import "regex"

fn main(w : World) -> Unit {
  match regex::compile("(?m)^(\\w+)$") {
    Ok(re) => {
      io_println(w, "is_match(\"ab\\ncd\") = " + re.is_match("ab\ncd").to_string())
      match re.captures("ab\ncd") {
        Some(c) => match c.get(1) {
          Some(m) => io_println(w, "captures group1 = [" + m.start.to_string() + "," + m.end.to_string() + ")")
          None => io_println(w, "captures group1 = None")
        }
        None => io_println(w, "captures = None")
      }
    }
    Err(_) => io_println(w, "compile error")
  }
}
