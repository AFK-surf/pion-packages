import "effect"

fn main(w : World) -> Unit {
  let rt = effect::Runtime::new_at(None, 0L)
  let order : Array[Int] = Array::new()
  let delays = [50, 10, 40, 20, 30, 5, 45, 15, 35, 25]
  for d in delays {
    rt.after(d, fn() -> Unit { order.push(d) })
  }
  rt.advance(100)
  let mut s = "fired:"
  for d in order {
    s = s + " " + d.to_string()
  }
  io_println(w, s)
}
