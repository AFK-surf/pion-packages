import "base64"

fn main(w : World) -> Unit {
  io_println(w, "encoded_len(536870910, false) = " + base64::encoded_len(536870910, false).to_string() + "   (inside theorem domain)")
  io_println(w, "encoded_len(536870912, false) = " + base64::encoded_len(536870912, false).to_string() + "   (expected 715827883)")
  io_println(w, "encoded_len(1610612736, true) = " + base64::encoded_len(1610612736, true).to_string() + "   (expected 2147483648 > Int max)")
  io_println(w, "hex_encoded_len(1073741824) = " + base64::hex_encoded_len(1073741824).to_string() + "   (expected 2147483648)")
  let big = Bytes::new(536870912)
  io_println(w, "encode_no_pad(536870912 zero bytes) ...")
  let s = base64::encode_no_pad(big)
  io_println(w, "len = " + s.length().to_string())
}
