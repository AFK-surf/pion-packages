import "crdt"

fn main(w : World) -> Unit {
  let it = crdt::DeleteItem::{ clock: 18446744073709551614UL, len: 4UL }
  io_println(w, "DeleteItem{clock=2^64-2,len=4}.contains(2^64-1) = " + crdt::delete_item_contains(it, 18446744073709551615UL).to_string() + "   (range claims to cover it)")
  io_println(w, "DeleteItem{clock=2^64-2,len=4}.contains(2^64-2) = " + crdt::delete_item_contains(it, 18446744073709551614UL).to_string())
  let a = crdt::DeleteItem::{ clock: 10UL, len: 5UL }
  let b = crdt::DeleteItem::{ clock: 12UL, len: 18446744073709551610UL }
  let m = crdt::delete_item_merge(a, b)
  io_println(w, "merge({10,5},{12,2^64-6}) = {clock=" + m.clock.to_string() + ", len=" + m.len.to_string() + "}   (b's end wraps to 6; b's range [12,2^64-1) is dropped)")
  io_println(w, "merged contains 1000 = " + crdt::delete_item_contains(m, 1000UL).to_string() + "   (b claimed to delete clock 1000)")
  let ds = crdt::DeleteSet::new()
  ds.add(1UL, 18446744073709551614UL, 4UL)
  io_println(w, "DeleteSet.add(client 1, clock 2^64-2, len 4).is_deleted(2^64-1) = " + ds.is_deleted(1UL, 18446744073709551615UL).to_string())
}
