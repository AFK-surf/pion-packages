fn shl_plain(x : Int, n : Int) -> Int {
  x << n
}

fn div_plain(x : Int, y : Int) -> Int {
  x / y
}

fn main(w : World) -> Unit {
  io_println(w, "non-verify 3 << 40 = " + shl_plain(3, 40).to_string())
  io_println(w, "non-verify 1 << 32 = " + shl_plain(1, 32).to_string())
  io_println(w, "non-verify 7 / 0 = " + div_plain(7, 0).to_string())
}
