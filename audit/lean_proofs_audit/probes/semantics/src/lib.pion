#verify
pub fn v_shl(x : Int, n : Int) -> Int {
  x << n
}

#verify
pub fn v_div(x : Int, y : Int) -> Int {
  x / y
}

#verify
pub fn v_rem(x : Int, y : Int) -> Int {
  x % y
}

#verify
pub fn v_shr(x : Int, n : Int) -> Int {
  x >> n
}

#verify
pub fn v_u_shr(x : UInt, n : UInt) -> UInt {
  x >> n
}

#verify
pub fn v_i64_to_int(x : Int64) -> Int {
  x.to_int()
}

#verify
pub fn v_uint_to_int(x : UInt) -> Int {
  x.to_int()
}

#verify
pub fn v_u64_to_int(x : UInt64) -> Int {
  x.to_int()
}

#verify
pub fn v_int_to_uint(x : Int) -> UInt {
  x.to_uint()
}

#verify
pub fn v_int_to_byte_to_int(x : Int) -> Int {
  x.to_byte().to_int()
}

#verify
pub fn v_bytes_get(b : Bytes, i : Int) -> Int {
  b[i].to_int()
}

#verify
pub fn v_arr_make_len(n : Int) -> Int {
  let a : Array[Int] = Array::make(n, 0)
  a.length()
}

#verify
pub fn v_add(x : Int, y : Int) -> Int {
  x + y
}

#verify
pub fn v_mul64(x : Int64, y : Int64) -> Int64 {
  x * y
}

#verify
pub fn v_neg(x : Int) -> Int {
  -x
}

#verify
pub fn v_i64_shl_int(x : Int64, n : Int) -> Int64 {
  x << n
}

#verify
pub fn v_str_len(s : String) -> Int {
  s.length()
}
