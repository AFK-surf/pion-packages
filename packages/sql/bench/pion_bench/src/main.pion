///| Steady-state SQL parser / tokenizer / roundtrip benchmark (Pion Native).

import "sql"

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn split_lines(content : String) -> Array[String] {
  let lines : Array[String] = []
  let n = content.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if content.code_unit_at(i) == 10 {
      if i > start {
        lines.push(content.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if n > start {
    lines.push(content.slice(start, n))
  }
  lines
}

fn stmt_tag(stmt : sql::Statement) -> Int64 {
  match stmt {
    sql::Statement::Query(_) => 1L
    sql::Statement::Insert(_) => 2L
    sql::Statement::Update(_) => 3L
    sql::Statement::Delete(_) => 4L
    sql::Statement::CreateTable(_) => 5L
    sql::Statement::CreateIndex(_) => 6L
    sql::Statement::AlterTable(_) => 7L
    _ => 8L
  }
}

fn run_parse(world : World, path : String, rounds : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read queries")
      return 1
    }
  }
  let queries = split_lines(content)
  let opts = sql::ParseOptions::postgres()
  let mut total_stmts : Int64 = 0L
  let mut tag_sum : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < queries.length() {
      match sql::parse_with_options(queries[i], opts) {
        Ok(stmts) => {
          total_stmts = total_stmts + stmts.length().to_int64()
          let mut j = 0
          while j < stmts.length() {
            tag_sum = tag_sum + stmt_tag(stmts[j])
            j = j + 1
          }
        }
        Err(e) => {
          io_println(world, "parse error: " + e.message)
          return 1
        }
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "mode=parse")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "total_stmts=" + total_stmts.to_string())
  io_println(world, "tag_sum=" + tag_sum.to_string())
  0
}

fn run_tokenize(world : World, path : String, rounds : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read script")
      return 1
    }
  }
  let opts = sql::ParseOptions::postgres()
  let mut total_tokens : Int64 = 0L
  let mut r = 0
  while r < rounds {
    match sql::tokenize_with_options(content, opts) {
      Ok(toks) => {
        // Exclude trailing Eof token to match Rust sqlparser non-whitespace token count
        let cnt = if toks.length() > 0 { toks.length() - 1 } else { 0 }
        total_tokens = total_tokens + cnt.to_int64()
      }
      Err(e) => {
        io_println(world, "tokenize error: " + e.message)
        return 1
      }
    }
    r = r + 1
  }
  io_println(world, "mode=tokenize")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "total_tokens=" + total_tokens.to_string())
  0
}

fn run_roundtrip(world : World, path : String, rounds : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read queries")
      return 1
    }
  }
  let queries = split_lines(content)
  let opts = sql::ParseOptions::postgres()
  let mut total_stmts : Int64 = 0L
  let mut tag_sum : Int64 = 0L
  let mut non_empty : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < queries.length() {
      match sql::parse_with_options(queries[i], opts) {
        Ok(stmts) => {
          let mut j = 0
          while j < stmts.length() {
            let formatted = sql::to_sql(stmts[j])
            if formatted.length() > 0 {
              non_empty = non_empty + 1L
            }
            match sql::parse_with_options(formatted, opts) {
              Ok(reparsed) => {
                total_stmts = total_stmts + reparsed.length().to_int64()
                let mut k = 0
                while k < reparsed.length() {
                  tag_sum = tag_sum + stmt_tag(reparsed[k])
                  k = k + 1
                }
              }
              Err(e) => {
                io_println(world, "reparse error: " + e.message)
                return 1
              }
            }
            j = j + 1
          }
        }
        Err(e) => {
          io_println(world, "parse error: " + e.message)
          return 1
        }
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "mode=roundtrip")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "total_stmts=" + total_stmts.to_string())
  io_println(world, "non_empty=" + non_empty.to_string())
  io_println(world, "tag_sum=" + tag_sum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: sql_bench <parse|tokenize|roundtrip> <path> <rounds>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let rounds = parse_pos_int(args[3])
  if mode == "parse" {
    run_parse(world, path, rounds)
  } else if mode == "tokenize" {
    run_tokenize(world, path, rounds)
  } else if mode == "roundtrip" {
    run_roundtrip(world, path, rounds)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
