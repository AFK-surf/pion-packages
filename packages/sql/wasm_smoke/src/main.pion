///| Wasm32 + Native smoke entry for the `sql` package.

import "sql"

///|
pub fn smoke() -> Int {
  let query_sql = "WITH active_u AS (SELECT id, name FROM users WHERE active = TRUE) SELECT u.id, u.name, SUM(o.total) OVER (PARTITION BY u.id ORDER BY o.created_at ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running FROM active_u u LEFT JOIN orders o ON u.id = o.user_id WHERE o.status = $1 AND o.total >= $2 ORDER BY u.id DESC NULLS LAST LIMIT 10"
  let stmt = match sql::parse_one_with_options(query_sql, sql::ParseOptions::postgres()) {
    Ok(s) => s
    Err(_) => return 1
  }
  let formatted = sql::to_sql(stmt)
  let reparsed = match sql::parse_one_with_options(formatted, sql::ParseOptions::postgres()) {
    Ok(s) => s
    Err(_) => return 2
  }
  if !sql::stmt_eq(stmt, reparsed) {
    return 3
  }
  let tables = sql::extract_tables(stmt)
  if tables.length() != 2 || tables[0] != "users" || tables[1] != "orders" {
    return 4
  }
  let phs = sql::extract_placeholders(stmt)
  if phs.length() != 2 || phs[0] != "$1" || phs[1] != "$2" {
    return 5
  }
  let parts = match sql::split_statements("SELECT 'a;b'; INSERT INTO t VALUES ($1);") {
    Ok(p) => p
    Err(_) => return 6
  }
  if parts.length() != 2 {
    return 7
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
