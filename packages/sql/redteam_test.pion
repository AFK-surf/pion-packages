///| Day-1 Red-Team defenses:
///| - Deep nested parentheses `((((...))))`, subqueries, and expression chains bounded by `max_depth` (0 SIGSEGV)
///| - `max_tokens` and `max_nodes` resource budget guards
///| - Unterminated strings, block comments, nested block comments, dollar-quotes rejected cleanly with line/col
///| - Massive OR / AND / comma-separated lists parsed in O(N) linear time
///| - Empty, whitespace-only, comment-only, and multi-semicolon inputs handled safely

///|
test "redteam_deep_nested_parens_max_depth_no_sigsegv" {
  let depth = 500
  let sb = StringBuilder::new()
  sb.write_string("SELECT ")
  let mut i = 0
  while i < depth {
    sb.write_byte((40).to_byte())
    i = i + 1
  }
  sb.write_byte((49).to_byte())
  let mut j = 0
  while j < depth {
    sb.write_byte((41).to_byte())
    j = j + 1
  }
  let deep_sql = sb.to_string()

  // Default max_depth (128) must reject cleanly without crashing
  match parse(deep_sql) {
    Ok(_) => debug_assert(false, "default max_depth should reject 500 nested parens")
    Err(e) => debug_assert(e.line >= 1 && e.col >= 1, "error must have valid line/col")
  }
}

///|
test "redteam_deep_nested_subqueries_max_depth" {
  let depth = 160
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("SELECT * FROM (")
    i = i + 1
  }
  sb.write_string("SELECT 1")
  let mut j = 0
  while j < depth {
    sb.write_string(") t")
    j = j + 1
  }
  match parse(sb.to_string()) {
    Ok(_) => debug_assert(false, "default max_depth should reject 160 nested subqueries")
    Err(_) => ()
  }
}

///|
test "redteam_max_tokens_and_max_nodes_limits" {
  let sb = StringBuilder::new()
  sb.write_string("SELECT ")
  let mut i = 0
  while i < 400 {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string("1")
    i = i + 1
  }
  let src = sb.to_string()

  let tok_opts = ParseOptions::{
    dialect: Dialect::Generic,
    max_depth: 128,
    max_tokens: 100,
    max_nodes: 1000000,
  }
  match tokenize_with_options(src, tok_opts) {
    Ok(_) => debug_assert(false, "max_tokens=100 must reject 400-col SELECT")
    Err(_) => ()
  }

  let node_opts = ParseOptions::{
    dialect: Dialect::Generic,
    max_depth: 128,
    max_tokens: 500000,
    max_nodes: 50,
  }
  match parse_with_options(src, node_opts) {
    Ok(_) => debug_assert(false, "max_nodes=50 must reject 400-col SELECT")
    Err(_) => ()
  }
}

///|
test "redteam_unterminated_constructs_no_hang" {
  let bad_inputs = [
    "SELECT 'unterminated",
    "SELECT 'escaped '' still open",
    "SELECT E'escaped \\' still open",
    "SELECT \"unterminated ident",
    "SELECT `unterminated backtick",
    "SELECT [unterminated bracket",
    "SELECT /* unterminated block comment",
    "SELECT /* outer /* inner */ still open",
    "SELECT $$unterminated dollar",
    "SELECT $abc$unterminated tagged dollar $ab$",
  ]
  let mut i = 0
  while i < bad_inputs.length() {
    match parse(bad_inputs[i]) {
      Ok(_) => debug_assert(false, "must reject malformed input: " + bad_inputs[i])
      Err(e) => debug_assert(e.line == 1 && e.col >= 1, "valid line/col for: " + bad_inputs[i])
    }
    i = i + 1
  }
}

///|
test "redteam_massive_or_and_comma_list_linear_time" {
  // 2,000 OR clauses + 2,000 IN list items must parse cleanly in linear time without stack overflow
  let sb = StringBuilder::new()
  sb.write_string("SELECT id FROM t WHERE ")
  let mut i = 0
  while i < 2000 {
    if i > 0 {
      sb.write_string(" OR ")
    }
    sb.write_string("x = 1")
    i = i + 1
  }
  sb.write_string(" AND y IN (")
  let mut j = 0
  while j < 2000 {
    if j > 0 {
      sb.write_string(",")
    }
    sb.write_string("1")
    j = j + 1
  }
  sb.write_string(")")
  match parse(sb.to_string()) {
    Ok(stmts) => debug_assert(stmts.length() == 1, "1 massive statement parsed")
    Err(e) => debug_assert(false, "massive linear query failed: " + e.message)
  }
}

///|
test "redteam_empty_and_comment_only_inputs" {
  let empties = ["", "   \n\t  ", "-- just a comment", "/* block /* nested */ */", " ; ; ; "]
  let mut i = 0
  while i < empties.length() {
    match parse(empties[i]) {
      Ok(stmts) => debug_assert(stmts.length() == 0, "expected 0 statements for empty input")
      Err(e) => debug_assert(false, "empty input should return Ok([]): " + e.message)
    }
    i = i + 1
  }
}
