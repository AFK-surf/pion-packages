///| DDL & TCL parser compliance tests (CREATE TABLE/INDEX/VIEW, ALTER TABLE, DROP, BEGIN/COMMIT/ROLLBACK/SAVEPOINT/EXPLAIN).

///|
test "ddl_create_table_columns_constraints_references" {
  let sql = "CREATE TEMP TABLE IF NOT EXISTS public.orders (id BIGSERIAL PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE ON UPDATE RESTRICT, code VARCHAR(32) UNIQUE NOT NULL, amount NUMERIC(12, 2) DEFAULT 0.00 CHECK (amount >= 0), tags TEXT[], meta JSONB, CONSTRAINT uq_user_code UNIQUE (user_id, code))"
  let stmt = assert_parse_one(sql, ParseOptions::postgres())
  match stmt {
    Statement::CreateTable(ct) => {
      debug_assert(ct.temporary, "TEMP")
      debug_assert(ct.if_not_exists, "IF NOT EXISTS")
      debug_assert(ct.name.parts.length() == 2, "schema.table")
      debug_assert(ct.columns.length() == 6, "6 columns")
      debug_assert(ct.constraints.length() == 1, "1 table constraint")
      match ct.columns[4].data_type {
        DataType::Array(DataType::Text) => ()
        _ => debug_assert(false, "expected TEXT[]")
      }
      match ct.columns[5].data_type {
        DataType::Jsonb => ()
        _ => debug_assert(false, "expected JSONB")
      }
    }
    _ => debug_assert(false, "expected CreateTable")
  }

  let sqlite_sql = "CREATE TABLE kv (k TEXT PRIMARY KEY, v BLOB) WITHOUT ROWID"
  let s2 = assert_parse_one(sqlite_sql, ParseOptions::sqlite())
  match s2 {
    Statement::CreateTable(ct) => debug_assert(ct.without_rowid, "WITHOUT ROWID")
    _ => debug_assert(false, "expected CreateTable")
  }
}

///|
test "ddl_create_index_view_alter_drop" {
  let idx = assert_parse_one(
    "CREATE UNIQUE INDEX IF NOT EXISTS idx_users_email ON users (email ASC, created_at DESC) WHERE deleted_at IS NULL",
    ParseOptions::postgres(),
  )
  match idx {
    Statement::CreateIndex(ci) => {
      debug_assert(ci.unique && ci.if_not_exists, "unique + if_not_exists")
      debug_assert(ci.columns.length() == 2, "2 index columns")
      match ci.predicate {
        Some(_) => ()
        None => debug_assert(false, "expected partial index WHERE")
      }
    }
    _ => debug_assert(false, "expected CreateIndex")
  }

  let vw = assert_parse_one(
    "CREATE OR REPLACE VIEW active_users (id, email) AS SELECT id, email FROM users WHERE active = TRUE",
    ParseOptions::postgres(),
  )
  match vw {
    Statement::CreateView(cv) => {
      debug_assert(cv.or_replace, "OR REPLACE")
      debug_assert(cv.columns.length() == 2, "2 view columns")
    }
    _ => debug_assert(false, "expected CreateView")
  }

  let alt1 = assert_parse_one(
    "ALTER TABLE users ADD COLUMN bio TEXT DEFAULT ''",
    ParseOptions::default(),
  )
  match alt1 {
    Statement::AlterTable(at) => {
      debug_assert(at.operations.length() == 1, "1 alter op")
      match at.operations[0] {
        AlterTableOp::AddColumn(col) => debug_assert(col.name.value == "bio", "bio")
        _ => debug_assert(false, "expected AddColumn")
      }
    }
    _ => debug_assert(false, "expected AlterTable")
  }

  let alt2 = assert_parse_one(
    "ALTER TABLE users DROP COLUMN IF EXISTS legacy_col CASCADE",
    ParseOptions::postgres(),
  )
  match alt2 {
    Statement::AlterTable(at) =>
    match at.operations[0] {
      AlterTableOp::DropColumn(col, true, true) => debug_assert(col.value == "legacy_col", "legacy_col")
      _ => debug_assert(false, "expected DropColumn IF EXISTS CASCADE")
    }
    _ => debug_assert(false, "expected AlterTable")
  }

  let alt3 = assert_parse_one(
    "ALTER TABLE users RENAME COLUMN name TO full_name",
    ParseOptions::default(),
  )
  match alt3 {
    Statement::AlterTable(at) =>
    match at.operations[0] {
      AlterTableOp::RenameColumn(old_c, new_c) =>
      debug_assert(old_c.value == "name" && new_c.value == "full_name", "rename col")
      _ => debug_assert(false, "expected RenameColumn")
    }
    _ => debug_assert(false, "expected AlterTable")
  }

  let drp = assert_parse_one("DROP TABLE IF EXISTS a, b CASCADE", ParseOptions::postgres())
  match drp {
    Statement::Drop(d) => {
      match d.object_type {
        ObjectType::Table => ()
        _ => debug_assert(false, "Table")
      }
      debug_assert(d.if_exists && d.cascade && d.names.length() == 2, "DROP TABLE IF EXISTS a, b CASCADE")
    }
    _ => debug_assert(false, "expected Drop")
  }

  let drp_idx = assert_parse_one("DROP INDEX IF EXISTS idx_users_email", ParseOptions::sqlite())
  match drp_idx {
    Statement::Drop(d) =>
    match d.object_type {
      ObjectType::Index => ()
      _ => debug_assert(false, "Index")
    }
    _ => debug_assert(false, "expected Drop Index")
  }

  let drp_vw = assert_parse_one("DROP VIEW active_users", ParseOptions::default())
  match drp_vw {
    Statement::Drop(d) =>
    match d.object_type {
      ObjectType::View => ()
      _ => debug_assert(false, "View")
    }
    _ => debug_assert(false, "expected Drop View")
  }
}

///|
test "tcl_transactions_savepoint_and_explain" {
  match assert_parse_one("BEGIN TRANSACTION", ParseOptions::default()) {
    Statement::Begin(_) => ()
    _ => debug_assert(false, "expected Begin")
  }
  match assert_parse_one("BEGIN IMMEDIATE", ParseOptions::sqlite()) {
    Statement::Begin(Some(mode)) => debug_assert(mode == "IMMEDIATE", "IMMEDIATE")
    _ => debug_assert(false, "expected Begin IMMEDIATE")
  }
  match assert_parse_one("COMMIT", ParseOptions::default()) {
    Statement::Commit => ()
    _ => debug_assert(false, "expected Commit")
  }
  match assert_parse_one("ROLLBACK", ParseOptions::default()) {
    Statement::Rollback(None) => ()
    _ => debug_assert(false, "expected Rollback")
  }
  match assert_parse_one("SAVEPOINT sp1", ParseOptions::default()) {
    Statement::Savepoint(id) => debug_assert(id.value == "sp1", "sp1")
    _ => debug_assert(false, "expected Savepoint")
  }
  match assert_parse_one("ROLLBACK TO SAVEPOINT sp1", ParseOptions::default()) {
    Statement::Rollback(Some(id)) => debug_assert(id.value == "sp1", "rollback to sp1")
    _ => debug_assert(false, "expected Rollback to sp1")
  }
  match assert_parse_one("RELEASE SAVEPOINT sp1", ParseOptions::default()) {
    Statement::ReleaseSavepoint(id) => debug_assert(id.value == "sp1", "release sp1")
    _ => debug_assert(false, "expected ReleaseSavepoint")
  }
  match assert_parse_one("EXPLAIN ANALYZE SELECT 1", ParseOptions::postgres()) {
    Statement::Explain(true, Statement::Query(_)) => ()
    _ => debug_assert(false, "expected Explain Analyze Query")
  }
}
