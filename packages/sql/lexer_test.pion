///| SQL Lexer compliance tests (sqlparser-rs vectors + SQLite + PostgreSQL dialects).

fn assert_ok_tokens(src : String, opts : ParseOptions) -> Array[Token] {
  match tokenize_with_options(src, opts) {
    Ok(toks) => toks
    Err(e) => {
      debug_assert(false, "expected tokenize Ok for [" + src + "], got Err: " + e.message)
      []
    }
  }
}

fn assert_err_tokens(src : String, opts : ParseOptions) -> SqlError {
  match tokenize_with_options(src, opts) {
    Ok(_) => {
      debug_assert(false, "expected tokenize Err for [" + src + "]")
      SqlError::new(0, 0, 0, "")
    }
    Err(e) => e
  }
}

///|
test "lexer_keywords_case_insensitive" {
  let toks = assert_ok_tokens("select FrOm wHeRe InNeR jOiN", ParseOptions::default())
  debug_assert(toks.length() == 6, "5 keywords + Eof")
  match toks[0].kind {
    TokenKind::Keyword(k) => debug_assert(k == "SELECT", "SELECT")
    _ => debug_assert(false, "expected SELECT")
  }
  match toks[1].kind {
    TokenKind::Keyword(k) => debug_assert(k == "FROM", "FROM")
    _ => debug_assert(false, "expected FROM")
  }
  match toks[2].kind {
    TokenKind::Keyword(k) => debug_assert(k == "WHERE", "WHERE")
    _ => debug_assert(false, "expected WHERE")
  }
  match toks[3].kind {
    TokenKind::Keyword(k) => debug_assert(k == "INNER", "INNER")
    _ => debug_assert(false, "expected INNER")
  }
  match toks[4].kind {
    TokenKind::Keyword(k) => debug_assert(k == "JOIN", "JOIN")
    _ => debug_assert(false, "expected JOIN")
  }
}

///|
test "lexer_quoted_identifiers_and_escapes" {
  let toks = assert_ok_tokens(
    "\"my \"\"col\"\"\" `back``tick` [bracket col] plain_id",
    ParseOptions::default(),
  )
  debug_assert(toks.length() == 5, "4 idents + Eof")
  match toks[0].kind {
    TokenKind::Ident(v, QuoteStyle::DoubleQuote) =>
    debug_assert(v == "my \"col\"", "double quote unescape")
    _ => debug_assert(false, "expected DoubleQuote ident")
  }
  match toks[1].kind {
    TokenKind::Ident(v, QuoteStyle::Backtick) =>
    debug_assert(v == "back`tick", "backtick unescape")
    _ => debug_assert(false, "expected Backtick ident")
  }
  match toks[2].kind {
    TokenKind::Ident(v, QuoteStyle::Bracket) =>
    debug_assert(v == "bracket col", "bracket ident")
    _ => debug_assert(false, "expected Bracket ident")
  }
  match toks[3].kind {
    TokenKind::Ident(v, QuoteStyle::None) =>
    debug_assert(v == "plain_id", "plain ident")
    _ => debug_assert(false, "expected plain ident")
  }
}

///|
test "lexer_strings_single_escaped_dollar_quoted" {
  let toks = assert_ok_tokens(
    "'it''s ok' E'line1\\nline2\\t\\\\\\'' $$raw $body$$ $tag$hello ''world''$tag$",
    ParseOptions::postgres(),
  )
  debug_assert(toks.length() == 5, "4 strings + Eof")
  match toks[0].kind {
    TokenKind::SingleQuotedString(s) => debug_assert(s == "it's ok", "single quoted")
    _ => debug_assert(false, "expected SingleQuotedString")
  }
  match toks[1].kind {
    TokenKind::EscapedString(s) => debug_assert(s == "line1\nline2\t\\'", "escaped string")
    _ => debug_assert(false, "expected EscapedString")
  }
  match toks[2].kind {
    TokenKind::DollarQuotedString(tag, body) => {
      debug_assert(tag == "", "empty tag")
      debug_assert(body == "raw $body", "empty tag dollar body")
    }
    _ => debug_assert(false, "expected DollarQuotedString")
  }
  match toks[3].kind {
    TokenKind::DollarQuotedString(tag, body) => {
      debug_assert(tag == "tag", "named tag")
      debug_assert(body == "hello ''world''", "named tag body")
    }
    _ => debug_assert(false, "expected tagged DollarQuotedString")
  }
}

///|
test "lexer_numbers_dec_hex_float" {
  let toks = assert_ok_tokens("0 42 3.14 .5 1e10 2.5E-3 0xFF 0X1a2B", ParseOptions::default())
  debug_assert(toks.length() == 9, "8 numbers + Eof")
  let expected = ["0", "42", "3.14", ".5", "1e10", "2.5E-3", "0xFF", "0X1a2B"]
  let mut i = 0
  while i < expected.length() {
    match toks[i].kind {
      TokenKind::Number(n) => debug_assert(n == expected[i], "number mismatch: " + n)
      _ => debug_assert(false, "expected Number at " + i.to_string())
    }
    i = i + 1
  }
}

///|
test "lexer_comments_line_and_nested_block" {
  let src = "-- header comment\nSELECT /* outer /* inner */ still outer */ 1 -- trailing\n/* a /* b /* c */ b */ a */ + 2"
  let toks = assert_ok_tokens(src, ParseOptions::postgres())
  debug_assert(toks.length() == 5, "SELECT 1 + 2 Eof")
  match toks[0].kind {
    TokenKind::Keyword(k) => debug_assert(k == "SELECT", "SELECT")
    _ => debug_assert(false, "expected SELECT")
  }
  match toks[1].kind {
    TokenKind::Number(n) => debug_assert(n == "1", "1")
    _ => debug_assert(false, "expected 1")
  }
  match toks[2].kind {
    TokenKind::Plus => ()
    _ => debug_assert(false, "expected Plus")
  }
  match toks[3].kind {
    TokenKind::Number(n) => debug_assert(n == "2", "2")
    _ => debug_assert(false, "expected 2")
  }
}

///|
test "lexer_placeholders_all_styles" {
  let toks = assert_ok_tokens("? ?1 $1 $23 :user_id @tenant_id", ParseOptions::default())
  debug_assert(toks.length() == 7, "6 placeholders + Eof")
  let expected = ["?", "?1", "$1", "$23", ":user_id", "@tenant_id"]
  let mut i = 0
  while i < expected.length() {
    match toks[i].kind {
      TokenKind::Placeholder(p) => debug_assert(p == expected[i], "placeholder mismatch: " + p)
      _ => debug_assert(false, "expected Placeholder at " + i.to_string())
    }
    i = i + 1
  }
}

///|
test "lexer_operators_all" {
  let src = "= != <> <= >= < > || -> ->> #> #>> :: @> <@ ~ ~* !~ !~* + - * / % ^ & | << >>"
  let toks = assert_ok_tokens(src, ParseOptions::postgres())
  debug_assert(toks.length() == 30, "29 operators + Eof")
  match toks[0].kind { TokenKind::Eq => () _ => debug_assert(false, "Eq") }
  match toks[1].kind { TokenKind::Neq => () _ => debug_assert(false, "Neq !=") }
  match toks[2].kind { TokenKind::Neq => () _ => debug_assert(false, "Neq <>") }
  match toks[3].kind { TokenKind::LtEq => () _ => debug_assert(false, "LtEq") }
  match toks[4].kind { TokenKind::GtEq => () _ => debug_assert(false, "GtEq") }
  match toks[7].kind { TokenKind::Concat => () _ => debug_assert(false, "Concat") }
  match toks[8].kind { TokenKind::Arrow => () _ => debug_assert(false, "Arrow") }
  match toks[9].kind { TokenKind::DoubleArrow => () _ => debug_assert(false, "DoubleArrow") }
  match toks[10].kind { TokenKind::HashArrow => () _ => debug_assert(false, "HashArrow") }
  match toks[11].kind { TokenKind::HashDoubleArrow => () _ => debug_assert(false, "HashDoubleArrow") }
  match toks[12].kind { TokenKind::DoubleColon => () _ => debug_assert(false, "DoubleColon") }
  match toks[13].kind { TokenKind::AtGt => () _ => debug_assert(false, "AtGt") }
  match toks[14].kind { TokenKind::LtAt => () _ => debug_assert(false, "LtAt") }
  match toks[15].kind { TokenKind::Tilde => () _ => debug_assert(false, "Tilde") }
  match toks[16].kind { TokenKind::TildeStar => () _ => debug_assert(false, "TildeStar") }
  match toks[17].kind { TokenKind::BangTilde => () _ => debug_assert(false, "BangTilde") }
  match toks[18].kind { TokenKind::BangTildeStar => () _ => debug_assert(false, "BangTildeStar") }
}

///|
test "lexer_precise_line_col_positions_and_errors" {
  let toks = assert_ok_tokens("SELECT\n  foo,\n    bar", ParseOptions::default())
  debug_assert(toks[0].line == 1 && toks[0].col == 1, "SELECT at 1:1")
  debug_assert(toks[1].line == 2 && toks[1].col == 3, "foo at 2:3")
  debug_assert(toks[3].line == 3 && toks[3].col == 5, "bar at 3:5")

  let err1 = assert_err_tokens("SELECT\n  'unterminated", ParseOptions::default())
  debug_assert(err1.line == 2 && err1.col == 3, "unterminated string at 2:3")

  let err2 = assert_err_tokens("SELECT 1\n/* outer /* inner */", ParseOptions::postgres())
  debug_assert(err2.line == 2 && err2.col == 1, "unterminated nested comment at 2:1")

  let err3 = assert_err_tokens("SELECT\n$tag$unclosed", ParseOptions::postgres())
  debug_assert(err3.line == 2 && err3.col == 1, "unterminated dollar quote at 2:1")
}
