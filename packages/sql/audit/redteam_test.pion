///| Red-team prosecution tests for `packages/sql` @ 1425a54 (feat/pkg-sql).
///|
///| Every `p*_` test asserts what a reference does on the very same input: real PostgreSQL 16 /
///| SQLite 3 (the engines the package claims to model) and Rust `sqlparser =0.53.0`. The live
///| differential that produced each vector is `run_audit.sh` (stages `security`, `diff`, `deep`).
///| A FAILING `p*_` test is evidence against Pion, not a broken test.
///|
///| `ctl_*` tests are controls: attacks the package survives. They pass and stay here so a reviewer
///| can see what was tried and found sound.
///|
///| Naming: `p0_*` security (injection, authorisation bypass, statement smuggling) or an invariant
///|         whose violation crashes the process; `p1_*` wrong tree / wrong value / valid SQL broken;
///|         `p2_*` divergence from a reference or API footgun (several shared with sqlparser 0.53,
///|         noted per test). Process crashes themselves cannot live in a unit test (they kill the
///|         test binary): see `run_audit.sh deep` (scripts/depth.py) and REPORT.md.

import "sql"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn pg(src : String) -> sql::Statement {
  match sql::parse_one_with_options(src, sql::ParseOptions::postgres()) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "setup: postgres parse failed: " + e.message + " in " + src)
      sql::Statement::Commit
    }
  }
}

///|
fn has(xs : Array[String], want : String) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == want {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn show(xs : Array[String]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///| Statements in a script as parsed by `parse_sqlite`, or -1 on error.
fn sqlite_count(src : String) -> Int {
  match sql::parse_sqlite(src) {
    Ok(s) => s.length()
    Err(_) => -1
  }
}

///|
fn first_expr(stmt : sql::Statement) -> sql::Expr {
  match stmt {
    sql::Statement::Query(q) =>
    match q.body {
      sql::SetExpr::Select(sel) =>
      match sel.projection[0] {
        sql::SelectItem::UnnamedExpr(x) => x
        sql::SelectItem::ExprWithAlias(x, _) => x
        _ => sql::Expr::Null
      }
      _ => sql::Expr::Null
    }
    _ => sql::Expr::Null
  }
}

///| Depth of an expression tree (only the shapes the tests build).
fn expr_depth(e : sql::Expr) -> Int {
  match e {
    sql::Expr::BinaryOp(l, _, r) => {
      let a = expr_depth(l)
      let b = expr_depth(r)
      1 + (if a > b { a } else { b })
    }
    sql::Expr::Cast(x, _, _) => 1 + expr_depth(x)
    sql::Expr::Subscript(x, _) => 1 + expr_depth(x)
    sql::Expr::IsNull(x) => 1 + expr_depth(x)
    sql::Expr::Nested(x) => 1 + expr_depth(x)
    sql::Expr::UnaryOp(_, x) => 1 + expr_depth(x)
    _ => 1
  }
}

///|
fn chain(head : String, piece : String, n : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string(head)
  let mut i = 0
  while i < n {
    sb.write_string(piece)
    i = i + 1
  }
  sb.to_string()
}

// ===========================================================================
// P0 - to_sql() injection
// ===========================================================================

///| PostgreSQL 16 runs the input as a harmless 2-column SELECT; it runs to_sql(parse(input)) as
///| `SELECT 1; DROP TABLE secret` (run_audit.sh security, exhibit A-PG, really drops the table).
///| `- -1` is printed as `--1`, a line comment that swallows the rest of the line, and the raw
///| newline inside the string literal resumes SQL. sqlparser 0.53 prints the same text (shared bug),
///| but its README does not claim `stmt_eq(stmt, parse_one(to_sql(stmt)))`.
test "p0_to_sql_double_minus_turns_into_comment_and_smuggles_drop_table" {
  let src = "SELECT - -1, '\n1; DROP TABLE secret; --'"
  let out = sql::to_sql(pg(src))
  match sql::parse_postgres(out) {
    Ok(stmts) =>
    debug_assert(
      stmts.length() == 1,
      "to_sql produced " + stmts.length().to_string() + " statements: " + out,
    )
    Err(e) => debug_assert(false, "to_sql output does not re-parse (" + e.message + "): " + out)
  }
}

///| `b = - -1` -> `b = --1 OR a = 2`: the WHERE clause is cut by a comment.
test "p0_to_sql_double_minus_in_where_breaks_round_trip" {
  let out = sql::to_sql(pg("SELECT a FROM t WHERE b = - -1 OR a = 2"))
  match sql::parse_postgres(out) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "to_sql output does not re-parse (" + e.message + "): " + out)
  }
}

// ===========================================================================
// P0 - extract_tables() misses tables PostgreSQL reads (role without SELECT on `secret`
// gets "permission denied for table secret" for every statement below)
// ===========================================================================

///|
fn expect_secret(src : String) -> Unit {
  let t = sql::extract_tables(pg(src))
  debug_assert(has(t, "secret"), "extract_tables = " + show(t) + " for: " + src)
}

///|
test "p0_extract_tables_misses_on_conflict_do_update_subquery" {
  expect_secret(
    "INSERT INTO t (id, a) VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET a = (SELECT max(id) FROM secret)",
  )
}

///|
test "p0_extract_tables_misses_on_conflict_where_subquery" {
  expect_secret(
    "INSERT INTO t (id, a) VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET a = 2 WHERE EXISTS (SELECT 1 FROM secret)",
  )
}

///|
test "p0_extract_tables_misses_insert_returning_subquery" {
  expect_secret("INSERT INTO t (id, a) VALUES (7, 1) RETURNING (SELECT pw FROM secret LIMIT 1)")
}

///|
test "p0_extract_tables_misses_update_returning_subquery" {
  expect_secret("UPDATE t SET a = 2 WHERE id = 1 RETURNING (SELECT pw FROM secret LIMIT 1)")
}

///|
test "p0_extract_tables_misses_delete_returning_subquery" {
  expect_secret("DELETE FROM t WHERE id = 1 RETURNING (SELECT pw FROM secret LIMIT 1)")
}

///|
test "p0_extract_tables_misses_distinct_on_subquery" {
  expect_secret("SELECT DISTINCT ON ((SELECT max(id) FROM secret)) a FROM t")
}

///| Table-level FOREIGN KEY needs REFERENCES on `secret`; the column-level form is listed.
test "p0_extract_tables_misses_table_level_foreign_key" {
  expect_secret("CREATE TABLE x_fk (a int, FOREIGN KEY (a) REFERENCES secret (id))")
}

///| CTE `"SECRET"` (quoted, case kept) does not shadow unquoted `SECRET`, which PostgreSQL folds to
///| `secret`. Pion compares raw strings, so it drops the real table as "a CTE reference".
test "p0_extract_tables_cte_shadowing_ignores_case_folding" {
  let t = sql::extract_tables(pg("WITH \"SECRET\" AS (SELECT 1 AS id) SELECT * FROM SECRET"))
  debug_assert(t.length() == 1, "extract_tables = " + show(t) + " (PostgreSQL reads table secret)")
}

///| `SECRET` and `"SECRET"` are two different tables in PostgreSQL; extract_tables returns the same
///| string for both, so no allow/deny list can be written against its output.
test "p1_extract_tables_conflates_quoted_and_unquoted_names" {
  let a = sql::extract_tables(pg("SELECT * FROM SECRET"))
  let b = sql::extract_tables(pg("SELECT * FROM \"SECRET\""))
  debug_assert(show(a) != show(b), "both give " + show(a) + " / " + show(b))
}

// ===========================================================================
// P0 - SQLite statement smuggling: real SQLite 3 executes the hidden DROP TABLE
// (run_audit.sh security, exhibit C); parse_sqlite sees one harmless SELECT.
// ===========================================================================

///| SQLite block comments do not nest: `/* /* */` is closed by the first `*/`.
test "p0_parse_sqlite_nested_comment_hides_drop_table" {
  let n = sqlite_count("SELECT 1 /* /* */; DROP TABLE secret; -- */")
  debug_assert(n == 2, "parse_sqlite statements = " + n.to_string() + " (SQLite runs 2: SELECT 1; DROP TABLE secret)")
}

///| SQLite has no dollar quoting: `$a$` is a bind parameter.
test "p0_parse_sqlite_dollar_quote_hides_drop_table" {
  let n = sqlite_count("SELECT $a$; DROP TABLE secret; SELECT $a$")
  debug_assert(n == 3, "parse_sqlite statements = " + n.to_string() + " (SQLite runs 3)")
}

///| SQLite has no E'' strings: `e` is a column, `'\'` a complete string literal (alias).
test "p0_parse_sqlite_escape_string_hides_drop_table" {
  let n = sqlite_count("SELECT e'\\' FROM (SELECT 1 AS e); DROP TABLE secret; --'")
  debug_assert(n == 2, "parse_sqlite statements = " + n.to_string() + " (SQLite runs 2)")
}

///| split_statements() takes no dialect and always lexes as Generic (SQLite brackets). psql sends
///| `SELECT 1 AS [x;` then `DROP TABLE secret;` (the DROP runs).
test "p0_split_statements_has_no_dialect_postgres_bracket" {
  match sql::split_statements("SELECT 1 AS [x; DROP TABLE secret; SELECT 2 AS y]") {
    Ok(parts) => debug_assert(parts.length() == 3, "pieces = " + show(parts) + " (psql sends 3)")
    Err(e) => debug_assert(false, e.message)
  }
}

///| Same for SQLite scripts: split_statements cannot be told the input is SQLite.
test "p0_split_statements_has_no_dialect_sqlite_nested_comment" {
  match sql::split_statements("SELECT 1 /* /* */; DROP TABLE secret; -- */") {
    Ok(parts) => debug_assert(parts.length() == 2, "pieces = " + show(parts) + " (SQLite runs 2)")
    Err(e) => debug_assert(false, e.message)
  }
}

// ===========================================================================
// P0 - max_depth does not bound the tree it is meant to bound
// ===========================================================================

///| README: "Recursive descent is strictly bounded by ParseOptions.max_depth (default 128) ... keep
///| max_depth <= 256 on wasm32". The iterative Pratt loop builds left-deep chains whose depth is the
///| chain length: with *default* options a 4.4 KB `SELECT 1 + 1 + ...` (1,093 terms) kills to_sql /
///| stmt_eq on wasm32, 1,491 terms kill extract_tables, 4,140 terms kill parse+drop
///| (RangeError: Maximum call stack size exceeded); natively ~88,000 terms SIGSEGV.
test "p0_left_deep_chain_depth_is_not_bounded_by_max_depth" {
  match sql::parse_one(chain("SELECT 1", " + 1", 1000)) {
    Ok(s) => {
      let d = expr_depth(first_expr(s))
      debug_assert(d <= 128, "default options accepted an expression tree of depth " + d.to_string())
    }
    Err(_) => ()
  }
}

///|
test "p0_cast_and_subscript_chains_ignore_max_depth" {
  let opts = sql::ParseOptions::{
    dialect: sql::Dialect::Postgres,
    max_depth: 8,
    max_tokens: 500000,
    max_nodes: 1000000,
  }
  let srcs = [chain("SELECT x", "::INT", 500), chain("SELECT x", "[1]", 500), chain("SELECT x", " IS NULL", 500)]
  let mut i = 0
  while i < srcs.length() {
    match sql::parse_one_with_options(srcs[i], opts) {
      Ok(s) => {
        let d = expr_depth(first_expr(s))
        debug_assert(d <= 8, "max_depth=8 accepted depth " + d.to_string())
      }
      Err(_) => ()
    }
    i = i + 1
  }
}

// ===========================================================================
// P1 - wrong tree / wrong value
// ===========================================================================

///| SQL standard / PostgreSQL / sqlparser: INTERSECT binds tighter than UNION and EXCEPT.
///| PostgreSQL returns {1} for this query; Pion's tree is ((1 UNION 2) INTERSECT 3) = {}.
test "p1_intersect_does_not_bind_tighter_than_union" {
  match pg("SELECT 1 UNION SELECT 2 INTERSECT SELECT 3") {
    sql::Statement::Query(q) =>
    match q.body {
      sql::SetExpr::SetOperation(op, _, _, _) =>
      match op {
        sql::SetOperator::Union => ()
        _ => debug_assert(false, "top-level set operation is not UNION")
      }
      _ => debug_assert(false, "not a set operation")
    }
    _ => debug_assert(false, "not a query")
  }
}

///| PostgreSQL: `||` ("any other operator") binds looser than `+`: 'a' || (1 + 2) = 'a3'.
///| Pion builds ('a' || 1) + 2, which PostgreSQL rejects (operator does not exist: text + integer).
test "p1_concat_binds_as_tight_as_plus" {
  match first_expr(pg("SELECT 'a' || 1 + 2")) {
    sql::Expr::BinaryOp(_, op, _) =>
    match op {
      sql::BinaryOperator::Concat => ()
      _ => debug_assert(false, "top operator is not ||")
    }
    _ => debug_assert(false, "not a binary op")
  }
}

///| PostgreSQL: `~` binds tighter than `=`: TRUE = ('ab' ~ 'a') is true. Pion: (TRUE = 'ab') ~ 'a'.
test "p1_regex_match_binds_as_loose_as_eq" {
  match first_expr(pg("SELECT TRUE = 'ab' ~ 'a'")) {
    sql::Expr::BinaryOp(_, op, _) =>
    match op {
      sql::BinaryOperator::Eq => ()
      _ => debug_assert(false, "top operator is not =")
    }
    _ => debug_assert(false, "not a binary op")
  }
}

///| PostgreSQL: IS binds looser than `=`.
test "p1_is_distinct_from_binds_tighter_than_eq" {
  match first_expr(pg("SELECT 1 + 1 IS DISTINCT FROM 2 = FALSE")) {
    sql::Expr::IsDistinctFrom(_, _) => ()
    _ => debug_assert(false, "top node is not IS DISTINCT FROM")
  }
}

///| PostgreSQL rejects chained non-associative comparisons; Pion accepts and evaluates them.
test "p1_chained_comparison_accepted" {
  match sql::parse_postgres("SELECT 3 > 2 > FALSE") {
    Ok(_) => debug_assert(false, "accepted `3 > 2 > FALSE` (PostgreSQL: syntax error)")
    Err(_) => ()
  }
}

///| PostgreSQL: E'\x41' = E'A' = E'\101' = 'A'. Pion silently drops the backslash.
test "p1_escape_string_hex_unicode_octal_escapes_dropped" {
  let srcs = ["SELECT E'\\x41'", "SELECT E'\\u0041'", "SELECT E'\\101'"]
  let mut i = 0
  while i < srcs.length() {
    match first_expr(pg(srcs[i])) {
      sql::Expr::EscapedString(v) => debug_assert(v == "A", srcs[i] + " -> '" + v + "'")
      _ => debug_assert(false, "not an escaped string")
    }
    i = i + 1
  }
}

///| `double precision` is printed as `DOUBLE`, which PostgreSQL rejects (type "double" does not exist).
test "p1_to_sql_double_precision_is_not_postgres" {
  let out = sql::to_sql(pg("SELECT a::double precision FROM t"))
  debug_assert(out.contains("DOUBLE PRECISION"), out)
}

///| stmt_eq is documented as "structural AST equality" and is the round-trip oracle of the package's
///| own tests, but it compares formatter text: two different WHERE trees are "equal".
test "p1_stmt_eq_is_text_equality_not_structural" {
  let a = sql::Expr::Identifier(sql::Ident::new("a"))
  let b = sql::Expr::Identifier(sql::Ident::new("b"))
  let c = sql::Expr::Identifier(sql::Ident::new("c"))
  let left = sql::Expr::BinaryOp(sql::Expr::BinaryOp(a, sql::BinaryOperator::Or, b), sql::BinaryOperator::And, c)
  let right = sql::Expr::BinaryOp(a, sql::BinaryOperator::Or, sql::Expr::BinaryOp(b, sql::BinaryOperator::And, c))
  match pg("SELECT 1 FROM t WHERE a") {
    sql::Statement::Query(q) =>
    match q.body {
      sql::SetExpr::Select(sel) => {
        let mk = fn(w : sql::Expr) -> sql::Statement {
          sql::Statement::Query(
            sql::Query::{
              with_clause: q.with_clause,
              body: sql::SetExpr::Select(
                sql::Select::{
                  distinct: sel.distinct,
                  projection: sel.projection,
                  from: sel.from,
                  selection: Some(w),
                  group_by: sel.group_by,
                  having: sel.having,
                },
              ),
              order_by: q.order_by,
              limit: q.limit,
              offset: q.offset,
            },
          )
        }
        debug_assert(!sql::stmt_eq(mk(left), mk(right)), "stmt_eq((a OR b) AND c, a OR (b AND c)) = true")
        debug_assert(
          !sql::stmt_eq(mk(sql::Expr::Number("1")), mk(sql::Expr::Identifier(sql::Ident::new("1")))),
          "stmt_eq(Number 1, Identifier 1) = true",
        )
      }
      _ => ()
    }
    _ => ()
  }
}

///| An unquoted identifier that happens to be a keyword comes back upper-cased (`key` -> `KEY`):
///| extract_tables / aliases / to_sql all change the user's spelling; sqlparser keeps `key`.
test "p1_keyword_identifiers_are_uppercased" {
  let t = sql::extract_tables(pg("SELECT * FROM key"))
  debug_assert(show(t) == "[key]", "extract_tables(FROM key) = " + show(t))
  let out = sql::to_sql(pg("SELECT date, time, key FROM t"))
  debug_assert(out == "SELECT date, time, key FROM t", out)
}

// ===========================================================================
// P2 - coverage gaps where sqlparser 0.53 parses what the engine runs, and API footguns
// ===========================================================================

///| All accepted by PostgreSQL 16 and by sqlparser 0.53 PostgreSqlDialect.
test "p2_postgres_statements_upstream_parses_pion_rejects" {
  let srcs = [
    "SELECT a FROM d WHERE s SIMILAR TO 'x%'", "SELECT a FROM d WHERE a = ALL(SELECT a FROM d2)",
    "SELECT EXTRACT(YEAR FROM date) FROM d", "SELECT SUBSTRING(s FROM 1 FOR 2) FROM d", "SELECT INTERVAL '1 day'",
    "SELECT DATE '2020-01-01'", "SELECT ARRAY(SELECT a FROM d)", "SELECT arr[1:2] FROM d",
    "SELECT string_agg(s, ',' ORDER BY s) FROM d", "SELECT count(*) OVER w FROM d WINDOW w AS (ORDER BY a)",
    "SELECT a FROM d FETCH FIRST 5 ROWS ONLY", "SELECT a FROM d FOR UPDATE", "SELECT * FROM generate_series(1, 3) g",
    "INSERT INTO d DEFAULT VALUES", "UPDATE d SET (a, b) = (1, 2)", "DELETE FROM d USING d2 WHERE d.id = d2.id",
    "CREATE TABLE d3 (a int, b int GENERATED ALWAYS AS (a * 2) STORED)", "CREATE TABLE d3 (a int CONSTRAINT pos CHECK (a > 0))",
    "ALTER TABLE d ALTER COLUMN a TYPE bigint", "TRUNCATE d", "SELECT @ -5",
  ]
  let bad : Array[String] = []
  let mut i = 0
  while i < srcs.length() {
    match sql::parse_postgres(srcs[i]) {
      Ok(_) => ()
      Err(_) => bad.push(srcs[i])
    }
    i = i + 1
  }
  debug_assert(bad.length() == 0, bad.length().to_string() + " rejected: " + show(bad))
}

///| All accepted by SQLite 3 and by sqlparser 0.53 SQLiteDialect.
test "p2_sqlite_statements_upstream_parses_pion_rejects" {
  let srcs = [
    "SELECT X'0102'", "SELECT 1 LIMIT 1, 2", "INSERT OR REPLACE INTO d (id) VALUES (1)", "REPLACE INTO d (id) VALUES (1)",
    "CREATE TABLE d3 (a, b)", "SELECT a FROM d WHERE a == 1", "SELECT a FROM d WHERE s REGEXP 'x'",
  ]
  let bad : Array[String] = []
  let mut i = 0
  while i < srcs.length() {
    if sqlite_count(srcs[i]) < 0 {
      bad.push(srcs[i])
    }
    i = i + 1
  }
  debug_assert(bad.length() == 0, bad.length().to_string() + " rejected: " + show(bad))
}

///| split_statements() runs the full tokenizer with the default max_tokens (500,000) and cannot be
///| given options: a 1.2 MB script of `INSERT ... VALUES (1),(2),...` is refused outright.
test "p2_split_statements_rejects_large_scripts" {
  let src = chain("INSERT INTO t VALUES (0)", ",(1)", 170000)
  match sql::split_statements(src) {
    Ok(parts) => debug_assert(parts.length() == 1, "pieces " + parts.length().to_string())
    Err(e) => debug_assert(false, "split_statements: " + e.message)
  }
}

///| Bracket identifiers are written without escaping `]` (sqlparser 0.53 does the same).
test "p2_to_sql_bracket_identifier_not_escaped" {
  let id = sql::Ident::quoted("x] FROM t; DROP TABLE secret; --", sql::QuoteStyle::Bracket)
  let out = sql::expr_to_sql(sql::Expr::Identifier(id))
  match sql::parse_sqlite("SELECT " + out) {
    Ok(stmts) => debug_assert(stmts.length() == 1, "SELECT " + out + " -> " + stmts.length().to_string() + " statements")
    Err(_) => ()
  }
}

///| Dollar-quoted bodies are written verbatim: a body containing its own delimiter escapes.
test "p2_to_sql_dollar_body_can_close_its_own_quote" {
  let out = sql::expr_to_sql(sql::Expr::DollarQuotedString("", "x$$; DROP TABLE secret; --"))
  match sql::parse_postgres("SELECT " + out) {
    Ok(stmts) => debug_assert(stmts.length() == 1, "SELECT " + out + " -> " + stmts.length().to_string() + " statements")
    Err(_) => ()
  }
}

// ===========================================================================
// Controls - attacks the package survives
// ===========================================================================

///|
test "ctl_quoted_identifiers_and_strings_round_trip" {
  let src = "SELECT \"a\"\"b\", \"x;y\", \"--c\", 'it''s', '--', E'a\\\\b\\'c\\n', $t$x$$y$t$ FROM \"select\""
  let s = pg(src)
  let out = sql::to_sql(s)
  match sql::parse_postgres(out) {
    Ok(re) => debug_assert(re.length() == 1 && sql::to_sql(re[0]) == out, out)
    Err(e) => debug_assert(false, e.message)
  }
}

///|
test "ctl_split_statements_quotes_comments_dollars" {
  let src = "SELECT 'a;b'; SELECT E'a\\';b'; SELECT $$;$$; SELECT $t$ $u$; $t$; SELECT 1 -- ;\n; SELECT /* /* ; */ ; */ 2; SELECT \"a;b\"; SELECT E'\\\\'; SELECT 3"
  match sql::split_statements(src) {
    Ok(parts) => debug_assert(parts.length() == 9, show(parts))
    Err(e) => debug_assert(false, e.message)
  }
}

///|
test "ctl_extract_tables_subquery_positions" {
  let srcs = [
    "SELECT a FROM t WHERE id IN (SELECT id FROM secret)", "SELECT (SELECT count(*) FROM secret) FROM t",
    "SELECT a FROM t GROUP BY a HAVING EXISTS (SELECT 1 FROM secret)", "SELECT CASE WHEN EXISTS (SELECT 1 FROM secret) THEN 1 END FROM t",
    "INSERT INTO t (id, a) SELECT id, 1 FROM secret", "UPDATE t SET a = 1 FROM secret WHERE t.id = secret.id",
    "DELETE FROM t WHERE id IN (SELECT id FROM secret)", "SELECT * FROM t JOIN (SELECT id FROM secret) s ON s.id = t.id",
    "WITH c AS (SELECT * FROM secret) SELECT * FROM c", "WITH secret AS (SELECT * FROM secret) SELECT * FROM secret",
    "SELECT * FROM \"secret\"", "SELECT a FROM t UNION SELECT id FROM secret", "SELECT * FROM t ORDER BY (SELECT max(id) FROM secret)",
    "SELECT * FROM t, LATERAL (SELECT pw FROM secret WHERE secret.id = t.id) s", "CREATE TABLE x_fk (a int REFERENCES secret (id))",
  ]
  let mut i = 0
  while i < srcs.length() {
    expect_secret(srcs[i])
    i = i + 1
  }
}

///|
test "ctl_parenthesised_precedence_round_trips" {
  let src = "SELECT (a OR b) AND c, NOT (a AND b), (a - b) - c, a - (b - c), -(a - b), (-a)::INTEGER, (SELECT 1 UNION SELECT 2) FROM t WHERE x BETWEEN 1 AND 2 AND y = 2"
  let out = sql::to_sql(pg(src))
  debug_assert(out == src, out)
}

///|
test "ctl_depth_guard_rejects_deep_parens_and_subqueries" {
  match sql::parse_one(chain("SELECT ", "(", 400) + "1" + chain("", ")", 400)) {
    Ok(_) => debug_assert(false, "400 parens accepted")
    Err(_) => ()
  }
  match sql::parse_one(chain("", "SELECT (", 200) + "SELECT 1" + chain("", ")", 200)) {
    Ok(_) => debug_assert(false, "200 nested subqueries accepted")
    Err(_) => ()
  }
}
