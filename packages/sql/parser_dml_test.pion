///| DML parser compliance tests (SELECT, JOINs, CTEs, Window Functions, SetOps, INSERT, UPDATE, DELETE).

fn assert_parse_one(src : String, opts : ParseOptions) -> Statement {
  match parse_one_with_options(src, opts) {
    Ok(s) => s
    Err(e) => {
      debug_assert(
        false,
        "parse_one failed for [" + src + "] at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message,
      )
      Statement::Commit
    }
  }
}

///|
test "dml_select_basic_distinct_all_aliases_where_group_having_order_limit_offset" {
  let s1 = assert_parse_one(
    "SELECT DISTINCT u.id, u.name AS user_name, COUNT(*) total FROM users u WHERE u.active = TRUE GROUP BY u.id, u.name HAVING COUNT(*) > 1 ORDER BY total DESC NULLS LAST, u.id ASC NULLS FIRST LIMIT 20 OFFSET 40",
    ParseOptions::postgres(),
  )
  match s1 {
    Statement::Query(q) => {
      match q.body {
        SetExpr::Select(sel) => {
          match sel.distinct {
            DistinctKind::Distinct => ()
            _ => debug_assert(false, "expected Distinct")
          }
          debug_assert(sel.projection.length() == 3, "3 projections")
          debug_assert(sel.from.length() == 1, "1 from")
          debug_assert(sel.group_by.length() == 2, "2 group_by")
          match sel.having {
            Some(_) => ()
            None => debug_assert(false, "expected HAVING")
          }
        }
        _ => debug_assert(false, "expected Select")
      }
      debug_assert(q.order_by.length() == 2, "2 order_by")
      match q.order_by[0].asc {
        Some(false) => ()
        _ => debug_assert(false, "expected DESC")
      }
      match q.order_by[0].nulls_first {
        Some(false) => ()
        _ => debug_assert(false, "expected NULLS LAST")
      }
      match q.order_by[1].nulls_first {
        Some(true) => ()
        _ => debug_assert(false, "expected NULLS FIRST")
      }
      match (q.limit, q.offset) {
        (Some(_), Some(_)) => ()
        _ => debug_assert(false, "expected LIMIT and OFFSET")
      }
    }
    _ => debug_assert(false, "expected Query")
  }

  let s2 = assert_parse_one("SELECT ALL a, b FROM t", ParseOptions::default())
  match s2 {
    Statement::Query(q) =>
    match q.body {
      SetExpr::Select(sel) =>
      match sel.distinct {
        DistinctKind::All => ()
        _ => debug_assert(false, "expected ALL")
      }
      _ => debug_assert(false, "expected Select")
    }
    _ => debug_assert(false, "expected Query")
  }

  let s3 = assert_parse_one(
    "SELECT DISTINCT ON (dept_id) dept_id, salary FROM employees ORDER BY dept_id, salary DESC",
    ParseOptions::postgres(),
  )
  match s3 {
    Statement::Query(q) =>
    match q.body {
      SetExpr::Select(sel) =>
      match sel.distinct {
        DistinctKind::DistinctOn(exprs) => debug_assert(exprs.length() == 1, "1 DISTINCT ON expr")
        _ => debug_assert(false, "expected DistinctOn")
      }
      _ => debug_assert(false, "expected Select")
    }
    _ => debug_assert(false, "expected Query")
  }
}

///|
test "dml_select_all_join_types" {
  let sql = "SELECT * FROM a INNER JOIN b ON a.id = b.a_id LEFT OUTER JOIN c USING (c_id) RIGHT JOIN d ON c.id = d.c_id FULL OUTER JOIN e ON d.id = e.d_id CROSS JOIN f NATURAL LEFT JOIN g"
  let stmt = assert_parse_one(sql, ParseOptions::default())
  match stmt {
    Statement::Query(q) =>
    match q.body {
      SetExpr::Select(sel) => {
        debug_assert(sel.from.length() == 1, "1 table_with_joins")
        let joins = sel.from[0].joins
        debug_assert(joins.length() == 6, "6 joins")
        match joins[0].join_operator {
          JoinOperator::Inner(JoinConstraint::On(_)) => ()
          _ => debug_assert(false, "join 0 Inner On")
        }
        match joins[1].join_operator {
          JoinOperator::LeftOuter(JoinConstraint::Using(cols)) =>
          debug_assert(cols.length() == 1 && cols[0].value == "c_id", "join 1 LeftOuter Using")
          _ => debug_assert(false, "join 1 LeftOuter Using")
        }
        match joins[2].join_operator {
          JoinOperator::RightOuter(JoinConstraint::On(_)) => ()
          _ => debug_assert(false, "join 2 RightOuter On")
        }
        match joins[3].join_operator {
          JoinOperator::FullOuter(JoinConstraint::On(_)) => ()
          _ => debug_assert(false, "join 3 FullOuter On")
        }
        match joins[4].join_operator {
          JoinOperator::CrossJoin => ()
          _ => debug_assert(false, "join 4 CrossJoin")
        }
        match joins[5].join_operator {
          JoinOperator::NaturalLeft => ()
          _ => debug_assert(false, "join 5 NaturalLeft")
        }
      }
      _ => debug_assert(false, "expected Select")
    }
    _ => debug_assert(false, "expected Query")
  }
}

///|
test "dml_set_operations_union_intersect_except" {
  let sql = "SELECT id FROM a UNION ALL SELECT id FROM b INTERSECT SELECT id FROM c EXCEPT SELECT id FROM d ORDER BY id LIMIT 10"
  let stmt = assert_parse_one(sql, ParseOptions::default())
  match stmt {
    Statement::Query(q) => {
      match q.body {
        SetExpr::SetOperation(SetOperator::Except, false, _, _) => ()
        _ => debug_assert(false, "expected outer EXCEPT")
      }
      debug_assert(q.order_by.length() == 1, "outer ORDER BY")
      match q.limit {
        Some(_) => ()
        None => debug_assert(false, "outer LIMIT")
      }
    }
    _ => debug_assert(false, "expected Query")
  }
}

///|
test "dml_cte_with_recursive_and_subqueries_exists" {
  let sql = "WITH RECURSIVE tree(id, parent_id, depth) AS (SELECT id, parent_id, 0 FROM nodes WHERE parent_id IS NULL UNION ALL SELECT n.id, n.parent_id, t.depth + 1 FROM nodes n INNER JOIN tree t ON n.parent_id = t.id) SELECT t.id, (SELECT COUNT(*) FROM items i WHERE i.node_id = t.id) AS cnt FROM tree t WHERE EXISTS (SELECT 1 FROM active_nodes a WHERE a.id = t.id) AND t.id IN (SELECT id FROM allowed)"
  let stmt = assert_parse_one(sql, ParseOptions::postgres())
  match stmt {
    Statement::Query(q) => {
      match q.with_clause {
        Some(w) => {
          debug_assert(w.recursive, "RECURSIVE must be true")
          debug_assert(w.cte_tables.length() == 1, "1 CTE")
          debug_assert(w.cte_tables[0].alias.value == "tree", "CTE alias tree")
          debug_assert(w.cte_tables[0].columns.length() == 3, "3 CTE columns")
        }
        None => debug_assert(false, "expected WITH clause")
      }
    }
    _ => debug_assert(false, "expected Query")
  }
}

///|
test "dml_window_functions_partition_order_frames" {
  let sql = "SELECT emp_id, dept, salary, ROW_NUMBER() OVER (PARTITION BY dept ORDER BY salary DESC) AS rn, SUM(salary) OVER (PARTITION BY dept ORDER BY hire_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_sum, AVG(salary) OVER (ORDER BY salary RANGE BETWEEN 100 PRECEDING AND 100 FOLLOWING) AS moving_avg FROM employees"
  let stmt = assert_parse_one(sql, ParseOptions::postgres())
  match stmt {
    Statement::Query(q) =>
    match q.body {
      SetExpr::Select(sel) => {
        debug_assert(sel.projection.length() == 6, "6 projections")
        match sel.projection[4] {
          SelectItem::ExprWithAlias(Expr::Function(fc), alias) => {
            debug_assert(alias.value == "running_sum", "alias running_sum")
            match fc.over {
              Some(ws) => {
                debug_assert(ws.partition_by.length() == 1, "1 partition_by")
                debug_assert(ws.order_by.length() == 1, "1 order_by")
                match ws.window_frame {
                  Some(wf) => {
                    match wf.units {
                      WindowFrameUnits::Rows => ()
                      _ => debug_assert(false, "expected ROWS")
                    }
                    match (wf.start_bound, wf.end_bound) {
                      (WindowFrameBound::Preceding(None), Some(WindowFrameBound::CurrentRow)) => ()
                      _ => debug_assert(false, "expected UNBOUNDED PRECEDING AND CURRENT ROW")
                    }
                  }
                  None => debug_assert(false, "expected window_frame")
                }
              }
              None => debug_assert(false, "expected OVER")
            }
          }
          _ => debug_assert(false, "expected Function with alias")
        }
      }
      _ => debug_assert(false, "expected Select")
    }
    _ => debug_assert(false, "expected Query")
  }
}

///|
test "dml_insert_values_select_on_conflict_returning" {
  let s1 = assert_parse_one(
    "INSERT INTO users (id, email, name) VALUES ($1, $2, $3), ($4, $5, $6) ON CONFLICT (email) DO UPDATE SET name = excluded.name WHERE users.active = TRUE RETURNING id, email",
    ParseOptions::postgres(),
  )
  match s1 {
    Statement::Insert(ins) => {
      debug_assert(ins.columns.length() == 3, "3 columns")
      match ins.on_conflict {
        Some(oc) => {
          debug_assert(oc.target_columns.length() == 1, "1 conflict target")
          match oc.action {
            OnConflictAction::DoUpdate(assigns, Some(_)) =>
            debug_assert(assigns.length() == 1, "1 assignment")
            _ => debug_assert(false, "expected DoUpdate with WHERE")
          }
        }
        None => debug_assert(false, "expected ON CONFLICT")
      }
      debug_assert(ins.returning.length() == 2, "2 returning items")
    }
    _ => debug_assert(false, "expected Insert")
  }

  let s2 = assert_parse_one(
    "INSERT INTO archive_users (id, email) SELECT id, email FROM users WHERE deleted = 1 ON CONFLICT DO NOTHING",
    ParseOptions::sqlite(),
  )
  match s2 {
    Statement::Insert(ins) => {
      match ins.on_conflict {
        Some(oc) =>
        match oc.action {
          OnConflictAction::DoNothing => ()
          _ => debug_assert(false, "expected DoNothing")
        }
        None => debug_assert(false, "expected ON CONFLICT")
      }
    }
    _ => debug_assert(false, "expected Insert")
  }
}

///|
test "dml_update_from_where_returning_and_delete" {
  let u = assert_parse_one(
    "UPDATE orders SET status = 'shipped', updated_at = $1 FROM shipments s WHERE orders.id = s.order_id AND s.done = TRUE RETURNING orders.id, status",
    ParseOptions::postgres(),
  )
  match u {
    Statement::Update(upd) => {
      debug_assert(upd.assignments.length() == 2, "2 assignments")
      debug_assert(upd.from.length() == 1, "1 FROM table")
      match upd.selection {
        Some(_) => ()
        None => debug_assert(false, "expected WHERE")
      }
      debug_assert(upd.returning.length() == 2, "2 RETURNING items")
    }
    _ => debug_assert(false, "expected Update")
  }

  let d = assert_parse_one(
    "DELETE FROM sessions WHERE expires_at < $1 RETURNING id",
    ParseOptions::postgres(),
  )
  match d {
    Statement::Delete(del) => {
      match del.selection {
        Some(_) => ()
        None => debug_assert(false, "expected WHERE")
      }
      debug_assert(del.returning.length() == 1, "1 RETURNING item")
    }
    _ => debug_assert(false, "expected Delete")
  }
}
