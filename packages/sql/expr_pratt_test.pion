///| Pratt expression precedence, CASE, CAST, functions (DISTINCT/FILTER), arrays, tuples, and Postgres operators.

fn parse_select_expr(expr_sql : String, opts : ParseOptions) -> Expr {
  let stmt = assert_parse_one("SELECT " + expr_sql, opts)
  match stmt {
    Statement::Query(q) =>
    match q.body {
      SetExpr::Select(sel) =>
      match sel.projection[0] {
        SelectItem::UnnamedExpr(e) => e
        _ => {
          debug_assert(false, "expected UnnamedExpr for " + expr_sql)
          Expr::Null
        }
      }
      _ => {
        debug_assert(false, "expected Select")
        Expr::Null
      }
    }
    _ => {
      debug_assert(false, "expected Query")
      Expr::Null
    }
  }
}

///|
test "pratt_precedence_or_and_not_comparison_add_mul_unary_cast" {
  // OR < AND < NOT < comparison < +/- < */% < unary < ::
  let e = parse_select_expr("a = 1 OR b = 2 AND NOT c + d * -e::INTEGER = 0", ParseOptions::postgres())
  // Top-level must be OR
  match e {
    Expr::BinaryOp(left, BinaryOperator::Or, right) => {
      match left {
        Expr::BinaryOp(_, BinaryOperator::Eq, _) => ()
        _ => debug_assert(false, "left of OR should be a = 1")
      }
      match right {
        Expr::BinaryOp(_, BinaryOperator::And, rhs_and) =>
        match rhs_and {
          Expr::UnaryOp(UnaryOperator::Not, cmp) =>
          match cmp {
            Expr::BinaryOp(lhs_cmp, BinaryOperator::Eq, _) =>
            match lhs_cmp {
              Expr::BinaryOp(_, BinaryOperator::Plus, mul_expr) =>
              match mul_expr {
                Expr::BinaryOp(_, BinaryOperator::Mul, neg_expr) =>
                match neg_expr {
                  Expr::UnaryOp(UnaryOperator::Minus, cast_expr) =>
                  match cast_expr {
                    Expr::Cast(_, DataType::Int(_), true) => ()
                    _ => debug_assert(false, "expected e::INTEGER inside unary minus")
                  }
                  _ => debug_assert(false, "expected unary minus")
                }
                _ => debug_assert(false, "expected mul")
              }
              _ => debug_assert(false, "expected plus")
            }
            _ => debug_assert(false, "expected Eq under NOT")
          }
          _ => debug_assert(false, "expected NOT on right of AND")
        }
        _ => debug_assert(false, "right of OR should be AND")
      }
    }
    _ => debug_assert(false, "top-level should be OR")
  }
}

///|
test "pratt_predicates_is_in_between_like_ilike" {
  match parse_select_expr("x IS NOT NULL", ParseOptions::default()) {
    Expr::IsNotNull(_) => ()
    _ => debug_assert(false, "expected IsNotNull")
  }
  match parse_select_expr("flag IS FALSE", ParseOptions::default()) {
    Expr::IsFalse(_) => ()
    _ => debug_assert(false, "expected IsFalse")
  }
  match parse_select_expr("x NOT IN (1, 2, 3)", ParseOptions::default()) {
    Expr::InList(_, list, true) => debug_assert(list.length() == 3, "3 items in IN list")
    _ => debug_assert(false, "expected InList negated")
  }
  // BETWEEN must bind tighter than AND so `a BETWEEN 1 AND 5 AND b = 2` parses cleanly!
  match parse_select_expr("a BETWEEN 1 AND 5 AND b = 2", ParseOptions::default()) {
    Expr::BinaryOp(Expr::Between(_, false, _, _), BinaryOperator::And, Expr::BinaryOp(_, BinaryOperator::Eq, _)) => ()
    _ => debug_assert(false, "BETWEEN ... AND ... followed by AND failed")
  }
  match parse_select_expr("name NOT ILIKE '%foo%' ESCAPE '!'", ParseOptions::postgres()) {
    Expr::Like(_, true, true, _, Some(esc)) => debug_assert(esc == "!", "escape char")
    _ => debug_assert(false, "expected NOT ILIKE with ESCAPE")
  }
}

///|
test "pratt_case_cast_functions_filter_arrays_tuples_json_ops" {
  // Simple CASE and searched CASE
  match parse_select_expr("CASE status WHEN 1 THEN 'ok' WHEN 2 THEN 'warn' ELSE 'err' END", ParseOptions::default()) {
    Expr::Case(Some(_), branches, Some(_)) => debug_assert(branches.length() == 2, "2 WHEN branches")
    _ => debug_assert(false, "expected simple CASE")
  }
  match parse_select_expr("CASE WHEN x > 0 THEN 1 ELSE 0 END", ParseOptions::default()) {
    Expr::Case(None, branches, Some(_)) => debug_assert(branches.length() == 1, "1 searched WHEN")
    _ => debug_assert(false, "expected searched CASE")
  }

  // CAST(x AS T)
  match parse_select_expr("CAST(price AS NUMERIC(10, 2))", ParseOptions::default()) {
    Expr::Cast(_, DataType::Numeric(Some(10), Some(2)), false) => ()
    _ => debug_assert(false, "expected CAST NUMERIC(10,2)")
  }

  // Function with DISTINCT and FILTER (WHERE ...)
  match parse_select_expr("COUNT(DISTINCT user_id) FILTER (WHERE status = 'paid')", ParseOptions::postgres()) {
    Expr::Function(fc) => {
      debug_assert(fc.distinct, "DISTINCT")
      debug_assert(fc.args.length() == 1, "1 arg")
      match fc.filter {
        Some(_) => ()
        None => debug_assert(false, "expected FILTER")
      }
    }
    _ => debug_assert(false, "expected Function")
  }

  // ARRAY literal + subscript
  match parse_select_expr("ARRAY[10, 20, 30][1]", ParseOptions::postgres()) {
    Expr::Subscript(Expr::Array(elems), Expr::Number(idx)) =>
    debug_assert(elems.length() == 3 && idx == "1", "ARRAY[10,20,30][1]")
    _ => debug_assert(false, "expected Subscript(Array)")
  }

  // Tuple comparison
  match parse_select_expr("(a, b) = (1, 2)", ParseOptions::default()) {
    Expr::BinaryOp(Expr::Tuple(l), BinaryOperator::Eq, Expr::Tuple(r)) =>
    debug_assert(l.length() == 2 && r.length() == 2, "tuple eq")
    _ => debug_assert(false, "expected Tuple Eq Tuple")
  }

  // Postgres JSON & regex operators
  match parse_select_expr("payload->'user'->>'email' ~* '^[a-z]+@'", ParseOptions::postgres()) {
    Expr::BinaryOp(
      Expr::BinaryOp(Expr::BinaryOp(_, BinaryOperator::Arrow, _), BinaryOperator::DoubleArrow, _),
      BinaryOperator::RegexIMatch,
      _,
    ) => ()
    _ => debug_assert(false, "expected JSON arrow chain + ~*")
  }
}
