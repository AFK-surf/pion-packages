///| Pure Pion SQL Lexer, Pratt Recursive-Descent AST Parser, Formatter, and Static Analyzer
///| supporting SQLite, PostgreSQL, and Generic dialects.

///| Tokenize SQL source using default (`Generic`) options.
pub fn tokenize(src : String) -> Result[Array[Token], SqlError] {
  tokenize_with_options(src, ParseOptions::default())
}

///| Tokenize SQL source with explicit `ParseOptions`.
pub fn tokenize_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], SqlError] {
  let _ = (src, opts)
  Err(SqlError::new(1, 1, 0, "not implemented"))
}

///| Parse one or more SQL statements using default (`Generic`) options.
pub fn parse(src : String) -> Result[Array[Statement], SqlError] {
  parse_with_options(src, ParseOptions::default())
}

///| Parse one or more SQL statements with explicit `ParseOptions`.
pub fn parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Statement], SqlError] {
  let _ = (src, opts)
  Err(SqlError::new(1, 1, 0, "not implemented"))
}

///| Parse a single SQL statement using default (`Generic`) options.
pub fn parse_one(src : String) -> Result[Statement, SqlError] {
  parse_one_with_options(src, ParseOptions::default())
}

///| Parse a single SQL statement with explicit `ParseOptions`.
pub fn parse_one_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Statement, SqlError] {
  let _ = (src, opts)
  Err(SqlError::new(1, 1, 0, "not implemented"))
}

///| Parse SQL statements using the SQLite dialect.
pub fn parse_sqlite(src : String) -> Result[Array[Statement], SqlError] {
  parse_with_options(src, ParseOptions::sqlite())
}

///| Parse SQL statements using the PostgreSQL dialect.
pub fn parse_postgres(src : String) -> Result[Array[Statement], SqlError] {
  parse_with_options(src, ParseOptions::postgres())
}

///| Format a single AST statement back into canonical SQL text.
pub fn to_sql(stmt : Statement) -> String {
  let _ = stmt
  ""
}

///| Format multiple AST statements into semicolon-separated SQL text.
pub fn statements_to_sql(stmts : Array[Statement]) -> String {
  let _ = stmts
  ""
}

///| Format a single expression AST node into canonical SQL text.
pub fn expr_to_sql(expr : Expr) -> String {
  let _ = expr
  ""
}

///| Structural AST equality for two statements.
pub fn stmt_eq(a : Statement, b : Statement) -> Bool {
  let _ = (a, b)
  false
}

///| Structural AST equality for two statement lists.
pub fn stmts_eq(a : Array[Statement], b : Array[Statement]) -> Bool {
  let _ = (a, b)
  false
}

///| Extract all referenced table names from a statement in encounter order (deduplicated, excluding CTE aliases).
pub fn extract_tables(stmt : Statement) -> Array[String] {
  let _ = stmt
  []
}

///| Extract all parameter placeholders (`?`, `?1`, `$1`, `:name`, `@name`) in encounter order.
pub fn extract_placeholders(stmt : Statement) -> Array[String] {
  let _ = stmt
  []
}

///| Split a multi-statement SQL script on top-level semicolons (respecting strings, dollar-quotes, and comments).
pub fn split_statements(src : String) -> Result[Array[String], SqlError] {
  let _ = src
  Err(SqlError::new(1, 1, 0, "not implemented"))
}
