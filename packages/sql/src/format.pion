///| Canonical SQL formatter (`to_sql`, `statements_to_sql`, `expr_to_sql`).

fn is_safe_unquoted_ident(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_ident_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_ident_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn write_double_quoted_ident(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\"\"")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

fn str_contains_sub(hay : String, needle : String) -> Bool {
  let hn = hay.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  let limit = hn - nn
  while i <= limit {
    let mut k = 0
    let mut ok = true
    while k < nn {
      if hay.code_unit_at(i + k) != needle.code_unit_at(k) {
        ok = false
        break
      }
      k = k + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

fn is_valid_dollar_tag(tag : String) -> Bool {
  let n = tag.length()
  if n == 0 {
    return true
  }
  let b0 = tag.code_unit_at(0)
  if !(is_ascii_alpha(b0) || b0 == 95) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_dollar_tag_char(tag.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn write_dollar_quoted(sb : StringBuilder, tag : String, body : String) -> Unit {
  let mut safe_tag = tag
  let mut delim = "$" + safe_tag + "$"
  if !is_valid_dollar_tag(safe_tag) || str_contains_sub(body, delim) {
    safe_tag = "q"
    delim = "$q$"
    let mut n = 1
    while str_contains_sub(body, delim) {
      safe_tag = "q" + n.to_string()
      delim = "$" + safe_tag + "$"
      n = n + 1
    }
  }
  sb.write_string(delim)
  sb.write_string(body)
  sb.write_string(delim)
}

fn write_ident(sb : StringBuilder, id : Ident) -> Unit {
  match id.quote_style {
    QuoteStyle::None =>
    if is_safe_unquoted_ident(id.value) {
      sb.write_string(id.value)
    } else {
      write_double_quoted_ident(sb, id.value)
    }
    QuoteStyle::DoubleQuote => write_double_quoted_ident(sb, id.value)
    QuoteStyle::Backtick => {
      sb.write_byte((96).to_byte())
      let n = id.value.length()
      let mut i = 0
      while i < n {
        let b = id.value.code_unit_at(i)
        if b == 96 {
          sb.write_string("``")
        } else {
          sb.write_byte(b.to_byte())
        }
        i = i + 1
      }
      sb.write_byte((96).to_byte())
    }
    QuoteStyle::Bracket => {
      let mut has_rbracket = false
      let n = id.value.length()
      let mut i = 0
      while i < n {
        if id.value.code_unit_at(i) == 93 {
          has_rbracket = true
          break
        }
        i = i + 1
      }
      if has_rbracket {
        write_double_quoted_ident(sb, id.value)
      } else {
        sb.write_byte((91).to_byte())
        sb.write_string(id.value)
        sb.write_byte((93).to_byte())
      }
    }
  }
}

fn write_object_name(sb : StringBuilder, name : ObjectName) -> Unit {
  let n = name.parts.length()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    write_ident(sb, name.parts[i])
    i = i + 1
  }
}

fn write_single_quoted(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((39).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 39 {
      sb.write_string("''")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((39).to_byte())
}

fn write_escaped_sql_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("E'")
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 10 {
      sb.write_string("\\n")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 39 {
      sb.write_string("\\'")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((39).to_byte())
}

fn write_data_type(sb : StringBuilder, dt : DataType) -> Unit {
  match dt {
    DataType::Int(None) => sb.write_string("INTEGER")
    DataType::Int(Some(n)) => {
      sb.write_string("INT(")
      sb.write_string(n.to_string())
      sb.write_byte((41).to_byte())
    }
    DataType::SmallInt => sb.write_string("SMALLINT")
    DataType::BigInt => sb.write_string("BIGINT")
    DataType::TinyInt => sb.write_string("TINYINT")
    DataType::Real => sb.write_string("REAL")
    DataType::Float(None) => sb.write_string("FLOAT")
    DataType::Float(Some(n)) => {
      sb.write_string("FLOAT(")
      sb.write_string(n.to_string())
      sb.write_byte((41).to_byte())
    }
    DataType::Double => sb.write_string("DOUBLE PRECISION")
    DataType::Numeric(p, s) => {
      sb.write_string("NUMERIC")
      match (p, s) {
        (Some(pv), Some(sv)) => {
          sb.write_byte((40).to_byte())
          sb.write_string(pv.to_string())
          sb.write_string(", ")
          sb.write_string(sv.to_string())
          sb.write_byte((41).to_byte())
        }
        (Some(pv), None) => {
          sb.write_byte((40).to_byte())
          sb.write_string(pv.to_string())
          sb.write_byte((41).to_byte())
        }
        _ => ()
      }
    }
    DataType::Decimal(p, s) => {
      sb.write_string("DECIMAL")
      match (p, s) {
        (Some(pv), Some(sv)) => {
          sb.write_byte((40).to_byte())
          sb.write_string(pv.to_string())
          sb.write_string(", ")
          sb.write_string(sv.to_string())
          sb.write_byte((41).to_byte())
        }
        (Some(pv), None) => {
          sb.write_byte((40).to_byte())
          sb.write_string(pv.to_string())
          sb.write_byte((41).to_byte())
        }
        _ => ()
      }
    }
    DataType::Boolean => sb.write_string("BOOLEAN")
    DataType::Text => sb.write_string("TEXT")
    DataType::Varchar(None) => sb.write_string("VARCHAR")
    DataType::Varchar(Some(n)) => {
      sb.write_string("VARCHAR(")
      sb.write_string(n.to_string())
      sb.write_byte((41).to_byte())
    }
    DataType::Char(None) => sb.write_string("CHAR")
    DataType::Char(Some(n)) => {
      sb.write_string("CHAR(")
      sb.write_string(n.to_string())
      sb.write_byte((41).to_byte())
    }
    DataType::Blob => sb.write_string("BLOB")
    DataType::Bytea => sb.write_string("BYTEA")
    DataType::Date => sb.write_string("DATE")
    DataType::Time => sb.write_string("TIME")
    DataType::Timestamp(tz) => {
      sb.write_string("TIMESTAMP")
      if tz {
        sb.write_string(" WITH TIME ZONE")
      }
    }
    DataType::Interval => sb.write_string("INTERVAL")
    DataType::Json => sb.write_string("JSON")
    DataType::Jsonb => sb.write_string("JSONB")
    DataType::Uuid => sb.write_string("UUID")
    DataType::Serial => sb.write_string("SERIAL")
    DataType::BigSerial => sb.write_string("BIGSERIAL")
    DataType::Array(inner) => {
      write_data_type(sb, inner)
      sb.write_string("[]")
    }
    DataType::Custom(name, params) => {
      write_object_name(sb, name)
      if params.length() > 0 {
        sb.write_byte((40).to_byte())
        let mut i = 0
        while i < params.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          sb.write_string(params[i])
          i = i + 1
        }
        sb.write_byte((41).to_byte())
      }
    }
    DataType::Unspecified => ()
  }
}

fn write_binary_op(sb : StringBuilder, op : BinaryOperator) -> Unit {
  match op {
    BinaryOperator::Or => sb.write_string(" OR ")
    BinaryOperator::And => sb.write_string(" AND ")
    BinaryOperator::Eq => sb.write_string(" = ")
    BinaryOperator::Neq => sb.write_string(" != ")
    BinaryOperator::Lt => sb.write_string(" < ")
    BinaryOperator::Gt => sb.write_string(" > ")
    BinaryOperator::LtEq => sb.write_string(" <= ")
    BinaryOperator::GtEq => sb.write_string(" >= ")
    BinaryOperator::Plus => sb.write_string(" + ")
    BinaryOperator::Minus => sb.write_string(" - ")
    BinaryOperator::Mul => sb.write_string(" * ")
    BinaryOperator::Div => sb.write_string(" / ")
    BinaryOperator::Mod => sb.write_string(" % ")
    BinaryOperator::Caret => sb.write_string(" ^ ")
    BinaryOperator::Concat => sb.write_string(" || ")
    BinaryOperator::BitwiseAnd => sb.write_string(" & ")
    BinaryOperator::BitwiseOr => sb.write_string(" | ")
    BinaryOperator::LShift => sb.write_string(" << ")
    BinaryOperator::RShift => sb.write_string(" >> ")
    BinaryOperator::Arrow => sb.write_string(" -> ")
    BinaryOperator::DoubleArrow => sb.write_string(" ->> ")
    BinaryOperator::HashArrow => sb.write_string(" #> ")
    BinaryOperator::HashDoubleArrow => sb.write_string(" #>> ")
    BinaryOperator::AtGt => sb.write_string(" @> ")
    BinaryOperator::LtAt => sb.write_string(" <@ ")
    BinaryOperator::RegexMatch => sb.write_string(" ~ ")
    BinaryOperator::RegexIMatch => sb.write_string(" ~* ")
    BinaryOperator::RegexNotMatch => sb.write_string(" !~ ")
    BinaryOperator::RegexNotIMatch => sb.write_string(" !~* ")
  }
}

fn write_window_bound(sb : StringBuilder, b : WindowFrameBound) -> Unit {
  match b {
    WindowFrameBound::CurrentRow => sb.write_string("CURRENT ROW")
    WindowFrameBound::Preceding(None) => sb.write_string("UNBOUNDED PRECEDING")
    WindowFrameBound::Preceding(Some(e)) => {
      write_expr(sb, e)
      sb.write_string(" PRECEDING")
    }
    WindowFrameBound::Following(None) => sb.write_string("UNBOUNDED FOLLOWING")
    WindowFrameBound::Following(Some(e)) => {
      write_expr(sb, e)
      sb.write_string(" FOLLOWING")
    }
  }
}

fn write_window_spec(sb : StringBuilder, ws : WindowSpec) -> Unit {
  sb.write_byte((40).to_byte())
  let mut need_space = false
  if ws.partition_by.length() > 0 {
    sb.write_string("PARTITION BY ")
    let mut i = 0
    while i < ws.partition_by.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      write_expr(sb, ws.partition_by[i])
      i = i + 1
    }
    need_space = true
  }
  if ws.order_by.length() > 0 {
    if need_space {
      sb.write_byte((32).to_byte())
    }
    sb.write_string("ORDER BY ")
    let mut i = 0
    while i < ws.order_by.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      write_order_by_expr(sb, ws.order_by[i])
      i = i + 1
    }
    need_space = true
  }
  match ws.window_frame {
    Some(wf) => {
      if need_space {
        sb.write_byte((32).to_byte())
      }
      match wf.units {
        WindowFrameUnits::Rows => sb.write_string("ROWS ")
        WindowFrameUnits::Range => sb.write_string("RANGE ")
        WindowFrameUnits::Groups => sb.write_string("GROUPS ")
      }
      match wf.end_bound {
        Some(eb) => {
          sb.write_string("BETWEEN ")
          write_window_bound(sb, wf.start_bound)
          sb.write_string(" AND ")
          write_window_bound(sb, eb)
        }
        None => write_window_bound(sb, wf.start_bound)
      }
    }
    None => ()
  }
  sb.write_byte((41).to_byte())
}

fn write_expr(sb : StringBuilder, expr : Expr) -> Unit {
  match expr {
    Expr::Identifier(id) => write_ident(sb, id)
    Expr::CompoundIdentifier(parts) => {
      let mut i = 0
      while i < parts.length() {
        if i > 0 {
          sb.write_byte((46).to_byte())
        }
        write_ident(sb, parts[i])
        i = i + 1
      }
    }
    Expr::Number(n) => sb.write_string(n)
    Expr::SingleQuotedString(s) => write_single_quoted(sb, s)
    Expr::EscapedString(s) => write_escaped_sql_string(sb, s)
    Expr::DollarQuotedString(tag, body) => write_dollar_quoted(sb, tag, body)
    Expr::HexStringLiteral(h) => {
      sb.write_string("X'")
      sb.write_string(h)
      sb.write_byte((39).to_byte())
    }
    Expr::Boolean(b) => sb.write_string(if b { "TRUE" } else { "FALSE" })
    Expr::Null => sb.write_string("NULL")
    Expr::Default => sb.write_string("DEFAULT")
    Expr::Placeholder(p) => sb.write_string(p)
    Expr::Wildcard => sb.write_byte((42).to_byte())
    Expr::QualifiedWildcard(name) => {
      write_object_name(sb, name)
      sb.write_string(".*")
    }
    Expr::UnaryOp(op, inner) => {
      match op {
        UnaryOperator::Plus =>
        match inner {
          Expr::UnaryOp(UnaryOperator::Plus, _) => sb.write_string("+ ")
          _ => sb.write_byte((43).to_byte())
        }
        UnaryOperator::Minus =>
        match inner {
          Expr::UnaryOp(UnaryOperator::Minus, _) => sb.write_string("- ")
          Expr::Number(num) =>
          if num.length() > 0 && num.code_unit_at(0) == 45 {
            sb.write_string("- ")
          } else {
            sb.write_byte((45).to_byte())
          }
          _ => sb.write_byte((45).to_byte())
        }
        UnaryOperator::Not => sb.write_string("NOT ")
        UnaryOperator::BitwiseNot => sb.write_byte((126).to_byte())
      }
      write_expr(sb, inner)
    }
    Expr::PrefixOp(sym, inner) => {
      sb.write_string(sym)
      sb.write_byte((32).to_byte())
      write_expr(sb, inner)
    }
    Expr::BinaryOp(l, op, r) => {
      write_expr(sb, l)
      write_binary_op(sb, op)
      write_expr(sb, r)
    }
    Expr::AnyAllOp(l, op, is_all, r) => {
      write_expr(sb, l)
      write_binary_op(sb, op)
      sb.write_string(if is_all { "ALL (" } else { "ANY (" })
      write_expr(sb, r)
      sb.write_byte((41).to_byte())
    }
    Expr::IsNull(e) => {
      write_expr(sb, e)
      sb.write_string(" IS NULL")
    }
    Expr::IsNotNull(e) => {
      write_expr(sb, e)
      sb.write_string(" IS NOT NULL")
    }
    Expr::IsTrue(e) => {
      write_expr(sb, e)
      sb.write_string(" IS TRUE")
    }
    Expr::IsNotTrue(e) => {
      write_expr(sb, e)
      sb.write_string(" IS NOT TRUE")
    }
    Expr::IsFalse(e) => {
      write_expr(sb, e)
      sb.write_string(" IS FALSE")
    }
    Expr::IsNotFalse(e) => {
      write_expr(sb, e)
      sb.write_string(" IS NOT FALSE")
    }
    Expr::IsDistinctFrom(l, r) => {
      write_expr(sb, l)
      sb.write_string(" IS DISTINCT FROM ")
      write_expr(sb, r)
    }
    Expr::IsNotDistinctFrom(l, r) => {
      write_expr(sb, l)
      sb.write_string(" IS NOT DISTINCT FROM ")
      write_expr(sb, r)
    }
    Expr::InList(e, list, neg) => {
      write_expr(sb, e)
      sb.write_string(if neg { " NOT IN (" } else { " IN (" })
      let mut i = 0
      while i < list.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, list[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    Expr::InSubquery(e, q, neg) => {
      write_expr(sb, e)
      sb.write_string(if neg { " NOT IN (" } else { " IN (" })
      write_query(sb, q)
      sb.write_byte((41).to_byte())
    }
    Expr::Between(e, neg, low, high) => {
      write_expr(sb, e)
      sb.write_string(if neg { " NOT BETWEEN " } else { " BETWEEN " })
      write_expr(sb, low)
      sb.write_string(" AND ")
      write_expr(sb, high)
    }
    Expr::Like(e, neg, ci, pat, esc) => {
      write_expr(sb, e)
      if neg {
        sb.write_string(" NOT")
      }
      sb.write_string(if ci { " ILIKE " } else { " LIKE " })
      write_expr(sb, pat)
      match esc {
        Some(es) => {
          sb.write_string(" ESCAPE ")
          write_single_quoted(sb, es)
        }
        None => ()
      }
    }
    Expr::SimilarTo(e, neg, pat, esc) => {
      write_expr(sb, e)
      if neg {
        sb.write_string(" NOT")
      }
      sb.write_string(" SIMILAR TO ")
      write_expr(sb, pat)
      match esc {
        Some(es) => {
          sb.write_string(" ESCAPE ")
          write_single_quoted(sb, es)
        }
        None => ()
      }
    }
    Expr::PatternOp(e, neg, op_name, pat) => {
      write_expr(sb, e)
      if neg {
        sb.write_string(" NOT")
      }
      sb.write_byte((32).to_byte())
      sb.write_string(op_name)
      sb.write_byte((32).to_byte())
      write_expr(sb, pat)
    }
    Expr::Cast(e, dt, pg_style) => {
      if pg_style {
        write_expr(sb, e)
        sb.write_string("::")
        write_data_type(sb, dt)
      } else {
        sb.write_string("CAST(")
        write_expr(sb, e)
        sb.write_string(" AS ")
        write_data_type(sb, dt)
        sb.write_byte((41).to_byte())
      }
    }
    Expr::TypedString(dt, s) => {
      write_data_type(sb, dt)
      sb.write_byte((32).to_byte())
      write_single_quoted(sb, s)
    }
    Expr::Extract(field, e) => {
      sb.write_string("EXTRACT(")
      write_ident(sb, field)
      sb.write_string(" FROM ")
      write_expr(sb, e)
      sb.write_byte((41).to_byte())
    }
    Expr::Position(sub, src_e) => {
      sb.write_string("POSITION(")
      write_expr(sb, sub)
      sb.write_string(" IN ")
      write_expr(sb, src_e)
      sb.write_byte((41).to_byte())
    }
    Expr::Substring(e, from_e, for_e) => {
      sb.write_string("SUBSTRING(")
      write_expr(sb, e)
      match from_e {
        Some(f) => {
          sb.write_string(" FROM ")
          write_expr(sb, f)
        }
        None => ()
      }
      match for_e {
        Some(f) => {
          sb.write_string(" FOR ")
          write_expr(sb, f)
        }
        None => ()
      }
      sb.write_byte((41).to_byte())
    }
    Expr::Trim(where_kw, chars, e) => {
      sb.write_string("TRIM(")
      match where_kw {
        Some(w) => {
          sb.write_string(w)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      match chars {
        Some(c) => {
          write_expr(sb, c)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      sb.write_string("FROM ")
      write_expr(sb, e)
      sb.write_byte((41).to_byte())
    }
    Expr::Nested(e) => {
      sb.write_byte((40).to_byte())
      write_expr(sb, e)
      sb.write_byte((41).to_byte())
    }
    Expr::Tuple(items) => {
      sb.write_byte((40).to_byte())
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, items[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    Expr::Array(items) => {
      sb.write_string("ARRAY[")
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    Expr::ArraySubquery(q) => {
      sb.write_string("ARRAY(")
      write_query(sb, q)
      sb.write_byte((41).to_byte())
    }
    Expr::Subscript(base, idx) => {
      write_expr(sb, base)
      sb.write_byte((91).to_byte())
      write_expr(sb, idx)
      sb.write_byte((93).to_byte())
    }
    Expr::Slice(base, lo, hi) => {
      write_expr(sb, base)
      sb.write_byte((91).to_byte())
      match lo {
        Some(e) => write_expr(sb, e)
        None => ()
      }
      sb.write_byte((58).to_byte())
      match hi {
        Some(e) => write_expr(sb, e)
        None => ()
      }
      sb.write_byte((93).to_byte())
    }
    Expr::Function(fc) => {
      write_object_name(sb, fc.name)
      sb.write_byte((40).to_byte())
      if fc.distinct {
        sb.write_string("DISTINCT ")
      }
      let mut i = 0
      while i < fc.args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, fc.args[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
      match fc.filter {
        Some(f) => {
          sb.write_string(" FILTER (WHERE ")
          write_expr(sb, f)
          sb.write_byte((41).to_byte())
        }
        None => ()
      }
      match fc.over {
        Some(ws) => {
          sb.write_string(" OVER ")
          write_window_spec(sb, ws)
        }
        None => ()
      }
    }
    Expr::AggregateCall(fc, arg_order, within_group, over_name) => {
      write_object_name(sb, fc.name)
      sb.write_byte((40).to_byte())
      if fc.distinct {
        sb.write_string("DISTINCT ")
      }
      let mut i = 0
      while i < fc.args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, fc.args[i])
        i = i + 1
      }
      if arg_order.length() > 0 {
        sb.write_string(" ORDER BY ")
        let mut j = 0
        while j < arg_order.length() {
          if j > 0 { sb.write_string(", ") }
          write_order_by_expr(sb, arg_order[j])
          j = j + 1
        }
      }
      sb.write_byte((41).to_byte())
      if within_group.length() > 0 {
        sb.write_string(" WITHIN GROUP (ORDER BY ")
        let mut j = 0
        while j < within_group.length() {
          if j > 0 { sb.write_string(", ") }
          write_order_by_expr(sb, within_group[j])
          j = j + 1
        }
        sb.write_byte((41).to_byte())
      }
      match fc.filter {
        Some(f) => {
          sb.write_string(" FILTER (WHERE ")
          write_expr(sb, f)
          sb.write_byte((41).to_byte())
        }
        None => ()
      }
      match over_name {
        Some(wn) => {
          sb.write_string(" OVER ")
          write_ident(sb, wn)
        }
        None =>
        match fc.over {
          Some(ws) => {
            sb.write_string(" OVER ")
            write_window_spec(sb, ws)
          }
          None => ()
        }
      }
    }
    Expr::Case(operand, branches, else_res) => {
      sb.write_string("CASE")
      match operand {
        Some(op) => {
          sb.write_byte((32).to_byte())
          write_expr(sb, op)
        }
        None => ()
      }
      let mut i = 0
      while i < branches.length() {
        let (cond, res) = branches[i]
        sb.write_string(" WHEN ")
        write_expr(sb, cond)
        sb.write_string(" THEN ")
        write_expr(sb, res)
        i = i + 1
      }
      match else_res {
        Some(er) => {
          sb.write_string(" ELSE ")
          write_expr(sb, er)
        }
        None => ()
      }
      sb.write_string(" END")
    }
    Expr::Subquery(q) => {
      sb.write_byte((40).to_byte())
      write_query(sb, q)
      sb.write_byte((41).to_byte())
    }
    Expr::Exists(q, neg) => {
      if neg {
        sb.write_string("NOT ")
      }
      sb.write_string("EXISTS (")
      write_query(sb, q)
      sb.write_byte((41).to_byte())
    }
    Expr::Collate(e, col) => {
      write_expr(sb, e)
      sb.write_string(" COLLATE ")
      write_object_name(sb, col)
    }
    Expr::GroupingSet(kind, items) => {
      sb.write_string(kind)
      sb.write_string(" (")
      let mut i = 0
      while i < items.length() {
        if i > 0 { sb.write_string(", ") }
        write_expr(sb, items[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
  }
}

fn write_order_by_expr(sb : StringBuilder, o : OrderByExpr) -> Unit {
  write_expr(sb, o.expr)
  match o.asc {
    Some(true) => sb.write_string(" ASC")
    Some(false) => sb.write_string(" DESC")
    None => ()
  }
  match o.nulls_first {
    Some(true) => sb.write_string(" NULLS FIRST")
    Some(false) => sb.write_string(" NULLS LAST")
    None => ()
  }
}

fn write_select_item(sb : StringBuilder, item : SelectItem) -> Unit {
  match item {
    SelectItem::UnnamedExpr(e) => write_expr(sb, e)
    SelectItem::ExprWithAlias(e, alias) => {
      write_expr(sb, e)
      sb.write_string(" AS ")
      write_ident(sb, alias)
    }
    SelectItem::Wildcard => sb.write_byte((42).to_byte())
    SelectItem::QualifiedWildcard(name) => {
      write_object_name(sb, name)
      sb.write_string(".*")
    }
  }
}

fn write_table_alias(sb : StringBuilder, alias : TableAlias) -> Unit {
  sb.write_string(" AS ")
  write_ident(sb, alias.name)
  if alias.columns.length() > 0 {
    sb.write_byte((40).to_byte())
    let mut i = 0
    while i < alias.columns.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      write_ident(sb, alias.columns[i])
      i = i + 1
    }
    sb.write_byte((41).to_byte())
  }
}

fn write_table_factor(sb : StringBuilder, tf : TableFactor) -> Unit {
  match tf {
    TableFactor::Table(name, alias) => {
      write_object_name(sb, name)
      match alias {
        Some(a) => write_table_alias(sb, a)
        None => ()
      }
    }
    TableFactor::Derived(lateral, q, alias) => {
      if lateral {
        sb.write_string("LATERAL ")
      }
      sb.write_byte((40).to_byte())
      write_query(sb, q)
      sb.write_byte((41).to_byte())
      match alias {
        Some(a) => write_table_alias(sb, a)
        None => ()
      }
    }
    TableFactor::NestedJoin(twj) => {
      sb.write_byte((40).to_byte())
      write_table_with_joins(sb, twj)
      sb.write_byte((41).to_byte())
    }
    TableFactor::TableFunction(name, args, alias) => {
      write_object_name(sb, name)
      sb.write_byte((40).to_byte())
      let mut i = 0
      while i < args.length() {
        if i > 0 { sb.write_string(", ") }
        write_expr(sb, args[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
      match alias {
        Some(a) => write_table_alias(sb, a)
        None => ()
      }
    }
  }
}

fn write_join_constraint(sb : StringBuilder, c : JoinConstraint) -> Unit {
  match c {
    JoinConstraint::On(e) => {
      sb.write_string(" ON ")
      write_expr(sb, e)
    }
    JoinConstraint::Using(cols) => {
      sb.write_string(" USING (")
      let mut i = 0
      while i < cols.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_ident(sb, cols[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    JoinConstraint::None => ()
  }
}

fn write_table_with_joins(sb : StringBuilder, twj : TableWithJoins) -> Unit {
  write_table_factor(sb, twj.relation)
  let mut i = 0
  while i < twj.joins.length() {
    let j = twj.joins[i]
    match j.join_operator {
      JoinOperator::Inner(c) => {
        sb.write_string(" INNER JOIN ")
        write_table_factor(sb, j.relation)
        write_join_constraint(sb, c)
      }
      JoinOperator::LeftOuter(c) => {
        sb.write_string(" LEFT JOIN ")
        write_table_factor(sb, j.relation)
        write_join_constraint(sb, c)
      }
      JoinOperator::RightOuter(c) => {
        sb.write_string(" RIGHT JOIN ")
        write_table_factor(sb, j.relation)
        write_join_constraint(sb, c)
      }
      JoinOperator::FullOuter(c) => {
        sb.write_string(" FULL OUTER JOIN ")
        write_table_factor(sb, j.relation)
        write_join_constraint(sb, c)
      }
      JoinOperator::CrossJoin => {
        sb.write_string(" CROSS JOIN ")
        write_table_factor(sb, j.relation)
      }
      JoinOperator::NaturalInner => {
        sb.write_string(" NATURAL INNER JOIN ")
        write_table_factor(sb, j.relation)
      }
      JoinOperator::NaturalLeft => {
        sb.write_string(" NATURAL LEFT JOIN ")
        write_table_factor(sb, j.relation)
      }
      JoinOperator::NaturalRight => {
        sb.write_string(" NATURAL RIGHT JOIN ")
        write_table_factor(sb, j.relation)
      }
      JoinOperator::NaturalFull => {
        sb.write_string(" NATURAL FULL OUTER JOIN ")
        write_table_factor(sb, j.relation)
      }
    }
    i = i + 1
  }
}

fn write_select(sb : StringBuilder, sel : Select) -> Unit {
  sb.write_string("SELECT ")
  match sel.distinct {
    DistinctKind::None => ()
    DistinctKind::Distinct => sb.write_string("DISTINCT ")
    DistinctKind::All => sb.write_string("ALL ")
    DistinctKind::DistinctOn(exprs) => {
      sb.write_string("DISTINCT ON (")
      let mut i = 0
      while i < exprs.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, exprs[i])
        i = i + 1
      }
      sb.write_string(") ")
    }
  }
  let mut i = 0
  while i < sel.projection.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    write_select_item(sb, sel.projection[i])
    i = i + 1
  }
  if sel.from.length() > 0 {
    sb.write_string(" FROM ")
    let mut j = 0
    while j < sel.from.length() {
      if j > 0 {
        sb.write_string(", ")
      }
      write_table_with_joins(sb, sel.from[j])
      j = j + 1
    }
  }
  match sel.selection {
    Some(w) => {
      sb.write_string(" WHERE ")
      write_expr(sb, w)
    }
    None => ()
  }
  if sel.group_by.length() > 0 {
    sb.write_string(" GROUP BY ")
    let mut k = 0
    while k < sel.group_by.length() {
      if k > 0 {
        sb.write_string(", ")
      }
      write_expr(sb, sel.group_by[k])
      k = k + 1
    }
  }
  match sel.having {
    Some(h) => {
      sb.write_string(" HAVING ")
      write_expr(sb, h)
    }
    None => ()
  }
}

fn write_set_expr(sb : StringBuilder, body : SetExpr) -> Unit {
  match body {
    SetExpr::Select(sel) => write_select(sb, sel)
    SetExpr::Query(q) => {
      sb.write_byte((40).to_byte())
      write_query(sb, q)
      sb.write_byte((41).to_byte())
    }
    SetExpr::SetOperation(op, all, l, r) => {
      write_set_expr(sb, l)
      match op {
        SetOperator::Union => sb.write_string(" UNION ")
        SetOperator::Intersect => sb.write_string(" INTERSECT ")
        SetOperator::Except => sb.write_string(" EXCEPT ")
      }
      if all {
        sb.write_string("ALL ")
      }
      write_set_expr(sb, r)
    }
    SetExpr::Values(rows) => {
      sb.write_string("VALUES ")
      let mut i = 0
      while i < rows.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_byte((40).to_byte())
        let row = rows[i]
        let mut j = 0
        while j < row.length() {
          if j > 0 {
            sb.write_string(", ")
          }
          write_expr(sb, row[j])
          j = j + 1
        }
        sb.write_byte((41).to_byte())
        i = i + 1
      }
    }
    SetExpr::DefaultValues => sb.write_string("DEFAULT VALUES")
    SetExpr::SelectWithWindows(sel, wins) => {
      write_select(sb, sel)
      if wins.length() > 0 {
        sb.write_string(" WINDOW ")
        let mut i = 0
        while i < wins.length() {
          if i > 0 { sb.write_string(", ") }
          let (wn, ws) = wins[i]
          write_ident(sb, wn)
          sb.write_string(" AS ")
          write_window_spec(sb, ws)
          i = i + 1
        }
      }
    }
    SetExpr::TableRef(name) => {
      sb.write_string("TABLE ")
      write_object_name(sb, name)
    }
  }
}

fn write_query(sb : StringBuilder, q : Query) -> Unit {
  match q.with_clause {
    Some(w) => {
      sb.write_string("WITH ")
      if w.recursive {
        sb.write_string("RECURSIVE ")
      }
      let mut i = 0
      while i < w.cte_tables.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        let cte = w.cte_tables[i]
        write_ident(sb, cte.alias)
        if cte.columns.length() > 0 {
          sb.write_byte((40).to_byte())
          let mut c = 0
          while c < cte.columns.length() {
            if c > 0 {
              sb.write_string(", ")
            }
            write_ident(sb, cte.columns[c])
            c = c + 1
          }
          sb.write_byte((41).to_byte())
        }
        sb.write_string(" AS ")
        match cte.materialized {
          Some(true) => sb.write_string("MATERIALIZED ")
          Some(false) => sb.write_string("NOT MATERIALIZED ")
          None => ()
        }
        sb.write_byte((40).to_byte())
        write_query(sb, cte.query)
        sb.write_byte((41).to_byte())
        i = i + 1
      }
      sb.write_byte((32).to_byte())
    }
    None => ()
  }
  write_set_expr(sb, q.body)
  if q.order_by.length() > 0 {
    sb.write_string(" ORDER BY ")
    let mut i = 0
    while i < q.order_by.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      write_order_by_expr(sb, q.order_by[i])
      i = i + 1
    }
  }
  match q.limit {
    Some(lim) => {
      sb.write_string(" LIMIT ")
      write_expr(sb, lim)
    }
    None => ()
  }
  match q.offset {
    Some(off) => {
      sb.write_string(" OFFSET ")
      write_expr(sb, off)
    }
    None => ()
  }
}

fn write_ref_action(sb : StringBuilder, act : ReferentialAction) -> Unit {
  match act {
    ReferentialAction::Cascade => sb.write_string("CASCADE")
    ReferentialAction::SetNull => sb.write_string("SET NULL")
    ReferentialAction::SetDefault => sb.write_string("SET DEFAULT")
    ReferentialAction::Restrict => sb.write_string("RESTRICT")
    ReferentialAction::NoAction => sb.write_string("NO ACTION")
  }
}

fn write_column_constraint(sb : StringBuilder, cc : ColumnConstraint) -> Unit {
  match cc {
    ColumnConstraint::NotNull => sb.write_string(" NOT NULL")
    ColumnConstraint::Null => sb.write_string(" NULL")
    ColumnConstraint::PrimaryKey(autoinc) => {
      sb.write_string(" PRIMARY KEY")
      if autoinc {
        sb.write_string(" AUTOINCREMENT")
      }
    }
    ColumnConstraint::Unique => sb.write_string(" UNIQUE")
    ColumnConstraint::Default(e) => {
      sb.write_string(" DEFAULT ")
      write_expr(sb, e)
    }
    ColumnConstraint::Check(e) => {
      sb.write_string(" CHECK (")
      write_expr(sb, e)
      sb.write_byte((41).to_byte())
    }
    ColumnConstraint::References(tbl, cols, on_del, on_upd) => {
      sb.write_string(" REFERENCES ")
      write_object_name(sb, tbl)
      if cols.length() > 0 {
        sb.write_byte((40).to_byte())
        let mut j = 0
        while j < cols.length() {
          if j > 0 {
            sb.write_string(", ")
          }
          write_ident(sb, cols[j])
          j = j + 1
        }
        sb.write_byte((41).to_byte())
      }
      match on_del {
        Some(act) => {
          sb.write_string(" ON DELETE ")
          write_ref_action(sb, act)
        }
        None => ()
      }
      match on_upd {
        Some(act) => {
          sb.write_string(" ON UPDATE ")
          write_ref_action(sb, act)
        }
        None => ()
      }
    }
    ColumnConstraint::Named(n, inner) => {
      sb.write_string(" CONSTRAINT ")
      write_ident(sb, n)
      write_column_constraint(sb, inner)
    }
    ColumnConstraint::Generated(expr_opt, always, stored) => {
      sb.write_string(if always { " GENERATED ALWAYS AS " } else { " GENERATED BY DEFAULT AS " })
      match expr_opt {
        Some(e) => {
          sb.write_byte((40).to_byte())
          write_expr(sb, e)
          sb.write_byte((41).to_byte())
          if stored {
            sb.write_string(" STORED")
          }
        }
        None => sb.write_string("IDENTITY")
      }
    }
  }
}

fn write_column_def(sb : StringBuilder, col : ColumnDef) -> Unit {
  write_ident(sb, col.name)
  match col.data_type {
    DataType::Unspecified => ()
    _ => {
      sb.write_byte((32).to_byte())
      write_data_type(sb, col.data_type)
    }
  }
  let mut i = 0
  while i < col.constraints.length() {
    write_column_constraint(sb, col.constraints[i])
    i = i + 1
  }
}

fn write_table_constraint(sb : StringBuilder, tc : TableConstraint) -> Unit {
  match tc {
    TableConstraint::PrimaryKey(name, cols) => {
      match name {
        Some(n) => {
          sb.write_string("CONSTRAINT ")
          write_ident(sb, n)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      sb.write_string("PRIMARY KEY (")
      let mut i = 0
      while i < cols.length() {
        if i > 0 { sb.write_string(", ") }
        write_ident(sb, cols[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    TableConstraint::Unique(name, cols) => {
      match name {
        Some(n) => {
          sb.write_string("CONSTRAINT ")
          write_ident(sb, n)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      sb.write_string("UNIQUE (")
      let mut i = 0
      while i < cols.length() {
        if i > 0 { sb.write_string(", ") }
        write_ident(sb, cols[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    TableConstraint::Check(name, e) => {
      match name {
        Some(n) => {
          sb.write_string("CONSTRAINT ")
          write_ident(sb, n)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      sb.write_string("CHECK (")
      write_expr(sb, e)
      sb.write_byte((41).to_byte())
    }
    TableConstraint::ForeignKey(name, cols, ref_tbl, ref_cols, on_del, on_upd) => {
      match name {
        Some(n) => {
          sb.write_string("CONSTRAINT ")
          write_ident(sb, n)
          sb.write_byte((32).to_byte())
        }
        None => ()
      }
      sb.write_string("FOREIGN KEY (")
      let mut i = 0
      while i < cols.length() {
        if i > 0 { sb.write_string(", ") }
        write_ident(sb, cols[i])
        i = i + 1
      }
      sb.write_string(") REFERENCES ")
      write_object_name(sb, ref_tbl)
      if ref_cols.length() > 0 {
        sb.write_byte((40).to_byte())
        let mut j = 0
        while j < ref_cols.length() {
          if j > 0 { sb.write_string(", ") }
          write_ident(sb, ref_cols[j])
          j = j + 1
        }
        sb.write_byte((41).to_byte())
      }
      match on_del {
        Some(act) => {
          sb.write_string(" ON DELETE ")
          write_ref_action(sb, act)
        }
        None => ()
      }
      match on_upd {
        Some(act) => {
          sb.write_string(" ON UPDATE ")
          write_ref_action(sb, act)
        }
        None => ()
      }
    }
  }
}

fn write_returning(sb : StringBuilder, items : Array[SelectItem]) -> Unit {
  if items.length() > 0 {
    sb.write_string(" RETURNING ")
    let mut i = 0
    while i < items.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      write_select_item(sb, items[i])
      i = i + 1
    }
  }
}

fn write_insert_body(sb : StringBuilder, ins : InsertStmt) -> Unit {
  write_object_name(sb, ins.table_name)
  if ins.columns.length() > 0 {
    sb.write_string(" (")
    let mut i = 0
    while i < ins.columns.length() {
      if i > 0 { sb.write_string(", ") }
      write_ident(sb, ins.columns[i])
      i = i + 1
    }
    sb.write_byte((41).to_byte())
  }
  sb.write_byte((32).to_byte())
  write_query(sb, ins.source)
  match ins.on_conflict {
    Some(oc) => {
      sb.write_string(" ON CONFLICT")
      if oc.target_columns.length() > 0 {
        sb.write_string(" (")
        let mut i = 0
        while i < oc.target_columns.length() {
          if i > 0 { sb.write_string(", ") }
          write_ident(sb, oc.target_columns[i])
          i = i + 1
        }
        sb.write_byte((41).to_byte())
      }
      match oc.action {
        OnConflictAction::DoNothing => sb.write_string(" DO NOTHING")
        OnConflictAction::DoUpdate(assigns, wh) => {
          sb.write_string(" DO UPDATE SET ")
          let mut i = 0
          while i < assigns.length() {
            if i > 0 { sb.write_string(", ") }
            write_ident(sb, assigns[i].target)
            sb.write_string(" = ")
            write_expr(sb, assigns[i].value)
            i = i + 1
          }
          match wh {
            Some(w) => {
              sb.write_string(" WHERE ")
              write_expr(sb, w)
            }
            None => ()
          }
        }
      }
    }
    None => ()
  }
  write_returning(sb, ins.returning)
}

fn write_stmt(sb : StringBuilder, stmt : Statement) -> Unit {
  match stmt {
    Statement::Query(q) => write_query(sb, q)
    Statement::QueryLocked(q, lock_clause) => {
      write_query(sb, q)
      sb.write_byte((32).to_byte())
      sb.write_string(lock_clause)
    }
    Statement::Insert(ins) => {
      sb.write_string("INSERT INTO ")
      write_insert_body(sb, ins)
    }
    Statement::InsertOr(or_opt, ins) => {
      match or_opt {
        Some(action) => {
          sb.write_string("INSERT OR ")
          sb.write_string(action)
          sb.write_string(" INTO ")
        }
        None => sb.write_string("REPLACE INTO ")
      }
      write_insert_body(sb, ins)
    }
    Statement::Update(upd) => {
      sb.write_string("UPDATE ")
      write_table_with_joins(sb, upd.table)
      sb.write_string(" SET ")
      let mut i = 0
      while i < upd.assignments.length() {
        if i > 0 { sb.write_string(", ") }
        write_ident(sb, upd.assignments[i].target)
        sb.write_string(" = ")
        write_expr(sb, upd.assignments[i].value)
        i = i + 1
      }
      if upd.from.length() > 0 {
        sb.write_string(" FROM ")
        let mut j = 0
        while j < upd.from.length() {
          if j > 0 { sb.write_string(", ") }
          write_table_with_joins(sb, upd.from[j])
          j = j + 1
        }
      }
      match upd.selection {
        Some(w) => {
          sb.write_string(" WHERE ")
          write_expr(sb, w)
        }
        None => ()
      }
      write_returning(sb, upd.returning)
    }
    Statement::UpdateMulti(table, assigns, from, selection, returning) => {
      sb.write_string("UPDATE ")
      write_table_with_joins(sb, table)
      sb.write_string(" SET ")
      let mut i = 0
      while i < assigns.length() {
        if i > 0 { sb.write_string(", ") }
        let (cols, av) = assigns[i]
        if cols.length() == 1 {
          write_ident(sb, cols[0])
        } else {
          sb.write_byte((40).to_byte())
          let mut c = 0
          while c < cols.length() {
            if c > 0 { sb.write_string(", ") }
            write_ident(sb, cols[c])
            c = c + 1
          }
          sb.write_byte((41).to_byte())
        }
        sb.write_string(" = ")
        write_expr(sb, av)
        i = i + 1
      }
      if from.length() > 0 {
        sb.write_string(" FROM ")
        let mut j = 0
        while j < from.length() {
          if j > 0 { sb.write_string(", ") }
          write_table_with_joins(sb, from[j])
          j = j + 1
        }
      }
      match selection {
        Some(w) => {
          sb.write_string(" WHERE ")
          write_expr(sb, w)
        }
        None => ()
      }
      write_returning(sb, returning)
    }
    Statement::Delete(del) => {
      sb.write_string("DELETE FROM ")
      write_table_with_joins(sb, del.from)
      match del.selection {
        Some(w) => {
          sb.write_string(" WHERE ")
          write_expr(sb, w)
        }
        None => ()
      }
      write_returning(sb, del.returning)
    }
    Statement::DeleteUsing(from, using_tbls, selection, returning) => {
      sb.write_string("DELETE FROM ")
      write_table_with_joins(sb, from)
      if using_tbls.length() > 0 {
        sb.write_string(" USING ")
        let mut i = 0
        while i < using_tbls.length() {
          if i > 0 { sb.write_string(", ") }
          write_table_with_joins(sb, using_tbls[i])
          i = i + 1
        }
      }
      match selection {
        Some(w) => {
          sb.write_string(" WHERE ")
          write_expr(sb, w)
        }
        None => ()
      }
      write_returning(sb, returning)
    }
    Statement::CreateTable(ct) => {
      sb.write_string("CREATE ")
      if ct.temporary { sb.write_string("TEMP ") }
      sb.write_string("TABLE ")
      if ct.if_not_exists { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, ct.name)
      sb.write_string(" (")
      let mut first = true
      let mut i = 0
      while i < ct.columns.length() {
        if !first { sb.write_string(", ") }
        first = false
        write_column_def(sb, ct.columns[i])
        i = i + 1
      }
      let mut j = 0
      while j < ct.constraints.length() {
        if !first { sb.write_string(", ") }
        first = false
        write_table_constraint(sb, ct.constraints[j])
        j = j + 1
      }
      sb.write_byte((41).to_byte())
      if ct.without_rowid { sb.write_string(" WITHOUT ROWID") }
    }
    Statement::CreateTableAs(temp, if_ne, name, q) => {
      sb.write_string("CREATE ")
      if temp { sb.write_string("TEMP ") }
      sb.write_string("TABLE ")
      if if_ne { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, name)
      sb.write_string(" AS ")
      write_query(sb, q)
    }
    Statement::CreateTableLike(temp, if_ne, name, src_tbl) => {
      sb.write_string("CREATE ")
      if temp { sb.write_string("TEMP ") }
      sb.write_string("TABLE ")
      if if_ne { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, name)
      sb.write_string(" (LIKE ")
      write_object_name(sb, src_tbl)
      sb.write_byte((41).to_byte())
    }
    Statement::CreateIndex(ci) => {
      sb.write_string("CREATE ")
      if ci.unique { sb.write_string("UNIQUE ") }
      sb.write_string("INDEX ")
      if ci.if_not_exists { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, ci.name)
      sb.write_string(" ON ")
      write_object_name(sb, ci.table_name)
      sb.write_string(" (")
      let mut i = 0
      while i < ci.columns.length() {
        if i > 0 { sb.write_string(", ") }
        write_order_by_expr(sb, ci.columns[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
      match ci.predicate {
        Some(p) => {
          sb.write_string(" WHERE ")
          write_expr(sb, p)
        }
        None => ()
      }
    }
    Statement::CreateIndexExt(ci, concurrently, using_method) => {
      sb.write_string("CREATE ")
      if ci.unique { sb.write_string("UNIQUE ") }
      sb.write_string("INDEX ")
      if concurrently { sb.write_string("CONCURRENTLY ") }
      if ci.if_not_exists { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, ci.name)
      sb.write_string(" ON ")
      write_object_name(sb, ci.table_name)
      match using_method {
        Some(m) => {
          sb.write_string(" USING ")
          write_ident(sb, m)
        }
        None => ()
      }
      sb.write_string(" (")
      let mut i = 0
      while i < ci.columns.length() {
        if i > 0 { sb.write_string(", ") }
        write_order_by_expr(sb, ci.columns[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
      match ci.predicate {
        Some(p) => {
          sb.write_string(" WHERE ")
          write_expr(sb, p)
        }
        None => ()
      }
    }
    Statement::CreateView(cv) => {
      sb.write_string("CREATE ")
      if cv.or_replace { sb.write_string("OR REPLACE ") }
      if cv.temporary { sb.write_string("TEMP ") }
      sb.write_string("VIEW ")
      if cv.if_not_exists { sb.write_string("IF NOT EXISTS ") }
      write_object_name(sb, cv.name)
      if cv.columns.length() > 0 {
        sb.write_string(" (")
        let mut i = 0
        while i < cv.columns.length() {
          if i > 0 { sb.write_string(", ") }
          write_ident(sb, cv.columns[i])
          i = i + 1
        }
        sb.write_byte((41).to_byte())
      }
      sb.write_string(" AS ")
      write_query(sb, cv.query)
    }
    Statement::AlterTable(at) => {
      sb.write_string("ALTER TABLE ")
      write_object_name(sb, at.name)
      let mut i = 0
      while i < at.operations.length() {
        if i > 0 { sb.write_string(", ") } else { sb.write_byte((32).to_byte()) }
        match at.operations[i] {
          AlterTableOp::AddColumn(col) => {
            sb.write_string("ADD COLUMN ")
            write_column_def(sb, col)
          }
          AlterTableOp::DropColumn(col, if_ex, cascade) => {
            sb.write_string("DROP COLUMN ")
            if if_ex { sb.write_string("IF EXISTS ") }
            write_ident(sb, col)
            if cascade { sb.write_string(" CASCADE") }
          }
          AlterTableOp::RenameColumn(o, n) => {
            sb.write_string("RENAME COLUMN ")
            write_ident(sb, o)
            sb.write_string(" TO ")
            write_ident(sb, n)
          }
          AlterTableOp::RenameTable(n) => {
            sb.write_string("RENAME TO ")
            write_object_name(sb, n)
          }
          AlterTableOp::AlterColumnType(col, dt) => {
            sb.write_string("ALTER COLUMN ")
            write_ident(sb, col)
            sb.write_string(" TYPE ")
            write_data_type(sb, dt)
          }
          AlterTableOp::AddConstraint(tc) => {
            sb.write_string("ADD ")
            write_table_constraint(sb, tc)
          }
          AlterTableOp::DropConstraint(c, if_ex, cascade) => {
            sb.write_string("DROP CONSTRAINT ")
            if if_ex { sb.write_string("IF EXISTS ") }
            write_ident(sb, c)
            if cascade { sb.write_string(" CASCADE") }
          }
        }
        i = i + 1
      }
    }
    Statement::Drop(d) => {
      sb.write_string("DROP ")
      match d.object_type {
        ObjectType::Table => sb.write_string("TABLE ")
        ObjectType::Index => sb.write_string("INDEX ")
        ObjectType::View => sb.write_string("VIEW ")
      }
      if d.if_exists { sb.write_string("IF EXISTS ") }
      let mut i = 0
      while i < d.names.length() {
        if i > 0 { sb.write_string(", ") }
        write_object_name(sb, d.names[i])
        i = i + 1
      }
      if d.cascade { sb.write_string(" CASCADE") }
    }
    Statement::Truncate(names, cascade) => {
      sb.write_string("TRUNCATE ")
      let mut i = 0
      while i < names.length() {
        if i > 0 { sb.write_string(", ") }
        write_object_name(sb, names[i])
        i = i + 1
      }
      if cascade { sb.write_string(" CASCADE") }
    }
    Statement::Begin(mode) => {
      sb.write_string("BEGIN")
      match mode {
        Some(m) => {
          sb.write_byte((32).to_byte())
          sb.write_string(m)
        }
        None => ()
      }
    }
    Statement::Commit => sb.write_string("COMMIT")
    Statement::Rollback(sp) => {
      sb.write_string("ROLLBACK")
      match sp {
        Some(id) => {
          sb.write_string(" TO SAVEPOINT ")
          write_ident(sb, id)
        }
        None => ()
      }
    }
    Statement::Savepoint(id) => {
      sb.write_string("SAVEPOINT ")
      write_ident(sb, id)
    }
    Statement::ReleaseSavepoint(id) => {
      sb.write_string("RELEASE SAVEPOINT ")
      write_ident(sb, id)
    }
    Statement::Explain(analyze, inner) => {
      sb.write_string("EXPLAIN ")
      if analyze { sb.write_string("ANALYZE ") }
      write_stmt(sb, inner)
    }
    Statement::ExplainOptions(opts, inner) => {
      sb.write_string("EXPLAIN (")
      let mut i = 0
      while i < opts.length() {
        if i > 0 { sb.write_string(", ") }
        sb.write_string(opts[i])
        i = i + 1
      }
      sb.write_string(") ")
      write_stmt(sb, inner)
    }
    Statement::SetVar(name, av) => {
      sb.write_string("SET ")
      write_object_name(sb, name)
      sb.write_string(" = ")
      write_expr(sb, av)
    }
    Statement::ShowVar(name) => {
      sb.write_string("SHOW ")
      write_object_name(sb, name)
    }
    Statement::Analyze(tbl) => {
      sb.write_string("ANALYZE")
      match tbl {
        Some(t) => {
          sb.write_byte((32).to_byte())
          write_object_name(sb, t)
        }
        None => ()
      }
    }
    Statement::CreateSchema(name) => {
      sb.write_string("CREATE SCHEMA ")
      write_object_name(sb, name)
    }
    Statement::CreateSequence(name) => {
      sb.write_string("CREATE SEQUENCE ")
      write_object_name(sb, name)
    }
    Statement::Pragma(name, arg) => {
      sb.write_string("PRAGMA ")
      write_object_name(sb, name)
      match arg {
        Some(e) => {
          sb.write_byte((40).to_byte())
          write_expr(sb, e)
          sb.write_byte((41).to_byte())
        }
        None => ()
      }
    }
    Statement::Vacuum => sb.write_string("VACUUM")
  }
}

fn format_stmt(stmt : Statement) -> String {
  let sb = StringBuilder::new()
  write_stmt(sb, stmt)
  sb.to_string()
}

fn format_stmts(stmts : Array[Statement]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < stmts.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    write_stmt(sb, stmts[i])
    i = i + 1
  }
  sb.to_string()
}

fn format_expr(expr : Expr) -> String {
  let sb = StringBuilder::new()
  write_expr(sb, expr)
  sb.to_string()
}
