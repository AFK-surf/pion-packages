///| Immutable SQL AST types (SQLite + PostgreSQL + Generic).

///| A single SQL identifier with optional quoting metadata.
pub struct Ident {
  pub value : String
  pub quote_style : QuoteStyle
}

///| Construct an unquoted identifier.
pub fn Ident::new(value : String) -> Ident {
  Ident::{ value: value, quote_style: QuoteStyle::None }
}

///| Construct a quoted identifier.
pub fn Ident::quoted(value : String, style : QuoteStyle) -> Ident {
  Ident::{ value: value, quote_style: style }
}

///| Qualified SQL object name, e.g. `schema.table`.
pub struct ObjectName {
  pub parts : Array[Ident]
}

///| SQL data types for DDL and CAST expressions.
pub enum DataType {
  Int(Option[Int])
  SmallInt
  BigInt
  TinyInt
  Real
  Float(Option[Int])
  Double
  Numeric(Option[Int], Option[Int])
  Decimal(Option[Int], Option[Int])
  Boolean
  Text
  Varchar(Option[Int])
  Char(Option[Int])
  Blob
  Bytea
  Date
  Time
  Timestamp(Bool)
  Interval
  Json
  Jsonb
  Uuid
  Serial
  BigSerial
  Array(DataType)
  Custom(ObjectName, Array[String])
  Unspecified
}

///| Unary expression operators.
pub enum UnaryOperator {
  Plus
  Minus
  Not
  BitwiseNot
}

///| Binary expression operators.
pub enum BinaryOperator {
  Or
  And
  Eq
  Neq
  Lt
  Gt
  LtEq
  GtEq
  Plus
  Minus
  Mul
  Div
  Mod
  Caret
  Concat
  BitwiseAnd
  BitwiseOr
  LShift
  RShift
  Arrow
  DoubleArrow
  HashArrow
  HashDoubleArrow
  AtGt
  LtAt
  RegexMatch
  RegexIMatch
  RegexNotMatch
  RegexNotIMatch
}

///| Window frame unit (`ROWS`, `RANGE`, `GROUPS`).
pub enum WindowFrameUnits {
  Rows
  Range
  Groups
}

///| Window frame boundary.
pub enum WindowFrameBound {
  CurrentRow
  Preceding(Option[Expr])
  Following(Option[Expr])
}

///| Window frame specification (`ROWS BETWEEN ... AND ...`).
pub struct WindowFrame {
  pub units : WindowFrameUnits
  pub start_bound : WindowFrameBound
  pub end_bound : Option[WindowFrameBound]
}

///| Window specification inside `OVER (...)`.
pub struct WindowSpec {
  pub partition_by : Array[Expr]
  pub order_by : Array[OrderByExpr]
  pub window_frame : Option[WindowFrame]
}

///| SQL function call expression (including aggregates and window functions).
pub struct FunctionCall {
  pub name : ObjectName
  pub distinct : Bool
  pub args : Array[Expr]
  pub filter : Option[Expr]
  pub over : Option[WindowSpec]
}

///| SQL expression AST node.
pub enum Expr {
  Identifier(Ident)
  CompoundIdentifier(Array[Ident])
  Number(String)
  SingleQuotedString(String)
  EscapedString(String)
  DollarQuotedString(String, String)
  HexStringLiteral(String)
  Boolean(Bool)
  Null
  Default
  Placeholder(String)
  Wildcard
  QualifiedWildcard(ObjectName)
  UnaryOp(UnaryOperator, Expr)
  PrefixOp(String, Expr)
  BinaryOp(Expr, BinaryOperator, Expr)
  AnyAllOp(Expr, BinaryOperator, Bool, Expr)
  IsNull(Expr)
  IsNotNull(Expr)
  IsTrue(Expr)
  IsNotTrue(Expr)
  IsFalse(Expr)
  IsNotFalse(Expr)
  IsDistinctFrom(Expr, Expr)
  IsNotDistinctFrom(Expr, Expr)
  InList(Expr, Array[Expr], Bool)
  InSubquery(Expr, Query, Bool)
  Between(Expr, Bool, Expr, Expr)
  Like(Expr, Bool, Bool, Expr, Option[String])
  SimilarTo(Expr, Bool, Expr, Option[String])
  PatternOp(Expr, Bool, String, Expr)
  Cast(Expr, DataType, Bool)
  TypedString(DataType, String)
  Extract(Ident, Expr)
  Position(Expr, Expr)
  Substring(Expr, Option[Expr], Option[Expr])
  Trim(Option[String], Option[Expr], Expr)
  Nested(Expr)
  Tuple(Array[Expr])
  Array(Array[Expr])
  ArraySubquery(Query)
  Subscript(Expr, Expr)
  Slice(Expr, Option[Expr], Option[Expr])
  Function(FunctionCall)
  AggregateCall(FunctionCall, Array[OrderByExpr], Array[OrderByExpr], Option[Ident])
  Case(Option[Expr], Array[(Expr, Expr)], Option[Expr])
  Subquery(Query)
  Exists(Query, Bool)
  Collate(Expr, ObjectName)
  GroupingSet(String, Array[Expr])
}

///| Ordering clause item (`expr [ASC|DESC] [NULLS FIRST|LAST]`).
pub struct OrderByExpr {
  pub expr : Expr
  pub asc : Option[Bool]
  pub nulls_first : Option[Bool]
}

///| `SELECT` distinctness modifier.
pub enum DistinctKind {
  None
  Distinct
  All
  DistinctOn(Array[Expr])
}

///| A single item in a `SELECT` projection list.
pub enum SelectItem {
  UnnamedExpr(Expr)
  ExprWithAlias(Expr, Ident)
  Wildcard
  QualifiedWildcard(ObjectName)
}

///| Table alias with optional column alias list.
pub struct TableAlias {
  pub name : Ident
  pub columns : Array[Ident]
}

///| `JOIN` condition (`ON expr` or `USING (col, ...)`).
pub enum JoinConstraint {
  On(Expr)
  Using(Array[Ident])
  None
}

///| `JOIN` type and constraint.
pub enum JoinOperator {
  Inner(JoinConstraint)
  LeftOuter(JoinConstraint)
  RightOuter(JoinConstraint)
  FullOuter(JoinConstraint)
  CrossJoin
  NaturalInner
  NaturalLeft
  NaturalRight
  NaturalFull
}

///| A single joined relation.
pub struct Join {
  pub relation : TableFactor
  pub join_operator : JoinOperator
}

///| Table source in `FROM` or `JOIN`.
pub enum TableFactor {
  Table(ObjectName, Option[TableAlias])
  Derived(Bool, Query, Option[TableAlias])
  NestedJoin(TableWithJoins)
  TableFunction(ObjectName, Array[Expr], Option[TableAlias])
}

///| Base table factor plus its chain of `JOIN`s.
pub struct TableWithJoins {
  pub relation : TableFactor
  pub joins : Array[Join]
}

///| A `SELECT` query core.
pub struct Select {
  pub distinct : DistinctKind
  pub projection : Array[SelectItem]
  pub from : Array[TableWithJoins]
  pub selection : Option[Expr]
  pub group_by : Array[Expr]
  pub having : Option[Expr]
}

///| Set operation kind (`UNION`, `INTERSECT`, `EXCEPT`).
pub enum SetOperator {
  Union
  Intersect
  Except
}

///| Body of a `Query`.
pub enum SetExpr {
  Select(Select)
  Query(Query)
  SetOperation(SetOperator, Bool, SetExpr, SetExpr)
  Values(Array[Array[Expr]])
  DefaultValues
  SelectWithWindows(Select, Array[(Ident, WindowSpec)])
  TableRef(ObjectName)
}

///| A Common Table Expression (`WITH` entry).
pub struct Cte {
  pub alias : Ident
  pub columns : Array[Ident]
  pub query : Query
  pub materialized : Option[Bool]
}

///| `WITH [RECURSIVE]` CTE clause.
pub struct With {
  pub recursive : Bool
  pub cte_tables : Array[Cte]
}

///| Full SQL query expression (`WITH ... SELECT/SetOp ... ORDER BY ... LIMIT ... OFFSET ...`).
pub struct Query {
  pub with_clause : Option[With]
  pub body : SetExpr
  pub order_by : Array[OrderByExpr]
  pub limit : Option[Expr]
  pub offset : Option[Expr]
}

///| Column assignment (`col = expr`) used in `UPDATE` and `ON CONFLICT DO UPDATE`.
pub struct Assignment {
  pub target : Ident
  pub value : Expr
}

///| `ON CONFLICT` action (`DO NOTHING` or `DO UPDATE SET ... [WHERE ...]`).
pub enum OnConflictAction {
  DoNothing
  DoUpdate(Array[Assignment], Option[Expr])
}

///| `ON CONFLICT [(target_cols)] DO ...` clause.
pub struct OnConflict {
  pub target_columns : Array[Ident]
  pub action : OnConflictAction
}

///| `INSERT` statement.
pub struct InsertStmt {
  pub table_name : ObjectName
  pub columns : Array[Ident]
  pub source : Query
  pub on_conflict : Option[OnConflict]
  pub returning : Array[SelectItem]
}

///| `UPDATE` statement.
pub struct UpdateStmt {
  pub table : TableWithJoins
  pub assignments : Array[Assignment]
  pub from : Array[TableWithJoins]
  pub selection : Option[Expr]
  pub returning : Array[SelectItem]
}

///| `DELETE` statement.
pub struct DeleteStmt {
  pub from : TableWithJoins
  pub selection : Option[Expr]
  pub returning : Array[SelectItem]
}

///| Foreign key referential action (`CASCADE`, `SET NULL`, `SET DEFAULT`, `RESTRICT`, `NO ACTION`).
pub enum ReferentialAction {
  Cascade
  SetNull
  SetDefault
  Restrict
  NoAction
}

///| Column-level constraint in `CREATE TABLE`.
pub enum ColumnConstraint {
  NotNull
  Null
  PrimaryKey(Bool)
  Unique
  Default(Expr)
  Check(Expr)
  References(
    ObjectName,
    Array[Ident],
    Option[ReferentialAction],
    Option[ReferentialAction],
  )
  Named(Ident, ColumnConstraint)
  Generated(Option[Expr], Bool, Bool)
}

///| Column definition in `CREATE TABLE` or `ALTER TABLE ADD COLUMN`.
pub struct ColumnDef {
  pub name : Ident
  pub data_type : DataType
  pub constraints : Array[ColumnConstraint]
}

///| Table-level constraint in `CREATE TABLE`.
pub enum TableConstraint {
  PrimaryKey(Option[Ident], Array[Ident])
  Unique(Option[Ident], Array[Ident])
  Check(Option[Ident], Expr)
  ForeignKey(
    Option[Ident],
    Array[Ident],
    ObjectName,
    Array[Ident],
    Option[ReferentialAction],
    Option[ReferentialAction],
  )
}

///| `CREATE [TEMP] TABLE [IF NOT EXISTS] ...` statement.
pub struct CreateTableStmt {
  pub temporary : Bool
  pub if_not_exists : Bool
  pub name : ObjectName
  pub columns : Array[ColumnDef]
  pub constraints : Array[TableConstraint]
  pub without_rowid : Bool
}

///| `CREATE [UNIQUE] INDEX [IF NOT EXISTS] ...` statement.
pub struct CreateIndexStmt {
  pub unique : Bool
  pub if_not_exists : Bool
  pub name : ObjectName
  pub table_name : ObjectName
  pub columns : Array[OrderByExpr]
  pub predicate : Option[Expr]
}

///| `CREATE [TEMP] [OR REPLACE] VIEW [IF NOT EXISTS] ...` statement.
pub struct CreateViewStmt {
  pub temporary : Bool
  pub or_replace : Bool
  pub if_not_exists : Bool
  pub name : ObjectName
  pub columns : Array[Ident]
  pub query : Query
}

///| `ALTER TABLE` operation.
pub enum AlterTableOp {
  AddColumn(ColumnDef)
  DropColumn(Ident, Bool, Bool)
  RenameColumn(Ident, Ident)
  RenameTable(ObjectName)
  AlterColumnType(Ident, DataType)
  AddConstraint(TableConstraint)
  DropConstraint(Ident, Bool, Bool)
}

///| `ALTER TABLE` statement.
pub struct AlterTableStmt {
  pub name : ObjectName
  pub operations : Array[AlterTableOp]
}

///| Object type for `DROP` statements.
pub enum ObjectType {
  Table
  Index
  View
}

///| `DROP TABLE/INDEX/VIEW [IF EXISTS] ... [CASCADE]` statement.
pub struct DropStmt {
  pub object_type : ObjectType
  pub if_exists : Bool
  pub names : Array[ObjectName]
  pub cascade : Bool
}

///| Top-level SQL statement.
pub enum Statement {
  Query(Query)
  QueryLocked(Query, String)
  Insert(InsertStmt)
  InsertOr(Option[String], InsertStmt)
  Update(UpdateStmt)
  UpdateMulti(TableWithJoins, Array[(Array[Ident], Expr)], Array[TableWithJoins], Option[Expr], Array[SelectItem])
  Delete(DeleteStmt)
  DeleteUsing(TableWithJoins, Array[TableWithJoins], Option[Expr], Array[SelectItem])
  CreateTable(CreateTableStmt)
  CreateTableAs(Bool, Bool, ObjectName, Query)
  CreateTableLike(Bool, Bool, ObjectName, ObjectName)
  CreateIndex(CreateIndexStmt)
  CreateIndexExt(CreateIndexStmt, Bool, Option[Ident])
  CreateView(CreateViewStmt)
  AlterTable(AlterTableStmt)
  Drop(DropStmt)
  Truncate(Array[ObjectName], Bool)
  Begin(Option[String])
  Commit
  Rollback(Option[Ident])
  Savepoint(Ident)
  ReleaseSavepoint(Ident)
  Explain(Bool, Statement)
  ExplainOptions(Array[String], Statement)
  SetVar(ObjectName, Expr)
  ShowVar(ObjectName)
  Analyze(Option[ObjectName])
  CreateSchema(ObjectName)
  CreateSequence(ObjectName)
  Pragma(ObjectName, Option[Expr])
  Vacuum
}
