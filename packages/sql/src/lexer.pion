///| High-performance SQL Lexer (SQLite + PostgreSQL + Generic) and statement splitter.

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn is_ident_start(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 95 || b >= 128
}

fn is_ident_cont(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95 || b == 36 || b >= 128
}

fn is_dollar_tag_char(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b) || b == 95
}

fn eq_ascii_upper(src : String, start : Int, target : String) -> Bool {
  let n = target.length()
  let mut i = 0
  while i < n {
    let mut c = src.code_unit_at(start + i)
    if c >= 97 && c <= 122 {
      c = c - 32
    }
    if c != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Zero-allocation ASCII case-insensitive SQL keyword matcher.
///| Returns `Some(STATIC_UPPER_KEYWORD)` if the slice matches a known SQL keyword.
fn match_keyword(src : String, start : Int, len : Int) -> Option[String] {
  if len < 2 || len > 13 {
    return None
  }
  let mut c0 = src.code_unit_at(start)
  if c0 >= 97 && c0 <= 122 {
    c0 = c0 - 32
  }
  if len == 2 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "AS") { return Some("AS") }
    } else if c0 == 66 {
      if eq_ascii_upper(src, start, "BY") { return Some("BY") }
    } else if c0 == 68 {
      if eq_ascii_upper(src, start, "DO") { return Some("DO") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "IN") { return Some("IN") }
      if eq_ascii_upper(src, start, "IS") { return Some("IS") }
      if eq_ascii_upper(src, start, "IF") { return Some("IF") }
    } else if c0 == 78 {
      if eq_ascii_upper(src, start, "NO") { return Some("NO") }
    } else if c0 == 79 {
      if eq_ascii_upper(src, start, "OR") { return Some("OR") }
      if eq_ascii_upper(src, start, "ON") { return Some("ON") }
    } else if c0 == 84 {
      if eq_ascii_upper(src, start, "TO") { return Some("TO") }
    }
    return None
  }
  if len == 3 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "AND") { return Some("AND") }
      if eq_ascii_upper(src, start, "ALL") { return Some("ALL") }
      if eq_ascii_upper(src, start, "ASC") { return Some("ASC") }
      if eq_ascii_upper(src, start, "ADD") { return Some("ADD") }
      if eq_ascii_upper(src, start, "ANY") { return Some("ANY") }
    } else if c0 == 69 {
      if eq_ascii_upper(src, start, "END") { return Some("END") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INT") { return Some("INT") }
    } else if c0 == 75 {
      if eq_ascii_upper(src, start, "KEY") { return Some("KEY") }
    } else if c0 == 78 {
      if eq_ascii_upper(src, start, "NOT") { return Some("NOT") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "ROW") { return Some("ROW") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SET") { return Some("SET") }
    }
    return None
  }
  if len == 4 {
    if c0 == 66 {
      if eq_ascii_upper(src, start, "BLOB") { return Some("BLOB") }
      if eq_ascii_upper(src, start, "BOOL") { return Some("BOOL") }
    } else if c0 == 67 {
      if eq_ascii_upper(src, start, "CASE") { return Some("CASE") }
      if eq_ascii_upper(src, start, "CAST") { return Some("CAST") }
      if eq_ascii_upper(src, start, "CHAR") { return Some("CHAR") }
    } else if c0 == 68 {
      if eq_ascii_upper(src, start, "DESC") { return Some("DESC") }
      if eq_ascii_upper(src, start, "DROP") { return Some("DROP") }
      if eq_ascii_upper(src, start, "DATE") { return Some("DATE") }
    } else if c0 == 69 {
      if eq_ascii_upper(src, start, "ELSE") { return Some("ELSE") }
    } else if c0 == 70 {
      if eq_ascii_upper(src, start, "FROM") { return Some("FROM") }
      if eq_ascii_upper(src, start, "FULL") { return Some("FULL") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INTO") { return Some("INTO") }
    } else if c0 == 74 {
      if eq_ascii_upper(src, start, "JOIN") { return Some("JOIN") }
      if eq_ascii_upper(src, start, "JSON") { return Some("JSON") }
    } else if c0 == 76 {
      if eq_ascii_upper(src, start, "LEFT") { return Some("LEFT") }
      if eq_ascii_upper(src, start, "LIKE") { return Some("LIKE") }
      if eq_ascii_upper(src, start, "LAST") { return Some("LAST") }
    } else if c0 == 78 {
      if eq_ascii_upper(src, start, "NULL") { return Some("NULL") }
    } else if c0 == 79 {
      if eq_ascii_upper(src, start, "OVER") { return Some("OVER") }
      if eq_ascii_upper(src, start, "ONLY") { return Some("ONLY") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "ROWS") { return Some("ROWS") }
      if eq_ascii_upper(src, start, "REAL") { return Some("REAL") }
      if eq_ascii_upper(src, start, "READ") { return Some("READ") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SOME") { return Some("SOME") }
    } else if c0 == 84 {
      if eq_ascii_upper(src, start, "THEN") { return Some("THEN") }
      if eq_ascii_upper(src, start, "TRUE") { return Some("TRUE") }
      if eq_ascii_upper(src, start, "TEXT") { return Some("TEXT") }
      if eq_ascii_upper(src, start, "TEMP") { return Some("TEMP") }
      if eq_ascii_upper(src, start, "TIME") { return Some("TIME") }
    } else if c0 == 85 {
      if eq_ascii_upper(src, start, "UUID") { return Some("UUID") }
    } else if c0 == 86 {
      if eq_ascii_upper(src, start, "VIEW") { return Some("VIEW") }
    } else if c0 == 87 {
      if eq_ascii_upper(src, start, "WITH") { return Some("WITH") }
      if eq_ascii_upper(src, start, "WHEN") { return Some("WHEN") }
      if eq_ascii_upper(src, start, "WORK") { return Some("WORK") }
    }
    return None
  }
  if len == 5 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "ALTER") { return Some("ALTER") }
      if eq_ascii_upper(src, start, "ARRAY") { return Some("ARRAY") }
    } else if c0 == 66 {
      if eq_ascii_upper(src, start, "BEGIN") { return Some("BEGIN") }
      if eq_ascii_upper(src, start, "BYTEA") { return Some("BYTEA") }
    } else if c0 == 67 {
      if eq_ascii_upper(src, start, "CROSS") { return Some("CROSS") }
      if eq_ascii_upper(src, start, "CHECK") { return Some("CHECK") }
    } else if c0 == 70 {
      if eq_ascii_upper(src, start, "FALSE") { return Some("FALSE") }
      if eq_ascii_upper(src, start, "FIRST") { return Some("FIRST") }
      if eq_ascii_upper(src, start, "FLOAT") { return Some("FLOAT") }
    } else if c0 == 71 {
      if eq_ascii_upper(src, start, "GROUP") { return Some("GROUP") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INNER") { return Some("INNER") }
      if eq_ascii_upper(src, start, "INDEX") { return Some("INDEX") }
      if eq_ascii_upper(src, start, "ILIKE") { return Some("ILIKE") }
    } else if c0 == 74 {
      if eq_ascii_upper(src, start, "JSONB") { return Some("JSONB") }
    } else if c0 == 76 {
      if eq_ascii_upper(src, start, "LIMIT") { return Some("LIMIT") }
    } else if c0 == 78 {
      if eq_ascii_upper(src, start, "NULLS") { return Some("NULLS") }
    } else if c0 == 79 {
      if eq_ascii_upper(src, start, "ORDER") { return Some("ORDER") }
      if eq_ascii_upper(src, start, "OUTER") { return Some("OUTER") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "RIGHT") { return Some("RIGHT") }
      if eq_ascii_upper(src, start, "RANGE") { return Some("RANGE") }
      if eq_ascii_upper(src, start, "ROWID") { return Some("ROWID") }
    } else if c0 == 84 {
      if eq_ascii_upper(src, start, "TABLE") { return Some("TABLE") }
    } else if c0 == 85 {
      if eq_ascii_upper(src, start, "UNION") { return Some("UNION") }
      if eq_ascii_upper(src, start, "USING") { return Some("USING") }
    } else if c0 == 87 {
      if eq_ascii_upper(src, start, "WHERE") { return Some("WHERE") }
      if eq_ascii_upper(src, start, "WRITE") { return Some("WRITE") }
    }
    return None
  }
  if len == 6 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "ACTION") { return Some("ACTION") }
    } else if c0 == 66 {
      if eq_ascii_upper(src, start, "BIGINT") { return Some("BIGINT") }
    } else if c0 == 67 {
      if eq_ascii_upper(src, start, "CREATE") { return Some("CREATE") }
      if eq_ascii_upper(src, start, "COMMIT") { return Some("COMMIT") }
      if eq_ascii_upper(src, start, "COLUMN") { return Some("COLUMN") }
    } else if c0 == 68 {
      if eq_ascii_upper(src, start, "DELETE") { return Some("DELETE") }
      if eq_ascii_upper(src, start, "DOUBLE") { return Some("DOUBLE") }
    } else if c0 == 69 {
      if eq_ascii_upper(src, start, "EXISTS") { return Some("EXISTS") }
      if eq_ascii_upper(src, start, "EXCEPT") { return Some("EXCEPT") }
      if eq_ascii_upper(src, start, "ESCAPE") { return Some("ESCAPE") }
    } else if c0 == 70 {
      if eq_ascii_upper(src, start, "FILTER") { return Some("FILTER") }
    } else if c0 == 71 {
      if eq_ascii_upper(src, start, "GROUPS") { return Some("GROUPS") }
    } else if c0 == 72 {
      if eq_ascii_upper(src, start, "HAVING") { return Some("HAVING") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INSERT") { return Some("INSERT") }
    } else if c0 == 79 {
      if eq_ascii_upper(src, start, "OFFSET") { return Some("OFFSET") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "RENAME") { return Some("RENAME") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SELECT") { return Some("SELECT") }
      if eq_ascii_upper(src, start, "SERIAL") { return Some("SERIAL") }
    } else if c0 == 85 {
      if eq_ascii_upper(src, start, "UPDATE") { return Some("UPDATE") }
      if eq_ascii_upper(src, start, "UNIQUE") { return Some("UNIQUE") }
    } else if c0 == 86 {
      if eq_ascii_upper(src, start, "VALUES") { return Some("VALUES") }
    }
    return None
  }
  if len == 7 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "ANALYZE") { return Some("ANALYZE") }
    } else if c0 == 66 {
      if eq_ascii_upper(src, start, "BETWEEN") { return Some("BETWEEN") }
      if eq_ascii_upper(src, start, "BOOLEAN") { return Some("BOOLEAN") }
    } else if c0 == 67 {
      if eq_ascii_upper(src, start, "CURRENT") { return Some("CURRENT") }
      if eq_ascii_upper(src, start, "CASCADE") { return Some("CASCADE") }
      if eq_ascii_upper(src, start, "COLLATE") { return Some("COLLATE") }
    } else if c0 == 68 {
      if eq_ascii_upper(src, start, "DEFAULT") { return Some("DEFAULT") }
      if eq_ascii_upper(src, start, "DECIMAL") { return Some("DECIMAL") }
    } else if c0 == 69 {
      if eq_ascii_upper(src, start, "EXPLAIN") { return Some("EXPLAIN") }
    } else if c0 == 70 {
      if eq_ascii_upper(src, start, "FOREIGN") { return Some("FOREIGN") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INTEGER") { return Some("INTEGER") }
    } else if c0 == 76 {
      if eq_ascii_upper(src, start, "LATERAL") { return Some("LATERAL") }
    } else if c0 == 78 {
      if eq_ascii_upper(src, start, "NATURAL") { return Some("NATURAL") }
      if eq_ascii_upper(src, start, "NOTHING") { return Some("NOTHING") }
      if eq_ascii_upper(src, start, "NUMERIC") { return Some("NUMERIC") }
    } else if c0 == 80 {
      if eq_ascii_upper(src, start, "PRIMARY") { return Some("PRIMARY") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "REPLACE") { return Some("REPLACE") }
      if eq_ascii_upper(src, start, "RELEASE") { return Some("RELEASE") }
    } else if c0 == 84 {
      if eq_ascii_upper(src, start, "TINYINT") { return Some("TINYINT") }
    } else if c0 == 86 {
      if eq_ascii_upper(src, start, "VARCHAR") { return Some("VARCHAR") }
    } else if c0 == 87 {
      if eq_ascii_upper(src, start, "WITHOUT") { return Some("WITHOUT") }
    }
    return None
  }
  if len == 8 {
    if c0 == 67 {
      if eq_ascii_upper(src, start, "CONFLICT") { return Some("CONFLICT") }
    } else if c0 == 68 {
      if eq_ascii_upper(src, start, "DISTINCT") { return Some("DISTINCT") }
      if eq_ascii_upper(src, start, "DEFERRED") { return Some("DEFERRED") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INTERVAL") { return Some("INTERVAL") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "ROLLBACK") { return Some("ROLLBACK") }
      if eq_ascii_upper(src, start, "RESTRICT") { return Some("RESTRICT") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SMALLINT") { return Some("SMALLINT") }
    }
    return None
  }
  if len == 9 {
    if c0 == 66 {
      if eq_ascii_upper(src, start, "BIGSERIAL") { return Some("BIGSERIAL") }
    } else if c0 == 69 {
      if eq_ascii_upper(src, start, "EXCLUSIVE") { return Some("EXCLUSIVE") }
    } else if c0 == 70 {
      if eq_ascii_upper(src, start, "FOLLOWING") { return Some("FOLLOWING") }
    } else if c0 == 73 {
      if eq_ascii_upper(src, start, "INTERSECT") { return Some("INTERSECT") }
      if eq_ascii_upper(src, start, "IMMEDIATE") { return Some("IMMEDIATE") }
    } else if c0 == 80 {
      if eq_ascii_upper(src, start, "PARTITION") { return Some("PARTITION") }
      if eq_ascii_upper(src, start, "PRECEDING") { return Some("PRECEDING") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "RECURSIVE") { return Some("RECURSIVE") }
      if eq_ascii_upper(src, start, "RETURNING") { return Some("RETURNING") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SAVEPOINT") { return Some("SAVEPOINT") }
    } else if c0 == 84 {
      if eq_ascii_upper(src, start, "TEMPORARY") { return Some("TEMPORARY") }
      if eq_ascii_upper(src, start, "TIMESTAMP") { return Some("TIMESTAMP") }
    } else if c0 == 85 {
      if eq_ascii_upper(src, start, "UNBOUNDED") { return Some("UNBOUNDED") }
    }
    return None
  }
  if len == 10 {
    if c0 == 67 {
      if eq_ascii_upper(src, start, "CONSTRAINT") { return Some("CONSTRAINT") }
    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "REFERENCES") { return Some("REFERENCES") }
    }
    return None
  }
  if len == 11 {
    if c0 == 84 {
      if eq_ascii_upper(src, start, "TRANSACTION") { return Some("TRANSACTION") }
    }
    return None
  }
  if len == 12 {
    if c0 == 77 {
      if eq_ascii_upper(src, start, "MATERIALIZED") { return Some("MATERIALIZED") }
    }
    return None
  }
  if len == 13 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "AUTOINCREMENT") { return Some("AUTOINCREMENT") }
    }
    return None
  }
  None
}

fn tokenize_impl(src : String, opts : ParseOptions) -> Result[Array[Token], SqlError] {
  let n = src.length()
  let tokens : Array[Token] = []
  let max_tokens = opts.max_tokens
  let mut i = 0
  let mut line = 1
  let mut col = 1

  while i < n {
    let b = src.code_unit_at(i)

    // Fast whitespace skip
    if b == 32 || b == 9 || b == 13 || b == 10 {
      if b == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
      continue
    }

    // Line comment `-- ...`
    if b == 45 && i + 1 < n && src.code_unit_at(i + 1) == 45 {
      i = i + 2
      col = col + 2
      while i < n && src.code_unit_at(i) != 10 {
        i = i + 1
        col = col + 1
      }
      continue
    }

    // Nested block comment `/* ... */`
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      let start_line = line
      let start_col = col
      let start_off = i
      i = i + 2
      col = col + 2
      let mut depth = 1
      while i < n && depth > 0 {
        let cb = src.code_unit_at(i)
        if cb == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
          depth = depth + 1
          i = i + 2
          col = col + 2
        } else if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          depth = depth - 1
          i = i + 2
          col = col + 2
        } else if cb == 10 {
          line = line + 1
          col = 1
          i = i + 1
        } else {
          i = i + 1
          col = col + 1
        }
      }
      if depth > 0 {
        return Err(
          SqlError::new(start_line, start_col, start_off, "unterminated block comment"),
        )
      }
      continue
    }

    // Resource guard before emitting a token
    if tokens.length() >= max_tokens {
      return Err(SqlError::new(line, col, i, "max_tokens limit exceeded"))
    }

    let tok_line = line
    let tok_col = col
    let tok_off = i

    // PostgreSQL E'...' escaped string
    if (b == 69 || b == 101) && i + 1 < n && src.code_unit_at(i + 1) == 39 {
      i = i + 2
      col = col + 2
      let sb = StringBuilder::new()
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 92 {
          if i + 1 >= n {
            return Err(
              SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"),
            )
          }
          let nxt = src.code_unit_at(i + 1)
          if nxt == 110 {
            sb.write_byte((10).to_byte())
          } else if nxt == 116 {
            sb.write_byte((9).to_byte())
          } else if nxt == 114 {
            sb.write_byte((13).to_byte())
          } else if nxt == 98 {
            sb.write_byte((8).to_byte())
          } else if nxt == 102 {
            sb.write_byte((12).to_byte())
          } else {
            sb.write_byte(nxt.to_byte())
          }
          if nxt == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 2
          }
          i = i + 2
        } else if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            sb.write_byte((39).to_byte())
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          sb.write_byte(cb.to_byte())
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"),
        )
      }
      tokens.push(
        Token::{
          kind: TokenKind::EscapedString(sb.to_string()),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Single-quoted string `'...'` with `''` escape
    if b == 39 {
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated string literal"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 39 && p + 1 < end_p && src.code_unit_at(p + 1) == 39 {
            sb.write_byte((39).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::SingleQuotedString(s),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Double-quoted identifier `"..."`
    if b == 34 {
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 34 {
          if i + 1 < n && src.code_unit_at(i + 1) == 34 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated double-quoted identifier"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 34 && p + 1 < end_p && src.code_unit_at(p + 1) == 34 {
            sb.write_byte((34).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(s, QuoteStyle::DoubleQuote),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Backtick-quoted identifier `` `...` ``
    if b == 96 {
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 96 {
          if i + 1 < n && src.code_unit_at(i + 1) == 96 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated backtick identifier"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 96 && p + 1 < end_p && src.code_unit_at(p + 1) == 96 {
            sb.write_byte((96).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(s, QuoteStyle::Backtick),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `[` : either SQLite bracket identifier `[col]` or array bracket `[`
    if b == 91 {
      let is_pg = match opts.dialect {
        Dialect::Postgres => true
        _ => false
      }
      // In Postgres, `[` is always LBracket.
      // In SQLite / Generic, distinguish array literals & subscripts (`ARRAY[...]`, `TEXT[]`, `expr[1]`) from `[ident]`:
      let prev_is_array_or_expr = if tokens.length() == 0 {
        false
      } else {
        let prev = tokens[tokens.length() - 1]
        match prev.kind {
          TokenKind::Keyword(k) =>
          k == "ARRAY" || k == "TEXT" || k == "INT" || k == "INTEGER" || k == "BIGINT" || k == "VARCHAR" || k == "JSONB" || k == "JSON" || k == "UUID" || k == "BOOLEAN" || k == "BOOL" || k == "NUMERIC" || k == "REAL" || k == "DOUBLE"
          TokenKind::RParen | TokenKind::RBracket => true
          TokenKind::Ident(_, QuoteStyle::None) => prev.offset + prev.len == tok_off
          _ => false
        }
      }
      if is_pg || prev_is_array_or_expr {
        i = i + 1
        col = col + 1
        tokens.push(
          Token::{
            kind: TokenKind::LBracket,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 1,
          },
        )
        continue
      }
      // Scan bracket identifier `[...]`
      i = i + 1
      col = col + 1
      let content_start = i
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 93 {
          i = i + 1
          col = col + 1
          closed = true
          break
        }
        if cb == 10 {
          line = line + 1
          col = 1
        } else {
          col = col + 1
        }
        i = i + 1
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated bracket identifier"),
        )
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(src.slice(content_start, i - 1), QuoteStyle::Bracket),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `$` : PostgreSQL `$1` placeholder OR `$tag$...$tag$` dollar-quoted string
    if b == 36 {
      // Check `$1` numeric placeholder
      if i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1)) {
        i = i + 1
        col = col + 1
        while i < n && is_ascii_digit(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      // Check `$tag$...$tag$`
      let mut j = i + 1
      while j < n && is_dollar_tag_char(src.code_unit_at(j)) {
        j = j + 1
      }
      if j < n && src.code_unit_at(j) == 36 {
        let tag = src.slice(i + 1, j)
        let delim = src.slice(i, j + 1)
        let delim_len = delim.length()
        col = col + delim_len
        i = j + 1
        let body_start = i
        let mut found = false
        while i + delim_len <= n {
          if src.code_unit_at(i) == 36 {
            let mut k = 0
            let mut m = true
            while k < delim_len {
              if src.code_unit_at(i + k) != delim.code_unit_at(k) {
                m = false
                break
              }
              k = k + 1
            }
            if m {
              let body = src.slice(body_start, i)
              i = i + delim_len
              col = col + delim_len
              tokens.push(
                Token::{
                  kind: TokenKind::DollarQuotedString(tag, body),
                  line: tok_line,
                  col: tok_col,
                  offset: tok_off,
                  len: i - tok_off,
                },
              )
              found = true
              break
            }
          }
          if src.code_unit_at(i) == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
        if !found {
          return Err(
            SqlError::new(tok_line, tok_col, tok_off, "unterminated dollar-quoted string"),
          )
        }
        continue
      }
      // Named placeholder `$name` (SQLite)
      if j > i + 1 {
        col = col + (j - i)
        i = j
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '$'"))
    }

    // Placeholders `?`, `?1`
    if b == 63 {
      i = i + 1
      col = col + 1
      while i < n && is_ascii_digit(src.code_unit_at(i)) {
        i = i + 1
        col = col + 1
      }
      tokens.push(
        Token::{
          kind: TokenKind::Placeholder(src.slice(tok_off, i)),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `:` -> `::` or `:name` placeholder or `:`
    if b == 58 {
      if i + 1 < n && src.code_unit_at(i + 1) == 58 {
        i = i + 2
        col = col + 2
        tokens.push(
          Token::{
            kind: TokenKind::DoubleColon,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 2,
          },
        )
        continue
      }
      if i + 1 < n && (is_ascii_alpha(src.code_unit_at(i + 1)) || src.code_unit_at(i + 1) == 95) {
        i = i + 2
        col = col + 2
        while i < n && is_ident_cont(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      i = i + 1
      col = col + 1
      tokens.push(
        Token::{
          kind: TokenKind::Colon,
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: 1,
        },
      )
      continue
    }

    // `@` -> `@>` or `@name` placeholder
    if b == 64 {
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        i = i + 2
        col = col + 2
        tokens.push(
          Token::{
            kind: TokenKind::AtGt,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 2,
          },
        )
        continue
      }
      if i + 1 < n && (is_ascii_alpha(src.code_unit_at(i + 1)) || src.code_unit_at(i + 1) == 95) {
        i = i + 2
        col = col + 2
        while i < n && is_ident_cont(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '@'"))
    }

    // Numbers: decimal, hex `0x...`, float `.5`, `3.14e-2`
    if is_ascii_digit(b) || (b == 46 && i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1))) {
      if b == 48 && i + 1 < n && (src.code_unit_at(i + 1) == 120 || src.code_unit_at(i + 1) == 88) {
        i = i + 2
        col = col + 2
        while i < n && is_hex_digit(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
      } else {
        let mut seen_dot = false
        if b == 46 {
          seen_dot = true
          i = i + 1
          col = col + 1
        }
        while i < n && is_ascii_digit(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        if !seen_dot && i < n && src.code_unit_at(i) == 46 {
          i = i + 1
          col = col + 1
          while i < n && is_ascii_digit(src.code_unit_at(i)) {
            i = i + 1
            col = col + 1
          }
        }
        if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
          let exp_pos = i
          let exp_col = col
          i = i + 1
          col = col + 1
          if i < n && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
            i = i + 1
            col = col + 1
          }
          if i < n && is_ascii_digit(src.code_unit_at(i)) {
            while i < n && is_ascii_digit(src.code_unit_at(i)) {
              i = i + 1
              col = col + 1
            }
          } else {
            i = exp_pos
            col = exp_col
          }
        }
      }
      tokens.push(
        Token::{
          kind: TokenKind::Number(src.slice(tok_off, i)),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Identifiers and keywords
    if is_ident_start(b) {
      i = i + 1
      col = col + 1
      while i < n && is_ident_cont(src.code_unit_at(i)) {
        i = i + 1
        col = col + 1
      }
      let wlen = i - tok_off
      let kind = match match_keyword(src, tok_off, wlen) {
        Some(kw) => TokenKind::Keyword(kw)
        None => TokenKind::Ident(src.slice(tok_off, i), QuoteStyle::None)
      }
      tokens.push(
        Token::{
          kind: kind,
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: wlen,
        },
      )
      continue
    }

    // Punctuation & Operators
    if b == 40 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::LParen, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 41 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::RParen, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 93 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::RBracket, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 44 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Comma, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 59 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Semicolon, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 46 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Dot, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 61 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Eq, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 43 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Plus, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 42 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Star, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 47 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Slash, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 37 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Percent, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 94 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Caret, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 38 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Amp, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 45 {
      // `-`, `->`, `->>`
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        if i + 2 < n && src.code_unit_at(i + 2) == 62 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::DoubleArrow, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
        } else {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::Arrow, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        }
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Minus, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }
    if b == 35 {
      // `#>`, `#>>`
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        if i + 2 < n && src.code_unit_at(i + 2) == 62 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::HashDoubleArrow, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
          continue
        }
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::HashArrow, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '#'"))
    }
    if b == 124 {
      // `||` or `|`
      if i + 1 < n && src.code_unit_at(i + 1) == 124 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::Concat, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Pipe, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }
    if b == 33 {
      // `!=`, `!~`, `!~*`
      if i + 1 < n && src.code_unit_at(i + 1) == 61 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::Neq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        continue
      }
      if i + 1 < n && src.code_unit_at(i + 1) == 126 {
        if i + 2 < n && src.code_unit_at(i + 2) == 42 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::BangTildeStar, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
        } else {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::BangTilde, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        }
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '!'"))
    }
    if b == 60 {
      // `<>`, `<=`, `<@`, `<<`, `<`
      if i + 1 < n {
        let nxt = src.code_unit_at(i + 1)
        if nxt == 62 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::Neq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 61 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LtEq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 64 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LtAt, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 60 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LShift, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
      }
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Lt, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 62 {
      // `>=`, `>>`, `>`
      if i + 1 < n {
        let nxt = src.code_unit_at(i + 1)
        if nxt == 61 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::GtEq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 62 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::RShift, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
      }
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Gt, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 126 {
      // `~*` or `~`
      if i + 1 < n && src.code_unit_at(i + 1) == 42 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::TildeStar, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Tilde, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }

    return Err(
      SqlError::new(tok_line, tok_col, tok_off, "unexpected character in SQL input"),
    )
  }

  tokens.push(Token::{ kind: TokenKind::Eof, line: line, col: col, offset: n, len: 0 })
  Ok(tokens)
}

fn trim_ascii_whitespace(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n {
    let b = s.code_unit_at(lo)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      lo = lo + 1
    } else {
      break
    }
  }
  let mut hi = n
  while hi > lo {
    let b = s.code_unit_at(hi - 1)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      hi = hi - 1
    } else {
      break
    }
  }
  s.slice(lo, hi)
}

fn split_statements_impl(src : String) -> Result[Array[String], SqlError] {
  let toks = match tokenize_impl(src, ParseOptions::default()) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let parts : Array[String] = []
  let mut stmt_start = -1
  let mut stmt_end = 0
  let mut paren_depth = 0
  let mut i = 0
  let n = toks.length()
  while i < n {
    let tok = toks[i]
    match tok.kind {
      TokenKind::Eof => {
        if stmt_start >= 0 {
          let chunk = trim_ascii_whitespace(src.slice(stmt_start, stmt_end))
          if chunk.length() > 0 {
            parts.push(chunk)
          }
        }
        break
      }
      TokenKind::Semicolon => {
        if paren_depth == 0 {
          if stmt_start >= 0 {
            let chunk = trim_ascii_whitespace(src.slice(stmt_start, stmt_end))
            if chunk.length() > 0 {
              parts.push(chunk)
            }
            stmt_start = -1
          }
        } else {
          if stmt_start < 0 {
            stmt_start = tok.offset
          }
          stmt_end = tok.offset + tok.len
        }
      }
      TokenKind::LParen => {
        if stmt_start < 0 {
          stmt_start = tok.offset
        }
        paren_depth = paren_depth + 1
        stmt_end = tok.offset + tok.len
      }
      TokenKind::RParen => {
        if stmt_start < 0 {
          stmt_start = tok.offset
        }
        if paren_depth > 0 {
          paren_depth = paren_depth - 1
        }
        stmt_end = tok.offset + tok.len
      }
      _ => {
        if stmt_start < 0 {
          stmt_start = tok.offset
        }
        stmt_end = tok.offset + tok.len
      }
    }
    i = i + 1
  }
  Ok(parts)
}
