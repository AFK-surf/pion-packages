  if len == 7 {
    if c0 == 65 {
      if eq_ascii_upper(src, start, "ANALYZE") { return Some("ANALYZE") }
    } else if c0 == 66 {
      if eq_ascii_upper(src, start, "BETWEEN") { return Some("BETWEEN") }
