fn tokenize_impl(src : String, opts : ParseOptions) -> Result[Array[Token], SqlError] {
  let n = src.length()
  let tokens : Array[Token] = []
  let max_tokens = opts.max_tokens
  let is_sqlite = match opts.dialect {
    Dialect::SQLite => true
    _ => false
  }
  let is_pg = match opts.dialect {
    Dialect::Postgres => true
    _ => false
  }
  let mut i = 0
  let mut line = 1
  let mut col = 1

  while i < n {
    let b = src.code_unit_at(i)

    // Fast whitespace skip
    if b == 32 || b == 9 || b == 13 || b == 10 {
      if b == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
      continue
    }

    // Line comment `-- ...`
    if b == 45 && i + 1 < n && src.code_unit_at(i + 1) == 45 {
      i = i + 2
      col = col + 2
      while i < n && src.code_unit_at(i) != 10 {
        i = i + 1
        col = col + 1
      }
      continue
    }

    // Block comment `/* ... */` (nested in PostgreSQL/Generic, NON-nested in SQLite!)
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      let start_line = line
      let start_col = col
      let start_off = i
      i = i + 2
      col = col + 2
      if is_sqlite {
        let mut closed = false
        while i < n {
          let cb = src.code_unit_at(i)
          if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
            i = i + 2
            col = col + 2
            closed = true
            break
          } else if cb == 10 {
            line = line + 1
            col = 1
            i = i + 1
          } else {
            i = i + 1
            col = col + 1
          }
        }
        if !closed {
          return Err(
            SqlError::new(start_line, start_col, start_off, "unterminated block comment"),
          )
        }
        continue
      }
      let mut depth = 1
      while i < n && depth > 0 {
        let cb = src.code_unit_at(i)
        if cb == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
          depth = depth + 1
          i = i + 2
          col = col + 2
        } else if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          depth = depth - 1
          i = i + 2
          col = col + 2
        } else if cb == 10 {
          line = line + 1
          col = 1
          i = i + 1
        } else {
          i = i + 1
          col = col + 1
        }
      }
      if depth > 0 {
        return Err(
          SqlError::new(start_line, start_col, start_off, "unterminated block comment"),
        )
      }
      continue
    }

    // Resource guard before emitting a token
    if tokens.length() >= max_tokens {
      return Err(SqlError::new(line, col, i, "max_tokens limit exceeded"))
    }

    let tok_line = line
    let tok_col = col
    let tok_off = i

    // SQLite / Generic hex blob literal `X'...'` / `x'...'`
    if !is_pg && (b == 88 || b == 120) && i + 1 < n && src.code_unit_at(i + 1) == 39 {
      i = i + 2
      col = col + 2
      let content_start = i
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 39 {
          i = i + 1
          col = col + 1
          closed = true
          break
        }
        if !is_hex_digit(cb) {
          return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid hex string literal"))
        }
        i = i + 1
        col = col + 1
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated hex string literal"))
      }
      tokens.push(
        Token::{
          kind: TokenKind::HexStringLiteral(src.slice(content_start, i - 1)),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // PostgreSQL / Generic E'...' escaped string (DISABLED in SQLite!)
    if !is_sqlite && (b == 69 || b == 101) && i + 1 < n && src.code_unit_at(i + 1) == 39 {
      i = i + 2
      col = col + 2
      let sb = StringBuilder::new()
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 92 {
          if i + 1 >= n {
            return Err(
              SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"),
            )
          }
          let nxt = src.code_unit_at(i + 1)
          if nxt == 110 {
            sb.write_byte((10).to_byte())
            i = i + 2; col = col + 2
          } else if nxt == 116 {
            sb.write_byte((9).to_byte())
            i = i + 2; col = col + 2
          } else if nxt == 114 {
            sb.write_byte((13).to_byte())
            i = i + 2; col = col + 2
          } else if nxt == 98 {
            sb.write_byte((8).to_byte())
            i = i + 2; col = col + 2
          } else if nxt == 102 {
            sb.write_byte((12).to_byte())
            i = i + 2; col = col + 2
          } else if nxt == 120 {
            // \xH or \xHH
            i = i + 2; col = col + 2
            if i >= n || hex_val(src.code_unit_at(i)) < 0 {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid hexadecimal escape"))
            }
            let mut hv = hex_val(src.code_unit_at(i))
            i = i + 1; col = col + 1
            if i < n && hex_val(src.code_unit_at(i)) >= 0 {
              hv = (hv << 4) | hex_val(src.code_unit_at(i))
              i = i + 1; col = col + 1
            }
            sb.write_byte(hv.to_byte())
          } else if nxt == 117 {
            // \uHHHH (4 hex digits)
            i = i + 2; col = col + 2
            if i + 4 > n {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode escape"))
            }
            let h0 = hex_val(src.code_unit_at(i))
            let h1 = hex_val(src.code_unit_at(i + 1))
            let h2 = hex_val(src.code_unit_at(i + 2))
            let h3 = hex_val(src.code_unit_at(i + 3))
            if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode escape"))
            }
            let cp = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
            if !write_utf8_codepoint(sb, cp) {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode codepoint"))
            }
            i = i + 4; col = col + 4
          } else if nxt == 85 {
            // \UHHHHHHHH (8 hex digits)
            i = i + 2; col = col + 2
            if i + 8 > n {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode escape"))
            }
            let mut cp = 0
            let mut k = 0
            while k < 8 {
              let hv = hex_val(src.code_unit_at(i + k))
              if hv < 0 {
                return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode escape"))
              }
              cp = (cp << 4) | hv
              k = k + 1
            }
            if !write_utf8_codepoint(sb, cp) {
              return Err(SqlError::new(tok_line, tok_col, tok_off, "invalid Unicode codepoint"))
            }
            i = i + 8; col = col + 8
          } else if is_octal_digit(nxt) {
            // \o, \oo, \ooo (1 to 3 octal digits)
            let mut ov = nxt - 48
            i = i + 2; col = col + 2
            if i < n && is_octal_digit(src.code_unit_at(i)) {
              ov = (ov << 3) | (src.code_unit_at(i) - 48)
              i = i + 1; col = col + 1
              if i < n && is_octal_digit(src.code_unit_at(i)) {
                ov = (ov << 3) | (src.code_unit_at(i) - 48)
                i = i + 1; col = col + 1
              }
            }
            sb.write_byte((ov & 255).to_byte())
          } else {
            sb.write_byte(nxt.to_byte())
            if nxt == 10 {
              line = line + 1
              col = 1
            } else {
              col = col + 2
            }
            i = i + 2
          }
        } else if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            sb.write_byte((39).to_byte())
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          sb.write_byte(cb.to_byte())
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"),
        )
      }
      tokens.push(
        Token::{
          kind: TokenKind::EscapedString(sb.to_string()),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Single-quoted string `'...'` with `''` escape
    if b == 39 {
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated string literal"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 39 && p + 1 < end_p && src.code_unit_at(p + 1) == 39 {
            sb.write_byte((39).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::SingleQuotedString(s),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Double-quoted identifier `"..."`
    if b == 34 {
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 34 {
          if i + 1 < n && src.code_unit_at(i + 1) == 34 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated double-quoted identifier"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 34 && p + 1 < end_p && src.code_unit_at(p + 1) == 34 {
            sb.write_byte((34).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(s, QuoteStyle::DoubleQuote),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Backtick-quoted identifier `` `...` `` (SQLite / Generic only, NOT Postgres)
    if b == 96 {
      if is_pg {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '`' in PostgreSQL dialect"))
      }
      i = i + 1
      col = col + 1
      let content_start = i
      let mut has_escape = false
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 96 {
          if i + 1 < n && src.code_unit_at(i + 1) == 96 {
            has_escape = true
            i = i + 2
            col = col + 2
          } else {
            i = i + 1
            col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated backtick identifier"),
        )
      }
      let s = if !has_escape {
        src.slice(content_start, i - 1)
      } else {
        let sb = StringBuilder::new()
        let mut p = content_start
        let end_p = i - 1
        while p < end_p {
          let cb = src.code_unit_at(p)
          if cb == 96 && p + 1 < end_p && src.code_unit_at(p + 1) == 96 {
            sb.write_byte((96).to_byte())
            p = p + 2
          } else {
            sb.write_byte(cb.to_byte())
            p = p + 1
          }
        }
        sb.to_string()
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(s, QuoteStyle::Backtick),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `[` : either SQLite bracket identifier `[col]` or array bracket `[`
    if b == 91 {
      let is_pg = match opts.dialect {
        Dialect::Postgres => true
        _ => false
      }
      // In Postgres, `[` is always LBracket.
      // In SQLite / Generic, distinguish array literals & subscripts (`ARRAY[...]`, `TEXT[]`, `expr[1]`) from `[ident]`:
      let prev_is_array_or_expr = if tokens.length() == 0 {
        false
      } else {
        let prev = tokens[tokens.length() - 1]
        match prev.kind {
          TokenKind::Keyword(k) =>
          k == "ARRAY" || k == "TEXT" || k == "INT" || k == "INTEGER" || k == "BIGINT" || k == "VARCHAR" || k == "JSONB" || k == "JSON" || k == "UUID" || k == "BOOLEAN" || k == "BOOL" || k == "NUMERIC" || k == "REAL" || k == "DOUBLE"
          TokenKind::RParen | TokenKind::RBracket => true
          TokenKind::Ident(_, QuoteStyle::None) => prev.offset + prev.len == tok_off
          _ => false
        }
      }
      if is_pg || prev_is_array_or_expr {
        i = i + 1
        col = col + 1
        tokens.push(
          Token::{
            kind: TokenKind::LBracket,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 1,
          },
        )
        continue
      }
      // Scan bracket identifier `[...]`
      i = i + 1
      col = col + 1
      let content_start = i
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 93 {
          i = i + 1
          col = col + 1
          closed = true
          break
        }
        if cb == 10 {
          line = line + 1
          col = 1
        } else {
          col = col + 1
        }
        i = i + 1
      }
      if !closed {
        return Err(
          SqlError::new(tok_line, tok_col, tok_off, "unterminated bracket identifier"),
        )
      }
      tokens.push(
        Token::{
          kind: TokenKind::Ident(src.slice(content_start, i - 1), QuoteStyle::Bracket),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `$` : SQLite bind parameter OR PostgreSQL/Generic `$1` placeholder / `$tag$...$tag$` dollar-quoted string
    if b == 36 {
      if is_sqlite {
        // SQLite has NO dollar-quoting: `$` starts a bind parameter (e.g. `$name`, `$a$`, `$1`)
        let mut j = i + 1
        while j < n && is_ident_cont(src.code_unit_at(j)) {
          j = j + 1
        }
        if j > i + 1 {
          col = col + (j - i)
          i = j
          tokens.push(
            Token::{
              kind: TokenKind::Placeholder(src.slice(tok_off, i)),
              line: tok_line,
              col: tok_col,
              offset: tok_off,
              len: i - tok_off,
            },
          )
          continue
        }
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '$'"))
      }
      // Check `$1` numeric placeholder
      if i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1)) {
        i = i + 1
        col = col + 1
        while i < n && is_ascii_digit(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        if is_pg && i < n && is_ident_cont(src.code_unit_at(i)) {
          return Err(SqlError::new(tok_line, tok_col, tok_off, "trailing junk after placeholder"))
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      // Check `$tag$...$tag$` (tag must be empty or start with letter/`_`)
      let mut j = i + 1
      if j < n && (is_ascii_alpha(src.code_unit_at(j)) || src.code_unit_at(j) == 95) {
        j = j + 1
        while j < n && is_dollar_tag_char(src.code_unit_at(j)) {
          j = j + 1
        }
      }
      if j < n && src.code_unit_at(j) == 36 {
        let tag = src.slice(i + 1, j)
        let delim = src.slice(i, j + 1)
        let delim_len = delim.length()
        col = col + delim_len
        i = j + 1
        let body_start = i
        let mut found = false
        while i + delim_len <= n {
          if src.code_unit_at(i) == 36 {
            let mut k = 0
            let mut m = true
            while k < delim_len {
              if src.code_unit_at(i + k) != delim.code_unit_at(k) {
                m = false
                break
              }
              k = k + 1
            }
            if m {
              let body = src.slice(body_start, i)
              i = i + delim_len
              col = col + delim_len
              tokens.push(
                Token::{
                  kind: TokenKind::DollarQuotedString(tag, body),
                  line: tok_line,
                  col: tok_col,
                  offset: tok_off,
                  len: i - tok_off,
                },
              )
              found = true
              break
            }
          }
          if src.code_unit_at(i) == 10 {
            line = line + 1
            col = 1
          } else {
            col = col + 1
          }
          i = i + 1
        }
        if !found {
          return Err(
            SqlError::new(tok_line, tok_col, tok_off, "unterminated dollar-quoted string"),
          )
        }
        continue
      }
      // Named placeholder `$name` (SQLite)
      if j > i + 1 {
        col = col + (j - i)
        i = j
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '$'"))
    }

    // Placeholders `?`, `?1`
    if b == 63 {
      i = i + 1
      col = col + 1
      while i < n && is_ascii_digit(src.code_unit_at(i)) {
        i = i + 1
        col = col + 1
      }
      tokens.push(
        Token::{
          kind: TokenKind::Placeholder(src.slice(tok_off, i)),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // `:` -> `::` or `:name` placeholder or `:`
    if b == 58 {
      if i + 1 < n && src.code_unit_at(i + 1) == 58 {
        i = i + 2
        col = col + 2
        tokens.push(
          Token::{
            kind: TokenKind::DoubleColon,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 2,
          },
        )
        continue
      }
      if i + 1 < n && (is_ascii_alpha(src.code_unit_at(i + 1)) || src.code_unit_at(i + 1) == 95) {
        i = i + 2
        col = col + 2
        while i < n && is_ident_cont(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      i = i + 1
      col = col + 1
      tokens.push(
        Token::{
          kind: TokenKind::Colon,
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: 1,
        },
      )
      continue
    }

    // `@` -> `@>` or `@name` placeholder (SQLite/Generic) or `@` unary abs operator (Postgres)
    if b == 64 {
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        i = i + 2
        col = col + 2
        tokens.push(
          Token::{
            kind: TokenKind::AtGt,
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: 2,
          },
        )
        continue
      }
      if !is_pg && i + 1 < n && (is_ascii_alpha(src.code_unit_at(i + 1)) || src.code_unit_at(i + 1) == 95) {
        i = i + 2
        col = col + 2
        while i < n && is_ident_cont(src.code_unit_at(i)) {
          i = i + 1
          col = col + 1
        }
        tokens.push(
          Token::{
            kind: TokenKind::Placeholder(src.slice(tok_off, i)),
            line: tok_line,
            col: tok_col,
            offset: tok_off,
            len: i - tok_off,
          },
        )
        continue
      }
      i = i + 1
      col = col + 1
      tokens.push(
        Token::{
          kind: TokenKind::At,
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: 1,
        },
      )
      continue
    }

    // Numbers: decimal, hex `0x...`, binary `0b...`, octal `0o...`, float `.5`, `3.14e-2`, `1_000`
    if is_ascii_digit(b) || (b == 46 && i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1))) {
      if b == 48 && i + 1 < n && (src.code_unit_at(i + 1) == 120 || src.code_unit_at(i + 1) == 88) {
        i = i + 2
        col = col + 2
        while i < n && (is_hex_digit(src.code_unit_at(i)) || src.code_unit_at(i) == 95) {
          i = i + 1
          col = col + 1
        }
      } else if b == 48 && i + 1 < n && (src.code_unit_at(i + 1) == 98 || src.code_unit_at(i + 1) == 66) {
        i = i + 2
        col = col + 2
        while i < n && (src.code_unit_at(i) == 48 || src.code_unit_at(i) == 49 || src.code_unit_at(i) == 95) {
          i = i + 1
          col = col + 1
        }
      } else if b == 48 && i + 1 < n && (src.code_unit_at(i + 1) == 111 || src.code_unit_at(i + 1) == 79) {
        i = i + 2
        col = col + 2
        while i < n && (is_octal_digit(src.code_unit_at(i)) || src.code_unit_at(i) == 95) {
          i = i + 1
          col = col + 1
        }
      } else {
        let mut seen_dot = false
        if b == 46 {
          seen_dot = true
          i = i + 1
          col = col + 1
        }
        while i < n && (is_ascii_digit(src.code_unit_at(i)) || src.code_unit_at(i) == 95) {
          i = i + 1
          col = col + 1
        }
        if !seen_dot && i < n && src.code_unit_at(i) == 46 {
          i = i + 1
          col = col + 1
          while i < n && (is_ascii_digit(src.code_unit_at(i)) || src.code_unit_at(i) == 95) {
            i = i + 1
            col = col + 1
          }
        }
        if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
          let exp_pos = i
          let exp_col = col
          i = i + 1
          col = col + 1
          if i < n && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
            i = i + 1
            col = col + 1
          }
          if i < n && is_ascii_digit(src.code_unit_at(i)) {
            while i < n && (is_ascii_digit(src.code_unit_at(i)) || src.code_unit_at(i) == 95) {
              i = i + 1
              col = col + 1
            }
          } else {
            i = exp_pos
            col = exp_col
          }
        }
      }
      tokens.push(
        Token::{
          kind: TokenKind::Number(src.slice(tok_off, i)),
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: i - tok_off,
        },
      )
      continue
    }

    // Identifiers and keywords
    if is_ident_start(b) {
      i = i + 1
      col = col + 1
      while i < n && is_ident_cont(src.code_unit_at(i)) {
        i = i + 1
        col = col + 1
      }
      let wlen = i - tok_off
      let kind = match match_keyword(src, tok_off, wlen) {
        Some(kw) => TokenKind::Keyword(kw)
        None => TokenKind::Ident(src.slice(tok_off, i), QuoteStyle::None)
      }
      tokens.push(
        Token::{
          kind: kind,
          line: tok_line,
          col: tok_col,
          offset: tok_off,
          len: wlen,
        },
      )
      continue
    }

    // Punctuation & Operators
    if b == 40 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::LParen, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 41 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::RParen, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 93 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::RBracket, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 44 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Comma, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 59 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Semicolon, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 46 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Dot, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 61 {
      if !is_pg && i + 1 < n && src.code_unit_at(i + 1) == 61 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::Eq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Eq, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }
    if b == 43 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Plus, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 42 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Star, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 47 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Slash, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 37 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Percent, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 94 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Caret, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 38 {
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Amp, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 45 {
      // `-`, `->`, `->>`
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        if i + 2 < n && src.code_unit_at(i + 2) == 62 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::DoubleArrow, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
        } else {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::Arrow, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        }
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Minus, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }
    if b == 35 {
      // `#>`, `#>>`
      if i + 1 < n && src.code_unit_at(i + 1) == 62 {
        if i + 2 < n && src.code_unit_at(i + 2) == 62 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::HashDoubleArrow, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
          continue
        }
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::HashArrow, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '#'"))
    }
    if b == 124 {
      // `||`, `|/`, or `|`
      if i + 1 < n && src.code_unit_at(i + 1) == 124 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::Concat, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else if i + 1 < n && src.code_unit_at(i + 1) == 47 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::PipeSlash, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Pipe, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }
    if b == 33 {
      // `!=`, `!~`, `!~*`
      if i + 1 < n && src.code_unit_at(i + 1) == 61 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::Neq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        continue
      }
      if i + 1 < n && src.code_unit_at(i + 1) == 126 {
        if i + 2 < n && src.code_unit_at(i + 2) == 42 {
          i = i + 3; col = col + 3
          tokens.push(Token::{ kind: TokenKind::BangTildeStar, line: tok_line, col: tok_col, offset: tok_off, len: 3 })
        } else {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::BangTilde, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
        }
        continue
      }
      return Err(SqlError::new(tok_line, tok_col, tok_off, "unexpected '!'"))
    }
    if b == 60 {
      // `<>`, `<=`, `<@`, `<<`, `<`
      if i + 1 < n {
        let nxt = src.code_unit_at(i + 1)
        if nxt == 62 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::Neq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 61 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LtEq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 64 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LtAt, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 60 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::LShift, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
      }
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Lt, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 62 {
      // `>=`, `>>`, `>`
      if i + 1 < n {
        let nxt = src.code_unit_at(i + 1)
        if nxt == 61 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::GtEq, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
        if nxt == 62 {
          i = i + 2; col = col + 2
          tokens.push(Token::{ kind: TokenKind::RShift, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
          continue
        }
      }
      i = i + 1; col = col + 1
      tokens.push(Token::{ kind: TokenKind::Gt, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      continue
    }
    if b == 126 {
      // `~*` or `~`
      if i + 1 < n && src.code_unit_at(i + 1) == 42 {
        i = i + 2; col = col + 2
        tokens.push(Token::{ kind: TokenKind::TildeStar, line: tok_line, col: tok_col, offset: tok_off, len: 2 })
      } else {
        i = i + 1; col = col + 1
        tokens.push(Token::{ kind: TokenKind::Tilde, line: tok_line, col: tok_col, offset: tok_off, len: 1 })
      }
      continue
    }

    return Err(
      SqlError::new(tok_line, tok_col, tok_off, "unexpected character in SQL input"),
    )
  }

  tokens.push(Token::{ kind: TokenKind::Eof, line: line, col: col, offset: n, len: 0 })
  Ok(tokens)
}

fn trim_ascii_whitespace(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n {
    let b = s.code_unit_at(lo)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      lo = lo + 1
    } else {
      break
    }
  }
  let mut hi = n
  while hi > lo {
    let b = s.code_unit_at(hi - 1)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      hi = hi - 1
    } else {
      break
    }
  }
  s.slice(lo, hi)
}

fn split_statements_dialect_impl(src : String, dialect : Dialect) -> Result[Array[String], SqlError] {
  let n = src.length()
  let is_sqlite = match dialect {
    Dialect::SQLite => true
    _ => false
  }
  let is_pg = match dialect {
    Dialect::Postgres => true
    _ => false
  }
  let parts : Array[String] = []
  let mut stmt_start = -1
  let mut stmt_end = 0
  let mut paren_depth = 0
  let mut i = 0
  let mut line = 1
  let mut col = 1

  while i < n {
    let b = src.code_unit_at(i)

    // Whitespace
    if b == 32 || b == 9 || b == 13 || b == 10 {
      if b == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
      continue
    }

    // Line comment `-- ...`
    if b == 45 && i + 1 < n && src.code_unit_at(i + 1) == 45 {
      i = i + 2
      col = col + 2
      while i < n && src.code_unit_at(i) != 10 {
        i = i + 1
        col = col + 1
      }
      continue
    }

    // Block comment `/* ... */`
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      let start_line = line
      let start_col = col
      let start_off = i
      i = i + 2
      col = col + 2
      if is_sqlite {
        let mut closed = false
        while i < n {
          let cb = src.code_unit_at(i)
          if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
            i = i + 2; col = col + 2
            closed = true
            break
          } else if cb == 10 {
            line = line + 1; col = 1; i = i + 1
          } else {
            i = i + 1; col = col + 1
          }
        }
        if !closed {
          return Err(SqlError::new(start_line, start_col, start_off, "unterminated block comment"))
        }
        continue
      }
      let mut depth = 1
      while i < n && depth > 0 {
        let cb = src.code_unit_at(i)
        if cb == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
          depth = depth + 1; i = i + 2; col = col + 2
        } else if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          depth = depth - 1; i = i + 2; col = col + 2
        } else if cb == 10 {
          line = line + 1; col = 1; i = i + 1
        } else {
          i = i + 1; col = col + 1
        }
      }
      if depth > 0 {
        return Err(SqlError::new(start_line, start_col, start_off, "unterminated block comment"))
      }
      continue
    }

    let tok_line = line
    let tok_col = col
    let tok_off = i

    // Semicolon at top level
    if b == 59 {
      i = i + 1
      col = col + 1
      if paren_depth == 0 {
        if stmt_start >= 0 {
          let chunk = trim_ascii_whitespace(src.slice(stmt_start, stmt_end))
          if chunk.length() > 0 {
            parts.push(chunk)
          }
          stmt_start = -1
        }
      } else {
        if stmt_start < 0 {
          stmt_start = tok_off
        }
        stmt_end = i
      }
      continue
    }

    if stmt_start < 0 {
      stmt_start = tok_off
    }

    // Parentheses
    if b == 40 {
      paren_depth = paren_depth + 1
      i = i + 1; col = col + 1
      stmt_end = i
      continue
    }
    if b == 41 {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
      i = i + 1; col = col + 1
      stmt_end = i
      continue
    }

    // Escaped string `E'...'` / `e'...'` (PostgreSQL / Generic only)
    if !is_sqlite && (b == 69 || b == 101) && i + 1 < n && src.code_unit_at(i + 1) == 39 {
      i = i + 2; col = col + 2
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 92 {
          if i + 1 >= n {
            return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"))
          }
          if src.code_unit_at(i + 1) == 10 {
            line = line + 1; col = 1
          } else {
            col = col + 2
          }
          i = i + 2
        } else if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            i = i + 2; col = col + 2
          } else {
            i = i + 1; col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 { line = line + 1; col = 1 } else { col = col + 1 }
          i = i + 1
        }
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated escaped string"))
      }
      stmt_end = i
      continue
    }

    // Single-quoted string `'...'`
    if b == 39 {
      i = i + 1; col = col + 1
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 39 {
          if i + 1 < n && src.code_unit_at(i + 1) == 39 {
            i = i + 2; col = col + 2
          } else {
            i = i + 1; col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 { line = line + 1; col = 1 } else { col = col + 1 }
          i = i + 1
        }
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated string literal"))
      }
      stmt_end = i
      continue
    }

    // Double-quoted identifier `"..."`
    if b == 34 {
      i = i + 1; col = col + 1
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 34 {
          if i + 1 < n && src.code_unit_at(i + 1) == 34 {
            i = i + 2; col = col + 2
          } else {
            i = i + 1; col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 { line = line + 1; col = 1 } else { col = col + 1 }
          i = i + 1
        }
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated double-quoted identifier"))
      }
      stmt_end = i
      continue
    }

    // Backtick identifier (SQLite / Generic only)
    if !is_pg && b == 96 {
      i = i + 1; col = col + 1
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 96 {
          if i + 1 < n && src.code_unit_at(i + 1) == 96 {
            i = i + 2; col = col + 2
          } else {
            i = i + 1; col = col + 1
            closed = true
            break
          }
        } else {
          if cb == 10 { line = line + 1; col = 1 } else { col = col + 1 }
          i = i + 1
        }
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated backtick identifier"))
      }
      stmt_end = i
      continue
    }

    // Bracket identifier `[...]` (SQLite / Generic only)
    if !is_pg && b == 91 {
      i = i + 1; col = col + 1
      let mut closed = false
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 93 {
          i = i + 1; col = col + 1
          closed = true
          break
        }
        if cb == 10 { line = line + 1; col = 1 } else { col = col + 1 }
        i = i + 1
      }
      if !closed {
        return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated bracket identifier"))
      }
      stmt_end = i
      continue
    }

    // Dollar-quoted string `$tag$...$tag$` (PostgreSQL / Generic only)
    if !is_sqlite && b == 36 {
      let mut j = i + 1
      if j < n && (is_ascii_alpha(src.code_unit_at(j)) || src.code_unit_at(j) == 95) {
        j = j + 1
        while j < n && is_dollar_tag_char(src.code_unit_at(j)) {
          j = j + 1
        }
      }
      if j < n && src.code_unit_at(j) == 36 {
        let delim = src.slice(i, j + 1)
        let delim_len = delim.length()
        col = col + delim_len
        i = j + 1
        let mut found = false
        while i + delim_len <= n {
          if src.code_unit_at(i) == 36 {
            let mut k = 0
            let mut m = true
            while k < delim_len {
              if src.code_unit_at(i + k) != delim.code_unit_at(k) {
                m = false
                break
              }
              k = k + 1
            }
            if m {
              i = i + delim_len
              col = col + delim_len
              found = true
              break
            }
          }
          if src.code_unit_at(i) == 10 { line = line + 1; col = 1 } else { col = col + 1 }
          i = i + 1
        }
        if !found {
          return Err(SqlError::new(tok_line, tok_col, tok_off, "unterminated dollar-quoted string"))
        }
        stmt_end = i
        continue
      }
      // Otherwise `$1` or `$name`
      i = i + 1; col = col + 1
      while i < n && is_ident_cont(src.code_unit_at(i)) {
        i = i + 1; col = col + 1
      }
      stmt_end = i
      continue
    }

    // Fast skip over identifier/keyword characters so `E'` inside `SELECT` or `TABLE` isn't mistaken for E'...'!
    if is_ident_start(b) {
      i = i + 1; col = col + 1
      while i < n && is_ident_cont(src.code_unit_at(i)) {
        i = i + 1; col = col + 1
      }
      stmt_end = i
      continue
    }

    // Any other byte
    i = i + 1
    col = col + 1
    stmt_end = i
  }

  if stmt_start >= 0 {
    let chunk = trim_ascii_whitespace(src.slice(stmt_start, stmt_end))
    if chunk.length() > 0 {
      parts.push(chunk)
    }
  }
  Ok(parts)
}
