    } else if c0 == 82 {
      if eq_ascii_upper(src, start, "RENAME") { return Some("RENAME") }
      if eq_ascii_upper(src, start, "REGEXP") { return Some("REGEXP") }
      if eq_ascii_upper(src, start, "ROLLUP") { return Some("ROLLUP") }
    } else if c0 == 83 {
      if eq_ascii_upper(src, start, "SELECT") { return Some("SELECT") }
      if eq_ascii_upper(src, start, "SERIAL") { return Some("SERIAL") }
      if eq_ascii_upper(src, start, "STORED") { return Some("STORED") }
      if eq_ascii_upper(src, start, "SCHEMA") { return Some("SCHEMA") }
