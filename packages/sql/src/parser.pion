///| Pratt expression parser + recursive-descent SQL statement parser (SQLite + PostgreSQL + Generic).

struct Parser {
  src : String
  tokens : Array[Token]
  mut pos : Int
  mut depth : Int
  mut nodes : Int
  opts : ParseOptions
}

fn Parser::new(src : String, tokens : Array[Token], opts : ParseOptions) -> Parser {
  Parser::{ src: src, tokens: tokens, pos: 0, depth: 0, nodes: 0, opts: opts }
}

fn tok_raw(p : Parser, tok : Token) -> String {
  p.src.slice(tok.offset, tok.offset + tok.len)
}

fn is_sqlite_dialect(p : Parser) -> Bool {
  match p.opts.dialect {
    Dialect::SQLite => true
    _ => false
  }
}

fn peek(p : Parser) -> Token {
  if p.pos < p.tokens.length() {
    p.tokens[p.pos]
  } else {
    p.tokens[p.tokens.length() - 1]
  }
}

fn peek_n(p : Parser, offset : Int) -> Token {
  let idx = p.pos + offset
  if idx < p.tokens.length() {
    p.tokens[idx]
  } else {
    p.tokens[p.tokens.length() - 1]
  }
}

fn advance(p : Parser) -> Token {
  let tok = peek(p)
  if p.pos + 1 < p.tokens.length() {
    p.pos = p.pos + 1
  }
  tok
}

fn err_here(p : Parser, msg : String) -> SqlError {
  let tok = peek(p)
  SqlError::new(tok.line, tok.col, tok.offset, msg)
}

fn enter_depth(p : Parser) -> Result[Unit, SqlError] {
  p.depth = p.depth + 1
  if p.depth > p.opts.max_depth {
    return Err(err_here(p, "max_depth limit exceeded"))
  }
  Ok(())
}

fn leave_depth(p : Parser) -> Unit {
  p.depth = p.depth - 1
}

fn bump_node(p : Parser) -> Result[Unit, SqlError] {
  p.nodes = p.nodes + 1
  if p.nodes > p.opts.max_nodes {
    return Err(err_here(p, "max_nodes limit exceeded"))
  }
  Ok(())
}

fn is_kw(tok : Token, kw : String) -> Bool {
  match tok.kind {
    TokenKind::Keyword(k) => k == kw
    _ => false
  }
}

fn peek_kw(p : Parser, kw : String) -> Bool {
  is_kw(peek(p), kw)
}

fn eat_kw(p : Parser, kw : String) -> Bool {
  if peek_kw(p, kw) {
    let _ = advance(p)
    true
  } else {
    false
  }
}

fn expect_kw(p : Parser, kw : String) -> Result[Unit, SqlError] {
  if eat_kw(p, kw) {
    Ok(())
  } else {
    Err(err_here(p, "expected keyword " + kw))
  }
}

fn is_eof(p : Parser) -> Bool {
  match peek(p).kind {
    TokenKind::Eof => true
    _ => false
  }
}

fn eat_lparen(p : Parser) -> Bool {
  match peek(p).kind {
    TokenKind::LParen => { let _ = advance(p); true }
    _ => false
  }
}

fn expect_lparen(p : Parser) -> Result[Unit, SqlError] {
  if eat_lparen(p) { Ok(()) } else { Err(err_here(p, "expected '('")) }
}

fn eat_rparen(p : Parser) -> Bool {
  match peek(p).kind {
    TokenKind::RParen => { let _ = advance(p); true }
    _ => false
  }
}

fn expect_rparen(p : Parser) -> Result[Unit, SqlError] {
  if eat_rparen(p) { Ok(()) } else { Err(err_here(p, "expected ')'")) }
}

fn eat_comma(p : Parser) -> Bool {
  match peek(p).kind {
    TokenKind::Comma => { let _ = advance(p); true }
    _ => false
  }
}

fn eat_dot(p : Parser) -> Bool {
  match peek(p).kind {
    TokenKind::Dot => { let _ = advance(p); true }
    _ => false
  }
}

fn is_clause_keyword(k : String) -> Bool {
  k == "SELECT" || k == "FROM" || k == "WHERE" || k == "GROUP" || k == "HAVING" ||
  k == "ORDER" || k == "LIMIT" || k == "OFFSET" || k == "FETCH" || k == "FOR" ||
  k == "WINDOW" || k == "UNION" || k == "INTERSECT" ||
  k == "EXCEPT" || k == "JOIN" || k == "INNER" || k == "LEFT" || k == "RIGHT" ||
  k == "FULL" || k == "OUTER" || k == "CROSS" || k == "NATURAL" || k == "ON" ||
  k == "USING" || k == "SET" || k == "VALUES" || k == "INTO" || k == "RETURNING" ||
  k == "WHEN" || k == "THEN" || k == "ELSE" || k == "END" || k == "AND" ||
  k == "OR" || k == "NOT" || k == "IS" || k == "IN" || k == "BETWEEN" ||
  k == "LIKE" || k == "ILIKE" || k == "SIMILAR" || k == "GLOB" || k == "REGEXP" ||
  k == "ISNULL" || k == "NOTNULL" || k == "ASC" || k == "DESC" || k == "NULLS" ||
  k == "OVER" || k == "FILTER" || k == "AS" || k == "WITH" || k == "CASE" ||
  k == "CAST" || k == "EXISTS" || k == "DISTINCT" || k == "ALL" || k == "TABLESAMPLE" ||
  k == "WITHIN"
}

fn parse_ident(p : Parser) -> Result[Ident, SqlError] {
  let tok = peek(p)
  match tok.kind {
    TokenKind::Ident(v, style) => {
      let _ = advance(p)
      Ok(Ident::{ value: v, quote_style: style })
    }
    TokenKind::Keyword(_) => {
      let _ = advance(p)
      Ok(Ident::{ value: tok_raw(p, tok), quote_style: QuoteStyle::None })
    }
    _ => Err(err_here(p, "expected identifier"))
  }
}

fn parse_object_name(p : Parser) -> Result[ObjectName, SqlError] {
  let parts : Array[Ident] = []
  match parse_ident(p) {
    Ok(id) => parts.push(id)
    Err(e) => return Err(e)
  }
  while eat_dot(p) {
    match parse_ident(p) {
      Ok(id) => parts.push(id)
      Err(e) => return Err(e)
    }
  }
  Ok(ObjectName::{ parts: parts })
}

fn parse_positive_int_literal(p : Parser) -> Result[Int, SqlError] {
  let tok = peek(p)
  match tok.kind {
    TokenKind::Number(s) => {
      let _ = advance(p)
      let mut acc = 0
      let mut i = 0
      while i < s.length() {
        let b = s.code_unit_at(i)
        if b < 48 || b > 57 {
          return Err(SqlError::new(tok.line, tok.col, tok.offset, "expected integer literal"))
        }
        acc = acc * 10 + (b - 48)
        i = i + 1
      }
      Ok(acc)
    }
    _ => Err(err_here(p, "expected integer literal"))
  }
}

fn parse_data_type(p : Parser) -> Result[DataType, SqlError] {
  match enter_depth(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let res = parse_data_type_inner(p)
  leave_depth(p)
  res
}

fn parse_data_type_inner(p : Parser) -> Result[DataType, SqlError] {
  let tok = peek(p)
  let mut dt = match tok.kind {
    TokenKind::Keyword(k) => {
      let _ = advance(p)
      if k == "INT" || k == "INTEGER" {
        if eat_lparen(p) {
          let n = match parse_positive_int_literal(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          DataType::Int(Some(n))
        } else {
          DataType::Int(None)
        }
      } else if k == "SMALLINT" {
        DataType::SmallInt
      } else if k == "BIGINT" {
        DataType::BigInt
      } else if k == "TINYINT" {
        DataType::TinyInt
      } else if k == "REAL" {
        DataType::Real
      } else if k == "FLOAT" {
        if eat_lparen(p) {
          let n = match parse_positive_int_literal(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          DataType::Float(Some(n))
        } else {
          DataType::Float(None)
        }
      } else if k == "DOUBLE" {
        // Optional PRECISION
        let _ = eat_kw(p, "PRECISION")
        DataType::Double
      } else if k == "NUMERIC" || k == "DECIMAL" {
        let mut prec : Option[Int] = None
        let mut scale : Option[Int] = None
        if eat_lparen(p) {
          match parse_positive_int_literal(p) {
            Ok(pv) => prec = Some(pv)
            Err(e) => return Err(e)
          }
          if eat_comma(p) {
            match parse_positive_int_literal(p) {
              Ok(sv) => scale = Some(sv)
              Err(e) => return Err(e)
            }
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        }
        if k == "NUMERIC" {
          DataType::Numeric(prec, scale)
        } else {
          DataType::Decimal(prec, scale)
        }
      } else if k == "BOOLEAN" || k == "BOOL" {
        DataType::Boolean
      } else if k == "TEXT" {
        DataType::Text
      } else if k == "VARCHAR" {
        if eat_lparen(p) {
          let n = match parse_positive_int_literal(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          DataType::Varchar(Some(n))
        } else {
          DataType::Varchar(None)
        }
      } else if k == "CHAR" {
        if eat_lparen(p) {
          let n = match parse_positive_int_literal(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          DataType::Char(Some(n))
        } else {
          DataType::Char(None)
        }
      } else if k == "BLOB" {
        DataType::Blob
      } else if k == "BYTEA" {
        DataType::Bytea
      } else if k == "DATE" {
        DataType::Date
      } else if k == "TIME" {
        DataType::Time
      } else if k == "TIMESTAMP" {
        let mut tz = false
        if eat_kw(p, "WITH") {
          let _ = eat_kw(p, "TIME")
          match peek(p).kind {
            TokenKind::Ident(_, _) => { let _ = advance(p) }
            _ => ()
          }
          tz = true
        } else if eat_kw(p, "WITHOUT") {
          let _ = eat_kw(p, "TIME")
          match peek(p).kind {
            TokenKind::Ident(_, _) => { let _ = advance(p) }
            _ => ()
          }
          tz = false
        }
        DataType::Timestamp(tz)
      } else if k == "INTERVAL" {
        DataType::Interval
      } else if k == "JSON" {
        DataType::Json
      } else if k == "JSONB" {
        DataType::Jsonb
      } else if k == "UUID" {
        DataType::Uuid
      } else if k == "SERIAL" {
        DataType::Serial
      } else if k == "BIGSERIAL" {
        DataType::BigSerial
      } else {
        DataType::Custom(ObjectName::{ parts: [Ident::new(tok_raw(p, tok))] }, [])
      }
    }
    TokenKind::Ident(_, _) => {
      let name = match parse_object_name(p) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      let params : Array[String] = []
      if eat_lparen(p) {
        if !eat_rparen(p) {
          while true {
            let t = advance(p)
            match t.kind {
              TokenKind::Number(s) => params.push(s)
              TokenKind::Ident(s, _) => params.push(s)
              TokenKind::Keyword(s) => params.push(s)
              _ => return Err(SqlError::new(t.line, t.col, t.offset, "expected type parameter"))
            }
            if !eat_comma(p) {
              break
            }
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        }
      }
      DataType::Custom(name, params)
    }
    _ => return Err(err_here(p, "expected data type"))
  }

  // Handle array suffix `[]`
  while true {
    match peek(p).kind {
      TokenKind::LBracket => {
        let _ = advance(p)
        match peek(p).kind {
          TokenKind::RBracket => {
            let _ = advance(p)
            dt = DataType::Array(dt)
          }
          _ => return Err(err_here(p, "expected ']' in array type"))
        }
      }
      _ => break
    }
  }
  Ok(dt)
}

// ============================================================================
// Pratt Expression Parser
// ============================================================================

fn parse_expr(p : Parser) -> Result[Expr, SqlError] {
  parse_subexpr(p, 0)
}

fn is_comparison_tok(kind : TokenKind) -> Bool {
  match kind {
    TokenKind::Eq | TokenKind::Neq | TokenKind::Lt | TokenKind::Gt | TokenKind::LtEq | TokenKind::GtEq => true
    _ => false
  }
}

fn get_infix_prec(p : Parser) -> Int {
  let tok = peek(p)
  match tok.kind {
    TokenKind::DoubleColon | TokenKind::LBracket => 90
    TokenKind::Caret => 70
    TokenKind::Star | TokenKind::Slash | TokenKind::Percent => 60
    TokenKind::Plus | TokenKind::Minus => 50
    TokenKind::Concat | TokenKind::Arrow | TokenKind::DoubleArrow | TokenKind::HashArrow | TokenKind::HashDoubleArrow |
    TokenKind::AtGt | TokenKind::LtAt | TokenKind::Tilde | TokenKind::TildeStar |
    TokenKind::BangTilde | TokenKind::BangTildeStar |
    TokenKind::Amp | TokenKind::Pipe | TokenKind::LShift | TokenKind::RShift => 45
    TokenKind::Eq | TokenKind::Neq | TokenKind::Lt | TokenKind::Gt | TokenKind::LtEq | TokenKind::GtEq => 35
    TokenKind::Keyword(k) => {
      if k == "COLLATE" { 85 }
      else if k == "IN" || k == "BETWEEN" || k == "LIKE" || k == "ILIKE" || k == "SIMILAR" || k == "GLOB" || k == "REGEXP" { 38 }
      else if k == "IS" || k == "ISNULL" || k == "NOTNULL" { 30 }
      else if k == "NOT" {
        let nxt = peek_n(p, 1)
        if is_kw(nxt, "IN") || is_kw(nxt, "BETWEEN") || is_kw(nxt, "LIKE") || is_kw(nxt, "ILIKE") ||
        is_kw(nxt, "SIMILAR") || is_kw(nxt, "GLOB") || is_kw(nxt, "REGEXP") {
          38
        } else if is_kw(nxt, "NULL") {
          30
        } else {
          0
        }
      }
      else if k == "AND" { 20 }
      else if k == "OR" { 10 }
      else { 0 }
    }
    _ => 0
  }
}

fn parse_subexpr(p : Parser, min_prec : Int) -> Result[Expr, SqlError] {
  let mut lhs = match parse_prefix(p) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  // Strictly bound left-deep Pratt chains by `max_depth` to prevent stack overflow in recursive consumers/Wasm32.
  let mut chain_depth = 0
  while true {
    let prec = get_infix_prec(p)
    if prec == 0 || prec <= min_prec {
      break
    }
    chain_depth = chain_depth + 1
    if p.depth + chain_depth > p.opts.max_depth {
      return Err(err_here(p, "max_depth limit exceeded"))
    }
    match bump_node(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match parse_infix_step(p, lhs, prec) {
      Ok(Some(next_lhs)) => lhs = next_lhs
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(lhs)
}

fn parse_infix_step(p : Parser, lhs : Expr, prec : Int) -> Result[Option[Expr], SqlError] {
  let tok = peek(p)
  match tok.kind {
    TokenKind::DoubleColon => {
      let _ = advance(p)
      let dt = match parse_data_type(p) {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      Ok(Some(Expr::Cast(lhs, dt, true)))
    }
    TokenKind::LBracket => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let mut is_slice = false
      let mut lo : Option[Expr] = None
      let mut hi : Option[Expr] = None
      match peek(p).kind {
        TokenKind::Colon => {
          is_slice = true
          let _ = advance(p)
          match peek(p).kind {
            TokenKind::RBracket => ()
            _ =>
            match parse_subexpr(p, 0) {
              Ok(e) => hi = Some(e)
              Err(e) => { leave_depth(p); return Err(e) }
            }
          }
        }
        _ => {
          let first = match parse_subexpr(p, 0) {
            Ok(e) => e
            Err(e) => { leave_depth(p); return Err(e) }
          }
          match peek(p).kind {
            TokenKind::Colon => {
              is_slice = true
              lo = Some(first)
              let _ = advance(p)
              match peek(p).kind {
                TokenKind::RBracket => ()
                _ =>
                match parse_subexpr(p, 0) {
                  Ok(e) => hi = Some(e)
                  Err(e) => { leave_depth(p); return Err(e) }
                }
              }
            }
            _ => lo = Some(first)
          }
        }
      }
      leave_depth(p)
      match peek(p).kind {
        TokenKind::RBracket => { let _ = advance(p) }
        _ => return Err(err_here(p, "expected ']'"))
      }
      if is_slice {
        Ok(Some(Expr::Slice(lhs, lo, hi)))
      } else {
        match lo {
          Some(idx) => Ok(Some(Expr::Subscript(lhs, idx)))
          None => Err(err_here(p, "expected subscript index"))
        }
      }
    }
    TokenKind::Keyword(k) => {
      if k == "COLLATE" {
        let _ = advance(p)
        let col_name = match parse_object_name(p) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        Ok(Some(Expr::Collate(lhs, col_name)))
      } else if k == "ISNULL" {
        let _ = advance(p)
        Ok(Some(Expr::IsNull(lhs)))
      } else if k == "NOTNULL" {
        let _ = advance(p)
        Ok(Some(Expr::IsNotNull(lhs)))
      } else if k == "IS" {
        let _ = advance(p)
        let negated = eat_kw(p, "NOT")
        if eat_kw(p, "NULL") {
          Ok(Some(if negated { Expr::IsNotNull(lhs) } else { Expr::IsNull(lhs) }))
        } else if eat_kw(p, "TRUE") {
          Ok(Some(if negated { Expr::IsNotTrue(lhs) } else { Expr::IsTrue(lhs) }))
        } else if eat_kw(p, "FALSE") {
          Ok(Some(if negated { Expr::IsNotFalse(lhs) } else { Expr::IsFalse(lhs) }))
        } else if eat_kw(p, "DISTINCT") {
          match expect_kw(p, "FROM") { Ok(_) => () Err(e) => return Err(e) }
          let rhs = match parse_subexpr(p, prec) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          Ok(Some(if negated { Expr::IsNotDistinctFrom(lhs, rhs) } else { Expr::IsDistinctFrom(lhs, rhs) }))
        } else if is_sqlite_dialect(p) {
          let rhs = match parse_subexpr(p, 35) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          Ok(Some(if negated { Expr::IsDistinctFrom(lhs, rhs) } else { Expr::IsNotDistinctFrom(lhs, rhs) }))
        } else {
          Err(err_here(p, "expected NULL, TRUE, FALSE, or DISTINCT FROM after IS"))
        }
      } else if k == "IN" || k == "BETWEEN" || k == "LIKE" || k == "ILIKE" || k == "SIMILAR" || k == "GLOB" || k == "REGEXP" || k == "NOT" {
        let negated = eat_kw(p, "NOT")
        if negated && eat_kw(p, "NULL") {
          Ok(Some(Expr::IsNotNull(lhs)))
        } else if eat_kw(p, "IN") {
          match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
          match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
          if peek_kw(p, "SELECT") || peek_kw(p, "WITH") {
            let subq = match parse_query(p) {
              Ok(q) => { leave_depth(p); q }
              Err(e) => { leave_depth(p); return Err(e) }
            }
            match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
            Ok(Some(Expr::InSubquery(lhs, subq, negated)))
          } else {
            let items : Array[Expr] = []
            if !eat_rparen(p) {
              while true {
                match parse_subexpr(p, 0) {
                  Ok(item) => items.push(item)
                  Err(e) => { leave_depth(p); return Err(e) }
                }
                if !eat_comma(p) {
                  break
                }
              }
              match expect_rparen(p) {
                Ok(_) => ()
                Err(e) => { leave_depth(p); return Err(e) }
              }
            }
            leave_depth(p)
            Ok(Some(Expr::InList(lhs, items, negated)))
          }
        } else if eat_kw(p, "BETWEEN") {
          let low = match parse_subexpr(p, 38) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          match expect_kw(p, "AND") { Ok(_) => () Err(e) => return Err(e) }
          let high = match parse_subexpr(p, 38) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          Ok(Some(Expr::Between(lhs, negated, low, high)))
        } else if eat_kw(p, "LIKE") || eat_kw(p, "ILIKE") {
          let ci = is_kw(p.tokens[p.pos - 1], "ILIKE")
          let pat = match parse_subexpr(p, prec) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          let mut esc : Option[String] = None
          if eat_kw(p, "ESCAPE") {
            match peek(p).kind {
              TokenKind::SingleQuotedString(s) => {
                let _ = advance(p)
                esc = Some(s)
              }
              _ => return Err(err_here(p, "expected string literal after ESCAPE"))
            }
          }
          Ok(Some(Expr::Like(lhs, negated, ci, pat, esc)))
        } else if eat_kw(p, "SIMILAR") {
          match expect_kw(p, "TO") { Ok(_) => () Err(e) => return Err(e) }
          let pat = match parse_subexpr(p, prec) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          let mut esc : Option[String] = None
          if eat_kw(p, "ESCAPE") {
            match peek(p).kind {
              TokenKind::SingleQuotedString(s) => {
                let _ = advance(p)
                esc = Some(s)
              }
              _ => return Err(err_here(p, "expected string literal after ESCAPE"))
            }
          }
          Ok(Some(Expr::SimilarTo(lhs, negated, pat, esc)))
        } else if eat_kw(p, "GLOB") {
          let pat = match parse_subexpr(p, prec) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          Ok(Some(Expr::PatternOp(lhs, negated, "GLOB", pat)))
        } else if eat_kw(p, "REGEXP") {
          let pat = match parse_subexpr(p, prec) {
            Ok(e) => e
            Err(e) => return Err(e)
          }
          Ok(Some(Expr::PatternOp(lhs, negated, "REGEXP", pat)))
        } else {
          Err(err_here(p, "unexpected NOT in expression"))
        }
      } else if k == "AND" {
        let _ = advance(p)
        let rhs = match parse_subexpr(p, prec) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        Ok(Some(Expr::BinaryOp(lhs, BinaryOperator::And, rhs)))
      } else if k == "OR" {
        let _ = advance(p)
        let rhs = match parse_subexpr(p, prec) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        Ok(Some(Expr::BinaryOp(lhs, BinaryOperator::Or, rhs)))
      } else {
        Ok(None)
      }
    }
    _ => {
      let is_cmp = is_comparison_tok(tok.kind)
      let op = match tok.kind {
        TokenKind::Eq => BinaryOperator::Eq
        TokenKind::Neq => BinaryOperator::Neq
        TokenKind::Lt => BinaryOperator::Lt
        TokenKind::Gt => BinaryOperator::Gt
        TokenKind::LtEq => BinaryOperator::LtEq
        TokenKind::GtEq => BinaryOperator::GtEq
        TokenKind::Plus => BinaryOperator::Plus
        TokenKind::Minus => BinaryOperator::Minus
        TokenKind::Star => BinaryOperator::Mul
        TokenKind::Slash => BinaryOperator::Div
        TokenKind::Percent => BinaryOperator::Mod
        TokenKind::Caret => BinaryOperator::Caret
        TokenKind::Concat => BinaryOperator::Concat
        TokenKind::Amp => BinaryOperator::BitwiseAnd
        TokenKind::Pipe => BinaryOperator::BitwiseOr
        TokenKind::LShift => BinaryOperator::LShift
        TokenKind::RShift => BinaryOperator::RShift
        TokenKind::Arrow => BinaryOperator::Arrow
        TokenKind::DoubleArrow => BinaryOperator::DoubleArrow
        TokenKind::HashArrow => BinaryOperator::HashArrow
        TokenKind::HashDoubleArrow => BinaryOperator::HashDoubleArrow
        TokenKind::AtGt => BinaryOperator::AtGt
        TokenKind::LtAt => BinaryOperator::LtAt
        TokenKind::Tilde => BinaryOperator::RegexMatch
        TokenKind::TildeStar => BinaryOperator::RegexIMatch
        TokenKind::BangTilde => BinaryOperator::RegexNotMatch
        TokenKind::BangTildeStar => BinaryOperator::RegexNotIMatch
        _ => return Ok(None)
      }
      let _ = advance(p)
      if is_cmp && (peek_kw(p, "ANY") || peek_kw(p, "SOME") || peek_kw(p, "ALL")) {
        let is_all = eat_kw(p, "ALL")
        if !is_all {
          let _ = advance(p)
        }
        match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
        match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
        let rhs = if peek_kw(p, "SELECT") || peek_kw(p, "WITH") || peek_kw(p, "VALUES") {
          match parse_query(p) {
            Ok(q) => { leave_depth(p); Expr::Subquery(q) }
            Err(e) => { leave_depth(p); return Err(e) }
          }
        } else {
          match parse_subexpr(p, 0) {
            Ok(e) => { leave_depth(p); e }
            Err(e) => { leave_depth(p); return Err(e) }
          }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        Ok(Some(Expr::AnyAllOp(lhs, op, is_all, rhs)))
      } else {
        let rhs = match parse_subexpr(p, prec) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if is_cmp && !is_sqlite_dialect(p) && is_comparison_tok(peek(p).kind) {
          return Err(err_here(p, "comparison operators are not associative"))
        }
        Ok(Some(Expr::BinaryOp(lhs, op, rhs)))
      }
    }
  }
}

fn parse_extract_expr(p : Parser) -> Result[Expr, SqlError] {
  let _ = advance(p)
  let _ = advance(p)
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let field = match parse_ident(p) {
    Ok(f) => f
    Err(e) => { leave_depth(p); return Err(e) }
  }
  match expect_kw(p, "FROM") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
  let src_e = match parse_subexpr(p, 0) {
    Ok(v) => v
    Err(e) => { leave_depth(p); return Err(e) }
  }
  leave_depth(p)
  match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
  Ok(Expr::Extract(field, src_e))
}

fn parse_position_expr(p : Parser) -> Result[Expr, SqlError] {
  let _ = advance(p)
  let _ = advance(p)
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let sub = match parse_subexpr(p, 38) {
    Ok(v) => v
    Err(e) => { leave_depth(p); return Err(e) }
  }
  match expect_kw(p, "IN") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
  let src_e = match parse_subexpr(p, 0) {
    Ok(v) => v
    Err(e) => { leave_depth(p); return Err(e) }
  }
  leave_depth(p)
  match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
  Ok(Expr::Position(sub, src_e))
}

fn parse_substring_expr(p : Parser) -> Result[Option[Expr], SqlError] {
  let save_pos = p.pos
  let _ = advance(p)
  let _ = advance(p)
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let base = match parse_subexpr(p, 0) {
    Ok(v) => v
    Err(e) => { leave_depth(p); return Err(e) }
  }
  if peek_kw(p, "FROM") || peek_kw(p, "FOR") {
    let from_e : Option[Expr] = if eat_kw(p, "FROM") {
      match parse_subexpr(p, 0) {
        Ok(v) => Some(v)
        Err(e) => { leave_depth(p); return Err(e) }
      }
    } else {
      None
    }
    let for_e : Option[Expr] = if eat_kw(p, "FOR") {
      match parse_subexpr(p, 0) {
        Ok(v) => Some(v)
        Err(e) => { leave_depth(p); return Err(e) }
      }
    } else {
      None
    }
    leave_depth(p)
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    return Ok(Some(Expr::Substring(base, from_e, for_e)))
  }
  leave_depth(p)
  p.pos = save_pos
  Ok(None)
}

fn parse_trim_expr(p : Parser) -> Result[Option[Expr], SqlError] {
  let save_pos = p.pos
  let _ = advance(p)
  let _ = advance(p)
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let where_kw : Option[String] = if eat_kw(p, "BOTH") {
    Some("BOTH")
  } else if eat_kw(p, "LEADING") {
    Some("LEADING")
  } else if eat_kw(p, "TRAILING") {
    Some("TRAILING")
  } else {
    None
  }
  let mut chars : Option[Expr] = None
  let mut has_from = false
  if eat_kw(p, "FROM") {
    has_from = true
  } else {
    match parse_subexpr(p, 0) {
      Ok(v) =>
      if eat_kw(p, "FROM") {
        chars = Some(v)
        has_from = true
      }
      Err(e) => { leave_depth(p); return Err(e) }
    }
  }
  if has_from {
    let target = match parse_subexpr(p, 0) {
      Ok(v) => v
      Err(e) => { leave_depth(p); return Err(e) }
    }
    leave_depth(p)
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    return Ok(Some(Expr::Trim(where_kw, chars, target)))
  }
  leave_depth(p)
  p.pos = save_pos
  Ok(None)
}

fn parse_prefix(p : Parser) -> Result[Expr, SqlError] {
  match bump_node(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = peek(p)
  match tok.kind {
    TokenKind::Number(n) => { let _ = advance(p); Ok(Expr::Number(n)) }
    TokenKind::SingleQuotedString(s) => { let _ = advance(p); Ok(Expr::SingleQuotedString(s)) }
    TokenKind::EscapedString(s) => { let _ = advance(p); Ok(Expr::EscapedString(s)) }
    TokenKind::DollarQuotedString(t, b) => { let _ = advance(p); Ok(Expr::DollarQuotedString(t, b)) }
    TokenKind::HexStringLiteral(h) => { let _ = advance(p); Ok(Expr::HexStringLiteral(h)) }
    TokenKind::Placeholder(ph) => { let _ = advance(p); Ok(Expr::Placeholder(ph)) }
    TokenKind::Star => { let _ = advance(p); Ok(Expr::Wildcard) }
    TokenKind::Plus => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let e = match parse_subexpr(p, 75) {
        Ok(v) => { leave_depth(p); v }
        Err(e) => { leave_depth(p); return Err(e) }
      }
      Ok(Expr::UnaryOp(UnaryOperator::Plus, e))
    }
    TokenKind::Minus => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let e = match parse_subexpr(p, 75) {
        Ok(v) => { leave_depth(p); v }
        Err(e) => { leave_depth(p); return Err(e) }
      }
      Ok(Expr::UnaryOp(UnaryOperator::Minus, e))
    }
    TokenKind::Tilde => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let e = match parse_subexpr(p, 75) {
        Ok(v) => { leave_depth(p); v }
        Err(e) => { leave_depth(p); return Err(e) }
      }
      Ok(Expr::UnaryOp(UnaryOperator::BitwiseNot, e))
    }
    TokenKind::At => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let e = match parse_subexpr(p, 75) {
        Ok(v) => { leave_depth(p); v }
        Err(e) => { leave_depth(p); return Err(e) }
      }
      Ok(Expr::PrefixOp("@", e))
    }
    TokenKind::PipeSlash => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      let e = match parse_subexpr(p, 75) {
        Ok(v) => { leave_depth(p); v }
        Err(e) => { leave_depth(p); return Err(e) }
      }
      Ok(Expr::PrefixOp("|/", e))
    }
    TokenKind::LParen => {
      let _ = advance(p)
      match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
      if peek_kw(p, "SELECT") || peek_kw(p, "WITH") || peek_kw(p, "VALUES") {
        let q = match parse_query(p) {
          Ok(v) => { leave_depth(p); v }
          Err(e) => { leave_depth(p); return Err(e) }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        return Ok(Expr::Subquery(q))
      }
      let first = match parse_subexpr(p, 0) {
        Ok(v) => v
        Err(e) => { leave_depth(p); return Err(e) }
      }
      if eat_comma(p) {
        let items : Array[Expr] = [first]
        while true {
          match parse_subexpr(p, 0) {
            Ok(v) => items.push(v)
            Err(e) => { leave_depth(p); return Err(e) }
          }
          if !eat_comma(p) {
            break
          }
        }
        leave_depth(p)
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        Ok(Expr::Tuple(items))
      } else {
        leave_depth(p)
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        Ok(Expr::Nested(first))
      }
    }
    TokenKind::Keyword(k) => {
      if k == "TRUE" {
        let _ = advance(p)
        return Ok(Expr::Boolean(true))
      }
      if k == "FALSE" {
        let _ = advance(p)
        return Ok(Expr::Boolean(false))
      }
      if k == "NULL" {
        let _ = advance(p)
        return Ok(Expr::Null)
      }
      if k == "DEFAULT" {
        let _ = advance(p)
        return Ok(Expr::Default)
      }
      if k == "INTERVAL" || k == "DATE" || k == "TIME" || k == "TIMESTAMP" {
        match peek_n(p, 1).kind {
          TokenKind::SingleQuotedString(s) => {
            let _ = advance(p)
            let _ = advance(p)
            let dt = if k == "INTERVAL" {
              DataType::Interval
            } else if k == "DATE" {
              DataType::Date
            } else if k == "TIME" {
              DataType::Time
            } else {
              DataType::Timestamp(false)
            }
            return Ok(Expr::TypedString(dt, s))
          }
          _ => ()
        }
      }
      if k == "EXTRACT" {
        match peek_n(p, 1).kind {
          TokenKind::LParen => return parse_extract_expr(p)
          _ => ()
        }
      }
      if k == "POSITION" {
        match peek_n(p, 1).kind {
          TokenKind::LParen => return parse_position_expr(p)
          _ => ()
        }
      }
      if k == "SUBSTRING" {
        match peek_n(p, 1).kind {
          TokenKind::LParen =>
          match parse_substring_expr(p) {
            Ok(Some(e)) => return Ok(e)
            Ok(None) => ()
            Err(e) => return Err(e)
          }
          _ => ()
        }
      }
      if k == "TRIM" {
        match peek_n(p, 1).kind {
          TokenKind::LParen =>
          match parse_trim_expr(p) {
            Ok(Some(e)) => return Ok(e)
            Ok(None) => ()
            Err(e) => return Err(e)
          }
          _ => ()
        }
      }
      if k == "NOT" {
        let _ = advance(p)
        if eat_kw(p, "EXISTS") {
          match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
          match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
          let q = match parse_query(p) {
            Ok(v) => { leave_depth(p); v }
            Err(e) => { leave_depth(p); return Err(e) }
          }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          return Ok(Expr::Exists(q, true))
        }
        match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
        let e = match parse_subexpr(p, 25) {
          Ok(v) => { leave_depth(p); v }
          Err(e) => { leave_depth(p); return Err(e) }
        }
        return Ok(Expr::UnaryOp(UnaryOperator::Not, e))
      }
      if k == "EXISTS" {
        let _ = advance(p)
        match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
        match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
        let q = match parse_query(p) {
          Ok(v) => { leave_depth(p); v }
          Err(e) => { leave_depth(p); return Err(e) }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        return Ok(Expr::Exists(q, false))
      }
      if k == "CASE" {
        let _ = advance(p)
        return parse_case_expr(p)
      }
      if k == "CAST" {
        let _ = advance(p)
        match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
        match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
        let inner = match parse_subexpr(p, 0) {
          Ok(v) => v
          Err(e) => { leave_depth(p); return Err(e) }
        }
        match expect_kw(p, "AS") {
          Ok(_) => ()
          Err(e) => { leave_depth(p); return Err(e) }
        }
        let dt = match parse_data_type(p) {
          Ok(d) => d
          Err(e) => { leave_depth(p); return Err(e) }
        }
        leave_depth(p)
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
        return Ok(Expr::Cast(inner, dt, false))
      }
      if k == "ARRAY" {
        match peek_n(p, 1).kind {
          TokenKind::LBracket => {
            let _ = advance(p)
            let _ = advance(p)
            match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
            let items : Array[Expr] = []
            let is_empty = match peek(p).kind {
              TokenKind::RBracket => { let _ = advance(p); true }
              _ => false
            }
            if !is_empty {
              while true {
                match parse_subexpr(p, 0) {
                  Ok(v) => items.push(v)
                  Err(e) => { leave_depth(p); return Err(e) }
                }
                if !eat_comma(p) {
                  break
                }
              }
              match peek(p).kind {
                TokenKind::RBracket => { let _ = advance(p) }
                _ => { leave_depth(p); return Err(err_here(p, "expected ']' in ARRAY literal")) }
              }
            }
            leave_depth(p)
            return Ok(Expr::Array(items))
          }
          TokenKind::LParen => {
            let _ = advance(p)
            let _ = advance(p)
            match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
            let q = match parse_query(p) {
              Ok(v) => { leave_depth(p); v }
              Err(e) => { leave_depth(p); return Err(e) }
            }
            match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
            return Ok(Expr::ArraySubquery(q))
          }
          _ => ()
        }
      }
      // Allow non-clause keywords as column/function identifiers (preserving original spelling!)
      if !is_clause_keyword(k) {
        let _ = advance(p)
        return parse_ident_or_func(p, Ident::new(tok_raw(p, tok)))
      }
      Err(err_here(p, "unexpected keyword " + k + " in expression"))
    }
    TokenKind::Ident(v, style) => {
      let _ = advance(p)
      parse_ident_or_func(p, Ident::{ value: v, quote_style: style })
    }
    _ => Err(err_here(p, "expected expression"))
  }
}

fn parse_case_expr(p : Parser) -> Result[Expr, SqlError] {
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let operand : Option[Expr] = if !peek_kw(p, "WHEN") {
    match parse_subexpr(p, 0) {
      Ok(e) => Some(e)
      Err(e) => { leave_depth(p); return Err(e) }
    }
  } else {
    None
  }
  let branches : Array[(Expr, Expr)] = []
  while eat_kw(p, "WHEN") {
    let cond = match parse_subexpr(p, 0) {
      Ok(e) => e
      Err(e) => { leave_depth(p); return Err(e) }
    }
    match expect_kw(p, "THEN") {
      Ok(_) => ()
      Err(e) => { leave_depth(p); return Err(e) }
    }
    let res = match parse_subexpr(p, 0) {
      Ok(e) => e
      Err(e) => { leave_depth(p); return Err(e) }
    }
    branches.push((cond, res))
  }
  let else_res : Option[Expr] = if eat_kw(p, "ELSE") {
    match parse_subexpr(p, 0) {
      Ok(e) => Some(e)
      Err(e) => { leave_depth(p); return Err(e) }
    }
  } else {
    None
  }
  leave_depth(p)
  match expect_kw(p, "END") { Ok(_) => () Err(e) => return Err(e) }
  Ok(Expr::Case(operand, branches, else_res))
}

fn parse_ident_or_func(p : Parser, first : Ident) -> Result[Expr, SqlError] {
  let parts : Array[Ident] = [first]
  while eat_dot(p) {
    match peek(p).kind {
      TokenKind::Star => {
        let _ = advance(p)
        return Ok(Expr::QualifiedWildcard(ObjectName::{ parts: parts }))
      }
      _ =>
      match parse_ident(p) {
        Ok(id) => parts.push(id)
        Err(e) => return Err(e)
      }
    }
  }
  if eat_lparen(p) {
    match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
    let distinct = eat_kw(p, "DISTINCT")
    let args : Array[Expr] = []
    let arg_order : Array[OrderByExpr] = []
    if !eat_rparen(p) {
      while true {
        match parse_subexpr(p, 0) {
          Ok(a) => args.push(a)
          Err(e) => { leave_depth(p); return Err(e) }
        }
        if !eat_comma(p) {
          break
        }
      }
      if eat_kw(p, "ORDER") {
        match expect_kw(p, "BY") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
        match parse_order_by_list(p, arg_order) {
          Ok(_) => ()
          Err(e) => { leave_depth(p); return Err(e) }
        }
      }
      match expect_rparen(p) {
        Ok(_) => ()
        Err(e) => { leave_depth(p); return Err(e) }
      }
    }
    let within_group : Array[OrderByExpr] = []
    if eat_kw(p, "WITHIN") {
      match expect_kw(p, "GROUP") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      match expect_lparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      match expect_kw(p, "ORDER") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      match expect_kw(p, "BY") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      match parse_order_by_list(p, within_group) {
        Ok(_) => ()
        Err(e) => { leave_depth(p); return Err(e) }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
    }
    let filter : Option[Expr] = if eat_kw(p, "FILTER") {
      match expect_lparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      match expect_kw(p, "WHERE") { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      let f = match parse_subexpr(p, 0) {
        Ok(v) => v
        Err(e) => { leave_depth(p); return Err(e) }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      Some(f)
    } else {
      None
    }
    let mut over : Option[WindowSpec] = None
    let mut over_name : Option[Ident] = None
    if eat_kw(p, "OVER") {
      match peek(p).kind {
        TokenKind::LParen =>
        match parse_window_spec(p) {
          Ok(ws) => over = Some(ws)
          Err(e) => { leave_depth(p); return Err(e) }
        }
        _ =>
        match parse_ident(p) {
          Ok(wn) => over_name = Some(wn)
          Err(e) => { leave_depth(p); return Err(e) }
        }
      }
    }
    leave_depth(p)
    let fc = FunctionCall::{
      name: ObjectName::{ parts: parts },
      distinct: distinct,
      args: args,
      filter: filter,
      over: over,
    }
    if arg_order.length() > 0 || within_group.length() > 0 || match over_name { Some(_) => true None => false } {
      return Ok(Expr::AggregateCall(fc, arg_order, within_group, over_name))
    }
    return Ok(Expr::Function(fc))
  }
  if parts.length() == 1 {
    Ok(Expr::Identifier(parts[0]))
  } else {
    Ok(Expr::CompoundIdentifier(parts))
  }
}

fn parse_window_bound(p : Parser) -> Result[WindowFrameBound, SqlError] {
  if eat_kw(p, "CURRENT") {
    match expect_kw(p, "ROW") { Ok(_) => () Err(e) => return Err(e) }
    return Ok(WindowFrameBound::CurrentRow)
  }
  if eat_kw(p, "UNBOUNDED") {
    if eat_kw(p, "PRECEDING") {
      return Ok(WindowFrameBound::Preceding(None))
    }
    if eat_kw(p, "FOLLOWING") {
      return Ok(WindowFrameBound::Following(None))
    }
    return Err(err_here(p, "expected PRECEDING or FOLLOWING after UNBOUNDED"))
  }
  let e = match parse_subexpr(p, 30) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if eat_kw(p, "PRECEDING") {
    Ok(WindowFrameBound::Preceding(Some(e)))
  } else if eat_kw(p, "FOLLOWING") {
    Ok(WindowFrameBound::Following(Some(e)))
  } else {
    Err(err_here(p, "expected PRECEDING or FOLLOWING in window frame bound"))
  }
}

fn parse_window_spec(p : Parser) -> Result[WindowSpec, SqlError] {
  match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
  let partition_by : Array[Expr] = []
  if eat_kw(p, "PARTITION") {
    match expect_kw(p, "BY") { Ok(_) => () Err(e) => return Err(e) }
    while true {
      match parse_expr(p) {
        Ok(e) => partition_by.push(e)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
  }
  let order_by : Array[OrderByExpr] = []
  if eat_kw(p, "ORDER") {
    match expect_kw(p, "BY") { Ok(_) => () Err(e) => return Err(e) }
    match parse_order_by_list(p, order_by) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let mut window_frame : Option[WindowFrame] = None
  let units : Option[WindowFrameUnits] = if eat_kw(p, "ROWS") {
    Some(WindowFrameUnits::Rows)
  } else if eat_kw(p, "RANGE") {
    Some(WindowFrameUnits::Range)
  } else if eat_kw(p, "GROUPS") {
    Some(WindowFrameUnits::Groups)
  } else {
    None
  }
  match units {
    Some(u) => {
      if eat_kw(p, "BETWEEN") {
        let start_b = match parse_window_bound(p) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        match expect_kw(p, "AND") { Ok(_) => () Err(e) => return Err(e) }
        let end_b = match parse_window_bound(p) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        window_frame = Some(WindowFrame::{ units: u, start_bound: start_b, end_bound: Some(end_b) })
      } else {
        let start_b = match parse_window_bound(p) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        window_frame = Some(WindowFrame::{ units: u, start_bound: start_b, end_bound: None })
      }
      // Optional PostgreSQL EXCLUDE CURRENT ROW | GROUP | TIES | NO OTHERS
      if eat_kw(p, "EXCLUDE") {
        if eat_kw(p, "CURRENT") {
          match expect_kw(p, "ROW") { Ok(_) => () Err(e) => return Err(e) }
        } else if eat_kw(p, "GROUP") || eat_kw(p, "TIES") {
          ()
        } else if eat_kw(p, "NO") {
          let _ = advance(p)
        }
      }
    }
    None => ()
  }
  match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
  Ok(WindowSpec::{ partition_by: partition_by, order_by: order_by, window_frame: window_frame })
}

// ============================================================================
// Query / SELECT / JOIN / CTE Parser
// ============================================================================

fn parse_order_by_expr(p : Parser) -> Result[OrderByExpr, SqlError] {
  let expr = match parse_expr(p) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  let asc : Option[Bool] = if eat_kw(p, "ASC") {
    Some(true)
  } else if eat_kw(p, "DESC") {
    Some(false)
  } else {
    None
  }
  let nulls_first : Option[Bool] = if eat_kw(p, "NULLS") {
    if eat_kw(p, "FIRST") {
      Some(true)
    } else if eat_kw(p, "LAST") {
      Some(false)
    } else {
      return Err(err_here(p, "expected FIRST or LAST after NULLS"))
    }
  } else {
    None
  }
  Ok(OrderByExpr::{ expr: expr, asc: asc, nulls_first: nulls_first })
}

fn parse_order_by_list(p : Parser, out : Array[OrderByExpr]) -> Result[Unit, SqlError] {
  while true {
    match parse_order_by_expr(p) {
      Ok(o) => out.push(o)
      Err(e) => return Err(e)
    }
    if !eat_comma(p) { break }
  }
  Ok(())
}

fn parse_optional_alias(p : Parser) -> Result[Option[Ident], SqlError] {
  if eat_kw(p, "AS") {
    match parse_ident(p) {
      Ok(id) => return Ok(Some(id))
      Err(e) => return Err(e)
    }
  }
  let tok = peek(p)
  match tok.kind {
    TokenKind::Ident(v, style) => {
      let _ = advance(p)
      Ok(Some(Ident::{ value: v, quote_style: style }))
    }
    TokenKind::Keyword(k) => {
      if !is_clause_keyword(k) {
        let _ = advance(p)
        Ok(Some(Ident::new(tok_raw(p, tok))))
      } else {
        Ok(None)
      }
    }
    TokenKind::SingleQuotedString(s) => {
      if is_sqlite_dialect(p) {
        let _ = advance(p)
        Ok(Some(Ident::quoted(s, QuoteStyle::DoubleQuote)))
      } else {
        Ok(None)
      }
    }
    _ => Ok(None)
  }
}

fn parse_optional_table_alias(p : Parser) -> Result[Option[TableAlias], SqlError] {
  let name = match parse_optional_alias(p) {
    Ok(Some(id)) => id
    Ok(None) => return Ok(None)
    Err(e) => return Err(e)
  }
  let cols : Array[Ident] = []
  if eat_lparen(p) {
    if !eat_rparen(p) {
      while true {
        match parse_ident(p) {
          Ok(c) => cols.push(c)
          Err(e) => return Err(e)
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    }
  }
  Ok(Some(TableAlias::{ name: name, columns: cols }))
}

fn parse_select_item(p : Parser) -> Result[SelectItem, SqlError] {
  match peek(p).kind {
    TokenKind::Star => {
      let _ = advance(p)
      return Ok(SelectItem::Wildcard)
    }
    _ => ()
  }
  let expr = match parse_subexpr(p, 0) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  match expr {
    Expr::QualifiedWildcard(name) => return Ok(SelectItem::QualifiedWildcard(name))
    _ => ()
  }
  match parse_optional_alias(p) {
    Ok(Some(alias)) => Ok(SelectItem::ExprWithAlias(expr, alias))
    Ok(None) => Ok(SelectItem::UnnamedExpr(expr))
    Err(e) => Err(e)
  }
}

fn parse_select_item_list(p : Parser) -> Result[Array[SelectItem], SqlError] {
  let items : Array[SelectItem] = []
  while true {
    match parse_select_item(p) {
      Ok(it) => items.push(it)
      Err(e) => return Err(e)
    }
    if !eat_comma(p) { break }
  }
  Ok(items)
}

fn parse_table_factor(p : Parser) -> Result[TableFactor, SqlError] {
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let lateral = eat_kw(p, "LATERAL")
  if eat_lparen(p) {
    if peek_kw(p, "SELECT") || peek_kw(p, "WITH") || peek_kw(p, "VALUES") {
      let q = match parse_query(p) {
        Ok(v) => v
        Err(e) => { leave_depth(p); return Err(e) }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      let alias = match parse_optional_table_alias(p) {
        Ok(a) => a
        Err(e) => { leave_depth(p); return Err(e) }
      }
      leave_depth(p)
      return Ok(TableFactor::Derived(lateral, q, alias))
    }
    let nested = match parse_table_with_joins(p) {
      Ok(t) => t
      Err(e) => { leave_depth(p); return Err(e) }
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
    leave_depth(p)
    return Ok(TableFactor::NestedJoin(nested))
  }
  let _ = eat_kw(p, "ONLY")
  let name = match parse_object_name(p) {
    Ok(n) => n
    Err(e) => { leave_depth(p); return Err(e) }
  }
  if eat_lparen(p) {
    let args : Array[Expr] = []
    if !eat_rparen(p) {
      while true {
        match parse_expr(p) {
          Ok(e) => args.push(e)
          Err(e) => { leave_depth(p); return Err(e) }
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
    }
    let alias = match parse_optional_table_alias(p) {
      Ok(a) => a
      Err(e) => { leave_depth(p); return Err(e) }
    }
    leave_depth(p)
    return Ok(TableFactor::TableFunction(name, args, alias))
  }
  let alias = match parse_optional_table_alias(p) {
    Ok(a) => a
    Err(e) => { leave_depth(p); return Err(e) }
  }
  // Optional PostgreSQL TABLESAMPLE method (args)
  if eat_kw(p, "TABLESAMPLE") {
    let _ = parse_ident(p)
    if eat_lparen(p) {
      if !eat_rparen(p) {
        while true {
          let _ = parse_expr(p)
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => { leave_depth(p); return Err(e) } }
      }
    }
  }
  leave_depth(p)
  Ok(TableFactor::Table(name, alias))
}

fn parse_join_constraint(p : Parser) -> Result[JoinConstraint, SqlError] {
  if eat_kw(p, "ON") {
    match parse_expr(p) {
      Ok(e) => return Ok(JoinConstraint::On(e))
      Err(e) => return Err(e)
    }
  }
  if eat_kw(p, "USING") {
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let cols : Array[Ident] = []
    while true {
      match parse_ident(p) {
        Ok(c) => cols.push(c)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    return Ok(JoinConstraint::Using(cols))
  }
  Ok(JoinConstraint::None)
}

fn parse_table_with_joins(p : Parser) -> Result[TableWithJoins, SqlError] {
  let relation = match parse_table_factor(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let joins : Array[Join] = []
  while true {
    if eat_kw(p, "NATURAL") {
      if eat_kw(p, "LEFT") {
        let _ = eat_kw(p, "OUTER")
        match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
        let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
        joins.push(Join::{ relation: rel, join_operator: JoinOperator::NaturalLeft })
      } else if eat_kw(p, "RIGHT") {
        let _ = eat_kw(p, "OUTER")
        match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
        let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
        joins.push(Join::{ relation: rel, join_operator: JoinOperator::NaturalRight })
      } else if eat_kw(p, "FULL") {
        let _ = eat_kw(p, "OUTER")
        match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
        let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
        joins.push(Join::{ relation: rel, join_operator: JoinOperator::NaturalFull })
      } else {
        let _ = eat_kw(p, "INNER")
        match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
        let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
        joins.push(Join::{ relation: rel, join_operator: JoinOperator::NaturalInner })
      }
      continue
    }
    if eat_kw(p, "CROSS") {
      match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::CrossJoin })
      continue
    }
    if eat_kw(p, "INNER") {
      match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      let c = match parse_join_constraint(p) { Ok(v) => v Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::Inner(c) })
      continue
    }
    if eat_kw(p, "JOIN") {
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      let c = match parse_join_constraint(p) { Ok(v) => v Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::Inner(c) })
      continue
    }
    if eat_kw(p, "LEFT") {
      let _ = eat_kw(p, "OUTER")
      match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      let c = match parse_join_constraint(p) { Ok(v) => v Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::LeftOuter(c) })
      continue
    }
    if eat_kw(p, "RIGHT") {
      let _ = eat_kw(p, "OUTER")
      match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      let c = match parse_join_constraint(p) { Ok(v) => v Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::RightOuter(c) })
      continue
    }
    if eat_kw(p, "FULL") {
      let _ = eat_kw(p, "OUTER")
      match expect_kw(p, "JOIN") { Ok(_) => () Err(e) => return Err(e) }
      let rel = match parse_table_factor(p) { Ok(r) => r Err(e) => return Err(e) }
      let c = match parse_join_constraint(p) { Ok(v) => v Err(e) => return Err(e) }
      joins.push(Join::{ relation: rel, join_operator: JoinOperator::FullOuter(c) })
      continue
    }
    break
  }
  Ok(TableWithJoins::{ relation: relation, joins: joins })
}

fn parse_group_by_list(p : Parser, group_by : Array[Expr]) -> Result[Unit, SqlError] {
  while true {
    if eat_kw(p, "ROLLUP") {
      match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
      let items : Array[Expr] = []
      if !eat_rparen(p) {
        while true {
          match parse_expr(p) { Ok(e) => items.push(e) Err(e) => return Err(e) }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
      group_by.push(Expr::GroupingSet("ROLLUP", items))
    } else if eat_kw(p, "CUBE") {
      match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
      let items : Array[Expr] = []
      if !eat_rparen(p) {
        while true {
          match parse_expr(p) { Ok(e) => items.push(e) Err(e) => return Err(e) }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
      group_by.push(Expr::GroupingSet("CUBE", items))
    } else if eat_kw(p, "GROUPING") {
      let _ = parse_ident(p)
      match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
      let items : Array[Expr] = []
      if !eat_rparen(p) {
        while true {
          if eat_lparen(p) {
            let sub : Array[Expr] = []
            if !eat_rparen(p) {
              while true {
                match parse_expr(p) { Ok(e) => sub.push(e) Err(e) => return Err(e) }
                if !eat_comma(p) { break }
              }
              match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
            }
            items.push(Expr::Tuple(sub))
          } else {
            match parse_expr(p) { Ok(e) => items.push(e) Err(e) => return Err(e) }
          }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
      group_by.push(Expr::GroupingSet("GROUPING SETS", items))
    } else {
      match parse_expr(p) {
        Ok(e) => group_by.push(e)
        Err(e) => return Err(e)
      }
    }
    if !eat_comma(p) { break }
  }
  Ok(())
}

fn parse_select(p : Parser) -> Result[Select, SqlError] {
  match expect_kw(p, "SELECT") { Ok(_) => () Err(e) => return Err(e) }
  let distinct : DistinctKind = if eat_kw(p, "DISTINCT") {
    if eat_kw(p, "ON") {
      match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
      let exprs : Array[Expr] = []
      while true {
        match parse_expr(p) {
          Ok(e) => exprs.push(e)
          Err(e) => return Err(e)
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      DistinctKind::DistinctOn(exprs)
    } else {
      DistinctKind::Distinct
    }
  } else if eat_kw(p, "ALL") {
    DistinctKind::All
  } else {
    DistinctKind::None
  }
  let projection : Array[SelectItem] = []
  while true {
    match parse_select_item(p) {
      Ok(it) => projection.push(it)
      Err(e) => return Err(e)
    }
    if !eat_comma(p) { break }
  }
  let from : Array[TableWithJoins] = []
  if eat_kw(p, "FROM") {
    while true {
      match parse_table_with_joins(p) {
        Ok(twj) => from.push(twj)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
  }
  let selection : Option[Expr] = if eat_kw(p, "WHERE") {
    match parse_expr(p) {
      Ok(e) => Some(e)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  let group_by : Array[Expr] = []
  if eat_kw(p, "GROUP") {
    match expect_kw(p, "BY") { Ok(_) => () Err(e) => return Err(e) }
    match parse_group_by_list(p, group_by) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let having : Option[Expr] = if eat_kw(p, "HAVING") {
    match parse_expr(p) {
      Ok(e) => Some(e)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  Ok(
    Select::{
      distinct: distinct,
      projection: projection,
      from: from,
      selection: selection,
      group_by: group_by,
      having: having,
    },
  )
}

fn parse_values(p : Parser) -> Result[SetExpr, SqlError] {
  match expect_kw(p, "VALUES") { Ok(_) => () Err(e) => return Err(e) }
  let rows : Array[Array[Expr]] = []
  while true {
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let row : Array[Expr] = []
    if !eat_rparen(p) {
      while true {
        match parse_expr(p) {
          Ok(e) => row.push(e)
          Err(e) => return Err(e)
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    }
    rows.push(row)
    if !eat_comma(p) { break }
  }
  Ok(SetExpr::Values(rows))
}

fn parse_set_factor(p : Parser) -> Result[SetExpr, SqlError] {
  if peek_kw(p, "SELECT") {
    match parse_select(p) {
      Ok(sel) => {
        if eat_kw(p, "WINDOW") {
          let wins : Array[(Ident, WindowSpec)] = []
          while true {
            let wn = match parse_ident(p) { Ok(id) => id Err(e) => return Err(e) }
            match expect_kw(p, "AS") { Ok(_) => () Err(e) => return Err(e) }
            let ws = match parse_window_spec(p) { Ok(w) => w Err(e) => return Err(e) }
            wins.push((wn, ws))
            if !eat_comma(p) { break }
          }
          Ok(SetExpr::SelectWithWindows(sel, wins))
        } else {
          Ok(SetExpr::Select(sel))
        }
      }
      Err(e) => Err(e)
    }
  } else if peek_kw(p, "VALUES") {
    parse_values(p)
  } else if eat_kw(p, "TABLE") {
    match parse_object_name(p) {
      Ok(name) => Ok(SetExpr::TableRef(name))
      Err(e) => Err(e)
    }
  } else if eat_lparen(p) {
    match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
    let q = match parse_query(p) {
      Ok(v) => { leave_depth(p); v }
      Err(e) => { leave_depth(p); return Err(e) }
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    Ok(SetExpr::Query(q))
  } else {
    Err(err_here(p, "expected SELECT, VALUES, or '(' in query"))
  }
}

fn parse_set_expr(p : Parser) -> Result[SetExpr, SqlError] {
  // Parse INTERSECT tighter than UNION / EXCEPT iteratively without an extra recursion frame per subquery.
  let mut left = match parse_set_factor(p) {
    Ok(f) => f
    Err(e) => return Err(e)
  }
  let mut chain_depth = 0
  while eat_kw(p, "INTERSECT") {
    chain_depth = chain_depth + 1
    if p.depth + chain_depth > p.opts.max_depth {
      return Err(err_here(p, "max_depth limit exceeded"))
    }
    let all = eat_kw(p, "ALL")
    let _ = if !all { eat_kw(p, "DISTINCT") } else { false }
    let r = match parse_set_factor(p) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    left = SetExpr::SetOperation(SetOperator::Intersect, all, left, r)
  }
  while true {
    let op : Option[SetOperator] = if eat_kw(p, "UNION") {
      Some(SetOperator::Union)
    } else if eat_kw(p, "EXCEPT") {
      Some(SetOperator::Except)
    } else {
      None
    }
    match op {
      Some(sop) => {
        chain_depth = chain_depth + 1
        if p.depth + chain_depth > p.opts.max_depth {
          return Err(err_here(p, "max_depth limit exceeded"))
        }
        let all = eat_kw(p, "ALL")
        let _ = if !all { eat_kw(p, "DISTINCT") } else { false }
        let mut right = match parse_set_factor(p) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        let mut r_depth = 0
        while eat_kw(p, "INTERSECT") {
          r_depth = r_depth + 1
          if p.depth + chain_depth + r_depth > p.opts.max_depth {
            return Err(err_here(p, "max_depth limit exceeded"))
          }
          let r_all = eat_kw(p, "ALL")
          let _ = if !r_all { eat_kw(p, "DISTINCT") } else { false }
          let rr = match parse_set_factor(p) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          right = SetExpr::SetOperation(SetOperator::Intersect, r_all, right, rr)
        }
        left = SetExpr::SetOperation(sop, all, left, right)
      }
      None => break
    }
  }
  Ok(left)
}

fn parse_with_clause(p : Parser) -> Result[With, SqlError] {
  match expect_kw(p, "WITH") { Ok(_) => () Err(e) => return Err(e) }
  let recursive = eat_kw(p, "RECURSIVE")
  let ctes : Array[Cte] = []
  while true {
    let alias = match parse_ident(p) {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    let cols : Array[Ident] = []
    if eat_lparen(p) {
      if !eat_rparen(p) {
        while true {
          match parse_ident(p) {
            Ok(c) => cols.push(c)
            Err(e) => return Err(e)
          }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
    }
    match expect_kw(p, "AS") { Ok(_) => () Err(e) => return Err(e) }
    let materialized : Option[Bool] = if eat_kw(p, "MATERIALIZED") {
      Some(true)
    } else if eat_kw(p, "NOT") {
      match expect_kw(p, "MATERIALIZED") { Ok(_) => () Err(e) => return Err(e) }
      Some(false)
    } else {
      None
    }
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
    let q = match parse_query(p) {
      Ok(v) => { leave_depth(p); v }
      Err(e) => { leave_depth(p); return Err(e) }
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    ctes.push(Cte::{ alias: alias, columns: cols, query: q, materialized: materialized })
    if !eat_comma(p) { break }
  }
  Ok(With::{ recursive: recursive, cte_tables: ctes })
}

fn parse_query(p : Parser) -> Result[Query, SqlError] {
  let with_clause : Option[With] = if peek_kw(p, "WITH") {
    match parse_with_clause(p) {
      Ok(w) => Some(w)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  let body = match parse_set_expr(p) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let order_by : Array[OrderByExpr] = []
  if eat_kw(p, "ORDER") {
    match expect_kw(p, "BY") { Ok(_) => () Err(e) => return Err(e) }
    match parse_order_by_list(p, order_by) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let mut limit : Option[Expr] = None
  let mut offset : Option[Expr] = None
  if eat_kw(p, "LIMIT") {
    if !eat_kw(p, "ALL") {
      let first_e = match parse_expr(p) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      if eat_comma(p) {
        // SQLite `LIMIT offset, count`
        let cnt_e = match parse_expr(p) {
          Ok(e) => e
          Err(e) => return Err(e)
        }
        offset = Some(first_e)
        limit = Some(cnt_e)
      } else {
        limit = Some(first_e)
      }
    }
  }
  if eat_kw(p, "OFFSET") {
    match parse_expr(p) {
      Ok(e) => offset = Some(e)
      Err(e) => return Err(e)
    }
    let _ = eat_kw(p, "ROW") || eat_kw(p, "ROWS")
  }
  if eat_kw(p, "FETCH") {
    if !(eat_kw(p, "FIRST") || eat_kw(p, "NEXT")) {
      return Err(err_here(p, "expected FIRST or NEXT after FETCH"))
    }
    if !(peek_kw(p, "ROW") || peek_kw(p, "ROWS")) {
      match parse_expr(p) {
        Ok(e) => limit = Some(e)
        Err(e) => return Err(e)
      }
    } else {
      limit = Some(Expr::Number("1"))
    }
    if !(eat_kw(p, "ROW") || eat_kw(p, "ROWS")) {
      return Err(err_here(p, "expected ROW or ROWS in FETCH clause"))
    }
    if eat_kw(p, "ONLY") {
      ()
    } else if eat_kw(p, "WITH") {
      match expect_kw(p, "TIES") { Ok(_) => () Err(e) => return Err(e) }
    } else {
      return Err(err_here(p, "expected ONLY or WITH TIES in FETCH clause"))
    }
  }
  Ok(
    Query::{
      with_clause: with_clause,
      body: body,
      order_by: order_by,
      limit: limit,
      offset: offset,
    },
  )
}

// ============================================================================
// DML: INSERT / UPDATE / DELETE
// ============================================================================

fn parse_assignments(p : Parser) -> Result[Array[Assignment], SqlError] {
  let assigns : Array[Assignment] = []
  while true {
    let target = match parse_ident(p) {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    match peek(p).kind {
      TokenKind::Eq => { let _ = advance(p) }
      _ => return Err(err_here(p, "expected '=' in assignment"))
    }
    let rhs_val = match parse_expr(p) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    assigns.push(Assignment::{ target: target, value: rhs_val })
    if !eat_comma(p) { break }
  }
  Ok(assigns)
}

fn parse_returning(p : Parser) -> Result[Array[SelectItem], SqlError] {
  if eat_kw(p, "RETURNING") {
    parse_select_item_list(p)
  } else {
    Ok([])
  }
}

fn parse_insert(p : Parser) -> Result[Statement, SqlError] {
  let mut or_action : Option[String] = None
  let mut is_replace_stmt = false
  if eat_kw(p, "REPLACE") {
    is_replace_stmt = true
  } else {
    match expect_kw(p, "INSERT") { Ok(_) => () Err(e) => return Err(e) }
    if eat_kw(p, "OR") {
      if eat_kw(p, "REPLACE") { or_action = Some("REPLACE") }
      else if eat_kw(p, "IGNORE") { or_action = Some("IGNORE") }
      else if eat_kw(p, "ABORT") { or_action = Some("ABORT") }
      else if eat_kw(p, "FAIL") { or_action = Some("FAIL") }
      else if eat_kw(p, "ROLLBACK") { or_action = Some("ROLLBACK") }
      else { return Err(err_here(p, "expected conflict resolution action after INSERT OR")) }
    }
  }
  match expect_kw(p, "INTO") { Ok(_) => () Err(e) => return Err(e) }
  let table_name = match parse_object_name(p) {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  // Optional PostgreSQL `INSERT INTO tbl AS alias`
  if eat_kw(p, "AS") {
    let _ = parse_ident(p)
  }
  let columns : Array[Ident] = []
  if eat_lparen(p) {
    if !eat_rparen(p) {
      while true {
        match parse_ident(p) {
          Ok(c) => columns.push(c)
          Err(e) => return Err(e)
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    }
  }
  let source = if eat_kw(p, "DEFAULT") {
    match expect_kw(p, "VALUES") { Ok(_) => () Err(e) => return Err(e) }
    Query::{ with_clause: None, body: SetExpr::DefaultValues, order_by: [], limit: None, offset: None }
  } else {
    match parse_query(p) {
      Ok(q) => q
      Err(e) => return Err(e)
    }
  }
  let on_conflict : Option[OnConflict] = if eat_kw(p, "ON") {
    match expect_kw(p, "CONFLICT") { Ok(_) => () Err(e) => return Err(e) }
    let target_cols : Array[Ident] = []
    if eat_kw(p, "ON") {
      match expect_kw(p, "CONSTRAINT") { Ok(_) => () Err(e) => return Err(e) }
      match parse_ident(p) { Ok(_) => () Err(e) => return Err(e) }
    } else if eat_lparen(p) {
      if !eat_rparen(p) {
        while true {
          match parse_ident(p) {
            Ok(c) => target_cols.push(c)
            Err(e) => return Err(e)
          }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
      // Optional index predicate WHERE expr
      if eat_kw(p, "WHERE") {
        match parse_expr(p) { Ok(_) => () Err(e) => return Err(e) }
      }
    }
    match expect_kw(p, "DO") { Ok(_) => () Err(e) => return Err(e) }
    let action = if eat_kw(p, "NOTHING") {
      OnConflictAction::DoNothing
    } else if eat_kw(p, "UPDATE") {
      match expect_kw(p, "SET") { Ok(_) => () Err(e) => return Err(e) }
      let assigns = match parse_assignments(p) {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      let wh : Option[Expr] = if eat_kw(p, "WHERE") {
        match parse_expr(p) {
          Ok(e) => Some(e)
          Err(e) => return Err(e)
        }
      } else {
        None
      }
      OnConflictAction::DoUpdate(assigns, wh)
    } else {
      return Err(err_here(p, "expected NOTHING or UPDATE after ON CONFLICT DO"))
    }
    Some(OnConflict::{ target_columns: target_cols, action: action })
  } else {
    None
  }
  let returning = match parse_returning(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ins = InsertStmt::{
    table_name: table_name,
    columns: columns,
    source: source,
    on_conflict: on_conflict,
    returning: returning,
  }
  if is_replace_stmt {
    Ok(Statement::InsertOr(None, ins))
  } else {
    match or_action {
      Some(_) => Ok(Statement::InsertOr(or_action, ins))
      None => Ok(Statement::Insert(ins))
    }
  }
}

fn parse_update(p : Parser) -> Result[Statement, SqlError] {
  match expect_kw(p, "UPDATE") { Ok(_) => () Err(e) => return Err(e) }
  let table = match parse_table_with_joins(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match expect_kw(p, "SET") { Ok(_) => () Err(e) => return Err(e) }
  let multi_assigns : Array[(Array[Ident], Expr)] = []
  let mut has_multi = false
  while true {
    if eat_lparen(p) {
      has_multi = true
      let cols : Array[Ident] = []
      while true {
        match parse_ident(p) { Ok(id) => cols.push(id) Err(e) => return Err(e) }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      match peek(p).kind {
        TokenKind::Eq => { let _ = advance(p) }
        _ => return Err(err_here(p, "expected '=' in assignment"))
      }
      let rhs_val = match parse_expr(p) { Ok(e) => e Err(e) => return Err(e) }
      multi_assigns.push((cols, rhs_val))
    } else {
      let target = match parse_ident(p) { Ok(id) => id Err(e) => return Err(e) }
      match peek(p).kind {
        TokenKind::Eq => { let _ = advance(p) }
        _ => return Err(err_here(p, "expected '=' in assignment"))
      }
      let rhs_val = match parse_expr(p) { Ok(e) => e Err(e) => return Err(e) }
      multi_assigns.push(([target], rhs_val))
    }
    if !eat_comma(p) { break }
  }
  let from : Array[TableWithJoins] = []
  if eat_kw(p, "FROM") {
    while true {
      match parse_table_with_joins(p) {
        Ok(twj) => from.push(twj)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
  }
  let selection : Option[Expr] = if eat_kw(p, "WHERE") {
    match parse_expr(p) {
      Ok(e) => Some(e)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  let returning = match parse_returning(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if has_multi {
    return Ok(Statement::UpdateMulti(table, multi_assigns, from, selection, returning))
  }
  let assignments : Array[Assignment] = []
  let mut i = 0
  while i < multi_assigns.length() {
    let (cols, av) = multi_assigns[i]
    assignments.push(Assignment::{ target: cols[0], value: av })
    i = i + 1
  }
  Ok(
    Statement::Update(
      UpdateStmt::{
        table: table,
        assignments: assignments,
        from: from,
        selection: selection,
        returning: returning,
      },
    ),
  )
}

fn parse_delete(p : Parser) -> Result[Statement, SqlError] {
  match expect_kw(p, "DELETE") { Ok(_) => () Err(e) => return Err(e) }
  match expect_kw(p, "FROM") { Ok(_) => () Err(e) => return Err(e) }
  let from = match parse_table_with_joins(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let using_tbls : Array[TableWithJoins] = []
  if eat_kw(p, "USING") {
    while true {
      match parse_table_with_joins(p) {
        Ok(twj) => using_tbls.push(twj)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
  }
  let selection : Option[Expr] = if eat_kw(p, "WHERE") {
    match parse_expr(p) {
      Ok(e) => Some(e)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  let returning = match parse_returning(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if using_tbls.length() > 0 {
    return Ok(Statement::DeleteUsing(from, using_tbls, selection, returning))
  }
  Ok(Statement::Delete(DeleteStmt::{ from: from, selection: selection, returning: returning }))
}

// ============================================================================
// DDL: CREATE / ALTER / DROP
// ============================================================================

fn parse_ref_action(p : Parser) -> Result[ReferentialAction, SqlError] {
  if eat_kw(p, "CASCADE") {
    Ok(ReferentialAction::Cascade)
  } else if eat_kw(p, "RESTRICT") {
    Ok(ReferentialAction::Restrict)
  } else if eat_kw(p, "SET") {
    if eat_kw(p, "NULL") {
      Ok(ReferentialAction::SetNull)
    } else if eat_kw(p, "DEFAULT") {
      Ok(ReferentialAction::SetDefault)
    } else {
      Err(err_here(p, "expected NULL or DEFAULT after SET"))
    }
  } else if eat_kw(p, "NO") {
    match expect_kw(p, "ACTION") { Ok(_) => () Err(e) => return Err(e) }
    Ok(ReferentialAction::NoAction)
  } else {
    Err(err_here(p, "expected referential action"))
  }
}

fn is_col_constraint_start(p : Parser) -> Bool {
  peek_kw(p, "NOT") || peek_kw(p, "NULL") || peek_kw(p, "PRIMARY") ||
  peek_kw(p, "UNIQUE") || peek_kw(p, "DEFAULT") || peek_kw(p, "CHECK") ||
  peek_kw(p, "REFERENCES") || peek_kw(p, "CONSTRAINT") || peek_kw(p, "GENERATED")
}

fn parse_single_col_constraint(p : Parser) -> Result[Option[ColumnConstraint], SqlError] {
  if eat_kw(p, "CONSTRAINT") {
    let cname = match parse_ident(p) { Ok(id) => id Err(e) => return Err(e) }
    match parse_single_col_constraint(p) {
      Ok(Some(inner)) => return Ok(Some(ColumnConstraint::Named(cname, inner)))
      Ok(None) => return Err(err_here(p, "expected column constraint after CONSTRAINT name"))
      Err(e) => return Err(e)
    }
  }
  if eat_kw(p, "NOT") {
    match expect_kw(p, "NULL") { Ok(_) => () Err(e) => return Err(e) }
    return Ok(Some(ColumnConstraint::NotNull))
  }
  if eat_kw(p, "NULL") {
    return Ok(Some(ColumnConstraint::Null))
  }
  if eat_kw(p, "PRIMARY") {
    match expect_kw(p, "KEY") { Ok(_) => () Err(e) => return Err(e) }
    let autoinc = eat_kw(p, "AUTOINCREMENT")
    return Ok(Some(ColumnConstraint::PrimaryKey(autoinc)))
  }
  if eat_kw(p, "UNIQUE") {
    return Ok(Some(ColumnConstraint::Unique))
  }
  if eat_kw(p, "DEFAULT") {
    let e = match parse_expr(p) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(ColumnConstraint::Default(e)))
  }
  if eat_kw(p, "CHECK") {
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let e = match parse_expr(p) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    return Ok(Some(ColumnConstraint::Check(e)))
  }
  if eat_kw(p, "GENERATED") {
    let always = if eat_kw(p, "ALWAYS") {
      true
    } else if eat_kw(p, "BY") {
      match expect_kw(p, "DEFAULT") { Ok(_) => () Err(e) => return Err(e) }
      false
    } else {
      return Err(err_here(p, "expected ALWAYS or BY DEFAULT after GENERATED"))
    }
    match expect_kw(p, "AS") { Ok(_) => () Err(e) => return Err(e) }
    if eat_kw(p, "IDENTITY") {
      return Ok(Some(ColumnConstraint::Generated(None, always, false)))
    }
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let e = match parse_expr(p) { Ok(v) => v Err(e) => return Err(e) }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let stored = eat_kw(p, "STORED")
    let _ = if !stored { eat_kw(p, "VIRTUAL") } else { false }
    return Ok(Some(ColumnConstraint::Generated(Some(e), always, stored)))
  }
  if eat_kw(p, "REFERENCES") {
    let ref_tbl = match parse_object_name(p) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ref_cols : Array[Ident] = []
    if eat_lparen(p) {
      if !eat_rparen(p) {
        while true {
          match parse_ident(p) {
            Ok(c) => ref_cols.push(c)
            Err(e) => return Err(e)
          }
          if !eat_comma(p) { break }
        }
        match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      }
    }
    let mut on_del : Option[ReferentialAction] = None
    let mut on_upd : Option[ReferentialAction] = None
    while eat_kw(p, "ON") {
      if eat_kw(p, "DELETE") {
        match parse_ref_action(p) {
          Ok(a) => on_del = Some(a)
          Err(e) => return Err(e)
        }
      } else if eat_kw(p, "UPDATE") {
        match parse_ref_action(p) {
          Ok(a) => on_upd = Some(a)
          Err(e) => return Err(e)
        }
      } else {
        return Err(err_here(p, "expected DELETE or UPDATE after ON"))
      }
    }
    return Ok(Some(ColumnConstraint::References(ref_tbl, ref_cols, on_del, on_upd)))
  }
  Ok(None)
}

fn parse_column_def(p : Parser) -> Result[ColumnDef, SqlError] {
  let name = match parse_ident(p) {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let no_type = match peek(p).kind {
    TokenKind::Comma | TokenKind::RParen => true
    _ => is_col_constraint_start(p)
  }
  let data_type = if no_type {
    DataType::Unspecified
  } else {
    match parse_data_type(p) {
      Ok(dt) => dt
      Err(e) => return Err(e)
    }
  }
  let constraints : Array[ColumnConstraint] = []
  while true {
    match parse_single_col_constraint(p) {
      Ok(Some(c)) => constraints.push(c)
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  Ok(ColumnDef::{ name: name, data_type: data_type, constraints: constraints })
}

fn parse_ident_paren_list(p : Parser) -> Result[Array[Ident], SqlError] {
  match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
  let cols : Array[Ident] = []
  if !eat_rparen(p) {
    while true {
      match parse_ident(p) {
        Ok(c) => cols.push(c)
        Err(e) => return Err(e)
      }
      if !eat_comma(p) { break }
    }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
  }
  Ok(cols)
}

fn parse_table_constraint(p : Parser) -> Result[TableConstraint, SqlError] {
  let name : Option[Ident] = if eat_kw(p, "CONSTRAINT") {
    match parse_ident(p) {
      Ok(id) => Some(id)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  if eat_kw(p, "PRIMARY") {
    match expect_kw(p, "KEY") { Ok(_) => () Err(e) => return Err(e) }
    let cols = match parse_ident_paren_list(p) { Ok(c) => c Err(e) => return Err(e) }
    return Ok(TableConstraint::PrimaryKey(name, cols))
  }
  if eat_kw(p, "UNIQUE") {
    let cols = match parse_ident_paren_list(p) { Ok(c) => c Err(e) => return Err(e) }
    return Ok(TableConstraint::Unique(name, cols))
  }
  if eat_kw(p, "CHECK") {
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let e = match parse_expr(p) { Ok(v) => v Err(e) => return Err(e) }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    return Ok(TableConstraint::Check(name, e))
  }
  if eat_kw(p, "FOREIGN") {
    match expect_kw(p, "KEY") { Ok(_) => () Err(e) => return Err(e) }
    let cols = match parse_ident_paren_list(p) { Ok(c) => c Err(e) => return Err(e) }
    match expect_kw(p, "REFERENCES") { Ok(_) => () Err(e) => return Err(e) }
    let ref_tbl = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    let ref_cols = match peek(p).kind {
      TokenKind::LParen =>
      match parse_ident_paren_list(p) { Ok(c) => c Err(e) => return Err(e) }
      _ => []
    }
    let mut on_del : Option[ReferentialAction] = None
    let mut on_upd : Option[ReferentialAction] = None
    while eat_kw(p, "ON") {
      if eat_kw(p, "DELETE") {
        match parse_ref_action(p) { Ok(a) => on_del = Some(a) Err(e) => return Err(e) }
      } else if eat_kw(p, "UPDATE") {
        match parse_ref_action(p) { Ok(a) => on_upd = Some(a) Err(e) => return Err(e) }
      } else {
        return Err(err_here(p, "expected DELETE or UPDATE after ON"))
      }
    }
    return Ok(TableConstraint::ForeignKey(name, cols, ref_tbl, ref_cols, on_del, on_upd))
  }
  Err(err_here(p, "expected table constraint"))
}

fn parse_create(p : Parser) -> Result[Statement, SqlError] {
  match expect_kw(p, "CREATE") { Ok(_) => () Err(e) => return Err(e) }
  let mut or_replace = false
  if eat_kw(p, "OR") {
    match expect_kw(p, "REPLACE") { Ok(_) => () Err(e) => return Err(e) }
    or_replace = true
  }
  let temporary = eat_kw(p, "TEMP") || eat_kw(p, "TEMPORARY")
  let _ = eat_kw(p, "UNLOGGED")
  let unique = eat_kw(p, "UNIQUE")

  if eat_kw(p, "SCHEMA") {
    let _ = if eat_kw(p, "IF") {
      let _ = eat_kw(p, "NOT")
      let _ = eat_kw(p, "EXISTS")
      true
    } else { false }
    let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    return Ok(Statement::CreateSchema(name))
  }

  if eat_kw(p, "SEQUENCE") {
    let _ = if eat_kw(p, "IF") {
      let _ = eat_kw(p, "NOT")
      let _ = eat_kw(p, "EXISTS")
      true
    } else { false }
    let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    return Ok(Statement::CreateSequence(name))
  }

  if eat_kw(p, "TABLE") {
    let mut if_not_exists = false
    if eat_kw(p, "IF") {
      match expect_kw(p, "NOT") { Ok(_) => () Err(e) => return Err(e) }
      match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
      if_not_exists = true
    }
    let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    if eat_kw(p, "AS") {
      let q = match parse_query(p) { Ok(v) => v Err(e) => return Err(e) }
      return Ok(Statement::CreateTableAs(temporary, if_not_exists, name, q))
    }
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    if eat_kw(p, "LIKE") {
      let src_tbl = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
      return Ok(Statement::CreateTableLike(temporary, if_not_exists, name, src_tbl))
    }
    let columns : Array[ColumnDef] = []
    let constraints : Array[TableConstraint] = []
    if !eat_rparen(p) {
      while true {
        if peek_kw(p, "CONSTRAINT") || peek_kw(p, "PRIMARY") || peek_kw(p, "UNIQUE") || peek_kw(p, "CHECK") || peek_kw(p, "FOREIGN") {
          match parse_table_constraint(p) {
            Ok(tc) => constraints.push(tc)
            Err(e) => return Err(e)
          }
        } else {
          match parse_column_def(p) {
            Ok(cd) => columns.push(cd)
            Err(e) => return Err(e)
          }
        }
        if !eat_comma(p) { break }
      }
      match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    }
    let mut without_rowid = false
    while true {
      if eat_kw(p, "WITHOUT") {
        match expect_kw(p, "ROWID") { Ok(_) => () Err(e) => return Err(e) }
        without_rowid = true
      } else if eat_kw(p, "STRICT") {
        ()
      } else {
        break
      }
      let _ = eat_comma(p)
    }
    return Ok(
      Statement::CreateTable(
        CreateTableStmt::{
          temporary: temporary,
          if_not_exists: if_not_exists,
          name: name,
          columns: columns,
          constraints: constraints,
          without_rowid: without_rowid,
        },
      ),
    )
  }

  if eat_kw(p, "INDEX") {
    let concurrently = eat_kw(p, "CONCURRENTLY")
    let mut if_not_exists = false
    if eat_kw(p, "IF") {
      match expect_kw(p, "NOT") { Ok(_) => () Err(e) => return Err(e) }
      match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
      if_not_exists = true
    }
    let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    match expect_kw(p, "ON") { Ok(_) => () Err(e) => return Err(e) }
    let table_name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    let using_method : Option[Ident] = if eat_kw(p, "USING") {
      match parse_ident(p) { Ok(m) => Some(m) Err(e) => return Err(e) }
    } else {
      None
    }
    match expect_lparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let cols : Array[OrderByExpr] = []
    match parse_order_by_list(p, cols) { Ok(_) => () Err(e) => return Err(e) }
    match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
    let predicate : Option[Expr] = if eat_kw(p, "WHERE") {
      match parse_expr(p) { Ok(e) => Some(e) Err(e) => return Err(e) }
    } else {
      None
    }
    let ci = CreateIndexStmt::{
      unique: unique,
      if_not_exists: if_not_exists,
      name: name,
      table_name: table_name,
      columns: cols,
      predicate: predicate,
    }
    if concurrently || match using_method { Some(_) => true None => false } {
      return Ok(Statement::CreateIndexExt(ci, concurrently, using_method))
    }
    return Ok(Statement::CreateIndex(ci))
  }

  if eat_kw(p, "VIEW") {
    let mut if_not_exists = false
    if eat_kw(p, "IF") {
      match expect_kw(p, "NOT") { Ok(_) => () Err(e) => return Err(e) }
      match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
      if_not_exists = true
    }
    let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
    let cols : Array[Ident] = match peek(p).kind {
      TokenKind::LParen =>
      match parse_ident_paren_list(p) { Ok(c) => c Err(e) => return Err(e) }
      _ => []
    }
    match expect_kw(p, "AS") { Ok(_) => () Err(e) => return Err(e) }
    let q = match parse_query(p) { Ok(v) => v Err(e) => return Err(e) }
    return Ok(
      Statement::CreateView(
        CreateViewStmt::{
          temporary: temporary,
          or_replace: or_replace,
          if_not_exists: if_not_exists,
          name: name,
          columns: cols,
          query: q,
        },
      ),
    )
  }

  Err(err_here(p, "expected TABLE, INDEX, or VIEW after CREATE"))
}

fn parse_alter(p : Parser) -> Result[Statement, SqlError] {
  match expect_kw(p, "ALTER") { Ok(_) => () Err(e) => return Err(e) }
  match expect_kw(p, "TABLE") { Ok(_) => () Err(e) => return Err(e) }
  let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
  let ops : Array[AlterTableOp] = []
  while true {
    if eat_kw(p, "ADD") {
      if peek_kw(p, "CONSTRAINT") || peek_kw(p, "PRIMARY") || peek_kw(p, "UNIQUE") || peek_kw(p, "CHECK") || peek_kw(p, "FOREIGN") {
        match parse_table_constraint(p) {
          Ok(tc) => ops.push(AlterTableOp::AddConstraint(tc))
          Err(e) => return Err(e)
        }
      } else {
        let _ = eat_kw(p, "COLUMN")
        match parse_column_def(p) {
          Ok(cd) => ops.push(AlterTableOp::AddColumn(cd))
          Err(e) => return Err(e)
        }
      }
    } else if eat_kw(p, "DROP") {
      if eat_kw(p, "CONSTRAINT") {
        let mut if_ex = false
        if eat_kw(p, "IF") {
          match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
          if_ex = true
        }
        let cname = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        let cascade = eat_kw(p, "CASCADE")
        let _ = if !cascade { eat_kw(p, "RESTRICT") } else { false }
        ops.push(AlterTableOp::DropConstraint(cname, if_ex, cascade))
      } else {
        let _ = eat_kw(p, "COLUMN")
        let mut if_ex = false
        if eat_kw(p, "IF") {
          match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
          if_ex = true
        }
        let col = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        let cascade = eat_kw(p, "CASCADE")
        let _ = if !cascade { eat_kw(p, "RESTRICT") } else { false }
        ops.push(AlterTableOp::DropColumn(col, if_ex, cascade))
      }
    } else if eat_kw(p, "ALTER") {
      let _ = eat_kw(p, "COLUMN")
      let col = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
      if eat_kw(p, "SET") {
        // SET DATA TYPE dt
        let _ = parse_ident(p)
        match expect_kw(p, "TYPE") { Ok(_) => () Err(e) => return Err(e) }
        let dt = match parse_data_type(p) { Ok(d) => d Err(e) => return Err(e) }
        ops.push(AlterTableOp::AlterColumnType(col, dt))
      } else if eat_kw(p, "TYPE") {
        let dt = match parse_data_type(p) { Ok(d) => d Err(e) => return Err(e) }
        ops.push(AlterTableOp::AlterColumnType(col, dt))
      } else {
        return Err(err_here(p, "expected TYPE after ALTER COLUMN"))
      }
    } else if eat_kw(p, "RENAME") {
      if eat_kw(p, "COLUMN") {
        let old_c = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        match expect_kw(p, "TO") { Ok(_) => () Err(e) => return Err(e) }
        let new_c = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        ops.push(AlterTableOp::RenameColumn(old_c, new_c))
      } else if eat_kw(p, "TO") {
        let new_t = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
        ops.push(AlterTableOp::RenameTable(new_t))
      } else {
        let old_c = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        match expect_kw(p, "TO") { Ok(_) => () Err(e) => return Err(e) }
        let new_c = match parse_ident(p) { Ok(c) => c Err(e) => return Err(e) }
        ops.push(AlterTableOp::RenameColumn(old_c, new_c))
      }
    } else {
      return Err(err_here(p, "expected ADD, DROP, or RENAME in ALTER TABLE"))
    }
    if !eat_comma(p) { break }
  }
  Ok(Statement::AlterTable(AlterTableStmt::{ name: name, operations: ops }))
}

fn parse_drop(p : Parser) -> Result[Statement, SqlError] {
  match expect_kw(p, "DROP") { Ok(_) => () Err(e) => return Err(e) }
  let obj_type = if eat_kw(p, "TABLE") {
    ObjectType::Table
  } else if eat_kw(p, "INDEX") {
    ObjectType::Index
  } else if eat_kw(p, "VIEW") {
    ObjectType::View
  } else {
    return Err(err_here(p, "expected TABLE, INDEX, or VIEW after DROP"))
  }
  let mut if_exists = false
  if eat_kw(p, "IF") {
    match expect_kw(p, "EXISTS") { Ok(_) => () Err(e) => return Err(e) }
    if_exists = true
  }
  let names : Array[ObjectName] = []
  while true {
    match parse_object_name(p) {
      Ok(n) => names.push(n)
      Err(e) => return Err(e)
    }
    if !eat_comma(p) { break }
  }
  let cascade = eat_kw(p, "CASCADE")
  let _ = if !cascade { eat_kw(p, "RESTRICT") } else { false }
  Ok(
    Statement::Drop(
      DropStmt::{
        object_type: obj_type,
        if_exists: if_exists,
        names: names,
        cascade: cascade,
      },
    ),
  )
}

// ============================================================================
// TCL & Top-Level Statement Dispatch
// ============================================================================

fn parse_statement(p : Parser) -> Result[Statement, SqlError] {
  match enter_depth(p) { Ok(_) => () Err(e) => return Err(e) }
  let res = parse_statement_inner(p)
  leave_depth(p)
  res
}

fn parse_query_stmt(p : Parser) -> Result[Statement, SqlError] {
  let q = match parse_query(p) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if eat_kw(p, "FOR") {
    let sb = StringBuilder::new()
    sb.write_string("FOR ")
    if eat_kw(p, "UPDATE") {
      sb.write_string("UPDATE")
    } else if eat_kw(p, "SHARE") {
      sb.write_string("SHARE")
    } else if eat_kw(p, "NO") {
      match expect_kw(p, "KEY") { Ok(_) => () Err(e) => return Err(e) }
      match expect_kw(p, "UPDATE") { Ok(_) => () Err(e) => return Err(e) }
      sb.write_string("NO KEY UPDATE")
    } else if eat_kw(p, "KEY") {
      match expect_kw(p, "SHARE") { Ok(_) => () Err(e) => return Err(e) }
      sb.write_string("KEY SHARE")
    } else {
      return Err(err_here(p, "expected UPDATE or SHARE after FOR"))
    }
    if eat_kw(p, "NOWAIT") {
      sb.write_string(" NOWAIT")
    } else if eat_kw(p, "SKIP") {
      match expect_kw(p, "LOCKED") { Ok(_) => () Err(e) => return Err(e) }
      sb.write_string(" SKIP LOCKED")
    }
    return Ok(Statement::QueryLocked(q, sb.to_string()))
  }
  Ok(Statement::Query(q))
}

fn parse_statement_inner(p : Parser) -> Result[Statement, SqlError] {
  let tok = peek(p)
  match tok.kind {
    TokenKind::Keyword(k) => {
      if k == "SELECT" || k == "WITH" || k == "VALUES" || k == "TABLE" {
        parse_query_stmt(p)
      } else if k == "INSERT" || k == "REPLACE" {
        parse_insert(p)
      } else if k == "UPDATE" {
        parse_update(p)
      } else if k == "DELETE" {
        parse_delete(p)
      } else if k == "CREATE" {
        parse_create(p)
      } else if k == "ALTER" {
        parse_alter(p)
      } else if k == "DROP" {
        parse_drop(p)
      } else if k == "TRUNCATE" {
        let _ = advance(p)
        let _ = eat_kw(p, "TABLE")
        let names : Array[ObjectName] = []
        while true {
          match parse_object_name(p) { Ok(n) => names.push(n) Err(e) => return Err(e) }
          if !eat_comma(p) { break }
        }
        let cascade = eat_kw(p, "CASCADE")
        let _ = if !cascade { eat_kw(p, "RESTRICT") } else { false }
        Ok(Statement::Truncate(names, cascade))
      } else if k == "BEGIN" || k == "START" {
        let _ = advance(p)
        let _ = eat_kw(p, "TRANSACTION") || eat_kw(p, "WORK")
        let mode : Option[String] = if eat_kw(p, "DEFERRED") {
          Some("DEFERRED")
        } else if eat_kw(p, "IMMEDIATE") {
          Some("IMMEDIATE")
        } else if eat_kw(p, "EXCLUSIVE") {
          Some("EXCLUSIVE")
        } else if eat_kw(p, "ISOLATION") {
          match expect_kw(p, "LEVEL") { Ok(_) => () Err(e) => return Err(e) }
          let lvl = match parse_ident(p) { Ok(id) => id.value Err(e) => return Err(e) }
          let sb = StringBuilder::new()
          sb.write_string("ISOLATION LEVEL ")
          sb.write_string(lvl)
          match peek(p).kind {
            TokenKind::Ident(s2, QuoteStyle::None) => {
              let _ = advance(p)
              sb.write_byte((32).to_byte())
              sb.write_string(s2)
            }
            _ => ()
          }
          Some(sb.to_string())
        } else if eat_kw(p, "READ") {
          if eat_kw(p, "ONLY") { Some("READ ONLY") }
          else if eat_kw(p, "WRITE") { Some("READ WRITE") }
          else { Some("READ") }
        } else {
          None
        }
        let _ = eat_kw(p, "TRANSACTION") || eat_kw(p, "WORK")
        Ok(Statement::Begin(mode))
      } else if k == "COMMIT" {
        let _ = advance(p)
        let _ = eat_kw(p, "TRANSACTION") || eat_kw(p, "WORK")
        Ok(Statement::Commit)
      } else if k == "ROLLBACK" {
        let _ = advance(p)
        let _ = eat_kw(p, "TRANSACTION") || eat_kw(p, "WORK")
        if eat_kw(p, "TO") {
          let _ = eat_kw(p, "SAVEPOINT")
          match parse_ident(p) {
            Ok(id) => Ok(Statement::Rollback(Some(id)))
            Err(e) => Err(e)
          }
        } else {
          Ok(Statement::Rollback(None))
        }
      } else if k == "SAVEPOINT" {
        let _ = advance(p)
        match parse_ident(p) {
          Ok(id) => Ok(Statement::Savepoint(id))
          Err(e) => Err(e)
        }
      } else if k == "RELEASE" {
        let _ = advance(p)
        let _ = eat_kw(p, "SAVEPOINT")
        match parse_ident(p) {
          Ok(id) => Ok(Statement::ReleaseSavepoint(id))
          Err(e) => Err(e)
        }
      } else if k == "EXPLAIN" {
        let _ = advance(p)
        if eat_lparen(p) {
          let opts : Array[String] = []
          if !eat_rparen(p) {
            while true {
              let opt = match parse_ident(p) { Ok(id) => id Err(e) => return Err(e) }
              let sb = StringBuilder::new()
              sb.write_string(opt.value)
              match peek(p).kind {
                TokenKind::Comma | TokenKind::RParen => ()
                _ => {
                  let vtok = advance(p)
                  sb.write_byte((32).to_byte())
                  sb.write_string(tok_raw(p, vtok))
                }
              }
              opts.push(sb.to_string())
              if !eat_comma(p) { break }
            }
            match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          }
          match parse_statement(p) {
            Ok(inner) => Ok(Statement::ExplainOptions(opts, inner))
            Err(e) => Err(e)
          }
        } else {
          let analyze = eat_kw(p, "ANALYZE")
          match parse_statement(p) {
            Ok(inner) => Ok(Statement::Explain(analyze, inner))
            Err(e) => Err(e)
          }
        }
      } else if k == "SET" {
        let _ = advance(p)
        let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
        match peek(p).kind {
          TokenKind::Eq => { let _ = advance(p) }
          _ => match expect_kw(p, "TO") { Ok(_) => () Err(e) => return Err(e) }
        }
        let av = match parse_expr(p) { Ok(v) => v Err(e) => return Err(e) }
        Ok(Statement::SetVar(name, av))
      } else if k == "SHOW" {
        let _ = advance(p)
        let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
        Ok(Statement::ShowVar(name))
      } else if k == "ANALYZE" {
        let _ = advance(p)
        let tbl : Option[ObjectName] = match peek(p).kind {
          TokenKind::Eof | TokenKind::Semicolon => None
          _ =>
          match parse_object_name(p) {
            Ok(n) => Some(n)
            Err(e) => return Err(e)
          }
        }
        Ok(Statement::Analyze(tbl))
      } else if k == "PRAGMA" {
        let _ = advance(p)
        let name = match parse_object_name(p) { Ok(n) => n Err(e) => return Err(e) }
        let arg : Option[Expr] = if eat_lparen(p) {
          let e = match parse_expr(p) { Ok(v) => v Err(e) => return Err(e) }
          match expect_rparen(p) { Ok(_) => () Err(e) => return Err(e) }
          Some(e)
        } else {
          match peek(p).kind {
            TokenKind::Eq => {
              let _ = advance(p)
              match parse_expr(p) { Ok(v) => Some(v) Err(e) => return Err(e) }
            }
            _ => None
          }
        }
        Ok(Statement::Pragma(name, arg))
      } else if k == "VACUUM" {
        let _ = advance(p)
        Ok(Statement::Vacuum)
      } else {
        Err(err_here(p, "unexpected keyword at start of statement: " + k))
      }
    }
    TokenKind::LParen => parse_query_stmt(p)
    _ => Err(err_here(p, "unexpected token at start of statement"))
  }
}

fn parse_statements_impl(src : String, opts : ParseOptions) -> Result[Array[Statement], SqlError] {
  let tokens = match tokenize_impl(src, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let p = Parser::new(src, tokens, opts)
  let stmts : Array[Statement] = []
  while !is_eof(p) {
    // Skip empty semicolons
    let mut skipped = false
    while true {
      match peek(p).kind {
        TokenKind::Semicolon => { let _ = advance(p); skipped = true }
        _ => break
      }
    }
    if is_eof(p) {
      break
    }
    let _ = skipped
    match parse_statement(p) {
      Ok(st) => stmts.push(st)
      Err(e) => return Err(e)
    }
    match peek(p).kind {
      TokenKind::Semicolon => { let _ = advance(p) }
      TokenKind::Eof => break
      _ => return Err(err_here(p, "expected ';' or end of input after statement"))
    }
  }
  Ok(stmts)
}
