///| Static analysis utilities (`extract_tables`, `extract_placeholders`) and structural AST equality (`stmt_eq`).

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    let b = s.code_unit_at(j)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

///| Normalize an identifier according to SQL case-folding rules:
///| unquoted identifiers fold ASCII A-Z to lowercase; quoted identifiers preserve exact case.
fn normalize_ident(id : Ident) -> String {
  match id.quote_style {
    QuoteStyle::None => ascii_lower(id.value)
    _ => id.value
  }
}

fn part_needs_disambig_quote(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 46 || b == 34 {
      return true
    }
    i = i + 1
  }
  false
}

fn object_name_to_string(name : ObjectName) -> String {
  if name.parts.length() == 1 {
    let norm = normalize_ident(name.parts[0])
    if part_needs_disambig_quote(norm) {
      let sb = StringBuilder::new()
      write_double_quoted_ident(sb, norm)
      return sb.to_string()
    }
    return norm
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < name.parts.length() {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    let norm = normalize_ident(name.parts[i])
    if part_needs_disambig_quote(norm) {
      write_double_quoted_ident(sb, norm)
    } else {
      sb.write_string(norm)
    }
    i = i + 1
  }
  sb.to_string()
}

// ============================================================================
// O(1) FNV-1a Open-Addressed Hash Tables for O(N) `extract_tables`
// ============================================================================

fn hash_str(s : String) -> Int {
  let mut h = 2166136261
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ s.code_unit_at(i)) * 16777619
    i = i + 1
  }
  h & 0x7FFFFFFF
}

struct StrSet {
  mut keys : Array[String]
  mut used : Array[Bool]
  mut len : Int
}

fn StrSet::new() -> StrSet {
  let cap = 16
  let keys : Array[String] = []
  let used : Array[Bool] = []
  let mut i = 0
  while i < cap {
    keys.push("")
    used.push(false)
    i = i + 1
  }
  StrSet::{ keys: keys, used: used, len: 0 }
}

fn str_set_grow(set : StrSet) -> Unit {
  let old_keys = set.keys
  let old_used = set.used
  let new_cap = old_keys.length() * 2
  let new_keys : Array[String] = []
  let new_used : Array[Bool] = []
  let mut i = 0
  while i < new_cap {
    new_keys.push("")
    new_used.push(false)
    i = i + 1
  }
  let mask = new_cap - 1
  let mut j = 0
  while j < old_keys.length() {
    if old_used[j] {
      let k = old_keys[j]
      let mut idx = hash_str(k) & mask
      while new_used[idx] {
        idx = (idx + 1) & mask
      }
      new_keys[idx] = k
      new_used[idx] = true
    }
    j = j + 1
  }
  set.keys = new_keys
  set.used = new_used
}

///| Insert `s` into `set`. Returns `true` if newly inserted, `false` if already present.
fn str_set_insert(set : StrSet, s : String) -> Bool {
  if (set.len + 1) * 10 >= set.keys.length() * 7 {
    str_set_grow(set)
  }
  let mask = set.keys.length() - 1
  let mut idx = hash_str(s) & mask
  while set.used[idx] {
    if set.keys[idx] == s {
      return false
    }
    idx = (idx + 1) & mask
  }
  set.keys[idx] = s
  set.used[idx] = true
  set.len = set.len + 1
  true
}

struct StrCountMap {
  mut keys : Array[String]
  mut counts : Array[Int]
  mut used : Array[Bool]
  mut len : Int
}

fn StrCountMap::new() -> StrCountMap {
  let cap = 16
  let keys : Array[String] = []
  let counts : Array[Int] = []
  let used : Array[Bool] = []
  let mut i = 0
  while i < cap {
    keys.push("")
    counts.push(0)
    used.push(false)
    i = i + 1
  }
  StrCountMap::{ keys: keys, counts: counts, used: used, len: 0 }
}

fn str_cmap_grow(m : StrCountMap) -> Unit {
  let old_keys = m.keys
  let old_counts = m.counts
  let old_used = m.used
  let new_cap = old_keys.length() * 2
  let new_keys : Array[String] = []
  let new_counts : Array[Int] = []
  let new_used : Array[Bool] = []
  let mut i = 0
  while i < new_cap {
    new_keys.push("")
    new_counts.push(0)
    new_used.push(false)
    i = i + 1
  }
  let mask = new_cap - 1
  let mut j = 0
  while j < old_keys.length() {
    if old_used[j] && old_counts[j] > 0 {
      let k = old_keys[j]
      let mut idx = hash_str(k) & mask
      while new_used[idx] {
        idx = (idx + 1) & mask
      }
      new_keys[idx] = k
      new_counts[idx] = old_counts[j]
      new_used[idx] = true
    }
    j = j + 1
  }
  m.keys = new_keys
  m.counts = new_counts
  m.used = new_used
}

fn str_cmap_inc(m : StrCountMap, s : String) -> Unit {
  if (m.len + 1) * 10 >= m.keys.length() * 7 {
    str_cmap_grow(m)
  }
  let mask = m.keys.length() - 1
  let mut idx = hash_str(s) & mask
  while m.used[idx] {
    if m.keys[idx] == s {
      m.counts[idx] = m.counts[idx] + 1
      return
    }
    idx = (idx + 1) & mask
  }
  m.keys[idx] = s
  m.counts[idx] = 1
  m.used[idx] = true
  m.len = m.len + 1
}

fn str_cmap_dec(m : StrCountMap, s : String) -> Unit {
  let mask = m.keys.length() - 1
  let mut idx = hash_str(s) & mask
  while m.used[idx] {
    if m.keys[idx] == s {
      if m.counts[idx] > 0 {
        m.counts[idx] = m.counts[idx] - 1
      }
      return
    }
    idx = (idx + 1) & mask
  }
}

fn str_cmap_has(m : StrCountMap, s : String) -> Bool {
  if m.len == 0 {
    return false
  }
  let mask = m.keys.length() - 1
  let mut idx = hash_str(s) & mask
  while m.used[idx] {
    if m.keys[idx] == s {
      return m.counts[idx] > 0
    }
    idx = (idx + 1) & mask
  }
  false
}

struct TableCollector {
  out : Array[String]
  seen : StrSet
  ctes : StrCountMap
  cte_stack : Array[String]
}

fn TableCollector::new() -> TableCollector {
  TableCollector::{
    out: [],
    seen: StrSet::new(),
    ctes: StrCountMap::new(),
    cte_stack: [],
  }
}

fn push_unique_table(tc : TableCollector, name : ObjectName) -> Unit {
  if name.parts.length() == 1 {
    let norm = normalize_ident(name.parts[0])
    if str_cmap_has(tc.ctes, norm) {
      return
    }
  }
  let s = object_name_to_string(name)
  if str_set_insert(tc.seen, s) {
    tc.out.push(s)
  }
}

fn collect_tables_window_spec(tc : TableCollector, ws : WindowSpec) -> Unit {
  let mut j = 0
  while j < ws.partition_by.length() {
    collect_tables_expr(tc, ws.partition_by[j])
    j = j + 1
  }
  let mut k = 0
  while k < ws.order_by.length() {
    collect_tables_expr(tc, ws.order_by[k].expr)
    k = k + 1
  }
  match ws.window_frame {
    Some(wf) => {
      match wf.start_bound {
        WindowFrameBound::Preceding(Some(e)) | WindowFrameBound::Following(Some(e)) =>
        collect_tables_expr(tc, e)
        _ => ()
      }
      match wf.end_bound {
        Some(WindowFrameBound::Preceding(Some(e))) | Some(WindowFrameBound::Following(Some(e))) =>
        collect_tables_expr(tc, e)
        _ => ()
      }
    }
    None => ()
  }
}

fn collect_tables_expr(tc : TableCollector, expr : Expr) -> Unit {
  match expr {
    Expr::UnaryOp(_, e) | Expr::PrefixOp(_, e) | Expr::IsNull(e) | Expr::IsNotNull(e) | Expr::IsTrue(e) | Expr::IsNotTrue(e) | Expr::IsFalse(e) | Expr::IsNotFalse(e) | Expr::Cast(e, _, _) | Expr::Extract(_, e) | Expr::Nested(e) | Expr::Collate(e, _) =>
    collect_tables_expr(tc, e)
    Expr::BinaryOp(l, _, r) | Expr::AnyAllOp(l, _, _, r) | Expr::IsDistinctFrom(l, r) | Expr::IsNotDistinctFrom(l, r) | Expr::Subscript(l, r) | Expr::Like(l, _, _, r, _) | Expr::SimilarTo(l, _, r, _) | Expr::PatternOp(l, _, _, r) | Expr::Position(l, r) => {
      collect_tables_expr(tc, l)
      collect_tables_expr(tc, r)
    }
    Expr::Substring(e, fe, fo) => {
      collect_tables_expr(tc, e)
      match fe { Some(x) => collect_tables_expr(tc, x) None => () }
      match fo { Some(x) => collect_tables_expr(tc, x) None => () }
    }
    Expr::Trim(_, ch, e) => {
      match ch { Some(x) => collect_tables_expr(tc, x) None => () }
      collect_tables_expr(tc, e)
    }
    Expr::Slice(base, lo, hi) => {
      collect_tables_expr(tc, base)
      match lo { Some(x) => collect_tables_expr(tc, x) None => () }
      match hi { Some(x) => collect_tables_expr(tc, x) None => () }
    }
    Expr::Between(e, _, lo, hi) => {
      collect_tables_expr(tc, e)
      collect_tables_expr(tc, lo)
      collect_tables_expr(tc, hi)
    }
    Expr::InList(e, list, _) => {
      collect_tables_expr(tc, e)
      let mut i = 0
      while i < list.length() {
        collect_tables_expr(tc, list[i])
        i = i + 1
      }
    }
    Expr::InSubquery(e, q, _) => {
      collect_tables_expr(tc, e)
      collect_tables_query(tc, q)
    }
    Expr::Tuple(items) | Expr::Array(items) | Expr::GroupingSet(_, items) => {
      let mut i = 0
      while i < items.length() {
        collect_tables_expr(tc, items[i])
        i = i + 1
      }
    }
    Expr::Function(fc) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_tables_expr(tc, fc.args[i])
        i = i + 1
      }
      match fc.filter {
        Some(f) => collect_tables_expr(tc, f)
        None => ()
      }
      match fc.over {
        Some(ws) => collect_tables_window_spec(tc, ws)
        None => ()
      }
    }
    Expr::AggregateCall(fc, arg_ord, wg, _) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_tables_expr(tc, fc.args[i])
        i = i + 1
      }
      let mut j = 0
      while j < arg_ord.length() {
        collect_tables_expr(tc, arg_ord[j].expr)
        j = j + 1
      }
      let mut k = 0
      while k < wg.length() {
        collect_tables_expr(tc, wg[k].expr)
        k = k + 1
      }
      match fc.filter {
        Some(f) => collect_tables_expr(tc, f)
        None => ()
      }
      match fc.over {
        Some(ws) => collect_tables_window_spec(tc, ws)
        None => ()
      }
    }
    Expr::Case(op, branches, er) => {
      match op {
        Some(e) => collect_tables_expr(tc, e)
        None => ()
      }
      let mut i = 0
      while i < branches.length() {
        let (c, r) = branches[i]
        collect_tables_expr(tc, c)
        collect_tables_expr(tc, r)
        i = i + 1
      }
      match er {
        Some(e) => collect_tables_expr(tc, e)
        None => ()
      }
    }
    Expr::Subquery(q) | Expr::Exists(q, _) | Expr::ArraySubquery(q) => collect_tables_query(tc, q)
    _ => ()
  }
}

fn collect_tables_select_item(tc : TableCollector, item : SelectItem) -> Unit {
  match item {
    SelectItem::UnnamedExpr(e) | SelectItem::ExprWithAlias(e, _) => collect_tables_expr(tc, e)
    _ => ()
  }
}

fn collect_tables_select_items(tc : TableCollector, items : Array[SelectItem]) -> Unit {
  let mut i = 0
  while i < items.length() {
    collect_tables_select_item(tc, items[i])
    i = i + 1
  }
}

fn collect_tables_factor(tc : TableCollector, tf : TableFactor) -> Unit {
  match tf {
    TableFactor::Table(name, _) => push_unique_table(tc, name)
    TableFactor::Derived(_, q, _) => collect_tables_query(tc, q)
    TableFactor::NestedJoin(twj) => collect_tables_twj(tc, twj)
    TableFactor::TableFunction(_, args, _) => {
      let mut i = 0
      while i < args.length() {
        collect_tables_expr(tc, args[i])
        i = i + 1
      }
    }
  }
}

fn collect_tables_twj(tc : TableCollector, twj : TableWithJoins) -> Unit {
  collect_tables_factor(tc, twj.relation)
  let mut i = 0
  while i < twj.joins.length() {
    let j = twj.joins[i]
    collect_tables_factor(tc, j.relation)
    match j.join_operator {
      JoinOperator::Inner(JoinConstraint::On(e)) | JoinOperator::LeftOuter(JoinConstraint::On(e)) | JoinOperator::RightOuter(JoinConstraint::On(e)) | JoinOperator::FullOuter(JoinConstraint::On(e)) =>
      collect_tables_expr(tc, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_tables_select(tc : TableCollector, sel : Select) -> Unit {
  match sel.distinct {
    DistinctKind::DistinctOn(exprs) => {
      let mut d = 0
      while d < exprs.length() {
        collect_tables_expr(tc, exprs[d])
        d = d + 1
      }
    }
    _ => ()
  }
  collect_tables_select_items(tc, sel.projection)
  let mut j = 0
  while j < sel.from.length() {
    collect_tables_twj(tc, sel.from[j])
    j = j + 1
  }
  match sel.selection {
    Some(w) => collect_tables_expr(tc, w)
    None => ()
  }
  let mut k = 0
  while k < sel.group_by.length() {
    collect_tables_expr(tc, sel.group_by[k])
    k = k + 1
  }
  match sel.having {
    Some(h) => collect_tables_expr(tc, h)
    None => ()
  }
}

fn collect_tables_set_expr(tc : TableCollector, body : SetExpr) -> Unit {
  match body {
    SetExpr::Select(sel) => collect_tables_select(tc, sel)
    SetExpr::SelectWithWindows(sel, wins) => {
      collect_tables_select(tc, sel)
      let mut i = 0
      while i < wins.length() {
        let (_, ws) = wins[i]
        collect_tables_window_spec(tc, ws)
        i = i + 1
      }
    }
    SetExpr::Query(q) => collect_tables_query(tc, q)
    SetExpr::SetOperation(_, _, l, r) => {
      collect_tables_set_expr(tc, l)
      collect_tables_set_expr(tc, r)
    }
    SetExpr::Values(rows) => {
      let mut i = 0
      while i < rows.length() {
        let row = rows[i]
        let mut j = 0
        while j < row.length() {
          collect_tables_expr(tc, row[j])
          j = j + 1
        }
        i = i + 1
      }
    }
    SetExpr::DefaultValues => ()
    SetExpr::TableRef(name) => push_unique_table(tc, name)
  }
}

fn collect_tables_query(tc : TableCollector, q : Query) -> Unit {
  let prev_cte_len = tc.cte_stack.length()
  match q.with_clause {
    Some(w) => {
      let mut i = 0
      while i < w.cte_tables.length() {
        let cte = w.cte_tables[i]
        let cte_key = normalize_ident(cte.alias)
        if w.recursive {
          str_cmap_inc(tc.ctes, cte_key)
          tc.cte_stack.push(cte_key)
        }
        collect_tables_query(tc, cte.query)
        if !w.recursive {
          str_cmap_inc(tc.ctes, cte_key)
          tc.cte_stack.push(cte_key)
        }
        i = i + 1
      }
    }
    None => ()
  }
  collect_tables_set_expr(tc, q.body)
  let mut i = 0
  while i < q.order_by.length() {
    collect_tables_expr(tc, q.order_by[i].expr)
    i = i + 1
  }
  match q.limit {
    Some(e) => collect_tables_expr(tc, e)
    None => ()
  }
  match q.offset {
    Some(e) => collect_tables_expr(tc, e)
    None => ()
  }
  while tc.cte_stack.length() > prev_cte_len {
    match tc.cte_stack.pop() {
      Some(k) => str_cmap_dec(tc.ctes, k)
      None => break
    }
  }
}

fn collect_tables_col_constraint(tc : TableCollector, cc : ColumnConstraint) -> Unit {
  match cc {
    ColumnConstraint::References(rt, _, _, _) => push_unique_table(tc, rt)
    ColumnConstraint::Default(e) | ColumnConstraint::Check(e) => collect_tables_expr(tc, e)
    ColumnConstraint::Named(_, inner) => collect_tables_col_constraint(tc, inner)
    ColumnConstraint::Generated(Some(e), _, _) => collect_tables_expr(tc, e)
    _ => ()
  }
}

fn collect_tables_table_constraint(tc : TableCollector, tblc : TableConstraint) -> Unit {
  match tblc {
    TableConstraint::ForeignKey(_, _, rt, _, _, _) => push_unique_table(tc, rt)
    TableConstraint::Check(_, e) => collect_tables_expr(tc, e)
    _ => ()
  }
}

fn collect_tables_insert(tc : TableCollector, ins : InsertStmt) -> Unit {
  push_unique_table(tc, ins.table_name)
  collect_tables_query(tc, ins.source)
  match ins.on_conflict {
    Some(oc) =>
    match oc.action {
      OnConflictAction::DoUpdate(assigns, wh) => {
        let mut i = 0
        while i < assigns.length() {
          collect_tables_expr(tc, assigns[i].value)
          i = i + 1
        }
        match wh {
          Some(w) => collect_tables_expr(tc, w)
          None => ()
        }
      }
      OnConflictAction::DoNothing => ()
    }
    None => ()
  }
  collect_tables_select_items(tc, ins.returning)
}

fn collect_tables_stmt(tc : TableCollector, stmt : Statement) -> Unit {
  match stmt {
    Statement::Query(q) | Statement::QueryLocked(q, _) => collect_tables_query(tc, q)
    Statement::Insert(ins) | Statement::InsertOr(_, ins) => collect_tables_insert(tc, ins)
    Statement::Update(upd) => {
      collect_tables_twj(tc, upd.table)
      let mut i = 0
      while i < upd.assignments.length() {
        collect_tables_expr(tc, upd.assignments[i].value)
        i = i + 1
      }
      let mut j = 0
      while j < upd.from.length() {
        collect_tables_twj(tc, upd.from[j])
        j = j + 1
      }
      match upd.selection {
        Some(w) => collect_tables_expr(tc, w)
        None => ()
      }
      collect_tables_select_items(tc, upd.returning)
    }
    Statement::UpdateMulti(tbl, assigns, from, selection, returning) => {
      collect_tables_twj(tc, tbl)
      let mut i = 0
      while i < assigns.length() {
        let (_, av) = assigns[i]
        collect_tables_expr(tc, av)
        i = i + 1
      }
      let mut j = 0
      while j < from.length() {
        collect_tables_twj(tc, from[j])
        j = j + 1
      }
      match selection {
        Some(w) => collect_tables_expr(tc, w)
        None => ()
      }
      collect_tables_select_items(tc, returning)
    }
    Statement::Delete(del) => {
      collect_tables_twj(tc, del.from)
      match del.selection {
        Some(w) => collect_tables_expr(tc, w)
        None => ()
      }
      collect_tables_select_items(tc, del.returning)
    }
    Statement::DeleteUsing(from, using_tbls, selection, returning) => {
      collect_tables_twj(tc, from)
      let mut i = 0
      while i < using_tbls.length() {
        collect_tables_twj(tc, using_tbls[i])
        i = i + 1
      }
      match selection {
        Some(w) => collect_tables_expr(tc, w)
        None => ()
      }
      collect_tables_select_items(tc, returning)
    }
    Statement::CreateTable(ct) => {
      push_unique_table(tc, ct.name)
      let mut i = 0
      while i < ct.columns.length() {
        let mut j = 0
        while j < ct.columns[i].constraints.length() {
          collect_tables_col_constraint(tc, ct.columns[i].constraints[j])
          j = j + 1
        }
        i = i + 1
      }
      let mut k = 0
      while k < ct.constraints.length() {
        collect_tables_table_constraint(tc, ct.constraints[k])
        k = k + 1
      }
    }
    Statement::CreateTableAs(_, _, name, q) => {
      push_unique_table(tc, name)
      collect_tables_query(tc, q)
    }
    Statement::CreateTableLike(_, _, name, src_tbl) => {
      push_unique_table(tc, name)
      push_unique_table(tc, src_tbl)
    }
    Statement::CreateIndex(ci) | Statement::CreateIndexExt(ci, _, _) => {
      push_unique_table(tc, ci.table_name)
      match ci.predicate {
        Some(e) => collect_tables_expr(tc, e)
        None => ()
      }
    }
    Statement::CreateView(cv) => collect_tables_query(tc, cv.query)
    Statement::AlterTable(at) => {
      push_unique_table(tc, at.name)
      let mut i = 0
      while i < at.operations.length() {
        match at.operations[i] {
          AlterTableOp::AddColumn(cd) => {
            let mut j = 0
            while j < cd.constraints.length() {
              collect_tables_col_constraint(tc, cd.constraints[j])
              j = j + 1
            }
          }
          AlterTableOp::AddConstraint(tblc) => collect_tables_table_constraint(tc, tblc)
          _ => ()
        }
        i = i + 1
      }
    }
    Statement::Drop(d) => {
      let mut i = 0
      while i < d.names.length() {
        push_unique_table(tc, d.names[i])
        i = i + 1
      }
    }
    Statement::Truncate(names, _) => {
      let mut i = 0
      while i < names.length() {
        push_unique_table(tc, names[i])
        i = i + 1
      }
    }
    Statement::Analyze(Some(tbl)) => push_unique_table(tc, tbl)
    Statement::Explain(_, inner) | Statement::ExplainOptions(_, inner) => collect_tables_stmt(tc, inner)
    _ => ()
  }
}

fn extract_tables_impl(stmt : Statement) -> Array[String] {
  let tc = TableCollector::new()
  collect_tables_stmt(tc, stmt)
  tc.out
}

// ============================================================================
// Placeholder Extraction
// ============================================================================

fn collect_ph_window_spec(out : Array[String], ws : WindowSpec) -> Unit {
  let mut j = 0
  while j < ws.partition_by.length() {
    collect_ph_expr(out, ws.partition_by[j])
    j = j + 1
  }
  let mut k = 0
  while k < ws.order_by.length() {
    collect_ph_expr(out, ws.order_by[k].expr)
    k = k + 1
  }
  match ws.window_frame {
    Some(wf) => {
      match wf.start_bound {
        WindowFrameBound::Preceding(Some(e)) | WindowFrameBound::Following(Some(e)) =>
        collect_ph_expr(out, e)
        _ => ()
      }
      match wf.end_bound {
        Some(WindowFrameBound::Preceding(Some(e))) | Some(WindowFrameBound::Following(Some(e))) =>
        collect_ph_expr(out, e)
        _ => ()
      }
    }
    None => ()
  }
}

fn collect_ph_expr(out : Array[String], expr : Expr) -> Unit {
  match expr {
    Expr::Placeholder(p) => out.push(p)
    Expr::UnaryOp(_, e) | Expr::PrefixOp(_, e) | Expr::IsNull(e) | Expr::IsNotNull(e) | Expr::IsTrue(e) | Expr::IsNotTrue(e) | Expr::IsFalse(e) | Expr::IsNotFalse(e) | Expr::Cast(e, _, _) | Expr::Extract(_, e) | Expr::Nested(e) | Expr::Collate(e, _) =>
    collect_ph_expr(out, e)
    Expr::BinaryOp(l, _, r) | Expr::AnyAllOp(l, _, _, r) | Expr::IsDistinctFrom(l, r) | Expr::IsNotDistinctFrom(l, r) | Expr::Subscript(l, r) | Expr::Like(l, _, _, r, _) | Expr::SimilarTo(l, _, r, _) | Expr::PatternOp(l, _, _, r) | Expr::Position(l, r) => {
      collect_ph_expr(out, l)
      collect_ph_expr(out, r)
    }
    Expr::Substring(e, fe, fo) => {
      collect_ph_expr(out, e)
      match fe { Some(x) => collect_ph_expr(out, x) None => () }
      match fo { Some(x) => collect_ph_expr(out, x) None => () }
    }
    Expr::Trim(_, ch, e) => {
      match ch { Some(x) => collect_ph_expr(out, x) None => () }
      collect_ph_expr(out, e)
    }
    Expr::Slice(base, lo, hi) => {
      collect_ph_expr(out, base)
      match lo { Some(x) => collect_ph_expr(out, x) None => () }
      match hi { Some(x) => collect_ph_expr(out, x) None => () }
    }
    Expr::Between(e, _, lo, hi) => {
      collect_ph_expr(out, e)
      collect_ph_expr(out, lo)
      collect_ph_expr(out, hi)
    }
    Expr::InList(e, list, _) => {
      collect_ph_expr(out, e)
      let mut i = 0
      while i < list.length() {
        collect_ph_expr(out, list[i])
        i = i + 1
      }
    }
    Expr::InSubquery(e, q, _) => {
      collect_ph_expr(out, e)
      collect_ph_query(out, q)
    }
    Expr::Tuple(items) | Expr::Array(items) | Expr::GroupingSet(_, items) => {
      let mut i = 0
      while i < items.length() {
        collect_ph_expr(out, items[i])
        i = i + 1
      }
    }
    Expr::Function(fc) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_ph_expr(out, fc.args[i])
        i = i + 1
      }
      match fc.filter {
        Some(f) => collect_ph_expr(out, f)
        None => ()
      }
      match fc.over {
        Some(ws) => collect_ph_window_spec(out, ws)
        None => ()
      }
    }
    Expr::AggregateCall(fc, arg_ord, wg, _) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_ph_expr(out, fc.args[i])
        i = i + 1
      }
      let mut j = 0
      while j < arg_ord.length() {
        collect_ph_expr(out, arg_ord[j].expr)
        j = j + 1
      }
      let mut k = 0
      while k < wg.length() {
        collect_ph_expr(out, wg[k].expr)
        k = k + 1
      }
      match fc.filter {
        Some(f) => collect_ph_expr(out, f)
        None => ()
      }
      match fc.over {
        Some(ws) => collect_ph_window_spec(out, ws)
        None => ()
      }
    }
    Expr::Case(op, branches, er) => {
      match op {
        Some(e) => collect_ph_expr(out, e)
        None => ()
      }
      let mut i = 0
      while i < branches.length() {
        let (c, r) = branches[i]
        collect_ph_expr(out, c)
        collect_ph_expr(out, r)
        i = i + 1
      }
      match er {
        Some(e) => collect_ph_expr(out, e)
        None => ()
      }
    }
    Expr::Subquery(q) | Expr::Exists(q, _) | Expr::ArraySubquery(q) => collect_ph_query(out, q)
    _ => ()
  }
}

fn collect_ph_select_items(out : Array[String], items : Array[SelectItem]) -> Unit {
  let mut i = 0
  while i < items.length() {
    match items[i] {
      SelectItem::UnnamedExpr(e) | SelectItem::ExprWithAlias(e, _) => collect_ph_expr(out, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_ph_twj(out : Array[String], twj : TableWithJoins) -> Unit {
  match twj.relation {
    TableFactor::Derived(_, q, _) => collect_ph_query(out, q)
    TableFactor::NestedJoin(inner) => collect_ph_twj(out, inner)
    TableFactor::TableFunction(_, args, _) => {
      let mut a = 0
      while a < args.length() {
        collect_ph_expr(out, args[a])
        a = a + 1
      }
    }
    _ => ()
  }
  let mut i = 0
  while i < twj.joins.length() {
    let j = twj.joins[i]
    match j.relation {
      TableFactor::Derived(_, q, _) => collect_ph_query(out, q)
      TableFactor::NestedJoin(inner) => collect_ph_twj(out, inner)
      TableFactor::TableFunction(_, args, _) => {
        let mut a = 0
        while a < args.length() {
          collect_ph_expr(out, args[a])
          a = a + 1
        }
      }
      _ => ()
    }
    match j.join_operator {
      JoinOperator::Inner(JoinConstraint::On(e)) | JoinOperator::LeftOuter(JoinConstraint::On(e)) | JoinOperator::RightOuter(JoinConstraint::On(e)) | JoinOperator::FullOuter(JoinConstraint::On(e)) =>
      collect_ph_expr(out, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_ph_select(out : Array[String], sel : Select) -> Unit {
  match sel.distinct {
    DistinctKind::DistinctOn(exprs) => {
      let mut d = 0
      while d < exprs.length() {
        collect_ph_expr(out, exprs[d])
        d = d + 1
      }
    }
    _ => ()
  }
  collect_ph_select_items(out, sel.projection)
  let mut i = 0
  while i < sel.from.length() {
    collect_ph_twj(out, sel.from[i])
    i = i + 1
  }
  match sel.selection {
    Some(w) => collect_ph_expr(out, w)
    None => ()
  }
  let mut j = 0
  while j < sel.group_by.length() {
    collect_ph_expr(out, sel.group_by[j])
    j = j + 1
  }
  match sel.having {
    Some(h) => collect_ph_expr(out, h)
    None => ()
  }
}

fn collect_ph_set_expr(out : Array[String], body : SetExpr) -> Unit {
  match body {
    SetExpr::Select(sel) => collect_ph_select(out, sel)
    SetExpr::SelectWithWindows(sel, wins) => {
      collect_ph_select(out, sel)
      let mut i = 0
      while i < wins.length() {
        let (_, ws) = wins[i]
        collect_ph_window_spec(out, ws)
        i = i + 1
      }
    }
    SetExpr::Query(q) => collect_ph_query(out, q)
    SetExpr::SetOperation(_, _, l, r) => {
      collect_ph_set_expr(out, l)
      collect_ph_set_expr(out, r)
    }
    SetExpr::Values(rows) => {
      let mut i = 0
      while i < rows.length() {
        let row = rows[i]
        let mut j = 0
        while j < row.length() {
          collect_ph_expr(out, row[j])
          j = j + 1
        }
        i = i + 1
      }
    }
    SetExpr::DefaultValues | SetExpr::TableRef(_) => ()
  }
}

fn collect_ph_query(out : Array[String], q : Query) -> Unit {
  match q.with_clause {
    Some(w) => {
      let mut i = 0
      while i < w.cte_tables.length() {
        collect_ph_query(out, w.cte_tables[i].query)
        i = i + 1
      }
    }
    None => ()
  }
  collect_ph_set_expr(out, q.body)
  let mut i = 0
  while i < q.order_by.length() {
    collect_ph_expr(out, q.order_by[i].expr)
    i = i + 1
  }
  match q.limit {
    Some(e) => collect_ph_expr(out, e)
    None => ()
  }
  match q.offset {
    Some(e) => collect_ph_expr(out, e)
    None => ()
  }
}

fn collect_ph_insert(out : Array[String], ins : InsertStmt) -> Unit {
  collect_ph_query(out, ins.source)
  match ins.on_conflict {
    Some(oc) =>
    match oc.action {
      OnConflictAction::DoUpdate(assigns, wh) => {
        let mut i = 0
        while i < assigns.length() {
          collect_ph_expr(out, assigns[i].value)
          i = i + 1
        }
        match wh {
          Some(w) => collect_ph_expr(out, w)
          None => ()
        }
      }
      OnConflictAction::DoNothing => ()
    }
    None => ()
  }
  collect_ph_select_items(out, ins.returning)
}

fn collect_ph_stmt(out : Array[String], stmt : Statement) -> Unit {
  match stmt {
    Statement::Query(q) | Statement::QueryLocked(q, _) => collect_ph_query(out, q)
    Statement::Insert(ins) | Statement::InsertOr(_, ins) => collect_ph_insert(out, ins)
    Statement::Update(upd) => {
      let mut i = 0
      while i < upd.assignments.length() {
        collect_ph_expr(out, upd.assignments[i].value)
        i = i + 1
      }
      let mut j = 0
      while j < upd.from.length() {
        collect_ph_twj(out, upd.from[j])
        j = j + 1
      }
      match upd.selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, upd.returning)
    }
    Statement::UpdateMulti(_, assigns, from, selection, returning) => {
      let mut i = 0
      while i < assigns.length() {
        let (_, av) = assigns[i]
        collect_ph_expr(out, av)
        i = i + 1
      }
      let mut j = 0
      while j < from.length() {
        collect_ph_twj(out, from[j])
        j = j + 1
      }
      match selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, returning)
    }
    Statement::Delete(del) => {
      collect_ph_twj(out, del.from)
      match del.selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, del.returning)
    }
    Statement::DeleteUsing(from, using_tbls, selection, returning) => {
      collect_ph_twj(out, from)
      let mut i = 0
      while i < using_tbls.length() {
        collect_ph_twj(out, using_tbls[i])
        i = i + 1
      }
      match selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, returning)
    }
    Statement::SetVar(_, v) => collect_ph_expr(out, v)
    Statement::Explain(_, inner) | Statement::ExplainOptions(_, inner) => collect_ph_stmt(out, inner)
    _ => ()
  }
}

fn extract_placeholders_impl(stmt : Statement) -> Array[String] {
  let out : Array[String] = []
  collect_ph_stmt(out, stmt)
  out
}

// ============================================================================
// True Structural AST Equality (`stmt_eq`)
// ============================================================================

fn quote_style_eq(a : QuoteStyle, b : QuoteStyle) -> Bool {
  match (a, b) {
    (QuoteStyle::None, QuoteStyle::None) => true
    (QuoteStyle::DoubleQuote, QuoteStyle::DoubleQuote) => true
    (QuoteStyle::Backtick, QuoteStyle::Backtick) => true
    (QuoteStyle::Bracket, QuoteStyle::Bracket) => true
    _ => false
  }
}

fn ident_eq(a : Ident, b : Ident) -> Bool {
  a.value == b.value && quote_style_eq(a.quote_style, b.quote_style)
}

fn opt_ident_eq(a : Option[Ident], b : Option[Ident]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => ident_eq(x, y)
    _ => false
  }
}

fn idents_eq(a : Array[Ident], b : Array[Ident]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !ident_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn obj_name_eq(a : ObjectName, b : ObjectName) -> Bool {
  idents_eq(a.parts, b.parts)
}

fn opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_bool_eq(a : Option[Bool], b : Option[Bool]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn data_type_eq(a : DataType, b : DataType) -> Bool {
  match (a, b) {
    (DataType::Int(x), DataType::Int(y)) => opt_int_eq(x, y)
    (DataType::SmallInt, DataType::SmallInt) => true
    (DataType::BigInt, DataType::BigInt) => true
    (DataType::TinyInt, DataType::TinyInt) => true
    (DataType::Real, DataType::Real) => true
    (DataType::Float(x), DataType::Float(y)) => opt_int_eq(x, y)
    (DataType::Double, DataType::Double) => true
    (DataType::Numeric(p1, s1), DataType::Numeric(p2, s2)) => opt_int_eq(p1, p2) && opt_int_eq(s1, s2)
    (DataType::Decimal(p1, s1), DataType::Decimal(p2, s2)) => opt_int_eq(p1, p2) && opt_int_eq(s1, s2)
    (DataType::Boolean, DataType::Boolean) => true
    (DataType::Text, DataType::Text) => true
    (DataType::Varchar(x), DataType::Varchar(y)) => opt_int_eq(x, y)
    (DataType::Char(x), DataType::Char(y)) => opt_int_eq(x, y)
    (DataType::Blob, DataType::Blob) => true
    (DataType::Bytea, DataType::Bytea) => true
    (DataType::Date, DataType::Date) => true
    (DataType::Time, DataType::Time) => true
    (DataType::Timestamp(x), DataType::Timestamp(y)) => x == y
    (DataType::Interval, DataType::Interval) => true
    (DataType::Json, DataType::Json) => true
    (DataType::Jsonb, DataType::Jsonb) => true
    (DataType::Uuid, DataType::Uuid) => true
    (DataType::Serial, DataType::Serial) => true
    (DataType::BigSerial, DataType::BigSerial) => true
    (DataType::Array(x), DataType::Array(y)) => data_type_eq(x, y)
    (DataType::Custom(n1, p1), DataType::Custom(n2, p2)) => {
      if !obj_name_eq(n1, n2) || p1.length() != p2.length() { return false }
      let mut i = 0
      while i < p1.length() {
        if p1[i] != p2[i] { return false }
        i = i + 1
      }
      true
    }
    (DataType::Unspecified, DataType::Unspecified) => true
    _ => false
  }
}

fn unary_op_eq(a : UnaryOperator, b : UnaryOperator) -> Bool {
  match (a, b) {
    (UnaryOperator::Plus, UnaryOperator::Plus) => true
    (UnaryOperator::Minus, UnaryOperator::Minus) => true
    (UnaryOperator::Not, UnaryOperator::Not) => true
    (UnaryOperator::BitwiseNot, UnaryOperator::BitwiseNot) => true
    _ => false
  }
}

fn binary_op_eq(a : BinaryOperator, b : BinaryOperator) -> Bool {
  match (a, b) {
    (BinaryOperator::Or, BinaryOperator::Or) => true
    (BinaryOperator::And, BinaryOperator::And) => true
    (BinaryOperator::Eq, BinaryOperator::Eq) => true
    (BinaryOperator::Neq, BinaryOperator::Neq) => true
    (BinaryOperator::Lt, BinaryOperator::Lt) => true
    (BinaryOperator::Gt, BinaryOperator::Gt) => true
    (BinaryOperator::LtEq, BinaryOperator::LtEq) => true
    (BinaryOperator::GtEq, BinaryOperator::GtEq) => true
    (BinaryOperator::Plus, BinaryOperator::Plus) => true
    (BinaryOperator::Minus, BinaryOperator::Minus) => true
    (BinaryOperator::Mul, BinaryOperator::Mul) => true
    (BinaryOperator::Div, BinaryOperator::Div) => true
    (BinaryOperator::Mod, BinaryOperator::Mod) => true
    (BinaryOperator::Caret, BinaryOperator::Caret) => true
    (BinaryOperator::Concat, BinaryOperator::Concat) => true
    (BinaryOperator::BitwiseAnd, BinaryOperator::BitwiseAnd) => true
    (BinaryOperator::BitwiseOr, BinaryOperator::BitwiseOr) => true
    (BinaryOperator::LShift, BinaryOperator::LShift) => true
    (BinaryOperator::RShift, BinaryOperator::RShift) => true
    (BinaryOperator::Arrow, BinaryOperator::Arrow) => true
    (BinaryOperator::DoubleArrow, BinaryOperator::DoubleArrow) => true
    (BinaryOperator::HashArrow, BinaryOperator::HashArrow) => true
    (BinaryOperator::HashDoubleArrow, BinaryOperator::HashDoubleArrow) => true
    (BinaryOperator::AtGt, BinaryOperator::AtGt) => true
    (BinaryOperator::LtAt, BinaryOperator::LtAt) => true
    (BinaryOperator::RegexMatch, BinaryOperator::RegexMatch) => true
    (BinaryOperator::RegexIMatch, BinaryOperator::RegexIMatch) => true
    (BinaryOperator::RegexNotMatch, BinaryOperator::RegexNotMatch) => true
    (BinaryOperator::RegexNotIMatch, BinaryOperator::RegexNotIMatch) => true
    _ => false
  }
}

fn opt_expr_eq(a : Option[Expr], b : Option[Expr]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => expr_eq(x, y)
    _ => false
  }
}

fn exprs_eq(a : Array[Expr], b : Array[Expr]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !expr_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn order_by_eq(a : OrderByExpr, b : OrderByExpr) -> Bool {
  expr_eq(a.expr, b.expr) && opt_bool_eq(a.asc, b.asc) && opt_bool_eq(a.nulls_first, b.nulls_first)
}

fn order_bys_eq(a : Array[OrderByExpr], b : Array[OrderByExpr]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !order_by_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn window_bound_eq(a : WindowFrameBound, b : WindowFrameBound) -> Bool {
  match (a, b) {
    (WindowFrameBound::CurrentRow, WindowFrameBound::CurrentRow) => true
    (WindowFrameBound::Preceding(x), WindowFrameBound::Preceding(y)) => opt_expr_eq(x, y)
    (WindowFrameBound::Following(x), WindowFrameBound::Following(y)) => opt_expr_eq(x, y)
    _ => false
  }
}

fn window_frame_eq(a : WindowFrame, b : WindowFrame) -> Bool {
  let u_eq = match (a.units, b.units) {
    (WindowFrameUnits::Rows, WindowFrameUnits::Rows) => true
    (WindowFrameUnits::Range, WindowFrameUnits::Range) => true
    (WindowFrameUnits::Groups, WindowFrameUnits::Groups) => true
    _ => false
  }
  if !u_eq || !window_bound_eq(a.start_bound, b.start_bound) { return false }
  match (a.end_bound, b.end_bound) {
    (None, None) => true
    (Some(x), Some(y)) => window_bound_eq(x, y)
    _ => false
  }
}

fn window_spec_eq(a : WindowSpec, b : WindowSpec) -> Bool {
  if !exprs_eq(a.partition_by, b.partition_by) || !order_bys_eq(a.order_by, b.order_by) {
    return false
  }
  match (a.window_frame, b.window_frame) {
    (None, None) => true
    (Some(x), Some(y)) => window_frame_eq(x, y)
    _ => false
  }
}

fn func_call_eq(a : FunctionCall, b : FunctionCall) -> Bool {
  if !obj_name_eq(a.name, b.name) || a.distinct != b.distinct || !exprs_eq(a.args, b.args) || !opt_expr_eq(a.filter, b.filter) {
    return false
  }
  match (a.over, b.over) {
    (None, None) => true
    (Some(x), Some(y)) => window_spec_eq(x, y)
    _ => false
  }
}

fn expr_eq(a : Expr, b : Expr) -> Bool {
  match (a, b) {
    (Expr::Identifier(x), Expr::Identifier(y)) => ident_eq(x, y)
    (Expr::CompoundIdentifier(x), Expr::CompoundIdentifier(y)) => idents_eq(x, y)
    (Expr::Number(x), Expr::Number(y)) => x == y
    (Expr::SingleQuotedString(x), Expr::SingleQuotedString(y)) => x == y
    (Expr::EscapedString(x), Expr::EscapedString(y)) => x == y
    (Expr::DollarQuotedString(t1, b1), Expr::DollarQuotedString(t2, b2)) => t1 == t2 && b1 == b2
    (Expr::HexStringLiteral(x), Expr::HexStringLiteral(y)) => x == y
    (Expr::Boolean(x), Expr::Boolean(y)) => x == y
    (Expr::Null, Expr::Null) => true
    (Expr::Default, Expr::Default) => true
    (Expr::Placeholder(x), Expr::Placeholder(y)) => x == y
    (Expr::Wildcard, Expr::Wildcard) => true
    (Expr::QualifiedWildcard(x), Expr::QualifiedWildcard(y)) => obj_name_eq(x, y)
    (Expr::UnaryOp(o1, e1), Expr::UnaryOp(o2, e2)) => unary_op_eq(o1, o2) && expr_eq(e1, e2)
    (Expr::PrefixOp(s1, e1), Expr::PrefixOp(s2, e2)) => s1 == s2 && expr_eq(e1, e2)
    (Expr::BinaryOp(l1, o1, r1), Expr::BinaryOp(l2, o2, r2)) =>
    binary_op_eq(o1, o2) && expr_eq(l1, l2) && expr_eq(r1, r2)
    (Expr::AnyAllOp(l1, o1, a1, r1), Expr::AnyAllOp(l2, o2, a2, r2)) =>
    a1 == a2 && binary_op_eq(o1, o2) && expr_eq(l1, l2) && expr_eq(r1, r2)
    (Expr::IsNull(x), Expr::IsNull(y)) => expr_eq(x, y)
    (Expr::IsNotNull(x), Expr::IsNotNull(y)) => expr_eq(x, y)
    (Expr::IsTrue(x), Expr::IsTrue(y)) => expr_eq(x, y)
    (Expr::IsNotTrue(x), Expr::IsNotTrue(y)) => expr_eq(x, y)
    (Expr::IsFalse(x), Expr::IsFalse(y)) => expr_eq(x, y)
    (Expr::IsNotFalse(x), Expr::IsNotFalse(y)) => expr_eq(x, y)
    (Expr::IsDistinctFrom(l1, r1), Expr::IsDistinctFrom(l2, r2)) => expr_eq(l1, l2) && expr_eq(r1, r2)
    (Expr::IsNotDistinctFrom(l1, r1), Expr::IsNotDistinctFrom(l2, r2)) => expr_eq(l1, l2) && expr_eq(r1, r2)
    (Expr::InList(e1, l1, n1), Expr::InList(e2, l2, n2)) => n1 == n2 && expr_eq(e1, e2) && exprs_eq(l1, l2)
    (Expr::InSubquery(e1, q1, n1), Expr::InSubquery(e2, q2, n2)) => n1 == n2 && expr_eq(e1, e2) && query_eq(q1, q2)
    (Expr::Between(e1, n1, lo1, hi1), Expr::Between(e2, n2, lo2, hi2)) =>
    n1 == n2 && expr_eq(e1, e2) && expr_eq(lo1, lo2) && expr_eq(hi1, hi2)
    (Expr::Like(e1, n1, c1, p1, s1), Expr::Like(e2, n2, c2, p2, s2)) =>
    n1 == n2 && c1 == c2 && opt_str_eq(s1, s2) && expr_eq(e1, e2) && expr_eq(p1, p2)
    (Expr::SimilarTo(e1, n1, p1, s1), Expr::SimilarTo(e2, n2, p2, s2)) =>
    n1 == n2 && opt_str_eq(s1, s2) && expr_eq(e1, e2) && expr_eq(p1, p2)
    (Expr::PatternOp(e1, n1, k1, p1), Expr::PatternOp(e2, n2, k2, p2)) =>
    n1 == n2 && k1 == k2 && expr_eq(e1, e2) && expr_eq(p1, p2)
    (Expr::Cast(e1, d1, p1), Expr::Cast(e2, d2, p2)) => p1 == p2 && data_type_eq(d1, d2) && expr_eq(e1, e2)
    (Expr::TypedString(d1, s1), Expr::TypedString(d2, s2)) => s1 == s2 && data_type_eq(d1, d2)
    (Expr::Extract(f1, e1), Expr::Extract(f2, e2)) => ident_eq(f1, f2) && expr_eq(e1, e2)
    (Expr::Position(a1, b1), Expr::Position(a2, b2)) => expr_eq(a1, a2) && expr_eq(b1, b2)
    (Expr::Substring(e1, f1, o1), Expr::Substring(e2, f2, o2)) =>
    expr_eq(e1, e2) && opt_expr_eq(f1, f2) && opt_expr_eq(o1, o2)
    (Expr::Trim(w1, c1, e1), Expr::Trim(w2, c2, e2)) =>
    opt_str_eq(w1, w2) && opt_expr_eq(c1, c2) && expr_eq(e1, e2)
    (Expr::Nested(x), Expr::Nested(y)) => expr_eq(x, y)
    (Expr::Tuple(x), Expr::Tuple(y)) => exprs_eq(x, y)
    (Expr::Array(x), Expr::Array(y)) => exprs_eq(x, y)
    (Expr::ArraySubquery(x), Expr::ArraySubquery(y)) => query_eq(x, y)
    (Expr::Subscript(b1, i1), Expr::Subscript(b2, i2)) => expr_eq(b1, b2) && expr_eq(i1, i2)
    (Expr::Slice(b1, l1, h1), Expr::Slice(b2, l2, h2)) => expr_eq(b1, b2) && opt_expr_eq(l1, l2) && opt_expr_eq(h1, h2)
    (Expr::Function(x), Expr::Function(y)) => func_call_eq(x, y)
    (Expr::AggregateCall(f1, o1, w1, n1), Expr::AggregateCall(f2, o2, w2, n2)) =>
    func_call_eq(f1, f2) && order_bys_eq(o1, o2) && order_bys_eq(w1, w2) && opt_ident_eq(n1, n2)
    (Expr::Case(o1, b1, e1), Expr::Case(o2, b2, e2)) => {
      if !opt_expr_eq(o1, o2) || !opt_expr_eq(e1, e2) || b1.length() != b2.length() { return false }
      let mut i = 0
      while i < b1.length() {
        let (c1, r1) = b1[i]
        let (c2, r2) = b2[i]
        if !expr_eq(c1, c2) || !expr_eq(r1, r2) { return false }
        i = i + 1
      }
      true
    }
    (Expr::Subquery(x), Expr::Subquery(y)) => query_eq(x, y)
    (Expr::Exists(q1, n1), Expr::Exists(q2, n2)) => n1 == n2 && query_eq(q1, q2)
    (Expr::Collate(e1, c1), Expr::Collate(e2, c2)) => expr_eq(e1, e2) && obj_name_eq(c1, c2)
    (Expr::GroupingSet(k1, l1), Expr::GroupingSet(k2, l2)) => k1 == k2 && exprs_eq(l1, l2)
    _ => false
  }
}

fn select_item_eq(a : SelectItem, b : SelectItem) -> Bool {
  match (a, b) {
    (SelectItem::UnnamedExpr(x), SelectItem::UnnamedExpr(y)) => expr_eq(x, y)
    (SelectItem::ExprWithAlias(e1, a1), SelectItem::ExprWithAlias(e2, a2)) => expr_eq(e1, e2) && ident_eq(a1, a2)
    (SelectItem::Wildcard, SelectItem::Wildcard) => true
    (SelectItem::QualifiedWildcard(x), SelectItem::QualifiedWildcard(y)) => obj_name_eq(x, y)
    _ => false
  }
}

fn select_items_eq(a : Array[SelectItem], b : Array[SelectItem]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !select_item_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn table_alias_eq(a : Option[TableAlias], b : Option[TableAlias]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => ident_eq(x.name, y.name) && idents_eq(x.columns, y.columns)
    _ => false
  }
}

fn join_constraint_eq(a : JoinConstraint, b : JoinConstraint) -> Bool {
  match (a, b) {
    (JoinConstraint::On(x), JoinConstraint::On(y)) => expr_eq(x, y)
    (JoinConstraint::Using(x), JoinConstraint::Using(y)) => idents_eq(x, y)
    (JoinConstraint::None, JoinConstraint::None) => true
    _ => false
  }
}

fn join_op_eq(a : JoinOperator, b : JoinOperator) -> Bool {
  match (a, b) {
    (JoinOperator::Inner(x), JoinOperator::Inner(y)) => join_constraint_eq(x, y)
    (JoinOperator::LeftOuter(x), JoinOperator::LeftOuter(y)) => join_constraint_eq(x, y)
    (JoinOperator::RightOuter(x), JoinOperator::RightOuter(y)) => join_constraint_eq(x, y)
    (JoinOperator::FullOuter(x), JoinOperator::FullOuter(y)) => join_constraint_eq(x, y)
    (JoinOperator::CrossJoin, JoinOperator::CrossJoin) => true
    (JoinOperator::NaturalInner, JoinOperator::NaturalInner) => true
    (JoinOperator::NaturalLeft, JoinOperator::NaturalLeft) => true
    (JoinOperator::NaturalRight, JoinOperator::NaturalRight) => true
    (JoinOperator::NaturalFull, JoinOperator::NaturalFull) => true
    _ => false
  }
}

fn table_factor_eq(a : TableFactor, b : TableFactor) -> Bool {
  match (a, b) {
    (TableFactor::Table(n1, a1), TableFactor::Table(n2, a2)) => obj_name_eq(n1, n2) && table_alias_eq(a1, a2)
    (TableFactor::Derived(l1, q1, a1), TableFactor::Derived(l2, q2, a2)) =>
    l1 == l2 && query_eq(q1, q2) && table_alias_eq(a1, a2)
    (TableFactor::NestedJoin(x), TableFactor::NestedJoin(y)) => twj_eq(x, y)
    (TableFactor::TableFunction(n1, args1, a1), TableFactor::TableFunction(n2, args2, a2)) =>
    obj_name_eq(n1, n2) && exprs_eq(args1, args2) && table_alias_eq(a1, a2)
    _ => false
  }
}

fn twj_eq(a : TableWithJoins, b : TableWithJoins) -> Bool {
  if !table_factor_eq(a.relation, b.relation) || a.joins.length() != b.joins.length() {
    return false
  }
  let mut i = 0
  while i < a.joins.length() {
    if !table_factor_eq(a.joins[i].relation, b.joins[i].relation) || !join_op_eq(a.joins[i].join_operator, b.joins[i].join_operator) {
      return false
    }
    i = i + 1
  }
  true
}

fn twjs_eq(a : Array[TableWithJoins], b : Array[TableWithJoins]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !twj_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn select_eq(a : Select, b : Select) -> Bool {
  let d_eq = match (a.distinct, b.distinct) {
    (DistinctKind::None, DistinctKind::None) => true
    (DistinctKind::Distinct, DistinctKind::Distinct) => true
    (DistinctKind::All, DistinctKind::All) => true
    (DistinctKind::DistinctOn(x), DistinctKind::DistinctOn(y)) => exprs_eq(x, y)
    _ => false
  }
  d_eq && select_items_eq(a.projection, b.projection) && twjs_eq(a.from, b.from) &&
  opt_expr_eq(a.selection, b.selection) && exprs_eq(a.group_by, b.group_by) &&
  opt_expr_eq(a.having, b.having)
}

fn set_expr_eq(a : SetExpr, b : SetExpr) -> Bool {
  match (a, b) {
    (SetExpr::Select(x), SetExpr::Select(y)) => select_eq(x, y)
    (SetExpr::SelectWithWindows(s1, w1), SetExpr::SelectWithWindows(s2, w2)) => {
      if !select_eq(s1, s2) || w1.length() != w2.length() { return false }
      let mut i = 0
      while i < w1.length() {
        let (n1, ws1) = w1[i]
        let (n2, ws2) = w2[i]
        if !ident_eq(n1, n2) || !window_spec_eq(ws1, ws2) { return false }
        i = i + 1
      }
      true
    }
    (SetExpr::Query(x), SetExpr::Query(y)) => query_eq(x, y)
    (SetExpr::SetOperation(o1, a1, l1, r1), SetExpr::SetOperation(o2, a2, l2, r2)) => {
      let op_eq = match (o1, o2) {
        (SetOperator::Union, SetOperator::Union) => true
        (SetOperator::Intersect, SetOperator::Intersect) => true
        (SetOperator::Except, SetOperator::Except) => true
        _ => false
      }
      op_eq && a1 == a2 && set_expr_eq(l1, l2) && set_expr_eq(r1, r2)
    }
    (SetExpr::Values(r1), SetExpr::Values(r2)) => {
      if r1.length() != r2.length() { return false }
      let mut i = 0
      while i < r1.length() {
        if !exprs_eq(r1[i], r2[i]) { return false }
        i = i + 1
      }
      true
    }
    (SetExpr::DefaultValues, SetExpr::DefaultValues) => true
    (SetExpr::TableRef(x), SetExpr::TableRef(y)) => obj_name_eq(x, y)
    _ => false
  }
}

fn query_eq(a : Query, b : Query) -> Bool {
  let w_eq = match (a.with_clause, b.with_clause) {
    (None, None) => true
    (Some(x), Some(y)) => {
      if x.recursive != y.recursive || x.cte_tables.length() != y.cte_tables.length() { return false }
      let mut i = 0
      while i < x.cte_tables.length() {
        let c1 = x.cte_tables[i]
        let c2 = y.cte_tables[i]
        if !ident_eq(c1.alias, c2.alias) || !idents_eq(c1.columns, c2.columns) ||
        !opt_bool_eq(c1.materialized, c2.materialized) || !query_eq(c1.query, c2.query) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
  w_eq && set_expr_eq(a.body, b.body) && order_bys_eq(a.order_by, b.order_by) &&
  opt_expr_eq(a.limit, b.limit) && opt_expr_eq(a.offset, b.offset)
}

fn assigns_eq(a : Array[Assignment], b : Array[Assignment]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !ident_eq(a[i].target, b[i].target) || !expr_eq(a[i].value, b[i].value) { return false }
    i = i + 1
  }
  true
}

fn insert_eq(a : InsertStmt, b : InsertStmt) -> Bool {
  if !obj_name_eq(a.table_name, b.table_name) || !idents_eq(a.columns, b.columns) ||
  !query_eq(a.source, b.source) || !select_items_eq(a.returning, b.returning) {
    return false
  }
  match (a.on_conflict, b.on_conflict) {
    (None, None) => true
    (Some(x), Some(y)) => {
      if !idents_eq(x.target_columns, y.target_columns) { return false }
      match (x.action, y.action) {
        (OnConflictAction::DoNothing, OnConflictAction::DoNothing) => true
        (OnConflictAction::DoUpdate(a1, w1), OnConflictAction::DoUpdate(a2, w2)) =>
        assigns_eq(a1, a2) && opt_expr_eq(w1, w2)
        _ => false
      }
    }
    _ => false
  }
}

fn ref_action_eq(a : Option[ReferentialAction], b : Option[ReferentialAction]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(ReferentialAction::Cascade), Some(ReferentialAction::Cascade)) => true
    (Some(ReferentialAction::SetNull), Some(ReferentialAction::SetNull)) => true
    (Some(ReferentialAction::SetDefault), Some(ReferentialAction::SetDefault)) => true
    (Some(ReferentialAction::Restrict), Some(ReferentialAction::Restrict)) => true
    (Some(ReferentialAction::NoAction), Some(ReferentialAction::NoAction)) => true
    _ => false
  }
}

fn col_constraint_eq(a : ColumnConstraint, b : ColumnConstraint) -> Bool {
  match (a, b) {
    (ColumnConstraint::NotNull, ColumnConstraint::NotNull) => true
    (ColumnConstraint::Null, ColumnConstraint::Null) => true
    (ColumnConstraint::PrimaryKey(x), ColumnConstraint::PrimaryKey(y)) => x == y
    (ColumnConstraint::Unique, ColumnConstraint::Unique) => true
    (ColumnConstraint::Default(x), ColumnConstraint::Default(y)) => expr_eq(x, y)
    (ColumnConstraint::Check(x), ColumnConstraint::Check(y)) => expr_eq(x, y)
    (ColumnConstraint::References(t1, c1, d1, u1), ColumnConstraint::References(t2, c2, d2, u2)) =>
    obj_name_eq(t1, t2) && idents_eq(c1, c2) && ref_action_eq(d1, d2) && ref_action_eq(u1, u2)
    (ColumnConstraint::Named(n1, i1), ColumnConstraint::Named(n2, i2)) =>
    ident_eq(n1, n2) && col_constraint_eq(i1, i2)
    (ColumnConstraint::Generated(e1, a1, s1), ColumnConstraint::Generated(e2, a2, s2)) =>
    a1 == a2 && s1 == s2 && opt_expr_eq(e1, e2)
    _ => false
  }
}

fn col_def_eq(a : ColumnDef, b : ColumnDef) -> Bool {
  if !ident_eq(a.name, b.name) || !data_type_eq(a.data_type, b.data_type) ||
  a.constraints.length() != b.constraints.length() {
    return false
  }
  let mut i = 0
  while i < a.constraints.length() {
    if !col_constraint_eq(a.constraints[i], b.constraints[i]) { return false }
    i = i + 1
  }
  true
}

fn table_constraint_eq(a : TableConstraint, b : TableConstraint) -> Bool {
  match (a, b) {
    (TableConstraint::PrimaryKey(n1, c1), TableConstraint::PrimaryKey(n2, c2)) =>
    opt_ident_eq(n1, n2) && idents_eq(c1, c2)
    (TableConstraint::Unique(n1, c1), TableConstraint::Unique(n2, c2)) =>
    opt_ident_eq(n1, n2) && idents_eq(c1, c2)
    (TableConstraint::Check(n1, e1), TableConstraint::Check(n2, e2)) =>
    opt_ident_eq(n1, n2) && expr_eq(e1, e2)
    (TableConstraint::ForeignKey(n1, c1, t1, rc1, d1, u1), TableConstraint::ForeignKey(n2, c2, t2, rc2, d2, u2)) =>
    opt_ident_eq(n1, n2) && idents_eq(c1, c2) && obj_name_eq(t1, t2) && idents_eq(rc1, rc2) &&
    ref_action_eq(d1, d2) && ref_action_eq(u1, u2)
    _ => false
  }
}

fn alter_op_eq(a : AlterTableOp, b : AlterTableOp) -> Bool {
  match (a, b) {
    (AlterTableOp::AddColumn(x), AlterTableOp::AddColumn(y)) => col_def_eq(x, y)
    (AlterTableOp::DropColumn(i1, e1, c1), AlterTableOp::DropColumn(i2, e2, c2)) =>
    ident_eq(i1, i2) && e1 == e2 && c1 == c2
    (AlterTableOp::RenameColumn(o1, n1), AlterTableOp::RenameColumn(o2, n2)) =>
    ident_eq(o1, o2) && ident_eq(n1, n2)
    (AlterTableOp::RenameTable(x), AlterTableOp::RenameTable(y)) => obj_name_eq(x, y)
    (AlterTableOp::AlterColumnType(i1, d1), AlterTableOp::AlterColumnType(i2, d2)) =>
    ident_eq(i1, i2) && data_type_eq(d1, d2)
    (AlterTableOp::AddConstraint(x), AlterTableOp::AddConstraint(y)) => table_constraint_eq(x, y)
    (AlterTableOp::DropConstraint(i1, e1, c1), AlterTableOp::DropConstraint(i2, e2, c2)) =>
    ident_eq(i1, i2) && e1 == e2 && c1 == c2
    _ => false
  }
}

fn obj_names_eq(a : Array[ObjectName], b : Array[ObjectName]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if !obj_name_eq(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

fn stmt_eq_impl(a : Statement, b : Statement) -> Bool {
  match (a, b) {
    (Statement::Query(x), Statement::Query(y)) => query_eq(x, y)
    (Statement::QueryLocked(q1, l1), Statement::QueryLocked(q2, l2)) => l1 == l2 && query_eq(q1, q2)
    (Statement::Insert(x), Statement::Insert(y)) => insert_eq(x, y)
    (Statement::InsertOr(o1, x), Statement::InsertOr(o2, y)) => opt_str_eq(o1, o2) && insert_eq(x, y)
    (Statement::Update(x), Statement::Update(y)) =>
    twj_eq(x.table, y.table) && assigns_eq(x.assignments, y.assignments) &&
    twjs_eq(x.from, y.from) && opt_expr_eq(x.selection, y.selection) && select_items_eq(x.returning, y.returning)
    (Statement::UpdateMulti(t1, a1, f1, s1, r1), Statement::UpdateMulti(t2, a2, f2, s2, r2)) => {
      if !twj_eq(t1, t2) || a1.length() != a2.length() || !twjs_eq(f1, f2) ||
      !opt_expr_eq(s1, s2) || !select_items_eq(r1, r2) {
        return false
      }
      let mut i = 0
      while i < a1.length() {
        let (c1, v1) = a1[i]
        let (c2, v2) = a2[i]
        if !idents_eq(c1, c2) || !expr_eq(v1, v2) { return false }
        i = i + 1
      }
      true
    }
    (Statement::Delete(x), Statement::Delete(y)) =>
    twj_eq(x.from, y.from) && opt_expr_eq(x.selection, y.selection) && select_items_eq(x.returning, y.returning)
    (Statement::DeleteUsing(f1, u1, s1, r1), Statement::DeleteUsing(f2, u2, s2, r2)) =>
    twj_eq(f1, f2) && twjs_eq(u1, u2) && opt_expr_eq(s1, s2) && select_items_eq(r1, r2)
    (Statement::CreateTable(x), Statement::CreateTable(y)) => {
      if x.temporary != y.temporary || x.if_not_exists != y.if_not_exists ||
      !obj_name_eq(x.name, y.name) || x.without_rowid != y.without_rowid ||
      x.columns.length() != y.columns.length() || x.constraints.length() != y.constraints.length() {
        return false
      }
      let mut i = 0
      while i < x.columns.length() {
        if !col_def_eq(x.columns[i], y.columns[i]) { return false }
        i = i + 1
      }
      let mut j = 0
      while j < x.constraints.length() {
        if !table_constraint_eq(x.constraints[j], y.constraints[j]) { return false }
        j = j + 1
      }
      true
    }
    (Statement::CreateTableAs(t1, e1, n1, q1), Statement::CreateTableAs(t2, e2, n2, q2)) =>
    t1 == t2 && e1 == e2 && obj_name_eq(n1, n2) && query_eq(q1, q2)
    (Statement::CreateTableLike(t1, e1, n1, s1), Statement::CreateTableLike(t2, e2, n2, s2)) =>
    t1 == t2 && e1 == e2 && obj_name_eq(n1, n2) && obj_name_eq(s1, s2)
    (Statement::CreateIndex(x), Statement::CreateIndex(y)) =>
    x.unique == y.unique && x.if_not_exists == y.if_not_exists && obj_name_eq(x.name, y.name) &&
    obj_name_eq(x.table_name, y.table_name) && order_bys_eq(x.columns, y.columns) &&
    opt_expr_eq(x.predicate, y.predicate)
    (Statement::CreateIndexExt(x, c1, u1), Statement::CreateIndexExt(y, c2, u2)) =>
    c1 == c2 && opt_ident_eq(u1, u2) &&
    x.unique == y.unique && x.if_not_exists == y.if_not_exists && obj_name_eq(x.name, y.name) &&
    obj_name_eq(x.table_name, y.table_name) && order_bys_eq(x.columns, y.columns) &&
    opt_expr_eq(x.predicate, y.predicate)
    (Statement::CreateView(x), Statement::CreateView(y)) =>
    x.temporary == y.temporary && x.or_replace == y.or_replace && x.if_not_exists == y.if_not_exists &&
    obj_name_eq(x.name, y.name) && idents_eq(x.columns, y.columns) && query_eq(x.query, y.query)
    (Statement::AlterTable(x), Statement::AlterTable(y)) => {
      if !obj_name_eq(x.name, y.name) || x.operations.length() != y.operations.length() { return false }
      let mut i = 0
      while i < x.operations.length() {
        if !alter_op_eq(x.operations[i], y.operations[i]) { return false }
        i = i + 1
      }
      true
    }
    (Statement::Drop(x), Statement::Drop(y)) => {
      let t_eq = match (x.object_type, y.object_type) {
        (ObjectType::Table, ObjectType::Table) => true
        (ObjectType::Index, ObjectType::Index) => true
        (ObjectType::View, ObjectType::View) => true
        _ => false
      }
      t_eq && x.if_exists == y.if_exists && x.cascade == y.cascade && obj_names_eq(x.names, y.names)
    }
    (Statement::Truncate(n1, c1), Statement::Truncate(n2, c2)) => c1 == c2 && obj_names_eq(n1, n2)
    (Statement::Begin(x), Statement::Begin(y)) => opt_str_eq(x, y)
    (Statement::Commit, Statement::Commit) => true
    (Statement::Rollback(x), Statement::Rollback(y)) => opt_ident_eq(x, y)
    (Statement::Savepoint(x), Statement::Savepoint(y)) => ident_eq(x, y)
    (Statement::ReleaseSavepoint(x), Statement::ReleaseSavepoint(y)) => ident_eq(x, y)
    (Statement::Explain(a1, s1), Statement::Explain(a2, s2)) => a1 == a2 && stmt_eq_impl(s1, s2)
    (Statement::ExplainOptions(o1, s1), Statement::ExplainOptions(o2, s2)) => {
      if o1.length() != o2.length() || !stmt_eq_impl(s1, s2) { return false }
      let mut i = 0
      while i < o1.length() {
        if o1[i] != o2[i] { return false }
        i = i + 1
      }
      true
    }
    (Statement::SetVar(n1, v1), Statement::SetVar(n2, v2)) => obj_name_eq(n1, n2) && expr_eq(v1, v2)
    (Statement::ShowVar(x), Statement::ShowVar(y)) => obj_name_eq(x, y)
    (Statement::Analyze(x), Statement::Analyze(y)) =>
    match (x, y) {
      (None, None) => true
      (Some(a1), Some(b1)) => obj_name_eq(a1, b1)
      _ => false
    }
    (Statement::CreateSchema(x), Statement::CreateSchema(y)) => obj_name_eq(x, y)
    (Statement::CreateSequence(x), Statement::CreateSequence(y)) => obj_name_eq(x, y)
    (Statement::Pragma(n1, a1), Statement::Pragma(n2, a2)) => obj_name_eq(n1, n2) && opt_expr_eq(a1, a2)
    (Statement::Vacuum, Statement::Vacuum) => true
    _ => false
  }
}

fn stmts_eq_impl(a : Array[Statement], b : Array[Statement]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !stmt_eq_impl(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}
