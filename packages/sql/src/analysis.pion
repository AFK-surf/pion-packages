///| Static analysis utilities (`extract_tables`, `extract_placeholders`) and structural AST equality (`stmt_eq`).

fn object_name_to_string(name : ObjectName) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < name.parts.length() {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    sb.write_string(name.parts[i].value)
    i = i + 1
  }
  sb.to_string()
}

fn array_contains_str(arr : Array[String], s : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

fn push_unique_table(out : Array[String], ctes : Array[String], name : ObjectName) -> Unit {
  if name.parts.length() == 1 && array_contains_str(ctes, name.parts[0].value) {
    return
  }
  let s = object_name_to_string(name)
  if !array_contains_str(out, s) {
    out.push(s)
  }
}

fn collect_tables_expr(out : Array[String], ctes : Array[String], expr : Expr) -> Unit {
  match expr {
    Expr::UnaryOp(_, e) | Expr::IsNull(e) | Expr::IsNotNull(e) | Expr::IsTrue(e) | Expr::IsNotTrue(e) | Expr::IsFalse(e) | Expr::IsNotFalse(e) | Expr::Cast(e, _, _) | Expr::Nested(e) | Expr::Collate(e, _) =>
    collect_tables_expr(out, ctes, e)
    Expr::BinaryOp(l, _, r) | Expr::IsDistinctFrom(l, r) | Expr::IsNotDistinctFrom(l, r) | Expr::Subscript(l, r) | Expr::Like(l, _, _, r, _) => {
      collect_tables_expr(out, ctes, l)
      collect_tables_expr(out, ctes, r)
    }
    Expr::Between(e, _, lo, hi) => {
      collect_tables_expr(out, ctes, e)
      collect_tables_expr(out, ctes, lo)
      collect_tables_expr(out, ctes, hi)
    }
    Expr::InList(e, list, _) => {
      collect_tables_expr(out, ctes, e)
      let mut i = 0
      while i < list.length() {
        collect_tables_expr(out, ctes, list[i])
        i = i + 1
      }
    }
    Expr::InSubquery(e, q, _) => {
      collect_tables_expr(out, ctes, e)
      collect_tables_query(out, ctes, q)
    }
    Expr::Tuple(items) | Expr::Array(items) => {
      let mut i = 0
      while i < items.length() {
        collect_tables_expr(out, ctes, items[i])
        i = i + 1
      }
    }
    Expr::Function(fc) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_tables_expr(out, ctes, fc.args[i])
        i = i + 1
      }
      match fc.filter {
        Some(f) => collect_tables_expr(out, ctes, f)
        None => ()
      }
      match fc.over {
        Some(ws) => {
          let mut j = 0
          while j < ws.partition_by.length() {
            collect_tables_expr(out, ctes, ws.partition_by[j])
            j = j + 1
          }
          let mut k = 0
          while k < ws.order_by.length() {
            collect_tables_expr(out, ctes, ws.order_by[k].expr)
            k = k + 1
          }
        }
        None => ()
      }
    }
    Expr::Case(op, branches, er) => {
      match op {
        Some(e) => collect_tables_expr(out, ctes, e)
        None => ()
      }
      let mut i = 0
      while i < branches.length() {
        let (c, r) = branches[i]
        collect_tables_expr(out, ctes, c)
        collect_tables_expr(out, ctes, r)
        i = i + 1
      }
      match er {
        Some(e) => collect_tables_expr(out, ctes, e)
        None => ()
      }
    }
    Expr::Subquery(q) | Expr::Exists(q, _) => collect_tables_query(out, ctes, q)
    _ => ()
  }
}

fn collect_tables_select_item(out : Array[String], ctes : Array[String], item : SelectItem) -> Unit {
  match item {
    SelectItem::UnnamedExpr(e) | SelectItem::ExprWithAlias(e, _) => collect_tables_expr(out, ctes, e)
    _ => ()
  }
}

fn collect_tables_factor(out : Array[String], ctes : Array[String], tf : TableFactor) -> Unit {
  match tf {
    TableFactor::Table(name, _) => push_unique_table(out, ctes, name)
    TableFactor::Derived(_, q, _) => collect_tables_query(out, ctes, q)
    TableFactor::NestedJoin(twj) => collect_tables_twj(out, ctes, twj)
  }
}

fn collect_tables_twj(out : Array[String], ctes : Array[String], twj : TableWithJoins) -> Unit {
  collect_tables_factor(out, ctes, twj.relation)
  let mut i = 0
  while i < twj.joins.length() {
    let j = twj.joins[i]
    collect_tables_factor(out, ctes, j.relation)
    match j.join_operator {
      JoinOperator::Inner(JoinConstraint::On(e)) | JoinOperator::LeftOuter(JoinConstraint::On(e)) | JoinOperator::RightOuter(JoinConstraint::On(e)) | JoinOperator::FullOuter(JoinConstraint::On(e)) =>
      collect_tables_expr(out, ctes, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_tables_set_expr(out : Array[String], ctes : Array[String], body : SetExpr) -> Unit {
  match body {
    SetExpr::Select(sel) => {
      let mut i = 0
      while i < sel.projection.length() {
        collect_tables_select_item(out, ctes, sel.projection[i])
        i = i + 1
      }
      let mut j = 0
      while j < sel.from.length() {
        collect_tables_twj(out, ctes, sel.from[j])
        j = j + 1
      }
      match sel.selection {
        Some(w) => collect_tables_expr(out, ctes, w)
        None => ()
      }
      let mut k = 0
      while k < sel.group_by.length() {
        collect_tables_expr(out, ctes, sel.group_by[k])
        k = k + 1
      }
      match sel.having {
        Some(h) => collect_tables_expr(out, ctes, h)
        None => ()
      }
    }
    SetExpr::Query(q) => collect_tables_query(out, ctes, q)
    SetExpr::SetOperation(_, _, l, r) => {
      collect_tables_set_expr(out, ctes, l)
      collect_tables_set_expr(out, ctes, r)
    }
    SetExpr::Values(rows) => {
      let mut i = 0
      while i < rows.length() {
        let row = rows[i]
        let mut j = 0
        while j < row.length() {
          collect_tables_expr(out, ctes, row[j])
          j = j + 1
        }
        i = i + 1
      }
    }
  }
}

fn collect_tables_query(out : Array[String], ctes : Array[String], q : Query) -> Unit {
  let prev_cte_len = ctes.length()
  match q.with_clause {
    Some(w) => {
      let mut i = 0
      while i < w.cte_tables.length() {
        let cte = w.cte_tables[i]
        if w.recursive {
          ctes.push(cte.alias.value)
        }
        collect_tables_query(out, ctes, cte.query)
        if !w.recursive {
          ctes.push(cte.alias.value)
        }
        i = i + 1
      }
    }
    None => ()
  }
  collect_tables_set_expr(out, ctes, q.body)
  let mut i = 0
  while i < q.order_by.length() {
    collect_tables_expr(out, ctes, q.order_by[i].expr)
    i = i + 1
  }
  match q.limit {
    Some(e) => collect_tables_expr(out, ctes, e)
    None => ()
  }
  match q.offset {
    Some(e) => collect_tables_expr(out, ctes, e)
    None => ()
  }
  while ctes.length() > prev_cte_len {
    let _ = ctes.pop()
  }
}

fn extract_tables_impl(stmt : Statement) -> Array[String] {
  let out : Array[String] = []
  let ctes : Array[String] = []
  collect_tables_stmt(out, ctes, stmt)
  out
}

fn collect_tables_stmt(out : Array[String], ctes : Array[String], stmt : Statement) -> Unit {
  match stmt {
    Statement::Query(q) => collect_tables_query(out, ctes, q)
    Statement::Insert(ins) => {
      push_unique_table(out, ctes, ins.table_name)
      collect_tables_query(out, ctes, ins.source)
    }
    Statement::Update(upd) => {
      collect_tables_twj(out, ctes, upd.table)
      let mut i = 0
      while i < upd.assignments.length() {
        collect_tables_expr(out, ctes, upd.assignments[i].value)
        i = i + 1
      }
      let mut j = 0
      while j < upd.from.length() {
        collect_tables_twj(out, ctes, upd.from[j])
        j = j + 1
      }
      match upd.selection {
        Some(w) => collect_tables_expr(out, ctes, w)
        None => ()
      }
    }
    Statement::Delete(del) => {
      collect_tables_twj(out, ctes, del.from)
      match del.selection {
        Some(w) => collect_tables_expr(out, ctes, w)
        None => ()
      }
    }
    Statement::CreateTable(ct) => {
      push_unique_table(out, ctes, ct.name)
      let mut i = 0
      while i < ct.columns.length() {
        let mut j = 0
        while j < ct.columns[i].constraints.length() {
          match ct.columns[i].constraints[j] {
            ColumnConstraint::References(rt, _, _, _) => push_unique_table(out, ctes, rt)
            _ => ()
          }
          j = j + 1
        }
        i = i + 1
      }
    }
    Statement::CreateIndex(ci) => push_unique_table(out, ctes, ci.table_name)
    Statement::CreateView(cv) => collect_tables_query(out, ctes, cv.query)
    Statement::AlterTable(at) => push_unique_table(out, ctes, at.name)
    Statement::Drop(d) => {
      let mut i = 0
      while i < d.names.length() {
        push_unique_table(out, ctes, d.names[i])
        i = i + 1
      }
    }
    Statement::Explain(_, inner) => collect_tables_stmt(out, ctes, inner)
    _ => ()
  }
}

// Placeholder extraction

fn collect_ph_expr(out : Array[String], expr : Expr) -> Unit {
  match expr {
    Expr::Placeholder(p) => out.push(p)
    Expr::UnaryOp(_, e) | Expr::IsNull(e) | Expr::IsNotNull(e) | Expr::IsTrue(e) | Expr::IsNotTrue(e) | Expr::IsFalse(e) | Expr::IsNotFalse(e) | Expr::Cast(e, _, _) | Expr::Nested(e) | Expr::Collate(e, _) =>
    collect_ph_expr(out, e)
    Expr::BinaryOp(l, _, r) | Expr::IsDistinctFrom(l, r) | Expr::IsNotDistinctFrom(l, r) | Expr::Subscript(l, r) | Expr::Like(l, _, _, r, _) => {
      collect_ph_expr(out, l)
      collect_ph_expr(out, r)
    }
    Expr::Between(e, _, lo, hi) => {
      collect_ph_expr(out, e)
      collect_ph_expr(out, lo)
      collect_ph_expr(out, hi)
    }
    Expr::InList(e, list, _) => {
      collect_ph_expr(out, e)
      let mut i = 0
      while i < list.length() {
        collect_ph_expr(out, list[i])
        i = i + 1
      }
    }
    Expr::InSubquery(e, q, _) => {
      collect_ph_expr(out, e)
      collect_ph_query(out, q)
    }
    Expr::Tuple(items) | Expr::Array(items) => {
      let mut i = 0
      while i < items.length() {
        collect_ph_expr(out, items[i])
        i = i + 1
      }
    }
    Expr::Function(fc) => {
      let mut i = 0
      while i < fc.args.length() {
        collect_ph_expr(out, fc.args[i])
        i = i + 1
      }
      match fc.filter {
        Some(f) => collect_ph_expr(out, f)
        None => ()
      }
      match fc.over {
        Some(ws) => {
          let mut j = 0
          while j < ws.partition_by.length() {
            collect_ph_expr(out, ws.partition_by[j])
            j = j + 1
          }
          let mut k = 0
          while k < ws.order_by.length() {
            collect_ph_expr(out, ws.order_by[k].expr)
            k = k + 1
          }
        }
        None => ()
      }
    }
    Expr::Case(op, branches, er) => {
      match op {
        Some(e) => collect_ph_expr(out, e)
        None => ()
      }
      let mut i = 0
      while i < branches.length() {
        let (c, r) = branches[i]
        collect_ph_expr(out, c)
        collect_ph_expr(out, r)
        i = i + 1
      }
      match er {
        Some(e) => collect_ph_expr(out, e)
        None => ()
      }
    }
    Expr::Subquery(q) | Expr::Exists(q, _) => collect_ph_query(out, q)
    _ => ()
  }
}

fn collect_ph_select_items(out : Array[String], items : Array[SelectItem]) -> Unit {
  let mut i = 0
  while i < items.length() {
    match items[i] {
      SelectItem::UnnamedExpr(e) | SelectItem::ExprWithAlias(e, _) => collect_ph_expr(out, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_ph_twj(out : Array[String], twj : TableWithJoins) -> Unit {
  match twj.relation {
    TableFactor::Derived(_, q, _) => collect_ph_query(out, q)
    TableFactor::NestedJoin(inner) => collect_ph_twj(out, inner)
    _ => ()
  }
  let mut i = 0
  while i < twj.joins.length() {
    let j = twj.joins[i]
    match j.relation {
      TableFactor::Derived(_, q, _) => collect_ph_query(out, q)
      TableFactor::NestedJoin(inner) => collect_ph_twj(out, inner)
      _ => ()
    }
    match j.join_operator {
      JoinOperator::Inner(JoinConstraint::On(e)) | JoinOperator::LeftOuter(JoinConstraint::On(e)) | JoinOperator::RightOuter(JoinConstraint::On(e)) | JoinOperator::FullOuter(JoinConstraint::On(e)) =>
      collect_ph_expr(out, e)
      _ => ()
    }
    i = i + 1
  }
}

fn collect_ph_set_expr(out : Array[String], body : SetExpr) -> Unit {
  match body {
    SetExpr::Select(sel) => {
      collect_ph_select_items(out, sel.projection)
      let mut i = 0
      while i < sel.from.length() {
        collect_ph_twj(out, sel.from[i])
        i = i + 1
      }
      match sel.selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      let mut j = 0
      while j < sel.group_by.length() {
        collect_ph_expr(out, sel.group_by[j])
        j = j + 1
      }
      match sel.having {
        Some(h) => collect_ph_expr(out, h)
        None => ()
      }
    }
    SetExpr::Query(q) => collect_ph_query(out, q)
    SetExpr::SetOperation(_, _, l, r) => {
      collect_ph_set_expr(out, l)
      collect_ph_set_expr(out, r)
    }
    SetExpr::Values(rows) => {
      let mut i = 0
      while i < rows.length() {
        let row = rows[i]
        let mut j = 0
        while j < row.length() {
          collect_ph_expr(out, row[j])
          j = j + 1
        }
        i = i + 1
      }
    }
  }
}

fn collect_ph_query(out : Array[String], q : Query) -> Unit {
  match q.with_clause {
    Some(w) => {
      let mut i = 0
      while i < w.cte_tables.length() {
        collect_ph_query(out, w.cte_tables[i].query)
        i = i + 1
      }
    }
    None => ()
  }
  collect_ph_set_expr(out, q.body)
  let mut i = 0
  while i < q.order_by.length() {
    collect_ph_expr(out, q.order_by[i].expr)
    i = i + 1
  }
  match q.limit {
    Some(e) => collect_ph_expr(out, e)
    None => ()
  }
  match q.offset {
    Some(e) => collect_ph_expr(out, e)
    None => ()
  }
}

fn collect_ph_stmt(out : Array[String], stmt : Statement) -> Unit {
  match stmt {
    Statement::Query(q) => collect_ph_query(out, q)
    Statement::Insert(ins) => {
      collect_ph_query(out, ins.source)
      match ins.on_conflict {
        Some(oc) =>
        match oc.action {
          OnConflictAction::DoUpdate(assigns, wh) => {
            let mut i = 0
            while i < assigns.length() {
              collect_ph_expr(out, assigns[i].value)
              i = i + 1
            }
            match wh {
              Some(w) => collect_ph_expr(out, w)
              None => ()
            }
          }
          OnConflictAction::DoNothing => ()
        }
        None => ()
      }
      collect_ph_select_items(out, ins.returning)
    }
    Statement::Update(upd) => {
      let mut i = 0
      while i < upd.assignments.length() {
        collect_ph_expr(out, upd.assignments[i].value)
        i = i + 1
      }
      let mut j = 0
      while j < upd.from.length() {
        collect_ph_twj(out, upd.from[j])
        j = j + 1
      }
      match upd.selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, upd.returning)
    }
    Statement::Delete(del) => {
      collect_ph_twj(out, del.from)
      match del.selection {
        Some(w) => collect_ph_expr(out, w)
        None => ()
      }
      collect_ph_select_items(out, del.returning)
    }
    Statement::Explain(_, inner) => collect_ph_stmt(out, inner)
    _ => ()
  }
}

fn extract_placeholders_impl(stmt : Statement) -> Array[String] {
  let out : Array[String] = []
  collect_ph_stmt(out, stmt)
  out
}

// Structural AST equality via unambiguous parenthesized AST serialization.

fn write_expr_ast(sb : StringBuilder, expr : Expr) -> Unit {
  match expr {
    Expr::Identifier(id) => {
      sb.write_string("(Id ")
      write_ident(sb, id)
      sb.write_byte((41).to_byte())
    }
    Expr::CompoundIdentifier(parts) => {
      sb.write_string("(Cid")
      let mut i = 0
      while i < parts.length() {
        sb.write_byte((32).to_byte())
        write_ident(sb, parts[i])
        i = i + 1
      }
      sb.write_byte((41).to_byte())
    }
    Expr::Number(n) => {
      sb.write_string("(Num ")
      sb.write_string(n)
      sb.write_byte((41).to_byte())
    }
    Expr::SingleQuotedString(s) => {
      sb.write_string("(Str ")
      write_single_quoted(sb, s)
      sb.write_byte((41).to_byte())
    }
    Expr::EscapedString(s) => {
      sb.write_string("(EStr ")
      write_escaped_sql_string(sb, s)
      sb.write_byte((41).to_byte())
    }
    Expr::DollarQuotedString(t, b) => {
      sb.write_string("(DStr ")
      sb.write_string(t)
      sb.write_byte((58).to_byte())
      sb.write_string(b)
      sb.write_byte((41).to_byte())
    }
    Expr::Boolean(b) => sb.write_string(if b { "(Bool T)" } else { "(Bool F)" })
    Expr::Null => sb.write_string("(Null)")
    Expr::Placeholder(p) => {
      sb.write_string("(Ph ")
      sb.write_string(p)
      sb.write_byte((41).to_byte())
    }
    Expr::Wildcard => sb.write_string("(*)")
    Expr::QualifiedWildcard(n) => {
      sb.write_string("(Q* ")
      write_object_name(sb, n)
      sb.write_byte((41).to_byte())
    }
    Expr::UnaryOp(op, e) => {
      sb.write_string("(Un ")
      match op {
        UnaryOperator::Plus => sb.write_string("+ ")
        UnaryOperator::Minus => sb.write_string("- ")
        UnaryOperator::Not => sb.write_string("NOT ")
        UnaryOperator::BitwiseNot => sb.write_string("~ ")
      }
      write_expr_ast(sb, e)
      sb.write_byte((41).to_byte())
    }
    Expr::BinaryOp(l, op, r) => {
      sb.write_string("(Bin")
      write_binary_op(sb, op)
      write_expr_ast(sb, l)
      sb.write_byte((32).to_byte())
      write_expr_ast(sb, r)
      sb.write_byte((41).to_byte())
    }
    Expr::Nested(e) => {
      sb.write_string("(Nest ")
      write_expr_ast(sb, e)
      sb.write_byte((41).to_byte())
    }
    Expr::Cast(e, dt, pg) => {
      sb.write_string(if pg { "(PgCast " } else { "(Cast " })
      write_expr_ast(sb, e)
      sb.write_byte((32).to_byte())
      write_data_type(sb, dt)
      sb.write_byte((41).to_byte())
    }
    _ => {
      sb.write_string("(E ")
      write_expr(sb, expr)
      sb.write_byte((41).to_byte())
    }
  }
}

fn stmt_eq_impl(a : Statement, b : Statement) -> Bool {
  if format_stmt(a) != format_stmt(b) {
    return false
  }
  match (a, b) {
    (Statement::Query(qa), Statement::Query(qb)) =>
    match (qa.body, qb.body) {
      (SetExpr::Select(sa), SetExpr::Select(sb)) => {
        if sa.projection.length() != sb.projection.length() {
          return false
        }
        let sba = StringBuilder::new()
        let sbb = StringBuilder::new()
        let mut i = 0
        while i < sa.projection.length() {
          match (sa.projection[i], sb.projection[i]) {
            (SelectItem::UnnamedExpr(ea), SelectItem::UnnamedExpr(eb)) |
            (SelectItem::ExprWithAlias(ea, _), SelectItem::ExprWithAlias(eb, _)) => {
              write_expr_ast(sba, ea)
              write_expr_ast(sbb, eb)
            }
            _ => ()
          }
          i = i + 1
        }
        sba.to_string() == sbb.to_string()
      }
      _ => true
    }
    _ => true
  }
}

fn stmts_eq_impl(a : Array[Statement], b : Array[Statement]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !stmt_eq_impl(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}
