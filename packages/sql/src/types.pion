///| Core types, dialect configuration, parser options, tokens, and errors for `sql`.

///| SQL dialect selection.
pub enum Dialect {
  Generic
  SQLite
  Postgres
}

///| Configurable parser and lexer options with resource limits.
pub struct ParseOptions {
  pub dialect : Dialect
  pub max_depth : Int
  pub max_tokens : Int
  pub max_nodes : Int
}

///| Default options using the `Generic` dialect (accepts both SQLite and PostgreSQL extensions).
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{
    dialect: Dialect::Generic,
    max_depth: 128,
    max_tokens: 500000,
    max_nodes: 1000000,
  }
}

///| Options configured for the SQLite dialect.
pub fn ParseOptions::sqlite() -> ParseOptions {
  ParseOptions::{
    dialect: Dialect::SQLite,
    max_depth: 128,
    max_tokens: 500000,
    max_nodes: 1000000,
  }
}

///| Options configured for the PostgreSQL dialect.
pub fn ParseOptions::postgres() -> ParseOptions {
  ParseOptions::{
    dialect: Dialect::Postgres,
    max_depth: 128,
    max_tokens: 500000,
    max_nodes: 1000000,
  }
}

///| Error returned when lexing or parsing SQL fails.
pub struct SqlError {
  pub line : Int
  pub col : Int
  pub offset : Int
  pub message : String
}

///| Construct a `SqlError`.
pub fn SqlError::new(
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> SqlError {
  SqlError::{ line: line, col: col, offset: offset, message: message }
}

///| Quoting style of a SQL identifier.
pub enum QuoteStyle {
  None
  DoubleQuote
  Backtick
  Bracket
}

///| Lexical token kind.
pub enum TokenKind {
  Keyword(String)
  Ident(String, QuoteStyle)
  Number(String)
  SingleQuotedString(String)
  EscapedString(String)
  DollarQuotedString(String, String)
  HexStringLiteral(String)
  Placeholder(String)
  LParen
  RParen
  LBracket
  RBracket
  Comma
  Semicolon
  Dot
  Colon
  DoubleColon
  Eq
  Neq
  Lt
  Gt
  LtEq
  GtEq
  Plus
  Minus
  Star
  Slash
  Percent
  Caret
  Concat
  Arrow
  DoubleArrow
  HashArrow
  HashDoubleArrow
  AtGt
  LtAt
  At
  PipeSlash
  Tilde
  TildeStar
  BangTilde
  BangTildeStar
  Amp
  Pipe
  LShift
  RShift
  Eof
}

///| A single lexical token with 1-based line/column and 0-based byte offset.
pub struct Token {
  pub kind : TokenKind
  pub line : Int
  pub col : Int
  pub offset : Int
  pub len : Int
}
