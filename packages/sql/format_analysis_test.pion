///| Formatting roundtrip (parse(to_sql(stmt)) AST equivalence), table extraction, placeholder extraction, and statement splitting.

fn assert_roundtrip(src : String, opts : ParseOptions) -> Unit {
  let stmt1 = assert_parse_one(src, opts)
  let formatted = to_sql(stmt1)
  debug_assert(formatted.length() > 0, "to_sql must be non-empty for: " + src)
  let stmt2 = assert_parse_one(formatted, opts)
  debug_assert(
    stmt_eq(stmt1, stmt2),
    "roundtrip AST mismatch!\n  orig: " + src + "\n  fmt : " + formatted,
  )
}

///|
test "format_roundtrip_ast_equivalence" {
  let cases = [
    "SELECT DISTINCT u.id, u.name AS user_name FROM users u LEFT JOIN orders o ON u.id = o.user_id WHERE o.total >= 100 AND u.name ILIKE '%alice%' GROUP BY u.id, u.name HAVING COUNT(*) > 1 ORDER BY u.id DESC NULLS LAST LIMIT 10 OFFSET 5",
    "WITH RECURSIVE t(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM t WHERE x < 10) SELECT x, SUM(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running FROM t",
    "SELECT CASE WHEN a > 0 THEN CAST(a AS NUMERIC(10, 2)) ELSE b::TEXT END, ARRAY[1, 2, 3][1], (x, y) = (1, 2) FROM metrics WHERE tag NOT IN ('a', 'b') AND score BETWEEN 10 AND 20",
    "INSERT INTO users (id, email) VALUES ($1, $2) ON CONFLICT (email) DO UPDATE SET id = excluded.id RETURNING id, email",
    "UPDATE orders SET status = 'done' FROM shipments s WHERE orders.id = s.order_id RETURNING orders.id",
    "DELETE FROM logs WHERE created_at < $1 RETURNING id",
    "CREATE TEMP TABLE IF NOT EXISTS items (id BIGSERIAL PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, price NUMERIC(10, 2) DEFAULT 0 CHECK (price >= 0))",
    "CREATE UNIQUE INDEX IF NOT EXISTS idx_items_user ON items (user_id ASC) WHERE price > 0",
    "ALTER TABLE items ADD COLUMN note TEXT DEFAULT ''",
    "DROP TABLE IF EXISTS old_items CASCADE",
    "EXPLAIN ANALYZE SELECT 1 + 2 * 3",
  ]
  let mut i = 0
  while i < cases.length() {
    assert_roundtrip(cases[i], ParseOptions::postgres())
    i = i + 1
  }
}

///|
test "analysis_extract_tables_with_ctes_joins_subqueries_dml" {
  let sql = "WITH active_u AS (SELECT id FROM public.users WHERE active = TRUE) SELECT u.id, o.total FROM active_u u INNER JOIN orders o ON u.id = o.user_id LEFT JOIN (SELECT order_id FROM payments) p ON o.id = p.order_id WHERE EXISTS (SELECT 1 FROM audit_log a WHERE a.user_id = u.id)"
  let stmt = assert_parse_one(sql, ParseOptions::postgres())
  let tables = extract_tables(stmt)
  // active_u is a CTE alias and must NOT be reported as a base table
  debug_assert(tables.length() == 4, "expected 4 tables, got " + tables.length().to_string())
  debug_assert(tables[0] == "public.users", "table 0")
  debug_assert(tables[1] == "orders", "table 1")
  debug_assert(tables[2] == "payments", "table 2")
  debug_assert(tables[3] == "audit_log", "table 3")

  let ins = assert_parse_one(
    "INSERT INTO archive_orders SELECT * FROM orders WHERE id = $1",
    ParseOptions::postgres(),
  )
  let ins_tables = extract_tables(ins)
  debug_assert(ins_tables.length() == 2, "2 tables in INSERT..SELECT")
  debug_assert(ins_tables[0] == "archive_orders" && ins_tables[1] == "orders", "insert tables")
}

///|
test "analysis_extract_placeholders_order_and_duplicates" {
  let sql = "SELECT * FROM orders WHERE user_id = $1 AND status = :status AND total > ? AND reviewer = $1 AND tenant = @tenant LIMIT $2"
  let stmt = assert_parse_one(sql, ParseOptions::default())
  let phs = extract_placeholders(stmt)
  debug_assert(phs.length() == 6, "6 placeholders")
  debug_assert(phs[0] == "$1", "ph 0")
  debug_assert(phs[1] == ":status", "ph 1")
  debug_assert(phs[2] == "?", "ph 2")
  debug_assert(phs[3] == "$1", "ph 3")
  debug_assert(phs[4] == "@tenant", "ph 4")
  debug_assert(phs[5] == "$2", "ph 5")
}

///|
test "analysis_split_statements_ignores_semicolons_in_strings_comments_dollar_quotes" {
  let script = "SELECT 'a;b'; -- comment ; here\n/* nested /* ; */ ; */ INSERT INTO t VALUES ($tag$hello;world$tag$); ;; DELETE FROM t WHERE x = 1;"
  match split_statements(script) {
    Ok(parts) => {
      debug_assert(parts.length() == 3, "expected 3 statements, got " + parts.length().to_string())
      match parse(script) {
        Ok(stmts) => debug_assert(stmts.length() == 3, "parse also yields 3 statements")
        Err(e) => debug_assert(false, "parse script failed: " + e.message)
      }
    }
    Err(e) => debug_assert(false, "split_statements failed: " + e.message)
  }
}
