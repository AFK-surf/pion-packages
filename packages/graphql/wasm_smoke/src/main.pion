///| Wasm32 + Native smoke entry for `packages/graphql`.

import "graphql"

///|
pub fn smoke() -> Int {
  let query = "query GetUser($id: ID! = \"1\") { user(id: $id) { ...UserFields } } fragment UserFields on User { id name }"
  let toks = match graphql::tokenize(query) {
    Ok(t) => t
    Err(_) => return 1
  }
  if toks.length() == 0 {
    return 2
  }
  let doc = match graphql::parse(query) {
    Ok(d) => d
    Err(_) => return 3
  }
  if doc.definitions.length() != 2 {
    return 4
  }
  let errs = graphql::validate_executable(doc)
  if errs.length() != 0 {
    return 5
  }
  let printed = graphql::print_document(doc)
  if printed.length() == 0 {
    return 6
  }
  let min = match graphql::minify_query(query) {
    Ok(m) => m
    Err(_) => return 7
  }
  if min.length() == 0 {
    return 8
  }
  let sdl = "\"\"\"\n  User type\n\"\"\"\ntype User implements Node { id: ID! name: String }"
  match graphql::parse(sdl) {
    Ok(sdoc) => {
      if sdoc.definitions.length() != 1 {
        return 9
      }
    }
    Err(_) => return 10
  }
  // Red-team deep nesting check inside Wasm32 (5,000 nested selection sets -> must Err cleanly, 0 trap)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 5000 {
    sb.write_string("{a")
    i = i + 1
  }
  i = 0
  while i < 5000 {
    sb.write_string("}")
    i = i + 1
  }
  match graphql::parse(sb.to_string()) {
    Ok(_) => return 11
    Err(e) => {
      if !graphql::error_kind_eq(e.kind, graphql::ErrorKind::LimitExceeded) {
        return 12
      }
    }
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
