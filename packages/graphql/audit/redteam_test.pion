///| Red-team regression tests for packages/graphql @ 5378e21 (branch feat/pkg-graphql).
///
/// `p0_*` / `p1_*` / `p2_*` tests assert what the reference implementations do (graphql-js
/// `graphql@16.10.0`, Rust `apollo-parser =0.8.4`) or what the GraphQL October 2021 spec text says;
/// every expectation was checked against node/oracle.js and rust/ (see REPORT.md) — a FAILURE here
/// is the evidence. `control_*` tests are attacks Pion survived (including places where Pion is
/// more correct or more robust than an oracle); they must keep passing.
/// The SIGSEGV on deep ASTs (P1-4) is NOT asserted here because it kills the whole test binary;
/// scripts/dos.py reproduces it in a child process.

import "graphql"

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn must_parse(src : String) -> graphql::Document {
  match graphql::parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "unexpected parse error: " + e.to_string())
      graphql::Document::{ definitions: [] }
    }
  }
}

///|
fn accepts(src : String) -> Bool {
  match graphql::parse(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///| first argument value of the first root field of the first operation
fn first_arg(doc : graphql::Document) -> graphql::Value {
  match doc.definitions[0] {
    graphql::Definition::Operation(op) =>
    match op.selection_set.selections[0] {
      graphql::Selection::Field(f) => f.arguments[0].value
      _ => graphql::Value::NullValue
    }
    _ => graphql::Value::NullValue
  }
}

///|
fn string_of(v : graphql::Value) -> String {
  match v {
    graphql::Value::StringValue(s, _) => s
    _ => "<not a string>"
  }
}

///| description of the first type definition
fn type_desc(doc : graphql::Document) -> String {
  match doc.definitions[0] {
    graphql::Definition::TypeDef(graphql::TypeDefinition::Object(o)) =>
    match o.description {
      Some(d) => d.value
      None => "<none>"
    }
    graphql::Definition::TypeDef(graphql::TypeDefinition::Scalar(o)) =>
    match o.description {
      Some(d) => d.value
      None => "<none>"
    }
    _ => "<not a type>"
  }
}

///| description of the first argument of the first field of the first object type
fn first_field_arg_desc(doc : graphql::Document) -> String {
  match doc.definitions[0] {
    graphql::Definition::TypeDef(graphql::TypeDefinition::Object(o)) =>
    match o.fields[0].arguments[0].description {
      Some(d) => d.value
      None => "<none>"
    }
    _ => "<not a type>"
  }
}

///|
fn has_kind(
  errs : Array[graphql::ValidationError],
  k : graphql::ValidationErrorKind,
) -> Bool {
  let mut i = 0
  while i < errs.length() {
    if graphql::validation_error_kind_eq(errs[i].kind, k) {
      return true
    }
    i = i + 1
  }
  false
}

// ============================================================================
// P0 — silent data corruption in print_document (README: "canonical, idempotent")
// ============================================================================

///| P0-1: a block string whose value starts with whitespace loses it after print → parse.
///| graphql-js printBlockString keeps `"""  a"""` on one line; Pion emits `"""\n  a\n"""`,
///| which §2.9.4 dedents back to "a".
test "p0_print_block_string_leading_spaces_lost" {
  let src = "{ f(x: \"\"\"  a\"\"\") }"
  let before = string_of(first_arg(must_parse(src)))
  debug_assert(before == "  a", "parser keeps the value: " + before)
  let printed = graphql::print_document(must_parse(src))
  let after = string_of(first_arg(must_parse(printed)))
  debug_assert(
    after == before,
    "print_document changed a block string value from '" +
    before +
    "' to '" +
    after +
    "'; printed=" +
    printed,
  )
}

///| P0-1b: same corruption on a type description (`"""  Leading"""` → "Leading") and with a tab.
test "p0_print_block_description_leading_whitespace_lost" {
  let src = "\"\"\"\tTabbed doc\"\"\"\ntype T { a: Int }"
  let before = type_desc(must_parse(src))
  let after = type_desc(must_parse(graphql::print_document(must_parse(src))))
  debug_assert(
    after == before,
    "description changed: '" + before + "' -> '" + after + "'",
  )
}

///| P0-1c: print is not idempotent (README claim) — every print strips one more indentation level.
test "p0_print_not_idempotent" {
  let src = "{ f(x: \"\"\"    deep\"\"\") }"
  let p1 = graphql::print_document(must_parse(src))
  let p2 = graphql::print_document(must_parse(p1))
  debug_assert(p1 == p2, "print(parse(print(x))) != print(x):\n" + p1 + "\n---\n" + p2)
}

///| P0-2: argument descriptions are silently dropped by print_document (field args).
test "p0_print_drops_field_argument_description" {
  let src = "type T {\n  f(\n    \"how many\"\n    first: Int\n  ): Int\n}"
  let before = first_field_arg_desc(must_parse(src))
  debug_assert(before == "how many", "parser keeps it: " + before)
  let printed = graphql::print_document(must_parse(src))
  let after = first_field_arg_desc(must_parse(printed))
  debug_assert(
    after == before,
    "argument description lost; printed=" + printed,
  )
}

///| P0-2b: directive-definition argument descriptions are dropped too.
test "p0_print_drops_directive_argument_description" {
  let src = "directive @cost(\"\"\"weight\"\"\" w: Int) on FIELD"
  let printed = graphql::print_document(must_parse(src))
  debug_assert(contains(printed, "weight"), "printed=" + printed)
}

// ============================================================================
// P1 — October 2021 spec deviations and validation gaps
// ============================================================================

///| P1-1: U+007F (DEL) is a SourceCharacter in Oct 2021 (/[\u0009\u000A\u000D\u0020-\uFFFF]/);
///| graphql-js and apollo-parser accept it. Pion rejects it in comments, strings and block strings.
test "p1_del_in_comment_rejected" {
  debug_assert(accepts("# rm\u{7f}\n{ a }"), "DEL in a comment must be accepted")
}

///|
test "p1_del_in_string_rejected" {
  debug_assert(accepts("{ f(x: \"a\u{7f}b\") }"), "DEL in a string must be accepted")
}

///|
test "p1_del_in_block_string_rejected" {
  debug_assert(
    accepts("{ f(x: \"\"\"a\u{7f}b\"\"\") }"),
    "DEL in a block string must be accepted",
  )
}

///| P1-2: ExecutableDefinitions — SDL in an executable document passes validate_executable.
test "p1_validate_accepts_sdl_in_executable_document" {
  let errs = graphql::validate_executable(
    must_parse("type Evil { a: Int } schema { query: Evil } { a }"),
  )
  debug_assert(
    errs.length() > 0,
    "graphql-js ExecutableDefinitionsRule rejects this document; Pion reports 0 errors",
  )
}

///| P1-3: NoUndefinedVariables — `$v` is used but never declared (also through a fragment).
test "p1_validate_misses_undefined_variable" {
  let errs = graphql::validate_executable(must_parse("query Q { a(x: $v) }"))
  debug_assert(errs.length() > 0, "undefined variable $v not reported")
}

///|
test "p1_validate_misses_undefined_variable_via_fragment" {
  let errs = graphql::validate_executable(
    must_parse(
      "query A($v: Int) { ...F } query B { ...F } fragment F on T { a(x: $v) }",
    ),
  )
  debug_assert(errs.length() > 0, "$v undefined in operation B not reported")
}

// ============================================================================
// P2 — edge / functional gaps
// ============================================================================

///| P2-1: NoUnusedVariables.
test "p2_validate_misses_unused_variable" {
  let errs = graphql::validate_executable(must_parse("query Q($v: Int) { a }"))
  debug_assert(errs.length() > 0, "unused $v not reported")
}

///| P2-2: NoUnusedFragments.
test "p2_validate_misses_unused_fragment" {
  let errs = graphql::validate_executable(
    must_parse("{ a } fragment F on T { b }"),
  )
  debug_assert(errs.length() > 0, "unused fragment F not reported")
}

///| P2-3: UniqueDirectivesPerLocation for the built-in non-repeatable @skip / @include.
test "p2_validate_misses_duplicate_skip" {
  let errs = graphql::validate_executable(
    must_parse("{ a @skip(if: true) @skip(if: false) }"),
  )
  debug_assert(errs.length() > 0, "duplicate @skip not reported")
}

///| P2-4: the body of a duplicate fragment definition is never walked, so its limits and
///| unknown spreads are invisible (graphql-js still reports KnownFragmentNames inside it).
test "p2_validate_skips_duplicate_fragment_body" {
  let errs = graphql::validate_executable(
    must_parse(
      "{ ...F } fragment F on T { a } fragment F on T { ...DoesNotExist }",
    ),
  )
  debug_assert(
    has_kind(errs, graphql::ValidationErrorKind::DuplicateFragmentName),
    "duplicate reported",
  )
  debug_assert(
    has_kind(errs, graphql::ValidationErrorKind::UndefinedFragment),
    "unknown spread inside the second F is not reported",
  )
}

///| P2-5: README says minify_query matches stripIgnoredCharacters byte-for-byte; block strings are
///| copied verbatim (graphql-js re-prints them minimized: `"""a\nb"""`).
test "p2_minify_block_string_not_minimized" {
  let src = "{ f(x: \"\"\"\n      a\n      b\n    \"\"\") }"
  let m = match graphql::minify_query(src) {
    Ok(s) => s
    Err(e) => "ERR " + e.to_string()
  }
  debug_assert(
    m == "{f(x:\"\"\"a\nb\"\"\")}",
    "minify kept block string indentation: " + m,
  )
}

///| P2-6: `\u{...}` with more than 8 hex digits: graphql-js and apollo-parser reject
///| (`\u{000000041}`), Pion accepts. (Oct 2021 itself has only `\uXXXX`.)
test "p2_variable_unicode_escape_over_8_digits_accepted" {
  debug_assert(
    !accepts("{ f(x: \"\\u{000000041}\") }"),
    "9-digit \\u{...} escape accepted",
  )
}

///| P2-7: a 2 MB realistic SDL (the package's own W1 benchmark corpus shape) exceeds the default
///| max_tokens = 500,000; bench/pion_bench silently raises it to 5,000,000 for W1.
test "p2_default_max_tokens_rejects_realistic_large_schema" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 15000 {
    sb.write_string("\"\"\"doc\"\"\"\ntype T")
    sb.write_string(i.to_string())
    sb.write_string(
      " implements Node @key(fields: \"id\") { id: ID! name(first: Int = 10, after: String): [Edge!]! createdAt: DateTime }\n",
    )
    i = i + 1
  }
  let src = sb.to_string()
  match graphql::parse(src) {
    Ok(_) => ()
    Err(e) =>
    debug_assert(
      false,
      src.length().to_string() + " byte SDL rejected by defaults: " + e.to_string(),
    )
  }
}

// ============================================================================
// Controls — attacks Pion survived (must pass)
// ============================================================================

///| Diamond fragment bomb: 26 levels, ~1.7 KB of text, 2^26 expanded fields. O(V+E) DP + cap.
test "control_diamond_fragment_bomb_detected_fast" {
  let sb = StringBuilder::new()
  sb.write_string("query Q { ...F0 }\n")
  let mut i = 0
  while i < 26 {
    sb.write_string(
      "fragment F" +
      i.to_string() +
      " on T { a1: f { ...F" +
      (i + 1).to_string() +
      " } a2: f { ...F" +
      (i + 1).to_string() +
      " } }\n",
    )
    i = i + 1
  }
  sb.write_string("fragment F26 on T { a1: f a2: f }\n")
  let errs = graphql::validate_executable(must_parse(sb.to_string()))
  debug_assert(
    has_kind(errs, graphql::ValidationErrorKind::MaxFieldsExceeded),
    "fields",
  )
  debug_assert(
    has_kind(errs, graphql::ValidationErrorKind::MaxAliasesExceeded),
    "aliases",
  )
  debug_assert(
    !has_kind(errs, graphql::ValidationErrorKind::FragmentCycle),
    "a DAG is not a cycle",
  )
}

///|
test "control_fragment_cycles_inline_and_self" {
  let a = graphql::validate_executable(must_parse("{ ...A } fragment A on T { ...A }"))
  debug_assert(has_kind(a, graphql::ValidationErrorKind::FragmentCycle), "self")
  let b = graphql::validate_executable(
    must_parse(
      "{ ...A } fragment A on T { ... on T { ...B } } fragment B on T { ...A }",
    ),
  )
  debug_assert(has_kind(b, graphql::ValidationErrorKind::FragmentCycle), "via inline")
}

///| Oct 2021 SourceCharacter excludes C0 controls other than TAB/LF/CR: Pion is spec-correct here,
///| graphql-js 16 / apollo-parser follow the later full-Unicode draft and accept them.
test "control_c0_controls_rejected_per_oct2021" {
  debug_assert(!accepts("# \u{7}\n{ a }"), "BEL in comment")
  debug_assert(!accepts("{ f(x: \"\u{0}\") }"), "NUL in string")
  debug_assert(!accepts("{ f(x: \"\"\"\u{b}\"\"\") }"), "VT in block string")
}

///|
test "control_keyword_contexts" {
  debug_assert(!accepts("fragment on on T { a }"), "fragment named on")
  debug_assert(!accepts("enum E { true }"), "enum value true")
  debug_assert(!accepts("enum E { null }"), "enum value null")
  debug_assert(accepts("{ query fragment on: a true }"), "keywords as field names")
  debug_assert(accepts("query on { a }"), "operation named on")
  debug_assert(!accepts("\"d\" extend type T @x"), "description on extend")
  debug_assert(!accepts("type T {}"), "empty fields")
  debug_assert(accepts("type T"), "no fields")
  debug_assert(accepts("type T implements & A & B { a: Int }"), "leading &")
  debug_assert(accepts("union U = | A | B"), "leading |")
}

///|
test "control_empty_lists_and_const_values" {
  debug_assert(!accepts("{ f() }"), "f()")
  debug_assert(!accepts("{ f @d() }"), "@d()")
  debug_assert(!accepts("query Q() { a }"), "Q()")
  debug_assert(!accepts("{ a {} }"), "{}")
  debug_assert(!accepts("query Q($x: Int = $y) { a }"), "var default")
  debug_assert(!accepts("input I { a: Int = $x }"), "input default")
  debug_assert(!accepts("type T @d(a: $x) { a: Int }"), "SDL directive")
  debug_assert(!accepts(""), "empty document")
}

///|
test "control_numbers_and_escapes" {
  debug_assert(accepts("{ f(x: -0) }"), "-0")
  debug_assert(accepts("{ f(x: -0.0) }"), "-0.0")
  debug_assert(!accepts("{ f(x: -00) }"), "-00")
  debug_assert(!accepts("{ f(x: 123a) }"), "123a")
  debug_assert(!accepts("{ f(x: 1.0.2) }"), "1.0.2")
  debug_assert(!accepts("{ f(x: [1...]) }"), "1...")
  debug_assert(!accepts("{ f(x: \"\\uD800\") }"), "lone high")
  debug_assert(!accepts("{ f(x: \"\\uD800\\u0041\") }"), "high + non-low")
  debug_assert(!accepts("{ f(x: \"\\uD83D\\u{DE00}\") }"), "mixed pair")
  debug_assert(!accepts("{ f(x: \"\\u{110000}\") }"), "> 10FFFF")
  debug_assert(!accepts("{ f(x: \"\\u{D800}\") }"), "var-width surrogate")
  let v = string_of(first_arg(must_parse("{ f(x: \"\\uD83D\\uDE00\") }")))
  debug_assert(v == "\u{1F600}", "surrogate pair combined")
}

///|
test "control_block_string_dedent" {
  let v = string_of(
    first_arg(
      must_parse("{ f(x: \"\"\"\r\n    a\r\n      b\r\n    \"\"\") }"),
    ),
  )
  debug_assert(v == "a\n  b", "CRLF + common indent: " + v)
  let w = string_of(first_arg(must_parse("{ f(x: \"\"\"x\\\"\"\"y\"\"\") }")))
  debug_assert(w == "x\"\"\"y", "escaped triple quote: " + w)
}

///| Minify never glues tokens (`...on`, numbers, names, strings).
test "control_minify_no_token_gluing" {
  let src = "query Q($a: Int = 1, $b: Float = 1.5e2) { f(x: 1 y: \"s\" z: [1 2 3] w: ENUM) ... on T { a } ...F @d(x: 1.0) }"
  let m = match graphql::minify_query(src) {
    Ok(s) => s
    Err(e) => "ERR " + e.to_string()
  }
  let p1 = graphql::print_document(must_parse(src))
  let p2 = graphql::print_document(must_parse(m))
  debug_assert(p1 == p2, "minified changed meaning: " + m)
}

///| Default limits stop 50k-level nesting with an error (no crash) — graphql-js overflows its
///| JS stack on the same input (RangeError), apollo-parser stops at recursion_limit 500.
test "control_default_limits_stop_deep_nesting" {
  match graphql::parse(repeat("{a", 50000) + repeat("}", 50000)) {
    Err(e) =>
    debug_assert(graphql::error_kind_eq(e.kind, graphql::ErrorKind::LimitExceeded), "limit")
    Ok(_) => debug_assert(false, "accepted")
  }
}

///| 60k distinct argument names / input fields: seeded runtime hash keeps validation linear.
test "control_hash_heavy_validation" {
  let sb = StringBuilder::new()
  sb.write_string("{ f(")
  let mut i = 0
  while i < 60000 {
    sb.write_string("a" + i.to_string() + ": 1 ")
    i = i + 1
  }
  sb.write_string(") }")
  let errs = graphql::validate_executable(must_parse(sb.to_string()))
  debug_assert(errs.length() == 0, "no duplicates")
}

///| Invalid / truncated UTF-8 rejected by parse_bytes.
test "control_invalid_utf8_rejected" {
  let bad : Array[Array[Int]] = [
    [123, 32, 0xC3],
    [0xED, 0xA0, 0x80],
    [0xF4, 0x90, 0x80, 0x80],
    [0xC0, 0xAF],
    [0xFF],
  ]
  let mut i = 0
  while i < bad.length() {
    let b = Bytes::new(bad[i].length())
    let mut j = 0
    while j < bad[i].length() {
      b[j] = bad[i][j].to_byte()
      j = j + 1
    }
    match graphql::parse_bytes(b) {
      Err(e) =>
      debug_assert(
        graphql::error_kind_eq(e.kind, graphql::ErrorKind::InvalidUtf8),
        "case " + i.to_string() + ": " + e.to_string(),
      )
      Ok(_) => debug_assert(false, "case " + i.to_string() + " accepted")
    }
    i = i + 1
  }
}

///| P2-8: error columns count UTF-8 bytes; graphql-js (and editors / LSPs) count characters
///| (`{ f(x: "ééé") ! }` → graphql-js column 15, Pion column 18).
test "p2_error_column_counts_utf8_bytes" {
  match graphql::parse("{ f(x: \"ééé\") ! }") {
    Err(e) => debug_assert(e.col == 15, "column " + e.col.to_string())
    Ok(_) => debug_assert(false, "accepted")
  }
}
