///| Red-team differential probe for `packages/graphql` (batch, length-framed I/O).
///|
///| Input records: `<len>\n<bytes>` repeated. Output records: `<len>\n<bytes>` repeated.
///|   tok    <in> <out> : `tokenize` canonical dump (`KIND len:value` items) or `ERR`
///|   tokb   <in> <out> : `tokenize_bytes` canonical dump or `ERR`
///|   parse  <in> <out> : `parse` canonical AST dump (shared with node/oracle.js) or `ERR`
///|   parseb <in> <out> : `parse_bytes` canonical AST dump or `ERR`
///|   min    <in> <out> : `minify_query` or `ERR`
///|   print  <in> <out> : `print_document(parse(..))` or `ERR`
///|   valid  <in> <out> : sorted `validate_executable(parse(..))` kinds, `OK`, or `ERR`
///|   one    <in> <sub> [reps] : run `sub` (tok|count|parse|min|print|valid|deep) on the whole file `reps` times

import "graphql"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_dec(src, ls, i)
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///| `<len>:<bytes>` — unambiguous string framing used by every dump.
fn ws(sb : StringBuilder, s : String) -> Unit {
  sb.write_string(s.length().to_string())
  sb.write_byte((58).to_byte())
  sb.write_string(s)
}

///|
fn item(sb : StringBuilder, kind : String, v : String) -> Unit {
  sb.write_string(kind)
  sb.write_byte((32).to_byte())
  ws(sb, v)
}

///|
fn err_str(e : graphql::GraphqlError) -> String {
  "ERR " + e.to_string()
}

///|
fn dump_tokens(toks : Array[graphql::Token]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < toks.length() {
    match toks[i].kind {
      graphql::TokenKind::Bang => item(sb, "P", "!")
      graphql::TokenKind::Dollar => item(sb, "P", "$")
      graphql::TokenKind::Amp => item(sb, "P", "&")
      graphql::TokenKind::LParen => item(sb, "P", "(")
      graphql::TokenKind::RParen => item(sb, "P", ")")
      graphql::TokenKind::Spread => item(sb, "P", "...")
      graphql::TokenKind::Colon => item(sb, "P", ":")
      graphql::TokenKind::Equals => item(sb, "P", "=")
      graphql::TokenKind::At => item(sb, "P", "@")
      graphql::TokenKind::LBracket => item(sb, "P", "[")
      graphql::TokenKind::RBracket => item(sb, "P", "]")
      graphql::TokenKind::LBrace => item(sb, "P", "{")
      graphql::TokenKind::Pipe => item(sb, "P", "|")
      graphql::TokenKind::RBrace => item(sb, "P", "}")
      graphql::TokenKind::Name(s) => item(sb, "Name", s)
      graphql::TokenKind::Int(s) => item(sb, "Int", s)
      graphql::TokenKind::Float(s) => item(sb, "Float", s)
      graphql::TokenKind::Str(s) => item(sb, "String", s)
      graphql::TokenKind::BlockStr(s) => item(sb, "BlockString", s)
      graphql::TokenKind::Eof => ()
    }
    i = i + 1
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------
// Canonical AST dump (mirrored exactly by node/oracle.js `dumpDoc`)
// ---------------------------------------------------------------------------

///|
fn d_opt_name(sb : StringBuilder, n : Option[String]) -> Unit {
  match n {
    Some(s) => ws(sb, s)
    None => sb.write_string("-")
  }
}

///|
fn d_type(sb : StringBuilder, t : graphql::TypeRef) -> Unit {
  match t {
    graphql::TypeRef::Named(n) => ws(sb, n)
    graphql::TypeRef::List(inner) => {
      sb.write_string("[")
      d_type(sb, inner)
      sb.write_string("]")
    }
    graphql::TypeRef::NonNull(inner) => {
      d_type(sb, inner)
      sb.write_string("!")
    }
  }
}

///|
fn d_value(sb : StringBuilder, v : graphql::Value) -> Unit {
  match v {
    graphql::Value::Variable(n) => {
      sb.write_string("$")
      ws(sb, n)
    }
    graphql::Value::IntValue(s) => {
      sb.write_string("i")
      ws(sb, s)
    }
    graphql::Value::FloatValue(s) => {
      sb.write_string("f")
      ws(sb, s)
    }
    graphql::Value::StringValue(s, b) => {
      sb.write_string(if b { "B" } else { "s" })
      ws(sb, s)
    }
    graphql::Value::BooleanValue(b) =>
    sb.write_string(if b { "true" } else { "false" })
    graphql::Value::NullValue => sb.write_string("null")
    graphql::Value::EnumValue(s) => {
      sb.write_string("e")
      ws(sb, s)
    }
    graphql::Value::ListValue(items) => {
      sb.write_string("[")
      let mut i = 0
      while i < items.length() {
        d_value(sb, items[i])
        sb.write_string(" ")
        i = i + 1
      }
      sb.write_string("]")
    }
    graphql::Value::ObjectValue(fields) => {
      sb.write_string("{")
      let mut i = 0
      while i < fields.length() {
        ws(sb, fields[i].name)
        sb.write_string("=")
        d_value(sb, fields[i].value)
        sb.write_string(" ")
        i = i + 1
      }
      sb.write_string("}")
    }
  }
}

///|
fn d_args(sb : StringBuilder, args : Array[graphql::Argument]) -> Unit {
  sb.write_string("(")
  let mut i = 0
  while i < args.length() {
    ws(sb, args[i].name)
    sb.write_string("=")
    d_value(sb, args[i].value)
    sb.write_string(" ")
    i = i + 1
  }
  sb.write_string(")")
}

///|
fn d_dirs(sb : StringBuilder, dirs : Array[graphql::Directive]) -> Unit {
  sb.write_string("<")
  let mut i = 0
  while i < dirs.length() {
    sb.write_string("@")
    ws(sb, dirs[i].name)
    d_args(sb, dirs[i].arguments)
    i = i + 1
  }
  sb.write_string(">")
}

///|
fn d_ss(sb : StringBuilder, ss : graphql::SelectionSet) -> Unit {
  sb.write_string("{")
  let mut i = 0
  while i < ss.selections.length() {
    match ss.selections[i] {
      graphql::Selection::Field(f) => {
        sb.write_string("(F ")
        d_opt_name(sb, f.alias)
        sb.write_string(" ")
        ws(sb, f.name)
        d_args(sb, f.arguments)
        d_dirs(sb, f.directives)
        match f.selection_set {
          Some(sub) => d_ss(sb, sub)
          None => sb.write_string("-")
        }
        sb.write_string(")")
      }
      graphql::Selection::FragmentSpread(fs) => {
        sb.write_string("(S ")
        ws(sb, fs.name)
        d_dirs(sb, fs.directives)
        sb.write_string(")")
      }
      graphql::Selection::InlineFragment(inf) => {
        sb.write_string("(I ")
        d_opt_name(sb, inf.type_condition)
        d_dirs(sb, inf.directives)
        d_ss(sb, inf.selection_set)
        sb.write_string(")")
      }
    }
    i = i + 1
  }
  sb.write_string("}")
}

///|
fn d_desc(sb : StringBuilder, d : Option[graphql::Description]) -> Unit {
  match d {
    Some(x) => {
      sb.write_string(if x.is_block { "B" } else { "s" })
      ws(sb, x.value)
    }
    None => sb.write_string("-")
  }
}

///|
fn d_ivs(sb : StringBuilder, ivs : Array[graphql::InputValueDefinition]) -> Unit {
  sb.write_string("(")
  let mut i = 0
  while i < ivs.length() {
    let iv = ivs[i]
    sb.write_string("(iv ")
    d_desc(sb, iv.description)
    sb.write_string(" ")
    ws(sb, iv.name)
    sb.write_string(" ")
    d_type(sb, iv.value_type)
    sb.write_string(" ")
    match iv.default_value {
      Some(v) => d_value(sb, v)
      None => sb.write_string("-")
    }
    d_dirs(sb, iv.directives)
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string(")")
}

///|
fn d_names(sb : StringBuilder, xs : Array[String]) -> Unit {
  sb.write_string("[")
  let mut i = 0
  while i < xs.length() {
    ws(sb, xs[i])
    i = i + 1
  }
  sb.write_string("]")
}

///|
fn d_fields(sb : StringBuilder, fs : Array[graphql::FieldDefinition]) -> Unit {
  sb.write_string("{")
  let mut i = 0
  while i < fs.length() {
    let f = fs[i]
    sb.write_string("(fd ")
    d_desc(sb, f.description)
    sb.write_string(" ")
    ws(sb, f.name)
    d_ivs(sb, f.arguments)
    d_type(sb, f.field_type)
    d_dirs(sb, f.directives)
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string("}")
}

///|
fn d_enum_vals(sb : StringBuilder, vs : Array[graphql::EnumValueDefinition]) -> Unit {
  sb.write_string("{")
  let mut i = 0
  while i < vs.length() {
    sb.write_string("(ev ")
    d_desc(sb, vs[i].description)
    sb.write_string(" ")
    ws(sb, vs[i].name)
    d_dirs(sb, vs[i].directives)
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string("}")
}

///|
fn d_op_types(sb : StringBuilder, ots : Array[graphql::OperationTypeDefinition]) -> Unit {
  sb.write_string("{")
  let mut i = 0
  while i < ots.length() {
    sb.write_string(graphql::operation_type_to_string(ots[i].op_type))
    sb.write_string("=")
    ws(sb, ots[i].named_type)
    sb.write_string(" ")
    i = i + 1
  }
  sb.write_string("}")
}

///|
fn dump_doc(doc : graphql::Document) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < doc.definitions.length() {
    match doc.definitions[i] {
      graphql::Definition::Operation(op) => {
        sb.write_string("(op ")
        sb.write_string(graphql::operation_type_to_string(op.op_type))
        sb.write_string(" ")
        d_opt_name(sb, op.name)
        sb.write_string(" (")
        let mut v = 0
        while v < op.variable_definitions.length() {
          let vd = op.variable_definitions[v]
          sb.write_string("(var ")
          ws(sb, vd.name)
          sb.write_string(" ")
          d_type(sb, vd.var_type)
          sb.write_string(" ")
          match vd.default_value {
            Some(dv) => d_value(sb, dv)
            None => sb.write_string("-")
          }
          d_dirs(sb, vd.directives)
          sb.write_string(")")
          v = v + 1
        }
        sb.write_string(")")
        d_dirs(sb, op.directives)
        d_ss(sb, op.selection_set)
        sb.write_string(")")
      }
      graphql::Definition::Fragment(fr) => {
        sb.write_string("(frag ")
        ws(sb, fr.name)
        sb.write_string(" ")
        ws(sb, fr.type_condition)
        d_dirs(sb, fr.directives)
        d_ss(sb, fr.selection_set)
        sb.write_string(")")
      }
      graphql::Definition::Schema(s) => {
        sb.write_string("(schema ")
        d_desc(sb, s.description)
        d_dirs(sb, s.directives)
        d_op_types(sb, s.operation_types)
        sb.write_string(")")
      }
      graphql::Definition::SchemaExtension(s) => {
        sb.write_string("(xschema ")
        d_dirs(sb, s.directives)
        d_op_types(sb, s.operation_types)
        sb.write_string(")")
      }
      graphql::Definition::DirectiveDef(dd) => {
        sb.write_string("(directive ")
        d_desc(sb, dd.description)
        sb.write_string(" ")
        ws(sb, dd.name)
        d_ivs(sb, dd.arguments)
        sb.write_string(if dd.repeatable { " rep " } else { " - " })
        d_names(sb, dd.locations)
        sb.write_string(")")
      }
      graphql::Definition::TypeDef(td) =>
      match td {
        graphql::TypeDefinition::Scalar(x) => {
          sb.write_string("(scalar ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          sb.write_string(")")
        }
        graphql::TypeDefinition::Object(x) => {
          sb.write_string("(type ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_names(sb, x.implements_interfaces)
          d_dirs(sb, x.directives)
          d_fields(sb, x.fields)
          sb.write_string(")")
        }
        graphql::TypeDefinition::Interface(x) => {
          sb.write_string("(interface ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_names(sb, x.implements_interfaces)
          d_dirs(sb, x.directives)
          d_fields(sb, x.fields)
          sb.write_string(")")
        }
        graphql::TypeDefinition::Union(x) => {
          sb.write_string("(union ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_names(sb, x.members)
          sb.write_string(")")
        }
        graphql::TypeDefinition::Enum(x) => {
          sb.write_string("(enum ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_enum_vals(sb, x.values)
          sb.write_string(")")
        }
        graphql::TypeDefinition::InputObject(x) => {
          sb.write_string("(input ")
          d_desc(sb, x.description)
          sb.write_string(" ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_ivs(sb, x.fields)
          sb.write_string(")")
        }
      }
      graphql::Definition::TypeExtension(te) =>
      match te {
        graphql::TypeExtension::Scalar(x) => {
          sb.write_string("(xscalar ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          sb.write_string(")")
        }
        graphql::TypeExtension::Object(x) => {
          sb.write_string("(xtype ")
          ws(sb, x.name)
          d_names(sb, x.implements_interfaces)
          d_dirs(sb, x.directives)
          d_fields(sb, x.fields)
          sb.write_string(")")
        }
        graphql::TypeExtension::Interface(x) => {
          sb.write_string("(xinterface ")
          ws(sb, x.name)
          d_names(sb, x.implements_interfaces)
          d_dirs(sb, x.directives)
          d_fields(sb, x.fields)
          sb.write_string(")")
        }
        graphql::TypeExtension::Union(x) => {
          sb.write_string("(xunion ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_names(sb, x.members)
          sb.write_string(")")
        }
        graphql::TypeExtension::Enum(x) => {
          sb.write_string("(xenum ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_enum_vals(sb, x.values)
          sb.write_string(")")
        }
        graphql::TypeExtension::InputObject(x) => {
          sb.write_string("(xinput ")
          ws(sb, x.name)
          d_dirs(sb, x.directives)
          d_ivs(sb, x.fields)
          sb.write_string(")")
        }
      }
    }
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///|
fn valid_dump(doc : graphql::Document) -> String {
  let errs = graphql::validate_executable(doc)
  if errs.length() == 0 {
    return "OK"
  }
  let kinds : Array[String] = []
  let mut i = 0
  while i < errs.length() {
    kinds.push(graphql::validation_error_kind_to_string(errs[i].kind))
    i = i + 1
  }
  // insertion sort (tiny arrays)
  let mut a = 1
  while a < kinds.length() {
    let mut b = a
    while b > 0 && kinds[b - 1] > kinds[b] {
      let t = kinds[b - 1]
      kinds[b - 1] = kinds[b]
      kinds[b] = t
      b = b - 1
    }
    a = a + 1
  }
  // unique kinds only: graphql-js reports one error per duplicate *group*, Pion one per extra copy
  let sb = StringBuilder::new()
  i = 0
  while i < kinds.length() {
    if i == 0 || kinds[i] != kinds[i - 1] {
      if i > 0 {
        sb.write_string(",")
      }
      sb.write_string(kinds[i])
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn run_one(mode : String, rec : String) -> String {
  if mode == "tok" {
    match graphql::tokenize(rec) {
      Ok(t) => dump_tokens(t)
      Err(e) => err_str(e)
    }
  } else if mode == "tokb" {
    match graphql::tokenize_bytes(rec.to_bytes()) {
      Ok(t) => dump_tokens(t)
      Err(e) => err_str(e)
    }
  } else if mode == "parse" {
    match graphql::parse(rec) {
      Ok(d) => dump_doc(d)
      Err(e) => err_str(e)
    }
  } else if mode == "parseb" {
    match graphql::parse_bytes(rec.to_bytes()) {
      Ok(d) => dump_doc(d)
      Err(e) => err_str(e)
    }
  } else if mode == "min" {
    match graphql::minify_query(rec) {
      Ok(s) => s
      Err(e) => err_str(e)
    }
  } else if mode == "print" {
    match graphql::parse(rec) {
      Ok(d) => graphql::print_document(d)
      Err(e) => err_str(e)
    }
  } else if mode == "valid" {
    match graphql::parse(rec) {
      Ok(d) => valid_dump(d)
      Err(e) => err_str(e)
    }
  } else {
    "ERR unknown mode"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe tok|tokb|parse|parseb|min|print|valid|one <in> ...")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  if mode == "one" {
    let sub = args[3]
    let reps = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      1
    }
    // big budgets so that the DoS probes measure the algorithm, not the default caps
    let big = graphql::ParseOptions::new(100000000, 100000000, 100000000)
    let mut total = 0
    let mut r = 0
    while r < reps {
      if sub == "count" {
        match graphql::count_tokens(src) {
          Ok(c) => total = total + c
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else if sub == "tok" {
        match graphql::tokenize_with_options(src, big) {
          Ok(t) => total = total + t.length()
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else if sub == "parse" || sub == "parsedef" {
        let o = if sub == "parse" {
          big
        } else {
          graphql::ParseOptions::default()
        }
        match graphql::parse_with_options(src, o) {
          Ok(d) => total = total + d.definitions.length()
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else if sub == "min" {
        match graphql::minify_query_with_options(src, big) {
          Ok(s) => total = total + s.length()
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else if sub == "print" {
        match graphql::parse_with_options(src, big) {
          Ok(d) => total = total + graphql::print_document(d).length()
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else if sub == "valid" {
        match graphql::parse_with_options(src, big) {
          Ok(d) => {
            let errs = graphql::validate_executable(d)
            total = total + errs.length()
            if r == 0 {
              io_println(world, "valid " + valid_dump(d))
            }
          }
          Err(e) => {
            io_println(world, err_str(e))
            return 0
          }
        }
      } else {
        io_eprintln(world, "unknown sub " + sub)
        return 2
      }
      r = r + 1
    }
    io_println(world, "ok " + total.to_string())
    return 0
  }
  let out_path = args[3]
  let recs = read_records(src)
  let out = StringBuilder::with_capacity(src.length() * 2 + 64)
  let mut i = 0
  while i < recs.length() {
    emit(out, run_one(mode, recs[i]))
    i = i + 1
  }
  match fs_write(world, out_path, out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      1
    }
  }
}
