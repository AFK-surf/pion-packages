fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y
    (None, None) => true
    _ => false
  }
}

///| GraphQL October 2021 Parser compliance tests (Kitchen Sink Query + Kitchen Sink SDL + edge cases).

fn parse_ok(name : String, src : String) -> Document {
  match parse(src) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, "[" + name + "] unexpected parse error: " + e.to_string())
      Document::{ definitions: [] }
    }
  }
}

fn parse_err(name : String, src : String) -> GraphqlError {
  match parse(src) {
    Ok(_) => {
      debug_assert(false, "[" + name + "] expected parse error, got Ok")
      GraphqlError::new(ErrorKind::InvalidSyntax, 0, 0, 0, "")
    }
    Err(e) => {
      debug_assert(
        !error_kind_eq(e.kind, ErrorKind::Unimplemented),
        "[" + name + "] got Unimplemented instead of real parse error",
      )
      e
    }
  }
}

///|
test "parser__kitchen_sink_query" {
  // Ported from graphql-js kitchen-sink.graphql
  let kitchen_sink = "# Copyright (c) GraphQL Contributors\n" +
  "query queryName($foo: ComplexType, $site: Site = MOBILE) @onQuery {\n" +
  "  whoever123is: node(id: [123, 456]) {\n" +
  "    id\n" +
  "    ... on User @onInlineFragment {\n" +
  "      field2 {\n" +
  "        id\n" +
  "        alias: field1(first: 10, after: $foo) @include(if: $foo) {\n" +
  "          id\n" +
  "          ...frag @onFragmentSpread\n" +
  "        }\n" +
  "      }\n" +
  "    }\n" +
  "    ... @skip(unless: $foo) {\n" +
  "      id\n" +
  "    }\n" +
  "    ... {\n" +
  "      id\n" +
  "    }\n" +
  "  }\n" +
  "}\n" +
  "mutation likeStory @onMutation {\n" +
  "  like(story: 123) @onField {\n" +
  "    story {\n" +
  "      id @onField\n" +
  "    }\n" +
  "  }\n" +
  "}\n" +
  "subscription StoryLikeSubscription($input: StoryLikeSubscribeInput @onVariableDefinition) @onSubscription {\n" +
  "  storyLikeSubscribe(input: $input) {\n" +
  "    story {\n" +
  "      likers {\n" +
  "        count\n" +
  "      }\n" +
  "      likeSentence {\n" +
  "        text\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}\n" +
  "fragment frag on Friend @onFragmentDefinition {\n" +
  "  foo(\n" +
  "    size: $size\n" +
  "    bar: $b\n" +
  "    obj: { key: \"value\", block: \"\"\"\n      block string uses \\\"\"\"\n    \"\"\" }\n" +
  "  )\n" +
  "}\n" +
  "{\n" +
  "  unnamed(truthy: true, falsy: false, nullish: null)\n" +
  "  query\n" +
  "}\n" +
  "query {\n" +
  "  __typename\n" +
  "}\n"
  let doc = parse_ok("kitchen_sink_query", kitchen_sink)
  debug_assert(doc.definitions.length() == 6, "expected 6 definitions, got " + doc.definitions.length().to_string())

  // Check op 0: named query with 2 variables and 1 directive
  match doc.definitions[0] {
    Definition::Operation(op) => {
      debug_assert(operation_type_eq(op.op_type, OperationType::Query), "op 0 is Query")
      debug_assert(!op.is_shorthand, "op 0 not shorthand")
      debug_assert(opt_str_eq(op.name, Some("queryName")), "op 0 name")
      debug_assert(op.variable_definitions.length() == 2, "op 0 2 vars")
      debug_assert(op.directives.length() == 1, "op 0 1 directive")
      debug_assert(op.selection_set.selections.length() == 1, "op 0 1 root selection")
    }
    _ => debug_assert(false, "expected Operation 0")
  }
  // Check op 1: mutation
  match doc.definitions[1] {
    Definition::Operation(op) => {
      debug_assert(operation_type_eq(op.op_type, OperationType::Mutation), "op 1 is Mutation")
      debug_assert(opt_str_eq(op.name, Some("likeStory")), "op 1 name")
    }
    _ => debug_assert(false, "expected Operation 1")
  }
  // Check op 2: subscription
  match doc.definitions[2] {
    Definition::Operation(op) => {
      debug_assert(operation_type_eq(op.op_type, OperationType::Subscription), "op 2 is Subscription")
      debug_assert(op.variable_definitions.length() == 1, "op 2 1 var")
      debug_assert(op.variable_definitions[0].directives.length() == 1, "var directive")
    }
    _ => debug_assert(false, "expected Operation 2")
  }
  // Check def 3: fragment
  match doc.definitions[3] {
    Definition::Fragment(frag) => {
      debug_assert(frag.name == "frag", "frag name")
      debug_assert(frag.type_condition == "Friend", "frag type condition")
      debug_assert(frag.directives.length() == 1, "frag directive")
    }
    _ => debug_assert(false, "expected Fragment 3")
  }
  // Check def 4: shorthand query
  match doc.definitions[4] {
    Definition::Operation(op) => {
      debug_assert(op.is_shorthand, "def 4 is shorthand")
      debug_assert(opt_str_eq(op.name, None), "def 4 anonymous")
      debug_assert(op.selection_set.selections.length() == 2, "def 4 2 fields")
    }
    _ => debug_assert(false, "expected shorthand Operation 4")
  }
  // Check def 5: explicit anonymous query
  match doc.definitions[5] {
    Definition::Operation(op) => {
      debug_assert(!op.is_shorthand, "def 5 not shorthand")
      debug_assert(opt_str_eq(op.name, None), "def 5 anonymous")
    }
    _ => debug_assert(false, "expected anonymous Operation 5")
  }
}

///|
test "parser__kitchen_sink_schema_sdl" {
  let sdl = "\"\"\"Root schema description\"\"\"\n" +
  "schema @onSchema {\n" +
  "  query: QueryType\n" +
  "  mutation: MutationType\n" +
  "  subscription: SubscriptionType\n" +
  "}\n" +
  "\"Scalar description\"\n" +
  "scalar CustomScalar @specifiedBy(url: \"https://example.com\")\n" +
  "interface Node {\n" +
  "  id: ID!\n" +
  "}\n" +
  "interface Resource implements & Node {\n" +
  "  id: ID!\n" +
  "  url: String!\n" +
  "}\n" +
  "\"\"\"\n  A user in the system.\n\"\"\"\n" +
  "type User implements & Node & Resource @key(fields: \"id\") {\n" +
  "  \"Unique ID\"\n" +
  "  id: ID!\n" +
  "  url: String!\n" +
  "  friends(first: Int = 10, after: String): [User!]! @deprecated(reason: \"Use edges\")\n" +
  "}\n" +
  "union SearchResult @onUnion = | User | CustomScalar\n" +
  "union EmptyUnion\n" +
  "enum Role {\n" +
  "  \"Admin role\"\n" +
  "  ADMIN @deprecated\n" +
  "  MEMBER\n" +
  "}\n" +
  "input UserFilter {\n" +
  "  name: String = \"anon\"\n" +
  "  roles: [Role!] = [ADMIN, MEMBER]\n" +
  "  nested: UserFilter = null\n" +
  "}\n" +
  "directive @auth(requires: Role = ADMIN) repeatable on | FIELD_DEFINITION | OBJECT\n" +
  "extend schema @extra {\n" +
  "  mutation: MutationType\n" +
  "}\n" +
  "extend scalar CustomScalar @extra\n" +
  "extend type User implements & Node @extra {\n" +
  "  email: String\n" +
  "}\n" +
  "extend interface Resource implements Node @extra {\n" +
  "  etag: String\n" +
  "}\n" +
  "extend union SearchResult = | Role\n" +
  "extend enum Role {\n" +
  "  GUEST\n" +
  "}\n" +
  "extend input UserFilter {\n" +
  "  active: Boolean = true\n" +
  "}\n"
  let doc = parse_ok("kitchen_sink_sdl", sdl)
  debug_assert(doc.definitions.length() == 17, "expected 17 SDL definitions, got " + doc.definitions.length().to_string())

  // Check schema description
  match doc.definitions[0] {
    Definition::Schema(s) => {
      match s.description {
        Some(d) => debug_assert(d.value == "Root schema description" && d.is_block, "schema desc")
        None => debug_assert(false, "expected schema description")
      }
      debug_assert(s.operation_types.length() == 3, "3 root op types")
    }
    _ => debug_assert(false, "expected SchemaDefinition")
  }
  // Check User implements 2 interfaces
  match doc.definitions[4] {
    Definition::TypeDef(TypeDefinition::Object(obj)) => {
      debug_assert(obj.name == "User", "User name")
      debug_assert(obj.implements_interfaces.length() == 2, "implements 2 interfaces")
      debug_assert(obj.implements_interfaces[0] == "Node", "Node")
      debug_assert(obj.implements_interfaces[1] == "Resource", "Resource")
      debug_assert(obj.fields.length() == 3, "3 fields")
    }
    _ => debug_assert(false, "expected ObjectTypeDefinition User")
  }
  // Check repeatable directive
  match doc.definitions[9] {
    Definition::DirectiveDef(dd) => {
      debug_assert(dd.name == "auth", "directive name")
      debug_assert(dd.repeatable, "directive repeatable")
      debug_assert(dd.locations.length() == 2, "2 locations")
      debug_assert(dd.locations[0] == "FIELD_DEFINITION", "loc 0")
      debug_assert(dd.locations[1] == "OBJECT", "loc 1")
    }
    _ => debug_assert(false, "expected DirectiveDefinition")
  }
}

///|
test "parser__standalone_value_and_type" {
  match parse_value("{ a: [1, 2.5, \"hi\", true, false, null, ENUM_VAL, $v] }") {
    Ok(Value::ObjectValue(fields)) => {
      debug_assert(fields.length() == 1, "1 field")
      match fields[0].value {
        Value::ListValue(items) => debug_assert(items.length() == 8, "8 list items")
        _ => debug_assert(false, "expected ListValue")
      }
    }
    Ok(_) => debug_assert(false, "expected ObjectValue")
    Err(e) => debug_assert(false, "parse_value failed: " + e.to_string())
  }

  match parse_type("[[String!]!]!") {
    Ok(TypeRef::NonNull(TypeRef::List(TypeRef::NonNull(TypeRef::List(TypeRef::NonNull(TypeRef::Named(n))))))) =>
    debug_assert(n == "String", "inner type String")
    Ok(_) => debug_assert(false, "unexpected TypeRef shape")
    Err(e) => debug_assert(false, "parse_type failed: " + e.to_string())
  }
}

///|
test "parser__spec_syntax_rejections" {
  // Empty document is invalid in GraphQL (must have >= 1 definition)
  let _ = parse_err("empty", "")
  let _ = parse_err("comments_only", "# just a comment")
  // Fragment named 'on' is forbidden
  let _ = parse_err("fragment_on", "fragment on on User { id }")
  // Double non-null is forbidden
  let _ = parse_err("double_nonnull", "type T { a: Int!! }")
  // Variable inside const default value is forbidden
  let _ = parse_err("var_in_default", "query Q($a: Int = $b) { x }")
  let _ = parse_err("var_in_sdl_arg", "type T @dir(a: $x) { id: ID }")
  let _ = parse_err("var_in_sdl_default", "input I { a: Int = $x }")
  // Enum value cannot be true, false, or null
  let _ = parse_err("enum_true", "enum E { true }")
  let _ = parse_err("enum_false", "enum E { false }")
  let _ = parse_err("enum_null", "enum E { null }")
  // Empty extension without directives/body is forbidden
  let _ = parse_err("empty_extend_type", "extend type User")
  let _ = parse_err("empty_extend_scalar", "extend scalar Date")
  let _ = parse_err("empty_extend_schema", "extend schema")
  // Description on extend is forbidden
  let _ = parse_err("desc_on_extend", "\"desc\" extend type User { a: Int }")
  // Invalid directive location
  let _ = parse_err("bad_directive_loc", "directive @foo on NOT_A_LOCATION")
  // Empty selection set
  let _ = parse_err("empty_sel_set", "query { }")
  // Empty arguments list ()
  let _ = parse_err("empty_args", "{ field() }")
  // Variable definitions on anonymous shorthand
  let _ = parse_err("shorthand_vars", "($a: Int) { x }")
}
