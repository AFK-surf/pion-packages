///| GraphQL printer (`print_document`) and minifier (`minify_query`) compliance tests.

///|
test "printer__roundtrip_query_and_sdl" {
  let src = "query GetUser($id: ID! = \"42\", $tags: [String!] = [\"a\", \"b\"]) @cached {\n" +
  "  me: user(id: $id, filter: { active: true, limit: 10, ratio: 0.5, extra: null, mode: FAST }) {\n" +
  "    id\n" +
  "    ...UserCore @include(if: true)\n" +
  "    ... on Admin {\n" +
  "      permissions\n" +
  "    }\n" +
  "  }\n" +
  "}\n" +
  "fragment UserCore on User {\n" +
  "  name\n" +
  "  email\n" +
  "}\n" +
  "\"\"\"\n  Account type\n\"\"\"\n" +
  "type Account implements Node & Timestamped @entity {\n" +
  "  id: ID!\n" +
  "  createdAt: String!\n" +
  "}\n" +
  "directive @entity repeatable on OBJECT | INTERFACE\n"
  let doc1 = match parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "initial parse failed: " + e.to_string())
      return
    }
  }
  let printed1 = print_document(doc1)
  debug_assert(printed1.length() > 0, "printed output non-empty")
  let doc2 = match parse(printed1) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "roundtrip re-parse failed: " + e.to_string() + "\n" + printed1)
      return
    }
  }
  let printed2 = print_document(doc2)
  debug_assert(printed1 == printed2, "print_document must be idempotent on roundtrip")
}

///|
test "printer__string_and_block_string_escaping_roundtrip" {
  let src = "{ a(s: \"line1\\nline2\\\"quote\\\\slash\", b: \"\"\"\n  hello\n  \\\"\"\" world\n\"\"\") }"
  let doc1 = match parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return
    }
  }
  let printed = print_document(doc1)
  let doc2 = match parse(printed) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "re-parse failed: " + e.to_string() + "\n" + printed)
      return
    }
  }
  match (doc1.definitions[0], doc2.definitions[0]) {
    (Definition::Operation(op1), Definition::Operation(op2)) => {
      match (op1.selection_set.selections[0], op2.selection_set.selections[0]) {
        (Selection::Field(f1), Selection::Field(f2)) => {
          match (f1.arguments[0].value, f2.arguments[0].value) {
            (Value::StringValue(s1, _), Value::StringValue(s2, _)) =>
            debug_assert(s1 == s2, "escaped string value preserved")
            _ => debug_assert(false, "expected string arg 0")
          }
          match (f1.arguments[1].value, f2.arguments[1].value) {
            (Value::StringValue(s1, _), Value::StringValue(s2, _)) =>
            debug_assert(s1 == s2, "block string value preserved")
            _ => debug_assert(false, "expected block string arg 1")
          }
        }
        _ => debug_assert(false, "expected Field")
      }
    }
    _ => debug_assert(false, "expected Operation")
  }
}

///|
test "minify__strips_comments_commas_whitespace_without_gluing" {
  let src = "# header comment\n" +
  "query  GetItems ( $a : Int = 1 , $b : Int = 2 ) {\n" +
  "  # inline comment\n" +
  "  items(ids: [1, 2, 3], tags: [A, B]) {\n" +
  "    id, name\n" +
  "    ... on Item {\n" +
  "      title\n" +
  "    }\n" +
  "    ...FragA\n" +
  "  }\n" +
  "}\n" +
  "fragment FragA on Item { score }\n"
  let min = match minify_query(src) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "minify_query failed: " + e.to_string())
      return
    }
  }
  debug_assert(min.length() < src.length(), "minified output must be shorter")
  // Must re-parse cleanly!
  let doc_orig = match parse(src) {
    Ok(d) => d
    Err(_) => return
  }
  let doc_min = match parse(min) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "minified output failed to re-parse: " + e.to_string() + "\nmin=" + min)
      return
    }
  }
  debug_assert(
    print_document(doc_orig) == print_document(doc_min),
    "minified document must preserve exact AST semantics",
  )
  // Idempotent
  match minify_query(min) {
    Ok(min2) => debug_assert(min == min2, "minify_query must be idempotent")
    Err(e) => debug_assert(false, "second minify failed: " + e.to_string())
  }
}

///|
test "minify__never_glues_adjacent_tokens" {
  // Adjacent names, numbers, and spread must keep a single space where required
  let cases = [
    "{ a b c }",
    "{ f(x: [1, 2, 3]) }",
    "{ ... on Type { a } }",
    "query Q { ...F } fragment F on T { a }",
    "{ f(a: 1, b: 2.5) }",
    "type A implements B & C { x: Int y: String }",
  ]
  let mut i = 0
  while i < cases.length() {
    let s = cases[i]
    let min = match minify_query(s) {
      Ok(m) => m
      Err(e) => {
        debug_assert(false, "minify case " + i.to_string() + " failed: " + e.to_string())
        return
      }
    }
    let d1 = match parse(s) {
      Ok(d) => d
      Err(_) => return
    }
    let d2 = match parse(min) {
      Ok(d) => d
      Err(e) => {
        debug_assert(false, "re-parse case " + i.to_string() + " failed: " + e.to_string() + " min=" + min)
        return
      }
    }
    debug_assert(
      print_document(d1) == print_document(d2),
      "AST mismatch on minify case " + i.to_string() + ": " + min,
    )
    i = i + 1
  }
}

///|
test "printer__block_string_leading_ws_and_arg_descriptions_roundtrip" {
  // P0-1: single-line block strings with leading space/tab and trailing quote/slash
  let cases = [
    "{ f(x: \"\"\"  a\"\"\") }",
    "{ f(x: \"\"\"\tTabbed\"\"\") }",
    "{ f(x: \"\"\"    deep\"\"\") }",
    "\"\"\"\tTabbed doc\"\"\"\ntype T { a: Int }",
    "type T {\n  f(\n    \"how many\"\n    first: Int\n  ): Int\n}",
    "directive @cost(\"\"\"weight\"\"\" w: Int) on FIELD",
  ]
  let mut i = 0
  while i < cases.length() {
    let d1 = match parse(cases[i]) {
      Ok(d) => d
      Err(e) => {
        debug_assert(false, "case " + i.to_string() + " parse failed: " + e.to_string())
        return
      }
    }
    let p1 = print_document(d1)
    let d2 = match parse(p1) {
      Ok(d) => d
      Err(e) => {
        debug_assert(false, "case " + i.to_string() + " re-parse failed: " + e.to_string() + "\n" + p1)
        return
      }
    }
    let p2 = print_document(d2)
    debug_assert(p1 == p2, "case " + i.to_string() + " not idempotent:\n" + p1 + "\n---\n" + p2)
    i = i + 1
  }
  // P2-5: minify_query minimizes block strings identically to graphql-js stripIgnoredCharacters
  match minify_query("{ f(x: \"\"\"\n      a\n      b\n    \"\"\") }") {
    Ok(m) => debug_assert(m == "{f(x:\"\"\"a\nb\"\"\")}", "unexpected minified block string: " + m)
    Err(e) => debug_assert(false, "minify failed: " + e.to_string())
  }
}
