///| Head-to-head benchmark driver for `packages/graphql`.

import "graphql"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn split_queries(src : String) -> Array[String] {
  let delim = "\n###QUERY###\n"
  let dlen = delim.length()
  let n = src.length()
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i + dlen <= n {
    if src.code_unit_at(i) == 10 && src.slice(i, i + dlen) == delim {
      out.push(src.slice(start, i))
      i = i + dlen
      start = i
    } else {
      i = i + 1
    }
  }
  if start <= n {
    out.push(src.slice(start, n))
  }
  out
}

fn fnv1a_update(h : Int64, s : String) -> Int64 {
  let mut hash = h
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i).to_int64()
    hash = hash ^ b
    hash = (hash * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  hash
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: graphql_bench_pion <sdl|queries|roundtrip> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int_arg(args[3], 1)
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }

  if mode == "sdl" {
    let mut total_defs : Int64 = 0L
    let mut total_objs : Int64 = 0L
    let mut total_fields : Int64 = 0L
    let mut r = 0
    while r < iters {
      let doc = match graphql::parse(src) {
        Ok(d) => d
        Err(e) => {
          io_println(world, "sdl parse error: " + e.to_string())
          return 1
        }
      }
      total_defs = total_defs + doc.definitions.length().to_int64()
      let mut i = 0
      while i < doc.definitions.length() {
        match doc.definitions[i] {
          graphql::Definition::TypeDef(graphql::TypeDefinition::Object(obj)) => {
            total_objs = total_objs + 1L
            total_fields = total_fields + obj.fields.length().to_int64()
          }
          graphql::Definition::TypeExtension(graphql::TypeExtension::Object(obj)) =>
          total_fields = total_fields + obj.fields.length().to_int64()
          _ => ()
        }
        i = i + 1
      }
      r = r + 1
    }
    io_println(world, "mode=sdl")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "definitions=" + total_defs.to_string())
    io_println(world, "object_types=" + total_objs.to_string())
    io_println(world, "fields=" + total_fields.to_string())
    return 0
  }

  if mode == "queries" {
    let queries = split_queries(src)
    let mut total_q : Int64 = 0L
    let mut total_ops : Int64 = 0L
    let mut total_frags : Int64 = 0L
    let mut total_errs : Int64 = 0L
    let mut r = 0
    while r < iters {
      let mut qi = 0
      while qi < queries.length() {
        let doc = match graphql::parse(queries[qi]) {
          Ok(d) => d
          Err(e) => {
            io_println(world, "query parse error: " + e.to_string())
            return 1
          }
        }
        total_q = total_q + 1L
        let mut di = 0
        while di < doc.definitions.length() {
          match doc.definitions[di] {
            graphql::Definition::Operation(_) => total_ops = total_ops + 1L
            graphql::Definition::Fragment(_) => total_frags = total_frags + 1L
            _ => ()
          }
          di = di + 1
        }
        let errs = graphql::validate_executable(doc)
        total_errs = total_errs + errs.length().to_int64()
        qi = qi + 1
      }
      r = r + 1
    }
    io_println(world, "mode=queries")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "queries=" + total_q.to_string())
    io_println(world, "ops=" + total_ops.to_string())
    io_println(world, "frags=" + total_frags.to_string())
    io_println(world, "val_errors=" + total_errs.to_string())
    return 0
  }

  if mode == "roundtrip" {
    let queries = split_queries(src)
    let mut total_q : Int64 = 0L
    let mut total_min_bytes : Int64 = 0L
    let mut min_hash : Int64 = 2166136261L
    let mut total_print_min_bytes : Int64 = 0L
    let mut print_min_hash : Int64 = 2166136261L
    let mut total_defs : Int64 = 0L
    let mut total_printed_nonempty : Int64 = 0L
    let mut r = 0
    while r < iters {
      let mut qi = 0
      while qi < queries.length() {
        let min = match graphql::minify_query(queries[qi]) {
          Ok(m) => m
          Err(e) => {
            io_println(world, "minify error: " + e.to_string())
            return 1
          }
        }
        total_min_bytes = total_min_bytes + min.length().to_int64()
        min_hash = fnv1a_update(min_hash, min)
        let doc = match graphql::parse(min) {
          Ok(d) => d
          Err(e) => {
            io_println(world, "re-parse error: " + e.to_string())
            return 1
          }
        }
        let printed = graphql::print_document(doc)
        if printed.length() > 0 {
          total_printed_nonempty = total_printed_nonempty + 1L
        }
        let printed_min = match graphql::minify_query(printed) {
          Ok(m) => m
          Err(e) => {
            io_println(world, "printed minify error: " + e.to_string())
            return 1
          }
        }
        total_print_min_bytes = total_print_min_bytes + printed_min.length().to_int64()
        print_min_hash = fnv1a_update(print_min_hash, printed_min)
        total_defs = total_defs + doc.definitions.length().to_int64()
        total_q = total_q + 1L
        qi = qi + 1
      }
      r = r + 1
    }
    io_println(world, "mode=roundtrip")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "queries=" + total_q.to_string())
    io_println(world, "min_bytes=" + total_min_bytes.to_string())
    io_println(world, "min_fnv1a=" + min_hash.to_string())
    io_println(world, "printed_min_bytes=" + total_print_min_bytes.to_string())
    io_println(world, "printed_min_fnv1a=" + print_min_hash.to_string())
    io_println(world, "defs=" + total_defs.to_string())
    io_println(world, "printed_ok=" + total_printed_nonempty.to_string())
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
