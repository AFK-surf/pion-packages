///| GraphQL October 2021 Lexer compliance tests (ported from graphql-js lexer-test).

fn lex_ok(name : String, src : String) -> Array[Token] {
  match tokenize(src) {
    Ok(toks) => toks
    Err(e) => {
      debug_assert(false, "[" + name + "] unexpected lex error: " + e.to_string())
      []
    }
  }
}

fn lex_err(name : String, src : String) -> GraphqlError {
  match tokenize(src) {
    Ok(toks) => {
      debug_assert(
        false,
        "[" + name + "] expected lex error, got " + toks.length().to_string() + " tokens",
      )
      GraphqlError::new(ErrorKind::InvalidSyntax, 0, 0, 0, "")
    }
    Err(e) => {
      debug_assert(
        !error_kind_eq(e.kind, ErrorKind::Unimplemented),
        "[" + name + "] got Unimplemented instead of real lex error",
      )
      e
    }
  }
}

///|
test "lexer__ignores_bom_whitespace_commas_and_comments" {
  let src = "\u{FEFF}  \t , , # hello world\n\r\n\r  foo , # trailing comment"
  let toks = lex_ok("ignored", src)
  debug_assert(toks.length() == 2, "expected Name + Eof, got " + toks.length().to_string())
  debug_assert(token_kind_eq(toks[0].kind, TokenKind::Name("foo")), "expected Name(foo)")
  debug_assert(toks[0].line == 4, "expected line 4 after \\n, \\r\\n, \\r, got " + toks[0].line.to_string())
  debug_assert(toks[0].col == 3, "expected col 3, got " + toks[0].col.to_string())
  debug_assert(token_kind_eq(toks[1].kind, TokenKind::Eof), "expected Eof")
}

///|
test "lexer__all_punctuators" {
  let src = "! $ & ( ) ... : = @ [ ] { | }"
  let toks = lex_ok("punctuators", src)
  debug_assert(toks.length() == 15, "expected 14 punctuators + Eof")
  debug_assert(token_kind_eq(toks[0].kind, TokenKind::Bang), "!")
  debug_assert(token_kind_eq(toks[1].kind, TokenKind::Dollar), "$")
  debug_assert(token_kind_eq(toks[2].kind, TokenKind::Amp), "&")
  debug_assert(token_kind_eq(toks[3].kind, TokenKind::LParen), "(")
  debug_assert(token_kind_eq(toks[4].kind, TokenKind::RParen), ")")
  debug_assert(token_kind_eq(toks[5].kind, TokenKind::Spread), "...")
  debug_assert(token_kind_eq(toks[6].kind, TokenKind::Colon), ":")
  debug_assert(token_kind_eq(toks[7].kind, TokenKind::Equals), "=")
  debug_assert(token_kind_eq(toks[8].kind, TokenKind::At), "@")
  debug_assert(token_kind_eq(toks[9].kind, TokenKind::LBracket), "[")
  debug_assert(token_kind_eq(toks[10].kind, TokenKind::RBracket), "]")
  debug_assert(token_kind_eq(toks[11].kind, TokenKind::LBrace), "{")
  debug_assert(token_kind_eq(toks[12].kind, TokenKind::Pipe), "|")
  debug_assert(token_kind_eq(toks[13].kind, TokenKind::RBrace), "}")
  debug_assert(token_kind_eq(toks[14].kind, TokenKind::Eof), "Eof")
}

///|
test "lexer__rejects_single_and_double_dot" {
  let _ = lex_err("single_dot", ".")
  let _ = lex_err("double_dot", "..")
  let _ = lex_err("four_dots", "....")
}

///|
test "lexer__names" {
  let toks = lex_ok("names", "_ _a A0 foo_bar_123 __typename")
  debug_assert(toks.length() == 6, "5 names + Eof")
  debug_assert(token_kind_eq(toks[0].kind, TokenKind::Name("_")), "_")
  debug_assert(token_kind_eq(toks[1].kind, TokenKind::Name("_a")), "_a")
  debug_assert(token_kind_eq(toks[2].kind, TokenKind::Name("A0")), "A0")
  debug_assert(token_kind_eq(toks[3].kind, TokenKind::Name("foo_bar_123")), "foo_bar_123")
  debug_assert(token_kind_eq(toks[4].kind, TokenKind::Name("__typename")), "__typename")
}

///|
test "lexer__valid_ints_and_floats" {
  let toks = lex_ok(
    "numbers",
    "0 -0 42 -42 1234567890 0.0 -0.0 3.14159 1e5 1E5 1e+5 1e-5 1.23e4 -1.23E-45",
  )
  debug_assert(toks.length() == 15, "14 numbers + Eof")
  debug_assert(token_kind_eq(toks[0].kind, TokenKind::Int("0")), "0")
  debug_assert(token_kind_eq(toks[1].kind, TokenKind::Int("-0")), "-0")
  debug_assert(token_kind_eq(toks[2].kind, TokenKind::Int("42")), "42")
  debug_assert(token_kind_eq(toks[3].kind, TokenKind::Int("-42")), "-42")
  debug_assert(token_kind_eq(toks[4].kind, TokenKind::Int("1234567890")), "1234567890")
  debug_assert(token_kind_eq(toks[5].kind, TokenKind::Float("0.0")), "0.0")
  debug_assert(token_kind_eq(toks[6].kind, TokenKind::Float("-0.0")), "-0.0")
  debug_assert(token_kind_eq(toks[7].kind, TokenKind::Float("3.14159")), "3.14159")
  debug_assert(token_kind_eq(toks[8].kind, TokenKind::Float("1e5")), "1e5")
  debug_assert(token_kind_eq(toks[9].kind, TokenKind::Float("1E5")), "1E5")
  debug_assert(token_kind_eq(toks[10].kind, TokenKind::Float("1e+5")), "1e+5")
  debug_assert(token_kind_eq(toks[11].kind, TokenKind::Float("1e-5")), "1e-5")
  debug_assert(token_kind_eq(toks[12].kind, TokenKind::Float("1.23e4")), "1.23e4")
  debug_assert(token_kind_eq(toks[13].kind, TokenKind::Float("-1.23E-45")), "-1.23E-45")
}

///|
test "lexer__invalid_numbers_spec_oct2021" {
  // Leading zeros
  let _ = lex_err("00", "00")
  let _ = lex_err("01", "01")
  let _ = lex_err("-01", "-01")
  let _ = lex_err("01.23", "01.23")
  // Leading / trailing dot
  let _ = lex_err(".5", ".5")
  let _ = lex_err("1.", "1.")
  let _ = lex_err("1.e5", "1.e5")
  // Missing exponent digits
  let _ = lex_err("1e", "1e")
  let _ = lex_err("1e+", "1e+")
  let _ = lex_err("1e-", "1e-")
  let _ = lex_err("1.0e", "1.0e")
  // Plus sign or bare minus
  let _ = lex_err("+1", "+1")
  let _ = lex_err("-", "-")
  let _ = lex_err("-a", "-a")
  // Lookahead restriction: NameStart or '.' immediately after number
  let _ = lex_err("123abc", "123abc")
  let _ = lex_err("0a", "0a")
  let _ = lex_err("1_000", "1_000")
  let _ = lex_err("1.2abc", "1.2abc")
  let _ = lex_err("1.2.3", "1.2.3")
  let _ = lex_err("1e2.3", "1e2.3")
  let _ = lex_err("1e2foo", "1e2foo")
}

///|
test "lexer__string_escapes_and_unicode_oct2021" {
  let toks = lex_ok(
    "strings",
    "\"\" \"simple\" \"\\\" \\\\ \\/ \\b \\f \\n \\r \\t\" \"\\u0041\\u03B1\" \"\\u{1F600}\" \"\\u{000041}\" \"\\uD83D\\uDE00\"",
  )
  debug_assert(toks.length() == 8, "7 strings + Eof")
  debug_assert(token_kind_eq(toks[0].kind, TokenKind::Str("")), "empty string")
  debug_assert(token_kind_eq(toks[1].kind, TokenKind::Str("simple")), "simple")
  debug_assert(
    token_kind_eq(toks[2].kind, TokenKind::Str("\" \\ / \u{0008} \u{000C} \n \r \t")),
    "standard escapes",
  )
  debug_assert(token_kind_eq(toks[3].kind, TokenKind::Str("Aα")), "fixed \\uXXXX")
  debug_assert(token_kind_eq(toks[4].kind, TokenKind::Str("😀")), "variable \\u{1F600}")
  debug_assert(token_kind_eq(toks[5].kind, TokenKind::Str("A")), "variable \\u{000041}")
  debug_assert(token_kind_eq(toks[6].kind, TokenKind::Str("😀")), "UTF-16 surrogate pair")
}

///|
test "lexer__invalid_strings_and_surrogates" {
  let _ = lex_err("unterminated", "\"abc")
  let _ = lex_err("unescaped_lf", "\"abc\ndef\"")
  let _ = lex_err("unescaped_cr", "\"abc\rdef\"")
  let _ = lex_err("bad_escape", "\"\\x\"")
  let _ = lex_err("bad_u_short", "\"\\u123\"")
  let _ = lex_err("bad_u_hex", "\"\\u123G\"")
  let _ = lex_err("lone_high_surrogate", "\"\\uD83D\"")
  let _ = lex_err("lone_high_before_ascii", "\"\\uD83Da\"")
  let _ = lex_err("lone_high_before_non_low", "\"\\uD83D\\u0041\"")
  let _ = lex_err("lone_low_surrogate", "\"\\uDE00\"")
  let _ = lex_err("var_u_empty", "\"\\u{}\"")
  let _ = lex_err("var_u_unclosed", "\"\\u{1F600\"")
  let _ = lex_err("var_u_surrogate", "\"\\u{D800}\"")
  let _ = lex_err("var_u_out_of_range", "\"\\u{110000}\"")
  let _ = lex_err("ctrl_char_in_str", "\"a\u{0007}b\"")
  // DEL (U+007F) is a valid SourceCharacter in GraphQL October 2021
  let del_toks = lex_ok("del_char_in_str", "\"a\u{007F}b\"")
  debug_assert(token_kind_eq(del_toks[0].kind, TokenKind::Str("a\u{007F}b")), "DEL allowed in string")
}

///|
test "lexer__block_string_indentation_and_escaping" {
  // Basic block string with common indentation stripping (GraphQL Oct 2021 §2.9.4)
  let src1 = "\"\"\"\n    Hello,\n      World!\n\n    Yours,\n      GraphQL.\n  \"\"\""
  let t1 = lex_ok("block1", src1)
  debug_assert(
    token_kind_eq(t1[0].kind, TokenKind::BlockStr("Hello,\n  World!\n\nYours,\n  GraphQL.")),
    "block string dedent",
  )

  // First line is NOT considered for commonIndent
  let src2 = "\"\"\"  first\n      second\n        third\n    \"\"\""
  let t2 = lex_ok("block2", src2)
  debug_assert(
    token_kind_eq(t2[0].kind, TokenKind::BlockStr("  first\nsecond\n  third")),
    "first line preserves its own leading spaces",
  )

  // Escaped triple-quote \""" becomes """, while \n stays literal
  let src3 = "\"\"\"escaped \\\"\"\" and literal \\n\"\"\""
  let t3 = lex_ok("block3", src3)
  debug_assert(
    token_kind_eq(t3[0].kind, TokenKind::BlockStr("escaped \"\"\" and literal \\n")),
    "block string escaped triple quote and literal backslash",
  )

  // CRLF and CR normalization inside block strings
  let src4 = "\"\"\"\r\n  line1\r\n  line2\r  line3\r\n\"\"\""
  let t4 = lex_ok("block4", src4)
  debug_assert(
    token_kind_eq(t4[0].kind, TokenKind::BlockStr("line1\nline2\nline3")),
    "block string CRLF/CR normalization",
  )

  // Empty and whitespace-only block strings
  let t5 = lex_ok("block_empty", "\"\"\"\"\"\"")
  debug_assert(token_kind_eq(t5[0].kind, TokenKind::BlockStr("")), "empty block string")
  let t6 = lex_ok("block_ws", "\"\"\"\n  \t \n   \n\"\"\"")
  debug_assert(token_kind_eq(t6[0].kind, TokenKind::BlockStr("")), "whitespace-only block string")

  // Unterminated block string
  let _ = lex_err("unterminated_block", "\"\"\"hello")
}

///|
test "lexer__count_tokens_matches_tokenize" {
  let src = "query Q($x: Int = 1) { field(a: \"hi\", b: [1, 2.5]) { ...F } }"
  let toks = lex_ok("count", src)
  match count_tokens(src) {
    Ok(n) => debug_assert(n == toks.length() - 1, "count_tokens excludes Eof")
    Err(e) => debug_assert(false, "count_tokens failed: " + e.to_string())
  }
}
