///| 100% iterative GraphQL AST Formatter (`print_document`) and single-pass streaming Minifier (`minify_query`).

let indent_spaces : String = "                                "

fn write_indent(sb : StringBuilder, level : Int) -> Unit {
  let mut rem = level * 2
  while rem > 32 {
    sb.write_string(indent_spaces)
    rem = rem - 32
  }
  if rem > 0 {
    sb.write_substring(indent_spaces, 0, rem)
  }
}

fn write_hex4(sb : StringBuilder, n : Int) -> Unit {
  let digits = "0123456789ABCDEF"
  sb.write_byte(digits.code_unit_at((n >> 12) & 0xF).to_byte())
  sb.write_byte(digits.code_unit_at((n >> 8) & 0xF).to_byte())
  sb.write_byte(digits.code_unit_at((n >> 4) & 0xF).to_byte())
  sb.write_byte(digits.code_unit_at(n & 0xF).to_byte())
}

fn write_escaped_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 0x20 && b != 34 && b != 92 && b != 0x7F {
      i = i + 1
    } else {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u")
        write_hex4(sb, b)
      }
      i = i + 1
      chunk_start = i
    }
  }
  if chunk_start == 0 {
    sb.write_string(s)
  } else if n > chunk_start {
    sb.write_substring(s, chunk_start, n)
  }
  sb.write_byte(34.to_byte())
}

fn write_block_string_impl(
  sb : StringBuilder,
  s : String,
  indent : Int,
  minimize : Bool,
) -> Unit {
  let n = s.length()
  // Single pass over `s` to detect whether `"""` escaping is needed and whether any newline exists
  let mut has_triple = false
  let mut first_nl = -1
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 &&
    i + 2 < n &&
    s.code_unit_at(i + 1) == 34 &&
    s.code_unit_at(i + 2) == 34 {
      has_triple = true
      i = i + 3
    } else {
      if first_nl < 0 && (b == 10 || b == 13) {
        first_nl = i
      }
      i = i + 1
    }
  }

  let body = if !has_triple {
    s
  } else {
    let esc = StringBuilder::with_capacity(n + 8)
    let mut chunk_start = 0
    let mut k = 0
    while k < n {
      if s.code_unit_at(k) == 34 &&
      k + 2 < n &&
      s.code_unit_at(k + 1) == 34 &&
      s.code_unit_at(k + 2) == 34 {
        if k > chunk_start {
          esc.write_substring(s, chunk_start, k)
        }
        esc.write_string("\\\"\"\"")
        k = k + 3
        chunk_start = k
      } else {
        k = k + 1
      }
    }
    if k > chunk_start {
      esc.write_substring(s, chunk_start, k)
    }
    esc.to_string()
  }

  let bn = body.length()
  let is_single_line = first_nl < 0
  let mut force_leading_nl = !is_single_line
  if force_leading_nl {
    // Check if every non-empty line after line 0 starts with space or tab
    let mut p = if has_triple { 0 } else { first_nl }
    if has_triple {
      while p < bn {
        let b = body.code_unit_at(p)
        if b == 10 || b == 13 {
          break
        }
        p = p + 1
      }
    }
    while p < bn {
      let b = body.code_unit_at(p)
      if b == 13 && p + 1 < bn && body.code_unit_at(p + 1) == 10 {
        p = p + 2
      } else {
        p = p + 1
      }
      // Now at start of a subsequent line
      if p < bn {
        let c0 = body.code_unit_at(p)
        if c0 != 10 && c0 != 13 && c0 != 32 && c0 != 9 {
          force_leading_nl = false
          break
        }
      }
      // Advance to next newline
      while p < bn {
        let nb = body.code_unit_at(p)
        if nb == 10 || nb == 13 {
          break
        }
        p = p + 1
      }
    }
  }

  let has_trailing_triple_quotes = bn >= 4 &&
  body.code_unit_at(bn - 4) == 92 &&
  body.code_unit_at(bn - 3) == 34 &&
  body.code_unit_at(bn - 2) == 34 &&
  body.code_unit_at(bn - 1) == 34
  let has_trailing_quote = n > 0 && s.code_unit_at(n - 1) == 34 && !has_trailing_triple_quotes
  let has_trailing_slash = n > 0 && s.code_unit_at(n - 1) == 92
  let force_trailing_nl = has_trailing_quote || has_trailing_slash

  let print_as_multiline = !minimize &&
  (!is_single_line ||
    n > 70 ||
    force_trailing_nl ||
    force_leading_nl ||
    has_trailing_triple_quotes)
  let skip_leading_nl = is_single_line &&
  n > 0 &&
  (s.code_unit_at(0) == 32 || s.code_unit_at(0) == 9)

  let add_leading_nl = (print_as_multiline && !skip_leading_nl) || force_leading_nl
  let add_trailing_nl = print_as_multiline || force_trailing_nl

  sb.write_string("\"\"\"")
  if add_leading_nl {
    sb.write_byte(10.to_byte())
  }
  if minimize || indent == 0 {
    sb.write_string(body)
  } else if is_single_line {
    if bn > 0 {
      if add_leading_nl {
        write_indent(sb, indent)
      }
      sb.write_string(body)
    }
  } else {
    let mut ls = 0
    let mut p = 0
    let mut li = 0
    while p <= bn {
      let at_end = p == bn
      let is_nl = !at_end && (body.code_unit_at(p) == 10 || body.code_unit_at(p) == 13)
      if at_end || is_nl {
        if li > 0 {
          sb.write_byte(10.to_byte())
        }
        if p > ls {
          if li > 0 || add_leading_nl {
            write_indent(sb, indent)
          }
          sb.write_substring(body, ls, p)
        }
        if at_end {
          break
        }
        if body.code_unit_at(p) == 13 && p + 1 < bn && body.code_unit_at(p + 1) == 10 {
          p = p + 2
        } else {
          p = p + 1
        }
        ls = p
        li = li + 1
      } else {
        p = p + 1
      }
    }
  }
  if add_trailing_nl {
    sb.write_byte(10.to_byte())
    if !minimize && indent > 0 {
      write_indent(sb, indent)
    }
  }
  sb.write_string("\"\"\"")
}

fn write_block_string(sb : StringBuilder, s : String, indent : Int) -> Unit {
  write_block_string_impl(sb, s, indent, false)
}

///| Iterative `TypeRef` formatter with zero-allocation fast paths for Named / NonNull(Named).
fn write_type_ref(sb : StringBuilder, ty : TypeRef) -> Unit {
  match ty {
    TypeRef::Named(n) => {
      sb.write_string(n)
      return
    }
    TypeRef::NonNull(TypeRef::Named(n)) => {
      sb.write_string(n)
      sb.write_byte(33.to_byte())
      return
    }
    _ => ()
  }
  let suffixes : Array[Int] = []
  let mut cur = ty
  while true {
    match cur {
      TypeRef::Named(n) => {
        sb.write_string(n)
        break
      }
      TypeRef::List(inner) => {
        sb.write_byte(91.to_byte())
        suffixes.push(93)
        cur = inner
      }
      TypeRef::NonNull(inner) => {
        suffixes.push(33)
        cur = inner
      }
    }
  }
  let mut i = suffixes.length() - 1
  while i >= 0 {
    sb.write_byte(suffixes[i].to_byte())
    i = i - 1
  }
}

enum ValPrintTask {
  Val(Value)
  Raw(String)
}

///| 100% iterative `Value` formatter with zero-stack fast path for scalar values.
fn write_value_iter(sb : StringBuilder, v_node : Value) -> Unit {
  match v_node {
    Value::Variable(name) => {
      sb.write_byte(36.to_byte())
      sb.write_string(name)
      return
    }
    Value::IntValue(s) => {
      sb.write_string(s)
      return
    }
    Value::FloatValue(s) => {
      sb.write_string(s)
      return
    }
    Value::StringValue(s, is_block) => {
      if is_block {
        write_block_string(sb, s, 0)
      } else {
        write_escaped_string(sb, s)
      }
      return
    }
    Value::BooleanValue(b) => {
      if b { sb.write_string("true") } else { sb.write_string("false") }
      return
    }
    Value::NullValue => {
      sb.write_string("null")
      return
    }
    Value::EnumValue(s) => {
      sb.write_string(s)
      return
    }
    _ => ()
  }
  let stack : Array[ValPrintTask] = [ValPrintTask::Val(v_node)]
  while stack.length() > 0 {
    let task = stack[stack.length() - 1]
    let _ = stack.pop()
    match task {
      ValPrintTask::Raw(s) => sb.write_string(s)
      ValPrintTask::Val(v) =>
      match v {
        Value::Variable(name) => {
          sb.write_byte(36.to_byte())
          sb.write_string(name)
        }
        Value::IntValue(s) => sb.write_string(s)
        Value::FloatValue(s) => sb.write_string(s)
        Value::StringValue(s, is_block) =>
        if is_block {
          write_block_string(sb, s, 0)
        } else {
          write_escaped_string(sb, s)
        }
        Value::BooleanValue(b) =>
        if b { sb.write_string("true") } else { sb.write_string("false") }
        Value::NullValue => sb.write_string("null")
        Value::EnumValue(s) => sb.write_string(s)
        Value::ListValue(items) => {
          sb.write_byte(91.to_byte())
          stack.push(ValPrintTask::Raw("]"))
          let mut i = items.length() - 1
          while i >= 0 {
            stack.push(ValPrintTask::Val(items[i]))
            if i > 0 {
              stack.push(ValPrintTask::Raw(", "))
            }
            i = i - 1
          }
        }
        Value::ObjectValue(fields) => {
          if fields.length() == 0 {
            sb.write_string("{}")
          } else {
            sb.write_string("{ ")
            stack.push(ValPrintTask::Raw(" }"))
            let mut i = fields.length() - 1
            while i >= 0 {
              stack.push(ValPrintTask::Val(fields[i].value))
              stack.push(ValPrintTask::Raw(": "))
              stack.push(ValPrintTask::Raw(fields[i].name))
              if i > 0 {
                stack.push(ValPrintTask::Raw(", "))
              }
              i = i - 1
            }
          }
        }
      }
    }
  }
}

fn write_arguments(sb : StringBuilder, args : Array[Argument]) -> Unit {
  if args.length() == 0 {
    return
  }
  sb.write_byte(40.to_byte())
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(args[i].name)
    sb.write_string(": ")
    write_value_iter(sb, args[i].value)
    i = i + 1
  }
  sb.write_byte(41.to_byte())
}

fn write_directives(sb : StringBuilder, dirs : Array[Directive]) -> Unit {
  let mut i = 0
  while i < dirs.length() {
    sb.write_string(" @")
    sb.write_string(dirs[i].name)
    write_arguments(sb, dirs[i].arguments)
    i = i + 1
  }
}

enum SelPrintTask {
  Sel(Selection, Int)
  CloseBrace(Int)
}

///| 100% iterative `SelectionSet` formatter with reusable stack.
fn write_selection_set_iter(
  sb : StringBuilder,
  ss : SelectionSet,
  base_indent : Int,
  stack : Array[SelPrintTask],
) -> Unit {
  sb.write_string("{\n")
  stack.clear()
  stack.push(SelPrintTask::CloseBrace(base_indent))
  let mut i = ss.selections.length() - 1
  while i >= 0 {
    stack.push(SelPrintTask::Sel(ss.selections[i], base_indent + 1))
    i = i - 1
  }
  while stack.length() > 0 {
    let task = stack[stack.length() - 1]
    let _ = stack.pop()
    match task {
      SelPrintTask::CloseBrace(ind) => {
        write_indent(sb, ind)
        sb.write_byte(125.to_byte())
        if ind > base_indent {
          sb.write_byte(10.to_byte())
        }
      }
      SelPrintTask::Sel(sel, ind) =>
      match sel {
        Selection::Field(f) => {
          write_indent(sb, ind)
          match f.alias {
            Some(a) => {
              sb.write_string(a)
              sb.write_string(": ")
            }
            None => ()
          }
          sb.write_string(f.name)
          if f.arguments.length() > 0 {
            write_arguments(sb, f.arguments)
          }
          if f.directives.length() > 0 {
            write_directives(sb, f.directives)
          }
          match f.selection_set {
            Some(sub) => {
              sb.write_string(" {\n")
              stack.push(SelPrintTask::CloseBrace(ind))
              let mut k = sub.selections.length() - 1
              while k >= 0 {
                stack.push(SelPrintTask::Sel(sub.selections[k], ind + 1))
                k = k - 1
              }
            }
            None => sb.write_byte(10.to_byte())
          }
        }
        Selection::FragmentSpread(fs) => {
          write_indent(sb, ind)
          sb.write_string("...")
          sb.write_string(fs.name)
          if fs.directives.length() > 0 {
            write_directives(sb, fs.directives)
          }
          sb.write_byte(10.to_byte())
        }
        Selection::InlineFragment(inf) => {
          write_indent(sb, ind)
          sb.write_string("...")
          match inf.type_condition {
            Some(tc) => {
              sb.write_string(" on ")
              sb.write_string(tc)
            }
            None => ()
          }
          if inf.directives.length() > 0 {
            write_directives(sb, inf.directives)
          }
          sb.write_string(" {\n")
          stack.push(SelPrintTask::CloseBrace(ind))
          let mut k = inf.selection_set.selections.length() - 1
          while k >= 0 {
            stack.push(
              SelPrintTask::Sel(inf.selection_set.selections[k], ind + 1),
            )
            k = k - 1
          }
        }
      }
    }
  }
}

fn write_description(
  sb : StringBuilder,
  desc : Option[Description],
  indent : Int,
) -> Unit {
  match desc {
    Some(d) => {
      write_indent(sb, indent)
      if d.is_block {
        write_block_string(sb, d.value, indent)
      } else {
        write_escaped_string(sb, d.value)
      }
      sb.write_byte(10.to_byte())
    }
    None => ()
  }
}

fn write_input_value_def(sb : StringBuilder, iv : InputValueDefinition) -> Unit {
  sb.write_string(iv.name)
  sb.write_string(": ")
  write_type_ref(sb, iv.value_type)
  match iv.default_value {
    Some(v) => {
      sb.write_string(" = ")
      write_value_iter(sb, v)
    }
    None => ()
  }
  if iv.directives.length() > 0 {
    write_directives(sb, iv.directives)
  }
}

fn write_implements(sb : StringBuilder, ifaces : Array[String]) -> Unit {
  if ifaces.length() == 0 {
    return
  }
  sb.write_string(" implements ")
  let mut i = 0
  while i < ifaces.length() {
    if i > 0 {
      sb.write_string(" & ")
    }
    sb.write_string(ifaces[i])
    i = i + 1
  }
}

fn has_any_description(args : Array[InputValueDefinition]) -> Bool {
  let mut i = 0
  while i < args.length() {
    match args[i].description {
      Some(_) => return true
      None => ()
    }
    i = i + 1
  }
  false
}

fn write_arguments_def(
  sb : StringBuilder,
  args : Array[InputValueDefinition],
  base_indent : Int,
) -> Unit {
  if args.length() == 0 {
    return
  }
  if has_any_description(args) {
    sb.write_string("(\n")
    let arg_indent = base_indent + 1
    let mut a = 0
    while a < args.length() {
      write_description(sb, args[a].description, arg_indent)
      write_indent(sb, arg_indent)
      write_input_value_def(sb, args[a])
      sb.write_byte(10.to_byte())
      a = a + 1
    }
    write_indent(sb, base_indent)
    sb.write_byte(41.to_byte())
  } else {
    sb.write_byte(40.to_byte())
    let mut a = 0
    while a < args.length() {
      if a > 0 {
        sb.write_string(", ")
      }
      write_input_value_def(sb, args[a])
      a = a + 1
    }
    sb.write_byte(41.to_byte())
  }
}

fn write_fields_def(sb : StringBuilder, fields : Array[FieldDefinition]) -> Unit {
  if fields.length() == 0 {
    return
  }
  sb.write_string(" {\n")
  let mut i = 0
  while i < fields.length() {
    let f = fields[i]
    write_description(sb, f.description, 1)
    write_indent(sb, 1)
    sb.write_string(f.name)
    write_arguments_def(sb, f.arguments, 1)
    sb.write_string(": ")
    write_type_ref(sb, f.field_type)
    if f.directives.length() > 0 {
      write_directives(sb, f.directives)
    }
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  sb.write_byte(125.to_byte())
}

fn write_input_fields_def(
  sb : StringBuilder,
  fields : Array[InputValueDefinition],
) -> Unit {
  if fields.length() == 0 {
    return
  }
  sb.write_string(" {\n")
  let mut i = 0
  while i < fields.length() {
    write_description(sb, fields[i].description, 1)
    write_indent(sb, 1)
    write_input_value_def(sb, fields[i])
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  sb.write_byte(125.to_byte())
}

fn write_enum_values_def(
  sb : StringBuilder,
  vals : Array[EnumValueDefinition],
) -> Unit {
  if vals.length() == 0 {
    return
  }
  sb.write_string(" {\n")
  let mut i = 0
  while i < vals.length() {
    write_description(sb, vals[i].description, 1)
    write_indent(sb, 1)
    sb.write_string(vals[i].name)
    if vals[i].directives.length() > 0 {
      write_directives(sb, vals[i].directives)
    }
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  sb.write_byte(125.to_byte())
}

fn write_union_members(sb : StringBuilder, members : Array[String]) -> Unit {
  if members.length() == 0 {
    return
  }
  sb.write_string(" = ")
  let mut i = 0
  while i < members.length() {
    if i > 0 {
      sb.write_string(" | ")
    }
    sb.write_string(members[i])
    i = i + 1
  }
}

fn print_document_impl(doc : Document) -> String {
  let ndefs = doc.definitions.length()
  let est_cap = if ndefs > 4 { ndefs * 160 } else { 512 }
  let sb = StringBuilder::with_capacity(est_cap)
  let sel_stack : Array[SelPrintTask] = Array::with_capacity(16)
  let mut i = 0
  while i < ndefs {
    if i > 0 {
      sb.write_string("\n\n")
    }
    match doc.definitions[i] {
      Definition::Operation(op) => {
        if op.is_shorthand {
          write_selection_set_iter(sb, op.selection_set, 0, sel_stack)
        } else {
          sb.write_string(operation_type_to_string(op.op_type))
          match op.name {
            Some(n) => {
              sb.write_byte(32.to_byte())
              sb.write_string(n)
            }
            None => ()
          }
          if op.variable_definitions.length() > 0 {
            sb.write_byte(40.to_byte())
            let mut v = 0
            while v < op.variable_definitions.length() {
              if v > 0 {
                sb.write_string(", ")
              }
              let vd = op.variable_definitions[v]
              sb.write_byte(36.to_byte())
              sb.write_string(vd.name)
              sb.write_string(": ")
              write_type_ref(sb, vd.var_type)
              match vd.default_value {
                Some(dv) => {
                  sb.write_string(" = ")
                  write_value_iter(sb, dv)
                }
                None => ()
              }
              if vd.directives.length() > 0 {
                write_directives(sb, vd.directives)
              }
              v = v + 1
            }
            sb.write_byte(41.to_byte())
          }
          if op.directives.length() > 0 {
            write_directives(sb, op.directives)
          }
          sb.write_byte(32.to_byte())
          write_selection_set_iter(sb, op.selection_set, 0, sel_stack)
        }
      }
      Definition::Fragment(frag) => {
        sb.write_string("fragment ")
        sb.write_string(frag.name)
        sb.write_string(" on ")
        sb.write_string(frag.type_condition)
        if frag.directives.length() > 0 {
          write_directives(sb, frag.directives)
        }
        sb.write_byte(32.to_byte())
        write_selection_set_iter(sb, frag.selection_set, 0, sel_stack)
      }
      Definition::Schema(s) => {
        write_description(sb, s.description, 0)
        sb.write_string("schema")
        write_directives(sb, s.directives)
        sb.write_string(" {\n")
        let mut k = 0
        while k < s.operation_types.length() {
          write_indent(sb, 1)
          sb.write_string(operation_type_to_string(s.operation_types[k].op_type))
          sb.write_string(": ")
          sb.write_string(s.operation_types[k].named_type)
          sb.write_byte(10.to_byte())
          k = k + 1
        }
        sb.write_byte(125.to_byte())
      }
      Definition::SchemaExtension(s) => {
        sb.write_string("extend schema")
        write_directives(sb, s.directives)
        if s.operation_types.length() > 0 {
          sb.write_string(" {\n")
          let mut k = 0
          while k < s.operation_types.length() {
            write_indent(sb, 1)
            sb.write_string(
              operation_type_to_string(s.operation_types[k].op_type),
            )
            sb.write_string(": ")
            sb.write_string(s.operation_types[k].named_type)
            sb.write_byte(10.to_byte())
            k = k + 1
          }
          sb.write_byte(125.to_byte())
        }
      }
      Definition::DirectiveDef(dd) => {
        write_description(sb, dd.description, 0)
        sb.write_string("directive @")
        sb.write_string(dd.name)
        write_arguments_def(sb, dd.arguments, 0)
        if dd.repeatable {
          sb.write_string(" repeatable")
        }
        sb.write_string(" on ")
        let mut l = 0
        while l < dd.locations.length() {
          if l > 0 {
            sb.write_string(" | ")
          }
          sb.write_string(dd.locations[l])
          l = l + 1
        }
      }
      Definition::TypeDef(td) =>
      match td {
        TypeDefinition::Scalar(sc) => {
          write_description(sb, sc.description, 0)
          sb.write_string("scalar ")
          sb.write_string(sc.name)
          write_directives(sb, sc.directives)
        }
        TypeDefinition::Object(obj) => {
          write_description(sb, obj.description, 0)
          sb.write_string("type ")
          sb.write_string(obj.name)
          write_implements(sb, obj.implements_interfaces)
          write_directives(sb, obj.directives)
          write_fields_def(sb, obj.fields)
        }
        TypeDefinition::Interface(inf) => {
          write_description(sb, inf.description, 0)
          sb.write_string("interface ")
          sb.write_string(inf.name)
          write_implements(sb, inf.implements_interfaces)
          write_directives(sb, inf.directives)
          write_fields_def(sb, inf.fields)
        }
        TypeDefinition::Union(u) => {
          write_description(sb, u.description, 0)
          sb.write_string("union ")
          sb.write_string(u.name)
          write_directives(sb, u.directives)
          write_union_members(sb, u.members)
        }
        TypeDefinition::Enum(en) => {
          write_description(sb, en.description, 0)
          sb.write_string("enum ")
          sb.write_string(en.name)
          write_directives(sb, en.directives)
          write_enum_values_def(sb, en.values)
        }
        TypeDefinition::InputObject(io) => {
          write_description(sb, io.description, 0)
          sb.write_string("input ")
          sb.write_string(io.name)
          write_directives(sb, io.directives)
          write_input_fields_def(sb, io.fields)
        }
      }
      Definition::TypeExtension(te) =>
      match te {
        TypeExtension::Scalar(sc) => {
          sb.write_string("extend scalar ")
          sb.write_string(sc.name)
          write_directives(sb, sc.directives)
        }
        TypeExtension::Object(obj) => {
          sb.write_string("extend type ")
          sb.write_string(obj.name)
          write_implements(sb, obj.implements_interfaces)
          write_directives(sb, obj.directives)
          write_fields_def(sb, obj.fields)
        }
        TypeExtension::Interface(inf) => {
          sb.write_string("extend interface ")
          sb.write_string(inf.name)
          write_implements(sb, inf.implements_interfaces)
          write_directives(sb, inf.directives)
          write_fields_def(sb, inf.fields)
        }
        TypeExtension::Union(u) => {
          sb.write_string("extend union ")
          sb.write_string(u.name)
          write_directives(sb, u.directives)
          write_union_members(sb, u.members)
        }
        TypeExtension::Enum(en) => {
          sb.write_string("extend enum ")
          sb.write_string(en.name)
          write_directives(sb, en.directives)
          write_enum_values_def(sb, en.values)
        }
        TypeExtension::InputObject(io) => {
          sb.write_string("extend input ")
          sb.write_string(io.name)
          write_directives(sb, io.directives)
          write_input_fields_def(sb, io.fields)
        }
      }
    }
    i = i + 1
  }
  sb.to_string()
}

///| Single-pass streaming GraphQL minifier using zero-allocation raw lexer cursor
///| and `write_substring` direct output.
fn minify_query_impl(
  src : String,
  opts : ParseOptions,
) -> Result[String, GraphqlError] {
  let lex = Lexer::new(src, opts.max_tokens)
  let sb = StringBuilder::with_capacity(src.length())
  let mut prev_non_punct = false
  while true {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let tag = lex.tok_tag
    if tag == tok_eof {
      break
    }
    let is_non_punct = tag >= tok_name
    if prev_non_punct && (is_non_punct || tag == tok_spread) {
      sb.write_byte(32.to_byte())
    }
    if tag == tok_block_str {
      write_block_string_impl(sb, lex.tok_decoded, 0, true)
    } else if tag == tok_spread {
      sb.write_string("...")
    } else if is_non_punct {
      sb.write_substring(src, lex.tok_start, lex.tok_end)
    } else {
      sb.write_byte(src.code_unit_at(lex.tok_start).to_byte())
    }
    prev_non_punct = is_non_punct
  }
  Ok(sb.to_string())
}
