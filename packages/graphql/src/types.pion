///| Core types, options, tokens, and errors for `graphql` (GraphQL October 2021).

///| Category of a GraphQL lexing or parsing error.
pub enum ErrorKind {
  InvalidSyntax
  InvalidUtf8
  UnexpectedToken
  UnexpectedEof
  LimitExceeded
  Unimplemented
}

///|
pub fn error_kind_eq(self : ErrorKind, other : ErrorKind) -> Bool {
  match (self, other) {
    (ErrorKind::InvalidSyntax, ErrorKind::InvalidSyntax) => true
    (ErrorKind::InvalidUtf8, ErrorKind::InvalidUtf8) => true
    (ErrorKind::UnexpectedToken, ErrorKind::UnexpectedToken) => true
    (ErrorKind::UnexpectedEof, ErrorKind::UnexpectedEof) => true
    (ErrorKind::LimitExceeded, ErrorKind::LimitExceeded) => true
    (ErrorKind::Unimplemented, ErrorKind::Unimplemented) => true
    _ => false
  }
}

///|
pub fn error_kind_to_string(self : ErrorKind) -> String {
  match self {
    ErrorKind::InvalidSyntax => "InvalidSyntax"
    ErrorKind::InvalidUtf8 => "InvalidUtf8"
    ErrorKind::UnexpectedToken => "UnexpectedToken"
    ErrorKind::UnexpectedEof => "UnexpectedEof"
    ErrorKind::LimitExceeded => "LimitExceeded"
    ErrorKind::Unimplemented => "Unimplemented"
  }
}

///| Lexing or parsing error with 1-based line/column and 0-based byte offset.
pub struct GraphqlError {
  pub kind : ErrorKind
  pub line : Int
  pub col : Int
  pub offset : Int
  pub message : String
}

///|
pub fn GraphqlError::new(
  kind : ErrorKind,
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> GraphqlError {
  GraphqlError::{
    kind: kind,
    line: line,
    col: col,
    offset: offset,
    message: message,
  }
}

///|
pub fn GraphqlError::to_string(self : GraphqlError) -> String {
  error_kind_to_string(self.kind) +
  " at " +
  self.line.to_string() +
  ":" +
  self.col.to_string() +
  " (offset " +
  self.offset.to_string() +
  "): " +
  self.message
}

///| Resource budgets and parser limits (Day-1 DoS protection).
pub val struct ParseOptions {
  pub max_depth : Int
  pub max_tokens : Int
  pub max_nodes : Int
}

///| Default parser options (`max_depth = 128`, `max_tokens = 500_000`, `max_nodes = 500_000`).
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{ max_depth: 128, max_tokens: 500000, max_nodes: 500000 }
}

///| Construct custom `ParseOptions`.
pub fn ParseOptions::new(
  max_depth : Int,
  max_tokens : Int,
  max_nodes : Int,
) -> ParseOptions {
  ParseOptions::{
    max_depth: max_depth,
    max_tokens: max_tokens,
    max_nodes: max_nodes,
  }
}

///| Security and structural limits for executable document validation.
pub val struct ValidationOptions {
  pub max_depth : Int
  pub max_aliases : Int
  pub max_fields : Int
}

///| Default validation options (`max_depth = 64`, `max_aliases = 100`, `max_fields = 1000`).
pub fn ValidationOptions::default() -> ValidationOptions {
  ValidationOptions::{ max_depth: 64, max_aliases: 100, max_fields: 1000 }
}

///| Construct custom `ValidationOptions`.
pub fn ValidationOptions::new(
  max_depth : Int,
  max_aliases : Int,
  max_fields : Int,
) -> ValidationOptions {
  ValidationOptions::{
    max_depth: max_depth,
    max_aliases: max_aliases,
    max_fields: max_fields,
  }
}

///| Category of a static validation error on an executable GraphQL document.
pub enum ValidationErrorKind {
  DuplicateOperationName
  LoneAnonymousOperation
  DuplicateVariableName
  DuplicateArgumentName
  DuplicateInputFieldName
  DuplicateFragmentName
  UndefinedFragment
  FragmentCycle
  MaxDepthExceeded
  MaxAliasesExceeded
  MaxFieldsExceeded
}

///|
pub fn validation_error_kind_eq(
  self : ValidationErrorKind,
  other : ValidationErrorKind,
) -> Bool {
  match (self, other) {
    (
      ValidationErrorKind::DuplicateOperationName,
      ValidationErrorKind::DuplicateOperationName,
    ) => true
    (
      ValidationErrorKind::LoneAnonymousOperation,
      ValidationErrorKind::LoneAnonymousOperation,
    ) => true
    (
      ValidationErrorKind::DuplicateVariableName,
      ValidationErrorKind::DuplicateVariableName,
    ) => true
    (
      ValidationErrorKind::DuplicateArgumentName,
      ValidationErrorKind::DuplicateArgumentName,
    ) => true
    (
      ValidationErrorKind::DuplicateInputFieldName,
      ValidationErrorKind::DuplicateInputFieldName,
    ) => true
    (
      ValidationErrorKind::DuplicateFragmentName,
      ValidationErrorKind::DuplicateFragmentName,
    ) => true
    (
      ValidationErrorKind::UndefinedFragment,
      ValidationErrorKind::UndefinedFragment,
    ) => true
    (ValidationErrorKind::FragmentCycle, ValidationErrorKind::FragmentCycle) =>
    true
    (
      ValidationErrorKind::MaxDepthExceeded,
      ValidationErrorKind::MaxDepthExceeded,
    ) => true
    (
      ValidationErrorKind::MaxAliasesExceeded,
      ValidationErrorKind::MaxAliasesExceeded,
    ) => true
    (
      ValidationErrorKind::MaxFieldsExceeded,
      ValidationErrorKind::MaxFieldsExceeded,
    ) => true
    _ => false
  }
}

///|
pub fn validation_error_kind_to_string(self : ValidationErrorKind) -> String {
  match self {
    ValidationErrorKind::DuplicateOperationName => "DuplicateOperationName"
    ValidationErrorKind::LoneAnonymousOperation => "LoneAnonymousOperation"
    ValidationErrorKind::DuplicateVariableName => "DuplicateVariableName"
    ValidationErrorKind::DuplicateArgumentName => "DuplicateArgumentName"
    ValidationErrorKind::DuplicateInputFieldName => "DuplicateInputFieldName"
    ValidationErrorKind::DuplicateFragmentName => "DuplicateFragmentName"
    ValidationErrorKind::UndefinedFragment => "UndefinedFragment"
    ValidationErrorKind::FragmentCycle => "FragmentCycle"
    ValidationErrorKind::MaxDepthExceeded => "MaxDepthExceeded"
    ValidationErrorKind::MaxAliasesExceeded => "MaxAliasesExceeded"
    ValidationErrorKind::MaxFieldsExceeded => "MaxFieldsExceeded"
  }
}

///| Static validation error produced by `validate_executable`.
pub struct ValidationError {
  pub kind : ValidationErrorKind
  pub message : String
}

///|
pub fn ValidationError::new(
  kind : ValidationErrorKind,
  message : String,
) -> ValidationError {
  ValidationError::{ kind: kind, message: message }
}

///|
pub fn ValidationError::to_string(self : ValidationError) -> String {
  validation_error_kind_to_string(self.kind) + ": " + self.message
}

///| GraphQL October 2021 lexical token kind.
pub enum TokenKind {
  Bang
  Dollar
  Amp
  LParen
  RParen
  Spread
  Colon
  Equals
  At
  LBracket
  RBracket
  LBrace
  Pipe
  RBrace
  Name(String)
  Int(String)
  Float(String)
  Str(String)
  BlockStr(String)
  Eof
}

///|
pub fn token_kind_eq(self : TokenKind, other : TokenKind) -> Bool {
  match (self, other) {
    (TokenKind::Bang, TokenKind::Bang) => true
    (TokenKind::Dollar, TokenKind::Dollar) => true
    (TokenKind::Amp, TokenKind::Amp) => true
    (TokenKind::LParen, TokenKind::LParen) => true
    (TokenKind::RParen, TokenKind::RParen) => true
    (TokenKind::Spread, TokenKind::Spread) => true
    (TokenKind::Colon, TokenKind::Colon) => true
    (TokenKind::Equals, TokenKind::Equals) => true
    (TokenKind::At, TokenKind::At) => true
    (TokenKind::LBracket, TokenKind::LBracket) => true
    (TokenKind::RBracket, TokenKind::RBracket) => true
    (TokenKind::LBrace, TokenKind::LBrace) => true
    (TokenKind::Pipe, TokenKind::Pipe) => true
    (TokenKind::RBrace, TokenKind::RBrace) => true
    (TokenKind::Name(a), TokenKind::Name(b)) => a == b
    (TokenKind::Int(a), TokenKind::Int(b)) => a == b
    (TokenKind::Float(a), TokenKind::Float(b)) => a == b
    (TokenKind::Str(a), TokenKind::Str(b)) => a == b
    (TokenKind::BlockStr(a), TokenKind::BlockStr(b)) => a == b
    (TokenKind::Eof, TokenKind::Eof) => true
    _ => false
  }
}

///| A single GraphQL lexical token with source location metadata.
pub struct Token {
  pub kind : TokenKind
  pub line : Int
  pub col : Int
  pub offset : Int
  pub len : Int
}
