///| Pure Pion GraphQL (October 2021) Lexer, Iterative AST Parser (Executable + SDL),
///| Formatter / Minifier, and Core Static Validator.

///| Tokenize GraphQL source using default `ParseOptions`.
pub fn tokenize(src : String) -> Result[Array[Token], GraphqlError] {
  tokenize_with_options(src, ParseOptions::default())
}

///| Tokenize GraphQL source with explicit `ParseOptions`.
pub fn tokenize_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  tokenize_impl(src, opts)
}

///| Validate UTF-8 and tokenize GraphQL source bytes using default `ParseOptions`.
pub fn tokenize_bytes(src : Bytes) -> Result[Array[Token], GraphqlError] {
  tokenize_bytes_with_options(src, ParseOptions::default())
}

///| Validate UTF-8 and tokenize GraphQL source bytes with explicit `ParseOptions`.
pub fn tokenize_bytes_with_options(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  tokenize_bytes_impl(src, opts)
}

///| Count non-EOF lexical tokens without materializing a token array.
pub fn count_tokens(src : String) -> Result[Int, GraphqlError] {
  count_tokens_impl(src)
}

///| Parse a GraphQL Document (Executable and/or Schema SDL) using default `ParseOptions`.
pub fn parse(src : String) -> Result[Document, GraphqlError] {
  parse_with_options(src, ParseOptions::default())
}

///| Parse a GraphQL Document with explicit `ParseOptions`.
pub fn parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  parse_impl(src, opts)
}

///| Validate UTF-8 and parse a GraphQL Document from raw bytes using default `ParseOptions`.
pub fn parse_bytes(src : Bytes) -> Result[Document, GraphqlError] {
  parse_bytes_with_options(src, ParseOptions::default())
}

///| Validate UTF-8 and parse a GraphQL Document from raw bytes with explicit `ParseOptions`.
pub fn parse_bytes_with_options(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  parse_bytes_impl(src, opts)
}

///| Parse a standalone GraphQL `Value` literal.
pub fn parse_value(src : String) -> Result[Value, GraphqlError] {
  parse_value_impl(src)
}

///| Parse a standalone GraphQL `TypeRef` (`[String!]!`).
pub fn parse_type(src : String) -> Result[TypeRef, GraphqlError] {
  parse_type_impl(src)
}

///| Format a GraphQL `Document` AST into canonical, human-readable GraphQL text.
pub fn print_document(doc : Document) -> String {
  print_document_impl(doc)
}

///| Minify a GraphQL document or query string (strips comments, commas, and redundant whitespace
///| without ever gluing adjacent Name, Number, or Spread tokens).
pub fn minify_query(src : String) -> Result[String, GraphqlError] {
  minify_query_with_options(src, ParseOptions::default())
}

///| Minify a GraphQL document or query string with explicit `ParseOptions`.
pub fn minify_query_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[String, GraphqlError] {
  minify_query_impl(src, opts)
}

///| Run core static validation rules on an executable GraphQL `Document` using default limits.
pub fn validate_executable(doc : Document) -> Array[ValidationError] {
  validate_executable_with_options(doc, ValidationOptions::default())
}

///| Run core static validation rules on an executable GraphQL `Document` with explicit limits.
pub fn validate_executable_with_options(
  doc : Document,
  opts : ValidationOptions,
) -> Array[ValidationError] {
  validate_executable_impl(doc, opts)
}
