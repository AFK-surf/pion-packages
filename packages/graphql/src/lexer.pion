///| High-performance GraphQL (October 2021) streaming Lexer with 256-byte ASCII LUT.

let lut_name_start : Int = 1

let lut_name_cont : Int = 2

let lut_digit : Int = 4

let lut_hex : Int = 8

let lut_space : Int = 16

let lut_line_term : Int = 32

fn build_ascii_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  // Whitespace & comma (Ignored tokens)
  lut[9] = lut_space // \t
  lut[32] = lut_space // ' '
  lut[44] = lut_space // ','
  // Line terminators
  lut[10] = lut_line_term // \n
  lut[13] = lut_line_term // \r
  // Digits 0-9
  let mut b = 48
  while b <= 57 {
    lut[b] = lut_name_cont | lut_digit | lut_hex
    b = b + 1
  }
  // Uppercase A-Z
  b = 65
  while b <= 90 {
    let mut flags = lut_name_start | lut_name_cont
    if b <= 70 {
      flags = flags | lut_hex
    }
    lut[b] = flags
    b = b + 1
  }
  // Lowercase a-z
  b = 97
  while b <= 122 {
    let mut flags = lut_name_start | lut_name_cont
    if b <= 102 {
      flags = flags | lut_hex
    }
    lut[b] = flags
    b = b + 1
  }
  // Underscore '_'
  lut[95] = lut_name_start | lut_name_cont
  lut
}

let ascii_lut : FixedArray[Int] = build_ascii_lut()

fn hex_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Bool {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    return false
  }
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  true
}

///| Strictly validate RFC 3629 UTF-8 bytes and convert to `String`.
pub fn validate_utf8_bytes(src : Bytes) -> Result[String, GraphqlError] {
  let n = src.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut line = 1
  let mut line_start = 0
  while i < n {
    let b0 = src[i].to_int()
    if b0 < 0x80 {
      if b0 == 10 {
        line = line + 1
        line_start = i + 1
      } else if b0 == 13 {
        line = line + 1
        if i + 1 < n && src[i + 1].to_int() == 10 {
          sb.write_byte(b0.to_byte())
          i = i + 1
          sb.write_byte(10.to_byte())
          line_start = i + 1
          i = i + 1
          continue
        }
        line_start = i + 1
      }
      sb.write_byte(b0.to_byte())
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "truncated 2-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "invalid 2-byte UTF-8 continuation",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "truncated 3-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      let b2 = src[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "invalid 3-byte UTF-8 continuation",
          ),
        )
      }
      // Reject overlong (E0 80..9F) and UTF-16 surrogates (ED A0..BF)
      if (b0 == 0xE0 && b1 < 0xA0) || (b0 == 0xED && b1 >= 0xA0) {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "overlong or surrogate 3-byte UTF-8 sequence",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      sb.write_byte(b2.to_byte())
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "truncated 4-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      let b2 = src[i + 2].to_int()
      let b3 = src[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "invalid 4-byte UTF-8 continuation",
          ),
        )
      }
      if (b0 == 0xF0 && b1 < 0x90) || (b0 == 0xF4 && b1 > 0x8F) {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            i - line_start + 1,
            i,
            "overlong or out-of-range 4-byte UTF-8 sequence",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      sb.write_byte(b2.to_byte())
      sb.write_byte(b3.to_byte())
      i = i + 4
    } else {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidUtf8,
          line,
          i - line_start + 1,
          i,
          "invalid UTF-8 lead byte",
        ),
      )
    }
  }
  Ok(sb.to_string())
}

fn is_invalid_source_byte(b : Int) -> Bool {
  (b < 0x20 && b != 9 && b != 10 && b != 13) || b == 0x7F
}

///| Apply GraphQL October 2021 §2.9.4 `BlockStringValue` indentation stripping.
fn dedent_block_string(raw : String) -> String {
  let n = raw.length()
  if n == 0 {
    return ""
  }
  let lines : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < n {
    let b = raw.code_unit_at(i)
    if b == 10 {
      lines.push(raw.slice(start, i))
      i = i + 1
      start = i
    } else if b == 13 {
      lines.push(raw.slice(start, i))
      if i + 1 < n && raw.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      start = i
    } else {
      i = i + 1
    }
  }
  lines.push(raw.slice(start, n))

  let num_lines = lines.length()
  let mut common_indent = -1
  let mut li = 1
  while li < num_lines {
    let ln = lines[li]
    let l_len = ln.length()
    let mut ind = 0
    while ind < l_len {
      let c = ln.code_unit_at(ind)
      if c == 32 || c == 9 {
        ind = ind + 1
      } else {
        break
      }
    }
    if ind < l_len {
      if common_indent < 0 || ind < common_indent {
        common_indent = ind
      }
    }
    li = li + 1
  }

  // Strip common_indent from lines[1..]
  if common_indent > 0 {
    li = 1
    while li < num_lines {
      let ln = lines[li]
      if ln.length() >= common_indent {
        lines[li] = ln.slice(common_indent, ln.length())
      } else {
        lines[li] = ""
      }
      li = li + 1
    }
  }

  // Trim leading blank lines
  let mut first = 0
  while first < num_lines {
    let ln = lines[first]
    let mut k = 0
    let mut blank = true
    while k < ln.length() {
      let c = ln.code_unit_at(k)
      if c != 32 && c != 9 {
        blank = false
        break
      }
      k = k + 1
    }
    if blank {
      first = first + 1
    } else {
      break
    }
  }

  // Trim trailing blank lines
  let mut last = num_lines - 1
  while last >= first {
    let ln = lines[last]
    let mut k = 0
    let mut blank = true
    while k < ln.length() {
      let c = ln.code_unit_at(k)
      if c != 32 && c != 9 {
        blank = false
        break
      }
      k = k + 1
    }
    if blank {
      last = last - 1
    } else {
      break
    }
  }

  if first > last {
    return ""
  }
  if first == last {
    return lines[first]
  }
  let sb = StringBuilder::new()
  let mut idx = first
  while idx <= last {
    if idx > first {
      sb.write_byte(10.to_byte())
    }
    sb.write_string(lines[idx])
    idx = idx + 1
  }
  sb.to_string()
}

///| Streaming zero-allocation GraphQL Lexer.
struct Lexer {
  src : String
  len : Int
  mut pos : Int
  mut line : Int
  mut line_start : Int
  mut token_count : Int
  max_tokens : Int
}

fn Lexer::new(src : String, max_tokens : Int) -> Lexer {
  Lexer::{
    src: src,
    len: src.length(),
    pos: 0,
    line: 1,
    line_start: 0,
    token_count: 0,
    max_tokens: max_tokens,
  }
}

fn Lexer::skip_ignored(self : Lexer) -> Result[Unit, GraphqlError] {
  let src = self.src
  let len = self.len
  let mut p = self.pos
  while p < len {
    let b = src.code_unit_at(p)
    let fl = ascii_lut[b]
    if (fl & lut_space) != 0 {
      p = p + 1
    } else if b == 10 {
      p = p + 1
      self.line = self.line + 1
      self.line_start = p
    } else if b == 13 {
      p = p + 1
      if p < len && src.code_unit_at(p) == 10 {
        p = p + 1
      }
      self.line = self.line + 1
      self.line_start = p
    } else if b == 35 {
      // Comment '#' until line terminator or EOF
      p = p + 1
      while p < len {
        let cb = src.code_unit_at(p)
        if cb == 10 || cb == 13 {
          break
        }
        if is_invalid_source_byte(cb) {
          self.pos = p
          return Err(
            GraphqlError::new(
              ErrorKind::InvalidSyntax,
              self.line,
              p - self.line_start + 1,
              p,
              "invalid control character in comment",
            ),
          )
        }
        p = p + 1
      }
    } else if b == 0xEF &&
    p + 2 < len &&
    src.code_unit_at(p + 1) == 0xBB &&
    src.code_unit_at(p + 2) == 0xBF {
      // Unicode BOM U+FEFF (ignored token)
      p = p + 3
    } else {
      break
    }
  }
  self.pos = p
  Ok(())
}

fn Lexer::read_number(
  self : Lexer,
  start : Int,
  line : Int,
  col : Int,
) -> Result[Token, GraphqlError] {
  let src = self.src
  let len = self.len
  let mut p = start
  let mut is_float = false

  if p < len && src.code_unit_at(p) == 45 {
    // '-'
    p = p + 1
  }
  if p >= len {
    return Err(
      GraphqlError::new(
        ErrorKind::InvalidSyntax,
        line,
        p - self.line_start + 1,
        p,
        "unexpected end of input in number",
      ),
    )
  }
  let d0 = src.code_unit_at(p)
  if d0 == 48 {
    // '0': must NOT be followed by another digit
    p = p + 1
    if p < len && (ascii_lut[src.code_unit_at(p)] & lut_digit) != 0 {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          p - self.line_start + 1,
          p,
          "invalid number: leading zero not allowed",
        ),
      )
    }
  } else if d0 >= 49 && d0 <= 57 {
    p = p + 1
    while p < len && (ascii_lut[src.code_unit_at(p)] & lut_digit) != 0 {
      p = p + 1
    }
  } else {
    return Err(
      GraphqlError::new(
        ErrorKind::InvalidSyntax,
        line,
        p - self.line_start + 1,
        p,
        "invalid number: expected digit",
      ),
    )
  }

  // Optional fractional part: '.' [0-9]+
  if p < len && src.code_unit_at(p) == 46 {
    is_float = true
    p = p + 1
    if p >= len || (ascii_lut[src.code_unit_at(p)] & lut_digit) == 0 {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          p - self.line_start + 1,
          p,
          "invalid float: expected digit after '.'",
        ),
      )
    }
    while p < len && (ascii_lut[src.code_unit_at(p)] & lut_digit) != 0 {
      p = p + 1
    }
  }

  // Optional exponent part: [eE] [+-]? [0-9]+
  if p < len {
    let eb = src.code_unit_at(p)
    if eb == 101 || eb == 69 {
      is_float = true
      p = p + 1
      if p < len {
        let sb = src.code_unit_at(p)
        if sb == 43 || sb == 45 {
          p = p + 1
        }
      }
      if p >= len || (ascii_lut[src.code_unit_at(p)] & lut_digit) == 0 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidSyntax,
            line,
            p - self.line_start + 1,
            p,
            "invalid float: expected digit in exponent",
          ),
        )
      }
      while p < len && (ascii_lut[src.code_unit_at(p)] & lut_digit) != 0 {
        p = p + 1
      }
    }
  }

  // GraphQL Oct 2021 lookahead restriction: must not be followed by '.' or NameStart
  if p < len {
    let nb = src.code_unit_at(p)
    if nb == 46 || (ascii_lut[nb] & lut_name_start) != 0 {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          p - self.line_start + 1,
          p,
          "invalid number: unexpected character immediately following number",
        ),
      )
    }
  }

  self.pos = p
  let text = src.slice(start, p)
  let kind = if is_float { TokenKind::Float(text) } else { TokenKind::Int(text) }
  Ok(Token::{ kind: kind, line: line, col: col, offset: start, len: p - start })
}

fn Lexer::read_string(
  self : Lexer,
  start : Int,
  line : Int,
  col : Int,
) -> Result[Token, GraphqlError] {
  let src = self.src
  let len = self.len
  let mut p = start + 1
  // Fast zero-copy path for strings without escapes
  let mut has_escape = false
  let mut fast_end = p
  while fast_end < len {
    let b = src.code_unit_at(fast_end)
    if b == 34 {
      self.pos = fast_end + 1
      return Ok(
        Token::{
          kind: TokenKind::Str(src.slice(start + 1, fast_end)),
          line: line,
          col: col,
          offset: start,
          len: fast_end + 1 - start,
        },
      )
    } else if b == 92 {
      has_escape = true
      break
    } else if b == 10 || b == 13 {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          fast_end - self.line_start + 1,
          fast_end,
          "unterminated string literal before line terminator",
        ),
      )
    } else if is_invalid_source_byte(b) {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          fast_end - self.line_start + 1,
          fast_end,
          "invalid control character in string literal",
        ),
      )
    }
    fast_end = fast_end + 1
  }
  if !has_escape {
    return Err(
      GraphqlError::new(
        ErrorKind::UnexpectedEof,
        line,
        fast_end - self.line_start + 1,
        fast_end,
        "unterminated string literal",
      ),
    )
  }

  // Slow path with escape decoding
  let sb = StringBuilder::new()
  if fast_end > start + 1 {
    sb.write_string(src.slice(start + 1, fast_end))
  }
  p = fast_end
  while p < len {
    let b = src.code_unit_at(p)
    if b == 34 {
      self.pos = p + 1
      return Ok(
        Token::{
          kind: TokenKind::Str(sb.to_string()),
          line: line,
          col: col,
          offset: start,
          len: p + 1 - start,
        },
      )
    } else if b == 10 || b == 13 {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          p - self.line_start + 1,
          p,
          "unterminated string literal before line terminator",
        ),
      )
    } else if is_invalid_source_byte(b) {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          line,
          p - self.line_start + 1,
          p,
          "invalid control character in string literal",
        ),
      )
    } else if b == 92 {
      p = p + 1
      if p >= len {
        return Err(
          GraphqlError::new(
            ErrorKind::UnexpectedEof,
            line,
            p - self.line_start + 1,
            p,
            "unterminated escape sequence in string",
          ),
        )
      }
      let esc = src.code_unit_at(p)
      if esc == 34 {
        sb.write_byte(34.to_byte())
        p = p + 1
      } else if esc == 92 {
        sb.write_byte(92.to_byte())
        p = p + 1
      } else if esc == 47 {
        sb.write_byte(47.to_byte())
        p = p + 1
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
        p = p + 1
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
        p = p + 1
      } else if esc == 110 {
        sb.write_byte(10.to_byte())
        p = p + 1
      } else if esc == 114 {
        sb.write_byte(13.to_byte())
        p = p + 1
      } else if esc == 116 {
        sb.write_byte(9.to_byte())
        p = p + 1
      } else if esc == 117 {
        p = p + 1
        if p < len && src.code_unit_at(p) == 123 {
          // Oct 2021 variable-length Unicode escape \u{X...}
          p = p + 1
          let mut cp = 0
          let mut digits = 0
          let mut overflow = false
          while p < len {
            let hb = src.code_unit_at(p)
            if hb == 125 {
              break
            }
            let hv = hex_digit_val(hb)
            if hv < 0 {
              return Err(
                GraphqlError::new(
                  ErrorKind::InvalidSyntax,
                  line,
                  p - self.line_start + 1,
                  p,
                  "invalid hex digit in \\u{...} escape",
                ),
              )
            }
            digits = digits + 1
            if !overflow {
              cp = (cp << 4) | hv
              if cp > 0x10FFFF {
                overflow = true
              }
            }
            p = p + 1
          }
          if p >= len || src.code_unit_at(p) != 125 || digits == 0 {
            return Err(
              GraphqlError::new(
                ErrorKind::InvalidSyntax,
                line,
                p - self.line_start + 1,
                p,
                "invalid or unterminated \\u{...} escape",
              ),
            )
          }
          p = p + 1
          if overflow || !write_utf8_cp(sb, cp) {
            return Err(
              GraphqlError::new(
                ErrorKind::InvalidSyntax,
                line,
                p - self.line_start + 1,
                p,
                "invalid Unicode scalar value in \\u{...} escape",
              ),
            )
          }
        } else {
          // Fixed 4-hex-digit \uXXXX (with UTF-16 surrogate pair combining)
          if p + 4 > len {
            return Err(
              GraphqlError::new(
                ErrorKind::InvalidSyntax,
                line,
                p - self.line_start + 1,
                p,
                "incomplete \\uXXXX escape",
              ),
            )
          }
          let h0 = hex_digit_val(src.code_unit_at(p))
          let h1 = hex_digit_val(src.code_unit_at(p + 1))
          let h2 = hex_digit_val(src.code_unit_at(p + 2))
          let h3 = hex_digit_val(src.code_unit_at(p + 3))
          if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
            return Err(
              GraphqlError::new(
                ErrorKind::InvalidSyntax,
                line,
                p - self.line_start + 1,
                p,
                "invalid hex digit in \\uXXXX escape",
              ),
            )
          }
          let u1 = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
          p = p + 4
          if u1 >= 0xD800 && u1 <= 0xDBFF {
            // High surrogate: must be immediately followed by \uYYYY low surrogate
            if p + 6 > len ||
            src.code_unit_at(p) != 92 ||
            src.code_unit_at(p + 1) != 117 {
              return Err(
                GraphqlError::new(
                  ErrorKind::InvalidSyntax,
                  line,
                  p - self.line_start + 1,
                  p,
                  "unpaired high surrogate in string escape",
                ),
              )
            }
            let l0 = hex_digit_val(src.code_unit_at(p + 2))
            let l1 = hex_digit_val(src.code_unit_at(p + 3))
            let l2 = hex_digit_val(src.code_unit_at(p + 4))
            let l3 = hex_digit_val(src.code_unit_at(p + 5))
            if l0 < 0 || l1 < 0 || l2 < 0 || l3 < 0 {
              return Err(
                GraphqlError::new(
                  ErrorKind::InvalidSyntax,
                  line,
                  p - self.line_start + 1,
                  p,
                  "invalid hex digit in low surrogate escape",
                ),
              )
            }
            let u2 = (l0 << 12) | (l1 << 8) | (l2 << 4) | l3
            if u2 < 0xDC00 || u2 > 0xDFFF {
              return Err(
                GraphqlError::new(
                  ErrorKind::InvalidSyntax,
                  line,
                  p - self.line_start + 1,
                  p,
                  "expected low surrogate after high surrogate",
                ),
              )
            }
            let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
            let _ = write_utf8_cp(sb, cp)
            p = p + 6
          } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
            return Err(
              GraphqlError::new(
                ErrorKind::InvalidSyntax,
                line,
                p - self.line_start + 1,
                p,
                "unpaired low surrogate in string escape",
              ),
            )
          } else {
            let _ = write_utf8_cp(sb, u1)
          }
        }
      } else {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidSyntax,
            line,
            p - self.line_start + 1,
            p,
            "invalid escape sequence in string",
          ),
        )
      }
    } else {
      sb.write_byte(b.to_byte())
      p = p + 1
    }
  }
  Err(
    GraphqlError::new(
      ErrorKind::UnexpectedEof,
      line,
      p - self.line_start + 1,
      p,
      "unterminated string literal",
    ),
  )
}

fn Lexer::read_block_string(
  self : Lexer,
  start : Int,
  line : Int,
  col : Int,
) -> Result[Token, GraphqlError] {
  let src = self.src
  let len = self.len
  let mut p = start + 3
  let sb = StringBuilder::new()
  let mut chunk_start = p
  while p < len {
    let b = src.code_unit_at(p)
    if b == 34 &&
    p + 2 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 {
      if p > chunk_start {
        sb.write_string(src.slice(chunk_start, p))
      }
      self.pos = p + 3
      let dedented = dedent_block_string(sb.to_string())
      return Ok(
        Token::{
          kind: TokenKind::BlockStr(dedented),
          line: line,
          col: col,
          offset: start,
          len: p + 3 - start,
        },
      )
    } else if b == 92 &&
    p + 3 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 &&
    src.code_unit_at(p + 3) == 34 {
      if p > chunk_start {
        sb.write_string(src.slice(chunk_start, p))
      }
      sb.write_string("\"\"\"")
      p = p + 4
      chunk_start = p
    } else if b == 10 {
      p = p + 1
      self.line = self.line + 1
      self.line_start = p
    } else if b == 13 {
      p = p + 1
      if p < len && src.code_unit_at(p) == 10 {
        p = p + 1
      }
      self.line = self.line + 1
      self.line_start = p
    } else if is_invalid_source_byte(b) {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          self.line,
          p - self.line_start + 1,
          p,
          "invalid control character in block string",
        ),
      )
    } else {
      p = p + 1
    }
  }
  Err(
    GraphqlError::new(
      ErrorKind::UnexpectedEof,
      line,
      col,
      start,
      "unterminated block string",
    ),
  )
}

fn Lexer::next_token(self : Lexer) -> Result[Token, GraphqlError] {
  match self.skip_ignored() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let p = self.pos
  let line = self.line
  let col = p - self.line_start + 1
  if p >= self.len {
    return Ok(
      Token::{ kind: TokenKind::Eof, line: line, col: col, offset: p, len: 0 },
    )
  }
  if self.token_count >= self.max_tokens {
    return Err(
      GraphqlError::new(
        ErrorKind::LimitExceeded,
        line,
        col,
        p,
        "max_tokens limit exceeded",
      ),
    )
  }
  self.token_count = self.token_count + 1
  let src = self.src
  let len = self.len
  let b = src.code_unit_at(p)

  // Fast path: Name ([_A-Za-z][_0-9A-Za-z]*)
  if (ascii_lut[b] & lut_name_start) != 0 {
    let mut end = p + 1
    while end < len && (ascii_lut[src.code_unit_at(end)] & lut_name_cont) != 0 {
      end = end + 1
    }
    self.pos = end
    return Ok(
      Token::{
        kind: TokenKind::Name(src.slice(p, end)),
        line: line,
        col: col,
        offset: p,
        len: end - p,
      },
    )
  }

  // Punctuators
  if b == 123 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::LBrace, line: line, col: col, offset: p, len: 1 })
  }
  if b == 125 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::RBrace, line: line, col: col, offset: p, len: 1 })
  }
  if b == 40 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::LParen, line: line, col: col, offset: p, len: 1 })
  }
  if b == 41 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::RParen, line: line, col: col, offset: p, len: 1 })
  }
  if b == 58 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Colon, line: line, col: col, offset: p, len: 1 })
  }
  if b == 33 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Bang, line: line, col: col, offset: p, len: 1 })
  }
  if b == 36 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Dollar, line: line, col: col, offset: p, len: 1 })
  }
  if b == 64 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::At, line: line, col: col, offset: p, len: 1 })
  }
  if b == 91 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::LBracket, line: line, col: col, offset: p, len: 1 })
  }
  if b == 93 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::RBracket, line: line, col: col, offset: p, len: 1 })
  }
  if b == 61 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Equals, line: line, col: col, offset: p, len: 1 })
  }
  if b == 124 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Pipe, line: line, col: col, offset: p, len: 1 })
  }
  if b == 38 {
    self.pos = p + 1
    return Ok(Token::{ kind: TokenKind::Amp, line: line, col: col, offset: p, len: 1 })
  }
  if b == 46 {
    if p + 2 < len &&
    src.code_unit_at(p + 1) == 46 &&
    src.code_unit_at(p + 2) == 46 {
      self.pos = p + 3
      return Ok(Token::{ kind: TokenKind::Spread, line: line, col: col, offset: p, len: 3 })
    }
    return Err(
      GraphqlError::new(
        ErrorKind::InvalidSyntax,
        line,
        col,
        p,
        "unexpected '.' (expected '...')",
      ),
    )
  }

  // Numbers: '-' or '0'..'9'
  if b == 45 || (ascii_lut[b] & lut_digit) != 0 {
    return self.read_number(p, line, col)
  }

  // Strings & BlockStrings
  if b == 34 {
    if p + 2 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 {
      return self.read_block_string(p, line, col)
    }
    return self.read_string(p, line, col)
  }

  Err(
    GraphqlError::new(
      ErrorKind::InvalidSyntax,
      line,
      col,
      p,
      "unexpected character in GraphQL source",
    ),
  )
}

fn tokenize_impl(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  let lex = Lexer::new(src, opts.max_tokens)
  let out : Array[Token] = []
  while true {
    match lex.next_token() {
      Ok(tok) => {
        let is_eof = match tok.kind {
          TokenKind::Eof => true
          _ => false
        }
        out.push(tok)
        if is_eof {
          break
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

fn tokenize_bytes_impl(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  match validate_utf8_bytes(src) {
    Ok(s) => tokenize_impl(s, opts)
    Err(e) => Err(e)
  }
}

fn count_tokens_impl(src : String) -> Result[Int, GraphqlError] {
  let lex = Lexer::new(src, 100000000)
  let mut count = 0
  while true {
    match lex.next_token() {
      Ok(tok) =>
      match tok.kind {
        TokenKind::Eof => break
        _ => count = count + 1
      }
      Err(e) => return Err(e)
    }
  }
  Ok(count)
}
