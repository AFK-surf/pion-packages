///| High-performance GraphQL (October 2021) streaming Lexer with 256-byte ASCII LUT
///| and zero-allocation raw token cursor.

let lut_name_start : Int = 1

let lut_name_cont : Int = 2

let lut_digit : Int = 4

let lut_hex : Int = 8

let lut_space : Int = 16

let lut_line_term : Int = 32

let tok_eof : Int = 0

let tok_bang : Int = 1

let tok_dollar : Int = 2

let tok_amp : Int = 3

let tok_lparen : Int = 4

let tok_rparen : Int = 5

let tok_spread : Int = 6

let tok_colon : Int = 7

let tok_equals : Int = 8

let tok_at : Int = 9

let tok_lbracket : Int = 10

let tok_rbracket : Int = 11

let tok_lbrace : Int = 12

let tok_pipe : Int = 13

let tok_rbrace : Int = 14

let tok_name : Int = 15

let tok_int : Int = 16

let tok_float : Int = 17

let tok_str : Int = 18

let tok_block_str : Int = 19

fn build_ascii_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  // Whitespace & comma (Ignored tokens)
  lut[9] = lut_space // \t
  lut[32] = lut_space // ' '
  lut[44] = lut_space // ','
  // Line terminators
  lut[10] = lut_line_term // \n
  lut[13] = lut_line_term // \r
  // Digits 0-9
  let mut b = 48
  while b <= 57 {
    lut[b] = lut_name_cont | lut_digit | lut_hex
    b = b + 1
  }
  // Uppercase A-Z
  b = 65
  while b <= 90 {
    let mut flags = lut_name_start | lut_name_cont
    if b <= 70 {
      flags = flags | lut_hex
    }
    lut[b] = flags
    b = b + 1
  }
  // Lowercase a-z
  b = 97
  while b <= 122 {
    let mut flags = lut_name_start | lut_name_cont
    if b <= 102 {
      flags = flags | lut_hex
    }
    lut[b] = flags
    b = b + 1
  }
  // Underscore '_'
  lut[95] = lut_name_start | lut_name_cont
  lut
}

fn build_punct_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  lut[33] = tok_bang // '!'
  lut[36] = tok_dollar // '$'
  lut[38] = tok_amp // '&'
  lut[40] = tok_lparen // '('
  lut[41] = tok_rparen // ')'
  lut[58] = tok_colon // ':'
  lut[61] = tok_equals // '='
  lut[64] = tok_at // '@'
  lut[91] = tok_lbracket // '['
  lut[93] = tok_rbracket // ']'
  lut[123] = tok_lbrace // '{'
  lut[124] = tok_pipe // '|'
  lut[125] = tok_rbrace // '}'
  lut
}

let ascii_lut : FixedArray[Int] = build_ascii_lut()

let punct_lut : FixedArray[Int] = build_punct_lut()

fn hex_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Bool {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    return false
  }
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  true
}

///| Strictly validate RFC 3629 UTF-8 bytes and convert to `String`.
pub fn validate_utf8_bytes(src : Bytes) -> Result[String, GraphqlError] {
  let n = src.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < n {
    let b0 = src[i].to_int()
    if b0 < 0x80 {
      if b0 == 10 {
        line = line + 1
        col = 1
      } else if b0 == 13 {
        line = line + 1
        col = 1
        if i + 1 < n && src[i + 1].to_int() == 10 {
          sb.write_byte(b0.to_byte())
          i = i + 1
          sb.write_byte(10.to_byte())
          i = i + 1
          continue
        }
      } else {
        col = col + 1
      }
      sb.write_byte(b0.to_byte())
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "truncated 2-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "invalid 2-byte UTF-8 continuation",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      col = col + 1
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "truncated 3-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      let b2 = src[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "invalid 3-byte UTF-8 continuation",
          ),
        )
      }
      // Reject overlong (E0 80..9F) and UTF-16 surrogates (ED A0..BF)
      if (b0 == 0xE0 && b1 < 0xA0) || (b0 == 0xED && b1 >= 0xA0) {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "overlong or surrogate 3-byte UTF-8 sequence",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      sb.write_byte(b2.to_byte())
      col = col + 1
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "truncated 4-byte UTF-8 sequence",
          ),
        )
      }
      let b1 = src[i + 1].to_int()
      let b2 = src[i + 2].to_int()
      let b3 = src[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "invalid 4-byte UTF-8 continuation",
          ),
        )
      }
      if (b0 == 0xF0 && b1 < 0x90) || (b0 == 0xF4 && b1 > 0x8F) {
        return Err(
          GraphqlError::new(
            ErrorKind::InvalidUtf8,
            line,
            col,
            i,
            "overlong or out-of-range 4-byte UTF-8 sequence",
          ),
        )
      }
      sb.write_byte(b0.to_byte())
      sb.write_byte(b1.to_byte())
      sb.write_byte(b2.to_byte())
      sb.write_byte(b3.to_byte())
      col = col + 1
      i = i + 4
    } else {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidUtf8,
          line,
          col,
          i,
          "invalid UTF-8 lead byte",
        ),
      )
    }
  }
  Ok(sb.to_string())
}

fn is_invalid_source_byte(b : Int) -> Bool {
  b < 0x20 && b != 9 && b != 10 && b != 13
}

fn col_from(src : String, line_start : Int, pos : Int) -> Int {
  let mut i = line_start
  let mut c = 1
  while i < pos {
    if (src.code_unit_at(i) & 0xC0) != 0x80 {
      c = c + 1
    }
    i = i + 1
  }
  c
}

///| Compare slice `src[start..end]` with literal `lit` without allocating.
fn slice_eq(src : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if src.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Apply GraphQL October 2021 §2.9.4 `BlockStringValue` indentation stripping
///| directly on `raw[start..end]` without intermediate line string allocations.
fn dedent_block_string_slice(
  raw : String,
  start : Int,
  end : Int,
  line_starts : Array[Int],
  line_ends : Array[Int],
) -> String {
  if start >= end {
    return ""
  }
  // Fast path: check if single-line (no \n or \r)
  let mut i = start
  let mut has_non_ws = false
  while i < end {
    let b = raw.code_unit_at(i)
    if b == 10 || b == 13 {
      break
    }
    if b != 32 && b != 9 {
      has_non_ws = true
    }
    i = i + 1
  }
  if i == end {
    if !has_non_ws {
      return ""
    }
    return raw.slice(start, end)
  }

  // Multi-line path: collect line [start, end) ranges in scratch arrays
  line_starts.clear()
  line_ends.clear()
  line_starts.push(start)
  line_ends.push(i)
  if raw.code_unit_at(i) == 13 && i + 1 < end && raw.code_unit_at(i + 1) == 10 {
    i = i + 2
  } else {
    i = i + 1
  }
  let mut ls = i
  while i < end {
    let b = raw.code_unit_at(i)
    if b == 10 {
      line_starts.push(ls)
      line_ends.push(i)
      i = i + 1
      ls = i
    } else if b == 13 {
      line_starts.push(ls)
      line_ends.push(i)
      if i + 1 < end && raw.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      ls = i
    } else {
      i = i + 1
    }
  }
  line_starts.push(ls)
  line_ends.push(end)

  let num_lines = line_starts.length()
  let mut common_indent = -1
  let mut li = 1
  while li < num_lines {
    let s = line_starts[li]
    let e = line_ends[li]
    let mut p = s
    while p < e {
      let c = raw.code_unit_at(p)
      if c == 32 || c == 9 {
        p = p + 1
      } else {
        break
      }
    }
    if p < e {
      let ind = p - s
      if common_indent < 0 || ind < common_indent {
        common_indent = ind
      }
    }
    li = li + 1
  }

  // Trim leading blank lines
  let mut first = 0
  while first < num_lines {
    let s = line_starts[first]
    let e = line_ends[first]
    let mut k = s
    let mut blank = true
    while k < e {
      let c = raw.code_unit_at(k)
      if c != 32 && c != 9 {
        blank = false
        break
      }
      k = k + 1
    }
    if blank {
      first = first + 1
    } else {
      break
    }
  }

  // Trim trailing blank lines
  let mut last = num_lines - 1
  while last >= first {
    let s = line_starts[last]
    let e = line_ends[last]
    let mut k = s
    let mut blank = true
    while k < e {
      let c = raw.code_unit_at(k)
      if c != 32 && c != 9 {
        blank = false
        break
      }
      k = k + 1
    }
    if blank {
      last = last - 1
    } else {
      break
    }
  }

  if first > last {
    return ""
  }
  if first == last {
    let s = line_starts[first]
    let e = line_ends[first]
    let adj_s = if first > 0 && common_indent > 0 {
      let s2 = s + common_indent
      if s2 > e { e } else { s2 }
    } else {
      s
    }
    return raw.slice(adj_s, e)
  }

  let sb = StringBuilder::with_capacity(end - start)
  let mut idx = first
  while idx <= last {
    if idx > first {
      sb.write_byte(10.to_byte())
    }
    let s = line_starts[idx]
    let e = line_ends[idx]
    let adj_s = if idx > 0 && common_indent > 0 {
      let s2 = s + common_indent
      if s2 > e { e } else { s2 }
    } else {
      s
    }
    if adj_s < e {
      sb.write_substring(raw, adj_s, e)
    }
    idx = idx + 1
  }
  sb.to_string()
}

///| Streaming zero-allocation GraphQL Lexer.
struct Lexer {
  src : String
  len : Int
  mut pos : Int
  mut line : Int
  mut line_start : Int
  mut col_pos : Int
  mut col_val : Int
  mut token_count : Int
  max_tokens : Int
  // Zero-allocation current token cursor (populated by `advance_raw`)
  mut tok_tag : Int
  mut tok_start : Int
  mut tok_end : Int
  mut tok_line : Int
  mut tok_line_start : Int
  mut tok_has_decoded : Bool
  mut tok_decoded : String
  mut err : Option[GraphqlError]
  bs_starts : Array[Int]
  bs_ends : Array[Int]
}

fn Lexer::new(src : String, max_tokens : Int) -> Lexer {
  Lexer::{
    src: src,
    len: src.length(),
    pos: 0,
    line: 1,
    line_start: 0,
    col_pos: 0,
    col_val: 1,
    token_count: 0,
    max_tokens: max_tokens,
    tok_tag: tok_eof,
    tok_start: 0,
    tok_end: 0,
    tok_line: 1,
    tok_line_start: 0,
    tok_has_decoded: false,
    tok_decoded: "",
    err: None,
    bs_starts: [],
    bs_ends: [],
  }
}

///| 1-based Unicode scalar column at byte offset `pos` on the current line (O(1) amortized).
fn Lexer::col_at(self : Lexer, pos : Int) -> Int {
  let src = self.src
  if self.col_pos >= self.line_start {
    if pos == self.col_pos {
      return self.col_val
    }
    if pos > self.col_pos {
      let mut i = self.col_pos
      let mut c = self.col_val
      while i < pos {
        if (src.code_unit_at(i) & 0xC0) != 0x80 {
          c = c + 1
        }
        i = i + 1
      }
      self.col_pos = pos
      self.col_val = c
      return c
    }
  }
  let mut i = self.line_start
  let mut c = 1
  while i < pos {
    if (src.code_unit_at(i) & 0xC0) != 0x80 {
      c = c + 1
    }
    i = i + 1
  }
  self.col_pos = pos
  self.col_val = c
  c
}

fn Lexer::set_err(
  self : Lexer,
  kind : ErrorKind,
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> Bool {
  self.err = Some(GraphqlError::new(kind, line, col, offset, message))
  false
}

fn Lexer::take_err(self : Lexer) -> GraphqlError {
  match self.err {
    Some(e) => e
    None => GraphqlError::new(ErrorKind::InvalidSyntax, self.line, 1, self.pos, "lexer error")
  }
}

fn Lexer::skip_ignored_raw(self : Lexer) -> Bool {
  let src = self.src
  let len = self.len
  let lut = ascii_lut
  let mut p = self.pos
  while p < len {
    let b = src.code_unit_at(p)
    let fl = lut[b]
    if (fl & lut_space) != 0 {
      p = p + 1
    } else if b == 10 {
      p = p + 1
      self.line = self.line + 1
      self.line_start = p
    } else if b == 13 {
      p = p + 1
      if p < len && src.code_unit_at(p) == 10 {
        p = p + 1
      }
      self.line = self.line + 1
      self.line_start = p
    } else if b == 35 {
      // Comment '#' until line terminator or EOF
      p = p + 1
      while p < len {
        let cb = src.code_unit_at(p)
        if cb == 10 || cb == 13 {
          break
        }
        if is_invalid_source_byte(cb) {
          self.pos = p
          return self.set_err(
            ErrorKind::InvalidSyntax,
            self.line,
            col_from(src, self.line_start, p),
            p,
            "invalid control character in comment",
          )
        }
        p = p + 1
      }
    } else if b == 0xEF &&
    p + 2 < len &&
    src.code_unit_at(p + 1) == 0xBB &&
    src.code_unit_at(p + 2) == 0xBF {
      // Unicode BOM U+FEFF (ignored token)
      p = p + 3
    } else {
      break
    }
  }
  self.pos = p
  true
}

fn Lexer::read_number_raw(self : Lexer, start : Int, line : Int) -> Bool {
  let src = self.src
  let len = self.len
  let lut = ascii_lut
  let mut p = start
  let mut is_float = false

  if p < len && src.code_unit_at(p) == 45 {
    // '-'
    p = p + 1
  }
  if p >= len {
    return self.set_err(
      ErrorKind::InvalidSyntax,
      line,
      col_from(src, self.line_start, p),
      p,
      "unexpected end of input in number",
    )
  }
  let d0 = src.code_unit_at(p)
  if d0 == 48 {
    // '0': must NOT be followed by another digit
    p = p + 1
    if p < len && (lut[src.code_unit_at(p)] & lut_digit) != 0 {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, p),
        p,
        "invalid number: leading zero not allowed",
      )
    }
  } else if d0 >= 49 && d0 <= 57 {
    p = p + 1
    while p < len && (lut[src.code_unit_at(p)] & lut_digit) != 0 {
      p = p + 1
    }
  } else {
    return self.set_err(
      ErrorKind::InvalidSyntax,
      line,
      col_from(src, self.line_start, p),
      p,
      "invalid number: expected digit",
    )
  }

  // Optional fractional part: '.' [0-9]+
  if p < len && src.code_unit_at(p) == 46 {
    is_float = true
    p = p + 1
    if p >= len || (lut[src.code_unit_at(p)] & lut_digit) == 0 {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, p),
        p,
        "invalid float: expected digit after '.'",
      )
    }
    while p < len && (lut[src.code_unit_at(p)] & lut_digit) != 0 {
      p = p + 1
    }
  }

  // Optional exponent part: [eE] [+-]? [0-9]+
  if p < len {
    let eb = src.code_unit_at(p)
    if eb == 101 || eb == 69 {
      is_float = true
      p = p + 1
      if p < len {
        let sb = src.code_unit_at(p)
        if sb == 43 || sb == 45 {
          p = p + 1
        }
      }
      if p >= len || (lut[src.code_unit_at(p)] & lut_digit) == 0 {
        return self.set_err(
          ErrorKind::InvalidSyntax,
          line,
          col_from(src, self.line_start, p),
          p,
          "invalid float: expected digit in exponent",
        )
      }
      while p < len && (lut[src.code_unit_at(p)] & lut_digit) != 0 {
        p = p + 1
      }
    }
  }

  // GraphQL Oct 2021 lookahead restriction: must not be followed by '.' or NameStart
  if p < len {
    let nb = src.code_unit_at(p)
    if nb == 46 || (lut[nb] & lut_name_start) != 0 {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, p),
        p,
        "invalid number: unexpected character immediately following number",
      )
    }
  }

  self.pos = p
  self.tok_tag = if is_float { tok_float } else { tok_int }
  self.tok_start = start
  self.tok_end = p
  self.tok_has_decoded = false
  true
}

fn Lexer::read_string_raw(
  self : Lexer,
  start : Int,
  line : Int,
  decode : Bool,
) -> Bool {
  let src = self.src
  let len = self.len
  let mut p = start + 1
  // Fast zero-copy path for strings without escapes
  let mut has_escape = false
  let mut fast_end = p
  while fast_end < len {
    let b = src.code_unit_at(fast_end)
    if b == 34 {
      self.pos = fast_end + 1
      self.tok_tag = tok_str
      self.tok_start = start
      self.tok_end = fast_end + 1
      self.tok_has_decoded = false
      return true
    } else if b == 92 {
      has_escape = true
      break
    } else if b == 10 || b == 13 {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, fast_end),
        fast_end,
        "unterminated string literal before line terminator",
      )
    } else if is_invalid_source_byte(b) {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, fast_end),
        fast_end,
        "invalid control character in string literal",
      )
    }
    fast_end = fast_end + 1
  }
  if !has_escape {
    return self.set_err(
      ErrorKind::UnexpectedEof,
      line,
      col_from(src, self.line_start, fast_end),
      fast_end,
      "unterminated string literal",
    )
  }

  // Slow path with escape decoding (or validation-only when !decode)
  let sb = if decode { StringBuilder::with_capacity((fast_end - start) + 16) } else { StringBuilder::new() }
  if decode && fast_end > start + 1 {
    sb.write_substring(src, start + 1, fast_end)
  }
  p = fast_end
  let mut chunk_start = p
  while p < len {
    let b = src.code_unit_at(p)
    if b == 34 {
      if decode && p > chunk_start {
        sb.write_substring(src, chunk_start, p)
      }
      self.pos = p + 1
      self.tok_tag = tok_str
      self.tok_start = start
      self.tok_end = p + 1
      if decode {
        self.tok_has_decoded = true
        self.tok_decoded = sb.to_string()
      } else {
        self.tok_has_decoded = false
      }
      return true
    } else if b == 10 || b == 13 {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, p),
        p,
        "unterminated string literal before line terminator",
      )
    } else if is_invalid_source_byte(b) {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        line,
        col_from(src, self.line_start, p),
        p,
        "invalid control character in string literal",
      )
    } else if b == 92 {
      if decode && p > chunk_start {
        sb.write_substring(src, chunk_start, p)
      }
      p = p + 1
      if p >= len {
        return self.set_err(
          ErrorKind::UnexpectedEof,
          line,
          col_from(src, self.line_start, p),
          p,
          "unterminated escape sequence in string",
        )
      }
      let esc = src.code_unit_at(p)
      if esc == 34 {
        if decode { sb.write_byte(34.to_byte()) }
        p = p + 1
      } else if esc == 92 {
        if decode { sb.write_byte(92.to_byte()) }
        p = p + 1
      } else if esc == 47 {
        if decode { sb.write_byte(47.to_byte()) }
        p = p + 1
      } else if esc == 98 {
        if decode { sb.write_byte(8.to_byte()) }
        p = p + 1
      } else if esc == 102 {
        if decode { sb.write_byte(12.to_byte()) }
        p = p + 1
      } else if esc == 110 {
        if decode { sb.write_byte(10.to_byte()) }
        p = p + 1
      } else if esc == 114 {
        if decode { sb.write_byte(13.to_byte()) }
        p = p + 1
      } else if esc == 116 {
        if decode { sb.write_byte(9.to_byte()) }
        p = p + 1
      } else if esc == 117 {
        p = p + 1
        if p < len && src.code_unit_at(p) == 123 {
          // Oct 2021 variable-length Unicode escape \u{X...}
          p = p + 1
          let mut cp = 0
          let mut digits = 0
          let mut overflow = false
          while p < len {
            let hb = src.code_unit_at(p)
            if hb == 125 {
              break
            }
            let hv = hex_digit_val(hb)
            if hv < 0 {
              return self.set_err(
                ErrorKind::InvalidSyntax,
                line,
                col_from(src, self.line_start, p),
                p,
                "invalid hex digit in \\u{...} escape",
              )
            }
            digits = digits + 1
            if digits > 8 {
              return self.set_err(
                ErrorKind::InvalidSyntax,
                line,
                col_from(src, self.line_start, p),
                p,
                "invalid \\u{...} escape: too many hex digits",
              )
            }
            if !overflow {
              cp = (cp << 4) | hv
              if cp > 0x10FFFF {
                overflow = true
              }
            }
            p = p + 1
          }
          if p >= len || src.code_unit_at(p) != 125 || digits == 0 {
            return self.set_err(
              ErrorKind::InvalidSyntax,
              line,
              col_from(src, self.line_start, p),
              p,
              "invalid or unterminated \\u{...} escape",
            )
          }
          p = p + 1
          if overflow || cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
            return self.set_err(
              ErrorKind::InvalidSyntax,
              line,
              col_from(src, self.line_start, p),
              p,
              "invalid Unicode scalar value in \\u{...} escape",
            )
          }
          if decode {
            let _ = write_utf8_cp(sb, cp)
          }
        } else {
          // Fixed 4-hex-digit \uXXXX (with UTF-16 surrogate pair combining)
          if p + 4 > len {
            return self.set_err(
              ErrorKind::InvalidSyntax,
              line,
              col_from(src, self.line_start, p),
              p,
              "incomplete \\uXXXX escape",
            )
          }
          let h0 = hex_digit_val(src.code_unit_at(p))
          let h1 = hex_digit_val(src.code_unit_at(p + 1))
          let h2 = hex_digit_val(src.code_unit_at(p + 2))
          let h3 = hex_digit_val(src.code_unit_at(p + 3))
          if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
            return self.set_err(
              ErrorKind::InvalidSyntax,
              line,
              col_from(src, self.line_start, p),
              p,
              "invalid hex digit in \\uXXXX escape",
            )
          }
          let u1 = (h0 << 12) | (h1 << 8) | (h2 << 4) | h3
          p = p + 4
          if u1 >= 0xD800 && u1 <= 0xDBFF {
            // High surrogate: must be immediately followed by \uYYYY low surrogate
            if p + 6 > len ||
            src.code_unit_at(p) != 92 ||
            src.code_unit_at(p + 1) != 117 {
              return self.set_err(
                ErrorKind::InvalidSyntax,
                line,
                col_from(src, self.line_start, p),
                p,
                "unpaired high surrogate in string escape",
              )
            }
            let l0 = hex_digit_val(src.code_unit_at(p + 2))
            let l1 = hex_digit_val(src.code_unit_at(p + 3))
            let l2 = hex_digit_val(src.code_unit_at(p + 4))
            let l3 = hex_digit_val(src.code_unit_at(p + 5))
            if l0 < 0 || l1 < 0 || l2 < 0 || l3 < 0 {
              return self.set_err(
                ErrorKind::InvalidSyntax,
                line,
                col_from(src, self.line_start, p),
                p,
                "invalid hex digit in low surrogate escape",
              )
            }
            let u2 = (l0 << 12) | (l1 << 8) | (l2 << 4) | l3
            if u2 < 0xDC00 || u2 > 0xDFFF {
              return self.set_err(
                ErrorKind::InvalidSyntax,
                line,
                col_from(src, self.line_start, p),
                p,
                "expected low surrogate after high surrogate",
              )
            }
            if decode {
              let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
              let _ = write_utf8_cp(sb, cp)
            }
            p = p + 6
          } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
            return self.set_err(
              ErrorKind::InvalidSyntax,
              line,
              col_from(src, self.line_start, p),
              p,
              "unpaired low surrogate in string escape",
            )
          } else if decode {
            let _ = write_utf8_cp(sb, u1)
          }
        }
      } else {
        return self.set_err(
          ErrorKind::InvalidSyntax,
          line,
          col_from(src, self.line_start, p),
          p,
          "invalid escape sequence in string",
        )
      }
      chunk_start = p
    } else {
      p = p + 1
    }
  }
  self.set_err(
    ErrorKind::UnexpectedEof,
    line,
    col_from(src, self.line_start, p),
    p,
    "unterminated string literal",
  )
}

fn Lexer::read_block_string_raw(
  self : Lexer,
  start : Int,
  line : Int,
  start_line_start : Int,
  decode : Bool,
) -> Bool {
  let src = self.src
  let len = self.len
  let mut p = start + 3
  let mut has_escape = false
  let mut sb_opt : Option[StringBuilder] = None
  let mut chunk_start = p
  while p < len {
    let b = src.code_unit_at(p)
    if b == 34 &&
    p + 2 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 {
      self.pos = p + 3
      self.tok_tag = tok_block_str
      self.tok_start = start
      self.tok_end = p + 3
      if decode {
        let dedented = if has_escape {
          let sb = match sb_opt {
            Some(s) => s
            None => StringBuilder::new()
          }
          if p > chunk_start {
            sb.write_substring(src, chunk_start, p)
          }
          let raw = sb.to_string()
          dedent_block_string_slice(raw, 0, raw.length(), self.bs_starts, self.bs_ends)
        } else {
          dedent_block_string_slice(src, start + 3, p, self.bs_starts, self.bs_ends)
        }
        self.tok_has_decoded = true
        self.tok_decoded = dedented
      } else {
        self.tok_has_decoded = false
      }
      return true
    } else if b == 92 &&
    p + 3 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 &&
    src.code_unit_at(p + 3) == 34 {
      if decode {
        let sb = match sb_opt {
          Some(s) => s
          None => {
            let s = StringBuilder::with_capacity((p - start) + 16)
            sb_opt = Some(s)
            s
          }
        }
        has_escape = true
        if p > chunk_start {
          sb.write_substring(src, chunk_start, p)
        }
        sb.write_string("\"\"\"")
      }
      p = p + 4
      chunk_start = p
    } else if b == 10 {
      p = p + 1
      self.line = self.line + 1
      self.line_start = p
    } else if b == 13 {
      p = p + 1
      if p < len && src.code_unit_at(p) == 10 {
        p = p + 1
      }
      self.line = self.line + 1
      self.line_start = p
    } else if is_invalid_source_byte(b) {
      return self.set_err(
        ErrorKind::InvalidSyntax,
        self.line,
        col_from(src, self.line_start, p),
        p,
        "invalid control character in block string",
      )
    } else {
      p = p + 1
    }
  }
  self.set_err(
    ErrorKind::UnexpectedEof,
    line,
    col_from(src, start_line_start, start),
    start,
    "unterminated block string",
  )
}

///| Advance lexer cursor in-place with zero Token/Result allocation.
///| Returns `true` on success (`tok_tag` / `tok_start` / `tok_end` populated), `false` on error (`self.err` set).
fn Lexer::advance_raw(self : Lexer, decode_strings : Bool) -> Bool {
  if !self.skip_ignored_raw() {
    return false
  }
  let p = self.pos
  let line = self.line
  let lstart = self.line_start
  self.tok_line = line
  self.tok_line_start = lstart
  if p >= self.len {
    self.tok_tag = tok_eof
    self.tok_start = p
    self.tok_end = p
    self.tok_has_decoded = false
    return true
  }
  if self.token_count >= self.max_tokens {
    return self.set_err(
      ErrorKind::LimitExceeded,
      line,
      col_from(self.src, lstart, p),
      p,
      "max_tokens limit exceeded",
    )
  }
  self.token_count = self.token_count + 1
  let src = self.src
  let len = self.len
  let lut = ascii_lut
  let b = src.code_unit_at(p)
  let fl = lut[b]

  // Fast path: Name ([_A-Za-z][_0-9A-Za-z]*)
  if (fl & lut_name_start) != 0 {
    let mut end = p + 1
    while end < len && (lut[src.code_unit_at(end)] & lut_name_cont) != 0 {
      end = end + 1
    }
    self.pos = end
    self.tok_tag = tok_name
    self.tok_start = p
    self.tok_end = end
    self.tok_has_decoded = false
    return true
  }

  // Fast path: Single-byte punctuators via 256-entry LUT
  let pt = punct_lut[b]
  if pt > 0 {
    self.pos = p + 1
    self.tok_tag = pt
    self.tok_start = p
    self.tok_end = p + 1
    self.tok_has_decoded = false
    return true
  }

  // Strings & BlockStrings
  if b == 34 {
    if p + 2 < len &&
    src.code_unit_at(p + 1) == 34 &&
    src.code_unit_at(p + 2) == 34 {
      return self.read_block_string_raw(p, line, lstart, decode_strings)
    }
    return self.read_string_raw(p, line, decode_strings)
  }

  // Numbers: '-' or '0'..'9'
  if b == 45 || (fl & lut_digit) != 0 {
    return self.read_number_raw(p, line)
  }

  // Spread '...'
  if b == 46 {
    if p + 2 < len &&
    src.code_unit_at(p + 1) == 46 &&
    src.code_unit_at(p + 2) == 46 {
      self.pos = p + 3
      self.tok_tag = tok_spread
      self.tok_start = p
      self.tok_end = p + 3
      self.tok_has_decoded = false
      return true
    }
    return self.set_err(
      ErrorKind::InvalidSyntax,
      line,
      col_from(src, lstart, p),
      p,
      "unexpected '.' (expected '...')",
    )
  }

  self.set_err(
    ErrorKind::InvalidSyntax,
    line,
    col_from(src, lstart, p),
    p,
    "unexpected character in GraphQL source",
  )
}

fn Lexer::tok_string_val(self : Lexer) -> String {
  if self.tok_has_decoded {
    self.tok_decoded
  } else {
    self.src.slice(self.tok_start + 1, self.tok_end - 1)
  }
}

fn Lexer::next_token(self : Lexer) -> Result[Token, GraphqlError] {
  if !self.advance_raw(true) {
    return Err(self.take_err())
  }
  let tag = self.tok_tag
  let start = self.tok_start
  let end = self.tok_end
  let line = self.tok_line
  let col = if self.tok_line_start == self.line_start {
    self.col_at(start)
  } else {
    col_from(self.src, self.tok_line_start, start)
  }
  let kind = if tag == tok_eof {
    TokenKind::Eof
  } else if tag == tok_name {
    TokenKind::Name(self.src.slice(start, end))
  } else if tag == tok_lbrace {
    TokenKind::LBrace
  } else if tag == tok_rbrace {
    TokenKind::RBrace
  } else if tag == tok_lparen {
    TokenKind::LParen
  } else if tag == tok_rparen {
    TokenKind::RParen
  } else if tag == tok_colon {
    TokenKind::Colon
  } else if tag == tok_bang {
    TokenKind::Bang
  } else if tag == tok_dollar {
    TokenKind::Dollar
  } else if tag == tok_at {
    TokenKind::At
  } else if tag == tok_lbracket {
    TokenKind::LBracket
  } else if tag == tok_rbracket {
    TokenKind::RBracket
  } else if tag == tok_equals {
    TokenKind::Equals
  } else if tag == tok_pipe {
    TokenKind::Pipe
  } else if tag == tok_amp {
    TokenKind::Amp
  } else if tag == tok_spread {
    TokenKind::Spread
  } else if tag == tok_int {
    TokenKind::Int(self.src.slice(start, end))
  } else if tag == tok_float {
    TokenKind::Float(self.src.slice(start, end))
  } else if tag == tok_str {
    TokenKind::Str(self.tok_string_val())
  } else {
    TokenKind::BlockStr(self.tok_decoded)
  }
  Ok(Token::{ kind: kind, line: line, col: col, offset: start, len: end - start })
}

fn tokenize_impl(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  let lex = Lexer::new(src, opts.max_tokens)
  let out : Array[Token] = []
  while true {
    match lex.next_token() {
      Ok(tok) => {
        let is_eof = match tok.kind {
          TokenKind::Eof => true
          _ => false
        }
        out.push(tok)
        if is_eof {
          break
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

fn tokenize_bytes_impl(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Array[Token], GraphqlError] {
  match validate_utf8_bytes(src) {
    Ok(s) => tokenize_impl(s, opts)
    Err(e) => Err(e)
  }
}

fn count_tokens_impl(src : String) -> Result[Int, GraphqlError] {
  let lex = Lexer::new(src, 100000000)
  let mut count = 0
  while true {
    if !lex.advance_raw(false) {
      return Err(lex.take_err())
    }
    if lex.tok_tag == tok_eof {
      break
    }
    count = count + 1
  }
  Ok(count)
}
