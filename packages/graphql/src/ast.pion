///| Full GraphQL October 2021 AST (Executable + Type System SDL + Extensions).

///| Root AST node representing a GraphQL document.
pub struct Document {
  pub definitions : Array[Definition]
}

///| Top-level definition inside a GraphQL `Document`.
pub enum Definition {
  Operation(OperationDefinition)
  Fragment(FragmentDefinition)
  Schema(SchemaDefinition)
  TypeDef(TypeDefinition)
  DirectiveDef(DirectiveDefinition)
  SchemaExtension(SchemaExtension)
  TypeExtension(TypeExtension)
}

///| Operation kind (`query`, `mutation`, `subscription`).
pub enum OperationType {
  Query
  Mutation
  Subscription
}

///|
pub fn operation_type_eq(self : OperationType, other : OperationType) -> Bool {
  match (self, other) {
    (OperationType::Query, OperationType::Query) => true
    (OperationType::Mutation, OperationType::Mutation) => true
    (OperationType::Subscription, OperationType::Subscription) => true
    _ => false
  }
}

///|
pub fn operation_type_to_string(self : OperationType) -> String {
  match self {
    OperationType::Query => "query"
    OperationType::Mutation => "mutation"
    OperationType::Subscription => "subscription"
  }
}

///| Executable operation definition (including anonymous query shorthand `{ ... }`).
pub struct OperationDefinition {
  pub op_type : OperationType
  pub is_shorthand : Bool
  pub name : Option[String]
  pub variable_definitions : Array[VariableDefinition]
  pub directives : Array[Directive]
  pub selection_set : SelectionSet
}

///| Variable definition (`$var: Type = default @dir`).
pub struct VariableDefinition {
  pub name : String
  pub var_type : TypeRef
  pub default_value : Option[Value]
  pub directives : Array[Directive]
}

///| GraphQL type reference (`Named`, `[T]`, `T!`).
pub enum TypeRef {
  Named(String)
  List(TypeRef)
  NonNull(TypeRef)
}

///| Selection set `{ selection ... }`.
pub struct SelectionSet {
  pub selections : Array[Selection]
}

///| An element of a `SelectionSet`.
pub enum Selection {
  Field(Field)
  FragmentSpread(FragmentSpread)
  InlineFragment(InlineFragment)
}

///| Field selection (`alias: name(args) @dirs { sub }`).
pub struct Field {
  pub alias : Option[String]
  pub name : String
  pub arguments : Array[Argument]
  pub directives : Array[Directive]
  pub selection_set : Option[SelectionSet]
}

///| Named argument (`name: value`).
pub struct Argument {
  pub name : String
  pub value : Value
}

///| Fragment spread (`...FragName @dirs`).
pub struct FragmentSpread {
  pub name : String
  pub directives : Array[Directive]
}

///| Inline fragment (`... on TypeName @dirs { ... }` or `... @dirs { ... }`).
pub struct InlineFragment {
  pub type_condition : Option[String]
  pub directives : Array[Directive]
  pub selection_set : SelectionSet
}

///| Fragment definition (`fragment Name on TypeName @dirs { ... }`).
pub struct FragmentDefinition {
  pub name : String
  pub type_condition : String
  pub directives : Array[Directive]
  pub selection_set : SelectionSet
}

///| GraphQL value literal or variable.
pub enum Value {
  Variable(String)
  IntValue(String)
  FloatValue(String)
  StringValue(String, Bool)
  BooleanValue(Bool)
  NullValue
  EnumValue(String)
  ListValue(Array[Value])
  ObjectValue(Array[ObjectField])
}

///| Key-value entry inside a GraphQL `ObjectValue`.
pub struct ObjectField {
  pub name : String
  pub value : Value
}

///| Directive application (`@name(args)`).
pub struct Directive {
  pub name : String
  pub arguments : Array[Argument]
}

///| Description string literal on an SDL definition or member.
pub struct Description {
  pub value : String
  pub is_block : Bool
}

///| Root operation type entry in a `schema` definition or extension.
pub struct OperationTypeDefinition {
  pub op_type : OperationType
  pub named_type : String
}

///| `schema @dirs { query: Query ... }`
pub struct SchemaDefinition {
  pub description : Option[Description]
  pub directives : Array[Directive]
  pub operation_types : Array[OperationTypeDefinition]
}

///| `extend schema @dirs { ... }`
pub struct SchemaExtension {
  pub directives : Array[Directive]
  pub operation_types : Array[OperationTypeDefinition]
}

///| SDL type definition (`scalar`, `type`, `interface`, `union`, `enum`, `input`).
pub enum TypeDefinition {
  Scalar(ScalarTypeDefinition)
  Object(ObjectTypeDefinition)
  Interface(InterfaceTypeDefinition)
  Union(UnionTypeDefinition)
  Enum(EnumTypeDefinition)
  InputObject(InputObjectTypeDefinition)
}

///| SDL type extension (`extend scalar|type|interface|union|enum|input`).
pub enum TypeExtension {
  Scalar(ScalarTypeExtension)
  Object(ObjectTypeExtension)
  Interface(InterfaceTypeExtension)
  Union(UnionTypeExtension)
  Enum(EnumTypeExtension)
  InputObject(InputObjectTypeExtension)
}

///| `scalar Name @dirs`
pub struct ScalarTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub directives : Array[Directive]
}

///| `extend scalar Name @dirs`
pub struct ScalarTypeExtension {
  pub name : String
  pub directives : Array[Directive]
}

///| `type Name implements A & B @dirs { fields }`
pub struct ObjectTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub implements_interfaces : Array[String]
  pub directives : Array[Directive]
  pub fields : Array[FieldDefinition]
}

///| `extend type Name ...`
pub struct ObjectTypeExtension {
  pub name : String
  pub implements_interfaces : Array[String]
  pub directives : Array[Directive]
  pub fields : Array[FieldDefinition]
}

///| `interface Name implements A & B @dirs { fields }`
pub struct InterfaceTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub implements_interfaces : Array[String]
  pub directives : Array[Directive]
  pub fields : Array[FieldDefinition]
}

///| `extend interface Name ...`
pub struct InterfaceTypeExtension {
  pub name : String
  pub implements_interfaces : Array[String]
  pub directives : Array[Directive]
  pub fields : Array[FieldDefinition]
}

///| Field definition inside an object or interface type.
pub struct FieldDefinition {
  pub description : Option[Description]
  pub name : String
  pub arguments : Array[InputValueDefinition]
  pub field_type : TypeRef
  pub directives : Array[Directive]
}

///| Input value definition (field argument, directive argument, or input object field).
pub struct InputValueDefinition {
  pub description : Option[Description]
  pub name : String
  pub value_type : TypeRef
  pub default_value : Option[Value]
  pub directives : Array[Directive]
}

///| `union Name @dirs = A | B`
pub struct UnionTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub directives : Array[Directive]
  pub members : Array[String]
}

///| `extend union Name ...`
pub struct UnionTypeExtension {
  pub name : String
  pub directives : Array[Directive]
  pub members : Array[String]
}

///| `enum Name @dirs { VALUE ... }`
pub struct EnumTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub directives : Array[Directive]
  pub values : Array[EnumValueDefinition]
}

///| `extend enum Name ...`
pub struct EnumTypeExtension {
  pub name : String
  pub directives : Array[Directive]
  pub values : Array[EnumValueDefinition]
}

///| Single value inside an `enum` definition or extension.
pub struct EnumValueDefinition {
  pub description : Option[Description]
  pub name : String
  pub directives : Array[Directive]
}

///| `input Name @dirs { field: Type = default }`
pub struct InputObjectTypeDefinition {
  pub description : Option[Description]
  pub name : String
  pub directives : Array[Directive]
  pub fields : Array[InputValueDefinition]
}

///| `extend input Name ...`
pub struct InputObjectTypeExtension {
  pub name : String
  pub directives : Array[Directive]
  pub fields : Array[InputValueDefinition]
}

///| `directive @name(args) repeatable on LOC1 | LOC2`
pub struct DirectiveDefinition {
  pub description : Option[Description]
  pub name : String
  pub arguments : Array[InputValueDefinition]
  pub repeatable : Bool
  pub locations : Array[String]
}
