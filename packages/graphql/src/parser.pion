///| 100% iterative explicit-stack GraphQL (October 2021) AST Parser (Executable + Schema SDL).

///| Hard upper bound on AST nesting depth to prevent native SIGSEGV / Wasm32 stack-overflow trap
///| during recursive runtime RC teardown of deeply nested AST nodes.
let hard_max_depth : Int = 500

// Shared immutable empty AST arrays (avoids >100k empty Array heap allocations on large schemas)
let empty_args : Array[Argument] = []

let empty_directives : Array[Directive] = []

let empty_input_values : Array[InputValueDefinition] = []

let empty_strings : Array[String] = []

let empty_fields : Array[FieldDefinition] = []

let empty_enum_vals : Array[EnumValueDefinition] = []

let empty_var_defs : Array[VariableDefinition] = []

let empty_values : Array[Value] = []

let empty_obj_fields : Array[ObjectField] = []

let empty_op_types : Array[OperationTypeDefinition] = []

let empty_name_cache : FixedArray[String] = FixedArray::make(1, "")

// Shared immutable built-in GraphQL scalar TypeRef singletons
let type_id : TypeRef = TypeRef::Named("ID")

let type_id_nn : TypeRef = TypeRef::NonNull(type_id)

let type_string : TypeRef = TypeRef::Named("String")

let type_string_nn : TypeRef = TypeRef::NonNull(type_string)

let type_int : TypeRef = TypeRef::Named("Int")

let type_int_nn : TypeRef = TypeRef::NonNull(type_int)

let type_float : TypeRef = TypeRef::Named("Float")

let type_float_nn : TypeRef = TypeRef::NonNull(type_float)

let type_boolean : TypeRef = TypeRef::Named("Boolean")

let type_boolean_nn : TypeRef = TypeRef::NonNull(type_boolean)

enum ValFrame {
  List(Array[Value])
  Obj(Array[ObjectField], String)
}

enum SelFrameKind {
  Root
  FieldFrame(Option[String], String, Array[Argument], Array[Directive])
  InlineFrame(Option[String], Array[Directive])
}

struct SelFrame {
  kind : SelFrameKind
  selections : Array[Selection]
}

struct Parser {
  lex : Lexer
  max_depth : Int
  max_nodes : Int
  mut node_count : Int
  use_intern : Bool
  name_cache : FixedArray[String]
  val_stack : Array[ValFrame]
  sel_stack : Array[SelFrame]
}

fn Parser::new(src : String, opts : ParseOptions) -> Result[Parser, GraphqlError] {
  let eff_depth = if opts.max_depth > hard_max_depth {
    hard_max_depth
  } else {
    opts.max_depth
  }
  let lex = Lexer::new(src, opts.max_tokens)
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  let use_intern = src.length() >= 4096
  let name_cache = if use_intern {
    FixedArray::make(256, "")
  } else {
    empty_name_cache
  }
  Ok(
    Parser::{
      lex: lex,
      max_depth: eff_depth,
      max_nodes: opts.max_nodes,
      node_count: 0,
      use_intern: use_intern,
      name_cache: name_cache,
      val_stack: [],
      sel_stack: [],
    },
  )
}

fn Parser::cur_col(self : Parser) -> Int {
  col_from(self.lex.src, self.lex.tok_line_start, self.lex.tok_start)
}

fn Parser::err_at_cur(
  self : Parser,
  kind : ErrorKind,
  msg : String,
) -> GraphqlError {
  GraphqlError::new(
    kind,
    self.lex.tok_line,
    self.cur_col(),
    self.lex.tok_start,
    msg,
  )
}

fn Parser::err_unexpected(self : Parser, expected : String) -> GraphqlError {
  let kind = if self.lex.tok_tag == tok_eof {
    ErrorKind::UnexpectedEof
  } else {
    ErrorKind::UnexpectedToken
  }
  self.err_at_cur(kind, "expected " + expected)
}

fn Parser::bump_node(self : Parser) -> Bool {
  self.node_count = self.node_count + 1
  if self.node_count > self.max_nodes {
    self.lex.err = Some(
      self.err_at_cur(ErrorKind::LimitExceeded, "max_nodes limit exceeded"),
    )
    return false
  }
  true
}

fn Parser::cur_name(self : Parser) -> String {
  let lex = self.lex
  let src = lex.src
  let s = lex.tok_start
  let e = lex.tok_end
  if !self.use_intern {
    return src.slice(s, e)
  }
  let n = e - s
  let b0 = src.code_unit_at(s)
  let blast = src.code_unit_at(e - 1)
  let bmid = src.code_unit_at(s + (n >> 1))
  let slot = (((b0 * 31 + bmid) * 31 + blast) * 31 + n) & 255
  let cached = self.name_cache[slot]
  if cached.length() == n && slice_eq(src, s, e, cached) {
    return cached
  }
  let fresh = src.slice(s, e)
  self.name_cache[slot] = fresh
  fresh
}

fn Parser::cur_slice_eq(self : Parser, lit : String) -> Bool {
  slice_eq(self.lex.src, self.lex.tok_start, self.lex.tok_end, lit)
}

fn Parser::expect_name(self : Parser) -> Result[String, GraphqlError] {
  if self.lex.tok_tag != tok_name {
    return Err(self.err_unexpected("Name"))
  }
  let s = self.cur_name()
  if !self.lex.advance_raw(true) {
    return Err(self.lex.take_err())
  }
  Ok(s)
}

fn Parser::expect_keyword(self : Parser, kw : String) -> Result[Unit, GraphqlError] {
  if self.lex.tok_tag == tok_name && self.cur_slice_eq(kw) {
    if !self.lex.advance_raw(true) {
      return Err(self.lex.take_err())
    }
    return Ok(())
  }
  Err(self.err_unexpected("keyword '" + kw + "'"))
}

fn Parser::skip_keyword(self : Parser, kw : String) -> Result[Bool, GraphqlError] {
  if self.lex.tok_tag == tok_name && self.cur_slice_eq(kw) {
    if !self.lex.advance_raw(true) {
      return Err(self.lex.take_err())
    }
    return Ok(true)
  }
  Ok(false)
}

fn Parser::expect_tag(
  self : Parser,
  expected : Int,
  label : String,
) -> Result[Unit, GraphqlError] {
  if self.lex.tok_tag == expected {
    if !self.lex.advance_raw(true) {
      return Err(self.lex.take_err())
    }
    return Ok(())
  }
  Err(self.err_unexpected(label))
}

fn Parser::skip_tag(self : Parser, expected : Int) -> Result[Bool, GraphqlError] {
  if self.lex.tok_tag == expected {
    if !self.lex.advance_raw(true) {
      return Err(self.lex.take_err())
    }
    return Ok(true)
  }
  Ok(false)
}

///| 100% iterative `TypeRef` parser (`[[String!]!]!`), bounded by `max_depth`.
fn Parser::parse_type_ref(self : Parser) -> Result[TypeRef, GraphqlError] {
  let lex = self.lex
  let mut list_depth = 0
  while lex.tok_tag == tok_lbracket {
    list_depth = list_depth + 1
    if list_depth > self.max_depth {
      return Err(
        self.err_at_cur(ErrorKind::LimitExceeded, "max_depth limit exceeded in type"),
      )
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
  }
  if lex.tok_tag != tok_name {
    return Err(self.err_unexpected("Name"))
  }
  if !self.bump_node() {
    return Err(lex.take_err())
  }
  let src = lex.src
  let s = lex.tok_start
  let e = lex.tok_end
  let n = e - s
  let b0 = src.code_unit_at(s)
  // Fast path: built-in GraphQL scalar TypeRefs (zero allocation)
  let mut builtin_id = 0
  if n == 2 && b0 == 73 && src.code_unit_at(s + 1) == 68 {
    builtin_id = 1 // ID
  } else if n == 6 && b0 == 83 && slice_eq(src, s, e, "String") {
    builtin_id = 2 // String
  } else if n == 3 && b0 == 73 && slice_eq(src, s, e, "Int") {
    builtin_id = 3 // Int
  } else if n == 7 && b0 == 66 && slice_eq(src, s, e, "Boolean") {
    builtin_id = 4 // Boolean
  } else if n == 5 && b0 == 70 && slice_eq(src, s, e, "Float") {
    builtin_id = 5 // Float
  }
  let mut ty = if builtin_id == 1 {
    type_id
  } else if builtin_id == 2 {
    type_string
  } else if builtin_id == 3 {
    type_int
  } else if builtin_id == 4 {
    type_boolean
  } else if builtin_id == 5 {
    type_float
  } else {
    TypeRef::Named(self.cur_name())
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_bang {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    if lex.tok_tag == tok_bang {
      return Err(self.err_unexpected("no duplicate '!'"))
    }
    ty = if builtin_id == 1 {
      type_id_nn
    } else if builtin_id == 2 {
      type_string_nn
    } else if builtin_id == 3 {
      type_int_nn
    } else if builtin_id == 4 {
      type_boolean_nn
    } else if builtin_id == 5 {
      type_float_nn
    } else {
      TypeRef::NonNull(ty)
    }
  }
  while list_depth > 0 {
    if lex.tok_tag != tok_rbracket {
      return Err(self.err_unexpected("']'"))
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    ty = TypeRef::List(ty)
    if !self.bump_node() {
      return Err(lex.take_err())
    }
    if lex.tok_tag == tok_bang {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      if lex.tok_tag == tok_bang {
        return Err(self.err_unexpected("no duplicate '!'"))
      }
      ty = TypeRef::NonNull(ty)
    }
    list_depth = list_depth - 1
  }
  Ok(ty)
}

///| 100% iterative `Value` parser using a reusable explicit heap stack, bounded by `max_depth` & `max_nodes`.
fn Parser::parse_value_iter(
  self : Parser,
  is_const : Bool,
) -> Result[Value, GraphqlError] {
  let lex = self.lex
  if !self.bump_node() {
    return Err(lex.take_err())
  }
  // Fast path for scalar / empty-container values (zero stack allocation)
  let tag0 = lex.tok_tag
  if tag0 == tok_dollar {
    if is_const {
      return Err(
        self.err_at_cur(
          ErrorKind::UnexpectedToken,
          "variable not allowed in constant value",
        ),
      )
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let vname = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    return Ok(Value::Variable(vname))
  }
  if tag0 == tok_int {
    let s = lex.src.slice(lex.tok_start, lex.tok_end)
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Value::IntValue(s))
  }
  if tag0 == tok_float {
    let s = lex.src.slice(lex.tok_start, lex.tok_end)
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Value::FloatValue(s))
  }
  if tag0 == tok_str {
    let s = lex.tok_string_val()
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Value::StringValue(s, false))
  }
  if tag0 == tok_block_str {
    let s = lex.tok_decoded
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Value::StringValue(s, true))
  }
  if tag0 == tok_name {
    let src = lex.src
    let st = lex.tok_start
    let en = lex.tok_end
    let v = if slice_eq(src, st, en, "true") {
      Value::BooleanValue(true)
    } else if slice_eq(src, st, en, "false") {
      Value::BooleanValue(false)
    } else if slice_eq(src, st, en, "null") {
      Value::NullValue
    } else {
      Value::EnumValue(self.cur_name())
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(v)
  }

  // Container path: List or Object
  let stack = self.val_stack
  stack.clear()
  if tag0 == tok_lbracket {
    if 0 >= self.max_depth {
      return Err(
        self.err_at_cur(
          ErrorKind::LimitExceeded,
          "max_depth limit exceeded in list value",
        ),
      )
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    if lex.tok_tag == tok_rbracket {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      return Ok(Value::ListValue(empty_values))
    }
    stack.push(ValFrame::List([]))
  } else if tag0 == tok_lbrace {
    if 0 >= self.max_depth {
      return Err(
        self.err_at_cur(
          ErrorKind::LimitExceeded,
          "max_depth limit exceeded in object value",
        ),
      )
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    if lex.tok_tag == tok_rbrace {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      return Ok(Value::ObjectValue(empty_obj_fields))
    }
    let fname = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_tag(tok_colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    stack.push(ValFrame::Obj([], fname))
  } else {
    return Err(self.err_unexpected("Value"))
  }

  let mut need_value = true
  let mut finished_val : Option[Value] = None

  while true {
    if need_value {
      if !self.bump_node() {
        return Err(lex.take_err())
      }
      let tag = lex.tok_tag
      if tag == tok_lbracket {
        if stack.length() >= self.max_depth {
          return Err(
            self.err_at_cur(
              ErrorKind::LimitExceeded,
              "max_depth limit exceeded in list value",
            ),
          )
        }
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        if lex.tok_tag == tok_rbracket {
          if !lex.advance_raw(true) {
            return Err(lex.take_err())
          }
          finished_val = Some(Value::ListValue(empty_values))
          need_value = false
        } else {
          stack.push(ValFrame::List([]))
          need_value = true
        }
      } else if tag == tok_lbrace {
        if stack.length() >= self.max_depth {
          return Err(
            self.err_at_cur(
              ErrorKind::LimitExceeded,
              "max_depth limit exceeded in object value",
            ),
          )
        }
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        if lex.tok_tag == tok_rbrace {
          if !lex.advance_raw(true) {
            return Err(lex.take_err())
          }
          finished_val = Some(Value::ObjectValue(empty_obj_fields))
          need_value = false
        } else {
          let fname = match self.expect_name() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          match self.expect_tag(tok_colon, "':'") {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          stack.push(ValFrame::Obj([], fname))
          need_value = true
        }
      } else if tag == tok_dollar {
        if is_const {
          return Err(
            self.err_at_cur(
              ErrorKind::UnexpectedToken,
              "variable not allowed in constant value",
            ),
          )
        }
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        let vname = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        finished_val = Some(Value::Variable(vname))
        need_value = false
      } else if tag == tok_int {
        let s = lex.src.slice(lex.tok_start, lex.tok_end)
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        finished_val = Some(Value::IntValue(s))
        need_value = false
      } else if tag == tok_float {
        let s = lex.src.slice(lex.tok_start, lex.tok_end)
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        finished_val = Some(Value::FloatValue(s))
        need_value = false
      } else if tag == tok_str {
        let s = lex.tok_string_val()
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        finished_val = Some(Value::StringValue(s, false))
        need_value = false
      } else if tag == tok_block_str {
        let s = lex.tok_decoded
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        finished_val = Some(Value::StringValue(s, true))
        need_value = false
      } else if tag == tok_name {
        let src = lex.src
        let st = lex.tok_start
        let en = lex.tok_end
        let v = if slice_eq(src, st, en, "true") {
          Value::BooleanValue(true)
        } else if slice_eq(src, st, en, "false") {
          Value::BooleanValue(false)
        } else if slice_eq(src, st, en, "null") {
          Value::NullValue
        } else {
          Value::EnumValue(self.cur_name())
        }
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        finished_val = Some(v)
        need_value = false
      } else {
        return Err(self.err_unexpected("Value"))
      }
    } else {
      let v_node = match finished_val {
        Some(v) => v
        None => return Err(self.err_unexpected("Value"))
      }
      if stack.length() == 0 {
        return Ok(v_node)
      }
      let top_idx = stack.length() - 1
      let frame = stack[top_idx]
      let _ = stack.pop()
      match frame {
        ValFrame::List(items) => {
          items.push(v_node)
          if lex.tok_tag == tok_rbracket {
            if !lex.advance_raw(true) {
              return Err(lex.take_err())
            }
            finished_val = Some(Value::ListValue(items))
            need_value = false
          } else {
            stack.push(ValFrame::List(items))
            need_value = true
          }
        }
        ValFrame::Obj(fields, cur_name) => {
          fields.push(ObjectField::{ name: cur_name, value: v_node })
          if lex.tok_tag == tok_rbrace {
            if !lex.advance_raw(true) {
              return Err(lex.take_err())
            }
            finished_val = Some(Value::ObjectValue(fields))
            need_value = false
          } else {
            let next_name = match self.expect_name() {
              Ok(n) => n
              Err(e) => return Err(e)
            }
            match self.expect_tag(tok_colon, "':'") {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            stack.push(ValFrame::Obj(fields, next_name))
            need_value = true
          }
        }
      }
    }
  }
  Err(self.err_unexpected("Value"))
}

fn Parser::parse_arguments(
  self : Parser,
  is_const : Bool,
) -> Result[Array[Argument], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lparen {
    return Ok(empty_args)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rparen {
    return Err(self.err_unexpected("at least one argument"))
  }
  let args : Array[Argument] = []
  while true {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_tag(tok_colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let v_node = match self.parse_value_iter(is_const) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    args.push(Argument::{ name: name, value: v_node })
    if lex.tok_tag == tok_rparen {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(args)
}

fn Parser::parse_directives(
  self : Parser,
  is_const : Bool,
) -> Result[Array[Directive], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_at {
    return Ok(empty_directives)
  }
  let dirs : Array[Directive] = []
  while lex.tok_tag == tok_at {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let args = match self.parse_arguments(is_const) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    if !self.bump_node() {
      return Err(lex.take_err())
    }
    dirs.push(Directive::{ name: name, arguments: args })
  }
  Ok(dirs)
}

///| 100% iterative `SelectionSet` parser using a reusable explicit heap stack, bounded by `max_depth` & `max_nodes`.
fn Parser::parse_selection_set_iter(
  self : Parser,
) -> Result[SelectionSet, GraphqlError] {
  let lex = self.lex
  match self.expect_tag(tok_lbrace, "'{'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let stack = self.sel_stack
  stack.clear()
  stack.push(SelFrame::{ kind: SelFrameKind::Root, selections: [] })
  while stack.length() > 0 {
    let tag = lex.tok_tag
    if tag == tok_rbrace {
      let top_idx = stack.length() - 1
      let frame = stack[top_idx]
      if frame.selections.length() == 0 {
        return Err(self.err_unexpected("at least one selection in SelectionSet"))
      }
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      let _ = stack.pop()
      let ss = SelectionSet::{ selections: frame.selections }
      match frame.kind {
        SelFrameKind::Root => return Ok(ss)
        SelFrameKind::FieldFrame(alias_opt, fname, args, dirs) => {
          let parent = stack[stack.length() - 1]
          parent.selections.push(
            Selection::Field(
              Field::{
                alias: alias_opt,
                name: fname,
                arguments: args,
                directives: dirs,
                selection_set: Some(ss),
              },
            ),
          )
        }
        SelFrameKind::InlineFrame(type_cond, dirs) => {
          let parent = stack[stack.length() - 1]
          parent.selections.push(
            Selection::InlineFragment(
              InlineFragment::{
                type_condition: type_cond,
                directives: dirs,
                selection_set: ss,
              },
            ),
          )
        }
      }
    } else if tag == tok_name {
      if !self.bump_node() {
        return Err(lex.take_err())
      }
      let first_name = self.cur_name()
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      let mut alias_opt : Option[String] = None
      let mut field_name = first_name
      if lex.tok_tag == tok_colon {
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        alias_opt = Some(first_name)
        field_name = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
      }
      let args = match self.parse_arguments(false) {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      let dirs = match self.parse_directives(false) {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      if lex.tok_tag == tok_lbrace {
        if stack.length() >= self.max_depth {
          return Err(
            self.err_at_cur(
              ErrorKind::LimitExceeded,
              "max_depth limit exceeded in selection set",
            ),
          )
        }
        if !lex.advance_raw(true) {
          return Err(lex.take_err())
        }
        stack.push(
          SelFrame::{
            kind: SelFrameKind::FieldFrame(alias_opt, field_name, args, dirs),
            selections: [],
          },
        )
      } else {
        let parent = stack[stack.length() - 1]
        parent.selections.push(
          Selection::Field(
            Field::{
              alias: alias_opt,
              name: field_name,
              arguments: args,
              directives: dirs,
              selection_set: None,
            },
          ),
        )
      }
    } else if tag == tok_spread {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      if !self.bump_node() {
        return Err(lex.take_err())
      }
      // InlineFragment: `... on Type @dirs { ... }` or `... @dirs { ... }` or `... { ... }`
      // FragmentSpread: `...FragName @dirs`
      let mut is_inline = false
      let mut type_cond : Option[String] = None
      let ntag = lex.tok_tag
      if ntag == tok_name {
        if self.cur_slice_eq("on") {
          is_inline = true
          if !lex.advance_raw(true) {
            return Err(lex.take_err())
          }
          let tc = match self.expect_name() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          type_cond = Some(tc)
        }
      } else if ntag == tok_at || ntag == tok_lbrace {
        is_inline = true
      } else {
        return Err(self.err_unexpected("fragment name, 'on', '@', or '{'"))
      }
      if is_inline {
        let dirs = match self.parse_directives(false) {
          Ok(d) => d
          Err(e) => return Err(e)
        }
        if stack.length() >= self.max_depth {
          return Err(
            self.err_at_cur(
              ErrorKind::LimitExceeded,
              "max_depth limit exceeded in inline fragment",
            ),
          )
        }
        match self.expect_tag(tok_lbrace, "'{'") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        stack.push(
          SelFrame::{
            kind: SelFrameKind::InlineFrame(type_cond, dirs),
            selections: [],
          },
        )
      } else {
        let frag_name = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        let dirs = match self.parse_directives(false) {
          Ok(d) => d
          Err(e) => return Err(e)
        }
        let parent = stack[stack.length() - 1]
        parent.selections.push(
          Selection::FragmentSpread(
            FragmentSpread::{ name: frag_name, directives: dirs },
          ),
        )
      }
    } else {
      return Err(
        self.err_unexpected("Field, FragmentSpread, InlineFragment, or '}'"),
      )
    }
  }
  Err(self.err_unexpected("'}'"))
}

fn Parser::parse_variable_definitions(
  self : Parser,
) -> Result[Array[VariableDefinition], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lparen {
    return Ok(empty_var_defs)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rparen {
    return Err(self.err_unexpected("at least one variable definition"))
  }
  let vars : Array[VariableDefinition] = []
  while true {
    match self.expect_tag(tok_dollar, "'$'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_tag(tok_colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let var_type = match self.parse_type_ref() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let mut default_val : Option[Value] = None
    if lex.tok_tag == tok_equals {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      let v = match self.parse_value_iter(true) {
        Ok(v_node) => v_node
        Err(e) => return Err(e)
      }
      default_val = Some(v)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    vars.push(
      VariableDefinition::{
        name: name,
        var_type: var_type,
        default_value: default_val,
        directives: dirs,
      },
    )
    if lex.tok_tag == tok_rparen {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(vars)
}

fn Parser::parse_operation_definition(
  self : Parser,
) -> Result[OperationDefinition, GraphqlError] {
  let lex = self.lex
  if lex.tok_tag == tok_lbrace {
    let ss = match self.parse_selection_set_iter() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(
      OperationDefinition::{
        op_type: OperationType::Query,
        is_shorthand: true,
        name: None,
        variable_definitions: empty_var_defs,
        directives: empty_directives,
        selection_set: ss,
      },
    )
  }
  if lex.tok_tag != tok_name {
    return Err(self.err_unexpected("Name"))
  }
  let op_type = if self.cur_slice_eq("query") {
    OperationType::Query
  } else if self.cur_slice_eq("mutation") {
    OperationType::Mutation
  } else if self.cur_slice_eq("subscription") {
    OperationType::Subscription
  } else {
    return Err(self.err_unexpected("'query', 'mutation', or 'subscription'"))
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  let mut name : Option[String] = None
  if lex.tok_tag == tok_name {
    name = Some(self.cur_name())
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
  }
  let vars = match self.parse_variable_definitions() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dirs = match self.parse_directives(false) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let ss = match self.parse_selection_set_iter() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(
    OperationDefinition::{
      op_type: op_type,
      is_shorthand: false,
      name: name,
      variable_definitions: vars,
      directives: dirs,
      selection_set: ss,
    },
  )
}

fn Parser::parse_fragment_definition(
  self : Parser,
) -> Result[FragmentDefinition, GraphqlError] {
  match self.expect_keyword("fragment") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if name == "on" {
    return Err(
      self.err_at_cur(ErrorKind::InvalidSyntax, "fragment name cannot be 'on'"),
    )
  }
  match self.expect_keyword("on") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let type_cond = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let dirs = match self.parse_directives(false) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let ss = match self.parse_selection_set_iter() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(
    FragmentDefinition::{
      name: name,
      type_condition: type_cond,
      directives: dirs,
      selection_set: ss,
    },
  )
}

fn Parser::parse_optional_description(
  self : Parser,
) -> Result[Option[Description], GraphqlError] {
  let lex = self.lex
  let tag = lex.tok_tag
  if tag == tok_str {
    let s = lex.tok_string_val()
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Some(Description::{ value: s, is_block: false }))
  }
  if tag == tok_block_str {
    let s = lex.tok_decoded
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    return Ok(Some(Description::{ value: s, is_block: true }))
  }
  Ok(None)
}

fn Parser::parse_operation_type_defs(
  self : Parser,
) -> Result[Array[OperationTypeDefinition], GraphqlError] {
  let lex = self.lex
  match self.expect_tag(tok_lbrace, "'{'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if lex.tok_tag == tok_rbrace {
    return Err(self.err_unexpected("at least one operation type definition"))
  }
  let out : Array[OperationTypeDefinition] = []
  while true {
    if lex.tok_tag != tok_name {
      return Err(self.err_unexpected("Name"))
    }
    let op_type = if self.cur_slice_eq("query") {
      OperationType::Query
    } else if self.cur_slice_eq("mutation") {
      OperationType::Mutation
    } else if self.cur_slice_eq("subscription") {
      OperationType::Subscription
    } else {
      return Err(self.err_unexpected("'query', 'mutation', or 'subscription'"))
    }
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    match self.expect_tag(tok_colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let named = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    out.push(OperationTypeDefinition::{ op_type: op_type, named_type: named })
    if lex.tok_tag == tok_rbrace {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(out)
}

fn Parser::parse_implements_interfaces(
  self : Parser,
) -> Result[Array[String], GraphqlError] {
  let lex = self.lex
  match self.skip_keyword("implements") {
    Ok(false) => return Ok(empty_strings)
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  if lex.tok_tag == tok_amp {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
  }
  let ifaces : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  ifaces.push(first)
  while lex.tok_tag == tok_amp {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let next = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    ifaces.push(next)
  }
  Ok(ifaces)
}

fn Parser::parse_input_value_def(
  self : Parser,
) -> Result[InputValueDefinition, GraphqlError] {
  let lex = self.lex
  let desc = match self.parse_optional_description() {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_tag(tok_colon, "':'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let vtype = match self.parse_type_ref() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let mut def_val : Option[Value] = None
  if lex.tok_tag == tok_equals {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let v = match self.parse_value_iter(true) {
      Ok(v_node) => v_node
      Err(e) => return Err(e)
    }
    def_val = Some(v)
  }
  let dirs = match self.parse_directives(true) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  if !self.bump_node() {
    return Err(lex.take_err())
  }
  Ok(
    InputValueDefinition::{
      description: desc,
      name: name,
      value_type: vtype,
      default_value: def_val,
      directives: dirs,
    },
  )
}

fn Parser::parse_arguments_def(
  self : Parser,
) -> Result[Array[InputValueDefinition], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lparen {
    return Ok(empty_input_values)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rparen {
    return Err(self.err_unexpected("at least one argument definition"))
  }
  let out : Array[InputValueDefinition] = []
  while true {
    let iv = match self.parse_input_value_def() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(iv)
    if lex.tok_tag == tok_rparen {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(out)
}

fn Parser::parse_fields_def(
  self : Parser,
) -> Result[Array[FieldDefinition], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lbrace {
    return Ok(empty_fields)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rbrace {
    return Err(self.err_unexpected("at least one field definition"))
  }
  let out : Array[FieldDefinition] = []
  while true {
    let desc = match self.parse_optional_description() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let args = match self.parse_arguments_def() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match self.expect_tag(tok_colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let ftype = match self.parse_type_ref() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    if !self.bump_node() {
      return Err(lex.take_err())
    }
    out.push(
      FieldDefinition::{
        description: desc,
        name: name,
        arguments: args,
        field_type: ftype,
        directives: dirs,
      },
    )
    if lex.tok_tag == tok_rbrace {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(out)
}

fn Parser::parse_union_members(
  self : Parser,
) -> Result[Array[String], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_equals {
    return Ok(empty_strings)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_pipe {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
  }
  let members : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  members.push(first)
  while lex.tok_tag == tok_pipe {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let next = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    members.push(next)
  }
  Ok(members)
}

fn Parser::parse_enum_values_def(
  self : Parser,
) -> Result[Array[EnumValueDefinition], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lbrace {
    return Ok(empty_enum_vals)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rbrace {
    return Err(self.err_unexpected("at least one enum value definition"))
  }
  let out : Array[EnumValueDefinition] = []
  while true {
    let desc = match self.parse_optional_description() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    if name == "true" || name == "false" || name == "null" {
      return Err(
        self.err_at_cur(
          ErrorKind::InvalidSyntax,
          "enum value name cannot be '" + name + "'",
        ),
      )
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    if !self.bump_node() {
      return Err(lex.take_err())
    }
    out.push(
      EnumValueDefinition::{ description: desc, name: name, directives: dirs },
    )
    if lex.tok_tag == tok_rbrace {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(out)
}

fn Parser::parse_input_fields_def(
  self : Parser,
) -> Result[Array[InputValueDefinition], GraphqlError] {
  let lex = self.lex
  if lex.tok_tag != tok_lbrace {
    return Ok(empty_input_values)
  }
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_rbrace {
    return Err(self.err_unexpected("at least one input field definition"))
  }
  let out : Array[InputValueDefinition] = []
  while true {
    let iv = match self.parse_input_value_def() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(iv)
    if lex.tok_tag == tok_rbrace {
      if !lex.advance_raw(true) {
        return Err(lex.take_err())
      }
      break
    }
  }
  Ok(out)
}

fn is_valid_directive_location(loc : String) -> Bool {
  loc == "QUERY" ||
  loc == "MUTATION" ||
  loc == "SUBSCRIPTION" ||
  loc == "FIELD" ||
  loc == "FRAGMENT_DEFINITION" ||
  loc == "FRAGMENT_SPREAD" ||
  loc == "INLINE_FRAGMENT" ||
  loc == "VARIABLE_DEFINITION" ||
  loc == "SCHEMA" ||
  loc == "SCALAR" ||
  loc == "OBJECT" ||
  loc == "FIELD_DEFINITION" ||
  loc == "ARGUMENT_DEFINITION" ||
  loc == "INTERFACE" ||
  loc == "UNION" ||
  loc == "ENUM" ||
  loc == "ENUM_VALUE" ||
  loc == "INPUT_OBJECT" ||
  loc == "INPUT_FIELD_DEFINITION"
}

fn Parser::parse_directive_definition(
  self : Parser,
  desc : Option[Description],
) -> Result[DirectiveDefinition, GraphqlError] {
  let lex = self.lex
  match self.expect_keyword("directive") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.expect_tag(tok_at, "'@'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let args = match self.parse_arguments_def() {
    Ok(a) => a
    Err(e) => return Err(e)
  }
  let repeatable = match self.skip_keyword("repeatable") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match self.expect_keyword("on") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if lex.tok_tag == tok_pipe {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
  }
  let locs : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if !is_valid_directive_location(first) {
    return Err(
      self.err_at_cur(
        ErrorKind::InvalidSyntax,
        "invalid directive location: " + first,
      ),
    )
  }
  locs.push(first)
  while lex.tok_tag == tok_pipe {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let loc = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    if !is_valid_directive_location(loc) {
      return Err(
        self.err_at_cur(
          ErrorKind::InvalidSyntax,
          "invalid directive location: " + loc,
        ),
      )
    }
    locs.push(loc)
  }
  Ok(
    DirectiveDefinition::{
      description: desc,
      name: name,
      arguments: args,
      repeatable: repeatable,
      locations: locs,
    },
  )
}

fn Parser::parse_type_system_extension(
  self : Parser,
) -> Result[Definition, GraphqlError] {
  let lex = self.lex
  match self.expect_keyword("extend") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if lex.tok_tag != tok_name {
    return Err(self.err_unexpected("Name"))
  }
  let src = lex.src
  let st = lex.tok_start
  let en = lex.tok_end
  let n = en - st
  let b0 = src.code_unit_at(st)
  if n == 4 && b0 == 116 && slice_eq(src, st, en, "type") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if ifaces.length() == 0 && dirs.length() == 0 && fields.length() == 0 {
      return Err(self.err_unexpected("implements, directives, or fields in extend type"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Object(
          ObjectTypeExtension::{
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if n == 6 && b0 == 115 && slice_eq(src, st, en, "schema") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let ops = if lex.tok_tag == tok_lbrace {
      match self.parse_operation_type_defs() {
        Ok(o) => o
        Err(e) => return Err(e)
      }
    } else {
      empty_op_types
    }
    if dirs.length() == 0 && ops.length() == 0 {
      return Err(
        self.err_unexpected("directives or operation types in extend schema"),
      )
    }
    return Ok(
      Definition::SchemaExtension(
        SchemaExtension::{ directives: dirs, operation_types: ops },
      ),
    )
  }
  if n == 6 && b0 == 115 && slice_eq(src, st, en, "scalar") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 {
      return Err(self.err_unexpected("directives in extend scalar"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Scalar(
          ScalarTypeExtension::{ name: name, directives: dirs },
        ),
      ),
    )
  }
  if n == 9 && b0 == 105 && slice_eq(src, st, en, "interface") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if ifaces.length() == 0 && dirs.length() == 0 && fields.length() == 0 {
      return Err(
        self.err_unexpected("implements, directives, or fields in extend interface"),
      )
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Interface(
          InterfaceTypeExtension::{
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if n == 5 && b0 == 117 && slice_eq(src, st, en, "union") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let members = match self.parse_union_members() {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && members.length() == 0 {
      return Err(self.err_unexpected("directives or members in extend union"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Union(
          UnionTypeExtension::{ name: name, directives: dirs, members: members },
        ),
      ),
    )
  }
  if n == 4 && b0 == 101 && slice_eq(src, st, en, "enum") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let vals = match self.parse_enum_values_def() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && vals.length() == 0 {
      return Err(self.err_unexpected("directives or values in extend enum"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Enum(
          EnumTypeExtension::{ name: name, directives: dirs, values: vals },
        ),
      ),
    )
  }
  if n == 5 && b0 == 105 && slice_eq(src, st, en, "input") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_input_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && fields.length() == 0 {
      return Err(self.err_unexpected("directives or fields in extend input"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::InputObject(
          InputObjectTypeExtension::{
            name: name,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  // Advance past unknown keyword to match prior error position
  if !lex.advance_raw(true) {
    return Err(lex.take_err())
  }
  Err(self.err_unexpected("schema, scalar, type, interface, union, enum, or input after extend"))
}

fn Parser::parse_definition(self : Parser) -> Result[Definition, GraphqlError] {
  let lex = self.lex
  if !self.bump_node() {
    return Err(lex.take_err())
  }
  if lex.tok_tag == tok_lbrace {
    let op = match self.parse_operation_definition() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(Definition::Operation(op))
  }
  let desc = match self.parse_optional_description() {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let has_desc = match desc {
    Some(_) => true
    None => false
  }
  if lex.tok_tag != tok_name {
    return Err(self.err_unexpected("definition keyword"))
  }
  let src = lex.src
  let st = lex.tok_start
  let en = lex.tok_end
  let n = en - st
  let b0 = src.code_unit_at(st)

  if b0 == 116 && n == 4 && slice_eq(src, st, en, "type") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Object(
          ObjectTypeDefinition::{
            description: desc,
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if b0 == 105 && n == 5 && slice_eq(src, st, en, "input") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_input_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::InputObject(
          InputObjectTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if b0 == 101 && n == 6 && slice_eq(src, st, en, "extend") {
    if has_desc {
      return Err(self.err_unexpected("no description on type system extension"))
    }
    return self.parse_type_system_extension()
  }
  if b0 == 113 && n == 5 && slice_eq(src, st, en, "query") {
    if has_desc {
      return Err(self.err_unexpected("no description on executable operation"))
    }
    let op = match self.parse_operation_definition() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(Definition::Operation(op))
  }
  if b0 == 102 && n == 8 && slice_eq(src, st, en, "fragment") {
    if has_desc {
      return Err(self.err_unexpected("no description on fragment definition"))
    }
    let frag = match self.parse_fragment_definition() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(Definition::Fragment(frag))
  }
  if b0 == 117 && n == 5 && slice_eq(src, st, en, "union") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let members = match self.parse_union_members() {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Union(
          UnionTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            members: members,
          },
        ),
      ),
    )
  }
  if b0 == 101 && n == 4 && slice_eq(src, st, en, "enum") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let vals = match self.parse_enum_values_def() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Enum(
          EnumTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            values: vals,
          },
        ),
      ),
    )
  }
  if b0 == 105 && n == 9 && slice_eq(src, st, en, "interface") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Interface(
          InterfaceTypeDefinition::{
            description: desc,
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if (b0 == 109 && n == 8 && slice_eq(src, st, en, "mutation")) ||
  (b0 == 115 && n == 12 && slice_eq(src, st, en, "subscription")) {
    if has_desc {
      return Err(self.err_unexpected("no description on executable operation"))
    }
    let op = match self.parse_operation_definition() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(Definition::Operation(op))
  }
  if b0 == 115 && n == 6 && slice_eq(src, st, en, "schema") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let ops = match self.parse_operation_type_defs() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::Schema(
        SchemaDefinition::{
          description: desc,
          directives: dirs,
          operation_types: ops,
        },
      ),
    )
  }
  if b0 == 115 && n == 6 && slice_eq(src, st, en, "scalar") {
    if !lex.advance_raw(true) {
      return Err(lex.take_err())
    }
    let name = match self.expect_name() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Scalar(
          ScalarTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
          },
        ),
      ),
    )
  }
  if b0 == 100 && n == 9 && slice_eq(src, st, en, "directive") {
    let dd = match self.parse_directive_definition(desc) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    return Ok(Definition::DirectiveDef(dd))
  }
  Err(self.err_unexpected("definition"))
}

fn parse_impl(
  src : String,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  let p = match Parser::new(src, opts) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  if p.lex.tok_tag == tok_eof {
    return Err(p.err_at_cur(ErrorKind::UnexpectedEof, "empty GraphQL document"))
  }
  let est_defs = if src.length() > 1024 { src.length() / 160 } else { 4 }
  let defs : Array[Definition] = Array::with_capacity(est_defs)
  while p.lex.tok_tag != tok_eof {
    let def = match p.parse_definition() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    defs.push(def)
  }
  Ok(Document::{ definitions: defs })
}

fn parse_bytes_impl(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  match validate_utf8_bytes(src) {
    Ok(s) => parse_impl(s, opts)
    Err(e) => Err(e)
  }
}

fn parse_value_impl(src : String) -> Result[Value, GraphqlError] {
  let p = match Parser::new(src, ParseOptions::default()) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let v_node = match p.parse_value_iter(false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if p.lex.tok_tag == tok_eof {
    Ok(v_node)
  } else {
    Err(p.err_unexpected("EOF"))
  }
}

fn parse_type_impl(src : String) -> Result[TypeRef, GraphqlError] {
  let p = match Parser::new(src, ParseOptions::default()) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let ty = match p.parse_type_ref() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if p.lex.tok_tag == tok_eof {
    Ok(ty)
  } else {
    Err(p.err_unexpected("EOF"))
  }
}
