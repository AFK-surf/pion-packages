///| 100% iterative explicit-stack GraphQL (October 2021) AST Parser (Executable + Schema SDL).

struct Parser {
  lex : Lexer
  opts : ParseOptions
  mut cur : Token
  mut has_peek : Bool
  mut peek_tok : Token
  mut node_count : Int
}

fn Parser::new(src : String, opts : ParseOptions) -> Result[Parser, GraphqlError] {
  let lex = Lexer::new(src, opts.max_tokens)
  let first = match lex.next_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  Ok(
    Parser::{
      lex: lex,
      opts: opts,
      cur: first,
      has_peek: false,
      peek_tok: Token::{ kind: TokenKind::Eof, line: 1, col: 1, offset: 0, len: 0 },
      node_count: 0,
    },
  )
}

fn Parser::bump_node(self : Parser) -> Result[Unit, GraphqlError] {
  self.node_count = self.node_count + 1
  if self.node_count > self.opts.max_nodes {
    return Err(
      GraphqlError::new(
        ErrorKind::LimitExceeded,
        self.cur.line,
        self.cur.col,
        self.cur.offset,
        "max_nodes limit exceeded",
      ),
    )
  }
  Ok(())
}

fn Parser::advance(self : Parser) -> Result[Token, GraphqlError] {
  let prev = self.cur
  if self.has_peek {
    self.cur = self.peek_tok
    self.has_peek = false
    return Ok(prev)
  }
  match self.lex.next_token() {
    Ok(next) => {
      self.cur = next
      Ok(prev)
    }
    Err(e) => Err(e)
  }
}

fn Parser::peek(self : Parser) -> Result[Token, GraphqlError] {
  if !self.has_peek {
    match self.lex.next_token() {
      Ok(next) => {
        self.peek_tok = next
        self.has_peek = true
      }
      Err(e) => return Err(e)
    }
  }
  Ok(self.peek_tok)
}

fn Parser::err_unexpected(self : Parser, expected : String) -> GraphqlError {
  let kind = match self.cur.kind {
    TokenKind::Eof => ErrorKind::UnexpectedEof
    _ => ErrorKind::UnexpectedToken
  }
  GraphqlError::new(
    kind,
    self.cur.line,
    self.cur.col,
    self.cur.offset,
    "expected " + expected,
  )
}

fn Parser::expect_name(self : Parser) -> Result[String, GraphqlError] {
  match self.cur.kind {
    TokenKind::Name(s) => {
      match self.advance() {
        Ok(_) => Ok(s)
        Err(e) => Err(e)
      }
    }
    _ => Err(self.err_unexpected("Name"))
  }
}

fn Parser::expect_keyword(self : Parser, kw : String) -> Result[Unit, GraphqlError] {
  match self.cur.kind {
    TokenKind::Name(s) => {
      if s == kw {
        match self.advance() {
          Ok(_) => Ok(())
          Err(e) => Err(e)
        }
      } else {
        Err(self.err_unexpected("keyword '" + kw + "'"))
      }
    }
    _ => Err(self.err_unexpected("keyword '" + kw + "'"))
  }
}

fn Parser::skip_keyword(self : Parser, kw : String) -> Result[Bool, GraphqlError] {
  match self.cur.kind {
    TokenKind::Name(s) => {
      if s == kw {
        match self.advance() {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      } else {
        Ok(false)
      }
    }
    _ => Ok(false)
  }
}

fn Parser::expect_punct(
  self : Parser,
  expected : TokenKind,
  label : String,
) -> Result[Unit, GraphqlError] {
  if token_kind_eq(self.cur.kind, expected) {
    match self.advance() {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
  } else {
    Err(self.err_unexpected(label))
  }
}

fn Parser::skip_punct(self : Parser, expected : TokenKind) -> Result[Bool, GraphqlError] {
  if token_kind_eq(self.cur.kind, expected) {
    match self.advance() {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
  } else {
    Ok(false)
  }
}

///| 100% iterative `TypeRef` parser (`[[String!]!]!`), bounded by `max_depth`.
fn Parser::parse_type_ref(self : Parser) -> Result[TypeRef, GraphqlError] {
  let mut list_depth = 0
  while true {
    match self.cur.kind {
      TokenKind::LBracket => {
        list_depth = list_depth + 1
        if list_depth > self.opts.max_depth {
          return Err(
            GraphqlError::new(
              ErrorKind::LimitExceeded,
              self.cur.line,
              self.cur.col,
              self.cur.offset,
              "max_depth limit exceeded in type",
            ),
          )
        }
        match self.advance() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      _ => break
    }
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.bump_node() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut ty = TypeRef::Named(name)
  match self.skip_punct(TokenKind::Bang) {
    Ok(true) => {
      ty = TypeRef::NonNull(ty)
      match self.cur.kind {
        TokenKind::Bang => return Err(self.err_unexpected("no duplicate '!'"))
        _ => ()
      }
    }
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  while list_depth > 0 {
    match self.expect_punct(TokenKind::RBracket, "']'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    ty = TypeRef::List(ty)
    match self.bump_node() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match self.skip_punct(TokenKind::Bang) {
      Ok(true) => {
        ty = TypeRef::NonNull(ty)
        match self.cur.kind {
          TokenKind::Bang => return Err(self.err_unexpected("no duplicate '!'"))
          _ => ()
        }
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    list_depth = list_depth - 1
  }
  Ok(ty)
}

enum ValFrame {
  List(Array[Value])
  Obj(Array[ObjectField], String)
}

///| 100% iterative `Value` parser using an explicit heap stack, bounded by `max_depth` & `max_nodes`.
fn Parser::parse_value_iter(
  self : Parser,
  is_const : Bool,
) -> Result[Value, GraphqlError] {
  let stack : Array[ValFrame] = []
  let mut need_value = true
  let mut finished_val : Option[Value] = None

  while true {
    if need_value {
      match self.bump_node() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.cur.kind {
        TokenKind::LBracket => {
          if stack.length() >= self.opts.max_depth {
            return Err(
              GraphqlError::new(
                ErrorKind::LimitExceeded,
                self.cur.line,
                self.cur.col,
                self.cur.offset,
                "max_depth limit exceeded in list value",
              ),
            )
          }
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match self.cur.kind {
            TokenKind::RBracket => {
              match self.advance() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              finished_val = Some(Value::ListValue([]))
              need_value = false
            }
            _ => {
              stack.push(ValFrame::List([]))
              need_value = true
            }
          }
        }
        TokenKind::LBrace => {
          if stack.length() >= self.opts.max_depth {
            return Err(
              GraphqlError::new(
                ErrorKind::LimitExceeded,
                self.cur.line,
                self.cur.col,
                self.cur.offset,
                "max_depth limit exceeded in object value",
              ),
            )
          }
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match self.cur.kind {
            TokenKind::RBrace => {
              match self.advance() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              finished_val = Some(Value::ObjectValue([]))
              need_value = false
            }
            _ => {
              let fname = match self.expect_name() {
                Ok(n) => n
                Err(e) => return Err(e)
              }
              match self.expect_punct(TokenKind::Colon, "':'") {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              stack.push(ValFrame::Obj([], fname))
              need_value = true
            }
          }
        }
        TokenKind::Dollar => {
          if is_const {
            return Err(
              GraphqlError::new(
                ErrorKind::UnexpectedToken,
                self.cur.line,
                self.cur.col,
                self.cur.offset,
                "variable not allowed in constant value",
              ),
            )
          }
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          let vname = match self.expect_name() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          finished_val = Some(Value::Variable(vname))
          need_value = false
        }
        TokenKind::Int(s) => {
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          finished_val = Some(Value::IntValue(s))
          need_value = false
        }
        TokenKind::Float(s) => {
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          finished_val = Some(Value::FloatValue(s))
          need_value = false
        }
        TokenKind::Str(s) => {
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          finished_val = Some(Value::StringValue(s, false))
          need_value = false
        }
        TokenKind::BlockStr(s) => {
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          finished_val = Some(Value::StringValue(s, true))
          need_value = false
        }
        TokenKind::Name(s) => {
          match self.advance() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          if s == "true" {
            finished_val = Some(Value::BooleanValue(true))
          } else if s == "false" {
            finished_val = Some(Value::BooleanValue(false))
          } else if s == "null" {
            finished_val = Some(Value::NullValue)
          } else {
            finished_val = Some(Value::EnumValue(s))
          }
          need_value = false
        }
        _ => return Err(self.err_unexpected("Value"))
      }
    } else {
      let v_node = match finished_val {
        Some(v) => v
        None => return Err(self.err_unexpected("Value"))
      }
      if stack.length() == 0 {
        return Ok(v_node)
      }
      let top_idx = stack.length() - 1
      let frame = stack[top_idx]
      let _ = stack.pop()
      match frame {
        ValFrame::List(items) => {
          items.push(v_node)
          match self.cur.kind {
            TokenKind::RBracket => {
              match self.advance() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              finished_val = Some(Value::ListValue(items))
              need_value = false
            }
            _ => {
              stack.push(ValFrame::List(items))
              need_value = true
            }
          }
        }
        ValFrame::Obj(fields, cur_name) => {
          fields.push(ObjectField::{ name: cur_name, value: v_node })
          match self.cur.kind {
            TokenKind::RBrace => {
              match self.advance() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              finished_val = Some(Value::ObjectValue(fields))
              need_value = false
            }
            _ => {
              let next_name = match self.expect_name() {
                Ok(n) => n
                Err(e) => return Err(e)
              }
              match self.expect_punct(TokenKind::Colon, "':'") {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              stack.push(ValFrame::Obj(fields, next_name))
              need_value = true
            }
          }
        }
      }
    }
  }
  Err(self.err_unexpected("Value"))
}

fn Parser::parse_arguments(
  self : Parser,
  is_const : Bool,
) -> Result[Array[Argument], GraphqlError] {
  match self.cur.kind {
    TokenKind::LParen => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let args : Array[Argument] = []
  match self.cur.kind {
    TokenKind::RParen => return Err(self.err_unexpected("at least one argument"))
    _ => ()
  }
  while true {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_punct(TokenKind::Colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let v_node = match self.parse_value_iter(is_const) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    args.push(Argument::{ name: name, value: v_node })
    match self.cur.kind {
      TokenKind::RParen => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(args)
}

fn Parser::parse_directives(
  self : Parser,
  is_const : Bool,
) -> Result[Array[Directive], GraphqlError] {
  let dirs : Array[Directive] = []
  while true {
    match self.cur.kind {
      TokenKind::At => {
        match self.advance() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let name = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        let args = match self.parse_arguments(is_const) {
          Ok(a) => a
          Err(e) => return Err(e)
        }
        match self.bump_node() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        dirs.push(Directive::{ name: name, arguments: args })
      }
      _ => break
    }
  }
  Ok(dirs)
}

enum SelFrameKind {
  Root
  FieldFrame(Option[String], String, Array[Argument], Array[Directive])
  InlineFrame(Option[String], Array[Directive])
}

struct SelFrame {
  kind : SelFrameKind
  selections : Array[Selection]
}

///| 100% iterative `SelectionSet` parser using an explicit heap stack, bounded by `max_depth` & `max_nodes`.
fn Parser::parse_selection_set_iter(
  self : Parser,
) -> Result[SelectionSet, GraphqlError] {
  match self.expect_punct(TokenKind::LBrace, "'{'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let stack : Array[SelFrame] = [
    SelFrame::{ kind: SelFrameKind::Root, selections: [] },
  ]
  while stack.length() > 0 {
    match self.cur.kind {
      TokenKind::RBrace => {
        let top_idx = stack.length() - 1
        let frame = stack[top_idx]
        if frame.selections.length() == 0 {
          return Err(self.err_unexpected("at least one selection in SelectionSet"))
        }
        match self.advance() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let _ = stack.pop()
        let ss = SelectionSet::{ selections: frame.selections }
        match frame.kind {
          SelFrameKind::Root => return Ok(ss)
          SelFrameKind::FieldFrame(alias_opt, fname, args, dirs) => {
            let parent = stack[stack.length() - 1]
            parent.selections.push(
              Selection::Field(
                Field::{
                  alias: alias_opt,
                  name: fname,
                  arguments: args,
                  directives: dirs,
                  selection_set: Some(ss),
                },
              ),
            )
          }
          SelFrameKind::InlineFrame(type_cond, dirs) => {
            let parent = stack[stack.length() - 1]
            parent.selections.push(
              Selection::InlineFragment(
                InlineFragment::{
                  type_condition: type_cond,
                  directives: dirs,
                  selection_set: ss,
                },
              ),
            )
          }
        }
      }
      TokenKind::Spread => {
        match self.advance() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match self.bump_node() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        // InlineFragment: `... on Type @dirs { ... }` or `... @dirs { ... }` or `... { ... }`
        // FragmentSpread: `...FragName @dirs`
        let mut is_inline = false
        let mut type_cond : Option[String] = None
        match self.cur.kind {
          TokenKind::Name(s) => {
            if s == "on" {
              is_inline = true
              match self.advance() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              let tc = match self.expect_name() {
                Ok(n) => n
                Err(e) => return Err(e)
              }
              type_cond = Some(tc)
            }
          }
          TokenKind::At | TokenKind::LBrace => is_inline = true
          _ => return Err(self.err_unexpected("fragment name, 'on', '@', or '{'"))
        }
        if is_inline {
          let dirs = match self.parse_directives(false) {
            Ok(d) => d
            Err(e) => return Err(e)
          }
          if stack.length() >= self.opts.max_depth {
            return Err(
              GraphqlError::new(
                ErrorKind::LimitExceeded,
                self.cur.line,
                self.cur.col,
                self.cur.offset,
                "max_depth limit exceeded in inline fragment",
              ),
            )
          }
          match self.expect_punct(TokenKind::LBrace, "'{'") {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          stack.push(
            SelFrame::{
              kind: SelFrameKind::InlineFrame(type_cond, dirs),
              selections: [],
            },
          )
        } else {
          let frag_name = match self.expect_name() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          let dirs = match self.parse_directives(false) {
            Ok(d) => d
            Err(e) => return Err(e)
          }
          let parent = stack[stack.length() - 1]
          parent.selections.push(
            Selection::FragmentSpread(
              FragmentSpread::{ name: frag_name, directives: dirs },
            ),
          )
        }
      }
      TokenKind::Name(_) => {
        match self.bump_node() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let first_name = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        let mut alias_opt : Option[String] = None
        let mut field_name = first_name
        match self.cur.kind {
          TokenKind::Colon => {
            match self.advance() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            alias_opt = Some(first_name)
            field_name = match self.expect_name() {
              Ok(n) => n
              Err(e) => return Err(e)
            }
          }
          _ => ()
        }
        let args = match self.parse_arguments(false) {
          Ok(a) => a
          Err(e) => return Err(e)
        }
        let dirs = match self.parse_directives(false) {
          Ok(d) => d
          Err(e) => return Err(e)
        }
        match self.cur.kind {
          TokenKind::LBrace => {
            if stack.length() >= self.opts.max_depth {
              return Err(
                GraphqlError::new(
                  ErrorKind::LimitExceeded,
                  self.cur.line,
                  self.cur.col,
                  self.cur.offset,
                  "max_depth limit exceeded in selection set",
                ),
              )
            }
            match self.advance() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            stack.push(
              SelFrame::{
                kind: SelFrameKind::FieldFrame(alias_opt, field_name, args, dirs),
                selections: [],
              },
            )
          }
          _ => {
            let parent = stack[stack.length() - 1]
            parent.selections.push(
              Selection::Field(
                Field::{
                  alias: alias_opt,
                  name: field_name,
                  arguments: args,
                  directives: dirs,
                  selection_set: None,
                },
              ),
            )
          }
        }
      }
      _ => return Err(self.err_unexpected("Field, FragmentSpread, InlineFragment, or '}'"))
    }
  }
  Err(self.err_unexpected("'}'"))
}

fn Parser::parse_variable_definitions(
  self : Parser,
) -> Result[Array[VariableDefinition], GraphqlError] {
  match self.cur.kind {
    TokenKind::LParen => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RParen =>
    return Err(self.err_unexpected("at least one variable definition"))
    _ => ()
  }
  let vars : Array[VariableDefinition] = []
  while true {
    match self.expect_punct(TokenKind::Dollar, "'$'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_punct(TokenKind::Colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let var_type = match self.parse_type_ref() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let mut default_val : Option[Value] = None
    match self.skip_punct(TokenKind::Equals) {
      Ok(true) => {
        let v = match self.parse_value_iter(true) {
          Ok(v_node) => v_node
          Err(e) => return Err(e)
        }
        default_val = Some(v)
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    vars.push(
      VariableDefinition::{
        name: name,
        var_type: var_type,
        default_value: default_val,
        directives: dirs,
      },
    )
    match self.cur.kind {
      TokenKind::RParen => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(vars)
}

fn Parser::parse_operation_definition(
  self : Parser,
) -> Result[OperationDefinition, GraphqlError] {
  match self.cur.kind {
    TokenKind::LBrace => {
      let ss = match self.parse_selection_set_iter() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      return Ok(
        OperationDefinition::{
          op_type: OperationType::Query,
          is_shorthand: true,
          name: None,
          variable_definitions: [],
          directives: [],
          selection_set: ss,
        },
      )
    }
    _ => ()
  }
  let op_kw = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let op_type = if op_kw == "query" {
    OperationType::Query
  } else if op_kw == "mutation" {
    OperationType::Mutation
  } else if op_kw == "subscription" {
    OperationType::Subscription
  } else {
    return Err(self.err_unexpected("'query', 'mutation', or 'subscription'"))
  }
  let mut name : Option[String] = None
  match self.cur.kind {
    TokenKind::Name(n) => {
      name = Some(n)
      match self.advance() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    _ => ()
  }
  let vars = match self.parse_variable_definitions() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dirs = match self.parse_directives(false) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let ss = match self.parse_selection_set_iter() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(
    OperationDefinition::{
      op_type: op_type,
      is_shorthand: false,
      name: name,
      variable_definitions: vars,
      directives: dirs,
      selection_set: ss,
    },
  )
}

fn Parser::parse_fragment_definition(
  self : Parser,
) -> Result[FragmentDefinition, GraphqlError] {
  match self.expect_keyword("fragment") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if name == "on" {
    return Err(
      GraphqlError::new(
        ErrorKind::InvalidSyntax,
        self.cur.line,
        self.cur.col,
        self.cur.offset,
        "fragment name cannot be 'on'",
      ),
    )
  }
  match self.expect_keyword("on") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let type_cond = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let dirs = match self.parse_directives(false) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let ss = match self.parse_selection_set_iter() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(
    FragmentDefinition::{
      name: name,
      type_condition: type_cond,
      directives: dirs,
      selection_set: ss,
    },
  )
}

fn Parser::parse_optional_description(
  self : Parser,
) -> Result[Option[Description], GraphqlError] {
  match self.cur.kind {
    TokenKind::Str(s) => {
      match self.advance() {
        Ok(_) => Ok(Some(Description::{ value: s, is_block: false }))
        Err(e) => Err(e)
      }
    }
    TokenKind::BlockStr(s) => {
      match self.advance() {
        Ok(_) => Ok(Some(Description::{ value: s, is_block: true }))
        Err(e) => Err(e)
      }
    }
    _ => Ok(None)
  }
}

fn Parser::parse_operation_type_defs(
  self : Parser,
) -> Result[Array[OperationTypeDefinition], GraphqlError] {
  match self.expect_punct(TokenKind::LBrace, "'{'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RBrace =>
    return Err(self.err_unexpected("at least one operation type definition"))
    _ => ()
  }
  let out : Array[OperationTypeDefinition] = []
  while true {
    let kw = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let op_type = if kw == "query" {
      OperationType::Query
    } else if kw == "mutation" {
      OperationType::Mutation
    } else if kw == "subscription" {
      OperationType::Subscription
    } else {
      return Err(self.err_unexpected("'query', 'mutation', or 'subscription'"))
    }
    match self.expect_punct(TokenKind::Colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let named = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    out.push(OperationTypeDefinition::{ op_type: op_type, named_type: named })
    match self.cur.kind {
      TokenKind::RBrace => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(out)
}

fn Parser::parse_implements_interfaces(
  self : Parser,
) -> Result[Array[String], GraphqlError] {
  match self.skip_keyword("implements") {
    Ok(false) => return Ok([])
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  let _ = match self.skip_punct(TokenKind::Amp) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let ifaces : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  ifaces.push(first)
  while true {
    match self.skip_punct(TokenKind::Amp) {
      Ok(true) => {
        let next = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        ifaces.push(next)
      }
      Ok(false) => break
      Err(e) => return Err(e)
    }
  }
  Ok(ifaces)
}

fn Parser::parse_input_value_def(
  self : Parser,
) -> Result[InputValueDefinition, GraphqlError] {
  let desc = match self.parse_optional_description() {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_punct(TokenKind::Colon, "':'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let vtype = match self.parse_type_ref() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let mut def_val : Option[Value] = None
  match self.skip_punct(TokenKind::Equals) {
    Ok(true) => {
      let v = match self.parse_value_iter(true) {
        Ok(v_node) => v_node
        Err(e) => return Err(e)
      }
      def_val = Some(v)
    }
    Ok(false) => ()
    Err(e) => return Err(e)
  }
  let dirs = match self.parse_directives(true) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  match self.bump_node() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(
    InputValueDefinition::{
      description: desc,
      name: name,
      value_type: vtype,
      default_value: def_val,
      directives: dirs,
    },
  )
}

fn Parser::parse_arguments_def(
  self : Parser,
) -> Result[Array[InputValueDefinition], GraphqlError] {
  match self.cur.kind {
    TokenKind::LParen => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RParen =>
    return Err(self.err_unexpected("at least one argument definition"))
    _ => ()
  }
  let out : Array[InputValueDefinition] = []
  while true {
    let iv = match self.parse_input_value_def() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(iv)
    match self.cur.kind {
      TokenKind::RParen => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(out)
}

fn Parser::parse_fields_def(
  self : Parser,
) -> Result[Array[FieldDefinition], GraphqlError] {
  match self.cur.kind {
    TokenKind::LBrace => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RBrace =>
    return Err(self.err_unexpected("at least one field definition"))
    _ => ()
  }
  let out : Array[FieldDefinition] = []
  while true {
    let desc = match self.parse_optional_description() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let args = match self.parse_arguments_def() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match self.expect_punct(TokenKind::Colon, "':'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let ftype = match self.parse_type_ref() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    match self.bump_node() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    out.push(
      FieldDefinition::{
        description: desc,
        name: name,
        arguments: args,
        field_type: ftype,
        directives: dirs,
      },
    )
    match self.cur.kind {
      TokenKind::RBrace => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(out)
}

fn Parser::parse_union_members(
  self : Parser,
) -> Result[Array[String], GraphqlError] {
  match self.skip_punct(TokenKind::Equals) {
    Ok(false) => return Ok([])
    Ok(true) => ()
    Err(e) => return Err(e)
  }
  let _ = match self.skip_punct(TokenKind::Pipe) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let members : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  members.push(first)
  while true {
    match self.skip_punct(TokenKind::Pipe) {
      Ok(true) => {
        let next = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        members.push(next)
      }
      Ok(false) => break
      Err(e) => return Err(e)
    }
  }
  Ok(members)
}

fn Parser::parse_enum_values_def(
  self : Parser,
) -> Result[Array[EnumValueDefinition], GraphqlError] {
  match self.cur.kind {
    TokenKind::LBrace => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RBrace =>
    return Err(self.err_unexpected("at least one enum value definition"))
    _ => ()
  }
  let out : Array[EnumValueDefinition] = []
  while true {
    let desc = match self.parse_optional_description() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    if name == "true" || name == "false" || name == "null" {
      return Err(
        GraphqlError::new(
          ErrorKind::InvalidSyntax,
          self.cur.line,
          self.cur.col,
          self.cur.offset,
          "enum value name cannot be '" + name + "'",
        ),
      )
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    match self.bump_node() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    out.push(
      EnumValueDefinition::{ description: desc, name: name, directives: dirs },
    )
    match self.cur.kind {
      TokenKind::RBrace => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(out)
}

fn Parser::parse_input_fields_def(
  self : Parser,
) -> Result[Array[InputValueDefinition], GraphqlError] {
  match self.cur.kind {
    TokenKind::LBrace => ()
    _ => return Ok([])
  }
  match self.advance() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::RBrace =>
    return Err(self.err_unexpected("at least one input field definition"))
    _ => ()
  }
  let out : Array[InputValueDefinition] = []
  while true {
    let iv = match self.parse_input_value_def() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    out.push(iv)
    match self.cur.kind {
      TokenKind::RBrace => {
        match self.advance() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
  }
  Ok(out)
}

fn is_valid_directive_location(loc : String) -> Bool {
  loc == "QUERY" ||
  loc == "MUTATION" ||
  loc == "SUBSCRIPTION" ||
  loc == "FIELD" ||
  loc == "FRAGMENT_DEFINITION" ||
  loc == "FRAGMENT_SPREAD" ||
  loc == "INLINE_FRAGMENT" ||
  loc == "VARIABLE_DEFINITION" ||
  loc == "SCHEMA" ||
  loc == "SCALAR" ||
  loc == "OBJECT" ||
  loc == "FIELD_DEFINITION" ||
  loc == "ARGUMENT_DEFINITION" ||
  loc == "INTERFACE" ||
  loc == "UNION" ||
  loc == "ENUM" ||
  loc == "ENUM_VALUE" ||
  loc == "INPUT_OBJECT" ||
  loc == "INPUT_FIELD_DEFINITION"
}

fn Parser::parse_directive_definition(
  self : Parser,
  desc : Option[Description],
) -> Result[DirectiveDefinition, GraphqlError] {
  match self.expect_keyword("directive") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.expect_punct(TokenKind::At, "'@'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let args = match self.parse_arguments_def() {
    Ok(a) => a
    Err(e) => return Err(e)
  }
  let repeatable = match self.skip_keyword("repeatable") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match self.expect_keyword("on") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let _ = match self.skip_punct(TokenKind::Pipe) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let locs : Array[String] = []
  let first = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if !is_valid_directive_location(first) {
    return Err(
      GraphqlError::new(
        ErrorKind::InvalidSyntax,
        self.cur.line,
        self.cur.col,
        self.cur.offset,
        "invalid directive location: " + first,
      ),
    )
  }
  locs.push(first)
  while true {
    match self.skip_punct(TokenKind::Pipe) {
      Ok(true) => {
        let loc = match self.expect_name() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        if !is_valid_directive_location(loc) {
          return Err(
            GraphqlError::new(
              ErrorKind::InvalidSyntax,
              self.cur.line,
              self.cur.col,
              self.cur.offset,
              "invalid directive location: " + loc,
            ),
          )
        }
        locs.push(loc)
      }
      Ok(false) => break
      Err(e) => return Err(e)
    }
  }
  Ok(
    DirectiveDefinition::{
      description: desc,
      name: name,
      arguments: args,
      repeatable: repeatable,
      locations: locs,
    },
  )
}

fn Parser::parse_type_system_extension(
  self : Parser,
) -> Result[Definition, GraphqlError] {
  match self.expect_keyword("extend") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let kw = match self.expect_name() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if kw == "schema" {
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let ops = match self.cur.kind {
      TokenKind::LBrace =>
      match self.parse_operation_type_defs() {
        Ok(o) => o
        Err(e) => return Err(e)
      }
      _ => []
    }
    if dirs.length() == 0 && ops.length() == 0 {
      return Err(
        self.err_unexpected("directives or operation types in extend schema"),
      )
    }
    return Ok(
      Definition::SchemaExtension(
        SchemaExtension::{ directives: dirs, operation_types: ops },
      ),
    )
  }
  if kw == "scalar" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 {
      return Err(self.err_unexpected("directives in extend scalar"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Scalar(
          ScalarTypeExtension::{ name: name, directives: dirs },
        ),
      ),
    )
  }
  if kw == "type" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if ifaces.length() == 0 && dirs.length() == 0 && fields.length() == 0 {
      return Err(self.err_unexpected("implements, directives, or fields in extend type"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Object(
          ObjectTypeExtension::{
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if kw == "interface" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if ifaces.length() == 0 && dirs.length() == 0 && fields.length() == 0 {
      return Err(
        self.err_unexpected("implements, directives, or fields in extend interface"),
      )
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Interface(
          InterfaceTypeExtension::{
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if kw == "union" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let members = match self.parse_union_members() {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && members.length() == 0 {
      return Err(self.err_unexpected("directives or members in extend union"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Union(
          UnionTypeExtension::{ name: name, directives: dirs, members: members },
        ),
      ),
    )
  }
  if kw == "enum" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let vals = match self.parse_enum_values_def() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && vals.length() == 0 {
      return Err(self.err_unexpected("directives or values in extend enum"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::Enum(
          EnumTypeExtension::{ name: name, directives: dirs, values: vals },
        ),
      ),
    )
  }
  if kw == "input" {
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_input_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    if dirs.length() == 0 && fields.length() == 0 {
      return Err(self.err_unexpected("directives or fields in extend input"))
    }
    return Ok(
      Definition::TypeExtension(
        TypeExtension::InputObject(
          InputObjectTypeExtension::{
            name: name,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  Err(self.err_unexpected("schema, scalar, type, interface, union, enum, or input after extend"))
}

fn Parser::parse_definition(self : Parser) -> Result[Definition, GraphqlError] {
  match self.bump_node() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.cur.kind {
    TokenKind::LBrace => {
      let op = match self.parse_operation_definition() {
        Ok(o) => o
        Err(e) => return Err(e)
      }
      return Ok(Definition::Operation(op))
    }
    _ => ()
  }
  let desc = match self.parse_optional_description() {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let has_desc = match desc {
    Some(_) => true
    None => false
  }
  let kw = match self.cur.kind {
    TokenKind::Name(s) => s
    _ => return Err(self.err_unexpected("definition keyword"))
  }
  if kw == "query" || kw == "mutation" || kw == "subscription" {
    if has_desc {
      return Err(self.err_unexpected("no description on executable operation"))
    }
    let op = match self.parse_operation_definition() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(Definition::Operation(op))
  }
  if kw == "fragment" {
    if has_desc {
      return Err(self.err_unexpected("no description on fragment definition"))
    }
    let frag = match self.parse_fragment_definition() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(Definition::Fragment(frag))
  }
  if kw == "extend" {
    if has_desc {
      return Err(self.err_unexpected("no description on type system extension"))
    }
    return self.parse_type_system_extension()
  }
  if kw == "schema" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let ops = match self.parse_operation_type_defs() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::Schema(
        SchemaDefinition::{
          description: desc,
          directives: dirs,
          operation_types: ops,
        },
      ),
    )
  }
  if kw == "scalar" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Scalar(
          ScalarTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
          },
        ),
      ),
    )
  }
  if kw == "type" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Object(
          ObjectTypeDefinition::{
            description: desc,
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if kw == "interface" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ifaces = match self.parse_implements_interfaces() {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Interface(
          InterfaceTypeDefinition::{
            description: desc,
            name: name,
            implements_interfaces: ifaces,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if kw == "union" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let members = match self.parse_union_members() {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Union(
          UnionTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            members: members,
          },
        ),
      ),
    )
  }
  if kw == "enum" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let vals = match self.parse_enum_values_def() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::Enum(
          EnumTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            values: vals,
          },
        ),
      ),
    )
  }
  if kw == "input" {
    match self.advance() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let name = match self.expect_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let dirs = match self.parse_directives(true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let fields = match self.parse_input_fields_def() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    return Ok(
      Definition::TypeDef(
        TypeDefinition::InputObject(
          InputObjectTypeDefinition::{
            description: desc,
            name: name,
            directives: dirs,
            fields: fields,
          },
        ),
      ),
    )
  }
  if kw == "directive" {
    let dd = match self.parse_directive_definition(desc) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    return Ok(Definition::DirectiveDef(dd))
  }
  Err(self.err_unexpected("definition"))
}

fn parse_impl(
  src : String,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  let p = match Parser::new(src, opts) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  match p.cur.kind {
    TokenKind::Eof =>
    return Err(
      GraphqlError::new(
        ErrorKind::UnexpectedEof,
        p.cur.line,
        p.cur.col,
        p.cur.offset,
        "empty GraphQL document",
      ),
    )
    _ => ()
  }
  let defs : Array[Definition] = []
  while true {
    match p.cur.kind {
      TokenKind::Eof => break
      _ => {
        let def = match p.parse_definition() {
          Ok(d) => d
          Err(e) => return Err(e)
        }
        defs.push(def)
      }
    }
  }
  Ok(Document::{ definitions: defs })
}

fn parse_bytes_impl(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Document, GraphqlError] {
  match validate_utf8_bytes(src) {
    Ok(s) => parse_impl(s, opts)
    Err(e) => Err(e)
  }
}

fn parse_value_impl(src : String) -> Result[Value, GraphqlError] {
  let p = match Parser::new(src, ParseOptions::default()) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let v_node = match p.parse_value_iter(false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match p.cur.kind {
    TokenKind::Eof => Ok(v_node)
    _ => Err(p.err_unexpected("EOF"))
  }
}

fn parse_type_impl(src : String) -> Result[TypeRef, GraphqlError] {
  let p = match Parser::new(src, ParseOptions::default()) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let ty = match p.parse_type_ref() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match p.cur.kind {
    TokenKind::Eof => Ok(ty)
    _ => Err(p.err_unexpected("EOF"))
  }
}
