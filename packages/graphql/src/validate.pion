///| 100% iterative O(N) core static validation engine for executable GraphQL documents.

fn check_unique_input_fields_iter(
  v_node : Value,
  used_vars_map : Map[String, Bool],
  used_vars_list : Array[String],
  collect_vars : Bool,
  errs : Array[ValidationError],
) -> Unit {
  let stack : Array[Value] = [v_node]
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    match cur {
      Value::Variable(vname) =>
      if collect_vars {
        match used_vars_map.get(vname) {
          Some(_) => ()
          None => {
            used_vars_map.set(vname, true)
            used_vars_list.push(vname)
          }
        }
      }
      Value::ListValue(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push(items[i])
          i = i - 1
        }
      }
      Value::ObjectValue(fields) => {
        let seen : Map[String, Bool] = Map::new()
        let mut i = 0
        while i < fields.length() {
          let f = fields[i]
          match seen.get(f.name) {
            Some(_) =>
            errs.push(
              ValidationError::new(
                ValidationErrorKind::DuplicateInputFieldName,
                "duplicate input object field '" + f.name + "'",
              ),
            )
            None => seen.set(f.name, true)
          }
          stack.push(f.value)
          i = i + 1
        }
      }
      _ => ()
    }
  }
}

fn check_unique_arguments(
  args : Array[Argument],
  used_vars_map : Map[String, Bool],
  used_vars_list : Array[String],
  collect_vars : Bool,
  errs : Array[ValidationError],
) -> Unit {
  if args.length() == 0 {
    return
  }
  let seen : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < args.length() {
    let a = args[i]
    match seen.get(a.name) {
      Some(_) =>
      errs.push(
        ValidationError::new(
          ValidationErrorKind::DuplicateArgumentName,
          "duplicate argument '" + a.name + "'",
        ),
      )
      None => seen.set(a.name, true)
    }
    check_unique_input_fields_iter(
      a.value,
      used_vars_map,
      used_vars_list,
      collect_vars,
      errs,
    )
    i = i + 1
  }
}

fn check_directives_with_seen(
  dirs : Array[Directive],
  unique_dir_map : Map[String, Bool],
  seen : Map[String, Bool],
  used_vars_map : Map[String, Bool],
  used_vars_list : Array[String],
  collect_vars : Bool,
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < dirs.length() {
    let d = dirs[i]
    match unique_dir_map.get(d.name) {
      Some(true) =>
      match seen.get(d.name) {
        Some(_) =>
        errs.push(
          ValidationError::new(
            ValidationErrorKind::UniqueDirectivesPerLocation,
            "the directive '@" + d.name + "' can only be used once at this location",
          ),
        )
        None => seen.set(d.name, true)
      }
      _ => ()
    }
    check_unique_arguments(
      d.arguments,
      used_vars_map,
      used_vars_list,
      collect_vars,
      errs,
    )
    i = i + 1
  }
}

fn check_directives(
  dirs : Array[Directive],
  unique_dir_map : Map[String, Bool],
  used_vars_map : Map[String, Bool],
  used_vars_list : Array[String],
  collect_vars : Bool,
  errs : Array[ValidationError],
) -> Unit {
  if dirs.length() == 0 {
    return
  }
  let seen : Map[String, Bool] = Map::new()
  check_directives_with_seen(
    dirs,
    unique_dir_map,
    seen,
    used_vars_map,
    used_vars_list,
    collect_vars,
    errs,
  )
}

fn check_sdl_input_values(
  ivs : Array[InputValueDefinition],
  unique_dir_map : Map[String, Bool],
  dummy_map : Map[String, Bool],
  dummy_list : Array[String],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < ivs.length() {
    let iv = ivs[i]
    match iv.default_value {
      Some(dv) =>
      check_unique_input_fields_iter(dv, dummy_map, dummy_list, false, errs)
      None => ()
    }
    check_directives(iv.directives, unique_dir_map, dummy_map, dummy_list, false, errs)
    i = i + 1
  }
}

fn check_sdl_fields(
  fields : Array[FieldDefinition],
  unique_dir_map : Map[String, Bool],
  dummy_map : Map[String, Bool],
  dummy_list : Array[String],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < fields.length() {
    let f = fields[i]
    check_sdl_input_values(f.arguments, unique_dir_map, dummy_map, dummy_list, errs)
    check_directives(f.directives, unique_dir_map, dummy_map, dummy_list, false, errs)
    i = i + 1
  }
}

fn check_sdl_enum_values(
  vals : Array[EnumValueDefinition],
  unique_dir_map : Map[String, Bool],
  dummy_map : Map[String, Bool],
  dummy_list : Array[String],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < vals.length() {
    check_directives(
      vals[i].directives,
      unique_dir_map,
      dummy_map,
      dummy_list,
      false,
      errs,
    )
    i = i + 1
  }
}

fn get_or_create_type_dir_seen(
  type_seen : Map[String, Map[String, Bool]],
  name : String,
) -> Map[String, Bool] {
  match type_seen.get(name) {
    Some(m) => m
    None => {
      let m : Map[String, Bool] = Map::new()
      type_seen.set(name, m)
      m
    }
  }
}

struct SpreadRef {
  frag_idx : Int
  depth : Int
}

struct SelStats {
  max_depth : Int
  aliases : Int
  fields : Int
  spreads : Array[SpreadRef]
}

///| Iteratively walk a SelectionSet: check args/directives/input fields/known fragments,
///| collect used variables, and collect depth/alias/field/spread stats.
fn walk_selection_set(
  ss : SelectionSet,
  frag_map : Map[String, Int],
  unique_dir_map : Map[String, Bool],
  used_vars_map : Map[String, Bool],
  used_vars_list : Array[String],
  collect_vars : Bool,
  errs : Array[ValidationError],
) -> SelStats {
  let mut max_depth = 0
  let mut aliases = 0
  let mut fields = 0
  let spreads : Array[SpreadRef] = []

  // Explicit stack of (SelectionSet, current_depth)
  let stack_ss : Array[SelectionSet] = [ss]
  let stack_depth : Array[Int] = [0]

  while stack_ss.length() > 0 {
    let idx = stack_ss.length() - 1
    let cur_ss = stack_ss[idx]
    let cur_depth = stack_depth[idx]
    let _ = stack_ss.pop()
    let _ = stack_depth.pop()

    let mut i = 0
    while i < cur_ss.selections.length() {
      match cur_ss.selections[i] {
        Selection::Field(f) => {
          let f_depth = cur_depth + 1
          if f_depth > max_depth {
            max_depth = f_depth
          }
          fields = fields + 1
          match f.alias {
            Some(_) => aliases = aliases + 1
            None => ()
          }
          check_unique_arguments(
            f.arguments,
            used_vars_map,
            used_vars_list,
            collect_vars,
            errs,
          )
          check_directives(
            f.directives,
            unique_dir_map,
            used_vars_map,
            used_vars_list,
            collect_vars,
            errs,
          )
          match f.selection_set {
            Some(sub) => {
              stack_ss.push(sub)
              stack_depth.push(f_depth)
            }
            None => ()
          }
        }
        Selection::FragmentSpread(fs) => {
          check_directives(
            fs.directives,
            unique_dir_map,
            used_vars_map,
            used_vars_list,
            collect_vars,
            errs,
          )
          match frag_map.get(fs.name) {
            Some(fidx) =>
            spreads.push(SpreadRef::{ frag_idx: fidx, depth: cur_depth })
            None =>
            errs.push(
              ValidationError::new(
                ValidationErrorKind::UndefinedFragment,
                "unknown fragment '" + fs.name + "'",
              ),
            )
          }
        }
        Selection::InlineFragment(inf) => {
          check_directives(
            inf.directives,
            unique_dir_map,
            used_vars_map,
            used_vars_list,
            collect_vars,
            errs,
          )
          stack_ss.push(inf.selection_set)
          stack_depth.push(cur_depth)
        }
      }
      i = i + 1
    }
  }
  SelStats::{
    max_depth: max_depth,
    aliases: aliases,
    fields: fields,
    spreads: spreads,
  }
}

fn validate_executable_impl(
  doc : Document,
  opts : ValidationOptions,
) -> Array[ValidationError] {
  let errs : Array[ValidationError] = []
  let ops : Array[OperationDefinition] = []
  let op_declared_vars : Array[Map[String, Bool]] = []
  let op_direct_vars_map : Array[Map[String, Bool]] = []
  let op_direct_vars_list : Array[Array[String]] = []
  let frags : Array[FragmentDefinition] = []
  let dup_frags : Array[FragmentDefinition] = []
  let op_names : Map[String, Bool] = Map::new()
  let frag_map : Map[String, Int] = Map::new()
  let mut anon_ops = 0

  // Built-in non-repeatable directives (matching graphql-js specifiedDirectives)
  let unique_dir_map : Map[String, Bool] = Map::new()
  unique_dir_map.set("include", true)
  unique_dir_map.set("skip", true)
  unique_dir_map.set("deprecated", true)
  unique_dir_map.set("specifiedBy", true)
  unique_dir_map.set("oneOf", true)

  // Pre-scan any DirectiveDefinitions in the document
  let mut i = 0
  while i < doc.definitions.length() {
    match doc.definitions[i] {
      Definition::DirectiveDef(dd) => unique_dir_map.set(dd.name, !dd.repeatable)
      _ => ()
    }
    i = i + 1
  }

  let dummy_map : Map[String, Bool] = Map::new()
  let dummy_list : Array[String] = []
  let schema_dir_seen : Map[String, Bool] = Map::new()
  let type_dir_seen : Map[String, Map[String, Bool]] = Map::new()

  // Pass 1: Collect operations & fragments, reject non-executable SDL definitions,
  // check unique names, lone anonymous op, variable definitions, and directives.
  i = 0
  while i < doc.definitions.length() {
    match doc.definitions[i] {
      Definition::Operation(op) => {
        ops.push(op)
        match op.name {
          Some(n) =>
          match op_names.get(n) {
            Some(_) =>
            errs.push(
              ValidationError::new(
                ValidationErrorKind::DuplicateOperationName,
                "duplicate operation name '" + n + "'",
              ),
            )
            None => op_names.set(n, true)
          }
          None => anon_ops = anon_ops + 1
        }
        let var_names : Map[String, Bool] = Map::new()
        let mut v = 0
        while v < op.variable_definitions.length() {
          let vd = op.variable_definitions[v]
          match var_names.get(vd.name) {
            Some(_) =>
            errs.push(
              ValidationError::new(
                ValidationErrorKind::DuplicateVariableName,
                "duplicate variable '$" + vd.name + "'",
              ),
            )
            None => var_names.set(vd.name, true)
          }
          match vd.default_value {
            Some(dv) =>
            check_unique_input_fields_iter(dv, dummy_map, dummy_list, false, errs)
            None => ()
          }
          check_directives(
            vd.directives,
            unique_dir_map,
            dummy_map,
            dummy_list,
            false,
            errs,
          )
          v = v + 1
        }
        op_declared_vars.push(var_names)
        let dmap : Map[String, Bool] = Map::new()
        let dlist : Array[String] = []
        check_directives(op.directives, unique_dir_map, dmap, dlist, true, errs)
        op_direct_vars_map.push(dmap)
        op_direct_vars_list.push(dlist)
      }
      Definition::Fragment(frag) =>
      match frag_map.get(frag.name) {
        Some(_) => {
          errs.push(
            ValidationError::new(
              ValidationErrorKind::DuplicateFragmentName,
              "duplicate fragment name '" + frag.name + "'",
            ),
          )
          dup_frags.push(frag)
        }
        None => {
          frag_map.set(frag.name, frags.length())
          frags.push(frag)
        }
      }
      Definition::Schema(s) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "schema definition is not executable",
          ),
        )
        check_directives_with_seen(
          s.directives,
          unique_dir_map,
          schema_dir_seen,
          dummy_map,
          dummy_list,
          false,
          errs,
        )
      }
      Definition::SchemaExtension(s) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "schema extension is not executable",
          ),
        )
        check_directives_with_seen(
          s.directives,
          unique_dir_map,
          schema_dir_seen,
          dummy_map,
          dummy_list,
          false,
          errs,
        )
      }
      Definition::DirectiveDef(dd) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "directive definition '@" + dd.name + "' is not executable",
          ),
        )
        check_sdl_input_values(
          dd.arguments,
          unique_dir_map,
          dummy_map,
          dummy_list,
          errs,
        )
      }
      Definition::TypeDef(td) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "type system definition is not executable",
          ),
        )
        match td {
          TypeDefinition::Scalar(x) =>
          check_directives_with_seen(
            x.directives,
            unique_dir_map,
            get_or_create_type_dir_seen(type_dir_seen, x.name),
            dummy_map,
            dummy_list,
            false,
            errs,
          )
          TypeDefinition::Object(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_fields(x.fields, unique_dir_map, dummy_map, dummy_list, errs)
          }
          TypeDefinition::Interface(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_fields(x.fields, unique_dir_map, dummy_map, dummy_list, errs)
          }
          TypeDefinition::Union(x) =>
          check_directives_with_seen(
            x.directives,
            unique_dir_map,
            get_or_create_type_dir_seen(type_dir_seen, x.name),
            dummy_map,
            dummy_list,
            false,
            errs,
          )
          TypeDefinition::Enum(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_enum_values(
              x.values,
              unique_dir_map,
              dummy_map,
              dummy_list,
              errs,
            )
          }
          TypeDefinition::InputObject(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_input_values(
              x.fields,
              unique_dir_map,
              dummy_map,
              dummy_list,
              errs,
            )
          }
        }
      }
      Definition::TypeExtension(te) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "type system extension is not executable",
          ),
        )
        match te {
          TypeExtension::Scalar(x) =>
          check_directives_with_seen(
            x.directives,
            unique_dir_map,
            get_or_create_type_dir_seen(type_dir_seen, x.name),
            dummy_map,
            dummy_list,
            false,
            errs,
          )
          TypeExtension::Object(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_fields(x.fields, unique_dir_map, dummy_map, dummy_list, errs)
          }
          TypeExtension::Interface(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_fields(x.fields, unique_dir_map, dummy_map, dummy_list, errs)
          }
          TypeExtension::Union(x) =>
          check_directives_with_seen(
            x.directives,
            unique_dir_map,
            get_or_create_type_dir_seen(type_dir_seen, x.name),
            dummy_map,
            dummy_list,
            false,
            errs,
          )
          TypeExtension::Enum(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_enum_values(
              x.values,
              unique_dir_map,
              dummy_map,
              dummy_list,
              errs,
            )
          }
          TypeExtension::InputObject(x) => {
            check_directives_with_seen(
              x.directives,
              unique_dir_map,
              get_or_create_type_dir_seen(type_dir_seen, x.name),
              dummy_map,
              dummy_list,
              false,
              errs,
            )
            check_sdl_input_values(
              x.fields,
              unique_dir_map,
              dummy_map,
              dummy_list,
              errs,
            )
          }
        }
      }
    }
    i = i + 1
  }

  if anon_ops > 0 && ops.length() > 1 {
    errs.push(
      ValidationError::new(
        ValidationErrorKind::LoneAnonymousOperation,
        "anonymous operation must be the only defined operation",
      ),
    )
  }

  // Pass 2: Walk all fragments (including duplicate fragment bodies) and operations
  let num_frags = frags.length()
  let frag_stats : Array[SelStats] = []
  let frag_used_vars : Array[Array[String]] = []
  i = 0
  while i < num_frags {
    let fmap : Map[String, Bool] = Map::new()
    let flist : Array[String] = []
    check_directives(frags[i].directives, unique_dir_map, fmap, flist, true, errs)
    frag_stats.push(
      walk_selection_set(
        frags[i].selection_set,
        frag_map,
        unique_dir_map,
        fmap,
        flist,
        true,
        errs,
      ),
    )
    frag_used_vars.push(flist)
    i = i + 1
  }

  // Walk duplicate fragment bodies too (P2-4: unknown spreads, args, directives, input fields)
  i = 0
  while i < dup_frags.length() {
    check_directives(
      dup_frags[i].directives,
      unique_dir_map,
      dummy_map,
      dummy_list,
      false,
      errs,
    )
    let _ = walk_selection_set(
      dup_frags[i].selection_set,
      frag_map,
      unique_dir_map,
      dummy_map,
      dummy_list,
      false,
      errs,
    )
    i = i + 1
  }

  let op_stats : Array[SelStats] = []
  i = 0
  while i < ops.length() {
    op_stats.push(
      walk_selection_set(
        ops[i].selection_set,
        frag_map,
        unique_dir_map,
        op_direct_vars_map[i],
        op_direct_vars_list[i],
        true,
        errs,
      ),
    )
    i = i + 1
  }

  // Pass 3: Iterative 3-color DFS on fragment dependency graph for cycle detection + post-order topological sort
  // color: 0 = unvisited, 1 = visiting (on stack), 2 = done
  let color : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let in_cycle : FixedArray[Bool] = FixedArray::make(num_frags, false)
  let topo_order : Array[Int] = []
  let dfs_node : Array[Int] = []
  let dfs_edge : Array[Int] = []
  let mut reported_cycle = false

  i = 0
  while i < num_frags {
    if color[i] == 0 {
      color[i] = 1
      dfs_node.push(i)
      dfs_edge.push(0)
      while dfs_node.length() > 0 {
        let top = dfs_node.length() - 1
        let u = dfs_node[top]
        let eidx = dfs_edge[top]
        let sp = frag_stats[u].spreads
        if eidx < sp.length() {
          dfs_edge[top] = eidx + 1
          let v = sp[eidx].frag_idx
          if color[v] == 1 {
            in_cycle[u] = true
            in_cycle[v] = true
            if !reported_cycle {
              errs.push(
                ValidationError::new(
                  ValidationErrorKind::FragmentCycle,
                  "cannot spread fragment '" +
                  frags[v].name +
                  "' within itself via '" +
                  frags[u].name +
                  "'",
                ),
              )
              reported_cycle = true
            }
          } else if color[v] == 0 {
            color[v] = 1
            dfs_node.push(v)
            dfs_edge.push(0)
          }
        } else {
          color[u] = 2
          topo_order.push(u)
          let _ = dfs_node.pop()
          let _ = dfs_edge.pop()
        }
      }
    }
    i = i + 1
  }

  // Pass 4: Bottom-up DP over topo_order (O(V + E)) for effective depth/aliases/fields
  let eff_depth : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let eff_aliases : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let eff_fields : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let cap = 1000000000

  i = 0
  while i < topo_order.length() {
    let u = topo_order[i]
    let st = frag_stats[u]
    let mut d = st.max_depth
    let mut al = st.aliases
    let mut fl = st.fields
    let mut e = 0
    while e < st.spreads.length() {
      let sr = st.spreads[e]
      let v = sr.frag_idx
      if !in_cycle[v] {
        let sub_d = sr.depth + eff_depth[v]
        if sub_d > d {
          d = sub_d
        }
        al = al + eff_aliases[v]
        if al > cap {
          al = cap
        }
        fl = fl + eff_fields[v]
        if fl > cap {
          fl = cap
        }
      }
      e = e + 1
    }
    eff_depth[u] = d
    eff_aliases[u] = al
    eff_fields[u] = fl
    i = i + 1
  }

  // Pass 5: Per-operation limits + transitive fragment reachability for NoUndefinedVariables,
  // NoUnusedVariables, and NoUnusedFragments.
  let frag_used : FixedArray[Bool] = FixedArray::make(num_frags, false)
  let visited_stamp : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let work : Array[Int] = []
  let mut depth_err = false
  let mut alias_err = false
  let mut field_err = false

  i = 0
  while i < op_stats.length() {
    let st = op_stats[i]
    let mut d = st.max_depth
    let mut al = st.aliases
    let mut fl = st.fields
    let stamp = i + 1
    let mut e = 0
    while e < st.spreads.length() {
      let sr = st.spreads[e]
      let v = sr.frag_idx
      if visited_stamp[v] != stamp {
        visited_stamp[v] = stamp
        work.push(v)
      }
      if !in_cycle[v] {
        let sub_d = sr.depth + eff_depth[v]
        if sub_d > d {
          d = sub_d
        }
        al = al + eff_aliases[v]
        if al > cap {
          al = cap
        }
        fl = fl + eff_fields[v]
        if fl > cap {
          fl = cap
        }
      }
      e = e + 1
    }

    // Collect all variables used directly or via transitively reachable fragments
    let all_used_map = op_direct_vars_map[i]
    let all_used_list = op_direct_vars_list[i]
    while work.length() > 0 {
      let fidx = work[work.length() - 1]
      let _ = work.pop()
      frag_used[fidx] = true
      let fvars = frag_used_vars[fidx]
      let mut vi = 0
      while vi < fvars.length() {
        let vn = fvars[vi]
        match all_used_map.get(vn) {
          Some(_) => ()
          None => {
            all_used_map.set(vn, true)
            all_used_list.push(vn)
          }
        }
        vi = vi + 1
      }
      let fsp = frag_stats[fidx].spreads
      let mut si = 0
      while si < fsp.length() {
        let next_f = fsp[si].frag_idx
        if visited_stamp[next_f] != stamp {
          visited_stamp[next_f] = stamp
          work.push(next_f)
        }
        si = si + 1
      }
    }

    // NoUndefinedVariables
    let declared = op_declared_vars[i]
    let mut ui = 0
    while ui < all_used_list.length() {
      let vn = all_used_list[ui]
      match declared.get(vn) {
        Some(_) => ()
        None =>
        errs.push(
          ValidationError::new(
            ValidationErrorKind::NoUndefinedVariables,
            "variable '$" + vn + "' is not defined",
          ),
        )
      }
      ui = ui + 1
    }

    // NoUnusedVariables
    let vdefs = ops[i].variable_definitions
    let mut di = 0
    while di < vdefs.length() {
      let vn = vdefs[di].name
      match all_used_map.get(vn) {
        Some(_) => ()
        None =>
        errs.push(
          ValidationError::new(
            ValidationErrorKind::NoUnusedVariables,
            "variable '$" + vn + "' is never used",
          ),
        )
      }
      di = di + 1
    }

    if !depth_err && d > opts.max_depth {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxDepthExceeded,
          "query depth " +
          d.to_string() +
          " exceeds max_depth " +
          opts.max_depth.to_string(),
        ),
      )
      depth_err = true
    }
    if !alias_err && al > opts.max_aliases {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxAliasesExceeded,
          "alias count " +
          al.to_string() +
          " exceeds max_aliases " +
          opts.max_aliases.to_string(),
        ),
      )
      alias_err = true
    }
    if !field_err && fl > opts.max_fields {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxFieldsExceeded,
          "field count " +
          fl.to_string() +
          " exceeds max_fields " +
          opts.max_fields.to_string(),
        ),
      )
      field_err = true
    }
    i = i + 1
  }

  // NoUnusedFragments
  i = 0
  while i < num_frags {
    if !frag_used[i] {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::NoUnusedFragments,
          "fragment '" + frags[i].name + "' is never used",
        ),
      )
    }
    i = i + 1
  }

  errs
}
