///| 100% iterative O(N) core static validation engine for executable GraphQL documents.
///| Uses zero-Map small-set fast paths (<= 8 elements) with automatic O(N) Map promotion,
///| zero-stack scalar value fast paths, and reusable traversal stacks.

struct StrSet {
  list : Array[String]
  mut map_opt : Option[Map[String, Bool]]
}

fn StrSet::new() -> StrSet {
  StrSet::{ list: [], map_opt: None }
}

fn StrSet::contains(self : StrSet, s : String) -> Bool {
  match self.map_opt {
    Some(m) =>
    match m.get(s) {
      Some(_) => true
      None => false
    }
    None => {
      let arr = self.list
      let n = arr.length()
      let mut i = 0
      while i < n {
        if arr[i] == s {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///| Insert `s` into the set; returns `true` if newly inserted, `false` if already present.
fn StrSet::insert(self : StrSet, s : String) -> Bool {
  match self.map_opt {
    Some(m) =>
    match m.get(s) {
      Some(_) => false
      None => {
        m.set(s, true)
        self.list.push(s)
        true
      }
    }
    None => {
      let arr = self.list
      let n = arr.length()
      let mut i = 0
      while i < n {
        if arr[i] == s {
          return false
        }
        i = i + 1
      }
      arr.push(s)
      if n >= 8 {
        let m : Map[String, Bool] = Map::new()
        let mut k = 0
        while k <= n {
          m.set(arr[k], true)
          k = k + 1
        }
        self.map_opt = Some(m)
      }
      true
    }
  }
}

fn is_builtin_unique_dir(name : String) -> Bool {
  name == "include" ||
  name == "skip" ||
  name == "deprecated" ||
  name == "specifiedBy" ||
  name == "oneOf"
}

fn is_unique_dir(name : String, custom_dir_map : Option[Map[String, Bool]]) -> Bool {
  match custom_dir_map {
    Some(m) =>
    match m.get(name) {
      Some(b) => b
      None => is_builtin_unique_dir(name)
    }
    None => is_builtin_unique_dir(name)
  }
}

fn check_unique_input_fields_iter(
  v_node : Value,
  used_vars : StrSet,
  collect_vars : Bool,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  // Fast path: scalar values need zero stack operations
  match v_node {
    Value::Variable(vname) => {
      if collect_vars {
        let _ = used_vars.insert(vname)
      }
      return
    }
    Value::ListValue(_) | Value::ObjectValue(_) => ()
    _ => return
  }

  val_stack.clear()
  val_stack.push(v_node)
  while val_stack.length() > 0 {
    let cur = val_stack[val_stack.length() - 1]
    let _ = val_stack.pop()
    match cur {
      Value::Variable(vname) =>
      if collect_vars {
        let _ = used_vars.insert(vname)
      }
      Value::ListValue(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          match items[i] {
            Value::Variable(vname) =>
            if collect_vars {
              let _ = used_vars.insert(vname)
            }
            Value::ListValue(_) | Value::ObjectValue(_) => val_stack.push(items[i])
            _ => ()
          }
          i = i - 1
        }
      }
      Value::ObjectValue(fields) => {
        let n = fields.length()
        if n == 0 {
          ()
        } else if n == 1 {
          match fields[0].value {
            Value::Variable(vname) =>
            if collect_vars {
              let _ = used_vars.insert(vname)
            }
            Value::ListValue(_) | Value::ObjectValue(_) => val_stack.push(fields[0].value)
            _ => ()
          }
        } else if n <= 8 {
          let mut i = 0
          while i < n {
            let f = fields[i]
            let mut j = 0
            while j < i {
              if fields[j].name == f.name {
                errs.push(
                  ValidationError::new(
                    ValidationErrorKind::DuplicateInputFieldName,
                    "duplicate input object field '" + f.name + "'",
                  ),
                )
                break
              }
              j = j + 1
            }
            match f.value {
              Value::Variable(vname) =>
              if collect_vars {
                let _ = used_vars.insert(vname)
              }
              Value::ListValue(_) | Value::ObjectValue(_) => val_stack.push(f.value)
              _ => ()
            }
            i = i + 1
          }
        } else {
          let seen : Map[String, Bool] = Map::new()
          let mut i = 0
          while i < n {
            let f = fields[i]
            match seen.get(f.name) {
              Some(_) =>
              errs.push(
                ValidationError::new(
                  ValidationErrorKind::DuplicateInputFieldName,
                  "duplicate input object field '" + f.name + "'",
                ),
              )
              None => seen.set(f.name, true)
            }
            match f.value {
              Value::Variable(vname) =>
              if collect_vars {
                let _ = used_vars.insert(vname)
              }
              Value::ListValue(_) | Value::ObjectValue(_) => val_stack.push(f.value)
              _ => ()
            }
            i = i + 1
          }
        }
      }
      _ => ()
    }
  }
}

fn check_unique_arguments(
  args : Array[Argument],
  used_vars : StrSet,
  collect_vars : Bool,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let n = args.length()
  if n == 0 {
    return
  }
  if n == 1 {
    check_unique_input_fields_iter(
      args[0].value,
      used_vars,
      collect_vars,
      val_stack,
      errs,
    )
    return
  }
  if n <= 8 {
    let mut i = 0
    while i < n {
      let a = args[i]
      let mut j = 0
      while j < i {
        if args[j].name == a.name {
          errs.push(
            ValidationError::new(
              ValidationErrorKind::DuplicateArgumentName,
              "duplicate argument '" + a.name + "'",
            ),
          )
          break
        }
        j = j + 1
      }
      check_unique_input_fields_iter(
        a.value,
        used_vars,
        collect_vars,
        val_stack,
        errs,
      )
      i = i + 1
    }
    return
  }
  let seen : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < n {
    let a = args[i]
    match seen.get(a.name) {
      Some(_) =>
      errs.push(
        ValidationError::new(
          ValidationErrorKind::DuplicateArgumentName,
          "duplicate argument '" + a.name + "'",
        ),
      )
      None => seen.set(a.name, true)
    }
    check_unique_input_fields_iter(
      a.value,
      used_vars,
      collect_vars,
      val_stack,
      errs,
    )
    i = i + 1
  }
}

fn check_directives_with_seen(
  dirs : Array[Directive],
  custom_dir_map : Option[Map[String, Bool]],
  seen : Map[String, Bool],
  used_vars : StrSet,
  collect_vars : Bool,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < dirs.length() {
    let d = dirs[i]
    if is_unique_dir(d.name, custom_dir_map) {
      match seen.get(d.name) {
        Some(_) =>
        errs.push(
          ValidationError::new(
            ValidationErrorKind::UniqueDirectivesPerLocation,
            "the directive '@" + d.name + "' can only be used once at this location",
          ),
        )
        None => seen.set(d.name, true)
      }
    }
    check_unique_arguments(
      d.arguments,
      used_vars,
      collect_vars,
      val_stack,
      errs,
    )
    i = i + 1
  }
}

fn check_directives(
  dirs : Array[Directive],
  custom_dir_map : Option[Map[String, Bool]],
  used_vars : StrSet,
  collect_vars : Bool,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let n = dirs.length()
  if n == 0 {
    return
  }
  if n == 1 {
    check_unique_arguments(
      dirs[0].arguments,
      used_vars,
      collect_vars,
      val_stack,
      errs,
    )
    return
  }
  if n <= 8 {
    let mut i = 0
    while i < n {
      let d = dirs[i]
      if is_unique_dir(d.name, custom_dir_map) {
        let mut j = 0
        while j < i {
          if dirs[j].name == d.name {
            errs.push(
              ValidationError::new(
                ValidationErrorKind::UniqueDirectivesPerLocation,
                "the directive '@" + d.name + "' can only be used once at this location",
              ),
            )
            break
          }
          j = j + 1
        }
      }
      check_unique_arguments(
        d.arguments,
        used_vars,
        collect_vars,
        val_stack,
        errs,
      )
      i = i + 1
    }
    return
  }
  let seen : Map[String, Bool] = Map::new()
  check_directives_with_seen(
    dirs,
    custom_dir_map,
    seen,
    used_vars,
    collect_vars,
    val_stack,
    errs,
  )
}

fn check_sdl_input_values(
  ivs : Array[InputValueDefinition],
  custom_dir_map : Option[Map[String, Bool]],
  dummy_vars : StrSet,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < ivs.length() {
    let iv = ivs[i]
    match iv.default_value {
      Some(dv) =>
      check_unique_input_fields_iter(dv, dummy_vars, false, val_stack, errs)
      None => ()
    }
    check_directives(iv.directives, custom_dir_map, dummy_vars, false, val_stack, errs)
    i = i + 1
  }
}

fn check_sdl_fields(
  fields : Array[FieldDefinition],
  custom_dir_map : Option[Map[String, Bool]],
  dummy_vars : StrSet,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < fields.length() {
    let f = fields[i]
    check_sdl_input_values(f.arguments, custom_dir_map, dummy_vars, val_stack, errs)
    check_directives(f.directives, custom_dir_map, dummy_vars, false, val_stack, errs)
    i = i + 1
  }
}

fn check_sdl_enum_values(
  vals : Array[EnumValueDefinition],
  custom_dir_map : Option[Map[String, Bool]],
  dummy_vars : StrSet,
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> Unit {
  let mut i = 0
  while i < vals.length() {
    check_directives(
      vals[i].directives,
      custom_dir_map,
      dummy_vars,
      false,
      val_stack,
      errs,
    )
    i = i + 1
  }
}

fn get_or_create_type_dir_seen(
  type_seen : Map[String, Map[String, Bool]],
  name : String,
) -> Map[String, Bool] {
  match type_seen.get(name) {
    Some(m) => m
    None => {
      let m : Map[String, Bool] = Map::new()
      type_seen.set(name, m)
      m
    }
  }
}

fn find_frag_idx(
  frags : Array[FragmentDefinition],
  frag_map_opt : Option[Map[String, Int]],
  name : String,
) -> Int {
  match frag_map_opt {
    Some(m) =>
    match m.get(name) {
      Some(idx) => idx
      None => -1
    }
    None => {
      let n = frags.length()
      let mut i = 0
      while i < n {
        if frags[i].name == name {
          return i
        }
        i = i + 1
      }
      -1
    }
  }
}

struct SpreadRef {
  frag_idx : Int
  depth : Int
}

struct SelStats {
  max_depth : Int
  aliases : Int
  fields : Int
  spreads : Array[SpreadRef]
}

///| Iteratively walk a SelectionSet: check args/directives/input fields/known fragments,
///| collect used variables, and collect depth/alias/field/spread stats.
fn walk_selection_set(
  ss : SelectionSet,
  frags : Array[FragmentDefinition],
  frag_map_opt : Option[Map[String, Int]],
  custom_dir_map : Option[Map[String, Bool]],
  used_vars : StrSet,
  collect_vars : Bool,
  stack_ss : Array[SelectionSet],
  stack_depth : Array[Int],
  val_stack : Array[Value],
  errs : Array[ValidationError],
) -> SelStats {
  let mut max_depth = 0
  let mut aliases = 0
  let mut fields = 0
  let spreads : Array[SpreadRef] = []

  stack_ss.clear()
  stack_depth.clear()
  stack_ss.push(ss)
  stack_depth.push(0)

  while stack_ss.length() > 0 {
    let idx = stack_ss.length() - 1
    let cur_ss = stack_ss[idx]
    let cur_depth = stack_depth[idx]
    let _ = stack_ss.pop()
    let _ = stack_depth.pop()

    let sels = cur_ss.selections
    let slen = sels.length()
    let mut i = 0
    while i < slen {
      match sels[i] {
        Selection::Field(f) => {
          let f_depth = cur_depth + 1
          if f_depth > max_depth {
            max_depth = f_depth
          }
          fields = fields + 1
          match f.alias {
            Some(_) => aliases = aliases + 1
            None => ()
          }
          if f.arguments.length() > 0 {
            check_unique_arguments(
              f.arguments,
              used_vars,
              collect_vars,
              val_stack,
              errs,
            )
          }
          if f.directives.length() > 0 {
            check_directives(
              f.directives,
              custom_dir_map,
              used_vars,
              collect_vars,
              val_stack,
              errs,
            )
          }
          match f.selection_set {
            Some(sub) => {
              stack_ss.push(sub)
              stack_depth.push(f_depth)
            }
            None => ()
          }
        }
        Selection::FragmentSpread(fs) => {
          if fs.directives.length() > 0 {
            check_directives(
              fs.directives,
              custom_dir_map,
              used_vars,
              collect_vars,
              val_stack,
              errs,
            )
          }
          let fidx = find_frag_idx(frags, frag_map_opt, fs.name)
          if fidx >= 0 {
            spreads.push(SpreadRef::{ frag_idx: fidx, depth: cur_depth })
          } else {
            errs.push(
              ValidationError::new(
                ValidationErrorKind::UndefinedFragment,
                "unknown fragment '" + fs.name + "'",
              ),
            )
          }
        }
        Selection::InlineFragment(inf) => {
          if inf.directives.length() > 0 {
            check_directives(
              inf.directives,
              custom_dir_map,
              used_vars,
              collect_vars,
              val_stack,
              errs,
            )
          }
          stack_ss.push(inf.selection_set)
          stack_depth.push(cur_depth)
        }
      }
      i = i + 1
    }
  }
  SelStats::{
    max_depth: max_depth,
    aliases: aliases,
    fields: fields,
    spreads: spreads,
  }
}

fn validate_executable_impl(
  doc : Document,
  opts : ValidationOptions,
) -> Array[ValidationError] {
  let errs : Array[ValidationError] = []
  let defs = doc.definitions
  let ndefs = defs.length()
  let ops : Array[OperationDefinition] = []
  let op_declared_vars : Array[StrSet] = []
  let op_direct_vars : Array[StrSet] = []
  let frags : Array[FragmentDefinition] = []
  let dup_frags : Array[FragmentDefinition] = []
  let op_names = StrSet::new()
  let mut frag_map_opt : Option[Map[String, Int]] = None
  let mut anon_ops = 0

  // Lazy custom directive map: only allocated if a DirectiveDef is present in the document
  let mut custom_dir_map : Option[Map[String, Bool]] = None
  let mut i = 0
  while i < ndefs {
    match defs[i] {
      Definition::DirectiveDef(dd) => {
        let m = match custom_dir_map {
          Some(existing) => existing
          None => {
            let fresh : Map[String, Bool] = Map::new()
            custom_dir_map = Some(fresh)
            fresh
          }
        }
        m.set(dd.name, !dd.repeatable)
      }
      _ => ()
    }
    i = i + 1
  }

  let dummy_vars = StrSet::new()
  let val_stack : Array[Value] = []
  let mut schema_dir_seen_opt : Option[Map[String, Bool]] = None
  let mut type_dir_seen_opt : Option[Map[String, Map[String, Bool]]] = None

  // Pass 1: Collect operations & fragments, reject non-executable SDL definitions,
  // check unique names, lone anonymous op, variable definitions, and directives.
  i = 0
  while i < ndefs {
    match defs[i] {
      Definition::Operation(op) => {
        ops.push(op)
        match op.name {
          Some(n) =>
          if !op_names.insert(n) {
            errs.push(
              ValidationError::new(
                ValidationErrorKind::DuplicateOperationName,
                "duplicate operation name '" + n + "'",
              ),
            )
          }
          None => anon_ops = anon_ops + 1
        }
        let var_names = StrSet::new()
        let vdefs = op.variable_definitions
        let mut v = 0
        while v < vdefs.length() {
          let vd = vdefs[v]
          if !var_names.insert(vd.name) {
            errs.push(
              ValidationError::new(
                ValidationErrorKind::DuplicateVariableName,
                "duplicate variable '$" + vd.name + "'",
              ),
            )
          }
          match vd.default_value {
            Some(dv) =>
            check_unique_input_fields_iter(dv, dummy_vars, false, val_stack, errs)
            None => ()
          }
          if vd.directives.length() > 0 {
            check_directives(
              vd.directives,
              custom_dir_map,
              dummy_vars,
              false,
              val_stack,
              errs,
            )
          }
          v = v + 1
        }
        op_declared_vars.push(var_names)
        let dvars = StrSet::new()
        if op.directives.length() > 0 {
          check_directives(op.directives, custom_dir_map, dvars, true, val_stack, errs)
        }
        op_direct_vars.push(dvars)
      }
      Definition::Fragment(frag) => {
        let existing = find_frag_idx(frags, frag_map_opt, frag.name)
        if existing >= 0 {
          errs.push(
            ValidationError::new(
              ValidationErrorKind::DuplicateFragmentName,
              "duplicate fragment name '" + frag.name + "'",
            ),
          )
          dup_frags.push(frag)
        } else {
          let new_idx = frags.length()
          frags.push(frag)
          match frag_map_opt {
            Some(m) => m.set(frag.name, new_idx)
            None =>
            if new_idx >= 8 {
              let m : Map[String, Int] = Map::new()
              let mut k = 0
              while k <= new_idx {
                m.set(frags[k].name, k)
                k = k + 1
              }
              frag_map_opt = Some(m)
            }
          }
        }
      }
      Definition::Schema(s) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "schema definition is not executable",
          ),
        )
        let s_seen = match schema_dir_seen_opt {
          Some(m) => m
          None => {
            let m : Map[String, Bool] = Map::new()
            schema_dir_seen_opt = Some(m)
            m
          }
        }
        check_directives_with_seen(
          s.directives,
          custom_dir_map,
          s_seen,
          dummy_vars,
          false,
          val_stack,
          errs,
        )
      }
      Definition::SchemaExtension(s) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "schema extension is not executable",
          ),
        )
        let s_seen = match schema_dir_seen_opt {
          Some(m) => m
          None => {
            let m : Map[String, Bool] = Map::new()
            schema_dir_seen_opt = Some(m)
            m
          }
        }
        check_directives_with_seen(
          s.directives,
          custom_dir_map,
          s_seen,
          dummy_vars,
          false,
          val_stack,
          errs,
        )
      }
      Definition::DirectiveDef(dd) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "directive definition '@" + dd.name + "' is not executable",
          ),
        )
        check_sdl_input_values(
          dd.arguments,
          custom_dir_map,
          dummy_vars,
          val_stack,
          errs,
        )
      }
      Definition::TypeDef(td) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "type system definition is not executable",
          ),
        )
        let t_seen = match type_dir_seen_opt {
          Some(m) => m
          None => {
            let m : Map[String, Map[String, Bool]] = Map::new()
            type_dir_seen_opt = Some(m)
            m
          }
        }
        match td {
          TypeDefinition::Scalar(x) =>
          check_directives_with_seen(
            x.directives,
            custom_dir_map,
            get_or_create_type_dir_seen(t_seen, x.name),
            dummy_vars,
            false,
            val_stack,
            errs,
          )
          TypeDefinition::Object(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_fields(x.fields, custom_dir_map, dummy_vars, val_stack, errs)
          }
          TypeDefinition::Interface(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_fields(x.fields, custom_dir_map, dummy_vars, val_stack, errs)
          }
          TypeDefinition::Union(x) =>
          check_directives_with_seen(
            x.directives,
            custom_dir_map,
            get_or_create_type_dir_seen(t_seen, x.name),
            dummy_vars,
            false,
            val_stack,
            errs,
          )
          TypeDefinition::Enum(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_enum_values(
              x.values,
              custom_dir_map,
              dummy_vars,
              val_stack,
              errs,
            )
          }
          TypeDefinition::InputObject(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_input_values(
              x.fields,
              custom_dir_map,
              dummy_vars,
              val_stack,
              errs,
            )
          }
        }
      }
      Definition::TypeExtension(te) => {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::ExecutableDefinitions,
            "type system extension is not executable",
          ),
        )
        let t_seen = match type_dir_seen_opt {
          Some(m) => m
          None => {
            let m : Map[String, Map[String, Bool]] = Map::new()
            type_dir_seen_opt = Some(m)
            m
          }
        }
        match te {
          TypeExtension::Scalar(x) =>
          check_directives_with_seen(
            x.directives,
            custom_dir_map,
            get_or_create_type_dir_seen(t_seen, x.name),
            dummy_vars,
            false,
            val_stack,
            errs,
          )
          TypeExtension::Object(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_fields(x.fields, custom_dir_map, dummy_vars, val_stack, errs)
          }
          TypeExtension::Interface(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_fields(x.fields, custom_dir_map, dummy_vars, val_stack, errs)
          }
          TypeExtension::Union(x) =>
          check_directives_with_seen(
            x.directives,
            custom_dir_map,
            get_or_create_type_dir_seen(t_seen, x.name),
            dummy_vars,
            false,
            val_stack,
            errs,
          )
          TypeExtension::Enum(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_enum_values(
              x.values,
              custom_dir_map,
              dummy_vars,
              val_stack,
              errs,
            )
          }
          TypeExtension::InputObject(x) => {
            check_directives_with_seen(
              x.directives,
              custom_dir_map,
              get_or_create_type_dir_seen(t_seen, x.name),
              dummy_vars,
              false,
              val_stack,
              errs,
            )
            check_sdl_input_values(
              x.fields,
              custom_dir_map,
              dummy_vars,
              val_stack,
              errs,
            )
          }
        }
      }
    }
    i = i + 1
  }

  if anon_ops > 0 && ops.length() > 1 {
    errs.push(
      ValidationError::new(
        ValidationErrorKind::LoneAnonymousOperation,
        "anonymous operation must be the only defined operation",
      ),
    )
  }

  // Reusable selection traversal stacks
  let stack_ss : Array[SelectionSet] = Array::with_capacity(8)
  let stack_depth : Array[Int] = Array::with_capacity(8)

  // Pass 2: Walk all fragments (including duplicate fragment bodies) and operations
  let num_frags = frags.length()
  let frag_stats : Array[SelStats] = Array::with_capacity(num_frags)
  let frag_used_vars : Array[Array[String]] = Array::with_capacity(num_frags)
  i = 0
  while i < num_frags {
    let fvars = StrSet::new()
    if frags[i].directives.length() > 0 {
      check_directives(frags[i].directives, custom_dir_map, fvars, true, val_stack, errs)
    }
    frag_stats.push(
      walk_selection_set(
        frags[i].selection_set,
        frags,
        frag_map_opt,
        custom_dir_map,
        fvars,
        true,
        stack_ss,
        stack_depth,
        val_stack,
        errs,
      ),
    )
    frag_used_vars.push(fvars.list)
    i = i + 1
  }

  // Walk duplicate fragment bodies too (P2-4: unknown spreads, args, directives, input fields)
  i = 0
  while i < dup_frags.length() {
    if dup_frags[i].directives.length() > 0 {
      check_directives(
        dup_frags[i].directives,
        custom_dir_map,
        dummy_vars,
        false,
        val_stack,
        errs,
      )
    }
    let _ = walk_selection_set(
      dup_frags[i].selection_set,
      frags,
      frag_map_opt,
      custom_dir_map,
      dummy_vars,
      false,
      stack_ss,
      stack_depth,
      val_stack,
      errs,
    )
    i = i + 1
  }

  let num_ops = ops.length()
  let op_stats : Array[SelStats] = Array::with_capacity(num_ops)
  i = 0
  while i < num_ops {
    op_stats.push(
      walk_selection_set(
        ops[i].selection_set,
        frags,
        frag_map_opt,
        custom_dir_map,
        op_direct_vars[i],
        true,
        stack_ss,
        stack_depth,
        val_stack,
        errs,
      ),
    )
    i = i + 1
  }

  // Pass 3 & 4: Only needed when fragments exist
  let in_cycle : FixedArray[Bool] = FixedArray::make(num_frags, false)
  let eff_depth : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let eff_aliases : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let eff_fields : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let cap = 1000000000

  if num_frags > 0 {
    let color : FixedArray[Int] = FixedArray::make(num_frags, 0)
    let topo_order : Array[Int] = Array::with_capacity(num_frags)
    let dfs_node : Array[Int] = Array::with_capacity(num_frags)
    let dfs_edge : Array[Int] = Array::with_capacity(num_frags)
    let mut reported_cycle = false

    i = 0
    while i < num_frags {
      if color[i] == 0 {
        color[i] = 1
        dfs_node.push(i)
        dfs_edge.push(0)
        while dfs_node.length() > 0 {
          let top = dfs_node.length() - 1
          let u = dfs_node[top]
          let eidx = dfs_edge[top]
          let sp = frag_stats[u].spreads
          if eidx < sp.length() {
            dfs_edge[top] = eidx + 1
            let v = sp[eidx].frag_idx
            if color[v] == 1 {
              in_cycle[u] = true
              in_cycle[v] = true
              if !reported_cycle {
                errs.push(
                  ValidationError::new(
                    ValidationErrorKind::FragmentCycle,
                    "cannot spread fragment '" +
                    frags[v].name +
                    "' within itself via '" +
                    frags[u].name +
                    "'",
                  ),
                )
                reported_cycle = true
              }
            } else if color[v] == 0 {
              color[v] = 1
              dfs_node.push(v)
              dfs_edge.push(0)
            }
          } else {
            color[u] = 2
            topo_order.push(u)
            let _ = dfs_node.pop()
            let _ = dfs_edge.pop()
          }
        }
      }
      i = i + 1
    }

    // Pass 4: Bottom-up DP over topo_order (O(V + E)) for effective depth/aliases/fields
    i = 0
    while i < topo_order.length() {
      let u = topo_order[i]
      let st = frag_stats[u]
      let mut d = st.max_depth
      let mut al = st.aliases
      let mut fl = st.fields
      let mut e = 0
      while e < st.spreads.length() {
        let sr = st.spreads[e]
        let v = sr.frag_idx
        if !in_cycle[v] {
          let sub_d = sr.depth + eff_depth[v]
          if sub_d > d {
            d = sub_d
          }
          al = al + eff_aliases[v]
          if al > cap {
            al = cap
          }
          fl = fl + eff_fields[v]
          if fl > cap {
            fl = cap
          }
        }
        e = e + 1
      }
      eff_depth[u] = d
      eff_aliases[u] = al
      eff_fields[u] = fl
      i = i + 1
    }
  }

  // Pass 5: Per-operation limits + transitive fragment reachability for NoUndefinedVariables,
  // NoUnusedVariables, and NoUnusedFragments.
  let frag_used : FixedArray[Bool] = FixedArray::make(num_frags, false)
  let visited_stamp : FixedArray[Int] = FixedArray::make(num_frags, 0)
  let work : Array[Int] = []
  let mut depth_err = false
  let mut alias_err = false
  let mut field_err = false

  i = 0
  while i < num_ops {
    let st = op_stats[i]
    let mut d = st.max_depth
    let mut al = st.aliases
    let mut fl = st.fields
    let stamp = i + 1
    let mut e = 0
    while e < st.spreads.length() {
      let sr = st.spreads[e]
      let v = sr.frag_idx
      if visited_stamp[v] != stamp {
        visited_stamp[v] = stamp
        work.push(v)
      }
      if !in_cycle[v] {
        let sub_d = sr.depth + eff_depth[v]
        if sub_d > d {
          d = sub_d
        }
        al = al + eff_aliases[v]
        if al > cap {
          al = cap
        }
        fl = fl + eff_fields[v]
        if fl > cap {
          fl = cap
        }
      }
      e = e + 1
    }

    // Collect all variables used directly or via transitively reachable fragments
    let all_used = op_direct_vars[i]
    while work.length() > 0 {
      let fidx = work[work.length() - 1]
      let _ = work.pop()
      frag_used[fidx] = true
      let fvars = frag_used_vars[fidx]
      let mut vi = 0
      while vi < fvars.length() {
        let _ = all_used.insert(fvars[vi])
        vi = vi + 1
      }
      let fsp = frag_stats[fidx].spreads
      let mut si = 0
      while si < fsp.length() {
        let next_f = fsp[si].frag_idx
        if visited_stamp[next_f] != stamp {
          visited_stamp[next_f] = stamp
          work.push(next_f)
        }
        si = si + 1
      }
    }

    // NoUndefinedVariables
    let declared = op_declared_vars[i]
    let used_list = all_used.list
    let mut ui = 0
    while ui < used_list.length() {
      let vn = used_list[ui]
      if !declared.contains(vn) {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::NoUndefinedVariables,
            "variable '$" + vn + "' is not defined",
          ),
        )
      }
      ui = ui + 1
    }

    // NoUnusedVariables
    let vdefs = ops[i].variable_definitions
    let mut di = 0
    while di < vdefs.length() {
      let vn = vdefs[di].name
      if !all_used.contains(vn) {
        errs.push(
          ValidationError::new(
            ValidationErrorKind::NoUnusedVariables,
            "variable '$" + vn + "' is never used",
          ),
        )
      }
      di = di + 1
    }

    if !depth_err && d > opts.max_depth {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxDepthExceeded,
          "query depth " +
          d.to_string() +
          " exceeds max_depth " +
          opts.max_depth.to_string(),
        ),
      )
      depth_err = true
    }
    if !alias_err && al > opts.max_aliases {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxAliasesExceeded,
          "alias count " +
          al.to_string() +
          " exceeds max_aliases " +
          opts.max_aliases.to_string(),
        ),
      )
      alias_err = true
    }
    if !field_err && fl > opts.max_fields {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::MaxFieldsExceeded,
          "field count " +
          fl.to_string() +
          " exceeds max_fields " +
          opts.max_fields.to_string(),
        ),
      )
      field_err = true
    }
    i = i + 1
  }

  // NoUnusedFragments
  i = 0
  while i < num_frags {
    if !frag_used[i] {
      errs.push(
        ValidationError::new(
          ValidationErrorKind::NoUnusedFragments,
          "fragment '" + frags[i].name + "' is never used",
        ),
      )
    }
    i = i + 1
  }

  errs
}
