///| GraphQL core static validation (`validate_executable`) compliance & security tests.

fn has_val_err(errs : Array[ValidationError], kind : ValidationErrorKind) -> Bool {
  let mut i = 0
  while i < errs.length() {
    if validation_error_kind_eq(errs[i].kind, kind) {
      return true
    }
    i = i + 1
  }
  false
}

fn validate_src(src : String) -> Array[ValidationError] {
  match parse(src) {
    Ok(doc) => validate_executable(doc)
    Err(e) => {
      debug_assert(false, "unexpected parse error: " + e.to_string())
      []
    }
  }
}

///|
test "validate__valid_executable_document" {
  let src = "query GetUser($id: ID!) { user(id: $id) { id ...UserFields } } fragment UserFields on User { name email }"
  let errs = validate_src(src)
  debug_assert(errs.length() == 0, "expected 0 validation errors, got " + errs.length().to_string())
}

///|
test "validate__unique_operation_names" {
  let errs = validate_src("query Foo { a } mutation Foo { b }")
  debug_assert(
    has_val_err(errs, ValidationErrorKind::DuplicateOperationName),
    "expected DuplicateOperationName",
  )
}

///|
test "validate__lone_anonymous_operation" {
  let errs1 = validate_src("{ a } query Named { b }")
  debug_assert(
    has_val_err(errs1, ValidationErrorKind::LoneAnonymousOperation),
    "anonymous mixed with named",
  )
  let errs2 = validate_src("{ a } { b }")
  debug_assert(
    has_val_err(errs2, ValidationErrorKind::LoneAnonymousOperation),
    "two anonymous operations",
  )
  // Single anonymous + fragments is valid!
  let errs3 = validate_src("{ ...F } fragment F on Query { a }")
  debug_assert(errs3.length() == 0, "single anonymous + fragment is valid")
}

///|
test "validate__unique_variable_names" {
  let errs = validate_src("query Q($a: Int, $b: String, $a: Boolean) { x }")
  debug_assert(
    has_val_err(errs, ValidationErrorKind::DuplicateVariableName),
    "expected DuplicateVariableName",
  )
  // Same variable name across DIFFERENT operations is valid
  let errs_ok = validate_src("query Q1($a: Int) { x } query Q2($a: Int) { y }")
  debug_assert(errs_ok.length() == 0, "same var in different ops is valid")
}

///|
test "validate__unique_argument_and_input_field_names" {
  let errs1 = validate_src("{ field(a: 1, a: 2) }")
  debug_assert(
    has_val_err(errs1, ValidationErrorKind::DuplicateArgumentName),
    "duplicate field arg",
  )
  let errs2 = validate_src("{ field @dir(x: 1, x: 2) }")
  debug_assert(
    has_val_err(errs2, ValidationErrorKind::DuplicateArgumentName),
    "duplicate directive arg",
  )
  let errs3 = validate_src("{ field(in: { k: 1, k: 2 }) }")
  debug_assert(
    has_val_err(errs3, ValidationErrorKind::DuplicateInputFieldName),
    "duplicate input object field",
  )
}

///|
test "validate__unique_and_known_fragment_names" {
  let errs1 = validate_src("{ ...A } fragment A on T { x } fragment A on T { y }")
  debug_assert(
    has_val_err(errs1, ValidationErrorKind::DuplicateFragmentName),
    "duplicate fragment name",
  )
  let errs2 = validate_src("{ ...MissingFrag }")
  debug_assert(
    has_val_err(errs2, ValidationErrorKind::UndefinedFragment),
    "undefined fragment spread",
  )
}

///|
test "validate__fragment_cycles_and_dag" {
  // Direct self cycle
  let e1 = validate_src("{ ...A } fragment A on T { ...A }")
  debug_assert(has_val_err(e1, ValidationErrorKind::FragmentCycle), "self cycle")

  // Mutual 2-cycle
  let e2 = validate_src("{ ...A } fragment A on T { ...B } fragment B on T { ...A }")
  debug_assert(has_val_err(e2, ValidationErrorKind::FragmentCycle), "mutual cycle")

  // 3-cycle
  let e3 = validate_src(
    "{ ...A } fragment A on T { ...B } fragment B on T { ...C } fragment C on T { ...A }",
  )
  debug_assert(has_val_err(e3, ValidationErrorKind::FragmentCycle), "3-cycle")

  // Diamond DAG is NOT a cycle!
  let e_dag = validate_src(
    "{ ...A } fragment A on T { ...B ...C } fragment B on T { ...D } fragment C on T { ...D } fragment D on T { id }",
  )
  debug_assert(e_dag.length() == 0, "diamond fragment DAG must be valid, got " + e_dag.length().to_string())
}

///|
test "validate__security_limits_depth_aliases_fields" {
  let opts = ValidationOptions::new(3, 2, 4)

  // Depth limit (including through fragment spreads)
  let d_deep = match parse("{ a { b { c { d } } } }") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return
    }
  }
  let e_depth = validate_executable_with_options(d_deep, opts)
  debug_assert(
    has_val_err(e_depth, ValidationErrorKind::MaxDepthExceeded),
    "expected MaxDepthExceeded",
  )

  // Depth via fragment spread: a (1) -> ...F -> b (2) -> c (3) -> d (4) > 3
  let d_frag_deep = match parse("{ a { ...F } } fragment F on T { b { c { d } } }") {
    Ok(d) => d
    Err(_) => return
  }
  let e_fdepth = validate_executable_with_options(d_frag_deep, opts)
  debug_assert(
    has_val_err(e_fdepth, ValidationErrorKind::MaxDepthExceeded),
    "expected MaxDepthExceeded through fragment",
  )

  // Alias limit (> 2)
  let d_alias = match parse("{ a1: x a2: x a3: x }") {
    Ok(d) => d
    Err(_) => return
  }
  let e_alias = validate_executable_with_options(d_alias, opts)
  debug_assert(
    has_val_err(e_alias, ValidationErrorKind::MaxAliasesExceeded),
    "expected MaxAliasesExceeded",
  )

  // Field limit (> 4)
  let d_fields = match parse("{ f1 f2 f3 f4 f5 }") {
    Ok(d) => d
    Err(_) => return
  }
  let e_fields = validate_executable_with_options(d_fields, opts)
  debug_assert(
    has_val_err(e_fields, ValidationErrorKind::MaxFieldsExceeded),
    "expected MaxFieldsExceeded",
  )
}
