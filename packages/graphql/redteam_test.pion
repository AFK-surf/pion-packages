///| Day-1 Red-Team security & DoS resistance suite for `graphql`.

fn repeat_s(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

fn make_raw_bytes(arr : Array[Int]) -> Bytes {
  let out = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

///|
test "redteam__50k_nested_selection_sets_no_sigsegv" {
  let deep = repeat_s("{a", 50000) + repeat_s("}", 50000)
  match parse(deep) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "50k selections -> LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k nested selection sets")
  }
  // Iterative parser handles 500-level deep nesting with higher max_depth cleanly (0 recursion)
  let deep_500 = repeat_s("{a", 500) + repeat_s("}", 500)
  let opts = ParseOptions::new(1000, 500000, 500000)
  match parse_with_options(deep_500, opts) {
    Ok(doc) => {
      debug_assert(doc.definitions.length() == 1, "500-level nested selection parsed iteratively")
      let printed = print_document(doc)
      debug_assert(printed.length() > 500, "500-level printed iteratively")
    }
    Err(e) => debug_assert(false, "500-level iterative parse failed: " + e.to_string())
  }
}

///|
test "redteam__50k_nested_list_and_object_values_no_sigsegv" {
  let deep_list = "{ f(x: " + repeat_s("[", 50000) + "1" + repeat_s("]", 50000) + ") }"
  match parse(deep_list) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "50k nested lists -> LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k nested list values")
  }

  let deep_obj = "{ f(x: " + repeat_s("{a:", 50000) + "1" + repeat_s("}", 50000) + ") }"
  match parse(deep_obj) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "50k nested objects -> LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k nested object values")
  }

  let deep_type = "type T { f: " + repeat_s("[", 50000) + "Int" + repeat_s("]", 50000) + " }"
  match parse(deep_type) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "50k nested types -> LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k nested list types")
  }
}

///|
test "redteam__10k_aliases_and_fragments_linear" {
  // 10,000 aliases in one operation -> O(N) parse + O(N) validate
  let sb = StringBuilder::new()
  sb.write_string("query AliasBomb {")
  let mut i = 0
  while i < 10000 {
    sb.write_string(" a")
    sb.write_string(i.to_string())
    sb.write_string(":id")
    i = i + 1
  }
  sb.write_string(" }")
  let doc = match parse(sb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "10k aliases parse failed: " + e.to_string())
      return
    }
  }
  let errs = validate_executable(doc)
  let mut found_alias_limit = false
  let mut k = 0
  while k < errs.length() {
    if validation_error_kind_eq(errs[k].kind, ValidationErrorKind::MaxAliasesExceeded) {
      found_alias_limit = true
    }
    k = k + 1
  }
  debug_assert(found_alias_limit, "10k alias bomb must trigger MaxAliasesExceeded")

  // 10,000 fragment definitions -> O(N) parse + O(N) cycle check
  let fsb = StringBuilder::new()
  fsb.write_string("{")
  i = 0
  while i < 10000 {
    fsb.write_string(" ...F")
    fsb.write_string(i.to_string())
    i = i + 1
  }
  fsb.write_string(" }")
  i = 0
  while i < 10000 {
    fsb.write_string(" fragment F")
    fsb.write_string(i.to_string())
    fsb.write_string(" on T { id }")
    i = i + 1
  }
  let fdoc = match parse(fsb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "10k fragments parse failed: " + e.to_string())
      return
    }
  }
  let ferrs = validate_executable_with_options(fdoc, ValidationOptions::new(64, 100, 20000))
  debug_assert(ferrs.length() == 0, "10k disjoint fragments validate cleanly in O(N)")
}

///|
test "redteam__max_tokens_and_max_nodes_budgets" {
  let src = "{ a b c d e f g h i j k l m n o p }"
  let tok_opts = ParseOptions::new(128, 5, 10000)
  match tokenize_with_options(src, tok_opts) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "max_tokens enforced in tokenize")
    Ok(_) => debug_assert(false, "expected max_tokens LimitExceeded")
  }
  match parse_with_options(src, tok_opts) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "max_tokens enforced in parse")
    Ok(_) => debug_assert(false, "expected max_tokens LimitExceeded in parse")
  }
  let node_opts = ParseOptions::new(128, 10000, 5)
  match parse_with_options(src, node_opts) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::LimitExceeded), "max_nodes enforced in parse")
    Ok(_) => debug_assert(false, "expected max_nodes LimitExceeded")
  }
}

///|
test "redteam__nul_and_invalid_utf8_rejected" {
  // NUL in source string
  match tokenize("{\u{0000}a}") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NUL byte in source must be rejected")
  }
  // NUL inside string literal
  match tokenize("{ f(x: \"a\u{0000}b\") }") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NUL byte in string literal must be rejected")
  }
  // NUL inside comment
  match tokenize("# hello \u{0000} world\n{ a }") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NUL byte in comment must be rejected")
  }
  // Invalid UTF-8 bytes: 0xFF, overlong 2-byte (C0 80), truncated 3-byte (E2 82), UTF-8 surrogate (ED A0 80)
  let bad_ff = make_raw_bytes([123, 32, 0xFF, 32, 125])
  match parse_bytes(bad_ff) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::InvalidUtf8), "0xFF -> InvalidUtf8")
    Ok(_) => debug_assert(false, "expected InvalidUtf8 for 0xFF")
  }
  let bad_overlong = make_raw_bytes([123, 32, 0xC0, 0xAF, 32, 125])
  match tokenize_bytes(bad_overlong) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::InvalidUtf8), "overlong -> InvalidUtf8")
    Ok(_) => debug_assert(false, "expected InvalidUtf8 for overlong UTF-8")
  }
  let bad_surrogate = make_raw_bytes([123, 32, 0xED, 0xA0, 0x80, 32, 125])
  match parse_bytes(bad_surrogate) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::InvalidUtf8), "UTF-8 surrogate -> InvalidUtf8")
    Ok(_) => debug_assert(false, "expected InvalidUtf8 for UTF-8 surrogate")
  }
  let bad_trunc = make_raw_bytes([123, 32, 0xE2, 0x82])
  match tokenize_bytes(bad_trunc) {
    Err(e) => debug_assert(error_kind_eq(e.kind, ErrorKind::InvalidUtf8), "truncated -> InvalidUtf8")
    Ok(_) => debug_assert(false, "expected InvalidUtf8 for truncated UTF-8")
  }
}
