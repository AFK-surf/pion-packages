///| Regression unit tests for all RT-xpath P1-1..P1-8 and P2-1..P2-4 defects.

fn rt_same_num(a : Double, b : Double) -> Bool {
  if a != a && b != b {
    return true
  }
  a.to_bits() == b.to_bits()
}

///| P1-1 & P1-8: pure-Pion §4.2 number->string without exponent notation, deterministic across Native & Wasm32.
test "rt_p1_1_number_to_string_no_exponent" {
  let doc = match XPathDoc::parse("<r/>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  match eval_string(doc, "string(1000000000000000000000)") {
    Ok(s) => debug_assert(s == "1000000000000000000000", "1e21 = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_string(doc, "string(1152921504606846976)") {
    Ok(s) => debug_assert(s == "1152921504606846976", "2^60 = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_string(doc, "string(0.0000001)") {
    Ok(s) => debug_assert(s == "0.0000001", "1e-7 = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_string(doc, "string(-0.0000000065809376)") {
    Ok(s) => debug_assert(s == "-0.0000000065809376", "-6.5809376e-9 = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_string(doc, "concat(1 div 10000000, '|', 100000000000000000000)") {
    Ok(s) => debug_assert(s == "0.0000001|100000000000000000000", "concat = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_string(doc, "string(-0)") {
    Ok(s) => debug_assert(s == "0", "-0 = " + s)
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P1-2: correctly rounded §4.4 string->number and 330-digit fraction without overflow to NaN.
test "rt_p1_2_correctly_rounded_string_to_number" {
  let doc = match XPathDoc::parse("<r/>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  match eval_number(doc, "0.49999999999999994") {
    Ok(n) => debug_assert(rt_same_num(n, 0.49999999999999994), "0.49999999999999994")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "round(0.49999999999999994)") {
    Ok(n) => debug_assert(rt_same_num(n, 0.0), "round just below 0.5")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "number('0.44170928548011157')") {
    Ok(n) => debug_assert(rt_same_num(n, 0.44170928548011157), "0.44170928548011157")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "number('2340032014150785536')") {
    Ok(n) => debug_assert(rt_same_num(n, 2340032014150785536.0), "2340032014150785536")
    Err(e) => debug_assert(false, e.to_string())
  }
  let sb = StringBuilder::new()
  sb.write_string("number('0.")
  let mut i = 0
  while i < 330 {
    sb.write_string("1")
    i = i + 1
  }
  sb.write_string("')")
  match eval_number(doc, sb.to_string()) {
    Ok(n) => debug_assert(rt_same_num(n, 0.1111111111111111), "330-digit fraction")
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P1-3: bit-exact IEEE-754 fmod with dividend sign preserved on zero remainder.
test "rt_p1_3_exact_ieee754_fmod" {
  let doc = match XPathDoc::parse("<r/>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  match eval_number(doc, "5.5 mod 1.1") {
    Ok(n) => debug_assert(rt_same_num(n, 1.0999999999999996), "5.5 mod 1.1")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "100000000000000000000 mod 3") {
    Ok(n) => debug_assert(rt_same_num(n, 1.0), "1e20 mod 3")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "9031316886084362240 mod 7.5") {
    Ok(n) => debug_assert(rt_same_num(n, 5.0), "large dividend mod")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "1 div (-0 mod 5)") {
    Ok(n) => debug_assert(rt_same_num(n, -1.0 / 0.0), "-0 mod 5 = -0")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(doc, "1 div (-6 mod 3)") {
    Ok(n) => debug_assert(rt_same_num(n, -1.0 / 0.0), "-6 mod 3 = -0")
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P1-4: flat left-associative chains (or, +, |) and caller max_depth > 128.
test "rt_p1_4_flat_chains_and_custom_max_depth" {
  let doc = match XPathDoc::parse("<r id=\"L\"><a/></r>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  let sb_or = StringBuilder::new()
  sb_or.write_string("count(/r[")
  let mut i = 0
  while i < 200 {
    sb_or.write_string("@id='" + i.to_string() + "' or ")
    i = i + 1
  }
  sb_or.write_string("@id='L'])")
  match eval_number(doc, sb_or.to_string()) {
    Ok(n) => debug_assert(rt_same_num(n, 1.0), "201-term or")
    Err(e) => debug_assert(false, e.to_string())
  }
  let sb_add = StringBuilder::new()
  i = 0
  while i < 200 {
    if i > 0 {
      sb_add.write_string("+")
    }
    sb_add.write_string("1")
    i = i + 1
  }
  match eval_number(doc, sb_add.to_string()) {
    Ok(n) => debug_assert(rt_same_num(n, 200.0), "200-term +")
    Err(e) => debug_assert(false, e.to_string())
  }
  let sb_u = StringBuilder::new()
  sb_u.write_string("count(")
  i = 0
  while i < 200 {
    if i > 0 {
      sb_u.write_string("|")
    }
    sb_u.write_string("/r/a")
    i = i + 1
  }
  sb_u.write_string(")")
  match eval_number(doc, sb_u.to_string()) {
    Ok(n) => debug_assert(rt_same_num(n, 1.0), "200-term |")
    Err(e) => debug_assert(false, e.to_string())
  }
  // Custom max_depth > 128 must be honoured
  let sb_p = StringBuilder::new()
  i = 0
  while i < 150 {
    sb_p.write_string("(")
    i = i + 1
  }
  sb_p.write_string("42")
  i = 0
  while i < 150 {
    sb_p.write_string(")")
    i = i + 1
  }
  let ctx = XPathContext::new().with_limits(
    XPathLimits::new(200, 1000000L, 100000, 1048576),
  )
  match eval_with(doc, doc.root(), sb_p.to_string(), ctx) {
    Ok(v) => debug_assert(rt_same_num(v.to_number(doc), 42.0), "150 nested parens with max_depth=200")
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P1-6 & P1-7: O(n+m) node-set comparisons and cached/budgeted string-value evaluation.
test "rt_p1_6_p1_7_nodeset_compare_and_string_budget" {
  let sb = StringBuilder::new()
  sb.write_string("<r>")
  let mut i = 0
  while i < 500 {
    sb.write_string("<a>" + i.to_string() + "</a>")
    i = i + 1
  }
  i = 0
  while i < 500 {
    sb.write_string("<b>" + (i + 1000).to_string() + "</b>")
    i = i + 1
  }
  sb.write_string("</r>")
  let doc = match XPathDoc::parse(sb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  match eval_bool(doc, "//a = //b") {
    Ok(b) => debug_assert(!b, "disjoint =")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_bool(doc, "//a != //b") {
    Ok(b) => debug_assert(b, "disjoint !=")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_bool(doc, "//a < //b") {
    Ok(b) => debug_assert(b, "a < b")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_bool(doc, "//a > //b") {
    Ok(b) => debug_assert(!b, "a > b")
    Err(e) => debug_assert(false, e.to_string())
  }
  // Repeated normalize-space(/) with tight step budget must fail cleanly with LimitExceeded
  let tight = XPathContext::new().with_limits(
    XPathLimits::new(128, 5000L, 100000, 16777216),
  )
  match eval_with(doc, doc.root(), "count(//a[normalize-space(/) = 'x'])", tight) {
    Ok(_) => debug_assert(false, "expected LimitExceeded on repeated normalize-space(/)")
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::LimitExceeded), e.to_string())
  }
}

///| P2-1..P2-4: explicit xmlns:xml, non-aliasing context, normalized nodeset vars, safe DOCTYPE.
test "rt_p2_model_and_api_regressions" {
  // P2-1: explicit xmlns:xml keeps namespace::xml
  let ns_xml = "<a xmlns:xml=\"http://www.w3.org/XML/1998/namespace\" xmlns:p=\"u\"><b/></a>"
  let ns_doc = match XPathDoc::parse(ns_xml) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  match eval_number(ns_doc, "count(/a/namespace::xml)") {
    Ok(n) => debug_assert(rt_same_num(n, 1.0), "P2-1 /a/namespace::xml")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_number(ns_doc, "count(/a/b/namespace::xml)") {
    Ok(n) => debug_assert(rt_same_num(n, 1.0), "P2-1 /a/b/namespace::xml")
    Err(e) => debug_assert(false, e.to_string())
  }

  // P2-2: context builders do not alias
  let cdoc = match XPathDoc::parse("<r xmlns:a=\"urn:one\"><a:x/></r>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  let base = XPathContext::new().with_namespace("p", "urn:one")
  let _derived = base.with_namespace("p", "urn:two")
  match eval_with(cdoc, cdoc.root(), "count(//p:x)", base) {
    Ok(v) => debug_assert(rt_same_num(v.to_number(cdoc), 1.0), "P2-2 ns non-aliasing")
    Err(e) => debug_assert(false, e.to_string())
  }
  let v0 = XPathContext::new().with_variable("k", XPathValue::Number(10.0))
  let _v1 = v0.with_variable("k", XPathValue::Number(20.0))
  match eval_with(cdoc, cdoc.root(), "$k", v0) {
    Ok(v) => debug_assert(rt_same_num(v.to_number(cdoc), 10.0), "P2-2 var non-aliasing")
    Err(e) => debug_assert(false, e.to_string())
  }

  // P2-3: node-set variable normalized to document order and deduplicated
  let vdoc = match XPathDoc::parse("<r><a/><b/></r>") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  let nodes = match eval_nodes(vdoc, "/r/*") {
    Ok(ns) => ns
    Err(e) => {
      debug_assert(false, e.to_string())
      return
    }
  }
  let rev : Array[XNode] = [nodes[1], nodes[0], nodes[1]]
  let vctx = XPathContext::new().with_variable("v", XPathValue::NodeSet(rev))
  match eval_with(vdoc, vdoc.root(), "count($v | /r/a)", vctx) {
    Ok(v) => debug_assert(rt_same_num(v.to_number(vdoc), 2.0), "P2-3 union dedup")
    Err(e) => debug_assert(false, e.to_string())
  }
  match eval_with(vdoc, vdoc.root(), "name($v[1])", vctx) {
    Ok(v) => debug_assert(v.to_string(vdoc) == "a", "P2-3 document order")
    Err(e) => debug_assert(false, e.to_string())
  }

  // P2-4: safe DOCTYPE accepted, external entity still blocked
  match XPathDoc::parse("<!DOCTYPE r><r><a/></r>") {
    Ok(d) =>
    match eval_number(d, "count(/r/a)") {
      Ok(n) => debug_assert(rt_same_num(n, 1.0), "P2-4 doctype count")
      Err(e) => debug_assert(false, e.to_string())
    }
    Err(e) => debug_assert(false, e.to_string())
  }
  match XPathDoc::parse("<!DOCTYPE r [<!ENTITY ext SYSTEM \"file:///etc/passwd\">]><r>&ext;</r>") {
    Ok(_) => debug_assert(false, "P2-4 external entity must be blocked")
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::XmlParseError), e.to_string())
  }
}
