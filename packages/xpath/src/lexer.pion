///| W3C XPath 1.0 §3.7 disambiguating tokenizer.

// Token kinds
let tk_eof : Int = 0

let tk_lparen : Int = 1

let tk_rparen : Int = 2

let tk_lbracket : Int = 3

let tk_rbracket : Int = 4

let tk_dot : Int = 5

let tk_dotdot : Int = 6

let tk_at : Int = 7

let tk_comma : Int = 8

let tk_dcolon : Int = 9

let tk_slash : Int = 10

let tk_dslash : Int = 11

let tk_pipe : Int = 12

let tk_plus : Int = 13

let tk_minus : Int = 14

let tk_eq : Int = 15

let tk_neq : Int = 16

let tk_lt : Int = 17

let tk_le : Int = 18

let tk_gt : Int = 19

let tk_ge : Int = 20

let tk_mul : Int = 21

let tk_and : Int = 22

let tk_or : Int = 23

let tk_mod : Int = 24

let tk_div : Int = 25

let tk_star : Int = 26

let tk_name : Int = 27

let tk_qname : Int = 28

let tk_ns_star : Int = 29

let tk_nodetype : Int = 30

let tk_func : Int = 31

let tk_axis : Int = 32

let tk_var : Int = 33

let tk_str : Int = 34

let tk_num : Int = 35

struct Token {
  kind : Int
  offset : Int
  s1 : String
  s2 : String
  num : Double
}

fn is_ncname_start(b : Int) -> Bool {
  (b >= 0x41 && b <= 0x5A) ||
  (b >= 0x61 && b <= 0x7A) ||
  b == 0x5F ||
  b >= 0x80
}

fn is_ncname_char(b : Int) -> Bool {
  (b >= 0x41 && b <= 0x5A) ||
  (b >= 0x61 && b <= 0x7A) ||
  (b >= 0x30 && b <= 0x39) ||
  b == 0x5F ||
  b == 0x2D ||
  b == 0x2E ||
  b >= 0x80
}

fn prev_allows_op(prev_kind : Int) -> Bool {
  prev_kind == tk_rparen ||
  prev_kind == tk_rbracket ||
  prev_kind == tk_dot ||
  prev_kind == tk_dotdot ||
  prev_kind == tk_star ||
  prev_kind == tk_name ||
  prev_kind == tk_qname ||
  prev_kind == tk_ns_star ||
  prev_kind == tk_var ||
  prev_kind == tk_str ||
  prev_kind == tk_num
}

fn is_nodetype_name(s : String) -> Bool {
  s == "node" || s == "text" || s == "comment" || s == "processing-instruction"
}

fn tokenize_xpath(src : String) -> Result[Array[Token], XPathError] {
  let n = src.length()
  let tokens : Array[Token] = Array::with_capacity(n / 3 + 8)
  let mut i = 0
  let mut prev_kind = tk_eof

  while i < n {
    let b = src.code_unit_at(i)
    if xml_is_ws(b) {
      i = i + 1
      continue
    }
    let start = i
    if b == 0x28 {
      // (
      tokens.push(Token::{ kind: tk_lparen, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_lparen
      i = i + 1
    } else if b == 0x29 {
      // )
      tokens.push(Token::{ kind: tk_rparen, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_rparen
      i = i + 1
    } else if b == 0x5B {
      // [
      tokens.push(Token::{ kind: tk_lbracket, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_lbracket
      i = i + 1
    } else if b == 0x5D {
      // ]
      tokens.push(Token::{ kind: tk_rbracket, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_rbracket
      i = i + 1
    } else if b == 0x40 {
      // @
      tokens.push(Token::{ kind: tk_at, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_at
      i = i + 1
    } else if b == 0x2C {
      // ,
      tokens.push(Token::{ kind: tk_comma, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_comma
      i = i + 1
    } else if b == 0x7C {
      // |
      tokens.push(Token::{ kind: tk_pipe, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_pipe
      i = i + 1
    } else if b == 0x2B {
      // +
      tokens.push(Token::{ kind: tk_plus, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_plus
      i = i + 1
    } else if b == 0x2D {
      // -
      tokens.push(Token::{ kind: tk_minus, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_minus
      i = i + 1
    } else if b == 0x3D {
      // =
      tokens.push(Token::{ kind: tk_eq, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = tk_eq
      i = i + 1
    } else if b == 0x21 {
      // !=
      if i + 1 < n && src.code_unit_at(i + 1) == 0x3D {
        tokens.push(Token::{ kind: tk_neq, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_neq
        i = i + 2
      } else {
        return Err(
          XPathError::new(
            XPathErrorKind::LexError,
            start,
            "unexpected '!' (expected '!=')",
          ),
        )
      }
    } else if b == 0x3C {
      // < or <=
      if i + 1 < n && src.code_unit_at(i + 1) == 0x3D {
        tokens.push(Token::{ kind: tk_le, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_le
        i = i + 2
      } else {
        tokens.push(Token::{ kind: tk_lt, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_lt
        i = i + 1
      }
    } else if b == 0x3E {
      // > or >=
      if i + 1 < n && src.code_unit_at(i + 1) == 0x3D {
        tokens.push(Token::{ kind: tk_ge, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_ge
        i = i + 2
      } else {
        tokens.push(Token::{ kind: tk_gt, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_gt
        i = i + 1
      }
    } else if b == 0x2F {
      // / or //
      if i + 1 < n && src.code_unit_at(i + 1) == 0x2F {
        tokens.push(Token::{ kind: tk_dslash, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_dslash
        i = i + 2
      } else {
        tokens.push(Token::{ kind: tk_slash, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_slash
        i = i + 1
      }
    } else if b == 0x3A {
      // ::
      if i + 1 < n && src.code_unit_at(i + 1) == 0x3A {
        tokens.push(Token::{ kind: tk_dcolon, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_dcolon
        i = i + 2
      } else {
        return Err(
          XPathError::new(
            XPathErrorKind::LexError,
            start,
            "unexpected ':'",
          ),
        )
      }
    } else if b == 0x2A {
      // * : MultiplyOperator vs NameTest wildcard (§3.7)
      let kind = if prev_allows_op(prev_kind) { tk_mul } else { tk_star }
      tokens.push(Token::{ kind: kind, offset: start, s1: "", s2: "", num: 0.0 })
      prev_kind = kind
      i = i + 1
    } else if b == 0x27 || b == 0x22 {
      // String literal '...' or "..."
      let quote = b
      i = i + 1
      let s_start = i
      while i < n && src.code_unit_at(i) != quote {
        i = i + 1
      }
      if i >= n {
        return Err(
          XPathError::new(
            XPathErrorKind::LexError,
            start,
            "unterminated string literal",
          ),
        )
      }
      let lit = src.slice(s_start, i)
      i = i + 1
      tokens.push(Token::{ kind: tk_str, offset: start, s1: lit, s2: "", num: 0.0 })
      prev_kind = tk_str
    } else if b == 0x2E {
      // . or .. or .Digits
      if i + 1 < n && src.code_unit_at(i + 1) == 0x2E {
        tokens.push(Token::{ kind: tk_dotdot, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_dotdot
        i = i + 2
      } else if i + 1 < n &&
      src.code_unit_at(i + 1) >= 0x30 &&
      src.code_unit_at(i + 1) <= 0x39 {
        i = i + 1
        while i < n && src.code_unit_at(i) >= 0x30 && src.code_unit_at(i) <= 0x39 {
          i = i + 1
        }
        let num = xp_parse_number(src.slice(start, i))
        tokens.push(Token::{ kind: tk_num, offset: start, s1: "", s2: "", num: num })
        prev_kind = tk_num
      } else {
        tokens.push(Token::{ kind: tk_dot, offset: start, s1: "", s2: "", num: 0.0 })
        prev_kind = tk_dot
        i = i + 1
      }
    } else if b >= 0x30 && b <= 0x39 {
      // Number: Digits ('.' Digits?)?
      while i < n && src.code_unit_at(i) >= 0x30 && src.code_unit_at(i) <= 0x39 {
        i = i + 1
      }
      if i < n && src.code_unit_at(i) == 0x2E {
        i = i + 1
        while i < n && src.code_unit_at(i) >= 0x30 && src.code_unit_at(i) <= 0x39 {
          i = i + 1
        }
      }
      let num = xp_parse_number(src.slice(start, i))
      tokens.push(Token::{ kind: tk_num, offset: start, s1: "", s2: "", num: num })
      prev_kind = tk_num
    } else if b == 0x24 {
      // VariableReference: $QName
      i = i + 1
      if i >= n || !is_ncname_start(src.code_unit_at(i)) {
        return Err(
          XPathError::new(
            XPathErrorKind::LexError,
            start,
            "expected variable name after '$'",
          ),
        )
      }
      let v_start = i
      i = i + 1
      while i < n && is_ncname_char(src.code_unit_at(i)) {
        i = i + 1
      }
      if i < n && src.code_unit_at(i) == 0x3A {
        if i + 1 >= n || !is_ncname_start(src.code_unit_at(i + 1)) {
          return Err(
            XPathError::new(
              XPathErrorKind::LexError,
              i,
              "invalid qualified variable name",
            ),
          )
        }
        i = i + 2
        while i < n && is_ncname_char(src.code_unit_at(i)) {
          i = i + 1
        }
      }
      let vname = src.slice(v_start, i)
      tokens.push(Token::{ kind: tk_var, offset: start, s1: vname, s2: "", num: 0.0 })
      prev_kind = tk_var
    } else if is_ncname_start(b) {
      i = i + 1
      while i < n && is_ncname_char(src.code_unit_at(i)) {
        i = i + 1
      }
      let name1 = src.slice(start, i)

      // §3.7 Rule 1: If preceding token allows an operator, recognize OperatorName
      if prev_allows_op(prev_kind) {
        if name1 == "and" {
          tokens.push(Token::{ kind: tk_and, offset: start, s1: "", s2: "", num: 0.0 })
          prev_kind = tk_and
          continue
        } else if name1 == "or" {
          tokens.push(Token::{ kind: tk_or, offset: start, s1: "", s2: "", num: 0.0 })
          prev_kind = tk_or
          continue
        } else if name1 == "mod" {
          tokens.push(Token::{ kind: tk_mod, offset: start, s1: "", s2: "", num: 0.0 })
          prev_kind = tk_mod
          continue
        } else if name1 == "div" {
          tokens.push(Token::{ kind: tk_div, offset: start, s1: "", s2: "", num: 0.0 })
          prev_kind = tk_div
          continue
        }
      }

      // Check for single ':' (QName or prefix:*) — NOT '::'
      if i < n && src.code_unit_at(i) == 0x3A &&
      !(i + 1 < n && src.code_unit_at(i + 1) == 0x3A) {
        i = i + 1
        if i < n && src.code_unit_at(i) == 0x2A {
          i = i + 1
          tokens.push(Token::{ kind: tk_ns_star, offset: start, s1: name1, s2: "", num: 0.0 })
          prev_kind = tk_ns_star
          continue
        }
        if i >= n || !is_ncname_start(src.code_unit_at(i)) {
          return Err(
            XPathError::new(
              XPathErrorKind::LexError,
              i,
              "expected local name or '*' after ':'",
            ),
          )
        }
        let l_start = i
        i = i + 1
        while i < n && is_ncname_char(src.code_unit_at(i)) {
          i = i + 1
        }
        let name2 = src.slice(l_start, i)
        // Look ahead past whitespace for '(' (qualified function call)
        let mut la = i
        while la < n && xml_is_ws(src.code_unit_at(la)) {
          la = la + 1
        }
        if la < n && src.code_unit_at(la) == 0x28 {
          tokens.push(
            Token::{
              kind: tk_func,
              offset: start,
              s1: name1 + ":" + name2,
              s2: "",
              num: 0.0,
            },
          )
          prev_kind = tk_func
        } else {
          tokens.push(Token::{ kind: tk_qname, offset: start, s1: name1, s2: name2, num: 0.0 })
          prev_kind = tk_qname
        }
        continue
      }

      // Look ahead past whitespace for '(' or '::'
      let mut la = i
      while la < n && xml_is_ws(src.code_unit_at(la)) {
        la = la + 1
      }
      if la < n && src.code_unit_at(la) == 0x28 {
        if is_nodetype_name(name1) {
          tokens.push(Token::{ kind: tk_nodetype, offset: start, s1: name1, s2: "", num: 0.0 })
          prev_kind = tk_nodetype
        } else {
          tokens.push(Token::{ kind: tk_func, offset: start, s1: name1, s2: "", num: 0.0 })
          prev_kind = tk_func
        }
      } else if la + 1 < n &&
      src.code_unit_at(la) == 0x3A &&
      src.code_unit_at(la + 1) == 0x3A {
        tokens.push(Token::{ kind: tk_axis, offset: start, s1: name1, s2: "", num: 0.0 })
        prev_kind = tk_axis
      } else {
        tokens.push(Token::{ kind: tk_name, offset: start, s1: name1, s2: "", num: 0.0 })
        prev_kind = tk_name
      }
    } else {
      return Err(
        XPathError::new(
          XPathErrorKind::LexError,
          start,
          "unexpected character in XPath expression",
        ),
      )
    }
  }

  tokens.push(Token::{ kind: tk_eof, offset: n, s1: "", s2: "", num: 0.0 })
  Ok(tokens)
}
