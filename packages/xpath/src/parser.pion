///| Depth-bounded recursive-descent parser for W3C XPath 1.0 expressions.

struct Parser {
  tokens : Array[Token]
  mut pos : Int
  mut depth : Int
  max_depth : Int
  exprs : Array[ExprNode]
  steps : Array[Step]
  expr_lists : Array[Int]
}

fn Parser::new(tokens : Array[Token], limits : XPathLimits) -> Parser {
  let md = if limits.max_depth < 1 {
    1
  } else if limits.max_depth > 128 {
    128
  } else {
    limits.max_depth
  }
  Parser::{
    tokens: tokens,
    pos: 0,
    depth: 0,
    max_depth: md,
    exprs: Array::with_capacity(tokens.length() + 4),
    steps: Array::with_capacity(8),
    expr_lists: Array::with_capacity(8),
  }
}

fn Parser::peek(self : Parser) -> Token {
  self.tokens[self.pos]
}

fn Parser::advance(self : Parser) -> Token {
  let t = self.tokens[self.pos]
  if self.pos + 1 < self.tokens.length() {
    self.pos = self.pos + 1
  }
  t
}

fn Parser::push_expr(self : Parser, node : ExprNode) -> Int {
  let id = self.exprs.length()
  self.exprs.push(node)
  id
}

fn Parser::enter(self : Parser, offset : Int) -> Result[Unit, XPathError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(
      XPathError::new(
        XPathErrorKind::LimitExceeded,
        offset,
        "expression nesting depth exceeds max_depth",
      ),
    )
  }
  Ok(())
}

fn Parser::leave(self : Parser) -> Unit {
  self.depth = self.depth - 1
}

fn parse_axis_name(name : String) -> Option[Int] {
  if name == "child" {
    Some(axis_child)
  } else if name == "descendant" {
    Some(axis_descendant)
  } else if name == "parent" {
    Some(axis_parent)
  } else if name == "ancestor" {
    Some(axis_ancestor)
  } else if name == "following-sibling" {
    Some(axis_following_sibling)
  } else if name == "preceding-sibling" {
    Some(axis_preceding_sibling)
  } else if name == "following" {
    Some(axis_following)
  } else if name == "preceding" {
    Some(axis_preceding)
  } else if name == "attribute" {
    Some(axis_attribute)
  } else if name == "namespace" {
    Some(axis_namespace)
  } else if name == "self" {
    Some(axis_self)
  } else if name == "descendant-or-self" {
    Some(axis_descendant_or_self)
  } else if name == "ancestor-or-self" {
    Some(axis_ancestor_or_self)
  } else {
    None
  }
}

fn Parser::parse_expr(self : Parser) -> Result[Int, XPathError] {
  self.parse_or_expr()
}

fn Parser::parse_or_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_and_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_or {
    let _ = self.advance()
    let right = match self.parse_and_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op_or, left, right))
  }
  Ok(left)
}

fn Parser::parse_and_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_eq_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_and {
    let _ = self.advance()
    let right = match self.parse_eq_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op_and, left, right))
  }
  Ok(left)
}

fn Parser::parse_eq_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_rel_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_eq || self.peek().kind == tk_neq {
    let op = if self.advance().kind == tk_eq { op_eq } else { op_neq }
    let right = match self.parse_rel_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op, left, right))
  }
  Ok(left)
}

fn Parser::parse_rel_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_add_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    let k = self.peek().kind
    let op = if k == tk_lt {
      op_lt
    } else if k == tk_le {
      op_le
    } else if k == tk_gt {
      op_gt
    } else if k == tk_ge {
      op_ge
    } else {
      break
    }
    let _ = self.advance()
    let right = match self.parse_add_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op, left, right))
  }
  Ok(left)
}

fn Parser::parse_add_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_mul_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_plus || self.peek().kind == tk_minus {
    let op = if self.advance().kind == tk_plus { op_add } else { op_sub }
    let right = match self.parse_mul_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op, left, right))
  }
  Ok(left)
}

fn Parser::parse_mul_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_unary_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    let k = self.peek().kind
    let op = if k == tk_mul {
      op_mul
    } else if k == tk_div {
      op_div
    } else if k == tk_mod {
      op_mod
    } else {
      break
    }
    let _ = self.advance()
    let right = match self.parse_unary_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::BinOp(op, left, right))
  }
  Ok(left)
}

fn Parser::parse_unary_expr(self : Parser) -> Result[Int, XPathError] {
  let mut neg_count = 0
  while self.peek().kind == tk_minus {
    let _ = self.advance()
    neg_count = neg_count + 1
  }
  let mut expr = match self.parse_union_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while neg_count > 0 {
    expr = self.push_expr(ExprNode::UnaryNeg(expr))
    neg_count = neg_count - 1
  }
  Ok(expr)
}

fn Parser::parse_union_expr(self : Parser) -> Result[Int, XPathError] {
  let mut left = match self.parse_path_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_pipe {
    let _ = self.advance()
    let right = match self.parse_path_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    left = self.push_expr(ExprNode::Union(left, right))
  }
  Ok(left)
}

fn is_primary_start(kind : Int) -> Bool {
  kind == tk_var ||
  kind == tk_lparen ||
  kind == tk_str ||
  kind == tk_num ||
  kind == tk_func
}

fn is_step_start(kind : Int) -> Bool {
  kind == tk_dot ||
  kind == tk_dotdot ||
  kind == tk_at ||
  kind == tk_axis ||
  kind == tk_star ||
  kind == tk_name ||
  kind == tk_qname ||
  kind == tk_ns_star ||
  kind == tk_nodetype
}

fn Parser::parse_path_expr(self : Parser) -> Result[Int, XPathError] {
  let k = self.peek().kind
  if is_primary_start(k) {
    let filter_id = match self.parse_filter_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    if self.peek().kind == tk_slash || self.peek().kind == tk_dslash {
      let local_steps : Array[Step] = []
      while self.peek().kind == tk_slash || self.peek().kind == tk_dslash {
        let is_ds = self.advance().kind == tk_dslash
        if is_ds {
          local_steps.push(
            Step::{
              axis: axis_descendant_or_self,
              test: NodeTest::Node,
              pred_start: 0,
              pred_len: 0,
            },
          )
        }
        match self.parse_step() {
          Ok(st) => local_steps.push(st)
          Err(e) => return Err(e)
        }
      }
      let start = self.steps.length()
      let mut i = 0
      while i < local_steps.length() {
        self.steps.push(local_steps[i])
        i = i + 1
      }
      return Ok(self.push_expr(ExprNode::PathExpr(filter_id, start, local_steps.length())))
    }
    return Ok(filter_id)
  }
  self.parse_location_path()
}

fn Parser::parse_filter_expr(self : Parser) -> Result[Int, XPathError] {
  let primary = match self.parse_primary_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  if self.peek().kind != tk_lbracket {
    return Ok(primary)
  }
  let preds : Array[Int] = []
  while self.peek().kind == tk_lbracket {
    match self.parse_predicate() {
      Ok(p) => preds.push(p)
      Err(e) => return Err(e)
    }
  }
  let start = self.expr_lists.length()
  let mut i = 0
  while i < preds.length() {
    self.expr_lists.push(preds[i])
    i = i + 1
  }
  Ok(self.push_expr(ExprNode::Filter(primary, start, preds.length())))
}

fn Parser::parse_primary_expr(self : Parser) -> Result[Int, XPathError] {
  let tok = self.peek()
  if tok.kind == tk_var {
    let _ = self.advance()
    Ok(self.push_expr(ExprNode::VarRef(tok.s1)))
  } else if tok.kind == tk_str {
    let _ = self.advance()
    Ok(self.push_expr(ExprNode::LitStr(tok.s1)))
  } else if tok.kind == tk_num {
    let _ = self.advance()
    Ok(self.push_expr(ExprNode::LitNum(tok.num)))
  } else if tok.kind == tk_lparen {
    let _ = self.advance()
    match self.enter(tok.offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let inner = match self.parse_expr() {
      Ok(id) => id
      Err(e) => {
        self.leave()
        return Err(e)
      }
    }
    self.leave()
    if self.peek().kind != tk_rparen {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected ')'",
        ),
      )
    }
    let _ = self.advance()
    Ok(inner)
  } else if tok.kind == tk_func {
    let _ = self.advance()
    let fn_name = tok.s1
    if self.peek().kind != tk_lparen {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected '(' after function name",
        ),
      )
    }
    let _ = self.advance()
    match self.enter(tok.offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let args : Array[Int] = []
    if self.peek().kind != tk_rparen {
      while true {
        match self.parse_expr() {
          Ok(a) => args.push(a)
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        if self.peek().kind == tk_comma {
          let _ = self.advance()
        } else {
          break
        }
      }
    }
    self.leave()
    if self.peek().kind != tk_rparen {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected ')' after function arguments",
        ),
      )
    }
    let _ = self.advance()
    let arg_start = self.expr_lists.length()
    let mut i = 0
    while i < args.length() {
      self.expr_lists.push(args[i])
      i = i + 1
    }
    let fn_id = resolve_core_fn_id(fn_name)
    Ok(
      self.push_expr(
        ExprNode::FuncCall(
          FuncCallData::{
            fn_id: fn_id,
            name: fn_name,
            arg_start: arg_start,
            arg_len: args.length(),
          },
        ),
      ),
    )
  } else {
    Err(
      XPathError::new(
        XPathErrorKind::SyntaxError,
        tok.offset,
        "unexpected token in expression",
      ),
    )
  }
}

fn Parser::parse_location_path(self : Parser) -> Result[Int, XPathError] {
  let local_steps : Array[Step] = []
  let mut is_abs = false
  if self.peek().kind == tk_slash {
    is_abs = true
    let _ = self.advance()
    if !is_step_start(self.peek().kind) {
      // Bare "/" selects root node
      return Ok(self.push_expr(ExprNode::LocPath(true, 0, 0)))
    }
  } else if self.peek().kind == tk_dslash {
    is_abs = true
    let _ = self.advance()
    local_steps.push(
      Step::{
        axis: axis_descendant_or_self,
        test: NodeTest::Node,
        pred_start: 0,
        pred_len: 0,
      },
    )
  }
  match self.parse_step() {
    Ok(st) => local_steps.push(st)
    Err(e) => return Err(e)
  }
  while self.peek().kind == tk_slash || self.peek().kind == tk_dslash {
    let is_ds = self.advance().kind == tk_dslash
    if is_ds {
      local_steps.push(
        Step::{
          axis: axis_descendant_or_self,
          test: NodeTest::Node,
          pred_start: 0,
          pred_len: 0,
        },
      )
    }
    match self.parse_step() {
      Ok(st) => local_steps.push(st)
      Err(e) => return Err(e)
    }
  }
  let start = self.steps.length()
  let mut i = 0
  while i < local_steps.length() {
    self.steps.push(local_steps[i])
    i = i + 1
  }
  Ok(self.push_expr(ExprNode::LocPath(is_abs, start, local_steps.length())))
}

fn Parser::parse_step(self : Parser) -> Result[Step, XPathError] {
  let tok = self.peek()
  if tok.kind == tk_dot {
    let _ = self.advance()
    return Ok(Step::{ axis: axis_self, test: NodeTest::Node, pred_start: 0, pred_len: 0 })
  }
  if tok.kind == tk_dotdot {
    let _ = self.advance()
    return Ok(Step::{ axis: axis_parent, test: NodeTest::Node, pred_start: 0, pred_len: 0 })
  }
  let axis = if tok.kind == tk_at {
    let _ = self.advance()
    axis_attribute
  } else if tok.kind == tk_axis {
    let _ = self.advance()
    if self.peek().kind != tk_dcolon {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected '::' after axis name",
        ),
      )
    }
    let _ = self.advance()
    match parse_axis_name(tok.s1) {
      Some(ax) => ax
      None =>
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          tok.offset,
          "unknown axis '" + tok.s1 + "'",
        ),
      )
    }
  } else {
    axis_child
  }
  let test = match self.parse_node_test() {
    Ok(nt) => nt
    Err(e) => return Err(e)
  }
  let preds : Array[Int] = []
  while self.peek().kind == tk_lbracket {
    match self.parse_predicate() {
      Ok(p) => preds.push(p)
      Err(e) => return Err(e)
    }
  }
  let pred_start = self.expr_lists.length()
  let mut i = 0
  while i < preds.length() {
    self.expr_lists.push(preds[i])
    i = i + 1
  }
  Ok(Step::{ axis: axis, test: test, pred_start: pred_start, pred_len: preds.length() })
}

fn Parser::parse_node_test(self : Parser) -> Result[NodeTest, XPathError] {
  let tok = self.peek()
  if tok.kind == tk_star {
    let _ = self.advance()
    Ok(NodeTest::Any)
  } else if tok.kind == tk_name {
    let _ = self.advance()
    Ok(NodeTest::Name(tok.s1))
  } else if tok.kind == tk_qname {
    let _ = self.advance()
    Ok(NodeTest::QName(tok.s1, tok.s2))
  } else if tok.kind == tk_ns_star {
    let _ = self.advance()
    Ok(NodeTest::NsWildcard(tok.s1))
  } else if tok.kind == tk_nodetype {
    let _ = self.advance()
    if self.peek().kind != tk_lparen {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected '(' after node type test",
        ),
      )
    }
    let _ = self.advance()
    let nt = if tok.s1 == "node" {
      NodeTest::Node
    } else if tok.s1 == "text" {
      NodeTest::Text
    } else if tok.s1 == "comment" {
      NodeTest::Comment
    } else {
      // processing-instruction(Literal?)
      if self.peek().kind == tk_str {
        let target = self.advance().s1
        NodeTest::PI(Some(target))
      } else {
        NodeTest::PI(None)
      }
    }
    if self.peek().kind != tk_rparen {
      return Err(
        XPathError::new(
          XPathErrorKind::SyntaxError,
          self.peek().offset,
          "expected ')' after node type test",
        ),
      )
    }
    let _ = self.advance()
    Ok(nt)
  } else {
    Err(
      XPathError::new(
        XPathErrorKind::SyntaxError,
        tok.offset,
        "expected node test",
      ),
    )
  }
}

fn Parser::parse_predicate(self : Parser) -> Result[Int, XPathError] {
  let open = self.advance()
  match self.enter(open.offset) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let expr = match self.parse_expr() {
    Ok(id) => id
    Err(e) => {
      self.leave()
      return Err(e)
    }
  }
  self.leave()
  if self.peek().kind != tk_rbracket {
    return Err(
      XPathError::new(
        XPathErrorKind::SyntaxError,
        self.peek().offset,
        "expected ']' to close predicate",
      ),
    )
  }
  let _ = self.advance()
  Ok(expr)
}

fn xp_compile(src : String, limits : XPathLimits) -> Result[XPathExpr, XPathError] {
  let tokens = match tokenize_xpath(src) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tokens.length() <= 1 {
    return Err(XPathError::new(XPathErrorKind::SyntaxError, 0, "empty XPath expression"))
  }
  let p = Parser::new(tokens, limits)
  let root = match p.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  if p.peek().kind != tk_eof {
    return Err(
      XPathError::new(
        XPathErrorKind::SyntaxError,
        p.peek().offset,
        "unexpected trailing token in XPath expression",
      ),
    )
  }
  Ok(
    XPathExpr::{
      src: src,
      root: root,
      exprs: p.exprs,
      steps: p.steps,
      expr_lists: p.expr_lists,
    },
  )
}
