///| W3C XPath 1.0 IEEE-754 number semantics, string/number conversions, and UTF-8 scalar value helpers.

fn xp_is_nan(x : Double) -> Bool {
  x != x
}

fn xp_is_inf(x : Double) -> Bool {
  x == 1.0 / 0.0 || x == -1.0 / 0.0
}

fn xp_is_finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn xp_is_neg_zero(x : Double) -> Bool {
  x == 0.0 && 1.0 / x < 0.0
}

fn xp_floor(x : Double) -> Double {
  if !xp_is_finite(x) || x == 0.0 {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x < d {
    d - 1.0
  } else {
    d
  }
}

fn xp_ceil(x : Double) -> Double {
  if !xp_is_finite(x) || x == 0.0 {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  if x > -1.0 && x < 0.0 {
    return -0.0
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x > d {
    d + 1.0
  } else {
    d
  }
}

fn xp_trunc(x : Double) -> Double {
  if !xp_is_finite(x) || x == 0.0 {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

///| W3C XPath 1.0 §4.4 `round(number)`:
///| Ties (.5) round toward +Infinity; `-0.5 <= x < 0.0` rounds to `-0.0`.
fn xp_round(x : Double) -> Double {
  if !xp_is_finite(x) || x == 0.0 {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  if x >= -0.5 && x < 0.0 {
    return -0.0
  }
  if x > 0.0 && x < 0.5 {
    return 0.0
  }
  xp_floor(x + 0.5)
}

fn xml_is_ws(b : Int) -> Bool {
  b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D
}

///| Decode a UTF-8 string into Unicode scalar values (codepoints).
fn utf8_to_codepoints(s : String) -> Array[Int] {
  let n = s.length()
  let out : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      out.push(
        ((b0 & 0x07) << 18) |
        ((b1 & 0x3F) << 12) |
        ((b2 & 0x3F) << 6) |
        (b3 & 0x3F),
      )
      i = i + 4
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

///| Count Unicode scalar values in a UTF-8 string without allocating.
fn utf8_codepoint_count(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 0x80 {
      i = i + 1
    } else if (b & 0xE0) == 0xC0 {
      i = i + 2
    } else if (b & 0xF0) == 0xE0 {
      i = i + 3
    } else if (b & 0xF8) == 0xF0 {
      i = i + 4
    } else {
      i = i + 1
    }
    count = count + 1
  }
  count
}

///| Write a single Unicode scalar value as UTF-8 bytes into a `StringBuilder`.
fn sb_write_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}
