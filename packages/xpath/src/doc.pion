///| Zero-copy read-only `XPathDoc` construction and node accessors backed by `xml::Document`.

import "xml"

let xp_xml_ns_uri : String = "http://www.w3.org/XML/1998/namespace"

fn xp_unpack_kind(kind_ns : Int) -> Int {
  kind_ns & 7
}

fn xp_unpack_ns(kind_ns : Int) -> Int {
  (kind_ns >> 3) - 2
}

fn xp_span_to_str(
  doc : xml::Document,
  start : Int,
  end : Int,
) -> String {
  if start < 0 {
    doc.strings[-(start + 1)]
  } else if start == end {
    ""
  } else {
    doc.src.slice(start, end)
  }
}

fn xp_span_eq_str(
  doc : xml::Document,
  start : Int,
  end : Int,
  target : String,
) -> Bool {
  if start < 0 {
    return doc.strings[-(start + 1)] == target
  }
  let len = end - start
  if len != target.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if doc.src.code_unit_at(start + i) != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn xp_ns_uri_str(doc : xml::Document, ns_idx : Int) -> String {
  if ns_idx == -1 {
    ""
  } else if ns_idx == -2 {
    xp_xml_ns_uri
  } else {
    let ns = doc.namespaces[ns_idx]
    xp_span_to_str(doc, ns.uri_span.start, ns.uri_span.end)
  }
}

fn xp_ns_uri_eq(doc : xml::Document, ns_idx : Int, uri : String) -> Bool {
  if ns_idx == -1 {
    uri.length() == 0
  } else if ns_idx == -2 {
    uri == xp_xml_ns_uri
  } else {
    let ns = doc.namespaces[ns_idx]
    xp_span_eq_str(doc, ns.uri_span.start, ns.uri_span.end, uri)
  }
}

fn xp_doc_build(doc : xml::Document) -> XPathDoc {
  let n = doc.nodes.length()
  let subtree_end : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    subtree_end.push(i)
    i = i + 1
  }
  // Single O(N) reverse pass: since `doc.nodes` is strictly pre-order DFS,
  // a node's subtree ends where its last child's subtree ends.
  let mut k = n - 1
  while k >= 0 {
    let lc = doc.nodes[k].last_child
    if lc >= 0 {
      subtree_end[k] = subtree_end[lc]
    }
    k = k - 1
  }

  // Build `id_map` from `xml:id` (priority) and unprefixed `id` attributes.
  let id_map : Map[String, Int] = Map::new()
  let id_from_xml_id : Map[String, Bool] = Map::new()
  i = 0
  while i < n {
    let nd = doc.nodes[i]
    if xp_unpack_kind(nd.kind_ns) == 1 {
      let mut a = nd.attrs_start
      while a < nd.attrs_end {
        let attr = doc.attrs[a]
        if attr.ns_idx == -2 &&
        xp_span_eq_str(doc, attr.local_start, attr.local_end, "id") {
          let id_val = xp_span_to_str(doc, attr.val_start, attr.val_end)
          if id_val.length() > 0 {
            match id_from_xml_id.get(id_val) {
              Some(true) => ()
              _ => {
                id_map.set(id_val, i)
                id_from_xml_id.set(id_val, true)
              }
            }
          }
        } else if attr.ns_idx == -1 &&
        xp_span_eq_str(doc, attr.local_start, attr.local_end, "id") {
          let id_val = xp_span_to_str(doc, attr.val_start, attr.val_end)
          if id_val.length() > 0 {
            match id_map.get(id_val) {
              None => id_map.set(id_val, i)
              Some(_) => ()
            }
          }
        }
        a = a + 1
      }
    }
    i = i + 1
  }

  // Build in-scope namespace node ranges per element.
  // Fast path: if `doc.namespaces` is empty, every element has only the built-in `xml` namespace.
  let ns_entries : Array[XNsEntry] = []
  ns_entries.push(XNsEntry::{ prefix: "xml", uri: xp_xml_ns_uri })
  let elem_ns_start : Array[Int] = []
  let elem_ns_end : Array[Int] = []
  if doc.namespaces.length() > 0 {
    i = 0
    while i < n {
      elem_ns_start.push(0)
      elem_ns_end.push(1)
      i = i + 1
    }
    i = 0
    while i < n {
      let nd = doc.nodes[i]
      if xp_unpack_kind(nd.kind_ns) == 1 {
        let p = nd.parent
        let p_start = if p >= 0 && xp_unpack_kind(doc.nodes[p].kind_ns) == 1 {
          elem_ns_start[p]
        } else {
          0
        }
        let p_end = if p >= 0 && xp_unpack_kind(doc.nodes[p].kind_ns) == 1 {
          elem_ns_end[p]
        } else {
          1
        }
        if nd.ns_start == nd.ns_end {
          // Inherit parent's slice directly with zero allocation!
          elem_ns_start[i] = p_start
          elem_ns_end[i] = p_end
        } else {
          let start = ns_entries.length()
          // Copy parent bindings unless overridden or undeclared by this element
          let mut j = p_start
          while j < p_end {
            let pe = ns_entries[j]
            let mut overridden = false
            let mut d = nd.ns_start
            while d < nd.ns_end {
              let decl = doc.namespaces[d]
              let d_pref = if decl.has_prefix {
                xp_span_to_str(doc, decl.prefix_span.start, decl.prefix_span.end)
              } else {
                ""
              }
              if d_pref == pe.prefix {
                overridden = true
                break
              }
              d = d + 1
            }
            if !overridden {
              ns_entries.push(pe)
            }
            j = j + 1
          }
          // Append this element's own non-empty namespace declarations
          let mut d = nd.ns_start
          while d < nd.ns_end {
            let decl = doc.namespaces[d]
            let d_pref = if decl.has_prefix {
              xp_span_to_str(doc, decl.prefix_span.start, decl.prefix_span.end)
            } else {
              ""
            }
            let d_uri = xp_span_to_str(doc, decl.uri_span.start, decl.uri_span.end)
            if d_uri.length() > 0 && d_pref != "xml" {
              ns_entries.push(XNsEntry::{ prefix: d_pref, uri: d_uri })
            }
            d = d + 1
          }
          elem_ns_start[i] = start
          elem_ns_end[i] = ns_entries.length()
        }
      }
      i = i + 1
    }
  }

  XPathDoc::{
    doc: doc,
    subtree_end: subtree_end,
    ns_entries: ns_entries,
    elem_ns_start: elem_ns_start,
    elem_ns_end: elem_ns_end,
    id_map: id_map,
  }
}

fn xp_doc_ns_range(doc : XPathDoc, elem_id : Int) -> (Int, Int) {
  if doc.elem_ns_start.length() == 0 {
    (0, 1)
  } else {
    (doc.elem_ns_start[elem_id], doc.elem_ns_end[elem_id])
  }
}

fn xp_doc_node_name(xdoc : XPathDoc, node : XNode) -> String {
  let doc = xdoc.doc
  if node.kind == 1 {
    let nd = doc.nodes[node.node_id]
    let local = xp_span_to_str(doc, nd.s1_start, nd.s1_end)
    if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
      local
    } else {
      xp_span_to_str(doc, nd.s2_start, nd.s2_end) + ":" + local
    }
  } else if node.kind == 5 {
    let a = doc.attrs[node.sub_id]
    let local = xp_span_to_str(doc, a.local_start, a.local_end)
    if a.prefix_start >= 0 && a.prefix_start == a.prefix_end {
      local
    } else {
      xp_span_to_str(doc, a.prefix_start, a.prefix_end) + ":" + local
    }
  } else if node.kind == 4 {
    let nd = doc.nodes[node.node_id]
    xp_span_to_str(doc, nd.s1_start, nd.s1_end)
  } else if node.kind == 6 {
    xdoc.ns_entries[node.sub_id].prefix
  } else {
    ""
  }
}

fn xp_doc_local_name(xdoc : XPathDoc, node : XNode) -> String {
  let doc = xdoc.doc
  if node.kind == 1 || node.kind == 4 {
    let nd = doc.nodes[node.node_id]
    xp_span_to_str(doc, nd.s1_start, nd.s1_end)
  } else if node.kind == 5 {
    let a = doc.attrs[node.sub_id]
    xp_span_to_str(doc, a.local_start, a.local_end)
  } else if node.kind == 6 {
    xdoc.ns_entries[node.sub_id].prefix
  } else {
    ""
  }
}

fn xp_doc_namespace_uri(xdoc : XPathDoc, node : XNode) -> String {
  let doc = xdoc.doc
  if node.kind == 1 {
    let nd = doc.nodes[node.node_id]
    xp_ns_uri_str(doc, xp_unpack_ns(nd.kind_ns))
  } else if node.kind == 5 {
    let a = doc.attrs[node.sub_id]
    xp_ns_uri_str(doc, a.ns_idx)
  } else {
    ""
  }
}

fn xp_doc_string_value(xdoc : XPathDoc, node : XNode) -> String {
  let doc = xdoc.doc
  if node.kind == 2 || node.kind == 3 {
    let nd = doc.nodes[node.node_id]
    return xp_span_to_str(doc, nd.s1_start, nd.s1_end)
  }
  if node.kind == 4 {
    let nd = doc.nodes[node.node_id]
    if xp_unpack_ns(nd.kind_ns) != 0 {
      return xp_span_to_str(doc, nd.s2_start, nd.s2_end)
    } else {
      return ""
    }
  }
  if node.kind == 5 {
    let a = doc.attrs[node.sub_id]
    return xp_span_to_str(doc, a.val_start, a.val_end)
  }
  if node.kind == 6 {
    return xdoc.ns_entries[node.sub_id].uri
  }
  // Root (0) or Element (1): concatenation of all descendant Text nodes in document order.
  // Fast path: single text child (very common for leaf elements like <price>19.99</price>).
  let nd = doc.nodes[node.node_id]
  let fc = nd.first_child
  if fc < 0 {
    return ""
  }
  if fc == nd.last_child && xp_unpack_kind(doc.nodes[fc].kind_ns) == 2 {
    let fnd = doc.nodes[fc]
    return xp_span_to_str(doc, fnd.s1_start, fnd.s1_end)
  }
  let end_id = xdoc.subtree_end[node.node_id]
  let sb = StringBuilder::new()
  let mut cur = node.node_id + 1
  while cur <= end_id {
    let cnd = doc.nodes[cur]
    if xp_unpack_kind(cnd.kind_ns) == 2 {
      if cnd.s1_start < 0 {
        sb.write_string(doc.strings[-(cnd.s1_start + 1)])
      } else if cnd.s1_start < cnd.s1_end {
        sb.write_string(doc.src.slice(cnd.s1_start, cnd.s1_end))
      }
    }
    cur = cur + 1
  }
  sb.to_string()
}

fn xp_doc_parent(xdoc : XPathDoc, node : XNode) -> Option[XNode] {
  if node.kind == 5 || node.kind == 6 {
    return Some(XNode::{ kind: 1, node_id: node.node_id, sub_id: -1 })
  }
  let p = xdoc.doc.nodes[node.node_id].parent
  if p >= 0 {
    let pk = xp_unpack_kind(xdoc.doc.nodes[p].kind_ns)
    Some(XNode::{ kind: pk, node_id: p, sub_id: -1 })
  } else {
    None
  }
}
