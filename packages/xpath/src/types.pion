///| Public types, errors, limits, document view, values, context, and compiled expression API for `xpath`.

import "xml"

///| Categories of XPath 1.0 parsing and evaluation errors.
pub enum XPathErrorKind {
  XmlParseError
  LexError
  SyntaxError
  UnknownFunction
  InvalidArity
  UnboundVariable
  UnboundNamespacePrefix
  TypeError
  LimitExceeded
  Unimplemented
}

///|
pub fn XPathErrorKind::eq(self : XPathErrorKind, other : XPathErrorKind) -> Bool {
  match (self, other) {
    (XPathErrorKind::XmlParseError, XPathErrorKind::XmlParseError) => true
    (XPathErrorKind::LexError, XPathErrorKind::LexError) => true
    (XPathErrorKind::SyntaxError, XPathErrorKind::SyntaxError) => true
    (XPathErrorKind::UnknownFunction, XPathErrorKind::UnknownFunction) => true
    (XPathErrorKind::InvalidArity, XPathErrorKind::InvalidArity) => true
    (XPathErrorKind::UnboundVariable, XPathErrorKind::UnboundVariable) => true
    (
      XPathErrorKind::UnboundNamespacePrefix,
      XPathErrorKind::UnboundNamespacePrefix,
    ) => true
    (XPathErrorKind::TypeError, XPathErrorKind::TypeError) => true
    (XPathErrorKind::LimitExceeded, XPathErrorKind::LimitExceeded) => true
    (XPathErrorKind::Unimplemented, XPathErrorKind::Unimplemented) => true
    _ => false
  }
}

///| Structured XPath 1.0 error with byte offset and diagnostic message.
pub struct XPathError {
  pub kind : XPathErrorKind
  pub offset : Int
  pub message : String
}

///|
pub fn XPathError::new(
  kind : XPathErrorKind,
  offset : Int,
  message : String,
) -> XPathError {
  XPathError::{ kind: kind, offset: offset, message: message }
}

///|
pub fn XPathError::is_kind(self : XPathError, kind : XPathErrorKind) -> Bool {
  self.kind.eq(kind)
}

///|
pub fn XPathError::to_string(self : XPathError) -> String {
  self.message + " (offset " + self.offset.to_string() + ")"
}

///| Resource and DoS safety limits enforced during parsing and evaluation.
pub struct XPathLimits {
  pub max_depth : Int
  pub max_steps : Int64
  pub max_nodes : Int
  pub max_output_bytes : Int
}

///|
pub fn XPathLimits::default() -> XPathLimits {
  XPathLimits::{
    max_depth: 128,
    max_steps: 1000000L,
    max_nodes: 200000,
    max_output_bytes: 16777216,
  }
}

///|
pub fn XPathLimits::new(
  max_depth : Int,
  max_steps : Int64,
  max_nodes : Int,
  max_output_bytes : Int,
) -> XPathLimits {
  XPathLimits::{
    max_depth: max_depth,
    max_steps: max_steps,
    max_nodes: max_nodes,
    max_output_bytes: max_output_bytes,
  }
}

///| The 7 node kinds in the W3C XPath 1.0 data model.
pub enum XNodeKind {
  Root
  Element
  Text
  Comment
  ProcessingInstruction
  Attribute
  Namespace
}

///|
pub fn XNodeKind::eq(self : XNodeKind, other : XNodeKind) -> Bool {
  match (self, other) {
    (XNodeKind::Root, XNodeKind::Root) => true
    (XNodeKind::Element, XNodeKind::Element) => true
    (XNodeKind::Text, XNodeKind::Text) => true
    (XNodeKind::Comment, XNodeKind::Comment) => true
    (XNodeKind::ProcessingInstruction, XNodeKind::ProcessingInstruction) => true
    (XNodeKind::Attribute, XNodeKind::Attribute) => true
    (XNodeKind::Namespace, XNodeKind::Namespace) => true
    _ => false
  }
}

///| Compact value handle to an XPath 1.0 node inside an `XPathDoc`.
///| - `kind`: 0=Root, 1=Element, 2=Text, 3=Comment, 4=PI, 5=Attribute, 6=Namespace
///| - `node_id`: `xml::Document` node id (or owner element id for Attribute/Namespace)
///| - `sub_id`: attribute index / namespace table index (`-1` for tree nodes)
pub val struct XNode {
  pub kind : Int
  pub node_id : Int
  pub sub_id : Int
}

///|
pub fn XNode::eq(self : XNode, other : XNode) -> Bool {
  self.kind == other.kind &&
  self.node_id == other.node_id &&
  self.sub_id == other.sub_id
}

///|
pub fn XNode::node_kind(self : XNode) -> XNodeKind {
  if self.kind == 0 {
    XNodeKind::Root
  } else if self.kind == 1 {
    XNodeKind::Element
  } else if self.kind == 2 {
    XNodeKind::Text
  } else if self.kind == 3 {
    XNodeKind::Comment
  } else if self.kind == 4 {
    XNodeKind::ProcessingInstruction
  } else if self.kind == 5 {
    XNodeKind::Attribute
  } else {
    XNodeKind::Namespace
  }
}

///| Compare two `XNode` handles in W3C XPath 1.0 document order.
///| Returns `-1` if `self < other`, `0` if equal, `1` if `self > other`.
pub fn XNode::cmp_doc_order(self : XNode, other : XNode) -> Int {
  if self.node_id != other.node_id {
    if self.node_id < other.node_id {
      return -1
    } else {
      return 1
    }
  }
  let p1 = if self.kind <= 4 {
    0
  } else if self.kind == 6 {
    1
  } else {
    2
  }
  let p2 = if other.kind <= 4 {
    0
  } else if other.kind == 6 {
    1
  } else {
    2
  }
  if p1 != p2 {
    if p1 < p2 {
      return -1
    } else {
      return 1
    }
  }
  if self.sub_id < other.sub_id {
    -1
  } else if self.sub_id > other.sub_id {
    1
  } else {
    0
  }
}

///| Precomputed in-scope namespace node entry for an element.
pub struct XNsEntry {
  pub prefix : String
  pub uri : String
}

///| Immutable read-only XPath 1.0 document view backed by `xml::Document`.
pub struct XPathDoc {
  pub doc : xml::Document
  pub subtree_end : Array[Int]
  pub ns_entries : Array[XNsEntry]
  pub elem_ns_start : Array[Int]
  pub elem_ns_end : Array[Int]
  pub id_map : Map[String, Int]
}

///|
pub fn XPathDoc::parse(src : String) -> Result[XPathDoc, XPathError] {
  let _ = src
  Err(XPathError::new(XPathErrorKind::Unimplemented, 0, "unimplemented"))
}

///|
pub fn XPathDoc::from_document(doc : xml::Document) -> XPathDoc {
  XPathDoc::{
    doc: doc,
    subtree_end: [],
    ns_entries: [],
    elem_ns_start: [],
    elem_ns_end: [],
    id_map: Map::new(),
  }
}

///|
pub fn XPathDoc::root(self : XPathDoc) -> XNode {
  let _ = self
  XNode::{ kind: 0, node_id: 0, sub_id: -1 }
}

///|
pub fn XPathDoc::root_element(self : XPathDoc) -> XNode {
  XNode::{ kind: 1, node_id: self.doc.root_elem_id, sub_id: -1 }
}

///|
pub fn XPathDoc::node_count(self : XPathDoc) -> Int {
  self.doc.node_count()
}

///|
pub fn XPathDoc::node_kind(self : XPathDoc, node : XNode) -> XNodeKind {
  let _ = self
  node.node_kind()
}

///|
pub fn XPathDoc::node_name(self : XPathDoc, node : XNode) -> String {
  let _ = self
  let _ = node
  ""
}

///|
pub fn XPathDoc::local_name(self : XPathDoc, node : XNode) -> String {
  let _ = self
  let _ = node
  ""
}

///|
pub fn XPathDoc::namespace_uri(self : XPathDoc, node : XNode) -> String {
  let _ = self
  let _ = node
  ""
}

///|
pub fn XPathDoc::string_value(self : XPathDoc, node : XNode) -> String {
  let _ = self
  let _ = node
  ""
}

///|
pub fn XPathDoc::parent(self : XPathDoc, node : XNode) -> Option[XNode] {
  let _ = self
  let _ = node
  None
}

///| The 4 W3C XPath 1.0 value types.
pub enum XPathValue {
  NodeSet(Array[XNode])
  Boolean(Bool)
  Number(Double)
  Str(String)
}

///|
pub fn XPathValue::as_nodes(self : XPathValue) -> Option[Array[XNode]] {
  match self {
    XPathValue::NodeSet(ns) => Some(ns)
    _ => None
  }
}

///|
pub fn XPathValue::as_bool(self : XPathValue) -> Option[Bool] {
  match self {
    XPathValue::Boolean(b) => Some(b)
    _ => None
  }
}

///|
pub fn XPathValue::as_number(self : XPathValue) -> Option[Double] {
  match self {
    XPathValue::Number(n) => Some(n)
    _ => None
  }
}

///|
pub fn XPathValue::as_string(self : XPathValue) -> Option[String] {
  match self {
    XPathValue::Str(s) => Some(s)
    _ => None
  }
}

///|
pub fn XPathValue::to_bool(self : XPathValue) -> Bool {
  let _ = self
  false
}

///|
pub fn XPathValue::to_string(self : XPathValue, doc : XPathDoc) -> String {
  let _ = self
  let _ = doc
  ""
}

///|
pub fn XPathValue::to_number(self : XPathValue, doc : XPathDoc) -> Double {
  let _ = self
  let _ = doc
  0.0 / 0.0
}

///| Evaluation context carrying namespace bindings, variables, and limits.
pub struct XPathContext {
  pub namespaces : Map[String, String]
  pub variables : Map[String, XPathValue]
  pub limits : XPathLimits
}

///|
pub fn XPathContext::new() -> XPathContext {
  XPathContext::{
    namespaces: Map::new(),
    variables: Map::new(),
    limits: XPathLimits::default(),
  }
}

///|
pub fn XPathContext::with_namespace(
  self : XPathContext,
  prefix : String,
  uri : String,
) -> XPathContext {
  let ns = self.namespaces
  ns.set(prefix, uri)
  XPathContext::{ namespaces: ns, variables: self.variables, limits: self.limits }
}

///|
pub fn XPathContext::with_variable(
  self : XPathContext,
  name : String,
  value : XPathValue,
) -> XPathContext {
  let vars = self.variables
  vars.set(name, value)
  XPathContext::{ namespaces: self.namespaces, variables: vars, limits: self.limits }
}

///|
pub fn XPathContext::with_limits(
  self : XPathContext,
  limits : XPathLimits,
) -> XPathContext {
  XPathContext::{
    namespaces: self.namespaces,
    variables: self.variables,
    limits: limits,
  }
}

///| Compiled XPath 1.0 expression (parse once, evaluate repeatedly).
pub struct XPathExpr {
  pub src : String
  pub root : Int
}

///|
pub fn XPathExpr::parse(src : String) -> Result[XPathExpr, XPathError] {
  XPathExpr::parse_with_limits(src, XPathLimits::default())
}

///|
pub fn XPathExpr::parse_with_limits(
  src : String,
  limits : XPathLimits,
) -> Result[XPathExpr, XPathError] {
  let _ = src
  let _ = limits
  Err(XPathError::new(XPathErrorKind::Unimplemented, 0, "unimplemented"))
}

///|
pub fn XPathExpr::eval(
  self : XPathExpr,
  doc : XPathDoc,
) -> Result[XPathValue, XPathError] {
  self.eval_with(doc, doc.root(), XPathContext::new())
}

///|
pub fn XPathExpr::eval_with(
  self : XPathExpr,
  doc : XPathDoc,
  node : XNode,
  ctx : XPathContext,
) -> Result[XPathValue, XPathError] {
  let _ = self
  let _ = doc
  let _ = node
  let _ = ctx
  Err(XPathError::new(XPathErrorKind::Unimplemented, 0, "unimplemented"))
}

///|
pub fn XPathExpr::eval_nodes(
  self : XPathExpr,
  doc : XPathDoc,
) -> Result[Array[XNode], XPathError] {
  match self.eval(doc) {
    Ok(XPathValue::NodeSet(ns)) => Ok(ns)
    Ok(_) =>
    Err(
      XPathError::new(
        XPathErrorKind::TypeError,
        0,
        "expected node-set result",
      ),
    )
    Err(e) => Err(e)
  }
}

///|
pub fn XPathExpr::eval_string(
  self : XPathExpr,
  doc : XPathDoc,
) -> Result[String, XPathError] {
  match self.eval(doc) {
    Ok(v) => Ok(v.to_string(doc))
    Err(e) => Err(e)
  }
}

///|
pub fn XPathExpr::eval_number(
  self : XPathExpr,
  doc : XPathDoc,
) -> Result[Double, XPathError] {
  match self.eval(doc) {
    Ok(v) => Ok(v.to_number(doc))
    Err(e) => Err(e)
  }
}

///|
pub fn XPathExpr::eval_bool(
  self : XPathExpr,
  doc : XPathDoc,
) -> Result[Bool, XPathError] {
  match self.eval(doc) {
    Ok(v) => Ok(v.to_bool())
    Err(e) => Err(e)
  }
}

///| Parse an XPath 1.0 expression string into a reusable compiled `XPathExpr`.
pub fn parse(src : String) -> Result[XPathExpr, XPathError] {
  XPathExpr::parse(src)
}

///| Compile and evaluate an XPath 1.0 expression against a document root.
pub fn eval(doc : XPathDoc, expr : String) -> Result[XPathValue, XPathError] {
  match XPathExpr::parse(expr) {
    Ok(compiled) => compiled.eval(doc)
    Err(e) => Err(e)
  }
}

///| Compile and evaluate an XPath 1.0 expression with explicit context node and `XPathContext`.
pub fn eval_with(
  doc : XPathDoc,
  node : XNode,
  expr : String,
  ctx : XPathContext,
) -> Result[XPathValue, XPathError] {
  match XPathExpr::parse_with_limits(expr, ctx.limits) {
    Ok(compiled) => compiled.eval_with(doc, node, ctx)
    Err(e) => Err(e)
  }
}

///| Parse XML and evaluate an XPath 1.0 expression in one call.
pub fn eval_str(
  xml_src : String,
  expr : String,
) -> Result[XPathValue, XPathError] {
  match XPathDoc::parse(xml_src) {
    Ok(doc) => eval(doc, expr)
    Err(e) => Err(e)
  }
}

///|
pub fn eval_string(doc : XPathDoc, expr : String) -> Result[String, XPathError] {
  match XPathExpr::parse(expr) {
    Ok(compiled) => compiled.eval_string(doc)
    Err(e) => Err(e)
  }
}

///|
pub fn eval_number(doc : XPathDoc, expr : String) -> Result[Double, XPathError] {
  match XPathExpr::parse(expr) {
    Ok(compiled) => compiled.eval_number(doc)
    Err(e) => Err(e)
  }
}

///|
pub fn eval_bool(doc : XPathDoc, expr : String) -> Result[Bool, XPathError] {
  match XPathExpr::parse(expr) {
    Ok(compiled) => compiled.eval_bool(doc)
    Err(e) => Err(e)
  }
}

///|
pub fn eval_nodes(
  doc : XPathDoc,
  expr : String,
) -> Result[Array[XNode], XPathError] {
  match XPathExpr::parse(expr) {
    Ok(compiled) => compiled.eval_nodes(doc)
    Err(e) => Err(e)
  }
}
