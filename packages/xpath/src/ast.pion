///| Flat-arena AST representation for compiled XPath 1.0 expressions.

// Axis constants (0..7 forward, 8..12 reverse)
let axis_child : Int = 0

let axis_descendant : Int = 1

let axis_following_sibling : Int = 2

let axis_following : Int = 3

let axis_attribute : Int = 4

let axis_namespace : Int = 5

let axis_self : Int = 6

let axis_descendant_or_self : Int = 7

let axis_parent : Int = 8

let axis_ancestor : Int = 9

let axis_preceding_sibling : Int = 10

let axis_preceding : Int = 11

let axis_ancestor_or_self : Int = 12

fn axis_is_reverse(axis : Int) -> Bool {
  axis >= axis_parent
}

// Binary operator constants
let op_or : Int = 0

let op_and : Int = 1

let op_eq : Int = 2

let op_neq : Int = 3

let op_lt : Int = 4

let op_le : Int = 5

let op_gt : Int = 6

let op_ge : Int = 7

let op_add : Int = 8

let op_sub : Int = 9

let op_mul : Int = 10

let op_div : Int = 11

let op_mod : Int = 12

// Core 27 function IDs (-1 = unknown)
let fn_last : Int = 0

let fn_position : Int = 1

let fn_count : Int = 2

let fn_id : Int = 3

let fn_local_name : Int = 4

let fn_namespace_uri : Int = 5

let fn_name : Int = 6

let fn_string : Int = 7

let fn_concat : Int = 8

let fn_starts_with : Int = 9

let fn_contains : Int = 10

let fn_substring_before : Int = 11

let fn_substring_after : Int = 12

let fn_substring : Int = 13

let fn_string_length : Int = 14

let fn_normalize_space : Int = 15

let fn_translate : Int = 16

let fn_boolean : Int = 17

let fn_not : Int = 18

let fn_true : Int = 19

let fn_false : Int = 20

let fn_lang : Int = 21

let fn_number : Int = 22

let fn_sum : Int = 23

let fn_floor : Int = 24

let fn_ceiling : Int = 25

let fn_round : Int = 26

fn resolve_core_fn_id(name : String) -> Int {
  if name == "last" {
    fn_last
  } else if name == "position" {
    fn_position
  } else if name == "count" {
    fn_count
  } else if name == "id" {
    fn_id
  } else if name == "local-name" {
    fn_local_name
  } else if name == "namespace-uri" {
    fn_namespace_uri
  } else if name == "name" {
    fn_name
  } else if name == "string" {
    fn_string
  } else if name == "concat" {
    fn_concat
  } else if name == "starts-with" {
    fn_starts_with
  } else if name == "contains" {
    fn_contains
  } else if name == "substring-before" {
    fn_substring_before
  } else if name == "substring-after" {
    fn_substring_after
  } else if name == "substring" {
    fn_substring
  } else if name == "string-length" {
    fn_string_length
  } else if name == "normalize-space" {
    fn_normalize_space
  } else if name == "translate" {
    fn_translate
  } else if name == "boolean" {
    fn_boolean
  } else if name == "not" {
    fn_not
  } else if name == "true" {
    fn_true
  } else if name == "false" {
    fn_false
  } else if name == "lang" {
    fn_lang
  } else if name == "number" {
    fn_number
  } else if name == "sum" {
    fn_sum
  } else if name == "floor" {
    fn_floor
  } else if name == "ceiling" {
    fn_ceiling
  } else if name == "round" {
    fn_round
  } else {
    -1
  }
}

///| NodeTest in a location step.
pub enum NodeTest {
  Any
  Name(String)
  QName(String, String)
  NsWildcard(String)
  Node
  Text
  Comment
  PI(Option[String])
}

///| A single location step stored in the compiled `XPathExpr` step arena.
pub struct Step {
  pub axis : Int
  pub test : NodeTest
  pub pred_start : Int
  pub pred_len : Int
}

///| Payload for a function call AST node.
pub struct FuncCallData {
  pub fn_id : Int
  pub name : String
  pub arg_start : Int
  pub arg_len : Int
}

///| Flat AST node stored in `XPathExpr.exprs`.
pub enum ExprNode {
  LitStr(String)
  LitNum(Double)
  VarRef(String)
  FuncCall(FuncCallData)
  UnaryNeg(Int)
  BinOp(Int, Int, Int)
  Union(Int, Int)
  LocPath(Bool, Int, Int)
  Filter(Int, Int, Int)
  PathExpr(Int, Int, Int)
}
