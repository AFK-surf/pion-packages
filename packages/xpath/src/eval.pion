///| W3C XPath 1.0 evaluator: all 13 axes, NodeTests, predicates, operators, and 27 core functions.

struct EvalEnv {
  doc : XPathDoc
  expr : XPathExpr
  ctx : XPathContext
  max_depth : Int
  max_nodes : Int
  max_output_bytes : Int
  mut steps_left : Int64
  mut depth : Int
}

fn EvalEnv::new(doc : XPathDoc, expr : XPathExpr, ctx : XPathContext) -> EvalEnv {
  let md = if ctx.limits.max_depth < 1 {
    1
  } else if ctx.limits.max_depth > 128 {
    128
  } else {
    ctx.limits.max_depth
  }
  EvalEnv::{
    doc: doc,
    expr: expr,
    ctx: ctx,
    max_depth: md,
    max_nodes: ctx.limits.max_nodes,
    max_output_bytes: ctx.limits.max_output_bytes,
    steps_left: ctx.limits.max_steps,
    depth: 0,
  }
}

fn EvalEnv::tick(self : EvalEnv) -> Result[Unit, XPathError] {
  self.steps_left = self.steps_left - 1L
  if self.steps_left < 0L {
    return Err(
      XPathError::new(
        XPathErrorKind::LimitExceeded,
        0,
        "evaluation step budget exceeded",
      ),
    )
  }
  Ok(())
}

fn EvalEnv::check_nodes(self : EvalEnv, count : Int) -> Result[Unit, XPathError] {
  if count > self.max_nodes {
    return Err(
      XPathError::new(
        XPathErrorKind::LimitExceeded,
        0,
        "node-set size exceeds max_nodes",
      ),
    )
  }
  Ok(())
}

fn EvalEnv::enter(self : EvalEnv) -> Result[Unit, XPathError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(
      XPathError::new(
        XPathErrorKind::LimitExceeded,
        0,
        "evaluation recursion depth exceeds max_depth",
      ),
    )
  }
  Ok(())
}

fn EvalEnv::leave(self : EvalEnv) -> Unit {
  self.depth = self.depth - 1
}

///| Resolve a namespace prefix from `XPathContext` (plus built-in `xml`).
fn EvalEnv::resolve_ns(self : EvalEnv, prefix : String) -> Result[String, XPathError] {
  match self.ctx.namespaces.get(prefix) {
    Some(uri) => Ok(uri)
    None =>
    if prefix == "xml" {
      Ok(xp_xml_ns_uri)
    } else {
      Err(
        XPathError::new(
          XPathErrorKind::UnboundNamespacePrefix,
          0,
          "unbound namespace prefix '" + prefix + "'",
        ),
      )
    }
  }
}

///| Reverse an `Array[XNode]` in-place.
fn reverse_nodes(arr : Array[XNode]) -> Unit {
  let mut lo = 0
  let mut hi = arr.length() - 1
  while lo < hi {
    let tmp = arr[lo]
    arr[lo] = arr[hi]
    arr[hi] = tmp
    lo = lo + 1
    hi = hi - 1
  }
}

///| Iterative heapsort + in-place deduplication of `Array[XNode]` in document order.
fn sort_dedup_nodes(arr : Array[XNode]) -> Array[XNode] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  // Check if already strictly sorted (common fast path)
  let mut strictly_sorted = true
  let mut i = 1
  while i < n {
    if arr[i - 1].cmp_doc_order(arr[i]) >= 0 {
      strictly_sorted = false
      break
    }
    i = i + 1
  }
  if strictly_sorted {
    return arr
  }
  // Build max-heap
  let mut start = n / 2 - 1
  while start >= 0 {
    sift_down_nodes(arr, start, n)
    start = start - 1
  }
  // Extract elements
  let mut end = n - 1
  while end > 0 {
    let tmp = arr[0]
    arr[0] = arr[end]
    arr[end] = tmp
    sift_down_nodes(arr, 0, end)
    end = end - 1
  }
  // Deduplicate into compacted array
  let out : Array[XNode] = Array::with_capacity(n)
  out.push(arr[0])
  i = 1
  while i < n {
    if !arr[i].eq(arr[i - 1]) {
      out.push(arr[i])
    }
    i = i + 1
  }
  out
}

fn sift_down_nodes(arr : Array[XNode], root_in : Int, end : Int) -> Unit {
  let mut root = root_in
  while root * 2 + 1 < end {
    let mut child = root * 2 + 1
    if child + 1 < end && arr[child].cmp_doc_order(arr[child + 1]) < 0 {
      child = child + 1
    }
    if arr[root].cmp_doc_order(arr[child]) < 0 {
      let tmp = arr[root]
      arr[root] = arr[child]
      arr[child] = tmp
      root = child
    } else {
      break
    }
  }
}

///| Merge two already-sorted, deduplicated `Array[XNode]` into a single sorted, deduplicated array.
fn union_sorted_nodes(a : Array[XNode], b : Array[XNode]) -> Array[XNode] {
  let na = a.length()
  let nb = b.length()
  if na == 0 {
    return b
  }
  if nb == 0 {
    return a
  }
  let out : Array[XNode] = Array::with_capacity(na + nb)
  let mut i = 0
  let mut j = 0
  while i < na && j < nb {
    let c = a[i].cmp_doc_order(b[j])
    if c < 0 {
      out.push(a[i])
      i = i + 1
    } else if c > 0 {
      out.push(b[j])
      j = j + 1
    } else {
      out.push(a[i])
      i = i + 1
      j = j + 1
    }
  }
  while i < na {
    out.push(a[i])
    i = i + 1
  }
  while j < nb {
    out.push(b[j])
    j = j + 1
  }
  out
}

///| Match a `NodeTest` against a candidate `XNode` given the axis's principal node kind
///| (`1` for element, `5` for attribute, `6` for namespace) and pre-resolved namespace URI (if any).
fn match_node_test(
  xdoc : XPathDoc,
  node : XNode,
  principal_kind : Int,
  test : NodeTest,
  resolved_ns : String,
) -> Bool {
  match test {
    NodeTest::Node => true
    NodeTest::Text => node.kind == 2
    NodeTest::Comment => node.kind == 3
    NodeTest::PI(target_opt) => {
      if node.kind != 4 {
        return false
      }
      match target_opt {
        None => true
        Some(target) => {
          let nd = xdoc.doc.nodes[node.node_id]
          xp_span_eq_str(xdoc.doc, nd.s1_start, nd.s1_end, target)
        }
      }
    }
    NodeTest::Any => node.kind == principal_kind
    NodeTest::Name(local) => {
      if node.kind != principal_kind {
        return false
      }
      if principal_kind == 1 {
        let nd = xdoc.doc.nodes[node.node_id]
        xp_unpack_ns(nd.kind_ns) == -1 &&
        xp_span_eq_str(xdoc.doc, nd.s1_start, nd.s1_end, local)
      } else if principal_kind == 5 {
        let a = xdoc.doc.attrs[node.sub_id]
        a.ns_idx == -1 &&
        xp_span_eq_str(xdoc.doc, a.local_start, a.local_end, local)
      } else {
        xdoc.ns_entries[node.sub_id].prefix == local
      }
    }
    NodeTest::QName(_, local) => {
      if node.kind != principal_kind {
        return false
      }
      if principal_kind == 1 {
        let nd = xdoc.doc.nodes[node.node_id]
        xp_ns_uri_eq(xdoc.doc, xp_unpack_ns(nd.kind_ns), resolved_ns) &&
        xp_span_eq_str(xdoc.doc, nd.s1_start, nd.s1_end, local)
      } else if principal_kind == 5 {
        let a = xdoc.doc.attrs[node.sub_id]
        xp_ns_uri_eq(xdoc.doc, a.ns_idx, resolved_ns) &&
        xp_span_eq_str(xdoc.doc, a.local_start, a.local_end, local)
      } else {
        false
      }
    }
    NodeTest::NsWildcard(_) => {
      if node.kind != principal_kind {
        return false
      }
      if principal_kind == 1 {
        let nd = xdoc.doc.nodes[node.node_id]
        xp_ns_uri_eq(xdoc.doc, xp_unpack_ns(nd.kind_ns), resolved_ns)
      } else if principal_kind == 5 {
        let a = xdoc.doc.attrs[node.sub_id]
        xp_ns_uri_eq(xdoc.doc, a.ns_idx, resolved_ns)
      } else {
        false
      }
    }
  }
}

///| Collect candidate nodes from `origin` along `axis` matching `test` into `out`.
///| Forward axes emit in ascending document order; reverse axes emit in reverse document order.
fn EvalEnv::collect_axis(
  self : EvalEnv,
  origin : XNode,
  axis : Int,
  test : NodeTest,
  resolved_ns : String,
  out : Array[XNode],
) -> Result[Unit, XPathError] {
  let xdoc = self.doc
  let doc = xdoc.doc
  let principal_kind = if axis == axis_attribute {
    5
  } else if axis == axis_namespace {
    6
  } else {
    1
  }
  if axis == axis_child {
    if origin.kind != 0 && origin.kind != 1 {
      return Ok(())
    }
    let mut cur = doc.nodes[origin.node_id].first_child
    while cur >= 0 {
      match self.tick() {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let nd = doc.nodes[cur]
      let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
      if match_node_test(xdoc, cand, 1, test, resolved_ns) {
        out.push(cand)
        match self.check_nodes(out.length()) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      cur = nd.next_sibling
    }
  } else if axis == axis_descendant || axis == axis_descendant_or_self {
    if axis == axis_descendant_or_self {
      match self.tick() {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if match_node_test(xdoc, origin, 1, test, resolved_ns) {
        out.push(origin)
        match self.check_nodes(out.length()) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    }
    if origin.kind == 0 || origin.kind == 1 {
      let end_id = xdoc.subtree_end[origin.node_id]
      let mut cur = origin.node_id + 1
      while cur <= end_id {
        match self.tick() {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let nd = doc.nodes[cur]
        let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
        if match_node_test(xdoc, cand, 1, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
        cur = cur + 1
      }
    }
  } else if axis == axis_self {
    match self.tick() {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    if match_node_test(xdoc, origin, 1, test, resolved_ns) {
      out.push(origin)
    }
  } else if axis == axis_parent {
    match self.tick() {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    match xp_doc_parent(xdoc, origin) {
      Some(p) =>
      if match_node_test(xdoc, p, 1, test, resolved_ns) {
        out.push(p)
      }
      None => ()
    }
  } else if axis == axis_ancestor || axis == axis_ancestor_or_self {
    if axis == axis_ancestor_or_self {
      match self.tick() {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if match_node_test(xdoc, origin, 1, test, resolved_ns) {
        out.push(origin)
      }
    }
    let mut cur_opt = xp_doc_parent(xdoc, origin)
    while true {
      match cur_opt {
        None => break
        Some(p) => {
          match self.tick() {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
          if match_node_test(xdoc, p, 1, test, resolved_ns) {
            out.push(p)
            match self.check_nodes(out.length()) {
              Ok(()) => ()
              Err(e) => return Err(e)
            }
          }
          cur_opt = xp_doc_parent(xdoc, p)
        }
      }
    }
  } else if axis == axis_following_sibling {
    if origin.kind <= 4 {
      let mut cur = doc.nodes[origin.node_id].next_sibling
      while cur >= 0 {
        match self.tick() {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let nd = doc.nodes[cur]
        let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
        if match_node_test(xdoc, cand, 1, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
        cur = nd.next_sibling
      }
    }
  } else if axis == axis_preceding_sibling {
    if origin.kind <= 4 {
      let mut cur = doc.nodes[origin.node_id].prev_sibling
      while cur >= 0 {
        match self.tick() {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let nd = doc.nodes[cur]
        let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
        if match_node_test(xdoc, cand, 1, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
        cur = nd.prev_sibling
      }
    }
  } else if axis == axis_following {
    let total = doc.nodes.length()
    // For attribute/namespace nodes, owner element's children/descendants ARE following!
    let mut cur = if origin.kind == 5 || origin.kind == 6 {
      origin.node_id + 1
    } else {
      xdoc.subtree_end[origin.node_id] + 1
    }
    while cur < total {
      match self.tick() {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let nd = doc.nodes[cur]
      let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
      if match_node_test(xdoc, cand, 1, test, resolved_ns) {
        out.push(cand)
        match self.check_nodes(out.length()) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      cur = cur + 1
    }
  } else if axis == axis_preceding {
    // All tree nodes before `origin.node_id` excluding ancestors of `origin`.
    // In pre-order DFS, `j < id` is an ancestor of `id` iff `subtree_end[j] >= id`!
    // Emit in reverse document order (from `origin.node_id - 1` down to `1`).
    let id = origin.node_id
    let mut cur = id - 1
    while cur >= 1 {
      match self.tick() {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if xdoc.subtree_end[cur] < id {
        let nd = doc.nodes[cur]
        let cand = XNode::{ kind: xp_unpack_kind(nd.kind_ns), node_id: cur, sub_id: -1 }
        if match_node_test(xdoc, cand, 1, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
      }
      cur = cur - 1
    }
  } else if axis == axis_attribute {
    if origin.kind == 1 {
      let nd = doc.nodes[origin.node_id]
      let mut a = nd.attrs_start
      while a < nd.attrs_end {
        match self.tick() {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let cand = XNode::{ kind: 5, node_id: origin.node_id, sub_id: a }
        if match_node_test(xdoc, cand, 5, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
        a = a + 1
      }
    }
  } else if axis == axis_namespace {
    if origin.kind == 1 {
      let (ns_s, ns_e) = xp_doc_ns_range(xdoc, origin.node_id)
      let mut k = ns_s
      while k < ns_e {
        match self.tick() {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let cand = XNode::{ kind: 6, node_id: origin.node_id, sub_id: k }
        if match_node_test(xdoc, cand, 6, test, resolved_ns) {
          out.push(cand)
          match self.check_nodes(out.length()) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
        k = k + 1
      }
    }
  }
  let _ = principal_kind
  Ok(())
}

///| Apply a sequence of predicate expressions to `nodes` (in whatever order `nodes` is in:
///| forward for forward axes / FilterExpr, reverse for reverse axes).
fn EvalEnv::apply_predicates(
  self : EvalEnv,
  nodes : Array[XNode],
  pred_start : Int,
  pred_len : Int,
) -> Result[Array[XNode], XPathError] {
  let mut cur = nodes
  let mut p = 0
  while p < pred_len && cur.length() > 0 {
    let pred_expr = self.expr.expr_lists[pred_start + p]
    let size = cur.length()
    let next : Array[XNode] = []
    let mut idx = 0
    while idx < size {
      let pval = match self.eval_expr(pred_expr, cur[idx], idx + 1, size) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let keep = match pval {
        XPathValue::Number(num) => num == (idx + 1).to_double()
        _ => pval.to_bool()
      }
      if keep {
        next.push(cur[idx])
      }
      idx = idx + 1
    }
    cur = next
    p = p + 1
  }
  Ok(cur)
}

fn is_bare_dos_node(step : Step) -> Bool {
  if step.axis != axis_descendant_or_self || step.pred_len != 0 {
    return false
  }
  match step.test {
    NodeTest::Node => true
    _ => false
  }
}

///| Evaluate a sequence of location steps starting from `initial` (sorted, deduplicated).
fn EvalEnv::eval_steps(
  self : EvalEnv,
  initial : Array[XNode],
  step_start : Int,
  step_len : Int,
) -> Result[Array[XNode], XPathError] {
  let mut cur = initial
  let mut s = 0
  while s < step_len && cur.length() > 0 {
    let step = self.expr.steps[step_start + s]
    // Fast path for `//child_step`: fuse `descendant-or-self::node()` + `child::test[preds]`
    // without materializing all text/comment/PI nodes!
    if s + 1 < step_len &&
    is_bare_dos_node(step) &&
    self.expr.steps[step_start + s + 1].axis == axis_child {
      let next_step = self.expr.steps[step_start + s + 1]
      let resolved_ns = match next_step.test {
        NodeTest::QName(pref, _) =>
        match self.resolve_ns(pref) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        NodeTest::NsWildcard(pref) =>
        match self.resolve_ns(pref) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        _ => ""
      }
      if next_step.pred_len == 0 {
        // `descendant-or-self::node()/child::test` with no predicates == `descendant::test`!
        let next_nodes : Array[XNode] = []
        let mut i = 0
        while i < cur.length() {
          match self.collect_axis(cur[i], axis_descendant, next_step.test, resolved_ns, next_nodes) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
          i = i + 1
        }
        cur = if cur.length() <= 1 { next_nodes } else { sort_dedup_nodes(next_nodes) }
      } else {
        // `//child_step[preds]`: iterate only container nodes (Root/Element) in subtree
        let doc = self.doc.doc
        let next_nodes : Array[XNode] = []
        let mut i = 0
        while i < cur.length() {
          let orig = cur[i]
          if orig.kind == 0 || orig.kind == 1 {
            let end_id = self.doc.subtree_end[orig.node_id]
            let mut cid = orig.node_id
            while cid <= end_id {
              let ck = xp_unpack_kind(doc.nodes[cid].kind_ns)
              if ck == 0 || ck == 1 {
                let container = XNode::{ kind: ck, node_id: cid, sub_id: -1 }
                let step_out : Array[XNode] = []
                match self.collect_axis(container, axis_child, next_step.test, resolved_ns, step_out) {
                  Ok(()) => ()
                  Err(e) => return Err(e)
                }
                if step_out.length() > 0 {
                  let filtered = match self.apply_predicates(
                    step_out,
                    next_step.pred_start,
                    next_step.pred_len,
                  ) {
                    Ok(f) => f
                    Err(e) => return Err(e)
                  }
                  let mut j = 0
                  while j < filtered.length() {
                    next_nodes.push(filtered[j])
                    j = j + 1
                  }
                  match self.check_nodes(next_nodes.length()) {
                    Ok(()) => ()
                    Err(e) => return Err(e)
                  }
                }
              }
              cid = cid + 1
            }
          }
          i = i + 1
        }
        cur = sort_dedup_nodes(next_nodes)
      }
      s = s + 2
      continue
    }

    let resolved_ns = match step.test {
      NodeTest::QName(pref, _) =>
      match self.resolve_ns(pref) {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      NodeTest::NsWildcard(pref) =>
      match self.resolve_ns(pref) {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      _ => ""
    }
    let is_rev = axis_is_reverse(step.axis)
    if cur.length() == 1 {
      let step_out : Array[XNode] = []
      match self.collect_axis(cur[0], step.axis, step.test, resolved_ns, step_out) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let filtered = if step.pred_len > 0 {
        match self.apply_predicates(step_out, step.pred_start, step.pred_len) {
          Ok(f) => f
          Err(e) => return Err(e)
        }
      } else {
        step_out
      }
      if is_rev {
        reverse_nodes(filtered)
      }
      cur = filtered
    } else {
      let next_nodes : Array[XNode] = []
      let mut i = 0
      while i < cur.length() {
        let step_out : Array[XNode] = []
        match self.collect_axis(cur[i], step.axis, step.test, resolved_ns, step_out) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let filtered = if step.pred_len > 0 {
          match self.apply_predicates(step_out, step.pred_start, step.pred_len) {
            Ok(f) => f
            Err(e) => return Err(e)
          }
        } else {
          step_out
        }
        let mut j = 0
        while j < filtered.length() {
          next_nodes.push(filtered[j])
          j = j + 1
        }
        match self.check_nodes(next_nodes.length()) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      cur = sort_dedup_nodes(next_nodes)
    }
    s = s + 1
  }
  Ok(cur)
}

fn EvalEnv::eval_expr(
  self : EvalEnv,
  expr_id : Int,
  ctx_node : XNode,
  ctx_pos : Int,
  ctx_size : Int,
) -> Result[XPathValue, XPathError] {
  match self.tick() {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  match self.enter() {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let res = self.eval_expr_inner(expr_id, ctx_node, ctx_pos, ctx_size)
  self.leave()
  res
}

fn EvalEnv::eval_expr_inner(
  self : EvalEnv,
  expr_id : Int,
  ctx_node : XNode,
  ctx_pos : Int,
  ctx_size : Int,
) -> Result[XPathValue, XPathError] {
  match self.expr.exprs[expr_id] {
    ExprNode::LitStr(s) => Ok(XPathValue::Str(s))
    ExprNode::LitNum(n) => Ok(XPathValue::Number(n))
    ExprNode::VarRef(name) =>
    match self.ctx.variables.get(name) {
      Some(v) => Ok(v)
      None =>
      Err(
        XPathError::new(
          XPathErrorKind::UnboundVariable,
          0,
          "unbound variable '$" + name + "'",
        ),
      )
    }
    ExprNode::UnaryNeg(inner) =>
    match self.eval_expr(inner, ctx_node, ctx_pos, ctx_size) {
      Ok(v) => Ok(XPathValue::Number(-v.to_number(self.doc)))
      Err(e) => Err(e)
    }
    ExprNode::LocPath(is_abs, step_start, step_len) => {
      let start_nodes = if is_abs {
        [self.doc.root()]
      } else {
        [ctx_node]
      }
      match self.eval_steps(start_nodes, step_start, step_len) {
        Ok(ns) => Ok(XPathValue::NodeSet(ns))
        Err(e) => Err(e)
      }
    }
    ExprNode::Filter(primary, pred_start, pred_len) => {
      let base = match self.eval_expr(primary, ctx_node, ctx_pos, ctx_size) {
        Ok(XPathValue::NodeSet(ns)) => ns
        Ok(_) =>
        return Err(
          XPathError::new(
            XPathErrorKind::TypeError,
            0,
            "filter expression requires a node-set",
          ),
        )
        Err(e) => return Err(e)
      }
      match self.apply_predicates(base, pred_start, pred_len) {
        Ok(ns) => Ok(XPathValue::NodeSet(ns))
        Err(e) => Err(e)
      }
    }
    ExprNode::PathExpr(filter_id, step_start, step_len) => {
      let base = match self.eval_expr(filter_id, ctx_node, ctx_pos, ctx_size) {
        Ok(XPathValue::NodeSet(ns)) => ns
        Ok(_) =>
        return Err(
          XPathError::new(
            XPathErrorKind::TypeError,
            0,
            "path expression base must evaluate to a node-set",
          ),
        )
        Err(e) => return Err(e)
      }
      match self.eval_steps(base, step_start, step_len) {
        Ok(ns) => Ok(XPathValue::NodeSet(ns))
        Err(e) => Err(e)
      }
    }
    ExprNode::Union(lhs, rhs) => {
      let a = match self.eval_expr(lhs, ctx_node, ctx_pos, ctx_size) {
        Ok(XPathValue::NodeSet(ns)) => ns
        Ok(_) =>
        return Err(
          XPathError::new(
            XPathErrorKind::TypeError,
            0,
            "union '|' requires node-set operands",
          ),
        )
        Err(e) => return Err(e)
      }
      let b = match self.eval_expr(rhs, ctx_node, ctx_pos, ctx_size) {
        Ok(XPathValue::NodeSet(ns)) => ns
        Ok(_) =>
        return Err(
          XPathError::new(
            XPathErrorKind::TypeError,
            0,
            "union '|' requires node-set operands",
          ),
        )
        Err(e) => return Err(e)
      }
      let merged = union_sorted_nodes(a, b)
      match self.check_nodes(merged.length()) {
        Ok(()) => Ok(XPathValue::NodeSet(merged))
        Err(e) => Err(e)
      }
    }
    ExprNode::BinOp(op, lhs, rhs) =>
    self.eval_binop(op, lhs, rhs, ctx_node, ctx_pos, ctx_size)
    ExprNode::FuncCall(fc) =>
    self.eval_func(fc, ctx_node, ctx_pos, ctx_size)
  }
}

fn cmp_num(op : Int, a : Double, b : Double) -> Bool {
  if op == op_eq {
    a == b
  } else if op == op_neq {
    a != b
  } else if op == op_lt {
    a < b
  } else if op == op_le {
    a <= b
  } else if op == op_gt {
    a > b
  } else {
    a >= b
  }
}

fn flip_cmp_op(op : Int) -> Int {
  if op == op_lt {
    op_gt
  } else if op == op_le {
    op_ge
  } else if op == op_gt {
    op_lt
  } else if op == op_ge {
    op_le
  } else {
    op
  }
}

fn EvalEnv::compare_values(
  self : EvalEnv,
  op : Int,
  lv : XPathValue,
  rv : XPathValue,
) -> Bool {
  let doc = self.doc
  // Handle NodeSet existential comparisons (§3.4)
  match (lv, rv) {
    (XPathValue::NodeSet(ns1), XPathValue::NodeSet(ns2)) => {
      if ns1.length() == 0 || ns2.length() == 0 {
        return false
      }
      if op == op_eq || op == op_neq {
        let mut i = 0
        while i < ns1.length() {
          let s1 = xp_doc_string_value(doc, ns1[i])
          let mut j = 0
          while j < ns2.length() {
            let s2 = xp_doc_string_value(doc, ns2[j])
            if (op == op_eq && s1 == s2) || (op == op_neq && s1 != s2) {
              return true
            }
            j = j + 1
          }
          i = i + 1
        }
        false
      } else {
        let mut i = 0
        while i < ns1.length() {
          let n1 = xp_parse_number(xp_doc_string_value(doc, ns1[i]))
          let mut j = 0
          while j < ns2.length() {
            let n2 = xp_parse_number(xp_doc_string_value(doc, ns2[j]))
            if cmp_num(op, n1, n2) {
              return true
            }
            j = j + 1
          }
          i = i + 1
        }
        false
      }
    }
    (XPathValue::NodeSet(ns), XPathValue::Boolean(b)) => {
      let lb = ns.length() > 0
      if op == op_eq {
        lb == b
      } else if op == op_neq {
        lb != b
      } else {
        cmp_num(op, if lb { 1.0 } else { 0.0 }, if b { 1.0 } else { 0.0 })
      }
    }
    (XPathValue::Boolean(b), XPathValue::NodeSet(ns)) => {
      let rb = ns.length() > 0
      if op == op_eq {
        b == rb
      } else if op == op_neq {
        b != rb
      } else {
        cmp_num(op, if b { 1.0 } else { 0.0 }, if rb { 1.0 } else { 0.0 })
      }
    }
    (XPathValue::NodeSet(ns), XPathValue::Number(num)) => {
      let mut i = 0
      while i < ns.length() {
        let n1 = xp_parse_number(xp_doc_string_value(doc, ns[i]))
        if cmp_num(op, n1, num) {
          return true
        }
        i = i + 1
      }
      false
    }
    (XPathValue::Number(num), XPathValue::NodeSet(ns)) => {
      let fop = flip_cmp_op(op)
      let mut i = 0
      while i < ns.length() {
        let n2 = xp_parse_number(xp_doc_string_value(doc, ns[i]))
        if cmp_num(fop, n2, num) {
          return true
        }
        i = i + 1
      }
      false
    }
    (XPathValue::NodeSet(ns), XPathValue::Str(s)) => {
      if op == op_eq || op == op_neq {
        let mut i = 0
        while i < ns.length() {
          let s1 = xp_doc_string_value(doc, ns[i])
          if (op == op_eq && s1 == s) || (op == op_neq && s1 != s) {
            return true
          }
          i = i + 1
        }
        false
      } else {
        let num = xp_parse_number(s)
        let mut i = 0
        while i < ns.length() {
          let n1 = xp_parse_number(xp_doc_string_value(doc, ns[i]))
          if cmp_num(op, n1, num) {
            return true
          }
          i = i + 1
        }
        false
      }
    }
    (XPathValue::Str(s), XPathValue::NodeSet(ns)) => {
      if op == op_eq || op == op_neq {
        let mut i = 0
        while i < ns.length() {
          let s2 = xp_doc_string_value(doc, ns[i])
          if (op == op_eq && s == s2) || (op == op_neq && s != s2) {
            return true
          }
          i = i + 1
        }
        false
      } else {
        let num = xp_parse_number(s)
        let fop = flip_cmp_op(op)
        let mut i = 0
        while i < ns.length() {
          let n2 = xp_parse_number(xp_doc_string_value(doc, ns[i]))
          if cmp_num(fop, n2, num) {
            return true
          }
          i = i + 1
        }
        false
      }
    }
    _ => {
      // Neither operand is a NodeSet
      if op == op_eq || op == op_neq {
        match (lv, rv) {
          (XPathValue::Boolean(_), _) | (_, XPathValue::Boolean(_)) => {
            let b1 = lv.to_bool()
            let b2 = rv.to_bool()
            if op == op_eq { b1 == b2 } else { b1 != b2 }
          }
          (XPathValue::Number(_), _) | (_, XPathValue::Number(_)) => {
            cmp_num(op, lv.to_number(doc), rv.to_number(doc))
          }
          _ => {
            let s1 = lv.to_string(doc)
            let s2 = rv.to_string(doc)
            if op == op_eq { s1 == s2 } else { s1 != s2 }
          }
        }
      } else {
        cmp_num(op, lv.to_number(doc), rv.to_number(doc))
      }
    }
  }
}

fn EvalEnv::eval_binop(
  self : EvalEnv,
  op : Int,
  lhs : Int,
  rhs : Int,
  ctx_node : XNode,
  ctx_pos : Int,
  ctx_size : Int,
) -> Result[XPathValue, XPathError] {
  // Short-circuit boolean operators
  if op == op_or {
    let lv = match self.eval_expr(lhs, ctx_node, ctx_pos, ctx_size) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if lv.to_bool() {
      return Ok(XPathValue::Boolean(true))
    }
    let rv = match self.eval_expr(rhs, ctx_node, ctx_pos, ctx_size) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(XPathValue::Boolean(rv.to_bool()))
  }
  if op == op_and {
    let lv = match self.eval_expr(lhs, ctx_node, ctx_pos, ctx_size) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !lv.to_bool() {
      return Ok(XPathValue::Boolean(false))
    }
    let rv = match self.eval_expr(rhs, ctx_node, ctx_pos, ctx_size) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(XPathValue::Boolean(rv.to_bool()))
  }
  let lv = match self.eval_expr(lhs, ctx_node, ctx_pos, ctx_size) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let rv = match self.eval_expr(rhs, ctx_node, ctx_pos, ctx_size) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if op >= op_eq && op <= op_ge {
    return Ok(XPathValue::Boolean(self.compare_values(op, lv, rv)))
  }
  let ln = lv.to_number(self.doc)
  let rn = rv.to_number(self.doc)
  if op == op_add {
    Ok(XPathValue::Number(ln + rn))
  } else if op == op_sub {
    Ok(XPathValue::Number(ln - rn))
  } else if op == op_mul {
    Ok(XPathValue::Number(ln * rn))
  } else if op == op_div {
    Ok(XPathValue::Number(ln / rn))
  } else {
    Ok(XPathValue::Number(xp_fmod(ln, rn)))
  }
}

fn check_arity(
  name : String,
  got : Int,
  min_a : Int,
  max_a : Int,
) -> Result[Unit, XPathError] {
  if got < min_a || (max_a >= 0 && got > max_a) {
    return Err(
      XPathError::new(
        XPathErrorKind::InvalidArity,
        0,
        "wrong number of arguments for '" + name + "()'",
      ),
    )
  }
  Ok(())
}

fn xp_normalize_space(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut need_space = false
  let mut started = false
  while i < n {
    let b = s.code_unit_at(i)
    if xml_is_ws(b) {
      if started {
        need_space = true
      }
    } else {
      if need_space {
        sb.write_byte(0x20.to_byte())
        need_space = false
      }
      sb.write_byte(b.to_byte())
      started = true
    }
    i = i + 1
  }
  sb.to_string()
}

fn xp_find_substring(haystack : String, needle : String) -> Int {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return 0
  }
  if nn > hn {
    return -1
  }
  let first = needle.code_unit_at(0)
  let limit = hn - nn
  let mut i = 0
  while i <= limit {
    if haystack.code_unit_at(i) == first {
      let mut j = 1
      while j < nn && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
        j = j + 1
      }
      if j == nn {
        return i
      }
    }
    i = i + 1
  }
  -1
}

fn xp_starts_with(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn ascii_lower_byte(b : Int) -> Int {
  if b >= 0x41 && b <= 0x5A {
    b + 32
  } else {
    b
  }
}

fn xp_lang_matches(actual : String, target : String) -> Bool {
  let an = actual.length()
  let tn = target.length()
  if tn == 0 || an < tn {
    return false
  }
  let mut i = 0
  while i < tn {
    if ascii_lower_byte(actual.code_unit_at(i)) != ascii_lower_byte(target.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  an == tn || actual.code_unit_at(tn) == 0x2D
}

fn EvalEnv::eval_func(
  self : EvalEnv,
  fc : FuncCallData,
  ctx_node : XNode,
  ctx_pos : Int,
  ctx_size : Int,
) -> Result[XPathValue, XPathError] {
  let fid = fc.fn_id
  let func_name = fc.name
  let arg_start = fc.arg_start
  let arg_len = fc.arg_len
  if fid < 0 {
    return Err(
      XPathError::new(
        XPathErrorKind::UnknownFunction,
        0,
        "unknown function '" + func_name + "()'",
      ),
    )
  }
  let doc = self.doc
  // Evaluate arguments eagerly
  let args : Array[XPathValue] = Array::with_capacity(arg_len)
  let mut i = 0
  while i < arg_len {
    match self.eval_expr(self.expr.expr_lists[arg_start + i], ctx_node, ctx_pos, ctx_size) {
      Ok(v) => args.push(v)
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  if fid == fn_last {
    match check_arity(func_name, arg_len, 0, 0) {
      Ok(()) => Ok(XPathValue::Number(ctx_size.to_double()))
      Err(e) => Err(e)
    }
  } else if fid == fn_position {
    match check_arity(func_name, arg_len, 0, 0) {
      Ok(()) => Ok(XPathValue::Number(ctx_pos.to_double()))
      Err(e) => Err(e)
    }
  } else if fid == fn_count {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    match args[0] {
      XPathValue::NodeSet(ns) => Ok(XPathValue::Number(ns.length().to_double()))
      _ =>
      Err(
        XPathError::new(
          XPathErrorKind::TypeError,
          0,
          "count() requires a node-set argument",
        ),
      )
    }
  } else if fid == fn_id {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let id_strings : Array[String] = []
    match args[0] {
      XPathValue::NodeSet(ns) => {
        let mut k = 0
        while k < ns.length() {
          id_strings.push(xp_doc_string_value(doc, ns[k]))
          k = k + 1
        }
      }
      other => id_strings.push(other.to_string(doc))
    }
    let found : Array[XNode] = []
    let mut k = 0
    while k < id_strings.length() {
      let s = id_strings[k]
      let slen = s.length()
      let mut pos = 0
      while pos < slen {
        while pos < slen && xml_is_ws(s.code_unit_at(pos)) {
          pos = pos + 1
        }
        let tok_start = pos
        while pos < slen && !xml_is_ws(s.code_unit_at(pos)) {
          pos = pos + 1
        }
        if pos > tok_start {
          let tok = s.slice(tok_start, pos)
          match doc.id_map.get(tok) {
            Some(eid) => found.push(XNode::{ kind: 1, node_id: eid, sub_id: -1 })
            None => ()
          }
        }
      }
      k = k + 1
    }
    Ok(XPathValue::NodeSet(sort_dedup_nodes(found)))
  } else if fid == fn_local_name || fid == fn_namespace_uri || fid == fn_name {
    match check_arity(func_name, arg_len, 0, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let target = if arg_len == 0 {
      Some(ctx_node)
    } else {
      match args[0] {
        XPathValue::NodeSet(ns) =>
        if ns.length() > 0 { Some(ns[0]) } else { None }
        _ =>
        return Err(
          XPathError::new(
            XPathErrorKind::TypeError,
            0,
            func_name + "() requires a node-set argument",
          ),
        )
      }
    }
    match target {
      None => Ok(XPathValue::Str(""))
      Some(nd) =>
      if fid == fn_local_name {
        Ok(XPathValue::Str(xp_doc_local_name(doc, nd)))
      } else if fid == fn_namespace_uri {
        Ok(XPathValue::Str(xp_doc_namespace_uri(doc, nd)))
      } else {
        Ok(XPathValue::Str(xp_doc_node_name(doc, nd)))
      }
    }
  } else if fid == fn_string {
    match check_arity(func_name, arg_len, 0, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    if arg_len == 0 {
      Ok(XPathValue::Str(xp_doc_string_value(doc, ctx_node)))
    } else {
      Ok(XPathValue::Str(args[0].to_string(doc)))
    }
  } else if fid == fn_concat {
    match check_arity(func_name, arg_len, 2, -1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let sb = StringBuilder::new()
    let mut total_bytes = 0
    let mut k = 0
    while k < arg_len {
      let part = args[k].to_string(doc)
      total_bytes = total_bytes + part.length()
      if total_bytes > self.max_output_bytes {
        return Err(
          XPathError::new(
            XPathErrorKind::LimitExceeded,
            0,
            "concat() output exceeds max_output_bytes",
          ),
        )
      }
      sb.write_string(part)
      k = k + 1
    }
    Ok(XPathValue::Str(sb.to_string()))
  } else if fid == fn_starts_with {
    match check_arity(func_name, arg_len, 2, 2) {
      Ok(()) =>
      Ok(
        XPathValue::Boolean(
          xp_starts_with(args[0].to_string(doc), args[1].to_string(doc)),
        ),
      )
      Err(e) => Err(e)
    }
  } else if fid == fn_contains {
    match check_arity(func_name, arg_len, 2, 2) {
      Ok(()) =>
      Ok(
        XPathValue::Boolean(
          xp_find_substring(args[0].to_string(doc), args[1].to_string(doc)) >= 0,
        ),
      )
      Err(e) => Err(e)
    }
  } else if fid == fn_substring_before {
    match check_arity(func_name, arg_len, 2, 2) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let s1 = args[0].to_string(doc)
    let s2 = args[1].to_string(doc)
    let pos = xp_find_substring(s1, s2)
    if pos < 0 {
      Ok(XPathValue::Str(""))
    } else {
      Ok(XPathValue::Str(s1.slice(0, pos)))
    }
  } else if fid == fn_substring_after {
    match check_arity(func_name, arg_len, 2, 2) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let s1 = args[0].to_string(doc)
    let s2 = args[1].to_string(doc)
    let pos = xp_find_substring(s1, s2)
    if pos < 0 {
      Ok(XPathValue::Str(""))
    } else {
      Ok(XPathValue::Str(s1.slice(pos + s2.length(), s1.length())))
    }
  } else if fid == fn_substring {
    match check_arity(func_name, arg_len, 2, 3) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let s = args[0].to_string(doc)
    let start_d = xp_round(args[1].to_number(doc))
    if xp_is_nan(start_d) {
      return Ok(XPathValue::Str(""))
    }
    let end_d = if arg_len == 3 {
      let len_d = xp_round(args[2].to_number(doc))
      if xp_is_nan(len_d) {
        return Ok(XPathValue::Str(""))
      }
      let sum = start_d + len_d
      if xp_is_nan(sum) {
        return Ok(XPathValue::Str(""))
      }
      sum
    } else {
      1.0 / 0.0
    }
    let cps = utf8_to_codepoints(s)
    let sb = StringBuilder::new()
    let mut k = 0
    while k < cps.length() {
      let pos_d = (k + 1).to_double()
      if pos_d >= start_d && pos_d < end_d {
        sb_write_codepoint(sb, cps[k])
      }
      k = k + 1
    }
    Ok(XPathValue::Str(sb.to_string()))
  } else if fid == fn_string_length {
    match check_arity(func_name, arg_len, 0, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let s = if arg_len == 0 {
      xp_doc_string_value(doc, ctx_node)
    } else {
      args[0].to_string(doc)
    }
    Ok(XPathValue::Number(utf8_codepoint_count(s).to_double()))
  } else if fid == fn_normalize_space {
    match check_arity(func_name, arg_len, 0, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let s = if arg_len == 0 {
      xp_doc_string_value(doc, ctx_node)
    } else {
      args[0].to_string(doc)
    }
    Ok(XPathValue::Str(xp_normalize_space(s)))
  } else if fid == fn_translate {
    match check_arity(func_name, arg_len, 3, 3) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let src_cps = utf8_to_codepoints(args[0].to_string(doc))
    let from_cps = utf8_to_codepoints(args[1].to_string(doc))
    let to_cps = utf8_to_codepoints(args[2].to_string(doc))
    let sb = StringBuilder::new()
    let mut k = 0
    while k < src_cps.length() {
      let ch = src_cps[k]
      let mut found_idx = -1
      let mut j = 0
      while j < from_cps.length() {
        if from_cps[j] == ch {
          found_idx = j
          break
        }
        j = j + 1
      }
      if found_idx < 0 {
        sb_write_codepoint(sb, ch)
      } else if found_idx < to_cps.length() {
        sb_write_codepoint(sb, to_cps[found_idx])
      }
      k = k + 1
    }
    Ok(XPathValue::Str(sb.to_string()))
  } else if fid == fn_boolean {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => Ok(XPathValue::Boolean(args[0].to_bool()))
      Err(e) => Err(e)
    }
  } else if fid == fn_not {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => Ok(XPathValue::Boolean(!args[0].to_bool()))
      Err(e) => Err(e)
    }
  } else if fid == fn_true {
    match check_arity(func_name, arg_len, 0, 0) {
      Ok(()) => Ok(XPathValue::Boolean(true))
      Err(e) => Err(e)
    }
  } else if fid == fn_false {
    match check_arity(func_name, arg_len, 0, 0) {
      Ok(()) => Ok(XPathValue::Boolean(false))
      Err(e) => Err(e)
    }
  } else if fid == fn_lang {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let target = args[0].to_string(doc)
    let mut cur_id = if ctx_node.kind == 1 {
      ctx_node.node_id
    } else if ctx_node.kind == 5 || ctx_node.kind == 6 {
      ctx_node.node_id
    } else {
      doc.doc.nodes[ctx_node.node_id].parent
    }
    while cur_id >= 0 {
      let nd = doc.doc.nodes[cur_id]
      if xp_unpack_kind(nd.kind_ns) == 1 {
        let mut a = nd.attrs_start
        while a < nd.attrs_end {
          let attr = doc.doc.attrs[a]
          if attr.ns_idx == -2 &&
          xp_span_eq_str(doc.doc, attr.local_start, attr.local_end, "lang") {
            let actual = xp_span_to_str(doc.doc, attr.val_start, attr.val_end)
            return Ok(XPathValue::Boolean(xp_lang_matches(actual, target)))
          }
          a = a + 1
        }
      }
      cur_id = nd.parent
    }
    Ok(XPathValue::Boolean(false))
  } else if fid == fn_number {
    match check_arity(func_name, arg_len, 0, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    if arg_len == 0 {
      Ok(XPathValue::Number(xp_parse_number(xp_doc_string_value(doc, ctx_node))))
    } else {
      Ok(XPathValue::Number(args[0].to_number(doc)))
    }
  } else if fid == fn_sum {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    match args[0] {
      XPathValue::NodeSet(ns) => {
        let mut acc = 0.0
        let mut k = 0
        while k < ns.length() {
          acc = acc + xp_parse_number(xp_doc_string_value(doc, ns[k]))
          k = k + 1
        }
        Ok(XPathValue::Number(acc))
      }
      _ =>
      Err(
        XPathError::new(
          XPathErrorKind::TypeError,
          0,
          "sum() requires a node-set argument",
        ),
      )
    }
  } else if fid == fn_floor {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => Ok(XPathValue::Number(xp_floor(args[0].to_number(doc))))
      Err(e) => Err(e)
    }
  } else if fid == fn_ceiling {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => Ok(XPathValue::Number(xp_ceil(args[0].to_number(doc))))
      Err(e) => Err(e)
    }
  } else if fid == fn_round {
    match check_arity(func_name, arg_len, 1, 1) {
      Ok(()) => Ok(XPathValue::Number(xp_round(args[0].to_number(doc))))
      Err(e) => Err(e)
    }
  } else {
    Err(
      XPathError::new(
        XPathErrorKind::UnknownFunction,
        0,
        "unknown function '" + func_name + "()'",
      ),
    )
  }
}

fn xp_eval(
  expr : XPathExpr,
  doc : XPathDoc,
  node : XNode,
  ctx : XPathContext,
) -> Result[XPathValue, XPathError] {
  let env = EvalEnv::new(doc, expr, ctx)
  env.eval_expr(expr.root, node, 1, 1)
}
