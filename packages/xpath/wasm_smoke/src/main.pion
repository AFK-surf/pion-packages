///| Wasm32 + Native 4-mode smoke entry for `packages/xpath`.

import "xpath"

///|
pub fn smoke() -> Int {
  let src =
  "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
  "<catalog xmlns:bk=\"urn:book\" xml:lang=\"en-US\">" +
  "<bk:book xml:id=\"b1\" price=\"12.5\"><bk:title>  Pure   Pion  </bk:title><tag>core</tag><tag>fast</tag></bk:book>" +
  "<bk:book xml:id=\"b2\" price=\"27.5\"><bk:title>你好世界😀</bk:title><tag>xml</tag></bk:book>" +
  "</catalog>"
  let doc = match xpath::XPathDoc::parse(src) {
    Ok(d) => d
    Err(_) => return -1
  }
  let ctx = xpath::XPathContext::new()
  .with_namespace("b", "urn:book")
  .with_variable("min", xpath::XPathValue::Number(15.0))

  // 1. Namespaces + variable predicate + Unicode substring/string-length
  match xpath::eval_with(doc, doc.root(), "substring(//b:book[@price >= $min]/b:title, 2, 3)", ctx) {
    Ok(xpath::XPathValue::Str(s)) => if s != "好世界" { return -2 }
    _ => return -3
  }
  match xpath::eval_with(doc, doc.root(), "string-length(id('b2')/b:title)", ctx) {
    Ok(xpath::XPathValue::Number(n)) => if n != 5.0 { return -4 }
    _ => return -5
  }

  // 2. Multi-axis + reverse-axis predicate + Union + normalize-space + sum
  match xpath::eval_with(doc, doc.root(), "normalize-space(id('b1')/b:title)", ctx) {
    Ok(xpath::XPathValue::Str(s)) => if s != "Pure Pion" { return -6 }
    _ => return -7
  }
  match xpath::eval_with(doc, doc.root(), "sum(//b:book/@price)", ctx) {
    Ok(xpath::XPathValue::Number(n)) => if n != 40.0 { return -8 }
    _ => return -9
  }
  match xpath::eval_with(doc, doc.root(), "count(//tag[2]/preceding-sibling::tag[1] | //b:book)", ctx) {
    Ok(xpath::XPathValue::Number(n)) => if n != 3.0 { return -10 }
    _ => return -11
  }

  // 3. W3C XPath 1.0 IEEE-754 round(-0.5) == -0.0 and lang()
  match xpath::eval_string(doc, "1 div round(-0.5)") {
    Ok(s) => if s != "-Infinity" { return -12 }
    Err(_) => return -13
  }
  match xpath::eval_with(doc, doc.root_element(), "lang('en')", ctx) {
    Ok(xpath::XPathValue::Boolean(true)) => ()
    _ => return -14
  }

  // 4. DoS safety limits (depth + steps, 0 trap on Wasm32)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 80 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 80 {
    sb.write_string(")")
    i = i + 1
  }
  match xpath::XPathExpr::parse_with_limits(sb.to_string(), xpath::XPathLimits::new(32, 10000L, 1000, 65536)) {
    Err(e) => if !e.is_kind(xpath::XPathErrorKind::LimitExceeded) { return -15 }
    Ok(_) => return -16
  }
  let tight = xpath::XPathContext::new().with_limits(xpath::XPathLimits::new(64, 5L, 1000, 65536))
  match xpath::eval_with(doc, doc.root(), "//*/ancestor::*", tight) {
    Err(e) => if !e.is_kind(xpath::XPathErrorKind::LimitExceeded) { return -17 }
    Ok(_) => return -18
  }

  // 5. Pure-Pion IEEE-754 §4.2/§4.4/§3.5 number semantics (4-mode byte-identical)
  match xpath::eval_string(doc, "string(1000000000000000000000)") {
    Ok(s) => if s != "1000000000000000000000" { return -19 }
    Err(_) => return -20
  }
  match xpath::eval_string(doc, "string(1152921504606846976)") {
    Ok(s) => if s != "1152921504606846976" { return -21 }
    Err(_) => return -22
  }
  match xpath::eval_string(doc, "string(0.0000001)") {
    Ok(s) => if s != "0.0000001" { return -23 }
    Err(_) => return -24
  }
  match xpath::eval_number(doc, "round(0.49999999999999994)") {
    Ok(n) => if n != 0.0 { return -25 }
    Err(_) => return -26
  }
  match xpath::eval_string(doc, "string(5.5 mod 1.1)") {
    Ok(s) => if s != "1.0999999999999996" { return -27 }
    Err(_) => return -28
  }
  5
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "xpath_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "xpath_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
