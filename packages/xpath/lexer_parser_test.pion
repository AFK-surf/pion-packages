///| W3C XPath 1.0 §3.7 lexical disambiguation, grammar, operator precedence, and error tests.
///| Also defines shared test assertion helpers used across all `packages/xpath/*_test.pion` files.

fn t_dummy_doc() -> XPathDoc {
  let empty_xml = xml::Document::{
    src: "",
    strings: [],
    nodes: [],
    attrs: [],
    namespaces: [],
    root_elem_id: -1,
  }
  XPathDoc::from_document(empty_xml)
}

fn t_must_doc(src : String) -> XPathDoc {
  match XPathDoc::parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "XPathDoc::parse failed: " + e.to_string())
      t_dummy_doc()
    }
  }
}

fn t_must_str(doc : XPathDoc, expr : String) -> String {
  match eval_string(doc, expr) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "eval_string(" + expr + ") failed: " + e.to_string())
      ""
    }
  }
}

fn t_must_num(doc : XPathDoc, expr : String) -> Double {
  match eval_number(doc, expr) {
    Ok(n) => n
    Err(e) => {
      debug_assert(false, "eval_number(" + expr + ") failed: " + e.to_string())
      0.0
    }
  }
}

fn t_must_bool(doc : XPathDoc, expr : String) -> Bool {
  match eval_bool(doc, expr) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "eval_bool(" + expr + ") failed: " + e.to_string())
      false
    }
  }
}

fn t_must_nodes(doc : XPathDoc, expr : String) -> Array[XNode] {
  match eval_nodes(doc, expr) {
    Ok(ns) => ns
    Err(e) => {
      debug_assert(false, "eval_nodes(" + expr + ") failed: " + e.to_string())
      []
    }
  }
}

fn t_must_first_node(doc : XPathDoc, expr : String) -> XNode {
  let ns = t_must_nodes(doc, expr)
  if ns.length() == 0 {
    debug_assert(false, "t_must_first_node(" + expr + "): empty node-set")
    XNode::{ kind: 0, node_id: 0, sub_id: -1 }
  } else {
    ns[0]
  }
}

fn t_must_str_with(
  doc : XPathDoc,
  node : XNode,
  expr : String,
  ctx : XPathContext,
) -> String {
  match eval_with(doc, node, expr, ctx) {
    Ok(v) => v.to_string(doc)
    Err(e) => {
      debug_assert(false, "eval_with(" + expr + ") failed: " + e.to_string())
      ""
    }
  }
}

fn t_must_num_with(
  doc : XPathDoc,
  node : XNode,
  expr : String,
  ctx : XPathContext,
) -> Double {
  match eval_with(doc, node, expr, ctx) {
    Ok(v) => v.to_number(doc)
    Err(e) => {
      debug_assert(false, "eval_with(" + expr + ") failed: " + e.to_string())
      0.0
    }
  }
}

fn t_must_bool_with(
  doc : XPathDoc,
  node : XNode,
  expr : String,
  ctx : XPathContext,
) -> Bool {
  match eval_with(doc, node, expr, ctx) {
    Ok(v) => v.to_bool()
    Err(e) => {
      debug_assert(false, "eval_with(" + expr + ") failed: " + e.to_string())
      false
    }
  }
}

fn t_must_nodes_with(
  doc : XPathDoc,
  node : XNode,
  expr : String,
  ctx : XPathContext,
) -> Array[XNode] {
  match eval_with(doc, node, expr, ctx) {
    Ok(XPathValue::NodeSet(ns)) => ns
    Ok(_) => {
      debug_assert(false, "eval_with(" + expr + "): expected NodeSet")
      []
    }
    Err(e) => {
      debug_assert(false, "eval_with(" + expr + ") failed: " + e.to_string())
      []
    }
  }
}

test "lexer_disambig_multiply_vs_wildcard" {
  let doc = t_must_doc("<r><a>6</a><b>7</b></r>")
  // * as wildcard after /, (, [, ,, @, ::, |, operator
  debug_assert(t_must_num(doc, "count(/*)") == 1.0, "/* wildcard")
  debug_assert(t_must_num(doc, "count(/*/*)") == 2.0, "/*/* wildcard")
  debug_assert(t_must_num(doc, "count((/*/*))") == 2.0, "(/*/*) wildcard")
  debug_assert(t_must_num(doc, "count(/r/*[* or true()])") == 2.0, "[* wildcard")
  debug_assert(t_must_num(doc, "count(/r/a | /r/*)") == 2.0, "| * wildcard")
  // * as multiply operator after expression/name/wildcard/number/rparen/rbracket
  debug_assert(t_must_num(doc, "2 * 3") == 6.0, "2 * 3")
  debug_assert(t_must_num(doc, "/r/a * /r/b") == 42.0, "/r/a * /r/b")
  debug_assert(t_must_num(doc, "/r/*[1] * /r/*[2]") == 42.0, "rbracket *")
  debug_assert(t_must_num(doc, "(2 + 1) * (3 + 4)") == 21.0, "rparen *")
  // * * * : child::* multiplied by child::*
  let r = doc.root_element()
  debug_assert(
    t_must_num_with(doc, r, "* * *", XPathContext::new()) == 36.0,
    "* * * => 6 * 6 = 36",
  )
  // 1 + * (after + operator, * is wildcard)
  debug_assert(
    t_must_num_with(doc, r, "1 + *", XPathContext::new()) == 7.0,
    "1 + * => 1 + 6 = 7",
  )
}

test "lexer_disambig_operator_names_as_element_names" {
  let xml_src = "<div and=\"1\" or=\"2\"><div mod=\"3\">10</div><mod>4</mod><and>true</and><or>false</or></div>"
  let doc = t_must_doc(xml_src)
  // Operator names as element & attribute names
  debug_assert(t_must_str(doc, "/div/div") == "10", "/div/div")
  debug_assert(t_must_str(doc, "/div/mod") == "4", "/div/mod")
  debug_assert(t_must_str(doc, "/div/@and") == "1", "/div/@and")
  debug_assert(t_must_str(doc, "/div/@or") == "2", "/div/@or")
  debug_assert(t_must_str(doc, "/div/div/@mod") == "3", "/div/div/@mod")
  // Operator names BOTH as element names AND operators in the same expression!
  let r = doc.root_element()
  debug_assert(
    t_must_num_with(doc, r, "div div mod", XPathContext::new()) == 2.5,
    "div div mod = 10 / 4 = 2.5",
  )
  debug_assert(
    t_must_num_with(doc, r, "div mod mod", XPathContext::new()) == 2.0,
    "div mod mod = 10 % 4 = 2",
  )
  debug_assert(
    t_must_num_with(doc, r, "div * mod", XPathContext::new()) == 40.0,
    "div * mod = 40",
  )
  debug_assert(
    t_must_bool_with(doc, r, "and and or", XPathContext::new()),
    "and and or (both non-empty node-sets)",
  )
  debug_assert(
    t_must_bool_with(doc, r, "or or and", XPathContext::new()),
    "or or and",
  )
}

test "lexer_disambig_nodetype_and_axis_names_as_elements" {
  let doc = t_must_doc("<root><node>N</node><text>T</text><comment>C</comment><child>CH</child><parent>P</parent></root>")
  debug_assert(t_must_str(doc, "/root/node") == "N", "element named node")
  debug_assert(t_must_str(doc, "/root/text") == "T", "element named text")
  debug_assert(t_must_str(doc, "/root/comment") == "C", "element named comment")
  debug_assert(t_must_str(doc, "/root/child") == "CH", "element named child")
  debug_assert(t_must_str(doc, "/root/parent") == "P", "element named parent")
  debug_assert(t_must_num(doc, "count(/root/node())") == 5.0, "node() test")
  debug_assert(t_must_str(doc, "/root/child::child") == "CH", "child::child")
}

test "lexer_literals_numbers_and_quotes" {
  let doc = t_must_doc("<r/>")
  debug_assert(t_must_str(doc, "'hello \"world\"'") == "hello \"world\"", "single quotes")
  debug_assert(t_must_str(doc, "\"hello 'world'\"") == "hello 'world'", "double quotes")
  debug_assert(t_must_str(doc, "''") == "", "empty single string")
  debug_assert(t_must_str(doc, "\"\"") == "", "empty double string")
  debug_assert(t_must_num(doc, "42") == 42.0, "int literal")
  debug_assert(t_must_num(doc, "3.14") == 3.14, "decimal literal")
  debug_assert(t_must_num(doc, ".5") == 0.5, "leading dot literal")
  debug_assert(t_must_num(doc, "5.") == 5.0, "trailing dot literal")
  debug_assert(t_must_num(doc, "--5") == 5.0, "double unary minus")
  debug_assert(t_must_num(doc, "---5") == -5.0, "triple unary minus")
}

test "parser_operator_precedence_and_associativity" {
  let doc = t_must_doc("<r/>")
  debug_assert(t_must_num(doc, "1 + 2 * 3") == 7.0, "* binds tighter than +")
  debug_assert(t_must_num(doc, "10 - 3 - 2") == 5.0, "- is left-associative")
  debug_assert(t_must_num(doc, "24 div 6 div 2") == 2.0, "div is left-associative")
  debug_assert(t_must_bool(doc, "true() or false() and false()"), "and binds tighter than or")
  debug_assert(t_must_bool(doc, "1 < 2 = true()"), "< binds tighter than =")
  debug_assert(t_must_bool(doc, "1 + 2 = 3"), "+ binds tighter than =")
  debug_assert(t_must_bool(doc, "1 = 1 = true()"), "= is left-associative")
  debug_assert(t_must_bool(doc, "1 = 2 = false()"), "(1=2)=false()")
}

test "parser_syntax_and_lex_errors" {
  // Unterminated string
  match XPathExpr::parse("'unterminated") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::LexError), "unterminated string")
    Ok(_) => debug_assert(false, "expected lex error")
  }
  // Empty expression
  match XPathExpr::parse("   ") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::SyntaxError), "empty expr")
    Ok(_) => debug_assert(false, "expected syntax error")
  }
  // Trailing garbage
  match XPathExpr::parse("1 + 2 3") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::SyntaxError), "trailing token")
    Ok(_) => debug_assert(false, "expected syntax error")
  }
  // Unknown axis
  match XPathExpr::parse("bogus::*") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::SyntaxError), "unknown axis")
    Ok(_) => debug_assert(false, "expected syntax error")
  }
  // Unclosed predicate
  match XPathExpr::parse("/a/b[1") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::SyntaxError), "unclosed predicate")
    Ok(_) => debug_assert(false, "expected syntax error")
  }
  // Deeply nested parentheses hit max_depth
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 80 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 80 {
    sb.write_string(")")
    i = i + 1
  }
  match XPathExpr::parse_with_limits(sb.to_string(), XPathLimits::new(32, 10000L, 1000, 65536)) {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::LimitExceeded), "depth limit")
    Ok(_) => debug_assert(false, "expected LimitExceeded on deep parens")
  }
}

test "compiled_expr_reuse_across_docs" {
  let compiled = match XPathExpr::parse("sum(//item/@v)") {
    Ok(e) => e
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return
    }
  }
  let d1 = t_must_doc("<r><item v=\"10\"/><item v=\"20\"/></r>")
  let d2 = t_must_doc("<r><g><item v=\"1\"/><item v=\"2\"/><item v=\"3\"/></g></r>")
  match compiled.eval_number(d1) {
    Ok(n) => debug_assert(n == 30.0, "d1 sum")
    Err(e) => debug_assert(false, "d1 error: " + e.to_string())
  }
  match compiled.eval_number(d2) {
    Ok(n) => debug_assert(n == 6.0, "d2 sum")
    Err(e) => debug_assert(false, "d2 error: " + e.to_string())
  }
}
