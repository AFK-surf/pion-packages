///| W3C XPath 1.0 §2 axes (all 13), abbreviated syntax, NodeTests, predicates, reverse axis order, and Union `|`.

fn ax_join_names(doc : XPathDoc, nodes : Array[XNode]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < nodes.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(doc.node_name(nodes[i]))
    i = i + 1
  }
  sb.to_string()
}

fn ax_join_vals(doc : XPathDoc, nodes : Array[XNode]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < nodes.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(doc.string_value(nodes[i]))
    i = i + 1
  }
  sb.to_string()
}

fn ax_eval_names(doc : XPathDoc, node : XNode, expr : String) -> String {
  ax_join_names(doc, t_must_nodes_with(doc, node, expr, XPathContext::new()))
}

fn ax_eval_vals(doc : XPathDoc, node : XNode, expr : String) -> String {
  ax_join_vals(doc, t_must_nodes_with(doc, node, expr, XPathContext::new()))
}

let tree_xml : String =
"<?xml version=\"1.0\"?><!--top--><?pi1 hello?><root xmlns:a=\"urn:a\" id=\"r0\">" +
"<s1><c1 id=\"1\">one</c1><c2 id=\"2\">two</c2></s1>" +
"<s2 a:k=\"av\" b=\"bv\"><!--mid--><?pi2 world?><c3 id=\"3\">three</c3><c4 id=\"4\">four</c4><c5 id=\"5\">five</c5></s2>" +
"<s3><c6 id=\"6\">six</c6></s3>" +
"</root>"

test "all_13_axes_forward_and_reverse" {
  let doc = t_must_doc(tree_xml)
  let c4 = t_must_first_node(doc, "//c4")
  let s2 = t_must_first_node(doc, "//s2")

  // 1. child
  debug_assert(ax_eval_names(doc, s2, "child::*") == "c3,c4,c5", "child::*")
  // 2. descendant
  debug_assert(
    ax_eval_names(doc, doc.root_element(), "descendant::*") == "s1,c1,c2,s2,c3,c4,c5,s3,c6",
    "descendant::*",
  )
  // 3. parent
  debug_assert(ax_eval_names(doc, c4, "parent::*") == "s2", "parent::*")
  // 4. ancestor (returned in document order)
  debug_assert(ax_eval_names(doc, c4, "ancestor::*") == "root,s2", "ancestor::*")
  // 5. following-sibling
  debug_assert(ax_eval_names(doc, c4, "following-sibling::*") == "c5", "following-sibling::*")
  // 6. preceding-sibling
  debug_assert(ax_eval_names(doc, c4, "preceding-sibling::*") == "c3", "preceding-sibling::*")
  // 7. following
  debug_assert(ax_eval_names(doc, c4, "following::*") == "c5,s3,c6", "following::*")
  // 8. preceding
  debug_assert(ax_eval_names(doc, c4, "preceding::*") == "s1,c1,c2,c3", "preceding::*")
  // 9. attribute
  debug_assert(ax_eval_vals(doc, s2, "attribute::*") == "av,bv", "attribute::*")
  // 10. namespace (xml and a)
  let ns_nodes = t_must_nodes_with(doc, s2, "namespace::*", XPathContext::new())
  debug_assert(ns_nodes.length() == 2, "s2 has 2 namespace nodes (xml and a)")
  debug_assert(
    t_must_str_with(doc, s2, "string(namespace::xml)", XPathContext::new()) ==
    "http://www.w3.org/XML/1998/namespace",
    "namespace::xml",
  )
  debug_assert(
    t_must_str_with(doc, s2, "string(namespace::a)", XPathContext::new()) == "urn:a",
    "namespace::a",
  )
  // 11. self
  debug_assert(ax_eval_names(doc, c4, "self::*") == "c4", "self::*")
  // 12. descendant-or-self
  debug_assert(ax_eval_names(doc, s2, "descendant-or-self::*") == "s2,c3,c4,c5", "descendant-or-self::*")
  // 13. ancestor-or-self
  debug_assert(ax_eval_names(doc, c4, "ancestor-or-self::*") == "root,s2,c4", "ancestor-or-self::*")
}

test "attribute_and_namespace_parent_and_following_axes" {
  let doc = t_must_doc(tree_xml)
  let attr_b = t_must_first_node(doc, "//s2/@b")
  // Parent of attribute is its owner element
  debug_assert(ax_eval_names(doc, attr_b, "..") == "s2", "attr parent is s2")
  // Following of attribute includes owner element's children/descendants (W3C XPath 1.0 §2.2)
  debug_assert(ax_eval_names(doc, attr_b, "following::*") == "c3,c4,c5,s3,c6", "attr following::*")
  // Preceding of attribute excludes owner element and its ancestors
  debug_assert(ax_eval_names(doc, attr_b, "preceding::*") == "s1,c1,c2", "attr preceding::*")
  // Attribute has no children, no attributes, no namespaces
  debug_assert(t_must_num_with(doc, attr_b, "count(*)", XPathContext::new()) == 0.0, "attr no children")
  debug_assert(t_must_num_with(doc, attr_b, "count(@*)", XPathContext::new()) == 0.0, "attr no attrs")
  debug_assert(t_must_num_with(doc, attr_b, "count(namespace::*)", XPathContext::new()) == 0.0, "attr no ns")
}

test "abbreviated_syntax_and_double_slash_predicate_semantics" {
  let doc = t_must_doc("<r><g><i>a</i><i>b</i></g><g><i>c</i><i>d</i></g></r>")
  // //i[1] == /descendant-or-self::node()/child::i[1] => first i in EACH g!
  debug_assert(
    ax_eval_vals(doc, doc.root(), "//i[1]") == "a,c",
    "//i[1] selects first i of every parent",
  )
  // (//i)[1] => single first i in document
  debug_assert(
    ax_eval_vals(doc, doc.root(), "(//i)[1]") == "a",
    "(//i)[1] selects single first i",
  )
  // . and .. and @
  let i_b = t_must_first_node(doc, "(//i)[2]")
  debug_assert(ax_eval_vals(doc, i_b, ".") == "b", ".")
  debug_assert(ax_eval_vals(doc, i_b, "../i[1]") == "a", "../i[1]")
}

test "reverse_axis_proximity_position_vs_filter_expr" {
  let doc = t_must_doc("<r><a id=\"1\"/><a id=\"2\"/><a id=\"3\"/><a id=\"4\"/></r>")
  let a4 = t_must_first_node(doc, "/r/a[@id='4']")
  // Reverse axis step predicate: [1] is closest (id=3), [last()] is farthest (id=1)
  debug_assert(
    t_must_str_with(doc, a4, "string(preceding-sibling::a[1]/@id)", XPathContext::new()) == "3",
    "preceding-sibling::a[1] is closest",
  )
  debug_assert(
    t_must_str_with(doc, a4, "string(preceding-sibling::a[2]/@id)", XPathContext::new()) == "2",
    "preceding-sibling::a[2] is second closest",
  )
  debug_assert(
    t_must_str_with(doc, a4, "string(preceding-sibling::a[last()]/@id)", XPathContext::new()) == "1",
    "preceding-sibling::a[last()] is farthest",
  )
  // FilterExpr (preceding-sibling::a)[1] always uses forward document order => id=1!
  debug_assert(
    t_must_str_with(doc, a4, "string((preceding-sibling::a)[1]/@id)", XPathContext::new()) == "1",
    "(preceding-sibling::a)[1] is first in document order",
  )
  // Ancestor reverse axis order
  let nested = t_must_doc("<l1><l2><l3><l4/></l3></l2></l1>")
  let l4 = t_must_first_node(nested, "//l4")
  debug_assert(ax_eval_names(nested, l4, "ancestor::*[1]") == "l3", "ancestor::*[1] is parent")
  debug_assert(ax_eval_names(nested, l4, "ancestor::*[2]") == "l2", "ancestor::*[2] is grandparent")
  debug_assert(ax_eval_names(nested, l4, "(ancestor::*)[1]") == "l1", "(ancestor::*)[1] is root")
}

test "node_tests_all_kinds" {
  let doc = t_must_doc(tree_xml)
  // comment()
  debug_assert(ax_eval_vals(doc, doc.root(), "//comment()") == "top,mid", "//comment()")
  // processing-instruction() with and without target
  debug_assert(ax_eval_vals(doc, doc.root(), "//processing-instruction()") == "hello,world", "//processing-instruction()")
  debug_assert(ax_eval_vals(doc, doc.root(), "//processing-instruction('pi2')") == "world", "pi('pi2')")
  debug_assert(ax_eval_vals(doc, doc.root(), "//processing-instruction(\"pi1\")") == "hello", "pi(\"pi1\")")
  // text()
  debug_assert(ax_eval_vals(doc, doc.root(), "/root/s1/*/text()") == "one,two", "text()")
  // node() includes comments, PIs, elements, text
  let s2 = t_must_first_node(doc, "//s2")
  debug_assert(
    t_must_num_with(doc, s2, "count(node())", XPathContext::new()) == 5.0,
    "s2 has 5 child nodes (comment, pi, c3, c4, c5)",
  )
}

test "namespace_node_tests_and_undeclare" {
  let xml_src = "<root xmlns=\"urn:def\" xmlns:p=\"urn:p\"><child/><p:item p:x=\"1\" y=\"2\"/><bare xmlns=\"\"><inner/></bare></root>"
  let doc = t_must_doc(xml_src)
  let ctx = XPathContext::new()
  .with_namespace("d", "urn:def")
  .with_namespace("q", "urn:p")
  // Unprefixed name test NEVER matches default namespace element in XPath 1.0
  debug_assert(t_must_num_with(doc, doc.root(), "count(/root)", ctx) == 0.0, "unprefixed does not match default ns")
  // Prefixed name test matches by URI, regardless of prefix name in XML
  debug_assert(t_must_num_with(doc, doc.root(), "count(/d:root/d:child)", ctx) == 1.0, "d:root/d:child")
  debug_assert(t_must_num_with(doc, doc.root(), "count(/d:root/q:item)", ctx) == 1.0, "q:item matches p:item")
  debug_assert(t_must_str_with(doc, doc.root(), "string(/d:root/q:item/@q:x)", ctx) == "1", "@q:x")
  debug_assert(t_must_str_with(doc, doc.root(), "string(/d:root/q:item/@y)", ctx) == "2", "unprefixed @y has no ns")
  // Wildcard prefix:*
  debug_assert(t_must_num_with(doc, doc.root(), "count(/d:root/q:*)", ctx) == 1.0, "q:*")
  debug_assert(t_must_num_with(doc, doc.root(), "count(/d:root/d:*)", ctx) == 1.0, "d:* (bare has no ns)")
  // Undeclared default namespace xmlns="" -> bare and inner have no namespace!
  debug_assert(t_must_num_with(doc, doc.root(), "count(/d:root/bare/inner)", ctx) == 1.0, "xmlns='' undeclared")
  // Unbound prefix returns UnboundNamespacePrefix
  match eval_with(doc, doc.root(), "/unknown:root", ctx) {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::UnboundNamespacePrefix), "unbound prefix")
    Ok(_) => debug_assert(false, "expected UnboundNamespacePrefix")
  }
}

test "multi_level_predicates_and_union_doc_order_dedup" {
  let doc = t_must_doc("<r><x>1</x><x>2</x><x>3</x><x>4</x><x>5</x></r>")
  // Multi-level predicate: filter > 1 => [2,3,4,5], then [2] => 3, then [last()] => 3
  debug_assert(t_must_str(doc, "/r/x[. > 1][2][last()]") == "3", "chained predicates")
  debug_assert(t_must_str(doc, "/r/x[. > 1][position() >= 2][2]") == "4", "3-level predicates")
  // Union | sorts in document order and deduplicates
  debug_assert(
    ax_eval_vals(doc, doc.root(), "/r/x[5] | /r/x[2] | /r/x[5] | /r/x[1]") == "1,2,5",
    "union doc order + dedup",
  )
  // Union with non-nodeset is TypeError
  match eval(doc, "/r/x | 1") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::TypeError), "union non-nodeset")
    Ok(_) => debug_assert(false, "expected TypeError on union with number")
  }
}
