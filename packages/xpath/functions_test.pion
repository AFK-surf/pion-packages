///| W3C XPath 1.0 §4 all 27 core library functions compliance tests.

fn fn_is_nan(x : Double) -> Bool {
  x != x
}

test "nodeset_functions_7" {
  let xml_src =
  "<root xmlns:ns=\"urn:test\">" +
  "<ns:a xml:id=\"x1\">first</ns:a>" +
  "<b id=\"x2\">second</b>" +
  "<c id=\"x3\">x1 x2</c>" +
  "</root>"
  let doc = t_must_doc(xml_src)
  let ctx = XPathContext::new().with_namespace("t", "urn:test")
  // 1. last(), 2. position()
  debug_assert(t_must_str(doc, "/root/*[position() = 2]") == "second", "position()")
  debug_assert(t_must_str(doc, "/root/*[last()]") == "x1 x2", "last()")
  // 3. count()
  debug_assert(t_must_num(doc, "count(/root/*)") == 3.0, "count()")
  // 4. id() with string and with node-set
  debug_assert(t_must_str(doc, "id('x1')") == "first", "id('x1')")
  debug_assert(t_must_num(doc, "count(id('x2 x1 x2'))") == 2.0, "id() dedup")
  debug_assert(t_must_str(doc, "id('x2 x1')[1]") == "first", "id() doc order")
  debug_assert(t_must_num(doc, "count(id(/root/c))") == 2.0, "id(node-set)")
  // 5. local-name(), 6. namespace-uri(), 7. name()
  debug_assert(
    t_must_str_with(doc, doc.root(), "local-name(/root/t:a)", ctx) == "a",
    "local-name()",
  )
  debug_assert(
    t_must_str_with(doc, doc.root(), "namespace-uri(/root/t:a)", ctx) == "urn:test",
    "namespace-uri()",
  )
  debug_assert(
    t_must_str_with(doc, doc.root(), "name(/root/t:a)", ctx) == "ns:a",
    "name()",
  )
  debug_assert(t_must_str(doc, "local-name(/root/missing)") == "", "local-name(empty)")
  debug_assert(t_must_str(doc, "namespace-uri(/root/b)") == "", "namespace-uri(no ns)")
  // Zero-arg defaults to context node
  let b_node = t_must_first_node(doc, "/root/b")
  debug_assert(
    t_must_str_with(doc, b_node, "name()", ctx) == "b",
    "name() default context node",
  )
}

test "string_functions_10_including_unicode_and_substring_ieee754" {
  let doc = t_must_doc("<r>  hello\t\n  world  </r>")
  // 8. string()
  debug_assert(t_must_str(doc, "string(123)") == "123", "string(123)")
  debug_assert(t_must_str(doc, "string(true())") == "true", "string(true)")
  debug_assert(t_must_str(doc, "string(false())") == "false", "string(false)")
  debug_assert(t_must_str(doc, "string()") == "  hello\t\n  world  ", "string() default")
  // 9. concat()
  debug_assert(t_must_str(doc, "concat('a', 'b', 'c', 4)") == "abc4", "concat")
  // 10. starts-with()
  debug_assert(t_must_bool(doc, "starts-with('foobar', 'foo')"), "starts-with true")
  debug_assert(!t_must_bool(doc, "starts-with('foobar', 'bar')"), "starts-with false")
  debug_assert(t_must_bool(doc, "starts-with('foo', '')"), "starts-with empty")
  // 11. contains()
  debug_assert(t_must_bool(doc, "contains('foobar', 'oba')"), "contains true")
  debug_assert(!t_must_bool(doc, "contains('foobar', 'baz')"), "contains false")
  debug_assert(t_must_bool(doc, "contains('', '')"), "contains empty")
  // 12. substring-before()
  debug_assert(t_must_str(doc, "substring-before('1999/04/01', '/')") == "1999", "substring-before")
  debug_assert(t_must_str(doc, "substring-before('1999', '/')") == "", "substring-before missing")
  // 13. substring-after()
  debug_assert(t_must_str(doc, "substring-after('1999/04/01', '/')") == "04/01", "substring-after")
  debug_assert(t_must_str(doc, "substring-after('1999', '/')") == "", "substring-after missing")
  // 14. substring() — W3C XPath 1.0 §4.2 exact IEEE-754 & Unicode examples!
  debug_assert(t_must_str(doc, "substring('12345', 2, 3)") == "234", "substring basic")
  debug_assert(t_must_str(doc, "substring('12345', 2)") == "2345", "substring 2-arg")
  debug_assert(t_must_str(doc, "substring('12345', 1.5, 2.6)") == "234", "substring round(1.5)=2, round(2.6)=3")
  debug_assert(t_must_str(doc, "substring('12345', 0, 3)") == "12", "substring start=0")
  debug_assert(t_must_str(doc, "substring('12345', 0 div 0, 3)") == "", "substring NaN start")
  debug_assert(t_must_str(doc, "substring('12345', 1, 0 div 0)") == "", "substring NaN len")
  debug_assert(t_must_str(doc, "substring('12345', -42, 1 div 0)") == "12345", "substring -42, +Inf")
  debug_assert(t_must_str(doc, "substring('12345', -1 div 0, 1 div 0)") == "", "substring -Inf, +Inf => NaN")
  debug_assert(t_must_str(doc, "substring('你好世界😀', 2, 3)") == "好世界", "substring Unicode scalar values")
  // 15. string-length() — Unicode scalar values, NOT UTF-8 bytes
  debug_assert(t_must_num(doc, "string-length('你好😀')") == 3.0, "string-length Unicode")
  debug_assert(t_must_num(doc, "string-length('')") == 0.0, "string-length empty")
  // 16. normalize-space()
  debug_assert(t_must_str(doc, "normalize-space()") == "hello world", "normalize-space default")
  debug_assert(t_must_str(doc, "normalize-space('  a\r\n\t b   c  ')") == "a b c", "normalize-space")
  // 17. translate() — first mapping wins, excess deleted, Unicode aware
  debug_assert(t_must_str(doc, "translate('bar', 'abc', 'ABC')") == "BAr", "translate basic")
  debug_assert(t_must_str(doc, "translate('--aaa--', 'abc-', 'ABC')") == "AAA", "translate delete")
  debug_assert(t_must_str(doc, "translate('ab', 'aa', 'XY')") == "Xb", "translate first wins")
  debug_assert(t_must_str(doc, "translate('你好世界', '好世', '坏')") == "你坏界", "translate Unicode")
}

test "boolean_functions_5_including_lang" {
  let xml_src = "<doc xml:lang=\"en-US\"><p>hi</p><q xml:lang=\"FR\"><r>bonjour</r></q></doc>"
  let doc = t_must_doc(xml_src)
  // 18. boolean(), 19. not(), 20. true(), 21. false()
  debug_assert(t_must_bool(doc, "boolean(1)"), "boolean(1)")
  debug_assert(!t_must_bool(doc, "boolean(0)"), "boolean(0)")
  debug_assert(!t_must_bool(doc, "boolean(0 div 0)"), "boolean(NaN)")
  debug_assert(t_must_bool(doc, "boolean('x')"), "boolean('x')")
  debug_assert(!t_must_bool(doc, "boolean('')"), "boolean('')")
  debug_assert(t_must_bool(doc, "boolean(/doc)"), "boolean(non-empty nodeset)")
  debug_assert(!t_must_bool(doc, "boolean(/none)"), "boolean(empty nodeset)")
  debug_assert(t_must_bool(doc, "not(false())"), "not(false())")
  debug_assert(!t_must_bool(doc, "not(true())"), "not(true())")
  // 22. lang()
  let p = t_must_first_node(doc, "//p")
  let r = t_must_first_node(doc, "//r")
  debug_assert(t_must_bool_with(doc, p, "lang('en')", XPathContext::new()), "lang('en') matches en-US")
  debug_assert(t_must_bool_with(doc, p, "lang('EN-us')", XPathContext::new()), "lang case-insensitive")
  debug_assert(!t_must_bool_with(doc, p, "lang('e')", XPathContext::new()), "lang('e') does not match en-US")
  debug_assert(t_must_bool_with(doc, r, "lang('fr')", XPathContext::new()), "lang('fr') matches FR")
  debug_assert(!t_must_bool_with(doc, r, "lang('en')", XPathContext::new()), "inner xml:lang overrides outer")
}

test "number_functions_5_including_xpath_round_neg_half" {
  let doc = t_must_doc("<r><n>10</n><n>20.5</n><n>-0.5</n></r>")
  // 23. number()
  debug_assert(t_must_num(doc, "number('  -42.5  ')") == -42.5, "number('-42.5')")
  debug_assert(t_must_num(doc, "number(true())") == 1.0, "number(true)")
  debug_assert(t_must_num(doc, "number(false())") == 0.0, "number(false)")
  debug_assert(fn_is_nan(t_must_num(doc, "number('+5')")), "number('+5') is NaN in XPath 1.0")
  debug_assert(fn_is_nan(t_must_num(doc, "number('1e5')")), "number('1e5') is NaN in XPath 1.0")
  debug_assert(fn_is_nan(t_must_num(doc, "number('abc')")), "number('abc') is NaN")
  // 24. sum()
  debug_assert(t_must_num(doc, "sum(/r/n)") == 30.0, "sum(/r/n)")
  debug_assert(t_must_num(doc, "sum(/r/missing)") == 0.0, "sum(empty) == 0")
  // 25. floor()
  debug_assert(t_must_num(doc, "floor(1.9)") == 1.0, "floor(1.9)")
  debug_assert(t_must_num(doc, "floor(-1.1)") == -2.0, "floor(-1.1)")
  debug_assert(fn_is_nan(t_must_num(doc, "floor(0 div 0)")), "floor(NaN)")
  // 26. ceiling()
  debug_assert(t_must_num(doc, "ceiling(1.1)") == 2.0, "ceiling(1.1)")
  debug_assert(t_must_num(doc, "ceiling(-1.9)") == -1.0, "ceiling(-1.9)")
  debug_assert(t_must_str(doc, "1 div ceiling(-0.5)") == "-Infinity", "ceiling(-0.5) == -0.0")
  // 27. round() — W3C XPath 1.0 §4.4: ties toward +Inf, and round(-0.5) == -0.0!
  debug_assert(t_must_num(doc, "round(1.5)") == 2.0, "round(1.5) == 2")
  debug_assert(t_must_num(doc, "round(-1.5)") == -1.0, "round(-1.5) == -1")
  debug_assert(t_must_num(doc, "round(-2.5)") == -2.0, "round(-2.5) == -2")
  debug_assert(t_must_num(doc, "round(-0.5)") == 0.0, "round(-0.5) == -0.0")
  debug_assert(t_must_str(doc, "1 div round(-0.5)") == "-Infinity", "1 div round(-0.5) == -Infinity!")
  debug_assert(t_must_str(doc, "1 div round(-0.2)") == "-Infinity", "1 div round(-0.2) == -Infinity!")
  debug_assert(t_must_str(doc, "1 div round(0.2)") == "Infinity", "1 div round(0.2) == +Infinity")
  debug_assert(fn_is_nan(t_must_num(doc, "round(0 div 0)")), "round(NaN)")
  debug_assert(t_must_str(doc, "round(1 div 0)") == "Infinity", "round(+Inf)")
  debug_assert(t_must_str(doc, "round(-1 div 0)") == "-Infinity", "round(-Inf)")
}

test "function_errors_unknown_and_arity" {
  let doc = t_must_doc("<r/>")
  match eval(doc, "no-such-func()") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::UnknownFunction), "unknown function")
    Ok(_) => debug_assert(false, "expected UnknownFunction")
  }
  match eval(doc, "concat('only-one')") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::InvalidArity), "concat arity < 2")
    Ok(_) => debug_assert(false, "expected InvalidArity")
  }
  match eval(doc, "count()") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::InvalidArity), "count arity 0")
    Ok(_) => debug_assert(false, "expected InvalidArity")
  }
  match eval(doc, "count(1)") {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::TypeError), "count expects node-set")
    Ok(_) => debug_assert(false, "expected TypeError")
  }
}
