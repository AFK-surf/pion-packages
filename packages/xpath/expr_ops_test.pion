///| W3C XPath 1.0 §3 expressions: arithmetic, IEEE-754 edge cases, existential comparisons,
///| boolean short-circuiting, variable bindings, and `XPathLimits` DoS protection.

fn eo_is_nan(x : Double) -> Bool {
  x != x
}

test "arithmetic_ieee754_div_mod_and_neg_zero" {
  let doc = t_must_doc("<r/>")
  // Basic arithmetic
  debug_assert(t_must_num(doc, "1 + 2") == 3.0, "1+2")
  debug_assert(t_must_num(doc, "5 - 8") == -3.0, "5-8")
  debug_assert(t_must_num(doc, "3 * 4") == 12.0, "3*4")
  debug_assert(t_must_num(doc, "7 div 2") == 3.5, "7 div 2")
  // XPath mod (truncating division remainder, sign of dividend)
  debug_assert(t_must_num(doc, "5 mod 2") == 1.0, "5 mod 2")
  debug_assert(t_must_num(doc, "5 mod -2") == 1.0, "5 mod -2")
  debug_assert(t_must_num(doc, "-5 mod 2") == -1.0, "-5 mod 2")
  debug_assert(t_must_num(doc, "-5 mod -2") == -1.0, "-5 mod -2")
  // IEEE-754 Infinity & NaN
  debug_assert(t_must_str(doc, "1 div 0") == "Infinity", "1 div 0")
  debug_assert(t_must_str(doc, "-1 div 0") == "-Infinity", "-1 div 0")
  debug_assert(t_must_str(doc, "0 div 0") == "NaN", "0 div 0")
  debug_assert(eo_is_nan(t_must_num(doc, "0 div 0")), "0 div 0 is NaN")
  debug_assert(eo_is_nan(t_must_num(doc, "5 mod 0")), "5 mod 0 is NaN")
  debug_assert(eo_is_nan(t_must_num(doc, "(1 div 0) mod 2")), "Inf mod 2 is NaN")
  debug_assert(t_must_num(doc, "5 mod (1 div 0)") == 5.0, "5 mod Inf == 5")
  // -0.0 stringification is "0", but 1 div (-0.0) is -Infinity
  debug_assert(t_must_str(doc, "-0") == "0", "string(-0) == '0'")
  debug_assert(t_must_str(doc, "1 div (-0)") == "-Infinity", "1 div (-0) == -Infinity")
}

test "existential_nodeset_comparisons" {
  let doc = t_must_doc("<r><a>1</a><a>2</a><a>3</a><b>2</b><b>4</b><c/></r>")
  // NodeSet = NodeSet: true iff any pair matches
  debug_assert(t_must_bool(doc, "/r/a = /r/b"), "a = b (2 == 2)")
  // NodeSet != NodeSet: true iff any pair differs! Even a != a is true when a has {1,2,3}!
  debug_assert(t_must_bool(doc, "/r/a != /r/a"), "a != a is true for {1,2,3}")
  // Empty nodeset comparisons are ALWAYS false (even !=)
  debug_assert(!t_must_bool(doc, "/r/missing = /r/missing"), "empty = empty is false")
  debug_assert(!t_must_bool(doc, "/r/missing != /r/missing"), "empty != empty is false")
  debug_assert(!t_must_bool(doc, "/r/missing != 'foo'"), "empty != 'foo' is false")
  debug_assert(!t_must_bool(doc, "/r/missing < 10"), "empty < 10 is false")
  // NodeSet vs Number / String
  debug_assert(t_must_bool(doc, "/r/a = 2"), "a = 2")
  debug_assert(t_must_bool(doc, "/r/a != 2"), "a != 2 (1 != 2)")
  debug_assert(t_must_bool(doc, "/r/a > 2"), "a > 2 (3 > 2)")
  debug_assert(!t_must_bool(doc, "/r/a > 3"), "not a > 3")
  debug_assert(t_must_bool(doc, "/r/a <= '1'"), "a <= '1'")
  // NodeSet vs Boolean: converts NodeSet to boolean first!
  debug_assert(t_must_bool(doc, "/r/missing = false()"), "empty = false() is true")
  debug_assert(!t_must_bool(doc, "/r/a = false()"), "non-empty = false() is false")
  debug_assert(t_must_bool(doc, "/r/a = true()"), "non-empty = true() is true")
  // NaN comparisons
  debug_assert(!t_must_bool(doc, "(0 div 0) = (0 div 0)"), "NaN = NaN is false")
  debug_assert(t_must_bool(doc, "(0 div 0) != (0 div 0)"), "NaN != NaN is true")
  debug_assert(!t_must_bool(doc, "(0 div 0) < 1"), "NaN < 1 is false")
  debug_assert(!t_must_bool(doc, "(0 div 0) >= 1"), "NaN >= 1 is false")
}

test "boolean_short_circuit_and_variable_bindings" {
  let doc = t_must_doc("<r><item price=\"15\">A</item><item price=\"25\">B</item></r>")
  // Short-circuit: false() and $unbound must NOT evaluate $unbound!
  debug_assert(!t_must_bool(doc, "false() and $unbound"), "and short-circuit")
  debug_assert(t_must_bool(doc, "true() or $unbound"), "or short-circuit")
  // Variable bindings ($var)
  let ctx = XPathContext::new()
  .with_variable("min_price", XPathValue::Number(20.0))
  .with_variable("label", XPathValue::Str("B"))
  debug_assert(
    t_must_str_with(doc, doc.root(), "string(//item[@price >= $min_price])", ctx) == "B",
    "variable number in predicate",
  )
  debug_assert(
    t_must_num_with(doc, doc.root(), "count(//item[. = $label])", ctx) == 1.0,
    "variable string in predicate",
  )
  // Unbound variable error
  match eval_with(doc, doc.root(), "$missing", ctx) {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::UnboundVariable), "unbound variable")
    Ok(_) => debug_assert(false, "expected UnboundVariable")
  }
}

test "limits_dos_protection_steps_and_nodes" {
  let sb = StringBuilder::new()
  sb.write_string("<r>")
  let mut i = 0
  while i < 50 {
    sb.write_string("<a><b>x</b></a>")
    i = i + 1
  }
  sb.write_string("</r>")
  let doc = t_must_doc(sb.to_string())
  // Tight max_nodes limit
  let ctx_nodes = XPathContext::new().with_limits(XPathLimits::new(64, 100000L, 10, 65536))
  match eval_with(doc, doc.root(), "//*", ctx_nodes) {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::LimitExceeded), "max_nodes limit")
    Ok(_) => debug_assert(false, "expected LimitExceeded for max_nodes")
  }
  // Tight max_steps limit
  let ctx_steps = XPathContext::new().with_limits(XPathLimits::new(64, 25L, 10000, 65536))
  match eval_with(doc, doc.root(), "//a//b/ancestor::*", ctx_steps) {
    Err(e) => debug_assert(e.is_kind(XPathErrorKind::LimitExceeded), "max_steps limit")
    Ok(_) => debug_assert(false, "expected LimitExceeded for max_steps")
  }
}
