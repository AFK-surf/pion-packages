///| Pion side of the `packages/xpath` red-team differential harness (RT-xpath).
///|
///| usage: pion_runner PACK [default]
///|   PACK is a sequence of records `@@<TAG> <byte_len>\n<bytes>\n`:
///|     DOC   XML source; starts a new document (namespace/variable bindings reset)
///|     NS    "prefix uri" binding added to the XPathContext of the current document
///|     VARS  "name value" string variable;  VARN "name value" number variable
///|     Q     XPath 1.0 expression evaluated with the root node as context node
///| Output per Q: `=== <n>` then one of
///|   `ERR`                       (parse or evaluation error; kinds are not compared)
///|   `NUM <16 hex digits>`       (IEEE-754 bits of a number result)
///|   `STR <escaped>` / `BOOL true|false`
///|   `NODES <count>` + one `  <kind> <name> <escaped string-value>` line per node
///| A DOC that fails to parse prints `=== DOCERR` and every Q until the next DOC prints `ERR`.
///| Escaping and truncation (string-values longer than 256 bytes are cut to 256 bytes plus
///| `...<len>`) are byte-identical to `tools/rust_oracle` and `tools/c_oracle`.

import "xpath"

///| Resource caps far above the corpus so that differences come from XPath rules, not limits.
fn audit_limits() -> xpath::XPathLimits {
  xpath::XPathLimits::new(128, 1000000000L, 100000000, 1073741824)
}

///|
fn hex1(d : Int) -> Int {
  if d < 10 {
    48 + d
  } else {
    87 + d
  }
}

///|
fn esc(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let lim = if n > 256 { 256 } else { n }
  let mut i = 0
  while i < lim {
    let b = s.code_unit_at(i)
    if b == 0x5C {
      sb.write_string("\\\\")
    } else if b == 0x0A {
      sb.write_string("\\n")
    } else if b == 0x0D {
      sb.write_string("\\r")
    } else if b == 0x09 {
      sb.write_string("\\t")
    } else if b < 0x20 || b == 0x7F {
      sb.write_string("\\x")
      sb.write_byte(hex1(b >> 4).to_byte())
      sb.write_byte(hex1(b & 15).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  if n > 256 {
    sb.write_string("..." + n.to_string())
  }
}

///|
fn hex64(sb : StringBuilder, x : Double) -> Unit {
  let bits = x.to_bits()
  let mut sh = 60
  while sh >= 0 {
    let d = ((bits >> sh) & 15L).to_int()
    sb.write_byte(hex1(d).to_byte())
    sh = sh - 4
  }
}

///|
fn kind_str(k : xpath::XNodeKind) -> String {
  match k {
    xpath::XNodeKind::Root => "root"
    xpath::XNodeKind::Element => "element"
    xpath::XNodeKind::Text => "text"
    xpath::XNodeKind::Comment => "comment"
    xpath::XNodeKind::ProcessingInstruction => "pi"
    xpath::XNodeKind::Attribute => "attribute"
    xpath::XNodeKind::Namespace => "namespace"
  }
}

///|
fn emit_value(sb : StringBuilder, doc : xpath::XPathDoc, v : xpath::XPathValue) -> Unit {
  match v {
    xpath::XPathValue::Number(n) => {
      sb.write_string("NUM ")
      hex64(sb, n)
      sb.write_string("\n")
    }
    xpath::XPathValue::Str(s) => {
      sb.write_string("STR ")
      esc(sb, s)
      sb.write_string("\n")
    }
    xpath::XPathValue::Boolean(b) => sb.write_string(if b { "BOOL true\n" } else { "BOOL false\n" })
    xpath::XPathValue::NodeSet(ns) => {
      sb.write_string("NODES " + ns.length().to_string() + "\n")
      let mut i = 0
      while i < ns.length() {
        let nd = ns[i]
        sb.write_string("  " + kind_str(doc.node_kind(nd)) + " ")
        esc(sb, doc.node_name(nd))
        sb.write_string(" ")
        esc(sb, doc.string_value(nd))
        sb.write_string("\n")
        i = i + 1
      }
    }
  }
}

///|
fn parse_len(s : String, start : Int, end : Int) -> Int {
  let mut acc = 0
  let mut i = start
  while i < end {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn split_pair(s : String) -> (String, String) {
  let n = s.length()
  let mut i = 0
  while i < n && s.code_unit_at(i) != 0x20 {
    i = i + 1
  }
  if i >= n {
    (s, "")
  } else {
    (s.slice(0, i), s.slice(i + 1, n))
  }
}

///|
fn run(pack : String, lim : xpath::XPathLimits) -> String {
  let out = StringBuilder::new()
  let n = pack.length()
  let mut pos = 0
  let mut qn = 0
  let mut doc_opt : Option[xpath::XPathDoc] = None
  let mut ctx = xpath::XPathContext::new().with_limits(lim)
  while pos < n {
    // "@@TAG LEN\n"
    let tag_start = pos + 2
    let mut sp = tag_start
    while sp < n && pack.code_unit_at(sp) != 0x20 {
      sp = sp + 1
    }
    let tag = pack.slice(tag_start, sp)
    let mut nl = sp + 1
    while nl < n && pack.code_unit_at(nl) != 0x0A {
      nl = nl + 1
    }
    let len = parse_len(pack, sp + 1, nl)
    let body = pack.slice(nl + 1, nl + 1 + len)
    pos = nl + 1 + len + 1
    if tag == "DOC" {
      ctx = xpath::XPathContext::new().with_limits(lim)
      match xpath::XPathDoc::parse(body) {
        Ok(d) => doc_opt = Some(d)
        Err(_) => {
          doc_opt = None
          out.write_string("=== DOCERR\n")
        }
      }
    } else if tag == "NS" {
      let (p, u) = split_pair(body)
      ctx = ctx.with_namespace(p, u)
    } else if tag == "VARS" {
      let (k, v) = split_pair(body)
      ctx = ctx.with_variable(k, xpath::XPathValue::Str(v))
    } else if tag == "VARN" {
      let (k, v) = split_pair(body)
      let num = match xpath::eval_str("<r/>", "number('" + v + "')") {
        Ok(xpath::XPathValue::Number(x)) => x
        _ => 0.0
      }
      ctx = ctx.with_variable(k, xpath::XPathValue::Number(num))
    } else if tag == "Q" {
      out.write_string("=== " + qn.to_string() + "\n")
      qn = qn + 1
      match doc_opt {
        None => out.write_string("ERR\n")
        Some(doc) =>
        match xpath::XPathExpr::parse_with_limits(body, lim) {
          Err(_) => out.write_string("ERR\n")
          Ok(e) =>
          match e.eval_with(doc, doc.root(), ctx) {
            Ok(v) => emit_value(out, doc, v)
            Err(_) => out.write_string("ERR\n")
          }
        }
      }
    }
  }
  out.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: pion_runner PACK")
    return 2
  }
  // Optional 2nd argument `default`: run with `XPathLimits::default()` (what `xpath::eval*` use).
  let lim = if args.length() > 2 && args[2] == "default" {
    xpath::XPathLimits::default()
  } else {
    audit_limits()
  }
  match fs_read(world, args[1]) {
    Ok(s) => {
      io_print(world, run(s, lim))
      0
    }
    Err(_) => {
      io_eprintln(world, "cannot read " + args[1])
      2
    }
  }
}
