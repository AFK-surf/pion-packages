///| RT-xpath: data model, namespace axis, axes/position semantics and API value semantics.
///| `p2_*` FAIL while the defect exists; `control_*` must PASS.

import "xpath"

///| P2-1: an explicit (legal) `xmlns:xml="http://www.w3.org/XML/1998/namespace"` removes the
///| implicit `xml` namespace node from that element and all its descendants.
test "p2_explicit_xmlns_xml_keeps_xml_namespace_node" {
  let x = "<a xmlns:xml=\"http://www.w3.org/XML/1998/namespace\" xmlns:p=\"u\"><b/></a>"
  debug_assert(count_of(x, "/a/namespace::xml") == 1, "namespace::xml missing on <a>")
  debug_assert(count_of(x, "/a/b/namespace::xml") == 1, "namespace::xml missing on <b>")
  debug_assert(count_of(x, "/a/namespace::*") == 2, "expected xml + p")
}

///| P2-2: `with_namespace` / `with_variable` return a "new" context but mutate the receiver's
///| maps, so a context derived for one query changes every context built from the same base.
test "p2_context_builders_do_not_alias" {
  let doc = must_doc("<r xmlns:a=\"urn:one\"><a:x>1</a:x></r>")
  let base = xpath::XPathContext::new().with_namespace("p", "urn:one")
  let _other = base.with_namespace("p", "urn:two")
  match ev_ctx(doc, "count(//p:x)", base) {
    Ok(v) => debug_assert(same_num(v.to_number(doc), 1.0), "base context now maps p -> urn:two")
    Err(m) => debug_assert(false, m)
  }
  let v0 = xpath::XPathContext::new().with_variable("v", xpath::XPathValue::Number(1.0))
  let _v1 = v0.with_variable("v", xpath::XPathValue::Number(2.0))
  match ev_ctx(doc, "$v", v0) {
    Ok(v) => debug_assert(same_num(v.to_number(doc), 1.0), "base context now binds $v = 2")
    Err(m) => debug_assert(false, m)
  }
}

///| P2-3: a node-set variable supplied in reverse document order is used as-is: `|` assumes both
///| operands are sorted and `$v[1]` is not the first node in document order.
test "p2_nodeset_variable_is_normalized_to_document_order" {
  let doc = must_doc("<r><a/><b/></r>")
  let ns = match ev(doc, "/r/*") {
    Ok(xpath::XPathValue::NodeSet(n)) => n
    _ => []
  }
  debug_assert(ns.length() == 2, "setup")
  let rev : Array[xpath::XNode] = [ns[1], ns[0]]
  let ctx = xpath::XPathContext::new().with_variable("v", xpath::XPathValue::NodeSet(rev))
  match ev_ctx(doc, "count($v | /r/a)", ctx) {
    Ok(v) => debug_assert(same_num(v.to_number(doc), 2.0), "union produced duplicates")
    Err(m) => debug_assert(false, m)
  }
  match ev_ctx(doc, "name($v[1])", ctx) {
    Ok(v) => debug_assert(v.to_string(doc) == "a", "$v[1] = " + v.to_string(doc))
    Err(m) => debug_assert(false, m)
  }
}

///| P2-4: `XPathDoc::parse` rejects every document that carries a DOCTYPE (even `<!DOCTYPE r>`),
///| i.e. most XHTML / DocBook / SVG files, and never enables DTD-declared IDs for `id()`.
test "p2_doctype_document_is_queryable" {
  match xpath::XPathDoc::parse("<!DOCTYPE r><r><a/></r>") {
    Ok(d) =>
    match xpath::eval_number(d, "count(/r/a)") {
      Ok(n) => debug_assert(same_num(n, 1.0), "count")
      Err(e) => debug_assert(false, e.to_string())
    }
    Err(e) => debug_assert(false, "DOCTYPE document rejected: " + e.to_string())
  }
}

///| Control: §5 data model — CDATA/entity text merges into one text node, no empty text nodes.
test "control_text_node_merging" {
  let x = "<r><a>x<![CDATA[y]]>&amp;z</a><b><![CDATA[]]></b><c>1<!--c-->2</c></r>"
  debug_assert(count_of(x, "/r/a/text()") == 1, "CDATA + text + entity = one text node")
  debug_assert(str_of(x, "/r/a") == "xy&z", "merged value")
  debug_assert(count_of(x, "/r/b/text()") == 0, "empty CDATA is not a text node")
  debug_assert(count_of(x, "/r/c/text()") == 2, "a comment splits text")
}

///| Control: §2.2 reverse axes — proximity positions inside the step, document order outside.
test "control_reverse_axis_positions" {
  let x = "<r><a id=\"1\"/><a id=\"2\"><b><c/></b></a><a id=\"3\"/><a id=\"4\"/></r>"
  debug_assert(str_of(x, "/r/a[4]/preceding-sibling::*[1]/@id") == "3", "nearest preceding sibling")
  debug_assert(str_of(x, "(/r/a[4]/preceding-sibling::*)[1]/@id") == "1", "filter = document order")
  debug_assert(names_of(x, "//c/ancestor::*[1]") == "b", "nearest ancestor")
  debug_assert(names_of(x, "//c/ancestor::*") == "r,a,b", "result in document order")
  debug_assert(names_of(x, "/r/a[3]/preceding::*[2]") == "b", "preceding proximity")
  debug_assert(
    str_of(x, "string(/r/a[4]/preceding-sibling::*[position() < 3][last()]/@id)") == "2",
    "second predicate also counts in reverse",
  )
}

///| Control: following/preceding exclude ancestors/descendants; attribute/namespace parents.
test "control_following_preceding_attribute_namespace" {
  let x = "<r xmlns:p=\"u\"><a><b x=\"1\"><c/></b></a><d/></r>"
  debug_assert(names_of(x, "//b/@x/following::*") == "c,d", "owner's descendants follow an attribute")
  debug_assert(names_of(x, "//b/@x/preceding::*") == "", "ancestors are not preceding")
  debug_assert(names_of(x, "//b/following::*") == "d", "descendants are not following")
  debug_assert(names_of(x, "//b/@x/parent::node()") == "b", "parent of attribute")
  debug_assert(names_of(x, "//b/namespace::p/..") == "b", "parent of namespace node")
  debug_assert(names_of(x, "//b/namespace::p/following::*") == "c,d", "namespace node following")
  debug_assert(count_of(x, "//b/@x/following-sibling::node()") == 0, "attributes have no siblings")
  debug_assert(count_of(x, "//b/@x/self::*") == 0, "self::* principal type is element")
}

///| Control: §5 document order: element < its namespace nodes < its attributes < its children.
test "control_document_order_namespace_attribute" {
  let x = "<r xmlns:p=\"u\" a=\"1\"><k/></r>"
  debug_assert(names_of(x, "(/r/@* | /r/namespace::* | /r | /r/k)[1]") == "r", "element first")
  debug_assert(names_of(x, "(/r/@* | /r/namespace::p)[1]") == "p", "namespace before attribute")
  debug_assert(names_of(x, "(/r/@* | /r/namespace::p | /r/k)[last()]") == "k", "children last")
}

///| Control: namespace axis inheritance, override, xmlns="" undeclaration, implicit xml.
test "control_namespace_axis_model" {
  let x = "<r xmlns=\"urn:d\" xmlns:p=\"urn:p\"><x xmlns=\"\"><y/></x><p:z xmlns:p=\"urn:p2\"/></r>"
  debug_assert(count_of(x, "/*/namespace::*") == 3, "xml, default, p")
  debug_assert(count_of(x, "//*[local-name()='y']/namespace::*") == 2, "undeclared default")
  debug_assert(str_of(x, "//*[local-name()='z']/namespace::p") == "urn:p2", "override")
  debug_assert(
    str_of(x, "/*/namespace::xml") == "http://www.w3.org/XML/1998/namespace",
    "implicit xml",
  )
  debug_assert(count_of(x, "/r") == 0, "unprefixed name test never matches the default namespace")
  debug_assert(str_of(x, "name(/*/namespace::p)") == "p", "name() of namespace node = prefix")
  debug_assert(str_of(x, "namespace-uri(/*/namespace::p)") == "", "namespace-uri() of ns node")
}

///| Control: §3.4 comparisons — existential node-sets, boolean conversion of node-sets.
test "control_nodeset_comparisons" {
  let x = "<r><a>1</a><a>2</a><b>2</b><b>3</b></r>"
  debug_assert(str_of(x, "string(//a = //b)") == "true", "some a = some b")
  debug_assert(str_of(x, "string(//a != //b)") == "true", "some a != some b")
  debug_assert(str_of(x, "string(//a = 2)") == "true", "a = number")
  debug_assert(str_of(x, "string(//a != 2)") == "true", "a != number (1 != 2)")
  debug_assert(str_of(x, "string(//zz = false())") == "true", "empty set = false()")
  debug_assert(str_of(x, "string(//zz != //zz)") == "false", "empty vs empty")
  debug_assert(str_of(x, "string(//zz < true())") == "true", "boolean(empty)=0 < 1")
  debug_assert(str_of(x, "string(//a >= '2')") == "true", "relational with string")
}

///| Control: string functions — translate, normalize-space (ASCII only), lang().
test "control_string_functions" {
  let x = "<r xml:lang=\"en-US\"><a xml:lang=\"EN\">x</a><b xml:lang=\"\">y</b><c>z</c></r>"
  debug_assert(str_of(x, "translate('bar','abc','ABC')") == "BAr", "translate")
  debug_assert(str_of(x, "translate('--aaa--','abc-','ABC')") == "AAA", "translate delete")
  debug_assert(str_of(x, "translate('aab','aa','xy')") == "xxb", "first occurrence wins")
  debug_assert(
    str_of(x, "normalize-space(' a   b ')") == "a   b",
    "NBSP is not collapsed",
  )
  debug_assert(count_of(x, "//*[lang('en')]") == 3, "lang inherits; xml:lang='' cancels")
  debug_assert(count_of(x, "//*[lang('en-us')]") == 2, "case-insensitive full tag")
  debug_assert(count_of(x, "//*[lang('e')]") == 0, "sub-tag boundary")
  debug_assert(count_of(x, "id('nope')") == 0, "id() miss")
}
