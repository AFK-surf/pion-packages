///| RT-xpath: W3C XPath 1.0 §3.7 lexical disambiguation and grammar corners (all controls).

import "xpath"

///|
fn lx_doc() -> String {
  "<r><div><div>3</div></div><and><or>1</or></and><mod>2</mod><a-b>5</a-b><a>7</a><b>2</b>" +
  "<node><node/></node><text><text>t</text></text><comment/><processing-instruction/></r>"
}

///| Control: operator names vs NCNames, `*` vs MultiplyOperator, `-` vs hyphen.
test "control_operator_name_disambiguation" {
  let d = lx_doc()
  debug_assert(same_num(num_of(d, "/r/div/div * /r/mod"), 6.0), "div/div * mod")
  debug_assert(same_num(num_of(d, "/r/div/div div /r/mod"), 1.5), "div div mod")
  debug_assert(same_num(num_of(d, "/r/mod mod 3"), 2.0), "mod mod 3")
  debug_assert(str_of(d, "string(/r/and/or)") == "1", "and/or as names")
  debug_assert(same_num(num_of(d, "/r/a-b"), 5.0), "a-b is one NCName")
  debug_assert(same_num(num_of(d, "/r/a - /r/b"), 5.0), "a - b is subtraction")
  debug_assert(same_num(num_of(d, "/r/a*/r/b"), 14.0), "a*/r/b")
  debug_assert(same_num(num_of(d, "count(*/*)"), 10.0), "*/* name tests")
  debug_assert(same_num(num_of(d, "count(/r/node/node())"), 1.0), "node/node()")
  debug_assert(same_num(num_of(d, "count(/r/text/text)"), 1.0), "text/text element")
  debug_assert(same_num(num_of(d, "count(/r/comment)"), 1.0), "comment as element name")
  debug_assert(same_num(num_of(d, "count(/r/processing-instruction)"), 1.0), "pi as element name")
  debug_assert(names_of(d, "div") == "", "bare div is a name test")
  debug_assert(same_num(num_of(d, "count(child :: r)"), 1.0), "whitespace around ::")
}

///| Control: `//a[1]` vs `/descendant::a[1]` vs `(//a)[1]`, FilterExpr then path, unary chains.
test "control_abbreviations_and_filters" {
  let d = lx_doc()
  debug_assert(same_num(num_of(d, "count(//div[1])"), 2.0), "//div[1]")
  debug_assert(same_num(num_of(d, "count(/descendant::div[1])"), 1.0), "/descendant::div[1]")
  debug_assert(same_num(num_of(d, "count((//div)[1])"), 1.0), "(//div)[1]")
  debug_assert(names_of(d, "(/r/a | /r/b)[2]") == "b", "(a | b)[2]")
  debug_assert(same_num(num_of(d, "(/r/a | /r/b)[2]/text()"), 2.0), "filter then step")
  debug_assert(same_num(num_of(d, "---1"), -1.0), "---1")
  debug_assert(same_num(num_of(d, ".5 + 5."), 5.5), ".5 and 5.")
  debug_assert(str_of(d, "string(1 < 2 < 3)") == "true", "left-assoc relational")
  debug_assert(str_of(d, "string(3 > 2 > 1)") == "false", "(3>2)>1 = 1>1")
}

///| Control: malformed expressions are errors, not silently accepted.
test "control_syntax_errors" {
  let bad = [
    "", "/r/", "1 +", "()", "(1", "1)", "[1]", "@", "child::", "foo::a", "/r/a[]", "'unterminated",
    "$", "a::b", "1..2", "a!b", "1 and", "or 1", "1e5", "1.2.3", "a:", ":a",
  ]
  let mut i = 0
  while i < bad.length() {
    match xpath::XPathExpr::parse(bad[i]) {
      Ok(_) => debug_assert(false, "accepted malformed expression: '" + bad[i] + "'")
      Err(_) => ()
    }
    i = i + 1
  }
}
