///| RT-xpath: XPathLimits false rejections (valid queries on modest inputs refused).
///| `p1_*` FAIL while the defect exists; `control_*` must PASS.

import "xpath"

///| P1-4: `max_depth` is clamped to <= 128 and every left-nested BinOp/Union level costs one
///| evaluation frame, so a generated `@id='0' or ... or @id='200'` filter (iteratively parsed,
///| no recursion needed) is rejected with LimitExceeded even with the largest allowed limits.
test "p1_or_chain_of_201_terms_evaluates" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("@id='" + i.to_string() + "' or ")
    i = i + 1
  }
  sb.write_string("@id='L'")
  let n = num_of("<r id=\"L\"/>", "count(/r[" + sb.to_string() + "])")
  debug_assert(same_num(n, 1.0), "201-term or-chain gave " + show_num(n))
}

///|
test "p1_plus_chain_of_200_terms_evaluates" {
  let n = num_of("<r/>", repeat_join("1", "+", 200))
  debug_assert(same_num(n, 200.0), "1+1+...(200) gave " + show_num(n))
}

///|
test "p1_union_chain_of_200_terms_evaluates" {
  let n = count_of("<r><a/></r>", repeat_join("/r/a", "|", 200))
  debug_assert(n == 1, "/r/a|...(200) gave " + n.to_string())
}

///| P1-4: even `XPathLimits::new(100000, ...)` cannot lift the cap (silently clamped to 128).
test "p1_max_depth_above_128_is_honoured" {
  let ctx = xpath::XPathContext::new().with_limits(
    xpath::XPathLimits::new(100000, 1000000000L, 100000000, 1073741824),
  )
  let doc = must_doc("<r/>")
  match ev_ctx(doc, repeat_join("1", "+", 300), ctx) {
    Ok(v) => debug_assert(same_num(v.to_number(doc), 300.0), "wrong sum")
    Err(m) => debug_assert(false, "max_depth=100000 still rejects a 300-term sum: " + m)
  }
}

///| P1-5: `xpath::eval` (no way to pass limits) refuses `count(/r/e)` on a 1.2 MB document with
///| 300,000 empty children: the 200,000-node `max_nodes` default caps every intermediate set.
test "p1_default_limits_count_300k_children" {
  let sb = StringBuilder::new()
  sb.write_string("<r>")
  let mut i = 0
  while i < 300000 {
    sb.write_string("<e/>")
    i = i + 1
  }
  sb.write_string("</r>")
  let doc = must_doc(sb.to_string())
  match xpath::eval_number(doc, "count(/r/e)") {
    Ok(n) => debug_assert(same_num(n, 300000.0), "count = " + show_num(n))
    Err(e) => debug_assert(false, "default limits reject count(/r/e): " + e.to_string())
  }
}

///| P1-5: `//@k` materializes descendant-or-self::node() (elements + text = 240,001 nodes) before
///| the attribute step, so 120,000 attributes in a 2.1 MB document trip max_nodes.
test "p1_default_limits_descendant_attributes_120k" {
  let sb = StringBuilder::new()
  sb.write_string("<r>")
  let mut i = 0
  while i < 120000 {
    sb.write_string("<e k=\"" + i.to_string() + "\">t</e>")
    i = i + 1
  }
  sb.write_string("</r>")
  let doc = must_doc(sb.to_string())
  match xpath::eval_number(doc, "count(//@k)") {
    Ok(n) => debug_assert(same_num(n, 120000.0), "count = " + show_num(n))
    Err(e) => debug_assert(false, "default limits reject count(//@k): " + e.to_string())
  }
}

///| Control: genuinely deep *recursive* nesting is rejected cleanly (error, no crash).
test "control_deep_parens_rejected_cleanly" {
  let src = repeat_join("(", "", 5000) + "1" + repeat_join(")", "", 5000)
  match xpath::XPathExpr::parse(src) {
    Ok(_) => debug_assert(false, "5000 nested parens accepted")
    Err(e) => debug_assert(e.is_kind(xpath::XPathErrorKind::LimitExceeded), "wrong error kind")
  }
}

///| Control: 100 nested parens / 60 nested predicates are fine.
test "control_moderate_nesting_ok" {
  let n = num_of("<r/>", repeat_join("(", "", 100) + "7" + repeat_join(")", "", 100))
  debug_assert(same_num(n, 7.0), "100 parens")
  let doc = "<a><a><a><a/></a></a></a>"
  debug_assert(same_num(num_of(doc, "count(/a[a[a[a]]])"), 1.0), "nested predicates")
}

///| Control: the step budget does stop a cartesian `//*//*//*` blow-up with an error.
test "control_step_budget_stops_cartesian" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("<a>")
    i = i + 1
  }
  i = 0
  while i < 200 {
    sb.write_string("</a>")
    i = i + 1
  }
  let doc = must_doc(sb.to_string())
  match xpath::eval(doc, "count(//*//*//*//*)") {
    Ok(_) => ()
    Err(e) => debug_assert(e.is_kind(xpath::XPathErrorKind::LimitExceeded), "wrong error kind")
  }
}
