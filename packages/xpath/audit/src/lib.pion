///| Helpers shared by the `packages/xpath` red-team tests (test-only package; see REPORT.md).

import "xpath"

///| Generous limits so that a test measures XPath semantics, not the resource caps.
pub fn big_limits() -> xpath::XPathLimits {
  xpath::XPathLimits::new(128, 1000000000L, 100000000, 1073741824)
}

///| Parse `xml` or abort the test with a message.
pub fn must_doc(xml : String) -> xpath::XPathDoc {
  match xpath::XPathDoc::parse(xml) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "XML did not parse: " + e.to_string())
      panic()
    }
  }
}

///| Evaluate `expr` from the root with big limits: `Ok(value)` or `Err(message)`.
pub fn ev(doc : xpath::XPathDoc, expr : String) -> Result[xpath::XPathValue, String] {
  ev_ctx(doc, expr, xpath::XPathContext::new().with_limits(big_limits()))
}

///|
pub fn ev_ctx(
  doc : xpath::XPathDoc,
  expr : String,
  ctx : xpath::XPathContext,
) -> Result[xpath::XPathValue, String] {
  match xpath::XPathExpr::parse_with_limits(expr, ctx.limits) {
    Err(e) => Err("parse error: " + e.to_string())
    Ok(c) =>
    match c.eval_with(doc, doc.root(), ctx) {
      Ok(v) => Ok(v)
      Err(e) => Err("eval error: " + e.to_string())
    }
  }
}

///| `string(expr)` of an expression on `xml`, or `ERR: ...`.
pub fn str_of(xml : String, expr : String) -> String {
  let doc = must_doc(xml)
  match ev(doc, expr) {
    Ok(v) => v.to_string(doc)
    Err(m) => "ERR: " + m
  }
}

///| `number(expr)`; NaN on error (tests compare with `same_num`, which reports errors).
pub fn num_of(xml : String, expr : String) -> Double {
  let doc = must_doc(xml)
  match ev(doc, expr) {
    Ok(v) => v.to_number(doc)
    Err(_) => 0.0 / 0.0
  }
}

///| Bit-exact Double comparison (distinguishes -0 from +0; NaN equals NaN).
pub fn same_num(a : Double, b : Double) -> Bool {
  a.to_bits() == b.to_bits() || (a != a && b != b)
}

///| Render a Double for a failure message.
pub fn show_num(x : Double) -> String {
  x.to_string() + " (bits " + x.to_bits().to_string() + ")"
}

///| `count(expr)`-style helper: node count of a node-set result, or -1 on error / non-node-set.
pub fn count_of(xml : String, expr : String) -> Int {
  let doc = must_doc(xml)
  match ev(doc, expr) {
    Ok(xpath::XPathValue::NodeSet(ns)) => ns.length()
    _ => -1
  }
}

///| Join `name()` of every node of a node-set result with ',' (or `ERR`).
pub fn names_of(xml : String, expr : String) -> String {
  let doc = must_doc(xml)
  match ev(doc, expr) {
    Ok(xpath::XPathValue::NodeSet(ns)) => {
      let sb = StringBuilder::new()
      let mut i = 0
      while i < ns.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(doc.node_name(ns[i]))
        i = i + 1
      }
      sb.to_string()
    }
    Ok(_) => "NOT-A-NODE-SET"
    Err(m) => "ERR: " + m
  }
}

///| `n` copies of `s` joined by `sep`.
pub fn repeat_join(s : String, sep : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| True when `s` starts with `p` (byte-wise).
pub fn starts(s : String, p : String) -> Bool {
  if p.length() > s.length() {
    return false
  }
  s.slice(0, p.length()) == p
}
