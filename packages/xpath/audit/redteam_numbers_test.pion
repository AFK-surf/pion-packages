///| RT-xpath: IEEE-754 / W3C XPath 1.0 §3.5, §4.2, §4.4 number semantics.
///| `p1_*` FAIL while the defect exists; `control_*` must PASS.

import "xpath"

///| P1-1: §4.2 number->string must never use exponent notation ("1e+21", "1e-07").
test "p1_string_of_large_integer_has_no_exponent" {
  let s = str_of("<r/>", "string(1000000000000000000000)")
  debug_assert(s == "1000000000000000000000", "string(10^21) = " + s)
}

///|
test "p1_string_of_2_pow_60_is_plain_integer" {
  let s = str_of("<r/>", "string(1152921504606846976)")
  debug_assert(s == "1152921504606846976", "string(2^60) = " + s)
}

///|
test "p1_string_of_small_fraction_has_no_exponent" {
  let s = str_of("<r/>", "string(0.0000001)")
  debug_assert(s == "0.0000001", "string(0.0000001) = " + s)
  let t = str_of("<r/>", "string(-0.0000000065809376)")
  debug_assert(t == "-0.0000000065809376", "string(-6.5809376e-9) = " + t)
}

///| P1-1 reaches every string conversion: concat(), comparisons with strings, string-length().
test "p1_number_to_string_exponent_leaks_into_concat_and_equality" {
  let s = str_of("<r/>", "concat(1 div 10000000, '|', 100000000000000000000)")
  debug_assert(s == "0.0000001|100000000000000000000", "concat = " + s)
  let b = str_of("<r/>", "string(string(100000000000000000000) = '100000000000000000000')")
  debug_assert(b == "true", "string(1e20) = '1e20 digits' -> " + b)
}

///| P1-2: §4.4/§3.7 string->number must be the IEEE-754 double nearest to the decimal.
test "p1_number_literal_is_correctly_rounded" {
  let x = num_of("<r/>", "0.49999999999999994")
  debug_assert(same_num(x, 0.49999999999999994), "0.49999999999999994 parsed as " + show_num(x))
  let y = num_of("<r/>", "number('0.44170928548011157')")
  debug_assert(same_num(y, 0.44170928548011157), "number('0.44170928548011157') = " + show_num(y))
  let z = num_of("<r/>", "number('2340032014150785536')")
  debug_assert(same_num(z, 2340032014150785536.0), "number('2340032014150785536') = " + show_num(z))
}

///| P1-2 consequence: round() of a value just below 0.5 gives 1.
test "p1_round_just_below_half_is_zero" {
  let x = num_of("<r/>", "round(0.49999999999999994)")
  debug_assert(same_num(x, 0.0), "round(0.49999999999999994) = " + show_num(x))
}

///| P1-2: a long but valid decimal turns into NaN (frac_val and frac_scale both overflow to +Inf).
test "p1_long_fraction_is_not_nan" {
  let ones = repeat_join("1", "", 330)
  let x = num_of("<r/>", "number('0." + ones + "')")
  debug_assert(same_num(x, 0.1111111111111111), "number('0.111...(330 digits)') = " + show_num(x))
  let y = num_of("<r/>", "0." + ones)
  debug_assert(same_num(y, 0.1111111111111111), "literal 0.111...(330 digits) = " + show_num(y))
}

///| P1-3: §3.5 `mod` is the IEEE-754 / ECMAScript `%` remainder (C fmod): exact, sign of dividend.
test "p1_mod_is_exact_remainder" {
  let a = num_of("<r/>", "5.5 mod 1.1")
  debug_assert(same_num(a, 1.0999999999999996), "5.5 mod 1.1 = " + show_num(a))
  let b = num_of("<r/>", "100000000000000000000 mod 3")
  debug_assert(same_num(b, 1.0), "1e20 mod 3 = " + show_num(b))
}

///| P1-3: for large quotients the result has the wrong sign and exceeds the divisor.
test "p1_mod_large_dividend_sign_and_magnitude" {
  let a = num_of("<r/>", "9031316886084362240 mod 7.5")
  debug_assert(same_num(a, 5.0), "9031316886084362240 mod 7.5 = " + show_num(a))
}

///| P1-3: `-0 mod 5` and `-6 mod 3` are -0 (sign of the dividend); observable through `1 div`.
test "p1_mod_keeps_negative_zero" {
  let a = num_of("<r/>", "1 div (-0 mod 5)")
  debug_assert(same_num(a, -1.0 / 0.0), "1 div (-0 mod 5) = " + show_num(a))
  let b = num_of("<r/>", "1 div (-6 mod 3)")
  debug_assert(same_num(b, -1.0 / 0.0), "1 div (-6 mod 3) = " + show_num(b))
}

///| Control: §4.2 special values and integer formatting.
test "control_number_to_string_specials" {
  debug_assert(str_of("<r/>", "string(0 div 0)") == "NaN", "NaN")
  debug_assert(str_of("<r/>", "string(1 div 0)") == "Infinity", "Infinity")
  debug_assert(str_of("<r/>", "string(-1 div 0)") == "-Infinity", "-Infinity")
  debug_assert(str_of("<r/>", "string(-0)") == "0", "-0 -> 0")
  debug_assert(str_of("<r/>", "string(0 * -1)") == "0", "0*-1 -> 0")
  debug_assert(str_of("<r/>", "string(-100)") == "-100", "-100")
  debug_assert(str_of("<r/>", "string(0.1 + 0.2)") == "0.30000000000000004", "0.1+0.2")
  debug_assert(str_of("<r/>", "string(-1.5)") == "-1.5", "-1.5")
}

///| Control: §4.4 number() grammar (no '+', no exponent, no Infinity, ASCII whitespace only).
test "control_number_grammar" {
  let r = "<r/>"
  debug_assert(same_num(num_of(r, "number(' 12 ')"), 12.0), "' 12 '")
  debug_assert(same_num(num_of(r, "number('-.5')"), -0.5), "'-.5'")
  debug_assert(same_num(num_of(r, "number('5.')"), 5.0), "'5.'")
  let nan = 0.0 / 0.0
  debug_assert(same_num(num_of(r, "number('1e5')"), nan), "'1e5' is NaN")
  debug_assert(same_num(num_of(r, "number('+1')"), nan), "'+1' is NaN")
  debug_assert(same_num(num_of(r, "number('')"), nan), "'' is NaN")
  debug_assert(same_num(num_of(r, "number('-')"), nan), "'-' is NaN")
  debug_assert(same_num(num_of(r, "number('.')"), nan), "'.' is NaN")
  debug_assert(same_num(num_of(r, "number('Infinity')"), nan), "'Infinity' is NaN")
  debug_assert(same_num(num_of(r, "number(' 3')"), nan), "NBSP is not XPath whitespace")
  debug_assert(starts(str_of(r, "1e5"), "ERR"), "1e5 is not an XPath 1.0 Number token")
}

///| Control: §4.4 round/floor/ceiling incl. -0, ties toward +Infinity, huge values, NaN/Inf.
test "control_round_floor_ceiling" {
  let r = "<r/>"
  debug_assert(same_num(num_of(r, "round(-0.5)"), -0.0), "round(-0.5) = -0")
  debug_assert(same_num(num_of(r, "round(-0.4)"), -0.0), "round(-0.4) = -0")
  debug_assert(same_num(num_of(r, "round(-1.5)"), -1.0), "round(-1.5) = -1")
  debug_assert(same_num(num_of(r, "round(2.5)"), 3.0), "round(2.5) = 3")
  debug_assert(same_num(num_of(r, "round(-2.5)"), -2.0), "round(-2.5) = -2")
  debug_assert(same_num(num_of(r, "round(4503599627370495.5)"), 4503599627370496.0), "2^52-0.5")
  debug_assert(
    same_num(num_of(r, "round(-4503599627370495.5)"), -4503599627370495.0),
    "-(2^52-0.5)",
  )
  debug_assert(same_num(num_of(r, "round(1 div 0)"), 1.0 / 0.0), "round(Inf)")
  debug_assert(same_num(num_of(r, "round(0 div 0)"), 0.0 / 0.0), "round(NaN)")
  debug_assert(same_num(num_of(r, "ceiling(-0.5)"), -0.0), "ceiling(-0.5) = -0")
  debug_assert(same_num(num_of(r, "floor(-0.5)"), -1.0), "floor(-0.5) = -1")
  debug_assert(same_num(num_of(r, "floor(-1 div 0)"), -1.0 / 0.0), "floor(-Inf)")
  // 2^70 is far outside Int64 for a naive to_int64 path; must pass through unchanged.
  debug_assert(
    same_num(num_of(r, "round(1180591620717411303424)"), 1180591620717411303424.0),
    "round(2^70)",
  )
}

///| Control: §4.2 substring() IEEE-754 edge cases from the spec text plus Unicode scalar indexing.
test "control_substring_ieee754" {
  let r = "<r><e>😀ab</e></r>"
  debug_assert(str_of(r, "substring('12345', 1.5, 2.6)") == "234", "1.5,2.6")
  debug_assert(str_of(r, "substring('12345', 0, 3)") == "12", "0,3")
  debug_assert(str_of(r, "substring('12345', 0 div 0, 3)") == "", "NaN,3")
  debug_assert(str_of(r, "substring('12345', 1, 0 div 0)") == "", "1,NaN")
  debug_assert(str_of(r, "substring('12345', -42, 1 div 0)") == "12345", "-42,Inf")
  debug_assert(str_of(r, "substring('12345', -1 div 0, 1 div 0)") == "", "-Inf,Inf")
  debug_assert(str_of(r, "substring('12345', -5, 7)") == "1", "-5,7")
  debug_assert(str_of(r, "substring(/r/e, 1, 1)") == "😀", "emoji is one character")
  debug_assert(str_of(r, "string-length(/r/e)") == "3", "string-length counts scalars")
}

///| Control: arithmetic specials and `div` by -0.
test "control_arithmetic_specials" {
  let r = "<r/>"
  debug_assert(same_num(num_of(r, "1 div -0"), -1.0 / 0.0), "1 div -0")
  debug_assert(same_num(num_of(r, "-0"), -0.0), "unary minus of 0")
  debug_assert(same_num(num_of(r, "---1"), -1.0), "---1")
  debug_assert(same_num(num_of(r, "5 mod 0"), 0.0 / 0.0), "5 mod 0 = NaN")
  debug_assert(same_num(num_of(r, "-5 mod 3"), -2.0), "-5 mod 3")
  debug_assert(same_num(num_of(r, "5 mod -3"), 2.0), "5 mod -3")
  debug_assert(same_num(num_of(r, "5 mod (1 div 0)"), 5.0), "5 mod Inf")
}
