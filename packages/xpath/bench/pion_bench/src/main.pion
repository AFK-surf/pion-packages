///| Pion Native head-to-head benchmark binary for `packages/xpath` (W1, W2, W3).

import "xpath"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 0x30 || b > 0x39 {
      return fallback
    }
    acc = acc * 10 + (b - 0x30)
    i = i + 1
  }
  acc
}

fn eval_int(doc : xpath::XPathDoc, expr : xpath::XPathExpr) -> Int64 {
  match expr.eval_number(doc) {
    Ok(n) => n.to_int64()
    Err(_) => -1L
  }
}

fn run_w1(doc : xpath::XPathDoc, rounds : Int) -> String {
  let queries = [
    "count(/catalog/section/book[@available='true' and price >= 50])",
    "sum(/catalog/section[@name='systems']/book/price)",
    "count(//book[@lang='en' or @lang='ja'][year >= 2015])",
    "count(//book[tags/tag = 'wasm' and tags/tag = 'core'])",
    "string-length(normalize-space((//book[@id='b1500']/title)[1]))",
    "count(/catalog/section[1]/book[position() <= 20] | /catalog/section[last()]/book[position() > 280])",
    "sum(//section[@name='compilers']/book[@available='true']/price)",
    "count(//book[contains(summary, 'security') and price < 40])",
    "count(//book[starts-with(@id, 'b10')]/tags/tag)",
    "count(//section[@name='ml']/book[1]/following-sibling::book[@lang='en'])",
  ]
  let compiled : Array[xpath::XPathExpr] = []
  let mut i = 0
  while i < queries.length() {
    match xpath::XPathExpr::parse(queries[i]) {
      Ok(e) => compiled.push(e)
      Err(e) => return "ERR:" + e.to_string()
    }
    i = i + 1
  }
  let mut acc : Int64 = 0L
  let mut last_str = ""
  let mut r = 0
  while r < rounds {
    let mut q = 0
    while q < compiled.length() {
      acc = acc + eval_int(doc, compiled[q])
      q = q + 1
    }
    if r == 0 {
      let sb = StringBuilder::new()
      let mut q2 = 0
      while q2 < compiled.length() {
        if q2 > 0 {
          sb.write_string(",")
        }
        sb.write_string(eval_int(doc, compiled[q2]).to_string())
        q2 = q2 + 1
      }
      last_str = sb.to_string()
    }
    r = r + 1
  }
  "w1 rounds=" + rounds.to_string() + " sum=" + acc.to_string() + " vec=" + last_str
}

fn run_w2(doc : xpath::XPathDoc, iters : Int) -> String {
  let queries = [
    "count(/store/item[@lang='en'])",
    "sum(/store/item[@stock > 0]/cost)",
    "string-length(string(/store/item[@id='i10']/name))",
    "count(/store/item/meta[tier = 2])",
    "number(/store/item[5]/cost) * 2",
    "count(/store/item[starts-with(meta/sku, 'SKU-002')])",
    "count(/store/item[@lang='fr' or @lang='de'])",
    "string-length(concat(/store/item[1]/name, '-', /store/item[2]/name))",
    "count(/store/item[cost >= 30 and cost <= 50])",
    "count(/store/item[last()]/preceding-sibling::item[@lang='ja'])",
  ]
  let nq = queries.length()
  let mut acc : Int64 = 0L
  let mut i = 0
  while i < iters {
    let q = queries[i % nq]
    match xpath::XPathExpr::parse(q) {
      Ok(e) => acc = acc + eval_int(doc, e)
      Err(e) => return "ERR:" + e.to_string()
    }
    i = i + 1
  }
  "w2 iters=" + iters.to_string() + " sum=" + acc.to_string()
}

fn run_w3(doc : xpath::XPathDoc, rounds : Int) -> String {
  let queries = [
    "count(descendant-or-self::*[ancestor::dept[@region='r0'] and @active='yes'])",
    "sum(descendant-or-self::project[ancestor::team[@tier='1']]/budget)",
    "count(//project[@active='yes']/following-sibling::project[@active='yes'])",
    "sum(//milestone[ancestor::dept[@region='r2']]/hours)",
    "count(//project[string-length(normalize-space(label)) >= 8])",
  ]
  let compiled : Array[xpath::XPathExpr] = []
  let mut i = 0
  while i < queries.length() {
    match xpath::XPathExpr::parse(queries[i]) {
      Ok(e) => compiled.push(e)
      Err(e) => return "ERR:" + e.to_string()
    }
    i = i + 1
  }
  let mut acc : Int64 = 0L
  let mut vec_str = ""
  let mut r = 0
  while r < rounds {
    let mut q = 0
    while q < compiled.length() {
      acc = acc + eval_int(doc, compiled[q])
      q = q + 1
    }
    if r == 0 {
      let sb = StringBuilder::new()
      let mut q2 = 0
      while q2 < compiled.length() {
        if q2 > 0 {
          sb.write_string(",")
        }
        sb.write_string(eval_int(doc, compiled[q2]).to_string())
        q2 = q2 + 1
      }
      vec_str = sb.to_string()
    }
    r = r + 1
  }
  "w3 rounds=" + rounds.to_string() + " sum=" + acc.to_string() + " vec=" + vec_str
}

fn run_batch(tag : String, queries : Array[String], doc : xpath::XPathDoc, rounds : Int) -> String {
  let compiled : Array[xpath::XPathExpr] = []
  let mut i = 0
  while i < queries.length() {
    match xpath::XPathExpr::parse(queries[i]) {
      Ok(e) => compiled.push(e)
      Err(e) => return "ERR:" + e.to_string()
    }
    i = i + 1
  }
  let mut acc : Int64 = 0L
  let mut vec_str = ""
  let mut r = 0
  while r < rounds {
    let mut q = 0
    while q < compiled.length() {
      acc = acc + eval_int(doc, compiled[q])
      q = q + 1
    }
    if r == 0 {
      let sb = StringBuilder::new()
      let mut q2 = 0
      while q2 < compiled.length() {
        if q2 > 0 {
          sb.write_string(",")
        }
        sb.write_string(eval_int(doc, compiled[q2]).to_string())
        q2 = q2 + 1
      }
      vec_str = sb.to_string()
    }
    r = r + 1
  }
  tag + " rounds=" + rounds.to_string() + " sum=" + acc.to_string() + " vec=" + vec_str
}

fn run_w4(doc : xpath::XPathDoc, rounds : Int) -> String {
  let queries = [
    "number(//a = //b)",
    "number(//a != //b)",
    "number(//a < //b)",
    "number(//a > //b)",
  ]
  run_batch("w4", queries, doc, rounds)
}

fn run_w5(doc : xpath::XPathDoc, rounds : Int) -> String {
  let queries = [
    "count(/r/e)",
    "count(//@k)",
    "count(//e[@k >= 25000])",
    "sum(//e[@k < 1000]/@k)",
  ]
  run_batch("w5", queries, doc, rounds)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_xpath <w1|w2|w3|w4|w5> <xml_path> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int_arg(args[3], 1)
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read " + path)
      return 1
    }
  }
  let doc = match xpath::XPathDoc::parse(src) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "error: " + e.to_string())
      return 1
    }
  }
  let out = if mode == "w1" {
    run_w1(doc, iters)
  } else if mode == "w2" {
    run_w2(doc, iters)
  } else if mode == "w3" {
    run_w3(doc, iters)
  } else if mode == "w4" {
    run_w4(doc, iters)
  } else {
    run_w5(doc, iters)
  }
  io_println(world, out)
  0
}
