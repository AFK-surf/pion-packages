///| Red-team differential probe for packages/cbor.
/// usage: cbor_audit_probe <mode> <file-of-hex-lines>
/// (or: cbor_audit_probe deepenc=<n>   — encode an n-deep nested array)
/// modes: dec | dup | strict | enc_det | enc_ctap2 | depth=<n> (decode only, max_depth=n)
/// One output line per input line: "OK <hex re-encoding>" or "ERR <message>".

import "cbor"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn hex_range(src : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = nib(src[start + 2 * i].to_int())
    let lo = nib(src[start + 2 * i + 1].to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn run_one(mode : String, depth : Int, input : Bytes) -> String {
  let mut opts = cbor::DecodeOptions::default()
  if mode == "dup" {
    opts = cbor::DecodeOptions::{ ..opts, reject_duplicate_keys: true }
  } else if mode == "strict" {
    opts = cbor::DecodeOptions::strict()
  } else if depth > 0 {
    opts = cbor::DecodeOptions::{ ..opts, max_depth: depth }
  }
  match cbor::decode(input, opts) {
    Err(e) => "ERR " + cbor::error_message(e)
    Ok(_) if depth > 0 => "OK decoded"
    Ok(v) => {
      let eopts = if mode == "enc_ctap2" {
        cbor::EncodeOptions::ctap2()
      } else if mode == "enc_det" {
        cbor::EncodeOptions::deterministic()
      } else {
        cbor::EncodeOptions::default()
      }
      match cbor::encode(v, eopts) {
        Ok(b) => "OK " + tohex(b)
        Err(e) => "ENCERR " + cbor::error_message(e)
      }
    }
  }
}

///|
/// Structural walk: (nodes, total bytes of byte/text payload).
fn walk(v : cbor::CborValue, acc : Array[Int64]) -> Unit {
  acc[0] = acc[0] + 1L
  match v {
    Bytes(b) => acc[1] = acc[1] + b.length().to_int64()
    Text(s) => acc[1] = acc[1] + s.length().to_int64()
    Tag(_, inner) => walk(inner, acc)
    Array(items) => {
      let mut i = 0
      while i < items.length() {
        walk(items[i], acc)
        i = i + 1
      }
    }
    Map(pairs) => {
      let mut i = 0
      while i < pairs.length() {
        let (k, x) = pairs[i]
        walk(k, acc)
        walk(x, acc)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i).to_int() - 48)
    i = i + 1
  }
  v
}

///|
/// Benchmark mode: cbor_audit_probe bench <dec|dupdec|enc_det|enc_ctap2> <file.cbor> <iters>
fn bench(world : World, mode : String, path : String, iters : Int) -> Int {
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let mut opts = cbor::DecodeOptions::default()
  if mode == "dupdec" {
    opts = cbor::DecodeOptions::{ ..opts, reject_duplicate_keys: true }
  }
  let acc : Array[Int64] = [0L, 0L]
  if mode == "dec" || mode == "dupdec" {
    let mut r = 0
    while r < iters {
      match cbor::decode(data, opts) {
        Ok(v) => walk(v, acc)
        Err(e) => {
          io_println(world, "ERR " + cbor::error_message(e))
          return 2
        }
      }
      r = r + 1
    }
  } else {
    let v = match cbor::decode(data, opts) {
      Ok(v) => v
      Err(_) => return 2
    }
    let eopts = if mode == "enc_ctap2" {
      cbor::EncodeOptions::ctap2()
    } else {
      cbor::EncodeOptions::deterministic()
    }
    let mut r = 0
    while r < iters {
      match cbor::encode(v, eopts) {
        Ok(b) => acc[1] = acc[1] + b.length().to_int64()
        Err(e) => {
          io_println(world, "ERR " + cbor::error_message(e))
          return 2
        }
      }
      r = r + 1
    }
  }
  io_println(world, "nodes=" + acc[0].to_string() + " bytes=" + acc[1].to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 5 && args[1] == "bench" {
    return bench(world, args[2], args[3], parse_int(args[4]))
  }
  if args.length() >= 2 && args[1].length() > 8 && args[1].slice(0, 8) == "deepenc=" {
    // Encoder recursion probe: build an N-deep [[[...0...]]] value and encode it.
    let n = parse_int(args[1].slice(8, args[1].length()))
    let mut v = cbor::CborValue::Unsigned(0UL)
    let mut i = 0
    while i < n {
      v = cbor::CborValue::Array([v])
      i = i + 1
    }
    match cbor::encode_default(v) {
      Ok(b) => io_println(world, "OK len=" + b.length().to_string())
      Err(e) => io_println(world, "ERR " + cbor::error_message(e))
    }
    return 0
  }
  if args.length() < 3 {
    io_eprintln(world, "usage: cbor_audit_probe <mode> <hexfile>")
    return 1
  }
  let mode = args[1]
  let mut depth = 0
  if mode.length() > 6 && mode.slice(0, 6) == "depth=" {
    let ds = mode.slice(6, mode.length())
    let mut i = 0
    while i < ds.length() {
      depth = depth * 10 + (ds.code_unit_at(i).to_int() - 48)
      i = i + 1
    }
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read input")
      return 1
    }
  }
  let sb = StringBuilder::new()
  let mut start = 0
  let mut i = 0
  let n = data.length()
  while i <= n {
    if i == n || data[i].to_int() == 10 {
      if i > start {
        sb.write_string(run_one(mode, depth, hex_range(data, start, i)))
        sb.write_string("\n")
      }
      start = i + 1
    }
    i = i + 1
  }
  io_println(world, sb.to_string())
  0
}
