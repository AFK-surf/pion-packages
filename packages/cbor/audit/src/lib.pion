///| Red-team audit helpers for packages/cbor (no production code; see ../REPORT.md).

import "cbor"

///|
fn audit_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
pub fn hx(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = audit_nibble(s.code_unit_at(2 * i).to_int())
    let lo = audit_nibble(s.code_unit_at(2 * i + 1).to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
pub fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn accepts(hex : String, opts : cbor::DecodeOptions) -> Bool {
  match cbor::decode(hx(hex), opts) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
pub fn enc_hex(v : cbor::CborValue, opts : cbor::EncodeOptions) -> String {
  match cbor::encode(v, opts) {
    Ok(b) => tohex(b)
    Err(e) => "ERR " + cbor::error_message(e)
  }
}
