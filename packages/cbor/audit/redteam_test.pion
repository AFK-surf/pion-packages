///| Red-team regression tests for packages/cbor @ 60080f3 (branch feat/opt-cbor).
///
/// Every `redteam_*` test asserts the behaviour of the reference implementation
/// (Go fxamacker/cbor/v2 v2.9.0 and/or RFC 8949) — a FAILURE here is the evidence.
/// `control_*` tests are attacks that Pion survived; they must keep passing.
/// Crash / DoS findings (SIGSEGV, quadratic time) cannot live in a unit test that must finish:
/// they are reproduced by ../run_audit.sh (see REPORT.md P0/P1).

import "cbor"

// ---------------------------------------------------------------------------
// F-4 (P2) Tag validity, RFC 8949 §3.4.1-§3.4.3: tag 0 requires a text string, tag 1 an
// int/float, tags 2/3 a byte string. fxamacker rejects all of these when decoding into any.
// ---------------------------------------------------------------------------

///|
test "redteam_tag0_on_integer_rejected" {
  // go: "cbor: tag number 0 must be followed by text string, got positive integer"
  debug_assert(!accepts("c000", cbor::DecodeOptions::default()), "c000 must be rejected")
}

///|
test "redteam_tag1_on_text_rejected" {
  // go: "cbor: tag number 1 must be followed by integer or floating-point number, got UTF-8 text string"
  debug_assert(!accepts("c16161", cbor::DecodeOptions::default()), "c16161 must be rejected")
}

///|
test "redteam_tag2_on_integer_rejected" {
  // go: "cbor: tag number 2 or 3 must be followed by byte string, got positive integer"
  debug_assert(!accepts("c201", cbor::DecodeOptions::default()), "c201 must be rejected")
}

///|
test "redteam_tag3_on_array_rejected" {
  debug_assert(!accepts("c380", cbor::DecodeOptions::default()), "c380 must be rejected")
}

///|
test "redteam_tag0_invalid_rfc3339_rejected" {
  // go: cannot set a for time.Time: parsing time "a" ...
  debug_assert(!accepts("c06161", cbor::DecodeOptions::default()), "c0 \"a\" must be rejected")
}

///|
test "redteam_tag0_strict_mode_also_accepts_invalid" {
  // Even DecodeOptions::strict() lets the invalid tag content through.
  debug_assert(!accepts("c000", cbor::DecodeOptions::strict()), "strict must reject c000")
}

// ---------------------------------------------------------------------------
// F-6 (P2) Duplicate-key detection reuses the test helper cbor_equals(), which treats every
// NaN as equal. f97e00 and f97e01 are different data items (different encodings, different
// payloads); fxamacker DupMapKeyEnforcedAPF accepts the map.
// ---------------------------------------------------------------------------

///|
test "redteam_dup_nan_different_payload_not_duplicate" {
  let opts = cbor::DecodeOptions::{ ..cbor::DecodeOptions::default(), reject_duplicate_keys: true }
  debug_assert(accepts("a2f97e0001f97e0102", opts), "{NaN(7e00):1, NaN(7e01):2} has no duplicate key")
}

///|
test "redteam_dup_nan_f16_vs_f64_payload_not_duplicate" {
  let opts = cbor::DecodeOptions::{ ..cbor::DecodeOptions::default(), reject_duplicate_keys: true }
  debug_assert(accepts("a2f97e0001fb7ff800000000000102", opts), "NaN keys with different payloads")
}

// ---------------------------------------------------------------------------
// F-7 (P2) Preferred serialization of bignums, RFC 8949 §3.4.3 (+ §4.2.1 Core Deterministic
// requires preferred serialization): an integer that fits major type 0/1 MUST NOT be a bignum.
// fxamacker CoreDetEncOptions emits 0x01 for tag2(h'01'); Pion keeps c24101, and strict decode
// accepts it as "canonical".
// ---------------------------------------------------------------------------

///|
test "redteam_core_det_bignum_preferred_serialization" {
  let v = cbor::CborValue::Tag(2UL, cbor::CborValue::Bytes(hx("01")))
  let got = enc_hex(v, cbor::EncodeOptions::deterministic())
  debug_assert(got == "01", "tag2(h'01') must encode as 01 in Core Deterministic, got " + got)
}

///|
test "redteam_strict_rejects_non_preferred_bignum" {
  debug_assert(!accepts("c24101", cbor::DecodeOptions::strict()), "c24101 is not preferred serialization")
}

///|
test "redteam_strict_rejects_bignum_leading_zero" {
  debug_assert(!accepts("c2420001", cbor::DecodeOptions::strict()), "bignum with leading zero byte")
}

// ---------------------------------------------------------------------------
// F-8 (P2) Strict decoding can only validate RFC 8949 bytewise order; there is no CTAP2 strict
// mode, so Pion's own CTAP2 canonical output is rejected by DecodeOptions::strict().
// ---------------------------------------------------------------------------

///|
test "redteam_strict_accepts_own_ctap2_output" {
  let m = cbor::CborValue::Map([
    (cbor::CborValue::Unsigned(24UL), cbor::CborValue::Null),
    (cbor::CborValue::Negative(0UL), cbor::CborValue::Null),
    (cbor::CborValue::Unsigned(10UL), cbor::CborValue::Null),
  ])
  let enc = match cbor::encode(m, cbor::EncodeOptions::ctap2()) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  // CTAP2 order: 0a, 20, 1818  (length-first)
  debug_assert(tohex(enc) == "a30af620f61818f6", "ctap2 encoding: " + tohex(enc))
  let ok = match cbor::decode(enc, cbor::DecodeOptions::strict()) {
    Ok(_) => true
    Err(_) => false
  }
  debug_assert(ok, "a CTAP2-canonical message must be accepted by a strict decoder")
}

// ---------------------------------------------------------------------------
// F-5 (P1) No consumed-length / "decode first item" API (fxamacker UnmarshalFirst, ciborium
// from_reader on &mut &[u8]). WebAuthn attestedCredentialData = ... || COSE_Key || extensions
// needs the COSE_Key length; allow_trailing_bytes only returns the first item. The only
// workaround (re-encode the item to learn its size) is wrong for non-preferred input:
// ---------------------------------------------------------------------------

///|
test "redteam_reencode_workaround_cannot_recover_item_length" {
  // item 1 = indefinite byte string 5f 41 01 ff (4 bytes), item 2 = 02
  let seq = hx("5f4101ff02")
  let opts = cbor::DecodeOptions::{ ..cbor::DecodeOptions::default(), allow_trailing_bytes: true }
  let consumed = match cbor::decode(seq, opts) {
    Ok(v) =>
    match cbor::encode_default(v) {
      Ok(b) => b.length()
      Err(_) => -1
    }
    Err(_) => -1
  }
  debug_assert(consumed == 4, "item 1 occupies 4 bytes; re-encoding says " + consumed.to_string())
}

// ---------------------------------------------------------------------------
// Controls: attacks the implementation survived (must stay green).
// ---------------------------------------------------------------------------

///|
test "control_u64_and_neg_2pow64_lossless" {
  let d = cbor::DecodeOptions::default()
  let e = cbor::EncodeOptions::default()
  match cbor::decode(hx("1bffffffffffffffff"), d) {
    Ok(v) => debug_assert(enc_hex(v, e) == "1bffffffffffffffff", "u64::MAX")
    Err(_) => debug_assert(false, "u64::MAX rejected")
  }
  match cbor::decode(hx("3bffffffffffffffff"), d) {
    Ok(v) => debug_assert(enc_hex(v, e) == "3bffffffffffffffff", "-2^64")
    Err(_) => debug_assert(false, "-2^64 rejected")
  }
  match cbor::decode(hx("3b8000000000000000"), d) {
    Ok(v) => debug_assert(enc_hex(v, e) == "3b8000000000000000", "-2^63-1")
    Err(_) => debug_assert(false, "-2^63-1 rejected")
  }
}

///|
test "control_indefinite_chunk_attacks_rejected" {
  let d = cbor::DecodeOptions::default()
  debug_assert(!accepts("5f5f4101ffff", d), "nested indefinite byte chunk (ciborium accepts this!)")
  debug_assert(!accepts("7f7f6161ffff", d), "nested indefinite text chunk (ciborium accepts this!)")
  debug_assert(!accepts("7f61c361a9ff", d), "UTF-8 split across chunks")
  debug_assert(!accepts("5f6161ff", d), "text chunk inside byte string")
  debug_assert(!accepts("bf01ff", d), "indefinite map with odd item count")
  debug_assert(!accepts("8101ff", d), "break inside definite array")
  debug_assert(accepts("5f40ff", d), "empty chunk is legal")
}

///|
test "control_float_preferred_serialization" {
  let e = cbor::EncodeOptions::deterministic()
  debug_assert(enc_hex(cbor::CborValue::Float(1.5), e) == "f93e00", "1.5")
  debug_assert(enc_hex(cbor::CborValue::Float(-0.0), e) == "f98000", "-0.0")
  match cbor::decode(hx("fb3e70000000000000"), cbor::DecodeOptions::default()) {
    Ok(v) => debug_assert(enc_hex(v, e) == "f90001", "f16 subnormal min")
    Err(_) => debug_assert(false, "f64 decode")
  }
  debug_assert(!accepts("fa3fc00000", cbor::DecodeOptions::strict()), "f32 1.5 is non-preferred")
}

///|
test "control_length_bombs_rejected_without_allocation" {
  let d = cbor::DecodeOptions::default()
  debug_assert(!accepts("5bffffffffffffffff00", d), "u64::MAX byte string")
  debug_assert(!accepts("7a7fffffff61", d), "i32::MAX text string")
  debug_assert(!accepts("9bffffffffffffffff00", d), "u64::MAX array")
  debug_assert(!accepts("bbffffffffffffffff0000", d), "u64::MAX map")
  debug_assert(!accepts("5f5bffffffffffffffff00ff", d), "u64::MAX indefinite chunk")
}

///|
test "control_utf8_and_reserved_ai" {
  let d = cbor::DecodeOptions::default()
  debug_assert(!accepts("62c0af", d), "overlong")
  debug_assert(!accepts("63eda080", d), "surrogate")
  debug_assert(!accepts("64f4908080", d), "> U+10FFFF")
  debug_assert(!accepts("1c", d), "ai 28")
  debug_assert(!accepts("fe", d), "ai 30 major 7")
  debug_assert(!accepts("f81f", d), "simple < 32 in two-byte form")
  debug_assert(!accepts("0000", d), "trailing bytes")
}
