///| Wasm32 smoke entry for the `cbor` package.

import "cbor"

///|
pub fn smoke() -> Int {
  let payload = cbor::CborValue::Map([
    (cbor::CborValue::Unsigned(1UL), cbor::CborValue::Unsigned(2UL)),
    (cbor::CborValue::Unsigned(3UL), cbor::CborValue::Negative(6UL)),
    (cbor::CborValue::Text("ok"), cbor::CborValue::Bool(true)),
    (cbor::CborValue::Text("score"), cbor::CborValue::Float(1.5)),
  ])
  let encoded = match cbor::encode(payload, cbor::EncodeOptions::deterministic()) {
    Ok(b) => b
    Err(_) => return -1
  }
  let decoded = match cbor::decode(encoded, cbor::DecodeOptions::strict()) {
    Ok(v) => v
    Err(_) => return -2
  }
  let diag = cbor::to_diagnostic(decoded)
  encoded.length() + diag.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
