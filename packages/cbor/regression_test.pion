///| Regression tests for red-team fixes: O(n) dup-key detection, O(n log n) Introsort,
///  depth safety, decode_prefix/decode_first, RFC 8949 tag validation, NaN key equality,
///  bignum preferred serialization, and strict CTAP2/RFC 8949 canonical decoding.

///|
test "rt_f1_dup_keys_large_definite_and_indef" {
  // Build a 1024-entry map with distinct uint keys in shuffled-like order
  let n = 1024
  let pairs : Array[(CborValue, CborValue)] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let k = ((i * 2654435761) & 1023).to_int64().to_uint64()
    pairs.push((CborValue::Unsigned(k), CborValue::Null))
    i = i + 1
  }
  let enc = unwrap_bytes(encode_default(CborValue::Map(pairs)))
  let opts = DecodeOptions::{ ..DecodeOptions::default(), reject_duplicate_keys: true }
  debug_assert(!is_err_val(decode(enc, opts)), "1024 distinct uint keys accepted")
  // Add a duplicate at the end
  pairs.push((CborValue::Unsigned(0UL), CborValue::Null))
  let enc_dup = unwrap_bytes(encode_default(CborValue::Map(pairs)))
  debug_assert(is_err_val(decode(enc_dup, opts)), "1024+1 duplicate uint key rejected")
  // Indefinite map with > 16 distinct keys, then duplicate at end
  let mut hex_ok = "bf"
  let mut hex_dup = "bf"
  let mut j = 0
  while j < 20 {
    let kb = unwrap_bytes(encode_default(CborValue::Unsigned(j.to_int64().to_uint64())))
    let kh = bytes_to_hex(kb)
    hex_ok = hex_ok + kh + "f6"
    hex_dup = hex_dup + kh + "f6"
    j = j + 1
  }
  hex_ok = hex_ok + "ff"
  hex_dup = hex_dup + "05f6ff"
  debug_assert(!is_err_val(decode(hex_to_bytes(hex_ok), opts)), "indef 20 distinct keys ok")
  debug_assert(is_err_val(decode(hex_to_bytes(hex_dup), opts)), "indef 20+1 dup key rejected")
}

///|
test "rt_f2_shell_killer_order_core_and_ctap2" {
  let n = 256
  let half = n / 2
  let uint_pairs : Array[(CborValue, CborValue)] = Array::with_capacity(n)
  let bstr_pairs : Array[(CborValue, CborValue)] = Array::with_capacity(n)
  let mut i = 0
  while i < half {
    let hi = (half + i).to_int64().to_uint64()
    let lo = i.to_int64().to_uint64()
    uint_pairs.push((CborValue::Unsigned(hi), CborValue::Null))
    uint_pairs.push((CborValue::Unsigned(lo), CborValue::Null))
    let bhi = Bytes::new(2)
    bhi[0] = ((half + i) >> 8).to_byte()
    bhi[1] = ((half + i) & 0xFF).to_byte()
    let blo = Bytes::new(2)
    blo[0] = (i >> 8).to_byte()
    blo[1] = (i & 0xFF).to_byte()
    bstr_pairs.push((CborValue::Bytes(bhi), CborValue::Null))
    bstr_pairs.push((CborValue::Bytes(blo), CborValue::Null))
    i = i + 1
  }
  let enc_u_det = unwrap_bytes(encode(CborValue::Map(uint_pairs), EncodeOptions::deterministic()))
  debug_assert(!is_err_val(decode_strict(enc_u_det, SortMode::CoreDeterministic)), "uint core det strict")
  let enc_u_ctap = unwrap_bytes(encode(CborValue::Map(uint_pairs), EncodeOptions::ctap2()))
  debug_assert(!is_err_val(decode_strict(enc_u_ctap, SortMode::Ctap2)), "uint ctap2 strict")
  let enc_b_det = unwrap_bytes(encode(CborValue::Map(bstr_pairs), EncodeOptions::deterministic()))
  debug_assert(!is_err_val(decode_strict(enc_b_det, SortMode::CoreDeterministic)), "bstr core det strict")
  let enc_b_ctap = unwrap_bytes(encode(CborValue::Map(bstr_pairs), EncodeOptions::ctap2()))
  debug_assert(!is_err_val(decode_strict(enc_b_ctap, SortMode::Ctap2)), "bstr ctap2 strict")
}

///|
test "rt_f3_depth_cap_and_iterative_encode" {
  // Build 200-deep nested array (exceeds encode_rec_limit=64, exercises iterative encoder)
  let mut v = CborValue::Unsigned(7UL)
  let mut i = 0
  while i < 200 {
    v = CborValue::Array([v])
    i = i + 1
  }
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(enc.length() == 201, "200-deep array encodes to 201 bytes")
  let opts_ok = DecodeOptions::{ ..DecodeOptions::default(), max_depth: 256 }
  let dec = unwrap_val(decode(enc, opts_ok))
  debug_assert(cbor_equals(dec, v), "200-deep roundtrip")
  // Exceeding hard safety cap (1024) with max_depth=65535 must return Err, never crash
  let raw = Bytes::new(1501)
  let mut j = 0
  while j < 1500 {
    raw[j] = (0x81).to_byte()
    j = j + 1
  }
  raw[1500] = (0x00).to_byte()
  let opts_huge = DecodeOptions::{ ..DecodeOptions::default(), max_depth: 65535 }
  debug_assert(is_err_val(decode(raw, opts_huge)), "1500-deep rejected even when max_depth=65535")
}

///|
test "rt_f5_decode_prefix_indef_and_sequence" {
  // item 1 = indefinite byte string 5f 41 01 ff (4 bytes), item 2 = 02 (1 byte), item 3 = "hi" (3 bytes)
  let seq = hex_to_bytes("5f4101ff02626869")
  let opts = DecodeOptions::default()
  match decode_first(seq, opts) {
    Ok((v1, c1)) => {
      debug_assert(cbor_equals(v1, CborValue::Bytes(hex_to_bytes("01"))), "item 1 value")
      debug_assert(c1 == 4, "item 1 exact consumed length = 4")
      match decode_prefix_at(seq, c1, opts) {
        Ok((v2, c2)) => {
          debug_assert(cbor_equals(v2, CborValue::Unsigned(2UL)), "item 2 value")
          debug_assert(c2 == 1, "item 2 consumed = 1")
          match decode_prefix_at(seq, c1 + c2, opts) {
            Ok((v3, c3)) => {
              debug_assert(cbor_equals(v3, CborValue::Text("hi")), "item 3 value")
              debug_assert(c3 == 3, "item 3 consumed = 3")
              debug_assert(c1 + c2 + c3 == seq.length(), "entire sequence consumed")
            }
            Err(_) => debug_assert(false, "item 3 failed")
          }
        }
        Err(_) => debug_assert(false, "item 2 failed")
      }
    }
    Err(_) => debug_assert(false, "item 1 failed")
  }
}

///|
test "rt_f5_webauthn_attested_credential_data_cose_plus_extensions" {
  let cose_key = CborValue::Map([
    (CborValue::Unsigned(1UL), CborValue::Unsigned(2UL)),
    (CborValue::Unsigned(3UL), CborValue::Negative(6UL)),
    (CborValue::Negative(0UL), CborValue::Unsigned(1UL)),
  ])
  let extensions = CborValue::Map([
    (CborValue::Text("credProtect"), CborValue::Unsigned(2UL)),
  ])
  let b1 = unwrap_bytes(encode(cose_key, EncodeOptions::ctap2()))
  let b2 = unwrap_bytes(encode(extensions, EncodeOptions::ctap2()))
  let combined = Bytes::new(b1.length() + b2.length())
  let mut i = 0
  while i < b1.length() {
    combined[i] = b1[i]
    i = i + 1
  }
  let mut j = 0
  while j < b2.length() {
    combined[b1.length() + j] = b2[j]
    j = j + 1
  }
  match decode_prefix(combined, DecodeOptions::strict()) {
    Ok((k, consumed)) => {
      debug_assert(cbor_equals(k, cose_key), "COSE_Key decoded")
      debug_assert(consumed == b1.length(), "COSE_Key consumed exact bytes")
      match decode_prefix_at(combined, consumed, DecodeOptions::strict()) {
        Ok((ext, consumed2)) => {
          debug_assert(cbor_equals(ext, extensions), "extensions decoded")
          debug_assert(consumed + consumed2 == combined.length(), "all bytes consumed")
        }
        Err(_) => debug_assert(false, "extensions decode failed")
      }
    }
    Err(_) => debug_assert(false, "COSE_Key decode failed")
  }
}

///|
test "rt_f4_tag0_rfc3339_and_tag123_validation" {
  let d = DecodeOptions::default()
  // Valid RFC 3339 variants
  let t0_z = unwrap_bytes(encode_default(CborValue::Tag(0UL, CborValue::Text("2024-02-29T23:59:59.123456Z"))))
  let t0_off = unwrap_bytes(encode_default(CborValue::Tag(0UL, CborValue::Text("2026-11-22t09:30:00+09:00"))))
  debug_assert(!is_err_val(decode(t0_z, d)), "valid leap-day RFC3339 with frac")
  debug_assert(!is_err_val(decode(t0_off, d)), "valid RFC3339 with offset")
  // Invalid RFC 3339
  let t0_noleap = unwrap_bytes(encode_default(CborValue::Tag(0UL, CborValue::Text("2023-02-29T00:00:00Z"))))
  let t0_badmo = unwrap_bytes(encode_default(CborValue::Tag(0UL, CborValue::Text("2023-13-01T00:00:00Z"))))
  let t0_notz = unwrap_bytes(encode_default(CborValue::Tag(0UL, CborValue::Text("2023-01-01T00:00:00"))))
  debug_assert(is_err_val(decode(t0_noleap, d)), "non-leap Feb 29 rejected")
  debug_assert(is_err_val(decode(t0_badmo, d)), "month 13 rejected")
  debug_assert(is_err_val(decode(t0_notz, d)), "missing tz rejected")
  // Tag 1 rejects NaN and Inf, accepts int/neg/finite float
  debug_assert(is_err_val(decode(hex_to_bytes("c1f97e00"), d)), "tag1 NaN rejected")
  debug_assert(is_err_val(decode(hex_to_bytes("c1f97c00"), d)), "tag1 +Inf rejected")
  debug_assert(!is_err_val(decode(hex_to_bytes("c120"), d)), "tag1 negint ok")
}

///|
test "rt_f6_nan_payload_distinct_keys" {
  let opts = DecodeOptions::{ ..DecodeOptions::default(), reject_duplicate_keys: true }
  debug_assert(is_err_val(decode(hex_to_bytes("a2f97e0001f97e0002"), opts)), "identical NaN keys dup")
  debug_assert(!is_err_val(decode(hex_to_bytes("a2f97e0001f97e0102"), opts)), "different f16 NaN payload distinct")
  debug_assert(!is_err_val(decode(hex_to_bytes("a2f97e0001fb7ff800000000000102"), opts)), "f16 vs f64 NaN payload distinct")
  debug_assert(!is_err_val(decode(hex_to_bytes("a2f9000001f9800002"), opts)), "+0.0 vs -0.0 distinct")
}

///|
test "rt_f7_bignum_preferred_serialization" {
  let det = EncodeOptions::deterministic()
  let ctap = EncodeOptions::ctap2()
  debug_assert(bytes_to_hex(unwrap_bytes(encode(CborValue::Tag(2UL, CborValue::Bytes(hex_to_bytes("01"))), det))) == "01", "tag2(01)->01")
  debug_assert(bytes_to_hex(unwrap_bytes(encode(CborValue::Tag(2UL, CborValue::Bytes(hex_to_bytes("0001"))), det))) == "01", "tag2(0001)->01")
  debug_assert(bytes_to_hex(unwrap_bytes(encode(CborValue::Tag(2UL, CborValue::Bytes(Bytes::new(0))), det))) == "00", "tag2(empty)->00")
  debug_assert(bytes_to_hex(unwrap_bytes(encode(CborValue::Tag(3UL, CborValue::Bytes(hex_to_bytes("00"))), ctap))) == "20", "tag3(00)->-1")
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode(CborValue::Tag(2UL, CborValue::Bytes(hex_to_bytes("00010000000000000000"))), det))) == "c249010000000000000000",
    "leading zero stripped on 2^64 bignum",
  )
  debug_assert(is_err_val(decode(hex_to_bytes("c24101"), DecodeOptions::strict())), "strict rejects tag2(01)")
  debug_assert(is_err_val(decode(hex_to_bytes("c24a00010000000000000000"), DecodeOptions::strict())), "strict rejects leading zero 10B bignum")
  debug_assert(!is_err_val(decode(hex_to_bytes("c249010000000000000000"), DecodeOptions::strict())), "strict accepts canonical 2^64 bignum")
}

///|
test "rt_f8_strict_rfc8949_vs_ctap2_modes" {
  let m = CborValue::Map([
    (CborValue::Unsigned(24UL), CborValue::Null),
    (CborValue::Negative(0UL), CborValue::Null),
    (CborValue::Unsigned(10UL), CborValue::Null),
  ])
  let rfc_bytes = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  let ctap_bytes = unwrap_bytes(encode(m, EncodeOptions::ctap2()))
  // DecodeOptions::strict() accepts both RFC 8949 and CTAP2
  debug_assert(!is_err_val(decode(rfc_bytes, DecodeOptions::strict())), "strict accepts RFC 8949")
  debug_assert(!is_err_val(decode(ctap_bytes, DecodeOptions::strict())), "strict accepts CTAP2")
  // decode_strict enforces exact ordering
  debug_assert(!is_err_val(decode_strict(rfc_bytes, SortMode::CoreDeterministic)), "decode_strict RFC accepts RFC")
  debug_assert(is_err_val(decode_strict(ctap_bytes, SortMode::CoreDeterministic)), "decode_strict RFC rejects CTAP2")
  debug_assert(!is_err_val(decode_strict(ctap_bytes, SortMode::Ctap2)), "decode_strict CTAP2 accepts CTAP2")
  debug_assert(is_err_val(decode_strict(rfc_bytes, SortMode::Ctap2)), "decode_strict CTAP2 rejects RFC")
  // Mixed order (1864, 20, 1903e8) rejected even by DecodeOptions::strict()
  debug_assert(is_err_val(decode(hex_to_bytes("a31864f620f61903e8f6"), DecodeOptions::strict())), "mixed order rejected")
}

///|
test "c1_migrated_cbor_constants" {
  // Gregorian days_in_month spots
  debug_assert(days_in_month(2000, 2) == 29, "2000-02 leap")
  debug_assert(days_in_month(2100, 2) == 28, "2100-02 non-leap")
  debug_assert(days_in_month(2024, 2) == 29, "2024-02 leap")
  debug_assert(days_in_month(2023, 2) == 28, "2023-02 non-leap")
  debug_assert(days_in_month(2024, 4) == 30, "2024-04")
  debug_assert(days_in_month(2024, 1) == 31, "2024-01")
  // DecodeOptions default & strict
  let def = DecodeOptions::default()
  debug_assert(def.max_depth == 32 && !def.reject_duplicate_keys && !def.require_canonical, "DecodeOptions::default")
  let st = DecodeOptions::strict()
  debug_assert(st.max_depth == 32 && st.reject_duplicate_keys && st.require_canonical, "DecodeOptions::strict")
  // Float16 & Float32 spot roundtrips
  let f16_spots = [0, 32768, 31744, 64512, 32256, 15360, 15872, 1, 31743]
  for i = 0; i < f16_spots.length(); i = i + 1 {
    let h = f16_spots[i]
    let d = float16_to_double_bits(h)
    match double_bits_to_float16_exact(d) {
      Some(rt) => debug_assert(rt == h, "float16 spot roundtrip")
      None => debug_assert(false, "float16 spot should roundtrip")
    }
  }
  let f32_spots = [0L, 2147483648L, 2139095040L, 4286578688L]
  for i = 0; i < f32_spots.length(); i = i + 1 {
    let f = f32_spots[i]
    let d = float32_to_double_bits(f)
    match double_bits_to_float32_exact(d) {
      Some(rt) => debug_assert(rt == f, "float32 spot roundtrip")
      None => debug_assert(false, "float32 spot should roundtrip")
    }
  }
}
