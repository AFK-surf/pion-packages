///| RFC 8949 Section 8 Diagnostic Notation and complex real-world roundtrip tests (25 tests).

///|
test "diag_unsigned_integers" {
  debug_assert(to_diagnostic(CborValue::Unsigned(0UL)) == "0", "0")
  debug_assert(to_diagnostic(CborValue::Unsigned(42UL)) == "42", "42")
  debug_assert(
    to_diagnostic(CborValue::Unsigned(18446744073709551615UL)) == "18446744073709551615",
    "u64::MAX",
  )
}

///|
test "diag_negative_integers_full_range" {
  debug_assert(to_diagnostic(CborValue::Negative(0UL)) == "-1", "-1")
  debug_assert(to_diagnostic(CborValue::Negative(99UL)) == "-100", "-100")
  debug_assert(
    to_diagnostic(CborValue::Negative(18446744073709551614UL)) == "-18446744073709551615",
    "-2^64+1",
  )
  debug_assert(
    to_diagnostic(CborValue::Negative(18446744073709551615UL)) == "-18446744073709551616",
    "-2^64",
  )
}

///|
test "diag_byte_strings" {
  debug_assert(to_diagnostic(CborValue::Bytes(Bytes::new(0))) == "h''", "empty bytes")
  debug_assert(
    to_diagnostic(CborValue::Bytes(hex_to_bytes("01020304"))) == "h'01020304'",
    "4 bytes",
  )
  debug_assert(
    to_diagnostic(CborValue::Bytes(hex_to_bytes("deadbeef"))) == "h'deadbeef'",
    "deadbeef",
  )
}

///|
test "diag_text_strings_and_escapes" {
  debug_assert(to_diagnostic(CborValue::Text("")) == "\"\"", "empty text")
  debug_assert(to_diagnostic(CborValue::Text("IETF")) == "\"IETF\"", "IETF")
  debug_assert(to_diagnostic(CborValue::Text("\"\\")) == "\"\\\"\\\\\"", "quote and backslash")
  debug_assert(to_diagnostic(CborValue::Text("a\nb\tc\rd")) == "\"a\\nb\\tc\\rd\"", "escapes")
}

///|
test "diag_bool_null_undefined_simple" {
  debug_assert(to_diagnostic(CborValue::Bool(false)) == "false", "false")
  debug_assert(to_diagnostic(CborValue::Bool(true)) == "true", "true")
  debug_assert(to_diagnostic(CborValue::Null) == "null", "null")
  debug_assert(to_diagnostic(CborValue::Undefined) == "undefined", "undefined")
  debug_assert(to_diagnostic(CborValue::Simple(16)) == "simple(16)", "simple(16)")
  debug_assert(to_diagnostic(CborValue::Simple(255)) == "simple(255)", "simple(255)")
}

///|
test "diag_floats_special_values" {
  let pos_inf = Double::from_bits(0x7FF0000000000000L)
  let neg_inf = Double::from_bits(-4503599627370496L)
  let nan_v = Double::from_bits(0x7FF8000000000000L)
  let neg_zero = Double::from_bits(-9223372036854775808L)
  debug_assert(to_diagnostic(CborValue::Float(0.0)) == "0.0", "0.0")
  debug_assert(to_diagnostic(CborValue::Float(neg_zero)) == "-0.0", "-0.0")
  debug_assert(to_diagnostic(CborValue::Float(1.5)) == "1.5", "1.5")
  debug_assert(to_diagnostic(CborValue::Float(pos_inf)) == "Infinity", "Infinity")
  debug_assert(to_diagnostic(CborValue::Float(neg_inf)) == "-Infinity", "-Infinity")
  debug_assert(to_diagnostic(CborValue::Float(nan_v)) == "NaN", "NaN")
}

///|
test "diag_array_empty_and_nested" {
  debug_assert(to_diagnostic(CborValue::Array([])) == "[]", "empty array")
  let a = CborValue::Array([
    CborValue::Unsigned(1UL),
    CborValue::Array([CborValue::Unsigned(2UL), CborValue::Unsigned(3UL)]),
  ])
  debug_assert(to_diagnostic(a) == "[1, [2, 3]]", "nested array")
}

///|
test "diag_map_empty_and_pairs" {
  debug_assert(to_diagnostic(CborValue::Map([])) == "{}", "empty map")
  let m = CborValue::Map([
    (CborValue::Unsigned(1UL), CborValue::Unsigned(2UL)),
    (CborValue::Unsigned(3UL), CborValue::Unsigned(4UL)),
  ])
  debug_assert(to_diagnostic(m) == "{1: 2, 3: 4}", "int map")
}

///|
test "diag_tags_rfc8949" {
  let t0 = CborValue::Tag(0UL, CborValue::Text("2013-03-21T20:04:00Z"))
  debug_assert(to_diagnostic(t0) == "0(\"2013-03-21T20:04:00Z\")", "tag 0")
  let t24 = CborValue::Tag(24UL, CborValue::Bytes(hex_to_bytes("6449455446")))
  debug_assert(to_diagnostic(t24) == "24(h'6449455446')", "tag 24")
  let t32 = CborValue::Tag(32UL, CborValue::Text("http://www.example.com"))
  debug_assert(to_diagnostic(t32) == "32(\"http://www.example.com\")", "tag 32")
}

///|
test "diag_nested_tags" {
  let v = CborValue::Tag(55799UL, CborValue::Tag(1UL, CborValue::Unsigned(1700000000UL)))
  debug_assert(to_diagnostic(v) == "55799(1(1700000000))", "self-describe + epoch tag")
}

///|
test "roundtrip_webauthn_cose_es256_key" {
  let x_coord = Bytes::new(32)
  let y_coord = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    x_coord[i] = (i * 7 + 1).to_byte()
    y_coord[i] = (i * 11 + 3).to_byte()
    i = i + 1
  }
  let cose_key = CborValue::Map([
    (CborValue::Unsigned(1UL), CborValue::Unsigned(2UL)),
    (CborValue::Unsigned(3UL), CborValue::Negative(6UL)),
    (CborValue::Negative(0UL), CborValue::Unsigned(1UL)),
    (CborValue::Negative(1UL), CborValue::Bytes(x_coord)),
    (CborValue::Negative(2UL), CborValue::Bytes(y_coord)),
  ])
  let enc = unwrap_bytes(encode(cose_key, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  debug_assert(cbor_equals(dec, cose_key), "COSE ES256 key roundtrip")
}

///|
test "roundtrip_webauthn_attestation_object" {
  let auth_data = Bytes::new(64)
  let sig = Bytes::new(72)
  let mut i = 0
  while i < 64 {
    auth_data[i] = (i ^ 0x5A).to_byte()
    i = i + 1
  }
  let mut j = 0
  while j < 72 {
    sig[j] = (j * 3 + 5).to_byte()
    j = j + 1
  }
  let att = CborValue::Map([
    (CborValue::Text("fmt"), CborValue::Text("packed")),
    (
      CborValue::Text("attStmt"),
      CborValue::Map([
        (CborValue::Text("alg"), CborValue::Negative(6UL)),
        (CborValue::Text("sig"), CborValue::Bytes(sig)),
      ]),
    ),
    (CborValue::Text("authData"), CborValue::Bytes(auth_data)),
  ])
  let enc = unwrap_bytes(encode(att, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  let enc2 = unwrap_bytes(encode(dec, EncodeOptions::deterministic()))
  debug_assert(bytes_equal(enc, enc2), "deterministic re-encode byte-identical")
}

///|
test "roundtrip_telemetry_rpc_envelope" {
  let payload = CborValue::Map([
    (CborValue::Text("service"), CborValue::Text("stillfail-relay")),
    (CborValue::Text("seq"), CborValue::Unsigned(9876543210UL)),
    (CborValue::Text("latency_ms"), CborValue::Float(12.5)),
    (CborValue::Text("ok"), CborValue::Bool(true)),
    (CborValue::Text("err"), CborValue::Null),
    (
      CborValue::Text("tags"),
      CborValue::Array([CborValue::Text("tokyo"), CborValue::Text("arm64")]),
    ),
  ])
  let enc = unwrap_bytes(encode(payload, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  debug_assert(cbor_equals(dec, payload), "telemetry envelope roundtrip")
}

///|
test "roundtrip_self_described_cbor_tag_55799" {
  let v = CborValue::Tag(55799UL, CborValue::Text("hello"))
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(bytes_to_hex(enc) == "d9d9f76568656c6c6f", "tag 55799 magic prefix d9d9f7")
  debug_assert(cbor_equals(unwrap_val(decode_default(enc)), v), "tag 55799 roundtrip")
}

///|
test "roundtrip_complex_map_keys_array_and_bytes" {
  let m = CborValue::Map([
    (CborValue::Bytes(hex_to_bytes("0102")), CborValue::Text("bytes_key")),
    (CborValue::Array([CborValue::Unsigned(1UL), CborValue::Negative(0UL)]), CborValue::Bool(true)),
  ])
  let enc = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  debug_assert(cbor_equals(dec, m), "complex map keys roundtrip")
}

///|
test "roundtrip_large_byte_string_1024" {
  let b = Bytes::new(1024)
  let mut i = 0
  while i < 1024 {
    b[i] = (i % 256).to_byte()
    i = i + 1
  }
  let v = CborValue::Bytes(b)
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(enc.length() == 1027, "3-byte header + 1024 bytes")
  debug_assert(cbor_equals(unwrap_val(decode_default(enc)), v), "1024B bytes roundtrip")
}

///|
test "roundtrip_large_text_string_multibyte" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 50 {
    sb.write_string("你好CBOR🚀")
    i = i + 1
  }
  let v = CborValue::Text(sb.to_string())
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(cbor_equals(unwrap_val(decode_default(enc)), v), "multibyte text roundtrip")
}

///|
test "roundtrip_deep_valid_nesting_16" {
  let mut v = CborValue::Unsigned(42UL)
  let mut i = 0
  while i < 16 {
    v = CborValue::Array([v])
    i = i + 1
  }
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(cbor_equals(unwrap_val(decode_default(enc)), v), "16-level nesting roundtrip")
}

///|
test "roundtrip_mixed_types_array" {
  let v = CborValue::Array([
    CborValue::Unsigned(0UL),
    CborValue::Negative(0UL),
    CborValue::Bytes(hex_to_bytes("ff00")),
    CborValue::Text("abc"),
    CborValue::Bool(true),
    CborValue::Bool(false),
    CborValue::Null,
    CborValue::Undefined,
    CborValue::Simple(32),
    CborValue::Float(3.5),
    CborValue::Tag(1UL, CborValue::Unsigned(100UL)),
  ])
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(cbor_equals(unwrap_val(decode_default(enc)), v), "mixed array roundtrip")
}

///|
test "roundtrip_indef_bytes_multiple_chunks_concat" {
  // 5f 40 42 0102 40 43 030405 ff -> h'0102030405'
  let dec = unwrap_val(decode_default(hex_to_bytes("5f404201024043030405ff")))
  debug_assert(cbor_equals(dec, CborValue::Bytes(hex_to_bytes("0102030405"))), "concat chunks with empty chunks")
}

///|
test "roundtrip_indef_text_multiple_chunks_concat" {
  // 7f 60 62 6869 60 63 20c3bc ff -> "hi ü"
  let dec = unwrap_val(decode_default(hex_to_bytes("7f60626869606320c3bcff")))
  debug_assert(cbor_equals(dec, CborValue::Text("hi ü")), "concat text chunks with UTF-8")
}

///|
test "roundtrip_cbor_sequence_with_allow_trailing" {
  // Sequence of 3 items: 01, 6161 ("a"), f5 (true)
  let opts = DecodeOptions::{
    max_depth: 32,
    max_elements: 131072,
    reject_duplicate_keys: false,
    require_canonical: false,
    allow_trailing_bytes: true,
  }
  let seq = hex_to_bytes("016161f5")
  let v1 = unwrap_val(decode(seq, opts))
  debug_assert(cbor_equals(v1, CborValue::Unsigned(1UL)), "first item in sequence")
}

///|
test "roundtrip_error_messages_non_empty" {
  let e1 = CborError::UnexpectedEof(0)
  let e2 = CborError::MaxDepthExceeded(32)
  let e3 = CborError::DuplicateMapKey(4)
  debug_assert(error_message(e1).length() > 0, "eof msg")
  debug_assert(error_message(e2).length() > 0, "depth msg")
  debug_assert(error_message(e3).length() > 0, "dup msg")
}

///|
test "roundtrip_ctap2_make_credential_like_map" {
  // Realistic CTAP2 authenticatorMakeCredential structure with integer keys 1..7
  let req = CborValue::Map([
    (CborValue::Unsigned(1UL), CborValue::Bytes(Bytes::new(32))),
    (
      CborValue::Unsigned(2UL),
      CborValue::Map([
        (CborValue::Text("id"), CborValue::Text("example.com")),
        (CborValue::Text("name"), CborValue::Text("Example RP")),
      ]),
    ),
    (
      CborValue::Unsigned(3UL),
      CborValue::Map([
        (CborValue::Text("id"), CborValue::Bytes(hex_to_bytes("01020304"))),
        (CborValue::Text("name"), CborValue::Text("alice@example.com")),
      ]),
    ),
    (
      CborValue::Unsigned(4UL),
      CborValue::Array([
        CborValue::Map([
          (CborValue::Text("alg"), CborValue::Negative(6UL)),
          (CborValue::Text("type"), CborValue::Text("public-key")),
        ]),
      ]),
    ),
  ])
  let enc = unwrap_bytes(encode(req, EncodeOptions::ctap2()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  debug_assert(cbor_equals(dec, req), "CTAP2 makeCredential roundtrip")
}

///|
test "diag_control_char_escape" {
  let b = Bytes::new(1)
  b[0] = (1).to_byte()
  let s = b.to_string()
  debug_assert(to_diagnostic(CborValue::Text(s)) == "\"\\u0001\"", "control char 0x01 escaped")
}
