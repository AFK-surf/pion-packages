///| RFC 8949 Section 4.2 Core Deterministic Encoding, CTAP2 Canonical CBOR, and IEEE-754 float16/32/64 tests (45 tests).

///|
test "canon_uint_boundary_23_24" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(23UL)))) == "17", "23")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(24UL)))) == "1818", "24")
}

///|
test "canon_uint_boundary_255_256" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(255UL)))) == "18ff", "255")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(256UL)))) == "190100", "256")
}

///|
test "canon_uint_boundary_65535_65536" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(65535UL)))) == "19ffff", "65535")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(65536UL)))) == "1a00010000", "65536")
}

///|
test "canon_uint_boundary_u32max_plus1" {
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(4294967295UL)))) == "1affffffff",
    "u32::MAX",
  )
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(CborValue::Unsigned(4294967296UL)))) == "1b0000000100000000",
    "u32::MAX+1",
  )
}

///|
test "canon_negint_boundary_minus24_minus25" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(23UL)))) == "37", "-24")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(24UL)))) == "3818", "-25")
}

///|
test "canon_negint_boundary_minus256_minus257" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(255UL)))) == "38ff", "-256")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(256UL)))) == "390100", "-257")
}

///|
test "canon_negint_boundary_minus65536_minus65537" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(65535UL)))) == "39ffff", "-65536")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(65536UL)))) == "3a00010000", "-65537")
}

///|
test "canon_negint_boundary_u32max" {
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(4294967295UL)))) == "3affffffff",
    "-2^32",
  )
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(CborValue::Negative(4294967296UL)))) == "3b0000000100000000",
    "-2^32-1",
  )
}

///|
test "canon_float16_exact_integers_and_halves" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(0.0)))) == "f90000", "0.0")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(1.0)))) == "f93c00", "1.0")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(-1.0)))) == "f9bc00", "-1.0")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(0.5)))) == "f93800", "0.5")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(5.5)))) == "f94580", "5.5")
}

///|
test "canon_float16_neg_zero_preserved" {
  let nz = Double::from_bits(-9223372036854775808L)
  let enc = unwrap_bytes(encode_default(CborValue::Float(nz)))
  debug_assert(bytes_to_hex(enc) == "f98000", "-0.0 encodes to f98000")
  let dec = unwrap_val(decode_default(enc))
  match dec {
    Float(d) => debug_assert(d.to_bits() == -9223372036854775808L, "-0.0 sign bit preserved")
    _ => debug_assert(false, "expected Float")
  }
}

///|
test "canon_float16_subnormal_exact" {
  // Smallest positive subnormal 2^-24 = 5.960464477539063e-08 -> 0x0001
  let min_sub = float16_to_double(0x0001)
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(min_sub)))) == "f90001", "min subnormal")
  // Largest subnormal 0x03ff
  let max_sub = float16_to_double(0x03FF)
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(max_sub)))) == "f903ff", "max subnormal")
  // Negative subnormal 0x8001
  let neg_sub = float16_to_double(0x8001)
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(neg_sub)))) == "f98001", "neg subnormal")
}

///|
test "canon_float16_max_and_overflow_to_float32" {
  // 65504.0 fits in float16 (f97bff), 65536.0 needs float32 (fa47800000)
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(65504.0)))) == "f97bff", "65504")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(65536.0)))) == "fa47800000", "65536")
}

///|
test "canon_float32_exact_5555_5" {
  // RFC 8949 Section 4.2.1 example: 5555.5 -> 0xfa45ad9c00
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(5555.5)))) == "fa45ad9c00", "5555.5")
}

///|
test "canon_float32_subnormal_roundtrip" {
  // Smallest positive float32 subnormal: 0x00000001 = 2^-149
  let raw = hex_to_bytes("fa00000001")
  let v = unwrap_val(decode_default(raw))
  let enc = unwrap_bytes(encode_default(v))
  debug_assert(bytes_to_hex(enc) == "fa00000001", "float32 min subnormal")
}

///|
test "canon_float64_required_when_precision_lost" {
  // 1.1 cannot be represented in float32 without precision loss
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(1.1)))) == "fb3ff199999999999a", "1.1")
  // 0.1 cannot be represented in float32
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(0.1)))) == "fb3fb999999999999a", "0.1")
}

///|
test "canon_float_no_shortest_option_uses_float64" {
  let opts = EncodeOptions::{ sort_mode: SortMode::None, shortest_float: false }
  let enc = unwrap_bytes(encode(CborValue::Float(1.0), opts))
  debug_assert(bytes_to_hex(enc) == "fb3ff0000000000000", "shortest_float=false -> float64")
}

///|
test "canon_float_nan_always_f97e00_when_shortest" {
  let nan64 = Double::from_bits(0x7FF8000000000001L)
  let enc = unwrap_bytes(encode_default(CborValue::Float(nan64)))
  debug_assert(bytes_to_hex(enc) == "f97e00", "canonical NaN is f97e00")
}

///|
test "canon_float_inf_shortest_is_float16" {
  let pos_inf = Double::from_bits(0x7FF0000000000000L)
  let neg_inf = Double::from_bits(-4503599627370496L)
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(pos_inf)))) == "f97c00", "+Inf")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Float(neg_inf)))) == "f9fc00", "-Inf")
}

///|
test "canon_float16_all_normals_roundtrip_sample" {
  // Sample float16 bit patterns across negative/positive normals and subnormals
  let samples = [0x0000, 0x0001, 0x0200, 0x03FF, 0x0400, 0x3555, 0x3C00, 0x3E00, 0x4000, 0x7BFF, 0x8000, 0x8001, 0xBC00, 0xC400, 0xFBFF]
  let mut i = 0
  while i < samples.length() {
    let h = samples[i]
    let d = float16_to_double(h)
    match double_to_float16_exact(d) {
      Some(back) => debug_assert(back == h, "float16 roundtrip mismatch for " + h.to_string())
      None => debug_assert(false, "expected Some for float16 " + h.to_string())
    }
    i = i + 1
  }
}

///|
test "canon_sort_core_deterministic_rfc8949_example" {
  // RFC 8949 Section 4.2.1 sorting example:
  // 10 (0x0a) < 100 (0x1864) < -1 (0x20) < "z" (0x617a) < "aa" (0x626161) < [100] (0x811864) < [-1] (0x8120) < false (0xf4)
  let m = CborValue::Map([
    (CborValue::Bool(false), CborValue::Unsigned(8UL)),
    (CborValue::Text("aa"), CborValue::Unsigned(5UL)),
    (CborValue::Negative(0UL), CborValue::Unsigned(3UL)),
    (CborValue::Array([CborValue::Negative(0UL)]), CborValue::Unsigned(7UL)),
    (CborValue::Unsigned(100UL), CborValue::Unsigned(2UL)),
    (CborValue::Text("z"), CborValue::Unsigned(4UL)),
    (CborValue::Array([CborValue::Unsigned(100UL)]), CborValue::Unsigned(6UL)),
    (CborValue::Unsigned(10UL), CborValue::Unsigned(1UL)),
  ])
  let enc = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode_default(enc))
  match dec {
    Map(pairs) => {
      debug_assert(pairs.length() == 8, "8 pairs")
      let mut i = 0
      while i < 8 {
        let (_, v) = pairs[i]
        debug_assert(cbor_equals(v, CborValue::Unsigned((i + 1).to_int64().to_uint64())), "order at " + i.to_string())
        i = i + 1
      }
    }
    _ => debug_assert(false, "expected Map")
  }
}

///|
test "canon_sort_ctap2_length_first_vs_core_deterministic" {
  // Key 100 encodes to 0x1864 (2 bytes); key -1 encodes to 0x20 (1 byte).
  // CoreDeterministic (bytewise lex): 0x1864 < 0x20 => 100 before -1.
  // Ctap2 / RFC 7049 §3.9 (length-first then bytewise): len(0x20)=1 < len(0x1864)=2 => -1 before 100.
  let m = CborValue::Map([
    (CborValue::Unsigned(100UL), CborValue::Text("hundred")),
    (CborValue::Negative(0UL), CborValue::Text("neg1")),
  ])
  let core_bytes = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  let ctap_bytes = unwrap_bytes(encode(m, EncodeOptions::ctap2()))
  // CoreDeterministic: a2 1864 6768756e64726564 20 646e656731
  debug_assert(
    bytes_to_hex(core_bytes) == "a218646768756e6472656420646e656731",
    "core det puts 100 before -1",
  )
  // Ctap2 length-first: a2 20 646e656731 1864 6768756e64726564
  debug_assert(
    bytes_to_hex(ctap_bytes) == "a220646e65673118646768756e64726564",
    "ctap2 length-first puts -1 before 100",
  )
}

///|
test "canon_sort_ctap2_1000_vs_text_a" {
  // 1000 -> 1903e8 (3 bytes), "a" -> 6161 (2 bytes)
  // CoreDeterministic: 0x19 < 0x61 => 1000 before "a"
  // Ctap2 length-first: len 2 < len 3 => "a" before 1000
  let m = CborValue::Map([
    (CborValue::Unsigned(1000UL), CborValue::Unsigned(1UL)),
    (CborValue::Text("a"), CborValue::Unsigned(2UL)),
  ])
  let core_hex = bytes_to_hex(unwrap_bytes(encode(m, EncodeOptions::deterministic())))
  let ctap_hex = bytes_to_hex(unwrap_bytes(encode(m, EncodeOptions::ctap2())))
  debug_assert(core_hex == "a21903e801616102", "core: 1000 before a")
  debug_assert(ctap_hex == "a26161021903e801", "ctap2: a before 1000")
}

///|
test "canon_sort_ctap2_cose_key_order" {
  // Real WebAuthn COSE_Key (ES256): keys 1 (kty), 3 (alg), -1 (crv), -2 (x), -3 (y)
  // Encoded keys: 1->0x01, 3->0x03, -1->0x20, -2->0x21, -3->0x22 (all 1 byte!)
  let m = CborValue::Map([
    (CborValue::Negative(2UL), CborValue::Bytes(hex_to_bytes("bbbb"))),
    (CborValue::Negative(0UL), CborValue::Unsigned(1UL)),
    (CborValue::Unsigned(3UL), CborValue::Negative(6UL)),
    (CborValue::Negative(1UL), CborValue::Bytes(hex_to_bytes("aaaa"))),
    (CborValue::Unsigned(1UL), CborValue::Unsigned(2UL)),
  ])
  let core_hex = bytes_to_hex(unwrap_bytes(encode(m, EncodeOptions::deterministic())))
  let ctap_hex = bytes_to_hex(unwrap_bytes(encode(m, EncodeOptions::ctap2())))
  let expected = "a50102032620012142aaaa2242bbbb"
  debug_assert(core_hex == expected, "COSE key core deterministic order")
  debug_assert(ctap_hex == expected, "COSE key ctap2 order")
}

///|
test "canon_sort_text_keys_same_length_lex" {
  let m = CborValue::Map([
    (CborValue::Text("fmt"), CborValue::Text("packed")),
    (CborValue::Text("attStmt"), CborValue::Map([])),
    (CborValue::Text("authData"), CborValue::Bytes(hex_to_bytes("deadbeef"))),
  ])
  let enc = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  // "fmt" (len 3 -> 0x63) < "attStmt" (len 7 -> 0x67) < "authData" (len 8 -> 0x68)
  let dec = unwrap_val(decode_default(enc))
  match dec {
    Map(pairs) => {
      let (k0, _) = pairs[0]
      let (k1, _) = pairs[1]
      let (k2, _) = pairs[2]
      debug_assert(cbor_equals(k0, CborValue::Text("fmt")), "k0=fmt")
      debug_assert(cbor_equals(k1, CborValue::Text("attStmt")), "k1=attStmt")
      debug_assert(cbor_equals(k2, CborValue::Text("authData")), "k2=authData")
    }
    _ => debug_assert(false, "expected Map")
  }
}

///|
test "canon_sort_none_preserves_insertion_order" {
  let m = CborValue::Map([
    (CborValue::Text("z"), CborValue::Unsigned(1UL)),
    (CborValue::Text("a"), CborValue::Unsigned(2UL)),
  ])
  let enc = unwrap_bytes(encode(m, EncodeOptions::default()))
  debug_assert(bytes_to_hex(enc) == "a2617a01616102", "SortMode::None preserves order")
}

///|
test "canon_sort_nested_maps_sorted_recursively" {
  let inner = CborValue::Map([
    (CborValue::Text("bb"), CborValue::Unsigned(2UL)),
    (CborValue::Text("a"), CborValue::Unsigned(1UL)),
  ])
  let outer = CborValue::Map([
    (CborValue::Text("second"), inner),
    (CborValue::Text("first"), CborValue::Unsigned(0UL)),
  ])
  let enc = unwrap_bytes(encode(outer, EncodeOptions::deterministic()))
  let strict = DecodeOptions::strict()
  let dec = unwrap_val(decode(enc, strict))
  match dec {
    Map(pairs) => {
      let (k0, _) = pairs[0]
      let (k1, v1) = pairs[1]
      debug_assert(cbor_equals(k0, CborValue::Text("first")), "outer sorted")
      debug_assert(cbor_equals(k1, CborValue::Text("second")), "outer sorted 2")
      match v1 {
        Map(ip) => {
          let (ik0, _) = ip[0]
          debug_assert(cbor_equals(ik0, CborValue::Text("a")), "inner sorted")
        }
        _ => debug_assert(false, "expected inner Map")
      }
    }
    _ => debug_assert(false, "expected outer Map")
  }
}

///|
test "canon_encode_rejects_duplicate_keys_in_deterministic_mode" {
  let m = CborValue::Map([
    (CborValue::Text("dup"), CborValue::Unsigned(1UL)),
    (CborValue::Text("dup"), CborValue::Unsigned(2UL)),
  ])
  debug_assert(is_err_bytes(encode(m, EncodeOptions::deterministic())), "dup key rejected in core det")
  debug_assert(is_err_bytes(encode(m, EncodeOptions::ctap2())), "dup key rejected in ctap2")
}

///|
test "canon_encode_rejects_invalid_simple_value" {
  // Simple values 24..31 are reserved/invalid in RFC 8949; > 255 or < 0 also invalid
  debug_assert(is_err_bytes(encode_default(CborValue::Simple(24))), "simple(24) forbidden")
  debug_assert(is_err_bytes(encode_default(CborValue::Simple(31))), "simple(31) forbidden")
  debug_assert(is_err_bytes(encode_default(CborValue::Simple(-1))), "simple(-1) forbidden")
  debug_assert(is_err_bytes(encode_default(CborValue::Simple(256))), "simple(256) forbidden")
}

///|
test "canon_encode_simple_valid_ranges" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(0)))) == "e0", "simple(0)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(19)))) == "f3", "simple(19)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(32)))) == "f820", "simple(32)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(255)))) == "f8ff", "simple(255)")
}

///|
test "canon_encode_simple_20_to_23_maps_to_prim" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(20)))) == "f4", "simple(20)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(21)))) == "f5", "simple(21)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(22)))) == "f6", "simple(22)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Simple(23)))) == "f7", "simple(23)")
}

///|
test "canon_decode_strict_accepts_core_deterministic" {
  let m = CborValue::Map([
    (CborValue::Unsigned(10UL), CborValue::Bool(true)),
    (CborValue::Unsigned(100UL), CborValue::Float(1.5)),
    (CborValue::Negative(0UL), CborValue::Text("ok")),
  ])
  let enc = unwrap_bytes(encode(m, EncodeOptions::deterministic()))
  let dec = unwrap_val(decode(enc, DecodeOptions::strict()))
  debug_assert(cbor_equals(dec, m), "strict decode accepts deterministic output")
}

///|
test "canon_decode_strict_rejects_overlong_uint_1byte" {
  // 0x18 0x17 encodes 23 in 2 bytes instead of 1 byte 0x17
  let raw = hex_to_bytes("1817")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Unsigned(23UL)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong uint8")
}

///|
test "canon_decode_strict_rejects_overlong_uint_2byte" {
  // 0x19 0x00 0xff encodes 255 in 3 bytes instead of 2 bytes 0x18ff
  let raw = hex_to_bytes("1900ff")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Unsigned(255UL)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong uint16")
}

///|
test "canon_decode_strict_rejects_overlong_uint_4byte" {
  let raw = hex_to_bytes("1a0000ffff")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Unsigned(65535UL)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong uint32")
}

///|
test "canon_decode_strict_rejects_overlong_uint_8byte" {
  let raw = hex_to_bytes("1b00000000ffffffff")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Unsigned(4294967295UL)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong uint64")
}

///|
test "canon_decode_strict_rejects_overlong_negint" {
  let raw = hex_to_bytes("3800")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Negative(0UL)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong negint")
}

///|
test "canon_decode_strict_rejects_overlong_length" {
  // Byte string of len 1 encoded with 1-byte length: 0x58 0x01 0xaa
  let raw = hex_to_bytes("5801aa")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Bytes(hex_to_bytes("aa"))), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects overlong byte length")
}

///|
test "canon_decode_strict_rejects_overlong_float32_for_1_0" {
  // 1.0 as float32: fa 3f800000 (should be f9 3c00)
  let raw = hex_to_bytes("fa3f800000")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Float(1.0)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects non-shortest float32")
}

///|
test "canon_decode_strict_rejects_overlong_float64_for_1_5" {
  // 1.5 as float64: fb 3ff8000000000000 (should be f9 3e00)
  let raw = hex_to_bytes("fb3ff8000000000000")
  debug_assert(cbor_equals(unwrap_val(decode_default(raw)), CborValue::Float(1.5)), "non-strict accepts")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects non-shortest float64")
}

///|
test "canon_decode_strict_rejects_noncanonical_nan_and_inf" {
  debug_assert(is_err_val(decode(hex_to_bytes("fa7fc00000"), DecodeOptions::strict())), "f32 NaN")
  debug_assert(is_err_val(decode(hex_to_bytes("fb7ff8000000000000"), DecodeOptions::strict())), "f64 NaN")
  debug_assert(is_err_val(decode(hex_to_bytes("f97e01"), DecodeOptions::strict())), "non-7e00 f16 NaN")
  debug_assert(is_err_val(decode(hex_to_bytes("fa7f800000"), DecodeOptions::strict())), "f32 +Inf")
  debug_assert(is_err_val(decode(hex_to_bytes("fbfff0000000000000"), DecodeOptions::strict())), "f64 -Inf")
}

///|
test "canon_decode_strict_rejects_indefinite_length" {
  debug_assert(is_err_val(decode(hex_to_bytes("5fff"), DecodeOptions::strict())), "indef bytes")
  debug_assert(is_err_val(decode(hex_to_bytes("7fff"), DecodeOptions::strict())), "indef text")
  debug_assert(is_err_val(decode(hex_to_bytes("9fff"), DecodeOptions::strict())), "indef array")
  debug_assert(is_err_val(decode(hex_to_bytes("bfff"), DecodeOptions::strict())), "indef map")
}

///|
test "canon_decode_strict_rejects_unsorted_map_keys" {
  // {"b": 1, "a": 2} -> a2 6162 01 6161 02 (unsorted!)
  let raw = hex_to_bytes("a2616201616102")
  debug_assert(!is_err_val(decode_default(raw)), "non-strict accepts unsorted")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects unsorted map keys")
}

///|
test "canon_decode_strict_rejects_duplicate_map_keys" {
  // {1: 2, 1: 3} -> a2 01 02 01 03
  let raw = hex_to_bytes("a201020103")
  debug_assert(is_err_val(decode(raw, DecodeOptions::strict())), "strict rejects dup map keys")
}

///|
test "canon_tag_encoding_boundaries" {
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Tag(23UL, CborValue::Null)))) == "d7f6", "tag 23")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Tag(24UL, CborValue::Null)))) == "d818f6", "tag 24")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Tag(256UL, CborValue::Null)))) == "d90100f6", "tag 256")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(CborValue::Tag(65536UL, CborValue::Null)))) == "da00010000f6", "tag 65536")
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(CborValue::Tag(4294967296UL, CborValue::Null)))) == "db0000000100000000f6",
    "tag 2^32",
  )
}

///|
test "canon_bytes_and_text_length_24_and_256" {
  let b24 = Bytes::new(24)
  let enc24 = unwrap_bytes(encode_default(CborValue::Bytes(b24)))
  debug_assert(enc24.length() == 26 && enc24[0].to_int() == 0x58 && enc24[1].to_int() == 24, "24 bytes")
  let b256 = Bytes::new(256)
  let enc256 = unwrap_bytes(encode_default(CborValue::Bytes(b256)))
  debug_assert(
    enc256.length() == 259 && enc256[0].to_int() == 0x59 && enc256[1].to_int() == 1 && enc256[2].to_int() == 0,
    "256 bytes",
  )
}
