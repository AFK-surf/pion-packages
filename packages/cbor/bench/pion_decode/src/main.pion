///| Benchmark Workload 2: CBOR Batch Decode + Structural Verification (WebAuthn/COSE + Telemetry RPC).

import "cbor"

///|
val struct WalkStats {
  nodes : Int64
  checksum : UInt64
}

///|
fn walk_value(value : cbor::CborValue) -> WalkStats {
  match value {
    Unsigned(u) => WalkStats::{ nodes: 1L, checksum: u + 1UL }
    Negative(n) => WalkStats::{ nodes: 1L, checksum: (n + 1UL) * 3UL }
    Bytes(b) => {
      let mut h : UInt64 = b.length().to_int64().to_uint64() * 7UL
      if b.length() > 0 {
        h = h + b[0].to_int().to_int64().to_uint64()
        h = h + b[b.length() - 1].to_int().to_int64().to_uint64()
      }
      WalkStats::{ nodes: 1L, checksum: h }
    }
    Text(s) => WalkStats::{ nodes: 1L, checksum: s.length().to_int64().to_uint64() * 11UL }
    Bool(b) => WalkStats::{ nodes: 1L, checksum: if b { 13UL } else { 17UL } }
    Null => WalkStats::{ nodes: 1L, checksum: 19UL }
    Undefined => WalkStats::{ nodes: 1L, checksum: 23UL }
    Simple(v) => WalkStats::{ nodes: 1L, checksum: v.to_int64().to_uint64() * 29UL }
    Float(d) => WalkStats::{ nodes: 1L, checksum: d.to_bits().to_uint64() }
    Tag(t, inner) => {
      let sub = walk_value(inner)
      WalkStats::{ nodes: 1L + sub.nodes, checksum: t * 31UL + sub.checksum }
    }
    Array(items) => {
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = items.length().to_int64().to_uint64() * 37UL
      let mut i = 0
      while i < items.length() {
        let sub = walk_value(items[i])
        nodes = nodes + sub.nodes
        sum = sum + sub.checksum
        i = i + 1
      }
      WalkStats::{ nodes: nodes, checksum: sum }
    }
    Map(pairs) => {
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = pairs.length().to_int64().to_uint64() * 41UL
      let mut i = 0
      while i < pairs.length() {
        let (k, v) = pairs[i]
        let sk = walk_value(k)
        let sv = walk_value(v)
        nodes = nodes + sk.nodes + sv.nodes
        sum = sum + sk.checksum + sv.checksum
        i = i + 1
      }
      WalkStats::{ nodes: nodes, checksum: sum }
    }
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_decode <corpus.cbor>")
    return 1
  }
  let path = args[1]
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let rounds = 40
  let opts = cbor::DecodeOptions::default()
  let mut total_nodes : Int64 = 0L
  let mut total_checksum : UInt64 = 0UL
  let mut r = 0
  while r < rounds {
    let val_dec = match cbor::decode(data, opts) {
      Ok(v) => v
      Err(_) => return 2
    }
    let st = walk_value(val_dec)
    total_nodes = total_nodes + st.nodes
    total_checksum = total_checksum + st.checksum
    r = r + 1
  }
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "bytes=" + data.length().to_string())
  io_println(world, "nodes=" + total_nodes.to_string())
  io_println(world, "checksum=" + total_checksum.to_string())
  0
}
