///| Benchmark Workload 1: Deterministic CBOR Batch Encode (WebAuthn/COSE + Telemetry RPC).

import "cbor"

///|
fn make_bytes(len : Int, seed : Int) -> Bytes {
  let b = Bytes::new(len)
  let mut i = 0
  while i < len {
    b[i] = ((seed * 31 + i * 17 + 7) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn fnv1a_update(h : UInt64, data : Bytes) -> UInt64 {
  let mut acc = h
  let mut i = 0
  let n = data.length()
  while i < n {
    acc = (acc ^ data[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let ops = 50000
  let opts = cbor::EncodeOptions::deterministic()
  let mut total_bytes : Int64 = 0L
  let mut hash : UInt64 = 14695981039346656037UL

  let mut i = 0
  while i < ops {
    let auth_data = make_bytes(37, i)
    let sig = make_bytes(64, i + 1)
    let x_coord = make_bytes(32, i + 2)
    let y_coord = make_bytes(32, i + 3)

    let cose_key = cbor::CborValue::Map([
      (cbor::CborValue::Unsigned(1UL), cbor::CborValue::Unsigned(2UL)),
      (cbor::CborValue::Unsigned(3UL), cbor::CborValue::Negative(6UL)),
      (cbor::CborValue::Negative(0UL), cbor::CborValue::Unsigned(1UL)),
      (cbor::CborValue::Negative(1UL), cbor::CborValue::Bytes(x_coord)),
      (cbor::CborValue::Negative(2UL), cbor::CborValue::Bytes(y_coord)),
    ])

    let att_stmt = cbor::CborValue::Map([
      (cbor::CborValue::Text("alg"), cbor::CborValue::Negative(6UL)),
      (cbor::CborValue::Text("sig"), cbor::CborValue::Bytes(sig)),
    ])

    let telemetry = cbor::CborValue::Map([
      (cbor::CborValue::Text("ok"), cbor::CborValue::Bool(i % 2 == 0)),
      (cbor::CborValue::Text("seq"), cbor::CborValue::Unsigned(i.to_int64().to_uint64())),
      (
        cbor::CborValue::Text("tags"),
        cbor::CborValue::Array([
          cbor::CborValue::Text("tokyo"),
          cbor::CborValue::Text("arm64"),
          cbor::CborValue::Text("cbor"),
        ]),
      ),
      (cbor::CborValue::Text("latency_ms"), cbor::CborValue::Float(12.3)),
    ])

    let record = cbor::CborValue::Map([
      (cbor::CborValue::Text("fmt"), cbor::CborValue::Text("packed")),
      (cbor::CborValue::Text("coseKey"), cose_key),
      (cbor::CborValue::Text("attStmt"), att_stmt),
      (cbor::CborValue::Text("authData"), cbor::CborValue::Bytes(auth_data)),
      (cbor::CborValue::Text("telemetry"), telemetry),
    ])

    let encoded = match cbor::encode(record, opts) {
      Ok(b) => b
      Err(_) => return 1
    }
    total_bytes = total_bytes + encoded.length().to_int64()
    hash = fnv1a_update(hash, encoded)
    i = i + 1
  }

  io_println(world, "ops=" + ops.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "fnv1a=" + hash.to_string())
  0
}
