///| RFC 8949 Appendix A official test vectors (all 83 vectors from cbor/test-vectors/appendix_a.json).

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    debug_assert(false, "invalid hex char")
    0
  }
}

///|
fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length()
  debug_assert(n % 2 == 0, "hex string must have even length")
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn nibble_to_hex(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (97 + n - 10).to_byte()
  }
}

///|
fn bytes_to_hex(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_byte(nibble_to_hex((v >> 4) & 15))
    sb.write_byte(nibble_to_hex(v & 15))
    i = i + 1
  }
  sb.to_string()
}

///|
fn unwrap_val(r : Result[CborValue, CborError]) -> CborValue {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(CborValue), got Err: " + error_message(e))
      CborValue::Null
    }
  }
}

///|
fn unwrap_bytes(r : Result[Bytes, CborError]) -> Bytes {
  match r {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "expected Ok(Bytes), got Err: " + error_message(e))
      Bytes::new(0)
    }
  }
}

///|
fn is_err_val(r : Result[CborValue, CborError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_bytes(r : Result[Bytes, CborError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn assert_vec_roundtrip(hex : String, expected : CborValue) -> Unit {
  let raw = hex_to_bytes(hex)
  let decoded = unwrap_val(decode_default(raw))
  debug_assert(
    cbor_equals(decoded, expected),
    "decode mismatch for hex " + hex + ": got " + to_diagnostic(decoded) + ", want " + to_diagnostic(expected),
  )
  let reencoded = unwrap_bytes(encode_default(expected))
  debug_assert(
    bytes_to_hex(reencoded) == hex,
    "encode mismatch for hex " + hex + ": got " + bytes_to_hex(reencoded),
  )
}

///|
fn assert_vec_decode_only(hex : String, expected : CborValue) -> Unit {
  let raw = hex_to_bytes(hex)
  let decoded = unwrap_val(decode_default(raw))
  debug_assert(
    cbor_equals(decoded, expected),
    "decode mismatch for hex " + hex + ": got " + to_diagnostic(decoded) + ", want " + to_diagnostic(expected),
  )
}

///|
fn assert_vec_diag(hex : String, expected_diag : String, roundtrip : Bool) -> Unit {
  let raw = hex_to_bytes(hex)
  let decoded = unwrap_val(decode_default(raw))
  let got_diag = to_diagnostic(decoded)
  debug_assert(
    got_diag == expected_diag,
    "diag mismatch for hex " + hex + ": got " + got_diag + ", want " + expected_diag,
  )
  if roundtrip {
    let reencoded = unwrap_bytes(encode_default(decoded))
    debug_assert(
      bytes_to_hex(reencoded) == hex,
      "roundtrip mismatch for hex " + hex + ": got " + bytes_to_hex(reencoded),
    )
  }
}

///|
test "appendix_a_01_uint_0" {
  assert_vec_roundtrip("00", CborValue::Unsigned(0UL))
}

