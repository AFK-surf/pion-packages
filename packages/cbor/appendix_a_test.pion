///|
test "appendix_a_46_simple_24_invalid_or_rfc_note" {
  // Note: appendix_a.json historically had f818 from RFC 7049,
  // while RFC 8949 Section 3.3 explicitly states 0xf8 followed by < 0x20 is NOT well-formed!
  // We verify RFC 8949 strict rejection for 0xf818 and valid 0xf820 (simple(32)).
  debug_assert(is_err_val(decode_default(hex_to_bytes("f818"))), "RFC 8949 forbids 0xf818")
  assert_vec_roundtrip("f820", CborValue::Simple(32))
}

