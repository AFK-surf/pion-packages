    "8301820203820405",
    CborValue::Array([
      CborValue::Unsigned(1UL),
      CborValue::Array([CborValue::Unsigned(2UL), CborValue::Unsigned(3UL)]),
      CborValue::Array([CborValue::Unsigned(4UL), CborValue::Unsigned(5UL)]),
    ]),
  )
}

///|
test "appendix_a_66_array_25_items" {
  let items : Array[CborValue] = []
  let mut i = 1
  while i <= 25 {
    items.push(CborValue::Unsigned(i.to_int64().to_uint64()))
    i = i + 1
  }
  assert_vec_roundtrip(
    "98190102030405060708090a0b0c0d0e0f101112131415161718181819",
    CborValue::Array(items),
  )
}

