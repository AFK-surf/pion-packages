///|
test "sec_invalid_simple_value_f8_below_32" {
  // RFC 8949 Section 3.3: 0xf8 followed by 0x00..0x1f is NOT well-formed
  debug_assert(is_err_val(decode_default(hex_to_bytes("f800"))), "f800")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f813"))), "f813")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f814"))), "f814 (false)")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f815"))), "f815 (true)")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f816"))), "f816 (null)")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f817"))), "f817 (undefined)")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f818"))), "f818")
  debug_assert(is_err_val(decode_default(hex_to_bytes("f81f"))), "f81f")
}

///|
test "sec_invalid_utf8_lone_continuation" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("6180"))), "0x80")
  debug_assert(is_err_val(decode_default(hex_to_bytes("61bf"))), "0xbf")
}

///|
test "sec_invalid_utf8_overlong_2byte" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("62c0af"))), "overlong /")
  debug_assert(is_err_val(decode_default(hex_to_bytes("62c1bf"))), "overlong 0x7f")
}

///|
test "sec_invalid_utf8_overlong_3byte" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("63e080af"))), "overlong 3-byte")
  debug_assert(is_err_val(decode_default(hex_to_bytes("63e09fbf"))), "overlong 3-byte boundary")
}

///|
test "sec_invalid_utf8_overlong_4byte" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("64f08080af"))), "overlong 4-byte")
  debug_assert(is_err_val(decode_default(hex_to_bytes("64f08fbfbf"))), "overlong 4-byte boundary")
}

///|
test "sec_invalid_utf8_surrogate_half" {
  // U+D800 = ED A0 80, U+DFFF = ED BF BF
  debug_assert(is_err_val(decode_default(hex_to_bytes("63eda080"))), "high surrogate")
  debug_assert(is_err_val(decode_default(hex_to_bytes("63edbfbf"))), "low surrogate")
}

///|
test "sec_invalid_utf8_above_max_unicode" {
  // U+110000 = F4 90 80 80; 0xF5..0xFF invalid
  debug_assert(is_err_val(decode_default(hex_to_bytes("64f4908080"))), "above U+10FFFF")
  debug_assert(is_err_val(decode_default(hex_to_bytes("61fe"))), "0xfe")
  debug_assert(is_err_val(decode_default(hex_to_bytes("61ff"))), "0xff")
}

///|
test "sec_invalid_utf8_truncated_multibyte" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("61c2"))), "truncated 2-byte")
  debug_assert(is_err_val(decode_default(hex_to_bytes("62e282"))), "truncated 3-byte")
  debug_assert(is_err_val(decode_default(hex_to_bytes("63f09085"))), "truncated 4-byte")
}

///|
test "sec_invalid_utf8_split_across_indef_text_chunks" {
  // RFC 8949 Section 3.2.3: each chunk of an indefinite-length text string MUST be valid UTF-8 on its own!
  // Splitting "ü" (c3 bc) across two chunks must fail.
  debug_assert(is_err_val(decode_default(hex_to_bytes("7f61c361bcff"))), "split UTF-8 across chunks")
}

///|
test "sec_oom_defense_huge_byte_string_length" {
  // Claims 2^64-1 bytes with 0 payload bytes -> must fail immediately with EOF, no OOM!
  debug_assert(is_err_val(decode_default(hex_to_bytes("5bffffffffffffffff"))), "huge bytes u64::MAX")
  debug_assert(is_err_val(decode_default(hex_to_bytes("5a7fffffff"))), "huge bytes 2GB")
}

///|
test "sec_oom_defense_huge_text_string_length" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("7bffffffffffffffff"))), "huge text u64::MAX")
  debug_assert(is_err_val(decode_default(hex_to_bytes("7a7fffffff"))), "huge text 2GB")
}

///|
test "sec_oom_defense_huge_array_length" {
  // Claims 2^64-1 or 2^31-1 array elements with 0 payload bytes -> must fail immediately, no OOM!
  debug_assert(is_err_val(decode_default(hex_to_bytes("9bffffffffffffffff"))), "huge array u64::MAX")
  debug_assert(is_err_val(decode_default(hex_to_bytes("9a7fffffff"))), "huge array 2G")
  debug_assert(is_err_val(decode_default(hex_to_bytes("9a00010000"))), "array 65536 truncated")
}

///|
test "sec_oom_defense_huge_map_length" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("bbffffffffffffffff"))), "huge map u64::MAX")
  debug_assert(is_err_val(decode_default(hex_to_bytes("ba7fffffff"))), "huge map 2G")
  debug_assert(is_err_val(decode_default(hex_to_bytes("ba00010000"))), "map 65536 truncated")
}

///|
test "sec_depth_32_array_allowed" {
  // 32 nested arrays: 81 repeated 32 times + 01
  let raw = hex_to_bytes("818181818181818181818181818181818181818181818181818181818181818101")
  debug_assert(!is_err_val(decode_default(raw)), "32-level array allowed by default")
}

///|
test "sec_depth_33_array_rejected" {
  // 33 nested arrays: 81 repeated 33 times + 01
  let raw = hex_to_bytes("81818181818181818181818181818181818181818181818181818181818181818101")
  debug_assert(is_err_val(decode_default(raw)), "33-level array rejected by default max_depth=32")
}

///|
test "sec_depth_33_indef_array_rejected" {
  let raw = hex_to_bytes("9f01818181818181818181818181818181818181818181818181818181818181818101ff")
  debug_assert(is_err_val(decode_default(raw)), "33-level indef array rejected")
}

///|
test "sec_depth_33_map_rejected" {
  let raw = hex_to_bytes("a101818181818181818181818181818181818181818181818181818181818181818101")
  debug_assert(is_err_val(decode_default(raw)), "33-level map rejected")
}

///|
test "sec_depth_33_nested_tags_rejected" {
  // 33 nested tags: d864 repeated 33 times + 00
  let raw = hex_to_bytes(
    "d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d864d86400",
  )
  debug_assert(is_err_val(decode_default(raw)), "33 nested tags rejected")
}

///|
test "sec_custom_max_depth_4" {
  let opts = DecodeOptions::{
    max_depth: 4,
    max_elements: 131072,
    reject_duplicate_keys: false,
    require_canonical: false,
    allow_trailing_bytes: false,
  }
  debug_assert(!is_err_val(decode(hex_to_bytes("8181818101"), opts)), "depth 4 ok")
  debug_assert(is_err_val(decode(hex_to_bytes("818181818101"), opts)), "depth 5 rejected")
}

///|
test "sec_max_elements_limit_definite_and_indef" {
  let opts = DecodeOptions::{
    max_depth: 32,
    max_elements: 4,
    reject_duplicate_keys: false,
    require_canonical: false,
    allow_trailing_bytes: false,
  }
  debug_assert(!is_err_val(decode(hex_to_bytes("8401020304"), opts)), "4 elems ok")
  debug_assert(is_err_val(decode(hex_to_bytes("850102030405"), opts)), "5 elems rejected")
  debug_assert(!is_err_val(decode(hex_to_bytes("9f01020304ff"), opts)), "indef 4 elems ok")
  debug_assert(is_err_val(decode(hex_to_bytes("9f0102030405ff"), opts)), "indef 5 elems rejected")
}

///|
test "sec_duplicate_map_keys_rejected_when_enabled" {
  let opts = DecodeOptions::{
    max_depth: 32,
    max_elements: 131072,
    reject_duplicate_keys: true,
    require_canonical: false,
    allow_trailing_bytes: false,
  }
  // {1: 2, 1: 3}
  debug_assert(is_err_val(decode(hex_to_bytes("a201020103"), opts)), "dup int key")
  // {"a": 1, "a": 2}
  debug_assert(is_err_val(decode(hex_to_bytes("a2616101616102"), opts)), "dup text key")
  // {0: 1, 0(overlong 1800): 2} -> same value 0!
  debug_assert(is_err_val(decode(hex_to_bytes("a20001180002"), opts)), "dup overlong int key")
  // {2: 1, simple(2): 2} -> DISTINCT keys!
  debug_assert(!is_err_val(decode(hex_to_bytes("a20201e202"), opts)), "uint(2) != simple(2)")
}

///|
test "sec_validate_api_matches_decode" {
  match validate(hex_to_bytes("a26161016162820203"), DecodeOptions::default()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "expected valid: " + error_message(e))
  }
  match validate(hex_to_bytes("81ff"), DecodeOptions::default()) {
    Ok(_) => debug_assert(false, "expected invalid")
    Err(_) => ()
  }
}
