///|
test "sec_trailing_bytes_rejected_by_default" {
  debug_assert(is_err_val(decode_default(hex_to_bytes("0001"))), "two numbers")
  debug_assert(is_err_val(decode_default(hex_to_bytes("440102030400"))), "bytestring + int")
  debug_assert(is_err_val(decode_default(hex_to_bytes("00830102"))), "int + partial array")
}

///|
test "sec_trailing_bytes_allowed_when_enabled" {
  let opts = DecodeOptions::{
    max_depth: 32,
    max_elements: 131072,
    reject_duplicate_keys: false,
    require_canonical: false,
    allow_trailing_bytes: true,
  }
  let v = unwrap_val(decode(hex_to_bytes("0102"), opts))
  debug_assert(cbor_equals(v, CborValue::Unsigned(1UL)), "decodes first item when trailing allowed")
}

///|
test "sec_reserved_ai_28_29_30_all_major_types" {
  // Major 0..7 with AI 28, 29, 30 must all be rejected
  let bad = [
    "1c", "1d", "1e",
    "3c", "3d", "3e",
    "5c", "5d", "5e",
    "7c", "7d", "7e",
    "9c", "9d", "9e",
    "bc", "bd", "be",
    "dc", "dd", "de",
    "fc", "fd", "fe",
  ]
  let mut i = 0
  while i < bad.length() {
    debug_assert(is_err_val(decode_default(hex_to_bytes(bad[i]))), "reserved AI " + bad[i])
    i = i + 1
  }
}

