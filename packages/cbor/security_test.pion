///| Security, well-formedness, OOM defense, depth limit, UTF-8, and malformed input tests ported from fxamacker/cbor (56 tests).

///|
test "sec_empty_input_rejected" {
  debug_assert(is_err_val(decode_default(Bytes::new(0))), "empty input must fail")
}

