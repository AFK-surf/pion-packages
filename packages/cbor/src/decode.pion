///| CBOR decoder (RFC 8949) with OOM protection, strict UTF-8, depth/element limits, and canonical validation.

///|
struct Decoder {
  data : Bytes
  mut pos : Int
  opts : DecodeOptions
}

///|
fn is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      // Reject overlong 3-byte (E0 80..9F) and UTF-16 surrogates (ED A0..BF)
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      // Reject overlong 4-byte (F0 80..8F) and > U+10FFFF (F4 90..BF)
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
fn cmp_slice_lex(data : Bytes, s1 : Int, e1 : Int, s2 : Int, e2 : Int) -> Int {
  let l1 = e1 - s1
  let l2 = e2 - s2
  let min_len = if l1 < l2 { l1 } else { l2 }
  let mut i = 0
  while i < min_len {
    let a = data[s1 + i].to_int()
    let b = data[s2 + i].to_int()
    if a != b {
      return if a < b { -1 } else { 1 }
    }
    i = i + 1
  }
  if l1 < l2 {
    -1
  } else if l1 > l2 {
    1
  } else {
    0
  }
}

///|
fn read_uint_arg(dec : Decoder, ai : Int, start_pos : Int) -> Result[UInt64, CborError] {
  if ai <= 23 {
    return Ok(ai.to_int64().to_uint64())
  }
  let rem = dec.data.length() - dec.pos
  if ai == 24 {
    if rem < 1 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let v = dec.data[dec.pos].to_int().to_int64().to_uint64()
    dec.pos = dec.pos + 1
    if dec.opts.require_canonical && v < 24UL {
      return Err(CborError::NonCanonicalEncoding(start_pos))
    }
    return Ok(v)
  }
  if ai == 25 {
    if rem < 2 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b0 = dec.data[dec.pos].to_int().to_int64().to_uint64()
    let b1 = dec.data[dec.pos + 1].to_int().to_int64().to_uint64()
    dec.pos = dec.pos + 2
    let v = (b0 << 8) | b1
    if dec.opts.require_canonical && v <= 0xFFUL {
      return Err(CborError::NonCanonicalEncoding(start_pos))
    }
    return Ok(v)
  }
  if ai == 26 {
    if rem < 4 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b0 = dec.data[dec.pos].to_int().to_int64().to_uint64()
    let b1 = dec.data[dec.pos + 1].to_int().to_int64().to_uint64()
    let b2 = dec.data[dec.pos + 2].to_int().to_int64().to_uint64()
    let b3 = dec.data[dec.pos + 3].to_int().to_int64().to_uint64()
    dec.pos = dec.pos + 4
    let v = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    if dec.opts.require_canonical && v <= 0xFFFFUL {
      return Err(CborError::NonCanonicalEncoding(start_pos))
    }
    return Ok(v)
  }
  if ai == 27 {
    if rem < 8 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b0 = dec.data[dec.pos].to_int().to_int64().to_uint64()
    let b1 = dec.data[dec.pos + 1].to_int().to_int64().to_uint64()
    let b2 = dec.data[dec.pos + 2].to_int().to_int64().to_uint64()
    let b3 = dec.data[dec.pos + 3].to_int().to_int64().to_uint64()
    let b4 = dec.data[dec.pos + 4].to_int().to_int64().to_uint64()
    let b5 = dec.data[dec.pos + 5].to_int().to_int64().to_uint64()
    let b6 = dec.data[dec.pos + 6].to_int().to_int64().to_uint64()
    let b7 = dec.data[dec.pos + 7].to_int().to_int64().to_uint64()
    dec.pos = dec.pos + 8
    let v = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
    if dec.opts.require_canonical && v <= 0xFFFFFFFFUL {
      return Err(CborError::NonCanonicalEncoding(start_pos))
    }
    return Ok(v)
  }
  Err(CborError::InvalidAdditionalInfo(ai, start_pos))
}

///|
fn decode_indef_bytes(dec : Decoder, start_pos : Int) -> Result[CborValue, CborError] {
  if dec.opts.require_canonical {
    return Err(CborError::NonCanonicalEncoding(start_pos))
  }
  let chunks : Array[Bytes] = []
  let mut total_len = 0
  while true {
    if dec.pos >= dec.data.length() {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b = dec.data[dec.pos].to_int()
    if b == 0xFF {
      dec.pos = dec.pos + 1
      break
    }
    let major = (b >> 5) & 7
    let ai = b & 31
    if major != 2 || ai == 31 {
      return Err(CborError::InvalidIndefiniteChunk(dec.pos))
    }
    let chunk_start = dec.pos
    dec.pos = dec.pos + 1
    let len_u64 = match read_uint_arg(dec, ai, chunk_start) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let len = len_u64.to_int()
    chunks.push(dec.data.slice(dec.pos, dec.pos + len))
    dec.pos = dec.pos + len
    total_len = total_len + len
  }
  let out = Bytes::new(total_len)
  let mut off = 0
  let mut i = 0
  while i < chunks.length() {
    let ch = chunks[i]
    let mut j = 0
    while j < ch.length() {
      out[off] = ch[j]
      off = off + 1
      j = j + 1
    }
    i = i + 1
  }
  Ok(CborValue::Bytes(out))
}

///|
fn decode_indef_text(dec : Decoder, start_pos : Int) -> Result[CborValue, CborError] {
  if dec.opts.require_canonical {
    return Err(CborError::NonCanonicalEncoding(start_pos))
  }
  let sb = StringBuilder::new()
  while true {
    if dec.pos >= dec.data.length() {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b = dec.data[dec.pos].to_int()
    if b == 0xFF {
      dec.pos = dec.pos + 1
      break
    }
    let major = (b >> 5) & 7
    let ai = b & 31
    if major != 3 || ai == 31 {
      return Err(CborError::InvalidIndefiniteChunk(dec.pos))
    }
    let chunk_start = dec.pos
    dec.pos = dec.pos + 1
    let len_u64 = match read_uint_arg(dec, ai, chunk_start) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let len = len_u64.to_int()
    if !is_valid_utf8_range(dec.data, dec.pos, len) {
      return Err(CborError::InvalidUtf8(dec.pos))
    }
    let slice = dec.data.slice(dec.pos, dec.pos + len)
    sb.write_string(slice.to_string())
    dec.pos = dec.pos + len
  }
  Ok(CborValue::Text(sb.to_string()))
}

///|
fn decode_item(dec : Decoder, depth : Int) -> Result[CborValue, CborError] {
  if dec.pos >= dec.data.length() {
    return Err(CborError::UnexpectedEof(dec.pos))
  }
  let start_pos = dec.pos
  let initial = dec.data[dec.pos].to_int()
  dec.pos = dec.pos + 1
  let major = (initial >> 5) & 7
  let ai = initial & 31

  if major == 0 {
    let v = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    return Ok(CborValue::Unsigned(v))
  }

  if major == 1 {
    let v = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    return Ok(CborValue::Negative(v))
  }

  if major == 2 {
    if ai == 31 {
      return decode_indef_bytes(dec, start_pos)
    }
    let len_u64 = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let len = len_u64.to_int()
    let slice = dec.data.slice(dec.pos, dec.pos + len)
    dec.pos = dec.pos + len
    return Ok(CborValue::Bytes(slice))
  }

  if major == 3 {
    if ai == 31 {
      return decode_indef_text(dec, start_pos)
    }
    let len_u64 = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let len = len_u64.to_int()
    if !is_valid_utf8_range(dec.data, dec.pos, len) {
      return Err(CborError::InvalidUtf8(dec.pos))
    }
    let slice = dec.data.slice(dec.pos, dec.pos + len)
    dec.pos = dec.pos + len
    return Ok(CborValue::Text(slice.to_string()))
  }

  if major == 4 {
    let next_depth = depth + 1
    if next_depth > dec.opts.max_depth {
      return Err(CborError::MaxDepthExceeded(dec.opts.max_depth))
    }
    if ai == 31 {
      if dec.opts.require_canonical {
        return Err(CborError::NonCanonicalEncoding(start_pos))
      }
      let items : Array[CborValue] = []
      while true {
        if dec.pos >= dec.data.length() {
          return Err(CborError::UnexpectedEof(dec.pos))
        }
        if dec.data[dec.pos].to_int() == 0xFF {
          dec.pos = dec.pos + 1
          break
        }
        if items.length() >= dec.opts.max_elements {
          return Err(CborError::MaxElementsExceeded(dec.opts.max_elements))
        }
        let item = match decode_item(dec, next_depth) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        items.push(item)
      }
      return Ok(CborValue::Array(items))
    }
    let len_u64 = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if len_u64 > dec.opts.max_elements.to_int64().to_uint64() {
      return Err(CborError::MaxElementsExceeded(dec.opts.max_elements))
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let count = len_u64.to_int()
    let items : Array[CborValue] = []
    let mut i = 0
    while i < count {
      let item = match decode_item(dec, next_depth) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      items.push(item)
      i = i + 1
    }
    return Ok(CborValue::Array(items))
  }

  if major == 5 {
    let next_depth = depth + 1
    if next_depth > dec.opts.max_depth {
      return Err(CborError::MaxDepthExceeded(dec.opts.max_depth))
    }
    if ai == 31 {
      if dec.opts.require_canonical {
        return Err(CborError::NonCanonicalEncoding(start_pos))
      }
      let pairs : Array[(CborValue, CborValue)] = []
      while true {
        if dec.pos >= dec.data.length() {
          return Err(CborError::UnexpectedEof(dec.pos))
        }
        if dec.data[dec.pos].to_int() == 0xFF {
          dec.pos = dec.pos + 1
          break
        }
        if pairs.length() >= dec.opts.max_elements {
          return Err(CborError::MaxElementsExceeded(dec.opts.max_elements))
        }
        let key_pos = dec.pos
        let k = match decode_item(dec, next_depth) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if dec.pos >= dec.data.length() {
          return Err(CborError::UnexpectedEof(dec.pos))
        }
        if dec.data[dec.pos].to_int() == 0xFF {
          return Err(CborError::UnexpectedBreak(dec.pos))
        }
        let v = match decode_item(dec, next_depth) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        if dec.opts.reject_duplicate_keys {
          let mut j = 0
          while j < pairs.length() {
            let (pk, _) = pairs[j]
            if cbor_equals(pk, k) {
              return Err(CborError::DuplicateMapKey(key_pos))
            }
            j = j + 1
          }
        }
        pairs.push((k, v))
      }
      return Ok(CborValue::Map(pairs))
    }
    let len_u64 = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if len_u64 > dec.opts.max_elements.to_int64().to_uint64() {
      return Err(CborError::MaxElementsExceeded(dec.opts.max_elements))
    }
    let rem_u64 = (dec.data.length() - dec.pos).to_int64().to_uint64()
    if len_u64 * 2UL > rem_u64 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let count = len_u64.to_int()
    let pairs : Array[(CborValue, CborValue)] = []
    let mut prev_k_start = -1
    let mut prev_k_end = -1
    let mut i = 0
    while i < count {
      let k_start = dec.pos
      let k = match decode_item(dec, next_depth) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let k_end = dec.pos
      if dec.opts.require_canonical && prev_k_start >= 0 {
        let ord = cmp_slice_lex(dec.data, prev_k_start, prev_k_end, k_start, k_end)
        if ord == 0 {
          return Err(CborError::DuplicateMapKey(k_start))
        }
        if ord > 0 {
          return Err(CborError::NonCanonicalEncoding(k_start))
        }
      } else if dec.opts.reject_duplicate_keys {
        let mut j = 0
        while j < pairs.length() {
          let (pk, _) = pairs[j]
          if cbor_equals(pk, k) {
            return Err(CborError::DuplicateMapKey(k_start))
          }
          j = j + 1
        }
      }
      prev_k_start = k_start
      prev_k_end = k_end
      let v = match decode_item(dec, next_depth) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      pairs.push((k, v))
      i = i + 1
    }
    return Ok(CborValue::Map(pairs))
  }

  if major == 6 {
    let tag_num = match read_uint_arg(dec, ai, start_pos) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if dec.pos >= dec.data.length() {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let next_depth = depth + 1
    if next_depth > dec.opts.max_depth {
      return Err(CborError::MaxDepthExceeded(dec.opts.max_depth))
    }
    let content = match decode_item(dec, next_depth) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(CborValue::Tag(tag_num, content))
  }

  // major == 7: simple values and IEEE-754 floating-point
  if ai < 20 {
    return Ok(CborValue::Simple(ai))
  }
  if ai == 20 {
    return Ok(CborValue::Bool(false))
  }
  if ai == 21 {
    return Ok(CborValue::Bool(true))
  }
  if ai == 22 {
    return Ok(CborValue::Null)
  }
  if ai == 23 {
    return Ok(CborValue::Undefined)
  }
  if ai == 24 {
    if dec.pos >= dec.data.length() {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let sv = dec.data[dec.pos].to_int()
    dec.pos = dec.pos + 1
    if sv < 32 {
      return Err(CborError::InvalidSimpleValue(sv))
    }
    return Ok(CborValue::Simple(sv))
  }
  if ai == 25 {
    if dec.data.length() - dec.pos < 2 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let h = (dec.data[dec.pos].to_int() << 8) | dec.data[dec.pos + 1].to_int()
    dec.pos = dec.pos + 2
    if dec.opts.require_canonical {
      // If NaN in float16, canonical form is strictly 0x7E00
      let exp = (h >> 10) & 0x1F
      let frac = h & 0x3FF
      if exp == 31 && frac != 0 && h != 0x7E00 {
        return Err(CborError::NonCanonicalEncoding(start_pos))
      }
    }
    return Ok(CborValue::Float(float16_to_double(h)))
  }
  if ai == 26 {
    if dec.data.length() - dec.pos < 4 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b0 = dec.data[dec.pos].to_int().to_int64()
    let b1 = dec.data[dec.pos + 1].to_int().to_int64()
    let b2 = dec.data[dec.pos + 2].to_int().to_int64()
    let b3 = dec.data[dec.pos + 3].to_int().to_int64()
    dec.pos = dec.pos + 4
    let f32bits = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    let d = float32_to_double(f32bits)
    if dec.opts.require_canonical {
      match double_to_float16_exact(d) {
        Some(_) => return Err(CborError::NonCanonicalEncoding(start_pos))
        None => ()
      }
    }
    return Ok(CborValue::Float(d))
  }
  if ai == 27 {
    if dec.data.length() - dec.pos < 8 {
      return Err(CborError::UnexpectedEof(dec.pos))
    }
    let b0 = dec.data[dec.pos].to_int().to_int64()
    let b1 = dec.data[dec.pos + 1].to_int().to_int64()
    let b2 = dec.data[dec.pos + 2].to_int().to_int64()
    let b3 = dec.data[dec.pos + 3].to_int().to_int64()
    let b4 = dec.data[dec.pos + 4].to_int().to_int64()
    let b5 = dec.data[dec.pos + 5].to_int().to_int64()
    let b6 = dec.data[dec.pos + 6].to_int().to_int64()
    let b7 = dec.data[dec.pos + 7].to_int().to_int64()
    dec.pos = dec.pos + 8
    let f64bits = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
    let d = Double::from_bits(f64bits)
    if dec.opts.require_canonical {
      match double_to_float32_exact(d) {
        Some(_) => return Err(CborError::NonCanonicalEncoding(start_pos))
        None => ()
      }
    }
    return Ok(CborValue::Float(d))
  }
  if ai == 31 {
    return Err(CborError::UnexpectedBreak(start_pos))
  }
  Err(CborError::InvalidAdditionalInfo(ai, start_pos))
}

///|
pub fn decode(data : Bytes, opts : DecodeOptions) -> Result[CborValue, CborError] {
  if data.length() == 0 {
    return Err(CborError::UnexpectedEof(0))
  }
  let dec = Decoder::{ data: data, pos: 0, opts: opts }
  let val_res = decode_item(dec, 0)
  match val_res {
    Err(e) => Err(e)
    Ok(v) => {
      if !opts.allow_trailing_bytes && dec.pos != data.length() {
        return Err(CborError::TrailingBytes(dec.pos))
      }
      Ok(v)
    }
  }
}

///|
pub fn decode_default(data : Bytes) -> Result[CborValue, CborError] {
  decode(data, DecodeOptions::default())
}

///|
pub fn validate(data : Bytes, opts : DecodeOptions) -> Result[Unit, CborError] {
  match decode(data, opts) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}
