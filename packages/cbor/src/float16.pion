///| IEEE-754 binary16 (float16) and binary32 (float32) exact bit-level conversions.

///| IEEE-754 binary16 (float16) to binary64 bit pattern conversion.
#verify
pub fn float16_to_double_bits(bits : Int) -> Int64 {
  let h = bits & 0xFFFF
  let sign : Int64 = ((h >> 15) & 1).to_int64()
  let exp = (h >> 10) & 0x1F
  let frac = h & 0x3FF
  if exp == 0 {
    if frac == 0 {
      return sign << 63
    }
    // Subnormal binary16: (-1)^sign * frac * 2^-24
    let mut f = frac
    let mut e64 = 1009 // 1023 - 14
    while (f & 0x400) == 0 {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x3FF).to_int64() << 42
    return (sign << 63) | (e64.to_int64() << 52) | mant
  }
  if exp == 31 {
    if frac == 0 {
      return (sign << 63) | (0x7FFL << 52)
    }
    // NaN (preserve quiet bit & payload)
    let mant : Int64 = frac.to_int64() << 42
    return (sign << 63) | (0x7FFL << 52) | mant
  }
  // Normal binary16: e64 = exp - 15 + 1023 = exp + 1008
  let e64 : Int64 = (exp + 1008).to_int64()
  let mant : Int64 = frac.to_int64() << 42
  (sign << 63) | (e64 << 52) | mant
}

///|
pub fn float16_to_double(bits : Int) -> Double {
  Double::from_bits(float16_to_double_bits(bits))
}

///| IEEE-754 binary32 (float32) to binary64 bit pattern conversion.
pub fn float32_to_double_bits(bits : Int64) -> Int64 {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return sign << 63
    }
    // Subnormal binary32: (-1)^sign * frac * 2^-149
    let mut f = frac
    let mut e64 = 897 // 1023 - 126
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return (sign << 63) | (e64.to_int64() << 52) | mant
  }
  if exp == 255 {
    if frac == 0L {
      return (sign << 63) | (0x7FFL << 52)
    }
    let mant : Int64 = frac << 29
    return (sign << 63) | (0x7FFL << 52) | mant
  }
  // Normal binary32: e64 = exp - 127 + 1023 = exp + 896
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  (sign << 63) | (e64 << 52) | mant
}

///|
pub fn float32_to_double(bits : Int64) -> Double {
  Double::from_bits(float32_to_double_bits(bits))
}

///| Exact binary64 bit pattern to binary16 conversion (RFC 8949 §4.2.1 shortest float).
#verify
pub fn double_bits_to_float16_exact(bits : Int64) -> Option[Int] {
  let sign = ((bits >> 63) & 1L).to_int()
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return Option::Some((sign << 15) | 0x7C00)
    }
    // Canonical CBOR NaN is 0x7E00
    return Option::Some(0x7E00)
  }
  if exp == 0 && frac == 0L {
    return Option::Some(sign << 15)
  }
  let e = exp - 1023
  if e >= -14 && e <= 15 {
    // Normal binary16: lower 42 bits of frac must be zero
    if (frac & 0x3FFFFFFFFFFL) != 0L {
      return Option::None
    }
    let h = (sign << 15) | ((e + 15) << 10) | ((frac >> 42) & 0x3FFL).to_int()
    return Option::Some(h)
  }
  if e >= -24 && e <= -15 {
    // Subnormal binary16: shift = 28 - e (in [43, 52])
    let full_sig = (1L << 52) | frac
    let shift = 28 - e
    let mask = (1L << shift) - 1L
    if (full_sig & mask) != 0L {
      return Option::None
    }
    let h = (sign << 15) | ((full_sig >> shift) & 0x3FFL).to_int()
    return Option::Some(h)
  }
  Option::None
}

///|
pub fn double_to_float16_exact(value : Double) -> Option[Int] {
  double_bits_to_float16_exact(value.to_bits())
}

///| Exact binary64 bit pattern to binary32 conversion (RFC 8949 §4.2.1 shortest float).
pub fn double_bits_to_float32_exact(bits : Int64) -> Option[Int64] {
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return Option::Some((sign << 31) | 0x7F800000L)
    }
    return Option::Some(0x7FC00000L)
  }
  if exp == 0 && frac == 0L {
    return Option::Some(sign << 31)
  }
  let e = exp - 1023
  if e >= -126 && e <= 127 {
    // Normal binary32: lower 29 bits of frac must be zero
    if (frac & 0x1FFFFFFFL) != 0L {
      return Option::None
    }
    let f32 = (sign << 31) | ((e + 127).to_int64() << 23) | ((frac >> 29) & 0x7FFFFFL)
    return Option::Some(f32)
  }
  if e >= -149 && e <= -127 {
    // Subnormal binary32: shift = -97 - e (in [30, 52])
    let full_sig = (1L << 52) | frac
    let shift = -97 - e
    let mask = (1L << shift) - 1L
    if (full_sig & mask) != 0L {
      return Option::None
    }
    let f32 = (sign << 31) | ((full_sig >> shift) & 0x7FFFFFL)
    return Option::Some(f32)
  }
  Option::None
}

///|
pub fn double_to_float32_exact(value : Double) -> Option[Int64] {
  double_bits_to_float32_exact(value.to_bits())
}
