///| IEEE-754 binary16 (float16) and binary32 (float32) exact bit-level conversions.

///|
pub fn float16_to_double(bits : Int) -> Double {
  let _ = bits
  0.0
}

///|
pub fn float32_to_double(bits : Int64) -> Double {
  let _ = bits
  0.0
}

///|
pub fn double_to_float16_exact(value : Double) -> Option[Int] {
  let _ = value
  Option::None
}

///|
pub fn double_to_float32_exact(value : Double) -> Option[Int64] {
  let _ = value
  Option::None
}
