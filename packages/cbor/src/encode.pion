///| CBOR encoder (RFC 8949 + Core Deterministic + CTAP2 Canonical CBOR).

///|
fn push_head(out : Array[Byte], major : Int, n : UInt64) -> Unit {
  let maj = major << 5
  if n < 24UL {
    out.push((maj | n.to_int()).to_byte())
  } else if n <= 0xFFUL {
    out.push((maj | 24).to_byte())
    out.push((n & 0xFFUL).to_int().to_byte())
  } else if n <= 0xFFFFUL {
    out.push((maj | 25).to_byte())
    out.push(((n >> 8) & 0xFFUL).to_int().to_byte())
    out.push((n & 0xFFUL).to_int().to_byte())
  } else if n <= 0xFFFFFFFFUL {
    out.push((maj | 26).to_byte())
    out.push(((n >> 24) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 16) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 8) & 0xFFUL).to_int().to_byte())
    out.push((n & 0xFFUL).to_int().to_byte())
  } else {
    out.push((maj | 27).to_byte())
    out.push(((n >> 56) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 48) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 40) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 32) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 24) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 16) & 0xFFUL).to_int().to_byte())
    out.push(((n >> 8) & 0xFFUL).to_int().to_byte())
    out.push((n & 0xFFUL).to_int().to_byte())
  }
}

///|
fn push_bytes(out : Array[Byte], b : Bytes) -> Unit {
  let mut i = 0
  let n = b.length()
  while i < n {
    out.push(b[i])
    i = i + 1
  }
}

///|
fn push_array_slice(out : Array[Byte], src : Array[Byte], start : Int, end : Int) -> Unit {
  let mut i = start
  while i < end {
    out.push(src[i])
    i = i + 1
  }
}

///|
fn push_float(out : Array[Byte], d : Double, shortest : Bool) -> Unit {
  if shortest {
    match double_to_float16_exact(d) {
      Some(h) => {
        out.push((0xF9).to_byte())
        out.push(((h >> 8) & 0xFF).to_byte())
        out.push((h & 0xFF).to_byte())
        return
      }
      None => ()
    }
    match double_to_float32_exact(d) {
      Some(f32) => {
        out.push((0xFA).to_byte())
        out.push(((f32 >> 24) & 0xFFL).to_int().to_byte())
        out.push(((f32 >> 16) & 0xFFL).to_int().to_byte())
        out.push(((f32 >> 8) & 0xFFL).to_int().to_byte())
        out.push((f32 & 0xFFL).to_int().to_byte())
        return
      }
      None => ()
    }
  }
  let bits = d.to_bits()
  out.push((0xFB).to_byte())
  out.push(((bits >> 56) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 48) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 40) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 32) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 24) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 16) & 0xFFL).to_int().to_byte())
  out.push(((bits >> 8) & 0xFFL).to_int().to_byte())
  out.push((bits & 0xFFL).to_int().to_byte())
}

///|
val struct EncodedPairRange {
  k_start : Int
  k_end : Int
  v_end : Int
}

///|
fn cmp_key_range(buf : Array[Byte], a : EncodedPairRange, b : EncodedPairRange, length_first : Bool) -> Int {
  let la = a.k_end - a.k_start
  let lb = b.k_end - b.k_start
  if length_first && la != lb {
    return if la < lb { -1 } else { 1 }
  }
  let min_len = if la < lb { la } else { lb }
  let mut i = 0
  while i < min_len {
    let ba = buf[a.k_start + i].to_int()
    let bb = buf[b.k_start + i].to_int()
    if ba != bb {
      return if ba < bb { -1 } else { 1 }
    }
    i = i + 1
  }
  if la < lb {
    -1
  } else if la > lb {
    1
  } else {
    0
  }
}

///|
fn sort_pair_ranges(buf : Array[Byte], ranges : Array[EncodedPairRange], length_first : Bool) -> Unit {
  // Insertion sort for small maps, shell sort for larger maps (zero extra allocations).
  let n = ranges.length()
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let cur = ranges[i]
      let mut j = i
      while j >= gap && cmp_key_range(buf, ranges[j - gap], cur, length_first) > 0 {
        ranges[j] = ranges[j - gap]
        j = j - gap
      }
      ranges[j] = cur
      i = i + 1
    }
    gap = gap / 2
  }
}

///|
fn encode_into(out : Array[Byte], value : CborValue, opts : EncodeOptions) -> Result[Unit, CborError] {
  match value {
    Unsigned(u) => {
      push_head(out, 0, u)
      Ok(())
    }
    Negative(n) => {
      push_head(out, 1, n)
      Ok(())
    }
    Bytes(b) => {
      push_head(out, 2, b.length().to_int64().to_uint64())
      push_bytes(out, b)
      Ok(())
    }
    Text(s) => {
      let b = s.to_bytes()
      push_head(out, 3, b.length().to_int64().to_uint64())
      push_bytes(out, b)
      Ok(())
    }
    Array(items) => {
      push_head(out, 4, items.length().to_int64().to_uint64())
      let mut i = 0
      while i < items.length() {
        match encode_into(out, items[i], opts) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(())
    }
    Map(pairs) => {
      let n = pairs.length()
      push_head(out, 5, n.to_int64().to_uint64())
      let need_sort = match opts.sort_mode {
        SortMode::None => false
        SortMode::CoreDeterministic => true
        SortMode::Ctap2 => true
      }
      if !need_sort || n <= 1 {
        let mut i = 0
        while i < n {
          let (k, v) = pairs[i]
          match encode_into(out, k, opts) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match encode_into(out, v, opts) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          i = i + 1
        }
        return Ok(())
      }
      let length_first = match opts.sort_mode {
        SortMode::Ctap2 => true
        _ => false
      }
      let scratch : Array[Byte] = []
      let ranges : Array[EncodedPairRange] = []
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        let k_start = scratch.length()
        match encode_into(scratch, k, opts) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let k_end = scratch.length()
        match encode_into(scratch, v, opts) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let v_end = scratch.length()
        ranges.push(EncodedPairRange::{ k_start: k_start, k_end: k_end, v_end: v_end })
        i = i + 1
      }
      sort_pair_ranges(scratch, ranges, length_first)
      let mut j = 0
      while j < n {
        if j > 0 && cmp_key_range(scratch, ranges[j - 1], ranges[j], length_first) == 0 {
          return Err(CborError::DuplicateMapKey(j))
        }
        let r = ranges[j]
        push_array_slice(out, scratch, r.k_start, r.v_end)
        j = j + 1
      }
      Ok(())
    }
    Tag(t, inner) => {
      push_head(out, 6, t)
      encode_into(out, inner, opts)
    }
    Bool(b) => {
      out.push((if b { 0xF5 } else { 0xF4 }).to_byte())
      Ok(())
    }
    Null => {
      out.push((0xF6).to_byte())
      Ok(())
    }
    Undefined => {
      out.push((0xF7).to_byte())
      Ok(())
    }
    Simple(v) => {
      if v >= 0 && v <= 23 {
        out.push((0xE0 | v).to_byte())
        Ok(())
      } else if v >= 32 && v <= 255 {
        out.push((0xF8).to_byte())
        out.push(v.to_byte())
        Ok(())
      } else {
        Err(CborError::InvalidSimpleValue(v))
      }
    }
    Float(d) => {
      push_float(out, d, opts.shortest_float)
      Ok(())
    }
  }
}

///|
pub fn encode(value : CborValue, opts : EncodeOptions) -> Result[Bytes, CborError] {
  let buf : Array[Byte] = []
  match encode_into(buf, value, opts) {
    Err(e) => Err(e)
    Ok(_) => {
      let n = buf.length()
      let out = Bytes::new(n)
      let mut i = 0
      while i < n {
        out[i] = buf[i]
        i = i + 1
      }
      Ok(out)
    }
  }
}

///|
pub fn encode_default(value : CborValue) -> Result[Bytes, CborError] {
  encode(value, EncodeOptions::default())
}
