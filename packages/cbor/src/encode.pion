///| CBOR encoder (RFC 8949 + Core Deterministic + CTAP2 Canonical CBOR).

///|
struct Encoder {
  out : Bytes
  mut pos : Int
  shortest_float : Bool
  sort_mode : Int // 0 = None, 1 = CoreDeterministic, 2 = Ctap2
  mut has_err : Bool
  mut err : CborError
}

///|
val struct EncodedKey {
  key_bytes : String
  orig_idx : Int
}

///|
fn head_size_u64(n : UInt64) -> Int {
  if n < 24UL {
    1
  } else if n <= 0xFFUL {
    2
  } else if n <= 0xFFFFUL {
    3
  } else if n <= 0xFFFFFFFFUL {
    5
  } else {
    9
  }
}

///|
fn head_size_int(n : Int) -> Int {
  if n < 24 {
    1
  } else if n <= 0xFF {
    2
  } else if n <= 0xFFFF {
    3
  } else {
    5
  }
}

///|
fn float_size(d : Double, shortest : Bool) -> Int {
  if shortest {
    let bits = d.to_bits()
    let exp = ((bits >> 52) & 0x7FFL).to_int()
    if !(exp >= 897 && exp <= 1150 && (bits & 0x1FFFFFFFL) != 0L) {
      match double_to_float16_exact(d) {
        Some(_) => return 3
        None => ()
      }
      match double_to_float32_exact(d) {
        Some(_) => return 5
        None => ()
      }
    }
  }
  9
}

///|
fn encoded_size(value : CborValue, shortest_float : Bool) -> Int {
  match value {
    Unsigned(u) => if u < 24UL { 1 } else { head_size_u64(u) }
    Negative(n) => if n < 24UL { 1 } else { head_size_u64(n) }
    Bytes(b) => {
      let n = b.length()
      (if n < 24 { 1 } else { head_size_int(n) }) + n
    }
    Text(s) => {
      let n = s.length()
      (if n < 24 { 1 } else { head_size_int(n) }) + n
    }
    Array(items) => {
      let n = items.length()
      let mut total = if n < 24 { 1 } else { head_size_int(n) }
      let mut i = 0
      while i < n {
        let s = encoded_size(items[i], shortest_float)
        if s < 0 {
          return -1
        }
        total = total + s
        i = i + 1
      }
      total
    }
    Map(pairs) => {
      let n = pairs.length()
      let mut total = if n < 24 { 1 } else { head_size_int(n) }
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        let sk = encoded_size(k, shortest_float)
        if sk < 0 {
          return -1
        }
        let sv = encoded_size(v, shortest_float)
        if sv < 0 {
          return -1
        }
        total = total + sk + sv
        i = i + 1
      }
      total
    }
    Tag(t, inner) => {
      let s = encoded_size(inner, shortest_float)
      if s < 0 {
        -1
      } else {
        head_size_u64(t) + s
      }
    }
    Bool(_) => 1
    Null => 1
    Undefined => 1
    Simple(v) =>
    if v >= 0 && v <= 23 {
      1
    } else if v >= 32 && v <= 255 {
      2
    } else {
      -1
    }
    Float(d) => float_size(d, shortest_float)
  }
}

///|
fn write_head_u64(enc : Encoder, major : Int, n : UInt64) -> Unit {
  let out = enc.out
  let p = enc.pos
  let maj = major << 5
  if n < 24UL {
    out[p] = (maj | n.to_int()).to_byte()
    enc.pos = p + 1
  } else if n <= 0xFFUL {
    out[p] = (maj | 24).to_byte()
    out[p + 1] = (n & 0xFFUL).to_int().to_byte()
    enc.pos = p + 2
  } else if n <= 0xFFFFUL {
    out[p] = (maj | 25).to_byte()
    out[p + 1] = ((n >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 2] = (n & 0xFFUL).to_int().to_byte()
    enc.pos = p + 3
  } else if n <= 0xFFFFFFFFUL {
    out[p] = (maj | 26).to_byte()
    out[p + 1] = ((n >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((n >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((n >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (n & 0xFFUL).to_int().to_byte()
    enc.pos = p + 5
  } else {
    out[p] = (maj | 27).to_byte()
    out[p + 1] = ((n >> 56) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((n >> 48) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((n >> 40) & 0xFFUL).to_int().to_byte()
    out[p + 4] = ((n >> 32) & 0xFFUL).to_int().to_byte()
    out[p + 5] = ((n >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 6] = ((n >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 7] = ((n >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 8] = (n & 0xFFUL).to_int().to_byte()
    enc.pos = p + 9
  }
}

///|
fn write_head_int(enc : Encoder, major : Int, n : Int) -> Unit {
  let out = enc.out
  let p = enc.pos
  let maj = major << 5
  if n < 24 {
    out[p] = (maj | n).to_byte()
    enc.pos = p + 1
  } else if n <= 0xFF {
    out[p] = (maj | 24).to_byte()
    out[p + 1] = (n & 0xFF).to_byte()
    enc.pos = p + 2
  } else if n <= 0xFFFF {
    out[p] = (maj | 25).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    enc.pos = p + 3
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (maj | 26).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 5
  }
}

///|
fn write_float(enc : Encoder, d : Double) -> Unit {
  let out = enc.out
  let p = enc.pos
  let bits = d.to_bits()
  if enc.shortest_float {
    let exp = ((bits >> 52) & 0x7FFL).to_int()
    if !(exp >= 897 && exp <= 1150 && (bits & 0x1FFFFFFFL) != 0L) {
      match double_to_float16_exact(d) {
        Some(h) => {
          out[p] = (0xF9).to_byte()
          out[p + 1] = ((h >> 8) & 0xFF).to_byte()
          out[p + 2] = (h & 0xFF).to_byte()
          enc.pos = p + 3
          return
        }
        None => ()
      }
      match double_to_float32_exact(d) {
        Some(f32) => {
          out[p] = (0xFA).to_byte()
          out[p + 1] = ((f32 >> 24) & 0xFFL).to_int().to_byte()
          out[p + 2] = ((f32 >> 16) & 0xFFL).to_int().to_byte()
          out[p + 3] = ((f32 >> 8) & 0xFFL).to_int().to_byte()
          out[p + 4] = (f32 & 0xFFL).to_int().to_byte()
          enc.pos = p + 5
          return
        }
        None => ()
      }
    }
  }
  out[p] = (0xFB).to_byte()
  out[p + 1] = ((bits >> 56) & 0xFFL).to_int().to_byte()
  out[p + 2] = ((bits >> 48) & 0xFFL).to_int().to_byte()
  out[p + 3] = ((bits >> 40) & 0xFFL).to_int().to_byte()
  out[p + 4] = ((bits >> 32) & 0xFFL).to_int().to_byte()
  out[p + 5] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  out[p + 6] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  out[p + 7] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  out[p + 8] = (bits & 0xFFL).to_int().to_byte()
  enc.pos = p + 9
}

///|
fn is_fast_key(v : CborValue) -> Bool {
  match v {
    Text(_) => true
    Unsigned(_) => true
    Negative(_) => true
    _ => false
  }
}

///|
/// Direct CoreDeterministic comparator for Unsigned / Negative / Text keys.
/// Returns -1, 0, 1 for fast keys, or 2 if either key is not a fast key.
fn try_fast_key_cmp(a : CborValue, b : CborValue) -> Int {
  match a {
    Text(sa) =>
    match b {
      Text(sb) => {
        let la = sa.length()
        let lb = sb.length()
        if la != lb {
          return if la < lb { -1 } else { 1 }
        }
        let mut i = 0
        while i < la {
          let ca = sa.code_unit_at(i)
          let cb = sb.code_unit_at(i)
          if ca != cb {
            return if ca < cb { -1 } else { 1 }
          }
          i = i + 1
        }
        0
      }
      Unsigned(_) => 1
      Negative(_) => 1
      _ => 2
    }
    Unsigned(ua) =>
    match b {
      Unsigned(ub) =>
      if ua < ub {
        -1
      } else if ua > ub {
        1
      } else {
        0
      }
      Negative(_) => -1
      Text(_) => -1
      _ => 2
    }
    Negative(na) =>
    match b {
      Negative(nb) =>
      if na < nb {
        -1
      } else if na > nb {
        1
      } else {
        0
      }
      Unsigned(_) => 1
      Text(_) => -1
      _ => 2
    }
    _ => 2
  }
}

///|
fn cmp_encoded_key(a : String, b : String, length_first : Bool) -> Int {
  if length_first {
    let la = a.length()
    let lb = b.length()
    if la != lb {
      return if la < lb { -1 } else { 1 }
    }
  }
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

///|
fn sort_encoded_keys(keys : Array[EncodedKey], length_first : Bool) -> Unit {
  let n = keys.length()
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let cur = keys[i]
      let mut j = i
      while j >= gap && cmp_encoded_key(keys[j - gap].key_bytes, cur.key_bytes, length_first) > 0 {
        keys[j] = keys[j - gap]
        j = j - gap
      }
      keys[j] = cur
      i = i + 1
    }
    gap = gap / 2
  }
}

///|
fn sort_fast_indices(pairs : Array[(CborValue, CborValue)], idx_buf : Array[Int], n : Int) -> Int {
  if n <= 16 {
    let mut i = 1
    while i < n {
      let cur_idx = idx_buf[i]
      let (cur_k, _) = pairs[cur_idx]
      let mut j = i
      while j > 0 {
        let prev_idx = idx_buf[j - 1]
        let (prev_k, _) = pairs[prev_idx]
        let c = try_fast_key_cmp(prev_k, cur_k)
        if c > 0 {
          idx_buf[j] = prev_idx
          j = j - 1
        } else if c == 0 {
          return i
        } else {
          break
        }
      }
      idx_buf[j] = cur_idx
      i = i + 1
    }
    return -1
  }
  let mut gap = n / 2
  while gap > 0 {
    let mut i = gap
    while i < n {
      let cur_idx = idx_buf[i]
      let (cur_k, _) = pairs[cur_idx]
      let mut j = i
      while j >= gap {
        let prev_idx = idx_buf[j - gap]
        let (prev_k, _) = pairs[prev_idx]
        let c = try_fast_key_cmp(prev_k, cur_k)
        if c > 0 {
          idx_buf[j] = prev_idx
          j = j - gap
        } else if gap == 1 && c == 0 {
          return i
        } else {
          break
        }
      }
      idx_buf[j] = cur_idx
      i = i + 1
    }
    gap = gap / 2
  }
  -1
}

///|
fn encode_map_slow(
  enc : Encoder,
  pairs : Array[(CborValue, CborValue)],
  length_first : Bool,
) -> Unit {
  let n = pairs.length()
  let keys : Array[EncodedKey] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let (k, _) = pairs[i]
    let ksize = encoded_size(k, enc.shortest_float)
    if ksize < 0 {
      // Trigger exact error via encode_into on dummy buffer
      let kenc = Encoder::{
        out: Bytes::new(0),
        pos: 0,
        shortest_float: enc.shortest_float,
        sort_mode: enc.sort_mode,
        has_err: false,
        err: enc.err,
      }
      encode_into(kenc, k)
      enc.has_err = true
      enc.err = kenc.err
      return
    }
    let kbuf = Bytes::new(ksize)
    let kenc = Encoder::{
      out: kbuf,
      pos: 0,
      shortest_float: enc.shortest_float,
      sort_mode: enc.sort_mode,
      has_err: false,
      err: enc.err,
    }
    encode_into(kenc, k)
    if kenc.has_err {
      enc.has_err = true
      enc.err = kenc.err
      return
    }
    keys.push(EncodedKey::{ key_bytes: kbuf.to_string(), orig_idx: i })
    i = i + 1
  }
  sort_encoded_keys(keys, length_first)
  let out = enc.out
  let mut j = 0
  while j < n {
    if j > 0 && keys[j - 1].key_bytes == keys[j].key_bytes {
      enc.has_err = true
      enc.err = CborError::DuplicateMapKey(j)
      return
    }
    let ek = keys[j]
    let ks = ek.key_bytes
    let klen = ks.length()
    let p = enc.pos
    let mut b = 0
    while b < klen {
      out[p + b] = ks.code_unit_at(b).to_byte()
      b = b + 1
    }
    enc.pos = p + klen
    let (_, v) = pairs[ek.orig_idx]
    encode_into(enc, v)
    if enc.has_err {
      return
    }
    j = j + 1
  }
}

///|
fn encode_into(enc : Encoder, value : CborValue) -> Unit {
  let out = enc.out
  match value {
    Unsigned(u) =>
    if u < 24UL {
      let p = enc.pos
      out[p] = u.to_int().to_byte()
      enc.pos = p + 1
    } else {
      write_head_u64(enc, 0, u)
    }
    Negative(n) =>
    if n < 24UL {
      let p = enc.pos
      out[p] = (0x20 | n.to_int()).to_byte()
      enc.pos = p + 1
    } else {
      write_head_u64(enc, 1, n)
    }
    Bytes(b) => {
      let n = b.length()
      if n < 24 {
        let p = enc.pos
        out[p] = (0x40 | n).to_byte()
        enc.pos = p + 1
      } else {
        write_head_int(enc, 2, n)
      }
      let p = enc.pos
      let mut i = 0
      while i < n {
        out[p + i] = b[i]
        i = i + 1
      }
      enc.pos = p + n
    }
    Text(s) => {
      let n = s.length()
      if n < 24 {
        let p = enc.pos
        out[p] = (0x60 | n).to_byte()
        enc.pos = p + 1
      } else {
        write_head_int(enc, 3, n)
      }
      let p = enc.pos
      let mut i = 0
      while i < n {
        out[p + i] = s.code_unit_at(i).to_byte()
        i = i + 1
      }
      enc.pos = p + n
    }
    Array(items) => {
      let n = items.length()
      if n < 24 {
        let p = enc.pos
        out[p] = (0x80 | n).to_byte()
        enc.pos = p + 1
      } else {
        write_head_int(enc, 4, n)
      }
      let mut i = 0
      while i < n {
        encode_into(enc, items[i])
        if enc.has_err {
          return
        }
        i = i + 1
      }
    }
    Map(pairs) => {
      let n = pairs.length()
      if n < 24 {
        let p = enc.pos
        out[p] = (0xA0 | n).to_byte()
        enc.pos = p + 1
      } else {
        write_head_int(enc, 5, n)
      }
      if enc.sort_mode == 0 || n <= 1 {
        let mut i = 0
        while i < n {
          let (k, v) = pairs[i]
          encode_into(enc, k)
          if enc.has_err {
            return
          }
          encode_into(enc, v)
          if enc.has_err {
            return
          }
          i = i + 1
        }
        return
      }
      if enc.sort_mode == 1 {
        if n == 2 {
          let (k0, v0) = pairs[0]
          let (k1, v1) = pairs[1]
          let c = try_fast_key_cmp(k0, k1)
          if c != 2 {
            if c == 0 {
              enc.has_err = true
              enc.err = CborError::DuplicateMapKey(1)
              return
            }
            if c < 0 {
              encode_into(enc, k0)
              if enc.has_err {
                return
              }
              encode_into(enc, v0)
              if enc.has_err {
                return
              }
              encode_into(enc, k1)
              if enc.has_err {
                return
              }
              encode_into(enc, v1)
            } else {
              encode_into(enc, k1)
              if enc.has_err {
                return
              }
              encode_into(enc, v1)
              if enc.has_err {
                return
              }
              encode_into(enc, k0)
              if enc.has_err {
                return
              }
              encode_into(enc, v0)
            }
            return
          }
          encode_map_slow(enc, pairs, false)
          return
        }
        let mut all_fast = true
        let mut sorted = true
        let mut i = 1
        while i < n {
          let (k, _) = pairs[i]
          if sorted {
            let (pk, _) = pairs[i - 1]
            let c = try_fast_key_cmp(pk, k)
            if c == 2 {
              all_fast = false
              break
            }
            if c == 0 {
              enc.has_err = true
              enc.err = CborError::DuplicateMapKey(i)
              return
            }
            if c > 0 {
              sorted = false
            }
          } else if !is_fast_key(k) {
            all_fast = false
            break
          }
          i = i + 1
        }
        if all_fast {
          if sorted {
            let mut j = 0
            while j < n {
              let (k, v) = pairs[j]
              encode_into(enc, k)
              if enc.has_err {
                return
              }
              encode_into(enc, v)
              if enc.has_err {
                return
              }
              j = j + 1
            }
            return
          }
          if n <= 8 {
            let mut used = 0
            let mut prev_idx = -1
            let mut emitted = 0
            while emitted < n {
              let mut best = -1
              let mut j = 0
              while j < n {
                if (used & (1 << j)) == 0 {
                  if best < 0 {
                    best = j
                  } else {
                    let (bk, _) = pairs[best]
                    let (jk, _) = pairs[j]
                    let c = try_fast_key_cmp(jk, bk)
                    if c < 0 {
                      best = j
                    } else if c == 0 {
                      enc.has_err = true
                      enc.err = CborError::DuplicateMapKey(j)
                      return
                    }
                  }
                }
                j = j + 1
              }
              if prev_idx >= 0 {
                let (pk, _) = pairs[prev_idx]
                let (bk, _) = pairs[best]
                if try_fast_key_cmp(pk, bk) == 0 {
                  enc.has_err = true
                  enc.err = CborError::DuplicateMapKey(best)
                  return
                }
              }
              used = used | (1 << best)
              prev_idx = best
              let (k, v) = pairs[best]
              encode_into(enc, k)
              if enc.has_err {
                return
              }
              encode_into(enc, v)
              if enc.has_err {
                return
              }
              emitted = emitted + 1
            }
            return
          }
          let idx_buf : Array[Int] = Array::with_capacity(n)
          let mut j = 0
          while j < n {
            idx_buf.push(j)
            j = j + 1
          }
          let dup = sort_fast_indices(pairs, idx_buf, n)
          if dup >= 0 {
            enc.has_err = true
            enc.err = CborError::DuplicateMapKey(dup)
            return
          }
          let mut m = 0
          while m < n {
            let (k, v) = pairs[idx_buf[m]]
            encode_into(enc, k)
            if enc.has_err {
              return
            }
            encode_into(enc, v)
            if enc.has_err {
              return
            }
            m = m + 1
          }
          return
        }
      }
      encode_map_slow(enc, pairs, enc.sort_mode == 2)
    }
    Tag(t, inner) => {
      write_head_u64(enc, 6, t)
      encode_into(enc, inner)
    }
    Bool(b) => {
      let p = enc.pos
      out[p] = (if b { 0xF5 } else { 0xF4 }).to_byte()
      enc.pos = p + 1
    }
    Null => {
      let p = enc.pos
      out[p] = (0xF6).to_byte()
      enc.pos = p + 1
    }
    Undefined => {
      let p = enc.pos
      out[p] = (0xF7).to_byte()
      enc.pos = p + 1
    }
    Simple(v) =>
    if v >= 0 && v <= 23 {
      let p = enc.pos
      out[p] = (0xE0 | v).to_byte()
      enc.pos = p + 1
    } else if v >= 32 && v <= 255 {
      let p = enc.pos
      out[p] = (0xF8).to_byte()
      out[p + 1] = v.to_byte()
      enc.pos = p + 2
    } else {
      enc.has_err = true
      enc.err = CborError::InvalidSimpleValue(v)
    }
    Float(d) => write_float(enc, d)
  }
}

///|
fn find_invalid_simple(value : CborValue) -> Option[CborError] {
  match value {
    Simple(v) =>
    if (v >= 0 && v <= 23) || (v >= 32 && v <= 255) {
      Option::None
    } else {
      Option::Some(CborError::InvalidSimpleValue(v))
    }
    Array(items) => {
      let mut i = 0
      while i < items.length() {
        match find_invalid_simple(items[i]) {
          Some(e) => return Option::Some(e)
          None => ()
        }
        i = i + 1
      }
      Option::None
    }
    Map(pairs) => {
      let mut i = 0
      while i < pairs.length() {
        let (k, v) = pairs[i]
        match find_invalid_simple(k) {
          Some(e) => return Option::Some(e)
          None => ()
        }
        match find_invalid_simple(v) {
          Some(e) => return Option::Some(e)
          None => ()
        }
        i = i + 1
      }
      Option::None
    }
    Tag(_, inner) => find_invalid_simple(inner)
    _ => Option::None
  }
}

///|
pub fn encode(value : CborValue, opts : EncodeOptions) -> Result[Bytes, CborError] {
  let total_len = encoded_size(value, opts.shortest_float)
  if total_len < 0 {
    match find_invalid_simple(value) {
      Some(e) => return Err(e)
      None => return Err(CborError::InvalidSimpleValue(-1))
    }
  }
  let sort_mode = match opts.sort_mode {
    SortMode::None => 0
    SortMode::CoreDeterministic => 1
    SortMode::Ctap2 => 2
  }
  let out = Bytes::new(total_len)
  let enc = Encoder::{
    out: out,
    pos: 0,
    shortest_float: opts.shortest_float,
    sort_mode: sort_mode,
    has_err: false,
    err: CborError::InvalidSimpleValue(0),
  }
  encode_into(enc, value)
  if enc.has_err {
    Err(enc.err)
  } else {
    Ok(out)
  }
}

///|
pub fn encode_default(value : CborValue) -> Result[Bytes, CborError] {
  encode(value, EncodeOptions::default())
}
