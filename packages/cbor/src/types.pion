///| Core CBOR data model, options, and error types (RFC 8949 + CTAP2).

///|
pub enum CborValue {
  Unsigned(UInt64)
  Negative(UInt64)
  Bytes(Bytes)
  Text(String)
  Array(Array[CborValue])
  Map(Array[(CborValue, CborValue)])
  Tag(UInt64, CborValue)
  Bool(Bool)
  Null
  Undefined
  Simple(Int)
  Float(Double)
}

///|
pub enum CborError {
  UnexpectedEof(Int)
  TrailingBytes(Int)
  InvalidAdditionalInfo(Int, Int)
  UnexpectedBreak(Int)
  InvalidIndefiniteChunk(Int)
  InvalidUtf8(Int)
  InvalidSimpleValue(Int)
  MaxDepthExceeded(Int)
  MaxElementsExceeded(Int)
  DuplicateMapKey(Int)
  NonCanonicalEncoding(Int)
  UnsupportedValue(String)
}

///|
pub fn error_message(err : CborError) -> String {
  match err {
    UnexpectedEof(pos) => "cbor: unexpected EOF at offset " + pos.to_string()
    TrailingBytes(pos) => "cbor: trailing bytes at offset " + pos.to_string()
    InvalidAdditionalInfo(ai, pos) =>
    "cbor: invalid additional info " + ai.to_string() + " at offset " + pos.to_string()
    UnexpectedBreak(pos) => "cbor: unexpected break code at offset " + pos.to_string()
    InvalidIndefiniteChunk(pos) =>
    "cbor: invalid indefinite-length chunk at offset " + pos.to_string()
    InvalidUtf8(pos) => "cbor: invalid UTF-8 text string at offset " + pos.to_string()
    InvalidSimpleValue(v) => "cbor: invalid simple value " + v.to_string()
    MaxDepthExceeded(limit) => "cbor: exceeded max nesting depth " + limit.to_string()
    MaxElementsExceeded(limit) => "cbor: exceeded max elements " + limit.to_string()
    DuplicateMapKey(pos) => "cbor: duplicate map key at offset " + pos.to_string()
    NonCanonicalEncoding(pos) =>
    "cbor: non-canonical encoding at offset " + pos.to_string()
    UnsupportedValue(msg) => "cbor: unsupported value: " + msg
  }
}

///|
pub val struct DecodeOptions {
  pub max_depth : Int
  pub max_elements : Int
  pub reject_duplicate_keys : Bool
  pub require_canonical : Bool
  pub allow_trailing_bytes : Bool
}

///|
pub fn DecodeOptions::default() -> DecodeOptions {
  DecodeOptions::{
    max_depth: 32,
    max_elements: 131072,
    reject_duplicate_keys: false,
    require_canonical: false,
    allow_trailing_bytes: false,
  }
}

///|
pub fn DecodeOptions::strict() -> DecodeOptions {
  DecodeOptions::{
    max_depth: 32,
    max_elements: 131072,
    reject_duplicate_keys: true,
    require_canonical: true,
    allow_trailing_bytes: false,
  }
}

///|
pub enum SortMode {
  None
  CoreDeterministic
  Ctap2
}

///|
pub val struct EncodeOptions {
  pub sort_mode : SortMode
  pub shortest_float : Bool
}

///|
pub fn EncodeOptions::default() -> EncodeOptions {
  EncodeOptions::{ sort_mode: SortMode::None, shortest_float: true }
}

///|
pub fn EncodeOptions::deterministic() -> EncodeOptions {
  EncodeOptions::{ sort_mode: SortMode::CoreDeterministic, shortest_float: true }
}

///|
pub fn EncodeOptions::ctap2() -> EncodeOptions {
  EncodeOptions::{ sort_mode: SortMode::Ctap2, shortest_float: true }
}

///|
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn cbor_equals(lhs : CborValue, rhs : CborValue) -> Bool {
  match (lhs, rhs) {
    (Unsigned(a), Unsigned(b)) => a == b
    (Negative(a), Negative(b)) => a == b
    (Bytes(a), Bytes(b)) => bytes_equal(a, b)
    (Text(a), Text(b)) => a == b
    (Bool(a), Bool(b)) => a == b
    (Null, Null) => true
    (Undefined, Undefined) => true
    (Simple(a), Simple(b)) => a == b
    (Float(a), Float(b)) => {
      let ba = a.to_bits()
      let bb = b.to_bits()
      // Treat all NaNs as equal for structural test comparison; preserve -0.0 vs +0.0.
      let exp_mask : Int64 = 0x7FF0000000000000L
      let frac_mask : Int64 = 0x000FFFFFFFFFFFFFL
      let a_nan = (ba & exp_mask) == exp_mask && (ba & frac_mask) != 0L
      let b_nan = (bb & exp_mask) == exp_mask && (bb & frac_mask) != 0L
      if a_nan && b_nan {
        true
      } else {
        ba == bb
      }
    }
    (Tag(ta, va), Tag(tb, vb)) => ta == tb && cbor_equals(va, vb)
    (Array(a), Array(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if !cbor_equals(a[i], b[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (Map(a), Map(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        let (ka, va) = a[i]
        let (kb, vb) = b[i]
        if !cbor_equals(ka, kb) || !cbor_equals(va, vb) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}
