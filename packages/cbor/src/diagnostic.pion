///| CBOR Diagnostic Notation (RFC 8949 Section 8).

///|
fn diag_hex_char(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (97 + n - 10).to_byte()
  }
}

///|
fn write_hex_u16(sb : StringBuilder, code : Int) -> Unit {
  sb.write_string("\\u")
  sb.write_byte(diag_hex_char((code >> 12) & 15))
  sb.write_byte(diag_hex_char((code >> 8) & 15))
  sb.write_byte(diag_hex_char((code >> 4) & 15))
  sb.write_byte(diag_hex_char(code & 15))
}

///|
fn write_diag_text(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte()) // '"'
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 8 {
      sb.write_string("\\b")
    } else if c == 12 {
      sb.write_string("\\f")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c < 32 {
      write_hex_u16(sb, c)
    } else {
      sb.write_byte(b[i])
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///|
fn write_diag_float(sb : StringBuilder, d : Double) -> Unit {
  let bits = d.to_bits()
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac = bits & 0x000FFFFFFFFFFFFFL
  let neg = ((bits >> 63) & 1L) != 0L
  if exp == 0x7FF {
    if frac != 0L {
      sb.write_string("NaN")
    } else if neg {
      sb.write_string("-Infinity")
    } else {
      sb.write_string("Infinity")
    }
    return
  }
  if exp == 0 && frac == 0L {
    if neg {
      sb.write_string("-0.0")
    } else {
      sb.write_string("0.0")
    }
    return
  }
  let s = d.to_string()
  sb.write_string(s)
  // Ensure decimal point is present for RFC 8949 float diagnostic notation
  let mut has_dot_or_exp = false
  let mut i = 0
  while i < s.length() {
    let ch = s.code_unit_at(i)
    if ch == 46 || ch == 101 || ch == 69 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  if !has_dot_or_exp {
    sb.write_string(".0")
  }
}

///|
fn write_diag(sb : StringBuilder, value : CborValue) -> Unit {
  match value {
    Unsigned(u) => sb.write_string(u.to_string())
    Negative(n) => {
      if n == 18446744073709551615UL {
        sb.write_string("-18446744073709551616")
      } else {
        sb.write_byte((45).to_byte())
        sb.write_string((n + 1UL).to_string())
      }
    }
    Bytes(b) => {
      sb.write_string("h'")
      let mut i = 0
      while i < b.length() {
        let v = b[i].to_int()
        sb.write_byte(diag_hex_char((v >> 4) & 15))
        sb.write_byte(diag_hex_char(v & 15))
        i = i + 1
      }
      sb.write_byte((39).to_byte())
    }
    Text(s) => write_diag_text(sb, s)
    Array(items) => {
      sb.write_byte((91).to_byte())
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_diag(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    Map(pairs) => {
      sb.write_byte((123).to_byte())
      let mut i = 0
      while i < pairs.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        let (k, v) = pairs[i]
        write_diag(sb, k)
        sb.write_string(": ")
        write_diag(sb, v)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
    Tag(t, inner) => {
      sb.write_string(t.to_string())
      sb.write_byte((40).to_byte())
      write_diag(sb, inner)
      sb.write_byte((41).to_byte())
    }
    Bool(b) => sb.write_string(if b { "true" } else { "false" })
    Null => sb.write_string("null")
    Undefined => sb.write_string("undefined")
    Simple(v) => {
      sb.write_string("simple(")
      sb.write_string(v.to_string())
      sb.write_byte((41).to_byte())
    }
    Float(d) => write_diag_float(sb, d)
  }
}

///|
pub fn to_diagnostic(value : CborValue) -> String {
  let sb = StringBuilder::new()
  write_diag(sb, value)
  sb.to_string()
}
