///| Red-team probe runner for packages/http2 (audit only; never linked into the library).
///|   probe hpack  <corpus.txt> [skip]      HPACK differential output (one line per case)
///|   probe frames <corpus.txt>        RFC 9113 single-frame decode differential output
///|   probe conn   <scenarios.txt>     Connection::feed outcome per attack scenario (server role)
///|   probe streams <n> <settings>     open+finish n streams, then apply <settings> INITIAL_WINDOW_SIZE frames
///|   probe drip   <n_frames>          feed n DATA frames byte-by-byte vs in bulk, prints event counts

import "http2"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///|
fn unhex(s : String, from : Int, to : Int) -> Bytes {
  let n = (to - from) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hexval(s.code_unit_at(from + 2 * i))
    let lo = hexval(s.code_unit_at(from + 2 * i + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
let hexdig : String = "0123456789abcdef"

///|
fn hex(sb : StringBuilder, b : Bytes) -> Unit {
  let mut i = 0
  let tmp = Bytes::new(b.length() * 2)
  while i < b.length() {
    let v = b[i].to_int()
    tmp[2 * i] = hexdig.code_unit_at(v >> 4).to_byte()
    tmp[2 * i + 1] = hexdig.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  sb.write_string(tmp.to_string())
}

///| Split text into lines (LF), dropping a trailing empty line.
fn lines(text : String) -> Array[String] {
  let out : Array[String] = []
  let b = text.to_bytes()
  let mut start = 0
  let mut i = 0
  while i < b.length() {
    if b[i].to_int() == 10 {
      out.push(b.slice(start, i).to_string())
      start = i + 1
    }
    i = i + 1
  }
  if start < b.length() {
    out.push(b.slice(start, b.length()).to_string())
  }
  out
}

///|
fn index_of(s : String, c : Int, from : Int) -> Int {
  let mut i = from
  while i < s.length() {
    if s.code_unit_at(i) == c {
      return i
    }
    i = i + 1
  }
  -1
}

///| `name\thex,hex,...` -> (name, [blocks])
fn parse_case(line : String) -> (String, Array[Bytes]) {
  let tab = index_of(line, 9, 0)
  let name = line.to_bytes().slice(0, tab).to_string()
  let blocks : Array[Bytes] = []
  let mut p = tab + 1
  while true {
    let c = index_of(line, 44, p)
    let e = if c < 0 { line.length() } else { c }
    blocks.push(unhex(line, p, e))
    if c < 0 {
      break
    }
    p = c + 1
  }
  (name, blocks)
}

///|
fn run_hpack(world : World, text : String, skip : Int) -> Unit {
  let ls = lines(text)
  let mut li = skip
  while li < ls.length() {
    let sb = StringBuilder::new()
    let (name, blocks) = parse_case(ls[li])
    sb.write_string(name)
    sb.write_string("\t")
    let dec = http2::HpackDecoder::with_limits(4096, 2147483647)
    let mut bi = 0
    while bi < blocks.length() {
      if bi > 0 {
        sb.write_string("|")
      }
      match dec.decode(blocks[bi]) {
        Ok(hs) => {
          let mut i = 0
          while i < hs.length() {
            if i > 0 {
              sb.write_string(" ")
            }
            hex(sb, hs[i].name.to_bytes())
            sb.write_string(":")
            hex(sb, hs[i].value.to_bytes())
            if hs[i].sensitive {
              sb.write_string("!")
            }
            i = i + 1
          }
          sb.write_string(";")
        }
        Err(e) => {
          sb.write_string("ERR(" + http2::h2_error_message(e) + ")")
          bi = blocks.length()
        }
      }
      bi = bi + 1
    }
    io_println(world, sb.to_string())
    li = li + 1
  }
}

///|
fn b01(b : Bool) -> String {
  if b {
    "1"
  } else {
    "0"
  }
}

///|
fn run_frames(world : World, text : String, skip : Int) -> Unit {
  let ls = lines(text)
  let mut li = skip
  while li < ls.length() {
    let sb = StringBuilder::new()
    let (name, blocks) = parse_case(ls[li])
    sb.write_string(name)
    sb.write_string("\t")
    let data = blocks[0]
    match http2::decode_frame(data, 0, 16384) {
      Err(e) => sb.write_string("ERR(" + http2::h2_error_message(e) + ")")
      Ok((f, next)) => {
        if next != data.length() {
          sb.write_string("TRAIL ")
        }
        match f {
          http2::Frame::Data(sid, body, es) => {
            sb.write_string("D " + sid.to_string() + " " + b01(es) + " ")
            hex(sb, body)
          }
          http2::Frame::Headers(sid, frag, es, eh, prio) => {
            sb.write_string("H " + sid.to_string() + " " + b01(es) + " " + b01(eh) + " ")
            match prio {
              Some(p) => sb.write_string(b01(p.exclusive) + "/" + p.dependency.to_string() + "/" + p.weight.to_string() + " ")
              None => sb.write_string("- ")
            }
            hex(sb, frag)
          }
          http2::Frame::Priority(sid, p) => sb.write_string("P " + sid.to_string() + " " + b01(p.exclusive) + "/" + p.dependency.to_string() + "/" + p.weight.to_string())
          http2::Frame::RstStream(sid, code) => sb.write_string("R " + sid.to_string() + " " + (code.to_int64() & 0xFFFFFFFFL).to_string())
          http2::Frame::Settings(ss, ack) => {
            sb.write_string("S " + b01(ack))
            let mut i = 0
            while i < ss.length() {
              sb.write_string(" " + ss[i].id.to_string() + "=" + ss[i].value.to_string())
              i = i + 1
            }
          }
          http2::Frame::PushPromise(sid, prom, frag, eh) => {
            sb.write_string("PP " + sid.to_string() + " " + prom.to_string() + " " + b01(eh) + " ")
            hex(sb, frag)
          }
          http2::Frame::Ping(op, ack) => {
            sb.write_string("G " + b01(ack) + " ")
            hex(sb, op)
          }
          http2::Frame::GoAway(last, code, dbg) => {
            sb.write_string("GA " + last.to_string() + " " + (code.to_int64() & 0xFFFFFFFFL).to_string() + " ")
            hex(sb, dbg)
          }
          http2::Frame::WindowUpdate(sid, inc) => sb.write_string("W " + sid.to_string() + " " + inc.to_string())
          http2::Frame::Continuation(sid, frag, eh) => {
            sb.write_string("C " + sid.to_string() + " " + b01(eh) + " ")
            hex(sb, frag)
          }
          http2::Frame::Unknown(h, body) => {
            sb.write_string("U " + h.frame_type.to_string() + " " + h.stream_id.to_string() + " ")
            hex(sb, body)
          }
        }
      }
    }
    io_println(world, sb.to_string())
    li = li + 1
  }
}

///|
fn ev_tag(ev : http2::ConnectionEvent) -> String {
  match ev {
    http2::ConnectionEvent::Headers(sid, _, _) => "HEADERS(" + sid.to_string() + ")"
    http2::ConnectionEvent::Data(sid, _, _) => "DATA(" + sid.to_string() + ")"
    http2::ConnectionEvent::RstStream(sid, _) => "RST(" + sid.to_string() + ")"
    http2::ConnectionEvent::Settings(_, _) => "SETTINGS"
    http2::ConnectionEvent::Ping(_, _) => "PING"
    http2::ConnectionEvent::GoAway(_, _, _) => "GOAWAY"
    http2::ConnectionEvent::WindowUpdate(_, _) => "WU"
    http2::ConnectionEvent::PushPromise(_, p, _) => "PUSH(" + p.to_string() + ")"
    http2::ConnectionEvent::Priority(_, _) => "PRIO"
    http2::ConnectionEvent::UnknownFrame(_, _) => "UNKNOWN"
  }
}

///| Scenario lines carry the bytes the client sends AFTER the preface + empty SETTINGS.
///| Config mirrors the Go harness: MaxConcurrentStreams = 4.
fn run_conn(world : World, text : String, skip : Int) -> Unit {
  let ls = lines(text)
  let mut li = skip
  while li < ls.length() {
    let sb = StringBuilder::new()
    let (name, blocks) = parse_case(ls[li])
    let cfg = http2::ConnectionConfig::{ ..http2::ConnectionConfig::server(), max_concurrent_streams: 4 }
    let conn = http2::Connection::new(cfg)
    sb.write_string(name)
    sb.write_string("\t")
    let mut heads = 0
    let mut datas = 0
    // the Go harness writes chunks 20 ms apart; Pion is Sans-IO, so the chunks are simply concatenated
    let mut total = 0
    let mut k = 0
    while k < blocks.length() {
      total = total + blocks[k].length()
      k = k + 1
    }
    let wire = Bytes::new(total)
    let mut wp = 0
    k = 0
    while k < blocks.length() {
      let c = blocks[k]
      let mut j = 0
      while j < c.length() {
        wire[wp] = c[j]
        wp = wp + 1
        j = j + 1
      }
      k = k + 1
    }
    match conn.feed(wire) {
      Ok((evs, used)) => {
        let mut i = 0
        while i < evs.length() {
          match evs[i] {
            http2::ConnectionEvent::Headers(_, _, _) => heads = heads + 1
            http2::ConnectionEvent::Data(_, _, _) => datas = datas + 1
            _ => ()
          }
          i = i + 1
        }
        sb.write_string("ACCEPTED headers=" + heads.to_string() + " data=" + datas.to_string())
        if used != wire.length() {
          sb.write_string(" unconsumed=" + (wire.length() - used).to_string())
        }
        if evs.length() > 0 {
          sb.write_string(" last=" + ev_tag(evs[evs.length() - 1]))
        }
      }
      Err(e) => sb.write_string("CONN_ERROR " + http2::h2_error_code(e).to_string() + " " + http2::h2_error_message(e))
    }
    io_println(world, sb.to_string())
    li = li + 1
  }
}

///|
fn frame(ftype : Int, flags : Int, sid : Int, payload : Bytes) -> Bytes {
  let len = payload.length()
  let out = Bytes::new(9 + len)
  out[0] = ((len >> 16) & 255).to_byte()
  out[1] = ((len >> 8) & 255).to_byte()
  out[2] = (len & 255).to_byte()
  out[3] = ftype.to_byte()
  out[4] = flags.to_byte()
  out[5] = ((sid >> 24) & 127).to_byte()
  out[6] = ((sid >> 16) & 255).to_byte()
  out[7] = ((sid >> 8) & 255).to_byte()
  out[8] = (sid & 255).to_byte()
  let mut i = 0
  while i < len {
    out[9 + i] = payload[i]
    i = i + 1
  }
  out
}

///| Open-and-finish `n` streams (HEADERS END_STREAM + RST_STREAM CANCEL from the client is avoided so
///| the rapid-reset counter is not involved), then apply `s` SETTINGS_INITIAL_WINDOW_SIZE frames.
fn run_streams(world : World, n : Int, s : Int) -> Int {
  let cfg = http2::ConnectionConfig::{
    ..http2::ConnectionConfig::server(),
    max_concurrent_streams: 2147483647,
    max_rapid_resets: 2147483647,
  }
  let conn = http2::Connection::new(cfg)
  let enc = http2::HpackEncoder::with_huffman(4096, true)
  let mut sid = 1
  let mut i = 0
  while i < n {
    let blk = enc.encode([
      http2::HeaderField::new(":method", "GET"),
      http2::HeaderField::new(":scheme", "https"),
      http2::HeaderField::new(":authority", "a.example"),
      http2::HeaderField::new(":path", "/"),
    ])
    match conn.receive_frame(http2::Frame::Headers(sid, blk, true, true, None)) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "stream " + sid.to_string() + ": " + http2::h2_error_message(e))
        return 1
      }
    }
    // server answers and finishes the stream
    match conn.open_stream(sid, true) {
      Ok(_) => ()
      Err(_) => ()
    }
    sid = sid + 2
    i = i + 1
  }
  let mut k = 0
  while k < s {
    let v = 65535 + (k & 1)
    match conn.receive_frame(http2::Frame::Settings([http2::Setting::new(4, v.to_int64())], false)) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "settings: " + http2::h2_error_message(e))
        return 1
      }
    }
    k = k + 1
  }
  let st = conn.stream_state(1)
  io_println(world, "streams=" + n.to_string() + " settings=" + s.to_string() + " stream1_retained=" + (if http2::stream_state_eq(st, http2::StreamState::Idle) { "no" } else { "yes" }))
  0
}

///| Feed `n` 1 KiB DATA frames (after one HEADERS) byte-by-byte with the caller-managed tail,
///| compare event count against a bulk feed.
fn run_drip(world : World, n : Int) -> Int {
  let enc = http2::HpackEncoder::with_huffman(4096, true)
  let blk = enc.encode([
    http2::HeaderField::new(":method", "POST"),
    http2::HeaderField::new(":scheme", "https"),
    http2::HeaderField::new(":authority", "a.example"),
    http2::HeaderField::new(":path", "/"),
  ])
  let parts : Array[Bytes] = [frame(1, 4, 1, blk)]
  let body = Bytes::new(1024)
  let mut i = 0
  while i < n {
    parts.push(frame(0, 0, 1, body))
    i = i + 1
  }
  let mut total = 0
  i = 0
  while i < parts.length() {
    total = total + parts[i].length()
    i = i + 1
  }
  let wire = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      wire[pos] = p[j]
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  let bulk = match http2::Connection::server().feed(wire) {
    Ok((evs, _)) => evs.length()
    Err(e) => {
      io_println(world, "bulk: " + http2::h2_error_message(e))
      -1
    }
  }
  // drip: caller appends one byte at a time to a pending window [start, end) of `wire`
  let conn = http2::Connection::server()
  let mut start = 0
  let mut drip = 0
  let mut end = 1
  while end <= wire.length() {
    match conn.feed(wire.slice(start, end)) {
      Ok((evs, used)) => {
        drip = drip + evs.length()
        start = start + used
      }
      Err(e) => {
        io_println(world, "drip: " + http2::h2_error_message(e))
        return 1
      }
    }
    end = end + 1
  }
  io_println(world, "drip_frames=" + n.to_string() + " bulk_events=" + bulk.to_string() + " drip_events=" + drip.to_string() + " leftover=" + (wire.length() - start).to_string())
  0
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: probe hpack|frames|conn <file> | streams <n> <s> | drip <n>")
    return 2
  }
  let mode = args[1]
  if mode == "streams" {
    return run_streams(world, parse_int(args[2]), if args.length() > 3 { parse_int(args[3]) } else { 0 })
  }
  if mode == "drip" {
    return run_drip(world, parse_int(args[2]))
  }
  let text = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "cannot read " + args[2])
      return 2
    }
  }
  let skip = if args.length() > 3 { parse_int(args[3]) } else { 0 }
  if mode == "hpack" {
    run_hpack(world, text, skip)
  } else if mode == "frames" {
    run_frames(world, text, skip)
  } else if mode == "conn" {
    run_conn(world, text, skip)
  } else {
    io_println(world, "unknown mode")
    return 2
  }
  0
}
