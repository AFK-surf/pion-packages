///| Fairness re-benchmark for packages/http2 (audit only). Same corpora as packages/http2/bench.
///|   hpack_decode     <hpack_stream.bin>   100 rounds x 1,000 blocks (fresh decoder per round)
///|   hpack_encode_huff <headers_plain.bin> encoder with Huffman (used when shorter, like Go)
///|   hpack_encode_raw  <headers_plain.bin> encoder without Huffman (same mode as hpack-patched)
///|   frames_codec     <frame_stream.bin>   decode_frame + CONTINUATION reassembly + HPACK (= Go Framer
///|                                         ReadMetaHeaders / h2 Codec level, no stream state machine)
///|   frames_conn      <frame_stream.bin>   decode_frame + Connection::receive_frame (full state machine)
///| Header hashing walks the strings in place (no per-field `to_bytes()` copy, unlike bench/pion_bench).

import "http2"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let n = s.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, s.code_unit_at(i).to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_bytes(h0 : Int64, b : Bytes) -> Int64 {
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///| Ordered (HPACK benches).
fn hash_headers(h0 : Int64, hs : Array[http2::HeaderField]) -> Int64 {
  let mut h = mix(h0, hs.length().to_int64())
  let mut i = 0
  while i < hs.length() {
    h = hash_str(h, hs[i].name)
    h = hash_str(h, hs[i].value)
    i = i + 1
  }
  h
}

///| Order-insensitive (frame benches: h2's Codec hands back a HeaderMap + Pseudo, not the wire order).
fn hash_headers_set(h0 : Int64, hs : Array[http2::HeaderField]) -> Int64 {
  let mut sum = 0L
  let mut i = 0
  while i < hs.length() {
    sum = (sum + hash_str(hash_str(0L, hs[i].name), hs[i].value)) % 1000000007L
    i = i + 1
  }
  mix(mix(h0, hs.length().to_int64()), sum)
}

///|
fn rd16(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

///|
fn rd32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn bench_decode(world : World, data : Bytes) -> Int {
  let count = rd32(data, 0)
  let blocks : Array[Bytes] = []
  let mut pos = 4
  let mut i = 0
  while i < count {
    let l = rd32(data, pos)
    pos = pos + 4
    blocks.push(data.slice(pos, pos + l))
    pos = pos + l
    i = i + 1
  }
  let mut tb = 0L
  let mut th = 0L
  let mut ck = 0L
  let mut round = 0
  while round < 100 {
    let dec = http2::HpackDecoder::new(4096)
    let mut bi = 0
    while bi < count {
      match dec.decode(blocks[bi]) {
        Ok(hs) => {
          tb = tb + 1L
          th = th + hs.length().to_int64()
          ck = hash_headers(ck, hs)
        }
        Err(e) => {
          io_println(world, "decode error: " + http2::h2_error_message(e))
          return 1
        }
      }
      bi = bi + 1
    }
    round = round + 1
  }
  io_println(world, "mode=hpack_decode")
  io_println(world, "blocks=" + tb.to_string())
  io_println(world, "headers=" + th.to_string())
  io_println(world, "checksum=" + ck.to_string())
  0
}

///|
fn bench_encode(world : World, data : Bytes, huff : Bool) -> Int {
  let count = rd32(data, 0)
  let lists : Array[Array[http2::HeaderField]] = []
  let mut pos = 4
  let mut i = 0
  while i < count {
    let hc = rd16(data, pos)
    pos = pos + 2
    let hs : Array[http2::HeaderField] = []
    let mut j = 0
    while j < hc {
      let nl = rd16(data, pos)
      pos = pos + 2
      let name = data.slice(pos, pos + nl).to_string()
      pos = pos + nl
      let vl = rd16(data, pos)
      pos = pos + 2
      let v = data.slice(pos, pos + vl).to_string()
      pos = pos + vl
      let sens = data[pos].to_int() != 0
      pos = pos + 1
      hs.push(http2::HeaderField::{ name: name, value: v, sensitive: sens })
      j = j + 1
    }
    lists.push(hs)
    i = i + 1
  }
  let mut tb = 0L
  let mut th = 0L
  let mut sink = 0L
  let mut vck = 0L
  let mut round = 0
  while round < 100 {
    let enc = http2::HpackEncoder::with_huffman(4096, huff)
    let dec = http2::HpackDecoder::new(4096)
    let verify = round == 99
    let mut bi = 0
    while bi < count {
      let hs = lists[bi]
      let wire = enc.encode(hs)
      tb = tb + 1L
      th = th + hs.length().to_int64()
      sink = sink + wire.length().to_int64()
      if verify {
        match dec.decode(wire) {
          Ok(rt) => vck = hash_headers(vck, rt)
          Err(e) => {
            io_println(world, "verify decode error: " + http2::h2_error_message(e))
            return 1
          }
        }
      }
      bi = bi + 1
    }
    round = round + 1
  }
  if sink <= 0L {
    return 1
  }
  io_println(world, "mode=hpack_encode")
  io_println(world, "blocks=" + tb.to_string())
  io_println(world, "headers=" + th.to_string())
  io_println(world, "verify_checksum=" + vck.to_string())
  0
}

///|
fn b2i(b : Bool) -> Int64 {
  if b {
    1L
  } else {
    0L
  }
}

///| frames_codec: frame decode + CONTINUATION reassembly + HPACK, no stream state machine.
fn bench_frames_codec(world : World, data : Bytes) -> Int {
  let mut frames = 0L
  let mut events = 0L
  let mut ck = 0L
  let mut round = 0
  while round < 100 {
    let dec = http2::HpackDecoder::with_limits(4096, 65536)
    let mut pos = 0
    let n = data.length()
    let mut psid = 0
    let mut pes = false
    let mut parts : Array[Bytes] = []
    while pos < n {
      match http2::decode_frame(data, pos, 16384) {
        Ok((f, next)) => {
          pos = next
          frames = frames + 1L
          match f {
            http2::Frame::Headers(sid, frag, es, eh, _) => {
              if eh {
                match dec.decode(frag) {
                  Ok(hs) => {
                    events = events + 1L
                    ck = mix(mix(mix(ck, 1L), sid.to_int64()), b2i(es))
                    ck = hash_headers_set(ck, hs)
                  }
                  Err(e) => {
                    io_println(world, "hpack: " + http2::h2_error_message(e))
                    return 1
                  }
                }
              } else {
                psid = sid
                pes = es
                parts = [frag]
              }
            }
            http2::Frame::Continuation(_, frag, eh) => {
              parts.push(frag)
              if eh {
                let mut tot = 0
                let mut k = 0
                while k < parts.length() {
                  tot = tot + parts[k].length()
                  k = k + 1
                }
                let blk = Bytes::new(tot)
                let mut w = 0
                k = 0
                while k < parts.length() {
                  let p = parts[k]
                  let mut j = 0
                  while j < p.length() {
                    blk[w] = p[j]
                    w = w + 1
                    j = j + 1
                  }
                  k = k + 1
                }
                match dec.decode(blk) {
                  Ok(hs) => {
                    events = events + 1L
                    ck = mix(mix(mix(ck, 1L), psid.to_int64()), b2i(pes))
                    ck = hash_headers_set(ck, hs)
                  }
                  Err(e) => {
                    io_println(world, "hpack: " + http2::h2_error_message(e))
                    return 1
                  }
                }
              }
            }
            http2::Frame::Data(sid, body, es) => {
              events = events + 1L
              ck = hash_bytes(mix(mix(mix(ck, 2L), sid.to_int64()), b2i(es)), body)
            }
            http2::Frame::Settings(_, ack) => {
              events = events + 1L
              ck = mix(mix(ck, 3L), b2i(ack))
            }
            http2::Frame::WindowUpdate(sid, inc) => {
              events = events + 1L
              ck = mix(mix(mix(ck, 4L), sid.to_int64()), inc.to_int64())
            }
            http2::Frame::Ping(op, ack) => {
              events = events + 1L
              ck = hash_bytes(mix(mix(ck, 5L), b2i(ack)), op)
            }
            http2::Frame::Priority(_, _) => {
              events = events + 1L
              ck = mix(ck, 6L)
            }
            _ => ()
          }
        }
        Err(e) => {
          io_println(world, "frame: " + http2::h2_error_message(e))
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=frames")
  io_println(world, "frames=" + frames.to_string())
  io_println(world, "events=" + events.to_string())
  io_println(world, "checksum=" + ck.to_string())
  0
}

///| frames_conn: same checksum, through Connection::receive_frame (state machine + header validation).
fn bench_frames_conn(world : World, data : Bytes) -> Int {
  let cfg = http2::ConnectionConfig::{
    ..http2::ConnectionConfig::server(),
    max_concurrent_streams: 1000,
    max_rapid_resets: 1000,
  }
  let mut frames = 0L
  let mut events = 0L
  let mut ck = 0L
  let mut round = 0
  while round < 100 {
    let conn = http2::Connection::new(cfg)
    let mut pos = 0
    let n = data.length()
    while pos < n {
      match http2::decode_frame(data, pos, 16384) {
        Ok((f, next)) => {
          pos = next
          frames = frames + 1L
          match conn.receive_frame(f) {
            Ok(Some(ev)) => {
              events = events + 1L
              match ev {
                http2::ConnectionEvent::Headers(sid, hs, es) => {
                  ck = mix(mix(mix(ck, 1L), sid.to_int64()), b2i(es))
                  ck = hash_headers_set(ck, hs)
                }
                http2::ConnectionEvent::Data(sid, body, es) => ck = hash_bytes(mix(mix(mix(ck, 2L), sid.to_int64()), b2i(es)), body)
                http2::ConnectionEvent::Settings(_, ack) => ck = mix(mix(ck, 3L), b2i(ack))
                http2::ConnectionEvent::WindowUpdate(sid, inc) => ck = mix(mix(mix(ck, 4L), sid.to_int64()), inc.to_int64())
                http2::ConnectionEvent::Ping(op, ack) => ck = hash_bytes(mix(mix(ck, 5L), b2i(ack)), op)
                http2::ConnectionEvent::Priority(_, _) => ck = mix(ck, 6L)
                _ => ()
              }
            }
            Ok(None) => ()
            Err(e) => {
              io_println(world, "conn: " + http2::h2_error_message(e))
              return 1
            }
          }
        }
        Err(e) => {
          io_println(world, "frame: " + http2::h2_error_message(e))
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=frames")
  io_println(world, "frames=" + frames.to_string())
  io_println(world, "events=" + events.to_string())
  io_println(world, "checksum=" + ck.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_fair <mode> <corpus>")
    return 2
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 2
  }
  let m = args[1]
  if m == "hpack_decode" {
    bench_decode(world, data)
  } else if m == "hpack_encode_huff" {
    bench_encode(world, data, true)
  } else if m == "hpack_encode_raw" {
    bench_encode(world, data, false)
  } else if m == "frames_codec" {
    bench_frames_codec(world, data)
  } else if m == "frames_conn" {
    bench_frames_conn(world, data)
  } else {
    2
  }
}
