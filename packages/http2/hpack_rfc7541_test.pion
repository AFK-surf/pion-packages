///| RFC 7541 HPACK Compliance Tests:
///| Appendix C.1 (Integers), C.2 (Literals), C.3/C.4 (Requests), C.5/C.6 (Responses),
///| Appendix B (256-symbol + EOS Canonical Huffman), Dynamic Table FIFO & Size Updates,
///| and Encoder/Decoder Roundtrips.

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    -1
  }
}

///|
fn bytes_from_hex(s : String) -> Bytes {
  let mut count = 0
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if hex_nibble(c) >= 0 {
      count = count + 1
    }
    i = i + 1
  }
  let mut out = Bytes::new(count / 2)
  let mut idx = 0
  let mut hi = -1
  i = 0
  while i < n {
    let v = hex_nibble(s.code_unit_at(i))
    if v >= 0 {
      if hi < 0 {
        hi = v
      } else {
        out[idx] = ((hi << 4) | v).to_byte()
        idx = idx + 1
        hi = -1
      }
    }
    i = i + 1
  }
  out
}

///|
fn assert_header(h : HeaderField, name : String, value : String) -> Unit {
  debug_assert(h.name == name, "header name expected=" + name + " got=" + h.name)
  debug_assert(h.value == value, "header value expected=" + value + " got=" + h.value)
}

///|
test "rfc7541_c1_integer_codec" {
  // C.1.1: Encoding 10 Using a 5-Bit Prefix -> 0x0a
  let b1 = hpack_encode_int(10L, 5, 0x00)
  debug_assert(bytes_equal(b1, bytes_from_hex("0a")), "C.1.1 encode 10")
  match hpack_decode_int(b1, 0, 5) {
    Ok((v, next)) => {
      debug_assert(v == 10L, "C.1.1 decode value")
      debug_assert(next == 1, "C.1.1 decode offset")
    }
    Err(e) => debug_assert(false, "C.1.1 decode failed: " + h2_error_message(e))
  }

  // C.1.2: Encoding 1337 Using a 5-Bit Prefix -> 1f 9a 0a
  let b2 = hpack_encode_int(1337L, 5, 0x00)
  debug_assert(bytes_equal(b2, bytes_from_hex("1f 9a 0a")), "C.1.2 encode 1337")
  match hpack_decode_int(b2, 0, 5) {
    Ok((v, next)) => {
      debug_assert(v == 1337L, "C.1.2 decode value")
      debug_assert(next == 3, "C.1.2 decode offset")
    }
    Err(e) => debug_assert(false, "C.1.2 decode failed: " + h2_error_message(e))
  }

  // C.1.3: Encoding 42 Starting at an Octet Boundary (8-bit prefix) -> 2a
  let b3 = hpack_encode_int(42L, 8, 0x00)
  debug_assert(bytes_equal(b3, bytes_from_hex("2a")), "C.1.3 encode 42")
  match hpack_decode_int(b3, 0, 8) {
    Ok((v, next)) => {
      debug_assert(v == 42L, "C.1.3 decode value")
      debug_assert(next == 1, "C.1.3 decode offset")
    }
    Err(e) => debug_assert(false, "C.1.3 decode failed: " + h2_error_message(e))
  }

  // All prefix sizes 1..8 across boundary values
  let vals = [0L, 1L, 30L, 31L, 32L, 127L, 128L, 255L, 256L, 65535L, 1000000L]
  let mut p = 1
  while p <= 8 {
    let mut vi = 0
    while vi < vals.length() {
      let enc = hpack_encode_int(vals[vi], p, 0x00)
      match hpack_decode_int(enc, 0, p) {
        Ok((dec, next)) => {
          debug_assert(dec == vals[vi], "varint roundtrip value")
          debug_assert(next == enc.length(), "varint roundtrip consumed")
        }
        Err(e) => debug_assert(false, "varint roundtrip failed: " + h2_error_message(e))
      }
      vi = vi + 1
    }
    p = p + 1
  }

  // Overflow & overlong continuation attack rejection
  let overflow_bytes = bytes_from_hex("1f ff ff ff ff ff ff ff ff ff 01")
  match hpack_decode_int(overflow_bytes, 0, 5) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject 64-bit varint overflow")
  }
  let overlong_zeros = bytes_from_hex("1f 80 80 80 80 80 80 80 80 80 80 00")
  match hpack_decode_int(overlong_zeros, 0, 5) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject overlong varint continuation")
  }
}

///|
test "rfc7541_static_table_all_61_entries" {
  // Verify bounds and key static table entries (RFC 7541 Appendix A)
  match static_table_get(0) {
    None => ()
    Some(_) => debug_assert(false, "index 0 must be None")
  }
  match static_table_get(62) {
    None => ()
    Some(_) => debug_assert(false, "index 62 must be None")
  }
  let mut i = 1
  while i <= 61 {
    match static_table_get(i) {
      Some(h) => debug_assert(h.name.length() > 0, "static entry non-empty name")
      None => debug_assert(false, "missing static entry " + i.to_string())
    }
    i = i + 1
  }
  match static_table_get(1) {
    Some(h) => assert_header(h, ":authority", "")
    None => debug_assert(false, "static[1]")
  }
  match static_table_get(2) {
    Some(h) => assert_header(h, ":method", "GET")
    None => debug_assert(false, "static[2]")
  }
  match static_table_get(8) {
    Some(h) => assert_header(h, ":status", "200")
    None => debug_assert(false, "static[8]")
  }
  match static_table_get(16) {
    Some(h) => assert_header(h, "accept-encoding", "gzip, deflate")
    None => debug_assert(false, "static[16]")
  }
  match static_table_get(61) {
    Some(h) => assert_header(h, "www-authenticate", "")
    None => debug_assert(false, "static[61]")
  }
}

///|
test "rfc7541_huffman_all_256_symbols_and_strict_errors" {
  // All 256 byte values individually and combined
  let mut all = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    all[i] = i.to_byte()
    let mut single = Bytes::new(1)
    single[0] = i.to_byte()
    let enc = huffman_encode(single)
    debug_assert(enc.length() == huffman_encoded_len(single), "encoded len matches")
    match huffman_decode(enc) {
      Ok(dec) => debug_assert(bytes_equal(dec, single), "symbol roundtrip " + i.to_string())
      Err(e) => debug_assert(false, "symbol decode failed " + i.to_string() + ": " + h2_error_message(e))
    }
    i = i + 1
  }
  let enc_all = huffman_encode(all)
  debug_assert(enc_all.length() == huffman_encoded_len(all), "all-256 encoded len")
  match huffman_decode(enc_all) {
    Ok(dec) => debug_assert(bytes_equal(dec, all), "all-256 roundtrip")
    Err(e) => debug_assert(false, "all-256 decode failed: " + h2_error_message(e))
  }

  // Known RFC 7541 C.4.1 vector: "www.example.com"
  let www = "www.example.com".to_bytes()
  let www_huff = bytes_from_hex("f1 e3 c2 e5 f2 3a 6b a0 ab 90 f4 ff")
  debug_assert(bytes_equal(huffman_encode(www), www_huff), "www.example.com huffman encode")
  match huffman_decode(www_huff) {
    Ok(dec) => debug_assert(bytes_equal(dec, www), "www.example.com huffman decode")
    Err(e) => debug_assert(false, "www decode failed: " + h2_error_message(e))
  }

  // Empty input -> empty output
  match huffman_decode(Bytes::new(0)) {
    Ok(dec) => debug_assert(dec.length() == 0, "empty huffman")
    Err(_) => debug_assert(false, "empty huffman must succeed")
  }

  // Error 1: Explicit EOS symbol (30 ones + 2 padding ones = ff ff ff ff)
  match huffman_decode(bytes_from_hex("ff ff ff ff")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject explicit EOS symbol")
  }

  // Error 2: Padding strictly longer than 7 bits (single byte 0xff = 8 ones)
  match huffman_decode(bytes_from_hex("ff")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject >7 bit padding (0xff)")
  }

  // Error 3: Non-all-1 padding: '0' is 00000 (5 bits), valid padded byte is 0x07 (00000_111),
  // invalid padding is 0x00 (00000_000) or 0x06 (00000_110)
  match huffman_decode(bytes_from_hex("07")) {
    Ok(dec) => debug_assert(dec.to_string() == "0", "0x07 decodes to '0'")
    Err(e) => debug_assert(false, "0x07 should succeed: " + h2_error_message(e))
  }
  match huffman_decode(bytes_from_hex("06")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject non-all-1 padding 0x06")
  }
  match huffman_decode(bytes_from_hex("00")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject non-all-1 padding 0x00")
  }
}

///|
test "rfc7541_c2_header_field_representations" {
  // C.2.1 Literal Header Field with Indexing
  let d1 = HpackDecoder::new(4096)
  match d1.decode(bytes_from_hex("400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572")) {
    Ok(hs) => {
      debug_assert(hs.length() == 1, "C.2.1 len")
      assert_header(hs[0], "custom-key", "custom-header")
      debug_assert(!hs[0].sensitive, "C.2.1 not sensitive")
      debug_assert(d1.dynamic_table_len() == 1, "C.2.1 dyn len")
      debug_assert(d1.dynamic_table_size() == 55, "C.2.1 dyn size 55")
    }
    Err(e) => debug_assert(false, "C.2.1 failed: " + h2_error_message(e))
  }

  // C.2.2 Literal Header Field without Indexing
  let d2 = HpackDecoder::new(4096)
  match d2.decode(bytes_from_hex("040c 2f73 616d 706c 652f 7061 7468")) {
    Ok(hs) => {
      debug_assert(hs.length() == 1, "C.2.2 len")
      assert_header(hs[0], ":path", "/sample/path")
      debug_assert(!hs[0].sensitive, "C.2.2 not sensitive")
      debug_assert(d2.dynamic_table_len() == 0, "C.2.2 dyn empty")
    }
    Err(e) => debug_assert(false, "C.2.2 failed: " + h2_error_message(e))
  }

  // C.2.3 Literal Header Field Never Indexed
  let d3 = HpackDecoder::new(4096)
  match d3.decode(bytes_from_hex("1008 7061 7373 776f 7264 0673 6563 7265 74")) {
    Ok(hs) => {
      debug_assert(hs.length() == 1, "C.2.3 len")
      assert_header(hs[0], "password", "secret")
      debug_assert(hs[0].sensitive, "C.2.3 sensitive true")
      debug_assert(d3.dynamic_table_len() == 0, "C.2.3 dyn empty")
    }
    Err(e) => debug_assert(false, "C.2.3 failed: " + h2_error_message(e))
  }

  // C.2.4 Indexed Header Field
  let d4 = HpackDecoder::new(4096)
  match d4.decode(bytes_from_hex("82")) {
    Ok(hs) => {
      debug_assert(hs.length() == 1, "C.2.4 len")
      assert_header(hs[0], ":method", "GET")
    }
    Err(e) => debug_assert(false, "C.2.4 failed: " + h2_error_message(e))
  }
}

///|
test "rfc7541_c3_requests_without_huffman" {
  let dec = HpackDecoder::new(4096)

  // C.3.1 First Request
  match dec.decode(bytes_from_hex("8286 8441 0f77 7777 2e65 7861 6d70 6c65 2e63 6f6d")) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.3.1 len")
      assert_header(hs[0], ":method", "GET")
      assert_header(hs[1], ":scheme", "http")
      assert_header(hs[2], ":path", "/")
      assert_header(hs[3], ":authority", "www.example.com")
      debug_assert(dec.dynamic_table_size() == 57, "C.3.1 dyn size 57")
    }
    Err(e) => debug_assert(false, "C.3.1 failed: " + h2_error_message(e))
  }

  // C.3.2 Second Request
  match dec.decode(bytes_from_hex("8286 84be 5808 6e6f 2d63 6163 6865")) {
    Ok(hs) => {
      debug_assert(hs.length() == 5, "C.3.2 len")
      assert_header(hs[3], ":authority", "www.example.com")
      assert_header(hs[4], "cache-control", "no-cache")
      debug_assert(dec.dynamic_table_size() == 110, "C.3.2 dyn size 110")
    }
    Err(e) => debug_assert(false, "C.3.2 failed: " + h2_error_message(e))
  }

  // C.3.3 Third Request
  match dec.decode(bytes_from_hex("8287 85bf 400a 6375 7374 6f6d 2d6b 6579 0c63 7573 746f 6d2d 7661 6c75 65")) {
    Ok(hs) => {
      debug_assert(hs.length() == 5, "C.3.3 len")
      assert_header(hs[0], ":method", "GET")
      assert_header(hs[1], ":scheme", "https")
      assert_header(hs[2], ":path", "/index.html")
      assert_header(hs[3], ":authority", "www.example.com")
      assert_header(hs[4], "custom-key", "custom-value")
      debug_assert(dec.dynamic_table_size() == 164, "C.3.3 dyn size 164")
      debug_assert(dec.dynamic_table_len() == 3, "C.3.3 dyn len 3")
    }
    Err(e) => debug_assert(false, "C.3.3 failed: " + h2_error_message(e))
  }
}

///|
test "rfc7541_c4_requests_with_huffman" {
  let dec = HpackDecoder::new(4096)

  // C.4.1
  match dec.decode(bytes_from_hex("8286 8441 8cf1 e3c2 e5f2 3a6b a0ab 90f4 ff")) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.4.1 len")
      assert_header(hs[3], ":authority", "www.example.com")
      debug_assert(dec.dynamic_table_size() == 57, "C.4.1 dyn size 57")
    }
    Err(e) => debug_assert(false, "C.4.1 failed: " + h2_error_message(e))
  }

  // C.4.2
  match dec.decode(bytes_from_hex("8286 84be 5886 a8eb 1064 9cbf")) {
    Ok(hs) => {
      debug_assert(hs.length() == 5, "C.4.2 len")
      assert_header(hs[4], "cache-control", "no-cache")
      debug_assert(dec.dynamic_table_size() == 110, "C.4.2 dyn size 110")
    }
    Err(e) => debug_assert(false, "C.4.2 failed: " + h2_error_message(e))
  }

  // C.4.3
  match dec.decode(bytes_from_hex("8287 85bf 4088 25a8 49e9 5ba9 7d7f 8925 a849 e95b b8e8 b4bf")) {
    Ok(hs) => {
      debug_assert(hs.length() == 5, "C.4.3 len")
      assert_header(hs[4], "custom-key", "custom-value")
      debug_assert(dec.dynamic_table_size() == 164, "C.4.3 dyn size 164")
    }
    Err(e) => debug_assert(false, "C.4.3 failed: " + h2_error_message(e))
  }
}

///|
test "rfc7541_c5_responses_without_huffman_eviction" {
  let dec = HpackDecoder::new(256)

  // C.5.1
  let r1 = bytes_from_hex(
    "4803 3330 3258 0770 7269 7661 7465 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3120 474d 546e 1768 7474 7073 3a2f 2f77 7777 2e65 7861 6d70 6c65 2e63 6f6d",
  )
  match dec.decode(r1) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.5.1 len")
      assert_header(hs[0], ":status", "302")
      assert_header(hs[1], "cache-control", "private")
      assert_header(hs[2], "date", "Mon, 21 Oct 2013 20:13:21 GMT")
      assert_header(hs[3], "location", "https://www.example.com")
      debug_assert(dec.dynamic_table_size() == 222, "C.5.1 dyn size 222")
      debug_assert(dec.dynamic_table_len() == 4, "C.5.1 dyn len 4")
    }
    Err(e) => debug_assert(false, "C.5.1 failed: " + h2_error_message(e))
  }

  // C.5.2 (evicts :status: 302)
  match dec.decode(bytes_from_hex("4803 3330 37c1 c0bf")) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.5.2 len")
      assert_header(hs[0], ":status", "307")
      assert_header(hs[1], "cache-control", "private")
      assert_header(hs[2], "date", "Mon, 21 Oct 2013 20:13:21 GMT")
      assert_header(hs[3], "location", "https://www.example.com")
      debug_assert(dec.dynamic_table_size() == 222, "C.5.2 dyn size 222")
    }
    Err(e) => debug_assert(false, "C.5.2 failed: " + h2_error_message(e))
  }

  // C.5.3 (evicts older entries, leaves 3 entries of total size 215)
  let r3 = bytes_from_hex(
    "88c1 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3220 474d 54c0 5a04 677a 6970 7738 666f 6f3d 4153 444a 4b48 514b 425a 584f 5157 454f 5049 5541 5851 5745 4f49 553b 206d 6178 2d61 6765 3d33 3630 303b 2076 6572 7369 6f6e 3d31",
  )
  match dec.decode(r3) {
    Ok(hs) => {
      debug_assert(hs.length() == 6, "C.5.3 len")
      assert_header(hs[0], ":status", "200")
      assert_header(hs[1], "cache-control", "private")
      assert_header(hs[2], "date", "Mon, 21 Oct 2013 20:13:22 GMT")
      assert_header(hs[3], "location", "https://www.example.com")
      assert_header(hs[4], "content-encoding", "gzip")
      assert_header(hs[5], "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")
      debug_assert(dec.dynamic_table_size() == 215, "C.5.3 dyn size 215")
      debug_assert(dec.dynamic_table_len() == 3, "C.5.3 dyn len 3")
    }
    Err(e) => debug_assert(false, "C.5.3 failed: " + h2_error_message(e))
  }
}

///|
test "rfc7541_c6_responses_with_huffman_eviction" {
  let dec = HpackDecoder::new(256)

  let r1 = bytes_from_hex(
    "4882 6402 5885 aec3 771a 4b61 96d0 7abe 9410 54d4 44a8 2005 9504 0b81 66e0 82a6 2d1b ff6e 919d 29ad 1718 63c7 8f0b 97c8 e9ae 82ae 43d3",
  )
  match dec.decode(r1) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.6.1 len")
      assert_header(hs[0], ":status", "302")
      assert_header(hs[2], "date", "Mon, 21 Oct 2013 20:13:21 GMT")
      assert_header(hs[3], "location", "https://www.example.com")
      debug_assert(dec.dynamic_table_size() == 222, "C.6.1 dyn size 222")
    }
    Err(e) => debug_assert(false, "C.6.1 failed: " + h2_error_message(e))
  }

  match dec.decode(bytes_from_hex("4883 640e ffc1 c0bf")) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "C.6.2 len")
      assert_header(hs[0], ":status", "307")
      debug_assert(dec.dynamic_table_size() == 222, "C.6.2 dyn size 222")
    }
    Err(e) => debug_assert(false, "C.6.2 failed: " + h2_error_message(e))
  }

  let r3 = bytes_from_hex(
    "88c1 6196 d07a be94 1054 d444 a820 0595 040b 8166 e084 a62d 1bff c05a 839b d9ab 77ad 94e7 821d d7f2 e6c7 b335 dfdf cd5b 3960 d5af 2708 7f36 72c1 ab27 0fb5 291f 9587 3160 65c0 03ed 4ee5 b106 3d50 07",
  )
  match dec.decode(r3) {
    Ok(hs) => {
      debug_assert(hs.length() == 6, "C.6.3 len")
      assert_header(hs[0], ":status", "200")
      assert_header(hs[4], "content-encoding", "gzip")
      assert_header(hs[5], "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")
      debug_assert(dec.dynamic_table_size() == 215, "C.6.3 dyn size 215")
    }
    Err(e) => debug_assert(false, "C.6.3 failed: " + h2_error_message(e))
  }
}

///|
test "rfc7541_dynamic_table_size_update_rules" {
  // Valid: size update to 0 at start of block evicts all entries
  let dec = HpackDecoder::new(4096)
  let _ = dec.decode(bytes_from_hex("400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572"))
  debug_assert(dec.dynamic_table_len() == 1, "before shrink len 1")
  // 0x20 = size update to 0, followed by 0x82 (:method: GET)
  match dec.decode(bytes_from_hex("20 82")) {
    Ok(hs) => {
      debug_assert(hs.length() == 1, "after shrink len 1")
      debug_assert(dec.dynamic_table_len() == 0, "evicted all")
      debug_assert(dec.dynamic_table_size() == 0, "size 0")
    }
    Err(e) => debug_assert(false, "valid size update failed: " + h2_error_message(e))
  }

  // Invalid: size update AFTER a header field (0x82 then 0x20)
  let dec2 = HpackDecoder::new(4096)
  match dec2.decode(bytes_from_hex("82 20")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject dynamic table size update after header")
  }

  // Invalid: size update exceeding negotiated max_dynamic_table_size (256)
  // 0x3f 0xe2 0x01 = 31 + 226 = 257 > 256
  let dec3 = HpackDecoder::new(256)
  match dec3.decode(bytes_from_hex("3f e2 01 82")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject dynamic table size update > negotiated max")
  }

  // Invalid: index 0 (0x80) and out-of-bounds index (0xbe when dynamic table is empty)
  let dec4 = HpackDecoder::new(4096)
  match dec4.decode(bytes_from_hex("80")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject index 0")
  }
  match dec4.decode(bytes_from_hex("be")) {
    Err(H2Error::CompressionError(_)) => ()
    _ => debug_assert(false, "must reject out-of-bounds index 62 on empty dynamic table")
  }
}

///|
test "rfc7541_encoder_decoder_roundtrip_and_sensitive" {
  let enc = HpackEncoder::with_huffman(4096, true)
  let dec = HpackDecoder::new(4096)

  let req1 = [
    HeaderField::new(":method", "POST"),
    HeaderField::new(":scheme", "https"),
    HeaderField::new(":authority", "api.example.com"),
    HeaderField::new(":path", "/v1/orders?limit=50"),
    HeaderField::new("content-type", "application/json"),
    HeaderField::sensitive("authorization", "Bearer super-secret-token-12345"),
    HeaderField::new("x-request-id", "req-0001"),
  ]
  let wire1 = enc.encode(req1)
  match dec.decode(wire1) {
    Ok(out1) => {
      debug_assert(out1.length() == req1.length(), "req1 len")
      let mut i = 0
      while i < req1.length() {
        assert_header(out1[i], req1[i].name, req1[i].value)
        debug_assert(out1[i].sensitive == req1[i].sensitive, "req1 sensitive flag")
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "req1 decode failed: " + h2_error_message(e))
  }

  // Second request reuses dynamic table entries and should be much smaller!
  let req2 = [
    HeaderField::new(":method", "POST"),
    HeaderField::new(":scheme", "https"),
    HeaderField::new(":authority", "api.example.com"),
    HeaderField::new(":path", "/v1/orders?limit=50"),
    HeaderField::new("content-type", "application/json"),
    HeaderField::new("x-request-id", "req-0002"),
  ]
  let wire2 = enc.encode(req2)
  debug_assert(wire2.length() < wire1.length(), "second request compressed smaller via dynamic table")
  match dec.decode(wire2) {
    Ok(out2) => {
      debug_assert(out2.length() == req2.length(), "req2 len")
      let mut i = 0
      while i < req2.length() {
        assert_header(out2[i], req2[i].name, req2[i].value)
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "req2 decode failed: " + h2_error_message(e))
  }

  // Encoder table size shrink -> emits size update -> decoder stays in sync
  enc.set_max_table_size(128)
  let wire3 = enc.encode(req2)
  match dec.decode(wire3) {
    Ok(out3) => {
      debug_assert(out3.length() == req2.length(), "req3 len")
      debug_assert(dec.dynamic_table_size() <= 128, "decoder table shrunk to <= 128")
    }
    Err(e) => debug_assert(false, "req3 decode failed: " + h2_error_message(e))
  }
}
