///| Native + Wasm32 (debug & release) smoke test for packages/http2.
///| Exercises HPACK (static/dynamic/Huffman), RFC 9113 frame codec, stream state machine,
///| flow control, and Day-1 CVE defenses, emitting a deterministic non-empty stdout digest.

import "http2"

///|
pub fn smoke(world : World) -> Int {
  // 1. Preface check
  match http2::validate_client_preface(http2::client_preface_bytes()) {
    Ok(24) => ()
    _ => return 1
  }

  // 2. Huffman 256-symbol roundtrip
  let mut all = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    all[i] = i.to_byte()
    i = i + 1
  }
  let enc_h = http2::huffman_encode(all)
  match http2::huffman_decode(enc_h) {
    Ok(dec) => {
      if !http2::bytes_equal(dec, all) {
        return 2
      }
    }
    Err(_) => return 3
  }

  // 3. HPACK + Frame + Connection end-to-end
  let enc = http2::HpackEncoder::with_huffman(4096, true)
  let req = [
    http2::HeaderField::new(":method", "POST"),
    http2::HeaderField::new(":scheme", "https"),
    http2::HeaderField::new(":authority", "api.pion.dev"),
    http2::HeaderField::new(":path", "/v1/smoke"),
    http2::HeaderField::new("content-type", "application/json"),
    http2::HeaderField::sensitive("authorization", "Bearer smoke-secret"),
  ]
  let hblock = enc.encode(req)
  let f_hdr = match http2::encode_frame(http2::Frame::Headers(1, hblock, false, true, None)) {
    Ok(b) => b
    Err(_) => return 4
  }
  let f_data = match http2::encode_frame(http2::Frame::Data(1, "{\"ok\":true}".to_bytes(), true)) {
    Ok(b) => b
    Err(_) => return 5
  }
  let conn = http2::Connection::server()
  let mut ev_count = 0
  match conn.feed(f_hdr) {
    Ok((evs, n)) => {
      if n != f_hdr.length() || evs.length() != 1 {
        return 6
      }
      ev_count = ev_count + evs.length()
    }
    Err(_) => return 7
  }
  match conn.feed(f_data) {
    Ok((evs, n)) => {
      if n != f_data.length() || evs.length() != 1 {
        return 8
      }
      ev_count = ev_count + evs.length()
    }
    Err(_) => return 9
  }
  if !http2::stream_state_eq(conn.stream_state(1), http2::StreamState::HalfClosedRemote) {
    return 10
  }

  // 4. Security smoke: reject explicit EOS in Huffman without trapping
  let mut eos = Bytes::new(4)
  eos[0] = 0xFF.to_byte()
  eos[1] = 0xFF.to_byte()
  eos[2] = 0xFF.to_byte()
  eos[3] = 0xFF.to_byte()
  match http2::huffman_decode(eos) {
    Err(http2::H2Error::CompressionError(_)) => ()
    _ => return 11
  }

  io_println(
    world,
    "http2_wasm_smoke ok events=" +
    ev_count.to_string() +
    " huff_len=" +
    enc_h.length().to_string() +
    " win=" +
    conn.conn_recv_window().to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  smoke(world)
}
