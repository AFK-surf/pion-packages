///| RFC 9113 HTTP/2 Frame Codec & Connection Preface Compliance Tests.

///|
test "rfc9113_client_connection_preface" {
  let valid = client_preface_bytes()
  debug_assert(valid.length() == 24, "preface is 24 bytes")
  match validate_client_preface(valid) {
    Ok(n) => debug_assert(n == 24, "consumed 24")
    Err(e) => debug_assert(false, "valid preface failed: " + h2_error_message(e))
  }

  // Partial prefix -> Incomplete
  match validate_client_preface("PRI * HTTP/2.0\r\n".to_bytes()) {
    Err(H2Error::Incomplete) => ()
    _ => debug_assert(false, "partial preface must return Incomplete")
  }

  // Invalid preface -> InvalidPreface
  match validate_client_preface("GET / HTTP/1.1\r\n\r\n".to_bytes()) {
    Err(H2Error::InvalidPreface) => ()
    _ => debug_assert(false, "HTTP/1.1 request must return InvalidPreface")
  }
}

///|
test "rfc9113_data_frame_and_padding" {
  let payload = "hello http2".to_bytes()
  let f = Frame::Data(1, payload, true)
  let wire = match encode_frame(f) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode DATA failed: " + h2_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(wire.length() == 9 + payload.length(), "DATA wire len")
  match decode_frame(wire, 0, default_max_frame_size) {
    Ok((Frame::Data(sid, data, es), next)) => {
      debug_assert(sid == 1, "DATA sid")
      debug_assert(es, "DATA end_stream")
      debug_assert(bytes_equal(data, payload), "DATA payload")
      debug_assert(next == wire.length(), "DATA consumed")
    }
    _ => debug_assert(false, "decode DATA failed")
  }

  // PADDED DATA frame: pad_len=3, data="abc", 3 pad bytes -> payload len 7
  let padded = bytes_from_hex("000007 00 08 00000003 03 616263 000000")
  match decode_frame(padded, 0, default_max_frame_size) {
    Ok((Frame::Data(sid, data, es), _)) => {
      debug_assert(sid == 3, "padded DATA sid")
      debug_assert(!es, "padded DATA not end_stream")
      debug_assert(data.to_string() == "abc", "padded DATA unpadded payload")
    }
    _ => debug_assert(false, "decode padded DATA failed")
  }

  // DATA on stream 0 -> ProtocolError
  let zero_sid = bytes_from_hex("000001 00 00 00000000 41")
  match decode_frame(zero_sid, 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "DATA on stream 0 must fail with ProtocolError")
  }
}

///|
test "rfc9113_headers_and_priority_and_continuation" {
  let frag = bytes_from_hex("828684")
  let prio = PrioritySpec::new(true, 3, 199)
  let f = Frame::Headers(5, frag, false, true, Some(prio))
  let wire = match encode_frame(f) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode HEADERS failed: " + h2_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_frame(wire, 0, default_max_frame_size) {
    Ok((Frame::Headers(sid, dec_frag, es, eh, dec_prio), next)) => {
      debug_assert(sid == 5, "HEADERS sid")
      debug_assert(!es, "HEADERS end_stream false")
      debug_assert(eh, "HEADERS end_headers true")
      debug_assert(bytes_equal(dec_frag, frag), "HEADERS frag")
      debug_assert(next == wire.length(), "HEADERS consumed")
      match dec_prio {
        Some(p) => {
          debug_assert(p.exclusive, "prio exclusive")
          debug_assert(p.dependency == 3, "prio dep")
          debug_assert(p.weight == 199, "prio weight")
        }
        None => debug_assert(false, "expected priority")
      }
    }
    _ => debug_assert(false, "decode HEADERS failed")
  }

  // PRIORITY frame
  let pf = Frame::Priority(7, PrioritySpec::new(false, 1, 15))
  let pwire = match encode_frame(pf) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(pwire, 0, default_max_frame_size) {
    Ok((Frame::Priority(sid, p), _)) => {
      debug_assert(sid == 7, "PRIORITY sid")
      debug_assert(!p.exclusive && p.dependency == 1 && p.weight == 15, "PRIORITY fields")
    }
    _ => debug_assert(false, "decode PRIORITY failed")
  }

  // PRIORITY wrong length (!= 5) -> FrameSizeError
  match decode_frame(bytes_from_hex("000004 02 00 00000007 00000001"), 0, default_max_frame_size) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "PRIORITY len != 5 must fail with FrameSizeError")
  }

  // PRIORITY self-dependency (stream 7 depends on 7) -> ProtocolError
  match decode_frame(bytes_from_hex("000005 02 00 00000007 00000007 0f"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "PRIORITY self-dependency must fail with ProtocolError")
  }

  // CONTINUATION frame
  let cf = Frame::Continuation(5, bytes_from_hex("8785"), true)
  let cwire = match encode_frame(cf) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(cwire, 0, default_max_frame_size) {
    Ok((Frame::Continuation(sid, cfrag, eh), _)) => {
      debug_assert(sid == 5 && eh && bytes_equal(cfrag, bytes_from_hex("8785")), "CONTINUATION roundtrip")
    }
    _ => debug_assert(false, "decode CONTINUATION failed")
  }
}

///|
test "rfc9113_settings_validation" {
  let settings = [
    Setting::new(setting_header_table_size, 8192L),
    Setting::new(setting_enable_push, 0L),
    Setting::new(setting_max_concurrent_streams, 256L),
    Setting::new(setting_initial_window_size, 131072L),
    Setting::new(setting_max_frame_size, 32768L),
    Setting::new(setting_max_header_list_size, 65536L),
  ]
  let wire = match encode_frame(Frame::Settings(settings, false)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(wire, 0, default_max_frame_size) {
    Ok((Frame::Settings(dec, ack), _)) => {
      debug_assert(!ack, "SETTINGS not ack")
      debug_assert(dec.length() == 6, "SETTINGS count 6")
      debug_assert(dec[0].id == setting_header_table_size && dec[0].value == 8192L, "setting 0")
      debug_assert(dec[4].id == setting_max_frame_size && dec[4].value == 32768L, "setting 4")
    }
    _ => debug_assert(false, "decode SETTINGS failed")
  }

  // SETTINGS ACK (0 length)
  let ack_wire = match encode_frame(Frame::Settings([], true)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(ack_wire, 0, default_max_frame_size) {
    Ok((Frame::Settings(dec, ack), _)) => debug_assert(ack && dec.length() == 0, "SETTINGS ACK")
    _ => debug_assert(false, "decode SETTINGS ACK failed")
  }

  // SETTINGS ACK with non-zero length -> FrameSizeError
  match decode_frame(bytes_from_hex("000006 04 01 00000000 0001 00001000"), 0, default_max_frame_size) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "SETTINGS ACK non-zero length must fail")
  }

  // SETTINGS length not multiple of 6 -> FrameSizeError
  match decode_frame(bytes_from_hex("000005 04 00 00000000 0001 000010"), 0, default_max_frame_size) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "SETTINGS non-6-multiple must fail")
  }

  // SETTINGS stream_id != 0 -> ProtocolError
  match decode_frame(bytes_from_hex("000000 04 00 00000001"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "SETTINGS stream_id != 0 must fail")
  }

  // SETTINGS INITIAL_WINDOW_SIZE > 2^31 - 1 (0x80000000) -> FlowControlError
  match decode_frame(bytes_from_hex("000006 04 00 00000000 0004 80000000"), 0, default_max_frame_size) {
    Err(H2Error::FlowControlError(_)) => ()
    _ => debug_assert(false, "SETTINGS INITIAL_WINDOW_SIZE > 2^31-1 must fail with FlowControlError")
  }

  // SETTINGS MAX_FRAME_SIZE < 16384 (16383 = 0x3FFF) -> ProtocolError
  match decode_frame(bytes_from_hex("000006 04 00 00000000 0005 00003fff"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "SETTINGS MAX_FRAME_SIZE < 16384 must fail")
  }

  // SETTINGS MAX_FRAME_SIZE > 16777215 (0x01000000) -> ProtocolError
  match decode_frame(bytes_from_hex("000006 04 00 00000000 0005 01000000"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "SETTINGS MAX_FRAME_SIZE > 16777215 must fail")
  }

  // SETTINGS ENABLE_PUSH = 2 -> ProtocolError
  match decode_frame(bytes_from_hex("000006 04 00 00000000 0002 00000002"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "SETTINGS ENABLE_PUSH=2 must fail")
  }
}

///|
test "rfc9113_ping_goaway_window_update_rst_push_unknown" {
  // PING 8 bytes + ACK
  let opaque = bytes_from_hex("0102030405060708")
  let pwire = match encode_frame(Frame::Ping(opaque, true)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(pwire, 0, default_max_frame_size) {
    Ok((Frame::Ping(d, ack), _)) => debug_assert(ack && bytes_equal(d, opaque), "PING roundtrip")
    _ => debug_assert(false, "PING decode failed")
  }
  // PING wrong length or stream_id != 0
  match decode_frame(bytes_from_hex("000007 06 00 00000000 01020304050607"), 0, default_max_frame_size) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "PING len != 8 must fail")
  }
  match decode_frame(bytes_from_hex("000008 06 00 00000001 0102030405060708"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "PING stream_id != 0 must fail")
  }

  // GOAWAY: masks reserved MSB of last_stream_id
  let goaway_raw = bytes_from_hex("00000c 07 00 00000000 80000009 0000000b 62796521")
  match decode_frame(goaway_raw, 0, default_max_frame_size) {
    Ok((Frame::GoAway(last_id, code, dbg), _)) => {
      debug_assert(last_id == 9, "GOAWAY last_stream_id MSB cleared")
      debug_assert(code == err_enhance_your_calm, "GOAWAY error code")
      debug_assert(dbg.to_string() == "bye!", "GOAWAY debug data")
    }
    _ => debug_assert(false, "GOAWAY decode failed")
  }
  match decode_frame(bytes_from_hex("000007 07 00 00000000 00000001 000000"), 0, default_max_frame_size) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "GOAWAY len < 8 must fail")
  }

  // WINDOW_UPDATE: 4 bytes, increment 1..2^31-1, reject 0
  let wu_wire = match encode_frame(Frame::WindowUpdate(0, 65536)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(wu_wire, 0, default_max_frame_size) {
    Ok((Frame::WindowUpdate(sid, inc), _)) => debug_assert(sid == 0 && inc == 65536, "WINDOW_UPDATE roundtrip")
    _ => debug_assert(false, "WINDOW_UPDATE decode failed")
  }
  // Increment == 0 (even with reserved MSB set 0x80000000) -> ProtocolError
  match decode_frame(bytes_from_hex("000004 08 00 00000000 80000000"), 0, default_max_frame_size) {
    Err(H2Error::ProtocolError(_)) => ()
    _ => debug_assert(false, "WINDOW_UPDATE increment 0 must fail")
  }

  // RST_STREAM
  let rst_wire = match encode_frame(Frame::RstStream(3, err_cancel)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(rst_wire, 0, default_max_frame_size) {
    Ok((Frame::RstStream(sid, code), _)) => debug_assert(sid == 3 && code == err_cancel, "RST_STREAM roundtrip")
    _ => debug_assert(false, "RST_STREAM decode failed")
  }

  // PUSH_PROMISE
  let pp_wire = match encode_frame(Frame::PushPromise(1, 2, bytes_from_hex("8286"), true)) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match decode_frame(pp_wire, 0, default_max_frame_size) {
    Ok((Frame::PushPromise(sid, pid, frag, eh), _)) => {
      debug_assert(sid == 1 && pid == 2 && eh && bytes_equal(frag, bytes_from_hex("8286")), "PUSH_PROMISE roundtrip")
    }
    _ => debug_assert(false, "PUSH_PROMISE decode failed")
  }

  // Unknown extension frame (type 0x42) passthrough
  let ext_raw = bytes_from_hex("000004 42 03 00000005 deadbeef")
  match decode_frame(ext_raw, 0, default_max_frame_size) {
    Ok((Frame::Unknown(hdr, body), _)) => {
      debug_assert(hdr.frame_type == 0x42 && hdr.flags == 0x03 && hdr.stream_id == 5, "Unknown header")
      debug_assert(bytes_equal(body, bytes_from_hex("deadbeef")), "Unknown body")
    }
    _ => debug_assert(false, "Unknown extension frame must pass through")
  }

  // Exceeding max_frame_size -> FrameSizeError
  match decode_frame(bytes_from_hex("004001 00 00 00000001"), 0, 16384) {
    Err(H2Error::FrameSizeError(_)) => ()
    _ => debug_assert(false, "length > max_frame_size must fail with FrameSizeError")
  }
}
