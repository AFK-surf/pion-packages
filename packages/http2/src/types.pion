///| Core RFC 9113 HTTP/2 & RFC 7541 HPACK types, constants, limits, and errors.

// ---------------------------------------------------------------------------
// HTTP/2 Protocol Constants (RFC 9113)
// ---------------------------------------------------------------------------

///| HTTP/2 client connection preface string (24 bytes).
pub let client_preface : String = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

///| HTTP/2 client connection preface as Bytes (24 bytes).
pub fn client_preface_bytes() -> Bytes {
  client_preface.to_bytes()
}

///| Frame Types (RFC 9113 §6)
pub let frame_data : Int = 0x0
pub let frame_headers : Int = 0x1
pub let frame_priority : Int = 0x2
pub let frame_rst_stream : Int = 0x3
pub let frame_settings : Int = 0x4
pub let frame_push_promise : Int = 0x5
pub let frame_ping : Int = 0x6
pub let frame_goaway : Int = 0x7
pub let frame_window_update : Int = 0x8
pub let frame_continuation : Int = 0x9

///| Frame Flags (RFC 9113 §6)
pub let flag_end_stream : Int = 0x01
pub let flag_ack : Int = 0x01
pub let flag_end_headers : Int = 0x04
pub let flag_padded : Int = 0x08
pub let flag_priority : Int = 0x20

///| HTTP/2 Error Codes (RFC 9113 §7)
pub let err_no_error : Int = 0x0
pub let err_protocol_error : Int = 0x1
pub let err_internal_error : Int = 0x2
pub let err_flow_control_error : Int = 0x3
pub let err_settings_timeout : Int = 0x4
pub let err_stream_closed : Int = 0x5
pub let err_frame_size_error : Int = 0x6
pub let err_refused_stream : Int = 0x7
pub let err_cancel : Int = 0x8
pub let err_compression_error : Int = 0x9
pub let err_connect_error : Int = 0xa
pub let err_enhance_your_calm : Int = 0xb
pub let err_inadequate_security : Int = 0xc
pub let err_http_1_1_required : Int = 0xd

///| HTTP/2 Settings Identifiers (RFC 9113 §6.5.2)
pub let setting_header_table_size : Int = 0x1
pub let setting_enable_push : Int = 0x2
pub let setting_max_concurrent_streams : Int = 0x3
pub let setting_initial_window_size : Int = 0x4
pub let setting_max_frame_size : Int = 0x5
pub let setting_max_header_list_size : Int = 0x6

///| Default Protocol Limits (RFC 9113)
pub let default_header_table_size : Int = 4096
pub let default_initial_window_size : Int = 65535
pub let default_max_frame_size : Int = 16384
pub let max_frame_size_upper : Int = 16777215
pub let max_window_size : Int = 2147483647
pub let max_stream_id : Int = 2147483647

// ---------------------------------------------------------------------------
// Error Type
// ---------------------------------------------------------------------------

///|
pub enum H2Error {
  ProtocolError(String)
  FrameSizeError(String)
  FlowControlError(String)
  CompressionError(String)
  StreamClosed(Int)
  EnhanceYourCalm(String)
  InvalidHeader(String)
  InvalidPreface
  Incomplete
}

///| Map an H2Error to its RFC 9113 §7 HTTP/2 error code.
pub fn h2_error_code(err : H2Error) -> Int {
  match err {
    H2Error::ProtocolError(_) => err_protocol_error
    H2Error::FrameSizeError(_) => err_frame_size_error
    H2Error::FlowControlError(_) => err_flow_control_error
    H2Error::CompressionError(_) => err_compression_error
    H2Error::StreamClosed(_) => err_stream_closed
    H2Error::EnhanceYourCalm(_) => err_enhance_your_calm
    H2Error::InvalidHeader(_) => err_protocol_error
    H2Error::InvalidPreface => err_protocol_error
    H2Error::Incomplete => err_no_error
  }
}

///| Human-readable description for an H2Error.
pub fn h2_error_message(err : H2Error) -> String {
  match err {
    H2Error::ProtocolError(msg) => "http2: protocol error: " + msg
    H2Error::FrameSizeError(msg) => "http2: frame size error: " + msg
    H2Error::FlowControlError(msg) => "http2: flow control error: " + msg
    H2Error::CompressionError(msg) => "http2: compression error: " + msg
    H2Error::StreamClosed(sid) => "http2: stream closed: " + sid.to_string()
    H2Error::EnhanceYourCalm(msg) => "http2: enhance your calm: " + msg
    H2Error::InvalidHeader(msg) => "http2: invalid header: " + msg
    H2Error::InvalidPreface => "http2: invalid client connection preface"
    H2Error::Incomplete => "http2: incomplete frame or buffer"
  }
}

// ---------------------------------------------------------------------------
// Core Value Types
// ---------------------------------------------------------------------------

///| An HTTP/2 header field (name, value, and HPACK never-indexed sensitivity flag).
pub val struct HeaderField {
  pub name : String
  pub value : String
  pub sensitive : Bool
}

///|
pub fn HeaderField::new(name : String, value : String) -> HeaderField {
  HeaderField::{ name: name, value: value, sensitive: false }
}

///|
pub fn HeaderField::sensitive(name : String, value : String) -> HeaderField {
  HeaderField::{ name: name, value: value, sensitive: true }
}

///| RFC 7541 §4.1 entry size: name bytes + value bytes + 32.
pub fn HeaderField::size(self : HeaderField) -> Int {
  self.name.to_bytes().length() + self.value.to_bytes().length() + 32
}

///| 9-byte HTTP/2 Frame Header (RFC 9113 §4.1).
pub val struct FrameHeader {
  pub length : Int
  pub frame_type : Int
  pub flags : Int
  pub stream_id : Int
}

///|
pub fn FrameHeader::new(
  length : Int,
  frame_type : Int,
  flags : Int,
  stream_id : Int,
) -> FrameHeader {
  FrameHeader::{
    length: length,
    frame_type: frame_type,
    flags: flags,
    stream_id: stream_id,
  }
}

///| Priority specification carried by PRIORITY and HEADERS frames.
pub val struct PrioritySpec {
  pub exclusive : Bool
  pub dependency : Int
  pub weight : Int
}

///|
pub fn PrioritySpec::new(
  exclusive : Bool,
  dependency : Int,
  weight : Int,
) -> PrioritySpec {
  PrioritySpec::{
    exclusive: exclusive,
    dependency: dependency,
    weight: weight,
  }
}

///| A single 6-byte SETTINGS parameter (RFC 9113 §6.5.1).
pub val struct Setting {
  pub id : Int
  pub value : Int64
}

///|
pub fn Setting::new(id : Int, value : Int64) -> Setting {
  Setting::{ id: id, value: value }
}

///| Decoded RFC 9113 HTTP/2 Frame.
pub enum Frame {
  Data(Int, Bytes, Bool)
  Headers(Int, Bytes, Bool, Bool, Option[PrioritySpec])
  Priority(Int, PrioritySpec)
  RstStream(Int, Int)
  Settings(Array[Setting], Bool)
  PushPromise(Int, Int, Bytes, Bool)
  Ping(Bytes, Bool)
  GoAway(Int, Int, Bytes)
  WindowUpdate(Int, Int)
  Continuation(Int, Bytes, Bool)
  Unknown(FrameHeader, Bytes)
}

///| RFC 9113 §5.1 Stream States.
pub enum StreamState {
  Idle
  ReservedLocal
  ReservedRemote
  Open
  HalfClosedLocal
  HalfClosedRemote
  Closed
}

///|
pub fn stream_state_eq(a : StreamState, b : StreamState) -> Bool {
  match (a, b) {
    (StreamState::Idle, StreamState::Idle) => true
    (StreamState::ReservedLocal, StreamState::ReservedLocal) => true
    (StreamState::ReservedRemote, StreamState::ReservedRemote) => true
    (StreamState::Open, StreamState::Open) => true
    (StreamState::HalfClosedLocal, StreamState::HalfClosedLocal) => true
    (StreamState::HalfClosedRemote, StreamState::HalfClosedRemote) => true
    (StreamState::Closed, StreamState::Closed) => true
    _ => false
  }
}

///| Sans-IO HTTP/2 Connection configuration & security limits.
pub val struct ConnectionConfig {
  pub is_server : Bool
  pub max_frame_size : Int
  pub max_header_list_size : Int
  pub max_dynamic_table_size : Int
  pub initial_window_size : Int
  pub max_concurrent_streams : Int
  pub max_rapid_resets : Int
  pub max_continuation_frames : Int
  pub validate_headers : Bool
}

///|
pub fn ConnectionConfig::server() -> ConnectionConfig {
  ConnectionConfig::{
    is_server: true,
    max_frame_size: default_max_frame_size,
    max_header_list_size: 65536,
    max_dynamic_table_size: default_header_table_size,
    initial_window_size: default_initial_window_size,
    max_concurrent_streams: 100,
    max_rapid_resets: 100,
    max_continuation_frames: 8,
    validate_headers: true,
  }
}

///|
pub fn ConnectionConfig::client() -> ConnectionConfig {
  ConnectionConfig::{
    is_server: false,
    max_frame_size: default_max_frame_size,
    max_header_list_size: 65536,
    max_dynamic_table_size: default_header_table_size,
    initial_window_size: default_initial_window_size,
    max_concurrent_streams: 100,
    max_rapid_resets: 100,
    max_continuation_frames: 8,
    validate_headers: true,
  }
}

///|
pub fn ConnectionConfig::default() -> ConnectionConfig {
  ConnectionConfig::server()
}

///| High-level events produced by the Sans-IO HTTP/2 Connection state machine.
pub enum ConnectionEvent {
  Headers(Int, Array[HeaderField], Bool)
  Data(Int, Bytes, Bool)
  RstStream(Int, Int)
  Settings(Array[Setting], Bool)
  Ping(Bytes, Bool)
  GoAway(Int, Int, Bytes)
  WindowUpdate(Int, Int)
  PushPromise(Int, Int, Array[HeaderField])
  Priority(Int, PrioritySpec)
  UnknownFrame(FrameHeader, Bytes)
}

///| Utility: byte-for-byte equality on Bytes.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}
