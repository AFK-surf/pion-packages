///| RFC 7541 Appendix B Canonical Huffman Codec (256 symbols + EOS)
///| using a precomputed 4-bit nibble DFA (256 states x 16 transitions = 4096 entries).

///|
let huff_codes : Array[Int64] = [
  0x1ff8L, 0x7fffd8L, 0xfffffe2L, 0xfffffe3L, 0xfffffe4L, 0xfffffe5L, 0xfffffe6L,
  0xfffffe7L, 0xfffffe8L, 0xffffeaL, 0x3ffffffcL, 0xfffffe9L, 0xfffffeaL, 0x3ffffffdL,
  0xfffffebL, 0xfffffecL, 0xfffffedL, 0xfffffeeL, 0xfffffefL, 0xffffff0L, 0xffffff1L,
  0xffffff2L, 0x3ffffffeL, 0xffffff3L, 0xffffff4L, 0xffffff5L, 0xffffff6L, 0xffffff7L,
  0xffffff8L, 0xffffff9L, 0xffffffaL, 0xffffffbL, 0x14L, 0x3f8L, 0x3f9L, 0xffaL,
  0x1ff9L, 0x15L, 0xf8L, 0x7faL, 0x3faL, 0x3fbL, 0xf9L, 0x7fbL, 0xfaL, 0x16L,
  0x17L, 0x18L, 0x0L, 0x1L, 0x2L, 0x19L, 0x1aL, 0x1bL, 0x1cL, 0x1dL, 0x1eL, 0x1fL,
  0x5cL, 0xfbL, 0x7ffcL, 0x20L, 0xffbL, 0x3fcL, 0x1ffaL, 0x21L, 0x5dL, 0x5eL,
  0x5fL, 0x60L, 0x61L, 0x62L, 0x63L, 0x64L, 0x65L, 0x66L, 0x67L, 0x68L, 0x69L,
  0x6aL, 0x6bL, 0x6cL, 0x6dL, 0x6eL, 0x6fL, 0x70L, 0x71L, 0x72L, 0xfcL, 0x73L,
  0xfdL, 0x1ffbL, 0x7fff0L, 0x1ffcL, 0x3ffcL, 0x22L, 0x7ffdL, 0x3L, 0x23L, 0x4L,
  0x24L, 0x5L, 0x25L, 0x26L, 0x27L, 0x6L, 0x74L, 0x75L, 0x28L, 0x29L, 0x2aL, 0x7L,
  0x2bL, 0x76L, 0x2cL, 0x8L, 0x9L, 0x2dL, 0x77L, 0x78L, 0x79L, 0x7aL, 0x7bL, 0x7ffeL,
  0x7fcL, 0x3ffdL, 0x1ffdL, 0xffffffcL, 0xfffe6L, 0x3fffd2L, 0xfffe7L, 0xfffe8L,
  0x3fffd3L, 0x3fffd4L, 0x3fffd5L, 0x7fffd9L, 0x3fffd6L, 0x7fffdaL, 0x7fffdbL,
  0x7fffdcL, 0x7fffddL, 0x7fffdeL, 0xffffebL, 0x7fffdfL, 0xffffecL, 0xffffedL,
  0x3fffd7L, 0x7fffe0L, 0xffffeeL, 0x7fffe1L, 0x7fffe2L, 0x7fffe3L, 0x7fffe4L,
  0x1fffdcL, 0x3fffd8L, 0x7fffe5L, 0x3fffd9L, 0x7fffe6L, 0x7fffe7L, 0xffffefL,
  0x3fffdaL, 0x1fffddL, 0xfffe9L, 0x3fffdbL, 0x3fffdcL, 0x7fffe8L, 0x7fffe9L,
  0x1fffdeL, 0x7fffeaL, 0x3fffddL, 0x3fffdeL, 0xfffff0L, 0x1fffdfL, 0x3fffdfL,
  0x7fffebL, 0x7fffecL, 0x1fffe0L, 0x1fffe1L, 0x3fffe0L, 0x1fffe2L, 0x7fffedL,
  0x3fffe1L, 0x7fffeeL, 0x7fffefL, 0xfffeaL, 0x3fffe2L, 0x3fffe3L, 0x3fffe4L,
  0x7ffff0L, 0x3fffe5L, 0x3fffe6L, 0x7ffff1L, 0x3ffffe0L, 0x3ffffe1L, 0xfffebL,
  0x7fff1L, 0x3fffe7L, 0x7ffff2L, 0x3fffe8L, 0x1ffffecL, 0x3ffffe2L, 0x3ffffe3L,
  0x3ffffe4L, 0x7ffffdeL, 0x7ffffdfL, 0x3ffffe5L, 0xfffff1L, 0x1ffffedL, 0x7fff2L,
  0x1fffe3L, 0x3ffffe6L, 0x7ffffe0L, 0x7ffffe1L, 0x3ffffe7L, 0x7ffffe2L, 0xfffff2L,
  0x1fffe4L, 0x1fffe5L, 0x3ffffe8L, 0x3ffffe9L, 0xffffffdL, 0x7ffffe3L, 0x7ffffe4L,
