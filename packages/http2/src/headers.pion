///| RFC 9113 §8.2 & §8.3 HTTP/2 Header Field Semantics Validation.

///| Check if a byte is a valid RFC 9110 tchar EXCEPT uppercase A-Z (HTTP/2 requires lowercase).
fn is_valid_h2_name_byte(b : Int) -> Bool {
  if b >= 97 && b <= 122 {
    return true // a-z
  }
  if b >= 48 && b <= 57 {
    return true // 0-9
  }
  b == 45 || // '-'
  b == 95 || // '_'
  b == 46 || // '.'
  b == 33 || // '!'
  b == 35 || // '#'
  b == 36 || // '$'
  b == 37 || // '%'
  b == 38 || // '&'
  b == 39 || // '\''
  b == 42 || // '*'
  b == 43 || // '+'
  b == 94 || // '^'
  b == 96 || // '`'
  b == 124 || // '|'
  b == 126 // '~'
}

///| Validate an HTTP/2 regular header name (non-empty, lowercase tchar, not forbidden).
fn validate_regular_name(name : String) -> Result[Unit, H2Error] {
  let n = name.length()
  if n == 0 {
    return Err(H2Error::InvalidHeader("empty header name"))
  }
  let mut i = 0
  while i < n {
    let ch = name.code_unit_at(i)
    if ch >= 65 && ch <= 90 {
      return Err(H2Error::InvalidHeader("uppercase character in HTTP/2 header name"))
    }
    if !is_valid_h2_name_byte(ch) {
      return Err(H2Error::InvalidHeader("invalid character in HTTP/2 header name"))
    }
    i = i + 1
  }
  // Forbidden connection-specific headers (RFC 9113 §8.2.2)
  if name == "connection" ||
  name == "keep-alive" ||
  name == "proxy-connection" ||
  name == "transfer-encoding" ||
  name == "upgrade" {
    return Err(H2Error::InvalidHeader("forbidden connection-specific header: " + name))
  }
  Ok(())
}

///| Validate an HTTP/2 header value (RFC 9110 §5.5 & RFC 9113 §8.2.1):
///| forbids CTL bytes (0x00..0x08, 0x0A..0x1F, 0x7F) and leading/trailing SP/HTAB.
fn validate_header_value(value : String) -> Result[Unit, H2Error] {
  let n = value.length()
  if n > 0 {
    let first = value.code_unit_at(0)
    let last = value.code_unit_at(n - 1)
    if first == 32 || first == 9 || last == 32 || last == 9 {
      return Err(H2Error::InvalidHeader("leading or trailing whitespace in HTTP/2 header value"))
    }
  }
  let mut i = 0
  while i < n {
    let ch = value.code_unit_at(i)
    if (ch < 32 && ch != 9) || ch == 127 {
      return Err(H2Error::InvalidHeader("CTL byte forbidden in HTTP/2 header value"))
    }
    i = i + 1
  }
  Ok(())
}

///| Parse a strict RFC 9110 content-length value (1+ ASCII digits, non-negative Int64).
fn parse_content_length_value(value : String) -> Result[Int64, H2Error] {
  let n = value.length()
  if n == 0 {
    return Err(H2Error::InvalidHeader("empty content-length"))
  }
  let mut acc = 0L
  let mut i = 0
  while i < n {
    let ch = value.code_unit_at(i)
    if ch < 48 || ch > 57 {
      return Err(H2Error::InvalidHeader("non-numeric content-length"))
    }
    let d = (ch - 48).to_int64()
    if acc > (0x7FFFFFFFFFFFFFFFL - d) / 10L {
      return Err(H2Error::InvalidHeader("content-length overflow"))
    }
    acc = acc * 10L + d
    i = i + 1
  }
  Ok(acc)
}

///| Extract validated content-length from an already-validated header list (-1 if absent).
fn extract_content_length(headers : Array[HeaderField]) -> Int64 {
  let n = headers.length()
  let mut i = 0
  while i < n {
    if headers[i].name == "content-length" {
      match parse_content_length_value(headers[i].value) {
        Ok(v) => return v
        Err(_) => return -1L
      }
    }
    i = i + 1
  }
  -1L
}

///| Validate HTTP/2 request headers (RFC 9113 §8.2 & §8.3.1, RFC 8441 §4).
pub fn validate_request_headers(
  headers : Array[HeaderField],
) -> Result[Unit, H2Error] {
  let mut seen_regular = false
  let mut seen_method = false
  let mut seen_scheme = false
  let mut seen_authority = false
  let mut seen_path = false
  let mut seen_protocol = false
  let mut is_connect = false
  let mut method_val = ""
  let mut scheme_val = ""
  let mut path_val = ""
  let mut has_cl = false
  let mut cl_val = 0L

  let n = headers.length()
  let mut i = 0
  while i < n {
    let h = headers[i]
    let name = h.name
    let value = h.value
    match validate_header_value(value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if name.length() == 0 {
      return Err(H2Error::InvalidHeader("empty header name"))
    }
    if name.code_unit_at(0) == 58 {
      // Pseudo-header
      if seen_regular {
        return Err(H2Error::InvalidHeader("pseudo-header after regular header"))
      }
      if name == ":method" {
        if seen_method {
          return Err(H2Error::InvalidHeader("duplicate :method pseudo-header"))
        }
        if value.length() == 0 {
          return Err(H2Error::InvalidHeader("empty :method"))
        }
        seen_method = true
        method_val = value
        if value == "CONNECT" {
          is_connect = true
        }
      } else if name == ":scheme" {
        if seen_scheme {
          return Err(H2Error::InvalidHeader("duplicate :scheme pseudo-header"))
        }
        if value.length() == 0 {
          return Err(H2Error::InvalidHeader("empty :scheme"))
        }
        seen_scheme = true
        scheme_val = value
      } else if name == ":authority" {
        if seen_authority {
          return Err(H2Error::InvalidHeader("duplicate :authority pseudo-header"))
        }
        seen_authority = true
      } else if name == ":path" {
        if seen_path {
          return Err(H2Error::InvalidHeader("duplicate :path pseudo-header"))
        }
        if value.length() == 0 {
          return Err(H2Error::InvalidHeader("empty :path"))
        }
        seen_path = true
        path_val = value
      } else if name == ":protocol" {
        if seen_protocol {
          return Err(H2Error::InvalidHeader("duplicate :protocol pseudo-header"))
        }
        if value.length() == 0 {
          return Err(H2Error::InvalidHeader("empty :protocol"))
        }
        seen_protocol = true
      } else {
        return Err(H2Error::InvalidHeader("invalid request pseudo-header: " + name))
      }
    } else {
      seen_regular = true
      match validate_regular_name(name) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if name == "te" && value != "trailers" {
        return Err(H2Error::InvalidHeader("TE header in HTTP/2 may only be 'trailers'"))
      }
      if name == "content-length" {
        let parsed = match parse_content_length_value(value) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if has_cl && parsed != cl_val {
          return Err(H2Error::InvalidHeader("conflicting content-length values"))
        }
        has_cl = true
        cl_val = parsed
      }
    }
    i = i + 1
  }

  if !seen_method {
    return Err(H2Error::InvalidHeader("missing required :method pseudo-header"))
  }
  if seen_protocol && !is_connect {
    return Err(H2Error::InvalidHeader(":protocol pseudo-header is only valid for CONNECT"))
  }
  if is_connect && !seen_protocol {
    if !seen_authority || seen_scheme || seen_path {
      return Err(
        H2Error::InvalidHeader(
          "CONNECT request requires :authority and forbids :scheme/:path",
        ),
      )
    }
  } else {
    if !seen_scheme || !seen_path {
      return Err(H2Error::InvalidHeader("missing required :scheme or :path pseudo-header"))
    }
    if is_connect && seen_protocol && !seen_authority {
      return Err(H2Error::InvalidHeader("extended CONNECT requires :authority"))
    }
    // RFC 9113 §8.3.1: for http/https, :path must be origin-form ('/'..., not '//'...) or '*' for OPTIONS
    if scheme_val == "http" || scheme_val == "https" {
      if path_val == "*" {
        if method_val != "OPTIONS" {
          return Err(H2Error::InvalidHeader(":path '*' is only valid for OPTIONS"))
        }
      } else {
        if path_val.code_unit_at(0) != 47 {
          return Err(H2Error::InvalidHeader(":path must be origin-form starting with '/'"))
        }
        if path_val.length() >= 2 && path_val.code_unit_at(1) == 47 {
          return Err(H2Error::InvalidHeader(":path must not start with '//'"))
        }
      }
    }
  }
  Ok(())
}

///| Validate HTTP/2 response headers (RFC 9113 §8.2 & §8.3.2).
pub fn validate_response_headers(
  headers : Array[HeaderField],
) -> Result[Unit, H2Error] {
  let mut seen_regular = false
  let mut seen_status = false
  let mut has_cl = false
  let mut cl_val = 0L

  let n = headers.length()
  let mut i = 0
  while i < n {
    let h = headers[i]
    let name = h.name
    let value = h.value
    match validate_header_value(value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if name.length() == 0 {
      return Err(H2Error::InvalidHeader("empty header name"))
    }
    if name.code_unit_at(0) == 58 {
      if seen_regular {
        return Err(H2Error::InvalidHeader("pseudo-header after regular header"))
      }
      if name == ":status" {
        if seen_status {
          return Err(H2Error::InvalidHeader("duplicate :status pseudo-header"))
        }
        if value.length() != 3 {
          return Err(H2Error::InvalidHeader(":status must be 3 ASCII digits"))
        }
        let d0 = value.code_unit_at(0)
        let d1 = value.code_unit_at(1)
        let d2 = value.code_unit_at(2)
        if d0 < 48 || d0 > 57 || d1 < 48 || d1 > 57 || d2 < 48 || d2 > 57 {
          return Err(H2Error::InvalidHeader(":status must be 3 ASCII digits"))
        }
        seen_status = true
      } else {
        return Err(H2Error::InvalidHeader("invalid response pseudo-header: " + name))
      }
    } else {
      seen_regular = true
      match validate_regular_name(name) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if name == "te" && value != "trailers" {
        return Err(H2Error::InvalidHeader("TE header in HTTP/2 may only be 'trailers'"))
      }
      if name == "content-length" {
        let parsed = match parse_content_length_value(value) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if has_cl && parsed != cl_val {
          return Err(H2Error::InvalidHeader("conflicting content-length values"))
        }
        has_cl = true
        cl_val = parsed
      }
    }
    i = i + 1
  }

  if !seen_status {
    return Err(H2Error::InvalidHeader("missing required :status pseudo-header"))
  }
  Ok(())
}

///| Validate HTTP/2 trailer headers (RFC 9113 §8.1: no pseudo-headers allowed).
pub fn validate_trailers(headers : Array[HeaderField]) -> Result[Unit, H2Error] {
  let n = headers.length()
  let mut i = 0
  while i < n {
    let h = headers[i]
    match validate_header_value(h.value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if h.name.length() == 0 || h.name.code_unit_at(0) == 58 {
      return Err(H2Error::InvalidHeader("pseudo-headers forbidden in trailers"))
    }
    match validate_regular_name(h.name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if h.name == "te" && h.value != "trailers" {
      return Err(H2Error::InvalidHeader("TE header in HTTP/2 may only be 'trailers'"))
    }
    i = i + 1
  }
  Ok(())
}
