  "transfer-encoding",
  "user-agent",
  "vary",
  "via",
  "www-authenticate",
]

///|
let static_values : Array[String] = [
  "",
  "",
  "GET",
  "POST",
  "/",
  "/index.html",
  "http",
  "https",
  "200",
  "204",
  "206",
