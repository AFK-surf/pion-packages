///|
let static_table_len : Int = 61

///| Fast O(1) sampled FNV-1a hash (at most 5 bytes hashed; exact equality verifies matches).
fn str_hash(s : String) -> Int {
  let n = s.length()
  let mut h = 216613626 ^ n
  if n <= 5 {
    let mut i = 0
    while i < n {
      h = (h ^ s.code_unit_at(i)) * 16777619
      i = i + 1
    }
    return h & 0x7FFFFFFF
  }
  let m = n >> 1
  h = (h ^ s.code_unit_at(0)) * 16777619
  h = (h ^ s.code_unit_at(m - 1)) * 16777619
  h = (h ^ s.code_unit_at(m)) * 16777619
  h = (h ^ s.code_unit_at(m + 1)) * 16777619
  h = (h ^ s.code_unit_at(n - 1)) * 16777619
  h & 0x7FFFFFFF
}

///|
struct StaticTables {
  names : FixedArray[String]
  values : FixedArray[String]
  name_lens : FixedArray[Int]
  entry_sizes : FixedArray[Int]
  name_hashes : FixedArray[Int]
  first_lo : FixedArray[Int]
  first_hi : FixedArray[Int]
}

///|
fn build_static_tables() -> StaticTables {
  let names : FixedArray[String] = FixedArray::make(62, "")
  let values : FixedArray[String] = FixedArray::make(62, "")
  let name_lens : FixedArray[Int] = FixedArray::make(62, 0)
  let entry_sizes : FixedArray[Int] = FixedArray::make(62, 0)
  let name_hashes : FixedArray[Int] = FixedArray::make(62, 0)
  let first_lo : FixedArray[Int] = FixedArray::make(128, 0)
  let first_hi : FixedArray[Int] = FixedArray::make(128, -1)
  let mut i = 0
  while i <= 61 {
    let nm = static_names[i]
    let vl = static_values[i]
    names[i] = nm
    values[i] = vl
    name_lens[i] = nm.length()
    entry_sizes[i] = nm.length() + vl.length() + 32
    name_hashes[i] = str_hash(nm)
    if i >= 15 {
      let c0 = nm.code_unit_at(0)
      if first_lo[c0] == 0 {
        first_lo[c0] = i
      }
      first_hi[c0] = i
    }
    i = i + 1
  }
  StaticTables::{
    names: names,
    values: values,
    name_lens: name_lens,
    entry_sizes: entry_sizes,
    name_hashes: name_hashes,
    first_lo: first_lo,
    first_hi: first_hi,
  }
}

///|
let static_tbl : StaticTables = build_static_tables()

///| Look up an entry in the RFC 7541 static table (1..=61).
pub fn static_table_get(index : Int) -> Option[HeaderField] {
  if index < 1 || index > static_table_len {
    return None
  }
  Some(HeaderField::new(static_tbl.names[index], static_tbl.values[index]))
}

///| Zero-allocation static table lookup returning packed Int:
///|   0            = not found
///|   idx (1..61)  = name-only match
///|   idx | 0x100  = exact (name, value) match
fn static_table_find_packed(
  name : String,
  value : String,
  snames : FixedArray[String],
  slens : FixedArray[Int],
  slo : FixedArray[Int],
  shi : FixedArray[Int],
) -> Int {
  let nlen = name.length()
  if nlen == 0 {
    return 0
  }
  let c0 = name.code_unit_at(0)
  if c0 == 58 {
    // ':' pseudo-headers (indices 1..14)
    if nlen < 5 {
      return 0
    }
    let c1 = name.code_unit_at(1)
    if c1 == 109 {
      if nlen == 7 && name == ":method" {
        if value == "GET" {
          return 2 | 0x100
        }
        if value == "POST" {
          return 3 | 0x100
        }
        return 2
      }
      return 0
    }
    if c1 == 112 {
      if nlen == 5 && name == ":path" {
        if value == "/" {
          return 4 | 0x100
        }
        if value == "/index.html" {
          return 5 | 0x100
        }
        return 4
      }
      return 0
    }
    if c1 == 115 {
      if nlen == 7 {
        if name == ":scheme" {
          if value == "https" {
            return 7 | 0x100
          }
          if value == "http" {
            return 6 | 0x100
          }
          return 6
        }
        if name == ":status" {
          if value.length() == 3 {
            if value == "200" {
              return 8 | 0x100
            }
            if value == "304" {
              return 11 | 0x100
            }
            if value == "204" {
              return 9 | 0x100
            }
            if value == "206" {
              return 10 | 0x100
            }
            if value == "400" {
              return 12 | 0x100
            }
            if value == "404" {
              return 13 | 0x100
            }
            if value == "500" {
              return 14 | 0x100
            }
          }
          return 8
        }
      }
      return 0
    }
    if c1 == 97 {
      if nlen == 10 && name == ":authority" {
        if value.length() == 0 {
          return 1 | 0x100
        }
        return 1
      }
      return 0
    }
    return 0
  }
  if c0 >= 128 {
    return 0
  }
  let lo = slo[c0]
  if lo == 0 {
    return 0
  }
  let hi = shi[c0]
  let mut i = lo
  while i <= hi {
    if slens[i] == nlen && snames[i] == name {
      if i == 16 {
        if value == "gzip, deflate" {
          return 16 | 0x100
        }
        return 16
      }
      if value.length() == 0 {
        return i | 0x100
      }
      return i
    }
    i = i + 1
  }
  0
}

// ---------------------------------------------------------------------------
// Growable Byte Buffer (Bytes-backed for C memcpy to_bytes via slice)
// ---------------------------------------------------------------------------

///|
struct ByteBuf {
  mut data : Bytes
  mut cap : Int
  mut len : Int
}

///|
fn ByteBuf::new(cap : Int) -> ByteBuf {
  let c = if cap < 32 { 32 } else { cap }
  ByteBuf::{ data: Bytes::new(c), cap: c, len: 0 }
}

///|
fn ByteBuf::grow(self : ByteBuf, need : Int) -> Unit {
  let mut new_cap = self.cap * 2
  while new_cap < need {
    new_cap = new_cap * 2
  }
  let nb = Bytes::new(new_cap)
  let old = self.data
  let n = self.len
  let mut i = 0
  while i < n {
    nb[i] = old[i]
    i = i + 1
  }
  self.data = nb
  self.cap = new_cap
}

///|
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  let need = self.len + extra
  if need > self.cap {
    self.grow(need)
  }
}

///|
fn ByteBuf::push_byte(self : ByteBuf, b : Int) -> Unit {
  let p = self.len
  if p >= self.cap {
    self.grow(p + 1)
  }
  self.data[p] = b.to_byte()
  self.len = p + 1
}

///|
fn ByteBuf::push_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  self.ensure(n)
  let dst = self.data
  let base = self.len
  let mut i = 0
  while i < n {
    dst[base + i] = src[i]
    i = i + 1
  }
  self.len = base + n
}

///|
fn ByteBuf::push_string(self : ByteBuf, s : String) -> Unit {
  let n = s.length()
  if n == 0 {
    return
  }
  self.ensure(n)
  let dst = self.data
  let base = self.len
  let mut i = 0
  while i < n {
    dst[base + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  self.len = base + n
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.data.slice(0, self.len)
}

// ---------------------------------------------------------------------------
// RFC 7541 §5.1 Variable-Length Integer Codec
// ---------------------------------------------------------------------------

///|
fn write_int(
  buf : ByteBuf,
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Unit {
  let max_prefix = (1L << prefix_bits) - 1L
  if value < max_prefix {
    buf.push_byte(first_byte_mask | value.to_int())
    return
  }
  buf.push_byte(first_byte_mask | max_prefix.to_int())
  let mut v = value - max_prefix
  while v >= 128L {
    buf.push_byte((v & 0x7FL).to_int() | 0x80)
    v = v >> 7
  }
  buf.push_byte(v.to_int())
}

///| Fast inline Int writer for common HPACK indices.
fn write_int_fast(
  buf : ByteBuf,
  value : Int,
  max_prefix : Int,
  first_byte_mask : Int,
) -> Unit {
  let p = buf.len
  if value < max_prefix {
    if p >= buf.cap {
      buf.grow(p + 1)
    }
    buf.data[p] = (first_byte_mask | value).to_byte()
    buf.len = p + 1
    return
  }
  buf.ensure(10)
  let dst = buf.data
  dst[p] = (first_byte_mask | max_prefix).to_byte()
  let mut q = p + 1
  let mut v = value - max_prefix
  while v >= 128 {
    dst[q] = ((v & 0x7F) | 0x80).to_byte()
    v = v >> 7
    q = q + 1
  }
  dst[q] = v.to_byte()
  buf.len = q + 1
}

///| Encode an HPACK integer with `prefix_bits` (1..=8) and upper-bit `first_byte_mask`.
pub fn hpack_encode_int(
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Bytes {
  let buf = ByteBuf::new(16)
  write_int(buf, value, prefix_bits, first_byte_mask)
  buf.to_bytes()
}

///| Decode an HPACK integer starting at `data[offset]` with `prefix_bits` (1..=8).
///| Rejects 64-bit overflow and overlong continuation byte sequences (> 8 continuation bytes).
pub fn hpack_decode_int(
  data : Bytes,
  offset : Int,
  prefix_bits : Int,
) -> Result[(Int64, Int), H2Error] {
  let n = data.length()
  if offset < 0 || offset >= n {
    return Err(H2Error::CompressionError("truncated HPACK integer"))
  }
  if prefix_bits < 1 || prefix_bits > 8 {
    return Err(H2Error::CompressionError("invalid HPACK integer prefix bits"))
  }
  let max_prefix = (1 << prefix_bits) - 1
  let mut acc = (data[offset].to_int() & max_prefix).to_int64()
  let mut pos = offset + 1
  if acc < max_prefix.to_int64() {
    return Ok((acc, pos))
  }
  let mut shift = 0
  let mut cont = 0
  while true {
    if pos >= n {
      return Err(H2Error::CompressionError("truncated HPACK integer continuation"))
    }
    if cont >= 8 || shift >= 56 {
      return Err(H2Error::CompressionError("HPACK integer overflow or overlong encoding"))
    }
    let b = data[pos].to_int()
    pos = pos + 1
    let low = (b & 0x7F).to_int64()
    let add = low << shift
    if acc > 0x7FFFFFFFFFFFFFFFL - add {
      return Err(H2Error::CompressionError("HPACK integer 64-bit overflow"))
    }
    acc = acc + add
    shift = shift + 7
    cont = cont + 1
    if (b & 0x80) == 0 {
      return Ok((acc, pos))
    }
  }
  Err(H2Error::CompressionError("HPACK integer decode error"))
}

// ---------------------------------------------------------------------------
// O(1) Circular Buffer Dynamic FIFO Table (RFC 7541 §4, FixedArray-backed)
// ---------------------------------------------------------------------------

///|
struct DynamicTable {
  mut names : FixedArray[String]
  mut values : FixedArray[String]
  mut sizes : FixedArray[Int]
  mut cap : Int
  mut mask : Int
  mut head : Int
  mut count : Int
  mut cur_size : Int
  mut max_size : Int
  // Optional O(1) open-addressing hash indices (enabled for HpackEncoder, off for HpackDecoder)
  use_index : Bool
  mut next_id : Int
  mut idx_cap : Int
  mut idx_mask : Int
  mut pair_used : Int
  mut pair_eid : FixedArray[Int]
  mut pair_hash : FixedArray[Int]
  mut pair_pos : FixedArray[Int]
  mut name_used : Int
  mut name_eid : FixedArray[Int]
  mut name_hash : FixedArray[Int]
  mut name_pos : FixedArray[Int]
  mut gen : Int
}

///|
fn DynamicTable::new_with_index(max_size : Int, use_index : Bool) -> DynamicTable {
  let cap = 64
  let icap = if use_index { 512 } else { 1 }
  DynamicTable::{
    names: FixedArray::make(cap, ""),
    values: FixedArray::make(cap, ""),
    sizes: FixedArray::make(cap, 0),
    cap: cap,
    mask: cap - 1,
    head: 0,
    count: 0,
    cur_size: 0,
    max_size: if max_size < 0 { 0 } else { max_size },
    use_index: use_index,
    next_id: 1,
    idx_cap: icap,
    idx_mask: icap - 1,
    pair_used: 0,
    pair_eid: FixedArray::make(icap, 0),
    pair_hash: FixedArray::make(icap, 0),
    pair_pos: FixedArray::make(icap, 0),
    name_used: 0,
    name_eid: FixedArray::make(icap, 0),
    name_hash: FixedArray::make(icap, 0),
    name_pos: FixedArray::make(icap, 0),
    gen: 0,
  }
}

///|
fn DynamicTable::rebuild_index(self : DynamicTable, target_cap : Int) -> Unit {
  if !self.use_index {
    return
  }
  let mut icap = target_cap
  if icap < 512 {
    icap = 512
  }
  while icap < self.count * 4 {
    icap = icap * 2
  }
  let imask = icap - 1
  let p_eid : FixedArray[Int] = FixedArray::make(icap, 0)
  let p_hash : FixedArray[Int] = FixedArray::make(icap, 0)
  let p_pos : FixedArray[Int] = FixedArray::make(icap, 0)
  let n_eid : FixedArray[Int] = FixedArray::make(icap, 0)
  let n_hash : FixedArray[Int] = FixedArray::make(icap, 0)
  let n_pos : FixedArray[Int] = FixedArray::make(icap, 0)
  let mut p_used = 0
  let mut n_used = 0

  let cnt = self.count
  let head = self.head
  let rmask = self.mask
  let names = self.names
  let values = self.values
  let mut i = cnt - 1
  let mut eid = 1
  while i >= 0 {
    let pos = (head + i) & rmask
    let name = names[pos]
    let val_s = values[pos]
    let nh = str_hash(name)
    let vh = str_hash(val_s)
    let ph = ((nh * 31) ^ vh) & 0x7FFFFFFF

    let mut ps = ph & imask
    while true {
      let ce = p_eid[ps]
      if ce == 0 {
        p_eid[ps] = eid
        p_hash[ps] = ph
        p_pos[ps] = pos
        p_used = p_used + 1
        break
      }
      if p_hash[ps] == ph && names[p_pos[ps]] == name && values[p_pos[ps]] == val_s {
        p_eid[ps] = eid
        p_pos[ps] = pos
        break
      }
      ps = (ps + 1) & imask
    }

    let mut ns = nh & imask
    while true {
      let ce = n_eid[ns]
      if ce == 0 {
        n_eid[ns] = eid
        n_hash[ns] = nh
        n_pos[ns] = pos
        n_used = n_used + 1
        break
      }
      if n_hash[ns] == nh && names[n_pos[ns]] == name {
        n_eid[ns] = eid
        n_pos[ns] = pos
        break
      }
      ns = (ns + 1) & imask
    }

    eid = eid + 1
    i = i - 1
  }

  self.next_id = cnt + 1
  self.idx_cap = icap
  self.idx_mask = imask
  self.pair_used = p_used
  self.pair_eid = p_eid
  self.pair_hash = p_hash
  self.pair_pos = p_pos
  self.name_used = n_used
  self.name_eid = n_eid
  self.name_hash = n_hash
  self.name_pos = n_pos
  self.gen = self.gen + 1
}

///|
fn DynamicTable::grow(self : DynamicTable) -> Unit {
  let new_cap = self.cap * 2
  let new_names : FixedArray[String] = FixedArray::make(new_cap, "")
  let new_values : FixedArray[String] = FixedArray::make(new_cap, "")
  let new_sizes : FixedArray[Int] = FixedArray::make(new_cap, 0)
  let rmask = self.mask
  let head = self.head
  let old_names = self.names
  let old_values = self.values
  let old_sizes = self.sizes
  let mut i = 0
  while i < self.count {
    let idx = (head + i) & rmask
    new_names[i] = old_names[idx]
    new_values[i] = old_values[idx]
    new_sizes[i] = old_sizes[idx]
    i = i + 1
  }
  self.names = new_names
  self.values = new_values
  self.sizes = new_sizes
  self.cap = new_cap
  self.mask = new_cap - 1
  self.head = 0
  self.gen = self.gen + 1
  if self.use_index {
    self.rebuild_index(new_cap * 2)
  }
}

///|
fn DynamicTable::evict_oldest(self : DynamicTable) -> Unit {
  if self.count == 0 {
    return
  }
  let tail = (self.head + self.count - 1) & self.mask
  self.cur_size = self.cur_size - self.sizes[tail]
  self.names[tail] = ""
  self.values[tail] = ""
  self.sizes[tail] = 0
  self.count = self.count - 1
}

///|
fn DynamicTable::clear(self : DynamicTable) -> Unit {
  while self.count > 0 {
    self.evict_oldest()
  }
  self.head = 0
  self.cur_size = 0
  if self.use_index && (self.pair_used > 0 || self.name_used > 0) {
    let p_eid = self.pair_eid
    let n_eid = self.name_eid
    let mut i = 0
    while i < self.idx_cap {
      p_eid[i] = 0
      n_eid[i] = 0
      i = i + 1
    }
    self.pair_used = 0
    self.name_used = 0
    self.next_id = 1
  }
}

///|
fn DynamicTable::set_max_size(self : DynamicTable, new_max : Int) -> Unit {
  let m = if new_max < 0 { 0 } else { new_max }
  self.max_size = m
  while self.count > 0 && self.cur_size > self.max_size {
    self.evict_oldest()
  }
}

///| Fast decoder insert (no hashing or index maintenance).
fn DynamicTable::insert_simple(
  self : DynamicTable,
  name : String,
  value : String,
  esize : Int,
) -> Unit {
  if esize > self.max_size {
    self.clear()
    return
  }
  while self.count > 0 && self.cur_size + esize > self.max_size {
    self.evict_oldest()
  }
  if self.count == self.cap {
    self.grow()
  }
  let new_head = (self.head - 1) & self.mask
  self.head = new_head
  self.names[new_head] = name
  self.values[new_head] = value
  self.sizes[new_head] = esize
  self.count = self.count + 1
  self.cur_size = self.cur_size + esize
}

///| Encoder insert with O(1) open-addressing pair & optional name index maintenance.
fn DynamicTable::insert_indexed(
  self : DynamicTable,
  name : String,
  value : String,
  esize : Int,
  nh : Int,
  ph : Int,
  index_name : Bool,
) -> Unit {
  if esize > self.max_size {
    self.clear()
    return
  }
  while self.count > 0 && self.cur_size + esize > self.max_size {
    self.evict_oldest()
  }
  if self.count == self.cap {
    self.grow()
  }
  let new_head = (self.head - 1) & self.mask
  self.head = new_head
  self.names[new_head] = name
  self.values[new_head] = value
  self.sizes[new_head] = esize
  self.count = self.count + 1
  self.cur_size = self.cur_size + esize

  if !self.use_index {
    return
  }
  if self.next_id >= 0x70000000 ||
  (self.pair_used + 1) * 2 >= self.idx_cap ||
  (self.name_used + 1) * 2 >= self.idx_cap {
    self.rebuild_index(self.idx_cap)
    return
  }
  let eid = self.next_id
  self.next_id = eid + 1
  let oldest = self.next_id - self.count
  let imask = self.idx_mask
  let names = self.names
  let values = self.values

  let p_eid = self.pair_eid
  let p_hash = self.pair_hash
  let p_pos = self.pair_pos
  let mut ps = ph & imask
  let mut first_exp = -1
  while true {
    let ce = p_eid[ps]
    if ce == 0 {
      let target = if first_exp >= 0 { first_exp } else { ps }
      if first_exp < 0 {
        self.pair_used = self.pair_used + 1
      }
      p_eid[target] = eid
      p_hash[target] = ph
      p_pos[target] = new_head
      break
    }
    if ce < oldest {
      if first_exp < 0 {
        first_exp = ps
      }
    } else if p_hash[ps] == ph && names[p_pos[ps]] == name && values[p_pos[ps]] == value {
      p_eid[ps] = eid
      p_pos[ps] = new_head
      break
    }
    ps = (ps + 1) & imask
  }

  if !index_name {
    return
  }
  let n_eid = self.name_eid
  let n_hash = self.name_hash
  let n_pos = self.name_pos
  let mut ns = nh & imask
  let mut first_nexp = -1
  while true {
    let ce = n_eid[ns]
    if ce == 0 {
      let target = if first_nexp >= 0 { first_nexp } else { ns }
      if first_nexp < 0 {
        self.name_used = self.name_used + 1
      }
      n_eid[target] = eid
      n_hash[target] = nh
      n_pos[target] = new_head
      break
    }
    if ce < oldest {
      if first_nexp < 0 {
        first_nexp = ns
      }
    } else if n_hash[ns] == nh && names[n_pos[ns]] == name {
      n_eid[ns] = eid
      n_pos[ns] = new_head
      break
    }
    ns = (ns + 1) & imask
  }
}

///| Get dynamic table entry at 0-based index `i` (0 = most recent = HPACK index 62).
fn DynamicTable::get_name(self : DynamicTable, i : Int) -> String {
  self.names[(self.head + i) & self.mask]
}

///|
fn DynamicTable::get_value(self : DynamicTable, i : Int) -> String {
  self.values[(self.head + i) & self.mask]
}

// ---------------------------------------------------------------------------
// HPACK Decoder (RFC 7541 §6, Zero-Boxing Cursor)
// ---------------------------------------------------------------------------

///|
pub struct HpackDecoder {
  mut max_allowed_size : Int
  mut max_header_list_size : Int
  dyn_table : DynamicTable
  mut huff_scratch : Bytes
  mut huff_cap : Int
  // Zero-boxing decode cursor outputs
  mut dec_pos : Int
  mut dec_int : Int64
  mut dec_str : String
  mut dec_slen : Int
}

///|
pub fn HpackDecoder::new(max_table_size : Int) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: 65536,
    dyn_table: DynamicTable::new_with_index(max_table_size, false),
    huff_scratch: Bytes::new(256),
    huff_cap: 256,
    dec_pos: 0,
    dec_int: 0L,
    dec_str: "",
    dec_slen: 0,
  }
}

///|
pub fn HpackDecoder::with_limits(
  max_table_size : Int,
  max_header_list_size : Int,
) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: max_header_list_size,
    dyn_table: DynamicTable::new_with_index(max_table_size, false),
    huff_scratch: Bytes::new(256),
    huff_cap: 256,
    dec_pos: 0,
    dec_int: 0L,
    dec_str: "",
    dec_slen: 0,
  }
}

///| Update protocol-negotiated SETTINGS_HEADER_TABLE_SIZE upper bound.
///| RFC 7541 §4.2: does not evict immediately; caps the peer's subsequent size updates.
pub fn HpackDecoder::set_max_table_size(
  self : HpackDecoder,
  max_size : Int,
) -> Unit {
  let m = if max_size < 0 { 0 } else { max_size }
  self.max_allowed_size = m
}

///|
pub fn HpackDecoder::dynamic_table_size(self : HpackDecoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackDecoder::dynamic_table_len(self : HpackDecoder) -> Int {
  self.dyn_table.count
}

///|
pub fn HpackDecoder::dynamic_table_get(
  self : HpackDecoder,
  index : Int,
) -> Option[HeaderField] {
  if index < 0 || index >= self.dyn_table.count {
    return None
  }
  Some(
    HeaderField::new(
      self.dyn_table.get_name(index),
      self.dyn_table.get_value(index),
    ),
  )
}

///| Zero-boxing multi-byte HPACK integer continuation decoder.
fn HpackDecoder::decode_int_cont(
  self : HpackDecoder,
  data : Bytes,
  start_pos : Int,
  n : Int,
  max_prefix : Int,
) -> Int {
  let mut acc = max_prefix.to_int64()
  let mut pos = start_pos
  let mut shift = 0
  let mut cont = 0
  while true {
    if pos >= n {
      return -1
    }
    if cont >= 8 || shift >= 56 {
      return -1
    }
    let b = data[pos].to_int()
    pos = pos + 1
    let low = (b & 0x7F).to_int64()
    let add = low << shift
    if acc > 0x7FFFFFFFFFFFFFFFL - add {
      return -1
    }
    acc = acc + add
    shift = shift + 7
    cont = cont + 1
    if (b & 0x80) == 0 {
      self.dec_int = acc
      self.dec_pos = pos
      return 0
    }
  }
  -1
}

///| Zero-boxing HPACK string decoder. Writes `self.dec_str`, `self.dec_slen`, `self.dec_pos`.
///| Returns 0 on success, -1 on CompressionError, -2 on EnhanceYourCalm.
fn HpackDecoder::decode_string_into(
  self : HpackDecoder,
  data : Bytes,
  offset : Int,
  n : Int,
  max_len : Int,
) -> Int {
  if offset >= n {
    return -1
  }
  let b0 = data[offset].to_int()
  let huff = (b0 & 0x80) != 0
  let low7 = b0 & 0x7F
  let mut slen64 = low7.to_int64()
  let mut start = offset + 1
  if low7 == 127 {
    if self.decode_int_cont(data, start, n, 127) < 0 {
      return -1
    }
    slen64 = self.dec_int
    start = self.dec_pos
  }
  let remaining = (n - start).to_int64()
  if slen64 < 0L || slen64 > remaining {
    return -1
  }
  let slen = slen64.to_int()
  if !huff {
    if slen > max_len {
      return -2
    }
    if slen == 0 {
      self.dec_str = ""
    } else {
      self.dec_str = data.slice(start, start + slen).to_string()
    }
    self.dec_slen = slen
    self.dec_pos = start + slen
    return 0
  }
  if slen > max_len {
    return -2
  }
  if slen == 0 {
    self.dec_str = ""
    self.dec_slen = 0
    self.dec_pos = start
    return 0
  }
  let max_out = ((slen * 8) / 5) + 2
  if self.huff_cap < max_out {
    let mut new_cap = self.huff_cap * 2
    while new_cap < max_out {
      new_cap = new_cap * 2
    }
    self.huff_scratch = Bytes::new(new_cap)
    self.huff_cap = new_cap
  }
  let ht = huff_tables
  let dlen = huffman_decode_into_bytes(
    data,
    start,
    slen,
    self.huff_scratch,
    ht.lut12,
    ht.left,
    ht.right,
    ht.leaf_sym,
  )
  if dlen < 0 {
    return -1
  }
  if dlen > max_len {
    return -2
  }
  self.dec_str = self.huff_scratch.slice(0, dlen).to_string()
  self.dec_slen = dlen
  self.dec_pos = start + slen
  0
}

///| Out-of-line literal & size-update handler to keep HpackDecoder::decode's indexed fast loop register-resident.
///| Returns:
///|   >= 0 : updated list_size (and updates self.dec_pos)
///|   -1   : CompressionError
///|   -2   : EnhanceYourCalm
fn HpackDecoder::decode_non_indexed(
  self : HpackDecoder,
  block : Bytes,
  b : Int,
  pos0 : Int,
  n : Int,
  allow_size_update : Bool,
  list_size0 : Int,
  limit : Int,
  headers : Array[HeaderField],
) -> Int {
  let dyn = self.dyn_table
  let st = static_tbl
  let mut pos = pos0
  if (b & 0x40) != 0 {
    // 6.2.1. Literal Header Field with Incremental Indexing
    let low6 = b & 0x3F
    let mut idx64 = low6.to_int64()
    pos = pos + 1
    if low6 == 63 {
      if self.decode_int_cont(block, pos, n, 63) < 0 {
        return -1
      }
      idx64 = self.dec_int
      pos = self.dec_pos
    }
    let rem_budget = limit - list_size0
    let mut name = ""
    let mut name_len = 0
    if idx64 == 0L {
      let rc = self.decode_string_into(block, pos, n, rem_budget)
      if rc < 0 {
        return rc
      }
      name = self.dec_str
      name_len = self.dec_slen
      pos = self.dec_pos
    } else {
      let max_idx64 = (static_table_len + dyn.count).to_int64()
      if idx64 < 1L || idx64 > max_idx64 {
        return -1
      }
      let idx = idx64.to_int()
      if idx <= static_table_len {
        name = st.names[idx]
        name_len = st.name_lens[idx]
      } else {
        let di = (dyn.head + (idx - static_table_len - 1)) & dyn.mask
        name = dyn.names[di]
        name_len = name.length()
      }
    }
    let val_budget = limit - list_size0 - name_len - 32
    if val_budget < 0 {
      return -2
    }
    let vrc = self.decode_string_into(block, pos, n, val_budget)
    if vrc < 0 {
      return vrc
    }
    let value = self.dec_str
    let val_len = self.dec_slen
    self.dec_pos = self.dec_pos
    let esize = name_len + val_len + 32
    let list_size = list_size0 + esize
    if list_size > limit {
      return -2
    }
    dyn.insert_simple(name, value, esize)
    headers.push(HeaderField::{ name: name, value: value, sensitive: false })
    return list_size
  }
  if (b & 0x20) != 0 {
    // 6.3. Dynamic Table Size Update
    if !allow_size_update {
      return -1
    }
    let low5 = b & 0x1F
    let mut new_size64 = low5.to_int64()
    pos = pos + 1
    if low5 == 31 {
      if self.decode_int_cont(block, pos, n, 31) < 0 {
        return -1
      }
      new_size64 = self.dec_int
      pos = self.dec_pos
    }
    if new_size64 < 0L || new_size64 > self.max_allowed_size.to_int64() {
      return -1
    }
    dyn.set_max_size(new_size64.to_int())
    self.dec_pos = pos
    return list_size0
  }
  // 6.2.2 (0000xxxx) Without Indexing / 6.2.3 (0001xxxx) Never Indexed
  let sensitive = (b & 0x10) != 0
  let low4 = b & 0x0F
  let mut idx64 = low4.to_int64()
  pos = pos + 1
  if low4 == 15 {
    if self.decode_int_cont(block, pos, n, 15) < 0 {
      return -1
    }
    idx64 = self.dec_int
    pos = self.dec_pos
  }
  let rem_budget = limit - list_size0
  let mut name = ""
  let mut name_len = 0
  if idx64 == 0L {
    let rc = self.decode_string_into(block, pos, n, rem_budget)
    if rc < 0 {
      return rc
    }
    name = self.dec_str
    name_len = self.dec_slen
    pos = self.dec_pos
  } else {
    let max_idx64 = (static_table_len + dyn.count).to_int64()
    if idx64 < 1L || idx64 > max_idx64 {
      return -1
    }
    let idx = idx64.to_int()
    if idx <= static_table_len {
      name = st.names[idx]
      name_len = st.name_lens[idx]
    } else {
      let di = (dyn.head + (idx - static_table_len - 1)) & dyn.mask
      name = dyn.names[di]
      name_len = name.length()
    }
  }
  let val_budget = limit - list_size0 - name_len - 32
  if val_budget < 0 {
    return -2
  }
  let vrc = self.decode_string_into(block, pos, n, val_budget)
  if vrc < 0 {
    return vrc
  }
  let value = self.dec_str
  let val_len = self.dec_slen
  let list_size = list_size0 + name_len + val_len + 32
  if list_size > limit {
    return -2
  }
  headers.push(HeaderField::{ name: name, value: value, sensitive: sensitive })
  list_size
}

///| Decode a complete HPACK header block with real-time RFC 7541 §4.1 bomb accounting.
pub fn HpackDecoder::decode(
  self : HpackDecoder,
  block : Bytes,
) -> Result[Array[HeaderField], H2Error] {
  let n = block.length()
  let est_hdrs = if n < 16 { 8 } else if n < 64 { 16 } else { 24 }
  let headers : Array[HeaderField] = Array::with_capacity(est_hdrs)
  let mut pos = 0
  let mut allow_size_update = true
  let mut list_size = 0
  let limit = self.max_header_list_size
  let st = static_tbl
  let snames = st.names
  let svals = st.values
  let ssizes = st.entry_sizes
  let dyn = self.dyn_table
  let mut d_names = dyn.names
  let mut d_values = dyn.values
  let mut d_sizes = dyn.sizes
  let mut d_mask = dyn.mask
  let mut d_head = dyn.head
  let mut d_max_idx = static_table_len + dyn.count
  let mut err_code = 0

  while pos < n {
    let b = block[pos].to_int()
    if (b & 0x80) != 0 {
      // 6.1. Indexed Header Field Representation (hot path: ~83% of headers)
      allow_size_update = false
      let low7 = b & 0x7F
      pos = pos + 1
      if low7 > 0 && low7 <= static_table_len {
        list_size = list_size + ssizes[low7]
        if list_size > limit {
          err_code = -2
          break
        }
        headers.push(HeaderField::{ name: snames[low7], value: svals[low7], sensitive: false })
      } else if low7 < 127 && low7 <= d_max_idx && low7 > static_table_len {
        let di = (d_head + (low7 - static_table_len - 1)) & d_mask
        list_size = list_size + d_sizes[di]
        if list_size > limit {
          err_code = -2
          break
        }
        headers.push(HeaderField::{ name: d_names[di], value: d_values[di], sensitive: false })
      } else if low7 == 127 {
        if self.decode_int_cont(block, pos, n, 127) < 0 {
          err_code = -1
          break
        }
        let idx64 = self.dec_int
        pos = self.dec_pos
        if idx64 < 1L || idx64 > d_max_idx.to_int64() {
          err_code = -1
          break
        }
        let di = (d_head + (idx64.to_int() - static_table_len - 1)) & d_mask
        list_size = list_size + d_sizes[di]
        if list_size > limit {
          err_code = -2
          break
        }
        headers.push(HeaderField::{ name: d_names[di], value: d_values[di], sensitive: false })
      } else {
        err_code = -1
        break
      }
    } else {
      let is_size_upd = (b & 0x60) == 0x20
      let res = self.decode_non_indexed(
        block,
        b,
        pos,
        n,
        allow_size_update,
        list_size,
        limit,
        headers,
      )
      if res < 0 {
        err_code = res
        break
      }
      list_size = res
      pos = self.dec_pos
      d_head = dyn.head
      d_max_idx = static_table_len + dyn.count
      if !is_size_upd {
        allow_size_update = false
        if dyn.mask != d_mask {
          d_names = dyn.names
          d_values = dyn.values
          d_sizes = dyn.sizes
          d_mask = dyn.mask
        }
      }
    }
  }
  if err_code == -2 {
    return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
  }
  if err_code < 0 {
    return Err(H2Error::CompressionError("HPACK decode error"))
  }
  Ok(headers)
}

// ---------------------------------------------------------------------------
// HPACK Encoder (RFC 7541 §6)
// ---------------------------------------------------------------------------

///|
pub struct HpackEncoder {
  dyn_table : DynamicTable
  scratch : ByteBuf
  mut use_huffman : Bool
  mut pending_min_size : Int
  mut pending_final_size : Int
}

///|
pub fn HpackEncoder::new(max_table_size : Int) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new_with_index(max_table_size, true),
    scratch: ByteBuf::new(256),
    use_huffman: true,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::with_huffman(
  max_table_size : Int,
  use_huffman : Bool,
) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new_with_index(max_table_size, true),
    scratch: ByteBuf::new(256),
    use_huffman: use_huffman,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::set_max_table_size(
  self : HpackEncoder,
  new_size : Int,
) -> Unit {
  let s = if new_size < 0 { 0 } else { new_size }
  self.dyn_table.set_max_size(s)
  if self.pending_min_size < 0 || s < self.pending_min_size {
    self.pending_min_size = s
  }
  self.pending_final_size = s
}

///|
pub fn HpackEncoder::set_huffman(self : HpackEncoder, enabled : Bool) -> Unit {
  self.use_huffman = enabled
}

///|
pub fn HpackEncoder::dynamic_table_size(self : HpackEncoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackEncoder::dynamic_table_len(self : HpackEncoder) -> Int {
  self.dyn_table.count
}

///| Zero-copy, single-pass HPACK string writer directly from String into Bytes-backed ByteBuf.
fn write_hpack_string(
  buf : ByteBuf,
  s : String,
  use_huffman : Bool,
  packed : FixedArray[UInt64],
) -> Unit {
  let rlen = s.length()
  if use_huffman && rlen > 0 {
    if rlen < 127 {
      buf.ensure(rlen + 8)
      let len_pos = buf.len
      let dst = buf.data
      let written = huffman_encode_str_if_shorter(s, rlen, dst, len_pos + 1, packed)
      if written > 0 {
        dst[len_pos] = (0x80 | written).to_byte()
        buf.len = len_pos + 1 + written
        return
      }
      dst[len_pos] = rlen.to_byte()
      let base = len_pos + 1
      let mut i = 0
      while i < rlen {
        dst[base + i] = s.code_unit_at(i).to_byte()
        i = i + 1
      }
      buf.len = base + rlen
      return
    }
    let hlen = huffman_encoded_len_str(s)
    if hlen < rlen {
      write_int_fast(buf, hlen, 127, 0x80)
      buf.ensure(hlen + 4)
      let written = huffman_encode_str_into_bytes(s, buf.data, buf.len, packed)
      buf.len = buf.len + written
      return
    }
  }
  write_int_fast(buf, rlen, 127, 0x00)
  buf.push_string(s)
}

///| Fast static table name-only lookup (returns 1..61 or 0). Used on dynamic-table miss.
fn static_table_find_name(name : String) -> Int {
  let nlen = name.length()
  if nlen == 0 {
    return 0
  }
  let c0 = name.code_unit_at(0)
  if c0 == 58 {
    if nlen == 7 {
      let c1 = name.code_unit_at(1)
      if c1 == 109 && name == ":method" {
        return 2
      }
      if c1 == 115 {
        if name == ":scheme" {
          return 6
        }
        if name == ":status" {
          return 8
        }
      }
    } else if nlen == 5 && name == ":path" {
      return 4
    } else if nlen == 10 && name == ":authority" {
      return 1
    }
    return 0
  }
  if c0 >= 128 {
    return 0
  }
  let st = static_tbl
  let lo = st.first_lo[c0]
  if lo == 0 {
    return 0
  }
  let hi = st.first_hi[c0]
  let snames = st.names
  let slens = st.name_lens
  let mut i = lo
  while i <= hi {
    if slens[i] == nlen && snames[i] == name {
      return i
    }
    i = i + 1
  }
  0
}

///| Out-of-line slow path for HpackEncoder::encode: handles sensitive, dyn_max==0, and dynamic-table misses.
fn HpackEncoder::encode_miss(
  self : HpackEncoder,
  hname : String,
  hval : String,
  hsens : Bool,
  nh : Int,
  ph : Int,
) -> Unit {
  let buf = self.scratch
  let use_huff = self.use_huffman
  let huff_tbl = huff_enc_packed
  let dyn = self.dyn_table
  let s_idx = static_table_find_name(hname)
  if hsens {
    let mut name_idx = s_idx
    if name_idx == 0 && dyn.count > 0 {
      let oldest = dyn.next_id - dyn.count
      let imask = dyn.idx_mask
      let n_eid = dyn.name_eid
      let n_hash = dyn.name_hash
      let n_pos = dyn.name_pos
      let d_names = dyn.names
      let mut ns = nh & imask
      while true {
        let ce = n_eid[ns]
        if ce == 0 {
          break
        }
        if ce >= oldest && n_hash[ns] == nh && d_names[n_pos[ns]] == hname {
          name_idx = static_table_len + (dyn.next_id - ce)
          break
        }
        ns = (ns + 1) & imask
      }
    }
    if name_idx > 0 {
      write_int_fast(buf, name_idx, 15, 0x10)
    } else {
      buf.push_byte(0x10)
      write_hpack_string(buf, hname, use_huff, huff_tbl)
    }
    write_hpack_string(buf, hval, use_huff, huff_tbl)
    return
  }
  let dyn_max = dyn.max_size
  if dyn_max == 0 {
    if s_idx > 0 {
      write_int_fast(buf, s_idx, 15, 0x00)
    } else {
      buf.push_byte(0x00)
      write_hpack_string(buf, hname, use_huff, huff_tbl)
    }
    write_hpack_string(buf, hval, use_huff, huff_tbl)
    return
  }
  let mut name_idx = s_idx
  if name_idx == 0 && dyn.count > 0 {
    let oldest = dyn.next_id - dyn.count
    let imask = dyn.idx_mask
    let n_eid = dyn.name_eid
    let n_hash = dyn.name_hash
    let n_pos = dyn.name_pos
    let d_names = dyn.names
    let mut ns = nh & imask
    while true {
      let ce = n_eid[ns]
      if ce == 0 {
        break
      }
      if ce >= oldest && n_hash[ns] == nh && d_names[n_pos[ns]] == hname {
        name_idx = static_table_len + (dyn.next_id - ce)
        break
      }
      ns = (ns + 1) & imask
    }
  }
  let entry_size = hname.length() + hval.length() + 32
  if entry_size <= dyn_max {
    if name_idx > 0 {
      write_int_fast(buf, name_idx, 63, 0x40)
    } else {
      buf.push_byte(0x40)
      write_hpack_string(buf, hname, use_huff, huff_tbl)
    }
    write_hpack_string(buf, hval, use_huff, huff_tbl)
    dyn.insert_indexed(hname, hval, entry_size, nh, ph, s_idx == 0)
  } else {
    if name_idx > 0 {
      write_int_fast(buf, name_idx, 15, 0x00)
    } else {
      buf.push_byte(0x00)
      write_hpack_string(buf, hname, use_huff, huff_tbl)
    }
    write_hpack_string(buf, hval, use_huff, huff_tbl)
  }
}

///| Encode a list of HeaderFields into an HPACK header block.
pub fn HpackEncoder::encode(
  self : HpackEncoder,
  headers : Array[HeaderField],
) -> Bytes {
  let buf = self.scratch
  buf.len = 0

  // Emit pending dynamic table size updates at the start of the header block
  if self.pending_final_size >= 0 {
    if self.pending_min_size >= 0 && self.pending_min_size < self.pending_final_size {
      write_int_fast(buf, self.pending_min_size, 31, 0x20)
    }
    write_int_fast(buf, self.pending_final_size, 31, 0x20)
    self.pending_min_size = -1
    self.pending_final_size = -1
  }

  let dyn = self.dyn_table
  let dyn_max = dyn.max_size
  let mut p_eid = dyn.pair_eid
  let mut p_hash = dyn.pair_hash
  let mut p_pos = dyn.pair_pos
  let mut d_names = dyn.names
  let mut d_values = dyn.values
  let mut imask = dyn.idx_mask

  let hlen = headers.length()
  buf.ensure(hlen * 2 + 16)
  let mut bdata = buf.data
  let mut bcap = buf.cap
  let mut i = 0
  while i < hlen {
    let hname = headers[i].name
    let hval = headers[i].value
    let hsens = headers[i].sensitive
    if hsens {
      let nh = str_hash(hname)
      self.encode_miss(hname, hval, true, nh, 0)
      if buf.cap != bcap {
        bdata = buf.data
        bcap = buf.cap
      }
      i = i + 1
      continue
    }
    // Check the 15 static-table entries that have non-empty values (or empty-value exact match)
    let nlen = hname.length()
    let vlen = hval.length()
    let mut s_exact_idx = 0
    if nlen > 0 {
      let c0 = hname.code_unit_at(0)
      if c0 == 58 {
        if nlen == 7 {
          let c1 = hname.code_unit_at(1)
          if c1 == 109 && hname.code_unit_at(6) == 100 && hname == ":method" {
            if vlen == 3 &&
            hval.code_unit_at(0) == 71 &&
            hval.code_unit_at(1) == 69 &&
            hval.code_unit_at(2) == 84 {
              s_exact_idx = 2
            } else if vlen == 4 &&
            hval.code_unit_at(0) == 80 &&
            hval.code_unit_at(1) == 79 &&
            hval.code_unit_at(2) == 83 &&
            hval.code_unit_at(3) == 84 {
              s_exact_idx = 3
            }
          } else if c1 == 115 {
            let c2 = hname.code_unit_at(2)
            if c2 == 99 && hname == ":scheme" {
              if vlen == 5 &&
              hval.code_unit_at(0) == 104 &&
              hval.code_unit_at(1) == 116 &&
              hval.code_unit_at(2) == 116 &&
              hval.code_unit_at(3) == 112 &&
              hval.code_unit_at(4) == 115 {
                s_exact_idx = 7
              } else if vlen == 4 &&
              hval.code_unit_at(0) == 104 &&
              hval.code_unit_at(1) == 116 &&
              hval.code_unit_at(2) == 116 &&
              hval.code_unit_at(3) == 112 {
                s_exact_idx = 6
              }
            } else if c2 == 116 && vlen == 3 && hname == ":status" {
              let v0 = hval.code_unit_at(0)
              let v1 = hval.code_unit_at(1)
              let v2 = hval.code_unit_at(2)
              if v0 == 50 && v1 == 48 {
                if v2 == 48 {
                  s_exact_idx = 8
                } else if v2 == 52 {
                  s_exact_idx = 9
                } else if v2 == 54 {
                  s_exact_idx = 10
                }
              } else if v0 == 51 && v1 == 48 && v2 == 52 {
                s_exact_idx = 11
              } else if v0 == 52 && v1 == 48 {
                if v2 == 48 {
                  s_exact_idx = 12
                } else if v2 == 52 {
                  s_exact_idx = 13
                }
              } else if v0 == 53 && v1 == 48 && v2 == 48 {
                s_exact_idx = 14
              }
            }
          }
        } else if nlen == 5 && hname.code_unit_at(1) == 112 && hname == ":path" {
          if vlen == 1 && hval.code_unit_at(0) == 47 {
            s_exact_idx = 4
          } else if vlen == 11 && hval == "/index.html" {
            s_exact_idx = 5
          }
        } else if vlen == 0 && nlen == 10 && hname == ":authority" {
          s_exact_idx = 1
        }
      } else if vlen == 13 && nlen == 15 && c0 == 97 && hname == "accept-encoding" && hval == "gzip, deflate" {
        s_exact_idx = 16
      } else if vlen == 0 {
        let si = static_table_find_name(hname)
        if si > 0 && si != 16 {
          s_exact_idx = si
        }
      }
    }
    if s_exact_idx > 0 {
      let p = buf.len
      if p >= bcap {
        buf.grow(p + 1)
        bdata = buf.data
        bcap = buf.cap
      }
      bdata[p] = (0x80 | s_exact_idx).to_byte()
      buf.len = p + 1
      i = i + 1
      continue
    }
    if dyn_max == 0 {
      self.encode_miss(hname, hval, false, 0, 0)
      if buf.cap != bcap {
        bdata = buf.data
        bcap = buf.cap
      }
      i = i + 1
      continue
    }
    // Dynamic table exact (name, value) lookup (hot path for ~60% of headers!)
    let nh = str_hash(hname)
    let vh = str_hash(hval)
    let ph = ((nh * 31) ^ vh) & 0x7FFFFFFF
    let mut d_exact_idx = 0
    if dyn.count > 0 {
      let oldest = dyn.next_id - dyn.count
      let mut ps = ph & imask
      while true {
        let ce = p_eid[ps]
        if ce == 0 {
          break
        }
        if ce >= oldest && p_hash[ps] == ph {
          let pos = p_pos[ps]
          if d_names[pos] == hname && d_values[pos] == hval {
            d_exact_idx = static_table_len + (dyn.next_id - ce)
            break
          }
        }
        ps = (ps + 1) & imask
      }
    }
    if d_exact_idx > 0 {
      if d_exact_idx < 127 {
        let p = buf.len
        if p >= bcap {
          buf.grow(p + 1)
          bdata = buf.data
          bcap = buf.cap
        }
        bdata[p] = (0x80 | d_exact_idx).to_byte()
        buf.len = p + 1
      } else {
        write_int_fast(buf, d_exact_idx, 127, 0x80)
        if buf.cap != bcap {
          bdata = buf.data
          bcap = buf.cap
        }
      }
    } else {
      let prev_gen = dyn.gen
      self.encode_miss(hname, hval, false, nh, ph)
      if buf.cap != bcap {
        bdata = buf.data
        bcap = buf.cap
      }
      if dyn.gen != prev_gen {
        p_eid = dyn.pair_eid
        p_hash = dyn.pair_hash
        p_pos = dyn.pair_pos
        d_names = dyn.names
        d_values = dyn.values
        imask = dyn.idx_mask
      }
    }
    i = i + 1
  }
  bdata.slice(0, buf.len)
}
