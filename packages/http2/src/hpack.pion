///|
let static_table_len : Int = 61

///| Look up an entry in the RFC 7541 static table (1..=61).
pub fn static_table_get(index : Int) -> Option[HeaderField] {
  if index < 1 || index > static_table_len {
    return None
  }
  Some(HeaderField::new(static_names[index], static_values[index]))
}

///| Fast static table lookup returning `(index, exact_match)`.
///| Returns `(0, false)` if name is not in the static table.
fn static_table_find(name : String, value : String) -> (Int, Bool) {
  let nlen = name.length()
  if nlen == 0 {
    return (0, false)
  }
  let c0 = name.code_unit_at(0)
  // Fast dispatch on first byte
  if c0 == 58 {
    // ':' pseudo-headers (indices 1..14)
    if name == ":method" {
      if value == "GET" {
        return (2, true)
      }
      if value == "POST" {
        return (3, true)
      }
      return (2, false)
    }
    if name == ":path" {
      if value == "/" {
        return (4, true)
      }
      if value == "/index.html" {
        return (5, true)
      }
      return (4, false)
    }
    if name == ":scheme" {
      if value == "http" {
        return (6, true)
      }
      if value == "https" {
        return (7, true)
      }
      return (6, false)
    }
    if name == ":authority" {
      return (1, value.length() == 0)
    }
    if name == ":status" {
      if value == "200" {
        return (8, true)
      }
      if value == "204" {
        return (9, true)
      }
      if value == "206" {
        return (10, true)
      }
      if value == "304" {
        return (11, true)
      }
      if value == "400" {
        return (12, true)
      }
      if value == "404" {
        return (13, true)
      }
      if value == "500" {
        return (14, true)
      }
      return (8, false)
    }
    return (0, false)
  }
  // Regular headers (indices 15..61) are sorted alphabetically!
  // Map first char to narrow range [lo..hi]
  let mut lo = 15
  let mut hi = 61
  if c0 == 97 {
    // 'a'
    lo = 15
    hi = 23
  } else if c0 == 99 {
    // 'c'
    lo = 24
    hi = 32
  } else if c0 == 100 {
    // 'd'
    lo = 33
    hi = 33
  } else if c0 == 101 {
    // 'e'
    lo = 34
    hi = 36
  } else if c0 == 102 {
    // 'f'
    lo = 37
    hi = 37
  } else if c0 == 104 {
    // 'h'
    lo = 38
    hi = 38
  } else if c0 == 105 {
    // 'i'
    lo = 39
    hi = 43
  } else if c0 == 108 {
    // 'l'
    lo = 44
    hi = 46
  } else if c0 == 109 {
    // 'm'
    lo = 47
    hi = 47
  } else if c0 == 112 {
    // 'p'
    lo = 48
    hi = 49
  } else if c0 == 114 {
    // 'r'
    lo = 50
    hi = 53
  } else if c0 == 115 {
    // 's'
    lo = 54
    hi = 56
  } else if c0 == 116 {
    // 't'
    lo = 57
    hi = 57
  } else if c0 == 117 {
    // 'u'
    lo = 58
    hi = 58
  } else if c0 == 118 {
    // 'v'
    lo = 59
    hi = 60
  } else if c0 == 119 {
    // 'w'
    lo = 61
    hi = 61
  } else {
    return (0, false)
  }
  let mut i = lo
  while i <= hi {
    if static_names[i] == name {
      let sv = static_values[i]
      if sv == value {
        return (i, true)
      }
      return (i, false)
    }
    i = i + 1
  }
  (0, false)
}

// ---------------------------------------------------------------------------
// Growable Byte Buffer (Zero-Boxing)
// ---------------------------------------------------------------------------

///|
struct ByteBuf {
  mut data : Bytes
  mut len : Int
}

///|
fn ByteBuf::new(cap : Int) -> ByteBuf {
  let c = if cap < 32 { 32 } else { cap }
  ByteBuf::{ data: Bytes::new(c), len: 0 }
}

///|
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  let need = self.len + extra
  if need <= self.data.length() {
    return
  }
  let mut new_cap = self.data.length() * 2
  while new_cap < need {
    new_cap = new_cap * 2
  }
  let mut nb = Bytes::new(new_cap)
  let mut i = 0
  while i < self.len {
    nb[i] = self.data[i]
    i = i + 1
  }
  self.data = nb
}

///|
fn ByteBuf::push_byte(self : ByteBuf, b : Int) -> Unit {
  self.ensure(1)
  self.data[self.len] = b.to_byte()
  self.len = self.len + 1
}

///|
fn ByteBuf::push_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  self.ensure(n)
  let base = self.len
  let mut i = 0
  while i < n {
    self.data[base + i] = src[i]
    i = i + 1
  }
  self.len = base + n
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.data.slice(0, self.len)
}

// ---------------------------------------------------------------------------
// RFC 7541 §5.1 Variable-Length Integer Codec
// ---------------------------------------------------------------------------

///|
fn write_int(
  buf : ByteBuf,
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Unit {
  let max_prefix = (1L << prefix_bits) - 1L
  if value < max_prefix {
    buf.push_byte(first_byte_mask | value.to_int())
    return
  }
  buf.push_byte(first_byte_mask | max_prefix.to_int())
  let mut v = value - max_prefix
  while v >= 128L {
    buf.push_byte((v & 0x7FL).to_int() | 0x80)
    v = v >> 7
  }
  buf.push_byte(v.to_int())
}

///| Encode an HPACK integer with `prefix_bits` (1..=8) and upper-bit `first_byte_mask`.
pub fn hpack_encode_int(
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Bytes {
  let buf = ByteBuf::new(16)
  write_int(buf, value, prefix_bits, first_byte_mask)
  buf.to_bytes()
}

///| Decode an HPACK integer starting at `data[offset]` with `prefix_bits` (1..=8).
///| Rejects 64-bit overflow and overlong continuation byte sequences (> 9 continuation bytes).
pub fn hpack_decode_int(
  data : Bytes,
  offset : Int,
  prefix_bits : Int,
) -> Result[(Int64, Int), H2Error] {
  let n = data.length()
  if offset < 0 || offset >= n {
    return Err(H2Error::CompressionError("truncated HPACK integer"))
  }
  if prefix_bits < 1 || prefix_bits > 8 {
    return Err(H2Error::CompressionError("invalid HPACK integer prefix bits"))
  }
  let max_prefix = (1 << prefix_bits) - 1
  let mut acc = (data[offset].to_int() & max_prefix).to_int64()
  let mut pos = offset + 1
  if acc < max_prefix.to_int64() {
    return Ok((acc, pos))
  }
  let mut shift = 0
  let mut cont = 0
  while true {
    if pos >= n {
      return Err(H2Error::CompressionError("truncated HPACK integer continuation"))
    }
    // At most 8 continuation bytes (shift 0..56) to prevent 64-bit overflow & DoS
    if cont >= 8 || shift >= 56 {
      return Err(H2Error::CompressionError("HPACK integer overflow or overlong encoding"))
    }
    let b = data[pos].to_int()
    pos = pos + 1
    let low = (b & 0x7F).to_int64()
    let add = low << shift
    // Check overflow against Int64 max (0x7FFFFFFFFFFFFFFF)
    if acc > 0x7FFFFFFFFFFFFFFFL - add {
      return Err(H2Error::CompressionError("HPACK integer 64-bit overflow"))
    }
    acc = acc + add
    shift = shift + 7
    cont = cont + 1
    if (b & 0x80) == 0 {
      return Ok((acc, pos))
    }
  }
  Err(H2Error::CompressionError("HPACK integer decode error"))
}

// ---------------------------------------------------------------------------
// O(1) Circular Buffer Dynamic FIFO Table (RFC 7541 §4)
// ---------------------------------------------------------------------------

///|
struct DynamicTable {
  mut names : Array[String]
  mut values : Array[String]
  mut sizes : Array[Int]
  mut cap : Int
  mut head : Int
  mut count : Int
  mut cur_size : Int
  mut max_size : Int
}

///|
fn DynamicTable::new(max_size : Int) -> DynamicTable {
  let cap = 64
  DynamicTable::{
    names: Array::make(cap, ""),
    values: Array::make(cap, ""),
    sizes: Array::make(cap, 0),
    cap: cap,
    head: 0,
    count: 0,
    cur_size: 0,
    max_size: if max_size < 0 { 0 } else { max_size },
  }
}

///|
fn DynamicTable::grow(self : DynamicTable) -> Unit {
  let new_cap = self.cap * 2
  let new_names = Array::make(new_cap, "")
  let new_values = Array::make(new_cap, "")
  let new_sizes = Array::make(new_cap, 0)
  let mut i = 0
  while i < self.count {
    let idx = (self.head + i) % self.cap
    new_names[i] = self.names[idx]
    new_values[i] = self.values[idx]
    new_sizes[i] = self.sizes[idx]
    i = i + 1
  }
  self.names = new_names
  self.values = new_values
  self.sizes = new_sizes
  self.cap = new_cap
  self.head = 0
}

///|
fn DynamicTable::evict_oldest(self : DynamicTable) -> Unit {
  if self.count == 0 {
    return
  }
  let tail = (self.head + self.count - 1) % self.cap
  self.cur_size = self.cur_size - self.sizes[tail]
  self.names[tail] = ""
  self.values[tail] = ""
  self.sizes[tail] = 0
  self.count = self.count - 1
}

///|
fn DynamicTable::clear(self : DynamicTable) -> Unit {
  while self.count > 0 {
    self.evict_oldest()
  }
  self.head = 0
  self.cur_size = 0
}

///|
fn DynamicTable::set_max_size(self : DynamicTable, new_max : Int) -> Unit {
  let m = if new_max < 0 { 0 } else { new_max }
  self.max_size = m
  while self.count > 0 && self.cur_size > self.max_size {
    self.evict_oldest()
  }
}

///|
fn DynamicTable::insert(self : DynamicTable, name : String, value : String) -> Unit {
  let esize = name.to_bytes().length() + value.to_bytes().length() + 32
  if esize > self.max_size {
    self.clear()
    return
  }
  while self.count > 0 && self.cur_size + esize > self.max_size {
    self.evict_oldest()
  }
  if self.count == self.cap {
    self.grow()
  }
  let new_head = (self.head - 1 + self.cap) % self.cap
  self.head = new_head
  self.names[new_head] = name
  self.values[new_head] = value
  self.sizes[new_head] = esize
  self.count = self.count + 1
  self.cur_size = self.cur_size + esize
}

///| Get dynamic table entry at 0-based index `i` (0 = most recent = HPACK index 62).
fn DynamicTable::get_name(self : DynamicTable, i : Int) -> String {
  self.names[(self.head + i) % self.cap]
}

///|
fn DynamicTable::get_value(self : DynamicTable, i : Int) -> String {
  self.values[(self.head + i) % self.cap]
}

///|
fn DynamicTable::get_size(self : DynamicTable, i : Int) -> Int {
  self.sizes[(self.head + i) % self.cap]
}

///| Find `(hpack_index, exact_match)` in dynamic table (HPACK index >= 62).
fn DynamicTable::find(self : DynamicTable, name : String, value : String) -> (Int, Bool) {
  let mut name_match = 0
  let mut i = 0
  while i < self.count {
    let idx = (self.head + i) % self.cap
    if self.names[idx] == name {
      if self.values[idx] == value {
        return (static_table_len + 1 + i, true)
      }
      if name_match == 0 {
        name_match = static_table_len + 1 + i
      }
    }
    i = i + 1
  }
  (name_match, false)
}

// ---------------------------------------------------------------------------
// HPACK Decoder (RFC 7541 §6)
// ---------------------------------------------------------------------------

///|
pub struct HpackDecoder {
  mut max_allowed_size : Int
  mut max_header_list_size : Int
  dyn_table : DynamicTable
}

///|
pub fn HpackDecoder::new(max_table_size : Int) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: 65536,
    dyn_table: DynamicTable::new(max_table_size),
  }
}

///|
pub fn HpackDecoder::with_limits(
  max_table_size : Int,
  max_header_list_size : Int,
) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: max_header_list_size,
    dyn_table: DynamicTable::new(max_table_size),
  }
}

///| Update protocol-negotiated SETTINGS_HEADER_TABLE_SIZE upper bound.
pub fn HpackDecoder::set_max_table_size(
  self : HpackDecoder,
  max_size : Int,
) -> Unit {
  let m = if max_size < 0 { 0 } else { max_size }
  self.max_allowed_size = m
  if self.dyn_table.max_size > m {
    self.dyn_table.set_max_size(m)
  }
}

///|
pub fn HpackDecoder::dynamic_table_size(self : HpackDecoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackDecoder::dynamic_table_len(self : HpackDecoder) -> Int {
  self.dyn_table.count
}

///|
pub fn HpackDecoder::dynamic_table_get(
  self : HpackDecoder,
  index : Int,
) -> Option[HeaderField] {
  if index < 0 || index >= self.dyn_table.count {
    return None
  }
  Some(
    HeaderField::new(
      self.dyn_table.get_name(index),
      self.dyn_table.get_value(index),
    ),
  )
}

///|
fn decode_hpack_string(
  data : Bytes,
  offset : Int,
  max_len : Int,
) -> Result[(String, Int, Int), H2Error] {
  if offset >= data.length() {
    return Err(H2Error::CompressionError("truncated HPACK string"))
  }
  let huff = (data[offset].to_int() & 0x80) != 0
  let (slen64, start) = match hpack_decode_int(data, offset, 7) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let remaining = (data.length() - start).to_int64()
  if slen64 < 0L || slen64 > remaining {
    return Err(H2Error::CompressionError("HPACK string length out of bounds"))
  }
  let slen = slen64.to_int()
  if !huff {
    if slen > max_len {
      return Err(H2Error::EnhanceYourCalm("HPACK string exceeds max_header_list_size"))
    }
    let s = data.slice(start, start + slen).to_string()
    return Ok((s, slen, start + slen))
  }
  // Huffman encoded: check lower bound before decoding (longest symbol is 30 bits, shortest 5 bits)
  // Even a compressed string can expand up to 1.6x, so pre-check rough bound to avoid OOM
  if slen > max_len {
    return Err(H2Error::EnhanceYourCalm("HPACK huffman string exceeds limit"))
  }
  let decoded = match huffman_decode_slice(data, start, slen) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let dlen = decoded.length()
  if dlen > max_len {
    return Err(H2Error::EnhanceYourCalm("HPACK decoded string exceeds max_header_list_size"))
  }
  Ok((decoded.to_string(), dlen, start + slen))
}

///| Decode a complete HPACK header block with real-time RFC 7541 §4.1 bomb accounting.
pub fn HpackDecoder::decode(
  self : HpackDecoder,
  block : Bytes,
) -> Result[Array[HeaderField], H2Error] {
  let headers : Array[HeaderField] = []
  let n = block.length()
  let mut pos = 0
  let mut allow_size_update = true
  let mut list_size = 0
  let limit = self.max_header_list_size

  while pos < n {
    let b = block[pos].to_int()
    if (b & 0x80) != 0 {
      // 6.1. Indexed Header Field Representation
      allow_size_update = false
      let (idx64, next_pos) = match hpack_decode_int(block, pos, 7) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = next_pos
      if idx64 <= 0L {
        return Err(H2Error::CompressionError("HPACK indexed header index 0"))
      }
      let idx = idx64.to_int()
      if idx <= static_table_len {
        let name = static_names[idx]
        let value = static_values[idx]
        let esize = name.length() + value.length() + 32
        list_size = list_size + esize
        if list_size > limit {
          return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
        }
        headers.push(HeaderField::new(name, value))
      } else {
        let di = idx - static_table_len - 1
        if di < 0 || di >= self.dyn_table.count {
          return Err(H2Error::CompressionError("HPACK dynamic index out of bounds"))
        }
        let esize = self.dyn_table.get_size(di)
        list_size = list_size + esize
        if list_size > limit {
          return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
        }
        headers.push(
          HeaderField::new(
            self.dyn_table.get_name(di),
            self.dyn_table.get_value(di),
          ),
        )
      }
    } else if (b & 0x40) != 0 {
      // 6.2.1. Literal Header Field with Incremental Indexing
      allow_size_update = false
      let (idx64, p1) = match hpack_decode_int(block, pos, 6) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p1
      let rem_budget = limit - list_size
      let (name, name_len) = if idx64 == 0L {
        let (ns, nlen, p2) = match decode_hpack_string(block, pos, rem_budget) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        pos = p2
        (ns, nlen)
      } else {
        let idx = idx64.to_int()
        if idx <= static_table_len {
          let ns = static_names[idx]
          (ns, ns.length())
        } else {
          let di = idx - static_table_len - 1
          if di < 0 || di >= self.dyn_table.count {
            return Err(H2Error::CompressionError("HPACK literal name index out of bounds"))
          }
          let ns = self.dyn_table.get_name(di)
          (ns, ns.to_bytes().length())
        }
      }
      let val_budget = limit - list_size - name_len - 32
      if val_budget < 0 {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      let (value, val_len, p3) = match decode_hpack_string(block, pos, val_budget) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p3
      list_size = list_size + name_len + val_len + 32
      if list_size > limit {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      self.dyn_table.insert(name, value)
      headers.push(HeaderField::new(name, value))
    } else if (b & 0x20) != 0 {
      // 6.3. Dynamic Table Size Update
      if !allow_size_update {
        return Err(
          H2Error::CompressionError(
            "HPACK dynamic table size update must appear at start of header block",
          ),
        )
      }
      let (new_size64, next_pos) = match hpack_decode_int(block, pos, 5) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = next_pos
      if new_size64 > self.max_allowed_size.to_int64() {
        return Err(
          H2Error::CompressionError(
            "HPACK dynamic table size update exceeds negotiated maximum",
          ),
        )
      }
      self.dyn_table.set_max_size(new_size64.to_int())
    } else {
      // 6.2.2 (0000xxxx) Without Indexing / 6.2.3 (0001xxxx) Never Indexed
      allow_size_update = false
      let sensitive = (b & 0x10) != 0
      let (idx64, p1) = match hpack_decode_int(block, pos, 4) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p1
      let rem_budget = limit - list_size
      let (name, name_len) = if idx64 == 0L {
        let (ns, nlen, p2) = match decode_hpack_string(block, pos, rem_budget) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        pos = p2
        (ns, nlen)
      } else {
        let idx = idx64.to_int()
        if idx <= static_table_len {
          let ns = static_names[idx]
          (ns, ns.length())
        } else {
          let di = idx - static_table_len - 1
          if di < 0 || di >= self.dyn_table.count {
            return Err(H2Error::CompressionError("HPACK literal name index out of bounds"))
          }
          let ns = self.dyn_table.get_name(di)
          (ns, ns.to_bytes().length())
        }
      }
      let val_budget = limit - list_size - name_len - 32
      if val_budget < 0 {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      let (value, val_len, p3) = match decode_hpack_string(block, pos, val_budget) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p3
      list_size = list_size + name_len + val_len + 32
      if list_size > limit {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      headers.push(HeaderField::{ name: name, value: value, sensitive: sensitive })
    }
  }
  Ok(headers)
}

// ---------------------------------------------------------------------------
// HPACK Encoder (RFC 7541 §6)
// ---------------------------------------------------------------------------

///|
pub struct HpackEncoder {
  dyn_table : DynamicTable
  mut use_huffman : Bool
  mut pending_min_size : Int
  mut pending_final_size : Int
}

///|
pub fn HpackEncoder::new(max_table_size : Int) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new(max_table_size),
    use_huffman: true,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::with_huffman(
  max_table_size : Int,
  use_huffman : Bool,
) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new(max_table_size),
    use_huffman: use_huffman,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::set_max_table_size(
  self : HpackEncoder,
  new_size : Int,
) -> Unit {
  let s = if new_size < 0 { 0 } else { new_size }
  self.dyn_table.set_max_size(s)
  if self.pending_min_size < 0 || s < self.pending_min_size {
    self.pending_min_size = s
  }
  self.pending_final_size = s
}

///|
pub fn HpackEncoder::set_huffman(self : HpackEncoder, enabled : Bool) -> Unit {
  self.use_huffman = enabled
}

///|
pub fn HpackEncoder::dynamic_table_size(self : HpackEncoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackEncoder::dynamic_table_len(self : HpackEncoder) -> Int {
  self.dyn_table.count
}

///|
fn write_hpack_string(buf : ByteBuf, s : String, use_huffman : Bool) -> Unit {
  let raw = s.to_bytes()
  let rlen = raw.length()
  if use_huffman && rlen > 0 {
    let hlen = huffman_encoded_len(raw)
    if hlen < rlen {
      write_int(buf, hlen.to_int64(), 7, 0x80)
      buf.ensure(hlen)
      let written = huffman_encode_into(raw, buf.data, buf.len)
      buf.len = buf.len + written
      return
    }
  }
  write_int(buf, rlen.to_int64(), 7, 0x00)
  buf.push_bytes(raw)
}

///| Encode a list of HeaderFields into an HPACK header block.
pub fn HpackEncoder::encode(
  self : HpackEncoder,
  headers : Array[HeaderField],
) -> Bytes {
  let buf = ByteBuf::new(headers.length() * 16 + 32)

  // Emit pending dynamic table size updates at the start of the header block
  if self.pending_final_size >= 0 {
    if self.pending_min_size >= 0 && self.pending_min_size < self.pending_final_size {
      write_int(buf, self.pending_min_size.to_int64(), 5, 0x20)
    }
    write_int(buf, self.pending_final_size.to_int64(), 5, 0x20)
    self.pending_min_size = -1
    self.pending_final_size = -1
  }

  let use_huff = self.use_huffman
  let hlen = headers.length()
  let mut i = 0
  while i < hlen {
    let h = headers[i]
    let (s_idx, s_exact) = static_table_find(h.name, h.value)
    if h.sensitive {
      // Never Indexed (0001xxxx, 4-bit prefix): never insert into dynamic table
      let name_idx = if s_idx > 0 {
        s_idx
      } else {
        let (d_idx, _) = self.dyn_table.find(h.name, h.value)
        d_idx
      }
      if name_idx > 0 {
        write_int(buf, name_idx.to_int64(), 4, 0x10)
      } else {
        buf.push_byte(0x10)
        write_hpack_string(buf, h.name, use_huff)
      }
      write_hpack_string(buf, h.value, use_huff)
    } else if s_exact {
      // Exact match in static table -> Indexed (1xxxxxxx, 7-bit prefix)
      write_int(buf, s_idx.to_int64(), 7, 0x80)
    } else {
      let (d_idx, d_exact) = self.dyn_table.find(h.name, h.value)
      if d_exact {
        // Exact match in dynamic table -> Indexed
        write_int(buf, d_idx.to_int64(), 7, 0x80)
      } else {
        let name_idx = if s_idx > 0 { s_idx } else { d_idx }
        let entry_size = h.name.to_bytes().length() + h.value.to_bytes().length() + 32
        if entry_size <= self.dyn_table.max_size {
          // Literal with Incremental Indexing (01xxxxxx, 6-bit prefix)
          if name_idx > 0 {
            write_int(buf, name_idx.to_int64(), 6, 0x40)
          } else {
            buf.push_byte(0x40)
            write_hpack_string(buf, h.name, use_huff)
          }
          write_hpack_string(buf, h.value, use_huff)
          self.dyn_table.insert(h.name, h.value)
        } else {
          // Larger than dynamic table max_size -> Literal without Indexing (0000xxxx)
          if name_idx > 0 {
            write_int(buf, name_idx.to_int64(), 4, 0x00)
          } else {
            buf.push_byte(0x00)
            write_hpack_string(buf, h.name, use_huff)
          }
          write_hpack_string(buf, h.value, use_huff)
        }
      }
    }
    i = i + 1
  }
  buf.to_bytes()
}
