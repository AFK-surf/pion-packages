///| RFC 7541 HPACK Header Compression Engine (Static Table + Dynamic FIFO Table + Varint).
///| Stub for Red phase.

///|
pub fn hpack_encode_int(
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Bytes {
  let _ = value
  let _ = prefix_bits
  let _ = first_byte_mask
  Bytes::new(0)
}

///|
pub fn hpack_decode_int(
  data : Bytes,
  offset : Int,
  prefix_bits : Int,
) -> Result[(Int64, Int), H2Error] {
  let _ = data
  let _ = offset
  let _ = prefix_bits
  Err(H2Error::CompressionError("unimplemented"))
}

///|
pub fn static_table_get(index : Int) -> Option[HeaderField] {
  let _ = index
  None
}

///|
pub struct HpackDecoder {
  mut max_allowed_size : Int
  mut max_table_size : Int
  mut max_header_list_size : Int
}

///|
pub fn HpackDecoder::new(max_table_size : Int) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_table_size: max_table_size,
    max_header_list_size: 65536,
  }
}

///|
pub fn HpackDecoder::with_limits(
  max_table_size : Int,
  max_header_list_size : Int,
) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_table_size: max_table_size,
    max_header_list_size: max_header_list_size,
  }
}

///|
pub fn HpackDecoder::set_max_table_size(
  self : HpackDecoder,
  max_size : Int,
) -> Unit {
  self.max_allowed_size = max_size
  if self.max_table_size > max_size {
    self.max_table_size = max_size
  }
}

///|
pub fn HpackDecoder::dynamic_table_size(self : HpackDecoder) -> Int {
  let _ = self
  0
}

///|
pub fn HpackDecoder::dynamic_table_len(self : HpackDecoder) -> Int {
  let _ = self
  0
}

///|
pub fn HpackDecoder::dynamic_table_get(
  self : HpackDecoder,
  index : Int,
) -> Option[HeaderField] {
  let _ = self
  let _ = index
  None
}

///|
pub fn HpackDecoder::decode(
  self : HpackDecoder,
  block : Bytes,
) -> Result[Array[HeaderField], H2Error] {
  let _ = self
  let _ = block
  Err(H2Error::CompressionError("unimplemented"))
}

///|
pub struct HpackEncoder {
  mut max_table_size : Int
  mut use_huffman : Bool
}

///|
pub fn HpackEncoder::new(max_table_size : Int) -> HpackEncoder {
  HpackEncoder::{ max_table_size: max_table_size, use_huffman: true }
}

///|
pub fn HpackEncoder::with_huffman(
  max_table_size : Int,
  use_huffman : Bool,
) -> HpackEncoder {
  HpackEncoder::{ max_table_size: max_table_size, use_huffman: use_huffman }
}

///|
pub fn HpackEncoder::set_max_table_size(
  self : HpackEncoder,
  new_size : Int,
) -> Unit {
  self.max_table_size = new_size
}

///|
pub fn HpackEncoder::set_huffman(self : HpackEncoder, enabled : Bool) -> Unit {
  self.use_huffman = enabled
}

///|
pub fn HpackEncoder::dynamic_table_size(self : HpackEncoder) -> Int {
  let _ = self
  0
}

///|
pub fn HpackEncoder::dynamic_table_len(self : HpackEncoder) -> Int {
  let _ = self
  0
}

///|
pub fn HpackEncoder::encode(
  self : HpackEncoder,
  headers : Array[HeaderField],
) -> Bytes {
  let _ = self
  let _ = headers
  Bytes::new(0)
}
