///|
let static_table_len : Int = 61

///| Look up an entry in the RFC 7541 static table (1..=61).
pub fn static_table_get(index : Int) -> Option[HeaderField] {
  if index < 1 || index > static_table_len {
    return None
  }
  Some(HeaderField::new(static_names[index], static_values[index]))
}

///| Fast static table lookup returning `(index, exact_match)`.
///| Returns `(0, false)` if name is not in the static table.
fn static_table_find(name : String, value : String) -> (Int, Bool) {
  let nlen = name.length()
  if nlen == 0 {
    return (0, false)
  }
  let c0 = name.code_unit_at(0)
  // Fast dispatch on first byte
  if c0 == 58 {
    // ':' pseudo-headers (indices 1..14)
    if name == ":method" {
      if value == "GET" {
        return (2, true)
      }
      if value == "POST" {
        return (3, true)
      }
      return (2, false)
    }
    if name == ":path" {
      if value == "/" {
        return (4, true)
      }
      if value == "/index.html" {
        return (5, true)
      }
      return (4, false)
    }
    if name == ":scheme" {
      if value == "http" {
        return (6, true)
      }
      if value == "https" {
        return (7, true)
      }
      return (6, false)
    }
    if name == ":authority" {
      return (1, value.length() == 0)
    }
    if name == ":status" {
      if value == "200" {
        return (8, true)
      }
      if value == "204" {
        return (9, true)
      }
      if value == "206" {
        return (10, true)
      }
      if value == "304" {
        return (11, true)
      }
      if value == "400" {
        return (12, true)
      }
      if value == "404" {
        return (13, true)
      }
      if value == "500" {
        return (14, true)
      }
      return (8, false)
    }
    return (0, false)
  }
  // Regular headers (indices 15..61) are sorted alphabetically!
  // Map first char to narrow range [lo..hi]
  let mut lo = 15
  let mut hi = 61
  if c0 == 97 {
    // 'a'
    lo = 15
    hi = 23
  } else if c0 == 99 {
    // 'c'
    lo = 24
    hi = 32
  } else if c0 == 100 {
    // 'd'
    lo = 33
    hi = 33
  } else if c0 == 101 {
    // 'e'
    lo = 34
    hi = 36
  } else if c0 == 102 {
    // 'f'
    lo = 37
    hi = 37
  } else if c0 == 104 {
    // 'h'
    lo = 38
    hi = 38
  } else if c0 == 105 {
    // 'i'
    lo = 39
    hi = 43
  } else if c0 == 108 {
    // 'l'
    lo = 44
    hi = 46
  } else if c0 == 109 {
    // 'm'
    lo = 47
    hi = 47
  } else if c0 == 112 {
    // 'p'
    lo = 48
    hi = 49
  } else if c0 == 114 {
    // 'r'
    lo = 50
    hi = 53
  } else if c0 == 115 {
    // 's'
    lo = 54
    hi = 56
  } else if c0 == 116 {
    // 't'
    lo = 57
    hi = 57
  } else if c0 == 117 {
    // 'u'
    lo = 58
    hi = 58
  } else if c0 == 118 {
    // 'v'
    lo = 59
    hi = 60
  } else if c0 == 119 {
    // 'w'
    lo = 61
    hi = 61
  } else {
    return (0, false)
  }
  let mut i = lo
  while i <= hi {
    if static_names[i] == name {
      let sv = static_values[i]
      if sv == value {
        return (i, true)
      }
      return (i, false)
    }
    i = i + 1
  }
  (0, false)
}

// ---------------------------------------------------------------------------
// Growable Byte Buffer (Zero-Boxing)
// ---------------------------------------------------------------------------

///|
struct ByteBuf {
  mut data : Bytes
  mut len : Int
}

///|
fn ByteBuf::new(cap : Int) -> ByteBuf {
  let c = if cap < 32 { 32 } else { cap }
  ByteBuf::{ data: Bytes::new(c), len: 0 }
}

///|
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  let need = self.len + extra
  if need <= self.data.length() {
    return
  }
  let mut new_cap = self.data.length() * 2
  while new_cap < need {
    new_cap = new_cap * 2
  }
  let mut nb = Bytes::new(new_cap)
  let mut i = 0
  while i < self.len {
    nb[i] = self.data[i]
    i = i + 1
  }
  self.data = nb
}

///|
fn ByteBuf::push_byte(self : ByteBuf, b : Int) -> Unit {
  self.ensure(1)
  self.data[self.len] = b.to_byte()
  self.len = self.len + 1
}

///|
fn ByteBuf::push_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  self.ensure(n)
  let base = self.len
  let mut i = 0
  while i < n {
    self.data[base + i] = src[i]
    i = i + 1
  }
  self.len = base + n
}

///|
fn ByteBuf::push_string(self : ByteBuf, s : String) -> Unit {
  let n = s.length()
  if n == 0 {
    return
  }
  self.ensure(n)
  let base = self.len
  let mut i = 0
  while i < n {
    self.data[base + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  self.len = base + n
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.data.slice(0, self.len)
}

// ---------------------------------------------------------------------------
// RFC 7541 §5.1 Variable-Length Integer Codec
// ---------------------------------------------------------------------------

///|
fn write_int(
  buf : ByteBuf,
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Unit {
  let max_prefix = (1L << prefix_bits) - 1L
  if value < max_prefix {
    buf.push_byte(first_byte_mask | value.to_int())
    return
  }
  buf.push_byte(first_byte_mask | max_prefix.to_int())
  let mut v = value - max_prefix
  while v >= 128L {
    buf.push_byte((v & 0x7FL).to_int() | 0x80)
    v = v >> 7
  }
  buf.push_byte(v.to_int())
}

///| Encode an HPACK integer with `prefix_bits` (1..=8) and upper-bit `first_byte_mask`.
pub fn hpack_encode_int(
  value : Int64,
  prefix_bits : Int,
  first_byte_mask : Int,
) -> Bytes {
  let buf = ByteBuf::new(16)
  write_int(buf, value, prefix_bits, first_byte_mask)
  buf.to_bytes()
}

///| Decode an HPACK integer starting at `data[offset]` with `prefix_bits` (1..=8).
///| Rejects 64-bit overflow and overlong continuation byte sequences (> 9 continuation bytes).
pub fn hpack_decode_int(
  data : Bytes,
  offset : Int,
  prefix_bits : Int,
) -> Result[(Int64, Int), H2Error] {
  let n = data.length()
  if offset < 0 || offset >= n {
    return Err(H2Error::CompressionError("truncated HPACK integer"))
  }
  if prefix_bits < 1 || prefix_bits > 8 {
    return Err(H2Error::CompressionError("invalid HPACK integer prefix bits"))
  }
  let max_prefix = (1 << prefix_bits) - 1
  let mut acc = (data[offset].to_int() & max_prefix).to_int64()
  let mut pos = offset + 1
  if acc < max_prefix.to_int64() {
    return Ok((acc, pos))
  }
  let mut shift = 0
  let mut cont = 0
  while true {
    if pos >= n {
      return Err(H2Error::CompressionError("truncated HPACK integer continuation"))
    }
    // At most 8 continuation bytes (shift 0..56) to prevent 64-bit overflow & DoS
    if cont >= 8 || shift >= 56 {
      return Err(H2Error::CompressionError("HPACK integer overflow or overlong encoding"))
    }
    let b = data[pos].to_int()
    pos = pos + 1
    let low = (b & 0x7F).to_int64()
    let add = low << shift
    // Check overflow against Int64 max (0x7FFFFFFFFFFFFFFF)
    if acc > 0x7FFFFFFFFFFFFFFFL - add {
      return Err(H2Error::CompressionError("HPACK integer 64-bit overflow"))
    }
    acc = acc + add
    shift = shift + 7
    cont = cont + 1
    if (b & 0x80) == 0 {
      return Ok((acc, pos))
    }
  }
  Err(H2Error::CompressionError("HPACK integer decode error"))
}

// ---------------------------------------------------------------------------
// O(1) Circular Buffer Dynamic FIFO Table (RFC 7541 §4)
// ---------------------------------------------------------------------------

///| Fast FNV-1a style string hash using code_unit_at (zero allocation).
fn str_hash(s : String) -> Int {
  let n = s.length()
  let mut h = 216613626
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i)) * 16777619) & 0x7FFFFFFF
    i = i + 1
  }
  h
}

///|
struct DynamicTable {
  mut names : Array[String]
  mut values : Array[String]
  mut sizes : Array[Int]
  mut cap : Int
  mut mask : Int
  mut head : Int
  mut count : Int
  mut cur_size : Int
  mut max_size : Int
  // Optional O(1) open-addressing hash indices (enabled for HpackEncoder, off for HpackDecoder)
  use_index : Bool
  mut next_id : Int
  mut idx_cap : Int
  mut idx_mask : Int
  mut pair_used : Int
  mut pair_eid : Array[Int]
  mut pair_hash : Array[Int]
  mut pair_pos : Array[Int]
  mut name_used : Int
  mut name_eid : Array[Int]
  mut name_hash : Array[Int]
  mut name_pos : Array[Int]
}

///|
fn DynamicTable::new_with_index(max_size : Int, use_index : Bool) -> DynamicTable {
  let cap = 64
  let icap = if use_index { 256 } else { 1 }
  DynamicTable::{
    names: Array::make(cap, ""),
    values: Array::make(cap, ""),
    sizes: Array::make(cap, 0),
    cap: cap,
    mask: cap - 1,
    head: 0,
    count: 0,
    cur_size: 0,
    max_size: if max_size < 0 { 0 } else { max_size },
    use_index: use_index,
    next_id: 1,
    idx_cap: icap,
    idx_mask: icap - 1,
    pair_used: 0,
    pair_eid: Array::make(icap, 0),
    pair_hash: Array::make(icap, 0),
    pair_pos: Array::make(icap, 0),
    name_used: 0,
    name_eid: Array::make(icap, 0),
    name_hash: Array::make(icap, 0),
    name_pos: Array::make(icap, 0),
  }
}

///|
fn DynamicTable::rebuild_index(self : DynamicTable, target_cap : Int) -> Unit {
  if !self.use_index {
    return
  }
  let mut icap = target_cap
  if icap < 256 {
    icap = 256
  }
  while icap < self.count * 2 {
    icap = icap * 2
  }
  let imask = icap - 1
  let p_eid = Array::make(icap, 0)
  let p_hash = Array::make(icap, 0)
  let p_pos = Array::make(icap, 0)
  let n_eid = Array::make(icap, 0)
  let n_hash = Array::make(icap, 0)
  let n_pos = Array::make(icap, 0)
  let mut p_used = 0
  let mut n_used = 0

  // Renumber live entries cleanly from oldest (1) to newest (count)
  let cnt = self.count
  let head = self.head
  let rmask = self.mask
  let names = self.names
  let values = self.values
  let mut i = cnt - 1
  let mut eid = 1
  while i >= 0 {
    let pos = (head + i) & rmask
    let name = names[pos]
    let val_s = values[pos]
    let nh = str_hash(name)
    let vh = str_hash(val_s)
    let ph = ((nh * 31) ^ vh) & 0x7FFFFFFF

    // Insert/update pair table (newer eid overwrites older identical pair)
    let mut ps = ph & imask
    while true {
      let ce = p_eid[ps]
      if ce == 0 {
        p_eid[ps] = eid
        p_hash[ps] = ph
        p_pos[ps] = pos
        p_used = p_used + 1
        break
      }
      if p_hash[ps] == ph && names[p_pos[ps]] == name && values[p_pos[ps]] == val_s {
        p_eid[ps] = eid
        p_pos[ps] = pos
        break
      }
      ps = (ps + 1) & imask
    }

    // Insert/update name table (newer eid overwrites older identical name)
    let mut ns = nh & imask
    while true {
      let ce = n_eid[ns]
      if ce == 0 {
        n_eid[ns] = eid
        n_hash[ns] = nh
        n_pos[ns] = pos
        n_used = n_used + 1
        break
      }
      if n_hash[ns] == nh && names[n_pos[ns]] == name {
        n_eid[ns] = eid
        n_pos[ns] = pos
        break
      }
      ns = (ns + 1) & imask
    }

    eid = eid + 1
    i = i - 1
  }

  self.next_id = cnt + 1
  self.idx_cap = icap
  self.idx_mask = imask
  self.pair_used = p_used
  self.pair_eid = p_eid
  self.pair_hash = p_hash
  self.pair_pos = p_pos
  self.name_used = n_used
  self.name_eid = n_eid
  self.name_hash = n_hash
  self.name_pos = n_pos
}

///|
fn DynamicTable::grow(self : DynamicTable) -> Unit {
  let new_cap = self.cap * 2
  let new_names = Array::make(new_cap, "")
  let new_values = Array::make(new_cap, "")
  let new_sizes = Array::make(new_cap, 0)
  let rmask = self.mask
  let head = self.head
  let mut i = 0
  while i < self.count {
    let idx = (head + i) & rmask
    new_names[i] = self.names[idx]
    new_values[i] = self.values[idx]
    new_sizes[i] = self.sizes[idx]
    i = i + 1
  }
  self.names = new_names
  self.values = new_values
  self.sizes = new_sizes
  self.cap = new_cap
  self.mask = new_cap - 1
  self.head = 0
  if self.use_index {
    self.rebuild_index(new_cap * 2)
  }
}

///|
fn DynamicTable::evict_oldest(self : DynamicTable) -> Unit {
  if self.count == 0 {
    return
  }
  let tail = (self.head + self.count - 1) & self.mask
  self.cur_size = self.cur_size - self.sizes[tail]
  self.names[tail] = ""
  self.values[tail] = ""
  self.sizes[tail] = 0
  self.count = self.count - 1
}

///|
fn DynamicTable::clear(self : DynamicTable) -> Unit {
  while self.count > 0 {
    self.evict_oldest()
  }
  self.head = 0
  self.cur_size = 0
  if self.use_index && (self.pair_used > 0 || self.name_used > 0) {
    let mut i = 0
    while i < self.idx_cap {
      self.pair_eid[i] = 0
      self.name_eid[i] = 0
      i = i + 1
    }
    self.pair_used = 0
    self.name_used = 0
    self.next_id = 1
  }
}

///|
fn DynamicTable::set_max_size(self : DynamicTable, new_max : Int) -> Unit {
  let m = if new_max < 0 { 0 } else { new_max }
  self.max_size = m
  while self.count > 0 && self.cur_size > self.max_size {
    self.evict_oldest()
  }
}

///| Fast decoder insert (no hashing or index maintenance).
fn DynamicTable::insert_simple(
  self : DynamicTable,
  name : String,
  value : String,
  esize : Int,
) -> Unit {
  if esize > self.max_size {
    self.clear()
    return
  }
  while self.count > 0 && self.cur_size + esize > self.max_size {
    self.evict_oldest()
  }
  if self.count == self.cap {
    self.grow()
  }
  let new_head = (self.head - 1) & self.mask
  self.head = new_head
  self.names[new_head] = name
  self.values[new_head] = value
  self.sizes[new_head] = esize
  self.count = self.count + 1
  self.cur_size = self.cur_size + esize
}

///| Encoder insert with O(1) open-addressing pair & name index maintenance.
fn DynamicTable::insert_indexed(
  self : DynamicTable,
  name : String,
  value : String,
  esize : Int,
  nh : Int,
  ph : Int,
) -> Unit {
  if esize > self.max_size {
    self.clear()
    return
  }
  while self.count > 0 && self.cur_size + esize > self.max_size {
    self.evict_oldest()
  }
  if self.count == self.cap {
    self.grow()
  }
  let new_head = (self.head - 1) & self.mask
  self.head = new_head
  self.names[new_head] = name
  self.values[new_head] = value
  self.sizes[new_head] = esize
  self.count = self.count + 1
  self.cur_size = self.cur_size + esize

  if !self.use_index {
    return
  }
  if self.next_id >= 0x70000000 ||
  (self.pair_used + 1) * 4 >= self.idx_cap * 3 ||
  (self.name_used + 1) * 4 >= self.idx_cap * 3 {
    self.rebuild_index(self.idx_cap)
    return
  }
  let eid = self.next_id
  self.next_id = eid + 1
  let oldest = self.next_id - self.count
  let imask = self.idx_mask
  let names = self.names
  let values = self.values

  // Update pair index
  let p_eid = self.pair_eid
  let p_hash = self.pair_hash
  let p_pos = self.pair_pos
  let mut ps = ph & imask
  let mut first_exp = -1
  while true {
    let ce = p_eid[ps]
    if ce == 0 {
      let target = if first_exp >= 0 { first_exp } else { ps }
      if first_exp < 0 {
        self.pair_used = self.pair_used + 1
      }
      p_eid[target] = eid
      p_hash[target] = ph
      p_pos[target] = new_head
      break
    }
    if ce < oldest {
      if first_exp < 0 {
        first_exp = ps
      }
    } else if p_hash[ps] == ph && names[p_pos[ps]] == name && values[p_pos[ps]] == value {
      p_eid[ps] = eid
      p_pos[ps] = new_head
      break
    }
    ps = (ps + 1) & imask
  }

  // Update name index
  let n_eid = self.name_eid
  let n_hash = self.name_hash
  let n_pos = self.name_pos
  let mut ns = nh & imask
  let mut first_nexp = -1
  while true {
    let ce = n_eid[ns]
    if ce == 0 {
      let target = if first_nexp >= 0 { first_nexp } else { ns }
      if first_nexp < 0 {
        self.name_used = self.name_used + 1
      }
      n_eid[target] = eid
      n_hash[target] = nh
      n_pos[target] = new_head
      break
    }
    if ce < oldest {
      if first_nexp < 0 {
        first_nexp = ns
      }
    } else if n_hash[ns] == nh && names[n_pos[ns]] == name {
      n_eid[ns] = eid
      n_pos[ns] = new_head
      break
    }
    ns = (ns + 1) & imask
  }
}

///| Get dynamic table entry at 0-based index `i` (0 = most recent = HPACK index 62).
fn DynamicTable::get_name(self : DynamicTable, i : Int) -> String {
  self.names[(self.head + i) & self.mask]
}

///|
fn DynamicTable::get_value(self : DynamicTable, i : Int) -> String {
  self.values[(self.head + i) & self.mask]
}

///|
fn DynamicTable::get_size(self : DynamicTable, i : Int) -> Int {
  self.sizes[(self.head + i) & self.mask]
}

///| O(1) exact (name, value) lookup in dynamic table; returns HPACK index >= 62 or 0.
fn DynamicTable::find_pair(
  self : DynamicTable,
  name : String,
  value : String,
  ph : Int,
) -> Int {
  if self.count == 0 {
    return 0
  }
  let oldest = self.next_id - self.count
  let imask = self.idx_mask
  let p_eid = self.pair_eid
  let p_hash = self.pair_hash
  let p_pos = self.pair_pos
  let names = self.names
  let values = self.values
  let mut ps = ph & imask
  while true {
    let ce = p_eid[ps]
    if ce == 0 {
      return 0
    }
    if ce >= oldest && p_hash[ps] == ph {
      let pos = p_pos[ps]
      if names[pos] == name && values[pos] == value {
        return static_table_len + (self.next_id - ce)
      }
    }
    ps = (ps + 1) & imask
  }
  0
}

///| O(1) name-only lookup in dynamic table; returns HPACK index >= 62 or 0.
fn DynamicTable::find_name(
  self : DynamicTable,
  name : String,
  nh : Int,
) -> Int {
  if self.count == 0 {
    return 0
  }
  let oldest = self.next_id - self.count
  let imask = self.idx_mask
  let n_eid = self.name_eid
  let n_hash = self.name_hash
  let n_pos = self.name_pos
  let names = self.names
  let mut ns = nh & imask
  while true {
    let ce = n_eid[ns]
    if ce == 0 {
      return 0
    }
    if ce >= oldest && n_hash[ns] == nh {
      if names[n_pos[ns]] == name {
        return static_table_len + (self.next_id - ce)
      }
    }
    ns = (ns + 1) & imask
  }
  0
}

// ---------------------------------------------------------------------------
// HPACK Decoder (RFC 7541 §6)
// ---------------------------------------------------------------------------

///|
pub struct HpackDecoder {
  mut max_allowed_size : Int
  mut max_header_list_size : Int
  dyn_table : DynamicTable
  mut huff_scratch : Bytes
}

///|
pub fn HpackDecoder::new(max_table_size : Int) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: 65536,
    dyn_table: DynamicTable::new_with_index(max_table_size, false),
    huff_scratch: Bytes::new(256),
  }
}

///|
pub fn HpackDecoder::with_limits(
  max_table_size : Int,
  max_header_list_size : Int,
) -> HpackDecoder {
  HpackDecoder::{
    max_allowed_size: max_table_size,
    max_header_list_size: max_header_list_size,
    dyn_table: DynamicTable::new_with_index(max_table_size, false),
    huff_scratch: Bytes::new(256),
  }
}

///| Update protocol-negotiated SETTINGS_HEADER_TABLE_SIZE upper bound.
///| RFC 7541 §4.2: does not evict immediately; caps the peer's subsequent size updates.
pub fn HpackDecoder::set_max_table_size(
  self : HpackDecoder,
  max_size : Int,
) -> Unit {
  let m = if max_size < 0 { 0 } else { max_size }
  self.max_allowed_size = m
}

///|
pub fn HpackDecoder::dynamic_table_size(self : HpackDecoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackDecoder::dynamic_table_len(self : HpackDecoder) -> Int {
  self.dyn_table.count
}

///|
pub fn HpackDecoder::dynamic_table_get(
  self : HpackDecoder,
  index : Int,
) -> Option[HeaderField] {
  if index < 0 || index >= self.dyn_table.count {
    return None
  }
  Some(
    HeaderField::new(
      self.dyn_table.get_name(index),
      self.dyn_table.get_value(index),
    ),
  )
}

///|
fn HpackDecoder::decode_string(
  self : HpackDecoder,
  data : Bytes,
  offset : Int,
  max_len : Int,
) -> Result[(String, Int, Int), H2Error] {
  if offset >= data.length() {
    return Err(H2Error::CompressionError("truncated HPACK string"))
  }
  let huff = (data[offset].to_int() & 0x80) != 0
  let (slen64, start) = match hpack_decode_int(data, offset, 7) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let remaining = (data.length() - start).to_int64()
  if slen64 < 0L || slen64 > remaining {
    return Err(H2Error::CompressionError("HPACK string length out of bounds"))
  }
  let slen = slen64.to_int()
  if !huff {
    if slen > max_len {
      return Err(H2Error::EnhanceYourCalm("HPACK string exceeds max_header_list_size"))
    }
    let s = data.slice(start, start + slen).to_string()
    return Ok((s, slen, start + slen))
  }
  if slen > max_len {
    return Err(H2Error::EnhanceYourCalm("HPACK huffman string exceeds limit"))
  }
  if slen == 0 {
    return Ok(("", 0, start))
  }
  let max_out = ((slen * 8) / 5) + 1
  if self.huff_scratch.length() < max_out {
    let mut new_cap = self.huff_scratch.length() * 2
    while new_cap < max_out {
      new_cap = new_cap * 2
    }
    self.huff_scratch = Bytes::new(new_cap)
  }
  let dlen = match huffman_decode_into(data, start, slen, self.huff_scratch) {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if dlen > max_len {
    return Err(H2Error::EnhanceYourCalm("HPACK decoded string exceeds max_header_list_size"))
  }
  Ok((self.huff_scratch.slice(0, dlen).to_string(), dlen, start + slen))
}

///| Decode a complete HPACK header block with real-time RFC 7541 §4.1 bomb accounting.
pub fn HpackDecoder::decode(
  self : HpackDecoder,
  block : Bytes,
) -> Result[Array[HeaderField], H2Error] {
  let headers : Array[HeaderField] = []
  let n = block.length()
  let mut pos = 0
  let mut allow_size_update = true
  let mut list_size = 0
  let limit = self.max_header_list_size

  while pos < n {
    let b = block[pos].to_int()
    if (b & 0x80) != 0 {
      // 6.1. Indexed Header Field Representation
      allow_size_update = false
      let (idx64, next_pos) = match hpack_decode_int(block, pos, 7) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = next_pos
      let max_idx64 = (static_table_len + self.dyn_table.count).to_int64()
      if idx64 < 1L || idx64 > max_idx64 {
        return Err(H2Error::CompressionError("HPACK indexed header index out of bounds"))
      }
      let idx = idx64.to_int()
      if idx <= static_table_len {
        let name = static_names[idx]
        let value = static_values[idx]
        let esize = name.length() + value.length() + 32
        list_size = list_size + esize
        if list_size > limit {
          return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
        }
        headers.push(HeaderField::new(name, value))
      } else {
        let di = idx - static_table_len - 1
        let esize = self.dyn_table.get_size(di)
        list_size = list_size + esize
        if list_size > limit {
          return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
        }
        headers.push(
          HeaderField::new(
            self.dyn_table.get_name(di),
            self.dyn_table.get_value(di),
          ),
        )
      }
    } else if (b & 0x40) != 0 {
      // 6.2.1. Literal Header Field with Incremental Indexing
      allow_size_update = false
      let (idx64, p1) = match hpack_decode_int(block, pos, 6) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p1
      let rem_budget = limit - list_size
      let (name, name_len) = if idx64 == 0L {
        let (ns, nlen, p2) = match self.decode_string(block, pos, rem_budget) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        pos = p2
        (ns, nlen)
      } else {
        let max_idx64 = (static_table_len + self.dyn_table.count).to_int64()
        if idx64 < 1L || idx64 > max_idx64 {
          return Err(H2Error::CompressionError("HPACK literal name index out of bounds"))
        }
        let idx = idx64.to_int()
        if idx <= static_table_len {
          let ns = static_names[idx]
          (ns, ns.length())
        } else {
          let di = idx - static_table_len - 1
          let ns = self.dyn_table.get_name(di)
          (ns, ns.length())
        }
      }
      let val_budget = limit - list_size - name_len - 32
      if val_budget < 0 {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      let (value, val_len, p3) = match self.decode_string(block, pos, val_budget) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p3
      let esize = name_len + val_len + 32
      list_size = list_size + esize
      if list_size > limit {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      self.dyn_table.insert_simple(name, value, esize)
      headers.push(HeaderField::new(name, value))
    } else if (b & 0x20) != 0 {
      // 6.3. Dynamic Table Size Update
      if !allow_size_update {
        return Err(
          H2Error::CompressionError(
            "HPACK dynamic table size update must appear at start of header block",
          ),
        )
      }
      let (new_size64, next_pos) = match hpack_decode_int(block, pos, 5) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = next_pos
      if new_size64 < 0L || new_size64 > self.max_allowed_size.to_int64() {
        return Err(
          H2Error::CompressionError(
            "HPACK dynamic table size update exceeds negotiated maximum",
          ),
        )
      }
      self.dyn_table.set_max_size(new_size64.to_int())
    } else {
      // 6.2.2 (0000xxxx) Without Indexing / 6.2.3 (0001xxxx) Never Indexed
      allow_size_update = false
      let sensitive = (b & 0x10) != 0
      let (idx64, p1) = match hpack_decode_int(block, pos, 4) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p1
      let rem_budget = limit - list_size
      let (name, name_len) = if idx64 == 0L {
        let (ns, nlen, p2) = match self.decode_string(block, pos, rem_budget) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        pos = p2
        (ns, nlen)
      } else {
        let max_idx64 = (static_table_len + self.dyn_table.count).to_int64()
        if idx64 < 1L || idx64 > max_idx64 {
          return Err(H2Error::CompressionError("HPACK literal name index out of bounds"))
        }
        let idx = idx64.to_int()
        if idx <= static_table_len {
          let ns = static_names[idx]
          (ns, ns.length())
        } else {
          let di = idx - static_table_len - 1
          let ns = self.dyn_table.get_name(di)
          (ns, ns.length())
        }
      }
      let val_budget = limit - list_size - name_len - 32
      if val_budget < 0 {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      let (value, val_len, p3) = match self.decode_string(block, pos, val_budget) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      pos = p3
      list_size = list_size + name_len + val_len + 32
      if list_size > limit {
        return Err(H2Error::EnhanceYourCalm("HPACK header list size exceeded"))
      }
      headers.push(HeaderField::{ name: name, value: value, sensitive: sensitive })
    }
  }
  Ok(headers)
}

// ---------------------------------------------------------------------------
// HPACK Encoder (RFC 7541 §6)
// ---------------------------------------------------------------------------

///|
pub struct HpackEncoder {
  dyn_table : DynamicTable
  scratch : ByteBuf
  mut use_huffman : Bool
  mut pending_min_size : Int
  mut pending_final_size : Int
}

///|
pub fn HpackEncoder::new(max_table_size : Int) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new_with_index(max_table_size, true),
    scratch: ByteBuf::new(256),
    use_huffman: true,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::with_huffman(
  max_table_size : Int,
  use_huffman : Bool,
) -> HpackEncoder {
  HpackEncoder::{
    dyn_table: DynamicTable::new_with_index(max_table_size, true),
    scratch: ByteBuf::new(256),
    use_huffman: use_huffman,
    pending_min_size: -1,
    pending_final_size: -1,
  }
}

///|
pub fn HpackEncoder::set_max_table_size(
  self : HpackEncoder,
  new_size : Int,
) -> Unit {
  let s = if new_size < 0 { 0 } else { new_size }
  self.dyn_table.set_max_size(s)
  if self.pending_min_size < 0 || s < self.pending_min_size {
    self.pending_min_size = s
  }
  self.pending_final_size = s
}

///|
pub fn HpackEncoder::set_huffman(self : HpackEncoder, enabled : Bool) -> Unit {
  self.use_huffman = enabled
}

///|
pub fn HpackEncoder::dynamic_table_size(self : HpackEncoder) -> Int {
  self.dyn_table.cur_size
}

///|
pub fn HpackEncoder::dynamic_table_len(self : HpackEncoder) -> Int {
  self.dyn_table.count
}

///| Zero-copy HPACK string writer directly from String (no to_bytes() allocation).
fn write_hpack_string(buf : ByteBuf, s : String, use_huffman : Bool) -> Unit {
  let rlen = s.length()
  if use_huffman && rlen > 0 {
    let hlen = huffman_encoded_len_str(s)
    if hlen < rlen {
      write_int(buf, hlen.to_int64(), 7, 0x80)
      buf.ensure(hlen)
      let written = huffman_encode_str_into(s, buf.data, buf.len)
      buf.len = buf.len + written
      return
    }
  }
  write_int(buf, rlen.to_int64(), 7, 0x00)
  buf.push_string(s)
}

///| Encode a list of HeaderFields into an HPACK header block.
pub fn HpackEncoder::encode(
  self : HpackEncoder,
  headers : Array[HeaderField],
) -> Bytes {
  let buf = self.scratch
  buf.len = 0

  // Emit pending dynamic table size updates at the start of the header block
  if self.pending_final_size >= 0 {
    if self.pending_min_size >= 0 && self.pending_min_size < self.pending_final_size {
      write_int(buf, self.pending_min_size.to_int64(), 5, 0x20)
    }
    write_int(buf, self.pending_final_size.to_int64(), 5, 0x20)
    self.pending_min_size = -1
    self.pending_final_size = -1
  }

  let use_huff = self.use_huffman
  let dyn_max = self.dyn_table.max_size
  let hlen = headers.length()
  let mut i = 0
  while i < hlen {
    let h = headers[i]
    let (s_idx, s_exact) = static_table_find(h.name, h.value)
    if h.sensitive {
      // Never Indexed (0001xxxx, 4-bit prefix): never insert into dynamic table
      let name_idx = if s_idx > 0 {
        s_idx
      } else if self.dyn_table.count > 0 {
        self.dyn_table.find_name(h.name, str_hash(h.name))
      } else {
        0
      }
      if name_idx > 0 {
        write_int(buf, name_idx.to_int64(), 4, 0x10)
      } else {
        buf.push_byte(0x10)
        write_hpack_string(buf, h.name, use_huff)
      }
      write_hpack_string(buf, h.value, use_huff)
    } else if s_exact {
      // Exact match in static table -> Indexed (1xxxxxxx, 7-bit prefix)
      write_int(buf, s_idx.to_int64(), 7, 0x80)
    } else if dyn_max == 0 {
      // Dynamic table disabled: skip all hashing and emit Literal without Indexing
      if s_idx > 0 {
        write_int(buf, s_idx.to_int64(), 4, 0x00)
      } else {
        buf.push_byte(0x00)
        write_hpack_string(buf, h.name, use_huff)
      }
      write_hpack_string(buf, h.value, use_huff)
    } else {
      let nh = str_hash(h.name)
      let vh = str_hash(h.value)
      let ph = ((nh * 31) ^ vh) & 0x7FFFFFFF
      let d_exact_idx = self.dyn_table.find_pair(h.name, h.value, ph)
      if d_exact_idx > 0 {
        // Exact match in dynamic table -> Indexed
        write_int(buf, d_exact_idx.to_int64(), 7, 0x80)
      } else {
        let name_idx = if s_idx > 0 {
          s_idx
        } else {
          self.dyn_table.find_name(h.name, nh)
        }
        let entry_size = h.name.length() + h.value.length() + 32
        if entry_size <= dyn_max {
          // Literal with Incremental Indexing (01xxxxxx, 6-bit prefix)
          if name_idx > 0 {
            write_int(buf, name_idx.to_int64(), 6, 0x40)
          } else {
            buf.push_byte(0x40)
            write_hpack_string(buf, h.name, use_huff)
          }
          write_hpack_string(buf, h.value, use_huff)
          self.dyn_table.insert_indexed(h.name, h.value, entry_size, nh, ph)
        } else {
          // Larger than dynamic table max_size -> Literal without Indexing (0000xxxx)
          if name_idx > 0 {
            write_int(buf, name_idx.to_int64(), 4, 0x00)
          } else {
            buf.push_byte(0x00)
            write_hpack_string(buf, h.name, use_huff)
          }
          write_hpack_string(buf, h.value, use_huff)
        }
      }
    }
    i = i + 1
  }
  buf.to_bytes()
}
