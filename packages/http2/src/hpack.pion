///| RFC 7541 HPACK Header Compression Engine:
///| 61-entry Static Table, O(1) Circular Dynamic FIFO Table, Variable-Length Integer Codec,
///| Real-Time Header List Size Bomb Accounting, and Fast Encoder/Decoder.

// ---------------------------------------------------------------------------
// RFC 7541 Appendix A: 61-Entry Static Table (1-indexed, index 0 unused)
// ---------------------------------------------------------------------------

///|
let static_names : Array[String] = [
  "",
  ":authority",
  ":method",
  ":method",
  ":path",
  ":path",
  ":scheme",
  ":scheme",
  ":status",
  ":status",
  ":status",
  ":status",
  ":status",
  ":status",
  ":status",
  "accept-charset",
  "accept-encoding",
  "accept-language",
  "accept-ranges",
  "accept",
  "access-control-allow-origin",
  "age",
  "allow",
  "authorization",
  "cache-control",
  "content-disposition",
  "content-encoding",
  "content-language",
  "content-length",
  "content-location",
