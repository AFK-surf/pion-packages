///| RFC 9113 HTTP/2 Frame Codec (9-byte header + all 10 frame types + unknown passthrough).
///| Stub for Red phase.

///|
pub fn validate_client_preface(data : Bytes) -> Result[Int, H2Error] {
  let _ = data
  Err(H2Error::InvalidPreface)
}

///|
pub fn decode_frame_header(
  data : Bytes,
  offset : Int,
) -> Result[FrameHeader, H2Error] {
  let _ = data
  let _ = offset
  Err(H2Error::Incomplete)
}

///|
pub fn decode_frame(
  data : Bytes,
  offset : Int,
  max_frame_size : Int,
) -> Result[(Frame, Int), H2Error] {
  let _ = data
  let _ = offset
  let _ = max_frame_size
  Err(H2Error::Incomplete)
}

///|
pub fn encode_frame(frame : Frame) -> Result[Bytes, H2Error] {
  let _ = frame
  Err(H2Error::ProtocolError("unimplemented"))
}
