///| RFC 9113 HTTP/2 Frame Codec (9-byte FrameHeader + all 10 frame types + unknown passthrough)
///| and Client Connection Preface validation.

///|
let preface_bytes_const : Bytes = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".to_bytes()

///| Validate the 24-byte RFC 9113 §3.4 HTTP/2 client connection preface.
///| Returns `Ok(24)` on exact match, `Err(Incomplete)` if fewer than 24 bytes match so far,
///| or `Err(InvalidPreface)` on any mismatch.
pub fn validate_client_preface(data : Bytes) -> Result[Int, H2Error] {
  let target = preface_bytes_const
  let n = data.length()
  let check_len = if n < 24 { n } else { 24 }
  let mut i = 0
  while i < check_len {
    if data[i] != target[i] {
      return Err(H2Error::InvalidPreface)
    }
    i = i + 1
  }
  if n < 24 {
    return Err(H2Error::Incomplete)
  }
  Ok(24)
}

///|
fn read_u16_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

///|
fn read_u24_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 16) | (b[off + 1].to_int() << 8) | b[off + 2].to_int()
}

///|
fn read_u32_be(b : Bytes, off : Int) -> Int64 {
  ((b[off].to_int().to_int64() & 0xFFL) << 24) |
  ((b[off + 1].to_int().to_int64() & 0xFFL) << 16) |
  ((b[off + 2].to_int().to_int64() & 0xFFL) << 8) |
  (b[off + 3].to_int().to_int64() & 0xFFL)
}

///|
fn read_u31_be(b : Bytes, off : Int) -> Int {
  ((b[off].to_int() & 0x7F) << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn write_frame_header(
  out : Bytes,
  length : Int,
  frame_type : Int,
  flags : Int,
  stream_id : Int,
) -> Unit {
  out[0] = ((length >> 16) & 0xFF).to_byte()
  out[1] = ((length >> 8) & 0xFF).to_byte()
  out[2] = (length & 0xFF).to_byte()
  out[3] = (frame_type & 0xFF).to_byte()
  out[4] = (flags & 0xFF).to_byte()
  out[5] = ((stream_id >> 24) & 0x7F).to_byte()
  out[6] = ((stream_id >> 16) & 0xFF).to_byte()
  out[7] = ((stream_id >> 8) & 0xFF).to_byte()
  out[8] = (stream_id & 0xFF).to_byte()
}

///|
fn write_u32_be(out : Bytes, off : Int, v : Int64) -> Unit {
  out[off] = ((v >> 24) & 0xFFL).to_int().to_byte()
  out[off + 1] = ((v >> 16) & 0xFFL).to_int().to_byte()
  out[off + 2] = ((v >> 8) & 0xFFL).to_int().to_byte()
  out[off + 3] = (v & 0xFFL).to_int().to_byte()
}

///|
fn copy_bytes(dst : Bytes, dst_off : Int, src : Bytes) -> Unit {
  let n = src.length()
  let mut i = 0
  while i < n {
    dst[dst_off + i] = src[i]
    i = i + 1
  }
}

///| Decode a 9-byte RFC 9113 §4.1 FrameHeader at `data[offset..]`.
pub fn decode_frame_header(
  data : Bytes,
  offset : Int,
) -> Result[FrameHeader, H2Error] {
  if offset < 0 || offset + 9 > data.length() {
    return Err(H2Error::Incomplete)
  }
  let length = read_u24_be(data, offset)
  let ftype = data[offset + 3].to_int()
  let flags = data[offset + 4].to_int()
  let sid = read_u31_be(data, offset + 5)
  Ok(FrameHeader::new(length, ftype, flags, sid))
}

///| Decode one complete RFC 9113 HTTP/2 frame starting at `data[offset..]`.
///| Enforces `max_frame_size` and all per-frame length, stream_id, padding, and setting rules.
///| Returns `Ok((frame, next_offset))`.
pub fn decode_frame(
  data : Bytes,
  offset : Int,
  max_frame_size : Int,
) -> Result[(Frame, Int), H2Error] {
  let hdr = match decode_frame_header(data, offset) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  if hdr.length > max_frame_size {
    return Err(H2Error::FrameSizeError("frame payload exceeds max_frame_size"))
  }
  let payload_start = offset + 9
  let payload_end = payload_start + hdr.length
  if payload_end > data.length() {
    return Err(H2Error::Incomplete)
  }

  let ftype = hdr.frame_type
  let flags = hdr.flags
  let sid = hdr.stream_id
  let plen = hdr.length

  if ftype == frame_data {
    if sid == 0 {
      return Err(H2Error::ProtocolError("DATA frame on stream 0"))
    }
    let padded = (flags & flag_padded) != 0
    let end_stream = (flags & flag_end_stream) != 0
    let mut start = payload_start
    let mut end = payload_end
    if padded {
      if plen < 1 {
        return Err(H2Error::FrameSizeError("padded DATA frame missing pad length"))
      }
      let pad_len = data[start].to_int()
      start = start + 1
      if pad_len >= plen {
        return Err(H2Error::ProtocolError("DATA padding length >= payload length"))
      }
      end = payload_end - pad_len
    }
    let body = data.slice(start, end)
    return Ok((Frame::Data(sid, body, end_stream), payload_end))
  }

  if ftype == frame_headers {
    if sid == 0 {
      return Err(H2Error::ProtocolError("HEADERS frame on stream 0"))
    }
    let padded = (flags & flag_padded) != 0
    let has_prio = (flags & flag_priority) != 0
    let end_stream = (flags & flag_end_stream) != 0
    let end_headers = (flags & flag_end_headers) != 0
    let mut start = payload_start
    let mut end = payload_end
    let mut pad_len = 0
    if padded {
      if plen < 1 {
        return Err(H2Error::FrameSizeError("padded HEADERS frame missing pad length"))
      }
      pad_len = data[start].to_int()
      start = start + 1
    }
    let prio : Option[PrioritySpec] = if has_prio {
      if start + 5 > payload_end {
        return Err(H2Error::FrameSizeError("HEADERS frame truncated priority"))
      }
      let raw_dep = read_u32_be(data, start)
      let excl = (raw_dep & 0x80000000L) != 0L
      let dep = (raw_dep & 0x7FFFFFFFL).to_int()
      let weight = data[start + 4].to_int()
      start = start + 5
      if dep == sid {
        return Err(H2Error::ProtocolError("HEADERS stream depends on itself"))
      }
      Some(PrioritySpec::new(excl, dep, weight))
    } else {
      None
    }
    if padded {
      if start + pad_len > payload_end {
        return Err(H2Error::ProtocolError("HEADERS padding exceeds remaining payload"))
      }
      end = payload_end - pad_len
    }
    let frag = data.slice(start, end)
    return Ok((Frame::Headers(sid, frag, end_stream, end_headers, prio), payload_end))
  }

  if ftype == frame_priority {
    if sid == 0 {
      return Err(H2Error::ProtocolError("PRIORITY frame on stream 0"))
    }
    if plen != 5 {
      return Err(H2Error::FrameSizeError("PRIORITY frame length must be 5"))
    }
    let raw_dep = read_u32_be(data, payload_start)
    let excl = (raw_dep & 0x80000000L) != 0L
    let dep = (raw_dep & 0x7FFFFFFFL).to_int()
    let weight = data[payload_start + 4].to_int()
    if dep == sid {
      return Err(H2Error::ProtocolError("PRIORITY stream depends on itself"))
    }
    return Ok((Frame::Priority(sid, PrioritySpec::new(excl, dep, weight)), payload_end))
  }

  if ftype == frame_rst_stream {
    if sid == 0 {
      return Err(H2Error::ProtocolError("RST_STREAM frame on stream 0"))
    }
    if plen != 4 {
      return Err(H2Error::FrameSizeError("RST_STREAM frame length must be 4"))
    }
    let code = read_u32_be(data, payload_start).to_int()
    return Ok((Frame::RstStream(sid, code), payload_end))
  }

  if ftype == frame_settings {
    if sid != 0 {
      return Err(H2Error::ProtocolError("SETTINGS frame with non-zero stream_id"))
    }
    let ack = (flags & flag_ack) != 0
    if ack {
      if plen != 0 {
        return Err(H2Error::FrameSizeError("SETTINGS ACK must have length 0"))
      }
      return Ok((Frame::Settings([], true), payload_end))
    }
    if plen % 6 != 0 {
      return Err(H2Error::FrameSizeError("SETTINGS payload length must be multiple of 6"))
    }
    let settings : Array[Setting] = []
    let mut p = payload_start
    while p < payload_end {
      let id = read_u16_be(data, p)
      let v = read_u32_be(data, p + 2)
      if id == setting_enable_push && v != 0L && v != 1L {
        return Err(H2Error::ProtocolError("SETTINGS_ENABLE_PUSH must be 0 or 1"))
      }
      if id == setting_initial_window_size && v > max_window_size.to_int64() {
        return Err(H2Error::FlowControlError("SETTINGS_INITIAL_WINDOW_SIZE exceeds 2^31-1"))
      }
      if id == setting_max_frame_size &&
      (v < default_max_frame_size.to_int64() || v > max_frame_size_upper.to_int64()) {
        return Err(H2Error::ProtocolError("SETTINGS_MAX_FRAME_SIZE out of range"))
      }
      settings.push(Setting::new(id, v))
      p = p + 6
    }
    return Ok((Frame::Settings(settings, false), payload_end))
  }

  if ftype == frame_push_promise {
    if sid == 0 {
      return Err(H2Error::ProtocolError("PUSH_PROMISE frame on stream 0"))
    }
    let padded = (flags & flag_padded) != 0
    let end_headers = (flags & flag_end_headers) != 0
    let mut start = payload_start
    let mut end = payload_end
    let mut pad_len = 0
    if padded {
      if plen < 1 {
        return Err(H2Error::FrameSizeError("padded PUSH_PROMISE missing pad length"))
      }
      pad_len = data[start].to_int()
      start = start + 1
    }
    if start + 4 > payload_end {
      return Err(H2Error::FrameSizeError("PUSH_PROMISE missing promised stream id"))
    }
    let promised_id = read_u31_be(data, start)
    start = start + 4
    if promised_id == 0 {
      return Err(H2Error::ProtocolError("PUSH_PROMISE promised stream_id cannot be 0"))
    }
    if padded {
      if start + pad_len > payload_end {
        return Err(H2Error::ProtocolError("PUSH_PROMISE padding exceeds remaining payload"))
      }
      end = payload_end - pad_len
    }
    let frag = data.slice(start, end)
    return Ok((Frame::PushPromise(sid, promised_id, frag, end_headers), payload_end))
  }

  if ftype == frame_ping {
    if sid != 0 {
      return Err(H2Error::ProtocolError("PING frame with non-zero stream_id"))
    }
    if plen != 8 {
      return Err(H2Error::FrameSizeError("PING frame length must be 8"))
    }
    let ack = (flags & flag_ack) != 0
    let opaque = data.slice(payload_start, payload_end)
    return Ok((Frame::Ping(opaque, ack), payload_end))
  }

  if ftype == frame_goaway {
    if sid != 0 {
      return Err(H2Error::ProtocolError("GOAWAY frame with non-zero stream_id"))
    }
    if plen < 8 {
      return Err(H2Error::FrameSizeError("GOAWAY frame length must be >= 8"))
    }
    let last_sid = read_u31_be(data, payload_start)
    let err_code = read_u32_be(data, payload_start + 4).to_int()
    let debug_data = data.slice(payload_start + 8, payload_end)
    return Ok((Frame::GoAway(last_sid, err_code, debug_data), payload_end))
  }

  if ftype == frame_window_update {
    if plen != 4 {
      return Err(H2Error::FrameSizeError("WINDOW_UPDATE frame length must be 4"))
    }
    let inc = read_u31_be(data, payload_start)
    if inc == 0 {
      return Err(H2Error::ProtocolError("WINDOW_UPDATE increment cannot be 0"))
    }
    return Ok((Frame::WindowUpdate(sid, inc), payload_end))
  }

  if ftype == frame_continuation {
    if sid == 0 {
      return Err(H2Error::ProtocolError("CONTINUATION frame on stream 0"))
    }
    let end_headers = (flags & flag_end_headers) != 0
    let frag = data.slice(payload_start, payload_end)
    return Ok((Frame::Continuation(sid, frag, end_headers), payload_end))
  }

  // Unknown extension frame passthrough (RFC 9113 §4.1)
  let body = data.slice(payload_start, payload_end)
  Ok((Frame::Unknown(hdr, body), payload_end))
}

///| Encode an RFC 9113 HTTP/2 Frame to wire Bytes.
pub fn encode_frame(frame : Frame) -> Result[Bytes, H2Error] {
  match frame {
    Frame::Data(sid, data, end_stream) => {
      if sid <= 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("DATA invalid stream_id"))
      }
      let plen = data.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("DATA payload exceeds 2^24-1"))
      }
      let mut out = Bytes::new(9 + plen)
      let flags = if end_stream { flag_end_stream } else { 0 }
      write_frame_header(out, plen, frame_data, flags, sid)
      copy_bytes(out, 9, data)
      Ok(out)
    }
    Frame::Headers(sid, frag, end_stream, end_headers, prio) => {
      if sid <= 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("HEADERS invalid stream_id"))
      }
      let mut flags = 0
      if end_stream {
        flags = flags | flag_end_stream
      }
      if end_headers {
        flags = flags | flag_end_headers
      }
      let extra = match prio {
        Some(p) => {
          if p.dependency == sid {
            return Err(H2Error::ProtocolError("HEADERS stream depends on itself"))
          }
          flags = flags | flag_priority
          5
        }
        None => 0
      }
      let plen = extra + frag.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("HEADERS payload exceeds 2^24-1"))
      }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, frame_headers, flags, sid)
      let mut pos = 9
      match prio {
        Some(p) => {
          let dep_word = if p.exclusive {
            (p.dependency.to_int64() & 0x7FFFFFFFL) | 0x80000000L
          } else {
            p.dependency.to_int64() & 0x7FFFFFFFL
          }
          write_u32_be(out, pos, dep_word)
          out[pos + 4] = (p.weight & 0xFF).to_byte()
          pos = pos + 5
        }
        None => ()
      }
      copy_bytes(out, pos, frag)
      Ok(out)
    }
    Frame::Priority(sid, p) => {
      if sid <= 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("PRIORITY invalid stream_id"))
      }
      if p.dependency == sid {
        return Err(H2Error::ProtocolError("PRIORITY stream depends on itself"))
      }
      let mut out = Bytes::new(14)
      write_frame_header(out, 5, frame_priority, 0, sid)
      let dep_word = if p.exclusive {
        (p.dependency.to_int64() & 0x7FFFFFFFL) | 0x80000000L
      } else {
        p.dependency.to_int64() & 0x7FFFFFFFL
      }
      write_u32_be(out, 9, dep_word)
      out[13] = (p.weight & 0xFF).to_byte()
      Ok(out)
    }
    Frame::RstStream(sid, code) => {
      if sid <= 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("RST_STREAM invalid stream_id"))
      }
      let mut out = Bytes::new(13)
      write_frame_header(out, 4, frame_rst_stream, 0, sid)
      write_u32_be(out, 9, code.to_int64() & 0xFFFFFFFFL)
      Ok(out)
    }
    Frame::Settings(settings, ack) => {
      if ack {
        if settings.length() != 0 {
          return Err(H2Error::FrameSizeError("SETTINGS ACK cannot carry parameters"))
        }
        let mut out = Bytes::new(9)
        write_frame_header(out, 0, frame_settings, flag_ack, 0)
        return Ok(out)
      }
      let plen = settings.length() * 6
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("SETTINGS payload exceeds 2^24-1"))
      }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, frame_settings, 0, 0)
      let mut i = 0
      while i < settings.length() {
        let s = settings[i]
        let off = 9 + i * 6
        out[off] = ((s.id >> 8) & 0xFF).to_byte()
        out[off + 1] = (s.id & 0xFF).to_byte()
        write_u32_be(out, off + 2, s.value & 0xFFFFFFFFL)
        i = i + 1
      }
      Ok(out)
    }
    Frame::PushPromise(sid, promised_id, frag, end_headers) => {
      if sid <= 0 || sid > max_stream_id || promised_id <= 0 || promised_id > max_stream_id {
        return Err(H2Error::ProtocolError("PUSH_PROMISE invalid stream_id"))
      }
      let plen = 4 + frag.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("PUSH_PROMISE payload exceeds 2^24-1"))
      }
      let flags = if end_headers { flag_end_headers } else { 0 }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, frame_push_promise, flags, sid)
      write_u32_be(out, 9, promised_id.to_int64() & 0x7FFFFFFFL)
      copy_bytes(out, 13, frag)
      Ok(out)
    }
    Frame::Ping(opaque, ack) => {
      if opaque.length() != 8 {
        return Err(H2Error::FrameSizeError("PING opaque data must be 8 bytes"))
      }
      let flags = if ack { flag_ack } else { 0 }
      let mut out = Bytes::new(17)
      write_frame_header(out, 8, frame_ping, flags, 0)
      copy_bytes(out, 9, opaque)
      Ok(out)
    }
    Frame::GoAway(last_sid, code, debug_data) => {
      if last_sid < 0 || last_sid > max_stream_id {
        return Err(H2Error::ProtocolError("GOAWAY invalid last_stream_id"))
      }
      let plen = 8 + debug_data.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("GOAWAY payload exceeds 2^24-1"))
      }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, frame_goaway, 0, 0)
      write_u32_be(out, 9, last_sid.to_int64() & 0x7FFFFFFFL)
      write_u32_be(out, 13, code.to_int64() & 0xFFFFFFFFL)
      copy_bytes(out, 17, debug_data)
      Ok(out)
    }
    Frame::WindowUpdate(sid, inc) => {
      if sid < 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("WINDOW_UPDATE invalid stream_id"))
      }
      if inc <= 0 || inc > max_window_size {
        return Err(H2Error::ProtocolError("WINDOW_UPDATE increment must be 1..2^31-1"))
      }
      let mut out = Bytes::new(13)
      write_frame_header(out, 4, frame_window_update, 0, sid)
      write_u32_be(out, 9, inc.to_int64() & 0x7FFFFFFFL)
      Ok(out)
    }
    Frame::Continuation(sid, frag, end_headers) => {
      if sid <= 0 || sid > max_stream_id {
        return Err(H2Error::ProtocolError("CONTINUATION invalid stream_id"))
      }
      let plen = frag.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("CONTINUATION payload exceeds 2^24-1"))
      }
      let flags = if end_headers { flag_end_headers } else { 0 }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, frame_continuation, flags, sid)
      copy_bytes(out, 9, frag)
      Ok(out)
    }
    Frame::Unknown(hdr, body) => {
      let plen = body.length()
      if plen > max_frame_size_upper {
        return Err(H2Error::FrameSizeError("Unknown frame payload exceeds 2^24-1"))
      }
      let mut out = Bytes::new(9 + plen)
      write_frame_header(out, plen, hdr.frame_type, hdr.flags, hdr.stream_id)
      copy_bytes(out, 9, body)
      Ok(out)
    }
  }
}
