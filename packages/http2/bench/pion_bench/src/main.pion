///| Pion Native head-to-head benchmark for packages/http2.
///| Modes:
///|   hpack_decode <hpack_stream.bin>   (100,000 header blocks: 100 rounds x 1,000 blocks)
///|   hpack_encode <headers_plain.bin>  (100,000 header blocks: 100 rounds x 1,000 blocks, Huffman ON)
///|   frame_stream <frame_stream.bin>   (200,000 frames: 100 rounds x 2,000 frames, codec level)

import "http2"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let n = s.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, s.code_unit_at(i).to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_bytes(h0 : Int64, b : Bytes) -> Int64 {
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_headers(h0 : Int64, hs : Array[http2::HeaderField]) -> Int64 {
  let mut h = mix(h0, hs.length().to_int64())
  let mut i = 0
  while i < hs.length() {
    let f = hs[i]
    h = hash_str(h, f.name)
    h = hash_str(h, f.value)
    i = i + 1
  }
  h
}

///| Order-insensitive header set hash (matches Rust h2::Codec HeaderMap + Go Framer).
fn hash_headers_set(h0 : Int64, hs : Array[http2::HeaderField]) -> Int64 {
  let mut sum = 0L
  let mut i = 0
  while i < hs.length() {
    sum = (sum + hash_str(hash_str(0L, hs[i].name), hs[i].value)) % 1000000007L
    i = i + 1
  }
  mix(mix(h0, hs.length().to_int64()), sum)
}

///|
fn b2i(b : Bool) -> Int64 {
  if b {
    1L
  } else {
    0L
  }
}

///|
fn read_u16(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

///|
fn read_u32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn bench_hpack_decode(world : World, data : Bytes) -> Int {
  let count = read_u32(data, 0)
  let blocks : Array[Bytes] = []
  let mut pos = 4
  let mut i = 0
  while i < count {
    let blen = read_u32(data, pos)
    pos = pos + 4
    blocks.push(data.slice(pos, pos + blen))
    pos = pos + blen
    i = i + 1
  }

  let mut total_blocks = 0L
  let mut total_headers = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 100 {
    let dec = http2::HpackDecoder::new(4096)
    let mut bi = 0
    while bi < count {
      match dec.decode(blocks[bi]) {
        Ok(hs) => {
          total_blocks = total_blocks + 1L
          total_headers = total_headers + hs.length().to_int64()
          checksum = hash_headers(checksum, hs)
        }
        Err(e) => {
          io_println(world, "decode error: " + http2::h2_error_message(e))
          return 1
        }
      }
      bi = bi + 1
    }
    round = round + 1
  }

  io_println(world, "mode=hpack_decode")
  io_println(world, "blocks=" + total_blocks.to_string())
  io_println(world, "headers=" + total_headers.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_hpack_encode(world : World, data : Bytes) -> Int {
  let count = read_u32(data, 0)
  let lists : Array[Array[http2::HeaderField]] = []
  let mut pos = 4
  let mut i = 0
  while i < count {
    let hcount = read_u16(data, pos)
    pos = pos + 2
    let hs : Array[http2::HeaderField] = []
    let mut j = 0
    while j < hcount {
      let nlen = read_u16(data, pos)
      pos = pos + 2
      let name = data.slice(pos, pos + nlen).to_string()
      pos = pos + nlen
      let vlen = read_u16(data, pos)
      pos = pos + 2
      let val_s = data.slice(pos, pos + vlen).to_string()
      pos = pos + vlen
      let sens = data[pos].to_int() != 0
      pos = pos + 1
      hs.push(http2::HeaderField::{ name: name, value: val_s, sensitive: sens })
      j = j + 1
    }
    lists.push(hs)
    i = i + 1
  }

  let mut total_blocks = 0L
  let mut total_headers = 0L
  let mut encoded_sink = 0L
  let mut verify_checksum = 0L
  let mut round = 0
  while round < 100 {
    let enc = http2::HpackEncoder::with_huffman(4096, true)
    let verify_round = round == 99
    let dec = http2::HpackDecoder::new(4096)
    let mut bi = 0
    while bi < count {
      let hs = lists[bi]
      let wire = enc.encode(hs)
      total_blocks = total_blocks + 1L
      total_headers = total_headers + hs.length().to_int64()
      encoded_sink = encoded_sink + wire.length().to_int64()
      if verify_round {
        match dec.decode(wire) {
          Ok(rt) => verify_checksum = hash_headers(verify_checksum, rt)
          Err(e) => {
            io_println(world, "verify decode error: " + http2::h2_error_message(e))
            return 1
          }
        }
      }
      bi = bi + 1
    }
    round = round + 1
  }

  if encoded_sink <= 0L {
    return 1
  }
  io_println(world, "mode=hpack_encode")
  io_println(world, "blocks=" + total_blocks.to_string())
  io_println(world, "headers=" + total_headers.to_string())
  io_println(world, "verify_checksum=" + verify_checksum.to_string())
  0
}

///|
fn bench_frame_stream(world : World, data : Bytes) -> Int {
  let mut total_frames = 0L
  let mut total_events = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 100 {
    let dec = http2::HpackDecoder::with_limits(4096, 65536)
    let mut pos = 0
    let n = data.length()
    let mut psid = 0
    let mut pes = false
    let mut parts : Array[Bytes] = []
    while pos < n {
      match http2::decode_frame(data, pos, 16384) {
        Ok((frame, next_pos)) => {
          total_frames = total_frames + 1L
          pos = next_pos
          match frame {
            http2::Frame::Headers(sid, frag, es, eh, _) => {
              if eh {
                match dec.decode(frag) {
                  Ok(hs) => {
                    total_events = total_events + 1L
                    checksum = mix(mix(mix(checksum, 1L), sid.to_int64()), b2i(es))
                    checksum = hash_headers_set(checksum, hs)
                  }
                  Err(e) => {
                    io_println(world, "hpack error: " + http2::h2_error_message(e))
                    return 1
                  }
                }
              } else {
                psid = sid
                pes = es
                parts = [frag]
              }
            }
            http2::Frame::Continuation(_, frag, eh) => {
              parts.push(frag)
              if eh {
                let mut tot = 0
                let mut k = 0
                while k < parts.length() {
                  tot = tot + parts[k].length()
                  k = k + 1
                }
                let blk = Bytes::new(tot)
                let mut w = 0
                k = 0
                while k < parts.length() {
                  let p = parts[k]
                  let mut j = 0
                  while j < p.length() {
                    blk[w] = p[j]
                    w = w + 1
                    j = j + 1
                  }
                  k = k + 1
                }
                match dec.decode(blk) {
                  Ok(hs) => {
                    total_events = total_events + 1L
                    checksum = mix(mix(mix(checksum, 1L), psid.to_int64()), b2i(pes))
                    checksum = hash_headers_set(checksum, hs)
                  }
                  Err(e) => {
                    io_println(world, "hpack error: " + http2::h2_error_message(e))
                    return 1
                  }
                }
              }
            }
            http2::Frame::Data(sid, body, es) => {
              total_events = total_events + 1L
              checksum = hash_bytes(mix(mix(mix(checksum, 2L), sid.to_int64()), b2i(es)), body)
            }
            http2::Frame::Settings(_, ack) => {
              total_events = total_events + 1L
              checksum = mix(mix(checksum, 3L), b2i(ack))
            }
            http2::Frame::WindowUpdate(sid, inc) => {
              total_events = total_events + 1L
              checksum = mix(mix(mix(checksum, 4L), sid.to_int64()), inc.to_int64())
            }
            http2::Frame::Ping(op, ack) => {
              total_events = total_events + 1L
              checksum = hash_bytes(mix(mix(checksum, 5L), b2i(ack)), op)
            }
            http2::Frame::Priority(_, _) => {
              total_events = total_events + 1L
              checksum = mix(checksum, 6L)
            }
            _ => ()
          }
        }
        Err(e) => {
          io_println(world, "frame decode error: " + http2::h2_error_message(e))
          return 1
        }
      }
    }
    round = round + 1
  }

  io_println(world, "mode=frames")
  io_println(world, "frames=" + total_frames.to_string())
  io_println(world, "events=" + total_events.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: http2_bench <hpack_decode|hpack_encode|frame_stream> <corpus.bin>")
    return 1
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  if mode == "hpack_decode" {
    bench_hpack_decode(world, data)
  } else if mode == "hpack_encode" {
    bench_hpack_encode(world, data)
  } else if mode == "frame_stream" {
    bench_frame_stream(world, data)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
