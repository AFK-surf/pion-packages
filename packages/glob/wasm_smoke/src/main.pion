///| Wasm32 smoke entry for the `glob` package.

import "glob"

///|
pub fn smoke() -> Int {
  let g = match glob::compile("src/**/*.pion") {
    Ok(v) => v
    Err(_) => return 1
  }
  let m1 = if g.is_match("src/pkg/main.pion") { 1 } else { 0 }
  let set = match glob::compile_set(["*.rs", "src/**", "**/Cargo.toml", "{a,b}.txt"]) {
    Ok(s) => s
    Err(_) => return 2
  }
  let hits = set.matches("src/main.rs")
  let gi = match glob::parse_gitignore("*.log\n!important.log\nbuild/\n") {
    Ok(v) => v
    Err(_) => return 3
  }
  let ig1 = if gi.is_ignored("app.log", false) { 1 } else { 0 }
  let ig2 = if gi.is_ignored("important.log", false) { 0 } else { 1 }
  let ig3 = if gi.is_ignored("build", true) { 1 } else { 0 }
  m1 + hits.length() + ig1 + ig2 + ig3
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r == 6 {
    0
  } else {
    1
  }
}
