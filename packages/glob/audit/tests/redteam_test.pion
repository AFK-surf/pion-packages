///| GENERATED by ../gen_redteam.py -- do not edit. Each expected value was read from the real
///| Rust globset 0.4.21 / ignore 0.4.34 or `git check-ignore`. A FAILURE here is the evidence.
import "glob"

fn opts(o : Int) -> glob::GlobOptions {
  glob::GlobOptions::{
    case_insensitive: (o & 1) != 0,
    literal_separator: (o & 2) != 0,
    backslash_escape: (o & 4) == 0,
    empty_alternates: (o & 8) != 0,
    allow_unclosed_class: (o & 16) != 0,
  }
}

fn expect_glob(pat : String, o : Int, path : String, want : Bool) -> Unit {
  match glob::compile_with(pat, opts(o)) {
    Ok(g) => debug_assert(g.is_match(path) == want, "Glob " + pat + " on " + path + ": oracle says " + want.to_string())
    Err(e) => debug_assert(false, "compile failed: " + e.message)
  }
}

fn expect_set(pat : String, o : Int, path : String, want : Bool) -> Unit {
  match glob::compile_with(pat, opts(o)) {
    Ok(g) =>
    match glob::compile_set_from_globs([g]) {
      Ok(s) => debug_assert(s.is_match(path) == want, "GlobSet " + pat + " on " + path + ": oracle says " + want.to_string())
      Err(e) => debug_assert(false, "set failed: " + e.message)
    }
    Err(e) => debug_assert(false, "compile failed: " + e.message)
  }
}

fn expect_git(content : String, path : String, is_dir : Bool, want : Bool) -> Unit {
  match glob::parse_gitignore(content) {
    Ok(g) => debug_assert(g.is_ignored_with_parents(path, is_dir) == want, "gitignore on " + path + ": git says ignored=" + want.to_string())
    Err(e) => debug_assert(false, "parse_gitignore rejected a file git accepts: " + e.message)
  }
}

test "r1_set_brace_doublestar_slash_false_positive" {
  expect_set("{**/}", 0, "a", false)
}

test "r1_set_brace_doublestar_slash_deep_path" {
  expect_set("{**/}", 0, "src/main.rs", false)
}

test "r2_qmark_is_one_byte_not_cjk" {
  expect_glob("?", 0, "中", false)
}

test "r2_qmark_is_one_byte_not_emoji" {
  expect_glob("?", 0, "🎉", false)
}

test "r2_qmark_x3_matches_3byte_cjk" {
  expect_glob("???", 0, "中", true)
}

test "r2_qmark_x4_matches_4byte_emoji" {
  expect_glob("????", 0, "🎉", true)
}

test "r2_qmark_in_ext_glob" {
  expect_glob("?.rs", 0, "中.rs", false)
}

test "r2_set_qmark_cjk" {
  expect_set("?", 0, "中", false)
}

test "r2_class_cjk_literal" {
  expect_glob("[中]", 0, "中", false)
}

test "r2_class_greek_range" {
  expect_glob("[α-ω]", 0, "σ", false)
}

test "r2_negated_class_cjk" {
  expect_glob("[!中]", 0, "文", false)
}

test "r2_negated_ascii_class_on_cjk" {
  expect_glob("[!a]", 0, "中", false)
}

test "r3_posix_digit_is_not_a_class_in_globset" {
  expect_glob("[[:digit:]]", 0, "0", false)
}

test "r3_posix_alpha_is_not_a_class_in_globset" {
  expect_glob("[[:alpha:]]", 0, "a", false)
}

test "r3_posix_blank_parses_as_class_plus_bracket" {
  expect_glob("[[:blank:]]", 0, "a]", true)
}

test "r4_upstream_matchslash4_class_slash_litsep" {
  expect_glob("abc[/]def", 2, "abc/def", true)
}

test "r4_class_slash_litsep_set" {
  expect_set("a[/]b", 2, "a/b", true)
}

test "r4_negated_class_matches_slash_litsep" {
  expect_glob("a[!x]b", 2, "a/b", true)
}

test "r5_star_dot_on_dotdot_glob" {
  expect_glob("*.", 0, "..", true)
}

test "g1_bad_range_line_must_not_kill_file" {
  expect_git("foo\n[z-a]\n", "foo", false, true)
}

test "g1_bad_range_first_line" {
  expect_git("[z-a]oo\nfoo\n", "foo", false, true)
}

test "g1_unclosed_brace_line" {
  expect_git("foo\n{bad\n", "foo", false, true)
}

test "g1_unopened_brace_line" {
  expect_git("foo\nbar}\n", "foo", false, true)
}

test "g1_dangling_backslash_line" {
  expect_git("foo\nbar\\\n", "foo", false, true)
}

test "g1_negation_survives_bad_line" {
  expect_git("*.log\n[z-a]\n!a.log\n", "b.log", false, true)
}

test "g2_qmark_cjk_vs_git" {
  expect_git("?文\n", "中文", false, false)
}

test "g2_qmark_x2_vs_git" {
  expect_git("??\n", "中文", false, false)
}

test "g2_qmark_x4_emoji_vs_git" {
  expect_git("????\n", "🎉", false, true)
}

test "g2_class_cjk_vs_git" {
  expect_git("[中]文\n", "中文", false, false)
}
