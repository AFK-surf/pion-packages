///| Pion side of the red-team differential: replays the same case file as `oracle/`.
import "glob"

fn hexval(c : Int) -> Int {
  if c >= 97 {
    c - 87
  } else {
    c - 48
  }
}

fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

fn options(o : Int) -> glob::GlobOptions {
  glob::GlobOptions::{
    case_insensitive: (o & 1) != 0,
    literal_separator: (o & 2) != 0,
    backslash_escape: (o & 4) == 0,
    empty_alternates: (o & 8) != 0,
    allow_unclosed_class: (o & 16) != 0,
  }
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

fn tri(m : glob::MatchResult) -> String {
  if glob::match_is_ignore(m) {
    "I"
  } else if glob::match_is_whitelist(m) {
    "W"
  } else {
    "N"
  }
}

fn field(f : Array[String], i : Int) -> String {
  if i < f.length() {
    f[i]
  } else {
    ""
  }
}

fn diff(world : World, file : String) -> Int {
  let text = match fs_read(world, file) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = text.split("\n")
  let out = StringBuilder::new()
  let mut single : Option[glob::Glob] = None
  let mut set : Option[glob::GlobSet] = None
  let mut ignore : Option[glob::Gitignore] = None
  let mut mode = 0
  let buf : Array[Int] = Array::new()
  let mut li = 0
  while li < lines.length() {
    let f = lines[li].split(" ")
    li = li + 1
    let tag = f[0]
    if tag == "G" {
      mode = 1
      single = None
      set = None
      match glob::compile_with(unhex(field(f, 2)), options(parse_int(field(f, 1)))) {
        Ok(g) => {
          single = Some(g)
          match glob::compile_set_from_globs([g]) {
            Ok(s) => set = Some(s)
            Err(_) => ()
          }
        }
        Err(_) => ()
      }
    } else if tag == "M" {
      mode = 2
      set = None
      let o = options(parse_int(field(f, 1)))
      let hs = field(f, 2).split(",")
      let gs : Array[glob::Glob] = Array::new()
      let mut ok = true
      let mut k = 0
      while k < hs.length() {
        match glob::compile_with(unhex(hs[k]), o) {
          Ok(g) => gs.push(g)
          Err(_) => ok = false
        }
        k = k + 1
      }
      if ok {
        match glob::compile_set_from_globs(gs) {
          Ok(s) => set = Some(s)
          Err(_) => ()
        }
      }
    } else if tag == "I" {
      mode = 3
      ignore = match glob::parse_gitignore(unhex(field(f, 1))) {
        Ok(g) => Some(g)
        Err(_) => None
      }
    } else if tag == "Q" {
      let p = unhex(field(f, 1))
      if mode == 1 {
        match (single, set) {
          (Some(g), Some(s)) => {
            out.write_string(if g.is_match(p) { "1" } else { "0" })
            out.write_string(if s.is_match(p) { "1\n" } else { "0\n" })
          }
          _ => out.write_string("E\n")
        }
      } else {
        match set {
          Some(s) => {
            s.matches_into(p, buf)
            let mut k = 0
            while k < buf.length() {
              if k > 0 {
                out.write_string(",")
              }
              out.write_string(buf[k].to_string())
              k = k + 1
            }
            out.write_string("\n")
          }
          None => out.write_string("E\n")
        }
      }
    } else if tag == "D" {
      let p = unhex(field(f, 1))
      let d = field(f, 2) == "1"
      match ignore {
        Some(g) => {
          out.write_string(tri(g.matched(p, d)))
          out.write_string(" ")
          out.write_string(tri(g.matched_path_or_any_parents(p, d)))
          out.write_string(if g.is_ignored_with_parents(p, d) { " 1\n" } else { " 0\n" })
        }
        None => out.write_string("E E E\n")
      }
    }
  }
  io_print(world, out.to_string())
  0
}

fn non_empty_lines(s : String) -> Array[String] {
  let parts = s.split("\n")
  let v : Array[String] = Array::new()
  let mut i = 0
  while i < parts.length() {
    if parts[i].length() > 0 {
      v.push(parts[i])
    }
    i = i + 1
  }
  v
}

fn bench(world : World, mode : String, rules_f : String, paths_f : String, iters : Int) -> Int {
  let rules = match fs_read(world, rules_f) {
    Ok(s) => non_empty_lines(s)
    Err(_) => return 2
  }
  let set = match glob::compile_set(rules) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "compile error: " + e.message)
      return 3
    }
  }
  io_println(world, "rules=" + rules.length().to_string())
  if mode == "build" {
    return 0
  }
  let paths = match fs_read(world, paths_f) {
    Ok(s) => non_empty_lines(s)
    Err(_) => return 2
  }
  let buf : Array[Int] = Array::new()
  let mut hits = 0L
  let mut sum = 0L
  let mut it = 0
  while it < iters {
    let mut p = 0
    while p < paths.length() {
      set.matches_into(paths[p], buf)
      hits = hits + buf.length().to_int64()
      let mut k = 0
      while k < buf.length() {
        sum = (sum * 131L + (buf[k] + 1).to_int64()) % 1000000007L
        k = k + 1
      }
      p = p + 1
    }
    it = it + 1
  }
  io_println(world, "hits=" + hits.to_string())
  io_println(world, "checksum=" + sum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let a = world_args(world)
  if a.length() >= 3 && a[1] == "diff" {
    return diff(world, a[2])
  }
  if a.length() >= 6 && a[1] == "bench" {
    return bench(world, a[2], a[3], a[4], parse_int(a[5]))
  }
  io_println(world, "usage: diff <cases> | bench <build|match> <rules> <paths> <iters>")
  64
}
