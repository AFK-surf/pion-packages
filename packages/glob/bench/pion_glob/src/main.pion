///| Head-to-head GlobSet benchmark (Pion Native):
///| Matches 50,000 monorepo paths against 80 GlobSet rules for `iters` steady-state iterations,
///| computing exact matched-path count, total hit count, and deterministic match checksum.

import "glob"

fn parse_pos_int(s : String, fallback : Int) -> Int {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  if acc <= 0 {
    fallback
  } else {
    acc
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let paths_file = if args.length() > 1 { args[1] } else { "/tmp/pion-glob-bench/paths_50k.txt" }
  let rules_file = if args.length() > 2 { args[2] } else { "/tmp/pion-glob-bench/rules_80.txt" }
  let iters = if args.length() > 3 { parse_pos_int(args[3], 5) } else { 5 }

  let paths_raw = match fs_read(world, paths_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read paths file")
      return 1
    }
  }
  let rules_raw = match fs_read(world, rules_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read rules file")
      return 1
    }
  }

  let rules_lines = rules_raw.split("\n")
  let rules : Array[String] = Array::new()
  let mut i = 0
  while i < rules_lines.length() {
    if rules_lines[i].length() > 0 {
      rules.push(rules_lines[i])
    }
    i = i + 1
  }

  let paths_lines = paths_raw.split("\n")
  let paths : Array[String] = Array::new()
  i = 0
  while i < paths_lines.length() {
    if paths_lines[i].length() > 0 {
      paths.push(paths_lines[i])
    }
    i = i + 1
  }

  let set = match glob::compile_set(rules) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "compile_set error: " + e.message)
      return 1
    }
  }

  let buf : Array[Int] = Array::new()
  let mut matched_paths : Int64 = 0L
  let mut total_hits : Int64 = 0L
  let mut checksum : Int64 = 0L

  let np = paths.length()
  let mut it = 0
  while it < iters {
    let mut p_idx = 0
    while p_idx < np {
      set.matches_into(paths[p_idx], buf)
      let nh = buf.length()
      if nh > 0 {
        matched_paths = matched_paths + 1L
        total_hits = total_hits + nh.to_int64()
        let mut h_idx = 0
        while h_idx < nh {
          checksum = (checksum * 131L + (buf[h_idx] + 1).to_int64()) % 1000000007L
          h_idx = h_idx + 1
        }
      }
      p_idx = p_idx + 1
    }
    it = it + 1
  }

  io_println(world, "rules=" + rules.length().to_string())
  io_println(world, "paths=" + np.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "matched_paths=" + matched_paths.to_string())
  io_println(world, "total_hits=" + total_hits.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
