///| Single Glob compliance tests ported from BurntSushi/globset `crates/globset/src/glob.rs`.

fn opt_casei() -> GlobOptions {
  GlobOptions::{
    case_insensitive: true,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

fn opt_litsep() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: true,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

fn opt_nobs() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: false,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

fn opt_bs() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

fn opt_ealtre() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: true,
    allow_unclosed_class: false,
  }
}

fn opt_unccls() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: true,
  }
}

fn check_match(pat : String, path : String, opts : GlobOptions) -> Unit {
  let g = match compile_with(pat, opts) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Glob) for '" + pat + "', got Err: " + e.message)
      return
    }
  }
  debug_assert(g.is_match(path), "expected '" + pat + "' to match '" + path + "'")
  let gs = match compile_set_from_globs([g]) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "expected Ok(GlobSet) for '" + pat + "', got Err: " + e.message)
      return
    }
  }
  debug_assert(gs.is_match(path), "expected GlobSet['" + pat + "'] to match '" + path + "'")
}

fn check_nmatch(pat : String, path : String, opts : GlobOptions) -> Unit {
  let g = match compile_with(pat, opts) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Glob) for '" + pat + "', got Err: " + e.message)
      return
    }
  }
  debug_assert(!g.is_match(path), "expected '" + pat + "' NOT to match '" + path + "'")
  let gs = match compile_set_from_globs([g]) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "expected Ok(GlobSet) for '" + pat + "', got Err: " + e.message)
      return
    }
  }
  debug_assert(!gs.is_match(path), "expected GlobSet['" + pat + "'] NOT to match '" + path + "'")
}

fn check_err(pat : String, expected : GlobErrorKind) -> Unit {
  match compile(pat) {
    Ok(_) => debug_assert(false, "expected Err for '" + pat + "', got Ok")
    Err(e) => {
      let ok = match (e.kind, expected) {
        (GlobErrorKind::UnclosedClass, GlobErrorKind::UnclosedClass) => true
        (GlobErrorKind::InvalidRange, GlobErrorKind::InvalidRange) => true
        (GlobErrorKind::UnopenedAlternates, GlobErrorKind::UnopenedAlternates) => true
        (GlobErrorKind::UnclosedAlternates, GlobErrorKind::UnclosedAlternates) => true
        (GlobErrorKind::TooManyNestedAlternates, GlobErrorKind::TooManyNestedAlternates) => true
        (GlobErrorKind::DanglingEscape, GlobErrorKind::DanglingEscape) => true
        _ => false
      }
      debug_assert(ok, "unexpected error kind for '" + pat + "': " + e.message)
    }
  }
}

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

// --- Syntax error tests ---

test "glob_err_unclosed1" {
  check_err("[", GlobErrorKind::UnclosedClass)
}

test "glob_err_unclosed2" {
  check_err("[]", GlobErrorKind::UnclosedClass)
}

test "glob_err_unclosed3" {
  check_err("[!", GlobErrorKind::UnclosedClass)
}

test "glob_err_unclosed4" {
  check_err("[!]", GlobErrorKind::UnclosedClass)
}

test "glob_err_range1" {
  check_err("[z-a]", GlobErrorKind::InvalidRange)
}

test "glob_err_range2" {
  check_err("[z--]", GlobErrorKind::InvalidRange)
}

test "glob_err_alt1" {
  check_err("{a,b", GlobErrorKind::UnclosedAlternates)
}

test "glob_err_alt2" {
  check_err("{a,{b,c}", GlobErrorKind::UnclosedAlternates)
}

test "glob_err_alt3" {
  check_err("a,b}", GlobErrorKind::UnopenedAlternates)
}

test "glob_err_alt4" {
  check_err("{a,b}}", GlobErrorKind::UnopenedAlternates)
}

test "glob_err_dangling_escape" {
  check_err("foo\\", GlobErrorKind::DanglingEscape)
}

test "glob_nested_alternates_depth_limit" {
  let ok_pat = repeat_str("{", 100) + "a" + repeat_str("}", 100)
  check_match(ok_pat, "a", GlobOptions::default())
  check_nmatch(ok_pat, "b", GlobOptions::default())

  let over_pat = repeat_str("{", 101) + "a" + repeat_str("}", 101)
  check_err(over_pat, GlobErrorKind::TooManyNestedAlternates)
}

// --- allow_unclosed_class tests ---

test "glob_allow_unclosed_class_single" {
  check_match("[", "[", opt_unccls())
  check_nmatch("[", "a", opt_unccls())
}

test "glob_allow_unclosed_class_many" {
  check_match("[abc", "[abc", opt_unccls())
  check_nmatch("[abc", "a", opt_unccls())
}

test "glob_allow_unclosed_class_empty1" {
  check_match("[]", "[]", opt_unccls())
}

test "glob_allow_unclosed_class_empty2" {
  check_match("[][", "[][", opt_unccls())
}

test "glob_allow_unclosed_class_negated" {
  check_match("[!", "[!", opt_unccls())
  check_match("[!]", "[!]", opt_unccls())
}

test "glob_allow_unclosed_class_brace" {
  check_match("{[abc,xyz}", "[abc", opt_unccls())
  check_match("{[abc,xyz}", "xyz", opt_unccls())
  check_match("{[abc,[xyz}", "[xyz", opt_unccls())
  check_match("{[abc],[xyz}", "b", opt_unccls())
  check_match("{[abc],[xyz}", "[xyz", opt_unccls())
}

// --- Basic matches ---

test "glob_match_empty" {
  check_match("", "", GlobOptions::default())
  check_nmatch("", "a", GlobOptions::default())
}

test "glob_match1" {
  check_match("a", "a", GlobOptions::default())
}

test "glob_match2" {
  check_match("a*b", "a_b", GlobOptions::default())
}

test "glob_match3" {
  check_match("a*b*c", "abc", GlobOptions::default())
}

test "glob_match4" {
  check_match("a*b*c", "a_b_c", GlobOptions::default())
}

test "glob_match5" {
  check_match("a*b*c", "a___b___c", GlobOptions::default())
}

test "glob_match6" {
  check_match("abc*abc*abc", "abcabcabcabcabcabcabc", GlobOptions::default())
}

test "glob_match7" {
  check_match("a*a*a*a*a*a*a*a*a", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", GlobOptions::default())
}

test "glob_match8" {
  check_match("a*b[xyz]c*d", "abxcdbxcddd", GlobOptions::default())
}

test "glob_match9" {
  check_match("*.rs", ".rs", GlobOptions::default())
}

test "glob_match10_unicode" {
  check_match("☃", "☃", GlobOptions::default())
  check_nmatch("☃", "a", GlobOptions::default())
  // BurntSushi/globset byte semantics (?-u): '?' matches 1 byte, '☃' is 3 UTF-8 bytes
  check_nmatch("?", "☃", GlobOptions::default())
  check_match("???", "☃", GlobOptions::default())
}

// --- Recursive ** matches ---

test "glob_matchrec1" {
  check_match("some/**/needle.txt", "some/needle.txt", GlobOptions::default())
}

test "glob_matchrec2" {
  check_match("some/**/needle.txt", "some/one/needle.txt", GlobOptions::default())
}

test "glob_matchrec3" {
  check_match("some/**/needle.txt", "some/one/two/needle.txt", GlobOptions::default())
}

test "glob_matchrec4" {
  check_match("some/**/needle.txt", "some/other/needle.txt", GlobOptions::default())
}

test "glob_matchrec5_doublestar_all" {
  check_match("**", "abcde", GlobOptions::default())
  check_match("**", "", GlobOptions::default())
  check_match("**", ".asdf", GlobOptions::default())
  check_match("**", "/x/.asdf", GlobOptions::default())
}

test "glob_matchrec9_double_doublestar" {
  check_match("some/**/**/needle.txt", "some/needle.txt", GlobOptions::default())
  check_match("some/**/**/needle.txt", "some/one/needle.txt", GlobOptions::default())
  check_match("some/**/**/needle.txt", "some/one/two/needle.txt", GlobOptions::default())
}

test "glob_matchrec13_prefix" {
  check_match("**/test", "one/two/test", GlobOptions::default())
  check_match("**/test", "one/test", GlobOptions::default())
  check_match("**/test", "test", GlobOptions::default())
}

test "glob_matchrec16_leading_slash" {
  check_match("/**/test", "/one/two/test", GlobOptions::default())
  check_match("/**/test", "/one/test", GlobOptions::default())
  check_match("/**/test", "/test", GlobOptions::default())
}

test "glob_matchrec19_dotfile" {
  check_match("**/.*", ".abc", GlobOptions::default())
  check_match("**/.*", "abc/.abc", GlobOptions::default())
}

test "glob_matchrec21_component_suffix" {
  check_match("**/foo/bar", "foo/bar", GlobOptions::default())
  check_match("**/foo/bar", "baz/foo/bar", GlobOptions::default())
}

test "glob_matchrec22_suffix" {
  check_match(".*/**", ".abc/abc", GlobOptions::default())
  check_match("test/**", "test/", GlobOptions::default())
  check_match("test/**", "test/one", GlobOptions::default())
  check_match("test/**", "test/one/two", GlobOptions::default())
}

test "glob_matchrec26_single_star" {
  check_match("some/*/needle.txt", "some/one/needle.txt", GlobOptions::default())
}

test "glob_doublestar_non_component" {
  check_match("a**", "a", GlobOptions::default())
  check_match("a**", "abc/def", GlobOptions::default())
  check_match("**a", "a", GlobOptions::default())
  check_match("a**b", "ab", GlobOptions::default())
  check_match("a**b", "a/x/b", GlobOptions::default())
  check_match("***", "anything", GlobOptions::default())
}

// --- Basename & literal_separator edge cases ---

test "glob_basename_empty" {
  check_match("**/*", "", opt_litsep())
}

test "glob_basename_trailing_separator" {
  check_match("**/*", "foo/", opt_litsep())
}

test "glob_basename_parent_component" {
  check_match("**/.*", "foo/..", opt_litsep())
}

test "glob_basename_class" {
  check_match("**/*.py[cod]", "src/module.pyc", opt_litsep())
  check_nmatch("**/*.py[cod]", "src/module.pyi", opt_litsep())
}

test "glob_basename_negated_class" {
  check_match("**/[!/]", "foo/a", opt_litsep())
}

test "glob_class_includes_separator" {
  check_match("**/[!a]", "/", GlobOptions::default())
  check_match("**/[.-0]", "/", GlobOptions::default())
  // In BurntSushi/globset, literal_separator only affects '*' and '?', not character classes
  check_match("**/[!a]", "/", opt_litsep())
  check_match("**/[.-0]", "/", opt_litsep())
}

test "glob_class_literal_separator" {
  check_match("*[/]*", "a/b", opt_litsep())
  check_match("[^a]*", "/b", opt_litsep())
  check_match("[ -~]", "/", opt_litsep())
  check_match("[ -~]", "a", opt_litsep())
}

// --- Character classes & ranges ---

test "glob_matchrange1" {
  check_match("a[0-9]b", "a0b", GlobOptions::default())
  check_match("a[0-9]b", "a9b", GlobOptions::default())
}

test "glob_matchrange3_negated" {
  check_match("a[!0-9]b", "a_b", GlobOptions::default())
  check_match("a[^0-9]b", "a_b", GlobOptions::default())
}

test "glob_matchrange4_mixed" {
  check_match("[a-z123]", "1", GlobOptions::default())
  check_match("[1a-z23]", "1", GlobOptions::default())
  check_match("[123a-z]", "1", GlobOptions::default())
}

test "glob_matchrange7_dash" {
  check_match("[abc-]", "-", GlobOptions::default())
  check_match("[-abc]", "-", GlobOptions::default())
  check_match("[-a-c]", "b", GlobOptions::default())
  check_match("[a-c-]", "b", GlobOptions::default())
  check_match("[-]", "-", GlobOptions::default())
}

test "glob_matchrange_bracket_and_bang" {
  check_match("[]]", "]", GlobOptions::default())
  check_match("[!!]", "a", GlobOptions::default())
  check_nmatch("[!!]", "!", GlobOptions::default())
  check_match("[]-z]", "a", GlobOptions::default())
  check_match("[--z]", "0", GlobOptions::default())
  check_match("[ --]", "%", GlobOptions::default())
}

// --- Wildcard path patterns ---

test "glob_matchpat_star_hello" {
  check_match("*hello.txt", "hello.txt", GlobOptions::default())
  check_match("*hello.txt", "gareth_says_hello.txt", GlobOptions::default())
  check_match("*hello.txt", "some/path/to/hello.txt", GlobOptions::default())
  check_match("*hello.txt", "some\\path\\to\\hello.txt", GlobOptions::default())
  check_match("*hello.txt", "/an/absolute/path/to/hello.txt", GlobOptions::default())
  check_match("*some/path/to/hello.txt", "some/path/to/hello.txt", GlobOptions::default())
  check_match("*some/path/to/hello.txt", "a/bigger/some/path/to/hello.txt", GlobOptions::default())
}

test "glob_matchescape_brackets" {
  check_match("_[[]_[]]_[?]_[*]_!_", "_[_]_?_*_!_", GlobOptions::default())
}

// --- Case insensitive ---

test "glob_matchcasei" {
  check_match("aBcDeFg", "aBcDeFg", opt_casei())
  check_match("aBcDeFg", "abcdefg", opt_casei())
  check_match("aBcDeFg", "ABCDEFG", opt_casei())
  check_match("aBcDeFg", "AbCdEfG", opt_casei())
  check_nmatch("aBcDeFg", "abcdefh", opt_casei())
}

test "glob_matchcasei_class" {
  check_match("[a-z]", "A", opt_casei())
  check_match("[A-Z]", "z", opt_casei())
  check_nmatch("[!a-z]", "A", opt_casei())
}

// --- Brace alternation ---

test "glob_matchalt_comma_outside" {
  check_match("a,b", "a,b", GlobOptions::default())
  check_match(",", ",", GlobOptions::default())
}

test "glob_matchalt_simple" {
  check_match("{a,b}", "a", GlobOptions::default())
  check_match("{a,b}", "b", GlobOptions::default())
  check_nmatch("{a,b}", "c", GlobOptions::default())
}

test "glob_matchalt_recursive" {
  check_match("{**/src/**,foo}", "abc/src/bar", GlobOptions::default())
  check_match("{**/src/**,foo}", "foo", GlobOptions::default())
  check_nmatch("{**/src/**,foo}", "bar", GlobOptions::default())
}

test "glob_matchalt_special" {
  check_match("{[}],foo}", "}", GlobOptions::default())
  check_match("{foo}", "foo", GlobOptions::default())
  check_match("{}", "", GlobOptions::default())
  check_match("{,}", "", GlobOptions::default())
}

test "glob_matchalt_extensions" {
  check_match("{*.foo,*.bar,*.wat}", "test.foo", GlobOptions::default())
  check_match("{*.foo,*.bar,*.wat}", "test.bar", GlobOptions::default())
  check_match("{*.foo,*.bar,*.wat}", "test.wat", GlobOptions::default())
  check_nmatch("{*.foo,*.bar,*.wat}", "test.rs", GlobOptions::default())
}

test "glob_matchalt_empty_alternates" {
  check_match("foo{,.txt}", "foo.txt", GlobOptions::default())
  check_nmatch("foo{,.txt}", "foo", GlobOptions::default())
  check_match("foo{,.txt}", "foo", opt_ealtre())
  check_match("foo{,.txt}", "foo.txt", opt_ealtre())
}

test "glob_matchalt_nested" {
  check_match("{a,b{c,d}}", "bc", GlobOptions::default())
  check_match("{a,b{c,d}}", "bd", GlobOptions::default())
  check_match("{a,b{c,d}}", "a", GlobOptions::default())
  check_nmatch("{a,b{c,d}}", "be", GlobOptions::default())
  check_match("{{a,b},{c,d}}", "d", GlobOptions::default())
}

// --- Literal separator ---

test "glob_matchslash1" {
  check_match("abc/def", "abc/def", opt_litsep())
}

test "glob_matchslash2" {
  check_nmatch("abc?def", "abc/def", opt_litsep())
}

test "glob_matchslash3" {
  check_nmatch("abc*def", "abc/def", opt_litsep())
}

test "glob_matchslash4" {
  check_match("abc[/]def", "abc/def", opt_litsep())
}

test "glob_matchslash5" {
  check_nmatch("abc\\def", "abc/def", opt_litsep())
}

// --- Backslash escape ---

test "glob_matchbackslash_enabled" {
  check_match("\\[", "[", opt_bs())
  check_match("\\?", "?", opt_bs())
  check_match("\\*", "*", opt_bs())
  check_match("\\a", "a", GlobOptions::default())
  check_match("\\\\", "\\", opt_bs())
}

test "glob_matchbackslash_disabled" {
  check_match("\\[a-z]", "\\a", opt_nobs())
  check_match("\\?", "\\a", opt_nobs())
  check_match("\\*", "\\\\", opt_nobs())
}

// --- Non-matches ---

test "glob_matchnot1_to_4" {
  check_nmatch("a*b*c", "abcd", GlobOptions::default())
  check_nmatch("abc*abc*abc", "abcabcabcabcabcabcabca", GlobOptions::default())
  check_nmatch("some/**/needle.txt", "some/other/notthis.txt", GlobOptions::default())
  check_nmatch("some/**/**/needle.txt", "some/other/notthis.txt", GlobOptions::default())
}

test "glob_matchnot5_to_7" {
  check_nmatch("/**/test", "test", GlobOptions::default())
  check_nmatch("/**/test", "/one/notthis", GlobOptions::default())
  check_nmatch("/**/test", "/notthis", GlobOptions::default())
}

test "glob_matchnot8_to_11" {
  check_nmatch("**/.*", "ab.c", GlobOptions::default())
  check_nmatch("**/.*", "abc/ab.c", GlobOptions::default())
  check_nmatch(".*/**", "a.bc", GlobOptions::default())
  check_nmatch(".*/**", "abc/a.bc", GlobOptions::default())
}

test "glob_matchnot12_to_15" {
  check_nmatch("a[0-9]b", "a_b", GlobOptions::default())
  check_nmatch("a[!0-9]b", "a0b", GlobOptions::default())
  check_nmatch("a[!0-9]b", "a9b", GlobOptions::default())
  check_nmatch("[!-]", "-", GlobOptions::default())
}

test "glob_matchnot16_to_19" {
  check_nmatch("*hello.txt", "hello.txt-and-then-some", GlobOptions::default())
  check_nmatch("*hello.txt", "goodbye.txt", GlobOptions::default())
  check_nmatch("*some/path/to/hello.txt", "some/path/to/hello.txt-and-then-some", GlobOptions::default())
  check_nmatch("*some/path/to/hello.txt", "some/other/path/to/hello.txt", GlobOptions::default())
}

test "glob_matchnot20_to_26" {
  check_nmatch("a", "foo/a", GlobOptions::default())
  check_nmatch("./foo", "foo", GlobOptions::default())
  check_nmatch("**/foo", "foofoo", GlobOptions::default())
  check_nmatch("**/foo/bar", "foofoo/bar", GlobOptions::default())
  check_nmatch("/*.c", "mozilla-sha1/sha1.c", GlobOptions::default())
  check_nmatch("*.c", "mozilla-sha1/sha1.c", opt_litsep())
  check_nmatch("**/m4/ltoptions.m4", "csharp/src/packages/repositories.config", opt_litsep())
}

test "glob_matchnot27_to_34" {
  check_nmatch("a[^0-9]b", "a0b", GlobOptions::default())
  check_nmatch("a[^0-9]b", "a9b", GlobOptions::default())
  check_nmatch("[^-]", "-", GlobOptions::default())
  check_nmatch("some/*/needle.txt", "some/needle.txt", GlobOptions::default())
  check_nmatch("some/*/needle.txt", "some/one/two/needle.txt", opt_litsep())
  check_nmatch("some/*/needle.txt", "some/one/two/three/needle.txt", opt_litsep())
  check_nmatch(".*/**", ".abc", GlobOptions::default())
  check_nmatch("foo/**", "foo", GlobOptions::default())
}

// --- BurntSushi/globset non-POSIX bracket semantics (POSIX classes are enabled in `.gitignore`) ---

test "glob_non_posix_bracket_semantics" {
  check_nmatch("[[:digit:]]", "0", GlobOptions::default())
  check_nmatch("[[:alpha:]]", "a", GlobOptions::default())
  check_match("[[:blank:]]", "a]", GlobOptions::default())
  check_match("[[:digit:]]", "d]", GlobOptions::default())
}

// --- Regression tests for red-team findings ---

test "glob_star_dot_matches_dotdot" {
  check_match("*.", "..", GlobOptions::default())
  check_match("*.", "a.", GlobOptions::default())
  check_nmatch("*.", "a", GlobOptions::default())
}

test "glob_brace_doublestar_slash_consistency" {
  check_nmatch("{**/}", "a", GlobOptions::default())
  check_nmatch("{**/}", "src/main.rs", GlobOptions::default())
  check_match("{**/}", "", GlobOptions::default())
  check_match("{**/}", "a/", GlobOptions::default())
}

test "glob_candidate_api" {
  let g = match compile("**/*.rs") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.message)
      return
    }
  }
  let c1 = Candidate::new("src/main.rs")
  let c2 = Candidate::new("src/main.py")
  debug_assert(g.is_match_candidate(c1), "candidate matches .rs")
  debug_assert(!g.is_match_candidate(c2), "candidate misses .py")
}

// --- Anti-ReDoS linear-time guarantee ---

test "glob_linear_time_anti_redos" {
  let pat = "a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*b"
  let path = repeat_str("a", 200)
  check_nmatch(pat, path, GlobOptions::default())
  check_match(pat, path + "b", GlobOptions::default())
}

test "glob_linear_time_doublestar_anti_redos" {
  let pat = "**/a/**/a/**/a/**/a/**/a/**/b"
  let path = repeat_str("a/", 60) + "c"
  check_nmatch(pat, path, GlobOptions::default())
  check_match(pat, repeat_str("a/", 60) + "b", GlobOptions::default())
}
