///| GlobSet compliance tests ported from BurntSushi/globset `crates/globset/src/lib.rs`.

fn must_set(pats : Array[String]) -> GlobSet {
  match compile_set(pats) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "compile_set failed: " + e.message)
      GlobSet::empty()
    }
  }
}

fn must_glob(pat : String, opts : GlobOptions) -> Glob {
  match compile_with(pat, opts) {
    Ok(g) => g
    Err(e) => {
      debug_assert(false, "compile_with failed for '" + pat + "': " + e.message)
      Glob::{ pattern: pat, opts }
    }
  }
}

fn must_set_globs(globs : Array[Glob]) -> GlobSet {
  match compile_set_from_globs(globs) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "compile_set_from_globs failed: " + e.message)
      GlobSet::empty()
    }
  }
}

fn assert_eq_ints(actual : Array[Int], expected : Array[Int], msg : String) -> Unit {
  debug_assert(
    actual.length() == expected.length(),
    msg + ": length mismatch",
  )
  let mut i = 0
  while i < actual.length() {
    debug_assert(actual[i] == expected[i], msg + ": element mismatch")
    i = i + 1
  }
}

fn repeat_a(n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte((97).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn repeat_b(n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte((98).to_byte())
    i = i + 1
  }
  sb.to_string()
}

test "globset_set_works" {
  let set = must_set(["src/**/*.rs", "*.c", "src/lib.rs"])
  debug_assert(set.len() == 3, "len == 3")
  debug_assert(!set.is_empty(), "not empty")

  debug_assert(set.is_match("foo.c"), "foo.c")
  debug_assert(set.is_match("src/foo.c"), "src/foo.c")
  debug_assert(!set.is_match("foo.rs"), "!foo.rs")
  debug_assert(!set.is_match("tests/foo.rs"), "!tests/foo.rs")
  debug_assert(set.is_match("src/foo.rs"), "src/foo.rs")
  debug_assert(set.is_match("src/grep/src/main.rs"), "src/grep/src/main.rs")

  debug_assert(!set.matches_all("src/lib.rs"), "!matches_all src/lib.rs")
  debug_assert(!set.matches_all("src/a/b.c"), "!matches_all src/a/b.c")

  assert_eq_ints(set.matches("src/lib.rs"), [0, 2], "src/lib.rs matches")
}

test "globset_empty_set_works" {
  let set = must_set([])
  debug_assert(set.is_empty(), "empty")
  debug_assert(set.len() == 0, "len 0")
  debug_assert(!set.is_match(""), "!empty")
  debug_assert(!set.is_match("a"), "!a")
  debug_assert(set.matches_all("a"), "matches_all vacuously true")
  assert_eq_ints(set.matches("a"), [], "empty matches")
}

test "globset_matches_all_literals" {
  let set = must_set(["abc", "def"])
  debug_assert(!set.matches_all("abc"), "!abc")
  debug_assert(!set.matches_all("def"), "!def")

  let set2 = must_set(["abc"])
  debug_assert(set2.matches_all("abc"), "abc")
}

test "globset_matches_all_basename_literals" {
  let set = must_set(["**/abc", "**/a.c"])
  debug_assert(!set.matches_all("foo/abc"), "!foo/abc")
  debug_assert(!set.matches_all("foo/a.c"), "!foo/a.c")

  let set2 = must_set(["**/a.c"])
  debug_assert(set2.matches_all("foo/a.c"), "foo/a.c")
}

test "globset_matches_all_extensions" {
  let set = must_set(["**/*.rs", "**/*.c"])
  debug_assert(!set.matches_all("foo/a.rs"), "!foo/a.rs")
  debug_assert(!set.matches_all("foo/a.c"), "!foo/a.c")

  let set2 = must_set(["**/*.rs", "*.rs"])
  debug_assert(set2.matches_all("foo/a.rs"), "foo/a.rs")
}

test "globset_matches_all_required_extensions" {
  let set = must_set(["*.rs", "**/m*.rs", "a/*.rs"])
  debug_assert(set.matches_all("a/main.rs"), "a/main.rs")
  debug_assert(!set.matches_all("main.rs"), "!main.rs")
  debug_assert(!set.matches_all("a/lib.rs"), "!a/lib.rs")

  let set2 = must_set(["x/m*.a", "y/n*.b"])
  assert_eq_ints(set2.matches("x/mt.a"), [0], "x/mt.a")
  debug_assert(!set2.matches_all("x/mt.a"), "!matches_all x/mt.a")
  assert_eq_ints(set2.matches("y/nz.b"), [1], "y/nz.b")
  debug_assert(!set2.matches_all("y/nz.b"), "!matches_all y/nz.b")
}

test "globset_matches_all_prefix" {
  let set = must_set(["a*", "ab*", "ab/c*"])
  debug_assert(set.matches_all("ab/c/def"), "ab/c/def")
  debug_assert(set.matches_all("ab/cd"), "ab/cd")
  debug_assert(!set.matches_all("abc"), "!abc")
  debug_assert(!set.matches_all("ab/x"), "!ab/x")
  debug_assert(!set.matches_all("a"), "!a")
}

test "globset_matches_all_suffix" {
  let set = must_set(["*.rs", "*s", "*/main.rs"])
  debug_assert(set.matches_all("a/b/c/main.rs"), "a/b/c/main.rs")
  debug_assert(!set.matches_all("foo.rs"), "!foo.rs")
  debug_assert(!set.matches_all("as"), "!as")
}

test "globset_matches_all_regex_mixed_options" {
  let ci = GlobOptions::{
    case_insensitive: true,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
  let set = must_set_globs([
    must_glob("c*", ci),
    must_glob("*{rs,c}", GlobOptions::default()),
  ])
  debug_assert(set.matches_all("c/main.rs"), "c/main.rs")
  debug_assert(set.matches_all("C/main.c"), "C/main.c")
  debug_assert(!set.matches_all("Ca"), "!Ca")
  debug_assert(!set.matches_all("foo.c"), "!foo.c")
}

test "globset_basename_regex_with_path_rules" {
  let ls = GlobOptions::{
    case_insensitive: false,
    literal_separator: true,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
  let set = must_set_globs([
    must_glob("**/.venv*", ls),
    must_glob("**/*.py[cod]", ls),
    must_glob("src/*", ls),
  ])
  assert_eq_ints(set.matches("src/module.pyc"), [1, 2], "src/module.pyc")
  assert_eq_ints(set.matches("src/nested/module.pyc"), [1], "src/nested/module.pyc")
  assert_eq_ints(set.matches("src/.venv-new"), [0, 2], "src/.venv-new")
  debug_assert(set.matches_all("src/.venv.pyc"), "src/.venv.pyc")
  debug_assert(!set.matches_all("src/nested/.venv.pyc"), "!src/nested/.venv.pyc")
}

test "globset_basename_regex_parent_component" {
  let ls = GlobOptions::{
    case_insensitive: false,
    literal_separator: true,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
  let set = must_set_globs([
    must_glob("**/.*", ls),
    must_glob("**/[.][.]", GlobOptions::default()),
  ])
  debug_assert(set.is_match(".."), "..")
  debug_assert(set.matches_all(".."), "all ..")
  assert_eq_ints(set.matches(".."), [0, 1], "matches ..")
  debug_assert(set.is_match("foo/.."), "foo/..")
  debug_assert(set.matches_all("foo/.."), "all foo/..")
  assert_eq_ints(set.matches("foo/.."), [0, 1], "matches foo/..")
  debug_assert(set.is_match("foo/bar/.."), "foo/bar/..")
  assert_eq_ints(set.matches("foo/bar/.."), [0, 1], "matches foo/bar/..")
  debug_assert(!set.matches_all("foo/."), "!foo/.")
  debug_assert(!set.matches_all("foo/a.."), "!foo/a..")
}

test "globset_escape" {
  debug_assert(escape("foo") == "foo", "foo")
  debug_assert(escape("foo*") == "foo[*]", "foo*")
  debug_assert(escape("[]") == "[[][]]", "[]")
  debug_assert(escape("*?") == "[*][?]", "*?")
  debug_assert(escape("src/**/*.rs") == "src/[*][*]/[*].rs", "src/**/*.rs")
  debug_assert(escape("bar[ab]baz") == "bar[[]ab[]]baz", "bar[ab]baz")
  debug_assert(escape("bar[!!]!baz") == "bar[[]!![]]!baz", "bar[!!]!baz")
  debug_assert(escape("{a,b}") == "[{]a,b[}]", "{a,b}")
}

test "globset_set_does_not_remember" {
  let set = must_set(["*foo*", "*bar*", "*quux*"])
  assert_eq_ints(set.matches("ZfooZquuxZ"), [0, 2], "first call")
  assert_eq_ints(set.matches("nada"), [], "second call")
}

test "globset_matches_into_clears_buffer" {
  let set = must_set(["*.rs", "src/**", "**/lib.rs"])
  let buf : Array[Int] = [99, 100]
  set.matches_into("src/lib.rs", buf)
  assert_eq_ints(buf, [0, 1, 2], "matches_into clears and sorts")
  set.matches_into("README.md", buf)
  assert_eq_ints(buf, [], "matches_into clears on miss")
}

test "globset_literal_length_filter" {
  let lengths = [0, 1, 63, 64, 65, 127, 128, 129]
  let patterns : Array[String] = Array::new()
  let mut i = 0
  while i < lengths.length() {
    patterns.push(repeat_a(lengths[i]))
    i = i + 1
  }
  patterns.push("é.py")
  patterns.push("foo\\*bar")
  let set = must_set(patterns)
  i = 0
  while i < lengths.length() {
    let path = repeat_a(lengths[i])
    debug_assert(set.is_match(path), "len match")
    assert_eq_ints(set.matches(path), [i], "len idx")
    i = i + 1
  }
  assert_eq_ints(set.matches("é.py"), [8], "unicode literal")
  assert_eq_ints(set.matches("foo*bar"), [9], "escaped star literal")
  debug_assert(!set.is_match(repeat_a(2)), "!2")
  debug_assert(!set.is_match(repeat_a(62)), "!62")
  debug_assert(!set.is_match(repeat_a(66)), "!66")
  debug_assert(!set.is_match(repeat_a(126)), "!126")
  debug_assert(!set.is_match(repeat_a(130)), "!130")

  let lit65 = repeat_a(65)
  let dups = must_set([lit65, lit65])
  debug_assert(dups.matches_all(lit65), "dup matches_all")
  assert_eq_ints(dups.matches(lit65), [0, 1], "dup indices")
  debug_assert(!dups.is_match("a"), "!a")
  debug_assert(!dups.matches_all("a"), "!all a")
  debug_assert(!dups.is_match(repeat_b(65)), "!b65")
}

test "globset_basename_literal_length_filter" {
  let lengths = [1, 63, 64, 65, 127, 128, 129]
  let patterns : Array[String] = Array::new()
  let mut i = 0
  while i < lengths.length() {
    patterns.push("**/" + repeat_a(lengths[i]))
    i = i + 1
  }
  patterns.push("**/é.py")
  patterns.push("**/foo\\*bar")
  let set = must_set(patterns)
  i = 0
  while i < lengths.length() {
    let path = "parent/" + repeat_a(lengths[i])
    debug_assert(set.is_match(path), "base len match")
    assert_eq_ints(set.matches(path), [i], "base len idx")
    i = i + 1
  }
  assert_eq_ints(set.matches("parent/é.py"), [7], "base unicode")
  assert_eq_ints(set.matches("parent/foo*bar"), [8], "base escaped star")

  let lit65 = repeat_a(65)
  let dups = must_set(["**/" + lit65, "**/" + lit65])
  let p65 = "parent/" + lit65
  debug_assert(dups.matches_all(p65), "base dup all")
  assert_eq_ints(dups.matches(p65), [0, 1], "base dup indices")
  debug_assert(!dups.is_match("parent/a"), "!parent/a")
  debug_assert(!dups.is_match("parent/" + repeat_b(65)), "!parent/b65")

  let parent = must_set(["**/.."])
  debug_assert(!parent.is_match("parent/.."), "!parent/..")
  debug_assert(!parent.matches_all("parent/.."), "!all parent/..")
}

test "globset_component_suffix_dedup" {
  let set = must_set(["**/foo/bar", "foo/bar", "*.bar"])
  assert_eq_ints(set.matches("foo/bar"), [0, 1], "foo/bar no dup")
  assert_eq_ints(set.matches("x/foo/bar"), [0], "x/foo/bar")
  assert_eq_ints(set.matches("foofoo/bar"), [], "foofoo/bar miss")
}

test "globset_compile_error_propagates" {
  match compile_set(["*.rs", "[z-a]", "*.pion"]) {
    Ok(_) => debug_assert(false, "expected Err")
    Err(e) => {
      let ok = match e.kind {
        GlobErrorKind::InvalidRange => true
        _ => false
      }
      debug_assert(ok, "expected InvalidRange")
    }
  }
}

test "globset_mixed_strategies_ordering" {
  let set = must_set([
    "src/main.rs",
    "**/*.rs",
    "src/**",
    "**/main.rs",
    "src/*/*.rs",
    "src/{main,lib}.rs",
    "*main.rs",
  ])
  assert_eq_ints(set.matches("src/main.rs"), [0, 1, 2, 3, 5, 6], "sorted ascending")
}

test "globset_anti_redos" {
  let set = must_set([
    "a*a*a*a*a*a*a*a*a*a*a*b",
    "x*x*x*x*x*x*x*x*x*x*x*y",
    "*.pion",
  ])
  let bad = repeat_a(150)
  debug_assert(!set.is_match(bad), "no match fast")
  assert_eq_ints(set.matches(bad + "b"), [0], "matches 0 fast")
}

test "globset_builder_and_candidate_api" {
  let b = GlobSetBuilder::new()
  let b = match b.add_pattern("*.rs") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.message)
      return
    }
  }
  let b = b.add(must_glob("src/**", GlobOptions::default()))
  let set = match b.build() {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, e.message)
      return
    }
  }
  let c = Candidate::new("src/main.rs")
  debug_assert(set.is_match_candidate(c), "is_match_candidate")
  debug_assert(set.matches_all_candidate(c), "matches_all_candidate")
  assert_eq_ints(set.matches_candidate(c), [0, 1], "matches_candidate")
  let buf : Array[Int] = Array::new()
  set.matches_candidate_into(c, buf)
  assert_eq_ints(buf, [0, 1], "matches_candidate_into")
}

test "globset_many_hits_bitmap_dedup" {
  let pats : Array[String] = Array::new()
  let expected : Array[Int] = Array::new()
  let mut i = 0
  while i < 100 {
    if i % 3 == 0 {
      pats.push("*.rs")
    } else if i % 3 == 1 {
      pats.push("src/**")
    } else {
      pats.push("**/hit.rs")
    }
    expected.push(i)
    i = i + 1
  }
  let set = must_set(pats)
  assert_eq_ints(set.matches("src/a/hit.rs"), expected, "100 hits sorted & deduped")
}
