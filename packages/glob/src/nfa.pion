///| Pure byte-level Thompson NFA compiler and on-demand Lazy DFA simulator.
///| - O(N) NFA compilation time and memory (no quadratic epsilon-closure matrix).
///| - Shared leading `RecursivePrefix` (`**/`) gadget across multi-pattern sets.
///| - O(N + 256) byte equivalence classes (`ByteClassSet`) for compact transitions.
///| - Memory-bounded Lazy DFA (all 256 bytes, including UTF-8 / raw bytes, O(1) per byte on hit).

///| Byte-level NFA state transition kind.
pub enum NfaKind {
  Epsilon
  Byte(Int, Bool) // (byte 0..255, ascii_case_insensitive)
  AnyByte(Bool) // literal_separator (if true, excludes '/')
  ByteClass(Int64, Int64, Int64, Int64) // 256-bit bitmap for bytes 0..255
  Match(Int) // pattern_id
}

///| A single NFA state with up to 2 epsilon transitions or 1 consuming transition (`out1`).
pub struct NfaState {
  pub kind : NfaKind
  pub mut out1 : Int // -1 if none
  pub mut out2 : Int // -1 if none (only used for Epsilon split)
}

///| Compiled byte-level Thompson NFA with on-demand memory-bounded Lazy DFA cache.
pub struct Nfa {
  pub states : Array[NfaState]
  pub start_states : Array[Int]
  pub num_states : Int
  pub byte_classes : Array[Int] // length 256: byte -> class_id
  pub rep_bytes : Array[Int] // length stride: class_id -> representative byte
  pub stride : Int
  mut dfa_ready : Bool
  mut start_dead : Bool
  // Lazy DFA cache:
  // row 0 = unused dummy row; row 1 = start state.
  // dfa_trans[state_id * stride + cls]: 0 = unknown, -1 = dead, > 0 = next_state_id * stride
  dfa_trans : Array[Int]
  dfa_sets : Array[Array[Int]]
  dfa_has_match : Array[Bool]
  dfa_matches : Array[Array[Int]]
  mut total_set_ints : Int
  // Open-addressing hash table mapping sorted NFA state set -> dfa state_id
  mut tbl_mask : Int
  mut tbl_buckets : Array[Int]
  mut tbl_hashes : Array[Int64]
  mut tbl_count : Int
  // Reusable epsilon-closure scratch (allocated on first match)
  eps_gen_arr : Array[Int]
  mut eps_gen : Int
  eps_stack : Array[Int]
}

struct NfaBuilder {
  states : Array[NfaState]
}

fn NfaBuilder::new() -> NfaBuilder {
  NfaBuilder::{ states: Array::new() }
}

fn NfaBuilder::add(
  self : NfaBuilder,
  kind : NfaKind,
  out1 : Int,
  out2 : Int,
) -> Int {
  let id = self.states.length()
  self.states.push(NfaState::{ kind, out1, out2 })
  id
}

///| Encode a Unicode scalar value into 1..4 UTF-8 bytes.
fn encode_utf8_bytes(cp : Int) -> Array[Int] {
  if cp < 0x80 {
    [cp]
  } else if cp < 0x800 {
    [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
  } else if cp < 0x10000 {
    [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
  } else {
    [
      0xF0 | (cp >> 18),
      0x80 | ((cp >> 12) & 0x3F),
      0x80 | ((cp >> 6) & 0x3F),
      0x80 | (cp & 0x3F),
    ]
  }
}

fn set_mask_bit(w : Array[Int64], b : Int) -> Unit {
  let idx = b >> 6
  w[idx] = w[idx] | (1L << (b & 63))
}

fn get_mask_bit(w : Array[Int64], b : Int) -> Bool {
  (w[b >> 6] & (1L << (b & 63))) != 0L
}

///| Convert a glob character class into a 256-bit byte bitmap matching `BurntSushi/globset`
///| (`(?-u)` byte regex semantics). When `class_excludes_separator` is true (`.gitignore`),
///| byte `'/'` (47) is always excluded.
fn build_byte_class_mask(
  negated : Bool,
  class_excludes_separator : Bool,
  ci : Bool,
  ranges : Array[CharRange],
) -> (Int64, Int64, Int64, Int64) {
  let w : Array[Int64] = [0L, 0L, 0L, 0L]
  let mut i = 0
  let nr = ranges.length()
  while i < nr {
    let r = ranges[i]
    let lo_b = encode_utf8_bytes(r.lo)
    if r.lo == r.hi {
      let mut k = 0
      while k < lo_b.length() {
        set_mask_bit(w, lo_b[k])
        k = k + 1
      }
    } else {
      let hi_b = encode_utf8_bytes(r.hi)
      let mut k = 0
      while k < lo_b.length() - 1 {
        set_mask_bit(w, lo_b[k])
        k = k + 1
      }
      let r_lo = lo_b[lo_b.length() - 1]
      let r_hi = hi_b[0]
      let mut b = r_lo
      while b <= r_hi {
        set_mask_bit(w, b)
        b = b + 1
      }
      k = 1
      while k < hi_b.length() {
        set_mask_bit(w, hi_b[k])
        k = k + 1
      }
    }
    i = i + 1
  }
  if ci {
    let mut b = 65 // 'A'..'Z'
    while b <= 90 {
      let lower = b + 32
      let has_u = get_mask_bit(w, b)
      let has_l = get_mask_bit(w, lower)
      if has_u && !has_l {
        set_mask_bit(w, lower)
      } else if has_l && !has_u {
        set_mask_bit(w, b)
      }
      b = b + 1
    }
  }
  if negated {
    w[0] = w[0] ^ -1L
    w[1] = w[1] ^ -1L
    w[2] = w[2] ^ -1L
    w[3] = w[3] ^ -1L
  }
  if class_excludes_separator {
    w[0] = w[0] & ((1L << 47) ^ -1L)
  }
  (w[0], w[1], w[2], w[3])
}

///| Compile a token sequence starting at `start_idx` and transitioning into `exit_state`.
fn NfaBuilder::compile_seq_from(
  self : NfaBuilder,
  tokens : Array[Token],
  start_idx : Int,
  opts : GlobOptions,
  class_excludes_separator : Bool,
  exit_state : Int,
) -> Int {
  let mut next = exit_state
  let mut i = tokens.length() - 1
  while i >= start_idx {
    next = self.compile_tok(tokens[i], opts, class_excludes_separator, next)
    i = i - 1
  }
  next
}

fn NfaBuilder::compile_tok(
  self : NfaBuilder,
  tok : Token,
  opts : GlobOptions,
  class_excludes_separator : Bool,
  next : Int,
) -> Int {
  match tok {
    Token::Literal(cp) =>
    if cp < 128 {
      self.add(NfaKind::Byte(cp, opts.case_insensitive), next, -1)
    } else {
      let bs = encode_utf8_bytes(cp)
      let mut cur = next
      let mut i = bs.length() - 1
      while i >= 0 {
        cur = self.add(NfaKind::Byte(bs[i], false), cur, -1)
        i = i - 1
      }
      cur
    }
    Token::Any => self.add(NfaKind::AnyByte(opts.literal_separator), next, -1)
    Token::ZeroOrMore => {
      let loop_s = self.add(NfaKind::AnyByte(opts.literal_separator), -1, -1)
      let split = self.add(NfaKind::Epsilon, loop_s, next)
      self.states[loop_s].out1 = split
      split
    }
    Token::RecursiveAll => {
      let loop_s = self.add(NfaKind::AnyByte(false), -1, -1)
      let split = self.add(NfaKind::Epsilon, loop_s, next)
      self.states[loop_s].out1 = split
      split
    }
    Token::RecursivePrefix => {
      // (?:/?|.*/) == (?:|.*/)
      let slash = self.add(NfaKind::Byte(47, false), next, -1)
      let any_s = self.add(NfaKind::AnyByte(false), -1, -1)
      let star = self.add(NfaKind::Epsilon, any_s, slash)
      self.states[any_s].out1 = star
      self.add(NfaKind::Epsilon, next, star)
    }
    Token::RecursiveSuffix => {
      // /.*
      let any_s = self.add(NfaKind::AnyByte(false), -1, -1)
      let star = self.add(NfaKind::Epsilon, any_s, next)
      self.states[any_s].out1 = star
      self.add(NfaKind::Byte(47, false), star, -1)
    }
    Token::RecursiveZeroOrMore => {
      // (?:/|/.*/) == / (?: | .*/ )
      let slash2 = self.add(NfaKind::Byte(47, false), next, -1)
      let any_s = self.add(NfaKind::AnyByte(false), -1, -1)
      let star = self.add(NfaKind::Epsilon, any_s, slash2)
      self.states[any_s].out1 = star
      let mid = self.add(NfaKind::Epsilon, next, star)
      self.add(NfaKind::Byte(47, false), mid, -1)
    }
    Token::Class(negated, ranges) => {
      let (w0, w1, w2, w3) = build_byte_class_mask(
        negated,
        class_excludes_separator,
        opts.case_insensitive,
        ranges,
      )
      self.add(NfaKind::ByteClass(w0, w1, w2, w3), next, -1)
    }
    Token::Alternates(alts) => {
      let entries : Array[Int] = Array::new()
      let mut i = 0
      while i < alts.length() {
        if !is_empty_branch(alts[i], opts) || opts.empty_alternates {
          entries.push(
            self.compile_seq_from(
              alts[i],
              0,
              opts,
              class_excludes_separator,
              next,
            ),
          )
        }
        i = i + 1
      }
      if entries.length() == 0 {
        next
      } else if entries.length() == 1 {
        entries[0]
      } else {
        let mut cur = entries[entries.length() - 1]
        let mut j = entries.length() - 2
        while j >= 0 {
          cur = self.add(NfaKind::Epsilon, entries[j], cur)
          j = j - 1
        }
        cur
      }
    }
  }
}

fn mark_bound(bounds : Array[Int64], b : Int) -> Unit {
  if b > 0 && b < 256 {
    let idx = b >> 6
    bounds[idx] = bounds[idx] | (1L << (b & 63))
  }
}

///| Compute byte equivalence classes in O(num_states + 256) time.
fn compute_byte_classes(states : Array[NfaState]) -> (Array[Int], Array[Int]) {
  let bounds : Array[Int64] = [0L, 0L, 0L, 0L]
  let mut i = 0
  let n = states.length()
  while i < n {
    match states[i].kind {
      NfaKind::Byte(b, ci) => {
        mark_bound(bounds, b)
        mark_bound(bounds, b + 1)
        if ci {
          let sw = ascii_swap_case(b)
          if sw != b {
            mark_bound(bounds, sw)
            mark_bound(bounds, sw + 1)
          }
        }
      }
      NfaKind::AnyByte(lit_sep) =>
      if lit_sep {
        mark_bound(bounds, 47)
        mark_bound(bounds, 48)
      }
      NfaKind::ByteClass(w0, w1, w2, w3) => {
        bounds[0] = bounds[0] | (w0 ^ (w0 << 1))
        let c0 = if (w0 & (1L << 63)) != 0L { 1L } else { 0L }
        bounds[1] = bounds[1] | (w1 ^ ((w1 << 1) | c0))
        let c1 = if (w1 & (1L << 63)) != 0L { 1L } else { 0L }
        bounds[2] = bounds[2] | (w2 ^ ((w2 << 1) | c1))
        let c2 = if (w2 & (1L << 63)) != 0L { 1L } else { 0L }
        bounds[3] = bounds[3] | (w3 ^ ((w3 << 1) | c2))
      }
      _ => ()
    }
    i = i + 1
  }

  let byte_classes : Array[Int] = Array::new()
  let rep_bytes : Array[Int] = Array::new()
  let mut cls = 0
  byte_classes.push(0)
  rep_bytes.push(0)
  let mut b = 1
  while b < 256 {
    if (bounds[b >> 6] & (1L << (b & 63))) != 0L {
      cls = cls + 1
      rep_bytes.push(b)
    }
    byte_classes.push(cls)
    b = b + 1
  }
  (byte_classes, rep_bytes)
}

fn finalize_nfa(builder : NfaBuilder, start_states : Array[Int]) -> Nfa {
  let num_states = builder.states.length()
  let (byte_classes, rep_bytes) = compute_byte_classes(builder.states)
  let stride = rep_bytes.length()
  Nfa::{
    states: builder.states,
    start_states,
    num_states,
    byte_classes,
    rep_bytes,
    stride,
    dfa_ready: false,
    start_dead: false,
    dfa_trans: Array::new(),
    dfa_sets: Array::new(),
    dfa_has_match: Array::new(),
    dfa_matches: Array::new(),
    total_set_ints: 0,
    tbl_mask: 0,
    tbl_buckets: Array::new(),
    tbl_hashes: Array::new(),
    tbl_count: 0,
    eps_gen_arr: Array::new(),
    eps_gen: 0,
    eps_stack: Array::new(),
  }
}

///| Compile a single token sequence into an immutable byte-level NFA.
pub fn compile_single_nfa(
  tokens : Array[Token],
  opts : GlobOptions,
  class_excludes_separator : Bool,
) -> Nfa {
  let b = NfaBuilder::new()
  let m = b.add(NfaKind::Match(0), -1, -1)
  let start = b.compile_seq_from(tokens, 0, opts, class_excludes_separator, m)
  finalize_nfa(b, [start])
}

///| Entry for compiling a multi-pattern NFA.
pub struct MultiNfaEntry {
  pub pat_id : Int
  pub tokens : Array[Token]
  pub opts : GlobOptions
  pub class_excludes_separator : Bool
}

///| Compile multiple patterns into a single unified byte-level NFA in O(N) time and memory.
///| Patterns starting with `RecursivePrefix` (`**/...`) share a single `**/` loop gadget.
pub fn compile_multi_nfa(entries : Array[MultiNfaEntry]) -> Nfa {
  let b = NfaBuilder::new()
  if entries.length() == 0 {
    return finalize_nfa(b, Array::new())
  }
  let start_states : Array[Int] = Array::new()
  let rec_tails : Array[Int] = Array::new()
  let mut i = 0
  let ne = entries.length()
  while i < ne {
    let e = entries[i]
    let m = b.add(NfaKind::Match(e.pat_id), -1, -1)
    let is_rec_prefix = if e.tokens.length() >= 2 {
      match e.tokens[0] {
        Token::RecursivePrefix => true
        _ => false
      }
    } else {
      false
    }
    if is_rec_prefix {
      let tail = b.compile_seq_from(
        e.tokens,
        1,
        e.opts,
        e.class_excludes_separator,
        m,
      )
      rec_tails.push(tail)
    } else {
      let st = b.compile_seq_from(
        e.tokens,
        0,
        e.opts,
        e.class_excludes_separator,
        m,
      )
      start_states.push(st)
    }
    i = i + 1
  }
  if rec_tails.length() > 0 {
    // Build one shared epsilon fan-out tree for all `**/` tails,
    // and attach a single shared `(?:|.*/)` gadget to it!
    let mut fanout = rec_tails[rec_tails.length() - 1]
    let mut j = rec_tails.length() - 2
    while j >= 0 {
      fanout = b.add(NfaKind::Epsilon, rec_tails[j], fanout)
      j = j - 1
    }
    let slash = b.add(NfaKind::Byte(47, false), fanout, -1)
    let any_s = b.add(NfaKind::AnyByte(false), -1, -1)
    let star = b.add(NfaKind::Epsilon, any_s, slash)
    b.states[any_s].out1 = star
    start_states.push(fanout)
    start_states.push(star)
  }
  finalize_nfa(b, start_states)
}

fn state_matches_byte(kind : NfaKind, b : Int) -> Bool {
  match kind {
    NfaKind::Byte(lit, ci) =>
    if b == lit {
      true
    } else if ci {
      ascii_lower(b) == ascii_lower(lit)
    } else {
      false
    }
    NfaKind::AnyByte(lit_sep) => !(lit_sep && b == 47)
    NfaKind::ByteClass(w0, w1, w2, w3) => {
      let word = if b < 64 {
        w0
      } else if b < 128 {
        w1
      } else if b < 192 {
        w2
      } else {
        w3
      }
      (word & (1L << (b & 63))) != 0L
    }
    _ => false
  }
}

///| Sort an `Array[Int]` in-place (insertion sort for small arrays, iterative quicksort for large).
fn sort_ints_in_place(arr : Array[Int]) -> Unit {
  let n = arr.length()
  if n <= 1 {
    return
  }
  if n <= 24 {
    let mut i = 1
    while i < n {
      let key = arr[i]
      let mut j = i - 1
      while j >= 0 && arr[j] > key {
        arr[j + 1] = arr[j]
        j = j - 1
      }
      arr[j + 1] = key
      i = i + 1
    }
    return
  }
  // Iterative quicksort with median-of-three pivot
  let stack_lo : Array[Int] = [0]
  let stack_hi : Array[Int] = [n - 1]
  while stack_lo.length() > 0 {
    let lo = match stack_lo.pop() {
      Some(v) => v
      None => break
    }
    let hi = match stack_hi.pop() {
      Some(v) => v
      None => break
    }
    if hi - lo <= 16 {
      let mut i = lo + 1
      while i <= hi {
        let key = arr[i]
        let mut j = i - 1
        while j >= lo && arr[j] > key {
          arr[j + 1] = arr[j]
          j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
      }
      continue
    }
    let mid = lo + ((hi - lo) >> 1)
    if arr[mid] < arr[lo] {
      let t = arr[lo]
      arr[lo] = arr[mid]
      arr[mid] = t
    }
    if arr[hi] < arr[lo] {
      let t = arr[lo]
      arr[lo] = arr[hi]
      arr[hi] = t
    }
    if arr[mid] < arr[hi] {
      let t = arr[mid]
      arr[mid] = arr[hi]
      arr[hi] = t
    }
    let pivot = arr[hi]
    let mut i = lo - 1
    let mut j = lo
    while j < hi {
      if arr[j] <= pivot {
        i = i + 1
        let t = arr[i]
        arr[i] = arr[j]
        arr[j] = t
      }
      j = j + 1
    }
    let p = i + 1
    let t = arr[p]
    arr[p] = arr[hi]
    arr[hi] = t
    if p - 1 > lo {
      stack_lo.push(lo)
      stack_hi.push(p - 1)
    }
    if p + 1 < hi {
      stack_lo.push(p + 1)
      stack_hi.push(hi)
    }
  }
}

fn hash_int_array(arr : Array[Int]) -> Int64 {
  let mut h : Int64 = -3750763034362895579L
  let mut i = 0
  let n = arr.length()
  while i < n {
    h = (h ^ arr[i].to_int64()) * 1099511628211L
    i = i + 1
  }
  h
}

fn eq_int_array(a : Array[Int], b : Array[Int]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Run epsilon closure from `self.eps_stack` and return sorted consuming + Match state IDs.
fn Nfa::eps_closure_from_stack(self : Nfa) -> Array[Int] {
  self.eps_gen = self.eps_gen + 1
  let gen = self.eps_gen
  let gen_arr = self.eps_gen_arr
  let states = self.states
  let out : Array[Int] = Array::new()
  while self.eps_stack.length() > 0 {
    let cur = match self.eps_stack.pop() {
      Some(v) => v
      None => break
    }
    if gen_arr[cur] == gen {
      continue
    }
    gen_arr[cur] = gen
    let st = states[cur]
    match st.kind {
      NfaKind::Epsilon => {
        let o1 = st.out1
        if o1 >= 0 && gen_arr[o1] != gen {
          self.eps_stack.push(o1)
        }
        let o2 = st.out2
        if o2 >= 0 && gen_arr[o2] != gen {
          self.eps_stack.push(o2)
        }
      }
      _ => out.push(cur)
    }
  }
  sort_ints_in_place(out)
  out
}

fn Nfa::rehash_set_table(self : Nfa, new_cap : Int) -> Unit {
  let mask = new_cap - 1
  let buckets : Array[Int] = Array::new()
  let hashes : Array[Int64] = Array::new()
  let mut i = 0
  while i < new_cap {
    buckets.push(-1)
    hashes.push(0L)
    i = i + 1
  }
  let old_buckets = self.tbl_buckets
  let old_hashes = self.tbl_hashes
  let mut k = 0
  while k < old_buckets.length() {
    let sid = old_buckets[k]
    if sid >= 0 {
      let h = old_hashes[k]
      let mut slot = h.to_int() & mask
      while buckets[slot] >= 0 {
        slot = (slot + 1) & mask
      }
      buckets[slot] = sid
      hashes[slot] = h
    }
    k = k + 1
  }
  self.tbl_mask = mask
  self.tbl_buckets = buckets
  self.tbl_hashes = hashes
}

fn Nfa::lookup_dfa_state(self : Nfa, set : Array[Int], h : Int64) -> Int {
  let mask = self.tbl_mask
  let buckets = self.tbl_buckets
  let hashes = self.tbl_hashes
  let sets = self.dfa_sets
  let mut slot = h.to_int() & mask
  while true {
    let sid = buckets[slot]
    if sid < 0 {
      return -1
    }
    if hashes[slot] == h && eq_int_array(sets[sid], set) {
      return sid
    }
    slot = (slot + 1) & mask
  }
  -1
}

fn Nfa::insert_dfa_state(self : Nfa, set : Array[Int], h : Int64) -> Int {
  if (self.tbl_count + 1) * 2 > self.tbl_buckets.length() {
    self.rehash_set_table(self.tbl_buckets.length() * 2)
  }
  let new_id = self.dfa_sets.length()
  self.dfa_sets.push(set)
  self.total_set_ints = self.total_set_ints + set.length()

  let matches : Array[Int] = Array::new()
  let states = self.states
  let mut i = 0
  let ns = set.length()
  while i < ns {
    match states[set[i]].kind {
      NfaKind::Match(pid) => matches.push(pid)
      _ => ()
    }
    i = i + 1
  }
  self.dfa_has_match.push(matches.length() > 0)
  self.dfa_matches.push(matches)

  // Append a zero-initialized transition row (0 = unknown)
  let stride = self.stride
  let mut c = 0
  while c < stride {
    self.dfa_trans.push(0)
    c = c + 1
  }

  let mask = self.tbl_mask
  let buckets = self.tbl_buckets
  let hashes = self.tbl_hashes
  let mut slot = h.to_int() & mask
  while buckets[slot] >= 0 {
    slot = (slot + 1) & mask
  }
  buckets[slot] = new_id
  hashes[slot] = h
  self.tbl_count = self.tbl_count + 1
  new_id
}

fn Nfa::reset_dfa_cache(self : Nfa) -> Unit {
  self.dfa_trans.clear()
  self.dfa_sets.clear()
  self.dfa_has_match.clear()
  self.dfa_matches.clear()
  self.total_set_ints = 0

  // Row 0: unused dummy dead row
  let stride = self.stride
  let mut c = 0
  while c < stride {
    self.dfa_trans.push(-1)
    c = c + 1
  }
  self.dfa_sets.push(Array::new())
  self.dfa_has_match.push(false)
  self.dfa_matches.push(Array::new())

  // Reset open-addressing hash table
  let init_cap = 256
  let buckets : Array[Int] = Array::new()
  let hashes : Array[Int64] = Array::new()
  let mut i = 0
  while i < init_cap {
    buckets.push(-1)
    hashes.push(0L)
    i = i + 1
  }
  self.tbl_mask = init_cap - 1
  self.tbl_buckets = buckets
  self.tbl_hashes = hashes
  self.tbl_count = 0

  // Compute start state (row 1)
  self.eps_stack.clear()
  i = 0
  while i < self.start_states.length() {
    self.eps_stack.push(self.start_states[i])
    i = i + 1
  }
  let start_set = self.eps_closure_from_stack()
  if start_set.length() == 0 {
    self.start_dead = true
  } else {
    self.start_dead = false
    let _ = self.insert_dfa_state(start_set, hash_int_array(start_set))
  }
}

fn Nfa::init_dfa(self : Nfa) -> Unit {
  if self.eps_gen_arr.length() < self.num_states {
    let mut i = self.eps_gen_arr.length()
    while i < self.num_states {
      self.eps_gen_arr.push(0)
      i = i + 1
    }
  }
  self.reset_dfa_cache()
  self.dfa_ready = true
}

///| Compute a missing Lazy DFA transition `(cur_off, cls)` on demand.
///| Returns `next_state_id * stride` (> 0) or `-1` (dead).
fn Nfa::step_lazy(self : Nfa, cur_off : Int, cls : Int) -> Int {
  let stride = self.stride
  let cur_id = cur_off / stride
  let cur_set = self.dfa_sets[cur_id]
  let rb = self.rep_bytes[cls]
  let states = self.states

  self.eps_stack.clear()
  let mut i = 0
  let ns = cur_set.length()
  while i < ns {
    let st = states[cur_set[i]]
    if state_matches_byte(st.kind, rb) {
      let dst = st.out1
      if dst >= 0 {
        self.eps_stack.push(dst)
      }
    }
    i = i + 1
  }

  let next_set = self.eps_closure_from_stack()
  if next_set.length() == 0 {
    self.dfa_trans[cur_off + cls] = -1
    return -1
  }
  let h = hash_int_array(next_set)
  let existing = self.lookup_dfa_state(next_set, h)
  if existing >= 0 {
    let next_off = existing * stride
    self.dfa_trans[cur_off + cls] = next_off
    return next_off
  }

  // Memory-bounded cache flush (~24 MiB cap): clear & continue seamlessly without restarting!
  if self.dfa_sets.length() >= 8192 ||
  self.total_set_ints + next_set.length() > 3000000 ||
  self.dfa_trans.length() + stride > 3000000 {
    self.reset_dfa_cache()
    let after_reset = self.lookup_dfa_state(next_set, h)
    if after_reset >= 0 {
      return after_reset * stride
    }
    let fresh_id = self.insert_dfa_state(next_set, h)
    return fresh_id * stride
  }

  let new_id = self.insert_dfa_state(next_set, h)
  let next_off = new_id * stride
  self.dfa_trans[cur_off + cls] = next_off
  next_off
}

///| Test whether any pattern in this NFA matches `s[start_pos..end_pos]`.
pub fn Nfa::is_match_slice(
  self : Nfa,
  s : String,
  start_pos : Int,
  end_pos : Int,
) -> Bool {
  if !self.dfa_ready {
    self.init_dfa()
  }
  if self.start_dead {
    return false
  }
  let stride = self.stride
  let byte_classes = self.byte_classes
  let mut trans = self.dfa_trans
  let mut st = stride // state 1 = start state
  let mut pos = start_pos
  while pos < end_pos {
    let cls = byte_classes[s.code_unit_at(pos)]
    let nxt = trans[st + cls]
    if nxt > 0 {
      st = nxt
    } else if nxt < 0 {
      return false
    } else {
      st = self.step_lazy(st, cls)
      if st < 0 {
        return false
      }
      trans = self.dfa_trans
    }
    pos = pos + 1
  }
  self.dfa_has_match[st / stride]
}

///| Append all matching pattern IDs for `s[start_pos..end_pos]` into `into`.
pub fn Nfa::matches_slice_into(
  self : Nfa,
  s : String,
  start_pos : Int,
  end_pos : Int,
  into : Array[Int],
) -> Unit {
  if !self.dfa_ready {
    self.init_dfa()
  }
  if self.start_dead {
    return
  }
  let stride = self.stride
  let byte_classes = self.byte_classes
  let mut trans = self.dfa_trans
  let mut st = stride // state 1 = start state
  let mut pos = start_pos
  while pos < end_pos {
    let cls = byte_classes[s.code_unit_at(pos)]
    let nxt = trans[st + cls]
    if nxt > 0 {
      st = nxt
    } else if nxt < 0 {
      return
    } else {
      st = self.step_lazy(st, cls)
      if st < 0 {
        return
      }
      trans = self.dfa_trans
    }
    pos = pos + 1
  }
  let sid = st / stride
  if self.dfa_has_match[sid] {
    let hits = self.dfa_matches[sid]
    let mut i = 0
    let nh = hits.length()
    while i < nh {
      into.push(hits[i])
      i = i + 1
    }
  }
}
