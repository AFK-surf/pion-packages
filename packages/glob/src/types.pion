///| Public API types and stub implementations for `packages/glob`.

///| Kind of error returned when compiling a glob pattern or `.gitignore`.
pub enum GlobErrorKind {
  UnclosedClass
  InvalidRange
  UnopenedAlternates
  UnclosedAlternates
  TooManyNestedAlternates
  DanglingEscape
  Unimplemented
}

///| Error returned when compiling a glob pattern or `.gitignore`.
pub val struct GlobError {
  pub kind : GlobErrorKind
  pub pattern : String
  pub message : String
}

///| Options controlling glob compilation and matching semantics.
pub val struct GlobOptions {
  pub case_insensitive : Bool
  pub literal_separator : Bool
  pub backslash_escape : Bool
  pub empty_alternates : Bool
  pub allow_unclosed_class : Bool
}

///| Default glob options matching `BurntSushi/globset` on Unix.
pub fn GlobOptions::default() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

///| Compiled single glob matcher (immutable, Send-safe).
pub struct Glob {
  pub pattern : String
  pub opts : GlobOptions
}

///| Compiled multi-pattern glob set matcher (immutable, Send-safe).
pub struct GlobSet {
  pub count : Int
}

///| Result of matching a path against a `.gitignore` rule set.
pub enum MatchResult {
  None
  Ignore(Int)
  Whitelist(Int)
}

///| Returns true if the match result is `None`.
pub fn match_is_none(m : MatchResult) -> Bool {
  match m {
    MatchResult::None => true
    _ => false
  }
}

///| Returns true if the match result is `Ignore`.
pub fn match_is_ignore(m : MatchResult) -> Bool {
  match m {
    MatchResult::Ignore(_) => true
    _ => false
  }
}

///| Returns true if the match result is `Whitelist`.
pub fn match_is_whitelist(m : MatchResult) -> Bool {
  match m {
    MatchResult::Whitelist(_) => true
    _ => false
  }
}

///| Returns the 1-based line number of the matching rule, or 0 if `None`.
pub fn match_line(m : MatchResult) -> Int {
  match m {
    MatchResult::None => 0
    MatchResult::Ignore(n) => n
    MatchResult::Whitelist(n) => n
  }
}

///| Compiled `.gitignore` matcher for a directory root.
pub struct Gitignore {
  pub root_path : String
  pub rule_count : Int
  pub ignore_count : Int
  pub whitelist_count : Int
}

///| Stack of nested `.gitignore` matchers ordered from shallowest (root) to deepest.
pub struct GitignoreStack {
  pub layers : Array[Gitignore]
}

fn stub_err(pat : String) -> GlobError {
  GlobError::{
    kind: GlobErrorKind::Unimplemented,
    pattern: pat,
    message: "not implemented yet",
  }
}

///| Compile a single glob pattern with default options.
pub fn compile(pattern : String) -> Result[Glob, GlobError] {
  compile_with(pattern, GlobOptions::default())
}

///| Compile a single glob pattern with custom options.
pub fn compile_with(
  pattern : String,
  opts : GlobOptions,
) -> Result[Glob, GlobError] {
  let _ = opts
  Err(stub_err(pattern))
}

///| Test whether `path` matches this glob.
pub fn Glob::is_match(self : Glob, path : String) -> Bool {
  let _ = self
  let _ = path
  false
}

///| Escape glob meta-characters using bracket notation (e.g. `*` -> `[*]`).
pub fn escape(s : String) -> String {
  let _ = s
  ""
}

///| Compile multiple glob patterns with default options into a `GlobSet`.
pub fn compile_set(patterns : Array[String]) -> Result[GlobSet, GlobError] {
  let _ = patterns
  Err(stub_err(""))
}

///| Compile pre-built `Glob` instances (with per-glob options) into a `GlobSet`.
pub fn compile_set_from_globs(
  globs : Array[Glob],
) -> Result[GlobSet, GlobError] {
  let _ = globs
  Err(stub_err(""))
}

///| Return an empty `GlobSet` that matches nothing.
pub fn GlobSet::empty() -> GlobSet {
  GlobSet::{ count: 0 }
}

///| Return true if this `GlobSet` contains zero patterns.
pub fn GlobSet::is_empty(self : GlobSet) -> Bool {
  self.count == 0
}

///| Return the number of patterns in this `GlobSet`.
pub fn GlobSet::len(self : GlobSet) -> Int {
  self.count
}

///| Return true if any pattern in this set matches `path`.
pub fn GlobSet::is_match(self : GlobSet, path : String) -> Bool {
  let _ = self
  let _ = path
  false
}

///| Return all matching pattern indices in ascending order.
pub fn GlobSet::matches(self : GlobSet, path : String) -> Array[Int] {
  let _ = self
  let _ = path
  Array::new()
}

///| Clear `into` and fill it with all matching pattern indices in ascending order.
pub fn GlobSet::matches_into(
  self : GlobSet,
  path : String,
  into : Array[Int],
) -> Unit {
  let _ = self
  let _ = path
  into.clear()
}

///| Return true if all patterns in this set match `path` (vacuously true when empty).
pub fn GlobSet::matches_all(self : GlobSet, path : String) -> Bool {
  let _ = self
  let _ = path
  false
}

///| Parse a `.gitignore` file content anchored at root `""`.
pub fn parse_gitignore(content : String) -> Result[Gitignore, GlobError] {
  parse_gitignore_with_root("", content)
}

///| Parse a `.gitignore` file content anchored at `root`.
pub fn parse_gitignore_with_root(
  root : String,
  content : String,
) -> Result[Gitignore, GlobError] {
  parse_gitignore_with_options(root, content, false, true)
}

///| Parse a `.gitignore` file content with explicit root and options.
pub fn parse_gitignore_with_options(
  root : String,
  content : String,
  case_insensitive : Bool,
  allow_unclosed_class : Bool,
) -> Result[Gitignore, GlobError] {
  let _ = root
  let _ = content
  let _ = case_insensitive
  let _ = allow_unclosed_class
  Err(stub_err(""))
}

///| Return an empty `Gitignore` matcher.
pub fn Gitignore::empty() -> Gitignore {
  Gitignore::{
    root_path: "",
    rule_count: 0,
    ignore_count: 0,
    whitelist_count: 0,
  }
}

///| Return true if this `Gitignore` has zero rules.
pub fn Gitignore::is_empty(self : Gitignore) -> Bool {
  self.rule_count == 0
}

///| Return total number of rules (`num_ignores + num_whitelists`).
pub fn Gitignore::len(self : Gitignore) -> Int {
  self.rule_count
}

///| Return number of ignore rules.
pub fn Gitignore::num_ignores(self : Gitignore) -> Int {
  self.ignore_count
}

///| Return number of whitelist (negated) rules.
pub fn Gitignore::num_whitelists(self : Gitignore) -> Int {
  self.whitelist_count
}

///| Return the normalized root path of this `Gitignore`.
pub fn Gitignore::root(self : Gitignore) -> String {
  self.root_path
}

///| Match `path` against this `Gitignore` (highest-precedence matching rule wins).
pub fn Gitignore::matched(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  let _ = self
  let _ = path
  let _ = is_dir
  MatchResult::None
}

///| Return true if `path` is ignored by this `Gitignore`.
pub fn Gitignore::is_ignored(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> Bool {
  match_is_ignore(self.matched(path, is_dir))
}

///| Match `path` or any of its parent directories (bottom-up, matching `BurntSushi/ignore`).
pub fn Gitignore::matched_path_or_any_parents(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  let _ = self
  let _ = path
  let _ = is_dir
  MatchResult::None
}

///| Return true if `path` is ignored under git top-down directory-exclusion semantics
///| (if an ancestor directory is ignored, child files cannot be re-included by `!`).
pub fn Gitignore::is_ignored_with_parents(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> Bool {
  let _ = self
  let _ = path
  let _ = is_dir
  false
}

///| Create an empty `GitignoreStack`.
pub fn GitignoreStack::new() -> GitignoreStack {
  GitignoreStack::{ layers: Array::new() }
}

///| Append a deeper `.gitignore` layer to the stack.
pub fn GitignoreStack::push(self : GitignoreStack, gi : Gitignore) -> Unit {
  self.layers.push(gi)
}

///| Match `path` against the stack from deepest to shallowest layer.
pub fn GitignoreStack::matched(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  let _ = self
  let _ = path
  let _ = is_dir
  MatchResult::None
}

///| Return true if `path` is ignored by the deepest matching layer.
pub fn GitignoreStack::is_ignored(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> Bool {
  match_is_ignore(self.matched(path, is_dir))
}

///| Return true if `path` is ignored by the stack under git top-down parent exclusion semantics.
pub fn GitignoreStack::is_ignored_with_parents(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> Bool {
  let _ = self
  let _ = path
  let _ = is_dir
  false
}
