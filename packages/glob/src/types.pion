///| Public API types for `packages/glob`.

///| Kind of error returned when compiling a glob pattern or `.gitignore`.
pub enum GlobErrorKind {
  UnclosedClass
  InvalidRange
  UnopenedAlternates
  UnclosedAlternates
  TooManyNestedAlternates
  DanglingEscape
  Unimplemented
}

///| Error returned when compiling a glob pattern or `.gitignore`.
pub val struct GlobError {
  pub kind : GlobErrorKind
  pub pattern : String
  pub message : String
}

///| Per-line error recorded while parsing a `.gitignore` file with partial-error tolerance.
pub val struct GitignoreError {
  pub line_no : Int
  pub error : GlobError
}

///| Options controlling glob compilation and matching semantics.
pub val struct GlobOptions {
  pub case_insensitive : Bool
  pub literal_separator : Bool
  pub backslash_escape : Bool
  pub empty_alternates : Bool
  pub allow_unclosed_class : Bool
}

///| Default glob options matching `BurntSushi/globset` on Unix.
pub fn GlobOptions::default() -> GlobOptions {
  GlobOptions::{
    case_insensitive: false,
    literal_separator: false,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: false,
  }
}

///| Result of matching a path against a `.gitignore` rule set.
pub enum MatchResult {
  None
  Ignore(Int)
  Whitelist(Int)
}

///| Returns true if the match result is `None`.
pub fn match_is_none(m : MatchResult) -> Bool {
  match m {
    MatchResult::None => true
    _ => false
  }
}

///| Returns true if the match result is `Ignore`.
pub fn match_is_ignore(m : MatchResult) -> Bool {
  match m {
    MatchResult::Ignore(_) => true
    _ => false
  }
}

///| Returns true if the match result is `Whitelist`.
pub fn match_is_whitelist(m : MatchResult) -> Bool {
  match m {
    MatchResult::Whitelist(_) => true
    _ => false
  }
}

///| Returns the 1-based line number of the matching rule, or 0 if `None`.
pub fn match_line(m : MatchResult) -> Int {
  match m {
    MatchResult::None => 0
    MatchResult::Ignore(n) => n
    MatchResult::Whitelist(n) => n
  }
}
