///| `.gitignore` parser and matcher (ported from `BurntSushi/ignore/src/gitignore.rs`),
///| plus git top-down parent-directory exclusion and multi-level `GitignoreStack`.

struct GitignoreRule {
  line_no : Int
  is_whitelist : Bool
  is_only_dir : Bool
}

///| Compiled `.gitignore` matcher for a directory root (immutable, Send-safe).
pub struct Gitignore {
  pub root_path : String
  norm_root : String
  set : GlobSet
  rules : Array[GitignoreRule]
  pub rule_count : Int
  pub ignore_count : Int
  pub whitelist_count : Int
}

///| Stack of nested `.gitignore` matchers ordered from shallowest (root) to deepest.
pub struct GitignoreStack {
  pub layers : Array[Gitignore]
}

///| Trim trailing unescaped spaces from a `.gitignore` line.
fn trim_trailing_unescaped_spaces(line : String) -> String {
  let n = line.length()
  let mut last_space = -1
  let mut i = 0
  while i < n {
    let b = line.code_unit_at(i)
    if b == 92 { // '\\'
      if i + 1 >= n {
        return line
      }
      i = i + 2
      last_space = -1
    } else if b == 32 { // ' '
      if last_space < 0 {
        last_space = i
      }
      i = i + 1
    } else {
      last_space = -1
      i = i + 1
    }
  }
  if last_space >= 0 {
    line.slice(0, last_space)
  } else {
    line
  }
}

///| Normalize a relative/absolute root path by stripping redundant `./` prefixes and trailing `/` / `/.`.
fn normalize_root_for_strip(p : String) -> String {
  let mut s = p
  // Strip repeated leading "./"
  while s.length() >= 2 && s.code_unit_at(0) == 46 && s.code_unit_at(1) == 47 {
    s = s.slice(2, s.length())
  }
  // Strip trailing "/" (unless root is "/")
  while s.length() > 1 && s.code_unit_at(s.length() - 1) == 47 {
    s = s.slice(0, s.length() - 1)
  }
  // Strip trailing "/."
  while s.length() >= 2 &&
  s.code_unit_at(s.length() - 2) == 47 &&
  s.code_unit_at(s.length() - 1) == 46 {
    s = s.slice(0, s.length() - 2)
  }
  if s == "." {
    ""
  } else {
    s
  }
}

///| Strip leading `./` (one or more) from a candidate path.
fn strip_leading_dot_slash(p : String) -> String {
  let mut s = p
  while s.length() >= 2 && s.code_unit_at(0) == 46 && s.code_unit_at(1) == 47 {
    s = s.slice(2, s.length())
  }
  s
}

fn has_slash(s : String) -> Bool {
  let mut i = 0
  let n = s.length()
  while i < n {
    if s.code_unit_at(i) == 47 {
      return true
    }
    i = i + 1
  }
  false
}

///| Strip `norm_root` prefix from `path` on a path-component boundary.
///| Returns `(stripped, matched_root_prefix)`.
fn strip_path_prefix(norm_root : String, path : String) -> (String, Bool) {
  let p = strip_leading_dot_slash(path)
  if norm_root.length() == 0 {
    return (p, true)
  }
  if !has_slash(p) {
    // Bare filename has no directory components; do not strip root unless exact match.
    if p == norm_root {
      return ("", true)
    }
    return (p, false)
  }
  if p == norm_root {
    return ("", true)
  }
  let rlen = norm_root.length()
  if p.length() > rlen && str_starts_with(p, norm_root) {
    if norm_root == "/" {
      return (p.slice(1, p.length()), true)
    }
    if p.code_unit_at(rlen) == 47 {
      let mut rest = p.slice(rlen + 1, p.length())
      while rest.length() > 0 && rest.code_unit_at(0) == 47 {
        rest = rest.slice(1, rest.length())
      }
      return (rest, true)
    }
  }
  (p, false)
}

///| Return an empty `Gitignore` matcher.
pub fn Gitignore::empty() -> Gitignore {
  Gitignore::{
    root_path: "",
    norm_root: "",
    set: GlobSet::empty(),
    rules: Array::new(),
    rule_count: 0,
    ignore_count: 0,
    whitelist_count: 0,
  }
}

///| Return true if this `Gitignore` has zero rules.
pub fn Gitignore::is_empty(self : Gitignore) -> Bool {
  self.rule_count == 0
}

///| Return total number of rules (`num_ignores + num_whitelists`).
pub fn Gitignore::len(self : Gitignore) -> Int {
  self.rule_count
}

///| Return number of ignore rules.
pub fn Gitignore::num_ignores(self : Gitignore) -> Int {
  self.ignore_count
}

///| Return number of whitelist (negated) rules.
pub fn Gitignore::num_whitelists(self : Gitignore) -> Int {
  self.whitelist_count
}

///| Return the root path of this `Gitignore`.
pub fn Gitignore::root(self : Gitignore) -> String {
  self.root_path
}

///| Incremental builder for `Gitignore` supporting per-line additions and partial error tolerance.
pub struct GitignoreBuilder {
  root_path : String
  norm_root : String
  mut opt_case_insensitive : Bool
  mut opt_allow_unclosed_class : Bool
  globs : Array[Glob]
  rules : Array[GitignoreRule]
  mut ignore_count : Int
  mut whitelist_count : Int
  mut next_line_no : Int
}

///| Create a new `GitignoreBuilder` anchored at `root`.
pub fn GitignoreBuilder::new(root : String) -> GitignoreBuilder {
  GitignoreBuilder::{
    root_path: root,
    norm_root: normalize_root_for_strip(root),
    opt_case_insensitive: false,
    opt_allow_unclosed_class: true,
    globs: Array::new(),
    rules: Array::new(),
    ignore_count: 0,
    whitelist_count: 0,
    next_line_no: 0,
  }
}

///| Toggle case-insensitive matching for subsequent lines added to this builder.
pub fn GitignoreBuilder::case_insensitive(
  self : GitignoreBuilder,
  yes : Bool,
) -> GitignoreBuilder {
  self.opt_case_insensitive = yes
  self
}

///| Toggle whether unclosed `[` is treated as a literal character for subsequent lines.
pub fn GitignoreBuilder::allow_unclosed_class(
  self : GitignoreBuilder,
  yes : Bool,
) -> GitignoreBuilder {
  self.opt_allow_unclosed_class = yes
  self
}

///| Parse and add a single `.gitignore` line. Returns `Err(GlobError)` if the line is invalid
///| (without corrupting previously or subsequently added rules).
pub fn GitignoreBuilder::add_line(
  self : GitignoreBuilder,
  raw_line : String,
) -> Result[Unit, GlobError] {
  self.next_line_no = self.next_line_no + 1
  let line_no = self.next_line_no
  let mut line = raw_line
  // Strip trailing '\r' if present
  if line.length() > 0 && line.code_unit_at(line.length() - 1) == 13 {
    line = line.slice(0, line.length() - 1)
  }
  // Strip UTF-8 BOM on line 1 (0xEF 0xBB 0xBF)
  if line_no == 1 &&
  line.length() >= 3 &&
  line.code_unit_at(0) == 0xEF &&
  line.code_unit_at(1) == 0xBB &&
  line.code_unit_at(2) == 0xBF {
    line = line.slice(3, line.length())
  }
  if line.length() == 0 || line.code_unit_at(0) == 35 { // '#'
    return Ok(())
  }
  line = trim_trailing_unescaped_spaces(line)
  if line.length() == 0 {
    return Ok(())
  }

  let mut is_whitelist = false
  let mut is_only_dir = false
  let mut is_absolute = false

  if line.length() >= 2 &&
  line.code_unit_at(0) == 92 &&
  (line.code_unit_at(1) == 33 || line.code_unit_at(1) == 35) {
    // '\!' or '\#'
    line = line.slice(1, line.length())
    is_absolute = line.length() > 0 && line.code_unit_at(0) == 47
  } else {
    if line.length() > 0 && line.code_unit_at(0) == 33 { // '!'
      is_whitelist = true
      line = line.slice(1, line.length())
    }
    if line.length() > 0 && line.code_unit_at(0) == 47 { // '/'
      is_absolute = true
      line = line.slice(1, line.length())
    }
  }

  if line.length() == 0 {
    return Ok(())
  }

  if line.code_unit_at(line.length() - 1) == 47 { // trailing '/'
    is_only_dir = true
    line = line.slice(0, line.length() - 1)
    if line.length() > 0 && line.code_unit_at(line.length() - 1) == 92 { // escaped '\/'
      line = line.slice(0, line.length() - 1)
    }
  }

  let mut actual = line
  if !is_absolute && !has_slash(line) {
    if !str_starts_with(actual, "**/") && actual != "**" {
      actual = "**/" + actual
    }
  }
  if str_ends_with(actual, "/**") {
    actual = actual + "/*"
  }

  let opts = GlobOptions::{
    case_insensitive: self.opt_case_insensitive,
    literal_separator: true,
    backslash_escape: true,
    empty_alternates: false,
    allow_unclosed_class: self.opt_allow_unclosed_class,
  }
  let compiled = match compile_with_internal(actual, opts, true, true) {
    Ok(g) => g
    Err(e) => return Err(e)
  }
  self.globs.push(compiled)
  self.rules.push(GitignoreRule::{ line_no, is_whitelist, is_only_dir })
  if is_whitelist {
    self.whitelist_count = self.whitelist_count + 1
  } else {
    self.ignore_count = self.ignore_count + 1
  }
  Ok(())
}

///| Add all lines from `content`, skipping invalid lines and returning their recorded errors.
pub fn GitignoreBuilder::add_str(
  self : GitignoreBuilder,
  content : String,
) -> Array[GitignoreError] {
  let errors : Array[GitignoreError] = Array::new()
  let n = content.length()
  let mut pos = 0
  while pos < n {
    let start = pos
    while pos < n && content.code_unit_at(pos) != 10 {
      pos = pos + 1
    }
    let end = pos
    if pos < n && content.code_unit_at(pos) == 10 {
      pos = pos + 1
    }
    let line = content.slice(start, end)
    match self.add_line(line) {
      Ok(_) => ()
      Err(e) =>
      errors.push(GitignoreError::{ line_no: self.next_line_no, error: e })
    }
  }
  errors
}

///| Build the compiled `Gitignore` matcher from all valid rules added so far.
pub fn GitignoreBuilder::build(
  self : GitignoreBuilder,
) -> Result[Gitignore, GlobError] {
  let set = match compile_set_from_globs(self.globs) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(Gitignore::{
    root_path: self.root_path,
    norm_root: self.norm_root,
    set,
    rules: self.rules,
    rule_count: self.rules.length(),
    ignore_count: self.ignore_count,
    whitelist_count: self.whitelist_count,
  })
}

///| Parse a `.gitignore` file content anchored at `root`, skipping invalid lines
///| and returning both the valid `Gitignore` matcher and any per-line parse errors.
pub fn parse_gitignore_partial(
  root : String,
  content : String,
  case_insensitive : Bool,
  allow_unclosed_class : Bool,
) -> (Gitignore, Array[GitignoreError]) {
  let b = GitignoreBuilder::new(root)
  .case_insensitive(case_insensitive)
  .allow_unclosed_class(allow_unclosed_class)
  let errors = b.add_str(content)
  let gi = match b.build() {
    Ok(g) => g
    Err(_) => Gitignore::empty()
  }
  (gi, errors)
}

///| Parse a `.gitignore` file content anchored at root `""` (tolerates bad lines like `git` and `ignore`).
pub fn parse_gitignore(content : String) -> Result[Gitignore, GlobError] {
  parse_gitignore_with_root("", content)
}

///| Parse a `.gitignore` file content anchored at `root` (tolerates bad lines like `git` and `ignore`).
pub fn parse_gitignore_with_root(
  root : String,
  content : String,
) -> Result[Gitignore, GlobError] {
  parse_gitignore_with_options(root, content, false, true)
}

///| Parse a `.gitignore` file content with explicit root and options (tolerates bad lines like `git` and `ignore`).
pub fn parse_gitignore_with_options(
  root : String,
  content : String,
  case_insensitive : Bool,
  allow_unclosed_class : Bool,
) -> Result[Gitignore, GlobError] {
  let (gi, _) = parse_gitignore_partial(
    root,
    content,
    case_insensitive,
    allow_unclosed_class,
  )
  Ok(gi)
}

fn Gitignore::matched_stripped(
  self : Gitignore,
  stripped : String,
  is_dir : Bool,
) -> MatchResult {
  if self.rule_count == 0 {
    return MatchResult::None
  }
  let hits = self.set.matches(stripped)
  let mut i = hits.length() - 1
  while i >= 0 {
    let idx = hits[i]
    let rule = self.rules[idx]
    if !rule.is_only_dir || is_dir {
      if rule.is_whitelist {
        return MatchResult::Whitelist(rule.line_no)
      } else {
        return MatchResult::Ignore(rule.line_no)
      }
    }
    i = i - 1
  }
  MatchResult::None
}

///| Match `path` against this `Gitignore` (highest-precedence matching rule wins).
pub fn Gitignore::matched(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  if self.rule_count == 0 {
    return MatchResult::None
  }
  let (stripped, _) = strip_path_prefix(self.norm_root, path)
  let candidate = if stripped.length() == 0 { path } else { stripped }
  self.matched_stripped(candidate, is_dir)
}

///| Return true if `path` is ignored by this `Gitignore`.
pub fn Gitignore::is_ignored(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> Bool {
  match_is_ignore(self.matched(path, is_dir))
}

///| Match `path` or any of its parent directories (bottom-up, matching `BurntSushi/ignore`).
pub fn Gitignore::matched_path_or_any_parents(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  if self.rule_count == 0 {
    return MatchResult::None
  }
  let (stripped, _) = strip_path_prefix(self.norm_root, path)
  if stripped.length() == 0 {
    return MatchResult::None
  }
  let m = self.matched_stripped(stripped, is_dir)
  if !match_is_none(m) {
    return m
  }
  let mut cur = stripped
  while true {
    let mut last_slash = -1
    let mut i = cur.length() - 1
    while i >= 0 {
      if cur.code_unit_at(i) == 47 {
        last_slash = i
        break
      }
      i = i - 1
    }
    if last_slash <= 0 {
      break
    }
    cur = cur.slice(0, last_slash)
    let pm = self.matched_stripped(cur, true)
    if !match_is_none(pm) {
      return pm
    }
  }
  MatchResult::None
}

///| Return true if `path` is ignored under git top-down directory-exclusion semantics
///| (if an ancestor directory is ignored, child files cannot be re-included by `!`).
pub fn Gitignore::is_ignored_with_parents(
  self : Gitignore,
  path : String,
  is_dir : Bool,
) -> Bool {
  if self.rule_count == 0 {
    return false
  }
  let (stripped, _) = strip_path_prefix(self.norm_root, path)
  if stripped.length() == 0 {
    return false
  }
  // Walk ancestors top-down: shallowest to deepest
  let n = stripped.length()
  let mut i = 1
  while i < n {
    if stripped.code_unit_at(i) == 47 {
      let anc = stripped.slice(0, i)
      if match_is_ignore(self.matched_stripped(anc, true)) {
        return true
      }
    }
    i = i + 1
  }
  match_is_ignore(self.matched_stripped(stripped, is_dir))
}

///| Create an empty `GitignoreStack`.
pub fn GitignoreStack::new() -> GitignoreStack {
  GitignoreStack::{ layers: Array::new() }
}

///| Append a deeper `.gitignore` layer to the stack.
pub fn GitignoreStack::push(self : GitignoreStack, gi : Gitignore) -> Unit {
  self.layers.push(gi)
}

fn layer_applies(gi : Gitignore, path : String) -> Bool {
  if gi.norm_root.length() == 0 {
    return true
  }
  let (_, matched_prefix) = strip_path_prefix(gi.norm_root, path)
  matched_prefix
}

///| Match `path` against the stack from deepest to shallowest applicable layer.
pub fn GitignoreStack::matched(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> MatchResult {
  let mut i = self.layers.length() - 1
  while i >= 0 {
    let layer = self.layers[i]
    if layer_applies(layer, path) {
      let m = layer.matched(path, is_dir)
      if !match_is_none(m) {
        return m
      }
    }
    i = i - 1
  }
  MatchResult::None
}

///| Return true if `path` is ignored by the deepest matching layer.
pub fn GitignoreStack::is_ignored(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> Bool {
  match_is_ignore(self.matched(path, is_dir))
}

///| Return true if `path` is ignored by the stack under git top-down parent exclusion semantics.
pub fn GitignoreStack::is_ignored_with_parents(
  self : GitignoreStack,
  path : String,
  is_dir : Bool,
) -> Bool {
  let norm = strip_leading_dot_slash(path)
  let n = norm.length()
  let mut i = 1
  while i < n {
    if norm.code_unit_at(i) == 47 {
      let anc = norm.slice(0, i)
      if match_is_ignore(self.matched(anc, true)) {
        return true
      }
    }
    i = i + 1
  }
  match_is_ignore(self.matched(norm, is_dir))
}
