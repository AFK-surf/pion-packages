///| Zero-allocation lookup structures for `GlobSet` fast strategies:
///| 1. `StrTable`: open-addressing FNV-1a hash table that looks up `s[start..end]`
///|    WITHOUT allocating a sliced `String`, plus a 64-bit length bitmask prefilter!
///| 2. `ByteTrie`: compact byte trie for O(min(len, max_pat)) prefix & reversed-suffix
///|    matching with zero allocations per query!

///| Compute 64-bit FNV-1a hash of `s[start..end]`.
pub fn fnv1a_slice(s : String, start : Int, end : Int) -> Int64 {
  let mut h : Int64 = -3750763034362895579L // 0xcbf29ce484222325
  let mut i = start
  while i < end {
    h = h ^ s.code_unit_at(i).to_int64()
    h = h * 1099511628211L // 0x100000001b3
    i = i + 1
  }
  h
}

///| Compare `s[start..end]` with full string `key` byte-by-byte (zero allocation).
pub fn slice_eq_str(s : String, start : Int, end : Int, key : String) -> Bool {
  let len = end - start
  if len != key.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if s.code_unit_at(start + i) != key.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Open-addressing hash table mapping `String` keys -> `Array[Int]` pattern indices,
///| supporting zero-allocation lookup by `(String, start, end)`.
pub struct StrTable {
  pub mask : Int
  pub keys : Array[String]
  pub occupied : Array[Bool]
  pub values : Array[Array[Int]]
  pub lengths : Int64
  pub entry_count : Int
}

pub fn StrTable::empty() -> StrTable {
  StrTable::{
    mask: 0,
    keys: Array::new(),
    occupied: Array::new(),
    values: Array::new(),
    lengths: 0L,
    entry_count: 0,
  }
}

pub fn StrTable::is_empty(self : StrTable) -> Bool {
  self.entry_count == 0
}

///| Build an immutable `StrTable` from `(key, pat_id)` pairs.
pub fn build_str_table(
  raw_keys : Array[String],
  raw_ids : Array[Int],
) -> StrTable {
  let n = raw_keys.length()
  if n == 0 {
    return StrTable::empty()
  }
  // Choose power-of-2 capacity >= 2 * n (at least 8).
  let mut cap = 8
  while cap < n * 2 {
    cap = cap * 2
  }
  let mask = cap - 1
  let keys : Array[String] = Array::new()
  let occupied : Array[Bool] = Array::new()
  let values : Array[Array[Int]] = Array::new()
  let mut i = 0
  while i < cap {
    keys.push("")
    occupied.push(false)
    values.push(Array::new())
    i = i + 1
  }
  let mut lengths = 0L
  let mut entry_count = 0
  i = 0
  while i < n {
    let k = raw_keys[i]
    let id = raw_ids[i]
    lengths = lengths | (1L << (k.length() % 64))
    let h = fnv1a_slice(k, 0, k.length())
    let mut slot = h.to_int() & mask
    while true {
      if !occupied[slot] {
        occupied[slot] = true
        keys[slot] = k
        values[slot].push(id)
        entry_count = entry_count + 1
        break
      } else if keys[slot] == k {
        values[slot].push(id)
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrTable::{ mask, keys, occupied, values, lengths, entry_count }
}

///| Check whether `s[start..end]` exists in this table (zero allocation).
pub fn StrTable::contains_slice(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
) -> Bool {
  if self.entry_count == 0 {
    return false
  }
  let len = end - start
  if (self.lengths & (1L << (len % 64))) == 0L {
    return false
  }
  let h = fnv1a_slice(s, start, end)
  let mut slot = h.to_int() & self.mask
  while self.occupied[slot] {
    if slice_eq_str(s, start, end, self.keys[slot]) {
      return true
    }
    slot = (slot + 1) & self.mask
  }
  false
}

///| Append all pattern IDs associated with `s[start..end]` into `into` (zero allocation).
pub fn StrTable::matches_slice_into(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
  into : Array[Int],
) -> Unit {
  if self.entry_count == 0 {
    return
  }
  let len = end - start
  if (self.lengths & (1L << (len % 64))) == 0L {
    return
  }
  let h = fnv1a_slice(s, start, end)
  let mut slot = h.to_int() & self.mask
  while self.occupied[slot] {
    if slice_eq_str(s, start, end, self.keys[slot]) {
      let hits = self.values[slot]
      let mut i = 0
      let nh = hits.length()
      while i < nh {
        into.push(hits[i])
        i = i + 1
      }
      return
    }
    slot = (slot + 1) & self.mask
  }
}

///| Compact byte trie for fast prefix and reversed-suffix matching.
pub struct ByteTrieNode {
  pub edge_bytes : Array[Int]
  pub edge_next : Array[Int]
  pub pat_ids : Array[Int]
}

pub struct ByteTrie {
  pub nodes : Array[ByteTrieNode]
  pub root_jump : Array[Int] // 128-entry direct jump from root for ASCII
  pub count : Int
}

pub fn ByteTrie::empty() -> ByteTrie {
  ByteTrie::{ nodes: Array::new(), root_jump: Array::new(), count: 0 }
}

pub fn ByteTrie::is_empty(self : ByteTrie) -> Bool {
  self.count == 0
}

fn new_trie_node() -> ByteTrieNode {
  ByteTrieNode::{
    edge_bytes: Array::new(),
    edge_next: Array::new(),
    pat_ids: Array::new(),
  }
}

fn trie_find_edge(node : ByteTrieNode, b : Int) -> Int {
  let mut i = 0
  let n = node.edge_bytes.length()
  while i < n {
    if node.edge_bytes[i] == b {
      return node.edge_next[i]
    }
    i = i + 1
  }
  -1
}

///| Build a prefix trie (when `reversed == false`) or suffix trie (when `reversed == true`).
pub fn build_byte_trie(
  pats : Array[String],
  ids : Array[Int],
  reversed : Bool,
) -> ByteTrie {
  let n = pats.length()
  if n == 0 {
    return ByteTrie::empty()
  }
  let nodes : Array[ByteTrieNode] = Array::new()
  nodes.push(new_trie_node())
  let mut i = 0
  while i < n {
    let p = pats[i]
    let plen = p.length()
    let mut cur = 0
    if !reversed {
      let mut j = 0
      while j < plen {
        let b = p.code_unit_at(j)
        let nxt = trie_find_edge(nodes[cur], b)
        if nxt >= 0 {
          cur = nxt
        } else {
          let new_id = nodes.length()
          nodes.push(new_trie_node())
          nodes[cur].edge_bytes.push(b)
          nodes[cur].edge_next.push(new_id)
          cur = new_id
        }
        j = j + 1
      }
    } else {
      let mut j = plen - 1
      while j >= 0 {
        let b = p.code_unit_at(j)
        let nxt = trie_find_edge(nodes[cur], b)
        if nxt >= 0 {
          cur = nxt
        } else {
          let new_id = nodes.length()
          nodes.push(new_trie_node())
          nodes[cur].edge_bytes.push(b)
          nodes[cur].edge_next.push(new_id)
          cur = new_id
        }
        j = j - 1
      }
    }
    nodes[cur].pat_ids.push(ids[i])
    i = i + 1
  }
  let root_jump : Array[Int] = Array::new()
  let mut b = 0
  while b < 128 {
    root_jump.push(trie_find_edge(nodes[0], b))
    b = b + 1
  }
  ByteTrie::{ nodes, root_jump, count: n }
}

///| Check whether any prefix in this trie matches the start of `path`.
pub fn ByteTrie::is_match_prefix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  if self.nodes[0].pat_ids.length() > 0 {
    return true
  }
  let n = path.length()
  if n == 0 {
    return false
  }
  let b0 = path.code_unit_at(0)
  let mut cur = if b0 < 128 {
    self.root_jump[b0]
  } else {
    trie_find_edge(self.nodes[0], b0)
  }
  if cur < 0 {
    return false
  }
  if self.nodes[cur].pat_ids.length() > 0 {
    return true
  }
  let mut i = 1
  while i < n {
    let nxt = trie_find_edge(self.nodes[cur], path.code_unit_at(i))
    if nxt < 0 {
      return false
    }
    cur = nxt
    if self.nodes[cur].pat_ids.length() > 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Append all matching prefix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_prefix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let r_ids = self.nodes[0].pat_ids
  let mut k = 0
  while k < r_ids.length() {
    into.push(r_ids[k])
    k = k + 1
  }
  let n = path.length()
  if n == 0 {
    return
  }
  let b0 = path.code_unit_at(0)
  let mut cur = if b0 < 128 {
    self.root_jump[b0]
  } else {
    trie_find_edge(self.nodes[0], b0)
  }
  if cur < 0 {
    return
  }
  let ids0 = self.nodes[cur].pat_ids
  k = 0
  while k < ids0.length() {
    into.push(ids0[k])
    k = k + 1
  }
  let mut i = 1
  while i < n {
    let nxt = trie_find_edge(self.nodes[cur], path.code_unit_at(i))
    if nxt < 0 {
      return
    }
    cur = nxt
    let ids = self.nodes[cur].pat_ids
    k = 0
    while k < ids.length() {
      into.push(ids[k])
      k = k + 1
    }
    i = i + 1
  }
}

///| Check whether any reversed suffix in this trie matches the end of `path`.
pub fn ByteTrie::is_match_suffix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  if self.nodes[0].pat_ids.length() > 0 {
    return true
  }
  let n = path.length()
  if n == 0 {
    return false
  }
  let b0 = path.code_unit_at(n - 1)
  let mut cur = if b0 < 128 {
    self.root_jump[b0]
  } else {
    trie_find_edge(self.nodes[0], b0)
  }
  if cur < 0 {
    return false
  }
  if self.nodes[cur].pat_ids.length() > 0 {
    return true
  }
  let mut i = n - 2
  while i >= 0 {
    let nxt = trie_find_edge(self.nodes[cur], path.code_unit_at(i))
    if nxt < 0 {
      return false
    }
    cur = nxt
    if self.nodes[cur].pat_ids.length() > 0 {
      return true
    }
    i = i - 1
  }
  false
}

///| Append all matching suffix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_suffix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let r_ids = self.nodes[0].pat_ids
  let mut k = 0
  while k < r_ids.length() {
    into.push(r_ids[k])
    k = k + 1
  }
  let n = path.length()
  if n == 0 {
    return
  }
  let b0 = path.code_unit_at(n - 1)
  let mut cur = if b0 < 128 {
    self.root_jump[b0]
  } else {
    trie_find_edge(self.nodes[0], b0)
  }
  if cur < 0 {
    return
  }
  let ids0 = self.nodes[cur].pat_ids
  k = 0
  while k < ids0.length() {
    into.push(ids0[k])
    k = k + 1
  }
  let mut i = n - 2
  while i >= 0 {
    let nxt = trie_find_edge(self.nodes[cur], path.code_unit_at(i))
    if nxt < 0 {
      return
    }
    cur = nxt
    let ids = self.nodes[cur].pat_ids
    k = 0
    while k < ids.length() {
      into.push(ids[k])
      k = k + 1
    }
    i = i - 1
  }
}
