///| Zero-allocation lookup structures for `GlobSet` fast strategies:
///| 1. `StrTable`: open-addressing FNV-1a hash table that looks up `s[start..end]`
///|    WITHOUT allocating a sliced `String`, with min/max length + 64-bit length bitmask
///|    + stored hash prefilters!
///| 2. `ByteTrie`: flat pre-multiplied 128-entry-per-state ASCII trie for O(min(len, max_pat))
///|    prefix & reversed-suffix matching with zero pointer chasing and zero allocations!

///| Compute 64-bit FNV-1a hash of `s[start..end]`.
pub fn fnv1a_slice(s : String, start : Int, end : Int) -> Int64 {
  let mut h : Int64 = -3750763034362895579L // 0xcbf29ce484222325
  let mut i = start
  while i < end {
    h = (h ^ s.code_unit_at(i).to_int64()) * 1099511628211L
    i = i + 1
  }
  h
}

///| Compare `s[start..end]` with full string `key` byte-by-byte (zero allocation).
pub fn slice_eq_str(s : String, start : Int, end : Int, key : String) -> Bool {
  let len = end - start
  if len != key.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if s.code_unit_at(start + i) != key.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Open-addressing hash table mapping `String` keys -> `Array[Int]` pattern indices,
///| supporting zero-allocation lookup by `(String, start, end)`.
pub struct StrTable {
  pub mask : Int
  pub keys : Array[String]
  pub hashes : Array[Int64]
  pub occupied : Array[Bool]
  pub values : Array[Array[Int]]
  pub lengths : Int64
  pub min_len : Int
  pub max_len : Int
  pub entry_count : Int
}

pub fn StrTable::empty() -> StrTable {
  StrTable::{
    mask: 0,
    keys: Array::new(),
    hashes: Array::new(),
    occupied: Array::new(),
    values: Array::new(),
    lengths: 0L,
    min_len: 0,
    max_len: -1,
    entry_count: 0,
  }
}

pub fn StrTable::is_empty(self : StrTable) -> Bool {
  self.entry_count == 0
}

///| Build an immutable `StrTable` from `(key, pat_id)` pairs.
pub fn build_str_table(
  raw_keys : Array[String],
  raw_ids : Array[Int],
) -> StrTable {
  let n = raw_keys.length()
  if n == 0 {
    return StrTable::empty()
  }
  let mut cap = 8
  while cap < n * 2 {
    cap = cap * 2
  }
  let mask = cap - 1
  let keys : Array[String] = Array::new()
  let hashes : Array[Int64] = Array::new()
  let occupied : Array[Bool] = Array::new()
  let values : Array[Array[Int]] = Array::new()
  let mut i = 0
  while i < cap {
    keys.push("")
    hashes.push(0L)
    occupied.push(false)
    values.push(Array::new())
    i = i + 1
  }
  let mut lengths = 0L
  let mut min_len = 2147483647
  let mut max_len = -1
  let mut entry_count = 0
  i = 0
  while i < n {
    let k = raw_keys[i]
    let klen = k.length()
    let id = raw_ids[i]
    lengths = lengths | (1L << (klen % 64))
    if klen < min_len {
      min_len = klen
    }
    if klen > max_len {
      max_len = klen
    }
    let h = fnv1a_slice(k, 0, klen)
    let mut slot = h.to_int() & mask
    while true {
      if !occupied[slot] {
        occupied[slot] = true
        keys[slot] = k
        hashes[slot] = h
        values[slot].push(id)
        entry_count = entry_count + 1
        break
      } else if hashes[slot] == h && keys[slot] == k {
        values[slot].push(id)
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrTable::{
    mask,
    keys,
    hashes,
    occupied,
    values,
    lengths,
    min_len,
    max_len,
    entry_count,
  }
}

///| Check whether `s[start..end]` exists in this table (zero allocation).
pub fn StrTable::contains_slice(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
) -> Bool {
  if self.entry_count == 0 {
    return false
  }
  let len = end - start
  if len < self.min_len ||
  len > self.max_len ||
  (self.lengths & (1L << (len % 64))) == 0L {
    return false
  }
  let h = fnv1a_slice(s, start, end)
  let mask = self.mask
  let occupied = self.occupied
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = h.to_int() & mask
  while occupied[slot] {
    if hashes[slot] == h && slice_eq_str(s, start, end, keys[slot]) {
      return true
    }
    slot = (slot + 1) & mask
  }
  false
}

///| Append all pattern IDs associated with `s[start..end]` into `into` (zero allocation).
pub fn StrTable::matches_slice_into(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
  into : Array[Int],
) -> Unit {
  if self.entry_count == 0 {
    return
  }
  let len = end - start
  if len < self.min_len ||
  len > self.max_len ||
  (self.lengths & (1L << (len % 64))) == 0L {
    return
  }
  let h = fnv1a_slice(s, start, end)
  let mask = self.mask
  let occupied = self.occupied
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = h.to_int() & mask
  while occupied[slot] {
    if hashes[slot] == h && slice_eq_str(s, start, end, keys[slot]) {
      let hits = self.values[slot]
      let mut i = 0
      let nh = hits.length()
      while i < nh {
        into.push(hits[i])
        i = i + 1
      }
      return
    }
    slot = (slot + 1) & mask
  }
}

///| Flat pre-multiplied 128-entry-per-state ASCII byte trie for prefix & reversed-suffix matching.
///| Zero pointer chases and zero allocations in the ASCII hot loop.
pub struct ByteTrie {
  // Flat transition table: `trans[state * 128 + b]` = `next_state * 128` (or -1 if dead).
  pub trans : Array[Int]
  pub has_match : Array[Bool]
  pub pat_ids : Array[Array[Int]]
  // Non-ASCII fallback edges per state (empty for all ASCII patterns).
  pub non_ascii_bytes : Array[Array[Int]]
  pub non_ascii_next : Array[Array[Int]]
  pub count : Int
}

pub fn ByteTrie::empty() -> ByteTrie {
  ByteTrie::{
    trans: Array::new(),
    has_match: Array::new(),
    pat_ids: Array::new(),
    non_ascii_bytes: Array::new(),
    non_ascii_next: Array::new(),
    count: 0,
  }
}

pub fn ByteTrie::is_empty(self : ByteTrie) -> Bool {
  self.count == 0
}

fn push_trie_state(
  trans : Array[Int],
  has_match : Array[Bool],
  pat_ids : Array[Array[Int]],
  non_ascii_bytes : Array[Array[Int]],
  non_ascii_next : Array[Array[Int]],
) -> Int {
  let id = has_match.length()
  let mut b = 0
  while b < 128 {
    trans.push(-1)
    b = b + 1
  }
  has_match.push(false)
  pat_ids.push(Array::new())
  non_ascii_bytes.push(Array::new())
  non_ascii_next.push(Array::new())
  id
}

fn find_non_ascii_edge(bytes : Array[Int], nexts : Array[Int], b : Int) -> Int {
  let mut i = 0
  let n = bytes.length()
  while i < n {
    if bytes[i] == b {
      return nexts[i]
    }
    i = i + 1
  }
  -1
}

///| Build a flat prefix trie (`reversed == false`) or reversed suffix trie (`reversed == true`).
pub fn build_byte_trie(
  pats : Array[String],
  ids : Array[Int],
  reversed : Bool,
) -> ByteTrie {
  let n = pats.length()
  if n == 0 {
    return ByteTrie::empty()
  }
  let trans : Array[Int] = Array::new()
  let has_match : Array[Bool] = Array::new()
  let pat_ids : Array[Array[Int]] = Array::new()
  let non_ascii_bytes : Array[Array[Int]] = Array::new()
  let non_ascii_next : Array[Array[Int]] = Array::new()
  let _ = push_trie_state(
    trans,
    has_match,
    pat_ids,
    non_ascii_bytes,
    non_ascii_next,
  )

  let mut i = 0
  while i < n {
    let p = pats[i]
    let plen = p.length()
    let mut cur = 0
    if !reversed {
      let mut j = 0
      while j < plen {
        let b = p.code_unit_at(j)
        if b < 128 {
          let idx = (cur << 7) + b
          let nxt = trans[idx]
          if nxt >= 0 {
            cur = nxt >> 7
          } else {
            let new_id = push_trie_state(
              trans,
              has_match,
              pat_ids,
              non_ascii_bytes,
              non_ascii_next,
            )
            trans[idx] = new_id << 7
            cur = new_id
          }
        } else {
          let nxt = find_non_ascii_edge(
            non_ascii_bytes[cur],
            non_ascii_next[cur],
            b,
          )
          if nxt >= 0 {
            cur = nxt
          } else {
            let new_id = push_trie_state(
              trans,
              has_match,
              pat_ids,
              non_ascii_bytes,
              non_ascii_next,
            )
            non_ascii_bytes[cur].push(b)
            non_ascii_next[cur].push(new_id)
            cur = new_id
          }
        }
        j = j + 1
      }
    } else {
      let mut j = plen - 1
      while j >= 0 {
        let b = p.code_unit_at(j)
        if b < 128 {
          let idx = (cur << 7) + b
          let nxt = trans[idx]
          if nxt >= 0 {
            cur = nxt >> 7
          } else {
            let new_id = push_trie_state(
              trans,
              has_match,
              pat_ids,
              non_ascii_bytes,
              non_ascii_next,
            )
            trans[idx] = new_id << 7
            cur = new_id
          }
        } else {
          let nxt = find_non_ascii_edge(
            non_ascii_bytes[cur],
            non_ascii_next[cur],
            b,
          )
          if nxt >= 0 {
            cur = nxt
          } else {
            let new_id = push_trie_state(
              trans,
              has_match,
              pat_ids,
              non_ascii_bytes,
              non_ascii_next,
            )
            non_ascii_bytes[cur].push(b)
            non_ascii_next[cur].push(new_id)
            cur = new_id
          }
        }
        j = j - 1
      }
    }
    has_match[cur] = true
    pat_ids[cur].push(ids[i])
    i = i + 1
  }
  ByteTrie::{ trans, has_match, pat_ids, non_ascii_bytes, non_ascii_next, count: n }
}

///| Check whether any prefix in this trie matches the start of `path`.
pub fn ByteTrie::is_match_prefix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  let has_match = self.has_match
  if has_match[0] {
    return true
  }
  let trans = self.trans
  let n = path.length()
  let mut st = 0 // pre-multiplied by 128
  let mut i = 0
  while i < n {
    let b = path.code_unit_at(i)
    if b < 128 {
      st = trans[st + b]
      if st < 0 {
        return false
      }
    } else {
      let sid = st >> 7
      let nxt = find_non_ascii_edge(
        self.non_ascii_bytes[sid],
        self.non_ascii_next[sid],
        b,
      )
      if nxt < 0 {
        return false
      }
      st = nxt << 7
    }
    if has_match[st >> 7] {
      return true
    }
    i = i + 1
  }
  false
}

///| Append all matching prefix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_prefix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let has_match = self.has_match
  if has_match[0] {
    let r_ids = self.pat_ids[0]
    let mut k = 0
    while k < r_ids.length() {
      into.push(r_ids[k])
      k = k + 1
    }
  }
  let trans = self.trans
  let n = path.length()
  let mut st = 0
  let mut i = 0
  while i < n {
    let b = path.code_unit_at(i)
    if b < 128 {
      st = trans[st + b]
      if st < 0 {
        return
      }
    } else {
      let sid = st >> 7
      let nxt = find_non_ascii_edge(
        self.non_ascii_bytes[sid],
        self.non_ascii_next[sid],
        b,
      )
      if nxt < 0 {
        return
      }
      st = nxt << 7
    }
    let sid = st >> 7
    if has_match[sid] {
      let ids = self.pat_ids[sid]
      let mut k = 0
      let nids = ids.length()
      while k < nids {
        into.push(ids[k])
        k = k + 1
      }
    }
    i = i + 1
  }
}

///| Check whether any reversed suffix in this trie matches the end of `path`.
pub fn ByteTrie::is_match_suffix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  let has_match = self.has_match
  if has_match[0] {
    return true
  }
  let trans = self.trans
  let mut st = 0
  let mut i = path.length() - 1
  while i >= 0 {
    let b = path.code_unit_at(i)
    if b < 128 {
      st = trans[st + b]
      if st < 0 {
        return false
      }
    } else {
      let sid = st >> 7
      let nxt = find_non_ascii_edge(
        self.non_ascii_bytes[sid],
        self.non_ascii_next[sid],
        b,
      )
      if nxt < 0 {
        return false
      }
      st = nxt << 7
    }
    if has_match[st >> 7] {
      return true
    }
    i = i - 1
  }
  false
}

///| Append all matching suffix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_suffix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let has_match = self.has_match
  if has_match[0] {
    let r_ids = self.pat_ids[0]
    let mut k = 0
    while k < r_ids.length() {
      into.push(r_ids[k])
      k = k + 1
    }
  }
  let trans = self.trans
  let mut st = 0
  let mut i = path.length() - 1
  while i >= 0 {
    let b = path.code_unit_at(i)
    if b < 128 {
      st = trans[st + b]
      if st < 0 {
        return
      }
    } else {
      let sid = st >> 7
      let nxt = find_non_ascii_edge(
        self.non_ascii_bytes[sid],
        self.non_ascii_next[sid],
        b,
      )
      if nxt < 0 {
        return
      }
      st = nxt << 7
    }
    let sid = st >> 7
    if has_match[sid] {
      let ids = self.pat_ids[sid]
      let mut k = 0
      let nids = ids.length()
      while k < nids {
        into.push(ids[k])
        k = k + 1
      }
    }
    i = i - 1
  }
}
