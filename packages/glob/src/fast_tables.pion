///| Zero-allocation lookup structures for `GlobSet` fast strategies:
///| 1. `StrTable`: open-addressing FNV-1a hash table that looks up `s[start..end]`
///|    WITHOUT allocating a sliced `String`, with min/max length + 64-bit length bitmask
///|    + stored hash prefilters.
///| 2. `ByteTrie`: compact CSR Compressed Radix Trie (Patricia Trie) with O(1) root ASCII
///|    dispatch and flat byte pool — O(total_bytes) memory and zero allocations on lookup.

///| Compute 64-bit FNV-1a hash of `s[start..end]`.
pub fn fnv1a_slice(s : String, start : Int, end : Int) -> Int64 {
  let mut h : Int64 = -3750763034362895579L // 0xcbf29ce484222325
  let mut i = start
  while i < end {
    h = (h ^ s.code_unit_at(i).to_int64()) * 1099511628211L
    i = i + 1
  }
  h
}

///| Compare `s[start..end]` with full string `key` byte-by-byte (zero allocation).
pub fn slice_eq_str(s : String, start : Int, end : Int, key : String) -> Bool {
  let len = end - start
  if len != key.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if s.code_unit_at(start + i) != key.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Open-addressing hash table mapping `String` keys -> `Array[Int]` pattern indices,
///| supporting zero-allocation lookup by `(String, start, end)`.
pub struct StrTable {
  pub mask : Int
  pub keys : Array[String]
  pub hashes : Array[Int64]
  pub occupied : Array[Bool]
  pub values : Array[Array[Int]]
  pub lengths : Int64
  pub min_len : Int
  pub max_len : Int
  pub entry_count : Int
}

pub fn StrTable::empty() -> StrTable {
  StrTable::{
    mask: 0,
    keys: Array::new(),
    hashes: Array::new(),
    occupied: Array::new(),
    values: Array::new(),
    lengths: 0L,
    min_len: 0,
    max_len: -1,
    entry_count: 0,
  }
}

pub fn StrTable::is_empty(self : StrTable) -> Bool {
  self.entry_count == 0
}

///| Build an immutable `StrTable` from `(key, pat_id)` pairs.
pub fn build_str_table(
  raw_keys : Array[String],
  raw_ids : Array[Int],
) -> StrTable {
  let n = raw_keys.length()
  if n == 0 {
    return StrTable::empty()
  }
  let mut cap = 8
  while cap < n * 2 {
    cap = cap * 2
  }
  let mask = cap - 1
  let keys : Array[String] = Array::new()
  let hashes : Array[Int64] = Array::new()
  let occupied : Array[Bool] = Array::new()
  let values : Array[Array[Int]] = Array::new()
  let mut i = 0
  while i < cap {
    keys.push("")
    hashes.push(0L)
    occupied.push(false)
    values.push(Array::new())
    i = i + 1
  }
  let mut lengths = 0L
  let mut min_len = 2147483647
  let mut max_len = -1
  let mut entry_count = 0
  i = 0
  while i < n {
    let k = raw_keys[i]
    let klen = k.length()
    let id = raw_ids[i]
    lengths = lengths | (1L << (klen % 64))
    if klen < min_len {
      min_len = klen
    }
    if klen > max_len {
      max_len = klen
    }
    let h = fnv1a_slice(k, 0, klen)
    let mut slot = h.to_int() & mask
    while true {
      if !occupied[slot] {
        occupied[slot] = true
        keys[slot] = k
        hashes[slot] = h
        values[slot].push(id)
        entry_count = entry_count + 1
        break
      } else if hashes[slot] == h && keys[slot] == k {
        values[slot].push(id)
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrTable::{
    mask,
    keys,
    hashes,
    occupied,
    values,
    lengths,
    min_len,
    max_len,
    entry_count,
  }
}

///| Check whether `s[start..end]` exists in this table (zero allocation).
pub fn StrTable::contains_slice(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
) -> Bool {
  if self.entry_count == 0 {
    return false
  }
  let len = end - start
  if len < self.min_len ||
  len > self.max_len ||
  (self.lengths & (1L << (len % 64))) == 0L {
    return false
  }
  let h = fnv1a_slice(s, start, end)
  let mask = self.mask
  let occupied = self.occupied
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = h.to_int() & mask
  while occupied[slot] {
    if hashes[slot] == h && slice_eq_str(s, start, end, keys[slot]) {
      return true
    }
    slot = (slot + 1) & mask
  }
  false
}

///| Append all pattern IDs associated with `s[start..end]` into `into` (zero allocation).
pub fn StrTable::matches_slice_into(
  self : StrTable,
  s : String,
  start : Int,
  end : Int,
  into : Array[Int],
) -> Unit {
  if self.entry_count == 0 {
    return
  }
  let len = end - start
  if len < self.min_len ||
  len > self.max_len ||
  (self.lengths & (1L << (len % 64))) == 0L {
    return
  }
  let h = fnv1a_slice(s, start, end)
  let mask = self.mask
  let occupied = self.occupied
  let hashes = self.hashes
  let keys = self.keys
  let mut slot = h.to_int() & mask
  while occupied[slot] {
    if hashes[slot] == h && slice_eq_str(s, start, end, keys[slot]) {
      let hits = self.values[slot]
      let mut i = 0
      let nh = hits.length()
      while i < nh {
        into.push(hits[i])
        i = i + 1
      }
      return
    }
    slot = (slot + 1) & mask
  }
}

///| Compact CSR Compressed Radix Trie for prefix & reversed-suffix matching.
///| Uses flat byte pool + CSR child edges + O(1) 128-entry root ASCII table.
pub struct ByteTrie {
  pub pool : String
  pub edge_off : Array[Int]
  pub edge_len : Array[Int]
  pub child_start : Array[Int]
  pub child_count : Array[Int]
  pub child_byte : Array[Int]
  pub child_node : Array[Int]
  pub match_start : Array[Int]
  pub match_count : Array[Int]
  pub match_ids : Array[Int]
  pub root_trans : Array[Int] // length 128 when count > 0: ASCII byte -> child node (-1 if none)
  pub count : Int
}

pub fn ByteTrie::empty() -> ByteTrie {
  ByteTrie::{
    pool: "",
    edge_off: Array::new(),
    edge_len: Array::new(),
    child_start: Array::new(),
    child_count: Array::new(),
    child_byte: Array::new(),
    child_node: Array::new(),
    match_start: Array::new(),
    match_count: Array::new(),
    match_ids: Array::new(),
    root_trans: Array::new(),
    count: 0,
  }
}

pub fn ByteTrie::is_empty(self : ByteTrie) -> Bool {
  self.count == 0
}

fn pat_byte_at(p : String, plen : Int, idx : Int, reversed : Bool) -> Int {
  if reversed {
    p.code_unit_at(plen - 1 - idx)
  } else {
    p.code_unit_at(idx)
  }
}

fn find_sorted_byte(bytes : Array[Int], b : Int) -> Int {
  let mut lo = 0
  let mut hi = bytes.length() - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = bytes[mid]
    if v == b {
      return mid
    } else if v < b {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

fn insert_sorted_child(
  bytes : Array[Int],
  nodes : Array[Int],
  b : Int,
  node : Int,
) -> Unit {
  bytes.push(b)
  nodes.push(node)
  let mut i = bytes.length() - 1
  while i > 0 && bytes[i - 1] > b {
    bytes[i] = bytes[i - 1]
    nodes[i] = nodes[i - 1]
    i = i - 1
  }
  bytes[i] = b
  nodes[i] = node
}

///| Build a compressed radix prefix trie (`reversed == false`) or reversed suffix trie (`reversed == true`).
pub fn build_byte_trie(
  pats : Array[String],
  ids : Array[Int],
  reversed : Bool,
) -> ByteTrie {
  let n = pats.length()
  if n == 0 {
    return ByteTrie::empty()
  }

  let pool_bytes : Array[Int] = Array::new()
  let b_eoff : Array[Int] = [0]
  let b_elen : Array[Int] = [0]
  let b_ch_bytes : Array[Array[Int]] = [Array::new()]
  let b_ch_nodes : Array[Array[Int]] = [Array::new()]
  let b_mids : Array[Array[Int]] = [Array::new()]

  let mut pi = 0
  while pi < n {
    let p = pats[pi]
    let plen = p.length()
    let mut cur = 0
    let mut pos = 0
    while pos < plen {
      let b = pat_byte_at(p, plen, pos, reversed)
      let cidx = find_sorted_byte(b_ch_bytes[cur], b)
      if cidx < 0 {
        // Append remaining suffix of `p` to pool as a single compressed leaf edge.
        let eoff = pool_bytes.length()
        let elen = plen - pos
        let mut k = pos
        while k < plen {
          pool_bytes.push(pat_byte_at(p, plen, k, reversed))
          k = k + 1
        }
        let leaf = b_eoff.length()
        b_eoff.push(eoff)
        b_elen.push(elen)
        b_ch_bytes.push(Array::new())
        b_ch_nodes.push(Array::new())
        b_mids.push(Array::new())
        insert_sorted_child(b_ch_bytes[cur], b_ch_nodes[cur], b, leaf)
        cur = leaf
        break
      }
      let child = b_ch_nodes[cur][cidx]
      let eoff = b_eoff[child]
      let elen = b_elen[child]
      let rem = plen - pos
      let max_cmp = if rem < elen { rem } else { elen }
      let mut lcp = 1
      while lcp < max_cmp &&
      pool_bytes[eoff + lcp] == pat_byte_at(p, plen, pos + lcp, reversed) {
        lcp = lcp + 1
      }
      if lcp == elen {
        cur = child
        pos = pos + elen
      } else {
        // Split `child` at `lcp`: create intermediate `mid` node.
        let mid = b_eoff.length()
        b_eoff.push(eoff)
        b_elen.push(lcp)
        let mid_cb : Array[Int] = [pool_bytes[eoff + lcp]]
        let mid_cn : Array[Int] = [child]
        b_ch_bytes.push(mid_cb)
        b_ch_nodes.push(mid_cn)
        b_mids.push(Array::new())

        // Shorten `child`'s edge.
        b_eoff[child] = eoff + lcp
        b_elen[child] = elen - lcp
        b_ch_nodes[cur][cidx] = mid

        pos = pos + lcp
        if pos == plen {
          cur = mid
          break
        }
        let nb = pat_byte_at(p, plen, pos, reversed)
        let loff = pool_bytes.length()
        let llen = plen - pos
        let mut k = pos
        while k < plen {
          pool_bytes.push(pat_byte_at(p, plen, k, reversed))
          k = k + 1
        }
        let leaf = b_eoff.length()
        b_eoff.push(loff)
        b_elen.push(llen)
        b_ch_bytes.push(Array::new())
        b_ch_nodes.push(Array::new())
        b_mids.push(Array::new())
        insert_sorted_child(b_ch_bytes[mid], b_ch_nodes[mid], nb, leaf)
        cur = leaf
        break
      }
    }
    b_mids[cur].push(ids[pi])
    pi = pi + 1
  }

  // Flatten byte pool into a single compact String (1 byte per entry).
  let sb = StringBuilder::new()
  let mut k = 0
  let np = pool_bytes.length()
  while k < np {
    sb.write_byte(pool_bytes[k].to_byte())
    k = k + 1
  }
  let pool = sb.to_string()

  // Flatten children and match IDs into CSR arrays.
  let num_nodes = b_eoff.length()
  let child_start : Array[Int] = Array::new()
  let child_count : Array[Int] = Array::new()
  let child_byte : Array[Int] = Array::new()
  let child_node : Array[Int] = Array::new()
  let match_start : Array[Int] = Array::new()
  let match_count : Array[Int] = Array::new()
  let match_ids : Array[Int] = Array::new()

  let mut u = 0
  while u < num_nodes {
    let cb = b_ch_bytes[u]
    let cn = b_ch_nodes[u]
    child_start.push(child_byte.length())
    child_count.push(cb.length())
    let mut j = 0
    while j < cb.length() {
      child_byte.push(cb[j])
      child_node.push(cn[j])
      j = j + 1
    }
    let mids = b_mids[u]
    match_start.push(match_ids.length())
    match_count.push(mids.length())
    j = 0
    while j < mids.length() {
      match_ids.push(mids[j])
      j = j + 1
    }
    u = u + 1
  }

  // Build O(1) root ASCII transition table.
  let root_trans : Array[Int] = Array::new()
  let mut b = 0
  while b < 128 {
    root_trans.push(-1)
    b = b + 1
  }
  let rcb = b_ch_bytes[0]
  let rcn = b_ch_nodes[0]
  let mut rj = 0
  while rj < rcb.length() {
    let rb = rcb[rj]
    if rb < 128 {
      root_trans[rb] = rcn[rj]
    }
    rj = rj + 1
  }

  ByteTrie::{
    pool,
    edge_off: b_eoff,
    edge_len: b_elen,
    child_start,
    child_count,
    child_byte,
    child_node,
    match_start,
    match_count,
    match_ids,
    root_trans,
    count: n,
  }
}

fn ByteTrie::find_child(self : ByteTrie, u : Int, b : Int) -> Int {
  if u == 0 && b < 128 {
    return self.root_trans[b]
  }
  let cs = self.child_start[u]
  let cc = self.child_count[u]
  if cc == 0 {
    return -1
  }
  let cb = self.child_byte
  if cc == 1 {
    return if cb[cs] == b { self.child_node[cs] } else { -1 }
  }
  if cc <= 8 {
    let end = cs + cc
    let mut i = cs
    while i < end {
      let v = cb[i]
      if v == b {
        return self.child_node[i]
      }
      if v > b {
        return -1
      }
      i = i + 1
    }
    return -1
  }
  let mut lo = cs
  let mut hi = cs + cc - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = cb[mid]
    if v == b {
      return self.child_node[mid]
    } else if v < b {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

///| Check whether any prefix in this trie matches the start of `path`.
pub fn ByteTrie::is_match_prefix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  if self.match_count[0] > 0 {
    return true
  }
  let pool = self.pool
  let edge_off = self.edge_off
  let edge_len = self.edge_len
  let match_count = self.match_count
  let n = path.length()
  let mut cur = 0
  let mut i = 0
  while i < n {
    let nxt = self.find_child(cur, path.code_unit_at(i))
    if nxt < 0 {
      return false
    }
    let elen = edge_len[nxt]
    if i + elen > n {
      return false
    }
    let eoff = edge_off[nxt]
    let mut k = 1
    while k < elen {
      if path.code_unit_at(i + k) != pool.code_unit_at(eoff + k) {
        return false
      }
      k = k + 1
    }
    i = i + elen
    cur = nxt
    if match_count[cur] > 0 {
      return true
    }
  }
  false
}

///| Append all matching prefix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_prefix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let match_start = self.match_start
  let match_count = self.match_count
  let match_ids = self.match_ids
  let rmc = match_count[0]
  if rmc > 0 {
    let rms = match_start[0]
    let mut k = 0
    while k < rmc {
      into.push(match_ids[rms + k])
      k = k + 1
    }
  }
  let pool = self.pool
  let edge_off = self.edge_off
  let edge_len = self.edge_len
  let n = path.length()
  let mut cur = 0
  let mut i = 0
  while i < n {
    let nxt = self.find_child(cur, path.code_unit_at(i))
    if nxt < 0 {
      return
    }
    let elen = edge_len[nxt]
    if i + elen > n {
      return
    }
    let eoff = edge_off[nxt]
    let mut k = 1
    while k < elen {
      if path.code_unit_at(i + k) != pool.code_unit_at(eoff + k) {
        return
      }
      k = k + 1
    }
    i = i + elen
    cur = nxt
    let mc = match_count[cur]
    if mc > 0 {
      let ms = match_start[cur]
      let mut m = 0
      while m < mc {
        into.push(match_ids[ms + m])
        m = m + 1
      }
    }
  }
}

///| Check whether any reversed suffix in this trie matches the end of `path`.
pub fn ByteTrie::is_match_suffix(self : ByteTrie, path : String) -> Bool {
  if self.count == 0 {
    return false
  }
  if self.match_count[0] > 0 {
    return true
  }
  let pool = self.pool
  let edge_off = self.edge_off
  let edge_len = self.edge_len
  let match_count = self.match_count
  let mut cur = 0
  let mut i = path.length() - 1
  while i >= 0 {
    let nxt = self.find_child(cur, path.code_unit_at(i))
    if nxt < 0 {
      return false
    }
    let elen = edge_len[nxt]
    if i + 1 < elen {
      return false
    }
    let eoff = edge_off[nxt]
    let mut k = 1
    while k < elen {
      if path.code_unit_at(i - k) != pool.code_unit_at(eoff + k) {
        return false
      }
      k = k + 1
    }
    i = i - elen
    cur = nxt
    if match_count[cur] > 0 {
      return true
    }
  }
  false
}

///| Append all matching suffix pattern IDs for `path` into `into`.
pub fn ByteTrie::matches_suffix_into(
  self : ByteTrie,
  path : String,
  into : Array[Int],
) -> Unit {
  if self.count == 0 {
    return
  }
  let match_start = self.match_start
  let match_count = self.match_count
  let match_ids = self.match_ids
  let rmc = match_count[0]
  if rmc > 0 {
    let rms = match_start[0]
    let mut k = 0
    while k < rmc {
      into.push(match_ids[rms + k])
      k = k + 1
    }
  }
  let pool = self.pool
  let edge_off = self.edge_off
  let edge_len = self.edge_len
  let mut cur = 0
  let mut i = path.length() - 1
  while i >= 0 {
    let nxt = self.find_child(cur, path.code_unit_at(i))
    if nxt < 0 {
      return
    }
    let elen = edge_len[nxt]
    if i + 1 < elen {
      return
    }
    let eoff = edge_off[nxt]
    let mut k = 1
    while k < elen {
      if path.code_unit_at(i - k) != pool.code_unit_at(eoff + k) {
        return
      }
      k = k + 1
    }
    i = i - elen
    cur = nxt
    let mc = match_count[cur]
    if mc > 0 {
      let ms = match_start[cur]
      let mut m = 0
      while m < mc {
        into.push(match_ids[ms + m])
        m = m + 1
      }
    }
  }
}
