// --- Bare negation ---

test "gi_bare_negation" {
  check_ignored(gi_root(), ".venv\n!", "a/.venv", false)
  check_ignored(gi_root(), "*.tmp\n!", "a/x.tmp", false)
  check_ignored(gi_root(), "!\n*.tmp", "a/x.tmp", false)
  check_not_ignored(gi_root(), "!", "a/x.tmp", false)
}

// --- Trailing spaces & escaping ---

test "gi_trailing_spaces_after_escaped_space" {
  let gi = must_gi(gi_root(), "foo\\   ")
  debug_assert(gi.is_ignored("foo ", false), "foo ")
  debug_assert(!gi.is_ignored("foo", false), "!foo")
  debug_assert(!gi.is_ignored("foo  ", false), "!foo  ")
}

test "gi_trailing_unescaped_spaces" {
  let gi = must_gi(gi_root(), "foo  ")
  debug_assert(gi.is_ignored("foo", false), "foo")
  debug_assert(!gi.is_ignored("foo ", false), "!foo ")
}

test "gi_trailing_escaped_space" {
  let gi = must_gi(gi_root(), "foo\\ ")
  debug_assert(gi.is_ignored("foo ", false), "foo ")
  debug_assert(!gi.is_ignored("foo", false), "!foo")
}

// --- Special regressions & options ---

test "gi_issue_2745" {
  let gi = must_gi(gi_root(), "*[\\<\\>\\:\\\"\\/\\\\\\|\\?\\*]*")
  debug_assert(!gi.is_ignored("folder/bar.txt", false), "folder/bar.txt")
  debug_assert(!gi.is_ignored("foo.txt", false), "foo.txt")
}

test "gi_regression_106_space_only" {
  let gi = must_gi("/", " ")
  debug_assert(gi.is_empty(), "space only is empty")
}

test "gi_case_insensitive" {
  let gi = match parse_gitignore_with_options(gi_root(), "*.html", true, true) {
    Ok(g) => g
    Err(e) => {
      debug_assert(false, e.message)
      return
    }
  }
  debug_assert(gi.is_ignored("foo.html", false), "foo.html")
  debug_assert(gi.is_ignored("foo.HTML", false), "foo.HTML")
  debug_assert(!gi.is_ignored("foo.htm", false), "!foo.htm")
  debug_assert(!gi.is_ignored("foo.HTM", false), "!foo.HTM")
}

test "gi_case_sensitive_default" {
  check_ignored(gi_root(), "*.html", "foo.html", false)
  check_not_ignored(gi_root(), "*.html", "foo.HTML", false)
  check_not_ignored(gi_root(), "*.html", "foo.htm", false)
  check_not_ignored(gi_root(), "*.html", "foo.HTM", false)
}

test "gi_root_directory_issue_1764" {
  let roots = ["/home/andrew/foo", "src/foo", "./src/foo"]
  let mut i = 0
  while i < roots.length() {
    let r = roots[i]
    let gi = must_gi(r, "foo/")
    debug_assert(match_is_ignore(gi.matched(r, true)), "root dir matches foo/")
    debug_assert(match_is_none(gi.matched(r, false)), "root file misses foo/")
    debug_assert(match_is_ignore(gi.matched(r + "/foo", true)), "child foo matches")
    debug_assert(match_is_none(gi.matched_path_or_any_parents(r, true)), "parent match skips root")

    let gi2 = must_gi(r, "/foo/")
    debug_assert(match_is_none(gi2.matched(r, true)), "anchored /foo/ misses root")
    debug_assert(match_is_ignore(gi2.matched(r + "/foo", true)), "anchored /foo/ matches child")
    i = i + 1
  }
}

test "gi_empty_builder_preserves_root" {
  let gi = must_gi(gi_root(), "")
  debug_assert(gi.root() == gi_root(), "root preserved")
  debug_assert(gi.is_empty(), "is_empty")
  debug_assert(gi.len() == 0, "len 0")
  debug_assert(gi.num_ignores() == 0, "num_ignores 0")
  debug_assert(gi.num_whitelists() == 0, "num_whitelists 0")
  debug_assert(!gi.is_ignored("anything", false), "not ignored")
}

test "gi_utf8_bom_and_crlf" {
  let content = "\u{feff}before\r\n# comment\r\nafter\r\nspace\\ \r\n!keep.log\r\n"
  let gi = must_gi("", content)
  debug_assert(gi.is_ignored("before", false), "before with BOM")
  debug_assert(gi.is_ignored("after", false), "after CRLF")
  debug_assert(gi.is_ignored("space ", false), "space CRLF")
  debug_assert(match_is_whitelist(gi.matched("keep.log", false)), "whitelist CRLF")
  debug_assert(match_line(gi.matched("before", false)) == 1, "line 1")
  debug_assert(match_line(gi.matched("after", false)) == 3, "line 3")
  debug_assert(match_line(gi.matched("keep.log", false)) == 5, "line 5")
}

test "gi_unclosed_class_allowed_by_default" {
  let gi = must_gi("", "[abc\n")
  debug_assert(gi.is_ignored("[abc", false), "literal [abc")
}

test "gi_line_numbers_and_counts" {
  let content = "# header\n\n*.log\n!important.log\nbuild/\n"
  let gi = must_gi("", content)
  debug_assert(gi.len() == 3, "3 rules")
  debug_assert(gi.num_ignores() == 2, "2 ignores")
  debug_assert(gi.num_whitelists() == 1, "1 whitelist")
  let m1 = gi.matched("app.log", false)
  debug_assert(match_is_ignore(m1) && match_line(m1) == 3, "app.log line 3")
  let m2 = gi.matched("important.log", false)
  debug_assert(match_is_whitelist(m2) && match_line(m2) == 4, "important.log line 4")
  let m3 = gi.matched("build", true)
  debug_assert(match_is_ignore(m3) && match_line(m3) == 5, "build/ line 5")
}

// --- Parent directory exclusion semantics ---

test "gi_parent_dir_ignored_blocks_child_whitelist" {
  // Per gitignore(5): "It is not possible to re-include a file if a parent directory of that file is excluded."
  let gi = must_gi("", "build/\n!build/important.txt\n")
  debug_assert(gi.is_ignored_with_parents("build", true), "build dir ignored")
  debug_assert(
    gi.is_ignored_with_parents("build/important.txt", false),
    "child under ignored parent stays ignored",
  )
  debug_assert(
    gi.is_ignored_with_parents("build/sub/important.txt", false),
    "grandchild under ignored parent stays ignored",
  )
}

test "gi_parent_dir_whitelisted_allows_child_whitelist" {
  // Proper git way to re-include: ignore contents (`build/*`), not dir (`build/`), or un-ignore dir first.
  let gi = must_gi("", "build/*\n!build/important.txt\n")
  debug_assert(!gi.is_ignored_with_parents("build", true), "build dir itself not ignored")
  debug_assert(gi.is_ignored_with_parents("build/other.txt", false), "build/other.txt ignored")
  debug_assert(!gi.is_ignored_with_parents("build/important.txt", false), "build/important.txt whitelisted")
}

// --- Multi-level nested .gitignore stack priority ---

test "gi_nested_stack_deeper_overrides_shallower" {
  let root_gi = must_gi("", "*.log\nbuild/\n")
  let sub_gi = must_gi("packages/app", "!debug.log\n*.tmp\n")
  let deep_gi = must_gi("packages/app/sub", "debug.log\n")

  let stack = GitignoreStack::new()
  stack.push(root_gi)
  stack.push(sub_gi)
  stack.push(deep_gi)

  // Root rule applies outside packages/app
  debug_assert(stack.is_ignored("root.log", false), "root.log ignored")
  debug_assert(!stack.is_ignored("root.tmp", false), "root.tmp not ignored (sub rule scoped)")

  // packages/app overrides *.log for debug.log
  debug_assert(!stack.is_ignored("packages/app/debug.log", false), "packages/app/debug.log whitelisted by sub")
  debug_assert(stack.is_ignored("packages/app/other.log", false), "packages/app/other.log ignored by root")
  debug_assert(stack.is_ignored("packages/app/a.tmp", false), "packages/app/a.tmp ignored by sub")

  // packages/app/sub re-ignores debug.log
  debug_assert(stack.is_ignored("packages/app/sub/debug.log", false), "sub/debug.log re-ignored by deep")
}

test "gi_nested_stack_parent_exclusion" {
  let root_gi = must_gi("", "vendor/\n")
  let sub_gi = must_gi("vendor/pkg", "!keep.rs\n")

  let stack = GitignoreStack::new()
  stack.push(root_gi)
  stack.push(sub_gi)

  debug_assert(
    stack.is_ignored_with_parents("vendor/pkg/keep.rs", false),
    "ignored ancestor vendor/ prevents deeper .gitignore from re-including",
  )
}
