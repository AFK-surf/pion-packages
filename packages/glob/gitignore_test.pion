// --- Official ignot1 .. ignot19 ---

test "gi_ignot1" {
  check_not_ignored(gi_root(), "amonths", "months", false)
}

test "gi_ignot2" {
  check_not_ignored(gi_root(), "monthsa", "months", false)
}

test "gi_ignot3" {
