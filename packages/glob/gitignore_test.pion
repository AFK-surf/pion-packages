///| `.gitignore` compliance tests ported from BurntSushi/ignore `crates/ignore/src/gitignore.rs`
///| plus parent-directory exclusion and multi-level nested `.gitignore` stack tests.

fn gi_root() -> String {
  "/home/foobar/rust/rg"
}

fn must_gi(root : String, content : String) -> Gitignore {
  match parse_gitignore_with_root(root, content) {
    Ok(g) => g
    Err(e) => {
      debug_assert(false, "parse_gitignore failed: " + e.message)
      Gitignore::empty()
    }
  }
}

fn check_ignored(root : String, rules : String, path : String, is_dir : Bool) -> Unit {
  let gi = must_gi(root, rules)
  debug_assert(
    gi.is_ignored(path, is_dir),
    "expected ignored: path='" + path + "' rules='" + rules + "'",
  )
}

fn check_not_ignored(root : String, rules : String, path : String, is_dir : Bool) -> Unit {
  let gi = must_gi(root, rules)
  debug_assert(
    !gi.is_ignored(path, is_dir),
    "expected NOT ignored: path='" + path + "' rules='" + rules + "'",
  )
}

// --- Official ig1 .. ig44 ---

test "gi_ig1_literal" {
  check_ignored(gi_root(), "months", "months", false)
}

