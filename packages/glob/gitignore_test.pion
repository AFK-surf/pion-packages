}

test "gi_ignot4" {
  check_not_ignored(gi_root(), "/*.c", "mozilla-sha1/sha1.c", false)
}

test "gi_ignot6_whitelist_overrides_ignore" {
  let gi = must_gi(gi_root(), "*.rs\n!src/main.rs")
  let m = gi.matched("src/main.rs", false)
  debug_assert(match_is_whitelist(m), "expected Whitelist")
  debug_assert(match_line(m) == 2, "expected line 2")
  debug_assert(!gi.is_ignored("src/main.rs", false), "not ignored")
}

