///| High-speed O(log N + K) cue timeline index and playback hot-path queries.

///| Bottom-up stable merge sort of cue indices by `(cues[idx].start_ms, idx)`.
fn stable_sort_cue_indices(cues : Array[Cue], order : FixedArray[Int], n : Int) -> Unit {
  let scratch = FixedArray::make(n, 0)
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        let ai = order[i]
        let bi = order[j]
        if cues[ai].start_ms <= cues[bi].start_ms {
          scratch[k] = ai
          i = i + 1
        } else {
          scratch[k] = bi
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        scratch[k] = order[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        scratch[k] = order[j]
        j = j + 1
        k = k + 1
      }
      let mut p = left
      while p < right {
        order[p] = scratch[p]
        p = p + 1
      }
      left = left + width * 2
    }
    width = width * 2
  }
}

///| Build an augmented sorted interval index over `cues`.
///| Uses a zero-sort O(N) fast path when cues are already ordered by `start_ms`.
pub fn build_timeline_index(cues : Array[Cue]) -> TimelineIndex {
  let n = cues.length()
  if n == 0 {
    return TimelineIndex::{
      is_identity: true,
      sorted_order: FixedArray::make(0, 0),
      sorted_starts: FixedArray::make(0, 0L),
      prefix_max_end: FixedArray::make(0, 0L),
    }
  }

  let sorted_starts = FixedArray::make(n, 0L)
  let prefix_max_end = FixedArray::make(n, 0L)

  // Single-pass optimistic sorted fill
  let mut is_sorted = true
  let mut prev_start = -1L
  let mut max_end = -1L
  let mut j = 0
  while j < n {
    let c = cues[j]
    let st = c.start_ms
    if st < prev_start {
      is_sorted = false
      break
    }
    prev_start = st
    sorted_starts[j] = st
    if c.end_ms > max_end {
      max_end = c.end_ms
    }
    prefix_max_end[j] = max_end
    j = j + 1
  }

  if is_sorted {
    return TimelineIndex::{
      is_identity: true,
      sorted_order: FixedArray::make(0, 0),
      sorted_starts: sorted_starts,
      prefix_max_end: prefix_max_end,
    }
  }

  let order = FixedArray::make(n, 0)
  let mut k = 0
  while k < n {
    order[k] = k
    k = k + 1
  }
  stable_sort_cue_indices(cues, order, n)

  let mut max_end = -1L
  let mut j = 0
  while j < n {
    let c = cues[order[j]]
    sorted_starts[j] = c.start_ms
    if c.end_ms > max_end {
      max_end = c.end_ms
    }
    prefix_max_end[j] = max_end
    j = j + 1
  }

  TimelineIndex::{
    is_identity: false,
    sorted_order: order,
    sorted_starts: sorted_starts,
    prefix_max_end: prefix_max_end,
  }
}

///| Upper bound: largest index `i` in `0..n-1` such that `sorted_starts[i] <= time_ms`, or `-1`.
fn find_rightmost_start_le(starts : FixedArray[Int64], n : Int, time_ms : Int64) -> Int {
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if starts[mid] <= time_ms {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo - 1
}

///| Return indices of all cues active at `time_ms` (`start_ms <= time_ms < end_ms`) in cue order.
pub fn active_cue_indices_at(track : WebVttTrack, time_ms : Int64) -> Array[Int] {
  let n = track.cues.length()
  if n == 0 {
    return []
  }
  let tl = track.timeline
  let hi = find_rightmost_start_le(tl.sorted_starts, n, time_ms)
  if hi < 0 {
    return []
  }
  let res : Array[Int] = []
  let mut i = hi
  while i >= 0 {
    if tl.prefix_max_end[i] <= time_ms {
      break
    }
    let idx = if tl.is_identity { i } else { tl.sorted_order[i] }
    if track.cues[idx].end_ms > time_ms {
      res.push(idx)
    }
    i = i - 1
  }
  // Reverse in-place to restore ascending (start_ms, cue_index) order
  let mut l = 0
  let mut r = res.length() - 1
  while l < r {
    let tmp = res[l]
    res[l] = res[r]
    res[r] = tmp
    l = l + 1
    r = r - 1
  }
  res
}

///| Return all cues active at `time_ms` (`start_ms <= time_ms < end_ms`) in cue order.
pub fn active_cues_at(track : WebVttTrack, time_ms : Int64) -> Array[Cue] {
  let n = track.cues.length()
  if n == 0 {
    return []
  }
  let tl = track.timeline
  let hi = find_rightmost_start_le(tl.sorted_starts, n, time_ms)
  if hi < 0 {
    return []
  }
  let res : Array[Cue] = []
  let mut i = hi
  while i >= 0 {
    if tl.prefix_max_end[i] <= time_ms {
      break
    }
    let idx = if tl.is_identity { i } else { tl.sorted_order[i] }
    let c = track.cues[idx]
    if c.end_ms > time_ms {
      res.push(c)
    }
    i = i - 1
  }
  let mut l = 0
  let mut r = res.length() - 1
  while l < r {
    let tmp = res[l]
    res[l] = res[r]
    res[r] = tmp
    l = l + 1
    r = r - 1
  }
  res
}
