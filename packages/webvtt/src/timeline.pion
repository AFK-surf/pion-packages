///| High-speed O((K + 1) log N) cue timeline index (flat max-end segment tree) and playback queries.

///| HTML "text track cue order" comparator: start_ms ascending, then end_ms descending, then index ascending.
fn cue_precedes(a : Cue, b : Cue) -> Bool {
  if a.start_ms != b.start_ms {
    a.start_ms < b.start_ms
  } else {
    a.end_ms >= b.end_ms
  }
}

///| Bottom-up stable merge sort of cue indices in HTML text track cue order.
fn stable_sort_cue_indices(cues : Array[Cue], order : FixedArray[Int], n : Int) -> Unit {
  let scratch = FixedArray::make(n, 0)
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        let ai = order[i]
        let bi = order[j]
        if cue_precedes(cues[ai], cues[bi]) {
          scratch[k] = ai
          i = i + 1
        } else {
          scratch[k] = bi
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        scratch[k] = order[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        scratch[k] = order[j]
        j = j + 1
        k = k + 1
      }
      let mut p = left
      while p < right {
        order[p] = scratch[p]
        p = p + 1
      }
      left = left + width * 2
    }
    width = width * 2
  }
}

///| Smallest power of 2 >= `n` (minimum 1).
fn next_pow2(n : Int) -> Int {
  let mut s = 1
  while s < n {
    s = s << 1
  }
  s
}

///| Build an augmented flat segment-tree interval index over `cues`.
///| Uses a zero-sort O(N) fast path when cues are already in HTML text track cue order.
pub fn build_timeline_index(cues : Array[Cue]) -> TimelineIndex {
  let n = cues.length()
  if n == 0 {
    return TimelineIndex::{
      n: 0,
      seg_size: 0,
      is_identity: true,
      sorted_order: FixedArray::make(0, 0),
      sorted_starts: FixedArray::make(0, 0L),
      seg_max_end: FixedArray::make(0, 0L),
    }
  }

  let seg_size = next_pow2(n)
  let sorted_starts = FixedArray::make(n, 0L)
  let seg_max_end = FixedArray::make(seg_size * 2, -1L)

  // Single-pass optimistic fill assuming cues are already in text track cue order
  let mut is_sorted = true
  let mut prev_start = -1L
  let mut prev_end = 9223372036854775807L
  let mut j = 0
  while j < n {
    let c = cues[j]
    let st = c.start_ms
    let en = c.end_ms
    if st < prev_start || (st == prev_start && en > prev_end) {
      is_sorted = false
      break
    }
    prev_start = st
    prev_end = en
    sorted_starts[j] = st
    seg_max_end[seg_size + j] = en
    j = j + 1
  }

  let mut order = FixedArray::make(0, 0)
  if !is_sorted {
    order = FixedArray::make(n, 0)
    let mut k = 0
    while k < n {
      order[k] = k
      k = k + 1
    }
    stable_sort_cue_indices(cues, order, n)
    let mut m = 0
    while m < n {
      let c = cues[order[m]]
      sorted_starts[m] = c.start_ms
      seg_max_end[seg_size + m] = c.end_ms
      m = m + 1
    }
  }

  // Build bottom-up max-end internal nodes in O(seg_size)
  let mut p = seg_size - 1
  while p >= 1 {
    let lmax = seg_max_end[p * 2]
    let rmax = seg_max_end[p * 2 + 1]
    seg_max_end[p] = if lmax >= rmax { lmax } else { rmax }
    p = p - 1
  }

  TimelineIndex::{
    n: n,
    seg_size: seg_size,
    is_identity: is_sorted,
    sorted_order: order,
    sorted_starts: sorted_starts,
    seg_max_end: seg_max_end,
  }
}

///| Upper bound: largest index `i` in `0..n-1` such that `sorted_starts[i] <= time_ms`, or `-1`.
fn find_rightmost_start_le(starts : FixedArray[Int64], n : Int, time_ms : Int64) -> Int {
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if starts[mid] <= time_ms {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo - 1
}

///| Ensure `track.timeline` matches the current `track.cues` length (guards against external mutation).
fn ensure_timeline_fresh(track : WebVttTrack) -> TimelineIndex {
  if track.timeline.n != track.cues.length() {
    track.timeline = build_timeline_index(track.cues)
  }
  track.timeline
}

///| Recursive segment-tree range scan over `[0, hi]` with `seg_max_end <= time_ms` pruning.
///| Max recursion depth is `ceil(log2(n)) <= 30`, zero heap allocations per query, ascending HTML cue order.
fn query_seg(
  track : WebVttTrack,
  tl : TimelineIndex,
  time_ms : Int64,
  hi : Int,
  node : Int,
  nl : Int,
  nr : Int,
  res : Array[Int],
) -> Unit {
  if nl > hi || tl.seg_max_end[node] <= time_ms {
    return
  }
  if nl == nr {
    let idx = if tl.is_identity { nl } else { tl.sorted_order[nl] }
    let c = track.cues[idx]
    if c.start_ms <= time_ms && time_ms < c.end_ms {
      res.push(idx)
    }
    return
  }
  let mid = nl + (nr - nl) / 2
  let left_child = node * 2
  if tl.seg_max_end[left_child] > time_ms {
    query_seg(track, tl, time_ms, hi, left_child, nl, mid, res)
  }
  if mid + 1 <= hi && tl.seg_max_end[left_child + 1] > time_ms {
    query_seg(track, tl, time_ms, hi, left_child + 1, mid + 1, nr, res)
  }
}

///| Return indices of all cues active at `time_ms` (`start_ms <= time_ms < end_ms`) in HTML text track cue order.
pub fn active_cue_indices_at(track : WebVttTrack, time_ms : Int64) -> Array[Int] {
  let n = track.cues.length()
  if n == 0 {
    return []
  }
  let tl = ensure_timeline_fresh(track)
  let hi = find_rightmost_start_le(tl.sorted_starts, n, time_ms)
  if hi < 0 || tl.seg_max_end[1] <= time_ms {
    return []
  }
  let res : Array[Int] = []
  query_seg(track, tl, time_ms, hi, 1, 0, tl.seg_size - 1, res)
  res
}

///| Return all cues active at `time_ms` (`start_ms <= time_ms < end_ms`) in HTML text track cue order.
pub fn active_cues_at(track : WebVttTrack, time_ms : Int64) -> Array[Cue] {
  let idxs = active_cue_indices_at(track, time_ms)
  let k = idxs.length()
  let out : Array[Cue] = []
  let mut i = 0
  while i < k {
    out.push(track.cues[idxs[i]])
    i = i + 1
  }
  out
}
