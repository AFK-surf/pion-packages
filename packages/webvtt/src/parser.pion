///| W3C WebVTT document, timestamp, region, style, note, and cue parser.

///| Parse a WebVTT timestamp (`MM:SS.mmm` or `HH:MM:SS.mmm`) into exact milliseconds (`Int64`).
pub fn parse_timestamp(s : String) -> Result[Int64, WebVttError] {
  let _ = s
  Err(WebVttError::Unimplemented("parse_timestamp"))
}

///| Format exact milliseconds (`Int64`) as a canonical WebVTT timestamp (`HH:MM:SS.mmm`).
pub fn format_timestamp(ms : Int64) -> String {
  let _ = ms
  ""
}

///| Parse a WebVTT document with default `ParseLimits` (strict on header and timing lines).
pub fn parse(input : String) -> Result[WebVttTrack, WebVttError] {
  parse_with_limits(input, ParseLimits::default())
}

///| Parse a WebVTT document with custom `ParseLimits` (strict on header and timing lines).
pub fn parse_with_limits(
  input : String,
  limits : ParseLimits,
) -> Result[WebVttTrack, WebVttError] {
  let _ = input
  let _ = limits
  Err(WebVttError::Unimplemented("parse_with_limits"))
}

///| Parse a WebVTT document in browser-lenient mode (skips malformed or inverted cue blocks).
pub fn parse_lenient(
  input : String,
  limits : ParseLimits,
) -> Result[WebVttTrack, WebVttError] {
  let _ = input
  let _ = limits
  Err(WebVttError::Unimplemented("parse_lenient"))
}
