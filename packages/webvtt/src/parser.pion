///| W3C WebVTT document, timestamp, region, style, note, and cue parser.

///| Check whether byte `b` is ASCII space (`0x20`) or tab (`0x09`).
fn is_ws(b : Int) -> Bool {
  b == 32 || b == 9
}

///| Check whether byte `b` is ASCII digit `'0'..'9'`.
fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///| Compare `s[start..end]` with an exact ASCII literal `lit`.
fn slice_eq(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check if `s[start..end]` starts with ASCII prefix `lit`.
fn slice_starts_with(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start < n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Find index of `"-->"` inside `s[start..end]`, or `-1` if absent (stride-3 skip scan).
fn find_arrow(s : String, start : Int, end : Int) -> Int {
  let limit = end - 2
  let mut i = start
  while i < limit {
    let b2 = s.code_unit_at(i + 2)
    if b2 == 62 {
      if s.code_unit_at(i) == 45 && s.code_unit_at(i + 1) == 45 {
        return i
      }
      i = i + 3
    } else if b2 == 45 {
      i = i + 1
    } else {
      i = i + 3
    }
  }
  -1
}

///| Find first occurrence of byte `needle` in `s[start..end]`, or `-1`.
fn find_byte(s : String, start : Int, end : Int, needle : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == needle {
      return i
    }
    i = i + 1
  }
  -1
}

///| Trim leading and trailing ASCII space/tab from `[start, end)`.
fn trim_ws_bounds(s : String, start : Int, end : Int) -> (Int, Int) {
  let mut a = start
  let mut b = end
  while a < b && is_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  while b > a && is_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  (a, b)
}

///| Find end-of-line offset starting at `pos` (stops at `\n`, `\r`, or `n`).
fn find_line_end(s : String, pos : Int, n : Int) -> Int {
  let mut i = pos
  while i < n {
    let b = s.code_unit_at(i)
    if b == 10 || b == 13 {
      return i
    }
    i = i + 1
  }
  n
}

///| Advance past the line terminator at `line_end` (`\r\n`, `\r`, or `\n`).
fn skip_eol(s : String, line_end : Int, n : Int) -> Int {
  if line_end >= n {
    return n
  }
  if s.code_unit_at(line_end) == 13 &&
  line_end + 1 < n &&
  s.code_unit_at(line_end + 1) == 10 {
    return line_end + 2
  }
  line_end + 1
}

///| Parse a non-negative integer from `s[start..end]` with overflow check.
fn parse_uint_slice(s : String, start : Int, end : Int) -> Option[Int] {
  if start >= end {
    return None
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if !is_digit(b) {
      return None
    }
    if acc > 214748364 {
      return None
    }
    let d = b - 48
    if acc == 214748364 && d > 7 {
      return None
    }
    acc = acc * 10 + d
    i = i + 1
  }
  Some(acc)
}

///| Parse a finite decimal number (optional leading `-`, digits, optional `.digits`) from `s[start..end]`.
fn parse_decimal_slice(s : String, start : Int, end : Int, allow_neg : Bool) -> Option[Double] {
  if start >= end {
    return None
  }
  let mut i = start
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    if !allow_neg {
      return None
    }
    neg = true
    i = i + 1
  }
  if i >= end {
    return None
  }
  let mut int_digits = 0
  let mut int_part = 0.0
  while i < end {
    let b = s.code_unit_at(i)
    if is_digit(b) {
      int_part = int_part * 10.0 + (b - 48).to_double()
      int_digits = int_digits + 1
      i = i + 1
    } else {
      break
    }
  }
  if int_digits == 0 {
    return None
  }
  let mut frac_part = 0.0
  if i < end {
    if s.code_unit_at(i) != 46 {
      return None
    }
    i = i + 1
    let mut frac_digits = 0
    let mut scale = 0.1
    while i < end {
      let b = s.code_unit_at(i)
      if is_digit(b) {
        frac_part = frac_part + (b - 48).to_double() * scale
        scale = scale * 0.1
        frac_digits = frac_digits + 1
        i = i + 1
      } else {
        return None
      }
    }
    if frac_digits == 0 {
      return None
    }
  }
  let num = int_part + frac_part
  Some(if neg { 0.0 - num } else { num })
}

///| Parse a percentage `0.0..100.0` ending with `%` from `s[start..end]`.
fn parse_percentage_slice(s : String, start : Int, end : Int) -> Option[Double] {
  if end - start < 2 || s.code_unit_at(end - 1) != 37 {
    return None
  }
  match parse_decimal_slice(s, start, end - 1, false) {
    Some(v) => if v >= 0.0 && v <= 100.0 { Some(v) } else { None }
    None => None
  }
}

///| Fast zero-allocation timestamp parser returning milliseconds `>= 0L`, or `-1L` on invalid syntax/overflow.
fn parse_timestamp_raw(s : String, start : Int, end : Int) -> Int64 {
  let len = end - start
  if len < 9 {
    return -1L
  }
  // Fast path for the two dominant exact lengths: MM:SS.mmm (9) and HH:MM:SS.mmm (12)
  if len == 9 {
    let c2 = s.code_unit_at(start + 2)
    let c5 = s.code_unit_at(start + 5)
    if c2 == 58 && c5 == 46 {
      let d0 = s.code_unit_at(start) - 48
      let d1 = s.code_unit_at(start + 1) - 48
      let d3 = s.code_unit_at(start + 3) - 48
      let d4 = s.code_unit_at(start + 4) - 48
      let d6 = s.code_unit_at(start + 6) - 48
      let d7 = s.code_unit_at(start + 7) - 48
      let d8 = s.code_unit_at(start + 8) - 48
      if d0 >= 0 && d0 <= 9 && d1 >= 0 && d1 <= 9 &&
      d3 >= 0 && d3 <= 9 && d4 >= 0 && d4 <= 9 &&
      d6 >= 0 && d6 <= 9 && d7 >= 0 && d7 <= 9 && d8 >= 0 && d8 <= 9 {
        let mins = d0 * 10 + d1
        let secs = d3 * 10 + d4
        if mins < 60 && secs < 60 {
          let millis = d6 * 100 + d7 * 10 + d8
          return (mins * 60000 + secs * 1000 + millis).to_int64()
        }
      }
    }
    return -1L
  }
  if len == 12 {
    let c2 = s.code_unit_at(start + 2)
    let c5 = s.code_unit_at(start + 5)
    let c8 = s.code_unit_at(start + 8)
    if c2 == 58 && c5 == 58 && c8 == 46 {
      let h0 = s.code_unit_at(start) - 48
      let h1 = s.code_unit_at(start + 1) - 48
      let m0 = s.code_unit_at(start + 3) - 48
      let m1 = s.code_unit_at(start + 4) - 48
      let s0 = s.code_unit_at(start + 6) - 48
      let s1 = s.code_unit_at(start + 7) - 48
      let f0 = s.code_unit_at(start + 9) - 48
      let f1 = s.code_unit_at(start + 10) - 48
      let f2 = s.code_unit_at(start + 11) - 48
      if h0 >= 0 && h0 <= 9 && h1 >= 0 && h1 <= 9 &&
      m0 >= 0 && m0 <= 9 && m1 >= 0 && m1 <= 9 &&
      s0 >= 0 && s0 <= 9 && s1 >= 0 && s1 <= 9 &&
      f0 >= 0 && f0 <= 9 && f1 >= 0 && f1 <= 9 && f2 >= 0 && f2 <= 9 {
        let hours = h0 * 10 + h1
        let mins = m0 * 10 + m1
        let secs = s0 * 10 + s1
        if mins < 60 && secs < 60 {
          let millis = f0 * 100 + f1 * 10 + f2
          return hours.to_int64() * 3600000L + (mins * 60000 + secs * 1000 + millis).to_int64()
        }
      }
    }
    return -1L
  }

  // General path for arbitrary-length hours (HH+:MM:SS.mmm)
  let mut i = start
  let mut first : Int64 = 0L
  let mut first_digits = 0
  while i < end {
    let b = s.code_unit_at(i)
    if is_digit(b) {
      if first > 250000000000L {
        return -1L
      }
      first = first * 10L + (b - 48).to_int64()
      first_digits = first_digits + 1
      i = i + 1
    } else {
      break
    }
  }
  if first_digits < 2 || i >= end || s.code_unit_at(i) != 58 {
    return -1L
  }
  i = i + 1
  if i + 9 != end {
    return -1L
  }
  let m1 = s.code_unit_at(i) - 48
  let m2 = s.code_unit_at(i + 1) - 48
  if m1 < 0 || m1 > 9 || m2 < 0 || m2 > 9 || s.code_unit_at(i + 2) != 58 {
    return -1L
  }
  let s1 = s.code_unit_at(i + 3) - 48
  let s2 = s.code_unit_at(i + 4) - 48
  if s1 < 0 || s1 > 9 || s2 < 0 || s2 > 9 || s.code_unit_at(i + 5) != 46 {
    return -1L
  }
  let f1 = s.code_unit_at(i + 6) - 48
  let f2 = s.code_unit_at(i + 7) - 48
  let f3 = s.code_unit_at(i + 8) - 48
  if f1 < 0 || f1 > 9 || f2 < 0 || f2 > 9 || f3 < 0 || f3 > 9 {
    return -1L
  }
  let mins = m1 * 10 + m2
  let secs = s1 * 10 + s2
  if mins >= 60 || secs >= 60 {
    return -1L
  }
  let millis = f1 * 100 + f2 * 10 + f3
  first * 3600000L + (mins * 60000 + secs * 1000 + millis).to_int64()
}

///| Parse a WebVTT timestamp directly from byte slice `s[start..end]` with zero allocations.
pub fn parse_timestamp_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[Int64, WebVttError] {
  let ms = parse_timestamp_raw(s, start, end)
  if ms < 0L {
    Err(WebVttError::InvalidTimestamp("invalid WebVTT timestamp"))
  } else {
    Ok(ms)
  }
}

///| Parse a WebVTT timestamp (`MM:SS.mmm` or `HH:MM:SS.mmm`) into exact milliseconds (`Int64`).
pub fn parse_timestamp(s : String) -> Result[Int64, WebVttError] {
  parse_timestamp_slice(s, 0, s.length())
}

///| Write a 2-digit zero-padded integer (`0..99`) to `sb`.
fn write_2d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///| Write a 3-digit zero-padded integer (`0..999`) to `sb`.
fn write_3d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 100).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///| Format exact milliseconds (`Int64`) as a canonical WebVTT timestamp (`HH:MM:SS.mmm`).
pub fn format_timestamp(ms : Int64) -> String {
  let clamped = if ms < 0L { 0L } else { ms }
  let hours = clamped / 3600000L
  let rem1 = clamped % 3600000L
  let mins = (rem1 / 60000L).to_int()
  let rem2 = rem1 % 60000L
  let secs = (rem2 / 1000L).to_int()
  let millis = (rem2 % 1000L).to_int()
  let sb = StringBuilder::with_capacity(16)
  if hours < 10L {
    sb.write_byte((48).to_byte())
    sb.write_byte((48 + hours.to_int()).to_byte())
  } else {
    sb.write_string(hours.to_string())
  }
  sb.write_byte((58).to_byte())
  write_2d(sb, mins)
  sb.write_byte((58).to_byte())
  write_2d(sb, secs)
  sb.write_byte((46).to_byte())
  write_3d(sb, millis)
  sb.to_string()
}

///| Parse cue settings directly from `s[start..end]` with first-byte dispatch and zero extra allocations.
fn parse_cue_settings_slice(s : String, start : Int, end : Int) -> CueSettings {
  let mut vertical = VerticalDirection::Horizontal
  let mut line = LineSetting::Auto
  let mut line_align = LineAlign::Auto
  let mut position = PositionSetting::Auto
  let mut position_align = PositionAlign::Auto
  let mut size = 100.0
  let mut align = TextAlign::Center
  let mut region = ""

  let mut i = start
  while i < end {
    while i < end && is_ws(s.code_unit_at(i)) {
      i = i + 1
    }
    if i >= end {
      break
    }
    let tok_start = i
    let mut colon = -1
    while i < end {
      let b = s.code_unit_at(i)
      if b == 32 || b == 9 {
        break
      }
      if b == 58 && colon < 0 {
        colon = i
      }
      i = i + 1
    }
    let tok_end = i
    if colon <= tok_start || colon + 1 >= tok_end {
      continue
    }
    let ks = tok_start
    let ke = colon
    let klen = ke - ks
    let kb0 = s.code_unit_at(ks)
    let vs = colon + 1
    let ve = tok_end

    if kb0 == 97 && klen == 5 && slice_eq(s, ks, ke, "align") {
      let vb0 = s.code_unit_at(vs)
      if vb0 == 99 && slice_eq(s, vs, ve, "center") {
        align = TextAlign::Center
      } else if vb0 == 115 && slice_eq(s, vs, ve, "start") {
        align = TextAlign::Start
      } else if vb0 == 101 && slice_eq(s, vs, ve, "end") {
        align = TextAlign::End
      } else if vb0 == 108 && slice_eq(s, vs, ve, "left") {
        align = TextAlign::Left
      } else if vb0 == 114 && slice_eq(s, vs, ve, "right") {
        align = TextAlign::Right
      } else if vb0 == 109 && slice_eq(s, vs, ve, "middle") {
        align = TextAlign::Center
      }
    } else if kb0 == 108 && klen == 4 && slice_eq(s, ks, ke, "line") {
      let comma = find_byte(s, vs, ve, 44)
      let num_end = if comma >= 0 { comma } else { ve }
      let mut parsed_align = LineAlign::Auto
      let mut align_ok = true
      if comma >= 0 {
        let as_ = comma + 1
        if slice_eq(s, as_, ve, "start") {
          parsed_align = LineAlign::Start
        } else if slice_eq(s, as_, ve, "center") {
          parsed_align = LineAlign::Center
        } else if slice_eq(s, as_, ve, "end") {
          parsed_align = LineAlign::End
        } else {
          align_ok = false
        }
      }
      if align_ok {
        if num_end > vs && s.code_unit_at(num_end - 1) == 37 {
          match parse_percentage_slice(s, vs, num_end) {
            Some(p) => {
              line = LineSetting::Percentage(p)
              line_align = parsed_align
            }
            None => ()
          }
        } else {
          match parse_decimal_slice(s, vs, num_end, true) {
            Some(num) => {
              line = LineSetting::LineNumber(num)
              line_align = parsed_align
            }
            None => ()
          }
        }
      }
    } else if kb0 == 112 && klen == 8 && slice_eq(s, ks, ke, "position") {
      let comma = find_byte(s, vs, ve, 44)
      let num_end = if comma >= 0 { comma } else { ve }
      let mut parsed_align = PositionAlign::Auto
      let mut align_ok = true
      if comma >= 0 {
        let as_ = comma + 1
        if slice_eq(s, as_, ve, "line-left") {
          parsed_align = PositionAlign::LineLeft
        } else if slice_eq(s, as_, ve, "center") {
          parsed_align = PositionAlign::Center
        } else if slice_eq(s, as_, ve, "line-right") {
          parsed_align = PositionAlign::LineRight
        } else {
          align_ok = false
        }
      }
      if align_ok {
        match parse_percentage_slice(s, vs, num_end) {
          Some(p) => {
            position = PositionSetting::Percentage(p)
            position_align = parsed_align
          }
          None => ()
        }
      }
    } else if kb0 == 115 && klen == 4 && slice_eq(s, ks, ke, "size") {
      match parse_percentage_slice(s, vs, ve) {
        Some(p) => size = p
        None => ()
      }
    } else if kb0 == 114 && klen == 6 && slice_eq(s, ks, ke, "region") {
      region = s.slice(vs, ve)
    } else if kb0 == 118 && klen == 8 && slice_eq(s, ks, ke, "vertical") {
      if ve - vs == 2 && s.code_unit_at(vs + 1) == 108 {
        if s.code_unit_at(vs) == 114 {
          vertical = VerticalDirection::RightToLeft
        }
      } else if ve - vs == 2 && s.code_unit_at(vs) == 108 && s.code_unit_at(vs + 1) == 114 {
        vertical = VerticalDirection::LeftToRight
      }
    }
  }

  CueSettings::{
    vertical: vertical,
    line: line,
    line_align: line_align,
    position: position,
    position_align: position_align,
    size: size,
    align: align,
    region: region,
  }
}

///| Parse an `Anchor` (`x%,y%`) from `s[start..end]`.
fn parse_anchor_slice(s : String, start : Int, end : Int) -> Option[Anchor] {
  let comma = find_byte(s, start, end, 44)
  if comma < 0 {
    return None
  }
  match parse_percentage_slice(s, start, comma) {
    Some(x) =>
    match parse_percentage_slice(s, comma + 1, end) {
      Some(y) => Some(Anchor::{ x: x, y: y })
      None => None
    }
    None => None
  }
}

///| Normalize a multi-line slice `[start, end)` to LF-only (zero-copy when `!had_cr`).
fn extract_normalized(s : String, start : Int, end : Int, had_cr : Bool) -> String {
  if start >= end {
    return ""
  }
  if !had_cr {
    return s.slice(start, end)
  }
  let sb = StringBuilder::with_capacity(end - start)
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 13 {
      sb.write_byte((10).to_byte())
      if i + 1 < end && s.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

///| Core internal WebVTT parser supporting both strict and browser-lenient modes.
fn parse_internal(
  input : String,
  limits : ParseLimits,
  strict : Bool,
) -> Result[WebVttTrack, WebVttError] {
  let n = input.length()
  if n > limits.max_input_bytes {
    return Err(
      WebVttError::LimitExceeded(
        "input size " + n.to_string() + " exceeds max_input_bytes " + limits.max_input_bytes.to_string(),
      ),
    )
  }

  // 1. Optional UTF-8 BOM
  let mut pos = 0
  if n >= 3 &&
  input.code_unit_at(0) == 0xEF &&
  input.code_unit_at(1) == 0xBB &&
  input.code_unit_at(2) == 0xBF {
    pos = 3
  }

  // 2. WEBVTT signature line
  if pos >= n {
    return Err(WebVttError::InvalidHeader("empty WebVTT input"))
  }
  let sig_end = find_line_end(input, pos, n)
  let after_sig = skip_eol(input, sig_end, n)
  let sig_len = sig_end - pos
  if sig_len < 6 || !slice_starts_with(input, pos, sig_end, "WEBVTT") {
    return Err(WebVttError::InvalidHeader("missing WEBVTT signature"))
  }
  let mut header_title = ""
  if sig_len > 6 {
    let b6 = input.code_unit_at(pos + 6)
    if !is_ws(b6) {
      return Err(WebVttError::InvalidHeader("WEBVTT signature must be followed by space, tab, or newline"))
    }
    let (ta, tb) = trim_ws_bounds(input, pos + 7, sig_end)
    if ta < tb {
      header_title = input.slice(ta, tb)
    }
  }
  pos = after_sig

  // 3. Optional header metadata lines until first blank line (or a line with '-->')
  let header_metadata : Array[HeaderMeta] = []
  while pos < n {
    let line_start = pos
    let line_end = find_line_end(input, pos, n)
    let next_pos = skip_eol(input, line_end, n)
    if line_start == line_end {
      pos = next_pos
      break
    }
    if find_arrow(input, line_start, line_end) >= 0 {
      break
    }
    let colon = find_byte(input, line_start, line_end, 58)
    if colon > line_start {
      let (ka, kb) = trim_ws_bounds(input, line_start, colon)
      let (va, vb) = trim_ws_bounds(input, colon + 1, line_end)
      if ka < kb {
        header_metadata.push(
          HeaderMeta::{ key: input.slice(ka, kb), value: input.slice(va, vb) },
        )
      }
    }
    pos = next_pos
  }

  // 4. Parse blocks (NOTE, STYLE, REGION, Cue)
  let styles : Array[String] = []
  let regions : Array[Region] = []
  let notes : Array[String] = []
  let cues : Array[Cue] = []

  while pos < n {
    let line_start = pos
    let line_end = find_line_end(input, pos, n)
    let next_pos = skip_eol(input, line_end, n)
    if line_start == line_end {
      pos = next_pos
      continue
    }

    let first_b = input.code_unit_at(line_start)

    // Fast first-byte guard: only check NOTE/STYLE/REGION if line starts with 'N', 'S', or 'R'
    if first_b == 78 {
      let is_note = slice_eq(input, line_start, line_end, "NOTE") ||
      (line_end - line_start > 4 &&
        slice_starts_with(input, line_start, line_end, "NOTE") &&
        is_ws(input.code_unit_at(line_start + 4)))
      if is_note {
        if notes.length() >= limits.max_notes {
          return Err(WebVttError::LimitExceeded("note count exceeds max_notes"))
        }
        let mut note_start = line_start + 4
        while note_start < line_end && is_ws(input.code_unit_at(note_start)) {
          note_start = note_start + 1
        }
        let has_inline = note_start < line_end
        let mut block_start = note_start
        let mut block_end = line_end
        let mut block_cr = false
        let mut cur = next_pos
        let mut extra_lines = 0
        while cur < n {
          let ls = cur
          let le = find_line_end(input, cur, n)
          let np = skip_eol(input, le, n)
          if ls == le {
            cur = np
            break
          }
          if !has_inline && extra_lines == 0 {
            block_start = ls
          } else if block_end < n && input.code_unit_at(block_end) == 13 {
            block_cr = true
          }
          block_end = le
          extra_lines = extra_lines + 1
          cur = np
        }
        if !has_inline && extra_lines == 0 {
          notes.push("")
        } else {
          notes.push(extract_normalized(input, block_start, block_end, block_cr))
        }
        pos = cur
        continue
      }
    } else if first_b == 83 {
      let mut tb0 = line_end
      while tb0 > line_start && is_ws(input.code_unit_at(tb0 - 1)) {
        tb0 = tb0 - 1
      }
      if slice_eq(input, line_start, tb0, "STYLE") {
        let mut cur = next_pos
        let mut body_start = -1
        let mut body_end = -1
        let mut body_cr = false
        let mut aborted = false
        while cur < n {
          let ls = cur
          let le = find_line_end(input, cur, n)
          let np = skip_eol(input, le, n)
          if ls == le {
            cur = np
            break
          }
          if find_arrow(input, ls, le) >= 0 {
            aborted = true
          }
          if body_start < 0 {
            body_start = ls
          } else if body_end >= 0 && input.code_unit_at(body_end) == 13 {
            body_cr = true
          }
          body_end = le
          cur = np
        }
        if !aborted && cues.length() == 0 && body_start >= 0 {
          if styles.length() >= limits.max_styles {
            return Err(WebVttError::LimitExceeded("style count exceeds max_styles"))
          }
          styles.push(extract_normalized(input, body_start, body_end, body_cr))
        }
        pos = cur
        continue
      }
    } else if first_b == 82 {
      let mut tb0 = line_end
      while tb0 > line_start && is_ws(input.code_unit_at(tb0 - 1)) {
        tb0 = tb0 - 1
      }
      if slice_eq(input, line_start, tb0, "REGION") {
        let mut cur = next_pos
        let mut aborted = false
        let mut r_id = ""
        let mut r_width = 100.0
        let mut r_lines = 3
        let mut r_anchor = Anchor::{ x: 0.0, y: 100.0 }
        let mut v_anchor = Anchor::{ x: 0.0, y: 100.0 }
        let mut r_scroll = RegionScroll::None

        while cur < n {
          let ls = cur
          let le = find_line_end(input, cur, n)
          let np = skip_eol(input, le, n)
          if ls == le {
            cur = np
            break
          }
          if find_arrow(input, ls, le) >= 0 {
            aborted = true
          }
          if !aborted && cues.length() == 0 {
            let mut ti = ls
            while ti < le {
              while ti < le && is_ws(input.code_unit_at(ti)) {
                ti = ti + 1
              }
              if ti >= le {
                break
              }
              let ts = ti
              while ti < le && !is_ws(input.code_unit_at(ti)) {
                ti = ti + 1
              }
              let te = ti
              let colon = find_byte(input, ts, te, 58)
              if colon <= ts || colon + 1 >= te {
                continue
              }
              let vs = colon + 1
              if slice_eq(input, ts, colon, "id") {
                r_id = input.slice(vs, te)
              } else if slice_eq(input, ts, colon, "width") {
                match parse_percentage_slice(input, vs, te) {
                  Some(p) => r_width = p
                  None => ()
                }
              } else if slice_eq(input, ts, colon, "lines") {
                match parse_uint_slice(input, vs, te) {
                  Some(v) => r_lines = v
                  None => ()
                }
              } else if slice_eq(input, ts, colon, "regionanchor") {
                match parse_anchor_slice(input, vs, te) {
                  Some(a) => r_anchor = a
                  None => ()
                }
              } else if slice_eq(input, ts, colon, "viewportanchor") {
                match parse_anchor_slice(input, vs, te) {
                  Some(a) => v_anchor = a
                  None => ()
                }
              } else if slice_eq(input, ts, colon, "scroll") {
                if slice_eq(input, vs, te, "up") {
                  r_scroll = RegionScroll::Up
                }
              }
            }
          }
          cur = np
        }

        if !aborted && cues.length() == 0 && r_id.length() > 0 {
          let reg = Region::{
            id: r_id,
            width: r_width,
            lines: r_lines,
            region_anchor: r_anchor,
            viewport_anchor: v_anchor,
            scroll: r_scroll,
          }
          let mut replaced = false
          let mut ri = 0
          while ri < regions.length() {
            if regions[ri].id == r_id {
              regions[ri] = reg
              replaced = true
              break
            }
            ri = ri + 1
          }
          if !replaced {
            if regions.length() >= limits.max_regions {
              return Err(WebVttError::LimitExceeded("region count exceeds max_regions"))
            }
            regions.push(reg)
          }
        }
        pos = cur
        continue
      }
    }

    // Cue block: either first line has '-->', or first line is cue id and second line has '-->'
    let mut cue_id = ""
    let mut timing_start = line_start
    let mut timing_end = line_end
    let mut cur = next_pos
    let mut arrow = find_arrow(input, line_start, line_end)

    if arrow < 0 {
      if cur >= n {
        pos = cur
        continue
      }
      let ls2 = cur
      let le2 = find_line_end(input, cur, n)
      let np2 = skip_eol(input, le2, n)
      if ls2 == le2 {
        pos = np2
        continue
      }
      let arrow2 = find_arrow(input, ls2, le2)
      if arrow2 < 0 {
        cur = np2
        while cur < n {
          let ls = cur
          let le = find_line_end(input, cur, n)
          cur = skip_eol(input, le, n)
          if ls == le {
            break
          }
        }
        pos = cur
        continue
      }
      cue_id = input.slice(line_start, line_end)
      timing_start = ls2
      timing_end = le2
      arrow = arrow2
      cur = np2
    }

    // Parse start timestamp before '-->'
    let mut ls_a = timing_start
    let mut ls_b = arrow
    while ls_a < ls_b && is_ws(input.code_unit_at(ls_a)) {
      ls_a = ls_a + 1
    }
    while ls_b > ls_a && is_ws(input.code_unit_at(ls_b - 1)) {
      ls_b = ls_b - 1
    }
    let start_ms = parse_timestamp_raw(input, ls_a, ls_b)

    // Parse end timestamp after '-->'
    let mut rs_a = arrow + 3
    while rs_a < timing_end && is_ws(input.code_unit_at(rs_a)) {
      rs_a = rs_a + 1
    }
    let mut rs_b = rs_a
    while rs_b < timing_end && !is_ws(input.code_unit_at(rs_b)) {
      rs_b = rs_b + 1
    }
    let end_ms = parse_timestamp_raw(input, rs_a, rs_b)

    if start_ms < 0L || end_ms < 0L || end_ms < start_ms {
      if strict {
        if start_ms >= 0L && end_ms >= 0L {
          return Err(
            WebVttError::InvalidTimestamp("cue end timestamp precedes start timestamp"),
          )
        }
        return Err(WebVttError::InvalidTimestamp("invalid cue timing line"))
      }
      while cur < n {
        let ls = cur
        let le = find_line_end(input, cur, n)
        cur = skip_eol(input, le, n)
        if ls == le {
          break
        }
      }
      pos = cur
      continue
    }

    let settings = if rs_b < timing_end {
      parse_cue_settings_slice(input, rs_b, timing_end)
    } else {
      CueSettings::default()
    }

    // Collect cue payload lines until blank line, EOF, or a line containing '-->' (W3C §6.1)
    let mut payload_start = -1
    let mut payload_end = -1
    let mut payload_cr = false
    let mut line_count = 0
    while cur < n {
      let ls = cur
      let le = find_line_end(input, cur, n)
      let np = skip_eol(input, le, n)
      if ls == le {
        cur = np
        break
      }
      if find_arrow(input, ls, le) >= 0 {
        break
      }
      if line_count == 0 {
        payload_start = ls
      } else if payload_end >= 0 && input.code_unit_at(payload_end) == 13 {
        payload_cr = true
      }
      payload_end = le
      line_count = line_count + 1
      cur = np
    }

    if cues.length() >= limits.max_cues {
      return Err(WebVttError::LimitExceeded("cue count exceeds max_cues"))
    }
    let payload = if line_count == 0 {
      ""
    } else {
      extract_normalized(input, payload_start, payload_end, payload_cr)
    }
    cues.push(
      Cue::{
        id: cue_id,
        start_ms: start_ms,
        end_ms: end_ms,
        settings: settings,
        payload: payload,
      },
    )
    pos = cur
  }

  let timeline = build_timeline_index(cues)
  Ok(
    WebVttTrack::{
      header_title: header_title,
      header_metadata: header_metadata,
      styles: styles,
      regions: regions,
      notes: notes,
      cues: cues,
      timeline: timeline,
    },
  )
}

///| Parse a WebVTT document with default `ParseLimits` (strict on header and timing lines).
pub fn parse(input : String) -> Result[WebVttTrack, WebVttError] {
  parse_internal(input, ParseLimits::default(), true)
}

///| Parse a WebVTT document with custom `ParseLimits` (strict on header and timing lines).
pub fn parse_with_limits(
  input : String,
  limits : ParseLimits,
) -> Result[WebVttTrack, WebVttError] {
  parse_internal(input, limits, true)
}

///| Parse a WebVTT document in browser-lenient mode (skips malformed or inverted cue blocks).
pub fn parse_lenient(
  input : String,
  limits : ParseLimits,
) -> Result[WebVttTrack, WebVttError] {
  parse_internal(input, limits, false)
}
