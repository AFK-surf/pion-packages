///| W3C WebVTT cue payload rich-text tag parser, full WHATWG HTML5 entity decoder, and fast plain-text extractor.

///| Append a Unicode scalar value `cp` as UTF-8 bytes into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0x10FFFF {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xEF).to_byte())
    sb.write_byte((0xBF).to_byte())
    sb.write_byte((0xBD).to_byte())
  }
}

///| WHATWG HTML5 Windows-1252 replacement table for numeric character references `0x80..0x9F`.
fn win1252_remap(cp : Int) -> Int {
  match cp {
    0x80 => 0x20AC
    0x82 => 0x201A
    0x83 => 0x0192
    0x84 => 0x201E
    0x85 => 0x2026
    0x86 => 0x2020
    0x87 => 0x2021
    0x88 => 0x02C6
    0x89 => 0x2030
    0x8A => 0x0160
    0x8B => 0x2039
    0x8C => 0x0152
    0x8E => 0x017D
    0x91 => 0x2018
    0x92 => 0x2019
    0x93 => 0x201C
    0x94 => 0x201D
    0x95 => 0x2022
    0x96 => 0x2013
    0x97 => 0x2014
    0x98 => 0x02DC
    0x99 => 0x2122
    0x9A => 0x0161
    0x9B => 0x203A
    0x9C => 0x0153
    0x9E => 0x017E
    0x9F => 0x0178
    _ => cp
  }
}

///| Sanitize a numeric character reference codepoint per WHATWG §13.2.5.80.
fn sanitize_numeric_cp(cp : Int) -> Int {
  if cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else if cp >= 0x80 && cp <= 0x9F {
    win1252_remap(cp)
  } else {
    cp
  }
}

///| Check if byte is ASCII letter (`A-Z`, `a-z`).
fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
}

///| Check if byte is ASCII alphanumeric (`0-9`, `A-Z`, `a-z`).
fn is_ascii_alnum(b : Int) -> Bool {
  (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
}

///| Decode a WHATWG HTML5 character reference starting at `&` (`pos`) into `sb`, returning next byte offset.
fn decode_entity_into(s : String, pos : Int, n : Int, sb : StringBuilder) -> Int {
  let rem = n - pos
  // Zero-allocation inline fast path for the 6 core WebVTT entities
  if rem >= 4 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if b1 == 108 && b2 == 116 && b3 == 59 {
      sb.write_byte((60).to_byte())
      return pos + 4
    }
    if b1 == 103 && b2 == 116 && b3 == 59 {
      sb.write_byte((62).to_byte())
      return pos + 4
    }
    if rem >= 5 {
      let b4 = s.code_unit_at(pos + 4)
      if b1 == 97 && b2 == 109 && b3 == 112 && b4 == 59 {
        sb.write_byte((38).to_byte())
        return pos + 5
      }
      if b1 == 108 && b2 == 114 && b3 == 109 && b4 == 59 {
        sb.write_byte((0xE2).to_byte())
        sb.write_byte((0x80).to_byte())
        sb.write_byte((0x8E).to_byte())
        return pos + 5
      }
      if b1 == 114 && b2 == 108 && b3 == 109 && b4 == 59 {
        sb.write_byte((0xE2).to_byte())
        sb.write_byte((0x80).to_byte())
        sb.write_byte((0x8F).to_byte())
        return pos + 5
      }
      if rem >= 6 {
        let b5 = s.code_unit_at(pos + 5)
        if b1 == 110 && b2 == 98 && b3 == 115 && b4 == 112 && b5 == 59 {
          sb.write_byte((0xC2).to_byte())
          sb.write_byte((0xA0).to_byte())
          return pos + 6
        }
      }
    }
  }

  let mut i = pos + 1
  if i >= n {
    sb.write_byte((38).to_byte())
    return i
  }
  let b0 = s.code_unit_at(i)
  if b0 == 35 {
    // Numeric character reference: &#... or &#x...
    i = i + 1
    if i >= n {
      sb.write_string("&#")
      return i
    }
    let bx = s.code_unit_at(i)
    if bx == 120 || bx == 88 {
      i = i + 1
      let dstart = i
      let mut cp = 0
      while i < n {
        let c = s.code_unit_at(i)
        let d = if c >= 48 && c <= 57 {
          c - 48
        } else if c >= 97 && c <= 102 {
          c - 97 + 10
        } else if c >= 65 && c <= 70 {
          c - 65 + 10
        } else {
          -1
        }
        if d < 0 {
          break
        }
        if cp < 0x110000 {
          cp = (cp << 4) | d
        }
        i = i + 1
      }
      if i == dstart {
        sb.write_string(s.slice(pos, i))
        return i
      }
      if i < n && s.code_unit_at(i) == 59 {
        i = i + 1
      }
      write_utf8_cp(sb, sanitize_numeric_cp(cp))
      return i
    } else {
      let dstart = i
      let mut cp = 0
      while i < n {
        let c = s.code_unit_at(i)
        if c >= 48 && c <= 57 {
          if cp < 0x110000 {
            cp = cp * 10 + (c - 48)
          }
          i = i + 1
        } else {
          break
        }
      }
      if i == dstart {
        sb.write_string("&#")
        return i
      }
      if i < n && s.code_unit_at(i) == 59 {
        i = i + 1
      }
      write_utf8_cp(sb, sanitize_numeric_cp(cp))
      return i
    }
  }

  // Named character reference (WHATWG HTML5 §13.2.5.73)
  if !is_ascii_alpha(b0) {
    sb.write_byte((38).to_byte())
    return pos + 1
  }
  let name_start = i
  let max_end = if name_start + 32 < n { name_start + 32 } else { n }
  while i < max_end && is_ascii_alnum(s.code_unit_at(i)) {
    i = i + 1
  }
  if i < n && s.code_unit_at(i) == 59 {
    let name = s.slice(name_start, i)
    let (cp1, cp2) = lookup_named_entity_pair(name)
    if cp1 > 0 {
      write_utf8_cp(sb, cp1)
      if cp2 > 0 {
        write_utf8_cp(sb, cp2)
      }
      return i + 1
    }
  }
  // Legacy prefix match without semicolon (e.g. &amp, &not, &notit;)
  let mut k = i
  if k > name_start + 6 {
    k = name_start + 6
  }
  while k >= name_start + 2 {
    let cand = s.slice(name_start, k)
    let cp = lookup_legacy_entity(cand)
    if cp > 0 {
      write_utf8_cp(sb, cp)
      return k
    }
    k = k - 1
  }
  sb.write_byte((38).to_byte())
  pos + 1
}

///| Fast-path plain text extraction: strips WebVTT tags and decodes HTML entities with zero intermediate slices.
pub fn plain_text(payload : String) -> String {
  let n = payload.length()
  // Fast scan: if no '<' (60) and no '&' (38), return payload directly with zero allocation!
  let mut i = 0
  let mut special = -1
  while i < n {
    let b = payload.code_unit_at(i)
    if b == 60 || b == 38 {
      special = i
      break
    }
    i = i + 1
  }
  if special < 0 {
    return payload
  }

  let sb = StringBuilder::with_capacity(n)
  let mut k = 0
  while k < special {
    sb.write_byte(payload.code_unit_at(k).to_byte())
    k = k + 1
  }
  let mut pos = special
  while pos < n {
    let b = payload.code_unit_at(pos)
    if b == 60 {
      pos = pos + 1
      while pos < n && payload.code_unit_at(pos) != 62 {
        pos = pos + 1
      }
      if pos < n {
        pos = pos + 1
      }
    } else if b == 38 {
      pos = decode_entity_into(payload, pos, n, sb)
    } else {
      sb.write_byte(b.to_byte())
      pos = pos + 1
    }
  }
  sb.to_string()
}

///| Check whether byte `b` is tag-annotation ASCII whitespace (SPACE, TAB, LF, FF).
fn is_tag_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 12
}

///| Open tag frame for iterative cue payload parsing.
struct TagFrame {
  kind : Int
  classes : Array[String]
  annotation : String
  children : Array[CueNode]
}

///| Map a WebVTT tag name slice to a numeric kind (`1..8`), or `0` if unrecognized.
fn match_tag_kind(s : String, start : Int, end : Int) -> Int {
  let len = end - start
  if len == 1 {
    let b = s.code_unit_at(start)
    if b == 98 {
      return 1 // b
    }
    if b == 105 {
      return 2 // i
    }
    if b == 117 {
      return 3 // u
    }
    if b == 99 {
      return 4 // c
    }
    if b == 118 {
      return 5 // v
    }
    return 0
  }
  if len == 2 {
    if s.code_unit_at(start) == 114 && s.code_unit_at(start + 1) == 116 {
      return 8 // rt
    }
    return 0
  }
  if len == 4 {
    if slice_eq(s, start, end, "lang") {
      return 6 // lang
    }
    if slice_eq(s, start, end, "ruby") {
      return 7 // ruby
    }
  }
  0
}

///| Convert a closed `TagFrame` into its `CueNode`.
fn frame_to_node(f : TagFrame) -> CueNode {
  if f.kind == 1 {
    CueNode::Bold(f.classes, f.children)
  } else if f.kind == 2 {
    CueNode::Italic(f.classes, f.children)
  } else if f.kind == 3 {
    CueNode::Underline(f.classes, f.children)
  } else if f.kind == 4 {
    CueNode::Class(f.classes, f.children)
  } else if f.kind == 5 {
    CueNode::Voice(f.classes, f.annotation, f.children)
  } else if f.kind == 6 {
    CueNode::Lang(f.classes, f.annotation, f.children)
  } else if f.kind == 7 {
    CueNode::Ruby(f.classes, f.children)
  } else {
    CueNode::RubyText(f.classes, f.children)
  }
}

///| Append a `CueNode` to the top frame on `stack`, or to `root` if stack is empty.
fn push_node(root : Array[CueNode], stack : Array[TagFrame], node : CueNode) -> Unit {
  let slen = stack.length()
  if slen == 0 {
    root.push(node)
  } else {
    stack[slen - 1].children.push(node)
  }
}

///| Flush buffered text into the active node list if non-empty.
fn flush_text(root : Array[CueNode], stack : Array[TagFrame], sb : StringBuilder) -> Unit {
  let txt = sb.to_string()
  if txt.length() > 0 {
    push_node(root, stack, CueNode::Text(txt))
  }
}

///| Decode entities and collapse ASCII whitespace runs in a WebVTT tag annotation (§6.4).
fn decode_annotation(s : String, start : Int, end : Int) -> String {
  let raw_sb = StringBuilder::with_capacity(end - start)
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 38 {
      i = decode_entity_into(s, i, end, raw_sb)
    } else {
      raw_sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  }
  let decoded = raw_sb.to_string()
  let dn = decoded.length()
  // Trim leading/trailing ASCII whitespace and collapse internal runs to single U+0020 SPACE
  let mut a = 0
  while a < dn && is_tag_ws(decoded.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = dn
  while b > a && is_tag_ws(decoded.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a >= b {
    return ""
  }
  let out = StringBuilder::with_capacity(b - a)
  let mut prev_ws = false
  let mut j = a
  while j < b {
    let ch = decoded.code_unit_at(j)
    if is_tag_ws(ch) {
      if !prev_ws {
        out.write_byte((32).to_byte())
        prev_ws = true
      }
    } else {
      out.write_byte(ch.to_byte())
      prev_ws = false
    }
    j = j + 1
  }
  out.to_string()
}

///| Parse a cue payload into a tree of `CueNode`s using the default tag nesting depth limit (64).
pub fn parse_cue_payload(payload : String) -> Result[Array[CueNode], WebVttError] {
  parse_cue_payload_with_limits(payload, 64)
}

///| Parse a cue payload into a tree of `CueNode`s with an explicit `max_tag_depth` limit.
pub fn parse_cue_payload_with_limits(
  payload : String,
  max_tag_depth : Int,
) -> Result[Array[CueNode], WebVttError] {
  let n = payload.length()
  let root : Array[CueNode] = []
  let stack : Array[TagFrame] = []
  let mut sb = StringBuilder::with_capacity(64)
  let mut has_text = false

  let mut pos = 0
  while pos < n {
    let b = payload.code_unit_at(pos)
    if b == 38 {
      pos = decode_entity_into(payload, pos, n, sb)
      has_text = true
    } else if b == 60 {
      if has_text {
        flush_text(root, stack, sb)
        sb = StringBuilder::with_capacity(32)
        has_text = false
      }
      let tag_start = pos + 1
      let mut gt = tag_start
      while gt < n && payload.code_unit_at(gt) != 62 {
        gt = gt + 1
      }
      let next_pos = if gt < n { gt + 1 } else { n }

      if tag_start < gt {
        let first_b = payload.code_unit_at(tag_start)
        if first_b == 47 {
          // Closing tag </name>: §6.4 only closes current node (plus </ruby> closes current <rt>)
          let close_kind = match_tag_kind(payload, tag_start + 1, gt)
          if close_kind != 0 && stack.length() > 0 {
            let top_kind = stack[stack.length() - 1].kind
            if top_kind == close_kind {
              match stack.pop() {
                Some(f) => push_node(root, stack, frame_to_node(f))
                None => ()
              }
            } else if close_kind == 7 && top_kind == 8 {
              // </ruby> closes current <rt>, then closes enclosing <ruby>
              match stack.pop() {
                Some(rt_f) => push_node(root, stack, frame_to_node(rt_f))
                None => ()
              }
              if stack.length() > 0 && stack[stack.length() - 1].kind == 7 {
                match stack.pop() {
                  Some(ruby_f) => push_node(root, stack, frame_to_node(ruby_f))
                  None => ()
                }
              }
            }
          }
        } else if is_digit(first_b) {
          // Inline timestamp tag <00:12.500>
          let ms = parse_timestamp_raw(payload, tag_start, gt, false)
          if ms >= 0L {
            push_node(root, stack, CueNode::Timestamp(ms))
          }
        } else {
          // Opening tag: name[.class1.class2][ annotation]
          let mut name_end = tag_start
          while name_end < gt {
            let c = payload.code_unit_at(name_end)
            if c == 46 || is_tag_ws(c) {
              break
            }
            name_end = name_end + 1
          }
          let kind = match_tag_kind(payload, tag_start, name_end)
          // §6.4: <rt> only opens if current node is <ruby>
          let rt_ok = kind != 8 || (stack.length() > 0 && stack[stack.length() - 1].kind == 7)
          if kind != 0 && rt_ok {
            if stack.length() >= max_tag_depth {
              return Err(
                WebVttError::LimitExceeded(
                  "cue tag nesting depth exceeds max_tag_depth " + max_tag_depth.to_string(),
                ),
              )
            }
            let classes : Array[String] = []
            let mut ci = name_end
            while ci < gt && payload.code_unit_at(ci) == 46 {
              ci = ci + 1
              let cs = ci
              while ci < gt {
                let c = payload.code_unit_at(ci)
                if c == 46 || is_tag_ws(c) {
                  break
                }
                ci = ci + 1
              }
              if ci > cs {
                classes.push(payload.slice(cs, ci))
              }
            }
            let mut annotation = ""
            if ci < gt && is_tag_ws(payload.code_unit_at(ci)) {
              annotation = decode_annotation(payload, ci + 1, gt)
            }
            stack.push(
              TagFrame::{
                kind: kind,
                classes: classes,
                annotation: annotation,
                children: [],
              },
            )
          }
        }
      }
      pos = next_pos
    } else {
      sb.write_byte(b.to_byte())
      has_text = true
      pos = pos + 1
    }
  }

  if has_text {
    flush_text(root, stack, sb)
  }
  while stack.length() > 0 {
    match stack.pop() {
      Some(f) => push_node(root, stack, frame_to_node(f))
      None => break
    }
  }
  Ok(root)
}

///| Flatten parsed `CueNode` trees back to plain text iteratively (stack-safe for arbitrary depth).
pub fn nodes_to_plain_text(nodes : Array[CueNode]) -> String {
  let sb = StringBuilder::with_capacity(64)
  let arr_stk : Array[Array[CueNode]] = [nodes]
  let idx_stk : Array[Int] = [0]

  while arr_stk.length() > 0 {
    let top = arr_stk.length() - 1
    let cur_arr = arr_stk[top]
    let cur_idx = idx_stk[top]
    if cur_idx >= cur_arr.length() {
      let _ = arr_stk.pop()
      let _ = idx_stk.pop()
      continue
    }
    idx_stk[top] = cur_idx + 1
    match cur_arr[cur_idx] {
      CueNode::Text(t) => sb.write_string(t)
      CueNode::Bold(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Italic(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Underline(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Class(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Voice(_, _, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Lang(_, _, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Ruby(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::RubyText(_, ch) => {
        arr_stk.push(ch)
        idx_stk.push(0)
      }
      CueNode::Timestamp(_) => ()
    }
  }
  sb.to_string()
}
