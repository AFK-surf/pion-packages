///| W3C WebVTT cue payload rich-text tag parser, HTML entity decoder, and fast plain-text extractor.

///| Decode a WebVTT HTML entity starting at `&` (`pos`) into `sb`, returning next byte offset.
fn decode_entity_into(s : String, pos : Int, n : Int, sb : StringBuilder) -> Int {
  // Fast check for shortest/most common entities
  let rem = n - pos
  if rem >= 4 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if b1 == 108 && b2 == 116 && b3 == 59 {
      // &lt;
      sb.write_byte((60).to_byte())
      return pos + 4
    }
    if b1 == 103 && b2 == 116 && b3 == 59 {
      // &gt;
      sb.write_byte((62).to_byte())
      return pos + 4
    }
    if rem >= 5 {
      let b4 = s.code_unit_at(pos + 4)
      if b1 == 97 && b2 == 109 && b3 == 112 && b4 == 59 {
        // &amp;
        sb.write_byte((38).to_byte())
        return pos + 5
      }
      if b1 == 108 && b2 == 114 && b3 == 109 && b4 == 59 {
        // &lrm; -> U+200E (E2 80 8E)
        sb.write_byte((0xE2).to_byte())
        sb.write_byte((0x80).to_byte())
        sb.write_byte((0x8E).to_byte())
        return pos + 5
      }
      if b1 == 114 && b2 == 108 && b3 == 109 && b4 == 59 {
        // &rlm; -> U+200F (E2 80 8F)
        sb.write_byte((0xE2).to_byte())
        sb.write_byte((0x80).to_byte())
        sb.write_byte((0x8F).to_byte())
        return pos + 5
      }
      if rem >= 6 {
        let b5 = s.code_unit_at(pos + 5)
        if b1 == 110 && b2 == 98 && b3 == 115 && b4 == 112 && b5 == 59 {
          // &nbsp; -> U+00A0 (C2 A0)
          sb.write_byte((0xC2).to_byte())
          sb.write_byte((0xA0).to_byte())
          return pos + 6
        }
      }
    }
  }
  sb.write_byte((38).to_byte())
  pos + 1
}

///| Fast-path plain text extraction: strips WebVTT tags and decodes HTML entities with zero intermediate slices.
pub fn plain_text(payload : String) -> String {
  let n = payload.length()
  // Fast scan: if no '<' (60) and no '&' (38), return payload directly with zero allocation!
  let mut i = 0
  let mut special = -1
  while i < n {
    let b = payload.code_unit_at(i)
    if b == 60 || b == 38 {
      special = i
      break
    }
    i = i + 1
  }
  if special < 0 {
    return payload
  }

  let sb = StringBuilder::with_capacity(n)
  let mut k = 0
  while k < special {
    sb.write_byte(payload.code_unit_at(k).to_byte())
    k = k + 1
  }
  let mut pos = special
  while pos < n {
    let b = payload.code_unit_at(pos)
    if b == 60 {
      pos = pos + 1
      while pos < n && payload.code_unit_at(pos) != 62 {
        pos = pos + 1
      }
      if pos < n {
        pos = pos + 1
      }
    } else if b == 38 {
      pos = decode_entity_into(payload, pos, n, sb)
    } else {
      sb.write_byte(b.to_byte())
      pos = pos + 1
    }
  }
  sb.to_string()
}

///| Open tag frame for iterative cue payload parsing.
struct TagFrame {
  kind : Int
  classes : Array[String]
  annotation : String
  children : Array[CueNode]
}

///| Map a WebVTT tag name slice to a numeric kind (`1..8`), or `0` if unrecognized.
fn match_tag_kind(s : String, start : Int, end : Int) -> Int {
  let len = end - start
  if len == 1 {
    let b = s.code_unit_at(start)
    if b == 98 {
      return 1 // b
    }
    if b == 105 {
      return 2 // i
    }
    if b == 117 {
      return 3 // u
    }
    if b == 99 {
      return 4 // c
    }
    if b == 118 {
      return 5 // v
    }
    return 0
  }
  if len == 2 {
    if s.code_unit_at(start) == 114 && s.code_unit_at(start + 1) == 116 {
      return 8 // rt
    }
    return 0
  }
  if len == 4 {
    if slice_eq(s, start, end, "lang") {
      return 6 // lang
    }
    if slice_eq(s, start, end, "ruby") {
      return 7 // ruby
    }
  }
  0
}

///| Convert a closed `TagFrame` into its `CueNode`.
fn frame_to_node(f : TagFrame) -> CueNode {
  if f.kind == 1 {
    CueNode::Bold(f.classes, f.children)
  } else if f.kind == 2 {
    CueNode::Italic(f.classes, f.children)
  } else if f.kind == 3 {
    CueNode::Underline(f.classes, f.children)
  } else if f.kind == 4 {
    CueNode::Class(f.classes, f.children)
  } else if f.kind == 5 {
    CueNode::Voice(f.classes, f.annotation, f.children)
  } else if f.kind == 6 {
    CueNode::Lang(f.classes, f.annotation, f.children)
  } else if f.kind == 7 {
    CueNode::Ruby(f.classes, f.children)
  } else {
    CueNode::RubyText(f.classes, f.children)
  }
}

///| Append a `CueNode` to the top frame on `stack`, or to `root` if stack is empty.
fn push_node(root : Array[CueNode], stack : Array[TagFrame], node : CueNode) -> Unit {
  let slen = stack.length()
  if slen == 0 {
    root.push(node)
  } else {
    stack[slen - 1].children.push(node)
  }
}

///| Flush buffered text into the active node list if non-empty.
fn flush_text(root : Array[CueNode], stack : Array[TagFrame], sb : StringBuilder) -> Unit {
  let txt = sb.to_string()
  if txt.length() > 0 {
    push_node(root, stack, CueNode::Text(txt))
  }
}

///| Parse a cue payload into a tree of `CueNode`s using the default tag nesting depth limit (64).
pub fn parse_cue_payload(payload : String) -> Result[Array[CueNode], WebVttError] {
  parse_cue_payload_with_limits(payload, 64)
}

///| Parse a cue payload into a tree of `CueNode`s with an explicit `max_tag_depth` limit.
pub fn parse_cue_payload_with_limits(
  payload : String,
  max_tag_depth : Int,
) -> Result[Array[CueNode], WebVttError] {
  let n = payload.length()
  let root : Array[CueNode] = []
  let stack : Array[TagFrame] = []
  let mut sb = StringBuilder::with_capacity(64)
  let mut has_text = false

  let mut pos = 0
  while pos < n {
    let b = payload.code_unit_at(pos)
    if b == 38 {
      pos = decode_entity_into(payload, pos, n, sb)
      has_text = true
    } else if b == 60 {
      if has_text {
        flush_text(root, stack, sb)
        sb = StringBuilder::with_capacity(32)
        has_text = false
      }
      // Find matching '>'
      let tag_start = pos + 1
      let mut gt = tag_start
      while gt < n && payload.code_unit_at(gt) != 62 {
        gt = gt + 1
      }
      let next_pos = if gt < n { gt + 1 } else { n }

      if tag_start < gt {
        let first_b = payload.code_unit_at(tag_start)
        if first_b == 47 {
          // Closing tag </name>
          let close_kind = match_tag_kind(payload, tag_start + 1, gt)
          if close_kind != 0 {
            // Find nearest matching frame on stack
            let mut match_idx = -1
            let mut si = stack.length() - 1
            while si >= 0 {
              if stack[si].kind == close_kind {
                match_idx = si
                break
              }
              si = si - 1
            }
            if match_idx >= 0 {
              while stack.length() > match_idx {
                match stack.pop() {
                  Some(f) => push_node(root, stack, frame_to_node(f))
                  None => break
                }
              }
            }
          }
        } else if is_digit(first_b) {
          // Inline timestamp tag <00:12.500>
          match parse_timestamp_slice(payload, tag_start, gt) {
            Ok(ms) => push_node(root, stack, CueNode::Timestamp(ms))
            Err(_) => ()
          }
        } else {
          // Opening tag: name[.class1.class2][ annotation]
          let mut name_end = tag_start
          while name_end < gt {
            let c = payload.code_unit_at(name_end)
            if c == 46 || c == 32 || c == 9 {
              break
            }
            name_end = name_end + 1
          }
          let kind = match_tag_kind(payload, tag_start, name_end)
          if kind != 0 {
            if stack.length() >= max_tag_depth {
              return Err(
                WebVttError::LimitExceeded(
                  "cue tag nesting depth exceeds max_tag_depth " + max_tag_depth.to_string(),
                ),
              )
            }
            let classes : Array[String] = []
            let mut ci = name_end
            while ci < gt && payload.code_unit_at(ci) == 46 {
              ci = ci + 1
              let cs = ci
              while ci < gt {
                let c = payload.code_unit_at(ci)
                if c == 46 || c == 32 || c == 9 {
                  break
                }
                ci = ci + 1
              }
              if ci > cs {
                classes.push(payload.slice(cs, ci))
              }
            }
            let mut annotation = ""
            if ci < gt && is_ws(payload.code_unit_at(ci)) {
              let (aa, ab) = trim_ws_bounds(payload, ci + 1, gt)
              if aa < ab {
                // Decode entities inside annotation (e.g. <v A &amp; B>)
                let asb = StringBuilder::with_capacity(ab - aa)
                let mut ai = aa
                while ai < ab {
                  if payload.code_unit_at(ai) == 38 {
                    ai = decode_entity_into(payload, ai, ab, asb)
                  } else {
                    asb.write_byte(payload.code_unit_at(ai).to_byte())
                    ai = ai + 1
                  }
                }
                annotation = asb.to_string()
              }
            }
            stack.push(
              TagFrame::{
                kind: kind,
                classes: classes,
                annotation: annotation,
                children: [],
              },
            )
          }
        }
      }
      pos = next_pos
    } else {
      sb.write_byte(b.to_byte())
      has_text = true
      pos = pos + 1
    }
  }

  if has_text {
    flush_text(root, stack, sb)
  }
  // Auto-close any remaining unclosed tags
  while stack.length() > 0 {
    match stack.pop() {
      Some(f) => push_node(root, stack, frame_to_node(f))
      None => break
    }
  }
  Ok(root)
}

///| Helper to append plain text of `nodes` into `sb`.
fn collect_nodes_text(nodes : Array[CueNode], sb : StringBuilder) -> Unit {
  let n = nodes.length()
  let mut i = 0
  while i < n {
    match nodes[i] {
      CueNode::Text(t) => sb.write_string(t)
      CueNode::Bold(_, ch) => collect_nodes_text(ch, sb)
      CueNode::Italic(_, ch) => collect_nodes_text(ch, sb)
      CueNode::Underline(_, ch) => collect_nodes_text(ch, sb)
      CueNode::Class(_, ch) => collect_nodes_text(ch, sb)
      CueNode::Voice(_, _, ch) => collect_nodes_text(ch, sb)
      CueNode::Lang(_, _, ch) => collect_nodes_text(ch, sb)
      CueNode::Ruby(_, ch) => collect_nodes_text(ch, sb)
      CueNode::RubyText(_, ch) => collect_nodes_text(ch, sb)
      CueNode::Timestamp(_) => ()
    }
    i = i + 1
  }
}

///| Flatten parsed `CueNode` trees back to plain text.
pub fn nodes_to_plain_text(nodes : Array[CueNode]) -> String {
  let sb = StringBuilder::with_capacity(64)
  collect_nodes_text(nodes, sb)
  sb.to_string()
}
