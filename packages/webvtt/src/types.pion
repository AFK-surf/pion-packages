///| Core types, errors, settings, regions, cues, rich-text nodes, and limits for W3C WebVTT (`packages/webvtt`).

///| Structured error type for WebVTT parsing and validation.
pub enum WebVttError {
  InvalidHeader(String)
  InvalidTimestamp(String)
  InvalidCue(String)
  InvalidPayload(String)
  LimitExceeded(String)
  Unimplemented(String)
}

///| Format a `WebVttError` as a human-readable string.
pub fn webvtt_error_to_string(e : WebVttError) -> String {
  match e {
    WebVttError::InvalidHeader(m) => "InvalidHeader: " + m
    WebVttError::InvalidTimestamp(m) => "InvalidTimestamp: " + m
    WebVttError::InvalidCue(m) => "InvalidCue: " + m
    WebVttError::InvalidPayload(m) => "InvalidPayload: " + m
    WebVttError::LimitExceeded(m) => "LimitExceeded: " + m
    WebVttError::Unimplemented(m) => "Unimplemented: " + m
  }
}

///| Security & DoS protection limits for WebVTT parsing.
pub val struct ParseLimits {
  max_input_bytes : Int
  max_cues : Int
  max_styles : Int
  max_regions : Int
  max_notes : Int
  max_tag_depth : Int
}

///| Default `ParseLimits` suitable for web video players (16 MiB input, 100k cues, 64 tag depth).
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_input_bytes: 16777216,
    max_cues: 100000,
    max_styles: 1000,
    max_regions: 1000,
    max_notes: 10000,
    max_tag_depth: 64,
  }
}

///| Header metadata key-value entry (e.g. `Kind: captions`, `Language: en`).
pub val struct HeaderMeta {
  key : String
  value : String
}

///| Vertical writing direction cue setting (`vertical:rl` / `vertical:lr`).
pub enum VerticalDirection {
  Horizontal
  RightToLeft
  LeftToRight
}

///| Line positioning value (`auto`, percentage `0..100`, or signed line number).
pub enum LineSetting {
  Auto
  Percentage(Double)
  LineNumber(Double)
}

///| Line alignment (`start`, `center`, `end`, or `auto`).
pub enum LineAlign {
  Auto
  Start
  Center
  End
}

///| Horizontal position setting (`auto` or percentage `0..100`).
pub enum PositionSetting {
  Auto
  Percentage(Double)
}

///| Position alignment (`auto`, `line-left`, `center`, `line-right`).
pub enum PositionAlign {
  Auto
  LineLeft
  Center
  LineRight
}

///| Text alignment (`start`, `center`, `end`, `left`, `right`).
pub enum TextAlign {
  Start
  Center
  End
  Left
  Right
}

///| Region scroll behavior (`none` or `up`).
pub enum RegionScroll {
  None
  Up
}

///| 2D percentage anchor point `(x, y)` in `0.0..100.0`.
pub val struct Anchor {
  x : Double
  y : Double
}

///| W3C WebVTT `REGION` block definition.
pub val struct Region {
  id : String
  width : Double
  lines : Int
  region_anchor : Anchor
  viewport_anchor : Anchor
  scroll : RegionScroll
}

///| Default `Region` values per W3C WebVTT specification.
pub fn Region::default(id : String) -> Region {
  Region::{
    id: id,
    width: 100.0,
    lines: 3,
    region_anchor: Anchor::{ x: 0.0, y: 100.0 },
    viewport_anchor: Anchor::{ x: 0.0, y: 100.0 },
    scroll: RegionScroll::None,
  }
}

///| W3C WebVTT cue layout settings.
pub val struct CueSettings {
  vertical : VerticalDirection
  line : LineSetting
  line_align : LineAlign
  position : PositionSetting
  position_align : PositionAlign
  size : Double
  align : TextAlign
  region : String
}

///| Default `CueSettings` per W3C WebVTT specification.
pub fn CueSettings::default() -> CueSettings {
  CueSettings::{
    vertical: VerticalDirection::Horizontal,
    line: LineSetting::Auto,
    line_align: LineAlign::Auto,
    position: PositionSetting::Auto,
    position_align: PositionAlign::Auto,
    size: 100.0,
    align: TextAlign::Center,
    region: "",
  }
}

///| Rich-text AST node inside a WebVTT cue payload.
pub enum CueNode {
  Text(String)
  Bold(Array[String], Array[CueNode])
  Italic(Array[String], Array[CueNode])
  Underline(Array[String], Array[CueNode])
  Class(Array[String], Array[CueNode])
  Voice(Array[String], String, Array[CueNode])
  Lang(Array[String], String, Array[CueNode])
  Ruby(Array[String], Array[CueNode])
  RubyText(Array[String], Array[CueNode])
  Timestamp(Int64)
}

///| A single WebVTT cue with exact integer millisecond timestamps.
pub val struct Cue {
  id : String
  start_ms : Int64
  end_ms : Int64
  settings : CueSettings
  payload : String
}

///| Extract decoded plain text from this cue's payload (tags stripped, entities decoded).
pub fn Cue::plain_text(self : Cue) -> String {
  plain_text(self.payload)
}

///| Parse this cue's rich-text payload into a tree of `CueNode`s using default depth limit.
pub fn Cue::parse_payload(self : Cue) -> Result[Array[CueNode], WebVttError] {
  parse_cue_payload(self.payload)
}

///| Precomputed timeline index for O(log N + K) active-cue queries.
pub struct TimelineIndex {
  is_identity : Bool
  sorted_order : FixedArray[Int]
  sorted_starts : FixedArray[Int64]
  prefix_max_end : FixedArray[Int64]
}

///| Parsed W3C WebVTT document with header metadata, styles, regions, notes, cues, and timeline index.
pub struct WebVttTrack {
  header_title : String
  header_metadata : Array[HeaderMeta]
  styles : Array[String]
  regions : Array[Region]
  notes : Array[String]
  cues : Array[Cue]
  timeline : TimelineIndex
}

///| Look up a `Region` by its `id`.
pub fn WebVttTrack::get_region(self : WebVttTrack, id : String) -> Option[Region] {
  let n = self.regions.length()
  let mut i = 0
  while i < n {
    if self.regions[i].id == id {
      return Some(self.regions[i])
    }
    i = i + 1
  }
  None
}

///| Query all cues active at `time_ms` (`start_ms <= time_ms < end_ms`) in cue order.
pub fn WebVttTrack::active_cues_at(self : WebVttTrack, time_ms : Int64) -> Array[Cue] {
  active_cues_at(self, time_ms)
}
