///| W3C WebVTT timestamp, cue identifier, cue settings, and lenient mode tests.

fn assert_eq_i64(got : Int64, expected : Int64, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_approx_f(got : Double, expected : Double, label : String) -> Unit {
  let diff = if got >= expected { got - expected } else { expected - got }
  debug_assert(diff < 0.0001, label + ": float mismatch")
}

///|
test "timestamp_parsing_and_formatting" {
  // MM:SS.mmm
  match parse_timestamp("00:00.000") {
    Ok(ms) => assert_eq_i64(ms, 0L, "00:00.000")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  match parse_timestamp("12:34.567") {
    Ok(ms) => assert_eq_i64(ms, 754567L, "12:34.567")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  // HH:MM:SS.mmm
  match parse_timestamp("01:02:03.004") {
    Ok(ms) => assert_eq_i64(ms, 3723004L, "01:02:03.004")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  // Arbitrary-length hours (e.g. 1234 hours for long live streams)
  match parse_timestamp("1234:59:59.999") {
    Ok(ms) => assert_eq_i64(ms, 4445999999L, "1234:59:59.999")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  // Canonical formatting roundtrip
  debug_assert(format_timestamp(0L) == "00:00:00.000", "fmt 0")
  debug_assert(format_timestamp(754567L) == "00:12:34.567", "fmt 12:34.567")
  debug_assert(format_timestamp(3723004L) == "01:02:03.004", "fmt 01:02:03.004")
  debug_assert(format_timestamp(4445999999L) == "1234:59:59.999", "fmt 1234h")

  // Invalid timestamps must be rejected
  let bad_ts : Array[String] = [
    "",
    "1:02.000", // 1-digit minutes in MM:SS.mmm
    "00:60.000", // seconds >= 60
    "60:00.000", // minutes >= 60 in MM:SS.mmm
    "01:60:00.000", // minutes >= 60 in HH:MM:SS.mmm
    "01:00:60.000", // seconds >= 60 in HH:MM:SS.mmm
    "00:01.00", // only 2 ms digits
    "00:01.0000", // 4 ms digits
    "00:01,000", // SRT comma instead of dot
    "1:00:00.000", // 1-digit hour
    "00:01.00a", // non-digit
    "-00:01.000", // negative
    "99999999999999999999:00:00.000", // overflow
  ]
  let mut i = 0
  while i < bad_ts.length() {
    match parse_timestamp(bad_ts[i]) {
      Ok(v) => debug_assert(false, "expected invalid timestamp for " + bad_ts[i] + ", got " + v.to_string())
      Err(WebVttError::InvalidTimestamp(_)) => ()
      Err(e) => debug_assert(false, "expected InvalidTimestamp, got: " + webvtt_error_to_string(e))
    }
    i = i + 1
  }
}

///|
test "cue_identifiers_settings_and_multiline_payload" {
  let doc =
  "WEBVTT\n\n" +
  "intro-cue\n" +
  "00:00:01.500 --> 00:00:04.250 vertical:rl line:85%,end position:20%,line-left size:60% align:left region:r1\n" +
  "First line of cue\n" +
  "Second line of cue\n\n" +
  "2\n" +
  "00:05.000 --> 00:10.000 vertical:lr line:-2,start position:50%,center size:100% align:middle\n" +
  "Line number & legacy middle align\n\n" +
  "00:10.000 --> 00:12.000 align:right line:105% size:-5% unknown:foo\n" +
  "Invalid settings ignored\n"

  match parse(doc) {
    Ok(t) => {
      debug_assert(t.cues.length() == 3, "expected 3 cues")

      let c0 = t.cues[0]
      debug_assert(c0.id == "intro-cue", "c0 id")
      assert_eq_i64(c0.start_ms, 1500L, "c0 start")
      assert_eq_i64(c0.end_ms, 4250L, "c0 end")
      match c0.settings.vertical {
        VerticalDirection::RightToLeft => ()
        _ => debug_assert(false, "c0 vertical rl")
      }
      match c0.settings.line {
        LineSetting::Percentage(p) => assert_approx_f(p, 85.0, "c0 line 85%")
        _ => debug_assert(false, "c0 line should be Percentage")
      }
      match c0.settings.line_align {
        LineAlign::End => ()
        _ => debug_assert(false, "c0 line_align end")
      }
      match c0.settings.position {
        PositionSetting::Percentage(p) => assert_approx_f(p, 20.0, "c0 pos 20%")
        _ => debug_assert(false, "c0 position should be Percentage")
      }
      match c0.settings.position_align {
        PositionAlign::LineLeft => ()
        _ => debug_assert(false, "c0 pos_align line-left")
      }
      assert_approx_f(c0.settings.size, 60.0, "c0 size")
      match c0.settings.align {
        TextAlign::Left => ()
        _ => debug_assert(false, "c0 align left")
      }
      debug_assert(c0.settings.region == "r1", "c0 region")
      debug_assert(c0.payload == "First line of cue\nSecond line of cue", "c0 payload")

      let c1 = t.cues[1]
      debug_assert(c1.id == "2", "c1 id")
      match c1.settings.vertical {
        VerticalDirection::LeftToRight => ()
        _ => debug_assert(false, "c1 vertical lr")
      }
      match c1.settings.line {
        LineSetting::LineNumber(n) => assert_approx_f(n, -2.0, "c1 line -2")
        _ => debug_assert(false, "c1 line should be LineNumber")
      }
      match c1.settings.line_align {
        LineAlign::Start => ()
        _ => debug_assert(false, "c1 line_align start")
      }
      match c1.settings.align {
        TextAlign::Center => ()
        _ => debug_assert(false, "c1 legacy middle -> Center")
      }

      let c2 = t.cues[2]
      debug_assert(c2.id == "", "c2 empty id")
      match c2.settings.line {
        LineSetting::Auto => ()
        _ => debug_assert(false, "c2 invalid line:105% ignored -> Auto")
      }
      assert_approx_f(c2.settings.size, 100.0, "c2 invalid size:-5% ignored -> 100%")
      match c2.settings.align {
        TextAlign::Right => ()
        _ => debug_assert(false, "c2 align right")
      }
    }
    Err(e) => debug_assert(false, "cues/settings parse failed: " + webvtt_error_to_string(e))
  }
}

///|
test "inverted_and_malformed_timestamps_strict_vs_lenient" {
  let inverted = "WEBVTT\n\n00:05.000 --> 00:02.000\nInverted\n\n00:06.000 --> 00:08.000\nValid\n"
  match parse(inverted) {
    Ok(_) => debug_assert(false, "strict parse must reject inverted cue timestamps")
    Err(WebVttError::InvalidTimestamp(_)) => ()
    Err(e) => debug_assert(false, "expected InvalidTimestamp, got: " + webvtt_error_to_string(e))
  }

  match parse_lenient(inverted, ParseLimits::default()) {
    Ok(t) => {
      debug_assert(t.cues.length() == 1, "lenient mode keeps valid cue")
      debug_assert(t.cues[0].payload == "Valid", "lenient valid cue payload")
    }
    Err(e) => debug_assert(false, "lenient parse failed: " + webvtt_error_to_string(e))
  }
}
