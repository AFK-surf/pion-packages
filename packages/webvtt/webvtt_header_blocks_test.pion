///| W3C WebVTT header, BOM, line endings, NOTE, STYLE, and REGION block tests.

fn assert_eq_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

fn assert_eq_int(got : Int, expected : Int, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_approx(got : Double, expected : Double, label : String) -> Unit {
  let diff = if got >= expected { got - expected } else { expected - got }
  debug_assert(diff < 0.0001, label + ": float mismatch")
}

///|
test "signature_validation_bom_and_line_endings" {
  // Valid minimal WEBVTT
  match parse("WEBVTT") {
    Ok(t) => {
      assert_eq_str(t.header_title, "", "minimal header title")
      assert_eq_int(t.cues.length(), 0, "minimal cues")
    }
    Err(e) => debug_assert(false, "minimal WEBVTT failed: " + webvtt_error_to_string(e))
  }

  // Valid with UTF-8 BOM + header title + CRLF + metadata
  let bom = "\xEF\xBB\xBF"
  let doc = bom +
  "WEBVTT - Sample Video Captions\r\n" +
  "Kind: captions\r\n" +
  "Language: en-US\r\n" +
  "\r\n" +
  "00:01.000 --> 00:02.500\r\n" +
  "Hello CRLF\r\n"
  match parse(doc) {
    Ok(t) => {
      assert_eq_str(t.header_title, "- Sample Video Captions", "header title")
      assert_eq_int(t.header_metadata.length(), 2, "metadata count")
      assert_eq_str(t.header_metadata[0].key, "Kind", "meta 0 key")
      assert_eq_str(t.header_metadata[0].value, "captions", "meta 0 val")
      assert_eq_str(t.header_metadata[1].key, "Language", "meta 1 key")
      assert_eq_str(t.header_metadata[1].value, "en-US", "meta 1 val")
      assert_eq_int(t.cues.length(), 1, "cue count")
      assert_eq_str(t.cues[0].payload, "Hello CRLF", "payload")
    }
    Err(e) => debug_assert(false, "BOM + CRLF failed: " + webvtt_error_to_string(e))
  }

  // Classic Mac CR-only line endings
  let cr_doc = "WEBVTT\tTab Title\r\r00:00.000 --> 00:01.000\rLine A\rLine B\r"
  match parse(cr_doc) {
    Ok(t) => {
      assert_eq_str(t.header_title, "Tab Title", "CR tab title")
      assert_eq_int(t.cues.length(), 1, "CR cue count")
      assert_eq_str(t.cues[0].payload, "Line A\nLine B", "CR normalized payload")
    }
    Err(e) => debug_assert(false, "CR-only failed: " + webvtt_error_to_string(e))
  }

  // Invalid signatures must be rejected
  let bad_inputs : Array[String] = [
    "",
    "WEBVT",
    "WEBVTTX",
    "WEBVTT:bad",
    "webvtt\n",
    " WEBVTT\n",
    "1\n00:00:00.000 --> 00:00:01.000\nSRT not VTT\n",
  ]
  let mut i = 0
  while i < bad_inputs.length() {
    match parse(bad_inputs[i]) {
      Ok(_) => debug_assert(false, "expected InvalidHeader for case " + i.to_string())
      Err(WebVttError::InvalidHeader(_)) => ()
      Err(e) => debug_assert(false, "expected InvalidHeader, got: " + webvtt_error_to_string(e))
    }
    i = i + 1
  }
}

///|
test "note_and_style_blocks" {
  let doc =
  "WEBVTT\n\n" +
  "NOTE This is a single-line comment\n\n" +
  "NOTE\nMulti-line comment line 1\nMulti-line comment line 2\n\n" +
  "STYLE\n::cue {\n  color: yellow;\n  background-color: rgba(0, 0, 0, 0.8);\n}\n\n" +
  "STYLE\n::cue(v[voice=\"Alice\"]) { color: cyan; }\n\n" +
  "STYLE\n::cue { color: red; }\n00:00.000 --> 00:01.000\naborted style\n\n" +
  "00:01.000 --> 00:03.000\nFirst cue\n\n" +
  "STYLE\n::cue { color: green; }\n\n" +
  "NOTE Trailing note\n"

  match parse(doc) {
    Ok(t) => {
      assert_eq_int(t.notes.length(), 3, "note count")
      assert_eq_str(t.notes[0], "This is a single-line comment", "note 0")
      assert_eq_str(
        t.notes[1],
        "Multi-line comment line 1\nMulti-line comment line 2",
        "note 1",
      )
      assert_eq_str(t.notes[2], "Trailing note", "note 2")
      // Only the 2 valid pre-cue STYLE blocks (3rd had '-->' so aborted, 4th was after a cue so ignored)
      assert_eq_int(t.styles.length(), 2, "style count")
      assert_eq_str(
        t.styles[0],
        "::cue {\n  color: yellow;\n  background-color: rgba(0, 0, 0, 0.8);\n}",
        "style 0",
      )
      assert_eq_str(t.styles[1], "::cue(v[voice=\"Alice\"]) { color: cyan; }", "style 1")
      assert_eq_int(t.cues.length(), 1, "cue count")
      assert_eq_str(t.cues[0].payload, "First cue", "cue 0 payload")
    }
    Err(e) => debug_assert(false, "note/style parse failed: " + webvtt_error_to_string(e))
  }
}

///|
test "region_blocks_and_defaults" {
  let doc =
  "WEBVTT\n\n" +
  "REGION\n" +
  "id:fred\n" +
  "width:40%\n" +
  "lines:3\n" +
  "regionanchor:0%,100%\n" +
  "viewportanchor:10%,90%\n" +
  "scroll:up\n\n" +
  "REGION\n" +
  "id:bill width:50% lines:5 regionanchor:100%,100% viewportanchor:90%,90%\n\n" +
  "REGION\n" +
  "id:fred\n" +
  "width:65.5%\n" +
  "lines:4\n\n" +
  "00:00.000 --> 00:05.000 region:fred\n" +
  "In region fred\n"

  match parse(doc) {
    Ok(t) => {
      assert_eq_int(t.regions.length(), 2, "region count after duplicate id replace")
      match t.get_region("fred") {
        Some(r) => {
          assert_approx(r.width, 65.5, "fred replaced width")
          assert_eq_int(r.lines, 4, "fred replaced lines")
          assert_approx(r.region_anchor.x, 0.0, "fred default region_anchor.x")
          assert_approx(r.region_anchor.y, 100.0, "fred default region_anchor.y")
          match r.scroll {
            RegionScroll::None => ()
            _ => debug_assert(false, "fred replaced scroll should be None")
          }
        }
        None => debug_assert(false, "missing region fred")
      }
      match t.get_region("bill") {
        Some(r) => {
          assert_approx(r.width, 50.0, "bill width")
          assert_eq_int(r.lines, 5, "bill lines")
          assert_approx(r.region_anchor.x, 100.0, "bill region_anchor.x")
          assert_approx(r.region_anchor.y, 100.0, "bill region_anchor.y")
          assert_approx(r.viewport_anchor.x, 90.0, "bill viewport_anchor.x")
          assert_approx(r.viewport_anchor.y, 90.0, "bill viewport_anchor.y")
        }
        None => debug_assert(false, "missing region bill")
      }
      assert_eq_int(t.cues.length(), 1, "cue count")
      assert_eq_str(t.cues[0].settings.region, "fred", "cue region setting")
    }
    Err(e) => debug_assert(false, "region parse failed: " + webvtt_error_to_string(e))
  }
}
