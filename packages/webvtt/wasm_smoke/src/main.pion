///| Native + Wasm32 4-mode smoke entry for `packages/webvtt`.

import "webvtt"

///|
pub fn main(world : World) -> Int {
  let sample =
  "\xEF\xBB\xBFWEBVTT - Farview Video Subtitles\r\n" +
  "Kind: captions\r\n" +
  "Language: en-US\r\n\r\n" +
  "NOTE Generated smoke corpus\r\n" +
  "Second note line\r\n\r\n" +
  "STYLE\r\n" +
  "::cue { color: white; }\r\n\r\n" +
  "REGION\r\n" +
  "id:bottom width:80% lines:2 regionanchor:50%,100% viewportanchor:50%,90% scroll:up\r\n\r\n" +
  "c2\r\n" +
  "00:05.000 --> 00:08.500 align:start position:10%,line-left size:80% region:bottom\r\n" +
  "<v.host Alice>Hello <b>world</b> &amp; <i>friends</i>!<00:06.250> <ruby>漢<rt>かん</rt></ruby></v>\r\n\r\n" +
  "c1\r\n" +
  "00:01.000 --> 00:10.000 vertical:rl line:90%,end\r\n" +
  "Background &lt;banner&gt;&nbsp;text\r\n"

  let track = match webvtt::parse(sample) {
    Ok(t) => t
    Err(e) => {
      io_println(world, "error=" + webvtt::webvtt_error_to_string(e))
      return 1
    }
  }

  let reg_ok = match track.get_region("bottom") {
    Some(r) => r.lines == 2L
    None => false
  }
  if !reg_ok {
    return 2
  }

  let active = track.active_cues_at(6000L)
  if active.length() != 2 {
    return 3
  }
  let p0 = active[0].plain_text()
  let p1 = active[1].plain_text()
  let ast_ok = match active[1].parse_payload() {
    Ok(nodes) => webvtt::nodes_to_plain_text(nodes) == p1
    Err(_) => false
  }
  if !ast_ok {
    return 4
  }

  io_println(world, "webvtt_wasm_smoke=ok")
  io_println(world, "title=" + track.header_title)
  io_println(world, "meta=" + track.header_metadata.length().to_string())
  io_println(world, "notes=" + track.notes.length().to_string())
  io_println(world, "styles=" + track.styles.length().to_string())
  io_println(world, "regions=" + track.regions.length().to_string())
  io_println(world, "cues=" + track.cues.length().to_string())
  io_println(world, "active_6s=" + active.length().to_string())
  io_println(world, "p0=" + p0)
  io_println(world, "p1=" + p1)
  io_println(world, "ts=" + webvtt::format_timestamp(active[1].start_ms))
  0
}
