///| W3C WebVTT cue payload rich-text tags, inline timestamps, HTML entities, and plain_text tests.

///|
test "payload_rich_tags_and_entities" {
  let raw = "<v.loud.host Alice>Hello <b>world</b> &amp; <i>friends</i>! <c.hi.blue>A &lt; B &gt; C</c><00:12.500> <lang en-US><u>OK</u></lang> <ruby>漢<rt>かん</rt></ruby></v>"
  match parse_cue_payload(raw) {
    Ok(nodes) => {
      debug_assert(nodes.length() == 1, "top-level single Voice node")
      match nodes[0] {
        CueNode::Voice(classes, speaker, children) => {
          debug_assert(classes.length() == 2, "voice classes len")
          debug_assert(classes[0] == "loud" && classes[1] == "host", "voice classes")
          debug_assert(speaker == "Alice", "voice speaker")
          // Verify Timestamp node exists inside children
          let mut found_ts = false
          let mut found_ruby = false
          let mut found_lang = false
          let mut i = 0
          while i < children.length() {
            match children[i] {
              CueNode::Timestamp(ms) => {
                debug_assert(ms == 12500L, "inline timestamp 00:12.500")
                found_ts = true
              }
              CueNode::Ruby(_, rchildren) => {
                debug_assert(rchildren.length() == 2, "ruby children")
                found_ruby = true
              }
              CueNode::Lang(_, lang, _) => {
                debug_assert(lang == "en-US", "lang annotation")
                found_lang = true
              }
              _ => ()
            }
            i = i + 1
          }
          debug_assert(found_ts, "must find inline timestamp node")
          debug_assert(found_ruby, "must find ruby node")
          debug_assert(found_lang, "must find lang node")
        }
        _ => debug_assert(false, "expected Voice root node")
      }
      let expected_plain = "Hello world & friends! A < B > C OK 漢かん"
      debug_assert(nodes_to_plain_text(nodes) == expected_plain, "nodes_to_plain_text")
      debug_assert(plain_text(raw) == expected_plain, "fast plain_text matches AST")
    }
    Err(e) => debug_assert(false, "parse_cue_payload failed: " + webvtt_error_to_string(e))
  }
}

///|
test "payload_entities_nbsp_lrm_rlm_and_unknown" {
  let raw = "A&nbsp;B&lrm;C&rlm;D&amp;E&lt;F&gt;G&unknown;H&"
  let expected = "A\xC2\xA0B\xE2\x80\x8EC\xE2\x80\x8FD&E<F>G&unknown;H&"
  debug_assert(plain_text(raw) == expected, "plain_text entities")
  match parse_cue_payload(raw) {
    Ok(nodes) => debug_assert(nodes_to_plain_text(nodes) == expected, "AST entities")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  // Fast path: no '<' or '&'
  let simple = "Plain subtitle line with UTF-8 日本語"
  debug_assert(plain_text(simple) == simple, "fast path no tags/entities")
}

///|
test "payload_unclosed_tags_and_depth_limit" {
  // Unclosed <v> and <b> auto-close gracefully at end of payload
  let unclosed = "<v Bob>Start <b>bold text"
  match parse_cue_payload(unclosed) {
    Ok(nodes) => {
      debug_assert(nodes_to_plain_text(nodes) == "Start bold text", "unclosed plain")
      debug_assert(plain_text(unclosed) == "Start bold text", "unclosed fast plain")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }

  // Deeply nested tags exceeding max_tag_depth must return LimitExceeded
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 20 {
    sb.write_string("<b>")
    i = i + 1
  }
  sb.write_string("deep")
  let deep = sb.to_string()
  match parse_cue_payload_with_limits(deep, 10) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for depth > 10")
    Err(WebVttError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded, got: " + webvtt_error_to_string(e))
  }
}
