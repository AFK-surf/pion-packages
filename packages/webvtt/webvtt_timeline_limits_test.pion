///| High-speed O(log N + K) timeline query tests (overlapping, unsorted, 10k cues) and ParseLimits security tests.

///|
test "timeline_overlapping_and_unsorted_cues" {
  // Deliberately unsorted cues with a long background cue overlapping multiple short cues
  let doc =
  "WEBVTT\n\n" +
  "c2\n00:05.000 --> 00:08.000\nSecond\n\n" +
  "bg\n00:01.000 --> 00:20.000\nBackground banner\n\n" +
  "c1\n00:02.000 --> 00:05.000\nFirst\n\n" +
  "c3\n00:05.000 --> 00:06.000\nSimultaneous\n"

  let track = match parse(doc) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, webvtt_error_to_string(e))
      return
    }
  }

  // Before any cue
  debug_assert(active_cues_at(track, 999L).length() == 0, "t=999 empty")

  // Exact start inclusive
  let at_1000 = active_cues_at(track, 1000L)
  debug_assert(at_1000.length() == 1 && at_1000[0].id == "bg", "t=1000 bg")

  // Overlap bg + c1
  let at_3000 = active_cues_at(track, 3000L)
  debug_assert(at_3000.length() == 2, "t=3000 count=2")

  // Exact end exclusive for c1 (5000), start inclusive for c2 and c3, plus bg
  let at_5000 = active_cues_at(track, 5000L)
  debug_assert(at_5000.length() == 3, "t=5000 count=3 (bg, c2, c3)")

  // At 15000 only bg is active
  let at_15000 = active_cues_at(track, 15000L)
  debug_assert(at_15000.length() == 1 && at_15000[0].id == "bg", "t=15000 only bg")

  // Exact end exclusive for bg (20000)
  debug_assert(active_cues_at(track, 20000L).length() == 0, "t=20000 empty")
}

///|
test "timeline_10000_cues_binary_pruning" {
  let sb = StringBuilder::with_capacity(512000)
  sb.write_string("WEBVTT\n\n")
  let mut i = 0
  while i < 10000 {
    let start_ms = i.to_int64() * 1000L
    let end_ms = start_ms + 2500L
    sb.write_string(format_timestamp(start_ms))
    sb.write_string(" --> ")
    sb.write_string(format_timestamp(end_ms))
    sb.write_string("\nCue #")
    sb.write_string(i.to_string())
    sb.write_string("\n\n")
    i = i + 1
  }
  let track = match parse(sb.to_string()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, webvtt_error_to_string(e))
      return
    }
  }
  debug_assert(track.cues.length() == 10000, "10000 cues parsed")

  // At t = 5000500ms (5000.5s): cues 4999 (4999..5001.5), 5000 (5000..5002.5) are active;
  // cue 4998 ends at 5000.5s (exclusive)
  let act = active_cues_at(track, 5000500L)
  debug_assert(act.length() == 2, "expected 2 active cues at 5000.5s, got " + act.length().to_string())
  debug_assert(act[0].payload == "Cue #4999", "active[0]")
  debug_assert(act[1].payload == "Cue #5000", "active[1]")

  // At t = 5000499ms: cues 4998, 4999, 5000 are active (3 cues)
  let act3 = active_cues_at(track, 5000499L)
  debug_assert(act3.length() == 3, "expected 3 active cues at 5000.499s")
}

///|
test "parse_limits_enforcement" {
  // 1. max_input_bytes
  let lim_bytes = ParseLimits::{
    max_input_bytes: 16,
    max_cues: 100,
    max_styles: 10,
    max_regions: 10,
    max_notes: 10,
    max_tag_depth: 16,
  }
  match parse_with_limits("WEBVTT\n\n00:00.000 --> 00:01.000\nToo long\n", lim_bytes) {
    Err(WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_input_bytes")
  }

  // 2. max_cues
  let lim_cues = ParseLimits::{
    max_input_bytes: 65536,
    max_cues: 1,
    max_styles: 10,
    max_regions: 10,
    max_notes: 10,
    max_tag_depth: 16,
  }
  let two_cues = "WEBVTT\n\n00:00.000 --> 00:01.000\nA\n\n00:01.000 --> 00:02.000\nB\n"
  match parse_with_limits(two_cues, lim_cues) {
    Err(WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_cues")
  }

  // 3. max_styles
  let lim_styles = ParseLimits::{
    max_input_bytes: 65536,
    max_cues: 100,
    max_styles: 1,
    max_regions: 10,
    max_notes: 10,
    max_tag_depth: 16,
  }
  let two_styles = "WEBVTT\n\nSTYLE\n::cue { color: red; }\n\nSTYLE\n::cue { color: blue; }\n"
  match parse_with_limits(two_styles, lim_styles) {
    Err(WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_styles")
  }

  // 4. max_regions
  let lim_regions = ParseLimits::{
    max_input_bytes: 65536,
    max_cues: 100,
    max_styles: 10,
    max_regions: 1,
    max_notes: 10,
    max_tag_depth: 16,
  }
  let two_regions = "WEBVTT\n\nREGION\nid:r1\n\nREGION\nid:r2\n"
  match parse_with_limits(two_regions, lim_regions) {
    Err(WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_regions")
  }
}
