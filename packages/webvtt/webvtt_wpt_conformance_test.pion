///| W3C WebVTT WPT conformance & security regression tests (file-parsing + cue-text-parsing + timeline).

///|
test "wpt_block_boundaries_arrows_and_recovery" {
  // STYLE / REGION / NOTE / garbage blocks terminated by '-->' without blank line
  let doc =
  "WEBVTT\n\n" +
  "STYLE\n::cue { color: red }\n00:01.000 --> 00:02.000\nAfter style\n\n" +
  "REGION\nid:r1 width:40%\n00:02.000 --> 00:03.000 region:r1\nAfter region\n\n" +
  "NOTE comment\nline 2\n00:03.000 --> 00:04.000\nAfter note\n\n" +
  "garbage 1\ngarbage 2\n00:04.000 --> 00:05.000\nAfter garbage\n"
  match parse(doc) {
    Ok(t) => {
      debug_assert(t.styles.length() == 1, "style preserved")
      debug_assert(t.regions.length() == 0, "region after first cue ignored per §6.1")
      debug_assert(t.cues.length() == 4, "all 4 cues survived")
      debug_assert(t.cues[0].payload == "After style", "cue 0")
      debug_assert(t.cues[1].payload == "After region", "cue 1")
      debug_assert(t.cues[2].payload == "After note", "cue 2")
      debug_assert(t.cues[3].payload == "After garbage", "cue 3")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }

  // WPT arrows.html recovery after malformed timing lines
  let arrows =
  "WEBVTT\n\n-->\n00:00:00.000 --> 00:00:01.000\ntext0\n" +
  "foo-->\n00:00:00.000 --> 00:00:01.000\ntext1\n" +
  "00:01.000 --> xx\n00:02.000 --> 00:03.000\ntext2\n"
  match parse_lenient(arrows, ParseLimits::default()) {
    Ok(t) => {
      debug_assert(t.cues.length() == 3, "recovered 3 valid cues")
      debug_assert(t.cues[0].payload == "text0", "text0")
      debug_assert(t.cues[1].payload == "text1", "text1")
      debug_assert(t.cues[2].payload == "text2", "text2")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
}

///|
test "wpt_nul_formfeed_decimal_rounding_and_region_nulling" {
  // NUL -> U+FFFD, form feed whitespace, exact IEEE-754 decimal rounding, u32 lines, region nulling
  let doc =
  "WEBVTT\n\n" +
  "REGION\nid:r\x0Clines:4294967295\n\n" +
  "\x0C0:00:00.000\x0C-->\x0C00:00:01.000\x0Cposition:0.3%\x0Csize:0.7%\x0Cline:0.1\x0Cregion:r\n" +
  "a\x00b\n\n" +
  "00:01.000 --> 00:02.000 region:r\n" +
  "in region\n"
  match parse_lenient(doc, ParseLimits::default()) {
    Ok(t) => {
      debug_assert(t.regions.length() == 1, "region count")
      debug_assert(t.regions[0].lines.to_string() == "4294967295", "u32 max lines")
      debug_assert(t.cues.length() == 2, "2 cues")
      debug_assert(t.cues[0].payload == "a\xEF\xBF\xBDb", "NUL replaced with U+FFFD")
      debug_assert(t.cues[0].settings.size == 0.7, "exact 0.7")
      debug_assert(t.cues[0].settings.region == "", "line/size nulls region")
      debug_assert(t.cues[1].settings.region == "r", "plain region kept")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
}

///|
test "wpt_entities_tree_building_and_cue_order" {
  // Full HTML5 entities (numeric, named, legacy no-semicolon, multi-codepoint)
  debug_assert(
    plain_text("&quot;&#39;&#x41;&copy;&amp&notit;&nsubE;") ==
    "\"'A\xC2\xA9&\xC2\xACit;\xE2\xAB\x85\xCC\xB8",
    "HTML5 character references",
  )

  // Strict current-node closing and <rt> only inside <ruby>
  match parse_cue_payload("<ruby>a<rt><b>b</rt></ruby>c") {
    Ok(nodes) => debug_assert(nodes_to_plain_text(nodes) == "abc", "ruby/rt/b plain")
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
  match parse_cue_payload("<v\n  Alice \t Smith >hi</v>") {
    Ok(nodes) =>
    match nodes[0] {
      CueNode::Voice(_, speaker, _) => debug_assert(speaker == "Alice Smith", "collapsed speaker")
      _ => debug_assert(false, "expected Voice")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }

  // HTML text track cue order: start asc, end desc, index asc
  match parse("WEBVTT\n\n00:00.000 --> 00:01.000\nshort\n\n00:00.000 --> 00:05.000\nlong\n") {
    Ok(t) => {
      let idxs = active_cue_indices_at(t, 500L)
      debug_assert(idxs.length() == 2 && idxs[0] == 1 && idxs[1] == 0, "longer cue first")
    }
    Err(e) => debug_assert(false, webvtt_error_to_string(e))
  }
}
