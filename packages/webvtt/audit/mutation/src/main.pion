///| F4 probe: `WebVttTrack.cues` is a public mutable `Array`, but the timeline index is built once at parse
///| time. After a push / element replacement, `active_cues_at` must neither panic nor return stale results.
///| Exit 0 = consistent with a brute-force scan of the CURRENT cue list. A panic aborts the process (non-zero).
///| If a fix makes the cue list immutable, this file stops compiling; run_audit.sh treats exactly that case
///| (build error located in this file while `packages/webvtt` itself checks clean) as fixed.

import "webvtt"

///|
fn brute(t : webvtt::WebVttTrack, tm : Int64) -> Int {
  let mut k = 0
  let mut i = 0
  while i < t.cues.length() {
    if t.cues[i].start_ms <= tm && tm < t.cues[i].end_ms {
      k = k + 1
    }
    i = i + 1
  }
  k
}

///|
pub fn main(world : World) -> Int {
  let t = match webvtt::parse("WEBVTT\n\n00:00.000 --> 00:01.000\nA\n\n00:05.000 --> 00:06.000\nB\n") {
    Ok(t) => t
    Err(_) => return 3
  }
  let other = match webvtt::parse("WEBVTT\n\n00:10.000 --> 00:11.000\nC\n") {
    Ok(t) => t
    Err(_) => return 3
  }
  // 1. replace an element: cue 0 now lives at 10s..11s
  t.cues[0] = other.cues[0]
  // 2. append: one more copy of cue 1 (5s..6s)
  t.cues.push(t.cues[1])
  let probes : Array[Int64] = [500L, 5500L, 10500L, 0L, 6000L]
  let mut bad = 0
  let mut i = 0
  while i < probes.length() {
    let got = t.active_cues_at(probes[i]).length()
    let want = brute(t, probes[i])
    io_println(
      world,
      "t=" + probes[i].to_string() + " got=" + got.to_string() + " want=" + want.to_string(),
    )
    if got != want {
      bad = bad + 1
    }
    i = i + 1
  }
  if bad == 0 {
    io_println(world, "F4 RESULT: PASS")
    0
  } else {
    io_println(world, "F4 RESULT: FAIL (stale timeline index)")
    1
  }
}
