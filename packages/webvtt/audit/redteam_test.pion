///| Red-team tests for `packages/webvtt` (audit of `origin/feat/pkg-webvtt` @ 3a49f9a).
///|
///| Naming:
///| - `p1_*` / `p2_*`: assert the W3C-conformant / safe behaviour. They FAIL while the defect exists and PASS
///|   once it is fixed. Finding ids (F1..F19) refer to `AUDIT_REPORT.md`.
///| - `ctl_*`: controls on attack surface that was probed and found correct; they must keep PASSING.
///|
///| Spec references are to W3C WebVTT (https://www.w3.org/TR/webvtt1/) §6 "Parsing"; the browser-mode
///| entry point `parse_lenient` is held to the §6.1 parser algorithm, `parse` (strict) to the same block
///| structure (it may reject more, but must never silently drop a valid cue).

import "webvtt"

// ---------------------------------------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------------------------------------

///|
fn lenient(doc : String) -> webvtt::WebVttTrack {
  match webvtt::parse_lenient(doc, webvtt::ParseLimits::default()) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "parse_lenient failed: " + webvtt::webvtt_error_to_string(e))
      panic("unreachable")
    }
  }
}

///|
fn strict(doc : String) -> webvtt::WebVttTrack {
  match webvtt::parse(doc) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "parse failed: " + webvtt::webvtt_error_to_string(e))
      panic("unreachable")
    }
  }
}

///|
fn limits_with_depth(d : Int) -> webvtt::ParseLimits {
  webvtt::ParseLimits::{ ..webvtt::ParseLimits::default(), max_tag_depth: d }
}

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn join_cls(cls : Array[String]) -> String {
  let sb = StringBuilder::with_capacity(16)
  let mut i = 0
  while i < cls.length() {
    sb.write_string(".")
    sb.write_string(cls[i])
    i = i + 1
  }
  sb.to_string()
}

///| Compact S-expression of a payload tree, e.g. `(b (i "x") "y")`.
fn sx(nodes : Array[webvtt::CueNode]) -> String {
  let sb = StringBuilder::with_capacity(64)
  let mut i = 0
  while i < nodes.length() {
    if i > 0 {
      sb.write_string(" ")
    }
    match nodes[i] {
      webvtt::CueNode::Text(t) => sb.write_string("\"" + t + "\"")
      webvtt::CueNode::Timestamp(ms) => sb.write_string("@" + ms.to_string())
      webvtt::CueNode::Bold(c, ch) => sb.write_string("(b" + join_cls(c) + " " + sx(ch) + ")")
      webvtt::CueNode::Italic(c, ch) => sb.write_string("(i" + join_cls(c) + " " + sx(ch) + ")")
      webvtt::CueNode::Underline(c, ch) => sb.write_string("(u" + join_cls(c) + " " + sx(ch) + ")")
      webvtt::CueNode::Class(c, ch) => sb.write_string("(c" + join_cls(c) + " " + sx(ch) + ")")
      webvtt::CueNode::Voice(c, a, ch) =>
      sb.write_string("(v" + join_cls(c) + "[" + a + "] " + sx(ch) + ")")
      webvtt::CueNode::Lang(c, a, ch) =>
      sb.write_string("(lang" + join_cls(c) + "[" + a + "] " + sx(ch) + ")")
      webvtt::CueNode::Ruby(c, ch) => sb.write_string("(ruby" + join_cls(c) + " " + sx(ch) + ")")
      webvtt::CueNode::RubyText(c, ch) => sb.write_string("(rt" + join_cls(c) + " " + sx(ch) + ")")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn tree(payload : String) -> String {
  match webvtt::parse_cue_payload(payload) {
    Ok(n) => sx(n)
    Err(e) => "ERR " + webvtt::webvtt_error_to_string(e)
  }
}

///|
fn expect_str(got : String, want : String, label : String) -> Unit {
  debug_assert(got == want, label + ": expected <" + want + ">, got <" + got + ">")
}

///|
fn expect_int(got : Int, want : Int, label : String) -> Unit {
  debug_assert(got == want, label + ": expected " + want.to_string() + ", got " + got.to_string())
}

///|
fn line_str(l : webvtt::LineSetting) -> String {
  match l {
    webvtt::LineSetting::Auto => "auto"
    webvtt::LineSetting::Percentage(p) => p.to_string() + "%"
    webvtt::LineSetting::LineNumber(n) => n.to_string()
  }
}

///|
fn pos_str(p : webvtt::PositionSetting) -> String {
  match p {
    webvtt::PositionSetting::Auto => "auto"
    webvtt::PositionSetting::Percentage(v) => v.to_string() + "%"
  }
}

///|
fn align_str(a : webvtt::TextAlign) -> String {
  match a {
    webvtt::TextAlign::Start => "start"
    webvtt::TextAlign::Center => "center"
    webvtt::TextAlign::End => "end"
    webvtt::TextAlign::Left => "left"
    webvtt::TextAlign::Right => "right"
  }
}

///|
fn ints_str(a : Array[Int]) -> String {
  let sb = StringBuilder::with_capacity(32)
  sb.write_string("[")
  let mut i = 0
  while i < a.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(a[i].to_string())
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///| Deterministic 64-bit LCG (Knuth MMIX constants); returns a value in `[0, bound)`.
fn lcg_next(state : FixedArray[Int64], bound : Int) -> Int {
  state[0] = state[0] * 6364136223846793005L + 1442695040888963407L
  let x = (state[0] >> 33) & 0x7FFFFFFFL
  (x % bound.to_int64()).to_int()
}

// =========================================================================================================
// P1 — silent cue loss / crash / broken complexity contract
// =========================================================================================================

///| F1: a STYLE block ends at the first line containing `-->` (§6.1 collect-a-block step "Otherwise, let
///| position be previous position and break"): the style sheet collected so far is kept and the `-->` line
///| starts a cue. The package drops the style AND swallows the cue (even in strict `parse`).
test "p1_f1_style_block_then_cue_without_blank_line" {
  let doc = "WEBVTT\n\nSTYLE\n::cue { color: red }\n00:01.000 --> 00:02.000\nHello\n"
  let t = strict(doc)
  expect_int(t.cues.length(), 1, "cue after STYLE body must survive")
  expect_int(t.styles.length(), 1, "STYLE body before the --> line must be kept")
  if t.cues.length() == 1 {
    expect_str(t.cues[0].payload, "Hello", "payload")
  }
  if t.styles.length() == 1 {
    expect_str(t.styles[0], "::cue { color: red }", "style body")
  }
}

///| F1: same for REGION blocks (region kept, cue parsed and still able to reference it).
test "p1_f1_region_block_then_cue_without_blank_line" {
  let doc = "WEBVTT\n\nREGION\nid:r1 width:40%\n00:01.000 --> 00:02.000 region:r1\nHi\n"
  let t = strict(doc)
  expect_int(t.regions.length(), 1, "region before the --> line must be kept")
  expect_int(t.cues.length(), 1, "cue after REGION body must survive")
  if t.cues.length() == 1 {
    expect_str(t.cues[0].settings.region, "r1", "cue region")
  }
}

///| F1: NOTE comments and any other non-cue block also end at a `-->` line (line >= 3).
test "p1_f1_note_and_garbage_blocks_do_not_swallow_following_cue" {
  let t1 = strict("WEBVTT\n\nNOTE a comment\nsecond line\n00:01.000 --> 00:02.000\nAfter note\n")
  expect_int(t1.cues.length(), 1, "cue after NOTE block")
  let t2 = strict("WEBVTT\n\nstray line 1\nstray line 2\n00:01.000 --> 00:02.000\nAfter garbage\n")
  expect_int(t2.cues.length(), 1, "cue after 2-line garbage block")
  if t2.cues.length() == 1 {
    expect_str(t2.cues[0].id, "", "no id carried from garbage")
    expect_str(t2.cues[0].payload, "After garbage", "payload")
  }
}

///| F2: browser-mode recovery. An unparsable timing line only nulls ITS cue; the next `-->` line
///| (line count 2 with seen-arrow set) ends the block and is re-parsed as a new cue (WPT arrows.html: 6 cues).
test "p1_f2_lenient_recovers_after_bad_timing_line" {
  let t = lenient("WEBVTT\n\n00:01.000 --> xx\n00:02.000 --> 00:03.000\nHi\n")
  expect_int(t.cues.length(), 1, "valid cue right after a bad timing line")
  if t.cues.length() == 1 {
    debug_assert(t.cues[0].start_ms == 2000L, "start of recovered cue")
    expect_str(t.cues[0].payload, "Hi", "payload of recovered cue")
  }
  let t2 = lenient(
    "WEBVTT\n\n-->\n00:00:00.000 --> 00:00:01.000\ntext0\nfoo-->\n00:00:00.000 --> 00:00:01.000\ntext1\n",
  )
  expect_int(t2.cues.length(), 2, "WPT arrows.html prefix")
}

// =========================================================================================================
// P2 — conformance divergences, numeric precision, DoS amplification, API/contract issues
// =========================================================================================================

///| F3: §6.3 does not reject end < start; browsers keep the cue (WPT timings-negative.html). Single-digit
///| hours are accepted by the §6.3 timestamp algorithm ("string not exactly two characters -> hours";
///| WPT timings-too-short.html cue 0). `parse_lenient` is documented as browser-lenient.
test "p2_f3_lenient_keeps_inverted_and_single_digit_hour_cues" {
  let t = lenient("WEBVTT\n\n00:00:01.000 --> 00:00:00.999\ninv\n")
  expect_int(t.cues.length(), 1, "inverted cue kept in browser mode")
  let t2 = lenient("WEBVTT\n\n0:00:00.000 --> 00:00:01.000\none-digit hour\n")
  expect_int(t2.cues.length(), 1, "single-digit hour accepted in browser mode")
}

///| F5: `ParseLimits.max_tag_depth` is never read by the parser; `Cue::parse_payload` always uses 64.
///| Either `parse_with_limits` must reject the cue, or the cue's own `parse_payload` must honour the limit;
///| and a raised limit must actually allow deeper (bounded) markup.
test "p2_f5_parse_limits_max_tag_depth_is_honoured" {
  let deep3 = "WEBVTT\n\n00:00.000 --> 00:01.000\n<b><i><u>x</u></i></b>\n"
  match webvtt::parse_with_limits(deep3, limits_with_depth(2)) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "unexpected error " + webvtt::webvtt_error_to_string(e))
    Ok(t) =>
    match t.cues[0].parse_payload() {
      Err(webvtt::WebVttError::LimitExceeded(_)) => ()
      _ => debug_assert(false, "max_tag_depth=2 ignored: depth-3 payload accepted")
    }
  }
  let deep100 = "WEBVTT\n\n00:00.000 --> 00:01.000\n" + rep("<b>", 100) + "x\n"
  match webvtt::parse_with_limits(deep100, limits_with_depth(200)) {
    Err(e) => debug_assert(false, "depth 100 under limit 200 rejected: " + webvtt::webvtt_error_to_string(e))
    Ok(t) =>
    match t.cues[0].parse_payload() {
      Ok(_) => ()
      Err(e) =>
      debug_assert(false, "max_tag_depth=200 ignored by parse_payload: " + webvtt::webvtt_error_to_string(e))
    }
  }
}

///| F6: §6.4 tokenizer "consume an HTML character reference": numeric references, the full named table and
///| legacy no-semicolon forms (WPT cue-text-parsing entities.dat: 12/25 fail).
test "p2_f6_html_character_references" {
  expect_str(webvtt::plain_text("&quot;&#39;&#x41;&copy;&amp"), "\"'A\xC2\xA9&", "plain_text")
  expect_str(tree("a&#32;b"), "\"a b\"", "tree numeric ref")
}

///| F7: §6.4 end tags only close the CURRENT node (otherwise ignored); `<rt>` only opens inside `<ruby>`
///| (WPT tree-building.dat #5-#9, tags.dat #20).
test "p2_f7_end_tag_and_rt_tree_building" {
  expect_str(tree("<b><i>x</b></i>y"), "(b (i \"x\") \"y\")", "mis-nested end tag ignored")
  expect_str(tree("<rt>test"), "\"test\"", "rt outside ruby ignored")
  expect_str(
    tree("<ruby>a<rt><b>b</rt></ruby>c"),
    "(ruby \"a\" (rt (b \"b\" \"c\")))",
    "WPT tree-building #5",
  )
}

///| F8: §6.1 preprocessing replaces every U+0000 by U+FFFD (WPT nulls.html, text.dat#2).
test "p2_f8_nul_replaced_by_u_fffd" {
  let t = lenient("WEBVTT\n\n00:00.000 --> 00:01.000\na\x00b\n")
  expect_str(t.cues[0].payload, "a\xEF\xBF\xBDb", "NUL in payload")
}

///| F9: numbers must be parsed with the HTML "rules for parsing floating-point number values"
///| (correctly rounded; out-of-range = error -> setting ignored). The package accumulates `digit * 0.1^k`.
test "p2_f9_decimal_parsing_is_correctly_rounded_and_range_checked" {
  let t = lenient(
    "WEBVTT\n\n00:00.000 --> 00:01.000 position:0.3% size:0.7% line:0.1\nx\n\n" +
    "00:00.000 --> 00:01.000 line:" +
    rep("9", 350) +
    "\ny\n",
  )
  expect_str(pos_str(t.cues[0].settings.position), "0.3%", "position:0.3%")
  debug_assert(t.cues[0].settings.size == 0.7, "size:0.7% got " + t.cues[0].settings.size.to_string())
  expect_str(line_str(t.cues[0].settings.line), "0.1", "line:0.1")
  expect_str(line_str(t.cues[1].settings.line), "auto", "line:9{350} overflows -> ignored, not inf")
}

///| F10: "skip whitespace"/"split on spaces" use ASCII whitespace, which includes U+000C FORM FEED
///| (WPT whitespace-chars.html, header-regions.html cue 10).
test "p2_f10_form_feed_is_ascii_whitespace" {
  let t = lenient("WEBVTT\n\n\x0C00:00:00.000\x0C-->\x0C00:00:01.000\x0Calign:start\ntext\n")
  expect_int(t.cues.length(), 1, "timing line with form feeds")
  if t.cues.length() == 1 {
    expect_str(align_str(t.cues[0].settings.align), "start", "align after form feed")
  }
}

///| F11: region `lines` is an unsigned long in VTTRegion; `lines:4294967295` is valid (WPT regions-lines.html).
test "p2_f11_region_lines_full_unsigned_range" {
  let t = lenient("WEBVTT\n\nREGION\nid:r lines:4294967295\n\n00:00.000 --> 00:01.000 region:r\nx\n")
  expect_str(t.regions[0].lines.to_string(), "4294967295", "lines")
}

///| F12: `align:middle` is not a valid value (§6.3 lists start/center/end/left/right): it must be ignored,
///| keeping the earlier `align:end` (WPT settings-align.html cue 10).
test "p2_f12_align_middle_is_ignored" {
  let t = lenient("WEBVTT\n\n00:00.000 --> 00:01.000 align:end align:middle\nx\n")
  expect_str(align_str(t.cues[0].settings.align), "end", "align")
}

///| F13: §6.3: `region:` resolves to an existing region or null; a following `vertical:rl|lr`, non-auto
///| `line:` or `size:` != 100 sets the cue's region to null. The package keeps the raw id in all cases.
test "p2_f13_cue_region_resolution_and_nulling" {
  let t = lenient(
    "WEBVTT\n\nREGION\nid:fred\n\n" +
    "00:00.000 --> 00:01.000 region:fred line:0\na\n\n" +
    "00:00.000 --> 00:01.000 region:fred size:50%\nb\n\n" +
    "00:00.000 --> 00:01.000 region:fred vertical:rl\nc\n\n" +
    "00:00.000 --> 00:01.000 region:nosuch\nd\n\n" +
    "00:00.000 --> 00:01.000 region:fred\ne\n",
  )
  expect_str(t.cues[0].settings.region, "", "line:0 drops region")
  expect_str(t.cues[1].settings.region, "", "size:50% drops region")
  expect_str(t.cues[2].settings.region, "", "vertical:rl drops region")
  expect_str(t.cues[3].settings.region, "", "unknown region id -> null")
  expect_str(t.cues[4].settings.region, "fred", "plain region reference")
}

///| F14: results are documented as "in cue order"; HTML "text track cue order" sorts by start ascending,
///| then END DESCENDING, then insertion order. Ties on start are returned by index instead.
test "p2_f14_active_cues_follow_text_track_cue_order" {
  let t = strict("WEBVTT\n\n00:00.000 --> 00:01.000\nshort\n\n00:00.000 --> 00:05.000\nlong\n")
  expect_str(ints_str(webvtt::active_cue_indices_at(t, 500L)), "[1,0]", "longer cue first")
}

///| F15: annotation: leading/trailing ASCII whitespace removed and inner runs collapsed to one space;
///| LF / FF / TAB after the tag name start the annotation (§6.4 tag state).
test "p2_f15_annotation_whitespace" {
  expect_str(tree("<v  Bob \t Smith >x</v>"), "(v[Bob Smith] \"x\")", "collapse")
  expect_str(tree("<v\nBob>x</v>"), "(v[Bob] \"x\")", "LF after tag name")
}

// =========================================================================================================
// Controls (probed, behaving correctly; must keep passing)
// =========================================================================================================

///|
test "ctl_signature_edges" {
  let bad : Array[String] = [
    "", "\xEF\xBB\xBF", "WEBVTTX", "WEBVTT-", "\xEF\xBB\xBF\xEF\xBB\xBFWEBVTT", "WEBVT", "webvtt",
  ]
  let mut i = 0
  while i < bad.length() {
    match webvtt::parse(bad[i]) {
      Err(webvtt::WebVttError::InvalidHeader(_)) => ()
      _ => debug_assert(false, "signature case " + i.to_string() + " must be InvalidHeader")
    }
    match webvtt::parse_lenient(bad[i], webvtt::ParseLimits::default()) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "lenient signature case " + i.to_string() + " must fail")
    }
    i = i + 1
  }
  expect_int(strict("WEBVTT").cues.length(), 0, "bare WEBVTT")
  expect_int(strict("\xEF\xBB\xBFWEBVTT").cues.length(), 0, "BOM + bare WEBVTT")
  expect_str(strict("WEBVTT\tTitle here \r\n").header_title, "Title here", "tab title, CRLF")
  expect_str(strict("WEBVTT Title\r").header_title, "Title", "space title, lone CR")
  let t = strict("WEBVTT\r\n\r00:00.000 --> 00:01.000\rA\r\nB\nC\r\n\r\nD\n")
  expect_int(t.cues.length(), 1, "mixed CR / CRLF / LF")
  expect_str(t.cues[0].payload, "A\nB\nC", "mixed newline normalisation")
}

///|
test "ctl_note_variants" {
  let t = strict("WEBVTT\n\nNOTES\n00:01.000 --> 00:02.000\nnot a note\n\nNOTE\tinline tab\n\nNOTE\n\n")
  expect_int(t.cues.length(), 1, "NOTES is a cue id, not a NOTE")
  expect_str(t.cues[0].id, "NOTES", "cue id")
  expect_int(t.notes.length(), 2, "NOTE<TAB> and bare NOTE")
  expect_str(t.notes[0], "inline tab", "inline NOTE text")
}

///|
test "ctl_style_and_region_after_first_cue_are_ignored" {
  let t = strict(
    "WEBVTT\n\n00:00.000 --> 00:01.000\nA\n\nSTYLE\n::cue { color: red }\n\nREGION\nid:late\n\n00:01.000 --> 00:02.000\nB\n",
  )
  expect_int(t.styles.length(), 0, "late STYLE")
  expect_int(t.regions.length(), 0, "late REGION")
  expect_int(t.cues.length(), 2, "both cues")
}

///|
test "ctl_region_malformed_parameters_keep_defaults" {
  let t = strict(
    "WEBVTT\n\nREGION\nid:r lines:-1 width:150% scroll:down regionanchor:101%,0% viewportanchor:50% width:-1% lines:1.5\n\n" +
    "REGION\nid:dup width:10%\n\nREGION\nid:dup width:20%\n",
  )
  let r = match t.get_region("r") {
    Some(r) => r
    None => {
      debug_assert(false, "region r missing")
      return
    }
  }
  expect_int(r.lines, 3, "lines default")
  debug_assert(r.width == 100.0, "width default")
  debug_assert(r.region_anchor.x == 0.0 && r.region_anchor.y == 100.0, "regionanchor default")
  debug_assert(r.viewport_anchor.x == 0.0 && r.viewport_anchor.y == 100.0, "viewportanchor default")
  match r.scroll {
    webvtt::RegionScroll::None => ()
    _ => debug_assert(false, "scroll default")
  }
  match t.get_region("dup") {
    Some(d) => debug_assert(d.width == 20.0, "last dup wins")
    None => debug_assert(false, "dup region missing")
  }
}

///|
test "ctl_timestamp_edges" {
  let ok_cases : Array[String] = ["00:00.000", "59:59.999", "00:00:00.000", "100:00:00.000", "2500000:00:00.000"]
  let ok_ms : Array[Int64] = [0L, 3599999L, 0L, 360000000L, 9000000000000L]
  let mut i = 0
  while i < ok_cases.length() {
    match webvtt::parse_timestamp(ok_cases[i]) {
      Ok(ms) => debug_assert(ms == ok_ms[i], "value of " + ok_cases[i])
      Err(_) => debug_assert(false, "should accept " + ok_cases[i])
    }
    i = i + 1
  }
  let bad : Array[String] = [
    "60:00.000", "00:60.000", "00:00:60.000", "00:60:00.000", "00:00.00", "00:00.0000", "000:00.000",
    "-00:00.000", " 00:00.000", "00:00.000 ", "00:00.000x", "00:00,000", "99999999999999999999:00:00.000",
    "2562047788016:00:00.000", "", "00:00.", "0a:00.000",
  ]
  i = 0
  while i < bad.length() {
    match webvtt::parse_timestamp(bad[i]) {
      Ok(ms) => debug_assert(false, "should reject <" + bad[i] + "> got " + ms.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
  expect_str(webvtt::format_timestamp(9000000000000L), "2500000:00:00.000", "format huge")
  expect_str(webvtt::format_timestamp(-5L), "00:00:00.000", "format negative clamps")
}

///|
test "ctl_timing_lines_strict_and_lenient" {
  match webvtt::parse("WEBVTT\n\n00:02.000 --> 00:01.000\nx\n") {
    Err(webvtt::WebVttError::InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "strict rejects inverted")
  }
  let t = strict("WEBVTT\n\n00:01.000-->00:02.000\nno spaces\n\ncue-id\n00:02.000 --> 00:02.000\nzero\n")
  expect_int(t.cues.length(), 2, "arrow without spaces + zero duration")
  let t2 = strict("WEBVTT\n00:00.000 --> 00:01.000\nA\n00:01.000 --> 00:02.000\nB\n")
  expect_int(t2.cues.length(), 2, "header and adjacent cues without blank lines")
}

///|
test "ctl_cue_settings_values" {
  let t = strict(
    "WEBVTT\n\n00:00.000 --> 00:01.000 vertical:lr line:-3,end position:100%,line-right size:0% align:left region:a\nx\n\n" +
    "00:00.000 --> 00:01.000 vertical:up line:50%,bogus position:101% size:100.5% align:CENTER : foo: :bar\ny\n\n" +
    "00:00.000 --> 00:01.000 line:1. line:.5 line:-- line:1-2 position:-1% size:-1%\nz\n",
  )
  let a = t.cues[0].settings
  match a.vertical {
    webvtt::VerticalDirection::LeftToRight => ()
    _ => debug_assert(false, "vertical lr")
  }
  expect_str(line_str(a.line), "-3", "line -3")
  match a.line_align {
    webvtt::LineAlign::End => ()
    _ => debug_assert(false, "line align end")
  }
  expect_str(pos_str(a.position), "100%", "position 100%")
  debug_assert(a.size == 0.0, "size 0")
  expect_str(align_str(a.align), "left", "align left")
  let b = t.cues[1].settings
  match b.vertical {
    webvtt::VerticalDirection::Horizontal => ()
    _ => debug_assert(false, "vertical:up ignored")
  }
  expect_str(line_str(b.line), "auto", "bad line align ignores whole setting")
  expect_str(pos_str(b.position), "auto", "position 101% ignored")
  debug_assert(b.size == 100.0, "size 100.5% ignored")
  expect_str(align_str(b.align), "center", "CENTER is case-sensitive")
  let c = t.cues[2].settings
  expect_str(line_str(c.line), "auto", "malformed line numbers ignored")
  expect_str(pos_str(c.position), "auto", "negative position ignored")
  debug_assert(c.size == 100.0, "negative size ignored")
}

///|
test "ctl_payload_hostile_markup" {
  expect_str(tree("a < b"), "\"a \"", "unclosed < swallows rest (spec tag state to EOF)")
  expect_str(tree("<c.a<b>hi</c>"), "(c.a<b \"hi\")", "nested < inside class")
  expect_str(tree("<script>x</script>"), "\"x\"", "unknown tags dropped, text kept")
  expect_str(tree("<v Speaker &amp; Co>t</v>"), "(v[Speaker & Co] \"t\")", "annotation entity")
  expect_str(webvtt::plain_text("&am&zzz;&"), "&am&zzz;&", "truncated / unknown entities")
  expect_str(webvtt::plain_text("字幕&amp;😀<b>漢</b>"), "字幕&😀漢", "multi-byte passthrough")
  expect_str(tree("<00:00:01.500>x<1:00.000>"), "@1500 \"x\"", "inline timestamp tags")
  expect_str(tree("<b><i>x"), "(b (i \"x\"))", "auto-close at end")
}

///|
test "ctl_tag_depth_bomb_returns_limit_exceeded" {
  let bomb = rep("<b>", 5000) + "x"
  match webvtt::parse_cue_payload(bomb) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "5000 nested <b> must hit the default depth limit")
  }
  let t = strict("WEBVTT\n\n00:00.000 --> 00:01.000\n" + bomb + "\n")
  match t.cues[0].parse_payload() {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "Cue::parse_payload bomb")
  }
  expect_str(t.cues[0].plain_text(), "x", "plain_text of bomb is linear and correct")
  match webvtt::parse_cue_payload_with_limits("<b>x", -1) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative depth limit fails closed")
  }
}

///|
test "ctl_negative_limits_fail_closed" {
  let neg_bytes = webvtt::ParseLimits::{ ..webvtt::ParseLimits::default(), max_input_bytes: -1 }
  match webvtt::parse_with_limits("WEBVTT", neg_bytes) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_input_bytes=-1")
  }
  let neg_cues = webvtt::ParseLimits::{
    ..webvtt::ParseLimits::default(),
    max_cues: -1,
    max_styles: -1,
    max_regions: -1,
    max_notes: -1,
  }
  match webvtt::parse_with_limits("WEBVTT\n\n00:00.000 --> 00:01.000\nx\n", neg_cues) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_cues=-1")
  }
  match webvtt::parse_with_limits("WEBVTT\n\nNOTE x\n", neg_cues) {
    Err(webvtt::WebVttError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_notes=-1")
  }
}

///| Randomised: `plain_text(p) == nodes_to_plain_text(parse_payload(p))` (fast path vs AST path).
test "ctl_plain_text_matches_ast_fuzz" {
  let alphabet : Array[String] = [
    "<b>", "</b>", "<i>", "</i>", "<u>", "</u>", "<c.a.b>", "</c>", "<v A &amp; B>", "</v>", "<lang en>", "</lang>",
    "<ruby>", "</ruby>", "<rt>", "</rt>", "<", ">", "&", "&amp;", "&lt;", "&gt;", "&nbsp;", "&am", "&lrm;", "x", " ",
    "\n", "字", "😀", "<00:01.000>", "<1x>", "</>", "<.>", "<script>", "\t",
  ]
  let st : FixedArray[Int64] = FixedArray::make(1, 0x5EEDL)
  let mut k = 0
  while k < 4000 {
    let len = lcg_next(st, 24)
    let sb = StringBuilder::with_capacity(64)
    let mut j = 0
    while j < len {
      sb.write_string(alphabet[lcg_next(st, alphabet.length())])
      j = j + 1
    }
    let p = sb.to_string()
    match webvtt::parse_cue_payload_with_limits(p, 1000) {
      Ok(nodes) => {
        let a = webvtt::plain_text(p)
        let b = webvtt::nodes_to_plain_text(nodes)
        debug_assert(a == b, "case " + k.to_string() + " <" + p + ">: plain <" + a + "> vs ast <" + b + ">")
      }
      Err(e) => debug_assert(false, "parse failed: " + webvtt::webvtt_error_to_string(e))
    }
    k = k + 1
  }
}

///| Randomised: the `prefix_max_end` pruning never misses an active cue (unsorted input, long early cues
///| covering many later short ones, zero-length cues, boundaries). Compared as index SETS with brute force.
test "ctl_timeline_matches_bruteforce_fuzz" {
  let st : FixedArray[Int64] = FixedArray::make(1, 0xC0FFEEL)
  let mut round = 0
  while round < 60 {
    let n = 1 + lcg_next(st, 120)
    let sb = StringBuilder::with_capacity(n * 40)
    sb.write_string("WEBVTT\n\n")
    let mut i = 0
    while i < n {
      let s = lcg_next(st, 20000).to_int64()
      let kind = lcg_next(st, 10)
      let d = if kind == 0 {
        0L
      } else if kind == 1 {
        200000L
      } else {
        lcg_next(st, 3000).to_int64()
      }
      sb.write_string(webvtt::format_timestamp(s) + " --> " + webvtt::format_timestamp(s + d) + "\nc\n\n")
      i = i + 1
    }
    let t = strict(sb.to_string())
    let mut q = 0
    while q < 80 {
      let tm = if q == 0 {
        -1L
      } else if q == 1 {
        9223372036854775807L
      } else if q < 20 {
        t.cues[lcg_next(st, n)].start_ms
      } else if q < 40 {
        t.cues[lcg_next(st, n)].end_ms
      } else {
        lcg_next(st, 230000).to_int64()
      }
      let got = webvtt::active_cue_indices_at(t, tm)
      let mark = FixedArray::make(n, false)
      let mut g = 0
      while g < got.length() {
        debug_assert(!mark[got[g]], "duplicate index")
        mark[got[g]] = true
        g = g + 1
      }
      let mut c = 0
      while c < n {
        let want = t.cues[c].start_ms <= tm && tm < t.cues[c].end_ms
        debug_assert(
          want == mark[c],
          "round " + round.to_string() + " t=" + tm.to_string() + " cue " + c.to_string() + " want=" +
          want.to_string(),
        )
        c = c + 1
      }
      expect_int(t.active_cues_at(tm).length(), got.length(), "active_cues_at vs indices")
      q = q + 1
    }
    round = round + 1
  }
}
