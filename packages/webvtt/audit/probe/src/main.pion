///| Red-team probe driver for `packages/webvtt` (audit only; never part of the package).
///|
///| Modes (one JSON object per input file on stdout, one per line):
///| - `track <file>...`   : `parse_lenient` (browser mode) -> cues mapped to VTTCue-like fields + regions.
///| - `strict <file>...`  : same with `parse` (strict mode).
///| - `cuetext <file>...` : first cue's payload tree serialized exactly like WPT `cue-text-parsing/common.js`.
///| - `parse <file>`      : parse only, prints the cue count (process-level timing probe).
///| - `timeline <file> <queries>` : parse once, run `<queries>` evenly spread `active_cue_indices_at` calls.
///| - `deep <n> <target>` : builds `<b>` x n, parses with `max_tag_depth = n + 1`, then flattens (stack probe).

import "webvtt"

///|
fn hex_digit(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    87 + v
  }
}

///|
fn json_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 {
      sb.write_byte((92).to_byte())
      sb.write_byte(b.to_byte())
    } else if b < 32 {
      sb.write_string("\\u00")
      sb.write_byte(hex_digit(b / 16).to_byte())
      sb.write_byte(hex_digit(b % 16).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///| JSON number; non-finite values are emitted as strings the harness maps back.
fn json_num(sb : StringBuilder, d : Double) -> Unit {
  if d != d {
    sb.write_string("\"NaN\"")
  } else if d > 1.7976931348623157e308 {
    sb.write_string("\"Infinity\"")
  } else if d < -1.7976931348623157e308 {
    sb.write_string("\"-Infinity\"")
  } else {
    sb.write_string(d.to_string())
  }
}

///|
fn region_json(sb : StringBuilder, r : webvtt::Region) -> Unit {
  sb.write_string("{\"id\":")
  json_str(sb, r.id)
  sb.write_string(",\"width\":")
  json_num(sb, r.width)
  sb.write_string(",\"lines\":")
  sb.write_string(r.lines.to_string())
  sb.write_string(",\"regionAnchorX\":")
  json_num(sb, r.region_anchor.x)
  sb.write_string(",\"regionAnchorY\":")
  json_num(sb, r.region_anchor.y)
  sb.write_string(",\"viewportAnchorX\":")
  json_num(sb, r.viewport_anchor.x)
  sb.write_string(",\"viewportAnchorY\":")
  json_num(sb, r.viewport_anchor.y)
  sb.write_string(",\"scroll\":")
  match r.scroll {
    webvtt::RegionScroll::Up => sb.write_string("\"up\"")
    webvtt::RegionScroll::None => sb.write_string("\"\"")
  }
  sb.write_string("}")
}

///|
fn cue_json(sb : StringBuilder, c : webvtt::Cue) -> Unit {
  let st = c.settings
  sb.write_string("{\"id\":")
  json_str(sb, c.id)
  sb.write_string(",\"start_ms\":")
  sb.write_string(c.start_ms.to_string())
  sb.write_string(",\"end_ms\":")
  sb.write_string(c.end_ms.to_string())
  sb.write_string(",\"text\":")
  json_str(sb, c.payload)
  sb.write_string(",\"vertical\":")
  match st.vertical {
    webvtt::VerticalDirection::Horizontal => sb.write_string("\"\"")
    webvtt::VerticalDirection::RightToLeft => sb.write_string("\"rl\"")
    webvtt::VerticalDirection::LeftToRight => sb.write_string("\"lr\"")
  }
  match st.line {
    webvtt::LineSetting::Auto => sb.write_string(",\"line\":\"auto\",\"snapToLines\":true")
    webvtt::LineSetting::Percentage(p) => {
      sb.write_string(",\"line\":")
      json_num(sb, p)
      sb.write_string(",\"snapToLines\":false")
    }
    webvtt::LineSetting::LineNumber(p) => {
      sb.write_string(",\"line\":")
      json_num(sb, p)
      sb.write_string(",\"snapToLines\":true")
    }
  }
  sb.write_string(",\"lineAlign\":")
  match st.line_align {
    webvtt::LineAlign::Auto => sb.write_string("\"auto\"")
    webvtt::LineAlign::Start => sb.write_string("\"start\"")
    webvtt::LineAlign::Center => sb.write_string("\"center\"")
    webvtt::LineAlign::End => sb.write_string("\"end\"")
  }
  sb.write_string(",\"position\":")
  match st.position {
    webvtt::PositionSetting::Auto => sb.write_string("\"auto\"")
    webvtt::PositionSetting::Percentage(p) => json_num(sb, p)
  }
  sb.write_string(",\"positionAlign\":")
  match st.position_align {
    webvtt::PositionAlign::Auto => sb.write_string("\"auto\"")
    webvtt::PositionAlign::LineLeft => sb.write_string("\"line-left\"")
    webvtt::PositionAlign::Center => sb.write_string("\"center\"")
    webvtt::PositionAlign::LineRight => sb.write_string("\"line-right\"")
  }
  sb.write_string(",\"size\":")
  json_num(sb, st.size)
  sb.write_string(",\"align\":")
  match st.align {
    webvtt::TextAlign::Start => sb.write_string("\"start\"")
    webvtt::TextAlign::Center => sb.write_string("\"center\"")
    webvtt::TextAlign::End => sb.write_string("\"end\"")
    webvtt::TextAlign::Left => sb.write_string("\"left\"")
    webvtt::TextAlign::Right => sb.write_string("\"right\"")
  }
  sb.write_string(",\"region\":")
  json_str(sb, st.region)
  sb.write_string("}")
}

///|
fn track_json(sb : StringBuilder, file : String, t : webvtt::WebVttTrack) -> Unit {
  sb.write_string("{\"file\":")
  json_str(sb, file)
  sb.write_string(",\"ok\":true,\"styles\":")
  sb.write_string(t.styles.length().to_string())
  sb.write_string(",\"regions\":[")
  let mut i = 0
  while i < t.regions.length() {
    if i > 0 {
      sb.write_string(",")
    }
    region_json(sb, t.regions[i])
    i = i + 1
  }
  sb.write_string("],\"cues\":[")
  i = 0
  while i < t.cues.length() {
    if i > 0 {
      sb.write_string(",")
    }
    cue_json(sb, t.cues[i])
    i = i + 1
  }
  sb.write_string("]}")
}

///|
fn err_json(sb : StringBuilder, file : String, msg : String) -> Unit {
  sb.write_string("{\"file\":")
  json_str(sb, file)
  sb.write_string(",\"ok\":false,\"err\":")
  json_str(sb, msg)
  sb.write_string("}")
}

///|
fn indent(sb : StringBuilder, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    sb.write_byte((32).to_byte())
    i = i + 1
  }
}

///|
fn join_classes(cls : Array[String]) -> String {
  let sb = StringBuilder::with_capacity(16)
  let mut i = 0
  while i < cls.length() {
    if i > 0 {
      sb.write_byte((32).to_byte())
    }
    sb.write_string(cls[i])
    i = i + 1
  }
  sb.to_string()
}

///| Element line + sorted attributes (`class` < `lang` < `title`), then children, WPT `test_serializer` layout.
fn ser_elem(
  sb : StringBuilder,
  depth : Int,
  name : String,
  cls : Array[String],
  lang : Option[String],
  title : Option[String],
  ch : Array[webvtt::CueNode],
) -> Unit {
  sb.write_string("\n|")
  indent(sb, depth * 2 - 1)
  sb.write_string("<" + name + ">")
  if cls.length() > 0 {
    sb.write_string("\n|")
    indent(sb, depth * 2 + 1)
    sb.write_string("class=\"" + join_classes(cls) + "\"")
  }
  match lang {
    Some(l) => {
      sb.write_string("\n|")
      indent(sb, depth * 2 + 1)
      sb.write_string("lang=\"" + l + "\"")
    }
    None => ()
  }
  match title {
    Some(t) => {
      sb.write_string("\n|")
      indent(sb, depth * 2 + 1)
      sb.write_string("title=\"" + t + "\"")
    }
    None => ()
  }
  ser_nodes(sb, depth + 1, ch)
}

///|
fn ser_nodes(sb : StringBuilder, depth : Int, nodes : Array[webvtt::CueNode]) -> Unit {
  let mut i = 0
  while i < nodes.length() {
    match nodes[i] {
      webvtt::CueNode::Text(t) => {
        sb.write_string("\n|")
        indent(sb, depth * 2 - 1)
        sb.write_string("\"" + t + "\"")
      }
      webvtt::CueNode::Timestamp(ms) => {
        sb.write_string("\n|")
        indent(sb, depth * 2 - 1)
        sb.write_string("<?timestamp " + webvtt::format_timestamp(ms) + ">")
      }
      webvtt::CueNode::Bold(c, ch) => ser_elem(sb, depth, "b", c, None, None, ch)
      webvtt::CueNode::Italic(c, ch) => ser_elem(sb, depth, "i", c, None, None, ch)
      webvtt::CueNode::Underline(c, ch) => ser_elem(sb, depth, "u", c, None, None, ch)
      webvtt::CueNode::Class(c, ch) => ser_elem(sb, depth, "span", c, None, None, ch)
      webvtt::CueNode::Voice(c, a, ch) => ser_elem(sb, depth, "span", c, None, Some(a), ch)
      webvtt::CueNode::Lang(c, a, ch) => ser_elem(sb, depth, "span", c, Some(a), None, ch)
      webvtt::CueNode::Ruby(c, ch) => ser_elem(sb, depth, "ruby", c, None, None, ch)
      webvtt::CueNode::RubyText(c, ch) => ser_elem(sb, depth, "rt", c, None, None, ch)
    }
    i = i + 1
  }
}

///|
fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn read_or_report(world : World, path : String) -> Option[String] {
  match fs_read(world, path) {
    Ok(s) => Some(s)
    Err(_) => {
      let sb = StringBuilder::with_capacity(64)
      err_json(sb, path, "io: cannot read file")
      io_println(world, sb.to_string())
      None
    }
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: probe track|strict|cuetext|parse|timeline|deep ...")
    return 2
  }
  let mode = args[1]
  if mode == "track" || mode == "strict" || mode == "cuetext" {
    let mut fi = 2
    while fi < args.length() {
      let path = args[fi]
      fi = fi + 1
      let content = match read_or_report(world, path) {
        Some(s) => s
        None => continue
      }
      let res = if mode == "strict" {
        webvtt::parse(content)
      } else {
        webvtt::parse_lenient(content, webvtt::ParseLimits::default())
      }
      let sb = StringBuilder::with_capacity(256)
      match res {
        Err(e) => err_json(sb, path, webvtt::webvtt_error_to_string(e))
        Ok(t) =>
        if mode == "cuetext" {
          if t.cues.length() == 0 {
            err_json(sb, path, "no cue")
          } else {
            match t.cues[0].parse_payload() {
              Err(e) => err_json(sb, path, webvtt::webvtt_error_to_string(e))
              Ok(nodes) => {
                let tree = StringBuilder::with_capacity(128)
                tree.write_string("#document-fragment")
                ser_nodes(tree, 1, nodes)
                sb.write_string("{\"file\":")
                json_str(sb, path)
                sb.write_string(",\"ok\":true,\"tree\":")
                json_str(sb, tree.to_string())
                sb.write_string(",\"plain\":")
                json_str(sb, t.cues[0].plain_text())
                sb.write_string(",\"tree_plain\":")
                json_str(sb, webvtt::nodes_to_plain_text(nodes))
                sb.write_string("}")
              }
            }
          }
        } else {
          track_json(sb, path, t)
        }
      }
      io_println(world, sb.to_string())
    }
    return 0
  }
  if mode == "parse" {
    let content = match read_or_report(world, args[2]) {
      Some(s) => s
      None => return 1
    }
    match webvtt::parse_lenient(content, webvtt::ParseLimits::default()) {
      Ok(t) =>
      io_println(
        world,
        "cues=" + t.cues.length().to_string() + " regions=" + t.regions.length().to_string(),
      )
      Err(e) => io_println(world, "error=" + webvtt::webvtt_error_to_string(e))
    }
    return 0
  }
  if mode == "timeline" {
    let content = match read_or_report(world, args[2]) {
      Some(s) => s
      None => return 1
    }
    let queries = parse_pos_int(args[3])
    let track = match webvtt::parse_lenient(content, webvtt::ParseLimits::default()) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "error=" + webvtt::webvtt_error_to_string(e))
        return 1
      }
    }
    let nc = track.cues.length()
    let mut max_t = 1L
    let mut ci = 0
    while ci < nc {
      if track.cues[ci].end_ms > max_t {
        max_t = track.cues[ci].end_ms
      }
      ci = ci + 1
    }
    let mut hits = 0L
    let mut q = 0
    while q < queries {
      let t = max_t * q.to_int64() / queries.to_int64()
      hits = hits + webvtt::active_cue_indices_at(track, t).length().to_int64()
      q = q + 1
    }
    io_println(world, "cues=" + nc.to_string() + " hits=" + hits.to_string())
    return 0
  }
  if mode == "payloads" {
    let content = match read_or_report(world, args[2]) {
      Some(s) => s
      None => return 1
    }
    let track = match webvtt::parse_lenient(content, webvtt::ParseLimits::default()) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "error=" + webvtt::webvtt_error_to_string(e))
        return 1
      }
    }
    let mut ok = 0
    let mut limited = 0
    let mut plain_bytes = 0
    let mut ci = 0
    while ci < track.cues.length() {
      match track.cues[ci].parse_payload() {
        Ok(_) => ok = ok + 1
        Err(_) => limited = limited + 1
      }
      plain_bytes = plain_bytes + track.cues[ci].plain_text().length()
      ci = ci + 1
    }
    io_println(
      world,
      "cues=" + track.cues.length().to_string() + " ok=" + ok.to_string() + " limited=" +
      limited.to_string() + " plain_bytes=" + plain_bytes.to_string(),
    )
    return 0
  }
  if mode == "deep" {
    let n = parse_pos_int(args[2])
    let sb = StringBuilder::with_capacity(n * 3 + 1)
    let mut i = 0
    while i < n {
      sb.write_string("<b>")
      i = i + 1
    }
    sb.write_string("x")
    match webvtt::parse_cue_payload_with_limits(sb.to_string(), n + 1) {
      Ok(nodes) => io_println(world, "deep_plain=" + webvtt::nodes_to_plain_text(nodes))
      Err(e) => io_println(world, "error=" + webvtt::webvtt_error_to_string(e))
    }
    return 0
  }
  io_println(world, "unknown mode " + mode)
  2
}
