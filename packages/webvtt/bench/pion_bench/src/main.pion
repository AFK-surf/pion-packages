///| Steady-state W3C WebVTT parse + plain_text + timeline query benchmark (Pion Native).

import "webvtt"

fn poly_hash(s : String) -> Int64 {
  let mut h : Int64 = 17L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  h
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 { args[1] } else { "/tmp/pion-webvtt-bench/corpus.vtt" }
  let iters = if args.length() > 2 { parse_pos_int(args[2]) } else { 15 }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }

  let mut total_cues = 0L
  let mut total_styles = 0L
  let mut total_regions = 0L
  let mut total_notes = 0L
  let mut total_plain_bytes = 0L
  let mut total_plain_hash = 0L
  let mut total_query_hits = 0L
  let mut total_query_start_sum = 0L

  let mut iter = 0
  while iter < iters {
    let track = match webvtt::parse(content) {
      Ok(t) => t
      Err(e) => {
        io_println(world, "parse error: " + webvtt::webvtt_error_to_string(e))
        return 1
      }
    }
    let nc = track.cues.length()
    total_cues = total_cues + nc.to_int64()
    total_styles = total_styles + track.styles.length().to_int64()
    total_regions = total_regions + track.regions.length().to_int64()
    total_notes = total_notes + track.notes.length().to_int64()

    let mut ci = 0
    while ci < nc {
      let pt = webvtt::plain_text(track.cues[ci].payload)
      total_plain_bytes = total_plain_bytes + pt.length().to_int64()
      total_plain_hash = (total_plain_hash + poly_hash(pt)) % 1000000007L
      ci = ci + 1
    }

    // 2,000 playback timeline queries spread across the full duration
    let max_t = if nc > 0 { track.cues[nc - 1].end_ms } else { 1000L }
    let step = if max_t > 2000L { max_t / 2000L } else { 1L }
    let mut q = 0
    while q < 2000 {
      let t = q.to_int64() * step + 500L
      let idxs = webvtt::active_cue_indices_at(track, t)
      let k = idxs.length()
      total_query_hits = total_query_hits + k.to_int64()
      let mut j = 0
      while j < k {
        total_query_start_sum = (total_query_start_sum + track.cues[idxs[j]].start_ms) % 1000000007L
        j = j + 1
      }
      q = q + 1
    }

    iter = iter + 1
  }

  io_println(world, "iters=" + iters.to_string())
  io_println(world, "cues=" + total_cues.to_string())
  io_println(world, "styles=" + total_styles.to_string())
  io_println(world, "regions=" + total_regions.to_string())
  io_println(world, "notes=" + total_notes.to_string())
  io_println(world, "plain_bytes=" + total_plain_bytes.to_string())
  io_println(world, "plain_hash=" + total_plain_hash.to_string())
  io_println(world, "query_hits=" + total_query_hits.to_string())
  io_println(world, "query_start_sum=" + total_query_start_sum.to_string())
  0
}
