///| DoS controls: very long prerelease / build identifiers parse, compare and format correctly.
///| (Timing comparison against dtolnay/semver lives in `run_audit.sh` perf section.)

import "semver"

fn long_dotted(n : Int, seg : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(".")
    }
    sb.write_string(seg)
    i = i + 1
  }
  sb.to_string()
}

test "control_10k_segment_prerelease_roundtrip_and_order" {
  let pre = long_dotted(10000, "a1")
  let v = must_v("1.0.0-" + pre + "+" + long_dotted(10000, "001"))
  expect_str(v.pre.as_str(), pre, "10k-segment prerelease kept")
  let w = must_v("1.0.0-" + pre + ".x")
  debug_assert(v.compare(w) < 0, "shorter prefix prerelease is smaller")
  debug_assert(w.compare(v) > 0, "antisymmetry")
  debug_assert(!must_r(">=1.0.0").matches(v), "prerelease does not opt in")
  debug_assert(must_r(">=1.0.0-" + pre).matches(w), "same-tuple prerelease opts in")
}

test "control_100kb_single_identifier" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 100000 {
    sb.write_string("9")
    i = i + 1
  }
  let big = sb.to_string()
  let v = must_v("1.0.0-" + big)
  let w = must_v("1.0.0-1" + big)
  debug_assert(v.compare(w) < 0, "100k-digit numeric < 100001-digit numeric")
  debug_assert(must_v("1.0.0-" + big + "a").compare(w) > 0, "alphanumeric > numeric")
}

test "control_33_comparators_rejected_32_accepted" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 32 {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(">=1.0.0")
    i = i + 1
  }
  let ok32 = sb.to_string()
  expect_str(req_err_msg(ok32).slice(0, 3), "<Ok", "32 comparators accepted")
  expect_str(req_err_msg(ok32 + ",>=1.0.0"), "excessive number of version comparators", "33 rejected")
}
