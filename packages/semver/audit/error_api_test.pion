///| P2: error-message character quoting and Eq/Hash/Ord contract vs dtolnay/semver 1.0.28.

import "semver"

test "p2_error_quotes_char_like_rust_debug" {
  // dtolnay/semver formats the offending char with `{:?}` (char::escape_debug), so control,
  // format and combining characters are written as `\u{..}`.
  let base = "unexpected character "
  let tail = " after patch version number"
  expect_str(version_err_msg("1.2.3" + utf8(0x01)), base + "'\\u{1}'" + tail, "U+0001")
  expect_str(version_err_msg("1.2.3" + utf8(0x1B)), base + "'\\u{1b}'" + tail, "U+001B")
  expect_str(version_err_msg("1.2.3" + utf8(0x7F)), base + "'\\u{7f}'" + tail, "U+007F")
  expect_str(version_err_msg("1.2.3" + utf8(0xA0)), base + "'\\u{a0}'" + tail, "U+00A0")
  expect_str(version_err_msg("1.2.3" + utf8(0xAD)), base + "'\\u{ad}'" + tail, "U+00AD")
  expect_str(version_err_msg("1.2.3" + utf8(0x301)), base + "'\\u{301}'" + tail, "U+0301")
  expect_str(version_err_msg("1.2.3" + utf8(0x200B)), base + "'\\u{200b}'" + tail, "U+200B")
  expect_str(version_err_msg("1.2.3" + utf8(0x2028)), base + "'\\u{2028}'" + tail, "U+2028")
  expect_str(version_err_msg("1.2.3" + utf8(0xFEFF)), base + "'\\u{feff}'" + tail, "U+FEFF")
  expect_str(
    req_err_msg("^1.2.3" + utf8(0x01)),
    "expected comma after patch version number, found '\\u{1}'",
    "req U+0001",
  )
}

test "control_error_quotes_already_matching" {
  let base = "unexpected character "
  let tail = " after patch version number"
  expect_str(version_err_msg("1.2.3" + utf8(0)), base + "'\\0'" + tail, "NUL")
  expect_str(version_err_msg("1.2.3\t"), base + "'\\t'" + tail, "TAB")
  expect_str(version_err_msg("1.2.3" + utf8(0xE9)), base + "'" + utf8(0xE9) + "'" + tail, "e-acute")
}

test "p2_equals_hash_contract" {
  // `Version::equals` ignores build metadata (SemVer precedence) but `Version::hash` mixes it in,
  // so two values that are `equals` hash differently. dtolnay/semver's `Eq` and `Hash` both
  // include build metadata (`1.0.0+a != 1.0.0+b`).
  let a = must_v("1.0.0+a")
  let b = must_v("1.0.0+b")
  debug_assert(!a.equals(b) || a.hash() == b.hash(), "equals(a, b) implies hash(a) == hash(b)")
}

test "p2_default_compare_matches_rust_ord" {
  // Rust `Ord for Version` is the total order (build metadata breaks ties);
  // `cmp_precedence` is the build-blind one. Here `compare` is the build-blind one.
  let a = must_v("1.0.0+a")
  let b = must_v("1.0.0+b")
  debug_assert(a.compare(b) < 0, "Version::compare should follow Rust Ord: 1.0.0+a < 1.0.0+b")
}

test "control_compare_full_and_equals_exact" {
  let a = must_v("1.0.0+a")
  let b = must_v("1.0.0+b")
  debug_assert(a.compare_full(b) < 0, "compare_full: 1.0.0+a < 1.0.0+b")
  debug_assert(!a.equals_exact(b), "equals_exact: 1.0.0+a != 1.0.0+b")
  debug_assert(must_build("001").compare(must_build("1")) > 0, "build +001 > +1 (dtolnay order)")
  debug_assert(must_build("01").compare(must_build("001")) < 0, "build +01 < +001")
}

test "control_prerelease_intersections" {
  // Precompiled interval / single-major prerelease filter: all match dtolnay/semver 1.0.28.
  expect_match("=1.0.0-alpha, >=1.0.0-alpha", "1.0.0-alpha", true)
  expect_match("=1.0.0-alpha, >=1.0.0-alpha", "1.0.0", false)
  expect_match("^0.0.0-alpha", "0.0.0", true)
  expect_match("~0.0.0-alpha", "0.0.1", true)
  expect_match("<1.0.0-0", "0.9.9", true)
  expect_match("<1.0.0-0", "1.0.0-alpha", false)
  expect_match(">=1.0.0-0, <2.0.0-0", "2.0.0-alpha", false)
  expect_match(">=1.0.0-alpha, >=2.0.0-alpha", "2.0.0-beta", true)
  expect_match(">=1.0.0-alpha, >=2.0.0-alpha", "1.5.0-beta", false)
  expect_match("0.0.*", "0.0.9", true)
  expect_match("1.*", "1.0.0-alpha", false)
}
