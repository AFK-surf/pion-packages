///| P0: dtolnay/semver accepts the full `u64` domain (`0 ..= 18446744073709551615`) for
///| major/minor/patch; packages/semver stores `Int64` and rejects `9223372036854775808 ..= u64::MAX`.
///| Every expected value below is the dtolnay/semver 1.0.28 result (cross-checked by `audit/oracle_rust`).

import "semver"

test "p0_u64_version_parse_roundtrip" {
  expect_str(version_err_msg("9223372036854775808.0.0"), "<Ok 9223372036854775808.0.0>", "Int64::MAX+1 major")
  expect_str(version_err_msg("0.9223372036854775808.0"), "<Ok 0.9223372036854775808.0>", "Int64::MAX+1 minor")
  expect_str(version_err_msg("0.0.9223372036854775808"), "<Ok 0.0.9223372036854775808>", "Int64::MAX+1 patch")
  expect_str(
    version_err_msg("18446744073709551615.18446744073709551615.18446744073709551615-alpha+b"),
    "<Ok 18446744073709551615.18446744073709551615.18446744073709551615-alpha+b>",
    "u64::MAX all components",
  )
}

test "p0_u64_req_and_comparator_parse_roundtrip" {
  expect_str(req_err_msg("^18446744073709551615.0.0"), "<Ok ^18446744073709551615.0.0>", "caret u64::MAX")
  expect_str(req_err_msg("~0.18446744073709551615.0"), "<Ok ~0.18446744073709551615.0>", "tilde u64::MAX minor")
  expect_str(req_err_msg(">9223372036854775808"), "<Ok >9223372036854775808>", "greater Int64::MAX+1")
  expect_str(req_err_msg("18446744073709551615.*"), "<Ok 18446744073709551615.*>", "wildcard u64::MAX")
  expect_str(
    req_err_msg("<18446744073709551615.18446744073709551615.18446744073709551615"),
    "<Ok <18446744073709551615.18446744073709551615.18446744073709551615>",
    "less u64::MAX",
  )
}

test "p0_u64_matches_no_overflow_at_major_plus_one" {
  // dtolnay/semver never computes major+1 / minor+1; all of these are `true` there.
  expect_match(">=9223372036854775807.0.0", "9223372036854775808.0.0", true)
  expect_match("^18446744073709551615.0.0", "18446744073709551615.0.0", true)
  expect_match("^18446744073709551615.0.0", "18446744073709551615.1.0", true)
  expect_match("~0.18446744073709551615.0", "0.18446744073709551615.5", true)
  expect_match("~0.18446744073709551615", "0.18446744073709551615.18446744073709551615", true)
  expect_match("<18446744073709551615.0.0", "9223372036854775808.0.0", true)
  expect_match(">9223372036854775808.0.0", "18446744073709551615.0.0", true)
  expect_match("<9223372036854775808.0.0", "9223372036854775807.0.0", true)
  expect_match("*", "18446744073709551615.0.0", true)
}

test "p2_overflow_error_message_says_u64" {
  expect_str(version_err_msg("18446744073709551616.0.0"), "value of major version number exceeds u64::MAX", "major")
  expect_str(version_err_msg("0.18446744073709551616.0"), "value of minor version number exceeds u64::MAX", "minor")
  expect_str(req_err_msg(">=0.0.18446744073709551616"), "value of patch version number exceeds u64::MAX", "patch")
}

test "control_int64_max_still_works" {
  expect_str(must_v("9223372036854775807.0.0").to_string(), "9223372036854775807.0.0", "Int64::MAX")
  expect_match("^9223372036854775807", "9223372036854775807.9223372036854775807.9223372036854775807", true)
  expect_match(
    ">9223372036854775807.9223372036854775807.9223372036854775806",
    "9223372036854775807.9223372036854775807.9223372036854775807",
    true,
  )
}
