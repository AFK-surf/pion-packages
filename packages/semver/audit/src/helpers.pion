///| Shared helpers for the red-team audit tests (`audit/*_test.pion`).

import "semver"

fn must_v(text : String) -> semver::Version {
  match semver::parse_version(text) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Version) for '" + text + "', got Err: " + e.to_string())
      semver::Version::new(0UL, 0UL, 0UL)
    }
  }
}

fn must_r(text : String) -> semver::VersionReq {
  match semver::parse_req(text) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "expected Ok(VersionReq) for '" + text + "', got Err: " + e.to_string())
      semver::VersionReq::star()
    }
  }
}

fn must_c(text : String) -> semver::Comparator {
  match semver::parse_comparator(text) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "expected Ok(Comparator) for '" + text + "', got Err: " + e.to_string())
      semver::Comparator::{
        op: semver::Op::Wildcard,
        major: 0UL,
        minor: None,
        patch: None,
        pre: semver::Prerelease::empty(),
      }
    }
  }
}

fn must_pre(text : String) -> semver::Prerelease {
  match semver::Prerelease::new(text) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "expected Ok(Prerelease) for '" + text + "', got Err: " + e.to_string())
      semver::Prerelease::empty()
    }
  }
}

fn must_build(text : String) -> semver::BuildMetadata {
  match semver::BuildMetadata::new(text) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "expected Ok(BuildMetadata) for '" + text + "', got Err: " + e.to_string())
      semver::BuildMetadata::empty()
    }
  }
}

fn version_err_msg(text : String) -> String {
  match semver::parse_version(text) {
    Ok(v) => "<Ok " + v.to_string() + ">"
    Err(e) => e.to_string()
  }
}

fn req_err_msg(text : String) -> String {
  match semver::parse_req(text) {
    Ok(r) => "<Ok " + r.to_string() + ">"
    Err(e) => e.to_string()
  }
}

fn expect_str(actual : String, expected : String, what : String) -> Unit {
  debug_assert(actual == expected, what + ": expected '" + expected + "', got '" + actual + "'")
}

fn expect_match(req : String, ver : String, expected : Bool) -> Unit {
  let r = must_r(req)
  let v = must_v(ver)
  debug_assert(
    r.matches(v) == expected,
    "'" + req + "'.matches('" + ver + "') expected " + expected.to_string() + " (dtolnay/semver 1.0.28)",
  )
}

///| UTF-8 encode a BMP code point.
fn utf8(cp : Int) -> String {
  let sb = StringBuilder::new()
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  sb.to_string()
}
