///| Red-team differential driver for `packages/semver` (Pion side).
///|
///| `diff <corpus>`: every corpus line is `<K> <hex>[ <hex>]` (UTF-8 bytes hex-encoded);
///| one result line is printed per input line in exactly the format of
///| `audit/oracle_rust` (dtolnay/semver =1.0.28), so the two stdouts can be diffed line by line.
///|
///| `perf <version|req|match> <file> <iters> [ver]`: DoS / throughput probe, prints a checksum
///| that must be byte-identical to the Rust oracle's.

import "semver"

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

fn unhex(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n / 2 + 1)
  let mut i = 0
  while i + 1 < n {
    sb.write_byte((hex_val(s.code_unit_at(i)) * 16 + hex_val(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

fn ord_str(c : Int) -> String {
  if c < 0 {
    "-1"
  } else if c > 0 {
    "1"
  } else {
    "0"
  }
}

fn split_fields(line : String) -> Array[String] {
  line.split(" ")
}

fn run_line(line : String, out : StringBuilder) -> Unit {
  let f = split_fields(line)
  let k = f[0]
  let a = if f.length() > 1 { unhex(f[1]) } else { "" }
  if k == "V" {
    match semver::parse_version(a) {
      Ok(v) => {
        out.write_string("ok|")
        out.write_string(v.to_string())
        out.write_string("|")
        out.write_string(v.pre.as_str())
        out.write_string("|")
        out.write_string(v.build.as_str())
      }
      Err(e) => {
        out.write_string("err|")
        out.write_string(e.to_string())
      }
    }
  } else if k == "R" {
    match semver::parse_req(a) {
      Ok(r) => {
        out.write_string("ok|")
        out.write_string(r.to_string())
        out.write_string("|n=")
        out.write_string(r.comparators.length().to_string())
      }
      Err(e) => {
        out.write_string("err|")
        out.write_string(e.to_string())
      }
    }
  } else if k == "C" {
    match semver::parse_comparator(a) {
      Ok(c) => {
        out.write_string("ok|")
        out.write_string(c.to_string())
      }
      Err(e) => {
        out.write_string("err|")
        out.write_string(e.to_string())
      }
    }
  } else if k == "P" {
    match semver::Prerelease::new(a) {
      Ok(p) => {
        out.write_string("ok|")
        out.write_string(p.as_str())
      }
      Err(e) => {
        out.write_string("err|")
        out.write_string(e.to_string())
      }
    }
  } else if k == "B" {
    match semver::BuildMetadata::new(a) {
      Ok(p) => {
        out.write_string("ok|")
        out.write_string(p.as_str())
      }
      Err(e) => {
        out.write_string("err|")
        out.write_string(e.to_string())
      }
    }
  } else if k == "M" || k == "K" {
    let b = if f.length() > 2 { unhex(f[2]) } else { "" }
    match semver::parse_version(b) {
      Err(e) => {
        out.write_string("verr|")
        out.write_string(e.to_string())
      }
      Ok(v) => {
        if k == "M" {
          match semver::parse_req(a) {
            Err(e) => {
              out.write_string("rerr|")
              out.write_string(e.to_string())
            }
            Ok(r) => out.write_string(if r.matches(v) { "1" } else { "0" })
          }
        } else {
          match semver::parse_comparator(a) {
            Err(e) => {
              out.write_string("rerr|")
              out.write_string(e.to_string())
            }
            Ok(c) => out.write_string(if c.matches(v) { "1" } else { "0" })
          }
        }
      }
    }
  } else if k == "O" {
    let b = if f.length() > 2 { unhex(f[2]) } else { "" }
    match (semver::parse_version(a), semver::parse_version(b)) {
      (Ok(x), Ok(y)) => {
        // Rust: `Ord::cmp` (total, includes build), `cmp_precedence`, `==` (Eq, includes build).
        out.write_string(ord_str(x.compare_full(y)))
        out.write_string(" ")
        out.write_string(ord_str(x.compare(y)))
        out.write_string(" ")
        out.write_string(if x.equals_exact(y) { "eq" } else { "ne" })
      }
      _ => out.write_string("perr")
    }
  } else {
    out.write_string("unknown")
  }
}

fn read_lines(world : World, path : String) -> Array[String] {
  let out : Array[String] = Array::new()
  match fs_read(world, path) {
    Ok(raw) => {
      let parts = raw.split("\n")
      let mut i = 0
      while i < parts.length() {
        if parts[i].length() > 0 {
          out.push(parts[i])
        }
        i = i + 1
      }
    }
    Err(_) => ()
  }
  out
}

fn run_diff(world : World, path : String) -> Int {
  let lines = read_lines(world, path)
  let out = StringBuilder::with_capacity(lines.length() * 16)
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      out.write_string("\n")
    }
    run_line(lines[i], out)
    i = i + 1
  }
  io_println(world, out.to_string())
  0
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

fn run_perf(world : World, mode : String, path : String, iters : Int, ver_text : String) -> Int {
  let lines = read_lines(world, path)
  let mut ok : Int64 = 0L
  let mut bytes : Int64 = 0L
  let ver = match semver::parse_version(ver_text) {
    Ok(v) => v
    Err(_) => semver::Version::new(1L, 0L, 0L)
  }
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < lines.length() {
      let s = lines[i]
      if mode == "version" {
        match semver::parse_version(s) {
          Ok(v) => {
            ok = ok + 1L
            bytes = bytes + v.to_string().length().to_int64()
          }
          Err(e) => bytes = bytes + e.to_string().length().to_int64()
        }
      } else if mode == "req" {
        match semver::parse_req(s) {
          Ok(r) => {
            ok = ok + 1L
            bytes = bytes + r.to_string().length().to_int64()
          }
          Err(e) => bytes = bytes + e.to_string().length().to_int64()
        }
      } else if mode == "cmp" {
        // Compare each line's version with itself-shaped neighbour (total order).
        let j = if i + 1 < lines.length() { i + 1 } else { 0 }
        match (semver::parse_version(s), semver::parse_version(lines[j])) {
          (Ok(x), Ok(y)) => {
            ok = ok + 1L
            bytes = bytes + (x.compare_full(y) + 1).to_int64()
          }
          _ => ()
        }
      } else {
        match semver::parse_req(s) {
          Ok(r) => {
            if r.matches(ver) {
              ok = ok + 1L
            }
          }
          Err(_) => ()
        }
      }
      i = i + 1
    }
    it = it + 1
  }
  io_println(world, "mode=" + mode + " lines=" + lines.length().to_string() + " ok=" + ok.to_string() + " bytes=" + bytes.to_string())
  0
}

///| Exhaustive small-domain matrix: one line per req, one `0`/`1` per version (`E` = parse error).
fn run_matrix(world : World, reqs_path : String, vers_path : String) -> Int {
  let reqs = read_lines(world, reqs_path)
  let vlines = read_lines(world, vers_path)
  let vers : Array[semver::Version] = Array::new()
  let mut i = 0
  while i < vlines.length() {
    match semver::parse_version(vlines[i]) {
      Ok(v) => vers.push(v)
      Err(_) => ()
    }
    i = i + 1
  }
  let out = StringBuilder::with_capacity(reqs.length() * (vers.length() + 1))
  let mut r = 0
  while r < reqs.length() {
    if r > 0 {
      out.write_string("\n")
    }
    match semver::parse_req(reqs[r]) {
      Ok(req) => {
        let mut j = 0
        while j < vers.length() {
          out.write_string(if req.matches(vers[j]) { "1" } else { "0" })
          j = j + 1
        }
      }
      Err(_) => out.write_string("E")
    }
    r = r + 1
  }
  io_println(world, out.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 4 && args[1] == "matrix" {
    return run_matrix(world, args[2], args[3])
  }
  if args.length() >= 3 && args[1] == "diff" {
    return run_diff(world, args[2])
  }
  if args.length() >= 5 && args[1] == "perf" {
    let v = if args.length() > 5 { args[5] } else { "1.0.0" }
    return run_perf(world, args[2], args[3], parse_int(args[4]), v)
  }
  io_println(world, "usage: semver_audit diff <corpus> | perf <version|req|cmp|match> <file> <iters> [ver]")
  2
}
