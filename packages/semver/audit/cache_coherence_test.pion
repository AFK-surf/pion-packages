///| P1: `VersionReq.comparators` and `Version.pre` / `Version.build` are public and mutable, but
///| `VersionReq::matches`, `Version::to_string`, `compare` and `matches` read values cached at
///| parse time (`lo_*`/`hi_*`/`has_pre`/`rel_empty`/`pre_only_major`, `pre_len`/`build_len`).
///| In dtolnay/semver these are plain `pub` fields and every operation reads them live.

import "semver"

test "p1_req_push_comparator_is_honoured" {
  let req = must_r(">=1.0.0")
  req.comparators.push(must_c("<0.5.0"))
  expect_str(req.to_string(), ">=1.0.0, <0.5.0", "formatted after push")
  // dtolnay: VersionReq { comparators: [>=1.0.0, <0.5.0] }.matches(1.2.0) == false
  debug_assert(!req.matches(must_v("1.2.0")), "'>=1.0.0, <0.5.0' must not match 1.2.0 (stale interval cache)")
}

test "p1_req_assign_comparator_is_honoured" {
  let req = must_r(">=1.0.0")
  req.comparators[0] = must_c("<0.5.0")
  debug_assert(!req.matches(must_v("1.2.0")), "'<0.5.0' must not match 1.2.0 (stale interval cache)")
  debug_assert(req.matches(must_v("0.4.0")), "'<0.5.0' must match 0.4.0 (stale interval cache)")
}

test "p1_req_built_from_star_plus_comparators" {
  // The only way to build a VersionReq programmatically (no FromIterator / from_comparators).
  let req = semver::VersionReq::star()
  req.comparators.push(must_c("=2.0.0"))
  debug_assert(!req.matches(must_v("1.0.0")), "'=2.0.0' must not match 1.0.0")
  let req2 = semver::VersionReq::star()
  req2.comparators.push(must_c(">=1.0.0-alpha"))
  debug_assert(req2.matches(must_v("1.0.0-beta")), "'>=1.0.0-alpha' must match 1.0.0-beta (has_pre cache)")
}

test "p1_req_replace_prerelease_comparator" {
  // Stale `pre_only_major = 1` rejects every major-2 prerelease before the live slow path runs.
  let req = must_r(">=1.0.0-alpha")
  req.comparators[0] = must_c(">=2.0.0-alpha")
  debug_assert(req.matches(must_v("2.0.0-beta")), "'>=2.0.0-alpha' must match 2.0.0-beta (pre_only_major cache)")
}

test "control_req_replace_comparator_slow_path_is_live" {
  // Correct by accident: stale `has_pre = true` routes to the live slow path.
  let req = must_r(">=1.0.0-alpha, <2.0.0")
  req.comparators[0] = must_c(">=1.0.0")
  debug_assert(!req.matches(must_v("1.0.0-beta")), "'>=1.0.0, <2.0.0' must not match 1.0.0-beta")
}

test "p1_version_pre_assignment_is_honoured" {
  let mut v = must_v("1.2.0")
  v.pre = must_pre("alpha")
  expect_str(v.to_string(), "1.2.0-alpha", "to_string after pre assignment")
  debug_assert(v.compare(must_v("1.2.0")) < 0, "1.2.0-alpha < 1.2.0")
  debug_assert(!must_r("^1.2.0").matches(v), "'^1.2.0' must not match 1.2.0-alpha")
}

test "p1_version_build_assignment_is_honoured" {
  let mut v = must_v("1.2.0")
  v.build = must_build("git.abc")
  expect_str(v.to_string(), "1.2.0+git.abc", "to_string after build assignment")
  debug_assert(v.compare_full(must_v("1.2.0")) > 0, "1.2.0+git.abc > 1.2.0 in total order")
}

test "p1_version_clear_pre_is_honoured" {
  let mut v = must_v("1.2.0-alpha")
  v.pre = semver::Prerelease::empty()
  expect_str(v.to_string(), "1.2.0", "to_string after clearing pre")
  debug_assert(must_r("^1.2.0").matches(v), "'^1.2.0' must match 1.2.0")
}

test "control_parsed_req_unmodified_is_correct" {
  expect_match(">=1.0.0, <0.5.0", "1.2.0", false)
  expect_match("<0.5.0", "0.4.0", true)
  expect_match(">=1.0.0-alpha", "1.0.0-beta", true)
}
