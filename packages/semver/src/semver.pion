///| Top-level convenience entrypoints for `packages/semver`.

///| Parse a strict SemVer 2.0.0 `Version`.
pub fn parse_version(text : String) -> Result[Version, SemverError] {
  Version::parse(text)
}

///| Parse a Cargo `VersionReq`.
pub fn parse_req(text : String) -> Result[VersionReq, SemverError] {
  VersionReq::parse(text)
}

///| Parse a single Cargo `Comparator`.
pub fn parse_comparator(text : String) -> Result[Comparator, SemverError] {
  Comparator::parse(text)
}
