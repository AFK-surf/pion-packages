///| Fast formatting for `Version`, `Comparator`, and `VersionReq`.

fn write_nonneg_i64(sb : StringBuilder, n : Int64) -> Unit {
  if n < 10L {
    sb.write_byte((48 + n.to_int()).to_byte())
    return
  }
  if n < 100L {
    let v = n.to_int()
    sb.write_byte((48 + v / 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  // Up to 19 digits for Int64::MAX
  let buf : FixedArray[Byte] = FixedArray::make(20, (0).to_byte())
  let mut x = n
  let mut pos = 20
  while x > 0L {
    pos = pos - 1
    let rem = (x % 10L).to_int()
    buf[pos] = (48 + rem).to_byte()
    x = x / 10L
  }
  let mut i = pos
  while i < 20 {
    sb.write_byte(buf[i])
    i = i + 1
  }
}

///| Write formatted `Version` directly into `sb` without intermediate allocations.
pub fn Version::write_to(self : Version, sb : StringBuilder) -> Unit {
  write_nonneg_i64(sb, self.major)
  sb.write_byte((46).to_byte())
  write_nonneg_i64(sb, self.minor)
  sb.write_byte((46).to_byte())
  write_nonneg_i64(sb, self.patch)
  if self.pre.raw.length() > 0 {
    sb.write_byte((45).to_byte())
    sb.write_string(self.pre.raw)
  }
  if self.build.raw.length() > 0 {
    sb.write_byte((43).to_byte())
    sb.write_string(self.build.raw)
  }
}

///| Format `Version` as a canonical SemVer 2.0.0 string.
pub fn Version::to_string(self : Version) -> String {
  let est = 16 + self.pre.raw.length() + self.build.raw.length()
  let sb = StringBuilder::with_capacity(est)
  self.write_to(sb)
  sb.to_string()
}

///| Write formatted `Comparator` directly into `sb`.
pub fn Comparator::write_to(self : Comparator, sb : StringBuilder) -> Unit {
  match self.op {
    Op::Exact => sb.write_byte((61).to_byte())
    Op::Greater => sb.write_byte((62).to_byte())
    Op::GreaterEq => sb.write_string(">=")
    Op::Less => sb.write_byte((60).to_byte())
    Op::LessEq => sb.write_string("<=")
    Op::Tilde => sb.write_byte((126).to_byte())
    Op::Caret => sb.write_byte((94).to_byte())
    Op::Wildcard => ()
  }
  write_nonneg_i64(sb, self.major)
  match self.minor {
    Some(m) => {
      sb.write_byte((46).to_byte())
      write_nonneg_i64(sb, m)
      match self.patch {
        Some(p) => {
          sb.write_byte((46).to_byte())
          write_nonneg_i64(sb, p)
          if self.pre.raw.length() > 0 {
            sb.write_byte((45).to_byte())
            sb.write_string(self.pre.raw)
          }
        }
        None => {
          match self.op {
            Op::Wildcard => sb.write_string(".*")
            _ => ()
          }
        }
      }
    }
    None => {
      match self.op {
        Op::Wildcard => sb.write_string(".*")
        _ => ()
      }
    }
  }
}

///| Format `Comparator` in canonical `dtolnay/semver` form.
pub fn Comparator::to_string(self : Comparator) -> String {
  let sb = StringBuilder::with_capacity(16 + self.pre.raw.length())
  self.write_to(sb)
  sb.to_string()
}

///| Write formatted `VersionReq` directly into `sb`.
pub fn VersionReq::write_to(self : VersionReq, sb : StringBuilder) -> Unit {
  let n = self.comparators.length()
  if n == 0 {
    sb.write_byte((42).to_byte())
    return
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(", ")
    }
    self.comparators[i].write_to(sb)
    i = i + 1
  }
}

///| Format `VersionReq` in canonical `dtolnay/semver` form.
pub fn VersionReq::to_string(self : VersionReq) -> String {
  let n = self.comparators.length()
  if n == 0 {
    return "*"
  }
  let sb = StringBuilder::with_capacity(n * 12)
  self.write_to(sb)
  sb.to_string()
}
