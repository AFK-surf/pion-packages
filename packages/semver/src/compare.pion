///| Zero-allocation ordering, equality, and FNV-1a hashing for SemVer types.

fn fnv1a_mix_u64(h : UInt64, v : UInt64) -> UInt64 {
  let prime : UInt64 = 1099511628211UL
  let mut x = h ^ (v & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 8UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 16UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 24UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 32UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 40UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 48UL) & 0xFFUL)
  x = x * prime
  x = x ^ ((v >> 56UL) & 0xFFUL)
  x * prime
}

fn fnv1a_mix_str(h : UInt64, s : String) -> UInt64 {
  let prime : UInt64 = 1099511628211UL
  let n = s.length()
  let mut x = fnv1a_mix_u64(h, n.to_int64().to_uint64())
  let mut i = 0
  while i < n {
    x = x ^ s.code_unit_at(i).to_int64().to_uint64()
    x = x * prime
    i = i + 1
  }
  x
}

fn cmp_bytes_range(a : String, a_start : Int, a_end : Int, b : String, b_start : Int, b_end : Int) -> Int {
  let a_len = a_end - a_start
  let b_len = b_end - b_start
  let min_len = if a_len < b_len { a_len } else { b_len }
  let mut k = 0
  while k < min_len {
    let ba = a.code_unit_at(a_start + k)
    let bb = b.code_unit_at(b_start + k)
    if ba != bb {
      return if ba < bb { -1 } else { 1 }
    }
    k = k + 1
  }
  if a_len < b_len {
    -1
  } else if a_len > b_len {
    1
  } else {
    0
  }
}

///| Compare two pre-release strings per SemVer 2.0.0 §11.
///| Numeric identifiers of arbitrary length are compared by decimal length then ASCII order (zero overflow).
fn compare_pre_raw(a : String, b : String) -> Int {
  let alen = a.length()
  let blen = b.length()
  if alen == 0 {
    return if blen == 0 { 0 } else { 1 }
  }
  if blen == 0 {
    return -1
  }
  let mut ai = 0
  let mut bi = 0
  while true {
    let a_start = ai
    let mut a_digits = true
    while ai < alen {
      let c = a.code_unit_at(ai)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        a_digits = false
      }
      ai = ai + 1
    }
    let a_end = ai

    let b_start = bi
    let mut b_digits = true
    while bi < blen {
      let c = b.code_unit_at(bi)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        b_digits = false
      }
      bi = bi + 1
    }
    let b_end = bi

    let a_slen = a_end - a_start
    let b_slen = b_end - b_start
    let lex_cmp = if (a_digits && b_digits && a_slen == b_slen) || (!a_digits && !b_digits) {
      cmp_bytes_range(a, a_start, a_end, b, b_start, b_end)
    } else {
      0
    }
    let seg_cmp = cmp_pre_segment_order(a_digits, a_slen, b_digits, b_slen, lex_cmp)

    if seg_cmp != 0 {
      return seg_cmp
    }

    let a_more = ai < alen
    let b_more = bi < blen
    if !a_more && !b_more {
      return 0
    }
    if !a_more {
      return -1
    }
    if !b_more {
      return 1
    }
    // Skip '.'
    ai = ai + 1
    bi = bi + 1
  }
  0
}

///| Compare two build metadata strings per `dtolnay/semver` total ordering:
///| `"" < "demo" < "demo.0" < "demo.00" < "demo.1" < "demo.01" < "demo.001" < "demo.2" < ...`
fn compare_build_raw(a : String, b : String) -> Int {
  let alen = a.length()
  let blen = b.length()
  if alen == 0 {
    return if blen == 0 { 0 } else { -1 }
  }
  if blen == 0 {
    return 1
  }
  let mut ai = 0
  let mut bi = 0
  while true {
    let a_start = ai
    let mut a_digits = true
    while ai < alen {
      let c = a.code_unit_at(ai)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        a_digits = false
      }
      ai = ai + 1
    }
    let a_end = ai

    let b_start = bi
    let mut b_digits = true
    while bi < blen {
      let c = b.code_unit_at(bi)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        b_digits = false
      }
      bi = bi + 1
    }
    let b_end = bi

    let seg_cmp = if a_digits && b_digits {
      let mut a_nz = a_start
      while a_nz < a_end && a.code_unit_at(a_nz) == 48 {
        a_nz = a_nz + 1
      }
      let mut b_nz = b_start
      while b_nz < b_end && b.code_unit_at(b_nz) == 48 {
        b_nz = b_nz + 1
      }
      let a_nlen = a_end - a_nz
      let b_nlen = b_end - b_nz
      if a_nlen != b_nlen {
        if a_nlen < b_nlen { -1 } else { 1 }
      } else {
        let c1 = cmp_bytes_range(a, a_nz, a_end, b, b_nz, b_end)
        if c1 != 0 {
          c1
        } else {
          let a_slen = a_end - a_start
          let b_slen = b_end - b_start
          if a_slen < b_slen { -1 } else if a_slen > b_slen { 1 } else { 0 }
        }
      }
    } else if a_digits {
      -1
    } else if b_digits {
      1
    } else {
      cmp_bytes_range(a, a_start, a_end, b, b_start, b_end)
    }

    if seg_cmp != 0 {
      return seg_cmp
    }

    let a_more = ai < alen
    let b_more = bi < blen
    if !a_more && !b_more {
      return 0
    }
    if !a_more {
      return -1
    }
    if !b_more {
      return 1
    }
    ai = ai + 1
    bi = bi + 1
  }
  0
}

///|
pub fn Prerelease::equals(self : Prerelease, other : Prerelease) -> Bool {
  self.raw == other.raw
}

///|
pub fn Prerelease::compare(self : Prerelease, other : Prerelease) -> Int {
  compare_pre_raw(self.raw, other.raw)
}

///|
pub fn Prerelease::hash(self : Prerelease) -> UInt64 {
  fnv1a_mix_str(14695981039346656037UL, self.raw)
}

///|
pub fn BuildMetadata::equals(self : BuildMetadata, other : BuildMetadata) -> Bool {
  self.raw == other.raw
}

///|
pub fn BuildMetadata::compare(self : BuildMetadata, other : BuildMetadata) -> Int {
  compare_build_raw(self.raw, other.raw)
}

///|
pub fn BuildMetadata::hash(self : BuildMetadata) -> UInt64 {
  fnv1a_mix_str(14695981039346656037UL, self.raw)
}

///| Pure `(major, minor, patch)` lexicographic comparison kernel (verified in Lean 4).
#verify
fn cmp_core(
  a_major : UInt64,
  a_minor : UInt64,
  a_patch : UInt64,
  b_major : UInt64,
  b_minor : UInt64,
  b_patch : UInt64,
) -> Int {
  if a_major != b_major {
    return if a_major < b_major { -1 } else { 1 }
  }
  if a_minor != b_minor {
    return if a_minor < b_minor { -1 } else { 1 }
  }
  if a_patch != b_patch {
    return if a_patch < b_patch { -1 } else { 1 }
  }
  0
}

///| Pure SemVer 2.0.0 §11.4 segment precedence rule (numeric < alphanumeric; decimal length order).
#verify
fn cmp_pre_segment_order(
  a_digits : Bool,
  a_len : Int,
  b_digits : Bool,
  b_len : Int,
  lex_cmp : Int,
) -> Int {
  if a_digits && b_digits {
    if a_len != b_len {
      if a_len < b_len { -1 } else { 1 }
    } else {
      lex_cmp
    }
  } else if a_digits {
    -1
  } else if b_digits {
    1
  } else {
    lex_cmp
  }
}

///| Pure SemVer 2.0.0 precedence kernel: core `(major, minor, patch)`, release > prerelease (§11.3),
///| and build metadata invariance (§10). Returns `None` only when both versions have distinct non-empty prereleases.
#verify
fn cmp_precedence_core(a : Version, b : Version) -> Option[Int] {
  let c = cmp_core(a.major, a.minor, a.patch, b.major, b.minor, b.patch)
  if c != 0 {
    return Some(c)
  }
  let a_pre_len = a.pre.raw.length()
  let b_pre_len = b.pre.raw.length()
  if a_pre_len == 0 {
    return Some(if b_pre_len == 0 { 0 } else { 1 })
  }
  if b_pre_len == 0 {
    return Some(-1)
  }
  if a.pre.raw == b.pre.raw {
    return Some(0)
  }
  None
}

///| SemVer 2.0.0 precedence comparison (ignores `build` metadata; matches Rust `Version::cmp_precedence`).
pub fn Version::cmp_precedence(self : Version, other : Version) -> Int {
  match cmp_precedence_core(self, other) {
    Some(c) => c
    None => compare_pre_raw(self.pre.raw, other.pre.raw)
  }
}

fn compare_full_tail(a : Version, b : Version) -> Int {
  let a_pre = a.pre.raw
  let b_pre = b.pre.raw
  let a_pre_len = a_pre.length()
  let b_pre_len = b_pre.length()
  if a_pre_len != 0 || b_pre_len != 0 {
    if a_pre_len == 0 {
      return 1
    }
    if b_pre_len == 0 {
      return -1
    }
    let cp = compare_pre_raw(a_pre, b_pre)
    if cp != 0 {
      return cp
    }
  }
  let a_build = a.build.raw
  let b_build = b.build.raw
  let a_build_len = a_build.length()
  let b_build_len = b_build.length()
  if a_build_len == 0 && b_build_len == 0 {
    return 0
  }
  if a_build_len == 0 {
    return -1
  }
  if b_build_len == 0 {
    return 1
  }
  compare_build_raw(a_build, b_build)
}

///| Total ordering comparison including `build` metadata (matches `dtolnay/semver` `Ord`).
pub fn Version::compare(self : Version, other : Version) -> Int {
  if self.major != other.major {
    return if self.major < other.major { -1 } else { 1 }
  }
  if self.minor != other.minor {
    return if self.minor < other.minor { -1 } else { 1 }
  }
  if self.patch != other.patch {
    return if self.patch < other.patch { -1 } else { 1 }
  }
  compare_full_tail(self, other)
}

///| Alias for `Version::compare` (total ordering including `build` metadata).
pub fn Version::compare_full(self : Version, other : Version) -> Int {
  if self.major != other.major {
    return if self.major < other.major { -1 } else { 1 }
  }
  if self.minor != other.minor {
    return if self.minor < other.minor { -1 } else { 1 }
  }
  if self.patch != other.patch {
    return if self.patch < other.patch { -1 } else { 1 }
  }
  compare_full_tail(self, other)
}

///| Exact structural equality including `build` metadata (matches `dtolnay/semver` `Eq` and `Hash`).
pub fn Version::equals(self : Version, other : Version) -> Bool {
  self.major == other.major && self.minor == other.minor && self.patch == other.patch &&
  self.pre.raw == other.pre.raw && self.build.raw == other.build.raw
}

///| Alias for `Version::equals` (exact structural equality including `build` metadata).
pub fn Version::equals_exact(self : Version, other : Version) -> Bool {
  self.equals(other)
}

///|
pub fn Version::hash(self : Version) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  h = fnv1a_mix_u64(h, self.major)
  h = fnv1a_mix_u64(h, self.minor)
  h = fnv1a_mix_u64(h, self.patch)
  h = fnv1a_mix_str(h, self.pre.raw)
  fnv1a_mix_str(h, self.build.raw)
}

fn opt_u64_eq(a : Option[UInt64], b : Option[UInt64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn op_tag(op : Op) -> UInt64 {
  match op {
    Op::Exact => 1UL
    Op::Greater => 2UL
    Op::GreaterEq => 3UL
    Op::Less => 4UL
    Op::LessEq => 5UL
    Op::Tilde => 6UL
    Op::Caret => 7UL
    Op::Wildcard => 8UL
  }
}

///|
pub fn Comparator::equals(self : Comparator, other : Comparator) -> Bool {
  op_tag(self.op) == op_tag(other.op) && self.major == other.major && opt_u64_eq(self.minor, other.minor) &&
  opt_u64_eq(self.patch, other.patch) && self.pre.raw == other.pre.raw
}

///|
pub fn Comparator::hash(self : Comparator) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  h = fnv1a_mix_u64(h, op_tag(self.op))
  h = fnv1a_mix_u64(h, self.major)
  match self.minor {
    None => h = fnv1a_mix_u64(h, 0UL)
    Some(v) => {
      h = fnv1a_mix_u64(h, 1UL)
      h = fnv1a_mix_u64(h, v)
    }
  }
  match self.patch {
    None => h = fnv1a_mix_u64(h, 0UL)
    Some(v) => {
      h = fnv1a_mix_u64(h, 1UL)
      h = fnv1a_mix_u64(h, v)
    }
  }
  fnv1a_mix_str(h, self.pre.raw)
}

///|
pub fn VersionReq::equals(self : VersionReq, other : VersionReq) -> Bool {
  let n = self.comparators.length()
  if n != other.comparators.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if !self.comparators[i].equals(other.comparators[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn VersionReq::hash(self : VersionReq) -> UInt64 {
  let n = self.comparators.length()
  let mut h = fnv1a_mix_u64(14695981039346656037UL, n.to_int64().to_uint64())
  let mut i = 0
  while i < n {
    h = fnv1a_mix_u64(h, self.comparators[i].hash())
    i = i + 1
  }
  h
}
