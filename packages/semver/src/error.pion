///| Error formatting and UTF-8 scalar extraction matching `dtolnay/semver`.

fn position_name(pos : Position) -> String {
  match pos {
    Position::Major => "major version number"
    Position::Minor => "minor version number"
    Position::Patch => "patch version number"
    Position::Pre => "pre-release identifier"
    Position::Build => "build metadata"
  }
}

///| Decode the first UTF-8 scalar value at `idx` in `text`, returning `(codepoint, byte_len)`.
fn decode_utf8_at(text : String, idx : Int) -> (Int, Int) {
  let n = text.length()
  if idx >= n {
    return (0, 0)
  }
  let b0 = text.code_unit_at(idx)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if (b0 & 0xE0) == 0xC0 && idx + 1 < n {
    let b1 = text.code_unit_at(idx + 1)
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    return (cp, 2)
  }
  if (b0 & 0xF0) == 0xE0 && idx + 2 < n {
    let b1 = text.code_unit_at(idx + 1)
    let b2 = text.code_unit_at(idx + 2)
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    return (cp, 3)
  }
  if (b0 & 0xF8) == 0xF0 && idx + 3 < n {
    let b1 = text.code_unit_at(idx + 1)
    let b2 = text.code_unit_at(idx + 2)
    let b3 = text.code_unit_at(idx + 3)
    let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    return (cp, 4)
  }
  (b0, 1)
}

fn quote_char_at(text : String, idx : Int) -> (Int, String) {
  let (cp, clen) = decode_utf8_at(text, idx)
  if cp == 0 {
    return (0, "'\\0'")
  }
  if cp == 9 {
    return (9, "'\\t'")
  }
  if cp == 10 {
    return (10, "'\\n'")
  }
  if cp == 13 {
    return (13, "'\\r'")
  }
  if cp == 39 {
    return (39, "'\\''")
  }
  if cp == 92 {
    return (92, "'\\\\'")
  }
  let sb = StringBuilder::with_capacity(clen + 2)
  sb.write_byte((39).to_byte())
  if clen > 0 {
    sb.write_substring(text, idx, idx + clen)
  }
  sb.write_byte((39).to_byte())
  (cp, sb.to_string())
}

fn err_empty() -> SemverError {
  SemverError::{
    kind: SemverErrorKind::Empty,
    message: "empty string, expected a semver version",
  }
}

fn err_unexpected_end(pos : Position) -> SemverError {
  SemverError::{
    kind: SemverErrorKind::UnexpectedEnd(pos),
    message: "unexpected end of input while parsing " + position_name(pos),
  }
}

fn err_unexpected_char(pos : Position, text : String, idx : Int) -> SemverError {
  let (cp, q) = quote_char_at(text, idx)
  SemverError::{
    kind: SemverErrorKind::UnexpectedChar(pos, cp),
    message: "unexpected character " + q + " while parsing " + position_name(pos),
  }
}

fn err_unexpected_char_after(pos : Position, text : String, idx : Int) -> SemverError {
  let (cp, q) = quote_char_at(text, idx)
  SemverError::{
    kind: SemverErrorKind::UnexpectedCharAfter(pos, cp),
    message: "unexpected character " + q + " after " + position_name(pos),
  }
}

fn err_expected_comma_found(pos : Position, text : String, idx : Int) -> SemverError {
  let (cp, q) = quote_char_at(text, idx)
  SemverError::{
    kind: SemverErrorKind::ExpectedCommaFound(pos, cp),
    message: "expected comma after " + position_name(pos) + ", found " + q,
  }
}

fn err_leading_zero(pos : Position) -> SemverError {
  SemverError::{
    kind: SemverErrorKind::LeadingZero(pos),
    message: "invalid leading zero in " + position_name(pos),
  }
}

fn err_overflow(pos : Position) -> SemverError {
  SemverError::{
    kind: SemverErrorKind::Overflow(pos),
    message: "value of " + position_name(pos) + " exceeds Int64::MAX",
  }
}

fn err_empty_segment(pos : Position) -> SemverError {
  SemverError::{
    kind: SemverErrorKind::EmptySegment(pos),
    message: "empty identifier segment in " + position_name(pos),
  }
}

fn err_illegal_char(pos : Position) -> SemverError {
  SemverError::{
    kind: SemverErrorKind::IllegalCharacter(pos),
    message: "unexpected character in " + position_name(pos),
  }
}

fn err_wildcard_not_only(ch : Int) -> SemverError {
  let sb = StringBuilder::with_capacity(64)
  sb.write_string("wildcard req (")
  sb.write_byte(ch.to_byte())
  sb.write_string(") must be the only comparator in the version req")
  SemverError::{
    kind: SemverErrorKind::WildcardNotTheOnlyComparator(ch),
    message: sb.to_string(),
  }
}

fn err_unexpected_after_wildcard() -> SemverError {
  SemverError::{
    kind: SemverErrorKind::UnexpectedAfterWildcard,
    message: "unexpected character after wildcard in version req",
  }
}

fn err_excessive_comparators() -> SemverError {
  SemverError::{
    kind: SemverErrorKind::ExcessiveComparators,
    message: "excessive number of version comparators",
  }
}
