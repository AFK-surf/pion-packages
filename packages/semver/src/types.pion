///| Core public types for the `semver` package (SemVer 2.0.0 + Cargo `VersionReq`).

///| Position within a SemVer version or comparator string where a parse error occurred.
pub enum Position {
  Major
  Minor
  Patch
  Pre
  Build
}

///| Structured error kind returned when parsing a `Version`, `VersionReq`, `Comparator`,
///| `Prerelease`, or `BuildMetadata`.
pub enum SemverErrorKind {
  Empty
  UnexpectedEnd(Position)
  UnexpectedChar(Position, Int)
  UnexpectedCharAfter(Position, Int)
  ExpectedCommaFound(Position, Int)
  LeadingZero(Position)
  Overflow(Position)
  EmptySegment(Position)
  IllegalCharacter(Position)
  WildcardNotTheOnlyComparator(Int)
  UnexpectedAfterWildcard
  ExcessiveComparators
  Unimplemented
}

///| Error returned when parsing a SemVer version, requirement, comparator, or identifier.
pub val struct SemverError {
  pub kind : SemverErrorKind
  pub message : String
}

///|
pub fn SemverError::to_string(self : SemverError) -> String {
  self.message
}

///| Maximum number of comparators allowed in a single `VersionReq` (matches `dtolnay/semver`).
pub fn max_comparators() -> Int {
  32
}

///| Optional pre-release identifier on a SemVer version (e.g. `alpha.1` in `1.0.0-alpha.1`).
pub val struct Prerelease {
  raw : String
}

let empty_pre_singleton : Prerelease = Prerelease::{ raw: "" }

let empty_build_singleton : BuildMetadata = BuildMetadata::{ raw: "" }

///|
pub fn Prerelease::empty() -> Prerelease {
  empty_pre_singleton
}

///|
pub fn Prerelease::as_str(self : Prerelease) -> String {
  self.raw
}

///|
pub fn Prerelease::is_empty(self : Prerelease) -> Bool {
  self.raw.length() == 0
}

///|
pub fn Prerelease::length(self : Prerelease) -> Int {
  self.raw.length()
}

///|
pub fn Prerelease::to_string(self : Prerelease) -> String {
  self.raw
}

///| Optional build metadata identifier on a SemVer version (e.g. `20130313144700` in `1.0.0+20130313144700`).
pub val struct BuildMetadata {
  raw : String
}

///|
pub fn BuildMetadata::empty() -> BuildMetadata {
  empty_build_singleton
}

///|
pub fn BuildMetadata::as_str(self : BuildMetadata) -> String {
  self.raw
}

///|
pub fn BuildMetadata::is_empty(self : BuildMetadata) -> Bool {
  self.raw.length() == 0
}

///|
pub fn BuildMetadata::length(self : BuildMetadata) -> Int {
  self.raw.length()
}

///|
pub fn BuildMetadata::to_string(self : BuildMetadata) -> String {
  self.raw
}

///| SemVer 2.0.0 version: `MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD]`.
pub val struct Version {
  pub major : Int64
  pub minor : Int64
  pub patch : Int64
  pub pre : Prerelease
  pub build : BuildMetadata
  pre_len : Int
  build_len : Int
}

///| Create a `Version` with empty pre-release and build metadata.
pub fn Version::new(major : Int64, minor : Int64, patch : Int64) -> Version {
  Version::{
    major: major,
    minor: minor,
    patch: patch,
    pre: empty_pre_singleton,
    build: empty_build_singleton,
    pre_len: 0,
    build_len: 0,
  }
}

///| Create a `Version` with explicit pre-release and build metadata.
pub fn Version::with_parts(
  major : Int64,
  minor : Int64,
  patch : Int64,
  pre : Prerelease,
  build : BuildMetadata,
) -> Version {
  Version::{
    major: major,
    minor: minor,
    patch: patch,
    pre: pre,
    build: build,
    pre_len: pre.raw.length(),
    build_len: build.raw.length(),
  }
}

///| Cargo SemVer comparison operator: `=`, `>`, `>=`, `<`, `<=`, `~`, `^`, `*`.
pub enum Op {
  Exact
  Greater
  GreaterEq
  Less
  LessEq
  Tilde
  Caret
  Wildcard
}

///|
pub fn Op::equals(self : Op, other : Op) -> Bool {
  match (self, other) {
    (Op::Exact, Op::Exact) => true
    (Op::Greater, Op::Greater) => true
    (Op::GreaterEq, Op::GreaterEq) => true
    (Op::Less, Op::Less) => true
    (Op::LessEq, Op::LessEq) => true
    (Op::Tilde, Op::Tilde) => true
    (Op::Caret, Op::Caret) => true
    (Op::Wildcard, Op::Wildcard) => true
    _ => false
  }
}

///| A single operator + partial version pair, e.g. `>=1.2.3`, forming one clause of a `VersionReq`.
pub val struct Comparator {
  pub op : Op
  pub major : Int64
  pub minor : Option[Int64]
  pub patch : Option[Int64]
  pub pre : Prerelease
}

///| A Cargo SemVer version requirement describing the intersection of zero or more `Comparator`s.
pub struct VersionReq {
  pub comparators : Array[Comparator]
  has_pre : Bool
  rel_empty : Bool
  lo_major : Int64
  lo_minor : Int64
  lo_patch : Int64
  hi_major : Int64
  hi_minor : Int64
  hi_patch : Int64
  pre_only_major : Int64
}

///| A `VersionReq` with no comparators (`*`).
pub fn VersionReq::star() -> VersionReq {
  VersionReq::{
    comparators: Array::new(),
    has_pre: false,
    rel_empty: false,
    lo_major: 0L,
    lo_minor: 0L,
    lo_patch: 0L,
    hi_major: 9223372036854775807L,
    hi_minor: 9223372036854775807L,
    hi_patch: 9223372036854775807L,
    pre_only_major: -1L,
  }
}

///| Default `VersionReq`, equivalent to `VersionReq::star()`.
pub fn VersionReq::default() -> VersionReq {
  VersionReq::star()
}
