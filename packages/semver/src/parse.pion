///| Zero-allocation byte-scanning parser for SemVer 2.0.0 and Cargo `VersionReq`.

fn skip_spaces(text : String, start : Int, len : Int) -> Int {
  let mut i = start
  while i < len && text.code_unit_at(i) == 32 {
    i = i + 1
  }
  i
}

fn is_wildcard_byte(b : Int) -> Bool {
  b == 42 || b == 120 || b == 88 // '*', 'x', 'X'
}

///| Scan a dot-separated pre-release or build metadata identifier starting at `start`.
///| Returns `Ok(end_idx)` where `[start..end_idx]` is the valid identifier (possibly empty).
fn scan_identifier(text : String, start : Int, len : Int, is_pre : Bool) -> Result[Int, SemverError] {
  let pos = if is_pre { Position::Pre } else { Position::Build }
  let mut acc = start
  let mut seg_len = 0
  let mut seg_has_nondigit = false
  while true {
    let idx = acc + seg_len
    if idx < len {
      let b = text.code_unit_at(idx)
      if b >= 48 && b <= 57 {
        seg_len = seg_len + 1
        continue
      }
      if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 {
        seg_len = seg_len + 1
        seg_has_nondigit = true
        continue
      }
      // Boundary character
      if seg_len == 0 {
        if acc == start && b != 46 {
          return Ok(start)
        }
        return Err(err_empty_segment(pos))
      }
      if is_pre && seg_len > 1 && !seg_has_nondigit && text.code_unit_at(acc) == 48 {
        return Err(err_leading_zero(pos))
      }
      acc = acc + seg_len
      if b == 46 {
        acc = acc + 1
        seg_len = 0
        seg_has_nondigit = false
        continue
      }
      return Ok(acc)
    } else {
      // End of input
      if seg_len == 0 {
        if acc == start {
          return Ok(start)
        }
        return Err(err_empty_segment(pos))
      }
      if is_pre && seg_len > 1 && !seg_has_nondigit && text.code_unit_at(acc) == 48 {
        return Err(err_leading_zero(pos))
      }
      return Ok(acc + seg_len)
    }
  }
  Ok(start)
}

fn slice_ident(text : String, start : Int, end : Int) -> String {
  if start == end {
    ""
  } else if start == 0 && end == text.length() {
    text
  } else {
    text.slice(start, end)
  }
}

///| Parse and validate a standalone `Prerelease` identifier (empty string is valid and returns `Prerelease::empty()`).
pub fn Prerelease::new(text : String) -> Result[Prerelease, SemverError] {
  let len = text.length()
  let end = match scan_identifier(text, 0, len, true) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  if end != len {
    return Err(err_illegal_char(Position::Pre))
  }
  if len == 0 {
    Ok(empty_pre_singleton)
  } else {
    Ok(Prerelease::{ raw: text })
  }
}

///| Parse and validate a standalone `BuildMetadata` identifier (empty string is valid and returns `BuildMetadata::empty()`).
pub fn BuildMetadata::new(text : String) -> Result[BuildMetadata, SemverError] {
  let len = text.length()
  let end = match scan_identifier(text, 0, len, false) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  if end != len {
    return Err(err_illegal_char(Position::Build))
  }
  if len == 0 {
    Ok(empty_build_singleton)
  } else {
    Ok(BuildMetadata::{ raw: text })
  }
}

///| Parse a strict SemVer 2.0.0 `Version` string.
pub fn Version::parse(text : String) -> Result[Version, SemverError] {
  let len = text.length()
  if len == 0 {
    return Err(err_empty())
  }

  // Inline major (u64::MAX = 18446744073709551615)
  let mut idx = 0
  let mut major : UInt64 = 0UL
  let mut count = 0
  while idx < len {
    let b = text.code_unit_at(idx)
    if b < 48 || b > 57 {
      break
    }
    if major == 0UL && count > 0 {
      return Err(err_leading_zero(Position::Major))
    }
    let d = (b - 48).to_int64().to_uint64()
    if major > 1844674407370955161UL || (major == 1844674407370955161UL && d > 5UL) {
      return Err(err_overflow(Position::Major))
    }
    major = major * 10UL + d
    idx = idx + 1
    count = count + 1
  }
  if count == 0 {
    return Err(err_unexpected_char(Position::Major, text, idx))
  }
  if idx >= len {
    return Err(err_unexpected_end(Position::Major))
  }
  if text.code_unit_at(idx) != 46 {
    return Err(err_unexpected_char_after(Position::Major, text, idx))
  }
  idx = idx + 1

  // Inline minor
  let mut minor : UInt64 = 0UL
  count = 0
  while idx < len {
    let b = text.code_unit_at(idx)
    if b < 48 || b > 57 {
      break
    }
    if minor == 0UL && count > 0 {
      return Err(err_leading_zero(Position::Minor))
    }
    let d = (b - 48).to_int64().to_uint64()
    if minor > 1844674407370955161UL || (minor == 1844674407370955161UL && d > 5UL) {
      return Err(err_overflow(Position::Minor))
    }
    minor = minor * 10UL + d
    idx = idx + 1
    count = count + 1
  }
  if count == 0 {
    if idx < len {
      return Err(err_unexpected_char(Position::Minor, text, idx))
    }
    return Err(err_unexpected_end(Position::Minor))
  }
  if idx >= len {
    return Err(err_unexpected_end(Position::Minor))
  }
  if text.code_unit_at(idx) != 46 {
    return Err(err_unexpected_char_after(Position::Minor, text, idx))
  }
  idx = idx + 1

  // Inline patch
  let mut patch : UInt64 = 0UL
  count = 0
  while idx < len {
    let b = text.code_unit_at(idx)
    if b < 48 || b > 57 {
      break
    }
    if patch == 0UL && count > 0 {
      return Err(err_leading_zero(Position::Patch))
    }
    let d = (b - 48).to_int64().to_uint64()
    if patch > 1844674407370955161UL || (patch == 1844674407370955161UL && d > 5UL) {
      return Err(err_overflow(Position::Patch))
    }
    patch = patch * 10UL + d
    idx = idx + 1
    count = count + 1
  }
  if count == 0 {
    if idx < len {
      return Err(err_unexpected_char(Position::Patch, text, idx))
    }
    return Err(err_unexpected_end(Position::Patch))
  }
  if idx == len {
    return Ok(Version::{
      major: major,
      minor: minor,
      patch: patch,
      pre: empty_pre_singleton,
      build: empty_build_singleton,
    })
  }

  let mut pos = Position::Patch
  let mut pre_val = empty_pre_singleton
  if text.code_unit_at(idx) == 45 {
    // '-'
    pos = Position::Pre
    let pre_start = idx + 1
    let pre_end = match scan_identifier(text, pre_start, len, true) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    if pre_end == pre_start {
      return Err(err_empty_segment(Position::Pre))
    }
    pre_val = Prerelease::{ raw: slice_ident(text, pre_start, pre_end) }
    idx = pre_end
  }

  let mut build_val = empty_build_singleton
  if idx < len && text.code_unit_at(idx) == 43 {
    // '+'
    pos = Position::Build
    let build_start = idx + 1
    let build_end = match scan_identifier(text, build_start, len, false) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    if build_end == build_start {
      return Err(err_empty_segment(Position::Build))
    }
    build_val = BuildMetadata::{ raw: slice_ident(text, build_start, build_end) }
    idx = build_end
  }

  if idx < len {
    return Err(err_unexpected_char_after(pos, text, idx))
  }

  Ok(Version::{
    major: major,
    minor: minor,
    patch: patch,
    pre: pre_val,
    build: build_val,
  })
}

fn parse_comparator_at(
  text : String,
  start : Int,
  len : Int,
) -> Result[(Comparator, Position, Int), SemverError] {
  let mut idx = start
  let mut op = Op::Caret
  let mut default_op = true
  if idx < len {
    let b0 = text.code_unit_at(idx)
    if b0 == 61 {
      // '='
      op = Op::Exact
      idx = idx + 1
      default_op = false
    } else if b0 == 62 {
      // '>'
      if idx + 1 < len && text.code_unit_at(idx + 1) == 61 {
        op = Op::GreaterEq
        idx = idx + 2
      } else {
        op = Op::Greater
        idx = idx + 1
      }
      default_op = false
    } else if b0 == 60 {
      // '<'
      if idx + 1 < len && text.code_unit_at(idx + 1) == 61 {
        op = Op::LessEq
        idx = idx + 2
      } else {
        op = Op::Less
        idx = idx + 1
      }
      default_op = false
    } else if b0 == 126 {
      // '~'
      op = Op::Tilde
      idx = idx + 1
      default_op = false
    } else if b0 == 94 {
      // '^'
      op = Op::Caret
      idx = idx + 1
      default_op = false
    }
  }

  while idx < len && text.code_unit_at(idx) == 32 {
    idx = idx + 1
  }

  let mut pos = Position::Major
  let mut major : UInt64 = 0UL
  let mut count = 0
  while idx < len {
    let b = text.code_unit_at(idx)
    if b < 48 || b > 57 {
      break
    }
    if major == 0UL && count > 0 {
      return Err(err_leading_zero(Position::Major))
    }
    let d = (b - 48).to_int64().to_uint64()
    if major > 1844674407370955161UL || (major == 1844674407370955161UL && d > 5UL) {
      return Err(err_overflow(Position::Major))
    }
    major = major * 10UL + d
    idx = idx + 1
    count = count + 1
  }
  if count == 0 {
    if idx < len {
      return Err(err_unexpected_char(Position::Major, text, idx))
    }
    return Err(err_unexpected_end(Position::Major))
  }

  let mut has_wildcard = false
  let mut minor : Option[UInt64] = None
  if idx < len && text.code_unit_at(idx) == 46 {
    idx = idx + 1
    pos = Position::Minor
    if idx < len && is_wildcard_byte(text.code_unit_at(idx)) {
      has_wildcard = true
      if default_op {
        op = Op::Wildcard
      }
      idx = idx + 1
    } else {
      let mut m : UInt64 = 0UL
      count = 0
      while idx < len {
        let b = text.code_unit_at(idx)
        if b < 48 || b > 57 {
          break
        }
        if m == 0UL && count > 0 {
          return Err(err_leading_zero(Position::Minor))
        }
        let d = (b - 48).to_int64().to_uint64()
        if m > 1844674407370955161UL || (m == 1844674407370955161UL && d > 5UL) {
          return Err(err_overflow(Position::Minor))
        }
        m = m * 10UL + d
        idx = idx + 1
        count = count + 1
      }
      if count == 0 {
        if idx < len {
          return Err(err_unexpected_char(Position::Minor, text, idx))
        }
        return Err(err_unexpected_end(Position::Minor))
      }
      minor = Some(m)
    }
  }

  let mut patch : Option[UInt64] = None
  let mut has_patch = false
  if idx < len && text.code_unit_at(idx) == 46 {
    idx = idx + 1
    pos = Position::Patch
    if idx < len && is_wildcard_byte(text.code_unit_at(idx)) {
      if default_op {
        op = Op::Wildcard
      }
      idx = idx + 1
    } else if has_wildcard {
      return Err(err_unexpected_after_wildcard())
    } else {
      let mut p : UInt64 = 0UL
      count = 0
      while idx < len {
        let b = text.code_unit_at(idx)
        if b < 48 || b > 57 {
          break
        }
        if p == 0UL && count > 0 {
          return Err(err_leading_zero(Position::Patch))
        }
        let d = (b - 48).to_int64().to_uint64()
        if p > 1844674407370955161UL || (p == 1844674407370955161UL && d > 5UL) {
          return Err(err_overflow(Position::Patch))
        }
        p = p * 10UL + d
        idx = idx + 1
        count = count + 1
      }
      if count == 0 {
        if idx < len {
          return Err(err_unexpected_char(Position::Patch, text, idx))
        }
        return Err(err_unexpected_end(Position::Patch))
      }
      patch = Some(p)
      has_patch = true
    }
  }

  let mut pre_val = empty_pre_singleton
  if has_patch && idx < len && text.code_unit_at(idx) == 45 {
    pos = Position::Pre
    let pre_start = idx + 1
    let pre_end = match scan_identifier(text, pre_start, len, true) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    if pre_end == pre_start {
      return Err(err_empty_segment(Position::Pre))
    }
    pre_val = Prerelease::{ raw: slice_ident(text, pre_start, pre_end) }
    idx = pre_end
  }

  if has_patch && idx < len && text.code_unit_at(idx) == 43 {
    pos = Position::Build
    let build_start = idx + 1
    let build_end = match scan_identifier(text, build_start, len, false) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    if build_end == build_start {
      return Err(err_empty_segment(Position::Build))
    }
    idx = build_end
  }

  while idx < len && text.code_unit_at(idx) == 32 {
    idx = idx + 1
  }

  let cmp = Comparator::{
    op: op,
    major: major,
    minor: minor,
    patch: patch,
    pre: pre_val,
  }
  Ok((cmp, pos, idx))
}

///| Parse a single Cargo `Comparator`.
pub fn Comparator::parse(text : String) -> Result[Comparator, SemverError] {
  let len = text.length()
  let start = skip_spaces(text, 0, len)
  let (cmp, pos, idx) = match parse_comparator_at(text, start, len) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if idx < len {
    return Err(err_unexpected_char_after(pos, text, idx))
  }
  Ok(cmp)
}

///| Parse a Cargo `VersionReq` (comma-separated comparators or `*` / `x` / `X`).
pub fn VersionReq::parse(text : String) -> Result[VersionReq, SemverError] {
  let len = text.length()
  let mut idx = skip_spaces(text, 0, len)

  if idx < len && is_wildcard_byte(text.code_unit_at(idx)) {
    let ch = text.code_unit_at(idx)
    let rest = skip_spaces(text, idx + 1, len)
    if rest == len {
      return Ok(VersionReq::star())
    } else if text.code_unit_at(rest) == 44 {
      return Err(err_wildcard_not_only(ch))
    } else {
      return Err(err_unexpected_after_wildcard())
    }
  }

  let comparators : Array[Comparator] = Array::new()
  while true {
    let comp_start = idx
    let mut op = Op::Caret
    let mut default_op = true
    if idx < len {
      let b0 = text.code_unit_at(idx)
      if b0 == 61 {
        op = Op::Exact
        idx = idx + 1
        default_op = false
      } else if b0 == 62 {
        if idx + 1 < len && text.code_unit_at(idx + 1) == 61 {
          op = Op::GreaterEq
          idx = idx + 2
        } else {
          op = Op::Greater
          idx = idx + 1
        }
        default_op = false
      } else if b0 == 60 {
        if idx + 1 < len && text.code_unit_at(idx + 1) == 61 {
          op = Op::LessEq
          idx = idx + 2
        } else {
          op = Op::Less
          idx = idx + 1
        }
        default_op = false
      } else if b0 == 126 {
        op = Op::Tilde
        idx = idx + 1
        default_op = false
      } else if b0 == 94 {
        op = Op::Caret
        idx = idx + 1
        default_op = false
      }
    }

    while idx < len && text.code_unit_at(idx) == 32 {
      idx = idx + 1
    }

    let mut pos = Position::Major
    let mut major : UInt64 = 0UL
    let mut count = 0
    while idx < len {
      let b = text.code_unit_at(idx)
      if b < 48 || b > 57 {
        break
      }
      if major == 0UL && count > 0 {
        return Err(err_leading_zero(Position::Major))
      }
      let d = (b - 48).to_int64().to_uint64()
      if major > 1844674407370955161UL || (major == 1844674407370955161UL && d > 5UL) {
        return Err(err_overflow(Position::Major))
      }
      major = major * 10UL + d
      idx = idx + 1
      count = count + 1
    }
    if count == 0 {
      if comp_start < len && is_wildcard_byte(text.code_unit_at(comp_start)) {
        let ch = text.code_unit_at(comp_start)
        let rest = skip_spaces(text, comp_start + 1, len)
        if rest == len || text.code_unit_at(rest) == 44 {
          return Err(err_wildcard_not_only(ch))
        }
      }
      if idx < len {
        return Err(err_unexpected_char(Position::Major, text, idx))
      }
      return Err(err_unexpected_end(Position::Major))
    }

    let mut has_wildcard = false
    let mut minor : Option[UInt64] = None
    if idx < len && text.code_unit_at(idx) == 46 {
      idx = idx + 1
      pos = Position::Minor
      if idx < len && is_wildcard_byte(text.code_unit_at(idx)) {
        has_wildcard = true
        if default_op {
          op = Op::Wildcard
        }
        idx = idx + 1
      } else {
        let mut m : UInt64 = 0UL
        count = 0
        while idx < len {
          let b = text.code_unit_at(idx)
          if b < 48 || b > 57 {
            break
          }
          if m == 0UL && count > 0 {
            return Err(err_leading_zero(Position::Minor))
          }
          let d = (b - 48).to_int64().to_uint64()
          if m > 1844674407370955161UL || (m == 1844674407370955161UL && d > 5UL) {
            return Err(err_overflow(Position::Minor))
          }
          m = m * 10UL + d
          idx = idx + 1
          count = count + 1
        }
        if count == 0 {
          if idx < len {
            return Err(err_unexpected_char(Position::Minor, text, idx))
          }
          return Err(err_unexpected_end(Position::Minor))
        }
        minor = Some(m)
      }
    }

    let mut patch : Option[UInt64] = None
    let mut has_patch = false
    if idx < len && text.code_unit_at(idx) == 46 {
      idx = idx + 1
      pos = Position::Patch
      if idx < len && is_wildcard_byte(text.code_unit_at(idx)) {
        if default_op {
          op = Op::Wildcard
        }
        idx = idx + 1
      } else if has_wildcard {
        return Err(err_unexpected_after_wildcard())
      } else {
        let mut p : UInt64 = 0UL
        count = 0
        while idx < len {
          let b = text.code_unit_at(idx)
          if b < 48 || b > 57 {
            break
          }
          if p == 0UL && count > 0 {
            return Err(err_leading_zero(Position::Patch))
          }
          let d = (b - 48).to_int64().to_uint64()
          if p > 1844674407370955161UL || (p == 1844674407370955161UL && d > 5UL) {
            return Err(err_overflow(Position::Patch))
          }
          p = p * 10UL + d
          idx = idx + 1
          count = count + 1
        }
        if count == 0 {
          if idx < len {
            return Err(err_unexpected_char(Position::Patch, text, idx))
          }
          return Err(err_unexpected_end(Position::Patch))
        }
        patch = Some(p)
        has_patch = true
      }
    }

    let mut pre_val = empty_pre_singleton
    if has_patch && idx < len && text.code_unit_at(idx) == 45 {
      pos = Position::Pre
      let pre_start = idx + 1
      let pre_end = match scan_identifier(text, pre_start, len, true) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      if pre_end == pre_start {
        return Err(err_empty_segment(Position::Pre))
      }
      pre_val = Prerelease::{ raw: slice_ident(text, pre_start, pre_end) }
      idx = pre_end
    }

    if has_patch && idx < len && text.code_unit_at(idx) == 43 {
      pos = Position::Build
      let build_start = idx + 1
      let build_end = match scan_identifier(text, build_start, len, false) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      if build_end == build_start {
        return Err(err_empty_segment(Position::Build))
      }
      idx = build_end
    }

    while idx < len && text.code_unit_at(idx) == 32 {
      idx = idx + 1
    }

    comparators.push(Comparator::{
      op: op,
      major: major,
      minor: minor,
      patch: patch,
      pre: pre_val,
    })

    if idx == len {
      return Ok(VersionReq::{ comparators: comparators })
    }
    if text.code_unit_at(idx) != 44 {
      return Err(err_expected_comma_found(pos, text, idx))
    }
    if comparators.length() >= 32 {
      return Err(err_excessive_comparators())
    }
    idx = skip_spaces(text, idx + 1, len)
  }
  Ok(VersionReq::{ comparators: comparators })
}
