///| Cargo `VersionReq` and `Comparator` matching engine (100% aligned with `dtolnay/semver`).
///| Evaluates `comparators` live with zero stale caches and zero overflow arithmetic across full `u64`.

fn matches_exact(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if ver.minor != m {
        return false
      }
    }
    None => ()
  }
  match cmp.patch {
    Some(p) => {
      if ver.patch != p {
        return false
      }
    }
    None => ()
  }
  ver.pre.raw == cmp.pre.raw
}

fn matches_greater(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return ver.major > cmp.major
  }
  match cmp.minor {
    None => return false
    Some(m) => {
      if ver.minor != m {
        return ver.minor > m
      }
    }
  }
  match cmp.patch {
    None => return false
    Some(p) => {
      if ver.patch != p {
        return ver.patch > p
      }
    }
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) > 0
}

fn matches_less(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return ver.major < cmp.major
  }
  match cmp.minor {
    None => return false
    Some(m) => {
      if ver.minor != m {
        return ver.minor < m
      }
    }
  }
  match cmp.patch {
    None => return false
    Some(p) => {
      if ver.patch != p {
        return ver.patch < p
      }
    }
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) < 0
}

fn matches_tilde(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if ver.minor != m {
        return false
      }
    }
    None => ()
  }
  match cmp.patch {
    Some(p) => {
      if ver.patch != p {
        return ver.patch > p
      }
    }
    None => ()
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) >= 0
}

fn matches_caret(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  let minor = match cmp.minor {
    None => return true
    Some(m) => m
  }
  let patch = match cmp.patch {
    None => {
      if cmp.major > 0UL {
        return ver.minor >= minor
      } else {
        return ver.minor == minor
      }
    }
    Some(p) => p
  }

  if cmp.major > 0UL {
    if ver.minor != minor {
      return ver.minor > minor
    }
    if ver.patch != patch {
      return ver.patch > patch
    }
  } else if minor > 0UL {
    if ver.minor != minor {
      return false
    }
    if ver.patch != patch {
      return ver.patch > patch
    }
  } else if ver.minor != minor || ver.patch != patch {
    return false
  }

  compare_pre_raw(ver.pre.raw, cmp.pre.raw) >= 0
}

fn matches_impl(cmp : Comparator, ver : Version) -> Bool {
  match cmp.op {
    Op::Exact => matches_exact(cmp, ver)
    Op::Wildcard => matches_exact(cmp, ver)
    Op::Greater => matches_greater(cmp, ver)
    Op::GreaterEq => matches_exact(cmp, ver) || matches_greater(cmp, ver)
    Op::Less => matches_less(cmp, ver)
    Op::LessEq => matches_exact(cmp, ver) || matches_less(cmp, ver)
    Op::Tilde => matches_tilde(cmp, ver)
    Op::Caret => matches_caret(cmp, ver)
  }
}

///| Fast path for release versions (`ver.pre.is_empty()`): avoids all prerelease string comparisons.
#verify
fn matches_release(cmp : Comparator, ver : Version) -> Bool {
  match cmp.op {
    Op::Caret => {
      if ver.major != cmp.major {
        return false
      }
      let minor = match cmp.minor {
        None => return true
        Some(m) => m
      }
      let patch = match cmp.patch {
        None => {
          if cmp.major > 0UL {
            return ver.minor >= minor
          } else {
            return ver.minor == minor
          }
        }
        Some(p) => p
      }
      if cmp.major > 0UL {
        if ver.minor != minor {
          ver.minor > minor
        } else {
          ver.patch >= patch
        }
      } else if minor > 0UL {
        ver.minor == minor && ver.patch >= patch
      } else {
        ver.minor == 0UL && ver.patch == patch
      }
    }
    Op::GreaterEq => {
      if ver.major != cmp.major {
        return ver.major > cmp.major
      }
      match cmp.minor {
        None => true
        Some(m) => {
          if ver.minor != m {
            return ver.minor > m
          }
          match cmp.patch {
            None => true
            Some(p) => ver.patch >= p
          }
        }
      }
    }
    Op::Less => {
      if ver.major != cmp.major {
        return ver.major < cmp.major
      }
      match cmp.minor {
        None => false
        Some(m) => {
          if ver.minor != m {
            return ver.minor < m
          }
          match cmp.patch {
            None => false
            Some(p) => ver.patch < p
          }
        }
      }
    }
    Op::Tilde => {
      if ver.major != cmp.major {
        return false
      }
      match cmp.minor {
        None => true
        Some(m) => {
          if ver.minor != m {
            return false
          }
          match cmp.patch {
            None => true
            Some(p) => ver.patch >= p
          }
        }
      }
    }
    Op::Exact | Op::Wildcard => {
      if ver.major != cmp.major {
        return false
      }
      match cmp.minor {
        Some(m) => {
          if ver.minor != m {
            return false
          }
        }
        None => ()
      }
      match cmp.patch {
        Some(p) => {
          if ver.patch != p {
            return false
          }
        }
        None => ()
      }
      cmp.pre.raw.length() == 0
    }
    Op::Greater => {
      if ver.major != cmp.major {
        return ver.major > cmp.major
      }
      match cmp.minor {
        None => false
        Some(m) => {
          if ver.minor != m {
            return ver.minor > m
          }
          match cmp.patch {
            None => false
            Some(p) => {
              if ver.patch != p {
                ver.patch > p
              } else {
                cmp.pre.raw.length() > 0
              }
            }
          }
        }
      }
    }
    Op::LessEq => {
      if ver.major != cmp.major {
        return ver.major < cmp.major
      }
      match cmp.minor {
        None => true
        Some(m) => {
          if ver.minor != m {
            return ver.minor < m
          }
          match cmp.patch {
            None => true
            Some(p) => {
              if ver.patch != p {
                ver.patch < p
              } else {
                cmp.pre.raw.length() == 0
              }
            }
          }
        }
      }
    }
  }
}

#verify
fn pre_is_compatible(cmp : Comparator, ver : Version) -> Bool {
  if cmp.major != ver.major || cmp.pre.raw.length() == 0 {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if m != ver.minor {
        return false
      }
    }
    None => return false
  }
  match cmp.patch {
    Some(p) => p == ver.patch
    None => false
  }
}

///| Evaluate whether `version` satisfies this single `Comparator`.
pub fn Comparator::matches(self : Comparator, version : Version) -> Bool {
  if version.pre.raw.length() == 0 {
    return matches_release(self, version)
  }
  matches_impl(self, version) && pre_is_compatible(self, version)
}

fn matches_pre_slow(comps : Array[Comparator], n : Int, version : Version) -> Bool {
  let mut i = 0
  while i < n {
    if !matches_impl(comps[i], version) {
      return false
    }
    i = i + 1
  }
  let mut j = 0
  while j < n {
    if pre_is_compatible(comps[j], version) {
      return true
    }
    j = j + 1
  }
  false
}

///| Evaluate whether `version` satisfies all comparators in this `VersionReq`.
pub fn VersionReq::matches(self : VersionReq, version : Version) -> Bool {
  let n = self.comparators.length()
  if version.pre.raw.length() != 0 {
    return matches_pre_slow(self.comparators, n, version)
  }
  let v_maj = version.major
  let v_min = version.minor
  let v_pat = version.patch
  let mut i = 0
  while i < n {
    let cmp = self.comparators[i]
    let ok = match cmp.op {
      Op::Caret => {
        if v_maj != cmp.major {
          false
        } else {
          match cmp.minor {
            None => true
            Some(m) => {
              match cmp.patch {
                None => if cmp.major > 0UL { v_min >= m } else { v_min == m }
                Some(p) => {
                  if cmp.major > 0UL {
                    if v_min != m { v_min > m } else { v_pat >= p }
                  } else if m > 0UL {
                    v_min == m && v_pat >= p
                  } else {
                    v_min == 0UL && v_pat == p
                  }
                }
              }
            }
          }
        }
      }
      Op::GreaterEq => {
        if v_maj != cmp.major {
          v_maj > cmp.major
        } else {
          match cmp.minor {
            None => true
            Some(m) => {
              if v_min != m {
                v_min > m
              } else {
                match cmp.patch {
                  None => true
                  Some(p) => v_pat >= p
                }
              }
            }
          }
        }
      }
      Op::Less => {
        if v_maj != cmp.major {
          v_maj < cmp.major
        } else {
          match cmp.minor {
            None => false
            Some(m) => {
              if v_min != m {
                v_min < m
              } else {
                match cmp.patch {
                  None => false
                  Some(p) => v_pat < p
                }
              }
            }
          }
        }
      }
      Op::Tilde => {
        if v_maj != cmp.major {
          false
        } else {
          match cmp.minor {
            None => true
            Some(m) => {
              if v_min != m {
                false
              } else {
                match cmp.patch {
                  None => true
                  Some(p) => v_pat >= p
                }
              }
            }
          }
        }
      }
      Op::Exact | Op::Wildcard => {
        if v_maj != cmp.major {
          false
        } else {
          let m_ok = match cmp.minor {
            None => true
            Some(m) => v_min == m
          }
          if !m_ok {
            false
          } else {
            let p_ok = match cmp.patch {
              None => true
              Some(p) => v_pat == p
            }
            p_ok && cmp.pre.raw.length() == 0
          }
        }
      }
      Op::Greater => {
        if v_maj != cmp.major {
          v_maj > cmp.major
        } else {
          match cmp.minor {
            None => false
            Some(m) => {
              if v_min != m {
                v_min > m
              } else {
                match cmp.patch {
                  None => false
                  Some(p) => if v_pat != p { v_pat > p } else { cmp.pre.raw.length() > 0 }
                }
              }
            }
          }
        }
      }
      Op::LessEq => {
        if v_maj != cmp.major {
          v_maj < cmp.major
        } else {
          match cmp.minor {
            None => true
            Some(m) => {
              if v_min != m {
                v_min < m
              } else {
                match cmp.patch {
                  None => true
                  Some(p) => if v_pat != p { v_pat < p } else { cmp.pre.raw.length() == 0 }
                }
              }
            }
          }
        }
      }
    }
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}
