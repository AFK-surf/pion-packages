///| Cargo `VersionReq` and `Comparator` matching engine (100% aligned with `dtolnay/semver`).

fn matches_exact(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if ver.minor != m {
        return false
      }
    }
    None => ()
  }
  match cmp.patch {
    Some(p) => {
      if ver.patch != p {
        return false
      }
    }
    None => ()
  }
  ver.pre.raw == cmp.pre.raw
}

fn matches_greater(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return ver.major > cmp.major
  }
  match cmp.minor {
    None => return false
    Some(m) => {
      if ver.minor != m {
        return ver.minor > m
      }
    }
  }
  match cmp.patch {
    None => return false
    Some(p) => {
      if ver.patch != p {
        return ver.patch > p
      }
    }
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) > 0
}

fn matches_less(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return ver.major < cmp.major
  }
  match cmp.minor {
    None => return false
    Some(m) => {
      if ver.minor != m {
        return ver.minor < m
      }
    }
  }
  match cmp.patch {
    None => return false
    Some(p) => {
      if ver.patch != p {
        return ver.patch < p
      }
    }
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) < 0
}

fn matches_tilde(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if ver.minor != m {
        return false
      }
    }
    None => ()
  }
  match cmp.patch {
    Some(p) => {
      if ver.patch != p {
        return ver.patch > p
      }
    }
    None => ()
  }
  compare_pre_raw(ver.pre.raw, cmp.pre.raw) >= 0
}

fn matches_caret(cmp : Comparator, ver : Version) -> Bool {
  if ver.major != cmp.major {
    return false
  }
  let minor = match cmp.minor {
    None => return true
    Some(m) => m
  }
  let patch = match cmp.patch {
    None => {
      if cmp.major > 0L {
        return ver.minor >= minor
      } else {
        return ver.minor == minor
      }
    }
    Some(p) => p
  }

  if cmp.major > 0L {
    if ver.minor != minor {
      return ver.minor > minor
    }
    if ver.patch != patch {
      return ver.patch > patch
    }
  } else if minor > 0L {
    if ver.minor != minor {
      return false
    }
    if ver.patch != patch {
      return ver.patch > patch
    }
  } else if ver.minor != minor || ver.patch != patch {
    return false
  }

  compare_pre_raw(ver.pre.raw, cmp.pre.raw) >= 0
}

fn matches_impl(cmp : Comparator, ver : Version) -> Bool {
  match cmp.op {
    Op::Exact => matches_exact(cmp, ver)
    Op::Wildcard => matches_exact(cmp, ver)
    Op::Greater => matches_greater(cmp, ver)
    Op::GreaterEq => matches_exact(cmp, ver) || matches_greater(cmp, ver)
    Op::Less => matches_less(cmp, ver)
    Op::LessEq => matches_exact(cmp, ver) || matches_less(cmp, ver)
    Op::Tilde => matches_tilde(cmp, ver)
    Op::Caret => matches_caret(cmp, ver)
  }
}

fn pre_is_compatible(cmp : Comparator, ver : Version) -> Bool {
  if cmp.major != ver.major || cmp.pre.raw.length() == 0 {
    return false
  }
  match cmp.minor {
    Some(m) => {
      if m != ver.minor {
        return false
      }
    }
    None => return false
  }
  match cmp.patch {
    Some(p) => p == ver.patch
    None => false
  }
}

///| Evaluate whether `version` satisfies this single `Comparator`.
pub fn Comparator::matches(self : Comparator, version : Version) -> Bool {
  matches_impl(self, version) && (version.pre.raw.length() == 0 || pre_is_compatible(self, version))
}

///| Build a `VersionReq` with precomputed O(1) release-version interval bounds.
fn build_version_req(comparators : Array[Comparator]) -> VersionReq {
  let max_i64 : Int64 = 9223372036854775807L
  let mut has_pre = false
  let mut pre_only_major : Int64 = -2L
  let mut rel_empty = false
  let mut lo_maj : Int64 = 0L
  let mut lo_min : Int64 = 0L
  let mut lo_pat : Int64 = 0L
  let mut hi_maj : Int64 = max_i64
  let mut hi_min : Int64 = max_i64
  let mut hi_pat : Int64 = max_i64

  let n = comparators.length()
  let mut i = 0
  while i < n {
    let c = comparators[i]
    let c_has_pre = c.pre.raw.length() > 0
    if c_has_pre {
      has_pre = true
      if pre_only_major == -2L {
        pre_only_major = c.major
      } else if pre_only_major != c.major {
        pre_only_major = -1L
      }
    }
    if !rel_empty {
      let mut c_empty = false
      let mut cl_maj : Int64 = 0L
      let mut cl_min : Int64 = 0L
      let mut cl_pat : Int64 = 0L
      let mut ch_maj : Int64 = max_i64
      let mut ch_min : Int64 = max_i64
      let mut ch_pat : Int64 = max_i64

      let cmaj = c.major
      match c.op {
        Op::Exact | Op::Wildcard => {
          if c_has_pre {
            c_empty = true
          } else {
            cl_maj = cmaj
            ch_maj = cmaj
            match c.minor {
              None => {
                cl_min = 0L
                cl_pat = 0L
                ch_min = max_i64
                ch_pat = max_i64
              }
              Some(m) => {
                cl_min = m
                ch_min = m
                match c.patch {
                  None => {
                    cl_pat = 0L
                    ch_pat = max_i64
                  }
                  Some(p) => {
                    cl_pat = p
                    ch_pat = p
                  }
                }
              }
            }
          }
        }
        Op::Greater => {
          match c.minor {
            None => {
              if cmaj == max_i64 {
                c_empty = true
              } else {
                cl_maj = cmaj + 1L
                cl_min = 0L
                cl_pat = 0L
              }
            }
            Some(m) => {
              match c.patch {
                None => {
                  if m < max_i64 {
                    cl_maj = cmaj
                    cl_min = m + 1L
                    cl_pat = 0L
                  } else if cmaj < max_i64 {
                    cl_maj = cmaj + 1L
                    cl_min = 0L
                    cl_pat = 0L
                  } else {
                    c_empty = true
                  }
                }
                Some(p) => {
                  if c_has_pre {
                    cl_maj = cmaj
                    cl_min = m
                    cl_pat = p
                  } else if p < max_i64 {
                    cl_maj = cmaj
                    cl_min = m
                    cl_pat = p + 1L
                  } else if m < max_i64 {
                    cl_maj = cmaj
                    cl_min = m + 1L
                    cl_pat = 0L
                  } else if cmaj < max_i64 {
                    cl_maj = cmaj + 1L
                    cl_min = 0L
                    cl_pat = 0L
                  } else {
                    c_empty = true
                  }
                }
              }
            }
          }
        }
        Op::GreaterEq => {
          cl_maj = cmaj
          cl_min = match c.minor {
            Some(m) => m
            None => 0L
          }
          cl_pat = match c.patch {
            Some(p) => p
            None => 0L
          }
        }
        Op::Less => {
          match c.minor {
            None => {
              if cmaj == 0L {
                c_empty = true
              } else {
                ch_maj = cmaj - 1L
                ch_min = max_i64
                ch_pat = max_i64
              }
            }
            Some(m) => {
              let p = match c.patch {
                Some(pv) => pv
                None => 0L
              }
              if p > 0L {
                ch_maj = cmaj
                ch_min = m
                ch_pat = p - 1L
              } else if m > 0L {
                ch_maj = cmaj
                ch_min = m - 1L
                ch_pat = max_i64
              } else if cmaj > 0L {
                ch_maj = cmaj - 1L
                ch_min = max_i64
                ch_pat = max_i64
              } else {
                c_empty = true
              }
            }
          }
        }
        Op::LessEq => {
          match c.minor {
            None => {
              ch_maj = cmaj
              ch_min = max_i64
              ch_pat = max_i64
            }
            Some(m) => {
              match c.patch {
                None => {
                  ch_maj = cmaj
                  ch_min = m
                  ch_pat = max_i64
                }
                Some(p) => {
                  if c_has_pre {
                    if p > 0L {
                      ch_maj = cmaj
                      ch_min = m
                      ch_pat = p - 1L
                    } else if m > 0L {
                      ch_maj = cmaj
                      ch_min = m - 1L
                      ch_pat = max_i64
                    } else if cmaj > 0L {
                      ch_maj = cmaj - 1L
                      ch_min = max_i64
                      ch_pat = max_i64
                    } else {
                      c_empty = true
                    }
                  } else {
                    ch_maj = cmaj
                    ch_min = m
                    ch_pat = p
                  }
                }
              }
            }
          }
        }
        Op::Tilde => {
          cl_maj = cmaj
          ch_maj = cmaj
          match c.minor {
            None => {
              cl_min = 0L
              cl_pat = 0L
              ch_min = max_i64
              ch_pat = max_i64
            }
            Some(m) => {
              cl_min = m
              ch_min = m
              ch_pat = max_i64
              cl_pat = match c.patch {
                Some(p) => p
                None => 0L
              }
            }
          }
        }
        Op::Caret => {
          cl_maj = cmaj
          ch_maj = cmaj
          match c.minor {
            None => {
              cl_min = 0L
              cl_pat = 0L
              ch_min = max_i64
              ch_pat = max_i64
            }
            Some(m) => {
              cl_min = m
              match c.patch {
                None => {
                  cl_pat = 0L
                  if cmaj > 0L {
                    ch_min = max_i64
                    ch_pat = max_i64
                  } else {
                    ch_min = m
                    ch_pat = max_i64
                  }
                }
                Some(p) => {
                  cl_pat = p
                  if cmaj > 0L {
                    ch_min = max_i64
                    ch_pat = max_i64
                  } else if m > 0L {
                    ch_min = m
                    ch_pat = max_i64
                  } else {
                    ch_min = 0L
                    ch_pat = p
                  }
                }
              }
            }
          }
        }
      }

      if c_empty {
        rel_empty = true
      } else {
        // lo = max(lo, cl)
        if cl_maj > lo_maj || (cl_maj == lo_maj && (cl_min > lo_min || (cl_min == lo_min && cl_pat > lo_pat))) {
          lo_maj = cl_maj
          lo_min = cl_min
          lo_pat = cl_pat
        }
        // hi = min(hi, ch)
        if ch_maj < hi_maj || (ch_maj == hi_maj && (ch_min < hi_min || (ch_min == hi_min && ch_pat < hi_pat))) {
          hi_maj = ch_maj
          hi_min = ch_min
          hi_pat = ch_pat
        }
        // Check lo > hi
        if lo_maj > hi_maj || (lo_maj == hi_maj && (lo_min > hi_min || (lo_min == hi_min && lo_pat > hi_pat))) {
          rel_empty = true
        }
      }
    }
    i = i + 1
  }

  VersionReq::{
    comparators: comparators,
    has_pre: has_pre,
    rel_empty: rel_empty,
    lo_major: lo_maj,
    lo_minor: lo_min,
    lo_patch: lo_pat,
    hi_major: hi_maj,
    hi_minor: hi_min,
    hi_patch: hi_pat,
    pre_only_major: if pre_only_major == -2L { -1L } else { pre_only_major },
  }
}

fn matches_pre_slow(req : VersionReq, version : Version) -> Bool {
  let n = req.comparators.length()
  let mut i = 0
  while i < n {
    if !matches_impl(req.comparators[i], version) {
      return false
    }
    i = i + 1
  }
  let mut j = 0
  while j < n {
    if pre_is_compatible(req.comparators[j], version) {
      return true
    }
    j = j + 1
  }
  false
}

///| Evaluate whether `version` satisfies all comparators in this `VersionReq`.
pub fn VersionReq::matches(self : VersionReq, version : Version) -> Bool {
  if version.pre_len == 0 {
    if self.rel_empty {
      return false
    }
    let maj = version.major
    if maj < self.lo_major || maj > self.hi_major {
      return false
    }
    let min = version.minor
    if maj == self.lo_major {
      if min < self.lo_minor || (min == self.lo_minor && version.patch < self.lo_patch) {
        return false
      }
    }
    if maj == self.hi_major {
      if min > self.hi_minor || (min == self.hi_minor && version.patch > self.hi_patch) {
        return false
      }
    }
    return true
  }
  if !self.has_pre {
    return false
  }
  if self.pre_only_major >= 0L && version.major != self.pre_only_major {
    return false
  }
  matches_pre_slow(self, version)
}
