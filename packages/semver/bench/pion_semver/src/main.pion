///| Head-to-head SemVer benchmark (Pion Native):
///|   mode 1 (`version`): parse + full sort + format N versions x `iters`
///|   mode 2 (`req`):     parse R reqs + V versions + R x V `VersionReq::matches` matrix x `iters`

import "semver"

fn parse_pos_int(s : String, fallback : Int) -> Int {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  if acc <= 0 {
    fallback
  } else {
    acc
  }
}

fn read_lines(world : World, path : String) -> Result[Array[String], String] {
  let raw = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return Err("failed to read " + path)
  }
  let parts = raw.split("\n")
  let out : Array[String] = Array::new()
  let mut i = 0
  while i < parts.length() {
    if parts[i].length() > 0 {
      out.push(parts[i])
    }
    i = i + 1
  }
  Ok(out)
}

fn insertion_sort(arr : Array[semver::Version], lo : Int, hi : Int) -> Unit {
  let mut i = lo + 1
  while i <= hi {
    let key = arr[i]
    let mut j = i - 1
    while j >= lo && arr[j].compare_full(key) > 0 {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

fn quicksort(arr : Array[semver::Version], lo : Int, hi : Int) -> Unit {
  let mut l = lo
  let mut r = hi
  while r - l > 16 {
    let mid = l + ((r - l) >> 1)
    // Median-of-three pivot
    if arr[mid].compare_full(arr[l]) < 0 {
      let t = arr[l]
      arr[l] = arr[mid]
      arr[mid] = t
    }
    if arr[r].compare_full(arr[l]) < 0 {
      let t = arr[l]
      arr[l] = arr[r]
      arr[r] = t
    }
    if arr[r].compare_full(arr[mid]) < 0 {
      let t = arr[mid]
      arr[mid] = arr[r]
      arr[r] = t
    }
    let pivot = arr[mid]
    let mut i = l
    let mut j = r
    while i <= j {
      while arr[i].compare_full(pivot) < 0 {
        i = i + 1
      }
      while arr[j].compare_full(pivot) > 0 {
        j = j - 1
      }
      if i <= j {
        let t = arr[i]
        arr[i] = arr[j]
        arr[j] = t
        i = i + 1
        j = j - 1
      }
    }
    // Recurse on smaller partition, loop on larger
    if j - l < r - i {
      if l < j {
        quicksort(arr, l, j)
      }
      l = i
    } else {
      if i < r {
        quicksort(arr, i, r)
      }
      r = j
    }
  }
  if l < r {
    insertion_sort(arr, l, r)
  }
}

fn fnv_str(h : UInt64, s : String) -> UInt64 {
  let prime : UInt64 = 1099511628211UL
  let n = s.length()
  let mut x = h
  let mut i = 0
  while i < n {
    x = x ^ s.code_unit_at(i).to_int64().to_uint64()
    x = x * prime
    i = i + 1
  }
  x
}

fn run_version_bench(world : World, versions_file : String, iters : Int) -> Int {
  let lines = match read_lines(world, versions_file) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: " + e)
      return 1
    }
  }
  let n = lines.length()
  let mut parsed_total : Int64 = 0L
  let mut formatted_bytes : Int64 = 0L
  let mut checksum : UInt64 = 14695981039346656037UL
  let mut first_s = ""
  let mut mid_s = ""
  let mut last_s = ""

  let mut it = 0
  while it < iters {
    let parsed : Array[semver::Version] = Array::new()
    let mut i = 0
    while i < n {
      match semver::parse_version(lines[i]) {
        Ok(v) => {
          parsed.push(v)
          parsed_total = parsed_total + 1L
        }
        Err(_) => ()
      }
      i = i + 1
    }
    let m = parsed.length()
    if m > 1 {
      quicksort(parsed, 0, m - 1)
    }
    let mut k = 0
    while k < m {
      let s = parsed[k].to_string()
      formatted_bytes = formatted_bytes + s.length().to_int64()
      checksum = fnv_str(checksum, s)
      if it == iters - 1 {
        if k == 0 {
          first_s = s
        } else if k == m / 2 {
          mid_s = s
        } else if k == m - 1 {
          last_s = s
        }
      }
      k = k + 1
    }
    it = it + 1
  }

  io_println(world, "bench=version_pipeline")
  io_println(world, "versions=" + n.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "parsed=" + parsed_total.to_string())
  io_println(world, "formatted_bytes=" + formatted_bytes.to_string())
  io_println(world, "first=" + first_s)
  io_println(world, "mid=" + mid_s)
  io_println(world, "last=" + last_s)
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_req_bench(
  world : World,
  reqs_file : String,
  versions_file : String,
  ver_limit : Int,
  iters : Int,
) -> Int {
  let req_lines = match read_lines(world, reqs_file) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: " + e)
      return 1
    }
  }
  let ver_lines = match read_lines(world, versions_file) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: " + e)
      return 1
    }
  }
  let nr = req_lines.length()
  let nv = if ver_limit < ver_lines.length() { ver_limit } else { ver_lines.length() }

  let mut total_checks : Int64 = 0L
  let mut matched : Int64 = 0L
  let mut checksum : UInt64 = 14695981039346656037UL
  let prime : UInt64 = 1099511628211UL

  let mut it = 0
  while it < iters {
    let reqs : Array[semver::VersionReq] = Array::new()
    let mut r = 0
    while r < nr {
      match semver::parse_req(req_lines[r]) {
        Ok(req) => reqs.push(req)
        Err(_) => ()
      }
      r = r + 1
    }
    let vers : Array[semver::Version] = Array::new()
    let mut v = 0
    while v < nv {
      match semver::parse_version(ver_lines[v]) {
        Ok(ver) => vers.push(ver)
        Err(_) => ()
      }
      v = v + 1
    }
    let rn = reqs.length()
    let vn = vers.length()
    let mut ri = 0
    while ri < rn {
      let req = reqs[ri]
      let mut vi = 0
      while vi < vn {
        total_checks = total_checks + 1L
        if req.matches(vers[vi]) {
          matched = matched + 1L
          let tag = ((ri + 1) * 131 + (vi + 1)).to_int64().to_uint64()
          checksum = (checksum ^ tag) * prime
        }
        vi = vi + 1
      }
      ri = ri + 1
    }
    it = it + 1
  }

  io_println(world, "bench=req_matrix")
  io_println(world, "reqs=" + nr.to_string())
  io_println(world, "versions=" + nv.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_checks=" + total_checks.to_string())
  io_println(world, "matched=" + matched.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: semver_bench_pion <version|req> ...")
    return 1
  }
  let mode = args[1]
  if mode == "version" {
    let versions_file = if args.length() > 2 {
      args[2]
    } else {
      "/tmp/pion-semver-bench/versions_20k.txt"
    }
    let iters = if args.length() > 3 { parse_pos_int(args[3], 20) } else { 20 }
    run_version_bench(world, versions_file, iters)
  } else if mode == "req" {
    let reqs_file = if args.length() > 2 {
      args[2]
    } else {
      "/tmp/pion-semver-bench/reqs_2k.txt"
    }
    let versions_file = if args.length() > 3 {
      args[3]
    } else {
      "/tmp/pion-semver-bench/versions_20k.txt"
    }
    let ver_limit = if args.length() > 4 { parse_pos_int(args[4], 500) } else { 500 }
    let iters = if args.length() > 5 { parse_pos_int(args[5], 5) } else { 5 }
    run_req_bench(world, reqs_file, versions_file, ver_limit, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
