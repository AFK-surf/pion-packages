///| Wasm32 smoke entry for the `semver` package.

import "semver"

///|
pub fn smoke() -> Int {
  let v1 = match semver::parse_version("1.2.3-alpha.1+build.42") {
    Ok(v) => v
    Err(_) => return 1
  }
  let v2 = match semver::parse_version("1.2.3-alpha.11") {
    Ok(v) => v
    Err(_) => return 2
  }
  let v3 = match semver::parse_version("1.2.3") {
    Ok(v) => v
    Err(_) => return 3
  }
  let c1 = if v1.compare(v2) < 0 { 1 } else { 0 }
  let c2 = if v2.compare(v3) < 0 { 1 } else { 0 }
  let req = match semver::parse_req(">=1.2.3-alpha.1, <2.0.0") {
    Ok(r) => r
    Err(_) => return 4
  }
  let m1 = if req.matches(v1) { 1 } else { 0 }
  let m2 = if req.matches(v2) { 1 } else { 0 }
  let m3 = if req.matches(v3) { 1 } else { 0 }
  let v4 = match semver::parse_version("1.3.0-alpha.1") {
    Ok(v) => v
    Err(_) => return 5
  }
  let m4 = if req.matches(v4) { 0 } else { 1 }
  c1 + c2 + m1 + m2 + m3 + m4
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r == 6 {
    0
  } else {
    1
  }
}
