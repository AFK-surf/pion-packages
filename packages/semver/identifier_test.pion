///| Official `Prerelease` and `BuildMetadata` test suite ported from `dtolnay/semver` (`tests/test_identifier.rs`).

fn must_pre_err(text : String) -> SemverError {
  match Prerelease::new(text) {
    Ok(p) => {
      debug_assert(false, "expected Err(Prerelease) for '" + text + "', got Ok: " + p.as_str())
      SemverError::{ kind: SemverErrorKind::Unimplemented, message: "" }
    }
    Err(e) => e
  }
}

fn check_pre_ident(expected : String) -> Unit {
  let id = must_pre(expected)
  debug_assert(id.is_empty() == (expected.length() == 0), "is_empty mismatch")
  debug_assert(id.length() == expected.length(), "length mismatch")
  assert_str_eq(id.as_str(), expected)
  debug_assert(id.equals(id), "reflexive equals failed")
  debug_assert(id.compare(id) == 0, "reflexive compare failed")
}

test "identifier_test_new_lengths" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 280 {
    check_pre_ident(sb.to_string())
    sb.write_byte((49).to_byte()) // '1'
    i = i + 1
  }
  // Long prerelease string (~5600 chars -> fast and thorough)
  let base = sb.to_string()
  let long_sb = StringBuilder::new()
  let mut j = 0
  while j < 200 {
    long_sb.write_string(base)
    j = j + 1
  }
  check_pre_ident(long_sb.to_string())
}

test "identifier_test_eq" {
  debug_assert(must_pre("-").equals(must_pre("-")), "- == -")
  debug_assert(!must_pre("a").equals(must_pre("aa")), "a != aa")
  debug_assert(!must_pre("aa").equals(must_pre("a")), "aa != a")
  debug_assert(!must_pre("aaaaaaaaa").equals(must_pre("a")), "a*9 != a")
  debug_assert(!must_pre("a").equals(must_pre("aaaaaaaaa")), "a != a*9")
  debug_assert(!must_pre("aaaaaaaaa").equals(must_pre("bbbbbbbbb")), "a*9 != b*9")
  debug_assert(!must_build("1").equals(must_build("001")), "build 1 != 001")
}

test "identifier_test_prerelease_invalid_nul" {
  let err = must_pre_err("1.b\u{0000}")
  assert_str_eq(err.to_string(), "unexpected character in pre-release identifier")
}

test "identifier_test_prerelease_order" {
  // From dtolnay/semver doc:
  // alpha < alpha.85 < alpha.90 < alpha.200 < alpha.0a < alpha.1a0 < alpha.a < beta
  let items = [
    "alpha",
    "alpha.85",
    "alpha.90",
    "alpha.200",
    "alpha.0a",
    "alpha.1a0",
    "alpha.a",
    "beta",
    "",
  ]
  let mut i = 1
  while i < items.length() {
    let a = must_pre(items[i - 1])
    let b = must_pre(items[i])
    debug_assert(a.compare(b) < 0, "pre order failed: " + items[i - 1] + " < " + items[i])
    debug_assert(b.compare(a) > 0, "pre reverse failed: " + items[i] + " > " + items[i - 1])
    i = i + 1
  }
}

test "identifier_test_build_metadata_order" {
  // From dtolnay/semver doc:
  // "" < demo < demo.0 < demo.00 < demo.1 < demo.01 < demo.001 < demo.2 < demo.02 < demo.002 < demo.10 < demo.85 < demo.90 < demo.090 < demo.200 < demo.1a0 < demo.a < memo
  let items = [
    "",
    "demo",
    "demo.0",
    "demo.00",
    "demo.1",
    "demo.01",
    "demo.001",
    "demo.2",
    "demo.02",
    "demo.002",
    "demo.10",
    "demo.85",
    "demo.90",
    "demo.090",
    "demo.200",
    "demo.1a0",
    "demo.a",
    "memo",
  ]
  let mut i = 1
  while i < items.length() {
    let a = must_build(items[i - 1])
    let b = must_build(items[i])
    debug_assert(a.compare(b) < 0, "build order failed: " + items[i - 1] + " < " + items[i])
    debug_assert(b.compare(a) > 0, "build reverse failed: " + items[i] + " > " + items[i - 1])
    i = i + 1
  }
}
