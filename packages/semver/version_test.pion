///| Official `Version` test suite ported from `dtolnay/semver` (`tests/test_version.rs`).

fn must_version(text : String) -> Version {
  match Version::parse(text) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Version) for '" + text + "', got Err: " + e.message)
      Version::new(0L, 0L, 0L)
    }
  }
}

fn must_version_err(text : String) -> SemverError {
  match Version::parse(text) {
    Ok(v) => {
      debug_assert(false, "expected Err for '" + text + "', got Ok: " + v.to_string())
      SemverError::{ kind: SemverErrorKind::Unimplemented, message: "" }
    }
    Err(e) => e
  }
}

fn must_pre(text : String) -> Prerelease {
  match Prerelease::new(text) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "expected Ok(Prerelease) for '" + text + "', got Err: " + e.message)
      Prerelease::empty()
    }
  }
}

fn must_build(text : String) -> BuildMetadata {
  match BuildMetadata::new(text) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "expected Ok(BuildMetadata) for '" + text + "', got Err: " + e.message)
      BuildMetadata::empty()
    }
  }
}

fn assert_str_eq(actual : String, expected : String) -> Unit {
  debug_assert(
    actual == expected,
    "string mismatch: expected '" + expected + "', got '" + actual + "'",
  )
}

test "version_test_parse" {
  let err = must_version_err("")
  assert_str_eq(err.to_string(), "empty string, expected a semver version")

  let err = must_version_err("  ")
  assert_str_eq(err.to_string(), "unexpected character ' ' while parsing major version number")

  let err = must_version_err("1")
  assert_str_eq(err.to_string(), "unexpected end of input while parsing major version number")

  let err = must_version_err("1.2")
  assert_str_eq(err.to_string(), "unexpected end of input while parsing minor version number")

  let err = must_version_err("1.2.3-")
  assert_str_eq(err.to_string(), "empty identifier segment in pre-release identifier")

  let err = must_version_err("a.b.c")
  assert_str_eq(err.to_string(), "unexpected character 'a' while parsing major version number")

  let err = must_version_err("1.2.3 abc")
  assert_str_eq(err.to_string(), "unexpected character ' ' after patch version number")

  let err = must_version_err("1.2.3-01")
  assert_str_eq(err.to_string(), "invalid leading zero in pre-release identifier")

  let err = must_version_err("1.2.3++")
  assert_str_eq(err.to_string(), "empty identifier segment in build metadata")

  let err = must_version_err("07")
  assert_str_eq(err.to_string(), "invalid leading zero in major version number")

  let err = must_version_err("111111111111111111111.0.0")
  assert_str_eq(err.to_string(), "value of major version number exceeds Int64::MAX")

  let err = must_version_err("8\u{0000}")
  assert_str_eq(err.to_string(), "unexpected character '\\0' after major version number")

  let parsed = must_version("1.2.3")
  let expected = Version::new(1L, 2L, 3L)
  debug_assert(parsed.equals_exact(expected), "1.2.3 should equal Version::new(1, 2, 3)")
  let expected2 = Version::with_parts(1L, 2L, 3L, Prerelease::empty(), BuildMetadata::empty())
  debug_assert(parsed.equals_exact(expected2), "1.2.3 should equal explicit parts")

  let parsed = must_version("1.2.3-alpha1")
  let expected = Version::with_parts(1L, 2L, 3L, must_pre("alpha1"), BuildMetadata::empty())
  debug_assert(parsed.equals_exact(expected), "1.2.3-alpha1 mismatch")

  let parsed = must_version("1.2.3+build5")
  let expected = Version::with_parts(1L, 2L, 3L, Prerelease::empty(), must_build("build5"))
  debug_assert(parsed.equals_exact(expected), "1.2.3+build5 mismatch")

  let parsed = must_version("1.2.3+5build")
  let expected = Version::with_parts(1L, 2L, 3L, Prerelease::empty(), must_build("5build"))
  debug_assert(parsed.equals_exact(expected), "1.2.3+5build mismatch")

  let parsed = must_version("1.2.3-alpha1+build5")
  let expected = Version::with_parts(1L, 2L, 3L, must_pre("alpha1"), must_build("build5"))
  debug_assert(parsed.equals_exact(expected), "1.2.3-alpha1+build5 mismatch")

  let parsed = must_version("1.2.3-1.alpha1.9+build5.7.3aedf")
  let expected = Version::with_parts(
    1L,
    2L,
    3L,
    must_pre("1.alpha1.9"),
    must_build("build5.7.3aedf"),
  )
  debug_assert(parsed.equals_exact(expected), "1.2.3-1.alpha1.9+build5.7.3aedf mismatch")

  let parsed = must_version("1.2.3-0a.alpha1.9+05build.7.3aedf")
  let expected = Version::with_parts(
    1L,
    2L,
    3L,
    must_pre("0a.alpha1.9"),
    must_build("05build.7.3aedf"),
  )
  debug_assert(parsed.equals_exact(expected), "1.2.3-0a.alpha1.9+05build.7.3aedf mismatch")

  let parsed = must_version("0.4.0-beta.1+0851523")
  let expected = Version::with_parts(0L, 4L, 0L, must_pre("beta.1"), must_build("0851523"))
  debug_assert(parsed.equals_exact(expected), "0.4.0-beta.1+0851523 mismatch")

  // for https://nodejs.org/dist/index.json, where some older npm versions are "1.1.0-beta-10"
  let parsed = must_version("1.1.0-beta-10")
  let expected = Version::with_parts(1L, 1L, 0L, must_pre("beta-10"), BuildMetadata::empty())
  debug_assert(parsed.equals_exact(expected), "1.1.0-beta-10 mismatch")
}

test "version_test_eq_and_ne" {
  debug_assert(must_version("1.2.3").equals_exact(must_version("1.2.3")), "eq 1.2.3")
  debug_assert(
    must_version("1.2.3-alpha1").equals_exact(must_version("1.2.3-alpha1")),
    "eq 1.2.3-alpha1",
  )
  debug_assert(
    must_version("1.2.3+build.42").equals_exact(must_version("1.2.3+build.42")),
    "eq 1.2.3+build.42",
  )
  debug_assert(
    must_version("1.2.3-alpha1+42").equals_exact(must_version("1.2.3-alpha1+42")),
    "eq 1.2.3-alpha1+42",
  )

  debug_assert(!must_version("0.0.0").equals_exact(must_version("0.0.1")), "ne patch")
  debug_assert(!must_version("0.0.0").equals_exact(must_version("0.1.0")), "ne minor")
  debug_assert(!must_version("0.0.0").equals_exact(must_version("1.0.0")), "ne major")
  debug_assert(!must_version("1.2.3-alpha").equals_exact(must_version("1.2.3-beta")), "ne pre")
  debug_assert(!must_version("1.2.3+23").equals_exact(must_version("1.2.3+42")), "ne build exact")

  // SemVer 2.0.0 precedence ignores build metadata
  debug_assert(must_version("1.2.3+23").equals(must_version("1.2.3+42")), "precedence eq build")
  debug_assert(
    must_version("1.2.3+23").compare(must_version("1.2.3+42")) == 0,
    "precedence compare build == 0",
  )
  debug_assert(
    must_version("1.2.3").compare(must_version("1.2.3+build.1")) == 0,
    "precedence compare no-build vs build == 0",
  )
}

test "version_test_display" {
  assert_str_eq(must_version("1.2.3").to_string(), "1.2.3")
  assert_str_eq(must_version("1.2.3-alpha1").to_string(), "1.2.3-alpha1")
  assert_str_eq(must_version("1.2.3+build.42").to_string(), "1.2.3+build.42")
  assert_str_eq(must_version("1.2.3-alpha1+42").to_string(), "1.2.3-alpha1+42")
}

test "version_test_ordering_full_and_precedence" {
  // test_lt (full ordering matches dtolnay/semver Ord)
  debug_assert(must_version("0.0.0").compare_full(must_version("1.2.3-alpha2")) < 0, "lt 1")
  debug_assert(must_version("1.0.0").compare_full(must_version("1.2.3-alpha2")) < 0, "lt 2")
  debug_assert(must_version("1.2.0").compare_full(must_version("1.2.3-alpha2")) < 0, "lt 3")
  debug_assert(must_version("1.2.3-alpha1").compare_full(must_version("1.2.3")) < 0, "lt 4")
  debug_assert(must_version("1.2.3-alpha1").compare_full(must_version("1.2.3-alpha2")) < 0, "lt 5")
  debug_assert(
    !(must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha2")) < 0),
    "lt 6",
  )
  debug_assert(must_version("1.2.3+23").compare_full(must_version("1.2.3+42")) < 0, "lt 7")

  // test_le
  debug_assert(must_version("0.0.0").compare_full(must_version("1.2.3-alpha2")) <= 0, "le 1")
  debug_assert(must_version("1.0.0").compare_full(must_version("1.2.3-alpha2")) <= 0, "le 2")
  debug_assert(must_version("1.2.0").compare_full(must_version("1.2.3-alpha2")) <= 0, "le 3")
  debug_assert(
    must_version("1.2.3-alpha1").compare_full(must_version("1.2.3-alpha2")) <= 0,
    "le 4",
  )
  debug_assert(
    must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha2")) <= 0,
    "le 5",
  )
  debug_assert(must_version("1.2.3+23").compare_full(must_version("1.2.3+42")) <= 0, "le 6")

  // test_gt
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("0.0.0")) > 0, "gt 1")
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("1.0.0")) > 0, "gt 2")
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("1.2.0")) > 0, "gt 3")
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha1")) > 0, "gt 4")
  debug_assert(must_version("1.2.3").compare_full(must_version("1.2.3-alpha2")) > 0, "gt 5")
  debug_assert(
    !(must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha2")) > 0),
    "gt 6",
  )
  debug_assert(!(must_version("1.2.3+23").compare_full(must_version("1.2.3+42")) > 0), "gt 7")

  // test_ge
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("0.0.0")) >= 0, "ge 1")
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("1.0.0")) >= 0, "ge 2")
  debug_assert(must_version("1.2.3-alpha2").compare_full(must_version("1.2.0")) >= 0, "ge 3")
  debug_assert(
    must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha1")) >= 0,
    "ge 4",
  )
  debug_assert(
    must_version("1.2.3-alpha2").compare_full(must_version("1.2.3-alpha2")) >= 0,
    "ge 5",
  )
  debug_assert(!(must_version("1.2.3+23").compare_full(must_version("1.2.3+42")) >= 0), "ge 6")

  // Precedence ordering (compare ignores build)
  debug_assert(must_version("1.0.0").compare(must_version("2.0.0")) < 0, "prec 1")
  debug_assert(must_version("2.0.0").compare(must_version("2.1.0")) < 0, "prec 2")
  debug_assert(must_version("2.1.0").compare(must_version("2.1.1")) < 0, "prec 3")
  debug_assert(must_version("1.0.0-alpha").compare(must_version("1.0.0")) < 0, "prec 4")
  debug_assert(must_version("1.2.3+23").compare(must_version("1.2.3+42")) == 0, "prec 5")
}

test "version_test_spec_order" {
  let vs = [
    "1.0.0-alpha",
    "1.0.0-alpha.1",
    "1.0.0-alpha.beta",
    "1.0.0-beta",
    "1.0.0-beta.2",
    "1.0.0-beta.11",
    "1.0.0-rc.1",
    "1.0.0",
  ]
  let mut i = 1
  while i < vs.length() {
    let a = must_version(vs[i - 1])
    let b = must_version(vs[i])
    debug_assert(a.compare(b) < 0, "spec_order compare failed: " + vs[i - 1] + " < " + vs[i])
    debug_assert(
      a.compare_full(b) < 0,
      "spec_order compare_full failed: " + vs[i - 1] + " < " + vs[i],
    )
    debug_assert(b.compare(a) > 0, "spec_order reverse failed: " + vs[i] + " > " + vs[i - 1])
    i = i + 1
  }
}
