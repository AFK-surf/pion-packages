///| Burrows-Wheeler block sorting, translated from `libbz2-rs-sys` 0.2.3 (itself derived from
///| bzip2/libbzip2 by Julian R Seward; see `NOTICE`) so the sorted order and `origPtr` match exactly.
///| `main_sort` is a radix + three-way quicksort; when a repetitive block exhausts its work budget,
///| `fallback_sort` in `fallbacksort.pion` takes over.

///| Bytes kept past the block end so comparisons can read ahead without wrapping.
let n_overshoot : Int = 34

///| Main-sort budget factor: libbz2 default work factor 30 gives `(30 - 1) / 3`.
let work_factor_budget : Int = 9

///| Bucket-completed flag stored in `ftab` entries.
let setmask : Int = 2097152

///|
let clearmask : Int = -2097153

///| Shell sort increments used by `main_simple_sort` (no global array -> zero RC overhead).
fn shell_inc(hp : Int) -> Int {
  if hp == 0 {
    1
  } else if hp == 1 {
    4
  } else if hp == 2 {
    13
  } else if hp == 3 {
    40
  } else if hp == 4 {
    121
  } else if hp == 5 {
    364
  } else if hp == 6 {
    1093
  } else if hp == 7 {
    3280
  } else if hp == 8 {
    9841
  } else if hp == 9 {
    29524
  } else if hp == 10 {
    88573
  } else if hp == 11 {
    265720
  } else if hp == 12 {
    797161
  } else {
    2391484
  }
}

///| Sort workspace sized for the largest block of one stream.
struct Sorter {
  ptr : FixedArray[Int]
  quadrant : FixedArray[Int]
  ftab : FixedArray[Int]
  mut eclass : FixedArray[Int]
  mut bhtab : FixedArray[Int]
  st_lo : FixedArray[Int]
  st_hi : FixedArray[Int]
  st_d : FixedArray[Int]
  mut budget : Int
}

///|
fn Sorter::new(cap : Int) -> Sorter {
  let empty : FixedArray[Int] = FixedArray::make(0, 0)
  Sorter::{
    ptr: FixedArray::make(cap, 0),
    quadrant: FixedArray::make(cap + n_overshoot, 0),
    ftab: FixedArray::make(65537, 0),
    eclass: empty,
    bhtab: empty,
    st_lo: FixedArray::make(100, 0),
    st_hi: FixedArray::make(100, 0),
    st_d: FixedArray::make(100, 0),
    budget: 0,
  }
}

///| Sort the rotations of `block[0..nblock]` into `s.ptr` and return `origPtr`.
///| `block` must have `n_overshoot` spare slots past `nblock`.
fn block_sort_bytes(s : Sorter, block : FixedArray[Byte], nblock : Int) -> Int {
  if nblock < 10000 {
    fallback_sort_bytes(s, block, nblock)
  } else {
    s.budget = nblock * work_factor_budget
    main_sort_bytes(s, block, nblock)
    if s.budget < 0 {
      fallback_sort_bytes(s, block, nblock)
    }
  }
  let ptr = s.ptr
  let mut i = 0
  while i < nblock {
    if ptr[i] == 0 {
      return i
    }
    i = i + 1
  }
  -1
}

///| Compatibility entry point for `FixedArray[Int]` blocks (used by internal tests).
fn main_sort(s : Sorter, block : FixedArray[Int], nblock : Int) -> Unit {
  let b : FixedArray[Byte] = FixedArray::make(nblock + n_overshoot, (0).to_byte())
  let mut i = 0
  while i < nblock {
    b[i] = block[i].to_byte()
    i = i + 1
  }
  main_sort_bytes(s, b, nblock)
}

///| Continuation of `main_gt_u` after the first 4 bytes matched, charging `s.budget` on >12-byte matches.
fn main_gt_u_from4(
  s : Sorter,
  block : FixedArray[Byte],
  quadrant : FixedArray[Int],
  nblock : Int,
  a : Int,
  b : Int,
) -> Bool {
  let mut c1 = block[a + 4]
  let mut c2 = block[b + 4]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 5]
  c2 = block[b + 5]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 6]
  c2 = block[b + 6]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 7]
  c2 = block[b + 7]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 8]
  c2 = block[b + 8]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 9]
  c2 = block[b + 9]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 10]
  c2 = block[b + 10]
  if c1 != c2 {
    return c1 > c2
  }
  c1 = block[a + 11]
  c2 = block[b + 11]
  if c1 != c2 {
    return c1 > c2
  }
  let mut i1 = a + 12
  let mut i2 = b + 12
  let mut budget = s.budget
  // `quadrant[i]` stores `(block[i] << 16) | qval`, so a single 32-bit comparison checks both
  // `block` (high 8 bits) and `quadrant` (low 16 bits) in exact lexicographic order.
  // `libbz2-rs-sys` 0.2.3 runs `nblock.div_ceil(8)` rounds (libbz2 1.0.8 runs `nblock / 8 + 2`);
  // the round count sets the budget charge, so it decides when main sort falls back.
  let mut iters = (nblock + 7) >> 3
  while iters > 0 {
    let mut s1 = quadrant[i1]
    let mut s2 = quadrant[i2]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 1]
    s2 = quadrant[i2 + 1]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 2]
    s2 = quadrant[i2 + 2]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 3]
    s2 = quadrant[i2 + 3]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 4]
    s2 = quadrant[i2 + 4]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 5]
    s2 = quadrant[i2 + 5]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 6]
    s2 = quadrant[i2 + 6]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    s1 = quadrant[i1 + 7]
    s2 = quadrant[i2 + 7]
    if s1 != s2 {
      s.budget = budget
      return s1 > s2
    }
    i1 = i1 + 8
    i2 = i2 + 8
    if i1 >= nblock {
      i1 = i1 - nblock
    }
    if i2 >= nblock {
      i2 = i2 - nblock
    }
    budget = budget - 1
    iters = iters - 1
  }
  s.budget = budget
  false
}

///|
fn main_simple_sort(s : Sorter, block : FixedArray[Byte], nblock : Int, lo : Int, hi : Int, d : Int) -> Unit {
  let big_n = hi - lo + 1
  if big_n < 2 {
    return
  }
  let ptr = s.ptr
  let quadrant = s.quadrant
  let mut hp = if big_n <= 4 {
    0
  } else if big_n <= 13 {
    1
  } else if big_n <= 40 {
    2
  } else {
    let mut k = 3
    while k < 14 && shell_inc(k) < big_n {
      k = k + 1
    }
    if k >= 14 {
      return
    }
    k - 1
  }
  while hp >= 0 {
    let h = shell_inc(hp)
    let lo_h = lo + h
    let mut i = lo_h
    while i <= hi {
      let v = ptr[i]
      let vd = v + d
      let b0 = block[vd]
      let b1 = block[vd + 1]
      let b2 = block[vd + 2]
      let b3 = block[vd + 3]
      let mut j = i
      while j >= lo_h {
        let u = ptr[j - h]
        let ud = u + d
        let c0 = block[ud]
        let gt = if c0 != b0 {
          c0 > b0
        } else {
          let c1 = block[ud + 1]
          if c1 != b1 {
            c1 > b1
          } else {
            let c2 = block[ud + 2]
            if c2 != b2 {
              c2 > b2
            } else {
              let c3 = block[ud + 3]
              if c3 != b3 {
                c3 > b3
              } else {
                main_gt_u_from4(s, block, quadrant, nblock, ud, vd)
              }
            }
          }
        }
        if !gt {
          break
        }
        ptr[j] = u
        j = j - h
      }
      ptr[j] = v
      if s.budget < 0 {
        return
      }
      i = i + 1
    }
    hp = hp - 1
  }
}

///|
fn median_of_3(a0 : Byte, b0 : Byte, c0 : Byte) -> Byte {
  let mut a = a0
  let mut b = b0
  let mut c = c0
  if a > b {
    let t = a
    a = b
    b = t
  }
  if a > c {
    c = a
  }
  if b > c {
    b = c
  }
  b
}

///|
fn main_qsort3(s : Sorter, block : FixedArray[Byte], nblock : Int, lo_st : Int, hi_st : Int, d_st : Int) -> Unit {
  let ptr = s.ptr
  let st_lo = s.st_lo
  let st_hi = s.st_hi
  let st_d = s.st_d
  st_lo[0] = lo_st
  st_hi[0] = hi_st
  st_d[0] = d_st
  let mut sp = 1
  while sp > 0 {
    sp = sp - 1
    let lo = st_lo[sp]
    let hi = st_hi[sp]
    if hi <= lo {
      continue
    }
    let d = st_d[sp]
    if hi - lo < 20 || d > 14 {
      main_simple_sort(s, block, nblock, lo, hi, d)
      if s.budget < 0 {
        return
      }
      continue
    }
    let med = median_of_3(block[ptr[lo] + d], block[ptr[hi] + d], block[ptr[(lo + hi) >> 1] + d])
    let mut lt_lo = lo
    let mut un_lo = lo
    let mut gt_hi = hi
    let mut un_hi = hi
    while true {
      while un_lo <= un_hi {
        let p = ptr[un_lo]
        let c = block[p + d]
        if c > med {
          break
        }
        if c == med {
          ptr[un_lo] = ptr[lt_lo]
          ptr[lt_lo] = p
          lt_lo = lt_lo + 1
        }
        un_lo = un_lo + 1
      }
      while un_lo <= un_hi {
        let p = ptr[un_hi]
        let c = block[p + d]
        if c < med {
          break
        }
        if c == med {
          ptr[un_hi] = ptr[gt_hi]
          ptr[gt_hi] = p
          gt_hi = gt_hi - 1
        }
        un_hi = un_hi - 1
      }
      if un_lo > un_hi {
        break
      }
      let t = ptr[un_lo]
      ptr[un_lo] = ptr[un_hi]
      ptr[un_hi] = t
      un_lo = un_lo + 1
      un_hi = un_hi - 1
    }
    if gt_hi < lt_lo {
      st_lo[sp] = lo
      st_hi[sp] = hi
      st_d[sp] = d + 1
      sp = sp + 1
      continue
    }
    let n0 = if lt_lo - lo < un_lo - lt_lo { lt_lo - lo } else { un_lo - lt_lo }
    let mut a = lo
    let mut b = un_lo - n0
    let mut k = n0
    while k > 0 {
      let t = ptr[a]
      ptr[a] = ptr[b]
      ptr[b] = t
      a = a + 1
      b = b + 1
      k = k - 1
    }
    let m0 = if hi - gt_hi < gt_hi - un_hi { hi - gt_hi } else { gt_hi - un_hi }
    a = un_lo
    b = hi - m0 + 1
    k = m0
    while k > 0 {
      let t = ptr[a]
      ptr[a] = ptr[b]
      ptr[b] = t
      a = a + 1
      b = b + 1
      k = k - 1
    }
    let n = lo + un_lo - lt_lo - 1
    let m = hi - (gt_hi - un_hi) + 1
    // Push the three partitions largest-first so the smallest is popped next.
    let mut l0 = lo
    let mut h0 = n
    let mut d0 = d
    let mut l1 = m
    let mut h1 = hi
    let mut d1 = d
    let mut l2 = n + 1
    let mut h2 = m - 1
    let mut d2 = d + 1
    if h0 - l0 < h1 - l1 {
      let tl = l0
      let th = h0
      let td = d0
      l0 = l1
      h0 = h1
      d0 = d1
      l1 = tl
      h1 = th
      d1 = td
    }
    if h1 - l1 < h2 - l2 {
      let tl = l1
      let th = h1
      let td = d1
      l1 = l2
      h1 = h2
      d1 = d2
      l2 = tl
      h2 = th
      d2 = td
    }
    if h0 - l0 < h1 - l1 {
      let tl = l0
      let th = h0
      let td = d0
      l0 = l1
      h0 = h1
      d0 = d1
      l1 = tl
      h1 = th
      d1 = td
    }
    st_lo[sp] = l0
    st_hi[sp] = h0
    st_d[sp] = d0
    st_lo[sp + 1] = l1
    st_hi[sp + 1] = h1
    st_d[sp + 1] = d1
    st_lo[sp + 2] = l2
    st_hi[sp + 2] = h2
    st_d[sp + 2] = d2
    sp = sp + 3
  }
}

///|
fn big_freq(ftab : FixedArray[Int], b : Int) -> Int {
  ftab[(b + 1) << 8] - ftab[b << 8]
}

///| Radix + quicksort of `block[0..nblock]` into `s.ptr`; leaves `s.budget < 0` when it gives up.
fn main_sort_bytes(s : Sorter, block : FixedArray[Byte], nblock : Int) -> Unit {
  let ptr = s.ptr
  let quadrant = s.quadrant
  let ftab = s.ftab
  let big_done : FixedArray[Bool] = FixedArray::make(256, false)
  let copy_start : FixedArray[Int] = FixedArray::make(256, 0)
  let copy_end : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < n_overshoot {
    block[nblock + i] = block[i]
    i = i + 1
  }
  i = 0
  while i < nblock + n_overshoot {
    quadrant[i] = block[i].to_int() << 16
    i = i + 1
  }
  ftab.fill(0)
  let mut j = block[0].to_int() << 8
  i = nblock - 1
  while i >= 0 {
    j = (j >> 8) | (block[i].to_int() << 8)
    ftab[j] += 1
    i = i - 1
  }
  i = 1
  while i <= 65536 {
    ftab[i] += ftab[i - 1]
    i = i + 1
  }
  let mut s16 = block[0].to_int() << 8
  i = nblock - 1
  while i >= 0 {
    s16 = (s16 >> 8) | (block[i].to_int() << 8)
    let k = ftab[s16] - 1
    ftab[s16] = k
    ptr[k] = i
    i = i - 1
  }
  let running_order : FixedArray[Int] = FixedArray::make(256, 0)
  i = 0
  while i < 256 {
    running_order[i] = i
    i = i + 1
  }
  let mut h = 364
  let mut sorting = true
  while sorting {
    h = h / 3
    i = h
    while i < 256 {
      let vv = running_order[i]
      let mut jj = i
      let mut go = true
      while go && big_freq(ftab, running_order[jj - h]) > big_freq(ftab, vv) {
        running_order[jj] = running_order[jj - h]
        jj = jj - h
        if jj < h {
          go = false
        }
      }
      running_order[jj] = vv
      i = i + 1
    }
    if h == 1 {
      sorting = false
    }
  }
  i = 0
  while i < 256 {
    let ss = running_order[i]
    // Step 1: quicksort the unsorted small buckets [ss, jb].
    let mut jb = 0
    while jb < 256 {
      if jb != ss {
        let sb = (ss << 8) + jb
        if (ftab[sb] & setmask) == 0 {
          let lo = ftab[sb] & clearmask
          let hi = (ftab[sb + 1] & clearmask) - 1
          if hi > lo {
            main_qsort3(s, block, nblock, lo, hi, 2)
            if s.budget < 0 {
              return
            }
          }
        }
        ftab[sb] = ftab[sb] | setmask
      }
      jb = jb + 1
    }
    // Step 2: derive the order of buckets [t, ss] from the sorted big bucket [ss].
    jb = 0
    while jb < 256 {
      copy_start[jb] = ftab[(jb << 8) + ss] & clearmask
      copy_end[jb] = (ftab[(jb << 8) + ss + 1] & clearmask) - 1
      jb = jb + 1
    }
    jb = ftab[ss << 8] & clearmask
    while jb < copy_start[ss] {
      let mut k = ptr[jb] - 1
      if k < 0 {
        k = k + nblock
      }
      let c1 = block[k].to_int()
      if !big_done[c1] {
        let dst = copy_start[c1]
        ptr[dst] = k
        copy_start[c1] = dst + 1
      }
      jb = jb + 1
    }
    jb = (ftab[(ss + 1) << 8] & clearmask) - 1
    while jb > copy_end[ss] {
      let mut k = ptr[jb] - 1
      if k < 0 {
        k = k + nblock
      }
      let c1 = block[k].to_int()
      if !big_done[c1] {
        let dst = copy_end[c1]
        ptr[dst] = k
        copy_end[c1] = dst - 1
      }
      jb = jb - 1
    }
    jb = 0
    while jb < 256 {
      let idx = (jb << 8) + ss
      ftab[idx] = ftab[idx] | setmask
      jb = jb + 1
    }
    // Step 3: record quadrant ranks of the finished big bucket.
    big_done[ss] = true
    if i < 255 {
      let bb_start = ftab[ss << 8] & clearmask
      let bb_size = (ftab[(ss + 1) << 8] & clearmask) - bb_start
      // `libbz2-rs-sys` 0.2.3 scales quadrant ranks by `popcount(bb_size >> 16)`, which changes the
      // main-sort work budget (and so the fallback decision) relative to libbz2 1.0.8. When that
      // shift is too small for 16-bit ranks, 0.2.3 aborts (internal error 1002); use the smallest
      // sufficient shift there so the sort stays correct.
      let mut shifts = (bb_size >> 16).count_ones()
      if ((bb_size - 1) >> shifts) > 65535 {
        shifts = 0
        while ((bb_size - 1) >> shifts) > 65535 {
          shifts = shifts + 1
        }
      }
      let ss_hi = ss << 16
      let mut q = bb_size - 1
      if shifts == 0 {
        while q >= 0 {
          let a2update = ptr[bb_start + q]
          let packed = ss_hi | q
          quadrant[a2update] = packed
          if a2update < n_overshoot {
            quadrant[a2update + nblock] = packed
          }
          q = q - 1
        }
      } else {
        while q >= 0 {
          let a2update = ptr[bb_start + q]
          let packed = ss_hi | (q >> shifts)
          quadrant[a2update] = packed
          if a2update < n_overshoot {
            quadrant[a2update + nblock] = packed
          }
          q = q - 1
        }
      }
    }
    i = i + 1
  }
}
