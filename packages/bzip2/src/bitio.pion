///| Bit-level I/O: 64-bit MSB-first bit writer and reader, and the bounded decoder output buffer.

///| 64-bit MSB-first bit writer backed by a reusable `FixedArray[Byte]` staging buffer.
struct BitWriter {
  buf : FixedArray[Byte]
  cap : Int
  mut len : Int
  mut bits : UInt64
  mut live : Int
  chunks : Array[Bytes]
}

///|
fn BitWriter::new(cap : Int) -> BitWriter {
  let c = if cap < 512 { 512 } else if cap > 65536 { 65536 } else { cap }
  BitWriter::{
    buf: FixedArray::make(c, (0).to_byte()),
    cap: c,
    len: 0,
    bits: 0UL,
    live: 0,
    chunks: [],
  }
}

///| Materialize `w.buf[0..w.len]` into `w.chunks` and reset `w.len = 0`.
fn bw_flush_chunk(w : BitWriter) -> Unit {
  let n = w.len
  if n == 0 {
    return
  }
  let src = w.buf
  let out = Bytes::new(n)
  let mut i = 0
  let lim8 = n - 8
  while i <= lim8 {
    out[i] = src[i]
    out[i + 1] = src[i + 1]
    out[i + 2] = src[i + 2]
    out[i + 3] = src[i + 3]
    out[i + 4] = src[i + 4]
    out[i + 5] = src[i + 5]
    out[i + 6] = src[i + 6]
    out[i + 7] = src[i + 7]
    i = i + 8
  }
  while i < n {
    out[i] = src[i]
    i = i + 1
  }
  w.chunks.push(out)
  w.len = 0
}

///| Append the low `n` (`<= 24`) bits of `v`.
fn bw_write(w : BitWriter, n : Int, v : Int) -> Unit {
  w.bits = (w.bits << n) | v.to_int64().to_uint64()
  w.live = w.live + n
  if w.live >= 32 {
    let shift = w.live - 32
    let word = w.bits >> shift
    if w.len + 4 > w.cap {
      bw_flush_chunk(w)
    }
    let buf = w.buf
    let p = w.len
    buf[p] = ((word >> 24) & 0xFFUL).to_int().to_byte()
    buf[p + 1] = ((word >> 16) & 0xFFUL).to_int().to_byte()
    buf[p + 2] = ((word >> 8) & 0xFFUL).to_int().to_byte()
    buf[p + 3] = (word & 0xFFUL).to_int().to_byte()
    w.len = p + 4
    w.live = shift
  }
}

///|
fn bw_write_u32(w : BitWriter, v : UInt) -> Unit {
  bw_write(w, 16, (v >> 16).to_int() & 0xFFFF)
  bw_write(w, 16, v.to_int() & 0xFFFF)
}

///| Zero-pad to a byte boundary and return the written bytes.
fn bw_finish(w : BitWriter) -> Bytes {
  if w.live > 0 {
    let pad = (8 - (w.live & 7)) & 7
    if pad > 0 {
      w.bits = w.bits << pad
      w.live = w.live + pad
    }
    while w.live >= 8 {
      w.live = w.live - 8
      if w.len >= w.cap {
        bw_flush_chunk(w)
      }
      w.buf[w.len] = ((w.bits >> w.live) & 0xFFUL).to_int().to_byte()
      w.len = w.len + 1
    }
  }
  let n_chunks = w.chunks.length()
  if n_chunks == 0 {
    let n = w.len
    let src = w.buf
    let out = Bytes::new(n)
    let mut i = 0
    let lim8 = n - 8
    while i <= lim8 {
      out[i] = src[i]
      out[i + 1] = src[i + 1]
      out[i + 2] = src[i + 2]
      out[i + 3] = src[i + 3]
      out[i + 4] = src[i + 4]
      out[i + 5] = src[i + 5]
      out[i + 6] = src[i + 6]
      out[i + 7] = src[i + 7]
      i = i + 8
    }
    while i < n {
      out[i] = src[i]
      i = i + 1
    }
    return out
  }
  bw_flush_chunk(w)
  let mut total = 0
  let mut c = 0
  let total_chunks = w.chunks.length()
  while c < total_chunks {
    total = total + w.chunks[c].length()
    c = c + 1
  }
  let out = Bytes::new(total)
  let mut dst = 0
  c = 0
  while c < total_chunks {
    let chunk = w.chunks[c]
    let clen = chunk.length()
    let mut i = 0
    let lim8 = clen - 8
    while i <= lim8 {
      out[dst + i] = chunk[i]
      out[dst + i + 1] = chunk[i + 1]
      out[dst + i + 2] = chunk[i + 2]
      out[dst + i + 3] = chunk[i + 3]
      out[dst + i + 4] = chunk[i + 4]
      out[dst + i + 5] = chunk[i + 5]
      out[dst + i + 6] = chunk[i + 6]
      out[dst + i + 7] = chunk[i + 7]
      i = i + 8
    }
    while i < clen {
      out[dst + i] = chunk[i]
      i = i + 1
    }
    dst = dst + clen
    c = c + 1
  }
  out
}

///| 64-bit MSB-aligned bit reader. Valid bits sit at the top of `bits`; reads past end yield 0 and set `overrun`.
struct BitReader {
  data : Bytes
  data_len : Int
  mut pos : Int
  mut bits : UInt64
  mut live : Int
  mut overrun : Bool
}

///|
fn BitReader::new(data : Bytes, pos : Int) -> BitReader {
  BitReader::{ data, data_len: data.length(), pos, bits: 0UL, live: 0, overrun: false }
}

///| Refill `r.bits` up to at least 57 bits when input bytes remain.
fn br_refill(r : BitReader) -> Unit {
  let data = r.data
  let dlen = r.data_len
  let mut pos = r.pos
  let mut bits = r.bits
  let mut live = r.live
  if live <= 32 && pos + 4 <= dlen {
    let w = (data[pos].to_int().to_int64().to_uint64() << 24)
    | (data[pos + 1].to_int().to_int64().to_uint64() << 16)
    | (data[pos + 2].to_int().to_int64().to_uint64() << 8)
    | data[pos + 3].to_int().to_int64().to_uint64()
    bits = bits | (w << (32 - live))
    pos = pos + 4
    live = live + 32
  }
  while live <= 56 && pos < dlen {
    bits = bits | (data[pos].to_int().to_int64().to_uint64() << (56 - live))
    pos = pos + 1
    live = live + 8
  }
  r.pos = pos
  r.bits = bits
  r.live = live
}

///| Read `n` (`1..=24`) bits.
fn br_bits(r : BitReader, n : Int) -> Int {
  if r.live < n {
    br_refill(r)
  }
  let res = (r.bits >> (64 - n)).to_int()
  if r.live >= n {
    r.bits = r.bits << n
    r.live = r.live - n
  } else {
    r.overrun = true
    r.bits = 0UL
    r.live = 0
  }
  res
}

///|
fn br_bit(r : BitReader) -> Int {
  if r.live == 0 {
    br_refill(r)
    if r.live == 0 {
      r.overrun = true
      return 0
    }
  }
  let v = (r.bits >> 63).to_int()
  r.bits = r.bits << 1
  r.live = r.live - 1
  v
}

///|
fn br_u32(r : BitReader) -> UInt {
  let hi = br_bits(r, 16).to_uint()
  let lo = br_bits(r, 16).to_uint()
  (hi << 16) | lo
}

///| Output buffer that grows by doubling but never past `limit` bytes.
struct OutBuf {
  mut buf : Bytes
  mut len : Int
  limit : Int
}

///|
fn OutBuf::new(hint : Int, limit : Int) -> OutBuf {
  let mut cap = if hint < 256 { 256 } else if hint > 16777216 { 16777216 } else { hint }
  if cap > limit {
    cap = limit
  }
  OutBuf::{ buf: Bytes::new(cap), len: 0, limit }
}

///| Compute next buffer capacity for `need <= limit` without signed-`Int` doubling overflow.
fn out_next_cap(cur : Int, need : Int, limit : Int) -> Int {
  let mut cap = if cur > limit / 2 { limit } else { cur * 2 }
  if cap < need {
    cap = need
  }
  if cap > limit {
    cap = limit
  }
  cap
}

///| Grow `o.buf` to hold at least `need` bytes (`need <= o.limit`).
fn out_grow(o : OutBuf, need : Int) -> Unit {
  let cap = out_next_cap(o.buf.length(), need, o.limit)
  if o.len == 0 {
    o.buf = Bytes::new(cap)
  } else {
    o.buf = o.buf.slice(0, o.len).concat(Bytes::new(cap - o.len))
  }
}

///| Append `count` copies of byte `b`; the caller guarantees `len + count <= limit`.
fn out_fill(o : OutBuf, b : Int, count : Int) -> Unit {
  let need = o.len + count
  if need > o.buf.length() {
    out_grow(o, need)
  }
  let buf = o.buf
  let v = b.to_byte()
  let mut p = o.len
  let end = need
  while p < end {
    buf[p] = v
    p = p + 1
  }
  o.len = need
}
