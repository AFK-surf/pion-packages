///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/bzip2`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "bzip2"

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn fnv1a_32(data : Bytes) -> UInt {
  let mut h : UInt = 2166136261U
  let mut i = 0
  let n = data.length()
  while i < n {
    h = (h ^ data[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  h
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  let n = a.length()
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn make_payload(len : Int) -> Bytes {
  let out = Bytes::new(len)
  let mut s : UInt = 0x12345678U
  let mut i = 0
  while i < len {
    let mod16 = i & 15
    if mod16 < 10 {
      out[i] = (97 + ((i / 16 + mod16) % 26)).to_byte()
    } else if mod16 == 10 {
      out[i] = b' '
    } else if mod16 == 15 {
      out[i] = b'\n'
    } else {
      s = s * 1664525U + 1013904223U
      out[i] = (48 + ((s >> 24).to_int() % 10)).to_byte()
    }
    i = i + 1
  }
  out
}

///|
pub fn main(world : World) -> Int {
  // 1. Empty stream
  let empty = Bytes::new(0)
  let bz_empty = match bzip2::compress(empty, 1) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR empty compress: " + e)
      return 1
    }
  }
  let dec_empty = match bzip2::decompress(bz_empty) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR empty decompress: " + e)
      return 2
    }
  }
  if dec_empty.length() != 0 {
    return 3
  }

  // 2. Single-block compress + decompress at levels 1, 6, 9
  let single = make_payload(8192)
  let single_fnv = fnv1a_32(single)
  let bz1 = match bzip2::compress(single, 1) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR L1 compress: " + e)
      return 4
    }
  }
  let bz6 = match bzip2::compress(single, 6) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR L6 compress: " + e)
      return 5
    }
  }
  let bz9 = match bzip2::compress(single, 9) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR L9 compress: " + e)
      return 6
    }
  }
  match bzip2::decompress(bz1) {
    Ok(d) => if !bytes_eq(d, single) { return 7 }
    Err(_) => return 8
  }
  match bzip2::decompress(bz6) {
    Ok(d) => if !bytes_eq(d, single) { return 9 }
    Err(_) => return 10
  }
  match bzip2::decompress(bz9) {
    Ok(d) => if !bytes_eq(d, single) { return 11 }
    Err(_) => return 12
  }

  // 3. Multi-block (>100 KiB at L1)
  let multi = make_payload(120000)
  let bz_multi = match bzip2::compress(multi, 1) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR multi compress: " + e)
      return 13
    }
  }
  let dec_multi = match bzip2::decompress(bz_multi) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR multi decompress: " + e)
      return 14
    }
  }
  if !bytes_eq(dec_multi, multi) {
    return 15
  }

  // 4. decompress_limited bomb rejection, negative limit rejection, and exact limit acceptance
  let zeros = Bytes::new(65536)
  let bz_bomb = match bzip2::compress(zeros, 1) {
    Ok(b) => b
    Err(_) => return 16
  }
  match bzip2::decompress_limited(bz_bomb, 4096) {
    Err(_) => ()
    Ok(_) => return 17
  }
  match bzip2::decompress_limited(bz_bomb, -1) {
    Err(_) => ()
    Ok(_) => return 18
  }
  match bzip2::decompress_limited(bz_bomb, 65536) {
    Ok(d) => if !bytes_eq(d, zeros) { return 23 }
    Err(_) => return 24
  }

  // 5. Embedded reference libbz2 stream decode
  let ref_bz = from_hex(
    "425a6836314159265359837d4d580000039980400010003424c4302000310340d02268f4267a8bbfbb5e9690050c68bb9229c284841bea6ac0",
  )
  let ref_plain = "bzip2 payload data".to_bytes()
  let dec_ref = match bzip2::decompress(ref_bz) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "ERR ref decompress: " + e)
      return 25
    }
  }
  if !bytes_eq(dec_ref, ref_plain) {
    return 26
  }

  // 6. Malformed header, truncated stream, CRC corruption, and invalid level rejection
  let bad_hdr = Bytes::new(8)
  bad_hdr[0] = b'B'
  bad_hdr[1] = b'Z'
  bad_hdr[2] = b'x'
  bad_hdr[3] = b'9'
  match bzip2::decompress(bad_hdr) {
    Err(_) => ()
    Ok(_) => return 19
  }
  match bzip2::decompress(bz6.slice(0, bz6.length() - 5)) {
    Err(_) => ()
    Ok(_) => return 27
  }
  let corrupt = Bytes::new(bz6.length())
  let mut k = 0
  while k < bz6.length() {
    corrupt[k] = bz6[k]
    k = k + 1
  }
  let mid = bz6.length() / 2
  corrupt[mid] = (corrupt[mid].to_int() ^ 0xFF).to_byte()
  match bzip2::decompress(corrupt) {
    Err(_) => ()
    Ok(_) => return 20
  }
  match bzip2::compress(empty, 0) {
    Err(_) => ()
    Ok(_) => return 21
  }
  match bzip2::compress(empty, 10) {
    Err(_) => ()
    Ok(_) => return 22
  }

  io_println(world, "bzip2_wasm_smoke:ok")
  io_println(world, "ref=" + dec_ref.to_string())
  io_println(
    world,
    "empty_bz=" + bz_empty.length().to_string() +
    " single_fnv=" + single_fnv.to_int64().to_string(),
  )
  io_println(
    world,
    "l1=" + bz1.length().to_string() + ":" + fnv1a_32(bz1).to_int64().to_string() +
    " l6=" + bz6.length().to_string() + ":" + fnv1a_32(bz6).to_int64().to_string() +
    " l9=" + bz9.length().to_string() + ":" + fnv1a_32(bz9).to_int64().to_string(),
  )
  io_println(
    world,
    "multi_raw=" + multi.length().to_string() +
    " multi_bz=" + bz_multi.length().to_string() +
    " multi_bz_fnv=" + fnv1a_32(bz_multi).to_int64().to_string() +
    " bomb_bz=" + bz_bomb.length().to_string(),
  )
  0
}
