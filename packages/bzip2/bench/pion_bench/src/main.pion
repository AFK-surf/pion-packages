///| Pion Native head-to-head benchmark for `packages/bzip2`.
///| Modes:
///|   compress   <level> <in_file> [iters] [dump_path]
///|   decompress <in_file> [iters] [dump_path]

import "bzip2"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn fnv1a_64(data : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = data.length()
  let mut i = 0
  while i < n {
    h = (h ^ data[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(
      world,
      "usage: bzip2_bench <compress <level> <in> [iters] [dump]|decompress <in> [iters] [dump]>",
    )
    return 1
  }
  let mode = args[1]

  if mode == "compress" {
    if args.length() < 4 {
      io_println(world, "usage: bzip2_bench compress <level> <in> [iters] [dump]")
      return 1
    }
    let level = parse_int(args[2])
    let path = args[3]
    let iters = if args.length() >= 5 { parse_int(args[4]) } else { 1 }
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut last_out = Bytes::new(0)
    let mut total_bytes : Int64 = 0L
    let mut i = 0
    while i < iters {
      match bzip2::compress(data, level) {
        Ok(out) => {
          total_bytes = total_bytes + out.length().to_int64()
          last_out = out
        }
        Err(e) => {
          io_println(world, "compress error: " + e)
          return 1
        }
      }
      i = i + 1
    }
    if args.length() >= 6 {
      let _ = fs_write_bytes(world, args[5], last_out)
    }
    let h = fnv1a_64(last_out)
    io_println(
      world,
      "mode=compress level=" + level.to_string() +
      " iters=" + iters.to_string() +
      " in_len=" + data.length().to_string() +
      " out_len=" + last_out.length().to_string() +
      " total_out=" + total_bytes.to_string() +
      " fnv64=" + hex_u64(h),
    )
    return 0
  }

  if mode == "decompress" {
    let path = args[2]
    let iters = if args.length() >= 4 { parse_int(args[3]) } else { 1 }
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut last_out = Bytes::new(0)
    let mut total_bytes : Int64 = 0L
    let mut i = 0
    while i < iters {
      match bzip2::decompress(data) {
        Ok(out) => {
          total_bytes = total_bytes + out.length().to_int64()
          last_out = out
        }
        Err(e) => {
          io_println(world, "decompress error: " + e)
          return 1
        }
      }
      i = i + 1
    }
    if args.length() >= 5 {
      let _ = fs_write_bytes(world, args[4], last_out)
    }
    let h = fnv1a_64(last_out)
    io_println(
      world,
      "mode=decompress iters=" + iters.to_string() +
      " in_len=" + data.length().to_string() +
      " out_len=" + last_out.length().to_string() +
      " total_out=" + total_bytes.to_string() +
      " fnv64=" + hex_u64(h),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
