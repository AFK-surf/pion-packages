///| Head-to-head benchmark for `packages/qrcode` vs Rust `qrcode = "0.14"` (--release --locked).
///| Workloads (all verified pixel-for-pixel identical between Pion and Rust qrcode 0.14):
///|   w1 - Batch URL / 2FA OTP URI encoding (10,000 ops, v2-v6 M/Q, auto best mask)
///|   w2 - Large multi-version encoding (300 ops, v10/v17/v27/v36/v40 + RS interleaving)
///|   w3 - End-to-end encode + compact SVG generation (5,000 ops, login/device/OTP QR)

import "qrcode"

fn fnv1a_byte(h : UInt64, b : Int) -> UInt64 {
  let x = h ^ (b & 0xFF).to_int64().to_uint64()
  x * 1099511628211UL
}

fn fnv1a_modules(h_in : UInt64, qr : qrcode::QrCode) -> UInt64 {
  let mut h = fnv1a_byte(h_in, qr.size)
  let m = qr.modules
  let n = m.length()
  let mut i = 0
  while i < n {
    h = fnv1a_byte(h, m[i].to_int() & 1)
    i = i + 1
  }
  h
}

fn fnv1a_str(h_in : UInt64, s : String) -> UInt64 {
  let mut h = h_in
  let n = s.length()
  let mut i = 0
  while i < n {
    h = fnv1a_byte(h, s.code_unit_at(i))
    i = i + 1
  }
  fnv1a_byte(h, 0xFF)
}

fn hex_u64(v : UInt64) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 60
  while shift >= 0 {
    let nib = ((v >> shift) & 15UL).to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

fn make_lcg_bytes(n : Int, seed : Int64) -> Bytes {
  let mut b = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
    b[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  b
}

fn bench_w1(world : World) -> Int {
  let inputs = [
    "https://still.fail/o/01m3hng540559hjg7h4rcww0te/chat",
    "otpauth://totp/acme:alice@example.com?secret=jbswy3dpehpk3pxp&issuer=acme",
    "https://github.com/afk-surf/pion-packages/tree/main/packages/qrcode",
    "otpauth://totp/stillfail:bob@example.org?secret=mfrggzdfmztwq2lk&digits=6",
    "https://console.still.fail/device/activate?token=k9x4m2p7q1w8",
  ]
  let ecs = [
    qrcode::EcLevel::M,
    qrcode::EcLevel::Q,
    qrcode::EcLevel::Q,
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
  ]
  let payloads : Array[Bytes] = []
  let mut p = 0
  while p < 5 {
    payloads.push(inputs[p].to_bytes())
    p = p + 1
  }

  let rounds = 2000
  let mut digest = 14695981039346656037UL
  let mut total_modules = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < 5 {
      let qr = match qrcode::encode_bytes(payloads[i], ecs[i]) {
        Result::Ok(q) => q
        Result::Err(_) => return 1
      }
      total_modules = total_modules + (qr.size * qr.size).to_int64()
      digest = fnv1a_modules(digest, qr)
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "mode=w1")
  io_println(world, "ops=10000")
  io_println(world, "total_modules=" + total_modules.to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}

fn bench_w2(world : World) -> Int {
  // Large binary/cert payloads spanning v10, v17, v27, v36, v40
  let payloads = [
    make_lcg_bytes(210, 101L), // v10-M (57x57)
    make_lcg_bytes(500, 102L), // v17-M (85x85)
    make_lcg_bytes(1100, 103L), // v27-M (125x125)
    make_lcg_bytes(1900, 104L), // v36-M (161x161)
    make_lcg_bytes(2900, 105L), // v40-L (177x177)
  ]
  let ecs = [
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::L,
  ]

  let rounds = 60
  let mut digest = 14695981039346656037UL
  let mut total_modules = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < 5 {
      let qr = match qrcode::encode_bytes(payloads[i], ecs[i]) {
        Result::Ok(q) => q
        Result::Err(_) => return 1
      }
      total_modules = total_modules + (qr.size * qr.size).to_int64()
      digest = fnv1a_modules(digest, qr)
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "mode=w2")
  io_println(world, "ops=300")
  io_println(world, "total_modules=" + total_modules.to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}

fn bench_w3(world : World) -> Int {
  let inputs = [
    "https://console.still.fail/device/activate?token=k9x4m2p7q1w8",
    "https://share.still.fail/doc/q4-roadmap?view=compact&theme=dark",
    "https://still.fail/o/01m3hng540559hjg7h4rcww0te/chat",
    "otpauth://totp/stillfail:bob@example.org?secret=mfrggzdfmztwq2lk&digits=6",
    "otpauth://totp/acme:alice@example.com?secret=jbswy3dpehpk3pxp&issuer=acme",
  ]
  let ecs = [
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::M,
    qrcode::EcLevel::Q,
  ]
  let payloads : Array[Bytes] = []
  let mut p = 0
  while p < 5 {
    payloads.push(inputs[p].to_bytes())
    p = p + 1
  }

  let rounds = 1000
  let mut digest = 14695981039346656037UL
  let mut total_svg_bytes = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < 5 {
      let qr = match qrcode::encode_bytes(payloads[i], ecs[i]) {
        Result::Ok(q) => q
        Result::Err(_) => return 1
      }
      let svg = qr.to_svg_default()
      total_svg_bytes = total_svg_bytes + svg.length().to_int64()
      digest = fnv1a_str(digest, svg)
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "mode=w3")
  io_println(world, "ops=5000")
  io_println(world, "total_svg_bytes=" + total_svg_bytes.to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: qrcode_bench <w1|w2|w3>")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    bench_w1(world)
  } else if mode == "w2" {
    bench_w2(world)
  } else if mode == "w3" {
    bench_w3(world)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
