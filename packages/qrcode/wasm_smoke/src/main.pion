///| Dual-target (Native & Wasm32, debug & release) smoke test for `packages/qrcode`.

import "qrcode"

fn fnv1a_byte(h : UInt64, b : Int) -> UInt64 {
  let x = h ^ (b & 0xFF).to_int64().to_uint64()
  x * 1099511628211UL
}

fn fnv1a_str(h_in : UInt64, s : String) -> UInt64 {
  let mut h = h_in
  let mut i = 0
  while i < s.length() {
    h = fnv1a_byte(h, s.code_unit_at(i))
    i = i + 1
  }
  fnv1a_byte(h, 0xFF)
}

fn fnv1a_modules(h_in : UInt64, m : FixedArray[Byte]) -> UInt64 {
  let mut h = h_in
  let mut i = 0
  while i < m.length() {
    h = fnv1a_byte(h, m[i].to_int())
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 60
  while shift >= 0 {
    let nib = ((v >> shift) & 15UL).to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let mut digest = 14695981039346656037UL

  // 1. ISO/IEC 18004 Annex I: HELLO WORLD (v1-Q, mask 6)
  let hw = match qrcode::encode_with_options("HELLO WORLD".to_bytes(), qrcode::EncodeOptions::fixed(1, qrcode::EcLevel::Q, 6)) {
    Result::Ok(q) => q
    Result::Err(_) => return 1
  }
  digest = fnv1a_modules(digest, hw.modules)

  // 2. DP mixed-mode + auto mask + roundtrip decode
  let otp = "otpauth://totp/Pion:dev@still.fail?secret=JBSWY3DPEHPK3PXP&issuer=Pion"
  let qr_otp = match qrcode::encode(otp, qrcode::EcLevel::M) {
    Result::Ok(q) => q
    Result::Err(_) => return 2
  }
  digest = fnv1a_modules(digest, qr_otp.modules)
  let dec_otp = match qrcode::decode(qr_otp) {
    Result::Ok(d) => d
    Result::Err(_) => return 3
  }
  if dec_otp.text != otp {
    io_println(world, "MISMATCH ver=" + qr_otp.version.to_string() + " mask=" + qr_otp.mask.to_string() + " dec_len=" + dec_otp.bytes.length().to_string() + " dec_text=" + dec_otp.text + " segs=" + dec_otp.segments.length().to_string())
    return 4
  }

  // 3. Corrupted modules Reed-Solomon recovery
  let msg = "Wasm32 + Native RS error correction check 1234567890"
  let qr_h = match qrcode::encode(msg, qrcode::EcLevel::H) {
    Result::Ok(q) => q
    Result::Err(_) => return 5
  }
  let n = qr_h.size * qr_h.size
  let damaged : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let mut i = 0
  while i < n {
    damaged[i] = qr_h.modules[i]
    i = i + 1
  }
  let mut k = 0
  while k < 8 {
    let idx = (qr_h.size - 1 - k) * qr_h.size + (qr_h.size - 1 - (k % 4))
    damaged[idx] = (1 - damaged[idx].to_int()).to_byte()
    k = k + 1
  }
  let dec_h = match qrcode::decode_matrix(damaged, qr_h.size) {
    Result::Ok(d) => d
    Result::Err(_) => return 6
  }
  if dec_h.text != msg || dec_h.errors_corrected <= 0 {
    return 7
  }

  // 4. SVG + Terminal + PGM + RGBA renderers
  let svg = hw.to_svg_default()
  let term = hw.to_terminal(2, false)
  let pgm = hw.to_pgm(1, 1)
  let rgba = hw.to_rgba(1, 1, 0x000000FFU, 0xFFFFFFFFU)
  digest = fnv1a_str(digest, svg)
  digest = fnv1a_str(digest, term)
  digest = fnv1a_byte(digest, pgm.length())
  digest = fnv1a_byte(digest, rgba.length())

  io_println(world, "qrcode_wasm_smoke=ok")
  io_println(world, "hw_size=" + hw.size.to_string())
  io_println(world, "otp_version=" + qr_otp.version.to_string())
  io_println(world, "rs_corrected=" + dec_h.errors_corrected.to_string())
  io_println(world, "svg_bytes=" + svg.length().to_string())
  io_println(world, "fnv1a64=" + hex_u64(digest))
  0
}
