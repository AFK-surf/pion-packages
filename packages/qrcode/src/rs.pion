///| GF(256) arithmetic (primitive polynomial 0x11D) and Reed-Solomon encoder & decoder
///| (Berlekamp-Massey + Chien Search + Forney algorithm).

///| Build GF(256) exp table of length 512 (primitive poly x^8 + x^4 + x^3 + x^2 + 1 = 0x11D).
fn build_gf_exp() -> FixedArray[Int] {
  let exp : FixedArray[Int] = FixedArray::make(512, 0)
  let mut x = 1
  let mut i = 0
  while i < 255 {
    exp[i] = x
    exp[i + 255] = x
    x = x << 1
    if (x & 0x100) != 0 {
      x = x ^ 0x11D
    }
    i = i + 1
  }
  exp[510] = exp[0]
  exp[511] = exp[1]
  exp
}

///| Build GF(256) log table of length 256.
fn build_gf_log() -> FixedArray[Int] {
  let log : FixedArray[Int] = FixedArray::make(256, 0)
  let mut x = 1
  let mut i = 0
  while i < 255 {
    log[x] = i
    x = x << 1
    if (x & 0x100) != 0 {
      x = x ^ 0x11D
    }
    i = i + 1
  }
  log
}

let gf_exp_table : FixedArray[Int] = build_gf_exp()
let gf_log_table : FixedArray[Int] = build_gf_log()

///| Multiply two elements in GF(256) with primitive polynomial 0x11D.
pub fn gf_mul(a : Int, b : Int) -> Int {
  let aa = a & 0xFF
  let bb = b & 0xFF
  if aa == 0 || bb == 0 {
    return 0
  }
  gf_exp_table[gf_log_table[aa] + gf_log_table[bb]]
}

///| Divide `a / b` in GF(256) (`b != 0`).
fn gf_div(a : Int, b : Int) -> Int {
  let aa = a & 0xFF
  let bb = b & 0xFF
  if aa == 0 {
    return 0
  }
  gf_exp_table[gf_log_table[aa] + 255 - gf_log_table[bb]]
}

///| Build flat precomputed Reed-Solomon generator polynomials for degrees `0..=30`.
///| Row `d` starts at `d * 32` and stores `d` non-leading coefficients `g[1..=d]`
///| (since `g[0] = 1` is monic).
fn build_rs_gen_table() -> FixedArray[Int] {
  let tbl : FixedArray[Int] = FixedArray::make(31 * 32, 0)
  let mut d = 1
  while d <= 30 {
    let base = d * 32
    // Start with polynomial [1] (stored in tmp[0..=d])
    let tmp : FixedArray[Int] = FixedArray::make(32, 0)
    tmp[0] = 1
    let mut root = 1
    let mut k = 0
    while k < d {
      let mut j = k + 1
      while j >= 1 {
        tmp[j] = tmp[j] ^ gf_mul(tmp[j - 1], root)
        j = j - 1
      }
      root = gf_mul(root, 2)
      k = k + 1
    }
    let mut i = 0
    while i < d {
      tbl[base + i] = tmp[i + 1]
      i = i + 1
    }
    d = d + 1
  }
  tbl
}

let rs_gen_table : FixedArray[Int] = build_rs_gen_table()

///| Compute Reed-Solomon generator polynomial of degree `degree` (length `degree + 1`, monic).
pub fn rs_generator_poly(degree : Int) -> FixedArray[Int] {
  if degree <= 0 {
    return FixedArray::make(1, 1)
  }
  let g : FixedArray[Int] = FixedArray::make(degree + 1, 0)
  g[0] = 1
  if degree <= 30 {
    let base = degree * 32
    let mut i = 0
    while i < degree {
      g[i + 1] = rs_gen_table[base + i]
      i = i + 1
    }
    return g
  }
  let mut root = 1
  let mut k = 0
  while k < degree {
    let mut j = k + 1
    while j >= 1 {
      g[j] = g[j] ^ gf_mul(g[j - 1], root)
      j = j - 1
    }
    root = gf_mul(root, 2)
    k = k + 1
  }
  g
}

///| Zero-allocation hot-path Reed-Solomon remainder computation into `out[out_offset .. out_offset + ec_len]`.
pub fn rs_compute_remainder_into(
  data : FixedArray[Byte],
  data_offset : Int,
  data_len : Int,
  ec_len : Int,
  out : FixedArray[Byte],
  out_offset : Int,
) -> Unit {
  let mut z = 0
  while z < ec_len {
    out[out_offset + z] = (0).to_byte()
    z = z + 1
  }
  if ec_len <= 0 {
    return
  }
  if ec_len <= 30 {
    let gen_base = ec_len * 32
    let mut i = 0
    while i < data_len {
      let factor = (data[data_offset + i].to_int() & 0xFF) ^ (out[out_offset].to_int() & 0xFF)
      // Shift remainder left by 1
      let mut j = 0
      while j < ec_len - 1 {
        out[out_offset + j] = out[out_offset + j + 1]
        j = j + 1
      }
      out[out_offset + ec_len - 1] = (0).to_byte()
      if factor != 0 {
        let log_f = gf_log_table[factor]
        let mut k = 0
        while k < ec_len {
          let coef = rs_gen_table[gen_base + k]
          if coef != 0 {
            let prod = gf_exp_table[log_f + gf_log_table[coef]]
            out[out_offset + k] = ((out[out_offset + k].to_int() & 0xFF) ^ prod).to_byte()
          }
          k = k + 1
        }
      }
      i = i + 1
    }
    return
  }
  let g = rs_generator_poly(ec_len)
  let mut i = 0
  while i < data_len {
    let factor = (data[data_offset + i].to_int() & 0xFF) ^ (out[out_offset].to_int() & 0xFF)
    let mut j = 0
    while j < ec_len - 1 {
      out[out_offset + j] = out[out_offset + j + 1]
      j = j + 1
    }
    out[out_offset + ec_len - 1] = (0).to_byte()
    if factor != 0 {
      let mut k = 0
      while k < ec_len {
        let prod = gf_mul(g[k + 1], factor)
        out[out_offset + k] = ((out[out_offset + k].to_int() & 0xFF) ^ prod).to_byte()
        k = k + 1
      }
    }
    i = i + 1
  }
}

///| Compute `ec_len` Reed-Solomon error-correction bytes for `data`.
pub fn rs_encode_block(data : Bytes, ec_len : Int) -> Bytes {
  let n = data.length()
  let buf : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let mut i = 0
  while i < n {
    buf[i] = data[i]
    i = i + 1
  }
  let rem : FixedArray[Byte] = FixedArray::make(ec_len, (0).to_byte())
  rs_compute_remainder_into(buf, 0, n, ec_len, rem, 0)
  let mut out = Bytes::new(ec_len)
  let mut j = 0
  while j < ec_len {
    out[j] = rem[j]
    j = j + 1
  }
  out
}

///| Decode a Reed-Solomon codeword block (`data || ec`) in-place using
///| Berlekamp-Massey + Chien Search + Forney algorithm.
///| Returns `Ok(num_errors_corrected)` or `Err(QrError::ReedSolomonError(_))`.
pub fn rs_decode_block(codewords : FixedArray[Byte], ec_len : Int) -> Result[Int, QrError] {
  let n = codewords.length()
  if ec_len <= 0 || n <= ec_len || n > 255 {
    return Result::Err(QrError::ReedSolomonError("invalid RS block length"))
  }

  // 1. Compute syndromes S[0..ec_len-1] where S[i] = R(alpha^i)
  let syn : FixedArray[Int] = FixedArray::make(ec_len, 0)
  let mut has_error = false
  let mut i = 0
  while i < ec_len {
    let alpha_i = gf_exp_table[i]
    let mut s = 0
    let mut j = 0
    while j < n {
      s = gf_mul(s, alpha_i) ^ (codewords[j].to_int() & 0xFF)
      j = j + 1
    }
    syn[i] = s
    if s != 0 {
      has_error = true
    }
    i = i + 1
  }
  if !has_error {
    return Result::Ok(0)
  }

  // 2. Berlekamp-Massey algorithm to find error locator polynomial C(x)
  let c : FixedArray[Int] = FixedArray::make(ec_len + 1, 0)
  let b : FixedArray[Int] = FixedArray::make(ec_len + 1, 0)
  let t : FixedArray[Int] = FixedArray::make(ec_len + 1, 0)
  c[0] = 1
  b[0] = 1
  let mut l_deg = 0
  let mut m_shift = 1
  let mut b_disc = 1

  let mut step = 0
  while step < ec_len {
    let mut disc = syn[step]
    let mut k = 1
    while k <= l_deg {
      disc = disc ^ gf_mul(c[k], syn[step - k])
      k = k + 1
    }
    if disc == 0 {
      m_shift = m_shift + 1
    } else {
      let mut cp = 0
      while cp <= ec_len {
        t[cp] = c[cp]
        cp = cp + 1
      }
      let coef = gf_div(disc, b_disc)
      let mut idx = 0
      while idx + m_shift <= ec_len {
        if b[idx] != 0 {
          c[idx + m_shift] = c[idx + m_shift] ^ gf_mul(coef, b[idx])
        }
        idx = idx + 1
      }
      if 2 * l_deg <= step {
        l_deg = step + 1 - l_deg
        let mut bp = 0
        while bp <= ec_len {
          b[bp] = t[bp]
          bp = bp + 1
        }
        b_disc = disc
        m_shift = 1
      } else {
        m_shift = m_shift + 1
      }
    }
    step = step + 1
  }

  let max_errors = ec_len / 2
  if l_deg <= 0 || l_deg > max_errors {
    return Result::Err(QrError::ReedSolomonError("uncorrectable error count"))
  }

  // 3. Chien Search: find all error powers p in 0..n-1 where C(alpha^{-p}) == 0
  let err_powers : FixedArray[Int] = FixedArray::make(l_deg, 0)
  let mut found = 0
  let mut p = 0
  while p < n {
    let inv_x = if p == 0 { 1 } else { gf_exp_table[255 - p] }
    let mut eval = c[0]
    let mut x_pow = inv_x
    let mut k = 1
    while k <= l_deg {
      if c[k] != 0 {
        eval = eval ^ gf_mul(c[k], x_pow)
      }
      x_pow = gf_mul(x_pow, inv_x)
      k = k + 1
    }
    if eval == 0 {
      if found >= l_deg {
        return Result::Err(QrError::ReedSolomonError("too many Chien search roots"))
      }
      err_powers[found] = p
      found = found + 1
    }
    p = p + 1
  }

  if found != l_deg {
    return Result::Err(QrError::ReedSolomonError("Chien search root count mismatch"))
  }

  // 4. Forney algorithm: Omega(x) = (S(x) * C(x)) mod x^{l_deg}
  let omega : FixedArray[Int] = FixedArray::make(l_deg, 0)
  let mut oi = 0
  while oi < l_deg {
    let mut sum = 0
    let mut oj = 0
    while oj <= oi {
      sum = sum ^ gf_mul(c[oj], syn[oi - oj])
      oj = oj + 1
    }
    omega[oi] = sum
    oi = oi + 1
  }

  let mut ei = 0
  while ei < l_deg {
    let p_k = err_powers[ei]
    let x_k = gf_exp_table[p_k]
    let inv_x = if p_k == 0 { 1 } else { gf_exp_table[255 - p_k] }

    // Evaluate Omega(inv_x)
    let mut num = 0
    let mut x_pow = 1
    let mut k = 0
    while k < l_deg {
      if omega[k] != 0 {
        num = num ^ gf_mul(omega[k], x_pow)
      }
      x_pow = gf_mul(x_pow, inv_x)
      k = k + 1
    }

    // Evaluate formal derivative C'(inv_x) = sum_{k odd} C[k] * inv_x^{k-1}
    let mut den = 0
    let inv_x2 = gf_mul(inv_x, inv_x)
    let mut d_pow = 1
    let mut dk = 1
    while dk <= l_deg {
      if c[dk] != 0 {
        den = den ^ gf_mul(c[dk], d_pow)
      }
      d_pow = gf_mul(d_pow, inv_x2)
      dk = dk + 2
    }
    if den == 0 {
      return Result::Err(QrError::ReedSolomonError("zero denominator in Forney"))
    }

    let mag = gf_mul(x_k, gf_div(num, den))
    let pos = n - 1 - p_k
    codewords[pos] = ((codewords[pos].to_int() & 0xFF) ^ mag).to_byte()
    ei = ei + 1
  }

  // 5. Re-verify all syndromes are zero after correction
  let mut vi = 0
  while vi < ec_len {
    let alpha_i = gf_exp_table[vi]
    let mut s = 0
    let mut j = 0
    while j < n {
      s = gf_mul(s, alpha_i) ^ (codewords[j].to_int() & 0xFF)
      j = j + 1
    }
    if s != 0 {
      return Result::Err(QrError::ReedSolomonError("syndrome verification failed after correction"))
    }
    vi = vi + 1
  }

  Result::Ok(l_deg)
}
