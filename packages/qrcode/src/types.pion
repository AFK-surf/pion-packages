///| Public types, options, and errors for `packages/qrcode`.
///| Pure Pion, zero-dependency, World-free ISO/IEC 18004 QR Code encoder,
///| Reed-Solomon matrix decoder, and multi-format renderer.

///| Error correction level per ISO/IEC 18004.
pub enum EcLevel {
  L
  M
  Q
  H
}

///| Convert `EcLevel` to ordinal index: L=0, M=1, Q=2, H=3.
pub fn EcLevel::to_int(self : EcLevel) -> Int {
  match self {
    L => 0
    M => 1
    Q => 2
    H => 3
  }
}

///| Convert `EcLevel` to its 2-bit ISO/IEC 18004 format indicator:
///| L=01 (1), M=00 (0), Q=11 (3), H=10 (2).
pub fn EcLevel::format_bits(self : EcLevel) -> Int {
  match self {
    L => 1
    M => 0
    Q => 3
    H => 2
  }
}

///|
pub fn EcLevel::to_string(self : EcLevel) -> String {
  match self {
    L => "L"
    M => "M"
    Q => "Q"
    H => "H"
  }
}

///|
pub fn ec_level_eq(a : EcLevel, b : EcLevel) -> Bool {
  a.to_int() == b.to_int()
}

///| QR Code data encoding mode per ISO/IEC 18004 §7.4.
#verify
pub enum Mode {
  Numeric
  Alphanumeric
  Byte
  Kanji
  Eci
}

///| 4-bit ISO/IEC 18004 mode indicator.
pub fn Mode::indicator(self : Mode) -> Int {
  match self {
    Numeric => 1
    Alphanumeric => 2
    Byte => 4
    Kanji => 8
    Eci => 7
  }
}

///|
pub fn Mode::to_int(self : Mode) -> Int {
  match self {
    Numeric => 0
    Alphanumeric => 1
    Byte => 2
    Kanji => 3
    Eci => 4
  }
}

///|
pub fn mode_eq(a : Mode, b : Mode) -> Bool {
  a.to_int() == b.to_int()
}

///| Error returned by QR encoding, decoding, or rendering.
pub enum QrError {
  DataTooLong(String)
  InvalidVersion(Int)
  InvalidMask(Int)
  InvalidCharacter(String)
  InvalidEci(Int)
  InvalidMatrixSize(Int)
  FormatDecodeError(String)
  VersionDecodeError(String)
  ReedSolomonError(String)
  InvalidDataStream(String)
  UnsupportedMode(Int)
  InvalidRenderOption(String)
}

///| Human-readable description of a `QrError`.
pub fn qr_error_message(err : QrError) -> String {
  match err {
    DataTooLong(msg) => "data too long: " + msg
    InvalidVersion(v) => "invalid QR version (expected 1..40): " + v.to_string()
    InvalidMask(m) => "invalid mask pattern (expected -1 or 0..7): " + m.to_string()
    InvalidCharacter(msg) => "invalid character for mode: " + msg
    InvalidEci(e) => "invalid ECI designator (expected 0..999999): " + e.to_string()
    InvalidMatrixSize(n) => "invalid QR matrix size: " + n.to_string()
    FormatDecodeError(msg) => "format info decode error: " + msg
    VersionDecodeError(msg) => "version info decode error: " + msg
    ReedSolomonError(msg) => "Reed-Solomon error: " + msg
    InvalidDataStream(msg) => "invalid QR data bitstream: " + msg
    UnsupportedMode(m) => "unsupported QR mode indicator: " + m.to_string()
    InvalidRenderOption(msg) => "invalid render option: " + msg
  }
}

///|
pub fn QrError::to_string(self : QrError) -> String {
  qr_error_message(self)
}

///| A single typed data segment (Numeric, Alphanumeric, Byte, Kanji, or ECI).
pub struct Segment {
  pub mode : Mode
  pub data : Bytes
  pub eci_designator : Int
}

///| Create a Numeric mode segment (ASCII digits '0'..'9').
pub fn Segment::numeric(s : String) -> Segment {
  Segment::{ mode: Mode::Numeric, data: s.to_bytes(), eci_designator: -1 }
}

///| Create an Alphanumeric mode segment (ISO/IEC 18004 45-character set).
pub fn Segment::alphanumeric(s : String) -> Segment {
  Segment::{ mode: Mode::Alphanumeric, data: s.to_bytes(), eci_designator: -1 }
}

///| Create a Byte mode segment from arbitrary bytes.
pub fn Segment::byte(b : Bytes) -> Segment {
  Segment::{ mode: Mode::Byte, data: b, eci_designator: -1 }
}

///| Create a Kanji mode segment from Shift-JIS double-byte pairs.
pub fn Segment::kanji(shift_jis : Bytes) -> Segment {
  Segment::{ mode: Mode::Kanji, data: shift_jis, eci_designator: -1 }
}

///| Create an ECI (Extended Channel Interpretation) header segment (e.g. 26 for UTF-8).
pub fn Segment::eci(designator : Int) -> Segment {
  Segment::{ mode: Mode::Eci, data: Bytes::new(0), eci_designator: designator }
}

///| Options controlling QR Code encoding.
pub struct EncodeOptions {
  pub ec_level : EcLevel
  pub min_version : Int
  pub max_version : Int
  pub mask : Int
  pub optimize_mode : Bool
  pub boost_ecl : Bool
}

///| Default options: EcLevel::M, versions 1..40, auto mask (-1), DP optimal mixed-mode on.
pub fn EncodeOptions::default() -> EncodeOptions {
  EncodeOptions::{
    ec_level: EcLevel::M,
    min_version: 1,
    max_version: 40,
    mask: -1,
    optimize_mode: true,
    boost_ecl: false,
  }
}

///| Options for a specific error correction level with all other defaults.
pub fn EncodeOptions::with_ec(ec : EcLevel) -> EncodeOptions {
  EncodeOptions::{
    ec_level: ec,
    min_version: 1,
    max_version: 40,
    mask: -1,
    optimize_mode: true,
    boost_ecl: false,
  }
}

///| Options for a fixed version, error correction level, and mask (-1 for auto).
pub fn EncodeOptions::fixed(version : Int, ec : EcLevel, mask : Int) -> EncodeOptions {
  EncodeOptions::{
    ec_level: ec,
    min_version: version,
    max_version: version,
    mask: mask,
    optimize_mode: true,
    boost_ecl: false,
  }
}

///| Encoded QR Code symbol.
pub struct QrCode {
  pub version : Int
  pub ec_level : EcLevel
  pub mask : Int
  pub size : Int
  pub modules : FixedArray[Byte]
}

///| Return true if module at `(x, y)` is dark; false if light or out of bounds.
pub fn QrCode::get(self : QrCode, x : Int, y : Int) -> Bool {
  if x < 0 || y < 0 || x >= self.size || y >= self.size {
    return false
  }
  self.modules[y * self.size + x] != (0).to_byte()
}

///| Width (and height) of the QR symbol in modules (`version * 4 + 17`).
pub fn QrCode::width(self : QrCode) -> Int {
  self.size
}

///| Result of decoding a QR Code matrix.
pub struct DecodedQr {
  pub version : Int
  pub ec_level : EcLevel
  pub mask : Int
  pub eci : Int
  pub bytes : Bytes
  pub text : String
  pub segments : Array[Segment]
  pub errors_corrected : Int
}

///| Options for SVG rendering.
pub struct SvgOptions {
  pub quiet_zone : Int
  pub dark_color : String
  pub light_color : String
  pub compact_path : Bool
  pub module_size : Int
}

///| Default SVG options: quiet_zone=4, `#000000` on `#ffffff`, compact `<path>` merging.
pub fn SvgOptions::default() -> SvgOptions {
  SvgOptions::{
    quiet_zone: 4,
    dark_color: "#000000",
    light_color: "#ffffff",
    compact_path: true,
    module_size: 1,
  }
}
