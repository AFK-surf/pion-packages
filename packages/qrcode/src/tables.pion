///| ISO/IEC 18004 tables: version geometry, EC codewords & block counts (v1..v40 x L/M/Q/H),
///| alignment pattern coordinates, character count bits, Format BCH(15,5), and Version BCH(18,6).

///| Matrix dimension for version `1..=40`: `version * 4 + 17`.
#verify
pub fn version_size(version : Int) -> Int {
  version * 4 + 17
}

///| Total raw data-area module bits for version `1..=40`.
#verify
pub fn raw_data_modules(version : Int) -> Int {
  if version < 1 || version > 40 {
    return 0
  }
  let mut result = (16 * version + 128) * version + 64
  if version >= 2 {
    let num_align = version / 7 + 2
    result = result - (25 * num_align - 10) * num_align + 55
    if version >= 7 {
      result = result - 36
    }
  }
  result
}

///| Total raw codewords (data + EC) available in the matrix for version `1..=40`.
#verify
pub fn total_codewords(version : Int) -> Int {
  raw_data_modules(version) / 8
}

///| Build the 160-entry ISO/IEC 18004 Table 9 EC codewords per block table.
///| Indexed by `ec.to_int() * 40 + (version - 1)`.
fn build_ec_per_block() -> FixedArray[Int] {
  let vals = [
    // L (v1..v40)
    7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28,
    28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
    // M (v1..v40)
    10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26,
    26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
    // Q (v1..v40)
    13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30,
    28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
    // H (v1..v40)
    17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28,
    30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
  ]
  let a : FixedArray[Int] = FixedArray::make(160, 0)
  let mut i = 0
  while i < 160 {
    a[i] = vals[i]
    i = i + 1
  }
  a
}

///| Build the 160-entry ISO/IEC 18004 Table 9 number of Reed-Solomon blocks table.
fn build_num_blocks() -> FixedArray[Int] {
  let vals = [
    // L (v1..v40)
    1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12,
    12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25,
    // M (v1..v40)
    1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18,
    20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49,
    // Q (v1..v40)
    1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23,
    25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68,
    // H (v1..v40)
    1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34,
    30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81,
  ]
  let a : FixedArray[Int] = FixedArray::make(160, 0)
  let mut i = 0
  while i < 160 {
    a[i] = vals[i]
    i = i + 1
  }
  a
}

let ec_per_block_table : FixedArray[Int] = build_ec_per_block()
let num_blocks_table : FixedArray[Int] = build_num_blocks()

///| Number of EC codewords per Reed-Solomon block for `(version, ec)`.
pub fn ec_codewords_per_block(version : Int, ec : EcLevel) -> Int {
  if version < 1 || version > 40 {
    return 0
  }
  ec_per_block_table[ec.to_int() * 40 + (version - 1)]
}

///| Number of Reed-Solomon blocks for `(version, ec)`.
pub fn num_blocks(version : Int, ec : EcLevel) -> Int {
  if version < 1 || version > 40 {
    return 0
  }
  num_blocks_table[ec.to_int() * 40 + (version - 1)]
}

///| Number of data codewords for `(version, ec)`.
pub fn data_codewords(version : Int, ec : EcLevel) -> Int {
  if version < 1 || version > 40 {
    return 0
  }
  total_codewords(version) - ec_codewords_per_block(version, ec) * num_blocks(version, ec)
}

///| Alignment pattern center coordinates for version `1..=40` (empty for v1).
pub fn alignment_pattern_positions(version : Int) -> Array[Int] {
  let out : Array[Int] = []
  if version <= 1 || version > 40 {
    return out
  }
  let num_align = version / 7 + 2
  let step = if version == 32 {
    26
  } else {
    ((version * 4 + num_align * 2 + 1) / (num_align * 2 - 2)) * 2
  }
  let last = version * 4 + 10
  out.push(6)
  let mut i = num_align - 2
  while i >= 0 {
    out.push(last - i * step)
    i = i - 1
  }
  out
}

///| Character count indicator bit length for `(version, mode)`.
#verify
pub fn char_count_bits(version : Int, mode : Mode) -> Int {
  let tier = if version <= 9 { 0 } else if version <= 26 { 1 } else { 2 }
  match mode {
    Mode::Numeric => if tier == 0 { 10 } else if tier == 1 { 12 } else { 14 }
    Mode::Alphanumeric => if tier == 0 { 9 } else if tier == 1 { 11 } else { 13 }
    Mode::Byte => if tier == 0 { 8 } else { 16 }
    Mode::Kanji => if tier == 0 { 8 } else if tier == 1 { 10 } else { 12 }
    Mode::Eci => 0
  }
}

///| 15-bit ISO/IEC 18004 Format Information BCH(15,5) codeword XOR 0x5412.
pub fn format_info_bits(ec : EcLevel, mask : Int) -> Int {
  let data = (ec.format_bits() << 3) | (mask & 7)
  let mut rem = data
  let mut i = 0
  while i < 10 {
    rem = (rem << 1) ^ ((rem >> 9) * 0x537)
    i = i + 1
  }
  ((data << 10) | rem) ^ 0x5412
}

///| 18-bit ISO/IEC 18004 Version Information BCH(18,6) codeword for version `7..=40`.
pub fn version_info_bits(version : Int) -> Int {
  if version < 7 || version > 40 {
    return 0
  }
  let mut rem = version
  let mut i = 0
  while i < 12 {
    rem = (rem << 1) ^ ((rem >> 11) * 0x1F25)
    i = i + 1
  }
  (version << 12) | rem
}
