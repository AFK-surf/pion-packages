///| ISO/IEC 18004 QR Code matrix encoder, 8 mask patterns, and 4 exact penalty rules.

///| Evaluate ISO/IEC 18004 mask condition `0..=7` at coordinates `(x, y)`.
pub fn apply_mask_condition(mask : Int, x : Int, y : Int) -> Bool {
  if mask == 0 {
    ((x + y) & 1) == 0
  } else if mask == 1 {
    (y & 1) == 0
  } else if mask == 2 {
    x % 3 == 0
  } else if mask == 3 {
    (x + y) % 3 == 0
  } else if mask == 4 {
    (((y / 2) + (x / 3)) & 1) == 0
  } else if mask == 5 {
    let xy = x * y
    (xy & 1) + (xy % 3) == 0
  } else if mask == 6 {
    let xy = x * y
    (((xy & 1) + (xy % 3)) & 1) == 0
  } else {
    ((((x + y) & 1) + ((x * y) % 3)) & 1) == 0
  }
}

///| Compute ISO/IEC 18004 §7.8.3.1 total penalty score (N1 + N2 + N3 + N4).
pub fn compute_penalty(modules : FixedArray[Byte], size : Int) -> Int {
  let mut penalty = 0
  let mut dark_count = 0

  // 1. Horizontal scan: N1 (runs >= 5) + N3 (1:1:3:1:1 with 4 light) + count dark modules
  let mut y = 0
  while y < size {
    let row_off = y * size
    let mut run_color = modules[row_off].to_int() & 1
    let mut run_len = 1
    if run_color != 0 {
      dark_count = dark_count + 1
    }
    let mut bits = run_color
    let mut x = 1
    while x < size {
      let c = modules[row_off + x].to_int() & 1
      if c != 0 {
        dark_count = dark_count + 1
      }
      if c == run_color {
        run_len = run_len + 1
        if run_len == 5 {
          penalty = penalty + 3
        } else if run_len > 5 {
          penalty = penalty + 1
        }
      } else {
        run_color = c
        run_len = 1
      }
      bits = ((bits << 1) | c) & 0x7FF
      // 00001011101 = 0x05D, 10111010000 = 0x5D0
      if x >= 10 && (bits == 0x05D || bits == 0x5D0) {
        penalty = penalty + 40
      }
      x = x + 1
    }
    y = y + 1
  }

  // 2. Vertical scan: N1 + N3
  let mut x = 0
  while x < size {
    let mut run_color = modules[x].to_int() & 1
    let mut run_len = 1
    let mut bits = run_color
    let mut y2 = 1
    while y2 < size {
      let c = modules[y2 * size + x].to_int() & 1
      if c == run_color {
        run_len = run_len + 1
        if run_len == 5 {
          penalty = penalty + 3
        } else if run_len > 5 {
          penalty = penalty + 1
        }
      } else {
        run_color = c
        run_len = 1
      }
      bits = ((bits << 1) | c) & 0x7FF
      if y2 >= 10 && (bits == 0x05D || bits == 0x5D0) {
        penalty = penalty + 40
      }
      y2 = y2 + 1
    }
    x = x + 1
  }

  // 3. N2: 2x2 same-color blocks (+3 each)
  let mut by = 0
  while by < size - 1 {
    let r0 = by * size
    let r1 = r0 + size
    let mut bx = 0
    while bx < size - 1 {
      let c = modules[r0 + bx]
      if c == modules[r0 + bx + 1] && c == modules[r1 + bx] && c == modules[r1 + bx + 1] {
        penalty = penalty + 3
      }
      bx = bx + 1
    }
    by = by + 1
  }

  // 4. N4: dark/light balance
  let total = size * size
  let diff = dark_count * 20 - total * 10
  let abs_diff = if diff < 0 { -diff } else { diff }
  let k = abs_diff / total
  penalty = penalty + k * 10

  penalty
}

///| Helper: set a function module at `(x, y)` in `modules` and mark `is_func`.
fn set_func_module(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  x : Int,
  y : Int,
  dark : Bool,
) -> Unit {
  if x >= 0 && y >= 0 && x < size && y < size {
    let idx = y * size + x
    modules[idx] = if dark { (1).to_byte() } else { (0).to_byte() }
    is_func[idx] = (1).to_byte()
  }
}

///| Draw a 7x7 finder pattern + 1-module white separator centered at `(cx, cy)`.
fn draw_finder_pattern(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  cx : Int,
  cy : Int,
) -> Unit {
  let mut dy = -4
  while dy <= 4 {
    let mut dx = -4
    while dx <= 4 {
      let adx = if dx < 0 { -dx } else { dx }
      let ady = if dy < 0 { -dy } else { dy }
      let dist = if adx > ady { adx } else { ady }
      let dark = dist != 2 && dist != 4
      set_func_module(modules, is_func, size, cx + dx, cy + dy, dark)
      dx = dx + 1
    }
    dy = dy + 1
  }
}

///| Draw a 5x5 alignment pattern centered at `(cx, cy)`.
fn draw_alignment_pattern(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  cx : Int,
  cy : Int,
) -> Unit {
  let mut dy = -2
  while dy <= 2 {
    let mut dx = -2
    while dx <= 2 {
      let adx = if dx < 0 { -dx } else { dx }
      let ady = if dy < 0 { -dy } else { dy }
      let dist = if adx > ady { adx } else { ady }
      set_func_module(modules, is_func, size, cx + dx, cy + dy, dist != 1)
      dx = dx + 1
    }
    dy = dy + 1
  }
}

///| Draw format information bits (two copies) + dark module at `(8, size - 8)`.
fn draw_format_bits(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  ec : EcLevel,
  mask : Int,
) -> Unit {
  let bits = format_info_bits(ec, mask)
  // First copy: around top-left finder
  let mut i = 0
  while i <= 5 {
    set_func_module(modules, is_func, size, 8, i, ((bits >> i) & 1) != 0)
    i = i + 1
  }
  set_func_module(modules, is_func, size, 8, 7, ((bits >> 6) & 1) != 0)
  set_func_module(modules, is_func, size, 8, 8, ((bits >> 7) & 1) != 0)
  set_func_module(modules, is_func, size, 7, 8, ((bits >> 8) & 1) != 0)
  let mut j = 9
  while j < 15 {
    set_func_module(modules, is_func, size, 14 - j, 8, ((bits >> j) & 1) != 0)
    j = j + 1
  }
  // Second copy: top-right and bottom-left
  let mut k = 0
  while k < 8 {
    set_func_module(modules, is_func, size, size - 1 - k, 8, ((bits >> k) & 1) != 0)
    k = k + 1
  }
  let mut m = 8
  while m < 15 {
    set_func_module(modules, is_func, size, 8, size - 15 + m, ((bits >> m) & 1) != 0)
    m = m + 1
  }
  // Always-dark module
  set_func_module(modules, is_func, size, 8, size - 8, true)
}

///| Draw 18-bit version information blocks for v7..v40.
fn draw_version_bits(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  version : Int,
) -> Unit {
  if version < 7 {
    return
  }
  let bits = version_info_bits(version)
  let mut i = 0
  while i < 18 {
    let dark = ((bits >> i) & 1) != 0
    let a = size - 11 + (i % 3)
    let b = i / 3
    set_func_module(modules, is_func, size, a, b, dark)
    set_func_module(modules, is_func, size, b, a, dark)
    i = i + 1
  }
}

///| Build all function patterns (finders, separators, timing, alignments, version, format placeholder).
pub fn draw_function_patterns(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  version : Int,
  ec : EcLevel,
) -> Unit {
  let size = version_size(version)
  // Timing patterns
  let mut i = 0
  while i < size {
    let dark = (i & 1) == 0
    set_func_module(modules, is_func, size, 6, i, dark)
    set_func_module(modules, is_func, size, i, 6, dark)
    i = i + 1
  }
  // 3 Finder patterns
  draw_finder_pattern(modules, is_func, size, 3, 3)
  draw_finder_pattern(modules, is_func, size, size - 4, 3)
  draw_finder_pattern(modules, is_func, size, 3, size - 4)

  // Alignment patterns
  let align = alignment_pattern_positions(version)
  let n_align = align.length()
  let mut ai = 0
  while ai < n_align {
    let mut aj = 0
    while aj < n_align {
      let skip =
      (ai == 0 && aj == 0) ||
      (ai == 0 && aj == n_align - 1) ||
      (ai == n_align - 1 && aj == 0)
      if !skip {
        draw_alignment_pattern(modules, is_func, size, align[ai], align[aj])
      }
      aj = aj + 1
    }
    ai = ai + 1
  }

  // Format bits (dummy mask 0 to reserve function area) & Version bits
  draw_format_bits(modules, is_func, size, ec, 0)
  draw_version_bits(modules, is_func, size, version)
}

///| Interleave data codewords + Reed-Solomon EC codewords across all blocks.
fn interleave_codewords(
  data_cw : FixedArray[Byte],
  version : Int,
  ec : EcLevel,
) -> FixedArray[Byte] {
  let tot_cw = total_codewords(version)
  let nb = num_blocks(version, ec)
  let ecpb = ec_codewords_per_block(version, ec)
  let num_short = nb - (tot_cw % nb)
  let short_total = tot_cw / nb
  let short_data = short_total - ecpb
  let long_data = short_data + 1

  let out : FixedArray[Byte] = FixedArray::make(tot_cw, (0).to_byte())
  let ec_buf : FixedArray[Byte] = FixedArray::make(nb * ecpb, (0).to_byte())

  // Compute EC for each block & interleave data codewords in one pass
  let mut data_off = 0
  let mut b = 0
  while b < nb {
    let blen = if b < num_short { short_data } else { long_data }
    rs_compute_remainder_into(data_cw, data_off, blen, ecpb, ec_buf, b * ecpb)
    // Place block b's data bytes into interleaved positions
    let mut j = 0
    while j < short_data {
      out[j * nb + b] = data_cw[data_off + j]
      j = j + 1
    }
    if blen > short_data {
      out[short_data * nb + (b - num_short)] = data_cw[data_off + short_data]
    }
    data_off = data_off + blen
    b = b + 1
  }

  // Place interleaved EC bytes
  let ec_start = data_cw.length()
  let mut j = 0
  while j < ecpb {
    let mut bi = 0
    while bi < nb {
      out[ec_start + j * nb + bi] = ec_buf[bi * ecpb + j]
      bi = bi + 1
    }
    j = j + 1
  }

  out
}

///| Place interleaved codeword bits into non-function modules in ISO/IEC 18004 zigzag order.
fn draw_codewords(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  codewords : FixedArray[Byte],
) -> Unit {
  let total_bits = codewords.length() * 8
  let mut bit_idx = 0
  let mut right = size - 1
  while right >= 1 {
    if right == 6 {
      right = 5
    }
    let upward = ((right + 1) & 2) == 0
    let mut vert = 0
    while vert < size {
      let y = if upward { size - 1 - vert } else { vert }
      let row_off = y * size
      let idx0 = row_off + right
      if is_func[idx0] == (0).to_byte() {
        if bit_idx < total_bits {
          let bit = ((codewords[bit_idx >> 3].to_int() & 0xFF) >> (7 - (bit_idx & 7))) & 1
          modules[idx0] = bit.to_byte()
        } else {
          modules[idx0] = (0).to_byte()
        }
        bit_idx = bit_idx + 1
      }
      let idx1 = idx0 - 1
      if is_func[idx1] == (0).to_byte() {
        if bit_idx < total_bits {
          let bit = ((codewords[bit_idx >> 3].to_int() & 0xFF) >> (7 - (bit_idx & 7))) & 1
          modules[idx1] = bit.to_byte()
        } else {
          modules[idx1] = (0).to_byte()
        }
        bit_idx = bit_idx + 1
      }
      vert = vert + 1
    }
    right = right - 2
  }
}

///| Toggle (XOR) mask pattern `mask` in-place on all non-function modules.
fn toggle_mask(
  modules : FixedArray[Byte],
  is_func : FixedArray[Byte],
  size : Int,
  mask : Int,
) -> Unit {
  let mut y = 0
  while y < size {
    let row = y * size
    let mut x = 0
    while x < size {
      let idx = row + x
      if is_func[idx] == (0).to_byte() && apply_mask_condition(mask, x, y) {
        modules[idx] = ((modules[idx].to_int() & 1) ^ 1).to_byte()
      }
      x = x + 1
    }
    y = y + 1
  }
}

///| Build final `QrCode` from packed data codewords, version, EC level, and mask (-1 for auto).
fn build_symbol(
  data_cw : FixedArray[Byte],
  version : Int,
  ec : EcLevel,
  mask_opt : Int,
) -> QrCode {
  let size = version_size(version)
  let n = size * size
  let modules : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let is_func : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  draw_function_patterns(modules, is_func, version, ec)
  let all_cw = interleave_codewords(data_cw, version, ec)
  draw_codewords(modules, is_func, size, all_cw)

  let chosen_mask = if mask_opt >= 0 {
    toggle_mask(modules, is_func, size, mask_opt)
    draw_format_bits(modules, is_func, size, ec, mask_opt)
    mask_opt
  } else {
    let mut best_m = 0
    let mut best_pen = 2147483647
    let mut m = 0
    while m < 8 {
      toggle_mask(modules, is_func, size, m)
      draw_format_bits(modules, is_func, size, ec, m)
      let pen = compute_penalty(modules, size)
      if pen < best_pen {
        best_pen = pen
        best_m = m
      }
      toggle_mask(modules, is_func, size, m)
      m = m + 1
    }
    toggle_mask(modules, is_func, size, best_m)
    draw_format_bits(modules, is_func, size, ec, best_m)
    best_m
  }

  QrCode::{
    version: version,
    ec_level: ec,
    mask: chosen_mask,
    size: size,
    modules: modules,
  }
}

///| Validate `EncodeOptions`.
fn validate_options(opts : EncodeOptions) -> Result[Unit, QrError] {
  if opts.min_version < 1 || opts.min_version > 40 {
    return Result::Err(QrError::InvalidVersion(opts.min_version))
  }
  if opts.max_version < 1 || opts.max_version > 40 || opts.max_version < opts.min_version {
    return Result::Err(QrError::InvalidVersion(opts.max_version))
  }
  if opts.mask < -1 || opts.mask > 7 {
    return Result::Err(QrError::InvalidMask(opts.mask))
  }
  Result::Ok(())
}

///| Pick the best single mode for `data` when `optimize_mode == false`.
fn single_mode_segments(data : Bytes) -> Array[Segment] {
  let n = data.length()
  if n == 0 {
    return []
  }
  let mut all_num = true
  let mut all_alnum = true
  let mut i = 0
  while i < n {
    let b = data[i].to_int() & 0xFF
    if !is_numeric_byte(b) {
      all_num = false
      if alphanumeric_value(b) < 0 {
        all_alnum = false
        break
      }
    }
    i = i + 1
  }
  if all_num {
    [Segment::{ mode: Mode::Numeric, data: data, eci_designator: -1 }]
  } else if all_alnum {
    [Segment::{ mode: Mode::Alphanumeric, data: data, eci_designator: -1 }]
  } else {
    [Segment::{ mode: Mode::Byte, data: data, eci_designator: -1 }]
  }
}

///| Encode explicit segments (including ECI / Kanji / manual splits) with `EncodeOptions`.
pub fn encode_segments(segments : Array[Segment], opts : EncodeOptions) -> Result[QrCode, QrError] {
  match validate_options(opts) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  let mut chosen_v = -1
  let mut v = opts.min_version
  while v <= opts.max_version {
    match segments_bit_length(segments, v) {
      Result::Ok(bits) =>
      if bits <= data_codewords(v, opts.ec_level) * 8 {
        chosen_v = v
        break
      }
      Result::Err(QrError::DataTooLong(_)) => ()
      Result::Err(e) => return Result::Err(e)
    }
    v = v + 1
  }
  if chosen_v < 0 {
    return Result::Err(QrError::DataTooLong("segments exceed max_version capacity"))
  }

  let mut chosen_ec = opts.ec_level
  if opts.boost_ecl {
    let bits = match segments_bit_length(segments, chosen_v) {
      Result::Ok(b) => b
      Result::Err(e) => return Result::Err(e)
    }
    let levels = [EcLevel::M, EcLevel::Q, EcLevel::H]
    let mut li = 0
    while li < 3 {
      let cand = levels[li]
      if cand.to_int() > chosen_ec.to_int() && bits <= data_codewords(chosen_v, cand) * 8 {
        chosen_ec = cand
      }
      li = li + 1
    }
  }

  let data_cw = match encode_segments_to_codewords(segments, chosen_v, chosen_ec) {
    Result::Ok(cw) => cw
    Result::Err(e) => return Result::Err(e)
  }
  Result::Ok(build_symbol(data_cw, chosen_v, chosen_ec, opts.mask))
}

///| Encode arbitrary bytes with explicit `EncodeOptions`.
pub fn encode_with_options(data : Bytes, opts : EncodeOptions) -> Result[QrCode, QrError] {
  match validate_options(opts) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }

  // Evaluate version tiers (tier 0: v1..9, tier 1: v10..26, tier 2: v27..40)
  // computing optimal segments at most once per tier.
  let mut chosen_v = -1
  let mut chosen_segs : Array[Segment] = []
  let mut last_tier = -1
  let mut tier_segs : Array[Segment] = []
  let mut tier_bits = 0

  let mut v = opts.min_version
  while v <= opts.max_version {
    let tier = if v <= 9 { 0 } else if v <= 26 { 1 } else { 2 }
    if tier != last_tier {
      tier_segs = if opts.optimize_mode {
        optimize_segments(data, v)
      } else {
        single_mode_segments(data)
      }
      tier_bits = match segments_bit_length(tier_segs, v) {
        Result::Ok(b) => b
        Result::Err(QrError::DataTooLong(_)) => 2147483647
        Result::Err(e) => return Result::Err(e)
      }
      last_tier = tier
    }
    if tier_bits <= data_codewords(v, opts.ec_level) * 8 {
      chosen_v = v
      chosen_segs = tier_segs
      break
    }
    v = v + 1
  }

  if chosen_v < 0 {
    return Result::Err(QrError::DataTooLong("data exceeds max_version capacity"))
  }

  let mut chosen_ec = opts.ec_level
  if opts.boost_ecl {
    let levels = [EcLevel::M, EcLevel::Q, EcLevel::H]
    let mut li = 0
    while li < 3 {
      let cand = levels[li]
      if cand.to_int() > chosen_ec.to_int() && tier_bits <= data_codewords(chosen_v, cand) * 8 {
        chosen_ec = cand
      }
      li = li + 1
    }
  }

  let data_cw = match encode_segments_to_codewords(chosen_segs, chosen_v, chosen_ec) {
    Result::Ok(cw) => cw
    Result::Err(e) => return Result::Err(e)
  }
  Result::Ok(build_symbol(data_cw, chosen_v, chosen_ec, opts.mask))
}

///| Encode UTF-8 text into a QR Code with the given error correction level.
pub fn encode(text : String, ec : EcLevel) -> Result[QrCode, QrError] {
  encode_with_options(text.to_bytes(), EncodeOptions::with_ec(ec))
}

///| Encode arbitrary bytes into a QR Code with the given error correction level.
pub fn encode_bytes(data : Bytes, ec : EcLevel) -> Result[QrCode, QrError] {
  encode_with_options(data, EncodeOptions::with_ec(ec))
}
