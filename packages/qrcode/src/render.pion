///| Multi-format QR Code renderers: compact SVG, UTF-8 terminal half-blocks,
///| ASCII, 8-bit PGM, and 32-bit RGBA raster.

///| Render a QR Code to SVG (compact merged `<path>` or `<rect>`).
pub fn render_svg(qr : QrCode, opts : SvgOptions) -> String {
  let _ = qr
  let _ = opts
  ""
}

///| Render a QR Code to UTF-8 terminal half-block characters (`▀`, `▄`, `█`, ` `).
pub fn render_terminal(qr : QrCode, quiet_zone : Int, invert : Bool) -> String {
  let _ = qr
  let _ = quiet_zone
  let _ = invert
  ""
}

///| Render a QR Code to plain ASCII (`##` for dark, `  ` for light).
pub fn render_ascii(qr : QrCode, quiet_zone : Int) -> String {
  let _ = qr
  let _ = quiet_zone
  ""
}

///| Render a QR Code to binary P5 PGM (8-bit grayscale).
pub fn render_pgm(qr : QrCode, quiet_zone : Int, scale : Int) -> Bytes {
  let _ = qr
  let _ = quiet_zone
  let _ = scale
  Bytes::new(0)
}

///| Render a QR Code to 32-bit RGBA pixel buffer (`dark_rgba`/`light_rgba` as 0xRRGGBBAA).
pub fn render_rgba(
  qr : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Bytes {
  let _ = qr
  let _ = quiet_zone
  let _ = scale
  let _ = dark_rgba
  let _ = light_rgba
  Bytes::new(0)
}

///| Convenience method: render SVG with `opts`.
pub fn QrCode::to_svg(self : QrCode, opts : SvgOptions) -> String {
  render_svg(self, opts)
}

///| Convenience method: render SVG with default options.
pub fn QrCode::to_svg_default(self : QrCode) -> String {
  render_svg(self, SvgOptions::default())
}

///| Convenience method: render UTF-8 terminal half-blocks.
pub fn QrCode::to_terminal(self : QrCode, quiet_zone : Int, invert : Bool) -> String {
  render_terminal(self, quiet_zone, invert)
}

///| Convenience method: render ASCII.
pub fn QrCode::to_ascii(self : QrCode, quiet_zone : Int) -> String {
  render_ascii(self, quiet_zone)
}

///| Convenience method: render P5 PGM.
pub fn QrCode::to_pgm(self : QrCode, quiet_zone : Int, scale : Int) -> Bytes {
  render_pgm(self, quiet_zone, scale)
}

///| Convenience method: render 32-bit RGBA.
pub fn QrCode::to_rgba(
  self : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Bytes {
  render_rgba(self, quiet_zone, scale, dark_rgba, light_rgba)
}
