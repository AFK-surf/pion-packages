///| Multi-format QR Code renderers: compact SVG (<path> horizontal run merging or <rect>),
///| UTF-8 terminal half-blocks, ASCII, 8-bit P5 PGM, and 32-bit RGBA raster.

let max_raster_bytes : Int64 = 268435456L // 256 MiB (2^28 bytes)
let max_rgba_dim : Int64 = 8192L // 8192^2 * 4 = 268,435,456 bytes
let max_pgm_dim : Int64 = 16384L // 16384^2 = 268,435,456 bytes
let max_text_dim : Int64 = 2048L // caps ASCII/terminal output to a few MiB

///| Return true if `c` is an ASCII hex digit (`0-9`, `a-f`, `A-F`).
fn is_hex_digit(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

///| Return true if `c` is an ASCII letter (`A-Z`, `a-z`).
fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

///| Validate an SVG color string against a strict safe whitelist:
///| `#rgb`, `#rgba`, `#rrggbb`, `#rrggbbaa`, or ASCII-letter CSS color keywords
///| (`none`, `currentColor`, `transparent`, named colors). Rejects quotes, tags,
///| entities, control chars, and any injection payload.
pub fn is_safe_svg_color(color : String) -> Bool {
  let n = color.length()
  if n == 0 || n > 64 {
    return false
  }
  if color.code_unit_at(0) == 35 {
    if n != 4 && n != 5 && n != 7 && n != 9 {
      return false
    }
    let mut i = 1
    while i < n {
      if !is_hex_digit(color.code_unit_at(i)) {
        return false
      }
      i = i + 1
    }
    return true
  }
  if n > 32 {
    return false
  }
  let mut i = 0
  while i < n {
    if !is_ascii_alpha(color.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Sanitize an SVG color string, falling back to `fallback` if invalid.
fn sanitize_svg_color(color : String, fallback : String) -> String {
  if is_safe_svg_color(color) {
    color
  } else {
    fallback
  }
}

///| Internal SVG renderer using 64-bit coordinate arithmetic to prevent Int32 overflow.
fn render_svg_inner(
  qr : QrCode,
  qz : Int,
  scale : Int,
  dark_color : String,
  light_color : String,
  compact_path : Bool,
) -> Result[String, QrError] {
  let qz64 = qz.to_int64()
  let sc64 = scale.to_int64()
  let total_mod = qr.size.to_int64() + qz64 * 2L
  if total_mod <= 0L || sc64 <= 0L || sc64 > 9223372036854775807L / total_mod {
    return Result::Err(QrError::InvalidRenderOption("SVG dimensions overflow Int64"))
  }
  let dim = total_mod * sc64
  let dim_s = dim.to_string()
  let sb = StringBuilder::new()
  sb.write_string("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ")
  sb.write_string(dim_s)
  sb.write_string(" ")
  sb.write_string(dim_s)
  sb.write_string("\" shape-rendering=\"crispEdges\">")
  sb.write_string("<rect width=\"100%\" height=\"100%\" fill=\"")
  sb.write_string(light_color)
  sb.write_string("\"/>")

  let scale_s = sc64.to_string()
  if compact_path {
    sb.write_string("<path d=\"")
    let mut y = 0
    while y < qr.size {
      let py = (y.to_int64() + qz64) * sc64
      let py_s = py.to_string()
      let row_off = y * qr.size
      let mut x = 0
      while x < qr.size {
        if qr.modules[row_off + x] != (0).to_byte() {
          let run_start = x
          x = x + 1
          while x < qr.size && qr.modules[row_off + x] != (0).to_byte() {
            x = x + 1
          }
          let px = (run_start.to_int64() + qz64) * sc64
          let rw = (x - run_start).to_int64() * sc64
          let rw_s = rw.to_string()
          sb.write_string("M")
          sb.write_string(px.to_string())
          sb.write_string(",")
          sb.write_string(py_s)
          sb.write_string("h")
          sb.write_string(rw_s)
          sb.write_string("v")
          sb.write_string(scale_s)
          sb.write_string("h-")
          sb.write_string(rw_s)
          sb.write_string("z")
        } else {
          x = x + 1
        }
      }
      y = y + 1
    }
    sb.write_string("\" fill=\"")
    sb.write_string(dark_color)
    sb.write_string("\"/>")
  } else {
    let mut y = 0
    while y < qr.size {
      let py_s = ((y.to_int64() + qz64) * sc64).to_string()
      let row_off = y * qr.size
      let mut x = 0
      while x < qr.size {
        if qr.modules[row_off + x] != (0).to_byte() {
          sb.write_string("<rect x=\"")
          sb.write_string(((x.to_int64() + qz64) * sc64).to_string())
          sb.write_string("\" y=\"")
          sb.write_string(py_s)
          sb.write_string("\" width=\"")
          sb.write_string(scale_s)
          sb.write_string("\" height=\"")
          sb.write_string(scale_s)
          sb.write_string("\" fill=\"")
          sb.write_string(dark_color)
          sb.write_string("\"/>")
        }
        x = x + 1
      }
      y = y + 1
    }
  }

  sb.write_string("</svg>")
  Result::Ok(sb.to_string())
}

///| Render a QR Code to SVG with strict validation of colors and dimensions.
pub fn render_svg_checked(qr : QrCode, opts : SvgOptions) -> Result[String, QrError] {
  if opts.quiet_zone < 0 {
    return Result::Err(QrError::InvalidRenderOption("negative quiet_zone"))
  }
  if opts.module_size <= 0 {
    return Result::Err(QrError::InvalidRenderOption("non-positive module_size"))
  }
  if !is_safe_svg_color(opts.dark_color) {
    return Result::Err(QrError::InvalidRenderOption("invalid SVG dark_color"))
  }
  if !is_safe_svg_color(opts.light_color) {
    return Result::Err(QrError::InvalidRenderOption("invalid SVG light_color"))
  }
  render_svg_inner(qr, opts.quiet_zone, opts.module_size, opts.dark_color, opts.light_color, opts.compact_path)
}

///| Render a QR Code to SVG (compact merged `<path>` or `<rect>`).
///| Invalid colors safely fall back to `#000000`/`#ffffff`; 64-bit arithmetic avoids viewBox overflow.
pub fn render_svg(qr : QrCode, opts : SvgOptions) -> String {
  let qz = if opts.quiet_zone < 0 { 0 } else { opts.quiet_zone }
  let scale = if opts.module_size <= 0 { 1 } else { opts.module_size }
  let dark = sanitize_svg_color(opts.dark_color, "#000000")
  let light = sanitize_svg_color(opts.light_color, "#ffffff")
  match render_svg_inner(qr, qz, scale, dark, light, opts.compact_path) {
    Result::Ok(s) => s
    Result::Err(_) => ""
  }
}

///| Helper: read dark state at `(x, y)` in padded coordinates (including quiet zone).
fn padded_dark(qr : QrCode, qz : Int, x : Int, y : Int, invert : Bool) -> Bool {
  let mx = x - qz
  let my = y - qz
  let d = if mx >= 0 && my >= 0 && mx < qr.size && my < qr.size {
    qr.modules[my * qr.size + mx] != (0).to_byte()
  } else {
    false
  }
  if invert { !d } else { d }
}

///| Render a QR Code to UTF-8 terminal half-block characters with dimension bounds check.
pub fn render_terminal_checked(qr : QrCode, quiet_zone : Int, invert : Bool) -> Result[String, QrError] {
  if quiet_zone < 0 {
    return Result::Err(QrError::InvalidRenderOption("negative quiet_zone"))
  }
  let total64 = qr.size.to_int64() + quiet_zone.to_int64() * 2L
  if total64 <= 0L || total64 > max_text_dim {
    return Result::Err(QrError::InvalidRenderOption("terminal render dimensions exceed limit"))
  }
  let total = total64.to_int()
  let sb = StringBuilder::new()
  let mut y = 0
  while y < total {
    let mut x = 0
    while x < total {
      let top = padded_dark(qr, quiet_zone, x, y, invert)
      let bot = if y + 1 < total {
        padded_dark(qr, quiet_zone, x, y + 1, invert)
      } else {
        invert
      }
      if top && bot {
        sb.write_string("█")
      } else if top {
        sb.write_string("▀")
      } else if bot {
        sb.write_string("▄")
      } else {
        sb.write_string(" ")
      }
      x = x + 1
    }
    sb.write_string("\n")
    y = y + 2
  }
  Result::Ok(sb.to_string())
}

///| Render a QR Code to UTF-8 terminal half-block characters (`▀`, `▄`, `█`, ` `).
pub fn render_terminal(qr : QrCode, quiet_zone : Int, invert : Bool) -> String {
  let qz = if quiet_zone < 0 { 0 } else { quiet_zone }
  match render_terminal_checked(qr, qz, invert) {
    Result::Ok(s) => s
    Result::Err(_) => ""
  }
}

///| Render a QR Code to plain ASCII with dimension bounds check.
pub fn render_ascii_checked(qr : QrCode, quiet_zone : Int) -> Result[String, QrError] {
  if quiet_zone < 0 {
    return Result::Err(QrError::InvalidRenderOption("negative quiet_zone"))
  }
  let total64 = qr.size.to_int64() + quiet_zone.to_int64() * 2L
  if total64 <= 0L || total64 > max_text_dim {
    return Result::Err(QrError::InvalidRenderOption("ASCII render dimensions exceed limit"))
  }
  let total = total64.to_int()
  let sb = StringBuilder::new()
  let mut y = 0
  while y < total {
    let mut x = 0
    while x < total {
      if padded_dark(qr, quiet_zone, x, y, false) {
        sb.write_string("##")
      } else {
        sb.write_string("  ")
      }
      x = x + 1
    }
    sb.write_string("\n")
    y = y + 1
  }
  Result::Ok(sb.to_string())
}

///| Render a QR Code to plain ASCII (`##` for dark, `  ` for light).
pub fn render_ascii(qr : QrCode, quiet_zone : Int) -> String {
  let qz = if quiet_zone < 0 { 0 } else { quiet_zone }
  match render_ascii_checked(qr, qz) {
    Result::Ok(s) => s
    Result::Err(_) => ""
  }
}

///| Render a QR Code to binary P5 PGM (8-bit grayscale) with 64-bit overflow & memory cap check.
pub fn render_pgm_checked(qr : QrCode, quiet_zone : Int, scale : Int) -> Result[Bytes, QrError] {
  if quiet_zone < 0 {
    return Result::Err(QrError::InvalidRenderOption("negative quiet_zone"))
  }
  if scale <= 0 {
    return Result::Err(QrError::InvalidRenderOption("non-positive scale"))
  }
  let total_mod64 = qr.size.to_int64() + quiet_zone.to_int64() * 2L
  let sc64 = scale.to_int64()
  if total_mod64 <= 0L || total_mod64 > max_pgm_dim || sc64 > max_pgm_dim / total_mod64 {
    return Result::Err(QrError::InvalidRenderOption("PGM dimensions exceed 256 MiB limit"))
  }
  let total_mod = total_mod64.to_int()
  let dim64 = total_mod64 * sc64
  let dim = dim64.to_int()
  let dim_s = dim.to_string()
  let header = ("P5\n" + dim_s + " " + dim_s + "\n255\n").to_bytes()
  let hlen = header.length()
  let total_bytes64 = hlen.to_int64() + dim64 * dim64
  if total_bytes64 > max_raster_bytes {
    return Result::Err(QrError::InvalidRenderOption("PGM buffer exceeds 256 MiB limit"))
  }
  let mut out = Bytes::new(total_bytes64.to_int())
  let mut hi = 0
  while hi < hlen {
    out[hi] = header[hi]
    hi = hi + 1
  }
  let mut my = 0
  while my < total_mod {
    let mut mx = 0
    while mx < total_mod {
      let pix = if padded_dark(qr, quiet_zone, mx, my, false) {
        (0).to_byte()
      } else {
        (255).to_byte()
      }
      let mut sy = 0
      while sy < scale {
        let row_off = hlen + (my * scale + sy) * dim + mx * scale
        let mut sx = 0
        while sx < scale {
          out[row_off + sx] = pix
          sx = sx + 1
        }
        sy = sy + 1
      }
      mx = mx + 1
    }
    my = my + 1
  }
  Result::Ok(out)
}

///| Render a QR Code to binary P5 PGM (8-bit grayscale: 0 = dark, 255 = light).
///| Returns empty `Bytes` if the requested dimensions overflow or exceed the 256 MiB safety cap.
pub fn render_pgm(qr : QrCode, quiet_zone : Int, scale : Int) -> Bytes {
  let qz = if quiet_zone < 0 { 0 } else { quiet_zone }
  let sc = if scale <= 0 { 1 } else { scale }
  match render_pgm_checked(qr, qz, sc) {
    Result::Ok(b) => b
    Result::Err(_) => Bytes::new(0)
  }
}

///| Render a QR Code to 32-bit RGBA pixel buffer with 64-bit overflow & memory cap check.
pub fn render_rgba_checked(
  qr : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Result[Bytes, QrError] {
  if quiet_zone < 0 {
    return Result::Err(QrError::InvalidRenderOption("negative quiet_zone"))
  }
  if scale <= 0 {
    return Result::Err(QrError::InvalidRenderOption("non-positive scale"))
  }
  let total_mod64 = qr.size.to_int64() + quiet_zone.to_int64() * 2L
  let sc64 = scale.to_int64()
  if total_mod64 <= 0L || total_mod64 > max_rgba_dim || sc64 > max_rgba_dim / total_mod64 {
    return Result::Err(QrError::InvalidRenderOption("RGBA dimensions exceed 256 MiB limit"))
  }
  let total_mod = total_mod64.to_int()
  let dim64 = total_mod64 * sc64
  let dim = dim64.to_int()
  let total_bytes64 = dim64 * dim64 * 4L
  if total_bytes64 > max_raster_bytes {
    return Result::Err(QrError::InvalidRenderOption("RGBA buffer exceeds 256 MiB limit"))
  }
  let dr = ((dark_rgba >> 24) & 0xFFU).to_int().to_byte()
  let dg = ((dark_rgba >> 16) & 0xFFU).to_int().to_byte()
  let db = ((dark_rgba >> 8) & 0xFFU).to_int().to_byte()
  let da = (dark_rgba & 0xFFU).to_int().to_byte()
  let lr = ((light_rgba >> 24) & 0xFFU).to_int().to_byte()
  let lg = ((light_rgba >> 16) & 0xFFU).to_int().to_byte()
  let lb = ((light_rgba >> 8) & 0xFFU).to_int().to_byte()
  let la = (light_rgba & 0xFFU).to_int().to_byte()

  let mut out = Bytes::new(total_bytes64.to_int())
  let mut my = 0
  while my < total_mod {
    let mut mx = 0
    while mx < total_mod {
      let dark = padded_dark(qr, quiet_zone, mx, my, false)
      let r = if dark { dr } else { lr }
      let g = if dark { dg } else { lg }
      let b = if dark { db } else { lb }
      let a = if dark { da } else { la }
      let mut sy = 0
      while sy < scale {
        let row_base = ((my * scale + sy) * dim + mx * scale) * 4
        let mut sx = 0
        while sx < scale {
          let off = row_base + sx * 4
          out[off] = r
          out[off + 1] = g
          out[off + 2] = b
          out[off + 3] = a
          sx = sx + 1
        }
        sy = sy + 1
      }
      mx = mx + 1
    }
    my = my + 1
  }
  Result::Ok(out)
}

///| Render a QR Code to 32-bit RGBA pixel buffer (`dark_rgba`/`light_rgba` as 0xRRGGBBAA).
///| Returns empty `Bytes` if the requested dimensions overflow or exceed the 256 MiB safety cap.
pub fn render_rgba(
  qr : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Bytes {
  let qz = if quiet_zone < 0 { 0 } else { quiet_zone }
  let sc = if scale <= 0 { 1 } else { scale }
  match render_rgba_checked(qr, qz, sc, dark_rgba, light_rgba) {
    Result::Ok(b) => b
    Result::Err(_) => Bytes::new(0)
  }
}

///| Convenience method: render SVG with `opts`.
pub fn QrCode::to_svg(self : QrCode, opts : SvgOptions) -> String {
  render_svg(self, opts)
}

///| Convenience method: render SVG with strict option validation.
pub fn QrCode::to_svg_checked(self : QrCode, opts : SvgOptions) -> Result[String, QrError] {
  render_svg_checked(self, opts)
}

///| Convenience method: render SVG with default options.
pub fn QrCode::to_svg_default(self : QrCode) -> String {
  render_svg(self, SvgOptions::default())
}

///| Convenience method: render UTF-8 terminal half-blocks.
pub fn QrCode::to_terminal(self : QrCode, quiet_zone : Int, invert : Bool) -> String {
  render_terminal(self, quiet_zone, invert)
}

///| Convenience method: render UTF-8 terminal half-blocks with bounds validation.
pub fn QrCode::to_terminal_checked(self : QrCode, quiet_zone : Int, invert : Bool) -> Result[String, QrError] {
  render_terminal_checked(self, quiet_zone, invert)
}

///| Convenience method: render ASCII.
pub fn QrCode::to_ascii(self : QrCode, quiet_zone : Int) -> String {
  render_ascii(self, quiet_zone)
}

///| Convenience method: render ASCII with bounds validation.
pub fn QrCode::to_ascii_checked(self : QrCode, quiet_zone : Int) -> Result[String, QrError] {
  render_ascii_checked(self, quiet_zone)
}

///| Convenience method: render P5 PGM.
pub fn QrCode::to_pgm(self : QrCode, quiet_zone : Int, scale : Int) -> Bytes {
  render_pgm(self, quiet_zone, scale)
}

///| Convenience method: render P5 PGM with overflow/memory cap validation.
pub fn QrCode::to_pgm_checked(self : QrCode, quiet_zone : Int, scale : Int) -> Result[Bytes, QrError] {
  render_pgm_checked(self, quiet_zone, scale)
}

///| Convenience method: render 32-bit RGBA.
pub fn QrCode::to_rgba(
  self : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Bytes {
  render_rgba(self, quiet_zone, scale, dark_rgba, light_rgba)
}

///| Convenience method: render 32-bit RGBA with overflow/memory cap validation.
pub fn QrCode::to_rgba_checked(
  self : QrCode,
  quiet_zone : Int,
  scale : Int,
  dark_rgba : UInt,
  light_rgba : UInt,
) -> Result[Bytes, QrError] {
  render_rgba_checked(self, quiet_zone, scale, dark_rgba, light_rgba)
}
