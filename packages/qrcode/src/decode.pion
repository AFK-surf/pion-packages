///| Pure Pion QR Code matrix decoder with rotation detection, Format/Version BCH
///| error correction, Reed-Solomon Berlekamp-Massey + Chien + Forney decoding,
///| and Numeric/Alphanumeric/Byte/Kanji/ECI bitstream reconstruction.

///| Decode a raw `size * size` module matrix (`1` = dark, `0` = light).
pub fn decode_matrix(modules : FixedArray[Byte], size : Int) -> Result[DecodedQr, QrError] {
  let _ = modules
  let _ = size
  Result::Err(QrError::FormatDecodeError("not implemented"))
}

///| Decode an encoded `QrCode` back into its payload and metadata.
pub fn decode(qr : QrCode) -> Result[DecodedQr, QrError] {
  decode_matrix(qr.modules, qr.size)
}
