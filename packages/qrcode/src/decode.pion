///| Pure Pion QR Code matrix decoder with automatic 0/90/180/270-degree rotation detection,
///| Format BCH(15,5) & Version BCH(18,6) Hamming-distance error correction,
///| Reed-Solomon Berlekamp-Massey + Chien + Forney decoding,
///| and Numeric/Alphanumeric/Byte/Kanji/ECI bitstream reconstruction.

///| Count set bits in `x`.
fn dec_popcount(x_in : Int) -> Int {
  let mut x = x_in
  let mut c = 0
  while x != 0 {
    c = c + (x & 1)
    x = x >> 1
  }
  c
}

///| Score how closely a 7x7 corner matches a QR finder pattern (max 49).
fn finder_score(modules : FixedArray[Byte], size : Int, ox : Int, oy : Int) -> Int {
  let mut score = 0
  let mut dy = 0
  while dy < 7 {
    let mut dx = 0
    while dx < 7 {
      let cx = dx - 3
      let cy = dy - 3
      let adx = if cx < 0 { -cx } else { cx }
      let ady = if cy < 0 { -cy } else { cy }
      let dist = if adx > ady { adx } else { ady }
      let expect = if dist != 2 { 1 } else { 0 }
      let actual = modules[(oy + dy) * size + (ox + dx)].to_int() & 1
      if actual == expect {
        score = score + 1
      }
      dx = dx + 1
    }
    dy = dy + 1
  }
  score
}

///| Rotate matrix counter-clockwise `rot` times (0, 1, 2, or 3) so finders are at TL, TR, BL.
fn orient_matrix(modules : FixedArray[Byte], size : Int, rot_cw_needed : Int) -> FixedArray[Byte] {
  if rot_cw_needed == 0 {
    return modules
  }
  let out : FixedArray[Byte] = FixedArray::make(size * size, (0).to_byte())
  let mut y = 0
  while y < size {
    let mut x = 0
    while x < size {
      let v = modules[y * size + x]
      let (nx, ny) = if rot_cw_needed == 1 {
        (size - 1 - y, x)
      } else if rot_cw_needed == 2 {
        (size - 1 - x, size - 1 - y)
      } else {
        (y, size - 1 - x)
      }
      out[ny * size + nx] = v
      x = x + 1
    }
    y = y + 1
  }
  out
}

///| Detect orientation from the 4 corners' finder pattern scores.
///| Returns number of 90-degree CW rotations needed to bring finders to TL, TR, BL.
fn detect_rotation(modules : FixedArray[Byte], size : Int) -> Int {
  let tl = finder_score(modules, size, 0, 0)
  let tr = finder_score(modules, size, size - 7, 0)
  let bl = finder_score(modules, size, 0, size - 7)
  let br = finder_score(modules, size, size - 7, size - 7)
  // Missing finder is at BR (0 CW), TR (1 CW -> BR), TL (2 CW -> BR), BL (3 CW -> BR)
  let mut min_s = br
  let mut rot = 0
  if tr < min_s {
    min_s = tr
    rot = 1
  }
  if tl < min_s {
    min_s = tl
    rot = 2
  }
  if bl < min_s {
    rot = 3
  }
  rot
}

///| Read the two 15-bit format information copies and decode `(ec, mask)` via BCH(15,5)
///| minimum Hamming distance (up to 3 bit errors).
fn read_format_info(modules : FixedArray[Byte], size : Int) -> Result[(EcLevel, Int), QrError] {
  // Copy 1 around TL finder
  let mut bits1 = 0
  let mut i = 0
  while i <= 5 {
    bits1 = bits1 | ((modules[i * size + 8].to_int() & 1) << i)
    i = i + 1
  }
  bits1 = bits1 | ((modules[7 * size + 8].to_int() & 1) << 6)
  bits1 = bits1 | ((modules[8 * size + 8].to_int() & 1) << 7)
  bits1 = bits1 | ((modules[8 * size + 7].to_int() & 1) << 8)
  let mut j = 9
  while j < 15 {
    bits1 = bits1 | ((modules[8 * size + (14 - j)].to_int() & 1) << j)
    j = j + 1
  }

  // Copy 2 around TR and BL finders
  let mut bits2 = 0
  let mut k = 0
  while k < 8 {
    bits2 = bits2 | ((modules[8 * size + (size - 1 - k)].to_int() & 1) << k)
    k = k + 1
  }
  let mut m = 8
  while m < 15 {
    bits2 = bits2 | ((modules[(size - 15 + m) * size + 8].to_int() & 1) << m)
    m = m + 1
  }

  let levels = [EcLevel::L, EcLevel::M, EcLevel::Q, EcLevel::H]
  let mut best_dist = 99
  let mut best_ec = EcLevel::M
  let mut best_mask = 0
  let mut li = 0
  while li < 4 {
    let ec = levels[li]
    let mut mask = 0
    while mask < 8 {
      let target = format_info_bits(ec, mask)
      let d1 = dec_popcount(bits1 ^ target)
      let d2 = dec_popcount(bits2 ^ target)
      let d = if d1 < d2 { d1 } else { d2 }
      if d < best_dist {
        best_dist = d
        best_ec = ec
        best_mask = mask
      }
      mask = mask + 1
    }
    li = li + 1
  }

  if best_dist > 3 {
    return Result::Err(QrError::FormatDecodeError("format BCH Hamming distance > 3"))
  }
  Result::Ok((best_ec, best_mask))
}

///| Verify version info BCH(18,6) for v7..v40 (allows up to 3 bit errors in either copy).
fn verify_version_info(modules : FixedArray[Byte], size : Int, geom_version : Int) -> Result[Int, QrError] {
  if geom_version < 7 {
    return Result::Ok(geom_version)
  }
  let mut bits1 = 0
  let mut bits2 = 0
  let mut i = 0
  while i < 18 {
    let a = size - 11 + (i % 3)
    let b = i / 3
    bits1 = bits1 | ((modules[b * size + a].to_int() & 1) << i)
    bits2 = bits2 | ((modules[a * size + b].to_int() & 1) << i)
    i = i + 1
  }
  let mut best_dist = 99
  let mut best_v = geom_version
  let mut v = 7
  while v <= 40 {
    let target = version_info_bits(v)
    let d1 = dec_popcount(bits1 ^ target)
    let d2 = dec_popcount(bits2 ^ target)
    let d = if d1 < d2 { d1 } else { d2 }
    if d < best_dist {
      best_dist = d
      best_v = v
    }
    v = v + 1
  }
  if best_dist <= 3 && best_v != geom_version {
    return Result::Err(QrError::VersionDecodeError("version info does not match matrix size"))
  }
  Result::Ok(geom_version)
}

///| Read raw unmasked interleaved codewords from `modules` in ISO/IEC 18004 zigzag order.
fn read_raw_codewords(
  modules : FixedArray[Byte],
  version : Int,
  ec : EcLevel,
  mask : Int,
) -> FixedArray[Byte] {
  let size = version_size(version)
  let dummy : FixedArray[Byte] = FixedArray::make(size * size, (0).to_byte())
  let is_func : FixedArray[Byte] = FixedArray::make(size * size, (0).to_byte())
  draw_function_patterns(dummy, is_func, version, ec)

  let tot_cw = total_codewords(version)
  let cw : FixedArray[Byte] = FixedArray::make(tot_cw, (0).to_byte())
  let total_bits = tot_cw * 8
  let mut bit_idx = 0
  let mut right = size - 1
  while right >= 1 {
    if right == 6 {
      right = 5
    }
    let upward = ((right + 1) & 2) == 0
    let mut vert = 0
    while vert < size {
      let y = if upward { size - 1 - vert } else { vert }
      let row_off = y * size
      let idx0 = row_off + right
      if is_func[idx0] == (0).to_byte() {
        if bit_idx < total_bits {
          let raw_bit = modules[idx0].to_int() & 1
          let m_bit = if apply_mask_condition(mask, right, y) { 1 } else { 0 }
          if (raw_bit ^ m_bit) != 0 {
            let b_idx = bit_idx >> 3
            let shift = 7 - (bit_idx & 7)
            cw[b_idx] = ((cw[b_idx].to_int() & 0xFF) | (1 << shift)).to_byte()
          }
        }
        bit_idx = bit_idx + 1
      }
      let x1 = right - 1
      let idx1 = row_off + x1
      if is_func[idx1] == (0).to_byte() {
        if bit_idx < total_bits {
          let raw_bit = modules[idx1].to_int() & 1
          let m_bit = if apply_mask_condition(mask, x1, y) { 1 } else { 0 }
          if (raw_bit ^ m_bit) != 0 {
            let b_idx = bit_idx >> 3
            let shift = 7 - (bit_idx & 7)
            cw[b_idx] = ((cw[b_idx].to_int() & 0xFF) | (1 << shift)).to_byte()
          }
        }
        bit_idx = bit_idx + 1
      }
      vert = vert + 1
    }
    right = right - 2
  }
  cw
}

///| De-interleave raw codewords into blocks, run Reed-Solomon decoding on each block,
///| and concatenate the corrected data codewords.
fn deinterleave_and_correct(
  raw_cw : FixedArray[Byte],
  version : Int,
  ec : EcLevel,
) -> Result[(FixedArray[Byte], Int), QrError] {
  let tot_cw = total_codewords(version)
  let nb = num_blocks(version, ec)
  let ecpb = ec_codewords_per_block(version, ec)
  let data_len = data_codewords(version, ec)
  let num_short = nb - (tot_cw % nb)
  let short_total = tot_cw / nb
  let short_data = short_total - ecpb
  let long_data = short_data + 1

  let out_data : FixedArray[Byte] = FixedArray::make(data_len, (0).to_byte())
  let mut total_fixed = 0
  let mut out_off = 0
  let mut b = 0
  while b < nb {
    let blen = if b < num_short { short_data } else { long_data }
    let block : FixedArray[Byte] = FixedArray::make(blen + ecpb, (0).to_byte())
    // Gather interleaved data bytes for block b
    let mut j = 0
    while j < short_data {
      block[j] = raw_cw[j * nb + b]
      j = j + 1
    }
    if blen > short_data {
      block[short_data] = raw_cw[short_data * nb + (b - num_short)]
    }
    // Gather interleaved EC bytes for block b
    let mut k = 0
    while k < ecpb {
      block[blen + k] = raw_cw[data_len + k * nb + b]
      k = k + 1
    }
    // Reed-Solomon decode in-place
    let fixed = match rs_decode_block(block, ecpb) {
      Result::Ok(f) => f
      Result::Err(e) => return Result::Err(e)
    }
    total_fixed = total_fixed + fixed
    // Copy corrected data bytes
    let mut d = 0
    while d < blen {
      out_data[out_off + d] = block[d]
      d = d + 1
    }
    out_off = out_off + blen
    b = b + 1
  }
  Result::Ok((out_data, total_fixed))
}

///| Read `nbits` MSB-first from `data` at bit offset `pos`.
fn read_bits(data : FixedArray[Byte], pos : Int, nbits : Int) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < nbits {
    let p = pos + i
    let bit = ((data[p >> 3].to_int() & 0xFF) >> (7 - (p & 7))) & 1
    acc = (acc << 1) | bit
    i = i + 1
  }
  acc
}

///| Parse ISO/IEC 18004 data bitstream into segments, raw bytes, and ECI designator.
fn parse_data_bitstream(
  data : FixedArray[Byte],
  version : Int,
) -> Result[(Array[Segment], Bytes, Int), QrError] {
  let alnum_chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"
  let total_bits = data.length() * 8
  let mut pos = 0
  let segments : Array[Segment] = []
  let all_bytes : Array[Byte] = []
  let mut last_eci = -1

  while pos + 4 <= total_bits {
    let mode_ind = read_bits(data, pos, 4)
    pos = pos + 4
    if mode_ind == 0 {
      // Terminator 0000
      break
    } else if mode_ind == 7 {
      // ECI mode
      if pos + 8 > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated ECI header"))
      }
      let b0 = read_bits(data, pos, 8)
      pos = pos + 8
      let eci = if (b0 & 0x80) == 0 {
        b0
      } else if (b0 & 0xC0) == 0x80 {
        if pos + 8 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated 2-byte ECI"))
        }
        let b1 = read_bits(data, pos, 8)
        pos = pos + 8
        ((b0 & 0x3F) << 8) | b1
      } else if (b0 & 0xE0) == 0xC0 {
        if pos + 16 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated 3-byte ECI"))
        }
        let b12 = read_bits(data, pos, 16)
        pos = pos + 16
        ((b0 & 0x1F) << 16) | b12
      } else {
        return Result::Err(QrError::InvalidDataStream("invalid ECI prefix"))
      }
      last_eci = eci
      segments.push(Segment::eci(eci))
    } else if mode_ind == 1 {
      // Numeric
      let ccb = char_count_bits(version, Mode::Numeric)
      if pos + ccb > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Numeric count"))
      }
      let count = read_bits(data, pos, ccb)
      pos = pos + ccb
      let mut seg_b = Bytes::new(count)
      let mut out_i = 0
      let mut rem = count
      while rem >= 3 {
        if pos + 10 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated Numeric triplet"))
        }
        let v = read_bits(data, pos, 10)
        pos = pos + 10
        if v >= 1000 {
          return Result::Err(QrError::InvalidDataStream("Numeric triplet >= 1000"))
        }
        let d0 = (48 + v / 100).to_byte()
        let d1 = (48 + (v / 10) % 10).to_byte()
        let d2 = (48 + v % 10).to_byte()
        seg_b[out_i] = d0
        seg_b[out_i + 1] = d1
        seg_b[out_i + 2] = d2
        all_bytes.push(d0)
        all_bytes.push(d1)
        all_bytes.push(d2)
        out_i = out_i + 3
        rem = rem - 3
      }
      if rem == 2 {
        if pos + 7 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated Numeric pair"))
        }
        let v = read_bits(data, pos, 7)
        pos = pos + 7
        if v >= 100 {
          return Result::Err(QrError::InvalidDataStream("Numeric pair >= 100"))
        }
        let d0 = (48 + v / 10).to_byte()
        let d1 = (48 + v % 10).to_byte()
        seg_b[out_i] = d0
        seg_b[out_i + 1] = d1
        all_bytes.push(d0)
        all_bytes.push(d1)
      } else if rem == 1 {
        if pos + 4 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated Numeric digit"))
        }
        let v = read_bits(data, pos, 4)
        pos = pos + 4
        if v >= 10 {
          return Result::Err(QrError::InvalidDataStream("Numeric digit >= 10"))
        }
        let d0 = (48 + v).to_byte()
        seg_b[out_i] = d0
        all_bytes.push(d0)
      }
      segments.push(Segment::{ mode: Mode::Numeric, data: seg_b, eci_designator: -1 })
    } else if mode_ind == 2 {
      // Alphanumeric
      let ccb = char_count_bits(version, Mode::Alphanumeric)
      if pos + ccb > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Alphanumeric count"))
      }
      let count = read_bits(data, pos, ccb)
      pos = pos + ccb
      let mut seg_b = Bytes::new(count)
      let mut out_i = 0
      let mut rem = count
      while rem >= 2 {
        if pos + 11 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated Alphanumeric pair"))
        }
        let v = read_bits(data, pos, 11)
        pos = pos + 11
        let c0 = v / 45
        let c1 = v % 45
        if c0 >= 45 {
          return Result::Err(QrError::InvalidDataStream("Alphanumeric pair out of range"))
        }
        let b0 = alnum_chars.code_unit_at(c0).to_byte()
        let b1 = alnum_chars.code_unit_at(c1).to_byte()
        seg_b[out_i] = b0
        seg_b[out_i + 1] = b1
        all_bytes.push(b0)
        all_bytes.push(b1)
        out_i = out_i + 2
        rem = rem - 2
      }
      if rem == 1 {
        if pos + 6 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated Alphanumeric char"))
        }
        let v = read_bits(data, pos, 6)
        pos = pos + 6
        if v >= 45 {
          return Result::Err(QrError::InvalidDataStream("Alphanumeric char >= 45"))
        }
        let b0 = alnum_chars.code_unit_at(v).to_byte()
        seg_b[out_i] = b0
        all_bytes.push(b0)
      }
      segments.push(Segment::{ mode: Mode::Alphanumeric, data: seg_b, eci_designator: -1 })
    } else if mode_ind == 4 {
      // Byte
      let ccb = char_count_bits(version, Mode::Byte)
      if pos + ccb > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Byte count"))
      }
      let count = read_bits(data, pos, ccb)
      pos = pos + ccb
      if pos + count * 8 > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Byte payload"))
      }
      let mut seg_b = Bytes::new(count)
      let mut i = 0
      while i < count {
        let bv = read_bits(data, pos, 8).to_byte()
        pos = pos + 8
        seg_b[i] = bv
        all_bytes.push(bv)
        i = i + 1
      }
      segments.push(Segment::{ mode: Mode::Byte, data: seg_b, eci_designator: -1 })
    } else if mode_ind == 8 {
      // Kanji (Shift-JIS double-byte pairs)
      let ccb = char_count_bits(version, Mode::Kanji)
      if pos + ccb > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Kanji count"))
      }
      let count = read_bits(data, pos, ccb)
      pos = pos + ccb
      if pos + count * 13 > total_bits {
        return Result::Err(QrError::InvalidDataStream("truncated Kanji payload"))
      }
      let mut seg_b = Bytes::new(count * 2)
      let mut i = 0
      while i < count {
        let kv = read_bits(data, pos, 13)
        pos = pos + 13
        let w = kanji_from_value(kv)
        let b0 = ((w >> 8) & 0xFF).to_byte()
        let b1 = (w & 0xFF).to_byte()
        seg_b[i * 2] = b0
        seg_b[i * 2 + 1] = b1
        all_bytes.push(b0)
        all_bytes.push(b1)
        i = i + 1
      }
      segments.push(Segment::{ mode: Mode::Kanji, data: seg_b, eci_designator: -1 })
    } else if mode_ind == 5 || mode_ind == 9 {
      // FNC1 first/second position: skip indicator (second position has 8-bit app indicator)
      if mode_ind == 9 {
        if pos + 8 > total_bits {
          return Result::Err(QrError::InvalidDataStream("truncated FNC1-2nd"))
        }
        pos = pos + 8
      }
    } else {
      return Result::Err(QrError::UnsupportedMode(mode_ind))
    }
  }

  let mut raw_out = Bytes::new(all_bytes.length())
  let mut i = 0
  while i < all_bytes.length() {
    raw_out[i] = all_bytes[i]
    i = i + 1
  }
  Result::Ok((segments, raw_out, last_eci))
}

///| Decode a raw `size * size` module matrix (`1` = dark, `0` = light).
pub fn decode_matrix(modules : FixedArray[Byte], size : Int) -> Result[DecodedQr, QrError] {
  if size < 21 || size > 177 || (size - 17) % 4 != 0 || modules.length() != size * size {
    return Result::Err(QrError::InvalidMatrixSize(size))
  }
  let version = (size - 17) / 4
  let rot = detect_rotation(modules, size)
  let oriented = orient_matrix(modules, size, rot)

  let (ec, mask) = match read_format_info(oriented, size) {
    Result::Ok(fm) => fm
    Result::Err(e) => return Result::Err(e)
  }
  match verify_version_info(oriented, size, version) {
    Result::Ok(_) => ()
    Result::Err(e) => return Result::Err(e)
  }

  let raw_cw = read_raw_codewords(oriented, version, ec, mask)
  let (data_cw, fixed) = match deinterleave_and_correct(raw_cw, version, ec) {
    Result::Ok(r) => r
    Result::Err(e) => return Result::Err(e)
  }
  let (segments, raw_bytes, eci) = match parse_data_bitstream(data_cw, version) {
    Result::Ok(p) => p
    Result::Err(e) => return Result::Err(e)
  }

  Result::Ok(DecodedQr::{
    version: version,
    ec_level: ec,
    mask: mask,
    eci: eci,
    bytes: raw_bytes,
    text: raw_bytes.to_string(),
    segments: segments,
    errors_corrected: fixed,
  })
}

///| Decode an encoded `QrCode` back into its payload and metadata.
pub fn decode(qr : QrCode) -> Result[DecodedQr, QrError] {
  decode_matrix(qr.modules, qr.size)
}
