///| RT-qrcode oracle: drives `packages/qrcode` over TSV corpora so the Python driver can diff it
///| against Nayuki `qrcodegen` / `rqrr` (audit/diff/rust). Same binary is built native debug/release
///| and wasm32 debug/release for the 4-mode check.
///|
///|   oracle enc  <corpus.tsv>   id ec minv maxv mask kind hex -> id OK v ec mask bits | id ERR msg
///|   oracle dec  <matrices.tsv> id size bits                  -> id OK v ec mask fixed hex | id ERR msg
///|   oracle seg  <seg.tsv>      id version hex               -> id bits modes
///|   oracle tables                                           -> per (v,ec) tables + BCH words
///|   oracle render <what> <n>                                -> render probe (may trap: evidence)
///|   oracle bench <w1|w2|real|dp> [n]                        -> fairness benchmark workloads

import "qrcode"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int() & 0xFF
    sb.write_byte(digits.code_unit_at(v >> 4).to_byte())
    sb.write_byte(digits.code_unit_at(v & 15).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn parse_int(s : String) -> Int {
  let mut neg = false
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 {
      neg = true
    } else if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///| Split `buf` into lines, each split on TAB.
fn read_rows(world : World, path : String) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read " + path)
      return out
    }
  }
  let n = buf.length()
  let mut row : Array[String] = []
  let mut cell = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = buf[i].to_int() & 0xFF
    if c == 10 {
      row.push(cell.to_string())
      out.push(row)
      row = []
      cell = StringBuilder::new()
    } else if c == 9 {
      row.push(cell.to_string())
      cell = StringBuilder::new()
    } else if c != 13 {
      cell.write_byte(c.to_byte())
    }
    i = i + 1
  }
  out
}

///|
fn ec_of(s : String) -> qrcode::EcLevel {
  if s == "L" {
    qrcode::EcLevel::L
  } else if s == "Q" {
    qrcode::EcLevel::Q
  } else if s == "H" {
    qrcode::EcLevel::H
  } else {
    qrcode::EcLevel::M
  }
}

///|
fn err_name(e : qrcode::QrError) -> String {
  match e {
    qrcode::QrError::DataTooLong(_) => "DataTooLong"
    qrcode::QrError::InvalidVersion(_) => "InvalidVersion"
    qrcode::QrError::InvalidMask(_) => "InvalidMask"
    qrcode::QrError::InvalidCharacter(_) => "InvalidCharacter"
    qrcode::QrError::InvalidEci(_) => "InvalidEci"
    qrcode::QrError::InvalidMatrixSize(_) => "InvalidMatrixSize"
    qrcode::QrError::FormatDecodeError(_) => "FormatDecodeError"
    qrcode::QrError::VersionDecodeError(_) => "VersionDecodeError"
    qrcode::QrError::ReedSolomonError(_) => "ReedSolomonError"
    qrcode::QrError::InvalidDataStream(_) => "InvalidDataStream"
    qrcode::QrError::UnsupportedMode(_) => "UnsupportedMode"
    qrcode::QrError::InvalidRenderOption(_) => "InvalidRenderOption"
  }
}

///|
fn bits_of(qr : qrcode::QrCode) -> String {
  let sb = StringBuilder::new()
  let n = qr.size * qr.size
  let mut i = 0
  while i < n {
    sb.write_byte(if qr.modules[i] != (0).to_byte() { (49).to_byte() } else { (48).to_byte() })
    i = i + 1
  }
  sb.to_string()
}

///| Build the explicit segment list for corpus `kind`.
fn segs_for(kind : String, data : Bytes) -> Array[qrcode::Segment] {
  if kind == "byte" {
    [qrcode::Segment::byte(data)]
  } else if kind == "num" {
    [qrcode::Segment::numeric(data.to_string())]
  } else if kind == "alnum" {
    [qrcode::Segment::alphanumeric(data.to_string())]
  } else if kind == "kanji" {
    [qrcode::Segment::kanji(data)]
  } else if kind.length() > 3 && kind.code_unit_at(0) == 101 {
    // eci<N>: ECI(N) + Byte
    let mut d = 0
    let mut i = 3
    while i < kind.length() {
      d = d * 10 + (kind.code_unit_at(i) - 48)
      i = i + 1
    }
    [qrcode::Segment::eci(d), qrcode::Segment::byte(data)]
  } else {
    []
  }
}

///|
fn cmd_enc(world : World, path : String) -> Int {
  let rows = read_rows(world, path)
  let sb = StringBuilder::new()
  let mut r = 0
  while r < rows.length() {
    let row = rows[r]
    r = r + 1
    if row.length() < 7 {
      continue
    }
    let data = unhex(row[6])
    let opts = qrcode::EncodeOptions::{
      ec_level: ec_of(row[1]),
      min_version: parse_int(row[2]),
      max_version: parse_int(row[3]),
      mask: parse_int(row[4]),
      optimize_mode: row[5] != "auto_noopt",
      boost_ecl: false,
    }
    let res = if row[5] == "auto" || row[5] == "auto_noopt" {
      qrcode::encode_with_options(data, opts)
    } else {
      qrcode::encode_segments(segs_for(row[5], data), opts)
    }
    sb.write_string(row[0])
    match res {
      Ok(qr) => {
        sb.write_string("\tOK\t")
        sb.write_string(qr.version.to_string())
        sb.write_string("\t")
        sb.write_string(qr.ec_level.to_string())
        sb.write_string("\t")
        sb.write_string(qr.mask.to_string())
        sb.write_string("\t")
        sb.write_string(bits_of(qr))
      }
      Err(e) => {
        sb.write_string("\tERR\t")
        sb.write_string(err_name(e))
      }
    }
    sb.write_string("\n")
    if sb.length() > 1000000 {
      io_print(world, sb.to_string())
      sb.reset()
    }
  }
  io_print(world, sb.to_string())
  0
}

///|
fn cmd_dec(world : World, path : String) -> Int {
  let rows = read_rows(world, path)
  let sb = StringBuilder::new()
  let mut r = 0
  while r < rows.length() {
    let row = rows[r]
    r = r + 1
    if row.length() < 3 {
      continue
    }
    let size = parse_int(row[1])
    let bits = row[2]
    let m : FixedArray[Byte] = FixedArray::make(bits.length(), (0).to_byte())
    let mut i = 0
    while i < bits.length() {
      if bits.code_unit_at(i) == 49 {
        m[i] = (1).to_byte()
      }
      i = i + 1
    }
    sb.write_string(row[0])
    match qrcode::decode_matrix(m, size) {
      Ok(d) => {
        sb.write_string("\tOK\t")
        sb.write_string(d.version.to_string())
        sb.write_string("\t")
        sb.write_string(d.ec_level.to_string())
        sb.write_string("\t")
        sb.write_string(d.mask.to_string())
        sb.write_string("\t")
        sb.write_string(d.errors_corrected.to_string())
        sb.write_string("\t")
        sb.write_string(tohex(d.bytes))
      }
      Err(e) => {
        sb.write_string("\tERR\t")
        sb.write_string(err_name(e))
      }
    }
    sb.write_string("\n")
    if sb.length() > 1000000 {
      io_print(world, sb.to_string())
      sb.reset()
    }
  }
  io_print(world, sb.to_string())
  0
}

///|
fn cmd_seg(world : World, path : String) -> Int {
  let rows = read_rows(world, path)
  let sb = StringBuilder::new()
  let mut r = 0
  while r < rows.length() {
    let row = rows[r]
    r = r + 1
    if row.length() < 3 {
      continue
    }
    let v = parse_int(row[1])
    let segs = qrcode::optimize_segments(unhex(row[2]), v)
    let bits = match qrcode::segments_bit_length(segs, v) {
      Ok(b) => b
      Err(_) => -1
    }
    sb.write_string(row[0] + "\t" + bits.to_string() + "\t")
    let mut k = 0
    while k < segs.length() {
      let ch = match segs[k].mode {
        qrcode::Mode::Numeric => "N"
        qrcode::Mode::Alphanumeric => "A"
        qrcode::Mode::Byte => "B"
        qrcode::Mode::Kanji => "K"
        qrcode::Mode::Eci => "E"
      }
      sb.write_string(ch + segs[k].data.length().to_string())
      k = k + 1
    }
    sb.write_string("\n")
  }
  io_print(world, sb.to_string())
  0
}

///|
fn cmd_tables(world : World) -> Int {
  let sb = StringBuilder::new()
  let ecs = [qrcode::EcLevel::L, qrcode::EcLevel::M, qrcode::EcLevel::Q, qrcode::EcLevel::H]
  let mut v = 1
  while v <= 40 {
    let mut e = 0
    while e < 4 {
      let ec = ecs[e]
      sb.write_string(
        "T\t" + v.to_string() + "\t" + ec.to_string() + "\t" +
        qrcode::total_codewords(v).to_string() + "\t" +
        qrcode::data_codewords(v, ec).to_string() + "\t" +
        qrcode::num_blocks(v, ec).to_string() + "\t" +
        qrcode::ec_codewords_per_block(v, ec).to_string() + "\n",
      )
      let mut m = 0
      while m < 8 {
        sb.write_string(
          "F\t" + ec.to_string() + "\t" + m.to_string() + "\t" +
          qrcode::format_info_bits(ec, m).to_string() + "\n",
        )
        m = m + 1
      }
      e = e + 1
    }
    let al = qrcode::alignment_pattern_positions(v)
    sb.write_string("A\t" + v.to_string())
    let mut i = 0
    while i < al.length() {
      sb.write_string("\t" + al[i].to_string())
      i = i + 1
    }
    sb.write_string("\nV\t" + v.to_string() + "\t" + qrcode::version_info_bits(v).to_string() + "\n")
    v = v + 1
  }
  io_print(world, sb.to_string())
  0
}

///| Render probes: `what` in svg_qz, svg_ms, rgba, pgm, ascii, term; `n` is the hostile parameter.
fn cmd_render(world : World, what : String, n : Int) -> Int {
  let qr = match qrcode::encode("HELLO", qrcode::EcLevel::L) {
    Ok(q) => q
    Err(_) => return 2
  }
  let t0 = clock_now_ms(world)
  let len = if what == "svg_qz" {
    qr.to_svg(qrcode::SvgOptions::{ ..qrcode::SvgOptions::default(), quiet_zone: n }).length()
  } else if what == "svg_ms" {
    let s = qr.to_svg(qrcode::SvgOptions::{ ..qrcode::SvgOptions::default(), module_size: n })
    let hb = StringBuilder::new()
    let mut i = 0
    while i < 120 && i < s.length() {
      hb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
    io_println(world, "head=" + hb.to_string())
    s.length()
  } else if what == "rgba" {
    qr.to_rgba(4, n, 0x000000FFU, 0xFFFFFFFFU).length()
  } else if what == "pgm" {
    qr.to_pgm(4, n).length()
  } else if what == "ascii" {
    qr.to_ascii(n).length()
  } else if what == "term" {
    qr.to_terminal(n, false).length()
  } else {
    -1
  }
  io_println(world, what + " n=" + n.to_string() + " len=" + len.to_string() + " ms=" + (clock_now_ms(world) - t0).to_string())
  0
}

///|
fn make_lcg_bytes(n : Int, seed : Int64) -> Bytes {
  let b = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
    b[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  b
}

///| Fairness workloads. Output is only `ops` + summed module count (+ `size`): every encoder in
///| audit/diff/rust prints the same bytes iff it picks the same versions, so bench_compare.py's
///| SHA-256 gate still holds across encoders whose (legal) mask choices differ.
fn cmd_bench(world : World, mode : String, arg : Int) -> Int {
  let mut inputs : Array[Bytes] = []
  let mut ecs : Array[qrcode::EcLevel] = []
  let mut rounds = 0
  if mode == "w1" {
    // W1 inputs as shipped in bench/ (lower-case URLs => single Byte segment)
    inputs = [
      "https://example.com/o/01examp1e2a3b4c5d6e7f8g9h0/chat".to_bytes(),
      "otpauth://totp/acme:alice@example.com?secret=jbswy3dpehpk3pxp&issuer=acme".to_bytes(),
      "https://github.com/afk-surf/pion-packages/tree/main/packages/qrcode".to_bytes(),
      "otpauth://totp/example:bob@example.org?secret=mfrggzdfmztwq2lk&digits=6".to_bytes(),
      "https://console.example.com/device/activate?token=a1b2c3d4e5f6".to_bytes(),
    ]
    ecs = [
      qrcode::EcLevel::M,
      qrcode::EcLevel::Q,
      qrcode::EcLevel::Q,
      qrcode::EcLevel::M,
      qrcode::EcLevel::M,
    ]
    rounds = 2000
  } else if mode == "w2" {
    inputs = [
      make_lcg_bytes(210, 101L),
      make_lcg_bytes(500, 102L),
      make_lcg_bytes(1100, 103L),
      make_lcg_bytes(1900, 104L),
      make_lcg_bytes(2900, 105L),
    ]
    ecs = [
      qrcode::EcLevel::M,
      qrcode::EcLevel::M,
      qrcode::EcLevel::M,
      qrcode::EcLevel::M,
      qrcode::EcLevel::L,
    ]
    rounds = 60
  } else if mode == "real" {
    // Real-world mixed-case payloads (upper-case base32 secrets, Wi-Fi, vCard, digits)
    inputs = [
      "otpauth://totp/ACME:alice@example.com?secret=JBSWY3DPEHPK3PXP&issuer=ACME".to_bytes(),
      "WIFI:T:WPA;S:Office-5G;P:correct horse battery staple;;".to_bytes(),
      "BEGIN:VCARD\nVERSION:3.0\nN:Doe;John\nTEL:+1-202-555-0143\nEMAIL:john@example.com\nEND:VCARD".to_bytes(),
      "HTTPS://EXAMPLE.COM/P/0123456789012345678901234567890123456789".to_bytes(),
      "4006381333931".to_bytes(),
    ]
    ecs = [
      qrcode::EcLevel::M,
      qrcode::EcLevel::M,
      qrcode::EcLevel::Q,
      qrcode::EcLevel::L,
      qrcode::EcLevel::H,
    ]
    rounds = 2000
  } else if mode == "dp" {
    // `arg` bytes of alternating digit / upper / lower runs: exercises the mixed-mode optimiser
    let b = Bytes::new(arg)
    let mut i = 0
    while i < arg {
      let k = (i / 7) % 3
      b[i] = (if k == 0 { 48 + i % 10 } else if k == 1 { 65 + i % 26 } else { 97 + i % 26 }).to_byte()
      i = i + 1
    }
    inputs = [b]
    ecs = [qrcode::EcLevel::L]
    rounds = 1
  } else {
    io_println(world, "unknown bench " + mode)
    return 2
  }
  let mut total = 0L
  let mut last = ""
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < inputs.length() {
      match qrcode::encode_bytes(inputs[i], ecs[i]) {
        Ok(qr) => total = total + (qr.size * qr.size).to_int64()
        Err(e) => last = err_name(e)
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "mode=" + mode + " total_modules=" + total.to_string() + " err=" + last)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: oracle enc|dec|seg|tables|render|bench ...")
    return 2
  }
  let cmd = args[1]
  if cmd == "enc" && args.length() >= 3 {
    cmd_enc(world, args[2])
  } else if cmd == "dec" && args.length() >= 3 {
    cmd_dec(world, args[2])
  } else if cmd == "seg" && args.length() >= 3 {
    cmd_seg(world, args[2])
  } else if cmd == "tables" {
    cmd_tables(world)
  } else if cmd == "render" && args.length() >= 4 {
    cmd_render(world, args[2], parse_int(args[3]))
  } else if cmd == "bench" && args.length() >= 3 {
    cmd_bench(world, args[2], if args.length() >= 4 { parse_int(args[3]) } else { 0 })
  } else {
    io_eprintln(world, "bad args")
    2
  }
}
