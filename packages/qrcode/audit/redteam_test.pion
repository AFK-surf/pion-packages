///| Red-team audit of `packages/qrcode` (RT-qrcode), baseline `feat/pkg-qrcode` @ e05329a.
///|
///| Every `p1_*` / `p2_*` test asserts what the references require (ISO/IEC 18004:2015,
///| Nayuki qrcodegen 1.8.0, rqrr 0.11.0 / quirc, zxing) and therefore FAILS on the audited
///| baseline: the failure is the evidence. Every `control_*` test pins an attack the package
///| already defeats and must keep passing. See REPORT.md; the differential evidence (160 (v,ec)
///| x 8 masks pixel-identical with qrcodegen, rqrr cross-decoding, RS injection, fuzz) is
///| reproduced by run_audit.sh.

import "qrcode"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn contains(h : String, n : String) -> Bool {
  let hl = h.length()
  let nl = n.length()
  let mut i = 0
  while i + nl <= hl {
    let mut j = 0
    while j < nl && h.code_unit_at(i + j) == n.code_unit_at(j) {
      j = j + 1
    }
    if j == nl {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn hexv(c : Int) -> Int {
  if c >= 97 {
    c - 87
  } else {
    c - 48
  }
}

///|
fn unhex(s : String) -> Bytes {
  let out = Bytes::new(s.length() / 2)
  let mut i = 0
  while i < out.length() {
    out[i] = (hexv(s.code_unit_at(2 * i)) * 16 + hexv(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///| `size*size` module matrix from a big-endian hex bit string (row-major, MSB first).
fn matrix_from_hex(h : String, size : Int) -> FixedArray[Byte] {
  let m : FixedArray[Byte] = FixedArray::make(size * size, (0).to_byte())
  let mut i = 0
  while i < size * size {
    let nib = hexv(h.code_unit_at(i / 4))
    if ((nib >> (3 - i % 4)) & 1) != 0 {
      m[i] = (1).to_byte()
    }
    i = i + 1
  }
  m
}

///|
fn transpose(m : FixedArray[Byte], n : Int) -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(n * n, (0).to_byte())
  let mut y = 0
  while y < n {
    let mut x = 0
    while x < n {
      out[x * n + y] = m[y * n + x]
      x = x + 1
    }
    y = y + 1
  }
  out
}

///|
fn is_ok_decode(r : Result[qrcode::DecodedQr, qrcode::QrError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn enc_version(r : Result[qrcode::QrCode, qrcode::QrError]) -> Int {
  match r {
    Ok(q) => q.version
    Err(_) => -1
  }
}

///|
fn hello() -> qrcode::QrCode {
  match qrcode::encode("HELLO", qrcode::EcLevel::L) {
    Ok(q) => q
    Err(_) => panic()
  }
}

// RS-valid v1-L symbols built with qrcodegen::encode_codewords (audit/diff, `cw` command, mask 0):
// struct-append header 0011|0001|0001|0x5A then Byte "A"
let mat_struct_append : String = "fe2bfc10506ea8bb7415dba5aec13907faafe01400efae22a5aab985cec97bb06f76006103fa22f05448baeaedd3aa2eb5cb053b9fef728"
// ECI 3-byte designator 0x1FFFFF = 2097151 (> 999999) then Byte "Z"
let mat_eci_2097151 : String = "fe5bfc13906eb6bb74a5dba2aec10507faafe01b00eff621ee1154fa34f844107aab006aa7fb5cd053b9ba9775d2182eba3d0506dfeea98"
// Kanji count 1, 13-bit value 0xBF (decodes to 0x81FF: trail byte 0xFF is not Shift-JIS)
let mat_kanji_81ff : String = "fe2bfc10506ea8bb7415dba5aec13907faafe01400efae25ecab79bdcce2fb89ed7380611bfb22305044baeaadd0aaaeb5db05fbafef760"

// ---------------------------------------------------------------------------
// P1: SVG injection (renderer writes caller colours into attributes verbatim)
// ---------------------------------------------------------------------------

///|
test "p1_svg_dark_color_attribute_injection" {
  let svg = hello().to_svg(qrcode::SvgOptions::{
    ..qrcode::SvgOptions::default(),
    dark_color: "#000\" onload=\"alert(1)",
  })
  debug_assert(!contains(svg, "\" onload=\"alert(1)"), "dark_color injects an onload= attribute into <path>")
}

///|
test "p1_svg_light_color_script_injection" {
  let svg = hello().to_svg(qrcode::SvgOptions::{
    ..qrcode::SvgOptions::default(),
    light_color: "#fff\"/><script>alert(document.domain)</script><rect fill=\"#fff",
    compact_path: false,
  })
  debug_assert(!contains(svg, "<script>"), "light_color closes <rect> and injects <script> into the SVG")
}

// ---------------------------------------------------------------------------
// P1: raster renderers - Int32 overflow of dim*dim(*4) aborts the process
// ---------------------------------------------------------------------------

///|
test "p1_rgba_scale_1000_int32_overflow_aborts" {
  // dim = (21 + 8) * 1000 = 29000; 29000^2 * 4 = 3.36e9 wraps negative -> runtime abort
  let out = hello().to_rgba(4, 1000, 0x000000FFU, 0xFFFFFFFFU)
  debug_assert(out.length() >= 0, "unreachable: Bytes::new(negative) aborted above")
}

///|
test "p1_rgba_scale_2000_wraps_then_out_of_bounds" {
  // 58000^2 * 4 wraps to a positive but too small length -> index out of bounds abort
  let out = hello().to_rgba(4, 2000, 0x000000FFU, 0xFFFFFFFFU)
  debug_assert(out.length() >= 0, "unreachable: out-of-bounds write aborted above")
}

///|
test "p1_pgm_scale_2000_int32_overflow_aborts" {
  let out = hello().to_pgm(4, 2000)
  debug_assert(out.length() >= 0, "unreachable: Bytes::new(negative) aborted above")
}

// ---------------------------------------------------------------------------
// P2: spec / interop gaps
// ---------------------------------------------------------------------------

///|
test "p2_svg_module_size_overflow_negative_viewbox" {
  let svg = hello().to_svg(qrcode::SvgOptions::{
    ..qrcode::SvgOptions::default(),
    module_size: 100000000,
  })
  debug_assert(!contains(svg, "viewBox=\"0 0 -"), "module_size*dim wraps Int32: negative viewBox emitted")
}

///|
test "p2_mirror_image_symbol_is_decoded" {
  // ISO/IEC 18004:2015 readers (zxing, quirc/rqrr) retry a mirror image; rqrr decodes 771/771
  // mirrored corpus symbols, Pion 0/771.
  let text = "MIRROR 0123456789 https://example.com/x"
  let qr = match qrcode::encode(text, qrcode::EcLevel::M) {
    Ok(q) => q
    Err(_) => panic()
  }
  let r = qrcode::decode_matrix(transpose(qr.modules, qr.size), qr.size)
  let ok = match r {
    Ok(d) => d.text == text
    Err(_) => false
  }
  debug_assert(ok, "mirror-imaged (transposed) symbol rejected")
}

///|
test "p2_auto_mask_follows_reference_penalty" {
  // Same data codewords at v2-L: qrcodegen picks mask 3 (N1..N4 = 1220), Pion picks mask 6
  // (1226 under the reference rule). 64/160 full-capacity symbols get a worse mask.
  let data = unhex("5754d510ac5ec1608d59fd47d628523cfa392d6a66f84ab8d98a4f6145ad2202")
  let qr = match qrcode::encode_segments([qrcode::Segment::byte(data)], qrcode::EncodeOptions::fixed(2, qrcode::EcLevel::L, -1)) {
    Ok(q) => q
    Err(_) => panic()
  }
  debug_assert(qr.mask == 3, "auto mask " + qr.mask.to_string() + " != reference-optimal mask 3")
}

///|
test "p2_penalty_n3_counts_finder_pattern_against_quiet_zone" {
  // 21x21 all light except row 10 = 1011101 0 1 0...: the 1:1:3:1:1 run touches the left edge,
  // whose quiet zone is light (ISO 7.8.3.1; qrcodegen / zxing count it). Reference total = 2047.
  let n = 21
  let m : FixedArray[Byte] = FixedArray::make(n * n, (0).to_byte())
  let row = [1, 0, 1, 1, 1, 0, 1, 0, 1]
  let mut i = 0
  while i < row.length() {
    m[10 * n + i] = row[i].to_byte()
    i = i + 1
  }
  let p = qrcode::compute_penalty(m, n)
  debug_assert(p == 2047, "penalty " + p.to_string() + " != reference 2047 (edge N3 not counted)")
}

///|
test "p2_optimizer_exact_fit_gets_v1" {
  // Exact optimum Byte("coofjvo8 ") + Numeric("062862655") + Alnum("$*") = 152 bits = v1-L
  // capacity (control below proves it encodes at v1); the DP's fixed +4/+3 switch costs make it
  // 153 bits and the encoder escalates to v2.
  let v = enc_version(qrcode::encode("coofjvo8 062862655$*", qrcode::EcLevel::L))
  debug_assert(v == 1, "auto encode picked v" + v.to_string() + " although a 152-bit v1-L encoding exists")
}

///|
test "p2_structured_append_header_is_decoded" {
  // Mode 0011 is part of ISO/IEC 18004 (8.3, Structured Append); zxing skips the 16-bit header.
  let r = qrcode::decode_matrix(matrix_from_hex(mat_struct_append, 21), 21)
  let ok = match r {
    Ok(d) => bytes_eq(d.bytes, "A".to_bytes())
    Err(_) => false
  }
  debug_assert(ok, "Structured Append symbol rejected (UnsupportedMode(3))")
}

///|
test "p2_decoder_rejects_eci_designator_over_999999" {
  debug_assert(!is_ok_decode(qrcode::decode_matrix(matrix_from_hex(mat_eci_2097151, 21), 21)), "ECI 2097151 accepted although the encoder rejects > 999999")
}

///|
test "p2_decoder_rejects_kanji_value_outside_shift_jis" {
  debug_assert(!is_ok_decode(qrcode::decode_matrix(matrix_from_hex(mat_kanji_81ff, 21), 21)), "Kanji value 0xBF decoded to non-Shift-JIS pair 0x81FF")
}

// ---------------------------------------------------------------------------
// controls (must PASS)
// ---------------------------------------------------------------------------

///|
test "control_optimizer_exact_fit_segments_do_fit_v1" {
  let segs = [
    qrcode::Segment::byte("coofjvo8 ".to_bytes()),
    qrcode::Segment::numeric("062862655"),
    qrcode::Segment::alphanumeric("$*"),
  ]
  let v = enc_version(qrcode::encode_segments(segs, qrcode::EncodeOptions::fixed(1, qrcode::EcLevel::L, -1)))
  debug_assert(v == 1, "explicit optimal segmentation must fit v1-L")
}

///|
test "control_iso_capacity_boundaries" {
  let bytes2953 = Bytes::new(2953)
  let bytes2954 = Bytes::new(2954)
  debug_assert(enc_version(qrcode::encode_bytes(bytes2953, qrcode::EcLevel::L)) == 40, "2953 bytes = v40-L")
  debug_assert(enc_version(qrcode::encode_bytes(bytes2954, qrcode::EcLevel::L)) == -1, "2954 bytes overflow")
  let n = StringBuilder::new()
  let a = StringBuilder::new()
  let mut i = 0
  while i < 7089 {
    n.write_byte((48 + i % 10).to_byte())
    if i < 4296 {
      a.write_byte((65 + i % 26).to_byte())
    }
    i = i + 1
  }
  debug_assert(enc_version(qrcode::encode(n.to_string(), qrcode::EcLevel::L)) == 40, "7089 digits = v40-L")
  debug_assert(enc_version(qrcode::encode(n.to_string() + "1", qrcode::EcLevel::L)) == -1, "7090 digits overflow")
  debug_assert(enc_version(qrcode::encode(a.to_string(), qrcode::EcLevel::L)) == 40, "4296 alnum = v40-L")
  debug_assert(enc_version(qrcode::encode(a.to_string() + "A", qrcode::EcLevel::L)) == -1, "4297 alnum overflow")
  debug_assert(enc_version(qrcode::encode("abcdefg", qrcode::EcLevel::H)) == 1, "7 bytes = v1-H")
  debug_assert(enc_version(qrcode::encode("abcdefgh", qrcode::EcLevel::H)) == 2, "8 bytes > v1-H")
  debug_assert(enc_version(qrcode::encode("12345678901234567", qrcode::EcLevel::H)) == 1, "17 digits = v1-H")
  debug_assert(enc_version(qrcode::encode("ABCDEFGHIJ", qrcode::EcLevel::H)) == 1, "10 alnum = v1-H")
}

///|
test "control_edge_payload_roundtrip" {
  let cases = [
    Bytes::new(0),
    unhex("00"),
    unhex("610062"),
    "😀🚀".to_bytes(),
    unhex("fffec32880"),
  ]
  let mut i = 0
  while i < cases.length() {
    let qr = match qrcode::encode_bytes(cases[i], qrcode::EcLevel::M) {
      Ok(q) => q
      Err(_) => panic()
    }
    let ok = match qrcode::decode(qr) {
      Ok(d) => bytes_eq(d.bytes, cases[i])
      Err(_) => false
    }
    debug_assert(ok, "edge payload " + i.to_string() + " roundtrip")
    i = i + 1
  }
}

///|
test "control_hostile_matrices_return_errors" {
  let sizes = [0, -21, 1, 20, 22, 177 + 4, 10000]
  let mut i = 0
  while i < sizes.length() {
    let s = sizes[i]
    let len = if s > 0 && s <= 200 { s * s } else { 4 }
    debug_assert(!is_ok_decode(qrcode::decode_matrix(FixedArray::make(len, (0).to_byte()), s)), "bad size accepted")
    i = i + 1
  }
  debug_assert(!is_ok_decode(qrcode::decode_matrix(FixedArray::make(25 * 25 - 1, (0).to_byte()), 25)), "length mismatch accepted")
  let mut v = 1
  while v <= 40 {
    let n = v * 4 + 17
    debug_assert(!is_ok_decode(qrcode::decode_matrix(FixedArray::make(n * n, (0).to_byte()), n)), "all-light decoded")
    debug_assert(!is_ok_decode(qrcode::decode_matrix(FixedArray::make(n * n, (1).to_byte()), n)), "all-dark decoded")
    v = v + 1
  }
}

///|
test "control_encoder_rejects_invalid_kanji_and_eci" {
  let bad_pairs = ["817f", "81fd", "a040", "9ffd", "ebc0", "e03f", "8140ff"]
  let mut i = 0
  while i < bad_pairs.length() {
    let r = qrcode::encode_segments([qrcode::Segment::kanji(unhex(bad_pairs[i]))], qrcode::EncodeOptions::default())
    debug_assert(enc_version(r) == -1, "invalid Shift-JIS accepted: " + bad_pairs[i])
    i = i + 1
  }
  let ok = qrcode::encode_segments([qrcode::Segment::kanji(unhex("8140ebbf935f"))], qrcode::EncodeOptions::default())
  debug_assert(enc_version(ok) == 1, "valid Shift-JIS boundary pairs rejected")
  let e = qrcode::encode_segments([qrcode::Segment::eci(1000000), qrcode::Segment::byte("x".to_bytes())], qrcode::EncodeOptions::default())
  debug_assert(enc_version(e) == -1, "ECI 1000000 accepted")
}

///|
test "control_rs_corrects_t_and_detects_t_plus_1" {
  // v5-Q style block: 15 data + 18 EC (t = 9)
  let data = unhex("4142434445464748494a4b4c4d4e4f")
  let ec = qrcode::rs_encode_block(data, 18)
  let mut k = 1
  while k <= 12 {
    let cw : FixedArray[Byte] = FixedArray::make(33, (0).to_byte())
    let mut i = 0
    while i < 15 {
      cw[i] = data[i]
      i = i + 1
    }
    while i < 33 {
      cw[i] = ec[i - 15]
      i = i + 1
    }
    let mut j = 0
    while j < k {
      cw[(j * 7) % 33] = ((cw[(j * 7) % 33].to_int() ^ (0x5A + j)) & 0xFF).to_byte()
      j = j + 1
    }
    let r = qrcode::rs_decode_block(cw, 18)
    let mut same = true
    i = 0
    while i < 15 {
      if cw[i] != data[i] {
        same = false
      }
      i = i + 1
    }
    let ok = match r {
      Ok(_) => same
      Err(_) => false
    }
    if k <= 9 {
      debug_assert(ok, "k=" + k.to_string() + " <= t must be corrected")
    } else {
      debug_assert(!ok || same, "k=" + k.to_string() + " > t silently miscorrected")
    }
    k = k + 1
  }
}

///|
test "control_huge_input_fails_fast_with_data_too_long" {
  let big = Bytes::new(102400)
  let mut i = 0
  while i < big.length() {
    big[i] = (if (i / 7) % 3 == 0 { 48 + i % 10 } else if (i / 7) % 3 == 1 { 65 + i % 26 } else { 97 + i % 26 }).to_byte()
    i = i + 1
  }
  debug_assert(enc_version(qrcode::encode_bytes(big, qrcode::EcLevel::L)) == -1, "100 KiB must be DataTooLong")
}

///|
test "control_svg_huge_quiet_zone_is_linear" {
  let svg = hello().to_svg(qrcode::SvgOptions::{ ..qrcode::SvgOptions::default(), quiet_zone: 1000000 })
  debug_assert(svg.length() < 10000, "SVG size must not depend on quiet_zone")
}
