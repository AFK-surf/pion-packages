///| Reed-Solomon GF(256) error injection & recovery, multi-version roundtrips,
///| module bit-flip corruption recovery, and 90/180/270-degree rotation decoding tests.

///|
fn dec_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn dec_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn dec_make_pattern_bytes(n : Int, seed : Int) -> Bytes {
  let mut b = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 1103515245 + 12345) & 0x7FFFFFFF
    b[i] = ((s >> 16) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn dec_rotate_cw(modules : FixedArray[Byte], size : Int) -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(size * size, (0).to_byte())
  let mut y = 0
  while y < size {
    let mut x = 0
    while x < size {
      // (x, y) -> (size - 1 - y, x)
      let nx = size - 1 - y
      let ny = x
      out[ny * size + nx] = modules[y * size + x]
      x = x + 1
    }
    y = y + 1
  }
  out
}

///|
test "rs_gf256_and_error_correction_up_to_half_ec" {
  // GF(256) basic identities
  debug_assert(gf_mul(0, 123) == 0, "0 * x = 0")
  debug_assert(gf_mul(1, 219) == 219, "1 * x = x")
  debug_assert(gf_mul(0x53, 0xCA) == gf_mul(0xCA, 0x53), "commutativity")
  debug_assert(gf_mul(0x80, 0x02) == 0x1D, "x^8 mod 0x11D = 0x1D")

  // Encode a 13-byte data block with 13 EC bytes (can correct up to t = 6 byte errors!)
  let data = dec_bytes_from_ints([32, 91, 11, 120, 209, 114, 220, 77, 67, 64, 236, 17, 236])
  let ec = rs_encode_block(data, 13)
  let cw : FixedArray[Byte] = FixedArray::make(26, (0).to_byte())
  let mut i = 0
  while i < 13 {
    cw[i] = data[i]
    cw[13 + i] = ec[i]
    i = i + 1
  }

  // Inject 6 byte errors (maximum correctable for ec_len=13)
  let err_pos = [0, 3, 7, 12, 15, 25]
  let err_val = [0xFF, 0x55, 0xAA, 0x01, 0x80, 0x3C]
  let mut e = 0
  while e < 6 {
    let p = err_pos[e]
    cw[p] = (cw[p].to_int() ^ err_val[e]).to_byte()
    e = e + 1
  }

  match rs_decode_block(cw, 13) {
    Result::Ok(fixed) => {
      debug_assert(fixed == 6, "must report 6 corrected errors")
      let mut j = 0
      while j < 13 {
        debug_assert(cw[j] == data[j], "RS restored data byte mismatch")
        j = j + 1
      }
    }
    Result::Err(err) => debug_assert(false, qr_error_message(err))
  }

  // Inject 7 byte errors (exceeds floor(13/2) = 6) -> must fail
  let cw_bad : FixedArray[Byte] = FixedArray::make(26, (0).to_byte())
  let mut k = 0
  while k < 13 {
    cw_bad[k] = data[k]
    cw_bad[13 + k] = ec[k]
    k = k + 1
  }
  let mut b = 0
  while b < 7 {
    cw_bad[b * 3] = (cw_bad[b * 3].to_int() ^ 0xA5).to_byte()
    b = b + 1
  }
  match rs_decode_block(cw_bad, 13) {
    Result::Err(QrError::ReedSolomonError(_)) => ()
    _ => debug_assert(false, "7 errors in 13-EC block must return ReedSolomonError")
  }
}

///|
test "decode_multi_version_roundtrip_v1_to_v40" {
  // Test v1, v4, v7 (first version-info), v10 (tier-2 char count), v27 (tier-3), and v40
  let payloads = [
    "https://still.fail",
    "otpauth://totp/ACME:alice@example.com?secret=JBSWY3DPEHPK3PXP&issuer=ACME",
    "Version 7+ has 18-bit BCH version information blocks in top-right and bottom-left corners! 0123456789",
  ]
  let levels = [EcLevel::L, EcLevel::M, EcLevel::Q, EcLevel::H]
  let mut pi = 0
  while pi < payloads.length() {
    let mut li = 0
    while li < 4 {
      match encode(payloads[pi], levels[li]) {
        Result::Ok(qr) =>
        match decode(qr) {
          Result::Ok(dec) => {
            debug_assert(dec.text == payloads[pi], "roundtrip payload mismatch")
            debug_assert(dec.version == qr.version, "roundtrip version mismatch")
            debug_assert(ec_level_eq(dec.ec_level, qr.ec_level), "roundtrip ec mismatch")
            debug_assert(dec.mask == qr.mask, "roundtrip mask mismatch")
            debug_assert(dec.errors_corrected == 0, "clean decode has 0 errors")
          }
          Result::Err(e) => debug_assert(false, qr_error_message(e))
        }
        Result::Err(e) => debug_assert(false, qr_error_message(e))
      }
      li = li + 1
    }
    pi = pi + 1
  }

  // Binary v10 (200 bytes) & v40 (2800 bytes) roundtrip
  let bin200 = dec_make_pattern_bytes(200, 42)
  match encode_bytes(bin200, EcLevel::Q) {
    Result::Ok(qr) => {
      debug_assert(qr.version >= 10, "200 binary bytes at Q requires >= v10")
      match decode(qr) {
        Result::Ok(dec) =>
        debug_assert(dec_bytes_eq(dec.bytes, bin200), "200-byte binary roundtrip")
        Result::Err(e) => debug_assert(false, qr_error_message(e))
      }
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }

  let bin2900 = dec_make_pattern_bytes(2900, 99)
  match encode_bytes(bin2900, EcLevel::L) {
    Result::Ok(qr) => {
      debug_assert(qr.version == 40, "2900 binary bytes at L uses v40")
      match decode(qr) {
        Result::Ok(dec) =>
        debug_assert(dec_bytes_eq(dec.bytes, bin2900), "v40 2900-byte binary roundtrip")
        Result::Err(e) => debug_assert(false, qr_error_message(e))
      }
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }
}

///|
test "decode_recovers_corrupted_modules_and_rotations" {
  let msg = "Pion QR Reed-Solomon full recovery test! 2026"
  match encode(msg, EcLevel::H) {
    Result::Ok(qr) => {
      // Copy modules and flip 12 modules in the data area
      let n = qr.size * qr.size
      let damaged : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
      let mut i = 0
      while i < n {
        damaged[i] = qr.modules[i]
        i = i + 1
      }
      // Flip modules in the bottom-right data region (away from finders)
      let mut k = 0
      while k < 12 {
        let x = qr.size - 1 - (k % 6)
        let y = qr.size - 1 - (k / 6) * 2
        let idx = y * qr.size + x
        damaged[idx] = (1 - damaged[idx].to_int()).to_byte()
        k = k + 1
      }
      // Also flip 2 format info bits (top-left copy) to test Format BCH correction
      damaged[8 * qr.size + 0] = (1 - damaged[8 * qr.size + 0].to_int()).to_byte()
      damaged[8 * qr.size + 1] = (1 - damaged[8 * qr.size + 1].to_int()).to_byte()

      match decode_matrix(damaged, qr.size) {
        Result::Ok(dec) => {
          debug_assert(dec.text == msg, "damaged QR must recover exact message")
          debug_assert(dec.errors_corrected > 0, "must report >0 RS errors corrected")
        }
        Result::Err(e) => debug_assert(false, qr_error_message(e))
      }

      // Test 90, 180, and 270 degree rotations
      let r90 = dec_rotate_cw(qr.modules, qr.size)
      let r180 = dec_rotate_cw(r90, qr.size)
      let r270 = dec_rotate_cw(r180, qr.size)
      let rots = [r90, r180, r270]
      let mut ri = 0
      while ri < 3 {
        match decode_matrix(rots[ri], qr.size) {
          Result::Ok(dec) =>
          debug_assert(dec.text == msg, "rotated QR decode mismatch at rot " + ri.to_string())
          Result::Err(e) => debug_assert(false, qr_error_message(e))
        }
        ri = ri + 1
      }
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }
}

///|
test "decode_rejects_invalid_matrix_size" {
  let bad : FixedArray[Byte] = FixedArray::make(400, (0).to_byte())
  match decode_matrix(bad, 20) {
    Result::Err(QrError::InvalidMatrixSize(20)) => ()
    _ => debug_assert(false, "size 20 must fail with InvalidMatrixSize")
  }
}
