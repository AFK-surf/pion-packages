///| Renderer tests: compact SVG (<path>), <rect> SVG, UTF-8 half-block terminal,
///| ASCII, P5 PGM grayscale, and 32-bit RGBA raster output.

///|
fn rnd_contains(haystack : String, needle : String) -> Bool {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  while i <= hn - nn {
    let mut ok = true
    let mut j = 0
    while j < nn {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn rnd_count_char(s : String, ch : Int) -> Int {
  let mut c = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == ch {
      c = c + 1
    }
    i = i + 1
  }
  c
}

///|
test "render_svg_compact_path_and_rect_modes" {
  match encode("HELLO WORLD", EcLevel::Q) {
    Result::Ok(qr) => {
      // Default compact SVG
      let svg_path = qr.to_svg_default()
      debug_assert(rnd_contains(svg_path, "<svg "), "SVG root element")
      debug_assert(rnd_contains(svg_path, "viewBox=\"0 0 29 29\""), "v1 + qz=4 -> 29x29 viewBox")
      debug_assert(rnd_contains(svg_path, "<path "), "compact SVG uses <path>")
      debug_assert(rnd_contains(svg_path, "</svg>"), "SVG closing tag")

      // Rect SVG with custom colors and quiet_zone=2
      let rect_opts = SvgOptions::{
        quiet_zone: 2,
        dark_color: "#112233",
        light_color: "#fafafa",
        compact_path: false,
        module_size: 2,
      }
      let svg_rect = qr.to_svg(rect_opts)
      debug_assert(rnd_contains(svg_rect, "viewBox=\"0 0 50 50\""), "(21+4)*2 = 50")
      debug_assert(rnd_contains(svg_rect, "#112233"), "custom dark color")
      debug_assert(rnd_contains(svg_rect, "#fafafa"), "custom light color")
      debug_assert(rnd_contains(svg_rect, "<rect "), "rect mode uses <rect>")
      debug_assert(
        svg_path.length() < svg_rect.length(),
        "compact <path> SVG must be significantly smaller than <rect> SVG",
      )
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }
}

///|
test "render_terminal_half_blocks_and_ascii" {
  match encode("PION", EcLevel::M) {
    Result::Ok(qr) => {
      let term = qr.to_terminal(2, false)
      // Total rows = 21 + 4 = 25 -> ceil(25 / 2) = 13 lines
      debug_assert(rnd_count_char(term, 10) == 13, "25 rows -> 13 half-block terminal lines")
      // Must contain UTF-8 block elements (U+2580/2584/2588)
      debug_assert(rnd_contains(term, "█") || rnd_contains(term, "▀"), "terminal uses block chars")

      let term_inv = qr.to_terminal(2, true)
      debug_assert(term_inv != term, "inverted terminal output must differ")

      let ascii = qr.to_ascii(1)
      // Total rows = 21 + 2 = 23 lines
      debug_assert(rnd_count_char(ascii, 10) == 23, "23 ASCII lines with qz=1")
      debug_assert(rnd_contains(ascii, "##"), "ASCII uses ## for dark modules")
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }
}

///|
test "render_pgm_and_rgba_raster" {
  match encode("RASTER", EcLevel::L) {
    Result::Ok(qr) => {
      // PGM with quiet_zone=1, scale=2 -> (21 + 2) * 2 = 46x46
      let pgm = qr.to_pgm(1, 2)
      let header = "P5\n46 46\n255\n"
      let expected_len = header.length() + 46 * 46
      debug_assert(pgm.length() == expected_len, "PGM total byte length")
      // Top-left pixel is in quiet zone -> white (255)
      debug_assert(pgm[header.length()].to_int() == 255, "PGM quiet zone pixel is 255")
      // Module (0, 0) is dark -> at pixel (2, 2) -> black (0)
      debug_assert(
        pgm[header.length() + 2 * 46 + 2].to_int() == 0,
        "PGM finder (0,0) pixel is 0",
      )

      // RGBA with quiet_zone=1, scale=1 -> 23x23x4 = 2116 bytes
      let rgba = qr.to_rgba(1, 1, 0x112233FFU, 0xFFEEDDCCU)
      debug_assert(rgba.length() == 23 * 23 * 4, "RGBA byte length")
      // Quiet zone (0,0) -> 0xFF, 0xEE, 0xDD, 0xCC
      debug_assert(rgba[0].to_int() == 0xFF && rgba[1].to_int() == 0xEE, "RGBA light pixel")
      // Finder (0,0) -> at (1,1) -> offset (1*23 + 1)*4 = 96 -> 0x11, 0x22, 0x33, 0xFF
      let off = (1 * 23 + 1) * 4
      debug_assert(
        rgba[off].to_int() == 0x11 &&
        rgba[off + 1].to_int() == 0x22 &&
        rgba[off + 2].to_int() == 0x33 &&
        rgba[off + 3].to_int() == 0xFF,
        "RGBA dark pixel",
      )
    }
    Result::Err(e) => debug_assert(false, qr_error_message(e))
  }
}
