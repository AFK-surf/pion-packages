// Head-to-head benchmark harness for packages/effect:
//   queue  : 50,000 messages through a bounded queue (cap 16) between producer & consumer fibers
//   timers : 20,000 virtual-clock sleep_k timers with deterministic delays (1..500 ms)
//   fanout : 2,500 batches x 4 concurrent fibers joined via all_k (10,000 child fibers)

import "effect"

fn queue_prod(q : effect::Queue[Int], i : Int, n : Int, k : (effect::Exit[Unit]) -> Unit) -> Unit {
  if i >= n {
    q.shutdown()
    k(effect::Exit::Succeeded(()))
    return
  }
  q.offer_k(i, fn(ex : effect::Exit[Unit]) -> Unit {
    match ex {
      effect::Exit::Succeeded(_) => queue_prod(q, i + 1, n, k)
      other => k(other)
    }
  })
}

fn queue_cons(
  q : effect::Queue[Int],
  acc : Array[Int],
  cnt : Array[Int],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  q.take_k(fn(ex : effect::Exit[Int]) -> Unit {
    match ex {
      effect::Exit::Succeeded(v) => {
        acc[0] = (acc[0] * 31 + v) & 0x7fffffff
        cnt[0] = cnt[0] + 1
        queue_cons(q, acc, cnt, k)
      }
      effect::Exit::Failed(_) => k(effect::Exit::Succeeded(()))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

fn bench_queue(world : World) -> Int {
  let n = 50000
  let rt = effect::Runtime::new()
  let q : effect::Queue[Int] = effect::Queue::bounded(16)
  let acc = [0]
  let cnt = [0]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit { queue_prod(q, 0, n, k) })
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit { queue_cons(q, acc, cnt, k) })
  let _ = rt.run_ready()
  io_println(world, "mode=queue")
  io_println(world, "ops=" + cnt[0].to_string())
  io_println(world, "checksum=" + acc[0].to_string())
  0
}

fn bench_timers(world : World) -> Int {
  let n = 20000
  let rt = effect::Runtime::new()
  let acc = [0]
  let fired = [0]
  for i in 0..<n {
    let idx = i
    let delay = ((idx * 7919) % 500) + 1
    let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
      effect::sleep_k(delay, fn(ex : effect::Exit[Unit]) -> Unit {
        match ex {
          effect::Exit::Succeeded(_) => {
            let at = effect::now().to_int()
            acc[0] = (acc[0] * 31 + at * 131 + idx) & 0x7fffffff
            fired[0] = fired[0] + 1
            k(effect::Exit::Succeeded(()))
          }
          other => k(other)
        }
      })
    })
  }
  rt.advance(505)
  io_println(world, "mode=timers")
  io_println(world, "ops=" + fired[0].to_string())
  io_println(world, "now=" + rt.now().to_string())
  io_println(world, "checksum=" + acc[0].to_string())
  0
}

fn bench_fanout(world : World) -> Int {
  let batches = 2500
  let rt = effect::Runtime::new()
  let acc = [0]
  let total = [0]
  for b in 0..<batches {
    let base = b * 4
    let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
      effect::all_k(
        [
          fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
            effect::pause_k(fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(base + 1)) })
          },
          fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
            effect::pause_k(fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(base + 2)) })
          },
          fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
            effect::pause_k(fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(base + 3)) })
          },
          fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
            effect::pause_k(fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(base + 4)) })
          },
        ],
        fn(ex : effect::Exit[Array[Int]]) -> Unit {
          match ex {
            effect::Exit::Succeeded(xs) => {
              let mut s = 0
              for x in xs {
                s = s + x
              }
              acc[0] = (acc[0] * 31 + s) & 0x7fffffff
              total[0] = total[0] + xs.length()
            }
            _ => ()
          }
          k(effect::Exit::Succeeded(()))
        },
      )
    })
    let _ = rt.run_ready()
  }
  io_println(world, "mode=fanout")
  io_println(world, "ops=" + total[0].to_string())
  io_println(world, "checksum=" + acc[0].to_string())
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: effect_bench <queue|timers|fanout>")
    return 1
  }
  let mode = args[1]
  if mode == "queue" {
    return bench_queue(world)
  }
  if mode == "timers" {
    return bench_timers(world)
  }
  if mode == "fanout" {
    return bench_fanout(world)
  }
  io_println(world, "unknown mode: " + mode)
  1
}
