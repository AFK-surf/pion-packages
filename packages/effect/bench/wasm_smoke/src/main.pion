// Deterministic 4-mode (Native/Wasm32 x debug/release) smoke test for packages/effect.

import "effect"

fn prod_loop(q : effect::Queue[Int], i : Int, n : Int, k : (effect::Exit[Unit]) -> Unit) -> Unit {
  if i >= n {
    q.shutdown()
    k(effect::Exit::Succeeded(()))
    return
  }
  q.offer_k(i, fn(ex : effect::Exit[Unit]) -> Unit {
    match ex {
      effect::Exit::Succeeded(_) => prod_loop(q, i + 1, n, k)
      other => k(other)
    }
  })
}

fn cons_loop(
  q : effect::Queue[Int],
  acc : Array[Int],
  cnt : Array[Int],
  k : (effect::Exit[Unit]) -> Unit,
) -> Unit {
  q.take_k(fn(ex : effect::Exit[Int]) -> Unit {
    match ex {
      effect::Exit::Succeeded(v) => {
        acc[0] = (acc[0] * 31 + v + 1) & 0x7fffffff
        cnt[0] = cnt[0] + 1
        cons_loop(q, acc, cnt, k)
      }
      effect::Exit::Failed(_) => k(effect::Exit::Succeeded(()))
      effect::Exit::Interrupted => k(effect::Exit::Interrupted)
    }
  })
}

pub fn main(world : World) -> Int {
  let rt = effect::Runtime::new_seeded(2026)

  // 1. Bounded Queue + producer/consumer fibers
  let q : effect::Queue[Int] = effect::Queue::bounded(8)
  let q_acc = [0]
  let q_cnt = [0]
  let _ = rt.fork_named("producer", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    prod_loop(q, 0, 200, k)
  })
  let _ = rt.fork_named("consumer", fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    cons_loop(q, q_acc, q_cnt, k)
  })

  // 2. Race + timeout + all_k
  let race_out = [0]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    effect::race_k(
      fn(rk : (effect::Exit[Int]) -> Unit) -> Unit {
        effect::sleep_k(15, fn(_ex : effect::Exit[Unit]) -> Unit {
          rk(effect::Exit::Succeeded(111))
        })
      },
      fn(rk : (effect::Exit[Int]) -> Unit) -> Unit {
        effect::sleep_k(40, fn(_ex : effect::Exit[Unit]) -> Unit {
          rk(effect::Exit::Succeeded(222))
        })
      },
      fn(ex : effect::Exit[Int]) -> Unit {
        match ex {
          effect::Exit::Succeeded(v) => race_out[0] = v
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })

  let all_sum = [0]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    effect::all_k(
      [
        fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
          effect::sleep_k(12, fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(10)) })
        },
        fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
          effect::sleep_k(5, fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(20)) })
        },
        fn(dk : (effect::Exit[Int]) -> Unit) -> Unit {
          effect::sleep_k(8, fn(_ex : effect::Exit[Unit]) -> Unit { dk(effect::Exit::Succeeded(30)) })
        },
      ],
      fn(ex : effect::Exit[Array[Int]]) -> Unit {
        match ex {
          effect::Exit::Succeeded(xs) => {
            let mut s = 0
            for x in xs {
              s = s + x
            }
            all_sum[0] = s
          }
          _ => ()
        }
        k(effect::Exit::Succeeded(()))
      },
    )
  })

  // 3. Priority Scheduler with preemption and boost
  let lane = effect::Scheduler::new(width=2, urgent_room=1)
  let sched_log : Array[String] = []
  let g_idle : effect::Deferred[Unit] = effect::Deferred::new()
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    lane.run_k(
      "idle:0",
      effect::priority_idle(),
      fn(preempt : effect::Preempt, tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        sched_log.push("start:idle")
        effect::race_k(
          fn(rk : (effect::Exit[Bool]) -> Unit) -> Unit {
            g_idle.wait_k(fn(_ex : effect::Exit[Unit]) -> Unit { rk(effect::Exit::Succeeded(false)) })
          },
          fn(rk : (effect::Exit[Bool]) -> Unit) -> Unit {
            preempt.wait_k(fn(_ex : effect::Exit[Unit]) -> Unit { rk(effect::Exit::Succeeded(true)) })
          },
          fn(rex : effect::Exit[Bool]) -> Unit {
            match rex {
              effect::Exit::Succeeded(p) =>
              if p {
                sched_log.push("preempted:idle")
              } else {
                sched_log.push("done:idle")
              }
              _ => ()
            }
            tk(effect::Exit::Succeeded(()))
          },
        )
      },
      k,
    )
  })
  let _ = rt.run_ready()
  lane.prioritize("hot", Some("job:b"), boost=effect::priority_focused())
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    lane.run_k(
      "job:a",
      effect::priority_shown(),
      fn(_p : effect::Preempt, tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        effect::sleep_k(10, fn(_ex : effect::Exit[Unit]) -> Unit {
          sched_log.push("done:a")
          tk(effect::Exit::Succeeded(()))
        })
      },
      k,
    )
  })
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    lane.run_k(
      "job:b",
      effect::priority_background(),
      fn(_p : effect::Preempt, tk : (effect::Exit[Unit]) -> Unit) -> Unit {
        effect::sleep_k(5, fn(_ex : effect::Exit[Unit]) -> Unit {
          sched_log.push("done:b")
          tk(effect::Exit::Succeeded(()))
        })
      },
      k,
    )
  })

  // 4. SimNet + nested scope LIFO finalizers
  let net = effect::SimNet::with_config(rt, 10, 4, 0.0)
  let ep_a = net.endpoint("a")
  let ep_b = net.endpoint("b")
  let pkt_got = [""]
  let _ = rt.fork(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    (ep_b.recv_k)(fn(ex : effect::Exit[effect::Packet]) -> Unit {
      match ex {
        effect::Exit::Succeeded(p) => pkt_got[0] = p.from + "->" + p.to + ":" + p.body
        _ => ()
      }
      k(effect::Exit::Succeeded(()))
    })
  })
  (ep_a.send)("b", "ping")

  let fin_log : Array[String] = []
  let sc = rt.new_scope()
  sc.add_finalizer(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    fin_log.push("outer")
    k(effect::Exit::Succeeded(()))
  })
  let child = sc.child()
  child.add_finalizer(fn(k : (effect::Exit[Unit]) -> Unit) -> Unit {
    fin_log.push("inner")
    k(effect::Exit::Succeeded(()))
  })

  rt.advance(100)
  sc.close_now()
  rt.shutdown()
  let _ = rt.run_ready()
  let (h0, h1, h2, h3, h4, h5) = rt.holding()

  io_println(world, "queue count=" + q_cnt[0].to_string() + " checksum=" + q_acc[0].to_string())
  io_println(world, "race=" + race_out[0].to_string() + " all_sum=" + all_sum[0].to_string())
  io_println(world, "pkt=" + pkt_got[0])
  io_println(world, "sched_len=" + sched_log.length().to_string() + " first=" + sched_log[0] + " last=" + sched_log[sched_log.length() - 1])
  io_println(world, "fin=" + fin_log[0] + "," + fin_log[1])
  io_println(world, "holding=" + h0.to_string() + "," + h1.to_string() + "," + h2.to_string() + "," + h3.to_string() + "," + h4.to_string() + "," + h5.to_string())
  io_println(world, "now=" + rt.now().to_string() + " steps=" + rt.steps.to_string() + " defects=" + rt.defects.length().to_string())
  if h0 == 0 && h1 == 0 && h2 == 0 && h3 == 0 && h4 == 0 && h5 == 0 && rt.defects.length() == 0 {
    0
  } else {
    1
  }
}
