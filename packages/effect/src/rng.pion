// A seeded random (xorshift32): the same seed, the same draws, on every backend.

let u32_mask : Int64 = (1.to_int64() << 32) - 1.to_int64()
let rng_mul : Int64 = (0x9E37.to_int64() << 16) | 0x79B1.to_int64()
let rng_xor : Int64 = (0x9E37.to_int64() << 16) | 0x79B9.to_int64()

/// Seeded xorshift32 PRNG (exact 32-bit unsigned arithmetic via masked Int64).
pub struct Rng {
  mut s : Int64
}

pub fn Rng::new(seed : Int) -> Rng {
  let u = seed.to_int64() & u32_mask
  let mixed = ((u * rng_mul) & u32_mask) ^ rng_xor
  let init = if mixed == 0.to_int64() { 1.to_int64() } else { mixed }
  Rng::{ s: init }
}

/// Next unsigned 32-bit value (in 0..=0xFFFFFFFF).
pub fn Rng::next(self : Rng) -> Int64 {
  let mut x = self.s
  x = (x ^ ((x << 13) & u32_mask)) & u32_mask
  x = (x ^ ((x >> 17) & u32_mask)) & u32_mask
  x = (x ^ ((x << 5) & u32_mask)) & u32_mask
  self.s = x
  x
}

/// In [0, n).
pub fn Rng::below(self : Rng, n : Int) -> Int {
  if n <= 1 {
    return 0
  }
  (self.next() % n.to_int64()).to_int()
}

/// In [lo, hi].
pub fn Rng::between(self : Rng, lo : Int, hi : Int) -> Int {
  lo + self.below(hi - lo + 1)
}

/// True with probability `p`.
pub fn Rng::chance(self : Rng, p : Double) -> Bool {
  ((self.next() >> 8).to_int().to_double() / 16777216.0) < p
}
