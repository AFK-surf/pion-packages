// A seeded random (xorshift32): the same seed, the same draws, on every backend.

/// Seeded xorshift32 PRNG (exact 32-bit unsigned arithmetic via masked Int64).
pub struct Rng {
  mut s : Int64
}

/// Mix a 32-bit seed into a guaranteed non-zero unsigned 32-bit xorshift state (`1..=0xFFFFFFFF`).
#verify
pub fn rng_init_state(seed : Int) -> Int64 {
  let u = seed.to_int64() & 4294967295L
  let mixed = ((u * 2654435761L) & 4294967295L) ^ 2654435769L
  if mixed == 0L { 1L } else { mixed }
}

/// Single xorshift32 transition masked to unsigned 32-bit (`0..=0xFFFFFFFF`).
#verify
pub fn rng_step_u32(s : Int64) -> Int64 {
  let x1 = (s ^ ((s << 13) & 4294967295L)) & 4294967295L
  let x2 = (x1 ^ ((x1 >> 17) & 4294967295L)) & 4294967295L
  (x2 ^ ((x2 << 5) & 4294967295L)) & 4294967295L
}

/// Reduce a non-negative 32-bit draw into `[0, n)` (or `0` when `n <= 1`).
#verify
pub fn rng_below_val(draw : Int64, n : Int) -> Int {
  if n <= 1 {
    return 0
  }
  (draw % n.to_int64()).to_int()
}

pub fn Rng::new(seed : Int) -> Rng {
  Rng::{ s: rng_init_state(seed) }
}

/// Next unsigned 32-bit value (in 0..=0xFFFFFFFF).
pub fn Rng::next(self : Rng) -> Int64 {
  let x = rng_step_u32(self.s)
  self.s = x
  x
}

/// In [0, n).
pub fn Rng::below(self : Rng, n : Int) -> Int {
  if n <= 1 {
    return 0
  }
  rng_below_val(self.next(), n)
}

/// In [lo, hi].
pub fn Rng::between(self : Rng, lo : Int, hi : Int) -> Int {
  lo + self.below(hi - lo + 1)
}

/// True with probability `p`.
pub fn Rng::chance(self : Rng, p : Double) -> Bool {
  ((self.next() >> 8).to_int().to_double() / 16777216.0) < p
}
