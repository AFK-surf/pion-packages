// Pure-Pion circular ring-buffer deque.

/// Ring-buffer double-ended queue with power-of-two capacity growth and unboxed slot storage.
pub struct RingDeque[T] {
  mut buf : Array[T]
  mut cap : Int
  mut head : Int
  mut len : Int
}

pub fn RingDeque::with_capacity[T](initial_cap : Int) -> RingDeque[T] {
  let mut cap = 8
  while cap < initial_cap {
    cap = cap * 2
  }
  RingDeque::{ buf: [], cap, head: 0, len: 0 }
}

pub fn RingDeque::new[T]() -> RingDeque[T] {
  RingDeque::with_capacity(8)
}

pub fn RingDeque::length[T](self : RingDeque[T]) -> Int {
  self.len
}

pub fn RingDeque::is_empty[T](self : RingDeque[T]) -> Bool {
  self.len == 0
}

/// Next capacity for `RingDeque::grow` (minimum 8, otherwise doubled).
#verify
pub fn ring_next_cap(old_cap : Int) -> Int {
  if old_cap == 0 { 8 } else { old_cap * 2 }
}

/// Circular slot index `(head + offset) % cap`.
#verify
pub fn ring_slot_add(head : Int, offset : Int, cap : Int) -> Int {
  (head + offset) % cap
}

/// Previous circular slot index `(head - 1 + cap) % cap`.
#verify
pub fn ring_slot_prev(head : Int, cap : Int) -> Int {
  (head - 1 + cap) % cap
}

fn RingDeque::grow[T](self : RingDeque[T]) -> Unit {
  let old_cap = self.cap
  let new_cap = ring_next_cap(old_cap)
  let next : Array[T] = []
  for i in 0..<self.len {
    let idx = ring_slot_add(self.head, i, old_cap)
    next.push(self.buf[idx])
  }
  self.buf = next
  self.cap = new_cap
  self.head = 0
}

pub fn RingDeque::push_back[T](self : RingDeque[T], item : T) -> Unit {
  if self.len == self.cap {
    self.grow()
  }
  let tail = ring_slot_add(self.head, self.len, self.cap)
  if tail < self.buf.length() {
    self.buf[tail] = item
  } else {
    while self.buf.length() < tail {
      self.buf.push(item)
    }
    self.buf.push(item)
  }
  self.len = self.len + 1
}

pub fn RingDeque::push_front[T](self : RingDeque[T], item : T) -> Unit {
  if self.len == self.cap {
    self.grow()
  }
  if self.buf.length() < self.cap {
    while self.buf.length() < self.cap {
      self.buf.push(item)
    }
  }
  self.head = ring_slot_prev(self.head, self.cap)
  self.buf[self.head] = item
  self.len = self.len + 1
}

fn RingDeque::pop_front_raw[T](self : RingDeque[T]) -> T {
  let item = self.buf[self.head]
  self.len = self.len - 1
  if self.len == 0 {
    if self.buf.length() > 64 {
      self.buf.clear()
    }
    self.head = 0
  } else {
    self.head = ring_slot_add(self.head, 1, self.cap)
  }
  item
}

pub fn RingDeque::pop_front[T](self : RingDeque[T]) -> Option[T] {
  if self.len == 0 {
    return None
  }
  Some(self.pop_front_raw())
}

pub fn RingDeque::pop_back[T](self : RingDeque[T]) -> Option[T] {
  if self.len == 0 {
    return None
  }
  let tail = ring_slot_add(self.head, self.len - 1, self.cap)
  let item = self.buf[tail]
  self.len = self.len - 1
  if self.len == 0 {
    self.buf.clear()
    self.head = 0
  }
  Some(item)
}

fn RingDeque::remove_at[T](self : RingDeque[T], idx : Int) -> Option[T] {
  if idx < 0 || idx >= self.len {
    return None
  }
  if idx == 0 {
    return self.pop_front()
  }
  if idx == self.len - 1 {
    return self.pop_back()
  }
  let cap = self.cap
  let slot = (self.head + idx) % cap
  let item = self.buf[slot]
  let mut i = idx
  while i + 1 < self.len {
    let cur = (self.head + i) % cap
    let nxt = (self.head + i + 1) % cap
    self.buf[cur] = self.buf[nxt]
    i = i + 1
  }
  self.len = self.len - 1
  Some(item)
}

pub fn RingDeque::peek_front[T](self : RingDeque[T]) -> Option[T] {
  if self.len == 0 {
    return None
  }
  Some(self.buf[self.head])
}

pub fn RingDeque::peek_back[T](self : RingDeque[T]) -> Option[T] {
  if self.len == 0 {
    return None
  }
  let tail = (self.head + self.len - 1) % self.cap
  Some(self.buf[tail])
}

pub fn RingDeque::clear[T](self : RingDeque[T]) -> Unit {
  self.buf.clear()
  self.head = 0
  self.len = 0
}
