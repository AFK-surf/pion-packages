// Fiber handle, interruption, shielding, and never.

struct FiberCell[X] {
  mut item : Option[X]
}

/// A fiber: code running beside the code that forked it, in a scope.
pub struct Fiber[X] {
  task : Task
  cell : FiberCell[X]
}

pub fn Fiber::id[X](self : Fiber[X]) -> Int {
  self.task.id
}

/// How it ended, if it has.
pub fn Fiber::poll[X](self : Fiber[X]) -> Option[Exit[X]] {
  match self.task.end {
    End::NotYet => None
    End::Done =>
    match self.cell.item {
      Some(x) => Some(Exit::Succeeded(x))
      None => halt_saying("effect: finished fiber missing value", "effect/fiber.pion:poll")
    }
    End::Raised(e) => Some(Exit::Failed(e))
    End::Cut => Some(Exit::Interrupted)
  }
}

pub fn Fiber::is_done[X](self : Fiber[X]) -> Bool {
  self.task.is_ended()
}

/// Waits for it to end (Effect's Fiber.await).
pub fn Fiber::wait_k[X](self : Fiber[X], k : (Exit[Exit[X]]) -> Unit) -> Unit {
  self.task.await_end_k(fn(ex : Exit[Unit]) -> Unit {
    match ex {
      Exit::Interrupted => k(Exit::Interrupted)
      Exit::Failed(e) => k(Exit::Failed(e))
      Exit::Succeeded(_) =>
      match self.poll() {
        Some(res) => k(Exit::Succeeded(res))
        None => halt_saying("effect: awaited fiber not ended", "effect/fiber.pion:wait_k")
      }
    }
  })
}

/// Waits for its value: its error is returned as Failed(e), its interruption as Failed(Interrupt).
pub fn Fiber::join_k[X](self : Fiber[X], k : (Exit[X]) -> Unit) -> Unit {
  self.wait_k(fn(outer : Exit[Exit[X]]) -> Unit {
    match outer {
      Exit::Interrupted => k(Exit::Interrupted)
      Exit::Failed(e) => k(Exit::Failed(e))
      Exit::Succeeded(inner) =>
      match inner {
        Exit::Succeeded(x) => k(Exit::Succeeded(x))
        Exit::Failed(e) => k(Exit::Failed(e))
        Exit::Interrupted => k(Exit::Failed(EffectError::Interrupt))
      }
    }
  })
}

/// Asks it to stop, without waiting.
pub fn Fiber::interrupt[X](self : Fiber[X]) -> Unit {
  self.task.interrupt()
}

/// Asks it to stop and waits until it has, its finalizers run.
pub fn Fiber::interrupt_and_wait_k[X](self : Fiber[X], k : (Exit[Exit[X]]) -> Unit) -> Unit {
  self.task.interrupt()
  self.wait_k(k)
}

/// Runs `f` where interruption waits: asked to stop meanwhile, the fiber stops right after `f` completes.
pub fn uninterruptible_k[X](f : ((Exit[X]) -> Unit) -> Unit, k : (Exit[X]) -> Unit) -> Unit {
  let t = current_task()
  t.shield = t.shield + 1
  f(fn(res : Exit[X]) -> Unit {
    t.shield = t.shield - 1
    if t.interrupted && t.shield == 0 {
      k(Exit::Interrupted)
    } else {
      k(res)
    }
  })
}

/// The running fiber was asked to stop.
pub fn is_interrupted() -> Bool {
  current_task().interrupted
}

/// Waits forever (Effect.never): only an interruption ends it.
pub fn never_k[X](k : (Exit[X]) -> Unit) -> Unit {
  park_k(
    fn() -> Unit { never_k(k) },
    fn() -> Unit { k(Exit::Interrupted) },
  )
}
