// External host work tracking and settledness diagnostics.

/// Starts waiting on something outside (`what` says what): returns its ticket for `outside_end`.
pub fn Runtime::outside_start(self : Runtime, what : String) -> Int {
  self.tickets = self.tickets + 1
  self.awaited.set(self.tickets, (what, self.now()))
  self.tickets
}

/// Its answer is in (or it was given up).
pub fn Runtime::outside_end(self : Runtime, ticket : Int) -> Unit {
  self.outside_end_wake(ticket, true)
}

/// Its answer is in, optionally waking the runtime.
pub fn Runtime::outside_end_wake(self : Runtime, ticket : Int, wake : Bool) -> Unit {
  match self.awaited.get(ticket) {
    Some((what, _)) => {
      self.awaited.remove(ticket)
      if self.keep_ended {
        self.ended.push((self.ended_n, what))
      }
      self.ended_n = self.ended_n + 1
      if wake {
        (self.waker)()
      }
    }
    None => ()
  }
}

/// How many waits on outside have ended so far: a mark for `outside_ended_since`.
pub fn Runtime::outside_ended(self : Runtime) -> Int {
  self.keep_ended = true
  let n = self.ended_n
  let keep : Array[(Int, String)] = []
  for e in self.ended {
    if e.0 >= n {
      keep.push(e)
    }
  }
  self.ended = keep
  n
}

/// What of outside ended since the mark `n`, oldest first.
pub fn Runtime::outside_ended_since(self : Runtime, n : Int) -> Array[String] {
  let out : Array[String] = []
  for e in self.ended {
    if e.0 >= n {
      out.push(e.1)
    }
  }
  out
}

/// How many are awaited from outside.
pub fn Runtime::awaiting(self : Runtime) -> Int {
  self.awaited.length()
}

/// What is awaited from outside, oldest first: (what, since_ms).
pub fn Runtime::awaited(self : Runtime) -> Array[(String, Int64)] {
  let ks = self.awaited.keys()
  // Sort ticket keys ascending
  for i in 1..<ks.length() {
    let key = ks[i]
    let mut j = i - 1
    while j >= 0 && ks[j] > key {
      ks[j + 1] = ks[j]
      j = j - 1
    }
    ks[j + 1] = key
  }
  let out : Array[(String, Int64)] = []
  for k in ks {
    match self.awaited.get(k) {
      Some((w, since)) => out.push((w, since))
      None => ()
    }
  }
  out
}

/// Waits on something outside as a fiber: `start` asks for it and is given the callback to answer once.
pub fn outside_k[X](
  what : String,
  start : ((X) -> Unit) -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  let rt = current_task().rt
  let d : Deferred[X] = Deferred::new()
  let ticket = rt.outside_start(what)
  start(fn(x : X) -> Unit {
    rt.outside_end(ticket)
    let _ = d.succeed(x)
  })
  d.wait_k(fn(ex : Exit[X]) -> Unit {
    rt.outside_end(ticket)
    k(ex)
  })
}

/// Why it is not settled, said ("" when it is).
pub fn Runtime::unsettled(self : Runtime) -> String {
  let why : Array[String] = []
  if !self.idle() {
    let n = self.ready.length() + self.later_len()
    why.push(n.to_string() + " fibers ready")
  }
  if !self.frame_waiters.is_empty() {
    why.push(self.frame_waiters.count().to_string() + " fibers waiting for a frame")
  }
  for a in self.awaited() {
    why.push("awaiting " + a.0 + " since " + a.1.to_string() + " ms")
  }
  for i in 0..<self.timers.len {
    let tid = self.timers.tids[i]
    if self.is_timer_live(tid) && !self.is_timer_later(tid) {
      let who = match self.timer_who.get(tid) {
        Some(w) => w
        None => ""
      }
      let suffix = if who == "" { "" } else { " (" + who + ")" }
      why.push("a timer at " + self.timers.ats[i].to_string() + " ms" + suffix)
    }
  }
  let sb = StringBuilder::new()
  for i in 0..<why.length() {
    if i > 0 {
      sb.write_byte(59 as Byte) // ';'
      sb.write_byte(32 as Byte) // ' '
    }
    let s = why[i]
    for j in 0..<s.length() {
      sb.write_byte(s.code_unit_at(j) as Byte)
    }
  }
  sb.to_string()
}
