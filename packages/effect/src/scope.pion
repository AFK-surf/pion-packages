// Structured concurrency scopes and finalizers.

struct ScopeState {
  children : Array[Task]
  mut children_len : Int
  mut finalizers : Option[Array[((Exit[Unit]) -> Unit) -> Unit]]
  mut closed : Bool
  report : Bool
  mut all_notify : Bool
  mut all_failed : Bool
  mut all_parent : Option[Task]
}

fn ScopeState::new(report : Bool) -> ScopeState {
  ScopeState::{
    children: [],
    children_len: 0,
    finalizers: None,
    closed: false,
    report,
    all_notify: false,
    all_failed: false,
    all_parent: None,
  }
}

fn ScopeState::finalizers_len(self : ScopeState) -> Int {
  match self.finalizers {
    None => 0
    Some(a) => a.length()
  }
}

fn ScopeState::add_child(self : ScopeState, t : Task) -> Unit {
  let idx = self.children_len
  t.owner_slot = idx
  if idx < self.children.length() {
    self.children[idx] = t
  } else {
    self.children.push(t)
  }
  self.children_len = idx + 1
}

fn ScopeState::remove_child(self : ScopeState, t : Task) -> Unit {
  let idx = t.owner_slot
  let n = self.children_len
  if idx >= 0 && idx < n {
    let last_idx = n - 1
    if idx != last_idx {
      let last = self.children[last_idx]
      self.children[idx] = last
      last.owner_slot = idx
    }
    self.children_len = last_idx
    if last_idx == 0 {
      self.children.clear()
    }
    t.owner_slot = -1
  }
}

/// A scope: what is opened in it (fibers, finalizers, child scopes) ends when it closes.
pub struct EffectScope {
  rt : Runtime
  st : ScopeState
}

fn EffectScope::make(rt : Runtime, report : Bool) -> EffectScope {
  EffectScope::{ rt, st: ScopeState::new(report) }
}

/// A new scope of its own, closed with `close_k` or `close_now`.
pub fn Runtime::new_scope(self : Runtime) -> EffectScope {
  EffectScope::make(self, true)
}

/// A scope closed when this one closes.
pub fn EffectScope::child(self : EffectScope) -> EffectScope {
  let c = EffectScope::make(self.rt, self.st.report)
  self.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit { c.close_k(k) })
  c
}

pub fn EffectScope::is_closed(self : EffectScope) -> Bool {
  self.st.closed
}

/// How many fibers of it are still running.
pub fn EffectScope::running(self : EffectScope) -> Int {
  self.st.children_len
}

/// Starts `f` as a fiber of the scope.
pub fn EffectScope::fork[X](self : EffectScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  self.fork_with(f, "", self.st.report)
}

/// Starts `f` as a named fiber of the scope.
pub fn EffectScope::fork_named[X](self : EffectScope, name : String, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  self.fork_with(f, name, self.st.report)
}

/// Starts `f` as a fiber of the scope whose failure is left for `join` or `wait` alone.
pub fn EffectScope::fork_quiet[X](self : EffectScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  self.fork_with(f, "", false)
}

/// Starts `f` as a named quiet fiber of the scope.
pub fn EffectScope::fork_quiet_named[X](
  self : EffectScope,
  name : String,
  f : ((Exit[X]) -> Unit) -> Unit,
) -> Fiber[X] {
  self.fork_with(f, name, false)
}

/// Starts `f` as a named background fiber of the scope: failures go to `on_error` (never `on_defect`),
/// while interruption ends it as `Interrupted` without calling `on_error`.
pub fn EffectScope::fork_daemon(
  self : EffectScope,
  name : String,
  f : ((Exit[Unit]) -> Unit) -> Unit,
  on_error : (EffectError) -> Unit,
) -> Fiber[Unit] {
  self.fork_quiet_named(name, fn(k : (Exit[Unit]) -> Unit) -> Unit {
    f(fn(ex : Exit[Unit]) -> Unit {
      match ex {
        Exit::Succeeded(_) => k(Exit::Succeeded(()))
        Exit::Interrupted => k(Exit::Interrupted)
        Exit::Failed(e) =>
        match e {
          EffectError::Interrupt =>
          if is_interrupted() {
            k(Exit::Interrupted)
          } else {
            on_error(e)
            k(Exit::Succeeded(()))
          }
          _ => {
            on_error(e)
            k(Exit::Succeeded(()))
          }
        }
      }
    })
  })
}

fn fork_in_scope[X](
  rt : Runtime,
  st : ScopeState,
  f : ((Exit[X]) -> Unit) -> Unit,
  name : String,
  report : Bool,
) -> Fiber[X] {
  let cell : FiberCell[X] = FiberCell::{ item: None }
  let t = rt.alloc_task(name)
  t.set_callback(fn(r : Resume) -> Unit {
    match r {
      Resume::Stop => {
        t.end = End::Cut
        t.clear_state()
        t.finish()
      }
      Resume::Go => {
        f(fn(ex : Exit[X]) -> Unit {
          match ex {
            Exit::Succeeded(x) => {
              cell.item = Some(x)
              match t.end {
                End::NotYet => t.end = End::Done
                _ => ()
              }
            }
            Exit::Failed(e) => t.end = End::Raised(e)
            Exit::Interrupted => t.end = End::Cut
          }
          t.clear_state()
          t.finish()
        })
      }
    }
  })
  rt.live_tasks = rt.live_tasks + 1
  if st.closed {
    rt.make_ready(t)
    t.interrupt()
  } else {
    t.owner = st
    t.set_owner_report(report)
    st.add_child(t)
    rt.make_ready(t)
  }
  Fiber::{ task: t, cell }
}

fn EffectScope::fork_with[X](
  self : EffectScope,
  f : ((Exit[X]) -> Unit) -> Unit,
  name : String,
  report : Bool,
) -> Fiber[X] {
  fork_in_scope(self.rt, self.st, f, name, report)
}

/// Runs `f` when the scope closes; on a closed scope, soon.
pub fn EffectScope::add_finalizer(self : EffectScope, f : ((Exit[Unit]) -> Unit) -> Unit) -> Unit {
  if self.st.closed {
    let _ = self.rt.start("finalizer", f)
  } else {
    match self.st.finalizers {
      Some(a) => a.push(f)
      None => self.st.finalizers = Some([f])
    }
  }
}

/// `acquire`, uninterruptibly, and `release` of what it gave when the scope closes.
pub fn EffectScope::acquire_release_k[X](
  self : EffectScope,
  acquire : ((Exit[X]) -> Unit) -> Unit,
  release : (X, (Exit[Unit]) -> Unit) -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  uninterruptible_k(
    fn(done : (Exit[X]) -> Unit) -> Unit {
      acquire(fn(ex : Exit[X]) -> Unit {
        match ex {
          Exit::Succeeded(x) => {
            self.add_finalizer(fn(fk : (Exit[Unit]) -> Unit) -> Unit { release(x, fk) })
            done(Exit::Succeeded(x))
          }
          Exit::Failed(e) => done(Exit::Failed(e))
          Exit::Interrupted => done(Exit::Interrupted)
        }
      })
    },
    k,
  )
}

fn await_all_kids(kids : Array[Task], idx : Int, done : () -> Unit) -> Unit {
  if idx >= kids.length() {
    done()
    return
  }
  kids[idx].await_end_k(fn(_ex : Exit[Unit]) -> Unit {
    await_all_kids(kids, idx + 1, done)
  })
}

fn run_finalizers_lifo(self : EffectScope, done : () -> Unit) -> Unit {
  match self.st.finalizers {
    None => done()
    Some(a) =>
    match a.pop() {
      None => done()
      Some(f) => {
        f(fn(ex : Exit[Unit]) -> Unit {
          match ex {
            Exit::Failed(e) => self.rt.report(e)
            _ => ()
          }
          run_finalizers_lifo(self, done)
        })
      }
    }
  }
}

/// Closes it: its fibers are interrupted and waited for, then its finalizers run, last first; all uninterruptibly.
pub fn EffectScope::close_k(self : EffectScope, k : (Exit[Unit]) -> Unit) -> Unit {
  if self.st.closed {
    k(exit_ok_unit)
    return
  }
  self.st.closed = true
  if self.st.children_len == 0 && self.st.finalizers_len() == 0 {
    k(exit_ok_unit)
    return
  }
  let t = current_task()
  t.shield = t.shield + 1
  let kids : Array[Task] = []
  for i in 0..<self.st.children_len {
    let child = self.st.children[i]
    if child.id == t.id {
      t.set_interrupted_flag()
    } else {
      kids.push(child)
    }
  }
  for child in kids {
    child.interrupt()
  }
  await_all_kids(kids, 0, fn() -> Unit {
    run_finalizers_lifo(self, fn() -> Unit {
      t.shield = t.shield - 1
      k(exit_ok_unit)
    })
  })
}

/// Closes it from outside any fiber (a host's call): done by a task of its own.
pub fn EffectScope::close_now(self : EffectScope) -> Unit {
  let _ = self.rt.start("close", fn(k : (Exit[Unit]) -> Unit) -> Unit { self.close_k(k) })
}

/// Runs `body` with a scope of its own, closed when it ends however it ends.
pub fn scoped_k[X](body : (EffectScope, (Exit[X]) -> Unit) -> Unit, k : (Exit[X]) -> Unit) -> Unit {
  let s = EffectScope::make(current_task().rt, false)
  body(s, fn(out : Exit[X]) -> Unit {
    s.close_k(fn(_c : Exit[Unit]) -> Unit {
      k(out)
    })
  })
}
