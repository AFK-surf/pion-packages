// Concurrent combinators: race_first, race, all, timeout.

fn first_end_k(tasks : Array[Task], k : (Exit[Int]) -> Unit) -> Unit {
  for i in 0..<tasks.length() {
    if tasks[i].is_ended() {
      k(Exit::Succeeded(i))
      return
    }
  }
  let me = current_task()
  let winner = [-1]
  let ids : Array[(Task, Int)] = []
  for i in 0..<tasks.length() {
    let t = tasks[i]
    let idx = i
    let wid = t.watch(fn() -> Unit {
      if winner[0] < 0 {
        winner[0] = idx
      }
      me.wake()
    })
    ids.push((t, wid))
  }
  first_end_wait(winner, ids, k)
}

fn first_end_wait(
  winner : Array[Int],
  ids : Array[(Task, Int)],
  k : (Exit[Int]) -> Unit,
) -> Unit {
  if winner[0] >= 0 {
    for p in ids {
      p.0.unwatch(p.1)
    }
    k(Exit::Succeeded(winner[0]))
    return
  }
  park_k(
    fn() -> Unit { first_end_wait(winner, ids, k) },
    fn() -> Unit {
      for p in ids {
        p.0.unwatch(p.1)
      }
      k(Exit::Interrupted)
    },
  )
}

/// The first of `a` and `b` to end, success or failure, is the answer; the other is interrupted and waited for.
pub fn race_first_k[X](
  a : ((Exit[X]) -> Unit) -> Unit,
  b : ((Exit[X]) -> Unit) -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  scoped_k(
    fn(s : EffectScope, done : (Exit[X]) -> Unit) -> Unit {
      let fa = s.fork_named("race a", a)
      let fb = s.fork_named("race b", b)
      first_end_k([fa.task, fb.task], fn(ex : Exit[Int]) -> Unit {
        match ex {
          Exit::Interrupted => done(Exit::Interrupted)
          Exit::Failed(e) => done(Exit::Failed(e))
          Exit::Succeeded(idx) => {
            let (w, l) = if idx == 0 { (fa, fb) } else { (fb, fa) }
            l.interrupt_and_wait_k(fn(_lex : Exit[Exit[X]]) -> Unit {
              w.join_k(done)
            })
          }
        }
      })
    },
    k,
  )
}

/// The first of `a` and `b` to succeed; the other is interrupted and waited for. Both failing: `BothFailed(e1, e2)`.
pub fn race_k[X](
  a : ((Exit[X]) -> Unit) -> Unit,
  b : ((Exit[X]) -> Unit) -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  scoped_k(
    fn(s : EffectScope, done : (Exit[X]) -> Unit) -> Unit {
      let fa = s.fork_named("race a", a)
      let fb = s.fork_named("race b", b)
      first_end_k([fa.task, fb.task], fn(ex : Exit[Int]) -> Unit {
        match ex {
          Exit::Interrupted => done(Exit::Interrupted)
          Exit::Failed(e) => done(Exit::Failed(e))
          Exit::Succeeded(idx) => {
            let (w, l) = if idx == 0 { (fa, fb) } else { (fb, fa) }
            match w.poll() {
              Some(wres) =>
              match wres {
                Exit::Succeeded(x) => {
                  l.interrupt_and_wait_k(fn(_lex : Exit[Exit[X]]) -> Unit {
                    done(Exit::Succeeded(x))
                  })
                }
                Exit::Failed(e1) => {
                  l.wait_k(fn(lex : Exit[Exit[X]]) -> Unit {
                    match lex {
                      Exit::Interrupted => done(Exit::Interrupted)
                      Exit::Failed(e) => done(Exit::Failed(e))
                      Exit::Succeeded(inner) =>
                      match inner {
                        Exit::Succeeded(x) => done(Exit::Succeeded(x))
                        Exit::Failed(e2) => done(Exit::Failed(EffectError::BothFailed(e1, e2)))
                        Exit::Interrupted => done(Exit::Failed(e1))
                      }
                    }
                  })
                }
                Exit::Interrupted => l.join_k(done)
              }
              None => l.join_k(done)
            }
          }
        }
      })
    },
    k,
  )
}

fn all_finish[X](
  rt : Runtime,
  st : ScopeState,
  fibers : Array[Fiber[X]],
  me : Task,
  k : (Exit[Array[X]]) -> Unit,
) -> Unit {
  if st.all_failed || st.children_len == 0 {
    st.all_notify = false
    st.all_parent = None
    for i in 0..<fibers.length() {
      match fibers[i].poll() {
        Some(fres) =>
        match fres {
          Exit::Failed(e) => {
            for j in (i + 1)..<fibers.length() {
              match fibers[j].poll() {
                Some(fres2) =>
                match fres2 {
                  Exit::Failed(e2) => fibers[j].task.rt.report(e2)
                  _ => ()
                }
                None => ()
              }
            }
            let s = EffectScope::{ rt, st }
            s.close_k(fn(_c : Exit[Unit]) -> Unit { k(Exit::Failed(e)) })
            return
          }
          Exit::Interrupted => {
            let s = EffectScope::{ rt, st }
            s.close_k(fn(_c : Exit[Unit]) -> Unit { k(Exit::Failed(EffectError::Interrupt)) })
            return
          }
          Exit::Succeeded(_) => ()
        }
        None => ()
      }
    }
    let out : Array[X] = []
    for f in fibers {
      match f.cell.item {
        Some(v) => out.push(v)
        None => halt_saying("effect: all fiber missing value", "effect/race.pion:all_finish")
      }
    }
    if st.children_len == 0 && st.finalizers_len() == 0 {
      st.closed = true
      k(Exit::Succeeded(out))
    } else {
      let s = EffectScope::{ rt, st }
      s.close_k(fn(_c : Exit[Unit]) -> Unit { k(Exit::Succeeded(out)) })
    }
    return
  }
  if me.is_interrupted_flag() && me.shield == 0 {
    st.all_notify = false
    st.all_parent = None
    let s = EffectScope::{ rt, st }
    s.close_k(fn(_c : Exit[Unit]) -> Unit { k(Exit::Interrupted) })
    return
  }
  me.set_callback(fn(r : Resume) -> Unit {
    match r {
      Resume::Go => all_finish(rt, st, fibers, me, k)
      Resume::Stop => {
        st.all_notify = false
        st.all_parent = None
        let s = EffectScope::{ rt, st }
        s.close_k(fn(_c : Exit[Unit]) -> Unit { k(Exit::Interrupted) })
      }
    }
  })
}

/// All of `fs` at once; their values in order. First to fail fails all, others interrupted.
pub fn all_k[X](
  fs : Array[((Exit[X]) -> Unit) -> Unit],
  k : (Exit[Array[X]]) -> Unit,
) -> Unit {
  let me = current_task()
  let rt = me.rt
  let n = fs.length()
  if n == 0 {
    k(Exit::Succeeded([]))
    return
  }
  let st = ScopeState::new(false)
  let fibers : Array[Fiber[X]] = []
  for i in 0..<n {
    let f = fork_in_scope(rt, st, fs[i], "all", false)
    fibers.push(f)
    if f.task.is_ended() {
      match f.task.end {
        End::Done => ()
        _ => st.all_failed = true
      }
    }
  }
  if !st.all_failed && st.children_len > 0 {
    st.all_notify = true
    st.all_parent = Some(me)
  }
  all_finish(rt, st, fibers, me, k)
}

/// `f`'s value, or `None` when it took longer than `ms` (it is interrupted).
pub fn timeout_k[X](
  ms : Int,
  f : ((Exit[X]) -> Unit) -> Unit,
  k : (Exit[Option[X]]) -> Unit,
) -> Unit {
  race_first_k(
    fn(done : (Exit[Option[X]]) -> Unit) -> Unit {
      f(fn(ex : Exit[X]) -> Unit {
        match ex {
          Exit::Succeeded(x) => done(Exit::Succeeded(Some(x)))
          Exit::Failed(e) => done(Exit::Failed(e))
          Exit::Interrupted => done(Exit::Interrupted)
        }
      })
    },
    fn(done : (Exit[Option[X]]) -> Unit) -> Unit {
      sleep_k(ms, fn(ex : Exit[Unit]) -> Unit {
        match ex {
          Exit::Succeeded(_) => done(Exit::Succeeded(None))
          Exit::Failed(e) => done(Exit::Failed(e))
          Exit::Interrupted => done(Exit::Interrupted)
        }
      })
    },
    k,
  )
}
