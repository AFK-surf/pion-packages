// Error and exit outcomes for fibers in the effect runtime.

fn halt_saying[T](msg : String, loc : String) -> T {
  panic(msg + "\n  at " + loc)
}

/// Errors raised by effect primitives or user fibers.
pub enum EffectError {
  /// Joining a fiber that was interrupted.
  Interrupt
  /// A queue that was shut down: no more offers, and takes once it is empty.
  QueueShutdown
  /// Something outside failed (a file, a host call).
  IoError(String)
  /// Both sides of a `race` failed (first failure, second failure).
  BothFailed(EffectError, EffectError)
  /// Custom application error message.
  Custom(String)
}

pub fn effect_error_to_string(self : EffectError) -> String {
  match self {
    EffectError::Interrupt => "Interrupt"
    EffectError::QueueShutdown => "QueueShutdown"
    EffectError::IoError(msg) => "IoError(" + msg + ")"
    EffectError::BothFailed(a, b) =>
    "BothFailed(" + effect_error_to_string(a) + ", " + effect_error_to_string(b) + ")"
    EffectError::Custom(msg) => "Custom(" + msg + ")"
  }
}

pub fn effect_error_eq(self : EffectError, other : EffectError) -> Bool {
  match self {
    EffectError::Interrupt =>
    match other {
      EffectError::Interrupt => true
      _ => false
    }
    EffectError::QueueShutdown =>
    match other {
      EffectError::QueueShutdown => true
      _ => false
    }
    EffectError::IoError(a) =>
    match other {
      EffectError::IoError(b) => a == b
      _ => false
    }
    EffectError::BothFailed(a1, a2) =>
    match other {
      EffectError::BothFailed(b1, b2) => effect_error_eq(a1, b1) && effect_error_eq(a2, b2)
      _ => false
    }
    EffectError::Custom(a) =>
    match other {
      EffectError::Custom(b) => a == b
      _ => false
    }
  }
}

/// How a fiber ended.
pub enum Exit[X] {
  Succeeded(X)
  Failed(EffectError)
  Interrupted
}

pub fn exit_is_succeeded[X](ex : Exit[X]) -> Bool {
  match ex {
    Exit::Succeeded(_) => true
    _ => false
  }
}

pub fn exit_is_failed[X](ex : Exit[X]) -> Bool {
  match ex {
    Exit::Failed(_) => true
    _ => false
  }
}

pub fn exit_is_interrupted[X](ex : Exit[X]) -> Bool {
  match ex {
    Exit::Interrupted => true
    _ => false
  }
}

/// Result of a host callback (`host_call_k`).
pub enum HostOutcome[X] {
  Ok(X)
  Err(EffectError)
}
