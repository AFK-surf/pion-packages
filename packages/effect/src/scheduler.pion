// Priority request lane scheduler with urgent room, background serialization,
// idle preemption (`Preempt`), dynamic prefix boosts (`prioritize`), and
// deterministic slot release on interruption.

#verify
pub fn priority_asked() -> Int { 30 }
#verify
pub fn priority_focused() -> Int { 20 }
#verify
pub fn priority_shown() -> Int { 10 }
#verify
pub fn priority_detail() -> Int { 5 }
#verify
pub fn priority_background() -> Int { 0 }
#verify
pub fn priority_idle() -> Int { -10 }

/// Admission predicate for the priority lane scheduler (`Scheduler::pump`).
#verify
pub fn sched_lane_admits(
  best_p : Int,
  busy : Int,
  width : Int,
  urgent_room : Int,
  foreground : Int,
  above_bg : Bool,
  has_bg_running : Bool,
  above_idle : Bool,
) -> Bool {
  if best_p >= 20 {
    busy < width + urgent_room
  } else if best_p > 0 {
    busy < width
  } else if best_p > -10 {
    busy < width && foreground <= 0 && !above_bg && !has_bg_running
  } else {
    busy <= 0 && foreground <= 0 && !above_idle
  }
}

/// Preemption predicate for `Preempt::is_preempted`.
#verify
pub fn sched_is_preempted(eff_p : Int, foreground : Int, above_bg : Bool) -> Bool {
  eff_p <= -10 && (foreground > 0 || above_bg)
}

struct Waiting {
  key : String
  base : Int
  seq : Int
  go : Deferred[Unit]
  mut granted : Bool
}

struct RunningEntry {
  key : String
  base : Int
}

struct BoostEntry {
  slot : String
  prefix : String
  boost : Int
}

pub struct Scheduler {
  pub width : Int
  pub urgent_room : Int
  waiting : Array[Waiting]
  running : Array[RunningEntry]
  boosts : Array[BoostEntry]
  mut seq : Int
  mut foreground : Int
  mut preempt : Option[Deferred[Unit]]
  mut on_idle_cb : () -> Unit
}

pub fn Scheduler::new(width : Int = 2, urgent_room : Int = 2) -> Scheduler {
  Scheduler::{
    width: width,
    urgent_room: urgent_room,
    waiting: [],
    running: [],
    boosts: [],
    seq: 0,
    foreground: 0,
    preempt: None,
    on_idle_cb: fn() -> Unit {},
  }
}

pub fn Scheduler::on_idle(self : Scheduler, f : () -> Unit) -> Unit {
  self.on_idle_cb = f
}

fn Scheduler::effective(self : Scheduler, key : String, base : Int) -> Int {
  let mut p = base
  for i in 0..<self.boosts.length() {
    let b = self.boosts[i]
    if b.boost > p && key.starts_with(b.prefix) {
      p = b.boost
    }
  }
  p
}

fn Scheduler::is_running_key(self : Scheduler, key : String) -> Bool {
  for i in 0..<self.running.length() {
    if self.running[i].key == key {
      return true
    }
  }
  false
}

fn Scheduler::remove_running_key(self : Scheduler, key : String) -> Unit {
  let n = self.running.length()
  let mut idx = -1
  for i in 0..<n {
    if self.running[i].key == key {
      idx = i
      break
    }
  }
  if idx >= 0 {
    let mut j = idx
    while j + 1 < n {
      self.running[j] = self.running[j + 1]
      j = j + 1
    }
    let _ = self.running.pop()
  }
}

fn Scheduler::remove_waiting_at(self : Scheduler, idx : Int) -> Waiting {
  let picked = self.waiting[idx]
  let n = self.waiting.length()
  let mut j = idx
  while j + 1 < n {
    self.waiting[j] = self.waiting[j + 1]
    j = j + 1
  }
  let _ = self.waiting.pop()
  picked
}

fn Scheduler::remove_waiting_seq(self : Scheduler, seq : Int) -> Unit {
  let mut idx = -1
  for i in 0..<self.waiting.length() {
    if self.waiting[i].seq == seq {
      idx = i
      break
    }
  }
  if idx >= 0 {
    let _ = self.remove_waiting_at(idx)
  }
}

fn Scheduler::above(self : Scheduler, than : Int) -> Bool {
  for i in 0..<self.running.length() {
    let r = self.running[i]
    if self.effective(r.key, r.base) > than {
      return true
    }
  }
  for i in 0..<self.waiting.length() {
    let w = self.waiting[i]
    if self.effective(w.key, w.base) > than {
      return true
    }
  }
  false
}

fn Scheduler::urgent(self : Scheduler) -> Bool {
  self.foreground > 0 || self.above(priority_background())
}

fn Scheduler::preempt_idle(self : Scheduler) -> Unit {
  match self.preempt {
    Some(d) => {
      self.preempt = None
      let _ = d.succeed(())
    }
    None => ()
  }
}

fn Scheduler::pump(self : Scheduler) -> Unit {
  if self.urgent() {
    self.preempt_idle()
  }
  let p_foc = priority_focused()
  let p_bg = priority_background()
  let p_idle = priority_idle()
  while true {
    let mut best = -1
    let mut best_p = 0
    for i in 0..<self.waiting.length() {
      let w = self.waiting[i]
      if self.is_running_key(w.key) {
        continue
      }
      let p = self.effective(w.key, w.base)
      if best < 0 || p > best_p || (p == best_p && w.seq < self.waiting[best].seq) {
        best = i
        best_p = p
      }
    }
    if best < 0 {
      return
    }
    let busy = self.running.length()
    let above_bg = if best_p <= p_bg && best_p > p_idle { self.above(p_bg) } else { false }
    let mut has_bg_running = false
    if best_p <= p_bg && best_p > p_idle {
      for i in 0..<self.running.length() {
        let r = self.running[i]
        if self.effective(r.key, r.base) <= p_bg {
          has_bg_running = true
          break
        }
      }
    }
    let above_idle = if best_p <= p_idle { self.above(p_idle) } else { false }
    if !sched_lane_admits(
      best_p,
      busy,
      self.width,
      self.urgent_room,
      self.foreground,
      above_bg,
      has_bg_running,
      above_idle,
    ) {
      return
    }
    let w = self.remove_waiting_at(best)
    w.granted = true
    self.running.push(RunningEntry::{ key: w.key, base: w.base })
    let _ = w.go.succeed(())
  }
}

pub struct Preempt {
  lane : Scheduler
  key : String
  base : Int
}

pub fn Preempt::is_preempted(self : Preempt) -> Bool {
  let eff = self.lane.effective(self.key, self.base)
  let above_bg = if eff <= priority_idle() && self.lane.foreground <= 0 {
    self.lane.above(priority_background())
  } else {
    false
  }
  sched_is_preempted(eff, self.lane.foreground, above_bg)
}

pub fn Preempt::wait_k(self : Preempt, k : (Exit[Unit]) -> Unit) -> Unit {
  if self.is_preempted() {
    k(Exit::Succeeded(()))
    return
  }
  let d = match self.lane.preempt {
    Some(existing) => existing
    None => {
      let fresh : Deferred[Unit] = Deferred::new()
      self.lane.preempt = Some(fresh)
      fresh
    }
  }
  d.wait_k(fn(ex : Exit[Unit]) -> Unit {
    match ex {
      Exit::Interrupted => k(Exit::Interrupted)
      Exit::Failed(e) => k(Exit::Failed(e))
      Exit::Succeeded(_) => self.wait_k(k)
    }
  })
}

fn Scheduler::leave(self : Scheduler, w : Waiting) -> Unit {
  if w.granted {
    self.remove_running_key(w.key)
  } else {
    self.remove_waiting_seq(w.seq)
  }
  self.pump()
  if self.running.length() == 0 && self.waiting.length() == 0 && self.foreground == 0 {
    let cb = self.on_idle_cb
    cb()
  }
}

pub fn Scheduler::run_k[T](
  self : Scheduler,
  key : String,
  priority : Int,
  task : (Preempt, (Exit[T]) -> Unit) -> Unit,
  k : (Exit[T]) -> Unit,
) -> Unit {
  self.seq += 1
  let w = Waiting::{
    key: key,
    base: priority,
    seq: self.seq,
    go: Deferred::new(),
    granted: false,
  }
  self.waiting.push(w)
  self.pump()
  w.go.wait_k(fn(ex : Exit[Unit]) -> Unit {
    match ex {
      Exit::Interrupted => {
        self.leave(w)
        k(Exit::Interrupted)
      }
      Exit::Failed(e) => {
        self.leave(w)
        k(Exit::Failed(e))
      }
      Exit::Succeeded(_) => {
        if is_interrupted() {
          self.leave(w)
          k(Exit::Interrupted)
          return
        }
        let p = Preempt::{ lane: self, key: key, base: priority }
        task(p, fn(tex : Exit[T]) -> Unit {
          self.leave(w)
          k(tex)
        })
      }
    }
  })
}

pub fn Scheduler::foreground_begin(self : Scheduler) -> () -> Unit {
  self.foreground += 1
  self.preempt_idle()
  let mut ended = false
  fn() -> Unit {
    if ended {
      return
    }
    ended = true
    self.foreground -= 1
    self.pump()
    if self.foreground == 0 && self.running.length() == 0 && self.waiting.length() == 0 {
      let cb = self.on_idle_cb
      cb()
    }
  }
}

pub fn Scheduler::prioritize(
  self : Scheduler,
  slot : String,
  prefix : Option[String],
  boost : Int = 20,
) -> Unit {
  let mut found = -1
  for i in 0..<self.boosts.length() {
    if self.boosts[i].slot == slot {
      found = i
      break
    }
  }
  match prefix {
    Some(p) => {
      let entry = BoostEntry::{ slot: slot, prefix: p, boost: boost }
      if found >= 0 {
        self.boosts[found] = entry
      } else {
        self.boosts.push(entry)
      }
    }
    None =>
    if found >= 0 {
      let n = self.boosts.length()
      let mut j = found
      while j + 1 < n {
        self.boosts[j] = self.boosts[j + 1]
        j = j + 1
      }
      let _ = self.boosts.pop()
    }
  }
  self.pump()
}

pub fn Scheduler::queued(self : Scheduler, key : String) -> Bool {
  if self.is_running_key(key) {
    return true
  }
  for i in 0..<self.waiting.length() {
    if self.waiting[i].key == key {
      return true
    }
  }
  false
}

pub fn Scheduler::busy(self : Scheduler) -> Bool {
  self.running.length() > 0 || self.waiting.length() > 0
}

pub fn Scheduler::pending(self : Scheduler) -> Array[String] {
  let out : Array[String] = []
  for i in 0..<self.running.length() {
    let r = self.running[i]
    out.push(r.key + "@" + self.effective(r.key, r.base).to_string() + " running")
  }
  for i in 0..<self.waiting.length() {
    let w = self.waiting[i]
    out.push(w.key + "@" + self.effective(w.key, w.base).to_string())
  }
  out
}
