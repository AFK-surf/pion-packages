// Comprehensive unit tests for packages/effect.

fn ended_str(f : Fiber[String]) -> String {
  match f.poll() {
    None => "running"
    Some(res) =>
    match res {
      Exit::Succeeded(x) => "ok " + x
      Exit::Failed(e) => "failed " + effect_error_to_string(e)
      Exit::Interrupted => "interrupted"
    }
  }
}

fn ended_unit(f : Fiber[Unit]) -> String {
  match f.poll() {
    None => "running"
    Some(res) =>
    match res {
      Exit::Succeeded(_) => "ok ()"
      Exit::Failed(e) => "failed " + effect_error_to_string(e)
      Exit::Interrupted => "interrupted"
    }
  }
}

fn ended_bool(f : Fiber[Bool]) -> String {
  match f.poll() {
    None => "running"
    Some(res) =>
    match res {
      Exit::Succeeded(b) => if b { "ok true" } else { "ok false" }
      Exit::Failed(e) => "failed " + effect_error_to_string(e)
      Exit::Interrupted => "interrupted"
    }
  }
}

fn ended_int(f : Fiber[Int]) -> String {
  match f.poll() {
    None => "running"
    Some(res) =>
    match res {
      Exit::Succeeded(x) => "ok " + x.to_string()
      Exit::Failed(e) => "failed " + effect_error_to_string(e)
      Exit::Interrupted => "interrupted"
    }
  }
}

fn assert_holding_zero(rt : Runtime, label : String) -> Unit {
  let (a, b, c, d, e, f) = rt.holding()
  debug_assert(a == 0 && b == 0 && c == 0 && d == 0 && e == 0 && f == 0, label)
}

test "RingDeque push/pop wraparound and growth" {
  let dq : RingDeque[Int] = RingDeque::with_capacity(4)
  debug_assert(dq.is_empty() && dq.length() == 0, "initially empty")
  for i in 0..<20 {
    dq.push_back(i)
  }
  debug_assert(dq.length() == 20, "grew to 20")
  for i in 0..<10 {
    match dq.pop_front() {
      Some(v) => debug_assert(v == i, "fifo pop_front")
      None => debug_assert(false, "expected value")
    }
  }
  dq.push_front(99)
  match dq.peek_front() {
    Some(v) => debug_assert(v == 99, "peek_front 99")
    None => debug_assert(false, "expected 99")
  }
  match dq.pop_front() {
    Some(v) => debug_assert(v == 99, "pop_front 99")
    None => debug_assert(false, "expected 99")
  }
  match dq.pop_back() {
    Some(v) => debug_assert(v == 19, "pop_back 19")
    None => debug_assert(false, "expected 19")
  }
  dq.clear()
  debug_assert(dq.is_empty() && dq.pop_front().is_none(), "cleared")
}

test "a task made ready between frames at the last seq, no timer: the frame runs it once" {
  let rt = Runtime::new()
  rt.seq = 2147483647 - 1
  let ran : Array[Int64] = []
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    ran.push(now())
    k(Exit::Succeeded(()))
  })
  rt.frame(16.to_int64())
  debug_assert(ran.length() == 1 && ran[0] == 0.to_int64(), "ran once at t=0")
  debug_assert(rt.idle(), "runtime idle")
}

test "fork_quiet: a failure is left to join and wait, never on_defect" {
  let rt = Runtime::new()
  let s = rt.new_scope()
  let bad : Fiber[Int] = s.fork_quiet_named("bad", fn(k : (Exit[Int]) -> Unit) -> Unit {
    k(Exit::Failed(EffectError::IoError("broken")))
  })
  let hung : Fiber[Int] = s.fork_quiet_named("hung", fn(k : (Exit[Int]) -> Unit) -> Unit {
    never_k(k)
  })
  let waited = rt.fork(fn(k : (Exit[String]) -> Unit) -> Unit {
    bad.wait_k(fn(ex : Exit[Exit[Int]]) -> Unit {
      match ex {
        Exit::Succeeded(inner) =>
        match inner {
          Exit::Failed(err) =>
          match err {
            EffectError::IoError(m) => k(Exit::Succeeded("wait failed: " + m))
            _ => k(Exit::Succeeded("wait: other"))
          }
          _ => k(Exit::Succeeded("wait: other"))
        }
        _ => k(Exit::Succeeded("wait: other"))
      }
    })
  })
  let joined = rt.fork(fn(k : (Exit[String]) -> Unit) -> Unit {
    bad.join_k(fn(ex : Exit[Int]) -> Unit {
      match ex {
        Exit::Failed(err) =>
        match err {
          EffectError::IoError(m) => k(Exit::Succeeded("join raised: " + m))
          e => k(Exit::Succeeded("join raised other: " + effect_error_to_string(e)))
        }
        Exit::Succeeded(got) => k(Exit::Succeeded("join returned " + got.to_string()))
        Exit::Interrupted => k(Exit::Interrupted)
      }
    })
  })
  let _ = rt.run_ready()
  debug_assert(rt.defects.length() == 0, "no defects")
  debug_assert(ended_str(waited) == "ok wait failed: broken", "waited saw error")
  debug_assert(ended_str(joined) == "ok join raised: broken", "joined saw error")
  debug_assert(ended_int(hung) == "running", "hung still running")
  s.close_now()
  let _ = rt.run_ready()
  debug_assert(ended_int(hung) == "interrupted", "hung interrupted")
  debug_assert(s.running() == 0, "scope empty")
  rt.shutdown()
  let _ = rt.run_ready()
  debug_assert(rt.defects.length() == 0, "no defects after shutdown")
  assert_holding_zero(rt, "holding zero after shutdown")
}

test "Runtime::fork_quiet: a failure on the root scope is not a defect" {
  let rt = Runtime::new()
  let bad : Fiber[Unit] = rt.fork_quiet(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    k(Exit::Failed(EffectError::IoError("broken")))
  })
  let _ = rt.run_ready()
  debug_assert(rt.defects.length() == 0, "quiet root fork not defect")
  debug_assert(ended_unit(bad) == "failed IoError(broken)", "bad failed")
  let told : Fiber[Unit] = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    k(Exit::Failed(EffectError::IoError("told")))
  })
  let _ = rt.run_ready()
  debug_assert(ended_unit(told) == "failed IoError(told)", "told failed")
  debug_assert(rt.defects.length() == 1, "plain fork reports defect")
  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero")
}

test "fork_daemon: a failure goes to on_error, never on_defect" {
  let rt = Runtime::new()
  let errors : Array[String] = []
  let d = rt.fork_daemon(
    "pump",
    fn(k : (Exit[Unit]) -> Unit) -> Unit {
      sleep_k(10, fn(ex : Exit[Unit]) -> Unit {
        match ex {
          Exit::Succeeded(_) => k(Exit::Failed(EffectError::IoError("broken")))
          other => k(other)
        }
      })
    },
    fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
  )
  rt.advance(10)
  debug_assert(errors.length() == 1, "on_error called once")
  debug_assert(rt.defects.length() == 0, "no defects")
  debug_assert(ended_unit(d) == "ok ()", "daemon ended ok")
  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero")
}

test "fork_daemon: interrupted as it sleeps, it ends interrupted without on_error" {
  let rt = Runtime::new()
  let errors : Array[String] = []
  let s = rt.new_scope()
  let by_hand = s.fork_daemon(
    "by hand",
    fn(k : (Exit[Unit]) -> Unit) -> Unit { sleep_k(1000, k) },
    fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
  )
  let by_close = s.fork_daemon(
    "by close",
    fn(k : (Exit[Unit]) -> Unit) -> Unit { sleep_k(1000, k) },
    fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
  )
  rt.advance(10)
  let stopper = rt.fork(fn(k : (Exit[Bool]) -> Unit) -> Unit {
    by_hand.interrupt_and_wait_k(fn(ex : Exit[Exit[Unit]]) -> Unit {
      match ex {
        Exit::Succeeded(inner) =>
        match inner {
          Exit::Interrupted => k(Exit::Succeeded(true))
          _ => k(Exit::Succeeded(false))
        }
        _ => k(Exit::Succeeded(false))
      }
    })
  })
  let _ = rt.run_ready()
  debug_assert(ended_bool(stopper) == "ok true", "stopper ok")
  debug_assert(ended_unit(by_hand) == "interrupted", "by_hand interrupted")
  debug_assert(ended_unit(by_close) == "running", "by_close still running")
  s.close_now()
  let _ = rt.run_ready()
  debug_assert(ended_unit(by_close) == "interrupted", "by_close interrupted")
  debug_assert(errors.length() == 0 && rt.defects.length() == 0, "no errors/defects")
  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero")
}

test "fork_daemon: closed while it joins a child, over 30 seeds" {
  for_seeds(30, fn(seed : Int) -> Option[String] {
    let rt = Runtime::new_seeded(seed)
    let errors : Array[String] = []
    let s = rt.new_scope()
    let child : Fiber[Unit] = s.fork_quiet_named("child", fn(k : (Exit[Unit]) -> Unit) -> Unit {
      never_k(k)
    })
    let plain = s.fork_daemon(
      "plain",
      fn(k : (Exit[Unit]) -> Unit) -> Unit { child.join_k(k) },
      fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
    )
    let shielded_child : Fiber[Unit] = s.fork_quiet_named(
      "shielded child",
      fn(k : (Exit[Unit]) -> Unit) -> Unit { never_k(k) },
    )
    let shielded = s.fork_daemon(
      "shielded",
      fn(k : (Exit[Unit]) -> Unit) -> Unit {
        uninterruptible_k(fn(ik : (Exit[Unit]) -> Unit) -> Unit { shielded_child.join_k(ik) }, k)
      },
      fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
    )
    rt.advance(5)
    s.close_now()
    let _ = rt.run_ready()
    if ended_unit(child) != "interrupted" || ended_unit(shielded_child) != "interrupted" ||
    ended_unit(plain) != "interrupted" || ended_unit(shielded) != "interrupted" {
      return Some("expected all interrupted")
    }
    if errors.length() != 0 || rt.defects.length() != 0 {
      return Some("unexpected errors or defects on scope close")
    }
    let other = rt.new_scope()
    let cut : Fiber[Unit] = other.fork_quiet_named("cut", fn(k : (Exit[Unit]) -> Unit) -> Unit {
      never_k(k)
    })
    let kept = rt.fork_daemon(
      "kept",
      fn(k : (Exit[Unit]) -> Unit) -> Unit { cut.join_k(k) },
      fn(e : EffectError) -> Unit { errors.push(effect_error_to_string(e)) },
    )
    rt.advance(5)
    cut.interrupt()
    let _ = rt.run_ready()
    if errors.length() != 1 || errors[0] != "Interrupt" || ended_unit(kept) != "ok ()" {
      return Some("kept daemon should report Interrupt")
    }
    other.close_now()
    rt.shutdown()
    let _ = rt.run_ready()
    let (a, b, c, d, e, f) = rt.holding()
    if a != 0 || b != 0 || c != 0 || d != 0 || e != 0 || f != 0 {
      return Some("leaked holding")
    }
    None
  })
}

test "Queue bounded backpressure, shutdown, and Semaphore permits" {
  let rt = Runtime::new()
  let q : Queue[Int] = Queue::bounded(1)
  debug_assert(q.try_offer(10), "first fits")
  debug_assert(!q.try_offer(20), "full rejects try_offer")
  let offered = [false]
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    q.offer_k(20, fn(ex : Exit[Unit]) -> Unit {
      offered[0] = exit_is_succeeded(ex)
      k(ex)
    })
  })
  let _ = rt.run_ready()
  debug_assert(!offered[0], "putter parked")
  match q.try_take() {
    Some(v) => debug_assert(v == 10, "took 10")
    None => debug_assert(false, "expected 10")
  }
  let _ = rt.run_ready()
  debug_assert(offered[0] && q.size() == 1, "putter resumed and enqueued 20")
  q.shutdown()
  match q.try_take() {
    Some(v) => debug_assert(v == 20, "drain remaining 20 after shutdown")
    None => debug_assert(false, "expected 20")
  }
  let after_shut = rt.fork_quiet(fn(k : (Exit[Int]) -> Unit) -> Unit { q.take_k(k) })
  let _ = rt.run_ready()
  debug_assert(ended_int(after_shut) == "failed QueueShutdown", "shutdown take fails")

  let sem = Semaphore::new(1)
  let log : Array[String] = []
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    sem.with_permit_k(
      fn(dk : (Exit[Unit]) -> Unit) -> Unit {
        log.push("a:in")
        sleep_k(10, fn(ex : Exit[Unit]) -> Unit {
          log.push("a:out")
          dk(ex)
        })
      },
      k,
    )
  })
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    sem.with_permit_k(
      fn(dk : (Exit[Unit]) -> Unit) -> Unit {
        log.push("b:in")
        dk(Exit::Succeeded(()))
      },
      k,
    )
  })
  let _ = rt.run_ready()
  debug_assert(log.length() == 1 && log[0] == "a:in", "b waiting for permit")
  rt.advance(10)
  debug_assert(log.length() == 3 && log[1] == "a:out" && log[2] == "b:in", "b ran after a released")
  debug_assert(sem.available() == 1, "permit restored")
}

test "race, all, timeout, outside, SimNet and SimFiles" {
  let rt = Runtime::new_seeded(42)
  // timeout
  let fast = rt.fork(fn(k : (Exit[Option[Int]]) -> Unit) -> Unit {
    timeout_k(50, fn(dk : (Exit[Int]) -> Unit) -> Unit {
      sleep_k(10, fn(_ex : Exit[Unit]) -> Unit { dk(Exit::Succeeded(7)) })
    }, k)
  })
  let slow = rt.fork(fn(k : (Exit[Option[Int]]) -> Unit) -> Unit {
    timeout_k(10, fn(dk : (Exit[Int]) -> Unit) -> Unit {
      sleep_k(50, fn(_ex : Exit[Unit]) -> Unit { dk(Exit::Succeeded(9)) })
    }, k)
  })
  rt.advance(60)
  let mut fast_ok = false
  match fast.poll() {
    Some(res) =>
    match res {
      Exit::Succeeded(opt) =>
      match opt {
        Some(v) => fast_ok = v == 7
        None => ()
      }
      _ => ()
    }
    None => ()
  }
  debug_assert(fast_ok, "fast succeeded")
  let mut slow_ok = false
  match slow.poll() {
    Some(res) =>
    match res {
      Exit::Succeeded(opt) =>
      match opt {
        None => slow_ok = true
        Some(_) => ()
      }
      _ => ()
    }
    None => ()
  }
  debug_assert(slow_ok, "slow timed out")

  // all_k preserves order
  let all_f = rt.fork(fn(k : (Exit[Array[Int]]) -> Unit) -> Unit {
    all_k(
      [
        fn(dk : (Exit[Int]) -> Unit) -> Unit {
          sleep_k(20, fn(_ex : Exit[Unit]) -> Unit { dk(Exit::Succeeded(1)) })
        },
        fn(dk : (Exit[Int]) -> Unit) -> Unit {
          sleep_k(5, fn(_ex : Exit[Unit]) -> Unit { dk(Exit::Succeeded(2)) })
        },
      ],
      k,
    )
  })
  rt.advance(25)
  let mut all_ok = false
  match all_f.poll() {
    Some(res) =>
    match res {
      Exit::Succeeded(xs) => all_ok = xs.length() == 2 && xs[0] == 1 && xs[1] == 2
      _ => ()
    }
    None => ()
  }
  debug_assert(all_ok, "all order")

  // outside tracking
  let mark = rt.outside_ended()
  let ticket = rt.outside_start("image 1 a.png")
  debug_assert(rt.awaiting() == 1, "awaiting 1")
  debug_assert(rt.unsettled().contains("image 1 a.png"), "unsettled names ticket")
  rt.outside_end(ticket)
  debug_assert(rt.awaiting() == 0, "awaiting 0")
  let ended_list = rt.outside_ended_since(mark)
  debug_assert(ended_list.length() == 1 && ended_list[0] == "image 1 a.png", "ended since mark")

  // SimNet + SimFiles
  let net = SimNet::with_config(rt, 15, 5, 0.0)
  let ep_a = net.endpoint("a")
  let ep_b = net.endpoint("b")
  let got_pkt = [""]
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    (ep_b.recv_k)(fn(ex : Exit[Packet]) -> Unit {
      match ex {
        Exit::Succeeded(p) => got_pkt[0] = p.from + ":" + p.body
        _ => ()
      }
      k(Exit::Succeeded(()))
    })
  })
  (ep_a.send)("b", "hello")
  rt.advance(30)
  debug_assert(got_pkt[0] == "a:hello", "simnet delivered")

  let sf = SimFiles::new(rt)
  let files = sf.files()
  let read_back = [""]
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    (files.write_k)("k.txt", "abc".to_bytes(), fn(_ex : Exit[Unit]) -> Unit {
      (files.read_k)("k.txt", fn(rex : Exit[Option[Bytes]]) -> Unit {
        match rex {
          Exit::Succeeded(opt) =>
          match opt {
            Some(bs) => read_back[0] = bs.length().to_string()
            None => ()
          }
          _ => ()
        }
        k(Exit::Succeeded(()))
      })
    })
  })
  rt.advance(10)
  debug_assert(read_back[0] == "3", "simfiles read/write")

  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "final holding zero")
}

// --- Additional boundary & edge-case tests ---

test "nested multi-level EffectScope cancellation and LIFO finalizers" {
  let rt = Runtime::new()
  let order : Array[String] = []
  let parent = rt.new_scope()
  parent.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    order.push("parent:f1")
    k(Exit::Succeeded(()))
  })
  let child = parent.child()
  child.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    order.push("child:f1")
    k(Exit::Succeeded(()))
  })
  let grand = child.child()
  grand.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    order.push("grand:f1")
    k(Exit::Succeeded(()))
  })
  grand.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    order.push("grand:f2")
    k(Exit::Succeeded(()))
  })
  parent.add_finalizer(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    order.push("parent:f2")
    k(Exit::Succeeded(()))
  })
  let fg : Fiber[Unit] = grand.fork_quiet(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    never_k(k)
  })
  let fc : Fiber[Unit] = child.fork_quiet(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    never_k(k)
  })
  let fp : Fiber[Unit] = parent.fork_quiet(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    never_k(k)
  })
  let _ = rt.run_ready()
  debug_assert(ended_unit(fg) == "running" && ended_unit(fc) == "running" && ended_unit(fp) == "running", "all running")
  parent.close_now()
  let _ = rt.run_ready()
  debug_assert(ended_unit(fg) == "interrupted", "grand fiber interrupted")
  debug_assert(ended_unit(fc) == "interrupted", "child fiber interrupted")
  debug_assert(ended_unit(fp) == "interrupted", "parent fiber interrupted")
  debug_assert(parent.is_closed() && child.is_closed() && grand.is_closed(), "all scopes closed")
  // LIFO order on parent: parent:f2 -> child.close (grand.close -> grand:f2, grand:f1 -> child:f1) -> parent:f1
  debug_assert(order.length() == 5, "5 finalizers ran")
  debug_assert(order[0] == "parent:f2", "lifo 0")
  debug_assert(order[1] == "grand:f2", "lifo 1")
  debug_assert(order[2] == "grand:f1", "lifo 2")
  debug_assert(order[3] == "child:f1", "lifo 3")
  debug_assert(order[4] == "parent:f1", "lifo 4")
  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero after nested scope close")
}

test "Semaphore and Queue wakeup cancellation prevents permit and item leaks" {
  let rt = Runtime::new()
  // Semaphore: holder releases, waiter1 is interrupted before acquiring, waiter2 must still get permit
  let sem = Semaphore::new(1)
  debug_assert(sem.try_acquire(), "initial acquire")
  let w1 = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    sem.with_permit_k(fn(dk : (Exit[Unit]) -> Unit) -> Unit { dk(Exit::Succeeded(())) }, k)
  })
  let got_w2 = [false]
  let w2 = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    sem.with_permit_k(fn(dk : (Exit[Unit]) -> Unit) -> Unit {
      got_w2[0] = true
      dk(Exit::Succeeded(()))
    }, k)
  })
  let _ = rt.run_ready()
  // Release and interrupt w1 in the same turn before running ready tasks
  sem.release()
  w1.interrupt()
  let _ = rt.run_ready()
  debug_assert(ended_unit(w1) == "interrupted", "w1 interrupted")
  debug_assert(ended_unit(w2) == "ok ()" && got_w2[0], "w2 acquired permit")
  debug_assert(sem.available() == 1, "no permit leak")

  // Queue: taker1 is interrupted in same turn item is offered; taker2 must receive the item
  let q : Queue[Int] = Queue::unbounded()
  let t1 = rt.fork(fn(k : (Exit[Int]) -> Unit) -> Unit { q.take_k(k) })
  let t2 = rt.fork(fn(k : (Exit[Int]) -> Unit) -> Unit { q.take_k(k) })
  let _ = rt.run_ready()
  debug_assert(q.try_offer(42), "offer 42")
  t1.interrupt()
  let _ = rt.run_ready()
  debug_assert(ended_int(t1) == "interrupted", "t1 interrupted")
  debug_assert(ended_int(t2) == "ok 42", "t2 got 42 without leak")
  debug_assert(q.size() == 0, "queue empty")

  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero after sem/queue cancel")
}

test "race_k interrupts loser immediately and handles BothFailed" {
  let rt = Runtime::new()
  let loser_cleaned = [false]
  let winner = rt.fork(fn(k : (Exit[Int]) -> Unit) -> Unit {
    race_k(
      fn(rk : (Exit[Int]) -> Unit) -> Unit {
        sleep_k(10, fn(_ex : Exit[Unit]) -> Unit { rk(Exit::Succeeded(100)) })
      },
      fn(rk : (Exit[Int]) -> Unit) -> Unit {
        scoped_k(
          fn(s : EffectScope, sk : (Exit[Int]) -> Unit) -> Unit {
            s.add_finalizer(fn(fk : (Exit[Unit]) -> Unit) -> Unit {
              loser_cleaned[0] = true
              fk(Exit::Succeeded(()))
            })
            sleep_k(500, fn(ex : Exit[Unit]) -> Unit {
              match ex {
                Exit::Succeeded(_) => sk(Exit::Succeeded(200))
                Exit::Interrupted => sk(Exit::Interrupted)
                Exit::Failed(e) => sk(Exit::Failed(e))
              }
            })
          },
          rk,
        )
      },
      k,
    )
  })
  rt.advance(10)
  debug_assert(ended_int(winner) == "ok 100", "winner finished at t=10")
  debug_assert(loser_cleaned[0], "loser interrupted and finalizer ran before race returned")

  // BothFailed when both branches fail
  let both = rt.fork_quiet(fn(k : (Exit[Int]) -> Unit) -> Unit {
    race_k(
      fn(rk : (Exit[Int]) -> Unit) -> Unit {
        sleep_k(5, fn(_ex : Exit[Unit]) -> Unit { rk(Exit::Failed(EffectError::Custom("e1"))) })
      },
      fn(rk : (Exit[Int]) -> Unit) -> Unit {
        sleep_k(15, fn(_ex : Exit[Unit]) -> Unit { rk(Exit::Failed(EffectError::Custom("e2"))) })
      },
      k,
    )
  })
  rt.advance(20)
  debug_assert(ended_int(both) == "failed BothFailed(Custom(e1), Custom(e2))", "both failed")

  rt.shutdown()
  let _ = rt.run_ready()
  assert_holding_zero(rt, "holding zero after race")
}

test "Runtime::live with injected clock, on_wake, on_timer, and host_call_k cancel" {
  let clock = [1000.to_int64()]
  let rt = Runtime::live(fn() -> Int64 { clock[0] })
  let wakes = [0]
  let timer_ats : Array[Int64] = []
  rt.on_wake(fn() -> Unit { wakes[0] = wakes[0] + 1 })
  rt.on_timer(fn(at : Int64) -> Unit { timer_ats.push(at) })

  let done = [false]
  let _ = rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    sleep_k(25, fn(ex : Exit[Unit]) -> Unit {
      done[0] = exit_is_succeeded(ex)
      k(ex)
    })
  })
  debug_assert(wakes[0] >= 1, "on_wake called on fork")
  rt.tick()
  debug_assert(!done[0], "not due at 1000")
  clock[0] = 1025.to_int64()
  rt.tick()
  debug_assert(done[0], "fired at 1025")

  let after_fired = [false]
  rt.after(50, fn() -> Unit { after_fired[0] = true })
  debug_assert(timer_ats.length() == 1 && timer_ats[0] == 1075.to_int64(), "on_timer notified")
  clock[0] = 1075.to_int64()
  rt.tick()
  debug_assert(after_fired[0], "after timer fired at 1075")

  // host_call_k cancel invoked when interrupted before completion
  let cancelled = [false]
  let hc : Fiber[Int] = rt.fork(fn(k : (Exit[Int]) -> Unit) -> Unit {
    host_call_k(
      fn(_cb : (HostOutcome[Int]) -> Unit) -> Unit { () },
      fn() -> Unit { cancelled[0] = true },
      k,
    )
  })
  rt.tick()
  hc.interrupt()
  rt.tick()
  debug_assert(cancelled[0] && ended_int(hc) == "interrupted", "host_call_k cancelled")

  rt.shutdown()
  rt.tick()
  assert_holding_zero(rt, "holding zero on live runtime")
}
