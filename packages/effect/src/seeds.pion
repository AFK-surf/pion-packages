// Deterministic seed iteration for simulated tests.

/// The seeds a simulated test runs: 1 to `count`, or only `override_seed` when given.
pub fn seeds_with(count : Int, override_seed : Option[Int]) -> Array[Int] {
  match override_seed {
    Some(s) => [s]
    None => {
      let out : Array[Int] = []
      for i in 0..<count {
        out.push(i + 1)
      }
      out
    }
  }
}

/// The seeds 1 to `count`.
pub fn seeds(count : Int) -> Array[Int] {
  seeds_with(count, None)
}

/// Runs `run` once per seed; if a seed returns `Some(err)`, halts naming the seed and replay instruction.
pub fn for_seeds_with(
  count : Int,
  override_seed : Option[Int],
  run : (Int) -> Option[String],
) -> Unit {
  let ss = seeds_with(count, override_seed)
  for s in ss {
    match run(s) {
      Some(err) => {
        let _ : Unit = halt_saying(
          "seed " + s.to_string() + ": " + err + "\n  replay: SEED=" + s.to_string() + " (the same run, step for step)",
          "effect/seeds.pion:for_seeds_with",
        )
      }
      None => ()
    }
  }
}

/// Runs `run` once per seed in 1..=count.
pub fn for_seeds(count : Int, run : (Int) -> Option[String]) -> Unit {
  for_seeds_with(count, None, run)
}
