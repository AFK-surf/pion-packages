// Cooperative single-threaded fiber & timer scheduler.

enum Resume {
  Go
  Stop
}

enum End {
  NotYet
  Done
  Raised(EffectError)
  Cut
}

let exit_ok_unit : Exit[Unit] = Exit::Succeeded(())
let exit_interrupted_unit : Exit[Unit] = Exit::Interrupted
let noop_cb : (Resume) -> Unit = fn(_r : Resume) -> Unit { () }
let noop_unit_k : (Exit[Unit]) -> Unit = fn(_ex : Exit[Unit]) -> Unit { () }
let noop_w : () -> Unit = fn() -> Unit { () }

// Task.flags bit layout:
//   bits 0..2 (mask 7): state_kind (0=Idle, 1=Callback, 2=Paused, 3=Sleeping)
//   bit 3 (8):          interrupted
//   bit 4 (16):         queued
//   bit 5 (32):         owner_report

/// A task: the code of one fiber, run by the scheduler between suspensions.
struct Task {
  id : Int
  rt : Runtime
  name : String
  /// Packed flags: state_kind (0..2), interrupted (3), queued (4), owner_report (5).
  mut flags : Int
  mut shield : Int
  mut cb : (Resume) -> Unit
  mut unit_k : (Exit[Unit]) -> Unit
  mut sleep_at : Int64
  /// Packed (sleep_seq << 32) | (sleep_tid & 0xffffffff).
  mut sleep_key : Int64
  mut end : End
  /// When it became ready: a frame's turn runs it at that moment, in its place among timers due by then.
  mut since : Int64
  /// Packed (event << 32) | (seq & 0xffffffff) for tasks made ready between frames.
  mut later_meta : Int64
  /// Direct owning scope (owned iff owner_slot >= 0; eliminates per-fiber scope watcher closure & Option/Map alloc).
  mut owner : ScopeState
  mut owner_slot : Int
  /// Inline single-slot watcher + lazy overflow map (0/1 watchers = zero Map/Option alloc).
  mut first_w_id : Int
  mut first_w : () -> Unit
  mut extra_watchers : Option[Map[Int, () -> Unit]]
}

/// Strict lexicographic ordering `(at, seq)` for `TimerHeap`.
#verify
pub fn timer_before(at1 : Int64, seq1 : Int, at2 : Int64, seq2 : Int) -> Bool {
  at1 < at2 || (at1 == at2 && seq1 < seq2)
}

/// Parent index in a 0-indexed binary min-heap (`(i - 1) / 2`).
#verify
pub fn heap_parent(i : Int) -> Int {
  (i - 1) / 2
}

/// Left child index in a 0-indexed binary min-heap (`2 * i + 1`).
#verify
pub fn heap_left(i : Int) -> Int {
  2 * i + 1
}

/// Right child index in a 0-indexed binary min-heap (`2 * i + 2`).
#verify
pub fn heap_right(i : Int) -> Int {
  2 * i + 2
}

/// Whether `TimerHeap::push` should swap child `(cur_at, cur_seq)` above parent `(par_at, par_seq)`.
#verify
pub fn heap_sift_up_should_swap(
  cur_at : Int64,
  cur_seq : Int,
  par_at : Int64,
  par_seq : Int,
) -> Bool {
  timer_before(cur_at, cur_seq, par_at, par_seq)
}

/// Choose the minimum among parent (`0`), left child (`1`), and optional right child (`2`)
/// during `TimerHeap::pop` sift-down.
#verify
pub fn heap_sift_down_pick(
  cur_at : Int64,
  cur_seq : Int,
  l_at : Int64,
  l_seq : Int,
  has_right : Bool,
  r_at : Int64,
  r_seq : Int,
) -> Int {
  let mut best = 0
  let mut best_at = cur_at
  let mut best_seq = cur_seq
  if timer_before(l_at, l_seq, best_at, best_seq) {
    best = 1
    best_at = l_at
    best_seq = l_seq
  }
  if has_right && timer_before(r_at, r_seq, best_at, best_seq) {
    best = 2
  }
  best
}

/// A binary min-heap of timers stored as Structure-of-Arrays (flat primitive arrays, zero RC/Option traffic).
struct TimerHeap {
  mut ats : Array[Int64]
  mut seqs : Array[Int]
  mut tids : Array[Int]
  mut len : Int
}

fn TimerHeap::new() -> TimerHeap {
  TimerHeap::{ ats: [], seqs: [], tids: [], len: 0 }
}

fn TimerHeap::push(self : TimerHeap, at : Int64, seq : Int, tid : Int) -> Unit {
  let ats = self.ats
  let seqs = self.seqs
  let tids = self.tids
  let mut i = self.len
  if i < ats.length() {
    ats[i] = at
    seqs[i] = seq
    tids[i] = tid
  } else {
    ats.push(at)
    seqs.push(seq)
    tids.push(tid)
  }
  self.len = i + 1
  while i > 0 {
    let p = heap_parent(i)
    let pat = ats[p]
    let pseq = seqs[p]
    if heap_sift_up_should_swap(at, seq, pat, pseq) {
      ats[i] = pat
      seqs[i] = pseq
      tids[i] = tids[p]
      i = p
    } else {
      break
    }
  }
  ats[i] = at
  seqs[i] = seq
  tids[i] = tid
}

fn TimerHeap::pop_tid(self : TimerHeap) -> Int {
  let n = self.len
  if n == 0 {
    return -2147483648
  }
  let ats = self.ats
  let seqs = self.seqs
  let tids = self.tids
  let top_tid = tids[0]
  let m = n - 1
  self.len = m
  if m > 0 {
    let last_at = ats[m]
    let last_seq = seqs[m]
    let last_tid = tids[m]
    let mut i = 0
    while true {
      let l = heap_left(i)
      if l >= m {
        break
      }
      let r = heap_right(i)
      let has_r = r < m
      let l_at = ats[l]
      let l_seq = seqs[l]
      let mut r_at = 0L
      let mut r_seq = 0
      if has_r {
        r_at = ats[r]
        r_seq = seqs[r]
      }
      let pick = heap_sift_down_pick(last_at, last_seq, l_at, l_seq, has_r, r_at, r_seq)
      if pick == 0 {
        break
      }
      if pick == 1 {
        ats[i] = l_at
        seqs[i] = l_seq
        tids[i] = tids[l]
        i = l
      } else {
        ats[i] = r_at
        seqs[i] = r_seq
        tids[i] = tids[r]
        i = r
      }
    }
    ats[i] = last_at
    seqs[i] = last_seq
    tids[i] = last_tid
  }
  top_tid
}

struct CurrentBox {
  stack : Array[Task]
  mut depth : Int
}

let current_box : CurrentBox = CurrentBox::{ stack: [], depth: 0 }

/// Cooperative fiber, timer, frame, and outside-work runtime.
pub struct Runtime {
  mut time : Int64
  clock : Option[() -> Int64]
  ready : RingDeque[Task]
  mut later : Array[Task]
  mut later_head : Int
  timers : TimerHeap
  timer_live : Array[Bool]
  timer_later : Array[Bool]
  timer_seq : Array[Int]
  timer_task : Array[Task]
  timer_free : Array[Int]
  mut timer_free_len : Int
  cb_live : Array[Bool]
  cb_later : Array[Bool]
  cb_fire : Array[() -> Unit]
  timer_who : Map[Int, String]
  pub mut seq : Int
  shuffle : Bool
  sched : Rng
  /// Draws for simulations (jitter, order, loss): apart from the scheduler's, from the same seed.
  pub rng : Rng
  /// The seed the run was made with (0: none, FIFO).
  pub seed : Int
  mut ids : Int
  root_state : ScopeState
  frame_waiters : Waiters
  mut dead : Int
  mut live_tasks : Int
  /// Frames so far (`frame`).
  pub mut frames : Int
  mut defect : (EffectError) -> Unit
  mut waker : () -> Unit
  mut timer_waker : (Int64) -> Unit
  mut outside : () -> Int64
  mut outside_event : () -> Int
  mut turning : Bool
  /// What failed, as said, when nobody else was told.
  pub defects : Array[String]
  /// What the run said (`trace`), each line with its time.
  pub log : Array[String]
  /// Task resumptions and timers fired so far.
  pub mut steps : Int
  awaited : Map[Int, (String, Int64)]
  mut tickets : Int
  mut ended : Array[(Int, String)]
  mut ended_n : Int
  mut keep_ended : Bool
}

fn Runtime::make(seed : Int, shuffle : Bool, start : Int64, clock : Option[() -> Int64]) -> Runtime {
  let defects : Array[String] = []
  Runtime::{
    time: start,
    clock,
    ready: RingDeque::with_capacity(64),
    later: [],
    later_head: 0,
    timers: TimerHeap::new(),
    timer_live: [],
    timer_later: [],
    timer_seq: [],
    timer_task: [],
    timer_free: [],
    timer_free_len: 0,
    cb_live: [],
    cb_later: [],
    cb_fire: [],
    timer_who: Map::new(),
    seq: 0,
    shuffle,
    sched: Rng::new(seed),
    rng: Rng::new(seed * 7919 + 17),
    seed,
    ids: 0,
    root_state: ScopeState::new(true),
    frame_waiters: Waiters::new(),
    dead: 0,
    live_tasks: 0,
    frames: 0,
    defect: fn(e : EffectError) -> Unit { defects.push(effect_error_to_string(e)) },
    waker: fn() -> Unit { () },
    timer_waker: fn(_at : Int64) -> Unit { () },
    outside: fn() -> Int64 { -1.to_int64() },
    outside_event: fn() -> Int { -1 },
    turning: false,
    defects,
    log: [],
    steps: 0,
    awaited: Map::new(),
    tickets: 0,
    ended: [],
    ended_n: 0,
    keep_ended: false,
  }
}

/// A runtime on virtual time from 0 ms (FIFO ready order).
pub fn Runtime::new() -> Runtime {
  Runtime::make(0, false, 0.to_int64(), None)
}

/// A runtime on virtual time from 0 ms with seeded scheduler shuffling.
pub fn Runtime::new_seeded(seed : Int) -> Runtime {
  Runtime::make(seed, true, 0.to_int64(), None)
}

/// A runtime on virtual time from `start` ms with optional `seed`.
pub fn Runtime::new_at(seed : Option[Int], start : Int64) -> Runtime {
  match seed {
    Some(s) => Runtime::make(s, true, start, None)
    None => Runtime::make(0, false, start, None)
  }
}

/// A runtime on the host's clock (ms): the host calls `tick` when it is due.
pub fn Runtime::live(now_fn : () -> Int64) -> Runtime {
  Runtime::make(0, false, now_fn(), Some(now_fn))
}

/// Who is told of failures nobody waited for (by default `defects` keeps them).
pub fn Runtime::on_defect(self : Runtime, f : (EffectError) -> Unit) -> Unit {
  self.defect = f
}

fn Runtime::report(self : Runtime, e : EffectError) -> Unit {
  (self.defect)(e)
}

/// Who is told that a task became ready while no turn runs.
pub fn Runtime::on_wake(self : Runtime, f : () -> Unit) -> Unit {
  self.waker = f
}

/// Who is told of a timer set while no turn runs, at its moment (`f(at)`).
pub fn Runtime::on_timer(self : Runtime, f : (Int64) -> Unit) -> Unit {
  self.timer_waker = f
}

/// The clock between frames (ms; negative: none).
pub fn Runtime::outside_clock(self : Runtime, f : () -> Int64) -> Unit {
  self.outside = f
}

/// Which of the host's events a task made ready between frames comes in (-1: one of its own).
pub fn Runtime::outside_event(self : Runtime, f : () -> Int) -> Unit {
  self.outside_event = f
}

/// The core's own scope: closing it ends everything.
pub fn Runtime::root(self : Runtime) -> EffectScope {
  EffectScope::{ rt: self, st: self.root_state }
}

/// The runtime's clock, in whole ms.
pub fn Runtime::now(self : Runtime) -> Int64 {
  match self.clock {
    Some(f) => f()
    None =>
    if self.turning {
      self.time
    } else {
      let t = (self.outside)()
      if t > self.time { t } else { self.time }
    }
  }
}

/// Notes a line in the run's log, with the time.
pub fn Runtime::trace(self : Runtime, s : String) -> Unit {
  self.log.push(self.now().to_string() + " " + s)
}

/// The log as one text, a line each.
pub fn Runtime::trace_text(self : Runtime) -> String {
  let sb = StringBuilder::new()
  for i in 0..<self.log.length() {
    if i > 0 {
      sb.write_byte(10 as Byte)
    }
    let line = self.log[i]
    for j in 0..<line.length() {
      sb.write_byte(line.code_unit_at(j) as Byte)
    }
  }
  sb.to_string()
}

fn current_task() -> Task {
  if current_box.depth > 0 {
    current_box.stack[current_box.depth - 1]
  } else {
    halt_saying("effect: not inside a task", "effect/runtime.pion:current_task")
  }
}

/// The runtime the running code is on.
pub fn runtime() -> Runtime {
  current_task().rt
}

/// The time on the running code's clock (ms).
pub fn now() -> Int64 {
  current_task().rt.now()
}

/// Notes a line in the run's log (`Runtime::trace`).
pub fn trace(s : String) -> Unit {
  current_task().rt.trace(s)
}

fn Task::is_interrupted_flag(self : Task) -> Bool {
  (self.flags & 8) != 0
}

fn Task::set_interrupted_flag(self : Task) -> Unit {
  self.flags = self.flags | 8
}

fn Task::is_queued(self : Task) -> Bool {
  (self.flags & 16) != 0
}

fn Task::set_queued(self : Task, v : Bool) -> Unit {
  if v {
    self.flags = self.flags | 16
  } else {
    self.flags = self.flags & -17
  }
}

fn Task::set_owner_report(self : Task, v : Bool) -> Unit {
  if v {
    self.flags = self.flags | 32
  } else {
    self.flags = self.flags & -33
  }
}

fn Task::set_state_kind(self : Task, k : Int) -> Unit {
  self.flags = (self.flags & -8) | k
}

fn Task::set_callback(self : Task, f : (Resume) -> Unit) -> Unit {
  self.flags = (self.flags & -8) | 1
  self.cb = f
}

fn Task::clear_state(self : Task) -> Unit {
  self.flags = self.flags & -8
  self.cb = noop_cb
  self.unit_k = noop_unit_k
}

fn Task::later_seq(self : Task) -> Int {
  (self.later_meta & 4294967295L).to_int()
}

fn Task::later_event(self : Task) -> Int {
  (self.later_meta >> 32).to_int()
}

fn Runtime::alloc_task(self : Runtime, name : String) -> Task {
  self.ids = self.ids + 1
  Task::{
    id: self.ids,
    rt: self,
    name,
    flags: 0,
    shield: 0,
    cb: noop_cb,
    unit_k: noop_unit_k,
    sleep_at: 0L,
    sleep_key: 0L,
    end: End::NotYet,
    since: 0.to_int64(),
    later_meta: 0L,
    owner: self.root_state,
    owner_slot: -1,
    first_w_id: 0,
    first_w: noop_w,
    extra_watchers: None,
  }
}

fn Runtime::start(
  self : Runtime,
  name : String,
  body : ((Exit[Unit]) -> Unit) -> Unit,
) -> Task {
  let t = self.alloc_task(name)
  t.set_callback(fn(r : Resume) -> Unit {
    match r {
      Resume::Stop => {
        t.end = End::Cut
        t.clear_state()
        t.finish()
      }
      Resume::Go => {
        body(fn(ex : Exit[Unit]) -> Unit {
          match ex {
            Exit::Succeeded(_) => {
              match t.end {
                End::NotYet => t.end = End::Done
                _ => ()
              }
            }
            Exit::Failed(e) => t.end = End::Raised(e)
            Exit::Interrupted => t.end = End::Cut
          }
          t.clear_state()
          t.finish()
        })
      }
    }
  })
  self.live_tasks = self.live_tasks + 1
  self.make_ready(t)
  t
}

fn Runtime::make_ready(self : Runtime, t : Task) -> Unit {
  t.flags = t.flags | 16
  if self.turning {
    t.since = self.time
    self.ready.push_back(t)
    return
  }
  t.since = self.now()
  let has_clock = match self.clock {
    Some(_) => true
    None => false
  }
  if !has_clock {
    self.seq = self.seq + 1
    let s = self.seq
    let e = (self.outside_event)()
    let ev = if e >= 0 { e } else { -s }
    t.later_meta = (ev.to_int64() << 32) | (s.to_int64() & 4294967295L)
    self.later.push(t)
  } else {
    self.ready.push_back(t)
  }
  (self.waker)()
}

fn Task::finish(self : Task) -> Unit {
  self.rt.live_tasks = self.rt.live_tasks - 1
  if self.owner_slot >= 0 {
    let st = self.owner
    st.remove_child(self)
    if st.all_notify {
      let ok = match self.end {
        End::Done => true
        _ => false
      }
      if !ok {
        st.all_failed = true
        st.all_notify = false
        match st.all_parent {
          Some(p) => {
            st.all_parent = None
            p.wake()
          }
          None => ()
        }
      } else if st.children_len == 0 {
        st.all_notify = false
        match st.all_parent {
          Some(p) => {
            st.all_parent = None
            p.wake()
          }
          None => ()
        }
      }
    }
    if (self.flags & 32) != 0 {
      match self.end {
        End::Raised(e) => self.rt.report(e)
        _ => ()
      }
    }
  }
  if self.first_w_id != 0 {
    let w = self.first_w
    self.first_w_id = 0
    self.first_w = noop_w
    w()
  }
  match self.extra_watchers {
    Some(m) => {
      if m.length() > 0 {
        let ks = m.keys()
        let ws : Array[() -> Unit] = []
        for k in ks {
          match m.get(k) {
            Some(w) => ws.push(w)
            None => ()
          }
          m.remove(k)
        }
        for w in ws {
          w()
        }
      }
    }
    None => ()
  }
}

fn Task::watch(self : Task, f : () -> Unit) -> Int {
  self.rt.ids = self.rt.ids + 1
  let id = self.rt.ids
  if self.first_w_id == 0 {
    self.first_w_id = id
    self.first_w = f
    return id
  }
  match self.extra_watchers {
    Some(m) => m.set(id, f)
    None => {
      let m : Map[Int, () -> Unit] = Map::new()
      m.set(id, f)
      self.extra_watchers = Some(m)
    }
  }
  id
}

fn Task::unwatch(self : Task, id : Int) -> Unit {
  if self.first_w_id == id {
    self.first_w_id = 0
    self.first_w = noop_w
    return
  }
  match self.extra_watchers {
    Some(m) => m.remove(id)
    None => ()
  }
}

fn Task::wake(self : Task) -> Unit {
  if (self.flags & 16) == 0 && (self.flags & 7) != 0 {
    self.rt.make_ready(self)
  }
}

fn Task::is_ended(self : Task) -> Bool {
  match self.end {
    End::NotYet => false
    _ => true
  }
}

fn Task::interrupt(self : Task) -> Unit {
  if !self.is_ended() {
    self.flags = self.flags | 8
    if self.shield == 0 {
      self.wake()
    }
  }
}

/// Parks the running task until something wakes it; interrupted (outside a shield), calls `on_cancel`.
fn park_k(on_go : () -> Unit, on_cancel : () -> Unit) -> Unit {
  let t = current_task()
  if (t.flags & 8) != 0 && t.shield == 0 {
    on_cancel()
    return
  }
  t.set_callback(fn(r : Resume) -> Unit {
    match r {
      Resume::Go => on_go()
      Resume::Stop => on_cancel()
    }
  })
}

fn Task::await_end_k(self : Task, k : (Exit[Unit]) -> Unit) -> Unit {
  if self.is_ended() {
    k(exit_ok_unit)
    return
  }
  let me = current_task()
  if (me.flags & 8) != 0 && me.shield == 0 {
    k(exit_interrupted_unit)
    return
  }
  let id = self.watch(fn() -> Unit { me.wake() })
  me.set_callback(fn(r : Resume) -> Unit {
    self.unwatch(id)
    match r {
      Resume::Go => self.await_end_k(k)
      Resume::Stop => k(exit_interrupted_unit)
    }
  })
}

/// Lets the other ready tasks run first.
pub fn pause_k(k : (Exit[Unit]) -> Unit) -> Unit {
  let t = current_task()
  if (t.flags & 8) != 0 && t.shield == 0 {
    k(exit_interrupted_unit)
    return
  }
  t.flags = (t.flags & -8) | 18
  t.unit_k = k
  t.since = t.rt.time
  t.rt.ready.push_back(t)
}

fn Runtime::push_free_tid(self : Runtime, tid : Int) -> Unit {
  let n = self.timer_free_len
  if n < self.timer_free.length() {
    self.timer_free[n] = tid
  } else {
    self.timer_free.push(tid)
  }
  self.timer_free_len = n + 1
}

fn Runtime::alloc_task_timer_slot(self : Runtime, seq : Int, later : Bool, task : Task, who : String) -> Int {
  let tid = if self.timer_free_len > 0 {
    let n = self.timer_free_len - 1
    self.timer_free_len = n
    let id = self.timer_free[n]
    self.timer_live[id] = true
    self.timer_later[id] = later
    self.timer_seq[id] = seq
    self.timer_task[id] = task
    id
  } else {
    let id = self.timer_live.length()
    self.timer_live.push(true)
    self.timer_later.push(later)
    self.timer_seq.push(seq)
    self.timer_task.push(task)
    id
  }
  if who.length() > 0 {
    self.timer_who.set(tid, who)
  }
  tid
}

fn Runtime::cancel_timer(self : Runtime, tid : Int, seq : Int) -> Unit {
  if tid >= 0 && tid < self.timer_live.length() && self.timer_live[tid] && self.timer_seq[tid] == seq {
    self.timer_live[tid] = false
    if self.timer_who.length() > 0 {
      self.timer_who.remove(tid)
    }
    self.dropped()
  }
}

fn Runtime::add_timer(
  self : Runtime,
  at : Int64,
  fire : () -> Unit,
  later : Bool,
  who : String,
) -> Int {
  self.seq = self.seq + 1
  let seq = self.seq
  let fid = self.cb_live.length()
  self.cb_live.push(true)
  self.cb_later.push(later)
  self.cb_fire.push(fire)
  let tid = -(fid + 1)
  if who.length() > 0 {
    self.timer_who.set(tid, who)
  }
  self.timers.push(at, seq, tid)
  if !self.turning {
    (self.timer_waker)(at)
  }
  tid
}

fn Runtime::add_task_timer(
  self : Runtime,
  at : Int64,
  task : Task,
  later : Bool,
  who : String,
) -> Int {
  self.seq = self.seq + 1
  let seq = self.seq
  let tid = self.alloc_task_timer_slot(seq, later, task, who)
  self.timers.push(at, seq, tid)
  if !self.turning {
    (self.timer_waker)(at)
  }
  tid
}

/// Calls `f` (sync code) `ms` from now on the runtime's clock.
pub fn Runtime::after(self : Runtime, ms : Int, f : () -> Unit) -> Unit {
  let _ = self.add_timer(self.now() + ms.to_int64(), f, false, "")
}

/// Calls `f` `ms` from now, with explicit `later` and `who` metadata.
pub fn Runtime::after_with(self : Runtime, ms : Int, f : () -> Unit, later : Bool, who : String) -> Unit {
  let _ = self.add_timer(self.now() + ms.to_int64(), f, later, who)
}

/// Waits `ms` on the runtime's clock.
pub fn sleep_k(ms : Int, k : (Exit[Unit]) -> Unit) -> Unit {
  sleep_later_k(ms, false, k)
}

/// Waits `ms` on the runtime's clock (`later`: does not block `unsettled`).
pub fn sleep_later_k(ms : Int, later : Bool, k : (Exit[Unit]) -> Unit) -> Unit {
  let t = current_task()
  let rt = t.rt
  let at = rt.now() + ms.to_int64()
  let tid = rt.add_task_timer(at, t, later, t.name)
  let seq = rt.seq
  if ms <= 0 {
    rt.cancel_timer(tid, seq)
    k(exit_ok_unit)
    return
  }
  if (t.flags & 8) != 0 && t.shield == 0 {
    rt.cancel_timer(tid, seq)
    k(exit_interrupted_unit)
    return
  }
  t.flags = (t.flags & -8) | 3
  t.sleep_at = at
  t.sleep_key = (seq.to_int64() << 32) | (tid.to_int64() & 4294967295L)
  t.unit_k = k
}

fn Runtime::pick(self : Runtime) -> Option[Task] {
  let n = self.ready.length()
  if n == 0 {
    None
  } else if self.shuffle {
    self.ready.remove_at(self.sched.below(n))
  } else {
    self.ready.pop_front()
  }
}

fn Runtime::later_len(self : Runtime) -> Int {
  self.later.length() - self.later_head
}

fn Runtime::clear_later(self : Runtime) -> Unit {
  self.later.clear()
  self.later_head = 0
}

fn Runtime::ready_later(self : Runtime) -> Option[Int64] {
  match self.clock {
    Some(_) => return None
    None => ()
  }
  let mut first : Option[Int64] = None
  for i in self.later_head..<self.later.length() {
    let t = self.later[i]
    match first {
      Some(f) => {
        if t.since < f {
          first = Some(t.since)
        }
      }
      None => first = Some(t.since)
    }
  }
  first
}

fn Runtime::run_ready_now(self : Runtime) -> Unit {
  if self.later_len() > 0 {
    let keep : Array[Task] = []
    for i in self.later_head..<self.later.length() {
      let t = self.later[i]
      if t.since <= self.time {
        self.ready.push_back(t)
      } else {
        keep.push(t)
      }
    }
    self.later = keep
    self.later_head = 0
  }
  let _ = self.run_tasks()
}

fn Runtime::step_task(self : Runtime, t : Task) -> Unit {
  let f = t.flags
  let kind = f & 7
  if kind == 0 {
    t.flags = f & -17
    return
  }
  t.flags = f & -24
  let d = current_box.depth
  if d < current_box.stack.length() {
    current_box.stack[d] = t
  } else {
    current_box.stack.push(t)
  }
  current_box.depth = d + 1
  self.steps = self.steps + 1
  let cut = (f & 8) != 0 && t.shield == 0
  if kind == 1 {
    let cb = t.cb
    t.cb = noop_cb
    cb(if cut { Resume::Stop } else { Resume::Go })
  } else if kind == 2 {
    let uk = t.unit_k
    t.unit_k = noop_unit_k
    if cut {
      uk(exit_interrupted_unit)
    } else {
      uk(exit_ok_unit)
    }
  } else {
    let uk = t.unit_k
    let at = t.sleep_at
    let sk = t.sleep_key
    let tid = (sk & 4294967295L).to_int()
    let seq = (sk >> 32).to_int()
    if cut {
      t.unit_k = noop_unit_k
      self.cancel_timer(tid, seq)
      uk(exit_interrupted_unit)
    } else if self.now() >= at {
      t.unit_k = noop_unit_k
      self.cancel_timer(tid, seq)
      uk(exit_ok_unit)
    } else {
      t.flags = (t.flags & -8) | 3
    }
  }
  current_box.depth = d
}

fn Runtime::is_timer_live(self : Runtime, tid : Int) -> Bool {
  if tid >= 0 {
    self.timer_live[tid]
  } else {
    self.cb_live[-tid - 1]
  }
}

fn Runtime::is_timer_later(self : Runtime, tid : Int) -> Bool {
  if tid >= 0 {
    self.timer_later[tid]
  } else {
    self.cb_later[-tid - 1]
  }
}

fn Runtime::dropped(self : Runtime) -> Unit {
  self.dead = self.dead + 1
  if self.dead >= 32 && self.dead * 2 > self.timers.len {
    let n = self.timers.len
    let live_ats : Array[Int64] = []
    let live_seqs : Array[Int] = []
    let live_tids : Array[Int] = []
    for i in 0..<n {
      let tid = self.timers.tids[i]
      if self.is_timer_live(tid) {
        live_ats.push(self.timers.ats[i])
        live_seqs.push(self.timers.seqs[i])
        live_tids.push(tid)
      } else if tid >= 0 {
        self.push_free_tid(tid)
      }
    }
    self.timers.len = 0
    for i in 0..<live_ats.length() {
      self.timers.push(live_ats[i], live_seqs[i], live_tids[i])
    }
    self.dead = 0
  }
}

/// Runs ready tasks until none is, including those made ready between frames; returns resumptions count.
pub fn Runtime::run_ready(self : Runtime) -> Int {
  for i in self.later_head..<self.later.length() {
    self.ready.push_back(self.later[i])
  }
  self.clear_later()
  let n = self.run_tasks()
  if current_box.depth == 0 && current_box.stack.length() > 0 {
    current_box.stack.clear()
  }
  n
}

fn Runtime::run_tasks(self : Runtime) -> Int {
  let outer = self.turning
  self.turning = true
  let mut n = 0
  if !self.shuffle {
    while self.ready.len > 0 {
      let t = self.ready.pop_front_raw()
      self.step_task(t)
      n = n + 1
      if n > 10000000 {
        self.turning = outer
        halt_saying(
          "effect: tasks kept each other ready without end (" + t.name + ")",
          "effect/runtime.pion:run_tasks",
        )
      }
    }
  } else {
    while true {
      match self.pick() {
        None => break
        Some(t) => {
          self.step_task(t)
          n = n + 1
          if n > 10000000 {
            self.turning = outer
            halt_saying(
              "effect: tasks kept each other ready without end (" + t.name + ")",
              "effect/runtime.pion:run_tasks",
            )
          }
        }
      }
    }
  }
  self.turning = outer
  n
}

/// The next non-`later` live timer due, when and who set it.
pub fn Runtime::next_due(self : Runtime) -> Option[(Int64, String)] {
  let mut best : Option[(Int64, String)] = None
  let n = self.timers.len
  for i in 0..<n {
    let tid = self.timers.tids[i]
    if self.is_timer_live(tid) && !self.is_timer_later(tid) {
      let tat = self.timers.ats[i]
      let who = match self.timer_who.get(tid) {
        Some(w) => w
        None => ""
      }
      match best {
        Some((at, _)) => {
          if tat < at {
            best = Some((tat, who))
          }
        }
        None => best = Some((tat, who))
      }
    }
  }
  best
}

/// When the next timer is due, if one is set.
pub fn Runtime::next_timer(self : Runtime) -> Option[Int64] {
  while self.timers.len > 0 {
    let tid = self.timers.tids[0]
    if !self.is_timer_live(tid) {
      let _ = self.timers.pop_tid()
      self.dead = self.dead - 1
      if tid >= 0 {
        self.push_free_tid(tid)
      }
    } else {
      return Some(self.timers.ats[0])
    }
  }
  None
}

fn Runtime::later_due_idx(self : Runtime) -> Int {
  for i in self.later_head..<self.later.length() {
    if self.later[i].since <= self.time {
      return i
    }
  }
  -1
}

fn Runtime::next_instant(self : Runtime) -> Option[Int64] {
  if self.later_len() == 0 {
    return self.next_timer()
  }
  match (self.next_timer(), self.ready_later()) {
    (Some(a), Some(b)) => Some(if a < b { a } else { b })
    (Some(a), None) => Some(a)
    (None, Some(b)) => Some(b)
    _ => None
  }
}

fn Runtime::fire_timer_tid(self : Runtime, tid : Int) -> Unit {
  if tid >= 0 {
    if self.timer_live[tid] {
      self.timer_live[tid] = false
      self.steps = self.steps + 1
      let task = self.timer_task[tid]
      if self.timer_who.length() > 0 {
        self.timer_who.remove(tid)
      }
      self.push_free_tid(tid)
      task.wake()
    } else {
      self.dead = self.dead - 1
      self.push_free_tid(tid)
    }
  } else {
    let fid = -tid - 1
    if self.cb_live[fid] {
      self.cb_live[fid] = false
      self.steps = self.steps + 1
      let f = self.cb_fire[fid]
      self.cb_fire[fid] = noop_w
      if self.timer_who.length() > 0 {
        self.timer_who.remove(tid)
      }
      f()
    } else {
      self.dead = self.dead - 1
    }
  }
}

fn Runtime::fire_until(self : Runtime, until : Int64) -> Unit {
  let outer = self.turning
  self.turning = true
  let _ = self.run_tasks()
  let has_clock = match self.clock {
    Some(_) => true
    None => false
  }
  while true {
    let at = match self.next_instant() {
      Some(a) => if a <= until { a } else { break }
      None => break
    }
    if !has_clock && at > self.time {
      self.time = at
    }
    if self.later_len() == 0 {
      while self.timers.len > 0 && self.timers.ats[0] <= at {
        let tid = self.timers.pop_tid()
        self.fire_timer_tid(tid)
      }
      let _ = self.run_tasks()
      continue
    }
    while true {
      let task_i = self.later_due_idx()
      let fire_timer = self.timers.len > 0 &&
      self.timers.ats[0] <= at &&
      (task_i < 0 || self.timers.seqs[0] < self.later[task_i].later_seq())
      if fire_timer {
        let tid = self.timers.pop_tid()
        if tid == -2147483648 {
          break
        }
        self.fire_timer_tid(tid)
      } else if task_i >= 0 {
        let i = task_i
        let event = self.later[i].later_event()
        let has_before = self.timers.len > 0 && self.timers.ats[0] <= at
        let before_seq = if has_before { self.timers.seqs[0] } else { 0 }
        let mut end = i
        while end < self.later.length() &&
        self.later[end].later_event() == event &&
        self.later[end].since <= self.time &&
        (!has_before || self.later[end].later_seq() < before_seq) {
          end = end + 1
        }
        let count = end - i
        if count == 1 && !self.shuffle && self.ready.len == 0 {
          let single = self.later[i]
          if i == self.later_head {
            self.later_head = end
            if self.later_head >= self.later.length() {
              self.clear_later()
            } else if self.later_head >= 1024 && self.later_head * 2 >= self.later.length() {
              let rem : Array[Task] = []
              for idx in self.later_head..<self.later.length() {
                rem.push(self.later[idx])
              }
              self.later = rem
              self.later_head = 0
            }
          } else {
            let mut k = i
            while k < self.later.length() - 1 {
              self.later[k] = self.later[k + 1]
              k = k + 1
            }
            let _ = self.later.pop()
          }
          self.step_task(single)
          if self.ready.len > 0 {
            let _ = self.run_tasks()
          }
        } else {
          for idx in i..<end {
            self.ready.push_back(self.later[idx])
          }
          if i == self.later_head {
            self.later_head = end
            if self.later_head >= self.later.length() {
              self.clear_later()
            } else if self.later_head >= 1024 && self.later_head * 2 >= self.later.length() {
              let rem : Array[Task] = []
              for idx in self.later_head..<self.later.length() {
                rem.push(self.later[idx])
              }
              self.later = rem
              self.later_head = 0
            }
          } else {
            let n = end - i
            let mut k = i
            while k < self.later.length() - n {
              self.later[k] = self.later[k + n]
              k = k + 1
            }
            for _ in 0..<n {
              let _ = self.later.pop()
            }
          }
          let _ = self.run_tasks()
        }
      } else {
        break
      }
    }
    let _ = self.run_tasks()
  }
  if self.timers.len == 0 && self.timer_live.length() > 0 {
    self.timer_live.clear()
    self.timer_later.clear()
    self.timer_seq.clear()
    self.timer_task.clear()
    self.timer_free_len = 0
  }
  if current_box.depth == 0 && current_box.stack.length() > 0 {
    current_box.stack.clear()
  }
  self.turning = outer
}

/// Moves virtual time on `ms`: every timer due meanwhile fires at its time.
pub fn Runtime::advance(self : Runtime, ms : Int) -> Unit {
  match self.clock {
    Some(_) => {
      let _ : Unit = halt_saying("effect: advance on the host's clock", "effect/runtime.pion:advance")
    }
    None => ()
  }
  let until = self.time + ms.to_int64()
  self.fire_until(until)
  self.time = until
}

/// The host's turn (`Runtime::live`): fires what is due on its clock and runs what is ready.
pub fn Runtime::tick(self : Runtime) -> Unit {
  self.fire_until(self.now())
}

/// A frame at `at` (ms, virtual time).
pub fn Runtime::frame(self : Runtime, at : Int64) -> Unit {
  match self.clock {
    Some(_) => {
      let _ : Unit = halt_saying("effect: frame on the host's clock", "effect/runtime.pion:frame")
    }
    None => ()
  }
  let outer = self.turning
  self.turning = true
  self.frames = self.frames + 1
  let moment = if at > self.time { at } else { self.time }
  self.fire_until(moment - 1.to_int64())
  let waited = self.frame_waiters.next
  self.fire_until(moment)
  if at > self.time {
    self.time = at
  }
  self.frame_waiters.wake_until(waited)
  self.run_ready_now()
  self.turning = outer
}

/// Whether it needs another frame.
pub fn Runtime::wants_frame(self : Runtime) -> Bool {
  !self.idle() || !self.frame_waiters.is_empty()
}

/// Waits for the next frame (`Runtime::frame`).
pub fn next_frame_k(k : (Exit[Unit]) -> Unit) -> Unit {
  current_task().rt.frame_waiters.wait_k(k)
}

/// What it still holds: (live_tasks, ready+later, live_timers, root_children, root_finalizers, frame_waiters).
pub fn Runtime::holding(self : Runtime) -> (Int, Int, Int, Int, Int, Int) {
  let mut live_timers = 0
  for i in 0..<self.timers.len {
    if self.is_timer_live(self.timers.tids[i]) {
      live_timers = live_timers + 1
    }
  }
  (
    self.live_tasks,
    self.ready.length() + self.later_len(),
    live_timers,
    self.root_state.children_len,
    self.root_state.finalizers_len(),
    self.frame_waiters.count(),
  )
}

/// Timers in the heap, live or given up.
pub fn Runtime::timer_slots(self : Runtime) -> Int {
  self.timers.len
}

/// Whether a fiber waits for the next frame (`next_frame_k`).
pub fn Runtime::waits_frame(self : Runtime) -> Bool {
  !self.frame_waiters.is_empty()
}

/// Nothing is ready to run.
pub fn Runtime::idle(self : Runtime) -> Bool {
  self.ready.is_empty() && self.later_len() == 0
}

/// Starts `f` as a fiber of the root scope.
pub fn Runtime::fork[X](self : Runtime, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  fork_in_scope(self, self.root_state, f, "", self.root_state.report)
}

/// Starts `f` as a named fiber of the root scope.
pub fn Runtime::fork_named[X](self : Runtime, name : String, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  fork_in_scope(self, self.root_state, f, name, self.root_state.report)
}

/// Starts `f` as a quiet fiber of the root scope (failures never reported to `on_defect`).
pub fn Runtime::fork_quiet[X](self : Runtime, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  fork_in_scope(self, self.root_state, f, "", false)
}

/// Starts `f` as a named quiet fiber of the root scope.
pub fn Runtime::fork_quiet_named[X](
  self : Runtime,
  name : String,
  f : ((Exit[X]) -> Unit) -> Unit,
) -> Fiber[X] {
  fork_in_scope(self, self.root_state, f, name, false)
}

/// Starts `f` as a named background daemon fiber of the root scope.
pub fn Runtime::fork_daemon(
  self : Runtime,
  name : String,
  f : ((Exit[Unit]) -> Unit) -> Unit,
  on_error : (EffectError) -> Unit,
) -> Fiber[Unit] {
  self.root().fork_daemon(name, f, on_error)
}

/// Closes the root scope: everything is interrupted, finalizers run.
pub fn Runtime::shutdown(self : Runtime) -> Unit {
  self.root().close_now()
}
