// Tasks parked on something (a Deferred, a Queue, a Semaphore, next_frame).

struct Waiters {
  tasks : Map[Int, Task]
  mut next : Int
}

fn Waiters::new() -> Waiters {
  Waiters::{ tasks: Map::new(), next: 0 }
}

fn Waiters::is_empty(self : Waiters) -> Bool {
  self.tasks.length() == 0
}

fn Waiters::count(self : Waiters) -> Int {
  self.tasks.length()
}

fn Waiters::wake_all(self : Waiters) -> Unit {
  if self.tasks.length() == 0 {
    return
  }
  let ks = self.tasks.keys()
  let ts : Array[Task] = []
  for k in ks {
    match self.tasks.get(k) {
      Some(t) => ts.push(t)
      None => ()
    }
    self.tasks.remove(k)
  }
  for t in ts {
    t.wake()
  }
}

/// Wakes those that began waiting by the `last`th wait, in the order they did.
fn Waiters::wake_until(self : Waiters, last : Int) -> Unit {
  if self.tasks.length() == 0 {
    return
  }
  let ks = self.tasks.keys()
  let ids : Array[Int] = []
  for k in ks {
    if k <= last {
      ids.push(k)
    }
  }
  // Sort ids ascending (insertion sort; waiter sets are small)
  for i in 1..<ids.length() {
    let key = ids[i]
    let mut j = i - 1
    while j >= 0 && ids[j] > key {
      ids[j + 1] = ids[j]
      j = j - 1
    }
    ids[j + 1] = key
  }
  let ts : Array[Task] = []
  for id in ids {
    match self.tasks.get(id) {
      Some(t) => {
        self.tasks.remove(id)
        ts.push(t)
      }
      None => ()
    }
  }
  for t in ts {
    t.wake()
  }
}

/// Parks the current task on this waiter set; removes itself on resume or cancellation.
fn Waiters::wait_k(self : Waiters, k : (Exit[Unit]) -> Unit) -> Unit {
  let t = current_task()
  self.next = self.next + 1
  let id = self.next
  self.tasks.set(id, t)
  park_k(
    fn() -> Unit {
      self.tasks.remove(id)
      k(Exit::Succeeded(()))
    },
    fn() -> Unit {
      self.tasks.remove(id)
      k(Exit::Interrupted)
    },
  )
}
