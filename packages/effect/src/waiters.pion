// Tasks parked on something (a Deferred, a Queue, a Semaphore, next_frame).

struct Waiters {
  mut first_id : Int
  mut first_task : Option[Task]
  mut extra : Option[Array[(Int, Task)]]
  mut next : Int
  mut len : Int
}

fn Waiters::new() -> Waiters {
  Waiters::{ first_id: 0, first_task: None, extra: None, next: 0, len: 0 }
}

fn Waiters::is_empty(self : Waiters) -> Bool {
  self.len == 0
}

fn Waiters::count(self : Waiters) -> Int {
  self.len
}

fn Waiters::add(self : Waiters, t : Task) -> Int {
  self.next = self.next + 1
  self.len = self.len + 1
  let id = self.next
  if self.first_id == 0 {
    match self.extra {
      None => {
        self.first_id = id
        self.first_task = Some(t)
        return id
      }
      Some(a) => {
        if a.length() == 0 {
          self.first_id = id
          self.first_task = Some(t)
          return id
        }
        a.push((id, t))
        return id
      }
    }
  }
  match self.extra {
    Some(a) => a.push((id, t))
    None => {
      let a : Array[(Int, Task)] = [(id, t)]
      self.extra = Some(a)
    }
  }
  id
}

fn Waiters::remove(self : Waiters, id : Int) -> Unit {
  if self.first_id == id {
    self.first_id = 0
    self.first_task = None
    self.len = self.len - 1
    return
  }
  match self.extra {
    None => ()
    Some(a) => {
      let n = a.length()
      for i in 0..<n {
        if a[i].0 == id {
          let mut j = i
          while j + 1 < n {
            a[j] = a[j + 1]
            j = j + 1
          }
          let _ = a.pop()
          self.len = self.len - 1
          return
        }
      }
    }
  }
}

fn Waiters::wake_all(self : Waiters) -> Unit {
  if self.len == 0 {
    return
  }
  if self.len == 1 && self.first_id != 0 {
    let t = self.first_task
    self.first_id = 0
    self.first_task = None
    self.len = 0
    match t {
      Some(task) => task.wake()
      None => ()
    }
    return
  }
  let ts : Array[Task] = []
  if self.first_id != 0 {
    match self.first_task {
      Some(task) => ts.push(task)
      None => ()
    }
    self.first_id = 0
    self.first_task = None
  }
  match self.extra {
    Some(a) => {
      for p in a {
        ts.push(p.1)
      }
      a.clear()
    }
    None => ()
  }
  self.len = 0
  for t in ts {
    t.wake()
  }
}

/// Wakes those that began waiting by the `last`th wait, in the order they did.
fn Waiters::wake_until(self : Waiters, last : Int) -> Unit {
  if self.len == 0 {
    return
  }
  let ts : Array[Task] = []
  if self.first_id != 0 && self.first_id <= last {
    match self.first_task {
      Some(task) => ts.push(task)
      None => ()
    }
    self.first_id = 0
    self.first_task = None
    self.len = self.len - 1
  }
  match self.extra {
    Some(a) => {
      if a.length() > 0 {
        let mut cut = 0
        while cut < a.length() && a[cut].0 <= last {
          ts.push(a[cut].1)
          cut = cut + 1
        }
        if cut > 0 {
          let rem = a.length() - cut
          for i in 0..<rem {
            a[i] = a[i + cut]
          }
          for _ in 0..<cut {
            let _ = a.pop()
          }
          self.len = self.len - cut
        }
      }
    }
    None => ()
  }
  for t in ts {
    t.wake()
  }
}

/// Parks the current task on this waiter set; removes itself on resume or cancellation.
fn Waiters::wait_k(self : Waiters, k : (Exit[Unit]) -> Unit) -> Unit {
  let t = current_task()
  if t.is_interrupted_flag() && t.shield == 0 {
    k(Exit::Interrupted)
    return
  }
  let id = self.add(t)
  t.set_callback(fn(r : Resume) -> Unit {
    self.remove(id)
    match r {
      Resume::Go => k(Exit::Succeeded(()))
      Resume::Stop => k(Exit::Interrupted)
    }
  })
}
