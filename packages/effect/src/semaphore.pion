// Permits: at most so many holders at once.

pub struct Semaphore {
  mut permits : Int
  waiters : Waiters
}

pub fn Semaphore::new(permits : Int) -> Semaphore {
  Semaphore::{ permits, waiters: Waiters::new() }
}

pub fn Semaphore::available(self : Semaphore) -> Int {
  self.permits
}

pub fn Semaphore::try_acquire(self : Semaphore) -> Bool {
  if self.permits > 0 {
    self.permits = self.permits - 1
    true
  } else {
    false
  }
}

pub fn Semaphore::acquire_k(self : Semaphore, k : (Exit[Unit]) -> Unit) -> Unit {
  if self.permits > 0 {
    self.permits = self.permits - 1
    k(Exit::Succeeded(()))
    return
  }
  let t = current_task()
  if t.is_interrupted_flag() && t.shield == 0 {
    k(Exit::Interrupted)
    return
  }
  let id = self.waiters.add(t)
  t.set_callback(fn(r : Resume) -> Unit {
    self.waiters.remove(id)
    match r {
      Resume::Go => self.acquire_k(k)
      Resume::Stop => k(Exit::Interrupted)
    }
  })
}

pub fn Semaphore::release(self : Semaphore) -> Unit {
  self.permits = self.permits + 1
  self.waiters.wake_all()
}

/// Runs `f` holding a permit, given back however it ends.
pub fn Semaphore::with_permit_k[X](
  self : Semaphore,
  f : ((Exit[X]) -> Unit) -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  self.acquire_k(fn(ex : Exit[Unit]) -> Unit {
    match ex {
      Exit::Interrupted => k(Exit::Interrupted)
      Exit::Failed(e) => k(Exit::Failed(e))
      Exit::Succeeded(_) => {
        f(fn(res : Exit[X]) -> Unit {
          self.release()
          k(res)
        })
      }
    }
  })
}
