// Simulated services (SimNet, SimFiles) and callback bridge (`host_call_k`).

/// A message between two endpoints.
pub struct Packet {
  pub from : String
  pub to : String
  pub body : String
}

pub fn Packet::eq(self : Packet, other : Packet) -> Bool {
  self.from == other.from && self.to == other.to && self.body == other.body
}

/// An endpoint of the network, as the core sees it.
pub struct Net {
  pub name : String
  pub send : (String, String) -> Unit
  pub recv_k : ((Exit[Packet]) -> Unit) -> Unit
}

/// A simulated network on the runtime's virtual clock.
pub struct SimNet {
  rt : Runtime
  inboxes : Map[String, Queue[Packet]]
  mut latency : Int
  mut jitter : Int
  mut loss : Double
  /// Packets so far, as they arrived (or were lost), with the time.
  pub log : Array[String]
}

pub fn SimNet::new(rt : Runtime) -> SimNet {
  SimNet::with_config(rt, 20, 0, 0.0)
}

pub fn SimNet::with_config(rt : Runtime, latency : Int, jitter : Int, loss : Double) -> SimNet {
  SimNet::{ rt, inboxes: Map::new(), latency, jitter, loss, log: [] }
}

/// Changes how it behaves from now on.
pub fn SimNet::set(
  self : SimNet,
  latency : Option[Int],
  jitter : Option[Int],
  loss : Option[Double],
) -> Unit {
  match latency {
    Some(x) => self.latency = x
    None => ()
  }
  match jitter {
    Some(x) => self.jitter = x
    None => ()
  }
  match loss {
    Some(x) => self.loss = x
    None => ()
  }
}

fn SimNet::inbox(self : SimNet, name : String) -> Queue[Packet] {
  match self.inboxes.get(name) {
    Some(q) => q
    None => {
      let q : Queue[Packet] = Queue::unbounded()
      self.inboxes.set(name, q)
      q
    }
  }
}

fn SimNet::send_packet(self : SimNet, p : Packet) -> Unit {
  let rt = self.rt
  if self.loss > 0.0 && rt.rng.chance(self.loss) {
    self.log.push(rt.now().to_string() + " lost " + p.from + "->" + p.to + " " + p.body)
    return
  }
  let delay = self.latency + rt.rng.between(0, self.jitter)
  rt.after(delay, fn() -> Unit {
    self.log.push(rt.now().to_string() + " " + p.from + "->" + p.to + " " + p.body)
    let _ = self.inbox(p.to).try_offer(p)
  })
}

/// The endpoint called `name`.
pub fn SimNet::endpoint(self : SimNet, name : String) -> Net {
  let inbox = self.inbox(name)
  Net::{
    name,
    send: fn(to : String, body : String) -> Unit {
      self.send_packet(Packet::{ from: name, to, body })
    },
    recv_k: fn(k : (Exit[Packet]) -> Unit) -> Unit { inbox.take_k(k) },
  }
}

/// The device's files, as the core sees them.
pub struct Files {
  pub read_k : (String, (Exit[Option[Bytes]]) -> Unit) -> Unit
  pub write_k : (String, Bytes, (Exit[Unit]) -> Unit) -> Unit
}

/// Files in memory on the virtual clock.
pub struct SimFiles {
  rt : Runtime
  pub data : Map[String, Bytes]
  latency : Int
  jitter : Int
  mut fail_writes : Bool
}

pub fn SimFiles::new(rt : Runtime) -> SimFiles {
  SimFiles::with_config(rt, 1, 0)
}

pub fn SimFiles::with_config(rt : Runtime, latency : Int, jitter : Int) -> SimFiles {
  SimFiles::{ rt, data: Map::new(), latency, jitter, fail_writes: false }
}

pub fn SimFiles::set_fail_writes(self : SimFiles, on : Bool) -> Unit {
  self.fail_writes = on
}

pub fn SimFiles::files(self : SimFiles) -> Files {
  Files::{
    read_k: fn(path : String, k : (Exit[Option[Bytes]]) -> Unit) -> Unit {
      let delay = self.latency + self.rt.rng.between(0, self.jitter)
      sleep_k(delay, fn(ex : Exit[Unit]) -> Unit {
        match ex {
          Exit::Interrupted => k(Exit::Interrupted)
          Exit::Failed(e) => k(Exit::Failed(e))
          Exit::Succeeded(_) => k(Exit::Succeeded(self.data.get(path)))
        }
      })
    },
    write_k: fn(path : String, bytes : Bytes, k : (Exit[Unit]) -> Unit) -> Unit {
      let delay = self.latency + self.rt.rng.between(0, self.jitter)
      sleep_k(delay, fn(ex : Exit[Unit]) -> Unit {
        match ex {
          Exit::Interrupted => k(Exit::Interrupted)
          Exit::Failed(e) => k(Exit::Failed(e))
          Exit::Succeeded(_) => {
            if self.fail_writes {
              k(Exit::Failed(EffectError::IoError("no space left writing " + path)))
            } else {
              self.data.set(path, bytes)
              k(Exit::Succeeded(()))
            }
          }
        }
      })
    },
  }
}

/// Waits for a host operation that answers by callback; interrupted before completion, calls `cancel`.
pub fn host_call_k[X](
  start : ((HostOutcome[X]) -> Unit) -> Unit,
  cancel : () -> Unit,
  k : (Exit[X]) -> Unit,
) -> Unit {
  let d : Deferred[X] = Deferred::new()
  start(fn(r : HostOutcome[X]) -> Unit {
    match r {
      HostOutcome::Ok(x) => {
        let _ = d.succeed(x)
      }
      HostOutcome::Err(e) => {
        let _ = d.fail(e)
      }
    }
  })
  d.wait_k(fn(ex : Exit[X]) -> Unit {
    if !d.is_done() {
      cancel()
    }
    k(ex)
  })
}
