// A queue between fibers backed by RingDeque[X].

pub struct Queue[X] {
  items : RingDeque[X]
  cap : Int
  takers : Waiters
  putters : Waiters
  mut shut : Bool
}

pub fn Queue::unbounded[X]() -> Queue[X] {
  Queue::{
    items: RingDeque::new(),
    cap: -1,
    takers: Waiters::new(),
    putters: Waiters::new(),
    shut: false,
  }
}

pub fn Queue::bounded[X](capacity : Int) -> Queue[X] {
  Queue::{
    items: RingDeque::with_capacity(if capacity > 0 { capacity } else { 8 }),
    cap: capacity,
    takers: Waiters::new(),
    putters: Waiters::new(),
    shut: false,
  }
}

pub fn Queue::size[X](self : Queue[X]) -> Int {
  self.items.length()
}

/// Return true if a queue with capacity `cap` (`< 0` = unbounded) and length `len` has room.
#verify
pub fn queue_has_room(cap : Int, len : Int) -> Bool {
  cap < 0 || len < cap
}

/// Return true if `try_offer` can accept an item without blocking.
#verify
pub fn queue_can_offer(shut : Bool, cap : Int, len : Int) -> Bool {
  !shut && queue_has_room(cap, len)
}

fn Queue::has_room[X](self : Queue[X]) -> Bool {
  queue_has_room(self.cap, self.items.length())
}

/// Adds `x` if there is room (offerUnsafe); false when full or shut down.
pub fn Queue::try_offer[X](self : Queue[X], x : X) -> Bool {
  if !queue_can_offer(self.shut, self.cap, self.items.length()) {
    return false
  }
  self.items.push_back(x)
  self.takers.wake_all()
  true
}

/// Adds `x`, waiting for room on a bounded queue.
pub fn Queue::offer_k[X](self : Queue[X], x : X, k : (Exit[Unit]) -> Unit) -> Unit {
  if self.shut {
    k(Exit::Failed(EffectError::QueueShutdown))
    return
  }
  if self.has_room() {
    self.items.push_back(x)
    self.takers.wake_all()
    k(Exit::Succeeded(()))
    return
  }
  self.putters.wait_k(fn(ex : Exit[Unit]) -> Unit {
    match ex {
      Exit::Interrupted => k(Exit::Interrupted)
      Exit::Failed(e) => k(Exit::Failed(e))
      Exit::Succeeded(_) => self.offer_k(x, k)
    }
  })
}

/// The first item, waiting for one.
pub fn Queue::take_k[X](self : Queue[X], k : (Exit[X]) -> Unit) -> Unit {
  match self.items.pop_front() {
    Some(x) => {
      self.putters.wake_all()
      k(Exit::Succeeded(x))
    }
    None => {
      if self.shut {
        k(Exit::Failed(EffectError::QueueShutdown))
        return
      }
      self.takers.wait_k(fn(ex : Exit[Unit]) -> Unit {
        match ex {
          Exit::Interrupted => k(Exit::Interrupted)
          Exit::Failed(e) => k(Exit::Failed(e))
          Exit::Succeeded(_) => self.take_k(k)
        }
      })
    }
  }
}

pub fn Queue::try_take[X](self : Queue[X]) -> Option[X] {
  let x = self.items.pop_front()
  match x {
    Some(_) => self.putters.wake_all()
    None => ()
  }
  x
}

/// No more offers; takes end once what is in it is taken.
pub fn Queue::shutdown[X](self : Queue[X]) -> Unit {
  self.shut = true
  self.takers.wake_all()
  self.putters.wake_all()
}
