// A value some fiber waits for and another (or a host's callback) gives, once.

enum DeferredSlot[X] {
  Empty
  Value(X)
  Broken(EffectError)
}

pub struct Deferred[X] {
  mut slot : DeferredSlot[X]
  waiters : Waiters
}

pub fn Deferred::new[X]() -> Deferred[X] {
  Deferred::{ slot: DeferredSlot::Empty, waiters: Waiters::new() }
}

/// Gives it its value; false when it already had an outcome.
pub fn Deferred::succeed[X](self : Deferred[X], x : X) -> Bool {
  match self.slot {
    DeferredSlot::Empty => {
      self.slot = DeferredSlot::Value(x)
      self.waiters.wake_all()
      true
    }
    _ => false
  }
}

/// Gives it a failure; false when it already had an outcome.
pub fn Deferred::fail[X](self : Deferred[X], e : EffectError) -> Bool {
  match self.slot {
    DeferredSlot::Empty => {
      self.slot = DeferredSlot::Broken(e)
      self.waiters.wake_all()
      true
    }
    _ => false
  }
}

pub fn Deferred::is_done[X](self : Deferred[X]) -> Bool {
  match self.slot {
    DeferredSlot::Empty => false
    _ => true
  }
}

/// Its outcome if it has one (None: not yet).
pub fn Deferred::poll[X](self : Deferred[X]) -> Option[Exit[X]] {
  match self.slot {
    DeferredSlot::Empty => None
    DeferredSlot::Value(x) => Some(Exit::Succeeded(x))
    DeferredSlot::Broken(e) => Some(Exit::Failed(e))
  }
}

/// Waits for its outcome: Succeeded(x), Failed(e), or Interrupted.
pub fn Deferred::wait_k[X](self : Deferred[X], k : (Exit[X]) -> Unit) -> Unit {
  match self.slot {
    DeferredSlot::Value(x) => k(Exit::Succeeded(x))
    DeferredSlot::Broken(e) => k(Exit::Failed(e))
    DeferredSlot::Empty => {
      let t = current_task()
      if t.is_interrupted_flag() && t.shield == 0 {
        k(Exit::Interrupted)
        return
      }
      let id = self.waiters.add(t)
      t.set_callback(fn(r : Resume) -> Unit {
        self.waiters.remove(id)
        match r {
          Resume::Go => self.wait_k(k)
          Resume::Stop => k(Exit::Interrupted)
        }
      })
    }
  }
}
