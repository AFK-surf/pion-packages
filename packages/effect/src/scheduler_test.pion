// Priority scheduler tests.

struct Rig {
  rt : Runtime
  lane : Scheduler
  log : Array[String]
  gates : Map[String, Deferred[Unit]]
  fibers : Map[String, Fiber[Unit]]
}

fn Rig::new(width : Int = 2) -> Rig {
  Rig::{
    rt: Runtime::new(),
    lane: Scheduler::new(width=width),
    log: [],
    gates: Map::new(),
    fibers: Map::new(),
  }
}

fn Rig::ask(self : Rig, key : String, priority : Int) -> Unit {
  let gate : Deferred[Unit] = Deferred::new()
  self.gates.set(key, gate)
  let f = self.rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    self.lane.run_k(
      key,
      priority,
      fn(_p : Preempt, tk : (Exit[Unit]) -> Unit) -> Unit {
        self.log.push("start " + key)
        gate.wait_k(fn(ex : Exit[Unit]) -> Unit {
          match ex {
            Exit::Succeeded(_) => {
              self.log.push("end " + key)
              tk(Exit::Succeeded(()))
            }
            _ => tk(ex)
          }
        })
      },
      k,
    )
  })
  self.fibers.set(key, f)
}

fn Rig::ask_idle(self : Rig, key : String) -> Unit {
  let gate : Deferred[Unit] = Deferred::new()
  self.gates.set(key, gate)
  let f = self.rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    self.lane.run_k(
      key,
      priority_idle(),
      fn(preempt : Preempt, tk : (Exit[Unit]) -> Unit) -> Unit {
        self.log.push("start " + key)
        race_k(
          fn(rk : (Exit[Bool]) -> Unit) -> Unit {
            gate.wait_k(fn(ex : Exit[Unit]) -> Unit {
              match ex {
                Exit::Succeeded(_) => rk(Exit::Succeeded(false))
                Exit::Interrupted => rk(Exit::Interrupted)
                Exit::Failed(e) => rk(Exit::Failed(e))
              }
            })
          },
          fn(rk : (Exit[Bool]) -> Unit) -> Unit {
            preempt.wait_k(fn(ex : Exit[Unit]) -> Unit {
              match ex {
                Exit::Succeeded(_) => rk(Exit::Succeeded(true))
                Exit::Interrupted => rk(Exit::Interrupted)
                Exit::Failed(e) => rk(Exit::Failed(e))
              }
            })
          },
          fn(rex : Exit[Bool]) -> Unit {
            match rex {
              Exit::Succeeded(given_way) => {
                if given_way {
                  debug_assert(preempt.is_preempted(), "must be preempted")
                  self.log.push("preempted " + key)
                } else {
                  self.log.push("end " + key)
                }
                tk(Exit::Succeeded(()))
              }
              Exit::Interrupted => tk(Exit::Interrupted)
              Exit::Failed(e) => tk(Exit::Failed(e))
            }
          },
        )
      },
      k,
    )
  })
  self.fibers.set(key, f)
}

fn Rig::finish(self : Rig, key : String) -> Unit {
  match self.gates.get(key) {
    Some(g) => {
      let _ = g.succeed(())
    }
    None => ()
  }
  let _ = self.rt.run_ready()
}

fn Rig::step(self : Rig) -> Unit {
  let _ = self.rt.run_ready()
}

fn Rig::took(self : Rig) -> Array[String] {
  let out : Array[String] = []
  for i in 0..<self.log.length() {
    out.push(self.log[i])
  }
  self.log.clear()
  out
}

fn strs_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

test "urgent tasks take urgent_room past width; shown takes only width" {
  let rig = Rig::new()
  rig.ask("s1", priority_shown())
  rig.ask("s2", priority_shown())
  rig.ask("s3", priority_shown())
  rig.ask("f1", priority_focused())
  rig.ask("a1", priority_asked())
  rig.ask("a2", priority_asked())
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start s1", "start s2", "start f1", "start a1"]), "initial 4")
  rig.finish("a1")
  debug_assert(strs_eq(rig.took(), ["end a1", "start a2"]), "a2 takes urgent room")
  rig.finish("s1")
  debug_assert(strs_eq(rig.took(), ["end s1"]), "width still full")
  rig.finish("a2")
  debug_assert(strs_eq(rig.took(), ["end a2"]), "still 2 running")
  rig.finish("f1")
  debug_assert(strs_eq(rig.took(), ["end f1", "start s3"]), "s3 starts")
}

test "prioritize raises matching prefix and clearing restores base priority" {
  let rig = Rig::new(width=1)
  rig.ask("hold", priority_shown())
  rig.step()
  rig.ask("t:1/a", priority_shown())
  rig.ask("t:2/a", priority_shown())
  rig.ask("t:2/b", priority_shown())
  rig.step()
  rig.lane.prioritize("open", Some("t:2/"), boost=priority_shown() + 1)
  debug_assert(
    strs_eq(rig.lane.pending(), ["hold@10 running", "t:1/a@10", "t:2/a@11", "t:2/b@11"]),
    "boosted",
  )
  rig.lane.prioritize("open", None)
  debug_assert(
    strs_eq(rig.lane.pending(), ["hold@10 running", "t:1/a@10", "t:2/a@10", "t:2/b@10"]),
    "restored",
  )
  rig.lane.prioritize("open", Some("t:2/b"), boost=priority_shown() + 1)
  rig.finish("hold")
  debug_assert(strs_eq(rig.took(), ["start hold", "end hold", "start t:2/b"]), "t:2/b next")
  rig.lane.prioritize("open", None)
  rig.finish("t:2/b")
  debug_assert(strs_eq(rig.took(), ["end t:2/b", "start t:1/a"]), "t:1/a next")
  rig.lane.prioritize("open", Some("t:2/a"))
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start t:2/a"]), "boosted to urgent")
}

test "background runs one at a time behind shown and foreground_begin; on_idle fires" {
  let rig = Rig::new()
  rig.ask("shown", priority_shown())
  rig.ask("bg1", priority_background())
  rig.ask("bg2", priority_background())
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start shown"]), "shown first")
  let end_fg = rig.lane.foreground_begin()
  rig.finish("shown")
  debug_assert(strs_eq(rig.took(), ["end shown"]), "fg blocks bg")
  end_fg()
  end_fg()
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start bg1"]), "bg1 one at a time")
  rig.ask("detail", priority_detail())
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start detail"]), "detail runs")
  rig.finish("bg1")
  debug_assert(strs_eq(rig.took(), ["end bg1"]), "bg2 waits for detail")
  let mut idle_seen = 0
  rig.lane.on_idle(fn() -> Unit { idle_seen += 1 })
  rig.finish("detail")
  debug_assert(strs_eq(rig.took(), ["end detail", "start bg2"]), "bg2 starts")
  rig.finish("bg2")
  debug_assert(idle_seen == 1 && !rig.lane.busy(), "on_idle fired")
}

test "idle preemption by detail, foreground_begin, and prioritize; background waits for idle" {
  let rig = Rig::new()
  rig.ask_idle("fill")
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start fill"]), "idle starts")
  rig.ask("bg", priority_background())
  rig.ask_idle("fill2")
  rig.step()
  debug_assert(strs_eq(rig.took(), []), "bg waits, does not preempt idle")
  rig.finish("fill")
  debug_assert(strs_eq(rig.took(), ["end fill", "start bg"]), "bg runs")
  rig.finish("bg")
  debug_assert(strs_eq(rig.took(), ["end bg", "start fill2"]), "fill2 runs")

  let rig2 = Rig::new()
  rig2.ask_idle("fill")
  rig2.step()
  rig2.ask("detail", priority_detail())
  rig2.step()
  debug_assert(strs_eq(rig2.took(), ["start fill", "start detail", "preempted fill"]), "detail preempts idle")
  rig2.finish("detail")
  debug_assert(!rig2.lane.busy(), "rig2 idle")

  let rig3 = Rig::new()
  rig3.lane.prioritize("open", Some("t:"))
  rig3.ask_idle("t:fill")
  rig3.step()
  rig3.ask("shown", priority_shown())
  rig3.step()
  debug_assert(strs_eq(rig3.took(), ["start t:fill", "start shown"]), "boosted idle not preempted")
  rig3.lane.prioritize("open", None)
  rig3.step()
  debug_assert(strs_eq(rig3.took(), ["preempted t:fill"]), "unboosted idle preempted")
  rig3.finish("shown")
  debug_assert(!rig3.lane.busy(), "rig3 idle")

  let rig4 = Rig::new()
  rig4.ask_idle("fill")
  rig4.step()
  let end_fg = rig4.lane.foreground_begin()
  rig4.step()
  debug_assert(strs_eq(rig4.took(), ["start fill", "preempted fill"]), "fg preempts idle")
  rig4.ask_idle("fill2")
  rig4.step()
  debug_assert(strs_eq(rig4.took(), []), "fill2 waits for fg")
  end_fg()
  rig4.step()
  debug_assert(strs_eq(rig4.took(), ["start fill2"]), "fill2 runs after fg")
}

test "interrupt releases running or waiting slot, and one key runs once at a time" {
  let rig = Rig::new(width=1)
  rig.ask("a", priority_shown())
  rig.ask("b", priority_shown())
  rig.ask("c", priority_shown())
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start a"]), "a runs")
  match rig.fibers.get("a") {
    Some(f) => f.interrupt()
    None => ()
  }
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start b"]), "b takes slot")
  match rig.fibers.get("c") {
    Some(f) => f.interrupt()
    None => ()
  }
  rig.step()
  debug_assert(strs_eq(rig.lane.pending(), ["b@10 running"]), "c left queue")
  rig.finish("b")
  debug_assert(strs_eq(rig.took(), ["end b"]) && !rig.lane.busy(), "b done")

  // Interrupted in same turn slot was granted
  let rig2 = Rig::new(width=1)
  rig2.ask("a", priority_shown())
  rig2.ask("b", priority_shown())
  rig2.ask("c", priority_shown())
  rig2.step()
  match rig2.gates.get("a") {
    Some(g) => {
      let _ = g.succeed(())
    }
    None => ()
  }
  match rig2.fibers.get("b") {
    Some(f) => f.interrupt()
    None => ()
  }
  rig2.step()
  debug_assert(strs_eq(rig2.took(), ["start a", "end a", "start c"]), "c runs when b cut on grant")
  rig2.finish("c")
  debug_assert(!rig2.lane.busy(), "rig2 idle")

  // Same key serialized
  let rig3 = Rig::new()
  rig3.ask("k", priority_shown())
  rig3.step()
  let gate2 : Deferred[Unit] = Deferred::new()
  let _ = rig3.rt.fork(fn(k : (Exit[Unit]) -> Unit) -> Unit {
    rig3.lane.run_k(
      "k",
      priority_shown(),
      fn(_p : Preempt, tk : (Exit[Unit]) -> Unit) -> Unit {
        rig3.log.push("start k again")
        gate2.wait_k(tk)
      },
      k,
    )
  })
  rig3.ask("other", priority_shown())
  rig3.step()
  debug_assert(strs_eq(rig3.took(), ["start k", "start other"]), "k2 waits for k1")
  rig3.finish("k")
  debug_assert(strs_eq(rig3.took(), ["end k", "start k again"]), "k2 starts after k1")
}

test "nested foreground_begin refcount, queued/busy state, and multi-slot prioritize" {
  let rig = Rig::new(width=1)
  debug_assert(!rig.lane.busy() && !rig.lane.queued("bg1"), "initially idle")
  let fg1 = rig.lane.foreground_begin()
  let fg2 = rig.lane.foreground_begin()
  rig.ask("bg1", priority_background())
  rig.step()
  debug_assert(rig.lane.busy() && rig.lane.queued("bg1"), "bg1 queued")
  debug_assert(strs_eq(rig.took(), []), "held by 2 foregrounds")
  fg1()
  rig.step()
  debug_assert(strs_eq(rig.took(), []), "still held by fg2")
  fg2()
  rig.step()
  debug_assert(strs_eq(rig.took(), ["start bg1"]), "bg1 starts after both fg ended")
  rig.finish("bg1")
  debug_assert(!rig.lane.queued("bg1") && !rig.lane.busy(), "cleared after finish")

  // Multi-slot prioritize: highest boost wins
  let rig2 = Rig::new(width=1)
  rig2.ask("hold", priority_shown())
  rig2.step()
  rig2.ask("p/a", priority_background())
  rig2.ask("p/b", priority_background())
  rig2.step()
  rig2.lane.prioritize("s1", Some("p/"), boost=12)
  rig2.lane.prioritize("s2", Some("p/b"), boost=15)
  debug_assert(strs_eq(rig2.lane.pending(), ["hold@10 running", "p/a@12", "p/b@15"]), "max boost applies")
  rig2.finish("hold")
  debug_assert(strs_eq(rig2.took(), ["start hold", "end hold", "start p/b"]), "p/b wins over p/a")
  rig2.finish("p/b")
  debug_assert(strs_eq(rig2.took(), ["end p/b", "start p/a"]), "p/a next")
  rig2.finish("p/a")
  debug_assert(!rig2.lane.busy(), "rig2 idle")
}
