///| Pion Native head-to-head benchmark for `packages/pdf`.
///| Modes:
///|   report100    [dump_pdf_path]
///|   images_flate [dump_pdf_path]
///|   images_rle   [dump_pdf_path]

import "pdf"

fn make_synth_rgba(w : Int, h : Int, page_idx : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 4)
  let mut y = 0
  while y < h {
    let band = (y / 32) & 7
    let mut x = 0
    while x < w {
      let off = (y * w + x) * 4
      if band == 0 || band == 4 {
        out[off] = 37.to_byte()
        out[off + 1] = 99.to_byte()
        out[off + 2] = 235.to_byte()
        out[off + 3] = 255.to_byte()
      } else if band == 1 || band == 5 {
        if (x / 16 + y / 8 + page_idx) % 11 == 0 {
          out[off] = 24.to_byte()
          out[off + 1] = 24.to_byte()
          out[off + 2] = 27.to_byte()
          out[off + 3] = 255.to_byte()
        } else {
          out[off] = 255.to_byte()
          out[off + 1] = 255.to_byte()
          out[off + 2] = 255.to_byte()
          out[off + 3] = 255.to_byte()
        }
      } else {
        let rv = (x * 255) / (w - 1)
        let gv = (y * 255) / (h - 1)
        let bv = (page_idx * 37 + (x >> 2)) & 0xFF
        out[off] = rv.to_byte()
        out[off + 1] = gv.to_byte()
        out[off + 2] = bv.to_byte()
        out[off + 3] = 224.to_byte()
      }
      x = x + 1
    }
    y = y + 1
  }
  out
}

fn pad2(n : Int) -> String {
  if n < 10 {
    "0" + n.to_string()
  } else {
    n.to_string()
  }
}

fn pad_left8(n : Int) -> String {
  let s = n.to_string()
  let mut pad = ""
  let mut i = s.length()
  while i < 8 {
    pad = pad + " "
    i = i + 1
  }
  pad + s
}

fn check_pdf_basic(data : Bytes) -> (Int, Int) {
  let n = data.length()
  let hdr = if n >= 7 &&
  data[0].to_int() == 37 &&
  data[1].to_int() == 80 &&
  data[2].to_int() == 68 &&
  data[3].to_int() == 70 &&
  data[4].to_int() == 45 &&
  data[5].to_int() == 49 &&
  data[6].to_int() == 46 {
    1
  } else {
    0
  }
  let eof = if n >= 6 &&
  data[n - 6].to_int() == 37 &&
  data[n - 5].to_int() == 37 &&
  data[n - 4].to_int() == 69 &&
  data[n - 3].to_int() == 79 &&
  data[n - 2].to_int() == 70 &&
  data[n - 1].to_int() == 10 {
    1
  } else {
    0
  }
  (hdr, eof)
}

fn bench_report100(pages : Int) -> Result[Bytes, pdf::PdfError] {
  let doc = pdf::PdfDoc::new()
  doc.set_title("Quarterly Report (100 Pages) \\ Benchmark")
  doc.set_author("PDF Benchmark")
  doc.set_creator("packages/pdf")
  doc.set_compression(pdf::flate_default())

  let mut p = 0
  while p < pages {
    let page = pdf::Page::a4()
    page.save()
    page.set_fill_rgb(0.12, 0.28, 0.56)
    page.rect(40.0, 760.0, 515.28, 42.0)
    page.fill()
    page.set_fill_rgb(1.0, 1.0, 1.0)
    let title = "Quarterly Financial Summary (Page " +
    (p + 1).to_string() +
    ") \\ Confidential"
    page.text(52.0, 776.0, 16.0, pdf::StandardFont::HelveticaBold, title)

    page.set_fill_rgb(0.1, 0.1, 0.1)
    page.text(
      40.0,
      742.0,
      10.0,
      pdf::StandardFont::Helvetica,
      "Generated by pure PDF 1.4 engine - ISO 32000-1",
    )

    page.set_stroke_rgb(0.2, 0.45, 0.8)
    page.set_line_width(1.25)
    page.move_to(40.0, 730.0)
    page.line_to(555.28, 730.0)
    page.cubic_to(460.0, 710.0, 160.0, 710.0, 40.0, 695.0)
    page.stroke()

    let mut r = 0
    while r < 20 {
      let y = 660.0 - r.to_double() * 28.0
      if r % 2 == 0 {
        page.set_fill_rgb(0.95, 0.96, 0.98)
        page.rect(40.0, y - 6.0, 515.28, 22.0)
        page.fill()
      }
      page.set_fill_rgb(0.1, 0.1, 0.12)
      let label = "Line Item #" +
      pad2(r + 1) +
      " (Dept " +
      ((p + r) % 7 + 1).to_string() +
      ")"
      page.text(48.0, y, 9.0, pdf::StandardFont::Helvetica, label)
      let amount = "USD " +
      pad_left8((p + 1) * 100 + r * 37) +
      "." +
      pad2((r * 19) % 100)
      page.text(420.0, y, 9.0, pdf::StandardFont::Courier, amount)
      r = r + 1
    }
    page.restore()
    match doc.add_page(page) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    p = p + 1
  }
  doc.encode()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pdf_bench <report100|images_flate|images_rle> [dump_path]")
    return 1
  }
  let mode = args[1]
  let has_dump = args.length() >= 3

  if mode == "report100" {
    let out = match bench_report100(100) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "report100 error: " + pdf::pdf_error_message(e))
        return 1
      }
    }
    if has_dump {
      let _ = fs_write_bytes(world, args[2], out)
    }
    let (hdr, eof) = check_pdf_basic(out)
    let non_empty = if out.length() > 10000 { 1 } else { 0 }
    io_println(
      world,
      "mode=report100 pages=100 header_ok=" +
      hdr.to_string() +
      " eof_ok=" +
      eof.to_string() +
      " non_empty=" +
      non_empty.to_string(),
    )
    return 0
  }

  if mode == "images_flate" || mode == "images_rle" {
    let w = 800
    let h = 600
    let pages : Array[(Int, Int, Bytes)] = []
    let mut i = 0
    while i < 10 {
      pages.push((w, h, make_synth_rgba(w, h, i)))
      i = i + 1
    }
    let comp = if mode == "images_flate" {
      pdf::flate_default()
    } else {
      pdf::Compression::RunLength
    }
    let out = match pdf::encode_pdf_pages_with_compression(pages, comp) {
      Ok(b) => b
      Err(e) => {
        io_println(world, mode + " error: " + pdf::pdf_error_message(e))
        return 1
      }
    }
    if has_dump {
      let _ = fs_write_bytes(world, args[2], out)
    }
    let (hdr, eof) = check_pdf_basic(out)
    let non_empty = if out.length() > 10000 { 1 } else { 0 }
    let raw_rgb = 10 * w * h * 3
    io_println(
      world,
      "mode=" +
      mode +
      " pages=10 raw_rgb_bytes=" +
      raw_rgb.to_string() +
      " header_ok=" +
      hdr.to_string() +
      " eof_ok=" +
      eof.to_string() +
      " non_empty=" +
      non_empty.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
