///| Four-mode (Native/Wasm32 x debug/release) smoke entry for `packages/pdf`.

import "pdf"

fn fnv1a_64(data : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let prime : UInt64 = 1099511628211UL
  let mut i = 0
  while i < data.length() {
    h = h ^ (data[i].to_int() & 0xFF).to_uint().to_uint64()
    h = h * prime
    i = i + 1
  }
  h
}

fn make_rgba(w : Int, h : Int, r : Int, g : Int, b : Int, a : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 4)
  let mut i = 0
  while i < w * h {
    out[i * 4] = (r & 0xFF).to_byte()
    out[i * 4 + 1] = (g & 0xFF).to_byte()
    out[i * 4 + 2] = (b & 0xFF).to_byte()
    out[i * 4 + 3] = (a & 0xFF).to_byte()
    i = i + 1
  }
  out
}

fn make_rgb(w : Int, h : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 3)
  let mut y = 0
  while y < h {
    let mut x = 0
    while x < w {
      let off = (y * w + x) * 3
      out[off] = ((x * 31) & 0xFF).to_byte()
      out[off + 1] = ((y * 47) & 0xFF).to_byte()
      out[off + 2] = (((x + y) * 19) & 0xFF).to_byte()
      x = x + 1
    }
    y = y + 1
  }
  out
}

fn make_jpeg() -> Bytes {
  let vals = [
    0xFF, 0xD8, 0xFF, 0xC0, 0x00, 0x11, 0x08, 0x00, 0x02, 0x00, 0x02, 0x03, 0x01,
    0x11, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01, 0xFF, 0xD9,
  ]
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
pub fn main(world : World) -> Int {
  let doc = pdf::PdfDoc::new()
  doc.set_title("Wasm Smoke (PDF 1.4)")
  doc.set_author("Pion")
  doc.set_compression(pdf::flate_default())

  let img_rgb = match doc.add_rgb_image(8, 8, make_rgb(8, 8)) {
    Ok(id) => id
    Err(_) => return 1
  }
  let img_mask = match
  doc.add_rgba_image(8, 8, make_rgba(8, 8, 37, 99, 235, 192), pdf::AlphaMode::SoftMask) {
    Ok(id) => id
    Err(_) => return 2
  }
  let img_jpg = match doc.add_jpeg_image(2, 2, make_jpeg()) {
    Ok(id) => id
    Err(_) => return 3
  }

  let p1 = pdf::Page::a4()
  p1.save()
  p1.set_fill_rgb(0.15, 0.39, 0.92)
  p1.rect(40.0, 740.0, 515.28, 60.0)
  p1.fill()
  p1.set_stroke_rgb(0.0, 0.0, 0.0)
  p1.set_line_width(1.25)
  p1.move_to(40.0, 700.0)
  p1.line_to(555.28, 700.0)
  p1.cubic_to(480.0, 660.0, 120.0, 660.0, 40.0, 620.0)
  p1.stroke()
  p1.text(50.0, 765.0, 18.0, pdf::StandardFont::HelveticaBold, "Pion PDF (Wasm32 + Native)")
  p1.text(50.0, 600.0, 11.0, pdf::StandardFont::Courier, "fn smoke() -> Int")
  p1.draw_image(img_rgb, 40.0, 460.0, 120.0, 120.0)
  p1.draw_image(img_mask, 180.0, 460.0, 120.0, 120.0)
  p1.draw_image(img_jpg, 320.0, 460.0, 120.0, 120.0)
  p1.restore()
  match doc.add_page(p1) {
    Ok(_) => ()
    Err(_) => return 4
  }

  let p2 = pdf::Page::letter()
  p2.text(72.0, 720.0, 14.0, pdf::StandardFont::TimesRoman, "Second page on US Letter")
  match doc.add_page(p2) {
    Ok(_) => ()
    Err(_) => return 5
  }

  let out = match doc.encode() {
    Ok(b) => b
    Err(_) => return 6
  }
  let rep = match pdf::validate_pdf(out) {
    Ok(r) => r
    Err(_) => return 7
  }

  let farview_pdf = match
  pdf::encode_pdf_pages([(8, 8, make_rgba(8, 8, 22, 163, 74, 255))]) {
    Ok(b) => b
    Err(_) => return 8
  }
  let rep_fv = match pdf::validate_pdf(farview_pdf) {
    Ok(r) => r
    Err(_) => return 9
  }

  io_println(
    world,
    "pdf_wasm_smoke: OK" +
    " bytes=" +
    out.length().to_string() +
    " objs=" +
    rep.object_count.to_string() +
    " pages=" +
    rep.page_count.to_string() +
    " streams=" +
    rep.stream_count.to_string() +
    " fnv=" +
    fnv1a_64(out).to_string() +
    " fv_bytes=" +
    farview_pdf.length().to_string() +
    " fv_objs=" +
    rep_fv.object_count.to_string() +
    " fv_fnv=" +
    fnv1a_64(farview_pdf).to_string(),
  )
  0
}
