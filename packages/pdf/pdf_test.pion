///| Comprehensive ISO 32000-1 PDF 1.4 specification, filter, security, and limits test suite.

fn pdf_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn pdf_bytes_contains(buf : Bytes, lit : String) -> Bool {
  pdf_find_ascii(buf, 0, buf.length(), lit) >= 0
}

fn make_solid_rgba(w : Int, h : Int, r : Int, g : Int, b : Int, a : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 4)
  let mut i = 0
  while i < w * h {
    out[i * 4] = (r & 0xFF).to_byte()
    out[i * 4 + 1] = (g & 0xFF).to_byte()
    out[i * 4 + 2] = (b & 0xFF).to_byte()
    out[i * 4 + 3] = (a & 0xFF).to_byte()
    i = i + 1
  }
  out
}

fn make_gradient_rgb(w : Int, h : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 3)
  let mut y = 0
  while y < h {
    let mut x = 0
    while x < w {
      let off = (y * w + x) * 3
      out[off] = ((x * 255) / (if w > 1 { w - 1 } else { 1 })).to_byte()
      out[off + 1] = ((y * 255) / (if h > 1 { h - 1 } else { 1 })).to_byte()
      out[off + 2] = (((x + y) * 17) & 0xFF).to_byte()
      x = x + 1
    }
    y = y + 1
  }
  out
}

///| Minimal valid JPEG SOI + SOF0 (2x2 RGB) + EOI bytes for /DCTDecode passthrough test.
fn make_minimal_jpeg_bytes() -> Bytes {
  let vals = [
    0xFF, 0xD8, // SOI
    0xFF, 0xC0, 0x00, 0x11, // SOF0, length=17
    0x08, // precision 8
    0x00, 0x02, // height 2
    0x00, 0x02, // width 2
    0x03, // 3 components (RGB/YCbCr)
    0x01, 0x11, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01, 0xFF, 0xD9, // EOI
  ]
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

test "escape_pdf_string prevents paren, backslash, newline, and control-char injection" {
  debug_assert(escape_pdf_string("Hello World") == "Hello World", "plain ASCII unchanged")
  debug_assert(
    escape_pdf_string("a(b)c\\d") == "a\\(b\\)c\\\\d",
    "parens and backslash escaped",
  )
  // Attempted PDF dictionary / object injection via unbalanced parens and newlines
  let payload = "evil) >> /OpenAction << /S /JavaScript >> (\r\n\t\u{0000}\u{007f}"
  let esc = escape_pdf_string(payload)
  debug_assert(!esc.contains("\n"), "no raw LF")
  debug_assert(!esc.contains("\r"), "no raw CR")
  debug_assert(esc.contains("\\)"), "closing paren escaped")
  debug_assert(esc.contains("\\("), "opening paren escaped")
  debug_assert(esc.contains("\\r\\n\\t"), "CR/LF/TAB escaped")
  debug_assert(esc.contains("\\000"), "NUL octal escaped")
  debug_assert(esc.contains("\\177"), "DEL octal escaped")
}

test "rle_encode and rle_decode PackBits ISO 32000-1 roundtrip and edge cases" {
  // 1. Empty input -> EOD 0x80
  let enc_empty = rle_encode(Bytes::new(0))
  debug_assert(enc_empty.length() == 1 && enc_empty[0].to_int() == 0x80, "empty RLE EOD")
  match rle_decode(enc_empty, 1024) {
    Ok(dec) => debug_assert(dec.length() == 0, "empty RLE decodes empty")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }

  // 2. Long uniform run (> 128 bytes) -> split across multiple run packets
  let mut zeros = Bytes::new(300)
  let mut i = 0
  while i < 300 {
    zeros[i] = 0xAA.to_byte()
    i = i + 1
  }
  let enc_zeros = rle_encode(zeros)
  debug_assert(enc_zeros.length() < 16, "300 identical bytes compress tightly")
  debug_assert(enc_zeros[enc_zeros.length() - 1].to_int() == 0x80, "ends with EOD")
  match rle_decode(enc_zeros, 1024) {
    Ok(dec) => debug_assert(pdf_bytes_eq(dec, zeros), "300-byte run roundtrip")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }

  // 3. Long literal run (> 128 non-repeating bytes) + mixed runs
  let mut mixed = Bytes::new(400)
  let mut j = 0
  while j < 200 {
    mixed[j] = ((j * 37 + 11) & 0xFF).to_byte()
    j = j + 1
  }
  while j < 250 {
    mixed[j] = 0x55.to_byte()
    j = j + 1
  }
  while j < 400 {
    mixed[j] = ((j * 13 + 7) & 0xFF).to_byte()
    j = j + 1
  }
  let enc_mixed = rle_encode(mixed)
  match rle_decode(enc_mixed, 1024) {
    Ok(dec) => debug_assert(pdf_bytes_eq(dec, mixed), "mixed literal+run roundtrip")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }

  // 4. RLE decode enforces max_output_bytes limit
  match rle_decode(enc_zeros, 100) {
    Err(PdfError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on RLE decode")
  }
}

test "flate_encode and flate_decode zlib roundtrip and invalid level check" {
  let msg = "PDF 1.4 /FlateDecode stream content: BT /F1 12 Tf (Hello) Tj ET\n".to_bytes()
  let encoded = match flate_encode(msg, 6) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      Bytes::new(0)
    }
  }
  // RFC 1950 zlib header check: CMF=0x78
  debug_assert(encoded.length() >= 6 && encoded[0].to_int() == 0x78, "valid zlib header")
  match flate_decode(encoded, 4096) {
    Ok(dec) => debug_assert(pdf_bytes_eq(dec, msg), "flate roundtrip exact")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }
  // Invalid level rejected
  match flate_encode(msg, 12) {
    Err(PdfError::CompressionFailed(_)) => ()
    _ => debug_assert(false, "expected CompressionFailed for invalid level 12")
  }
}

test "rgba_to_white_rgb and rgba_split_rgb_alpha pixel conversions" {
  let semi = make_solid_rgba(2, 2, 0, 0, 0, 128)
  let rgb = rgba_to_white_rgb(semi, 2, 2)
  debug_assert(rgb.length() == 12, "2x2 RGB = 12 bytes")
  let expected = (0 * 128 + 255 * 127) / 255
  debug_assert(rgb[0].to_int() == expected, "alpha blend R")
  debug_assert(rgb[1].to_int() == expected, "alpha blend G")
  debug_assert(rgb[2].to_int() == expected, "alpha blend B")

  let (cplane, aplane) = rgba_split_rgb_alpha(make_solid_rgba(2, 2, 10, 20, 30, 200), 2, 2)
  debug_assert(cplane.length() == 12, "RGB plane 12 bytes")
  debug_assert(aplane.length() == 4, "Alpha plane 4 bytes")
  debug_assert(cplane[0].to_int() == 10 && cplane[1].to_int() == 20 && cplane[2].to_int() == 30, "RGB values")
  debug_assert(aplane[0].to_int() == 200 && aplane[3].to_int() == 200, "Alpha values")
}

test "multi-page vector, text, standard 14 fonts, and metadata with strict xref validation" {
  let doc = PdfDoc::new()
  doc.set_title("Quarterly Report (Q4) \\ Final")
  doc.set_author("Pion PDF Engine")
  doc.set_creator("packages/pdf v0.1.0")
  doc.set_compression(Compression::Uncompressed)

  let p1 = Page::a4()
  p1.save()
  p1.set_fill_rgb(0.15, 0.39, 0.92)
  p1.rect(40.0, 740.0, 515.28, 60.0)
  p1.fill()
  p1.set_stroke_rgb(0.1, 0.1, 0.1)
  p1.set_line_width(1.5)
  p1.move_to(40.0, 720.0)
  p1.line_to(555.28, 720.0)
  p1.cubic_to(500.0, 680.0, 100.0, 680.0, 40.0, 640.0)
  p1.close_path()
  p1.stroke()
  p1.restore()

  p1.save()
  p1.rect(40.0, 500.0, 200.0, 100.0)
  p1.clip()
  p1.set_fill_rgb(0.0, 0.0, 0.0)
  p1.text(50.0, 550.0, 18.0, StandardFont::HelveticaBold, "Title: (Hello \\ World)")
  p1.text(50.0, 520.0, 12.0, StandardFont::TimesRoman, "Body line 1")
  p1.text(50.0, 505.0, 10.0, StandardFont::Courier, "code_sample();")
  p1.restore()

  let p2 = Page::letter()
  p2.text(72.0, 720.0, 14.0, StandardFont::Helvetica, "Page 2 on US Letter")

  match doc.add_page(p1) {
    Ok(idx) => debug_assert(idx == 0, "first page index 0")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }
  match doc.add_page(p2) {
    Ok(idx) => debug_assert(idx == 1, "second page index 1")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }

  let pdf = match doc.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      Bytes::new(0)
    }
  }
  let text = pdf.to_string()
  debug_assert(text.starts_with("%PDF-1.4\n"), "PDF 1.4 header")
  debug_assert(text.ends_with("%%EOF\n"), "PDF %%EOF trailer")
  debug_assert(text.contains("/Title (Quarterly Report \\(Q4\\) \\\\ Final)"), "escaped /Title")
  debug_assert(text.contains("/Author (Pion PDF Engine)"), "/Author present")
  debug_assert(text.contains("/BaseFont /Helvetica-Bold"), "Helvetica-Bold font")
  debug_assert(text.contains("/BaseFont /Times-Roman"), "Times-Roman font")
  debug_assert(text.contains("/BaseFont /Courier"), "Courier font")
  debug_assert(text.contains("/BaseFont /Helvetica"), "Helvetica font")
  debug_assert(text.contains("BT "), "text block emitted")
  debug_assert(text.contains(" re\n"), "rect operator emitted")
  debug_assert(text.contains(" c\n"), "cubic bezier operator emitted")
  debug_assert(text.contains("W n\n"), "clip operator emitted")

  match validate_pdf(pdf) {
    Ok(rep) => {
      debug_assert(rep.version == "1.4", "report version 1.4")
      debug_assert(rep.page_count == 2, "report page_count 2")
      debug_assert(rep.stream_count == 2, "report stream_count 2")
      debug_assert(rep.object_count >= 10, "at least 10 objects")
    }
    Err(e) => debug_assert(false, "validate_pdf failed: " + pdf_error_message(e))
  }
}

test "images: RGB FlateDecode, RGBA BlendWhite, RGBA SoftMask /SMask, and JPEG /DCTDecode" {
  let doc = PdfDoc::new()
  doc.set_compression(flate_default())

  let rgb_id = match doc.add_rgb_image(4, 4, make_gradient_rgb(4, 4)) {
    Ok(id) => id
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      ImageId::{ index: -1 }
    }
  }
  let rgba_blend_id = match
  doc.add_rgba_image_with_compression(
    4,
    4,
    make_solid_rgba(4, 4, 255, 0, 0, 128),
    AlphaMode::BlendWhite,
    Compression::RunLength,
  ) {
    Ok(id) => id
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      ImageId::{ index: -1 }
    }
  }
  let rgba_mask_id = match
  doc.add_rgba_image(4, 4, make_solid_rgba(4, 4, 0, 128, 255, 180), AlphaMode::SoftMask) {
    Ok(id) => id
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      ImageId::{ index: -1 }
    }
  }
  let jpeg_id = match doc.add_jpeg_image(2, 2, make_minimal_jpeg_bytes()) {
    Ok(id) => id
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      ImageId::{ index: -1 }
    }
  }

  let p = Page::a4()
  p.draw_image(rgb_id, 40.0, 600.0, 100.0, 100.0)
  p.draw_image(rgba_blend_id, 160.0, 600.0, 100.0, 100.0)
  p.draw_image(rgba_mask_id, 280.0, 600.0, 100.0, 100.0)
  p.draw_image(jpeg_id, 400.0, 600.0, 100.0, 100.0)
  let _ = doc.add_page(p)

  let pdf = match doc.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(pdf_bytes_contains(pdf, "/Filter /FlateDecode"), "FlateDecode present")
  debug_assert(pdf_bytes_contains(pdf, "/Filter /RunLengthDecode"), "RunLengthDecode present")
  debug_assert(pdf_bytes_contains(pdf, "/Filter /DCTDecode"), "DCTDecode present")
  debug_assert(pdf_bytes_contains(pdf, "/SMask "), "/SMask reference present")
  debug_assert(pdf_bytes_contains(pdf, "/ColorSpace /DeviceGray"), "SMask DeviceGray present")

  match validate_pdf(pdf) {
    Ok(rep) => {
      debug_assert(rep.page_count == 1, "1 page")
      // 1 content stream + 4 images + 1 smask = 6 streams
      debug_assert(rep.stream_count == 6, "6 streams")
    }
    Err(e) => debug_assert(false, "validate_pdf failed: " + pdf_error_message(e))
  }
}

test "Farview convenience encode_pdf_pages works with RunLengthDecode and FlateDecode" {
  let pages = [
    (8, 8, make_solid_rgba(8, 8, 0x25, 0x63, 0xEB, 0xFF)),
    (8, 8, make_solid_rgba(8, 8, 0x16, 0xA3, 0x4A, 0xFF)),
  ]
  let pdf_rle = match encode_pdf_pages(pages) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(pdf_bytes_contains(pdf_rle, "/Filter /RunLengthDecode"), "default RLE")
  match validate_pdf(pdf_rle) {
    Ok(rep) => debug_assert(rep.page_count == 2, "2 pages in RLE PDF")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }

  let pdf_flate = match encode_pdf_pages_with_compression(pages, flate_default()) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, pdf_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(pdf_bytes_contains(pdf_flate, "/Filter /FlateDecode"), "FlateDecode option")
  match validate_pdf(pdf_flate) {
    Ok(rep) => debug_assert(rep.page_count == 2, "2 pages in Flate PDF")
    Err(e) => debug_assert(false, pdf_error_message(e))
  }
}

test "limits and error validation reject oversized docs, bad dimensions, and corrupted xref" {
  // 1. max_pages enforced
  let tight_pages = PdfDoc::with_limits(Limits::{ ..Limits::default(), max_pages: 1 })
  let _ = tight_pages.add_page(Page::a4())
  match tight_pages.add_page(Page::a4()) {
    Err(PdfError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_pages=1")
  }

  // 2. max_image_pixels enforced
  let tight_img = PdfDoc::with_limits(Limits::{ ..Limits::default(), max_image_pixels: 10 })
  match tight_img.add_rgb_image(4, 4, make_gradient_rgb(4, 4)) {
    Err(PdfError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_image_pixels=10")
  }

  // 3. max_document_bytes enforced
  let tight_doc = PdfDoc::with_limits(Limits::{ ..Limits::default(), max_document_bytes: 128 })
  let _ = tight_doc.add_page(Page::a4())
  match tight_doc.encode() {
    Err(PdfError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_document_bytes=128")
  }

  // 4. Invalid page dimensions & invalid image buffer length & invalid JPEG
  let doc = PdfDoc::new()
  match doc.add_page(Page::new(0.0, 100.0)) {
    Err(PdfError::InvalidDimension(_)) => ()
    _ => debug_assert(false, "expected InvalidDimension for width=0")
  }
  match doc.add_rgb_image(4, 4, Bytes::new(10)) {
    Err(PdfError::InvalidImage(_)) => ()
    _ => debug_assert(false, "expected InvalidImage for short RGB buffer")
  }
  match doc.add_jpeg_image(4, 4, "not a jpeg".to_bytes()) {
    Err(PdfError::InvalidImage(_)) => ()
    _ => debug_assert(false, "expected InvalidImage for non-JPEG bytes")
  }

  // 5. Validator detects corrupted xref offset
  let ok_doc = PdfDoc::new()
  let _ = ok_doc.add_page(Page::a4())
  let valid_pdf = match ok_doc.encode() {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  // Corrupt the first xref offset digit if valid_pdf is non-empty
  let mut corrupted = Bytes::new(valid_pdf.length())
  let mut i = 0
  while i < valid_pdf.length() {
    corrupted[i] = valid_pdf[i]
    i = i + 1
  }
  // Flip a byte inside "1 0 obj" -> "X 0 obj" so xref offset no longer matches object header
  let s = valid_pdf.to_string()
  if s.contains("1 0 obj") {
    let mut k = 0
    while k + 7 <= corrupted.length() {
      if corrupted[k].to_int() == 49 &&
      corrupted[k + 1].to_int() == 32 &&
      corrupted[k + 2].to_int() == 48 &&
      corrupted[k + 3].to_int() == 32 &&
      corrupted[k + 4].to_int() == 111 &&
      corrupted[k + 5].to_int() == 98 &&
      corrupted[k + 6].to_int() == 106 {
        corrupted[k] = 88.to_byte() // 'X'
        break
      }
      k = k + 1
    }
    match validate_pdf(corrupted) {
      Err(PdfError::ValidationFailed(_)) => ()
      _ => debug_assert(false, "validator must reject corrupted object at xref offset")
    }
  }
}
