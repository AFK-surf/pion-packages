///| Red-team regression tests for packages/pdf @ 08cad250 (branch feat/pkg-pdf).
///
/// `p0_*` / `p1_*` / `p2_*` tests assert the behaviour a hardened PDF writer must have (ISO 32000-1,
/// PDF 1.4 reference Annex C, and what the Rust `lopdf =0.35.0` oracle in `rust/` reads back); a
/// FAILURE here is the evidence. `control_*` tests are attacks the package survived; they must keep
/// passing. Hangs, OOMs and timings are reproduced by `run_audit.sh` through `probe/` (they would take
/// the test runner down), see REPORT.md.

import "pdf"

///|
fn has(buf : Bytes, lit : String) -> Bool {
  find(buf, lit) >= 0
}

///|
fn find(buf : Bytes, lit : String) -> Int {
  let pat = lit.to_bytes()
  let n = buf.length()
  let m = pat.length()
  let mut i = 0
  while i + m <= n {
    let mut j = 0
    while j < m && buf[i + j] == pat[j] {
      j = j + 1
    }
    if j == m {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn bytes_of(vals : Array[Int]) -> Bytes {
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = (vals[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn encode_ok(doc : pdf::PdfDoc) -> Bytes {
  match doc.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode failed: " + pdf::pdf_error_message(e))
      Bytes::new(0)
    }
  }
}

///| Content stream of a one-page document, uncompressed.
fn one_page(page : pdf::Page) -> Bytes {
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  let _ = doc.add_page(page)
  encode_ok(doc)
}

///| SOI + optional Adobe APP14 + SOFn(16x8, `comps` components) + EOI.
fn jpeg(sof : Int, comps : Int, adobe : Bool) -> Bytes {
  let head = [0xFF, 0xD8]
  if adobe {
    let app14 = [0xFF, 0xEE, 0x00, 0x0E, 0x41, 0x64, 0x6F, 0x62, 0x65, 0x00, 0x64, 0x00, 0x00, 0x00, 0x00, 0x02]
    let mut k = 0
    while k < app14.length() {
      head.push(app14[k])
      k = k + 1
    }
  }
  let seg_len = 8 + comps * 3
  head.push(0xFF)
  head.push(sof)
  head.push(seg_len >> 8)
  head.push(seg_len & 0xFF)
  head.push(8)
  head.push(0)
  head.push(8) // height 8
  head.push(0)
  head.push(16) // width 16
  head.push(comps)
  let mut c = 0
  while c < comps {
    head.push(c + 1)
    head.push(0x11)
    head.push(0)
    c = c + 1
  }
  head.push(0xFF)
  head.push(0xD9)
  bytes_of(head)
}

///|
fn pad(v : Int) -> String {
  let s = v.to_string()
  let mut z = ""
  let mut i = s.length()
  while i < 10 {
    z = z + "0"
    i = i + 1
  }
  z + s
}

///| A minimal well-formed document whose single stream declares `/Length len`.
fn pdf_with_stream_length(len : String) -> Bytes {
  let p1 = "%PDF-1.4\n"
  let o1 = "1 0 obj\n<</Type /Catalog /Pages 2 0 R>>\nendobj\n"
  let o2 = "2 0 obj\n<</Type /Pages /Count 0 /Kids []>>\nendobj\n"
  let o3 = "3 0 obj\n<</Length " + len + ">>\nstream\nxx\nendstream\nendobj\n"
  let off1 = p1.length()
  let off2 = off1 + o1.length()
  let off3 = off2 + o2.length()
  let xr = off3 + o3.length()
  let tail = "xref\n0 4\n0000000000 65535 f \n" +
  pad(off1) +
  " 00000 n \n" +
  pad(off2) +
  " 00000 n \n" +
  pad(off3) +
  " 00000 n \ntrailer\n<</Size 4 /Root 1 0 R>>\nstartxref\n" +
  xr.to_string() +
  "\n%%EOF\n"
  (p1 + o1 + o2 + o3 + tail).to_bytes()
}

// ───────────────────────────── P0 ─────────────────────────────

///| validate_pdf: `/Length 2147483600` wraps `s_data_start + slen` negative, then `pdf[es_pos]` with
///| es_pos < 0 aborts the process (`pion panic: index -2147483552 out of bounds`). 305-byte input.
test "p0_validate_pdf_length_overflow_panics" {
  match pdf::validate_pdf(pdf_with_stream_length("2147483600")) {
    Ok(_) => debug_assert(false, "a stream whose /Length exceeds the file must be rejected")
    Err(_) => ()
  }
}

// ───────────────────────────── P1 ─────────────────────────────

///| Public helper: `width * height` (and `* 3`) overflows 32-bit `Int`, `Bytes::new(negative)` aborts.
test "p1_rgba_to_white_rgb_dims_overflow_panics" {
  let out = pdf::rgba_to_white_rgb(Bytes::new(0), 40000, 20000)
  debug_assert(out.length() == 0, "800M px must be rejected/empty, not abort")
}

///|
test "p1_rgba_split_rgb_alpha_dims_overflow_panics" {
  let (rgb, a) = pdf::rgba_split_rgb_alpha(Bytes::new(0), 46341, 46341)
  debug_assert(rgb.length() == 0 && a.length() == 0, "2.1G px must be rejected/empty, not abort")
}

///| add_jpeg_image trusts caller width/height; SOF says 16x8. The XObject is written as 4000x3000.
test "p1_jpeg_dimensions_not_checked_against_sof" {
  let doc = pdf::PdfDoc::new()
  match doc.add_jpeg_image(4000, 3000, jpeg(0xC0, 3, false)) {
    Ok(_) => debug_assert(false, "declared 4000x3000 but SOF0 is 16x8: must be rejected (or SOF size used)")
    Err(_) => ()
  }
}

///| Adobe APP14 CMYK JPEGs (Photoshop, PIL) store inverted CMYK; without `/Decode [1 0 1 0 1 0 1 0]`
///| every viewer paints the photographic negative.
test "p1_adobe_cmyk_jpeg_missing_decode_inversion" {
  let doc = pdf::PdfDoc::new()
  let id = match doc.add_jpeg_image(16, 8, jpeg(0xC0, 4, true)) {
    Ok(i) => i
    Err(e) => {
      debug_assert(false, pdf::pdf_error_message(e))
      return
    }
  }
  let page = pdf::Page::a4()
  page.draw_image(id, 0.0, 0.0, 16.0, 8.0)
  let _ = doc.add_page(page)
  let out = encode_ok(doc)
  debug_assert(has(out, "/DeviceCMYK"), "CMYK detected")
  debug_assert(has(out, "/Decode [1 0 1 0 1 0 1 0]"), "Adobe CMYK JPEG needs an inverting /Decode array")
}

///| add_page rejects NaN and <= 0 but accepts +Inf / 1e20 / 1e-12; write_num then prints `0`,
///| producing `/MediaBox [0 0 0 100]` (a zero-area page).
test "p1_add_page_accepts_infinite_and_unrepresentable_sizes" {
  let inf = 1.0 / 0.0
  let sizes = [inf, 1.0e20, 1.0e-12, 0.00004]
  let mut accepted = ""
  let mut i = 0
  while i < sizes.length() {
    let doc = pdf::PdfDoc::new()
    match doc.add_page(pdf::Page::new(sizes[i], 100.0)) {
      Ok(_) => accepted = accepted + "#" + i.to_string() + " "
      Err(_) => ()
    }
    i = i + 1
  }
  debug_assert(accepted == "", "page widths that serialize as MediaBox width 0 were accepted: " + accepted)
}

///| Text is written as raw UTF-8 bytes into a /WinAnsiEncoding font: "é" (U+00E9) renders as "Ã©".
test "p1_text_utf8_bytes_under_winansi_mojibake" {
  let page = pdf::Page::a4()
  page.text(10.0, 10.0, 12.0, pdf::StandardFont::Helvetica, "café €")
  let out = one_page(page)
  debug_assert(!has(out, "\\303\\251"), "UTF-8 bytes C3 A9 emitted for é (shows as Ã©)")
  debug_assert(has(out, "caf\\351 \\200"), "WinAnsi: é = \\351, € = \\200")
}

///| /Info text strings without a UTF-16BE BOM are PDFDocEncoding (§7.9.2.2): UTF-8 bytes turn to mojibake.
test "p1_info_non_ascii_not_encoded_as_text_string" {
  let doc = pdf::PdfDoc::new()
  doc.set_title("Résumé 中文")
  let out = encode_ok(doc)
  debug_assert(
    has(out, "/Title (\\376\\377") || has(out, "/Title <FEFF"),
    "non-ASCII /Title must be UTF-16BE with BOM",
  )
}

///| 4-decimal fixed point: a 1e-5 scale (pt -> 1/100000 user units, or any small-scale cm) becomes the
///| singular matrix `0 0 0 0 0 0 cm`; everything after it is invisible / an error in strict viewers.
test "p1_small_scale_matrix_becomes_singular_cm" {
  let page = pdf::Page::a4()
  page.concat_matrix(0.00001, 0.0, 0.0, 0.00001, 0.0, 0.0)
  let out = one_page(page)
  debug_assert(!has(out, "0 0 0 0 0 0 cm"), "non-singular matrix serialized as singular")
}

// ───────────────────────────── P2 ─────────────────────────────

///| NaN / ±Inf / |v| > 1e14 are silently written as `0` instead of being rejected (line width, colour, size).
test "p2_non_finite_and_huge_numbers_silently_zero" {
  let page = pdf::Page::a4()
  page.set_line_width(0.0 / 0.0)
  page.set_line_width(1.0e20)
  page.text(0.0, 0.0, 1.0 / 0.0, pdf::StandardFont::Helvetica, "x")
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  let _ = doc.add_page(page)
  match doc.encode() {
    Ok(out) =>
    debug_assert(
      !has(out, "\n0 w\n0 w\n") && !has(out, "/F1 0 Tf"),
      "NaN/1e20 line width and Inf font size silently became 0",
    )
    Err(_) => ()
  }
}

///| write_num: `(abs * 10000 + 0.5).to_int64()` exceeds 2^53, so 99999999999999.0 prints `...999.0016`.
test "p2_write_num_spurious_fraction_digits" {
  let page = pdf::Page::a4()
  page.set_line_width(99999999999999.0)
  let out = one_page(page)
  debug_assert(!has(out, "99999999999999.0016"), "spurious digits from double precision loss")
}

///| Line cap/join outside 0..2 and negative dash lengths are emitted verbatim (invalid operands).
test "p2_line_cap_join_dash_unvalidated" {
  let page = pdf::Page::a4()
  page.set_line_cap(99)
  page.set_line_join(-7)
  page.set_dash([-3.0, 0.0], 0.0)
  let out = one_page(page)
  debug_assert(!has(out, "99 J") && !has(out, "-7 j") && !has(out, "[-3 0]"), "invalid operands emitted")
}

///| MediaBox above PDF 1.4 Annex C's 14400-unit limit is accepted.
test "p2_page_size_above_14400_accepted" {
  let doc = pdf::PdfDoc::new()
  match doc.add_page(pdf::Page::new(20000.0, 20000.0)) {
    Ok(_) => debug_assert(false, "20000pt page accepted (max 14400 in PDF 1.4)")
    Err(_) => ()
  }
}

///| `encode()` on a document with no page succeeds (`/Count 0 /Kids []`).
test "p2_zero_page_document_encodes" {
  match pdf::PdfDoc::new().encode() {
    Ok(_) => debug_assert(false, "0-page PDF emitted without error")
    Err(_) => ()
  }
}

///| `Page` is a shared mutable reference: drawing after `add_page` changes the already-added page, and
///| adding the same Page twice shares one content stream.
test "p2_page_mutable_after_add_page" {
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  let page = pdf::Page::a4()
  let _ = doc.add_page(page)
  page.text(0.0, 0.0, 9.0, pdf::StandardFont::Helvetica, "late")
  let out = encode_ok(doc)
  debug_assert(!has(out, "(late)"), "content drawn after add_page leaked into the document")
}

///| ImageId is a bare index: an id from document A silently draws document B's image with that index.
test "p2_foreign_image_id_draws_wrong_image" {
  let a = pdf::PdfDoc::new()
  let b = pdf::PdfDoc::new()
  let _ = b.add_rgb_image(1, 1, bytes_of([1, 2, 3]))
  let foreign = match a.add_rgb_image(2, 1, bytes_of([1, 2, 3, 4, 5, 6])) {
    Ok(i) => i
    Err(_) => return
  }
  let page = pdf::Page::a4()
  page.draw_image(foreign, 0.0, 0.0, 1.0, 1.0)
  let _ = b.add_page(page)
  match b.encode() {
    Ok(_) => debug_assert(false, "ImageId from another PdfDoc accepted")
    Err(_) => ()
  }
}

///| `restore()` without `save()` (Q underflow) and unclosed `q` are not tracked.
test "p2_unbalanced_graphics_state_not_detected" {
  let page = pdf::Page::a4()
  page.restore()
  page.save()
  page.save()
  let doc = pdf::PdfDoc::new()
  let _ = doc.add_page(page)
  match doc.encode() {
    Ok(_) => debug_assert(false, "Q underflow / unbalanced q accepted")
    Err(_) => ()
  }
}

///| Arithmetic-coded SOF9..SOF11 / lossless SOF5..7 are not inspected: a 4-component SOF9 is tagged RGB;
///| a 2-component SOF0 (no PDF colour space exists) is also tagged RGB instead of rejected.
test "p2_jpeg_colorspace_detection_gaps" {
  let mut bad = ""
  let doc = pdf::PdfDoc::new()
  let cases = [(0xC9, 4, "/DeviceCMYK"), (0xC1, 1, "/DeviceGray")]
  let mut i = 0
  while i < cases.length() {
    let (sof, comps, want) = cases[i]
    let d = pdf::PdfDoc::new()
    match d.add_jpeg_image(16, 8, jpeg(sof, comps, false)) {
      Ok(id) => {
        let page = pdf::Page::a4()
        page.draw_image(id, 0.0, 0.0, 1.0, 1.0)
        let _ = d.add_page(page)
        if !has(encode_ok(d), want) {
          bad = bad + "SOF" + (sof - 0xC0).to_string() + " not " + want + "; "
        }
      }
      Err(_) => ()
    }
    i = i + 1
  }
  match doc.add_jpeg_image(16, 8, jpeg(0xC0, 2, false)) {
    Ok(_) => bad = bad + "2-component JPEG accepted as RGB; "
    Err(_) => ()
  }
  match doc.add_jpeg_image(16, 8, bytes_of([0xFF, 0xD8, 0x00, 0x00, 0x13, 0x37])) {
    Ok(_) => bad = bad + "JPEG with no SOF accepted; "
    Err(_) => ()
  }
  debug_assert(bad == "", bad)
}

///| Limits are only consulted in `encode()`: images are compressed and retained at `add_*` time without a
///| document budget, so a 64 KiB `max_document_bytes` doc still holds 8 MiB of image data before failing.
test "p2_limits_checked_after_data_is_retained" {
  let lim = pdf::Limits::{ ..pdf::Limits::default(), max_document_bytes: 65536 }
  let doc = pdf::PdfDoc::with_limits(lim)
  doc.set_compression(pdf::Compression::Uncompressed)
  let px = Bytes::new(512 * 512 * 3)
  let mut accepted = 0
  let mut i = 0
  while i < 10 {
    match doc.add_rgb_image(512, 512, px) {
      Ok(_) => accepted = accepted + 1
      Err(_) => ()
    }
    i = i + 1
  }
  debug_assert(accepted <= 1, accepted.to_string() + " x 786 KiB images retained under a 64 KiB document limit")
}

///| `0` means "unlimited" for rle_decode/flate_decode limits (and every Limits field); negative Limits fields too.
test "p2_zero_limit_means_unlimited" {
  let enc = pdf::rle_encode(Bytes::new(100000))
  match pdf::rle_decode(enc, 0) {
    Ok(b) => debug_assert(b.length() == 0, "limit 0 decoded " + b.length().to_string() + " bytes")
    Err(_) => ()
  }
}

///| validate_pdf truncates 10-digit xref offsets with `.to_int()`: offset + 2^32 aliases a valid offset.
test "p2_validate_xref_offset_truncation_alias" {
  let ok = pdf_with_stream_length("2")
  // first in-use entry is "0000000009 00000 n"; 4294967305 = 9 + 2^32
  let at = find(ok, "0000000009 00000 n")
  let alias = "4294967305".to_bytes()
  let mut bad = Bytes::new(ok.length())
  let mut i = 0
  while i < ok.length() {
    bad[i] = if i >= at && i < at + 10 { alias[i - at] } else { ok[i] }
    i = i + 1
  }
  debug_assert(at > 0, "fixture layout")
  match pdf::validate_pdf(bad) {
    Ok(_) => debug_assert(false, "xref offset 4294967305 accepted as 9")
    Err(_) => ()
  }
}

// ───────────────────────────── controls ─────────────────────────────

///| Every payload stays one literal string: no raw `(`/`)`/CR/LF/backslash survives unescaped.
test "control_string_escaping_closes_every_injection" {
  let payloads = [
    ") /JS (app.alert(1)) /S /JavaScript /Z (",
    "\\) /OpenAction 99 0 R /Q (\\",
    "unbalanced ((( no close",
    "trailing backslash \\",
    "CR\rLF\n>>\nendobj\n9 0 obj",
    "NUL\u{0}x\u{7F}",
    "中文 😀",
  ]
  let mut i = 0
  while i < payloads.length() {
    let esc = pdf::escape_pdf_string(payloads[i]).to_bytes()
    let mut j = 0
    while j < esc.length() {
      let b = esc[j].to_int() & 0xFF
      if b == 92 {
        j = j + 2
        continue
      }
      debug_assert(b != 40 && b != 41 && b >= 32 && b < 127, "unescaped byte " + b.to_string() + " in payload " + i.to_string())
      j = j + 1
    }
    i = i + 1
  }
}

///| Info + Tj injection payloads still yield a structurally valid document with exactly the expected keys.
test "control_injection_document_validates" {
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  doc.set_title(") /JS (x) /S /JavaScript (")
  doc.set_author("\\")
  let page = pdf::Page::a4()
  page.text(0.0, 0.0, 9.0, pdf::StandardFont::Helvetica, ") Tj ET BT (")
  let _ = doc.add_page(page)
  let out = encode_ok(doc)
  match pdf::validate_pdf(out) {
    Ok(r) => debug_assert(r.page_count == 1, "one page")
    Err(e) => debug_assert(false, pdf::pdf_error_message(e))
  }
  debug_assert(!has(out, "(x) /S /JavaScript ("), "JS key injected")
}

///| No `nan`, `inf` or exponent ever reaches the content stream.
test "control_numbers_never_nan_inf_or_exponent" {
  let page = pdf::Page::a4()
  let vals = [0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 1.0e-12, 1.0e20, -0.0, 1.0e300, -1.0e-300, 123456.789]
  let mut i = 0
  while i < vals.length() {
    page.move_to(vals[i], vals[i])
    i = i + 1
  }
  let out = one_page(page)
  debug_assert(!has(out, "nan") && !has(out, "inf") && !has(out, "e+") && !has(out, "e-") && !has(out, "-0 "), "bad number token")
}

///| Image dimension overflow / mismatch is rejected before any allocation in PdfDoc.
test "control_image_dimension_overflow_rejected" {
  let doc = pdf::PdfDoc::new()
  let tiny = Bytes::new(12)
  let cases = [(65536, 65536), (46341, 46341), (0, 5), (-1, -1), (2147483647, 2), (2, 2)]
  let mut i = 0
  while i < cases.length() {
    let (w, h) = cases[i]
    let r1 = doc.add_rgba_image(w, h, tiny, pdf::AlphaMode::SoftMask)
    let r2 = doc.add_rgb_image(w, h, tiny)
    if w == 2 {
      debug_assert(r1.is_err() && r2.is_ok(), "2x2: rgba needs 16 bytes (12 given), rgb 12 ok")
    } else {
      debug_assert(r1.is_err() && r2.is_err(), "dims " + w.to_string() + "x" + h.to_string() + " accepted")
    }
    i = i + 1
  }
}

///| RunLength / Flate decoders: truncation is an error, limits hold, zlib bomb is capped.
test "control_filters_truncation_and_bombs" {
  debug_assert(pdf::rle_decode(bytes_of([5, 1, 2]), 0).is_err(), "truncated literal")
  debug_assert(pdf::rle_decode(bytes_of([200]), 0).is_err(), "truncated repeat")
  debug_assert(pdf::rle_decode(bytes_of([129, 7]), 64).is_err(), "128-byte run vs 64 limit")
  debug_assert(pdf::rle_decode(bytes_of([128, 1, 2]), 0).is_ok(), "EOD stops")
  let bomb = match pdf::flate_encode(Bytes::new(4194304), 9) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(pdf::flate_decode(bomb, 65536).is_err(), "4 MiB zlib bomb vs 64 KiB limit")
  let rt = pdf::rle_encode(bytes_of([1, 1, 1, 1, 2, 3, 4, 4, 4, 9]))
  match pdf::rle_decode(rt, 0) {
    Ok(b) => debug_assert(b.length() == 10, "roundtrip")
    Err(_) => debug_assert(false, "roundtrip")
  }
}

///| 4000 random marker soups after SOI: JPEG SOF scanning never crashes.
test "control_jpeg_marker_fuzz_no_crash" {
  let mut seed = 12345
  let mut n = 0
  while n < 4000 {
    let len = 2 + seed % 40
    let v = [0xFF, 0xD8]
    let mut k = 0
    while k < len {
      seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
      let r = seed >> 16
      v.push(if r % 3 == 0 { 0xFF } else if r % 5 == 0 { 0xC0 + r % 4 } else { r & 0xFF })
      k = k + 1
    }
    let doc = pdf::PdfDoc::new()
    let _ = doc.add_jpeg_image(1, 1, bytes_of(v))
    n = n + 1
  }
}

///| Forged negative / out-of-range ImageId is rejected at encode.
test "control_out_of_range_image_id_rejected" {
  let doc = pdf::PdfDoc::new()
  let page = pdf::Page::a4()
  page.draw_image(pdf::ImageId::{ index: -1 }, 0.0, 0.0, 1.0, 1.0)
  let _ = doc.add_page(page)
  debug_assert(doc.encode().is_err(), "ImageId(-1)")
}

///| Self-produced multi-page / SMask / JPEG / RLE document passes the strict validator.
test "control_complex_document_self_validates" {
  let doc = pdf::PdfDoc::new()
  let rgba = Bytes::new(8 * 8 * 4)
  let i1 = match doc.add_rgba_image(8, 8, rgba, pdf::AlphaMode::SoftMask) {
    Ok(i) => i
    Err(_) => return
  }
  let i2 = match doc.add_jpeg_image(16, 8, jpeg(0xC2, 3, false)) {
    Ok(i) => i
    Err(_) => return
  }
  let mut p = 0
  while p < 5 {
    let page = pdf::Page::letter()
    if p == 3 {
      page.set_compression(pdf::Compression::RunLength)
    }
    page.draw_image(i1, 0.0, 0.0, 8.0, 8.0)
    page.draw_image(i2, 10.0, 0.0, 16.0, 8.0)
    page.text(0.0, 100.0, 9.0, pdf::StandardFont::ZapfDingbats, "(x)")
    let _ = doc.add_page(page)
    p = p + 1
  }
  match pdf::validate_pdf(encode_ok(doc)) {
    Ok(r) => debug_assert(r.page_count == 5, "5 pages")
    Err(e) => debug_assert(false, pdf::pdf_error_message(e))
  }
}

///| Regression guard for the P0 fixture: the same document with a correct /Length validates.
test "control_validate_correct_length_ok" {
  debug_assert(pdf::validate_pdf(pdf_with_stream_length("2")).is_ok(), "baseline fixture")
}
