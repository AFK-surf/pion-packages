///| Red-team probe for `packages/pdf` (fixture generator + crash / DoS entry points).
///|
///|   gen <out_dir> [gray.jpg rgb.jpg cmyk.jpg prog.jpg] : write adversarial fixtures for the lopdf oracle
///|   validate <file>                                     : run `pdf::validate_pdf` on an arbitrary file
///|   rle <file> <limit>                                  : run `pdf::rle_decode` on an arbitrary file
///|   flate <file> <limit>                                : run `pdf::flate_decode` on an arbitrary file
///|   rgba <w> <h>                                        : call the public `rgba_to_white_rgb` helper
///|   split <w> <h>                                       : call the public `rgba_split_rgb_alpha` helper
///|   bigtext <MiB>                                       : grow one page ContentStream to N MiB, then encode
///|   perf                                                : phase breakdown of the bench workloads (best of 5, ms)

import "pdf"

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut neg = false
  let mut i = 0
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///|
fn make_rgba(w : Int, h : Int, seed : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 4)
  let mut i = 0
  while i < w * h {
    out[i * 4] = ((i * 7 + seed) & 0xFF).to_byte()
    out[i * 4 + 1] = ((i * 13 + seed * 3) & 0xFF).to_byte()
    out[i * 4 + 2] = ((i * 29) & 0xFF).to_byte()
    out[i * 4 + 3] = ((i * 5 + 64) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn make_rgb(w : Int, h : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 3)
  let mut i = 0
  while i < w * h * 3 {
    out[i] = ((i * 11) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn emit(world : World, dir : String, name : String, r : Result[Bytes, pdf::PdfError]) -> Unit {
  match r {
    Ok(b) => {
      let _ = fs_write_bytes(world, dir + "/" + name, b)
      let v = match pdf::validate_pdf(b) {
        Ok(rep) =>
        "valid pages=" +
        rep.page_count.to_string() +
        " objs=" +
        rep.object_count.to_string()
        Err(e) => "INVALID " + pdf::pdf_error_message(e)
      }
      io_println(world, "gen " + name + " bytes=" + b.length().to_string() + " self_validate=" + v)
    }
    Err(e) => io_println(world, "gen " + name + " ERR " + pdf::pdf_error_message(e))
  }
}

///| String-escape attack payloads, shared by /Info and Tj.
fn payloads() -> Array[String] {
  [
    ") /JS (app.alert(1)) /S /JavaScript /Z (",
    "\\) /OpenAction 99 0 R /Q (\\",
    "unbalanced ((( no close",
    "unbalanced ))) no open",
    "trailing backslash \\",
    "CR\rLF\nCRLF\r\n>>\nendobj\n9 0 obj\n<</Type /Action>>",
    "NUL\u{0}inside and \u{7F} DEL and \t tab",
    "ET BT /F1 99 Tf (pwn) Tj",
    "héllo — “quotes” €",
    "中文 😀",
  ]
}

///|
fn gen_inject(world : World, dir : String) -> Unit {
  let p = payloads()
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  doc.set_title(p[0])
  doc.set_author(p[1])
  doc.set_subject(p[5])
  doc.set_keywords(p[6])
  doc.set_creator(p[2] + p[3] + p[4])
  doc.set_producer(p[8] + " " + p[9])
  let page = pdf::Page::a4()
  let mut i = 0
  while i < p.length() {
    page.text(40.0, 800.0 - i.to_double() * 20.0, 10.0, pdf::StandardFont::Helvetica, p[i])
    i = i + 1
  }
  let _ = doc.add_page(page)
  emit(world, dir, "inject.pdf", doc.encode())
}

///|
fn gen_floats(world : World, dir : String) -> Unit {
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  let doc = pdf::PdfDoc::new()
  doc.set_compression(pdf::Compression::Uncompressed)
  let page = pdf::Page::a4()
  // one operator per line; the oracle reads them back in order
  page.set_line_width(nan)
  page.set_line_width(inf)
  page.set_line_width(-inf)
  page.set_line_width(1.0e-12)
  page.set_line_width(1.0e20)
  page.set_line_width(-0.0)
  page.set_line_width(0.00004)
  page.set_line_width(0.00005)
  page.set_line_width(99999999999999.0)
  page.set_line_width(100000000000001.0)
  page.set_line_width(-123.45678)
  page.set_line_width(2147483648.5)
  page.set_fill_rgb(nan, inf, -inf)
  page.concat_matrix(0.00001, 0.0, 0.0, 0.00001, 0.0, 0.0)
  page.set_line_cap(99)
  page.set_line_join(-7)
  page.set_dash([], 0.0)
  page.set_dash([nan, -3.0], inf)
  page.text(10.0, 10.0, nan, pdf::StandardFont::Courier, "nan size")
  page.rect(0.0, 0.0, 1.0e300, -1.0e300)
  page.fill()
  let _ = doc.add_page(page)
  emit(world, dir, "floats.pdf", doc.encode())

  // Page dimensions: +Inf / 1e20 / tiny pass add_page (only NaN and <= 0 are rejected)
  let d2 = pdf::PdfDoc::new()
  let sizes = [(inf, 100.0), (1.0e20, 100.0), (1.0e-12, 100.0), (0.00004, 100.0), (14400.5, 14400.5)]
  let mut k = 0
  while k < sizes.length() {
    let (w, h) = sizes[k]
    match d2.add_page(pdf::Page::new(w, h)) {
      Ok(_) => io_println(world, "add_page size#" + k.to_string() + " accepted")
      Err(e) => io_println(world, "add_page size#" + k.to_string() + " rejected: " + pdf::pdf_error_message(e))
    }
    k = k + 1
  }
  emit(world, dir, "page_sizes.pdf", d2.encode())
}

///|
fn gen_images(world : World, dir : String, jpegs : Array[Bytes]) -> Unit {
  let doc = pdf::PdfDoc::new()
  let ids : Array[pdf::ImageId] = []
  match doc.add_rgb_image(17, 9, make_rgb(17, 9)) {
    Ok(id) => ids.push(id)
    Err(e) => io_println(world, "rgb ERR " + pdf::pdf_error_message(e))
  }
  match
  doc.add_rgba_image(13, 11, make_rgba(13, 11, 1), pdf::AlphaMode::SoftMask) {
    Ok(id) => ids.push(id)
    Err(e) => io_println(world, "smask ERR " + pdf::pdf_error_message(e))
  }
  match
  doc.add_rgba_image_with_compression(
    13,
    11,
    make_rgba(13, 11, 2),
    pdf::AlphaMode::BlendWhite,
    pdf::Compression::RunLength,
  ) {
    Ok(id) => ids.push(id)
    Err(e) => io_println(world, "rle ERR " + pdf::pdf_error_message(e))
  }
  match
  doc.add_rgba_image_with_compression(
    5,
    3,
    make_rgba(5, 3, 3),
    pdf::AlphaMode::SoftMask,
    pdf::Compression::Uncompressed,
  ) {
    Ok(id) => ids.push(id)
    Err(e) => io_println(world, "raw ERR " + pdf::pdf_error_message(e))
  }
  // Real JPEGs from PIL: gray / rgb / cmyk(Adobe, inverted) / progressive; declared size = true size 16x8
  let mut j = 0
  while j < jpegs.length() {
    match doc.add_jpeg_image(16, 8, jpegs[j]) {
      Ok(id) => ids.push(id)
      Err(e) => io_println(world, "jpeg#" + j.to_string() + " ERR " + pdf::pdf_error_message(e))
    }
    j = j + 1
  }
  // Same rgb JPEG but with a lying width/height (no SOF cross-check)
  if jpegs.length() > 1 {
    match doc.add_jpeg_image(4000, 3000, jpegs[1]) {
      Ok(id) => ids.push(id)
      Err(e) => io_println(world, "jpeg-lie ERR " + pdf::pdf_error_message(e))
    }
  }
  let page = pdf::Page::a4()
  let mut k = 0
  while k < ids.length() {
    page.draw_image(ids[k], 20.0 + (k % 4).to_double() * 130.0, 600.0 - (k / 4).to_double() * 130.0, 120.0, 120.0)
    k = k + 1
  }
  let _ = doc.add_page(page)
  emit(world, dir, "images.pdf", doc.encode())
}

///|
fn gen_vector14(world : World, dir : String) -> Unit {
  let fonts = [
    pdf::StandardFont::Helvetica,
    pdf::StandardFont::HelveticaBold,
    pdf::StandardFont::HelveticaOblique,
    pdf::StandardFont::HelveticaBoldOblique,
    pdf::StandardFont::TimesRoman,
    pdf::StandardFont::TimesBold,
    pdf::StandardFont::TimesItalic,
    pdf::StandardFont::TimesBoldItalic,
    pdf::StandardFont::Courier,
    pdf::StandardFont::CourierBold,
    pdf::StandardFont::CourierOblique,
    pdf::StandardFont::CourierBoldOblique,
    pdf::StandardFont::Symbol,
    pdf::StandardFont::ZapfDingbats,
  ]
  let doc = pdf::PdfDoc::new()
  doc.set_title("vector14")
  let mut p = 0
  while p < 3 {
    let page = if p == 1 { pdf::Page::letter() } else { pdf::Page::a4() }
    if p == 2 {
      page.set_compression(pdf::Compression::RunLength)
    }
    page.save()
    page.rect(30.0, 30.0, 400.0, 400.0)
    page.clip_even_odd()
    page.set_dash([3.0, 1.5], 0.25)
    page.set_stroke_rgb(0.1, 0.2, 0.3)
    page.move_to(30.0, 30.0)
    page.cubic_to(100.0, 200.0, 200.0, -50.0, 430.0, 430.0)
    page.stroke()
    page.restore()
    let mut f = 0
    while f < fonts.length() {
      if (f + p) % 2 == 0 {
        page.text(40.0, 780.0 - f.to_double() * 18.0, 11.0, fonts[f], "Font " + f.to_string() + " abc")
      }
      f = f + 1
    }
    let _ = doc.add_page(page)
    p = p + 1
  }
  emit(world, dir, "vector14.pdf", doc.encode())
}

///|
fn gen_misc(world : World, dir : String) -> Unit {
  // 0 pages
  emit(world, dir, "empty.pdf", pdf::PdfDoc::new().encode())
  // ImageId forged from another document with a colliding index
  let a = pdf::PdfDoc::new()
  let b = pdf::PdfDoc::new()
  let _ = b.add_rgb_image(1, 1, make_rgb(1, 1))
  let foreign = match a.add_rgb_image(2, 2, make_rgb(2, 2)) {
    Ok(id) => id
    Err(_) => pdf::ImageId::{ index: 0 }
  }
  let pg = pdf::Page::a4()
  pg.draw_image(foreign, 0.0, 0.0, 10.0, 10.0)
  let _ = b.add_page(pg)
  emit(world, dir, "foreign_image.pdf", b.encode())
  // Same Page object added twice, then mutated after add_page
  let c = pdf::PdfDoc::new()
  let shared = pdf::Page::a4()
  shared.text(10.0, 10.0, 12.0, pdf::StandardFont::Helvetica, "first")
  let _ = c.add_page(shared)
  let _ = c.add_page(shared)
  shared.text(10.0, 30.0, 12.0, pdf::StandardFont::Helvetica, "added-after-add_page")
  emit(world, dir, "aliased_pages.pdf", c.encode())
}

///|
fn gen_all(world : World, dir : String, jpeg_paths : Array[String]) -> Unit {
  let jpegs : Array[Bytes] = []
  let mut i = 0
  while i < jpeg_paths.length() {
    match fs_read_bytes(world, jpeg_paths[i]) {
      Ok(b) => jpegs.push(b)
      Err(_) => io_println(world, "cannot read " + jpeg_paths[i])
    }
    i = i + 1
  }
  gen_inject(world, dir)
  gen_floats(world, dir)
  gen_images(world, dir, jpegs)
  gen_vector14(world, dir)
  gen_misc(world, dir)
}

///| Copy of `bench/pion_bench` `make_synth_rgba` (same pixels as the published benchmark).
fn bench_synth_rgba(w : Int, h : Int, page_idx : Int) -> Bytes {
  let mut out = Bytes::new(w * h * 4)
  let mut y = 0
  while y < h {
    let band = (y / 32) & 7
    let mut x = 0
    while x < w {
      let off = (y * w + x) * 4
      if band == 0 || band == 4 {
        out[off] = 37.to_byte()
        out[off + 1] = 99.to_byte()
        out[off + 2] = 235.to_byte()
        out[off + 3] = 255.to_byte()
      } else if band == 1 || band == 5 {
        if (x / 16 + y / 8 + page_idx) % 11 == 0 {
          out[off] = 24.to_byte()
          out[off + 1] = 24.to_byte()
          out[off + 2] = 27.to_byte()
          out[off + 3] = 255.to_byte()
        } else {
          out[off] = 255.to_byte()
          out[off + 1] = 255.to_byte()
          out[off + 2] = 255.to_byte()
          out[off + 3] = 255.to_byte()
        }
      } else {
        let rv = (x * 255) / (w - 1)
        let gv = (y * 255) / (h - 1)
        let bv = (page_idx * 37 + (x >> 2)) & 0xFF
        out[off] = rv.to_byte()
        out[off + 1] = gv.to_byte()
        out[off + 2] = bv.to_byte()
        out[off + 3] = 224.to_byte()
      }
      x = x + 1
    }
    y = y + 1
  }
  out
}

///| Phase breakdown of the two benchmark workloads (`bench/run_bench.sh`), in ms.
fn perf(world : World) -> Unit {
  let reps = 5
  // --- report100: build content vs serialize vs compress
  let mut best_build : Int64 = 1000000L
  let mut best_raw : Int64 = 1000000L
  let mut best_flate : Int64 = 1000000L
  let mut r = 0
  while r < reps {
    let t0 = clock_now_ms(world)
    let doc = pdf::PdfDoc::new()
    let mut p = 0
    while p < 100 {
      let page = pdf::Page::a4()
      page.set_fill_rgb(0.12, 0.28, 0.56)
      page.rect(40.0, 760.0, 515.28, 42.0)
      page.fill()
      let mut row = 0
      while row < 20 {
        let y = 660.0 - row.to_double() * 28.0
        page.text(52.0, y, 10.0, pdf::StandardFont::Helvetica, "Account " + row.to_string() + " (net) \\ value")
        page.text(420.0, y, 9.0, pdf::StandardFont::Courier, "1234567.89")
        row = row + 1
      }
      let _ = doc.add_page(page)
      p = p + 1
    }
    let t1 = clock_now_ms(world)
    doc.set_compression(pdf::Compression::Uncompressed)
    let _ = doc.encode()
    let t2 = clock_now_ms(world)
    doc.set_compression(pdf::flate_default())
    let _ = doc.encode()
    let t3 = clock_now_ms(world)
    if t1 - t0 < best_build { best_build = t1 - t0 }
    if t2 - t1 < best_raw { best_raw = t2 - t1 }
    if t3 - t2 < best_flate { best_flate = t3 - t2 }
    r = r + 1
  }
  io_println(world, "perf report100 build_content_ms=" + best_build.to_string() + " encode_uncompressed_ms=" + best_raw.to_string() + " encode_flate6_ms=" + best_flate.to_string())
  // --- images: 10 x 800x600 RGBA
  let pages : Array[(Int, Int, Bytes)] = []
  let mut i = 0
  while i < 10 {
    pages.push((800, 600, bench_synth_rgba(800, 600, i)))
    i = i + 1
  }
  let mut b_white : Int64 = 1000000L
  let mut b_flate : Int64 = 1000000L
  let mut b_rle : Int64 = 1000000L
  let mut b_full_f : Int64 = 1000000L
  let mut b_full_u : Int64 = 1000000L
  r = 0
  while r < reps {
    let t0 = clock_now_ms(world)
    let rgbs : Array[Bytes] = []
    let mut k = 0
    while k < 10 {
      let (w, h, px) = pages[k]
      rgbs.push(pdf::rgba_to_white_rgb(px, w, h))
      k = k + 1
    }
    let t1 = clock_now_ms(world)
    k = 0
    while k < 10 {
      let _ = pdf::flate_encode(rgbs[k], 6)
      k = k + 1
    }
    let t2 = clock_now_ms(world)
    k = 0
    while k < 10 {
      let _ = pdf::rle_encode(rgbs[k])
      k = k + 1
    }
    let t3 = clock_now_ms(world)
    let _ = pdf::encode_pdf_pages_with_compression(pages, pdf::flate_default())
    let t4 = clock_now_ms(world)
    let _ = pdf::encode_pdf_pages_with_compression(pages, pdf::Compression::Uncompressed)
    let t5 = clock_now_ms(world)
    if t1 - t0 < b_white { b_white = t1 - t0 }
    if t2 - t1 < b_flate { b_flate = t2 - t1 }
    if t3 - t2 < b_rle { b_rle = t3 - t2 }
    if t4 - t3 < b_full_f { b_full_f = t4 - t3 }
    if t5 - t4 < b_full_u { b_full_u = t5 - t4 }
    r = r + 1
  }
  io_println(world, "perf images10 rgba_to_white_rgb_ms=" + b_white.to_string() + " flate_encode6_ms=" + b_flate.to_string() + " rle_encode_ms=" + b_rle.to_string() + " full_flate_ms=" + b_full_f.to_string() + " full_uncompressed_ms=" + b_full_u.to_string())
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: probe perf|gen|validate|rle|flate|rgba|split|bigtext|pages ...")
    return 2
  }
  let mode = args[1]
  if mode == "perf" {
    perf(world)
    return 0
  }
  if mode == "gen" {
    let jp : Array[String] = []
    let mut i = 3
    while i < args.length() {
      jp.push(args[i])
      i = i + 1
    }
    gen_all(world, args[2], jp)
    return 0
  }
  if mode == "validate" || mode == "rle" || mode == "flate" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => {
        io_eprintln(world, "read failed")
        return 1
      }
    }
    let t0 = clock_now_ms(world)
    let msg = if mode == "validate" {
      match pdf::validate_pdf(data) {
        Ok(r) => "OK pages=" + r.page_count.to_string() + " objs=" + r.object_count.to_string()
        Err(e) => "ERR " + pdf::pdf_error_message(e)
      }
    } else {
      let lim = parse_int(args[3])
      let r = if mode == "rle" { pdf::rle_decode(data, lim) } else { pdf::flate_decode(data, lim) }
      match r {
        Ok(b) => "OK out=" + b.length().to_string()
        Err(e) => "ERR " + pdf::pdf_error_message(e)
      }
    }
    io_println(world, mode + " " + msg + " ms=" + (clock_now_ms(world) - t0).to_string())
    return 0
  }
  if mode == "rgba" || mode == "split" {
    let w = parse_int(args[2])
    let h = parse_int(args[3])
    if mode == "rgba" {
      let out = pdf::rgba_to_white_rgb(Bytes::new(0), w, h)
      io_println(world, "rgba_to_white_rgb(" + w.to_string() + "," + h.to_string() + ") -> " + out.length().to_string() + " bytes")
    } else {
      let (rgb, a) = pdf::rgba_split_rgb_alpha(Bytes::new(0), w, h)
      io_println(world, "rgba_split_rgb_alpha -> " + rgb.length().to_string() + "/" + a.length().to_string() + " bytes")
    }
    return 0
  }
  if mode == "bigtext" {
    let mib = parse_int(args[2])
    let target = mib * 1048576
    let page = pdf::Page::a4()
    let line = "0123456789012345678901234567890123456789012345678901234567890123456789"
    let t0 = clock_now_ms(world)
    let mut step = 0
    while page.content().byte_len() < target {
      page.text(10.0, 10.0, 9.0, pdf::StandardFont::Courier, line)
      step = step + 1
      if step % 2000000 == 0 {
        io_println(world, "content bytes=" + page.content().byte_len().to_string() + " ms=" + (clock_now_ms(world) - t0).to_string())
      }
    }
    io_println(world, "built content bytes=" + page.content().byte_len().to_string() + " ms=" + (clock_now_ms(world) - t0).to_string())
    let doc = pdf::PdfDoc::new()
    doc.set_compression(pdf::Compression::Uncompressed)
    let _ = doc.add_page(page)
    match doc.encode() {
      Ok(b) => io_println(world, "encode OK bytes=" + b.length().to_string())
      Err(e) => io_println(world, "encode ERR " + pdf::pdf_error_message(e))
    }
    return 0
  }
  io_eprintln(world, "unknown mode")
  2
}
