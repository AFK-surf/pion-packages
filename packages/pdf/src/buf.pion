///| Fast single-buffer `ByteBuf`, zero-allocation ASCII number writers, and ISO 32000-1 §7.3.4.2 PDF string escaping.

///| Growable byte buffer backed by a single `Bytes` slice.
struct ByteBuf {
  mut buf : Bytes
  mut n : Int
}

///|
fn ByteBuf::new() -> ByteBuf {
  ByteBuf::with_capacity(512)
}

///|
fn ByteBuf::with_capacity(cap : Int) -> ByteBuf {
  let init_cap = if cap < 64 { 64 } else { cap }
  ByteBuf::{ buf: Bytes::new(init_cap), n: 0 }
}

///|
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  if self.n + extra <= self.buf.length() {
    return
  }
  let mut cap = self.buf.length() * 2
  while cap < self.n + extra {
    cap = cap * 2
  }
  let mut bigger = Bytes::new(cap)
  let mut i = 0
  while i < self.n {
    bigger[i] = self.buf[i]
    i = i + 1
  }
  self.buf = bigger
}

///|
fn ByteBuf::write_byte(self : ByteBuf, b : Int) -> Unit {
  self.ensure(1)
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
}

///|
fn ByteBuf::write_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let len = src.length()
  if len == 0 {
    return
  }
  self.ensure(len)
  let base = self.n
  let mut i = 0
  while i < len {
    self.buf[base + i] = src[i]
    i = i + 1
  }
  self.n = base + len
}

///|
fn ByteBuf::write_slice(self : ByteBuf, src : Bytes, start : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  self.ensure(len)
  let base = self.n
  let mut i = 0
  while i < len {
    self.buf[base + i] = src[start + i]
    i = i + 1
  }
  self.n = base + len
}

///|
fn ByteBuf::write_str(self : ByteBuf, s : String) -> Unit {
  self.write_bytes(s.to_bytes())
}

///| Write a signed 64-bit integer in ASCII decimal with zero heap allocations.
fn ByteBuf::write_int64(self : ByteBuf, value : Int64) -> Unit {
  if value == 0L {
    self.write_byte(48)
    return
  }
  let mut v = value
  if v < 0L {
    self.write_byte(45) // '-'
    v = -v
  }
  let digits = FixedArray::make(20, 0)
  let mut count = 0
  while v > 0L {
    digits[count] = (v % 10L).to_int() + 48
    v = v / 10L
    count = count + 1
  }
  self.ensure(count)
  let mut i = count - 1
  while i >= 0 {
    self.buf[self.n] = digits[i].to_byte()
    self.n = self.n + 1
    i = i - 1
  }
}

///| Write a signed `Int` in ASCII decimal with zero heap allocations.
fn ByteBuf::write_int(self : ByteBuf, value : Int) -> Unit {
  self.write_int64(value.to_int64())
}

///| Write an exact 10-digit zero-padded non-negative integer for PDF xref entries.
fn ByteBuf::write_pad10(self : ByteBuf, value : Int) -> Unit {
  self.ensure(10)
  let mut v = if value < 0 { 0 } else { value }
  let base = self.n
  let mut i = 9
  while i >= 0 {
    self.buf[base + i] = (48 + v % 10).to_byte()
    v = v / 10
    i = i - 1
  }
  self.n = base + 10
}

///| Write a PDF real/integer number without scientific notation (ISO 32000-1 §7.3.3).
///| Formats up to 4 fractional decimal places, trimming trailing zeros and `-0`.
fn ByteBuf::write_num(self : ByteBuf, value : Double) -> Unit {
  // Guard NaN and infinities
  if value != value || value > 1.0e14 || value < -1.0e14 {
    self.write_byte(48)
    return
  }
  let neg = value < 0.0
  let abs_v = if neg { -value } else { value }
  let scaled = (abs_v * 10000.0 + 0.5).to_int64()
  if scaled == 0L {
    self.write_byte(48)
    return
  }
  if neg {
    self.write_byte(45) // '-'
  }
  let int_part = scaled / 10000L
  let mut frac_part = (scaled % 10000L).to_int()
  self.write_int64(int_part)
  if frac_part > 0 {
    self.write_byte(46) // '.'
    let mut d0 = frac_part / 1000
    frac_part = frac_part % 1000
    let mut d1 = frac_part / 100
    frac_part = frac_part % 100
    let mut d2 = frac_part / 10
    let d3 = frac_part % 10
    self.write_byte(48 + d0)
    if d1 != 0 || d2 != 0 || d3 != 0 {
      self.write_byte(48 + d1)
      if d2 != 0 || d3 != 0 {
        self.write_byte(48 + d2)
        if d3 != 0 {
          self.write_byte(48 + d3)
        }
      }
    }
    let _ = (d0, d1, d2)
  }
}

///| Write an escaped PDF literal string body (without outer `(` and `)`) directly into `ByteBuf`.
///| Escapes `\`, `(`, `)`, `\n`, `\r`, `\t`, `\b`, `\f`, and any byte `< 0x20` or `>= 0x7F` as 3-digit octal.
fn ByteBuf::write_pdf_escaped_string(self : ByteBuf, s : String) -> Unit {
  let raw = s.to_bytes()
  let n = raw.length()
  self.ensure(n)
  let mut i = 0
  while i < n {
    let b = raw[i].to_int() & 0xFF
    if b == 40 {
      // '('
      self.write_byte(92)
      self.write_byte(40)
    } else if b == 41 {
      // ')'
      self.write_byte(92)
      self.write_byte(41)
    } else if b == 92 {
      // '\'
      self.write_byte(92)
      self.write_byte(92)
    } else if b == 10 {
      // '\n'
      self.write_byte(92)
      self.write_byte(110)
    } else if b == 13 {
      // '\r'
      self.write_byte(92)
      self.write_byte(114)
    } else if b == 9 {
      // '\t'
      self.write_byte(92)
      self.write_byte(116)
    } else if b == 8 {
      // '\b'
      self.write_byte(92)
      self.write_byte(98)
    } else if b == 12 {
      // '\f'
      self.write_byte(92)
      self.write_byte(102)
    } else if b < 32 || b >= 127 {
      // Octal \ddd
      self.ensure(4)
      self.buf[self.n] = 92.to_byte()
      self.buf[self.n + 1] = (48 + ((b >> 6) & 7)).to_byte()
      self.buf[self.n + 2] = (48 + ((b >> 3) & 7)).to_byte()
      self.buf[self.n + 3] = (48 + (b & 7)).to_byte()
      self.n = self.n + 4
    } else {
      self.write_byte(b)
    }
    i = i + 1
  }
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.buf.slice(0, self.n)
}

///| Escape a string for inclusion in a PDF literal string `(...)` (ISO 32000-1 §7.3.4.2).
pub fn escape_pdf_string(s : String) -> String {
  let buf = ByteBuf::with_capacity(s.length() + 16)
  buf.write_pdf_escaped_string(s)
  buf.to_bytes().to_string()
}
