///| Fast single-buffer `ByteBuf`, overflow-safe growth, zero-allocation ASCII number writers,
///| WinAnsi (cp1252) text encoding, UTF-16BE `/Info` text strings, and ISO 32000-1 §7.3.4.2 escaping.

///| Maximum safe capacity for a single `ByteBuf` (1 GiB, well below 32-bit `Int` overflow).
let bytebuf_hard_max : Int = 1073741824

///| Growable byte buffer backed by a single `Bytes` slice with overflow-safe growth and optional budget.
struct ByteBuf {
  mut buf : Bytes
  mut n : Int
  mut max_bytes : Int
  mut overflowed : Bool
  mut virtual_n : Int
}

///|
fn ByteBuf::new() -> ByteBuf {
  ByteBuf::with_capacity(512)
}

///|
fn ByteBuf::with_capacity(cap : Int) -> ByteBuf {
  let init_cap = if cap < 64 {
    64
  } else if cap > bytebuf_hard_max {
    bytebuf_hard_max
  } else {
    cap
  }
  ByteBuf::{
    buf: Bytes::new(init_cap),
    n: 0,
    max_bytes: bytebuf_hard_max,
    overflowed: false,
    virtual_n: 0,
  }
}

///|
fn ByteBuf::with_budget(cap : Int, max_bytes : Int) -> ByteBuf {
  let eff_max = if max_bytes <= 0 || max_bytes > bytebuf_hard_max {
    bytebuf_hard_max
  } else {
    max_bytes
  }
  let init_cap = if cap < 64 {
    64
  } else if cap > eff_max {
    eff_max
  } else {
    cap
  }
  ByteBuf::{
    buf: Bytes::new(init_cap),
    n: 0,
    max_bytes: eff_max,
    overflowed: false,
    virtual_n: 0,
  }
}

///| Advance `virtual_n` safely without 32-bit overflow.
fn ByteBuf::add_virtual(self : ByteBuf, extra : Int) -> Unit {
  if extra <= 0 {
    return
  }
  let sum64 = self.virtual_n.to_int64() + extra.to_int64()
  self.virtual_n = if sum64 > 2147483647L { 2147483647 } else { sum64.to_int() }
}

///| Overflow-safe capacity reservation in `Int64`. Returns `false` if budget or 1 GiB cap is exceeded.
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Bool {
  if extra < 0 {
    self.overflowed = true
    return false
  }
  if self.overflowed {
    self.add_virtual(extra)
    return false
  }
  let need64 = self.n.to_int64() + extra.to_int64()
  let limit64 = self.max_bytes.to_int64()
  if need64 > limit64 || need64 > bytebuf_hard_max.to_int64() {
    self.overflowed = true
    self.add_virtual(extra)
    return false
  }
  let cur_cap64 = self.buf.length().to_int64()
  if need64 <= cur_cap64 {
    return true
  }
  let hard64 = if limit64 < bytebuf_hard_max.to_int64() {
    limit64
  } else {
    bytebuf_hard_max.to_int64()
  }
  let mut cap64 = cur_cap64 * 2L
  if cap64 < 64L {
    cap64 = 64L
  }
  while cap64 < need64 {
    if cap64 >= hard64 {
      cap64 = hard64
      break
    }
    cap64 = cap64 * 2L
  }
  if cap64 > hard64 {
    cap64 = hard64
  }
  let new_cap = cap64.to_int()
  let mut bigger = Bytes::new(new_cap)
  let mut i = 0
  let n = self.n
  while i < n {
    bigger[i] = self.buf[i]
    i = i + 1
  }
  self.buf = bigger
  true
}

///|
fn ByteBuf::write_byte(self : ByteBuf, b : Int) -> Unit {
  if !self.ensure(1) {
    return
  }
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
  self.virtual_n = self.n
}

///|
fn ByteBuf::write_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let len = src.length()
  if len == 0 {
    return
  }
  if !self.ensure(len) {
    return
  }
  let base = self.n
  let mut i = 0
  while i < len {
    self.buf[base + i] = src[i]
    i = i + 1
  }
  self.n = base + len
  self.virtual_n = self.n
}

///|
fn ByteBuf::write_slice(self : ByteBuf, src : Bytes, start : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  if !self.ensure(len) {
    return
  }
  let base = self.n
  let mut i = 0
  while i < len {
    self.buf[base + i] = src[start + i]
    i = i + 1
  }
  self.n = base + len
  self.virtual_n = self.n
}

///|
fn ByteBuf::write_str(self : ByteBuf, s : String) -> Unit {
  self.write_bytes(s.to_bytes())
}

///| Write a signed 64-bit integer in ASCII decimal with zero heap allocations.
fn ByteBuf::write_int64(self : ByteBuf, value : Int64) -> Unit {
  if value == 0L {
    self.write_byte(48)
    return
  }
  let mut v = value
  if v < 0L {
    self.write_byte(45) // '-'
    v = -v
  }
  let digits = FixedArray::make(20, 0)
  let mut count = 0
  while v > 0L {
    digits[count] = (v % 10L).to_int() + 48
    v = v / 10L
    count = count + 1
  }
  if !self.ensure(count) {
    return
  }
  let mut i = count - 1
  while i >= 0 {
    self.buf[self.n] = digits[i].to_byte()
    self.n = self.n + 1
    i = i - 1
  }
  self.virtual_n = self.n
}

///| Write a signed `Int` in ASCII decimal with zero heap allocations.
fn ByteBuf::write_int(self : ByteBuf, value : Int) -> Unit {
  self.write_int64(value.to_int64())
}

///| Write an exact 10-digit zero-padded non-negative integer for PDF xref entries.
fn ByteBuf::write_pad10(self : ByteBuf, value : Int) -> Unit {
  if !self.ensure(10) {
    return
  }
  let mut v = if value < 0 { 0 } else { value }
  let base = self.n
  let mut i = 9
  while i >= 0 {
    self.buf[base + i] = (48 + v % 10).to_byte()
    v = v / 10
    i = i - 1
  }
  self.n = base + 10
  self.virtual_n = self.n
}

///| Return true if `value` is finite and within the safe PDF 1.4 representable range `[-1e14, 1e14]`.
fn is_valid_pdf_num(value : Double) -> Bool {
  value == value && value >= -1.0e14 && value <= 1.0e14
}

///| Write a PDF real/integer number without scientific notation (ISO 32000-1 §7.3.3).
///| Preserves exact integer parts up to 1e14 (no spurious fraction digits) and up to 12
///| fractional digits for small-scale transforms (e.g. `0.00001` never rounds to `0`).
fn ByteBuf::write_num(self : ByteBuf, value : Double) -> Unit {
  if !is_valid_pdf_num(value) {
    self.write_byte(48)
    return
  }
  if value == 0.0 {
    self.write_byte(48)
    return
  }
  let neg = value < 0.0
  let abs_v = if neg { -value } else { value }
  let mut int_part = abs_v.to_int64()
  let frac = abs_v - int_part.to_double()
  if frac <= 0.0 {
    if int_part == 0L {
      self.write_byte(48)
      return
    }
    if neg {
      self.write_byte(45)
    }
    self.write_int64(int_part)
    return
  }
  if int_part == 0L && frac < 0.0001 {
    // High-precision small value (e.g. 1e-5..1e-12) without scientific notation
    let mut scaled = (frac * 1000000000000.0 + 0.5).to_int64()
    if scaled <= 0L {
      self.write_byte(48)
      return
    }
    if scaled >= 1000000000000L {
      if neg {
        self.write_byte(45)
      }
      self.write_byte(49)
      return
    }
    if neg {
      self.write_byte(45)
    }
    self.write_byte(48)
    self.write_byte(46)
    let digits = FixedArray::make(12, 0)
    let mut k = 11
    while k >= 0 {
      digits[k] = (scaled % 10L).to_int()
      scaled = scaled / 10L
      k = k - 1
    }
    let mut last = 11
    while last > 0 && digits[last] == 0 {
      last = last - 1
    }
    let mut j = 0
    while j <= last {
      self.write_byte(48 + digits[j])
      j = j + 1
    }
    return
  }
  // Standard range: 6 fractional decimal places, trimming trailing zeros
  let mut scaled6 = (frac * 1000000.0 + 0.5).to_int64()
  if scaled6 >= 1000000L {
    int_part = int_part + 1L
    scaled6 = 0L
  }
  if int_part == 0L && scaled6 == 0L {
    self.write_byte(48)
    return
  }
  if neg {
    self.write_byte(45)
  }
  self.write_int64(int_part)
  if scaled6 > 0L {
    self.write_byte(46)
    let digits = FixedArray::make(6, 0)
    let mut k = 5
    while k >= 0 {
      digits[k] = (scaled6 % 10L).to_int()
      scaled6 = scaled6 / 10L
      k = k - 1
    }
    let mut last = 5
    while last > 0 && digits[last] == 0 {
      last = last - 1
    }
    let mut j = 0
    while j <= last {
      self.write_byte(48 + digits[j])
      j = j + 1
    }
  }
}

///| Write a single byte escaped for a PDF literal string `(...)`.
fn ByteBuf::write_pdf_escaped_byte(self : ByteBuf, b : Int) -> Unit {
  if b == 40 {
    self.write_byte(92)
    self.write_byte(40)
  } else if b == 41 {
    self.write_byte(92)
    self.write_byte(41)
  } else if b == 92 {
    self.write_byte(92)
    self.write_byte(92)
  } else if b == 10 {
    self.write_byte(92)
    self.write_byte(110)
  } else if b == 13 {
    self.write_byte(92)
    self.write_byte(114)
  } else if b == 9 {
    self.write_byte(92)
    self.write_byte(116)
  } else if b == 8 {
    self.write_byte(92)
    self.write_byte(98)
  } else if b == 12 {
    self.write_byte(92)
    self.write_byte(102)
  } else if b < 32 || b >= 127 {
    if !self.ensure(4) {
      return
    }
    self.buf[self.n] = 92.to_byte()
    self.buf[self.n + 1] = (48 + ((b >> 6) & 7)).to_byte()
    self.buf[self.n + 2] = (48 + ((b >> 3) & 7)).to_byte()
    self.buf[self.n + 3] = (48 + (b & 7)).to_byte()
    self.n = self.n + 4
    self.virtual_n = self.n
  } else {
    self.write_byte(b)
  }
}

///| Write an escaped PDF literal string body (without outer `(` and `)`) directly into `ByteBuf`.
fn ByteBuf::write_pdf_escaped_string(self : ByteBuf, s : String) -> Unit {
  let raw = s.to_bytes()
  let n = raw.length()
  let _ = self.ensure(n)
  let mut i = 0
  while i < n {
    self.write_pdf_escaped_byte(raw[i].to_int() & 0xFF)
    i = i + 1
  }
}

///| Map a Unicode scalar value to a Windows-1252 (WinAnsiEncoding) byte, or `-1` if unrepresentable.
fn unicode_to_winansi(cp : Int) -> Int {
  if cp >= 0 && cp <= 0x7F {
    return cp
  }
  if cp >= 0xA0 && cp <= 0xFF {
    return cp
  }
  match cp {
    0x20AC => 0x80 // €
    0x201A => 0x82 // ‚
    0x0192 => 0x83 // ƒ
    0x201E => 0x84 // „
    0x2026 => 0x85 // …
    0x2020 => 0x86 // †
    0x2021 => 0x87 // ‡
    0x02C6 => 0x88 // ˆ
    0x2030 => 0x89 // ‰
    0x0160 => 0x8A // Š
    0x2039 => 0x8B // ‹
    0x0152 => 0x8C // Œ
    0x017D => 0x8E // Ž
    0x2018 => 0x91 // ‘
    0x2019 => 0x92 // ’
    0x201C => 0x93 // “
    0x201D => 0x94 // ”
    0x2022 => 0x95 // •
    0x2013 => 0x96 // –
    0x2014 => 0x97 // —
    0x02DC => 0x98 // ˜
    0x2122 => 0x99 // ™
    0x0161 => 0x9A // š
    0x203A => 0x9B // ›
    0x0153 => 0x9C // œ
    0x017E => 0x9E // ž
    0x0178 => 0x9F // Ÿ
    _ => -1
  }
}

///| Decode the next UTF-8 codepoint from `raw` starting at `i`, returning `(codepoint, next_i)`.
fn utf8_next_codepoint(raw : Bytes, i : Int) -> (Int, Int) {
  let n = raw.length()
  let b0 = raw[i].to_int() & 0xFF
  if b0 < 0x80 {
    return (b0, i + 1)
  }
  if (b0 & 0xE0) == 0xC0 && i + 1 < n {
    let b1 = raw[i + 1].to_int() & 0xFF
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), i + 2)
    }
  } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
    let b1 = raw[i + 1].to_int() & 0xFF
    let b2 = raw[i + 2].to_int() & 0xFF
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), i + 3)
    }
  } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
    let b1 = raw[i + 1].to_int() & 0xFF
    let b2 = raw[i + 2].to_int() & 0xFF
    let b3 = raw[i + 3].to_int() & 0xFF
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (
        ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
        i + 4,
      )
    }
  }
  (0x3F, i + 1)
}

///| Write a UTF-8 string transcoded to WinAnsiEncoding (cp1252) inside a PDF literal string.
///| Unmappable Unicode scalar values outside WinAnsi are substituted with `?` (0x3F).
fn ByteBuf::write_pdf_winansi_string(self : ByteBuf, s : String) -> Unit {
  let raw = s.to_bytes()
  let n = raw.length()
  let mut i = 0
  while i < n {
    let b0 = raw[i].to_int() & 0xFF
    if b0 < 0x80 {
      self.write_pdf_escaped_byte(b0)
      i = i + 1
    } else {
      let (cp, next_i) = utf8_next_codepoint(raw, i)
      let wa = unicode_to_winansi(cp)
      self.write_pdf_escaped_byte(if wa >= 0 { wa } else { 0x3F })
      i = next_i
    }
  }
}

///| Write a single byte as 2 uppercase hex ASCII characters.
fn ByteBuf::write_hex_byte(self : ByteBuf, b : Int) -> Unit {
  let hi = (b >> 4) & 0xF
  let lo = b & 0xF
  self.write_byte(if hi < 10 { 48 + hi } else { 55 + hi })
  self.write_byte(if lo < 10 { 48 + lo } else { 55 + lo })
}

///| Write an ISO 32000-1 §7.9.2.2 PDF text string for `/Info` metadata:
///| pure ASCII is written as a literal `(...)`, non-ASCII is written as UTF-16BE with BOM `<FEFF...>`.
fn ByteBuf::write_pdf_text_string(self : ByteBuf, s : String) -> Unit {
  let raw = s.to_bytes()
  let n = raw.length()
  let mut has_non_ascii = false
  let mut i = 0
  while i < n {
    if (raw[i].to_int() & 0xFF) >= 0x80 {
      has_non_ascii = true
      break
    }
    i = i + 1
  }
  if !has_non_ascii {
    self.write_byte(40) // '('
    self.write_pdf_escaped_string(s)
    self.write_byte(41) // ')'
    return
  }
  // UTF-16BE with FE FF BOM in hex string
  self.write_str("<FEFF")
  let mut pos = 0
  while pos < n {
    let (cp, next_pos) = utf8_next_codepoint(raw, pos)
    if cp <= 0xFFFF {
      self.write_hex_byte((cp >> 8) & 0xFF)
      self.write_hex_byte(cp & 0xFF)
    } else {
      let adj = cp - 0x10000
      let hi = 0xD800 + ((adj >> 10) & 0x3FF)
      let lo = 0xDC00 + (adj & 0x3FF)
      self.write_hex_byte((hi >> 8) & 0xFF)
      self.write_hex_byte(hi & 0xFF)
      self.write_hex_byte((lo >> 8) & 0xFF)
      self.write_hex_byte(lo & 0xFF)
    }
    pos = next_pos
  }
  self.write_byte(62) // '>'
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  if self.n == self.buf.length() {
    self.buf
  } else {
    self.buf.slice(0, self.n)
  }
}

///| Escape a string for inclusion in a PDF literal string `(...)` (ISO 32000-1 §7.3.4.2).
pub fn escape_pdf_string(s : String) -> String {
  let buf = ByteBuf::with_capacity(s.length() + 16)
  buf.write_pdf_escaped_string(s)
  buf.to_bytes().to_string()
}
