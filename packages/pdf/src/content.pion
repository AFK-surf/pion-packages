///| 2D vector, text, and image PDF content stream builder backed by a single `ByteBuf`.

///| Mutable PDF page content stream builder.
pub struct ContentStream {
  buf : ByteBuf
  mut used_fonts : Int
  used_images : Array[Int]
}

///| Create a new empty content stream.
pub fn ContentStream::new() -> ContentStream {
  ContentStream::{ buf: ByteBuf::with_capacity(512), used_fonts: 0, used_images: [] }
}

///| Push graphics state (`q`).
pub fn ContentStream::save(self : ContentStream) -> Unit {
  self.buf.write_str("q\n")
}

///| Pop graphics state (`Q`).
pub fn ContentStream::restore(self : ContentStream) -> Unit {
  self.buf.write_str("Q\n")
}

///| Concatenate affine transformation matrix (`a b c d e f cm`).
pub fn ContentStream::concat_matrix(
  self : ContentStream,
  a : Double,
  b : Double,
  c : Double,
  d : Double,
  e : Double,
  f : Double,
) -> Unit {
  self.buf.write_num(a)
  self.buf.write_byte(32)
  self.buf.write_num(b)
  self.buf.write_byte(32)
  self.buf.write_num(c)
  self.buf.write_byte(32)
  self.buf.write_num(d)
  self.buf.write_byte(32)
  self.buf.write_num(e)
  self.buf.write_byte(32)
  self.buf.write_num(f)
  self.buf.write_str(" cm\n")
}

///| Set stroke line width (`w`).
pub fn ContentStream::set_line_width(self : ContentStream, width : Double) -> Unit {
  self.buf.write_num(width)
  self.buf.write_str(" w\n")
}

///| Set line cap style (`0` butt, `1` round, `2` projecting square) (`J`).
pub fn ContentStream::set_line_cap(self : ContentStream, cap : Int) -> Unit {
  self.buf.write_int(cap)
  self.buf.write_str(" J\n")
}

///| Set line join style (`0` miter, `1` round, `2` bevel) (`j`).
pub fn ContentStream::set_line_join(self : ContentStream, join : Int) -> Unit {
  self.buf.write_int(join)
  self.buf.write_str(" j\n")
}

///| Set miter limit (`M`).
pub fn ContentStream::set_miter_limit(self : ContentStream, limit : Double) -> Unit {
  self.buf.write_num(limit)
  self.buf.write_str(" M\n")
}

///| Set line dash pattern (`[...] phase d`).
pub fn ContentStream::set_dash(
  self : ContentStream,
  pattern : Array[Double],
  phase : Double,
) -> Unit {
  self.buf.write_byte(91) // '['
  let mut i = 0
  while i < pattern.length() {
    if i > 0 {
      self.buf.write_byte(32)
    }
    self.buf.write_num(pattern[i])
    i = i + 1
  }
  self.buf.write_str("] ")
  self.buf.write_num(phase)
  self.buf.write_str(" d\n")
}

///| Set non-stroking (fill) RGB color (`r g b rg`), each channel in `0.0..1.0`.
pub fn ContentStream::set_fill_rgb(
  self : ContentStream,
  r : Double,
  g : Double,
  b : Double,
) -> Unit {
  self.buf.write_num(r)
  self.buf.write_byte(32)
  self.buf.write_num(g)
  self.buf.write_byte(32)
  self.buf.write_num(b)
  self.buf.write_str(" rg\n")
}

///| Set stroking RGB color (`r g b RG`), each channel in `0.0..1.0`.
pub fn ContentStream::set_stroke_rgb(
  self : ContentStream,
  r : Double,
  g : Double,
  b : Double,
) -> Unit {
  self.buf.write_num(r)
  self.buf.write_byte(32)
  self.buf.write_num(g)
  self.buf.write_byte(32)
  self.buf.write_num(b)
  self.buf.write_str(" RG\n")
}

///| Set non-stroking (fill) grayscale (`g g`).
pub fn ContentStream::set_fill_gray(self : ContentStream, g : Double) -> Unit {
  self.buf.write_num(g)
  self.buf.write_str(" g\n")
}

///| Set stroking grayscale (`g G`).
pub fn ContentStream::set_stroke_gray(self : ContentStream, g : Double) -> Unit {
  self.buf.write_num(g)
  self.buf.write_str(" G\n")
}

///| Begin a new subpath at `(x, y)` (`m`).
pub fn ContentStream::move_to(self : ContentStream, x : Double, y : Double) -> Unit {
  self.buf.write_num(x)
  self.buf.write_byte(32)
  self.buf.write_num(y)
  self.buf.write_str(" m\n")
}

///| Append a straight line segment to `(x, y)` (`l`).
pub fn ContentStream::line_to(self : ContentStream, x : Double, y : Double) -> Unit {
  self.buf.write_num(x)
  self.buf.write_byte(32)
  self.buf.write_num(y)
  self.buf.write_str(" l\n")
}

///| Append a cubic Bezier curve (`x1 y1 x2 y2 x3 y3 c`).
pub fn ContentStream::cubic_to(
  self : ContentStream,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
) -> Unit {
  self.buf.write_num(x1)
  self.buf.write_byte(32)
  self.buf.write_num(y1)
  self.buf.write_byte(32)
  self.buf.write_num(x2)
  self.buf.write_byte(32)
  self.buf.write_num(y2)
  self.buf.write_byte(32)
  self.buf.write_num(x3)
  self.buf.write_byte(32)
  self.buf.write_num(y3)
  self.buf.write_str(" c\n")
}

///| Append a rectangle subpath (`x y w h re`).
pub fn ContentStream::rect(
  self : ContentStream,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
) -> Unit {
  self.buf.write_num(x)
  self.buf.write_byte(32)
  self.buf.write_num(y)
  self.buf.write_byte(32)
  self.buf.write_num(w)
  self.buf.write_byte(32)
  self.buf.write_num(h)
  self.buf.write_str(" re\n")
}

///| Close the current subpath (`h`).
pub fn ContentStream::close_path(self : ContentStream) -> Unit {
  self.buf.write_str("h\n")
}

///| Stroke the current path (`S`).
pub fn ContentStream::stroke(self : ContentStream) -> Unit {
  self.buf.write_str("S\n")
}

///| Close and stroke the current path (`s`).
pub fn ContentStream::close_and_stroke(self : ContentStream) -> Unit {
  self.buf.write_str("s\n")
}

///| Fill the current path using the nonzero winding number rule (`f`).
pub fn ContentStream::fill(self : ContentStream) -> Unit {
  self.buf.write_str("f\n")
}

///| Fill the current path using the even-odd rule (`f*`).
pub fn ContentStream::fill_even_odd(self : ContentStream) -> Unit {
  self.buf.write_str("f*\n")
}

///| Fill and then stroke the current path (`B`).
pub fn ContentStream::fill_and_stroke(self : ContentStream) -> Unit {
  self.buf.write_str("B\n")
}

///| Intersect current clipping path using nonzero winding rule and end path (`W n`).
pub fn ContentStream::clip(self : ContentStream) -> Unit {
  self.buf.write_str("W n\n")
}

///| Intersect current clipping path using even-odd rule and end path (`W* n`).
pub fn ContentStream::clip_even_odd(self : ContentStream) -> Unit {
  self.buf.write_str("W* n\n")
}

///| End path without filling or stroking (`n`).
pub fn ContentStream::end_path(self : ContentStream) -> Unit {
  self.buf.write_str("n\n")
}

///| Draw a single-line text string at `(x, y)` using a Standard 14 font.
pub fn ContentStream::text(
  self : ContentStream,
  x : Double,
  y : Double,
  size : Double,
  font : StandardFont,
  s : String,
) -> Unit {
  let fidx = standard_font_index(font)
  self.used_fonts = self.used_fonts | (1 << fidx)
  self.buf.write_str("BT /F")
  self.buf.write_int(fidx + 1)
  self.buf.write_byte(32)
  self.buf.write_num(size)
  self.buf.write_str(" Tf 1 0 0 1 ")
  self.buf.write_num(x)
  self.buf.write_byte(32)
  self.buf.write_num(y)
  self.buf.write_str(" Tm (")
  self.buf.write_pdf_escaped_string(s)
  self.buf.write_str(") Tj ET\n")
}

///| Draw a registered image XObject inside rectangle `(x, y, w, h)`.
pub fn ContentStream::draw_image(
  self : ContentStream,
  image : ImageId,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
) -> Unit {
  let idx = image.index
  let mut found = false
  let mut i = 0
  while i < self.used_images.length() {
    if self.used_images[i] == idx {
      found = true
      break
    }
    i = i + 1
  }
  if !found {
    self.used_images.push(idx)
  }
  self.buf.write_str("q ")
  self.buf.write_num(w)
  self.buf.write_str(" 0 0 ")
  self.buf.write_num(h)
  self.buf.write_byte(32)
  self.buf.write_num(x)
  self.buf.write_byte(32)
  self.buf.write_num(y)
  self.buf.write_str(" cm /Im")
  self.buf.write_int(idx)
  self.buf.write_str(" Do Q\n")
}

///| Extract the accumulated raw content stream bytes.
pub fn ContentStream::to_bytes(self : ContentStream) -> Bytes {
  self.buf.to_bytes()
}

///| Return current raw byte length of the content stream.
pub fn ContentStream::byte_len(self : ContentStream) -> Int {
  self.buf.n
}
