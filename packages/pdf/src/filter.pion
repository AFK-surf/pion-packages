///| PDF stream compression filters (`/FlateDecode`, `/RunLengthDecode`) and pixel format converters.

import "flate"

///| PackBits (`/RunLengthDecode`, ISO 32000-1 §7.4.5) encoder.
///| Single-pass fused scan+copy with 4-byte unrolled literal/run loops into local `Bytes`.
pub fn rle_encode(src : Bytes) -> Bytes {
  let n = src.length()
  if n == 0 {
    let mut empty = Bytes::new(1)
    empty[0] = 0x80.to_byte()
    return empty
  }
  let max_out = n + n / 128 + 16
  let mut out = Bytes::new(max_out)
  let mut pos = 0
  let mut i = 0
  while i < n {
    let b = src[i]
    if i + 2 < n && src[i + 1] == b && src[i + 2] == b {
      let mut run = 3
      let run_lim = if n - i < 128 { n - i } else { 128 }
      while run + 4 <= run_lim &&
      src[i + run] == b &&
      src[i + run + 1] == b &&
      src[i + run + 2] == b &&
      src[i + run + 3] == b {
        run = run + 4
      }
      while run < run_lim && src[i + run] == b {
        run = run + 1
      }
      out[pos] = (257 - run).to_byte()
      out[pos + 1] = b
      pos = pos + 2
      i = i + run
    } else {
      let start = i
      let end = if start + 128 < n { start + 128 } else { n }
      if start + 1 >= end {
        out[pos] = 0.to_byte()
        out[pos + 1] = b
        pos = pos + 2
        i = end
      } else {
        // Single-pass fused scan + copy: reserve header byte at `hdr_pos` and emit bytes directly.
        let hdr_pos = pos
        let b1 = src[start + 1]
        out[hdr_pos + 1] = b
        out[hdr_pos + 2] = b1
        let mut p = hdr_pos + 3
        let mut prev = b1
        let mut j = start + 2
        let mut hit_run = false
        while j < end {
          // 4-byte unrolled fast path: if no adjacent pair matches, no 3-run can begin here.
          while j + 4 <= end {
            let c0 = src[j]
            let c1 = src[j + 1]
            let c2 = src[j + 2]
            let c3 = src[j + 3]
            if c0 == prev || c1 == c0 || c2 == c1 || c3 == c2 {
              break
            }
            out[p] = c0
            out[p + 1] = c1
            out[p + 2] = c2
            out[p + 3] = c3
            prev = c3
            j = j + 4
            p = p + 4
          }
          if j >= end {
            break
          }
          let cur = src[j]
          if cur == prev && j + 1 < n && src[j + 1] == cur {
            // 3-run starts at `j - 1` (`prev`, which was already written to `out[p - 1]`).
            p = p - 1
            j = j - 1
            hit_run = true
            break
          }
          out[p] = cur
          prev = cur
          p = p + 1
          j = j + 1
        }
        // Check whether a 3-run starts at `end - 1` (the last byte of the 128-byte window)
        if !hit_run && end + 1 < n && prev == src[end] && prev == src[end + 1] {
          p = p - 1
          j = end - 1
        }
        let lit = j - start
        out[hdr_pos] = (lit - 1).to_byte()
        pos = p
        i = j
      }
    }
  }
  out[pos] = 0x80.to_byte()
  pos = pos + 1
  if pos == max_out {
    out
  } else {
    out.slice(0, pos)
  }
}

///| PackBits (`/RunLengthDecode`, ISO 32000-1 §7.4.5) decoder with strict `max_output_bytes` limit.
///| `max_output_bytes == 0` allows only empty (0-byte) decoded output; negative limits are rejected.
pub fn rle_decode(src : Bytes, max_output_bytes : Int) -> Result[Bytes, PdfError] {
  if max_output_bytes < 0 {
    return Err(PdfError::LimitExceeded("negative max_output_bytes"))
  }
  let eff_limit = if max_output_bytes > bytebuf_hard_max {
    bytebuf_hard_max
  } else {
    max_output_bytes
  }
  let n = src.length()
  let init_cap = if eff_limit == 0 {
    64
  } else if n < eff_limit && n < 4096 {
    n * 2
  } else if n < eff_limit {
    n
  } else {
    eff_limit
  }
  let out = ByteBuf::with_budget(init_cap, if eff_limit == 0 { 64 } else { eff_limit })
  let mut i = 0
  while i < n {
    let ctrl = src[i].to_int() & 0xFF
    i = i + 1
    if ctrl == 128 {
      // EOD marker 0x80
      return Ok(out.to_bytes())
    } else if ctrl < 128 {
      let count = ctrl + 1
      if i + count > n {
        return Err(PdfError::InvalidFilter("truncated RunLengthDecode literal packet"))
      }
      if out.n.to_int64() + count.to_int64() > eff_limit.to_int64() {
        return Err(
          PdfError::LimitExceeded(
            "RunLengthDecode output exceeded limit of " + eff_limit.to_string() + " bytes",
          ),
        )
      }
      out.write_slice(src, i, count)
      i = i + count
    } else {
      let count = 257 - ctrl
      if i >= n {
        return Err(PdfError::InvalidFilter("truncated RunLengthDecode repeat packet"))
      }
      if out.n.to_int64() + count.to_int64() > eff_limit.to_int64() {
        return Err(
          PdfError::LimitExceeded(
            "RunLengthDecode output exceeded limit of " + eff_limit.to_string() + " bytes",
          ),
        )
      }
      let bv = src[i]
      i = i + 1
      if !out.ensure(count) {
        return Err(
          PdfError::LimitExceeded(
            "RunLengthDecode output exceeded limit of " + eff_limit.to_string() + " bytes",
          ),
        )
      }
      let buf = out.buf
      let base = out.cur
      let mut k = 0
      let lim8 = count - 8
      while k <= lim8 {
        buf[base + k] = bv
        buf[base + k + 1] = bv
        buf[base + k + 2] = bv
        buf[base + k + 3] = bv
        buf[base + k + 4] = bv
        buf[base + k + 5] = bv
        buf[base + k + 6] = bv
        buf[base + k + 7] = bv
        k = k + 8
      }
      while k < count {
        buf[base + k] = bv
        k = k + 1
      }
      out.cur = base + count
      out.n = out.n + count
      out.virtual_n = out.n
    }
  }
  Ok(out.to_bytes())
}

///| RFC 1950 zlib (`/FlateDecode`) encoder backed by `flate::zlib_compress`.
pub fn flate_encode(src : Bytes, level : Int) -> Result[Bytes, PdfError] {
  match flate::zlib_compress(src, level) {
    Ok(b) => Ok(b)
    Err(e) => Err(PdfError::CompressionFailed(flate::flate_error_message(e)))
  }
}

///| RFC 1950 zlib (`/FlateDecode`) decoder backed by `flate::zlib_decompress_with_limit`.
///| `max_output_bytes == 0` allows only empty (0-byte) decoded output; negative limits are rejected.
pub fn flate_decode(src : Bytes, max_output_bytes : Int) -> Result[Bytes, PdfError] {
  if max_output_bytes < 0 {
    return Err(PdfError::LimitExceeded("negative max_output_bytes"))
  }
  if max_output_bytes == 0 {
    match flate::zlib_decompress_with_limit(src, 1) {
      Ok(b) =>
      if b.length() == 0 {
        return Ok(b)
      } else {
        return Err(PdfError::LimitExceeded("FlateDecode output exceeded limit: 0"))
      }
      Err(flate::FlateError::OutputLimitExceeded(_)) =>
      return Err(PdfError::LimitExceeded("FlateDecode output exceeded limit: 0"))
      Err(e) => return Err(PdfError::CompressionFailed(flate::flate_error_message(e)))
    }
  }
  match flate::zlib_decompress_with_limit(src, max_output_bytes) {
    Ok(b) => Ok(b)
    Err(flate::FlateError::OutputLimitExceeded(lim)) =>
    Err(PdfError::LimitExceeded("FlateDecode output exceeded limit: " + lim.to_string()))
    Err(e) => Err(PdfError::CompressionFailed(flate::flate_error_message(e)))
  }
}

///| Compress a stream payload according to `Compression`, returning `(filter_name, bytes)`.
fn compress_stream(src : Bytes, compression : Compression) -> Result[(String, Bytes), PdfError] {
  match compression {
    Uncompressed => Ok(("", src))
    RunLength => Ok(("/RunLengthDecode", rle_encode(src)))
    Flate(level) =>
    match flate_encode(src, level) {
      Ok(b) => Ok(("/FlateDecode", b))
      Err(e) => Err(e)
    }
  }
}

///| Composite straight-alpha RGBA pixels over white paper into opaque RGB.
///| Returns empty `Bytes` on invalid/overflowing dimensions (`width * height * 4` checked in `Int64`).
pub fn rgba_to_white_rgb(rgba : Bytes, width : Int, height : Int) -> Bytes {
  if width <= 0 || height <= 0 {
    return Bytes::new(0)
  }
  let pixels64 = width.to_int64() * height.to_int64()
  // Ensure pixels * 4 fits safely in 32-bit Int and does not exceed 1 GiB
  if pixels64 <= 0L || pixels64 > 268435455L {
    return Bytes::new(0)
  }
  let count = pixels64.to_int()
  let avail = rgba.length() / 4
  let max_i = if avail < count { avail } else { count }
  let total = count * 3
  let mut rgb = Bytes::new(total)
  let mut s = 0
  let mut d = 0
  let s_end = max_i * 4
  let mut prev_a = -1
  let mut prev_inv_w = 0
  while s < s_end {
    let a = rgba[s + 3].to_int()
    if a == 255 {
      rgb[d] = rgba[s]
      rgb[d + 1] = rgba[s + 1]
      rgb[d + 2] = rgba[s + 2]
    } else if a == 0 {
      rgb[d] = 0xFF.to_byte()
      rgb[d + 1] = 0xFF.to_byte()
      rgb[d + 2] = 0xFF.to_byte()
    } else {
      if a != prev_a {
        prev_a = a
        prev_inv_w = 255 * (255 - a) + 127
      }
      let inv_w = prev_inv_w
      let r = rgba[s].to_int()
      let g = rgba[s + 1].to_int()
      let b = rgba[s + 2].to_int()
      rgb[d] = (((r * a + inv_w) * 257) >> 16).to_byte()
      rgb[d + 1] = (((g * a + inv_w) * 257) >> 16).to_byte()
      rgb[d + 2] = (((b * a + inv_w) * 257) >> 16).to_byte()
    }
    s = s + 4
    d = d + 3
  }
  // Fill any remaining pixels past short RGBA input with white
  while d < total {
    rgb[d] = 0xFF.to_byte()
    d = d + 1
  }
  rgb
}

///| Split RGBA pixels into separate RGB color plane and 8-bit Grayscale alpha mask.
///| Returns empty buffers on invalid/overflowing dimensions (`width * height * 4` checked in `Int64`).
pub fn rgba_split_rgb_alpha(rgba : Bytes, width : Int, height : Int) -> (Bytes, Bytes) {
  if width <= 0 || height <= 0 {
    return (Bytes::new(0), Bytes::new(0))
  }
  let pixels64 = width.to_int64() * height.to_int64()
  if pixels64 <= 0L || pixels64 > 268435455L {
    return (Bytes::new(0), Bytes::new(0))
  }
  let count = pixels64.to_int()
  let mut rgb = Bytes::new(count * 3)
  let mut alpha = Bytes::new(count)
  let avail = rgba.length() / 4
  let max_i = if avail < count { avail } else { count }
  let mut p = 0
  let mut s = 0
  let mut d = 0
  while p < max_i {
    rgb[d] = rgba[s]
    rgb[d + 1] = rgba[s + 1]
    rgb[d + 2] = rgba[s + 2]
    alpha[p] = rgba[s + 3]
    p = p + 1
    s = s + 4
    d = d + 3
  }
  (rgb, alpha)
}
