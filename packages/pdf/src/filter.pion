///| PDF stream compression filters (`/FlateDecode`, `/RunLengthDecode`) and pixel format converters.

import "flate"

///| PackBits (`/RunLengthDecode`, ISO 32000-1 §7.4.5) encoder.
pub fn rle_encode(src : Bytes) -> Bytes {
  let n = src.length()
  let out = ByteBuf::with_capacity(n + n / 128 + 16)
  let mut i = 0
  while i < n {
    let b = src[i].to_int() & 0xFF
    let mut run = 1
    while i + run < n && run < 128 && (src[i + run].to_int() & 0xFF) == b {
      run = run + 1
    }
    if run >= 3 {
      out.write_byte(257 - run)
      out.write_byte(b)
      i = i + run
    } else {
      let start = i
      let mut lit = 0
      while i < n && lit < 128 {
        if i + 2 < n {
          let c0 = src[i].to_int() & 0xFF
          let c1 = src[i + 1].to_int() & 0xFF
          let c2 = src[i + 2].to_int() & 0xFF
          if c0 == c1 && c0 == c2 {
            break
          }
        }
        i = i + 1
        lit = lit + 1
      }
      if lit == 0 {
        out.write_byte(0)
        out.write_byte(src[i].to_int() & 0xFF)
        i = i + 1
      } else {
        out.write_byte(lit - 1)
        out.write_slice(src, start, lit)
      }
    }
  }
  out.write_byte(0x80)
  out.to_bytes()
}

///| PackBits (`/RunLengthDecode`, ISO 32000-1 §7.4.5) decoder with explicit output limit.
pub fn rle_decode(src : Bytes, max_output_bytes : Int) -> Result[Bytes, PdfError] {
  if max_output_bytes < 0 {
    return Err(PdfError::LimitExceeded("negative max_output_bytes"))
  }
  let eff_limit = if max_output_bytes == 0 { 2147483647 } else { max_output_bytes }
  let n = src.length()
  let out = ByteBuf::with_capacity(if n < 4096 { n * 2 } else { n })
  let mut i = 0
  while i < n {
    let ctrl = src[i].to_int() & 0xFF
    i = i + 1
    if ctrl == 128 {
      // EOD marker 0x80
      return Ok(out.to_bytes())
    } else if ctrl < 128 {
      let count = ctrl + 1
      if i + count > n {
        return Err(PdfError::InvalidFilter("truncated RunLengthDecode literal packet"))
      }
      if out.n + count > eff_limit {
        return Err(
          PdfError::LimitExceeded(
            "RunLengthDecode output exceeded limit of " + eff_limit.to_string() + " bytes",
          ),
        )
      }
      out.write_slice(src, i, count)
      i = i + count
    } else {
      let count = 257 - ctrl
      if i >= n {
        return Err(PdfError::InvalidFilter("truncated RunLengthDecode repeat packet"))
      }
      if out.n + count > eff_limit {
        return Err(
          PdfError::LimitExceeded(
            "RunLengthDecode output exceeded limit of " + eff_limit.to_string() + " bytes",
          ),
        )
      }
      let b = src[i].to_int() & 0xFF
      i = i + 1
      out.ensure(count)
      let base = out.n
      let bv = b.to_byte()
      let mut k = 0
      while k < count {
        out.buf[base + k] = bv
        k = k + 1
      }
      out.n = base + count
    }
  }
  Ok(out.to_bytes())
}

///| RFC 1950 zlib (`/FlateDecode`) encoder backed by `flate::zlib_compress`.
pub fn flate_encode(src : Bytes, level : Int) -> Result[Bytes, PdfError] {
  match flate::zlib_compress(src, level) {
    Ok(b) => Ok(b)
    Err(e) => Err(PdfError::CompressionFailed(flate::flate_error_message(e)))
  }
}

///| RFC 1950 zlib (`/FlateDecode`) decoder backed by `flate::zlib_decompress_with_limit`.
pub fn flate_decode(src : Bytes, max_output_bytes : Int) -> Result[Bytes, PdfError] {
  match flate::zlib_decompress_with_limit(src, max_output_bytes) {
    Ok(b) => Ok(b)
    Err(flate::FlateError::OutputLimitExceeded(lim)) =>
    Err(PdfError::LimitExceeded("FlateDecode output exceeded limit: " + lim.to_string()))
    Err(e) => Err(PdfError::CompressionFailed(flate::flate_error_message(e)))
  }
}

///| Compress a stream payload according to `Compression`, returning `(filter_name, bytes)`.
fn compress_stream(src : Bytes, compression : Compression) -> Result[(String, Bytes), PdfError] {
  match compression {
    Uncompressed => Ok(("", src))
    RunLength => Ok(("/RunLengthDecode", rle_encode(src)))
    Flate(level) =>
    match flate_encode(src, level) {
      Ok(b) => Ok(("/FlateDecode", b))
      Err(e) => Err(e)
    }
  }
}

///| Composite straight-alpha RGBA pixels over white paper into opaque RGB.
pub fn rgba_to_white_rgb(rgba : Bytes, width : Int, height : Int) -> Bytes {
  if width <= 0 || height <= 0 {
    return Bytes::new(0)
  }
  let count = width * height
  let mut rgb = Bytes::new(count * 3)
  let mut init_i = 0
  while init_i < count * 3 {
    rgb[init_i] = 0xFF.to_byte()
    init_i = init_i + 1
  }
  let avail = rgba.length() / 4
  let max_i = if avail < count { avail } else { count }
  let mut p = 0
  while p < max_i {
    let s = p * 4
    let d = p * 3
    let a = rgba[s + 3].to_int() & 0xFF
    if a >= 255 {
      rgb[d] = rgba[s]
      rgb[d + 1] = rgba[s + 1]
      rgb[d + 2] = rgba[s + 2]
    } else if a > 0 {
      let inv = 255 - a
      let r = rgba[s].to_int() & 0xFF
      let g = rgba[s + 1].to_int() & 0xFF
      let b = rgba[s + 2].to_int() & 0xFF
      rgb[d] = ((r * a + 255 * inv) / 255).to_byte()
      rgb[d + 1] = ((g * a + 255 * inv) / 255).to_byte()
      rgb[d + 2] = ((b * a + 255 * inv) / 255).to_byte()
    }
    p = p + 1
  }
  rgb
}

///| Split RGBA pixels into separate RGB color plane and 8-bit Grayscale alpha mask.
pub fn rgba_split_rgb_alpha(rgba : Bytes, width : Int, height : Int) -> (Bytes, Bytes) {
  if width <= 0 || height <= 0 {
    return (Bytes::new(0), Bytes::new(0))
  }
  let count = width * height
  let mut rgb = Bytes::new(count * 3)
  let mut alpha = Bytes::new(count)
  let avail = rgba.length() / 4
  let max_i = if avail < count { avail } else { count }
  let mut p = 0
  while p < max_i {
    let s = p * 4
    let d = p * 3
    rgb[d] = rgba[s]
    rgb[d + 1] = rgba[s + 1]
    rgb[d + 2] = rgba[s + 2]
    alpha[p] = rgba[s + 3]
    p = p + 1
  }
  (rgb, alpha)
}
