}

///|
pub fn Page::draw_image(
  self : Page,
  image : ImageId,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
) -> Unit {
  self.stream.draw_image(image, x, y, w, h)
}

///| Multi-page PDF 1.4 document builder.
pub struct PdfDoc {
  doc_tag : Int
  limits : Limits
  mut compression : Compression
  mut info : DocInfo
  pages : Array[FrozenPage]
  images : Array[PdfImage]
  mut retained_bytes : Int64
  mut est_objects : Int
}

///| Create a new `PdfDoc` with default limits and `/FlateDecode` (level 6).
pub fn PdfDoc::new() -> PdfDoc {
  PdfDoc::with_limits(Limits::default())
}

///| Create a new `PdfDoc` with custom resource limits.
pub fn PdfDoc::with_limits(limits : Limits) -> PdfDoc {
  PdfDoc::{
    doc_tag: next_doc_tag(),
    limits: limits,
    compression: flate_default(),
    info: DocInfo::empty(),
    pages: [],
    images: [],
    retained_bytes: 0L,
    est_objects: 3,
  }
}

///| Set the default compression filter for page streams and newly added images.
pub fn PdfDoc::set_compression(self : PdfDoc, compression : Compression) -> Unit {
  self.compression = compression
}

///|
pub fn PdfDoc::set_info(self : PdfDoc, info : DocInfo) -> Unit {
  self.info = info
}

///|
pub fn PdfDoc::set_title(self : PdfDoc, title : String) -> Unit {
  self.info = DocInfo::{ ..self.info, title: title }
}

///|
pub fn PdfDoc::set_author(self : PdfDoc, author : String) -> Unit {
  self.info = DocInfo::{ ..self.info, author: author }
}

///|
pub fn PdfDoc::set_subject(self : PdfDoc, subject : String) -> Unit {
  self.info = DocInfo::{ ..self.info, subject: subject }
}

///|
pub fn PdfDoc::set_keywords(self : PdfDoc, keywords : String) -> Unit {
  self.info = DocInfo::{ ..self.info, keywords: keywords }
}

///|
pub fn PdfDoc::set_creator(self : PdfDoc, creator : String) -> Unit {
  self.info = DocInfo::{ ..self.info, creator: creator }
}

///|
pub fn PdfDoc::set_producer(self : PdfDoc, producer : String) -> Unit {
  self.info = DocInfo::{ ..self.info, producer: producer }
}

///| Validate and append an immutable snapshot of `page`, returning its 0-based page index.
pub fn PdfDoc::add_page(self : PdfDoc, page : Page) -> Result[Int, PdfError] {
  // PDF 1.4 Annex C: MediaBox dimensions must be finite and within [3.0, 14400.0] units
  if page.width != page.width ||
  page.height != page.height ||
  page.width < 3.0 ||
  page.height < 3.0 ||
  page.width > 14400.0 ||
  page.height > 14400.0 {
    return Err(
      PdfError::InvalidDimension(
        "page width and height must be finite numbers in [3.0, 14400.0] pt",
      ),
    )
  }
  if self.limits.max_pages <= 0 || self.pages.length() >= self.limits.max_pages {
    return Err(
      PdfError::LimitExceeded(
        "page count exceeded max_pages (" + self.limits.max_pages.to_string() + ")",
      ),
    )
  }
  if page.stream.q_underflow || page.stream.q_depth != 0 {
    return Err(PdfError::InvalidPage("unbalanced save/restore (q/Q) graphics state"))
  }
  if page.stream.buf.overflowed ||
  self.limits.max_stream_bytes < 0 ||
  page.stream.byte_len() > self.limits.max_stream_bytes {
    return Err(PdfError::LimitExceeded("page content stream exceeded max_stream_bytes"))
  }
  if self.limits.max_objects <= 0 || self.est_objects + 2 > self.limits.max_objects {
    return Err(PdfError::LimitExceeded("object count exceeded max_objects"))
  }
  let raw_stream = page.stream.to_bytes()
  let used_imgs : Array[Int] = []
  let mut i = 0
  while i < page.stream.used_images.length() {
    used_imgs.push(page.stream.used_images[i])
    i = i + 1
  }
  let idx = self.pages.length()
  self.pages.push(
    FrozenPage::{
      width: page.width,
      height: page.height,
      raw_stream: raw_stream,
      used_fonts: page.stream.used_fonts,
      used_images: used_imgs,
      compression: page.compression,
    },
  )
  self.est_objects = self.est_objects + 2
  Ok(idx)
}

///| Check image dimensions against `Limits::max_image_pixels`.
fn PdfDoc::check_image_dims(self : PdfDoc, width : Int, height : Int) -> Result[Int, PdfError] {
  if width <= 0 || height <= 0 {
    return Err(PdfError::InvalidDimension("image width and height must be > 0"))
  }
  let pixels64 = width.to_int64() * height.to_int64()
  if self.limits.max_image_pixels <= 0 || pixels64 > self.limits.max_image_pixels.to_int64() {
    return Err(
      PdfError::LimitExceeded(
        "image pixel count " +
        pixels64.to_string() +
        " exceeded max_image_pixels (" +
        self.limits.max_image_pixels.to_string() +
        ")",
      ),
    )
  }
  if pixels64 > 268435455L {
    return Err(PdfError::LimitExceeded("image pixel count overflows 32-bit byte buffer"))
  }
  Ok(pixels64.to_int())
}

///| Check early document byte and object budgets before retaining a new image XObject.
fn PdfDoc::check_retain_budget(
  self : PdfDoc,
  added_bytes : Int64,
  added_objs : Int,
) -> Result[Unit, PdfError] {
  if self.limits.max_objects <= 0 || self.est_objects + added_objs > self.limits.max_objects {
    return Err(PdfError::LimitExceeded("object count exceeded max_objects"))
  }
  if self.limits.max_document_bytes <= 0 ||
  self.retained_bytes + added_bytes > self.limits.max_document_bytes.to_int64() {
    return Err(PdfError::LimitExceeded("retained document data exceeded max_document_bytes"))
  }
  if self.images.length() >= 65535 {
    return Err(PdfError::LimitExceeded("image count exceeded 65535 per document"))
  }
  Ok(())
}

///| Register an 8-bit RGB image XObject using the document's default compression.
pub fn PdfDoc::add_rgb_image(
  self : PdfDoc,
  width : Int,
  height : Int,
  rgb : Bytes,
) -> Result[ImageId, PdfError] {
  self.add_rgb_image_with_compression(width, height, rgb, self.compression)
}

///| Register an 8-bit RGB image XObject with an explicit compression filter.
pub fn PdfDoc::add_rgb_image_with_compression(
  self : PdfDoc,
  width : Int,
  height : Int,
  rgb : Bytes,
  compression : Compression,
) -> Result[ImageId, PdfError] {
  let pixels = match self.check_image_dims(width, height) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let expected = pixels * 3
  if rgb.length() != expected {
    return Err(
      PdfError::InvalidImage(
        "RGB buffer length " +
        rgb.length().to_string() +
        " does not match width*height*3 (" +
        expected.to_string() +
        ")",
      ),
    )
  }
  match compression {
    Uncompressed =>
    match self.check_retain_budget(expected.to_int64(), 1) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    _ => ()
  }
  let (filter, encoded) = match compress_stream(rgb, compression) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }
  if self.limits.max_stream_bytes <= 0 || encoded.length() > self.limits.max_stream_bytes {
    return Err(PdfError::LimitExceeded("image stream exceeded max_stream_bytes"))
  }
  match self.check_retain_budget(encoded.length().to_int64(), 1) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let local_idx = self.images.length()
  self.images.push(
    PdfImage::{
      width: width,
      height: height,
      color_space: "/DeviceRGB",
      filter: filter,
      data: encoded,
      invert_cmyk_decode: false,
      has_smask: false,
      smask_filter: "",
      smask_data: Bytes::new(0),
    },
  )
  self.retained_bytes = self.retained_bytes + encoded.length().to_int64()
  self.est_objects = self.est_objects + 1
  Ok(ImageId::{ index: (self.doc_tag << 16) | local_idx })
}

///| Register an 8-bit RGBA image XObject using the document's default compression.
pub fn PdfDoc::add_rgba_image(
  self : PdfDoc,
  width : Int,
  height : Int,
  rgba : Bytes,
  alpha_mode : AlphaMode,
) -> Result[ImageId, PdfError] {
  self.add_rgba_image_with_compression(width, height, rgba, alpha_mode, self.compression)
}

///| Register an 8-bit RGBA image XObject with explicit alpha mode and compression.
pub fn PdfDoc::add_rgba_image_with_compression(
  self : PdfDoc,
  width : Int,
  height : Int,
  rgba : Bytes,
  alpha_mode : AlphaMode,
  compression : Compression,
) -> Result[ImageId, PdfError] {
  let pixels = match self.check_image_dims(width, height) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let expected = pixels * 4
  if rgba.length() != expected {
    return Err(
      PdfError::InvalidImage(
        "RGBA buffer length " +
        rgba.length().to_string() +
        " does not match width*height*4 (" +
        expected.to_string() +
        ")",
      ),
    )
  }
  match alpha_mode {
    BlendWhite => {
      let rgb = rgba_to_white_rgb(rgba, width, height)
      self.add_rgb_image_with_compression(width, height, rgb, compression)
    }
    SoftMask => {
      let (rgb, alpha) = rgba_split_rgb_alpha(rgba, width, height)
      let (filter, enc_rgb) = match compress_stream(rgb, compression) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      let (smask_filter, enc_alpha) = match compress_stream(alpha, compression) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      if self.limits.max_stream_bytes <= 0 ||
      enc_rgb.length() > self.limits.max_stream_bytes ||
      enc_alpha.length() > self.limits.max_stream_bytes {
        return Err(PdfError::LimitExceeded("image or SMask stream exceeded max_stream_bytes"))
      }
      let total_added = enc_rgb.length().to_int64() + enc_alpha.length().to_int64()
      match self.check_retain_budget(total_added, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let local_idx = self.images.length()
      self.images.push(
        PdfImage::{
          width: width,
          height: height,
          color_space: "/DeviceRGB",
          filter: filter,
          data: enc_rgb,
          invert_cmyk_decode: false,
          has_smask: true,
          smask_filter: smask_filter,
          smask_data: enc_alpha,
        },
      )
      self.retained_bytes = self.retained_bytes + total_added
      self.est_objects = self.est_objects + 2
      Ok(ImageId::{ index: (self.doc_tag << 16) | local_idx })
    }
  }
}

///| Parse JPEG markers to extract `(sof_width, sof_height, components, has_adobe_app14)`.
///| Covers all SOF0..SOF15 markers (excluding DHT 0xC4, JPG 0xC8, DAC 0xCC).
fn parse_jpeg_header(jpeg : Bytes) -> Result[(Int, Int, Int, Bool), PdfError] {
  let n = jpeg.length()
  if n < 4 || (jpeg[0].to_int() & 0xFF) != 0xFF || (jpeg[1].to_int() & 0xFF) != 0xD8 {
    return Err(PdfError::InvalidImage("JPEG bytes must start with SOI marker 0xFF 0xD8"))
  }
  let mut is_adobe = false
  let mut i = 2
  while i + 2 <= n {
    if (jpeg[i].to_int() & 0xFF) != 0xFF {
      return Err(PdfError::InvalidImage("invalid JPEG marker alignment"))
    }
    while i < n && (jpeg[i].to_int() & 0xFF) == 0xFF {
      i = i + 1
    }
    if i >= n {
      break
    }
    let marker = jpeg[i].to_int() & 0xFF
    i = i + 1
    if marker == 0xD9 || marker == 0xDA {
      break
    }
    if marker == 0x01 || (marker >= 0xD0 && marker <= 0xD8) {
      continue
    }
    if i + 2 > n {
      return Err(PdfError::InvalidImage("truncated JPEG segment length"))
    }
    let seg_len = ((jpeg[i].to_int() & 0xFF) << 8) | (jpeg[i + 1].to_int() & 0xFF)
    if seg_len < 2 || i + seg_len > n {
      return Err(PdfError::InvalidImage("invalid JPEG segment length"))
    }
    // Check Adobe APP14 ("Adobe") marker for inverted CMYK detection
    if marker == 0xEE &&
    seg_len >= 14 &&
    (jpeg[i + 2].to_int() & 0xFF) == 65 &&
    (jpeg[i + 3].to_int() & 0xFF) == 100 &&
    (jpeg[i + 4].to_int() & 0xFF) == 111 &&
    (jpeg[i + 5].to_int() & 0xFF) == 98 &&
    (jpeg[i + 6].to_int() & 0xFF) == 101 {
      is_adobe = true
    }
    // All Start-of-Frame markers: 0xC0..0xCF except DHT(0xC4), JPG(0xC8), DAC(0xCC)
    if marker >= 0xC0 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC {
      if seg_len < 8 {
        return Err(PdfError::InvalidImage("truncated JPEG SOF segment"))
      }
      let sof_h = ((jpeg[i + 3].to_int() & 0xFF) << 8) | (jpeg[i + 4].to_int() & 0xFF)
      let sof_w = ((jpeg[i + 5].to_int() & 0xFF) << 8) | (jpeg[i + 6].to_int() & 0xFF)
      let comps = jpeg[i + 7].to_int() & 0xFF
      return Ok((sof_w, sof_h, comps, is_adobe))
    }
    i = i + seg_len
  }
  Err(PdfError::InvalidImage("JPEG stream missing Start-of-Frame (SOF) marker"))
}

///| Register a JPEG image XObject via zero-recompression `/DCTDecode` passthrough.
///| Strictly validates SOF dimensions and component count, and emits `/Decode [1 0 1 0 1 0 1 0]` for Adobe CMYK JPEGs.
pub fn PdfDoc::add_jpeg_image(
  self : PdfDoc,
  width : Int,
  height : Int,
  jpeg : Bytes,
) -> Result[ImageId, PdfError] {
  let _ = match self.check_image_dims(width, height) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let (sof_w, sof_h, comps, is_adobe) = match parse_jpeg_header(jpeg) {
    Ok(info) => info
    Err(e) => return Err(e)
  }
  if sof_w != width || sof_h != height {
    return Err(
      PdfError::InvalidImage(
        "declared JPEG dimensions " +
        width.to_string() +
        "x" +
        height.to_string() +
        " do not match SOF header " +
        sof_w.to_string() +
        "x" +
        sof_h.to_string(),
      ),
    )
  }
  let cs = if comps == 1 {
    "/DeviceGray"
  } else if comps == 3 {
    "/DeviceRGB"
  } else if comps == 4 {
    "/DeviceCMYK"
  } else {
    return Err(
      PdfError::InvalidImage("unsupported JPEG component count: " + comps.to_string()),
    )
  }
  if self.limits.max_stream_bytes <= 0 || jpeg.length() > self.limits.max_stream_bytes {
    return Err(PdfError::LimitExceeded("JPEG stream exceeded max_stream_bytes"))
  }
  match self.check_retain_budget(jpeg.length().to_int64(), 1) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let local_idx = self.images.length()
  self.images.push(
    PdfImage::{
      width: width,
      height: height,
      color_space: cs,
      filter: "/DCTDecode",
      data: jpeg,
      invert_cmyk_decode: comps == 4 && is_adobe,
      has_smask: false,
      smask_filter: "",
      smask_data: Bytes::new(0),
    },
  )
  self.retained_bytes = self.retained_bytes + jpeg.length().to_int64()
  self.est_objects = self.est_objects + 1
  Ok(ImageId::{ index: (self.doc_tag << 16) | local_idx })
}

///| Return true if any `DocInfo` metadata field is non-empty.
fn has_doc_info(info : DocInfo) -> Bool {
  info.title.length() > 0 ||
  info.author.length() > 0 ||
  info.subject.length() > 0 ||
  info.keywords.length() > 0 ||
  info.creator.length() > 0 ||
  info.producer.length() > 0
}

///| Encode the complete ISO 32000-1 PDF 1.4 document into a single `Bytes` buffer.
pub fn PdfDoc::encode(self : PdfDoc) -> Result[Bytes, PdfError] {
  let n_pages = self.pages.length()
  let n_images = self.images.length()
  if n_pages == 0 {
    return Err(PdfError::InvalidPage("document must contain at least one page"))
  }
  if self.limits.max_pages <= 0 || n_pages > self.limits.max_pages {
    return Err(PdfError::LimitExceeded("page count exceeded max_pages"))
  }
  if self.limits.max_document_bytes <= 0 {
    return Err(PdfError::LimitExceeded("max_document_bytes must be > 0"))
  }

  // Collect union of all used Standard 14 fonts and verify all ImageId ownership tags
  let mut all_fonts_mask = 0
  let mut pi = 0
  while pi < n_pages {
    all_fonts_mask = all_fonts_mask | self.pages[pi].used_fonts
    let used_imgs = self.pages[pi].used_images
    let mut ui = 0
    while ui < used_imgs.length() {
      let full_id = used_imgs[ui]
      if full_id < 0 {
        return Err(
          PdfError::InvalidImage("page references invalid ImageId(" + full_id.to_string() + ")"),
        )
      }
      let tag = full_id >> 16
      let local_idx = full_id & 0xFFFF
      if tag != self.doc_tag || local_idx < 0 || local_idx >= n_images {
        return Err(
          PdfError::InvalidImage(
            "page references unknown or foreign ImageId(" + full_id.to_string() + ")",
          ),
        )
      }
      ui = ui + 1
    }
    pi = pi + 1
  }

  // Assign deterministic sequential object IDs
  let mut next_id = 3
  let info_id = if has_doc_info(self.info) {
    let id = next_id
    next_id = next_id + 1
    id
  } else {
    0
  }

  let font_obj_ids = FixedArray::make(14, 0)
  let mut fi = 0
  while fi < 14 {
    if ((all_fonts_mask >> fi) & 1) != 0 {
      font_obj_ids[fi] = next_id
      next_id = next_id + 1
    }
    fi = fi + 1
  }

  let img_obj_ids = FixedArray::make(n_images, 0)
  let smask_obj_ids = FixedArray::make(n_images, 0)
  let mut est_bytes : Int64 = 512L + n_pages.to_int64() * 256L
  let mut ii = 0
  while ii < n_images {
    img_obj_ids[ii] = next_id
    next_id = next_id + 1
    est_bytes = est_bytes + self.images[ii].data.length().to_int64() + 256L
    if self.images[ii].has_smask {
      smask_obj_ids[ii] = next_id
      next_id = next_id + 1
      est_bytes = est_bytes + self.images[ii].smask_data.length().to_int64() + 192L
    }
    ii = ii + 1
  }

  let page_obj_ids = FixedArray::make(n_pages, 0)
  let content_obj_ids = FixedArray::make(n_pages, 0)
  let mut pk = 0
  while pk < n_pages {
    page_obj_ids[pk] = next_id
    content_obj_ids[pk] = next_id + 1
    next_id = next_id + 2
    est_bytes = est_bytes + self.pages[pk].raw_stream.length().to_int64()
    pk = pk + 1
  }

  let total_objs = next_id
  if self.limits.max_objects <= 0 || total_objs > self.limits.max_objects {
    return Err(
      PdfError::LimitExceeded(
        "object count " +
        total_objs.to_string() +
        " exceeded max_objects (" +
        self.limits.max_objects.to_string() +
        ")",
      ),
    )
  }

  // Large streams (>= 1 KiB) are appended as zero-copy Bytes chunks, so staging only holds headers/xref.
  let staging_est : Int64 = 1024L + n_pages.to_int64() * 256L + n_images.to_int64() * 256L
  let max_doc64 = self.limits.max_document_bytes.to_int64()
  let cap64 = if staging_est > max_doc64 { max_doc64 } else { staging_est }
  let init_cap = if cap64 > 65536L { 65536 } else { cap64.to_int() }
  let buf = ByteBuf::with_budget(init_cap, self.limits.max_document_bytes)

  // PDF 1.4 header + binary comment marker (ISO 32000-1 §7.5.2)
  buf.write_str("%PDF-1.4\n%")
  buf.write_byte(0xE2)
  buf.write_byte(0xE3)
  buf.write_byte(0xCF)
  buf.write_byte(0xD3)
  buf.write_byte(10)

  let offsets = FixedArray::make(total_objs, 0)

  // Obj 1: Catalog
  offsets[1] = buf.n
  buf.write_str("1 0 obj\n<</Type /Catalog /Pages 2 0 R>>\nendobj\n")

  // Obj 2: Pages
  offsets[2] = buf.n
  buf.write_str("2 0 obj\n<</Type /Pages /Count ")
  buf.write_int(n_pages)
  buf.write_str(" /Kids [")
  let mut ki = 0
  while ki < n_pages {
    if ki > 0 {
      buf.write_byte(32)
    }
    buf.write_int(page_obj_ids[ki])
    buf.write_str(" 0 R")
    ki = ki + 1
  }
  buf.write_str("]>>\nendobj\n")

  // Optional Info dictionary (ISO 32000-1 §7.9.2.2 PDF text strings)
  if info_id > 0 {
    offsets[info_id] = buf.n
    buf.write_int(info_id)
    buf.write_str(" 0 obj\n<<")
    if self.info.title.length() > 0 {
      buf.write_str("/Title ")
      buf.write_pdf_text_string(self.info.title)
      buf.write_byte(32)
    }
    if self.info.author.length() > 0 {
      buf.write_str("/Author ")
      buf.write_pdf_text_string(self.info.author)
      buf.write_byte(32)
    }
    if self.info.subject.length() > 0 {
      buf.write_str("/Subject ")
      buf.write_pdf_text_string(self.info.subject)
      buf.write_byte(32)
    }
    if self.info.keywords.length() > 0 {
      buf.write_str("/Keywords ")
      buf.write_pdf_text_string(self.info.keywords)
      buf.write_byte(32)
    }
    if self.info.creator.length() > 0 {
      buf.write_str("/Creator ")
      buf.write_pdf_text_string(self.info.creator)
      buf.write_byte(32)
    }
    if self.info.producer.length() > 0 {
      buf.write_str("/Producer ")
      buf.write_pdf_text_string(self.info.producer)
      buf.write_byte(32)
    }
    buf.write_str(">>\nendobj\n")
  }

  // Font objects
  let mut fk = 0
  while fk < 14 {
    let fid = font_obj_ids[fk]
    if fid > 0 {
      let font = standard_font_from_index(fk)
      offsets[fid] = buf.n
      buf.write_int(fid)
      buf.write_str(" 0 obj\n<</Type /Font /Subtype /Type1 /BaseFont /")
      buf.write_str(standard_font_name(font))
      if fk < 12 {
        buf.write_str(" /Encoding /WinAnsiEncoding")
      }
      buf.write_str(">>\nendobj\n")
    }
    fk = fk + 1
  }

  // Image XObjects (and optional /SMask objects)
  let mut ik = 0
  while ik < n_images {
    let img = self.images[ik]
    let oid = img_obj_ids[ik]
    let smid = smask_obj_ids[ik]
    offsets[oid] = buf.n
    buf.write_int(oid)
    buf.write_str(" 0 obj\n<</Type /XObject /Subtype /Image /Width ")
    buf.write_int(img.width)
    buf.write_str(" /Height ")
    buf.write_int(img.height)
    buf.write_str(" /ColorSpace ")
    buf.write_str(img.color_space)
    buf.write_str(" /BitsPerComponent 8")
    if img.invert_cmyk_decode {
      buf.write_str(" /Decode [1 0 1 0 1 0 1 0]")
    }
    if img.filter.length() > 0 {
      buf.write_str(" /Filter ")
      buf.write_str(img.filter)
    }
    if img.has_smask {
      buf.write_str(" /SMask ")
      buf.write_int(smid)
      buf.write_str(" 0 R")
    }
    buf.write_str(" /Length ")
    buf.write_int(img.data.length())
    buf.write_str(">>\nstream\n")
    buf.write_bytes(img.data)
    buf.write_str("\nendstream\nendobj\n")

    if img.has_smask {
      offsets[smid] = buf.n
      buf.write_int(smid)
      buf.write_str(" 0 obj\n<</Type /XObject /Subtype /Image /Width ")
      buf.write_int(img.width)
      buf.write_str(" /Height ")
      buf.write_int(img.height)
      buf.write_str(" /ColorSpace /DeviceGray /BitsPerComponent 8")
      if img.smask_filter.length() > 0 {
        buf.write_str(" /Filter ")
        buf.write_str(img.smask_filter)
      }
      buf.write_str(" /Length ")
      buf.write_int(img.smask_data.length())
      buf.write_str(">>\nstream\n")
      buf.write_bytes(img.smask_data)
      buf.write_str("\nendstream\nendobj\n")
    }
    if buf.overflowed {
      return Err(PdfError::LimitExceeded("document exceeded max_document_bytes"))
    }
    ik = ik + 1
  }

  // Page + Content objects
  let mut p_idx = 0
  while p_idx < n_pages {
    let page = self.pages[p_idx]
    let pid = page_obj_ids[p_idx]
    let cid = content_obj_ids[p_idx]

    offsets[pid] = buf.n
    buf.write_int(pid)
    buf.write_str(" 0 obj\n<</Type /Page /Parent 2 0 R /MediaBox [0 0 ")
    buf.write_num(page.width)
    buf.write_byte(32)
    buf.write_num(page.height)
    buf.write_str("] /Resources <<")

    let fmask = page.used_fonts
    if fmask != 0 {
      buf.write_str("/Font <<")
      let mut f = 0
      while f < 14 {
        if ((fmask >> f) & 1) != 0 {
          buf.write_str("/F")
          buf.write_int(f + 1)
          buf.write_byte(32)
          buf.write_int(font_obj_ids[f])
          buf.write_str(" 0 R ")
        }
        f = f + 1
      }
      buf.write_str(">> ")
    }

    let uimgs = page.used_images
    if uimgs.length() > 0 {
      buf.write_str("/XObject <<")
      let mut u = 0
      while u < uimgs.length() {
        let local_i = uimgs[u] & 0xFFFF
        buf.write_str("/Im")
        buf.write_int(local_i)
        buf.write_byte(32)
        buf.write_int(img_obj_ids[local_i])
        buf.write_str(" 0 R ")
        u = u + 1
      }
      buf.write_str(">>")
    }

    buf.write_str(">> /Contents ")
    buf.write_int(cid)
    buf.write_str(" 0 R>>\nendobj\n")

    let raw_stream = page.raw_stream
    if self.limits.max_stream_bytes < 0 || raw_stream.length() > self.limits.max_stream_bytes {
      return Err(PdfError::LimitExceeded("page content stream exceeded max_stream_bytes"))
    }
    let page_comp = match page.compression {
      Some(c) => c
      None => self.compression
    }
    let (c_filter, c_bytes) = match compress_stream(raw_stream, page_comp) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    if self.limits.max_stream_bytes < 0 || c_bytes.length() > self.limits.max_stream_bytes {
      return Err(PdfError::LimitExceeded("compressed content stream exceeded max_stream_bytes"))
    }
    offsets[cid] = buf.n
    buf.write_int(cid)
    buf.write_str(" 0 obj\n<<")
    if c_filter.length() > 0 {
      buf.write_str("/Filter ")
      buf.write_str(c_filter)
      buf.write_byte(32)
    }
    buf.write_str("/Length ")
    buf.write_int(c_bytes.length())
    buf.write_str(">>\nstream\n")
    buf.write_bytes(c_bytes)
    buf.write_str("\nendstream\nendobj\n")

    if buf.overflowed {
      return Err(PdfError::LimitExceeded("document exceeded max_document_bytes"))
    }
    p_idx = p_idx + 1
  }

  // XRef table (exact 20-byte entries)
  let xref_off = buf.n
  buf.write_str("xref\n0 ")
  buf.write_int(total_objs)
  buf.write_str("\n0000000000 65535 f \n")
  let mut oi = 1
  while oi < total_objs {
    buf.write_pad10(offsets[oi])
    buf.write_str(" 00000 n \n")
    oi = oi + 1
  }

  // Trailer
  buf.write_str("trailer\n<</Size ")
  buf.write_int(total_objs)
  buf.write_str(" /Root 1 0 R")
  if info_id > 0 {
    buf.write_str(" /Info ")
    buf.write_int(info_id)
    buf.write_str(" 0 R")
  }
  buf.write_str(">>\nstartxref\n")
  buf.write_int(xref_off)
  buf.write_str("\n%%EOF\n")

  if buf.overflowed || buf.n > self.limits.max_document_bytes {
    return Err(PdfError::LimitExceeded("final document exceeded max_document_bytes"))
  }
  Ok(buf.to_bytes())
}

///| Convenience function: encode `(width, height, rgba)` pages as A4 PDF using `/RunLengthDecode`.
pub fn encode_pdf_pages(pages : Array[(Int, Int, Bytes)]) -> Result[Bytes, PdfError] {
  encode_pdf_pages_with_compression(pages, Compression::RunLength)
}

///| Encode `(width, height, rgba)` pages as A4 PDF with the chosen compression filter.
pub fn encode_pdf_pages_with_compression(
  pages : Array[(Int, Int, Bytes)],
  compression : Compression,
) -> Result[Bytes, PdfError] {
  let doc = PdfDoc::new()
  doc.set_compression(Compression::Uncompressed)
  let mut i = 0
  while i < pages.length() {
    let (pw, ph, rgba) = pages[i]
    let img_id = match
    doc.add_rgba_image_with_compression(pw, ph, rgba, AlphaMode::BlendWhite, compression) {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    let page = Page::a4()
    page.draw_image(img_id, 0.0, 0.0, a4_width, a4_height)
    match doc.add_page(page) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  doc.encode()
}
