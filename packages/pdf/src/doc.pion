///| ISO 32000-1 PDF 1.4 multi-page document and page builder.

///| Process-local monotonic counter for per-document `ImageId` ownership tags.
let pdf_doc_tag_counter : FixedArray[Int] = FixedArray::make(1, 1)

fn next_doc_tag() -> Int {
  let tag = pdf_doc_tag_counter[0]
  pdf_doc_tag_counter[0] = if tag >= 32766 { 1 } else { tag + 1 }
  tag
}

///| Internal image XObject record stored in `PdfDoc`.
struct PdfImage {
  width : Int
  height : Int
  color_space : String
  filter : String
  data : Bytes
  invert_cmyk_decode : Bool
  has_smask : Bool
  smask_filter : String
  smask_data : Bytes
}

///| Immutable snapshot of a page captured at `PdfDoc::add_page`.
struct FrozenPage {
  width : Double
  height : Double
  raw_stream : Bytes
  used_fonts : Int
  used_images : Array[Int]
  compression : Option[Compression]
}

///| A single PDF page with dimensions and drawing content stream.
pub struct Page {
  width : Double
  height : Double
  stream : ContentStream
  mut compression : Option[Compression]
}

///|
pub fn Page::new(width : Double, height : Double) -> Page {
  Page::{
    width: width,
    height: height,
    stream: ContentStream::new(),
    compression: None,
  }
}

///|
pub fn Page::a4() -> Page {
  Page::new(a4_width, a4_height)
}

///|
pub fn Page::letter() -> Page {
  Page::new(letter_width, letter_height)
}

///|
pub fn Page::from_size(size : PageSize) -> Page {
  Page::new(size.width, size.height)
}

///|
pub fn Page::width(self : Page) -> Double {
  self.width
}

///|
pub fn Page::height(self : Page) -> Double {
  self.height
}

///|
pub fn Page::content(self : Page) -> ContentStream {
  self.stream
}

///|
pub fn Page::set_compression(self : Page, compression : Compression) -> Unit {
  self.compression = Some(compression)
}

///|
pub fn Page::set_max_stream_bytes(self : Page, max_bytes : Int) -> Unit {
  self.stream.set_max_bytes(max_bytes)
}

///|
pub fn Page::save(self : Page) -> Unit {
  self.stream.save()
}

///|
pub fn Page::restore(self : Page) -> Unit {
  self.stream.restore()
}

///|
pub fn Page::concat_matrix(
  self : Page,
  a : Double,
  b : Double,
  c : Double,
  d : Double,
  e : Double,
  f : Double,
) -> Unit {
  self.stream.concat_matrix(a, b, c, d, e, f)
}

///|
pub fn Page::set_line_width(self : Page, width : Double) -> Unit {
  self.stream.set_line_width(width)
}

///|
pub fn Page::set_line_cap(self : Page, cap : Int) -> Unit {
  self.stream.set_line_cap(cap)
}

///|
pub fn Page::set_line_join(self : Page, join : Int) -> Unit {
  self.stream.set_line_join(join)
}

///|
pub fn Page::set_miter_limit(self : Page, limit : Double) -> Unit {
  self.stream.set_miter_limit(limit)
}

///|
pub fn Page::set_dash(self : Page, pattern : Array[Double], phase : Double) -> Unit {
  self.stream.set_dash(pattern, phase)
}

///|
pub fn Page::set_fill_rgb(self : Page, r : Double, g : Double, b : Double) -> Unit {
  self.stream.set_fill_rgb(r, g, b)
}

///|
pub fn Page::set_stroke_rgb(self : Page, r : Double, g : Double, b : Double) -> Unit {
  self.stream.set_stroke_rgb(r, g, b)
}

///|
pub fn Page::set_fill_gray(self : Page, g : Double) -> Unit {
  self.stream.set_fill_gray(g)
}

///|
pub fn Page::set_stroke_gray(self : Page, g : Double) -> Unit {
  self.stream.set_stroke_gray(g)
}

///|
pub fn Page::move_to(self : Page, x : Double, y : Double) -> Unit {
  self.stream.move_to(x, y)
}

///|
pub fn Page::line_to(self : Page, x : Double, y : Double) -> Unit {
  self.stream.line_to(x, y)
}

///|
pub fn Page::cubic_to(
  self : Page,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
) -> Unit {
  self.stream.cubic_to(x1, y1, x2, y2, x3, y3)
}

///|
pub fn Page::rect(self : Page, x : Double, y : Double, w : Double, h : Double) -> Unit {
  self.stream.rect(x, y, w, h)
}

///|
pub fn Page::close_path(self : Page) -> Unit {
  self.stream.close_path()
}

///|
pub fn Page::stroke(self : Page) -> Unit {
  self.stream.stroke()
}

///|
pub fn Page::close_and_stroke(self : Page) -> Unit {
  self.stream.close_and_stroke()
}

///|
pub fn Page::fill(self : Page) -> Unit {
  self.stream.fill()
}

///|
pub fn Page::fill_even_odd(self : Page) -> Unit {
  self.stream.fill_even_odd()
}

///|
pub fn Page::fill_and_stroke(self : Page) -> Unit {
  self.stream.fill_and_stroke()
}

///|
pub fn Page::clip(self : Page) -> Unit {
  self.stream.clip()
}

///|
pub fn Page::clip_even_odd(self : Page) -> Unit {
  self.stream.clip_even_odd()
}

///|
pub fn Page::end_path(self : Page) -> Unit {
  self.stream.end_path()
}

///|
pub fn Page::text(
  self : Page,
  x : Double,
  y : Double,
  size : Double,
  font : StandardFont,
  s : String,
