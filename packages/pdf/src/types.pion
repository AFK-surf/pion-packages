///| Public types, errors, limits, standard fonts, and constants for `packages/pdf`.
///| Pure Pion ISO 32000-1 PDF 1.4 generator and structural validator.

///| ISO A4 width in PostScript points (210 mm = 595.28 pt).
pub let a4_width : Double = 595.28

///| ISO A4 height in PostScript points (297 mm = 841.89 pt).
pub let a4_height : Double = 841.89

///| US Letter width in PostScript points (8.5 in = 612 pt).
pub let letter_width : Double = 612.0

///| US Letter height in PostScript points (11 in = 792 pt).
pub let letter_height : Double = 792.0

///| Farview print CSS width at 96 DPI for A4.
pub let print_css_w : Double = 794.0

///| Farview print CSS height at 96 DPI for A4.
pub let print_css_h : Double = 1123.0

///| Error returned by PDF construction, compression, encoding, or validation.
pub enum PdfError {
  InvalidDimension(String)
  InvalidColor(String)
  InvalidImage(String)
  InvalidPage(String)
  InvalidFont(String)
  InvalidFilter(String)
  CompressionFailed(String)
  LimitExceeded(String)
  ValidationFailed(String)
}

///| Human-readable error message for `PdfError`.
pub fn pdf_error_message(err : PdfError) -> String {
  match err {
    InvalidDimension(msg) => "invalid dimension: " + msg
    InvalidColor(msg) => "invalid color: " + msg
    InvalidImage(msg) => "invalid image: " + msg
    InvalidPage(msg) => "invalid page: " + msg
    InvalidFont(msg) => "invalid font: " + msg
    InvalidFilter(msg) => "invalid filter: " + msg
    CompressionFailed(msg) => "compression failed: " + msg
    LimitExceeded(msg) => "limit exceeded: " + msg
    ValidationFailed(msg) => "validation failed: " + msg
  }
}

///|
pub fn PdfError::to_string(self : PdfError) -> String {
  pdf_error_message(self)
}

///| Resource limits to prevent OOM on oversized or adversarial documents.
pub val struct Limits {
  pub max_pages : Int
  pub max_objects : Int
  pub max_stream_bytes : Int
  pub max_document_bytes : Int
  pub max_image_pixels : Int
}

///| Default conservative limits (10k pages, 200k objects, 64 MiB stream, 256 MiB document, 100M px image).
pub fn Limits::default() -> Limits {
  Limits::{
    max_pages: 10000,
    max_objects: 200000,
    max_stream_bytes: 67108864,
    max_document_bytes: 268435456,
    max_image_pixels: 100000000,
  }
}

///| Stream compression filter selection.
pub enum Compression {
  Uncompressed
  Flate(Int)
  RunLength
}

///| Default `/FlateDecode` compression (zlib level 6).
pub fn flate_default() -> Compression {
  Compression::Flate(6)
}

///| Page dimensions in PostScript points (1 pt = 1/72 inch).
pub val struct PageSize {
  pub width : Double
  pub height : Double
}

///| Standard ISO A4 page size (595.28 x 841.89 pt).
pub fn PageSize::a4() -> PageSize {
  PageSize::{ width: a4_width, height: a4_height }
}

///| Standard US Letter page size (612.0 x 792.0 pt).
pub fn PageSize::letter() -> PageSize {
  PageSize::{ width: letter_width, height: letter_height }
}

///| Custom page size in PostScript points.
pub fn PageSize::custom(width : Double, height : Double) -> PageSize {
  PageSize::{ width: width, height: height }
}

///| ISO 32000-1 §9.6.2.2 PDF Standard 14 Type 1 fonts.
pub enum StandardFont {
  Helvetica
  HelveticaBold
  HelveticaOblique
  HelveticaBoldOblique
  TimesRoman
  TimesBold
  TimesItalic
  TimesBoldItalic
  Courier
  CourierBold
  CourierOblique
  CourierBoldOblique
  Symbol
  ZapfDingbats
}

///| Canonical PDF `/BaseFont` name for a standard 14 font.
pub fn standard_font_name(font : StandardFont) -> String {
  match font {
    Helvetica => "Helvetica"
    HelveticaBold => "Helvetica-Bold"
    HelveticaOblique => "Helvetica-Oblique"
    HelveticaBoldOblique => "Helvetica-BoldOblique"
    TimesRoman => "Times-Roman"
    TimesBold => "Times-Bold"
    TimesItalic => "Times-Italic"
    TimesBoldItalic => "Times-BoldItalic"
    Courier => "Courier"
    CourierBold => "Courier-Bold"
    CourierOblique => "Courier-Oblique"
    CourierBoldOblique => "Courier-BoldOblique"
    Symbol => "Symbol"
    ZapfDingbats => "ZapfDingbats"
  }
}

///| Stable 0..13 index for bitmask tracking.
pub fn standard_font_index(font : StandardFont) -> Int {
  match font {
    Helvetica => 0
    HelveticaBold => 1
    HelveticaOblique => 2
    HelveticaBoldOblique => 3
    TimesRoman => 4
    TimesBold => 5
    TimesItalic => 6
    TimesBoldItalic => 7
    Courier => 8
    CourierBold => 9
    CourierOblique => 10
    CourierBoldOblique => 11
    Symbol => 12
    ZapfDingbats => 13
  }
}

///| Resource dictionary key (`F1`..`F14`).
pub fn standard_font_key(font : StandardFont) -> String {
  "F" + (standard_font_index(font) + 1).to_string()
}

///| Look up a `StandardFont` by index `0..13`.
fn standard_font_from_index(idx : Int) -> StandardFont {
  match idx {
    0 => StandardFont::Helvetica
    1 => StandardFont::HelveticaBold
    2 => StandardFont::HelveticaOblique
    3 => StandardFont::HelveticaBoldOblique
    4 => StandardFont::TimesRoman
    5 => StandardFont::TimesBold
    6 => StandardFont::TimesItalic
    7 => StandardFont::TimesBoldItalic
    8 => StandardFont::Courier
    9 => StandardFont::CourierBold
    10 => StandardFont::CourierOblique
    11 => StandardFont::CourierBoldOblique
    12 => StandardFont::Symbol
    _ => StandardFont::ZapfDingbats
  }
}

///| Document metadata dictionary (`/Info`).
pub struct DocInfo {
  pub title : String
  pub author : String
  pub subject : String
  pub keywords : String
  pub creator : String
  pub producer : String
}

///| Empty document metadata.
pub fn DocInfo::empty() -> DocInfo {
  DocInfo::{
    title: "",
    author: "",
    subject: "",
    keywords: "",
    creator: "",
    producer: "",
  }
}

///| Handle to an image XObject registered in a `PdfDoc`.
pub val struct ImageId {
  pub index : Int
}

///| How alpha channel is encoded when adding an RGBA image.
pub enum AlphaMode {
  BlendWhite
  SoftMask
}

///| Summary returned by `validate_pdf` on a structurally valid PDF document.
pub struct ValidationReport {
  pub version : String
  pub object_count : Int
  pub page_count : Int
  pub stream_count : Int
  pub xref_offset : Int
}
