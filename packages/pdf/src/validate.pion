///| Strict ISO 32000-1 PDF 1.4 structural validator:
///| verifies header, `startxref`, `xref` 10-digit byte offsets, `N G obj` alignment,
///| exact stream `/Length` to `endstream`, `trailer`, `/Root` Catalog, and `/Pages` count.

fn pdf_match_ascii(buf : Bytes, pos : Int, lit : String) -> Bool {
  let pat = lit.to_bytes()
  let plen = pat.length()
  if pos < 0 || pos + plen > buf.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if buf[pos + i] != pat[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn pdf_is_ws(b : Int) -> Bool {
  b == 32 || b == 10 || b == 13 || b == 9 || b == 12 || b == 0
}

fn pdf_skip_ws(buf : Bytes, start : Int) -> Int {
  let n = buf.length()
  let mut i = start
  while i < n && pdf_is_ws(buf[i].to_int() & 0xFF) {
    i = i + 1
  }
  i
}

fn pdf_parse_uint(buf : Bytes, start : Int) -> (Int, Int) {
  let n = buf.length()
  let mut i = start
  if i >= n {
    return (-1, start)
  }
  let first = buf[i].to_int() & 0xFF
  if first < 48 || first > 57 {
    return (-1, start)
  }
  let mut acc : Int64 = 0L
  while i < n {
    let ch = buf[i].to_int() & 0xFF
    if ch < 48 || ch > 57 {
      break
    }
    acc = acc * 10L + (ch - 48).to_int64()
    if acc > 2147483647L {
      return (-1, start)
    }
    i = i + 1
  }
  (acc.to_int(), i)
}

fn pdf_find_ascii(buf : Bytes, start : Int, end : Int, lit : String) -> Int {
  let pat = lit.to_bytes()
  let plen = pat.length()
  if plen == 0 || start < 0 || end > buf.length() || start + plen > end {
    return -1
  }
  let limit = end - plen
  let first = pat[0]
  let mut i = start
  while i <= limit {
    if buf[i] == first {
      let mut ok = true
      let mut j = 1
      while j < plen {
        if buf[i + j] != pat[j] {
          ok = false
          break
        }
        j = j + 1
      }
      if ok {
        return i
      }
    }
    i = i + 1
  }
  -1
}

fn pdf_rfind_ascii(buf : Bytes, lit : String) -> Int {
  let pat = lit.to_bytes()
  let plen = pat.length()
  let n = buf.length()
  if plen == 0 || plen > n {
    return -1
  }
  let mut i = n - plen
  while i >= 0 {
    if pdf_match_ascii(buf, i, lit) {
      return i
    }
    i = i - 1
  }
  -1
}

///| Validate a PDF 1.4 byte buffer structurally, checking every xref byte offset and stream `/Length`.
pub fn validate_pdf(pdf : Bytes) -> Result[ValidationReport, PdfError] {
  let n = pdf.length()
  if n < 32 {
    return Err(PdfError::ValidationFailed("PDF too short"))
  }
  if !pdf_match_ascii(pdf, 0, "%PDF-1.") {
    return Err(PdfError::ValidationFailed("missing %PDF-1.x header"))
  }
  let minor = pdf[7].to_int() & 0xFF
  if minor < 48 || minor > 57 {
    return Err(PdfError::ValidationFailed("invalid PDF minor version digit"))
  }
  let version = "1." + (minor - 48).to_string()

  // Locate %%EOF and startxref
  let eof_pos = pdf_rfind_ascii(pdf, "%%EOF")
  if eof_pos < 0 {
    return Err(PdfError::ValidationFailed("missing %%EOF marker"))
  }
  // Only trailing whitespace allowed after %%EOF
  let after_eof = pdf_skip_ws(pdf, eof_pos + 5)
  if after_eof != n {
    return Err(PdfError::ValidationFailed("unexpected trailing bytes after %%EOF"))
  }

  let sx_pos = pdf_rfind_ascii(pdf, "startxref")
  if sx_pos < 0 || sx_pos > eof_pos {
    return Err(PdfError::ValidationFailed("missing startxref before %%EOF"))
  }
  let sx_num_start = pdf_skip_ws(pdf, sx_pos + 9)
  let (xref_off, sx_num_end) = pdf_parse_uint(pdf, sx_num_start)
  if xref_off <= 0 || xref_off >= sx_pos {
    return Err(PdfError::ValidationFailed("invalid startxref offset"))
  }
  if pdf_skip_ws(pdf, sx_num_end) != eof_pos {
    return Err(PdfError::ValidationFailed("unexpected tokens between startxref offset and %%EOF"))
  }

  // Parse xref header: "xref\n0 <size>\n"
  if !pdf_match_ascii(pdf, xref_off, "xref") {
    return Err(PdfError::ValidationFailed("startxref does not point to xref table"))
  }
  let mut pos = pdf_skip_ws(pdf, xref_off + 4)
  let (first_id, pos1) = pdf_parse_uint(pdf, pos)
  if first_id != 0 {
    return Err(PdfError::ValidationFailed("xref subsection must start at object 0"))
  }
  let pos2 = pdf_skip_ws(pdf, pos1)
  let (xref_count, pos3) = pdf_parse_uint(pdf, pos2)
  if xref_count < 2 {
    return Err(PdfError::ValidationFailed("xref table has fewer than 2 entries"))
  }
  pos = pdf_skip_ws(pdf, pos3)

  let offsets = FixedArray::make(xref_count, -1)
  let gens = FixedArray::make(xref_count, 0)
  let in_use = FixedArray::make(xref_count, false)

  let mut ei = 0
  while ei < xref_count {
    // Expect 10 digits + ' ' + 5 digits + ' ' + ('n'|'f') + line ending
    if pos + 19 > sx_pos {
      return Err(PdfError::ValidationFailed("truncated xref entry " + ei.to_string()))
    }
    let mut off_val : Int64 = 0L
    let mut d = 0
    while d < 10 {
      let ch = pdf[pos + d].to_int() & 0xFF
      if ch < 48 || ch > 57 {
        return Err(PdfError::ValidationFailed("non-digit in xref offset for obj " + ei.to_string()))
      }
      off_val = off_val * 10L + (ch - 48).to_int64()
      d = d + 1
    }
    if (pdf[pos + 10].to_int() & 0xFF) != 32 {
      return Err(PdfError::ValidationFailed("expected space after xref offset"))
    }
    let mut gen_val = 0
    let mut g = 0
    while g < 5 {
      let ch = pdf[pos + 11 + g].to_int() & 0xFF
      if ch < 48 || ch > 57 {
        return Err(PdfError::ValidationFailed("non-digit in xref generation"))
      }
      gen_val = gen_val * 10 + (ch - 48)
      g = g + 1
    }
    if (pdf[pos + 16].to_int() & 0xFF) != 32 {
      return Err(PdfError::ValidationFailed("expected space after xref generation"))
    }
    let flag = pdf[pos + 17].to_int() & 0xFF
    if flag == 110 {
      // 'n'
      in_use[ei] = true
    } else if flag == 102 {
      // 'f'
      in_use[ei] = false
    } else {
      return Err(PdfError::ValidationFailed("invalid xref flag byte"))
    }
    offsets[ei] = off_val.to_int()
    gens[ei] = gen_val
    // Advance past 2-byte EOL (" \n" or "\r\n" or "\n")
    pos = pos + 18
    while pos < sx_pos && ((pdf[pos].to_int() & 0xFF) == 32 || (pdf[pos].to_int() & 0xFF) == 13) {
      pos = pos + 1
    }
    if pos < sx_pos && (pdf[pos].to_int() & 0xFF) == 10 {
      pos = pos + 1
    }
    ei = ei + 1
  }

  if in_use[0] || gens[0] != 65535 {
    return Err(PdfError::ValidationFailed("xref entry 0 must be free with generation 65535"))
  }

  // Parse trailer
  let trailer_pos = pdf_skip_ws(pdf, pos)
  if !pdf_match_ascii(pdf, trailer_pos, "trailer") {
    return Err(PdfError::ValidationFailed("missing trailer after xref table"))
  }
  let size_key = pdf_find_ascii(pdf, trailer_pos, sx_pos, "/Size")
  if size_key < 0 {
    return Err(PdfError::ValidationFailed("trailer missing /Size"))
  }
  let (trailer_size, _) = pdf_parse_uint(pdf, pdf_skip_ws(pdf, size_key + 5))
  if trailer_size != xref_count {
    return Err(PdfError::ValidationFailed("trailer /Size does not match xref entry count"))
  }
  let root_key = pdf_find_ascii(pdf, trailer_pos, sx_pos, "/Root")
  if root_key < 0 {
    return Err(PdfError::ValidationFailed("trailer missing /Root"))
  }
  let (root_id, _) = pdf_parse_uint(pdf, pdf_skip_ws(pdf, root_key + 5))
  if root_id <= 0 || root_id >= xref_count || !in_use[root_id] {
    return Err(PdfError::ValidationFailed("trailer /Root points to invalid object"))
  }

  // Validate every in-use object at its exact xref byte offset
  let mut stream_count = 0
  let mut page_count = 0
  let mut pages_obj_id = -1
  let mut declared_pages_count = -1

  let mut obj_i = 1
  while obj_i < xref_count {
    if !in_use[obj_i] {
      obj_i = obj_i + 1
      continue
    }
    let off = offsets[obj_i]
    if off < 8 || off >= xref_off {
      return Err(PdfError::ValidationFailed("object " + obj_i.to_string() + " offset out of range"))
    }
    let expected_hdr = obj_i.to_string() + " " + gens[obj_i].to_string() + " obj"
    if !pdf_match_ascii(pdf, off, expected_hdr) {
      return Err(
        PdfError::ValidationFailed(
          "xref offset for obj " +
          obj_i.to_string() +
          " (" +
          off.to_string() +
          ") does not point to `" +
          expected_hdr +
          "`",
        ),
      )
    }
    let body_start = off + expected_hdr.length()
    if body_start >= xref_off || !pdf_is_ws(pdf[body_start].to_int() & 0xFF) {
      return Err(PdfError::ValidationFailed("missing whitespace after obj header"))
    }

    // Find dictionary end ">>" or "endobj"
    let dict_end = pdf_find_ascii(pdf, body_start, xref_off, ">>")
    let endobj_pos = pdf_find_ascii(pdf, body_start, xref_off, "endobj")
    if endobj_pos < 0 {
      return Err(PdfError::ValidationFailed("object " + obj_i.to_string() + " missing endobj"))
    }

    // Check if this object has a stream immediately after its dictionary
    let mut has_stream = false
    let mut dict_limit = endobj_pos
    if dict_end >= 0 && dict_end < endobj_pos {
      // Find matching last ">>" before "stream" or "endobj"
      let mut scan = body_start
      let mut depth = 0
      let mut last_close = -1
      while scan + 1 < xref_off {
        let c0 = pdf[scan].to_int() & 0xFF
        let c1 = pdf[scan + 1].to_int() & 0xFF
        if c0 == 40 {
          // Skip literal string (...) respecting escapes
          scan = scan + 1
          let mut pdepth = 1
          while scan < xref_off && pdepth > 0 {
            let sc = pdf[scan].to_int() & 0xFF
            if sc == 92 {
              scan = scan + 2
              continue
            } else if sc == 40 {
              pdepth = pdepth + 1
            } else if sc == 41 {
              pdepth = pdepth - 1
            }
            scan = scan + 1
          }
          continue
        }
        if c0 == 60 && c1 == 60 {
          depth = depth + 1
          scan = scan + 2
          continue
        }
        if c0 == 62 && c1 == 62 {
          depth = depth - 1
          scan = scan + 2
          if depth == 0 {
            last_close = scan
            break
          }
          continue
        }
        scan = scan + 1
      }
      if last_close > 0 {
        dict_limit = last_close
        let after_dict = pdf_skip_ws(pdf, last_close)
        if pdf_match_ascii(pdf, after_dict, "stream") {
          has_stream = true
          // Parse /Length from dictionary
          let len_key = pdf_find_ascii(pdf, body_start, last_close, "/Length")
          if len_key < 0 {
            return Err(
              PdfError::ValidationFailed("stream object " + obj_i.to_string() + " missing /Length"),
            )
          }
          let (slen, _) = pdf_parse_uint(pdf, pdf_skip_ws(pdf, len_key + 7))
          if slen < 0 {
            return Err(
              PdfError::ValidationFailed("stream object " + obj_i.to_string() + " invalid /Length"),
            )
          }
          // stream keyword must be followed by \n or \r\n
          let mut s_data_start = after_dict + 6
          if s_data_start < xref_off && (pdf[s_data_start].to_int() & 0xFF) == 13 {
            s_data_start = s_data_start + 1
          }
          if s_data_start >= xref_off || (pdf[s_data_start].to_int() & 0xFF) != 10 {
            return Err(
              PdfError::ValidationFailed(
                "stream keyword in obj " + obj_i.to_string() + " not followed by EOL",
              ),
            )
          }
          s_data_start = s_data_start + 1
          let s_data_end = s_data_start + slen
          if s_data_end > xref_off {
            return Err(
              PdfError::ValidationFailed(
                "stream /Length in obj " + obj_i.to_string() + " exceeds file bounds",
              ),
            )
          }
          let mut es_pos = s_data_end
          if es_pos < xref_off && (pdf[es_pos].to_int() & 0xFF) == 13 {
            es_pos = es_pos + 1
          }
          if es_pos < xref_off && (pdf[es_pos].to_int() & 0xFF) == 10 {
            es_pos = es_pos + 1
          }
          if !pdf_match_ascii(pdf, es_pos, "endstream") {
            return Err(
              PdfError::ValidationFailed(
                "stream /Length mismatch in obj " + obj_i.to_string() + ": expected endstream",
              ),
            )
          }
          let after_es = pdf_skip_ws(pdf, es_pos + 9)
          if !pdf_match_ascii(pdf, after_es, "endobj") {
            return Err(
              PdfError::ValidationFailed(
                "missing endobj after endstream in obj " + obj_i.to_string(),
              ),
            )
          }
          stream_count = stream_count + 1
        }
      }
    }

    // Check Catalog, Pages, Page objects (only on non-stream dictionary objects)
    if !has_stream {
      if obj_i == root_id {
        if pdf_find_ascii(pdf, body_start, dict_limit, "/Type /Catalog") < 0 {
          return Err(PdfError::ValidationFailed("/Root object is not /Type /Catalog"))
        }
        let pk = pdf_find_ascii(pdf, body_start, dict_limit, "/Pages")
        if pk < 0 {
          return Err(PdfError::ValidationFailed("/Catalog missing /Pages reference"))
        }
        let (pid, _) = pdf_parse_uint(pdf, pdf_skip_ws(pdf, pk + 6))
        pages_obj_id = pid
      }
      if pdf_find_ascii(pdf, body_start, dict_limit, "/Type /Pages") >= 0 {
        let ck = pdf_find_ascii(pdf, body_start, dict_limit, "/Count")
        if ck >= 0 {
          let (cnt, _) = pdf_parse_uint(pdf, pdf_skip_ws(pdf, ck + 6))
          declared_pages_count = cnt
        }
      } else if pdf_find_ascii(pdf, body_start, dict_limit, "/Type /Page") >= 0 {
        page_count = page_count + 1
      }
    }

    obj_i = obj_i + 1
  }

  if pages_obj_id <= 0 || pages_obj_id >= xref_count || !in_use[pages_obj_id] {
    return Err(PdfError::ValidationFailed("/Catalog /Pages reference invalid"))
  }
  if declared_pages_count != page_count {
    return Err(
      PdfError::ValidationFailed(
        "/Pages /Count (" +
        declared_pages_count.to_string() +
        ") does not match actual /Type /Page objects (" +
        page_count.to_string() +
        ")",
      ),
    )
  }

  Ok(
    ValidationReport::{
      version: version,
      object_count: xref_count,
      page_count: page_count,
      stream_count: stream_count,
      xref_offset: xref_off,
    },
  )
}
