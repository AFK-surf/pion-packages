///| Pion Native head-to-head benchmark for packages/mqtt.
///| Workloads:
///|   w1                        : 200,000 MQTT 5.0 PUBLISH (Properties + User Properties + QoS 1) encode + stream decode
///|   w2 <v5.bin> <v311.bin>    : 500,000 mixed MQTT 3.1.1 + 5.0 all 15 control packets streaming decode (137B chunks)
///|   w2_v5 <v5.bin>            : 500,000 MQTT 5.0 all 15 control packets streaming decode (137B chunks)
///|   w3                        : TopicTrie routing (10,000 wildcard subs x 100,000 IoT publishes)

import "mqtt"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_bytes(h0 : Int64, b : Bytes) -> Int64 {
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  hash_bytes(h0, s.to_bytes())
}

///|
fn bench_w1(world : World) -> Int {
  let topics : Array[String] = []
  let payloads : Array[Bytes] = []
  let resp_topics : Array[String] = []
  let mut k = 0
  while k < 16 {
    let z = k / 4
    let d = k % 4
    topics.push("iot/zone" + z.to_string() + "/dev" + d.to_string() + "/telemetry")
    resp_topics.push("iot/reply/zone" + z.to_string() + "/dev" + d.to_string())
    payloads.push(
      ("{\"zone\":" + z.to_string() + ",\"dev\":" + d.to_string() + ",\"temp\":24.75,\"hum\":58,\"status\":\"ok\"}").to_bytes(),
    )
    k = k + 1
  }

  let dec = mqtt::StreamDecoder::default(mqtt::ProtocolVersion::V5)
  let mut total_wire : Int64 = 0L
  let mut total_payload : Int64 = 0L
  let mut total_uprops : Int64 = 0L
  let mut checksum : Int64 = 0L
  let mut i = 0
  while i < 200000 {
    let idx = i & 15
    let pid = (i % 65000) + 1
    let props = mqtt::Properties::empty()
    props.message_expiry_interval = Some(300U)
    props.content_type = Some("application/json")
    props.response_topic = Some(resp_topics[idx])
    props.user_properties.push(("region", "ap-northeast-1"))
    props.user_properties.push(("tier", "edge"))
    let pkt = mqtt::Packet::Publish(mqtt::PublishPacket::{
      dup: false,
      qos: mqtt::QoS::AtLeastOnce,
      retain: false,
      topic: topics[idx],
      packet_id: Some(pid),
      properties: props,
      payload: payloads[idx],
    })
    let wire = match mqtt::encode_packet(pkt, mqtt::ProtocolVersion::V5) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "w1 encode error: " + mqtt::mqtt_error_string(e))
        return 1
      }
    }
    total_wire = total_wire + wire.length().to_int64()
    dec.feed(wire)
    match dec.next_packet() {
      Ok(Some(mqtt::Packet::Publish(d))) => {
        let dpid = match d.packet_id {
          Some(x) => x
          None => 0
        }
        total_payload = total_payload + d.payload.length().to_int64()
        total_uprops = total_uprops + d.properties.user_properties.length().to_int64()
        checksum = mix(checksum, dpid.to_int64())
        checksum = mix(checksum, d.topic.length().to_int64())
        checksum = mix(checksum, d.payload.length().to_int64())
      }
      _ => {
        io_println(world, "w1 decode error")
        return 1
      }
    }
    i = i + 1
  }
  io_println(world, "mode=w1")
  io_println(world, "packets=200000")
  io_println(world, "wire_bytes=" + total_wire.to_string())
  io_println(world, "payload_bytes=" + total_payload.to_string())
  io_println(world, "user_props=" + total_uprops.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn digest_packet(h0 : Int64, pkt : mqtt::Packet) -> Int64 {
  match pkt {
    mqtt::Packet::Connect(c) => mix(mix(h0, 1L), c.client_id.length().to_int64())
    mqtt::Packet::ConnAck(ca) => mix(mix(h0, 2L), ca.reason_code.to_int64())
    mqtt::Packet::Publish(p) => {
      let pid = match p.packet_id {
        Some(x) => x
        None => 0
      }
      mix(mix(mix(h0, 3L), pid.to_int64()), p.payload.length().to_int64())
    }
    mqtt::Packet::PubAck(a) => mix(mix(h0, 4L), a.packet_id.to_int64())
    mqtt::Packet::PubRec(a) => mix(mix(h0, 5L), a.packet_id.to_int64())
    mqtt::Packet::PubRel(a) => mix(mix(h0, 6L), a.packet_id.to_int64())
    mqtt::Packet::PubComp(a) => mix(mix(h0, 7L), a.packet_id.to_int64())
    mqtt::Packet::Subscribe(s) => mix(mix(h0, 8L), s.packet_id.to_int64())
    mqtt::Packet::SubAck(sa) => mix(mix(h0, 9L), sa.packet_id.to_int64())
    mqtt::Packet::Unsubscribe(u) => mix(mix(h0, 10L), u.packet_id.to_int64())
    mqtt::Packet::UnsubAck(ua) => mix(mix(h0, 11L), ua.packet_id.to_int64())
    mqtt::Packet::PingReq => mix(h0, 12L)
    mqtt::Packet::PingResp => mix(h0, 13L)
    mqtt::Packet::Disconnect(d) => mix(mix(h0, 14L), d.reason_code.to_int64())
    mqtt::Packet::Auth(a) => mix(mix(h0, 15L), a.reason_code.to_int64())
  }
}

///|
fn stream_parse_rounds(
  data : Bytes,
  ver : mqtt::ProtocolVersion,
  rounds : Int,
) -> Result[(Int64, Int64), mqtt::MqttError] {
  let dec = mqtt::StreamDecoder::default(ver)
  let mut count : Int64 = 0L
  let mut checksum : Int64 = 0L
  let n = data.length()
  let mut r = 0
  while r < rounds {
    let mut pos = 0
    while pos < n {
      let end = if pos + 137 < n { pos + 137 } else { n }
      dec.feed(data.slice(pos, end))
      while true {
        match dec.next_packet() {
          Ok(Some(pkt)) => {
            count = count + 1L
            checksum = digest_packet(checksum, pkt)
          }
          Ok(None) => break
          Err(e) => return Err(e)
        }
      }
      pos = end
    }
    r = r + 1
  }
  Ok((count, checksum))
}

///|
fn bench_w2(world : World, v5_data : Bytes, v311_data : Bytes) -> Int {
  let (c5, h5) = match stream_parse_rounds(v5_data, mqtt::ProtocolVersion::V5, 500) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "w2 v5 error: " + mqtt::mqtt_error_string(e))
      return 1
    }
  }
  let (c4, h4) = match stream_parse_rounds(v311_data, mqtt::ProtocolVersion::V311, 500) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "w2 v4 error: " + mqtt::mqtt_error_string(e))
      return 1
    }
  }
  io_println(world, "mode=w2")
  io_println(world, "packets=" + (c5 + c4).to_string())
  io_println(world, "checksum=" + mix(h5, h4).to_string())
  0
}

///|
fn bench_w2_v5(world : World, v5_data : Bytes) -> Int {
  let (c5, h5) = match stream_parse_rounds(v5_data, mqtt::ProtocolVersion::V5, 1000) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "w2_v5 error: " + mqtt::mqtt_error_string(e))
      return 1
    }
  }
  io_println(world, "mode=w2_v5")
  io_println(world, "packets=" + c5.to_string())
  io_println(world, "checksum=" + h5.to_string())
  0
}

///|
fn bench_w3(world : World) -> Int {
  let trie : mqtt::TopicTrie[Int] = mqtt::TopicTrie::new()
  // Insert 10,000 realistic IoT wildcard + exact + $SYS subscriptions
  let mut i = 0
  while i < 10000 {
    let kind = i % 10
    let sub = if kind == 0 {
      "factory/site" + (i % 50).to_string() + "/+/telemetry"
    } else if kind == 1 {
      "factory/site" + (i % 50).to_string() + "/line" + (i % 20).to_string() + "/#"
    } else if kind == 2 {
      "iot/+/sensor" + (i % 200).to_string() + "/temp"
    } else if kind == 3 {
      "fleet/region" + (i % 10).to_string() + "/+/+/gps"
    } else if kind == 4 {
      "$SYS/broker/node" + (i % 25).to_string() + "/#"
    } else {
      "iot/site" + (i % 100).to_string() + "/dev" + (i % 500).to_string() + "/metric"
    }
    match trie.insert_with_key(sub, i, i + 1) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "w3 insert error: " + mqtt::mqtt_error_string(e))
        return 1
      }
    }
    i = i + 1
  }

  // Pre-generate 1,000 realistic IoT topics (including $SYS), route 100 rounds = 100,000 publishes
  let topics : Array[String] = []
  let mut t = 0
  while t < 1000 {
    let k = t % 10
    let topic = if k == 0 || k == 1 {
      "factory/site" + (t % 50).to_string() + "/line" + (t % 20).to_string() + "/telemetry"
    } else if k == 2 {
      "iot/zone" + (t % 10).to_string() + "/sensor" + (t % 200).to_string() + "/temp"
    } else if k == 3 {
      "fleet/region" + (t % 10).to_string() + "/city" + (t % 8).to_string() + "/truck" + (t % 30).to_string() + "/gps"
    } else if k == 4 {
      "$SYS/broker/node" + (t % 25).to_string() + "/load/1m"
    } else {
      "iot/site" + (t % 100).to_string() + "/dev" + (t % 500).to_string() + "/metric"
    }
    topics.push(topic)
    t = t + 1
  }

  let mut total_matches : Int64 = 0L
  let mut id_sum : Int64 = 0L
  let mut r = 0
  while r < 100 {
    let mut j = 0
    while j < 1000 {
      let hits = trie.match_topic(topics[j])
      total_matches = total_matches + hits.length().to_int64()
      let mut h = 0
      while h < hits.length() {
        id_sum = (id_sum + hits[h].to_int64()) % 1000000007L
        h = h + 1
      }
      j = j + 1
    }
    r = r + 1
  }

  io_println(world, "mode=w3")
  io_println(world, "subs=" + trie.len().to_string())
  io_println(world, "publishes=100000")
  io_println(world, "matches=" + total_matches.to_string())
  io_println(world, "id_sum=" + id_sum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: mqtt_bench <w1|w2|w2_v5|w3> [args...]")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    bench_w1(world)
  } else if mode == "w2" {
    if args.length() < 4 {
      io_println(world, "usage: mqtt_bench w2 <v5.bin> <v311.bin>")
      return 1
    }
    let v5 = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let v4 = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 1
    }
    bench_w2(world, v5, v4)
  } else if mode == "w2_v5" {
    if args.length() < 3 {
      io_println(world, "usage: mqtt_bench w2_v5 <v5.bin>")
      return 1
    }
    let v5 = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 1
    }
    bench_w2_v5(world, v5)
  } else if mode == "w3" {
    bench_w3(world)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
