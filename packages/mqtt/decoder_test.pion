///| Streaming incremental decoder tests: 1-byte drip, 3-byte fragmented sticky streams,
///| max_packet_size enforcement, and buffer compaction.

///|
fn concat_bytes(parts : Array[Bytes]) -> Bytes {
  let mut total = 0
  let mut i = 0
  while i < parts.length() {
    total = total + parts[i].length()
    i = i + 1
  }
  let mut out = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      out[pos] = p[j]
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  out
}

///|
test "stream_decoder_1byte_drip_mixed_v5_packets" {
  let p1 = match encode_packet(Packet::Connect(ConnectPacket::new(ProtocolVersion::V5, "drip-1")), ProtocolVersion::V5) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let pub_props = Properties::empty()
  pub_props.user_properties.push(("chunk", "1byte"))
  let p2 = match encode_packet(
    Packet::Publish(PublishPacket::{
      dup: false,
      qos: QoS::AtLeastOnce,
      retain: false,
      topic: "stream/drip",
      packet_id: Some(7),
      properties: pub_props,
      payload: "hello fragmented world".to_bytes(),
    }),
    ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let p3 = match encode_packet(Packet::PingReq, ProtocolVersion::V5) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let p4 = match encode_packet(
    Packet::Disconnect(DisconnectPacket::{ reason_code: 0, properties: Properties::empty() }),
    ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let stream = concat_bytes([p1, p2, p3, p4])
  let dec = StreamDecoder::default(ProtocolVersion::V5)
  let decoded : Array[Packet] = []
  let mut i = 0
  while i < stream.length() {
    let mut one = Bytes::new(1)
    one[0] = stream[i]
    dec.feed(one)
    match dec.drain() {
      Ok(pkts) => {
        let mut j = 0
        while j < pkts.length() {
          decoded.push(pkts[j])
          j = j + 1
        }
      }
      Err(e) => debug_assert(false, "1B drip failed: " + mqtt_error_string(e))
    }
    i = i + 1
  }
  debug_assert(decoded.length() == 4, "expected 4 packets from 1B drip")
  debug_assert(dec.buffered_len() == 0, "decoder buffer must be empty after drain")
}

///|
test "stream_decoder_3byte_chunks_and_sticky_packets" {
  let parts : Array[Bytes] = []
  let mut i = 0
  while i < 20 {
    let pkt = Packet::Publish(PublishPacket::new(
      "iot/dev/" + i.to_string(),
      ("payload-" + i.to_string()).to_bytes(),
      QoS::AtMostOnce,
      false,
      None,
    ))
    match encode_packet(pkt, ProtocolVersion::V311) {
      Ok(b) => parts.push(b)
      Err(_) => debug_assert(false, "encode failed")
    }
    i = i + 1
  }
  let stream = concat_bytes(parts)
  let dec = StreamDecoder::default(ProtocolVersion::V311)
  let mut count = 0
  let mut pos = 0
  while pos < stream.length() {
    let end = if pos + 3 < stream.length() { pos + 3 } else { stream.length() }
    dec.feed(stream.slice(pos, end))
    match dec.drain() {
      Ok(pkts) => count = count + pkts.length()
      Err(e) => debug_assert(false, "3B chunk failed: " + mqtt_error_string(e))
    }
    pos = end
  }
  debug_assert(count == 20, "expected 20 packets from 3B chunks")
  debug_assert(dec.buffered_len() == 0, "buffer empty")
}

///|
test "stream_decoder_max_packet_size_enforced" {
  let limits = MqttLimits::new(32, 65535, 64, 64, 64)
  let dec = StreamDecoder::new(ProtocolVersion::V5, limits)
  let big = match encode_packet(
    Packet::Publish(PublishPacket::new(
      "big/topic",
      "0123456789012345678901234567890123456789".to_bytes(),
      QoS::AtMostOnce,
      false,
      None,
    )),
    ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  dec.feed(big)
  match dec.next_packet() {
    Err(MqttError::PacketTooLarge(_, 32)) => ()
    _ => debug_assert(false, "oversized packet must be rejected by StreamDecoder")
  }
}

///|
test "stream_decoder_copies_caller_buffer_safely" {
  let wire = match encode_packet(
    Packet::Publish(PublishPacket::new("safe/topic", "payload".to_bytes(), QoS::AtMostOnce, false, None)),
    ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let head = wire.slice(0, 8)
  let tail = wire.slice(8, wire.length())
  let dec = StreamDecoder::default(ProtocolVersion::V5)
  dec.feed(head)
  debug_assert(dec.next_packet() is Ok(None), "partial")
  // Mutate caller's read buffer in place before feeding remainder
  head[4] = 0x58.to_byte()
  head[5] = 0x59.to_byte()
  dec.feed(tail)
  match dec.next_packet() {
    Ok(Some(Packet::Publish(p))) =>
    debug_assert(p.topic == "safe/topic", "topic must not be corrupted by caller buffer reuse")
    _ => debug_assert(false, "expected Publish")
  }
}

test "c1_migrated_mqtt_constants" {
  let lim = MqttLimits::default()
  debug_assert(lim.max_packet_size > 0 && lim.max_topic_len > 0, "MqttLimits::default positive")
  let qoss = [QoS::AtMostOnce, QoS::AtLeastOnce, QoS::ExactlyOnce]
  for i = 0; i < qoss.length(); i = i + 1 {
    debug_assert(qos_to_int(qoss[i]) == i, "qos_to_int")
    match qos_from_int_opt(i) {
      Some(q) => debug_assert(qos_to_int(q) == i, "qos roundtrip")
      None => debug_assert(false, "expected Some")
    }
  }
  for c = 1; c <= 15; c = c + 1 {
    match packet_type_from_int_opt(c) {
      Some(pt) => debug_assert(packet_type_to_int(pt) == c, "packet_type roundtrip")
      None => debug_assert(false, "expected Some")
    }
  }
}
