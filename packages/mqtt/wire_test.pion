///| OASIS MQTT 3.1.1 & 5.0 wire-level compliance tests:
///| VBI (1..4 bytes, overlong/non-canonical rejection), UTF-8 & forbidden code points,
///| and fixed header reserved flag validation for all 15 control packet types.

///|
fn bytes_from_ints(xs : Array[Int]) -> Bytes {
  let n = xs.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = xs[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  let n = a.length()
  while i < n {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "vbi_oasis_boundary_vectors_roundtrip" {
  // OASIS MQTT 5.0 §1.5.5 Table 1-1 Variable Byte Integer boundary values
  let cases : Array[(Int, Array[Int])] = [
    (0, [0x00]),
    (127, [0x7F]),
    (128, [0x80, 0x01]),
    (16383, [0xFF, 0x7F]),
    (16384, [0x80, 0x80, 0x01]),
    (2097151, [0xFF, 0xFF, 0x7F]),
    (2097152, [0x80, 0x80, 0x80, 0x01]),
    (268435455, [0xFF, 0xFF, 0xFF, 0x7F]),
  ]
  let mut i = 0
  while i < cases.length() {
    let (v, expected_arr) = cases[i]
    let expected = bytes_from_ints(expected_arr)
    debug_assert(vbi_encoded_len(v) == expected.length(), "vbi len mismatch")
    match encode_vbi(v) {
      Ok(enc) => debug_assert(bytes_equal(enc, expected), "vbi encode mismatch")
      Err(_) => debug_assert(false, "vbi encode failed")
    }
    match decode_vbi(expected, 0) {
      Ok((dec, used)) => {
        debug_assert(dec == v, "vbi decode value mismatch")
        debug_assert(used == expected.length(), "vbi decode used mismatch")
      }
      Err(_) => debug_assert(false, "vbi decode failed")
    }
    i = i + 1
  }
}

///|
test "vbi_reject_out_of_range_and_malformed_and_non_canonical" {
  // Encode out of range
  match encode_vbi(-1) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "negative VBI must fail")
  }
  match encode_vbi(268435456) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "VBI > 268435455 must fail")
  }
  // 5-byte malformed VBI (continuation bit set on 4th byte)
  match decode_vbi(bytes_from_ints([0xFF, 0xFF, 0xFF, 0x80, 0x01]), 0) {
    Err(MqttError::MalformedVbi) => ()
    _ => debug_assert(false, "5-byte VBI must return MalformedVbi")
  }
  // Non-canonical / overlong encodings (OASIS MQTT 5.0 §1.5.5 minimum byte rule)
  let non_canonical : Array[Array[Int]] = [
    [0x80, 0x00],
    [0x81, 0x00],
    [0x80, 0x80, 0x00],
    [0x80, 0x80, 0x80, 0x00],
  ]
  let mut i = 0
  while i < non_canonical.length() {
    match decode_vbi(bytes_from_ints(non_canonical[i]), 0) {
      Err(MqttError::NonCanonicalVbi) => ()
      _ => debug_assert(false, "overlong VBI must return NonCanonicalVbi")
    }
    i = i + 1
  }
  // Truncated VBI
  match decode_vbi(bytes_from_ints([0x80]), 0) {
    Err(MqttError::Incomplete) => ()
    _ => debug_assert(false, "truncated VBI must return Incomplete")
  }
  match decode_vbi(bytes_from_ints([]), 0) {
    Err(MqttError::Incomplete) => ()
    _ => debug_assert(false, "empty VBI must return Incomplete")
  }
}

///|
test "utf8_valid_and_mqtt_forbidden_codepoints" {
  // Valid ASCII, multi-byte UTF-8, emoji, and BOM (U+FEFF is allowed by MQTT spec)
  match validate_mqtt_utf8("sensors/tokyo/temp-01") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "valid ASCII should pass")
  }
  match validate_mqtt_utf8("传感器/温度/🌡️") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "valid UTF-8 CJK+emoji should pass")
  }
  // U+FEFF BOM: EF BB BF
  match validate_mqtt_utf8_range(bytes_from_ints([0xEF, 0xBB, 0xBF, 0x41]), 0, 4) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "U+FEFF BOM is permitted in MQTT")
  }
  // Forbidden U+0000 (NUL)
  match validate_mqtt_utf8_range(bytes_from_ints([0x61, 0x00, 0x62]), 0, 3) {
    Err(MqttError::ForbiddenCodePoint(0)) => ()
    _ => debug_assert(false, "U+0000 must be rejected")
  }
  // Forbidden U+0001..U+001F (C0 controls)
  let c0_cases : Array[Int] = [0x01, 0x07, 0x0A, 0x0D, 0x1F]
  let mut i = 0
  while i < c0_cases.length() {
    let cp = c0_cases[i]
    match validate_mqtt_utf8_range(bytes_from_ints([cp]), 0, 1) {
      Err(MqttError::ForbiddenCodePoint(c)) => debug_assert(c == cp, "C0 codepoint")
      _ => debug_assert(false, "C0 control must be rejected")
    }
    i = i + 1
  }
  // Forbidden U+007F (DEL)
  match validate_mqtt_utf8_range(bytes_from_ints([0x7F]), 0, 1) {
    Err(MqttError::ForbiddenCodePoint(0x7F)) => ()
    _ => debug_assert(false, "U+007F must be rejected")
  }
  // Forbidden U+0080..U+009F (C1 controls: C2 80 .. C2 9F)
  match validate_mqtt_utf8_range(bytes_from_ints([0xC2, 0x80]), 0, 2) {
    Err(MqttError::ForbiddenCodePoint(0x80)) => ()
    _ => debug_assert(false, "U+0080 must be rejected")
  }
  match validate_mqtt_utf8_range(bytes_from_ints([0xC2, 0x9F]), 0, 2) {
    Err(MqttError::ForbiddenCodePoint(0x9F)) => ()
    _ => debug_assert(false, "U+009F must be rejected")
  }
  // U+00A0 (NBSP: C2 A0) is allowed
  match validate_mqtt_utf8_range(bytes_from_ints([0xC2, 0xA0]), 0, 2) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "U+00A0 should be allowed")
  }
  // Forbidden UTF-16 surrogates U+D800 (ED A0 80) and U+DFFF (ED BF BF)
  match validate_mqtt_utf8_range(bytes_from_ints([0xED, 0xA0, 0x80]), 0, 3) {
    Err(MqttError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "UTF-16 surrogate U+D800 must be rejected")
  }
  match validate_mqtt_utf8_range(bytes_from_ints([0xED, 0xBF, 0xBF]), 0, 3) {
    Err(MqttError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "UTF-16 surrogate U+DFFF must be rejected")
  }
  // Overlong UTF-8 and > U+10FFFF
  match validate_mqtt_utf8_range(bytes_from_ints([0xC0, 0xAF]), 0, 2) {
    Err(MqttError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "overlong UTF-8 must be rejected")
  }
  match validate_mqtt_utf8_range(bytes_from_ints([0xF4, 0x90, 0x80, 0x80]), 0, 4) {
    Err(MqttError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, ">U+10FFFF must be rejected")
  }
}

///|
test "fixed_header_reserved_flags_all_15_packet_types" {
  // Exact OASIS Table 2-2 flags for non-PUBLISH packet types
  let expected_flags : Array[(Int, Int)] = [
    (1, 0x00), // CONNECT
    (2, 0x00), // CONNACK
    (4, 0x00), // PUBACK
    (5, 0x00), // PUBREC
    (6, 0x02), // PUBREL
    (7, 0x00), // PUBCOMP
    (8, 0x02), // SUBSCRIBE
    (9, 0x00), // SUBACK
    (10, 0x02), // UNSUBSCRIBE
    (11, 0x00), // UNSUBACK
    (12, 0x00), // PINGREQ
    (13, 0x00), // PINGRESP
    (14, 0x00), // DISCONNECT
    (15, 0x00), // AUTH
  ]
  let mut i = 0
  while i < expected_flags.length() {
    let (pt, req) = expected_flags[i]
    let mut f = 0
    while f < 16 {
      match validate_fixed_header_flags(pt, f) {
        Ok(_) => debug_assert(f == req, "unexpectedly accepted reserved flag")
        Err(_) => debug_assert(f != req, "rejected valid fixed header flag")
      }
      f = f + 1
    }
    i = i + 1
  }
  // PUBLISH (3): QoS 0..2 valid, QoS 3 invalid, QoS=0 & DUP=1 invalid
  let mut f = 0
  while f < 16 {
    let dup = (f & 0x08) != 0
    let qos = (f >> 1) & 0x03
    let should_ok = qos <= 2 && !(qos == 0 && dup)
    match validate_fixed_header_flags(3, f) {
      Ok(_) => debug_assert(should_ok, "PUBLISH accepted invalid flag combo")
      Err(_) => debug_assert(!should_ok, "PUBLISH rejected valid flag combo")
    }
    f = f + 1
  }
  // Packet type 0 is reserved and invalid
  match validate_fixed_header_flags(0, 0) {
    Err(MqttError::InvalidPacketType(0)) => ()
    _ => debug_assert(false, "packet type 0 must be rejected")
  }
}
