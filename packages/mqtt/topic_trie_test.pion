///| OASIS MQTT 3.1.1 & 5.0 Topic Name, Topic Filter, Shared Subscription, `$SYS` rules,
///| and `TopicTrie[T]` router tests.

///|
test "topic_name_and_filter_validation" {
  // Valid topic names
  match validate_topic_name("a") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "a valid")
  }
  match validate_topic_name("sport/tennis/player1/") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "trailing slash valid")
  }
  match validate_topic_name("$SYS/broker/clients/connected") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "$SYS valid topic name")
  }
  // Invalid topic names
  let bad_names : Array[String] = ["", "+", "#", "a/+/b", "a/#", "a+b", "a#b"]
  let mut i = 0
  while i < bad_names.length() {
    match validate_topic_name(bad_names[i]) {
      Err(MqttError::InvalidTopicName(_)) => ()
      _ => debug_assert(false, "bad topic name must be rejected: " + bad_names[i])
    }
    i = i + 1
  }

  // Valid topic filters
  let good_filters : Array[String] = [
    "#",
    "+",
    "+/+",
    "/+",
    "/#",
    "sport/tennis/#",
    "sport/tennis/+",
    "sport/+/player1",
    "$SYS/#",
    "$SYS/monitor/+",
    "$share/group1/a/+/b",
  ]
  i = 0
  while i < good_filters.length() {
    match validate_topic_filter(good_filters[i]) {
      Ok(_) => ()
      Err(_) => debug_assert(false, "valid filter rejected: " + good_filters[i])
    }
    i = i + 1
  }

  // Invalid topic filters
  let bad_filters : Array[String] = [
    "",
    "sport/tennis#",
    "sport/tennis/#/ranking",
    "sport+",
    "+sport",
    "a/b+c/d",
    "##",
  ]
  i = 0
  while i < bad_filters.length() {
    match validate_topic_filter(bad_filters[i]) {
      Err(MqttError::InvalidTopicFilter(_)) => ()
      _ => debug_assert(false, "invalid filter accepted: " + bad_filters[i])
    }
    i = i + 1
  }
}

///|
test "shared_subscription_parsing" {
  match parse_shared_subscription("$share/consumer1/iot/+/temp") {
    Ok(Some(s)) => {
      debug_assert(s.share_name == "consumer1", "share_name")
      debug_assert(s.filter == "iot/+/temp", "inner filter")
    }
    _ => debug_assert(false, "valid shared sub should parse")
  }
  match parse_shared_subscription("normal/topic/+") {
    Ok(None) => ()
    _ => debug_assert(false, "normal filter should return None")
  }
  let bad_shared : Array[String] = [
    "$share/",
    "$share//a/b",
    "$share/g/",
    "$share/g",
    "$share/g+1/a",
    "$share/g#1/a",
    "$share/g/a/#/b",
  ]
  let mut i = 0
  while i < bad_shared.length() {
    match parse_shared_subscription(bad_shared[i]) {
      Err(MqttError::InvalidSharedSubscription(_)) => ()
      Err(MqttError::InvalidTopicFilter(_)) => ()
      _ => debug_assert(false, "bad shared sub must fail: " + bad_shared[i])
    }
    i = i + 1
  }
}

///|
test "oasis_topic_matching_and_dollar_sys_rules" {
  // OASIS §4.7.1.2 Multi-level wildcard `#`
  debug_assert(topic_matches("sport/tennis/player1/#", "sport/tennis/player1"), "# matches parent")
  debug_assert(topic_matches("sport/tennis/player1/#", "sport/tennis/player1/"), "# matches trailing slash")
  debug_assert(topic_matches("sport/tennis/player1/#", "sport/tennis/player1/ranking"), "# matches child")
  debug_assert(topic_matches("sport/tennis/player1/#", "sport/tennis/player1/score/wimbledon"), "# matches deep")
  debug_assert(!topic_matches("sport/tennis/player1/#", "sport/tennis/player2"), "# rejects sibling")

  // OASIS §4.7.1.3 Single-level wildcard `+`
  debug_assert(topic_matches("sport/tennis/+", "sport/tennis/player1"), "+ matches level")
  debug_assert(topic_matches("sport/tennis/+", "sport/tennis/"), "+ matches empty level")
  debug_assert(!topic_matches("sport/tennis/+", "sport/tennis"), "+ does not match parent")
  debug_assert(!topic_matches("sport/tennis/+", "sport/tennis/player1/ranking"), "+ does not match deep")
  debug_assert(topic_matches("+/+", "/finance"), "+/+ matches /finance")
  debug_assert(topic_matches("/+", "/finance"), "/+ matches /finance")
  debug_assert(!topic_matches("+", "/finance"), "+ does not match /finance")

  // OASIS §4.7.2 Topics beginning with `$`
  debug_assert(!topic_matches("#", "$SYS/broker/load"), "# MUST NOT match $SYS")
  debug_assert(!topic_matches("+/monitor/Clients", "$SYS/monitor/Clients"), "+/ MUST NOT match $SYS")
  debug_assert(!topic_matches("+", "$SYS"), "+ MUST NOT match $SYS")
  debug_assert(topic_matches("$SYS/#", "$SYS/broker/load"), "$SYS/# matches $SYS")
  debug_assert(topic_matches("$SYS/monitor/+", "$SYS/monitor/Clients"), "$SYS/monitor/+ matches $SYS")
}

///|
test "topic_trie_routing_dedup_remove_and_dollar_rules" {
  let trie : TopicTrie[Int] = TopicTrie::new()
  debug_assert(trie.insert_with_key("sensors/+/temp", 1, 100) is Ok(_), "insert 1")
  debug_assert(trie.insert_with_key("sensors/room1/#", 1, 100) is Ok(_), "insert 2 same key")
  debug_assert(trie.insert_with_key("#", 2, 200) is Ok(_), "insert #")
  debug_assert(trie.insert_with_key("$SYS/#", 3, 300) is Ok(_), "insert $SYS/#")
  debug_assert(trie.insert_with_key("+/broker/load", 4, 400) is Ok(_), "insert +/broker/load")
  debug_assert(trie.len() == 5, "trie len 5")

  // Dedup: key 1 matches via both sensors/+/temp and sensors/room1/#, returned once; key 2 via #
  let m1 = trie.match_topic("sensors/room1/temp")
  debug_assert(m1.length() == 2, "deduped matches should be 2")

  // $SYS isolation: only key 3 ($SYS/#), NOT # (key 2) or +/broker/load (key 4)
  let m_sys = trie.match_topic("$SYS/broker/load")
  debug_assert(m_sys.length() == 1 && m_sys[0] == 300, "$SYS must only match $SYS/#")

  // Removal
  debug_assert(trie.remove("sensors/+/temp", 1), "remove existing")
  debug_assert(!trie.remove("sensors/+/temp", 1), "remove already removed")
  debug_assert(trie.len() == 4, "trie len after remove")
  let m2 = trie.match_topic("sensors/room2/temp")
  debug_assert(m2.length() == 1 && m2[0] == 200, "only # matches room2 now")
}

///|
test "topic_trie_shared_isolation_and_slot_recycling" {
  let trie : TopicTrie[String] = TopicTrie::new()
  debug_assert(trie.insert_with_key("$share/g1/a/b", 1, "s1") is Ok(_), "insert shared g1")
  debug_assert(trie.insert_with_key("$share/g2/a/b", 1, "s2") is Ok(_), "insert shared g2")
  debug_assert(trie.insert_with_key("a/b", 2, "plain") is Ok(_), "insert plain")
  debug_assert(!trie.remove("a/b", 1), "plain remove must not delete shared sub")
  debug_assert(trie.remove("$share/g1/a/b", 1), "shared g1 remove")
  debug_assert(!trie.remove("$share/g1/a/b", 1), "shared g1 already removed")
  debug_assert(trie.remove("$share/g2/a/b", 1), "shared g2 remove")
  debug_assert(trie.len() == 1, "only plain remains")
  // Partial churn with live anchor tests free-list recycling without full clear
  let mut i = 0
  while i < 2000 {
    let f = "ephemeral/d" + (i % 64).to_string() + "/+"
    debug_assert(trie.insert_with_key(f, 100 + i % 64, "tmp") is Ok(_), "churn insert")
    debug_assert(trie.remove(f, 100 + i % 64), "churn remove")
    i = i + 1
  }
  debug_assert(trie.len() == 1, "live anchor preserved")
  debug_assert(trie.nodes.length() < 32, "node slots recycled")
  debug_assert(trie.entry_keys.length() < 16, "entry slots recycled")
  debug_assert(trie.remove("a/b", 2), "remove anchor")
  debug_assert(trie.len() == 0, "empty")
}
