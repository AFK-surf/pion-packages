///| OASIS MQTT 3.1.1 & 5.0 Control Packets (all 15 packet types) and wire codec.

///|
pub struct Will {
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub payload : Bytes
  pub properties : Properties
}

///|
pub fn Will::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
) -> Will {
  Will::{
    qos: qos,
    retain: retain,
    topic: topic,
    payload: payload,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnectPacket {
  pub protocol_version : ProtocolVersion
  pub client_id : String
  pub clean_start : Bool
  pub keep_alive : Int
  pub username : Option[String]
  pub password : Option[Bytes]
  pub will : Option[Will]
  pub properties : Properties
}

///|
pub fn ConnectPacket::new(
  version : ProtocolVersion,
  client_id : String,
) -> ConnectPacket {
  ConnectPacket::{
    protocol_version: version,
    client_id: client_id,
    clean_start: true,
    keep_alive: 60,
    username: None,
    password: None,
    will: None,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnAckPacket {
  pub session_present : Bool
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PublishPacket {
  pub dup : Bool
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub packet_id : Option[Int]
  pub properties : Properties
  pub payload : Bytes
}

///|
pub fn PublishPacket::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
  packet_id : Option[Int],
) -> PublishPacket {
  PublishPacket::{
    dup: false,
    qos: qos,
    retain: retain,
    topic: topic,
    packet_id: packet_id,
    properties: Properties::empty(),
    payload: payload,
  }
}

///|
pub struct PubAckPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRecPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRelPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubCompPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub val struct SubscribeTopic {
  pub filter : String
  pub qos : QoS
  pub no_local : Bool
  pub retain_as_published : Bool
  pub retain_handling : Int
}

///|
pub fn SubscribeTopic::new(filter : String, qos : QoS) -> SubscribeTopic {
  SubscribeTopic::{
    filter: filter,
    qos: qos,
    no_local: false,
    retain_as_published: false,
    retain_handling: 0,
  }
}

///|
pub struct SubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[SubscribeTopic]
}

///|
pub struct SubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct UnsubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[String]
}

///|
pub struct UnsubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct DisconnectPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct AuthPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub enum Packet {
  Connect(ConnectPacket)
  ConnAck(ConnAckPacket)
  Publish(PublishPacket)
  PubAck(PubAckPacket)
  PubRec(PubRecPacket)
  PubRel(PubRelPacket)
  PubComp(PubCompPacket)
  Subscribe(SubscribePacket)
  SubAck(SubAckPacket)
  Unsubscribe(UnsubscribePacket)
  UnsubAck(UnsubAckPacket)
  PingReq
  PingResp
  Disconnect(DisconnectPacket)
  Auth(AuthPacket)
}

///| Encode PUBACK / PUBREC / PUBREL / PUBCOMP uniformly without intermediate buffers.
fn encode_ack_packet(
  header_byte : Int,
  packet_id : Int,
  reason_code : Int,
  props : Properties,
  version : ProtocolVersion,
  pt : PacketType,
  ctx : PropertyContext,
) -> Result[Bytes, MqttError] {
  if packet_id < 1 || packet_id > 65535 {
    return Err(MqttError::InvalidPacketId)
  }
  if version is ProtocolVersion::V5 {
    if !is_valid_reason_code(pt, reason_code) {
      return Err(MqttError::InvalidReasonCode(reason_code))
    }
    let prop_len = match measure_and_validate_properties(props, ctx) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    if reason_code == 0 && prop_len == 0 {
      let out = Bytes::new(4)
      out[0] = (header_byte & 0xFF).to_byte()
      out[1] = (2).to_byte()
      out[2] = ((packet_id >> 8) & 0xFF).to_byte()
      out[3] = (packet_id & 0xFF).to_byte()
      return Ok(out)
    }
    if prop_len == 0 {
      let out = Bytes::new(5)
      out[0] = (header_byte & 0xFF).to_byte()
      out[1] = (3).to_byte()
      out[2] = ((packet_id >> 8) & 0xFF).to_byte()
      out[3] = (packet_id & 0xFF).to_byte()
      out[4] = (reason_code & 0xFF).to_byte()
      return Ok(out)
    }
    let rem_len = 3 + vbi_encoded_len(prop_len) + prop_len
    if vbi_encoded_len(rem_len) == 0 {
      return Err(MqttError::MalformedVbi)
    }
    let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
    sb.write_byte((header_byte & 0xFF).to_byte())
    sb_write_vbi(sb, rem_len)
    sb_write_u16(sb, packet_id)
    sb.write_byte((reason_code & 0xFF).to_byte())
    write_properties_to_sb(sb, props, prop_len, ctx)
    return Ok(sb.to_string().to_bytes())
  }
  let out = Bytes::new(4)
  out[0] = (header_byte & 0xFF).to_byte()
  out[1] = (2).to_byte()
  out[2] = ((packet_id >> 8) & 0xFF).to_byte()
  out[3] = (packet_id & 0xFF).to_byte()
  Ok(out)
}

///| Encode any MQTT 3.1.1 or MQTT 5.0 control packet to wire bytes.
pub fn encode_packet(
  packet : Packet,
  version : ProtocolVersion,
) -> Result[Bytes, MqttError] {
  match packet {
    Packet::Connect(c) => {
      let has_user = !(c.username is None)
      let has_pass = !(c.password is None)
      if c.protocol_version is ProtocolVersion::V311 && has_pass && !has_user {
        return Err(MqttError::InvalidConnectFlags(0x40))
      }
      if c.keep_alive < 0 || c.keep_alive > 65535 {
        return Err(MqttError::ProtocolViolation("keep_alive out of range"))
      }
      let is_v5 = c.protocol_version is ProtocolVersion::V5
      let mut rem_len = 10 // 2 + "MQTT"(4) + ver(1) + flags(1) + keep_alive(2)
      let mut conn_prop_len = 0
      if is_v5 {
        conn_prop_len = match measure_and_validate_properties(c.properties, PropertyContext::Connect) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        rem_len = rem_len + vbi_encoded_len(conn_prop_len) + conn_prop_len
      }
      let cid_len = match check_encode_mqtt_str(c.client_id) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      rem_len = rem_len + 2 + cid_len
      let mut will_prop_len = 0
      match c.will {
        Some(w) => {
          if is_v5 {
            will_prop_len = match measure_and_validate_properties(w.properties, PropertyContext::Will) {
              Ok(n) => n
              Err(e) => return Err(e)
            }
            rem_len = rem_len + vbi_encoded_len(will_prop_len) + will_prop_len
          }
          if !is_valid_mqtt_topic_str(w.topic) {
            return Err(MqttError::InvalidTopicName(w.topic))
          }
          let wplen = w.payload.length()
          if wplen > 65535 {
            return Err(MqttError::ProtocolViolation("binary data exceeds 65535 bytes"))
          }
          rem_len = rem_len + 2 + w.topic.length() + 2 + wplen
        }
        None => ()
      }
      match c.username {
        Some(u) => {
          let ulen = match check_encode_mqtt_str(u) {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          rem_len = rem_len + 2 + ulen
        }
        None => ()
      }
      match c.password {
        Some(pw) => {
          let pwlen = pw.length()
          if pwlen > 65535 {
            return Err(MqttError::ProtocolViolation("binary data exceeds 65535 bytes"))
          }
          rem_len = rem_len + 2 + pwlen
        }
        None => ()
      }
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let mut flags = 0
      if c.clean_start {
        flags = flags | 0x02
      }
      match c.will {
        Some(w) => {
          flags = flags | 0x04 | ((qos_to_int(w.qos) & 0x03) << 3)
          if w.retain {
            flags = flags | 0x20
          }
        }
        None => ()
      }
      if has_pass {
        flags = flags | 0x40
      }
      if has_user {
        flags = flags | 0x80
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0x10).to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_u16(sb, 4)
      sb.write_string("MQTT")
      sb.write_byte((if is_v5 { 5 } else { 4 }).to_byte())
      sb.write_byte(flags.to_byte())
      sb_write_u16(sb, c.keep_alive)
      if is_v5 {
        write_properties_to_sb(sb, c.properties, conn_prop_len, PropertyContext::Connect)
      }
      sb_write_mqtt_str_raw(sb, c.client_id)
      match c.will {
        Some(w) => {
          if is_v5 {
            write_properties_to_sb(sb, w.properties, will_prop_len, PropertyContext::Will)
          }
          sb_write_mqtt_str_raw(sb, w.topic)
          sb_write_bin_data_raw(sb, w.payload)
        }
        None => ()
      }
      match c.username {
        Some(u) => sb_write_mqtt_str_raw(sb, u)
        None => ()
      }
      match c.password {
        Some(pw) => sb_write_bin_data_raw(sb, pw)
        None => ()
      }
      Ok(sb.to_string().to_bytes())
    }
    Packet::ConnAck(ca) => {
      if version is ProtocolVersion::V311 {
        if ca.reason_code < 0 || ca.reason_code > 5 {
          return Err(MqttError::InvalidReasonCode(ca.reason_code))
        }
        if ca.session_present && ca.reason_code != 0 {
          return Err(
            MqttError::ProtocolViolation(
              "CONNACK session_present must be 0 when reason code is non-zero",
            ),
          )
        }
        let out = Bytes::new(4)
        out[0] = (0x20).to_byte()
        out[1] = (2).to_byte()
        out[2] = (if ca.session_present { 1 } else { 0 }).to_byte()
        out[3] = (ca.reason_code & 0xFF).to_byte()
        return Ok(out)
      }
      if !is_valid_reason_code(PacketType::ConnAck, ca.reason_code) {
        return Err(MqttError::InvalidReasonCode(ca.reason_code))
      }
      if ca.session_present && ca.reason_code != 0 {
        return Err(
          MqttError::ProtocolViolation(
            "CONNACK session_present must be 0 when reason code is non-zero",
          ),
        )
      }
      let prop_len = match measure_and_validate_properties(ca.properties, PropertyContext::ConnAck) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      let rem_len = 2 + vbi_encoded_len(prop_len) + prop_len
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0x20).to_byte())
      sb_write_vbi(sb, rem_len)
      sb.write_byte((if ca.session_present { 1 } else { 0 }).to_byte())
      sb.write_byte((ca.reason_code & 0xFF).to_byte())
      write_properties_to_sb(sb, ca.properties, prop_len, PropertyContext::ConnAck)
      Ok(sb.to_string().to_bytes())
    }
    Packet::Publish(p) => {
      let q = qos_to_int(p.qos)
      if q == 0 && p.dup {
        return Err(MqttError::InvalidFlags(3, 0x08))
      }
      let tlen = p.topic.length()
      let is_v5 = version is ProtocolVersion::V5
      if tlen == 0 {
        if !(is_v5 && !(p.properties.topic_alias is None)) {
          return Err(MqttError::InvalidTopicName("empty topic name"))
        }
      } else {
        if !is_valid_mqtt_topic_str(p.topic) {
          return Err(MqttError::InvalidTopicName(p.topic))
        }
      }
      let mut pid = 0
      if q > 0 {
        match p.packet_id {
          Some(x) => {
            if x < 1 || x > 65535 {
              return Err(MqttError::InvalidPacketId)
            }
            pid = x
          }
          None => return Err(MqttError::InvalidPacketId)
        }
      }
      let mut prop_len = 0
      let mut prop_vbi_len = 0
      let header_body_len = 2 + tlen + (if q > 0 { 2 } else { 0 })
      if is_v5 {
        let fast_len = measure_publish_properties_fast(p.properties)
        if fast_len >= 0 {
          prop_len = fast_len
        } else {
          prop_len = match measure_and_validate_properties(p.properties, PropertyContext::Publish) {
            Ok(n) => n
            Err(e) => return Err(e)
          }
        }
        prop_vbi_len = vbi_encoded_len(prop_len)
      }
      let rem_len = header_body_len + prop_vbi_len + prop_len + p.payload.length()
      let rem_vbi_len = vbi_encoded_len(rem_len)
      if rem_vbi_len == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let mut hdr = 0x30 | (q << 1)
      if p.dup {
        hdr = hdr | 0x08
      }
      if p.retain {
        hdr = hdr | 0x01
      }
      let sb = StringBuilder::with_capacity(1 + rem_vbi_len + header_body_len + prop_vbi_len + prop_len)
      sb.write_byte(hdr.to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_mqtt_str_raw(sb, p.topic)
      if q > 0 {
        sb_write_u16(sb, pid)
      }
      if is_v5 {
        write_properties_to_sb(sb, p.properties, prop_len, PropertyContext::Publish)
      }
      if p.payload.length() == 0 {
        Ok(sb.to_string().to_bytes())
      } else {
        Ok(sb.to_string().to_bytes().concat(p.payload))
      }
    }
    Packet::PubAck(a) =>
    encode_ack_packet(0x40, a.packet_id, a.reason_code, a.properties, version, PacketType::PubAck, PropertyContext::PubAck)
    Packet::PubRec(a) =>
    encode_ack_packet(0x50, a.packet_id, a.reason_code, a.properties, version, PacketType::PubRec, PropertyContext::PubRec)
    Packet::PubRel(a) =>
    encode_ack_packet(0x62, a.packet_id, a.reason_code, a.properties, version, PacketType::PubRel, PropertyContext::PubRel)
    Packet::PubComp(a) =>
    encode_ack_packet(0x70, a.packet_id, a.reason_code, a.properties, version, PacketType::PubComp, PropertyContext::PubComp)
    Packet::Subscribe(s) => {
      if s.packet_id < 1 || s.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      let tcount = s.topics.length()
      if tcount == 0 {
        return Err(MqttError::ProtocolViolation("SUBSCRIBE must contain at least one topic"))
      }
      let is_v5 = version is ProtocolVersion::V5
      let mut prop_len = 0
      let mut rem_len = 2
      if is_v5 {
        prop_len = match measure_and_validate_properties(s.properties, PropertyContext::Subscribe) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        rem_len = rem_len + vbi_encoded_len(prop_len) + prop_len
      }
      let mut i = 0
      while i < tcount {
        let t = s.topics[i]
        match validate_topic_filter_for_version(t.filter, version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if is_v5 {
          if t.no_local && is_shared_subscription_filter(t.filter) {
            return Err(
              MqttError::ProtocolViolation(
                "No Local option MUST NOT be set on a Shared Subscription",
              ),
            )
          }
          if t.retain_handling < 0 || t.retain_handling > 2 {
            return Err(MqttError::ProtocolViolation("retain_handling must be 0..2"))
          }
        }
        rem_len = rem_len + 2 + t.filter.length() + 1
        i = i + 1
      }
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0x82).to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_u16(sb, s.packet_id)
      if is_v5 {
        write_properties_to_sb(sb, s.properties, prop_len, PropertyContext::Subscribe)
      }
      let mut j = 0
      while j < tcount {
        let t = s.topics[j]
        sb_write_mqtt_str_raw(sb, t.filter)
        let mut opts = qos_to_int(t.qos) & 0x03
        if is_v5 {
          if t.no_local {
            opts = opts | 0x04
          }
          if t.retain_as_published {
            opts = opts | 0x08
          }
          opts = opts | ((t.retain_handling & 0x03) << 4)
        }
        sb.write_byte(opts.to_byte())
        j = j + 1
      }
      Ok(sb.to_string().to_bytes())
    }
    Packet::SubAck(sa) => {
      if sa.packet_id < 1 || sa.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      let rcount = sa.reason_codes.length()
      if rcount == 0 {
        return Err(MqttError::ProtocolViolation("SUBACK must contain at least one reason code"))
      }
      let is_v5 = version is ProtocolVersion::V5
      let mut prop_len = 0
      let mut rem_len = 2 + rcount
      if is_v5 {
        prop_len = match measure_and_validate_properties(sa.properties, PropertyContext::SubAck) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        rem_len = rem_len + vbi_encoded_len(prop_len) + prop_len
      }
      let mut i = 0
      while i < rcount {
        let rc = sa.reason_codes[i]
        if !is_v5 {
          if rc != 0x00 && rc != 0x01 && rc != 0x02 && rc != 0x80 {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        } else {
          if !is_valid_reason_code(PacketType::SubAck, rc) {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        }
        i = i + 1
      }
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0x90).to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_u16(sb, sa.packet_id)
      if is_v5 {
        write_properties_to_sb(sb, sa.properties, prop_len, PropertyContext::SubAck)
      }
      let mut j = 0
      while j < rcount {
        sb.write_byte((sa.reason_codes[j] & 0xFF).to_byte())
        j = j + 1
      }
      Ok(sb.to_string().to_bytes())
    }
    Packet::Unsubscribe(u) => {
      if u.packet_id < 1 || u.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      let tcount = u.topics.length()
      if tcount == 0 {
        return Err(MqttError::ProtocolViolation("UNSUBSCRIBE must contain at least one topic"))
      }
      let is_v5 = version is ProtocolVersion::V5
      let mut prop_len = 0
      let mut rem_len = 2
      if is_v5 {
        prop_len = match measure_and_validate_properties(u.properties, PropertyContext::Unsubscribe) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        rem_len = rem_len + vbi_encoded_len(prop_len) + prop_len
      }
      let mut i = 0
      while i < tcount {
        let f = u.topics[i]
        match validate_topic_filter_for_version(f, version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        rem_len = rem_len + 2 + f.length()
        i = i + 1
      }
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0xA2).to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_u16(sb, u.packet_id)
      if is_v5 {
        write_properties_to_sb(sb, u.properties, prop_len, PropertyContext::Unsubscribe)
      }
      let mut j = 0
      while j < tcount {
        sb_write_mqtt_str_raw(sb, u.topics[j])
        j = j + 1
      }
      Ok(sb.to_string().to_bytes())
    }
    Packet::UnsubAck(ua) => {
      if ua.packet_id < 1 || ua.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      if !(version is ProtocolVersion::V5) {
        let out = Bytes::new(4)
        out[0] = (0xB0).to_byte()
        out[1] = (2).to_byte()
        out[2] = ((ua.packet_id >> 8) & 0xFF).to_byte()
        out[3] = (ua.packet_id & 0xFF).to_byte()
        return Ok(out)
      }
      let rcount = ua.reason_codes.length()
      if rcount == 0 {
        return Err(MqttError::ProtocolViolation("v5 UNSUBACK must contain at least one reason code"))
      }
      let prop_len = match measure_and_validate_properties(ua.properties, PropertyContext::UnsubAck) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < rcount {
        let rc = ua.reason_codes[i]
        if !is_valid_reason_code(PacketType::UnsubAck, rc) {
          return Err(MqttError::InvalidReasonCode(rc))
        }
        i = i + 1
      }
      let rem_len = 2 + vbi_encoded_len(prop_len) + prop_len + rcount
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0xB0).to_byte())
      sb_write_vbi(sb, rem_len)
      sb_write_u16(sb, ua.packet_id)
      write_properties_to_sb(sb, ua.properties, prop_len, PropertyContext::UnsubAck)
      let mut j = 0
      while j < rcount {
        sb.write_byte((ua.reason_codes[j] & 0xFF).to_byte())
        j = j + 1
      }
      Ok(sb.to_string().to_bytes())
    }
    Packet::PingReq => {
      let out = Bytes::new(2)
      out[0] = (0xC0).to_byte()
      out[1] = (0x00).to_byte()
      Ok(out)
    }
    Packet::PingResp => {
      let out = Bytes::new(2)
      out[0] = (0xD0).to_byte()
      out[1] = (0x00).to_byte()
      Ok(out)
    }
    Packet::Disconnect(d) => {
      if !(version is ProtocolVersion::V5) {
        let out = Bytes::new(2)
        out[0] = (0xE0).to_byte()
        out[1] = (0x00).to_byte()
        return Ok(out)
      }
      if !is_valid_reason_code(PacketType::Disconnect, d.reason_code) {
        return Err(MqttError::InvalidReasonCode(d.reason_code))
      }
      let prop_len = match measure_and_validate_properties(d.properties, PropertyContext::Disconnect) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      if d.reason_code == 0 && prop_len == 0 {
        let out = Bytes::new(2)
        out[0] = (0xE0).to_byte()
        out[1] = (0x00).to_byte()
        return Ok(out)
      }
      if prop_len == 0 {
        let out = Bytes::new(3)
        out[0] = (0xE0).to_byte()
        out[1] = (1).to_byte()
        out[2] = (d.reason_code & 0xFF).to_byte()
        return Ok(out)
      }
      let rem_len = 1 + vbi_encoded_len(prop_len) + prop_len
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0xE0).to_byte())
      sb_write_vbi(sb, rem_len)
      sb.write_byte((d.reason_code & 0xFF).to_byte())
      write_properties_to_sb(sb, d.properties, prop_len, PropertyContext::Disconnect)
      Ok(sb.to_string().to_bytes())
    }
    Packet::Auth(a) => {
      if !(version is ProtocolVersion::V5) {
        return Err(MqttError::ProtocolViolation("AUTH packet is MQTT 5.0 only"))
      }
      if !is_valid_reason_code(PacketType::Auth, a.reason_code) {
        return Err(MqttError::InvalidReasonCode(a.reason_code))
      }
      let prop_len = match measure_and_validate_properties(a.properties, PropertyContext::Auth) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      if a.reason_code == 0 && prop_len == 0 {
        let out = Bytes::new(2)
        out[0] = (0xF0).to_byte()
        out[1] = (0x00).to_byte()
        return Ok(out)
      }
      if prop_len == 0 {
        let out = Bytes::new(3)
        out[0] = (0xF0).to_byte()
        out[1] = (1).to_byte()
        out[2] = (a.reason_code & 0xFF).to_byte()
        return Ok(out)
      }
      let rem_len = 1 + vbi_encoded_len(prop_len) + prop_len
      if vbi_encoded_len(rem_len) == 0 {
        return Err(MqttError::MalformedVbi)
      }
      let sb = StringBuilder::with_capacity(1 + vbi_encoded_len(rem_len) + rem_len)
      sb.write_byte((0xF0).to_byte())
      sb_write_vbi(sb, rem_len)
      sb.write_byte((a.reason_code & 0xFF).to_byte())
      write_properties_to_sb(sb, a.properties, prop_len, PropertyContext::Auth)
      Ok(sb.to_string().to_bytes())
    }
  }
}

///| Decode an ACK-shaped packet (PUBACK, PUBREC, PUBREL, PUBCOMP) directly from `String` without Result/tuple boxing.
fn decode_ack_packet_str(
  data : String,
  start : Int,
  end : Int,
  version : ProtocolVersion,
  ptype : Int,
  pt : PacketType,
  ctx : PropertyContext,
  max_props : Int,
  cursor : DecodeCursor,
) -> Option[Packet] {
  if start + 2 > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return None
  }
  let pid = (data.code_unit_at(start) << 8) | data.code_unit_at(start + 1)
  if pid == 0 {
    cursor.err = Some(MqttError::InvalidPacketId)
    return None
  }
  let p1 = start + 2
  let mut rc = 0
  let props = if version is ProtocolVersion::V311 {
    if p1 != end {
      cursor.err = Some(MqttError::TrailingBytes(end - p1))
      return None
    }
    Properties::empty()
  } else if p1 < end {
    rc = data.code_unit_at(p1)
    if rc != 0 && !is_valid_reason_code(pt, rc) {
      cursor.err = Some(MqttError::InvalidReasonCode(rc))
      return None
    }
    let p2 = p1 + 1
    if p2 < end {
      if p2 + 1 == end && data.code_unit_at(p2) == 0 {
        Properties::empty()
      } else {
        cursor.pos = p2
        let pr = decode_properties_str(data, cursor, end, ctx, max_props)
        if !(cursor.err is None) {
          return None
        }
        if cursor.pos != end {
          cursor.err = Some(MqttError::TrailingBytes(end - cursor.pos))
          return None
        }
        pr
      }
    } else {
      Properties::empty()
    }
  } else {
    Properties::empty()
  }
  cursor.pos = end
  if ptype == 4 {
    Some(Packet::PubAck(PubAckPacket::{ packet_id: pid, reason_code: rc, properties: props }))
  } else if ptype == 5 {
    Some(Packet::PubRec(PubRecPacket::{ packet_id: pid, reason_code: rc, properties: props }))
  } else if ptype == 6 {
    Some(Packet::PubRel(PubRelPacket::{ packet_id: pid, reason_code: rc, properties: props }))
  } else {
    Some(Packet::PubComp(PubCompPacket::{ packet_id: pid, reason_code: rc, properties: props }))
  }
}

///| Zero-boxing single-packet decoder over `String` `[offset, data_end)`.
///| Returns `Some(pkt)` with `cursor.pos = body_end` on success;
///| returns `None` with `cursor.err = None` if incomplete;
///| returns `None` with `cursor.err = Some(e)` on protocol error.
fn decode_packet_str(
  data : String,
  offset : Int,
  data_end : Int,
  version : ProtocolVersion,
  limits : MqttLimits,
  cursor : DecodeCursor,
) -> Option[Packet] {
  if offset >= data_end {
    return None
  }
  let b0 = data.code_unit_at(offset)
  let ptype = (b0 >> 4) & 0x0F
  let flags = b0 & 0x0F
  let fh_code = fixed_header_flags_err_code(ptype, flags)
  if fh_code != 0 {
    if fh_code == 1 {
      cursor.err = Some(MqttError::InvalidPacketType(ptype))
    } else if fh_code == 2 {
      cursor.err = Some(MqttError::InvalidQoS(3))
    } else {
      cursor.err = Some(MqttError::InvalidFlags(ptype, flags))
    }
    return None
  }
  if ptype == 15 && !(version is ProtocolVersion::V5) {
    cursor.err = Some(MqttError::ProtocolViolation("AUTH packet is MQTT 5.0 only"))
    return None
  }
  let vbi_off = offset + 1
  if vbi_off >= data_end {
    return None
  }
  let vb0 = data.code_unit_at(vbi_off)
  let mut rem_len = 0
  let mut body_start = 0
  if vb0 < 0x80 {
    rem_len = vb0
    body_start = vbi_off + 1
  } else {
    let v = decode_vbi_multi_str(data, vbi_off, data_end, vb0, cursor)
    if v < 0 {
      return None
    }
    rem_len = v
    body_start = cursor.pos
  }
  let body_end = body_start + rem_len
  let total_len = body_end - offset
  if total_len > limits.max_packet_size {
    cursor.err = Some(MqttError::PacketTooLarge(total_len, limits.max_packet_size))
    return None
  }
  if body_end > data_end {
    return None
  }
  let is_v5 = version is ProtocolVersion::V5
  match ptype {
    3 => {
      // PUBLISH (hottest packet type)
      let dup = (flags & 0x08) != 0
      let qos_raw = (flags >> 1) & 0x03
      let retain = (flags & 0x01) != 0
      let qos = if qos_raw == 0 {
        QoS::AtMostOnce
      } else if qos_raw == 1 {
        QoS::AtLeastOnce
      } else {
        QoS::ExactlyOnce
      }
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let tlen = (data.code_unit_at(body_start) << 8) | data.code_unit_at(body_start + 1)
      let tstart = body_start + 2
      let tend = tstart + tlen
      if tend > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let mut topic_has_wildcard = false
      if tlen > 0 {
        let tcheck = check_mqtt_topic_str_range(data, tstart, tend)
        if tcheck == 2 {
          let sub = data.slice(tstart, tend).to_bytes()
          match validate_mqtt_utf8_range(sub, 0, tlen) {
            Ok(_) => ()
            Err(e) => {
              cursor.err = Some(e)
              return None
            }
          }
        } else if tcheck == 1 {
          topic_has_wildcard = true
        }
      }
      if tlen > limits.max_topic_len {
        cursor.err = Some(MqttError::InvalidTopicName("topic exceeds max_topic_len"))
        return None
      }
      let topic = if tlen == 0 { "" } else { data.slice(tstart, tend) }
      let mut p = tend
      let pid_opt : Option[Int] = if qos_raw > 0 {
        if p + 2 > body_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return None
        }
        let pid = (data.code_unit_at(p) << 8) | data.code_unit_at(p + 1)
        if pid == 0 {
          cursor.err = Some(MqttError::InvalidPacketId)
          return None
        }
        p = p + 2
        Some(pid)
      } else {
        None
      }
      let props = if is_v5 {
        cursor.pos = p
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::Publish, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        p = cursor.pos
        pr
      } else {
        Properties::empty()
      }
      if tlen == 0 {
        if !(is_v5 && !(props.topic_alias is None)) {
          cursor.err = Some(MqttError::InvalidTopicName("empty topic without topic alias"))
          return None
        }
      } else if topic_has_wildcard {
        cursor.err = Some(MqttError::InvalidTopicName(topic))
        return None
      }
      let payload = if p == body_end {
        empty_bytes
      } else {
        data.slice(p, body_end).to_bytes()
      }
      cursor.pos = body_end
      Some(
        Packet::Publish(PublishPacket::{
          dup: dup,
          qos: qos,
          retain: retain,
          topic: topic,
          packet_id: pid_opt,
          properties: props,
          payload: payload,
        }),
      )
    }
    4 =>
    decode_ack_packet_str(data, body_start, body_end, version, 4, PacketType::PubAck, PropertyContext::PubAck, limits.max_properties, cursor)
    5 =>
    decode_ack_packet_str(data, body_start, body_end, version, 5, PacketType::PubRec, PropertyContext::PubRec, limits.max_properties, cursor)
    6 =>
    decode_ack_packet_str(data, body_start, body_end, version, 6, PacketType::PubRel, PropertyContext::PubRel, limits.max_properties, cursor)
    7 =>
    decode_ack_packet_str(data, body_start, body_end, version, 7, PacketType::PubComp, PropertyContext::PubComp, limits.max_properties, cursor)
    12 => {
      if rem_len != 0 {
        cursor.err = Some(MqttError::TrailingBytes(rem_len))
        return None
      }
      cursor.pos = body_end
      Some(Packet::PingReq)
    }
    13 => {
      if rem_len != 0 {
        cursor.err = Some(MqttError::TrailingBytes(rem_len))
        return None
      }
      cursor.pos = body_end
      Some(Packet::PingResp)
    }
    1 => {
      // CONNECT
      let mut p = body_start
      if p + 6 <= body_end &&
      data.code_unit_at(p) == 0 &&
      data.code_unit_at(p + 1) == 4 &&
      data.code_unit_at(p + 2) == 0x4D &&
      data.code_unit_at(p + 3) == 0x51 &&
      data.code_unit_at(p + 4) == 0x54 &&
      data.code_unit_at(p + 5) == 0x54 {
        p = p + 6
      } else {
        cursor.pos = p
        let proto_name = read_mqtt_str_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        if proto_name != "MQTT" {
          cursor.err = Some(MqttError::InvalidProtocolName(proto_name))
          return None
        }
        p = cursor.pos
      }
      if p + 4 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let ver_byte = data.code_unit_at(p)
      let conn_ver = if ver_byte == 4 {
        ProtocolVersion::V311
      } else if ver_byte == 5 {
        ProtocolVersion::V5
      } else {
        cursor.err = Some(MqttError::UnsupportedProtocolVersion(ver_byte))
        return None
      }
      let cflags = data.code_unit_at(p + 1)
      if (cflags & 0x01) != 0 {
        cursor.err = Some(MqttError::InvalidConnectFlags(cflags))
        return None
      }
      let clean_start = (cflags & 0x02) != 0
      let will_flag = (cflags & 0x04) != 0
      let will_qos_raw = (cflags >> 3) & 0x03
      let will_retain = (cflags & 0x20) != 0
      let pass_flag = (cflags & 0x40) != 0
      let user_flag = (cflags & 0x80) != 0
      if !will_flag && (will_qos_raw != 0 || will_retain) {
        cursor.err = Some(MqttError::InvalidConnectFlags(cflags))
        return None
      }
      let will_qos = if will_qos_raw == 0 {
        QoS::AtMostOnce
      } else if will_qos_raw == 1 {
        QoS::AtLeastOnce
      } else if will_qos_raw == 2 {
        QoS::ExactlyOnce
      } else {
        cursor.err = Some(MqttError::InvalidQoS(will_qos_raw))
        return None
      }
      let conn_is_v5 = conn_ver is ProtocolVersion::V5
      if !conn_is_v5 && pass_flag && !user_flag {
        cursor.err = Some(MqttError::InvalidConnectFlags(cflags))
        return None
      }
      let keep_alive = (data.code_unit_at(p + 2) << 8) | data.code_unit_at(p + 3)
      cursor.pos = p + 4
      let conn_props = if conn_is_v5 {
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::Connect, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        pr
      } else {
        Properties::empty()
      }
      let client_id = read_mqtt_str_from_str(data, cursor, body_end)
      if !(cursor.err is None) {
        return None
      }
      let will_opt : Option[Will] = if will_flag {
        let w_props = if conn_is_v5 {
          let pr = decode_properties_str(data, cursor, body_end, PropertyContext::Will, limits.max_properties)
          if !(cursor.err is None) {
            return None
          }
          pr
        } else {
          Properties::empty()
        }
        let w_topic = read_mqtt_str_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        if !is_valid_mqtt_topic_str(w_topic) {
          cursor.err = Some(MqttError::InvalidTopicName(w_topic))
          return None
        }
        let w_payload = read_bin_data_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        Some(Will::{
          qos: will_qos,
          retain: will_retain,
          topic: w_topic,
          payload: w_payload,
          properties: w_props,
        })
      } else {
        None
      }
      let username : Option[String] = if user_flag {
        let u = read_mqtt_str_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        Some(u)
      } else {
        None
      }
      let password : Option[Bytes] = if pass_flag {
        let pw = read_bin_data_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        Some(pw)
      } else {
        None
      }
      if cursor.pos != body_end {
        cursor.err = Some(MqttError::TrailingBytes(body_end - cursor.pos))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::Connect(ConnectPacket::{
          protocol_version: conn_ver,
          client_id: client_id,
          clean_start: clean_start,
          keep_alive: keep_alive,
          username: username,
          password: password,
          will: will_opt,
          properties: conn_props,
        }),
      )
    }
    2 => {
      // CONNACK
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let ack_flags = data.code_unit_at(body_start)
      if (ack_flags & 0xFE) != 0 {
        cursor.err = Some(MqttError::ProtocolViolation("reserved CONNACK acknowledge flags non-zero"))
        return None
      }
      let rc = data.code_unit_at(body_start + 1)
      let session_present = (ack_flags & 0x01) != 0
      if !is_v5 {
        if rc > 5 {
          cursor.err = Some(MqttError::InvalidReasonCode(rc))
          return None
        }
      } else {
        if !is_valid_reason_code(PacketType::ConnAck, rc) {
          cursor.err = Some(MqttError::InvalidReasonCode(rc))
          return None
        }
      }
      if session_present && rc != 0 {
        cursor.err = Some(
          MqttError::ProtocolViolation(
            "CONNACK session_present must be 0 when reason code is non-zero",
          ),
        )
        return None
      }
      cursor.pos = body_start + 2
      let props = if is_v5 {
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::ConnAck, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        pr
      } else {
        Properties::empty()
      }
      if cursor.pos != body_end {
        cursor.err = Some(MqttError::TrailingBytes(body_end - cursor.pos))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::ConnAck(ConnAckPacket::{
          session_present: session_present,
          reason_code: rc,
          properties: props,
        }),
      )
    }
    8 => {
      // SUBSCRIBE
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let pid = (data.code_unit_at(body_start) << 8) | data.code_unit_at(body_start + 1)
      if pid == 0 {
        cursor.err = Some(MqttError::InvalidPacketId)
        return None
      }
      cursor.pos = body_start + 2
      let props = if is_v5 {
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::Subscribe, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        pr
      } else {
        Properties::empty()
      }
      let topics : Array[SubscribeTopic] = []
      while cursor.pos < body_end {
        if topics.length() >= limits.max_subscriptions {
          cursor.err = Some(MqttError::ProtocolViolation("max_subscriptions exceeded"))
          return None
        }
        let filter = read_mqtt_str_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        match validate_decoded_filter_for_version(filter, version) {
          Ok(_) => ()
          Err(e) => {
            cursor.err = Some(e)
            return None
          }
        }
        if cursor.pos + 1 > body_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return None
        }
        let opts = data.code_unit_at(cursor.pos)
        cursor.pos = cursor.pos + 1
        let qraw = opts & 0x03
        let qos = if qraw == 0 {
          QoS::AtMostOnce
        } else if qraw == 1 {
          QoS::AtLeastOnce
        } else if qraw == 2 {
          QoS::ExactlyOnce
        } else {
          cursor.err = Some(MqttError::InvalidQoS(qraw))
          return None
        }
        if !is_v5 {
          if (opts & 0xFC) != 0 {
            cursor.err = Some(MqttError::ProtocolViolation("reserved v3.1.1 subscribe options non-zero"))
            return None
          }
          topics.push(SubscribeTopic::new(filter, qos))
        } else {
          if (opts & 0xC0) != 0 {
            cursor.err = Some(MqttError::ProtocolViolation("reserved v5 subscribe options non-zero"))
            return None
          }
          let rh = (opts >> 4) & 0x03
          if rh == 3 {
            cursor.err = Some(MqttError::ProtocolViolation("invalid retain_handling 3"))
            return None
          }
          let no_local = (opts & 0x04) != 0
          if no_local && is_shared_subscription_filter(filter) {
            cursor.err = Some(
              MqttError::ProtocolViolation(
                "No Local option MUST NOT be set on a Shared Subscription",
              ),
            )
            return None
          }
          topics.push(SubscribeTopic::{
            filter: filter,
            qos: qos,
            no_local: no_local,
            retain_as_published: (opts & 0x08) != 0,
            retain_handling: rh,
          })
        }
      }
      if topics.length() == 0 {
        cursor.err = Some(MqttError::ProtocolViolation("SUBSCRIBE has no topic filters"))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::Subscribe(SubscribePacket::{
          packet_id: pid,
          properties: props,
          topics: topics,
        }),
      )
    }
    9 => {
      // SUBACK
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let pid = (data.code_unit_at(body_start) << 8) | data.code_unit_at(body_start + 1)
      if pid == 0 {
        cursor.err = Some(MqttError::InvalidPacketId)
        return None
      }
      cursor.pos = body_start + 2
      let props = if is_v5 {
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::SubAck, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        pr
      } else {
        Properties::empty()
      }
      let rcs : Array[Int] = []
      let mut p = cursor.pos
      while p < body_end {
        let rc = data.code_unit_at(p)
        if !is_v5 {
          if rc != 0x00 && rc != 0x01 && rc != 0x02 && rc != 0x80 {
            cursor.err = Some(MqttError::InvalidReasonCode(rc))
            return None
          }
        } else {
          if !is_valid_reason_code(PacketType::SubAck, rc) {
            cursor.err = Some(MqttError::InvalidReasonCode(rc))
            return None
          }
        }
        rcs.push(rc)
        p = p + 1
      }
      if rcs.length() == 0 {
        cursor.err = Some(MqttError::ProtocolViolation("SUBACK has no return codes"))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::SubAck(SubAckPacket::{
          packet_id: pid,
          properties: props,
          reason_codes: rcs,
        }),
      )
    }
    10 => {
      // UNSUBSCRIBE
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let pid = (data.code_unit_at(body_start) << 8) | data.code_unit_at(body_start + 1)
      if pid == 0 {
        cursor.err = Some(MqttError::InvalidPacketId)
        return None
      }
      cursor.pos = body_start + 2
      let props = if is_v5 {
        let pr = decode_properties_str(data, cursor, body_end, PropertyContext::Unsubscribe, limits.max_properties)
        if !(cursor.err is None) {
          return None
        }
        pr
      } else {
        Properties::empty()
      }
      let topics : Array[String] = []
      while cursor.pos < body_end {
        if topics.length() >= limits.max_subscriptions {
          cursor.err = Some(MqttError::ProtocolViolation("max_subscriptions exceeded"))
          return None
        }
        let filter = read_mqtt_str_from_str(data, cursor, body_end)
        if !(cursor.err is None) {
          return None
        }
        match validate_decoded_filter_for_version(filter, version) {
          Ok(_) => ()
          Err(e) => {
            cursor.err = Some(e)
            return None
          }
        }
        topics.push(filter)
      }
      if topics.length() == 0 {
        cursor.err = Some(MqttError::ProtocolViolation("UNSUBSCRIBE has no topic filters"))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::Unsubscribe(UnsubscribePacket::{
          packet_id: pid,
          properties: props,
          topics: topics,
        }),
      )
    }
    11 => {
      // UNSUBACK
      if body_start + 2 > body_end {
        cursor.err = Some(MqttError::UnexpectedEof)
        return None
      }
      let pid = (data.code_unit_at(body_start) << 8) | data.code_unit_at(body_start + 1)
      if pid == 0 {
        cursor.err = Some(MqttError::InvalidPacketId)
        return None
      }
      let p1 = body_start + 2
      if !is_v5 {
        if p1 != body_end {
          cursor.err = Some(MqttError::TrailingBytes(body_end - p1))
          return None
        }
        cursor.pos = body_end
        return Some(
          Packet::UnsubAck(UnsubAckPacket::{
            packet_id: pid,
            properties: Properties::empty(),
            reason_codes: [],
          }),
        )
      }
      cursor.pos = p1
      let props = decode_properties_str(data, cursor, body_end, PropertyContext::UnsubAck, limits.max_properties)
      if !(cursor.err is None) {
        return None
      }
      let rcs : Array[Int] = []
      let mut p = cursor.pos
      while p < body_end {
        let rc = data.code_unit_at(p)
        if !is_valid_reason_code(PacketType::UnsubAck, rc) {
          cursor.err = Some(MqttError::InvalidReasonCode(rc))
          return None
        }
        rcs.push(rc)
        p = p + 1
      }
      if rcs.length() == 0 {
        cursor.err = Some(MqttError::ProtocolViolation("v5 UNSUBACK must contain reason codes"))
        return None
      }
      cursor.pos = body_end
      Some(
        Packet::UnsubAck(UnsubAckPacket::{
          packet_id: pid,
          properties: props,
          reason_codes: rcs,
        }),
      )
    }
    14 => {
      // DISCONNECT
      if !is_v5 {
        if rem_len != 0 {
          cursor.err = Some(MqttError::TrailingBytes(rem_len))
          return None
        }
        cursor.pos = body_end
        return Some(
          Packet::Disconnect(DisconnectPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
        )
      }
      if rem_len == 0 {
        cursor.pos = body_end
        return Some(
          Packet::Disconnect(DisconnectPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
        )
      }
      let rc = data.code_unit_at(body_start)
      if !is_valid_reason_code(PacketType::Disconnect, rc) {
        cursor.err = Some(MqttError::InvalidReasonCode(rc))
        return None
      }
      let p1 = body_start + 1
      if p1 == body_end {
        cursor.pos = body_end
        return Some(
          Packet::Disconnect(DisconnectPacket::{
            reason_code: rc,
            properties: Properties::empty(),
          }),
        )
      }
      cursor.pos = p1
      let props = decode_properties_str(data, cursor, body_end, PropertyContext::Disconnect, limits.max_properties)
      if !(cursor.err is None) {
        return None
      }
      if cursor.pos != body_end {
        cursor.err = Some(MqttError::TrailingBytes(body_end - cursor.pos))
        return None
      }
      cursor.pos = body_end
      Some(Packet::Disconnect(DisconnectPacket::{ reason_code: rc, properties: props }))
    }
    15 => {
      // AUTH (v5 only)
      if rem_len == 0 {
        cursor.pos = body_end
        return Some(
          Packet::Auth(AuthPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
        )
      }
      let rc = data.code_unit_at(body_start)
      if !is_valid_reason_code(PacketType::Auth, rc) {
        cursor.err = Some(MqttError::InvalidReasonCode(rc))
        return None
      }
      let p1 = body_start + 1
      if p1 == body_end {
        cursor.pos = body_end
        return Some(
          Packet::Auth(AuthPacket::{
            reason_code: rc,
            properties: Properties::empty(),
          }),
        )
      }
      cursor.pos = p1
      let props = decode_properties_str(data, cursor, body_end, PropertyContext::Auth, limits.max_properties)
      if !(cursor.err is None) {
        return None
      }
      if cursor.pos != body_end {
        cursor.err = Some(MqttError::TrailingBytes(body_end - cursor.pos))
        return None
      }
      cursor.pos = body_end
      Some(Packet::Auth(AuthPacket::{ reason_code: rc, properties: props }))
    }
    _ => {
      cursor.err = Some(MqttError::InvalidPacketType(ptype))
      None
    }
  }
}

///| Decode a single MQTT packet from `data` starting at byte offset `offset`.
fn decode_packet_at(
  data : Bytes,
  offset : Int,
  data_end : Int,
  version : ProtocolVersion,
  limits : MqttLimits,
) -> Result[(Packet, Int), MqttError] {
  let s = if offset == 0 && data_end == data.length() {
    data.to_string()
  } else {
    data.slice(offset, data_end).to_string()
  }
  let cursor = DecodeCursor::{ pos: 0, err: None }
  match decode_packet_str(s, 0, s.length(), version, limits, cursor) {
    Some(pkt) => Ok((pkt, cursor.pos))
    None =>
    match cursor.err {
      Some(e) => Err(e)
      None => Err(MqttError::Incomplete)
    }
  }
}

///| Decode one MQTT packet from the beginning of `data` using default limits.
pub fn decode_packet(
  data : Bytes,
  version : ProtocolVersion,
) -> Result[(Packet, Int), MqttError] {
  decode_packet_at(data, 0, data.length(), version, MqttLimits::default())
}

///| Decode one MQTT packet from the beginning of `data` using custom `MqttLimits`.
pub fn decode_packet_with_limits(
  data : Bytes,
  version : ProtocolVersion,
  limits : MqttLimits,
) -> Result[(Packet, Int), MqttError] {
  decode_packet_at(data, 0, data.length(), version, limits)
}
