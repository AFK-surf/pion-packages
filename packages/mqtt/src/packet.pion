///| OASIS MQTT 3.1.1 & 5.0 Control Packets (all 15 packet types) and wire codec.

///|
pub struct Will {
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub payload : Bytes
  pub properties : Properties
}

///|
pub fn Will::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
) -> Will {
  Will::{
    qos: qos,
    retain: retain,
    topic: topic,
    payload: payload,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnectPacket {
  pub protocol_version : ProtocolVersion
  pub client_id : String
  pub clean_start : Bool
  pub keep_alive : Int
  pub username : Option[String]
  pub password : Option[Bytes]
  pub will : Option[Will]
  pub properties : Properties
}

///|
pub fn ConnectPacket::new(
  version : ProtocolVersion,
  client_id : String,
) -> ConnectPacket {
  ConnectPacket::{
    protocol_version: version,
    client_id: client_id,
    clean_start: true,
    keep_alive: 60,
    username: None,
    password: None,
    will: None,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnAckPacket {
  pub session_present : Bool
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PublishPacket {
  pub dup : Bool
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub packet_id : Option[Int]
  pub properties : Properties
  pub payload : Bytes
}

///|
pub fn PublishPacket::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
  packet_id : Option[Int],
) -> PublishPacket {
  PublishPacket::{
    dup: false,
    qos: qos,
    retain: retain,
    topic: topic,
    packet_id: packet_id,
    properties: Properties::empty(),
    payload: payload,
  }
}

///|
pub struct PubAckPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRecPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRelPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubCompPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub val struct SubscribeTopic {
  pub filter : String
  pub qos : QoS
  pub no_local : Bool
  pub retain_as_published : Bool
  pub retain_handling : Int
}

///|
pub fn SubscribeTopic::new(filter : String, qos : QoS) -> SubscribeTopic {
  SubscribeTopic::{
    filter: filter,
    qos: qos,
    no_local: false,
    retain_as_published: false,
    retain_handling: 0,
  }
}

///|
pub struct SubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[SubscribeTopic]
}

///|
pub struct SubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct UnsubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[String]
}

///|
pub struct UnsubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct DisconnectPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct AuthPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub enum Packet {
  Connect(ConnectPacket)
  ConnAck(ConnAckPacket)
  Publish(PublishPacket)
  PubAck(PubAckPacket)
  PubRec(PubRecPacket)
  PubRel(PubRelPacket)
  PubComp(PubCompPacket)
  Subscribe(SubscribePacket)
  SubAck(SubAckPacket)
  Unsubscribe(UnsubscribePacket)
  UnsubAck(UnsubAckPacket)
  PingReq
  PingResp
  Disconnect(DisconnectPacket)
  Auth(AuthPacket)
}

///|
pub fn encode_packet(
  packet : Packet,
  version : ProtocolVersion,
) -> Result[Bytes, MqttError] {
  let _ = packet
  let _ = version
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn decode_packet(
  data : Bytes,
  version : ProtocolVersion,
) -> Result[(Packet, Int), MqttError] {
  decode_packet_with_limits(data, version, MqttLimits::default())
}

///|
pub fn decode_packet_with_limits(
  data : Bytes,
  version : ProtocolVersion,
  limits : MqttLimits,
) -> Result[(Packet, Int), MqttError] {
  let _ = data
  let _ = version
  let _ = limits
  Err(MqttError::ProtocolViolation("stub"))
}
