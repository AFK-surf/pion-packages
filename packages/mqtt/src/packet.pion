///| OASIS MQTT 3.1.1 & 5.0 Control Packets (all 15 packet types) and wire codec.

///|
pub struct Will {
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub payload : Bytes
  pub properties : Properties
}

///|
pub fn Will::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
) -> Will {
  Will::{
    qos: qos,
    retain: retain,
    topic: topic,
    payload: payload,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnectPacket {
  pub protocol_version : ProtocolVersion
  pub client_id : String
  pub clean_start : Bool
  pub keep_alive : Int
  pub username : Option[String]
  pub password : Option[Bytes]
  pub will : Option[Will]
  pub properties : Properties
}

///|
pub fn ConnectPacket::new(
  version : ProtocolVersion,
  client_id : String,
) -> ConnectPacket {
  ConnectPacket::{
    protocol_version: version,
    client_id: client_id,
    clean_start: true,
    keep_alive: 60,
    username: None,
    password: None,
    will: None,
    properties: Properties::empty(),
  }
}

///|
pub struct ConnAckPacket {
  pub session_present : Bool
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PublishPacket {
  pub dup : Bool
  pub qos : QoS
  pub retain : Bool
  pub topic : String
  pub packet_id : Option[Int]
  pub properties : Properties
  pub payload : Bytes
}

///|
pub fn PublishPacket::new(
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
  packet_id : Option[Int],
) -> PublishPacket {
  PublishPacket::{
    dup: false,
    qos: qos,
    retain: retain,
    topic: topic,
    packet_id: packet_id,
    properties: Properties::empty(),
    payload: payload,
  }
}

///|
pub struct PubAckPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRecPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubRelPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct PubCompPacket {
  pub packet_id : Int
  pub reason_code : Int
  pub properties : Properties
}

///|
pub val struct SubscribeTopic {
  pub filter : String
  pub qos : QoS
  pub no_local : Bool
  pub retain_as_published : Bool
  pub retain_handling : Int
}

///|
pub fn SubscribeTopic::new(filter : String, qos : QoS) -> SubscribeTopic {
  SubscribeTopic::{
    filter: filter,
    qos: qos,
    no_local: false,
    retain_as_published: false,
    retain_handling: 0,
  }
}

///|
pub struct SubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[SubscribeTopic]
}

///|
pub struct SubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct UnsubscribePacket {
  pub packet_id : Int
  pub properties : Properties
  pub topics : Array[String]
}

///|
pub struct UnsubAckPacket {
  pub packet_id : Int
  pub properties : Properties
  pub reason_codes : Array[Int]
}

///|
pub struct DisconnectPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub struct AuthPacket {
  pub reason_code : Int
  pub properties : Properties
}

///|
pub enum Packet {
  Connect(ConnectPacket)
  ConnAck(ConnAckPacket)
  Publish(PublishPacket)
  PubAck(PubAckPacket)
  PubRec(PubRecPacket)
  PubRel(PubRelPacket)
  PubComp(PubCompPacket)
  Subscribe(SubscribePacket)
  SubAck(SubAckPacket)
  Unsubscribe(UnsubscribePacket)
  UnsubAck(UnsubAckPacket)
  PingReq
  PingResp
  Disconnect(DisconnectPacket)
  Auth(AuthPacket)
}

///| Helper to wrap a fixed header byte + encoded body buffer into final wire `Bytes`.
fn finish_packet(header_byte : Int, body : ByteBuf) -> Result[Bytes, MqttError] {
  let rem_len = body.len
  let vbi_len = vbi_encoded_len(rem_len)
  if vbi_len == 0 {
    return Err(MqttError::MalformedVbi)
  }
  let out = Bytes::new(1 + vbi_len + rem_len)
  out[0] = (header_byte & 0xFF).to_byte()
  let mut x = rem_len
  let mut i = 1
  while i <= vbi_len {
    let mut b = x & 0x7F
    x = x >> 7
    if x > 0 {
      b = b | 0x80
    }
    out[i] = b.to_byte()
    i = i + 1
  }
  if rem_len > 0 {
    copy_bytes(out, 1 + vbi_len, body.data, 0, rem_len)
  }
  Ok(out)
}

///| Encode PUBACK / PUBREC / PUBREL / PUBCOMP uniformly.
fn encode_ack_packet(
  header_byte : Int,
  packet_id : Int,
  reason_code : Int,
  props : Properties,
  version : ProtocolVersion,
  pt : PacketType,
  ctx : PropertyContext,
) -> Result[Bytes, MqttError] {
  if packet_id < 1 || packet_id > 65535 {
    return Err(MqttError::InvalidPacketId)
  }
  if version is ProtocolVersion::V5 && !is_valid_reason_code(pt, reason_code) {
    return Err(MqttError::InvalidReasonCode(reason_code))
  }
  let body = ByteBuf::with_capacity(16)
  body.push_u16(packet_id)
  if version is ProtocolVersion::V5 {
    if reason_code != 0 || !props.is_empty() {
      body.push_u8(reason_code)
      if !props.is_empty() {
        match encode_properties(body, props, ctx) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
    }
  }
  finish_packet(header_byte, body)
}

///| Encode any MQTT 3.1.1 or MQTT 5.0 control packet to wire bytes.
pub fn encode_packet(
  packet : Packet,
  version : ProtocolVersion,
) -> Result[Bytes, MqttError] {
  match packet {
    Packet::Connect(c) => {
      let body = ByteBuf::with_capacity(64)
      // Protocol Name "MQTT"
      body.push_u16(4)
      body.push_u8(0x4D)
      body.push_u8(0x51)
      body.push_u8(0x54)
      body.push_u8(0x54)
      let ver_byte = match c.protocol_version {
        ProtocolVersion::V311 => 4
        ProtocolVersion::V5 => 5
      }
      body.push_u8(ver_byte)
      let has_user = !(c.username is None)
      let has_pass = !(c.password is None)
      if c.protocol_version is ProtocolVersion::V311 && has_pass && !has_user {
        return Err(MqttError::InvalidConnectFlags(0x40))
      }
      let mut flags = 0
      if c.clean_start {
        flags = flags | 0x02
      }
      match c.will {
        Some(w) => {
          flags = flags | 0x04 | ((qos_to_int(w.qos) & 0x03) << 3)
          if w.retain {
            flags = flags | 0x20
          }
        }
        None => ()
      }
      if has_pass {
        flags = flags | 0x40
      }
      if has_user {
        flags = flags | 0x80
      }
      body.push_u8(flags)
      if c.keep_alive < 0 || c.keep_alive > 65535 {
        return Err(MqttError::ProtocolViolation("keep_alive out of range"))
      }
      body.push_u16(c.keep_alive)
      if c.protocol_version is ProtocolVersion::V5 {
        match encode_properties(body, c.properties, PropertyContext::Connect) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      match body.push_mqtt_str(c.client_id) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match c.will {
        Some(w) => {
          if c.protocol_version is ProtocolVersion::V5 {
            match encode_properties(body, w.properties, PropertyContext::Will) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
          match validate_topic_name(w.topic) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match body.push_mqtt_str(w.topic) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match body.push_bin_data(w.payload) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
      match c.username {
        Some(u) =>
        match body.push_mqtt_str(u) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        None => ()
      }
      match c.password {
        Some(pw) =>
        match body.push_bin_data(pw) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        None => ()
      }
      finish_packet(0x10, body)
    }
    Packet::ConnAck(ca) => {
      if version is ProtocolVersion::V311 {
        if ca.reason_code < 0 || ca.reason_code > 5 {
          return Err(MqttError::InvalidReasonCode(ca.reason_code))
        }
      } else {
        if !is_valid_reason_code(PacketType::ConnAck, ca.reason_code) {
          return Err(MqttError::InvalidReasonCode(ca.reason_code))
        }
      }
      if ca.session_present && ca.reason_code != 0 {
        return Err(
          MqttError::ProtocolViolation(
            "CONNACK session_present must be 0 when reason code is non-zero",
          ),
        )
      }
      let body = ByteBuf::with_capacity(32)
      body.push_u8(if ca.session_present { 1 } else { 0 })
      body.push_u8(ca.reason_code)
      if version is ProtocolVersion::V5 {
        match encode_properties(body, ca.properties, PropertyContext::ConnAck) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      finish_packet(0x20, body)
    }
    Packet::Publish(p) => {
      let q = qos_to_int(p.qos)
      if q == 0 && p.dup {
        return Err(MqttError::InvalidFlags(3, 0x08))
      }
      let has_alias = !(p.properties.topic_alias is None)
      if p.topic.length() == 0 {
        if !(version is ProtocolVersion::V5 && has_alias) {
          return Err(MqttError::InvalidTopicName("empty topic name"))
        }
      } else {
        match validate_topic_name(p.topic) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      let mut hdr = 0x30 | (q << 1)
      if p.dup {
        hdr = hdr | 0x08
      }
      if p.retain {
        hdr = hdr | 0x01
      }
      let body = ByteBuf::with_capacity(32 + p.topic.length() + p.payload.length())
      match body.push_mqtt_str(p.topic) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if q > 0 {
        match p.packet_id {
          Some(pid) => {
            if pid < 1 || pid > 65535 {
              return Err(MqttError::InvalidPacketId)
            }
            body.push_u16(pid)
          }
          None => return Err(MqttError::InvalidPacketId)
        }
      }
      if version is ProtocolVersion::V5 {
        match encode_properties(body, p.properties, PropertyContext::Publish) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      body.push_bytes(p.payload)
      finish_packet(hdr, body)
    }
    Packet::PubAck(a) =>
    encode_ack_packet(0x40, a.packet_id, a.reason_code, a.properties, version, PacketType::PubAck, PropertyContext::PubAck)
    Packet::PubRec(a) =>
    encode_ack_packet(0x50, a.packet_id, a.reason_code, a.properties, version, PacketType::PubRec, PropertyContext::PubRec)
    Packet::PubRel(a) =>
    encode_ack_packet(0x62, a.packet_id, a.reason_code, a.properties, version, PacketType::PubRel, PropertyContext::PubRel)
    Packet::PubComp(a) =>
    encode_ack_packet(0x70, a.packet_id, a.reason_code, a.properties, version, PacketType::PubComp, PropertyContext::PubComp)
    Packet::Subscribe(s) => {
      if s.packet_id < 1 || s.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      if s.topics.length() == 0 {
        return Err(MqttError::ProtocolViolation("SUBSCRIBE must contain at least one topic"))
      }
      let body = ByteBuf::with_capacity(64)
      body.push_u16(s.packet_id)
      if version is ProtocolVersion::V5 {
        match encode_properties(body, s.properties, PropertyContext::Subscribe) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      let mut i = 0
      while i < s.topics.length() {
        let t = s.topics[i]
        match validate_topic_filter_for_version(t.filter, version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if version is ProtocolVersion::V5 && t.no_local && is_shared_subscription_filter(t.filter) {
          return Err(
            MqttError::ProtocolViolation(
              "No Local option MUST NOT be set on a Shared Subscription",
            ),
          )
        }
        match body.push_mqtt_str(t.filter) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let mut opts = qos_to_int(t.qos) & 0x03
        if version is ProtocolVersion::V5 {
          if t.retain_handling < 0 || t.retain_handling > 2 {
            return Err(MqttError::ProtocolViolation("retain_handling must be 0..2"))
          }
          if t.no_local {
            opts = opts | 0x04
          }
          if t.retain_as_published {
            opts = opts | 0x08
          }
          opts = opts | ((t.retain_handling & 0x03) << 4)
        }
        body.push_u8(opts)
        i = i + 1
      }
      finish_packet(0x82, body)
    }
    Packet::SubAck(sa) => {
      if sa.packet_id < 1 || sa.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      if sa.reason_codes.length() == 0 {
        return Err(MqttError::ProtocolViolation("SUBACK must contain at least one reason code"))
      }
      let body = ByteBuf::with_capacity(16 + sa.reason_codes.length())
      body.push_u16(sa.packet_id)
      if version is ProtocolVersion::V5 {
        match encode_properties(body, sa.properties, PropertyContext::SubAck) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      let mut i = 0
      while i < sa.reason_codes.length() {
        let rc = sa.reason_codes[i]
        if version is ProtocolVersion::V311 {
          if rc != 0x00 && rc != 0x01 && rc != 0x02 && rc != 0x80 {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        } else {
          if !is_valid_reason_code(PacketType::SubAck, rc) {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        }
        body.push_u8(rc)
        i = i + 1
      }
      finish_packet(0x90, body)
    }
    Packet::Unsubscribe(u) => {
      if u.packet_id < 1 || u.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      if u.topics.length() == 0 {
        return Err(MqttError::ProtocolViolation("UNSUBSCRIBE must contain at least one topic"))
      }
      let body = ByteBuf::with_capacity(64)
      body.push_u16(u.packet_id)
      if version is ProtocolVersion::V5 {
        match encode_properties(body, u.properties, PropertyContext::Unsubscribe) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      let mut i = 0
      while i < u.topics.length() {
        match validate_topic_filter_for_version(u.topics[i], version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match body.push_mqtt_str(u.topics[i]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      finish_packet(0xA2, body)
    }
    Packet::UnsubAck(ua) => {
      if ua.packet_id < 1 || ua.packet_id > 65535 {
        return Err(MqttError::InvalidPacketId)
      }
      if version is ProtocolVersion::V5 && ua.reason_codes.length() == 0 {
        return Err(MqttError::ProtocolViolation("v5 UNSUBACK must contain at least one reason code"))
      }
      let body = ByteBuf::with_capacity(16 + ua.reason_codes.length())
      body.push_u16(ua.packet_id)
      if version is ProtocolVersion::V5 {
        match encode_properties(body, ua.properties, PropertyContext::UnsubAck) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let mut i = 0
        while i < ua.reason_codes.length() {
          let rc = ua.reason_codes[i]
          if !is_valid_reason_code(PacketType::UnsubAck, rc) {
            return Err(MqttError::InvalidReasonCode(rc))
          }
          body.push_u8(rc)
          i = i + 1
        }
      }
      finish_packet(0xB0, body)
    }
    Packet::PingReq => {
      let mut out = Bytes::new(2)
      out[0] = 0xC0.to_byte()
      out[1] = 0x00.to_byte()
      Ok(out)
    }
    Packet::PingResp => {
      let mut out = Bytes::new(2)
      out[0] = 0xD0.to_byte()
      out[1] = 0x00.to_byte()
      Ok(out)
    }
    Packet::Disconnect(d) => {
      let body = ByteBuf::with_capacity(16)
      if version is ProtocolVersion::V5 {
        if !is_valid_reason_code(PacketType::Disconnect, d.reason_code) {
          return Err(MqttError::InvalidReasonCode(d.reason_code))
        }
        if d.reason_code != 0 || !d.properties.is_empty() {
          body.push_u8(d.reason_code)
          if !d.properties.is_empty() {
            match encode_properties(body, d.properties, PropertyContext::Disconnect) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
        }
      }
      finish_packet(0xE0, body)
    }
    Packet::Auth(a) => {
      if !(version is ProtocolVersion::V5) {
        return Err(MqttError::ProtocolViolation("AUTH packet is MQTT 5.0 only"))
      }
      if !is_valid_reason_code(PacketType::Auth, a.reason_code) {
        return Err(MqttError::InvalidReasonCode(a.reason_code))
      }
      let body = ByteBuf::with_capacity(32)
      if a.reason_code != 0 || !a.properties.is_empty() {
        body.push_u8(a.reason_code)
        if !a.properties.is_empty() {
          match encode_properties(body, a.properties, PropertyContext::Auth) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
      }
      finish_packet(0xF0, body)
    }
  }
}

///| Decode an ACK-shaped packet (PUBACK, PUBREC, PUBREL, PUBCOMP).
fn decode_ack_body(
  data : Bytes,
  start : Int,
  end : Int,
  version : ProtocolVersion,
  pt : PacketType,
  ctx : PropertyContext,
  max_props : Int,
) -> Result[(Int, Int, Properties), MqttError] {
  let (pid, p1) = match read_u16(data, start, end) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if pid == 0 {
    return Err(MqttError::InvalidPacketId)
  }
  if version is ProtocolVersion::V311 {
    if p1 != end {
      return Err(MqttError::TrailingBytes(end - p1))
    }
    return Ok((pid, 0, Properties::empty()))
  }
  if p1 == end {
    return Ok((pid, 0, Properties::empty()))
  }
  let (rc, p2) = match read_u8(data, p1, end) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if !is_valid_reason_code(pt, rc) {
    return Err(MqttError::InvalidReasonCode(rc))
  }
  if p2 == end {
    return Ok((pid, rc, Properties::empty()))
  }
  let (props, p3) = match decode_properties(data, p2, end, ctx, max_props) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if p3 != end {
    return Err(MqttError::TrailingBytes(end - p3))
  }
  Ok((pid, rc, props))
}

///| Decode a single MQTT packet from `data` starting at byte offset `offset`.
fn decode_packet_at(
  data : Bytes,
  offset : Int,
  data_end : Int,
  version : ProtocolVersion,
  limits : MqttLimits,
) -> Result[(Packet, Int), MqttError] {
  if offset >= data_end {
    return Err(MqttError::Incomplete)
  }
  let b0 = data[offset].to_int()
  let ptype = (b0 >> 4) & 0x0F
  let flags = b0 & 0x0F
  match validate_fixed_header_flags(ptype, flags) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if ptype == 15 && !(version is ProtocolVersion::V5) {
    return Err(MqttError::ProtocolViolation("AUTH packet is MQTT 5.0 only"))
  }
  let (rem_len, vbi_len) = match decode_vbi(data, offset + 1) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if offset + 1 + vbi_len > data_end {
    return Err(MqttError::Incomplete)
  }
  let total_len = 1 + vbi_len + rem_len
  if total_len > limits.max_packet_size {
    return Err(MqttError::PacketTooLarge(total_len, limits.max_packet_size))
  }
  let body_start = offset + 1 + vbi_len
  let body_end = body_start + rem_len
  if body_end > data_end {
    return Err(MqttError::Incomplete)
  }
  match ptype {
    1 => {
      // CONNECT
      let (proto_name, p1) = match read_mqtt_str(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if proto_name != "MQTT" {
        return Err(MqttError::InvalidProtocolName(proto_name))
      }
      let (ver_byte, p2) = match read_u8(data, p1, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let conn_ver = if ver_byte == 4 {
        ProtocolVersion::V311
      } else if ver_byte == 5 {
        ProtocolVersion::V5
      } else {
        return Err(MqttError::UnsupportedProtocolVersion(ver_byte))
      }
      let (cflags, p3) = match read_u8(data, p2, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if (cflags & 0x01) != 0 {
        return Err(MqttError::InvalidConnectFlags(cflags))
      }
      let clean_start = (cflags & 0x02) != 0
      let will_flag = (cflags & 0x04) != 0
      let will_qos_raw = (cflags >> 3) & 0x03
      let will_retain = (cflags & 0x20) != 0
      let pass_flag = (cflags & 0x40) != 0
      let user_flag = (cflags & 0x80) != 0
      if !will_flag && (will_qos_raw != 0 || will_retain) {
        return Err(MqttError::InvalidConnectFlags(cflags))
      }
      let will_qos = match qos_from_int(will_qos_raw) {
        Ok(q) => q
        Err(e) => return Err(e)
      }
      if conn_ver is ProtocolVersion::V311 && pass_flag && !user_flag {
        return Err(MqttError::InvalidConnectFlags(cflags))
      }
      let (keep_alive, p4) = match read_u16(data, p3, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let mut p = p4
      let conn_props = if conn_ver is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::Connect, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      let (client_id, p5) = match read_mqtt_str(data, p, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      p = p5
      let will_opt : Option[Will] = if will_flag {
        let w_props = if conn_ver is ProtocolVersion::V5 {
          let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::Will, limits.max_properties) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          p = np
          pr
        } else {
          Properties::empty()
        }
        let (w_topic, np1) = match read_mqtt_str(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        match validate_topic_name(w_topic) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let (w_payload, np2) = match read_bin_data(data, np1, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np2
        Some(Will::{
          qos: will_qos,
          retain: will_retain,
          topic: w_topic,
          payload: w_payload,
          properties: w_props,
        })
      } else {
        None
      }
      let username : Option[String] = if user_flag {
        let (u, np) = match read_mqtt_str(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        Some(u)
      } else {
        None
      }
      let password : Option[Bytes] = if pass_flag {
        let (pw, np) = match read_bin_data(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        Some(pw)
      } else {
        None
      }
      if p != body_end {
        return Err(MqttError::TrailingBytes(body_end - p))
      }
      Ok((
        Packet::Connect(ConnectPacket::{
          protocol_version: conn_ver,
          client_id: client_id,
          clean_start: clean_start,
          keep_alive: keep_alive,
          username: username,
          password: password,
          will: will_opt,
          properties: conn_props,
        }),
        total_len,
      ))
    }
    2 => {
      // CONNACK
      let (ack_flags, p1) = match read_u8(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if (ack_flags & 0xFE) != 0 {
        return Err(MqttError::ProtocolViolation("reserved CONNACK acknowledge flags non-zero"))
      }
      let (rc, p2) = match read_u8(data, p1, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let session_present = (ack_flags & 0x01) != 0
      if version is ProtocolVersion::V311 {
        if rc > 5 {
          return Err(MqttError::InvalidReasonCode(rc))
        }
      } else {
        if !is_valid_reason_code(PacketType::ConnAck, rc) {
          return Err(MqttError::InvalidReasonCode(rc))
        }
      }
      if session_present && rc != 0 {
        return Err(
          MqttError::ProtocolViolation(
            "CONNACK session_present must be 0 when reason code is non-zero",
          ),
        )
      }
      let mut p = p2
      let props = if version is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::ConnAck, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      if p != body_end {
        return Err(MqttError::TrailingBytes(body_end - p))
      }
      Ok((
        Packet::ConnAck(ConnAckPacket::{
          session_present: session_present,
          reason_code: rc,
          properties: props,
        }),
        total_len,
      ))
    }
    3 => {
      // PUBLISH
      let dup = (flags & 0x08) != 0
      let qos_raw = (flags >> 1) & 0x03
      let retain = (flags & 0x01) != 0
      let qos = match qos_from_int(qos_raw) {
        Ok(q) => q
        Err(e) => return Err(e)
      }
      let (topic, p1) = match read_mqtt_str(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if topic.length() > limits.max_topic_len {
        return Err(MqttError::InvalidTopicName("topic exceeds max_topic_len"))
      }
      let mut p = p1
      let pid_opt : Option[Int] = if qos_raw > 0 {
        let (pid, np) = match read_u16(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if pid == 0 {
          return Err(MqttError::InvalidPacketId)
        }
        p = np
        Some(pid)
      } else {
        None
      }
      let props = if version is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::Publish, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      if topic.length() == 0 {
        if !(version is ProtocolVersion::V5 && !(props.topic_alias is None)) {
          return Err(MqttError::InvalidTopicName("empty topic without topic alias"))
        }
      } else {
        match validate_topic_name(topic) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      let payload = if p == body_end {
        Bytes::new(0)
      } else {
        data.slice(p, body_end)
      }
      Ok((
        Packet::Publish(PublishPacket::{
          dup: dup,
          qos: qos,
          retain: retain,
          topic: topic,
          packet_id: pid_opt,
          properties: props,
          payload: payload,
        }),
        total_len,
      ))
    }
    4 => {
      let (pid, rc, props) = match decode_ack_body(data, body_start, body_end, version, PacketType::PubAck, PropertyContext::PubAck, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      Ok((Packet::PubAck(PubAckPacket::{ packet_id: pid, reason_code: rc, properties: props }), total_len))
    }
    5 => {
      let (pid, rc, props) = match decode_ack_body(data, body_start, body_end, version, PacketType::PubRec, PropertyContext::PubRec, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      Ok((Packet::PubRec(PubRecPacket::{ packet_id: pid, reason_code: rc, properties: props }), total_len))
    }
    6 => {
      let (pid, rc, props) = match decode_ack_body(data, body_start, body_end, version, PacketType::PubRel, PropertyContext::PubRel, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      Ok((Packet::PubRel(PubRelPacket::{ packet_id: pid, reason_code: rc, properties: props }), total_len))
    }
    7 => {
      let (pid, rc, props) = match decode_ack_body(data, body_start, body_end, version, PacketType::PubComp, PropertyContext::PubComp, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      Ok((Packet::PubComp(PubCompPacket::{ packet_id: pid, reason_code: rc, properties: props }), total_len))
    }
    8 => {
      // SUBSCRIBE
      let (pid, p1) = match read_u16(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if pid == 0 {
        return Err(MqttError::InvalidPacketId)
      }
      let mut p = p1
      let props = if version is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::Subscribe, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      let topics : Array[SubscribeTopic] = []
      while p < body_end {
        if topics.length() >= limits.max_subscriptions {
          return Err(MqttError::ProtocolViolation("max_subscriptions exceeded"))
        }
        let (filter, np1) = match read_mqtt_str(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        match validate_topic_filter_for_version(filter, version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let (opts, np2) = match read_u8(data, np1, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        let qos = match qos_from_int(opts & 0x03) {
          Ok(q) => q
          Err(e) => return Err(e)
        }
        if version is ProtocolVersion::V311 {
          if (opts & 0xFC) != 0 {
            return Err(MqttError::ProtocolViolation("reserved v3.1.1 subscribe options non-zero"))
          }
          topics.push(SubscribeTopic::new(filter, qos))
        } else {
          if (opts & 0xC0) != 0 {
            return Err(MqttError::ProtocolViolation("reserved v5 subscribe options non-zero"))
          }
          let rh = (opts >> 4) & 0x03
          if rh == 3 {
            return Err(MqttError::ProtocolViolation("invalid retain_handling 3"))
          }
          let no_local = (opts & 0x04) != 0
          if no_local && is_shared_subscription_filter(filter) {
            return Err(
              MqttError::ProtocolViolation(
                "No Local option MUST NOT be set on a Shared Subscription",
              ),
            )
          }
          topics.push(SubscribeTopic::{
            filter: filter,
            qos: qos,
            no_local: no_local,
            retain_as_published: (opts & 0x08) != 0,
            retain_handling: rh,
          })
        }
        p = np2
      }
      if topics.length() == 0 {
        return Err(MqttError::ProtocolViolation("SUBSCRIBE has no topic filters"))
      }
      Ok((
        Packet::Subscribe(SubscribePacket::{
          packet_id: pid,
          properties: props,
          topics: topics,
        }),
        total_len,
      ))
    }
    9 => {
      // SUBACK
      let (pid, p1) = match read_u16(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if pid == 0 {
        return Err(MqttError::InvalidPacketId)
      }
      let mut p = p1
      let props = if version is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::SubAck, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      let rcs : Array[Int] = []
      while p < body_end {
        let rc = data[p].to_int()
        if version is ProtocolVersion::V311 {
          if rc != 0x00 && rc != 0x01 && rc != 0x02 && rc != 0x80 {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        } else {
          if !is_valid_reason_code(PacketType::SubAck, rc) {
            return Err(MqttError::InvalidReasonCode(rc))
          }
        }
        rcs.push(rc)
        p = p + 1
      }
      if rcs.length() == 0 {
        return Err(MqttError::ProtocolViolation("SUBACK has no return codes"))
      }
      Ok((
        Packet::SubAck(SubAckPacket::{
          packet_id: pid,
          properties: props,
          reason_codes: rcs,
        }),
        total_len,
      ))
    }
    10 => {
      // UNSUBSCRIBE
      let (pid, p1) = match read_u16(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if pid == 0 {
        return Err(MqttError::InvalidPacketId)
      }
      let mut p = p1
      let props = if version is ProtocolVersion::V5 {
        let (pr, np) = match decode_properties(data, p, body_end, PropertyContext::Unsubscribe, limits.max_properties) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        p = np
        pr
      } else {
        Properties::empty()
      }
      let topics : Array[String] = []
      while p < body_end {
        if topics.length() >= limits.max_subscriptions {
          return Err(MqttError::ProtocolViolation("max_subscriptions exceeded"))
        }
        let (filter, np) = match read_mqtt_str(data, p, body_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        match validate_topic_filter_for_version(filter, version) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        topics.push(filter)
        p = np
      }
      if topics.length() == 0 {
        return Err(MqttError::ProtocolViolation("UNSUBSCRIBE has no topic filters"))
      }
      Ok((
        Packet::Unsubscribe(UnsubscribePacket::{
          packet_id: pid,
          properties: props,
          topics: topics,
        }),
        total_len,
      ))
    }
    11 => {
      // UNSUBACK
      let (pid, p1) = match read_u16(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if pid == 0 {
        return Err(MqttError::InvalidPacketId)
      }
      if version is ProtocolVersion::V311 {
        if p1 != body_end {
          return Err(MqttError::TrailingBytes(body_end - p1))
        }
        return Ok((
          Packet::UnsubAck(UnsubAckPacket::{
            packet_id: pid,
            properties: Properties::empty(),
            reason_codes: [],
          }),
          total_len,
        ))
      }
      let (props, p2) = match decode_properties(data, p1, body_end, PropertyContext::UnsubAck, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let rcs : Array[Int] = []
      let mut p = p2
      while p < body_end {
        let rc = data[p].to_int()
        if !is_valid_reason_code(PacketType::UnsubAck, rc) {
          return Err(MqttError::InvalidReasonCode(rc))
        }
        rcs.push(rc)
        p = p + 1
      }
      if rcs.length() == 0 {
        return Err(MqttError::ProtocolViolation("v5 UNSUBACK must contain reason codes"))
      }
      Ok((
        Packet::UnsubAck(UnsubAckPacket::{
          packet_id: pid,
          properties: props,
          reason_codes: rcs,
        }),
        total_len,
      ))
    }
    12 => {
      if rem_len != 0 {
        return Err(MqttError::TrailingBytes(rem_len))
      }
      Ok((Packet::PingReq, total_len))
    }
    13 => {
      if rem_len != 0 {
        return Err(MqttError::TrailingBytes(rem_len))
      }
      Ok((Packet::PingResp, total_len))
    }
    14 => {
      // DISCONNECT
      if version is ProtocolVersion::V311 {
        if rem_len != 0 {
          return Err(MqttError::TrailingBytes(rem_len))
        }
        return Ok((
          Packet::Disconnect(DisconnectPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
          total_len,
        ))
      }
      if rem_len == 0 {
        return Ok((
          Packet::Disconnect(DisconnectPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
          total_len,
        ))
      }
      let (rc, p1) = match read_u8(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if !is_valid_reason_code(PacketType::Disconnect, rc) {
        return Err(MqttError::InvalidReasonCode(rc))
      }
      if p1 == body_end {
        return Ok((
          Packet::Disconnect(DisconnectPacket::{
            reason_code: rc,
            properties: Properties::empty(),
          }),
          total_len,
        ))
      }
      let (props, p2) = match decode_properties(data, p1, body_end, PropertyContext::Disconnect, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if p2 != body_end {
        return Err(MqttError::TrailingBytes(body_end - p2))
      }
      Ok((
        Packet::Disconnect(DisconnectPacket::{ reason_code: rc, properties: props }),
        total_len,
      ))
    }
    15 => {
      // AUTH (v5 only)
      if rem_len == 0 {
        return Ok((
          Packet::Auth(AuthPacket::{
            reason_code: 0,
            properties: Properties::empty(),
          }),
          total_len,
        ))
      }
      let (rc, p1) = match read_u8(data, body_start, body_end) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if !is_valid_reason_code(PacketType::Auth, rc) {
        return Err(MqttError::InvalidReasonCode(rc))
      }
      if p1 == body_end {
        return Ok((
          Packet::Auth(AuthPacket::{
            reason_code: rc,
            properties: Properties::empty(),
          }),
          total_len,
        ))
      }
      let (props, p2) = match decode_properties(data, p1, body_end, PropertyContext::Auth, limits.max_properties) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if p2 != body_end {
        return Err(MqttError::TrailingBytes(body_end - p2))
      }
      Ok((Packet::Auth(AuthPacket::{ reason_code: rc, properties: props }), total_len))
    }
    _ => Err(MqttError::InvalidPacketType(ptype))
  }
}

///| Decode one MQTT packet from the beginning of `data` using default limits.
pub fn decode_packet(
  data : Bytes,
  version : ProtocolVersion,
) -> Result[(Packet, Int), MqttError] {
  decode_packet_at(data, 0, data.length(), version, MqttLimits::default())
}

///| Decode one MQTT packet from the beginning of `data` using custom `MqttLimits`.
pub fn decode_packet_with_limits(
  data : Bytes,
  version : ProtocolVersion,
  limits : MqttLimits,
) -> Result[(Packet, Int), MqttError] {
  decode_packet_at(data, 0, data.length(), version, limits)
}
