///| OASIS MQTT 3.1.1 & 5.0 Topic Name, Topic Filter, Shared Subscription, and matching rules.

///|
pub val struct SharedSubscription {
  pub share_name : String
  pub filter : String
}

///| Validate an MQTT Topic Name (OASIS §4.7.1: non-empty, <= 65535B, valid UTF-8, no `+` or `#`).
pub fn validate_topic_name(topic : String) -> Result[Unit, MqttError] {
  if is_valid_mqtt_topic_str(topic) {
    return Ok(())
  }
  Err(MqttError::InvalidTopicName(topic))
}

///| Validate syntax of a standard (non-shared) topic filter whose UTF-8 has already been verified.
fn validate_plain_filter_syntax_only(
  s : String,
  start : Int,
  end : Int,
  raw : String,
) -> Result[Unit, MqttError] {
  let n = end - start
  if n == 0 || n > 65535 {
    return Err(MqttError::InvalidTopicFilter(raw))
  }
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x23 {
      if i + 1 != end {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i > start && s.code_unit_at(i - 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    } else if c == 0x2B {
      if i > start && s.code_unit_at(i - 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i + 1 < end && s.code_unit_at(i + 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Validate a topic filter whose UTF-8 has already been verified during wire decoding.
fn validate_decoded_filter_for_version(
  filter : String,
  version : ProtocolVersion,
) -> Result[Unit, MqttError] {
  let n = filter.length()
  if version is ProtocolVersion::V311 || !is_shared_subscription_filter(filter) {
    return validate_plain_filter_syntax_only(filter, 0, n, filter)
  }
  // Shared subscription `$share/{ShareName}/{filter}` (UTF-8 already validated)
  let mut slash = -1
  let mut i = 7
  while i < n {
    let c = filter.code_unit_at(i)
    if c == 0x2F {
      slash = i
      break
    }
    if c == 0x2B || c == 0x23 {
      return Err(MqttError::InvalidSharedSubscription(filter))
    }
    i = i + 1
  }
  if slash <= 7 || slash + 1 >= n {
    return Err(MqttError::InvalidSharedSubscription(filter))
  }
  validate_plain_filter_syntax_only(filter, slash + 1, n, filter.slice(slash + 1, n))
}

///| Validate a standard (non-shared) topic filter `String` slice `[start, end)` without `to_bytes()`.
fn validate_plain_filter_str(
  s : String,
  start : Int,
  end : Int,
  raw : String,
) -> Result[Unit, MqttError] {
  let n = end - start
  if n == 0 || n > 65535 {
    return Err(MqttError::InvalidTopicFilter(raw))
  }
  if !is_valid_mqtt_utf8_str_range(s, start, end) {
    return Err(MqttError::InvalidTopicFilter(raw))
  }
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x23 {
      // '#' must be the last character and either sole char or preceded by '/'
      if i + 1 != end {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i > start && s.code_unit_at(i - 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    } else if c == 0x2B {
      // '+' must occupy an entire level
      if i > start && s.code_unit_at(i - 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i + 1 < end && s.code_unit_at(i + 1) != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Parse MQTT 5.0 Shared Subscription `$share/{ShareName}/{filter}` (OASIS §4.8.2).
///| Returns `Ok(None)` if `filter` does not begin with `$share/`.
pub fn parse_shared_subscription(
  filter : String,
) -> Result[Option[SharedSubscription], MqttError] {
  let n = filter.length()
  // Check prefix "$share/" (7 bytes: 24 73 68 61 72 65 2F)
  if n < 7 ||
  filter.code_unit_at(0) != 0x24 ||
  filter.code_unit_at(1) != 0x73 ||
  filter.code_unit_at(2) != 0x68 ||
  filter.code_unit_at(3) != 0x61 ||
  filter.code_unit_at(4) != 0x72 ||
  filter.code_unit_at(5) != 0x65 ||
  filter.code_unit_at(6) != 0x2F {
    return Ok(None)
  }
  // Find slash separating ShareName and inner filter
  let mut slash = -1
  let mut i = 7
  while i < n {
    let c = filter.code_unit_at(i)
    if c == 0x2F {
      slash = i
      break
    }
    if c == 0x2B || c == 0x23 {
      return Err(MqttError::InvalidSharedSubscription(filter))
    }
    i = i + 1
  }
  if slash <= 7 || slash + 1 >= n {
    return Err(MqttError::InvalidSharedSubscription(filter))
  }
  if !is_valid_mqtt_utf8_str_range(filter, 7, slash) {
    return Err(MqttError::InvalidSharedSubscription(filter))
  }
  let inner_str = filter.slice(slash + 1, n)
  match validate_plain_filter_str(filter, slash + 1, n, inner_str) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let share_name = filter.slice(7, slash)
  Ok(Some(SharedSubscription::{ share_name: share_name, filter: inner_str }))
}

///| Check whether `filter` begins with the MQTT 5.0 shared subscription prefix `$share/`.
fn is_shared_subscription_filter(filter : String) -> Bool {
  filter.length() >= 7 &&
  filter.code_unit_at(0) == 0x24 &&
  filter.code_unit_at(1) == 0x73 &&
  filter.code_unit_at(2) == 0x68 &&
  filter.code_unit_at(3) == 0x61 &&
  filter.code_unit_at(4) == 0x72 &&
  filter.code_unit_at(5) == 0x65 &&
  filter.code_unit_at(6) == 0x2F
}

///| Validate an MQTT Topic Filter (including optional MQTT 5.0 `$share/{ShareName}/{filter}`).
pub fn validate_topic_filter(filter : String) -> Result[Unit, MqttError] {
  if !is_shared_subscription_filter(filter) {
    return validate_plain_filter_str(filter, 0, filter.length(), filter)
  }
  match parse_shared_subscription(filter) {
    Ok(Some(_)) => Ok(())
    Ok(None) => validate_plain_filter_str(filter, 0, filter.length(), filter)
    Err(e) => Err(e)
  }
}

///| Validate an MQTT Topic Filter according to `version` rules.
///| In MQTT 3.1.1, `$share/...` is an ordinary topic filter, not a shared subscription.
pub fn validate_topic_filter_for_version(
  filter : String,
  version : ProtocolVersion,
) -> Result[Unit, MqttError] {
  match version {
    ProtocolVersion::V311 => validate_plain_filter_str(filter, 0, filter.length(), filter)
    ProtocolVersion::V5 => validate_topic_filter(filter)
  }
}

///| Zero-allocation OASIS MQTT 3.1.1 & 5.0 topic filter matching (§4.7).
///| Enforces §4.7.2: topics starting with `$` never match filters starting with `#` or `+`.
pub fn topic_matches(filter : String, topic : String) -> Bool {
  let flen = filter.length()
  let tlen = topic.length()
  if flen == 0 || tlen == 0 {
    return false
  }
  // OASIS §4.7.2: topic beginning with '$' MUST NOT match filter beginning with '#' or '+'
  if topic.code_unit_at(0) == 0x24 &&
  (filter.code_unit_at(0) == 0x23 || filter.code_unit_at(0) == 0x2B) {
    return false
  }
  let mut fi = 0
  let mut ti = 0
  while fi < flen {
    let fc = filter.code_unit_at(fi)
    if fc == 0x23 {
      // '#' matches everything from here onward
      return fi + 1 == flen
    }
    if fc == 0x2B {
      // '+' matches a single level (up to next '/' or end of topic)
      while ti < tlen && topic.code_unit_at(ti) != 0x2F {
        ti = ti + 1
      }
      fi = fi + 1
      if fi == flen {
        return ti == tlen
      }
      // Next char in filter must be '/'
      if filter.code_unit_at(fi) != 0x2F {
        return false
      }
      if ti == tlen {
        // Filter has "/#" remaining? e.g. "+/#" matches "a"
        return fi + 2 == flen && filter.code_unit_at(fi + 1) == 0x23
      }
      // Both at '/'
      fi = fi + 1
      ti = ti + 1
      continue
    }
    // Literal level comparison
    while fi < flen && filter.code_unit_at(fi) != 0x2F {
      if ti >= tlen || filter.code_unit_at(fi) != topic.code_unit_at(ti) {
        return false
      }
      fi = fi + 1
      ti = ti + 1
    }
    if fi == flen {
      return ti == tlen
    }
    // filter[fi] == '/'
    if ti == tlen {
      // Filter has "/#" left -> matches parent topic without trailing slash!
      return fi + 2 == flen && filter.code_unit_at(fi + 1) == 0x23
    }
    if topic.code_unit_at(ti) != 0x2F {
      return false
    }
    fi = fi + 1
    ti = ti + 1
  }
  ti == tlen
}
