///| OASIS MQTT 3.1.1 & 5.0 Topic Name, Topic Filter, Shared Subscription, and matching rules.

///|
pub val struct SharedSubscription {
  pub share_name : String
  pub filter : String
}

///| Validate an MQTT Topic Name (OASIS §4.7.1: non-empty, <= 65535B, valid UTF-8, no `+` or `#`).
pub fn validate_topic_name(topic : String) -> Result[Unit, MqttError] {
  let b = topic.to_bytes()
  let n = b.length()
  if n == 0 || n > 65535 {
    return Err(MqttError::InvalidTopicName(topic))
  }
  match validate_mqtt_utf8_range(b, 0, n) {
    Ok(_) => ()
    Err(_) => return Err(MqttError::InvalidTopicName(topic))
  }
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 0x2B || c == 0x23 {
      // '+' or '#'
      return Err(MqttError::InvalidTopicName(topic))
    }
    i = i + 1
  }
  Ok(())
}

///| Validate a standard (non-shared) topic filter byte slice.
fn validate_plain_filter_bytes(
  b : Bytes,
  start : Int,
  end : Int,
  raw : String,
) -> Result[Unit, MqttError] {
  let n = end - start
  if n == 0 || n > 65535 {
    return Err(MqttError::InvalidTopicFilter(raw))
  }
  match validate_mqtt_utf8_range(b, start, end) {
    Ok(_) => ()
    Err(_) => return Err(MqttError::InvalidTopicFilter(raw))
  }
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c == 0x23 {
      // '#' must be the last character and either sole char or preceded by '/'
      if i + 1 != end {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i > start && b[i - 1].to_int() != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    } else if c == 0x2B {
      // '+' must occupy an entire level
      if i > start && b[i - 1].to_int() != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
      if i + 1 < end && b[i + 1].to_int() != 0x2F {
        return Err(MqttError::InvalidTopicFilter(raw))
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Parse MQTT 5.0 Shared Subscription `$share/{ShareName}/{filter}` (OASIS §4.8.2).
///| Returns `Ok(None)` if `filter` does not begin with `$share/`.
pub fn parse_shared_subscription(
  filter : String,
) -> Result[Option[SharedSubscription], MqttError] {
  let b = filter.to_bytes()
  let n = b.length()
  // Check prefix "$share/" (7 bytes: 24 73 68 61 72 65 2F)
  if n < 7 ||
  b[0].to_int() != 0x24 ||
  b[1].to_int() != 0x73 ||
  b[2].to_int() != 0x68 ||
  b[3].to_int() != 0x61 ||
  b[4].to_int() != 0x72 ||
  b[5].to_int() != 0x65 ||
  b[6].to_int() != 0x2F {
    return Ok(None)
  }
  // Find slash separating ShareName and inner filter
  let mut slash = -1
  let mut i = 7
  while i < n {
    let c = b[i].to_int()
    if c == 0x2F {
      slash = i
      break
    }
    if c == 0x2B || c == 0x23 {
      return Err(MqttError::InvalidSharedSubscription(filter))
    }
    i = i + 1
  }
  if slash <= 7 || slash + 1 >= n {
    return Err(MqttError::InvalidSharedSubscription(filter))
  }
  match validate_mqtt_utf8_range(b, 7, slash) {
    Ok(_) => ()
    Err(_) => return Err(MqttError::InvalidSharedSubscription(filter))
  }
  let inner_str = b.slice(slash + 1, n).to_string()
  match validate_plain_filter_bytes(b, slash + 1, n, inner_str) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let share_name = b.slice(7, slash).to_string()
  Ok(Some(SharedSubscription::{ share_name: share_name, filter: inner_str }))
}

///| Check whether `filter` begins with the MQTT 5.0 shared subscription prefix `$share/`.
fn is_shared_subscription_filter(filter : String) -> Bool {
  let b = filter.to_bytes()
  b.length() >= 7 &&
  b[0].to_int() == 0x24 &&
  b[1].to_int() == 0x73 &&
  b[2].to_int() == 0x68 &&
  b[3].to_int() == 0x61 &&
  b[4].to_int() == 0x72 &&
  b[5].to_int() == 0x65 &&
  b[6].to_int() == 0x2F
}

///| Validate an MQTT Topic Filter (including optional MQTT 5.0 `$share/{ShareName}/{filter}`).
pub fn validate_topic_filter(filter : String) -> Result[Unit, MqttError] {
  match parse_shared_subscription(filter) {
    Ok(Some(_)) => Ok(())
    Ok(None) => {
      let b = filter.to_bytes()
      validate_plain_filter_bytes(b, 0, b.length(), filter)
    }
    Err(e) => Err(e)
  }
}

///| Validate an MQTT Topic Filter according to `version` rules.
///| In MQTT 3.1.1, `$share/...` is an ordinary topic filter, not a shared subscription.
pub fn validate_topic_filter_for_version(
  filter : String,
  version : ProtocolVersion,
) -> Result[Unit, MqttError] {
  match version {
    ProtocolVersion::V311 => {
      let b = filter.to_bytes()
      validate_plain_filter_bytes(b, 0, b.length(), filter)
    }
    ProtocolVersion::V5 => validate_topic_filter(filter)
  }
}

///| Zero-allocation OASIS MQTT 3.1.1 & 5.0 topic filter matching (§4.7).
///| Enforces §4.7.2: topics starting with `$` never match filters starting with `#` or `+`.
pub fn topic_matches(filter : String, topic : String) -> Bool {
  let fb = filter.to_bytes()
  let tb = topic.to_bytes()
  let flen = fb.length()
  let tlen = tb.length()
  if flen == 0 || tlen == 0 {
    return false
  }
  // OASIS §4.7.2: topic beginning with '$' MUST NOT match filter beginning with '#' or '+'
  if tb[0].to_int() == 0x24 &&
  (fb[0].to_int() == 0x23 || fb[0].to_int() == 0x2B) {
    return false
  }
  let mut fi = 0
  let mut ti = 0
  while fi < flen {
    let fc = fb[fi].to_int()
    if fc == 0x23 {
      // '#' matches everything from here onward
      return fi + 1 == flen
    }
    if fc == 0x2B {
      // '+' matches a single level (up to next '/' or end of topic)
      while ti < tlen && tb[ti].to_int() != 0x2F {
        ti = ti + 1
      }
      fi = fi + 1
      if fi == flen {
        return ti == tlen
      }
      // Next char in filter must be '/'
      if fb[fi].to_int() != 0x2F {
        return false
      }
      if ti == tlen {
        // Filter has "/#" remaining? e.g. "+/#" matches "a"
        return fi + 2 == flen && fb[fi + 1].to_int() == 0x23
      }
      // Both at '/'
      fi = fi + 1
      ti = ti + 1
      continue
    }
    // Literal level comparison
    while fi < flen && fb[fi].to_int() != 0x2F {
      if ti >= tlen || fb[fi].to_int() != tb[ti].to_int() {
        return false
      }
      fi = fi + 1
      ti = ti + 1
    }
    if fi == flen {
      return ti == tlen
    }
    // fb[fi] == '/'
    if ti == tlen {
      // Filter has "/#" left -> matches parent topic without trailing slash!
      return fi + 2 == flen && fb[fi + 1].to_int() == 0x23
    }
    if tb[ti].to_int() != 0x2F {
      return false
    }
    fi = fi + 1
    ti = ti + 1
  }
  ti == tlen
}
