///| Streaming Sans-IO MQTT 3.1.1 & 5.0 incremental packet decoder.
///| Supports arbitrary fragmentation (1-byte drip) and sticky packets with O(1) amortized compaction.

///|
pub struct StreamDecoder {
  pub version : ProtocolVersion
  pub limits : MqttLimits
  mut buf : String
  mut head : Int
  mut tail : Int
  drip : StringBuilder
  mut drip_active : Bool
  cursor : DecodeCursor
}

///|
pub fn StreamDecoder::new(
  version : ProtocolVersion,
  limits : MqttLimits,
) -> StreamDecoder {
  StreamDecoder::{
    version: version,
    limits: limits,
    buf: "",
    head: 0,
    tail: 0,
    drip: StringBuilder::new(),
    drip_active: false,
    cursor: DecodeCursor::{ pos: 0, err: None },
  }
}

///|
pub fn StreamDecoder::default(version : ProtocolVersion) -> StreamDecoder {
  StreamDecoder::new(version, MqttLimits::default())
}

///| Return the number of unparsed bytes currently buffered.
pub fn StreamDecoder::buffered_len(self : StreamDecoder) -> Int {
  if self.drip_active {
    self.drip.length() - self.head
  } else {
    self.tail - self.head
  }
}

///| Reset the decoder buffer.
pub fn StreamDecoder::reset(self : StreamDecoder) -> Unit {
  self.buf = ""
  self.head = 0
  self.tail = 0
  if self.drip_active {
    self.drip.reset()
    self.drip_active = false
  }
}

///| Feed a chunk of network bytes into the streaming decoder.
///| Always copies into an internal owned buffer so caller buffer reuse cannot corrupt partial frames.
pub fn StreamDecoder::feed(self : StreamDecoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  if self.drip_active {
    self.drip.write_string(chunk.to_string())
    return ()
  }
  let unread = self.tail - self.head
  if unread == 0 {
    self.buf = chunk.to_string()
    self.head = 0
    self.tail = clen
    return ()
  }
  // Fast hardware-memcpy path for normal chunked reads with a small unread remainder.
  if clen >= 32 && unread <= 512 {
    let rem = if self.head == 0 && self.tail == self.buf.length() {
      self.buf
    } else {
      self.buf.slice(self.head, self.tail)
    }
    self.buf = rem + chunk.to_string()
    self.head = 0
    self.tail = unread + clen
    return ()
  }
  // Switch to O(1)-amortized StringBuilder for 1-byte drips or large fragmented frames.
  self.drip.reset()
  if self.head == 0 && self.tail == self.buf.length() {
    self.drip.write_string(self.buf)
  } else {
    self.drip.write_string(self.buf.slice(self.head, self.tail))
  }
  self.drip.write_string(chunk.to_string())
  self.buf = ""
  self.head = 0
  self.tail = 0
  self.drip_active = true
}

///| Decode the next complete packet from the buffer, or return `Ok(None)` if more bytes are needed.
pub fn StreamDecoder::next_packet(
  self : StreamDecoder,
) -> Result[Option[Packet], MqttError] {
  if self.drip_active {
    let dlen = self.drip.length()
    if self.head >= dlen {
      self.drip.reset()
      self.drip_active = false
      self.head = 0
      return Ok(None)
    }
    let s = self.drip.to_string()
    match decode_packet_str(s, self.head, dlen, self.version, self.limits, self.cursor) {
      Some(pkt) => {
        self.head = self.cursor.pos
        if self.head >= dlen {
          self.drip.reset()
          self.drip_active = false
          self.head = 0
        } else if self.head >= 4096 && self.head * 2 >= dlen {
          let rem = s.slice(self.head, dlen)
          self.drip.reset()
          self.drip.write_string(rem)
          self.head = 0
        }
        return Ok(Some(pkt))
      }
      None =>
      match self.cursor.err {
        Some(e) => {
          self.cursor.err = None
          return Err(e)
        }
        None => return Ok(None)
      }
    }
  }
  if self.head >= self.tail {
    return Ok(None)
  }
  match decode_packet_str(self.buf, self.head, self.tail, self.version, self.limits, self.cursor) {
    Some(pkt) => {
      self.head = self.cursor.pos
      if self.head >= self.tail {
        self.buf = ""
        self.head = 0
        self.tail = 0
      }
      Ok(Some(pkt))
    }
    None =>
    match self.cursor.err {
      Some(e) => {
        self.cursor.err = None
        Err(e)
      }
      None => Ok(None)
    }
  }
}

///| Decode all complete packets currently buffered.
pub fn StreamDecoder::drain(
  self : StreamDecoder,
) -> Result[Array[Packet], MqttError] {
  let out : Array[Packet] = []
  while true {
    match self.next_packet() {
      Ok(Some(pkt)) => out.push(pkt)
      Ok(None) => return Ok(out)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}
