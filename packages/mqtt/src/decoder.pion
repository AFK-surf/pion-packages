///| Streaming Sans-IO MQTT 3.1.1 & 5.0 incremental packet decoder.
///| Supports arbitrary fragmentation (1-byte drip) and sticky packets with O(1) amortized compaction.

///|
pub struct StreamDecoder {
  pub version : ProtocolVersion
  pub limits : MqttLimits
  mut buf : Bytes
  mut head : Int
  mut tail : Int
  mut owned : Bool
  empty : Bytes
}

///|
pub fn StreamDecoder::new(
  version : ProtocolVersion,
  limits : MqttLimits,
) -> StreamDecoder {
  let empty = Bytes::new(0)
  StreamDecoder::{
    version: version,
    limits: limits,
    buf: empty,
    head: 0,
    tail: 0,
    owned: false,
    empty: empty,
  }
}

///|
pub fn StreamDecoder::default(version : ProtocolVersion) -> StreamDecoder {
  StreamDecoder::new(version, MqttLimits::default())
}

///| Return the number of unparsed bytes currently buffered.
pub fn StreamDecoder::buffered_len(self : StreamDecoder) -> Int {
  self.tail - self.head
}

///| Reset the decoder buffer.
pub fn StreamDecoder::reset(self : StreamDecoder) -> Unit {
  self.buf = self.empty
  self.head = 0
  self.tail = 0
  self.owned = false
}

///| Feed a chunk of network bytes into the streaming decoder.
///| Always copies into an internal owned buffer so caller buffer reuse cannot corrupt partial frames.
pub fn StreamDecoder::feed(self : StreamDecoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  let unread = self.tail - self.head
  if unread == 0 {
    if self.owned && clen <= self.buf.length() {
      copy_bytes(self.buf, 0, chunk, 0, clen)
      self.head = 0
      self.tail = clen
      return ()
    }
    let mut cap = 128
    while cap < clen {
      cap = cap * 2
    }
    let nb = Bytes::new(cap)
    copy_bytes(nb, 0, chunk, 0, clen)
    self.buf = nb
    self.head = 0
    self.tail = clen
    self.owned = true
    return ()
  }
  // If we own a mutable buffer with enough tail space, append in place.
  if self.owned && self.tail + clen <= self.buf.length() {
    copy_bytes(self.buf, self.tail, chunk, 0, clen)
    self.tail = self.tail + clen
    return ()
  }
  // If we own a buffer and compacting makes room, compact in place.
  if self.owned && unread + clen <= self.buf.length() {
    copy_bytes(self.buf, 0, self.buf, self.head, unread)
    copy_bytes(self.buf, unread, chunk, 0, clen)
    self.head = 0
    self.tail = unread + clen
    return ()
  }
  // Allocate a new owned buffer sized with geometric growth.
  let need = unread + clen
  let mut cap = 128
  while cap < need {
    cap = cap * 2
  }
  let nb = Bytes::new(cap)
  copy_bytes(nb, 0, self.buf, self.head, unread)
  copy_bytes(nb, unread, chunk, 0, clen)
  self.buf = nb
  self.head = 0
  self.tail = need
  self.owned = true
}

///| Decode the next complete packet from the buffer, or return `Ok(None)` if more bytes are needed.
pub fn StreamDecoder::next_packet(
  self : StreamDecoder,
) -> Result[Option[Packet], MqttError] {
  let unread = self.tail - self.head
  if unread == 0 {
    return Ok(None)
  }
  match decode_packet_at(self.buf, self.head, self.tail, self.version, self.limits) {
    Ok((pkt, used)) => {
      self.head = self.head + used
      if self.head >= self.tail {
        self.head = 0
        self.tail = 0
        // Release oversized buffers when completely drained so memory stays bounded.
        if self.buf.length() > 65536 {
          self.buf = self.empty
          self.owned = false
        }
      } else if self.owned && self.head >= 4096 && self.head * 2 >= self.tail {
        let rem = self.tail - self.head
        copy_bytes(self.buf, 0, self.buf, self.head, rem)
        self.head = 0
        self.tail = rem
      }
      Ok(Some(pkt))
    }
    Err(MqttError::Incomplete) => Ok(None)
    Err(e) => Err(e)
  }
}

///| Decode all complete packets currently buffered.
pub fn StreamDecoder::drain(
  self : StreamDecoder,
) -> Result[Array[Packet], MqttError] {
  let out : Array[Packet] = []
  while true {
    match self.next_packet() {
      Ok(Some(pkt)) => out.push(pkt)
      Ok(None) => return Ok(out)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}
