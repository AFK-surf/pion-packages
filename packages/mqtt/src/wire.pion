///| Core MQTT 3.1.1 & 5.0 wire types, limits, error definitions, VBI, ByteBuf, and MQTT UTF-8 validation.

///|
pub enum ProtocolVersion {
  V311
  V5
}

///|
#verify
pub enum QoS {
  AtMostOnce
  AtLeastOnce
  ExactlyOnce
}

///|
#verify
pub enum PacketType {
  Connect
  ConnAck
  Publish
  PubAck
  PubRec
  PubRel
  PubComp
  Subscribe
  SubAck
  Unsubscribe
  UnsubAck
  PingReq
  PingResp
  Disconnect
  Auth
}

///|
pub val struct MqttLimits {
  pub max_packet_size : Int
  pub max_topic_len : Int
  pub max_properties : Int
  pub max_subscriptions : Int
  pub max_inflight : Int
}

///|
pub fn MqttLimits::default() -> MqttLimits {
  MqttLimits::{
    max_packet_size: 1048576,
    max_topic_len: 65535,
    max_properties: 256,
    max_subscriptions: 1024,
    max_inflight: 65535,
  }
}

///|
pub fn MqttLimits::new(
  max_packet_size : Int,
  max_topic_len : Int,
  max_properties : Int,
  max_subscriptions : Int,
  max_inflight : Int,
) -> MqttLimits {
  MqttLimits::{
    max_packet_size: max_packet_size,
    max_topic_len: max_topic_len,
    max_properties: max_properties,
    max_subscriptions: max_subscriptions,
    max_inflight: max_inflight,
  }
}

///|
pub enum MqttError {
  Incomplete
  InvalidPacketType(Int)
  InvalidFlags(Int, Int)
  MalformedVbi
  NonCanonicalVbi
  PacketTooLarge(Int, Int)
  UnexpectedEof
  TrailingBytes(Int)
  InvalidUtf8(String)
  ForbiddenCodePoint(Int)
  InvalidProtocolName(String)
  UnsupportedProtocolVersion(Int)
  InvalidConnectFlags(Int)
  InvalidQoS(Int)
  InvalidPacketId
  DuplicateProperty(Int)
  UnknownProperty(Int)
  InvalidPropertyForPacket(Int)
  PropertyCountExceeded(Int)
  InvalidReasonCode(Int)
  InvalidTopicName(String)
  InvalidTopicFilter(String)
  InvalidSharedSubscription(String)
  ProtocolViolation(String)
  FlowControlExceeded
  UnknownTopicAlias(Int)
  SessionNotConnected
  PacketIdExhausted
}

///|
pub fn mqtt_error_string(err : MqttError) -> String {
  match err {
    MqttError::Incomplete => "incomplete packet"
    MqttError::InvalidPacketType(pt) => "invalid packet type: " + pt.to_string()
    MqttError::InvalidFlags(pt, fl) =>
    "invalid flags " + fl.to_string() + " for packet type " + pt.to_string()
    MqttError::MalformedVbi => "malformed variable byte integer"
    MqttError::NonCanonicalVbi => "non-canonical variable byte integer"
    MqttError::PacketTooLarge(actual, max) =>
    "packet too large: " + actual.to_string() + " > " + max.to_string()
    MqttError::UnexpectedEof => "unexpected end of packet"
    MqttError::TrailingBytes(n) => "trailing bytes in packet: " + n.to_string()
    MqttError::InvalidUtf8(msg) => "invalid utf-8: " + msg
    MqttError::ForbiddenCodePoint(cp) =>
    "forbidden mqtt code point: " + cp.to_string()
    MqttError::InvalidProtocolName(s) => "invalid protocol name: " + s
    MqttError::UnsupportedProtocolVersion(v) =>
    "unsupported protocol version: " + v.to_string()
    MqttError::InvalidConnectFlags(f) => "invalid connect flags: " + f.to_string()
    MqttError::InvalidQoS(q) => "invalid qos: " + q.to_string()
    MqttError::InvalidPacketId => "invalid packet identifier (0)"
    MqttError::DuplicateProperty(id) => "duplicate property: " + id.to_string()
    MqttError::UnknownProperty(id) => "unknown property: " + id.to_string()
    MqttError::InvalidPropertyForPacket(id) =>
    "property not allowed for packet: " + id.to_string()
    MqttError::PropertyCountExceeded(n) =>
    "property count exceeded: " + n.to_string()
    MqttError::InvalidReasonCode(rc) => "invalid reason code: " + rc.to_string()
    MqttError::InvalidTopicName(s) => "invalid topic name: " + s
    MqttError::InvalidTopicFilter(s) => "invalid topic filter: " + s
    MqttError::InvalidSharedSubscription(s) =>
    "invalid shared subscription: " + s
    MqttError::ProtocolViolation(msg) => "protocol violation: " + msg
    MqttError::FlowControlExceeded => "receive maximum flow control exceeded"
    MqttError::UnknownTopicAlias(a) => "unknown topic alias: " + a.to_string()
    MqttError::SessionNotConnected => "session not connected"
    MqttError::PacketIdExhausted => "packet identifier space exhausted"
  }
}

///|
#verify
pub fn qos_to_int(q : QoS) -> Int {
  match q {
    QoS::AtMostOnce => 0
    QoS::AtLeastOnce => 1
    QoS::ExactlyOnce => 2
  }
}

///|
#verify
pub fn qos_from_int_opt(raw : Int) -> Option[QoS] {
  if raw == 0 {
    Some(QoS::AtMostOnce)
  } else if raw == 1 {
    Some(QoS::AtLeastOnce)
  } else if raw == 2 {
    Some(QoS::ExactlyOnce)
  } else {
    None
  }
}

///|
pub fn qos_from_int(raw : Int) -> Result[QoS, MqttError] {
  match qos_from_int_opt(raw) {
    Some(q) => Ok(q)
    None => Err(MqttError::InvalidQoS(raw))
  }
}

///|
pub fn packet_type_to_int(pt : PacketType) -> Int {
  match pt {
    PacketType::Connect => 1
    PacketType::ConnAck => 2
    PacketType::Publish => 3
    PacketType::PubAck => 4
    PacketType::PubRec => 5
    PacketType::PubRel => 6
    PacketType::PubComp => 7
    PacketType::Subscribe => 8
    PacketType::SubAck => 9
    PacketType::Unsubscribe => 10
    PacketType::UnsubAck => 11
    PacketType::PingReq => 12
    PacketType::PingResp => 13
    PacketType::Disconnect => 14
    PacketType::Auth => 15
  }
}

///|
#verify
pub fn packet_type_from_int_opt(raw : Int) -> Option[PacketType] {
  if raw == 1 {
    Some(PacketType::Connect)
  } else if raw == 2 {
    Some(PacketType::ConnAck)
  } else if raw == 3 {
    Some(PacketType::Publish)
  } else if raw == 4 {
    Some(PacketType::PubAck)
  } else if raw == 5 {
    Some(PacketType::PubRec)
  } else if raw == 6 {
    Some(PacketType::PubRel)
  } else if raw == 7 {
    Some(PacketType::PubComp)
  } else if raw == 8 {
    Some(PacketType::Subscribe)
  } else if raw == 9 {
    Some(PacketType::SubAck)
  } else if raw == 10 {
    Some(PacketType::Unsubscribe)
  } else if raw == 11 {
    Some(PacketType::UnsubAck)
  } else if raw == 12 {
    Some(PacketType::PingReq)
  } else if raw == 13 {
    Some(PacketType::PingResp)
  } else if raw == 14 {
    Some(PacketType::Disconnect)
  } else if raw == 15 {
    Some(PacketType::Auth)
  } else {
    None
  }
}

///|
pub fn packet_type_from_int(raw : Int) -> Result[PacketType, MqttError] {
  match packet_type_from_int_opt(raw) {
    Some(pt) => Ok(pt)
    None => Err(MqttError::InvalidPacketType(raw))
  }
}

///| OASIS MQTT 5.0 §1.5.5 Variable Byte Integer encoded length (0 if out of range).
#verify
pub fn vbi_encoded_len(value : Int) -> Int {
  if value < 0 || value > 268435455 {
    return 0
  }
  if value < 128 {
    1
  } else if value < 16384 {
    2
  } else if value < 2097152 {
    3
  } else {
    4
  }
}

///| Encode a Variable Byte Integer (0..268435455).
pub fn encode_vbi(value : Int) -> Result[Bytes, MqttError] {
  if value < 0 || value > 268435455 {
    return Err(MqttError::MalformedVbi)
  }
  let n = vbi_encoded_len(value)
  let mut out = Bytes::new(n)
  let mut x = value
  let mut i = 0
  while i < n {
    let mut b = x & 0x7F
    x = x >> 7
    if x > 0 {
      b = b | 0x80
    }
    out[i] = b.to_byte()
    i = i + 1
  }
  Ok(out)
}

///| Assemble a 2-byte MQTT Variable Byte Integer.
#verify
pub fn vbi_decode_2(b0 : Int, b1 : Int) -> Int {
  (b0 & 0x7F) | (b1 << 7)
}

///| Assemble a 3-byte MQTT Variable Byte Integer.
#verify
pub fn vbi_decode_3(b0 : Int, b1 : Int, b2 : Int) -> Int {
  (b0 & 0x7F) | ((b1 & 0x7F) << 7) | (b2 << 14)
}

///| Assemble a 4-byte MQTT Variable Byte Integer.
#verify
pub fn vbi_decode_4(b0 : Int, b1 : Int, b2 : Int, b3 : Int) -> Int {
  (b0 & 0x7F) | ((b1 & 0x7F) << 7) | ((b2 & 0x7F) << 14) | (b3 << 21)
}

///| Decode a Variable Byte Integer from `data` starting at `offset`.
///| Strictly rejects >4-byte encodings (`MalformedVbi`) and overlong/non-canonical encodings (`NonCanonicalVbi`).
pub fn decode_vbi(data : Bytes, offset : Int) -> Result[(Int, Int), MqttError] {
  let len = data.length()
  if offset >= len {
    return Err(MqttError::Incomplete)
  }
  let b0 = data[offset].to_int()
  if b0 < 0x80 {
    return Ok((b0, 1))
  }
  if offset + 1 >= len {
    return Err(MqttError::Incomplete)
  }
  let b1 = data[offset + 1].to_int()
  if b1 < 0x80 {
    if b1 == 0 {
      return Err(MqttError::NonCanonicalVbi)
    }
    return Ok((vbi_decode_2(b0, b1), 2))
  }
  if offset + 2 >= len {
    return Err(MqttError::Incomplete)
  }
  let b2 = data[offset + 2].to_int()
  if b2 < 0x80 {
    if b2 == 0 {
      return Err(MqttError::NonCanonicalVbi)
    }
    return Ok((vbi_decode_3(b0, b1, b2), 3))
  }
  if offset + 3 >= len {
    return Err(MqttError::Incomplete)
  }
  let b3 = data[offset + 3].to_int()
  if b3 >= 0x80 {
    return Err(MqttError::MalformedVbi)
  }
  if b3 == 0 {
    return Err(MqttError::NonCanonicalVbi)
  }
  Ok((vbi_decode_4(b0, b1, b2, b3), 4))
}

///| Validate OASIS MQTT 3.1.1 & 5.0 Fixed Header packet type & flags (Table 2-2).
///| Returns: 0 = valid, 1 = InvalidPacketType, 2 = InvalidQoS(3), 3 = InvalidFlags.
#verify
pub fn fixed_header_flags_err_code(ptype : Int, flags : Int) -> Int {
  if ptype < 1 || ptype > 15 {
    return 1
  }
  if ptype == 3 {
    let qos = (flags >> 1) & 0x03
    if qos == 3 {
      return 2
    }
    let dup = (flags & 0x08) != 0
    if qos == 0 && dup {
      return 3
    }
    return 0
  }
  let expected = if ptype == 6 || ptype == 8 || ptype == 10 { 0x02 } else { 0x00 }
  if flags != expected {
    return 3
  }
  0
}

///| Validate OASIS MQTT 3.1.1 & 5.0 Fixed Header packet type & flags (Table 2-2).
pub fn validate_fixed_header_flags(
  ptype : Int,
  flags : Int,
) -> Result[Unit, MqttError] {
  let code = fixed_header_flags_err_code(ptype, flags)
  if code == 0 {
    Ok(())
  } else if code == 1 {
    Err(MqttError::InvalidPacketType(ptype))
  } else if code == 2 {
    Err(MqttError::InvalidQoS(3))
  } else {
    Err(MqttError::InvalidFlags(ptype, flags))
  }
}

///| Check whether an ASCII byte is forbidden by OASIS MQTT §1.5.4 (C0 controls 0x00..0x1F or DEL 0x7F).
pub fn is_mqtt_forbidden_ascii(b : Int) -> Bool {
  b < 0x20 || b == 0x7F
}

///| Check whether a byte is a UTF-8 continuation byte (10xxxxxx = 0x80..0xBF).
#verify
pub fn is_utf8_cont_byte(b : Int) -> Bool {
  (b & 0xC0) == 0x80
}

///| Check whether a 2-byte UTF-8 sequence `(b0, b1)` encodes a forbidden C1 control (U+0080..U+009F).
pub fn is_mqtt_c1_control_2b(b0 : Int, b1 : Int) -> Bool {
  b0 == 0xC2 && b1 >= 0x80 && b1 <= 0x9F
}

///| Shared empty `Bytes` singleton to avoid zero-length heap allocations.
let empty_bytes : Bytes = Bytes::new(0)

///| Mutable byte cursor and error slot for zero-boxing internal decoding.
struct DecodeCursor {
  mut pos : Int
  mut err : Option[MqttError]
}

///| Fast single-pass topic name validator over `String` `[start, end)` (valid MQTT UTF-8 and no `+`/`#`).
///| Returns: 0 = valid, 1 = wildcard (`+` or `#`), 2 = invalid UTF-8 / forbidden code point.
fn check_mqtt_topic_str_range(s : String, start : Int, end : Int) -> Int {
  let mut i = start
  while i < end {
    while i + 4 <= end {
      let c0 = s.code_unit_at(i)
      let c1 = s.code_unit_at(i + 1)
      let c2 = s.code_unit_at(i + 2)
      let c3 = s.code_unit_at(i + 3)
      if ((c0 - 0x20) | (0x7E - c0) | (c1 - 0x20) | (0x7E - c1) | (c2 - 0x20) | (0x7E - c2) | (c3 - 0x20) | (0x7E - c3)) >= 0 &&
      c0 != 0x2B && c0 != 0x23 && c1 != 0x2B && c1 != 0x23 &&
      c2 != 0x2B && c2 != 0x23 && c3 != 0x2B && c3 != 0x23 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 < 0x20 || b0 == 0x7F {
        return 2
      }
      if b0 == 0x2B || b0 == 0x23 {
        return 1
      }
      i = i + 1
    } else if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= end {
        return 2
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 || (b0 == 0xC2 && b1 <= 0x9F) {
        return 2
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 >= end {
        return 2
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b2 & 0xC0) != 0x80 {
        return 2
      }
      if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return 2
        }
      } else if b0 == 0xED {
        if b1 < 0x80 || b1 > 0x9F {
          return 2
        }
      } else if (b1 & 0xC0) != 0x80 {
        return 2
      }
      i = i + 3
    } else if b0 <= 0xF4 {
      if i + 3 >= end {
        return 2
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return 2
      }
      if b0 == 0xF0 {
        if b1 < 0x90 || b1 > 0xBF {
          return 2
        }
      } else if b0 == 0xF4 {
        if b1 < 0x80 || b1 > 0x8F {
          return 2
        }
      } else if (b1 & 0xC0) != 0x80 {
        return 2
      }
      i = i + 4
    } else {
      return 2
    }
  }
  0
}

///| Fast unboxed multi-byte VBI decoder over `String` for `b0 >= 0x80`.
///| Returns decoded value >= 0 on success (updating `cursor.pos`), or -1 on Incomplete, or -2 on error (setting `cursor.err`).
fn decode_vbi_multi_str(
  data : String,
  offset : Int,
  end : Int,
  b0 : Int,
  cursor : DecodeCursor,
) -> Int {
  if offset + 1 >= end {
    return -1
  }
  let b1 = data.code_unit_at(offset + 1)
  if b1 < 0x80 {
    if b1 == 0 {
      cursor.err = Some(MqttError::NonCanonicalVbi)
      return -2
    }
    cursor.pos = offset + 2
    return vbi_decode_2(b0, b1)
  }
  if offset + 2 >= end {
    return -1
  }
  let b2 = data.code_unit_at(offset + 2)
  if b2 < 0x80 {
    if b2 == 0 {
      cursor.err = Some(MqttError::NonCanonicalVbi)
      return -2
    }
    cursor.pos = offset + 3
    return vbi_decode_3(b0, b1, b2)
  }
  if offset + 3 >= end {
    return -1
  }
  let b3 = data.code_unit_at(offset + 3)
  if b3 >= 0x80 {
    cursor.err = Some(MqttError::MalformedVbi)
    return -2
  }
  if b3 == 0 {
    cursor.err = Some(MqttError::NonCanonicalVbi)
    return -2
  }
  cursor.pos = offset + 4
  vbi_decode_4(b0, b1, b2, b3)
}

///| Zero-boxing MQTT string reader over `String` `[cursor.pos, end)`.
///| On error, sets `cursor.err = Some(err)` and returns `""`.
fn read_mqtt_str_from_str(
  data : String,
  cursor : DecodeCursor,
  end : Int,
) -> String {
  let p = cursor.pos
  if p + 2 > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return ""
  }
  let slen = (data.code_unit_at(p) << 8) | data.code_unit_at(p + 1)
  let sstart = p + 2
  let send = sstart + slen
  if send > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return ""
  }
  if slen == 0 {
    cursor.pos = send
    return ""
  }
  if !is_valid_mqtt_utf8_str_range(data, sstart, send) {
    let sub = data.slice(sstart, send).to_bytes()
    match validate_mqtt_utf8_range(sub, 0, slen) {
      Ok(_) => ()
      Err(e) => {
        cursor.err = Some(e)
        return ""
      }
    }
  }
  cursor.pos = send
  data.slice(sstart, send)
}

///| Zero-boxing binary data reader over `String` `[cursor.pos, end)`.
///| On error, sets `cursor.err = Some(err)` and returns `empty_bytes`.
fn read_bin_data_from_str(
  data : String,
  cursor : DecodeCursor,
  end : Int,
) -> Bytes {
  let p = cursor.pos
  if p + 2 > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return empty_bytes
  }
  let blen = (data.code_unit_at(p) << 8) | data.code_unit_at(p + 1)
  let bstart = p + 2
  let bend = bstart + blen
  if bend > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return empty_bytes
  }
  cursor.pos = bend
  if blen == 0 {
    empty_bytes
  } else {
    data.slice(bstart, bend).to_bytes()
  }
}

///| Fast unboxed RFC 3629 UTF-8 + OASIS MQTT §1.5.4 validator over `Bytes` range `[start, end)`.
///| Uses 4x-unrolled bitwise printable ASCII fast path (`0x20..0x7E`).
fn is_valid_mqtt_utf8_bytes(data : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    while i + 4 <= end {
      let c0 = data[i].to_int()
      let c1 = data[i + 1].to_int()
      let c2 = data[i + 2].to_int()
      let c3 = data[i + 3].to_int()
      if ((c0 - 0x20) | (0x7E - c0) | (c1 - 0x20) | (0x7E - c1) | (c2 - 0x20) | (0x7E - c2) | (c3 - 0x20) | (0x7E - c3)) >= 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      if b0 < 0x20 || b0 == 0x7F {
        return false
      }
      i = i + 1
    } else if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xC2 && b1 <= 0x9F {
        return false
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xED {
        if b1 < 0x80 || b1 > 0x9F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 {
        if b1 < 0x90 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xF4 {
        if b1 < 0x80 || b1 > 0x8F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Fast unboxed RFC 3629 UTF-8 + OASIS MQTT §1.5.4 validator directly on `String` (zero `to_bytes()`).
fn is_valid_mqtt_utf8_str_range(s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    while i + 4 <= end {
      let c0 = s.code_unit_at(i)
      let c1 = s.code_unit_at(i + 1)
      let c2 = s.code_unit_at(i + 2)
      let c3 = s.code_unit_at(i + 3)
      if ((c0 - 0x20) | (0x7E - c0) | (c1 - 0x20) | (0x7E - c1) | (c2 - 0x20) | (0x7E - c2) | (c3 - 0x20) | (0x7E - c3)) >= 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 < 0x20 || b0 == 0x7F {
        return false
      }
      i = i + 1
    } else if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xC2 && b1 <= 0x9F {
        return false
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xED {
        if b1 < 0x80 || b1 > 0x9F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 {
        if b1 < 0x90 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xF4 {
        if b1 < 0x80 || b1 > 0x8F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Fast single-pass topic name validator directly on `String` (non-empty, <=65535B, valid MQTT UTF-8, no `+`/`#`).
fn is_valid_mqtt_topic_str(s : String) -> Bool {
  let end = s.length()
  if end == 0 || end > 65535 {
    return false
  }
  let mut i = 0
  while i < end {
    while i + 4 <= end {
      let c0 = s.code_unit_at(i)
      let c1 = s.code_unit_at(i + 1)
      let c2 = s.code_unit_at(i + 2)
      let c3 = s.code_unit_at(i + 3)
      if ((c0 - 0x20) | (0x7E - c0) | (c1 - 0x20) | (0x7E - c1) | (c2 - 0x20) | (0x7E - c2) | (c3 - 0x20) | (0x7E - c3)) >= 0 &&
      c0 != 0x2B && c0 != 0x23 && c1 != 0x2B && c1 != 0x23 &&
      c2 != 0x2B && c2 != 0x23 && c3 != 0x2B && c3 != 0x23 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 < 0x20 || b0 == 0x7F || b0 == 0x2B || b0 == 0x23 {
        return false
      }
      i = i + 1
    } else if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 || (b0 == 0xC2 && b1 <= 0x9F) {
        return false
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xED {
        if b1 < 0x80 || b1 > 0x9F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 {
        if b1 < 0x90 || b1 > 0xBF {
          return false
        }
      } else if b0 == 0xF4 {
        if b1 < 0x80 || b1 > 0x8F {
          return false
        }
      } else if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Strict RFC 3629 UTF-8 + OASIS MQTT 5.0 §1.5.4 / 3.1.1 §1.5.3 string validator.
///| Rejects invalid UTF-8, UTF-16 surrogates, U+0000, U+0001..U+001F, U+007F..U+009F.
pub fn validate_mqtt_utf8_range(
  data : Bytes,
  start : Int,
  end : Int,
) -> Result[Unit, MqttError] {
  if is_valid_mqtt_utf8_bytes(data, start, end) {
    return Ok(())
  }
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      if is_mqtt_forbidden_ascii(b0) {
        return Err(MqttError::ForbiddenCodePoint(b0))
      }
      i = i + 1
    } else if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= end {
        return Err(MqttError::InvalidUtf8("invalid 2-byte sequence"))
      }
      let b1 = data[i + 1].to_int()
      if !is_utf8_cont_byte(b1) {
        return Err(MqttError::InvalidUtf8("invalid continuation byte"))
      }
      // Reject U+0080..U+009F (0xC2 0x80..0x9F)
      if is_mqtt_c1_control_2b(b0, b1) {
        return Err(MqttError::ForbiddenCodePoint(b1))
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 >= end {
        return Err(MqttError::InvalidUtf8("truncated 3-byte sequence"))
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b2 & 0xC0) != 0x80 {
        return Err(MqttError::InvalidUtf8("invalid 3-byte continuation"))
      }
      if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return Err(MqttError::InvalidUtf8("overlong 3-byte sequence"))
        }
      } else if b0 == 0xED {
        // Reject UTF-16 surrogates U+D800..U+DFFF (0xED 0xA0..0xBF)
        if b1 < 0x80 || b1 > 0x9F {
          return Err(MqttError::InvalidUtf8("utf-16 surrogate code point"))
        }
      } else if (b1 & 0xC0) != 0x80 {
        return Err(MqttError::InvalidUtf8("invalid 3-byte continuation"))
      }
      i = i + 3
    } else if b0 <= 0xF4 {
      if i + 3 >= end {
        return Err(MqttError::InvalidUtf8("truncated 4-byte sequence"))
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(MqttError::InvalidUtf8("invalid 4-byte continuation"))
      }
      if b0 == 0xF0 {
        if b1 < 0x90 || b1 > 0xBF {
          return Err(MqttError::InvalidUtf8("overlong 4-byte sequence"))
        }
      } else if b0 == 0xF4 {
        if b1 < 0x80 || b1 > 0x8F {
          return Err(MqttError::InvalidUtf8("code point > U+10FFFF"))
        }
      } else if (b1 & 0xC0) != 0x80 {
        return Err(MqttError::InvalidUtf8("invalid 4-byte continuation"))
      }
      i = i + 4
    } else {
      return Err(MqttError::InvalidUtf8("invalid leading byte"))
    }
  }
  Ok(())
}

///| Validate an MQTT UTF-8 `String`.
pub fn validate_mqtt_utf8(s : String) -> Result[Unit, MqttError] {
  if is_valid_mqtt_utf8_str_range(s, 0, s.length()) {
    return Ok(())
  }
  let b = s.to_bytes()
  validate_mqtt_utf8_range(b, 0, b.length())
}

///| Validate an MQTT UTF-8 string for encoding (`<= 65535` bytes and valid MQTT UTF-8).
fn check_encode_mqtt_str(s : String) -> Result[Int, MqttError] {
  let n = s.length()
  if n > 65535 {
    return Err(MqttError::ProtocolViolation("utf-8 string exceeds 65535 bytes"))
  }
  if is_valid_mqtt_utf8_str_range(s, 0, n) {
    return Ok(n)
  }
  let b = s.to_bytes()
  match validate_mqtt_utf8_range(b, 0, n) {
    Ok(_) => Ok(n)
    Err(e) => Err(e)
  }
}

///| StringBuilder low-overhead wire encoding primitives (zero per-byte ByteBuf/copy_bytes overhead).
fn sb_write_u16(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte(((v >> 8) & 0xFF).to_byte())
  sb.write_byte((v & 0xFF).to_byte())
}

///|
fn sb_write_u32(sb : StringBuilder, v : UInt) -> Unit {
  sb.write_byte(((v >> 24) & 0xFFU).to_int().to_byte())
  sb.write_byte(((v >> 16) & 0xFFU).to_int().to_byte())
  sb.write_byte(((v >> 8) & 0xFFU).to_int().to_byte())
  sb.write_byte((v & 0xFFU).to_int().to_byte())
}

///|
fn sb_write_vbi(sb : StringBuilder, value : Int) -> Unit {
  if value < 128 {
    sb.write_byte(value.to_byte())
    return ()
  }
  let mut x = value
  while true {
    let mut b = x & 0x7F
    x = x >> 7
    if x > 0 {
      b = b | 0x80
    }
    sb.write_byte(b.to_byte())
    if x == 0 {
      break
    }
  }
}

///|
fn sb_write_mqtt_str_raw(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  sb.write_byte(((n >> 8) & 0xFF).to_byte())
  sb.write_byte((n & 0xFF).to_byte())
  if n > 0 {
    sb.write_string(s)
  }
}

///|
fn sb_write_bin_data_raw(sb : StringBuilder, b : Bytes) -> Unit {
  let n = b.length()
  sb.write_byte(((n >> 8) & 0xFF).to_byte())
  sb.write_byte((n & 0xFF).to_byte())
  if n > 0 {
    sb.write_string(b.to_string())
  }
}

///| Fast unrolled byte-slice copy helper.
fn copy_bytes(
  dst : Bytes,
  dst_off : Int,
  src : Bytes,
  src_off : Int,
  len : Int,
) -> Unit {
  let mut di = dst_off
  let mut si = src_off
  let end = src_off + len
  while si + 8 <= end {
    dst[di] = src[si]
    dst[di + 1] = src[si + 1]
    dst[di + 2] = src[si + 2]
    dst[di + 3] = src[si + 3]
    dst[di + 4] = src[si + 4]
    dst[di + 5] = src[si + 5]
    dst[di + 6] = src[si + 6]
    dst[di + 7] = src[si + 7]
    di = di + 8
    si = si + 8
  }
  while si < end {
    dst[di] = src[si]
    di = di + 1
    si = si + 1
  }
}
