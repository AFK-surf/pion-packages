///| OASIS MQTT 5.0 Properties (all 27 standard properties) and Reason Codes.

///|
pub enum PropertyContext {
  Connect
  Will
  ConnAck
  Publish
  PubAck
  PubRec
  PubRel
  PubComp
  Subscribe
  SubAck
  Unsubscribe
  UnsubAck
  Disconnect
  Auth
}

///|
pub struct Properties {
  pub mut payload_format_indicator : Option[Int]
  pub mut message_expiry_interval : Option[UInt]
  pub mut content_type : Option[String]
  pub mut response_topic : Option[String]
  pub mut correlation_data : Option[Bytes]
  pub mut subscription_identifiers : Array[Int]
  pub mut session_expiry_interval : Option[UInt]
  pub mut assigned_client_identifier : Option[String]
  pub mut server_keep_alive : Option[Int]
  pub mut authentication_method : Option[String]
  pub mut authentication_data : Option[Bytes]
  pub mut request_problem_information : Option[Int]
  pub mut will_delay_interval : Option[UInt]
  pub mut request_response_information : Option[Int]
  pub mut response_information : Option[String]
  pub mut server_reference : Option[String]
  pub mut reason_string : Option[String]
  pub mut receive_maximum : Option[Int]
  pub mut topic_alias_maximum : Option[Int]
  pub mut topic_alias : Option[Int]
  pub mut maximum_qos : Option[Int]
  pub mut retain_available : Option[Int]
  pub mut user_properties : Array[(String, String)]
  pub mut maximum_packet_size : Option[UInt]
  pub mut wildcard_subscription_available : Option[Int]
  pub mut subscription_identifier_available : Option[Int]
  pub mut shared_subscription_available : Option[Int]
}

///|
pub fn Properties::empty() -> Properties {
  Properties::{
    payload_format_indicator: None,
    message_expiry_interval: None,
    content_type: None,
    response_topic: None,
    correlation_data: None,
    subscription_identifiers: [],
    session_expiry_interval: None,
    assigned_client_identifier: None,
    server_keep_alive: None,
    authentication_method: None,
    authentication_data: None,
    request_problem_information: None,
    will_delay_interval: None,
    request_response_information: None,
    response_information: None,
    server_reference: None,
    reason_string: None,
    receive_maximum: None,
    topic_alias_maximum: None,
    topic_alias: None,
    maximum_qos: None,
    retain_available: None,
    user_properties: [],
    maximum_packet_size: None,
    wildcard_subscription_available: None,
    subscription_identifier_available: None,
    shared_subscription_available: None,
  }
}

///|
pub fn Properties::is_empty(self : Properties) -> Bool {
  self.payload_format_indicator is None &&
  self.message_expiry_interval is None &&
  self.content_type is None &&
  self.response_topic is None &&
  self.correlation_data is None &&
  self.subscription_identifiers.length() == 0 &&
  self.session_expiry_interval is None &&
  self.assigned_client_identifier is None &&
  self.server_keep_alive is None &&
  self.authentication_method is None &&
  self.authentication_data is None &&
  self.request_problem_information is None &&
  self.will_delay_interval is None &&
  self.request_response_information is None &&
  self.response_information is None &&
  self.server_reference is None &&
  self.reason_string is None &&
  self.receive_maximum is None &&
  self.topic_alias_maximum is None &&
  self.topic_alias is None &&
  self.maximum_qos is None &&
  self.retain_available is None &&
  self.user_properties.length() == 0 &&
  self.maximum_packet_size is None &&
  self.wildcard_subscription_available is None &&
  self.subscription_identifier_available is None &&
  self.shared_subscription_available is None
}

///| Check whether property identifier `id` is permitted in `ctx` (OASIS MQTT 5.0 §2.2.2.2).
fn property_allowed_in(id : Int, ctx : PropertyContext) -> Bool {
  match id {
    0x01 => ctx is PropertyContext::Publish || ctx is PropertyContext::Will
    0x02 => ctx is PropertyContext::Publish || ctx is PropertyContext::Will
    0x03 => ctx is PropertyContext::Publish || ctx is PropertyContext::Will
    0x08 => ctx is PropertyContext::Publish || ctx is PropertyContext::Will
    0x09 => ctx is PropertyContext::Publish || ctx is PropertyContext::Will
    0x0B => ctx is PropertyContext::Publish || ctx is PropertyContext::Subscribe
    0x11 =>
    ctx is PropertyContext::Connect ||
    ctx is PropertyContext::ConnAck ||
    ctx is PropertyContext::Disconnect
    0x12 => ctx is PropertyContext::ConnAck
    0x13 => ctx is PropertyContext::ConnAck
    0x15 =>
    ctx is PropertyContext::Connect ||
    ctx is PropertyContext::ConnAck ||
    ctx is PropertyContext::Auth
    0x16 =>
    ctx is PropertyContext::Connect ||
    ctx is PropertyContext::ConnAck ||
    ctx is PropertyContext::Auth
    0x17 => ctx is PropertyContext::Connect
    0x18 => ctx is PropertyContext::Will
    0x19 => ctx is PropertyContext::Connect
    0x1A => ctx is PropertyContext::ConnAck
    0x1C => ctx is PropertyContext::ConnAck || ctx is PropertyContext::Disconnect
    0x1F =>
    ctx is PropertyContext::ConnAck ||
    ctx is PropertyContext::PubAck ||
    ctx is PropertyContext::PubRec ||
    ctx is PropertyContext::PubRel ||
    ctx is PropertyContext::PubComp ||
    ctx is PropertyContext::SubAck ||
    ctx is PropertyContext::UnsubAck ||
    ctx is PropertyContext::Disconnect ||
    ctx is PropertyContext::Auth
    0x21 => ctx is PropertyContext::Connect || ctx is PropertyContext::ConnAck
    0x22 => ctx is PropertyContext::Connect || ctx is PropertyContext::ConnAck
    0x23 => ctx is PropertyContext::Publish
    0x24 => ctx is PropertyContext::ConnAck
    0x25 => ctx is PropertyContext::ConnAck
    0x26 => true // User Property allowed on every packet & will
    0x27 => ctx is PropertyContext::Connect || ctx is PropertyContext::ConnAck
    0x28 => ctx is PropertyContext::ConnAck
    0x29 => ctx is PropertyContext::ConnAck
    0x2A => ctx is PropertyContext::ConnAck
    _ => false
  }
}

///| Encode MQTT 5.0 Properties section (prefixed by Property Length VBI).
fn encode_properties(
  buf : ByteBuf,
  props : Properties,
  ctx : PropertyContext,
) -> Result[Unit, MqttError] {
  if props.is_empty() {
    buf.push_u8(0)
    return Ok(())
  }
  let tmp = ByteBuf::with_capacity(64)
  match props.payload_format_indicator {
    Some(v) => {
      if !property_allowed_in(0x01, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x01))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("payload format indicator must be 0 or 1"))
      }
      tmp.push_u8(0x01)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.message_expiry_interval {
    Some(v) => {
      if !property_allowed_in(0x02, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x02))
      }
      tmp.push_u8(0x02)
      tmp.push_u32(v)
    }
    None => ()
  }
  match props.content_type {
    Some(s) => {
      if !property_allowed_in(0x03, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x03))
      }
      tmp.push_u8(0x03)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.response_topic {
    Some(s) => {
      if !property_allowed_in(0x08, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x08))
      }
      tmp.push_u8(0x08)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.correlation_data {
    Some(b) => {
      if !property_allowed_in(0x09, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x09))
      }
      tmp.push_u8(0x09)
      match tmp.push_bin_data(b) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  let mut si = 0
  let sids = props.subscription_identifiers
  while si < sids.length() {
    if !property_allowed_in(0x0B, ctx) {
      return Err(MqttError::InvalidPropertyForPacket(0x0B))
    }
    if ctx is PropertyContext::Subscribe && si > 0 {
      return Err(MqttError::DuplicateProperty(0x0B))
    }
    let sid = sids[si]
    if sid <= 0 || sid > 268435455 {
      return Err(MqttError::ProtocolViolation("subscription identifier must be 1..268435455"))
    }
    tmp.push_u8(0x0B)
    match tmp.push_vbi(sid) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    si = si + 1
  }
  match props.session_expiry_interval {
    Some(v) => {
      if !property_allowed_in(0x11, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x11))
      }
      tmp.push_u8(0x11)
      tmp.push_u32(v)
    }
    None => ()
  }
  match props.assigned_client_identifier {
    Some(s) => {
      if !property_allowed_in(0x12, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x12))
      }
      tmp.push_u8(0x12)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.server_keep_alive {
    Some(v) => {
      if !property_allowed_in(0x13, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x13))
      }
      if v < 0 || v > 65535 {
        return Err(MqttError::ProtocolViolation("server keep alive out of range"))
      }
      tmp.push_u8(0x13)
      tmp.push_u16(v)
    }
    None => ()
  }
  match props.authentication_method {
    Some(s) => {
      if !property_allowed_in(0x15, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x15))
      }
      tmp.push_u8(0x15)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.authentication_data {
    Some(b) => {
      if !property_allowed_in(0x16, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x16))
      }
      tmp.push_u8(0x16)
      match tmp.push_bin_data(b) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.request_problem_information {
    Some(v) => {
      if !property_allowed_in(0x17, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x17))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("request problem info must be 0 or 1"))
      }
      tmp.push_u8(0x17)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.will_delay_interval {
    Some(v) => {
      if !property_allowed_in(0x18, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x18))
      }
      tmp.push_u8(0x18)
      tmp.push_u32(v)
    }
    None => ()
  }
  match props.request_response_information {
    Some(v) => {
      if !property_allowed_in(0x19, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x19))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("request response info must be 0 or 1"))
      }
      tmp.push_u8(0x19)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.response_information {
    Some(s) => {
      if !property_allowed_in(0x1A, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x1A))
      }
      tmp.push_u8(0x1A)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.server_reference {
    Some(s) => {
      if !property_allowed_in(0x1C, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x1C))
      }
      tmp.push_u8(0x1C)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.reason_string {
    Some(s) => {
      if !property_allowed_in(0x1F, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x1F))
      }
      tmp.push_u8(0x1F)
      match tmp.push_mqtt_str(s) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match props.receive_maximum {
    Some(v) => {
      if !property_allowed_in(0x21, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x21))
      }
      if v < 1 || v > 65535 {
        return Err(MqttError::ProtocolViolation("receive maximum must be 1..65535"))
      }
      tmp.push_u8(0x21)
      tmp.push_u16(v)
    }
    None => ()
  }
  match props.topic_alias_maximum {
    Some(v) => {
      if !property_allowed_in(0x22, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x22))
      }
      if v < 0 || v > 65535 {
        return Err(MqttError::ProtocolViolation("topic alias maximum out of range"))
      }
      tmp.push_u8(0x22)
      tmp.push_u16(v)
    }
    None => ()
  }
  match props.topic_alias {
    Some(v) => {
      if !property_allowed_in(0x23, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x23))
      }
      if v < 1 || v > 65535 {
        return Err(MqttError::ProtocolViolation("topic alias must be 1..65535"))
      }
      tmp.push_u8(0x23)
      tmp.push_u16(v)
    }
    None => ()
  }
  match props.maximum_qos {
    Some(v) => {
      if !property_allowed_in(0x24, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x24))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("maximum qos must be 0 or 1"))
      }
      tmp.push_u8(0x24)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.retain_available {
    Some(v) => {
      if !property_allowed_in(0x25, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x25))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("retain available must be 0 or 1"))
      }
      tmp.push_u8(0x25)
      tmp.push_u8(v)
    }
    None => ()
  }
  let mut ui = 0
  let ups = props.user_properties
  while ui < ups.length() {
    let (k, v) = ups[ui]
    tmp.push_u8(0x26)
    match tmp.push_mqtt_str(k) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match tmp.push_mqtt_str(v) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    ui = ui + 1
  }
  match props.maximum_packet_size {
    Some(v) => {
      if !property_allowed_in(0x27, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x27))
      }
      if v == 0U {
        return Err(MqttError::ProtocolViolation("maximum packet size cannot be 0"))
      }
      tmp.push_u8(0x27)
      tmp.push_u32(v)
    }
    None => ()
  }
  match props.wildcard_subscription_available {
    Some(v) => {
      if !property_allowed_in(0x28, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x28))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("wildcard sub available must be 0 or 1"))
      }
      tmp.push_u8(0x28)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.subscription_identifier_available {
    Some(v) => {
      if !property_allowed_in(0x29, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x29))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("sub id available must be 0 or 1"))
      }
      tmp.push_u8(0x29)
      tmp.push_u8(v)
    }
    None => ()
  }
  match props.shared_subscription_available {
    Some(v) => {
      if !property_allowed_in(0x2A, ctx) {
        return Err(MqttError::InvalidPropertyForPacket(0x2A))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("shared sub available must be 0 or 1"))
      }
      tmp.push_u8(0x2A)
      tmp.push_u8(v)
    }
    None => ()
  }
  match buf.push_vbi(tmp.len) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if tmp.len > 0 {
    buf.reserve(tmp.len)
    copy_bytes(buf.data, buf.len, tmp.data, 0, tmp.len)
    buf.len = buf.len + tmp.len
  }
  Ok(())
}

///| Decode MQTT 5.0 Properties section starting at `pos` within `[pos, end)`.
fn decode_properties(
  data : Bytes,
  pos : Int,
  end : Int,
  ctx : PropertyContext,
  max_properties : Int,
) -> Result[(Properties, Int), MqttError] {
  let (prop_len, vbi_used) = match decode_vbi(data, pos) {
    Ok(r) => r
    Err(MqttError::Incomplete) => return Err(MqttError::UnexpectedEof)
    Err(e) => return Err(e)
  }
  let start = pos + vbi_used
  let prop_end = start + prop_len
  if prop_end > end {
    return Err(MqttError::UnexpectedEof)
  }
  let props = Properties::empty()
  if prop_len == 0 {
    return Ok((props, prop_end))
  }
  let mut p = start
  let mut count = 0
  while p < prop_end {
    count = count + 1
    if count > max_properties {
      return Err(MqttError::PropertyCountExceeded(count))
    }
    let (id, id_len) = match decode_vbi(data, p) {
      Ok(r) => r
      Err(MqttError::Incomplete) => return Err(MqttError::UnexpectedEof)
      Err(e) => return Err(e)
    }
    p = p + id_len
    if p > prop_end {
      return Err(MqttError::UnexpectedEof)
    }
    // Check known property first
    let known = id == 0x01 ||
    id == 0x02 ||
    id == 0x03 ||
    id == 0x08 ||
    id == 0x09 ||
    id == 0x0B ||
    id == 0x11 ||
    id == 0x12 ||
    id == 0x13 ||
    id == 0x15 ||
    id == 0x16 ||
    id == 0x17 ||
    id == 0x18 ||
    id == 0x19 ||
    id == 0x1A ||
    id == 0x1C ||
    id == 0x1F ||
    id == 0x21 ||
    id == 0x22 ||
    id == 0x23 ||
    id == 0x24 ||
    id == 0x25 ||
    id == 0x26 ||
    id == 0x27 ||
    id == 0x28 ||
    id == 0x29 ||
    id == 0x2A
    if !known {
      return Err(MqttError::UnknownProperty(id))
    }
    if !property_allowed_in(id, ctx) {
      return Err(MqttError::InvalidPropertyForPacket(id))
    }
    match id {
      0x01 => {
        if !(props.payload_format_indicator is None) {
          return Err(MqttError::DuplicateProperty(0x01))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("payload format indicator must be 0 or 1"))
        }
        props.payload_format_indicator = Some(v)
        p = np
      }
      0x02 => {
        if !(props.message_expiry_interval is None) {
          return Err(MqttError::DuplicateProperty(0x02))
        }
        let (v, np) = match read_u32(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.message_expiry_interval = Some(v)
        p = np
      }
      0x03 => {
        if !(props.content_type is None) {
          return Err(MqttError::DuplicateProperty(0x03))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.content_type = Some(s)
        p = np
      }
      0x08 => {
        if !(props.response_topic is None) {
          return Err(MqttError::DuplicateProperty(0x08))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.response_topic = Some(s)
        p = np
      }
      0x09 => {
        if !(props.correlation_data is None) {
          return Err(MqttError::DuplicateProperty(0x09))
        }
        let (b, np) = match read_bin_data(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.correlation_data = Some(b)
        p = np
      }
      0x0B => {
        if ctx is PropertyContext::Subscribe && props.subscription_identifiers.length() > 0 {
          return Err(MqttError::DuplicateProperty(0x0B))
        }
        let (sid, used) = match decode_vbi(data, p) {
          Ok(r) => r
          Err(MqttError::Incomplete) => return Err(MqttError::UnexpectedEof)
          Err(e) => return Err(e)
        }
        if p + used > prop_end {
          return Err(MqttError::UnexpectedEof)
        }
        if sid <= 0 {
          return Err(MqttError::ProtocolViolation("subscription identifier cannot be 0"))
        }
        props.subscription_identifiers.push(sid)
        p = p + used
      }
      0x11 => {
        if !(props.session_expiry_interval is None) {
          return Err(MqttError::DuplicateProperty(0x11))
        }
        let (v, np) = match read_u32(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.session_expiry_interval = Some(v)
        p = np
      }
      0x12 => {
        if !(props.assigned_client_identifier is None) {
          return Err(MqttError::DuplicateProperty(0x12))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.assigned_client_identifier = Some(s)
        p = np
      }
      0x13 => {
        if !(props.server_keep_alive is None) {
          return Err(MqttError::DuplicateProperty(0x13))
        }
        let (v, np) = match read_u16(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.server_keep_alive = Some(v)
        p = np
      }
      0x15 => {
        if !(props.authentication_method is None) {
          return Err(MqttError::DuplicateProperty(0x15))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.authentication_method = Some(s)
        p = np
      }
      0x16 => {
        if !(props.authentication_data is None) {
          return Err(MqttError::DuplicateProperty(0x16))
        }
        let (b, np) = match read_bin_data(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.authentication_data = Some(b)
        p = np
      }
      0x17 => {
        if !(props.request_problem_information is None) {
          return Err(MqttError::DuplicateProperty(0x17))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("request problem info must be 0 or 1"))
        }
        props.request_problem_information = Some(v)
        p = np
      }
      0x18 => {
        if !(props.will_delay_interval is None) {
          return Err(MqttError::DuplicateProperty(0x18))
        }
        let (v, np) = match read_u32(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.will_delay_interval = Some(v)
        p = np
      }
      0x19 => {
        if !(props.request_response_information is None) {
          return Err(MqttError::DuplicateProperty(0x19))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("request response info must be 0 or 1"))
        }
        props.request_response_information = Some(v)
        p = np
      }
      0x1A => {
        if !(props.response_information is None) {
          return Err(MqttError::DuplicateProperty(0x1A))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.response_information = Some(s)
        p = np
      }
      0x1C => {
        if !(props.server_reference is None) {
          return Err(MqttError::DuplicateProperty(0x1C))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.server_reference = Some(s)
        p = np
      }
      0x1F => {
        if !(props.reason_string is None) {
          return Err(MqttError::DuplicateProperty(0x1F))
        }
        let (s, np) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.reason_string = Some(s)
        p = np
      }
      0x21 => {
        if !(props.receive_maximum is None) {
          return Err(MqttError::DuplicateProperty(0x21))
        }
        let (v, np) = match read_u16(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v == 0 {
          return Err(MqttError::ProtocolViolation("receive maximum cannot be 0"))
        }
        props.receive_maximum = Some(v)
        p = np
      }
      0x22 => {
        if !(props.topic_alias_maximum is None) {
          return Err(MqttError::DuplicateProperty(0x22))
        }
        let (v, np) = match read_u16(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.topic_alias_maximum = Some(v)
        p = np
      }
      0x23 => {
        if !(props.topic_alias is None) {
          return Err(MqttError::DuplicateProperty(0x23))
        }
        let (v, np) = match read_u16(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v == 0 {
          return Err(MqttError::ProtocolViolation("topic alias cannot be 0"))
        }
        props.topic_alias = Some(v)
        p = np
      }
      0x24 => {
        if !(props.maximum_qos is None) {
          return Err(MqttError::DuplicateProperty(0x24))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("maximum qos must be 0 or 1"))
        }
        props.maximum_qos = Some(v)
        p = np
      }
      0x25 => {
        if !(props.retain_available is None) {
          return Err(MqttError::DuplicateProperty(0x25))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("retain available must be 0 or 1"))
        }
        props.retain_available = Some(v)
        p = np
      }
      0x26 => {
        let (k, p1) = match read_mqtt_str(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        let (v, p2) = match read_mqtt_str(data, p1, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        props.user_properties.push((k, v))
        p = p2
      }
      0x27 => {
        if !(props.maximum_packet_size is None) {
          return Err(MqttError::DuplicateProperty(0x27))
        }
        let (v, np) = match read_u32(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v == 0U {
          return Err(MqttError::ProtocolViolation("maximum packet size cannot be 0"))
        }
        props.maximum_packet_size = Some(v)
        p = np
      }
      0x28 => {
        if !(props.wildcard_subscription_available is None) {
          return Err(MqttError::DuplicateProperty(0x28))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("wildcard sub available must be 0 or 1"))
        }
        props.wildcard_subscription_available = Some(v)
        p = np
      }
      0x29 => {
        if !(props.subscription_identifier_available is None) {
          return Err(MqttError::DuplicateProperty(0x29))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("sub id available must be 0 or 1"))
        }
        props.subscription_identifier_available = Some(v)
        p = np
      }
      0x2A => {
        if !(props.shared_subscription_available is None) {
          return Err(MqttError::DuplicateProperty(0x2A))
        }
        let (v, np) = match read_u8(data, p, prop_end) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if v != 0 && v != 1 {
          return Err(MqttError::ProtocolViolation("shared sub available must be 0 or 1"))
        }
        props.shared_subscription_available = Some(v)
        p = np
      }
      _ => return Err(MqttError::UnknownProperty(id))
    }
  }
  Ok((props, prop_end))
}

///| Standard OASIS MQTT 5.0 Reason Code names (§2.4).
pub fn reason_code_name(code : Int) -> String {
  match code {
    0x00 => "Success"
    0x01 => "Granted QoS 1"
    0x02 => "Granted QoS 2"
    0x04 => "Disconnect with Will Message"
    0x10 => "No matching subscribers"
    0x11 => "No subscription existed"
    0x18 => "Continue authentication"
    0x19 => "Re-authenticate"
    0x80 => "Unspecified error"
    0x81 => "Malformed Packet"
    0x82 => "Protocol Error"
    0x83 => "Implementation specific error"
    0x84 => "Unsupported Protocol Version"
    0x85 => "Client Identifier not valid"
    0x86 => "Bad User Name or Password"
    0x87 => "Not authorized"
    0x88 => "Server unavailable"
    0x89 => "Server busy"
    0x8A => "Banned"
    0x8B => "Server shutting down"
    0x8C => "Bad authentication method"
    0x8D => "Keep Alive timeout"
    0x8E => "Session taken over"
    0x8F => "Topic Filter invalid"
    0x90 => "Topic Name invalid"
    0x91 => "Packet Identifier in use"
    0x92 => "Packet Identifier not found"
    0x93 => "Receive Maximum exceeded"
    0x94 => "Topic Alias invalid"
    0x95 => "Packet too large"
    0x96 => "Message rate too high"
    0x97 => "Quota exceeded"
    0x98 => "Administrative action"
    0x99 => "Payload format invalid"
    0x9A => "Retain not supported"
    0x9B => "QoS not supported"
    0x9C => "Use another server"
    0x9D => "Server moved"
    0x9E => "Shared Subscriptions not supported"
    0x9F => "Connection rate exceeded"
    0xA0 => "Maximum connect time"
    0xA1 => "Subscription Identifiers not supported"
    0xA2 => "Wildcard Subscriptions not supported"
    _ => "Unknown"
  }
}

///| Validate whether `code` is a standard MQTT 5.0 Reason Code for `pt`.
pub fn is_valid_reason_code(pt : PacketType, code : Int) -> Bool {
  match pt {
    PacketType::ConnAck =>
    code == 0x00 ||
    (code >= 0x80 && code <= 0x8A) ||
    code == 0x8C ||
    code == 0x90 ||
    code == 0x95 ||
    code == 0x97 ||
    (code >= 0x99 && code <= 0x9D) ||
    code == 0x9F
    PacketType::PubAck =>
    code == 0x00 ||
    code == 0x10 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x90 ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x99
    PacketType::PubRec =>
    code == 0x00 ||
    code == 0x10 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x90 ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x99
    PacketType::PubRel => code == 0x00 || code == 0x92
    PacketType::PubComp => code == 0x00 || code == 0x92
    PacketType::SubAck =>
    code == 0x00 ||
    code == 0x01 ||
    code == 0x02 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x8F ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x9E ||
    code == 0xA1 ||
    code == 0xA2
    PacketType::UnsubAck =>
    code == 0x00 ||
    code == 0x11 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x8F ||
    code == 0x91
    PacketType::Disconnect =>
    code == 0x00 ||
    code == 0x04 ||
    (code >= 0x80 && code <= 0x83) ||
    code == 0x87 ||
    code == 0x89 ||
    code == 0x8B ||
    (code >= 0x8D && code <= 0x90) ||
    (code >= 0x93 && code <= 0xA2)
    PacketType::Auth => code == 0x00 || code == 0x18 || code == 0x19
    _ => false
  }
}
