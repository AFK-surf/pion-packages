///| OASIS MQTT 5.0 Properties (all 27 standard properties) and Reason Codes.

///|
pub enum PropertyContext {
  Connect
  Will
  ConnAck
  Publish
  PubAck
  PubRec
  PubRel
  PubComp
  Subscribe
  SubAck
  Unsubscribe
  UnsubAck
  Disconnect
  Auth
}

///|
pub struct Properties {
  pub mut payload_format_indicator : Option[Int]
  pub mut message_expiry_interval : Option[UInt]
  pub mut content_type : Option[String]
  pub mut response_topic : Option[String]
  pub mut correlation_data : Option[Bytes]
  pub mut subscription_identifiers : Array[Int]
  pub mut session_expiry_interval : Option[UInt]
  pub mut assigned_client_identifier : Option[String]
  pub mut server_keep_alive : Option[Int]
  pub mut authentication_method : Option[String]
  pub mut authentication_data : Option[Bytes]
  pub mut request_problem_information : Option[Int]
  pub mut will_delay_interval : Option[UInt]
  pub mut request_response_information : Option[Int]
  pub mut response_information : Option[String]
  pub mut server_reference : Option[String]
  pub mut reason_string : Option[String]
  pub mut receive_maximum : Option[Int]
  pub mut topic_alias_maximum : Option[Int]
  pub mut topic_alias : Option[Int]
  pub mut maximum_qos : Option[Int]
  pub mut retain_available : Option[Int]
  pub mut user_properties : Array[(String, String)]
  pub mut maximum_packet_size : Option[UInt]
  pub mut wildcard_subscription_available : Option[Int]
  pub mut subscription_identifier_available : Option[Int]
  pub mut shared_subscription_available : Option[Int]
}

///|
pub fn Properties::empty() -> Properties {
  Properties::{
    payload_format_indicator: None,
    message_expiry_interval: None,
    content_type: None,
    response_topic: None,
    correlation_data: None,
    subscription_identifiers: [],
    session_expiry_interval: None,
    assigned_client_identifier: None,
    server_keep_alive: None,
    authentication_method: None,
    authentication_data: None,
    request_problem_information: None,
    will_delay_interval: None,
    request_response_information: None,
    response_information: None,
    server_reference: None,
    reason_string: None,
    receive_maximum: None,
    topic_alias_maximum: None,
    topic_alias: None,
    maximum_qos: None,
    retain_available: None,
    user_properties: [],
    maximum_packet_size: None,
    wildcard_subscription_available: None,
    subscription_identifier_available: None,
    shared_subscription_available: None,
  }
}

///| Clone a `Properties` struct so mutations do not alias the original.
pub fn Properties::clone(self : Properties) -> Properties {
  let sids : Array[Int] = []
  let mut i = 0
  while i < self.subscription_identifiers.length() {
    sids.push(self.subscription_identifiers[i])
    i = i + 1
  }
  let ups : Array[(String, String)] = []
  let mut j = 0
  while j < self.user_properties.length() {
    ups.push(self.user_properties[j])
    j = j + 1
  }
  Properties::{
    payload_format_indicator: self.payload_format_indicator,
    message_expiry_interval: self.message_expiry_interval,
    content_type: self.content_type,
    response_topic: self.response_topic,
    correlation_data: self.correlation_data,
    subscription_identifiers: sids,
    session_expiry_interval: self.session_expiry_interval,
    assigned_client_identifier: self.assigned_client_identifier,
    server_keep_alive: self.server_keep_alive,
    authentication_method: self.authentication_method,
    authentication_data: self.authentication_data,
    request_problem_information: self.request_problem_information,
    will_delay_interval: self.will_delay_interval,
    request_response_information: self.request_response_information,
    response_information: self.response_information,
    server_reference: self.server_reference,
    reason_string: self.reason_string,
    receive_maximum: self.receive_maximum,
    topic_alias_maximum: self.topic_alias_maximum,
    topic_alias: self.topic_alias,
    maximum_qos: self.maximum_qos,
    retain_available: self.retain_available,
    user_properties: ups,
    maximum_packet_size: self.maximum_packet_size,
    wildcard_subscription_available: self.wildcard_subscription_available,
    subscription_identifier_available: self.subscription_identifier_available,
    shared_subscription_available: self.shared_subscription_available,
  }
}

///|
pub fn Properties::is_empty(self : Properties) -> Bool {
  self.payload_format_indicator is None &&
  self.message_expiry_interval is None &&
  self.content_type is None &&
  self.response_topic is None &&
  self.correlation_data is None &&
  self.subscription_identifiers.length() == 0 &&
  self.session_expiry_interval is None &&
  self.assigned_client_identifier is None &&
  self.server_keep_alive is None &&
  self.authentication_method is None &&
  self.authentication_data is None &&
  self.request_problem_information is None &&
  self.will_delay_interval is None &&
  self.request_response_information is None &&
  self.response_information is None &&
  self.server_reference is None &&
  self.reason_string is None &&
  self.receive_maximum is None &&
  self.topic_alias_maximum is None &&
  self.topic_alias is None &&
  self.maximum_qos is None &&
  self.retain_available is None &&
  self.user_properties.length() == 0 &&
  self.maximum_packet_size is None &&
  self.wildcard_subscription_available is None &&
  self.subscription_identifier_available is None &&
  self.shared_subscription_available is None
}

///| 64-bit bitmask of all 27 standard MQTT 5.0 property identifiers (`0x01..0x2A`).
let known_prop_mask : Int64 = (1L << 0x01) |
(1L << 0x02) |
(1L << 0x03) |
(1L << 0x08) |
(1L << 0x09) |
(1L << 0x0B) |
(1L << 0x11) |
(1L << 0x12) |
(1L << 0x13) |
(1L << 0x15) |
(1L << 0x16) |
(1L << 0x17) |
(1L << 0x18) |
(1L << 0x19) |
(1L << 0x1A) |
(1L << 0x1C) |
(1L << 0x1F) |
(1L << 0x21) |
(1L << 0x22) |
(1L << 0x23) |
(1L << 0x24) |
(1L << 0x25) |
(1L << 0x26) |
(1L << 0x27) |
(1L << 0x28) |
(1L << 0x29) |
(1L << 0x2A)

///| Per-context 64-bit bitmask of allowed MQTT 5.0 property identifiers (OASIS §2.2.2.2).
fn prop_allowed_mask(ctx : PropertyContext) -> Int64 {
  match ctx {
    PropertyContext::Publish =>
    (1L << 0x01) |
    (1L << 0x02) |
    (1L << 0x03) |
    (1L << 0x08) |
    (1L << 0x09) |
    (1L << 0x0B) |
    (1L << 0x23) |
    (1L << 0x26)
    PropertyContext::Connect =>
    (1L << 0x11) |
    (1L << 0x15) |
    (1L << 0x16) |
    (1L << 0x17) |
    (1L << 0x19) |
    (1L << 0x21) |
    (1L << 0x22) |
    (1L << 0x26) |
    (1L << 0x27)
    PropertyContext::Will =>
    (1L << 0x01) |
    (1L << 0x02) |
    (1L << 0x03) |
    (1L << 0x08) |
    (1L << 0x09) |
    (1L << 0x18) |
    (1L << 0x26)
    PropertyContext::ConnAck =>
    (1L << 0x11) |
    (1L << 0x12) |
    (1L << 0x13) |
    (1L << 0x15) |
    (1L << 0x16) |
    (1L << 0x1A) |
    (1L << 0x1C) |
    (1L << 0x1F) |
    (1L << 0x21) |
    (1L << 0x22) |
    (1L << 0x24) |
    (1L << 0x25) |
    (1L << 0x26) |
    (1L << 0x27) |
    (1L << 0x28) |
    (1L << 0x29) |
    (1L << 0x2A)
    PropertyContext::Subscribe => (1L << 0x0B) | (1L << 0x26)
    PropertyContext::Unsubscribe => (1L << 0x26)
    PropertyContext::PubAck => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::PubRec => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::PubRel => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::PubComp => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::SubAck => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::UnsubAck => (1L << 0x1F) | (1L << 0x26)
    PropertyContext::Disconnect =>
    (1L << 0x11) | (1L << 0x1C) | (1L << 0x1F) | (1L << 0x26)
    PropertyContext::Auth =>
    (1L << 0x15) | (1L << 0x16) | (1L << 0x1F) | (1L << 0x26)
  }
}

///| Fast unboxed Publish property length & validation check.
///| Returns encoded `prop_len >= 0` if valid, or `-1` on any error (caller falls back to `measure_and_validate_properties`).
fn measure_publish_properties_fast(props : Properties) -> Int {
  // Fast reject if any non-Publish property is set.
  if !(props.session_expiry_interval is None) ||
  !(props.assigned_client_identifier is None) ||
  !(props.server_keep_alive is None) ||
  !(props.authentication_method is None) ||
  !(props.authentication_data is None) ||
  !(props.request_problem_information is None) ||
  !(props.will_delay_interval is None) ||
  !(props.request_response_information is None) ||
  !(props.response_information is None) ||
  !(props.server_reference is None) ||
  !(props.reason_string is None) ||
  !(props.receive_maximum is None) ||
  !(props.topic_alias_maximum is None) ||
  !(props.maximum_qos is None) ||
  !(props.retain_available is None) ||
  !(props.maximum_packet_size is None) ||
  !(props.wildcard_subscription_available is None) ||
  !(props.subscription_identifier_available is None) ||
  !(props.shared_subscription_available is None) {
    return -1
  }
  let mut total = 0
  match props.payload_format_indicator {
    Some(v) => {
      if v != 0 && v != 1 {
        return -1
      }
      total = total + 2
    }
    None => ()
  }
  match props.message_expiry_interval {
    Some(_) => total = total + 5
    None => ()
  }
  match props.content_type {
    Some(s) => {
      let n = s.length()
      if n > 65535 || !is_valid_mqtt_utf8_str_range(s, 0, n) {
        return -1
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.response_topic {
    Some(s) => {
      let n = s.length()
      if n > 65535 || !is_valid_mqtt_utf8_str_range(s, 0, n) {
        return -1
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.correlation_data {
    Some(b) => {
      let n = b.length()
      if n > 65535 {
        return -1
      }
      total = total + 3 + n
    }
    None => ()
  }
  let sids = props.subscription_identifiers
  let sids_len = sids.length()
  if sids_len > 0 {
    let mut si = 0
    while si < sids_len {
      let sid = sids[si]
      if sid <= 0 || sid > 268435455 {
        return -1
      }
      total = total + 1 + vbi_encoded_len(sid)
      si = si + 1
    }
  }
  match props.topic_alias {
    Some(v) => {
      if v < 1 || v > 65535 {
        return -1
      }
      total = total + 3
    }
    None => ()
  }
  let ups = props.user_properties
  let ups_len = ups.length()
  let mut ui = 0
  while ui < ups_len {
    let (k, v) = ups[ui]
    let kn = k.length()
    let vn = v.length()
    if kn > 65535 || vn > 65535 ||
    !is_valid_mqtt_utf8_str_range(k, 0, kn) ||
    !is_valid_mqtt_utf8_str_range(v, 0, vn) {
      return -1
    }
    total = total + 5 + kn + vn
    ui = ui + 1
  }
  if vbi_encoded_len(total) == 0 {
    return -1
  }
  total
}

///| Validate and compute the exact encoded byte length of MQTT 5.0 `Properties` (excluding Property Length VBI).
fn measure_and_validate_properties(
  props : Properties,
  ctx : PropertyContext,
) -> Result[Int, MqttError] {
  let allowed = prop_allowed_mask(ctx)
  let mut total = 0
  match props.payload_format_indicator {
    Some(v) => {
      if (allowed & (1L << 0x01)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x01))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("payload format indicator must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.message_expiry_interval {
    Some(_) => {
      if (allowed & (1L << 0x02)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x02))
      }
      total = total + 5
    }
    None => ()
  }
  match props.content_type {
    Some(s) => {
      if (allowed & (1L << 0x03)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x03))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.response_topic {
    Some(s) => {
      if (allowed & (1L << 0x08)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x08))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.correlation_data {
    Some(b) => {
      if (allowed & (1L << 0x09)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x09))
      }
      let n = b.length()
      if n > 65535 {
        return Err(MqttError::ProtocolViolation("binary data exceeds 65535 bytes"))
      }
      total = total + 3 + n
    }
    None => ()
  }
  let sids = props.subscription_identifiers
  let sids_len = sids.length()
  if sids_len > 0 {
    if (allowed & (1L << 0x0B)) == 0L {
      return Err(MqttError::InvalidPropertyForPacket(0x0B))
    }
    if ctx is PropertyContext::Subscribe && sids_len > 1 {
      return Err(MqttError::DuplicateProperty(0x0B))
    }
    let mut si = 0
    while si < sids_len {
      let sid = sids[si]
      if sid <= 0 || sid > 268435455 {
        return Err(MqttError::ProtocolViolation("subscription identifier must be 1..268435455"))
      }
      total = total + 1 + vbi_encoded_len(sid)
      si = si + 1
    }
  }
  match props.session_expiry_interval {
    Some(_) => {
      if (allowed & (1L << 0x11)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x11))
      }
      total = total + 5
    }
    None => ()
  }
  match props.assigned_client_identifier {
    Some(s) => {
      if (allowed & (1L << 0x12)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x12))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.server_keep_alive {
    Some(v) => {
      if (allowed & (1L << 0x13)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x13))
      }
      if v < 0 || v > 65535 {
        return Err(MqttError::ProtocolViolation("server keep alive out of range"))
      }
      total = total + 3
    }
    None => ()
  }
  match props.authentication_method {
    Some(s) => {
      if (allowed & (1L << 0x15)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x15))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.authentication_data {
    Some(b) => {
      if (allowed & (1L << 0x16)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x16))
      }
      if props.authentication_method is None {
        return Err(
          MqttError::ProtocolViolation(
            "authentication data without authentication method",
          ),
        )
      }
      let n = b.length()
      if n > 65535 {
        return Err(MqttError::ProtocolViolation("binary data exceeds 65535 bytes"))
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.request_problem_information {
    Some(v) => {
      if (allowed & (1L << 0x17)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x17))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("request problem info must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.will_delay_interval {
    Some(_) => {
      if (allowed & (1L << 0x18)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x18))
      }
      total = total + 5
    }
    None => ()
  }
  match props.request_response_information {
    Some(v) => {
      if (allowed & (1L << 0x19)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x19))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("request response info must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.response_information {
    Some(s) => {
      if (allowed & (1L << 0x1A)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x1A))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.server_reference {
    Some(s) => {
      if (allowed & (1L << 0x1C)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x1C))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.reason_string {
    Some(s) => {
      if (allowed & (1L << 0x1F)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x1F))
      }
      let n = match check_encode_mqtt_str(s) {
        Ok(len) => len
        Err(e) => return Err(e)
      }
      total = total + 3 + n
    }
    None => ()
  }
  match props.receive_maximum {
    Some(v) => {
      if (allowed & (1L << 0x21)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x21))
      }
      if v < 1 || v > 65535 {
        return Err(MqttError::ProtocolViolation("receive maximum must be 1..65535"))
      }
      total = total + 3
    }
    None => ()
  }
  match props.topic_alias_maximum {
    Some(v) => {
      if (allowed & (1L << 0x22)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x22))
      }
      if v < 0 || v > 65535 {
        return Err(MqttError::ProtocolViolation("topic alias maximum out of range"))
      }
      total = total + 3
    }
    None => ()
  }
  match props.topic_alias {
    Some(v) => {
      if (allowed & (1L << 0x23)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x23))
      }
      if v < 1 || v > 65535 {
        return Err(MqttError::ProtocolViolation("topic alias must be 1..65535"))
      }
      total = total + 3
    }
    None => ()
  }
  match props.maximum_qos {
    Some(v) => {
      if (allowed & (1L << 0x24)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x24))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("maximum qos must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.retain_available {
    Some(v) => {
      if (allowed & (1L << 0x25)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x25))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("retain available must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  let ups = props.user_properties
  let ups_len = ups.length()
  let mut ui = 0
  while ui < ups_len {
    let (k, v) = ups[ui]
    let kn = match check_encode_mqtt_str(k) {
      Ok(len) => len
      Err(e) => return Err(e)
    }
    let vn = match check_encode_mqtt_str(v) {
      Ok(len) => len
      Err(e) => return Err(e)
    }
    total = total + 5 + kn + vn
    ui = ui + 1
  }
  match props.maximum_packet_size {
    Some(v) => {
      if (allowed & (1L << 0x27)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x27))
      }
      if v == 0U {
        return Err(MqttError::ProtocolViolation("maximum packet size cannot be 0"))
      }
      total = total + 5
    }
    None => ()
  }
  match props.wildcard_subscription_available {
    Some(v) => {
      if (allowed & (1L << 0x28)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x28))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("wildcard sub available must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.subscription_identifier_available {
    Some(v) => {
      if (allowed & (1L << 0x29)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x29))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("sub id available must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  match props.shared_subscription_available {
    Some(v) => {
      if (allowed & (1L << 0x2A)) == 0L {
        return Err(MqttError::InvalidPropertyForPacket(0x2A))
      }
      if v != 0 && v != 1 {
        return Err(MqttError::ProtocolViolation("shared sub available must be 0 or 1"))
      }
      total = total + 2
    }
    None => ()
  }
  if vbi_encoded_len(total) == 0 {
    return Err(MqttError::MalformedVbi)
  }
  Ok(total)
}

///| Write pre-validated MQTT 5.0 Properties directly to `StringBuilder` (zero intermediate buffer).
fn write_properties_to_sb(
  sb : StringBuilder,
  props : Properties,
  prop_len : Int,
  ctx : PropertyContext,
) -> Unit {
  sb_write_vbi(sb, prop_len)
  if prop_len == 0 {
    return ()
  }
  if ctx is PropertyContext::Publish {
    match props.payload_format_indicator {
      Some(v) => {
        sb.write_byte((0x01).to_byte())
        sb.write_byte(v.to_byte())
      }
      None => ()
    }
    match props.message_expiry_interval {
      Some(v) => {
        sb.write_byte((0x02).to_byte())
        sb_write_u32(sb, v)
      }
      None => ()
    }
    match props.content_type {
      Some(s) => {
        sb.write_byte((0x03).to_byte())
        sb_write_mqtt_str_raw(sb, s)
      }
      None => ()
    }
    match props.response_topic {
      Some(s) => {
        sb.write_byte((0x08).to_byte())
        sb_write_mqtt_str_raw(sb, s)
      }
      None => ()
    }
    match props.correlation_data {
      Some(b) => {
        sb.write_byte((0x09).to_byte())
        sb_write_bin_data_raw(sb, b)
      }
      None => ()
    }
    let sids = props.subscription_identifiers
    let mut si = 0
    while si < sids.length() {
      sb.write_byte((0x0B).to_byte())
      sb_write_vbi(sb, sids[si])
      si = si + 1
    }
    match props.topic_alias {
      Some(v) => {
        sb.write_byte((0x23).to_byte())
        sb_write_u16(sb, v)
      }
      None => ()
    }
    let ups = props.user_properties
    let mut ui = 0
    while ui < ups.length() {
      let (k, v) = ups[ui]
      sb.write_byte((0x26).to_byte())
      sb_write_mqtt_str_raw(sb, k)
      sb_write_mqtt_str_raw(sb, v)
      ui = ui + 1
    }
    return ()
  }
  match props.payload_format_indicator {
    Some(v) => {
      sb.write_byte((0x01).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.message_expiry_interval {
    Some(v) => {
      sb.write_byte((0x02).to_byte())
      sb_write_u32(sb, v)
    }
    None => ()
  }
  match props.content_type {
    Some(s) => {
      sb.write_byte((0x03).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.response_topic {
    Some(s) => {
      sb.write_byte((0x08).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.correlation_data {
    Some(b) => {
      sb.write_byte((0x09).to_byte())
      sb_write_bin_data_raw(sb, b)
    }
    None => ()
  }
  let sids = props.subscription_identifiers
  let mut si = 0
  while si < sids.length() {
    sb.write_byte((0x0B).to_byte())
    sb_write_vbi(sb, sids[si])
    si = si + 1
  }
  match props.session_expiry_interval {
    Some(v) => {
      sb.write_byte((0x11).to_byte())
      sb_write_u32(sb, v)
    }
    None => ()
  }
  match props.assigned_client_identifier {
    Some(s) => {
      sb.write_byte((0x12).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.server_keep_alive {
    Some(v) => {
      sb.write_byte((0x13).to_byte())
      sb_write_u16(sb, v)
    }
    None => ()
  }
  match props.authentication_method {
    Some(s) => {
      sb.write_byte((0x15).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.authentication_data {
    Some(b) => {
      sb.write_byte((0x16).to_byte())
      sb_write_bin_data_raw(sb, b)
    }
    None => ()
  }
  match props.request_problem_information {
    Some(v) => {
      sb.write_byte((0x17).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.will_delay_interval {
    Some(v) => {
      sb.write_byte((0x18).to_byte())
      sb_write_u32(sb, v)
    }
    None => ()
  }
  match props.request_response_information {
    Some(v) => {
      sb.write_byte((0x19).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.response_information {
    Some(s) => {
      sb.write_byte((0x1A).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.server_reference {
    Some(s) => {
      sb.write_byte((0x1C).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.reason_string {
    Some(s) => {
      sb.write_byte((0x1F).to_byte())
      sb_write_mqtt_str_raw(sb, s)
    }
    None => ()
  }
  match props.receive_maximum {
    Some(v) => {
      sb.write_byte((0x21).to_byte())
      sb_write_u16(sb, v)
    }
    None => ()
  }
  match props.topic_alias_maximum {
    Some(v) => {
      sb.write_byte((0x22).to_byte())
      sb_write_u16(sb, v)
    }
    None => ()
  }
  match props.topic_alias {
    Some(v) => {
      sb.write_byte((0x23).to_byte())
      sb_write_u16(sb, v)
    }
    None => ()
  }
  match props.maximum_qos {
    Some(v) => {
      sb.write_byte((0x24).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.retain_available {
    Some(v) => {
      sb.write_byte((0x25).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  let ups = props.user_properties
  let mut ui = 0
  while ui < ups.length() {
    let (k, v) = ups[ui]
    sb.write_byte((0x26).to_byte())
    sb_write_mqtt_str_raw(sb, k)
    sb_write_mqtt_str_raw(sb, v)
    ui = ui + 1
  }
  match props.maximum_packet_size {
    Some(v) => {
      sb.write_byte((0x27).to_byte())
      sb_write_u32(sb, v)
    }
    None => ()
  }
  match props.wildcard_subscription_available {
    Some(v) => {
      sb.write_byte((0x28).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.subscription_identifier_available {
    Some(v) => {
      sb.write_byte((0x29).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
  match props.shared_subscription_available {
    Some(v) => {
      sb.write_byte((0x2A).to_byte())
      sb.write_byte(v.to_byte())
    }
    None => ()
  }
}

///| Zero-boxing MQTT 5.0 Properties decoder over `String` `[cursor.pos, end)`.
///| Updates `cursor.pos` to the end of the properties section; sets `cursor.err` on error.
fn decode_properties_str(
  data : String,
  cursor : DecodeCursor,
  end : Int,
  ctx : PropertyContext,
  max_properties : Int,
) -> Properties {
  let p0 = cursor.pos
  if p0 >= end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return Properties::empty()
  }
  let b0 = data.code_unit_at(p0)
  let mut prop_len = 0
  let mut start = 0
  if b0 < 0x80 {
    prop_len = b0
    start = p0 + 1
  } else {
    let v = decode_vbi_multi_str(data, p0, end, b0, cursor)
    if v < 0 {
      if v == -1 {
        cursor.err = Some(MqttError::UnexpectedEof)
      }
      return Properties::empty()
    }
    prop_len = v
    start = cursor.pos
  }
  let prop_end = start + prop_len
  if prop_end > end {
    cursor.err = Some(MqttError::UnexpectedEof)
    return Properties::empty()
  }
  let props = Properties::empty()
  if prop_len == 0 {
    cursor.pos = prop_end
    return props
  }
  let allowed = prop_allowed_mask(ctx)
  let mut seen : Int64 = 0L
  let mut p = start
  let mut count = 0
  while p < prop_end {
    count = count + 1
    if count > max_properties {
      cursor.err = Some(MqttError::PropertyCountExceeded(count))
      return props
    }
    let ib0 = data.code_unit_at(p)
    let mut id = 0
    if ib0 < 0x80 {
      id = ib0
      p = p + 1
    } else {
      let v = decode_vbi_multi_str(data, p, prop_end, ib0, cursor)
      if v < 0 {
        if v == -1 {
          cursor.err = Some(MqttError::UnexpectedEof)
        }
        return props
      }
      id = v
      p = cursor.pos
    }
    if id > 42 || ((known_prop_mask >> id) & 1L) == 0L {
      cursor.err = Some(MqttError::UnknownProperty(id))
      return props
    }
    let bit = 1L << id
    if (allowed & bit) == 0L {
      cursor.err = Some(MqttError::InvalidPropertyForPacket(id))
      return props
    }
    if id != 0x0B && id != 0x26 {
      if (seen & bit) != 0L {
        cursor.err = Some(MqttError::DuplicateProperty(id))
        return props
      }
      seen = seen | bit
    }
    match id {
      0x01 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("payload format indicator must be 0 or 1"))
          return props
        }
        props.payload_format_indicator = Some(v)
        p = p + 1
      }
      0x02 => {
        if p + 4 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p).to_uint() << 24) |
        (data.code_unit_at(p + 1).to_uint() << 16) |
        (data.code_unit_at(p + 2).to_uint() << 8) |
        data.code_unit_at(p + 3).to_uint()
        props.message_expiry_interval = Some(v)
        p = p + 4
      }
      0x03 => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.content_type = Some(s)
        p = cursor.pos
      }
      0x08 => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.response_topic = Some(s)
        p = cursor.pos
      }
      0x09 => {
        cursor.pos = p
        let b = read_bin_data_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.correlation_data = Some(b)
        p = cursor.pos
      }
      0x0B => {
        if ctx is PropertyContext::Subscribe && props.subscription_identifiers.length() > 0 {
          cursor.err = Some(MqttError::DuplicateProperty(0x0B))
          return props
        }
        if p >= prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let sb0 = data.code_unit_at(p)
        let mut sid = 0
        if sb0 < 0x80 {
          sid = sb0
          p = p + 1
        } else {
          let v = decode_vbi_multi_str(data, p, prop_end, sb0, cursor)
          if v < 0 {
            if v == -1 {
              cursor.err = Some(MqttError::UnexpectedEof)
            }
            return props
          }
          sid = v
          p = cursor.pos
        }
        if sid <= 0 {
          cursor.err = Some(MqttError::ProtocolViolation("subscription identifier cannot be 0"))
          return props
        }
        props.subscription_identifiers.push(sid)
      }
      0x11 => {
        if p + 4 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p).to_uint() << 24) |
        (data.code_unit_at(p + 1).to_uint() << 16) |
        (data.code_unit_at(p + 2).to_uint() << 8) |
        data.code_unit_at(p + 3).to_uint()
        props.session_expiry_interval = Some(v)
        p = p + 4
      }
      0x12 => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.assigned_client_identifier = Some(s)
        p = cursor.pos
      }
      0x13 => {
        if p + 2 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        props.server_keep_alive = Some((data.code_unit_at(p) << 8) | data.code_unit_at(p + 1))
        p = p + 2
      }
      0x15 => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.authentication_method = Some(s)
        p = cursor.pos
      }
      0x16 => {
        cursor.pos = p
        let b = read_bin_data_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.authentication_data = Some(b)
        p = cursor.pos
      }
      0x17 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("request problem info must be 0 or 1"))
          return props
        }
        props.request_problem_information = Some(v)
        p = p + 1
      }
      0x18 => {
        if p + 4 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p).to_uint() << 24) |
        (data.code_unit_at(p + 1).to_uint() << 16) |
        (data.code_unit_at(p + 2).to_uint() << 8) |
        data.code_unit_at(p + 3).to_uint()
        props.will_delay_interval = Some(v)
        p = p + 4
      }
      0x19 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("request response info must be 0 or 1"))
          return props
        }
        props.request_response_information = Some(v)
        p = p + 1
      }
      0x1A => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.response_information = Some(s)
        p = cursor.pos
      }
      0x1C => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.server_reference = Some(s)
        p = cursor.pos
      }
      0x1F => {
        cursor.pos = p
        let s = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.reason_string = Some(s)
        p = cursor.pos
      }
      0x21 => {
        if p + 2 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p) << 8) | data.code_unit_at(p + 1)
        if v == 0 {
          cursor.err = Some(MqttError::ProtocolViolation("receive maximum cannot be 0"))
          return props
        }
        props.receive_maximum = Some(v)
        p = p + 2
      }
      0x22 => {
        if p + 2 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        props.topic_alias_maximum = Some((data.code_unit_at(p) << 8) | data.code_unit_at(p + 1))
        p = p + 2
      }
      0x23 => {
        if p + 2 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p) << 8) | data.code_unit_at(p + 1)
        if v == 0 {
          cursor.err = Some(MqttError::ProtocolViolation("topic alias cannot be 0"))
          return props
        }
        props.topic_alias = Some(v)
        p = p + 2
      }
      0x24 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("maximum qos must be 0 or 1"))
          return props
        }
        props.maximum_qos = Some(v)
        p = p + 1
      }
      0x25 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("retain available must be 0 or 1"))
          return props
        }
        props.retain_available = Some(v)
        p = p + 1
      }
      0x26 => {
        cursor.pos = p
        let k = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        let v = read_mqtt_str_from_str(data, cursor, prop_end)
        if !(cursor.err is None) {
          return props
        }
        props.user_properties.push((k, v))
        p = cursor.pos
      }
      0x27 => {
        if p + 4 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = (data.code_unit_at(p).to_uint() << 24) |
        (data.code_unit_at(p + 1).to_uint() << 16) |
        (data.code_unit_at(p + 2).to_uint() << 8) |
        data.code_unit_at(p + 3).to_uint()
        if v == 0U {
          cursor.err = Some(MqttError::ProtocolViolation("maximum packet size cannot be 0"))
          return props
        }
        props.maximum_packet_size = Some(v)
        p = p + 4
      }
      0x28 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("wildcard sub available must be 0 or 1"))
          return props
        }
        props.wildcard_subscription_available = Some(v)
        p = p + 1
      }
      0x29 => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("sub id available must be 0 or 1"))
          return props
        }
        props.subscription_identifier_available = Some(v)
        p = p + 1
      }
      0x2A => {
        if p + 1 > prop_end {
          cursor.err = Some(MqttError::UnexpectedEof)
          return props
        }
        let v = data.code_unit_at(p)
        if v != 0 && v != 1 {
          cursor.err = Some(MqttError::ProtocolViolation("shared sub available must be 0 or 1"))
          return props
        }
        props.shared_subscription_available = Some(v)
        p = p + 1
      }
      _ => {
        cursor.err = Some(MqttError::UnknownProperty(id))
        return props
      }
    }
  }
  if (seen & (1L << 0x16)) != 0L && (seen & (1L << 0x15)) == 0L {
    cursor.err = Some(
      MqttError::ProtocolViolation(
        "authentication data without authentication method",
      ),
    )
    return props
  }
  cursor.pos = prop_end
  props
}

///| Standard OASIS MQTT 5.0 Reason Code names (§2.4).
pub fn reason_code_name(code : Int) -> String {
  match code {
    0x00 => "Success"
    0x01 => "Granted QoS 1"
    0x02 => "Granted QoS 2"
    0x04 => "Disconnect with Will Message"
    0x10 => "No matching subscribers"
    0x11 => "No subscription existed"
    0x18 => "Continue authentication"
    0x19 => "Re-authenticate"
    0x80 => "Unspecified error"
    0x81 => "Malformed Packet"
    0x82 => "Protocol Error"
    0x83 => "Implementation specific error"
    0x84 => "Unsupported Protocol Version"
    0x85 => "Client Identifier not valid"
    0x86 => "Bad User Name or Password"
    0x87 => "Not authorized"
    0x88 => "Server unavailable"
    0x89 => "Server busy"
    0x8A => "Banned"
    0x8B => "Server shutting down"
    0x8C => "Bad authentication method"
    0x8D => "Keep Alive timeout"
    0x8E => "Session taken over"
    0x8F => "Topic Filter invalid"
    0x90 => "Topic Name invalid"
    0x91 => "Packet Identifier in use"
    0x92 => "Packet Identifier not found"
    0x93 => "Receive Maximum exceeded"
    0x94 => "Topic Alias invalid"
    0x95 => "Packet too large"
    0x96 => "Message rate too high"
    0x97 => "Quota exceeded"
    0x98 => "Administrative action"
    0x99 => "Payload format invalid"
    0x9A => "Retain not supported"
    0x9B => "QoS not supported"
    0x9C => "Use another server"
    0x9D => "Server moved"
    0x9E => "Shared Subscriptions not supported"
    0x9F => "Connection rate exceeded"
    0xA0 => "Maximum connect time"
    0xA1 => "Subscription Identifiers not supported"
    0xA2 => "Wildcard Subscriptions not supported"
    _ => "Unknown"
  }
}

///| Validate whether `code` is a standard MQTT 5.0 Reason Code for `pt`.
pub fn is_valid_reason_code(pt : PacketType, code : Int) -> Bool {
  match pt {
    PacketType::ConnAck =>
    code == 0x00 ||
    (code >= 0x80 && code <= 0x8A) ||
    code == 0x8C ||
    code == 0x90 ||
    code == 0x95 ||
    code == 0x97 ||
    (code >= 0x99 && code <= 0x9D) ||
    code == 0x9F
    PacketType::PubAck =>
    code == 0x00 ||
    code == 0x10 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x90 ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x99
    PacketType::PubRec =>
    code == 0x00 ||
    code == 0x10 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x90 ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x99
    PacketType::PubRel => code == 0x00 || code == 0x92
    PacketType::PubComp => code == 0x00 || code == 0x92
    PacketType::SubAck =>
    code == 0x00 ||
    code == 0x01 ||
    code == 0x02 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x8F ||
    code == 0x91 ||
    code == 0x97 ||
    code == 0x9E ||
    code == 0xA1 ||
    code == 0xA2
    PacketType::UnsubAck =>
    code == 0x00 ||
    code == 0x11 ||
    code == 0x80 ||
    code == 0x83 ||
    code == 0x87 ||
    code == 0x8F ||
    code == 0x91
    PacketType::Disconnect =>
    code == 0x00 ||
    code == 0x04 ||
    (code >= 0x80 && code <= 0x83) ||
    code == 0x87 ||
    code == 0x89 ||
    code == 0x8B ||
    (code >= 0x8D && code <= 0x90) ||
    (code >= 0x93 && code <= 0xA2)
    PacketType::Auth => code == 0x00 || code == 0x18 || code == 0x19
    _ => false
  }
}
