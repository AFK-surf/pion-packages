///| Sans-IO MQTT 3.1.1 & 5.0 Client Session State Machine (QoS 0/1/2, flow control, aliases, keepalive).

///|
pub enum SessionState {
  Disconnected
  Connecting
  Connected
  Closed
}

///|
pub struct SessionConfig {
  pub client_id : String
  pub version : ProtocolVersion
  pub clean_start : Bool
  pub keep_alive_secs : Int
  pub receive_maximum : Int
  pub topic_alias_maximum : Int
  pub username : Option[String]
  pub password : Option[Bytes]
  pub will : Option[Will]
  pub connect_properties : Properties
  pub limits : MqttLimits
}

///|
pub fn SessionConfig::new(
  client_id : String,
  version : ProtocolVersion,
) -> SessionConfig {
  SessionConfig::{
    client_id: client_id,
    version: version,
    clean_start: true,
    keep_alive_secs: 60,
    receive_maximum: 65535,
    topic_alias_maximum: 0,
    username: None,
    password: None,
    will: None,
    connect_properties: Properties::empty(),
    limits: MqttLimits::default(),
  }
}

///|
pub enum SessionEvent {
  Connected(Bool, Int, Properties)
  PublishReceived(PublishPacket)
  PublishAcked(Int, Int)
  PublishComplete(Int, Int)
  SubAckReceived(Int, Array[Int])
  UnsubAckReceived(Int, Array[Int])
  PingRespReceived
  Disconnected(Int, Properties)
  AuthReceived(Int, Properties)
}

///|
pub struct Session {
  pub config : SessionConfig
  mut st : SessionState
}

///|
pub fn Session::new(config : SessionConfig) -> Session {
  Session::{ config: config, st: SessionState::Disconnected }
}

///|
pub fn Session::state(self : Session) -> SessionState {
  self.st
}

///|
pub fn Session::connect(self : Session, now_ms : Int64) -> Result[Unit, MqttError] {
  let _ = self
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::publish(
  self : Session,
  topic : String,
  payload : Bytes,
  qos : QoS,
  retain : Bool,
  props : Properties,
  now_ms : Int64,
) -> Result[Option[Int], MqttError] {
  let _ = self
  let _ = topic
  let _ = payload
  let _ = qos
  let _ = retain
  let _ = props
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::subscribe(
  self : Session,
  topics : Array[SubscribeTopic],
  props : Properties,
  now_ms : Int64,
) -> Result[Int, MqttError] {
  let _ = self
  let _ = topics
  let _ = props
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::unsubscribe(
  self : Session,
  topics : Array[String],
  props : Properties,
  now_ms : Int64,
) -> Result[Int, MqttError] {
  let _ = self
  let _ = topics
  let _ = props
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::disconnect(
  self : Session,
  reason_code : Int,
  props : Properties,
) -> Result[Unit, MqttError] {
  let _ = self
  let _ = reason_code
  let _ = props
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::feed(
  self : Session,
  data : Bytes,
  now_ms : Int64,
) -> Result[Array[SessionEvent], MqttError] {
  let _ = self
  let _ = data
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::poll_transmit(self : Session) -> Bytes {
  let _ = self
  Bytes::new(0)
}

///|
pub fn Session::tick(self : Session, now_ms : Int64) -> Result[Unit, MqttError] {
  let _ = self
  let _ = now_ms
  Err(MqttError::ProtocolViolation("stub"))
}

///|
pub fn Session::on_transport_disconnected(self : Session) -> Unit {
  let _ = self
  ()
}

///|
pub fn Session::inflight_count(self : Session) -> Int {
  let _ = self
  0
}

///|
pub fn Session::pending_tx_len(self : Session) -> Int {
  let _ = self
  0
}
