///| High-performance level-indexed MQTT Topic Trie router (`O(depth)` matching, `$` safe,
///| generation-stamped O(1) deduplication).

///|
struct TrieNode {
  children : Map[String, Int]
  mut plus_child : Int
  hash_ids : Array[Int]
  exact_ids : Array[Int]
}

///|
fn TrieNode::new() -> TrieNode {
  TrieNode::{
    children: Map::new(),
    plus_child: -1,
    hash_ids: [],
    exact_ids: [],
  }
}

///|
pub struct TopicTrie[T] {
  nodes : Array[TrieNode]
  entry_keys : Array[Int]
  entry_values : Array[T]
  mut count : Int
  seen_gen : Map[Int, Int]
  mut gen : Int
}

///|
pub fn TopicTrie::new[T]() -> TopicTrie[T] {
  TopicTrie::{
    nodes: [TrieNode::new()],
    entry_keys: [],
    entry_values: [],
    count: 0,
    seen_gen: Map::new(),
    gen: 0,
  }
}

///|
pub fn TopicTrie::len[T](self : TopicTrie[T]) -> Int {
  self.count
}

///| Split a topic or filter string by `/` into level slices.
fn split_levels(s : String) -> Array[String] {
  let b = s.to_bytes()
  let n = b.length()
  let levels : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < n {
    if b[i].to_int() == 0x2F {
      if i == start {
        levels.push("")
      } else {
        levels.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if start == n {
    levels.push("")
  } else {
    levels.push(b.slice(start, n).to_string())
  }
  levels
}

///| Strip `$share/{group}/` prefix if present after validation.
fn normalize_filter_for_trie(filter : String) -> Result[String, MqttError] {
  match parse_shared_subscription(filter) {
    Ok(Some(s)) => Ok(s.filter)
    Ok(None) =>
    match validate_topic_filter(filter) {
      Ok(_) => Ok(filter)
      Err(e) => Err(e)
    }
    Err(e) => Err(e)
  }
}

///| Insert a subscription without deduplication key (`key = -1`).
pub fn TopicTrie::insert[T](
  self : TopicTrie[T],
  filter : String,
  value : T,
) -> Result[Unit, MqttError] {
  self.insert_with_key(filter, -1, value)
}

///| Insert a subscription with a deduplication `key` (`key >= 0` deduplicates hits with the same key).
pub fn TopicTrie::insert_with_key[T](
  self : TopicTrie[T],
  filter : String,
  key : Int,
  value : T,
) -> Result[Unit, MqttError] {
  let norm = match normalize_filter_for_trie(filter) {
    Ok(f) => f
    Err(e) => return Err(e)
  }
  let levels = split_levels(norm)
  let mut cur = 0
  let mut i = 0
  let n = levels.length()
  while i < n {
    let seg = levels[i]
    if seg == "#" {
      let eid = self.entry_keys.length()
      self.entry_keys.push(key)
      self.entry_values.push(value)
      self.nodes[cur].hash_ids.push(eid)
      self.count = self.count + 1
      return Ok(())
    } else if seg == "+" {
      let mut nxt = self.nodes[cur].plus_child
      if nxt < 0 {
        nxt = self.nodes.length()
        self.nodes.push(TrieNode::new())
        self.nodes[cur].plus_child = nxt
      }
      cur = nxt
    } else {
      match self.nodes[cur].children.get(seg) {
        Some(nxt) => cur = nxt
        None => {
          let nxt = self.nodes.length()
          self.nodes.push(TrieNode::new())
          self.nodes[cur].children.set(seg, nxt)
          cur = nxt
        }
      }
    }
    i = i + 1
  }
  let eid = self.entry_keys.length()
  self.entry_keys.push(key)
  self.entry_values.push(value)
  self.nodes[cur].exact_ids.push(eid)
  self.count = self.count + 1
  Ok(())
}

///| Remove the first entry matching `(filter, key)` from the trie.
pub fn TopicTrie::remove[T](
  self : TopicTrie[T],
  filter : String,
  key : Int,
) -> Bool {
  let norm = match normalize_filter_for_trie(filter) {
    Ok(f) => f
    Err(_) => return false
  }
  let levels = split_levels(norm)
  let mut cur = 0
  let mut i = 0
  let n = levels.length()
  let mut is_hash = false
  while i < n {
    let seg = levels[i]
    if seg == "#" {
      is_hash = true
      break
    } else if seg == "+" {
      let nxt = self.nodes[cur].plus_child
      if nxt < 0 {
        return false
      }
      cur = nxt
    } else {
      match self.nodes[cur].children.get(seg) {
        Some(nxt) => cur = nxt
        None => return false
      }
    }
    i = i + 1
  }
  let arr = if is_hash {
    self.nodes[cur].hash_ids
  } else {
    self.nodes[cur].exact_ids
  }
  let mut idx = -1
  let mut j = 0
  while j < arr.length() {
    let eid = arr[j]
    if self.entry_keys[eid] == key {
      idx = j
      break
    }
    j = j + 1
  }
  if idx < 0 {
    return false
  }
  let last = arr.length() - 1
  if idx != last {
    arr[idx] = arr[last]
  }
  let _ = arr.pop()
  self.count = self.count - 1
  true
}

///| Internal collector helper with generation-stamped dedup.
fn TopicTrie::collect_entries[T](
  self : TopicTrie[T],
  ids : Array[Int],
  out : Array[T],
) -> Unit {
  let mut i = 0
  let n = ids.length()
  let g = self.gen
  while i < n {
    let eid = ids[i]
    let k = self.entry_keys[eid]
    if k >= 0 {
      match self.seen_gen.get(k) {
        Some(prev) =>
        if prev == g {
          i = i + 1
          continue
        }
        None => ()
      }
      self.seen_gen.set(k, g)
    }
    out.push(self.entry_values[eid])
    i = i + 1
  }
}

///| Iterative stack-based traversal of the trie for `levels` (zero recursion overhead).
pub fn TopicTrie::match_topic[T](self : TopicTrie[T], topic : String) -> Array[T] {
  let out : Array[T] = []
  let tb = topic.to_bytes()
  if tb.length() == 0 {
    return out
  }
  self.gen = self.gen + 1
  let is_dollar = tb[0].to_int() == 0x24
  let levels = split_levels(topic)
  let nlevels = levels.length()
  let stack_node : Array[Int] = [0]
  let stack_idx : Array[Int] = [0]
  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let node_idx = stack_node[top]
    let idx = stack_idx[top]
    let _ = stack_node.pop()
    let _ = stack_idx.pop()
    let node = self.nodes[node_idx]
    if !(node_idx == 0 && is_dollar) && node.hash_ids.length() > 0 {
      self.collect_entries(node.hash_ids, out)
    }
    if idx == nlevels {
      if node.exact_ids.length() > 0 {
        self.collect_entries(node.exact_ids, out)
      }
      continue
    }
    let seg = levels[idx]
    if !(node_idx == 0 && is_dollar) && node.plus_child >= 0 {
      stack_node.push(node.plus_child)
      stack_idx.push(idx + 1)
    }
    match node.children.get(seg) {
      Some(child_idx) => {
        stack_node.push(child_idx)
        stack_idx.push(idx + 1)
      }
      None => ()
    }
  }
  out
}

///| Fast non-deduplicated match count for a topic.
pub fn TopicTrie::count_matches[T](self : TopicTrie[T], topic : String) -> Int {
  let tb = topic.to_bytes()
  if tb.length() == 0 {
    return 0
  }
  let is_dollar = tb[0].to_int() == 0x24
  let levels = split_levels(topic)
  let nlevels = levels.length()
  let mut total = 0
  let stack_node : Array[Int] = [0]
  let stack_idx : Array[Int] = [0]
  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let node_idx = stack_node[top]
    let idx = stack_idx[top]
    let _ = stack_node.pop()
    let _ = stack_idx.pop()
    let node = self.nodes[node_idx]
    if !(node_idx == 0 && is_dollar) {
      total = total + node.hash_ids.length()
    }
    if idx == nlevels {
      total = total + node.exact_ids.length()
      continue
    }
    let seg = levels[idx]
    if !(node_idx == 0 && is_dollar) && node.plus_child >= 0 {
      stack_node.push(node.plus_child)
      stack_idx.push(idx + 1)
    }
    match node.children.get(seg) {
      Some(child_idx) => {
        stack_node.push(child_idx)
        stack_idx.push(idx + 1)
      }
      None => ()
    }
  }
  total
}
