///| High-performance level-indexed MQTT Topic Trie router (`O(depth)` matching, `$` safe,
///| generation-stamped O(1) deduplication, free-list slot/node recycling & bottom-up pruning).

///|
struct TrieNode {
  children : Map[String, Int]
  mut plus_child : Int
  hash_ids : Array[Int]
  exact_ids : Array[Int]
}

///|
fn TrieNode::new() -> TrieNode {
  TrieNode::{
    children: Map::new(),
    plus_child: -1,
    hash_ids: [],
    exact_ids: [],
  }
}

///|
fn TrieNode::is_empty(self : TrieNode) -> Bool {
  self.hash_ids.length() == 0 &&
  self.exact_ids.length() == 0 &&
  self.plus_child < 0 &&
  self.children.length() == 0
}

///|
pub struct TopicTrie[T] {
  nodes : Array[TrieNode]
  free_nodes : Array[Int]
  entry_keys : Array[Int]
  entry_share_groups : Array[String]
  entry_values : Array[T]
  free_entries : Array[Int]
  mut count : Int
  seen_gen_arr : Array[Int]
  seen_gen : Map[Int, Int]
  mut gen : Int
  stack_node : Array[Int]
  stack_idx : Array[Int]
  level_starts : Array[Int]
  level_ends : Array[Int]
}

///|
pub fn TopicTrie::new[T]() -> TopicTrie[T] {
  TopicTrie::{
    nodes: [TrieNode::new()],
    free_nodes: [],
    entry_keys: [],
    entry_share_groups: [],
    entry_values: [],
    free_entries: [],
    count: 0,
    seen_gen_arr: [],
    seen_gen: Map::new(),
    gen: 0,
    stack_node: [],
    stack_idx: [],
    level_starts: [],
    level_ends: [],
  }
}

///|
pub fn TopicTrie::len[T](self : TopicTrie[T]) -> Int {
  self.count
}

///| Allocate a Trie node index, reusing a pruned slot when available.
fn TopicTrie::alloc_node[T](self : TopicTrie[T]) -> Int {
  if self.free_nodes.length() > 0 {
    match self.free_nodes.pop() {
      Some(nid) => return nid
      None => ()
    }
  }
  let nid = self.nodes.length()
  self.nodes.push(TrieNode::new())
  nid
}

///| Allocate an entry slot, reusing a freed slot when available.
fn TopicTrie::alloc_entry[T](
  self : TopicTrie[T],
  key : Int,
  share_group : String,
  value : T,
) -> Int {
  if self.free_entries.length() > 0 {
    match self.free_entries.pop() {
      Some(eid) => {
        self.entry_keys[eid] = key
        self.entry_share_groups[eid] = share_group
        self.entry_values[eid] = value
        return eid
      }
      None => ()
    }
  }
  let eid = self.entry_keys.length()
  self.entry_keys.push(key)
  self.entry_share_groups.push(share_group)
  self.entry_values.push(value)
  eid
}

///| Scan `/` level boundaries of `s` into reusable `starts`/`ends` arrays without allocating level Strings.
fn TopicTrie::scan_levels[T](self : TopicTrie[T], s : String) -> Int {
  self.level_starts.clear()
  self.level_ends.clear()
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 0x2F {
      self.level_starts.push(start)
      self.level_ends.push(i)
      start = i + 1
    }
    i = i + 1
  }
  self.level_starts.push(start)
  self.level_ends.push(n)
  self.level_starts.length()
}

///| Insert a subscription without deduplication key (`key = -1`).
pub fn TopicTrie::insert[T](
  self : TopicTrie[T],
  filter : String,
  value : T,
) -> Result[Unit, MqttError] {
  self.insert_with_key(filter, -1, value)
}

///| Insert a subscription with a deduplication `key` (`key >= 0` deduplicates hits with the same key).
pub fn TopicTrie::insert_with_key[T](
  self : TopicTrie[T],
  filter : String,
  key : Int,
  value : T,
) -> Result[Unit, MqttError] {
  let mut share_group = ""
  let mut norm = filter
  if is_shared_subscription_filter(filter) {
    match parse_shared_subscription(filter) {
      Ok(Some(s)) => {
        share_group = s.share_name
        norm = s.filter
      }
      Ok(None) =>
      match validate_plain_filter_str(filter, 0, filter.length(), filter) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      Err(e) => return Err(e)
    }
  } else {
    match validate_plain_filter_str(filter, 0, filter.length(), filter) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let nlen = norm.length()
  let mut cur = 0
  let mut start = 0
  let mut i = 0
  while true {
    while i < nlen && norm.code_unit_at(i) != 0x2F {
      i = i + 1
    }
    let slen = i - start
    if slen == 1 && norm.code_unit_at(start) == 0x23 {
      let eid = self.alloc_entry(key, share_group, value)
      self.nodes[cur].hash_ids.push(eid)
      self.count = self.count + 1
      return Ok(())
    } else if slen == 1 && norm.code_unit_at(start) == 0x2B {
      let mut nxt = self.nodes[cur].plus_child
      if nxt < 0 {
        nxt = self.alloc_node()
        self.nodes[cur].plus_child = nxt
      }
      cur = nxt
    } else {
      let seg = if slen == 0 { "" } else { norm.slice(start, i) }
      match self.nodes[cur].children.get(seg) {
        Some(nxt) => cur = nxt
        None => {
          let nxt = self.alloc_node()
          self.nodes[cur].children.set(seg, nxt)
          cur = nxt
        }
      }
    }
    if i >= nlen {
      break
    }
    i = i + 1
    start = i
  }
  let eid = self.alloc_entry(key, share_group, value)
  self.nodes[cur].exact_ids.push(eid)
  self.count = self.count + 1
  Ok(())
}

///| Remove the first entry matching `(filter, key)` from the trie, reclaiming entry and empty node slots.
pub fn TopicTrie::remove[T](
  self : TopicTrie[T],
  filter : String,
  key : Int,
) -> Bool {
  let mut share_group = ""
  let mut norm = filter
  if is_shared_subscription_filter(filter) {
    match parse_shared_subscription(filter) {
      Ok(Some(s)) => {
        share_group = s.share_name
        norm = s.filter
      }
      Ok(None) =>
      match validate_plain_filter_str(filter, 0, filter.length(), filter) {
        Ok(_) => ()
        Err(_) => return false
      }
      Err(_) => return false
    }
  } else {
    match validate_plain_filter_str(filter, 0, filter.length(), filter) {
      Ok(_) => ()
      Err(_) => return false
    }
  }
  let path_parent : Array[Int] = []
  let path_child : Array[Int] = []
  let path_seg : Array[String] = []
  let path_is_plus : Array[Bool] = []
  let nlen = norm.length()
  let mut cur = 0
  let mut start = 0
  let mut i = 0
  let mut is_hash = false
  while true {
    while i < nlen && norm.code_unit_at(i) != 0x2F {
      i = i + 1
    }
    let slen = i - start
    if slen == 1 && norm.code_unit_at(start) == 0x23 {
      is_hash = true
      break
    } else if slen == 1 && norm.code_unit_at(start) == 0x2B {
      let nxt = self.nodes[cur].plus_child
      if nxt < 0 {
        return false
      }
      path_parent.push(cur)
      path_child.push(nxt)
      path_seg.push("")
      path_is_plus.push(true)
      cur = nxt
    } else {
      let seg = if slen == 0 { "" } else { norm.slice(start, i) }
      match self.nodes[cur].children.get(seg) {
        Some(nxt) => {
          path_parent.push(cur)
          path_child.push(nxt)
          path_seg.push(seg)
          path_is_plus.push(false)
          cur = nxt
        }
        None => return false
      }
    }
    if i >= nlen {
      break
    }
    i = i + 1
    start = i
  }
  let arr = if is_hash {
    self.nodes[cur].hash_ids
  } else {
    self.nodes[cur].exact_ids
  }
  let mut idx = -1
  let mut j = 0
  while j < arr.length() {
    let eid = arr[j]
    if self.entry_keys[eid] == key && self.entry_share_groups[eid] == share_group {
      idx = j
      break
    }
    j = j + 1
  }
  if idx < 0 {
    return false
  }
  let removed_eid = arr[idx]
  let last = arr.length() - 1
  if idx != last {
    arr[idx] = arr[last]
  }
  let _ = arr.pop()
  // Recycle entry slot.
  self.entry_keys[removed_eid] = -2
  self.entry_share_groups[removed_eid] = ""
  self.free_entries.push(removed_eid)
  self.count = self.count - 1
  // Prune empty nodes bottom-up and recycle their slots.
  let mut k = path_child.length() - 1
  while k >= 0 {
    let nid = path_child[k]
    if !self.nodes[nid].is_empty() {
      break
    }
    let parent = path_parent[k]
    if path_is_plus[k] {
      self.nodes[parent].plus_child = -1
    } else {
      let _ = self.nodes[parent].children.remove(path_seg[k])
    }
    self.free_nodes.push(nid)
    k = k - 1
  }
  // When completely empty, compact backing arrays so peak churn never lingers.
  if self.count == 0 {
    self.nodes.clear()
    self.nodes.push(TrieNode::new())
    self.free_nodes.clear()
    self.entry_keys.clear()
    self.entry_share_groups.clear()
    self.entry_values.clear()
    self.free_entries.clear()
    self.seen_gen_arr.clear()
    self.seen_gen.clear()
  }
  true
}

///| Internal collector helper with generation-stamped O(1) dense-array + Map fallback dedup.
fn TopicTrie::collect_entries[T](
  self : TopicTrie[T],
  ids : Array[Int],
  out : Array[T],
) -> Unit {
  let mut i = 0
  let n = ids.length()
  let g = self.gen
  let arr = self.seen_gen_arr
  while i < n {
    let eid = ids[i]
    let k = self.entry_keys[eid]
    if k >= 0 {
      if k < 65536 {
        if k >= arr.length() {
          let target = k + 1
          while arr.length() < target {
            arr.push(0)
          }
        }
        if arr[k] == g {
          i = i + 1
          continue
        }
        arr[k] = g
      } else {
        match self.seen_gen.get(k) {
          Some(prev) =>
          if prev == g {
            i = i + 1
            continue
          }
          None => ()
        }
        self.seen_gen.set(k, g)
      }
    }
    out.push(self.entry_values[eid])
    i = i + 1
  }
}

///| Iterative stack-based traversal of the trie for `topic` (zero per-call stack/level-array allocation).
pub fn TopicTrie::match_topic[T](self : TopicTrie[T], topic : String) -> Array[T] {
  let out : Array[T] = []
  let tlen = topic.length()
  if tlen == 0 {
    return out
  }
  if self.gen == 2147483647 {
    self.seen_gen_arr.clear()
    self.seen_gen.clear()
    self.gen = 0
  }
  self.gen = self.gen + 1
  let is_dollar = topic.code_unit_at(0) == 0x24
  let nlevels = self.scan_levels(topic)
  let stack_node = self.stack_node
  let stack_idx = self.stack_idx
  stack_node.clear()
  stack_idx.clear()
  stack_node.push(0)
  stack_idx.push(0)
  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let node_idx = stack_node[top]
    let idx = stack_idx[top]
    let _ = stack_node.pop()
    let _ = stack_idx.pop()
    let node = self.nodes[node_idx]
    if !(node_idx == 0 && is_dollar) && node.hash_ids.length() > 0 {
      self.collect_entries(node.hash_ids, out)
    }
    if idx == nlevels {
      if node.exact_ids.length() > 0 {
        self.collect_entries(node.exact_ids, out)
      }
      continue
    }
    if !(node_idx == 0 && is_dollar) && node.plus_child >= 0 {
      stack_node.push(node.plus_child)
      stack_idx.push(idx + 1)
    }
    if node.children.length() > 0 {
      let s0 = self.level_starts[idx]
      let e0 = self.level_ends[idx]
      let seg = if s0 == e0 { "" } else { topic.slice(s0, e0) }
      match node.children.get(seg) {
        Some(child_idx) => {
          stack_node.push(child_idx)
          stack_idx.push(idx + 1)
        }
        None => ()
      }
    }
  }
  out
}

///| Fast non-deduplicated match count for a topic.
pub fn TopicTrie::count_matches[T](self : TopicTrie[T], topic : String) -> Int {
  let tlen = topic.length()
  if tlen == 0 {
    return 0
  }
  let is_dollar = topic.code_unit_at(0) == 0x24
  let nlevels = self.scan_levels(topic)
  let mut total = 0
  let stack_node = self.stack_node
  let stack_idx = self.stack_idx
  stack_node.clear()
  stack_idx.clear()
  stack_node.push(0)
  stack_idx.push(0)
  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let node_idx = stack_node[top]
    let idx = stack_idx[top]
    let _ = stack_node.pop()
    let _ = stack_idx.pop()
    let node = self.nodes[node_idx]
    if !(node_idx == 0 && is_dollar) {
      total = total + node.hash_ids.length()
    }
    if idx == nlevels {
      total = total + node.exact_ids.length()
      continue
    }
    if !(node_idx == 0 && is_dollar) && node.plus_child >= 0 {
      stack_node.push(node.plus_child)
      stack_idx.push(idx + 1)
    }
    if node.children.length() > 0 {
      let s0 = self.level_starts[idx]
      let e0 = self.level_ends[idx]
      let seg = if s0 == e0 { "" } else { topic.slice(s0, e0) }
      match node.children.get(seg) {
        Some(child_idx) => {
          stack_node.push(child_idx)
          stack_idx.push(idx + 1)
        }
        None => ()
      }
    }
  }
  total
}
