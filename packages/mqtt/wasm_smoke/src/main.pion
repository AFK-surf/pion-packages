///| 4-mode Native + Wasm32 (debug & release) smoke test for packages/mqtt.
///| Exercises MQTT 3.1.1 & 5.0 wire codec, 1-byte streaming decode, TopicTrie routing,
///| and Sans-IO Session QoS 1/2 state machine, emitting deterministic stdout.

import "mqtt"

///|
pub fn main(world : World) -> Int {
  // 1. MQTT 5.0 PUBLISH encode + 1-byte streaming decode
  let props = mqtt::Properties::empty()
  props.message_expiry_interval = Some(60U)
  props.content_type = Some("application/json")
  props.user_properties.push(("env", "wasm32"))
  let pkt = mqtt::Packet::Publish(mqtt::PublishPacket::{
    dup: false,
    qos: mqtt::QoS::AtLeastOnce,
    retain: false,
    topic: "iot/wasm/temp",
    packet_id: Some(9),
    properties: props,
    payload: "{\"c\":22.5}".to_bytes(),
  })
  let wire = match mqtt::encode_packet(pkt, mqtt::ProtocolVersion::V5) {
    Ok(b) => b
    Err(_) => return 1
  }
  let dec = mqtt::StreamDecoder::default(mqtt::ProtocolVersion::V5)
  let mut i = 0
  let mut decoded_len = 0
  while i < wire.length() {
    let mut one = Bytes::new(1)
    one[0] = wire[i]
    dec.feed(one)
    match dec.next_packet() {
      Ok(Some(mqtt::Packet::Publish(p))) => decoded_len = p.payload.length()
      Ok(None) => ()
      _ => return 2
    }
    i = i + 1
  }
  if decoded_len != 10 {
    return 3
  }

  // 2. TopicTrie routing + $SYS isolation
  let trie : mqtt::TopicTrie[Int] = mqtt::TopicTrie::new()
  let _ = trie.insert_with_key("iot/+/temp", 1, 10)
  let _ = trie.insert_with_key("#", 2, 20)
  let _ = trie.insert_with_key("$SYS/#", 3, 30)
  let m1 = trie.match_topic("iot/wasm/temp")
  let m2 = trie.match_topic("$SYS/broker/load")
  if m1.length() != 2 || m2.length() != 1 {
    return 4
  }

  // 3. Sans-IO Session CONNECT -> CONNACK -> QoS 1 PUBLISH -> PUBACK
  let s = mqtt::Session::new(mqtt::SessionConfig::new("wasm-client", mqtt::ProtocolVersion::V5))
  if !(s.connect(100L) is Ok(_)) {
    return 5
  }
  let _ = s.poll_transmit()
  let ca = match mqtt::encode_packet(
    mqtt::Packet::ConnAck(mqtt::ConnAckPacket::{
      session_present: false,
      reason_code: 0,
      properties: mqtt::Properties::empty(),
    }),
    mqtt::ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => return 6
  }
  if !(s.feed(ca, 110L) is Ok(_)) {
    return 7
  }
  let pid = match s.publish(
    "iot/wasm/ack",
    "ok".to_bytes(),
    mqtt::QoS::AtLeastOnce,
    false,
    mqtt::Properties::empty(),
    120L,
  ) {
    Ok(Some(id)) => id
    _ => return 8
  }
  let _ = s.poll_transmit()
  let ack = match mqtt::encode_packet(
    mqtt::Packet::PubAck(mqtt::PubAckPacket::{
      packet_id: pid,
      reason_code: 0,
      properties: mqtt::Properties::empty(),
    }),
    mqtt::ProtocolVersion::V5,
  ) {
    Ok(b) => b
    Err(_) => return 9
  }
  if !(s.feed(ack, 130L) is Ok(_)) {
    return 10
  }
  if s.inflight_count() != 0 {
    return 11
  }

  io_println(
    world,
    "mqtt_wasm_smoke ok wire=" +
    wire.length().to_string() +
    " payload=" +
    decoded_len.to_string() +
    " m1=" +
    m1.length().to_string() +
    " m2=" +
    m2.length().to_string() +
    " pid=" +
    pid.to_string(),
  )
  0
}
