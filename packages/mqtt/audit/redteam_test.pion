///| RT-mqtt adversarial audit tests for packages/mqtt @ c850403 (public API only).
///|
///| `p0_` / `p1_` / `p2_` tests encode a confirmed defect and are EXPECTED TO FAIL on c850403:
///| each asserts the OASIS MQTT 3.1.1 / 5.0 conformant behaviour. `control_` tests probe the
///| same attack surfaces where packages/mqtt already behaves correctly and MUST PASS.
///| See REPORT.md for root causes, spec clauses and the differential evidence.

import "mqtt"

// ------------------------------------------------------------------ helpers

///|
fn hexb(hex : String) -> Bytes {
  let vals : Array[Int] = []
  let hb = hex.to_bytes()
  let mut hi = -1
  let mut i = 0
  while i < hb.length() {
    let c = hb[i].to_int()
    let v = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 87
    } else if c >= 65 && c <= 70 {
      c - 55
    } else {
      -1
    }
    if v >= 0 {
      if hi < 0 {
        hi = v
      } else {
        vals.push(hi * 16 + v)
        hi = -1
      }
    }
    i = i + 1
  }
  let out = Bytes::new(vals.length())
  let mut k = 0
  while k < vals.length() {
    out[k] = vals[k].to_byte()
    k = k + 1
  }
  out
}

///|
fn cat(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn enc5(p : mqtt::Packet) -> Bytes {
  match mqtt::encode_packet(p, mqtt::ProtocolVersion::V5) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "enc5 failed: " + mqtt::mqtt_error_string(e))
      Bytes::new(0)
    }
  }
}

///|
fn connack5(session_present : Bool, props : mqtt::Properties) -> Bytes {
  enc5(
    mqtt::Packet::ConnAck(mqtt::ConnAckPacket::{
      session_present: session_present,
      reason_code: 0,
      properties: props,
    }),
  )
}

///|
fn pub5(topic : String, payload : String, qos : mqtt::QoS, pid : Int, dup : Bool) -> Bytes {
  let p = mqtt::PublishPacket::new(
    topic,
    payload.to_bytes(),
    qos,
    false,
    if pid > 0 { Some(pid) } else { None },
  )
  enc5(
    mqtt::Packet::Publish(mqtt::PublishPacket::{
      dup: dup,
      qos: p.qos,
      retain: p.retain,
      topic: p.topic,
      packet_id: p.packet_id,
      properties: p.properties,
      payload: p.payload,
    }),
  )
}

///|
fn ack5(kind : Int, pid : Int) -> Bytes {
  let e = mqtt::Properties::empty()
  let p = if kind == 4 {
    mqtt::Packet::PubAck(mqtt::PubAckPacket::{ packet_id: pid, reason_code: 0, properties: e })
  } else if kind == 5 {
    mqtt::Packet::PubRec(mqtt::PubRecPacket::{ packet_id: pid, reason_code: 0, properties: e })
  } else if kind == 6 {
    mqtt::Packet::PubRel(mqtt::PubRelPacket::{ packet_id: pid, reason_code: 0, properties: e })
  } else {
    mqtt::Packet::PubComp(mqtt::PubCompPacket::{ packet_id: pid, reason_code: 0, properties: e })
  }
  enc5(p)
}

///| A v5 session that has sent CONNECT and received CONNACK(`props`).
fn connected(cfg : mqtt::SessionConfig, props : mqtt::Properties) -> mqtt::Session {
  let s = mqtt::Session::new(cfg)
  debug_assert(s.connect(0L) is Ok(_), "connect")
  let _ = s.poll_transmit()
  debug_assert(s.feed(connack5(false, props), 1L) is Ok(_), "connack")
  s
}

///|
fn received(evs : Array[mqtt::SessionEvent], payload : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < evs.length() {
    match evs[i] {
      mqtt::SessionEvent::PublishReceived(p) =>
      if p.payload.to_string() == payload {
        n = n + 1
      }
      _ => ()
    }
    i = i + 1
  }
  n
}

///|
fn decodes(hex : String, v : mqtt::ProtocolVersion) -> Bool {
  mqtt::decode_packet(hexb(hex), v) is Ok(_)
}

///|
fn v5() -> mqtt::ProtocolVersion {
  mqtt::ProtocolVersion::V5
}

///|
fn v4() -> mqtt::ProtocolVersion {
  mqtt::ProtocolVersion::V311
}

///|
fn deep(seg : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((47).to_byte())
    }
    sb.write_string(seg)
    i = i + 1
  }
  sb.to_string()
}

// ================================================================== P0

///| [MQTT-3.2.2-21] The Client MUST use the Server Keep Alive from CONNACK instead of its own.
///| Session::tick keeps using config.keep_alive_secs (60 s) after the broker said 10 s, so a
///| conforming broker drops every idle client after 1.5 x 10 s.
test "p0_server_keep_alive_from_connack_ignored" {
  let cfg = mqtt::SessionConfig::new("ka", v5())
  let ca = mqtt::Properties::empty()
  ca.server_keep_alive = Some(10)
  let s = connected(cfg, ca)
  debug_assert(s.tick(10500L) is Ok(_), "tick")
  debug_assert(
    s.poll_transmit().length() > 0,
    "PINGREQ must be due 10 s after the last send when Server Keep Alive = 10",
  )
}

///| QoS 2 exactly-once: Session::feed returns Err for a later packet of the same chunk after it
///| has already queued PUBREC and recorded the packet id of an earlier QoS 2 PUBLISH, but the
///| PublishReceived event is discarded with the Err. On reconnect the broker re-sends the
///| PUBLISH (DUP=1), which is then suppressed as a duplicate: the message is never delivered.
test "p0_qos2_message_lost_when_later_packet_in_chunk_errors" {
  let cfg = mqtt::SessionConfig::new("eo", v5())
  let cfg2 = mqtt::SessionConfig::{ ..cfg, topic_alias_maximum: 8, clean_start: false }
  let s = connected(cfg2, mqtt::Properties::empty())
  let alias_props = mqtt::Properties::empty()
  alias_props.topic_alias = Some(5)
  let unknown_alias = enc5(
    mqtt::Packet::Publish(mqtt::PublishPacket::{
      dup: false,
      qos: mqtt::QoS::AtMostOnce,
      retain: false,
      topic: "",
      packet_id: None,
      properties: alias_props,
      payload: "x".to_bytes(),
    }),
  )
  let chunk = cat(pub5("t/eo", "M1", mqtt::QoS::ExactlyOnce, 1, false), unknown_alias)
  let mut delivered = 0
  match s.feed(chunk, 10L) {
    Ok(evs) => delivered = delivered + received(evs, "M1")
    Err(_) => ()
  }
  // Connection is torn down after the error, then resumed with session state.
  s.on_transport_disconnected()
  debug_assert(s.connect(20L) is Ok(_), "reconnect")
  let _ = s.poll_transmit()
  let _ = s.feed(connack5(true, mqtt::Properties::empty()), 21L)
  match s.feed(pub5("t/eo", "M1", mqtt::QoS::ExactlyOnce, 1, true), 22L) {
    Ok(evs) => delivered = delivered + received(evs, "M1")
    Err(_) => ()
  }
  debug_assert(delivered == 1, "QoS 2 message must be delivered exactly once, got " + delivered.to_string())
}

///| PUBREC for a Packet Identifier the client never used creates a phantom in-flight entry
///| (Session::feed PubRec arm calls outbound_inflight.set unconditionally). Ten bogus PUBRECs
///| with Receive Maximum = 10 wedge QoS 1/2 publishing for the rest of the session.
test "p0_phantom_pubrec_wedges_flow_control" {
  let ca = mqtt::Properties::empty()
  ca.receive_maximum = Some(10)
  let s = connected(mqtt::SessionConfig::new("ph", v5()), ca)
  let mut pid = 1000
  while pid < 1010 {
    let _ = s.feed(ack5(5, pid), 2L)
    pid = pid + 1
  }
  debug_assert(s.inflight_count() == 0, "unknown PUBRECs must not create in-flight state")
  debug_assert(
    s.publish("t", "x".to_bytes(), mqtt::QoS::AtLeastOnce, false, mqtt::Properties::empty(), 3L)
    is Ok(_),
    "QoS 1 publish must not be blocked by phantom PUBRECs",
  )
}

// ================================================================== P1

///| [MQTT-3.2.0-1/2] The first packet from the Server MUST be CONNACK. A PUBLISH received
///| while still Connecting is delivered to the application.
test "p1_publish_before_connack_is_delivered" {
  let s = mqtt::Session::new(mqtt::SessionConfig::new("pre", v5()))
  debug_assert(s.connect(0L) is Ok(_), "connect")
  let _ = s.poll_transmit()
  match s.feed(pub5("t", "EARLY", mqtt::QoS::AtMostOnce, 0, false), 1L) {
    Ok(evs) =>
    debug_assert(received(evs, "EARLY") == 0, "PUBLISH before CONNACK must be a protocol error")
    Err(_) => ()
  }
}

///| A second CONNACK (Session Present = 0) on an established connection silently clears all
///| in-flight QoS 1/2 messages: the application never gets PublishAcked or an error.
test "p1_duplicate_connack_wipes_inflight_messages" {
  let s = connected(mqtt::SessionConfig::new("dup", v5()), mqtt::Properties::empty())
  debug_assert(
    s.publish("t", "x".to_bytes(), mqtt::QoS::AtLeastOnce, false, mqtt::Properties::empty(), 2L)
    is Ok(_),
    "publish",
  )
  let r = s.feed(connack5(false, mqtt::Properties::empty()), 3L)
  debug_assert(
    r is Err(_) || s.inflight_count() == 1,
    "second CONNACK must be a protocol error, not drop in-flight state",
  )
}

///| [MQTT-4.3.3] A QoS 2 PUBLISH is acknowledged by PUBREC/PUBREL/PUBCOMP. A PUBACK for it is
///| accepted, removes the in-flight entry and reports PublishAcked: exactly-once is bypassed.
test "p1_puback_completes_qos2_publish" {
  let s = connected(mqtt::SessionConfig::new("q2", v5()), mqtt::Properties::empty())
  let pid = match
  s.publish("t", "x".to_bytes(), mqtt::QoS::ExactlyOnce, false, mqtt::Properties::empty(), 2L) {
    Ok(Some(p)) => p
    _ => 0
  }
  let r = s.feed(ack5(4, pid), 3L)
  debug_assert(r is Err(_) || s.inflight_count() == 1, "PUBACK must not complete a QoS 2 flow")
}

///| A PUBREC for a QoS 1 in-flight PUBLISH turns it into a QoS 2 flow and emits PUBREL.
test "p1_pubrec_for_qos1_publish_emits_pubrel" {
  let s = connected(mqtt::SessionConfig::new("q1", v5()), mqtt::Properties::empty())
  let pid = match
  s.publish("t", "x".to_bytes(), mqtt::QoS::AtLeastOnce, false, mqtt::Properties::empty(), 2L) {
    Ok(Some(p)) => p
    _ => 0
  }
  let _ = s.poll_transmit()
  let r = s.feed(ack5(5, pid), 3L)
  debug_assert(r is Err(_) || s.poll_transmit().length() == 0, "no PUBREL for a QoS 1 message")
}

///| [MQTT-3.2.2-4] A Client without session state receiving Session Present = 1 MUST close the
///| connection. Session accepts it (clean_start = true, first connect).
test "p1_session_present_with_clean_start_accepted" {
  let s = mqtt::Session::new(mqtt::SessionConfig::new("cs", v5()))
  debug_assert(s.connect(0L) is Ok(_), "connect")
  let r = s.feed(connack5(true, mqtt::Properties::empty()), 1L)
  debug_assert(r is Err(_), "Session Present = 1 after Clean Start = 1 must be rejected")
}

///| §3.3.2.3.4 / [MQTT-3.3.2-11]: a Topic Alias above the Topic Alias Maximum the Client sent
///| (default 0 = none) is a Protocol Error. Session stores and resolves it.
test "p1_inbound_topic_alias_above_client_maximum_accepted" {
  let s = connected(mqtt::SessionConfig::new("ta", v5()), mqtt::Properties::empty())
  let pr = mqtt::Properties::empty()
  pr.topic_alias = Some(7)
  let r = s.feed(
    enc5(
      mqtt::Packet::Publish(mqtt::PublishPacket::{
        dup: false,
        qos: mqtt::QoS::AtMostOnce,
        retain: false,
        topic: "a",
        packet_id: None,
        properties: pr,
        payload: "x".to_bytes(),
      }),
    ),
    2L,
  )
  debug_assert(r is Err(_), "Topic Alias 7 with client Topic Alias Maximum 0 must be rejected")
}

///| §3.2.2.3.8 / [MQTT-3.3.2-9]: an absent Topic Alias Maximum in CONNACK means 0, so the Client
///| MUST NOT send any Topic Alias. Session::publish only checks the limit when it is > 0.
test "p1_outbound_topic_alias_without_server_permission" {
  let s = connected(mqtt::SessionConfig::new("tao", v5()), mqtt::Properties::empty())
  let pr = mqtt::Properties::empty()
  pr.topic_alias = Some(1)
  debug_assert(
    s.publish("t", "x".to_bytes(), mqtt::QoS::AtMostOnce, false, pr, 2L) is Err(_),
    "publish with a Topic Alias must fail when the server allows none",
  )
}

///| [MQTT-3.2.2-11] The Client MUST NOT send PUBLISH above the Server's Maximum QoS.
test "p1_connack_maximum_qos_not_enforced" {
  let ca = mqtt::Properties::empty()
  ca.maximum_qos = Some(1)
  let s = connected(mqtt::SessionConfig::new("mq", v5()), ca)
  debug_assert(
    s.publish("t", "x".to_bytes(), mqtt::QoS::ExactlyOnce, false, mqtt::Properties::empty(), 2L)
    is Err(_),
    "QoS 2 publish must be refused when Maximum QoS = 1",
  )
}

///| [MQTT-3.2.2-14] The Client MUST NOT send retained messages when Retain Available = 0.
test "p1_connack_retain_available_not_enforced" {
  let ca = mqtt::Properties::empty()
  ca.retain_available = Some(0)
  let s = connected(mqtt::SessionConfig::new("ra", v5()), ca)
  debug_assert(
    s.publish("t", "x".to_bytes(), mqtt::QoS::AtMostOnce, true, mqtt::Properties::empty(), 2L)
    is Err(_),
    "retained publish must be refused when Retain Available = 0",
  )
}

///| [MQTT-3.2.2-15] The Client MUST NOT send packets larger than the Server's Maximum Packet Size.
test "p1_connack_maximum_packet_size_not_enforced" {
  let ca = mqtt::Properties::empty()
  ca.maximum_packet_size = Some(64U)
  let s = connected(mqtt::SessionConfig::new("mps", v5()), ca)
  let big = Bytes::new(1000)
  debug_assert(
    s.publish("t", big, mqtt::QoS::AtMostOnce, false, mqtt::Properties::empty(), 2L) is Err(_),
    "1000-byte PUBLISH must be refused when Maximum Packet Size = 64",
  )
}

///| StreamDecoder::feed adopts the caller's Bytes without copying while a packet is still
///| partial. A transport that reuses its read buffer (the usual pattern) corrupts the
///| buffered prefix before the next feed copies it.
test "p1_stream_decoder_aliases_caller_read_buffer" {
  let wire = pub5("a/b", "hello", mqtt::QoS::AtMostOnce, 0, false)
  let first = wire.slice(0, 6) // header + topic, payload still missing
  let rest = wire.slice(6, wire.length())
  let dec = mqtt::StreamDecoder::default(v5())
  dec.feed(first)
  debug_assert(dec.next_packet() is Ok(None), "partial")
  // the transport reuses its buffer for the next read
  first[4] = (0x78).to_byte()
  first[5] = (0x79).to_byte()
  dec.feed(rest)
  match dec.next_packet() {
    Ok(Some(mqtt::Packet::Publish(p))) =>
    debug_assert(p.topic == "a/b", "decoded topic must be the bytes on the wire, got " + p.topic)
    _ => debug_assert(false, "publish expected")
  }
}

///| Session::publish clears `topic_alias` on the caller's Properties object (stored_props is an
///| alias of `props`), so re-using a Properties value for the next aliased publish breaks.
test "p1_publish_mutates_caller_properties" {
  let ca = mqtt::Properties::empty()
  ca.topic_alias_maximum = Some(5)
  let s = connected(mqtt::SessionConfig::new("mut", v5()), ca)
  let pr = mqtt::Properties::empty()
  pr.topic_alias = Some(1)
  let _ = s.publish("t/a", "x".to_bytes(), mqtt::QoS::AtLeastOnce, false, pr, 2L)
  debug_assert(pr.topic_alias is Some(1), "publish must not modify the caller's Properties")
}

// ================================================================== P2

///| [MQTT-3.4.2-1 et al.] Reason Codes outside each packet's defined set are accepted by the
///| decoder (is_valid_reason_code exists but is never called). rumqttc rejects them.
test "p2_v5_reason_codes_outside_defined_set_accepted" {
  debug_assert(!decodes("4003000105", v5()), "PUBACK reason 0x05")
  debug_assert(!decodes("5003000101", v5()), "PUBREC reason 0x01")
  debug_assert(!decodes("6203000110", v5()), "PUBREL reason 0x10")
  debug_assert(!decodes("9004000100 03", v5()), "SUBACK reason 0x03")
  debug_assert(!decodes("b004000100 01", v5()), "UNSUBACK reason 0x01")
  debug_assert(!decodes("e00101", v5()), "DISCONNECT reason 0x01")
  debug_assert(!decodes("f0020100", v5()), "AUTH reason 0x01")
  debug_assert(!decodes("2003000100", v5()), "CONNACK reason 0x01")
}

///| v3.1.1 CONNACK return codes 6..255 are reserved; v5/v3.1.1 Session Present MUST be 0 with a
///| failure code [MQTT-3.2.2-4 (3.1.1) / MQTT-3.2.2-6 (5.0)].
test "p2_connack_reserved_return_code_and_session_present_with_error" {
  debug_assert(!decodes("20020006", v4()), "v3.1.1 return code 6")
  debug_assert(!decodes("20020105", v4()), "v3.1.1 session present with return code 5")
  debug_assert(!decodes("2003018700", v5()), "v5 session present with 0x87")
}

///| encode_packet silently truncates out-of-range reason codes with `& 0xFF`: 256 is sent as
///| 0x00 Success, 0x180 as 0x80.
test "p2_encoder_truncates_reason_code_to_byte" {
  let r = mqtt::encode_packet(
    mqtt::Packet::PubAck(mqtt::PubAckPacket::{
      packet_id: 1,
      reason_code: 256,
      properties: mqtt::Properties::empty(),
    }),
    v5(),
  )
  debug_assert(r is Err(_), "reason code 256 must be rejected, not encoded as 0x00")
  let r2 = mqtt::encode_packet(
    mqtt::Packet::SubAck(mqtt::SubAckPacket::{
      packet_id: 1,
      properties: mqtt::Properties::empty(),
      reason_codes: [0x180],
    }),
    v5(),
  )
  debug_assert(r2 is Err(_), "SUBACK reason 0x180 must be rejected")
}

///| The encoder emits a v5 UNSUBACK with no reason codes, which the package's own decoder rejects.
test "p2_v5_unsuback_without_reason_codes_roundtrip_asymmetry" {
  let r = mqtt::encode_packet(
    mqtt::Packet::UnsubAck(mqtt::UnsubAckPacket::{
      packet_id: 1,
      properties: mqtt::Properties::empty(),
      reason_codes: [],
    }),
    v5(),
  )
  match r {
    Ok(b) => debug_assert(mqtt::decode_packet(b, v5()) is Ok(_), "encoder output must decode")
    Err(_) => ()
  }
}

///| [MQTT-3.8.3-4] No Local = 1 on a Shared Subscription is a Protocol Error; the decoder accepts
///| it and the encoder produces it.
test "p2_shared_subscription_with_no_local_accepted" {
  debug_assert(
    !decodes("8210000100000a24736861726" + "52f672f6104", v5()),
    "decode $share/g/a with No Local",
  )
  let t = mqtt::SubscribeTopic::new("$share/g/a", mqtt::QoS::AtMostOnce)
  let r = mqtt::encode_packet(
    mqtt::Packet::Subscribe(mqtt::SubscribePacket::{
      packet_id: 1,
      properties: mqtt::Properties::empty(),
      topics: [mqtt::SubscribeTopic::{ ..t, no_local: true }],
    }),
    v5(),
  )
  debug_assert(r is Err(_), "encode $share/g/a with No Local")
}

///| §3.1.2.11.10: Authentication Data without Authentication Method is a Protocol Error.
test "p2_connect_authentication_data_without_method_accepted" {
  debug_assert(
    !decodes("1012 00044d5154540502003c 04 16000101 000163", v5()),
    "CONNECT with Authentication Data and no Authentication Method",
  )
}

///| `$share/...` is only special in MQTT 5.0. Under 3.1.1 `$share/g`, `$share//a` and
///| `$share/+/a` are ordinary valid filters, but the v3.1.1 decoder rejects them.
test "p2_v311_share_prefixed_filters_rejected" {
  debug_assert(decodes("820d0001 0008247368617265 2f67 00", v4()), "v3.1.1 $share/g")
  debug_assert(decodes("820e0001 0009247368617265 2f2f61 00", v4()), "v3.1.1 $share//a")
  debug_assert(decodes("820f0001 000a247368617265 2f2b2f61 00", v4()), "v3.1.1 $share/+/a")
}

///| TopicTrie strips `$share/{group}/` before indexing, so `$share/g/a` and `a` share one slot;
///| remove("a", key) deletes the shared subscription registered under the same key.
test "p2_trie_conflates_shared_and_plain_subscriptions" {
  let trie : mqtt::TopicTrie[String] = mqtt::TopicTrie::new()
  debug_assert(trie.insert_with_key("$share/g/a", 1, "shared") is Ok(_), "insert shared")
  debug_assert(!trie.remove("a", 1), "removing plain `a` must not remove `$share/g/a`")
}

///| Receive Maximum the client announced is not enforced inbound: a server exceeding it with
///| unacknowledged QoS 2 PUBLISH must get DISCONNECT 0x93 [MQTT-3.3.4-9 receiver side].
test "p2_inbound_receive_maximum_not_enforced" {
  let cfg = mqtt::SessionConfig::new("rm", v5())
  let s = connected(mqtt::SessionConfig::{ ..cfg, receive_maximum: 2 }, mqtt::Properties::empty())
  let _ = s.feed(pub5("t", "1", mqtt::QoS::ExactlyOnce, 1, false), 2L)
  let _ = s.feed(pub5("t", "2", mqtt::QoS::ExactlyOnce, 2, false), 3L)
  let r = s.feed(pub5("t", "3", mqtt::QoS::ExactlyOnce, 3, false), 4L)
  debug_assert(r is Err(_), "3rd unacknowledged QoS 2 PUBLISH with Receive Maximum 2")
}

///| A Server MUST NOT send PINGREQ; Session answers it with PINGRESP instead of a protocol error.
test "p2_server_pingreq_answered" {
  let s = connected(mqtt::SessionConfig::new("pr", v5()), mqtt::Properties::empty())
  debug_assert(s.feed(hexb("c000"), 2L) is Err(_), "PINGREQ from server")
}

// ================================================================== controls (must PASS)

///| A 5-byte header declaring 256 MiB is refused before any body allocation (paho.golang
///| pre-allocates bytes.Buffer.Grow(remainingLength) for the same input).
test "control_256mib_declared_length_rejected_early" {
  let dec = mqtt::StreamDecoder::default(v5())
  dec.feed(hexb("30ffffff7f"))
  debug_assert(dec.next_packet() is Err(mqtt::MqttError::PacketTooLarge(_, _)), "too large")
}

///|
test "control_vbi_5byte_and_noncanonical_rejected" {
  debug_assert(!decodes("30ffffffff01", v5()), "5-byte VBI")
  debug_assert(!decodes("c08000", v5()), "non-canonical 0")
  debug_assert(decodes("c000", v5()), "PINGREQ")
}

///|
test "control_connect_flag_semantics" {
  // will flag 0 + will qos 1
  debug_assert(!decodes("100d00044d5154540408003c000163", v4()), "will qos without will")
  // will flag 0 + will retain
  debug_assert(!decodes("100d00044d5154540422003c000163", v4()), "will retain without will")
  // reserved bit
  debug_assert(!decodes("100d00044d5154540403003c000163", v4()), "reserved bit")
  // password without username: v3.1.1 reject, v5 accept
  debug_assert(!decodes("101000044d5154540442003c000163000170", v4()), "v3.1.1 pw w/o user")
  debug_assert(decodes("101100044d5154540542003c000001630001 70", v5()), "v5 pw w/o user")
}

///|
test "control_subscribe_empty_pid0_and_reserved_options_rejected" {
  debug_assert(!decodes("8203000100", v5()), "empty SUBSCRIBE v5")
  debug_assert(!decodes("82020001", v4()), "empty SUBSCRIBE v3.1.1")
  debug_assert(!decodes("a203000100", v5()), "empty UNSUBSCRIBE")
  debug_assert(!decodes("8206000000016100", v4()), "SUBSCRIBE pid 0")
  debug_assert(!decodes("820700010000016140", v5()), "options bit 6")
  debug_assert(!decodes("820700010000016130", v5()), "retain handling 3")
  debug_assert(!decodes("820700010000016103", v5()), "qos 3")
}

///|
test "control_v5_ack_short_forms_and_disconnect_rem0" {
  debug_assert(decodes("40020001", v5()), "PUBACK rem 2")
  debug_assert(decodes("4003000110", v5()), "PUBACK rem 3")
  debug_assert(decodes("400400011000", v5()), "PUBACK rem 4")
  debug_assert(decodes("e000", v5()), "DISCONNECT rem 0 (rumqttc rejects)")
  debug_assert(decodes("f000", v5()), "AUTH rem 0 (rumqttc rejects)")
}

///|
test "control_topic_matching_edges" {
  debug_assert(mqtt::topic_matches("sport/tennis/player1/#", "sport/tennis/player1"), "# parent")
  debug_assert(mqtt::topic_matches("sport/+", "sport/"), "+ empty level")
  debug_assert(mqtt::topic_matches("+/+", "/"), "+/+ vs /")
  debug_assert(!mqtt::topic_matches("#", "$SYS/x"), "$ isolation #")
  debug_assert(!mqtt::topic_matches("+/monitor", "$SYS/monitor"), "$ isolation +")
  debug_assert(mqtt::topic_matches("$SYS/#", "$SYS/x"), "$SYS/#")
  let trie : mqtt::TopicTrie[Int] = mqtt::TopicTrie::new()
  let _ = trie.insert_with_key("#", 1, 1)
  let _ = trie.insert_with_key("+/monitor", 2, 2)
  let _ = trie.insert_with_key("$SYS/#", 3, 3)
  let _ = trie.insert_with_key("sport/tennis/player1/#", 4, 4)
  debug_assert(trie.match_topic("$SYS/monitor").length() == 1, "trie $ isolation")
  debug_assert(trie.match_topic("sport/tennis/player1").length() == 2, "trie # parent")
}

///|
test "control_shared_subscription_invalid_forms_rejected_v5" {
  debug_assert(mqtt::validate_topic_filter("$share//a") is Err(_), "empty group")
  debug_assert(mqtt::validate_topic_filter("$share/g/") is Err(_), "empty filter")
  debug_assert(mqtt::validate_topic_filter("$share/g+/a") is Err(_), "group with +")
  debug_assert(mqtt::validate_topic_filter("$share/g") is Err(_), "no filter")
  debug_assert(mqtt::validate_topic_filter("$share/g/a/#") is Ok(_), "valid")
}

///| 5,000- and 30,000-level topics/filters: iterative matcher, no recursion blow-up.
test "control_deep_topics_no_stack_overflow" {
  let trie : mqtt::TopicTrie[Int] = mqtt::TopicTrie::new()
  let _ = trie.insert_with_key(deep("+", 5000), 1, 1)
  let _ = trie.insert_with_key(deep("a", 5000), 2, 2)
  let _ = trie.insert_with_key(deep("+", 4999) + "/#", 3, 3)
  debug_assert(trie.match_topic(deep("a", 5000)).length() == 3, "3 hits")
  debug_assert(mqtt::topic_matches(deep("+", 30000), deep("a", 30000)), "30k levels")
}

///|
test "control_qos2_duplicate_publish_delivered_once" {
  let s = connected(mqtt::SessionConfig::new("d", v5()), mqtt::Properties::empty())
  let mut n = 0
  match s.feed(pub5("t", "Q2", mqtt::QoS::ExactlyOnce, 9, false), 2L) {
    Ok(evs) => n = n + received(evs, "Q2")
    Err(_) => ()
  }
  match s.feed(pub5("t", "Q2", mqtt::QoS::ExactlyOnce, 9, true), 3L) {
    Ok(evs) => n = n + received(evs, "Q2")
    Err(_) => ()
  }
  debug_assert(n == 1, "once")
}

///|
test "control_stream_decoder_drip_and_sticky_bounded" {
  let one = pub5("drip/t", "0123456789abcdef", mqtt::QoS::AtLeastOnce, 7, false)
  let n = one.length()
  let dec = mqtt::StreamDecoder::default(v5())
  let mut pos = 0
  let mut got = 0
  let mut maxbuf = 0
  let mut round = 0
  while round < 2000 {
    let len = if round % 2 == 0 { 1 } else { n * 8 + n / 2 }
    let chunk = Bytes::new(len)
    let mut k = 0
    while k < len {
      chunk[k] = one[pos % n]
      pos = pos + 1
      k = k + 1
    }
    dec.feed(chunk)
    match dec.drain() {
      Ok(ps) => got = got + ps.length()
      Err(_) => debug_assert(false, "decode error")
    }
    if dec.buffered_len() > maxbuf {
      maxbuf = dec.buffered_len()
    }
    round = round + 1
  }
  debug_assert(got == pos / n, "every complete frame decoded")
  debug_assert(maxbuf < n, "never buffers more than one partial frame")
}

///|
test "control_utf8_surrogate_nul_overlong_rejected" {
  debug_assert(!decodes("300600036100620078", v4()), "U+0000 in topic")
  debug_assert(!decodes("30070004 61eda080 78", v4()), "surrogate in topic")
  debug_assert(!decodes("30060003 61c080 78", v4()), "overlong NUL")
  debug_assert(decodes("30070004 efbbbf61 78", v4()), "BOM kept")
}

///|
test "control_packet_id_wraps_and_stays_in_range" {
  let s = connected(mqtt::SessionConfig::new("w", v5()), mqtt::Properties::empty())
  let mut i = 0
  let mut ok = true
  while i < 70000 {
    match
    s.publish("t", "x".to_bytes(), mqtt::QoS::AtLeastOnce, false, mqtt::Properties::empty(), 2L) {
      Ok(Some(pid)) => {
        if pid < 1 || pid > 65535 {
          ok = false
        }
        let _ = s.feed(ack5(4, pid), 3L)
      }
      _ => ok = false
    }
    i = i + 1
  }
  debug_assert(ok && s.inflight_count() == 0, "70k QoS1 publish/ack cycles")
}
