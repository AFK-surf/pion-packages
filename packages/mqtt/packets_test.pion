///| OASIS MQTT 3.1.1 & 5.0 Control Packet codec tests (all 15 packet types + all 27 v5 properties).

///|
fn opt_int_is(o : Option[Int], expected : Int) -> Bool {
  match o {
    Some(v) => v == expected
    None => false
  }
}

///|
fn opt_uint_is(o : Option[UInt], expected : UInt) -> Bool {
  match o {
    Some(v) => v == expected
    None => false
  }
}

///|
fn opt_str_is(o : Option[String], expected : String) -> Bool {
  match o {
    Some(v) => v == expected
    None => false
  }
}

///|
fn roundtrip(pkt : Packet, ver : ProtocolVersion) -> Packet {
  let wire = match encode_packet(pkt, ver) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode failed: " + mqtt_error_string(e))
      Bytes::new(0)
    }
  }
  match decode_packet(wire, ver) {
    Ok((dec, used)) => {
      debug_assert(used == wire.length(), "consumed bytes mismatch")
      dec
    }
    Err(e) => {
      debug_assert(false, "decode failed: " + mqtt_error_string(e))
      Packet::PingReq
    }
  }
}

///|
test "connect_v311_and_v5_wire_vectors" {
  // MQTT 3.1.1 CONNECT with Will, Username, Password
  let mut c4 = ConnectPacket::new(ProtocolVersion::V311, "client-v4")
  let c4_full = ConnectPacket::{
    protocol_version: c4.protocol_version,
    client_id: c4.client_id,
    clean_start: false,
    keep_alive: 30,
    username: Some("alice"),
    password: Some("s3cr3t".to_bytes()),
    will: Some(Will::new("status/alice", "offline".to_bytes(), QoS::AtLeastOnce, true)),
    properties: Properties::empty(),
  }
  match roundtrip(Packet::Connect(c4_full), ProtocolVersion::V311) {
    Packet::Connect(d) => {
      debug_assert(d.client_id == "client-v4", "v4 client_id")
      debug_assert(!d.clean_start, "v4 clean_start")
      debug_assert(d.keep_alive == 30, "v4 keep_alive")
      match d.username {
        Some(u) => debug_assert(u == "alice", "v4 username")
        None => debug_assert(false, "expected username")
      }
      match d.will {
        Some(w) => {
          debug_assert(w.topic == "status/alice", "v4 will topic")
          debug_assert(w.retain, "v4 will retain")
          debug_assert(qos_to_int(w.qos) == 1, "v4 will qos")
        }
        None => debug_assert(false, "expected will")
      }
    }
    _ => debug_assert(false, "expected Connect")
  }

  // MQTT 5.0 CONNECT with Will Properties + Password without Username (legal in v5.0)
  let will_props = Properties::empty()
  will_props.will_delay_interval = Some(15U)
  will_props.payload_format_indicator = Some(1)
  will_props.message_expiry_interval = Some(120U)
  will_props.content_type = Some("application/json")
  will_props.response_topic = Some("resp/will")
  will_props.correlation_data = Some("corr-1".to_bytes())
  will_props.user_properties.push(("env", "prod"))
  let conn_props = Properties::empty()
  conn_props.session_expiry_interval = Some(3600U)
  conn_props.receive_maximum = Some(32)
  conn_props.maximum_packet_size = Some(65536U)
  conn_props.topic_alias_maximum = Some(16)
  conn_props.request_response_information = Some(1)
  conn_props.request_problem_information = Some(1)
  conn_props.authentication_method = Some("SCRAM-SHA-256")
  conn_props.authentication_data = Some("auth-init".to_bytes())
  conn_props.user_properties.push(("sdk", "pion"))
  conn_props.user_properties.push(("ver", "0.1.0"))
  let c5 = ConnectPacket::{
    protocol_version: ProtocolVersion::V5,
    client_id: "client-v5",
    clean_start: true,
    keep_alive: 45,
    username: None,
    password: Some("token-only".to_bytes()),
    will: Some(Will::{
      qos: QoS::ExactlyOnce,
      retain: false,
      topic: "will/v5",
      payload: "{\"bye\":true}".to_bytes(),
      properties: will_props,
    }),
    properties: conn_props,
  }
  match roundtrip(Packet::Connect(c5), ProtocolVersion::V5) {
    Packet::Connect(d) => {
      debug_assert(d.client_id == "client-v5", "v5 client_id")
      debug_assert(opt_uint_is(d.properties.session_expiry_interval, 3600U), "session_expiry")
      debug_assert(opt_int_is(d.properties.receive_maximum, 32), "receive_max")
      debug_assert(opt_uint_is(d.properties.maximum_packet_size, 65536U), "max_pkt_size")
      debug_assert(opt_int_is(d.properties.topic_alias_maximum, 16), "topic_alias_max")
      debug_assert(opt_int_is(d.properties.request_response_information, 1), "req_resp_info")
      debug_assert(opt_int_is(d.properties.request_problem_information, 1), "req_prob_info")
      debug_assert(opt_str_is(d.properties.authentication_method, "SCRAM-SHA-256"), "auth_method")
      debug_assert(d.properties.user_properties.length() == 2, "user_props count")
      match d.will {
        Some(w) => {
          debug_assert(opt_uint_is(w.properties.will_delay_interval, 15U), "will_delay")
          debug_assert(opt_str_is(w.properties.content_type, "application/json"), "will_ct")
          debug_assert(opt_str_is(w.properties.response_topic, "resp/will"), "will_resp")
        }
        None => debug_assert(false, "expected v5 will")
      }
    }
    _ => debug_assert(false, "expected Connect")
  }
}

///|
test "connect_reject_reserved_flag_and_v311_password_without_username" {
  // Reserved bit 0 set in Connect Flags (0x01)
  let bad_reserved = bytes_from_ints([
    0x10, 0x0C, 0x00, 0x04, 0x4D, 0x51, 0x54, 0x54, 0x04, 0x01, 0x00, 0x3C,
    0x00, 0x00,
  ])
  match decode_packet(bad_reserved, ProtocolVersion::V311) {
    Err(MqttError::InvalidConnectFlags(_)) => ()
    _ => debug_assert(false, "reserved connect flag bit 0 must be rejected")
  }
  // MQTT 3.1.1: Password flag (0x40) without Username flag (0x80) is forbidden
  let bad_pw = bytes_from_ints([
    0x10, 0x0F, 0x00, 0x04, 0x4D, 0x51, 0x54, 0x54, 0x04, 0x42, 0x00, 0x3C,
    0x00, 0x00, 0x00, 0x01, 0x61,
  ])
  match decode_packet(bad_pw, ProtocolVersion::V311) {
    Err(MqttError::InvalidConnectFlags(_)) => ()
    _ => debug_assert(false, "v3.1.1 password without username must be rejected")
  }
}

///|
test "connack_all_v5_properties_roundtrip" {
  let props = Properties::empty()
  props.session_expiry_interval = Some(7200U)
  props.receive_maximum = Some(100)
  props.maximum_qos = Some(1)
  props.retain_available = Some(1)
  props.maximum_packet_size = Some(131072U)
  props.assigned_client_identifier = Some("auto-999")
  props.topic_alias_maximum = Some(32)
  props.reason_string = Some("welcome")
  props.user_properties.push(("node", "tokyo-1"))
  props.wildcard_subscription_available = Some(1)
  props.subscription_identifier_available = Some(1)
  props.shared_subscription_available = Some(1)
  props.server_keep_alive = Some(120)
  props.response_information = Some("reply/prefix")
  props.server_reference = Some("mqtt://backup.example.com")
  props.authentication_method = Some("PLAIN")
  props.authentication_data = Some("ok".to_bytes())
  let pkt = Packet::ConnAck(ConnAckPacket::{
    session_present: true,
    reason_code: 0x00,
    properties: props,
  })
  match roundtrip(pkt, ProtocolVersion::V5) {
    Packet::ConnAck(d) => {
      debug_assert(d.session_present, "session_present")
      debug_assert(d.reason_code == 0, "reason_code")
      debug_assert(opt_int_is(d.properties.maximum_qos, 1), "max_qos")
      debug_assert(opt_int_is(d.properties.retain_available, 1), "retain_avail")
      debug_assert(opt_str_is(d.properties.assigned_client_identifier, "auto-999"), "assigned_cid")
      debug_assert(opt_int_is(d.properties.wildcard_subscription_available, 1), "wildcard_avail")
      debug_assert(opt_int_is(d.properties.subscription_identifier_available, 1), "sub_id_avail")
      debug_assert(opt_int_is(d.properties.shared_subscription_available, 1), "shared_avail")
      debug_assert(opt_int_is(d.properties.server_keep_alive, 120), "server_ka")
      debug_assert(opt_str_is(d.properties.response_information, "reply/prefix"), "resp_info")
      debug_assert(opt_str_is(d.properties.server_reference, "mqtt://backup.example.com"), "server_ref")
      debug_assert(opt_str_is(d.properties.reason_string, "welcome"), "reason_str")
    }
    _ => debug_assert(false, "expected ConnAck")
  }
}

///|
test "all_15_control_packets_v311_and_v5_roundtrip" {
  // 1. PUBLISH QoS 0 & QoS 1 with all Publish properties
  let p_props = Properties::empty()
  p_props.payload_format_indicator = Some(1)
  p_props.message_expiry_interval = Some(60U)
  p_props.topic_alias = Some(7)
  p_props.response_topic = Some("reply/1")
  p_props.correlation_data = Some("cid-42".to_bytes())
  p_props.subscription_identifiers.push(101)
  p_props.subscription_identifiers.push(202)
  p_props.content_type = Some("text/plain")
  p_props.user_properties.push(("k1", "v1"))
  p_props.user_properties.push(("k2", "v2"))
  let pub5 = Packet::Publish(PublishPacket::{
    dup: true,
    qos: QoS::AtLeastOnce,
    retain: true,
    topic: "factory/line1/sensor",
    packet_id: Some(42),
    properties: p_props,
    payload: "temp=23.5".to_bytes(),
  })
  match roundtrip(pub5, ProtocolVersion::V5) {
    Packet::Publish(d) => {
      debug_assert(d.dup && d.retain, "pub flags")
      debug_assert(qos_to_int(d.qos) == 1, "pub qos")
      debug_assert(opt_int_is(d.packet_id, 42), "pub pid")
      debug_assert(opt_int_is(d.properties.topic_alias, 7), "topic_alias")
      debug_assert(d.properties.subscription_identifiers.length() == 2, "sub_ids")
      debug_assert(d.properties.user_properties.length() == 2, "user_props")
    }
    _ => debug_assert(false, "expected Publish")
  }

  // 2. PUBACK / PUBREC / PUBREL / PUBCOMP (v3.1.1 & v5.0)
  let ack_props = Properties::empty()
  ack_props.reason_string = Some("accepted")
  ack_props.user_properties.push(("trace", "abc"))
  let _ = roundtrip(Packet::PubAck(PubAckPacket::{ packet_id: 10, reason_code: 0, properties: Properties::empty() }), ProtocolVersion::V311)
  let _ = roundtrip(Packet::PubAck(PubAckPacket::{ packet_id: 10, reason_code: 0x10, properties: ack_props }), ProtocolVersion::V5)
  let _ = roundtrip(Packet::PubRec(PubRecPacket::{ packet_id: 11, reason_code: 0, properties: Properties::empty() }), ProtocolVersion::V311)
  let _ = roundtrip(Packet::PubRec(PubRecPacket::{ packet_id: 11, reason_code: 0x00, properties: Properties::empty() }), ProtocolVersion::V5)
  let _ = roundtrip(Packet::PubRel(PubRelPacket::{ packet_id: 12, reason_code: 0, properties: Properties::empty() }), ProtocolVersion::V311)
  let _ = roundtrip(Packet::PubRel(PubRelPacket::{ packet_id: 12, reason_code: 0x92, properties: Properties::empty() }), ProtocolVersion::V5)
  let _ = roundtrip(Packet::PubComp(PubCompPacket::{ packet_id: 13, reason_code: 0, properties: Properties::empty() }), ProtocolVersion::V311)
  let _ = roundtrip(Packet::PubComp(PubCompPacket::{ packet_id: 13, reason_code: 0x00, properties: Properties::empty() }), ProtocolVersion::V5)

  // 3. SUBSCRIBE / SUBACK
  let sub_props = Properties::empty()
  sub_props.subscription_identifiers.push(55)
  let sub5 = Packet::Subscribe(SubscribePacket::{
    packet_id: 20,
    properties: sub_props,
    topics: [
      SubscribeTopic::{ filter: "a/+/c", qos: QoS::ExactlyOnce, no_local: true, retain_as_published: true, retain_handling: 2 },
      SubscribeTopic::new("$share/workers/jobs/#", QoS::AtLeastOnce),
    ],
  })
  match roundtrip(sub5, ProtocolVersion::V5) {
    Packet::Subscribe(d) => {
      debug_assert(d.packet_id == 20, "sub pid")
      debug_assert(d.topics.length() == 2, "sub topics")
      debug_assert(d.topics[0].no_local && d.topics[0].retain_as_published && d.topics[0].retain_handling == 2, "sub opts")
      debug_assert(d.properties.subscription_identifiers.length() == 1 && d.properties.subscription_identifiers[0] == 55, "sub id")
    }
    _ => debug_assert(false, "expected Subscribe")
  }
  match roundtrip(Packet::SubAck(SubAckPacket::{ packet_id: 20, properties: Properties::empty(), reason_codes: [0x02, 0x01] }), ProtocolVersion::V5) {
    Packet::SubAck(d) => debug_assert(d.reason_codes.length() == 2 && d.reason_codes[0] == 2, "suback")
    _ => debug_assert(false, "expected SubAck")
  }

  // 4. UNSUBSCRIBE / UNSUBACK
  let unsub = Packet::Unsubscribe(UnsubscribePacket::{
    packet_id: 21,
    properties: Properties::empty(),
    topics: ["a/+/c", "b/#"],
  })
  let _ = roundtrip(unsub, ProtocolVersion::V311)
  let _ = roundtrip(Packet::UnsubAck(UnsubAckPacket::{ packet_id: 21, properties: Properties::empty(), reason_codes: [] }), ProtocolVersion::V311)
  match roundtrip(Packet::UnsubAck(UnsubAckPacket::{ packet_id: 21, properties: Properties::empty(), reason_codes: [0x00, 0x11] }), ProtocolVersion::V5) {
    Packet::UnsubAck(d) => debug_assert(d.reason_codes.length() == 2 && d.reason_codes[1] == 0x11, "v5 unsuback")
    _ => debug_assert(false, "expected UnsubAck")
  }

  // 5. PINGREQ / PINGRESP
  match roundtrip(Packet::PingReq, ProtocolVersion::V311) {
    Packet::PingReq => ()
    _ => debug_assert(false, "expected PingReq")
  }
  match roundtrip(Packet::PingResp, ProtocolVersion::V5) {
    Packet::PingResp => ()
    _ => debug_assert(false, "expected PingResp")
  }

  // 6. DISCONNECT (v3.1.1 & v5.0)
  let _ = roundtrip(Packet::Disconnect(DisconnectPacket::{ reason_code: 0, properties: Properties::empty() }), ProtocolVersion::V311)
  let disc_props = Properties::empty()
  disc_props.session_expiry_interval = Some(0U)
  disc_props.reason_string = Some("normal shutdown")
  match roundtrip(Packet::Disconnect(DisconnectPacket::{ reason_code: 0x04, properties: disc_props }), ProtocolVersion::V5) {
    Packet::Disconnect(d) => {
      debug_assert(d.reason_code == 0x04, "disc rc")
      debug_assert(opt_str_is(d.properties.reason_string, "normal shutdown"), "disc reason")
    }
    _ => debug_assert(false, "expected Disconnect")
  }

  // 7. AUTH (v5.0 only; rejected in v3.1.1)
  let auth_props = Properties::empty()
  auth_props.authentication_method = Some("SCRAM-SHA-256")
  auth_props.authentication_data = Some("challenge".to_bytes())
  match roundtrip(Packet::Auth(AuthPacket::{ reason_code: 0x18, properties: auth_props }), ProtocolVersion::V5) {
    Packet::Auth(d) => debug_assert(d.reason_code == 0x18, "auth rc")
    _ => debug_assert(false, "expected Auth")
  }
  match decode_packet(bytes_from_ints([0xF0, 0x00]), ProtocolVersion::V311) {
    Err(MqttError::ProtocolViolation(_)) => ()
    _ => debug_assert(false, "AUTH must be rejected in MQTT 3.1.1")
  }
}

///|
test "v5_duplicate_property_and_invalid_property_values_rejected" {
  // Duplicate Payload Format Indicator (0x01) on PUBLISH
  // Fixed header: 0x30 (PUBLISH QoS 0), rem_len: 10
  // Topic: "a" (00 01 61), PropLen: 4, Props: [0x01, 0x01, 0x01, 0x00], Payload: "x"
  let dup_prop = bytes_from_ints([
    0x30, 0x09, 0x00, 0x01, 0x61, 0x04, 0x01, 0x01, 0x01, 0x00, 0x78,
  ])
  match decode_packet(dup_prop, ProtocolVersion::V5) {
    Err(MqttError::DuplicateProperty(0x01)) => ()
    _ => debug_assert(false, "duplicate single-value property must be rejected")
  }

  // Property not allowed on PUBLISH: Receive Maximum (0x21)
  let wrong_ctx = bytes_from_ints([
    0x30, 0x07, 0x00, 0x01, 0x61, 0x03, 0x21, 0x00, 0x0A,
  ])
  match decode_packet(wrong_ctx, ProtocolVersion::V5) {
    Err(MqttError::InvalidPropertyForPacket(0x21)) => ()
    _ => debug_assert(false, "Receive Maximum on PUBLISH must be rejected")
  }

  // Topic Alias = 0 on PUBLISH is Protocol Error (OASIS §3.3.2.3.4)
  let zero_alias = bytes_from_ints([
    0x30, 0x07, 0x00, 0x01, 0x61, 0x03, 0x23, 0x00, 0x00,
  ])
  match decode_packet(zero_alias, ProtocolVersion::V5) {
    Err(MqttError::ProtocolViolation(_)) => ()
    _ => debug_assert(false, "Topic Alias 0 must be rejected")
  }

  // Empty topic name on v5 PUBLISH allowed ONLY with Topic Alias
  let empty_topic_no_alias = bytes_from_ints([0x30, 0x03, 0x00, 0x00, 0x00])
  match decode_packet(empty_topic_no_alias, ProtocolVersion::V5) {
    Err(MqttError::InvalidTopicName(_)) => ()
    _ => debug_assert(false, "empty topic without Topic Alias must be rejected")
  }
  let empty_topic_with_alias = bytes_from_ints([
    0x30, 0x06, 0x00, 0x00, 0x03, 0x23, 0x00, 0x05,
  ])
  match decode_packet(empty_topic_with_alias, ProtocolVersion::V5) {
    Ok((Packet::Publish(p), 8)) => {
      debug_assert(p.topic == "", "empty topic with alias")
      debug_assert(opt_int_is(p.properties.topic_alias, 5), "alias 5")
    }
    _ => debug_assert(false, "empty topic with Topic Alias must succeed")
  }

  // PUBLISH QoS 1 with Packet ID 0 must be rejected
  let pid_zero = bytes_from_ints([0x32, 0x06, 0x00, 0x01, 0x61, 0x00, 0x00, 0x00])
  match decode_packet(pid_zero, ProtocolVersion::V5) {
    Err(MqttError::InvalidPacketId) => ()
    _ => debug_assert(false, "Packet ID 0 must be rejected")
  }
}
