///| Slider postprocessing and indentation heuristic (ported from
///| `imara-diff/src/postprocess.rs` and `imara-diff/src/slider_heuristic.rs`).

///| Blank line sentinel indentation level (`255`).
fn indent_blank() -> Int {
  255
}

///| Compute indentation level for a span in `src` (tab_width = 8, max = 200, blank = 255).
pub fn compute_span_indent(src : String, start : Int, end : Int) -> Int {
  let mut level = 0
  let mut i = start
  while i < end {
    let c = src.code_unit_at(i)
    if c == 32 {
      // ' '
      level = level + 1
    } else if c == 9 {
      // '\t'
      level = level + (8 - (level % 8))
    } else if c == 13 || c == 10 || c == 12 {
      // '\r' | '\n' | '\x0C'
      let _ = 0
    } else {
      return level
    }
    if level >= 200 {
      return level
    }
    i = i + 1
  }
  indent_blank()
}

///| Precompute indentation levels for every token ID in a `LineInterner`.
pub fn compute_line_indents(interner : LineInterner) -> Array[Int] {
  let n = interner.num_tokens
  let indents = Array::make(n, 255)
  let mut i = 0
  while i < n {
    let src = if interner.tok_side[i] == 0 {
      interner.before_src
    } else {
      interner.after_src
    }
    indents[i] = compute_span_indent(src, interner.tok_start[i], interner.tok_end[i])
    i = i + 1
  }
  indents
}

///| Precompute indentation levels for a string vocabulary.
pub fn compute_vocab_indents(vocab : Array[String]) -> Array[Int] {
  let n = vocab.length()
  let indents = Array::make(n, 255)
  let mut i = 0
  while i < n {
    let s = vocab[i]
    indents[i] = compute_span_indent(s, 0, s.length())
    i = i + 1
  }
  indents
}

///| Compute indentation level for token `tid`, lazily populating `tok_indents` when `interner` is used.
fn get_token_indent_lazy(
  tid : Int,
  tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_side : Array[Int],
  tok_start : Array[Int],
  tok_end : Array[Int],
) -> Int {
  let cached = tok_indents[tid]
  if cached >= 0 {
    return cached
  }
  if has_interner {
    let src = if tok_side[tid] == 0 { before_src } else { after_src }
    let lv = compute_span_indent(src, tok_start[tid], tok_end[tid])
    tok_indents[tid] = lv
    return lv
  }
  255
}

///| Score at a single token boundary (indent, penalty).
val struct BoundaryScore {
  indent : Int
  penalty : Int
}

///| Compute indentation score at `token_idx` (0..=tokens.length()).
fn score_at_token(
  tokens : Array[Int],
  token_idx : Int,
  tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_side : Array[Int],
  tok_start : Array[Int],
  tok_end : Array[Int],
) -> BoundaryScore {
  let blank = indent_blank()
  let max_blanks = 20

  // Scan backwards for leading blank lines & previous non-blank indent
  let mut leading_blanks = 0
  let mut prev_indent = blank
  let mut i = token_idx - 1
  while i >= 0 {
    if leading_blanks == max_blanks {
      prev_indent = 0
      break
    }
    let lv = get_token_indent_lazy(
      tokens[i],
      tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_side,
      tok_start,
      tok_end,
    )
    if lv != blank {
      prev_indent = lv
      break
    }
    leading_blanks = leading_blanks + 1
    i = i - 1
  }

  // Scan forwards for trailing blank lines & next non-blank indent
  let n = tokens.length()
  let mut trailing_blanks = 0
  let mut next_indent = blank
  if token_idx < n {
    let mut j = token_idx + 1
    let mut found_next = false
    while j < n {
      if trailing_blanks == max_blanks {
        next_indent = 0
        found_next = true
        break
      }
      let lv = get_token_indent_lazy(
        tokens[j],
        tok_indents,
        has_interner,
        before_src,
        after_src,
        tok_side,
        tok_start,
        tok_end,
      )
      if lv != blank {
        next_indent = lv
        found_next = true
        break
      }
      trailing_blanks = trailing_blanks + 1
      j = j + 1
    }
    if !found_next {
      // Matches imara-diff slider_heuristic.rs:249 unwrap_or((token_idx, BLANK)) as u8
      trailing_blanks = token_idx & 255
      next_indent = blank
    }
  }

  let cur_indent = if token_idx < n {
    get_token_indent_lazy(
      tokens[token_idx],
      tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_side,
      tok_start,
      tok_end,
    )
  } else {
    blank
  }

  let mut penalty = 0
  if prev_indent == blank && leading_blanks == 0 {
    penalty = penalty + 1
  }
  if next_indent == blank && trailing_blanks == 0 {
    penalty = penalty + 21
  }

  let eff_trailing = if cur_indent == blank { trailing_blanks + 1 } else { 0 }
  let total_blanks = eff_trailing + leading_blanks
  penalty = penalty + (-30 * total_blanks) + (6 * eff_trailing)

  let eff_indent = if cur_indent == blank { next_indent } else { cur_indent }
  if eff_indent != blank && prev_indent != blank {
    if eff_indent < prev_indent {
      if next_indent <= eff_indent {
        penalty = penalty + (if total_blanks != 0 { 17 } else { 23 })
      } else {
        penalty = penalty + (if total_blanks != 0 { 17 } else { 24 })
      }
    } else if eff_indent > prev_indent {
      penalty = penalty + (if total_blanks != 0 { 10 } else { -4 })
    }
  }

  BoundaryScore::{
    indent: if eff_indent == blank { -1 } else { eff_indent },
    penalty: penalty,
  }
}

///|
fn score_for_range(
  start : Int,
  end : Int,
  tokens : Array[Int],
  tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_side : Array[Int],
  tok_start : Array[Int],
  tok_end : Array[Int],
) -> BoundaryScore {
  let s1 = score_at_token(
    tokens, start, tok_indents, has_interner, before_src, after_src, tok_side,
    tok_start, tok_end,
  )
  let s2 = score_at_token(
    tokens, end, tok_indents, has_interner, before_src, after_src, tok_side,
    tok_start, tok_end,
  )
  BoundaryScore::{ indent: s1.indent + s2.indent, penalty: s1.penalty + s2.penalty }
}

///|
fn is_score_improvement(cur : BoundaryScore, prev : BoundaryScore) -> Bool {
  let indent_score = if prev.indent < cur.indent {
    60
  } else if prev.indent > cur.indent {
    -60
  } else {
    0
  }
  (indent_score + cur.penalty - prev.penalty) <= 0
}

///|
fn best_slider_end_indent(
  tokens : Array[Int],
  hunk_start : Int,
  hunk_end : Int,
  earliest_end : Int,
  tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_side : Array[Int],
  tok_start : Array[Int],
  tok_end : Array[Int],
) -> Int {
  let max_sliding = 100
  let mut top_end = earliest_end
  if top_end < hunk_start - 1 {
    top_end = hunk_start - 1
  }
  if hunk_end > top_end + max_sliding {
    top_end = hunk_end - max_sliding
  }
  let group_size = hunk_end - hunk_start
  let mut best_score = score_for_range(
    top_end - group_size,
    top_end,
    tokens,
    tok_indents,
    has_interner,
    before_src,
    after_src,
    tok_side,
    tok_start,
    tok_end,
  )
  let mut best_end = top_end
  let mut cur_end = top_end + 1
  while cur_end <= hunk_end {
    let sc = score_for_range(
      cur_end - group_size,
      cur_end,
      tokens,
      tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_side,
      tok_start,
      tok_end,
    )
    if is_score_improvement(sc, best_score) {
      best_score = sc
      best_end = cur_end
    }
    cur_end = cur_end + 1
  }
  best_end
}

///| Find offset to next `true` in `changes[pos..]`, or `-1` if none.
fn find_next_change(changes : Array[Bool], pos : Int) -> Int {
  let n = changes.length()
  let mut i = pos
  while i < n {
    if changes[i] {
      return i - pos
    }
    i = i + 1
  }
  -1
}

///|
fn find_hunk_end(changes : Array[Bool], pos : Int) -> Int {
  let n = changes.length()
  let mut i = pos
  while i < n && changes[i] {
    i = i + 1
  }
  i
}

///|
fn find_hunk_start(changes : Array[Bool], pos : Int) -> Int {
  let mut i = pos
  while i > 0 && changes[i - 1] {
    i = i - 1
  }
  i
}

///| Run one pass of postprocessing on `(added, removed, tokens)`.
fn postprocess_pass(
  added : Array[Bool],
  removed : Array[Bool],
  tokens : Array[Int],
  use_indent : Bool,
  tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_side : Array[Int],
  tok_start : Array[Int],
  tok_end : Array[Int],
) -> Unit {
  let mut b_start = 0
  let mut b_end = 0
  let mut a_start = 0
  let mut a_end = 0
  let rem_len = removed.length()
  let tok_len = tokens.length()

  while true {
    // Advance to next hunk in `added`
    let off = find_next_change(added, a_end)
    if off < 0 {
      break
    }
    let mut off_before = 0
    while true {
      let next_rem = find_next_change(removed, b_end)
      let unchanged = if next_rem < 0 { rem_len - b_end } else { next_rem }
      if off_before + unchanged > off {
        b_start = b_end + (off - off_before)
        b_end = b_start
        break
      }
      off_before = off_before + unchanged
      b_start = b_end + unchanged
      b_end = find_hunk_end(removed, b_start)
      if off_before == off {
        break
      }
    }
    a_start = a_end + off
    a_end = find_hunk_end(added, a_start)

    // Slide up and down until no more merges happen
    let mut earliest_end = a_end
    let mut is_mod = false
    while true {
      // Slide up
      while a_start > 0 && tokens[a_start - 1] == tokens[a_end - 1] {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
      }
      earliest_end = a_end
      is_mod = b_start != b_end
      let unexpanded_len = a_end - a_start

      // Slide down
      while a_end < tok_len && tokens[a_start] == tokens[a_end] {
        added[a_start] = false
        added[a_end] = true
        a_start = a_start + 1
        a_end = find_hunk_end(added, a_end)
        b_start = b_end + 1
        b_end = find_hunk_end(removed, b_start)
        if b_start != b_end {
          is_mod = true
        }
      }

      if unexpanded_len == a_end - a_start {
        break
      }
    }

    if a_end == earliest_end {
      continue
    }

    if is_mod {
      while b_start == b_end {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
      }
    } else if use_indent {
      let target_end = best_slider_end_indent(
        tokens, a_start, a_end, earliest_end, tok_indents, has_interner,
        before_src, after_src, tok_side, tok_start, tok_end,
      )
      let steps = a_end - target_end
      let mut s = 0
      while s < steps {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
        s = s + 1
      }
    }
  }
}

///| Postprocess diff with lazy indentation calculation from a `LineInterner`.
pub fn postprocess_interned_lines(
  interner : LineInterner,
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  let tok_indents = Array::make(interner.num_tokens, -1)
  postprocess_pass(
    added,
    removed,
    interner.after_tokens,
    true,
    tok_indents,
    true,
    interner.before_src,
    interner.after_src,
    interner.tok_side,
    interner.tok_start,
    interner.tok_end,
  )
  postprocess_pass(
    removed,
    added,
    interner.before_tokens,
    true,
    tok_indents,
    true,
    interner.before_src,
    interner.after_src,
    interner.tok_side,
    interner.tok_start,
    interner.tok_end,
  )
}

///| Postprocess diff with precomputed indentation levels.
pub fn postprocess_with_indents(
  before : Array[Int],
  after : Array[Int],
  removed : Array[Bool],
  added : Array[Bool],
  tok_indents : Array[Int],
) -> Unit {
  let empty : Array[Int] = Array::new()
  postprocess_pass(
    added, removed, after, true, tok_indents, false, "", "", empty, empty, empty,
  )
  postprocess_pass(
    removed, added, before, true, tok_indents, false, "", "", empty, empty, empty,
  )
}

///| Postprocess diff without indentation heuristic (slides down + merges hunks).
pub fn postprocess_no_heuristic(
  before : Array[Int],
  after : Array[Int],
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  let empty : Array[Int] = Array::new()
  postprocess_pass(
    added, removed, after, false, empty, false, "", "", empty, empty, empty,
  )
  postprocess_pass(
    removed, added, before, false, empty, false, "", "", empty, empty, empty,
  )
}
