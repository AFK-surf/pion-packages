///| Slider postprocessing and indentation heuristic (ported from
///| `imara-diff/src/postprocess.rs` and `imara-diff/src/slider_heuristic.rs`).

///| Blank line sentinel indentation level (`255`).
fn indent_blank() -> Int {
  255
}

///| Compute indentation level for a span in `src` (tab_width = 8, max = 200, blank = 255).
pub fn compute_span_indent(src : String, start : Int, end : Int) -> Int {
  let mut level = 0
  let mut i = start
  while i < end {
    let c = src.code_unit_at(i)
    if c == 32 {
      // ' '
      level = level + 1
    } else if c == 9 {
      // '\t'
      level = level + (8 - (level % 8))
    } else if c == 13 || c == 10 || c == 12 {
      // '\r' | '\n' | '\x0C'
      let _ = 0
    } else {
      return level
    }
    if level >= 200 {
      return level
    }
    i = i + 1
  }
  indent_blank()
}

///| Precompute indentation levels for every token ID in a `LineInterner`.
pub fn compute_line_indents(interner : LineInterner) -> Array[Int] {
  let n = interner.num_tokens
  let indents = Array::make(n, 255)
  let tok_span = interner.tok_span
  let before_src = interner.before_src
  let after_src = interner.after_src
  let mut i = 0
  while i < n {
    let sp = tok_span[i]
    let src = if ((sp >> 62) & 1L) == 0L { before_src } else { after_src }
    let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
    let te = (sp & 0x7FFFFFFFL).to_int()
    indents[i] = compute_span_indent(src, ts, te)
    i = i + 1
  }
  indents
}

///| Precompute indentation levels for a string vocabulary.
pub fn compute_vocab_indents(vocab : Array[String]) -> Array[Int] {
  let n = vocab.length()
  let indents = Array::make(n, 255)
  let mut i = 0
  while i < n {
    let s = vocab[i]
    indents[i] = compute_span_indent(s, 0, s.length())
    i = i + 1
  }
  indents
}

///| Compute indentation level for token `tid`, lazily populating `tok_indents`
///| (or `after_tok_indents` when using a reusable `BeforeInterner`).
fn get_token_indent_lazy(
  tid : Int,
  tok_indents : Array[Int],
  after_tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_span : Array[Int64],
  after_tok_span : Array[Int64],
) -> Int {
  let b_len = tok_indents.length()
  if tid < b_len {
    let cached = tok_indents[tid]
    if cached >= 0 {
      return cached
    }
    if has_interner {
      let sp = tok_span[tid]
      let src = if ((sp >> 62) & 1L) == 0L { before_src } else { after_src }
      let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
      let te = (sp & 0x7FFFFFFFL).to_int()
      let lv = compute_span_indent(src, ts, te)
      tok_indents[tid] = lv
      return lv
    }
    return 255
  }
  let local_id = tid - b_len
  let cached = after_tok_indents[local_id]
  if cached >= 0 {
    return cached
  }
  if has_interner {
    let sp = after_tok_span[local_id]
    let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
    let te = (sp & 0x7FFFFFFFL).to_int()
    let lv = compute_span_indent(after_src, ts, te)
    after_tok_indents[local_id] = lv
    return lv
  }
  255
}

///| Exact boundary context outside a windowed slice (up to 20 blank lines + anchor indent).
val struct WindowBoundary {
  has_pre : Bool
  pre_blanks : Int
  pre_indent : Int
  has_suf : Bool
  suf_first_indent : Int
  suf_blanks_from_0 : Int
  suf_indent_from_0 : Int
  suf_blanks_from_1 : Int
  suf_indent_from_1 : Int
}

///|
fn no_window_boundary() -> WindowBoundary {
  WindowBoundary::{
    has_pre: false,
    pre_blanks: 0,
    pre_indent: 255,
    has_suf: false,
    suf_first_indent: 255,
    suf_blanks_from_0: 0,
    suf_indent_from_0: 255,
    suf_blanks_from_1: 0,
    suf_indent_from_1: 255,
  }
}

///| Scan forward from byte `start` in `src` for up to 20 blank lines + next non-blank indent.
fn scan_suffix_blanks(src : String, start : Int) -> (Int, Int) {
  let blank = indent_blank()
  let bn = src.length()
  let mut blanks = 0
  let mut indent = blank
  let mut q = start
  while q < bn {
    if blanks == 20 {
      indent = 0
      break
    }
    let ls = q
    while q < bn && src.code_unit_at(q) != 10 {
      q = q + 1
    }
    if q < bn {
      q = q + 1
    }
    let lv = compute_span_indent(src, ls, q)
    if lv != blank {
      indent = lv
      break
    }
    blanks = blanks + 1
  }
  (blanks, indent)
}

///| Precompute true BOF/EOF and 20-line blank/indent context across stripped window edges.
fn compute_window_boundary(interner : LineInterner) -> WindowBoundary {
  let has_pre = interner.pre_lines > 0
  let has_suf = interner.has_stripped_suffix
  if !has_pre && !has_suf {
    return no_window_boundary()
  }
  let blank = indent_blank()
  let src = interner.before_src
  let mut pre_blanks = 0
  let mut pre_indent = blank
  if has_pre {
    let mut p = interner.before_offsets[0]
    while p > 0 {
      if pre_blanks == 20 {
        pre_indent = 0
        break
      }
      let le = p
      let mut ls = p - 1
      while ls > 0 && src.code_unit_at(ls - 1) != 10 {
        ls = ls - 1
      }
      let lv = compute_span_indent(src, ls, le)
      if lv != blank {
        pre_indent = lv
        break
      }
      pre_blanks = pre_blanks + 1
      p = ls
    }
  }
  let mut suf_first_indent = blank
  let mut suf_blanks_from_0 = 0
  let mut suf_indent_from_0 = blank
  let mut suf_blanks_from_1 = 0
  let mut suf_indent_from_1 = blank
  if has_suf {
    let bn = src.length()
    let p = interner.before_offsets[interner.before_tokens.length()]
    let mut e0 = p
    while e0 < bn && src.code_unit_at(e0) != 10 {
      e0 = e0 + 1
    }
    if e0 < bn {
      e0 = e0 + 1
    }
    suf_first_indent = compute_span_indent(src, p, e0)
    let (b0, i0) = scan_suffix_blanks(src, p)
    suf_blanks_from_0 = b0
    suf_indent_from_0 = i0
    let (b1, i1) = scan_suffix_blanks(src, e0)
    suf_blanks_from_1 = b1
    suf_indent_from_1 = i1
  }
  WindowBoundary::{
    has_pre: has_pre,
    pre_blanks: pre_blanks,
    pre_indent: pre_indent,
    has_suf: has_suf,
    suf_first_indent: suf_first_indent,
    suf_blanks_from_0: suf_blanks_from_0,
    suf_indent_from_0: suf_indent_from_0,
    suf_blanks_from_1: suf_blanks_from_1,
    suf_indent_from_1: suf_indent_from_1,
  }
}

///| Score at a single token boundary (indent, penalty).
val struct BoundaryScore {
  indent : Int
  penalty : Int
}

///| Compute indentation score at `token_idx` (0..=tokens.length()).
fn score_at_token(
  tokens : Array[Int],
  token_idx : Int,
  line_offset : Int,
  boundary : WindowBoundary,
  tok_indents : Array[Int],
  after_tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_span : Array[Int64],
  after_tok_span : Array[Int64],
) -> BoundaryScore {
  let blank = indent_blank()
  let max_blanks = 20

  // Scan backwards for leading blank lines & previous non-blank indent
  let mut leading_blanks = 0
  let mut prev_indent = blank
  let mut i = token_idx - 1
  while i >= 0 {
    if leading_blanks == max_blanks {
      prev_indent = 0
      break
    }
    let lv = get_token_indent_lazy(
      tokens[i],
      tok_indents,
      after_tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_span,
      after_tok_span,
    )
    if lv != blank {
      prev_indent = lv
      break
    }
    leading_blanks = leading_blanks + 1
    i = i - 1
  }
  if prev_indent == blank && boundary.has_pre {
    if leading_blanks == max_blanks {
      prev_indent = 0
    } else {
      let tot = leading_blanks + boundary.pre_blanks
      if tot > max_blanks {
        leading_blanks = max_blanks
        prev_indent = 0
      } else if tot == max_blanks {
        leading_blanks = max_blanks
        if boundary.pre_indent != blank {
          prev_indent = 0
        }
      } else {
        leading_blanks = tot
        prev_indent = boundary.pre_indent
      }
    }
  }

  // Scan forwards for trailing blank lines & next non-blank indent
  let n = tokens.length()
  let mut trailing_blanks = 0
  let mut next_indent = blank
  if token_idx < n {
    let mut j = token_idx + 1
    let mut found_next = false
    while j < n {
      if trailing_blanks == max_blanks {
        next_indent = 0
        found_next = true
        break
      }
      let lv = get_token_indent_lazy(
        tokens[j],
        tok_indents,
        after_tok_indents,
        has_interner,
        before_src,
        after_src,
        tok_span,
        after_tok_span,
      )
      if lv != blank {
        next_indent = lv
        found_next = true
        break
      }
      trailing_blanks = trailing_blanks + 1
      j = j + 1
    }
    if !found_next && boundary.has_suf {
      if trailing_blanks == max_blanks {
        next_indent = 0
        found_next = true
      } else {
        let tot = trailing_blanks + boundary.suf_blanks_from_0
        if tot > max_blanks {
          trailing_blanks = max_blanks
          next_indent = 0
          found_next = true
        } else if tot == max_blanks {
          if boundary.suf_indent_from_0 != blank {
            trailing_blanks = max_blanks
            next_indent = 0
            found_next = true
          }
        } else if boundary.suf_indent_from_0 != blank {
          trailing_blanks = tot
          next_indent = boundary.suf_indent_from_0
          found_next = true
        }
      }
    }
    if !found_next {
      // Matches imara-diff slider_heuristic.rs:249 unwrap_or((token_idx, BLANK)) as u8
      trailing_blanks = (token_idx + line_offset) & 255
      next_indent = blank
    }
  } else if boundary.has_suf {
    // `token_idx == n`, but stripped suffix lines exist so this is not EOF.
    if boundary.suf_indent_from_1 != blank {
      trailing_blanks = boundary.suf_blanks_from_1
      next_indent = boundary.suf_indent_from_1
    } else {
      trailing_blanks = (token_idx + line_offset) & 255
      next_indent = blank
    }
  }

  let cur_indent = if token_idx < n {
    get_token_indent_lazy(
      tokens[token_idx],
      tok_indents,
      after_tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_span,
      after_tok_span,
    )
  } else if boundary.has_suf {
    boundary.suf_first_indent
  } else {
    blank
  }

  let mut penalty = 0
  if prev_indent == blank && leading_blanks == 0 {
    penalty = penalty + 1
  }
  if next_indent == blank && trailing_blanks == 0 {
    penalty = penalty + 21
  }

  let eff_trailing = if cur_indent == blank { trailing_blanks + 1 } else { 0 }
  let total_blanks = eff_trailing + leading_blanks
  penalty = penalty + (-30 * total_blanks) + (6 * eff_trailing)

  let eff_indent = if cur_indent == blank { next_indent } else { cur_indent }
  if eff_indent != blank && prev_indent != blank {
    if eff_indent < prev_indent {
      if next_indent <= eff_indent {
        penalty = penalty + (if total_blanks != 0 { 17 } else { 23 })
      } else {
        penalty = penalty + (if total_blanks != 0 { 17 } else { 24 })
      }
    } else if eff_indent > prev_indent {
      penalty = penalty + (if total_blanks != 0 { 10 } else { -4 })
    }
  }

  BoundaryScore::{
    indent: if eff_indent == blank { -1 } else { eff_indent },
    penalty: penalty,
  }
}

///|
fn score_for_range(
  start : Int,
  end : Int,
  tokens : Array[Int],
  line_offset : Int,
  boundary : WindowBoundary,
  tok_indents : Array[Int],
  after_tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_span : Array[Int64],
  after_tok_span : Array[Int64],
) -> BoundaryScore {
  let s1 = score_at_token(
    tokens, start, line_offset, boundary, tok_indents, after_tok_indents,
    has_interner, before_src, after_src, tok_span, after_tok_span,
  )
  let s2 = score_at_token(
    tokens, end, line_offset, boundary, tok_indents, after_tok_indents,
    has_interner, before_src, after_src, tok_span, after_tok_span,
  )
  BoundaryScore::{ indent: s1.indent + s2.indent, penalty: s1.penalty + s2.penalty }
}

///|
fn is_score_improvement(cur : BoundaryScore, prev : BoundaryScore) -> Bool {
  let indent_score = if prev.indent < cur.indent {
    60
  } else if prev.indent > cur.indent {
    -60
  } else {
    0
  }
  (indent_score + cur.penalty - prev.penalty) <= 0
}

///|
fn best_slider_end_indent(
  tokens : Array[Int],
  hunk_start : Int,
  hunk_end : Int,
  earliest_end : Int,
  line_offset : Int,
  boundary : WindowBoundary,
  tok_indents : Array[Int],
  after_tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_span : Array[Int64],
  after_tok_span : Array[Int64],
) -> Int {
  let max_sliding = 100
  let mut top_end = earliest_end
  if top_end < hunk_start - 1 {
    top_end = hunk_start - 1
  }
  if hunk_end > top_end + max_sliding {
    top_end = hunk_end - max_sliding
  }
  let group_size = hunk_end - hunk_start
  let mut best_score = score_for_range(
    top_end - group_size,
    top_end,
    tokens,
    line_offset,
    boundary,
    tok_indents,
    after_tok_indents,
    has_interner,
    before_src,
    after_src,
    tok_span,
    after_tok_span,
  )
  let mut best_end = top_end
  let mut cur_end = top_end + 1
  while cur_end <= hunk_end {
    let sc = score_for_range(
      cur_end - group_size,
      cur_end,
      tokens,
      line_offset,
      boundary,
      tok_indents,
      after_tok_indents,
      has_interner,
      before_src,
      after_src,
      tok_span,
      after_tok_span,
    )
    if is_score_improvement(sc, best_score) {
      best_score = sc
      best_end = cur_end
    }
    cur_end = cur_end + 1
  }
  best_end
}

///| Find offset to next `true` in `changes[pos..]`, or `-1` if none.
fn find_next_change(changes : Array[Bool], pos : Int) -> Int {
  let n = changes.length()
  let mut i = pos
  while i < n {
    if changes[i] {
      return i - pos
    }
    i = i + 1
  }
  -1
}

///|
fn find_hunk_end(changes : Array[Bool], pos : Int) -> Int {
  let n = changes.length()
  let mut i = pos
  while i < n && changes[i] {
    i = i + 1
  }
  i
}

///|
fn find_hunk_start(changes : Array[Bool], pos : Int) -> Int {
  let mut i = pos
  while i > 0 && changes[i - 1] {
    i = i - 1
  }
  i
}

///| Run one pass of postprocessing on `(added, removed, tokens)`.
///| Returns `true` if any sliding hunk reached a stripped window boundary.
fn postprocess_pass(
  added : Array[Bool],
  removed : Array[Bool],
  tokens : Array[Int],
  line_offset : Int,
  boundary : WindowBoundary,
  use_indent : Bool,
  tok_indents : Array[Int],
  after_tok_indents : Array[Int],
  has_interner : Bool,
  before_src : String,
  after_src : String,
  tok_span : Array[Int64],
  after_tok_span : Array[Int64],
) -> Bool {
  let mut b_start = 0
  let mut b_end = 0
  let mut a_start = 0
  let mut a_end = 0
  let rem_len = removed.length()
  let tok_len = tokens.length()
  let mut touched_boundary = false

  while true {
    // Advance to next hunk in `added`
    let off = find_next_change(added, a_end)
    if off < 0 {
      break
    }
    let mut off_before = 0
    while true {
      let next_rem = find_next_change(removed, b_end)
      let unchanged = if next_rem < 0 { rem_len - b_end } else { next_rem }
      if off_before + unchanged > off {
        b_start = b_end + (off - off_before)
        b_end = b_start
        break
      }
      off_before = off_before + unchanged
      b_start = b_end + unchanged
      b_end = find_hunk_end(removed, b_start)
      if off_before == off {
        break
      }
    }
    a_start = a_end + off
    a_end = find_hunk_end(added, a_start)

    // Slide up and down until no more merges happen
    let mut earliest_end = a_end
    let mut is_mod = false
    while true {
      // Slide up
      while a_start > 0 && tokens[a_start - 1] == tokens[a_end - 1] {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
      }
      if boundary.has_pre && a_start == 0 {
        touched_boundary = true
      }
      earliest_end = a_end
      is_mod = b_start != b_end
      let unexpanded_len = a_end - a_start

      // Slide down
      while a_end < tok_len && tokens[a_start] == tokens[a_end] {
        added[a_start] = false
        added[a_end] = true
        a_start = a_start + 1
        a_end = find_hunk_end(added, a_end)
        b_start = b_end + 1
        b_end = find_hunk_end(removed, b_start)
        if b_start != b_end {
          is_mod = true
        }
      }
      if boundary.has_suf && a_end == tok_len {
        touched_boundary = true
      }

      if unexpanded_len == a_end - a_start {
        break
      }
    }

    if a_end == earliest_end {
      continue
    }

    if is_mod {
      while b_start == b_end {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
      }
    } else if use_indent {
      let target_end = best_slider_end_indent(
        tokens, a_start, a_end, earliest_end, line_offset, boundary,
        tok_indents, after_tok_indents, has_interner, before_src, after_src,
        tok_span, after_tok_span,
      )
      let steps = a_end - target_end
      let mut s = 0
      while s < steps {
        added[a_start - 1] = true
        added[a_end - 1] = false
        a_end = a_end - 1
        a_start = find_hunk_start(added, a_start - 1)
        b_end = b_start - 1
        b_start = find_hunk_start(removed, b_start - 1)
        s = s + 1
      }
    }
  }
  touched_boundary
}

///| Postprocess diff with lazy indentation calculation from a `LineInterner`,
///| returning `true` if any sliding hunk reached a stripped window boundary.
fn postprocess_interned_lines_checked(
  interner : LineInterner,
  removed : Array[Bool],
  added : Array[Bool],
) -> Bool {
  let tok_indents = Array::make(interner.num_tokens, -1)
  let empty_i : Array[Int] = Array::new()
  let empty_s : Array[Int64] = Array::new()
  let boundary = compute_window_boundary(interner)
  let t1 = postprocess_pass(
    added,
    removed,
    interner.after_tokens,
    interner.pre_lines,
    boundary,
    true,
    tok_indents,
    empty_i,
    true,
    interner.before_src,
    interner.after_src,
    interner.tok_span,
    empty_s,
  )
  let t2 = postprocess_pass(
    removed,
    added,
    interner.before_tokens,
    interner.pre_lines,
    boundary,
    true,
    tok_indents,
    empty_i,
    true,
    interner.before_src,
    interner.after_src,
    interner.tok_span,
    empty_s,
  )
  t1 || t2
}

///| Postprocess diff with lazy indentation calculation from a `LineInterner`.
pub fn postprocess_interned_lines(
  interner : LineInterner,
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  let _ = postprocess_interned_lines_checked(interner, removed, added)
}

///| Postprocess diff for a reusable `BeforeInterner` + `AfterInterned` view,
///| reusing `BeforeInterner.tok_indents` across calls.
fn postprocess_reusable_lines(
  interned : BeforeInterner,
  after_src : String,
  after_tokens : Array[Int],
  after_tok_span : Array[Int64],
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  let after_tok_indents = Array::make(after_tok_span.length(), -1)
  let boundary = no_window_boundary()
  let _ = postprocess_pass(
    added,
    removed,
    after_tokens,
    0,
    boundary,
    true,
    interned.tok_indents,
    after_tok_indents,
    true,
    interned.before_src,
    after_src,
    interned.tok_span,
    after_tok_span,
  )
  let _ = postprocess_pass(
    removed,
    added,
    interned.before_tokens,
    0,
    boundary,
    true,
    interned.tok_indents,
    after_tok_indents,
    true,
    interned.before_src,
    after_src,
    interned.tok_span,
    after_tok_span,
  )
}

///| Postprocess diff with precomputed indentation levels.
pub fn postprocess_with_indents(
  before : Array[Int],
  after : Array[Int],
  removed : Array[Bool],
  added : Array[Bool],
  tok_indents : Array[Int],
) -> Unit {
  let empty_i : Array[Int] = Array::new()
  let empty_s : Array[Int64] = Array::new()
  let boundary = no_window_boundary()
  let _ = postprocess_pass(
    added, removed, after, 0, boundary, true, tok_indents, empty_i, false, "",
    "", empty_s, empty_s,
  )
  let _ = postprocess_pass(
    removed, added, before, 0, boundary, true, tok_indents, empty_i, false, "",
    "", empty_s, empty_s,
  )
}

///| Postprocess diff without indentation heuristic (slides down + merges hunks).
pub fn postprocess_no_heuristic(
  before : Array[Int],
  after : Array[Int],
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  let empty_i : Array[Int] = Array::new()
  let empty_s : Array[Int64] = Array::new()
  let boundary = no_window_boundary()
  let _ = postprocess_pass(
    added, removed, after, 0, boundary, false, empty_i, empty_i, false, "", "",
    empty_s, empty_s,
  )
  let _ = postprocess_pass(
    removed, added, before, 0, boundary, false, empty_i, empty_i, false, "", "",
    empty_s, empty_s,
  )
}
