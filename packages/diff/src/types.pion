///| Core value types and error definitions for the `diff` package.

///| Diff algorithm selection.
pub enum Algorithm {
  Myers
  Histogram
}

///| A single contiguous change hunk between `before` and `after` sequences.
///| Ranges are half-open `[start, end)`.
pub val struct Hunk {
  pub before_start : Int
  pub before_end : Int
  pub after_start : Int
  pub after_end : Int
}

///|
pub fn Hunk::new(
  before_start : Int,
  before_end : Int,
  after_start : Int,
  after_end : Int,
) -> Hunk {
  Hunk::{
    before_start: before_start,
    before_end: before_end,
    after_start: after_start,
    after_end: after_end,
  }
}

///|
pub fn Hunk::invert(self : Hunk) -> Hunk {
  Hunk::{
    before_start: self.after_start,
    before_end: self.after_end,
    after_start: self.before_start,
    after_end: self.before_end,
  }
}

///|
pub fn Hunk::before_len(self : Hunk) -> Int {
  self.before_end - self.before_start
}

///|
pub fn Hunk::after_len(self : Hunk) -> Int {
  self.after_end - self.after_start
}

///|
pub fn Hunk::is_pure_insertion(self : Hunk) -> Bool {
  self.before_start == self.before_end
}

///|
pub fn Hunk::is_pure_removal(self : Hunk) -> Bool {
  self.after_start == self.after_end
}

///| Result of diffing two token/line sequences.
pub struct DiffResult {
  pub hunks : Array[Hunk]
  pub before_len : Int
  pub after_len : Int
}

///|
pub fn DiffResult::is_empty(self : DiffResult) -> Bool {
  self.hunks.length() == 0
}

///|
pub fn DiffResult::count_removals(self : DiffResult) -> Int {
  let mut total = 0
  let mut i = 0
  let n = self.hunks.length()
  while i < n {
    total = total + self.hunks[i].before_len()
    i = i + 1
  }
  total
}

///|
pub fn DiffResult::count_additions(self : DiffResult) -> Int {
  let mut total = 0
  let mut i = 0
  let n = self.hunks.length()
  while i < n {
    total = total + self.hunks[i].after_len()
    i = i + 1
  }
  total
}

///| Error returned by unified patch parsing and application.
pub struct DiffError {
  pub code : String
  pub message : String
}

///|
pub fn DiffError::new(code : String, message : String) -> DiffError {
  DiffError::{ code: code, message: message }
}

///| A single line inside a parsed unified patch hunk.
pub enum PatchLine {
  Context(String)
  Remove(String)
  Add(String)
}

///| A single parsed hunk in a unified diff patch.
pub struct PatchHunk {
  pub old_start : Int
  pub old_count : Int
  pub new_start : Int
  pub new_count : Int
  pub lines : Array[PatchLine]
}

///| A parsed unified diff patch.
pub struct UnifiedPatch {
  pub before_name : String
  pub after_name : String
  pub hunks : Array[PatchHunk]
}

///| A chunk produced by three-way merge (`merge3`).
///| `Conflict(base, ours, theirs)` holds the conflicting line slices.
pub enum MergeChunk {
  Clean(Array[String])
  Conflict(Array[String], Array[String], Array[String])
}

///| Result of a three-way merge.
pub struct MergeResult {
  pub chunks : Array[MergeChunk]
  pub has_conflicts : Bool
}

///|
pub fn MergeResult::is_clean(self : MergeResult) -> Bool {
  !self.has_conflicts
}

///| Render merged output with custom conflict labels.
pub fn MergeResult::to_string_with_labels(
  self : MergeResult,
  ours_label : String,
  theirs_label : String,
) -> String {
  render_merge3(self, ours_label, theirs_label)
}

///| Render merged output with default `ours` / `theirs` conflict labels.
pub fn MergeResult::to_string(self : MergeResult) -> String {
  self.to_string_with_labels("ours", "theirs")
}
