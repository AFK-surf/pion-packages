///| Histogram diff algorithm with pooled occurrence lists and Myers fallback
///| (ported from `imara-diff/src/histogram`).

///| Pool + per-token occurrence lists with O(1) generation-based clear.
struct HistogramState {
  /// Per-token occurrence list metadata (indexed by token ID).
  occ_index : Array[Int]
  occ_gen : Array[Int]
  occ_len : Array[Int]
  /// Flat pooled storage for occurrence lists of length >= 2.
  pool_data : Array[Int]
  /// Free list head per size class (0..=4 for sizes 4, 8, 16, 32, 64).
  free_heads : Array[Int]
  mut generation : Int
}

///|
fn HistogramState::new(num_tokens : Int) -> HistogramState {
  HistogramState::{
    occ_index: Array::make(num_tokens, 0),
    occ_gen: Array::make(num_tokens, 0),
    occ_len: Array::make(num_tokens, 0),
    pool_data: Array::new(),
    free_heads: Array::make(5, -1),
    generation: 1,
  }
}

///|
fn HistogramState::clear(self : HistogramState) -> Unit {
  self.pool_data.clear()
  let mut i = 0
  while i < 5 {
    self.free_heads[i] = -1
    i = i + 1
  }
  self.generation = self.generation + 1
}

///|
fn sclass_size(sclass : Int) -> Int {
  4 << sclass
}

///| Size class for list length `len` (when `len` is a power of 2 >= 4: 4->1, 8->2, 16->3, 32->4).
fn sclass_for_power_of_two(len : Int) -> Int {
  if len == 4 {
    1
  } else if len == 8 {
    2
  } else if len == 16 {
    3
  } else {
    4
  }
}

///|
fn HistogramState::pool_alloc(self : HistogramState, sclass : Int) -> Int {
  let head = self.free_heads[sclass]
  if head < 0 {
    let offset = self.pool_data.length()
    let sz = sclass_size(sclass)
    let mut i = 0
    while i < sz {
      self.pool_data.push(-1)
      i = i + 1
    }
    offset
  } else {
    self.free_heads[sclass] = self.pool_data[head]
    head
  }
}

///|
fn HistogramState::pool_free(
  self : HistogramState,
  block : Int,
  sclass : Int,
) -> Unit {
  self.pool_data[block] = self.free_heads[sclass]
  self.free_heads[sclass] = block
}

///|
fn HistogramState::num_occurrences(self : HistogramState, tok : Int) -> Int {
  if self.occ_gen[tok] == self.generation {
    self.occ_len[tok]
  } else {
    0
  }
}

///|
fn HistogramState::push_occurrence(
  self : HistogramState,
  tok : Int,
  pos : Int,
) -> Unit {
  let len = self.num_occurrences(tok)
  if len == 0 {
    self.occ_gen[tok] = self.generation
    self.occ_index[tok] = pos
    self.occ_len[tok] = 1
  } else if len == 1 {
    let block = self.pool_alloc(0)
    self.pool_data[block] = self.occ_index[tok]
    self.pool_data[block + 1] = pos
    self.occ_index[tok] = block
    self.occ_len[tok] = 2
  } else if len <= 63 {
    let mut block = self.occ_index[tok]
    if len == 4 || len == 8 || len == 16 || len == 32 {
      let to_sc = sclass_for_power_of_two(len)
      let from_sc = to_sc - 1
      let new_block = self.pool_alloc(to_sc)
      let mut i = 0
      while i < len {
        self.pool_data[new_block + i] = self.pool_data[block + i]
        i = i + 1
      }
      self.pool_free(block, from_sc)
      block = new_block
      self.occ_index[tok] = block
    }
    self.pool_data[block + len] = pos
    self.occ_len[tok] = len + 1
  }
  // If len >= 64 (MAX_CHAIN_LEN + 1), ignore further occurrences;
  // find_lcs will detect `min_occurrences > MAX_CHAIN_LEN` and fall back to Myers.
}

///|
fn HistogramState::populate(
  self : HistogramState,
  before : Array[Int],
  b_off : Int,
  b_len : Int,
) -> Unit {
  let mut i = 0
  while i < b_len {
    self.push_occurrence(before[b_off + i], i)
    i = i + 1
  }
}

///| Result of histogram LCS search.
val struct HistLcs {
  /// `ok == false` means highly repetitive sequence: fall back to Myers.
  ok : Bool
  before_start : Int
  after_start : Int
  len : Int
}

///| Find the best common subsequence anchored by the rarest token in `before`.
fn find_histogram_lcs(
  before : Array[Int],
  b_off : Int,
  b_len : Int,
  after : Array[Int],
  a_off : Int,
  a_len : Int,
  state : HistogramState,
) -> HistLcs {
  let max_chain = 63
  let mut best_b = 0
  let mut best_a = 0
  let mut best_len = 0
  let mut min_occ = max_chain + 1
  let mut found_cs = false

  let mut pos = 0
  while pos < a_len {
    let tok = after[a_off + pos]
    let tok_occ = state.num_occurrences(tok)
    if tok_occ != 0 {
      found_cs = true
      if tok_occ <= min_occ {
        // Explore all occurrences of `tok` in `before`
        let mut next_a_pos = pos + 1
        let mut occ_i = 0
        let base_idx = state.occ_index[tok]
        let mut token_idx1 = if tok_occ == 1 {
          base_idx
        } else {
          state.pool_data[base_idx]
        }
        occ_i = 1

        while true {
          let mut occ = tok_occ
          let mut start1 = token_idx1
          let mut start2 = pos
          while start1 > 0 && start2 > 0 {
            let t1 = before[b_off + start1 - 1]
            let t2 = after[a_off + start2 - 1]
            if t1 == t2 {
              start1 = start1 - 1
              start2 = start2 - 1
              let no = state.num_occurrences(t1)
              if no < occ {
                occ = no
              }
            } else {
              break
            }
          }

          let mut end1 = token_idx1 + 1
          let mut end2 = pos + 1
          while end1 < b_len && end2 < a_len {
            let t1 = before[b_off + end1]
            let t2 = after[a_off + end2]
            if t1 == t2 {
              let no = state.num_occurrences(t1)
              if no < occ {
                occ = no
              }
              end1 = end1 + 1
              end2 = end2 + 1
            } else {
              break
            }
          }

          if next_a_pos < end2 {
            next_a_pos = end2
          }

          let cur_len = end2 - start2
          if best_len < cur_len || min_occ > occ {
            min_occ = occ
            best_b = start1
            best_a = start2
            best_len = cur_len
          }

          // Advance to next occurrence > end2 (matching upstream imara-diff/src/histogram/lcs.rs:132)
          let mut found_next = false
          while occ_i < tok_occ {
            let cand = state.pool_data[base_idx + occ_i]
            occ_i = occ_i + 1
            if cand > end2 {
              token_idx1 = cand
              found_next = true
              break
            }
          }
          if !found_next {
            break
          }
        }

        pos = next_a_pos
        continue
      }
    }
    pos = pos + 1
  }

  state.clear()
  if !found_cs || min_occ <= max_chain {
    HistLcs::{
      ok: true,
      before_start: best_b,
      after_start: best_a,
      len: best_len,
    }
  } else {
    HistLcs::{ ok: false, before_start: 0, after_start: 0, len: 0 }
  }
}

///| Recursive histogram diff with tail-call loop on the right half.
fn histogram_run(
  state : HistogramState,
  before : Array[Int],
  after : Array[Int],
  num_tokens : Int,
  removed : Array[Bool],
  added : Array[Bool],
  start_b_off : Int,
  start_b_len : Int,
  start_a_off : Int,
  start_a_len : Int,
) -> Unit {
  let mut b_off = start_b_off
  let mut b_len = start_b_len
  let mut a_off = start_a_off
  let mut a_len = start_a_len

  while true {
    if b_len == 0 {
      let mut i = 0
      while i < a_len {
        added[a_off + i] = true
        i = i + 1
      }
      return
    }
    if a_len == 0 {
      let mut i = 0
      while i < b_len {
        removed[b_off + i] = true
        i = i + 1
      }
      return
    }

    state.populate(before, b_off, b_len)
    let lcs = find_histogram_lcs(before, b_off, b_len, after, a_off, a_len, state)
    if !lcs.ok {
      // Fallback to Myers on highly repetitive sequences
      myers_diff_range(
        before, b_off, b_len, after, a_off, a_len, num_tokens, removed, added, false,
      )
      return
    }
    if lcs.len == 0 {
      let mut i = 0
      while i < b_len {
        removed[b_off + i] = true
        i = i + 1
      }
      let mut j = 0
      while j < a_len {
        added[a_off + j] = true
        j = j + 1
      }
      return
    }

    // Recurse on left subproblem
    histogram_run(
      state,
      before,
      after,
      num_tokens,
      removed,
      added,
      b_off,
      lcs.before_start,
      a_off,
      lcs.after_start,
    )

    // Loop on right subproblem
    let b_adv = lcs.before_start + lcs.len
    let a_adv = lcs.after_start + lcs.len
    b_off = b_off + b_adv
    b_len = b_len - b_adv
    a_off = a_off + a_adv
    a_len = a_len - a_adv
  }
}

///| Run Histogram diff on subranges `before[b_off..b_off+b_len]` and `after[a_off..a_off+a_len]`.
pub fn histogram_diff_range(
  before : Array[Int],
  b_off : Int,
  b_len : Int,
  after : Array[Int],
  a_off : Int,
  a_len : Int,
  num_tokens : Int,
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  if b_len == 0 {
    let mut i = 0
    while i < a_len {
      added[a_off + i] = true
      i = i + 1
    }
    return
  }
  if a_len == 0 {
    let mut i = 0
    while i < b_len {
      removed[b_off + i] = true
      i = i + 1
    }
    return
  }
  let state = HistogramState::new(num_tokens)
  histogram_run(
    state, before, after, num_tokens, removed, added, b_off, b_len, a_off, a_len,
  )
}
