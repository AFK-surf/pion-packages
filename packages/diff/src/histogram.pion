///| Histogram diff algorithm with pooled occurrence lists and Myers fallback
///| (ported from `imara-diff/src/histogram`).

///| Pool + per-token occurrence lists with O(1) generation-based clear.
///| `occ[tok]` packs `(gen << 36) | (len << 29) | index`:
///| - bits 0..28 (29 bits): `index` (inline pos when len == 1, pool offset when len >= 2)
///| - bits 29..35 (7 bits): `len` (0..=64)
///| - bits 36..62 (27 bits): `gen` (generation counter)
struct HistogramState {
  occ : Array[Int64]
  /// Flat pre-allocated pooled storage for occurrence lists of length >= 2.
  mut pool_data : Array[Int]
  mut pool_top : Int
  /// Free list head per size class (0..=4 for sizes 4, 8, 16, 32, 64).
  free_heads : Array[Int]
  mut generation : Int64
}

///|
fn HistogramState::new(num_tokens : Int, init_pool_cap : Int) -> HistogramState {
  let cap = if init_pool_cap < 256 { 256 } else { init_pool_cap }
  HistogramState::{
    occ: Array::make(num_tokens, 0L),
    pool_data: Array::make(cap, 0),
    pool_top: 0,
    free_heads: Array::make(5, -1),
    generation: 1L,
  }
}

///|
fn HistogramState::clear(self : HistogramState) -> Unit {
  self.pool_top = 0
  let fh = self.free_heads
  fh[0] = -1
  fh[1] = -1
  fh[2] = -1
  fh[3] = -1
  fh[4] = -1
  self.generation = self.generation + 1L
}

///| Size class for list length `len` (when `len` is a power of 2 >= 4: 4->1, 8->2, 16->3, 32->4).
fn sclass_for_power_of_two(len : Int) -> Int {
  if len == 4 {
    1
  } else if len == 8 {
    2
  } else if len == 16 {
    3
  } else {
    4
  }
}

///|
fn HistogramState::pool_alloc(self : HistogramState, sclass : Int) -> Int {
  let fh = self.free_heads
  let head = fh[sclass]
  if head < 0 {
    let offset = self.pool_top
    let sz = 4 << sclass
    let need = offset + sz
    let cur_cap = self.pool_data.length()
    if need > cur_cap {
      let mut new_cap = cur_cap * 2
      while new_cap < need {
        new_cap = new_cap * 2
      }
      let new_pool = Array::make(new_cap, 0)
      let old_pool = self.pool_data
      let mut i = 0
      while i < offset {
        new_pool[i] = old_pool[i]
        i = i + 1
      }
      self.pool_data = new_pool
    }
    self.pool_top = need
    offset
  } else {
    fh[sclass] = self.pool_data[head]
    head
  }
}

///|
fn HistogramState::pool_free(
  self : HistogramState,
  block : Int,
  sclass : Int,
) -> Unit {
  let fh = self.free_heads
  self.pool_data[block] = fh[sclass]
  fh[sclass] = block
}

///| Slow path for `populate` when `tok` already has >= 1 occurrence in the current generation.
fn HistogramState::push_occurrence_slow(
  self : HistogramState,
  tok : Int,
  pos : Int,
  e : Int64,
  gen_shifted : Int64,
) -> Unit {
  let len = ((e >> 29) & 127L).to_int()
  if len == 1 {
    let prev_pos = (e & 0x1FFFFFFFL).to_int()
    let block = self.pool_alloc(0)
    let pool = self.pool_data
    pool[block] = prev_pos
    pool[block + 1] = pos
    self.occ[tok] = gen_shifted | (2L << 29) | block.to_int64()
  } else if len <= 63 {
    let mut block = (e & 0x1FFFFFFFL).to_int()
    if len == 4 || len == 8 || len == 16 || len == 32 {
      let to_sc = sclass_for_power_of_two(len)
      let from_sc = to_sc - 1
      let new_block = self.pool_alloc(to_sc)
      let pool = self.pool_data
      let mut i = 0
      while i < len {
        pool[new_block + i] = pool[block + i]
        i = i + 1
      }
      self.pool_free(block, from_sc)
      block = new_block
    }
    self.pool_data[block + len] = pos
    self.occ[tok] = gen_shifted | ((len + 1).to_int64() << 29) | block.to_int64()
  }
}

///| Populate occurrence lists for `before[b_off..b_off+b_len]`.
fn HistogramState::populate(
  self : HistogramState,
  before : Array[Int],
  b_off : Int,
  b_len : Int,
) -> Unit {
  let occ = self.occ
  let mut pool = self.pool_data
  let gen = self.generation
  let gen_shifted = gen << 36
  let gen_len1 = gen_shifted | (1L << 29)
  let step_len = 1L << 29
  let mut i = 0
  while i < b_len {
    let tok = before[b_off + i]
    let e = occ[tok]
    if (e >> 36) != gen {
      occ[tok] = gen_len1 | i.to_int64()
    } else {
      let len = ((e >> 29) & 127L).to_int()
      if len >= 2 && len <= 63 && (len & (len - 1)) != 0 {
        let block = (e & 0x1FFFFFFFL).to_int()
        pool[block + len] = i
        occ[tok] = e + step_len
      } else if len <= 63 {
        self.push_occurrence_slow(tok, i, e, gen_shifted)
        pool = self.pool_data
      }
    }
    i = i + 1
  }
}

///| Result of histogram LCS search.
val struct HistLcs {
  /// `ok == false` means highly repetitive sequence: fall back to Myers.
  ok : Bool
  before_start : Int
  after_start : Int
  len : Int
}

///| Find the best common subsequence anchored by the rarest token in `before`.
fn find_histogram_lcs(
  before : Array[Int],
  b_off : Int,
  b_len : Int,
  after : Array[Int],
  a_off : Int,
  a_len : Int,
  state : HistogramState,
) -> HistLcs {
  let max_chain = 63
  let mut best_b = 0
  let mut best_a = 0
  let mut best_len = 0
  let mut min_occ = max_chain + 1
  let mut found_cs = false

  let occ = state.occ
  let pool = state.pool_data
  let gen = state.generation

  let mut pos = 0
  while pos < a_len {
    let tok = after[a_off + pos]
    let e = occ[tok]
    if (e >> 36) == gen {
      let tok_occ = ((e >> 29) & 127L).to_int()
      found_cs = true
      if tok_occ <= min_occ {
        // Explore all occurrences of `tok` in `before`
        let mut next_a_pos = pos + 1
        let base_idx = (e & 0x1FFFFFFFL).to_int()
        let mut token_idx1 = if tok_occ == 1 { base_idx } else { pool[base_idx] }
        let mut occ_i = 1

        while true {
          let mut cur_occ = tok_occ
          let mut p1 = b_off + token_idx1
          let mut p2 = a_off + pos
          let max_back = if token_idx1 < pos { token_idx1 } else { pos }
          let lim_back = p1 - max_back
          if cur_occ == 1 {
            // Fast path: cur_occ == 1 cannot decrease, so skip all `occ[t1]` lookups!
            while p1 > lim_back && before[p1 - 1] == after[p2 - 1] {
              p1 = p1 - 1
              p2 = p2 - 1
            }
          } else {
            while p1 > lim_back {
              let t1 = before[p1 - 1]
              if t1 == after[p2 - 1] {
                p1 = p1 - 1
                p2 = p2 - 1
                let no = ((occ[t1] >> 29) & 127L).to_int()
                if no < cur_occ {
                  cur_occ = no
                  if cur_occ == 1 {
                    while p1 > lim_back && before[p1 - 1] == after[p2 - 1] {
                      p1 = p1 - 1
                      p2 = p2 - 1
                    }
                    break
                  }
                }
              } else {
                break
              }
            }
          }
          let start1 = p1 - b_off
          let start2 = p2 - a_off

          let mut e1 = b_off + token_idx1 + 1
          let mut e2 = a_off + pos + 1
          let rem1 = b_len - (token_idx1 + 1)
          let rem2 = a_len - (pos + 1)
          let max_fwd = if rem1 < rem2 { rem1 } else { rem2 }
          let lim_fwd = e1 + max_fwd
          if cur_occ == 1 {
            while e1 < lim_fwd && before[e1] == after[e2] {
              e1 = e1 + 1
              e2 = e2 + 1
            }
          } else {
            while e1 < lim_fwd {
              let t1 = before[e1]
              if t1 == after[e2] {
                let no = ((occ[t1] >> 29) & 127L).to_int()
                if no < cur_occ {
                  cur_occ = no
                  if cur_occ == 1 {
                    e1 = e1 + 1
                    e2 = e2 + 1
                    while e1 < lim_fwd && before[e1] == after[e2] {
                      e1 = e1 + 1
                      e2 = e2 + 1
                    }
                    break
                  }
                }
                e1 = e1 + 1
                e2 = e2 + 1
              } else {
                break
              }
            }
          }
          let end2 = e2 - a_off

          if next_a_pos < end2 {
            next_a_pos = end2
          }

          let cur_len = end2 - start2
          if best_len < cur_len || min_occ > cur_occ {
            min_occ = cur_occ
            best_b = start1
            best_a = start2
            best_len = cur_len
          }

          // Advance to next occurrence > end2 (matching upstream imara-diff/src/histogram/lcs.rs:132)
          let mut found_next = false
          while occ_i < tok_occ {
            let cand = pool[base_idx + occ_i]
            occ_i = occ_i + 1
            if cand > end2 {
              token_idx1 = cand
              found_next = true
              break
            }
          }
          if !found_next {
            break
          }
        }

        pos = next_a_pos
        continue
      }
    }
    pos = pos + 1
  }

  state.clear()
  if !found_cs || min_occ <= max_chain {
    HistLcs::{
      ok: true,
      before_start: best_b,
      after_start: best_a,
      len: best_len,
    }
  } else {
    HistLcs::{ ok: false, before_start: 0, after_start: 0, len: 0 }
  }
}

///| Recursive histogram diff with tail-call loop on the right half.
fn histogram_run(
  state : HistogramState,
  before : Array[Int],
  after : Array[Int],
  num_tokens : Int,
  removed : Array[Bool],
  added : Array[Bool],
  start_b_off : Int,
  start_b_len : Int,
  start_a_off : Int,
  start_a_len : Int,
) -> Unit {
  let mut b_off = start_b_off
  let mut b_len = start_b_len
  let mut a_off = start_a_off
  let mut a_len = start_a_len

  while true {
    if b_len == 0 {
      let mut i = 0
      while i < a_len {
        added[a_off + i] = true
        i = i + 1
      }
      return
    }
    if a_len == 0 {
      let mut i = 0
      while i < b_len {
        removed[b_off + i] = true
        i = i + 1
      }
      return
    }

    if b_len == 1 && a_len == 1 {
      if before[b_off] != after[a_off] {
        removed[b_off] = true
        added[a_off] = true
      }
      return
    }

    state.populate(before, b_off, b_len)
    let lcs = find_histogram_lcs(before, b_off, b_len, after, a_off, a_len, state)
    if !lcs.ok {
      // Fallback to Myers on highly repetitive sequences
      myers_diff_range(
        before, b_off, b_len, after, a_off, a_len, num_tokens, removed, added, false,
      )
      return
    }
    if lcs.len == 0 {
      let mut i = 0
      while i < b_len {
        removed[b_off + i] = true
        i = i + 1
      }
      let mut j = 0
      while j < a_len {
        added[a_off + j] = true
        j = j + 1
      }
      return
    }

    // Recurse on left subproblem
    histogram_run(
      state,
      before,
      after,
      num_tokens,
      removed,
      added,
      b_off,
      lcs.before_start,
      a_off,
      lcs.after_start,
    )

    // Loop on right subproblem
    let b_adv = lcs.before_start + lcs.len
    let a_adv = lcs.after_start + lcs.len
    b_off = b_off + b_adv
    b_len = b_len - b_adv
    a_off = a_off + a_adv
    a_len = a_len - a_adv
  }
}

///| Run Histogram diff on subranges `before[b_off..b_off+b_len]` and `after[a_off..a_off+a_len]`.
pub fn histogram_diff_range(
  before : Array[Int],
  b_off : Int,
  b_len : Int,
  after : Array[Int],
  a_off : Int,
  a_len : Int,
  num_tokens : Int,
  removed : Array[Bool],
  added : Array[Bool],
) -> Unit {
  if b_len == 0 {
    let mut i = 0
    while i < a_len {
      added[a_off + i] = true
      i = i + 1
    }
    return
  }
  if a_len == 0 {
    let mut i = 0
    while i < b_len {
      removed[b_off + i] = true
      i = i + 1
    }
    return
  }
  let state = HistogramState::new(num_tokens, num_tokens * 2 + 256)
  histogram_run(
    state, before, after, num_tokens, removed, added, b_off, b_len, a_off, a_len,
  )
}
