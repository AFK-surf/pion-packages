///| Linear-space Myers O((N+M)D) divide-and-conquer diff algorithm with
///| preprocessing and middle-snake heuristics (ported from `imara-diff/src/myers`).

///| Approximate integer square root matching `imara-diff`'s `util::sqrt`.
pub fn isqrt_pow2(n : Int) -> Int {
  if n <= 1 {
    return 1
  }
  let mut bits = 0
  let mut v = n
  while v > 0 {
    bits = bits + 1
    v = v >> 1
  }
  1 << (bits / 2)
}

///| Common prefix length of `a[a_off..a_off+a_len]` and `b[b_off..b_off+b_len]`.
pub fn common_prefix_range(
  a : Array[Int],
  a_off : Int,
  a_len : Int,
  b : Array[Int],
  b_off : Int,
  b_len : Int,
) -> Int {
  let limit = if a_len < b_len { a_len } else { b_len }
  let mut off = 0
  while off < limit && a[a_off + off] == b[b_off + off] {
    off = off + 1
  }
  off
}

///| Common postfix length of `a[a_off..a_off+a_len]` and `b[b_off..b_off+b_len]`.
pub fn common_postfix_range(
  a : Array[Int],
  a_off : Int,
  a_len : Int,
  b : Array[Int],
  b_off : Int,
  b_len : Int,
) -> Int {
  let limit = if a_len < b_len { a_len } else { b_len }
  let mut off = 0
  while off < limit && a[a_off + a_len - 1 - off] == b[b_off + b_len - 1 - off] {
    off = off + 1
  }
  off
}

///| Occurrence status constants: 0 = None, 1 = Some, 2 = Common.
fn should_prune_common_line(status : Array[Int], pos : Int) -> Bool {
  let window = 100
  let mut unmatched_before = 0
  let mut common_before = 0
  let start = if pos > window { pos - window } else { 0 }
  let mut i = pos - 1
  while i >= start {
    let st = status[i]
    if st == 0 {
      unmatched_before = unmatched_before + 1
    } else if st == 2 {
      common_before = common_before + 1
    } else {
      break
    }
    i = i - 1
  }
  if unmatched_before == 0 {
    return false
  }
  let n = status.length()
  let end = if pos + window < n { pos + window } else { n }
  let mut unmatched_after = 0
  let mut common_after = 0
  let mut j = pos
  while j < end {
    let st = status[j]
    if st == 0 {
      unmatched_after = unmatched_after + 1
    } else if st == 2 {
      common_after = common_after + 1
    } else {
      break
    }
    j = j + 1
  }
  if unmatched_after == 0 {
    return false
  }
  let common = common_before + common_after
  let unmatched = unmatched_before + unmatched_after
  unmatched > 3 * common
}

///| Preprocess a slice of `before` and `after`: mark tokens absent in the other
///| side (and noisy common lines in large files) as changed, returning compacted
///| `(tokens, original_indices)` arrays.
fn preprocess_side(
  tokens : Array[Int],
  off : Int,
  len : Int,
  other_counts : Array[Int],
  eqlimit : Int,
  allow_common_prune : Bool,
  changed : Array[Bool],
) -> (Array[Int], Array[Int]) {
  let status = Array::make(len, 0)
  let other_len = other_counts.length()
  let mut i = 0
  while i < len {
    let tok = tokens[off + i]
    let cnt = if tok >= 0 && tok < other_len { other_counts[tok] } else { 0 }
    if cnt == 0 {
      status[i] = 0
    } else if allow_common_prune && cnt >= eqlimit {
      status[i] = 2
    } else {
      status[i] = 1
    }
    i = i + 1
  }

  let out_tokens : Array[Int] = Array::new()
  let out_indices : Array[Int] = Array::new()
  let mut k = 0
  while k < len {
    let st = status[k]
    let prune = if st == 0 {
      true
    } else if st == 1 {
      false
    } else {
      should_prune_common_line(status, k)
    }
    if prune {
      changed[off + k] = true
    } else {
      out_tokens.push(tokens[off + k])
      out_indices.push(off + k)
    }
    k = k + 1
  }
  (out_tokens, out_indices)
}

///| Split result from middle snake search.
val struct MyersSplit {
  token_idx1 : Int
  token_idx2 : Int
  minimized_lo : Bool
  minimized_hi : Bool
}

///| Find a good snake in the forward search (heuristic for high edit cost).
fn find_good_snake_forward(
  kvec : Array[Int],
  base : Int,
  kmin : Int,
  kmax : Int,
  ec : Int,
  t1 : Array[Int],
  off1 : Int,
  len1 : Int,
  t2 : Array[Int],
  off2 : Int,
  len2 : Int,
) -> (Bool, Int, Int) {
  let snake_cnt = 20
  let k_heur = 4
  let mut best_score = 0
  let mut best_x = 0
  let mut best_y = 0
  let mut k = kmax
  while k >= kmin {
    let x = kvec[base + k]
    let y = x - k
    if x >= snake_cnt && x < len1 && y >= snake_cnt && y < len2 {
      let abs_k = if k < 0 { -k } else { k }
      let score = x + y + abs_k
      if score > k_heur * ec && score > best_score {
        let mut ok = true
        let mut s = 1
        while s <= snake_cnt {
          if t1[off1 + x - s] != t2[off2 + y - s] {
            ok = false
            break
          }
          s = s + 1
        }
        if ok {
          best_x = x
          best_y = y
          best_score = score
        }
      }
    }
    k = k - 2
  }
  (best_score > 0, best_x, best_y)
}

///| Find a good snake in the backward search (heuristic for high edit cost).
fn find_good_snake_backward(
  kvec : Array[Int],
  base : Int,
  kmin : Int,
  kmax : Int,
  ec : Int,
  t1 : Array[Int],
  off1 : Int,
  len1 : Int,
  t2 : Array[Int],
  off2 : Int,
  len2 : Int,
) -> (Bool, Int, Int) {
  let snake_cnt = 20
  let k_heur = 4
  let mut best_score = 0
  let mut best_x = 0
  let mut best_y = 0
  let lim1 = len1 - snake_cnt
  let lim2 = len2 - snake_cnt
  let mut k = kmax
  while k >= kmin {
    let x = kvec[base + k]
    let y = x - k
    if x >= 0 && x < lim1 && y >= 0 && y < lim2 {
      let abs_k = if k < 0 { -k } else { k }
      let score = (len1 - x) + (len2 - y) + abs_k
      if score > k_heur * ec && score > best_score {
        let mut ok = true
        let mut s = 0
        while s < snake_cnt {
          if t1[off1 + x + s] != t2[off2 + y + s] {
            ok = false
            break
          }
          s = s + 1
        }
        if ok {
          best_x = x
          best_y = y
          best_score = score
        }
      }
    }
    k = k - 2
  }
  (best_score > 0, best_x, best_y)
}

///| Middle-snake split in `O(D)` iterations using `kvec`.
fn myers_split(
  kvec : Array[Int],
  kf_base : Int,
  kb_base : Int,
  max_cost : Int,
  t1 : Array[Int],
  off1 : Int,
  len1 : Int,
  t2 : Array[Int],
  off2 : Int,
  len2 : Int,
  need_min : Bool,
) -> MyersSplit {
  let neg_inf = -1073741824
  let pos_inf = 1073741824
  let snake_cnt = 20
  let heur_min_cost = 256

  let dmin = -len2
  let dmax = len1
  let mut f_kmin = 0
  let mut f_kmax = 0
  kvec[kf_base] = 0

  let b_mid = dmin + dmax
  let mut b_kmin = b_mid
  let mut b_kmax = b_mid
  kvec[kb_base + b_mid] = len1

  let is_odd = ((len2 - len1) & 1) != 0
  let mut ec = 0

  while ec <= max_cost {
    let mut found_snake = false

    // Forward step: extend diagonal range
    if f_kmin > dmin {
      f_kmin = f_kmin - 1
      kvec[kf_base + f_kmin - 1] = neg_inf
    } else {
      f_kmin = f_kmin + 1
    }
    if f_kmax < dmax {
      f_kmax = f_kmax + 1
      kvec[kf_base + f_kmax + 1] = neg_inf
    } else {
      f_kmax = f_kmax - 1
    }

    let mut k = f_kmax
    while k >= f_kmin {
      let left = kvec[kf_base + k - 1]
      let right = kvec[kf_base + k + 1]
      let mut x = if left >= right { left + 1 } else { right }
      let mut y = x - k
      let mut off = 0
      if x >= 0 && y >= 0 && x < len1 && y < len2 {
        while x + off < len1 && y + off < len2 && t1[off1 + x + off] == t2[off2 + y + off] {
          off = off + 1
        }
      }
      if off > snake_cnt {
        found_snake = true
      }
      x = x + off
      y = y + off
      kvec[kf_base + k] = x
      if is_odd && k >= b_kmin && k <= b_kmax && kvec[kb_base + k] <= x {
        return MyersSplit::{
          token_idx1: x,
          token_idx2: y,
          minimized_lo: true,
          minimized_hi: true,
        }
      }
      k = k - 2
    }

    // Backward step: extend diagonal range
    if b_kmin > dmin {
      b_kmin = b_kmin - 1
      kvec[kb_base + b_kmin - 1] = pos_inf
    } else {
      b_kmin = b_kmin + 1
    }
    if b_kmax < dmax {
      b_kmax = b_kmax + 1
      kvec[kb_base + b_kmax + 1] = pos_inf
    } else {
      b_kmax = b_kmax - 1
    }

    let mut kb = b_kmax
    while kb >= b_kmin {
      let left = kvec[kb_base + kb - 1]
      let right = kvec[kb_base + kb + 1]
      let mut x = if left < right { left } else { right - 1 }
      let mut y = x - kb
      let mut off = 0
      if x > 0 && y > 0 && x <= len1 && y <= len2 {
        while x - off > 0 && y - off > 0 && t1[off1 + x - 1 - off] == t2[off2 + y - 1 - off] {
          off = off + 1
        }
      }
      if off > snake_cnt {
        found_snake = true
      }
      x = x - off
      y = y - off
      kvec[kb_base + kb] = x
      if !is_odd && kb >= f_kmin && kb <= f_kmax && x <= kvec[kf_base + kb] {
        return MyersSplit::{
          token_idx1: x,
          token_idx2: y,
          minimized_lo: true,
          minimized_hi: true,
        }
      }
      kb = kb - 2
    }

    if need_min {
      continue
    }

    if found_snake && ec > heur_min_cost {
      let (ok_f, fx, fy) = find_good_snake_forward(
        kvec, kf_base, f_kmin, f_kmax, ec, t1, off1, len1, t2, off2, len2,
      )
      if ok_f {
        return MyersSplit::{
          token_idx1: fx,
          token_idx2: fy,
          minimized_lo: true,
          minimized_hi: false,
        }
      }
      let (ok_b, bx, by) = find_good_snake_backward(
        kvec, kb_base, b_kmin, b_kmax, ec, t1, off1, len1, t2, off2, len2,
      )
      if ok_b {
        return MyersSplit::{
          token_idx1: bx,
          token_idx2: by,
          minimized_lo: false,
          minimized_hi: true,
        }
      }
    }

    ec = ec + 1
  }

  // Max cost exceeded: pick furthest reaching diagonal from forward or backward
  let mut best_f_dist = -1
  let mut best_f_x = -1
  let mut kf = f_kmax
  while kf >= f_kmin {
    let mut x = kvec[kf_base + kf]
    if x > len1 {
      x = len1
    }
    let mut y = x - kf
    if y > len2 {
      x = len2 + kf
      y = len2
    }
    let dist = x + y
    if dist > best_f_dist {
      best_f_dist = dist
      best_f_x = x
    }
    kf = kf - 2
  }

  let mut best_b_dist = pos_inf
  let mut best_b_x = pos_inf
  let mut kb2 = b_kmax
  while kb2 >= b_kmin {
    let mut x = kvec[kb_base + kb2]
    if x < 0 {
      x = 0
    }
    let mut y = x - kb2
    if y < 0 {
      x = kb2
      y = 0
    }
    let dist = x + y
    if dist < best_b_dist {
      best_b_dist = dist
      best_b_x = x
    }
    kb2 = kb2 - 2
  }

  if best_f_dist > len1 + len2 - best_b_dist {
    MyersSplit::{
      token_idx1: best_f_x,
      token_idx2: best_f_dist - best_f_x,
      minimized_lo: true,
      minimized_hi: false,
    }
  } else {
    MyersSplit::{
      token_idx1: best_b_x,
      token_idx2: best_b_dist - best_b_x,
      minimized_lo: false,
      minimized_hi: true,
    }
  }
}

///| Recursive divide-and-conquer Myers with tail-call loop on the upper half.
fn myers_run(
  kvec : Array[Int],
  kf_base : Int,
  kb_base : Int,
  max_cost : Int,
  t1 : Array[Int],
  idx1 : Array[Int],
  removed : Array[Bool],
  t2 : Array[Int],
  idx2 : Array[Int],
  added : Array[Bool],
  start_off1 : Int,
  start_len1 : Int,
  start_off2 : Int,
  start_len2 : Int,
  start_need_min : Bool,
) -> Unit {
  let mut off1 = start_off1
  let mut len1 = start_len1
  let mut off2 = start_off2
  let mut len2 = start_len2
  let mut need_min = start_need_min

  while true {
    let pre = common_prefix_range(t1, off1, len1, t2, off2, len2)
    off1 = off1 + pre
    len1 = len1 - pre
    off2 = off2 + pre
    len2 = len2 - pre

    let post = common_postfix_range(t1, off1, len1, t2, off2, len2)
    len1 = len1 - post
    len2 = len2 - post

    if len1 == 0 {
      let mut i = 0
      while i < len2 {
        added[idx2[off2 + i]] = true
        i = i + 1
      }
      return
    }
    if len2 == 0 {
      let mut i = 0
      while i < len1 {
        removed[idx1[off1 + i]] = true
        i = i + 1
      }
      return
    }

    let sp = myers_split(
      kvec, kf_base, kb_base, max_cost, t1, off1, len1, t2, off2, len2, need_min,
    )
    myers_run(
      kvec,
      kf_base,
      kb_base,
      max_cost,
      t1,
      idx1,
      removed,
      t2,
      idx2,
      added,
      off1,
      sp.token_idx1,
      off2,
      sp.token_idx2,
      sp.minimized_lo,
    )

    off1 = off1 + sp.token_idx1
    len1 = len1 - sp.token_idx1
    off2 = off2 + sp.token_idx2
    len2 = len2 - sp.token_idx2
    need_min = sp.minimized_hi
  }
}

///| Run Myers diff on subranges `before[b_off..b_off+b_len]` and `after[a_off..a_off+a_len]`,
///| marking removed/added booleans directly in `removed` / `added`.
pub fn myers_diff_range(
  before : Array[Int],
  b_off : Int,
  b_len : Int,
  after : Array[Int],
  a_off : Int,
  a_len : Int,
  num_tokens : Int,
  removed : Array[Bool],
  added : Array[Bool],
  minimal : Bool,
) -> Unit {
  if b_len == 0 {
    let mut i = 0
    while i < a_len {
      added[a_off + i] = true
      i = i + 1
    }
    return
  }
  if a_len == 0 {
    let mut i = 0
    while i < b_len {
      removed[b_off + i] = true
      i = i + 1
    }
    return
  }

  let counts1 = Array::make(num_tokens, 0)
  let mut i = 0
  while i < b_len {
    let tok = before[b_off + i]
    if tok >= 0 && tok < num_tokens {
      counts1[tok] = counts1[tok] + 1
    }
    i = i + 1
  }
  let counts2 = Array::make(num_tokens, 0)
  let mut j = 0
  while j < a_len {
    let tok = after[a_off + j]
    if tok >= 0 && tok < num_tokens {
      counts2[tok] = counts2[tok] + 1
    }
    j = j + 1
  }

  let max_eqlimit = 1024
  let sq1 = isqrt_pow2(b_len)
  let eqlimit1 = if sq1 < max_eqlimit { sq1 } else { max_eqlimit }
  let sq2 = isqrt_pow2(a_len)
  let eqlimit2 = if sq2 < max_eqlimit { sq2 } else { max_eqlimit }
  let allow_common_prune = !minimal && (b_len >= 64 || a_len >= 64)

  let (t1, idx1) = preprocess_side(
    before, b_off, b_len, counts2, eqlimit1, allow_common_prune, removed,
  )
  let (t2, idx2) = preprocess_side(
    after, a_off, a_len, counts1, eqlimit2, allow_common_prune, added,
  )

  let len1 = t1.length()
  let len2 = t2.length()
  if len1 == 0 {
    let mut k = 0
    while k < len2 {
      added[idx2[k]] = true
      k = k + 1
    }
    return
  }
  if len2 == 0 {
    let mut k = 0
    while k < len1 {
      removed[idx1[k]] = true
      k = k + 1
    }
    return
  }

  let ndiags = len1 + len2 + 3
  let kvec = Array::make(2 * ndiags + 2, 0)
  let kf_base = len2 + 1
  let kb_base = ndiags + len2 + 1
  let sq_d = isqrt_pow2(ndiags)
  let max_cost = if sq_d > 256 { sq_d } else { 256 }

  myers_run(
    kvec, kf_base, kb_base, max_cost, t1, idx1, removed, t2, idx2, added, 0, len1,
    0, len2, minimal,
  )
}
