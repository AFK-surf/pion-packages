///| Unified diff formatting, parsing, and forward/reverse patch application.

///| Write a line span from `src[start..end)` with a 1-char prefix (` `, `-`, `+`),
///| emitting `\ No newline at end of file\n` if the line lacks a trailing `\n`.
fn write_diff_line(
  sb : StringBuilder,
  prefix : String,
  src : String,
  start : Int,
  end : Int,
) -> Unit {
  sb.write_string(prefix)
  sb.write_string(src.slice(start, end))
  if end == start || src.code_unit_at(end - 1) != 10 {
    sb.write_string("\n\\ No newline at end of file\n")
  }
}

///| Write a non-negative integer directly into `sb` without heap String allocation.
fn write_uint(sb : StringBuilder, v_in : Int) -> Unit {
  if v_in < 10 {
    sb.write_byte((48 + v_in).to_byte())
    return
  }
  let mut v = v_in
  let mut div = 1
  while v / div >= 10 {
    div = div * 10
  }
  while div > 0 {
    let d = v / div
    sb.write_byte((48 + d).to_byte())
    v = v - d * div
    div = div / 10
  }
}

///| Write a unified diff hunk header `@@ -a,b +c,d @@\n`.
fn write_hunk_header(
  sb : StringBuilder,
  start_before : Int,
  len_before : Int,
  start_after : Int,
  len_after : Int,
) -> Unit {
  let b1 = if len_before == 0 { start_before } else { start_before + 1 }
  let a1 = if len_after == 0 { start_after } else { start_after + 1 }
  sb.write_string("@@ -")
  write_uint(sb, b1)
  sb.write_byte(44.to_byte())
  write_uint(sb, len_before)
  sb.write_string(" +")
  write_uint(sb, a1)
  sb.write_byte(44.to_byte())
  write_uint(sb, len_after)
  sb.write_string(" @@\n")
}

///| Format a unified diff between `before` and `after`.
pub fn unified_diff(
  before : String,
  after : String,
  before_name : String,
  after_name : String,
  context : Int,
  algo : Algorithm,
) -> String {
  let ctx = if context < 0 {
    0
  } else if context > 1048576 {
    1048576
  } else {
    context
  }
  let margin = if ctx > 21 { ctx } else { 21 }
  let mut interner = intern_lines_windowed(before, after, margin, false)
  let mut mid_b = interner.before_tokens.length()
  let mut mid_a = interner.after_tokens.length()
  if mid_b == 0 && mid_a == 0 {
    return ""
  }

  let mut flags = compute_diff_flags(
    interner.before_tokens,
    interner.after_tokens,
    interner.num_tokens,
    algo,
  )
  let mut removed = flags.0
  let mut added = flags.1
  postprocess_interned_lines(interner, removed, added)

  // Safety check: if slider postprocessing pushed a hunk all the way to a stripped boundary,
  // re-run on the full file for 100% exactness with imara-diff.
  let hit_pre = interner.pre_lines > 0 && ((mid_b > 0 && removed[0]) || (mid_a > 0 && added[0]))
  let hit_suf = interner.has_stripped_suffix && ((mid_b > 0 && removed[mid_b - 1]) || (mid_a > 0 && added[mid_a - 1]))
  if hit_pre || hit_suf {
    interner = intern_lines_windowed(before, after, -1, false)
    mid_b = interner.before_tokens.length()
    mid_a = interner.after_tokens.length()
    flags = compute_diff_flags(
      interner.before_tokens,
      interner.after_tokens,
      interner.num_tokens,
      algo,
    )
    removed = flags.0
    added = flags.1
    postprocess_interned_lines(interner, removed, added)
  }

  let hunks = collect_hunks(removed, added)
  let num_hunks = hunks.length()
  if num_hunks == 0 {
    return ""
  }

  let sb = StringBuilder::new()
  if before_name.length() > 0 || after_name.length() > 0 {
    sb.write_string("--- ")
    sb.write_string(before_name)
    sb.write_string("\n+++ ")
    sb.write_string(after_name)
    sb.write_string("\n")
  }

  let pre_lines = interner.pre_lines
  let before_offsets = interner.before_offsets
  let after_offsets = interner.after_offsets
  let before_len = mid_b
  let two_ctx = 2 * ctx

  let mut hi = 0
  while hi < num_hunks {
    // Group consecutive hunks whose gap <= 2 * ctx so we can write the header directly to `sb`
    let first = hunks[hi]
    let grp_b_start = if first.before_start > ctx {
      first.before_start - ctx
    } else {
      0
    }
    let grp_a_start = if first.after_start > ctx {
      first.after_start - ctx
    } else {
      0
    }
    let mut hi_end = hi + 1
    let mut prev_b_end = first.before_end
    while hi_end < num_hunks && hunks[hi_end].before_start - prev_b_end <= two_ctx {
      prev_b_end = hunks[hi_end].before_end
      hi_end = hi_end + 1
    }
    let last = hunks[hi_end - 1]
    let trail_end = if last.before_end + ctx < before_len {
      last.before_end + ctx
    } else {
      before_len
    }
    let trail_len = trail_end - last.before_end
    let grp_b_len = trail_end - grp_b_start
    let grp_a_len = (last.after_end + trail_len) - grp_a_start

    write_hunk_header(
      sb,
      pre_lines + grp_b_start,
      grp_b_len,
      pre_lines + grp_a_start,
      grp_a_len,
    )

    let mut pos = grp_b_start
    let mut k = hi
    while k < hi_end {
      let h = hunks[k]
      while pos < h.before_start {
        write_diff_line(
          sb,
          " ",
          before,
          before_offsets[pos],
          before_offsets[pos + 1],
        )
        pos = pos + 1
      }
      let mut r = h.before_start
      while r < h.before_end {
        write_diff_line(
          sb,
          "-",
          before,
          before_offsets[r],
          before_offsets[r + 1],
        )
        r = r + 1
      }
      let mut a = h.after_start
      while a < h.after_end {
        write_diff_line(
          sb,
          "+",
          after,
          after_offsets[a],
          after_offsets[a + 1],
        )
        a = a + 1
      }
      pos = h.before_end
      k = k + 1
    }
    while pos < trail_end {
      write_diff_line(
        sb,
        " ",
        before,
        before_offsets[pos],
        before_offsets[pos + 1],
      )
      pos = pos + 1
    }

    hi = hi_end
  }

  sb.to_string()
}

///| Strip trailing `\n` or `\r\n` from a line.
fn strip_eol(s : String) -> String {
  let mut n = s.length()
  if n > 0 && s.code_unit_at(n - 1) == 10 {
    n = n - 1
  }
  if n > 0 && s.code_unit_at(n - 1) == 13 {
    n = n - 1
  }
  s.slice(0, n)
}

///| Strip trailing `\n` (only `\n`) from a string.
fn strip_trailing_lf(s : String) -> String {
  let n = s.length()
  if n > 0 && s.code_unit_at(n - 1) == 10 {
    s.slice(0, n - 1)
  } else {
    s
  }
}

///| Check if `s` starts with `prefix`.
fn str_starts_with(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if s.length() < pn {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a non-negative decimal integer from `s[start..end)`.
fn parse_uint_span(s : String, start : Int, end : Int) -> Result[Int, DiffError] {
  if start >= end {
    return Err(DiffError::new("invalid_header", "empty integer in hunk header"))
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return Err(
        DiffError::new("invalid_header", "non-digit character in hunk header"),
      )
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  Ok(acc)
}

///| Parse `start[,count]` from `s[start..end)` (default count = 1 if `,` omitted).
fn parse_range_spec(
  s : String,
  start : Int,
  end : Int,
) -> Result[(Int, Int), DiffError] {
  let mut comma = -1
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 44 {
      comma = i
      break
    }
    i = i + 1
  }
  if comma < 0 {
    match parse_uint_span(s, start, end) {
      Ok(st) => Ok((st, 1))
      Err(e) => Err(e)
    }
  } else {
    match parse_uint_span(s, start, comma) {
      Err(e) => Err(e)
      Ok(st) =>
      match parse_uint_span(s, comma + 1, end) {
        Err(e) => Err(e)
        Ok(cnt) => Ok((st, cnt))
      }
    }
  }
}

///| Parse a hunk header line `@@ -a[,b] +c[,d] @@...`.
fn parse_hunk_header(line : String) -> Result[(Int, Int, Int, Int), DiffError] {
  let trimmed = strip_eol(line)
  if !str_starts_with(trimmed, "@@ -") {
    return Err(
      DiffError::new("invalid_header", "hunk header must start with '@@ -'"),
    )
  }
  let n = trimmed.length()
  // Find space after old range
  let mut sp1 = 4
  while sp1 < n && trimmed.code_unit_at(sp1) != 32 {
    sp1 = sp1 + 1
  }
  if sp1 + 2 >= n || trimmed.code_unit_at(sp1 + 1) != 43 {
    return Err(
      DiffError::new("invalid_header", "expected ' +' after old range in hunk header"),
    )
  }
  // Find space after new range
  let mut sp2 = sp1 + 2
  while sp2 < n && trimmed.code_unit_at(sp2) != 32 {
    sp2 = sp2 + 1
  }
  if sp2 + 2 >= n || trimmed.code_unit_at(sp2 + 1) != 64 || trimmed.code_unit_at(sp2 + 2) != 64 {
    return Err(
      DiffError::new("invalid_header", "missing closing ' @@' in hunk header"),
    )
  }
  let (old_start, old_count) = match parse_range_spec(trimmed, 4, sp1) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }
  let (new_start, new_count) = match parse_range_spec(trimmed, sp1 + 2, sp2) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }
  Ok((old_start, old_count, new_start, new_count))
}

///| Extract filename after `--- ` or `+++ ` (stopping at `\t` if a timestamp follows).
fn parse_header_name(line : String) -> String {
  let t = strip_eol(line)
  let n = t.length()
  let mut end = 4
  while end < n && t.code_unit_at(end) != 9 {
    end = end + 1
  }
  t.slice(4, end)
}

///| Parse a unified diff patch string.
pub fn parse_unified_patch(patch : String) -> Result[UnifiedPatch, DiffError] {
  if patch.length() == 0 {
    return Ok(UnifiedPatch::{
      before_name: "",
      after_name: "",
      hunks: Array::new(),
    })
  }

  let raw_lines = split_lines(patch)
  let n = raw_lines.length()
  let mut before_name = ""
  let mut after_name = ""
  let hunks : Array[PatchHunk] = Array::new()
  let mut i = 0

  while i < n {
    let line = raw_lines[i]
    if str_starts_with(line, "--- ") {
      before_name = parse_header_name(line)
      i = i + 1
      continue
    }
    if str_starts_with(line, "+++ ") {
      after_name = parse_header_name(line)
      i = i + 1
      continue
    }
    if str_starts_with(line, "diff ") || str_starts_with(line, "index ") || str_starts_with(line, "old mode ") || str_starts_with(line, "new mode ") || str_starts_with(line, "new file mode ") || str_starts_with(line, "deleted file mode ") || str_starts_with(line, "similarity index ") || str_starts_with(line, "rename from ") || str_starts_with(line, "rename to ") {
      i = i + 1
      continue
    }
    if str_starts_with(line, "@@") {
      let (old_start, old_count, new_start, new_count) = match
      parse_hunk_header(line) {
        Ok(hdr) => hdr
        Err(e) => return Err(e)
      }
      i = i + 1
      let plines : Array[PatchLine] = Array::new()
      let mut old_seen = 0
      let mut new_seen = 0

      while i < n && (old_seen < old_count || new_seen < new_count) {
        let cur = raw_lines[i]
        if cur.length() == 0 {
          return Err(DiffError::new("invalid_hunk", "unexpected empty line"))
        }
        let ch = cur.code_unit_at(0)
        if ch == 32 {
          // ' ' context
          let content = cur.slice(1, cur.length())
          plines.push(PatchLine::Context(content))
          old_seen = old_seen + 1
          new_seen = new_seen + 1
          i = i + 1
        } else if ch == 45 {
          // '-' remove
          let content = cur.slice(1, cur.length())
          plines.push(PatchLine::Remove(content))
          old_seen = old_seen + 1
          i = i + 1
        } else if ch == 43 {
          // '+' add
          let content = cur.slice(1, cur.length())
          plines.push(PatchLine::Add(content))
          new_seen = new_seen + 1
          i = i + 1
        } else if ch == 92 {
          // '\ No newline at end of file' applies to previous line
          if plines.length() == 0 {
            return Err(
              DiffError::new("invalid_hunk", "unexpected '\\' line at hunk start"),
            )
          }
          let last_idx = plines.length() - 1
          plines[last_idx] = match plines[last_idx] {
            PatchLine::Context(s) => PatchLine::Context(strip_trailing_lf(s))
            PatchLine::Remove(s) => PatchLine::Remove(strip_trailing_lf(s))
            PatchLine::Add(s) => PatchLine::Add(strip_trailing_lf(s))
          }
          i = i + 1
        } else {
          return Err(
            DiffError::new(
              "invalid_hunk",
              "invalid line prefix in hunk body: " + strip_eol(cur),
            ),
          )
        }
      }

      // Also consume a trailing `\ No newline at end of file` immediately after the last line of the hunk
      if i < n && raw_lines[i].length() > 0 && raw_lines[i].code_unit_at(0) == 92 {
        if plines.length() == 0 {
          return Err(
            DiffError::new("invalid_hunk", "unexpected '\\' line after empty hunk"),
          )
        }
        let last_idx = plines.length() - 1
        plines[last_idx] = match plines[last_idx] {
          PatchLine::Context(s) => PatchLine::Context(strip_trailing_lf(s))
          PatchLine::Remove(s) => PatchLine::Remove(strip_trailing_lf(s))
          PatchLine::Add(s) => PatchLine::Add(strip_trailing_lf(s))
        }
        i = i + 1
      }

      if old_seen != old_count || new_seen != new_count {
        return Err(
          DiffError::new(
            "invalid_hunk",
            "hunk line count mismatch (expected -" + old_count.to_string() + " +" + new_count.to_string() + ", got -" + old_seen.to_string() + " +" + new_seen.to_string() + ")",
          ),
        )
      }

      hunks.push(PatchHunk::{
        old_start: old_start,
        old_count: old_count,
        new_start: new_start,
        new_count: new_count,
        lines: plines,
      })
      continue
    }

    return Err(
      DiffError::new("invalid_patch", "unexpected line outside hunk: " + strip_eol(line)),
    )
  }

  Ok(UnifiedPatch::{
    before_name: before_name,
    after_name: after_name,
    hunks: hunks,
  })
}

///| Internal patch applier supporting both forward (`reverse == false`) and
///| reverse (`reverse == true`) application.
fn apply_patch_impl(
  source : String,
  patch : String,
  reverse : Bool,
) -> Result[String, DiffError] {
  let parsed = match parse_unified_patch(patch) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if parsed.hunks.length() == 0 {
    return Ok(source)
  }

  let src_lines = split_lines(source)
  let src_len = src_lines.length()
  let out = StringBuilder::new()
  let mut cursor = 0

  let mut hi = 0
  while hi < parsed.hunks.length() {
    let h = parsed.hunks[hi]
    let start_1 = if reverse { h.new_start } else { h.old_start }
    let count = if reverse { h.new_count } else { h.old_count }
    let target = if count == 0 {
      start_1
    } else {
      start_1 - 1
    }

    if target < cursor || target > src_len {
      return Err(
        DiffError::new(
          "hunk_out_of_bounds",
          "hunk target line out of bounds at line " + start_1.to_string(),
        ),
      )
    }

    while cursor < target {
      out.write_string(src_lines[cursor])
      cursor = cursor + 1
    }

    let mut li = 0
    while li < h.lines.length() {
      match h.lines[li] {
        PatchLine::Context(s) => {
          if cursor >= src_len || src_lines[cursor] != s {
            return Err(
              DiffError::new(
                "context_mismatch",
                "context line mismatch at line " + (cursor + 1).to_string(),
              ),
            )
          }
          out.write_string(s)
          cursor = cursor + 1
        }
        PatchLine::Remove(s) => {
          if reverse {
            out.write_string(s)
          } else {
            if cursor >= src_len || src_lines[cursor] != s {
              return Err(
                DiffError::new(
                  "remove_mismatch",
                  "removed line mismatch at line " + (cursor + 1).to_string(),
                ),
              )
            }
            cursor = cursor + 1
          }
        }
        PatchLine::Add(s) => {
          if reverse {
            if cursor >= src_len || src_lines[cursor] != s {
              return Err(
                DiffError::new(
                  "reverse_mismatch",
                  "added line mismatch during reverse apply at line " + (cursor + 1).to_string(),
                ),
              )
            }
            cursor = cursor + 1
          } else {
            out.write_string(s)
          }
        }
      }
      li = li + 1
    }

    hi = hi + 1
  }

  while cursor < src_len {
    out.write_string(src_lines[cursor])
    cursor = cursor + 1
  }

  Ok(out.to_string())
}

///| Apply a unified diff patch to `original`.
pub fn apply_unified_patch(
  original : String,
  patch : String,
) -> Result[String, DiffError] {
  apply_patch_impl(original, patch, false)
}

///| Reverse-apply a unified diff patch to `modified` to recover the original.
pub fn apply_unified_patch_reverse(
  modified : String,
  patch : String,
) -> Result[String, DiffError] {
  apply_patch_impl(modified, patch, true)
}
