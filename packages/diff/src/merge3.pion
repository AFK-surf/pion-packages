///| Three-way merge (`merge3`) built on top of `diff_lines`.

///| Copy `lines[start..end)` into a fresh `Array[String]`.
fn slice_lines(lines : Array[String], start : Int, end : Int) -> Array[String] {
  let out : Array[String] = Array::new()
  let mut i = start
  while i < end {
    out.push(lines[i])
    i = i + 1
  }
  out
}

///| Check element-wise equality of two `Array[String]` slices.
fn line_arrays_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Append clean lines to `chunks`, coalescing with a trailing `Clean` chunk if present.
fn push_clean(chunks : Array[MergeChunk], lines : Array[String]) -> Unit {
  if lines.length() == 0 {
    return
  }
  let n = chunks.length()
  if n > 0 {
    match chunks[n - 1] {
      MergeChunk::Clean(prev) => {
        let mut i = 0
        while i < lines.length() {
          prev.push(lines[i])
          i = i + 1
        }
        return
      }
      MergeChunk::Conflict(_, _, _) => ()
    }
  }
  chunks.push(MergeChunk::Clean(lines))
}

///| Reconstruct the side's lines corresponding to base range `[b_start, b_end)`
///| given the subset of hunks `hunks[h_from..h_to)` falling within that base range.
fn reconstruct_side_span(
  base_lines : Array[String],
  side_lines : Array[String],
  hunks : Array[Hunk],
  h_from : Int,
  h_to : Int,
  b_start : Int,
  b_end : Int,
) -> Array[String] {
  let out : Array[String] = Array::new()
  let mut bp = b_start
  let mut hi = h_from
  while hi < h_to {
    let h = hunks[hi]
    while bp < h.before_start {
      out.push(base_lines[bp])
      bp = bp + 1
    }
    let mut ap = h.after_start
    while ap < h.after_end {
      out.push(side_lines[ap])
      ap = ap + 1
    }
    bp = h.before_end
    hi = hi + 1
  }
  while bp < b_end {
    out.push(base_lines[bp])
    bp = bp + 1
  }
  out
}

///| Check whether two hunks overlap or are adjacent (touching at the same base line boundary),
///| matching `git merge-file` / diff3 conflict semantics.
fn hunks_conflict(a : Hunk, b : Hunk) -> Bool {
  a.before_start <= b.before_end && b.before_start <= a.before_end
}

///| Perform a three-way merge of `ours` and `theirs` against `base`.
pub fn merge3(base : String, ours : String, theirs : String) -> MergeResult {
  let base_lines = split_lines(base)
  let ours_lines = split_lines(ours)
  let theirs_lines = split_lines(theirs)

  let diff_ours = diff_lines(base, ours, Algorithm::Histogram)
  let diff_theirs = diff_lines(base, theirs, Algorithm::Histogram)
  let oh = diff_ours.hunks
  let th = diff_theirs.hunks
  let on = oh.length()
  let tn = th.length()

  let chunks : Array[MergeChunk] = Array::new()
  let mut has_conflicts = false
  let mut b_pos = 0
  let mut oi = 0
  let mut ti = 0

  while oi < on || ti < tn {
    if oi < on && ti < tn {
      let ho = oh[oi]
      let ht = th[ti]
      if !hunks_conflict(ho, ht) {
        if ho.before_end <= ht.before_start && (ho.before_start < ht.before_start || (ho.before_start == ht.before_start && ho.before_end < ht.before_end)) {
          // Only `ours` hunk comes first
          push_clean(chunks, slice_lines(base_lines, b_pos, ho.before_start))
          push_clean(chunks, slice_lines(ours_lines, ho.after_start, ho.after_end))
          b_pos = ho.before_end
          oi = oi + 1
          continue
        }
        if ht.before_end <= ho.before_start && (ht.before_start < ho.before_start || (ht.before_start == ho.before_start && ht.before_end < ho.before_end)) {
          // Only `theirs` hunk comes first
          push_clean(chunks, slice_lines(base_lines, b_pos, ht.before_start))
          push_clean(
            chunks,
            slice_lines(theirs_lines, ht.after_start, ht.after_end),
          )
          b_pos = ht.before_end
          ti = ti + 1
          continue
        }
      }

      // Overlapping / conflicting region: expand until no further hunks overlap `[reg_start, reg_end)`
      let oi_start = oi
      let ti_start = ti
      let mut reg_start = if ho.before_start < ht.before_start {
        ho.before_start
      } else {
        ht.before_start
      }
      let mut reg_end = if ho.before_end > ht.before_end {
        ho.before_end
      } else {
        ht.before_end
      }
      oi = oi + 1
      ti = ti + 1

      let mut grew = true
      while grew {
        grew = false
        while oi < on {
          let nh = oh[oi]
          if nh.before_start <= reg_end {
            if nh.before_end > reg_end {
              reg_end = nh.before_end
            }
            if nh.before_start < reg_start {
              reg_start = nh.before_start
            }
            oi = oi + 1
            grew = true
          } else {
            break
          }
        }
        while ti < tn {
          let nh = th[ti]
          if nh.before_start <= reg_end {
            if nh.before_end > reg_end {
              reg_end = nh.before_end
            }
            if nh.before_start < reg_start {
              reg_start = nh.before_start
            }
            ti = ti + 1
            grew = true
          } else {
            break
          }
        }
      }

      push_clean(chunks, slice_lines(base_lines, b_pos, reg_start))
      let base_span = slice_lines(base_lines, reg_start, reg_end)
      let ours_span = reconstruct_side_span(
        base_lines, ours_lines, oh, oi_start, oi, reg_start, reg_end,
      )
      let theirs_span = reconstruct_side_span(
        base_lines, theirs_lines, th, ti_start, ti, reg_start, reg_end,
      )

      if line_arrays_eq(ours_span, theirs_span) {
        push_clean(chunks, ours_span)
      } else {
        has_conflicts = true
        chunks.push(MergeChunk::Conflict(base_span, ours_span, theirs_span))
      }
      b_pos = reg_end
    } else if oi < on {
      let ho = oh[oi]
      push_clean(chunks, slice_lines(base_lines, b_pos, ho.before_start))
      push_clean(chunks, slice_lines(ours_lines, ho.after_start, ho.after_end))
      b_pos = ho.before_end
      oi = oi + 1
    } else {
      let ht = th[ti]
      push_clean(chunks, slice_lines(base_lines, b_pos, ht.before_start))
      push_clean(chunks, slice_lines(theirs_lines, ht.after_start, ht.after_end))
      b_pos = ht.before_end
      ti = ti + 1
    }
  }

  push_clean(chunks, slice_lines(base_lines, b_pos, base_lines.length()))
  MergeResult::{ chunks: chunks, has_conflicts: has_conflicts }
}

///| Write an array of lines into `sb`, ensuring a trailing newline before conflict markers.
fn write_conflict_side(sb : StringBuilder, lines : Array[String]) -> Unit {
  let n = lines.length()
  let mut i = 0
  while i < n {
    sb.write_string(lines[i])
    i = i + 1
  }
  if n > 0 {
    let last = lines[n - 1]
    let ln = last.length()
    if ln == 0 || last.code_unit_at(ln - 1) != 10 {
      sb.write_string("\n")
    }
  }
}

///| Render a `MergeResult` to string with custom conflict labels.
pub fn render_merge3(
  res : MergeResult,
  ours_label : String,
  theirs_label : String,
) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < res.chunks.length() {
    match res.chunks[i] {
      MergeChunk::Clean(lines) => {
        let mut j = 0
        while j < lines.length() {
          sb.write_string(lines[j])
          j = j + 1
        }
      }
      MergeChunk::Conflict(_, ours, theirs) => {
        sb.write_string("<<<<<<< ")
        sb.write_string(ours_label)
        sb.write_string("\n")
        write_conflict_side(sb, ours)
        sb.write_string("=======\n")
        write_conflict_side(sb, theirs)
        sb.write_string(">>>>>>> ")
        sb.write_string(theirs_label)
        sb.write_string("\n")
      }
    }
    i = i + 1
  }
  sb.to_string()
}
