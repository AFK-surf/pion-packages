///| Fast line splitting and single-pass zero-copy-hotpath token interning.

///| Split a string into lines preserving line terminators (`\n`).
pub fn split_lines(text : String) -> Array[String] {
  let out : Array[String] = Array::new()
  let n = text.length()
  if n == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < n {
    if text.code_unit_at(i) == 10 {
      out.push(text.slice(start, i + 1))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(text.slice(start, n))
  }
  out
}

///| Span-based line interner: interns lines of `before` and `after` (or only
///| the differing middle window after common prefix/suffix trimming) into dense
///| integer token IDs `0..num_tokens` without allocating per-line Strings.
pub struct LineInterner {
  pub before_src : String
  pub after_src : String
  pub before_tokens : Array[Int]
  pub after_tokens : Array[Int]
  /// Line byte offsets in `before_src` for the interned window (len = lines + 1).
  /// Line `i` spans `[before_offsets[i], before_offsets[i + 1])`.
  pub before_offsets : Array[Int]
  /// Line byte offsets in `after_src` for the interned window (len = lines + 1).
  pub after_offsets : Array[Int]
  /// Packed canonical representative for each unique token ID:
  /// bit 62 = side (0 => `before_src`, 1 => `after_src`),
  /// bits 31..61 = start, bits 0..30 = end.
  pub tok_span : Array[Int64]
  pub num_tokens : Int
  /// Number of common prefix lines stripped before the interned window.
  pub pre_lines : Int
  /// Number of common suffix lines stripped after the interned window (only counted when requested).
  pub post_lines : Int
  /// Whether any non-empty common suffix was stripped after the interned window.
  pub has_stripped_suffix : Bool
}

///| Compare two string spans without allocating substrings (8-byte XOR-OR unrolled).
fn span_eq(
  s1 : String,
  start1 : Int,
  end1 : Int,
  s2 : String,
  start2 : Int,
  end2 : Int,
) -> Bool {
  let len1 = end1 - start1
  if len1 != end2 - start2 {
    return false
  }
  let mut p1 = start1
  let mut p2 = start2
  let lim8 = end1 - 7
  while p1 < lim8 {
    let d1 = (s1.code_unit_at(p1) ^ s2.code_unit_at(p2)) |
    (s1.code_unit_at(p1 + 1) ^ s2.code_unit_at(p2 + 1)) |
    (s1.code_unit_at(p1 + 2) ^ s2.code_unit_at(p2 + 2)) |
    (s1.code_unit_at(p1 + 3) ^ s2.code_unit_at(p2 + 3))
    let d2 = (s1.code_unit_at(p1 + 4) ^ s2.code_unit_at(p2 + 4)) |
    (s1.code_unit_at(p1 + 5) ^ s2.code_unit_at(p2 + 5)) |
    (s1.code_unit_at(p1 + 6) ^ s2.code_unit_at(p2 + 6)) |
    (s1.code_unit_at(p1 + 7) ^ s2.code_unit_at(p2 + 7))
    if (d1 | d2) != 0 {
      return false
    }
    p1 = p1 + 8
    p2 = p2 + 8
  }
  let lim4 = end1 - 3
  while p1 < lim4 {
    let d = (s1.code_unit_at(p1) ^ s2.code_unit_at(p2)) |
    (s1.code_unit_at(p1 + 1) ^ s2.code_unit_at(p2 + 1)) |
    (s1.code_unit_at(p1 + 2) ^ s2.code_unit_at(p2 + 2)) |
    (s1.code_unit_at(p1 + 3) ^ s2.code_unit_at(p2 + 3))
    if d != 0 {
      return false
    }
    p1 = p1 + 4
    p2 = p2 + 4
  }
  while p1 < end1 {
    if s1.code_unit_at(p1) != s2.code_unit_at(p2) {
      return false
    }
    p1 = p1 + 1
    p2 = p2 + 1
  }
  true
}

///| Next power of two >= `n` (minimum 16).
fn next_pow2(n : Int) -> Int {
  let mut p = 16
  while p < n {
    p = p << 1
  }
  p
}

///| Count `\n`-terminated lines in `s[start..end)` (including trailing line without `\n`).
fn count_lines_range(s : String, start : Int, end : Int) -> Int {
  if start >= end {
    return 0
  }
  let mut lines = 0
  let mut i = start
  let lim = end - 3
  while i < lim {
    if s.code_unit_at(i) == 10 {
      lines = lines + 1
    }
    if s.code_unit_at(i + 1) == 10 {
      lines = lines + 1
    }
    if s.code_unit_at(i + 2) == 10 {
      lines = lines + 1
    }
    if s.code_unit_at(i + 3) == 10 {
      lines = lines + 1
    }
    i = i + 4
  }
  while i < end {
    if s.code_unit_at(i) == 10 {
      lines = lines + 1
    }
    i = i + 1
  }
  if s.code_unit_at(end - 1) != 10 {
    lines = lines + 1
  }
  lines
}

///| Rehash packed `(hash32 << 32) | (tid + 1)` open-addressed table to double capacity.
fn rehash_table(old_table : Array[Int64]) -> Array[Int64] {
  let old_cap = old_table.length()
  let new_cap = old_cap * 2
  let new_mask = new_cap - 1
  let new_table = Array::make(new_cap, 0L)
  let mut r = 0
  while r < old_cap {
    let entry = old_table[r]
    if entry != 0L {
      let mut ns = ((entry >> 32) & 0xFFFFFFFFL).to_int() & new_mask
      while new_table[ns] != 0L {
        ns = (ns + 1) & new_mask
      }
      new_table[ns] = entry
    }
    r = r + 1
  }
  new_table
}

///| SplitMix64 mixer for deriving per-input 64-bit hash keys (HashDoS defense).
fn splitmix64(x_in : Int64) -> Int64 {
  let mut z = x_in + -7046029254386353131L
  z = (z ^ (z >> 30)) * -4658895280553007687L
  z = (z ^ (z >> 27)) * -7723592293110705685L
  z ^ (z >> 31)
}

///| Mix length and 8 spread sample bytes from `s` into `acc_in`.
fn sample_string_entropy(s : String, acc_in : Int64) -> Int64 {
  let n = s.length()
  let mut acc = splitmix64(acc_in ^ n.to_int64())
  if n == 0 {
    return acc
  }
  let mut i = 0
  while i < 8 {
    let pos = (i * (n - 1)) / 7
    let b = s.code_unit_at(pos).to_int64() & 0xFFL
    acc = splitmix64(acc ^ (b << ((i & 7) * 8)) ^ pos.to_int64())
    i = i + 1
  }
  acc
}

///| Derive per-input `(hash_seed, hash_mult)` where `hash_mult` is odd.
fn derive_hash_keys(before : String, after : String) -> (Int64, Int64) {
  let mut s = sample_string_entropy(before, 0x517CC1B727220A95L)
  s = sample_string_entropy(after, s)
  let seed = splitmix64(s)
  let mult = splitmix64(seed ^ 0x2545F4914F6CDD1DL) | 1L
  (seed, mult)
}

///| Intern lines of `before[b_start..b_end)` into `table`, `tok_span`, and `tok_b_line`.
///| Returns the (possibly rehashed) `table`.
fn intern_before_window(
  before : String,
  b_start : Int,
  b_end : Int,
  hash_seed : Int64,
  hash_mult : Int64,
  table_in : Array[Int64],
  tok_span : Array[Int64],
  tok_b_line : Array[Int],
  before_offsets : Array[Int],
  before_tokens : Array[Int],
) -> Array[Int64] {
  let mut table = table_in
  let mut mask = table.length() - 1
  let mut num_toks = tok_span.length()
  let mut grow_at = (table.length() * 7) / 10

  before_offsets.push(b_start)
  let mut bi = b_start
  let mut b_line = 0
  let lim4 = b_end - 3
  while bi < b_end {
    let bs = bi
    let mut bh : Int64 = hash_seed
    while bi < lim4 {
      let c0 = before.code_unit_at(bi)
      let c1 = before.code_unit_at(bi + 1)
      let c2 = before.code_unit_at(bi + 2)
      let c3 = before.code_unit_at(bi + 3)
      let word = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24)
      let x = word ^ 0x0A0A0A0A
      if ((x - 0x01010101) & (x ^ -1) & 0x80808080) != 0 {
        break
      }
      bh = (bh ^ (word.to_int64() & 0xFFFFFFFFL)) * hash_mult
      bh = bh ^ (bh >> 29)
      bi = bi + 4
    }
    let mut tail : Int64 = 0L
    let mut shift = 0
    while bi < b_end {
      let c = before.code_unit_at(bi)
      tail = tail | ((c.to_int64() & 0xFFL) << shift)
      shift = shift + 8
      bi = bi + 1
      if c == 10 {
        break
      }
    }
    let en = bi
    before_offsets.push(en)

    let line_len = en - bs
    bh = (bh ^ tail ^ (line_len.to_int64() << 32)) * hash_mult
    bh = bh ^ (bh >> 32)
    let h = bh.to_int()
    let h64 = bh & 0xFFFFFFFFL
    let mut slot = h & mask
    let mut found = -1
    while true {
      let entry = table[slot]
      if entry == 0L {
        break
      }
      if ((entry >> 32) & 0xFFFFFFFFL) == h64 {
        let tid = (entry & 0xFFFFFFFFL).to_int() - 1
        let sp = tok_span[tid]
        let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
        let te = (sp & 0x7FFFFFFFL).to_int()
        if te - ts == line_len && (line_len == 0 || (before.code_unit_at(ts) == before.code_unit_at(bs) && (line_len == 1 || span_eq(before, ts + 1, te, before, bs + 1, en)))) {
          found = tid
          break
        }
      }
      slot = (slot + 1) & mask
    }
    if found >= 0 {
      before_tokens.push(found)
      // Mark non-unique tokens as -1 so lockstep only jumps to unique anchors
      if tok_b_line[found] >= 0 {
        tok_b_line[found] = -1
      }
    } else {
      let tid = num_toks
      num_toks = num_toks + 1
      tok_span.push((bs.to_int64() << 31) | en.to_int64())
      tok_b_line.push(b_line)
      table[slot] = (h64 << 32) | (tid + 1).to_int64()
      before_tokens.push(tid)
      if num_toks > grow_at {
        table = rehash_table(table)
        mask = table.length() - 1
        grow_at = (table.length() * 7) / 10
      }
    }
    b_line = b_line + 1
  }
  table
}

///| Intern lines of `after[a_start..a_end)` into `table` and `tok_span`,
///| using lockstep predictive matching against `before` to skip hashing & table
///| probing on contiguous unchanged blocks.
fn intern_after_window(
  before : String,
  after : String,
  a_start : Int,
  a_end : Int,
  hash_seed : Int64,
  hash_mult : Int64,
  table_in : Array[Int64],
  tok_span : Array[Int64],
  tok_b_line : Array[Int],
  before_offsets : Array[Int],
  before_tokens : Array[Int],
  after_offsets : Array[Int],
  after_tokens : Array[Int],
) -> Unit {
  let mut table = table_in
  let mut mask = table.length() - 1
  let mut num_toks = tok_span.length()
  let mut grow_at = (table.length() * 7) / 10
  let b_lines = before_tokens.length()
  let num_b_toks = tok_b_line.length()

  after_offsets.push(a_start)
  let mut ai = a_start
  let mut b_cursor = 0
  let lim4 = a_end - 3

  while ai < a_end {
    // Lockstep fast path: predict that `after[ai..]` matches `before` line `b_cursor`.
    if b_cursor < b_lines {
      let bs = before_offsets[b_cursor]
      let be = before_offsets[b_cursor + 1]
      let blen = be - bs
      let next_ai = ai + blen
      if next_ai <= a_end && blen > 0 && before.code_unit_at(bs) == after.code_unit_at(ai) && (before.code_unit_at(be - 1) == 10 || next_ai == a_end) && (blen <= 1 || span_eq(before, bs + 1, be, after, ai + 1, next_ai)) {
        after_tokens.push(before_tokens[b_cursor])
        ai = next_ai
        after_offsets.push(ai)
        b_cursor = b_cursor + 1
        continue
      }
    }

    let as_ = ai
    let mut ah : Int64 = hash_seed
    while ai < lim4 {
      let c0 = after.code_unit_at(ai)
      let c1 = after.code_unit_at(ai + 1)
      let c2 = after.code_unit_at(ai + 2)
      let c3 = after.code_unit_at(ai + 3)
      let word = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24)
      let x = word ^ 0x0A0A0A0A
      if ((x - 0x01010101) & (x ^ -1) & 0x80808080) != 0 {
        break
      }
      ah = (ah ^ (word.to_int64() & 0xFFFFFFFFL)) * hash_mult
      ah = ah ^ (ah >> 29)
      ai = ai + 4
    }
    let mut tail : Int64 = 0L
    let mut shift = 0
    while ai < a_end {
      let c = after.code_unit_at(ai)
      tail = tail | ((c.to_int64() & 0xFFL) << shift)
      shift = shift + 8
      ai = ai + 1
      if c == 10 {
        break
      }
    }
    let en = ai
    after_offsets.push(en)

    let line_len = en - as_
    ah = (ah ^ tail ^ (line_len.to_int64() << 32)) * hash_mult
    ah = ah ^ (ah >> 32)
    let h = ah.to_int()
    let h64 = ah & 0xFFFFFFFFL
    let mut slot = h & mask
    let mut found = -1
    while true {
      let entry = table[slot]
      if entry == 0L {
        break
      }
      if ((entry >> 32) & 0xFFFFFFFFL) == h64 {
        let tid = (entry & 0xFFFFFFFFL).to_int() - 1
        let sp = tok_span[tid]
        let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
        let te = (sp & 0x7FFFFFFFL).to_int()
        if te - ts == line_len {
          let ref_src = if ((sp >> 62) & 1L) == 0L { before } else { after }
          if span_eq(ref_src, ts, te, after, as_, en) {
            found = tid
            break
          }
        }
      }
      slot = (slot + 1) & mask
    }
    if found >= 0 {
      after_tokens.push(found)
      if found < num_b_toks {
        let anchor = tok_b_line[found]
        if anchor >= 0 {
          b_cursor = anchor + 1
        } else if b_cursor < b_lines {
          b_cursor = b_cursor + 1
        }
      }
    } else {
      let tid = num_toks
      num_toks = num_toks + 1
      tok_span.push((1L << 62) | (as_.to_int64() << 31) | en.to_int64())
      table[slot] = (h64 << 32) | (tid + 1).to_int64()
      after_tokens.push(tid)
      if b_cursor < b_lines {
        b_cursor = b_cursor + 1
      }
      if num_toks > grow_at {
        table = rehash_table(table)
        mask = table.length() - 1
        grow_at = (table.length() * 7) / 10
      }
    }
  }
}

///| Fast byte-level common prefix/suffix trimming + single-pass line interning.
///| When `margin >= 0`, strips identical prefix/suffix lines leaving `margin`
///| guard lines on each side for slider postprocessing & unified diff context.
///| When `margin < 0`, interns the entire `before` and `after` strings.
pub fn intern_lines_windowed(
  before : String,
  after : String,
  margin : Int,
  count_post : Bool,
) -> LineInterner {
  let bn = before.length()
  let an = after.length()

  let mut b_start = 0
  let mut b_end = bn
  let mut a_start = 0
  let mut a_end = an
  let mut pre_lines = 0
  let mut post_lines = 0
  let mut has_stripped_suffix = false

  if margin >= 0 {
    // 1. Byte-level common prefix scan (4-byte XOR-OR unrolled)
    let min_len = if bn < an { bn } else { an }
    let mut pi = 0
    let mut last_nl_end = 0
    let mut nl_count = 0
    let lim4 = min_len - 3
    while pi < lim4 {
      let b0 = before.code_unit_at(pi)
      let b1 = before.code_unit_at(pi + 1)
      let b2 = before.code_unit_at(pi + 2)
      let b3 = before.code_unit_at(pi + 3)
      let d = (b0 ^ after.code_unit_at(pi)) |
      (b1 ^ after.code_unit_at(pi + 1)) |
      (b2 ^ after.code_unit_at(pi + 2)) |
      (b3 ^ after.code_unit_at(pi + 3))
      if d != 0 {
        break
      }
      if b0 == 10 {
        nl_count = nl_count + 1
        last_nl_end = pi + 1
      }
      if b1 == 10 {
        nl_count = nl_count + 1
        last_nl_end = pi + 2
      }
      if b2 == 10 {
        nl_count = nl_count + 1
        last_nl_end = pi + 3
      }
      if b3 == 10 {
        nl_count = nl_count + 1
        last_nl_end = pi + 4
      }
      pi = pi + 4
    }
    while pi < min_len {
      let c = before.code_unit_at(pi)
      if c != after.code_unit_at(pi) {
        break
      }
      pi = pi + 1
      if c == 10 {
        nl_count = nl_count + 1
        last_nl_end = pi
      }
    }

    // Exact identical file fast path!
    if pi == bn && pi == an {
      let total = if bn == 0 {
        0
      } else if before.code_unit_at(bn - 1) == 10 {
        nl_count
      } else {
        nl_count + 1
      }
      let empty_off : Array[Int] = Array::make(1, 0)
      return LineInterner::{
        before_src: before,
        after_src: after,
        before_tokens: Array::new(),
        after_tokens: Array::new(),
        before_offsets: empty_off,
        after_offsets: Array::make(1, 0),
        tok_span: Array::new(),
        num_tokens: 0,
        pre_lines: total,
        post_lines: 0,
        has_stripped_suffix: false,
      }
    }

    b_start = last_nl_end
    a_start = last_nl_end
    pre_lines = nl_count

    // 2. Byte-level common suffix scan (8-byte XOR-OR unrolled)
    let rem_b = bn - b_start
    let rem_a = an - a_start
    let min_rem = if rem_b < rem_a { rem_b } else { rem_a }
    let mut k = 0
    while k + 8 <= min_rem {
      let bp = bn - 8 - k
      let ap = an - 8 - k
      let d1 = (before.code_unit_at(bp + 7) ^ after.code_unit_at(ap + 7)) |
      (before.code_unit_at(bp + 6) ^ after.code_unit_at(ap + 6)) |
      (before.code_unit_at(bp + 5) ^ after.code_unit_at(ap + 5)) |
      (before.code_unit_at(bp + 4) ^ after.code_unit_at(ap + 4))
      let d2 = (before.code_unit_at(bp + 3) ^ after.code_unit_at(ap + 3)) |
      (before.code_unit_at(bp + 2) ^ after.code_unit_at(ap + 2)) |
      (before.code_unit_at(bp + 1) ^ after.code_unit_at(ap + 1)) |
      (before.code_unit_at(bp) ^ after.code_unit_at(ap))
      if (d1 | d2) != 0 {
        break
      }
      k = k + 8
    }
    while k + 4 <= min_rem {
      let bp = bn - 4 - k
      let ap = an - 4 - k
      let d = (before.code_unit_at(bp + 3) ^ after.code_unit_at(ap + 3)) |
      (before.code_unit_at(bp + 2) ^ after.code_unit_at(ap + 2)) |
      (before.code_unit_at(bp + 1) ^ after.code_unit_at(ap + 1)) |
      (before.code_unit_at(bp) ^ after.code_unit_at(ap))
      if d != 0 {
        break
      }
      k = k + 4
    }
    while k < min_rem && before.code_unit_at(bn - 1 - k) == after.code_unit_at(an - 1 - k) {
      k = k + 1
    }

    let mut b_suf = bn - k
    let mut a_suf = an - k
    if b_suf < bn {
      let b_aligned = b_suf == b_start || before.code_unit_at(b_suf - 1) == 10
      let a_aligned = a_suf == a_start || after.code_unit_at(a_suf - 1) == 10
      if !b_aligned || !a_aligned {
        // Advance past the first '\n' inside the matching suffix so both sides start on a line boundary
        while b_suf < bn && before.code_unit_at(b_suf) != 10 {
          b_suf = b_suf + 1
        }
        if b_suf < bn {
          b_suf = b_suf + 1
        }
        a_suf = an - (bn - b_suf)
      }
    }

    // 3. Apply safety margin (lines) into prefix and suffix, extending past any
    //    repeating identical-line run at the boundary (up to 128 lines + margin)
    //    so slider runs like 40+ identical `}` or blank lines stay inside one pass.
    if margin > 0 && pre_lines > 0 {
      let mut back = 0
      let mut p = b_start
      while back < margin && p > 0 {
        p = p - 1
        while p > 0 && before.code_unit_at(p - 1) != 10 {
          p = p - 1
        }
        back = back + 1
      }
      if p > 0 && p < bn {
        let ref_s = p
        let mut ref_e = p
        while ref_e < bn && before.code_unit_at(ref_e) != 10 {
          ref_e = ref_e + 1
        }
        if ref_e < bn {
          ref_e = ref_e + 1
        }
        let mut ext = 0
        while ext < 128 && p > 0 {
          let prev_end = p
          let mut prev_start = p - 1
          while prev_start > 0 && before.code_unit_at(prev_start - 1) != 10 {
            prev_start = prev_start - 1
          }
          if !span_eq(before, prev_start, prev_end, before, ref_s, ref_e) {
            break
          }
          p = prev_start
          back = back + 1
          ext = ext + 1
        }
        if ext > 0 {
          let mut extra = 0
          while extra < margin && p > 0 {
            p = p - 1
            while p > 0 && before.code_unit_at(p - 1) != 10 {
              p = p - 1
            }
            back = back + 1
            extra = extra + 1
          }
        }
      }
      b_start = p
      a_start = p
      pre_lines = pre_lines - back
    }

    if margin > 0 && b_suf < bn {
      let mut fwd = 0
      let mut p = b_suf
      while fwd < margin && p < bn {
        while p < bn && before.code_unit_at(p) != 10 {
          p = p + 1
        }
        if p < bn {
          p = p + 1
        }
        fwd = fwd + 1
      }
      if p > b_start && p < bn {
        let ref_e = p
        let mut ref_s = p - 1
        while ref_s > b_start && before.code_unit_at(ref_s - 1) != 10 {
          ref_s = ref_s - 1
        }
        let mut ext = 0
        while ext < 128 && p < bn {
          let next_s = p
          let mut next_e = p
          while next_e < bn && before.code_unit_at(next_e) != 10 {
            next_e = next_e + 1
          }
          if next_e < bn {
            next_e = next_e + 1
          }
          if !span_eq(before, ref_s, ref_e, before, next_s, next_e) {
            break
          }
          p = next_e
          ext = ext + 1
        }
        if ext > 0 {
          let mut extra = 0
          while extra < margin && p < bn {
            while p < bn && before.code_unit_at(p) != 10 {
              p = p + 1
            }
            if p < bn {
              p = p + 1
            }
            extra = extra + 1
          }
        }
      }
      b_suf = p
      a_suf = an - (bn - b_suf)
    }

    b_end = b_suf
    a_end = a_suf
    if b_end < bn {
      has_stripped_suffix = true
      if count_post {
        post_lines = count_lines_range(before, b_end, bn)
      }
    }
  }

  let (hash_seed, hash_mult) = derive_hash_keys(before, after)
  let mid_b_bytes = b_end - b_start
  let mid_a_bytes = a_end - a_start
  let est_b_lines = mid_b_bytes / 28 + 16
  let est_a_lines = mid_a_bytes / 28 + 16
  let cap = next_pow2(mid_b_bytes / 128 + 64)
  let mut table = Array::make(cap, 0L)
  let tok_span : Array[Int64] = Array::with_capacity(cap / 2)
  let tok_b_line : Array[Int] = Array::with_capacity(cap / 2)
  let before_offsets : Array[Int] = Array::with_capacity(est_b_lines + 1)
  let before_tokens : Array[Int] = Array::with_capacity(est_b_lines)
  let after_offsets : Array[Int] = Array::with_capacity(est_a_lines + 1)
  let after_tokens : Array[Int] = Array::with_capacity(est_a_lines)

  table = intern_before_window(
    before, b_start, b_end, hash_seed, hash_mult, table, tok_span, tok_b_line,
    before_offsets, before_tokens,
  )
  intern_after_window(
    before, after, a_start, a_end, hash_seed, hash_mult, table, tok_span,
    tok_b_line, before_offsets, before_tokens, after_offsets, after_tokens,
  )

  LineInterner::{
    before_src: before,
    after_src: after,
    before_tokens: before_tokens,
    after_tokens: after_tokens,
    before_offsets: before_offsets,
    after_offsets: after_offsets,
    tok_span: tok_span,
    num_tokens: tok_span.length(),
    pre_lines: pre_lines,
    post_lines: post_lines,
    has_stripped_suffix: has_stripped_suffix,
  }
}

///| Intern all lines of `before` and `after` in a single pass per string
///| (splitting + hashing simultaneously) into compact integer token IDs.
pub fn intern_lines(before : String, after : String) -> LineInterner {
  intern_lines_windowed(before, after, -1, false)
}

///| Reusable pre-interned `before` text for fast repeated diffs against multiple
///| `after` strings without re-interning or re-hashing `before`.
pub struct BeforeInterner {
  pub before_src : String
  pub before_tokens : Array[Int]
  pub before_offsets : Array[Int]
  pub tok_span : Array[Int64]
  pub num_before_tokens : Int
  table : Array[Int64]
  tok_b_line : Array[Int]
  tok_indents : Array[Int]
  hash_seed : Int64
  hash_mult : Int64
}

///| Pre-intern all lines of `before` into a reusable `BeforeInterner`.
pub fn intern_before(before : String) -> BeforeInterner {
  let bn = before.length()
  let (hash_seed, hash_mult) = derive_hash_keys(before, "")
  let est_b_lines = bn / 28 + 16
  let cap = next_pow2(bn / 128 + 64)
  let mut table = Array::make(cap, 0L)
  let tok_span : Array[Int64] = Array::with_capacity(cap / 2)
  let tok_b_line : Array[Int] = Array::with_capacity(cap / 2)
  let before_offsets : Array[Int] = Array::with_capacity(est_b_lines + 1)
  let before_tokens : Array[Int] = Array::with_capacity(est_b_lines)

  table = intern_before_window(
    before, 0, bn, hash_seed, hash_mult, table, tok_span, tok_b_line,
    before_offsets, before_tokens,
  )
  let num_before_tokens = tok_span.length()
  let tok_indents = Array::make(num_before_tokens, -1)
  BeforeInterner::{
    before_src: before,
    before_tokens: before_tokens,
    before_offsets: before_offsets,
    tok_span: tok_span,
    num_before_tokens: num_before_tokens,
    table: table,
    tok_b_line: tok_b_line,
    tok_indents: tok_indents,
    hash_seed: hash_seed,
    hash_mult: hash_mult,
  }
}

///| Constructor alias for `intern_before`.
pub fn BeforeInterner::new(before : String) -> BeforeInterner {
  intern_before(before)
}

///| Result of interning an `after` string against a reusable `BeforeInterner`
///| without mutating `BeforeInterner`'s hash table or token table.
struct AfterInterned {
  after_tokens : Array[Int]
  after_offsets : Array[Int]
  after_tok_span : Array[Int64]
  total_tokens : Int
}

///| Intern `after` against a pre-interned `BeforeInterner`, using lockstep
///| matching and a small secondary delta table for `after`-only tokens.
fn intern_after_against_before(
  interned : BeforeInterner,
  after : String,
) -> AfterInterned {
  let before = interned.before_src
  let before_offsets = interned.before_offsets
  let before_tokens = interned.before_tokens
  let b_tok_span = interned.tok_span
  let b_table = interned.table
  let b_mask = b_table.length() - 1
  let tok_b_line = interned.tok_b_line
  let num_b_toks = interned.num_before_tokens
  let hash_seed = interned.hash_seed
  let hash_mult = interned.hash_mult
  let b_lines = before_tokens.length()

  let an = after.length()
  let est_a_lines = an / 28 + 16
  let after_offsets : Array[Int] = Array::with_capacity(est_a_lines + 1)
  let after_tokens : Array[Int] = Array::with_capacity(est_a_lines)
  let after_tok_span : Array[Int64] = Array::new()
  let mut a_table = Array::make(64, 0L)
  let mut a_mask = 63
  let mut a_grow_at = 44
  let mut num_a_toks = 0

  after_offsets.push(0)
  let mut ai = 0
  let mut b_cursor = 0
  let lim4 = an - 3

  while ai < an {
    // Lockstep fast path
    if b_cursor < b_lines {
      let bs = before_offsets[b_cursor]
      let be = before_offsets[b_cursor + 1]
      let blen = be - bs
      let next_ai = ai + blen
      if next_ai <= an && blen > 0 && before.code_unit_at(bs) == after.code_unit_at(ai) && (before.code_unit_at(be - 1) == 10 || next_ai == an) && (blen <= 1 || span_eq(before, bs + 1, be, after, ai + 1, next_ai)) {
        after_tokens.push(before_tokens[b_cursor])
        ai = next_ai
        after_offsets.push(ai)
        b_cursor = b_cursor + 1
        continue
      }
    }

    let as_ = ai
    let mut ah : Int64 = hash_seed
    while ai < lim4 {
      let c0 = after.code_unit_at(ai)
      let c1 = after.code_unit_at(ai + 1)
      let c2 = after.code_unit_at(ai + 2)
      let c3 = after.code_unit_at(ai + 3)
      let word = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24)
      let x = word ^ 0x0A0A0A0A
      if ((x - 0x01010101) & (x ^ -1) & 0x80808080) != 0 {
        break
      }
      ah = (ah ^ (word.to_int64() & 0xFFFFFFFFL)) * hash_mult
      ah = ah ^ (ah >> 29)
      ai = ai + 4
    }
    let mut tail : Int64 = 0L
    let mut shift = 0
    while ai < an {
      let c = after.code_unit_at(ai)
      tail = tail | ((c.to_int64() & 0xFFL) << shift)
      shift = shift + 8
      ai = ai + 1
      if c == 10 {
        break
      }
    }
    let en = ai
    after_offsets.push(en)

    let line_len = en - as_
    ah = (ah ^ tail ^ (line_len.to_int64() << 32)) * hash_mult
    ah = ah ^ (ah >> 32)
    let h = ah.to_int()
    let h64 = ah & 0xFFFFFFFFL

    // 1. Read-only probe in `before`'s table
    let mut slot = h & b_mask
    let mut found = -1
    while true {
      let entry = b_table[slot]
      if entry == 0L {
        break
      }
      if ((entry >> 32) & 0xFFFFFFFFL) == h64 {
        let tid = (entry & 0xFFFFFFFFL).to_int() - 1
        let sp = b_tok_span[tid]
        let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
        let te = (sp & 0x7FFFFFFFL).to_int()
        if te - ts == line_len && span_eq(before, ts, te, after, as_, en) {
          found = tid
          break
        }
      }
      slot = (slot + 1) & b_mask
    }

    if found >= 0 {
      after_tokens.push(found)
      let anchor = tok_b_line[found]
      if anchor >= 0 {
        b_cursor = anchor + 1
      } else if b_cursor < b_lines {
        b_cursor = b_cursor + 1
      }
      continue
    }

    // 2. Probe/insert in small secondary `after` delta table
    let mut aslot = h & a_mask
    let mut afound = -1
    while true {
      let entry = a_table[aslot]
      if entry == 0L {
        break
      }
      if ((entry >> 32) & 0xFFFFFFFFL) == h64 {
        let local_id = (entry & 0xFFFFFFFFL).to_int() - 1
        let sp = after_tok_span[local_id]
        let ts = ((sp >> 31) & 0x7FFFFFFFL).to_int()
        let te = (sp & 0x7FFFFFFFL).to_int()
        if te - ts == line_len && span_eq(after, ts, te, after, as_, en) {
          afound = num_b_toks + local_id
          break
        }
      }
      aslot = (aslot + 1) & a_mask
    }
    if afound >= 0 {
      after_tokens.push(afound)
    } else {
      let local_id = num_a_toks
      num_a_toks = num_a_toks + 1
      after_tok_span.push((1L << 62) | (as_.to_int64() << 31) | en.to_int64())
      a_table[aslot] = (h64 << 32) | (local_id + 1).to_int64()
      after_tokens.push(num_b_toks + local_id)
      if num_a_toks > a_grow_at {
        a_table = rehash_table(a_table)
        a_mask = a_table.length() - 1
        a_grow_at = (a_table.length() * 7) / 10
      }
    }
    if b_cursor < b_lines {
      b_cursor = b_cursor + 1
    }
  }

  AfterInterned::{
    after_tokens: after_tokens,
    after_offsets: after_offsets,
    after_tok_span: after_tok_span,
    total_tokens: num_b_toks + num_a_toks,
  }
}

///| Intern two `Array[String]` slices into compact integer token IDs.
pub fn intern_slices(
  before : Array[String],
  after : Array[String],
) -> (Array[Int], Array[Int], Array[String]) {
  let map : Map[String, Int] = Map::new()
  let vocab : Array[String] = Array::new()
  let b_toks : Array[Int] = Array::with_capacity(before.length())
  let a_toks : Array[Int] = Array::with_capacity(after.length())

  let mut i = 0
  while i < before.length() {
    let s = before[i]
    match map.get(s) {
      Some(id) => b_toks.push(id)
      None => {
        let id = vocab.length()
        vocab.push(s)
        map.set(s, id)
        b_toks.push(id)
      }
    }
    i = i + 1
  }

  let mut j = 0
  while j < after.length() {
    let s = after[j]
    match map.get(s) {
      Some(id) => a_toks.push(id)
      None => {
        let id = vocab.length()
        vocab.push(s)
        map.set(s, id)
        a_toks.push(id)
      }
    }
    j = j + 1
  }

  (b_toks, a_toks, vocab)
}
