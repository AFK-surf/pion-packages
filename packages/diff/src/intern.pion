///| Fast line splitting and single-pass zero-copy-hotpath token interning.

///| Split a string into lines preserving line terminators (`\n`).
pub fn split_lines(text : String) -> Array[String] {
  let out : Array[String] = Array::new()
  let n = text.length()
  if n == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < n {
    if text.code_unit_at(i) == 10 {
      out.push(text.slice(start, i + 1))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(text.slice(start, n))
  }
  out
}

///| Span-based line interner: interns lines of `before` and `after` into dense
///| integer token IDs `0..num_tokens` without allocating per-line Strings.
pub struct LineInterner {
  pub before_src : String
  pub after_src : String
  pub before_tokens : Array[Int]
  pub after_tokens : Array[Int]
  /// For each line in `before`: start/end code-unit offsets in `before_src`.
  pub before_starts : Array[Int]
  pub before_ends : Array[Int]
  /// For each line in `after`: start/end code-unit offsets in `after_src`.
  pub after_starts : Array[Int]
  pub after_ends : Array[Int]
  /// Canonical representative for each unique token ID:
  /// `tok_side[id]` == 0 => `before_src`, 1 => `after_src`.
  pub tok_side : Array[Int]
  pub tok_start : Array[Int]
  pub tok_end : Array[Int]
  pub tok_hash : Array[Int]
  pub num_tokens : Int
}

///| Compare two string spans without allocating substrings.
fn span_eq(
  s1 : String,
  start1 : Int,
  end1 : Int,
  s2 : String,
  start2 : Int,
  end2 : Int,
) -> Bool {
  let len1 = end1 - start1
  if len1 != end2 - start2 {
    return false
  }
  let mut i = 0
  while i < len1 {
    if s1.code_unit_at(start1 + i) != s2.code_unit_at(start2 + i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Next power of two >= `n` (minimum 16).
fn next_pow2(n : Int) -> Int {
  let mut p = 16
  while p < n {
    p = p << 1
  }
  p
}

///| Intern all lines of `before` and `after` in a single pass per string
///| (splitting + hashing simultaneously) into compact integer token IDs.
pub fn intern_lines(before : String, after : String) -> LineInterner {
  let bn = before.length()
  let an = after.length()
  // Estimate line count (~32 bytes/line) to size hash table once without rehashing.
  let est_lines = (bn + an) / 32 + 16
  let cap = next_pow2(est_lines * 2)
  let mut mask = cap - 1
  // Table stores `token_id + 1`, 0 = empty slot.
  let mut table = Array::make(cap, 0)

  let before_starts : Array[Int] = Array::new()
  let before_ends : Array[Int] = Array::new()
  let after_starts : Array[Int] = Array::new()
  let after_ends : Array[Int] = Array::new()
  let tok_side : Array[Int] = Array::new()
  let tok_start : Array[Int] = Array::new()
  let tok_end : Array[Int] = Array::new()
  let tok_hash : Array[Int] = Array::new()
  let before_tokens : Array[Int] = Array::new()
  let after_tokens : Array[Int] = Array::new()

  // Single pass over `before`: split on '\n' while accumulating FNV-1a hash
  let mut bs = 0
  let mut bi = 0
  let mut bh : Int = -2128831035
  while bi < bn {
    let c = before.code_unit_at(bi)
    bh = (bh ^ c) * 16777619
    if c == 10 || bi + 1 == bn {
      let en = bi + 1
      before_starts.push(bs)
      before_ends.push(en)
      let h = bh ^ ((bh >> 16) & 65535)
      let mut slot = h & mask
      let mut found = -1
      while true {
        let entry = table[slot]
        if entry == 0 {
          break
        }
        let tid = entry - 1
        if tok_hash[tid] == h {
          if span_eq(before, tok_start[tid], tok_end[tid], before, bs, en) {
            found = tid
            break
          }
        }
        slot = (slot + 1) & mask
      }
      if found >= 0 {
        before_tokens.push(found)
      } else {
        let tid = tok_side.length()
        tok_side.push(0)
        tok_start.push(bs)
        tok_end.push(en)
        tok_hash.push(h)
        table[slot] = tid + 1
        before_tokens.push(tid)
        if tok_side.length() * 10 > table.length() * 7 {
          let new_cap = table.length() * 2
          let new_mask = new_cap - 1
          let new_table = Array::make(new_cap, 0)
          let mut r = 0
          while r < tok_side.length() {
            let mut ns = tok_hash[r] & new_mask
            while new_table[ns] != 0 {
              ns = (ns + 1) & new_mask
            }
            new_table[ns] = r + 1
            r = r + 1
          }
          table = new_table
          mask = new_mask
        }
      }
      bs = en
      bh = -2128831035
    }
    bi = bi + 1
  }

  // Single pass over `after`: split on '\n' while accumulating FNV-1a hash
  let mut as_ = 0
  let mut ai = 0
  let mut ah : Int = -2128831035
  while ai < an {
    let c = after.code_unit_at(ai)
    ah = (ah ^ c) * 16777619
    if c == 10 || ai + 1 == an {
      let en = ai + 1
      after_starts.push(as_)
      after_ends.push(en)
      let h = ah ^ ((ah >> 16) & 65535)
      let mut slot = h & mask
      let mut found = -1
      while true {
        let entry = table[slot]
        if entry == 0 {
          break
        }
        let tid = entry - 1
        if tok_hash[tid] == h {
          let ref_src = if tok_side[tid] == 0 { before } else { after }
          if span_eq(ref_src, tok_start[tid], tok_end[tid], after, as_, en) {
            found = tid
            break
          }
        }
        slot = (slot + 1) & mask
      }
      if found >= 0 {
        after_tokens.push(found)
      } else {
        let tid = tok_side.length()
        tok_side.push(1)
        tok_start.push(as_)
        tok_end.push(en)
        tok_hash.push(h)
        table[slot] = tid + 1
        after_tokens.push(tid)
        if tok_side.length() * 10 > table.length() * 7 {
          let new_cap = table.length() * 2
          let new_mask = new_cap - 1
          let new_table = Array::make(new_cap, 0)
          let mut r = 0
          while r < tok_side.length() {
            let mut ns = tok_hash[r] & new_mask
            while new_table[ns] != 0 {
              ns = (ns + 1) & new_mask
            }
            new_table[ns] = r + 1
            r = r + 1
          }
          table = new_table
          mask = new_mask
        }
      }
      as_ = en
      ah = -2128831035
    }
    ai = ai + 1
  }

  LineInterner::{
    before_src: before,
    after_src: after,
    before_tokens: before_tokens,
    after_tokens: after_tokens,
    before_starts: before_starts,
    before_ends: before_ends,
    after_starts: after_starts,
    after_ends: after_ends,
    tok_side: tok_side,
    tok_start: tok_start,
    tok_end: tok_end,
    tok_hash: tok_hash,
    num_tokens: tok_side.length(),
  }
}

///| Intern two `Array[String]` slices into compact integer token IDs.
pub fn intern_slices(
  before : Array[String],
  after : Array[String],
) -> (Array[Int], Array[Int], Array[String]) {
  let map : Map[String, Int] = Map::new()
  let vocab : Array[String] = Array::new()
  let b_toks : Array[Int] = Array::new()
  let a_toks : Array[Int] = Array::new()

  let mut i = 0
  while i < before.length() {
    let s = before[i]
    match map.get(s) {
      Some(id) => b_toks.push(id)
      None => {
        let id = vocab.length()
        vocab.push(s)
        map.set(s, id)
        b_toks.push(id)
      }
    }
    i = i + 1
  }

  let mut j = 0
  while j < after.length() {
    let s = after[j]
    match map.get(s) {
      Some(id) => a_toks.push(id)
      None => {
        let id = vocab.length()
        vocab.push(s)
        map.set(s, id)
        a_toks.push(id)
      }
    }
    j = j + 1
  }

  (b_toks, a_toks, vocab)
}
