///| Public entry points for `diff` (Red-phase stubs).

///| Split a string into lines preserving line terminators (`\n`).
pub fn split_lines(text : String) -> Array[String] {
  let _ = text
  Array::new()
}

///| Diff two integer token sequences directly (no slider postprocessing).
pub fn diff_tokens(
  before : Array[Int],
  after : Array[Int],
  num_tokens : Int,
  algo : Algorithm,
) -> DiffResult {
  let _ = num_tokens
  let _ = algo
  DiffResult::{
    hunks: Array::new(),
    before_len: before.length(),
    after_len: after.length(),
  }
}

///| Diff two string slices using token interning and the selected algorithm.
pub fn diff_slices(
  before : Array[String],
  after : Array[String],
  algo : Algorithm,
) -> DiffResult {
  let _ = algo
  DiffResult::{
    hunks: Array::new(),
    before_len: before.length(),
    after_len: after.length(),
  }
}

///| Diff two strings line-by-line with indentation slider postprocessing.
pub fn diff_lines(before : String, after : String, algo : Algorithm) -> DiffResult {
  let _ = before
  let _ = after
  let _ = algo
  DiffResult::{ hunks: Array::new(), before_len: 0, after_len: 0 }
}

///| Diff two strings line-by-line without slider postprocessing.
pub fn diff_lines_raw(
  before : String,
  after : String,
  algo : Algorithm,
) -> DiffResult {
  let _ = before
  let _ = after
  let _ = algo
  DiffResult::{ hunks: Array::new(), before_len: 0, after_len: 0 }
}

///| Format a unified diff between `before` and `after`.
pub fn unified_diff(
  before : String,
  after : String,
  before_name : String,
  after_name : String,
  context : Int,
  algo : Algorithm,
) -> String {
  let _ = before
  let _ = after
  let _ = before_name
  let _ = after_name
  let _ = context
  let _ = algo
  ""
}

///| Parse a unified diff patch string.
pub fn parse_unified_patch(patch : String) -> Result[UnifiedPatch, DiffError] {
  let _ = patch
  Err(DiffError::new("unimplemented", "stub"))
}

///| Apply a unified diff patch to `original`.
pub fn apply_unified_patch(
  original : String,
  patch : String,
) -> Result[String, DiffError] {
  let _ = original
  let _ = patch
  Err(DiffError::new("unimplemented", "stub"))
}

///| Reverse-apply a unified diff patch to `modified` to recover the original.
pub fn apply_unified_patch_reverse(
  modified : String,
  patch : String,
) -> Result[String, DiffError] {
  let _ = modified
  let _ = patch
  Err(DiffError::new("unimplemented", "stub"))
}

///| Perform a three-way merge of `ours` and `theirs` against `base`.
pub fn merge3(base : String, ours : String, theirs : String) -> MergeResult {
  let _ = base
  let _ = ours
  let _ = theirs
  MergeResult::{ chunks: Array::new(), has_conflicts: false }
}
