///| Public entry points and core diff orchestration for the `diff` package.

///| Core diff driver on integer token sequences, returning `(removed, added)` boolean arrays.
pub fn compute_diff_flags(
  before : Array[Int],
  after : Array[Int],
  num_tokens : Int,
  algo : Algorithm,
) -> (Array[Bool], Array[Bool]) {
  let b_len = before.length()
  let a_len = after.length()
  let removed = Array::make(b_len, false)
  let added = Array::make(a_len, false)

  let pre = common_prefix_range(before, 0, b_len, after, 0, a_len)
  let post = common_postfix_range(
    before,
    pre,
    b_len - pre,
    after,
    pre,
    a_len - pre,
  )
  let mid_b = b_len - pre - post
  let mid_a = a_len - pre - post

  if mid_b == 0 && mid_a == 0 {
    return (removed, added)
  }

  match algo {
    Algorithm::Myers =>
    myers_diff_range(
      before, pre, mid_b, after, pre, mid_a, num_tokens, removed, added, false,
    )
    Algorithm::Histogram =>
    histogram_diff_range(
      before, pre, mid_b, after, pre, mid_a, num_tokens, removed, added,
    )
  }

  (removed, added)
}

///| Collect monotonically increasing changed hunks from `(removed, added)` boolean arrays.
pub fn collect_hunks(removed : Array[Bool], added : Array[Bool]) -> Array[Hunk] {
  let hunks : Array[Hunk] = Array::new()
  let b_len = removed.length()
  let a_len = added.length()
  let mut pb = 0
  let mut pa = 0

  while pb < b_len || pa < a_len {
    let start_b = pb
    let start_a = pa
    while pb < b_len && removed[pb] {
      pb = pb + 1
    }
    while pa < a_len && added[pa] {
      pa = pa + 1
    }
    if pb > start_b || pa > start_a {
      hunks.push(Hunk::new(start_b, pb, start_a, pa))
    }
    if pb < b_len || pa < a_len {
      pb = pb + 1
      pa = pa + 1
    }
  }
  hunks
}

///| Diff two integer token sequences directly (no slider postprocessing).
pub fn diff_tokens(
  before : Array[Int],
  after : Array[Int],
  num_tokens : Int,
  algo : Algorithm,
) -> DiffResult {
  let (removed, added) = compute_diff_flags(before, after, num_tokens, algo)
  let hunks = collect_hunks(removed, added)
  DiffResult::{
    hunks: hunks,
    before_len: before.length(),
    after_len: after.length(),
  }
}

///| Diff two string slices using token interning, selected algorithm, and indentation slider postprocessing.
pub fn diff_slices(
  before : Array[String],
  after : Array[String],
  algo : Algorithm,
) -> DiffResult {
  let (b_toks, a_toks, vocab) = intern_slices(before, after)
  let (removed, added) = compute_diff_flags(b_toks, a_toks, vocab.length(), algo)
  let indents = compute_vocab_indents(vocab)
  postprocess_with_indents(b_toks, a_toks, removed, added, indents)
  let hunks = collect_hunks(removed, added)
  DiffResult::{
    hunks: hunks,
    before_len: before.length(),
    after_len: after.length(),
  }
}

///| Diff two strings line-by-line with indentation slider postprocessing.
pub fn diff_lines(before : String, after : String, algo : Algorithm) -> DiffResult {
  let interner = intern_lines(before, after)
  let (removed, added) = compute_diff_flags(
    interner.before_tokens,
    interner.after_tokens,
    interner.num_tokens,
    algo,
  )
  postprocess_interned_lines(interner, removed, added)
  let hunks = collect_hunks(removed, added)
  DiffResult::{
    hunks: hunks,
    before_len: interner.before_tokens.length(),
    after_len: interner.after_tokens.length(),
  }
}

///| Diff two strings line-by-line without slider postprocessing.
pub fn diff_lines_raw(
  before : String,
  after : String,
  algo : Algorithm,
) -> DiffResult {
  let interner = intern_lines(before, after)
  let (removed, added) = compute_diff_flags(
    interner.before_tokens,
    interner.after_tokens,
    interner.num_tokens,
    algo,
  )
  let hunks = collect_hunks(removed, added)
  DiffResult::{
    hunks: hunks,
    before_len: interner.before_tokens.length(),
    after_len: interner.after_tokens.length(),
  }
}
