///| Three-way merge (`merge3`) tests (25 tests).

///|
fn count_conflicts(res : MergeResult) -> Int {
  let mut c = 0
  let mut i = 0
  while i < res.chunks.length() {
    match res.chunks[i] {
      MergeChunk::Clean(_) => ()
      MergeChunk::Conflict(_, _, _) => c = c + 1
    }
    i = i + 1
  }
  c
}

///|
test "merge3_all_identical" {
  let base = "a\nb\nc\n"
  let res = merge3(base, base, base)
  debug_assert(res.is_clean(), "no conflicts")
  debug_assert(res.to_string() == base, "identical output")
}

///|
test "merge3_all_empty" {
  let res = merge3("", "", "")
  debug_assert(res.is_clean(), "no conflicts")
  debug_assert(res.to_string() == "", "empty output")
}

///|
test "merge3_ours_only_modify" {
  let base = "a\nb\nc\n"
  let ours = "a\nB_OURS\nc\n"
  let res = merge3(base, ours, base)
  debug_assert(res.is_clean(), "clean merge")
  debug_assert(res.to_string() == ours, "takes ours")
}

///|
test "merge3_theirs_only_modify" {
  let base = "a\nb\nc\n"
  let theirs = "a\nB_THEIRS\nc\n"
  let res = merge3(base, base, theirs)
  debug_assert(res.is_clean(), "clean merge")
  debug_assert(res.to_string() == theirs, "takes theirs")
}

///|
test "merge3_ours_only_insert" {
  let base = "a\nc\n"
  let ours = "a\nb1\nb2\nc\n"
  let res = merge3(base, ours, base)
  debug_assert(res.is_clean(), "clean merge")
  debug_assert(res.to_string() == ours, "takes ours insertion")
}

///|
test "merge3_theirs_only_delete" {
  let base = "a\nb\nc\n"
  let theirs = "a\nc\n"
  let res = merge3(base, base, theirs)
  debug_assert(res.is_clean(), "clean merge")
  debug_assert(res.to_string() == theirs, "takes theirs deletion")
}

///|
test "merge3_convergent_identical_modify" {
  let base = "a\nb\nc\n"
  let both = "a\nSAME\nc\n"
  let res = merge3(base, both, both)
  debug_assert(res.is_clean(), "convergent edit is clean")
  debug_assert(res.to_string() == both, "result matches both")
}

///|
test "merge3_convergent_identical_insert" {
  let base = "a\nc\n"
  let both = "a\ninserted\nc\n"
  let res = merge3(base, both, both)
  debug_assert(res.is_clean(), "convergent insert is clean")
  debug_assert(res.to_string() == both, "result matches both")
}

///|
test "merge3_convergent_identical_delete" {
  let base = "a\nb\nc\n"
  let both = "a\nc\n"
  let res = merge3(base, both, both)
  debug_assert(res.is_clean(), "convergent delete is clean")
  debug_assert(res.to_string() == both, "result matches both")
}

///|
test "merge3_disjoint_edits_top_and_bottom" {
  let base = "1\n2\n3\n4\n5\n"
  let ours = "ONE\n2\n3\n4\n5\n"
  let theirs = "1\n2\n3\n4\nFIVE\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.is_clean(), "disjoint edits merge cleanly")
  debug_assert(res.to_string() == "ONE\n2\n3\n4\nFIVE\n", "both edits applied")
}

///|
test "merge3_disjoint_insert_and_delete" {
  let base = "a\nb\nc\nd\ne\n"
  let ours = "a\nX\nb\nc\nd\ne\n"
  let theirs = "a\nb\nc\ne\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.is_clean(), "clean merge")
  debug_assert(res.to_string() == "a\nX\nb\nc\ne\n", "insert + delete both preserved")
}

///|
test "merge3_disjoint_multiple_hunks_interleaved" {
  let base = "1\n2\n3\n4\n5\n6\n7\n8\n9\n"
  let ours = "1\nO2\n3\n4\n5\nO6\n7\n8\n9\n"
  let theirs = "1\n2\n3\nT4\n5\n6\n7\nT8\n9\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.is_clean(), "interleaved disjoint hunks clean")
  debug_assert(res.to_string() == "1\nO2\n3\nT4\n5\nO6\n7\nT8\n9\n", "all 4 edits merged")
}

///|
test "merge3_conflict_same_line_different_values" {
  let base = "a\nb\nc\n"
  let ours = "a\nOURS\nc\n"
  let theirs = "a\nTHEIRS\nc\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "has conflict")
  debug_assert(!res.is_clean(), "not clean")
  debug_assert(count_conflicts(res) == 1, "1 conflict chunk")
  let expected = "a\n<<<<<<< ours\nOURS\n=======\nTHEIRS\n>>>>>>> theirs\nc\n"
  debug_assert(res.to_string() == expected, "standard conflict markers")
}

///|
test "merge3_conflict_structured_chunk_contents" {
  let base = "top\nold\nbottom\n"
  let ours = "top\nleft1\nleft2\nbottom\n"
  let theirs = "top\nright1\nbottom\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "has conflict")
  let mut found = false
  let mut i = 0
  while i < res.chunks.length() {
    match res.chunks[i] {
      MergeChunk::Clean(_) => ()
      MergeChunk::Conflict(b, o, t) => {
        found = true
        debug_assert(b.length() == 1 && b[0] == "old\n", "base chunk")
        debug_assert(o.length() == 2 && o[0] == "left1\n" && o[1] == "left2\n", "ours chunk")
        debug_assert(t.length() == 1 && t[0] == "right1\n", "theirs chunk")
      }
    }
    i = i + 1
  }
  debug_assert(found, "found conflict chunk")
}

///|
test "merge3_conflict_custom_labels" {
  let base = "x\n"
  let ours = "a\n"
  let theirs = "b\n"
  let res = merge3(base, ours, theirs)
  let rendered = res.to_string_with_labels("HEAD", "origin/main")
  let expected = "<<<<<<< HEAD\na\n=======\nb\n>>>>>>> origin/main\n"
  debug_assert(rendered == expected, "custom conflict labels")
}

///|
test "merge3_conflict_both_insert_at_same_point" {
  let base = "a\nb\n"
  let ours = "a\nOURS_INS\nb\n"
  let theirs = "a\nTHEIRS_INS\nb\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "conflicting inserts at same point")
  let expected = "a\n<<<<<<< ours\nOURS_INS\n=======\nTHEIRS_INS\n>>>>>>> theirs\nb\n"
  debug_assert(res.to_string() == expected, "insert conflict markers")
}

///|
test "merge3_conflict_modify_vs_delete" {
  let base = "a\nb\nc\n"
  let ours = "a\nMODIFIED\nc\n"
  let theirs = "a\nc\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "modify vs delete is a conflict")
  let expected = "a\n<<<<<<< ours\nMODIFIED\n=======\n>>>>>>> theirs\nc\n"
  debug_assert(res.to_string() == expected, "modify vs delete markers")
}

///|
test "merge3_conflict_delete_vs_modify" {
  let base = "a\nb\nc\n"
  let ours = "a\nc\n"
  let theirs = "a\nMODIFIED\nc\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "delete vs modify is a conflict")
  let expected = "a\n<<<<<<< ours\n=======\nMODIFIED\n>>>>>>> theirs\nc\n"
  debug_assert(res.to_string() == expected, "delete vs modify markers")
}

///|
test "merge3_conflict_partially_overlapping_ranges" {
  let base = "1\n2\n3\n4\n5\n"
  let ours = "1\nO2\nO3\n4\n5\n"
  let theirs = "1\n2\nT3\nT4\n5\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "overlapping ranges conflict")
  debug_assert(count_conflicts(res) == 1, "merged into 1 conflict region")
  let expected = "1\n<<<<<<< ours\nO2\nO3\n4\n=======\n2\nT3\nT4\n>>>>>>> theirs\n5\n"
  debug_assert(res.to_string() == expected, "overlapping conflict spans lines 2..4")
}

///|
test "merge3_multiple_conflicts_and_clean_regions" {
  let base = "h\n1\nm1\nm2\n2\nt\n"
  let ours = "h\nO1\nm1\nm2\nO2\nt\n"
  let theirs = "h\nT1\nm1\nm2\nT2\nt\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "has conflicts")
  debug_assert(count_conflicts(res) == 2, "2 separate conflict chunks")
  let expected = "h\n<<<<<<< ours\nO1\n=======\nT1\n>>>>>>> theirs\nm1\nm2\n<<<<<<< ours\nO2\n=======\nT2\n>>>>>>> theirs\nt\n"
  debug_assert(res.to_string() == expected, "2 conflicts with clean middle")
}

///|
test "merge3_empty_base_ours_only" {
  let res = merge3("", "a\nb\n", "")
  debug_assert(res.is_clean(), "clean")
  debug_assert(res.to_string() == "a\nb\n", "takes ours")
}

///|
test "merge3_empty_base_both_different_conflict" {
  let res = merge3("", "ours\n", "theirs\n")
  debug_assert(res.has_conflicts, "both created different files")
  let expected = "<<<<<<< ours\nours\n=======\ntheirs\n>>>>>>> theirs\n"
  debug_assert(res.to_string() == expected, "conflict on empty base")
}

///|
test "merge3_empty_base_both_same_clean" {
  let res = merge3("", "same\n", "same\n")
  debug_assert(res.is_clean(), "both created identical file")
  debug_assert(res.to_string() == "same\n", "clean result")
}

///|
test "merge3_memory_sync_two_stations_append_at_different_sections" {
  // Realistic shared config sync sync scenario: station A edits section 1, station B edits section 2
  let base = "# Memory\n- rule 1\n- rule 2\n- rule 3\n- rule 4\n"
  let ours = "# Memory\n- rule 1 (updated by station A)\n- rule 2\n- rule 3\n- rule 4\n"
  let theirs = "# Memory\n- rule 1\n- rule 2\n- rule 3\n- rule 4\n- rule 5 (added by station B)\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.is_clean(), "memory sync merges cleanly")
  let expected = "# Memory\n- rule 1 (updated by station A)\n- rule 2\n- rule 3\n- rule 4\n- rule 5 (added by station B)\n"
  debug_assert(res.to_string() == expected, "both station rules preserved")
}

///|
test "merge3_conflict_no_trailing_newline" {
  let base = "a\nb"
  let ours = "a\nOURS"
  let theirs = "a\nTHEIRS"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "conflict without trailing newline")
  let s = res.to_string()
  debug_assert(s.length() > 0, "rendered non-empty")
  // Markers should still be on their own lines
  let expected = "a\n<<<<<<< ours\nOURS\n=======\nTHEIRS\n>>>>>>> theirs\n"
  debug_assert(s == expected, "markers properly newline-separated")
}
