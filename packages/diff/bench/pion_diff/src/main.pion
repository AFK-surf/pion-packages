///| Benchmark driver for `packages/diff` (Myers & Histogram unified diff).

import "diff"

///|
fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return fallback
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc <= 0 {
    fallback
  } else {
    acc
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 5 {
    io_println(
      world,
      "usage: bench_pion <before_path> <after_path> <myers|histogram> <iters>",
    )
    return 1
  }
  let before_path = args[1]
  let after_path = args[2]
  let algo_name = args[3]
  let iters = parse_int_arg(args[4], 1)

  let algo = if algo_name == "myers" {
    diff::Algorithm::Myers
  } else if algo_name == "histogram" {
    diff::Algorithm::Histogram
  } else {
    io_println(world, "error: unknown algorithm: " + algo_name)
    return 1
  }

  let before = match fs_read(world, before_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read before file")
      return 1
    }
  }
  let after = match fs_read(world, after_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read after file")
      return 1
    }
  }

  let mut total_bytes : Int64 = 0L
  let mut last_out = ""
  let mut i = 0
  while i < iters {
    let out = diff::unified_diff(before, after, "", "", 3, algo)
    total_bytes = total_bytes + out.length().to_int64()
    last_out = out
    i = i + 1
  }

  io_println(world, "iters=" + iters.to_string() + " total_bytes=" + total_bytes.to_string())
  io_print(world, last_out)
  0
}
