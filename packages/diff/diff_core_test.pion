///| Core unit tests ported from `pascalkuthe/imara-diff` (45 tests).

///| Helper: apply hunks from a DiffResult to `before` and `after` arrays to reconstruct `after`.
fn apply_hunks_str(
  before : Array[String],
  after : Array[String],
  res : DiffResult,
) -> Array[String] {
  let out : Array[String] = Array::new()
  let mut b_pos = 0
  let mut i = 0
  let n = res.hunks.length()
  while i < n {
    let h = res.hunks[i]
    while b_pos < h.before_start {
      out.push(before[b_pos])
      b_pos = b_pos + 1
    }
    let mut a_pos = h.after_start
    while a_pos < h.after_end {
      out.push(after[a_pos])
      a_pos = a_pos + 1
    }
    b_pos = h.before_end
    i = i + 1
  }
  while b_pos < before.length() {
    out.push(before[b_pos])
    b_pos = b_pos + 1
  }
  out
}

///|
fn arr_eq_str(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn assert_hunks_reconstruct(
  before_str : String,
  after_str : String,
  algo : Algorithm,
) -> Unit {
  let before = split_lines(before_str)
  let after = split_lines(after_str)
  let res = diff_lines(before_str, after_str, algo)
  debug_assert(res.before_len == before.length(), "before_len matches")
  debug_assert(res.after_len == after.length(), "after_len matches")
  let reconstructed = apply_hunks_str(before, after, res)
  debug_assert(arr_eq_str(reconstructed, after), "hunks reconstruct after")
}

///|
test "split_lines_empty" {
  let lines = split_lines("")
  debug_assert(lines.length() == 0, "empty string has 0 lines")
}

///|
test "split_lines_single_no_newline" {
  let lines = split_lines("hello")
  debug_assert(lines.length() == 1, "1 line")
  debug_assert(lines[0] == "hello", "exact content")
}

///|
test "split_lines_single_with_newline" {
  let lines = split_lines("hello\n")
  debug_assert(lines.length() == 1, "1 line")
  debug_assert(lines[0] == "hello\n", "preserves newline")
}

///|
test "split_lines_multi_and_crlf" {
  let lines = split_lines("a\r\nb\nc")
  debug_assert(lines.length() == 3, "3 lines")
  debug_assert(lines[0] == "a\r\n", "line 0 crlf")
  debug_assert(lines[1] == "b\n", "line 1 lf")
  debug_assert(lines[2] == "c", "line 2 no eol")
}

///|
test "hunk_methods_and_invert" {
  let h = Hunk::new(2, 5, 3, 4)
  debug_assert(h.before_len() == 3, "before_len")
  debug_assert(h.after_len() == 1, "after_len")
  debug_assert(!h.is_pure_insertion(), "not pure insertion")
  debug_assert(!h.is_pure_removal(), "not pure removal")
  let inv = h.invert()
  debug_assert(inv.before_start == 3 && inv.before_end == 4, "inv before")
  debug_assert(inv.after_start == 2 && inv.after_end == 5, "inv after")
  let ins = Hunk::new(1, 1, 1, 3)
  debug_assert(ins.is_pure_insertion(), "pure insertion")
  let rem = Hunk::new(1, 4, 1, 1)
  debug_assert(rem.is_pure_removal(), "pure removal")
}

///|
test "empty_both_myers" {
  let r = diff_lines("", "", Algorithm::Myers)
  debug_assert(r.is_empty(), "empty diff")
  debug_assert(r.before_len == 0 && r.after_len == 0, "lengths 0")
}

///|
test "empty_both_histogram" {
  let r = diff_lines("", "", Algorithm::Histogram)
  debug_assert(r.is_empty(), "empty diff")
  debug_assert(r.before_len == 0 && r.after_len == 0, "lengths 0")
}

///|
test "empty_to_nonempty_myers" {
  let r = diff_lines("", "a\nb\nc\n", Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  debug_assert(r.hunks[0].before_start == 0 && r.hunks[0].before_end == 0, "before 0..0")
  debug_assert(r.hunks[0].after_start == 0 && r.hunks[0].after_end == 3, "after 0..3")
  debug_assert(r.count_additions() == 3 && r.count_removals() == 0, "3 adds 0 rems")
}

///|
test "empty_to_nonempty_histogram" {
  let r = diff_lines("", "a\nb\nc\n", Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  debug_assert(r.hunks[0].is_pure_insertion(), "pure insertion")
  debug_assert(r.count_additions() == 3, "3 additions")
}

///|
test "nonempty_to_empty_myers" {
  let r = diff_lines("a\nb\nc\n", "", Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  debug_assert(r.hunks[0].is_pure_removal(), "pure removal")
  debug_assert(r.count_removals() == 3 && r.count_additions() == 0, "3 rems 0 adds")
}

///|
test "nonempty_to_empty_histogram" {
  let r = diff_lines("a\nb\nc\n", "", Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  debug_assert(r.hunks[0].is_pure_removal(), "pure removal")
  debug_assert(r.count_removals() == 3, "3 removals")
}

///|
test "identical_files_myers" {
  let file = "fn foo() -> Bar{\n    let mut foo = 2.0;\n    foo *= 100 / 2;\n}"
  let r = diff_lines(file, file, Algorithm::Myers)
  debug_assert(r.is_empty(), "identical files have no hunks")
  debug_assert(r.before_len == 4 && r.after_len == 4, "4 lines")
}

///|
test "identical_files_histogram" {
  let file = "fn foo() -> Bar{\n    let mut foo = 2.0;\n    foo *= 100 / 2;\n}"
  let r = diff_lines(file, file, Algorithm::Histogram)
  debug_assert(r.is_empty(), "identical files have no hunks")
  debug_assert(r.before_len == 4 && r.after_len == 4, "4 lines")
}

///|
test "completely_different_myers" {
  let r = diff_lines("a\nb\nc\n", "x\ny\nz\nw\n", Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "single replacement hunk")
  debug_assert(r.hunks[0].before_start == 0 && r.hunks[0].before_end == 3, "before 0..3")
  debug_assert(r.hunks[0].after_start == 0 && r.hunks[0].after_end == 4, "after 0..4")
}

///|
test "completely_different_histogram" {
  let r = diff_lines("a\nb\nc\n", "x\ny\nz\nw\n", Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "single replacement hunk")
  debug_assert(r.count_removals() == 3 && r.count_additions() == 4, "3 rem 4 add")
}

///|
test "common_prefix_and_postfix_stripping_myers" {
  let before = "p1\np2\np3\nold1\nold2\ns1\ns2\ns3\n"
  let after = "p1\np2\np3\nnew1\ns1\ns2\ns3\n"
  let r = diff_lines(before, after, Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 3 && h.before_end == 5, "before 3..5")
  debug_assert(h.after_start == 3 && h.after_end == 4, "after 3..4")
}

///|
test "common_prefix_and_postfix_stripping_histogram" {
  let before = "p1\np2\np3\nold1\nold2\ns1\ns2\ns3\n"
  let after = "p1\np2\np3\nnew1\ns1\ns2\ns3\n"
  let r = diff_lines(before, after, Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 3 && h.before_end == 5, "before 3..5")
  debug_assert(h.after_start == 3 && h.after_end == 4, "after 3..4")
}

///|
test "single_line_insert_middle_myers" {
  let r = diff_lines("a\nb\nc\n", "a\nb\nX\nc\n", Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 2 && h.before_end == 2, "insert at 2")
  debug_assert(h.after_start == 2 && h.after_end == 3, "after 2..3")
}

///|
test "single_line_insert_middle_histogram" {
  let r = diff_lines("a\nb\nc\n", "a\nb\nX\nc\n", Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 2 && h.before_end == 2, "insert at 2")
  debug_assert(h.after_start == 2 && h.after_end == 3, "after 2..3")
}

///|
test "single_line_delete_middle_myers" {
  let r = diff_lines("a\nb\nX\nc\n", "a\nb\nc\n", Algorithm::Myers)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 2 && h.before_end == 3, "del 2..3")
  debug_assert(h.after_start == 2 && h.after_end == 2, "after 2..2")
}

///|
test "single_line_delete_middle_histogram" {
  let r = diff_lines("a\nb\nX\nc\n", "a\nb\nc\n", Algorithm::Histogram)
  debug_assert(r.hunks.length() == 1, "1 hunk")
  let h = r.hunks[0]
  debug_assert(h.before_start == 2 && h.before_end == 3, "del 2..3")
  debug_assert(h.after_start == 2 && h.after_end == 2, "after 2..2")
