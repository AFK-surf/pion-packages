///| Unit tests for red-team fixes (P0-1, P0-2, P0-3, P2-2, P2-3).

///|
fn fmt_hunks(res : DiffResult) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < res.hunks.length() {
    let h = res.hunks[i]
    if i > 0 {
      sb.write_string(" ")
    }
    sb.write_string(h.before_start.to_string())
    sb.write_string("-")
    sb.write_string(h.before_end.to_string())
    sb.write_string(":")
    sb.write_string(h.after_start.to_string())
    sb.write_string("-")
    sb.write_string(h.after_end.to_string())
    i = i + 1
  }
  sb.to_string()
}

///| P0-1: Windowed diff_lines must match full-file diff_slices across >20 blank lines (suffix).
test "rt_p0_1_window_blank_suffix_matches_full" {
  let before = "    if x {\n    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  let after = "    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  let h_win = fmt_hunks(diff_lines(before, after, Algorithm::Histogram))
  let h_full = fmt_hunks(
    diff_slices(split_lines(before), split_lines(after), Algorithm::Histogram),
  )
  debug_assert(h_win == h_full, "Histogram windowed matches full")
  debug_assert(h_win == "0-1:0-0 23-24:22-22", "Histogram exact hunks")

  let m_win = fmt_hunks(diff_lines(before, after, Algorithm::Myers))
  let m_full = fmt_hunks(
    diff_slices(split_lines(before), split_lines(after), Algorithm::Myers),
  )
  debug_assert(m_win == m_full, "Myers windowed matches full")
  debug_assert(m_win == "0-1:0-0 23-24:22-22", "Myers exact hunks")
}

///| P0-1: Windowed diff_lines and unified_diff across >20 blank prefix lines.
test "rt_p0_1_window_blank_prefix_matches_full" {
  let before = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn f() {\n\n\n        return;\n"
  let after = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n        return;\n"
  let h_win = fmt_hunks(diff_lines(before, after, Algorithm::Histogram))
  let h_full = fmt_hunks(
    diff_slices(split_lines(before), split_lines(after), Algorithm::Histogram),
  )
  debug_assert(h_win == h_full, "Histogram prefix windowed matches full")
  debug_assert(h_win == "20-23:20-20", "Histogram prefix exact hunks")
  let u = unified_diff(before, after, "", "", 3, Algorithm::Histogram)
  debug_assert(
    u == "@@ -18,9 +18,6 @@\n \n \n \n-\n-\n-fn f() {\n \n \n         return;\n",
    "unified_diff prefix exact",
  )
}

///| P0-2: Large context (>= 21) must never truncate trailing context lines.
test "rt_p0_2_unified_large_context_no_truncation" {
  let before = "\n}\nb\na\n{\nb\na\n\na\n}\nb\n}\n  x\nb\n\nc\na\n}\n\nb\n}\n\nc\n{\n{\n{\n{\na\n"
  let after = "}\nb\nb\na\n{\nb\na\n\na\n}\nb\n}\n  x\nb\n\nc\na\n}\n\nb\n}\n\nc\n{\n{\n{\n{\na\n"
  let u = unified_diff(before, after, "", "", 25, Algorithm::Histogram)
  let expected = "@@ -1,28 +1,28 @@\n-\n }\n b\n+b\n a\n {\n b\n a\n \n a\n }\n b\n }\n   x\n b\n \n c\n a\n }\n \n b\n }\n \n c\n {\n {\n {\n {\n a\n"
  debug_assert(u == expected, "ctx=25 preserves full trailing context")
  match apply_unified_patch(before, u) {
    Ok(out) => debug_assert(out == after, "ctx=25 patch roundtrips")
    Err(e) => debug_assert(false, "ctx=25 apply failed: " + e.message)
  }
}

///| P2-2: Adjacent (touching but non-overlapping) edits in merge3 must report a conflict.
test "rt_p2_2_merge3_adjacent_edits_conflict" {
  let base = "a\n}\n}\n"
  let ours = "Z\n}\n}\n"
  let theirs = "a\nc\n}\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "adjacent edits must conflict like git merge-file")
  debug_assert(
    res.to_string() == "<<<<<<< ours\nZ\n}\n=======\na\nc\n>>>>>>> theirs\n}\n",
    "adjacent conflict covers both touching lines",
  )
}

///| P2-2: Chain of adjacent hunks across ours and theirs expands into a single conflict region.
test "rt_p2_2_merge3_adjacent_chain_expands_conflict" {
  let base = "1\n2\n3\n4\n"
  let ours = "O1\n2\nO3\n4\n"
  let theirs = "1\nT2\n3\n4\n"
  let res = merge3(base, ours, theirs)
  debug_assert(res.has_conflicts, "adjacent chain must conflict")
  let expected = "<<<<<<< ours\nO1\n2\nO3\n=======\n1\nT2\n3\n>>>>>>> theirs\n4\n"
  debug_assert(res.to_string() == expected, "adjacent chain coalesces into 1 conflict")
}

///| P2-3: Algorithm::MyersMinimal produces exact minimal edit scripts.
test "rt_p2_3_myers_minimal_algorithm" {
  let before = "a\nb\nc\nd\ne\nf\n"
  let after = "a\nx\nc\ny\ne\nz\n"
  let r_min = diff_lines(before, after, Algorithm::MyersMinimal)
  let r_myers = diff_lines(before, after, Algorithm::Myers)
  debug_assert(r_min.count_removals() == 3, "minimal removes 3")
  debug_assert(r_min.count_additions() == 3, "minimal adds 3")
  debug_assert(fmt_hunks(r_min) == fmt_hunks(r_myers), "matches Myers on small input")
  let u = unified_diff(before, after, "a", "b", 1, Algorithm::MyersMinimal)
  match apply_unified_patch(before, u) {
    Ok(out) => debug_assert(out == after, "MyersMinimal unified patch roundtrips")
    Err(e) => debug_assert(false, "MyersMinimal patch failed: " + e.message)
  }
}

///| P2-3: Reusable BeforeInterner matches one-shot diff_lines / unified_diff across multiple afters.
test "rt_p2_3_reusable_before_interner_multi_after" {
  let before = "fn alpha() {\n    let x = 1;\n    let y = 2;\n}\n\nfn beta() {\n    let z = 3;\n}\n"
  let afters = [
    before,
    "fn alpha() {\n    let x = 10;\n    let y = 2;\n}\n\nfn beta() {\n    let z = 3;\n}\n",
    "fn alpha() {\n    let x = 1;\n    let y = 2;\n}\n\nfn beta() {\n    let z = 30;\n    let w = 40;\n}\n",
    "// header\nfn alpha() {\n    let x = 1;\n}\n",
    "",
  ]
  let interned = intern_before(before)
  let mut i = 0
  while i < afters.length() {
    let a = afters[i]
    let d1 = diff_lines(before, a, Algorithm::Histogram)
    let d2 = diff_against_interned(interned, a, Algorithm::Histogram)
    debug_assert(fmt_hunks(d1) == fmt_hunks(d2), "Histogram hunks match")
    debug_assert(d1.before_len == d2.before_len && d1.after_len == d2.after_len, "lengths match")

    let r1 = diff_lines_raw(before, a, Algorithm::Myers)
    let r2 = interned.diff_raw(a, Algorithm::Myers)
    debug_assert(fmt_hunks(r1) == fmt_hunks(r2), "Myers raw hunks match")

    let m1 = diff_lines(before, a, Algorithm::MyersMinimal)
    let m2 = interned.diff(a, Algorithm::MyersMinimal)
    debug_assert(fmt_hunks(m1) == fmt_hunks(m2), "MyersMinimal hunks match")

    let u1 = unified_diff(before, a, "a/f", "b/f", 3, Algorithm::Histogram)
    let u2 = interned.unified_diff(a, "a/f", "b/f", 3, Algorithm::Histogram)
    debug_assert(u1 == u2, "unified_diff matches")
    i = i + 1
  }
}
