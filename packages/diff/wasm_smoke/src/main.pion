///| Wasm32 smoke entry for the `diff` package.

import "diff"

///|
pub fn smoke() -> Int {
  let before = "fn foo() {\n    let a = 1;\n    let b = 2;\n}\n"
  let after = "fn foo() {\n    let a = 1;\n    let b = 3;\n    let c = 4;\n}\n"
  let r_myers = diff::diff_lines(before, after, diff::Algorithm::Myers)
  let r_hist = diff::diff_lines(before, after, diff::Algorithm::Histogram)
  let patch = diff::unified_diff(
    before,
    after,
    "a/foo.pion",
    "b/foo.pion",
    3,
    diff::Algorithm::Histogram,
  )
  let applied = match diff::apply_unified_patch(before, patch) {
    Ok(s) => s
    Err(_) => return -1
  }
  let merged = diff::merge3(before, after, before)
  r_myers.hunks.length() + r_hist.hunks.length() + applied.length() + merged.to_string().length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
