  run_random_batch(505L, 25, 20, 20, 10, Algorithm::Myers, true)
}

///|
test "prop_myers_minimal_high_cardinality" {
  run_random_batch(606L, 25, 25, 25, 50, Algorithm::Myers, true)
}

///|
test "prop_histogram_binary_alphabet_small" {
  run_random_batch(707L, 30, 15, 15, 2, Algorithm::Histogram, false)
}

