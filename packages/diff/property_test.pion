///|
test "prop_lines_postprocess_reconstruct_myers" {
  let mut s = 2020L
  let mut c = 0
  while c < 15 {
    let (a_tok, s1) = gen_seq(s, 40, 6)
    let (b_tok, s2) = mutate_seq(a_tok, s1, 6, 25)
    s = s2
    let sb1 = StringBuilder::new()
    let mut i = 0
    while i < a_tok.length() {
      if a_tok[i] == 0 {
        sb1.write_string("\n")
      } else if a_tok[i] == 1 {
        sb1.write_string("}\n")
      } else {
        sb1.write_string("    line_" + a_tok[i].to_string() + "\n")
      }
      i = i + 1
    }
    let sb2 = StringBuilder::new()
    let mut j = 0
    while j < b_tok.length() {
      if b_tok[j] == 0 {
        sb2.write_string("\n")
      } else if b_tok[j] == 1 {
        sb2.write_string("}\n")
      } else {
        sb2.write_string("    line_" + b_tok[j].to_string() + "\n")
      }
      j = j + 1
    }
    let before = sb1.to_string()
    let after = sb2.to_string()
    let patch = unified_diff(before, after, "a", "b", 3, Algorithm::Myers)
    if before == after {
      debug_assert(patch == "", "no diff when equal")
    } else {
      match apply_unified_patch(before, patch) {
        Ok(got) => debug_assert(got == after, "patch restores after")
        Err(e) => debug_assert(false, "patch failed: " + e.message)
      }
    }
    c = c + 1
  }
}

///|
test "prop_lines_postprocess_reconstruct_histogram" {
  let mut s = 2121L
  let mut c = 0
  while c < 15 {
    let (a_tok, s1) = gen_seq(s, 40, 6)
    let (b_tok, s2) = mutate_seq(a_tok, s1, 6, 25)
    s = s2
    let sb1 = StringBuilder::new()
    let mut i = 0
    while i < a_tok.length() {
      if a_tok[i] == 0 {
        sb1.write_string("\n")
      } else if a_tok[i] == 1 {
        sb1.write_string("}\n")
      } else {
        sb1.write_string("    line_" + a_tok[i].to_string() + "\n")
      }
      i = i + 1
    }
    let sb2 = StringBuilder::new()
    let mut j = 0
    while j < b_tok.length() {
      if b_tok[j] == 0 {
        sb2.write_string("\n")
      } else if b_tok[j] == 1 {
        sb2.write_string("}\n")
      } else {
        sb2.write_string("    line_" + b_tok[j].to_string() + "\n")
      }
      j = j + 1
    }
    let before = sb1.to_string()
    let after = sb2.to_string()
    let patch = unified_diff(before, after, "a", "b", 3, Algorithm::Histogram)
    if before == after {
      debug_assert(patch == "", "no diff when equal")
    } else {
      match apply_unified_patch(before, patch) {
        Ok(got) => debug_assert(got == after, "patch restores after")
        Err(e) => debug_assert(false, "patch failed: " + e.message)
      }
    }
    c = c + 1
  }
}

///|
test "prop_symmetry_edit_count_myers_minimal" {
  // For small sequences, edit_dist(A, B) == edit_dist(B, A) under Myers
  let mut s = 2222L
  let mut c = 0
  while c < 20 {
    let (a, s1) = gen_seq(s, 14, 4)
    let (b, s2) = gen_seq(s1, 13, 4)
    s = s2
    let r_ab = diff_tokens(a, b, 4, Algorithm::Myers)
    let r_ba = diff_tokens(b, a, 4, Algorithm::Myers)
    let d_ab = r_ab.count_removals() + r_ab.count_additions()
    let d_ba = r_ba.count_removals() + r_ba.count_additions()
    debug_assert(d_ab == d_ba, "edit distance is symmetric")
    c = c + 1
  }
}

///|
test "prop_single_symbol_various_lengths" {
  let a = Array::make(50, 0)
  let b = Array::make(85, 0)
  verify_token_diff(a, b, 1, Algorithm::Myers, true)
  verify_token_diff(a, b, 1, Algorithm::Histogram, false)
  verify_token_diff(b, a, 1, Algorithm::Myers, true)
  verify_token_diff(b, a, 1, Algorithm::Histogram, false)
}

///|
test "prop_disjoint_alphabets" {
  let (a, s1) = gen_seq(2323L, 30, 5)
  let (b_raw, _) = gen_seq(s1, 35, 5)
  let b : Array[Int] = Array::new()
  let mut i = 0
  while i < b_raw.length() {
    b.push(b_raw[i] + 5)
    i = i + 1
  }
  verify_token_diff(a, b, 10, Algorithm::Myers, true)
  verify_token_diff(a, b, 10, Algorithm::Histogram, false)
}

///|
test "prop_all_pairs_length_up_to_4_binary_minimal" {
  // Exhaustively test all binary sequences of length 0..=4 against each other for Myers optimality
  let seqs : Array[Array[Int]] = Array::new()
  let mut len = 0
  while len <= 4 {
    let total = 1 << len
    let mut mask = 0
    while mask < total {
      let arr : Array[Int] = Array::new()
      let mut bit = 0
      while bit < len {
        arr.push((mask >> bit) & 1)
        bit = bit + 1
      }
      seqs.push(arr)
      mask = mask + 1
    }
    len = len + 1
  }
  let mut i = 0
  while i < seqs.length() {
    let mut j = 0
    while j < seqs.length() {
      verify_token_diff(seqs[i], seqs[j], 2, Algorithm::Myers, true)
      j = j + 1
    }
    i = i + 1
  }
}
