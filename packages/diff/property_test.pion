///| Property and invariant tests for Myers & Histogram diff (25 tests).
///| Verifies:
///| 1. 100% exact reconstruction of `after` from `before` + hunks.
///| 2. Strict monotonicity and non-overlap of hunks.
///| 3. Exact shortest edit distance (via DP LCS) for Myers on small sequences.

///| Simple deterministic LCG PRNG.
fn next_rand(state : Int64) -> Int64 {
  (state * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
}

///|
fn gen_seq(seed : Int64, len : Int, alphabet : Int) -> (Array[Int], Int64) {
  let arr : Array[Int] = Array::new()
  let mut s = seed
  let mut i = 0
  while i < len {
    s = next_rand(s)
    let v = ((s >> 16) % alphabet.to_int64()).to_int()
    arr.push(if v < 0 { -v } else { v })
    i = i + 1
  }
  (arr, s)
}

///|
fn mutate_seq(
  base : Array[Int],
  seed : Int64,
  alphabet : Int,
  edit_pct : Int,
) -> (Array[Int], Int64) {
  let out : Array[Int] = Array::new()
  let mut s = seed
  let mut i = 0
  while i < base.length() {
    s = next_rand(s)
    let r = ((s >> 16) % 100L).to_int()
    if r < edit_pct {
      s = next_rand(s)
      let op = ((s >> 16) % 3L).to_int()
      if op == 0 {
        // delete
        let _ = 0
      } else if op == 1 {
        // substitute
        s = next_rand(s)
        out.push(((s >> 16) % alphabet.to_int64()).to_int())
      } else {
        // insert + keep
        s = next_rand(s)
        out.push(((s >> 16) % alphabet.to_int64()).to_int())
        out.push(base[i])
      }
    } else {
      out.push(base[i])
    }
    i = i + 1
  }
  (out, s)
}

///| Exact O(N*M) DP LCS length for verifying Myers optimality on small sequences.
fn exact_lcs_len(a : Array[Int], b : Array[Int]) -> Int {
  let n = a.length()
  let m = b.length()
  let mut prev = Array::make(m + 1, 0)
  let mut curr = Array::make(m + 1, 0)
  let mut i = 0
  while i < n {
    curr[0] = 0
    let mut j = 0
    while j < m {
      if a[i] == b[j] {
        curr[j + 1] = prev[j] + 1
      } else {
        let up = prev[j + 1]
        let left = curr[j]
        curr[j + 1] = if up > left { up } else { left }
      }
      j = j + 1
    }
    let tmp = prev
    prev = curr
    curr = tmp
    i = i + 1
  }
  prev[m]
}

///| Verify hunk monotonicity, bounds, and 100% exact reconstruction.
fn verify_token_diff(
  a : Array[Int],
  b : Array[Int],
  num_tokens : Int,
  algo : Algorithm,
  check_minimal : Bool,
) -> Unit {
  let res = diff_tokens(a, b, num_tokens, algo)
  debug_assert(res.before_len == a.length(), "before_len matches")
  debug_assert(res.after_len == b.length(), "after_len matches")

  let out : Array[Int] = Array::new()
  let mut b_pos = 0
  let mut a_pos = 0
  let mut prev_b_end = -1
  let mut prev_a_end = -1
  let mut hi = 0
  while hi < res.hunks.length() {
    let h = res.hunks[hi]
    debug_assert(h.before_start >= 0 && h.before_start <= h.before_end, "valid before range")
    debug_assert(h.before_end <= a.length(), "before_end in bounds")
    debug_assert(h.after_start >= 0 && h.after_start <= h.after_end, "valid after range")
    debug_assert(h.after_end <= b.length(), "after_end in bounds")
    debug_assert(h.before_len() > 0 || h.after_len() > 0, "non-empty hunk")
    if hi > 0 {
      debug_assert(h.before_start > prev_b_end, "strictly increasing before hunks")
      debug_assert(h.after_start > prev_a_end, "strictly increasing after hunks")
    }
    let unchanged_b = h.before_start - b_pos
    let unchanged_a = h.after_start - a_pos
    debug_assert(unchanged_b == unchanged_a, "unchanged gap lengths equal")
    let mut k = 0
    while k < unchanged_b {
      debug_assert(a[b_pos + k] == b[a_pos + k], "unchanged tokens identical")
      out.push(a[b_pos + k])
      k = k + 1
    }
    let mut j = h.after_start
    while j < h.after_end {
      out.push(b[j])
      j = j + 1
    }
    prev_b_end = h.before_end
    prev_a_end = h.after_end
    b_pos = h.before_end
    a_pos = h.after_end
    hi = hi + 1
  }
  let rem_b = a.length() - b_pos
  let rem_a = b.length() - a_pos
  debug_assert(rem_b == rem_a, "trailing unchanged lengths equal")
  let mut t = 0
  while t < rem_b {
    debug_assert(a[b_pos + t] == b[a_pos + t], "trailing unchanged tokens identical")
    out.push(a[b_pos + t])
    t = t + 1
  }
  debug_assert(out.length() == b.length(), "reconstructed length equals after")
  let mut idx = 0
  while idx < b.length() {
    debug_assert(out[idx] == b[idx], "reconstructed element matches")
    idx = idx + 1
  }

  if check_minimal {
    let lcs = exact_lcs_len(a, b)
    let expected_edit_dist = (a.length() - lcs) + (b.length() - lcs)
    let actual_edit_dist = res.count_removals() + res.count_additions()
    debug_assert(
      actual_edit_dist == expected_edit_dist,
      "Myers achieves exact shortest edit distance",
    )
  }
}

///|
fn run_random_batch(
  seed_start : Int64,
  cases : Int,
  len_a : Int,
  len_b : Int,
  alphabet : Int,
  algo : Algorithm,
  check_minimal : Bool,
) -> Unit {
  let mut s = seed_start
  let mut c = 0
  while c < cases {
    let (a, s1) = gen_seq(s, len_a, alphabet)
    let (b, s2) = gen_seq(s1, len_b, alphabet)
    s = s2
    verify_token_diff(a, b, alphabet, algo, check_minimal)
    c = c + 1
  }
}

///|
test "prop_myers_minimal_binary_alphabet_small" {
  run_random_batch(101L, 30, 12, 12, 2, Algorithm::Myers, true)
}

///|
test "prop_myers_minimal_ternary_alphabet_small" {
  run_random_batch(202L, 30, 14, 11, 3, Algorithm::Myers, true)
}

///|
test "prop_myers_minimal_quaternary_alphabet_small" {
  run_random_batch(303L, 30, 15, 15, 4, Algorithm::Myers, true)
}

///|
test "prop_myers_minimal_asymmetric_lengths" {
  run_random_batch(404L, 25, 5, 22, 3, Algorithm::Myers, true)
  run_random_batch(405L, 25, 22, 5, 3, Algorithm::Myers, true)
}

