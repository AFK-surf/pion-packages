test "prop_myers_low_cardinality_long_sequences" {
  run_random_batch(1212L, 10, 150, 160, 2, Algorithm::Myers, false)
  run_random_batch(1213L, 10, 150, 140, 3, Algorithm::Myers, false)
}

///|
test "prop_histogram_low_cardinality_long_sequences" {
  run_random_batch(1313L, 10, 150, 160, 2, Algorithm::Histogram, false)
  run_random_batch(1314L, 10, 150, 140, 4, Algorithm::Histogram, false)
}

///|
test "prop_myers_mutated_realistic_10pct_edits" {
  let mut s = 1414L
  let mut c = 0
  while c < 15 {
    let (a, s1) = gen_seq(s, 120, 40)
    let (b, s2) = mutate_seq(a, s1, 40, 10)
    s = s2
    verify_token_diff(a, b, 40, Algorithm::Myers, false)
    c = c + 1
  }
}

