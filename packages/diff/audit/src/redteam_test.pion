///| Red-team parity tests: Pion `packages/diff` vs real Rust `imara-diff v0.2.0`.
///| GENERATED by `audit/gen_redteam_tests.py` - every expected value was printed by the
///| Rust oracle `audit/harness/rust_oracle` on the same input. A failing `p0_*`/`p1_*`/`p2_*`
///| test is a reproducible divergence; `ok_*` tests are parity controls expected to pass.

import "diff"

///|
fn hunks_str(res : diff::DiffResult) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < res.hunks.length() {
    let h = res.hunks[i]
    if i > 0 {
      sb.write_string(" ")
    }
    sb.write_string(h.before_start.to_string())
    sb.write_string("-")
    sb.write_string(h.before_end.to_string())
    sb.write_string(":")
    sb.write_string(h.after_start.to_string())
    sb.write_string("-")
    sb.write_string(h.after_end.to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn expect_eq(what : String, got : String, want : String) -> Unit {
  debug_assert(
    got == want,
    what + "\n--- imara-diff 0.2.0 (expected) ---\n" + want + "\n--- pion (got) ---\n" + got,
  )
}

///|
/// [P0] diff_lines (margin-21 window) moves a blank-line deletion; imara and Pion's own diff_slices agree
test "p0_window_blank_suffix_histogram" {
  let before = "    if x {\n    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  let after = "    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-1:0-0 23-24:22-22")
  expect_eq("diff_slices Histogram", hunks_str(diff::diff_slices(diff::split_lines(before), diff::split_lines(after), diff::Algorithm::Histogram)), "0-1:0-0 23-24:22-22")
}

///|
/// [P0] same input, Myers
test "p0_window_blank_suffix_myers" {
  let before = "    if x {\n    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  let after = "    }\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  expect_eq("diff_lines Myers", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Myers)), "0-1:0-0 23-24:22-22")
  expect_eq("diff_slices Myers", hunks_str(diff::diff_slices(diff::split_lines(before), diff::split_lines(after), diff::Algorithm::Myers)), "0-1:0-0 23-24:22-22")
}

///|
/// [P0] 22 blank lines then a deleted 3-line block: window start is mistaken for start-of-file
test "p0_window_blank_prefix_histogram" {
  let before = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn f() {\n\n\n        return;\n"
  let after = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n        return;\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "20-23:20-20")
  expect_eq("diff_slices Histogram", hunks_str(diff::diff_slices(diff::split_lines(before), diff::split_lines(after), diff::Algorithm::Histogram)), "20-23:20-20")
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -18,9 +18,6 @@\n \n \n \n-\n-\n-fn f() {\n \n \n         return;\n")
}

///|
/// [P0] header line edited + one blank added to a 40-blank run: wrong hunk position AND trailing context cut to 1 line
test "p0_window_header_edit_plus_blank_run_unified" {
  let before = "// v1\n    stmt_0();\n    stmt_1();\n    stmt_2();\n    stmt_3();\n    stmt_4();\n    stmt_5();\n    stmt_6();\n    stmt_7();\n    stmt_8();\n    stmt_9();\n    stmt_10();\n    stmt_11();\n    stmt_12();\n    stmt_13();\n    stmt_14();\n    stmt_15();\n    stmt_16();\n    stmt_17();\n    stmt_18();\n    stmt_19();\n    stmt_20();\n    stmt_21();\n    stmt_22();\n    stmt_23();\n    stmt_24();\n    stmt_25();\n    stmt_26();\n    stmt_27();\n    stmt_28();\n    stmt_29();\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    stmt_0();\n    stmt_1();\n    stmt_2();\n    stmt_3();\n    stmt_4();\n    stmt_5();\n    stmt_6();\n    stmt_7();\n    stmt_8();\n    stmt_9();\n    stmt_10();\n    stmt_11();\n    stmt_12();\n    stmt_13();\n    stmt_14();\n    stmt_15();\n    stmt_16();\n    stmt_17();\n    stmt_18();\n    stmt_19();\n    stmt_20();\n    stmt_21();\n    stmt_22();\n    stmt_23();\n    stmt_24();\n    stmt_25();\n    stmt_26();\n    stmt_27();\n    stmt_28();\n    stmt_29();\n"
  let after = "// v2\n    stmt_0();\n    stmt_1();\n    stmt_2();\n    stmt_3();\n    stmt_4();\n    stmt_5();\n    stmt_6();\n    stmt_7();\n    stmt_8();\n    stmt_9();\n    stmt_10();\n    stmt_11();\n    stmt_12();\n    stmt_13();\n    stmt_14();\n    stmt_15();\n    stmt_16();\n    stmt_17();\n    stmt_18();\n    stmt_19();\n    stmt_20();\n    stmt_21();\n    stmt_22();\n    stmt_23();\n    stmt_24();\n    stmt_25();\n    stmt_26();\n    stmt_27();\n    stmt_28();\n    stmt_29();\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    stmt_0();\n    stmt_1();\n    stmt_2();\n    stmt_3();\n    stmt_4();\n    stmt_5();\n    stmt_6();\n    stmt_7();\n    stmt_8();\n    stmt_9();\n    stmt_10();\n    stmt_11();\n    stmt_12();\n    stmt_13();\n    stmt_14();\n    stmt_15();\n    stmt_16();\n    stmt_17();\n    stmt_18();\n    stmt_19();\n    stmt_20();\n    stmt_21();\n    stmt_22();\n    stmt_23();\n    stmt_24();\n    stmt_25();\n    stmt_26();\n    stmt_27();\n    stmt_28();\n    stmt_29();\n"
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -1,4 +1,4 @@\n-// v1\n+// v2\n     stmt_0();\n     stmt_1();\n     stmt_2();\n@@ -67,6 +67,7 @@\n \n \n \n+\n \n \n     stmt_0();\n")
  expect_eq("unified_diff Myers ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Myers), "@@ -1,4 +1,4 @@\n-// v1\n+// v2\n     stmt_0();\n     stmt_1();\n     stmt_2();\n@@ -67,6 +67,7 @@\n \n \n \n+\n \n \n     stmt_0();\n")
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-1:0-1 69-69:69-70")
}

///|
/// [P0] context >= 21 makes margin == ctx; a hunk that slid into the stripped suffix loses a trailing context line
test "p0_unified_ctx25_trailing_context_truncated" {
  let before = "\n}\nb\na\n{\nb\na\n\na\n}\nb\n}\n  x\nb\n\nc\na\n}\n\nb\n}\n\nc\n{\n{\n{\n{\na\n"
  let after = "}\nb\nb\na\n{\nb\na\n\na\n}\nb\n}\n  x\nb\n\nc\na\n}\n\nb\n}\n\nc\n{\n{\n{\n{\na\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-1:0-0 3-3:2-3")
  expect_eq("unified_diff Histogram ctx=25", diff::unified_diff(before, after, "", "", 25, diff::Algorithm::Histogram), "@@ -1,28 +1,28 @@\n-\n }\n b\n+b\n a\n {\n b\n a\n \n a\n }\n b\n }\n   x\n b\n \n c\n a\n }\n \n b\n }\n \n c\n {\n {\n {\n {\n a\n")
  expect_eq("unified_diff Myers ctx=25", diff::unified_diff(before, after, "", "", 25, diff::Algorithm::Myers), "@@ -1,28 +1,28 @@\n-\n }\n b\n+b\n a\n {\n b\n a\n \n a\n }\n b\n }\n   x\n b\n \n c\n a\n }\n \n b\n }\n \n c\n {\n {\n {\n {\n a\n")
}

///|
/// [P1] Myers port deviates from imara (is_odd / common-line pruning) on a 7-line input
test "p1_myers_postprocessed_small" {
  let before = "c\n}\nc\nc\na\n}\na\n"
  let after = "a\n}\nc\na\na\n}\nc\na\n"
  expect_eq("diff_lines Myers", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Myers)), "0-1:0-1 3-4:3-4 6-6:6-7")
  expect_eq("diff_slices Myers", hunks_str(diff::diff_slices(diff::split_lines(before), diff::split_lines(after), diff::Algorithm::Myers)), "0-1:0-1 3-4:3-4 6-6:6-7")
  expect_eq("unified_diff Myers ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Myers), "@@ -1,7 +1,8 @@\n-c\n+a\n }\n c\n-c\n+a\n a\n }\n+c\n a\n")
}

///|
/// [P1] raw Myers hunks differ (no postprocessing involved)
test "p1_myers_raw_small" {
  let before = "\n\tz();\n\tz();\n\tz();\n\n\n"
  let after = "\tz();\n\n\tz();\n"
  expect_eq("diff_lines_raw Myers", hunks_str(diff::diff_lines_raw(before, after, diff::Algorithm::Myers)), "0-2:0-0 3-4:1-1 5-6:2-3")
}

///|
/// [P1] raw Myers hunks differ
test "p1_myers_raw_mixed" {
  let before = "b\n  x\n}\n\n  x\n"
  let after = "  x\n\n}\n}\n\n"
  expect_eq("diff_lines_raw Myers", hunks_str(diff::diff_lines_raw(before, after, diff::Algorithm::Myers)), "0-1:0-0 2-2:1-2 3-3:3-4 4-5:5-5")
}

///|
/// [P1] >63-occurrence Histogram fallback inherits the Myers deviation (192-line x/y/blank input)
test "p1_histogram_myers_fallback_raw" {
  let before = "x\ny\ny\n\n\n\ny\ny\n\n\ny\n\ny\ny\n\n\ny\nx\ny\n\n\n\ny\n\nx\n\nx\ny\ny\ny\ny\n\nx\nx\n\nx\nx\nx\n\n\n\nx\n\ny\n\ny\ny\n\n\n\ny\nx\ny\nx\nx\nx\nx\n\ny\n\nx\nx\ny\nx\nx\ny\ny\n\n\ny\n\n\ny\nx\n\n\n\ny\nx\nx\nx\n\n\n\nx\n\nx\nx\nx\n\nx\n\ny\n\n\n\nx\n\nx\nx\nx\nx\ny\ny\ny\ny\ny\n\nx\ny\nx\nx\n\n\nx\n\n\nx\ny\ny\ny\nx\ny\ny\nx\n\ny\n\nx\ny\ny\n\ny\n\nx\nx\nx\ny\n\n\nx\n\ny\ny\ny\ny\nx\nx\ny\ny\n\nx\ny\ny\nx\nx\ny\nx\ny\nx\n\nx\ny\nx\nx\ny\nx\n\ny\nx\nx\n\n\n\nx\n\nx\n\ny\ny\ny\nx\n\nx\ny\ny\nx\nx\n\ny\ny\ny\n"
  let after = "\ny\n\ny\ny\n\n\ny\ny\n\n\n\ny\n\n\ny\ny\ny\ny\n\nx\n\nx\nx\nx\n\n\n\ny\n\ny\n\n\n\ny\nx\ny\nx\nx\nx\nx\n\ny\n\nx\nx\ny\nx\nx\ny\ny\n\n\ny\n\n\ny\nx\n\n\ny\nx\nx\nx\n\n\n\nx\n\nx\nx\nx\n\n\ny\n\n\n\nx\n\nx\nx\nx\ny\ny\ny\ny\nx\ny\nx\nx\n\n\nx\n\ny\ny\ny\nx\ny\nx\n\ny\n\nx\ny\ny\n\ny\n\nx\nx\nx\ny\n\n\nx\n\ny\ny\ny\ny\nx\nx\ny\n\nx\ny\nx\nx\ny\nx\ny\n\nx\ny\nx\nx\ny\nx\n\ny\nx\nx\n\n\n\nx\n\nx\n\ny\ny\ny\nx\n\nx\ny\ny\nx\nx\n"
  expect_eq("diff_lines_raw Histogram", hunks_str(diff::diff_lines_raw(before, after, diff::Algorithm::Histogram)), "0-9:0-0 17-18:8-8 24-25:14-14 26-27:15-15 32-33:20-20 40-42:27-27 46-47:31-31 74-75:58-58 90-91:73-73 98-99:80-80 106-108:87-87 116-118:95-95 123-124:100-100 148-149:124-124 153-154:128-128 159-160:133-133 188-192:161-161")
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-9:0-0 17-18:8-8 24-25:14-14 26-27:15-15 32-33:20-20 41-43:28-28 46-47:31-31 76-77:60-60 90-91:73-73 101-102:83-83 106-108:87-87 116-118:95-95 123-124:100-100 149-150:125-125 153-154:128-128 159-160:133-133 188-192:161-161")
}

///|
/// [P1] imara prints -1,0 for an empty side; Pion prints -0,0 (GNU style)
test "p1_unified_empty_before_header" {
  let before = ""
  let after = "a\n"
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -1,0 +1,1 @@\n+a\n")
}

///|
/// [P1] context 0 pure insertion header start
test "p1_unified_ctx0_pure_insertion_header" {
  let before = "a\nb\n"
  let after = "a\nx\nb\n"
  expect_eq("unified_diff Histogram ctx=0", diff::unified_diff(before, after, "", "", 0, diff::Algorithm::Histogram), "@@ -2,0 +2,1 @@\n+x\n")
  expect_eq("unified_diff Myers ctx=0", diff::unified_diff(before, after, "", "", 0, diff::Algorithm::Myers), "@@ -2,0 +2,1 @@\n+x\n")
}

///|
/// [P1] imara's BasicLineDiffPrinter prints a bare newline, Pion adds '\ No newline at end of file'
test "p1_unified_no_newline_marker" {
  let before = "a\n"
  let after = "b"
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -1,1 +1,1 @@\n-a\n+b\n")
}

///|
/// [P2] imara quirk: first hunk with ctx < start <= 2*ctx prints context from line 1 under a -(start-ctx+1) header; Pion prints the GNU-correct hunk
test "p2_unified_first_hunk_context_imara_quirk" {
  let before = "l0\nl1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\n"
  let after = "l0\nl1\nl2\nl3\nl4\nL5\nl6\nl7\nl8\nl9\n"
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -3,9 +3,9 @@\n l0\n l1\n l2\n l3\n l4\n-l5\n+L5\n l6\n l7\n l8\n")
}

///|
test "ok_empty_vs_empty" {
  let before = ""
  let after = ""
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "")
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "")
}

///|
/// [ok] CRLF and LF lines are different tokens in both
test "ok_crlf_vs_lf" {
  let before = "a\r\nb\r\nc\r\n"
  let after = "a\nb\r\nc\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-1:0-1 2-3:2-3")
  expect_eq("diff_lines Myers", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Myers)), "0-1:0-1 2-3:2-3")
}

///|
test "ok_only_newlines" {
  let before = "\n"
  let after = "\r\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "0-1:0-1")
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -1,1 +1,1 @@\n-\n+\r\n")
}

///|
test "ok_multibyte_utf8" {
  let before = "日本語\nçé\n🙂\n"
  let after = "日本語\nce\n🙂\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "1-2:1-2")
  expect_eq("unified_diff Histogram ctx=3", diff::unified_diff(before, after, "", "", 3, diff::Algorithm::Histogram), "@@ -1,3 +1,3 @@\n 日本語\n-çé\n+ce\n 🙂\n")
  expect_eq("unified_diff Myers ctx=1", diff::unified_diff(before, after, "", "", 1, diff::Algorithm::Myers), "@@ -1,3 +1,3 @@\n 日本語\n-çé\n+ce\n 🙂\n")
}

///|
/// [ok] hunks only (unified differs by the marker)
test "ok_add_trailing_newline_only" {
  let before = "a\nb"
  let after = "a\nb\n"
  expect_eq("diff_lines Histogram", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Histogram)), "1-2:1-2")
  expect_eq("diff_lines Myers", hunks_str(diff::diff_lines(before, after, diff::Algorithm::Myers)), "1-2:1-2")
}
