///| Red-team runner: dumps Pion `packages/diff` results in the exact format of
///| `../rust_oracle` (real Rust `imara-diff v0.2.0`) so the two can be compared byte-for-byte.
///|
///| usage: runner cases <cases.bin>
///|        runner bench <before> <after> <myers|histogram> <iters> [ctx]
///|        runner multi <before> <iters> <after>...
///|        runner merge <cases3.bin>

import "diff"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut acc = 0
  let mut i = start
  while i < end {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn hunks_str(sb : StringBuilder, res : diff::DiffResult) -> Unit {
  let mut i = 0
  while i < res.hunks.length() {
    let h = res.hunks[i]
    if i > 0 {
      sb.write_string(" ")
    }
    sb.write_string(h.before_start.to_string())
    sb.write_string("-")
    sb.write_string(h.before_end.to_string())
    sb.write_string(":")
    sb.write_string(h.after_start.to_string())
    sb.write_string("-")
    sb.write_string(h.after_end.to_string())
    i = i + 1
  }
}

///|
fn dump_case(sb : StringBuilder, idx : Int, before : String, after : String) -> Unit {
  sb.write_string("#")
  sb.write_string(idx.to_string())
  sb.write_string("\n")
  let tags = ["H", "M"]
  let algos = [diff::Algorithm::Histogram, diff::Algorithm::Myers]
  let ctxs = [0, 1, 3, 25]
  let mut k = 0
  while k < 2 {
    let tag = tags[k]
    let algo = algos[k]
    sb.write_string(tag)
    sb.write_string("P ")
    hunks_str(sb, diff::diff_lines(before, after, algo))
    sb.write_string("\n")
    sb.write_string(tag)
    sb.write_string("R ")
    hunks_str(sb, diff::diff_lines_raw(before, after, algo))
    sb.write_string("\n")
    sb.write_string(tag)
    sb.write_string("S ")
    hunks_str(
      sb,
      diff::diff_slices(diff::split_lines(before), diff::split_lines(after), algo),
    )
    sb.write_string("\n")
    let mut c = 0
    while c < ctxs.length() {
      let u = diff::unified_diff(before, after, "", "", ctxs[c], algo)
      sb.write_string(tag)
      sb.write_string("U")
      sb.write_string(ctxs[c].to_string())
      sb.write_string(" ")
      sb.write_string(u.length().to_string())
      sb.write_string("\n")
      sb.write_string(u)
      c = c + 1
    }
    k = k + 1
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: runner cases <file> | bench <before> <after> <algo> <iters> [ctx]")
    return 2
  }
  if args[1] == "merge" {
    // framing: `<base_len> <ours_len> <theirs_len>\n<base><ours><theirs>`;
    // output per case: `#<i> <C|K> <len>\n<merged text>` (C = conflicts, K = clean)
    let buf = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 1
    }
    let sb = StringBuilder::new()
    let n = buf.length()
    let mut p = 0
    let mut idx = 0
    while p < n {
      let mut s1 = p
      while buf.code_unit_at(s1) != 32 {
        s1 = s1 + 1
      }
      let mut s2 = s1 + 1
      while buf.code_unit_at(s2) != 32 {
        s2 = s2 + 1
      }
      let mut nl = s2
      while buf.code_unit_at(nl) != 10 {
        nl = nl + 1
      }
      let l0 = parse_dec(buf, p, s1)
      let l1 = parse_dec(buf, s1 + 1, s2)
      let l2 = parse_dec(buf, s2 + 1, nl)
      let s = nl + 1
      let res = diff::merge3(
        buf.slice(s, s + l0),
        buf.slice(s + l0, s + l0 + l1),
        buf.slice(s + l0 + l1, s + l0 + l1 + l2),
      )
      let text = res.to_string()
      sb.write_string("#")
      sb.write_string(idx.to_string())
      sb.write_string(if res.has_conflicts { " C " } else { " K " })
      sb.write_string(text.length().to_string())
      sb.write_string("\n")
      sb.write_string(text)
      idx = idx + 1
      p = s + l0 + l1 + l2
    }
    io_print(world, sb.to_string())
    return 0
  }
  if args[1] == "cases" {
    let buf = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => {
        io_println(world, "error: read cases")
        return 1
      }
    }
    let sb = StringBuilder::new()
    let n = buf.length()
    let mut p = 0
    let mut idx = 0
    while p < n {
      let mut sp = p
      while buf.code_unit_at(sp) != 32 {
        sp = sp + 1
      }
      let mut nl = sp
      while buf.code_unit_at(nl) != 10 {
        nl = nl + 1
      }
      let bl = parse_dec(buf, p, sp)
      let al = parse_dec(buf, sp + 1, nl)
      let s = nl + 1
      let before = buf.slice(s, s + bl)
      let after = buf.slice(s + bl, s + bl + al)
      dump_case(sb, idx, before, after)
      idx = idx + 1
      p = s + bl + al
    }
    io_print(world, sb.to_string())
    return 0
  }
  let before = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => return 1
  }
  if args[1] == "multi" {
    // Pion has no interner-reuse API: every pair is re-interned from scratch.
    let iters = parse_dec(args[3], 0, args[3].length())
    let afters : Array[String] = Array::new()
    let mut k = 4
    while k < args.length() {
      match fs_read(world, args[k]) {
        Ok(s) => afters.push(s)
        Err(_) => return 1
      }
      k = k + 1
    }
    let mut total : Int64 = 0L
    let mut last = ""
    let mut it = 0
    while it < iters {
      let mut j = 0
      while j < afters.length() {
        let out = diff::unified_diff(
          before,
          afters[j],
          "",
          "",
          3,
          diff::Algorithm::Histogram,
        )
        total = total + out.length().to_int64()
        last = out
        j = j + 1
      }
      it = it + 1
    }
    io_println(world, "iters=" + iters.to_string() + " total_bytes=" + total.to_string())
    io_print(world, last)
    return 0
  }
  let after = match fs_read(world, args[3]) {
    Ok(s) => s
    Err(_) => return 1
  }
  let algo = if args[4] == "myers" {
    diff::Algorithm::Myers
  } else {
    diff::Algorithm::Histogram
  }
  let iters = parse_dec(args[5], 0, args[5].length())
  let ctx = if args.length() > 6 {
    parse_dec(args[6], 0, args[6].length())
  } else {
    3
  }
  let mut total : Int64 = 0L
  let mut last = ""
  let mut i = 0
  while i < iters {
    let out = diff::unified_diff(before, after, "", "", ctx, algo)
    total = total + out.length().to_int64()
    last = out
    i = i + 1
  }
  io_println(world, "iters=" + iters.to_string() + " total_bytes=" + total.to_string())
  io_print(world, last)
  0
}
