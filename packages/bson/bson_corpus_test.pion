///| MongoDB BSON 1.1 Corpus & Extended JSON v2 specification compliance tests.

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length()
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

fn bytes_to_hex(b : Bytes) -> String {
  let lut = "0123456789abcdef"
  let out = Bytes::new(b.length() * 2)
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    out[i * 2] = lut.code_unit_at(v >> 4).to_byte()
    out[i * 2 + 1] = lut.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

fn assert_bson_roundtrip(hex : String, canon_json : String, relaxed_json : String) -> Unit {
  let raw = hex_to_bytes(hex)
  let doc = match decode(raw) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "decode failed for " + hex + ": " + error_message(e))
      return
    }
  }
  let reenc = match encode(doc) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode failed for " + hex + ": " + error_message(e))
      return
    }
  }
  debug_assert(
    bytes_equal(raw, reenc),
    "BSON roundtrip mismatch: expected " + hex + ", got " + bytes_to_hex(reenc),
  )
  let got_canon = match to_extjson(doc, ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_extjson(Canonical) failed: " + error_message(e))
      return
    }
  }
  debug_assert(
    got_canon == canon_json,
    "Canonical ExtJSON mismatch: expected " + canon_json + ", got " + got_canon,
  )
  let got_relaxed = match to_extjson(doc, ExtJsonMode::Relaxed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_extjson(Relaxed) failed: " + error_message(e))
      return
    }
  }
  debug_assert(
    got_relaxed == relaxed_json,
    "Relaxed ExtJSON mismatch: expected " + relaxed_json + ", got " + got_relaxed,
  )
  let from_canon = match from_extjson(canon_json) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "from_extjson(Canonical) failed: " + error_message(e))
      return
    }
  }
  debug_assert(
    bson_doc_eq(doc, from_canon),
    "Canonical ExtJSON parse did not reproduce document for " + canon_json,
  )
}

test "corpus_empty_document" {
  assert_bson_roundtrip("0500000000", "{}", "{}")
}

test "corpus_double_values" {
  assert_bson_roundtrip(
    "10000000017800000000000000f03f00",
    "{\"x\":{\"$numberDouble\":\"1.0\"}}",
    "{\"x\":1.0}",
  )
  assert_bson_roundtrip(
    "10000000017800000000000000008000",
    "{\"x\":{\"$numberDouble\":\"-0.0\"}}",
    "{\"x\":-0.0}",
  )
  assert_bson_roundtrip(
    "10000000017800000000000000f07f00",
    "{\"x\":{\"$numberDouble\":\"Infinity\"}}",
    "{\"x\":{\"$numberDouble\":\"Infinity\"}}",
  )
  assert_bson_roundtrip(
    "10000000017800000000000000f0ff00",
    "{\"x\":{\"$numberDouble\":\"-Infinity\"}}",
    "{\"x\":{\"$numberDouble\":\"-Infinity\"}}",
  )
  assert_bson_roundtrip(
    "10000000017800000000000000f87f00",
    "{\"x\":{\"$numberDouble\":\"NaN\"}}",
    "{\"x\":{\"$numberDouble\":\"NaN\"}}",
  )
}

test "corpus_string_and_utf8" {
  assert_bson_roundtrip(
    "0d000000026100010000000000",
    "{\"a\":\"\"}",
    "{\"a\":\"\"}",
  )
  assert_bson_roundtrip(
    "0e00000002610002000000620000",
    "{\"a\":\"b\"}",
    "{\"a\":\"b\"}",
  )
  // Multi-byte UTF-8: "é" (c3 a9) + "😀" (f0 9f 98 80)
  let doc = BsonDocument::from_entries([("u", BsonValue::Str("café 😀\n\t\"\\"))])
  let enc = match encode(doc) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let dec = match decode(enc) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(bson_doc_eq(doc, dec), "UTF-8 string roundtrip failed")
  let ej = match to_extjson(doc, ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let parsed = match from_extjson(ej) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(bson_doc_eq(doc, parsed), "UTF-8 ExtJSON roundtrip failed")
}

test "corpus_embedded_document_and_array" {
  assert_bson_roundtrip(
    "0d000000036100050000000000",
    "{\"a\":{}}",
    "{\"a\":{}}",
  )
  assert_bson_roundtrip(
    "1b0000000461001300000010300001000000103100020000000000",
    "{\"a\":[{\"$numberInt\":\"1\"},{\"$numberInt\":\"2\"}]}",
    "{\"a\":[1,2]}",
  )
}

test "corpus_binary_all_subtypes_0_to_9_and_user" {
  // 0x00 Generic
  assert_bson_roundtrip(
    "0f0000000578000200000000010200",
    "{\"x\":{\"$binary\":{\"base64\":\"AQI=\",\"subType\":\"00\"}}}",
    "{\"x\":{\"$binary\":{\"base64\":\"AQI=\",\"subType\":\"00\"}}}",
  )
  // 0x02 BinaryOld (with inner 4-byte length prefix)
  assert_bson_roundtrip(
    "13000000057800060000000202000000010200",
    "{\"x\":{\"$binary\":{\"base64\":\"AQI=\",\"subType\":\"02\"}}}",
    "{\"x\":{\"$binary\":{\"base64\":\"AQI=\",\"subType\":\"02\"}}}",
  )
  // 0x04 UUID
  assert_bson_roundtrip(
    "1d000000057800100000000400112233445566778899aabbccddeeff00",
    "{\"x\":{\"$binary\":{\"base64\":\"ABEiM0RVZneImaq7zN3u/w==\",\"subType\":\"04\"}}}",
    "{\"x\":{\"$binary\":{\"base64\":\"ABEiM0RVZneImaq7zN3u/w==\",\"subType\":\"04\"}}}",
  )
  // Parse $uuid ExtJSON sugar -> Binary(Uuid, 16 bytes)
  let uuid_doc = match from_extjson("{\"x\":{\"$uuid\":\"00112233-4455-6677-8899-aabbccddeeff\"}}") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "$uuid parse failed: " + error_message(e))
      return
    }
  }
  let uuid_enc = match encode(uuid_doc) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(
    bytes_to_hex(uuid_enc) == "1d000000057800100000000400112233445566778899aabbccddeeff00",
    "$uuid did not encode to Binary subtype 0x04",
  )

  // Subtypes 0x01, 0x03, 0x05, 0x06, 0x07, 0x08, 0x09, 0x80
  let subtypes : Array[BinarySubtype] = [
    BinarySubtype::Function,
    BinarySubtype::UuidOld,
    BinarySubtype::Md5,
    BinarySubtype::Encrypted,
    BinarySubtype::Column,
    BinarySubtype::Sensitive,
    BinarySubtype::Vector,
    BinarySubtype::UserDefined(0x80),
  ]
  let payload = hex_to_bytes("deadbeef")
  let mut i = 0
  while i < subtypes.length() {
    let sub = subtypes[i]
    let d = BsonDocument::from_entries([("b", BsonValue::Binary(sub, payload))])
    let enc = match encode(d) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, "subtype encode failed: " + error_message(e))
        return
      }
    }
    let dec = match decode(enc) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "subtype decode failed: " + error_message(e))
        return
      }
    }
    debug_assert(bson_doc_eq(d, dec), "binary subtype roundtrip mismatch")
    let ej = match to_extjson(d, ExtJsonMode::Canonical) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, error_message(e))
        return
      }
    }
    let dec_ej = match from_extjson(ej) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, error_message(e))
        return
      }
    }
    debug_assert(bson_doc_eq(d, dec_ej), "binary subtype ExtJSON roundtrip mismatch")
    i = i + 1
  }
}

test "corpus_objectid_and_methods" {
  assert_bson_roundtrip(
    "1400000007610056e1fc72e0c917e9c471416100",
    "{\"a\":{\"$oid\":\"56e1fc72e0c917e9c4714161\"}}",
    "{\"a\":{\"$oid\":\"56e1fc72e0c917e9c4714161\"}}",
  )
  let oid1 = match ObjectId::from_hex("56E1FC72E0C917E9C4714161") {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(oid1.to_hex() == "56e1fc72e0c917e9c4714161", "lowercase hex normalization")
  // 0x56e1fc72 = 1457650802
  debug_assert(oid1.timestamp_seconds() == 1457650802L, "timestamp_seconds mismatch")
  let oid2 = match ObjectId::from_hex("56e1fc72e0c917e9c4714162") {
    Ok(o) => o
    Err(_) => {
      debug_assert(false, "oid2 failed")
      return
    }
  }
  debug_assert(oid1.compare(oid2) == -1, "oid1 < oid2")
  debug_assert(oid2.compare(oid1) == 1, "oid2 > oid1")
  debug_assert(oid1.compare(oid1) == 0, "oid1 == oid1")
  debug_assert(oid1.eq(oid1), "oid1 eq oid1")
  debug_assert(!oid1.eq(oid2), "oid1 != oid2")
}

test "corpus_boolean_null_undefined_minkey_maxkey" {
  assert_bson_roundtrip("090000000862000100", "{\"b\":true}", "{\"b\":true}")
  assert_bson_roundtrip("090000000862000000", "{\"b\":false}", "{\"b\":false}")
  assert_bson_roundtrip("080000000a610000", "{\"a\":null}", "{\"a\":null}")
  assert_bson_roundtrip(
    "0800000006780000",
    "{\"x\":{\"$undefined\":true}}",
    "{\"x\":{\"$undefined\":true}}",
  )
  assert_bson_roundtrip(
    "08000000ff610000",
    "{\"a\":{\"$minKey\":1}}",
    "{\"a\":{\"$minKey\":1}}",
  )
  assert_bson_roundtrip(
    "080000007f610000",
    "{\"a\":{\"$maxKey\":1}}",
    "{\"a\":{\"$maxKey\":1}}",
  )
}

test "corpus_datetime_epoch_positive_negative_y9999_y10000" {
  // Epoch 0 -> Relaxed ISO-8601 without fractional seconds
  assert_bson_roundtrip(
    "10000000096100000000000000000000",
    "{\"a\":{\"$date\":{\"$numberLong\":\"0\"}}}",
    "{\"a\":{\"$date\":\"1970-01-01T00:00:00Z\"}}",
  )
  // 2012-12-24T12:15:30.501Z (ms = 1356351330501)
  assert_bson_roundtrip(
    "1000000009610005e941cc3b01000000",
    "{\"a\":{\"$date\":{\"$numberLong\":\"1356351330501\"}}}",
    "{\"a\":{\"$date\":\"2012-12-24T12:15:30.501Z\"}}",
  )
  // Negative pre-1970 (-1000 ms) -> Relaxed falls back to $numberLong
  assert_bson_roundtrip(
    "1000000009610018fcffffffffffff00",
    "{\"a\":{\"$date\":{\"$numberLong\":\"-1000\"}}}",
    "{\"a\":{\"$date\":{\"$numberLong\":\"-1000\"}}}",
  )
  // Year 9999-12-31T23:59:59.999Z (ms = 253402300799999)
  let y9999 = BsonDocument::from_entries([("d", BsonValue::DateTime(253402300799999L))])
  let y9999_rel = match to_extjson(y9999, ExtJsonMode::Relaxed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(
    y9999_rel == "{\"d\":{\"$date\":\"9999-12-31T23:59:59.999Z\"}}",
    "Y9999 relaxed mismatch: " + y9999_rel,
  )
  let y9999_back = match from_extjson(y9999_rel) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(bson_doc_eq(y9999, y9999_back), "Y9999 roundtrip failed")

  // Year 10000 (ms = 253402300800000) -> Relaxed falls back to $numberLong
  let y10000 = BsonDocument::from_entries([("d", BsonValue::DateTime(253402300800000L))])
  let y10000_rel = match to_extjson(y10000, ExtJsonMode::Relaxed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(
    y10000_rel == "{\"d\":{\"$date\":{\"$numberLong\":\"253402300800000\"}}}",
    "Y10000 relaxed mismatch: " + y10000_rel,
  )
}

test "corpus_regex_dbpointer_javascript_symbol_codewscope" {
  assert_bson_roundtrip(
    "0f0000000b610061626300696d0000",
    "{\"a\":{\"$regularExpression\":{\"pattern\":\"abc\",\"options\":\"im\"}}}",
    "{\"a\":{\"$regularExpression\":{\"pattern\":\"abc\",\"options\":\"im\"}}}",
  )
  assert_bson_roundtrip(
    "1d0000000c61000500000064622e630056e1fc72e0c917e9c471416100",
    "{\"a\":{\"$dbPointer\":{\"$ref\":\"db.c\",\"$id\":{\"$oid\":\"56e1fc72e0c917e9c4714161\"}}}}",
    "{\"a\":{\"$dbPointer\":{\"$ref\":\"db.c\",\"$id\":{\"$oid\":\"56e1fc72e0c917e9c4714161\"}}}}",
  )
  assert_bson_roundtrip(
    "0e0000000d610002000000780000",
    "{\"a\":{\"$code\":\"x\"}}",
    "{\"a\":{\"$code\":\"x\"}}",
  )
  assert_bson_roundtrip(
    "0e0000000e610002000000730000",
    "{\"a\":{\"$symbol\":\"s\"}}",
    "{\"a\":{\"$symbol\":\"s\"}}",
  )
  assert_bson_roundtrip(
    "170000000f61000f000000020000007800050000000000",
    "{\"a\":{\"$code\":\"x\",\"$scope\":{}}}",
    "{\"a\":{\"$code\":\"x\",\"$scope\":{}}}",
  )
}

test "corpus_int32_timestamp_int64" {
  assert_bson_roundtrip(
    "0c0000001069002a00000000",
    "{\"i\":{\"$numberInt\":\"42\"}}",
    "{\"i\":42}",
  )
  // Timestamp wire order: increment=42 (2a000000), time=123456789 (15cd5b07)
  assert_bson_roundtrip(
    "100000001174002a00000015cd5b0700",
    "{\"t\":{\"$timestamp\":{\"t\":123456789,\"i\":42}}}",
    "{\"t\":{\"$timestamp\":{\"t\":123456789,\"i\":42}}}",
  )
  assert_bson_roundtrip(
    "100000001261002a0000000000000000",
    "{\"a\":{\"$numberLong\":\"42\"}}",
    "{\"a\":42}",
  )
  // Exact 64-bit integer precision beyond 2^53 in Relaxed Extended JSON
  let big_doc = BsonDocument::from_entries([
    ("max", BsonValue::Int64(9223372036854775807L)),
    ("min", BsonValue::Int64(-9223372036854775807L - 1L)),
  ])
  let big_rel = match to_extjson(big_doc, ExtJsonMode::Relaxed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(
    big_rel == "{\"max\":9223372036854775807,\"min\":-9223372036854775808}",
    "Relaxed i64 precision mismatch: " + big_rel,
  )
  let big_back = match from_extjson(big_rel) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(bson_doc_eq(big_doc, big_back), "Relaxed i64 exact parse failed")
}

test "corpus_relaxed_extjson_number_typing" {
  // Bare integer fitting i32 -> Int32, beyond i32 -> Int64, float -> Double
  let parsed = match from_extjson("{\"i32\":42,\"i64\":2147483648,\"f\":1.0,\"f2\":1.5e2}") {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let expected = BsonDocument::from_entries([
    ("i32", BsonValue::Int32(42)),
    ("i64", BsonValue::Int64(2147483648L)),
    ("f", BsonValue::Double(1.0)),
    ("f2", BsonValue::Double(150.0)),
  ])
  debug_assert(bson_doc_eq(parsed, expected), "Relaxed number typing mismatch")
}
