///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/bson`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "bson"

fn fnv1a_64_bytes(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  let oid = match bson::ObjectId::from_hex("65a4f8b2e1c9d04a7b123456") {
    Ok(v) => v
    Err(_) => return 1
  }
  let dec = match bson::Decimal128::from_string("12345678901234567890.12345678901234") {
    Ok(v) => v
    Err(_) => return 2
  }
  let uuid_bytes = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    uuid_bytes[i] = (i * 17).to_byte()
    i = i + 1
  }
  let sub = bson::BsonDocument::from_entries([
    ("region", bson::BsonValue::Str("ap-northeast-1")),
    ("score", bson::BsonValue::Double(99.5)),
    ("active", bson::BsonValue::Bool(true)),
  ])
  let doc = bson::BsonDocument::from_entries([
    ("_id", bson::BsonValue::ObjectId(oid)),
    ("amount", bson::BsonValue::Decimal128(dec)),
    ("created_at", bson::BsonValue::DateTime(1705322096789L)),
    ("count", bson::BsonValue::Int64(9007199254740993L)),
    ("flags", bson::BsonValue::Int32(7)),
    ("uuid", bson::BsonValue::Binary(bson::BinarySubtype::Uuid, uuid_bytes)),
    ("meta", bson::BsonValue::Document(sub)),
    (
      "tags",
      bson::BsonValue::Array([
        bson::BsonValue::Str("bson"),
        bson::BsonValue::Str("pion"),
        bson::BsonValue::Null,
      ]),
    ),
    ("ts", bson::BsonValue::Timestamp(1705322096L, 42L)),
    ("re", bson::BsonValue::Regex("^ok$", "im")),
    ("min", bson::BsonValue::MinKey),
    ("max", bson::BsonValue::MaxKey),
  ])

  let encoded = match bson::encode(doc) {
    Ok(b) => b
    Err(_) => return 3
  }
  let decoded = match bson::decode(encoded) {
    Ok(d) => d
    Err(_) => return 4
  }
  if !bson::bson_doc_eq(doc, decoded) {
    return 5
  }
  let canon = match bson::to_extjson(decoded, bson::ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(_) => return 6
  }
  let relaxed = match bson::to_extjson(decoded, bson::ExtJsonMode::Relaxed) {
    Ok(s) => s
    Err(_) => return 7
  }
  let from_c = match bson::from_extjson(canon) {
    Ok(d) => d
    Err(_) => return 8
  }
  if !bson::bson_doc_eq(doc, from_c) {
    return 9
  }
  let reenc = match bson::encode(from_c) {
    Ok(b) => b
    Err(_) => return 10
  }
  if !bson::bytes_equal(encoded, reenc) {
    return 11
  }

  io_println(world, "bson_wasm_smoke:ok")
  io_println(
    world,
    "bytes=" + encoded.length().to_string() +
    " bson_fnv64=" + hex_u64(fnv1a_64_bytes(encoded)) +
    " canon_fnv64=" + hex_u64(fnv1a_64_str(canon)) +
    " relaxed_fnv64=" + hex_u64(fnv1a_64_str(relaxed)),
  )
  0
}
