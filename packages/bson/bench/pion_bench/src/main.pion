///| Head-to-head BSON 1.1 & Extended JSON v2 benchmark runner (Pion Native).

import "bson"

fn read_i32_le(data : Bytes, pos : Int) -> Int {
  let b0 = data[pos].to_int()
  let b1 = data[pos + 1].to_int()
  let b2 = data[pos + 2].to_int()
  let b3 = data[pos + 3].to_int()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn split_corpus(data : Bytes) -> Array[Bytes] {
  let docs : Array[Bytes] = []
  let n = data.length()
  let mut pos = 0
  while pos + 4 <= n {
    let dlen = read_i32_le(data, pos)
    if dlen < 5 || pos + dlen > n {
      break
    }
    let slice = Bytes::new(dlen)
    let mut i = 0
    while i < dlen {
      slice[i] = data[pos + i]
      i = i + 1
    }
    docs.push(slice)
    pos = pos + dlen
  }
  docs
}

fn fnv_update_bytes(h0 : UInt64, b : Bytes) -> UInt64 {
  let mut h = h0
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn fnv_update_str(h0 : UInt64, s : String) -> UInt64 {
  let mut h = h0
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn fnv_update_u64(h0 : UInt64, v : UInt64) -> UInt64 {
  (h0 ^ v) * 1099511628211UL
}

fn walk_doc_checksum(doc : bson::BsonDocument) -> (Int64, UInt64) {
  let mut elems : Int64 = 0L
  let mut h : UInt64 = 14695981039346656037UL
  let stack : Array[bson::BsonValue] = [bson::BsonValue::Document(doc)]
  while stack.length() > 0 {
    let cur = match stack.pop() {
      Some(v) => v
      None => break
    }
    match cur {
      bson::BsonValue::Document(d) => {
        let n = d.entries.length()
        elems = elems + n.to_int64()
        h = fnv_update_u64(h, n.to_int64().to_uint64())
        let mut i = n - 1
        while i >= 0 {
          let (k, v) = d.entries[i]
          h = fnv_update_str(h, k)
          stack.push(v)
          i = i - 1
        }
      }
      bson::BsonValue::Array(items) => {
        let n = items.length()
        elems = elems + n.to_int64()
        h = fnv_update_u64(h, n.to_int64().to_uint64())
        let mut i = n - 1
        while i >= 0 {
          stack.push(items[i])
          i = i - 1
        }
      }
      bson::BsonValue::Double(x) => h = fnv_update_u64(h, x.to_bits().to_uint64())
      bson::BsonValue::Str(s) => h = fnv_update_str(h, s)
      bson::BsonValue::Binary(sub, b) => {
        h = fnv_update_u64(h, sub.to_byte().to_int64().to_uint64())
        h = fnv_update_bytes(h, b)
      }
      bson::BsonValue::ObjectId(oid) => h = fnv_update_bytes(h, oid.bytes)
      bson::BsonValue::Bool(b) => h = fnv_update_u64(h, if b { 1UL } else { 0UL })
      bson::BsonValue::DateTime(ms) => h = fnv_update_u64(h, ms.to_uint64())
      bson::BsonValue::Null => h = fnv_update_u64(h, 10UL)
      bson::BsonValue::Int32(n) => h = fnv_update_u64(h, n.to_int64().to_uint64())
      bson::BsonValue::Int64(n) => h = fnv_update_u64(h, n.to_uint64())
      bson::BsonValue::Decimal128(dec) => h = fnv_update_bytes(h, dec.bytes)
      _ => h = fnv_update_u64(h, 99UL)
    }
  }
  (elems, h)
}

fn parse_int_arg(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_bench <decode|encode|extjson> <corpus.bson> <rounds>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let rounds = parse_int_arg(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let raw_docs = split_corpus(data)
  let ndocs = raw_docs.length()

  if mode == "decode" {
    let mut total_docs : Int64 = 0L
    let mut total_elems : Int64 = 0L
    let mut checksum : UInt64 = 14695981039346656037UL
    let mut r = 0
    while r < rounds {
      let mut i = 0
      while i < ndocs {
        let doc = match bson::decode(raw_docs[i]) {
          Ok(d) => d
          Err(_) => return 2
        }
        let (ec, ch) = walk_doc_checksum(doc)
        total_docs = total_docs + 1L
        total_elems = total_elems + ec
        checksum = fnv_update_u64(checksum, ch)
        i = i + 1
      }
      r = r + 1
    }
    io_println(
      world,
      "mode=decode docs=" + total_docs.to_string() +
      " elems=" + total_elems.to_string() +
      " checksum=" + checksum.to_string(),
    )
    return 0
  }

  // Pre-decode docs for encode / extjson workloads
  let docs : Array[bson::BsonDocument] = []
  let mut di = 0
  while di < ndocs {
    let d = match bson::decode(raw_docs[di]) {
      Ok(v) => v
      Err(_) => return 3
    }
    docs.push(d)
    di = di + 1
  }

  if mode == "encode" {
    let mut total_docs : Int64 = 0L
    let mut total_bytes : Int64 = 0L
    let mut checksum : UInt64 = 14695981039346656037UL
    let mut r = 0
    while r < rounds {
      let mut i = 0
      while i < ndocs {
        let enc = match bson::encode(docs[i]) {
          Ok(b) => b
          Err(_) => return 4
        }
        total_docs = total_docs + 1L
        total_bytes = total_bytes + enc.length().to_int64()
        checksum = fnv_update_bytes(checksum, enc)
        i = i + 1
      }
      r = r + 1
    }
    io_println(
      world,
      "mode=encode docs=" + total_docs.to_string() +
      " bytes=" + total_bytes.to_string() +
      " checksum=" + checksum.to_string(),
    )
    return 0
  }

  if mode == "extjson" {
    let mut total_docs : Int64 = 0L
    let mut canon_bytes : Int64 = 0L
    let mut relaxed_bytes : Int64 = 0L
    let mut checksum : UInt64 = 14695981039346656037UL
    let mut r = 0
    while r < rounds {
      let mut i = 0
      while i < ndocs {
        let canon = match bson::to_extjson(docs[i], bson::ExtJsonMode::Canonical) {
          Ok(s) => s
          Err(_) => return 5
        }
        let doc_c = match bson::from_extjson(canon) {
          Ok(d) => d
          Err(_) => return 6
        }
        let relaxed = match bson::to_extjson(doc_c, bson::ExtJsonMode::Relaxed) {
          Ok(s) => s
          Err(_) => return 7
        }
        let doc_r = match bson::from_extjson(relaxed) {
          Ok(d) => d
          Err(_) => return 8
        }
        total_docs = total_docs + 1L
        canon_bytes = canon_bytes + canon.length().to_int64()
        relaxed_bytes = relaxed_bytes + relaxed.length().to_int64()
        checksum = fnv_update_str(checksum, canon)
        checksum = fnv_update_str(checksum, relaxed)
        checksum = fnv_update_u64(checksum, doc_r.len().to_int64().to_uint64())
        i = i + 1
      }
      r = r + 1
    }
    io_println(
      world,
      "mode=extjson docs=" + total_docs.to_string() +
      " canon_bytes=" + canon_bytes.to_string() +
      " relaxed_bytes=" + relaxed_bytes.to_string() +
      " checksum=" + checksum.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
