///| IEEE 754-2008 Binary Integer Decimal (BID) Decimal128 specification tests.

fn dec_assert_vector(input : String, expected_hex : String, expected_str : String) -> Unit {
  let d = match Decimal128::from_string(input) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "Decimal128::from_string failed for '" + input + "': " + error_message(e))
      return
    }
  }
  let got_hex = bytes_to_hex(d.to_bytes())
  debug_assert(
    got_hex == expected_hex,
    "Decimal128 hex mismatch for '" + input + "': expected " + expected_hex + ", got " + got_hex,
  )
  let got_str = d.to_string()
  debug_assert(
    got_str == expected_str,
    "Decimal128 to_string mismatch for '" + input + "': expected " + expected_str + ", got " + got_str,
  )
  let from_b = match Decimal128::from_bytes(hex_to_bytes(expected_hex)) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "Decimal128::from_bytes failed: " + error_message(e))
      return
    }
  }
  debug_assert(from_b.to_string() == expected_str, "Decimal128 from_bytes->to_string mismatch")
  debug_assert(d.eq(from_b), "Decimal128 eq mismatch")
}

fn dec_assert_err(input : String) -> Unit {
  match Decimal128::from_string(input) {
    Ok(v) =>
    debug_assert(
      false,
      "Decimal128::from_string should reject '" + input + "', got " + v.to_string(),
    )
    Err(_) => ()
  }
}

test "decimal128_zeros_and_signs" {
  dec_assert_vector("0", "00000000000000000000000000004030", "0")
  dec_assert_vector("+0", "00000000000000000000000000004030", "0")
  dec_assert_vector("-0", "000000000000000000000000000040b0", "-0")
  dec_assert_vector("0.00", "00000000000000000000000000003c30", "0.00")
  dec_assert_vector("-0.00", "00000000000000000000000000003cb0", "-0.00")
  dec_assert_vector("0E+2", "00000000000000000000000000004430", "0E+2")
  dec_assert_vector("0E-7", "00000000000000000000000000003230", "0E-7")
}

test "decimal128_basic_and_fractional" {
  dec_assert_vector("1", "01000000000000000000000000004030", "1")
  dec_assert_vector("-1", "010000000000000000000000000040b0", "-1")
  dec_assert_vector("1.23", "7b000000000000000000000000003c30", "1.23")
  dec_assert_vector("-1.23", "7b000000000000000000000000003cb0", "-1.23")
  dec_assert_vector("0.00123", "7b000000000000000000000000003630", "0.00123")
  dec_assert_vector("0.00000123", "7b000000000000000000000000003030", "0.00000123")
  dec_assert_vector("0.000000123", "7b000000000000000000000000002e30", "1.23E-7")
  dec_assert_vector("1.23E+5", "7b000000000000000000000000004630", "1.23E+5")
}

test "decimal128_special_nan_and_infinity" {
  dec_assert_vector("Infinity", "00000000000000000000000000000078", "Infinity")
  dec_assert_vector("+Infinity", "00000000000000000000000000000078", "Infinity")
  dec_assert_vector("Inf", "00000000000000000000000000000078", "Infinity")
  dec_assert_vector("-Infinity", "000000000000000000000000000000f8", "-Infinity")
  dec_assert_vector("-Inf", "000000000000000000000000000000f8", "-Infinity")
  dec_assert_vector("NaN", "0000000000000000000000000000007c", "NaN")
  dec_assert_vector("-NaN", "0000000000000000000000000000007c", "NaN")
  dec_assert_vector("sNaN", "0000000000000000000000000000007c", "NaN")

  let nan_v = match Decimal128::from_string("NaN") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "NaN failed")
      return
    }
  }
  debug_assert(nan_v.is_nan(), "NaN.is_nan()")
  debug_assert(!nan_v.is_infinite(), "!NaN.is_infinite()")
  debug_assert(!nan_v.is_zero(), "!NaN.is_zero()")

  let neg_inf = match Decimal128::from_string("-Infinity") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "-Inf failed")
      return
    }
  }
  debug_assert(neg_inf.is_infinite(), "-Inf.is_infinite()")
  debug_assert(neg_inf.is_negative(), "-Inf.is_negative()")
  debug_assert(!neg_inf.is_nan(), "!-Inf.is_nan()")

  let neg_zero = match Decimal128::from_string("-0") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "-0 failed")
      return
    }
  }
  debug_assert(neg_zero.is_zero(), "-0.is_zero()")
  debug_assert(neg_zero.is_negative(), "-0.is_negative()")
}

test "decimal128_extremes_34_digits_and_exponents" {
  // Max finite: (10^34 - 1) * 10^6111
  dec_assert_vector(
    "9999999999999999999999999999999999E+6111",
    "ffffffff638e8d37c087adbe09edff5f",
    "9.999999999999999999999999999999999E+6144",
  )
  // Min positive subnormal: 1 * 10^-6176
  dec_assert_vector("1E-6176", "01000000000000000000000000000000", "1E-6176")
  // Exact clamping of 1E+6144 -> 1000000000000000000000000000000000 * 10^6111
  let big = match Decimal128::from_string("1E+6144") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "1E+6144 should be valid: " + error_message(e))
      return
    }
  }
  debug_assert(
    big.to_string() == "1.000000000000000000000000000000000E+6144",
    "1E+6144 formatting mismatch: " + big.to_string(),
  )
  // Exact trailing zero stripping on 10E-6177 -> 1E-6176
  dec_assert_vector("10E-6177", "01000000000000000000000000000000", "1E-6176")
  // 34-digit precision preserved
  let pi34 = "3.141592653589793238462643383279502"
  let d = match Decimal128::from_string(pi34) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(d.to_string() == pi34, "34-digit roundtrip mismatch: " + d.to_string())
}

test "decimal128_non_canonical_bid_decodes_to_zero" {
  // Combination bits 11 (non-Inf/non-NaN) implies significand >= 2^113 > 10^34-1 -> value 0
  // hi = 0x6000000000000000 (sign=0, comb=11, biased_exp=0 -> exp=-6176)
  let non_canon = match Decimal128::from_bytes(hex_to_bytes("01000000000000000000000000000060")) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(non_canon.is_zero(), "non-canonical BID must be zero")
  debug_assert(non_canon.to_string() == "0E-6176", "non-canonical BID string mismatch: " + non_canon.to_string())
}

test "decimal128_in_bson_and_extjson" {
  // {"d": Decimal128("1.23")} -> 4 + 1 + 2("d\0") + 16 + 1 = 24 = 0x18
  assert_bson_roundtrip(
    "180000001364007b000000000000000000000000003c3000",
    "{\"d\":{\"$numberDecimal\":\"1.23\"}}",
    "{\"d\":{\"$numberDecimal\":\"1.23\"}}",
  )
}

test "decimal128_invalid_strings_rejected" {
  dec_assert_err("")
  dec_assert_err(" ")
  dec_assert_err(".")
  dec_assert_err("+.e1")
  dec_assert_err("1.2.3")
  dec_assert_err("1e")
  dec_assert_err("1e+")
  dec_assert_err("1e-")
  dec_assert_err("abc")
  dec_assert_err("1E+6145") // overflow
  dec_assert_err("1E-6177") // underflow (precision loss)
  dec_assert_err("12345678901234567890123456789012345") // 35 non-zero digits
  dec_assert_err("1.23 ")
  dec_assert_err(" 1.23")
}

test "c1_migrated_bson_constants" {
  // Canonical signed zeros (+0 and -0)
  debug_assert(dec128_pair_is_zero(0UL, 0UL), "+0 is zero")
  debug_assert(dec128_pair_is_zero(0x8000000000000000UL, 0UL), "-0 is zero")
  // BinarySubtype::to_byte bounds
  for b = 0; b <= 255; b = b + 1 {
    let tb = BinarySubtype::from_byte(b).to_byte()
    debug_assert(tb >= 0 && tb <= 255, "BinarySubtype to_byte in [0, 255]")
  }
  // BsonLimits::default spec
  let lim = BsonLimits::default()
  debug_assert(lim.max_depth == 128, "default max_depth")
  debug_assert(lim.max_doc_bytes == 16777216, "default max_doc_bytes")
  debug_assert(lim.max_elements == 1000000, "default max_elements")
  debug_assert(!lim.validate_array_keys, "default validate_array_keys")
}
