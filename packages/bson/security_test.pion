///| Adversarial, malformed BSON, strict UTF-8, limits, and deep-nesting security tests.

fn assert_decode_err(hex : String, msg : String) -> Unit {
  match decode(hex_to_bytes(hex)) {
    Ok(_) => debug_assert(false, "expected decode error (" + msg + ") for " + hex)
    Err(_) => ()
  }
}

test "sec_doc_length_and_framing_errors" {
  assert_decode_err("", "empty input")
  assert_decode_err("04000000", "doc length < 5")
  assert_decode_err("0000000000", "doc length == 0")
  assert_decode_err("ffffffff00", "negative doc length")
  assert_decode_err("0500000001", "missing trailing NUL")
  assert_decode_err("0600000000", "declared length > buffer")
  assert_decode_err("050000000000", "trailing garbage byte")
  assert_decode_err("0500000000deadbeef", "trailing garbage bytes")
}

test "sec_invalid_element_type_and_truncation" {
  // Unknown element type 0x14
  assert_decode_err("0800000014610000", "unknown element type 0x14")
  // Truncated Int32 (only 2 value bytes)
  assert_decode_err("0a000000106100010200", "truncated Int32")
  // Truncated Double (only 4 value bytes)
  assert_decode_err("0c0000000161000102030400", "truncated Double")
  // Truncated ObjectId (only 6 bytes)
  assert_decode_err("0e00000007610001020304050600", "truncated ObjectId")
  // Truncated Decimal128 (only 8 bytes)
  assert_decode_err("10000000136100010203040506070800", "truncated Decimal128")
  // Missing NUL on key cstring
  assert_decode_err("080000000a616263", "unterminated cstring key")
}

test "sec_string_and_utf8_validation" {
  // String length == 0 (invalid, must be >= 1 for NUL)
  assert_decode_err("0c0000000273000000000000", "string len 0")
  // String length == -1
  assert_decode_err("0c000000027300ffffffff00", "negative string len")
  // String missing trailing NUL (len=2, bytes="ab" instead of "a\0")
  assert_decode_err("0e00000002610002000000616200", "string missing NUL")
  // Invalid UTF-8 in string (0xFF)
  assert_decode_err("0e00000002610002000000ff0000", "invalid UTF-8 0xFF in string")
  // Invalid UTF-8 overlong 2-byte (C0 AF)
  assert_decode_err("0f00000002610003000000c0af0000", "overlong UTF-8 in string")
  // Invalid UTF-8 surrogate (ED A0 80)
  assert_decode_err("1000000002610004000000eda0800000", "surrogate UTF-8 in string")
  // Invalid UTF-8 in key (0xFE)
  assert_decode_err("080000000afe0000", "invalid UTF-8 in key")
  // Invalid UTF-8 in regex pattern
  assert_decode_err("0a0000000b6100ff000000", "invalid UTF-8 in regex")
}

test "sec_boolean_binary_and_array_validation" {
  // Boolean byte 0x02 (invalid, must be 0x00 or 0x01)
  assert_decode_err("0b00000008666c67000200", "invalid bool 0x02")
  assert_decode_err("0b00000008666c6700ff00", "invalid bool 0xFF")
  // Binary negative length
  assert_decode_err("0f0000000562696e00ffffffff0000", "negative binary len")
  // BinaryOld (0x02) with outer_len < 4
  assert_decode_err("0f0000000578000200000002010200", "BinaryOld outer_len < 4")
  // BinaryOld (0x02) with inner_len != outer_len - 4
  assert_decode_err("13000000057800060000000205000000010200", "BinaryOld inner_len mismatch")
  // Array with wrong key ("1" instead of "0") — strict array key mode opt-in
  let strict_limits = BsonLimits::default().with_validate_array_keys(true)
  match decode_with_limits(
    hex_to_bytes("140000000461000c000000103100010000000000"),
    strict_limits,
  ) {
    Ok(_) => debug_assert(false, "expected strict array key error for '1' at index 0")
    Err(_) => ()
  }
  // Array with non-numeric key ("x") — strict array key mode opt-in
  match decode_with_limits(
    hex_to_bytes("140000000461000c000000107800010000000000"),
    strict_limits,
  ) {
    Ok(_) => debug_assert(false, "expected strict array key error for 'x' at index 0")
    Err(_) => ()
  }
}

test "sec_encode_rejects_embedded_nul_and_bad_values" {
  // Embedded NUL in document key must be rejected by encoder
  let bad_key = BsonDocument::from_entries([("a\u{0000}b", BsonValue::Int32(1))])
  match encode(bad_key) {
    Ok(_) => debug_assert(false, "encoder must reject embedded NUL in key")
    Err(_) => ()
  }
  // Embedded NUL in regex pattern/options must be rejected
  let bad_re = BsonDocument::from_entries([("r", BsonValue::Regex("a\u{0000}b", "i"))])
  match encode(bad_re) {
    Ok(_) => debug_assert(false, "encoder must reject embedded NUL in regex")
    Err(_) => ()
  }
  // Out-of-range Timestamp (> u32::MAX or negative) must be rejected
  let bad_ts = BsonDocument::from_entries([("t", BsonValue::Timestamp(-1L, 0L))])
  match encode(bad_ts) {
    Ok(_) => debug_assert(false, "encoder must reject negative timestamp")
    Err(_) => ()
  }
}

test "sec_limits_depth_bytes_elements" {
  // Build nested document of depth 250 (iterative encode & decode must NOT stack overflow!)
  let mut doc = BsonDocument::from_entries([("leaf", BsonValue::Int32(7))])
  let mut i = 0
  while i < 250 {
    doc = BsonDocument::from_entries([("n", BsonValue::Document(doc))])
    i = i + 1
  }
  // Default max_depth=128 must reject both encode and decode
  match encode(doc) {
    Ok(_) => debug_assert(false, "default max_depth=128 should reject depth 250")
    Err(_) => ()
  }
  let deep_limits = BsonLimits::new(300, 16777216, 1000000)
  let encoded = match encode_with_limits(doc, deep_limits) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "depth 250 encode with limit 300 failed: " + error_message(e))
      return
    }
  }
  // Decode with default limit=128 must fail
  match decode(encoded) {
    Ok(_) => debug_assert(false, "default max_depth=128 should reject decoding depth 250")
    Err(_) => ()
  }
  // Decode with limit=300 must succeed
  let decoded = match decode_with_limits(encoded, deep_limits) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "depth 250 decode with limit 300 failed: " + error_message(e))
      return
    }
  }
  debug_assert(bson_doc_eq(doc, decoded), "depth 250 roundtrip mismatch")

  // max_doc_bytes limit
  let tiny_bytes = BsonLimits::new(300, 16, 1000)
  match decode_with_limits(encoded, tiny_bytes) {
    Ok(_) => debug_assert(false, "max_doc_bytes=16 should reject")
    Err(_) => ()
  }

  // max_elements limit
  let tiny_elems = BsonLimits::new(300, 16777216, 10)
  match decode_with_limits(encoded, tiny_elems) {
    Ok(_) => debug_assert(false, "max_elements=10 should reject 251 elements")
    Err(_) => ()
  }
}

test "sec_extjson_malformed_and_depth_bomb" {
  // Trailing garbage
  match from_extjson("{} trailing") {
    Ok(_) => debug_assert(false, "must reject trailing garbage in ExtJSON")
    Err(_) => ()
  }
  // Root must be a JSON object
  match from_extjson("[1,2,3]") {
    Ok(_) => debug_assert(false, "ExtJSON root must be an object")
    Err(_) => ()
  }
  // Invalid $oid length
  match from_extjson("{\"_id\":{\"$oid\":\"1234\"}}") {
    Ok(_) => debug_assert(false, "must reject short $oid")
    Err(_) => ()
  }
  // Invalid $uuid format
  match from_extjson("{\"u\":{\"$uuid\":\"not-a-uuid\"}}") {
    Ok(_) => debug_assert(false, "must reject invalid $uuid")
    Err(_) => ()
  }
  // Invalid $numberInt overflow
  match from_extjson("{\"n\":{\"$numberInt\":\"999999999999\"}}") {
    Ok(_) => debug_assert(false, "must reject $numberInt overflow")
    Err(_) => ()
  }
  // Depth bomb in ExtJSON
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("{\"a\":")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 200 {
    sb.write_string("}")
    i = i + 1
  }
  match from_extjson(sb.to_string()) {
    Ok(_) => debug_assert(false, "ExtJSON depth 200 must be rejected by default max_depth=128")
    Err(_) => ()
  }
}

test "sec_p0_decode_length_signed_overflow" {
  // 32-bit signed overflow in length checks must return Err, never abort
  assert_decode_err("0e000000026100ffffff7f780000", "String len 0x7FFFFFFF")
  assert_decode_err("0e0000000d6100ffffff7f780000", "JavaScript len 0x7FFFFFFF")
  assert_decode_err("0e0000000e6100feffff7f780000", "Symbol len 0x7FFFFFFE")
  assert_decode_err(
    "1a0000000c6100ffffff7f780001010101010101010101010100",
    "DBPointer len 0x7FFFFFFF",
  )
  assert_decode_err("0f000000056100ffffff7f00aabb00", "Binary len 0x7FFFFFFF")
  assert_decode_err("0d000000036100ffffff7f0000", "Subdocument len 0x7FFFFFFF")
  assert_decode_err("0d000000046100feffff7f0000", "Array len 0x7FFFFFFE")
  assert_decode_err(
    "170000000f61000f000000ffffff7f7800050000000000",
    "CodeWScope inner string len 0x7FFFFFFF",
  )
}

test "sec_p1_extjson_strict_wrappers_and_types" {
  // Extra / legacy keys in type wrappers must be rejected, not downgraded to Document
  for bad in [
    "{\"a\":{\"$oid\":\"65a00102030405060708090a\",\"x\":1}}",
    "{\"a\":{\"$numberInt\":\"42\",\"x\":1}}",
    "{\"a\":{\"$numberLong\":\"42\",\"x\":1}}",
    "{\"a\":{\"$numberDouble\":\"1.0\",\"x\":1}}",
    "{\"a\":{\"$numberDecimal\":\"1.0\",\"x\":1}}",
    "{\"a\":{\"$code\":\"\",\"x\":1}}",
    "{\"a\":{\"$scope\":{}}}",
    "{\"a\":{\"$binary\":\"AA==\",\"$type\":\"00\"}}",
    "{\"a\":{\"$date\":{\"$numberLong\":\"1\"},\"x\":1}}",
    "{\"a\":{\"$minKey\":1,\"x\":1}}",
    "{\"a\":{\"$maxKey\":1,\"x\":1}}",
    // Wrong wrapper value types
    "{\"a\":{\"$date\":{\"$numberInt\":\"5\"}}}",
    "{\"a\":{\"$date\":42}}",
    "{\"a\":{\"$minKey\":{\"$numberInt\":\"1\"}}}",
    "{\"a\":{\"$maxKey\":{\"$numberInt\":\"1\"}}}",
    "{\"a\":{\"$timestamp\":{\"t\":{\"$numberInt\":\"1\"},\"i\":2}}}",
    // RFC 3339 timezone requires :MM
    "{\"a\":{\"$date\":\"1970-01-01T00:00:00+00\"}}",
  ] {
    match from_extjson(bad) {
      Ok(_) => debug_assert(false, "must reject invalid ExtJSON: " + bad)
      Err(_) => ()
    }
  }
}

test "sec_p1_array_keys_default_and_regex_options_sort" {
  // Default limits accept degenerate array keys per BSON Corpus and re-encode canonically
  let d = match decode(hex_to_bytes("150000000476000d000000107879002a0000000000")) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "default decode must accept degenerate array key: " + error_message(e))
      return
    }
  }
  let reenc = match encode(d) {
    Ok(b) => bytes_to_hex(b)
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(reenc == "140000000476000c0000001030002a0000000000", "canonical array reencode: " + reenc)

  // Regex options sorted in decode, encode, from_extjson, to_extjson
  let rdoc = BsonDocument::from_entries([("r", BsonValue::Regex("abc", "xsmli"))])
  let rej = match to_extjson(rdoc, ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(
    rej == "{\"r\":{\"$regularExpression\":{\"pattern\":\"abc\",\"options\":\"ilmsx\"}}}",
    "to_extjson regex sort: " + rej,
  )
}

test "sec_p1_utf8_and_p2_numberdouble_and_to_extjson_validation" {
  // Invalid UTF-8 rejected in from_extjson and encode
  let bad_ej = hex_to_bytes("7b2261223a22ff227d").to_string()
  debug_assert(from_extjson(bad_ej) is Err(_), "from_extjson must reject invalid UTF-8")
  let bad_s = hex_to_bytes("c0af").to_string()
  debug_assert(
    encode(BsonDocument::from_entries([(bad_s, BsonValue::Int32(1))])) is Err(_),
    "encode must reject invalid UTF-8 key",
  )
  debug_assert(
    encode(BsonDocument::from_entries([("s", BsonValue::Str(bad_s))])) is Err(_),
    "encode must reject invalid UTF-8 string",
  )

  // P2-1: relaxed $numberDouble decimal & special strings
  for good in [
    "{\"a\":{\"$numberDouble\":\"1.\"}}",
    "{\"a\":{\"$numberDouble\":\".5\"}}",
    "{\"a\":{\"$numberDouble\":\"-.5\"}}",
    "{\"a\":{\"$numberDouble\":\"inf\"}}",
    "{\"a\":{\"$numberDouble\":\"+inf\"}}",
    "{\"a\":{\"$numberDouble\":\"-inf\"}}",
  ] {
    debug_assert(from_extjson(good) is Ok(_), "$numberDouble must accept " + good)
  }

  // P2-3 & P2-4: to_extjson rejects malformed ObjectId, Decimal128, Timestamp
  debug_assert(
    to_extjson(
      BsonDocument::from_entries([("o", BsonValue::ObjectId(ObjectId::{ bytes: Bytes::new(3) }))]),
      ExtJsonMode::Canonical,
    ) is Err(_),
    "to_extjson must reject short ObjectId",
  )
  debug_assert(
    to_extjson(
      BsonDocument::from_entries([
        ("d", BsonValue::Decimal128(Decimal128::{ bytes: Bytes::new(4) })),
      ]),
      ExtJsonMode::Canonical,
    ) is Err(_),
    "to_extjson must reject short Decimal128",
  )
  debug_assert(
    to_extjson(
      BsonDocument::from_entries([("t", BsonValue::Timestamp(-1L, 0L))]),
      ExtJsonMode::Canonical,
    ) is Err(_),
    "to_extjson must reject negative Timestamp",
  )
}
