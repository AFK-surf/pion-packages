///| Red-team differential / DoS probe for packages/bson.
/// usage:
///   bson_audit_probe diff <requests.tsv>    one result line per request line `<op>\t<hex>`:
///     B <bson hex>    -> OK\t<re-encoded hex>\t<canonical extjson>\t<relaxed extjson> | ERR\t<msg>
///     J <utf8 hex>    -> OK\t<bson hex> | ERR\t<msg>              (from_extjson -> encode)
///     D <utf8 hex>    -> OK\t<16-byte LE hex>\t<to_string> | ERR\t<msg>
///     X <16-byte hex> -> OK\t<to_string>
///   bson_audit_probe deep <what> <n> [max_depth]   n-deep nesting (what = bin_dec | enc | ej_ser | ej_parse | drop)
///   bson_audit_probe wide <what> <n>               n-key flat document (what = dec | enc | ej_ser | ej_parse)

import "bson"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (nib(s.code_unit_at(2 * i)) * 16 + nib(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(b : Bytes) -> String {
  let d : FixedArray[Byte] = [
    b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
  ]
  let out = Bytes::new(b.length() * 2)
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    out[2 * i] = d[v >> 4]
    out[2 * i + 1] = d[v & 15]
    i = i + 1
  }
  out.to_string()
}

///|
fn clean(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 9 || c == 10 || c == 13 {
      sb.write_byte(b' ')
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn err(e : bson::BsonError) -> String {
  "ERR\t" + clean(bson::error_message(e))
}

///|
fn run_one(op : String, arg : String) -> String {
  let raw = unhex(arg)
  if op == "B" {
    match bson::decode(raw) {
      Err(e) => err(e)
      Ok(doc) => {
        let re = match bson::encode(doc) {
          Ok(b) => tohex(b)
          Err(e) => "ENCERR:" + clean(bson::error_message(e))
        }
        let c = match bson::to_extjson(doc, bson::ExtJsonMode::Canonical) {
          Ok(s) => s
          Err(e) => return "ERR\tto_extjson: " + clean(bson::error_message(e))
        }
        let r = match bson::to_extjson(doc, bson::ExtJsonMode::Relaxed) {
          Ok(s) => s
          Err(e) => return "ERR\tto_extjson: " + clean(bson::error_message(e))
        }
        "OK\t" + re + "\t" + c + "\t" + r
      }
    }
  } else if op == "J" {
    match bson::from_extjson(raw.to_string()) {
      Err(e) => err(e)
      Ok(doc) =>
      match bson::encode(doc) {
        Ok(b) => "OK\t" + tohex(b)
        Err(e) => "ERR\tencode: " + clean(bson::error_message(e))
      }
    }
  } else if op == "D" {
    match bson::Decimal128::from_string(raw.to_string()) {
      Err(e) => err(e)
      Ok(d) => "OK\t" + tohex(d.to_bytes()) + "\t" + d.to_string()
    }
  } else if op == "X" {
    match bson::Decimal128::from_bytes(raw) {
      Err(e) => err(e)
      Ok(d) => "OK\t" + d.to_string()
    }
  } else {
    "ERR\tbad op"
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn big_limits(depth : Int) -> bson::BsonLimits {
  bson::BsonLimits::new(depth, 2147483647, 2147483647)
}

///|
/// n-deep `{"a":{"a":...{}}}` as raw BSON bytes (built iteratively from the inside out).
fn deep_bin(n : Int) -> Bytes {
  let total = 5 + n * 8
  let out = Bytes::new(total)
  // outer i-th document starts at 7*i: len(4) 0x03 'a' 0x00 ... trailing NUL at total-1-i
  let mut i = 0
  while i <= n {
    let start = 7 * i
    let doc_len = total - start - i
    out[start] = (doc_len & 0xFF).to_byte()
    out[start + 1] = ((doc_len >> 8) & 0xFF).to_byte()
    out[start + 2] = ((doc_len >> 16) & 0xFF).to_byte()
    out[start + 3] = ((doc_len >> 24) & 0xFF).to_byte()
    if i < n {
      out[start + 4] = (3).to_byte()
      out[start + 5] = b'a'
      out[start + 6] = (0).to_byte()
    }
    out[total - 1 - i] = (0).to_byte()
    i = i + 1
  }
  out
}

///|
fn deep_doc(n : Int) -> bson::BsonDocument {
  let mut d = bson::BsonDocument::empty()
  let mut i = 0
  while i < n {
    d = bson::BsonDocument::from_entries([("a", bson::BsonValue::Document(d))])
    i = i + 1
  }
  d
}

///|
fn deep_json(n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string("{\"a\":")
    i = i + 1
  }
  sb.write_string("{}")
  i = 0
  while i < n {
    sb.write_byte(b'}')
    i = i + 1
  }
  sb.to_string()
}

///|
fn wide_doc(n : Int) -> bson::BsonDocument {
  let entries : Array[(String, bson::BsonValue)] = []
  let mut i = 0
  while i < n {
    entries.push(("k" + i.to_string(), bson::BsonValue::Int32(i)))
    i = i + 1
  }
  bson::BsonDocument::from_entries(entries)
}

///|
fn show[T](r : Result[T, bson::BsonError], what : (T) -> String) -> String {
  match r {
    Ok(v) => "OK " + what(v)
    Err(e) => "ERR " + bson::error_message(e)
  }
}

///|
fn deep(world : World, what : String, n : Int, depth : Int) -> Int {
  let lim = big_limits(depth)
  let line = if what == "bin_dec" {
    show(bson::decode_with_limits(deep_bin(n), lim), fn(d) { "entries=" + d.len().to_string() })
  } else if what == "enc" {
    show(bson::encode_with_limits(deep_doc(n), lim), fn(b) { "bytes=" + b.length().to_string() })
  } else if what == "ej_ser" {
    show(bson::to_extjson_with_limits(deep_doc(n), bson::ExtJsonMode::Canonical, lim), fn(
      s,
    ) {
      "chars=" + s.length().to_string()
    })
  } else if what == "ej_parse" {
    show(bson::from_extjson_with_limits(deep_json(n), lim), fn(d) {
      "entries=" + d.len().to_string()
    })
  } else if what == "drop" {
    // build and drop an n-deep tree (reference-count teardown)
    let d = deep_doc(n)
    "OK built entries=" + d.len().to_string()
  } else if what == "eq" {
    let a = deep_doc(n)
    let b = deep_doc(n)
    "OK eq=" + bson::bson_doc_eq(a, b).to_string()
  } else {
    "ERR bad what"
  }
  io_println(world, "deep " + what + " n=" + n.to_string() + ": " + line)
  0
}

///|
fn wide(world : World, what : String, n : Int) -> Int {
  let lim = big_limits(128)
  let doc = wide_doc(n)
  let line = if what == "enc" {
    show(bson::encode_with_limits(doc, lim), fn(b) { "bytes=" + b.length().to_string() })
  } else if what == "dec" {
    match bson::encode_with_limits(doc, lim) {
      Ok(b) =>
      show(bson::decode_with_limits(b, lim), fn(d) { "entries=" + d.len().to_string() })
      Err(e) => "ERR " + bson::error_message(e)
    }
  } else if what == "ej_ser" {
    show(bson::to_extjson_with_limits(doc, bson::ExtJsonMode::Relaxed, lim), fn(s) {
      "chars=" + s.length().to_string()
    })
  } else if what == "ej_parse" {
    match bson::to_extjson_with_limits(doc, bson::ExtJsonMode::Canonical, lim) {
      Ok(s) =>
      show(bson::from_extjson_with_limits(s, lim), fn(d) {
        "entries=" + d.len().to_string()
      })
      Err(e) => "ERR " + bson::error_message(e)
    }
  } else {
    "ERR bad what"
  }
  io_println(world, "wide " + what + " n=" + n.to_string() + ": " + line)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 4 && args[1] == "deep" {
    let depth = if args.length() >= 5 { parse_int(args[4]) } else { 2147483647 }
    return deep(world, args[2], parse_int(args[3]), depth)
  }
  if args.length() >= 4 && args[1] == "wide" {
    return wide(world, args[2], parse_int(args[3]))
  }
  if args.length() < 3 || args[1] != "diff" {
    io_eprintln(world, "usage: bson_audit_probe diff <requests.tsv> | deep <what> <n> [max_depth] | wide <what> <n>")
    return 1
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read input")
      return 1
    }
  }
  let skip = if args.length() >= 4 { parse_int(args[3]) } else { 0 }
  let text = data.to_string()
  let n = text.length()
  let mut line_no = 0
  let mut start = 0
  while start < n {
    let mut end = start
    while end < n && text.code_unit_at(end) != 10 {
      end = end + 1
    }
    if line_no >= skip && end > start {
      let mut tab = start
      while tab < end && text.code_unit_at(tab) != 9 {
        tab = tab + 1
      }
      let op = text.slice(start, tab)
      let arg = if tab < end { text.slice(tab + 1, end) } else { "" }
      io_println(world, run_one(op, arg))
    }
    line_no = line_no + 1
    start = end + 1
  }
  0
}
