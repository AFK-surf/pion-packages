///| Red-team regression tests for packages/bson @ 341de2d (branch feat/pkg-bson).
///
/// Every `p0_` / `p1_` / `p2_` test asserts the behaviour required by the MongoDB specifications
/// (bson-corpus, extended-json) and shown by BOTH reference implementations (Rust `bson` 2.15.0 and
/// Go `go.mongodb.org/mongo-driver/v2/bson` v2.4.1) unless the comment says otherwise.
/// A FAILURE of a p*_ test is the evidence; see REPORT.md for the finding each one belongs to.
/// `control_` tests are attacks Pion survived; they must keep passing.
///
/// P0 tests abort the process inside `bson::decode` (index out of bounds / allocation panic); the
/// Pion test runner isolates each test, so they are reported as failed and the run continues.

import "bson"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn hx(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (nib(s.code_unit_at(2 * i)) * 16 + nib(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn decode_is_err(hex : String) -> Bool {
  match bson::decode(hx(hex)) {
    Ok(_) => false
    Err(_) => true
  }
}

///|
/// decode(hex) then encode: the re-encoded hex, or "ERR <message>".
fn reencode(hex : String) -> String {
  match bson::decode(hx(hex)) {
    Err(e) => "ERR " + bson::error_message(e)
    Ok(d) =>
    match bson::encode(d) {
      Ok(b) => tohex(b)
      Err(e) => "ERR " + bson::error_message(e)
    }
  }
}

///|
/// from_extjson(json) then encode: the BSON hex, or "ERR <message>".
fn ej_to_hex(json : String) -> String {
  match bson::from_extjson(json) {
    Err(e) => "ERR " + bson::error_message(e)
    Ok(d) =>
    match bson::encode(d) {
      Ok(b) => tohex(b)
      Err(e) => "ERR " + bson::error_message(e)
    }
  }
}

///|
fn ej_is_err(json : String) -> Bool {
  match bson::from_extjson(json) {
    Ok(_) => false
    Err(_) => true
  }
}

// ---------------------------------------------------------------------------
// P0-1  Signed 32-bit overflow in every length bounds check of decode.pion (`pos + len > end - 1`
// wraps negative for len near 0x7FFFFFFF). 13..26-byte inputs abort the process (native SIGABRT,
// wasm32 pion panic). Rust and Go return an error for every one of these inputs.
// ---------------------------------------------------------------------------

///|
test "p0_string_length_overflow_aborts" {
  // decode.pion:292  {"a": String, len = 0x7FFFFFFF}
  debug_assert(decode_is_err("0e000000026100ffffff7f780000"), "must be Err, not abort")
}

///|
test "p0_javascript_length_overflow_aborts" {
  debug_assert(decode_is_err("0e0000000d6100ffffff7f780000"), "must be Err, not abort")
}

///|
test "p0_symbol_length_overflow_aborts" {
  debug_assert(decode_is_err("0e0000000e6100feffff7f780000"), "must be Err, not abort")
}

///|
test "p0_dbpointer_length_overflow_aborts" {
  // decode.pion:448  pos + slen + 12
  debug_assert(
    decode_is_err("1a0000000c6100ffffff7f780001010101010101010101010100"),
    "must be Err, not abort",
  )
}

///|
test "p0_binary_length_overflow_aborts" {
  // decode.pion:348  pos + 1 + blen -> Bytes::new(0x7FFFFFFF): "container length exceeds maximum"
  debug_assert(decode_is_err("0f000000056100ffffff7f00aabb00"), "must be Err, not abort")
}

///|
test "p0_subdocument_length_overflow_aborts" {
  // decode.pion:320  pos + sub_len
  debug_assert(decode_is_err("0d000000036100ffffff7f0000"), "must be Err, not abort")
}

///|
test "p0_array_length_overflow_aborts" {
  debug_assert(decode_is_err("0d000000046100feffff7f0000"), "must be Err, not abort")
}

///|
test "p0_code_w_scope_code_length_overflow_aborts" {
  // decode.pion:480  pos + slen + 5
  debug_assert(
    decode_is_err("170000000f61000f000000ffffff7f7800050000000000"),
    "must be Err, not abort",
  )
}

// ---------------------------------------------------------------------------
// P1-1  Type-wrapper objects with extra keys are silently kept as ordinary documents.
// extended-json.md "Parsers": "it must contain exactly the keys of the type wrapper. Any missing or
// extra keys constitute an error." 11 official bson-corpus top.json parseErrors are accepted.
// ---------------------------------------------------------------------------

///|
test "p1_corpus_top_bad_oid_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$oid\":\"65a00102030405060708090a\",\"extra\":1}}"),
    "extra field on $oid wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_numberint_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$numberInt\":\"99\",\"extra\":1}}"),
    "extra field on $numberInt wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_numberlong_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$numberLong\":\"99\",\"extra\":1}}"),
    "extra field on $numberLong wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_numberdouble_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$numberDouble\":\"2.5\",\"extra\":1}}"),
    "extra field on $numberDouble wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_numberdecimal_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$numberDecimal\":\"4.56\",\"extra\":1}}"),
    "extra field on $numberDecimal wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_code_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$code\":\"fn()\",\"extra\":1}}"),
    "extra field on $code wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_timestamp_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$timestamp\":{\"t\":1704984834,\"i\":7},\"extra\":1}}"),
    "extra field on $timestamp wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_date_extra_field" {
  // Worse than a plain accept: the inner {"$numberLong"} is converted, so the result is a
  // sub-document {"$date": Int64, "extra": 1} -- a silently type-confused value.
  debug_assert(
    ej_is_err("{\"k\":{\"$date\":{\"$numberLong\":\"1752914535321\"},\"extra\":1}}"),
    "extra field on $date wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_minkey_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$minKey\":1,\"extra\":1}}"),
    "extra field on $minKey wrapper must be rejected",
  )
}

///|
test "p1_corpus_top_bad_maxkey_extra_field" {
  debug_assert(
    ej_is_err("{\"k\":{\"$maxKey\":1,\"extra\":1}}"),
    "extra field on $maxKey wrapper must be rejected",
  )
}

///|
test "p1_binary_extra_field_and_legacy_form_not_silently_a_document" {
  // Rust rejects both; Go rejects the first and parses the second as legacy Binary.
  // Pion turns both into a plain sub-document with a "$binary" key.
  debug_assert(
    ej_is_err("{\"a\":{\"$binary\":{\"base64\":\"AA==\",\"subType\":\"00\"},\"x\":1}}"),
    "extra key next to $binary must be rejected",
  )
  let legacy = ej_to_hex("{\"a\":{\"$binary\":\"AA==\",\"$type\":\"00\"}}")
  debug_assert(
    legacy.length() >= 3 && legacy.slice(0, 3) == "ERR" || legacy == "0e00000005610001000000000000",
    "legacy $binary/$type must be an error or Binary(00, [0]); got " + legacy,
  )
}

// ---------------------------------------------------------------------------
// P1-2  Array keys are validated by default, so official bson-corpus *valid* degenerate vectors
// (array.json) are rejected. Rust and Go decode them and re-encode canonical keys "0","1",...
// ---------------------------------------------------------------------------

///|
test "p1_corpus_array_index_empty_key_is_valid" {
  let got = reencode("130000000476000b00000010002a0000000000")
  debug_assert(got == "140000000476000c0000001030002a0000000000", "got " + got)
}

///|
test "p1_corpus_array_index_ab_is_valid" {
  let got = reencode("150000000476000d000000107879002a0000000000")
  debug_assert(got == "140000000476000c0000001030002a0000000000", "got " + got)
}

///|
test "p1_corpus_array_duplicate_indexes_is_valid" {
  let got = reencode("1b000000047600130000001030002a000000103000630000000000")
  debug_assert(got == "1b000000047600130000001030002a000000103100630000000000", "got " + got)
}

// ---------------------------------------------------------------------------
// P1-3  Regex options are never alphabetized (extended-json.md footnote 2: "BSON Regular Expression
// options MUST be in alphabetical order"; corpus regex.json "flags not alphabetized").
// ---------------------------------------------------------------------------

///|
test "p1_corpus_regex_flags_not_alphabetized_bson" {
  let got = reencode("100000000b720078797a00786d690000")
  debug_assert(got == "100000000b720078797a00696d780000", "got " + got)
}

///|
test "p1_corpus_regex_flags_not_alphabetized_extjson" {
  let got = ej_to_hex(
    "{\"r\" : {\"$regularExpression\" : { \"pattern\": \"xyz\", \"options\" : \"xmi\"}}}",
  )
  debug_assert(got == "100000000b720078797a00696d780000", "got " + got)
}

///|
test "p1_regex_canonical_extjson_options_sorted" {
  let doc = bson::BsonDocument::from_entries([("a", bson::BsonValue::Regex("p", "xsmli"))])
  let got = match bson::to_extjson(doc, bson::ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(e) => bson::error_message(e)
  }
  debug_assert(
    got == "{\"a\":{\"$regularExpression\":{\"pattern\":\"p\",\"options\":\"ilmsx\"}}}",
    "got " + got,
  )
}

// ---------------------------------------------------------------------------
// P1-4  Wrapper values of the wrong type are accepted because inner objects are converted first.
// extended-json.md: "if any of the values are of an incorrect type, then the parser MUST report an
// error". Rust and Go reject all three.
// ---------------------------------------------------------------------------

///|
test "p1_date_numberint_value_rejected" {
  debug_assert(ej_is_err("{\"a\":{\"$date\":{\"$numberInt\":\"5\"}}}"), "$date takes $numberLong only")
}

///|
test "p1_minkey_wrapped_value_rejected" {
  debug_assert(ej_is_err("{\"a\":{\"$minKey\":{\"$numberInt\":\"1\"}}}"), "$minKey takes the integer 1")
}

///|
test "p1_timestamp_wrapped_field_rejected" {
  debug_assert(
    ej_is_err("{\"a\":{\"$timestamp\":{\"t\":{\"$numberInt\":\"1\"},\"i\":2}}}"),
    "$timestamp.t must be a JSON integer",
  )
}

// ---------------------------------------------------------------------------
// P1-5  Invalid UTF-8 passes from_extjson / encode unchecked, producing BSON that Pion's own decode
// rejects (bson-corpus string.json/regex.json decodeErrors). Pion `String` values can carry arbitrary
// bytes (e.g. `Bytes::to_string` of a file). Rust rejects the input; Go also emits the bad bytes.
// ---------------------------------------------------------------------------

///|
test "p1_extjson_invalid_utf8_string_must_not_produce_undecodable_bson" {
  let src = hx("7b2261223a22ff227d").to_string() // {"a":"\xff"}
  match bson::from_extjson(src) {
    Err(_) => ()
    Ok(d) =>
    match bson::encode(d) {
      Err(_) => ()
      Ok(b) =>
      debug_assert(
        bson::decode(b) is Ok(_),
        "encode() emitted " + tohex(b) + " which decode() rejects",
      )
    }
  }
}

///|
test "p1_encode_invalid_utf8_key_and_regex_must_not_produce_undecodable_bson" {
  let bad = hx("c0af").to_string()
  let doc = bson::BsonDocument::from_entries([
    (bad, bson::BsonValue::Int32(1)),
    ("r", bson::BsonValue::Regex(bad, "")),
  ])
  match bson::encode(doc) {
    Err(_) => ()
    Ok(b) =>
    debug_assert(bson::decode(b) is Ok(_), "encode() emitted " + tohex(b) + " which decode() rejects")
  }
}

// ---------------------------------------------------------------------------
// P2  Robustness / interoperability
// ---------------------------------------------------------------------------

///|
test "p2_numberdouble_decimal_strings_without_leading_or_trailing_digit" {
  // "64-bit signed floating point as a decimal string": Rust and Go both accept these.
  debug_assert(!ej_is_err("{\"a\":{\"$numberDouble\":\"1.\"}}"), "1. rejected")
  debug_assert(!ej_is_err("{\"a\":{\"$numberDouble\":\".5\"}}"), ".5 rejected")
  debug_assert(!ej_is_err("{\"a\":{\"$numberDouble\":\"-.5\"}}"), "-.5 rejected")
}

///|
test "p2_date_rfc3339_offset_requires_minutes" {
  // RFC 3339 time-numoffset = ("+" / "-") time-hour ":" time-minute. Rust and Go reject "+00".
  debug_assert(
    ej_is_err("{\"a\":{\"$date\":\"1970-01-01T00:00:00+00\"}}"),
    "+00 offset must be rejected",
  )
}

///|
test "p2_to_extjson_malformed_objectid_returns_err_not_abort" {
  // encode() rejects a 3-byte ObjectId with InvalidObjectId; to_extjson() indexes past the end.
  let doc = bson::BsonDocument::from_entries([
    ("o", bson::BsonValue::ObjectId(bson::ObjectId::{ bytes: Bytes::new(3) })),
  ])
  debug_assert(bson::to_extjson(doc, bson::ExtJsonMode::Canonical) is Err(_), "must be Err")
}

///|
test "p2_to_extjson_malformed_decimal128_returns_err_not_abort" {
  let doc = bson::BsonDocument::from_entries([
    ("d", bson::BsonValue::Decimal128(bson::Decimal128::{ bytes: Bytes::new(4) })),
  ])
  debug_assert(bson::to_extjson(doc, bson::ExtJsonMode::Canonical) is Err(_), "must be Err")
}

///|
test "p2_to_extjson_out_of_range_timestamp_rejected_like_encode" {
  // encode() rejects t = -1; to_extjson emits {"$timestamp":{"t":-1,...}} that from_extjson rejects.
  let doc = bson::BsonDocument::from_entries([("t", bson::BsonValue::Timestamp(-1L, 0L))])
  let out = match bson::to_extjson(doc, bson::ExtJsonMode::Canonical) {
    Ok(s) => s
    Err(_) => return
  }
  debug_assert(!ej_is_err(out), "to_extjson emitted " + out + " which from_extjson rejects")
}

// ---------------------------------------------------------------------------
// Controls: attacks Pion survives (must keep passing)
// ---------------------------------------------------------------------------

///|
test "control_small_length_lies_rejected" {
  for h in [
    "0e000000026100ffffffff780000", "0e0000000261000000000078000000", "0d000000036100040000000000",
    "0f000000056100ffffffff00aabb00", "0500000001", "ffffff7f00", "ffffffff00", "050000000000",
    // code_w_scope *total* length 0x7FFFFFFF also wraps, but the inner string check stops it
    "170000000f6100ffffff7f02000000780005000000000000",
  ] {
    debug_assert(decode_is_err(h), "must reject " + h)
  }
}

///|
test "control_string_with_embedded_nul_roundtrips" {
  // BSON strings may contain NUL (only cstrings may not).
  let h = "10000000026100040000006100620000"
  debug_assert(reencode(h) == h, "got " + reencode(h))
}

///|
test "control_relaxed_datetime_fallbacks" {
  let enc = fn(ms : Int64) -> String {
    let d = bson::BsonDocument::from_entries([("d", bson::BsonValue::DateTime(ms))])
    match bson::to_extjson(d, bson::ExtJsonMode::Relaxed) {
      Ok(s) => s
      Err(e) => bson::error_message(e)
    }
  }
  debug_assert(enc(-1L) == "{\"d\":{\"$date\":{\"$numberLong\":\"-1\"}}}", enc(-1L))
  debug_assert(
    enc(253402300800000L) == "{\"d\":{\"$date\":{\"$numberLong\":\"253402300800000\"}}}",
    enc(253402300800000L),
  )
  debug_assert(
    enc(253402300799999L) == "{\"d\":{\"$date\":\"9999-12-31T23:59:59.999Z\"}}",
    enc(253402300799999L),
  )
  debug_assert(
    enc(-9223372036854775807L - 1L) ==
    "{\"d\":{\"$date\":{\"$numberLong\":\"-9223372036854775808\"}}}",
    enc(-9223372036854775807L - 1L),
  )
}

///|
test "control_double_shortest_roundtrip_in_extjson" {
  for bits in [
    1L, 0x3FD3333333333334L, 0x7FEFFFFFFFFFFFFFL, 0x000FFFFFFFFFFFFFL, 0x44B52D02C7E14AF6L, 0x3EB0C6F7A0B5ED8DL,
  ] {
    let doc = bson::BsonDocument::from_entries([("d", bson::BsonValue::Double(Double::from_bits(bits)))])
    for mode in [bson::ExtJsonMode::Canonical, bson::ExtJsonMode::Relaxed] {
      let s = match bson::to_extjson(doc, mode) {
        Ok(v) => v
        Err(e) => bson::error_message(e)
      }
      match bson::from_extjson(s) {
        Ok(back) => debug_assert(bson::bson_doc_eq(doc, back), "lossy double: " + s)
        Err(e) => debug_assert(false, s + ": " + bson::error_message(e))
      }
    }
  }
}

///|
test "control_decimal128_clamping_and_display_threshold" {
  let cases : Array[(String, String)] = [
    ("1E+6144", "1.000000000000000000000000000000000E+6144"),
    ("0E+99999", "0E+6111"),
    ("100E-6178", "1E-6176"),
    ("0.0000001", "1E-7"),
    ("0.000001", "0.000001"),
    ("-0.00", "-0.00"),
    ("1E3", "1E+3"),
  ]
  for c in cases {
    let (src, want) = c
    let got = match bson::Decimal128::from_string(src) {
      Ok(d) => d.to_string()
      Err(e) => bson::error_message(e)
    }
    debug_assert(got == want, src + " -> " + got + ", want " + want)
  }
  debug_assert(bson::Decimal128::from_string("1E+6145") is Err(_), "1E+6145 must overflow")
  debug_assert(bson::Decimal128::from_string("1E-6177") is Err(_), "1E-6177 must underflow")
}

///|
test "control_deep_nesting_respects_limits" {
  let mut d = bson::BsonDocument::empty()
  let mut i = 0
  while i < 200 {
    d = bson::BsonDocument::from_entries([("a", bson::BsonValue::Document(d))])
    i = i + 1
  }
  debug_assert(bson::encode(d) is Err(_), "depth 200 > default 128 must be rejected")
  debug_assert(bson::to_extjson(d, bson::ExtJsonMode::Canonical) is Err(_), "to_extjson depth")
}
