///| 12-byte MongoDB ObjectId implementation.

let oid_hex_lower : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
  b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
]

#verify
pub fn oid_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///| Construct an `ObjectId` from 12 raw bytes (copied).
pub fn ObjectId::from_bytes(b : Bytes) -> Result[ObjectId, BsonError] {
  if b.length() != 12 {
    return Err(
      BsonError::InvalidObjectId("expected 12 bytes, got " + b.length().to_string()),
    )
  }
  let out = Bytes::new(12)
  let mut i = 0
  while i < 12 {
    out[i] = b[i]
    i = i + 1
  }
  Ok(ObjectId::{ bytes: out })
}

///| Parse a 24-character hex string (case-insensitive) into an `ObjectId`.
pub fn ObjectId::from_hex(hex : String) -> Result[ObjectId, BsonError] {
  if hex.length() != 24 {
    return Err(
      BsonError::InvalidObjectId("expected 24 hex chars, got " + hex.length().to_string()),
    )
  }
  let out = Bytes::new(12)
  let mut i = 0
  while i < 12 {
    let hi = oid_hex_val(hex.code_unit_at(i * 2))
    let lo = oid_hex_val(hex.code_unit_at(i * 2 + 1))
    if hi < 0 || lo < 0 {
      return Err(BsonError::InvalidObjectId("invalid hex character in ObjectId"))
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  Ok(ObjectId::{ bytes: out })
}

///| Format an `ObjectId` as a 24-character lowercase hex string.
pub fn ObjectId::to_hex(self : ObjectId) -> String {
  let out = Bytes::new(24)
  let b = self.bytes
  let mut i = 0
  while i < 12 {
    let v = b[i].to_int()
    out[i * 2] = oid_hex_lower[v >> 4]
    out[i * 2 + 1] = oid_hex_lower[v & 15]
    i = i + 1
  }
  out.to_string()
}

///| Return a copy of the 12 raw bytes.
pub fn ObjectId::to_bytes(self : ObjectId) -> Bytes {
  let out = Bytes::new(12)
  let mut i = 0
  while i < 12 {
    out[i] = self.bytes[i]
    i = i + 1
  }
  out
}

///| Extract the unsigned 32-bit big-endian Unix timestamp (seconds) from bytes 0..4.
pub fn ObjectId::timestamp_seconds(self : ObjectId) -> Int64 {
  let b = self.bytes
  let b0 = b[0].to_int().to_int64()
  let b1 = b[1].to_int().to_int64()
  let b2 = b[2].to_int().to_int64()
  let b3 = b[3].to_int().to_int64()
  (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

///| Lexicographical comparison of two `ObjectId` values (`-1`, `0`, `1`).
pub fn ObjectId::compare(self : ObjectId, other : ObjectId) -> Int {
  let a = self.bytes
  let b = other.bytes
  let mut i = 0
  while i < 12 {
    let va = a[i].to_int()
    let vb = b[i].to_int()
    if va < vb {
      return -1
    }
    if va > vb {
      return 1
    }
    i = i + 1
  }
  0
}

///| Equality of two `ObjectId` values.
pub fn ObjectId::eq(self : ObjectId, other : ObjectId) -> Bool {
  bytes_equal(self.bytes, other.bytes)
}
