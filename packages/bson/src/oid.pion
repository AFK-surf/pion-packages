  let _ = hex
  Err(BsonError::Unsupported("ObjectId::from_hex not implemented"))
}

///| Format an `ObjectId` as a 24-character lowercase hex string.
pub fn ObjectId::to_hex(self : ObjectId) -> String {
  let _ = self
  ""
}

///| Return a copy of the 12 raw bytes.
pub fn ObjectId::to_bytes(self : ObjectId) -> Bytes {
  self.bytes
}

///| Extract the unsigned 32-bit big-endian Unix timestamp (seconds) from bytes 0..4.
pub fn ObjectId::timestamp_seconds(self : ObjectId) -> Int64 {
  let _ = self
  0L
}

///| Lexicographical comparison of two `ObjectId` values (`-1`, `0`, `1`).
pub fn ObjectId::compare(self : ObjectId, other : ObjectId) -> Int {
  let _ = self
  let _ = other
  0
}

///| Equality of two `ObjectId` values.
pub fn ObjectId::eq(self : ObjectId, other : ObjectId) -> Bool {
  let _ = self
