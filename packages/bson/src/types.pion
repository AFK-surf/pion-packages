///| Core BSON 1.1 data model, binary subtypes, limits, and error types.

///| BSON Binary (type `0x05`) subtype byte.
pub enum BinarySubtype {
  Generic // 0x00
  Function // 0x01
  BinaryOld // 0x02
  UuidOld // 0x03
  Uuid // 0x04
  Md5 // 0x05
  Encrypted // 0x06
  Column // 0x07 (Compressed / Time-Series Column)
  Sensitive // 0x08
  Vector // 0x09
  Reserved(Int) // 0x0A..0x7F
  UserDefined(Int) // 0x80..0xFF
}

///| Convert a raw byte (`0..255`) into a `BinarySubtype`.
pub fn BinarySubtype::from_byte(b : Int) -> BinarySubtype {
  let v = b & 0xFF
  if v == 0x00 {
    BinarySubtype::Generic
  } else if v == 0x01 {
    BinarySubtype::Function
  } else if v == 0x02 {
    BinarySubtype::BinaryOld
  } else if v == 0x03 {
    BinarySubtype::UuidOld
  } else if v == 0x04 {
    BinarySubtype::Uuid
  } else if v == 0x05 {
    BinarySubtype::Md5
  } else if v == 0x06 {
    BinarySubtype::Encrypted
  } else if v == 0x07 {
    BinarySubtype::Column
  } else if v == 0x08 {
    BinarySubtype::Sensitive
  } else if v == 0x09 {
    BinarySubtype::Vector
  } else if v >= 0x80 {
    BinarySubtype::UserDefined(v)
  } else {
    BinarySubtype::Reserved(v)
  }
}

///| Convert a `BinarySubtype` to its wire byte (`0..255`).
pub fn BinarySubtype::to_byte(self : BinarySubtype) -> Int {
  match self {
    BinarySubtype::Generic => 0x00
    BinarySubtype::Function => 0x01
    BinarySubtype::BinaryOld => 0x02
    BinarySubtype::UuidOld => 0x03
    BinarySubtype::Uuid => 0x04
    BinarySubtype::Md5 => 0x05
    BinarySubtype::Encrypted => 0x06
    BinarySubtype::Column => 0x07
    BinarySubtype::Sensitive => 0x08
    BinarySubtype::Vector => 0x09
    BinarySubtype::Reserved(v) => v & 0xFF
    BinarySubtype::UserDefined(v) => v & 0xFF
  }
}

///| Check equality of two `BinarySubtype` values.
pub fn binary_subtype_eq(a : BinarySubtype, b : BinarySubtype) -> Bool {
  a.to_byte() == b.to_byte()
}

///| 12-byte MongoDB ObjectId stored as raw bytes.
pub struct ObjectId {
  pub bytes : Bytes
}

///| 16-byte IEEE 754-2008 Binary Integer Decimal (BID) Decimal128 stored in little-endian order.
pub struct Decimal128 {
  pub bytes : Bytes
}

///| Ordered BSON document (list of key-value elements).
pub struct BsonDocument {
  pub entries : Array[(String, BsonValue)]
}

///| Construct an empty `BsonDocument`.
pub fn BsonDocument::empty() -> BsonDocument {
  BsonDocument::{ entries: [] }
}

///| Construct a `BsonDocument` from key-value entries.
pub fn BsonDocument::from_entries(entries : Array[(String, BsonValue)]) -> BsonDocument {
  BsonDocument::{ entries: entries }
}

///| Number of elements in the document.
pub fn BsonDocument::len(self : BsonDocument) -> Int {
  self.entries.length()
}

///| True if the document has no elements.
pub fn BsonDocument::is_empty(self : BsonDocument) -> Bool {
  self.entries.length() == 0
}

///| Append an element to the document.
pub fn BsonDocument::push(self : BsonDocument, key : String, value : BsonValue) -> Unit {
  self.entries.push((key, value))
}

///| Lookup the first element with the given key.
pub fn BsonDocument::get(self : BsonDocument, key : String) -> Option[BsonValue] {
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    let (k, v) = self.entries[i]
    if k == key {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| BSON 1.1 element value covering all 19+ element types.
pub enum BsonValue {
  Double(Double) // 0x01
  Str(String) // 0x02
  Document(BsonDocument) // 0x03
  Array(Array[BsonValue]) // 0x04
  Binary(BinarySubtype, Bytes) // 0x05
  Undefined // 0x06 (deprecated)
  ObjectId(ObjectId) // 0x07
  Bool(Bool) // 0x08
  DateTime(Int64) // 0x09 (UTC ms since Unix epoch)
  Null // 0x0A
  Regex(String, String) // 0x0B (pattern, options)
  DbPointer(String, ObjectId) // 0x0C (deprecated)
  JavaScript(String) // 0x0D
  Symbol(String) // 0x0E (deprecated)
  JavaScriptWithScope(String, BsonDocument) // 0x0F
  Int32(Int) // 0x10
  Timestamp(Int64, Int64) // 0x11 (time u32, increment u32)
  Int64(Int64) // 0x12
  Decimal128(Decimal128) // 0x13
  MinKey // 0xFF
  MaxKey // 0x7F
}

///| Extended JSON v2 formatting mode.
pub enum ExtJsonMode {
  Canonical
  Relaxed
}

///| Resource limits enforced during BSON and Extended JSON decode/encode.
pub val struct BsonLimits {
  pub max_depth : Int
  pub max_doc_bytes : Int
  pub max_elements : Int
  pub validate_array_keys : Bool
}

///| Default BSON limits (matches MongoDB 16 MiB doc limit, depth 128, 1M elements).
pub fn BsonLimits::default() -> BsonLimits {
  BsonLimits::{
    max_depth: 128,
    max_doc_bytes: 16777216,
    max_elements: 1000000,
    validate_array_keys: true,
  }
}

///| Construct custom BSON limits.
pub fn BsonLimits::new(
  max_depth : Int,
  max_doc_bytes : Int,
  max_elements : Int,
) -> BsonLimits {
  BsonLimits::{
    max_depth: max_depth,
    max_doc_bytes: max_doc_bytes,
    max_elements: max_elements,
    validate_array_keys: true,
  }
}

///| Errors returned by BSON binary and Extended JSON operations.
pub enum BsonError {
  UnexpectedEof(Int)
  InvalidDocumentLength(Int)
  MissingNullTerminator(Int)
  TrailingBytes(Int)
  InvalidElementType(Int, Int)
  InvalidUtf8(Int)
  EmbeddedNull(String)
  InvalidStringLength(Int)
  InvalidBoolean(Int, Int)
  InvalidBinaryLength(Int)
  InvalidArrayKey(Int, String)
  InvalidObjectId(String)
  InvalidDecimal128(String)
  InvalidTimestamp(String)
  InvalidExtJson(String)
  MaxDepthExceeded(Int)
  MaxDocBytesExceeded(Int)
  MaxElementsExceeded(Int)
  LimitExceeded(String)
  Unsupported(String)
}

///| Format a `BsonError` as a human-readable message.
pub fn error_message(err : BsonError) -> String {
  match err {
    UnexpectedEof(pos) => "bson: unexpected EOF at offset " + pos.to_string()
    InvalidDocumentLength(len) => "bson: invalid document length " + len.to_string()
    MissingNullTerminator(pos) => "bson: missing NUL terminator at offset " + pos.to_string()
    TrailingBytes(pos) => "bson: trailing unconsumed bytes at offset " + pos.to_string()
    InvalidElementType(tag, pos) =>
    "bson: invalid element type " + tag.to_string() + " at offset " + pos.to_string()
    InvalidUtf8(pos) => "bson: invalid UTF-8 at offset " + pos.to_string()
    EmbeddedNull(ctx) => "bson: embedded NUL byte in " + ctx
    InvalidStringLength(len) => "bson: invalid string length " + len.to_string()
    InvalidBoolean(b, pos) =>
    "bson: invalid boolean byte " + b.to_string() + " at offset " + pos.to_string()
    InvalidBinaryLength(len) => "bson: invalid binary length " + len.to_string()
    InvalidArrayKey(idx, got) =>
    "bson: invalid array key at index " + idx.to_string() + ": " + got
    InvalidObjectId(msg) => "bson: invalid ObjectId: " + msg
    InvalidDecimal128(msg) => "bson: invalid Decimal128: " + msg
    InvalidTimestamp(msg) => "bson: invalid Timestamp: " + msg
    InvalidExtJson(msg) => "bson: invalid Extended JSON: " + msg
    MaxDepthExceeded(limit) => "bson: max nesting depth exceeded (" + limit.to_string() + ")"
    MaxDocBytesExceeded(limit) => "bson: max document bytes exceeded (" + limit.to_string() + ")"
    MaxElementsExceeded(limit) => "bson: max elements exceeded (" + limit.to_string() + ")"
    LimitExceeded(msg) => "bson: limit exceeded: " + msg
    Unsupported(msg) => "bson: unsupported: " + msg
  }
}

///| Constant-logic byte equality helper.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Iterative structural equality for two `BsonValue` trees (treats NaN == NaN by bits).
pub fn bson_value_eq(a : BsonValue, b : BsonValue) -> Bool {
  let stack : Array[(BsonValue, BsonValue)] = [(a, b)]
  while stack.length() > 0 {
    let pair = match stack.pop() {
      Some(p) => p
      None => break
    }
    let (va, vb) = pair
    match (va, vb) {
      (BsonValue::Double(x), BsonValue::Double(y)) => {
        if x.to_bits() != y.to_bits() {
          return false
        }
      }
      (BsonValue::Str(x), BsonValue::Str(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::Document(da), BsonValue::Document(db)) => {
        let n = da.entries.length()
        if n != db.entries.length() {
          return false
        }
        let mut i = n - 1
        while i >= 0 {
          let (ka, ea) = da.entries[i]
          let (kb, eb) = db.entries[i]
          if ka != kb {
            return false
          }
          stack.push((ea, eb))
          i = i - 1
        }
      }
      (BsonValue::Array(xa), BsonValue::Array(xb)) => {
        let n = xa.length()
        if n != xb.length() {
          return false
        }
        let mut i = n - 1
        while i >= 0 {
          stack.push((xa[i], xb[i]))
          i = i - 1
        }
      }
      (BsonValue::Binary(sa, ba), BsonValue::Binary(sb, bb)) => {
        if !binary_subtype_eq(sa, sb) || !bytes_equal(ba, bb) {
          return false
        }
      }
      (BsonValue::Undefined, BsonValue::Undefined) => ()
      (BsonValue::ObjectId(oa), BsonValue::ObjectId(ob)) => {
        if !bytes_equal(oa.bytes, ob.bytes) {
          return false
        }
      }
      (BsonValue::Bool(x), BsonValue::Bool(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::DateTime(x), BsonValue::DateTime(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::Null, BsonValue::Null) => ()
      (BsonValue::Regex(pa, oa), BsonValue::Regex(pb, ob)) => {
        if pa != pb || oa != ob {
          return false
        }
      }
      (BsonValue::DbPointer(na, oa), BsonValue::DbPointer(nb, ob)) => {
        if na != nb || !bytes_equal(oa.bytes, ob.bytes) {
          return false
        }
      }
      (BsonValue::JavaScript(x), BsonValue::JavaScript(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::Symbol(x), BsonValue::Symbol(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::JavaScriptWithScope(ca, sa), BsonValue::JavaScriptWithScope(cb, sb)) => {
        if ca != cb {
          return false
        }
        stack.push((BsonValue::Document(sa), BsonValue::Document(sb)))
      }
      (BsonValue::Int32(x), BsonValue::Int32(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::Timestamp(ta, ia), BsonValue::Timestamp(tb, ib)) => {
        if ta != tb || ia != ib {
          return false
        }
      }
      (BsonValue::Int64(x), BsonValue::Int64(y)) => {
        if x != y {
          return false
        }
      }
      (BsonValue::Decimal128(da), BsonValue::Decimal128(db)) => {
        if !bytes_equal(da.bytes, db.bytes) {
          return false
        }
      }
      (BsonValue::MinKey, BsonValue::MinKey) => ()
      (BsonValue::MaxKey, BsonValue::MaxKey) => ()
      _ => return false
    }
  }
  true
}

///| Iterative structural equality for two `BsonDocument` values.
pub fn bson_doc_eq(a : BsonDocument, b : BsonDocument) -> Bool {
  bson_value_eq(BsonValue::Document(a), BsonValue::Document(b))
}
