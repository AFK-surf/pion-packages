///| Iterative BSON 1.1 binary encoder (stub for Red phase).

///| Encode a BSON 1.1 document with default limits.
pub fn encode(doc : BsonDocument) -> Result[Bytes, BsonError] {
  encode_with_limits(doc, BsonLimits::default())
}

///| Encode a BSON 1.1 document with explicit limits.
pub fn encode_with_limits(
  doc : BsonDocument,
  limits : BsonLimits,
) -> Result[Bytes, BsonError] {
  let _ = doc
  let _ = limits
  Err(BsonError::Unsupported("encode_with_limits not implemented"))
}
