///| Iterative two-pass pre-allocated BSON 1.1 binary encoder.
///| Pass 1 validates limits/invariants and computes exact byte lengths per container.
///| Pass 2 writes directly into a single pre-allocated `Bytes` buffer.

fn enc_has_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 0 {
      return true
    }
    i = i + 1
  }
  false
}

fn enc_array_key_len(idx : Int) -> Int {
  if idx < 10 {
    1
  } else if idx < 100 {
    2
  } else if idx < 1000 {
    3
  } else if idx < 10000 {
    4
  } else if idx < 100000 {
    5
  } else {
    idx.to_string().length()
  }
}

fn enc_write_i32_le(out : Bytes, pos : Int, v : Int) -> Int {
  out[pos] = (v & 0xFF).to_byte()
  out[pos + 1] = ((v >> 8) & 0xFF).to_byte()
  out[pos + 2] = ((v >> 16) & 0xFF).to_byte()
  out[pos + 3] = ((v >> 24) & 0xFF).to_byte()
  pos + 4
}

fn enc_write_i64_le(out : Bytes, pos : Int, v : Int64) -> Int {
  out[pos] = (v & 0xFFL).to_int().to_byte()
  out[pos + 1] = ((v >> 8) & 0xFFL).to_int().to_byte()
  out[pos + 2] = ((v >> 16) & 0xFFL).to_int().to_byte()
  out[pos + 3] = ((v >> 24) & 0xFFL).to_int().to_byte()
  out[pos + 4] = ((v >> 32) & 0xFFL).to_int().to_byte()
  out[pos + 5] = ((v >> 40) & 0xFFL).to_int().to_byte()
  out[pos + 6] = ((v >> 48) & 0xFFL).to_int().to_byte()
  out[pos + 7] = ((v >> 56) & 0xFFL).to_int().to_byte()
  pos + 8
}

fn enc_write_str_raw(out : Bytes, pos : Int, s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut p = pos
  while i < n {
    out[p] = s.code_unit_at(i).to_byte()
    p = p + 1
    i = i + 1
  }
  p
}

fn enc_write_cstring(out : Bytes, pos : Int, s : String) -> Int {
  let p = enc_write_str_raw(out, pos, s)
  out[p] = (0).to_byte()
  p + 1
}

fn enc_write_array_key(out : Bytes, pos : Int, idx : Int) -> Int {
  if idx < 10 {
    out[pos] = (48 + idx).to_byte()
    out[pos + 1] = (0).to_byte()
    return pos + 2
  }
  if idx < 100 {
    out[pos] = (48 + idx / 10).to_byte()
    out[pos + 1] = (48 + idx % 10).to_byte()
    out[pos + 2] = (0).to_byte()
    return pos + 3
  }
  enc_write_cstring(out, pos, idx.to_string())
}

fn enc_write_bson_string(out : Bytes, pos : Int, s : String) -> Int {
  let p1 = enc_write_i32_le(out, pos, s.length() + 1)
  let p2 = enc_write_str_raw(out, p1, s)
  out[p2] = (0).to_byte()
  p2 + 1
}

fn enc_write_bytes(out : Bytes, pos : Int, b : Bytes) -> Int {
  let n = b.length()
  let mut i = 0
  let mut p = pos
  while i < n {
    out[p] = b[i]
    p = p + 1
    i = i + 1
  }
  p
}

fn enc_type_byte(v : BsonValue) -> Int {
  match v {
    BsonValue::Double(_) => 0x01
    BsonValue::Str(_) => 0x02
    BsonValue::Document(_) => 0x03
    BsonValue::Array(_) => 0x04
    BsonValue::Binary(_, _) => 0x05
    BsonValue::Undefined => 0x06
    BsonValue::ObjectId(_) => 0x07
    BsonValue::Bool(_) => 0x08
    BsonValue::DateTime(_) => 0x09
    BsonValue::Null => 0x0A
    BsonValue::Regex(_, _) => 0x0B
    BsonValue::DbPointer(_, _) => 0x0C
    BsonValue::JavaScript(_) => 0x0D
    BsonValue::Symbol(_) => 0x0E
    BsonValue::JavaScriptWithScope(_, _) => 0x0F
    BsonValue::Int32(_) => 0x10
    BsonValue::Timestamp(_, _) => 0x11
    BsonValue::Int64(_) => 0x12
    BsonValue::Decimal128(_) => 0x13
    BsonValue::MinKey => 0xFF
    BsonValue::MaxKey => 0x7F
  }
}

struct SizeFrame {
  is_array : Bool
  doc_entries : Array[(String, BsonValue)]
  arr_items : Array[BsonValue]
  mut idx : Int
  mut size : Int
  size_slot : Int
  is_code_w_scope : Bool
  cws_header_bytes : Int
}

struct WriteFrame {
  is_array : Bool
  doc_entries : Array[(String, BsonValue)]
  arr_items : Array[BsonValue]
  mut idx : Int
}

///| Encode a BSON 1.1 document with default limits.
pub fn encode(doc : BsonDocument) -> Result[Bytes, BsonError] {
  encode_with_limits(doc, BsonLimits::default())
}

///| Encode a BSON 1.1 document with explicit limits (100% iterative two-pass).
pub fn encode_with_limits(
  doc : BsonDocument,
  limits : BsonLimits,
) -> Result[Bytes, BsonError] {
  if limits.max_depth < 0 || limits.max_doc_bytes < 0 || limits.max_elements < 0 {
    return Err(BsonError::LimitExceeded("negative limit"))
  }

  // Pass 1: iterative sizing & validation
  let container_sizes : Array[Int] = [0]
  let sstack : Array[SizeFrame] = [
    SizeFrame::{
      is_array: false,
      doc_entries: doc.entries,
      arr_items: [],
      idx: 0,
      size: 5, // 4-byte length + 1-byte trailing NUL
      size_slot: 0,
      is_code_w_scope: false,
      cws_header_bytes: 0,
    },
  ]
  let mut total_elements = 0

  while sstack.length() > 0 {
    let top_i = sstack.length() - 1
    let f = sstack[top_i]
    let count = if f.is_array { f.arr_items.length() } else { f.doc_entries.length() }
    if f.idx >= count {
      let finished = match sstack.pop() {
        Some(x) => x
        None => break
      }
      if finished.size > limits.max_doc_bytes {
        return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
      }
      container_sizes[finished.size_slot] = finished.size
      if sstack.length() > 0 {
        let parent = sstack[sstack.length() - 1]
        let add = if finished.is_code_w_scope {
          finished.cws_header_bytes + finished.size
        } else {
          finished.size
        }
        parent.size = parent.size + add
        if parent.size > limits.max_doc_bytes {
          return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
        }
      }
      continue
    }

    total_elements = total_elements + 1
    if total_elements > limits.max_elements {
      return Err(BsonError::MaxElementsExceeded(limits.max_elements))
    }

    let cur_idx = f.idx
    f.idx = cur_idx + 1

    let mut key_wire_len = 0
    let mut bval = BsonValue::Null
    if f.is_array {
      key_wire_len = enc_array_key_len(cur_idx) + 1
      bval = f.arr_items[cur_idx]
    } else {
      let (k, v) = f.doc_entries[cur_idx]
      if enc_has_nul(k) {
        return Err(BsonError::EmbeddedNull("document key"))
      }
      key_wire_len = k.length() + 1
      bval = v
    }

    // 1 byte element type + key cstring
    f.size = f.size + 1 + key_wire_len

    match bval {
      BsonValue::Double(_) => f.size = f.size + 8
      BsonValue::Str(s) => f.size = f.size + 4 + s.length() + 1
      BsonValue::Document(sub) => {
        if sstack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        let slot = container_sizes.length()
        container_sizes.push(0)
        sstack.push(
          SizeFrame::{
            is_array: false,
            doc_entries: sub.entries,
            arr_items: [],
            idx: 0,
            size: 5,
            size_slot: slot,
            is_code_w_scope: false,
            cws_header_bytes: 0,
          },
        )
      }
      BsonValue::Array(items) => {
        if sstack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        let slot = container_sizes.length()
        container_sizes.push(0)
        sstack.push(
          SizeFrame::{
            is_array: true,
            doc_entries: [],
            arr_items: items,
            idx: 0,
            size: 5,
            size_slot: slot,
            is_code_w_scope: false,
            cws_header_bytes: 0,
          },
        )
      }
      BsonValue::Binary(sub, b) => {
        let extra = if sub.to_byte() == 0x02 { 4 } else { 0 }
        f.size = f.size + 4 + 1 + extra + b.length()
      }
      BsonValue::Undefined => ()
      BsonValue::ObjectId(oid) => {
        if oid.bytes.length() != 12 {
          return Err(BsonError::InvalidObjectId("ObjectId must be 12 bytes"))
        }
        f.size = f.size + 12
      }
      BsonValue::Bool(_) => f.size = f.size + 1
      BsonValue::DateTime(_) => f.size = f.size + 8
      BsonValue::Null => ()
      BsonValue::Regex(pat, opts) => {
        if enc_has_nul(pat) || enc_has_nul(opts) {
          return Err(BsonError::EmbeddedNull("regex pattern or options"))
        }
        f.size = f.size + pat.length() + 1 + opts.length() + 1
      }
      BsonValue::DbPointer(ns, oid) => {
        if oid.bytes.length() != 12 {
          return Err(BsonError::InvalidObjectId("DbPointer ObjectId must be 12 bytes"))
        }
        f.size = f.size + 4 + ns.length() + 1 + 12
      }
      BsonValue::JavaScript(code) => f.size = f.size + 4 + code.length() + 1
      BsonValue::Symbol(sym) => f.size = f.size + 4 + sym.length() + 1
      BsonValue::JavaScriptWithScope(code, jscope) => {
        if sstack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        let slot = container_sizes.length()
        container_sizes.push(0)
        let header = 4 + 4 + code.length() + 1
        sstack.push(
          SizeFrame::{
            is_array: false,
            doc_entries: jscope.entries,
            arr_items: [],
            idx: 0,
            size: 5,
            size_slot: slot,
            is_code_w_scope: true,
            cws_header_bytes: header,
          },
        )
      }
      BsonValue::Int32(_) => f.size = f.size + 4
      BsonValue::Timestamp(t, inc) => {
        if t < 0L || t > 4294967295L || inc < 0L || inc > 4294967295L {
          return Err(BsonError::InvalidTimestamp("timestamp/increment out of u32 range"))
        }
        f.size = f.size + 8
      }
      BsonValue::Int64(_) => f.size = f.size + 8
      BsonValue::Decimal128(dec) => {
        if dec.bytes.length() != 16 {
          return Err(BsonError::InvalidDecimal128("Decimal128 must be 16 bytes"))
        }
        f.size = f.size + 16
      }
      BsonValue::MinKey => ()
      BsonValue::MaxKey => ()
    }
    if f.size > limits.max_doc_bytes {
      return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
    }
  }

  let total_size = container_sizes[0]
  if total_size > limits.max_doc_bytes {
    return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
  }

  // Pass 2: iterative write into single pre-allocated buffer
  let out = Bytes::new(total_size)
  let mut pos = enc_write_i32_le(out, 0, total_size)
  let mut next_slot = 1
  let wstack : Array[WriteFrame] = [
    WriteFrame::{ is_array: false, doc_entries: doc.entries, arr_items: [], idx: 0 },
  ]

  while wstack.length() > 0 {
    let f = wstack[wstack.length() - 1]
    let count = if f.is_array { f.arr_items.length() } else { f.doc_entries.length() }
    if f.idx >= count {
      out[pos] = (0).to_byte()
      pos = pos + 1
      let _ = wstack.pop()
      continue
    }

    let cur_idx = f.idx
    f.idx = cur_idx + 1

    let mut bval = BsonValue::Null
    if f.is_array {
      bval = f.arr_items[cur_idx]
      out[pos] = enc_type_byte(bval).to_byte()
      pos = pos + 1
      pos = enc_write_array_key(out, pos, cur_idx)
    } else {
      let (k, v) = f.doc_entries[cur_idx]
      bval = v
      out[pos] = enc_type_byte(bval).to_byte()
      pos = pos + 1
      pos = enc_write_cstring(out, pos, k)
    }

    match bval {
      BsonValue::Double(d) => pos = enc_write_i64_le(out, pos, d.to_bits())
      BsonValue::Str(s) => pos = enc_write_bson_string(out, pos, s)
      BsonValue::Document(sub) => {
        let sub_size = container_sizes[next_slot]
        next_slot = next_slot + 1
        pos = enc_write_i32_le(out, pos, sub_size)
        wstack.push(
          WriteFrame::{ is_array: false, doc_entries: sub.entries, arr_items: [], idx: 0 },
        )
      }
      BsonValue::Array(items) => {
        let arr_size = container_sizes[next_slot]
        next_slot = next_slot + 1
        pos = enc_write_i32_le(out, pos, arr_size)
        wstack.push(
          WriteFrame::{ is_array: true, doc_entries: [], arr_items: items, idx: 0 },
        )
      }
      BsonValue::Binary(sub, b) => {
        let sb = sub.to_byte()
        if sb == 0x02 {
          pos = enc_write_i32_le(out, pos, b.length() + 4)
          out[pos] = (0x02).to_byte()
          pos = pos + 1
          pos = enc_write_i32_le(out, pos, b.length())
          pos = enc_write_bytes(out, pos, b)
        } else {
          pos = enc_write_i32_le(out, pos, b.length())
          out[pos] = sb.to_byte()
          pos = pos + 1
          pos = enc_write_bytes(out, pos, b)
        }
      }
      BsonValue::Undefined => ()
      BsonValue::ObjectId(oid) => pos = enc_write_bytes(out, pos, oid.bytes)
      BsonValue::Bool(b) => {
        out[pos] = (if b { 1 } else { 0 }).to_byte()
        pos = pos + 1
      }
      BsonValue::DateTime(ms) => pos = enc_write_i64_le(out, pos, ms)
      BsonValue::Null => ()
      BsonValue::Regex(pat, opts) => {
        pos = enc_write_cstring(out, pos, pat)
        pos = enc_write_cstring(out, pos, opts)
      }
      BsonValue::DbPointer(ns, oid) => {
        pos = enc_write_bson_string(out, pos, ns)
        pos = enc_write_bytes(out, pos, oid.bytes)
      }
      BsonValue::JavaScript(code) => pos = enc_write_bson_string(out, pos, code)
      BsonValue::Symbol(sym) => pos = enc_write_bson_string(out, pos, sym)
      BsonValue::JavaScriptWithScope(code, jscope) => {
        let scope_size = container_sizes[next_slot]
        next_slot = next_slot + 1
        let cws_total = 4 + 4 + code.length() + 1 + scope_size
        pos = enc_write_i32_le(out, pos, cws_total)
        pos = enc_write_bson_string(out, pos, code)
        pos = enc_write_i32_le(out, pos, scope_size)
        wstack.push(
          WriteFrame::{ is_array: false, doc_entries: jscope.entries, arr_items: [], idx: 0 },
        )
      }
      BsonValue::Int32(n) => pos = enc_write_i32_le(out, pos, n)
      BsonValue::Timestamp(t, inc) => {
        pos = enc_write_i32_le(out, pos, inc.to_int())
        pos = enc_write_i32_le(out, pos, t.to_int())
      }
      BsonValue::Int64(n) => pos = enc_write_i64_le(out, pos, n)
      BsonValue::Decimal128(dec) => pos = enc_write_bytes(out, pos, dec.bytes)
      BsonValue::MinKey => ()
      BsonValue::MaxKey => ()
    }
  }

  Ok(out)
}
