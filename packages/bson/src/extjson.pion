///| MongoDB Extended JSON v2 (Canonical & Relaxed) bidirectional iterative codec.

import "base64"
import "json5"

let ej_hex_lower : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
  b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
]

let ej_hex_upper : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
  b'8', b'9', b'A', b'B', b'C', b'D', b'E', b'F',
]

// 9999-12-31T23:59:59.999Z in ms since 1970-01-01T00:00:00Z
let ej_relaxed_date_max_ms : Int64 = 253402300799999L

fn ej_write_escaped_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(b'"')
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 || b < 0x20 {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(ej_hex_upper[(b >> 4) & 0xF])
        sb.write_byte(ej_hex_upper[b & 0xF])
      }
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if chunk_start < n {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte(b'"')
}

fn ej_write_2digits(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

fn ej_write_3digits(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 100).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

fn ej_write_4digits(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 1000).to_byte())
  sb.write_byte((48 + (v / 100) % 10).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

// Howard Hinnant's O(1) civil_from_days for UTC ms in [0, 253402300799999].
fn ej_write_iso8601_utc(sb : StringBuilder, ms : Int64) -> Unit {
  let total_secs = ms / 1000L
  let millis = (ms % 1000L).to_int()
  let days = total_secs / 86400L
  let sod = (total_secs % 86400L).to_int()
  let hour = sod / 3600
  let minute = (sod % 3600) / 60
  let second = sod % 60

  let z = days + 719468L
  let era = (if z >= 0L { z } else { z - 146096L }) / 146097L
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let y = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = (doy - (153L * mp + 2L) / 5L + 1L).to_int()
  let m = (if mp < 10L { mp + 3L } else { mp - 9L }).to_int()
  let year = (y + (if m <= 2 { 1L } else { 0L })).to_int()

  ej_write_4digits(sb, year)
  sb.write_byte(b'-')
  ej_write_2digits(sb, m)
  sb.write_byte(b'-')
  ej_write_2digits(sb, d)
  sb.write_byte(b'T')
  ej_write_2digits(sb, hour)
  sb.write_byte(b':')
  ej_write_2digits(sb, minute)
  sb.write_byte(b':')
  ej_write_2digits(sb, second)
  if millis != 0 {
    sb.write_byte(b'.')
    ej_write_3digits(sb, millis)
  }
  sb.write_byte(b'Z')
}

fn ej_days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = year.to_int64() - (if month <= 2 { 1L } else { 0L })
  let era = (if y >= 0L { y } else { y - 399L }) / 400L
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let doy = (153L * (if m > 2L { m - 3L } else { m + 9L }) + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn ej_is_leap_year(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn ej_days_in_month(y : Int, m : Int) -> Int {
  if m == 2 {
    if ej_is_leap_year(y) { 29 } else { 28 }
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else {
    31
  }
}

fn ej_parse_digits(s : String, start : Int, count : Int) -> Int {
  if start + count > s.length() {
    return -1
  }
  let mut v = 0
  let mut i = 0
  while i < count {
    let c = s.code_unit_at(start + i)
    if c < 48 || c > 57 {
      return -1
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  v
}

fn ej_parse_iso8601_ms(s : String) -> Result[Int64, BsonError] {
  let n = s.length()
  if n < 20 {
    return Err(BsonError::InvalidExtJson("ISO-8601 date too short"))
  }
  let year = ej_parse_digits(s, 0, 4)
  if year < 0 || s.code_unit_at(4) != 45 {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 year"))
  }
  let month = ej_parse_digits(s, 5, 2)
  if month < 1 || month > 12 || s.code_unit_at(7) != 45 {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 month"))
  }
  let day = ej_parse_digits(s, 8, 2)
  if day < 1 || day > ej_days_in_month(year, month) {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 day"))
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 {
    return Err(BsonError::InvalidExtJson("expected 'T' in ISO-8601 date"))
  }
  let hour = ej_parse_digits(s, 11, 2)
  if hour < 0 || hour > 23 || s.code_unit_at(13) != 58 {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 hour"))
  }
  let minute = ej_parse_digits(s, 14, 2)
  if minute < 0 || minute > 59 || s.code_unit_at(16) != 58 {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 minute"))
  }
  let second = ej_parse_digits(s, 17, 2)
  if second < 0 || second > 59 {
    return Err(BsonError::InvalidExtJson("invalid ISO-8601 second"))
  }

  let mut pos = 19
  let mut millis = 0
  if pos < n && s.code_unit_at(pos) == 46 {
    pos = pos + 1
    let frac_start = pos
    let mut weight = 100
    while pos < n {
      let c = s.code_unit_at(pos)
      if c < 48 || c > 57 {
        break
      }
      if weight > 0 {
        millis = millis + (c - 48) * weight
        weight = weight / 10
      }
      pos = pos + 1
    }
    if pos == frac_start {
      return Err(BsonError::InvalidExtJson("empty fractional seconds in ISO-8601 date"))
    }
  }

  if pos >= n {
    return Err(BsonError::InvalidExtJson("missing timezone in ISO-8601 date"))
  }
  let mut tz_offset_secs : Int64 = 0L
  let tzc = s.code_unit_at(pos)
  if tzc == 90 || tzc == 122 {
    pos = pos + 1
  } else if tzc == 43 || tzc == 45 {
    let tz_neg = tzc == 45
    pos = pos + 1
    let tzh = ej_parse_digits(s, pos, 2)
    if tzh < 0 || tzh > 23 {
      return Err(BsonError::InvalidExtJson("invalid timezone hour"))
    }
    pos = pos + 2
    let mut tzm = 0
    if pos < n {
      if s.code_unit_at(pos) == 58 {
        pos = pos + 1
      }
      tzm = ej_parse_digits(s, pos, 2)
      if tzm < 0 || tzm > 59 {
        return Err(BsonError::InvalidExtJson("invalid timezone minute"))
      }
      pos = pos + 2
    }
    let off = (tzh * 3600 + tzm * 60).to_int64()
    tz_offset_secs = if tz_neg { -off } else { off }
  } else {
    return Err(BsonError::InvalidExtJson("invalid timezone specifier"))
  }
  if pos != n {
    return Err(BsonError::InvalidExtJson("trailing characters in ISO-8601 date"))
  }

  let days = ej_days_from_civil(year, month, day)
  let secs = days * 86400L + (hour * 3600 + minute * 60 + second).to_int64() - tz_offset_secs
  Ok(secs * 1000L + millis.to_int64())
}

fn ej_format_finite_double(d : Double) -> String {
  let bits = d.to_bits()
  if bits == (-9223372036854775807L - 1L) {
    // -0.0
    return "-0.0"
  }
  if bits == 0L {
    return "0.0"
  }
  let s = match json5::to_json_string(json5::Json5Value::Number(d)) {
    Ok(v) => v
    Err(_) => "0.0"
  }
  // Ensure double always has decimal point or exponent
  let n = s.length()
  let mut has_dot_or_exp = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 46 || c == 101 || c == 69 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  if has_dot_or_exp {
    s
  } else {
    s + ".0"
  }
}

fn ej_is_double_nan(d : Double) -> Bool {
  let bits = d.to_bits()
  let exp = (bits >> 52) & 0x7FFL
  let frac = bits & 0xFFFFFFFFFFFFFL
  exp == 0x7FFL && frac != 0L
}

fn ej_is_double_pos_inf(d : Double) -> Bool {
  d.to_bits() == 0x7FF0000000000000L
}

fn ej_is_double_neg_inf(d : Double) -> Bool {
  d.to_bits() == (-9223372036854775807L - 1L | 0x7FF0000000000000L)
}

struct SerFrame {
  is_array : Bool
  doc_entries : Array[(String, BsonValue)]
  arr_items : Array[BsonValue]
  mut idx : Int
  close_suffix : String
}

///| Serialize a `BsonDocument` to Extended JSON v2 (`Canonical` or `Relaxed`).
pub fn to_extjson(doc : BsonDocument, mode : ExtJsonMode) -> Result[String, BsonError] {
  to_extjson_with_limits(doc, mode, BsonLimits::default())
}

///| Serialize a `BsonDocument` to Extended JSON v2 with explicit limits (100% iterative).
pub fn to_extjson_with_limits(
  doc : BsonDocument,
  mode : ExtJsonMode,
  limits : BsonLimits,
) -> Result[String, BsonError] {
  if limits.max_depth < 0 || limits.max_doc_bytes < 0 || limits.max_elements < 0 {
    return Err(BsonError::LimitExceeded("negative limit"))
  }
  let relaxed = match mode {
    ExtJsonMode::Relaxed => true
    ExtJsonMode::Canonical => false
  }
  let sb = StringBuilder::new()
  sb.write_byte(b'{')

  let stack : Array[SerFrame] = [
    SerFrame::{
      is_array: false,
      doc_entries: doc.entries,
      arr_items: [],
      idx: 0,
      close_suffix: "}",
    },
  ]
  let mut total_elements = 0

  while stack.length() > 0 {
    let f = stack[stack.length() - 1]
    let count = if f.is_array { f.arr_items.length() } else { f.doc_entries.length() }
    if f.idx >= count {
      sb.write_string(f.close_suffix)
      let _ = stack.pop()
      continue
    }

    total_elements = total_elements + 1
    if total_elements > limits.max_elements {
      return Err(BsonError::MaxElementsExceeded(limits.max_elements))
    }

    let cur_idx = f.idx
    f.idx = cur_idx + 1
    if cur_idx > 0 {
      sb.write_byte(b',')
    }

    let mut bval = BsonValue::Null
    if f.is_array {
      bval = f.arr_items[cur_idx]
    } else {
      let (k, v) = f.doc_entries[cur_idx]
      ej_write_escaped_str(sb, k)
      sb.write_byte(b':')
      bval = v
    }

    match bval {
      BsonValue::Double(d) => {
        if ej_is_double_nan(d) {
          sb.write_string("{\"$numberDouble\":\"NaN\"}")
        } else if ej_is_double_pos_inf(d) {
          sb.write_string("{\"$numberDouble\":\"Infinity\"}")
        } else if ej_is_double_neg_inf(d) {
          sb.write_string("{\"$numberDouble\":\"-Infinity\"}")
        } else {
          let ds = ej_format_finite_double(d)
          if relaxed {
            sb.write_string(ds)
          } else {
            sb.write_string("{\"$numberDouble\":\"")
            sb.write_string(ds)
            sb.write_string("\"}")
          }
        }
      }
      BsonValue::Str(s) => ej_write_escaped_str(sb, s)
      BsonValue::Document(sub) => {
        if stack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        sb.write_byte(b'{')
        stack.push(
          SerFrame::{
            is_array: false,
            doc_entries: sub.entries,
            arr_items: [],
            idx: 0,
            close_suffix: "}",
          },
        )
      }
      BsonValue::Array(items) => {
        if stack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        sb.write_byte(b'[')
        stack.push(
          SerFrame::{
            is_array: true,
            doc_entries: [],
            arr_items: items,
            idx: 0,
            close_suffix: "]",
          },
        )
      }
      BsonValue::Binary(sub, b) => {
        let sub_b = sub.to_byte()
        sb.write_string("{\"$binary\":{\"base64\":\"")
        sb.write_string(base64::encode(b))
        sb.write_string("\",\"subType\":\"")
        sb.write_byte(ej_hex_lower[(sub_b >> 4) & 0xF])
        sb.write_byte(ej_hex_lower[sub_b & 0xF])
        sb.write_string("\"}}")
      }
      BsonValue::Undefined => sb.write_string("{\"$undefined\":true}")
      BsonValue::ObjectId(oid) => {
        sb.write_string("{\"$oid\":\"")
        sb.write_string(oid.to_hex())
        sb.write_string("\"}")
      }
      BsonValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      BsonValue::DateTime(ms) => {
        if relaxed && ms >= 0L && ms <= ej_relaxed_date_max_ms {
          sb.write_string("{\"$date\":\"")
          ej_write_iso8601_utc(sb, ms)
          sb.write_string("\"}")
        } else {
          sb.write_string("{\"$date\":{\"$numberLong\":\"")
          sb.write_string(ms.to_string())
          sb.write_string("\"}}")
        }
      }
      BsonValue::Null => sb.write_string("null")
      BsonValue::Regex(pat, opts) => {
        sb.write_string("{\"$regularExpression\":{\"pattern\":")
        ej_write_escaped_str(sb, pat)
        sb.write_string(",\"options\":")
        ej_write_escaped_str(sb, opts)
        sb.write_string("}}")
      }
      BsonValue::DbPointer(ns, oid) => {
        sb.write_string("{\"$dbPointer\":{\"$ref\":")
        ej_write_escaped_str(sb, ns)
        sb.write_string(",\"$id\":{\"$oid\":\"")
        sb.write_string(oid.to_hex())
        sb.write_string("\"}}}")
      }
      BsonValue::JavaScript(code) => {
        sb.write_string("{\"$code\":")
        ej_write_escaped_str(sb, code)
        sb.write_byte(b'}')
      }
      BsonValue::Symbol(sym) => {
        sb.write_string("{\"$symbol\":")
        ej_write_escaped_str(sb, sym)
        sb.write_byte(b'}')
      }
      BsonValue::JavaScriptWithScope(code, jscope) => {
        if stack.length() > limits.max_depth {
          return Err(BsonError::MaxDepthExceeded(limits.max_depth))
        }
        sb.write_string("{\"$code\":")
        ej_write_escaped_str(sb, code)
        sb.write_string(",\"$scope\":{")
        stack.push(
          SerFrame::{
            is_array: false,
            doc_entries: jscope.entries,
            arr_items: [],
            idx: 0,
            close_suffix: "}}",
          },
        )
      }
      BsonValue::Int32(n) => {
        if relaxed {
          sb.write_string(n.to_string())
        } else {
          sb.write_string("{\"$numberInt\":\"")
          sb.write_string(n.to_string())
          sb.write_string("\"}")
        }
      }
      BsonValue::Timestamp(t, inc) => {
        sb.write_string("{\"$timestamp\":{\"t\":")
        sb.write_string(t.to_string())
        sb.write_string(",\"i\":")
        sb.write_string(inc.to_string())
        sb.write_string("}}")
      }
      BsonValue::Int64(n) => {
        if relaxed {
          sb.write_string(n.to_string())
        } else {
          sb.write_string("{\"$numberLong\":\"")
          sb.write_string(n.to_string())
          sb.write_string("\"}")
        }
      }
      BsonValue::Decimal128(dec) => {
        sb.write_string("{\"$numberDecimal\":\"")
        sb.write_string(dec.to_string())
        sb.write_string("\"}")
      }
      BsonValue::MinKey => sb.write_string("{\"$minKey\":1}")
      BsonValue::MaxKey => sb.write_string("{\"$maxKey\":1}")
    }
  }

  Ok(sb.to_string())
}

// ---------------------------------------------------------------------------
// Extended JSON v2 Iterative Parser
// ---------------------------------------------------------------------------

fn ej_skip_ws(s : String, pos : Int, n : Int) -> Int {
  let mut p = pos
  while p < n {
    let c = s.code_unit_at(p)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      p = p + 1
    } else {
      break
    }
  }
  p
}

fn ej_hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn ej_parse_hex4(s : String, pos : Int, n : Int) -> Int {
  if pos + 4 > n {
    return -1
  }
  let d0 = ej_hex_digit(s.code_unit_at(pos))
  let d1 = ej_hex_digit(s.code_unit_at(pos + 1))
  let d2 = ej_hex_digit(s.code_unit_at(pos + 2))
  let d3 = ej_hex_digit(s.code_unit_at(pos + 3))
  if d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0 {
    return -1
  }
  (d0 << 12) | (d1 << 8) | (d2 << 4) | d3
}

fn ej_write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn ej_parse_json_string(s : String, start : Int, n : Int) -> Result[(String, Int), BsonError] {
  if start >= n || s.code_unit_at(start) != 34 {
    return Err(BsonError::InvalidExtJson("expected '\"'"))
  }
  let mut p = start + 1
  // Fast path: scan for closing quote without escapes
  let scan_start = p
  while p < n {
    let c = s.code_unit_at(p)
    if c == 34 {
      return Ok((s.slice(scan_start, p), p + 1))
    }
    if c == 92 || c < 0x20 {
      break
    }
    p = p + 1
  }
  if p >= n {
    return Err(BsonError::InvalidExtJson("unterminated string"))
  }
  let sb = StringBuilder::new()
  if p > scan_start {
    sb.write_string(s.slice(scan_start, p))
  }
  while p < n {
    let c = s.code_unit_at(p)
    if c == 34 {
      return Ok((sb.to_string(), p + 1))
    }
    if c < 0x20 {
      return Err(BsonError::InvalidExtJson("unescaped control character in string"))
    }
    if c == 92 {
      p = p + 1
      if p >= n {
        return Err(BsonError::InvalidExtJson("unterminated escape"))
      }
      let esc = s.code_unit_at(p)
      p = p + 1
      if esc == 34 {
        sb.write_byte(b'"')
      } else if esc == 92 {
        sb.write_byte(b'\\')
      } else if esc == 47 {
        sb.write_byte(b'/')
      } else if esc == 98 {
        sb.write_byte((8).to_byte())
      } else if esc == 102 {
        sb.write_byte((12).to_byte())
      } else if esc == 110 {
        sb.write_byte(b'\n')
      } else if esc == 114 {
        sb.write_byte(b'\r')
      } else if esc == 116 {
        sb.write_byte(b'\t')
      } else if esc == 117 {
        let u1 = ej_parse_hex4(s, p, n)
        if u1 < 0 {
          return Err(BsonError::InvalidExtJson("invalid \\uXXXX escape"))
        }
        p = p + 4
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          // High surrogate: must be followed by \uDC00..DFFF
          if p + 6 > n || s.code_unit_at(p) != 92 || s.code_unit_at(p + 1) != 117 {
            return Err(BsonError::InvalidExtJson("unpaired high surrogate"))
          }
          let u2 = ej_parse_hex4(s, p + 2, n)
          if u2 < 0xDC00 || u2 > 0xDFFF {
            return Err(BsonError::InvalidExtJson("invalid low surrogate"))
          }
          p = p + 6
          let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
          ej_write_utf8_cp(sb, cp)
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          return Err(BsonError::InvalidExtJson("unpaired low surrogate"))
        } else {
          ej_write_utf8_cp(sb, u1)
        }
      } else {
        return Err(BsonError::InvalidExtJson("invalid escape sequence"))
      }
    } else {
      let chunk_s = p
      while p < n {
        let ch = s.code_unit_at(p)
        if ch == 34 || ch == 92 || ch < 0x20 {
          break
        }
        p = p + 1
      }
      sb.write_string(s.slice(chunk_s, p))
    }
  }
  Err(BsonError::InvalidExtJson("unterminated string"))
}

fn ej_parse_i64_exact(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut p = 0
  let mut neg = false
  let c0 = s.code_unit_at(0)
  if c0 == 45 {
    neg = true
    p = 1
  } else if c0 == 43 {
    p = 1
  }
  if p >= n {
    return None
  }
  // Accumulate as negative to handle i64::MIN (-9223372036854775808) cleanly
  let limit : Int64 = if neg { -9223372036854775807L - 1L } else { -9223372036854775807L }
  let multmin : Int64 = limit / 10L
  let mut acc : Int64 = 0L
  while p < n {
    let c = s.code_unit_at(p)
    if c < 48 || c > 57 {
      return None
    }
    let d = (c - 48).to_int64()
    if acc < multmin {
      return None
    }
    acc = acc * 10L
    if acc < limit + d {
      return None
    }
    acc = acc - d
    p = p + 1
  }
  Some(if neg { acc } else { -acc })
}

fn ej_parse_double_str(s : String) -> Result[Double, BsonError] {
  if s == "NaN" {
    return Ok(Double::from_bits(0x7FF8000000000000L))
  }
  if s == "Infinity" || s == "+Infinity" {
    return Ok(Double::from_bits(0x7FF0000000000000L))
  }
  if s == "-Infinity" {
    return Ok(Double::from_bits((-9223372036854775807L - 1L) | 0x7FF0000000000000L))
  }
  // Normalize leading '+' or '-0.0' for strict JSON float parsing via json5
  let mut norm = s
  if norm.length() > 0 && norm.code_unit_at(0) == 43 {
    norm = norm.slice(1, norm.length())
  }
  match json5::parse_with_options(norm, json5::ParseOptions::strict_json()) {
    Ok(json5::Json5Value::Number(d)) => Ok(d)
    _ => Err(BsonError::InvalidExtJson("invalid double literal: " + s))
  }
}

fn ej_parse_json_number(s : String, start : Int, n : Int) -> Result[(BsonValue, Int), BsonError] {
  let mut p = start
  let mut is_neg = false
  if p < n && s.code_unit_at(p) == 45 {
    is_neg = true
    p = p + 1
  }
  if p >= n {
    return Err(BsonError::InvalidExtJson("invalid number"))
  }
  let c0 = s.code_unit_at(p)
  if c0 == 48 {
    p = p + 1
  } else if c0 >= 49 && c0 <= 57 {
    p = p + 1
    while p < n && s.code_unit_at(p) >= 48 && s.code_unit_at(p) <= 57 {
      p = p + 1
    }
  } else {
    return Err(BsonError::InvalidExtJson("invalid number"))
  }
  let mut is_float = false
  if p < n && s.code_unit_at(p) == 46 {
    is_float = true
    p = p + 1
    let fs = p
    while p < n && s.code_unit_at(p) >= 48 && s.code_unit_at(p) <= 57 {
      p = p + 1
    }
    if p == fs {
      return Err(BsonError::InvalidExtJson("missing digits after decimal point"))
    }
  }
  if p < n && (s.code_unit_at(p) == 101 || s.code_unit_at(p) == 69) {
    is_float = true
    p = p + 1
    if p < n && (s.code_unit_at(p) == 43 || s.code_unit_at(p) == 45) {
      p = p + 1
    }
    let es = p
    while p < n && s.code_unit_at(p) >= 48 && s.code_unit_at(p) <= 57 {
      p = p + 1
    }
    if p == es {
      return Err(BsonError::InvalidExtJson("missing exponent digits"))
    }
  }
  let tok = s.slice(start, p)
  if !is_float {
    // Reject "-0" as integer -> Double(-0.0)
    if is_neg && tok == "-0" {
      return Ok((BsonValue::Double(Double::from_bits(-9223372036854775807L - 1L)), p))
    }
    match ej_parse_i64_exact(tok) {
      Some(v) => {
        if v >= -2147483648L && v <= 2147483647L {
          return Ok((BsonValue::Int32(v.to_int()), p))
        }
        return Ok((BsonValue::Int64(v), p))
      }
      None => ()
    }
  }
  let d = match ej_parse_double_str(tok) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok((BsonValue::Double(d), p))
}

fn ej_parse_uuid_str(u : String) -> Result[Bytes, BsonError] {
  // Format: 8-4-4-4-12 = 36 chars
  if u.length() != 36 {
    return Err(BsonError::InvalidExtJson("$uuid must be 36 characters"))
  }
  if u.code_unit_at(8) != 45 ||
  u.code_unit_at(13) != 45 ||
  u.code_unit_at(18) != 45 ||
  u.code_unit_at(23) != 45 {
    return Err(BsonError::InvalidExtJson("$uuid missing hyphens"))
  }
  let out = Bytes::new(16)
  let mut si = 0
  let mut bi = 0
  while bi < 16 {
    if si == 8 || si == 13 || si == 18 || si == 23 {
      si = si + 1
    }
    let hi = ej_hex_digit(u.code_unit_at(si))
    let lo = ej_hex_digit(u.code_unit_at(si + 1))
    if hi < 0 || lo < 0 {
      return Err(BsonError::InvalidExtJson("invalid hex in $uuid"))
    }
    out[bi] = ((hi << 4) | lo).to_byte()
    si = si + 2
    bi = bi + 1
  }
  Ok(out)
}

fn ej_parse_hex_byte(s : String) -> Option[Int] {
  if s.length() == 1 {
    let d = ej_hex_digit(s.code_unit_at(0))
    if d < 0 { None } else { Some(d) }
  } else if s.length() == 2 {
    let hi = ej_hex_digit(s.code_unit_at(0))
    let lo = ej_hex_digit(s.code_unit_at(1))
    if hi < 0 || lo < 0 { None } else { Some((hi << 4) | lo) }
  } else {
    None
  }
}

fn ej_convert_special_object(entries : Array[(String, BsonValue)]) -> Result[BsonValue, BsonError] {
  let n = entries.length()
  if n == 0 {
    return Ok(BsonValue::Document(BsonDocument::{ entries: entries }))
  }
  let (k0, v0) = entries[0]
  if n == 1 {
    if k0 == "$oid" {
      match v0 {
        BsonValue::Str(hex) => {
          let oid = match ObjectId::from_hex(hex) {
            Ok(o) => o
            Err(e) => return Err(e)
          }
          return Ok(BsonValue::ObjectId(oid))
        }
        _ => return Err(BsonError::InvalidExtJson("$oid must be a string"))
      }
    }
    if k0 == "$numberInt" {
      match v0 {
        BsonValue::Str(ns) => {
          match ej_parse_i64_exact(ns) {
            Some(v) => {
              if v < -2147483648L || v > 2147483647L {
                return Err(BsonError::InvalidExtJson("$numberInt out of i32 range"))
              }
              return Ok(BsonValue::Int32(v.to_int()))
            }
            None => return Err(BsonError::InvalidExtJson("invalid $numberInt: " + ns))
          }
        }
        _ => return Err(BsonError::InvalidExtJson("$numberInt must be a string"))
      }
    }
    if k0 == "$numberLong" {
      match v0 {
        BsonValue::Str(ns) => {
          match ej_parse_i64_exact(ns) {
            Some(v) => return Ok(BsonValue::Int64(v))
            None => return Err(BsonError::InvalidExtJson("invalid $numberLong: " + ns))
          }
        }
        _ => return Err(BsonError::InvalidExtJson("$numberLong must be a string"))
      }
    }
    if k0 == "$numberDouble" {
      match v0 {
        BsonValue::Str(ds) => {
          let d = match ej_parse_double_str(ds) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          return Ok(BsonValue::Double(d))
        }
        _ => return Err(BsonError::InvalidExtJson("$numberDouble must be a string"))
      }
    }
    if k0 == "$numberDecimal" {
      match v0 {
        BsonValue::Str(ds) => {
          let dec = match Decimal128::from_string(ds) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          return Ok(BsonValue::Decimal128(dec))
        }
        _ => return Err(BsonError::InvalidExtJson("$numberDecimal must be a string"))
      }
    }
    if k0 == "$date" {
      match v0 {
        BsonValue::Int64(ms) => return Ok(BsonValue::DateTime(ms))
        BsonValue::Int32(ms) => return Ok(BsonValue::DateTime(ms.to_int64()))
        BsonValue::Str(iso) => {
          let ms = match ej_parse_iso8601_ms(iso) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          return Ok(BsonValue::DateTime(ms))
        }
        _ => return Err(BsonError::InvalidExtJson("invalid $date value"))
      }
    }
    if k0 == "$binary" {
      match v0 {
        BsonValue::Document(subdoc) => {
          if subdoc.entries.length() != 2 {
            return Err(BsonError::InvalidExtJson("$binary must have base64 and subType"))
          }
          let mut b64_opt : Option[String] = None
          let mut sub_opt : Option[String] = None
          let mut i = 0
          while i < 2 {
            let (sk, sv) = subdoc.entries[i]
            if sk == "base64" {
              match sv {
                BsonValue::Str(s) => b64_opt = Some(s)
                _ => return Err(BsonError::InvalidExtJson("$binary.base64 must be string"))
              }
            } else if sk == "subType" {
              match sv {
                BsonValue::Str(s) => sub_opt = Some(s)
                _ => return Err(BsonError::InvalidExtJson("$binary.subType must be string"))
              }
            } else {
              return Err(BsonError::InvalidExtJson("unknown $binary field: " + sk))
            }
            i = i + 1
          }
          let b64_s = match b64_opt {
            Some(s) => s
            None => return Err(BsonError::InvalidExtJson("$binary missing base64"))
          }
          let sub_s = match sub_opt {
            Some(s) => s
            None => return Err(BsonError::InvalidExtJson("$binary missing subType"))
          }
          let sub_byte = match ej_parse_hex_byte(sub_s) {
            Some(v) => v
            None => return Err(BsonError::InvalidExtJson("invalid $binary.subType: " + sub_s))
          }
          let raw = match base64::decode(b64_s) {
            Ok(b) => b
            Err(_) => return Err(BsonError::InvalidExtJson("invalid base64 in $binary"))
          }
          return Ok(BsonValue::Binary(BinarySubtype::from_byte(sub_byte), raw))
        }
        _ => return Err(BsonError::InvalidExtJson("$binary must be an object"))
      }
    }
    if k0 == "$uuid" {
      match v0 {
        BsonValue::Str(us) => {
          let raw = match ej_parse_uuid_str(us) {
            Ok(b) => b
            Err(e) => return Err(e)
          }
          return Ok(BsonValue::Binary(BinarySubtype::Uuid, raw))
        }
        _ => return Err(BsonError::InvalidExtJson("$uuid must be a string"))
      }
    }
    if k0 == "$regularExpression" {
      match v0 {
        BsonValue::Document(subdoc) => {
          if subdoc.entries.length() != 2 {
            return Err(BsonError::InvalidExtJson("$regularExpression must have pattern and options"))
          }
          let mut pat_opt : Option[String] = None
          let mut opt_opt : Option[String] = None
          let mut i = 0
          while i < 2 {
            let (sk, sv) = subdoc.entries[i]
            if sk == "pattern" {
              match sv {
                BsonValue::Str(s) => pat_opt = Some(s)
                _ => return Err(BsonError::InvalidExtJson("pattern must be string"))
              }
            } else if sk == "options" {
              match sv {
                BsonValue::Str(s) => opt_opt = Some(s)
                _ => return Err(BsonError::InvalidExtJson("options must be string"))
              }
            } else {
              return Err(BsonError::InvalidExtJson("unknown $regularExpression field"))
            }
            i = i + 1
          }
          match (pat_opt, opt_opt) {
            (Some(p), Some(o)) => return Ok(BsonValue::Regex(p, o))
            _ => return Err(BsonError::InvalidExtJson("$regularExpression missing fields"))
          }
        }
        _ => return Err(BsonError::InvalidExtJson("$regularExpression must be an object"))
      }
    }
    if k0 == "$timestamp" {
      match v0 {
        BsonValue::Document(subdoc) => {
          if subdoc.entries.length() != 2 {
            return Err(BsonError::InvalidExtJson("$timestamp must have t and i"))
          }
          let mut t_opt : Option[Int64] = None
          let mut i_opt : Option[Int64] = None
          let mut idx = 0
          while idx < 2 {
            let (sk, sv) = subdoc.entries[idx]
            let iv = match sv {
              BsonValue::Int32(x) => x.to_int64()
              BsonValue::Int64(x) => x
              _ => return Err(BsonError::InvalidExtJson("$timestamp fields must be integers"))
            }
            if iv < 0L || iv > 4294967295L {
              return Err(BsonError::InvalidTimestamp("$timestamp out of u32 range"))
            }
            if sk == "t" {
              t_opt = Some(iv)
            } else if sk == "i" {
              i_opt = Some(iv)
            } else {
              return Err(BsonError::InvalidExtJson("unknown $timestamp field"))
            }
            idx = idx + 1
          }
          match (t_opt, i_opt) {
            (Some(t), Some(inc)) => return Ok(BsonValue::Timestamp(t, inc))
            _ => return Err(BsonError::InvalidExtJson("$timestamp missing t or i"))
          }
        }
        _ => return Err(BsonError::InvalidExtJson("$timestamp must be an object"))
      }
    }
    if k0 == "$code" {
      match v0 {
        BsonValue::Str(c) => return Ok(BsonValue::JavaScript(c))
        _ => return Err(BsonError::InvalidExtJson("$code must be a string"))
      }
    }
    if k0 == "$symbol" {
      match v0 {
        BsonValue::Str(s) => return Ok(BsonValue::Symbol(s))
        _ => return Err(BsonError::InvalidExtJson("$symbol must be a string"))
      }
    }
    if k0 == "$dbPointer" {
      match v0 {
        BsonValue::Document(subdoc) => {
          if subdoc.entries.length() != 2 {
            return Err(BsonError::InvalidExtJson("$dbPointer must have $ref and $id"))
          }
          let mut ref_opt : Option[String] = None
          let mut id_opt : Option[ObjectId] = None
          let mut i = 0
          while i < 2 {
            let (sk, sv) = subdoc.entries[i]
            if sk == "$ref" {
              match sv {
                BsonValue::Str(s) => ref_opt = Some(s)
                _ => return Err(BsonError::InvalidExtJson("$dbPointer.$ref must be string"))
              }
            } else if sk == "$id" {
              match sv {
                BsonValue::ObjectId(o) => id_opt = Some(o)
                _ => return Err(BsonError::InvalidExtJson("$dbPointer.$id must be ObjectId"))
              }
            } else {
              return Err(BsonError::InvalidExtJson("unknown $dbPointer field"))
            }
            i = i + 1
          }
          match (ref_opt, id_opt) {
            (Some(r), Some(o)) => return Ok(BsonValue::DbPointer(r, o))
            _ => return Err(BsonError::InvalidExtJson("$dbPointer missing $ref or $id"))
          }
        }
        _ => return Err(BsonError::InvalidExtJson("$dbPointer must be an object"))
      }
    }
    if k0 == "$undefined" {
      match v0 {
        BsonValue::Bool(true) => return Ok(BsonValue::Undefined)
        _ => return Err(BsonError::InvalidExtJson("$undefined must be true"))
      }
    }
    if k0 == "$minKey" {
      match v0 {
        BsonValue::Int32(1) => return Ok(BsonValue::MinKey)
        _ => return Err(BsonError::InvalidExtJson("$minKey must be 1"))
      }
    }
    if k0 == "$maxKey" {
      match v0 {
        BsonValue::Int32(1) => return Ok(BsonValue::MaxKey)
        _ => return Err(BsonError::InvalidExtJson("$maxKey must be 1"))
      }
    }
  } else if n == 2 {
    let (k1, v1) = entries[1]
    if (k0 == "$code" && k1 == "$scope") || (k0 == "$scope" && k1 == "$code") {
      let code_v = if k0 == "$code" { v0 } else { v1 }
      let scope_v = if k0 == "$scope" { v0 } else { v1 }
      match (code_v, scope_v) {
        (BsonValue::Str(c), BsonValue::Document(sc)) =>
        return Ok(BsonValue::JavaScriptWithScope(c, sc))
        _ => return Err(BsonError::InvalidExtJson("invalid $code/$jscope types"))
      }
    }
  }
  Ok(BsonValue::Document(BsonDocument::{ entries: entries }))
}

struct ParseFrame {
  is_array : Bool
  entries : Array[(String, BsonValue)]
  arr_items : Array[BsonValue]
  mut cur_key : String
  mut expect_first : Bool
  mut expect_comma_or_end : Bool
}

///| Parse a MongoDB Extended JSON v2 document (Canonical or Relaxed) into a `BsonDocument`.
pub fn from_extjson(src : String) -> Result[BsonDocument, BsonError] {
  from_extjson_with_limits(src, BsonLimits::default())
}

///| Parse a MongoDB Extended JSON v2 document with explicit limits (100% iterative).
pub fn from_extjson_with_limits(
  src : String,
  limits : BsonLimits,
) -> Result[BsonDocument, BsonError] {
  if limits.max_depth < 0 || limits.max_doc_bytes < 0 || limits.max_elements < 0 {
    return Err(BsonError::LimitExceeded("negative limit"))
  }
  let n = src.length()
  if n > limits.max_doc_bytes {
    return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
  }
  let mut pos = ej_skip_ws(src, 0, n)
  if pos >= n || src.code_unit_at(pos) != 123 {
    return Err(BsonError::InvalidExtJson("Extended JSON root must be an object '{'"))
  }
  pos = pos + 1

  let stack : Array[ParseFrame] = [
    ParseFrame::{
      is_array: false,
      entries: [],
      arr_items: [],
      cur_key: "",
      expect_first: true,
      expect_comma_or_end: false,
    },
  ]
  let mut total_elements = 0

  while stack.length() > 0 {
    let f = stack[stack.length() - 1]
    pos = ej_skip_ws(src, pos, n)
    if pos >= n {
      return Err(BsonError::InvalidExtJson("unexpected EOF"))
    }
    let ch = src.code_unit_at(pos)

    if f.is_array {
      if f.expect_first && ch == 93 {
        // ']'
        pos = pos + 1
        let finished = match stack.pop() {
          Some(x) => x
          None => break
        }
        let bval = BsonValue::Array(finished.arr_items)
        let parent = stack[stack.length() - 1]
        if parent.is_array {
          parent.arr_items.push(bval)
        } else {
          parent.entries.push((parent.cur_key, bval))
        }
        parent.expect_comma_or_end = true
        continue
      }
      if f.expect_comma_or_end {
        if ch == 93 {
          pos = pos + 1
          let finished = match stack.pop() {
            Some(x) => x
            None => break
          }
          let bval = BsonValue::Array(finished.arr_items)
          let parent = stack[stack.length() - 1]
          if parent.is_array {
            parent.arr_items.push(bval)
          } else {
            parent.entries.push((parent.cur_key, bval))
          }
          parent.expect_comma_or_end = true
          continue
        }
        if ch != 44 {
          return Err(BsonError::InvalidExtJson("expected ',' or ']' in array"))
        }
        pos = ej_skip_ws(src, pos + 1, n)
        if pos >= n {
          return Err(BsonError::InvalidExtJson("unexpected EOF after ','"))
        }
      }
      f.expect_first = false
      f.expect_comma_or_end = false
    } else {
      if f.expect_first && ch == 125 {
        // '}'
        pos = pos + 1
        let finished = match stack.pop() {
          Some(x) => x
          None => break
        }
        if stack.length() == 0 {
          pos = ej_skip_ws(src, pos, n)
          if pos != n {
            return Err(BsonError::InvalidExtJson("trailing characters after root object"))
          }
          return Ok(BsonDocument::{ entries: finished.entries })
        }
        let bval = match ej_convert_special_object(finished.entries) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let parent = stack[stack.length() - 1]
        if parent.is_array {
          parent.arr_items.push(bval)
        } else {
          parent.entries.push((parent.cur_key, bval))
        }
        parent.expect_comma_or_end = true
        continue
      }
      if f.expect_comma_or_end {
        if ch == 125 {
          pos = pos + 1
          let finished = match stack.pop() {
            Some(x) => x
            None => break
          }
          if stack.length() == 0 {
            pos = ej_skip_ws(src, pos, n)
            if pos != n {
              return Err(BsonError::InvalidExtJson("trailing characters after root object"))
            }
            return Ok(BsonDocument::{ entries: finished.entries })
          }
          let bval = match ej_convert_special_object(finished.entries) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let parent = stack[stack.length() - 1]
          if parent.is_array {
            parent.arr_items.push(bval)
          } else {
            parent.entries.push((parent.cur_key, bval))
          }
          parent.expect_comma_or_end = true
          continue
        }
        if ch != 44 {
          return Err(BsonError::InvalidExtJson("expected ',' or '}' in object"))
        }
        pos = ej_skip_ws(src, pos + 1, n)
        if pos >= n {
          return Err(BsonError::InvalidExtJson("unexpected EOF after ','"))
        }
      }
      f.expect_first = false
      f.expect_comma_or_end = false
      // Parse object key
      let (k, np) = match ej_parse_json_string(src, pos, n) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      f.cur_key = k
      pos = ej_skip_ws(src, np, n)
      if pos >= n || src.code_unit_at(pos) != 58 {
        return Err(BsonError::InvalidExtJson("expected ':' after object key"))
      }
      pos = ej_skip_ws(src, pos + 1, n)
      if pos >= n {
        return Err(BsonError::InvalidExtJson("unexpected EOF after ':'"))
      }
    }

    // Parse value at pos
    total_elements = total_elements + 1
    if total_elements > limits.max_elements {
      return Err(BsonError::MaxElementsExceeded(limits.max_elements))
    }

    let vc = src.code_unit_at(pos)
    if vc == 123 {
      // '{'
      if stack.length() > limits.max_depth {
        return Err(BsonError::MaxDepthExceeded(limits.max_depth))
      }
      pos = pos + 1
      stack.push(
        ParseFrame::{
          is_array: false,
          entries: [],
          arr_items: [],
          cur_key: "",
          expect_first: true,
          expect_comma_or_end: false,
        },
      )
    } else if vc == 91 {
      // '['
      if stack.length() > limits.max_depth {
        return Err(BsonError::MaxDepthExceeded(limits.max_depth))
      }
      pos = pos + 1
      stack.push(
        ParseFrame::{
          is_array: true,
          entries: [],
          arr_items: [],
          cur_key: "",
          expect_first: true,
          expect_comma_or_end: false,
        },
      )
    } else {
      let mut parsed_val = BsonValue::Null
      if vc == 34 {
        let (sv, np) = match ej_parse_json_string(src, pos, n) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        parsed_val = BsonValue::Str(sv)
        pos = np
      } else if vc == 116 {
        // true
        if pos + 4 > n || src.slice(pos, pos + 4) != "true" {
          return Err(BsonError::InvalidExtJson("invalid literal"))
        }
        parsed_val = BsonValue::Bool(true)
        pos = pos + 4
      } else if vc == 102 {
        // false
        if pos + 5 > n || src.slice(pos, pos + 5) != "false" {
          return Err(BsonError::InvalidExtJson("invalid literal"))
        }
        parsed_val = BsonValue::Bool(false)
        pos = pos + 5
      } else if vc == 110 {
        // null
        if pos + 4 > n || src.slice(pos, pos + 4) != "null" {
          return Err(BsonError::InvalidExtJson("invalid literal"))
        }
        parsed_val = BsonValue::Null
        pos = pos + 4
      } else if vc == 45 || (vc >= 48 && vc <= 57) {
        let (nv, np) = match ej_parse_json_number(src, pos, n) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        parsed_val = nv
        pos = np
      } else {
        return Err(BsonError::InvalidExtJson("unexpected token in value"))
      }

      if f.is_array {
        f.arr_items.push(parsed_val)
      } else {
        f.entries.push((f.cur_key, parsed_val))
      }
      f.expect_comma_or_end = true
    }
  }

  Err(BsonError::InvalidExtJson("unexpected EOF"))
}
