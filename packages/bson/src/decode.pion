///| Iterative BSON 1.1 binary decoder (stub for Red phase).

///| Decode a BSON 1.1 document with default limits.
pub fn decode(data : Bytes) -> Result[BsonDocument, BsonError] {
  decode_with_limits(data, BsonLimits::default())
}

///| Decode a BSON 1.1 document with explicit limits.
pub fn decode_with_limits(
  data : Bytes,
  limits : BsonLimits,
) -> Result[BsonDocument, BsonError] {
  let _ = data
  let _ = limits
  Err(BsonError::Unsupported("decode_with_limits not implemented"))
}
