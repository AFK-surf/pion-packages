///| Iterative BSON 1.1 binary decoder with strict UTF-8, NUL, array-key, and DoS limit validation.

fn dec_read_i32_le(data : Bytes, pos : Int) -> Int {
  let b0 = data[pos].to_int()
  let b1 = data[pos + 1].to_int()
  let b2 = data[pos + 2].to_int()
  let b3 = data[pos + 3].to_int()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn dec_read_u32_le_i64(data : Bytes, pos : Int) -> Int64 {
  let b0 = data[pos].to_int().to_int64()
  let b1 = data[pos + 1].to_int().to_int64()
  let b2 = data[pos + 2].to_int().to_int64()
  let b3 = data[pos + 3].to_int().to_int64()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn dec_read_i64_le(data : Bytes, pos : Int) -> Int64 {
  let b0 = data[pos].to_int().to_int64()
  let b1 = data[pos + 1].to_int().to_int64()
  let b2 = data[pos + 2].to_int().to_int64()
  let b3 = data[pos + 3].to_int().to_int64()
  let b4 = data[pos + 4].to_int().to_int64()
  let b5 = data[pos + 5].to_int().to_int64()
  let b6 = data[pos + 6].to_int().to_int64()
  let b7 = data[pos + 7].to_int().to_int64()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
}

fn dec_is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

fn dec_copy_bytes(data : Bytes, start : Int, len : Int) -> Bytes {
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = data[start + i]
    i = i + 1
  }
  out
}

fn dec_bytes_to_string(data : Bytes, start : Int, len : Int) -> String {
  if len == 0 {
    return ""
  }
  dec_copy_bytes(data, start, len).to_string()
}

fn dec_find_nul(data : Bytes, start : Int, limit : Int) -> Int {
  let mut i = start
  while i < limit {
    if data[i].to_int() == 0 {
      return i
    }
    i = i + 1
  }
  -1
}

fn dec_check_array_key(data : Bytes, start : Int, len : Int, idx : Int) -> Bool {
  if idx < 10 {
    return len == 1 && data[start].to_int() == 48 + idx
  }
  if idx < 100 {
    return len == 2 &&
    data[start].to_int() == 48 + idx / 10 &&
    data[start + 1].to_int() == 48 + idx % 10
  }
  let expected = idx.to_string()
  if len != expected.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if data[start + i].to_int() != expected.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

struct DecodeFrame {
  end_pos : Int
  is_array : Bool
  mut array_idx : Int
  entries : Array[(String, BsonValue)]
  arr_items : Array[BsonValue]
  parent_key : String
  is_code_w_scope : Bool
  code_str : String
  cws_end : Int
}

///| Decode a BSON 1.1 document with default limits.
pub fn decode(data : Bytes) -> Result[BsonDocument, BsonError] {
  decode_with_limits(data, BsonLimits::default())
}

///| Decode a BSON 1.1 document with explicit limits (100% iterative).
pub fn decode_with_limits(
  data : Bytes,
  limits : BsonLimits,
) -> Result[BsonDocument, BsonError] {
  if limits.max_depth < 0 || limits.max_doc_bytes < 0 || limits.max_elements < 0 {
    return Err(BsonError::LimitExceeded("negative limit"))
  }
  let total_len = data.length()
  if total_len > limits.max_doc_bytes {
    return Err(BsonError::MaxDocBytesExceeded(limits.max_doc_bytes))
  }
  if total_len < 5 {
    return Err(BsonError::InvalidDocumentLength(total_len))
  }
  let root_len = dec_read_i32_le(data, 0)
  if root_len < 5 {
    return Err(BsonError::InvalidDocumentLength(root_len))
  }
  if root_len > total_len {
    return Err(BsonError::UnexpectedEof(total_len))
  }
  if root_len < total_len {
    return Err(BsonError::TrailingBytes(root_len))
  }
  if data[root_len - 1].to_int() != 0 {
    return Err(BsonError::MissingNullTerminator(root_len - 1))
  }

  let stack : Array[DecodeFrame] = [
    DecodeFrame::{
      end_pos: root_len,
      is_array: false,
      array_idx: 0,
      entries: [],
      arr_items: [],
      parent_key: "",
      is_code_w_scope: false,
      code_str: "",
      cws_end: 0,
    },
  ]

  let mut pos = 4
  let mut total_elements = 0

  while stack.length() > 0 {
    let top_idx = stack.length() - 1
    let frame = stack[top_idx]

    if pos >= frame.end_pos {
      return Err(BsonError::UnexpectedEof(pos))
    }

    let tag = data[pos].to_int()
    pos = pos + 1

    if tag == 0 {
      // End of current document/array
      if pos != frame.end_pos {
        return Err(BsonError::TrailingBytes(pos))
      }
      let finished = match stack.pop() {
        Some(f) => f
        None => break
      }
      if stack.length() == 0 {
        return Ok(BsonDocument::{ entries: finished.entries })
      }
      let parent = stack[stack.length() - 1]
      let bval = if finished.is_code_w_scope {
        if pos != finished.cws_end {
          return Err(BsonError::InvalidDocumentLength(finished.cws_end))
        }
        BsonValue::JavaScriptWithScope(
          finished.code_str,
          BsonDocument::{ entries: finished.entries },
        )
      } else if finished.is_array {
        BsonValue::Array(finished.arr_items)
      } else {
        BsonValue::Document(BsonDocument::{ entries: finished.entries })
      }
      if parent.is_array {
        parent.arr_items.push(bval)
      } else {
        parent.entries.push((finished.parent_key, bval))
      }
      continue
    }

    total_elements = total_elements + 1
    if total_elements > limits.max_elements {
      return Err(BsonError::MaxElementsExceeded(limits.max_elements))
    }

    // Read element key cstring (must end before frame.end_pos - 1)
    let key_nul = dec_find_nul(data, pos, frame.end_pos - 1)
    if key_nul < 0 {
      return Err(BsonError::MissingNullTerminator(pos))
    }
    let key_len = key_nul - pos
    let mut key = ""
    if frame.is_array {
      if limits.validate_array_keys && !dec_check_array_key(data, pos, key_len, frame.array_idx) {
        let got = dec_bytes_to_string(data, pos, key_len)
        return Err(BsonError::InvalidArrayKey(frame.array_idx, got))
      }
      frame.array_idx = frame.array_idx + 1
    } else {
      if !dec_is_valid_utf8_range(data, pos, key_len) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      key = dec_bytes_to_string(data, pos, key_len)
    }
    pos = key_nul + 1

    // Dispatch on element type
    if tag == 0x01 {
      // Double
      if pos + 8 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let bits = dec_read_i64_le(data, pos)
      pos = pos + 8
      let bval = BsonValue::Double(Double::from_bits(bits))
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x02 || tag == 0x0D || tag == 0x0E {
      // String / JavaScript / Symbol
      if pos + 4 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let slen = dec_read_i32_le(data, pos)
      pos = pos + 4
      if slen < 1 || pos + slen > frame.end_pos - 1 {
        return Err(BsonError::InvalidStringLength(slen))
      }
      if data[pos + slen - 1].to_int() != 0 {
        return Err(BsonError::MissingNullTerminator(pos + slen - 1))
      }
      if !dec_is_valid_utf8_range(data, pos, slen - 1) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      let s = dec_bytes_to_string(data, pos, slen - 1)
      pos = pos + slen
      let bval = if tag == 0x02 {
        BsonValue::Str(s)
      } else if tag == 0x0D {
        BsonValue::JavaScript(s)
      } else {
        BsonValue::Symbol(s)
      }
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x03 || tag == 0x04 {
      // Embedded Document or Array
      if stack.length() > limits.max_depth {
        return Err(BsonError::MaxDepthExceeded(limits.max_depth))
      }
      if pos + 5 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let sub_len = dec_read_i32_le(data, pos)
      if sub_len < 5 || pos + sub_len > frame.end_pos - 1 {
        return Err(BsonError::InvalidDocumentLength(sub_len))
      }
      let sub_end = pos + sub_len
      if data[sub_end - 1].to_int() != 0 {
        return Err(BsonError::MissingNullTerminator(sub_end - 1))
      }
      pos = pos + 4
      stack.push(
        DecodeFrame::{
          end_pos: sub_end,
          is_array: tag == 0x04,
          array_idx: 0,
          entries: [],
          arr_items: [],
          parent_key: key,
          is_code_w_scope: false,
          code_str: "",
          cws_end: 0,
        },
      )
    } else if tag == 0x05 {
      // Binary
      if pos + 5 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let blen = dec_read_i32_le(data, pos)
      pos = pos + 4
      if blen < 0 || pos + 1 + blen > frame.end_pos - 1 {
        return Err(BsonError::InvalidBinaryLength(blen))
      }
      let sub_byte = data[pos].to_int()
      pos = pos + 1
      let sub = BinarySubtype::from_byte(sub_byte)
      let payload = if sub_byte == 0x02 {
        // BinaryOld: 4-byte inner length must equal blen - 4
        if blen < 4 {
          return Err(BsonError::InvalidBinaryLength(blen))
        }
        let inner_len = dec_read_i32_le(data, pos)
        if inner_len < 0 || inner_len != blen - 4 {
          return Err(BsonError::InvalidBinaryLength(inner_len))
        }
        let b = dec_copy_bytes(data, pos + 4, inner_len)
        pos = pos + blen
        b
      } else {
        let b = dec_copy_bytes(data, pos, blen)
        pos = pos + blen
        b
      }
      let bval = BsonValue::Binary(sub, payload)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x06 {
      // Undefined
      if frame.is_array {
        frame.arr_items.push(BsonValue::Undefined)
      } else {
        frame.entries.push((key, BsonValue::Undefined))
      }
    } else if tag == 0x07 {
      // ObjectId (12 bytes)
      if pos + 12 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let oid = ObjectId::{ bytes: dec_copy_bytes(data, pos, 12) }
      pos = pos + 12
      let bval = BsonValue::ObjectId(oid)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x08 {
      // Boolean (strictly 0x00 or 0x01)
      if pos + 1 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let b = data[pos].to_int()
      if b != 0 && b != 1 {
        return Err(BsonError::InvalidBoolean(b, pos))
      }
      pos = pos + 1
      let bval = BsonValue::Bool(b == 1)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x09 {
      // UTC DateTime (int64 ms)
      if pos + 8 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let ms = dec_read_i64_le(data, pos)
      pos = pos + 8
      let bval = BsonValue::DateTime(ms)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x0A {
      // Null
      if frame.is_array {
        frame.arr_items.push(BsonValue::Null)
      } else {
        frame.entries.push((key, BsonValue::Null))
      }
    } else if tag == 0x0B {
      // Regex (cstring pattern + cstring options)
      let pat_nul = dec_find_nul(data, pos, frame.end_pos - 1)
      if pat_nul < 0 {
        return Err(BsonError::MissingNullTerminator(pos))
      }
      let pat_len = pat_nul - pos
      if !dec_is_valid_utf8_range(data, pos, pat_len) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      let pat = dec_bytes_to_string(data, pos, pat_len)
      pos = pat_nul + 1
      let opt_nul = dec_find_nul(data, pos, frame.end_pos - 1)
      if opt_nul < 0 {
        return Err(BsonError::MissingNullTerminator(pos))
      }
      let opt_len = opt_nul - pos
      if !dec_is_valid_utf8_range(data, pos, opt_len) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      let opts = dec_bytes_to_string(data, pos, opt_len)
      pos = opt_nul + 1
      let bval = BsonValue::Regex(pat, opts)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x0C {
      // DBPointer (string + 12-byte ObjectId)
      if pos + 4 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let slen = dec_read_i32_le(data, pos)
      pos = pos + 4
      if slen < 1 || pos + slen + 12 > frame.end_pos - 1 {
        return Err(BsonError::InvalidStringLength(slen))
      }
      if data[pos + slen - 1].to_int() != 0 {
        return Err(BsonError::MissingNullTerminator(pos + slen - 1))
      }
      if !dec_is_valid_utf8_range(data, pos, slen - 1) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      let ns = dec_bytes_to_string(data, pos, slen - 1)
      pos = pos + slen
      let oid = ObjectId::{ bytes: dec_copy_bytes(data, pos, 12) }
      pos = pos + 12
      let bval = BsonValue::DbPointer(ns, oid)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x0F {
      // JavaScript Code w/ Scope
      if stack.length() > limits.max_depth {
        return Err(BsonError::MaxDepthExceeded(limits.max_depth))
      }
      if pos + 14 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let cws_start = pos
      let cws_len = dec_read_i32_le(data, pos)
      if cws_len < 14 || cws_start + cws_len > frame.end_pos - 1 {
        return Err(BsonError::InvalidDocumentLength(cws_len))
      }
      let cws_end = cws_start + cws_len
      pos = pos + 4
      let slen = dec_read_i32_le(data, pos)
      pos = pos + 4
      if slen < 1 || pos + slen + 5 > cws_end {
        return Err(BsonError::InvalidStringLength(slen))
      }
      if data[pos + slen - 1].to_int() != 0 {
        return Err(BsonError::MissingNullTerminator(pos + slen - 1))
      }
      if !dec_is_valid_utf8_range(data, pos, slen - 1) {
        return Err(BsonError::InvalidUtf8(pos))
      }
      let code = dec_bytes_to_string(data, pos, slen - 1)
      pos = pos + slen
      let scope_len = dec_read_i32_le(data, pos)
      if scope_len < 5 || pos + scope_len != cws_end {
        return Err(BsonError::InvalidDocumentLength(scope_len))
      }
      if data[cws_end - 1].to_int() != 0 {
        return Err(BsonError::MissingNullTerminator(cws_end - 1))
      }
      pos = pos + 4
      stack.push(
        DecodeFrame::{
          end_pos: cws_end,
          is_array: false,
          array_idx: 0,
          entries: [],
          arr_items: [],
          parent_key: key,
          is_code_w_scope: true,
          code_str: code,
          cws_end: cws_end,
        },
      )
    } else if tag == 0x10 {
      // Int32
      if pos + 4 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let v = dec_read_i32_le(data, pos)
      pos = pos + 4
      let bval = BsonValue::Int32(v)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x11 {
      // Timestamp (4B increment LE, then 4B time LE)
      if pos + 8 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let inc = dec_read_u32_le_i64(data, pos)
      let t = dec_read_u32_le_i64(data, pos + 4)
      pos = pos + 8
      let bval = BsonValue::Timestamp(t, inc)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x12 {
      // Int64
      if pos + 8 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let v = dec_read_i64_le(data, pos)
      pos = pos + 8
      let bval = BsonValue::Int64(v)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0x13 {
      // Decimal128 (16 bytes LE)
      if pos + 16 > frame.end_pos - 1 {
        return Err(BsonError::UnexpectedEof(pos))
      }
      let dec = Decimal128::{ bytes: dec_copy_bytes(data, pos, 16) }
      pos = pos + 16
      let bval = BsonValue::Decimal128(dec)
      if frame.is_array { frame.arr_items.push(bval) } else { frame.entries.push((key, bval)) }
    } else if tag == 0xFF {
      if frame.is_array {
        frame.arr_items.push(BsonValue::MinKey)
      } else {
        frame.entries.push((key, BsonValue::MinKey))
      }
    } else if tag == 0x7F {
      if frame.is_array {
        frame.arr_items.push(BsonValue::MaxKey)
      } else {
        frame.entries.push((key, BsonValue::MaxKey))
      }
    } else {
      return Err(BsonError::InvalidElementType(tag, pos - 1))
    }
  }

  Err(BsonError::UnexpectedEof(pos))
}
