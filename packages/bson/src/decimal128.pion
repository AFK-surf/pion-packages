///| Complete IEEE 754-2008 Binary Integer Decimal (BID) Decimal128 codec.
///| Stored as 16 little-endian bytes (`lo = bytes[0..8]`, `hi = bytes[8..16]`).

let dec128_exp_bias : Int = 6176
let dec128_exp_min : Int = -6176
let dec128_exp_max : Int = 6111
let dec128_max_digits : Int = 34

// 10^34 - 1 = 0x0001ED09BEAD87C0_378D8E63FFFFFFFF
let dec128_max_coeff_hi : UInt64 = 0x0001ED09BEAD87C0UL
let dec128_max_coeff_lo : UInt64 = 0x378D8E63FFFFFFFFUL

fn dec128_read_u64_le(b : Bytes, off : Int) -> UInt64 {
  let b0 = b[off].to_int().to_int64().to_uint64()
  let b1 = b[off + 1].to_int().to_int64().to_uint64()
  let b2 = b[off + 2].to_int().to_int64().to_uint64()
  let b3 = b[off + 3].to_int().to_int64().to_uint64()
  let b4 = b[off + 4].to_int().to_int64().to_uint64()
  let b5 = b[off + 5].to_int().to_int64().to_uint64()
  let b6 = b[off + 6].to_int().to_int64().to_uint64()
  let b7 = b[off + 7].to_int().to_int64().to_uint64()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
}

fn dec128_write_u64_le(b : Bytes, off : Int, v : UInt64) -> Unit {
  b[off] = (v & 0xFFUL).to_int().to_byte()
  b[off + 1] = ((v >> 8) & 0xFFUL).to_int().to_byte()
  b[off + 2] = ((v >> 16) & 0xFFUL).to_int().to_byte()
  b[off + 3] = ((v >> 24) & 0xFFUL).to_int().to_byte()
  b[off + 4] = ((v >> 32) & 0xFFUL).to_int().to_byte()
  b[off + 5] = ((v >> 40) & 0xFFUL).to_int().to_byte()
  b[off + 6] = ((v >> 48) & 0xFFUL).to_int().to_byte()
  b[off + 7] = ((v >> 56) & 0xFFUL).to_int().to_byte()
}

fn dec128_from_u64_pair(lo : UInt64, hi : UInt64) -> Decimal128 {
  let out = Bytes::new(16)
  dec128_write_u64_le(out, 0, lo)
  dec128_write_u64_le(out, 8, hi)
  Decimal128::{ bytes: out }
}

fn u128_gt(a_hi : UInt64, a_lo : UInt64, b_hi : UInt64, b_lo : UInt64) -> Bool {
  if a_hi != b_hi {
    a_hi > b_hi
  } else {
    a_lo > b_lo
  }
}

fn u128_mul10_add(hi : UInt64, lo : UInt64, digit : UInt64) -> (UInt64, UInt64) {
  let x2_lo = lo << 1
  let x2_hi = (hi << 1) | (lo >> 63)
  let x8_lo = lo << 3
  let x8_hi = (hi << 3) | (lo >> 61)
  let s1_lo = x8_lo + x2_lo
  let c1 = if s1_lo < x8_lo { 1UL } else { 0UL }
  let s2_lo = s1_lo + digit
  let c2 = if s2_lo < s1_lo { 1UL } else { 0UL }
  let s_hi = x8_hi + x2_hi + c1 + c2
  (s_hi, s2_lo)
}

fn u128_divmod_1e9(hi : UInt64, lo : UInt64) -> (UInt64, UInt64, Int) {
  let base : UInt64 = 1000000000UL
  let a3 = (hi >> 32) & 0xFFFFFFFFUL
  let q3 = a3 / base
  let r3 = a3 % base
  let a2 = (r3 << 32) | (hi & 0xFFFFFFFFUL)
  let q2 = a2 / base
  let r2 = a2 % base
  let a1 = (r2 << 32) | ((lo >> 32) & 0xFFFFFFFFUL)
  let q1 = a1 / base
  let r1 = a1 % base
  let a0 = (r1 << 32) | (lo & 0xFFFFFFFFUL)
  let q0 = a0 / base
  let r0 = a0 % base
  ((q3 << 32) | q2, (q1 << 32) | q0, r0.to_int())
}

fn ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn eq_ascii_ci(s : String, start : Int, target : String) -> Bool {
  let n = target.length()
  if s.length() - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if ascii_lower(s.code_unit_at(start + i)) != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Construct a `Decimal128` from 16 little-endian BID bytes (copied).
pub fn Decimal128::from_bytes(b : Bytes) -> Result[Decimal128, BsonError] {
  if b.length() != 16 {
    return Err(
      BsonError::InvalidDecimal128("expected 16 bytes, got " + b.length().to_string()),
    )
  }
  let out = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    out[i] = b[i]
    i = i + 1
  }
  Ok(Decimal128::{ bytes: out })
}

///| Return a copy of the 16 little-endian BID bytes.
pub fn Decimal128::to_bytes(self : Decimal128) -> Bytes {
  let out = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    out[i] = self.bytes[i]
    i = i + 1
  }
  out
}

///| Parse a decimal string into an IEEE 754-2008 BID `Decimal128`.
pub fn Decimal128::from_string(s : String) -> Result[Decimal128, BsonError] {
  let n = s.length()
  if n == 0 {
    return Err(BsonError::InvalidDecimal128("empty string"))
  }
  let mut pos = 0
  let mut is_neg = false
  let first = s.code_unit_at(0)
  if first == 43 {
    // '+'
    pos = 1
  } else if first == 45 {
    // '-'
    is_neg = true
    pos = 1
  }
  if pos >= n {
    return Err(BsonError::InvalidDecimal128("sign without digits"))
  }

  // Special values: NaN, sNaN, Inf, Infinity (case-insensitive)
  let c0 = ascii_lower(s.code_unit_at(pos))
  if c0 == 110 || c0 == 115 {
    // 'n' or 's'
    if eq_ascii_ci(s, pos, "nan") || eq_ascii_ci(s, pos, "snan") {
      return Ok(dec128_from_u64_pair(0UL, 0x7C00000000000000UL))
    }
    return Err(BsonError::InvalidDecimal128("invalid special value"))
  }
  if c0 == 105 {
    // 'i'
    if eq_ascii_ci(s, pos, "inf") || eq_ascii_ci(s, pos, "infinity") {
      let hi = if is_neg { 0xF800000000000000UL } else { 0x7800000000000000UL }
      return Ok(dec128_from_u64_pair(0UL, hi))
    }
    return Err(BsonError::InvalidDecimal128("invalid special value"))
  }

  let digits : Array[Int] = []
  let mut seen_digit = false
  let mut seen_dot = false
  let mut seen_nonzero = false
  let mut frac_digits = 0
  let mut trailing_zeros_after_34 = 0

  while pos < n {
    let c = s.code_unit_at(pos)
    if c >= 48 && c <= 57 {
      seen_digit = true
      let d = c - 48
      if seen_dot {
        frac_digits = frac_digits + 1
      }
      if d != 0 || seen_nonzero {
        seen_nonzero = true
        if digits.length() < dec128_max_digits {
          if trailing_zeros_after_34 > 0 {
            return Err(BsonError::InvalidDecimal128("too many significant digits"))
          }
          digits.push(d)
        } else if d == 0 {
          trailing_zeros_after_34 = trailing_zeros_after_34 + 1
        } else {
          return Err(BsonError::InvalidDecimal128("more than 34 significant digits"))
        }
      }
      pos = pos + 1
    } else if c == 46 {
      // '.'
      if seen_dot {
        return Err(BsonError::InvalidDecimal128("multiple decimal points"))
      }
      seen_dot = true
      pos = pos + 1
    } else if c == 101 || c == 69 {
      // 'e' or 'E'
      break
    } else {
      return Err(BsonError::InvalidDecimal128("unexpected character"))
    }
  }

  if !seen_digit {
    return Err(BsonError::InvalidDecimal128("no digits in mantissa"))
  }

  let mut parsed_exp : Int64 = 0L
  if pos < n {
    // Parse exponent after 'e'/'E'
    pos = pos + 1
    if pos >= n {
      return Err(BsonError::InvalidDecimal128("missing exponent digits"))
    }
    let mut exp_neg = false
    let ec0 = s.code_unit_at(pos)
    if ec0 == 43 {
      pos = pos + 1
    } else if ec0 == 45 {
      exp_neg = true
      pos = pos + 1
    }
    if pos >= n {
      return Err(BsonError::InvalidDecimal128("missing exponent digits"))
    }
    let mut exp_digits = 0
    while pos < n {
      let c = s.code_unit_at(pos)
      if c < 48 || c > 57 {
        return Err(BsonError::InvalidDecimal128("invalid exponent character"))
      }
      exp_digits = exp_digits + 1
      // Cap magnitude to prevent Int64 overflow while preserving overflow/underflow detection
      if parsed_exp < 1000000000L {
        parsed_exp = parsed_exp * 10L + (c - 48).to_int64()
      }
      pos = pos + 1
    }
    if exp_digits == 0 {
      return Err(BsonError::InvalidDecimal128("empty exponent"))
    }
    if exp_neg {
      parsed_exp = -parsed_exp
    }
  }

  let mut exp64 = parsed_exp - frac_digits.to_int64() + trailing_zeros_after_34.to_int64()
  let mut sig_len = digits.length()

  if sig_len == 0 {
    // Numeric zero: clamp exponent to valid BID range
    if exp64 > dec128_exp_max.to_int64() {
      exp64 = dec128_exp_max.to_int64()
    } else if exp64 < dec128_exp_min.to_int64() {
      exp64 = dec128_exp_min.to_int64()
    }
    let biased = (exp64.to_int() + dec128_exp_bias).to_int64().to_uint64()
    let sign_bit = if is_neg { 0x8000000000000000UL } else { 0UL }
    return Ok(dec128_from_u64_pair(0UL, sign_bit | (biased << 49)))
  }

  // If exponent is too small (< -6176), strip trailing zeros from digits to raise exponent
  while exp64 < dec128_exp_min.to_int64() && sig_len > 0 && digits[sig_len - 1] == 0 {
    sig_len = sig_len - 1
    exp64 = exp64 + 1L
  }
  if exp64 < dec128_exp_min.to_int64() {
    return Err(BsonError::InvalidDecimal128("exponent underflow"))
  }

  // If exponent is too large (> 6111), pad trailing zeros up to 34 digits to lower exponent
  while exp64 > dec128_exp_max.to_int64() && sig_len < dec128_max_digits {
    digits.push(0)
    sig_len = sig_len + 1
    exp64 = exp64 - 1L
  }
  if exp64 > dec128_exp_max.to_int64() {
    return Err(BsonError::InvalidDecimal128("exponent overflow"))
  }

  // Build 128-bit significand
  let mut sig_hi : UInt64 = 0UL
  let mut sig_lo : UInt64 = 0UL
  let mut i = 0
  while i < sig_len {
    let (nh, nl) = u128_mul10_add(sig_hi, sig_lo, digits[i].to_int64().to_uint64())
    sig_hi = nh
    sig_lo = nl
    i = i + 1
  }

  let biased = (exp64.to_int() + dec128_exp_bias).to_int64().to_uint64()
  let sign_bit = if is_neg { 0x8000000000000000UL } else { 0UL }
  let hi = sign_bit | (biased << 49) | sig_hi
  Ok(dec128_from_u64_pair(sig_lo, hi))
}

///| True if this `Decimal128` represents NaN (quiet or signaling).
pub fn Decimal128::is_nan(self : Decimal128) -> Bool {
  let hi = dec128_read_u64_le(self.bytes, 8)
  ((hi >> 58) & 0x1FUL) == 0x1FUL
}

///| True if this `Decimal128` represents +Infinity or -Infinity.
pub fn Decimal128::is_infinite(self : Decimal128) -> Bool {
  let hi = dec128_read_u64_le(self.bytes, 8)
  ((hi >> 58) & 0x1FUL) == 0x1EUL
}

///| True if the sign bit is set.
pub fn Decimal128::is_negative(self : Decimal128) -> Bool {
  let hi = dec128_read_u64_le(self.bytes, 8)
  (hi >> 63) != 0UL
}

///| True if this `Decimal128` is finite and has numeric value zero.
pub fn Decimal128::is_zero(self : Decimal128) -> Bool {
  let lo = dec128_read_u64_le(self.bytes, 0)
  let hi = dec128_read_u64_le(self.bytes, 8)
  let comb5 = (hi >> 58) & 0x1FUL
  if comb5 == 0x1FUL || comb5 == 0x1EUL {
    return false
  }
  if ((hi >> 61) & 3UL) == 3UL {
    // Non-canonical significand >= 2^113 > 10^34 - 1 -> value is 0
    return true
  }
  let sig_hi = hi & 0x0001FFFFFFFFFFFFUL
  if u128_gt(sig_hi, lo, dec128_max_coeff_hi, dec128_max_coeff_lo) {
    return true
  }
  sig_hi == 0UL && lo == 0UL
}

///| Format a `Decimal128` according to MongoDB BSON / IEEE 754-2008 rules.
pub fn Decimal128::to_string(self : Decimal128) -> String {
  let lo = dec128_read_u64_le(self.bytes, 0)
  let hi = dec128_read_u64_le(self.bytes, 8)
  let is_neg = (hi >> 63) != 0UL
  let comb5 = (hi >> 58) & 0x1FUL
  if comb5 == 0x1FUL {
    return "NaN"
  }
  if comb5 == 0x1EUL {
    return if is_neg { "-Infinity" } else { "Infinity" }
  }

  let mut biased_exp = 0
  let mut sig_hi : UInt64 = 0UL
  let mut sig_lo : UInt64 = 0UL
  if ((hi >> 61) & 3UL) == 3UL {
    // Combination starts with 11 (not 1111x): significand >= 2^113 > 10^34-1 -> value 0
    biased_exp = ((hi >> 47) & 0x3FFFUL).to_int()
    sig_hi = 0UL
    sig_lo = 0UL
  } else {
    biased_exp = ((hi >> 49) & 0x3FFFUL).to_int()
    sig_hi = hi & 0x0001FFFFFFFFFFFFUL
    sig_lo = lo
    if u128_gt(sig_hi, sig_lo, dec128_max_coeff_hi, dec128_max_coeff_lo) {
      sig_hi = 0UL
      sig_lo = 0UL
    }
  }

  let exp = biased_exp - dec128_exp_bias

  // Extract decimal digits into string
  let mut digits = "0"
  if sig_hi != 0UL || sig_lo != 0UL {
    let chunks : Array[Int] = []
    let mut cur_hi = sig_hi
    let mut cur_lo = sig_lo
    while cur_hi != 0UL || cur_lo != 0UL {
      let (nh, nl, rem) = u128_divmod_1e9(cur_hi, cur_lo)
      chunks.push(rem)
      cur_hi = nh
      cur_lo = nl
    }
    let dsb = StringBuilder::new()
    let mut ci = chunks.length() - 1
    dsb.write_string(chunks[ci].to_string())
    ci = ci - 1
    while ci >= 0 {
      let chunk = chunks[ci]
      // Write exactly 9 zero-padded digits
      let mut div = 100000000
      let mut v = chunk
      while div > 0 {
        dsb.write_byte((48 + v / div).to_byte())
        v = v % div
        div = div / 10
      }
      ci = ci - 1
    }
    digits = dsb.to_string()
  }

  let dlen = digits.length()
  let adj_exp = exp + (dlen - 1)
  let sb = StringBuilder::new()
  if is_neg {
    sb.write_byte(b'-')
  }

  if exp > 0 || adj_exp < -6 {
    // Scientific notation
    sb.write_byte(digits.code_unit_at(0).to_byte())
    if dlen > 1 {
      sb.write_byte(b'.')
      sb.write_string(digits.slice(1, dlen))
    }
    sb.write_byte(b'E')
    if adj_exp >= 0 {
      sb.write_byte(b'+')
    }
    sb.write_string(adj_exp.to_string())
  } else if exp == 0 {
    sb.write_string(digits)
  } else if adj_exp >= 0 {
    let split = dlen + exp
    sb.write_string(digits.slice(0, split))
    sb.write_byte(b'.')
    sb.write_string(digits.slice(split, dlen))
  } else {
    sb.write_string("0.")
    let mut z = -adj_exp - 1
    while z > 0 {
      sb.write_byte(b'0')
      z = z - 1
    }
    sb.write_string(digits)
  }
  sb.to_string()
}

///| Bit-exact equality of two `Decimal128` values.
pub fn Decimal128::eq(self : Decimal128, other : Decimal128) -> Bool {
  bytes_equal(self.bytes, other.bytes)
}
