///| cel-spec compliance tests: string/list/map methods, standard macros
///| (has/all/exists/exists_one/map/filter), Timestamp & Duration arithmetic/accessors,
///| type() & type conversions.

///|
test "cel_spec_string_list_map_methods_and_in" {
  let empty = Activation::empty()
  // size() on string (UTF-8 codepoints), bytes (byte len), list, map
  assert_eval_int("size('')", empty, 0L, "size empty string")
  assert_eval_int("''.size()", empty, 0L, "method size empty string")
  assert_eval_int("'hello'.size()", empty, 5L, "size ascii string")
  assert_eval_int("'😀'.size()", empty, 1L, "size emoji codepoint")
  assert_eval_int("'中文测试'.size()", empty, 4L, "size CJK codepoints")
  assert_eval_int("b'😀'.size()", empty, 4L, "size utf8 bytes")
  assert_eval_int("[1, 2, 3].size()", empty, 3L, "size list")
  assert_eval_int("size({'a': 1, 'b': 2})", empty, 2L, "size map")

  // String methods
  assert_eval_bool("'foobar'.contains('oba')", empty, true, "contains true")
  assert_eval_bool("'foobar'.contains('xyz')", empty, false, "contains false")
  assert_eval_bool("'foobar'.startsWith('foo')", empty, true, "startsWith true")
  assert_eval_bool("'foobar'.startsWith('bar')", empty, false, "startsWith false")
  assert_eval_bool("'foobar'.endsWith('bar')", empty, true, "endsWith true")
  assert_eval_bool("'foobar'.endsWith('foo')", empty, false, "endsWith false")
  assert_eval_bool("'abc123'.matches('^[a-z]+[0-9]+$')", empty, true, "method matches true")
  assert_eval_bool("'abc123'.matches('^[0-9]+$')", empty, false, "method matches false")
  assert_eval_bool("matches('hello world', 'wor.*')", empty, true, "global matches true")
  assert_eval_err_kind("'abc'.matches('[unclosed')", empty, CelErrorKind::InvalidArgument, "invalid regex")

  // Concatenation
  assert_eval_str("'foo' + 'bar'", empty, "foobar", "string concat")
  assert_eval_eq("b'ab' + b'cd'", empty, Value::bytes(Bytes::from_array([b'a', b'b', b'c', b'd'])), "bytes concat")
  assert_eval_bool("[1, 2] + [3, 4] == [1, 2, 3, 4]", empty, true, "list concat")

  // `in` operator
  assert_eval_bool("2 in [1, 2, 3]", empty, true, "int in list")
  assert_eval_bool("2u in [1, 2, 3]", empty, true, "uint in int list")
  assert_eval_bool("4 in [1, 2, 3]", empty, false, "missing in list")
  assert_eval_bool("'a' in {'a': 1, 'b': 2}", empty, true, "key in map")
  assert_eval_bool("'c' in {'a': 1, 'b': 2}", empty, false, "missing key in map")
  assert_eval_bool("1u in {1: 'one'}", empty, true, "numeric key in map")
}

///|
test "cel_spec_macros_has_all_exists_map_filter" {
  let req = Value::str_map([
    ("user", Value::str_map([("name", Value::string("alice")), ("role", Value::string("admin"))])),
    ("tags", Value::list([Value::string("prod"), Value::string("canary")])),
  ])
  let act = Activation::from_pairs([("req", req)])

  // has()
  assert_eval_bool("has(req.user)", act, true, "has present field")
  assert_eval_bool("has(req.user.role)", act, true, "has nested present field")
  assert_eval_bool("has(req.user.email)", act, false, "has missing leaf field")
  assert_eval_bool("has(req.missing)", act, false, "has missing top field")
  assert_eval_err_kind("has(req.missing.sub)", act, CelErrorKind::NoSuchField, "has missing intermediate errors")

  // all()
  assert_eval_bool("[1, 2, 3].all(x, x > 0)", act, true, "all true")
  assert_eval_bool("[1, -2, 3].all(x, x > 0)", act, false, "all false")
  assert_eval_bool("[].all(x, x > 0)", act, true, "all empty vacuously true")
  assert_eval_bool("{'a': 1, 'b': 2}.all(k, k.size() == 1)", act, true, "all on map keys")
  // Kleene absorption in all(): false absorbs errors
  assert_eval_bool("[0, 1, 2].all(x, x > 0)", act, false, "all short-circuit false")
  assert_eval_bool("[0, -1].all(x, (10 / x > 0) && (x > 0))", act, false, "all absorbs error when false")
  assert_eval_err_kind("[0, 1].all(x, 10 / x > 0)", act, CelErrorKind::DivisionByZero, "all propagates error if no false")

  // exists()
  assert_eval_bool("[1, 2, 3].exists(x, x == 2)", act, true, "exists true")
  assert_eval_bool("[1, 2, 3].exists(x, x == 9)", act, false, "exists false")
  assert_eval_bool("[].exists(x, true)", act, false, "exists empty false")
  // Kleene absorption in exists(): true absorbs errors
  assert_eval_bool("[0, 2].exists(x, 10 / x == 5)", act, true, "exists absorbs error when true")
  assert_eval_err_kind("[0, 3].exists(x, 10 / x == 5)", act, CelErrorKind::DivisionByZero, "exists propagates error if no true")

  // exists_one()
  assert_eval_bool("[1, 2, 3].exists_one(x, x == 2)", act, true, "exists_one single match")
  assert_eval_bool("[1, 2, 2].exists_one(x, x == 2)", act, false, "exists_one multiple matches")
  assert_eval_bool("[1, 2, 3].exists_one(x, x == 9)", act, false, "exists_one zero matches")
  assert_eval_bool("[].exists_one(x, true)", act, false, "exists_one empty")

  // map() 2-arg and 3-arg
  assert_eval_bool("[1, 2, 3].map(x, x * 2) == [2, 4, 6]", act, true, "map 2-arg")
  assert_eval_bool("[1, 2, 3, 4].map(x, x % 2 == 0, x * 10) == [20, 40]", act, true, "map 3-arg filtered")

  // filter()
  assert_eval_bool("[1, 2, 3, 4, 5].filter(x, x > 2) == [3, 4, 5]", act, true, "filter")

  // Nested macros
  assert_eval_bool("[1, 2].map(x, [10, 20].map(y, x + y)) == [[11, 21], [12, 22]]", act, true, "nested map")
  assert_eval_bool("req.tags.exists(t, t == 'prod') && req.user.role == 'admin'", act, true, "macro with activation")
}

///|
test "cel_spec_timestamp_and_duration" {
  let empty = Activation::empty()
  // Parsing and comparisons
  assert_eval_bool("timestamp('2023-10-15T12:30:45Z') == timestamp('2023-10-15T14:30:45+02:00')", empty, true, "ts offset equality")
  assert_eval_bool("timestamp('2023-10-15T12:30:45Z') < timestamp('2023-10-15T12:30:46Z')", empty, true, "ts ordering")
  assert_eval_bool("timestamp(0) == timestamp('1970-01-01T00:00:00Z')", empty, true, "ts from epoch int")
  assert_eval_bool("duration('1h30m') == duration('90m')", empty, true, "duration equality")
  assert_eval_bool("duration('1.5s') == duration('1500ms')", empty, true, "fractional duration")
  assert_eval_bool("duration('-500ms') < duration('0s')", empty, true, "negative duration")

  // Arithmetic
  assert_eval_bool("timestamp('2023-10-15T12:00:00Z') + duration('1h30m') == timestamp('2023-10-15T13:30:00Z')", empty, true, "ts + dur")
  assert_eval_bool("duration('1h30m') + timestamp('2023-10-15T12:00:00Z') == timestamp('2023-10-15T13:30:00Z')", empty, true, "dur + ts")
  assert_eval_bool("timestamp('2023-10-15T13:30:00Z') - duration('1h30m') == timestamp('2023-10-15T12:00:00Z')", empty, true, "ts - dur")
  assert_eval_bool("timestamp('2023-10-15T13:30:00Z') - timestamp('2023-10-15T12:00:00Z') == duration('1h30m')", empty, true, "ts - ts")
  assert_eval_bool("duration('1h') + duration('30m') == duration('90m')", empty, true, "dur + dur")
  assert_eval_bool("duration('1h') - duration('15m') == duration('45m')", empty, true, "dur - dur")

  // Timestamp accessors (2023-10-15 is Sunday)
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getFullYear()", empty, 2023L, "getFullYear")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getMonth()", empty, 9L, "getMonth 0-indexed (Oct=9)")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getDate()", empty, 15L, "getDate 1-indexed")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getDayOfMonth()", empty, 14L, "getDayOfMonth 0-indexed")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getDayOfWeek()", empty, 0L, "getDayOfWeek Sunday=0")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getHours()", empty, 12L, "getHours UTC")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getHours('+09:00')", empty, 21L, "getHours +09:00")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getMinutes()", empty, 30L, "getMinutes")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getSeconds()", empty, 45L, "getSeconds")
  assert_eval_int("timestamp('2023-10-15T12:30:45.123Z').getMilliseconds()", empty, 123L, "getMilliseconds")

  // Duration accessors
  assert_eval_int("duration('2h30m45s500ms').getHours()", empty, 2L, "dur getHours")
  assert_eval_int("duration('2h30m45s500ms').getMinutes()", empty, 150L, "dur getMinutes total")
  assert_eval_int("duration('2h30m45s500ms').getSeconds()", empty, 9045L, "dur getSeconds total")
  assert_eval_int("duration('2h30m45s500ms').getMilliseconds()", empty, 500L, "dur getMilliseconds subsec")

  // Invalid strings
  assert_eval_err_kind("timestamp('not-a-timestamp')", empty, CelErrorKind::InvalidArgument, "bad timestamp")
  assert_eval_err_kind("duration('12x')", empty, CelErrorKind::InvalidArgument, "bad duration")
}

///|
test "cel_spec_type_and_conversions" {
  let empty = Activation::empty()
  // type()
  assert_eval_bool("type(1) == int", empty, true, "type(int)")
  assert_eval_bool("type(1u) == uint", empty, true, "type(uint)")
  assert_eval_bool("type(1.5) == double", empty, true, "type(double)")
  assert_eval_bool("type('a') == string", empty, true, "type(string)")
  assert_eval_bool("type(b'a') == bytes", empty, true, "type(bytes)")
  assert_eval_bool("type(true) == bool", empty, true, "type(bool)")
  assert_eval_bool("type(null) == null_type", empty, true, "type(null)")
  assert_eval_bool("type([1]) == list", empty, true, "type(list)")
  assert_eval_bool("type({'a': 1}) == map", empty, true, "type(map)")
  assert_eval_bool("type(int) == type", empty, true, "type(type)")

  // int()
  assert_eval_int("int(42)", empty, 42L, "int(int)")
  assert_eval_int("int(42u)", empty, 42L, "int(uint)")
  assert_eval_int("int(3.9)", empty, 3L, "int(double) trunc")
  assert_eval_int("int(-3.9)", empty, -3L, "int(-double) trunc")
  assert_eval_int("int('-123')", empty, -123L, "int(string)")
  assert_eval_int("int(timestamp('1970-01-01T00:01:00Z'))", empty, 60L, "int(timestamp)")
  assert_eval_err_kind("int(18446744073709551615u)", empty, CelErrorKind::Overflow, "int(u64 max) overflow")
  assert_eval_err_kind("int(double('nan'))", empty, CelErrorKind::Overflow, "int(NaN) error")

  // uint()
  assert_eval_uint("uint(42)", empty, 42UL, "uint(int)")
  assert_eval_uint("uint(3.9)", empty, 3UL, "uint(double)")
  assert_eval_uint("uint('42')", empty, 42UL, "uint(string)")
  assert_eval_err_kind("uint(-1)", empty, CelErrorKind::Overflow, "uint(negative int)")
  assert_eval_err_kind("uint(-0.5)", empty, CelErrorKind::Overflow, "uint(negative double)")

  // double()
  assert_eval_eq("double(42)", empty, Value::double(42.0), "double(int)")
  assert_eval_eq("double(42u)", empty, Value::double(42.0), "double(uint)")
  assert_eval_eq("double('3.25')", empty, Value::double(3.25), "double(string)")

  // string()
  assert_eval_str("string(42)", empty, "42", "string(int)")
  assert_eval_str("string(42u)", empty, "42", "string(uint)")
  assert_eval_str("string(true)", empty, "true", "string(bool)")
  assert_eval_str("string(b'hello')", empty, "hello", "string(bytes)")
  assert_eval_str("string(timestamp('2023-10-15T12:30:45Z'))", empty, "2023-10-15T12:30:45Z", "string(timestamp)")
  assert_eval_err_kind("string(b'\\xff\\xfe')", empty, CelErrorKind::InvalidArgument, "string(invalid utf8 bytes)")

  // bytes() & dyn()
  assert_eval_eq("bytes('hi')", empty, Value::bytes(Bytes::from_array([b'h', b'i'])), "bytes(string)")
  assert_eval_int("dyn(1) + 2", empty, 3L, "dyn identity")
}
