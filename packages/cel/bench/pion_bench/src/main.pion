///| Head-to-head benchmark driver for `packages/cel` vs Go `github.com/google/cel-go`.

import "cel"
import "time"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn fnv1a_step(h : Int64, b : Int64) -> Int64 {
  ((h ^ b) * 16777619L) & 0xFFFFFFFFL
}

fn run_w1(world : World, iters : Int) -> Int {
  let env = cel::Env::new()
  .with_var("role", cel::CelType::String)
  .with_var("env", cel::CelType::String)
  .with_var("replicas", cel::CelType::Int)
  .with_var("method", cel::CelType::String)
  .with_var("quota_used", cel::CelType::Int)
  .with_var("cost", cel::CelType::Int)
  .with_var("quota_limit", cel::CelType::Int)
  .with_var("ns", cel::CelType::String)
  .with_var("tier", cel::CelType::String)
  .with_var("labels", cel::CelType::Map(cel::CelType::String, cel::CelType::String))
  .with_var("privileged", cel::CelType::Bool)

  let rules : Array[String] = [
    "role == 'admin' || (env == 'staging' && replicas <= 5)",
    "method == 'GET' || (method == 'POST' && quota_used + cost <= quota_limit)",
    "ns != 'kube-system' && replicas >= 1 && replicas <= 50 && (tier == 'gold' || tier == 'silver')",
    "has(labels.team) && labels.team == 'platform' && !privileged",
  ]
  let progs : Array[cel::Program] = []
  let mut r = 0
  while r < rules.length() {
    match cel::compile(rules[r], env) {
      Ok(p) => progs.push(p)
      Err(e) => {
        io_println(world, "compile error: " + e.to_string())
        return 1
      }
    }
    r = r + 1
  }

  let roles : Array[String] = ["admin", "dev", "viewer", "ops"]
  let envs : Array[String] = ["prod", "staging", "dev", "staging"]
  let methods : Array[String] = ["GET", "POST", "DELETE", "POST"]
  let namespaces : Array[String] = ["default", "kube-system", "payments", "infra"]
  let tiers : Array[String] = ["gold", "bronze", "silver", "gold"]
  let teams : Array[String] = ["platform", "growth", "platform", "ml"]

  let acts : Array[cel::Activation] = []
  let mut k = 0
  while k < 16 {
    let labels = if k % 3 == 0 {
      cel::Value::str_map([("owner", cel::Value::string("sre"))])
    } else {
      cel::Value::str_map([("team", cel::Value::string(teams[k % 4]))])
    }
    acts.push(
      cel::Activation::from_pairs([
        ("role", cel::Value::string(roles[k % 4])),
        ("env", cel::Value::string(envs[(k / 2) % 4])),
        ("replicas", cel::Value::int((k % 12 + 1).to_int64())),
        ("method", cel::Value::string(methods[(k / 4) % 4])),
        ("quota_used", cel::Value::int((k * 100).to_int64())),
        ("cost", cel::Value::int(250L)),
        ("quota_limit", cel::Value::int(1000L)),
        ("ns", cel::Value::string(namespaces[k % 4])),
        ("tier", cel::Value::string(tiers[(k + 1) % 4])),
        ("labels", labels),
        ("privileged", cel::Value::bool(k % 5 == 0)),
      ]),
    )
    k = k + 1
  }

  let mut allow = 0
  let mut deny = 0
  let mut checksum : Int64 = 2166136261L
  let mut i = 0
  while i < iters {
    let act = acts[i & 15]
    let mut j = 0
    while j < progs.length() {
      match progs[j].eval(act) {
        Ok(v) => {
          match v.kind {
            cel::ValueKind::Bool(true) => {
              allow = allow + 1
              checksum = fnv1a_step(checksum, 1L)
            }
            cel::ValueKind::Bool(false) => {
              deny = deny + 1
              checksum = fnv1a_step(checksum, 0L)
            }
            _ => return 2
          }
        }
        Err(e) => {
          io_println(world, "eval error: " + e.to_string())
          return 3
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "w1 ops=" + (iters * 4).to_string() + " allow=" + allow.to_string() + " deny=" + deny.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_w2(world : World, iters : Int) -> Int {
  let env = cel::Env::new()
  .with_var("containers", cel::CelType::List(cel::CelType::Map(cel::CelType::String, cel::CelType::String)))
  .with_var("tags", cel::CelType::List(cel::CelType::String))
  .with_var("scores", cel::CelType::List(cel::CelType::Int))
  .with_var("now", cel::CelType::Timestamp)
  .with_var("expires_at", cel::CelType::Timestamp)

  let rules : Array[String] = [
    "containers.all(c, c.image.matches('^gcr\\\\.io/prod/[a-z0-9-]+:v[0-9]+$')) && now < expires_at",
    "tags.exists(t, t == 'prod' || t == 'canary') && scores.filter(s, s >= 80).size() >= 2 && (expires_at - now) > duration('30m')",
  ]
  let progs : Array[cel::Program] = []
  let mut r = 0
  while r < rules.length() {
    match cel::compile(rules[r], env) {
      Ok(p) => progs.push(p)
      Err(e) => {
        io_println(world, "w2 compile error: " + e.to_string())
        return 1
      }
    }
    r = r + 1
  }

  let base_ts = match time::Timestamp::parse_rfc3339("2026-11-23T10:00:00Z") {
    Ok(t) => t
    Err(_) => return 1
  }

  let acts : Array[cel::Activation] = []
  let mut k = 0
  while k < 16 {
    let img2 = if k % 3 == 0 {
      "docker.io/untrusted/app:latest"
    } else {
      "gcr.io/prod/worker-" + k.to_string() + ":v" + (k + 1).to_string()
    }
    let containers = cel::Value::list([
      cel::Value::str_map([("image", cel::Value::string("gcr.io/prod/api-gw:v12"))]),
      cel::Value::str_map([("image", cel::Value::string(img2))]),
    ])
    let tags = if k % 4 == 0 {
      cel::Value::list([cel::Value::string("dev"), cel::Value::string("nightly")])
    } else if k % 2 == 0 {
      cel::Value::list([cel::Value::string("canary"), cel::Value::string("eu-west")])
    } else {
      cel::Value::list([cel::Value::string("prod"), cel::Value::string("us-east")])
    }
    let scores = cel::Value::list([
      cel::Value::int((60 + (k % 5) * 10).to_int64()),
      cel::Value::int((75 + (k % 4) * 8).to_int64()),
      cel::Value::int((85 + (k % 3) * 5).to_int64()),
    ])
    let delta_secs : Int64 = if k % 5 == 0 {
      -600L
    } else if k % 5 == 1 {
      900L
    } else {
      3600L
    }
    let exp_ts = match time::Timestamp::from_second(base_ts.as_second() + delta_secs) {
      Ok(t) => t
      Err(_) => return 1
    }
    acts.push(
      cel::Activation::from_pairs([
        ("containers", containers),
        ("tags", tags),
        ("scores", scores),
        ("now", cel::Value::timestamp(base_ts)),
        ("expires_at", cel::Value::timestamp(exp_ts)),
      ]),
    )
    k = k + 1
  }

  let mut allow = 0
  let mut deny = 0
  let mut checksum : Int64 = 2166136261L
  let mut i = 0
  while i < iters {
    let act = acts[i & 15]
    let mut j = 0
    while j < progs.length() {
      match progs[j].eval(act) {
        Ok(v) => {
          match v.kind {
            cel::ValueKind::Bool(true) => {
              allow = allow + 1
              checksum = fnv1a_step(checksum, 1L)
            }
            cel::ValueKind::Bool(false) => {
              deny = deny + 1
              checksum = fnv1a_step(checksum, 0L)
            }
            _ => return 2
          }
        }
        Err(e) => {
          io_println(world, "w2 eval error: " + e.to_string())
          return 3
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "w2 ops=" + (iters * 2).to_string() + " allow=" + allow.to_string() + " deny=" + deny.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_w3(world : World, iters : Int) -> Int {
  let env = cel::Env::new()
  .with_var("user", cel::CelType::String)
  .with_var("role", cel::CelType::String)
  .with_var("count", cel::CelType::Int)
  .with_var("tags", cel::CelType::List(cel::CelType::String))
  .with_var("now", cel::CelType::Timestamp)

  let exprs : Array[String] = [
    "role == 'admin' && count > 0",
    "user.startsWith('svc-') || role == 'ops'",
    "tags.exists(t, t == 'prod') && count < 100",
    "tags.all(t, t.size() >= 2 && t.size() <= 16)",
    "tags.filter(t, t.startsWith('us-')).size() >= 1",
    "user.matches('^[a-z]+-[0-9]+$') && count % 2 == 0",
    "now > timestamp('2026-01-01T00:00:00Z') && count + 10 <= 50",
    "(role == 'admin' ? 100 : 10) >= count",
    "'prod' in tags && !(role == 'guest')",
    "tags.map(t, t.size()).exists(n, n >= 4)",
  ]

  let now_ts = match time::Timestamp::parse_rfc3339("2026-11-23T10:00:00Z") {
    Ok(t) => t
    Err(_) => return 1
  }
  let act = cel::Activation::from_pairs([
    ("user", cel::Value::string("svc-42")),
    ("role", cel::Value::string("admin")),
    ("count", cel::Value::int(24L)),
    (
      "tags",
      cel::Value::list([
        cel::Value::string("prod"),
        cel::Value::string("us-east"),
        cel::Value::string("canary"),
      ]),
    ),
    ("now", cel::Value::timestamp(now_ts)),
  ])

  let mut allow = 0
  let mut deny = 0
  let mut checksum : Int64 = 2166136261L
  let mut i = 0
  while i < iters {
    let mut j = 0
    while j < exprs.length() {
      let prog = match cel::compile(exprs[j], env) {
        Ok(p) => p
        Err(e) => {
          io_println(world, "w3 compile error: " + e.to_string())
          return 1
        }
      }
      match prog.eval(act) {
        Ok(v) => {
          match v.kind {
            cel::ValueKind::Bool(true) => {
              allow = allow + 1
              checksum = fnv1a_step(checksum, 1L)
            }
            cel::ValueKind::Bool(false) => {
              deny = deny + 1
              checksum = fnv1a_step(checksum, 0L)
            }
            _ => return 2
          }
        }
        Err(e) => {
          io_println(world, "w3 eval error: " + e.to_string())
          return 3
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "w3 ops=" + (iters * 10).to_string() + " allow=" + allow.to_string() + " deny=" + deny.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_cel <w1|w2|w3> <iters>")
    return 1
  }
  let mode = args[1]
  let iters = parse_int_arg(args[2], 1000)
  if mode == "w1" {
    run_w1(world, iters)
  } else if mode == "w2" {
    run_w2(world, iters)
  } else if mode == "w3" {
    run_w3(world, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
