///| Wasm32 + Native smoke entry for `packages/cel`.

import "cel"
import "time"

///|
pub fn smoke() -> Int {
  // 1. Compiled IAM / K8s admission policy with macros, regex, and timestamp comparison
  let env = cel::Env::new()
  .with_var("req", cel::CelType::Map(cel::CelType::String, cel::CelType::Dyn))
  .with_var("now", cel::CelType::Timestamp)
  let expr = "has(req.user) && req.user.role == 'admin' && req.containers.all(c, c.image.matches('^gcr\\\\.io/prod/[a-z0-9-]+:v[0-9]+$')) && now < req.expires_at"
  let prog = match cel::compile(expr, env) {
    Ok(p) => p
    Err(_) => return -1
  }
  let now_ts = match time::Timestamp::parse_rfc3339("2026-11-23T10:00:00Z") {
    Ok(t) => t
    Err(_) => return -2
  }
  let exp_ts = match time::Timestamp::parse_rfc3339("2026-11-23T12:00:00Z") {
    Ok(t) => t
    Err(_) => return -3
  }
  let req = cel::Value::str_map([
    ("user", cel::Value::str_map([("role", cel::Value::string("admin"))])),
    (
      "containers",
      cel::Value::list([
        cel::Value::str_map([("image", cel::Value::string("gcr.io/prod/api:v12"))]),
        cel::Value::str_map([("image", cel::Value::string("gcr.io/prod/worker-1:v4"))]),
      ]),
    ),
    ("expires_at", cel::Value::timestamp(exp_ts)),
  ])
  let act = cel::Activation::from_pairs([("req", req), ("now", cel::Value::timestamp(now_ts))])
  match prog.eval(act) {
    Ok(v) => {
      if !cel::value_strict_eq(v, cel::Value::bool(true)) {
        return -4
      }
    }
    Err(_) => return -5
  }

  // 2. UTF-8 codepoint length + Kleene 3-valued logic + heterogeneous numeric comparison
  match cel::eval("'😀'.size() == 1 && '中文'.size() == 2 && ((1 / 0 == 0) || true) && 9007199254740993 > 9007199254740992.0", cel::Activation::empty()) {
    Ok(v) => {
      if !cel::value_strict_eq(v, cel::Value::bool(true)) {
        return -6
      }
    }
    Err(_) => return -7
  }

  // 3. Depth bomb + fuel bomb + output bytes bomb (0 trap on Wasm32)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 100 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 100 {
    sb.write_string(")")
    i = i + 1
  }
  let tight_depth = cel::EvalLimits::new(32, 10000L, 4096)
  match cel::parse_with_limits(sb.to_string(), tight_depth) {
    Ok(_) => return -8
    Err(e) => {
      if !e.is_kind(cel::CelErrorKind::LimitExceeded) {
        return -9
      }
    }
  }
  let tight_fuel = cel::EvalLimits::new(64, 40L, 4096)
  match cel::eval_with_limits("[1,2,3,4,5,6,7,8].all(a, [1,2,3,4,5,6,7,8].all(b, a + b > 0))", cel::Activation::empty(), tight_fuel) {
    Ok(_) => return -10
    Err(e) => {
      if !e.is_kind(cel::CelErrorKind::LimitExceeded) {
        return -11
      }
    }
  }

  // 4. Duration & Timestamp arithmetic
  match cel::eval("(timestamp('2026-11-23T10:00:00Z') + duration('1h30m')).getMinutes()", cel::Activation::empty()) {
    Ok(v) => {
      if !cel::value_strict_eq(v, cel::Value::int(30L)) {
        return -12
      }
    }
    Err(_) => return -13
  }
  4
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "cel_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "cel_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
