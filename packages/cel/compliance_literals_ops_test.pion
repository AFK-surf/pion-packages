///| cel-spec compliance tests: literals, escapes, operators, precedence,
///| Kleene short-circuiting, heterogeneous numeric comparisons, overflow,
///| division by zero, and indexing/field errors.

fn assert_eval_eq(expr : String, act : Activation, expected : Value, msg : String) -> Unit {
  match eval(expr, act) {
    Ok(got) => debug_assert(value_strict_eq(got, expected), msg + " (expr: " + expr + ")")
    Err(e) => debug_assert(false, msg + " (unexpected err: " + e.to_string() + ", expr: " + expr + ")")
  }
}

fn assert_eval_bool(expr : String, act : Activation, expected : Bool, msg : String) -> Unit {
  assert_eval_eq(expr, act, Value::bool(expected), msg)
}

fn assert_eval_int(expr : String, act : Activation, expected : Int64, msg : String) -> Unit {
  assert_eval_eq(expr, act, Value::int(expected), msg)
}

fn assert_eval_uint(expr : String, act : Activation, expected : UInt64, msg : String) -> Unit {
  assert_eval_eq(expr, act, Value::uint(expected), msg)
}

fn assert_eval_str(expr : String, act : Activation, expected : String, msg : String) -> Unit {
  assert_eval_eq(expr, act, Value::string(expected), msg)
}

fn assert_eval_err_kind(
  expr : String,
  act : Activation,
  expected_kind : CelErrorKind,
  msg : String,
) -> Unit {
  match eval(expr, act) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok for: " + expr + ")")
    Err(e) =>
    debug_assert(
      e.is_kind(expected_kind),
      msg + " (expected " + error_kind_as_str(expected_kind) + ", got " + e.to_string() + ")",
    )
  }
}

fn assert_eval_any_err(expr : String, act : Activation, msg : String) -> Unit {
  match eval(expr, act) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok for: " + expr + ")")
    Err(e) =>
    debug_assert(
      !e.is_kind(CelErrorKind::Unimplemented),
      msg + " (got Unimplemented instead of real error)",
    )
  }
}

///|
test "cel_spec_literals_primitives" {
  let empty = Activation::empty()
  assert_eval_eq("null", empty, Value::null(), "null literal")
  assert_eval_bool("true", empty, true, "true literal")
  assert_eval_bool("false", empty, false, "false literal")

  // Integers: decimal, hex, min/max int64
  assert_eval_int("0", empty, 0L, "zero")
  assert_eval_int("42", empty, 42L, "decimal int")
  assert_eval_int("-42", empty, -42L, "negative int")
  assert_eval_int("0x2a", empty, 42L, "hex int lower")
  assert_eval_int("0X2A", empty, 42L, "hex int upper")
  assert_eval_int("-0x10", empty, -16L, "negative hex int")
  assert_eval_int("9223372036854775807", empty, 9223372036854775807L, "i64 max")
  assert_eval_int("-9223372036854775808", empty, -9223372036854775807L - 1L, "i64 min")

  // Unsigned integers
  assert_eval_uint("0u", empty, 0UL, "zero uint")
  assert_eval_uint("42U", empty, 42UL, "decimal uint upper U")
  assert_eval_uint("0xffu", empty, 255UL, "hex uint")
  assert_eval_uint("18446744073709551615u", empty, 18446744073709551615UL, "u64 max")

  // Doubles
  assert_eval_eq("0.0", empty, Value::double(0.0), "zero double")
  assert_eval_eq("3.14", empty, Value::double(3.14), "float literal")
  assert_eval_eq(".5", empty, Value::double(0.5), "leading dot double")
  assert_eval_eq("1e3", empty, Value::double(1000.0), "sci double")
  assert_eval_eq("1.5e-2", empty, Value::double(0.015), "sci neg exp double")

  // Comments
  assert_eval_int("1 + // inline comment\n 2", empty, 3L, "line comment")
}

///|
test "cel_spec_strings_escapes_raw_and_bytes" {
  let empty = Activation::empty()
  assert_eval_str("\"hello\"", empty, "hello", "double quoted string")
  assert_eval_str("'world'", empty, "world", "single quoted string")
  assert_eval_str("\"a\\nb\\tc\\\\d\\\"e\\'f\"", empty, "a\nb\tc\\d\"e'f", "standard escapes")
  assert_eval_str("\"\\u0041\\U0001F600\"", empty, "A😀", "unicode escapes")
  assert_eval_str("\"\\101\\x42\"", empty, "AB", "octal and hex string escapes")
  assert_eval_str("'''multi\nline'quote'''", empty, "multi\nline'quote", "triple single quoted")
  assert_eval_str("\"\"\"multi\nline\"quote\"\"\"", empty, "multi\nline\"quote", "triple double quoted")
  assert_eval_str("r\"a\\nb\\t\"", empty, "a\\nb\\t", "raw double quoted")
  assert_eval_str("R'\\d+\\.\\d+'", empty, "\\d+\\.\\d+", "raw single quoted")
  assert_eval_str("r'''raw\\n'''", empty, "raw\\n", "raw triple quoted")

  // Bytes literals
  assert_eval_eq("b\"abc\"", empty, Value::bytes(bytes_from_array([b'a', b'b', b'c'])), "bytes ascii")
  assert_eval_eq("b\"\\x00\\xff\\101\"", empty, Value::bytes(bytes_from_array([b'\x00', b'\xff', b'A'])), "bytes hex/octal escapes")
  assert_eval_err_kind("rb\"\\x41\"", empty, CelErrorKind::SyntaxError, "raw bytes rb rejected per cel-go")
  assert_eval_eq("br'\\n'", empty, Value::bytes(bytes_from_array([b'\\', b'n'])), "raw bytes br")

  // Invalid escapes -> SyntaxError
  assert_eval_err_kind("\"\\q\"", empty, CelErrorKind::SyntaxError, "unknown escape")
  assert_eval_err_kind("\"\\uD800\"", empty, CelErrorKind::SyntaxError, "surrogate unicode escape")
}

///|
test "cel_spec_operator_precedence_and_ternary" {
  let empty = Activation::empty()
  assert_eval_int("1 + 2 * 3", empty, 7L, "mul binds tighter than add")
  assert_eval_int("(1 + 2) * 3", empty, 9L, "parens override precedence")
  assert_eval_int("10 - 3 - 2", empty, 5L, "left associative sub")
  assert_eval_int("20 / 4 / 2", empty, 2L, "left associative div")
  assert_eval_int("-3 * -4", empty, 12L, "unary minus")
  assert_eval_int("--5", empty, 5L, "double unary minus")
  assert_eval_bool("!!true", empty, true, "double logical not")
  assert_eval_bool("true || false && false", empty, true, "&& binds tighter than ||")
  assert_eval_bool("false && true || true", empty, true, "&& binds tighter than || (2)")
  assert_eval_int("true ? 1 : 2", empty, 1L, "ternary true")
  assert_eval_int("false ? 1 : 2", empty, 2L, "ternary false")
  assert_eval_int("false ? 1 : true ? 2 : 3", empty, 2L, "right associative ternary")
  assert_eval_int("true ? 10 : (1 / 0)", empty, 10L, "ternary short-circuit true branch")
  assert_eval_int("false ? (1 / 0) : 20", empty, 20L, "ternary short-circuit false branch")
}

///|
test "cel_spec_kleene_short_circuit_logic" {
  let empty = Activation::empty()
  // Standard short-circuit
  assert_eval_bool("true || (1 / 0 == 0)", empty, true, "true || err => true")
  assert_eval_bool("false && (1 / 0 == 0)", empty, false, "false && err => false")
  // CEL commutative error absorption (Kleene 3-valued logic)
  assert_eval_bool("(1 / 0 == 0) || true", empty, true, "err || true => true")
  assert_eval_bool("(1 / 0 == 0) && false", empty, false, "err && false => false")
  // Non-absorbing error propagation
  assert_eval_err_kind("false || (1 / 0 == 0)", empty, CelErrorKind::DivisionByZero, "false || err => err")
  assert_eval_err_kind("(1 / 0 == 0) || false", empty, CelErrorKind::DivisionByZero, "err || false => err")
  assert_eval_err_kind("true && (1 / 0 == 0)", empty, CelErrorKind::DivisionByZero, "true && err => err")
  assert_eval_err_kind("(1 / 0 == 0) && true", empty, CelErrorKind::DivisionByZero, "err && true => err")
}

///|
test "cel_spec_heterogeneous_numeric_comparisons" {
  let empty = Activation::empty()
  // Equality across int / uint / double
  assert_eval_bool("1 == 1u", empty, true, "int == uint")
  assert_eval_bool("1 == 1.0", empty, true, "int == double")
  assert_eval_bool("1u == 1.0", empty, true, "uint == double")
  assert_eval_bool("-1 == 0u", empty, false, "negative int != uint")
  assert_eval_bool("1 != 1.5", empty, true, "int != fractional double")
  // Precision edge: 2^53 + 1 != double(2^53)
  assert_eval_bool("9007199254740993 == 9007199254740992.0", empty, false, "i64 > 2^53 exactness")
  assert_eval_bool("9007199254740993 > 9007199254740992.0", empty, true, "i64 > 2^53 ordering")
  assert_eval_bool("9007199254740993u > 9007199254740992.0", empty, true, "u64 > 2^53 ordering")
  assert_eval_bool("18446744073709551615u > 9223372036854775807", empty, true, "u64 max > i64 max")
  assert_eval_bool("-1 < 0u", empty, true, "negative int < 0u")
  assert_eval_bool("9223372036854775807 < 9223372036854775808.0", empty, true, "i64 max < 2^63 double")
  // NaN semantics (cel-go: NaN == NaN is false, NaN != NaN is true, ordering against NaN errors)
  assert_eval_bool("double('nan') == double('nan')", empty, false, "NaN == NaN is false")
  assert_eval_bool("double('nan') != double('nan')", empty, true, "NaN != NaN is true")
  assert_eval_err_kind("double('nan') < 1", empty, CelErrorKind::EvalError, "NaN < 1 errors")
  assert_eval_err_kind("double('nan') <= 1", empty, CelErrorKind::EvalError, "NaN <= 1 errors")
  assert_eval_err_kind("1 < double('nan')", empty, CelErrorKind::EvalError, "1 < NaN errors")
  assert_eval_err_kind("1 > double('nan')", empty, CelErrorKind::EvalError, "1 > NaN errors")
  // Container deep equality with heterogeneous numeric elements
  assert_eval_bool("[1, 2, 3] == [1u, 2.0, 3]", empty, true, "list numeric equality")
  assert_eval_bool("{'a': 1, 'b': 2u} == {'b': 2.0, 'a': 1u}", empty, true, "map numeric equality")
  assert_eval_bool("[1, 2] != [1, 2, 3]", empty, true, "list length inequality")
}

///|
test "cel_spec_overflow_divzero_and_bounds" {
  let empty = Activation::empty()
  // Signed int64 overflow
  assert_eval_err_kind("9223372036854775807 + 1", empty, CelErrorKind::Overflow, "i64 add overflow")
  assert_eval_err_kind("-9223372036854775808 - 1", empty, CelErrorKind::Overflow, "i64 sub underflow")
  assert_eval_err_kind("-(-9223372036854775808)", empty, CelErrorKind::Overflow, "i64 neg min overflow")
  assert_eval_err_kind("-9223372036854775808 / -1", empty, CelErrorKind::Overflow, "i64 div min/-1 overflow")
  assert_eval_err_kind("1000000000000 * 1000000000000", empty, CelErrorKind::Overflow, "i64 mul overflow")
  // Unsigned uint64 overflow
  assert_eval_err_kind("18446744073709551615u + 1u", empty, CelErrorKind::Overflow, "u64 add overflow")
  assert_eval_err_kind("0u - 1u", empty, CelErrorKind::Overflow, "u64 sub underflow")
  assert_eval_err_kind("1000000000000u * 1000000000000u", empty, CelErrorKind::Overflow, "u64 mul overflow")
  // Division & modulo by zero
  assert_eval_err_kind("1 / 0", empty, CelErrorKind::DivisionByZero, "i64 div by zero")
  assert_eval_err_kind("1 % 0", empty, CelErrorKind::DivisionByZero, "i64 mod by zero")
  assert_eval_err_kind("1u / 0u", empty, CelErrorKind::DivisionByZero, "u64 div by zero")
  assert_eval_err_kind("1u % 0u", empty, CelErrorKind::DivisionByZero, "u64 mod by zero")
  // Double div by zero is IEEE 754 +Inf (not error)
  assert_eval_bool("1.0 / 0.0 > 1e308", empty, true, "double div by zero is +Inf")
  // Indexing & field access
  assert_eval_int("[10, 20, 30][1]", empty, 20L, "list index")
  assert_eval_int("[10, 20, 30][1u]", empty, 20L, "list uint index")
  assert_eval_err_kind("[10, 20][-1]", empty, CelErrorKind::IndexOutOfBounds, "list negative index")
  assert_eval_err_kind("[10, 20][2]", empty, CelErrorKind::IndexOutOfBounds, "list oob index")
  assert_eval_int("{'a': 7}['a']", empty, 7L, "map index")
  assert_eval_int("{'a': 7}.a", empty, 7L, "map field select")
  assert_eval_str("{1: 'one'}[1u]", empty, "one", "map numeric key lookup")
  assert_eval_err_kind("{'a': 7}['b']", empty, CelErrorKind::NoSuchKey, "map missing key")
  assert_eval_err_kind("{'a': 7}.b", empty, CelErrorKind::NoSuchField, "map missing field")
  // Arithmetic truncation toward zero for negative division/modulo
  assert_eval_int("-7 / 2", empty, -3L, "signed div toward zero")
  assert_eval_int("-7 % 2", empty, -1L, "signed mod sign matches dividend")
}
