///| Static type checker for CEL ASTs against an `Env`.

struct TypeChecker {
  nodes : Array[ExprNode]
  env : Env
  locals : Array[(String, CelType)]
  mut depth : Int
  max_depth : Int
}

pub fn is_valid_map_key_type(t : CelType) -> Bool {
  match t {
    CelType::Bool | CelType::Int | CelType::UInt | CelType::String | CelType::Dyn => true
    _ => false
  }
}

pub fn is_numeric_type(t : CelType) -> Bool {
  match t {
    CelType::Int | CelType::UInt | CelType::Double | CelType::Dyn => true
    _ => false
  }
}

pub fn is_bool_compat(t : CelType) -> Bool {
  match t {
    CelType::Bool | CelType::Dyn => true
    _ => false
  }
}

#verify
pub fn is_assignable(actual : CelType, expected : CelType) -> Bool {
  match actual {
    CelType::Dyn => true
    CelType::List(a) => match expected {
      CelType::Dyn => true
      CelType::List(b) => is_assignable(a, b)
      _ => false
    }
    CelType::Map(k1, v1) => match expected {
      CelType::Dyn => true
      CelType::Map(k2, v2) => is_assignable(k1, k2) && is_assignable(v1, v2)
      _ => false
    }
    _ => match expected {
      CelType::Dyn => true
      _ => cel_type_eq(actual, expected)
    }
  }
}

fn is_builtin_type_name(name : String) -> Bool {
  name == "null_type" ||
  name == "bool" ||
  name == "int" ||
  name == "uint" ||
  name == "double" ||
  name == "string" ||
  name == "bytes" ||
  name == "list" ||
  name == "map" ||
  name == "type"
}

fn TypeChecker::lookup_var(self : TypeChecker, name : String) -> Option[CelType] {
  // Search locals in reverse (innermost binding shadows outer)
  let mut i = self.locals.length() - 1
  while i >= 0 {
    let (k, v) = self.locals[i]
    if k == name {
      return Some(v)
    }
    i = i - 1
  }
  // Search declared Env vars
  let mut j = 0
  while j < self.env.vars.length() {
    let (k, v) = self.env.vars[j]
    if k == name {
      return Some(v)
    }
    j = j + 1
  }
  if is_builtin_type_name(name) {
    return Some(CelType::Type)
  }
  None
}

fn TypeChecker::check_custom_func(
  self : TypeChecker,
  name : String,
  target_ty : Option[CelType],
  arg_tys : Array[CelType],
) -> Option[CelType] {
  let mut i = 0
  while i < self.env.funcs.length() {
    let decl = self.env.funcs[i]
    if decl.name == name && decl.params.length() == arg_tys.length() {
      let recv_ok = match (target_ty, decl.receiver) {
        (None, None) => true
        (Some(t), Some(r)) => is_assignable(t, r)
        _ => false
      }
      if recv_ok {
        let mut all_ok = true
        let mut k = 0
        while k < arg_tys.length() {
          if !is_assignable(arg_tys[k], decl.params[k]) {
            all_ok = false
            break
          }
          k = k + 1
        }
        if all_ok {
          return Some(decl.result)
        }
      }
    }
    i = i + 1
  }
  None
}

fn TypeChecker::check_binary_types(
  op : BinOp,
  lt : CelType,
  rt : CelType,
  pos : Int,
) -> Result[CelType, CelError] {
  match op {
    BinOp::Or | BinOp::And => {
      if !is_bool_compat(lt) || !is_bool_compat(rt) {
        return Err(CelError::new(CelErrorKind::TypeError, "logical operator requires bool operands", pos))
      }
      Ok(CelType::Bool)
    }
    BinOp::Eq | BinOp::Ne => {
      if (is_numeric_type(lt) && is_numeric_type(rt)) || is_assignable(lt, rt) || is_assignable(rt, lt) {
        Ok(CelType::Bool)
      } else {
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "cannot compare equality of " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
    BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge => {
      if is_numeric_type(lt) && is_numeric_type(rt) {
        return Ok(CelType::Bool)
      }
      match (lt, rt) {
        (CelType::Dyn, _) | (_, CelType::Dyn) => Ok(CelType::Bool)
        (CelType::String, CelType::String) => Ok(CelType::Bool)
        (CelType::Bytes, CelType::Bytes) => Ok(CelType::Bool)
        (CelType::Bool, CelType::Bool) => Ok(CelType::Bool)
        (CelType::Timestamp, CelType::Timestamp) => Ok(CelType::Bool)
        (CelType::Duration, CelType::Duration) => Ok(CelType::Bool)
        _ =>
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "cannot order " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
    BinOp::In => {
      match rt {
        CelType::List(_) | CelType::Map(_, _) | CelType::Dyn => Ok(CelType::Bool)
        _ => Err(CelError::new(CelErrorKind::NoMatchingOverload, "'in' requires list or map on right-hand side", pos))
      }
    }
    BinOp::Add => {
      match (lt, rt) {
        (CelType::Dyn, _) | (_, CelType::Dyn) => Ok(CelType::Dyn)
        (CelType::Int, CelType::Int) => Ok(CelType::Int)
        (CelType::UInt, CelType::UInt) => Ok(CelType::UInt)
        (CelType::Double, CelType::Double) => Ok(CelType::Double)
        (CelType::String, CelType::String) => Ok(CelType::String)
        (CelType::Bytes, CelType::Bytes) => Ok(CelType::Bytes)
        (CelType::List(a), CelType::List(b)) => {
          if cel_type_eq(a, b) {
            Ok(CelType::List(a))
          } else if is_assignable(a, b) {
            Ok(CelType::List(b))
          } else if is_assignable(b, a) {
            Ok(CelType::List(a))
          } else {
            Err(
              CelError::new(
                CelErrorKind::NoMatchingOverload,
                "cannot concatenate incompatible list types",
                pos,
              ),
            )
          }
        }
        (CelType::Timestamp, CelType::Duration) => Ok(CelType::Timestamp)
        (CelType::Duration, CelType::Timestamp) => Ok(CelType::Timestamp)
        (CelType::Duration, CelType::Duration) => Ok(CelType::Duration)
        _ =>
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "no matching '+' overload for " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
    BinOp::Sub => {
      match (lt, rt) {
        (CelType::Dyn, _) | (_, CelType::Dyn) => Ok(CelType::Dyn)
        (CelType::Int, CelType::Int) => Ok(CelType::Int)
        (CelType::UInt, CelType::UInt) => Ok(CelType::UInt)
        (CelType::Double, CelType::Double) => Ok(CelType::Double)
        (CelType::Timestamp, CelType::Duration) => Ok(CelType::Timestamp)
        (CelType::Timestamp, CelType::Timestamp) => Ok(CelType::Duration)
        (CelType::Duration, CelType::Duration) => Ok(CelType::Duration)
        _ =>
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "no matching '-' overload for " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
    BinOp::Mul | BinOp::Div => {
      match (lt, rt) {
        (CelType::Dyn, _) | (_, CelType::Dyn) => Ok(CelType::Dyn)
        (CelType::Int, CelType::Int) => Ok(CelType::Int)
        (CelType::UInt, CelType::UInt) => Ok(CelType::UInt)
        (CelType::Double, CelType::Double) => Ok(CelType::Double)
        _ =>
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "no matching arithmetic overload for " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
    BinOp::Mod => {
      match (lt, rt) {
        (CelType::Dyn, _) | (_, CelType::Dyn) => Ok(CelType::Dyn)
        (CelType::Int, CelType::Int) => Ok(CelType::Int)
        (CelType::UInt, CelType::UInt) => Ok(CelType::UInt)
        _ =>
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "no matching '%' overload for " + cel_type_name(lt) + " and " + cel_type_name(rt),
            pos,
          ),
        )
      }
    }
  }
}

fn TypeChecker::check_node(self : TypeChecker, id : Int) -> Result[CelType, CelError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    self.depth = self.depth - 1
    return Err(
      CelError::new(
        CelErrorKind::LimitExceeded,
        "type check recursion depth exceeds limit (" + self.max_depth.to_string() + ")",
        -1,
      ),
    )
  }
  let res = self.check_node_inner(id)
  self.depth = self.depth - 1
  res
}

fn TypeChecker::check_node_inner(self : TypeChecker, id : Int) -> Result[CelType, CelError] {
  match self.nodes[id] {
    ExprNode::LitNull => Ok(CelType::Null)
    ExprNode::LitBool(_) => Ok(CelType::Bool)
    ExprNode::LitInt(_) => Ok(CelType::Int)
    ExprNode::LitUInt(_) => Ok(CelType::UInt)
    ExprNode::LitDouble(_) => Ok(CelType::Double)
    ExprNode::LitString(_) => Ok(CelType::String)
    ExprNode::LitBytes(_) => Ok(CelType::Bytes)
    ExprNode::Ident(name, pos) => {
      match self.lookup_var(name) {
        Some(ty) => Ok(ty)
        None => Err(CelError::new(CelErrorKind::UndeclaredReference, "undeclared reference to '" + name + "'", pos))
      }
    }
    ExprNode::Unary(op, child_id, pos) => {
      let ct = match self.check_node(child_id) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      match op {
        UnaryOp::Not => {
          if is_bool_compat(ct) {
            Ok(CelType::Bool)
          } else {
            Err(CelError::new(CelErrorKind::TypeError, "operator '!' requires bool", pos))
          }
        }
        UnaryOp::Neg => {
          match ct {
            CelType::Int => Ok(CelType::Int)
            CelType::Double => Ok(CelType::Double)
            CelType::Dyn => Ok(CelType::Dyn)
            _ => Err(CelError::new(CelErrorKind::NoMatchingOverload, "unary '-' not supported for " + cel_type_name(ct), pos))
          }
        }
      }
    }
    ExprNode::OrChain(items, pos) | ExprNode::AndChain(items, pos) => {
      let mut i = 0
      while i < items.length() {
        let ct = match self.check_node(items[i]) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !is_bool_compat(ct) {
          return Err(CelError::new(CelErrorKind::TypeError, "logical operator requires bool operands", pos))
        }
        i = i + 1
      }
      Ok(CelType::Bool)
    }
    ExprNode::Binary(_, _, _, _) => {
      // Iteratively unroll left-leaning binary chains to keep call stack O(1)
      let ops : Array[(BinOp, Int, Int)] = []
      let mut cur = id
      while true {
        match self.nodes[cur] {
          ExprNode::Binary(op, lhs_id, rhs_id, pos) => {
            ops.push((op, rhs_id, pos))
            cur = lhs_id
          }
          _ => break
        }
      }
      let mut acc_ty = match self.check_node(cur) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let mut k = ops.length() - 1
      while k >= 0 {
        let (op, rhs_id, pos) = ops[k]
        let rt = match self.check_node(rhs_id) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        acc_ty = match TypeChecker::check_binary_types(op, acc_ty, rt, pos) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        k = k - 1
      }
      Ok(acc_ty)
    }
    ExprNode::Ternary(cond_id, then_id, else_id, pos) => {
      let ct = match self.check_node(cond_id) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if !is_bool_compat(ct) {
        return Err(CelError::new(CelErrorKind::TypeError, "ternary condition must be bool", pos))
      }
      let tt = match self.check_node(then_id) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let et = match self.check_node(else_id) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if cel_type_eq(tt, et) {
        Ok(tt)
      } else if is_assignable(tt, et) {
        Ok(et)
      } else if is_assignable(et, tt) {
        Ok(tt)
      } else {
        Err(
          CelError::new(
            CelErrorKind::NoMatchingOverload,
            "ternary branches have incompatible types " + cel_type_name(tt) + " and " + cel_type_name(et),
            pos,
          ),
        )
      }
    }
    ExprNode::Index(_, _, _) => {
      // Iteratively unroll left-leaning index chains
      let steps : Array[(Int, Int)] = []
      let mut cur = id
      while true {
        match self.nodes[cur] {
          ExprNode::Index(target_id, idx_id, pos) => {
            steps.push((idx_id, pos))
            cur = target_id
          }
          _ => break
        }
      }
      let mut tt = match self.check_node(cur) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let mut k = steps.length() - 1
      while k >= 0 {
        let (idx_id, pos) = steps[k]
        let it = match self.check_node(idx_id) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        tt = match tt {
          CelType::Dyn => CelType::Dyn
          CelType::List(elem) => {
            if is_numeric_type(it) {
              elem
            } else {
              return Err(CelError::new(CelErrorKind::TypeError, "list index must be integer", pos))
            }
          }
          CelType::Map(key_ty, val_ty) => {
            if is_assignable(it, key_ty) || (is_numeric_type(key_ty) && is_numeric_type(it)) {
              val_ty
            } else {
              return Err(
                CelError::new(
                  CelErrorKind::NoMatchingOverload,
                  "map key type mismatch: expected " + cel_type_name(key_ty) + ", got " + cel_type_name(it),
                  pos,
                ),
              )
            }
          }
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "cannot index type " + cel_type_name(tt), pos))
        }
        k = k - 1
      }
      Ok(tt)
    }
    ExprNode::Select(_, _, _, _) => {
      // Iteratively unroll left-leaning select chains
      let steps : Array[(Bool, Int)] = []
      let mut cur = id
      while true {
        match self.nodes[cur] {
          ExprNode::Select(target_id, _field, test_only, pos) => {
            steps.push((test_only, pos))
            cur = target_id
          }
          _ => break
        }
      }
      let mut tt = match self.check_node(cur) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let mut k = steps.length() - 1
      while k >= 0 {
        let (test_only, pos) = steps[k]
        tt = match tt {
          CelType::Dyn => if test_only { CelType::Bool } else { CelType::Dyn }
          CelType::Map(key_ty, val_ty) => {
            if !is_assignable(CelType::String, key_ty) {
              return Err(CelError::new(CelErrorKind::NoMatchingOverload, "field selection requires string-keyed map", pos))
            }
            if test_only { CelType::Bool } else { val_ty }
          }
          _ => return Err(CelError::new(CelErrorKind::TypeError, "field selection requires map or dyn", pos))
        }
        k = k - 1
      }
      Ok(tt)
    }
    ExprNode::ListLit(elems, _pos) => {
      if elems.length() == 0 {
        return Ok(CelType::List(CelType::Dyn))
      }
      let first = match self.check_node(elems[0]) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let mut unified = first
      let mut i = 1
      while i < elems.length() {
        let et = match self.check_node(elems[i]) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !cel_type_eq(unified, et) {
          unified = CelType::Dyn
        }
        i = i + 1
      }
      Ok(CelType::List(unified))
    }
    ExprNode::MapLit(entries, pos) => {
      if entries.length() == 0 {
        return Ok(CelType::Map(CelType::Dyn, CelType::Dyn))
      }
      let (k0, v0) = entries[0]
      let mut kt = match self.check_node(k0) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if !is_valid_map_key_type(kt) {
        return Err(CelError::new(CelErrorKind::TypeError, "invalid map key type: " + cel_type_name(kt), pos))
      }
      let mut vt = match self.check_node(v0) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let mut i = 1
      while i < entries.length() {
        let (ki, vi) = entries[i]
        let kti = match self.check_node(ki) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !is_valid_map_key_type(kti) {
          return Err(CelError::new(CelErrorKind::TypeError, "invalid map key type: " + cel_type_name(kti), pos))
        }
        let vti = match self.check_node(vi) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !cel_type_eq(kt, kti) {
          kt = CelType::Dyn
        }
        if !cel_type_eq(vt, vti) {
          vt = CelType::Dyn
        }
        i = i + 1
      }
      Ok(CelType::Map(kt, vt))
    }
    ExprNode::Call(name, target_opt, args, pos) => {
      let target_ty = match target_opt {
        Some(tid) => {
          match self.check_node(tid) {
            Ok(t) => Some(t)
            Err(e) => return Err(e)
          }
        }
        None => None
      }
      let arg_tys : Array[CelType] = []
      let mut i = 0
      while i < args.length() {
        match self.check_node(args[i]) {
          Ok(t) => arg_tys.push(t)
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      // Custom functions in Env take precedence if matching
      match self.check_custom_func(name, target_ty, arg_tys) {
        Some(res_ty) => return Ok(res_ty)
        None => ()
      }
      self.check_builtin_call(name, target_ty, arg_tys, pos)
    }
    ExprNode::Comprehension(kind, range_id, iter_var, filter_id, body_id, pos) => {
      let rt = match self.check_node(range_id) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let iter_ty = match rt {
        CelType::List(elem) => elem
        CelType::Map(k, _) => k
        CelType::Dyn => CelType::Dyn
        _ => return Err(CelError::new(CelErrorKind::TypeError, "comprehension target must be list or map", pos))
      }
      self.locals.push((iter_var, iter_ty))
      let res = match kind {
        CompKind::All | CompKind::Exists | CompKind::ExistsOne => {
          match self.check_node(body_id) {
            Ok(bt) => {
              if is_bool_compat(bt) {
                Ok(CelType::Bool)
              } else {
                Err(CelError::new(CelErrorKind::TypeError, "comprehension predicate must return bool", pos))
              }
            }
            Err(e) => Err(e)
          }
        }
        CompKind::Filter => {
          match self.check_node(filter_id) {
            Ok(ft) => {
              if is_bool_compat(ft) {
                Ok(CelType::List(iter_ty))
              } else {
                Err(CelError::new(CelErrorKind::TypeError, "filter predicate must return bool", pos))
              }
            }
            Err(e) => Err(e)
          }
        }
        CompKind::Map => {
          match self.check_node(body_id) {
            Ok(bt) => Ok(CelType::List(bt))
            Err(e) => Err(e)
          }
        }
        CompKind::MapFilter => {
          match self.check_node(filter_id) {
            Ok(ft) => {
              if !is_bool_compat(ft) {
                Err(CelError::new(CelErrorKind::TypeError, "map filter predicate must return bool", pos))
              } else {
                match self.check_node(body_id) {
                  Ok(bt) => Ok(CelType::List(bt))
                  Err(e) => Err(e)
                }
              }
            }
            Err(e) => Err(e)
          }
        }
      }
      let _ = self.locals.pop()
      res
    }
  }
}

fn TypeChecker::check_builtin_call(
  self : TypeChecker,
  name : String,
  target_ty : Option[CelType],
  arg_tys : Array[CelType],
  pos : Int,
) -> Result[CelType, CelError] {
  let _ = self
  match target_ty {
    Some(recv) => {
      if name == "size" && arg_tys.length() == 0 {
        match recv {
          CelType::String | CelType::Bytes | CelType::List(_) | CelType::Map(_, _) | CelType::Dyn =>
          return Ok(CelType::Int)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "size() not supported for " + cel_type_name(recv), pos))
        }
      }
      if (name == "contains" || name == "startsWith" || name == "endsWith" || name == "matches") && arg_tys.length() == 1 {
        if is_assignable(recv, CelType::String) && is_assignable(arg_tys[0], CelType::String) {
          return Ok(CelType::Bool)
        }
        return Err(CelError::new(CelErrorKind::NoMatchingOverload, name + "() requires string receiver and argument", pos))
      }
      if name == "getFullYear" || name == "getMonth" || name == "getDate" || name == "getDayOfMonth" || name == "getDayOfWeek" || name == "getDayOfYear" {
        if is_assignable(recv, CelType::Timestamp) && (arg_tys.length() == 0 || (arg_tys.length() == 1 && is_assignable(arg_tys[0], CelType::String))) {
          return Ok(CelType::Int)
        }
        return Err(CelError::new(CelErrorKind::NoMatchingOverload, name + "() requires timestamp receiver", pos))
      }
      if name == "getHours" || name == "getMinutes" || name == "getSeconds" || name == "getMilliseconds" {
        if is_assignable(recv, CelType::Timestamp) && (arg_tys.length() == 0 || (arg_tys.length() == 1 && is_assignable(arg_tys[0], CelType::String))) {
          return Ok(CelType::Int)
        }
        if is_assignable(recv, CelType::Duration) && arg_tys.length() == 0 {
          return Ok(CelType::Int)
        }
        return Err(CelError::new(CelErrorKind::NoMatchingOverload, name + "() requires timestamp or duration receiver", pos))
      }
      Err(CelError::new(CelErrorKind::NoMatchingOverload, "unknown method '" + name + "'", pos))
    }
    None => {
      if name == "size" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::String | CelType::Bytes | CelType::List(_) | CelType::Map(_, _) | CelType::Dyn =>
          return Ok(CelType::Int)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "size() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "matches" && arg_tys.length() == 2 {
        if is_assignable(arg_tys[0], CelType::String) && is_assignable(arg_tys[1], CelType::String) {
          return Ok(CelType::Bool)
        }
        return Err(CelError::new(CelErrorKind::NoMatchingOverload, "matches(string, string) requires string arguments", pos))
      }
      if name == "type" && arg_tys.length() == 1 {
        return Ok(CelType::Type)
      }
      if name == "int" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Int | CelType::UInt | CelType::Double | CelType::String | CelType::Timestamp | CelType::Duration | CelType::Dyn =>
          return Ok(CelType::Int)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "int() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "uint" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::UInt | CelType::Int | CelType::Double | CelType::String | CelType::Dyn =>
          return Ok(CelType::UInt)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "uint() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "double" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Double | CelType::Int | CelType::UInt | CelType::String | CelType::Dyn =>
          return Ok(CelType::Double)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "double() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "string" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::String | CelType::Int | CelType::UInt | CelType::Double | CelType::Bool | CelType::Bytes | CelType::Timestamp | CelType::Duration | CelType::Dyn =>
          return Ok(CelType::String)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "string() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "bytes" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Bytes | CelType::String | CelType::Dyn => return Ok(CelType::Bytes)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "bytes() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "bool" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Bool | CelType::String | CelType::Dyn => return Ok(CelType::Bool)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "bool() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "dyn" && arg_tys.length() == 1 {
        return Ok(CelType::Dyn)
      }
      if name == "timestamp" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Timestamp | CelType::String | CelType::Int | CelType::Dyn => return Ok(CelType::Timestamp)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "timestamp() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      if name == "duration" && arg_tys.length() == 1 {
        match arg_tys[0] {
          CelType::Duration | CelType::String | CelType::Dyn => return Ok(CelType::Duration)
          _ => return Err(CelError::new(CelErrorKind::NoMatchingOverload, "duration() not supported for " + cel_type_name(arg_tys[0]), pos))
        }
      }
      Err(CelError::new(CelErrorKind::UndeclaredReference, "undeclared function '" + name + "'", pos))
    }
  }
}

///| Statically type-check an `Ast` against `Env`.
pub fn check_ast(ast : Ast, env : Env) -> Result[CheckedAst, CelError] {
  let tc = TypeChecker::{ nodes: ast.nodes, env: env, locals: [], depth: 0, max_depth: 256 }
  match tc.check_node(ast.expr_id) {
    Ok(ty) => Ok(CheckedAst::{ ast: ast, result_type: ty })
    Err(e) => Err(e)
  }
}
