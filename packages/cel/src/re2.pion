///| RE2 dialect compatibility translator for CEL `matches()`.
///| Translates Go/RE2 semantics onto `packages/regex` (Rust regex dialect):
///| - `\d`/`\D`, `\w`/`\W`, `\s`/`\S`, `\b`/`\B` are ASCII-only (as in RE2)
///| - Inside `[...]`, `&&`, `--`, `~~` are literal characters (no Rust class set ops)
///| - `\Q...\E` (and unterminated `\Q` to end of pattern) quotes metacharacters
///| - Repetition bounds `{m}` / `{m,n}` enforce RE2's max repeat count of 1000
///| - Rejects `(?<name>...)` (RE2 requires `(?P<name>...)`)

import "regex"

fn is_re2_meta(b : Int) -> Bool {
  b == 92 || b == 46 || b == 43 || b == 42 || b == 63 ||
  b == 40 || b == 41 || b == 124 || b == 91 || b == 93 ||
  b == 123 || b == 125 || b == 94 || b == 36
}

fn translate_re2_pattern(pat : String) -> Result[String, String] {
  let n = pat.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut in_class = false
  let mut class_first = false

  while i < n {
    let b = pat.code_unit_at(i)
    if !in_class {
      if b == 92 && i + 1 < n {
        let next = pat.code_unit_at(i + 1)
        if next == 81 {
          // \Q ... \E (or end of string)
          i = i + 2
          while i < n {
            if pat.code_unit_at(i) == 92 && i + 1 < n && pat.code_unit_at(i + 1) == 69 {
              i = i + 2
              break
            }
            let c = pat.code_unit_at(i)
            if is_re2_meta(c) {
              sb.write_byte((92).to_byte())
            }
            sb.write_byte(c.to_byte())
            i = i + 1
          }
          continue
        }
        if next == 100 {
          // \d -> ASCII digit
          sb.write_string("[0-9]")
          i = i + 2
          continue
        }
        if next == 68 {
          // \D -> non-ASCII-digit
          sb.write_string("[^0-9]")
          i = i + 2
          continue
        }
        if next == 119 {
          // \w -> ASCII word
          sb.write_string("[0-9A-Za-z_]")
          i = i + 2
          continue
        }
        if next == 87 {
          // \W -> non-ASCII-word
          sb.write_string("[^0-9A-Za-z_]")
          i = i + 2
          continue
        }
        if next == 115 {
          // \s -> RE2 ASCII whitespace [\t\n\f\r ]
          sb.write_string("[\\t\\n\\f\\r ]")
          i = i + 2
          continue
        }
        if next == 83 {
          // \S -> non-ASCII-whitespace
          sb.write_string("[^\\t\\n\\f\\r ]")
          i = i + 2
          continue
        }
        if next == 98 {
          // \b -> ASCII word boundary
          sb.write_string("(?-u:\\b)")
          i = i + 2
          continue
        }
        if next == 66 {
          // \B -> ASCII non-word boundary
          sb.write_string("(?-u:\\B)")
          i = i + 2
          continue
        }
        // Pass through any other escape sequence as-is
        sb.write_byte(b.to_byte())
        sb.write_byte(next.to_byte())
        i = i + 2
        continue
      }
      if b == 91 {
        // Enter character class
        in_class = true
        class_first = true
        sb.write_byte(b.to_byte())
        i = i + 1
        if i < n && pat.code_unit_at(i) == 94 {
          sb.write_byte((94).to_byte())
          i = i + 1
        }
        continue
      }
      if b == 123 {
        // Check {m} or {m,n} repeat bounds <= 1000
        let start = i
        let mut j = i + 1
        let mut m = 0
        let mut has_m = false
        while j < n && pat.code_unit_at(j) >= 48 && pat.code_unit_at(j) <= 57 {
          has_m = true
          if m <= 10000 {
            m = m * 10 + (pat.code_unit_at(j) - 48)
          }
          j = j + 1
        }
        if has_m {
          let mut has_comma = false
          let mut max_v = m
          let mut has_max = false
          if j < n && pat.code_unit_at(j) == 44 {
            has_comma = true
            j = j + 1
            max_v = 0
            while j < n && pat.code_unit_at(j) >= 48 && pat.code_unit_at(j) <= 57 {
              has_max = true
              if max_v <= 10000 {
                max_v = max_v * 10 + (pat.code_unit_at(j) - 48)
              }
              j = j + 1
            }
          }
          if j < n && pat.code_unit_at(j) == 125 {
            if m > 1000 || (has_comma && has_max && max_v > 1000) {
              return Err("invalid repeat count > 1000")
            }
            sb.write_string(pat.slice(start, j + 1))
            i = j + 1
            continue
          }
        }
        sb.write_byte(b.to_byte())
        i = i + 1
        continue
      }
      sb.write_byte(b.to_byte())
      i = i + 1
    } else {
      // Inside [...]
      if b == 93 && !class_first {
        in_class = false
        sb.write_byte(b.to_byte())
        i = i + 1
        continue
      }
      class_first = false
      // Preserve POSIX character classes [:...:]
      if b == 91 && i + 1 < n && pat.code_unit_at(i + 1) == 58 {
        let mut j = i + 2
        let mut found_end = false
        while j + 1 < n {
          if pat.code_unit_at(j) == 58 && pat.code_unit_at(j + 1) == 93 {
            sb.write_string(pat.slice(i, j + 2))
            i = j + 2
            found_end = true
            break
          }
          j = j + 1
        }
        if found_end {
          continue
        }
      }
      if b == 92 && i + 1 < n {
        let next = pat.code_unit_at(i + 1)
        if next == 100 {
          sb.write_string("0-9")
          i = i + 2
          continue
        }
        if next == 119 {
          sb.write_string("0-9A-Za-z_")
          i = i + 2
          continue
        }
        if next == 115 {
          sb.write_string("\\t\\n\\f\\r ")
          i = i + 2
          continue
        }
        sb.write_byte(b.to_byte())
        sb.write_byte(next.to_byte())
        i = i + 2
        continue
      }
      // Escape Rust class set operators && and ~~ so they are literal characters as in RE2;
      // for --, escape only the second '-' so `a--b` parses as range `a`..`-` (matching RE2).
      if (b == 38 || b == 126) && i + 1 < n && pat.code_unit_at(i + 1) == b {
        sb.write_byte((92).to_byte())
        sb.write_byte(b.to_byte())
        sb.write_byte((92).to_byte())
        sb.write_byte(b.to_byte())
        i = i + 2
        continue
      }
      if b == 45 && i + 1 < n && pat.code_unit_at(i + 1) == 45 {
        sb.write_byte((45).to_byte())
        sb.write_byte((92).to_byte())
        sb.write_byte((45).to_byte())
        i = i + 2
        continue
      }
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Compile a CEL RE2 regular expression pattern.
pub fn compile_cel_re2(pattern : String) -> Result[regex::Regex, String] {
  let translated = match translate_re2_pattern(pattern) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match regex::compile(translated) {
    Ok(re) => Ok(re)
    Err(_) => Err("invalid regular expression: " + pattern)
  }
}
