///| Arena-indexed AST representation for CEL expressions.

///| Unary operators.
pub enum UnaryOp {
  Neg
  Not
}

///| Binary operators.
pub enum BinOp {
  Or
  And
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  In
  Add
  Sub
  Mul
  Div
  Mod
}

///| Standard CEL comprehension macro kinds.
pub enum CompKind {
  All
  Exists
  ExistsOne
  Map
  MapFilter
  Filter
}

///| Arena-allocated AST node. Child references are `Int` indices into `Ast.nodes`.
pub enum ExprNode {
  LitNull
  LitBool(Bool)
  LitInt(Int64)
  LitUInt(UInt64)
  LitDouble(Double)
  LitString(String)
  LitBytes(Bytes)
  Ident(String, Int)
  Unary(UnaryOp, Int, Int)
  Binary(BinOp, Int, Int, Int)
  Ternary(Int, Int, Int, Int)
  Index(Int, Int, Int)
  Select(Int, String, Bool, Int)
  ListLit(Array[Int], Int)
  MapLit(Array[(Int, Int)], Int)
  Call(String, Option[Int], Array[Int], Int)
  Comprehension(CompKind, Int, String, Int, Int, Int)
}
