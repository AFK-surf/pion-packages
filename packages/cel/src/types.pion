///| Core public types for `cel` (Google Common Expression Language).

import "time"
import "regex"

///| Categorized CEL error kinds covering syntax, static type checking, runtime evaluation, and safety limits.
pub enum CelErrorKind {
  SyntaxError
  TypeError
  EvalError
  DivisionByZero
  Overflow
  NoSuchField
  NoSuchKey
  IndexOutOfBounds
  UndeclaredReference
  NoMatchingOverload
  LimitExceeded
  InvalidArgument
  Unimplemented
}

///|
pub fn error_kind_as_str(kind : CelErrorKind) -> String {
  match kind {
    CelErrorKind::SyntaxError => "SyntaxError"
    CelErrorKind::TypeError => "TypeError"
    CelErrorKind::EvalError => "EvalError"
    CelErrorKind::DivisionByZero => "DivisionByZero"
    CelErrorKind::Overflow => "Overflow"
    CelErrorKind::NoSuchField => "NoSuchField"
    CelErrorKind::NoSuchKey => "NoSuchKey"
    CelErrorKind::IndexOutOfBounds => "IndexOutOfBounds"
    CelErrorKind::UndeclaredReference => "UndeclaredReference"
    CelErrorKind::NoMatchingOverload => "NoMatchingOverload"
    CelErrorKind::LimitExceeded => "LimitExceeded"
    CelErrorKind::InvalidArgument => "InvalidArgument"
    CelErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn error_kind_eq(a : CelErrorKind, b : CelErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured CEL error with kind, message, and optional byte offset (-1 if N/A).
pub struct CelError {
  pub kind : CelErrorKind
  pub message : String
  pub pos : Int
}

///|
pub fn CelError::new(kind : CelErrorKind, message : String, pos : Int) -> CelError {
  CelError::{ kind: kind, message: message, pos: pos }
}

///|
pub fn CelError::unimplemented(what : String) -> CelError {
  CelError::{
    kind: CelErrorKind::Unimplemented,
    message: "not implemented: " + what,
    pos: -1,
  }
}

///|
pub fn CelError::is_kind(self : CelError, expected : CelErrorKind) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn CelError::to_string(self : CelError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  if self.pos >= 0 {
    sb.write_string(" at offset ")
    sb.write_string(self.pos.to_string())
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Static CEL type used by `Env` and the static type checker.
#verify
pub enum CelType {
  Dyn
  Null
  Bool
  Int
  UInt
  Double
  String
  Bytes
  List(CelType)
  Map(CelType, CelType)
  Timestamp
  Duration
  Type
}

///|
pub fn cel_type_name(ty : CelType) -> String {
  match ty {
    CelType::Dyn => "dyn"
    CelType::Null => "null_type"
    CelType::Bool => "bool"
    CelType::Int => "int"
    CelType::UInt => "uint"
    CelType::Double => "double"
    CelType::String => "string"
    CelType::Bytes => "bytes"
    CelType::List(_) => "list"
    CelType::Map(_, _) => "map"
    CelType::Timestamp => "google.protobuf.Timestamp"
    CelType::Duration => "google.protobuf.Duration"
    CelType::Type => "type"
  }
}

///|
#verify
pub fn cel_type_eq(a : CelType, b : CelType) -> Bool {
  match a {
    CelType::Dyn => match b { CelType::Dyn => true _ => false }
    CelType::Null => match b { CelType::Null => true _ => false }
    CelType::Bool => match b { CelType::Bool => true _ => false }
    CelType::Int => match b { CelType::Int => true _ => false }
    CelType::UInt => match b { CelType::UInt => true _ => false }
    CelType::Double => match b { CelType::Double => true _ => false }
    CelType::String => match b { CelType::String => true _ => false }
    CelType::Bytes => match b { CelType::Bytes => true _ => false }
    CelType::Timestamp => match b { CelType::Timestamp => true _ => false }
    CelType::Duration => match b { CelType::Duration => true _ => false }
    CelType::Type => match b { CelType::Type => true _ => false }
    CelType::List(x) => match b { CelType::List(y) => cel_type_eq(x, y) _ => false }
    CelType::Map(k1, v1) => match b {
      CelType::Map(k2, v2) => cel_type_eq(k1, k2) && cel_type_eq(v1, v2)
      _ => false
    }
  }
}

///| Runtime CEL value variant covering all 12 CEL specification value kinds.
pub enum ValueKind {
  Null
  Bool(Bool)
  Int64(Int64)
  UInt64(UInt64)
  Double(Double)
  String(String)
  Bytes(Bytes)
  List(Array[Value])
  Map(Array[(Value, Value)])
  Timestamp(time::Timestamp)
  Duration(time::SignedDuration)
  Type(String)
}

let CEL_TS_OFFSET_UTC : Int = -100000

///| Runtime CEL value wrapper (struct so static constructors and methods dispatch cleanly).
pub struct Value {
  pub kind : ValueKind
  map_idx : Option[CelMapIndex]
  ts_offset : Int
}

let VAL_NULL : Value = Value::{ kind: ValueKind::Null, map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }

let VAL_TRUE : Value = Value::{ kind: ValueKind::Bool(true), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }

let VAL_FALSE : Value = Value::{ kind: ValueKind::Bool(false), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }

///|
pub fn Value::null() -> Value {
  VAL_NULL
}

///|
pub fn Value::bool(v : Bool) -> Value {
  if v { VAL_TRUE } else { VAL_FALSE }
}

///|
pub fn Value::int(v : Int64) -> Value {
  Value::{ kind: ValueKind::Int64(v), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::uint(v : UInt64) -> Value {
  Value::{ kind: ValueKind::UInt64(v), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::double(v : Double) -> Value {
  Value::{ kind: ValueKind::Double(v), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::string(v : String) -> Value {
  Value::{ kind: ValueKind::String(v), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::bytes(v : Bytes) -> Value {
  Value::{ kind: ValueKind::Bytes(v), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::list(items : Array[Value]) -> Value {
  Value::{ kind: ValueKind::List(items), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::map(entries : Array[(Value, Value)]) -> Value {
  let idx = if entries.length() >= 8 {
    Some(CelMapIndex::build(entries))
  } else {
    None
  }
  Value::{ kind: ValueKind::Map(entries), map_idx: idx, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::str_map(entries : Array[(String, Value)]) -> Value {
  let out : Array[(Value, Value)] = []
  let mut i = 0
  while i < entries.length() {
    let (k, v) = entries[i]
    out.push((Value::string(k), v))
    i = i + 1
  }
  Value::map(out)
}

///|
pub fn Value::timestamp(ts : time::Timestamp) -> Value {
  Value::{ kind: ValueKind::Timestamp(ts), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
fn Value::timestamp_with_offset(ts : time::Timestamp, offset_secs : Int) -> Value {
  Value::{ kind: ValueKind::Timestamp(ts), map_idx: None, ts_offset: offset_secs }
}

///|
pub fn Value::duration(d : time::SignedDuration) -> Value {
  Value::{ kind: ValueKind::Duration(d), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn Value::type_val(name : String) -> Value {
  Value::{ kind: ValueKind::Type(name), map_idx: None, ts_offset: CEL_TS_OFFSET_UTC }
}

///|
pub fn value_type_name(v : Value) -> String {
  match v.kind {
    ValueKind::Null => "null_type"
    ValueKind::Bool(_) => "bool"
    ValueKind::Int64(_) => "int"
    ValueKind::UInt64(_) => "uint"
    ValueKind::Double(_) => "double"
    ValueKind::String(_) => "string"
    ValueKind::Bytes(_) => "bytes"
    ValueKind::List(_) => "list"
    ValueKind::Map(_) => "map"
    ValueKind::Timestamp(_) => "google.protobuf.Timestamp"
    ValueKind::Duration(_) => "google.protobuf.Duration"
    ValueKind::Type(_) => "type"
  }
}

///| Strict structural equality for tests (exact variant & value equality).
pub fn value_strict_eq(self : Value, other : Value) -> Bool {
  match (self.kind, other.kind) {
    (ValueKind::Null, ValueKind::Null) => true
    (ValueKind::Bool(a), ValueKind::Bool(b)) => a == b
    (ValueKind::Int64(a), ValueKind::Int64(b)) => a == b
    (ValueKind::UInt64(a), ValueKind::UInt64(b)) => a == b
    (ValueKind::Double(a), ValueKind::Double(b)) => a == b
    (ValueKind::String(a), ValueKind::String(b)) => a == b
    (ValueKind::Bytes(a), ValueKind::Bytes(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if a[i] != b[i] {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Timestamp(a), ValueKind::Timestamp(b)) => a.eq(b)
    (ValueKind::Duration(a), ValueKind::Duration(b)) => a.eq(b)
    (ValueKind::Type(a), ValueKind::Type(b)) => a == b
    (ValueKind::List(a), ValueKind::List(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if !value_strict_eq(a[i], b[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Map(a), ValueKind::Map(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        let (ka, va) = a[i]
        let mut found = false
        let mut j = 0
        while j < b.length() {
          let (kb, vb) = b[j]
          if value_strict_eq(ka, kb) && value_strict_eq(va, vb) {
            found = true
            break
          }
          j = j + 1
        }
        if !found {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///| Safety and resource budget limits for parsing and evaluation.
pub val struct EvalLimits {
  pub max_depth : Int
  pub max_cost : Int64
  pub max_output_bytes : Int
}

///|
pub fn EvalLimits::default() -> EvalLimits {
  EvalLimits::{
    max_depth: 64,
    max_cost: 1000000L,
    max_output_bytes: 1048576,
  }
}

///|
pub fn EvalLimits::new(
  max_depth : Int,
  max_cost : Int64,
  max_output_bytes : Int,
) -> EvalLimits {
  EvalLimits::{
    max_depth: max_depth,
    max_cost: max_cost,
    max_output_bytes: max_output_bytes,
  }
}

///| Custom function signature declaration for static type checking.
pub struct FuncDecl {
  pub name : String
  pub receiver : Option[CelType]
  pub params : Array[CelType]
  pub result : CelType
}

///|
pub fn FuncDecl::new(
  name : String,
  receiver : Option[CelType],
  params : Array[CelType],
  result : CelType,
) -> FuncDecl {
  FuncDecl::{
    name: name,
    receiver: receiver,
    params: params,
    result: result,
  }
}

///| Type-checking environment declaring variables and optional custom functions.
pub struct Env {
  pub vars : Array[(String, CelType)]
  pub funcs : Array[FuncDecl]
}

///|
pub fn Env::new() -> Env {
  Env::{ vars: [], funcs: [] }
}

///|
pub fn Env::with_var(self : Env, name : String, ty : CelType) -> Env {
  let next_vars : Array[(String, CelType)] = []
  let mut replaced = false
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      next_vars.push((name, ty))
      replaced = true
    } else {
      next_vars.push((k, v))
    }
    i = i + 1
  }
  if !replaced {
    next_vars.push((name, ty))
  }
  Env::{ vars: next_vars, funcs: self.funcs }
}

///|
pub fn Env::with_vars(self : Env, pairs : Array[(String, CelType)]) -> Env {
  let mut env = self
  let mut i = 0
  while i < pairs.length() {
    let (k, v) = pairs[i]
    env = env.with_var(k, v)
    i = i + 1
  }
  env
}

///|
pub fn Env::with_func(self : Env, decl : FuncDecl) -> Env {
  let next_funcs : Array[FuncDecl] = []
  let mut i = 0
  while i < self.funcs.length() {
    next_funcs.push(self.funcs[i])
    i = i + 1
  }
  next_funcs.push(decl)
  Env::{ vars: self.vars, funcs: next_funcs }
}

///| Runtime variable activation map.
pub struct Activation {
  pub vars : Array[(String, Value)]
  index : Option[StrHashIndex]
}

///|
pub fn Activation::empty() -> Activation {
  Activation::{ vars: [], index: None }
}

///|
pub fn Activation::from_pairs(pairs : Array[(String, Value)]) -> Activation {
  let idx = if pairs.length() >= 8 {
    Some(StrHashIndex::from_str_val_pairs(pairs))
  } else {
    None
  }
  Activation::{ vars: pairs, index: idx }
}

///|
pub fn Activation::with_var(self : Activation, name : String, value : Value) -> Activation {
  let out : Array[(String, Value)] = []
  let mut replaced = false
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      out.push((name, value))
      replaced = true
    } else {
      out.push((k, v))
    }
    i = i + 1
  }
  if !replaced {
    out.push((name, value))
  }
  Activation::from_pairs(out)
}

///|
pub fn Activation::lookup(self : Activation, name : String) -> Option[Value] {
  match self.index {
    Some(idx) => {
      let slot = idx.get(name)
      if slot >= 0 {
        let (_, v) = self.vars[slot]
        return Some(v)
      }
      return None
    }
    None => ()
  }
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Parsed CEL abstract syntax tree.
pub struct Ast {
  pub source : String
  pub expr_id : Int
  pub nodes : Array[ExprNode]
}

///| Statically type-checked CEL AST.
pub struct CheckedAst {
  pub ast : Ast
  pub result_type : CelType
}

///| Compiled, reusable CEL program with pre-compiled constant regex cache.
pub struct Program {
  pub source : String
  pub result_type : CelType
  pub root : Int
  pub nodes : Array[ExprNode]
  pub regex_cache : Array[Option[regex::Regex]]
}
