///| Core public types for `cel` (Google Common Expression Language).

import "time"

///| Categorized CEL error kinds covering syntax, static type checking, runtime evaluation, and safety limits.
pub enum CelErrorKind {
  SyntaxError
  TypeError
  EvalError
  DivisionByZero
  Overflow
  NoSuchField
  NoSuchKey
  IndexOutOfBounds
  UndeclaredReference
  NoMatchingOverload
  LimitExceeded
  InvalidArgument
  Unimplemented
}

///|
pub fn error_kind_as_str(kind : CelErrorKind) -> String {
  match kind {
    CelErrorKind::SyntaxError => "SyntaxError"
    CelErrorKind::TypeError => "TypeError"
    CelErrorKind::EvalError => "EvalError"
    CelErrorKind::DivisionByZero => "DivisionByZero"
    CelErrorKind::Overflow => "Overflow"
    CelErrorKind::NoSuchField => "NoSuchField"
    CelErrorKind::NoSuchKey => "NoSuchKey"
    CelErrorKind::IndexOutOfBounds => "IndexOutOfBounds"
    CelErrorKind::UndeclaredReference => "UndeclaredReference"
    CelErrorKind::NoMatchingOverload => "NoMatchingOverload"
    CelErrorKind::LimitExceeded => "LimitExceeded"
    CelErrorKind::InvalidArgument => "InvalidArgument"
    CelErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn error_kind_eq(a : CelErrorKind, b : CelErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured CEL error with kind, message, and optional byte offset (-1 if N/A).
pub struct CelError {
  pub kind : CelErrorKind
  pub message : String
  pub pos : Int
}

///|
pub fn CelError::new(kind : CelErrorKind, message : String, pos : Int) -> CelError {
  CelError::{ kind: kind, message: message, pos: pos }
}

///|
pub fn CelError::unimplemented(what : String) -> CelError {
  CelError::{
    kind: CelErrorKind::Unimplemented,
    message: "not implemented: " + what,
    pos: -1,
  }
}

///|
pub fn CelError::is_kind(self : CelError, expected : CelErrorKind) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn CelError::to_string(self : CelError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  if self.pos >= 0 {
    sb.write_string(" at offset ")
    sb.write_string(self.pos.to_string())
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Static CEL type used by `Env` and the static type checker.
pub enum CelType {
  Dyn
  Null
  Bool
  Int
  UInt
  Double
  String
  Bytes
  List(CelType)
  Map(CelType, CelType)
  Timestamp
  Duration
  Type
}

///|
pub fn cel_type_name(ty : CelType) -> String {
  match ty {
    CelType::Dyn => "dyn"
    CelType::Null => "null_type"
    CelType::Bool => "bool"
    CelType::Int => "int"
    CelType::UInt => "uint"
    CelType::Double => "double"
    CelType::String => "string"
    CelType::Bytes => "bytes"
    CelType::List(_) => "list"
    CelType::Map(_, _) => "map"
    CelType::Timestamp => "google.protobuf.Timestamp"
    CelType::Duration => "google.protobuf.Duration"
    CelType::Type => "type"
  }
}

///|
pub fn cel_type_eq(a : CelType, b : CelType) -> Bool {
  match (a, b) {
    (CelType::Dyn, CelType::Dyn) => true
    (CelType::Null, CelType::Null) => true
    (CelType::Bool, CelType::Bool) => true
    (CelType::Int, CelType::Int) => true
    (CelType::UInt, CelType::UInt) => true
    (CelType::Double, CelType::Double) => true
    (CelType::String, CelType::String) => true
    (CelType::Bytes, CelType::Bytes) => true
    (CelType::Timestamp, CelType::Timestamp) => true
    (CelType::Duration, CelType::Duration) => true
    (CelType::Type, CelType::Type) => true
    (CelType::List(x), CelType::List(y)) => cel_type_eq(x, y)
    (CelType::Map(k1, v1), CelType::Map(k2, v2)) => cel_type_eq(k1, k2) && cel_type_eq(v1, v2)
    _ => false
  }
}

///| Runtime CEL value covering all 12 CEL specification value kinds.
pub enum Value {
  Null
  Bool(Bool)
  Int64(Int64)
  UInt64(UInt64)
  Double(Double)
  String(String)
  Bytes(Bytes)
  List(Array[Value])
  Map(Array[(Value, Value)])
  Timestamp(time::Timestamp)
  Duration(time::SignedDuration)
  Type(String)
}

///|
pub fn Value::null() -> Value {
  Value::Null
}

///|
pub fn Value::bool(v : Bool) -> Value {
  Value::Bool(v)
}

///|
pub fn Value::int(v : Int64) -> Value {
  Value::Int64(v)
}

///|
pub fn Value::uint(v : UInt64) -> Value {
  Value::UInt64(v)
}

///|
pub fn Value::double(v : Double) -> Value {
  Value::Double(v)
}

///|
pub fn Value::string(v : String) -> Value {
  Value::String(v)
}

///|
pub fn Value::bytes(v : Bytes) -> Value {
  Value::Bytes(v)
}

///|
pub fn Value::list(items : Array[Value]) -> Value {
  Value::List(items)
}

///|
pub fn Value::map(entries : Array[(Value, Value)]) -> Value {
  Value::Map(entries)
}

///|
pub fn Value::str_map(entries : Array[(String, Value)]) -> Value {
  let out : Array[(Value, Value)] = []
  let mut i = 0
  while i < entries.length() {
    let (k, v) = entries[i]
    out.push((Value::String(k), v))
    i = i + 1
  }
  Value::Map(out)
}

///|
pub fn Value::timestamp(ts : time::Timestamp) -> Value {
  Value::Timestamp(ts)
}

///|
pub fn Value::duration(d : time::SignedDuration) -> Value {
  Value::Duration(d)
}

///|
pub fn Value::type_val(name : String) -> Value {
  Value::Type(name)
}

///|
pub fn value_type_name(v : Value) -> String {
  match v {
    Value::Null => "null_type"
    Value::Bool(_) => "bool"
    Value::Int64(_) => "int"
    Value::UInt64(_) => "uint"
    Value::Double(_) => "double"
    Value::String(_) => "string"
    Value::Bytes(_) => "bytes"
    Value::List(_) => "list"
    Value::Map(_) => "map"
    Value::Timestamp(_) => "google.protobuf.Timestamp"
    Value::Duration(_) => "google.protobuf.Duration"
    Value::Type(_) => "type"
  }
}

///| Strict structural equality for tests (exact variant & value equality).
pub fn value_strict_eq(self : Value, other : Value) -> Bool {
  match (self, other) {
    (Value::Null, Value::Null) => true
    (Value::Bool(a), Value::Bool(b)) => a == b
    (Value::Int64(a), Value::Int64(b)) => a == b
    (Value::UInt64(a), Value::UInt64(b)) => a == b
    (Value::Double(a), Value::Double(b)) => a == b
    (Value::String(a), Value::String(b)) => a == b
    (Value::Bytes(a), Value::Bytes(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if a[i] != b[i] {
          return false
        }
        i = i + 1
      }
      true
    }
    (Value::Timestamp(a), Value::Timestamp(b)) => a.eq(b)
    (Value::Duration(a), Value::Duration(b)) => a.eq(b)
    (Value::Type(a), Value::Type(b)) => a == b
    (Value::List(a), Value::List(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if !value_strict_eq(a[i], b[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (Value::Map(a), Value::Map(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        let (ka, va) = a[i]
        let mut found = false
        let mut j = 0
        while j < b.length() {
          let (kb, vb) = b[j]
          if value_strict_eq(ka, kb) && value_strict_eq(va, vb) {
            found = true
            break
          }
          j = j + 1
        }
        if !found {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///| Safety and resource budget limits for parsing and evaluation.
pub val struct EvalLimits {
  pub max_depth : Int
  pub max_cost : Int64
  pub max_output_bytes : Int
}

///|
pub fn EvalLimits::default() -> EvalLimits {
  EvalLimits::{
    max_depth: 64,
    max_cost: 1000000L,
    max_output_bytes: 1048576,
  }
}

///|
pub fn EvalLimits::new(
  max_depth : Int,
  max_cost : Int64,
  max_output_bytes : Int,
) -> EvalLimits {
  EvalLimits::{
    max_depth: max_depth,
    max_cost: max_cost,
    max_output_bytes: max_output_bytes,
  }
}

///| Custom function signature declaration for static type checking.
pub struct FuncDecl {
  pub name : String
  pub receiver : Option[CelType]
  pub params : Array[CelType]
  pub result : CelType
}

///|
pub fn FuncDecl::new(
  name : String,
  receiver : Option[CelType],
  params : Array[CelType],
  result : CelType,
) -> FuncDecl {
  FuncDecl::{
    name: name,
    receiver: receiver,
    params: params,
    result: result,
  }
}

///| Type-checking environment declaring variables and optional custom functions.
pub struct Env {
  pub vars : Array[(String, CelType)]
  pub funcs : Array[FuncDecl]
}

///|
pub fn Env::new() -> Env {
  Env::{ vars: [], funcs: [] }
}

///|
pub fn Env::with_var(self : Env, name : String, ty : CelType) -> Env {
  let next_vars : Array[(String, CelType)] = []
  let mut replaced = false
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      next_vars.push((name, ty))
      replaced = true
    } else {
      next_vars.push((k, v))
    }
    i = i + 1
  }
  if !replaced {
    next_vars.push((name, ty))
  }
  Env::{ vars: next_vars, funcs: self.funcs }
}

///|
pub fn Env::with_vars(self : Env, pairs : Array[(String, CelType)]) -> Env {
  let mut env = self
  let mut i = 0
  while i < pairs.length() {
    let (k, v) = pairs[i]
    env = env.with_var(k, v)
    i = i + 1
  }
  env
}

///|
pub fn Env::with_func(self : Env, decl : FuncDecl) -> Env {
  let next_funcs : Array[FuncDecl] = []
  let mut i = 0
  while i < self.funcs.length() {
    next_funcs.push(self.funcs[i])
    i = i + 1
  }
  next_funcs.push(decl)
  Env::{ vars: self.vars, funcs: next_funcs }
}

///| Runtime variable activation map.
pub struct Activation {
  pub vars : Array[(String, Value)]
}

///|
pub fn Activation::empty() -> Activation {
  Activation::{ vars: [] }
}

///|
pub fn Activation::from_pairs(pairs : Array[(String, Value)]) -> Activation {
  Activation::{ vars: pairs }
}

///|
pub fn Activation::with_var(self : Activation, name : String, value : Value) -> Activation {
  let out : Array[(String, Value)] = []
  let mut replaced = false
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      out.push((name, value))
      replaced = true
    } else {
      out.push((k, v))
    }
    i = i + 1
  }
  if !replaced {
    out.push((name, value))
  }
  Activation::{ vars: out }
}

///|
pub fn Activation::lookup(self : Activation, name : String) -> Option[Value] {
  let mut i = 0
  while i < self.vars.length() {
    let (k, v) = self.vars[i]
    if k == name {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Parsed CEL abstract syntax tree.
pub struct Ast {
  pub source : String
  pub expr_id : Int
}

///| Statically type-checked CEL AST.
pub struct CheckedAst {
  pub ast : Ast
  pub result_type : CelType
}

///| Compiled, reusable CEL program.
pub struct Program {
  pub source : String
  pub result_type : CelType
}
