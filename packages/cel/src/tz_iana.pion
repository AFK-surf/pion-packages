///| CEL timezone resolution: UTC/GMT/Z, fixed `±HH:MM` / `±HH` / `HH:MM` offsets,
///| and common IANA time zones resolved via `packages/time::TimeZone::posix`.

import "time"

fn iana_to_posix(name : String) -> Option[String] {
  // UTC / GMT aliases
  if name == "UTC" || name == "Etc/UTC" || name == "Etc/GMT" || name == "GMT" || name == "Etc/GMT+0" || name == "Etc/GMT-0" || name == "Etc/GMT0" || name == "Etc/Universal" || name == "Etc/Zulu" || name == "Universal" || name == "Zulu" || name == "Greenwich" {
    return Some("UTC0")
  }
  // North America
  if name == "America/New_York" || name == "US/Eastern" || name == "America/Toronto" || name == "America/Detroit" || name == "America/Indiana/Indianapolis" || name == "America/Montreal" || name == "EST5EDT" {
    return Some("EST5EDT,M3.2.0,M11.1.0")
  }
  if name == "America/Chicago" || name == "US/Central" || name == "America/Winnipeg" || name == "CST6CDT" {
    return Some("CST6CDT,M3.2.0,M11.1.0")
  }
  if name == "America/Denver" || name == "US/Mountain" || name == "America/Edmonton" || name == "MST7MDT" {
    return Some("MST7MDT,M3.2.0,M11.1.0")
  }
  if name == "America/Los_Angeles" || name == "US/Pacific" || name == "America/Vancouver" || name == "America/Tijuana" || name == "PST8PDT" {
    return Some("PST8PDT,M3.2.0,M11.1.0")
  }
  if name == "America/Anchorage" || name == "US/Alaska" {
    return Some("AKST9AKDT,M3.2.0,M11.1.0")
  }
  if name == "Pacific/Honolulu" || name == "US/Hawaii" {
    return Some("HST10")
  }
  if name == "America/Phoenix" || name == "US/Arizona" {
    return Some("MST7")
  }
  if name == "America/Halifax" || name == "Canada/Atlantic" {
    return Some("AST4ADT,M3.2.0,M11.1.0")
  }
  if name == "America/St_Johns" || name == "Canada/Newfoundland" {
    return Some("NST3:30NDT,M3.2.0,M11.1.0")
  }
  if name == "America/Mexico_City" || name == "America/Monterrey" {
    return Some("CST6")
  }
  if name == "America/Bogota" || name == "America/Lima" || name == "America/Panama" {
    return Some("<-05>5")
  }
  if name == "America/Caracas" {
    return Some("<-04>4")
  }
  if name == "America/Sao_Paulo" || name == "America/Argentina/Buenos_Aires" || name == "America/Montevideo" {
    return Some("<-03>3")
  }
  if name == "America/Santiago" {
    return Some("<-04>4<-03>,M9.1.6/24,M4.1.6/24")
  }
  // Europe
  if name == "Europe/London" || name == "Europe/Dublin" || name == "Europe/Lisbon" || name == "Atlantic/Canary" || name == "GB" {
    return Some("GMT0BST,M3.5.0/1,M10.5.0")
  }
  if name == "Atlantic/Reykjavik" || name == "Africa/Accra" || name == "Africa/Dakar" {
    return Some("GMT0")
  }
  if name == "Europe/Paris" || name == "Europe/Berlin" || name == "Europe/Amsterdam" || name == "Europe/Brussels" || name == "Europe/Madrid" || name == "Europe/Rome" || name == "Europe/Zurich" || name == "Europe/Vienna" || name == "Europe/Prague" || name == "Europe/Warsaw" || name == "Europe/Stockholm" || name == "Europe/Oslo" || name == "Europe/Copenhagen" || name == "Europe/Budapest" || name == "Europe/Belgrade" || name == "CET" {
    return Some("CET-1CEST,M3.5.0,M10.5.0/3")
  }
  if name == "Europe/Athens" || name == "Europe/Bucharest" || name == "Europe/Helsinki" || name == "Europe/Kiev" || name == "Europe/Kyiv" || name == "Europe/Sofia" || name == "Europe/Tallinn" || name == "Europe/Riga" || name == "Europe/Vilnius" || name == "EET" {
    return Some("EET-2EEST,M3.5.0/3,M10.5.0/4")
  }
  if name == "Europe/Moscow" || name == "Europe/Istanbul" || name == "Europe/Minsk" || name == "Asia/Riyadh" || name == "Asia/Baghdad" || name == "Africa/Nairobi" {
    return Some("<+03>-3")
  }
  if name == "Asia/Jerusalem" || name == "Israel" {
    return Some("IST-2IDT,M3.4.4/26,M10.5.0")
  }
  // Africa
  if name == "Africa/Cairo" {
    return Some("EET-2EEST,M4.5.5/0,M10.5.4/24")
  }
  if name == "Africa/Johannesburg" || name == "Africa/Harare" {
    return Some("SAST-2")
  }
  if name == "Africa/Lagos" || name == "Africa/Algiers" || name == "Africa/Tunis" {
    return Some("WAT-1")
  }
  // Asia
  if name == "Asia/Dubai" || name == "Asia/Muscat" || name == "Asia/Baku" || name == "Asia/Tbilisi" || name == "Asia/Yerevan" {
    return Some("<+04>-4")
  }
  if name == "Asia/Tehran" {
    return Some("<+0330>-3:30")
  }
  if name == "Asia/Kabul" {
    return Some("<+0430>-4:30")
  }
  if name == "Asia/Karachi" || name == "Asia/Tashkent" || name == "Asia/Yekaterinburg" {
    return Some("PKT-5")
  }
  if name == "Asia/Kolkata" || name == "Asia/Calcutta" || name == "Asia/Colombo" {
    return Some("IST-5:30")
  }
  if name == "Asia/Kathmandu" || name == "Asia/Katmandu" {
    return Some("<+0545>-5:45")
  }
  if name == "Asia/Dhaka" || name == "Asia/Almaty" || name == "Asia/Bishkek" {
    return Some("<+06>-6")
  }
  if name == "Asia/Yangon" || name == "Asia/Rangoon" {
    return Some("<+0630>-6:30")
  }
  if name == "Asia/Bangkok" || name == "Asia/Ho_Chi_Minh" || name == "Asia/Saigon" || name == "Asia/Jakarta" || name == "Asia/Phnom_Penh" || name == "Asia/Novosibirsk" {
    return Some("<+07>-7")
  }
  if name == "Asia/Shanghai" || name == "Asia/Chongqing" || name == "Asia/Harbin" || name == "Asia/Urumqi" || name == "Asia/Hong_Kong" || name == "Asia/Taipei" || name == "Asia/Singapore" || name == "Asia/Kuala_Lumpur" || name == "Asia/Manila" || name == "Asia/Macau" || name == "Australia/Perth" || name == "PRC" {
    return Some("CST-8")
  }
  if name == "Asia/Tokyo" || name == "Asia/Seoul" || name == "Asia/Pyongyang" || name == "Asia/Jayapura" || name == "Japan" || name == "ROK" {
    return Some("JST-9")
  }
  if name == "Australia/Darwin" {
    return Some("ACST-9:30")
  }
  if name == "Australia/Adelaide" {
    return Some("ACST-9:30ACDT,M10.1.0,M4.1.0/3")
  }
  if name == "Australia/Brisbane" || name == "Pacific/Guam" || name == "Asia/Vladivostok" {
    return Some("AEST-10")
  }
  if name == "Australia/Sydney" || name == "Australia/Melbourne" || name == "Australia/Hobart" || name == "Australia/Canberra" {
    return Some("AEST-10AEDT,M10.1.0,M4.1.0/3")
  }
  if name == "Pacific/Auckland" || name == "NZ" {
    return Some("NZST-12NZDT,M9.5.0,M4.1.0/3")
  }
  if name == "Pacific/Fiji" {
    return Some("<+12>-12")
  }
  if name == "Pacific/Chatham" {
    return Some("<+1245>-12:45<+1345>,M9.5.0/2:45,M4.1.0/3:45")
  }
  if name == "Pacific/Tongatapu" || name == "Pacific/Apia" {
    return Some("<+13>-13")
  }
  if name == "Pacific/Kiritimati" {
    return Some("<+14>-14")
  }
  // Etc/GMT+/-N (POSIX sign is inverted relative to ISO, and Etc/GMT+N means UTC-N)
  if name == "Etc/GMT+1" { return Some("<-01>1") }
  if name == "Etc/GMT+2" { return Some("<-02>2") }
  if name == "Etc/GMT+3" { return Some("<-03>3") }
  if name == "Etc/GMT+4" { return Some("<-04>4") }
  if name == "Etc/GMT+5" { return Some("<-05>5") }
  if name == "Etc/GMT+6" { return Some("<-06>6") }
  if name == "Etc/GMT+7" { return Some("<-07>7") }
  if name == "Etc/GMT+8" { return Some("<-08>8") }
  if name == "Etc/GMT+9" { return Some("<-09>9") }
  if name == "Etc/GMT+10" { return Some("<-10>10") }
  if name == "Etc/GMT+11" { return Some("<-11>11") }
  if name == "Etc/GMT+12" { return Some("<-12>12") }
  if name == "Etc/GMT-1" { return Some("<+01>-1") }
  if name == "Etc/GMT-2" { return Some("<+02>-2") }
  if name == "Etc/GMT-3" { return Some("<+03>-3") }
  if name == "Etc/GMT-4" { return Some("<+04>-4") }
  if name == "Etc/GMT-5" { return Some("<+05>-5") }
  if name == "Etc/GMT-6" { return Some("<+06>-6") }
  if name == "Etc/GMT-7" { return Some("<+07>-7") }
  if name == "Etc/GMT-8" { return Some("<+08>-8") }
  if name == "Etc/GMT-9" { return Some("<+09>-9") }
  if name == "Etc/GMT-10" { return Some("<+10>-10") }
  if name == "Etc/GMT-11" { return Some("<+11>-11") }
  if name == "Etc/GMT-12" { return Some("<+12>-12") }
  if name == "Etc/GMT-13" { return Some("<+13>-13") }
  if name == "Etc/GMT-14" { return Some("<+14>-14") }
  None
}

///| Resolve a CEL timezone string at timestamp `ts`:
///| - `"UTC"`, `"GMT"`, `"Z"`
///| - Fixed offsets: `"+09:00"`, `"-05:30"`, `"+09"`, `"-08"`, and sign-less `"05:30"`
///| - Common IANA timezone names (e.g. `"America/New_York"`, `"Asia/Kolkata"`, `"Europe/London"`)
pub fn resolve_cel_tz_offset(
  tz : String,
  ts : time::Timestamp,
  pos : Int,
) -> Result[time::Offset, CelError] {
  if tz == "UTC" || tz == "Z" || tz == "GMT" || tz == "+00:00" || tz == "-00:00" || tz == "00:00" {
    return Ok(time::Offset::utc())
  }
  // Check IANA name first
  match iana_to_posix(tz) {
    Some(spec) => {
      match time::TimeZone::posix(spec) {
        Ok(zone) => return Ok(zone.to_offset(ts))
        Err(_) => return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
      }
    }
    None => ()
  }
  // Fixed offset: `±HH:MM`, `±HH`, or sign-less `HH:MM` (CEL / cel-go supports sign-less `HH:MM` as +HH:MM)
  let bs = string_to_bytes(tz)
  let n = bs.length()
  if n == 5 && bs[2].to_int() == 58 {
    // Sign-less HH:MM
    let h1 = bs[0].to_int() - 48
    let h2 = bs[1].to_int() - 48
    let m1 = bs[3].to_int() - 48
    let m2 = bs[4].to_int() - 48
    if h1 >= 0 && h1 <= 9 && h2 >= 0 && h2 <= 9 && m1 >= 0 && m1 <= 9 && m2 >= 0 && m2 <= 9 {
      let hours = h1 * 10 + h2
      let mins = m1 * 10 + m2
      if hours <= 23 && mins <= 59 {
        match time::Offset::from_seconds(hours * 3600 + mins * 60) {
          Ok(o) => return Ok(o)
          Err(_) => ()
        }
      }
    }
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  if n == 5 && (bs[0].to_int() == 43 || bs[0].to_int() == 45) && bs[2].to_int() == 58 {
    // ±H:MM (single-digit hour, e.g. "+5:30")
    let sign = if bs[0].to_int() == 43 { 1 } else { -1 }
    let h1 = bs[1].to_int() - 48
    let m1 = bs[3].to_int() - 48
    let m2 = bs[4].to_int() - 48
    if h1 >= 0 && h1 <= 9 && m1 >= 0 && m1 <= 9 && m2 >= 0 && m2 <= 9 {
      let mins = m1 * 10 + m2
      if mins <= 59 {
        match time::Offset::from_seconds(sign * (h1 * 3600 + mins * 60)) {
          Ok(o) => return Ok(o)
          Err(_) => ()
        }
      }
    }
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  if n == 6 && (bs[0].to_int() == 43 || bs[0].to_int() == 45) && bs[3].to_int() == 58 {
    let sign = if bs[0].to_int() == 43 { 1 } else { -1 }
    let h1 = bs[1].to_int() - 48
    let h2 = bs[2].to_int() - 48
    let m1 = bs[4].to_int() - 48
    let m2 = bs[5].to_int() - 48
    if h1 >= 0 && h1 <= 9 && h2 >= 0 && h2 <= 9 && m1 >= 0 && m1 <= 9 && m2 >= 0 && m2 <= 9 {
      let hours = h1 * 10 + h2
      let mins = m1 * 10 + m2
      if hours <= 23 && mins <= 59 {
        match time::Offset::from_seconds(sign * (hours * 3600 + mins * 60)) {
          Ok(o) => return Ok(o)
          Err(_) => ()
        }
      }
    }
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  if n == 3 && (bs[0].to_int() == 43 || bs[0].to_int() == 45) {
    let sign = if bs[0].to_int() == 43 { 1 } else { -1 }
    let h1 = bs[1].to_int() - 48
    let h2 = bs[2].to_int() - 48
    if h1 >= 0 && h1 <= 9 && h2 >= 0 && h2 <= 9 {
      let hours = h1 * 10 + h2
      if hours <= 23 {
        match time::Offset::from_seconds(sign * hours * 3600) {
          Ok(o) => return Ok(o)
          Err(_) => ()
        }
      }
    }
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  Err(CelError::new(CelErrorKind::InvalidArgument, "unsupported timezone: " + tz, pos))
}
