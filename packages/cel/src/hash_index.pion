///| Seeded open-addressing hash indices for O(1) `Activation` variable lookup
///| and O(1) `Value::Map` lookup (with canonical heterogeneous numeric key hashing).

struct CelSeedState {
  mut counter : UInt64
}

let cel_seed_state : CelSeedState = CelSeedState::{ counter: 0x9E3779B97F4A7C15UL }

fn cel_splitmix64(x : UInt64) -> UInt64 {
  let mut z = x + 0x9E3779B97F4A7C15UL
  z = (z ^ (z >> 30UL)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27UL)) * 0x94D049BB133111EBUL
  z ^ (z >> 31UL)
}

fn cel_next_seed() -> UInt64 {
  cel_seed_state.counter = cel_seed_state.counter + 0x9E3779B97F4A7C15UL
  cel_splitmix64(cel_seed_state.counter)
}

///| Seeded 64-bit string hash (non-zero).
fn cel_hash_str(s : String, seed : UInt64) -> UInt64 {
  let n = s.length()
  let mut h = seed ^ (n.to_int64().reinterpret_as_uint64() * 0x9E3779B97F4A7C15UL)
  let mut i = 0
  while i + 4 <= n {
    let w = s.code_unit_at(i).to_int64().reinterpret_as_uint64() |
    (s.code_unit_at(i + 1).to_int64().reinterpret_as_uint64() << 8UL) |
    (s.code_unit_at(i + 2).to_int64().reinterpret_as_uint64() << 16UL) |
    (s.code_unit_at(i + 3).to_int64().reinterpret_as_uint64() << 24UL)
    h = (h ^ w) * 0xBF58476D1CE4E5B9UL
    h = h ^ (h >> 27UL)
    i = i + 4
  }
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()) * 0x94D049BB133111EBUL
    h = h ^ (h >> 31UL)
    i = i + 1
  }
  h = (h ^ (h >> 30UL)) * 0xBF58476D1CE4E5B9UL
  h = (h ^ (h >> 27UL)) * 0x94D049BB133111EBUL
  h = h ^ (h >> 31UL)
  if h == 0UL { 1UL } else { h }
}

///| Canonical 64-bit hash for a CEL map key (returns `0UL` if key cannot match any valid map key).
///| Guarantees identical hash for equal numeric keys (`Int64`, `UInt64`, integer `Double`).
fn cel_hash_map_key(k : Value, seed : UInt64) -> UInt64 {
  match k.kind {
    ValueKind::String(s) => cel_hash_str(s, seed ^ 0x535452494E475F31UL)
    ValueKind::Bool(b) => {
      let v : UInt64 = if b { 0x424F4F4C5F545255UL } else { 0x424F4F4C5F46414CUL }
      let h = cel_splitmix64(seed ^ v)
      if h == 0UL { 1UL } else { h }
    }
    ValueKind::Int64(n) => {
      if n >= 0L {
        let h = cel_splitmix64(seed ^ 0x4E554D5F504F5331UL ^ n.reinterpret_as_uint64())
        if h == 0UL { 1UL } else { h }
      } else {
        let h = cel_splitmix64(seed ^ 0x4E554D5F4E454731UL ^ n.reinterpret_as_uint64())
        if h == 0UL { 1UL } else { h }
      }
    }
    ValueKind::UInt64(u) => {
      let h = cel_splitmix64(seed ^ 0x4E554D5F504F5331UL ^ u)
      if h == 0UL { 1UL } else { h }
    }
    ValueKind::Double(d) => {
      if is_nan_f64(d) || is_inf_f64(d) {
        return 0UL
      }
      if d < CEL_NEG_TWO_63_F || d >= CEL_TWO_64_F {
        return 0UL
      }
      if d < 0.0 {
        let di = d.to_int64()
        if di.to_double() != d {
          return 0UL
        }
        let h = cel_splitmix64(seed ^ 0x4E554D5F4E454731UL ^ di.reinterpret_as_uint64())
        if h == 0UL { 1UL } else { h }
      } else if d < CEL_TWO_63_F {
        let di = d.to_int64()
        if di.to_double() != d {
          return 0UL
        }
        let h = cel_splitmix64(seed ^ 0x4E554D5F504F5331UL ^ di.reinterpret_as_uint64())
        if h == 0UL { 1UL } else { h }
      } else {
        // [2^63, 2^64): all doubles are exact integers
        let u = (d - CEL_TWO_63_F).to_int64().reinterpret_as_uint64() + CEL_TWO_63_U
        let h = cel_splitmix64(seed ^ 0x4E554D5F504F5331UL ^ u)
        if h == 0UL { 1UL } else { h }
      }
    }
    _ => 0UL
  }
}

///| O(1) seeded open-addressing string-to-index table (used by `Activation` and `Env`).
struct StrHashIndex {
  seed : UInt64
  cap : Int
  keys : FixedArray[String]
  hashes : FixedArray[UInt64]
  ///| index + 1 (0 means empty slot)
  vals : FixedArray[Int]
}

fn StrHashIndex::from_str_val_pairs(pairs : Array[(String, Value)]) -> StrHashIndex {
  let n = pairs.length()
  let mut cap = 16
  while cap * 5 <= n * 8 {
    cap = cap << 1
  }
  let seed = cel_next_seed()
  let keys = FixedArray::make(cap, "")
  let hashes = FixedArray::make(cap, 0UL)
  let vals = FixedArray::make(cap, 0)
  let mask = cap - 1
  let mask_u = mask.to_int64().reinterpret_as_uint64()
  let mut i = 0
  while i < n {
    let (k, _) = pairs[i]
    let h = cel_hash_str(k, seed)
    let mut slot = (h & mask_u).to_int()
    while true {
      let v = vals[slot]
      if v == 0 {
        keys[slot] = k
        hashes[slot] = h
        vals[slot] = i + 1
        break
      }
      if hashes[slot] == h && keys[slot] == k {
        // Keep first match to match linear Activation::lookup semantics
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrHashIndex::{ seed: seed, cap: cap, keys: keys, hashes: hashes, vals: vals }
}

fn StrHashIndex::get(self : StrHashIndex, key : String) -> Int {
  let h = cel_hash_str(key, self.seed)
  let mask = self.cap - 1
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = self.vals[slot]
    if v == 0 {
      return -1
    }
    if self.hashes[slot] == h && self.keys[slot] == key {
      return v - 1
    }
    slot = (slot + 1) & mask
  }
  -1
}

///| O(1) seeded open-addressing index over `ValueKind::Map(entries)`.
struct CelMapIndex {
  seed : UInt64
  cap : Int
  hashes : FixedArray[UInt64]
  ///| entry_idx + 1 (0 means empty slot)
  slots : FixedArray[Int]
}

fn CelMapIndex::build(entries : Array[(Value, Value)]) -> CelMapIndex {
  let n = entries.length()
  let mut cap = 16
  while cap * 5 <= n * 8 {
    cap = cap << 1
  }
  let seed = cel_next_seed()
  let hashes = FixedArray::make(cap, 0UL)
  let slots = FixedArray::make(cap, 0)
  let mask = cap - 1
  let mask_u = mask.to_int64().reinterpret_as_uint64()
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    let h = cel_hash_map_key(k, seed)
    if h != 0UL {
      let mut slot = (h & mask_u).to_int()
      while true {
        let s = slots[slot]
        if s == 0 {
          hashes[slot] = h
          slots[slot] = i + 1
          break
        }
        let (existing_k, _) = entries[s - 1]
        if hashes[slot] == h && cel_values_equal(existing_k, k) {
          // Last-wins overwrite
          slots[slot] = i + 1
          break
        }
        slot = (slot + 1) & mask
      }
    }
    i = i + 1
  }
  CelMapIndex::{ seed: seed, cap: cap, hashes: hashes, slots: slots }
}

fn CelMapIndex::lookup(
  self : CelMapIndex,
  entries : Array[(Value, Value)],
  key : Value,
) -> Int {
  let h = cel_hash_map_key(key, self.seed)
  if h == 0UL {
    return -1
  }
  let mask = self.cap - 1
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let s = self.slots[slot]
    if s == 0 {
      return -1
    }
    if self.hashes[slot] == h {
      let (ek, _) = entries[s - 1]
      if cel_values_equal(ek, key) {
        return s - 1
      }
    }
    slot = (slot + 1) & mask
  }
  -1
}

fn CelMapIndex::lookup_str(
  self : CelMapIndex,
  entries : Array[(Value, Value)],
  field : String,
) -> Int {
  let h = cel_hash_str(field, self.seed ^ 0x535452494E475F31UL)
  let mask = self.cap - 1
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let s = self.slots[slot]
    if s == 0 {
      return -1
    }
    if self.hashes[slot] == h {
      let (ek, _) = entries[s - 1]
      match ek.kind {
        ValueKind::String(ks) => {
          if ks == field {
            return s - 1
          }
        }
        _ => ()
      }
    }
    slot = (slot + 1) & mask
  }
  -1
}
