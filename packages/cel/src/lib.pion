///| Public entrypoints for `cel` (stub implementation for Red phase).

///| Parse a CEL expression with default limits.
pub fn parse(source : String) -> Result[Ast, CelError] {
  parse_with_limits(source, EvalLimits::default())
}

///| Parse a CEL expression with explicit depth/budget limits.
pub fn parse_with_limits(_source : String, _limits : EvalLimits) -> Result[Ast, CelError] {
  Err(CelError::unimplemented("parse"))
}

///| Statically type-check a parsed CEL AST against an `Env`.
pub fn check(_ast : Ast, _env : Env) -> Result[CheckedAst, CelError] {
  Err(CelError::unimplemented("check"))
}

///| Parse, statically type-check, and compile a reusable `Program`.
pub fn compile(source : String, env : Env) -> Result[Program, CelError] {
  compile_with_limits(source, env, EvalLimits::default())
}

///| Parse, statically type-check, and compile a reusable `Program` with explicit limits.
pub fn compile_with_limits(
  _source : String,
  _env : Env,
  _limits : EvalLimits,
) -> Result[Program, CelError] {
  Err(CelError::unimplemented("compile"))
}

///| One-shot parse and evaluate a CEL expression against an `Activation`.
pub fn eval(source : String, activation : Activation) -> Result[Value, CelError] {
  eval_with_limits(source, activation, EvalLimits::default())
}

///| One-shot parse and evaluate a CEL expression with explicit `EvalLimits`.
pub fn eval_with_limits(
  _source : String,
  _activation : Activation,
  _limits : EvalLimits,
) -> Result[Value, CelError] {
  Err(CelError::unimplemented("eval"))
}

///| Evaluate a compiled `Program` with default limits.
pub fn Program::eval(self : Program, activation : Activation) -> Result[Value, CelError] {
  self.eval_with_limits(activation, EvalLimits::default())
}

///| Evaluate a compiled `Program` with explicit `EvalLimits`.
pub fn Program::eval_with_limits(
  self : Program,
  _activation : Activation,
  _limits : EvalLimits,
) -> Result[Value, CelError] {
  let _ = self
  Err(CelError::unimplemented("Program::eval"))
}

///| Return the statically inferred result type of a compiled `Program`.
pub fn Program::result_type(self : Program) -> CelType {
  self.result_type
}
