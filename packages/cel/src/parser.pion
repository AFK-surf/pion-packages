///| Depth-bounded recursive-descent CEL parser with standard macro expansion
///| (`has`, `all`, `exists`, `exists_one`, `map`, `filter`).

struct Parser {
  tokens : Array[Token]
  mut idx : Int
  nodes : Array[ExprNode]
  max_depth : Int
  mut depth : Int
}

fn Parser::peek(self : Parser) -> Token {
  self.tokens[self.idx]
}

fn Parser::advance(self : Parser) -> Token {
  let t = self.tokens[self.idx]
  if self.idx + 1 < self.tokens.length() {
    self.idx = self.idx + 1
  }
  t
}

fn Parser::push_node(self : Parser, node : ExprNode) -> Int {
  let id = self.nodes.length()
  self.nodes.push(node)
  id
}

fn Parser::enter(self : Parser, pos : Int) -> Result[Unit, CelError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(
      CelError::new(
        CelErrorKind::LimitExceeded,
        "expression nesting depth exceeds limit (" + self.max_depth.to_string() + ")",
        pos,
      ),
    )
  }
  Ok(())
}

fn Parser::leave(self : Parser) -> Unit {
  self.depth = self.depth - 1
}

fn Parser::parse_expr(self : Parser) -> Result[Int, CelError] {
  let pos = self.peek().pos
  match self.enter(pos) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let res = self.parse_ternary()
  self.leave()
  res
}

fn Parser::parse_ternary(self : Parser) -> Result[Int, CelError] {
  let cond = match self.parse_or() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokenKind::Question => {
      let pos = self.advance().pos
      let then_id = match self.parse_or() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      match self.peek().kind {
        TokenKind::Colon => {
          let _ = self.advance()
        }
        _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ':' in ternary expression", self.peek().pos))
      }
      let else_id = match self.parse_expr() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.push_node(ExprNode::Ternary(cond, then_id, else_id, pos)))
    }
    _ => Ok(cond)
  }
}

fn Parser::parse_or(self : Parser) -> Result[Int, CelError] {
  let first = match self.parse_and() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokenKind::OrOr => ()
    _ => return Ok(first)
  }
  let first_pos = self.peek().pos
  let items : Array[Int] = [first]
  while true {
    match self.peek().kind {
      TokenKind::OrOr => {
        let pos = self.advance().pos
        if items.length() >= 10000 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "logical '||' chain exceeds limit (10000)", pos))
        }
        let rhs = match self.parse_and() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        items.push(rhs)
      }
      _ => break
    }
  }
  if items.length() == 2 {
    Ok(self.push_node(ExprNode::Binary(BinOp::Or, items[0], items[1], first_pos)))
  } else {
    Ok(self.push_node(ExprNode::OrChain(items, first_pos)))
  }
}

fn Parser::parse_and(self : Parser) -> Result[Int, CelError] {
  let first = match self.parse_rel() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokenKind::AndAnd => ()
    _ => return Ok(first)
  }
  let first_pos = self.peek().pos
  let items : Array[Int] = [first]
  while true {
    match self.peek().kind {
      TokenKind::AndAnd => {
        let pos = self.advance().pos
        if items.length() >= 10000 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "logical '&&' chain exceeds limit (10000)", pos))
        }
        let rhs = match self.parse_rel() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        items.push(rhs)
      }
      _ => break
    }
  }
  if items.length() == 2 {
    Ok(self.push_node(ExprNode::Binary(BinOp::And, items[0], items[1], first_pos)))
  } else {
    Ok(self.push_node(ExprNode::AndChain(items, first_pos)))
  }
}

fn Parser::parse_rel(self : Parser) -> Result[Int, CelError] {
  let mut lhs = match self.parse_add() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut chain = 0
  while true {
    let op_opt = match self.peek().kind {
      TokenKind::EqEq => Some(BinOp::Eq)
      TokenKind::BangEq => Some(BinOp::Ne)
      TokenKind::Lt => Some(BinOp::Lt)
      TokenKind::LtEq => Some(BinOp::Le)
      TokenKind::Gt => Some(BinOp::Gt)
      TokenKind::GtEq => Some(BinOp::Ge)
      TokenKind::KwIn => Some(BinOp::In)
      _ => None
    }
    match op_opt {
      Some(op) => {
        let pos = self.advance().pos
        chain = chain + 1
        if chain >= 250 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "max recursion depth exceeded (250)", pos))
        }
        let rhs = match self.parse_add() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.push_node(ExprNode::Binary(op, lhs, rhs, pos))
      }
      None => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_add(self : Parser) -> Result[Int, CelError] {
  let mut lhs = match self.parse_mul() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut chain = 0
  while true {
    let op_opt = match self.peek().kind {
      TokenKind::Plus => Some(BinOp::Add)
      TokenKind::Minus => Some(BinOp::Sub)
      _ => None
    }
    match op_opt {
      Some(op) => {
        let pos = self.advance().pos
        chain = chain + 1
        if chain >= 250 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "max recursion depth exceeded (250)", pos))
        }
        let rhs = match self.parse_mul() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.push_node(ExprNode::Binary(op, lhs, rhs, pos))
      }
      None => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_mul(self : Parser) -> Result[Int, CelError] {
  let mut lhs = match self.parse_unary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut chain = 0
  while true {
    let op_opt = match self.peek().kind {
      TokenKind::Star => Some(BinOp::Mul)
      TokenKind::Slash => Some(BinOp::Div)
      TokenKind::Percent => Some(BinOp::Mod)
      _ => None
    }
    match op_opt {
      Some(op) => {
        let pos = self.advance().pos
        chain = chain + 1
        if chain >= 250 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "max recursion depth exceeded (250)", pos))
        }
        let rhs = match self.parse_unary() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.push_node(ExprNode::Binary(op, lhs, rhs, pos))
      }
      None => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_unary(self : Parser) -> Result[Int, CelError] {
  match self.peek().kind {
    TokenKind::Minus => {
      let pos = self.advance().pos
      // Special case: direct `-9223372036854775808` folds to i64::MIN
      match self.peek().kind {
        TokenKind::IntLit(v) => {
          if v == 9223372036854775808UL {
            let _ = self.advance()
            return Ok(self.push_node(ExprNode::LitInt(-9223372036854775807L - 1L)))
          }
        }
        _ => ()
      }
      match self.enter(pos) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let child = self.parse_unary()
      self.leave()
      match child {
        Ok(id) => Ok(self.push_node(ExprNode::Unary(UnaryOp::Neg, id, pos)))
        Err(e) => Err(e)
      }
    }
    TokenKind::Bang => {
      let pos = self.advance().pos
      match self.enter(pos) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let child = self.parse_unary()
      self.leave()
      match child {
        Ok(id) => Ok(self.push_node(ExprNode::Unary(UnaryOp::Not, id, pos)))
        Err(e) => Err(e)
      }
    }
    _ => self.parse_member()
  }
}

fn Parser::parse_arg_list(self : Parser) -> Result[Array[Int], CelError] {
  let args : Array[Int] = []
  match self.peek().kind {
    TokenKind::RParen => {
      let _ = self.advance()
      return Ok(args)
    }
    _ => ()
  }
  while true {
    let arg = match self.parse_expr() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    args.push(arg)
    match self.peek().kind {
      TokenKind::Comma => {
        let _ = self.advance()
        match self.peek().kind {
          TokenKind::RParen => {
            let _ = self.advance()
            break
          }
          _ => ()
        }
      }
      TokenKind::RParen => {
        let _ = self.advance()
        break
      }
      _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ',' or ')' in argument list", self.peek().pos))
    }
  }
  Ok(args)
}

fn Parser::extract_ident(self : Parser, node_id : Int, pos : Int) -> Result[String, CelError] {
  match self.nodes[node_id] {
    ExprNode::Ident(name, _) => Ok(name)
    _ => Err(CelError::new(CelErrorKind::SyntaxError, "macro iteration variable must be an identifier", pos))
  }
}

fn Parser::expand_method_macro(
  self : Parser,
  target : Int,
  name : String,
  args : Array[Int],
  pos : Int,
) -> Result[Option[Int], CelError] {
  if name == "all" && args.length() == 2 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::All, target, var_name, -1, args[1], pos))))
  }
  if name == "exists" && args.length() == 2 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::Exists, target, var_name, -1, args[1], pos))))
  }
  if name == "exists_one" && args.length() == 2 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::ExistsOne, target, var_name, -1, args[1], pos))))
  }
  if name == "filter" && args.length() == 2 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::Filter, target, var_name, args[1], -1, pos))))
  }
  if name == "map" && args.length() == 2 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::Map, target, var_name, -1, args[1], pos))))
  }
  if name == "map" && args.length() == 3 {
    let var_name = match self.extract_ident(args[0], pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Ok(Some(self.push_node(ExprNode::Comprehension(CompKind::MapFilter, target, var_name, args[1], args[2], pos))))
  }
  Ok(None)
}

fn Parser::parse_member(self : Parser) -> Result[Int, CelError] {
  let mut expr = match self.parse_primary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut chain = 0
  while true {
    match self.peek().kind {
      TokenKind::Dot => {
        let pos = self.advance().pos
        chain = chain + 1
        if chain >= 250 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "max recursion depth exceeded (250)", pos))
        }
        let field = match self.peek().kind {
          TokenKind::Ident(s) => {
            let _ = self.advance()
            s
          }
          _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected field or method name after '.'", self.peek().pos))
        }
        match self.peek().kind {
          TokenKind::LParen => {
            let _ = self.advance()
            let args = match self.parse_arg_list() {
              Ok(a) => a
              Err(e) => return Err(e)
            }
            match self.expand_method_macro(expr, field, args, pos) {
              Ok(Some(macro_id)) => expr = macro_id
              Ok(None) => expr = self.push_node(ExprNode::Call(field, Some(expr), args, pos))
              Err(e) => return Err(e)
            }
          }
          _ => expr = self.push_node(ExprNode::Select(expr, field, false, pos))
        }
      }
      TokenKind::LBracket => {
        let pos = self.advance().pos
        chain = chain + 1
        if chain >= 250 {
          return Err(CelError::new(CelErrorKind::LimitExceeded, "max recursion depth exceeded (250)", pos))
        }
        let index_id = match self.parse_expr() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        match self.peek().kind {
          TokenKind::RBracket => {
            let _ = self.advance()
          }
          _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ']' after index", self.peek().pos))
        }
        expr = self.push_node(ExprNode::Index(expr, index_id, pos))
      }
      _ => break
    }
  }
  Ok(expr)
}

fn Parser::parse_primary(self : Parser) -> Result[Int, CelError] {
  let tok = self.peek()
  match tok.kind {
    TokenKind::NullLit => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitNull))
    }
    TokenKind::TrueLit => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitBool(true)))
    }
    TokenKind::FalseLit => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitBool(false)))
    }
    TokenKind::IntLit(v) => {
      let _ = self.advance()
      if v > 9223372036854775807UL {
        return Err(CelError::new(CelErrorKind::SyntaxError, "integer literal exceeds int64 max", tok.pos))
      }
      Ok(self.push_node(ExprNode::LitInt(v.reinterpret_as_int64())))
    }
    TokenKind::UIntLit(v) => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitUInt(v)))
    }
    TokenKind::DoubleLit(d) => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitDouble(d)))
    }
    TokenKind::StringLit(s) => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitString(s)))
    }
    TokenKind::BytesLit(bs) => {
      let _ = self.advance()
      Ok(self.push_node(ExprNode::LitBytes(bs)))
    }
    TokenKind::Ident(name) => {
      let pos = self.advance().pos
      match self.peek().kind {
        TokenKind::LParen => {
          let _ = self.advance()
          let args = match self.parse_arg_list() {
            Ok(a) => a
            Err(e) => return Err(e)
          }
          // `has(e.f)` macro expansion
          if name == "has" {
            if args.length() != 1 {
              return Err(CelError::new(CelErrorKind::SyntaxError, "has() takes exactly 1 select argument", pos))
            }
            match self.nodes[args[0]] {
              ExprNode::Select(target, field, false, spos) => {
                return Ok(self.push_node(ExprNode::Select(target, field, true, spos)))
              }
              _ => return Err(CelError::new(CelErrorKind::SyntaxError, "has() argument must be a field selection", pos))
            }
          }
          Ok(self.push_node(ExprNode::Call(name, None, args, pos)))
        }
        _ => Ok(self.push_node(ExprNode::Ident(name, pos)))
      }
    }
    TokenKind::LParen => {
      let _ = self.advance()
      let inner = match self.parse_expr() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      match self.peek().kind {
        TokenKind::RParen => {
          let _ = self.advance()
          Ok(inner)
        }
        _ => Err(CelError::new(CelErrorKind::SyntaxError, "expected ')'", self.peek().pos))
      }
    }
    TokenKind::LBracket => {
      let pos = self.advance().pos
      let elems : Array[Int] = []
      match self.peek().kind {
        TokenKind::RBracket => {
          let _ = self.advance()
          return Ok(self.push_node(ExprNode::ListLit(elems, pos)))
        }
        _ => ()
      }
      while true {
        let elem = match self.parse_expr() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        elems.push(elem)
        match self.peek().kind {
          TokenKind::Comma => {
            let _ = self.advance()
            match self.peek().kind {
              TokenKind::RBracket => {
                let _ = self.advance()
                break
              }
              _ => ()
            }
          }
          TokenKind::RBracket => {
            let _ = self.advance()
            break
          }
          _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ',' or ']' in list literal", self.peek().pos))
        }
      }
      Ok(self.push_node(ExprNode::ListLit(elems, pos)))
    }
    TokenKind::LBrace => {
      let pos = self.advance().pos
      let entries : Array[(Int, Int)] = []
      match self.peek().kind {
        TokenKind::RBrace => {
          let _ = self.advance()
          return Ok(self.push_node(ExprNode::MapLit(entries, pos)))
        }
        _ => ()
      }
      while true {
        let k = match self.parse_expr() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        match self.peek().kind {
          TokenKind::Colon => {
            let _ = self.advance()
          }
          _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ':' in map literal", self.peek().pos))
        }
        let v = match self.parse_expr() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        entries.push((k, v))
        match self.peek().kind {
          TokenKind::Comma => {
            let _ = self.advance()
            match self.peek().kind {
              TokenKind::RBrace => {
                let _ = self.advance()
                break
              }
              _ => ()
            }
          }
          TokenKind::RBrace => {
            let _ = self.advance()
            break
          }
          _ => return Err(CelError::new(CelErrorKind::SyntaxError, "expected ',' or '}' in map literal", self.peek().pos))
        }
      }
      Ok(self.push_node(ExprNode::MapLit(entries, pos)))
    }
    _ => Err(CelError::new(CelErrorKind::SyntaxError, "unexpected token in expression", tok.pos))
  }
}

///| Parse CEL source into an arena-backed `Ast`.
pub fn parse_ast(source : String, limits : EvalLimits) -> Result[Ast, CelError] {
  if source.length() > 1000000 {
    return Err(CelError::new(CelErrorKind::LimitExceeded, "expression source exceeds length limit (1000000)", 0))
  }
  let tokens = match tokenize(source) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let p = Parser::{
    tokens: tokens,
    idx: 0,
    nodes: [],
    max_depth: limits.max_depth,
    depth: 0,
  }
  let root = match p.parse_expr() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match p.peek().kind {
    TokenKind::Eof => Ok(Ast::{ source: source, expr_id: root, nodes: p.nodes })
    _ => Err(CelError::new(CelErrorKind::SyntaxError, "unexpected trailing token", p.peek().pos))
  }
}
