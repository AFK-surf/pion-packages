///| Exact heterogeneous numeric comparisons, checked int64/uint64 arithmetic,
///| UTF-8 utilities, float/int/duration parsing, and timestamp accessors.

import "time"

let CEL_I64_MAX : Int64 = 9223372036854775807L

let CEL_I64_MIN : Int64 = -9223372036854775807L - 1L

let CEL_U64_MAX : UInt64 = 18446744073709551615UL

let CEL_TWO_63_U : UInt64 = 9223372036854775808UL

let CEL_TWO_63_F : Double = 9223372036854775808.0

let CEL_NEG_TWO_63_F : Double = -9223372036854775808.0

let CEL_TWO_64_F : Double = 18446744073709551616.0

///| Convert non-negative Int to UInt64.
pub fn int_to_u64(n : Int) -> UInt64 {
  n.to_int64().reinterpret_as_uint64()
}

///| Convert UInt64 to Double accurately.
pub fn u64_to_double(u : UInt64) -> Double {
  if u < CEL_TWO_63_U {
    u.reinterpret_as_int64().to_double()
  } else {
    (u - CEL_TWO_63_U).reinterpret_as_int64().to_double() + CEL_TWO_63_F
  }
}

///| Check whether a Double is NaN.
pub fn is_nan_f64(d : Double) -> Bool {
  d != d
}

///| Check whether a Double is +/- Infinity.
pub fn is_inf_f64(d : Double) -> Bool {
  d == 1.0 / 0.0 || d == -1.0 / 0.0
}

///| Checked Int64 negation.
pub fn checked_neg_i64(a : Int64, pos : Int) -> Result[Int64, CelError] {
  if a == CEL_I64_MIN {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 negation overflow", pos))
  }
  Ok(0L - a)
}

///| Checked Int64 addition.
pub fn checked_add_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if b > 0L && a > CEL_I64_MAX - b {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 addition overflow", pos))
  }
  if b < 0L && a < CEL_I64_MIN - b {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 addition underflow", pos))
  }
  Ok(a + b)
}

///| Checked Int64 subtraction.
pub fn checked_sub_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if b < 0L && a > CEL_I64_MAX + b {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 subtraction overflow", pos))
  }
  if b > 0L && a < CEL_I64_MIN + b {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 subtraction underflow", pos))
  }
  Ok(a - b)
}

///| Checked Int64 multiplication.
pub fn checked_mul_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if a == 0L || b == 0L {
    return Ok(0L)
  }
  if (a == CEL_I64_MIN && b == -1L) || (b == CEL_I64_MIN && a == -1L) {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 multiplication overflow", pos))
  }
  let res = a * b
  if res / b != a {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 multiplication overflow", pos))
  }
  Ok(res)
}

///| Checked Int64 division (truncates toward zero).
pub fn checked_div_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if b == 0L {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "division by zero", pos))
  }
  if a == CEL_I64_MIN && b == -1L {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 division overflow", pos))
  }
  Ok(a / b)
}

///| Checked Int64 modulo.
pub fn checked_mod_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if b == 0L {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "modulo by zero", pos))
  }
  if a == CEL_I64_MIN && b == -1L {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 modulo overflow", pos))
  }
  Ok(a % b)
}

///| Checked UInt64 addition.
pub fn checked_add_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if a > CEL_U64_MAX - b {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 addition overflow", pos))
  }
  Ok(a + b)
}

///| Checked UInt64 subtraction.
pub fn checked_sub_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if a < b {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 subtraction underflow", pos))
  }
  Ok(a - b)
}

///| Checked UInt64 multiplication.
pub fn checked_mul_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if a == 0UL || b == 0UL {
    return Ok(0UL)
  }
  if a > CEL_U64_MAX / b {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 multiplication overflow", pos))
  }
  Ok(a * b)
}

///| Checked UInt64 division.
pub fn checked_div_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if b == 0UL {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "division by zero", pos))
  }
  Ok(a / b)
}

///| Checked UInt64 modulo.
pub fn checked_mod_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if b == 0UL {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "modulo by zero", pos))
  }
  Ok(a % b)
}

///| Exact comparison between Int64 and UInt64 (-1, 0, +1).
pub fn cmp_i64_u64(i : Int64, u : UInt64) -> Int {
  if i < 0L {
    return -1
  }
  let iu = i.reinterpret_as_uint64()
  if iu < u {
    -1
  } else if iu > u {
    1
  } else {
    0
  }
}

///| Exact comparison between Int64 and Double. Returns `None` if `d` is NaN.
pub fn cmp_i64_f64(i : Int64, d : Double) -> Option[Int] {
  if is_nan_f64(d) {
    return None
  }
  if d < CEL_NEG_TWO_63_F {
    return Some(1)
  }
  if d >= CEL_TWO_63_F {
    return Some(-1)
  }
  // d is strictly in [-2^63, 2^63). Truncating to Int64 is exact for the integer part.
  let di = d.to_int64()
  let df = di.to_double()
  if df == d {
    if i < di {
      Some(-1)
    } else if i > di {
      Some(1)
    } else {
      Some(0)
    }
  } else if d > df {
    // d = di + frac (0 < frac < 1), so i <= di => i < d; i > di => i > d
    if i <= di {
      Some(-1)
    } else {
      Some(1)
    }
  } else {
    // d = di - frac (0 < frac < 1), so i < di => i < d; i >= di => i > d
    if i < di {
      Some(-1)
    } else {
      Some(1)
    }
  }
}

///| Exact comparison between UInt64 and Double. Returns `None` if `d` is NaN.
pub fn cmp_u64_f64(u : UInt64, d : Double) -> Option[Int] {
  if is_nan_f64(d) {
    return None
  }
  if d < 0.0 {
    return Some(1)
  }
  if d >= CEL_TWO_64_F {
    return Some(-1)
  }
  if d < CEL_TWO_63_F {
    let di = d.to_int64()
    let df = di.to_double()
    let du = di.reinterpret_as_uint64()
    if df == d {
      if u < du {
        Some(-1)
      } else if u > du {
        Some(1)
      } else {
        Some(0)
      }
    } else {
      // d >= 0 and d > df, so u <= du => u < d
      if u <= du {
        Some(-1)
      } else {
        Some(1)
      }
    }
  } else {
    // d is in [2^63, 2^64). All doubles >= 2^53 are exact integers.
    let shifted = (d - CEL_TWO_63_F).to_int64().reinterpret_as_uint64() + CEL_TWO_63_U
    if u < shifted {
      Some(-1)
    } else if u > shifted {
      Some(1)
    } else {
      Some(0)
    }
  }
}

///| Exact comparison between two Doubles. Returns `None` if either is NaN.
pub fn cmp_f64_f64(a : Double, b : Double) -> Option[Int] {
  if is_nan_f64(a) || is_nan_f64(b) {
    return None
  }
  if a < b {
    Some(-1)
  } else if a > b {
    Some(1)
  } else {
    Some(0)
  }
}

///| Convert an `Array[Byte]` into `Bytes`.
pub fn bytes_from_array(arr : Array[Byte]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i]
    i = i + 1
  }
  out
}

///| Convert a Pion `String` into raw UTF-8 `Bytes`.
pub fn string_to_bytes(s : String) -> Bytes {
  let n = s.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  out
}

///| Validate UTF-8 bytes and decode to a Pion `String`.
pub fn utf8_bytes_to_string(bs : Bytes) -> Option[String] {
  let n = bs.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(bs[i])
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 {
      if i + 1 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      if cp < 0x80 {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 {
      if i + 2 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      sb.write_byte(bs[i + 2])
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 {
      if i + 3 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      let b3 = bs[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      if cp < 0x10000 || cp > 0x10FFFF {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      sb.write_byte(bs[i + 2])
      sb.write_byte(bs[i + 3])
      i = i + 4
    } else {
      return None
    }
  }
  Some(sb.to_string())
}

///| Count Unicode scalar values (UTF-8 codepoints) in a String.
pub fn utf8_codepoint_len(s : String) -> Int {
  let n = s.length()
  let mut count = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///| Parse a decimal signed Int64 string (exact bounds).
pub fn parse_i64_str(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc : UInt64 = 0UL
  let limit : UInt64 = if neg { CEL_TWO_63_U } else { 9223372036854775807UL }
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = int_to_u64(b - 48)
    if acc > (limit - d) / 10UL {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if neg {
    if acc == CEL_TWO_63_U {
      Some(CEL_I64_MIN)
    } else {
      Some(0L - acc.reinterpret_as_int64())
    }
  } else {
    Some(acc.reinterpret_as_int64())
  }
}

///| Parse a decimal unsigned UInt64 string.
pub fn parse_u64_str(s : String) -> Option[UInt64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut acc : UInt64 = 0UL
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = int_to_u64(b - 48)
    if acc > (CEL_U64_MAX - d) / 10UL {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  Some(acc)
}

///| Parse a Double from string, supporting `nan`, `inf`, `-inf`, `+inf`, and scientific notation.
pub fn parse_double_str(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  if s == "nan" || s == "NaN" || s == "NAN" {
    return Some(0.0 / 0.0)
  }
  if s == "inf" || s == "+inf" || s == "Inf" || s == "+Inf" || s == "Infinity" || s == "+Infinity" {
    return Some(1.0 / 0.0)
  }
  if s == "-inf" || s == "-Inf" || s == "-Infinity" {
    return Some(-1.0 / 0.0)
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if s.code_unit_at(i) == 43 {
    i = i + 1
  }
  let mut int_part : Double = 0.0
  let mut has_digits = false
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      has_digits = true
      int_part = int_part * 10.0 + (b - 48).to_double()
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_part : Double = 0.0
  let mut frac_div : Double = 1.0
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    while i < n {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        has_digits = true
        frac_part = frac_part * 10.0 + (b - 48).to_double()
        frac_div = frac_div * 10.0
        i = i + 1
      } else {
        break
      }
    }
  }
  if !has_digits {
    return None
  }
  let mut result = int_part + frac_part / frac_div
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let exp_start = i
    let mut exp_val = 0
    while i < n {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        if exp_val < 10000 {
          exp_val = exp_val * 10 + (b - 48)
        }
        i = i + 1
      } else {
        break
      }
    }
    if i == exp_start {
      return None
    }
    let mut p : Double = 1.0
    let mut base : Double = 10.0
    let mut e = exp_val
    while e > 0 {
      if (e & 1) != 0 {
        p = p * base
      }
      base = base * base
      e = e >> 1
    }
    if exp_neg {
      result = result / p
    } else {
      result = result * p
    }
  }
  if i != n {
    return None
  }
  Some(if neg { 0.0 - result } else { result })
}

///| Parse a CEL / Go `time.ParseDuration` string (e.g. `"1h30m45s"`, `"-500ms"`, `"1.5s"`).
pub fn parse_cel_duration(s : String, pos : Int) -> Result[time::SignedDuration, CelError] {
  let bs = string_to_bytes(s)
  let n = bs.length()
  if n == 0 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "empty duration string", pos))
  }
  let mut i = 0
  let mut neg = false
  if bs[i].to_int() == 45 {
    neg = true
    i = i + 1
  } else if bs[i].to_int() == 43 {
    i = i + 1
  }
  if i == n {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid duration: " + s, pos))
  }
  if i + 1 == n && bs[i].to_int() == 48 {
    return Ok(time::SignedDuration::from_secs(0L))
  }

  let mut total_secs : Int64 = 0L
  let mut total_nanos : Int64 = 0L

  while i < n {
    // Parse integer and optional fractional part
    let mut int_v : Int64 = 0L
    let mut has_int = false
    while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
      has_int = true
      let d = (bs[i].to_int() - 48).to_int64()
      if int_v > (CEL_I64_MAX - d) / 10L {
        return Err(CelError::new(CelErrorKind::Overflow, "duration overflow", pos))
      }
      int_v = int_v * 10L + d
      i = i + 1
    }
    let mut frac_v : Int64 = 0L
    let mut frac_scale : Int64 = 1L
    let mut has_frac = false
    if i < n && bs[i].to_int() == 46 {
      i = i + 1
      while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
        has_frac = true
        if frac_scale < 1000000000L {
          frac_v = frac_v * 10L + (bs[i].to_int() - 48).to_int64()
          frac_scale = frac_scale * 10L
        }
        i = i + 1
      }
    }
    if !has_int && !has_frac {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid duration number: " + s, pos))
    }

    // Parse unit: ns, us, µs (C2 B5 73), μs (CE BC 73), ms, s, m, h
    if i >= n {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "missing duration unit: " + s, pos))
    }
    let u0 = bs[i].to_int()
    let mut unit_nanos : Int64 = 0L
    let mut unit_secs : Int64 = 0L
    if u0 == 104 {
      // h
      unit_secs = 3600L
      i = i + 1
    } else if u0 == 109 {
      if i + 1 < n && bs[i + 1].to_int() == 115 {
        // ms
        unit_nanos = 1000000L
        i = i + 2
      } else {
        // m
        unit_secs = 60L
        i = i + 1
      }
    } else if u0 == 115 {
      // s
      unit_secs = 1L
      i = i + 1
    } else if u0 == 110 && i + 1 < n && bs[i + 1].to_int() == 115 {
      // ns
      unit_nanos = 1L
      i = i + 2
    } else if u0 == 117 && i + 1 < n && bs[i + 1].to_int() == 115 {
      // us
      unit_nanos = 1000L
      i = i + 2
    } else if (u0 == 0xC2 || u0 == 0xCE) && i + 2 < n && bs[i + 2].to_int() == 115 {
      // µs or μs
      unit_nanos = 1000L
      i = i + 3
    } else {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "unknown duration unit in: " + s, pos))
    }

    if unit_secs > 0L {
      let add_s = match checked_mul_i64(int_v, unit_secs, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      total_secs = match checked_add_i64(total_secs, add_s, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if frac_v > 0L {
        // frac_v / frac_scale * unit_secs seconds -> nanos
        let frac_ns = (frac_v * (1000000000L / frac_scale)) * unit_secs
        total_secs = total_secs + frac_ns / 1000000000L
        total_nanos = total_nanos + frac_ns % 1000000000L
      }
    } else {
      // sub-second unit
      let ns_from_int = match checked_mul_i64(int_v, unit_nanos, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      total_secs = total_secs + ns_from_int / 1000000000L
      total_nanos = total_nanos + ns_from_int % 1000000000L
      if frac_v > 0L {
        let frac_ns = (frac_v * unit_nanos) / frac_scale
        total_nanos = total_nanos + frac_ns
      }
    }
    if total_nanos >= 1000000000L {
      total_secs = total_secs + total_nanos / 1000000000L
      total_nanos = total_nanos % 1000000000L
    }
  }

  let mut final_secs = total_secs
  let mut final_nanos = total_nanos.to_int()
  if neg {
    final_secs = 0L - final_secs
    final_nanos = 0 - final_nanos
  }
  match time::SignedDuration::new(final_secs, final_nanos) {
    Ok(d) => Ok(d)
    Err(_) => Err(CelError::new(CelErrorKind::Overflow, "duration out of range", pos))
  }
}

///| Format a CEL `SignedDuration` to canonical string (e.g., `"90s"`, `"1.5s"`).
pub fn format_cel_duration(d : time::SignedDuration) -> String {
  let sb = StringBuilder::new()
  let mut secs = d.as_secs()
  let mut nanos = d.subsec_nanos()
  if secs < 0L || nanos < 0 {
    sb.write_string("-")
    secs = 0L - secs
    nanos = 0 - nanos
  }
  sb.write_string(secs.to_string())
  if nanos > 0 {
    sb.write_string(".")
    // Write 9-digit zero-padded nanos, trimming trailing zeros
    let mut digits : Array[Int] = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    let mut v = nanos
    let mut k = 8
    while k >= 0 {
      digits[k] = v % 10
      v = v / 10
      k = k - 1
    }
    let mut end = 8
    while end > 0 && digits[end] == 0 {
      end = end - 1
    }
    let mut j = 0
    while j <= end {
      sb.write_byte((48 + digits[j]).to_byte())
      j = j + 1
    }
  }
  sb.write_string("s")
  sb.to_string()
}

///| Parse a CEL timezone string (`"UTC"`, `"Z"`, `"+09:00"`, `"-05:30"`, `"+09"`) to `time::Offset`.
pub fn parse_cel_tz_offset(tz : String, pos : Int) -> Result[time::Offset, CelError] {
  if tz == "UTC" || tz == "Z" || tz == "GMT" || tz == "+00:00" || tz == "-00:00" {
    return Ok(time::Offset::utc())
  }
  let bs = string_to_bytes(tz)
  let n = bs.length()
  if n < 3 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  let sign = if bs[0].to_int() == 43 {
    1
  } else if bs[0].to_int() == 45 {
    -1
  } else {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "unsupported timezone: " + tz, pos))
  }
  let h1 = bs[1].to_int() - 48
  let h2 = bs[2].to_int() - 48
  if h1 < 0 || h1 > 9 || h2 < 0 || h2 > 9 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone hours: " + tz, pos))
  }
  let hours = h1 * 10 + h2
  let mut mins = 0
  if n == 6 && bs[3].to_int() == 58 {
    let m1 = bs[4].to_int() - 48
    let m2 = bs[5].to_int() - 48
    if m1 < 0 || m1 > 9 || m2 < 0 || m2 > 9 {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone minutes: " + tz, pos))
    }
    mins = m1 * 10 + m2
  } else if n != 3 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone format: " + tz, pos))
  }
  if hours > 23 || mins > 59 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "timezone offset out of range: " + tz, pos))
  }
  match time::Offset::from_seconds(sign * (hours * 3600 + mins * 60)) {
    Ok(o) => Ok(o)
    Err(_) => Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone offset: " + tz, pos))
  }
}

///| Compute 0-based day of year (0..365) from a `time::Date`.
pub fn date_day_of_year_zero(d : time::Date) -> Int {
  let mut total = 0
  let mut m = 1
  while m < d.month {
    total = total + time::days_in_month_of(d.year, m)
    m = m + 1
  }
  total + d.day - 1
}

///| Compute 0-based day of week (Sunday=0 .. Saturday=6) from a `time::Date`.
pub fn date_day_of_week_sun0(d : time::Date) -> Int {
  // Sakamoto's algorithm (1970-01-01 was Thursday = 4)
  let t : Array[Int] = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  let mut y = d.year
  if d.month < 3 {
    y = y - 1
  }
  let mut r = (y + y / 4 - y / 100 + y / 400 + t[d.month - 1] + d.day) % 7
  if r < 0 {
    r = r + 7
  }
  r
}
