///| Exact heterogeneous numeric comparisons, checked int64/uint64 arithmetic,
///| UTF-8 utilities, float/int/duration parsing, and timestamp accessors.

import "time"

let CEL_I64_MAX : Int64 = 9223372036854775807L

let CEL_I64_MIN : Int64 = -9223372036854775807L - 1L

let CEL_U64_MAX : UInt64 = 18446744073709551615UL

let CEL_TWO_63_U : UInt64 = 9223372036854775808UL

let CEL_TWO_63_F : Double = 9223372036854775808.0

let CEL_NEG_TWO_63_F : Double = -9223372036854775808.0

let CEL_TWO_64_F : Double = 18446744073709551616.0

///| Convert non-negative Int to UInt64.
#verify
pub fn int_to_u64(n : Int) -> UInt64 {
  n.to_int64().reinterpret_as_uint64()
}

///| Convert UInt64 to Double accurately.
pub fn u64_to_double(u : UInt64) -> Double {
  if u < CEL_TWO_63_U {
    u.reinterpret_as_int64().to_double()
  } else {
    (u - CEL_TWO_63_U).reinterpret_as_int64().to_double() + CEL_TWO_63_F
  }
}

///| Check whether a Double is NaN.
pub fn is_nan_f64(d : Double) -> Bool {
  d != d
}

///| Check whether a Double is +/- Infinity.
pub fn is_inf_f64(d : Double) -> Bool {
  d == 1.0 / 0.0 || d == -1.0 / 0.0
}

///| Return true iff negating `a` overflows signed 64-bit range.
pub fn i64_neg_overflows(a : Int64) -> Bool {
  a == -9223372036854775807L - 1L
}

///| Checked Int64 negation.
pub fn checked_neg_i64(a : Int64, pos : Int) -> Result[Int64, CelError] {
  if i64_neg_overflows(a) {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 negation overflow", pos))
  }
  Ok(0L - a)
}

///| Return true iff `a + b` overflows or underflows signed 64-bit range.
#verify
pub fn i64_add_overflows(a : Int64, b : Int64) -> Bool {
  (b > 0L && a > 9223372036854775807L - b) || (b < 0L && a < -9223372036854775807L - 1L - b)
}

///| Checked Int64 addition.
pub fn checked_add_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if i64_add_overflows(a, b) {
    if b > 0L {
      return Err(CelError::new(CelErrorKind::Overflow, "int64 addition overflow", pos))
    }
    return Err(CelError::new(CelErrorKind::Overflow, "int64 addition underflow", pos))
  }
  Ok(a + b)
}

///| Return true iff `a - b` overflows or underflows signed 64-bit range.
#verify
pub fn i64_sub_overflows(a : Int64, b : Int64) -> Bool {
  (b < 0L && a > 9223372036854775807L + b) || (b > 0L && a < -9223372036854775807L - 1L + b)
}

///| Checked Int64 subtraction.
pub fn checked_sub_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if i64_sub_overflows(a, b) {
    if b < 0L {
      return Err(CelError::new(CelErrorKind::Overflow, "int64 subtraction overflow", pos))
    }
    return Err(CelError::new(CelErrorKind::Overflow, "int64 subtraction underflow", pos))
  }
  Ok(a - b)
}

///| Checked Int64 multiplication.
pub fn checked_mul_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  if a == 0L || b == 0L {
    return Ok(0L)
  }
  if (a == CEL_I64_MIN && b == -1L) || (b == CEL_I64_MIN && a == -1L) {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 multiplication overflow", pos))
  }
  let res = a * b
  if res / b != a {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 multiplication overflow", pos))
  }
  Ok(res)
}

///| Classify Int64 division/modulo error: 0 = ok, 1 = division by zero, 2 = INT64_MIN / -1 overflow.
pub fn i64_div_err_code(a : Int64, b : Int64) -> Int {
  if b == 0L {
    1
  } else if a == -9223372036854775807L - 1L && b == -1L {
    2
  } else {
    0
  }
}

///| Checked Int64 division (truncates toward zero).
pub fn checked_div_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  let err = i64_div_err_code(a, b)
  if err == 1 {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "division by zero", pos))
  }
  if err == 2 {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 division overflow", pos))
  }
  Ok(a / b)
}

///| Checked Int64 modulo.
pub fn checked_mod_i64(a : Int64, b : Int64, pos : Int) -> Result[Int64, CelError] {
  let err = i64_div_err_code(a, b)
  if err == 1 {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "modulo by zero", pos))
  }
  if err == 2 {
    return Err(CelError::new(CelErrorKind::Overflow, "int64 modulo overflow", pos))
  }
  Ok(a % b)
}

///| Return true iff `a + b` overflows unsigned 64-bit range.
#verify
pub fn u64_add_overflows(a : UInt64, b : UInt64) -> Bool {
  a > 18446744073709551615UL - b
}

///| Checked UInt64 addition.
pub fn checked_add_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if u64_add_overflows(a, b) {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 addition overflow", pos))
  }
  Ok(a + b)
}

///| Return true iff `a - b` underflows unsigned 64-bit range.
pub fn u64_sub_underflows(a : UInt64, b : UInt64) -> Bool {
  a < b
}

///| Checked UInt64 subtraction.
pub fn checked_sub_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if u64_sub_underflows(a, b) {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 subtraction underflow", pos))
  }
  Ok(a - b)
}

///| Return true iff `a * b` overflows unsigned 64-bit range.
#verify
pub fn u64_mul_overflows(a : UInt64, b : UInt64) -> Bool {
  a != 0UL && b != 0UL && a > 18446744073709551615UL / b
}

///| Checked UInt64 multiplication.
pub fn checked_mul_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if a == 0UL || b == 0UL {
    return Ok(0UL)
  }
  if u64_mul_overflows(a, b) {
    return Err(CelError::new(CelErrorKind::Overflow, "uint64 multiplication overflow", pos))
  }
  Ok(a * b)
}

///| Checked UInt64 division.
pub fn checked_div_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if b == 0UL {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "division by zero", pos))
  }
  Ok(a / b)
}

///| Checked UInt64 modulo.
pub fn checked_mod_u64(a : UInt64, b : UInt64, pos : Int) -> Result[UInt64, CelError] {
  if b == 0UL {
    return Err(CelError::new(CelErrorKind::DivisionByZero, "modulo by zero", pos))
  }
  Ok(a % b)
}

///| Exact comparison between Int64 and UInt64 (-1, 0, +1).
#verify
pub fn cmp_i64_u64(i : Int64, u : UInt64) -> Int {
  if i < 0L {
    return -1
  }
  let iu = i.reinterpret_as_uint64()
  if iu < u {
    -1
  } else if iu > u {
    1
  } else {
    0
  }
}

///| Exact comparison between Int64 and Double. Returns `None` if `d` is NaN.
pub fn cmp_i64_f64(i : Int64, d : Double) -> Option[Int] {
  if is_nan_f64(d) {
    return None
  }
  if d < CEL_NEG_TWO_63_F {
    return Some(1)
  }
  if d >= CEL_TWO_63_F {
    return Some(-1)
  }
  // d is strictly in [-2^63, 2^63). Truncating to Int64 is exact for the integer part.
  let di = d.to_int64()
  let df = di.to_double()
  if df == d {
    if i < di {
      Some(-1)
    } else if i > di {
      Some(1)
    } else {
      Some(0)
    }
  } else if d > df {
    // d = di + frac (0 < frac < 1), so i <= di => i < d; i > di => i > d
    if i <= di {
      Some(-1)
    } else {
      Some(1)
    }
  } else {
    // d = di - frac (0 < frac < 1), so i < di => i < d; i >= di => i > d
    if i < di {
      Some(-1)
    } else {
      Some(1)
    }
  }
}

///| Exact comparison between UInt64 and Double. Returns `None` if `d` is NaN.
pub fn cmp_u64_f64(u : UInt64, d : Double) -> Option[Int] {
  if is_nan_f64(d) {
    return None
  }
  if d < 0.0 {
    return Some(1)
  }
  if d >= CEL_TWO_64_F {
    return Some(-1)
  }
  if d < CEL_TWO_63_F {
    let di = d.to_int64()
    let df = di.to_double()
    let du = di.reinterpret_as_uint64()
    if df == d {
      if u < du {
        Some(-1)
      } else if u > du {
        Some(1)
      } else {
        Some(0)
      }
    } else {
      // d >= 0 and d > df, so u <= du => u < d
      if u <= du {
        Some(-1)
      } else {
        Some(1)
      }
    }
  } else {
    // d is in [2^63, 2^64). All doubles >= 2^53 are exact integers.
    let shifted = (d - CEL_TWO_63_F).to_int64().reinterpret_as_uint64() + CEL_TWO_63_U
    if u < shifted {
      Some(-1)
    } else if u > shifted {
      Some(1)
    } else {
      Some(0)
    }
  }
}

///| Exact comparison between two Doubles. Returns `None` if either is NaN.
pub fn cmp_f64_f64(a : Double, b : Double) -> Option[Int] {
  if is_nan_f64(a) || is_nan_f64(b) {
    return None
  }
  if a < b {
    Some(-1)
  } else if a > b {
    Some(1)
  } else {
    Some(0)
  }
}

///| Convert an `Array[Byte]` into `Bytes`.
pub fn bytes_from_array(arr : Array[Byte]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i]
    i = i + 1
  }
  out
}

///| Convert a Pion `String` into raw UTF-8 `Bytes`.
pub fn string_to_bytes(s : String) -> Bytes {
  let n = s.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  out
}

///| Validate UTF-8 bytes and decode to a Pion `String`.
pub fn utf8_bytes_to_string(bs : Bytes) -> Option[String] {
  let n = bs.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(bs[i])
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 {
      if i + 1 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      if cp < 0x80 {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 {
      if i + 2 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      sb.write_byte(bs[i + 2])
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 {
      if i + 3 >= n {
        return None
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      let b3 = bs[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      if cp < 0x10000 || cp > 0x10FFFF {
        return None
      }
      sb.write_byte(bs[i])
      sb.write_byte(bs[i + 1])
      sb.write_byte(bs[i + 2])
      sb.write_byte(bs[i + 3])
      i = i + 4
    } else {
      return None
    }
  }
  Some(sb.to_string())
}

///| Count Unicode scalar values (UTF-8 codepoints) in a String.
pub fn utf8_codepoint_len(s : String) -> Int {
  let n = s.length()
  let mut count = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///| Parse a decimal signed Int64 string (exact bounds).
pub fn parse_i64_str(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc : UInt64 = 0UL
  let limit : UInt64 = if neg { CEL_TWO_63_U } else { 9223372036854775807UL }
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = int_to_u64(b - 48)
    if acc > (limit - d) / 10UL {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if neg {
    if acc == CEL_TWO_63_U {
      Some(CEL_I64_MIN)
    } else {
      Some(0L - acc.reinterpret_as_int64())
    }
  } else {
    Some(acc.reinterpret_as_int64())
  }
}

///| Parse a decimal unsigned UInt64 string.
pub fn parse_u64_str(s : String) -> Option[UInt64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut acc : UInt64 = 0UL
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = int_to_u64(b - 48)
    if acc > (CEL_U64_MAX - d) / 10UL {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  Some(acc)
}

///| Parse a Double from string using exact IEEE-754 rounding (`double(string)` semantics).
pub fn parse_double_str(s : String) -> Option[Double] {
  parse_cel_double_conv(s)
}

let CEL_TS_MIN_SECS : Int64 = -62135596800L

let CEL_TS_MAX_SECS : Int64 = 253402300799L

let CEL_DUR_MAX_U64 : UInt64 = 9223372036854775807UL

let CEL_DUR_MIN_ABS_U64 : UInt64 = 9223372036854775808UL

///| Convert a `SignedDuration` to `Int64` total nanoseconds if within CEL/cel-go range.
pub fn duration_to_i64_nanos(d : time::SignedDuration) -> Option[Int64] {
  let s = d.secs
  let ns = d.nanos.to_int64()
  // Check s * 1_000_000_000 + ns in [INT64_MIN, INT64_MAX]
  if s > 9223372036L || s < -9223372036L {
    return None
  }
  let base = s * 1000000000L
  if ns > 0L && base > CEL_I64_MAX - ns {
    return None
  }
  if ns < 0L && base < CEL_I64_MIN - ns {
    return None
  }
  Some(base + ns)
}

///| Construct a `SignedDuration` from `Int64` total nanoseconds.
pub fn duration_from_i64_nanos(ns : Int64) -> time::SignedDuration {
  let secs = ns / 1000000000L
  let rem = (ns % 1000000000L).to_int()
  time::SignedDuration::{ secs: secs, nanos: rem }
}

///| Checked CEL duration addition (enforcing int64 nanosecond bounds).
pub fn checked_add_cel_duration(
  a : time::SignedDuration,
  b : time::SignedDuration,
  pos : Int,
) -> Result[time::SignedDuration, CelError] {
  let na = match duration_to_i64_nanos(a) {
    Some(v) => v
    None => return Err(CelError::new(CelErrorKind::Overflow, "duration overflow", pos))
  }
  let nb = match duration_to_i64_nanos(b) {
    Some(v) => v
    None => return Err(CelError::new(CelErrorKind::Overflow, "duration overflow", pos))
  }
  match checked_add_i64(na, nb, pos) {
    Ok(sum) => Ok(duration_from_i64_nanos(sum))
    Err(e) => Err(e)
  }
}

///| Checked CEL duration subtraction (enforcing int64 nanosecond bounds).
pub fn checked_sub_cel_duration(
  a : time::SignedDuration,
  b : time::SignedDuration,
  pos : Int,
) -> Result[time::SignedDuration, CelError] {
  let na = match duration_to_i64_nanos(a) {
    Some(v) => v
    None => return Err(CelError::new(CelErrorKind::Overflow, "duration overflow", pos))
  }
  let nb = match duration_to_i64_nanos(b) {
    Some(v) => v
    None => return Err(CelError::new(CelErrorKind::Overflow, "duration overflow", pos))
  }
  match checked_sub_i64(na, nb, pos) {
    Ok(diff) => Ok(duration_from_i64_nanos(diff))
    Err(e) => Err(e)
  }
}

///| Checked CEL `timestamp + duration` (enforcing `0001-01-01..9999-12-31T23:59:59.999999999Z`).
pub fn checked_ts_add_dur(
  ts : time::Timestamp,
  dur : time::SignedDuration,
  pos : Int,
) -> Result[time::Timestamp, CelError] {
  let mut n = ts.nanos + dur.nanos
  let mut carry : Int64 = 0L
  if n >= 1000000000 {
    n = n - 1000000000
    carry = 1L
  } else if n < 0 {
    n = n + 1000000000
    carry = -1L
  }
  let s1 = match checked_add_i64(ts.secs, dur.secs, pos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let s2 = match checked_add_i64(s1, carry, pos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if s2 < CEL_TS_MIN_SECS || s2 > CEL_TS_MAX_SECS {
    return Err(CelError::new(CelErrorKind::Overflow, "timestamp out of CEL range", pos))
  }
  Ok(time::Timestamp::{ secs: s2, nanos: n })
}

///| Checked CEL `timestamp - duration`.
pub fn checked_ts_sub_dur(
  ts : time::Timestamp,
  dur : time::SignedDuration,
  pos : Int,
) -> Result[time::Timestamp, CelError] {
  let mut n = ts.nanos - dur.nanos
  let mut carry : Int64 = 0L
  if n >= 1000000000 {
    n = n - 1000000000
    carry = 1L
  } else if n < 0 {
    n = n + 1000000000
    carry = -1L
  }
  let s1 = match checked_sub_i64(ts.secs, dur.secs, pos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let s2 = match checked_add_i64(s1, carry, pos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if s2 < CEL_TS_MIN_SECS || s2 > CEL_TS_MAX_SECS {
    return Err(CelError::new(CelErrorKind::Overflow, "timestamp out of CEL range", pos))
  }
  Ok(time::Timestamp::{ secs: s2, nanos: n })
}

///| Checked CEL `timestamp - timestamp` (enforcing int64 nanosecond duration range).
pub fn checked_ts_sub_ts(
  a : time::Timestamp,
  b : time::Timestamp,
  pos : Int,
) -> Result[time::SignedDuration, CelError] {
  let ds = match checked_sub_i64(a.secs, b.secs, pos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dn = (a.nanos - b.nanos).to_int64()
  let mut s = ds
  let mut n = dn
  if s > 0L && n < 0L {
    s = s - 1L
    n = n + 1000000000L
  } else if s < 0L && n > 0L {
    s = s + 1L
    n = n - 1000000000L
  }
  let d = time::SignedDuration::{ secs: s, nanos: n.to_int() }
  match duration_to_i64_nanos(d) {
    Some(_) => Ok(d)
    None => Err(CelError::new(CelErrorKind::Overflow, "timestamp difference overflows duration range", pos))
  }
}

///| Create a CEL `Timestamp` from Unix epoch seconds, checking CEL bounds `[0001-01-01, 9999-12-31T23:59:59Z]`.
pub fn cel_timestamp_from_second(secs : Int64, pos : Int) -> Result[time::Timestamp, CelError] {
  if secs < CEL_TS_MIN_SECS || secs > CEL_TS_MAX_SECS {
    return Err(CelError::new(CelErrorKind::Overflow, "timestamp seconds out of CEL range", pos))
  }
  Ok(time::Timestamp::{ secs: secs, nanos: 0 })
}

fn parse_two_digits(s : String, i : Int) -> Int {
  let d1 = s.code_unit_at(i) - 48
  let d2 = s.code_unit_at(i + 1) - 48
  if d1 < 0 || d1 > 9 || d2 < 0 || d2 > 9 {
    return -1
  }
  d1 * 10 + d2
}

///| Strict RFC 3339 timestamp parser matching Go `time.Parse(time.RFC3339, s)` / `cel-go`:
///| - Uppercase `T` separator and uppercase `Z` or `±HH:MM` offset
///| - Year `0001..=9999`, valid calendar date, `00..=23`, `00..=59`, `00..=59` (no leap second 60)
///| - Fractional seconds require >= 1 digit; > 9 digits are accepted and truncated to nanoseconds
///| - Returns `(Timestamp, ts_offset)` where `ts_offset` is `CEL_TS_OFFSET_UTC` for `Z` or fixed offset seconds.
pub fn parse_cel_rfc3339(s : String, pos : Int) -> Result[(time::Timestamp, Int), CelError] {
  let n = s.length()
  if n < 20 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid RFC 3339 timestamp: " + s, pos))
  }
  // YYYY-MM-DDTHH:MM:SS
  let y1 = s.code_unit_at(0) - 48
  let y2 = s.code_unit_at(1) - 48
  let y3 = s.code_unit_at(2) - 48
  let y4 = s.code_unit_at(3) - 48
  if y1 < 0 || y1 > 9 || y2 < 0 || y2 > 9 || y3 < 0 || y3 > 9 || y4 < 0 || y4 > 9 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid RFC 3339 year: " + s, pos))
  }
  let year = y1 * 1000 + y2 * 100 + y3 * 10 + y4
  if year < 1 || year > 9999 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "timestamp year out of CEL range: " + s, pos))
  }
  if s.code_unit_at(4) != 45 || s.code_unit_at(7) != 45 || s.code_unit_at(10) != 84 || s.code_unit_at(13) != 58 || s.code_unit_at(16) != 58 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid RFC 3339 timestamp: " + s, pos))
  }
  let month = parse_two_digits(s, 5)
  let day = parse_two_digits(s, 8)
  let hour = parse_two_digits(s, 11)
  let minute = parse_two_digits(s, 14)
  let second = parse_two_digits(s, 17)
  if month < 1 || month > 12 || day < 1 || day > time::days_in_month_of(year, month) {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid RFC 3339 date: " + s, pos))
  }
  if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid RFC 3339 time: " + s, pos))
  }
  let mut i = 19
  let mut nanos = 0
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let frac_start = i
    let mut scale = 100000000
    while i < n {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        if scale > 0 {
          nanos = nanos + (b - 48) * scale
          scale = scale / 10
        }
        i = i + 1
      } else {
        break
      }
    }
    if i == frac_start {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "empty fractional seconds in timestamp: " + s, pos))
    }
  }
  if i >= n {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "missing timezone in timestamp: " + s, pos))
  }
  let mut offset_secs = 0
  let mut stored_offset = CEL_TS_OFFSET_UTC
  let tz_b = s.code_unit_at(i)
  if tz_b == 90 {
    // 'Z'
    if i + 1 != n {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "trailing characters in timestamp: " + s, pos))
    }
  } else if tz_b == 43 || tz_b == 45 {
    // ±HH:MM
    if i + 6 != n || s.code_unit_at(i + 3) != 58 {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone offset in timestamp: " + s, pos))
    }
    let oh = parse_two_digits(s, i + 1)
    let om = parse_two_digits(s, i + 4)
    if oh < 0 || oh > 23 || om < 0 || om > 59 {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "timezone offset out of range: " + s, pos))
    }
    let sign = if tz_b == 43 { 1 } else { -1 }
    offset_secs = sign * (oh * 3600 + om * 60)
    stored_offset = offset_secs
  } else {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone in timestamp: " + s, pos))
  }
  let date = match time::Date::new(year, month, day) {
    Ok(d) => d
    Err(_) => return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid date: " + s, pos))
  }
  let secs = date.to_epoch_days().to_int64() * 86400L + (hour * 3600 + minute * 60 + second).to_int64() - offset_secs.to_int64()
  if secs < CEL_TS_MIN_SECS || secs > CEL_TS_MAX_SECS {
    return Err(CelError::new(CelErrorKind::Overflow, "timestamp out of CEL range: " + s, pos))
  }
  Ok((time::Timestamp::{ secs: secs, nanos: nanos }, stored_offset))
}

fn write_2d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + v / 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

fn write_4d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + (v / 1000) % 10).to_byte())
  sb.write_byte((48 + (v / 100) % 10).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///| Format a CEL timestamp to RFC 3339 string, preserving explicit offset if present.
pub fn format_cel_timestamp(ts : time::Timestamp, ts_offset : Int) -> String {
  let use_z = ts_offset == CEL_TS_OFFSET_UTC
  let off = if use_z {
    time::Offset::utc()
  } else {
    match time::Offset::from_seconds(ts_offset) {
      Ok(o) => o
      Err(_) => time::Offset::utc()
    }
  }
  let dt = off.to_datetime(ts)
  let sb = StringBuilder::new()
  write_4d(sb, dt.date.year)
  sb.write_byte((45).to_byte())
  write_2d(sb, dt.date.month)
  sb.write_byte((45).to_byte())
  write_2d(sb, dt.date.day)
  sb.write_byte((84).to_byte())
  write_2d(sb, dt.time.hour)
  sb.write_byte((58).to_byte())
  write_2d(sb, dt.time.minute)
  sb.write_byte((58).to_byte())
  write_2d(sb, dt.time.second)
  if dt.time.nanosecond > 0 {
    sb.write_byte((46).to_byte())
    let digits : Array[Int] = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    let mut v = dt.time.nanosecond
    let mut k = 8
    while k >= 0 {
      digits[k] = v % 10
      v = v / 10
      k = k - 1
    }
    let mut end = 8
    while end > 0 && digits[end] == 0 {
      end = end - 1
    }
    let mut j = 0
    while j <= end {
      sb.write_byte((48 + digits[j]).to_byte())
      j = j + 1
    }
  }
  if use_z {
    sb.write_byte((90).to_byte())
  } else {
    let abs_off = if ts_offset < 0 {
      sb.write_byte((45).to_byte())
      -ts_offset
    } else {
      sb.write_byte((43).to_byte())
      ts_offset
    }
    write_2d(sb, abs_off / 3600)
    sb.write_byte((58).to_byte())
    write_2d(sb, (abs_off % 3600) / 60)
  }
  sb.to_string()
}

///| Parse a CEL / Go `time.ParseDuration` string with strict int64 nanosecond overflow checks.
pub fn parse_cel_duration(s : String, pos : Int) -> Result[time::SignedDuration, CelError] {
  let bs = string_to_bytes(s)
  let n = bs.length()
  if n == 0 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "empty duration string", pos))
  }
  let mut i = 0
  let mut neg = false
  if bs[i].to_int() == 45 {
    neg = true
    i = i + 1
  } else if bs[i].to_int() == 43 {
    i = i + 1
  }
  if i == n {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid duration: " + s, pos))
  }
  if i + 1 == n && bs[i].to_int() == 48 {
    return Ok(time::SignedDuration::from_secs(0L))
  }

  let max_ns : UInt64 = if neg { CEL_DUR_MIN_ABS_U64 } else { CEL_DUR_MAX_U64 }
  let mut total_ns : UInt64 = 0UL

  while i < n {
    let mut int_v : UInt64 = 0UL
    let mut has_int = false
    while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
      has_int = true
      let d = int_to_u64(bs[i].to_int() - 48)
      if int_v > (max_ns - d) / 10UL {
        return Err(CelError::new(CelErrorKind::Overflow, "duration overflow: " + s, pos))
      }
      int_v = int_v * 10UL + d
      i = i + 1
    }
    let mut frac_v : UInt64 = 0UL
    let mut frac_scale : UInt64 = 1UL
    let mut has_frac = false
    if i < n && bs[i].to_int() == 46 {
      i = i + 1
      while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
        has_frac = true
        if frac_scale < 1000000000000UL {
          frac_v = frac_v * 10UL + int_to_u64(bs[i].to_int() - 48)
          frac_scale = frac_scale * 10UL
        }
        i = i + 1
      }
    }
    if !has_int && !has_frac {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid duration number: " + s, pos))
    }

    if i >= n {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "missing duration unit: " + s, pos))
    }
    let u0 = bs[i].to_int()
    let mut unit_ns : UInt64 = 0UL
    if u0 == 104 {
      unit_ns = 3600000000000UL
      i = i + 1
    } else if u0 == 109 {
      if i + 1 < n && bs[i + 1].to_int() == 115 {
        unit_ns = 1000000UL
        i = i + 2
      } else {
        unit_ns = 60000000000UL
        i = i + 1
      }
    } else if u0 == 115 {
      unit_ns = 1000000000UL
      i = i + 1
    } else if u0 == 110 && i + 1 < n && bs[i + 1].to_int() == 115 {
      unit_ns = 1UL
      i = i + 2
    } else if u0 == 117 && i + 1 < n && bs[i + 1].to_int() == 115 {
      unit_ns = 1000UL
      i = i + 2
    } else if (u0 == 0xC2 && i + 2 < n && bs[i + 1].to_int() == 0xB5 && bs[i + 2].to_int() == 115) ||
    (u0 == 0xCE && i + 2 < n && bs[i + 1].to_int() == 0xBC && bs[i + 2].to_int() == 115) {
      unit_ns = 1000UL
      i = i + 3
    } else {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "unknown duration unit in: " + s, pos))
    }

    if int_v > max_ns / unit_ns {
      return Err(CelError::new(CelErrorKind::Overflow, "duration overflow: " + s, pos))
    }
    let add_int = int_v * unit_ns
    if total_ns > max_ns - add_int {
      return Err(CelError::new(CelErrorKind::Overflow, "duration overflow: " + s, pos))
    }
    total_ns = total_ns + add_int

    if frac_v > 0UL {
      // Exact floor(frac_v * unit_ns / frac_scale) without u64 overflow:
      // split frac_v / frac_scale using 128-bit or reducing by common factor
      let add_frac = if frac_scale <= unit_ns {
        frac_v * (unit_ns / frac_scale)
      } else {
        frac_v / (frac_scale / unit_ns)
      }
      if total_ns > max_ns - add_frac {
        return Err(CelError::new(CelErrorKind::Overflow, "duration overflow: " + s, pos))
      }
      total_ns = total_ns + add_frac
    }
  }

  let signed_ns : Int64 = if neg {
    if total_ns == CEL_DUR_MIN_ABS_U64 {
      CEL_I64_MIN
    } else {
      0L - total_ns.reinterpret_as_int64()
    }
  } else {
    total_ns.reinterpret_as_int64()
  }
  Ok(duration_from_i64_nanos(signed_ns))
}

///| Format a CEL `SignedDuration` to canonical string (e.g., `"90s"`, `"1.5s"`).
pub fn format_cel_duration(d : time::SignedDuration) -> String {
  let sb = StringBuilder::new()
  let mut secs = d.as_secs()
  let mut nanos = d.subsec_nanos()
  if secs < 0L || nanos < 0 {
    sb.write_string("-")
    secs = 0L - secs
    nanos = 0 - nanos
  }
  sb.write_string(secs.to_string())
  if nanos > 0 {
    sb.write_string(".")
    // Write 9-digit zero-padded nanos, trimming trailing zeros
    let mut digits : Array[Int] = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    let mut v = nanos
    let mut k = 8
    while k >= 0 {
      digits[k] = v % 10
      v = v / 10
      k = k - 1
    }
    let mut end = 8
    while end > 0 && digits[end] == 0 {
      end = end - 1
    }
    let mut j = 0
    while j <= end {
      sb.write_byte((48 + digits[j]).to_byte())
      j = j + 1
    }
  }
  sb.write_string("s")
  sb.to_string()
}

///| Parse a CEL timezone string (`"UTC"`, `"Z"`, `"+09:00"`, `"-05:30"`, `"+09"`) to `time::Offset`.
pub fn parse_cel_tz_offset(tz : String, pos : Int) -> Result[time::Offset, CelError] {
  if tz == "UTC" || tz == "Z" || tz == "GMT" || tz == "+00:00" || tz == "-00:00" {
    return Ok(time::Offset::utc())
  }
  let bs = string_to_bytes(tz)
  let n = bs.length()
  if n < 3 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone: " + tz, pos))
  }
  let sign = if bs[0].to_int() == 43 {
    1
  } else if bs[0].to_int() == 45 {
    -1
  } else {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "unsupported timezone: " + tz, pos))
  }
  let h1 = bs[1].to_int() - 48
  let h2 = bs[2].to_int() - 48
  if h1 < 0 || h1 > 9 || h2 < 0 || h2 > 9 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone hours: " + tz, pos))
  }
  let hours = h1 * 10 + h2
  let mut mins = 0
  if n == 6 && bs[3].to_int() == 58 {
    let m1 = bs[4].to_int() - 48
    let m2 = bs[5].to_int() - 48
    if m1 < 0 || m1 > 9 || m2 < 0 || m2 > 9 {
      return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone minutes: " + tz, pos))
    }
    mins = m1 * 10 + m2
  } else if n != 3 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone format: " + tz, pos))
  }
  if hours > 23 || mins > 59 {
    return Err(CelError::new(CelErrorKind::InvalidArgument, "timezone offset out of range: " + tz, pos))
  }
  match time::Offset::from_seconds(sign * (hours * 3600 + mins * 60)) {
    Ok(o) => Ok(o)
    Err(_) => Err(CelError::new(CelErrorKind::InvalidArgument, "invalid timezone offset: " + tz, pos))
  }
}

///| Compute 0-based day of year (0..365) from a `time::Date`.
pub fn date_day_of_year_zero(d : time::Date) -> Int {
  let mut total = 0
  let mut m = 1
  while m < d.month {
    total = total + time::days_in_month_of(d.year, m)
    m = m + 1
  }
  total + d.day - 1
}

///| Compute 0-based day of week (Sunday=0 .. Saturday=6) from a `time::Date`.
pub fn date_day_of_week_sun0(d : time::Date) -> Int {
  // Sakamoto's algorithm (1970-01-01 was Thursday = 4)
  let t : Array[Int] = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  let mut y = d.year
  if d.month < 3 {
    y = y - 1
  }
  let mut r = (y + y / 4 - y / 100 + y / 400 + t[d.month - 1] + d.day) % 7
  if r < 0 {
    r = r + 7
  }
  r
}
