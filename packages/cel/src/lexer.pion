///| CEL Lexer supporting all cel-spec literals, raw/triple/bytes strings,
///| escape sequences, comments, operators, and punctuation.

///| Token kinds produced by the CEL lexer.
pub enum TokenKind {
  Eof
  Ident(String)
  IntLit(UInt64)
  UIntLit(UInt64)
  DoubleLit(Double)
  StringLit(String)
  BytesLit(Bytes)
  TrueLit
  FalseLit
  NullLit
  KwIn
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  Dot
  Comma
  Colon
  Question
  Plus
  Minus
  Star
  Slash
  Percent
  Bang
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  AndAnd
  OrOr
}

///| Token with kind and byte offset in source.
pub struct Token {
  pub kind : TokenKind
  pub pos : Int
}

fn is_cel_reserved_word(ident : String) -> Bool {
  ident == "as" ||
  ident == "break" ||
  ident == "const" ||
  ident == "continue" ||
  ident == "else" ||
  ident == "for" ||
  ident == "function" ||
  ident == "if" ||
  ident == "import" ||
  ident == "let" ||
  ident == "loop" ||
  ident == "package" ||
  ident == "namespace" ||
  ident == "return" ||
  ident == "var" ||
  ident == "void" ||
  ident == "while"
}

fn is_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn is_ident_cont(b : Int) -> Bool {
  is_ident_start(b) || (b >= 48 && b <= 57)
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn push_utf8_codepoint(out : Array[Byte], cp : Int) -> Unit {
  if cp <= 0x7F {
    out.push(cp.to_byte())
  } else if cp <= 0x7FF {
    out.push((0xC0 | (cp >> 6)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    out.push((0xE0 | (cp >> 12)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else {
    out.push((0xF0 | (cp >> 18)).to_byte())
    out.push((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn bytes_to_utf8_string(arr : Array[Byte], pos : Int) -> Result[String, CelError] {
  let bs = bytes_from_array(arr)
  match utf8_bytes_to_string(bs) {
    Some(s) => Ok(s)
    None => Err(CelError::new(CelErrorKind::SyntaxError, "invalid UTF-8 in string literal", pos))
  }
}

fn parse_u64_checked(src : Bytes, start : Int, end : Int, radix : UInt64, pos : Int) -> Result[UInt64, CelError] {
  let max_u64 : UInt64 = 18446744073709551615UL
  let mut acc : UInt64 = 0UL
  let mut i = start
  if i >= end {
    return Err(CelError::new(CelErrorKind::SyntaxError, "empty integer literal", pos))
  }
  while i < end {
    let b = src[i].to_int()
    let d = if radix == 16UL { hex_val(b) } else { b - 48 }
    if d < 0 || int_to_u64(d) >= radix {
      return Err(CelError::new(CelErrorKind::SyntaxError, "invalid digit in integer literal", pos))
    }
    let du = int_to_u64(d)
    if acc > (max_u64 - du) / radix {
      return Err(CelError::new(CelErrorKind::SyntaxError, "integer literal overflow", pos))
    }
    acc = acc * radix + du
    i = i + 1
  }
  Ok(acc)
}

fn scan_string_or_bytes(
  src : Bytes,
  start_pos : Int,
  idx : Int,
  is_raw : Bool,
  is_bytes : Bool,
) -> Result[(Token, Int), CelError] {
  let n = src.length()
  let quote = src[idx].to_int()
  let is_triple = idx + 2 < n && src[idx + 1].to_int() == quote && src[idx + 2].to_int() == quote
  let mut i = if is_triple { idx + 3 } else { idx + 1 }
  let out : Array[Byte] = []

  while i < n {
    let b = src[i].to_int()
    if is_triple {
      if b == quote && i + 2 < n && src[i + 1].to_int() == quote && src[i + 2].to_int() == quote {
        i = i + 3
        if is_bytes {
          return Ok((Token::{ kind: TokenKind::BytesLit(bytes_from_array(out)), pos: start_pos }, i))
        }
        match bytes_to_utf8_string(out, start_pos) {
          Ok(s) => return Ok((Token::{ kind: TokenKind::StringLit(s), pos: start_pos }, i))
          Err(e) => return Err(e)
        }
      }
    } else {
      if b == quote {
        i = i + 1
        if is_bytes {
          return Ok((Token::{ kind: TokenKind::BytesLit(bytes_from_array(out)), pos: start_pos }, i))
        }
        match bytes_to_utf8_string(out, start_pos) {
          Ok(s) => return Ok((Token::{ kind: TokenKind::StringLit(s), pos: start_pos }, i))
          Err(e) => return Err(e)
        }
      }
      if b == 10 || b == 13 {
        return Err(CelError::new(CelErrorKind::SyntaxError, "unterminated string literal (newline)", start_pos))
      }
    }

    if b == 13 {
      // Normalize \r\n and \r to \n per CEL spec
      if i + 1 < n && src[i + 1].to_int() == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      out.push(b'\n')
      continue
    }

    if !is_raw && b == 92 {
      // Escape sequence
      i = i + 1
      if i >= n {
        return Err(CelError::new(CelErrorKind::SyntaxError, "unterminated escape sequence", start_pos))
      }
      let esc = src[i].to_int()
      i = i + 1
      if esc == 97 {
        out.push((7).to_byte())
      } else if esc == 98 {
        out.push((8).to_byte())
      } else if esc == 102 {
        out.push((12).to_byte())
      } else if esc == 110 {
        out.push((10).to_byte())
      } else if esc == 114 {
        out.push((13).to_byte())
      } else if esc == 116 {
        out.push((9).to_byte())
      } else if esc == 118 {
        out.push((11).to_byte())
      } else if esc == 92 || esc == 34 || esc == 39 || esc == 63 || esc == 96 {
        out.push(esc.to_byte())
      } else if esc == 120 || esc == 88 {
        // \xHH or \XHH
        if i + 2 > n {
          return Err(CelError::new(CelErrorKind::SyntaxError, "incomplete hex escape", i))
        }
        let h1 = hex_val(src[i].to_int())
        let h2 = hex_val(src[i + 1].to_int())
        if h1 < 0 || h2 < 0 {
          return Err(CelError::new(CelErrorKind::SyntaxError, "invalid hex escape", i))
        }
        i = i + 2
        let byte_val = (h1 << 4) | h2
        if is_bytes {
          out.push(byte_val.to_byte())
        } else {
          push_utf8_codepoint(out, byte_val)
        }
      } else if esc == 117 || esc == 85 {
        // \uHHHH or \UHHHHHHHH (string only)
        if is_bytes {
          return Err(CelError::new(CelErrorKind::SyntaxError, "unicode escape not allowed in bytes literal", i))
        }
        let count = if esc == 117 { 4 } else { 8 }
        if i + count > n {
          return Err(CelError::new(CelErrorKind::SyntaxError, "incomplete unicode escape", i))
        }
        let mut cp = 0
        let mut k = 0
        while k < count {
          let h = hex_val(src[i + k].to_int())
          if h < 0 {
            return Err(CelError::new(CelErrorKind::SyntaxError, "invalid unicode escape", i))
          }
          cp = (cp << 4) | h
          k = k + 1
        }
        i = i + count
        if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
          return Err(CelError::new(CelErrorKind::SyntaxError, "invalid unicode codepoint", i))
        }
        push_utf8_codepoint(out, cp)
      } else if esc >= 48 && esc <= 51 {
        // 3-digit octal escape \000..\377
        if i + 2 > n {
          return Err(CelError::new(CelErrorKind::SyntaxError, "incomplete octal escape", i))
        }
        let d1 = esc - 48
        let d2 = src[i].to_int() - 48
        let d3 = src[i + 1].to_int() - 48
        if d2 < 0 || d2 > 7 || d3 < 0 || d3 > 7 {
          return Err(CelError::new(CelErrorKind::SyntaxError, "invalid octal escape", i))
        }
        i = i + 2
        let oct_val = (d1 << 6) | (d2 << 3) | d3
        if is_bytes {
          out.push(oct_val.to_byte())
        } else {
          push_utf8_codepoint(out, oct_val)
        }
      } else {
        return Err(CelError::new(CelErrorKind::SyntaxError, "unknown escape sequence", i - 1))
      }
    } else {
      out.push(src[i])
      i = i + 1
    }
  }
  Err(CelError::new(CelErrorKind::SyntaxError, "unterminated string literal", start_pos))
}

///| Tokenize a CEL source string into a flat token array ending with `TokenKind::Eof`.
pub fn tokenize(source : String) -> Result[Array[Token], CelError] {
  let src = string_to_bytes(source)
  let n = src.length()
  let tokens : Array[Token] = []
  let mut i = 0

  while i < n {
    let b = src[i].to_int()
    // Whitespace
    if b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12 {
      i = i + 1
      continue
    }
    // Line comment // ...
    if b == 47 && i + 1 < n && src[i + 1].to_int() == 47 {
      i = i + 2
      while i < n && src[i].to_int() != 10 {
        i = i + 1
      }
      continue
    }

    let start = i

    // String / Bytes prefixes: r, R, b, B, rb, br, ...
    if b == 34 || b == 39 {
      match scan_string_or_bytes(src, start, i, false, false) {
        Ok((tok, next_i)) => {
          tokens.push(tok)
          i = next_i
          continue
        }
        Err(e) => return Err(e)
      }
    }
    if (b == 114 || b == 82) && i + 1 < n {
      let b1 = src[i + 1].to_int()
      if b1 == 34 || b1 == 39 {
        match scan_string_or_bytes(src, start, i + 1, true, false) {
          Ok((tok, next_i)) => {
            tokens.push(tok)
            i = next_i
            continue
          }
          Err(e) => return Err(e)
        }
      }
    }
    if (b == 98 || b == 66) && i + 1 < n {
      let b1 = src[i + 1].to_int()
      if b1 == 34 || b1 == 39 {
        match scan_string_or_bytes(src, start, i + 1, false, true) {
          Ok((tok, next_i)) => {
            tokens.push(tok)
            i = next_i
            continue
          }
          Err(e) => return Err(e)
        }
      }
      if (b1 == 114 || b1 == 82) && i + 2 < n {
        let b2 = src[i + 2].to_int()
        if b2 == 34 || b2 == 39 {
          match scan_string_or_bytes(src, start, i + 2, true, true) {
            Ok((tok, next_i)) => {
              tokens.push(tok)
              i = next_i
              continue
            }
            Err(e) => return Err(e)
          }
        }
      }
    }

    // Identifiers and keywords
    if is_ident_start(b) {
      i = i + 1
      while i < n && is_ident_cont(src[i].to_int()) {
        i = i + 1
      }
      let ident = source.slice(start, i)
      if is_cel_reserved_word(ident) {
        return Err(CelError::new(CelErrorKind::SyntaxError, "reserved identifier: " + ident, start))
      }
      let kind = if ident == "true" {
        TokenKind::TrueLit
      } else if ident == "false" {
        TokenKind::FalseLit
      } else if ident == "null" {
        TokenKind::NullLit
      } else if ident == "in" {
        TokenKind::KwIn
      } else {
        TokenKind::Ident(ident)
      }
      tokens.push(Token::{ kind: kind, pos: start })
      continue
    }

    // Numbers (int, uint, double, leading-dot double)
    if is_digit(b) || (b == 46 && i + 1 < n && is_digit(src[i + 1].to_int())) {
      // Hex integer 0x...
      if b == 48 && i + 1 < n && (src[i + 1].to_int() == 120 || src[i + 1].to_int() == 88) {
        i = i + 2
        let hex_start = i
        while i < n && hex_val(src[i].to_int()) >= 0 {
          i = i + 1
        }
        let hex_end = i
        let is_uint = i < n && (src[i].to_int() == 117 || src[i].to_int() == 85)
        if is_uint {
          i = i + 1
        }
        match parse_u64_checked(src, hex_start, hex_end, 16UL, start) {
          Ok(num) => {
            let kind = if is_uint { TokenKind::UIntLit(num) } else { TokenKind::IntLit(num) }
            tokens.push(Token::{ kind: kind, pos: start })
            continue
          }
          Err(e) => return Err(e)
        }
      }

      let mut is_float = false
      if b == 46 {
        is_float = true
        i = i + 1
        while i < n && is_digit(src[i].to_int()) {
          i = i + 1
        }
      } else {
        while i < n && is_digit(src[i].to_int()) {
          i = i + 1
        }
        if i < n && src[i].to_int() == 46 && i + 1 < n && is_digit(src[i + 1].to_int()) {
          is_float = true
          i = i + 1
          while i < n && is_digit(src[i].to_int()) {
            i = i + 1
          }
        }
      }

      if i < n && (src[i].to_int() == 101 || src[i].to_int() == 69) {
        is_float = true
        i = i + 1
        if i < n && (src[i].to_int() == 43 || src[i].to_int() == 45) {
          i = i + 1
        }
        let exp_start = i
        while i < n && is_digit(src[i].to_int()) {
          i = i + 1
        }
        if i == exp_start {
          return Err(CelError::new(CelErrorKind::SyntaxError, "invalid float exponent", start))
        }
      }

      if is_float {
        let s = source.slice(start, i)
        match parse_cel_double_literal(s) {
          Some(d) => {
            if is_inf_f64(d) {
              return Err(CelError::new(CelErrorKind::SyntaxError, "invalid double literal (overflow): " + s, start))
            }
            tokens.push(Token::{ kind: TokenKind::DoubleLit(d), pos: start })
            continue
          }
          None => return Err(CelError::new(CelErrorKind::SyntaxError, "invalid float literal: " + s, start))
        }
      }

      let num_end = i
      let is_uint = i < n && (src[i].to_int() == 117 || src[i].to_int() == 85)
      if is_uint {
        i = i + 1
      }
      match parse_u64_checked(src, start, num_end, 10UL, start) {
        Ok(num) => {
          let kind = if is_uint { TokenKind::UIntLit(num) } else { TokenKind::IntLit(num) }
          tokens.push(Token::{ kind: kind, pos: start })
          continue
        }
        Err(e) => return Err(e)
      }
    }

    // Two-character operators
    if i + 1 < n {
      let b2 = src[i + 1].to_int()
      if b == 61 && b2 == 61 {
        tokens.push(Token::{ kind: TokenKind::EqEq, pos: start })
        i = i + 2
        continue
      }
      if b == 33 && b2 == 61 {
        tokens.push(Token::{ kind: TokenKind::BangEq, pos: start })
        i = i + 2
        continue
      }
      if b == 60 && b2 == 61 {
        tokens.push(Token::{ kind: TokenKind::LtEq, pos: start })
        i = i + 2
        continue
      }
      if b == 62 && b2 == 61 {
        tokens.push(Token::{ kind: TokenKind::GtEq, pos: start })
        i = i + 2
        continue
      }
      if b == 38 && b2 == 38 {
        tokens.push(Token::{ kind: TokenKind::AndAnd, pos: start })
        i = i + 2
        continue
      }
      if b == 124 && b2 == 124 {
        tokens.push(Token::{ kind: TokenKind::OrOr, pos: start })
        i = i + 2
        continue
      }
    }

    // Single-character operators and punctuation
    i = i + 1
    let kind = if b == 40 {
      TokenKind::LParen
    } else if b == 41 {
      TokenKind::RParen
    } else if b == 91 {
      TokenKind::LBracket
    } else if b == 93 {
      TokenKind::RBracket
    } else if b == 123 {
      TokenKind::LBrace
    } else if b == 125 {
      TokenKind::RBrace
    } else if b == 46 {
      TokenKind::Dot
    } else if b == 44 {
      TokenKind::Comma
    } else if b == 58 {
      TokenKind::Colon
    } else if b == 63 {
      TokenKind::Question
    } else if b == 43 {
      TokenKind::Plus
    } else if b == 45 {
      TokenKind::Minus
    } else if b == 42 {
      TokenKind::Star
    } else if b == 47 {
      TokenKind::Slash
    } else if b == 37 {
      TokenKind::Percent
    } else if b == 33 {
      TokenKind::Bang
    } else if b == 60 {
      TokenKind::Lt
    } else if b == 62 {
      TokenKind::Gt
    } else {
      return Err(CelError::new(CelErrorKind::SyntaxError, "unexpected character", start))
    }
    tokens.push(Token::{ kind: kind, pos: start })
  }

  tokens.push(Token::{ kind: TokenKind::Eof, pos: n })
  Ok(tokens)
}
