fn ryu_log10_pow2(e : Int) -> Int {
  (e * 78913) >> 18
}

fn ryu_log10_pow5(e : Int) -> Int {
  (e * 732923) >> 20
}

fn ryu_pow5bits(e : Int) -> Int {
  if e == 0 {
    1
  } else {
    ((e * 1217359) >> 19) + 1
  }
}

fn ryu_pow5_factor(value : UInt64) -> Int {
  let mut v = value
  let mut count = 0
  while true {
    let q = v / 5UL
    let r = v - q * 5UL
    if r != 0UL {
      break
    }
    v = q
    count = count + 1
  }
  count
}

fn ryu_multiple_of_power_of_5(value : UInt64, p : Int) -> Bool {
  ryu_pow5_factor(value) >= p
}

fn ryu_multiple_of_power_of_2(value : UInt64, p : Int) -> Bool {
  if p >= 64 {
    value == 0UL
  } else {
    (value & ((1UL << p.to_int64().reinterpret_as_uint64()) - 1UL)) == 0UL
  }
}

///| Exact 64x64 -> 128-bit unsigned multiply returning (lo, hi).
fn ryu_umul128(a : UInt64, b : UInt64) -> (UInt64, UInt64) {
  let mask32 : UInt64 = 0xFFFFFFFFUL
  let a0 = a & mask32
  let a1 = a >> 32UL
  let b0 = b & mask32
  let b1 = b >> 32UL
  let p00 = a0 * b0
  let p01 = a0 * b1
  let p10 = a1 * b0
  let p11 = a1 * b1
  let mid1 = (p00 >> 32UL) + (p01 & mask32) + (p10 & mask32)
  let lo = (p00 & mask32) | (mid1 << 32UL)
  let hi = p11 + (p01 >> 32UL) + (p10 >> 32UL) + (mid1 >> 32UL)
  (lo, hi)
}

///| Compute floor((m * (mul_hi * 2^64 + mul_lo)) / 2^j) where j in [65, 127].
fn ryu_mul_shift_64(m : UInt64, mul_lo : UInt64, mul_hi : UInt64, j : Int) -> UInt64 {
  let (_, b0_hi) = ryu_umul128(m, mul_lo)
  let (b2_lo, b2_hi) = ryu_umul128(m, mul_hi)
  let mid = b0_hi + b2_lo
  let carry : UInt64 = if mid < b0_hi { 1UL } else { 0UL }
  let high = b2_hi + carry
  let shift = (j - 64).to_int64().reinterpret_as_uint64()
  let rshift = (64 - (j - 64)).to_int64().reinterpret_as_uint64()
  (mid >> shift) | (high << rshift)
}

///| Compute shortest decimal representation (mantissa, exp10) for positive finite double.
fn ryu_d2d(ieee_mantissa : UInt64, ieee_exponent : Int) -> (UInt64, Int) {
  let e2 = if ieee_exponent == 0 {
    1 - 1023 - 52 - 2
  } else {
    ieee_exponent - 1023 - 52 - 2
  }
  let m2 : UInt64 = if ieee_exponent == 0 {
    ieee_mantissa
  } else {
    (1UL << 52UL) | ieee_mantissa
  }
  let even = (m2 & 1UL) == 0UL
  let accept_bounds = even
  let mv = 4UL * m2
  let mp = 4UL * m2 + 2UL
  let mm_shift = if ieee_mantissa != 0UL || ieee_exponent <= 1 { 1 } else { 0 }
  let mm = 4UL * m2 - 1UL - mm_shift.to_int64().reinterpret_as_uint64()

  let mut vr : UInt64 = 0UL
  let mut vp : UInt64 = 0UL
  let mut vm : UInt64 = 0UL
  let mut e10 = 0
  let mut vm_is_trailing_zeros = false
  let mut vr_is_trailing_zeros = false

  if e2 >= 0 {
    let q_raw = ryu_log10_pow2(e2) - (if e2 > 3 { 1 } else { 0 })
    let q = if q_raw < 0 { 0 } else { q_raw }
    e10 = q
    let k = 125 + ryu_pow5bits(q) - 1
    let i = -e2 + q + k
    let mul_lo = ryu_pow5_inv_lo[q]
    let mul_hi = ryu_pow5_inv_hi[q]
    vr = ryu_mul_shift_64(mv, mul_lo, mul_hi, i)
    vp = ryu_mul_shift_64(mp, mul_lo, mul_hi, i)
    vm = ryu_mul_shift_64(mm, mul_lo, mul_hi, i)
    if q <= 21 {
      if mv % 5UL == 0UL {
        vr_is_trailing_zeros = ryu_multiple_of_power_of_5(mv, q)
      } else if accept_bounds {
        vm_is_trailing_zeros = ryu_multiple_of_power_of_5(mm, q)
      } else if ryu_multiple_of_power_of_5(mp, q) {
        vp = vp - 1UL
      }
    }
  } else {
    let neg_e2 = -e2
    let q_raw = ryu_log10_pow5(neg_e2) - (if neg_e2 > 1 { 1 } else { 0 })
    let q = if q_raw < 0 { 0 } else { q_raw }
    e10 = q + e2
    let i = neg_e2 - q
    let k = ryu_pow5bits(i) - 125
    let j = q - k
    let mul_lo = ryu_pow5_lo[i]
    let mul_hi = ryu_pow5_hi[i]
    vr = ryu_mul_shift_64(mv, mul_lo, mul_hi, j)
    vp = ryu_mul_shift_64(mp, mul_lo, mul_hi, j)
    vm = ryu_mul_shift_64(mm, mul_lo, mul_hi, j)
    if q <= 1 {
      vr_is_trailing_zeros = true
      if accept_bounds {
        vm_is_trailing_zeros = mm_shift == 1
      } else {
        vp = vp - 1UL
      }
    } else if q < 63 {
      vr_is_trailing_zeros = ryu_multiple_of_power_of_2(mv, q - 1)
    }
  }

  let mut removed = 0
  let mut last_removed_digit : UInt64 = 0UL
  if vm_is_trailing_zeros || vr_is_trailing_zeros {
    while true {
      let vp_div10 = vp / 10UL
      let vm_div10 = vm / 10UL
      if vp_div10 <= vm_div10 {
        break
      }
      let vm_mod10 = vm - vm_div10 * 10UL
      let vr_div10 = vr / 10UL
      let vr_mod10 = vr - vr_div10 * 10UL
      vm_is_trailing_zeros = vm_is_trailing_zeros && (vm_mod10 == 0UL)
      vr_is_trailing_zeros = vr_is_trailing_zeros && (last_removed_digit == 0UL)
      last_removed_digit = vr_mod10
      vr = vr_div10
      vp = vp_div10
      vm = vm_div10
      removed = removed + 1
    }
    if vm_is_trailing_zeros {
      while true {
        let vm_div10 = vm / 10UL
        let vm_mod10 = vm - vm_div10 * 10UL
        if vm_mod10 != 0UL {
          break
        }
        let vp_div10 = vp / 10UL
        let vr_div10 = vr / 10UL
        let vr_mod10 = vr - vr_div10 * 10UL
        vr_is_trailing_zeros = vr_is_trailing_zeros && (last_removed_digit == 0UL)
        last_removed_digit = vr_mod10
        vr = vr_div10
        vp = vp_div10
        vm = vm_div10
        removed = removed + 1
      }
    }
    if vr_is_trailing_zeros && last_removed_digit == 5UL && (vr % 2UL == 0UL) {
      last_removed_digit = 4UL
    }
    let round_up = (vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= 5UL
    let output = vr + (if round_up { 1UL } else { 0UL })
    (output, e10 + removed)
  } else {
    let mut round_up = false
    let vp_div100 = vp / 100UL
    let vm_div100 = vm / 100UL
    if vp_div100 > vm_div100 {
      let vr_div100 = vr / 100UL
      let vr_mod100 = vr - vr_div100 * 100UL
      round_up = vr_mod100 >= 50UL
      vr = vr_div100
      vp = vp_div100
      vm = vm_div100
      removed = removed + 2
    }
    while true {
      let vp_div10 = vp / 10UL
      let vm_div10 = vm / 10UL
      if vp_div10 <= vm_div10 {
        break
      }
      let vr_div10 = vr / 10UL
      let vr_mod10 = vr - vr_div10 * 10UL
      round_up = vr_mod10 >= 5UL
      vr = vr_div10
      vp = vp_div10
      vm = vm_div10
      removed = removed + 1
    }
    let inc = if vr == vm || round_up { 1UL } else { 0UL }
    (vr + inc, e10 + removed)
  }
}

