///| Count leading zero bits of a non-zero `UInt64`.
fn clz_u64(x : UInt64) -> Int {
  let mut v = x
  let mut n = 0
  if (v & 0xFFFFFFFF00000000UL) == 0UL {
    n = n + 32
    v = v << 32UL
  }
  if (v & 0xFFFF000000000000UL) == 0UL {
    n = n + 16
    v = v << 16UL
  }
  if (v & 0xFF00000000000000UL) == 0UL {
    n = n + 8
    v = v << 8UL
  }
  if (v & 0xF000000000000000UL) == 0UL {
    n = n + 4
    v = v << 4UL
  }
  if (v & 0xC000000000000000UL) == 0UL {
    n = n + 2
    v = v << 2UL
  }
  if (v & 0x8000000000000000UL) == 0UL {
    n = n + 1
  }
  n
}

///| Eisel-Lemire fast exact conversion of `w * 10^q` to IEEE-754 `Double`.
///| Returns `None` on ambiguous rounding boundaries or subnormals (caller falls back to `to_double()`).
fn eisel_lemire_f64(w_in : UInt64, q : Int) -> Option[Double] {
  if w_in == 0UL || q < -342 || q > 308 {
    return None
  }
  let lz = clz_u64(w_in)
  let w = w_in << lz.to_int64().reinterpret_as_uint64()
  let idx = q + 342
  let p_hi = el_pow5_hi[idx]
  let (lo1, hi1) = ryu_umul128(w, p_hi)
  let ub1 = (hi1 >> 63UL).to_int()
  let sh1 = (ub1 + 9).to_int64().reinterpret_as_uint64()
  let rm1 = (1UL << sh1) - 1UL
  let r1 = hi1 & rm1
  let upper = if r1 >= 1UL && r1 <= rm1 - 2UL {
    hi1
  } else {
    let (_, hi2) = ryu_umul128(w, el_pow5_lo[idx])
    let mid = lo1 + hi2
    let carry : UInt64 = if mid < lo1 { 1UL } else { 0UL }
    hi1 + carry
  }
  let upper_bit = (upper >> 63UL).to_int()
  let shift = upper_bit + 9
  let shift_u = shift.to_int64().reinterpret_as_uint64()
  let rem_mask = (1UL << shift_u) - 1UL
  let rem = upper & rem_mask
  if rem == 0UL || rem == rem_mask {
    return None
  }
  let z = upper >> shift_u
  let mut sig = (z >> 1UL) + (z & 1UL)
  let log2_10 = if q >= 0 {
    (q * 217706) >> 16
  } else {
    -(((-q) * 217706 + 65535) >> 16)
  }
  let mut exp2 = log2_10 + 63 - lz + upper_bit
  if sig == (1UL << 53UL) {
    sig = sig >> 1UL
    exp2 = exp2 + 1
  }
  if exp2 < -1022 {
    return None
  }
  if exp2 > 1023 {
    return Some(1.0 / 0.0)
  }
  let ieee_exp = (exp2 + 1023).to_int64().reinterpret_as_uint64()
  let bits = (ieee_exp << 52UL) | (sig & 0x000FFFFFFFFFFFFFUL)
  Some(Double::from_bits(bits.reinterpret_as_int64()))
}

///| Negate an IEEE-754 double by flipping its sign bit (preserves `-0.0`).
pub fn neg_f64_bits(d : Double) -> Double {
  Double::from_bits(d.to_bits() ^ (-9223372036854775807L - 1L))
}

// ============================================================================
// Exact big-integer fallback for IEEE-754 binary64 decimal-to-binary conversion
// ============================================================================

fn big_trim(a : Array[UInt64]) -> Unit {
  while a.length() > 0 && a[a.length() - 1] == 0UL {
    let _ = a.pop()
  }
}

fn big_mul_add(a : Array[UInt64], mul : UInt64, add : UInt64) -> Unit {
  let mut carry = add
  let mut i = 0
  while i < a.length() {
    let cur = a[i] * mul + carry
    a[i] = cur & 0xFFFFFFFFUL
    carry = cur >> 32UL
    i = i + 1
  }
  while carry > 0UL {
    a.push(carry & 0xFFFFFFFFUL)
    carry = carry >> 32UL
  }
}

fn big_mul_pow5(a : Array[UInt64], exp5 : Int) -> Unit {
  let mut rem = exp5
  // 5^13 = 1220703125 fits in 32 bits
  while rem >= 13 {
    big_mul_add(a, 1220703125UL, 0UL)
    rem = rem - 13
  }
  if rem > 0 {
    let mut p : UInt64 = 1UL
    let mut k = 0
    while k < rem {
      p = p * 5UL
      k = k + 1
    }
    big_mul_add(a, p, 0UL)
  }
}

fn big_shl(a : Array[UInt64], shift : Int) -> Unit {
  if shift <= 0 || a.length() == 0 {
    return
  }
  let word_shift = shift / 32
  let bit_shift = shift % 32
  if bit_shift > 0 {
    let sh_u = bit_shift.to_int64().reinterpret_as_uint64()
    let rsh_u = (32 - bit_shift).to_int64().reinterpret_as_uint64()
    let mut carry : UInt64 = 0UL
    let mut i = 0
    while i < a.length() {
      let v = a[i]
      a[i] = ((v << sh_u) | carry) & 0xFFFFFFFFUL
      carry = v >> rsh_u
      i = i + 1
    }
    if carry > 0UL {
      a.push(carry)
    }
  }
  if word_shift > 0 {
    let old_len = a.length()
    let mut k = 0
    while k < word_shift {
      a.push(0UL)
      k = k + 1
    }
    let mut i = old_len - 1
    while i >= 0 {
      a[i + word_shift] = a[i]
      i = i - 1
    }
    let mut j = 0
    while j < word_shift {
      a[j] = 0UL
      j = j + 1
    }
  }
}

fn big_bit_len(a : Array[UInt64]) -> Int {
  big_trim(a)
  let n = a.length()
  if n == 0 {
    return 0
  }
  let top = a[n - 1]
  let lz = clz_u64(top)
  (n - 1) * 32 + (64 - lz)
}

fn big_cmp(a : Array[UInt64], b : Array[UInt64]) -> Int {
  big_trim(a)
  big_trim(b)
  if a.length() < b.length() {
    return -1
  }
  if a.length() > b.length() {
    return 1
  }
  let mut i = a.length() - 1
  while i >= 0 {
    if a[i] < b[i] {
      return -1
    }
    if a[i] > b[i] {
      return 1
    }
    i = i - 1
  }
  0
}

fn big_sub_in_place(a : Array[UInt64], b : Array[UInt64]) -> Unit {
  let mut borrow : UInt64 = 0UL
  let mut i = 0
  while i < a.length() {
    let bv = if i < b.length() { b[i] } else { 0UL }
    let av = a[i]
    let sub = bv + borrow
    if av >= sub {
      a[i] = av - sub
      borrow = 0UL
    } else {
      a[i] = (av + 0x100000000UL) - sub
      borrow = 1UL
    }
    i = i + 1
  }
  big_trim(a)
}

///| Exact decimal-to-IEEE-754 binary64 conversion for positive non-zero decimal `digits * 10^exp10`.
///| `digits` contains ASCII '0'..'9' (leading zeros already stripped; capped at 768 digits + sticky).
fn big_dec_to_f64(digits : Array[Int], exp10 : Int, sticky_extra : Bool) -> Double {
  let nd = digits.length()
  if nd == 0 {
    return 0.0
  }
  // Quick overflow / underflow bounds based on scientific exponent
  let sci_exp = exp10 + nd - 1
  if sci_exp > 309 {
    return 1.0 / 0.0
  }
  if sci_exp < -326 {
    return 0.0
  }

  // Build numerator D (if sticky_extra, append digit '5' and decrement exp10 by 1)
  let num : Array[UInt64] = []
  let mut i = 0
  while i < nd {
    big_mul_add(num, 10UL, digits[i].to_int64().reinterpret_as_uint64())
    i = i + 1
  }
  let mut q10 = exp10
  if sticky_extra {
    big_mul_add(num, 10UL, 5UL)
    q10 = q10 - 1
  }
  let den : Array[UInt64] = [1UL]
  if q10 >= 0 {
    big_mul_pow5(num, q10)
  } else {
    big_mul_pow5(den, -q10)
  }
  // Value is (num / den) * 2^q10
  // We want exact binary exponent e2 such that:
  //   normal:    2^52 <= (num / den) * 2^(q10 - e2) < 2^53, e2 in [-1074, 971]
  //   subnormal: 0 <= (num / den) * 2^(q10 - (-1074)) < 2^52, e2 = -1074
  let nb = big_bit_len(num)
  let db = big_bit_len(den)
  // Initial estimate for msb_exp = floor(log2(value))
  let mut msb_exp = nb - db + q10
  // Target e2 = msb_exp - 52, clamped to >= -1074
  let mut e2 = msb_exp - 52
  if e2 < -1074 {
    e2 = -1074
  }
  // Shift so we compare num2 / den2 = (num / den) * 2^(q10 - e2)
  let shift = q10 - e2
  if shift > 0 {
    big_shl(num, shift)
  } else if shift < 0 {
    big_shl(den, -shift)
  }
  // If e2 > -1074, adjust e2 by +/- 1 so quotient is strictly in [2^52, 2^53)
  // Check if num < den * 2^52
  if e2 > -1074 {
    let den52 : Array[UInt64] = []
    let mut k = 0
    while k < den.length() {
      den52.push(den[k])
      k = k + 1
    }
    big_shl(den52, 52)
    if big_cmp(num, den52) < 0 {
      // Shift num left by 1, decrement e2
      big_shl(num, 1)
      e2 = e2 - 1
    } else {
      big_shl(den52, 1)
      if big_cmp(num, den52) >= 0 {
        // Shift den left by 1, increment e2
        big_shl(den, 1)
        e2 = e2 + 1
      }
    }
  }
  // Now compute 54-bit integer quotient q = floor(num / den) via binary long division (at most 54 iterations)
  let mut q : UInt64 = 0UL
  let mut bit = 53
  while bit >= 0 {
    let shifted : Array[UInt64] = []
    let mut k = 0
    while k < den.length() {
      shifted.push(den[k])
      k = k + 1
    }
    big_shl(shifted, bit)
    if big_cmp(num, shifted) >= 0 {
      big_sub_in_place(num, shifted)
      q = q | (1UL << bit.to_int64().reinterpret_as_uint64())
    }
    bit = bit - 1
  }
  // Round to nearest even using remainder in `num` vs `den`
  big_shl(num, 1)
  let cmp_half = big_cmp(num, den)
  if cmp_half > 0 || (cmp_half == 0 && (q & 1UL) != 0UL) {
    q = q + 1UL
  }
  // Handle carry out of 53 bits
  if q >= (1UL << 53UL) {
    q = q >> 1UL
    e2 = e2 + 1
  }
  let biased_exp = if q == 0UL {
    0
  } else if e2 == -1074 && q < (1UL << 52UL) {
    0
  } else {
    e2 + 52 + 1023
  }
  if biased_exp >= 2047 {
    return 1.0 / 0.0
  }
  let ieee_bits = (biased_exp.to_int64().reinterpret_as_uint64() << 52UL) | (q & 0x000FFFFFFFFFFFFFUL)
  Double::from_bits(ieee_bits.reinterpret_as_int64())
}

fn parse_decimal_float_core(s : String, allow_underscores : Bool) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if s.code_unit_at(i) == 43 {
    i = i + 1
  }
  if i >= n {
    return None
  }
  let digits : Array[Int] = []
  let mut has_any_digit = false
  let mut sig_val : UInt64 = 0UL
  let mut sig_digits = 0
  let mut truncated = false
  let mut sticky_extra = false
  let mut frac_digits = 0
  let mut extra_int_zeros = 0
  let mut prev_was_underscore = false

  // Integer part
  let int_start = i
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      has_any_digit = true
      prev_was_underscore = false
      let d = b - 48
      if d != 0 || digits.length() > 0 {
        if digits.length() < 768 {
          digits.push(d)
        } else {
          extra_int_zeros = extra_int_zeros + 1
          if d != 0 {
            sticky_extra = true
          }
        }
        if sig_digits < 19 {
          sig_val = sig_val * 10UL + d.to_int64().reinterpret_as_uint64()
          sig_digits = sig_digits + 1
        } else {
          truncated = true
        }
      }
      i = i + 1
    } else if allow_underscores && b == 95 && i > int_start && !prev_was_underscore {
      prev_was_underscore = true
      i = i + 1
    } else {
      break
    }
  }
  if prev_was_underscore {
    return None
  }

  // Fractional part
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let frac_start = i
    prev_was_underscore = false
    while i < n {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        has_any_digit = true
        prev_was_underscore = false
        let d = b - 48
        if digits.length() == 0 {
          if d != 0 {
            digits.push(d)
            frac_digits = frac_digits + 1
            sig_val = d.to_int64().reinterpret_as_uint64()
            sig_digits = 1
          } else {
            frac_digits = frac_digits + 1
          }
        } else {
          if digits.length() < 768 {
            digits.push(d)
            frac_digits = frac_digits + 1
          } else if d != 0 {
            sticky_extra = true
          }
          if sig_digits < 19 {
            sig_val = sig_val * 10UL + d.to_int64().reinterpret_as_uint64()
            sig_digits = sig_digits + 1
          } else {
            truncated = true
          }
        }
        i = i + 1
      } else if allow_underscores && b == 95 && i > frac_start && !prev_was_underscore {
        prev_was_underscore = true
        i = i + 1
      } else {
        break
      }
    }
    if prev_was_underscore {
      return None
    }
  }

  if !has_any_digit {
    return None
  }

  // Exponent part
  let mut exp_val = 0
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let exp_start = i
    let mut has_exp_digit = false
    prev_was_underscore = false
    while i < n {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        has_exp_digit = true
        prev_was_underscore = false
        if exp_val < 100000 {
          exp_val = exp_val * 10 + (b - 48)
        }
        i = i + 1
      } else if allow_underscores && b == 95 && i > exp_start && !prev_was_underscore {
        prev_was_underscore = true
        i = i + 1
      } else {
        break
      }
    }
    if !has_exp_digit || prev_was_underscore {
      return None
    }
    if exp_neg {
      exp_val = -exp_val
    }
  }

  if i != n {
    return None
  }

  if digits.length() == 0 {
    return Some(if neg { neg_f64_bits(0.0) } else { 0.0 })
  }

  let q10 = exp_val - frac_digits + extra_int_zeros
  let mag = if !truncated && !sticky_extra && sig_digits <= 19 {
    match eisel_lemire_f64(sig_val, q10) {
      Some(d) => d
      None => big_dec_to_f64(digits, q10, sticky_extra)
    }
  } else {
    big_dec_to_f64(digits, q10, sticky_extra)
  }
  Some(if neg { neg_f64_bits(mag) } else { mag })
}

fn parse_hex_float_str(s : String) -> Option[Double] {
  let n = s.length()
  let mut i = 0
  let mut neg = false
  if i < n && s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if i < n && s.code_unit_at(i) == 43 {
    i = i + 1
  }
  if i + 2 > n || s.code_unit_at(i) != 48 || (s.code_unit_at(i + 1) != 120 && s.code_unit_at(i + 1) != 88) {
    return None
  }
  i = i + 2
  let mut mant : UInt64 = 0UL
  let mut bits = 0
  let mut sticky = false
  let mut has_digit = false
  let mut saw_dot = false
  let mut frac_bits = 0
  let mut extra_int_bits = 0

  while i < n {
    let b = s.code_unit_at(i)
    if b == 95 {
      i = i + 1
      continue
    }
    if b == 46 && !saw_dot {
      saw_dot = true
      i = i + 1
      continue
    }
    let hv = hex_val(b)
    if hv < 0 {
      break
    }
    has_digit = true
    if bits == 0 {
      if hv != 0 {
        mant = hv.to_int64().reinterpret_as_uint64()
        bits = if hv >= 8 { 4 } else if hv >= 4 { 3 } else if hv >= 2 { 2 } else { 1 }
        if saw_dot {
          frac_bits = frac_bits + 4
        }
      } else if saw_dot {
        frac_bits = frac_bits + 4
      }
    } else if bits + 4 <= 63 {
      mant = (mant << 4UL) | hv.to_int64().reinterpret_as_uint64()
      bits = bits + 4
      if saw_dot {
        frac_bits = frac_bits + 4
      }
    } else {
      let mut k = 3
      while k >= 0 {
        let bit_v = (hv >> k) & 1
        if bits < 63 {
          mant = (mant << 1UL) | bit_v.to_int64().reinterpret_as_uint64()
          bits = bits + 1
          if saw_dot {
            frac_bits = frac_bits + 1
          }
        } else {
          if bit_v != 0 {
            sticky = true
          }
          if !saw_dot {
            extra_int_bits = extra_int_bits + 1
          }
        }
        k = k - 1
      }
    }
    i = i + 1
  }
  if !has_digit {
    return None
  }
  if i >= n || (s.code_unit_at(i) != 112 && s.code_unit_at(i) != 80) {
    return None
  }
  i = i + 1
  let mut exp_neg = false
  if i < n && s.code_unit_at(i) == 45 {
    exp_neg = true
    i = i + 1
  } else if i < n && s.code_unit_at(i) == 43 {
    i = i + 1
  }
  let mut exp_val = 0
  let mut has_exp = false
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      has_exp = true
      if exp_val < 100000 {
        exp_val = exp_val * 10 + (b - 48)
      }
      i = i + 1
    } else if b == 95 && has_exp {
      i = i + 1
    } else {
      break
    }
  }
  if !has_exp || i != n {
    return None
  }
  if exp_neg {
    exp_val = -exp_val
  }
  if bits == 0 {
    return Some(if neg { neg_f64_bits(0.0) } else { 0.0 })
  }
  let total_exp = exp_val + extra_int_bits - frac_bits
  let mut msb_exp = bits - 1 + total_exp
  if msb_exp > 1023 {
    let inf = 1.0 / 0.0
    return Some(if neg { neg_f64_bits(inf) } else { inf })
  }
  if msb_exp < -1075 {
    return Some(if neg { neg_f64_bits(0.0) } else { 0.0 })
  }
  let target_bits = if msb_exp < -1022 {
    msb_exp + 1075
  } else {
    53
  }
  let mut sig : UInt64 = 0UL
  if target_bits <= 0 {
    let shift = bits - target_bits
    let round_up = if shift <= 63 {
      let half = 1UL << (shift - 1).to_int64().reinterpret_as_uint64()
      mant > half || (mant == half && sticky)
    } else {
      false
    }
    sig = if round_up { 1UL } else { 0UL }
  } else if bits <= target_bits {
    sig = mant << (target_bits - bits).to_int64().reinterpret_as_uint64()
  } else {
    let shift = bits - target_bits
    let sh_u = shift.to_int64().reinterpret_as_uint64()
    sig = mant >> sh_u
    let rem_mask = (1UL << sh_u) - 1UL
    let rem = mant & rem_mask
    let half = 1UL << (shift - 1).to_int64().reinterpret_as_uint64()
    if rem > half || (rem == half && (sticky || (sig & 1UL) != 0UL)) {
      sig = sig + 1UL
    }
  }
  let biased_exp = if msb_exp < -1022 {
    if sig >= (1UL << 52UL) { 1 } else { 0 }
  } else {
    if sig >= (1UL << 53UL) {
      sig = sig >> 1UL
      msb_exp = msb_exp + 1
    }
    if msb_exp > 1023 {
      let inf = 1.0 / 0.0
      return Some(if neg { neg_f64_bits(inf) } else { inf })
    }
    msb_exp + 1023
  }
  let ieee_bits = (biased_exp.to_int64().reinterpret_as_uint64() << 52UL) | (sig & 0x000FFFFFFFFFFFFFUL)
  let mag = Double::from_bits(ieee_bits.reinterpret_as_int64())
  Some(if neg { neg_f64_bits(mag) } else { mag })
}

fn eq_ascii_icase(a : String, b : String) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    let mut ca = a.code_unit_at(i)
    let mut cb = b.code_unit_at(i)
    if ca >= 65 && ca <= 90 {
      ca = ca + 32
    }
    if cb >= 65 && cb <= 90 {
      cb = cb + 32
    }
    if ca != cb {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a CEL numeric double literal (strict decimal, exact IEEE-754 rounding).
pub fn parse_cel_double_literal(s : String) -> Option[Double] {
  parse_decimal_float_core(s, false)
}

///| Parse a string via `double(string)` (Go `strconv.ParseFloat` semantics).
pub fn parse_cel_double_conv(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  if eq_ascii_icase(s, "nan") {
    return Some(0.0 / 0.0)
  }
  if eq_ascii_icase(s, "inf") || eq_ascii_icase(s, "+inf") || eq_ascii_icase(s, "infinity") || eq_ascii_icase(s, "+infinity") {
    return Some(1.0 / 0.0)
  }
  if eq_ascii_icase(s, "-inf") || eq_ascii_icase(s, "-infinity") {
    return Some(-1.0 / 0.0)
  }
  // Check hex float 0x...p... / -0x...p... / +0x...p...
  let mut p = 0
  if s.code_unit_at(0) == 43 || s.code_unit_at(0) == 45 {
    p = 1
  }
  if p + 2 <= n && s.code_unit_at(p) == 48 && (s.code_unit_at(p + 1) == 120 || s.code_unit_at(p + 1) == 88) {
    return parse_hex_float_str(s)
  }
  parse_decimal_float_core(s, true)
}

///| Format a CEL `Double` identically to Go `strconv.FormatFloat(f, 'g', -1, 64)`.
pub fn format_cel_double(v : Double) -> String {
  let bits = v.to_bits().reinterpret_as_uint64()
  let neg = (bits >> 63UL) != 0UL
  let ieee_exp = ((bits >> 52UL) & 0x7FFUL).to_int()
  let ieee_mant = bits & ((1UL << 52UL) - 1UL)
  if ieee_exp == 0x7FF {
    if ieee_mant != 0UL {
      return "NaN"
    }
    if neg {
      return "-Inf"
    }
    return "+Inf"
  }
  if ieee_exp == 0 && ieee_mant == 0UL {
    if neg {
      return "-0"
    }
    return "0"
  }
  let sb = StringBuilder::new()
  if neg {
    sb.write_byte((45).to_byte())
  }
  let (mant, exp10) = ryu_d2d(ieee_mant, ieee_exp)
  let buf = FixedArray::make(20, (0).to_byte())
  let mut m = mant
  let mut n = 0
  while m >= 10UL {
    let q = m / 10UL
    let r = (m - q * 10UL).to_int()
    buf[n] = (48 + r).to_byte()
    n = n + 1
    m = q
  }
  buf[n] = (48 + m.to_int()).to_byte()
  n = n + 1
  let sci_exp = exp10 + n - 1
  // Go 'g' with prec=-1 uses scientific notation iff sci_exp < -4 || sci_exp >= 6
  if sci_exp >= -4 && sci_exp < 6 {
    let dot_pos = sci_exp + 1
    if dot_pos <= 0 {
      sb.write_string("0.")
      let mut z = 0
      while z < -dot_pos {
        sb.write_byte((48).to_byte())
        z = z + 1
      }
      let mut i = n - 1
      while i >= 0 {
        sb.write_byte(buf[i])
        i = i - 1
      }
    } else if dot_pos >= n {
      let mut i = n - 1
      while i >= 0 {
        sb.write_byte(buf[i])
        i = i - 1
      }
      let mut z = 0
      while z < dot_pos - n {
        sb.write_byte((48).to_byte())
        z = z + 1
      }
    } else {
      let mut i = 0
      while i < dot_pos {
        sb.write_byte(buf[n - 1 - i])
        i = i + 1
      }
      sb.write_byte((46).to_byte())
      while i < n {
        sb.write_byte(buf[n - 1 - i])
        i = i + 1
      }
    }
  } else {
    sb.write_byte(buf[n - 1])
    if n > 1 {
      sb.write_byte((46).to_byte())
      let mut i = n - 2
      while i >= 0 {
        sb.write_byte(buf[i])
        i = i - 1
      }
    }
    sb.write_byte((101).to_byte())
    let abs_exp = if sci_exp >= 0 {
      sb.write_byte((43).to_byte())
      sci_exp
    } else {
      sb.write_byte((45).to_byte())
      -sci_exp
    }
    if abs_exp < 10 {
      sb.write_byte((48).to_byte())
    }
    sb.write_string(abs_exp.to_string())
  }
  sb.to_string()
}
