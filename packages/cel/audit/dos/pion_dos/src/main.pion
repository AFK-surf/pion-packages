///| DoS / limit-bypass probes for `packages/cel` (Pion side). One probe per process so that
///| a crash (stack overflow, OOM) is attributed to exactly one probe; timing and peak RSS
///| are measured from outside (`/usr/bin/time -l`, see `dos/run_dos.py`).
///|
///| usage: cel_audit_dos <probe> <n>
///|   parse_chain N   parse `1+1+...` (N terms)                 -> parser only
///|   check_chain N   compile `1+1+...` (N terms)               -> parser + checker
///|   check_member N  compile `dyn({'a':1}).a.a...` (N selects)      -> parser + checker
///|   check_index N   compile `dyn([0])[0]...[0]` (N indexes)        -> parser + checker
///|   eval_chain N    eval `1+1+...` (N terms), default limits
///|   or_chain N      compile+eval `x == 0 || x == 1 || ...` (N clauses), default limits
///|   mem_amp K       2^K fresh 1 MiB strings (`s + s`) inside one result (max_output_bytes = 1 MiB)
///|   cpu_in K        L = [0 .. 2^K) ; L.map(i, 1 in L)          (2^(2K) equality tests)
///|   cpu_size K      2^K x size(<1 MiB string>)                 (2^K x 1 MiB UTF-8 scans)
///|   cpu_eq K        2^K x (<1 MiB string> == <1 MiB string>)
///|   map_lookup K    map with 2^K int keys, 2^K lookups          (O(n^2) vs O(n))
///|   act_lookup N    Activation with N vars; 100000 x eval of the LAST var

import "cel"

fn rep(unit : String, sep : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(unit)
    i = i + 1
  }
  sb.to_string()
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

// `[[0]].map(l, l + l)` applied k times -> list of 2^k zeros (each step is 1 node + 1 concat).
fn list_of_pow2(k : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[[0]]")
  let mut i = 0
  while i < k {
    sb.write_string(".map(l, l + l)")
    i = i + 1
  }
  sb.write_string("[0]")
  sb.to_string()
}

// 16 B string doubled 16 times = 1 MiB (exactly max_output_bytes, allowed by `>` check).
fn mib_string() -> String {
  let sb = StringBuilder::new()
  sb.write_string("['0123456789abcdef']")
  let mut i = 0
  while i < 16 {
    sb.write_string(".map(s, s + s)")
    i = i + 1
  }
  sb.write_string("[0]")
  sb.to_string()
}

// 16 B string doubled 15 times = 512 KiB.
fn half_mib_string() -> String {
  let sb = StringBuilder::new()
  sb.write_string("['0123456789abcdef']")
  let mut i = 0
  while i < 15 {
    sb.write_string(".map(s, s + s)")
    i = i + 1
  }
  sb.write_string("[0]")
  sb.to_string()
}

fn total_bytes(v : cel::Value) -> Int64 {
  match v.kind {
    cel::ValueKind::String(s) => s.length().to_int64()
    cel::ValueKind::Bytes(b) => b.length().to_int64()
    cel::ValueKind::List(xs) => {
      let mut t = 0L
      let mut i = 0
      while i < xs.length() {
        t = t + total_bytes(xs[i])
        i = i + 1
      }
      t
    }
    _ => 8L
  }
}

fn show(world : World, label : String, r : Result[cel::Value, cel::CelError]) -> Unit {
  match r {
    Ok(v) => {
      let shape = match v.kind {
        cel::ValueKind::List(xs) => "list(len=" + xs.length().to_string() + ")"
        cel::ValueKind::Bool(b) => "bool(" + b.to_string() + ")"
        cel::ValueKind::Int64(n) => "int(" + n.to_string() + ")"
        _ => cel::value_type_name(v)
      }
      io_println(world, label + " OK " + shape + " result_bytes=" + total_bytes(v).to_string())
    }
    Err(e) => io_println(world, label + " ERR " + e.to_string())
  }
}

fn compile_eval(src : String, act : cel::Activation, env : cel::Env) -> Result[cel::Value, cel::CelError] {
  match cel::compile(src, env) {
    Ok(p) => p.eval(act)
    Err(e) => Err(e)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: cel_audit_dos <probe> <n>")
    return 2
  }
  let probe = args[1]
  let n = parse_int(args[2])
  let empty = cel::Activation::empty()
  let env0 = cel::Env::new()
  if probe == "parse_chain" {
    match cel::parse(rep("1", "+", n)) {
      Ok(a) => io_println(world, "parse_chain OK nodes=" + a.nodes.length().to_string())
      Err(e) => io_println(world, "parse_chain ERR " + e.to_string())
    }
  } else if probe == "check_chain" {
    match cel::compile(rep("1", "+", n), env0) {
      Ok(_) => io_println(world, "check_chain OK")
      Err(e) => io_println(world, "check_chain ERR " + e.to_string())
    }
  } else if probe == "check_member" {
    match cel::compile("dyn({'a':1})" + rep(".a", "", n), env0) {
      Ok(_) => io_println(world, "check_member OK")
      Err(e) => io_println(world, "check_member ERR " + e.to_string())
    }
  } else if probe == "check_index" {
    match cel::compile("dyn([0])" + rep("[0]", "", n), env0) {
      Ok(_) => io_println(world, "check_index OK")
      Err(e) => io_println(world, "check_index ERR " + e.to_string())
    }
  } else if probe == "eval_chain" {
    show(world, "eval_chain", cel::eval(rep("1", "+", n), empty))
  } else if probe == "or_chain" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      if i > 0 {
        sb.write_string(" || ")
      }
      sb.write_string("x == " + i.to_string())
      i = i + 1
    }
    let env = env0.with_var("x", cel::CelType::Int)
    let act = cel::Activation::from_pairs([("x", cel::Value::int((n - 1).to_int64()))])
    show(world, "or_chain", compile_eval(sb.to_string(), act, env))
  } else if probe == "mem_amp" {
    let src = "[" + half_mib_string() + "].map(s, [" + list_of_pow2(n) + "].map(l, l.map(i, s + s)))"
    // (`s + s` allocates a fresh 1 MiB string per element — each one individually within the limit)
    show(world, "mem_amp limit=" + cel::EvalLimits::default().max_output_bytes.to_string(), cel::eval(src, empty))
  } else if probe == "cpu_in" {
    let src = "[" + list_of_pow2(n) + "].map(L, L.map(i, 1 in L))"
    show(world, "cpu_in", cel::eval(src, empty))
  } else if probe == "cpu_size" {
    let src = "[" + mib_string() + "].map(s, [" + list_of_pow2(n) + "].map(l, l.map(i, size(s))))"
    show(world, "cpu_size", cel::eval(src, empty))
  } else if probe == "cpu_eq" {
    let src = "[" + mib_string() + "].map(s, [" + list_of_pow2(n) + "].map(l, l.map(i, s == s + '')))"
    show(world, "cpu_eq", cel::eval(src, empty))
  } else if probe == "map_lookup" {
    let entries : Array[(cel::Value, cel::Value)] = []
    let keys : Array[cel::Value] = []
    let cnt = 1 << n
    let mut i = 0
    while i < cnt {
      entries.push((cel::Value::int(i.to_int64()), cel::Value::int(i.to_int64())))
      keys.push(cel::Value::int(i.to_int64()))
      i = i + 1
    }
    let act = cel::Activation::from_pairs([("m", cel::Value::map(entries)), ("ks", cel::Value::list(keys))])
    let env = env0
    .with_var("m", cel::CelType::Map(cel::CelType::Int, cel::CelType::Int))
    .with_var("ks", cel::CelType::List(cel::CelType::Int))
    show(world, "map_lookup", compile_eval("ks.map(k, m[k]).size()", act, env))
  } else if probe == "act_lookup" {
    let pairs : Array[(String, cel::Value)] = []
    let mut env = env0
    let mut i = 0
    while i < n {
      pairs.push(("v" + i.to_string(), cel::Value::int(i.to_int64())))
      env = env.with_var("v" + i.to_string(), cel::CelType::Int)
      i = i + 1
    }
    let act = cel::Activation::from_pairs(pairs)
    let prog = match cel::compile("v" + (n - 1).to_string() + " > 0", env) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "act_lookup ERR " + e.to_string())
        return 1
      }
    }
    let mut ok = 0
    let mut j = 0
    while j < 100000 {
      match prog.eval(act) {
        Ok(_) => ok = ok + 1
        Err(_) => ()
      }
      j = j + 1
    }
    io_println(world, "act_lookup OK evals=" + ok.to_string())
  } else {
    io_println(world, "unknown probe " + probe)
    return 2
  }
  0
}
