///| Control tests for the `packages/cel` red-team audit: behaviour Pion gets RIGHT (matches
///| cel-go v0.24.1 / cel-spec, or is strictly better). These must always pass.

import "cel"

fn cev(src : String) -> Result[cel::Value, cel::CelError] {
  cel::eval(src, cel::Activation::empty())
}

fn cwant(src : String, expected : cel::Value) -> Unit {
  let ok = match cev(src) {
    Ok(v) => cel::value_strict_eq(v, expected)
    Err(_) => false
  }
  debug_assert(ok, "control: " + src)
}

fn cwant_kind(src : String, kind : cel::CelErrorKind) -> Unit {
  let ok = match cev(src) {
    Ok(_) => false
    Err(e) => e.is_kind(kind)
  }
  debug_assert(ok, "control (error kind " + cel::error_kind_as_str(kind) + "): " + src)
}

///|
test "control_commutative_error_absorption" {
  cwant("true || (1/0 == 0)", cel::Value::bool(true))
  cwant("(1/0 == 0) || true", cel::Value::bool(true))
  cwant("false && (1/0 == 0)", cel::Value::bool(false))
  cwant("(1/0 == 0) && false", cel::Value::bool(false))
  cwant_kind("(1/0 == 0) || false", cel::CelErrorKind::DivisionByZero)
  cwant("[1, 0, 2].exists(x, 10/x == 5)", cel::Value::bool(true))
  cwant("[0, 1].all(x, x > 0 && 10/x > 0)", cel::Value::bool(false))
  cwant("[0, 1].all(x, 10/x > 50)", cel::Value::bool(false))
  cwant_kind("[1, 0].all(x, 10/x > 5)", cel::CelErrorKind::DivisionByZero)
  cwant_kind("[0, 1].all(x, 10/x > 0)", cel::CelErrorKind::DivisionByZero)
  cwant_kind("[0, 2].exists_one(x, 10/x == 5)", cel::CelErrorKind::DivisionByZero)
}

///|
test "control_int64_edges_no_trap" {
  cwant("-9223372036854775808", cel::Value::int(-9223372036854775807L - 1L))
  cwant_kind("-9223372036854775808 / -1", cel::CelErrorKind::Overflow)
  cwant_kind("-9223372036854775808 % -1", cel::CelErrorKind::Overflow)
  cwant_kind("-(-9223372036854775808)", cel::CelErrorKind::Overflow)
  cwant_kind("9223372036854775807 + 1", cel::CelErrorKind::Overflow)
  cwant_kind("-9223372036854775808 * -1", cel::CelErrorKind::Overflow)
  cwant_kind("-1 * -9223372036854775808", cel::CelErrorKind::Overflow)
  cwant_kind("18446744073709551615u + 1u", cel::CelErrorKind::Overflow)
  cwant_kind("0u - 1u", cel::CelErrorKind::Overflow)
  cwant_kind("5 % 0", cel::CelErrorKind::DivisionByZero)
  cwant("-7 / 2", cel::Value::int(-3L))
  cwant("-7 % 2", cel::Value::int(-1L))
  cwant("--1", cel::Value::int(1L))
  cwant("!!true", cel::Value::bool(true))
  cwant_kind("int(9223372036854775808.0)", cel::CelErrorKind::Overflow)
  cwant_kind("int(-9223372036854775808.0)", cel::CelErrorKind::Overflow)
  cwant_kind("int(0.0/0.0)", cel::CelErrorKind::Overflow)
  cwant_kind("uint(-1.0)", cel::CelErrorKind::Overflow)
  cwant_kind("uint(1e20)", cel::CelErrorKind::Overflow)
}

///| Fairness: Pion compares int/uint/double exactly on the real number line (cel-spec), cel-go
///| converts the integer to double first and answers 9007199254740993 == 9007199254740992.0.
test "control_exact_cross_type_numeric_comparison" {
  cwant("1 == 1u && 1 == 1.0 && 1u == 1.0 && -1 < 0u", cel::Value::bool(true))
  cwant("9007199254740993 > 9007199254740992.0", cel::Value::bool(true))
  cwant("9223372036854775807 < 9223372036854775808.0", cel::Value::bool(true))
  cwant("18446744073709551615u < 18446744073709551616.0", cel::Value::bool(true))
  cwant("0.0/0.0 == 0.0/0.0", cel::Value::bool(false))
  cwant("0.0/0.0 != 0.0/0.0", cel::Value::bool(true))
  cwant("[1] == [1u] && {1: 'a'}[1u] == 'a'", cel::Value::bool(true))
}

///|
test "control_lexer_literals" {
  cwant("'''a'b''c'''", cel::Value::string("a'b''c"))
  cwant("'\\U0001F600'.size()", cel::Value::int(1L))
  debug_assert(
    match cev("'\\uD800'") {
      Ok(_) => false
      Err(_) => true
    },
    "lone surrogate must be rejected",
  )
  debug_assert(
    match cev("'\\400'") {
      Ok(_) => false
      Err(_) => true
    },
    "octal > 377 rejected",
  )
  debug_assert(
    match cev("'a\nb'") {
      Ok(_) => false
      Err(_) => true
    },
    "newline in single-quoted string rejected",
  )
  cwant("b'\\x80'.size()", cel::Value::int(1L))
  cwant("b'\\377'.size()", cel::Value::int(1L))
  cwant("'\\377' == '\\u00ff'", cel::Value::bool(true))
  debug_assert(
    match cev("b'\\u00e9'") {
      Ok(_) => false
      Err(_) => true
    },
    "unicode escape in bytes literal rejected",
  )
}

///|
test "control_macros_and_scoping" {
  cwant("[1, 2].map(x, x + 1) == [2, 3]", cel::Value::bool(true))
  cwant("[1, 2].all(x, [3, 4].all(x, x > 2))", cel::Value::bool(true))
  cwant("[1, 2].map(x, [x].map(x, x * 10)) == [[10], [20]]", cel::Value::bool(true))
  cwant("true ? 1 : false ? 2 : 3", cel::Value::int(1L))
  cwant("false ? 1 : false ? 2 : 3", cel::Value::int(3L))
  cwant("has({'a': 1}.a) && !has({'a': 1}.b)", cel::Value::bool(true))
  cwant_kind("has({'a': {'b': 1}}.c.b)", cel::CelErrorKind::NoSuchField)
  debug_assert(
    match cel::parse("has(x)") {
      Ok(_) => false
      Err(_) => true
    },
    "has(ident) must be a syntax error",
  )
}

///| Fairness: `max_depth` does protect the parser and the evaluator (no crash on deep parens /
///| unary chains; graceful LimitExceeded), and the default `max_cost` stops plain fuel bombs.
test "control_depth_and_fuel_limits" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 100000 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  cwant_kind(sb.to_string(), cel::CelErrorKind::LimitExceeded)
  let nb = StringBuilder::new()
  let mut j = 0
  while j < 100000 {
    nb.write_string("!")
    j = j + 1
  }
  nb.write_string("true")
  cwant_kind(nb.to_string(), cel::CelErrorKind::LimitExceeded)
  let l = "[[0]].map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l).map(l, l + l)[0]"
  cwant_kind("[" + l + "].map(a, a.map(b, a.map(c, 1)))", cel::CelErrorKind::LimitExceeded)
}
