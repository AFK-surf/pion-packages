///| Differential driver for `packages/cel` (Pion side).
///| Reads a case file (`<mode>\t<hex expr>` per line, mode `E` = parse+eval unchecked,
///| `C` = parse+check+eval) and prints a canonical transcript identical in format to
///| `audit/diff/go_oracle` (Go `google/cel-go v0.24.1`).
///|
///| Output per case:  `## <line>` then one of
///|   `OK <canonical value>` | `PERR\t<msg>` (parse) | `CERR\t<msg>` (check) | `EERR\t<msg>` (eval)

import "cel"

fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length() / 2
  let mut i = 0
  while i < n {
    let v = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(v.to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn hex_str(s : String) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn hex_bytes(bs : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    let b = bs[i].to_int()
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn hex_u64(u : UInt64) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut k = 15
  while k >= 0 {
    let nib = ((u >> (k * 4)) & 15UL).reinterpret_as_int64().to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    k = k - 1
  }
  sb.to_string()
}

fn sort_strings(xs : Array[String]) -> Unit {
  // insertion sort (byte order) — transcripts are small
  let mut i = 1
  while i < xs.length() {
    let x = xs[i]
    let mut j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
}

fn canon(v : cel::Value) -> String {
  match v.kind {
    cel::ValueKind::Null => "null"
    cel::ValueKind::Bool(b) => if b { "bool:true" } else { "bool:false" }
    cel::ValueKind::Int64(n) => "int:" + n.to_string()
    cel::ValueKind::UInt64(u) => "uint:" + u.to_string()
    cel::ValueKind::Double(d) => {
      if d != d {
        "double:nan"
      } else {
        "double:" + hex_u64(d.to_bits().reinterpret_as_uint64())
      }
    }
    cel::ValueKind::String(s) => "string:" + hex_str(s)
    cel::ValueKind::Bytes(bs) => "bytes:" + hex_bytes(bs)
    cel::ValueKind::List(xs) => {
      let sb = StringBuilder::new()
      sb.write_string("[")
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(canon(xs[i]))
        i = i + 1
      }
      sb.write_string("]")
      sb.to_string()
    }
    cel::ValueKind::Map(es) => {
      let parts : Array[String] = []
      let mut i = 0
      while i < es.length() {
        let (k, x) = es[i]
        parts.push(canon(k) + "=" + canon(x))
        i = i + 1
      }
      sort_strings(parts)
      let sb = StringBuilder::new()
      sb.write_string("{")
      let mut j = 0
      while j < parts.length() {
        if j > 0 {
          sb.write_string(",")
        }
        sb.write_string(parts[j])
        j = j + 1
      }
      sb.write_string("}")
      sb.to_string()
    }
    cel::ValueKind::Timestamp(ts) => "ts:" + ts.secs.to_string() + "." + ts.nanos.to_string()
    cel::ValueKind::Duration(d) => {
      // normalise to (secs, nanos) with nanos sharing the sign of the total, like Go's ns/1e9, ns%1e9
      "dur:" + d.secs.to_string() + "." + d.nanos.to_string()
    }
    cel::ValueKind::Type(t) => "type:" + t
  }
}

fn split_fields(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == sep {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

fn one_line(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b == 10 || b == 13 || b == 9 {
      sb.write_byte(b' ')
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn run_case(mode : String, src : String) -> String {
  let ast = match cel::parse(src) {
    Ok(a) => a
    Err(e) => return "PERR\t" + one_line(e.to_string())
  }
  if mode == "C" {
    match cel::check(ast, cel::Env::new()) {
      Ok(_) => ()
      Err(e) => return "CERR\t" + one_line(e.to_string())
    }
  }
  match cel::eval(src, cel::Activation::empty()) {
    Ok(v) => "OK " + canon(v)
    Err(e) => "EERR\t" + one_line(e.to_string())
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: cel_audit_driver <cases>")
    return 2
  }
  let data = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read " + args[1])
      return 2
    }
  }
  let lines = split_fields(data, 10)
  let mut idx = 0
  while idx < lines.length() {
    let line = lines[idx]
    idx = idx + 1
    if line.length() == 0 || line.code_unit_at(0) == 35 {
      continue
    }
    let f = split_fields(line, 9)
    if f.length() < 2 {
      continue
    }
    io_print(world, "## " + idx.to_string() + "\n" + run_case(f[0], unhex(f[1])) + "\n")
  }
  0
}
