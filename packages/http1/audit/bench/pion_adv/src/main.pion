///| Adversarial head-to-head benchmark runner (Pion side) for the http1 red-team audit.
///| Modes: req64 | chunk1m | sse_multiline | drip   (see audit/bench/gen_bench.py)

import "http1"

///|
fn hash_str(h : Int64, s : String) -> Int64 {
  let mut acc = h
  let n = s.length()
  let mut i = 0
  while i < n {
    acc = (acc * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  acc
}

///|
fn bench_req64(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = http1::Limits::default()
  let mut count : Int64 = 0L
  let mut headers : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut round = 0
  while round < 4 {
    let mut pos = 0
    while pos < dlen {
      match http1::parse_request_at(data, pos, dlen, lim) {
        Ok(http1::ParseStatus::Complete(req, consumed)) => {
          count = count + 1L
          headers = headers + req.headers.length().to_int64()
          hash = hash_str(hash, req.method)
          hash = hash_str(hash, req.path)
          match req.header("host") {
            Some(v) => hash = hash_str(hash, v)
            None => ()
          }
          match req.header("x-request-id") {
            Some(v) => hash = hash_str(hash, v)
            None => ()
          }
          pos = pos + consumed
        }
        _ => {
          io_println(world, "req parse error at " + pos.to_string())
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=req64")
  io_println(world, "count=" + count.to_string())
  io_println(world, "headers=" + headers.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///| Real streaming API: parse_response_at + ChunkedDecoder fed 64 KiB network reads.
fn bench_chunk1m(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = http1::Limits::default()
  let mut count : Int64 = 0L
  let mut body : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut round = 0
  while round < 16 {
    let mut pos = 0
    while pos < dlen {
      match http1::parse_response_at(data, pos, dlen, lim) {
        Ok(http1::ParseStatus::Complete(_, consumed)) => {
          count = count + 1L
          pos = pos + consumed
          let dec = http1::ChunkedDecoder::new()
          let mut off : Int64 = 0L
          let mut done = false
          while !done {
            if pos >= dlen {
              io_println(world, "truncated")
              return 1
            }
            let e = if pos + 65536 > dlen { dlen } else { pos + 65536 }
            dec.feed(data.slice(pos, e))
            pos = e
            let mut looping = true
            while looping {
              match dec.next() {
                Ok(http1::ChunkStep::Data(d)) => {
                  let n = d.length()
                  // sample every byte whose body offset is a multiple of 4096
                  let first = ((off + 4095L) / 4096L * 4096L - off).to_int()
                  let mut k = first
                  while k < n {
                    hash = (hash * 131L + d[k].to_int().to_int64()) % 1000000007L
                    k = k + 4096
                  }
                  off = off + n.to_int64()
                }
                Ok(http1::ChunkStep::NeedMore) => looping = false
                Ok(http1::ChunkStep::Done(_)) => {
                  looping = false
                  done = true
                }
                Err(_) => {
                  io_println(world, "chunk error")
                  return 1
                }
              }
            }
          }
          pos = pos - dec.remaining_bytes()
          body = body + off
        }
        _ => {
          io_println(world, "resp parse error at " + pos.to_string())
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=chunk1m")
  io_println(world, "count=" + count.to_string())
  io_println(world, "body_bytes=" + body.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn bench_sse(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let mut events : Int64 = 0L
  let mut data_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut round = 0
  while round < 2 {
    let dec = http1::SseDecoder::new()
    let mut off = 0
    while off < dlen {
      let e = if off + 4096 < dlen { off + 4096 } else { dlen }
      match dec.feed(data.slice(off, e)) {
        Ok(evts) => {
          let mut j = 0
          while j < evts.length() {
            let ev = evts[j]
            events = events + 1L
            data_bytes = data_bytes + ev.data.length().to_int64()
            hash = hash_str(hash, ev.event_type)
            hash = hash_str(hash, ev.last_event_id)
            hash = hash_str(hash, ev.data)
            j = j + 1
          }
        }
        Err(_) => {
          io_println(world, "sse decode error")
          return 1
        }
      }
      off = e
    }
    round = round + 1
  }
  io_println(world, "mode=sse_multiline")
  io_println(world, "events=" + events.to_string())
  io_println(world, "data_bytes=" + data_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///| Sans-IO usage under a 1-byte drip: re-parse the buffered prefix after every byte.
fn bench_drip(world : World, data : Bytes) -> Int {
  let n = data.length()
  let lim = http1::Limits::default()
  let mut complete = 0
  let mut round = 0
  while round < 4 {
    let mut k = 1
    while k <= n {
      match http1::parse_request_at(data, 0, k, lim) {
        Ok(http1::ParseStatus::Complete(_, _)) => complete = complete + 1
        Ok(http1::ParseStatus::Partial) => ()
        Err(_) => {
          io_println(world, "drip error at " + k.to_string())
          return 1
        }
      }
      k = k + 1
    }
    round = round + 1
  }
  io_println(world, "mode=drip")
  io_println(world, "bytes=" + n.to_string())
  io_println(world, "complete=" + complete.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: adv_pion <req64|chunk1m|sse_multiline|drip> <file>")
    return 1
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + args[2])
      return 1
    }
  }
  let mode = args[1]
  if mode == "req64" {
    bench_req64(world, data)
  } else if mode == "chunk1m" {
    bench_chunk1m(world, data)
  } else if mode == "sse_multiline" {
    bench_sse(world, data)
  } else if mode == "drip" {
    bench_drip(world, data)
  } else {
    io_println(world, "unknown mode " + mode)
    1
  }
}
