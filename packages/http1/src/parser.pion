///| RFC 9112 HTTP/1.1 Request & Response incremental parser (Red-phase stubs).

///|
pub fn parse_request(buf : Bytes) -> Result[ParseStatus[Request], HttpError] {
  parse_request_with_limits(buf, Limits::default())
}

///|
pub fn parse_request_with_limits(
  buf : Bytes,
  limits : Limits,
) -> Result[ParseStatus[Request], HttpError] {
  parse_request_at(buf, 0, buf.length(), limits)
}

///|
pub fn parse_request_at(
  buf : Bytes,
  start : Int,
  end : Int,
  limits : Limits,
) -> Result[ParseStatus[Request], HttpError] {
  let _ = buf
  let _ = start
  let _ = end
  let _ = limits
  Err(HttpError::InvalidMethod)
}

///|
pub fn parse_response(buf : Bytes) -> Result[ParseStatus[Response], HttpError] {
  parse_response_with_limits(buf, Limits::default())
}

///|
pub fn parse_response_with_limits(
  buf : Bytes,
  limits : Limits,
) -> Result[ParseStatus[Response], HttpError] {
  parse_response_at(buf, 0, buf.length(), limits)
}

///|
pub fn parse_response_at(
  buf : Bytes,
  start : Int,
  end : Int,
  limits : Limits,
) -> Result[ParseStatus[Response], HttpError] {
  let _ = buf
  let _ = start
  let _ = end
  let _ = limits
  Err(HttpError::InvalidStatus)
}
