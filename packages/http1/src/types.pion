///| Core RFC 9110 / RFC 9112 HTTP/1.1 and WHATWG SSE types, limits, and errors.

///|
pub enum Version {
  Http10
  Http11
}

///|
pub fn version_to_string(v : Version) -> String {
  match v {
    Version::Http10 => "HTTP/1.0"
    Version::Http11 => "HTTP/1.1"
  }
}

///|
pub fn Version::to_string(self : Version) -> String {
  version_to_string(self)
}

///|
#verify
pub fn version_eq(a : Version, b : Version) -> Bool {
  match (a, b) {
    (Version::Http10, Version::Http10) => true
    (Version::Http11, Version::Http11) => true
    _ => false
  }
}

///|
pub val struct Header {
  pub name : String
  pub value : String
}

///|
pub fn Header::new(name : String, value : String) -> Header {
  Header::{ name: name, value: value }
}

///|
pub enum Framing {
  None
  ContentLength(Int64)
  Chunked
}

///|
pub val struct Limits {
  pub max_headers : Int
  pub max_header_bytes : Int64
  pub max_uri_bytes : Int64
  pub max_chunk_size : Int64
  pub max_chunk_ext_bytes : Int64
  pub max_trailers : Int
  pub max_sse_event_bytes : Int64
  pub max_sse_line_bytes : Int64
}

///|
#verify
pub fn Limits::default() -> Limits {
  Limits::{
    max_headers: 100,
    max_header_bytes: 65536L,
    max_uri_bytes: 8192L,
    max_chunk_size: 4611686018427387903L,
    max_chunk_ext_bytes: 4096L,
    max_trailers: 64,
    max_sse_event_bytes: 1048576L,
    max_sse_line_bytes: 262144L,
  }
}

///| RFC 9112 §6.3 rule 1: 1xx, 204, and 304 responses never carry a message body.
#verify
pub fn is_bodyless_status(status : Int) -> Bool {
  status < 200 || status == 204 || status == 304
}

///| RFC 9112 §6.3 effective response framing after applying bodyless status overrides.
#verify
pub fn effective_response_framing(status : Int, framing : Framing) -> Framing {
  if is_bodyless_status(status) {
    Framing::None
  } else {
    framing
  }
}

///| RFC 9112 anti-smuggling header framing accumulator state.
pub val struct FramingState {
  pub has_cl : Bool
  pub cl_val : Int64
  pub has_te : Bool
  pub te_state : Int
  pub host_count : Int
}

///|
#verify
pub fn FramingState::new() -> FramingState {
  FramingState::{
    has_cl: false,
    cl_val: 0L,
    has_te: false,
    te_state: 0,
    host_count: 0,
  }
}

///| Process a Content-Length header value into the RFC 9112 framing state machine.
#verify
pub fn framing_on_content_length(
  st : FramingState,
  cl_v : Int64,
) -> Result[FramingState, HttpError] {
  if st.has_te {
    return Err(HttpError::AmbiguousFraming)
  }
  if st.has_cl {
    return Err(HttpError::InvalidContentLength)
  }
  if cl_v < 0L {
    return Err(HttpError::InvalidContentLength)
  }
  Ok(
    FramingState::{
      has_cl: true,
      cl_val: cl_v,
      has_te: st.has_te,
      te_state: st.te_state,
      host_count: st.host_count,
    },
  )
}

///| Process a Transfer-Encoding header transition into the RFC 9112 framing state machine.
#verify
pub fn framing_on_transfer_encoding(
  st : FramingState,
  version : Version,
  next_te : Int,
) -> Result[FramingState, HttpError] {
  if st.has_cl {
    return Err(HttpError::AmbiguousFraming)
  }
  if version_eq(version, Version::Http10) {
    return Err(HttpError::InvalidTransferEncoding)
  }
  if next_te < 0 {
    return Err(HttpError::InvalidTransferEncoding)
  }
  Ok(
    FramingState::{
      has_cl: st.has_cl,
      cl_val: st.cl_val,
      has_te: true,
      te_state: next_te,
      host_count: st.host_count,
    },
  )
}

///| Process a Host header occurrence into the RFC 9112 framing state machine.
#verify
pub fn framing_on_host(
  st : FramingState,
  host_valid : Bool,
) -> Result[FramingState, HttpError] {
  if st.host_count >= 1 {
    return Err(HttpError::InvalidHost)
  }
  if !host_valid {
    return Err(HttpError::InvalidHost)
  }
  Ok(
    FramingState::{
      has_cl: st.has_cl,
      cl_val: st.cl_val,
      has_te: st.has_te,
      te_state: st.te_state,
      host_count: st.host_count + 1,
    },
  )
}

///| Finalize the RFC 9112 framing state machine after all headers are parsed.
#verify
pub fn framing_finalize(
  st : FramingState,
  is_request : Bool,
  version : Version,
) -> Result[Framing, HttpError] {
  if is_request && version_eq(version, Version::Http11) && st.host_count == 0 {
    return Err(HttpError::InvalidHost)
  }
  if st.has_te {
    if is_request && st.te_state != 1 {
      return Err(HttpError::InvalidTransferEncoding)
    }
    if st.te_state == 1 {
      return Ok(Framing::Chunked)
    }
    return Ok(Framing::None)
  }
  if st.has_cl {
    return Ok(Framing::ContentLength(st.cl_val))
  }
  Ok(Framing::None)
}

///|
pub enum HttpError {
  InvalidMethod
  InvalidUri
  InvalidVersion
  InvalidStatus
  InvalidReason
  InvalidHeaderName
  InvalidHeaderValue
  InvalidHost
  ObsFold
  BareCrOrLf
  AmbiguousFraming
  InvalidContentLength
  InvalidTransferEncoding
  TooManyHeaders
  HeaderTooLarge
  UriTooLarge
  InvalidChunkSize
  InvalidChunkExtension
  ChunkTooLarge
  InvalidChunkTerminator
  InvalidTrailer
  TooManyTrailers
  CrlfInjection
  SseEventTooLarge
  SseLineTooLarge
}

///|
pub fn http_error_string(err : HttpError) -> String {
  match err {
    HttpError::InvalidMethod => "invalid HTTP method"
    HttpError::InvalidUri => "invalid request target URI"
    HttpError::InvalidVersion => "invalid HTTP version"
    HttpError::InvalidStatus => "invalid HTTP status code"
    HttpError::InvalidReason => "invalid HTTP reason phrase"
    HttpError::InvalidHeaderName => "invalid HTTP header name"
    HttpError::InvalidHeaderValue => "invalid HTTP header value"
    HttpError::InvalidHost => "missing, duplicate, or invalid Host header"
    HttpError::ObsFold => "obsolete line folding (obs-fold) rejected"
    HttpError::BareCrOrLf => "bare CR or LF rejected"
    HttpError::AmbiguousFraming => "ambiguous framing: both Content-Length and Transfer-Encoding present"
    HttpError::InvalidContentLength => "invalid or duplicate Content-Length"
    HttpError::InvalidTransferEncoding => "invalid Transfer-Encoding"
    HttpError::TooManyHeaders => "too many headers"
    HttpError::HeaderTooLarge => "header block exceeds max_header_bytes"
    HttpError::UriTooLarge => "request target exceeds max_uri_bytes"
    HttpError::InvalidChunkSize => "invalid chunk size"
    HttpError::InvalidChunkExtension => "invalid chunk extension"
    HttpError::ChunkTooLarge => "chunk size exceeds max_chunk_size"
    HttpError::InvalidChunkTerminator => "invalid chunk CRLF terminator"
    HttpError::InvalidTrailer => "invalid chunked trailer header"
    HttpError::TooManyTrailers => "too many chunked trailers"
    HttpError::CrlfInjection => "CRLF or NUL injection rejected"
    HttpError::SseEventTooLarge => "SSE event exceeds max_sse_event_bytes"
    HttpError::SseLineTooLarge => "SSE line exceeds max_sse_line_bytes"
  }
}

///|
pub enum ParseStatus[T] {
  Complete(T, Int)
  Partial
}

///|
pub struct Request {
  pub method : String
  pub path : String
  pub version : Version
  pub headers : Array[Header]
  pub framing : Framing
}

///|
pub struct Response {
  pub version : Version
  pub status : Int
  pub reason : String
  pub headers : Array[Header]
  pub framing : Framing
}

///|
pub enum ChunkStep {
  Data(Bytes)
  NeedMore
  Done(Array[Header])
}

///|
pub val struct SseEvent {
  pub event_type : String
  pub data : String
  pub last_event_id : String
  pub retry : Option[Int64]
}

///|
pub fn SseEvent::new(
  event_type : String,
  data : String,
  last_event_id : String,
  retry : Option[Int64],
) -> SseEvent {
  SseEvent::{
    event_type: event_type,
    data: data,
    last_event_id: last_event_id,
    retry: retry,
  }
}

///|
pub fn Request::header(self : Request, name : String) -> Option[String] {
  let hdrs = self.headers
  let n = hdrs.length()
  let mut i = 0
  while i < n {
    if str_eq_ignore_ascii_case(hdrs[i].name, name) {
      return Some(hdrs[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn Request::headers_named(self : Request, name : String) -> Array[String] {
  let out : Array[String] = []
  let hdrs = self.headers
  let n = hdrs.length()
  let mut i = 0
  while i < n {
    if str_eq_ignore_ascii_case(hdrs[i].name, name) {
      out.push(hdrs[i].value)
    }
    i = i + 1
  }
  out
}

///|
pub fn Request::content_length(self : Request) -> Option[Int64] {
  match self.framing {
    Framing::ContentLength(n) => Some(n)
    _ => None
  }
}

///|
pub fn Request::is_chunked(self : Request) -> Bool {
  match self.framing {
    Framing::Chunked => true
    _ => false
  }
}

///|
pub fn Response::header(self : Response, name : String) -> Option[String] {
  let hdrs = self.headers
  let n = hdrs.length()
  let mut i = 0
  while i < n {
    if str_eq_ignore_ascii_case(hdrs[i].name, name) {
      return Some(hdrs[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn Response::headers_named(self : Response, name : String) -> Array[String] {
  let out : Array[String] = []
  let hdrs = self.headers
  let n = hdrs.length()
  let mut i = 0
  while i < n {
    if str_eq_ignore_ascii_case(hdrs[i].name, name) {
      out.push(hdrs[i].value)
    }
    i = i + 1
  }
  out
}

///|
pub fn Response::content_length(self : Response) -> Option[Int64] {
  match self.framing {
    Framing::ContentLength(n) => Some(n)
    _ => None
  }
}

///|
pub fn Response::is_chunked(self : Response) -> Bool {
  match self.framing {
    Framing::Chunked => true
    _ => false
  }
}
