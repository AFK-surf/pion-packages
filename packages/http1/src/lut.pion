///| Global 256-byte FixedArray lookup tables (P53-C BCE) for RFC 9110 / RFC 9112 / SSE.

///| RFC 9110 §5.6.2 token character (`tchar`) byte predicate.
#verify
pub fn is_tchar_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) ||
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  b == 33 ||
  b == 35 ||
  b == 36 ||
  b == 37 ||
  b == 38 ||
  b == 39 ||
  b == 42 ||
  b == 43 ||
  b == 45 ||
  b == 46 ||
  b == 94 ||
  b == 95 ||
  b == 96 ||
  b == 124 ||
  b == 126
}

///| RFC 9112 request-target visible ASCII (`VCHAR`) byte predicate.
pub fn is_uri_byte(b : Int) -> Bool {
  b >= 33 && b <= 126
}

///| RFC 9110 field-value byte predicate (HTAB / SP..VCHAR / obs-text; rejects CR/LF/NUL/CTL).
#verify
pub fn is_header_val_byte(b : Int) -> Bool {
  b == 9 || (b >= 32 && b <= 126) || (b >= 128 && b <= 255)
}

///| CRLF or NUL injection byte predicate.
#verify
pub fn is_crlf_or_nul_byte(b : Int) -> Bool {
  b == 13 || b == 10 || b == 0
}

///| ASCII hexadecimal digit decoder (`0..15`, or `-1` if invalid).
#verify
pub fn hex_digit_value(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///| ASCII lowercase normalization for a byte.
#verify
pub fn ascii_lower_byte(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///| RFC 3986 reg-name / host character byte predicate.
pub fn is_host_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) ||
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  b == 45 ||
  b == 46 ||
  b == 95 ||
  b == 126 ||
  b == 33 ||
  b == 36 ||
  b == 38 ||
  b == 39 ||
  b == 40 ||
  b == 41 ||
  b == 42 ||
  b == 43 ||
  b == 44 ||
  b == 59 ||
  b == 61 ||
  b == 37
}

///|
fn build_tchar_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_tchar_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///|
fn build_uri_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_uri_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///|
fn build_header_val_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_header_val_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///|
fn build_hex_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 0
  while i < 256 {
    lut[i] = hex_digit_value(i)
    i = i + 1
  }
  lut
}

///|
fn build_lower_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    lut[i] = ascii_lower_byte(i)
    i = i + 1
  }
  lut
}

///|
fn build_hex_lower_bytes() -> FixedArray[Byte] {
  let arr : FixedArray[Byte] = FixedArray::make(16, (48).to_byte())
  let mut i = 0
  while i < 10 {
    arr[i] = (48 + i).to_byte()
    i = i + 1
  }
  while i < 16 {
    arr[i] = (87 + i).to_byte()
    i = i + 1
  }
  arr
}

///|
fn build_host_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_host_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///|
let tchar_lut : FixedArray[Int] = build_tchar_lut()

///|
let uri_lut : FixedArray[Int] = build_uri_lut()

///|
let header_val_lut : FixedArray[Int] = build_header_val_lut()

///|
let hex_lut : FixedArray[Int] = build_hex_lut()

///|
let lower_lut : FixedArray[Int] = build_lower_lut()

///|
let hex_lower_bytes : FixedArray[Byte] = build_hex_lower_bytes()

///|
let host_lut : FixedArray[Int] = build_host_lut()

///| Validate RFC 9112 §3.2 / RFC 3986 Host header value (`uri-host [ ":" port ]`).
fn validate_host_value(buf : Bytes, start : Int, end : Int) -> Bool {
  if start >= end {
    return true
  }
  let hlut = host_lut
  let mut pos = start
  if buf[pos].to_int() == 91 {
    // IP-literal: "[" ... "]" [ ":" *DIGIT ]
    pos = pos + 1
    let lit_start = pos
    while pos < end && buf[pos].to_int() != 93 {
      let b = buf[pos].to_int()
      if b != 58 && hlut[b] != 1 {
        return false
      }
      pos = pos + 1
    }
    if pos == lit_start || pos >= end || buf[pos].to_int() != 93 {
      return false
    }
    pos = pos + 1 // skip ']'
    if pos == end {
      return true
    }
    if buf[pos].to_int() != 58 {
      return false
    }
    pos = pos + 1
    while pos < end {
      let d = buf[pos].to_int()
      if d < 48 || d > 57 {
        return false
      }
      pos = pos + 1
    }
    return true
  }
  // reg-name / IPv4address [ ":" *DIGIT ]
  while pos < end {
    let b = buf[pos].to_int()
    if b == 58 {
      pos = pos + 1
      while pos < end {
        let d = buf[pos].to_int()
        if d < 48 || d > 57 {
          return false
        }
        pos = pos + 1
      }
      return true
    }
    if hlut[b] != 1 {
      return false
    }
    pos = pos + 1
  }
  true
}

///|
fn str_eq_ignore_ascii_case(a : String, b : String) -> Bool {
  let len = a.length()
  if len != b.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      let la = if ca >= 65 && ca <= 90 { ca + 32 } else { ca }
      let lb = if cb >= 65 && cb <= 90 { cb + 32 } else { cb }
      if la != lb {
        return false
      }
    }
    i = i + 1
  }
  true
}

///|
fn bytes_eq_lower_ascii(
  buf : Bytes,
  start : Int,
  end : Int,
  lower_target : String,
) -> Bool {
  let len = end - start
  if len != lower_target.length() {
    return false
  }
  let llut = lower_lut
  let mut i = 0
  while i < len {
    let b = buf[start + i].to_int()
    if llut[b] != lower_target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Overflow-checked single ASCII decimal digit step for non-negative signed 64-bit Content-Length / SSE retry.
///| Returns `-1L` on non-digit or overflow, otherwise `acc * 10L + (b - 48)` (`>= 0L`).
#verify
pub fn u63_decimal_step(acc : Int64, b : Int) -> Int64 {
  if b < 48 || b > 57 {
    return -1L
  }
  let max_div10 : Int64 = 922337203685477580L
  let d = (b - 48).to_int64()
  if acc < 0L || acc > max_div10 || (acc == max_div10 && d > 7L) {
    return -1L
  }
  acc * 10L + d
}

///|
fn parse_strict_u63_decimal(buf : Bytes, start : Int, end : Int) -> Option[Int64] {
  if start >= end {
    return None
  }
  let mut acc : Int64 = 0L
  let mut i = start
  while i < end {
    let next = u63_decimal_step(acc, buf[i].to_int())
    if next < 0L {
      return None
    }
    acc = next
    i = i + 1
  }
  Some(acc)
}
