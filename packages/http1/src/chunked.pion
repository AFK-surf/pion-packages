///| RFC 9112 §7.1 Chunked Transfer Coding incremental Sans-IO decoder.
///| Uses a bounded O(1) compacting chunk queue and strict RFC 9112 syntax validation.

///| Validate chunk-ext syntax starting at `ext_start` (which points to ';') up to `end` (before CRLF).
///| RFC 9112 §7.1.1: chunk-ext = *( BWS ";" BWS chunk-ext-name [ BWS "=" BWS chunk-ext-val ] )
fn validate_chunk_ext(
  buf : Bytes,
  ext_start : Int,
  end : Int,
  max_ext_bytes : Int64,
) -> Result[Unit, HttpError] {
  if (end - ext_start).to_int64() > max_ext_bytes {
    return Err(HttpError::InvalidChunkExtension)
  }
  let tlut = tchar_lut
  let mut pos = ext_start
  while pos < end {
    // Skip BWS (SP / HTAB)
    while pos < end {
      let b = buf[pos].to_int()
      if b == 32 || b == 9 {
        pos = pos + 1
      } else {
        break
      }
    }
    if pos >= end {
      break
    }
    if buf[pos].to_int() != 59 {
      return Err(HttpError::InvalidChunkExtension)
    }
    pos = pos + 1 // skip ';'
    // Skip BWS
    while pos < end {
      let b = buf[pos].to_int()
      if b == 32 || b == 9 {
        pos = pos + 1
      } else {
        break
      }
    }
    // chunk-ext-name = token (1*tchar)
    let name_s = pos
    while pos < end && tlut[buf[pos].to_int()] == 1 {
      pos = pos + 1
    }
    if pos == name_s {
      return Err(HttpError::InvalidChunkExtension)
    }
    // Skip BWS
    while pos < end {
      let b = buf[pos].to_int()
      if b == 32 || b == 9 {
        pos = pos + 1
      } else {
        break
      }
    }
    if pos < end && buf[pos].to_int() == 61 {
      pos = pos + 1 // skip '='
      // Skip BWS
      while pos < end {
        let b = buf[pos].to_int()
        if b == 32 || b == 9 {
          pos = pos + 1
        } else {
          break
        }
      }
      if pos >= end {
        return Err(HttpError::InvalidChunkExtension)
      }
      if buf[pos].to_int() == 34 {
        // quoted-string
        pos = pos + 1
        let mut closed = false
        while pos < end {
          let qb = buf[pos].to_int()
          if qb == 34 {
            pos = pos + 1
            closed = true
            break
          } else if qb == 92 {
            // quoted-pair: '\' (HTAB / SP / VCHAR / obs-text)
            pos = pos + 1
            if pos >= end {
              return Err(HttpError::InvalidChunkExtension)
            }
            let eb = buf[pos].to_int()
            if header_val_lut[eb] != 1 {
              return Err(HttpError::InvalidChunkExtension)
            }
            pos = pos + 1
          } else if header_val_lut[qb] == 1 {
            pos = pos + 1
          } else {
            return Err(HttpError::InvalidChunkExtension)
          }
        }
        if !closed {
          return Err(HttpError::InvalidChunkExtension)
        }
      } else {
        // token
        let vs = pos
        while pos < end && tlut[buf[pos].to_int()] == 1 {
          pos = pos + 1
        }
        if pos == vs {
          return Err(HttpError::InvalidChunkExtension)
        }
      }
    }
  }
  Ok(())
}

///| Parse a single RFC 9112 chunk-size line (`1*HEXDIG [ chunk-ext ] CRLF`).
pub fn parse_chunk_size_with_limits(
  buf : Bytes,
  start : Int,
  end : Int,
  limits : Limits,
) -> Result[ParseStatus[Int64], HttpError] {
  if start >= end {
    return Ok(ParseStatus::Partial)
  }
  let hlut = hex_lut
  let mut pos = start
  let mut size : Int64 = 0L
  let mut digits = 0
  let max_div16 : Int64 = 576460752303423487L // (INT64_MAX - 15) / 16
  while pos < end {
    let v = hlut[buf[pos].to_int()]
    if v >= 0 {
      if digits >= 16 {
        return Err(HttpError::InvalidChunkSize)
      }
      if size > max_div16 || (size == max_div16 && v > 15) {
        return Err(HttpError::ChunkTooLarge)
      }
      size = (size << 4) | v.to_int64()
      digits = digits + 1
      pos = pos + 1
    } else {
      break
    }
  }
  if digits == 0 {
    return Err(HttpError::InvalidChunkSize)
  }
  if pos >= end {
    return Ok(ParseStatus::Partial)
  }
  let b = buf[pos].to_int()
  if b == 13 {
    if pos + 1 >= end {
      return Ok(ParseStatus::Partial)
    }
    if buf[pos + 1].to_int() != 10 {
      return Err(HttpError::InvalidChunkTerminator)
    }
    if size > limits.max_chunk_size {
      return Err(HttpError::ChunkTooLarge)
    }
    return Ok(ParseStatus::Complete(size, pos + 2 - start))
  }
  if b == 10 {
    return Err(HttpError::BareCrOrLf)
  }
  if b != 59 && b != 32 && b != 9 {
    return Err(HttpError::InvalidChunkSize)
  }
  // Scan until CRLF for chunk extension
  let ext_start = pos
  while pos < end {
    let eb = buf[pos].to_int()
    if eb == 13 {
      if pos + 1 >= end {
        return Ok(ParseStatus::Partial)
      }
      if buf[pos + 1].to_int() != 10 {
        return Err(HttpError::InvalidChunkTerminator)
      }
      match validate_chunk_ext(buf, ext_start, pos, limits.max_chunk_ext_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if size > limits.max_chunk_size {
        return Err(HttpError::ChunkTooLarge)
      }
      return Ok(ParseStatus::Complete(size, pos + 2 - start))
    }
    if eb == 10 {
      return Err(HttpError::BareCrOrLf)
    }
    if (pos - ext_start).to_int64() > limits.max_chunk_ext_bytes {
      return Err(HttpError::InvalidChunkExtension)
    }
    pos = pos + 1
  }
  Ok(ParseStatus::Partial)
}

///|
pub fn parse_chunk_size(buf : Bytes) -> Result[ParseStatus[Int64], HttpError] {
  parse_chunk_size_with_limits(buf, 0, buf.length(), Limits::default())
}

///|
pub struct ChunkedDecoder {
  pub limits : Limits
  mut state : Int // 0=size, 1=data, 2=data_crlf, 3=trailers, 4=done
  mut chunk_rem : Int64
  mut cur : Bytes
  mut cur_pos : Int
  mut cur_len : Int
  mut queue : Array[Bytes]
  mut queue_head : Int
  mut pending_total : Int
  mut line_buf : Bytes
  mut line_len : Int
  mut trailers : Array[Header]
  mut trailer_bytes : Int64
  mut seen_cr : Bool
  empty_bytes : Bytes
}

///|
pub fn ChunkedDecoder::new() -> ChunkedDecoder {
  ChunkedDecoder::with_limits(Limits::default())
}

///|
pub fn ChunkedDecoder::with_limits(limits : Limits) -> ChunkedDecoder {
  let empty = Bytes::new(0)
  ChunkedDecoder::{
    limits: limits,
    state: 0,
    chunk_rem: 0L,
    cur: empty,
    cur_pos: 0,
    cur_len: 0,
    queue: [],
    queue_head: 0,
    pending_total: 0,
    line_buf: Bytes::new(256),
    line_len: 0,
    trailers: [],
    trailer_bytes: 0L,
    seen_cr: false,
    empty_bytes: empty,
  }
}

///|
pub fn ChunkedDecoder::reset(self : ChunkedDecoder) -> Unit {
  self.state = 0
  self.chunk_rem = 0L
  self.cur = self.empty_bytes
  self.cur_pos = 0
  self.cur_len = 0
  self.queue = []
  self.queue_head = 0
  self.pending_total = 0
  self.line_len = 0
  self.trailers = []
  self.trailer_bytes = 0L
  self.seen_cr = false
}

///|
pub fn ChunkedDecoder::is_done(self : ChunkedDecoder) -> Bool {
  self.state == 4
}

///|
pub fn ChunkedDecoder::remaining_bytes(self : ChunkedDecoder) -> Int {
  self.pending_total
}

///|
pub fn ChunkedDecoder::feed(self : ChunkedDecoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  if self.pending_total == 0 {
    self.cur = chunk
    self.cur_pos = 0
    self.cur_len = clen
    self.pending_total = clen
  } else {
    self.queue.push(chunk)
    self.pending_total = self.pending_total + clen
  }
}

///|
fn ChunkedDecoder::advance_chunk(self : ChunkedDecoder) -> Unit {
  if self.cur_pos >= self.cur_len {
    let q = self.queue
    let qlen = q.length()
    if self.queue_head < qlen {
      let next = q[self.queue_head]
      q[self.queue_head] = self.empty_bytes
      self.queue_head = self.queue_head + 1
      if self.queue_head == qlen {
        q.clear()
        self.queue_head = 0
      } else if self.queue_head >= 16 && self.queue_head * 2 >= qlen {
        let rem = qlen - self.queue_head
        let mut nq : Array[Bytes] = []
        let mut i = 0
        while i < rem {
          nq.push(q[self.queue_head + i])
          i = i + 1
        }
        self.queue = nq
        self.queue_head = 0
      }
      self.cur = next
      self.cur_pos = 0
      self.cur_len = next.length()
    } else {
      self.cur = self.empty_bytes
      self.cur_pos = 0
      self.cur_len = 0
    }
  }
}

///|
fn ChunkedDecoder::push_line_byte(self : ChunkedDecoder, b : Byte) -> Unit {
  let cap = self.line_buf.length()
  if self.line_len >= cap {
    let new_cap = if cap < 256 { 256 } else { cap * 2 }
    let mut nb = Bytes::new(new_cap)
    let mut i = 0
    while i < self.line_len {
      nb[i] = self.line_buf[i]
      i = i + 1
    }
    self.line_buf = nb
  }
  self.line_buf[self.line_len] = b
  self.line_len = self.line_len + 1
}

///|
pub fn ChunkedDecoder::take_remaining(self : ChunkedDecoder) -> Bytes {
  if self.pending_total == 0 {
    return Bytes::new(0)
  }
  let mut out = Bytes::new(self.pending_total)
  let mut off = 0
  while self.pending_total > 0 {
    let avail = self.cur_len - self.cur_pos
    let mut i = 0
    while i < avail {
      out[off + i] = self.cur[self.cur_pos + i]
      i = i + 1
    }
    off = off + avail
    self.pending_total = self.pending_total - avail
    self.cur_pos = self.cur_len
    self.advance_chunk()
  }
  out
}

///| Parse a single trailer header line (without trailing CRLF).
fn parse_trailer_line(buf : Bytes, len : Int) -> Result[Header, HttpError] {
  if len == 0 {
    return Err(HttpError::InvalidTrailer)
  }
  let b0 = buf[0].to_int()
  if b0 == 32 || b0 == 9 {
    return Err(HttpError::ObsFold)
  }
  let tlut = tchar_lut
  let vlut = header_val_lut
  let mut pos = 0
  while pos < len && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == 0 || pos >= len || buf[pos].to_int() != 58 {
    return Err(HttpError::InvalidTrailer)
  }
  let name_end = pos
  pos = pos + 1
  while pos < len {
    let b = buf[pos].to_int()
    if b == 32 || b == 9 {
      pos = pos + 1
    } else {
      break
    }
  }
  let val_start = pos
  while pos < len {
    if vlut[buf[pos].to_int()] != 1 {
      return Err(HttpError::InvalidTrailer)
    }
    pos = pos + 1
  }
  let mut val_end = len
  while val_end > val_start {
    let tb = buf[val_end - 1].to_int()
    if tb == 32 || tb == 9 {
      val_end = val_end - 1
    } else {
      break
    }
  }
  let hname = buf.slice(0, name_end).to_string()
  let hval = if val_end > val_start {
    buf.slice(val_start, val_end).to_string()
  } else {
    ""
  }
  Ok(Header::{ name: hname, value: hval })
}

///| Read bytes until `\r\n` into `line_buf` (excluding `\r\n`).
///| Returns: 1 = complete line in `line_buf[0..line_len]`, 0 = NeedMore, -1 = BareCrOrLf, -2 = TooLarge.
fn ChunkedDecoder::read_crlf_line(
  self : ChunkedDecoder,
  max_len : Int64,
) -> Int {
  while self.pending_total > 0 {
    let b = self.cur[self.cur_pos]
    let bi = b.to_int()
    self.cur_pos = self.cur_pos + 1
    self.pending_total = self.pending_total - 1
    if self.cur_pos >= self.cur_len {
      self.advance_chunk()
    }
    if self.seen_cr {
      self.seen_cr = false
      if bi == 10 {
        return 1
      }
      return -1
    }
    if bi == 13 {
      self.seen_cr = true
    } else if bi == 10 {
      return -1
    } else {
      if self.line_len.to_int64() >= max_len {
        return -2
      }
      self.push_line_byte(b)
    }
  }
  0
}

///|
pub fn ChunkedDecoder::next(
  self : ChunkedDecoder,
) -> Result[ChunkStep, HttpError] {
  while true {
    if self.state == 4 {
      return Ok(ChunkStep::Done(self.trailers))
    }
    if self.state == 0 {
      // Fast path: if line_len == 0 and !seen_cr and cur has complete size line
      if self.line_len == 0 && !self.seen_cr && self.cur_pos < self.cur_len {
        match parse_chunk_size_with_limits(
          self.cur,
          self.cur_pos,
          self.cur_len,
          self.limits,
        ) {
          Ok(ParseStatus::Complete(sz, consumed)) => {
            self.cur_pos = self.cur_pos + consumed
            self.pending_total = self.pending_total - consumed
            if self.cur_pos >= self.cur_len {
              self.advance_chunk()
            }
            if sz == 0L {
              self.state = 3
            } else {
              self.chunk_rem = sz
              self.state = 1
            }
            continue
          }
          Ok(ParseStatus::Partial) => ()
          Err(e) => return Err(e)
        }
      }
      let max_sz_line = self.limits.max_chunk_ext_bytes + 64L
      let rc = self.read_crlf_line(max_sz_line)
      if rc == 0 {
        if self.line_len > 16 {
          let mut all_hex = true
          let mut hi = 0
          while hi < 17 {
            if hex_lut[self.line_buf[hi].to_int()] < 0 {
              all_hex = false
              break
            }
            hi = hi + 1
          }
          if all_hex {
            return Err(HttpError::InvalidChunkSize)
          }
        }
        return Ok(ChunkStep::NeedMore)
      }
      if rc == -1 {
        return Err(HttpError::BareCrOrLf)
      }
      if rc == -2 {
        if self.line_len >= 17 {
          let mut all_hex = true
          let mut hi = 0
          while hi < 17 {
            if hex_lut[self.line_buf[hi].to_int()] < 0 {
              all_hex = false
              break
            }
            hi = hi + 1
          }
          if all_hex {
            return Err(HttpError::InvalidChunkSize)
          }
        }
        return Err(HttpError::InvalidChunkExtension)
      }
      // Append CRLF temporarily for parse_chunk_size_with_limits
      self.push_line_byte((13).to_byte())
      self.push_line_byte((10).to_byte())
      let llen = self.line_len
      self.line_len = 0
      match parse_chunk_size_with_limits(self.line_buf, 0, llen, self.limits) {
        Ok(ParseStatus::Complete(sz, _)) => {
          if sz == 0L {
            self.state = 3
          } else {
            self.chunk_rem = sz
            self.state = 1
          }
        }
        Ok(ParseStatus::Partial) => return Err(HttpError::InvalidChunkSize)
        Err(e) => return Err(e)
      }
    } else if self.state == 1 {
      if self.pending_total == 0 {
        return Ok(ChunkStep::NeedMore)
      }
      let avail = self.cur_len - self.cur_pos
      let take = if avail.to_int64() <= self.chunk_rem {
        avail
      } else {
        self.chunk_rem.to_int()
      }
      let slice = if self.cur_pos == 0 && take == self.cur_len {
        self.cur
      } else {
        self.cur.slice(self.cur_pos, self.cur_pos + take)
      }
      self.cur_pos = self.cur_pos + take
      self.pending_total = self.pending_total - take
      self.chunk_rem = self.chunk_rem - take.to_int64()
      if self.cur_pos >= self.cur_len {
        self.advance_chunk()
      }
      if self.chunk_rem == 0L {
        self.state = 2
      }
      return Ok(ChunkStep::Data(slice))
    } else if self.state == 2 {
      // Expect exact CRLF after chunk data
      while self.pending_total > 0 {
        let bi = self.cur[self.cur_pos].to_int()
        self.cur_pos = self.cur_pos + 1
        self.pending_total = self.pending_total - 1
        if self.cur_pos >= self.cur_len {
          self.advance_chunk()
        }
        if !self.seen_cr {
          if bi != 13 {
            return Err(HttpError::InvalidChunkTerminator)
          }
          self.seen_cr = true
        } else {
          self.seen_cr = false
          if bi != 10 {
            return Err(HttpError::InvalidChunkTerminator)
          }
          self.state = 0
          break
        }
      }
      if self.state == 2 {
        return Ok(ChunkStep::NeedMore)
      }
    } else if self.state == 3 {
      let rc = self.read_crlf_line(self.limits.max_header_bytes)
      if rc == 0 {
        return Ok(ChunkStep::NeedMore)
      }
      if rc == -1 {
        return Err(HttpError::BareCrOrLf)
      }
      if rc == -2 {
        return Err(HttpError::HeaderTooLarge)
      }
      let llen = self.line_len
      self.line_len = 0
      if llen == 0 {
        self.state = 4
        return Ok(ChunkStep::Done(self.trailers))
      }
      if self.trailers.length() >= self.limits.max_trailers {
        return Err(HttpError::TooManyTrailers)
      }
      self.trailer_bytes = self.trailer_bytes + llen.to_int64() + 2L
      if self.trailer_bytes > self.limits.max_header_bytes {
        return Err(HttpError::HeaderTooLarge)
      }
      match parse_trailer_line(self.line_buf, llen) {
        Ok(h) => self.trailers.push(h)
        Err(e) => return Err(e)
      }
    }
  }
  Ok(ChunkStep::NeedMore)
}
