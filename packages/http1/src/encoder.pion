///| RFC 9112 HTTP/1.1 Request, Response, and Chunked encoder with strict CRLF/NUL injection defense.

///|
fn check_no_crlf_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn validate_token_str(s : String, on_other_err : HttpError) -> Result[Unit, HttpError] {
  let n = s.length()
  if n == 0 {
    return Err(on_other_err)
  }
  let tlut = tchar_lut
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return Err(HttpError::CrlfInjection)
    }
    if c > 255 || tlut[c] != 1 {
      return Err(on_other_err)
    }
    i = i + 1
  }
  Ok(())
}

///|
fn validate_uri_str(s : String) -> Result[Unit, HttpError] {
  let n = s.length()
  if n == 0 {
    return Err(HttpError::InvalidUri)
  }
  let ulut = uri_lut
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return Err(HttpError::CrlfInjection)
    }
    if c > 255 || ulut[c] != 1 {
      return Err(HttpError::InvalidUri)
    }
    i = i + 1
  }
  Ok(())
}

///|
fn validate_header_value_str(
  s : String,
  on_other_err : HttpError,
) -> Result[Unit, HttpError] {
  let b = s.to_bytes()
  let n = b.length()
  let vlut = header_val_lut
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    if v == 13 || v == 10 || v == 0 {
      return Err(HttpError::CrlfInjection)
    }
    if vlut[v] != 1 {
      return Err(on_other_err)
    }
    i = i + 1
  }
  Ok(())
}

///|
pub fn encode_request(
  method : String,
  path : String,
  version : Version,
  headers : Array[Header],
) -> Result[Bytes, HttpError] {
  match validate_token_str(method, HttpError::InvalidMethod) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_uri_str(path) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  sb.write_string(method)
  sb.write_string(" ")
  sb.write_string(path)
  sb.write_string(" ")
  sb.write_string(version_to_string(version))
  sb.write_string("\r\n")
  let mut i = 0
  let n = headers.length()
  while i < n {
    let h = headers[i]
    match validate_token_str(h.name, HttpError::InvalidHeaderName) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_header_value_str(h.value, HttpError::InvalidHeaderValue) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(h.name)
    sb.write_string(": ")
    sb.write_string(h.value)
    sb.write_string("\r\n")
    i = i + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}

///|
pub fn encode_response(
  version : Version,
  status : Int,
  reason : String,
  headers : Array[Header],
) -> Result[Bytes, HttpError] {
  if status < 100 || status > 999 {
    return Err(HttpError::InvalidStatus)
  }
  if !check_no_crlf_nul(reason) {
    return Err(HttpError::CrlfInjection)
  }
  match validate_header_value_str(reason, HttpError::InvalidReason) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  sb.write_string(version_to_string(version))
  sb.write_string(" ")
  sb.write_string(status.to_string())
  if reason.length() > 0 {
    sb.write_string(" ")
    sb.write_string(reason)
  }
  sb.write_string("\r\n")
  let mut i = 0
  let n = headers.length()
  while i < n {
    let h = headers[i]
    match validate_token_str(h.name, HttpError::InvalidHeaderName) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_header_value_str(h.value, HttpError::InvalidHeaderValue) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(h.name)
    sb.write_string(": ")
    sb.write_string(h.value)
    sb.write_string("\r\n")
    i = i + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}

///| Encode a non-empty chunk (`<hex>\r\n<data>\r\n`). Empty `data` returns empty `Bytes`.
pub fn encode_chunk(data : Bytes) -> Bytes {
  let dlen = data.length()
  if dlen == 0 {
    return Bytes::new(0)
  }
  // Format hex length into small temp FixedArray[Byte]
  let hex_digits : FixedArray[Byte] = FixedArray::make(16, (48).to_byte())
  let hbytes = hex_lower_bytes
  let mut v = dlen
  let mut hlen = 0
  while v > 0 {
    hex_digits[hlen] = hbytes[v & 0xF]
    v = v >> 4
    hlen = hlen + 1
  }
  let total = hlen + 2 + dlen + 2
  let mut out = Bytes::new(total)
  let mut i = 0
  while i < hlen {
    out[i] = hex_digits[hlen - 1 - i]
    i = i + 1
  }
  out[hlen] = (13).to_byte()
  out[hlen + 1] = (10).to_byte()
  let off = hlen + 2
  let mut j = 0
  while j <= dlen - 4 {
    out[off + j] = data[j]
    out[off + j + 1] = data[j + 1]
    out[off + j + 2] = data[j + 2]
    out[off + j + 3] = data[j + 3]
    j = j + 4
  }
  while j < dlen {
    out[off + j] = data[j]
    j = j + 1
  }
  out[off + dlen] = (13).to_byte()
  out[off + dlen + 1] = (10).to_byte()
  out
}

///| Encode the terminating zero chunk plus optional trailers (`0\r\n[trailers]\r\n`).
pub fn encode_final_chunk(trailers : Array[Header]) -> Result[Bytes, HttpError] {
  let sb = StringBuilder::new()
  sb.write_string("0\r\n")
  let mut i = 0
  let n = trailers.length()
  while i < n {
    let h = trailers[i]
    match validate_token_str(h.name, HttpError::InvalidTrailer) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_header_value_str(h.value, HttpError::InvalidTrailer) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(h.name)
    sb.write_string(": ")
    sb.write_string(h.value)
    sb.write_string("\r\n")
    i = i + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}
