///| RFC 9112 HTTP/1.1 Request, Response, and Chunked encoder (Red-phase stubs).

///|
pub fn encode_request(
  method : String,
  path : String,
  version : Version,
  headers : Array[Header],
) -> Result[Bytes, HttpError] {
  let _ = method
  let _ = path
  let _ = version
  let _ = headers
  Err(HttpError::InvalidMethod)
}

///|
pub fn encode_response(
  version : Version,
  status : Int,
  reason : String,
  headers : Array[Header],
) -> Result[Bytes, HttpError] {
  let _ = version
  let _ = status
  let _ = reason
  let _ = headers
  Err(HttpError::InvalidStatus)
}

///|
pub fn encode_chunk(data : Bytes) -> Bytes {
  let _ = data
  Bytes::new(0)
}

///|
pub fn encode_final_chunk(trailers : Array[Header]) -> Result[Bytes, HttpError] {
  let _ = trailers
  Err(HttpError::InvalidTrailer)
}
