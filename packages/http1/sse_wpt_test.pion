///| WHATWG HTML §9.2.6 / WPT EventSource (SSE) official compliance & streaming tests.

///|
fn sse_feed_all(chunks : Array[Bytes]) -> Result[Array[SseEvent], HttpError] {
  let dec = SseDecoder::new()
  let all : Array[SseEvent] = []
  let mut i = 0
  while i < chunks.length() {
    match dec.feed(chunks[i]) {
      Ok(evts) => {
        let mut j = 0
        while j < evts.length() {
          all.push(evts[j])
          j = j + 1
        }
      }
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  match dec.finish() {
    Ok(evts) => {
      let mut j = 0
      while j < evts.length() {
        all.push(evts[j])
        j = j + 1
      }
    }
    Err(e) => return Err(e)
  }
  Ok(all)
}

///|
fn sse_events_eq(a : Array[SseEvent], b : Array[SseEvent]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].event_type != b[i].event_type ||
    a[i].data != b[i].data ||
    a[i].last_event_id != b[i].last_event_id ||
    !opt_i64_eq(a[i].retry, b[i].retry) {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "sse_basic_and_multiline_data" {
  let raw = "data: YHOO\ndata: +2\ndata: 10\n\n".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "1 event")
      debug_assert(evts[0].event_type == "message", "default event type message")
      debug_assert(evts[0].data == "YHOO\n+2\n10", "multiline data joined with LF")
      debug_assert(evts[0].last_event_id == "", "empty id")
      debug_assert(opt_i64_eq(evts[0].retry, None), "no retry")
    }
    Err(_) => debug_assert(false, "basic sse failed")
  }
}

///|
test "sse_empty_data_variants_wpt" {
  // WHATWG §9.2.6 example: `data\n\ndata\ndata\n\ndata:`
  let raw = "data\n\ndata\ndata\n\ndata:".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 2, "2 events (3rd has no blank line)")
      debug_assert(evts[0].data == "", "first event empty string")
      debug_assert(evts[1].data == "\n", "second event single LF")
    }
    Err(_) => debug_assert(false, "empty data variants failed")
  }
}

///|
test "sse_no_data_suppresses_dispatch_and_resets_event_type" {
  let raw = "event: custom\n\ndata: after\n\n".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "only 1 event dispatched")
      debug_assert(evts[0].event_type == "message", "event type reset after empty block")
      debug_assert(evts[0].data == "after", "data after")
    }
    Err(_) => debug_assert(false, "no-data suppression failed")
  }
}

///|
test "sse_custom_event_and_single_leading_space_strip" {
  let raw = "event: update\ndata:  two leading spaces\ndata:\ttab preserved\ndata:no space\n\n".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "1 event")
      debug_assert(evts[0].event_type == "update", "event update")
      debug_assert(evts[0].data == " two leading spaces\n\ttab preserved\nno space", "exact leading space rule")
    }
    Err(_) => debug_assert(false, "leading space test failed")
  }
}

///|
test "sse_comments_and_unknown_fields_ignored" {
  let raw = ": this is a comment\n:another comment\nunknown: ignored\ndata: ok\n:\n\n".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "1 event")
      debug_assert(evts[0].data == "ok", "data ok")
    }
    Err(_) => debug_assert(false, "comments test failed")
  }
}

///|
test "sse_wpt_line_endings_lf_cr_crlf" {
  let raw = "data: a\r\n\r\ndata: b\r\rdata: c\n\ndata: d\r\n\ndata: e\n\r\n".to_bytes()
  match sse_feed_all([raw]) {
    Ok(evts) => {
      debug_assert(evts.length() == 5, "5 events across LF/CR/CRLF")
      debug_assert(evts[0].data == "a", "a")
      debug_assert(evts[1].data == "b", "b")
      debug_assert(evts[2].data == "c", "c")
      debug_assert(evts[3].data == "d", "d")
      debug_assert(evts[4].data == "e", "e")
    }
    Err(_) => debug_assert(false, "line endings failed")
  }
}

///|
test "sse_cross_chunk_cr_lf_merged" {
  // CR at end of chunk 0 + LF at start of chunk 1 is ONE newline, NOT two!
  let chunks = [
    "data: first\r".to_bytes(),
    "\ndata: second\r".to_bytes(),
    "\n\r".to_bytes(),
    "\ndata: third\r".to_bytes(),
    "\n\n".to_bytes(),
  ]
  match sse_feed_all(chunks) {
    Ok(evts) => {
      debug_assert(evts.length() == 2, "2 events (first+second merged, then third)")
      debug_assert(evts[0].data == "first\nsecond", "CR+LF across chunks merged into 1 newline")
      debug_assert(evts[1].data == "third", "third")
    }
    Err(_) => debug_assert(false, "cross-chunk CRLF failed")
  }
}

///|
test "sse_utf8_bom_stripping_whole_and_split" {
  // Single chunk with UTF-8 BOM (EF BB BF)
  let bom_prefix = bytes_from_ints([0xEF, 0xBB, 0xBF])
  let body = "data: hello\n\n".to_bytes()
  let mut full = Bytes::new(3 + body.length())
  full[0] = (0xEF).to_byte()
  full[1] = (0xBB).to_byte()
  full[2] = (0xBF).to_byte()
  let mut i = 0
  while i < body.length() {
    full[3 + i] = body[i]
    i = i + 1
  }
  match sse_feed_all([full]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1 && evts[0].data == "hello", "whole BOM stripped")
    }
    Err(_) => debug_assert(false, "whole BOM failed")
  }
  // Split 1-byte BOM across 3 chunks
  let b0 = bytes_from_ints([0xEF])
  let b1 = bytes_from_ints([0xBB])
  let b2 = bytes_from_ints([0xBF])
  match sse_feed_all([b0, b1, b2, body]) {
    Ok(evts) => {
      debug_assert(evts.length() == 1 && evts[0].data == "hello", "split BOM stripped")
    }
    Err(_) => debug_assert(false, "split BOM failed")
  }
  // Partial non-BOM starting with 0xEF 0xBB 0x00 is NOT stripped
  let _ = bom_prefix
  // Second BOM after first BOM is NOT stripped (treated as unknown field name "\u{FEFF}data")
  let mut double_bom = Bytes::new(6 + body.length())
  double_bom[0] = (0xEF).to_byte()
  double_bom[1] = (0xBB).to_byte()
  double_bom[2] = (0xBF).to_byte()
  double_bom[3] = (0xEF).to_byte()
  double_bom[4] = (0xBB).to_byte()
  double_bom[5] = (0xBF).to_byte()
  let mut j = 0
  while j < body.length() {
    double_bom[6 + j] = body[j]
    j = j + 1
  }
  match sse_feed_all([double_bom]) {
    Ok(evts) => debug_assert(evts.length() == 0, "second BOM not stripped so field is unknown")
    Err(_) => debug_assert(false, "double BOM failed")
  }
}

///|
test "sse_wpt_id_persistence_clear_and_nul_ignored" {
  // Event 1 sets id=10; Event 2 has no id -> inherits 10; Event 3 has id with NUL -> ignored (stays 10);
  // Event 4 has bare `id` -> clears to ""
  let p1 = "id: 10\ndata: one\n\ndata: two\n\nid: bad".to_bytes()
  let nul = bytes_from_ints([0])
  let p2 = "id\ndata: three\n\nid\ndata: four\n\n".to_bytes()
  match sse_feed_all([p1, nul, p2]) {
    Ok(evts) => {
      debug_assert(evts.length() == 4, "4 events")
      debug_assert(evts[0].last_event_id == "10", "e0 id 10")
      debug_assert(evts[1].last_event_id == "10", "e1 inherits id 10")
      debug_assert(evts[2].last_event_id == "10", "e2 NUL id ignored, stays 10")
      debug_assert(evts[3].last_event_id == "", "e3 bare id clears to empty")
    }
    Err(_) => debug_assert(false, "id test failed")
  }
}

///|
test "sse_wpt_retry_parsing" {
  let raw = "retry: 3000\ndata: a\n\nretry: invalid\ndata: b\n\nretry: -5\ndata: c\n\nretry: +5\ndata: d\n\nretry: 0\ndata: e\n\nretry: 99999999999999999999999999\ndata: f\n\n".to_bytes()
  let dec = SseDecoder::new()
  match dec.feed(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 6, "6 events")
      debug_assert(opt_i64_eq(evts[0].retry, Some(3000L)), "valid retry 3000")
      debug_assert(opt_i64_eq(evts[1].retry, Some(3000L)), "invalid retry ignored, keeps 3000")
      debug_assert(opt_i64_eq(evts[2].retry, Some(3000L)), "negative retry ignored")
      debug_assert(opt_i64_eq(evts[3].retry, Some(3000L)), "plus retry ignored")
      debug_assert(opt_i64_eq(evts[4].retry, Some(0L)), "zero retry valid")
      debug_assert(opt_i64_eq(evts[5].retry, Some(0L)), "overflow retry ignored")
      debug_assert(opt_i64_eq(dec.retry(), Some(0L)), "decoder retry is 0")
    }
    Err(_) => debug_assert(false, "retry test failed")
  }
}

///|
test "sse_one_byte_drip_equals_whole_buffer" {
  let body = ": llm stream\nevent: content_block_delta\nid: msg_01\nretry: 1500\ndata: {\"delta\":\"\u{4F60}\u{597D}\"}\r\n\r\nevent: content_block_delta\rdata: line1\rdata:  line2\r\rdata: final\n\n".to_bytes()
  let mut full = Bytes::new(3 + body.length())
  full[0] = (0xEF).to_byte()
  full[1] = (0xBB).to_byte()
  full[2] = (0xBF).to_byte()
  let mut i = 0
  while i < body.length() {
    full[3 + i] = body[i]
    i = i + 1
  }
  let whole = match sse_feed_all([full]) {
    Ok(e) => e
    Err(_) => {
      debug_assert(false, "whole sse failed")
      []
    }
  }
  debug_assert(whole.length() == 3, "3 events")
  let sizes = [1, 2, 3, 5, 11]
  let mut si = 0
  while si < sizes.length() {
    match sse_feed_all(split_bytes(full, sizes[si])) {
      Ok(evts) => debug_assert(sse_events_eq(evts, whole), "drip eq step " + sizes[si].to_string())
      Err(_) => debug_assert(false, "drip failed at step " + sizes[si].to_string())
    }
    si = si + 1
  }
}

///|
test "sse_limits_line_and_event_too_large" {
  let lim = Limits::{
    max_headers: 100,
    max_header_bytes: 65536L,
    max_uri_bytes: 8192L,
    max_chunk_size: 67108864L,
    max_chunk_ext_bytes: 4096L,
    max_trailers: 64,
    max_sse_event_bytes: 20L,
    max_sse_line_bytes: 12L,
  }
  let dec1 = SseDecoder::with_limits(lim)
  match dec1.feed("data: 123456789012345\n\n".to_bytes()) {
    Err(HttpError::SseLineTooLarge) => ()
    _ => debug_assert(false, "expected SseLineTooLarge")
  }
  let dec2 = SseDecoder::with_limits(lim)
  match dec2.feed("data: 12345\ndata: 12345\ndata: 12345\ndata: 12345\n\n".to_bytes()) {
    Err(HttpError::SseEventTooLarge) => ()
    _ => debug_assert(false, "expected SseEventTooLarge")
  }
}
