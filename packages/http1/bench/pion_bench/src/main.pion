///| Pion Native head-to-head benchmark for packages/http1:
///| Modes: "req" | "resp_chunked" | "sse"

import "http1"

///|
fn hash_str(h : Int64, s : String) -> Int64 {
  let mut acc = h
  let n = s.length()
  let mut i = 0
  while i < n {
    acc = (acc * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  acc
}

///|
fn hash_bytes(h : Int64, b : Bytes) -> Int64 {
  let mut acc = h
  let n = b.length()
  let mut i = 0
  while i < n {
    acc = (acc * 131L + b[i].to_int().to_int64()) % 1000000007L
    i = i + 1
  }
  acc
}

///|
fn bench_req(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = http1::Limits::default()
  let mut count : Int64 = 0L
  let mut total_headers : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut round = 0
  while round < 4 {
    let mut pos = 0
    while pos < dlen {
      match http1::parse_request_at(data, pos, dlen, lim) {
        Ok(http1::ParseStatus::Complete(req, consumed)) => {
          count = count + 1L
          total_headers = total_headers + req.headers.length().to_int64()
          total_bytes = total_bytes + consumed.to_int64()
          hash = hash_str(hash, req.method)
          hash = hash_str(hash, req.path)
          match req.header("host") {
            Some(v) => hash = hash_str(hash, v)
            None => ()
          }
          match req.header("x-request-id") {
            Some(v) => hash = hash_str(hash, v)
            None => ()
          }
          pos = pos + consumed
        }
        _ => {
          io_println(world, "req parse error at " + pos.to_string())
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=req")
  io_println(world, "count=" + count.to_string())
  io_println(world, "headers=" + total_headers.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn bench_resp_chunked(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = http1::Limits::default()
  let mut count : Int64 = 0L
  let mut total_body : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut round = 0
  while round < 4 {
    let mut pos = 0
    while pos < dlen {
      match http1::parse_response_at(data, pos, dlen, lim) {
        Ok(http1::ParseStatus::Complete(resp, consumed)) => {
          count = count + 1L
          hash = (hash * 131L + resp.status.to_int64()) % 1000000007L
          match resp.header("content-type") {
            Some(v) => hash = hash_str(hash, v)
            None => ()
          }
          pos = pos + consumed
          // Decode chunked body directly using parse_chunk_size_with_limits
          while true {
            match http1::parse_chunk_size_with_limits(data, pos, dlen, lim) {
              Ok(http1::ParseStatus::Complete(sz, sz_consumed)) => {
                pos = pos + sz_consumed
                if sz == 0L {
                  // Expect terminating CRLF
                  if pos + 2 <= dlen &&
                  data[pos].to_int() == 13 &&
                  data[pos + 1].to_int() == 10 {
                    pos = pos + 2
                    break
                  } else {
                    io_println(world, "chunked final crlf error")
                    return 1
                  }
                }
                let n = sz.to_int()
                total_body = total_body + sz
                let mut k = 0
                while k < n {
                  hash = (hash * 131L + data[pos + k].to_int().to_int64()) %
                  1000000007L
                  k = k + 1
                }
                pos = pos + n
                if pos + 2 <= dlen &&
                data[pos].to_int() == 13 &&
                data[pos + 1].to_int() == 10 {
                  pos = pos + 2
                } else {
                  io_println(world, "chunked data crlf error")
                  return 1
                }
              }
              _ => {
                io_println(world, "chunk size error at " + pos.to_string())
                return 1
              }
            }
          }
        }
        _ => {
          io_println(world, "resp parse error at " + pos.to_string())
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "mode=resp_chunked")
  io_println(world, "count=" + count.to_string())
  io_println(world, "body_bytes=" + total_body.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn bench_sse(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let mut events : Int64 = 0L
  let mut data_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  // Pre-slice into 4 KiB network chunks
  let chunks : Array[Bytes] = []
  let mut off = 0
  while off < dlen {
    let e = if off + 4096 < dlen { off + 4096 } else { dlen }
    chunks.push(data.slice(off, e))
    off = e
  }
  let nchunks = chunks.length()
  let mut round = 0
  while round < 2 {
    let dec = http1::SseDecoder::new()
    let mut ci = 0
    while ci < nchunks {
      match dec.feed(chunks[ci]) {
        Ok(evts) => {
          let mut j = 0
          let en = evts.length()
          while j < en {
            let ev = evts[j]
            events = events + 1L
            data_bytes = data_bytes + ev.data.length().to_int64()
            hash = hash_str(hash, ev.event_type)
            hash = hash_str(hash, ev.last_event_id)
            hash = hash_str(hash, ev.data)
            j = j + 1
          }
        }
        Err(_) => {
          io_println(world, "sse decode error")
          return 1
        }
      }
      ci = ci + 1
    }
    let _ = dec.finish()
    round = round + 1
  }
  io_println(world, "mode=sse")
  io_println(world, "events=" + events.to_string())
  io_println(world, "data_bytes=" + data_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: http1_bench <req|resp_chunked|sse> <file>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let content = match fs_read(world, path) {
    Ok(s) => s.to_bytes()
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let _ = hash_bytes
  if mode == "req" {
    bench_req(world, content)
  } else if mode == "resp_chunked" {
    bench_resp_chunked(world, content)
  } else if mode == "sse" {
    bench_sse(world, content)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
