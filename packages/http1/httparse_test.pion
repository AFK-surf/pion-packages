///| Ported Rust `httparse` official compliance & unit tests for HTTP/1.1 requests,
///| responses, partial incremental parsing, chunked sizes, and encoding roundtrips.

///|
fn bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
fn opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
fn is_err_req(r : Result[ParseStatus[Request], HttpError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

///|
fn is_err_resp(r : Result[ParseStatus[Response], HttpError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

///|
test "httparse_request_simple" {
  let raw = "GET / HTTP/1.0\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw.length(), "consumed full buffer")
      debug_assert(req.method == "GET", "method GET")
      debug_assert(req.path == "/", "path /")
      debug_assert(version_eq(req.version, Version::Http10), "HTTP/1.0")
      debug_assert(req.headers.length() == 0, "0 headers")
      debug_assert(opt_i64_eq(req.content_length(), None), "no content-length")
      debug_assert(!req.is_chunked(), "not chunked")
    }
    _ => debug_assert(false, "expected Complete request")
  }
}

///|
test "httparse_request_http10" {
  let raw = "HEAD /status HTTP/1.0\r\nHost: example.com\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw.length(), "consumed")
      debug_assert(req.method == "HEAD", "method HEAD")
      debug_assert(req.path == "/status", "path /status")
      debug_assert(version_eq(req.version, Version::Http10), "HTTP/1.0")
      debug_assert(req.headers.length() == 1, "1 header")
      debug_assert(opt_str_eq(req.header("host"), Some("example.com")), "host header")
    }
    _ => debug_assert(false, "expected Complete HTTP/1.0 request")
  }
}

///|
test "httparse_request_headers" {
  let raw = "GET /index.html?a=1&b=2 HTTP/1.1\r\nHost: foo.com\r\nCookie: a=1; b=2\r\nUser-Agent: pion/0.1\r\nContent-Length: 42\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw.length(), "consumed")
      debug_assert(req.method == "GET", "method")
      debug_assert(req.path == "/index.html?a=1&b=2", "path")
      debug_assert(req.headers.length() == 4, "4 headers")
      debug_assert(req.headers[0].name == "Host", "h0 name")
      debug_assert(req.headers[0].value == "foo.com", "h0 val")
      debug_assert(req.headers[1].name == "Cookie", "h1 name")
      debug_assert(req.headers[1].value == "a=1; b=2", "h1 val")
      debug_assert(req.headers[2].name == "User-Agent", "h2 name")
      debug_assert(req.headers[2].value == "pion/0.1", "h2 val")
      debug_assert(opt_i64_eq(req.content_length(), Some(42L)), "content-length 42")
    }
    _ => debug_assert(false, "expected Complete request with headers")
  }
}

///|
test "httparse_request_headers_max_limit" {
  let raw = "GET / HTTP/1.1\r\nHost: a\r\nB: 2\r\nC: 3\r\n\r\n".to_bytes()
  let lim_ok = Limits::{
    max_headers: 3,
    max_header_bytes: 65536L,
    max_uri_bytes: 8192L,
    max_chunk_size: 67108864L,
    max_chunk_ext_bytes: 4096L,
    max_trailers: 64,
    max_sse_event_bytes: 1048576L,
    max_sse_line_bytes: 262144L,
  }
  match parse_request_with_limits(raw, lim_ok) {
    Ok(ParseStatus::Complete(req, _)) => debug_assert(req.headers.length() == 3, "exact 3 headers ok")
    _ => debug_assert(false, "exact max_headers should succeed")
  }
  let lim_fail = Limits::{
    max_headers: 2,
    max_header_bytes: 65536L,
    max_uri_bytes: 8192L,
    max_chunk_size: 67108864L,
    max_chunk_ext_bytes: 4096L,
    max_trailers: 64,
    max_sse_event_bytes: 1048576L,
    max_sse_line_bytes: 262144L,
  }
  match parse_request_with_limits(raw, lim_fail) {
    Err(HttpError::TooManyHeaders) => ()
    _ => debug_assert(false, "exceeding max_headers must return TooManyHeaders")
  }
}

///|
test "httparse_request_header_ows_trimming_and_empty" {
  let raw = "GET / HTTP/1.1\r\nHost: example.com\r\nX-Spaces:   \t hello \t world \t  \r\nX-Empty:\r\nX-Empty-Spaces:   \t \r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, _)) => {
      debug_assert(opt_str_eq(req.header("x-spaces"), Some("hello \t world")), "OWS trimmed, inner preserved")
      debug_assert(opt_str_eq(req.header("x-empty"), Some("")), "empty header value")
      debug_assert(opt_str_eq(req.header("x-empty-spaces"), Some("")), "whitespace-only header value trimmed to empty")
    }
    _ => debug_assert(false, "expected Complete")
  }
}

///|
test "httparse_request_header_obstext_utf8" {
  let raw = "GET / HTTP/1.1\r\nHost: example.com\r\nX-Note: caf\u{00E9} \u{65E5}\u{672C}\u{8A9E}\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, _)) => {
      debug_assert(opt_str_eq(req.header("X-Note"), Some("caf\u{00E9} \u{65E5}\u{672C}\u{8A9E}")), "obs-text preserved")
    }
    _ => debug_assert(false, "obs-text in header value should be allowed per RFC 9110")
  }
}

///|
test "httparse_request_case_insensitive_header_lookup" {
  let raw = "GET / HTTP/1.1\r\nHost: example.com\r\nX-Multi: first\r\nx-multi: second\r\nX-MULTI: third\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, _)) => {
      debug_assert(opt_str_eq(req.header("x-multi"), Some("first")), "first match")
      debug_assert(opt_str_eq(req.header("X-MULTI"), Some("first")), "case insensitive")
      debug_assert(opt_str_eq(req.header("missing"), None), "missing header")
      let all = req.headers_named("X-mUlTi")
      debug_assert(all.length() == 3, "3 matches")
      debug_assert(all[0] == "first" && all[1] == "second" && all[2] == "third", "all values in order")
    }
    _ => debug_assert(false, "expected Complete")
  }
}

///|
test "httparse_request_partial_every_byte_boundary" {
  let raw = "POST /api/v1/items HTTP/1.1\r\nHost: api.example.com\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n".to_bytes()
  let n = raw.length()
  let mut k = 0
  while k < n {
    let prefix = raw.slice(0, k)
    match parse_request(prefix) {
      Ok(ParseStatus::Partial) => ()
      _ => debug_assert(false, "prefix of len " + k.to_string() + " must be Partial")
    }
    k = k + 1
  }
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == n, "full consumed")
      debug_assert(req.is_chunked(), "chunked framing")
    }
    _ => debug_assert(false, "full buffer must be Complete")
  }
}

///|
test "httparse_request_trailing_body_not_consumed" {
  let head = "POST /submit HTTP/1.1\r\nHost: a.com\r\nContent-Length: 5\r\n\r\n"
  let full = (head + "helloEXTRA").to_bytes()
  match parse_request(full) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == head.to_bytes().length(), "consumed stops at end of headers")
      debug_assert(opt_i64_eq(req.content_length(), Some(5L)), "CL 5")
      debug_assert(full.slice(consumed, full.length()).to_string() == "helloEXTRA", "body untouched")
    }
    _ => debug_assert(false, "expected Complete")
  }
}

///|
test "httparse_request_custom_tchar_method" {
  let raw = "M-SEARCH * HTTP/1.1\r\nHost: 239.255.255.250:1900\r\n\r\n".to_bytes()
  match parse_request(raw) {
    Ok(ParseStatus::Complete(req, _)) => {
      debug_assert(req.method == "M-SEARCH", "custom token method")
      debug_assert(req.path == "*", "asterisk-form target")
    }
    _ => debug_assert(false, "expected Complete")
  }
}

///|
test "httparse_request_invalid_method_and_uri_and_version" {
  debug_assert(is_err_req(parse_request(" / HTTP/1.1\r\n\r\n".to_bytes())), "empty method")
  debug_assert(is_err_req(parse_request("G@T / HTTP/1.1\r\n\r\n".to_bytes())), "non-tchar @ in method")
  debug_assert(is_err_req(parse_request("GET  / HTTP/1.1\r\n\r\n".to_bytes())), "double space after method")
  debug_assert(is_err_req(parse_request("GET /  HTTP/1.1\r\n\r\n".to_bytes())), "double space after uri")
  debug_assert(is_err_req(parse_request("GET /a b HTTP/1.1\r\n\r\n".to_bytes())), "space in uri")
  debug_assert(is_err_req(parse_request("GET / HTTP/0.9\r\n\r\n".to_bytes())), "HTTP/0.9 rejected")
  debug_assert(is_err_req(parse_request("GET / HTTP/1.2\r\n\r\n".to_bytes())), "HTTP/1.2 rejected")
  debug_assert(is_err_req(parse_request("GET / HTTP/2.0\r\n\r\n".to_bytes())), "HTTP/2.0 rejected")
  debug_assert(is_err_req(parse_request("GET / http/1.1\r\n\r\n".to_bytes())), "lowercase http rejected")
  debug_assert(is_err_req(parse_request("GET / HTTP/1.11\r\n\r\n".to_bytes())), "extra digit version rejected")
  debug_assert(is_err_req(parse_request("GET /\u{00E9} HTTP/1.1\r\n\r\n".to_bytes())), "non-ASCII in URI rejected")
}

///|
test "httparse_request_uri_and_header_size_limits" {
  let lim = Limits::{
    max_headers: 100,
    max_header_bytes: 32L,
    max_uri_bytes: 8L,
    max_chunk_size: 67108864L,
    max_chunk_ext_bytes: 4096L,
    max_trailers: 64,
    max_sse_event_bytes: 1048576L,
    max_sse_line_bytes: 262144L,
  }
  match parse_request_with_limits("GET /123456789 HTTP/1.1\r\n\r\n".to_bytes(), lim) {
    Err(HttpError::UriTooLarge) => ()
    _ => debug_assert(false, "expected UriTooLarge")
  }
  // Partial buffer exceeding max_header_bytes must fail immediately (DoS protection)
  match parse_request_with_limits("GET / HTTP/1.1\r\nX-Long-Header: 12345678901234567890".to_bytes(), lim) {
    Err(HttpError::HeaderTooLarge) => ()
    _ => debug_assert(false, "expected HeaderTooLarge even on partial input")
  }
}

///|
test "httparse_response_simple" {
  let raw = "HTTP/1.1 200 OK\r\n\r\n".to_bytes()
  match parse_response(raw) {
    Ok(ParseStatus::Complete(resp, consumed)) => {
      debug_assert(consumed == raw.length(), "consumed")
      debug_assert(version_eq(resp.version, Version::Http11), "HTTP/1.1")
      debug_assert(resp.status == 200, "status 200")
      debug_assert(resp.reason == "OK", "reason OK")
      debug_assert(resp.headers.length() == 0, "0 headers")
    }
    _ => debug_assert(false, "expected Complete response")
  }
}

///|
test "httparse_response_http10_and_reason_variants" {
  let r1 = "HTTP/1.0 404 Not Found\r\nServer: test\r\n\r\n".to_bytes()
  match parse_response(r1) {
    Ok(ParseStatus::Complete(resp, _)) => {
      debug_assert(version_eq(resp.version, Version::Http10), "HTTP/1.0")
      debug_assert(resp.status == 404, "404")
      debug_assert(resp.reason == "Not Found", "Not Found")
      debug_assert(opt_str_eq(resp.header("server"), Some("test")), "Server header")
    }
    _ => debug_assert(false, "expected Complete HTTP/1.0 response")
  }
  // Empty reason phrase with trailing space
  let r2 = "HTTP/1.1 204 \r\n\r\n".to_bytes()
  match parse_response(r2) {
    Ok(ParseStatus::Complete(resp, _)) => {
      debug_assert(resp.status == 204, "204")
      debug_assert(resp.reason == "", "empty reason")
    }
    _ => debug_assert(false, "expected Complete 204 with space")
  }
  // Empty reason phrase without trailing space (RFC 9112 / httparse compatibility)
  let r3 = "HTTP/1.1 200\r\nContent-Length: 0\r\n\r\n".to_bytes()
  match parse_response(r3) {
    Ok(ParseStatus::Complete(resp, _)) => {
      debug_assert(resp.status == 200, "200")
      debug_assert(resp.reason == "", "empty reason no space")
      debug_assert(opt_i64_eq(resp.content_length(), Some(0L)), "CL 0")
    }
    _ => debug_assert(false, "expected Complete 200 without space")
  }
}

///|
test "httparse_response_partial_every_byte_boundary" {
  let raw = "HTTP/1.1 201 Created\r\nLocation: /items/1\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\n".to_bytes()
  let n = raw.length()
  let mut k = 0
  while k < n {
    match parse_response(raw.slice(0, k)) {
      Ok(ParseStatus::Partial) => ()
      _ => debug_assert(false, "response prefix " + k.to_string() + " must be Partial")
    }
    k = k + 1
  }
  match parse_response(raw) {
    Ok(ParseStatus::Complete(resp, consumed)) => {
      debug_assert(consumed == n, "consumed")
      let cookies = resp.headers_named("set-cookie")
      debug_assert(cookies.length() == 2 && cookies[0] == "a=1" && cookies[1] == "b=2", "2 cookies")
    }
    _ => debug_assert(false, "expected Complete response")
  }
}

///|
test "httparse_response_invalid_status_version_reason" {
  debug_assert(is_err_resp(parse_response("HTTP/1.1 20 OK\r\n\r\n".to_bytes())), "2-digit status")
  debug_assert(is_err_resp(parse_response("HTTP/1.1 2000 OK\r\n\r\n".to_bytes())), "4-digit status")
  debug_assert(is_err_resp(parse_response("HTTP/1.1 2a0 OK\r\n\r\n".to_bytes())), "non-digit status")
  debug_assert(is_err_resp(parse_response("HTTP/2.0 200 OK\r\n\r\n".to_bytes())), "HTTP/2.0")
  debug_assert(is_err_resp(parse_response("HTTP/1.1  200 OK\r\n\r\n".to_bytes())), "double space")
  let bad_reason = bytes_from_ints([
    72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 0, 75, 13, 10, 13, 10,
  ])
  debug_assert(is_err_resp(parse_response(bad_reason)), "NUL in reason phrase")
}

///|
test "httparse_parse_chunk_size_vectors" {
  match parse_chunk_size("0\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(sz, n)) => debug_assert(sz == 0L && n == 3, "0 chunk")
    _ => debug_assert(false, "0 chunk failed")
  }
  match parse_chunk_size("12\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(sz, n)) => debug_assert(sz == 18L && n == 4, "0x12 = 18")
    _ => debug_assert(false, "12 chunk failed")
  }
  match parse_chunk_size("3086d\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(sz, n)) => debug_assert(sz == 198765L && n == 7, "0x3086d = 198765")
    _ => debug_assert(false, "3086d failed")
  }
  match parse_chunk_size("3735AB1;foo=bar\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(sz, n)) => debug_assert(sz == 57891505L && n == 17, "hex + ext")
    _ => debug_assert(false, "hex + ext failed")
  }
  match parse_chunk_size("12".to_bytes()) {
    Ok(ParseStatus::Partial) => ()
    _ => debug_assert(false, "partial chunk size")
  }
  match parse_chunk_size("12\r".to_bytes()) {
    Ok(ParseStatus::Partial) => ()
    _ => debug_assert(false, "partial chunk size after CR")
  }
  match parse_chunk_size("12\n".to_bytes()) {
    Err(_) => ()
    _ => debug_assert(false, "bare LF chunk size rejected")
  }
  match parse_chunk_size(" 1\r\n".to_bytes()) {
    Err(_) => ()
    _ => debug_assert(false, "leading space chunk size rejected")
  }
  match parse_chunk_size("1234567890abcdef0\r\n".to_bytes()) {
    Err(_) => ()
    _ => debug_assert(false, "overflow chunk size rejected")
  }
}

///|
test "httparse_encode_request_and_response_roundtrip" {
  let req_hdrs = [
    Header::new("Host", "example.com"),
    Header::new("Accept", "*/*"),
    Header::new("Content-Length", "11"),
  ]
  match encode_request("POST", "/v1/echo", Version::Http11, req_hdrs) {
    Ok(wire) => {
      match parse_request(wire) {
        Ok(ParseStatus::Complete(req, consumed)) => {
          debug_assert(consumed == wire.length(), "roundtrip consumed")
          debug_assert(req.method == "POST", "POST")
          debug_assert(req.path == "/v1/echo", "/v1/echo")
          debug_assert(version_eq(req.version, Version::Http11), "1.1")
          debug_assert(opt_str_eq(req.header("host"), Some("example.com")), "host")
          debug_assert(opt_i64_eq(req.content_length(), Some(11L)), "CL 11")
        }
        _ => debug_assert(false, "encoded request failed to parse")
      }
    }
    Err(_) => debug_assert(false, "encode_request failed")
  }
  let resp_hdrs = [
    Header::new("Content-Type", "text/plain"),
    Header::new("Transfer-Encoding", "chunked"),
  ]
  match encode_response(Version::Http11, 200, "OK", resp_hdrs) {
    Ok(wire) => {
      match parse_response(wire) {
        Ok(ParseStatus::Complete(resp, consumed)) => {
          debug_assert(consumed == wire.length(), "resp roundtrip consumed")
          debug_assert(resp.status == 200 && resp.reason == "OK", "200 OK")
          debug_assert(resp.is_chunked(), "chunked")
        }
        _ => debug_assert(false, "encoded response failed to parse")
      }
    }
    Err(_) => debug_assert(false, "encode_response failed")
  }
}

///|
test "rt_http11_minimal_with_host_leading_crlf_and_http12" {
  // Minimal HTTP/1.1 request with Host succeeds
  let raw11 = "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n".to_bytes()
  match parse_request(raw11) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw11.length(), "consumed")
      debug_assert(version_eq(req.version, Version::Http11), "HTTP/1.1")
      debug_assert(opt_str_eq(req.header("host"), Some("example.com")), "host")
    }
    _ => debug_assert(false, "minimal HTTP/1.1 with Host should succeed")
  }
  // Leading CRLF before request-line ignored (RFC 9112 §2.2)
  let raw_crlf = "\r\nGET / HTTP/1.1\r\nHost: a\r\n\r\n".to_bytes()
  match parse_request(raw_crlf) {
    Ok(ParseStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw_crlf.length(), "consumed includes leading CRLF")
      debug_assert(req.method == "GET", "GET")
    }
    _ => debug_assert(false, "leading CRLF should be ignored")
  }
  // Higher minor version HTTP/1.2 treated as HTTP/1.1 (RFC 9110 §2.5)
  match parse_request("GET / HTTP/1.2\r\nHost: a\r\n\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(req, _)) =>
    debug_assert(version_eq(req.version, Version::Http11), "HTTP/1.2 as 1.1")
    _ => debug_assert(false, "HTTP/1.2 with Host should be accepted")
  }
  match parse_response("HTTP/1.2 200 OK\r\n\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(resp, _)) =>
    debug_assert(version_eq(resp.version, Version::Http11), "resp HTTP/1.2 as 1.1")
    _ => debug_assert(false, "HTTP/1.2 response should be accepted")
  }
  // 1xx / 204 / 304 responses always have Framing::None (RFC 9112 §6.3 rule 1)
  let no_body_resps = [
    "HTTP/1.1 100 Continue\r\nTransfer-Encoding: chunked\r\n\r\n",
    "HTTP/1.1 101 Switching Protocols\r\nContent-Length: 10\r\n\r\n",
    "HTTP/1.1 204 No Content\r\nContent-Length: 38\r\n\r\n",
    "HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n",
    "HTTP/1.1 304 Not Modified\r\nContent-Length: 1024\r\n\r\n",
  ]
  let mut i = 0
  while i < no_body_resps.length() {
    match parse_response(no_body_resps[i].to_bytes()) {
      Ok(ParseStatus::Complete(resp, _)) => {
        debug_assert(opt_i64_eq(resp.content_length(), None), "no CL framing")
        debug_assert(!resp.is_chunked(), "no chunked framing")
      }
      _ => debug_assert(false, "1xx/204/304 response parse failed #" + i.to_string())
    }
    i = i + 1
  }
}
