///| Wasm32 smoke entry for the `http1` package.

import "http1"

///|
pub fn smoke() -> Int {
  let raw_req = "POST /v1/chat HTTP/1.1\r\nHost: api.example.com\r\nTransfer-Encoding: chunked\r\n\r\n".to_bytes()
  let ok_req = match http1::parse_request(raw_req) {
    Ok(http1::ParseStatus::Complete(req, _)) =>
    req.method == "POST" && req.is_chunked()
    _ => false
  }
  if !ok_req {
    return 1
  }
  let dec = http1::ChunkedDecoder::new()
  dec.feed("5\r\nhello\r\n0\r\n\r\n".to_bytes())
  let ok_chunk = match dec.next() {
    Ok(http1::ChunkStep::Data(d)) => d.to_string() == "hello"
    _ => false
  }
  if !ok_chunk {
    return 2
  }
  let sse = http1::SseDecoder::new()
  let ok_sse = match sse.feed("event: token\ndata: hi\n\n".to_bytes()) {
    Ok(evts) =>
    evts.length() == 1 &&
    evts[0].event_type == "token" &&
    evts[0].data == "hi"
    _ => false
  }
  if !ok_sse {
    return 3
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
