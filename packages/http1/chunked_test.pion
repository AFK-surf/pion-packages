///| RFC 9112 §7.1 Chunked Transfer Coding compliance & incremental streaming tests.

///|
fn drain_chunked(
  dec : ChunkedDecoder,
  chunks : Array[Bytes],
) -> Result[(Bytes, Array[Header]), HttpError] {
  let out_parts : Array[Bytes] = []
  let mut total = 0
  let mut ci = 0
  let mut done = false
  let mut trailers : Array[Header] = []
  while ci < chunks.length() {
    dec.feed(chunks[ci])
    let mut looping = !done
    while looping {
      match dec.next() {
        Ok(ChunkStep::Data(d)) => {
          out_parts.push(d)
          total = total + d.length()
        }
        Ok(ChunkStep::NeedMore) => looping = false
        Ok(ChunkStep::Done(tr)) => {
          trailers = tr
          done = true
          looping = false
        }
        Err(e) => return Err(e)
      }
    }
    ci = ci + 1
  }
  if !done {
    return Err(HttpError::InvalidChunkTerminator)
  }
  let mut out = Bytes::new(total)
  let mut off = 0
  let mut pi = 0
  while pi < out_parts.length() {
    let p = out_parts[pi]
    let plen = p.length()
    let mut j = 0
    while j < plen {
      out[off + j] = p[j]
      j = j + 1
    }
    off = off + plen
    pi = pi + 1
  }
  Ok((out, trailers))
}

///|
fn split_bytes(src : Bytes, step : Int) -> Array[Bytes] {
  let parts : Array[Bytes] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let e = if i + step < n { i + step } else { n }
    parts.push(src.slice(i, e))
    i = e
  }
  parts
}

///|
test "chunked_empty_body" {
  let dec = ChunkedDecoder::new()
  match drain_chunked(dec, ["0\r\n\r\n".to_bytes()]) {
    Ok((body, trailers)) => {
      debug_assert(body.length() == 0, "empty body")
      debug_assert(trailers.length() == 0, "no trailers")
      debug_assert(dec.is_done(), "done")
      debug_assert(dec.remaining_bytes() == 0, "no remaining")
    }
    Err(_) => debug_assert(false, "empty chunked body failed")
  }
}

///|
test "chunked_rfc9112_wikipedia_vector" {
  let wire = "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n".to_bytes()
  let dec = ChunkedDecoder::new()
  match drain_chunked(dec, [wire]) {
    Ok((body, trailers)) => {
      debug_assert(body.to_string() == "Wikipedia in\r\n\r\nchunks.", "decoded body")
      debug_assert(trailers.length() == 0, "no trailers")
    }
    Err(_) => debug_assert(false, "wikipedia vector failed")
  }
}

///|
test "chunked_leading_zeros_and_extensions_and_trailers" {
  let wire = "000005;ext=1;q=\"a;b\\\"c\\\\d\"\r\nhello\r\n0006;flag\r\n world\r\n0000;last=yes\r\nX-Checksum: abc123\r\nX-Signature: sig\r\n\r\n".to_bytes()
  let dec = ChunkedDecoder::new()
  match drain_chunked(dec, [wire]) {
    Ok((body, trailers)) => {
      debug_assert(body.to_string() == "hello world", "body")
      debug_assert(trailers.length() == 2, "2 trailers")
      debug_assert(trailers[0].name == "X-Checksum" && trailers[0].value == "abc123", "t0")
      debug_assert(trailers[1].name == "X-Signature" && trailers[1].value == "sig", "t1")
    }
    Err(_) => debug_assert(false, "extensions + trailers failed")
  }
}

///|
test "chunked_preserves_pipelined_trailing_bytes" {
  let wire = "5\r\nhello\r\n0\r\n\r\nGET /next HTTP/1.1\r\n\r\n".to_bytes()
  let dec = ChunkedDecoder::new()
  match drain_chunked(dec, [wire]) {
    Ok((body, _)) => {
      debug_assert(body.to_string() == "hello", "body")
      debug_assert(dec.remaining_bytes() == 22, "22 trailing bytes")
      debug_assert(dec.take_remaining().to_string() == "GET /next HTTP/1.1\r\n\r\n", "pipelined request preserved")
    }
    Err(_) => debug_assert(false, "pipelined trailing failed")
  }
}

///|
test "chunked_one_byte_drip_equals_whole_buffer" {
  let wire = "4;a=b\r\nWiki\r\n5;c=\"x\\\"y\"\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0;end=1\r\nX-T1: v1\r\nX-T2: v2\r\n\r\nTAIL".to_bytes()
  let dec_whole = ChunkedDecoder::new()
  let (whole_body, whole_tr) = match drain_chunked(dec_whole, [wire]) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "whole decode failed")
      (Bytes::new(0), [])
    }
  }
  let sizes = [1, 2, 3, 5, 7, 13]
  let mut si = 0
  while si < sizes.length() {
    let dec = ChunkedDecoder::new()
    match drain_chunked(dec, split_bytes(wire, sizes[si])) {
      Ok((b, tr)) => {
        debug_assert(b.to_string() == whole_body.to_string(), "body eq step " + sizes[si].to_string())
        debug_assert(tr.length() == whole_tr.length(), "trailer len eq")
        debug_assert(tr[0].name == whole_tr[0].name && tr[0].value == whole_tr[0].value, "t0 eq")
        debug_assert(tr[1].name == whole_tr[1].name && tr[1].value == whole_tr[1].value, "t1 eq")
        debug_assert(dec.take_remaining().to_string() == "TAIL", "trailing eq")
      }
      Err(_) => debug_assert(false, "drip decode failed at step " + sizes[si].to_string())
    }
    si = si + 1
  }
}

///|
test "chunked_encode_and_final_chunk_roundtrip" {
  let c1 = encode_chunk("Hello, ".to_bytes())
  let c2 = encode_chunk("Chunked!".to_bytes())
  let c3 = encode_chunk(Bytes::new(0))
  debug_assert(c3.length() == 0, "encode_chunk(empty) returns empty bytes")
  let fin = match encode_final_chunk([Header::new("X-End", "ok")]) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode_final_chunk failed")
      Bytes::new(0)
    }
  }
  let dec = ChunkedDecoder::new()
  match drain_chunked(dec, [c1, c2, fin]) {
    Ok((body, trailers)) => {
      debug_assert(body.to_string() == "Hello, Chunked!", "roundtrip body")
      debug_assert(trailers.length() == 1 && trailers[0].name == "X-End" && trailers[0].value == "ok", "roundtrip trailer")
    }
    Err(_) => debug_assert(false, "roundtrip decode failed")
  }
}

///|
test "chunked_rejects_malformed_lines_and_terminators" {
  let bad_inputs = [
    "5\nhello\r\n0\r\n\r\n",
    "5\r\nhello\n0\r\n\r\n",
    "5\r\nhelloXX0\r\n\r\n",
    "+5\r\nhello\r\n0\r\n\r\n",
    "-5\r\nhello\r\n0\r\n\r\n",
    " 5\r\nhello\r\n0\r\n\r\n",
    "0x5\r\nhello\r\n0\r\n\r\n",
    "5g\r\nhello\r\n0\r\n\r\n",
    "\r\n0\r\n\r\n",
    "5;bad ext\r\nhello\r\n0\r\n\r\n",
    "5;q=\"unterminated\r\nhello\r\n0\r\n\r\n",
    "0\r\nBad Header : x\r\n\r\n",
    "0\r\n folded: x\r\n\r\n",
    "0\r\nX-A: 1\n\r\n",
  ]
  let mut i = 0
  while i < bad_inputs.length() {
    let dec = ChunkedDecoder::new()
    match drain_chunked(dec, [bad_inputs[i].to_bytes()]) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "expected error for bad chunked input #" + i.to_string())
    }
    i = i + 1
  }
}

///|
test "chunked_rejects_overflow_and_limits" {
  // Int64 overflow
  let dec1 = ChunkedDecoder::new()
  match drain_chunked(dec1, ["8000000000000000\r\n".to_bytes()]) {
    Err(HttpError::ChunkTooLarge) => ()
    Err(HttpError::InvalidChunkSize) => ()
    _ => debug_assert(false, "expected overflow error for 0x8000000000000000")
  }
  // Exceeds max_chunk_size
  let lim = Limits::{
    max_headers: 100,
    max_header_bytes: 65536L,
    max_uri_bytes: 8192L,
    max_chunk_size: 4L,
    max_chunk_ext_bytes: 8L,
    max_trailers: 1,
    max_sse_event_bytes: 1048576L,
    max_sse_line_bytes: 262144L,
  }
  let dec2 = ChunkedDecoder::with_limits(lim)
  match drain_chunked(dec2, ["5\r\nhello\r\n0\r\n\r\n".to_bytes()]) {
    Err(HttpError::ChunkTooLarge) => ()
    _ => debug_assert(false, "expected ChunkTooLarge")
  }
  let dec3 = ChunkedDecoder::with_limits(lim)
  match drain_chunked(dec3, ["1;abcdefghij=1\r\na\r\n0\r\n\r\n".to_bytes()]) {
    Err(HttpError::InvalidChunkExtension) => ()
    _ => debug_assert(false, "expected InvalidChunkExtension for long ext")
  }
  let dec4 = ChunkedDecoder::with_limits(lim)
  match drain_chunked(dec4, ["0\r\nA: 1\r\nB: 2\r\n\r\n".to_bytes()]) {
    Err(HttpError::TooManyTrailers) => ()
    _ => debug_assert(false, "expected TooManyTrailers")
  }
}

///|
test "rt_chunked_16_hex_digits_limit_and_large_streaming" {
  // 16 hex digits accepted
  let dec16 = ChunkedDecoder::new()
  match drain_chunked(dec16, ["0000000000000005\r\nhello\r\n0\r\n\r\n".to_bytes()]) {
    Ok((b, _)) => debug_assert(b.to_string() == "hello", "16 hex digits ok")
    Err(_) => debug_assert(false, "16 hex digits should succeed")
  }
  // 17+ hex digits rejected identically whole and split
  let dec17w = ChunkedDecoder::new()
  match drain_chunked(dec17w, ["00000000000000005\r\nhello\r\n0\r\n\r\n".to_bytes()]) {
    Err(HttpError::InvalidChunkSize) => ()
    _ => debug_assert(false, "17 hex digits whole must fail with InvalidChunkSize")
  }
  let dec17s = ChunkedDecoder::new()
  match drain_chunked(dec17s, split_bytes("00000000000000005\r\nhello\r\n0\r\n\r\n".to_bytes(), 1)) {
    Err(HttpError::InvalidChunkSize) => ()
    _ => debug_assert(false, "17 hex digits 1-byte split must fail with InvalidChunkSize")
  }
  // 80 MiB single chunk streams without up-front rejection
  let dec80 = ChunkedDecoder::new()
  dec80.feed("5000000\r\n".to_bytes())
  dec80.feed(Bytes::new(1024))
  match dec80.next() {
    Ok(ChunkStep::Data(d)) => debug_assert(d.length() == 1024, "streamed 1 KiB of 80 MiB chunk")
    _ => debug_assert(false, "80 MiB chunk must stream")
  }
}
