///| Day-1 Red-Team HTTP Request Smuggling & CRLF Injection security tests.

///|
test "smuggle_cl_and_te_ambiguous_framing_rejected" {
  // CL + TE in request
  let r1 = "POST / HTTP/1.1\r\nHost: victim.com\r\nContent-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n".to_bytes()
  match parse_request(r1) {
    Err(HttpError::AmbiguousFraming) => ()
    _ => debug_assert(false, "CL+TE must return AmbiguousFraming")
  }
  // TE + CL in request (reverse order, mixed case)
  let r2 = "POST / HTTP/1.1\r\nHost: victim.com\r\ntransfer-encoding: chunked\r\nCONTENT-LENGTH: 0\r\n\r\n".to_bytes()
  match parse_request(r2) {
    Err(HttpError::AmbiguousFraming) => ()
    _ => debug_assert(false, "TE+CL must return AmbiguousFraming")
  }
  // CL + TE in response
  let r3 = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n".to_bytes()
  match parse_response(r3) {
    Err(HttpError::AmbiguousFraming) => ()
    _ => debug_assert(false, "Response CL+TE must return AmbiguousFraming")
  }
}

///|
test "smuggle_duplicate_and_malformed_content_length_rejected" {
  let cases = [
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\nContent-Length: 20\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\nContent-Length: 10\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10, 20\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10, 10\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: +10\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: -5\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: \r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 10 20\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 9223372036854775808\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 9999999999999999999999999\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 12a\r\n\r\n",
  ]
  let mut i = 0
  while i < cases.length() {
    match parse_request(cases[i].to_bytes()) {
      Err(HttpError::InvalidContentLength) => ()
      _ => debug_assert(false, "CL smuggling case #" + i.to_string() + " must return InvalidContentLength")
    }
    i = i + 1
  }
}

///|
test "smuggle_transfer_encoding_obfuscation_rejected" {
  let cases = [
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, gzip\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: gzip\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: xchunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked; q=1\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: \r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: , chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, \r\n\r\n",
    "POST / HTTP/1.0\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n",
  ]
  let mut i = 0
  while i < cases.length() {
    match parse_request(cases[i].to_bytes()) {
      Err(HttpError::InvalidTransferEncoding) => ()
      _ => debug_assert(false, "TE smuggling case #" + i.to_string() + " must return InvalidTransferEncoding")
    }
    i = i + 1
  }
  // Valid stacked TE ending in chunked (gzip, chunked) IS allowed in RFC 9112
  let ok_te = "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: gzip, chunked\r\n\r\n".to_bytes()
  match parse_request(ok_te) {
    Ok(ParseStatus::Complete(req, _)) => debug_assert(req.is_chunked(), "gzip, chunked valid")
    _ => debug_assert(false, "gzip, chunked should be accepted")
  }
}

///|
test "smuggle_space_before_colon_and_obs_fold_rejected" {
  match parse_request("GET / HTTP/1.1\r\nHost : evil.com\r\n\r\n".to_bytes()) {
    Err(HttpError::InvalidHeaderName) => ()
    _ => debug_assert(false, "space before colon must be InvalidHeaderName")
  }
  match parse_request("GET / HTTP/1.1\r\nHost\t: evil.com\r\n\r\n".to_bytes()) {
    Err(HttpError::InvalidHeaderName) => ()
    _ => debug_assert(false, "tab before colon must be InvalidHeaderName")
  }
  match parse_request("GET / HTTP/1.1\r\nHost: a.com\r\n folded: value\r\n\r\n".to_bytes()) {
    Err(HttpError::ObsFold) => ()
    _ => debug_assert(false, "SP obs-fold must return ObsFold")
  }
  match parse_request("GET / HTTP/1.1\r\nHost: a.com\r\n\tfolded: value\r\n\r\n".to_bytes()) {
    Err(HttpError::ObsFold) => ()
    _ => debug_assert(false, "HTAB obs-fold must return ObsFold")
  }
}

///|
test "smuggle_bare_cr_and_bare_lf_rejected" {
  let req_cases = [
    "GET / HTTP/1.1\nHost: a\r\n\r\n",
    "GET / HTTP/1.1\rHost: a\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\n\n",
    "GET / HTTP/1.1\r\nX-Evil: a\rb\r\n\r\n",
    "GET / HTTP/1.1\r\nX-Evil: a\nb\r\n\r\n",
  ]
  let mut i = 0
  while i < req_cases.length() {
    match parse_request(req_cases[i].to_bytes()) {
      Err(HttpError::BareCrOrLf) => ()
      _ => debug_assert(false, "bare CR/LF req #" + i.to_string() + " must return BareCrOrLf")
    }
    i = i + 1
  }
  let resp_cases = [
    "HTTP/1.1 200 OK\n\r\n",
    "HTTP/1.1 200 OK\r\nX-A: 1\n\r\n",
    "HTTP/1.1 200 OK\r\nX-A: 1\r2\r\n\r\n",
  ]
  let mut j = 0
  while j < resp_cases.length() {
    match parse_response(resp_cases[j].to_bytes()) {
      Err(HttpError::BareCrOrLf) => ()
      _ => debug_assert(false, "bare CR/LF resp #" + j.to_string() + " must return BareCrOrLf")
    }
    j = j + 1
  }
}

///|
test "smuggle_nul_and_ctl_in_headers_rejected" {
  // NUL in header value
  let h_nul = bytes_from_ints([
    71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
    88, 45, 65, 58, 32, 97, 0, 98, 13, 10, 13, 10,
  ])
  match parse_request(h_nul) {
    Err(HttpError::InvalidHeaderValue) => ()
    _ => debug_assert(false, "NUL in header value must be rejected")
  }
  // Vertical tab 0x0B in header value (classic TE smuggling bypass)
  let h_vt = bytes_from_ints([
    71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
    88, 45, 65, 58, 32, 11, 98, 13, 10, 13, 10,
  ])
  match parse_request(h_vt) {
    Err(HttpError::InvalidHeaderValue) => ()
    _ => debug_assert(false, "VT 0x0B in header value must be rejected")
  }
  // DEL 0x7F in header value
  let h_del = bytes_from_ints([
    71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
    88, 45, 65, 58, 32, 127, 13, 10, 13, 10,
  ])
  match parse_request(h_del) {
    Err(HttpError::InvalidHeaderValue) => ()
    _ => debug_assert(false, "DEL 0x7F in header value must be rejected")
  }
}

///|
test "smuggle_encoder_crlf_and_nul_injection_rejected" {
  // Method CRLF / NUL
  match encode_request("GET\r\nX-Inject: 1", "/", Version::Http11, []) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "method CRLF injection must be rejected")
  }
  // Path CRLF / NUL
  match encode_request("GET", "/a\r\nHost: evil", Version::Http11, []) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "path CRLF injection must be rejected")
  }
  match encode_request("GET", "/a\u{0000}b", Version::Http11, []) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "path NUL injection must be rejected")
  }
  // Header name CRLF
  match encode_request("GET", "/", Version::Http11, [Header::new("X-Bad\r\nName", "v")]) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "header name CRLF injection must be rejected")
  }
  // Header value CRLF / LF / CR / NUL
  match encode_request("GET", "/", Version::Http11, [Header::new("X-Ok", "a\r\nSet-Cookie: evil=1")]) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "header value CRLF injection must be rejected")
  }
  match encode_request("GET", "/", Version::Http11, [Header::new("X-Ok", "a\nb")]) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "header value LF injection must be rejected")
  }
  match encode_request("GET", "/", Version::Http11, [Header::new("X-Ok", "a\u{0000}b")]) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "header value NUL injection must be rejected")
  }
  // Response reason CRLF
  match encode_response(Version::Http11, 200, "OK\r\nX-Injected: yes", []) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "response reason CRLF injection must be rejected")
  }
  // Trailer CRLF
  match encode_final_chunk([Header::new("X-Tr", "val\r\nEvil: 1")]) {
    Err(HttpError::CrlfInjection) => ()
    _ => debug_assert(false, "trailer CRLF injection must be rejected")
  }
}

///|
test "rt_host_validation_and_http10_resp_te_and_encoder_framing" {
  // Missing, duplicate, and invalid Host in HTTP/1.1 requests
  let bad_hosts = [
    "GET / HTTP/1.1\r\nAccept: */*\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nhOsT: b\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a b\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a/evil\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\"\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a:badport\r\n\r\n",
  ]
  let mut i = 0
  while i < bad_hosts.length() {
    match parse_request(bad_hosts[i].to_bytes()) {
      Err(HttpError::InvalidHost) => ()
      _ => debug_assert(false, "bad host #" + i.to_string() + " must return InvalidHost")
    }
    i = i + 1
  }
  // Valid IPv6 literal Host accepted
  match parse_request("GET / HTTP/1.1\r\nHost: [::1]:8080\r\n\r\n".to_bytes()) {
    Ok(ParseStatus::Complete(_, _)) => ()
    _ => debug_assert(false, "IPv6 Host should be accepted")
  }
  // HTTP/1.0 response with Transfer-Encoding rejected (RFC 9112 §6.1)
  match parse_response("HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n".to_bytes()) {
    Err(HttpError::InvalidTransferEncoding) => ()
    _ => debug_assert(false, "HTTP/1.0 response with TE must be rejected")
  }
  // Encoder rejects CL+TE, duplicate/bad CL, bad TE, HTTP/1.0+TE, untrimmed values, forbidden trailers
  match encode_request("POST", "/", Version::Http11, [
    Header::new("Host", "a"),
    Header::new("Content-Length", "4"),
    Header::new("Transfer-Encoding", "chunked"),
  ]) {
    Err(HttpError::AmbiguousFraming) => ()
    _ => debug_assert(false, "encode_request CL+TE must fail")
  }
  match encode_response(Version::Http11, 200, "OK", [
    Header::new("Transfer-Encoding", "chunked"),
    Header::new("Content-Length", "4"),
  ]) {
    Err(HttpError::AmbiguousFraming) => ()
    _ => debug_assert(false, "encode_response CL+TE must fail")
  }
  match encode_request("POST", "/", Version::Http10, [
    Header::new("Host", "a"),
    Header::new("Transfer-Encoding", "chunked"),
  ]) {
    Err(HttpError::InvalidTransferEncoding) => ()
    _ => debug_assert(false, "encode_request HTTP/1.0+TE must fail")
  }
  match encode_request("GET", "/", Version::Http11, [
    Header::new("Host", "a"),
    Header::new("X-Sig", " v "),
  ]) {
    Err(HttpError::InvalidHeaderValue) => ()
    _ => debug_assert(false, "encode_request untrimmed value must fail")
  }
  match encode_final_chunk([Header::new("Content-Length", "1")]) {
    Err(HttpError::InvalidTrailer) => ()
    _ => debug_assert(false, "forbidden Content-Length trailer must fail")
  }
  match encode_final_chunk([Header::new("Host", "evil")]) {
    Err(HttpError::InvalidTrailer) => ()
    _ => debug_assert(false, "forbidden Host trailer must fail")
  }
}

test "limits default positive and framing host first acceptance" {
  let lim = Limits::default()
  debug_assert(lim.max_headers > 0, "default max_headers > 0")
  debug_assert(lim.max_header_bytes > 0L, "default max_header_bytes > 0")
  debug_assert(lim.max_uri_bytes > 0L, "default max_uri_bytes > 0")
  debug_assert(lim.max_chunk_size > 0L, "default max_chunk_size > 0")
  debug_assert(lim.max_chunk_ext_bytes > 0L, "default max_chunk_ext_bytes > 0")
  debug_assert(lim.max_trailers > 0, "default max_trailers > 0")
  debug_assert(lim.max_sse_line_bytes > 0L, "default max_sse_line_bytes > 0")
  debug_assert(lim.max_sse_event_bytes > 0L, "default max_sse_event_bytes > 0")
  debug_assert(check_framing_host(0, true) == 0, "first valid host accepted")
}
