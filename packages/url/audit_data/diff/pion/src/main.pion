///| Differential driver for the `data:` URL red-team audit (Pion side).
///| Protocol (same as `../node/oracle.mjs`): one case per stdin line, the input URL as
///| lowercase hex bytes. One output line per case:
///|   `OK<TAB>hex(serialized MIME type)<TAB>hex(body)` or `ERR<TAB><kind>`.

import "url"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> String {
  let n = s.length() / 2
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn hex_digit(d : Int) -> Byte {
  "0123456789abcdef".code_unit_at(d).to_byte()
}

///|
fn write_hex_str(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(hex_digit(b / 16))
    sb.write_byte(hex_digit(b % 16))
    i = i + 1
  }
}

///|
fn write_hex_bytes(sb : StringBuilder, bs : Bytes) -> Unit {
  let mut i = 0
  while i < bs.length() {
    let b = bs[i].to_int() & 0xFF
    sb.write_byte(hex_digit(b / 16))
    sb.write_byte(hex_digit(b % 16))
    i = i + 1
  }
}

///| WHATWG MIME Sniffing "serialize a MIME type".
fn is_token(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    let ok = (b >= 48 && b <= 57) ||
    (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    b == 33 ||
    b == 35 ||
    b == 36 ||
    b == 37 ||
    b == 38 ||
    b == 39 ||
    b == 42 ||
    b == 43 ||
    b == 45 ||
    b == 46 ||
    b == 94 ||
    b == 95 ||
    b == 96 ||
    b == 124 ||
    b == 126
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn serialize_mime(d : url::DataUrl) -> String {
  let sb = StringBuilder::with_capacity(64)
  sb.write_string(d.mime_type)
  let mut i = 0
  while i < d.parameters.length() {
    let (k, v) = d.parameters[i]
    sb.write_string(";")
    sb.write_string(k)
    sb.write_string("=")
    if is_token(v) {
      sb.write_string(v)
    } else {
      sb.write_string("\"")
      let mut j = 0
      while j < v.length() {
        let c = v.code_unit_at(j)
        if c == 34 || c == 92 {
          sb.write_byte((92).to_byte())
        }
        sb.write_byte(c.to_byte())
        j = j + 1
      }
      sb.write_string("\"")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let mut sb = StringBuilder::with_capacity(1 << 20)
  while true {
    let line = match io_read_line(world) {
      Some(l) => l
      None => break
    }
    if line.length() == 0 {
      continue
    }
    match url::parse_data_url(unhex(line)) {
      Ok(d) => {
        sb.write_string("OK\t")
        write_hex_str(sb, serialize_mime(d))
        sb.write_string("\t")
        write_hex_bytes(sb, d.body)
      }
      Err(e) => {
        sb.write_string("ERR\t")
        sb.write_string(url::data_url_error_to_string(e))
      }
    }
    sb.write_byte((10).to_byte())
    if sb.length() > (1 << 20) {
      io_print(world, sb.to_string())
      sb = StringBuilder::with_capacity(1 << 20)
    }
  }
  io_print(world, sb.to_string())
  0
}
