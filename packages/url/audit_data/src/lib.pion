///| Red-team audit helpers for `packages/url/src/data.pion` (no production code; see ../REPORT.md).

import "url"

///|
pub fn expect_eq(got : String, want : String, what : String) -> Unit {
  debug_assert(got == want, what + ": got `" + got + "`, want `" + want + "`")
}

///|
fn hex_byte(sb : StringBuilder, b : Int) -> Unit {
  let digits = "0123456789abcdef"
  sb.write_byte(digits.code_unit_at(b / 16).to_byte())
  sb.write_byte(digits.code_unit_at(b % 16).to_byte())
}

///| Body bytes, printable ASCII kept and everything else as `\xNN`.
pub fn show_bytes(bs : Bytes) -> String {
  let sb = StringBuilder::with_capacity(bs.length() + 8)
  let mut i = 0
  while i < bs.length() {
    let b = bs[i].to_int() & 0xFF
    if b >= 32 && b < 127 && b != 92 {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_string("\\x")
      hex_byte(sb, b)
    }
    i = i + 1
  }
  sb.to_string()
}

///| `mime_type;k=v;...|b64|body` for a parsed data: URL, or `ERR:<message>`.
pub fn summary_with_limit(input : String, max_bytes : Int) -> String {
  match url::parse_data_url_with_limit(input, max_bytes) {
    Ok(d) => {
      let sb = StringBuilder::with_capacity(64)
      sb.write_string(d.mime_type)
      let mut i = 0
      while i < d.parameters.length() {
        sb.write_string(";")
        sb.write_string(d.parameters[i].0)
        sb.write_string("=")
        sb.write_string(d.parameters[i].1)
        i = i + 1
      }
      sb.write_string(if d.is_base64 { "|b64|" } else { "|txt|" })
      sb.write_string(show_bytes(d.body))
      sb.to_string()
    }
    Err(e) => "ERR:" + url::data_url_error_to_string(e)
  }
}

///|
pub fn summary(input : String) -> String {
  summary_with_limit(input, url::default_data_url_max_bytes)
}

///| Decoded body only (`ERR:<message>` on failure).
pub fn body_of(input : String) -> String {
  match url::parse_data_url(input) {
    Ok(d) => show_bytes(d.body)
    Err(e) => "ERR:" + url::data_url_error_to_string(e)
  }
}

///| The URL parser's serialization of `input` (`<ERR>` on failure).
pub fn href_of(input : String) -> String {
  match url::Url::parse(input) {
    Ok(u) => u.href()
    Err(_) => "<ERR>"
  }
}
