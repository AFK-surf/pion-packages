///| Self-contained DoS / no-panic probe for `parse_data_url`, identical on Native and
///| wasm32 (the wasm runtime has no stdin, so inputs are generated in-process).
///| Prints `shape<TAB>n<TAB>ms<TAB>result` per run; a panic aborts with a non-zero exit.

import "url"

///|
fn repeat(prefix : String, unit : String, n : Int, suffix : String) -> String {
  let sb = StringBuilder::with_capacity(prefix.length() + unit.length() * n + suffix.length())
  sb.write_string(prefix)
  let mut i = 0
  while i < n {
    sb.write_string(unit)
    i = i + 1
  }
  sb.write_string(suffix)
  sb.to_string()
}

///|
fn distinct_params(n : Int) -> String {
  let sb = StringBuilder::with_capacity(n * 10 + 32)
  sb.write_string("data:text/plain")
  let mut i = 0
  while i < n {
    sb.write_string(";a")
    sb.write_string(i.to_string())
    sb.write_string("=1")
    i = i + 1
  }
  sb.write_string(",x")
  sb.to_string()
}

///|
fn result_of(input : String) -> String {
  match url::parse_data_url(input) {
    Ok(d) => "OK params=" + d.parameters.length().to_string() + " body=" + d.body.length().to_string()
    Err(e) => "ERR " + url::data_url_error_to_string(e)
  }
}

///|
fn run(world : World, name : String, n : Int, input : String) -> Unit {
  let t0 = clock_now_ms(world)
  let r = result_of(input)
  let t1 = clock_now_ms(world)
  io_print(world, name + "\t" + n.to_string() + "\t" + (t1 - t0).to_string() + "\t" + r + "\n")
}

///|
pub fn main(world : World) -> Int {
  let n = 100000
  run(world, "semicolons", n, repeat("data:text/plain", ";", n, ",x"))
  run(world, "quotes", n, repeat("data:text/plain;a=", "\"", n, ",x"))
  run(world, "backslashes", n, repeat("data:text/plain;a=\"", "\\", n, "\",x"))
  run(world, "duplicate-params", n, repeat("data:text/plain", ";a=1", n, ",x"))
  run(world, "commas-body", n, repeat("data:,", ",", n, ""))
  run(world, "percent-body", n, repeat("data:,", "%41", n, ""))
  run(world, "broken-percent", n, repeat("data:,", "%", n, ""))
  run(world, "base64-body", n, repeat("data:;base64,", "QUFB", n, ""))
  run(world, "base64-pct", n, repeat("data:;base64,", "%51%55%46%42", n, ""))
  run(world, "base64-ws", n, repeat("data:;base64,", " ", n, "QQ=="))
  run(world, "header-ws", n, repeat("data:", " ", n, ";base64,QQ=="))
  run(world, "fragments", n, repeat("data:,a", "#", n, ""))
  // D-1: quadratic distinct-parameter scan (n vs 4n)
  run(world, "distinct-params", 5000, distinct_params(5000))
  run(world, "distinct-params", 20000, distinct_params(20000))
  0
}
