///| Red-team tests for `packages/url/src/data.pion` @ 67385f72 (feat/enrich-url-html).
///
/// Oracle: Fetch Standard §6 "data: URL processor" + WHATWG Infra §4.5 forgiving-base64,
/// executed by Node.js `fetch()` (undici) through `diff/node/oracle.mjs` (122-case
/// differential, see ../REPORT.md). `redteam_*` = a FAILURE is the evidence of a finding;
/// `control_*` = attacks the implementation survived; they must keep passing.
/// The quadratic-time finding (D-1) is reproduced with timings by `../run_audit.sh`.

// ---------------------------------------------------------------------------
// D-2 (P2) `parse_data_url` runs the Fetch data: URL processor on the RAW string and
// skips the URL parser that every browser/fetch runs first. Per the URL standard
// ASCII tab/LF/CR are removed from the whole input, C0 controls (incl. FF) and
// non-ASCII are percent-encoded; the processor then sees a different header/body.
// Consequence: a raw attribute value (`<img src="data:...">`) decodes differently
// from what a browser renders — newlines stay in the body, `te\txt/plain` loses its
// MIME type, and `;\fbase64` turns a text body into a base64-decoded one.
// ---------------------------------------------------------------------------

///|
test "redteam_tab_lf_cr_in_body_are_removed" {
  // node fetch: body `abcd`
  expect_eq(body_of("data:,a\tb\nc\rd"), "abcd", "tab/LF/CR in body")
}

///|
test "redteam_tab_lf_inside_mime_type_are_removed" {
  // node fetch: content-type `text/plain` (URL parser drops the tab / LF)
  expect_eq(summary("data:te\txt/plain,x"), "text/plain|txt|x", "tab inside type")
  expect_eq(summary("data:text/\nplain,x"), "text/plain|txt|x", "LF inside type")
}

///|
test "redteam_formfeed_before_base64_is_not_base64" {
  // Fetch only allows U+0020 between `;` and `base64`; in a URL the FF is `%0C`.
  // node fetch: text/plain, body `SGk=` (not decoded)
  expect_eq(summary("data:text/plain;\x0cbase64,SGk="), "text/plain|txt|SGk=", ";\\fbase64")
  expect_eq(summary("data:text/plain;base64\x0c,SGk="), "text/plain|txt|SGk=", "base64\\f,")
}

///|
test "control_url_parser_then_data_processor_matches_fetch" {
  // Recommended composition: parse_data_url(Url::parse(raw).href()) — what fetch does.
  expect_eq(body_of(href_of("data:,a\tb\nc\rd")), "abcd", "composed tab/LF/CR")
  expect_eq(summary(href_of("data:te\txt/plain,x")), "text/plain|txt|x", "composed type")
  expect_eq(summary(href_of("data:text/plain;\x0cbase64,SGk=")), "text/plain|txt|SGk=", "composed FF")
}

// ---------------------------------------------------------------------------
// Controls: comma / fragment / whitespace / scheme (all agree with node fetch)
// ---------------------------------------------------------------------------

///|
test "control_comma_and_fragment" {
  expect_eq(summary("data:text/plain"), "ERR:missing comma in data: URL", "no comma")
  expect_eq(summary("data:"), "ERR:missing comma in data: URL", "bare data:")
  expect_eq(summary("data:text/plain#a,b"), "ERR:missing comma in data: URL", "comma only in fragment")
  expect_eq(summary("data:#,"), "ERR:missing comma in data: URL", "fragment first")
  expect_eq(body_of("data:text/plain,a,b,c"), "a,b,c", "commas in body")
  expect_eq(body_of("data:text/plain,a#b,c"), "a", "fragment stripped from body")
  expect_eq(body_of("data:,a?b#c"), "a?b", "query kept, fragment dropped")
  expect_eq(summary("data:,,"), "text/plain;charset=US-ASCII|txt|,", "data:,,")
  expect_eq(summary("data :,x"), "ERR:invalid data: URL scheme", "space before colon")
  expect_eq(body_of("  DATA:,x  "), "x", "case-insensitive scheme, trimmed")
  expect_eq(body_of("\x01data:,x\x1f"), "x", "C0 trimmed")
}

///|
test "control_base64_flag_detection" {
  expect_eq(summary("data:;base64,SGk="), "text/plain;charset=US-ASCII|b64|Hi", ";base64")
  expect_eq(summary("data:;BaSe64,SGk="), "text/plain;charset=US-ASCII|b64|Hi", ";BaSe64")
  expect_eq(summary("data:text/plain; base64 ,SGk="), "text/plain|b64|Hi", "; base64 ,")
  expect_eq(summary("data:text/plain;charset=utf-8;base64,SGk="), "text/plain;charset=utf-8|b64|Hi", "charset;base64")
  expect_eq(summary("data:text/plain;base64;charset=utf-8,SGk="), "text/plain;charset=utf-8|txt|SGk=", "base64 not last")
  expect_eq(summary("data:text/plain;foo=\"a;base64\",abc"), "text/plain;foo=a;base64|txt|abc", "quoted ;base64")
  expect_eq(summary("data:text/plainbase64,SGk="), "text/plainbase64|txt|SGk=", "no semicolon")
  expect_eq(summary("data:base64,SGk="), "text/plain;charset=US-ASCII|txt|SGk=", "bare base64")
  expect_eq(summary("data:;base64;base64,SGk="), "text/plain|b64|Hi", "double ;base64")
  expect_eq(summary("data:%3Bbase64,SGk="), "text/plain;charset=US-ASCII|txt|SGk=", "%3B not decoded in header")
}

///|
test "control_forgiving_base64" {
  expect_eq(body_of("data:;base64,"), "", "empty")
  expect_eq(body_of("data:;base64,S"), "ERR:invalid base64 data in data: URL", "len%4==1")
  expect_eq(body_of("data:;base64,SGVsbG8"), "Hello", "no padding")
  expect_eq(body_of("data:;base64,SGk=="), "ERR:invalid base64 data in data: URL", "== after 3 symbols")
  expect_eq(body_of("data:;base64,SGk==="), "ERR:invalid base64 data in data: URL", "===")
  expect_eq(body_of("data:;base64,S==="), "ERR:invalid base64 data in data: URL", "S===")
  expect_eq(body_of("data:;base64,===="), "ERR:invalid base64 data in data: URL", "====")
  expect_eq(body_of("data:;base64,SG=k"), "ERR:invalid base64 data in data: URL", "= not at end")
  expect_eq(body_of("data:;base64,SGVs=bG8="), "ERR:invalid base64 data in data: URL", "inner =")
  expect_eq(body_of("data:;base64,ab-_"), "ERR:invalid base64 data in data: URL", "URL-safe alphabet")
  expect_eq(body_of("data:;base64,SGk\xc3\xa9"), "ERR:invalid base64 data in data: URL", "non-ASCII")
  expect_eq(body_of("data:;base64,SGk%E9"), "ERR:invalid base64 data in data: URL", "%E9")
  expect_eq(body_of("data:;base64,SGk%00"), "ERR:invalid base64 data in data: URL", "%00")
  expect_eq(body_of("data:;base64,SG\x0bk="), "ERR:invalid base64 data in data: URL", "VT is not ASCII ws")
  expect_eq(body_of("data:;base64, S G\tk\n= "), "Hi", "whitespace ignored")
  expect_eq(body_of("data:;base64,YR"), "a", "non-zero pad bits discarded")
}

///|
test "control_percent_decode_before_base64" {
  expect_eq(body_of("data:;base64,SGVs%20bG8%3D"), "Hello", "%20 ws, %3D pad")
  expect_eq(body_of("data:;base64,%53%47%6b%3d"), "Hi", "all percent-encoded")
  expect_eq(body_of("data:;base64,SG%3D%3D"), "H", "%3D%3D")
  expect_eq(body_of("data:;base64,SGk%"), "ERR:invalid base64 data in data: URL", "dangling %")
  expect_eq(body_of("data:;base64,S%Gk="), "ERR:invalid base64 data in data: URL", "%G")
  expect_eq(body_of("data:,%"), "%", "dangling % in text")
  expect_eq(body_of("data:,%zz%2C%2c"), "%zz,,", "bad + good escapes")
}

///|
test "control_mime_parsing" {
  expect_eq(summary("data:TEXT/HTML;CHARSET=utf-8,x"), "text/html;charset=utf-8|txt|x", "lowercased")
  expect_eq(summary("data:text/html;charset=\"utf\\-8\",x"), "text/html;charset=utf-8|txt|x", "quoted escape")
  expect_eq(summary("data:text/html;a=1;a=2,x"), "text/html;a=1|txt|x", "first duplicate wins")
  expect_eq(summary("data:text/html;a=,x"), "text/html|txt|x", "empty value dropped")
  expect_eq(summary("data:text/,x"), "text/plain;charset=US-ASCII|txt|x", "empty subtype")
  expect_eq(summary("data:text,x"), "text/plain;charset=US-ASCII|txt|x", "no slash")
  expect_eq(summary("data:text/html/x,x"), "text/plain;charset=US-ASCII|txt|x", "two slashes")
  expect_eq(summary("data:;charset=utf-8,x"), "text/plain;charset=utf-8|txt|x", ";charset only")
}

// ---------------------------------------------------------------------------
// max_bytes boundaries (Pion-only API)
// ---------------------------------------------------------------------------

///|
test "control_max_bytes_boundaries" {
  expect_eq(summary_with_limit("data:,", 0), "text/plain;charset=US-ASCII|txt|", "0 / empty")
  expect_eq(summary_with_limit("data:,a", 0), "ERR:data: URL body exceeds size limit", "0 / 1 byte")
  expect_eq(summary_with_limit("data:,%41", 1), "text/plain;charset=US-ASCII|txt|A", "%41 counts 1")
  expect_eq(summary_with_limit("data:;base64,SGk=", 2), "text/plain;charset=US-ASCII|b64|Hi", "exact")
  expect_eq(summary_with_limit("data:;base64,SGk=", 1), "ERR:data: URL body exceeds size limit", "b64 over")
  expect_eq(summary_with_limit("data:,", -1), "ERR:data: URL body exceeds size limit", "negative")
  expect_eq(summary_with_limit("data:text/plain", -1), "ERR:missing comma in data: URL", "syntax first")
  // A 1 MiB base64 body is rejected by the size pre-pass before any allocation.
  let sb = StringBuilder::with_capacity(1 << 20)
  sb.write_string("data:;base64,")
  let mut i = 0
  while i < (1 << 18) {
    sb.write_string("QUFB")
    i = i + 1
  }
  expect_eq(summary_with_limit(sb.to_string(), 16), "ERR:data: URL body exceeds size limit", "1 MiB vs 16")
}

///|
test "control_dos_shapes_no_panic_small" {
  // linear shapes at 100k (the quadratic one, D-1, is measured by ../run_audit.sh)
  let semis = StringBuilder::with_capacity(100016)
  semis.write_string("data:text/plain")
  let quotes = StringBuilder::with_capacity(100016)
  quotes.write_string("data:text/plain;a=")
  let dup = StringBuilder::with_capacity(400016)
  dup.write_string("data:text/plain")
  let mut i = 0
  while i < 100000 {
    semis.write_string(";")
    quotes.write_string("\"")
    dup.write_string(";a=1")
    i = i + 1
  }
  semis.write_string(",x")
  quotes.write_string(",x")
  dup.write_string(",x")
  expect_eq(summary(semis.to_string()), "text/plain|txt|x", "100k semicolons")
  expect_eq(body_of(quotes.to_string()), "x", "100k quotes: header ends at the first comma")
  expect_eq(summary(dup.to_string()), "text/plain;a=1|txt|x", "100k duplicate params")
}
