///| RFC 2397 / Fetch Standard §6 `data:` URL compliance & edge-case tests.

fn bytes_eq_str(bs : Bytes, expected : String) -> Bool {
  if bs.length() != expected.length() {
    return false
  }
  let mut i = 0
  while i < bs.length() {
    if (bs[i].to_int() & 0xFF) != expected.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn bytes_eq_ints(bs : Bytes, expected : Array[Int]) -> Bool {
  if bs.length() != expected.length() {
    return false
  }
  let mut i = 0
  while i < bs.length() {
    if (bs[i].to_int() & 0xFF) != expected[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "data_url_minimal_and_default_mime" {
  let d1 = match parse_data_url("data:,Hello%2C%20World%21") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d1.mime_type == "text/plain", "default mime_type")
  debug_assert(d1.parameters.length() == 1, "default 1 param")
  debug_assert(d1.parameters[0].0 == "charset", "param key charset")
  debug_assert(d1.parameters[0].1 == "US-ASCII", "param val US-ASCII")
  debug_assert(!d1.is_base64, "not base64")
  debug_assert(bytes_eq_str(d1.body, "Hello, World!"), "decoded body")
  debug_assert(d1.body_string() == "Hello, World!", "body_string")

  let d2 = match parse_data_url("data:,") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "empty payload: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d2.mime_type == "text/plain", "empty mime")
  debug_assert(d2.body.length() == 0, "empty body")

  // Case-insensitive scheme and leading/trailing ASCII whitespace / C0
  let d3 = match parse_data_url("  \tDaTa:,ok\n ") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "case-insensitive scheme: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d3.body, "ok"), "trimmed scheme and body")
}

///|
test "data_url_scheme_and_comma_errors" {
  match parse_data_url("") {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::InvalidScheme), "empty -> InvalidScheme")
    Ok(_) => debug_assert(false, "empty must fail")
  }
  match parse_data_url("http://example.com,foo") {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::InvalidScheme), "http -> InvalidScheme")
    Ok(_) => debug_assert(false, "http must fail")
  }
  match parse_data_url("dat:,foo") {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::InvalidScheme), "dat -> InvalidScheme")
    Ok(_) => debug_assert(false, "dat must fail")
  }
  match parse_data_url("data:text/plain") {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::MissingComma), "no comma -> MissingComma")
    Ok(_) => debug_assert(false, "no comma must fail")
  }
  match parse_data_url("data:text/plain#frag,after") {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::MissingComma), "comma after fragment -> MissingComma")
    Ok(_) => debug_assert(false, "comma after fragment must fail")
  }
}

///|
test "data_url_mime_parameters_and_quoted_values" {
  // Shorthand `;charset=utf-8` prepends `text/plain` per Fetch Standard §6
  let d1 = match parse_data_url("data:;charset=utf-8,%E4%BD%A0%E5%A5%BD") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "shorthand charset: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d1.mime_type == "text/plain", "prepended text/plain")
  debug_assert(d1.parameters.length() == 1, "1 param")
  debug_assert(d1.parameters[0].0 == "charset", "charset key")
  debug_assert(d1.parameters[0].1 == "utf-8", "charset val")
  debug_assert(d1.body_string() == "你好", "utf-8 decoded")

  // Uppercase MIME + multiple params + quoted string with semicolon & escapes + duplicate param (first wins)
  let d2 = match parse_data_url(
    "data:Text/HTML; CHARSET=\"UTF-8\"; foo=\"a;b\\\"c\\\\d\"; foo=second; bar=baz,<h1>Hi</h1>",
  ) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "quoted params: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d2.mime_type == "text/html", "lowercased mime")
  debug_assert(d2.parameters.length() == 3, "3 unique params")
  match d2.get_parameter("charset") {
    Some(v) => debug_assert(v == "UTF-8", "quoted charset")
    None => debug_assert(false, "missing charset")
  }
  match d2.get_parameter("FOO") {
    Some(v) => debug_assert(v == "a;b\"c\\d", "quoted escaped value, first wins")
    None => debug_assert(false, "missing foo")
  }
  match d2.get_parameter("bar") {
    Some(v) => debug_assert(v == "baz", "bar=baz")
    None => debug_assert(false, "missing bar")
  }
  debug_assert(d2.body_string() == "<h1>Hi</h1>", "html body")

  // Invalid MIME falls back to text/plain;charset=US-ASCII per Fetch Standard §6
  let d3 = match parse_data_url("data:notamimetype,abc") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "invalid mime fallback: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d3.mime_type == "text/plain", "fallback text/plain")
  match d3.get_parameter("charset") {
    Some(v) => debug_assert(v == "US-ASCII", "fallback US-ASCII")
    None => debug_assert(false, "fallback charset")
  }
  debug_assert(bytes_eq_str(d3.body, "abc"), "fallback body")
}

///|
test "data_url_base64_forgiving_and_edge_cases" {
  // Standard padded base64 + case-insensitive ;BASE64 + whitespace before base64
  let d1 = match parse_data_url("data:text/plain; charset=utf-8; BASE64,SGVsbG8sIFdvcmxkIQ==") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "standard base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d1.mime_type == "text/plain", "base64 mime")
  debug_assert(d1.is_base64, "is_base64 true")
  debug_assert(bytes_eq_str(d1.body, "Hello, World!"), "decoded Hello, World!")

  // Empty mediatype + `;base64` defaults to text/plain;charset=US-ASCII
  let d2 = match parse_data_url("data:;base64,SGVsbG8=") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "empty mime base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d2.mime_type == "text/plain", "default mime for ;base64")
  debug_assert(d2.is_base64, "is_base64")
  debug_assert(bytes_eq_str(d2.body, "Hello"), "Hello")

  // Missing optional padding (forgiving-base64)
  let d3 = match parse_data_url("data:application/octet-stream;base64,SGVsbG8") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "unpadded base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d3.body, "Hello"), "unpadded Hello")

  let d4 = match parse_data_url("data:;base64,YQ") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "2-char unpadded: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d4.body, "a"), "2-char -> 'a'")

  // ASCII whitespace + percent-encoded whitespace/padding/symbols inside base64
  let d5 = match parse_data_url("data:;base64,SGVs%20bG8%0A%0D%09%3D") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "percent+ws base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d5.body, "Hello"), "percent-decoded ws + = in base64")

  // Binary payload (0x00, 0xFF, 0x7F, 0x80) -> "AP9/gA=="
  let d6 = match parse_data_url("data:application/octet-stream;base64,AP9/gA==") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "binary base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_ints(d6.body, [0, 255, 127, 128]), "binary bytes")

  // Empty base64 body
  let d7 = match parse_data_url("data:;base64,   ") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "empty base64: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(d7.body.length() == 0, "empty base64 -> 0 bytes")

  // `data:base64,abc` without `;` is NOT base64 per Fetch Standard §6
  let d8 = match parse_data_url("data:base64,abc") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "data:base64 without semicolon: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(!d8.is_base64, "no semicolon means not base64")
  debug_assert(bytes_eq_str(d8.body, "abc"), "literal abc")
}

///|
test "data_url_invalid_base64_rejected" {
  let bad = [
    "data:;base64,A",
    "data:;base64,AAAAA",
    "data:;base64,YQ=",
    "data:;base64,====",
    "data:;base64,Y=Q=",
    "data:;base64,SGVs!G8=",
    "data:;base64,SGVs-G8=",
    "data:;base64,SGVs_G8=",
    "data:;base64,SGVs%FFG8=",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse_data_url(bad[i]) {
      Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::InvalidBase64), "must be InvalidBase64: " + bad[i])
      Ok(_) => debug_assert(false, "must reject invalid base64: " + bad[i])
    }
    i = i + 1
  }
}

///|
test "data_url_fragment_and_percent_edge_cases" {
  // Fragment stripped from both plain and base64
  let d1 = match parse_data_url("data:text/plain,hello%20world#section1") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "plain frag: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d1.body, "hello world"), "plain fragment stripped")

  let d2 = match parse_data_url("data:text/plain;base64,SGVsbG8=#ignored!") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "base64 frag: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d2.body, "Hello"), "base64 fragment stripped")

  // Literal '#' percent-encoded as %23 is preserved
  let d3 = match parse_data_url("data:text/plain,a%23b#frag") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "%23 preserved: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d3.body, "a#b"), "%23 decoded to #")

  // Invalid / truncated percent escapes kept literally
  let d4 = match parse_data_url("data:,100%25%ZZ%2%") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "malformed pct: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_str(d4.body, "100%%ZZ%2%"), "invalid % sequences kept literally")

  // Raw binary percent-decoded bytes
  let d5 = match parse_data_url("data:application/octet-stream,%00%01%fe%FF") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "raw binary pct: " + data_url_error_to_string(e))
      return ()
    }
  }
  debug_assert(bytes_eq_ints(d5.body, [0, 1, 254, 255]), "binary pct bytes")
}

///|
test "data_url_size_limit_and_dos_resistance" {
  // Exact limit allowed
  match parse_data_url_with_limit("data:,hello", 5) {
    Ok(v) => debug_assert(v.body.length() == 5, "exact limit ok")
    Err(_) => debug_assert(false, "exact limit should pass")
  }
  // Over limit rejected (plain)
  match parse_data_url_with_limit("data:,hello!", 5) {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::BodyTooLarge), "plain over limit")
    Ok(_) => debug_assert(false, "plain over limit must fail")
  }
  // Exact limit allowed (base64: "Hello" = 5 bytes)
  match parse_data_url_with_limit("data:;base64,SGVsbG8=", 5) {
    Ok(v) => debug_assert(bytes_eq_str(v.body, "Hello"), "base64 exact limit ok")
    Err(_) => debug_assert(false, "base64 exact limit should pass")
  }
  // Over limit rejected (base64: 5 bytes > 4)
  match parse_data_url_with_limit("data:;base64,SGVsbG8=", 4) {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::BodyTooLarge), "base64 over limit")
    Ok(_) => debug_assert(false, "base64 over limit must fail")
  }
  // Limit 0 allows empty, rejects 1 byte; negative rejects empty
  match parse_data_url_with_limit("data:,", 0) {
    Ok(v) => debug_assert(v.body.length() == 0, "limit 0 empty ok")
    Err(_) => debug_assert(false, "limit 0 empty should pass")
  }
  match parse_data_url_with_limit("data:,a", 0) {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::BodyTooLarge), "limit 0 non-empty rejected")
    Ok(_) => debug_assert(false, "limit 0 non-empty must fail")
  }
  match parse_data_url_with_limit("data:,", -1) {
    Err(e) => debug_assert(data_url_error_eq(e, DataUrlError::BodyTooLarge), "negative limit rejected")
    Ok(_) => debug_assert(false, "negative limit must fail")
  }

  // Linear O(N) large base64 payload (48 KB decoded)
  let sb = StringBuilder::with_capacity(65600)
  sb.write_string("data:application/octet-stream;base64,")
  let mut i = 0
  while i < 16384 {
    sb.write_string("AAAA")
    i = i + 1
  }
  match parse_data_url(sb.to_string()) {
    Ok(v) => debug_assert(v.body.length() == 49152, "48 KiB decoded")
    Err(e) => debug_assert(false, "large base64 failed: " + data_url_error_to_string(e))
  }
}
