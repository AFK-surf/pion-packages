///| Benchmark 1: Mixed URL batch parse + join + serialize (100,000 x 2 steady-state rounds).

import "url"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-url-bench/urls_100k.txt"
  }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let base = match url::Url::parse("https://base.example.com/a/b/c/index.html") {
    Ok(u) => u
    Err(_) => return 1
  }
  // Pre-split lines once so benchmark measures URL parsing & serialization, not file I/O
  let lines : Array[String] = []
  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    if end > pos {
      lines.push(content.slice(pos, end))
    }
    pos = end + 1
  }
  let nlines = lines.length()
  let mut count : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut first_out = ""
  let mut last_out = ""
  let mut round = 0
  while round < 2 {
    let mut i = 0
    while i < nlines {
      let line = lines[i]
      let u = if line.code_unit_at(0) == 46 {
        match base.join(line) {
          Ok(v) => v
          Err(_) => {
            io_println(world, "join error at " + i.to_string())
            return 1
          }
        }
      } else {
        match url::Url::parse(line) {
          Ok(v) => v
          Err(_) => {
            io_println(world, "parse error at " + i.to_string())
            return 1
          }
        }
      }
      let s = u.as_str()
      let slen = s.length()
      if count == 0L {
        first_out = s
      }
      last_out = s
      count = count + 1L
      total_bytes = total_bytes + slen.to_int64()
      let mut j = 0
      while j < slen {
        hash = (hash * 131L + s.code_unit_at(j).to_int64()) % 1000000007L
        j = j + 1
      }
      i = i + 1
    }
    round = round + 1
  }
  io_println(world, "count=" + count.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "first=" + first_out)
  io_println(world, "last=" + last_out)
  0
}
