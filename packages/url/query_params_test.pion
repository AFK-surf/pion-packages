///| QueryParams (URLSearchParams / application/x-www-form-urlencoded) and percent-encoding tests.

///|
test "query_params_basic_parse_and_get" {
  let qp = QueryParams::parse("?a=1&b=2&a=3&empty=&bare")
  debug_assert(qp.len() == 5, "len 5")
  debug_assert(!qp.is_empty(), "not empty")
  debug_assert(qp.has("a"), "has a")
  debug_assert(qp.has("empty"), "has empty")
  debug_assert(qp.has("bare"), "has bare")
  debug_assert(!qp.has("missing"), "no missing")
  match qp.get("a") {
    Some(v) => debug_assert(v == "1", "first a is 1")
    None => debug_assert(false, "expected Some(1)")
  }
  match qp.get("empty") {
    Some(v) => debug_assert(v == "", "empty is ''")
    None => debug_assert(false, "expected Some('')")
  }
  match qp.get("bare") {
    Some(v) => debug_assert(v == "", "bare is ''")
    None => debug_assert(false, "expected Some('')")
  }
  match qp.get("missing") {
    Some(_) => debug_assert(false, "expected None")
    None => ()
  }
  let all_a = qp.get_all("a")
  debug_assert(all_a.length() == 2, "two a values")
  debug_assert(all_a[0] == "1", "a[0]")
  debug_assert(all_a[1] == "3", "a[1]")
}

///|
test "query_params_plus_and_percent" {
  let qp = QueryParams::parse("q=hello+world&msg=a%20b%2Bc&u=%E4%BD%A0%E5%A5%BD")
  match qp.get("q") {
    Some(v) => debug_assert(v == "hello world", "plus to space")
    None => debug_assert(false, "q")
  }
  match qp.get("msg") {
    Some(v) => debug_assert(v == "a b+c", "percent decode")
    None => debug_assert(false, "msg")
  }
  match qp.get("u") {
    Some(v) => debug_assert(v == "你好", "utf8 decode")
    None => debug_assert(false, "u")
  }
  debug_assert(
    qp.to_string() == "q=hello+world&msg=a+b%2Bc&u=%E4%BD%A0%E5%A5%BD",
    "serialize roundtrip",
  )
}

///|
test "query_params_set_append_delete" {
  let qp = QueryParams::parse("a=1&b=2&a=3&c=4")
  qp.set("a", "99")
  debug_assert(qp.to_string() == "a=99&b=2&c=4", "set replaces first and removes rest")
  qp.set("d", "5")
  debug_assert(qp.to_string() == "a=99&b=2&c=4&d=5", "set appends if absent")
  qp.append("b", "22")
  debug_assert(qp.to_string() == "a=99&b=2&c=4&d=5&b=22", "append")
  qp.delete("b")
  debug_assert(qp.to_string() == "a=99&c=4&d=5", "delete all matching")
  qp.delete("nonexistent")
  debug_assert(qp.to_string() == "a=99&c=4&d=5", "delete absent noop")
}

///|
test "query_params_sort_stable_and_utf16" {
  let qp = QueryParams::parse("z=1&a=2&m=3&a=1&b=4")
  qp.sort()
  debug_assert(qp.to_string() == "a=2&a=1&b=4&m=3&z=1", "stable sort")
  // WHATWG URLSearchParams.sort() sorts by UTF-16 code units:
  // U+1F600 (0xD83D 0xDE00) < U+FFFD (0xFFFD) in UTF-16, whereas in UTF-8/Unicode U+1F600 > U+FFFD.
  let u = QueryParams::new()
  u.append("\u{FFFD}", "1")
  u.append("\u{1F600}", "2")
  u.sort()
  let ps = u.pairs()
  debug_assert(ps.length() == 2, "2 pairs")
  debug_assert(ps[0].0 == "\u{1F600}", "UTF-16 sort order: surrogate before U+FFFD")
  debug_assert(ps[1].0 == "\u{FFFD}", "UTF-16 sort order: U+FFFD second")
}

///|
test "query_params_empty_segments_and_special_chars" {
  let qp = QueryParams::parse("&&a=1&&&b=2&")
  debug_assert(qp.len() == 2, "skip empty segments")
  debug_assert(qp.to_string() == "a=1&b=2", "clean serialize")
  let qp2 = QueryParams::new()
  qp2.append("k", "*-._azAZ09 !~'()")
  // WHATWG application/x-www-form-urlencoded serializer keeps *, -, ., _, 0-9, A-Z, a-z; space -> +; everything else percent-encoded
  debug_assert(
    qp2.to_string() == "k=*-._azAZ09+%21%7E%27%28%29",
    "urlencoded charset",
  )
}

///|
test "percent_encode_and_decode_sets" {
  debug_assert(
    percent_encode("hello world/?#[]@", EncodeSet::Controls) == "hello world/?#[]@",
    "controls keeps ascii",
  )
  debug_assert(
    percent_encode("a b\"<>`c", EncodeSet::Fragment) == "a%20b%22%3C%3E%60c",
    "fragment set",
  )
  debug_assert(
    percent_encode("a b\"#<>'c", EncodeSet::Query) == "a%20b%22%23%3C%3E'c",
    "query set keeps apostrophe",
  )
  debug_assert(
    percent_encode("a b\"#<>'c", EncodeSet::SpecialQuery) == "a%20b%22%23%3C%3E%27c",
    "special query encodes apostrophe",
  )
  debug_assert(
    percent_encode("a?`{}^b", EncodeSet::Path) == "a%3F%60%7B%7D^b",
    "path set",
  )
  debug_assert(
    percent_encode("u:p/@;=[]|^", EncodeSet::Userinfo) == "u%3Ap%2F%40%3B%3D%5B%5D%7C%5E",
    "userinfo set",
  )
  debug_assert(
    percent_encode("a+b&c=d,e$f", EncodeSet::Component) == "a%2Bb%26c%3Dd%2Ce%24f",
    "component set",
  )
  debug_assert(percent_decode_str("hello%20%E4%BD%A0%E5%A5%BD%21") == "hello 你好!", "decode utf8")
  debug_assert(percent_decode_str("100%25+%2") == "100%+%2", "truncated percent passthrough")
  debug_assert(percent_decode_str("%FF%FE") == "\u{FFFD}\u{FFFD}", "invalid utf8 becomes U+FFFD")
}

///|
test "url_query_params_integration" {
  let u = match Url::parse("https://example.com/search?q=pion+lang&page=2&tag=fast&tag=safe#top") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return ()
    }
  }
  let qp = u.query_params()
  debug_assert(qp.len() == 4, "4 params")
  match qp.get("q") {
    Some(v) => debug_assert(v == "pion lang", "q value")
    None => debug_assert(false, "missing q")
  }
  let tags = qp.get_all("tag")
  debug_assert(tags.length() == 2 && tags[0] == "fast" && tags[1] == "safe", "tags")
}
