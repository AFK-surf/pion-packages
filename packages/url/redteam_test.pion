///| Day-1 red-team adversarial and security regression tests for `url`.

///| Helper: assert a serialized URL contains zero raw C0 controls, CR, LF, TAB, or DEL.
fn assert_no_raw_controls(s : String, label : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    debug_assert(b >= 0x20 && b != 0x7F, label + ": raw control byte leaked")
    i = i + 1
  }
}

///|
test "redteam_long_path_linear_dot_segments" {
  // 50,000 `/a/..` segments -> 250KB path; must complete linearly without O(n^2) blowup.
  let sb = StringBuilder::with_capacity(260000)
  sb.write_string("https://example.com")
  let mut i = 0
  while i < 20000 {
    sb.write_string("/a/..")
    i = i + 1
  }
  sb.write_string("/final")
  let u = match Url::parse(sb.to_string()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(u.as_str() == "https://example.com/final", "collapsed to /final")
}

///|
test "redteam_massive_at_signs_linear" {
  // 10,000 `@` signs in authority: must be O(N), not quadratic backtracking.
  let sb = StringBuilder::with_capacity(10050)
  sb.write_string("https://")
  let mut i = 0
  while i < 10000 {
    sb.write_byte((64).to_byte())
    i = i + 1
  }
  sb.write_string("example.com/p")
  let u = match Url::parse(sb.to_string()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(u.hostname() == "example.com", "host is example.com")
  debug_assert(u.path() == "/p", "path is /p")
}

///|
test "redteam_massive_percent_and_slashes" {
  let sb = StringBuilder::with_capacity(30050)
  sb.write_string("https://example.com/")
  let mut i = 0
  while i < 10000 {
    sb.write_string("%2")
    i = i + 1
  }
  let u = match Url::parse(sb.to_string()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(u.path().length() == 20001, "path preserved linearly")
}

///|
test "redteam_ipv4_overflow_and_malformed" {
  let bad = [
    "http://999999999999999999999999999999999999999/",
    "http://0xffffffffffffffffffffffffffffffff/",
    "http://0377777777777777777777777777777777777/",
    "http://4294967296/",
    "http://1.2.3.256/",
    "http://1.2.65536/",
    "http://1.16777216/",
    "http://1.2.3.4.5/",
    "http://1.2.3.0x100/",
    "http://0x100000000/",
    "http://08/",
    "http://1.2.3.09/",
  ]
  let mut i = 0
  while i < bad.length() {
    match Url::parse(bad[i]) {
      Ok(u) => debug_assert(false, "expected Err for " + bad[i] + ", got " + u.as_str())
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "redteam_ipv6_overflow_and_malformed" {
  let bad = [
    "http://[:::]",
    "http://[1:2:3:4:5:6:7:8:9]",
    "http://[::1:2:3:4:5:6:7:8]",
    "http://[1::2::3]",
    "http://[::ffff:256.0.0.1]",
    "http://[::ffff:1.2.3.4.5]",
    "http://[10000::1]",
    "http://[gggg::1]",
    "http://[::1",
    "http://[]",
    "http://[:1]",
    "http://[1:]",
  ]
  let mut i = 0
  while i < bad.length() {
    match Url::parse(bad[i]) {
      Ok(u) => debug_assert(false, "expected Err for " + bad[i] + ", got " + u.as_str())
      Err(_) => ()
    }
    i = i + 1
  }
  // 20,000 colons inside brackets must fail fast without panic
  let sb = StringBuilder::with_capacity(20020)
  sb.write_string("http://[")
  let mut j = 0
  while j < 20000 {
    sb.write_byte((58).to_byte())
    j = j + 1
  }
  sb.write_string("]")
  match Url::parse(sb.to_string()) {
    Ok(_) => debug_assert(false, "expected Err for 20k colons")
    Err(_) => ()
  }
}

///|
test "redteam_punycode_overflow_and_malformed" {
  let bad = [
    "http://xn--99999999999999999999999999999999999999999/",
    "http://xn---/",
    "http://xn--a-99999999999999999999999999999999/",
    "http://xn--zzzzzzzzzzzzzzzzzzzzzzzz/",
    "http://xn--/",
    "http://xn--a/",
  ]
  let mut i = 0
  while i < bad.length() {
    match Url::parse(bad[i]) {
      Ok(u) => debug_assert(false, "expected Err for " + bad[i] + ", got " + u.as_str())
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "redteam_no_c0_control_crlf_tab_smuggling" {
  let inputs = [
    "https://example.com/a\r\nX-Injected: 1",
    "https://example.com/a\tb\nc\rd",
    "https://example.com/path?q=1\r\nSet-Cookie: a=b#frag\r\n",
    "https://user\r\n:pass\t@example.com/p",
    "mailto:user@example.com?subject=hi\r\nBcc:evil@x.com",
  ]
  let mut i = 0
  while i < inputs.length() {
    match Url::parse(inputs[i]) {
      Ok(u) => assert_no_raw_controls(u.as_str(), "parse " + i.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
  // Test all bytes 0x00..0x1F and 0x7F in path, query, fragment, username, password
  let sb = StringBuilder::with_capacity(64)
  let mut b = 0
  while b < 0x20 {
    sb.write_byte(b.to_byte())
    b = b + 1
  }
  sb.write_byte((0x7F).to_byte())
  let ctrl = sb.to_string()
  let u = match Url::parse("https://example.com/p") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "base url")
      return ()
    }
  }
  u.set_path("/" + ctrl)
  assert_no_raw_controls(u.as_str(), "set_path ctrl")
  u.set_query(Some(ctrl))
  assert_no_raw_controls(u.as_str(), "set_query ctrl")
  u.set_fragment(Some(ctrl))
  assert_no_raw_controls(u.as_str(), "set_fragment ctrl")
  let _ = u.set_username(ctrl)
  assert_no_raw_controls(u.as_str(), "set_username ctrl")
  let _ = u.set_password(Some(ctrl))
  assert_no_raw_controls(u.as_str(), "set_password ctrl")
}

///|
test "redteam_port_overflow_and_bounds" {
  let bad = [
    "http://example.com:65536/",
    "http://example.com:999999999999999999999999999999/",
    "http://example.com:-1/",
    "http://example.com:+80/",
    "http://example.com:80a/",
  ]
  let mut i = 0
  while i < bad.length() {
    match Url::parse(bad[i]) {
      Ok(u) => debug_assert(false, "expected Err for " + bad[i] + ", got " + u.as_str())
      Err(_) => ()
    }
    i = i + 1
  }
  let ok0 = match Url::parse("http://example.com:0/") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "port 0 valid: " + e.to_string())
      return ()
    }
  }
  debug_assert(ok0.port_str() == "0", "port 0")
  let ok65535 = match Url::parse("http://example.com:65535/") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "port 65535 valid: " + e.to_string())
      return ()
    }
  }
  debug_assert(ok65535.port_str() == "65535", "port 65535")
}
