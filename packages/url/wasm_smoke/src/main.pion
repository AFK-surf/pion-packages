///| Wasm32 + Native smoke entry for the `url` package.

import "url"

///|
pub fn smoke() -> Int {
  let u = match url::Url::parse("https://user:pass@faß.ExAmPlE:443/a/b/../c?q=hello+world&k=1#frag") {
    Ok(v) => v
    Err(_) => return -1
  }
  let j = match u.join("../d/e?x=2") {
    Ok(v) => v
    Err(_) => return -2
  }
  let v6 = match url::Url::parse("http://[2001:0db8:0000:0000:0000:0000:0000:0001]:8080/p") {
    Ok(v) => v
    Err(_) => return -3
  }
  let qp = u.query_params()
  qp.append("z", "9")
  qp.sort()
  let qstr = qp.to_string()

  // RFC 2397 / Fetch §6 data: URL smoke checks
  let d1 = match url::parse_data_url("DATA:Text/Plain; charset=\"UTF-8\"; BASE64,SGVsbG8sIFdvcmxkIQ==#frag") {
    Ok(v) => v
    Err(_) => return -4
  }
  if d1.mime_type != "text/plain" || !d1.is_base64 || d1.body_string() != "Hello, World!" {
    return -5
  }
  let d2 = match url::parse_data_url_with_limit("data:;charset=utf-8,%E4%BD%A0%E5%A5%BD", 16) {
    Ok(v) => v
    Err(_) => return -6
  }
  if d2.body_string() != "你好" {
    return -7
  }
  match url::parse_data_url_with_limit("data:,too_long", 3) {
    Err(e) => if !url::data_url_error_eq(e, url::DataUrlError::BodyTooLarge) { return -8 }
    Ok(_) => return -9
  }
  u.href().length() + j.href().length() + v6.hostname().length() + qstr.length() + d1.body.length() + d2.body.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  io_println(world, "url_wasm_smoke=" + r.to_string())
  if r > 0 {
    0
  } else {
    1
  }
}
