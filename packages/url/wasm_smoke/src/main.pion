///| Wasm32 smoke entry for the `url` package.

import "url"

///|
pub fn smoke() -> Int {
  let u = match url::Url::parse("https://user:pass@faß.ExAmPlE:443/a/b/../c?q=hello+world&k=1#frag") {
    Ok(v) => v
    Err(_) => return -1
  }
  let j = match u.join("../d/e?x=2") {
    Ok(v) => v
    Err(_) => return -2
  }
  let v6 = match url::Url::parse("http://[2001:0db8:0000:0000:0000:0000:0000:0001]:8080/p") {
    Ok(v) => v
    Err(_) => return -3
  }
  let qp = u.query_params()
  qp.append("z", "9")
  qp.sort()
  let qstr = qp.to_string()
  u.href().length() + j.href().length() + v6.hostname().length() + qstr.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
