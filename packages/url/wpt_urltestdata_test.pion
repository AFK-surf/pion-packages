test "wpt_urltestdata_050_099" {
  check_wpt_ok(50, "http://foo.com/\\@", Some("http://example.org/foo/bar"), "http://foo.com//@", "http:", "", "", "foo.com", "foo.com", "", "//@", "", "", Some("http://foo.com"))
  check_wpt_ok(51, "http:\\\\foo.com\\", Some("http://example.org/foo/bar"), "http://foo.com/", "http:", "", "", "foo.com", "foo.com", "", "/", "", "", Some("http://foo.com"))
  check_wpt_ok(52, "http:\\\\a\\b:c\\d@foo.com\\", Some("http://example.org/foo/bar"), "http://a/b:c/d@foo.com/", "http:", "", "", "a", "a", "", "/b:c/d@foo.com/", "", "", Some("http://a"))
  check_wpt_ok(53, "http://a:b@c\\", None, "http://a:b@c/", "http:", "a", "b", "c", "c", "", "/", "", "", Some("http://c"))
  check_wpt_ok(54, "ws://a@b\\c", None, "ws://a@b/c", "ws:", "a", "", "b", "b", "", "/c", "", "", Some("ws://b"))
  check_wpt_ok(55, "foo:/", Some("http://example.org/foo/bar"), "foo:/", "foo:", "", "", "", "", "", "/", "", "", Some("null"))
  check_wpt_ok(56, "foo:/bar.com/", Some("http://example.org/foo/bar"), "foo:/bar.com/", "foo:", "", "", "", "", "", "/bar.com/", "", "", Some("null"))
  check_wpt_ok(57, "foo://///////", Some("http://example.org/foo/bar"), "foo://///////", "foo:", "", "", "", "", "", "///////", "", "", Some("null"))
  check_wpt_ok(58, "foo://///////bar.com/", Some("http://example.org/foo/bar"), "foo://///////bar.com/", "foo:", "", "", "", "", "", "///////bar.com/", "", "", Some("null"))
  check_wpt_ok(59, "foo:////://///", Some("http://example.org/foo/bar"), "foo:////://///", "foo:", "", "", "", "", "", "//://///", "", "", Some("null"))
  check_wpt_ok(60, "c:/foo", Some("http://example.org/foo/bar"), "c:/foo", "c:", "", "", "", "", "", "/foo", "", "", Some("null"))
  check_wpt_ok(61, "//foo/bar", Some("http://example.org/foo/bar"), "http://foo/bar", "http:", "", "", "foo", "foo", "", "/bar", "", "", Some("http://foo"))
  check_wpt_ok(62, "http://foo/path;a??e#f#g", Some("http://example.org/foo/bar"), "http://foo/path;a??e#f#g", "http:", "", "", "foo", "foo", "", "/path;a", "??e", "#f#g", Some("http://foo"))
  check_wpt_ok(63, "http://foo/abcd?efgh?ijkl", Some("http://example.org/foo/bar"), "http://foo/abcd?efgh?ijkl", "http:", "", "", "foo", "foo", "", "/abcd", "?efgh?ijkl", "", Some("http://foo"))
  check_wpt_ok(64, "http://foo/abcd#foo?bar", Some("http://example.org/foo/bar"), "http://foo/abcd#foo?bar", "http:", "", "", "foo", "foo", "", "/abcd", "", "#foo?bar", Some("http://foo"))
  check_wpt_ok(65, "[61:24:74]:98", Some("http://example.org/foo/bar"), "http://example.org/foo/[61:24:74]:98", "http:", "", "", "example.org", "example.org", "", "/foo/[61:24:74]:98", "", "", Some("http://example.org"))
  check_wpt_ok(66, "http:[61:27]/:foo", Some("http://example.org/foo/bar"), "http://example.org/foo/[61:27]/:foo", "http:", "", "", "example.org", "example.org", "", "/foo/[61:27]/:foo", "", "", Some("http://example.org"))
  check_wpt_fail(67, "http://[1::2]:3:4", Some("http://example.org/foo/bar"))
  check_wpt_fail(68, "http://2001::1", Some("http://example.org/foo/bar"))
  check_wpt_fail(69, "http://2001::1]", Some("http://example.org/foo/bar"))
  check_wpt_fail(70, "http://2001::1]:80", Some("http://example.org/foo/bar"))
  check_wpt_ok(71, "http://[2001::1]", Some("http://example.org/foo/bar"), "http://[2001::1]/", "http:", "", "", "[2001::1]", "[2001::1]", "", "/", "", "", Some("http://[2001::1]"))
  check_wpt_ok(72, "http://[::127.0.0.1]", Some("http://example.org/foo/bar"), "http://[::7f00:1]/", "http:", "", "", "[::7f00:1]", "[::7f00:1]", "", "/", "", "", Some("http://[::7f00:1]"))
  check_wpt_fail(73, "http://[::127.0.0.1.]", Some("http://example.org/foo/bar"))
  check_wpt_ok(74, "http://[0:0:0:0:0:0:13.1.68.3]", Some("http://example.org/foo/bar"), "http://[::d01:4403]/", "http:", "", "", "[::d01:4403]", "[::d01:4403]", "", "/", "", "", Some("http://[::d01:4403]"))
  check_wpt_ok(75, "http://[2001::1]:80", Some("http://example.org/foo/bar"), "http://[2001::1]/", "http:", "", "", "[2001::1]", "[2001::1]", "", "/", "", "", Some("http://[2001::1]"))
  check_wpt_ok(76, "http:/example.com/", Some("http://example.org/foo/bar"), "http://example.org/example.com/", "http:", "", "", "example.org", "example.org", "", "/example.com/", "", "", Some("http://example.org"))
  check_wpt_ok(77, "ftp:/example.com/", Some("http://example.org/foo/bar"), "ftp://example.com/", "ftp:", "", "", "example.com", "example.com", "", "/", "", "", Some("ftp://example.com"))
