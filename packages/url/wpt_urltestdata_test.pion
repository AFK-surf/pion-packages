test "wpt_urltestdata_000_049" {
  check_wpt_ok(0, "http://example\t.\norg", Some("http://example.org/foo/bar"), "http://example.org/", "http:", "", "", "example.org", "example.org", "", "/", "", "", Some("http://example.org"))
  check_wpt_ok(1, "http://user:pass@foo:21/bar;par?b#c", Some("http://example.org/foo/bar"), "http://user:pass@foo:21/bar;par?b#c", "http:", "user", "pass", "foo:21", "foo", "21", "/bar;par", "?b", "#c", Some("http://foo:21"))
  check_wpt_ok(2, "https://test:@test", None, "https://test@test/", "https:", "test", "", "test", "test", "", "/", "", "", Some("https://test"))
  check_wpt_ok(3, "https://:@test", None, "https://test/", "https:", "", "", "test", "test", "", "/", "", "", Some("https://test"))
  check_wpt_ok(4, "non-special://test:@test/x", None, "non-special://test@test/x", "non-special:", "test", "", "test", "test", "", "/x", "", "", Some("null"))
  check_wpt_ok(5, "non-special://:@test/x", None, "non-special://test/x", "non-special:", "", "", "test", "test", "", "/x", "", "", Some("null"))
  check_wpt_ok(6, "http:foo.com", Some("http://example.org/foo/bar"), "http://example.org/foo/foo.com", "http:", "", "", "example.org", "example.org", "", "/foo/foo.com", "", "", Some("http://example.org"))
  check_wpt_ok(7, "\t   :foo.com   \n", Some("http://example.org/foo/bar"), "http://example.org/foo/:foo.com", "http:", "", "", "example.org", "example.org", "", "/foo/:foo.com", "", "", Some("http://example.org"))
  check_wpt_ok(8, " foo.com  ", Some("http://example.org/foo/bar"), "http://example.org/foo/foo.com", "http:", "", "", "example.org", "example.org", "", "/foo/foo.com", "", "", Some("http://example.org"))
  check_wpt_ok(9, "a:\t foo.com", Some("http://example.org/foo/bar"), "a: foo.com", "a:", "", "", "", "", "", " foo.com", "", "", Some("null"))
  check_wpt_ok(10, "http://f:21/ b ? d # e ", Some("http://example.org/foo/bar"), "http://f:21/%20b%20?%20d%20#%20e", "http:", "", "", "f:21", "f", "21", "/%20b%20", "?%20d%20", "#%20e", Some("http://f:21"))
  check_wpt_ok(11, "lolscheme:x x#x x", None, "lolscheme:x x#x%20x", "lolscheme:", "", "", "", "", "", "x x", "", "#x%20x", None)
  check_wpt_ok(12, "http://f:/c", Some("http://example.org/foo/bar"), "http://f/c", "http:", "", "", "f", "f", "", "/c", "", "", Some("http://f"))
  check_wpt_ok(13, "http://f:0/c", Some("http://example.org/foo/bar"), "http://f:0/c", "http:", "", "", "f:0", "f", "0", "/c", "", "", Some("http://f:0"))
  check_wpt_ok(14, "http://f:00000000000000/c", Some("http://example.org/foo/bar"), "http://f:0/c", "http:", "", "", "f:0", "f", "0", "/c", "", "", Some("http://f:0"))
  check_wpt_ok(15, "http://f:00000000000000000000080/c", Some("http://example.org/foo/bar"), "http://f/c", "http:", "", "", "f", "f", "", "/c", "", "", Some("http://f"))
  check_wpt_fail(16, "http://f:b/c", Some("http://example.org/foo/bar"))
  check_wpt_fail(17, "http://f: /c", Some("http://example.org/foo/bar"))
  check_wpt_ok(18, "http://f:\n/c", Some("http://example.org/foo/bar"), "http://f/c", "http:", "", "", "f", "f", "", "/c", "", "", Some("http://f"))
  check_wpt_fail(19, "http://f:fifty-two/c", Some("http://example.org/foo/bar"))
  check_wpt_fail(20, "http://f:999999/c", Some("http://example.org/foo/bar"))
  check_wpt_fail(21, "non-special://f:999999/c", Some("http://example.org/foo/bar"))
  check_wpt_fail(22, "http://f: 21 / b ? d # e ", Some("http://example.org/foo/bar"))
  check_wpt_ok(23, "", Some("http://example.org/foo/bar"), "http://example.org/foo/bar", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "", Some("http://example.org"))
  check_wpt_ok(24, "  \t", Some("http://example.org/foo/bar"), "http://example.org/foo/bar", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "", Some("http://example.org"))
