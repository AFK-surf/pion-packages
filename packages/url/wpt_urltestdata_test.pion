  check_wpt_ok(31, ":#", Some("http://example.org/foo/bar"), "http://example.org/foo/:#", "http:", "", "", "example.org", "example.org", "", "/foo/:", "", "", Some("http://example.org"))
  check_wpt_ok(32, "#", Some("http://example.org/foo/bar"), "http://example.org/foo/bar#", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "", Some("http://example.org"))
  check_wpt_ok(33, "#/", Some("http://example.org/foo/bar"), "http://example.org/foo/bar#/", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "#/", Some("http://example.org"))
  check_wpt_ok(34, "#\\", Some("http://example.org/foo/bar"), "http://example.org/foo/bar#\\", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "#\\", Some("http://example.org"))
  check_wpt_ok(35, "#;?", Some("http://example.org/foo/bar"), "http://example.org/foo/bar#;?", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "#;?", Some("http://example.org"))
  check_wpt_ok(36, "?", Some("http://example.org/foo/bar"), "http://example.org/foo/bar?", "http:", "", "", "example.org", "example.org", "", "/foo/bar", "", "", Some("http://example.org"))
  check_wpt_ok(37, "/", Some("http://example.org/foo/bar"), "http://example.org/", "http:", "", "", "example.org", "example.org", "", "/", "", "", Some("http://example.org"))
  check_wpt_ok(38, ":23", Some("http://example.org/foo/bar"), "http://example.org/foo/:23", "http:", "", "", "example.org", "example.org", "", "/foo/:23", "", "", Some("http://example.org"))
