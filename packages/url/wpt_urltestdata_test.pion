///| Official WPT `urltestdata.json` compliance suite (869 vectors, verbatim from servo/rust-url).

///|
fn wpt_bytes(bs : Array[Int]) -> String {
  let sb = StringBuilder::with_capacity(bs.length())
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn check_wpt_ok(
  idx : Int,
  input : String,
  base : Option[String],
  exp_href : String,
  exp_protocol : String,
  exp_username : String,
  exp_password : String,
  exp_host : String,
  exp_hostname : String,
  exp_port : String,
  exp_pathname : String,
  exp_search : String,
  exp_hash : String,
  exp_origin : Option[String],
) -> Unit {
  let base_url : Option[Url] = match base {
    Some(b) => match Url::parse(b) {
      Ok(u) => Some(u)
      Err(e) => {
        debug_assert(false, "case #" + idx.to_string() + " base parse failed: " + e.to_string())
        return ()
      }
    }
    None => None
  }
  let u = match Url::parse_with_base(input, base_url) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "case #" + idx.to_string() + " expected Ok, got Err: " + e.to_string())
      return ()
    }
  }
  let p = "case #" + idx.to_string() + " "
  debug_assert(u.href() == exp_href, p + "href: got " + u.href() + " want " + exp_href)
  debug_assert(u.protocol() == exp_protocol, p + "protocol: got " + u.protocol() + " want " + exp_protocol)
  debug_assert(u.username() == exp_username, p + "username: got " + u.username() + " want " + exp_username)
  debug_assert(u.password_str() == exp_password, p + "password: got " + u.password_str() + " want " + exp_password)
  debug_assert(u.host_and_port() == exp_host, p + "host: got " + u.host_and_port() + " want " + exp_host)
  debug_assert(u.hostname() == exp_hostname, p + "hostname: got " + u.hostname() + " want " + exp_hostname)
  debug_assert(u.port_str() == exp_port, p + "port: got " + u.port_str() + " want " + exp_port)
  debug_assert(u.pathname() == exp_pathname, p + "pathname: got " + u.pathname() + " want " + exp_pathname)
  debug_assert(u.search() == exp_search, p + "search: got " + u.search() + " want " + exp_search)
  debug_assert(u.hash() == exp_hash, p + "hash: got " + u.hash() + " want " + exp_hash)
  match exp_origin {
    Some(eo) => {
      let got_o = origin_ascii_serialization(u.origin())
      debug_assert(got_o == eo, p + "origin: got " + got_o + " want " + eo)
    }
    None => ()
  }
}

///|
fn check_wpt_fail(idx : Int, input : String, base : Option[String]) -> Unit {
  let base_url : Option[Url] = match base {
    Some(b) => match Url::parse(b) {
      Ok(u) => Some(u)
      Err(_) => return ()
    }
    None => None
  }
  match Url::parse_with_base(input, base_url) {
    Ok(u) => debug_assert(false, "case #" + idx.to_string() + " expected failure, got " + u.href())
    Err(_) => ()
  }
}

