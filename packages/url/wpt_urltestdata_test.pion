  check_wpt_ok(40, "\\x", Some("http://example.org/foo/bar"), "http://example.org/x", "http:", "", "", "example.org", "example.org", "", "/x", "", "", Some("http://example.org"))
  check_wpt_ok(41, "\\\\x\\hello", Some("http://example.org/foo/bar"), "http://x/hello", "http:", "", "", "x", "x", "", "/hello", "", "", Some("http://x"))
  check_wpt_ok(42, "::", Some("http://example.org/foo/bar"), "http://example.org/foo/::", "http:", "", "", "example.org", "example.org", "", "/foo/::", "", "", Some("http://example.org"))
  check_wpt_ok(43, "::23", Some("http://example.org/foo/bar"), "http://example.org/foo/::23", "http:", "", "", "example.org", "example.org", "", "/foo/::23", "", "", Some("http://example.org"))
  check_wpt_ok(44, "foo://", Some("http://example.org/foo/bar"), "foo://", "foo:", "", "", "", "", "", "", "", "", Some("null"))
  check_wpt_ok(45, "http://a:b@c:29/d", Some("http://example.org/foo/bar"), "http://a:b@c:29/d", "http:", "a", "b", "c:29", "c", "29", "/d", "", "", Some("http://c:29"))
  check_wpt_ok(46, "http::@c:29", Some("http://example.org/foo/bar"), "http://example.org/foo/:@c:29", "http:", "", "", "example.org", "example.org", "", "/foo/:@c:29", "", "", Some("http://example.org"))
  check_wpt_ok(47, "http://&a:foo(b]c@d:2/", Some("http://example.org/foo/bar"), "http://&a:foo(b%5Dc@d:2/", "http:", "&a", "foo(b%5Dc", "d:2", "d", "2", "/", "", "", Some("http://d:2"))
  check_wpt_ok(48, "http://::@c@d:2", Some("http://example.org/foo/bar"), "http://:%3A%40c@d:2/", "http:", "", "%3A%40c", "d:2", "d", "2", "/", "", "", Some("http://d:2"))
  check_wpt_ok(49, "http://foo.com:b@d/", Some("http://example.org/foo/bar"), "http://foo.com:b@d/", "http:", "foo.com", "b", "d", "d", "", "/", "", "", Some("http://d"))
}

