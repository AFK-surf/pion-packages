  check_wpt_ok(79, "madeupscheme:/example.com/", Some("http://example.org/foo/bar"), "madeupscheme:/example.com/", "madeupscheme:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(80, "file:/example.com/", Some("http://example.org/foo/bar"), "file:///example.com/", "file:", "", "", "", "", "", "/example.com/", "", "", None)
  check_wpt_fail(81, "file://example:1/", None)
  check_wpt_fail(82, "file://example:test/", None)
  check_wpt_fail(83, "file://example%/", None)
  check_wpt_fail(84, "file://[example]/", None)
  check_wpt_ok(85, "ftps:/example.com/", Some("http://example.org/foo/bar"), "ftps:/example.com/", "ftps:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(86, "gopher:/example.com/", Some("http://example.org/foo/bar"), "gopher:/example.com/", "gopher:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(87, "ws:/example.com/", Some("http://example.org/foo/bar"), "ws://example.com/", "ws:", "", "", "example.com", "example.com", "", "/", "", "", Some("ws://example.com"))
  check_wpt_ok(88, "wss:/example.com/", Some("http://example.org/foo/bar"), "wss://example.com/", "wss:", "", "", "example.com", "example.com", "", "/", "", "", Some("wss://example.com"))
  check_wpt_ok(89, "data:/example.com/", Some("http://example.org/foo/bar"), "data:/example.com/", "data:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(90, "javascript:/example.com/", Some("http://example.org/foo/bar"), "javascript:/example.com/", "javascript:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(91, "mailto:/example.com/", Some("http://example.org/foo/bar"), "mailto:/example.com/", "mailto:", "", "", "", "", "", "/example.com/", "", "", Some("null"))
  check_wpt_ok(92, "http:example.com/", Some("http://example.org/foo/bar"), "http://example.org/foo/example.com/", "http:", "", "", "example.org", "example.org", "", "/foo/example.com/", "", "", Some("http://example.org"))
  check_wpt_ok(93, "ftp:example.com/", Some("http://example.org/foo/bar"), "ftp://example.com/", "ftp:", "", "", "example.com", "example.com", "", "/", "", "", Some("ftp://example.com"))
  check_wpt_ok(94, "https:example.com/", Some("http://example.org/foo/bar"), "https://example.com/", "https:", "", "", "example.com", "example.com", "", "/", "", "", Some("https://example.com"))
  check_wpt_ok(95, "madeupscheme:example.com/", Some("http://example.org/foo/bar"), "madeupscheme:example.com/", "madeupscheme:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(96, "ftps:example.com/", Some("http://example.org/foo/bar"), "ftps:example.com/", "ftps:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(97, "gopher:example.com/", Some("http://example.org/foo/bar"), "gopher:example.com/", "gopher:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(98, "ws:example.com/", Some("http://example.org/foo/bar"), "ws://example.com/", "ws:", "", "", "example.com", "example.com", "", "/", "", "", Some("ws://example.com"))
  check_wpt_ok(99, "wss:example.com/", Some("http://example.org/foo/bar"), "wss://example.com/", "wss:", "", "", "example.com", "example.com", "", "/", "", "", Some("wss://example.com"))
}

///|
test "wpt_urltestdata_100_149" {
  check_wpt_ok(100, "data:example.com/", Some("http://example.org/foo/bar"), "data:example.com/", "data:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(101, "javascript:example.com/", Some("http://example.org/foo/bar"), "javascript:example.com/", "javascript:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(102, "mailto:example.com/", Some("http://example.org/foo/bar"), "mailto:example.com/", "mailto:", "", "", "", "", "", "example.com/", "", "", Some("null"))
  check_wpt_ok(103, "/a/b/c", Some("http://example.org/foo/bar"), "http://example.org/a/b/c", "http:", "", "", "example.org", "example.org", "", "/a/b/c", "", "", Some("http://example.org"))
  check_wpt_ok(104, "/a/ /c", Some("http://example.org/foo/bar"), "http://example.org/a/%20/c", "http:", "", "", "example.org", "example.org", "", "/a/%20/c", "", "", Some("http://example.org"))
