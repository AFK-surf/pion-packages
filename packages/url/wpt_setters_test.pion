  check_wpt_setter(5, "port", "http://example.net/path", "8080/stuff", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(6, "port", "http://example.net/path", "8080?stuff", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(7, "port", "http://example.net/path", "8080#stuff", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(8, "port", "http://example.net/path", "8080\\stuff", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(9, "port", "view-source+http://example.net/path", "8080stuff2", Some("view-source+http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(10, "port", "http://example.net/path", "8080stuff2", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(11, "port", "http://example.net/path", "8080+2", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(12, "port", "http://example.net/path", "65535", Some("http://example.net:65535/path"), None, None, None, Some("example.net:65535"), Some("example.net"), Some("65535"), None, None, None)
  check_wpt_setter(13, "port", "http://example.net:8080/path", "65536", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(14, "port", "http://example.net:8080/path", "randomstring", Some("http://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(15, "port", "non-special://example.net:8080/path", "65536", Some("non-special://example.net:8080/path"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(16, "port", "file://test/", "12", Some("file://test/"), None, None, None, None, None, Some(""), None, None, None)
  check_wpt_setter(17, "port", "file://localhost/", "12", Some("file:///"), None, None, None, None, None, Some(""), None, None, None)
  check_wpt_setter(18, "port", "non-base:value", "12", Some("non-base:value"), None, None, None, None, None, Some(""), None, None, None)
  check_wpt_setter(19, "port", "sc:///", "12", Some("sc:///"), None, None, None, None, None, Some(""), None, None, None)
  check_wpt_setter(20, "port", "sc://x/", "12", Some("sc://x:12/"), None, None, None, None, None, Some("12"), None, None, None)
  check_wpt_setter(21, "port", "javascript://x/", "12", Some("javascript://x:12/"), None, None, None, None, None, Some("12"), None, None, None)
  check_wpt_setter(22, "port", "https://domain.com:443", "\t8080", None, None, None, None, None, None, Some("8080"), None, None, None)
  check_wpt_setter(23, "port", "wpt++://domain.com:443", "\t8080", None, None, None, None, None, None, Some("8080"), None, None, None)
  check_wpt_setter(24, "port", "https://www.google.com:4343", "4wpt", None, None, None, None, None, None, Some("4"), None, None, None)
