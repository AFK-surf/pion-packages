test "wpt_setters_port" {
  check_wpt_setter(0, "port", "http://example.net", "8080", Some("http://example.net:8080/"), None, None, None, Some("example.net:8080"), Some("example.net"), Some("8080"), None, None, None)
  check_wpt_setter(1, "port", "http://example.net:8080", "", Some("http://example.net/"), None, None, None, Some("example.net"), Some("example.net"), Some(""), None, None, None)
  check_wpt_setter(2, "port", "http://example.net:8080", "80", Some("http://example.net/"), None, None, None, Some("example.net"), Some("example.net"), Some(""), None, None, None)
  check_wpt_setter(3, "port", "https://example.net:4433", "443", Some("https://example.net/"), None, None, None, Some("example.net"), Some("example.net"), Some(""), None, None, None)
