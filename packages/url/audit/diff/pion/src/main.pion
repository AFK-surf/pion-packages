///| Differential driver for the `url` red-team audit (Pion side).
///| Protocol: identical to `audit/diff/rust/src/main.rs` — one case per line,
///| TAB-separated lowercase-hex UTF-8 fields (`~` = None); one output line per case.

import "url"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> Option[String] {
  if s == "~" {
    return None
  }
  let n = s.length() / 2
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  Some(sb.to_string())
}

///|
fn write_hex(sb : StringBuilder, s : String) -> Unit {
  let digits = "0123456789abcdef"
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
}

///|
fn dump(u : url::Url, out : Array[String]) -> Unit {
  out.push("OK")
  out.push(u.href())
  out.push(u.protocol())
  out.push(u.username())
  out.push(u.password_str())
  out.push(u.host_and_port())
  out.push(u.hostname())
  out.push(u.port_str())
  out.push(u.pathname())
  out.push(u.search())
  out.push(u.hash())
  out.push(url::origin_ascii_serialization(u.origin()))
  out.push(if u.cannot_be_a_base() { "opaque" } else { "base" })
}

///|
fn ok_unit(r : Result[Unit, url::ParseError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn parse_port(p : String) -> Option[Int] {
  let n = p.length()
  if n == 0 || n > 5 {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let c = p.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  if v > 65535 {
    None
  } else {
    Some(v)
  }
}

///|
fn setter(u : url::Url, name : String, v : Option[String]) -> String {
  let s = match v {
    Some(x) => x
    None => ""
  }
  let ok = if name == "protocol" {
    ok_unit(u.set_protocol(s))
  } else if name == "username" {
    ok_unit(u.set_username(s))
  } else if name == "password" {
    ok_unit(u.set_password_str(s))
  } else if name == "host" {
    ok_unit(u.set_host_and_port(s))
  } else if name == "hostname" {
    ok_unit(u.set_hostname(s))
  } else if name == "port" {
    ok_unit(u.set_port_str(s))
  } else if name == "pathname" {
    u.set_pathname(s)
    true
  } else if name == "search" {
    u.set_search(s)
    true
  } else if name == "hash" {
    u.set_hash(s)
    true
  } else if name == "href" {
    ok_unit(u.set_href(s))
  } else if name == "set_scheme" {
    ok_unit(u.set_scheme(s))
  } else if name == "set_username" {
    ok_unit(u.set_username(s))
  } else if name == "set_password" {
    ok_unit(u.set_password(v))
  } else if name == "set_host" {
    ok_unit(u.set_host(v))
  } else if name == "set_port" {
    match v {
      None => ok_unit(u.set_port(None))
      Some(p) =>
      match parse_port(p) {
        Some(n) => ok_unit(u.set_port(Some(n)))
        None => false
      }
    }
  } else if name == "set_path" {
    u.set_path(s)
    true
  } else if name == "set_query" {
    u.set_query(v)
    true
  } else if name == "set_fragment" {
    u.set_fragment(v)
    true
  } else {
    false
  }
  if ok {
    "SETOK"
  } else {
    "SETERR"
  }
}

///|
fn arg(f : Array[Option[String]], i : Int) -> String {
  if i >= f.length() {
    return ""
  }
  match f[i] {
    Some(x) => x
    None => ""
  }
}

///|
fn run(f : Array[Option[String]], out : Array[String]) -> Unit {
  let op = arg(f, 0)
  // L<op>: run <op> but only emit each output field's byte length (compact
  // output for the adversarial performance workloads).
  if op.length() > 1 && op.code_unit_at(0) == 76 {
    let g : Array[Option[String]] = [Some(op.slice(1, op.length()))]
    let mut k = 1
    while k < f.length() {
      g.push(f[k])
      k = k + 1
    }
    let inner : Array[String] = []
    run(g, inner)
    let mut j = 0
    while j < inner.length() {
      out.push(inner[j].length().to_string())
      j = j + 1
    }
    return ()
  }
  if op == "P" {
    match url::Url::parse(arg(f, 1)) {
      Ok(u) => dump(u, out)
      Err(_) => out.push("ERR")
    }
  } else if op == "J" {
    match url::Url::parse(arg(f, 1)) {
      Ok(b) =>
      match b.join(arg(f, 2)) {
        Ok(u) => dump(u, out)
        Err(_) => out.push("ERR")
      }
      Err(_) => out.push("BASEERR")
    }
  } else if op == "S" {
    match url::Url::parse(arg(f, 1)) {
      Ok(u) => {
        let mut i = 2
        while i < f.length() {
          let v = if i + 1 < f.length() { f[i + 1] } else { None }
          out.push(setter(u, arg(f, i), v))
          i = i + 2
        }
        dump(u, out)
      }
      Err(_) => out.push("BASEERR")
    }
  } else if op == "R" {
    // serialization round-trip: parse (or join onto base) -> href1 -> parse(href1) -> href2
    let r = match f[1] {
      None => url::Url::parse(arg(f, 2))
      Some(b) =>
      match url::Url::parse(b) {
        Ok(bu) => bu.join(arg(f, 2))
        Err(_) => {
          out.push("BASEERR")
          return ()
        }
      }
    }
    match r {
      Err(_) => out.push("ERR")
      Ok(u) =>
      match url::Url::parse(u.href()) {
        Ok(v) => {
          let o1 : Array[String] = []
          dump(u, o1)
          let o2 : Array[String] = []
          dump(v, o2)
          out.push("OK")
          let mut i = 1
          while i < o1.length() {
            out.push(o1[i])
            i = i + 1
          }
          i = 1
          while i < o2.length() {
            out.push(o2[i])
            i = i + 1
          }
        }
        Err(_) => {
          out.push("REPARSE-ERR")
          out.push(u.href())
        }
      }
    }
  } else if op == "H" {
    // parse and return only the serialization (perf workloads)
    match url::Url::parse(arg(f, 1)) {
      Ok(u) => out.push(u.href())
      Err(_) => out.push("ERR")
    }
  } else if op == "JH" {
    match url::Url::parse(arg(f, 1)) {
      Ok(b) =>
      match b.join(arg(f, 2)) {
        Ok(u) => out.push(u.href())
        Err(_) => out.push("ERR")
      }
      Err(_) => out.push("BASEERR")
    }
  } else if op == "N" {
    // no-op (measures driver I/O + hex decoding overhead for the perf workloads)
    out.push("0")
  } else if op == "A" {
    match url::domain_to_ascii(arg(f, 1)) {
      Ok(s) => out.push(s)
      Err(_) => out.push("")
    }
  } else if op == "U" {
    out.push(url::domain_to_unicode(arg(f, 1)))
  } else if op == "D" {
    out.push(url::percent_decode_str(arg(f, 1)))
  } else if op == "Q" {
    let qp = url::QueryParams::parse(arg(f, 1))
    let pairs = qp.pairs()
    out.push(pairs.length().to_string())
    let mut i = 0
    while i < pairs.length() {
      let (k, v) = pairs[i]
      out.push(k)
      out.push(v)
      i = i + 1
    }
    out.push(qp.to_string())
  } else if op == "M" {
    // URLSearchParams mutation script (see rust driver)
    let qp = url::QueryParams::parse(arg(f, 1))
    let mut i = 2
    while i < f.length() {
      let o = arg(f, i)
      if o == "d" {
        qp.delete(arg(f, i + 1))
        i = i + 2
      } else if o == "s" {
        qp.set(arg(f, i + 1), arg(f, i + 2))
        i = i + 3
      } else if o == "a" {
        qp.append(arg(f, i + 1), arg(f, i + 2))
        i = i + 3
      } else if o == "sort" {
        qp.sort()
        i = i + 1
      } else if o == "g" {
        match qp.get(arg(f, i + 1)) {
          Some(v) => out.push(v)
          None => out.push("<none>")
        }
        i = i + 2
      } else if o == "h" {
        out.push(if qp.has(arg(f, i + 1)) { "true" } else { "false" })
        i = i + 2
      } else {
        out.push("UNKNOWN-M-OP")
        return ()
      }
    }
    out.push(qp.len().to_string())
    out.push(qp.to_string())
  } else {
    out.push("UNKNOWN-OP")
  }
}

///|
pub fn main(world : World) -> Int {
  let mut sb = StringBuilder::with_capacity(1 << 20)
  while true {
    let line = match io_read_line(world) {
      Some(l) => l
      None => break
    }
    if line.length() == 0 {
      continue
    }
    let f : Array[Option[String]] = []
    let n = line.length()
    let mut st = 0
    let mut i = 0
    while i <= n {
      if i == n || line.code_unit_at(i) == 9 {
        f.push(unhex(line.slice(st, i)))
        st = i + 1
      }
      i = i + 1
    }
    let out : Array[String] = []
    run(f, out)
    let mut j = 0
    while j < out.length() {
      if j > 0 {
        sb.write_byte((9).to_byte())
      }
      write_hex(sb, out[j])
      j = j + 1
    }
    sb.write_byte((10).to_byte())
    if sb.length() > (1 << 20) {
      io_print(world, sb.to_string())
      sb = StringBuilder::with_capacity(1 << 20)
    }
  }
  io_print(world, sb.to_string())
  0
}
