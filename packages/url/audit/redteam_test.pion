///| Red-team regression tests for packages/url @ fb85513 (branch feat/pkg-url).
///
/// Every `redteam_*` test asserts the behaviour of the reference implementation
/// Rust `url v2.5.9` (+ `idna 1.1.0`), cross-checked against Node.js `URL` (Ada) and
/// the Unicode IdnaTestV2.txt conformance file — a FAILURE here is the evidence.
/// `control_*` tests are attacks that Pion survived; they must keep passing.
/// Quadratic-time findings cannot live in a unit test that must finish quickly:
/// they are reproduced with timings by ../run_audit.sh (see REPORT.md P1).

import "url"

// ---------------------------------------------------------------------------
// F-1 (P0) `.%2e` / `.%2E` dot-segments are never removed for special schemes.
// WHATWG "double-dot URL path segment" = `..`, `.%2e`, `%2e.`, `%2e%2e` (any case).
// `try_fast_parse_absolute` (src/parser.pion:1391-1393) sets `path_has_dots` for a
// segment starting with `.` and its inline resolver (src/parser.pion:1706-1724) only
// knows the literal `.` / `..`, so `.%2e` survives. Path-based access control that
// is enforced on Pion's view of the path is bypassable (servers/browsers see `/admin`).
// ---------------------------------------------------------------------------

///|
test "redteam_dot_pct2e_segment_is_parent_special" {
  // rust/node: https://h/admin
  expect_eq(href_of("https://h/static/.%2e/admin"), "https://h/admin", "/static/.%2e/admin")
}

///|
test "redteam_dot_pct2E_segment_is_parent_special" {
  expect_eq(href_of("http://h/a/.%2E/x"), "http://h/x", "/a/.%2E/x")
}

///|
test "redteam_dot_pct2e_trailing_segment" {
  // rust/node: https://h/a/?x
  expect_eq(href_of("https://h/a/b/.%2e?x"), "https://h/a/?x", "trailing /.%2e")
}

///|
test "redteam_dot_pct2e_ws_ftp_ipv6" {
  expect_eq(href_of("wss://[::1]/.%2E/%252e/.a/#f"), "wss://[::1]/%252e/.a/#f", "wss ipv6")
  expect_eq(href_of("ftp://example.com/.%2e/a/."), "ftp://example.com/a/", "ftp")
}

///|
test "control_dot_pct2e_nonspecial_and_other_spellings" {
  // the slow path and the other spellings are fine
  expect_eq(href_of("foo://h/a/.%2e/x"), "foo://h/x", "non-special")
  expect_eq(href_of("https://h/a/%2e./x"), "https://h/x", "%2e.")
  expect_eq(href_of("https://h/a/%2E%2e/x"), "https://h/x", "%2E%2e")
}

// ---------------------------------------------------------------------------
// F-2 (P0) `try_fast_join` classifies the base scheme by first letter + length
// (src/parser.pion:1806-1813): any 4/5-letter scheme starting with `h` (hdfs, hive,
// hello), 2/3-letter starting with `w` (web), 3-letter starting with `f` (foo, fax)
// is treated as http/https/ws/wss/ftp. Joining onto such a base with an empty path
// drops the `/` separator, so the path is glued onto the authority: the result
// serializes to a URL whose re-parse has a DIFFERENT HOST (or port) — and special
// query encoding is applied to non-special URLs.
// ---------------------------------------------------------------------------

///|
test "redteam_join_hdfs_base_path_glued_to_port" {
  // rust/node: hdfs://namenode:8020/user/data ; pion: hdfs://namenode:8020user/data
  expect_eq(
    join_of("hdfs://namenode:8020", "user/data"),
    "hdfs://namenode:8020/user/data",
    "hdfs join",
  )
}

///|
test "redteam_join_nonspecial_result_reparses_to_other_host" {
  // pion serializes `foo://example.comx`; re-parsing that names host `example.comx`
  let joined = join_of("foo://example.com", "x")
  expect_eq(joined, "foo://example.com/x", "foo join")
  expect_eq(host_of(joined), "example.com", "host of re-parsed join result")
}

///|
test "redteam_join_empty_host_base_smuggles_host" {
  // rust/node: foo:///evil.com/x (empty host, path /evil.com/x)
  // pion: foo://evil.com/x whose re-parse has host `evil.com`
  let joined = join_of("foo://", "evil.com/x")
  expect_eq(joined, "foo:///evil.com/x", "foo:// join")
  expect_eq(host_of(joined), "", "host of re-parsed join result")
}

///|
test "redteam_join_nonspecial_gets_special_query_encoding" {
  // non-special query encode set leaves `'` alone (rust/node keep q='1')
  expect_eq(
    join_of("hdfs://namenode:8020/a/", "x?q='1'"),
    "hdfs://namenode:8020/a/x?q='1'",
    "hdfs query",
  )
}

///|
test "control_join_real_special_schemes" {
  expect_eq(join_of("ssh://git.example.com", "x"), "ssh://git.example.com/x", "ssh")
  expect_eq(join_of("ftp://h", "x"), "ftp://h/x", "ftp")
  expect_eq(join_of("https://h", "x"), "https://h/x", "https")
}

// ---------------------------------------------------------------------------
// F-3 (P0) UTS #46 mapping is a hand-written ~20-range subset (src/idna.pion:333):
// no NFC normalization, no compatibility (NFKC) mappings, no full case folding,
// no Unicode mapping table. Hosts that every browser and rust-url resolve to one
// canonical ASCII name become a DIFFERENT registrable name in Pion (origin /
// allow-list / cookie-scope confusion, homograph spoofing).
// ---------------------------------------------------------------------------

///|
test "redteam_idna_nfc_combining_diaeresis" {
  // `Bu\u0308cher.de` (u + COMBINING DIAERESIS) == `Bücher.de` after NFC
  expect_eq(ascii_of("Bu\u{308}cher.de"), "xn--bcher-kva.de", "decomposed ü")
  expect_eq(ascii_of("e\u{301}.com"), "xn--9ca.com", "decomposed é")
  expect_eq(ascii_of("A\u{30A}.com"), "xn--5ca.com", "decomposed Å")
}

///|
test "redteam_idna_kelvin_sign_is_k" {
  // U+212A KELVIN SIGN maps to `k`: browsers send `k.com`, Pion builds `xn--62g.com`
  expect_eq(ascii_of("\u{212A}.com"), "k.com", "KELVIN SIGN")
  expect_eq(host_of("https://\u{212A}.com/"), "k.com", "URL host with KELVIN SIGN")
}

///|
test "redteam_idna_compatibility_mappings" {
  expect_eq(ascii_of("\u{FB00}.com"), "ff.com", "U+FB00 ff ligature")
  expect_eq(ascii_of("\u{2121}.com"), "tel.com", "U+2121 TEL")
  expect_eq(ascii_of("\u{2122}.com"), "tm.com", "U+2122 TM")
  expect_eq(ascii_of("\u{24D0}\u{24D1}\u{24D2}.com"), "abc.com", "circled abc")
  expect_eq(ascii_of("\u{216B}.example"), "xii.example", "ROMAN NUMERAL TWELVE")
  expect_eq(ascii_of("\u{BD}.com"), "xn--12-c6t.com", "VULGAR FRACTION ONE HALF")
  expect_eq(ascii_of("\u{2126}.com"), "xn--bya.com", "OHM SIGN")
}

///|
test "redteam_idna_case_folding" {
  expect_eq(ascii_of("\u{1E9E}.de"), "xn--zca.de", "CAPITAL SHARP S")
  expect_eq(ascii_of("\u{130}stanbul.tr"), "xn--istanbul-o0e.tr", "I WITH DOT ABOVE")
  expect_eq(ascii_of("\u{1C5}.example"), "xn--d-toa.example", "titlecase DZ")
  expect_eq(
    ascii_of("ΠΑΡΆΔΕΙΓΜΑ.ΔΟΚΙΜΉ"),
    "xn--hxajbheg2az3al.xn--jxalpdlp",
    "Greek with tonos",
  )
}

///|
test "redteam_idna_hangul_jamo_composition" {
  expect_eq(ascii_of("\u{1100}\u{1161}.kr"), "xn--o39a.kr", "jamo -> 가")
}

///|
test "redteam_idna_uppercase_punycode_label_accepted" {
  // real-world: `XN--BCHER-KVA.DE` is valid (A-labels are case-insensitive)
  expect_eq(ascii_of("XN--BCHER-KVA.DE"), "xn--bcher-kva.de", "uppercase A-label")
  expect_eq(href_of("https://XN--BCHER-KVA.DE/"), "https://xn--bcher-kva.de/", "URL")
}

///|
test "redteam_idna_valid_mapped_rejected" {
  expect_eq(ascii_of("\u{337F}.jp"), "xn--6oqv20b1zgzxr.jp", "SQUARE CORPORATION")
  expect_eq(ascii_of("\u{3231}.jp"), "xn--()-z88d.jp", "PARENTHESIZED IDEOGRAPH STOCK")
}

// ---------------------------------------------------------------------------
// F-4 (P0) UTS #46 validity criteria are not implemented: CheckJoiners (ContextJ),
// CheckBidi (RFC 5893), unassigned / disallowed code points (V7), leading combining
// marks (V6), NFC of decoded A-labels (V1), non-ASCII in `xn--` labels (P4).
// Pion turns invalid hosts into "valid" punycode that rust-url/browsers reject.
// ---------------------------------------------------------------------------

///|
test "redteam_idna_contextj_zwj_zwnj_rejected" {
  expect_eq(ascii_of("a\u{200D}b.com"), "", "ZWJ between latin")
  expect_eq(ascii_of("a\u{200C}b.com"), "", "ZWNJ between latin")
  expect_eq(href_of("https://a\u{200D}b.com/"), "<ERR>", "URL with ZWJ host")
}

///|
test "redteam_idna_bidi_rule_enforced" {
  expect_eq(ascii_of("a\u{5D0}.com"), "", "LTR+RTL in one label")
  expect_eq(ascii_of("1\u{5D0}.com"), "", "RTL label starting with digit")
}

///|
test "redteam_idna_unassigned_and_disallowed_rejected" {
  expect_eq(ascii_of("\u{378}.com"), "", "unassigned U+0378")
  expect_eq(ascii_of("\u{E0001}.com"), "", "LANGUAGE TAG")
  expect_eq(ascii_of("a\u{2028}b.com"), "", "LINE SEPARATOR")
  expect_eq(ascii_of("a\u{2488}com"), "", "DIGIT ONE FULL STOP")
}

///|
test "redteam_idna_label_validity" {
  expect_eq(ascii_of("a.b.\u{308}c.d"), "", "label starts with combining mark")
  expect_eq(ascii_of("xn--u-ccb"), "", "A-label decodes to non-NFC u+U+0308")
  expect_eq(ascii_of("xn--a-\u{E4}.pt"), "", "non-ASCII inside xn-- label")
}

///|
test "redteam_domain_to_unicode_case_insensitive_alabel" {
  expect_eq(url::domain_to_unicode("XN--BCHER-KVA.DE"), "bücher.de", "uppercase A-label")
  expect_eq(url::domain_to_unicode("\u{212A}.com"), "k.com", "KELVIN SIGN")
}

///|
test "control_idna_common_hosts" {
  expect_eq(ascii_of("bücher.de"), "xn--bcher-kva.de", "precomposed ü")
  expect_eq(ascii_of("faß.de"), "xn--fa-hia.de", "ß non-transitional")
  expect_eq(ascii_of("ПРИМЕР.РФ"), "xn--e1afmkfd.xn--p1ai", "Cyrillic")
  expect_eq(ascii_of("例え.テスト"), "xn--r8jz45g.xn--zckzah", "Japanese")
  expect_eq(ascii_of("ｅｘａｍｐｌｅ．ｃｏｍ"), "example.com", "fullwidth")
  expect_eq(ascii_of("xn--bcher-kva.de"), "xn--bcher-kva.de", "A-label")
}

// ---------------------------------------------------------------------------
// F-5 (P1) serialization not idempotent: `Url::parse(u.href())` != `u`
// (8 of 15,876 fuzzed parses/joins; rust-url: 0). All via F-2.
// ---------------------------------------------------------------------------

///|
test "redteam_href_reparse_is_identity" {
  let u = match url::Url::parse("foo://") {
    Ok(b) =>
    match b.join("a/b") {
      Ok(v) => v
      Err(_) => return ()
    }
    Err(_) => return ()
  }
  let again = match url::Url::parse(u.href()) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "href does not re-parse")
      return ()
    }
  }
  expect_eq(again.hostname(), u.hostname(), "hostname after re-parse")
  expect_eq(again.pathname(), u.pathname(), "pathname after re-parse")
}

// ---------------------------------------------------------------------------
// F-6 (P2) rust-url native setter semantics.
// ---------------------------------------------------------------------------

///|
test "redteam_set_host_none_keeps_hierarchical_url" {
  // rust: foo://h --set_host(None)--> foo:/ (still a base URL)
  // pion: `foo:` (re-parses as an opaque, cannot-be-a-base URL)
  let u = match url::Url::parse("foo://h") {
    Ok(v) => v
    Err(_) => return ()
  }
  let _ = u.set_host(None)
  expect_eq(u.href(), "foo:/", "href")
  debug_assert(!u.cannot_be_a_base(), "must stay hierarchical")
  match url::Url::parse(u.href()) {
    Ok(v) => debug_assert(!v.cannot_be_a_base(), "re-parsed href became opaque")
    Err(_) => debug_assert(false, "re-parse failed")
  }
}

///|
test "redteam_set_scheme_rejects_invalid_scheme" {
  // rust `Url::set_scheme("h:ttp")` -> Err(()); pion truncates and returns Ok
  let u = match url::Url::parse("foo://h/p") {
    Ok(v) => v
    Err(_) => return ()
  }
  let r = u.set_scheme("h:ttp")
  debug_assert(
    match r {
      Err(_) => true
      Ok(_) => false
    },
    "set_scheme(\"h:ttp\") must fail",
  )
  expect_eq(u.href(), "foo://h/p", "href unchanged")
}

///|
test "redteam_set_scheme_reports_refusal" {
  // rust: set_scheme("file") on a URL with credentials/port is Err(());
  // pion reports Ok(()) while silently leaving the scheme unchanged.
  let u = match url::Url::parse("http://u:p@h.com:8080/") {
    Ok(v) => v
    Err(_) => return ()
  }
  match u.set_scheme("file") {
    Ok(_) => expect_eq(u.scheme(), "file", "Ok but scheme not changed")
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// Controls: attacks Pion survived (must keep passing).
// ---------------------------------------------------------------------------

///|
test "control_queryparams_utf16_sort_large" {
  // > 24 pairs takes the merge-sort branch; UTF-16 order puts U+1F600 (D83D..) before U+FFFD
  let qp = url::QueryParams::new()
  let mut i = 0
  while i < 30 {
    qp.append("k" + (100 - i).to_string(), i.to_string())
    i = i + 1
  }
  qp.append("\u{FFFD}", "r")
  qp.append("\u{1F600}", "e")
  qp.sort()
  let p = qp.pairs()
  let (k0, _) = p[0]
  expect_eq(k0, "k100", "first")
  let (kl1, _) = p[p.length() - 2]
  let (kl, _) = p[p.length() - 1]
  expect_eq(kl1, "\u{1F600}", "surrogate pair sorts before U+FFFD")
  expect_eq(kl, "\u{FFFD}", "U+FFFD last")
}

///|
test "control_percent_decode_invalid_utf8" {
  expect_eq(url::percent_decode_str("%ED%A0%80"), "\u{FFFD}\u{FFFD}\u{FFFD}", "surrogate")
  expect_eq(url::percent_decode_str("%C0%AF"), "\u{FFFD}\u{FFFD}", "overlong")
  expect_eq(url::percent_decode_str("%F0%9F%92"), "\u{FFFD}", "truncated")
}

///|
test "control_spec_cases_where_rust_url_deviates" {
  // urltestdata.json expectations that rust-url 2.5.9 lists in expected_failures.txt:
  // Pion follows the WHATWG spec here (rust-url does not).
  expect_eq(href_of("non-special:opaque  ?hi"), "non-special:opaque %20?hi", "opaque trailing spaces")
  expect_eq(href_of("file:\\\\//"), "file:////", "file backslashes")
  expect_eq(href_of("file:///w|/m"), "file:///w:/m", "drive letter normalization")
}

///|
test "control_ipv4_ipv6_edge" {
  expect_eq(href_of("http://0x7f.1/"), "http://127.0.0.1/", "hex ipv4")
  expect_eq(href_of("http://4294967296/"), "<ERR>", "ipv4 overflow")
  expect_eq(href_of("http://[::ffff:1.2.3.4]/"), "http://[::ffff:102:304]/", "embedded ipv4")
  expect_eq(href_of("http://[1:2:3:4:5:6:7:8:9]/"), "<ERR>", "9 groups")
}
