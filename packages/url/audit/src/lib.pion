///| Red-team audit helpers for packages/url (no production code; see ../REPORT.md).

import "url"

///| `Url::parse(input).href()`, or `"<ERR>"` on failure.
pub fn href_of(input : String) -> String {
  match url::Url::parse(input) {
    Ok(u) => u.href()
    Err(_) => "<ERR>"
  }
}

///| `Url::parse(base).join(rel).href()`, or `"<ERR>"` on failure.
pub fn join_of(base : String, rel : String) -> String {
  match url::Url::parse(base) {
    Ok(b) =>
    match b.join(rel) {
      Ok(u) => u.href()
      Err(_) => "<ERR>"
    }
    Err(_) => "<BASEERR>"
  }
}

///| Host string of `Url::parse(input)`, or `"<ERR>"` on failure.
pub fn host_of(input : String) -> String {
  match url::Url::parse(input) {
    Ok(u) => u.hostname()
    Err(_) => "<ERR>"
  }
}

///| WHATWG `domainToASCII` (empty string on failure, as in rust-url `quirks`).
pub fn ascii_of(domain : String) -> String {
  match url::domain_to_ascii(domain) {
    Ok(s) => s
    Err(_) => ""
  }
}

///| Assert `got == want` with a readable message.
pub fn expect_eq(got : String, want : String, what : String) -> Unit {
  debug_assert(got == want, what + ": got `" + got + "`, want `" + want + "`")
}
