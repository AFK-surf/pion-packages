///| WHATWG `URLSearchParams` (`application/x-www-form-urlencoded`) implementation.

///| Decode a form-urlencoded slice (`+` -> space, `%XX` -> byte, lossy UTF-8).
fn decode_form_slice(s : String, start : Int, end : Int) -> String {
  // Fast scan for `+` or `%`
  let mut needs_decode = false
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 43 || b == 37 {
      needs_decode = true
      break
    }
    i = i + 1
  }
  if !needs_decode {
    return s.slice(start, end)
  }
  // Compute decoded byte length
  let mut out_len = 0
  i = start
  while i < end {
    if s.code_unit_at(i) == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        out_len = out_len + 1
        i = i + 3
        continue
      }
    }
    out_len = out_len + 1
    i = i + 1
  }
  let mut buf = Bytes::new(out_len)
  let mut o = 0
  i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 43 {
      buf[o] = (32).to_byte()
      o = o + 1
      i = i + 1
    } else if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        buf[o] = ((hi << 4) | lo).to_byte()
        o = o + 1
        i = i + 3
        continue
      }
      buf[o] = (37).to_byte()
      o = o + 1
      i = i + 1
    } else {
      buf[o] = b.to_byte()
      o = o + 1
      i = i + 1
    }
  }
  let sb = StringBuilder::with_capacity(out_len)
  write_utf8_lossy(sb, buf)
  sb.to_string()
}

///| Write a string in `application/x-www-form-urlencoded` format into `sb`.
fn write_form_encoded(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut run_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (encode_lut[b] & mask_form) != 0 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      if b == 32 {
        sb.write_byte((43).to_byte())
      } else {
        write_pct_byte(sb, b)
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < n {
    sb.write_substring(s, run_start, n)
  }
}

///| Compare two UTF-8 strings by UTF-16 code unit order (WHATWG `URLSearchParams.sort()`).
///| Returns < 0 if `a < b`, 0 if equal, > 0 if `a > b`.
fn cmp_utf16(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let mut ia = 0
  let mut ib = 0
  let mut pending_a = -1
  let mut pending_b = -1
  while true {
    let ua : Int = if pending_a >= 0 {
      let v = pending_a
      pending_a = -1
      v
    } else if ia < na {
      let b0 = a.code_unit_at(ia)
      if b0 < 0x80 {
        ia = ia + 1
        b0
      } else {
        let (cp, next) = decode_utf8_at(a, ia)
        ia = next
        if cp >= 0x10000 {
          let adj = cp - 0x10000
          pending_a = 0xDC00 + (adj & 0x3FF)
          0xD800 + (adj >> 10)
        } else {
          cp
        }
      }
    } else {
      -1
    }
    let ub : Int = if pending_b >= 0 {
      let v = pending_b
      pending_b = -1
      v
    } else if ib < nb {
      let b0 = b.code_unit_at(ib)
      if b0 < 0x80 {
        ib = ib + 1
        b0
      } else {
        let (cp, next) = decode_utf8_at(b, ib)
        ib = next
        if cp >= 0x10000 {
          let adj = cp - 0x10000
          pending_b = 0xDC00 + (adj & 0x3FF)
          0xD800 + (adj >> 10)
        } else {
          cp
        }
      }
    } else {
      -1
    }
    if ua != ub {
      return ua - ub
    }
    if ua < 0 {
      return 0
    }
  }
  0
}

///| Parse a query string (stripping one leading `?` if present).
pub fn QueryParams::parse(input : String) -> QueryParams {
  let n = input.length()
  if n > 0 && input.code_unit_at(0) == 63 {
    QueryParams::parse_slice(input, 1, n)
  } else {
    QueryParams::parse_slice(input, 0, n)
  }
}

///| Parse a raw `application/x-www-form-urlencoded` string without stripping `?`.
pub fn QueryParams::parse_raw(input : String) -> QueryParams {
  QueryParams::parse_slice(input, 0, input.length())
}

///|
fn QueryParams::parse_slice(
  input : String,
  start : Int,
  end : Int,
) -> QueryParams {
  let keys : Array[String] = []
  let vals : Array[String] = []
  let mut i = start
  while i < end {
    let mut seg_end = i
    let mut eq_pos = -1
    while seg_end < end {
      let b = input.code_unit_at(seg_end)
      if b == 38 {
        break
      }
      if b == 61 && eq_pos < 0 {
        eq_pos = seg_end
      }
      seg_end = seg_end + 1
    }
    if seg_end > i {
      if eq_pos >= 0 {
        keys.push(decode_form_slice(input, i, eq_pos))
        vals.push(decode_form_slice(input, eq_pos + 1, seg_end))
      } else {
        keys.push(decode_form_slice(input, i, seg_end))
        vals.push("")
      }
    }
    i = seg_end + 1
  }
  QueryParams::{ keys: keys, vals: vals }
}

///|
pub fn QueryParams::get(self : QueryParams, name : String) -> Option[String] {
  let n = self.keys.length()
  let mut i = 0
  while i < n {
    if self.keys[i] == name {
      return Some(self.vals[i])
    }
    i = i + 1
  }
  None
}

///|
pub fn QueryParams::get_all(self : QueryParams, name : String) -> Array[String] {
  let res : Array[String] = []
  let n = self.keys.length()
  let mut i = 0
  while i < n {
    if self.keys[i] == name {
      res.push(self.vals[i])
    }
    i = i + 1
  }
  res
}

///|
pub fn QueryParams::has(self : QueryParams, name : String) -> Bool {
  let n = self.keys.length()
  let mut i = 0
  while i < n {
    if self.keys[i] == name {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn QueryParams::set(
  self : QueryParams,
  name : String,
  value : String,
) -> Unit {
  let n = self.keys.length()
  let mut found = false
  let new_keys : Array[String] = []
  let new_vals : Array[String] = []
  let mut i = 0
  while i < n {
    if self.keys[i] == name {
      if !found {
        new_keys.push(name)
        new_vals.push(value)
        found = true
      }
    } else {
      new_keys.push(self.keys[i])
      new_vals.push(self.vals[i])
    }
    i = i + 1
  }
  if !found {
    new_keys.push(name)
    new_vals.push(value)
  }
  self.keys = new_keys
  self.vals = new_vals
}

///|
pub fn QueryParams::append(
  self : QueryParams,
  name : String,
  value : String,
) -> Unit {
  self.keys.push(name)
  self.vals.push(value)
}

///|
pub fn QueryParams::delete(self : QueryParams, name : String) -> Unit {
  let n = self.keys.length()
  let new_keys : Array[String] = []
  let new_vals : Array[String] = []
  let mut i = 0
  while i < n {
    if self.keys[i] != name {
      new_keys.push(self.keys[i])
      new_vals.push(self.vals[i])
    }
    i = i + 1
  }
  self.keys = new_keys
  self.vals = new_vals
}

///| Stable bottom-up merge sort on `(keys, vals)` by UTF-16 key order.
pub fn QueryParams::sort(self : QueryParams) -> Unit {
  let n = self.keys.length()
  if n <= 1 {
    return ()
  }
  let src_k : FixedArray[String] = FixedArray::make(n, "")
  let src_v : FixedArray[String] = FixedArray::make(n, "")
  let tmp_k : FixedArray[String] = FixedArray::make(n, "")
  let tmp_v : FixedArray[String] = FixedArray::make(n, "")
  let mut i = 0
  while i < n {
    src_k[i] = self.keys[i]
    src_v[i] = self.vals[i]
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut l = left
      let mut r = mid
      let mut o = left
      while l < mid && r < right {
        if cmp_utf16(src_k[l], src_k[r]) <= 0 {
          tmp_k[o] = src_k[l]
          tmp_v[o] = src_v[l]
          l = l + 1
        } else {
          tmp_k[o] = src_k[r]
          tmp_v[o] = src_v[r]
          r = r + 1
        }
        o = o + 1
      }
      while l < mid {
        tmp_k[o] = src_k[l]
        tmp_v[o] = src_v[l]
        l = l + 1
        o = o + 1
      }
      while r < right {
        tmp_k[o] = src_k[r]
        tmp_v[o] = src_v[r]
        r = r + 1
        o = o + 1
      }
      left = left + 2 * width
    }
    i = 0
    while i < n {
      src_k[i] = tmp_k[i]
      src_v[i] = tmp_v[i]
      i = i + 1
    }
    width = width * 2
  }
  let out_k : Array[String] = []
  let out_v : Array[String] = []
  i = 0
  while i < n {
    out_k.push(src_k[i])
    out_v.push(src_v[i])
    i = i + 1
  }
  self.keys = out_k
  self.vals = out_v
}

///|
pub fn QueryParams::pairs(self : QueryParams) -> Array[(String, String)] {
  let res : Array[(String, String)] = []
  let n = self.keys.length()
  let mut i = 0
  while i < n {
    res.push((self.keys[i], self.vals[i]))
    i = i + 1
  }
  res
}

///|
pub fn QueryParams::to_string(self : QueryParams) -> String {
  let n = self.keys.length()
  if n == 0 {
    return ""
  }
  let mut est = n * 2
  let mut i = 0
  while i < n {
    est = est + self.keys[i].length() + self.vals[i].length()
    i = i + 1
  }
  let sb = StringBuilder::with_capacity(est + 16)
  i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((38).to_byte())
    }
    write_form_encoded(sb, self.keys[i])
    sb.write_byte((61).to_byte())
    write_form_encoded(sb, self.vals[i])
    i = i + 1
  }
  sb.to_string()
}
