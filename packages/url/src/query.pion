///| WHATWG `URLSearchParams` (`application/x-www-form-urlencoded`) implementation.

///| Decode a form-urlencoded slice (`+` -> space, `%XX` -> byte, lossy UTF-8)
///| starting from the known first escape byte `first_special`.
fn decode_form_slice_from(
  s : String,
  start : Int,
  end : Int,
  first_special : Int,
) -> String {
  let sb = StringBuilder::with_capacity(end - start)
  if first_special > start {
    sb.write_substring(s, start, first_special)
  }
  let mut run_start = first_special
  let mut invalid_utf8 = false
  let mut i = first_special
  while i < end {
    let b = s.code_unit_at(i)
    if b == 43 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      sb.write_byte((32).to_byte())
      run_start = i + 1
      i = i + 1
    } else if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        let b0 = (hi << 4) | lo
        if b0 < 0x80 {
          if i > run_start {
            sb.write_substring(s, run_start, i)
          }
          sb.write_byte(b0.to_byte())
          run_start = i + 3
          i = i + 3
        } else if b0 >= 0xC2 && b0 <= 0xDF && i + 5 < end && s.code_unit_at(i + 3) == 37 {
          let h1 = hex_val(s.code_unit_at(i + 4))
          let l1 = hex_val(s.code_unit_at(i + 5))
          if h1 >= 0 && l1 >= 0 {
            let b1 = (h1 << 4) | l1
            if (b1 & 0xC0) == 0x80 {
              if i > run_start {
                sb.write_substring(s, run_start, i)
              }
              sb.write_byte(b0.to_byte())
              sb.write_byte(b1.to_byte())
              run_start = i + 6
              i = i + 6
              continue
            }
          }
          invalid_utf8 = true
          break
        } else if b0 >= 0xE0 &&
        b0 <= 0xEF &&
        i + 8 < end &&
        s.code_unit_at(i + 3) == 37 &&
        s.code_unit_at(i + 6) == 37 {
          let h1 = hex_val(s.code_unit_at(i + 4))
          let l1 = hex_val(s.code_unit_at(i + 5))
          let h2 = hex_val(s.code_unit_at(i + 7))
          let l2 = hex_val(s.code_unit_at(i + 8))
          if h1 >= 0 && l1 >= 0 && h2 >= 0 && l2 >= 0 {
            let b1 = (h1 << 4) | l1
            let b2 = (h2 << 4) | l2
            let valid_b1 = if b0 == 0xE0 {
              b1 >= 0xA0 && b1 <= 0xBF
            } else if b0 == 0xED {
              b1 >= 0x80 && b1 <= 0x9F
            } else {
              (b1 & 0xC0) == 0x80
            }
            if valid_b1 && (b2 & 0xC0) == 0x80 {
              if i > run_start {
                sb.write_substring(s, run_start, i)
              }
              sb.write_byte(b0.to_byte())
              sb.write_byte(b1.to_byte())
              sb.write_byte(b2.to_byte())
              run_start = i + 9
              i = i + 9
              continue
            }
          }
          invalid_utf8 = true
          break
        } else if b0 >= 0xF0 &&
        b0 <= 0xF4 &&
        i + 11 < end &&
        s.code_unit_at(i + 3) == 37 &&
        s.code_unit_at(i + 6) == 37 &&
        s.code_unit_at(i + 9) == 37 {
          let h1 = hex_val(s.code_unit_at(i + 4))
          let l1 = hex_val(s.code_unit_at(i + 5))
          let h2 = hex_val(s.code_unit_at(i + 7))
          let l2 = hex_val(s.code_unit_at(i + 8))
          let h3 = hex_val(s.code_unit_at(i + 10))
          let l3 = hex_val(s.code_unit_at(i + 11))
          if h1 >= 0 && l1 >= 0 && h2 >= 0 && l2 >= 0 && h3 >= 0 && l3 >= 0 {
            let b1 = (h1 << 4) | l1
            let b2 = (h2 << 4) | l2
            let b3 = (h3 << 4) | l3
            let valid_b1 = if b0 == 0xF0 {
              b1 >= 0x90 && b1 <= 0xBF
            } else if b0 == 0xF4 {
              b1 >= 0x80 && b1 <= 0x8F
            } else {
              (b1 & 0xC0) == 0x80
            }
            if valid_b1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
              if i > run_start {
                sb.write_substring(s, run_start, i)
              }
              sb.write_byte(b0.to_byte())
              sb.write_byte(b1.to_byte())
              sb.write_byte(b2.to_byte())
              sb.write_byte(b3.to_byte())
              run_start = i + 12
              i = i + 12
              continue
            }
          }
          invalid_utf8 = true
          break
        } else {
          invalid_utf8 = true
          break
        }
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  if !invalid_utf8 {
    if run_start < end {
      sb.write_substring(s, run_start, end)
    }
    return sb.to_string()
  }
  let mut out_len = 0
  i = start
  while i < end {
    if s.code_unit_at(i) == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        out_len = out_len + 1
        i = i + 3
        continue
      }
    }
    out_len = out_len + 1
    i = i + 1
  }
  let mut buf = Bytes::new(out_len)
  let mut o = 0
  i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 43 {
      buf[o] = (32).to_byte()
      o = o + 1
      i = i + 1
    } else if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        buf[o] = ((hi << 4) | lo).to_byte()
        o = o + 1
        i = i + 3
        continue
      }
      buf[o] = (37).to_byte()
      o = o + 1
      i = i + 1
    } else {
      buf[o] = b.to_byte()
      o = o + 1
      i = i + 1
    }
  }
  let utf_sb = StringBuilder::with_capacity(out_len)
  write_utf8_lossy(utf_sb, buf)
  utf_sb.to_string()
}

fn build_form_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 1)
  lut[0x2A] = 0
  lut[0x2D] = 0
  lut[0x2E] = 0
  lut[0x5F] = 0
  let mut b = 0x30
  while b <= 0x39 {
    lut[b] = 0
    b = b + 1
  }
  b = 0x41
  while b <= 0x5A {
    lut[b] = 0
    b = b + 1
  }
  b = 0x61
  while b <= 0x7A {
    lut[b] = 0
    b = b + 1
  }
  lut
}

let form_safe_lut : FixedArray[Int] = build_form_lut()

///| Write a string in `application/x-www-form-urlencoded` format into `sb`.
fn write_form_encoded(sb : StringBuilder, s : String, lut : FixedArray[Int]) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut run_start = 0
  while i < n {
    let b = s.code_unit_at(i)
    if lut[b] != 0 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      if b == 32 {
        sb.write_byte((43).to_byte())
      } else {
        write_pct_byte(sb, b)
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start == 0 {
    sb.write_string(s)
  } else if run_start < n {
    sb.write_substring(s, run_start, n)
  }
}

///| Compare two UTF-8 strings by UTF-16 code unit order (WHATWG `URLSearchParams.sort()`).
fn cmp_utf16(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let min_n = if na < nb { na } else { nb }
  let mut i = 0
  while i < min_n {
    let ba = a.code_unit_at(i)
    let bb = b.code_unit_at(i)
    if (ba | bb) >= 0x80 {
      return cmp_utf16_slow(a, b, i)
    }
    if ba != bb {
      return ba - bb
    }
    i = i + 1
  }
  na - nb
}

fn cmp_utf16_slow(a : String, b : String, start : Int) -> Int {
  let na = a.length()
  let nb = b.length()
  let mut ia = start
  let mut ib = start
  let mut pending_a = -1
  let mut pending_b = -1
  while true {
    let ua : Int = if pending_a >= 0 {
      let v = pending_a
      pending_a = -1
      v
    } else if ia < na {
      let b0 = a.code_unit_at(ia)
      if b0 < 0x80 {
        ia = ia + 1
        b0
      } else {
        let (cp, next) = decode_utf8_at(a, ia)
        ia = next
        if cp >= 0x10000 {
          let adj = cp - 0x10000
          pending_a = 0xDC00 + (adj & 0x3FF)
          0xD800 + (adj >> 10)
        } else {
          cp
        }
      }
    } else {
      -1
    }
    let ub : Int = if pending_b >= 0 {
      let v = pending_b
      pending_b = -1
      v
    } else if ib < nb {
      let b0 = b.code_unit_at(ib)
      if b0 < 0x80 {
        ib = ib + 1
        b0
      } else {
        let (cp, next) = decode_utf8_at(b, ib)
        ib = next
        if cp >= 0x10000 {
          let adj = cp - 0x10000
          pending_b = 0xDC00 + (adj & 0x3FF)
          0xD800 + (adj >> 10)
        } else {
          cp
        }
      }
    } else {
      -1
    }
    if ua != ub {
      return ua - ub
    }
    if ua < 0 {
      return 0
    }
  }
  0
}

fn QueryParams::ensure_cap(self : QueryParams, needed : Int) -> Unit {
  if needed <= self.cap {
    return ()
  }
  let mut new_cap = if self.cap < 8 { 8 } else { self.cap * 2 }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let nkv = FixedArray::make(new_cap * 2, "")
  let limit = self.count * 2
  let old = self.kv
  let mut i = 0
  while i < limit {
    nkv[i] = old[i]
    i = i + 1
  }
  self.kv = nkv
  self.cap = new_cap
}

///| Parse a query string (stripping one leading `?` if present).
pub fn QueryParams::parse(input : String) -> QueryParams {
  let n = input.length()
  if n > 0 && input.code_unit_at(0) == 63 {
    QueryParams::parse_slice(input, 1, n)
  } else {
    QueryParams::parse_slice(input, 0, n)
  }
}

///| Parse a raw `application/x-www-form-urlencoded` string without stripping `?`.
pub fn QueryParams::parse_raw(input : String) -> QueryParams {
  QueryParams::parse_slice(input, 0, input.length())
}

///| Single-pass query parser that records form-safe bits in `safe_mask` (zero extra alloc).
fn QueryParams::parse_slice(
  input : String,
  start : Int,
  end : Int,
) -> QueryParams {
  let lut = form_safe_lut
  let mut cap = 9
  let mut kv = FixedArray::make(18, "")
  let mut count = 0
  let mut safe_mask = 0L
  let mut i = start
  while i < end {
    let mut seg_end = i
    let mut eq_pos = -1
    let mut key_esc = -1
    let mut val_esc = -1
    let mut key_unsafe = false
    let mut val_unsafe = false
    while seg_end < end {
      let b = input.code_unit_at(seg_end)
      if b == 38 {
        break
      }
      if b == 61 && eq_pos < 0 {
        eq_pos = seg_end
      } else if lut[b] != 0 {
        if eq_pos < 0 {
          key_unsafe = true
          if (b == 43 || b == 37) && key_esc < 0 {
            key_esc = seg_end
          }
        } else {
          val_unsafe = true
          if (b == 43 || b == 37) && val_esc < 0 {
            val_esc = seg_end
          }
        }
      }
      seg_end = seg_end + 1
    }
    if seg_end > i {
      if count >= cap {
        let new_cap = cap * 2
        let nkv = FixedArray::make(new_cap * 2, "")
        let limit = count * 2
        let mut ci = 0
        while ci < limit {
          nkv[ci] = kv[ci]
          ci = ci + 1
        }
        kv = nkv
        cap = new_cap
      }
      let idx = count * 2
      if eq_pos >= 0 {
        kv[idx] = if key_esc >= 0 {
          decode_form_slice_from(input, i, eq_pos, key_esc)
        } else {
          input.slice(i, eq_pos)
        }
        kv[idx + 1] = if val_esc >= 0 {
          decode_form_slice_from(input, eq_pos + 1, seg_end, val_esc)
        } else {
          input.slice(eq_pos + 1, seg_end)
        }
      } else {
        kv[idx] = if key_esc >= 0 {
          decode_form_slice_from(input, i, seg_end, key_esc)
        } else {
          input.slice(i, seg_end)
        }
        kv[idx + 1] = ""
      }
      if idx < 62 {
        if !key_unsafe {
          safe_mask = safe_mask | (1L << idx.to_int64())
        }
        if !val_unsafe {
          safe_mask = safe_mask | (1L << (idx + 1).to_int64())
        }
      }
      count = count + 1
    }
    i = seg_end + 1
  }
  QueryParams::{ kv: kv, count: count, cap: cap, safe_mask: safe_mask }
}

///|
pub fn QueryParams::get(self : QueryParams, name : String) -> Option[String] {
  let limit = self.count * 2
  let kv = self.kv
  let name_len = name.length()
  let mut i = 0
  while i < limit {
    let ki = kv[i]
    if ki.length() == name_len && ki == name {
      return Some(kv[i + 1])
    }
    i = i + 2
  }
  None
}

///|
pub fn QueryParams::get_all(self : QueryParams, name : String) -> Array[String] {
  let res : Array[String] = []
  let limit = self.count * 2
  let kv = self.kv
  let name_len = name.length()
  let mut i = 0
  while i < limit {
    let ki = kv[i]
    if ki.length() == name_len && ki == name {
      res.push(kv[i + 1])
    }
    i = i + 2
  }
  res
}

///|
pub fn QueryParams::has(self : QueryParams, name : String) -> Bool {
  let limit = self.count * 2
  let kv = self.kv
  let name_len = name.length()
  let mut i = 0
  while i < limit {
    let ki = kv[i]
    if ki.length() == name_len && ki == name {
      return true
    }
    i = i + 2
  }
  false
}

///| In-place set (zero allocation when capacity permits).
pub fn QueryParams::set(
  self : QueryParams,
  name : String,
  value : String,
) -> Unit {
  let limit = self.count * 2
  let name_len = name.length()
  let kv = self.kv
  let old_mask = self.safe_mask
  let mut new_mask = 0L
  let mut found = false
  let mut w = 0
  let mut i = 0
  while i < limit {
    let ki = kv[i]
    if ki.length() == name_len && ki == name {
      if !found {
        kv[w] = name
        kv[w + 1] = value
        w = w + 2
        found = true
      }
    } else {
      if w != i {
        kv[w] = ki
        kv[w + 1] = kv[i + 1]
      }
      if w < 62 && i < 62 {
        let bits = (old_mask >> i.to_int64()) & 3L
        new_mask = new_mask | (bits << w.to_int64())
      }
      w = w + 2
    }
    i = i + 2
  }
  if !found {
    self.ensure_cap(self.count + 1)
    let idx = self.count * 2
    self.kv[idx] = name
    self.kv[idx + 1] = value
    self.count = self.count + 1
  } else {
    self.count = w / 2
    self.safe_mask = new_mask
  }
}

///|
pub fn QueryParams::append(
  self : QueryParams,
  name : String,
  value : String,
) -> Unit {
  self.ensure_cap(self.count + 1)
  let idx = self.count * 2
  self.kv[idx] = name
  self.kv[idx + 1] = value
  if idx < 62 {
    self.safe_mask = self.safe_mask & ((3L << idx.to_int64()) ^ -1L)
  }
  self.count = self.count + 1
}

///| In-place delete (zero allocation).
pub fn QueryParams::delete(self : QueryParams, name : String) -> Unit {
  let limit = self.count * 2
  let name_len = name.length()
  let kv = self.kv
  let old_mask = self.safe_mask
  let mut new_mask = 0L
  let mut w = 0
  let mut i = 0
  while i < limit {
    let ki = kv[i]
    if ki.length() != name_len || ki != name {
      if w != i {
        kv[w] = ki
        kv[w + 1] = kv[i + 1]
      }
      if w < 62 && i < 62 {
        let bits = (old_mask >> i.to_int64()) & 3L
        new_mask = new_mask | (bits << w.to_int64())
      }
      w = w + 2
    }
    i = i + 2
  }
  self.count = w / 2
  self.safe_mask = new_mask
}

///| Stable sort on `(k, v)` pairs by UTF-16 key order.
pub fn QueryParams::sort(self : QueryParams) -> Unit {
  let n = self.count
  if n <= 1 {
    return ()
  }
  let kv = self.kv
  if n <= 24 {
    let mut mask = self.safe_mask
    let mut i = 1
    while i < n {
      let idx = i * 2
      let k = kv[idx]
      let v = kv[idx + 1]
      let ibits = (mask >> idx.to_int64()) & 3L
      let k_len = k.length()
      let k0 = if k_len > 0 { k.code_unit_at(0) } else { -1 }
      let mut j = i - 1
      while j >= 0 {
        let jdx = j * 2
        let kj = kv[jdx]
        let kj_len = kj.length()
        let gt = if k_len > 0 && kj_len > 0 {
          let kj0 = kj.code_unit_at(0)
          if (kj0 | k0) < 0x80 && kj0 != k0 {
            kj0 > k0
          } else {
            cmp_utf16(kj, k) > 0
          }
        } else {
          cmp_utf16(kj, k) > 0
        }
        if !gt {
          break
        }
        kv[jdx + 2] = kj
        kv[jdx + 3] = kv[jdx + 1]
        let jbits = (mask >> jdx.to_int64()) & 3L
        let sh = (jdx + 2).to_int64()
        mask = (mask & ((3L << sh) ^ -1L)) | (jbits << sh)
        j = j - 1
      }
      let dst = (j + 1) * 2
      kv[dst] = k
      kv[dst + 1] = v
      let dsh = dst.to_int64()
      mask = (mask & ((3L << dsh) ^ -1L)) | (ibits << dsh)
      i = i + 1
    }
    self.safe_mask = mask
    return ()
  }
  self.safe_mask = 0L
  let tmp : FixedArray[String] = FixedArray::make(n * 2, "")
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut l = left
      let mut r = mid
      let mut o = left
      while l < mid && r < right {
        if cmp_utf16(kv[l * 2], kv[r * 2]) <= 0 {
          tmp[o * 2] = kv[l * 2]
          tmp[o * 2 + 1] = kv[l * 2 + 1]
          l = l + 1
        } else {
          tmp[o * 2] = kv[r * 2]
          tmp[o * 2 + 1] = kv[r * 2 + 1]
          r = r + 1
        }
        o = o + 1
      }
      while l < mid {
        tmp[o * 2] = kv[l * 2]
        tmp[o * 2 + 1] = kv[l * 2 + 1]
        l = l + 1
        o = o + 1
      }
      while r < right {
        tmp[o * 2] = kv[r * 2]
        tmp[o * 2 + 1] = kv[r * 2 + 1]
        r = r + 1
        o = o + 1
      }
      left = left + 2 * width
    }
    let limit = n * 2
    let mut i = 0
    while i < limit {
      kv[i] = tmp[i]
      i = i + 1
    }
    width = width * 2
  }
}

///|
pub fn QueryParams::pairs(self : QueryParams) -> Array[(String, String)] {
  let res : Array[(String, String)] = []
  let limit = self.count * 2
  let kv = self.kv
  let mut i = 0
  while i < limit {
    res.push((kv[i], kv[i + 1]))
    i = i + 2
  }
  res
}

///|
pub fn QueryParams::to_string(self : QueryParams) -> String {
  let n = self.count
  if n == 0 {
    return ""
  }
  let limit = n * 2
  let kv = self.kv
  let lut = form_safe_lut
  let mask = self.safe_mask
  let mut est = n * 2
  let mut i = 0
  while i < limit {
    est = est + kv[i].length() + kv[i + 1].length()
    i = i + 2
  }
  let sb = StringBuilder::with_capacity(est + 16)
  i = 0
  while i < limit {
    if i > 0 {
      sb.write_byte((38).to_byte())
    }
    if i < 62 && (mask & (1L << i.to_int64())) != 0L {
      sb.write_string(kv[i])
    } else {
      write_form_encoded(sb, kv[i], lut)
    }
    sb.write_byte((61).to_byte())
    if i < 62 && (mask & (1L << (i + 1).to_int64())) != 0L {
      sb.write_string(kv[i + 1])
    } else {
      write_form_encoded(sb, kv[i + 1], lut)
    }
    i = i + 2
  }
  sb.to_string()
}
