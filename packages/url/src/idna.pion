///| Pure-Pion RFC 3492 Punycode and UTS #46 / IDNA domain processing.

let puny_base : Int64 = 36L

let puny_tmin : Int64 = 1L

let puny_tmax : Int64 = 26L

let puny_skew : Int64 = 38L

let puny_damp : Int64 = 700L

let puny_init_bias : Int64 = 72L

let puny_init_n : Int64 = 128L

let puny_max_u32 : Int64 = 0x7FFFFFFFL

fn err_idna(msg : String) -> ParseError {
  ParseError::new(ParseErrorKind::IdnaError, msg)
}

fn puny_adapt(delta_in : Int64, num_points : Int64, first_time : Bool) -> Int64 {
  let mut delta = if first_time { delta_in / puny_damp } else { delta_in >> 1 }
  delta = delta + delta / num_points
  let mut k = 0L
  while delta > ((puny_base - puny_tmin) * puny_tmax) / 2L {
    delta = delta / (puny_base - puny_tmin)
    k = k + puny_base
  }
  k + ((puny_base - puny_tmin + 1L) * delta) / (delta + puny_skew)
}

fn puny_encode_digit(d : Int64) -> Byte {
  if d < 26L {
    (97 + d.to_int()).to_byte()
  } else {
    (48 + (d - 26L).to_int()).to_byte()
  }
}

fn puny_decode_digit(b : Int) -> Int64 {
  if b >= 97 && b <= 122 {
    (b - 97).to_int64()
  } else if b >= 65 && b <= 90 {
    (b - 65).to_int64()
  } else if b >= 48 && b <= 57 {
    (b - 48 + 26).to_int64()
  } else {
    -1L
  }
}

///| Encode a slice `cps[c_start..c_end]` of Unicode scalar values into RFC 3492 Punycode
///| directly into `sb` (without `xn--` prefix, zero intermediate StringBuilder/Array).
fn punycode_encode_cps_range(
  sb : StringBuilder,
  cps : Array[Int],
  c_start : Int,
  c_end : Int,
) -> Result[Unit, ParseError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(err_idna("punycode encode overflow"))
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(err_idna("punycode encode overflow"))
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = if k <= bias {
            puny_tmin
          } else if k >= bias + puny_tmax {
            puny_tmax
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

///| Encode a slice of Unicode scalar values into RFC 3492 Punycode (without `xn--` prefix).
fn punycode_encode_cps(cps : Array[Int]) -> Result[String, ParseError] {
  let sb = StringBuilder::with_capacity(cps.length() * 2 + 8)
  match punycode_encode_cps_range(sb, cps, 0, cps.length()) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into Unicode scalar values.
fn punycode_decode_cps(
  input : String,
  start : Int,
  end : Int,
) -> Result[Array[Int], ParseError] {
  let out : Array[Int] = []
  let mut last_dash = -1
  let mut idx = start
  while idx < end {
    let ch = input.code_unit_at(idx)
    if ch >= 0x80 {
      return Err(err_idna("non-ASCII in punycode"))
    }
    if ch == 45 {
      last_dash = idx
    }
    idx = idx + 1
  }
  if last_dash >= start {
    idx = start
    while idx < last_dash {
      out.push(input.code_unit_at(idx))
      idx = idx + 1
    }
    idx = last_dash + 1
  } else {
    idx = start
  }
  let mut n = puny_init_n
  let mut i = 0L
  let mut bias = puny_init_bias
  let mut has_non_ascii = false
  while idx < end {
    let old_i = i
    let mut w = 1L
    let mut k = puny_base
    while true {
      if idx >= end {
        return Err(err_idna("truncated punycode"))
      }
      let digit = puny_decode_digit(input.code_unit_at(idx))
      idx = idx + 1
      if digit < 0L {
        return Err(err_idna("invalid punycode digit"))
      }
      if digit > (puny_max_u32 - i) / w {
        return Err(err_idna("punycode overflow"))
      }
      i = i + digit * w
      let t = if k <= bias {
        puny_tmin
      } else if k >= bias + puny_tmax {
        puny_tmax
      } else {
        k - bias
      }
      if digit < t {
        break
      }
      let mult = puny_base - t
      if w > puny_max_u32 / mult {
        return Err(err_idna("punycode weight overflow"))
      }
      w = w * mult
      k = k + puny_base
    }
    let out_len1 = (out.length() + 1).to_int64()
    bias = puny_adapt(i - old_i, out_len1, old_i == 0L)
    let inc = i / out_len1
    if inc > 0x10FFFFL - n {
      return Err(err_idna("punycode code point overflow"))
    }
    n = n + inc
    i = i % out_len1
    let cp = n.to_int()
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(err_idna("invalid punycode scalar"))
    }
    if cp >= 0x80 {
      has_non_ascii = true
    }
    // Insert cp at index i
    let pos = i.to_int()
    out.push(0)
    let mut j = out.length() - 1
    while j > pos {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[pos] = cp
    i = i + 1L
  }
  if !has_non_ascii {
    return Err(err_idna("punycode label has no non-ASCII code points"))
  }
  Ok(out)
}

///| Encode a UTF-8 string into RFC 3492 Punycode (without `xn--` prefix).
pub fn punycode_encode(input : String) -> Result[String, ParseError] {
  let cps : Array[Int] = []
  let n = input.length()
  let mut pos = 0
  while pos < n {
    let (cp, next) = decode_utf8_at(input, pos)
    cps.push(cp)
    pos = next
  }
  punycode_encode_cps(cps)
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into UTF-8.
pub fn punycode_decode(input : String) -> Result[String, ParseError] {
  match punycode_decode_cps(input, 0, input.length()) {
    Ok(cps) => {
      let sb = StringBuilder::with_capacity(cps.length() * 2)
      let mut i = 0
      while i < cps.length() {
        write_utf8_cp(sb, cps[i])
        i = i + 1
      }
      Ok(sb.to_string())
    }
    Err(e) => Err(e)
  }
}

fn build_forbidden_domain_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(128, 0)
  let mut b = 0
  while b < 128 {
    if b <= 0x20 ||
    b == 0x23 ||
    b == 0x25 ||
    b == 0x2F ||
    b == 0x3A ||
    b == 0x3C ||
    b == 0x3E ||
    b == 0x3F ||
    b == 0x40 ||
    b == 0x5B ||
    b == 0x5C ||
    b == 0x5D ||
    b == 0x5E ||
    b == 0x7C ||
    b == 0x7F {
      lut[b] = 1
    }
    b = b + 1
  }
  lut
}

let forbidden_domain_lut : FixedArray[Int] = build_forbidden_domain_lut()

///| Check whether ASCII byte `b` is a WHATWG forbidden domain code point.
fn is_forbidden_domain_byte(b : Int) -> Bool {
  forbidden_domain_lut[b] != 0
}

///| Check whether ASCII byte `b` is a WHATWG forbidden host code point.
fn is_forbidden_host_byte(b : Int) -> Bool {
  b == 0x00 ||
  b == 0x09 ||
  b == 0x0A ||
  b == 0x0D ||
  b == 0x20 ||
  b == 0x23 ||
  b == 0x2F ||
  b == 0x3A ||
  b == 0x3C ||
  b == 0x3E ||
  b == 0x3F ||
  b == 0x40 ||
  b == 0x5B ||
  b == 0x5C ||
  b == 0x5D ||
  b == 0x5E ||
  b == 0x7C
}

///| Map a Unicode code point per UTS #46 (non-transitional).
///| Returns:
///|  -1 : disallowed
///|  -2 : ignored (drop)
///|  >= 0 : mapped single code point (for ASCII/BMP/SMP)
fn uts46_map_single(cp : Int) -> Int {
  // ASCII fast path
  if cp < 0x80 {
    if cp >= 65 && cp <= 90 {
      return cp + 32
    }
    return cp
  }
  // C1 controls & non-breaking space / ideographic space / replacement / noncharacters
  if cp <= 0xA0 || cp == 0x3000 || cp == 0xFFFD {
    return -1
  }
  // Noncharacters: U+FDD0..U+FDEF and U+xxFFFE..U+xxFFFF
  if (cp >= 0xFDD0 && cp <= 0xFDEF) || (cp & 0xFFFE) == 0xFFFE {
    return -1
  }
  // Enclosed CJK Letters/Months & CJK Compatibility (disallowed/mapped in UTS #46)
  if cp >= 0x3200 && cp <= 0x33FF {
    return -1
  }
  // UTS #46 Ignored characters
  if cp == 0x00AD ||
  cp == 0x034F ||
  cp == 0x1806 ||
  cp == 0x200B ||
  cp == 0x2060 ||
  cp == 0xFEFF ||
  (cp >= 0xFE00 && cp <= 0xFE0F) {
    return -2
  }
  // Bidi format controls disallowed
  if cp >= 0x202A && cp <= 0x202E {
    return -1
  }
  // Label separators -> '.'
  if cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
    return 46
  }
  // Fullwidth ASCII U+FF01..U+FF5E -> U+0021..U+007E (lowercased)
  if cp >= 0xFF01 && cp <= 0xFF5E {
    let ascii = cp - 0xFF00 + 0x20
    if ascii >= 65 && ascii <= 90 {
      return ascii + 32
    }
    return ascii
  }
  // Latin-1 uppercase U+00C0..U+00DE (excluding U+00D7 multiplication sign)
  if cp >= 0x00C0 && cp <= 0x00DE && cp != 0x00D7 {
    return cp + 32
  }
  // Mathematical Alphanumeric Symbols (NFKC + case fold to ASCII lowercase)
  // Bold A-Z (1D400..1D419), Bold a-z (1D41A..1D433)
  if cp >= 0x1D400 && cp <= 0x1D419 {
    return 97 + (cp - 0x1D400)
  }
  if cp >= 0x1D41A && cp <= 0x1D433 {
    return 97 + (cp - 0x1D41A)
  }
  // Italic A-Z (1D434..1D44D), Italic a-z (1D44E..1D467)
  if cp >= 0x1D434 && cp <= 0x1D44D {
    return 97 + (cp - 0x1D434)
  }
  if cp >= 0x1D44E && cp <= 0x1D467 {
    return 97 + (cp - 0x1D44E)
  }
  // Bold Italic A-Z / a-z (1D468..1D49B)
  if cp >= 0x1D468 && cp <= 0x1D481 {
    return 97 + (cp - 0x1D468)
  }
  if cp >= 0x1D482 && cp <= 0x1D49B {
    return 97 + (cp - 0x1D482)
  }
  // Mathematical Bold/Double-struck/Sans-serif/Monospace digits (1D7CE..1D7FF)
  if cp >= 0x1D7CE && cp <= 0x1D7FF {
    return 48 + ((cp - 0x1D7CE) % 10)
  }
  // Greek uppercase U+0391..U+03AB (excluding U+03A2)
  if cp >= 0x0391 && cp <= 0x03AB && cp != 0x03A2 {
    return cp + 32
  }
  // Cyrillic uppercase U+0410..U+042F
  if cp >= 0x0410 && cp <= 0x042F {
    return cp + 32
  }
  // Keep valid Unicode scalar (including U+00DF 'ß' in non-transitional UTS #46!)
  cp
}

///| Check if a lowercase ASCII label starts with `xn--`.
fn label_is_punycode_ascii(s : String, start : Int, end : Int) -> Bool {
  if end - start < 4 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  let b2 = s.code_unit_at(start + 2)
  let b3 = s.code_unit_at(start + 3)
  (b0 == 120 || b0 == 88) &&
  (b1 == 110 || b1 == 78) &&
  b2 == 45 &&
  b3 == 45
}

///| Validate a single Punycode label `s[start..end]` (which starts with `xn--`).
fn validate_xn_label(s : String, start : Int, end : Int) -> Result[Unit, ParseError] {
  if end - start == 4 {
    return Err(err_idna("empty punycode label"))
  }
  let decoded = match punycode_decode_cps(s, start + 4, end) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  // Verify every decoded code point is valid under UTS #46 and has no forbidden domain char or '.'
  let mut i = 0
  while i < decoded.length() {
    let cp = decoded[i]
    if cp == 46 {
      return Err(err_idna("decoded punycode contains dot"))
    }
    if cp < 0x80 && is_forbidden_domain_byte(cp) {
      return Err(err_idna("decoded punycode contains forbidden domain char"))
    }
    let mapped = uts46_map_single(cp)
    if mapped != cp {
      return Err(err_idna("decoded punycode not normalized"))
    }
    i = i + 1
  }
  // Verify re-encoding matches original punycode suffix (canonical check)
  let reencoded = match punycode_encode_cps(decoded) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let orig_len = end - (start + 4)
  if reencoded.length() != orig_len {
    return Err(err_idna("non-canonical punycode label"))
  }
  let mut j = 0
  while j < orig_len {
    let mut b = s.code_unit_at(start + 4 + j)
    if b >= 65 && b <= 90 {
      b = b + 32
    }
    if b != reencoded.code_unit_at(j) {
      return Err(err_idna("non-canonical punycode label"))
    }
    j = j + 1
  }
  Ok(())
}

///| WHATWG `domain to ASCII` on a slice `domain[d_start..d_end]` (zero input slice allocation).
fn domain_to_ascii_slice(
  domain : String,
  d_start : Int,
  d_end : Int,
) -> Result[String, ParseError] {
  let n = d_end - d_start
  if n == 0 {
    return Ok("")
  }
  // Ultra-fast pure-ASCII scan
  let dlut = forbidden_domain_lut
  let mut is_ascii = true
  let mut has_upper = false
  let mut has_xn = false
  let mut i = d_start
  let mut label_start = d_start
  while i < d_end {
    let b = domain.code_unit_at(i)
    if b >= 0x80 {
      is_ascii = false
      break
    }
    if dlut[b] != 0 {
      return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden domain code point"))
    }
    if b >= 65 && b <= 90 {
      has_upper = true
    }
    if b == 46 {
      if label_is_punycode_ascii(domain, label_start, i) {
        has_xn = true
      }
      label_start = i + 1
    }
    i = i + 1
  }
  if is_ascii {
    if label_is_punycode_ascii(domain, label_start, d_end) {
      has_xn = true
    }
    if has_xn {
      let mut ls = d_start
      let mut k = d_start
      while k <= d_end {
        if k == d_end || domain.code_unit_at(k) == 46 {
          if label_is_punycode_ascii(domain, ls, k) {
            match validate_xn_label(domain, ls, k) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
          ls = k + 1
        }
        k = k + 1
      }
    }
    if !has_upper {
      return Ok(if d_start == 0 && d_end == domain.length() { domain } else { domain.slice(d_start, d_end) })
    }
    let sb = StringBuilder::with_capacity(n)
    let mut k = d_start
    while k < d_end {
      let b = domain.code_unit_at(k)
      if b >= 65 && b <= 90 {
        sb.write_byte((b + 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      k = k + 1
    }
    return Ok(sb.to_string())
  }
  // Non-ASCII UTS #46 mapping path using single FixedArray (zero dynamic growth!)
  let mapped : FixedArray[Int] = FixedArray::make(n + 2, 0)
  let mut total = 0
  let mut pos = d_start
  while pos < d_end {
    let (cp, next) = decode_utf8_at(domain, pos)
    pos = next
    if cp == 0x2025 {
      mapped[total] = 46
      mapped[total + 1] = 46
      total = total + 2
      continue
    }
    let m = uts46_map_single(cp)
    if m == -1 {
      return Err(err_idna("disallowed code point in domain"))
    }
    if m == -2 {
      continue
    }
    if m < 0x80 && dlut[m] != 0 {
      return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden domain code point"))
    }
    mapped[total] = m
    total = total + 1
  }
  let out = StringBuilder::with_capacity(total + 16)
  let mut ls = 0
  let mut k = 0
  while k <= total {
    if k == total || mapped[k] == 46 {
      if ls > 0 {
        out.write_byte((46).to_byte())
      }
      let mut label_has_non_ascii = false
      let mut j = ls
      while j < k {
        if mapped[j] >= 0x80 {
          label_has_non_ascii = true
          break
        }
        j = j + 1
      }
      if label_has_non_ascii {
        out.write_string("xn--")
        match punycode_encode_fixed_range(out, mapped, ls, k) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else {
        let llen = k - ls
        if llen >= 4 &&
        mapped[ls] == 120 &&
        mapped[ls + 1] == 110 &&
        mapped[ls + 2] == 45 &&
        mapped[ls + 3] == 45 {
          let label_sb = StringBuilder::with_capacity(llen)
          j = ls
          while j < k {
            label_sb.write_byte(mapped[j].to_byte())
            j = j + 1
          }
          let lstr = label_sb.to_string()
          match validate_xn_label(lstr, 0, llen) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          out.write_string(lstr)
        } else {
          j = ls
          while j < k {
            out.write_byte(mapped[j].to_byte())
            j = j + 1
          }
        }
      }
      ls = k + 1
    }
    k = k + 1
  }
  Ok(out.to_string())
}

///| Encode `cps[c_start..c_end]` from a `FixedArray[Int]` into Punycode directly into `sb`.
fn punycode_encode_fixed_range(
  sb : StringBuilder,
  cps : FixedArray[Int],
  c_start : Int,
  c_end : Int,
) -> Result[Unit, ParseError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(err_idna("punycode encode overflow"))
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(err_idna("punycode encode overflow"))
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = if k <= bias {
            puny_tmin
          } else if k >= bias + puny_tmax {
            puny_tmax
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

///| WHATWG `domain to ASCII` (UTS #46 non-transitional, beStrict=false).
pub fn domain_to_ascii(domain : String) -> Result[String, ParseError] {
  domain_to_ascii_slice(domain, 0, domain.length())
}

///| WHATWG `domain to Unicode` (decodes valid `xn--` labels to UTF-8).
pub fn domain_to_unicode(domain : String) -> String {
  let ascii = match domain_to_ascii(domain) {
    Ok(v) => v
    Err(_) => return ""
  }
  let n = ascii.length()
  let sb = StringBuilder::with_capacity(n)
  let mut ls = 0
  let mut i = 0
  while i <= n {
    if i == n || ascii.code_unit_at(i) == 46 {
      if ls > 0 {
        sb.write_byte((46).to_byte())
      }
      if label_is_punycode_ascii(ascii, ls, i) {
        match punycode_decode_cps(ascii, ls + 4, i) {
          Ok(cps) => {
            let mut j = 0
            while j < cps.length() {
              write_utf8_cp(sb, cps[j])
              j = j + 1
            }
          }
          Err(_) => sb.write_substring(ascii, ls, i)
        }
      } else {
        sb.write_substring(ascii, ls, i)
      }
      ls = i + 1
    }
    i = i + 1
  }
  sb.to_string()
}
