///| Pure-Pion RFC 3492 Punycode and full Unicode 16.0.0 UTS #46 / IDNA domain processing.

let puny_base : Int64 = 36L

let puny_tmin : Int64 = 1L

let puny_tmax : Int64 = 26L

let puny_skew : Int64 = 38L

let puny_damp : Int64 = 700L

let puny_init_bias : Int64 = 72L

let puny_init_n : Int64 = 128L

let puny_max_u32 : Int64 = 0x7FFFFFFFL

///| Input caps matching Rust `idna 1.1.0` (`src/uts46.rs`) to prevent quadratic Punycode DoS.
let puny_encode_max_input_len : Int = 1000

let puny_decode_max_input_len : Int = 2000

fn err_idna(msg : String) -> ParseError {
  ParseError::new(ParseErrorKind::IdnaError, msg)
}

fn uts46_lookup_fast(cp : Int) -> Int {
  if cp < 256 {
    latin1_uts46_lut[cp]
  } else if cp >= 0x4E00 && cp <= 0x9FFF {
    1
  } else {
    uts46_lookup(cp)
  }
}

fn puny_adapt(delta_in : Int64, num_points : Int64, first_time : Bool) -> Int64 {
  let mut delta = if first_time { delta_in / puny_damp } else { delta_in >> 1 }
  delta = delta + delta / num_points
  let mut k = 0L
  while delta > ((puny_base - puny_tmin) * puny_tmax) / 2L {
    delta = delta / (puny_base - puny_tmin)
    k = k + puny_base
  }
  k + ((puny_base - puny_tmin + 1L) * delta) / (delta + puny_skew)
}

fn puny_encode_digit(d : Int64) -> Byte {
  if d < 26L {
    (97 + d.to_int()).to_byte()
  } else {
    (48 + (d - 26L).to_int()).to_byte()
  }
}

fn puny_decode_digit(b : Int) -> Int64 {
  if b >= 97 && b <= 122 {
    (b - 97).to_int64()
  } else if b >= 65 && b <= 90 {
    (b - 65).to_int64()
  } else if b >= 48 && b <= 57 {
    (b - 48 + 26).to_int64()
  } else {
    -1L
  }
}

///| Encode a slice `cps[c_start..c_end]` of Unicode scalar values into RFC 3492 Punycode
///| directly into `sb` (without `xn--` prefix).
fn punycode_encode_cps_range(
  sb : StringBuilder,
  cps : Array[Int],
  c_start : Int,
  c_end : Int,
) -> Result[Unit, ParseError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(err_idna("punycode encode overflow"))
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(err_idna("punycode encode overflow"))
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = if k <= bias {
            puny_tmin
          } else if k >= bias + puny_tmax {
            puny_tmax
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

///| Encode a slice `cps[c_start..c_end]` from a `FixedArray[Int]` into Punycode directly into `sb`.
fn punycode_encode_fixed_range(
  sb : StringBuilder,
  cps : FixedArray[Int],
  c_start : Int,
  c_end : Int,
) -> Result[Unit, ParseError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(err_idna("punycode encode overflow"))
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(err_idna("punycode encode overflow"))
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = if k <= bias {
            puny_tmin
          } else if k >= bias + puny_tmax {
            puny_tmax
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

///| Encode a slice of Unicode scalar values into RFC 3492 Punycode (without `xn--` prefix).
fn punycode_encode_cps(cps : Array[Int]) -> Result[String, ParseError] {
  let sb = StringBuilder::with_capacity(cps.length() * 2 + 8)
  match punycode_encode_cps_range(sb, cps, 0, cps.length()) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into Unicode scalar values.
fn punycode_decode_cps(
  input : String,
  start : Int,
  end : Int,
) -> Result[Array[Int], ParseError] {
  let out : Array[Int] = []
  let mut last_dash = -1
  let mut idx = start
  while idx < end {
    let ch = input.code_unit_at(idx)
    if ch >= 0x80 {
      return Err(err_idna("non-ASCII in punycode"))
    }
    if ch == 45 {
      last_dash = idx
    }
    idx = idx + 1
  }
  if last_dash >= start {
    idx = start
    while idx < last_dash {
      out.push(input.code_unit_at(idx))
      idx = idx + 1
    }
    idx = last_dash + 1
  } else {
    idx = start
  }
  let mut n = puny_init_n
  let mut i = 0L
  let mut bias = puny_init_bias
  let mut has_non_ascii = false
  while idx < end {
    let old_i = i
    let mut w = 1L
    let mut k = puny_base
    while true {
      if idx >= end {
        return Err(err_idna("truncated punycode"))
      }
      let digit = puny_decode_digit(input.code_unit_at(idx))
      idx = idx + 1
      if digit < 0L {
        return Err(err_idna("invalid punycode digit"))
      }
      if digit > (puny_max_u32 - i) / w {
        return Err(err_idna("punycode overflow"))
      }
      i = i + digit * w
      let t = if k <= bias {
        puny_tmin
      } else if k >= bias + puny_tmax {
        puny_tmax
      } else {
        k - bias
      }
      if digit < t {
        break
      }
      let mult = puny_base - t
      if w > puny_max_u32 / mult {
        return Err(err_idna("punycode weight overflow"))
      }
      w = w * mult
      k = k + puny_base
    }
    let out_len1 = (out.length() + 1).to_int64()
    bias = puny_adapt(i - old_i, out_len1, old_i == 0L)
    let inc = i / out_len1
    if inc > 0x10FFFFL - n {
      return Err(err_idna("punycode code point overflow"))
    }
    n = n + inc
    i = i % out_len1
    let cp = n.to_int()
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(err_idna("invalid punycode scalar"))
    }
    if cp >= 0x80 {
      has_non_ascii = true
    }
    let pos = i.to_int()
    out.push(0)
    let mut j = out.length() - 1
    while j > pos {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[pos] = cp
    i = i + 1L
  }
  if !has_non_ascii {
    return Err(err_idna("punycode label has no non-ASCII code points"))
  }
  Ok(out)
}

///| Decode an RFC 3492 Punycode label from `Array[Int]` (`cps[start..end]`, without `xn--`).
fn punycode_decode_cp_slice(
  cps : Array[Int],
  start : Int,
  end : Int,
) -> Result[Array[Int], ParseError] {
  if end <= start || end - start > puny_decode_max_input_len {
    return Err(err_idna("punycode label length out of bounds"))
  }
  let out : Array[Int] = []
  let mut last_dash = -1
  let mut idx = start
  while idx < end {
    let ch = cps[idx]
    if ch >= 0x80 {
      return Err(err_idna("non-ASCII in punycode"))
    }
    if ch == 45 {
      last_dash = idx
    }
    idx = idx + 1
  }
  if last_dash >= start {
    idx = start
    while idx < last_dash {
      out.push(cps[idx])
      idx = idx + 1
    }
    idx = last_dash + 1
  } else {
    idx = start
  }
  let mut n = puny_init_n
  let mut i = 0L
  let mut bias = puny_init_bias
  let mut has_non_ascii = false
  while idx < end {
    let old_i = i
    let mut w = 1L
    let mut k = puny_base
    while true {
      if idx >= end {
        return Err(err_idna("truncated punycode"))
      }
      let digit = puny_decode_digit(cps[idx])
      idx = idx + 1
      if digit < 0L {
        return Err(err_idna("invalid punycode digit"))
      }
      if digit > (puny_max_u32 - i) / w {
        return Err(err_idna("punycode overflow"))
      }
      i = i + digit * w
      let t = if k <= bias {
        puny_tmin
      } else if k >= bias + puny_tmax {
        puny_tmax
      } else {
        k - bias
      }
      if digit < t {
        break
      }
      let mult = puny_base - t
      if w > puny_max_u32 / mult {
        return Err(err_idna("punycode weight overflow"))
      }
      w = w * mult
      k = k + puny_base
    }
    let out_len1 = (out.length() + 1).to_int64()
    bias = puny_adapt(i - old_i, out_len1, old_i == 0L)
    let inc = i / out_len1
    if inc > 0x10FFFFL - n {
      return Err(err_idna("punycode code point overflow"))
    }
    n = n + inc
    i = i % out_len1
    let cp = n.to_int()
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(err_idna("invalid punycode scalar"))
    }
    if cp >= 0x80 {
      has_non_ascii = true
    }
    let pos = i.to_int()
    out.push(0)
    let mut j = out.length() - 1
    while j > pos {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[pos] = cp
    i = i + 1L
  }
  if !has_non_ascii {
    return Err(err_idna("punycode label has no non-ASCII code points"))
  }
  Ok(out)
}

///| Encode a UTF-8 string into RFC 3492 Punycode (without `xn--` prefix).
pub fn punycode_encode(input : String) -> Result[String, ParseError] {
  let cps : Array[Int] = []
  let n = input.length()
  let mut pos = 0
  while pos < n {
    let (cp, next) = decode_utf8_at(input, pos)
    cps.push(cp)
    pos = next
  }
  punycode_encode_cps(cps)
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into UTF-8.
pub fn punycode_decode(input : String) -> Result[String, ParseError] {
  match punycode_decode_cps(input, 0, input.length()) {
    Ok(cps) => {
      let sb = StringBuilder::with_capacity(cps.length() * 2)
      let mut i = 0
      while i < cps.length() {
        write_utf8_cp(sb, cps[i])
        i = i + 1
      }
      Ok(sb.to_string())
    }
    Err(e) => Err(e)
  }
}

fn build_forbidden_domain_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(128, 0)
  let mut b = 0
  while b < 128 {
    if b <= 0x20 ||
    b == 0x23 ||
    b == 0x25 ||
    b == 0x2F ||
    b == 0x3A ||
    b == 0x3C ||
    b == 0x3E ||
    b == 0x3F ||
    b == 0x40 ||
    b == 0x5B ||
    b == 0x5C ||
    b == 0x5D ||
    b == 0x5E ||
    b == 0x7C ||
    b == 0x7F {
      lut[b] = 1
    }
    b = b + 1
  }
  lut
}

let forbidden_domain_lut : FixedArray[Int] = build_forbidden_domain_lut()

///| Check whether ASCII byte `b` is a WHATWG forbidden domain code point.
fn is_forbidden_domain_byte(b : Int) -> Bool {
  forbidden_domain_lut[b] != 0
}

///| Check whether ASCII byte `b` is a WHATWG forbidden host code point.
fn is_forbidden_host_byte(b : Int) -> Bool {
  b == 0x00 ||
  b == 0x09 ||
  b == 0x0A ||
  b == 0x0D ||
  b == 0x20 ||
  b == 0x23 ||
  b == 0x2F ||
  b == 0x3A ||
  b == 0x3C ||
  b == 0x3E ||
  b == 0x3F ||
  b == 0x40 ||
  b == 0x5B ||
  b == 0x5C ||
  b == 0x5D ||
  b == 0x5E ||
  b == 0x7C
}

// ---------------------------------------------------------------------------
// Unicode 16.0.0 NFC Normalization (Canonical Decomp + Ordering + Composition)
// ---------------------------------------------------------------------------

let hangul_sbase : Int = 0xAC00

let hangul_lbase : Int = 0x1100

let hangul_vbase : Int = 0x1161

let hangul_tbase : Int = 0x11A7

let hangul_lcount : Int = 19

let hangul_vcount : Int = 21

let hangul_tcount : Int = 28

let hangul_ncount : Int = 588

let hangul_scount : Int = 11172

///| Fast check: could `cp` ever trigger NFC change when appearing in a UTS #46 mapped stream?
///| Verified exhaustively against Unicode 16.0.0: 0 valid IDNA cps are singletons, and all
///| ccc==0 composition-trailing cps lie in 0x09BE..0x1B35 or 0x11127..0x113FF (plus Hangul Jamo V/T).
fn cp_may_need_nfc(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  if cp >= 0x4E00 && cp <= 0x9FFF {
    return false
  }
  if cp >= 0xAC00 && cp <= 0xD7A3 {
    return false
  }
  if cp >= 0x1161 && cp <= 0x11C2 {
    return true
  }
  if (cp >= 0x09BE && cp <= 0x1B35) || (cp >= 0x11127 && cp <= 0x113FF) {
    return true
  }
  unicode_ccc(cp) != 0
}

///| Fast check: could `cp` have Bidi_Class R, AL, or AN (triggering RFC 5893 Bidi domain check)?
fn cp_may_be_rtl(cp : Int) -> Bool {
  if cp < 0x0590 {
    return false
  }
  if cp >= 0x4E00 && cp <= 0x9FFF {
    return false
  }
  if cp >= 0xAC00 && cp <= 0xD7A3 {
    return false
  }
  if cp >= 0x3040 && cp <= 0x30FF {
    return false
  }
  let bc = unicode_bidi_class(cp)
  bc == 1 || bc == 2 || bc == 6
}

///| Apply Unicode NFC normalization to `cps`.
fn nfc_normalize(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n == 0 {
    return cps
  }
  let dec : Array[Int] = []
  let mut i = 0
  let mut has_combining_or_hangul = false
  while i < n {
    let cp = cps[i]
    if cp >= hangul_sbase && cp < hangul_sbase + hangul_scount {
      let s_idx = cp - hangul_sbase
      let l = hangul_lbase + s_idx / hangul_ncount
      let v = hangul_vbase + (s_idx % hangul_ncount) / hangul_tcount
      let t = hangul_tbase + s_idx % hangul_tcount
      dec.push(l)
      dec.push(v)
      if t != hangul_tbase {
        dec.push(t)
      }
      has_combining_or_hangul = true
    } else if cp < 0x00C0 {
      dec.push(cp)
    } else {
      if cp >= hangul_lbase && cp < hangul_tbase + hangul_tcount {
        has_combining_or_hangul = true
      }
      let info = unicode_decomp_info(cp)
      if info >= 0 {
        let off = info & 0xFFFF
        let dlen = info >> 16
        let mut k = 0
        while k < dlen {
          dec.push(decomp_pool[off + k])
          k = k + 1
        }
        has_combining_or_hangul = true
      } else {
        if unicode_ccc(cp) != 0 {
          has_combining_or_hangul = true
        }
        dec.push(cp)
      }
    }
    i = i + 1
  }
  if !has_combining_or_hangul {
    return dec
  }
  let dn = dec.length()
  i = 0
  while i < dn {
    if unicode_ccc(dec[i]) == 0 {
      i = i + 1
      continue
    }
    let mut j = i + 1
    while j < dn && unicode_ccc(dec[j]) != 0 {
      j = j + 1
    }
    let mut a = i + 1
    while a < j {
      let cur = dec[a]
      let cur_c = unicode_ccc(cur)
      let mut b = a - 1
      while b >= i && unicode_ccc(dec[b]) > cur_c {
        dec[b + 1] = dec[b]
        b = b - 1
      }
      dec[b + 1] = cur
      a = a + 1
    }
    i = j
  }
  let out : Array[Int] = []
  let mut starter_idx = -1
  let mut last_ccc = -1
  i = 0
  while i < dn {
    let cp = dec[i]
    let c = unicode_ccc(cp)
    if starter_idx >= 0 && (last_ccc < c || last_ccc == 0) {
      let st = out[starter_idx]
      let composed = if st >= hangul_lbase &&
      st < hangul_lbase + hangul_lcount &&
      cp >= hangul_vbase &&
      cp < hangul_vbase + hangul_vcount {
        hangul_sbase + ((st - hangul_lbase) * hangul_vcount + (cp - hangul_vbase)) * hangul_tcount
      } else if st >= hangul_sbase &&
      st < hangul_sbase + hangul_scount &&
      (st - hangul_sbase) % hangul_tcount == 0 &&
      cp > hangul_tbase &&
      cp < hangul_tbase + hangul_tcount {
        st + (cp - hangul_tbase)
      } else {
        unicode_compose_pair(st, cp)
      }
      if composed >= 0 {
        out[starter_idx] = composed
        i = i + 1
        continue
      }
    }
    if c == 0 {
      starter_idx = out.length()
      last_ccc = 0
    } else {
      last_ccc = c
    }
    out.push(cp)
    i = i + 1
  }
  out
}

fn cps_equal(a : Array[Int], b : Array[Int]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

// ---------------------------------------------------------------------------
// UTS #46 Validity Criteria: CheckJoiners (RFC 5892) & CheckBidi (RFC 5893)
// ---------------------------------------------------------------------------

fn check_joiners(label : Array[Int]) -> Bool {
  let n = label.length()
  let mut i = 0
  while i < n {
    let cp = label[i]
    if cp == 0x200D {
      if i == 0 || unicode_ccc(label[i - 1]) != 9 {
        return false
      }
    } else if cp == 0x200C {
      if i > 0 && unicode_ccc(label[i - 1]) == 9 {
        i = i + 1
        continue
      }
      let mut j = i - 1
      while j >= 0 && unicode_joining_type(label[j]) == 4 {
        j = j - 1
      }
      if j < 0 {
        return false
      }
      let jtl = unicode_joining_type(label[j])
      if jtl != 1 && jtl != 3 {
        return false
      }
      let mut k = i + 1
      while k < n && unicode_joining_type(label[k]) == 4 {
        k = k + 1
      }
      if k >= n {
        return false
      }
      let jtr = unicode_joining_type(label[k])
      if jtr != 2 && jtr != 3 {
        return false
      }
    }
    i = i + 1
  }
  true
}

fn check_bidi_domain(labels : Array[Array[Int]]) -> Bool {
  let num_labels = labels.length()
  let mut is_bidi = false
  let mut li = 0
  while li < num_labels && !is_bidi {
    let lab = labels[li]
    let ln = lab.length()
    let mut i = 0
    while i < ln {
      let bc = unicode_bidi_class(lab[i])
      if bc == 1 || bc == 2 || bc == 6 {
        is_bidi = true
        break
      }
      i = i + 1
    }
    li = li + 1
  }
  if !is_bidi {
    return true
  }
  li = 0
  while li < num_labels {
    let lab = labels[li]
    let ln = lab.length()
    if ln == 0 {
      li = li + 1
      continue
    }
    let bc0 = unicode_bidi_class(lab[0])
    if bc0 == 1 || bc0 == 2 {
      let mut has_en = false
      let mut has_an = false
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 0 || bc == 11 {
          return false
        }
        if bc == 3 {
          has_en = true
        } else if bc == 6 {
          has_an = true
        }
        i = i + 1
      }
      if has_en && has_an {
        return false
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return false
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 1 && lbc != 2 && lbc != 3 && lbc != 6 {
        return false
      }
    } else if bc0 == 0 {
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 1 || bc == 2 || bc == 6 || bc == 11 {
          return false
        }
        i = i + 1
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return false
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 0 && lbc != 3 {
        return false
      }
    } else {
      return false
    }
    li = li + 1
  }
  true
}

///| Check if an ASCII label in `s[start..end]` starts with `xn--` (case-insensitive).
fn label_is_punycode_ascii(s : String, start : Int, end : Int) -> Bool {
  if end - start < 4 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  let b2 = s.code_unit_at(start + 2)
  let b3 = s.code_unit_at(start + 3)
  (b0 == 120 || b0 == 88) &&
  (b1 == 110 || b1 == 78) &&
  b2 == 45 &&
  b3 == 45
}

///| Core UTS #46 processing returning validated Unicode labels.
fn uts46_process_labels(
  domain : String,
  d_start : Int,
  d_end : Int,
) -> Result[Array[Array[Int]], ParseError] {
  let mapped : Array[Int] = []
  let mut needs_nfc = false
  let mut has_joiner = false
  let mut pos = d_start
  while pos < d_end {
    let (cp, next) = decode_utf8_at(domain, pos)
    pos = next
    if cp < 0x80 {
      let c = if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
      mapped.push(c)
    } else {
      let v = uts46_lookup_fast(cp)
      if v == 0 {
        return Err(err_idna("disallowed code point in domain"))
      } else if v == 1 {
        if cp == 0x200C || cp == 0x200D {
          has_joiner = true
        }
        if !needs_nfc && cp_may_need_nfc(cp) {
          needs_nfc = true
        }
        mapped.push(cp)
      } else if v == 2 {
        continue
      } else if (v & 7) == 3 {
        let m = cp + (v >> 3)
        if !needs_nfc && cp_may_need_nfc(m) {
          needs_nfc = true
        }
        mapped.push(m)
      } else {
        let off = (v >> 3) & 0xFFFF
        let mlen = v >> 19
        let mut k = 0
        while k < mlen {
          let m = idna_pool[off + k]
          if !needs_nfc && cp_may_need_nfc(m) {
            needs_nfc = true
          }
          mapped.push(m)
          k = k + 1
        }
      }
    }
  }
  let norm = if needs_nfc { nfc_normalize(mapped) } else { mapped }
  let norm_len = norm.length()
  let labels : Array[Array[Int]] = []
  let mut ls = 0
  let mut k = 0
  while k <= norm_len {
    if k == norm_len || norm[k] == 46 {
      let llen = k - ls
      let is_xn = llen >= 4 &&
      norm[ls] == 120 &&
      norm[ls + 1] == 110 &&
      norm[ls + 2] == 45 &&
      norm[ls + 3] == 45
      if is_xn {
        let mut j = ls
        while j < k {
          if norm[j] >= 0x80 {
            return Err(err_idna("non-ASCII in xn-- label"))
          }
          j = j + 1
        }
        let dec = match punycode_decode_cp_slice(norm, ls + 4, k) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let dec_nfc = nfc_normalize(dec)
        if !cps_equal(dec, dec_nfc) {
          return Err(err_idna("decoded punycode label is not NFC"))
        }
        let dn = dec.length()
        if dn > 0 && unicode_is_mark(dec[0]) {
          return Err(err_idna("label starts with combining mark"))
        }
        let mut di = 0
        while di < dn {
          let cp = dec[di]
          if cp == 46 {
            return Err(err_idna("decoded punycode contains dot"))
          }
          if uts46_lookup_fast(cp) != 1 {
            return Err(err_idna("disallowed or mapped code point in decoded punycode"))
          }
          di = di + 1
        }
        if !check_joiners(dec) {
          return Err(err_idna("ContextJ joiner rule violated"))
        }
        labels.push(dec)
      } else {
        let lab : Array[Int] = []
        let mut j = ls
        while j < k {
          let cp = norm[j]
          if needs_nfc && cp >= 0x80 && uts46_lookup_fast(cp) != 1 {
            return Err(err_idna("disallowed code point after NFC"))
          }
          lab.push(cp)
          j = j + 1
        }
        if lab.length() > 0 && unicode_is_mark(lab[0]) {
          return Err(err_idna("label starts with combining mark"))
        }
        if has_joiner && !check_joiners(lab) {
          return Err(err_idna("ContextJ joiner rule violated"))
        }
        labels.push(lab)
      }
      ls = k + 1
    }
    k = k + 1
  }
  if !check_bidi_domain(labels) {
    return Err(err_idna("Bidi rule violated"))
  }
  Ok(labels)
}

///| WHATWG `domain to ASCII` on a slice `domain[d_start..d_end]` (zero input slice allocation).
fn domain_to_ascii_slice(
  domain : String,
  d_start : Int,
  d_end : Int,
) -> Result[String, ParseError] {
  let n = d_end - d_start
  if n == 0 {
    return Ok("")
  }
  // Ultra-fast pure-ASCII zero-alloc scan
  let dlut = forbidden_domain_lut
  let mut is_ascii = true
  let mut has_upper = false
  let mut has_xn = false
  let mut has_forbidden = false
  let mut i = d_start
  let mut label_start = d_start
  while i < d_end {
    let b = domain.code_unit_at(i)
    if b >= 0x80 {
      is_ascii = false
      break
    }
    if dlut[b] != 0 {
      has_forbidden = true
    } else if b >= 65 && b <= 90 {
      has_upper = true
    } else if b == 46 {
      if label_is_punycode_ascii(domain, label_start, i) {
        has_xn = true
      }
      label_start = i + 1
    }
    i = i + 1
  }
  if is_ascii {
    if has_forbidden {
      return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden domain code point"))
    }
    if label_is_punycode_ascii(domain, label_start, d_end) {
      has_xn = true
    }
    if !has_xn {
      if !has_upper {
        return Ok(
          if d_start == 0 && d_end == domain.length() {
            domain
          } else {
            domain.slice(d_start, d_end)
          },
        )
      }
      let sb = StringBuilder::with_capacity(n)
      let mut k = d_start
      while k < d_end {
        let b = domain.code_unit_at(k)
        if b >= 65 && b <= 90 {
          sb.write_byte((b + 32).to_byte())
        } else {
          sb.write_byte(b.to_byte())
        }
        k = k + 1
      }
      return Ok(sb.to_string())
    }
  }
  // Fast non-ASCII single-FixedArray path for common already-NFC, non-Bidi, non-Joiner, non-xn-- IDNs!
  if !is_ascii {
    let mapped : FixedArray[Int] = FixedArray::make(n + 4, 0)
    let mut total = 0
    let mut ok_fast = true
    let mut pos = d_start
    while pos < d_end {
      let (cp, next) = decode_utf8_at(domain, pos)
      pos = next
      if cp < 0x80 {
        let c = if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
        if dlut[c] != 0 {
          // Could combine with a following combining mark (e.g. `≯` -> `≯`), fall back to full path
          ok_fast = false
          break
        }
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = c
        total = total + 1
      } else {
        let v = uts46_lookup_fast(cp)
        if v == 0 {
          return Err(err_idna("disallowed code point in domain"))
        } else if v == 1 {
          if cp == 0x200C || cp == 0x200D || cp_may_need_nfc(cp) || cp_may_be_rtl(cp) {
            ok_fast = false
            break
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if m < 0x80 {
            if dlut[m] != 0 {
              ok_fast = false
              break
            }
          } else if cp_may_need_nfc(m) || cp_may_be_rtl(m) {
            ok_fast = false
            break
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_fast = false
          break
        }
      }
    }
    if ok_fast && total > 0 {
      // Verify no `xn--` label and no leading combining mark (V6)
      let mut ls = 0
      let mut k = 0
      while k <= total {
        if k == total || mapped[k] == 46 {
          let llen = k - ls
          if llen > 0 && unicode_is_mark(mapped[ls]) {
            return Err(err_idna("label starts with combining mark"))
          }
          if llen >= 4 &&
          mapped[ls] == 120 &&
          mapped[ls + 1] == 110 &&
          mapped[ls + 2] == 45 &&
          mapped[ls + 3] == 45 {
            ok_fast = false
            break
          }
          ls = k + 1
        }
        k = k + 1
      }
      if ok_fast {
        let out = StringBuilder::with_capacity(total * 2 + 16)
        ls = 0
        k = 0
        while k <= total {
          if k == total || mapped[k] == 46 {
            if ls > 0 {
              out.write_byte((46).to_byte())
            }
            let mut label_has_non_ascii = false
            let mut j = ls
            while j < k {
              if mapped[j] >= 0x80 {
                label_has_non_ascii = true
                break
              }
              j = j + 1
            }
            if label_has_non_ascii {
              if k - ls > puny_encode_max_input_len {
                return Err(err_idna("punycode encode input too long"))
              }
              out.write_string("xn--")
              match punycode_encode_fixed_range(out, mapped, ls, k) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            } else {
              j = ls
              while j < k {
                out.write_byte(mapped[j].to_byte())
                j = j + 1
              }
            }
            ls = k + 1
          }
          k = k + 1
        }
        return Ok(out.to_string())
      }
    }
  }
  // Full Unicode 16.0.0 UTS #46 path (NFC + Bidi + ContextJ + multi-map + xn-- validation)
  let labels = match uts46_process_labels(domain, d_start, d_end) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let out = StringBuilder::with_capacity(n + 16)
  let num_labels = labels.length()
  let mut li = 0
  while li < num_labels {
    if li > 0 {
      out.write_byte((46).to_byte())
    }
    let lab = labels[li]
    let ln = lab.length()
    let mut has_non_ascii = false
    let mut j = 0
    while j < ln {
      if lab[j] >= 0x80 {
        has_non_ascii = true
        break
      }
      j = j + 1
    }
    if has_non_ascii {
      if ln > puny_encode_max_input_len {
        return Err(err_idna("punycode encode input too long"))
      }
      out.write_string("xn--")
      match punycode_encode_cps_range(out, lab, 0, ln) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      j = 0
      while j < ln {
        let b = lab[j]
        if dlut[b] != 0 {
          return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden domain code point"))
        }
        out.write_byte(b.to_byte())
        j = j + 1
      }
    }
    li = li + 1
  }
  let res = out.to_string()
  let rn = res.length()
  if rn == 0 {
    return Err(err_idna("empty domain after UTS #46"))
  }
  let mut ri = 0
  while ri < rn {
    let b = res.code_unit_at(ri)
    if b < 0x80 && dlut[b] != 0 {
      return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden domain code point"))
    }
    ri = ri + 1
  }
  Ok(res)
}

///| WHATWG `domain to ASCII` (UTS #46 non-transitional, beStrict=false).
pub fn domain_to_ascii(domain : String) -> Result[String, ParseError] {
  domain_to_ascii_slice(domain, 0, domain.length())
}

///| WHATWG `domain to Unicode` (decodes valid `xn--` labels to UTF-8).
pub fn domain_to_unicode(domain : String) -> String {
  let n = domain.length()
  if n == 0 {
    return ""
  }
  let labels = match uts46_process_labels(domain, 0, n) {
    Ok(v) => v
    Err(_) => return ""
  }
  let dlut = forbidden_domain_lut
  let sb = StringBuilder::with_capacity(n + 16)
  let num_labels = labels.length()
  let mut li = 0
  while li < num_labels {
    if li > 0 {
      sb.write_byte((46).to_byte())
    }
    let lab = labels[li]
    let ln = lab.length()
    let mut j = 0
    while j < ln {
      let cp = lab[j]
      if cp < 0x80 && dlut[cp] != 0 {
        return ""
      }
      write_utf8_cp(sb, cp)
      j = j + 1
    }
    li = li + 1
  }
  sb.to_string()
}
