let bidi_end : FixedArray[Int] = decode_vlq_end_array(bidi_start, bidi_e_data, 1531)
let bidi_val : FixedArray[Int] = decode_vlq_u_array(bidi_v_data, 1531)

let jt_count : Int = 514
let jt_start : FixedArray[Int] = decode_vlq_delta_array(jt_s_data, 514)
let jt_end : FixedArray[Int] = decode_vlq_end_array(jt_start, jt_e_data, 514)
let jt_val : FixedArray[Int] = decode_vlq_u_array(jt_v_data, 514)

///| Lookup UTS #46 mapping entry for `cp`.
///| Returns: 0=disallowed, 1=valid, 2=ignored, (v&7)==3 => delta=(v>>3), (v&7)==4 => multi.
fn uts46_lookup(cp : Int) -> Int {
  let starts = idna_start
  let mut lo = 0
  let mut hi = idna_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= idna_end[hi] {
    idna_val[hi]
  } else {
    0
  }
}

///| Lookup Unicode Canonical Combining Class (0 if not combining).
fn unicode_ccc(cp : Int) -> Int {
  if cp < 0x0300 {
    return 0
  }
  let starts = ccc_start
  let mut lo = 0
  let mut hi = ccc_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= ccc_end[hi] {
    ccc_val[hi]
  } else {
    0
  }
}

///| Lookup canonical decomposition info for `cp`, or -1 if none.
fn unicode_decomp_info(cp : Int) -> Int {
  if cp < 0x00C0 {
    return -1
  }
  let cps = decomp_cp
  let mut lo = 0
  let mut hi = decomp_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let v = cps[mid]
    if v == cp {
      return decomp_info[mid]
    } else if v < cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

///| Lookup canonical composition for `(c1, c2)`, or -1 if none.
fn unicode_compose_pair(c1 : Int, c2 : Int) -> Int {
  let key = (c1.to_int64() << 21L) | c2.to_int64()
  let keys = comp_key
  let mut lo = 0
  let mut hi = comp_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let v = keys[mid]
    if v == key {
      return comp_val[mid]
    } else if v < key {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

///| Return true if `cp` has General_Category Mn, Mc, or Me.
fn unicode_is_mark(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  let starts = mark_start
  let mut lo = 0
  let mut hi = mark_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hi >= 0 && cp <= mark_end[hi]
}

///| Lookup Bidi_Class: 0=L, 1=R, 2=AL, 3=EN, 4=ES, 5=ET, 6=AN, 7=CS, 8=NSM, 9=BN, 10=ON, 11=OTHER.
fn unicode_bidi_class(cp : Int) -> Int {
  if cp >= 97 && cp <= 122 {
    return 0
  }
  let starts = bidi_start
  let mut lo = 0
  let mut hi = bidi_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= bidi_end[hi] {
    bidi_val[hi]
  } else {
    0
  }
}

///| Lookup Joining_Type: 0=other, 1=L, 2=R, 3=D, 4=T.
fn unicode_joining_type(cp : Int) -> Int {
  if cp < 0x0300 {
    return 0
  }
  let starts = jt_start
  let mut lo = 0
  let mut hi = jt_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= jt_end[hi] {
    jt_val[hi]
  } else {
    0
  }
}

fn build_latin1_uts46_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut cp = 0
  while cp < 256 {
    lut[cp] = uts46_lookup(cp)
    cp = cp + 1
  }
  lut
}

let latin1_uts46_lut : FixedArray[Int] = build_latin1_uts46_lut()
