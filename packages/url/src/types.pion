///|
pub fn Url::set_path(self : Url, path : String) -> Unit {
  let _ = self
  let _ = path
}

///|
pub fn Url::set_pathname(self : Url, pathname : String) -> Unit {
  let _ = self
  let _ = pathname
}

///|
pub fn Url::set_query(self : Url, query : Option[String]) -> Unit {
  let _ = self
  let _ = query
