///| Core types, getters, and Origin serialization for the pure-Pion WHATWG URL Standard library.

///| Error kind variants for URL parsing and mutation.
pub enum ParseErrorKind {
  EmptyHost
  IdnaError
  InvalidPort
  InvalidIpv4Address
  InvalidIpv6Address
  InvalidDomainCharacter
  RelativeUrlWithoutBase
  RelativeUrlWithCannotBeABaseBase
  SetHostOnCannotBeABaseUrl
  Overflow
  InvalidScheme
  MissingSchemeNonRelativeUrl
  Unimplemented
}

///| Errors returned when parsing or mutating a URL.
pub struct ParseError {
  pub kind : ParseErrorKind
  pub message : String
}

///|
pub fn ParseError::new(kind : ParseErrorKind, message : String) -> ParseError {
  ParseError::{ kind: kind, message: message }
}

///|
pub fn ParseError::to_string(self : ParseError) -> String {
  self.message
}

///|
pub fn ParseError::eq(self : ParseError, other : ParseError) -> Bool {
  self.message == other.message
}

///| An IPv4 address stored as a 32-bit unsigned integer in network byte order.
pub val struct Ipv4Addr {
  pub bits : UInt
}

///|
pub fn Ipv4Addr::new(a : Int, b : Int, c : Int, d : Int) -> Ipv4Addr {
  let bits = (((a & 0xFF).to_uint()) << 24) |
  (((b & 0xFF).to_uint()) << 16) |
  (((c & 0xFF).to_uint()) << 8) |
  ((d & 0xFF).to_uint())
  Ipv4Addr::{ bits: bits }
}

///|
pub fn Ipv4Addr::from_u32(bits : UInt) -> Ipv4Addr {
  Ipv4Addr::{ bits: bits }
}

///|
pub fn Ipv4Addr::to_u32(self : Ipv4Addr) -> UInt {
  self.bits
}

///|
pub fn Ipv4Addr::octets(self : Ipv4Addr) -> (Int, Int, Int, Int) {
  (
    ((self.bits >> 24) & 0xFFU).to_int(),
    ((self.bits >> 16) & 0xFFU).to_int(),
    ((self.bits >> 8) & 0xFFU).to_int(),
    (self.bits & 0xFFU).to_int(),
  )
}

///|
pub fn Ipv4Addr::to_string(self : Ipv4Addr) -> String {
  let (a, b, c, d) = self.octets()
  let sb = StringBuilder::with_capacity(15)
  sb.write_string(a.to_string())
  sb.write_byte((46).to_byte())
  sb.write_string(b.to_string())
  sb.write_byte((46).to_byte())
  sb.write_string(c.to_string())
  sb.write_byte((46).to_byte())
  sb.write_string(d.to_string())
  sb.to_string()
}

///|
pub fn Ipv4Addr::eq(self : Ipv4Addr, other : Ipv4Addr) -> Bool {
  self.bits == other.bits
}

///| An IPv6 address stored as eight 16-bit segments.
pub val struct Ipv6Addr {
  pub s0 : Int
  pub s1 : Int
  pub s2 : Int
  pub s3 : Int
  pub s4 : Int
  pub s5 : Int
  pub s6 : Int
  pub s7 : Int
}

///|
pub fn Ipv6Addr::new(
  s0 : Int,
  s1 : Int,
  s2 : Int,
  s3 : Int,
  s4 : Int,
  s5 : Int,
  s6 : Int,
  s7 : Int,
) -> Ipv6Addr {
  Ipv6Addr::{
    s0: s0 & 0xFFFF,
    s1: s1 & 0xFFFF,
    s2: s2 & 0xFFFF,
    s3: s3 & 0xFFFF,
    s4: s4 & 0xFFFF,
    s5: s5 & 0xFFFF,
    s6: s6 & 0xFFFF,
    s7: s7 & 0xFFFF,
  }
}

///|
pub fn Ipv6Addr::segments(self : Ipv6Addr) -> FixedArray[Int] {
  let arr : FixedArray[Int] = FixedArray::make(8, 0)
  arr[0] = self.s0
  arr[1] = self.s1
  arr[2] = self.s2
  arr[3] = self.s3
  arr[4] = self.s4
  arr[5] = self.s5
  arr[6] = self.s6
  arr[7] = self.s7
  arr
}

///|
pub fn Ipv6Addr::to_string(self : Ipv6Addr) -> String {
  let sb = StringBuilder::with_capacity(39)
  write_ipv6(sb, self)
  sb.to_string()
}

///|
pub fn Ipv6Addr::eq(self : Ipv6Addr, other : Ipv6Addr) -> Bool {
  self.s0 == other.s0 &&
  self.s1 == other.s1 &&
  self.s2 == other.s2 &&
  self.s3 == other.s3 &&
  self.s4 == other.s4 &&
  self.s5 == other.s5 &&
  self.s6 == other.s6 &&
  self.s7 == other.s7
}

///| The host component of a URL.
pub enum Host {
  Domain(String)
  Ipv4(Ipv4Addr)
  Ipv6(Ipv6Addr)
}

///|
pub fn host_to_string(h : Host) -> String {
  match h {
    Host::Domain(d) => d
    Host::Ipv4(ip) => ip.to_string()
    Host::Ipv6(ip) => "[" + ip.to_string() + "]"
  }
}

///|
pub fn host_eq(a : Host, b : Host) -> Bool {
  match (a, b) {
    (Host::Domain(x), Host::Domain(y)) => x == y
    (Host::Ipv4(x), Host::Ipv4(y)) => x.eq(y)
    (Host::Ipv6(x), Host::Ipv6(y)) => x.eq(y)
    _ => false
  }
}

///| The origin of a URL (WHATWG URL Standard §6).
pub enum Origin {
  Opaque
  Tuple(String, Host, Int)
}

///|
pub fn origin_is_tuple(o : Origin) -> Bool {
  match o {
    Origin::Tuple(_, _, _) => true
    Origin::Opaque => false
  }
}

///|
pub fn origin_ascii_serialization(o : Origin) -> String {
  match o {
    Origin::Opaque => "null"
    Origin::Tuple(scheme, host, port) => {
      let sb = StringBuilder::with_capacity(scheme.length() + 32)
      sb.write_string(scheme)
      sb.write_string("://")
      sb.write_string(host_to_string(host))
      if port != default_port_for_scheme(scheme) && port >= 0 {
        sb.write_byte((58).to_byte())
        sb.write_string(port.to_string())
      }
      sb.to_string()
    }
  }
}

///| Percent-encode character sets per WHATWG URL Standard §1.3.
pub enum EncodeSet {
  Controls
  Fragment
  Query
  SpecialQuery
  Path
  Userinfo
  Component
}

///| Internal host discriminant stored on `Url`.
enum HostKind {
  NoHost
  DomainHost
  Ipv4Host
  Ipv6Host
}

///| A parsed WHATWG URL stored as a single canonical serialization plus byte offsets.
pub struct Url {
  mut serialization : String
  mut scheme_end : Int
  mut username_end : Int
  mut host_start : Int
  mut host_end : Int
  mut host_kind : HostKind
  mut ipv4 : Ipv4Addr
  mut ipv6 : Ipv6Addr
  mut port_val : Int
  mut path_start : Int
  mut query_start : Int
  mut fragment_start : Int
  mut opaque_path : Bool
}

///|
pub fn Url::as_str(self : Url) -> String {
  self.serialization
}

///|
pub fn Url::href(self : Url) -> String {
  self.serialization
}

///|
pub fn Url::scheme(self : Url) -> String {
  self.serialization.slice(0, self.scheme_end)
}

///|
pub fn Url::protocol(self : Url) -> String {
  self.serialization.slice(0, self.scheme_end + 1)
}

///|
pub fn Url::username(self : Url) -> String {
  let authority_start = self.scheme_end + 3
  if self.has_host() && self.username_end > authority_start {
    self.serialization.slice(authority_start, self.username_end)
  } else {
    ""
  }
}

///|
pub fn Url::password(self : Url) -> Option[String] {
  if !self.has_host() {
    return None
  }
  // If password exists, `:` is at `username_end` and `@` is at `host_start - 1`.
  if self.host_start > self.username_end + 1 &&
  self.serialization.code_unit_at(self.username_end) == 58 {
    Some(self.serialization.slice(self.username_end + 1, self.host_start - 1))
  } else {
    None
  }
}

///|
pub fn Url::password_str(self : Url) -> String {
  match self.password() {
    Some(p) => p
    None => ""
  }
}

///|
pub fn Url::has_host(self : Url) -> Bool {
  match self.host_kind {
    HostKind::NoHost => false
    _ => true
  }
}

///|
pub fn Url::host(self : Url) -> Option[Host] {
  match self.host_kind {
    HostKind::NoHost => None
    HostKind::DomainHost =>
    Some(Host::Domain(self.serialization.slice(self.host_start, self.host_end)))
    HostKind::Ipv4Host => Some(Host::Ipv4(self.ipv4))
    HostKind::Ipv6Host => Some(Host::Ipv6(self.ipv6))
  }
}

///|
pub fn Url::host_str(self : Url) -> Option[String] {
  if self.has_host() {
    Some(self.serialization.slice(self.host_start, self.host_end))
  } else {
    None
  }
}

///|
pub fn Url::hostname(self : Url) -> String {
  match self.host_str() {
    Some(h) => h
    None => ""
  }
}

///|
pub fn Url::host_and_port(self : Url) -> String {
  if !self.has_host() {
    return ""
  }
  let end = if self.port_val >= 0 {
    self.path_start
  } else {
    self.host_end
  }
  self.serialization.slice(self.host_start, end)
}

///|
pub fn Url::port(self : Url) -> Option[Int] {
  if self.port_val >= 0 {
    Some(self.port_val)
  } else {
    None
  }
}

///|
pub fn Url::port_str(self : Url) -> String {
  if self.port_val >= 0 {
    self.port_val.to_string()
  } else {
    ""
  }
}

///|
pub fn Url::port_or_known_default(self : Url) -> Option[Int] {
  if self.port_val >= 0 {
    return Some(self.port_val)
  }
  let dp = default_port_for_scheme(self.scheme())
  if dp >= 0 {
    Some(dp)
  } else {
    None
  }
}

///|
pub fn Url::path(self : Url) -> String {
  let end = if self.query_start >= 0 {
    self.query_start
  } else if self.fragment_start >= 0 {
    self.fragment_start
  } else {
    self.serialization.length()
  }
  self.serialization.slice(self.path_start, end)
}

///|
pub fn Url::pathname(self : Url) -> String {
  self.path()
}

///|
pub fn Url::query(self : Url) -> Option[String] {
  if self.query_start < 0 {
    return None
  }
  let end = if self.fragment_start >= 0 {
    self.fragment_start
  } else {
    self.serialization.length()
  }
  Some(self.serialization.slice(self.query_start + 1, end))
}

///|
pub fn Url::search(self : Url) -> String {
  if self.query_start < 0 {
    return ""
  }
  let end = if self.fragment_start >= 0 {
    self.fragment_start
  } else {
    self.serialization.length()
  }
  if end - self.query_start <= 1 {
    ""
  } else {
    self.serialization.slice(self.query_start, end)
  }
}

///|
pub fn Url::query_params(self : Url) -> QueryParams {
  match self.query() {
    Some(q) => QueryParams::parse_raw(q)
    None => QueryParams::new()
  }
}

///|
pub fn Url::fragment(self : Url) -> Option[String] {
  if self.fragment_start < 0 {
    return None
  }
  Some(self.serialization.slice(self.fragment_start + 1, self.serialization.length()))
}

///|
pub fn Url::hash(self : Url) -> String {
  if self.fragment_start < 0 {
    return ""
  }
  let len = self.serialization.length()
  if len - self.fragment_start <= 1 {
    ""
  } else {
    self.serialization.slice(self.fragment_start, len)
  }
}

///|
pub fn Url::origin(self : Url) -> Origin {
  let sc = self.scheme()
  if sc == "blob" {
    match Url::parse(self.path()) {
      Ok(inner) => {
        let isc = inner.scheme()
        if isc == "http" || isc == "https" {
          return inner.origin()
        }
        return Origin::Opaque
      }
      Err(_) => return Origin::Opaque
    }
  }
  if sc == "ftp" || sc == "http" || sc == "https" || sc == "ws" || sc == "wss" {
    match self.host() {
      Some(h) => {
        let p = if self.port_val >= 0 {
          self.port_val
        } else {
          default_port_for_scheme(sc)
        }
        Origin::Tuple(sc, h, p)
      }
      None => Origin::Opaque
    }
  } else {
    Origin::Opaque
  }
}

///|
pub fn Url::cannot_be_a_base(self : Url) -> Bool {
  self.opaque_path
}

///| WHATWG `URLSearchParams` (`application/x-www-form-urlencoded` key/value list).
pub struct QueryParams {
  mut keys : Array[String]
  mut vals : Array[String]
}

///|
pub fn QueryParams::new() -> QueryParams {
  QueryParams::{ keys: [], vals: [] }
}

///|
pub fn QueryParams::len(self : QueryParams) -> Int {
  self.keys.length()
}

///|
pub fn QueryParams::is_empty(self : QueryParams) -> Bool {
  self.keys.length() == 0
}
