///| WHATWG `URLSearchParams` (`application/x-www-form-urlencoded` key/value list).
pub struct QueryParams {
  mut keys : Array[String]
  mut vals : Array[String]
}

///|
pub fn QueryParams::new() -> QueryParams {
  QueryParams::{ keys: [], vals: [] }
}

///|
pub fn QueryParams::parse(input : String) -> QueryParams {
  let _ = input
  QueryParams::new()
}

///|
pub fn QueryParams::parse_raw(input : String) -> QueryParams {
  let _ = input
  QueryParams::new()
}

///|
pub fn QueryParams::len(self : QueryParams) -> Int {
  self.keys.length()
}

///|
pub fn QueryParams::is_empty(self : QueryParams) -> Bool {
  self.keys.length() == 0
}

///|
pub fn QueryParams::get(self : QueryParams, name : String) -> Option[String] {
  let _ = self
  let _ = name
  None
}

///|
pub fn QueryParams::get_all(self : QueryParams, name : String) -> Array[String] {
  let _ = self
  let _ = name
  []
}

///|
pub fn QueryParams::has(self : QueryParams, name : String) -> Bool {
  let _ = self
  let _ = name
  false
}

///|
pub fn QueryParams::set(self : QueryParams, name : String, value : String) -> Unit {
  let _ = self
  let _ = name
  let _ = value
}

///|
pub fn QueryParams::append(
  self : QueryParams,
  name : String,
  value : String,
) -> Unit {
  let _ = self
  let _ = name
  let _ = value
}

///|
pub fn QueryParams::delete(self : QueryParams, name : String) -> Unit {
  let _ = self
  let _ = name
}

///|
pub fn QueryParams::sort(self : QueryParams) -> Unit {
  let _ = self
}

///|
pub fn QueryParams::pairs(self : QueryParams) -> Array[(String, String)] {
  let _ = self
  []
}

///|
pub fn QueryParams::to_string(self : QueryParams) -> String {
  let _ = self
  ""
}
