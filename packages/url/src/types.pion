  let _ = self
  let _ = username
  Err(err_unimplemented())
}

///|
pub fn Url::set_password(
  self : Url,
  password : Option[String],
) -> Result[Unit, ParseError] {
  let _ = self
  let _ = password
  Err(err_unimplemented())
}

///|
pub fn Url::set_password_str(
  self : Url,
  password : String,
) -> Result[Unit, ParseError] {
  if password.length() == 0 {
    self.set_password(None)
  } else {
    self.set_password(Some(password))
  }
}

///|
pub fn Url::set_host(
  self : Url,
  host : Option[String],
