///| RFC 2397 / Fetch Standard §6 `data:` URL parser and decoder.

///| Default maximum decoded body size (16 MiB) for `parse_data_url`.
pub let default_data_url_max_bytes : Int = 16777216

///| Errors returned when parsing or decoding a `data:` URL.
pub enum DataUrlError {
  InvalidScheme
  MissingComma
  InvalidBase64
  BodyTooLarge
}

///|
pub fn data_url_error_to_string(err : DataUrlError) -> String {
  match err {
    DataUrlError::InvalidScheme => "invalid data: URL scheme"
    DataUrlError::MissingComma => "missing comma in data: URL"
    DataUrlError::InvalidBase64 => "invalid base64 data in data: URL"
    DataUrlError::BodyTooLarge => "data: URL body exceeds size limit"
  }
}

///|
pub fn data_url_error_eq(a : DataUrlError, b : DataUrlError) -> Bool {
  match (a, b) {
    (DataUrlError::InvalidScheme, DataUrlError::InvalidScheme) => true
    (DataUrlError::MissingComma, DataUrlError::MissingComma) => true
    (DataUrlError::InvalidBase64, DataUrlError::InvalidBase64) => true
    (DataUrlError::BodyTooLarge, DataUrlError::BodyTooLarge) => true
    _ => false
  }
}

///| A parsed RFC 2397 / Fetch Standard `data:` URL.
pub struct DataUrl {
  pub mime_type : String
  pub parameters : Array[(String, String)]
  pub is_base64 : Bool
  pub body : Bytes
}

fn data_ascii_lower_byte(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

fn data_ascii_lower_str(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < n {
    sb.write_byte(data_ascii_lower_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn data_is_ascii_ws(b : Int) -> Bool {
  b == 9 || b == 10 || b == 12 || b == 13 || b == 32
}

fn data_is_http_ws(b : Int) -> Bool {
  b == 9 || b == 10 || b == 13 || b == 32
}

fn data_is_http_token_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) ||
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  b == 33 ||
  b == 35 ||
  b == 36 ||
  b == 37 ||
  b == 38 ||
  b == 39 ||
  b == 42 ||
  b == 43 ||
  b == 45 ||
  b == 46 ||
  b == 94 ||
  b == 95 ||
  b == 96 ||
  b == 124 ||
  b == 126
}

fn data_is_quoted_string_byte(b : Int) -> Bool {
  b == 9 || (b >= 32 && b <= 126) || (b >= 128 && b <= 255)
}

fn data_b64_val(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b - 65
  } else if b >= 97 && b <= 122 {
    b - 97 + 26
  } else if b >= 48 && b <= 57 {
    b - 48 + 52
  } else if b == 43 {
    62
  } else if b == 47 {
    63
  } else {
    -1
  }
}

///| Look up a MIME parameter value by ASCII case-insensitive name.
pub fn DataUrl::get_parameter(self : DataUrl, name : String) -> Option[String] {
  let key = data_ascii_lower_str(name)
  let mut i = 0
  while i < self.parameters.length() {
    if self.parameters[i].0 == key {
      return Some(self.parameters[i].1)
    }
    i = i + 1
  }
  None
}

///| Decode the body bytes as a UTF-8 `String` (replacing invalid sequences with U+FFFD).
pub fn DataUrl::body_string(self : DataUrl) -> String {
  let sb = StringBuilder::with_capacity(self.body.length())
  write_utf8_lossy(sb, self.body)
  sb.to_string()
}

///| Parse MIME type & parameters per WHATWG MIME Sniffing §4.4.
///| Returns `None` if `type/subtype` is malformed.
fn parse_mime_type(raw : String) -> Option[(String, Array[(String, String)])] {
  let n = raw.length()
  let mut i = 0
  while i < n && data_is_http_ws(raw.code_unit_at(i)) {
    i = i + 1
  }
  let type_start = i
  while i < n && raw.code_unit_at(i) != 47 {
    if !data_is_http_token_byte(raw.code_unit_at(i)) {
      return None
    }
    i = i + 1
  }
  if i == type_start || i >= n {
    return None
  }
  let mime_type_part = data_ascii_lower_str(raw.slice(type_start, i))
  i = i + 1 // skip '/'
  let sub_start = i
  while i < n && raw.code_unit_at(i) != 59 {
    i = i + 1
  }
  let mut sub_end = i
  while sub_end > sub_start && data_is_http_ws(raw.code_unit_at(sub_end - 1)) {
    sub_end = sub_end - 1
  }
  if sub_end == sub_start {
    return None
  }
  let mut k = sub_start
  while k < sub_end {
    if !data_is_http_token_byte(raw.code_unit_at(k)) {
      return None
    }
    k = k + 1
  }
  let subtype_part = data_ascii_lower_str(raw.slice(sub_start, sub_end))
  let essence = mime_type_part + "/" + subtype_part
  let params : Array[(String, String)] = []

  while i < n {
    i = i + 1 // skip ';'
    while i < n && data_is_http_ws(raw.code_unit_at(i)) {
      i = i + 1
    }
    let name_start = i
    while i < n && raw.code_unit_at(i) != 59 && raw.code_unit_at(i) != 61 {
      i = i + 1
    }
    let name_end = i
    if i >= n {
      break
    }
    if raw.code_unit_at(i) == 59 {
      continue
    }
    i = i + 1 // skip '='
    let mut name_valid = name_end > name_start
    if name_valid {
      let mut ni = name_start
      while ni < name_end {
        if !data_is_http_token_byte(raw.code_unit_at(ni)) {
          name_valid = false
          break
        }
        ni = ni + 1
      }
    }
    let mut pval = ""
    let mut val_valid = true
    if i < n && raw.code_unit_at(i) == 34 {
      // HTTP quoted-string
      i = i + 1
      let sb = StringBuilder::with_capacity(16)
      while i < n {
        let c = raw.code_unit_at(i)
        if c == 34 {
          i = i + 1
          break
        } else if c == 92 {
          i = i + 1
          if i < n {
            let esc = raw.code_unit_at(i)
            if !data_is_quoted_string_byte(esc) {
              val_valid = false
            }
            sb.write_byte(esc.to_byte())
            i = i + 1
          } else {
            sb.write_byte((92).to_byte())
          }
        } else {
          if !data_is_quoted_string_byte(c) {
            val_valid = false
          }
          sb.write_byte(c.to_byte())
          i = i + 1
        }
      }
      pval = sb.to_string()
      while i < n && raw.code_unit_at(i) != 59 {
        i = i + 1
      }
    } else {
      let val_start = i
      while i < n && raw.code_unit_at(i) != 59 {
        i = i + 1
      }
      let mut val_end = i
      while val_end > val_start && data_is_http_ws(raw.code_unit_at(val_end - 1)) {
        val_end = val_end - 1
      }
      if val_end == val_start {
        val_valid = false
      } else {
        let mut vi = val_start
        while vi < val_end {
          if !data_is_quoted_string_byte(raw.code_unit_at(vi)) {
            val_valid = false
            break
          }
          vi = vi + 1
        }
        if val_valid {
          pval = raw.slice(val_start, val_end)
        }
      }
    }
    if name_valid && val_valid {
      let pname = data_ascii_lower_str(raw.slice(name_start, name_end))
      let mut exists = false
      let mut pi = 0
      while pi < params.length() {
        if params[pi].0 == pname {
          exists = true
          break
        }
        pi = pi + 1
      }
      if !exists {
        params.push((pname, pval))
      }
    }
  }
  Some((essence, params))
}

///| Strip trailing `;[ws*]base64` (case-insensitive) from `header`.
///| Returns `(remaining_header, is_base64)`.
fn strip_trailing_base64(header : String) -> (String, Bool) {
  let mut end = header.length()
  while end > 0 && data_is_ascii_ws(header.code_unit_at(end - 1)) {
    end = end - 1
  }
  if end < 7 {
    return (header.slice(0, end), false)
  }
  let b0 = data_ascii_lower_byte(header.code_unit_at(end - 6))
  let b1 = data_ascii_lower_byte(header.code_unit_at(end - 5))
  let b2 = data_ascii_lower_byte(header.code_unit_at(end - 4))
  let b3 = data_ascii_lower_byte(header.code_unit_at(end - 3))
  let b4 = data_ascii_lower_byte(header.code_unit_at(end - 2))
  let b5 = data_ascii_lower_byte(header.code_unit_at(end - 1))
  if b0 == 98 && b1 == 97 && b2 == 115 && b3 == 101 && b4 == 54 && b5 == 52 {
    let mut p = end - 6
    while p > 0 && data_is_ascii_ws(header.code_unit_at(p - 1)) {
      p = p - 1
    }
    if p > 0 && header.code_unit_at(p - 1) == 59 {
      return (header.slice(0, p - 1), true)
    }
  }
  (header.slice(0, end), false)
}

///| Decode a percent-encoded slice `s[start..end]` with an upper bound `max_bytes`.
fn percent_decode_slice_limited(
  s : String,
  start : Int,
  end : Int,
  max_bytes : Int,
) -> Result[Bytes, DataUrlError] {
  let mut out_len = 0
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        out_len = out_len + 1
        if out_len > max_bytes {
          return Err(DataUrlError::BodyTooLarge)
        }
        i = i + 3
        continue
      }
    }
    out_len = out_len + 1
    if out_len > max_bytes {
      return Err(DataUrlError::BodyTooLarge)
    }
    i = i + 1
  }
  let mut buf = Bytes::new(out_len)
  let mut o = 0
  i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        buf[o] = ((hi << 4) | lo).to_byte()
        o = o + 1
        i = i + 3
        continue
      }
    }
    buf[o] = b.to_byte()
    o = o + 1
    i = i + 1
  }
  Ok(buf)
}

///| Percent-decode + WHATWG Infra §4.5 forgiving-base64 decode `s[start..end]` with `max_bytes` limit.
fn decode_base64_slice_limited(
  s : String,
  start : Int,
  end : Int,
  max_bytes : Int,
) -> Result[Bytes, DataUrlError] {
  // Pass 1: count non-ASCII-whitespace bytes after percent-decoding and record last two bytes.
  let mut non_ws = 0
  let mut prev2 = -1
  let mut prev1 = -1
  let mut i = start
  while i < end {
    let mut b = s.code_unit_at(i)
    if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        b = (hi << 4) | lo
        i = i + 3
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
    if !data_is_ascii_ws(b) {
      prev2 = prev1
      prev1 = b
      non_ws = non_ws + 1
    }
  }
  if non_ws == 0 {
    return Ok(Bytes::new(0))
  }
  let effective_len = if non_ws % 4 == 0 {
    if non_ws >= 2 && prev2 == 61 && prev1 == 61 {
      non_ws - 2
    } else if prev1 == 61 {
      non_ws - 1
    } else {
      non_ws
    }
  } else {
    non_ws
  }
  let rem = effective_len % 4
  if rem == 1 {
    return Err(DataUrlError::InvalidBase64)
  }
  let extra = if rem == 2 {
    1
  } else if rem == 3 {
    2
  } else {
    0
  }
  let out_len = (effective_len / 4) * 3 + extra
  if out_len > max_bytes {
    return Err(DataUrlError::BodyTooLarge)
  }
  // Pass 2: validate and decode exact `effective_len` base64 symbols.
  let mut buf = Bytes::new(out_len)
  let mut o = 0
  let mut seen = 0
  let mut acc = 0
  let mut bits = 0
  i = start
  while i < end && seen < effective_len {
    let mut b = s.code_unit_at(i)
    if b == 37 && i + 2 < end {
      let hi = hex_val(s.code_unit_at(i + 1))
      let lo = hex_val(s.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        b = (hi << 4) | lo
        i = i + 3
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
    if data_is_ascii_ws(b) {
      continue
    }
    let v = data_b64_val(b)
    if v < 0 {
      return Err(DataUrlError::InvalidBase64)
    }
    acc = ((acc << 6) | v) & 0xFFFFFF
    bits = bits + 6
    if bits >= 8 {
      bits = bits - 8
      buf[o] = ((acc >> bits) & 0xFF).to_byte()
      o = o + 1
    }
    seen = seen + 1
  }
  Ok(buf)
}

///| Parse and decode a `data:` URL with the default size limit (`default_data_url_max_bytes`).
pub fn parse_data_url(input : String) -> Result[DataUrl, DataUrlError] {
  parse_data_url_with_limit(input, default_data_url_max_bytes)
}

///| Parse and decode a `data:` URL, rejecting decoded payloads larger than `max_bytes`.
pub fn parse_data_url_with_limit(
  input : String,
  max_bytes : Int,
) -> Result[DataUrl, DataUrlError] {
  let raw_len = input.length()
  let mut start = 0
  while start < raw_len && input.code_unit_at(start) <= 32 {
    start = start + 1
  }
  let mut end = raw_len
  while end > start && input.code_unit_at(end - 1) <= 32 {
    end = end - 1
  }
  if end - start < 5 {
    return Err(DataUrlError::InvalidScheme)
  }
  if data_ascii_lower_byte(input.code_unit_at(start)) != 100 ||
  data_ascii_lower_byte(input.code_unit_at(start + 1)) != 97 ||
  data_ascii_lower_byte(input.code_unit_at(start + 2)) != 116 ||
  data_ascii_lower_byte(input.code_unit_at(start + 3)) != 97 ||
  input.code_unit_at(start + 4) != 58 {
    return Err(DataUrlError::InvalidScheme)
  }
  // Strip `#fragment` per Fetch Standard §6.
  let mut effective_end = start + 5
  while effective_end < end && input.code_unit_at(effective_end) != 35 {
    effective_end = effective_end + 1
  }
  // Find first `,` before `#`.
  let mut comma = start + 5
  while comma < effective_end && input.code_unit_at(comma) != 44 {
    comma = comma + 1
  }
  if comma >= effective_end {
    return Err(DataUrlError::MissingComma)
  }
  if max_bytes < 0 {
    return Err(DataUrlError::BodyTooLarge)
  }

  let mut hstart = start + 5
  while hstart < comma && data_is_ascii_ws(input.code_unit_at(hstart)) {
    hstart = hstart + 1
  }
  let raw_header = input.slice(hstart, comma)
  let (mime_raw, is_base64) = strip_trailing_base64(raw_header)
  let mut mstart = 0
  while mstart < mime_raw.length() && data_is_ascii_ws(mime_raw.code_unit_at(mstart)) {
    mstart = mstart + 1
  }
  let mut mend = mime_raw.length()
  while mend > mstart && data_is_ascii_ws(mime_raw.code_unit_at(mend - 1)) {
    mend = mend - 1
  }
  let mime_trimmed = mime_raw.slice(mstart, mend)

  let (mime_type, parameters) = if mime_trimmed.length() == 0 {
    ("text/plain", [("charset", "US-ASCII")])
  } else {
    let candidate = if mime_trimmed.code_unit_at(0) == 59 {
      "text/plain" + mime_trimmed
    } else {
      mime_trimmed
    }
    match parse_mime_type(candidate) {
      Some(pair) => pair
      None => ("text/plain", [("charset", "US-ASCII")])
    }
  }

  let body_res = if is_base64 {
    decode_base64_slice_limited(input, comma + 1, effective_end, max_bytes)
  } else {
    percent_decode_slice_limited(input, comma + 1, effective_end, max_bytes)
  }
  match body_res {
    Ok(body) => Ok(DataUrl::{
      mime_type: mime_type,
      parameters: parameters,
      is_base64: is_base64,
      body: body,
    })
    Err(e) => Err(e)
  }
}
