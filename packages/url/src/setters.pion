///| WHATWG URL Standard setters (both clean `Url` mutators and DOM/quirks setters).

fn Url::apply_record(self : Url, rec : UrlRecord) -> Unit {
  let u = rec.to_url()
  self.serialization = u.serialization
  self.scheme_end = u.scheme_end
  self.username_end = u.username_end
  self.host_start = u.host_start
  self.host_end = u.host_end
  self.host_kind = u.host_kind
  self.ipv4 = u.ipv4
  self.ipv6 = u.ipv6
  self.port_val = u.port_val
  self.path_start = u.path_start
  self.query_start = u.query_start
  self.fragment_start = u.fragment_start
  self.opaque_path = u.opaque_path
}

fn Url::is_special_fast(self : Url) -> Bool {
  let n = self.scheme_end
  let s = self.serialization
  let b0 = s.code_unit_at(0)
  if b0 == 104 {
    if n == 4 {
      s.code_unit_at(1) == 116 && s.code_unit_at(2) == 116 && s.code_unit_at(3) == 112
    } else if n == 5 {
      s.code_unit_at(1) == 116 &&
      s.code_unit_at(2) == 116 &&
      s.code_unit_at(3) == 112 &&
      s.code_unit_at(4) == 115
    } else {
      false
    }
  } else if b0 == 119 {
    if n == 2 {
      s.code_unit_at(1) == 115
    } else if n == 3 {
      s.code_unit_at(1) == 115 && s.code_unit_at(2) == 115
    } else {
      false
    }
  } else if b0 == 102 {
    if n == 3 {
      s.code_unit_at(1) == 116 && s.code_unit_at(2) == 112
    } else if n == 4 {
      s.code_unit_at(1) == 105 && s.code_unit_at(2) == 108 && s.code_unit_at(3) == 101
    } else {
      false
    }
  } else {
    false
  }
}

fn Url::is_file_scheme_fast(self : Url) -> Bool {
  self.scheme_end == 4 &&
  self.serialization.code_unit_at(0) == 102 &&
  self.serialization.code_unit_at(1) == 105 &&
  self.serialization.code_unit_at(2) == 108 &&
  self.serialization.code_unit_at(3) == 101
}

fn Url::has_empty_domain_host(self : Url) -> Bool {
  match self.host_kind {
    HostKind::DomainHost => self.host_end == self.host_start
    _ => false
  }
}

fn Url::has_credentials_fast(self : Url) -> Bool {
  self.has_host() && self.host_start > self.scheme_end + 3
}

///| Set the URL scheme (without trailing `:`), matching `rust-url` strict validation and refusal reporting.
pub fn Url::set_scheme(self : Url, scheme : String) -> Result[Unit, ParseError] {
  let n = scheme.length()
  if n == 0 || !is_ascii_alpha(scheme.code_unit_at(0)) {
    return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme"))
  }
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let c = scheme.code_unit_at(i)
    if !(is_ascii_alnum(c) || c == 43 || c == 45 || c == 46) {
      return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme character"))
    }
    sb.write_byte(to_ascii_lower(c).to_byte())
    i = i + 1
  }
  let new_scheme = sb.to_string()
  let old_special = self.is_special_fast()
  let new_special = is_special_scheme(new_scheme)
  if old_special != new_special {
    return Err(ParseError::new(ParseErrorKind::InvalidScheme, "cannot change between special and non-special scheme"))
  }
  if (self.has_credentials_fast() || self.port_val >= 0) && new_scheme == "file" {
    return Err(ParseError::new(ParseErrorKind::InvalidScheme, "cannot change scheme to file with credentials or port"))
  }
  if self.is_file_scheme_fast() && (!self.has_host() || self.has_empty_domain_host()) {
    return Err(ParseError::new(ParseErrorKind::InvalidScheme, "cannot change file scheme with empty host"))
  }
  let rec = UrlRecord::from_url(self)
  rec.scheme = new_scheme
  if rec.port_val >= 0 && rec.port_val == default_port_for_scheme(rec.scheme) {
    rec.port_val = -1
  }
  self.apply_record(rec)
  Ok(())
}

///| WHATWG `url.protocol = value` setter (ignores everything after first `:`).
pub fn Url::set_protocol(
  self : Url,
  protocol : String,
) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(protocol + ":", None, Some(rec), Some(ParseState::SchemeStart)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| WHATWG `url.username = value` setter (O(N) slice splice, no full re-parse).
pub fn Url::set_username(
  self : Url,
  username : String,
) -> Result[Unit, ParseError] {
  if !self.has_host() || self.is_file_scheme_fast() || self.has_empty_domain_host() {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set username on URL without host or file URL",
      ),
    )
  }
  let s = self.serialization
  let slen = s.length()
  let auth_start = self.scheme_end + 3
  let has_pw = self.host_start > self.username_end + 1 &&
  s.code_unit_at(self.username_end) == 58
  let pw_start = if has_pw { self.username_end + 1 } else { 0 }
  let pw_end = if has_pw { self.host_start - 1 } else { 0 }
  let old_host_start = self.host_start
  let enc_u = percent_encode(username, EncodeSet::Userinfo)
  let sb = StringBuilder::with_capacity(slen + enc_u.length() + 4)
  sb.write_substring(s, 0, auth_start)
  let new_u_end : Int = if enc_u.length() > 0 || has_pw {
    sb.write_string(enc_u)
    let ue = sb.length()
    if has_pw {
      sb.write_byte((58).to_byte())
      sb.write_substring(s, pw_start, pw_end)
    }
    sb.write_byte((64).to_byte())
    ue
  } else {
    auth_start
  }
  let new_host_start = sb.length()
  sb.write_substring(s, old_host_start, slen)
  let delta = new_host_start - old_host_start
  self.serialization = sb.to_string()
  self.username_end = new_u_end
  self.host_start = new_host_start
  self.host_end = self.host_end + delta
  self.path_start = self.path_start + delta
  if self.query_start >= 0 {
    self.query_start = self.query_start + delta
  }
  if self.fragment_start >= 0 {
    self.fragment_start = self.fragment_start + delta
  }
  Ok(())
}

///| Set the URL password (`None` clears password, O(N) slice splice).
pub fn Url::set_password(
  self : Url,
  password : Option[String],
) -> Result[Unit, ParseError] {
  if !self.has_host() || self.is_file_scheme_fast() || self.has_empty_domain_host() {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set password on URL without host or file URL",
      ),
    )
  }
  let s = self.serialization
  let slen = s.length()
  let auth_start = self.scheme_end + 3
  let has_u = self.username_end > auth_start
  let enc_p = match password {
    Some(p) => percent_encode(p, EncodeSet::Userinfo)
    None => ""
  }
  let old_host_start = self.host_start
  let sb = StringBuilder::with_capacity(slen + enc_p.length() + 4)
  sb.write_substring(s, 0, auth_start)
  let new_u_end : Int = if has_u || enc_p.length() > 0 {
    if has_u {
      sb.write_substring(s, auth_start, self.username_end)
    }
    let ue = sb.length()
    if enc_p.length() > 0 {
      sb.write_byte((58).to_byte())
      sb.write_string(enc_p)
    }
    sb.write_byte((64).to_byte())
    ue
  } else {
    auth_start
  }
  let new_host_start = sb.length()
  sb.write_substring(s, old_host_start, slen)
  let delta = new_host_start - old_host_start
  self.serialization = sb.to_string()
  self.username_end = new_u_end
  self.host_start = new_host_start
  self.host_end = self.host_end + delta
  self.path_start = self.path_start + delta
  if self.query_start >= 0 {
    self.query_start = self.query_start + delta
  }
  if self.fragment_start >= 0 {
    self.fragment_start = self.fragment_start + delta
  }
  Ok(())
}

///| WHATWG `url.password = value` setter.
pub fn Url::set_password_str(
  self : Url,
  password : String,
) -> Result[Unit, ParseError] {
  if password.length() == 0 {
    self.set_password(None)
  } else {
    self.set_password(Some(password))
  }
}

///| Set the URL host (`None` removes host on non-special URLs, keeping hierarchical path `/`).
pub fn Url::set_host(
  self : Url,
  host : Option[String],
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set host on opaque-path URL",
      ),
    )
  }
  match host {
    Some(h) => self.set_hostname(h)
    None => {
      let rec = UrlRecord::from_url(self)
      if is_special_scheme(rec.scheme) ||
      rec.includes_credentials() ||
      rec.port_val >= 0 {
        return Err(
          ParseError::new(
            ParseErrorKind::EmptyHost,
            "cannot remove host on special URL or URL with credentials/port",
          ),
        )
      }
      rec.clear_host()
      // Keep non-special URL hierarchical (`foo://h` -> `foo:/`) so re-parsing stays hierarchical.
      if rec.path_segs.length() == 0 {
        rec.path_segs.push("")
      }
      self.apply_record(rec)
      Ok(())
    }
  }
}

///| WHATWG `url.host = value` setter (may include `:port`).
pub fn Url::set_host_and_port(
  self : Url,
  host_port : String,
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set host on opaque-path URL",
      ),
    )
  }
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(host_port, None, Some(rec), Some(ParseState::Host)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => {
      // Per WHATWG URL Standard, if Host state succeeded before Port state failed,
      // the updated host remains applied on the URL.
      match e.kind {
        ParseErrorKind::InvalidPort => {
          self.apply_record(rec)
          Err(e)
        }
        _ => Err(e)
      }
    }
  }
}

///| WHATWG `url.hostname = value` setter (rejects `:port`).
pub fn Url::set_hostname(
  self : Url,
  hostname : String,
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set hostname on opaque-path URL",
      ),
    )
  }
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(hostname, None, Some(rec), Some(ParseState::Hostname)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| Set the URL port (`None` clears port, O(N) slice splice).
pub fn Url::set_port(
  self : Url,
  port : Option[Int],
) -> Result[Unit, ParseError] {
  if !self.has_host() || self.is_file_scheme_fast() || self.has_empty_domain_host() {
    return Err(
      ParseError::new(
        ParseErrorKind::InvalidPort,
        "cannot set port on URL without host or file URL",
      ),
    )
  }
  let new_port = match port {
    None => -1
    Some(p) => {
      if p < 0 || p > 65535 {
        return Err(ParseError::new(ParseErrorKind::InvalidPort, "port out of range"))
      }
      if p == default_port_for_scheme(self.scheme()) {
        -1
      } else {
        p
      }
    }
  }
  if new_port == self.port_val {
    return Ok(())
  }
  let s = self.serialization
  let slen = s.length()
  let old_path_start = self.path_start
  let sb = StringBuilder::with_capacity(slen + 8)
  sb.write_substring(s, 0, self.host_end)
  if new_port >= 0 {
    sb.write_byte((58).to_byte())
    write_uint_dec(sb, new_port)
  }
  let new_path_start = sb.length()
  sb.write_substring(s, old_path_start, slen)
  let delta = new_path_start - old_path_start
  self.serialization = sb.to_string()
  self.port_val = new_port
  self.path_start = new_path_start
  if self.query_start >= 0 {
    self.query_start = self.query_start + delta
  }
  if self.fragment_start >= 0 {
    self.fragment_start = self.fragment_start + delta
  }
  Ok(())
}

///| WHATWG `url.port = value` setter.
pub fn Url::set_port_str(self : Url, port : String) -> Result[Unit, ParseError] {
  if !self.has_host() || self.is_file_scheme_fast() || self.has_empty_domain_host() {
    return Err(
      ParseError::new(
        ParseErrorKind::InvalidPort,
        "cannot set port on URL without host or file URL",
      ),
    )
  }
  if port.length() == 0 {
    return self.set_port(None)
  }
  // Fast path: pure ASCII digits with no tabs/newlines
  let pn = port.length()
  let mut pnum = 0
  let mut pi = 0
  let mut pure_digits = true
  while pi < pn {
    let ch = port.code_unit_at(pi)
    if ch < 48 || ch > 57 {
      pure_digits = false
      break
    }
    pnum = pnum * 10 + (ch - 48)
    if pnum > 65535 {
      return Err(ParseError::new(ParseErrorKind::InvalidPort, "port > 65535"))
    }
    pi = pi + 1
  }
  if pure_digits {
    return self.set_port(Some(pnum))
  }
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(port, None, Some(rec), Some(ParseState::Port)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| Set the URL path (parses in `PathStart` state override).
pub fn Url::set_path(self : Url, path : String) -> Unit {
  if self.opaque_path {
    return ()
  }
  let rec = UrlRecord::from_url(self)
  rec.path_segs = []
  match basic_url_parse(path, None, Some(rec), Some(ParseState::PathStart)) {
    Ok(updated) => self.apply_record(updated)
    Err(_) => ()
  }
}

///| WHATWG `url.pathname = value` setter.
pub fn Url::set_pathname(self : Url, pathname : String) -> Unit {
  self.set_path(pathname)
}

///| Set the URL query (`None` removes query; `Some("")` sets empty `?` query).
///| Uses direct byte-offset slicing without re-parsing or splitting the URL path.
pub fn Url::set_query(self : Url, query : Option[String]) -> Unit {
  let s = self.serialization
  let slen = s.length()
  match query {
    None => {
      if self.query_start < 0 {
        return ()
      }
      if self.fragment_start < 0 {
        self.serialization = s.slice(0, self.query_start)
        self.query_start = -1
      } else {
        let frag_len = slen - self.fragment_start
        let sb = StringBuilder::with_capacity(self.query_start + frag_len)
        sb.write_substring(s, 0, self.query_start)
        sb.write_substring(s, self.fragment_start, slen)
        self.fragment_start = self.query_start
        self.query_start = -1
        self.serialization = sb.to_string()
      }
    }
    Some(q) => {
      let prefix_end = if self.query_start >= 0 {
        self.query_start
      } else if self.fragment_start >= 0 {
        self.fragment_start
      } else {
        slen
      }
      let frag_len = if self.fragment_start >= 0 {
        slen - self.fragment_start
      } else {
        0
      }
      let qmask = if self.is_special_fast() {
        mask_special_query
      } else {
        mask_query
      }
      let sb = StringBuilder::with_capacity(prefix_end + 1 + q.length() + frag_len + 8)
      sb.write_substring(s, 0, prefix_end)
      sb.write_byte((63).to_byte())
      write_percent_encoded_strip_tab_nl(sb, q, 0, q.length(), qmask)
      let new_frag_start = if self.fragment_start >= 0 {
        let fs = sb.length()
        sb.write_substring(s, self.fragment_start, slen)
        fs
      } else {
        -1
      }
      self.query_start = prefix_end
      self.fragment_start = new_frag_start
      self.serialization = sb.to_string()
    }
  }
}

///| WHATWG `url.search = value` setter (strips one leading `?` if present; `""` clears).
pub fn Url::set_search(self : Url, search : String) -> Unit {
  let n = search.length()
  if n == 0 {
    self.set_query(None)
  } else if search.code_unit_at(0) == 63 {
    self.set_query(Some(search.slice(1, n)))
  } else {
    self.set_query(Some(search))
  }
}

///| Set the URL fragment (`None` removes fragment; `Some("")` sets empty `#` fragment).
///| Uses direct byte-offset slicing without re-parsing or splitting the URL path.
pub fn Url::set_fragment(self : Url, fragment : Option[String]) -> Unit {
  let s = self.serialization
  let slen = s.length()
  match fragment {
    None => {
      if self.fragment_start < 0 {
        return ()
      }
      self.serialization = s.slice(0, self.fragment_start)
      self.fragment_start = -1
    }
    Some(f) => {
      let prefix_end = if self.fragment_start >= 0 {
        self.fragment_start
      } else {
        slen
      }
      let sb = StringBuilder::with_capacity(prefix_end + 1 + f.length() + 8)
      sb.write_substring(s, 0, prefix_end)
      sb.write_byte((35).to_byte())
      write_percent_encoded_strip_tab_nl(sb, f, 0, f.length(), mask_fragment)
      self.fragment_start = prefix_end
      self.serialization = sb.to_string()
    }
  }
}

///| WHATWG `url.hash = value` setter (strips one leading `#` if present; `""` clears).
pub fn Url::set_hash(self : Url, hash : String) -> Unit {
  let n = hash.length()
  if n == 0 {
    self.set_fragment(None)
  } else if hash.code_unit_at(0) == 35 {
    self.set_fragment(Some(hash.slice(1, n)))
  } else {
    self.set_fragment(Some(hash))
  }
}

///| WHATWG `url.href = value` setter.
pub fn Url::set_href(self : Url, href : String) -> Result[Unit, ParseError] {
  match basic_url_parse(href, None, None, None) {
    Ok(rec) => {
      self.apply_record(rec)
      Ok(())
    }
    Err(e) => Err(e)
  }
}
