///| WHATWG URL Standard setters (both clean `Url` mutators and DOM/quirks setters).

fn Url::apply_record(self : Url, rec : UrlRecord) -> Unit {
  let u = rec.to_url()
  self.serialization = u.serialization
  self.scheme_end = u.scheme_end
  self.username_end = u.username_end
  self.host_start = u.host_start
  self.host_end = u.host_end
  self.host_kind = u.host_kind
  self.ipv4 = u.ipv4
  self.ipv6 = u.ipv6
  self.port_val = u.port_val
  self.path_start = u.path_start
  self.query_start = u.query_start
  self.fragment_start = u.fragment_start
  self.opaque_path = u.opaque_path
}

///| Set the URL scheme (without trailing `:`).
pub fn Url::set_scheme(self : Url, scheme : String) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(scheme + ":", None, Some(rec), Some(ParseState::SchemeStart)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| WHATWG `url.protocol = value` setter (ignores everything after first `:`).
pub fn Url::set_protocol(
  self : Url,
  protocol : String,
) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(protocol + ":", None, Some(rec), Some(ParseState::SchemeStart)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| WHATWG `url.username = value` setter.
pub fn Url::set_username(
  self : Url,
  username : String,
) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  if !rec.has_host ||
  rec.scheme == "file" ||
  (match rec.host_kind {
    HostKind::DomainHost => rec.host_domain.length() == 0
    _ => false
  }) {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set username on URL without host or file URL",
      ),
    )
  }
  rec.username = percent_encode(username, EncodeSet::Userinfo)
  self.apply_record(rec)
  Ok(())
}

///| Set the URL password (`None` clears password).
pub fn Url::set_password(
  self : Url,
  password : Option[String],
) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  if !rec.has_host ||
  rec.scheme == "file" ||
  (match rec.host_kind {
    HostKind::DomainHost => rec.host_domain.length() == 0
    _ => false
  }) {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set password on URL without host or file URL",
      ),
    )
  }
  rec.password = match password {
    Some(p) => percent_encode(p, EncodeSet::Userinfo)
    None => ""
  }
  self.apply_record(rec)
  Ok(())
}

///| WHATWG `url.password = value` setter.
pub fn Url::set_password_str(
  self : Url,
  password : String,
) -> Result[Unit, ParseError] {
  if password.length() == 0 {
    self.set_password(None)
  } else {
    self.set_password(Some(password))
  }
}

///| Set the URL host (`None` removes host on non-special URLs).
pub fn Url::set_host(
  self : Url,
  host : Option[String],
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set host on opaque-path URL",
      ),
    )
  }
  match host {
    Some(h) => self.set_hostname(h)
    None => {
      let rec = UrlRecord::from_url(self)
      if is_special_scheme(rec.scheme) ||
      rec.includes_credentials() ||
      rec.port_val >= 0 {
        return Err(
          ParseError::new(
            ParseErrorKind::EmptyHost,
            "cannot remove host on special URL or URL with credentials/port",
          ),
        )
      }
      rec.clear_host()
      self.apply_record(rec)
      Ok(())
    }
  }
}

///| WHATWG `url.host = value` setter (may include `:port`).
pub fn Url::set_host_and_port(
  self : Url,
  host_port : String,
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set host on opaque-path URL",
      ),
    )
  }
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(host_port, None, Some(rec), Some(ParseState::Host)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => {
      // Per WHATWG URL Standard, if Host state succeeded before Port state failed,
      // the updated host remains applied on the URL.
      match e.kind {
        ParseErrorKind::InvalidPort => {
          self.apply_record(rec)
          Err(e)
        }
        _ => Err(e)
      }
    }
  }
}

///| WHATWG `url.hostname = value` setter (rejects `:port`).
pub fn Url::set_hostname(
  self : Url,
  hostname : String,
) -> Result[Unit, ParseError] {
  if self.opaque_path {
    return Err(
      ParseError::new(
        ParseErrorKind::SetHostOnCannotBeABaseUrl,
        "cannot set hostname on opaque-path URL",
      ),
    )
  }
  let rec = UrlRecord::from_url(self)
  match basic_url_parse(hostname, None, Some(rec), Some(ParseState::Hostname)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| Set the URL port (`None` clears port).
pub fn Url::set_port(
  self : Url,
  port : Option[Int],
) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  if !rec.has_host ||
  rec.scheme == "file" ||
  (match rec.host_kind {
    HostKind::DomainHost => rec.host_domain.length() == 0
    _ => false
  }) {
    return Err(
      ParseError::new(
        ParseErrorKind::InvalidPort,
        "cannot set port on URL without host or file URL",
      ),
    )
  }
  match port {
    None => rec.port_val = -1
    Some(p) => {
      if p < 0 || p > 65535 {
        return Err(ParseError::new(ParseErrorKind::InvalidPort, "port out of range"))
      }
      if p == default_port_for_scheme(rec.scheme) {
        rec.port_val = -1
      } else {
        rec.port_val = p
      }
    }
  }
  self.apply_record(rec)
  Ok(())
}

///| WHATWG `url.port = value` setter.
pub fn Url::set_port_str(self : Url, port : String) -> Result[Unit, ParseError] {
  let rec = UrlRecord::from_url(self)
  if !rec.has_host ||
  rec.scheme == "file" ||
  (match rec.host_kind {
    HostKind::DomainHost => rec.host_domain.length() == 0
    _ => false
  }) {
    return Err(
      ParseError::new(
        ParseErrorKind::InvalidPort,
        "cannot set port on URL without host or file URL",
      ),
    )
  }
  if port.length() == 0 {
    rec.port_val = -1
    self.apply_record(rec)
    return Ok(())
  }
  match basic_url_parse(port, None, Some(rec), Some(ParseState::Port)) {
    Ok(updated) => {
      self.apply_record(updated)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| Set the URL path (parses in `PathStart` state override).
pub fn Url::set_path(self : Url, path : String) -> Unit {
  if self.opaque_path {
    return ()
  }
  let rec = UrlRecord::from_url(self)
  rec.path_segs = []
  match basic_url_parse(path, None, Some(rec), Some(ParseState::PathStart)) {
    Ok(updated) => self.apply_record(updated)
    Err(_) => ()
  }
}

///| WHATWG `url.pathname = value` setter.
pub fn Url::set_pathname(self : Url, pathname : String) -> Unit {
  self.set_path(pathname)
}

///| Set the URL query (`None` removes query; `Some("")` sets empty `?` query).
pub fn Url::set_query(self : Url, query : Option[String]) -> Unit {
  let rec = UrlRecord::from_url(self)
  match query {
    None => {
      rec.has_query = false
      rec.query_str = ""
      self.apply_record(rec)
    }
    Some(q) => {
      rec.has_query = true
      rec.query_str = ""
      match basic_url_parse(q, None, Some(rec), Some(ParseState::Query)) {
        Ok(updated) => self.apply_record(updated)
        Err(_) => ()
      }
    }
  }
}

///| WHATWG `url.search = value` setter (strips one leading `?` if present; `""` clears).
pub fn Url::set_search(self : Url, search : String) -> Unit {
  let n = search.length()
  if n == 0 {
    self.set_query(None)
  } else if search.code_unit_at(0) == 63 {
    self.set_query(Some(search.slice(1, n)))
  } else {
    self.set_query(Some(search))
  }
}

///| Set the URL fragment (`None` removes fragment; `Some("")` sets empty `#` fragment).
pub fn Url::set_fragment(self : Url, fragment : Option[String]) -> Unit {
  let rec = UrlRecord::from_url(self)
  match fragment {
    None => {
      rec.has_fragment = false
      rec.fragment_str = ""
      self.apply_record(rec)
    }
    Some(f) => {
      rec.has_fragment = true
      rec.fragment_str = ""
      match basic_url_parse(f, None, Some(rec), Some(ParseState::Fragment)) {
        Ok(updated) => self.apply_record(updated)
        Err(_) => ()
      }
    }
  }
}

///| WHATWG `url.hash = value` setter (strips one leading `#` if present; `""` clears).
pub fn Url::set_hash(self : Url, hash : String) -> Unit {
  let n = hash.length()
  if n == 0 {
    self.set_fragment(None)
  } else if hash.code_unit_at(0) == 35 {
    self.set_fragment(Some(hash.slice(1, n)))
  } else {
    self.set_fragment(Some(hash))
  }
}

///| WHATWG `url.href = value` setter.
pub fn Url::set_href(self : Url, href : String) -> Result[Unit, ParseError] {
  match basic_url_parse(href, None, None, None) {
    Ok(rec) => {
      self.apply_record(rec)
      Ok(())
    }
    Err(e) => Err(e)
  }
}
