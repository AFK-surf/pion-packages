///| WHATWG URL Standard Basic URL Parser (full state machine + canonical serializer).

///| Return default port for special schemes, or -1 if none.
fn default_port_for_scheme(scheme : String) -> Int {
  if scheme == "http" || scheme == "ws" {
    80
  } else if scheme == "https" || scheme == "wss" {
    443
  } else if scheme == "ftp" {
    21
  } else {
    -1
  }
}

///| Return true if `scheme` is a WHATWG special scheme.
fn is_special_scheme(scheme : String) -> Bool {
  scheme == "http" ||
  scheme == "https" ||
  scheme == "ws" ||
  scheme == "wss" ||
  scheme == "ftp" ||
  scheme == "file"
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alnum(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

fn to_ascii_lower(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

fn is_windows_drive_letter_pair(b0 : Int, b1 : Int) -> Bool {
  is_ascii_alpha(b0) && (b1 == 58 || b1 == 124)
}

fn is_normalized_windows_drive_letter(s : String) -> Bool {
  s.length() == 2 && is_ascii_alpha(s.code_unit_at(0)) && s.code_unit_at(1) == 58
}

fn starts_with_windows_drive_letter(s : String, pos : Int, end : Int) -> Bool {
  let rem = end - pos
  if rem < 2 {
    return false
  }
  if !is_windows_drive_letter_pair(s.code_unit_at(pos), s.code_unit_at(pos + 1)) {
    return false
  }
  if rem == 2 {
    return true
  }
  let c2 = s.code_unit_at(pos + 2)
  c2 == 47 || c2 == 92 || c2 == 63 || c2 == 35
}

fn is_single_dot_segment(seg : String) -> Bool {
  let n = seg.length()
  if n == 1 {
    return seg.code_unit_at(0) == 46
  }
  if n == 3 {
    return seg.code_unit_at(0) == 37 &&
    seg.code_unit_at(1) == 50 &&
    (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69)
  }
  false
}

fn is_double_dot_segment(seg : String) -> Bool {
  let n = seg.length()
  if n == 2 {
    return seg.code_unit_at(0) == 46 && seg.code_unit_at(1) == 46
  }
  if n == 4 {
    // `.%2e` or `%2e.`
    if seg.code_unit_at(0) == 46 {
      return seg.code_unit_at(1) == 37 &&
      seg.code_unit_at(2) == 50 &&
      (seg.code_unit_at(3) == 101 || seg.code_unit_at(3) == 69)
    }
    if seg.code_unit_at(3) == 46 {
      return seg.code_unit_at(0) == 37 &&
      seg.code_unit_at(1) == 50 &&
      (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69)
    }
  }
  if n == 6 {
    // `%2e%2e`
    return seg.code_unit_at(0) == 37 &&
    seg.code_unit_at(1) == 50 &&
    (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69) &&
    seg.code_unit_at(3) == 37 &&
    seg.code_unit_at(4) == 50 &&
    (seg.code_unit_at(5) == 101 || seg.code_unit_at(5) == 69)
  }
  false
}

///| Strip leading/trailing C0+space (when `trim_outer` is true) and all ASCII tab/LF/CR.
fn preprocess_input(input : String, trim_outer : Bool) -> String {
  let n = input.length()
  let mut start = 0
  let mut end = n
  if trim_outer {
    while start < end && input.code_unit_at(start) <= 0x20 {
      start = start + 1
    }
    while end > start && input.code_unit_at(end - 1) <= 0x20 {
      end = end - 1
    }
  }
  // Scan for \t, \n, \r
  let mut has_tab_nl = false
  let mut i = start
  while i < end {
    let b = input.code_unit_at(i)
    if b == 9 || b == 10 || b == 13 {
      has_tab_nl = true
      break
    }
    i = i + 1
  }
  if !has_tab_nl {
    if start == 0 && end == n {
      return input
    }
    return input.slice(start, end)
  }
  let sb = StringBuilder::with_capacity(end - start)
  let mut run_start = start
  i = start
  while i < end {
    let b = input.code_unit_at(i)
    if b == 9 || b == 10 || b == 13 {
      if i > run_start {
        sb.write_substring(input, run_start, i)
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < end {
    sb.write_substring(input, run_start, end)
  }
  sb.to_string()
}

///| Internal mutable URL record used during parsing and setters before serialization.
struct UrlRecord {
  mut scheme : String
  mut username : String
  mut password : String
  mut has_host : Bool
  mut host_kind : HostKind
  mut host_domain : String
  mut host_ipv4 : Ipv4Addr
  mut host_ipv6 : Ipv6Addr
  mut port_val : Int
  mut opaque_path : Bool
  mut opaque_path_str : String
  mut path_segs : Array[String]
  mut has_query : Bool
  mut query_str : String
  mut has_fragment : Bool
  mut fragment_str : String
}

fn UrlRecord::empty() -> UrlRecord {
  UrlRecord::{
    scheme: "",
    username: "",
    password: "",
    has_host: false,
    host_kind: HostKind::NoHost,
    host_domain: "",
    host_ipv4: Ipv4Addr::from_u32(0U),
    host_ipv6: Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 0),
    port_val: -1,
    opaque_path: false,
    opaque_path_str: "",
    path_segs: [],
    has_query: false,
    query_str: "",
    has_fragment: false,
    fragment_str: "",
  }
}

fn UrlRecord::from_url(u : Url) -> UrlRecord {
  let rec = UrlRecord::empty()
  rec.scheme = u.scheme()
  rec.username = u.username()
  match u.password() {
    Some(p) => rec.password = p
    None => rec.password = ""
  }
  rec.has_host = u.has_host()
  rec.host_kind = u.host_kind
  match u.host_kind {
    HostKind::DomainHost =>
    rec.host_domain = u.serialization.slice(u.host_start, u.host_end)
    HostKind::Ipv4Host => rec.host_ipv4 = u.ipv4
    HostKind::Ipv6Host => rec.host_ipv6 = u.ipv6
    HostKind::NoHost => ()
  }
  rec.port_val = u.port_val
  rec.opaque_path = u.opaque_path
  let p = u.path()
  if u.opaque_path {
    rec.opaque_path_str = p
  } else {
    // Decode path string back into segments.
    // Note: if !has_host and serialized with "/." prefix, `u.path()` starts with "/" (Wait: `u.path()` is the serialized path WITHOUT "/."? No, in WHATWG `/.` is only in href, pathname starts with `//`? Let's check!).
    // Actually in WHATWG URL Standard:
    // URL serializer emits `/.` before `path[0]` when host is null, path is list, path.len > 1, path[0] == "".
    // And `pathname` getter serializes URL path WITHOUT `/.`! Wait: let's check WPT `non-spec:/.//p`!
    // In WPT: `non-spec:/.//p` has href=`non-spec:/.//p`, pathname=`//p`!
    // So in `Url`, if we store `path_start` pointing to the start of pathname (after `/.` if present? Wait: if href is `non-spec:/.//p`, then `serialization[path_start..]` is `/.//p` unless we handle it).
    // Let's split `p` carefully:
    if p.length() == 0 {
      rec.path_segs = []
    } else if p.code_unit_at(0) == 47 {
      // Split by '/' starting after index 0
      let segs : Array[String] = []
      let mut start = 1
      let mut i = 1
      let pn = p.length()
      while i <= pn {
        if i == pn || p.code_unit_at(i) == 47 {
          segs.push(p.slice(start, i))
          start = i + 1
        }
        i = i + 1
      }
      rec.path_segs = segs
    } else {
      rec.path_segs = [p]
    }
  }
  match u.query() {
    Some(q) => {
      rec.has_query = true
      rec.query_str = q
    }
    None => ()
  }
  match u.fragment() {
    Some(f) => {
      rec.has_fragment = true
      rec.fragment_str = f
    }
    None => ()
  }
  rec
}

fn UrlRecord::includes_credentials(self : UrlRecord) -> Bool {
  self.username.length() > 0 || self.password.length() > 0
}

fn UrlRecord::set_host_val(self : UrlRecord, h : Host) -> Unit {
  self.has_host = true
  match h {
    Host::Domain(d) => {
      self.host_kind = HostKind::DomainHost
      self.host_domain = d
    }
    Host::Ipv4(ip) => {
      self.host_kind = HostKind::Ipv4Host
      self.host_ipv4 = ip
    }
    Host::Ipv6(ip) => {
      self.host_kind = HostKind::Ipv6Host
      self.host_ipv6 = ip
    }
  }
}

fn UrlRecord::clear_host(self : UrlRecord) -> Unit {
  self.has_host = false
  self.host_kind = HostKind::NoHost
  self.host_domain = ""
}

fn UrlRecord::shorten_path(self : UrlRecord) -> Unit {
  let len = self.path_segs.length()
  if len == 0 {
    return ()
  }
  if self.scheme == "file" &&
  len == 1 &&
  is_normalized_windows_drive_letter(self.path_segs[0]) {
    return ()
  }
  let _ = self.path_segs.pop()
}

///| Serialize a `UrlRecord` into a canonical `Url` with exact byte offsets.
fn UrlRecord::to_url(self : UrlRecord) -> Url {
  let est = self.scheme.length() +
  self.username.length() +
  self.password.length() +
  self.host_domain.length() +
  self.opaque_path_str.length() +
  self.query_str.length() +
  self.fragment_str.length() +
  32
  let sb = StringBuilder::with_capacity(est)
  sb.write_string(self.scheme)
  let scheme_end = self.scheme.length()
  sb.write_byte((58).to_byte()) // ':'
  let mut username_end = scheme_end + 1
  let mut host_start = scheme_end + 1
  let mut host_end = scheme_end + 1
  if self.has_host {
    sb.write_string("//")
    if self.includes_credentials() {
      sb.write_string(self.username)
      username_end = sb.length()
      if self.password.length() > 0 {
        sb.write_byte((58).to_byte())
        sb.write_string(self.password)
      }
      sb.write_byte((64).to_byte()) // '@'
      host_start = sb.length()
    } else {
      username_end = sb.length()
      host_start = sb.length()
    }
    match self.host_kind {
      HostKind::DomainHost => sb.write_string(self.host_domain)
      HostKind::Ipv4Host => sb.write_string(self.host_ipv4.to_string())
      HostKind::Ipv6Host => {
        sb.write_byte((91).to_byte())
        write_ipv6(sb, self.host_ipv6)
        sb.write_byte((93).to_byte())
      }
      HostKind::NoHost => ()
    }
    host_end = sb.length()
    if self.port_val >= 0 {
      sb.write_byte((58).to_byte())
      sb.write_string(self.port_val.to_string())
    }
  } else if !self.opaque_path &&
  self.path_segs.length() > 1 &&
  self.path_segs[0].length() == 0 {
    // WHATWG URL Serializer §4.5: if host is null, path is list, path.len > 1, path[0] == "",
    // append "/." to avoid ambiguity with authority "//"
    sb.write_string("/.")
  }
  let path_start = sb.length()
  if self.opaque_path {
    sb.write_string(self.opaque_path_str)
  } else {
    let plen = self.path_segs.length()
    let mut i = 0
    while i < plen {
      sb.write_byte((47).to_byte())
      sb.write_string(self.path_segs[i])
      i = i + 1
    }
  }
  let mut query_start = -1
  if self.has_query {
    query_start = sb.length()
    sb.write_byte((63).to_byte())
    sb.write_string(self.query_str)
  }
  let mut fragment_start = -1
  if self.has_fragment {
    fragment_start = sb.length()
    sb.write_byte((35).to_byte())
    sb.write_string(self.fragment_str)
  }
  Url::{
    serialization: sb.to_string(),
    scheme_end: scheme_end,
    username_end: username_end,
    host_start: host_start,
    host_end: host_end,
    host_kind: self.host_kind,
    ipv4: self.host_ipv4,
    ipv6: self.host_ipv6,
    port_val: self.port_val,
    path_start: path_start,
    query_start: query_start,
    fragment_start: fragment_start,
    opaque_path: self.opaque_path,
  }
}

///| Parser state enum matching WHATWG URL Standard §4.3.
enum ParseState {
  SchemeStart
  Scheme
  NoScheme
  SpecialRelativeOrAuthority
  PathOrAuthority
  Relative
  RelativeSlash
  SpecialAuthoritySlashes
  SpecialAuthorityIgnoreSlashes
  Authority
  Host
  Hostname
  Port
  File
  FileSlash
  FileHost
  PathStart
  Path
  OpaquePath
  Query
  Fragment
}

///| Basic URL Parser (WHATWG URL Standard §4.3).
fn basic_url_parse(
  raw_input : String,
  base : Option[Url],
  existing : Option[UrlRecord],
  state_override : Option[ParseState],
) -> Result[UrlRecord, ParseError] {
  let has_override = match state_override {
    Some(_) => true
    None => false
  }
  let input = preprocess_input(raw_input, !has_override)
  let n = input.length()
  let url = match existing {
    Some(r) => r
    None => UrlRecord::empty()
  }
  let base_rec : Option[UrlRecord] = match base {
    Some(b) => Some(UrlRecord::from_url(b))
    None => None
  }
  let mut state = match state_override {
    Some(st) => st
    None => ParseState::SchemeStart
  }
  let mut buf = StringBuilder::with_capacity(32)
  let mut u_sb = StringBuilder::with_capacity(0)
  let mut p_sb = StringBuilder::with_capacity(0)
  let mut at_sign_seen = false
  let mut inside_brackets = false
  let mut password_token_seen = false
  let mut ptr = 0

  while ptr <= n {
    let is_eof = ptr == n
    let c = if is_eof { -1 } else { input.code_unit_at(ptr) }
    match state {
      ParseState::SchemeStart => {
        if !is_eof && is_ascii_alpha(c) {
          buf.write_byte(to_ascii_lower(c).to_byte())
          state = ParseState::Scheme
        } else if !has_override {
          state = ParseState::NoScheme
          continue // reprocess without advancing ptr
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme start"))
        }
      }
      ParseState::Scheme => {
        if !is_eof &&
        (is_ascii_alnum(c) || c == 43 || c == 45 || c == 46) {
          buf.write_byte(to_ascii_lower(c).to_byte())
        } else if c == 58 {
          // ':'
          let new_scheme = buf.to_string()
          if has_override {
            let old_special = is_special_scheme(url.scheme)
            let new_special = is_special_scheme(new_scheme)
            if old_special && !new_special {
              return Ok(url)
            }
            if !old_special && new_special {
              return Ok(url)
            }
            if (url.includes_credentials() || url.port_val >= 0) &&
            new_scheme == "file" {
              return Ok(url)
            }
            if url.scheme == "file" &&
            (!url.has_host ||
              (match url.host_kind {
                HostKind::DomainHost => url.host_domain.length() == 0
                _ => false
            })) {
              return Ok(url)
            }
          }
          url.scheme = new_scheme
          if has_override {
            if url.port_val >= 0 &&
            url.port_val == default_port_for_scheme(url.scheme) {
              url.port_val = -1
            }
            return Ok(url)
          }
          buf = StringBuilder::with_capacity(32)
          if url.scheme == "file" {
            state = ParseState::File
          } else if is_special_scheme(url.scheme) {
            let same_base_scheme = match base_rec {
              Some(b) => b.scheme == url.scheme
              None => false
            }
            if same_base_scheme {
              state = ParseState::SpecialRelativeOrAuthority
            } else {
              state = ParseState::SpecialAuthoritySlashes
            }
          } else if ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
            state = ParseState::PathOrAuthority
            ptr = ptr + 1
          } else {
            url.opaque_path = true
            url.opaque_path_str = ""
            url.path_segs = []
            state = ParseState::OpaquePath
          }
        } else if !has_override {
          buf = StringBuilder::with_capacity(32)
          state = ParseState::NoScheme
          ptr = 0
          continue
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme"))
        }
      }
      ParseState::NoScheme => {
        match base_rec {
          None =>
          return Err(
            ParseError::new(
              ParseErrorKind::RelativeUrlWithoutBase,
              "relative URL without a base",
            ),
          )
          Some(b) => {
            if b.opaque_path && c != 35 {
              return Err(
                ParseError::new(
                  ParseErrorKind::RelativeUrlWithCannotBeABaseBase,
                  "relative URL with cannot-be-a-base base",
                ),
              )
            } else if b.opaque_path && c == 35 {
              url.scheme = b.scheme
              url.opaque_path = true
              url.opaque_path_str = b.opaque_path_str
              url.has_query = b.has_query
              url.query_str = b.query_str
              url.has_fragment = true
              url.fragment_str = ""
              state = ParseState::Fragment
            } else if b.scheme != "file" {
              state = ParseState::Relative
              continue
            } else {
              state = ParseState::File
              continue
            }
          }
        }
      }
      ParseState::SpecialRelativeOrAuthority => {
        if c == 47 && ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          ptr = ptr + 1
        } else {
          state = ParseState::Relative
          continue
        }
      }
      ParseState::PathOrAuthority => {
        if c == 47 {
          state = ParseState::Authority
        } else {
          state = ParseState::Path
          continue
        }
      }
      ParseState::Relative => {
        let b = match base_rec {
          Some(v) => v
          None =>
          return Err(
            ParseError::new(
              ParseErrorKind::RelativeUrlWithoutBase,
              "missing base",
            ),
          )
        }
        url.scheme = b.scheme
        if c == 47 {
          state = ParseState::RelativeSlash
        } else if is_special_scheme(url.scheme) && c == 92 {
          state = ParseState::RelativeSlash
        } else {
          url.username = b.username
          url.password = b.password
          url.has_host = b.has_host
          url.host_kind = b.host_kind
          url.host_domain = b.host_domain
          url.host_ipv4 = b.host_ipv4
          url.host_ipv6 = b.host_ipv6
          url.port_val = b.port_val
          url.opaque_path = false
          url.path_segs = copy_str_array(b.path_segs)
          url.has_query = b.has_query
          url.query_str = b.query_str
          if c == 63 {
            url.has_query = true
            url.query_str = ""
            state = ParseState::Query
          } else if c == 35 {
            url.has_fragment = true
            url.fragment_str = ""
            state = ParseState::Fragment
          } else if !is_eof {
            url.has_query = false
            url.query_str = ""
            url.shorten_path()
            state = ParseState::Path
            continue
          }
        }
      }
      ParseState::RelativeSlash => {
        if is_special_scheme(url.scheme) && (c == 47 || c == 92) {
          state = ParseState::SpecialAuthorityIgnoreSlashes
        } else if c == 47 {
          state = ParseState::Authority
        } else {
          let b = match base_rec {
            Some(v) => v
            None =>
            return Err(
              ParseError::new(
                ParseErrorKind::RelativeUrlWithoutBase,
                "missing base",
              ),
            )
          }
          url.username = b.username
          url.password = b.password
          url.has_host = b.has_host
          url.host_kind = b.host_kind
          url.host_domain = b.host_domain
          url.host_ipv4 = b.host_ipv4
          url.host_ipv6 = b.host_ipv6
          url.port_val = b.port_val
          state = ParseState::Path
          continue
        }
      }
      ParseState::SpecialAuthoritySlashes => {
        if c == 47 && ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          ptr = ptr + 1
        } else {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          continue
        }
      }
      ParseState::SpecialAuthorityIgnoreSlashes => {
        if c != 47 && c != 92 {
          state = ParseState::Authority
          continue
        }
      }
      ParseState::Authority => {
        if c == 64 {
          // '@' — O(N) persistent StringBuilder accumulation (no repeated copying of url.username)
          if at_sign_seen {
            if password_token_seen {
              p_sb.write_string("%40")
            } else {
              u_sb.write_string("%40")
            }
          }
          at_sign_seen = true
          let bstr = buf.to_string()
          let bn = bstr.length()
          if bn > 0 {
            if password_token_seen {
              write_percent_encoded_slice(p_sb, bstr, 0, bn, mask_userinfo)
            } else {
              let mut colon_pos = -1
              let mut bi = 0
              while bi < bn {
                if bstr.code_unit_at(bi) == 58 {
                  colon_pos = bi
                  break
                }
                bi = bi + 1
              }
              if colon_pos >= 0 {
                if colon_pos > 0 {
                  write_percent_encoded_slice(u_sb, bstr, 0, colon_pos, mask_userinfo)
                }
                password_token_seen = true
                if colon_pos + 1 < bn {
                  write_percent_encoded_slice(p_sb, bstr, colon_pos + 1, bn, mask_userinfo)
                }
              } else {
                write_percent_encoded_slice(u_sb, bstr, 0, bn, mask_userinfo)
              }
            }
          }
          buf = StringBuilder::with_capacity(32)
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) {
          if at_sign_seen {
            if buf.length() == 0 {
              return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host after @"))
            }
            url.username = u_sb.to_string()
            url.password = p_sb.to_string()
          }
          ptr = ptr - buf.length()
          buf = StringBuilder::with_capacity(32)
          state = ParseState::Host
          continue
        } else {
          // Fast-scan authority chunk up to next '@', '/', '?', '#', or '\'
          let chunk_start = ptr
          let special = is_special_scheme(url.scheme)
          let mut j = ptr + 1
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 64 || ch == 47 || ch == 63 || ch == 35 || (special && ch == 92) {
              break
            }
            j = j + 1
          }
          buf.write_substring(input, chunk_start, j)
          ptr = j
          continue
        }
      }
      ParseState::Host | ParseState::Hostname => {
        if has_override && url.scheme == "file" {
          state = ParseState::FileHost
          continue
        }
        let is_hostname_state = match state {
          ParseState::Hostname => true
          _ => false
        }
        if c == 58 && !inside_brackets {
          let bstr = buf.to_string()
          if bstr.length() == 0 {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host before colon"))
          }
          if is_hostname_state {
            return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "colon in hostname"))
          }
          let h = if is_special_scheme(url.scheme) {
            match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          } else {
            match host_parse_opaque(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          }
          url.set_host_val(h)
          buf = StringBuilder::with_capacity(16)
          state = ParseState::Port
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) {
          let bstr = buf.to_string()
          if is_special_scheme(url.scheme) && bstr.length() == 0 {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host"))
          }
          if has_override &&
          bstr.length() == 0 &&
          (url.includes_credentials() || url.port_val >= 0) {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "cannot clear host with credentials or port"))
          }
          let h = if is_special_scheme(url.scheme) {
            match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          } else {
            match host_parse_opaque(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          }
          url.set_host_val(h)
          buf = StringBuilder::with_capacity(32)
          state = ParseState::PathStart
          if has_override {
            return Ok(url)
          }
          continue
        } else {
          if c == 91 {
            inside_brackets = true
          } else if c == 93 {
            inside_brackets = false
          }
          buf.write_byte(c.to_byte())
        }
      }
      ParseState::Port => {
        if !is_eof && is_ascii_digit(c) {
          buf.write_byte(c.to_byte())
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) ||
        has_override {
          let bstr = buf.to_string()
          if bstr.length() > 0 {
            let mut port_num = 0
            let mut pi = 0
            let pn = bstr.length()
            while pi < pn {
              port_num = port_num * 10 + (bstr.code_unit_at(pi) - 48)
              if port_num > 65535 {
                return Err(ParseError::new(ParseErrorKind::InvalidPort, "port > 65535"))
              }
              pi = pi + 1
            }
            if port_num == default_port_for_scheme(url.scheme) {
              url.port_val = -1
            } else {
              url.port_val = port_num
            }
            buf = StringBuilder::with_capacity(32)
            if has_override {
              return Ok(url)
            }
          }
          if has_override {
            match state_override {
              Some(ParseState::Host) => return Ok(url)
              _ => return Err(ParseError::new(ParseErrorKind::InvalidPort, "invalid port in override"))
            }
          }
          state = ParseState::PathStart
          continue
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidPort, "non-digit in port"))
        }
      }
      ParseState::File => {
        url.scheme = "file"
        url.set_host_val(Host::Domain(""))
        if c == 47 || c == 92 {
          state = ParseState::FileSlash
        } else {
          match base_rec {
            Some(b) => {
              if b.scheme == "file" {
                url.has_host = b.has_host
                url.host_kind = b.host_kind
                url.host_domain = b.host_domain
                url.host_ipv4 = b.host_ipv4
                url.host_ipv6 = b.host_ipv6
                url.opaque_path = false
                url.path_segs = copy_str_array(b.path_segs)
                url.has_query = b.has_query
                url.query_str = b.query_str
                if c == 63 {
                  url.has_query = true
                  url.query_str = ""
                  state = ParseState::Query
                } else if c == 35 {
                  url.has_fragment = true
                  url.fragment_str = ""
                  state = ParseState::Fragment
                } else if !is_eof {
                  url.has_query = false
                  url.query_str = ""
                  if !starts_with_windows_drive_letter(input, ptr, n) {
                    url.shorten_path()
                  } else {
                    url.path_segs = []
                  }
                  state = ParseState::Path
                  continue
                }
              } else {
                state = ParseState::Path
                continue
              }
            }
            None => {
              state = ParseState::Path
              continue
            }
          }
        }
      }
      ParseState::FileSlash => {
        if c == 47 || c == 92 {
          state = ParseState::FileHost
        } else {
          match base_rec {
            Some(b) => {
              if b.scheme == "file" {
                url.has_host = b.has_host
                url.host_kind = b.host_kind
                url.host_domain = b.host_domain
                url.host_ipv4 = b.host_ipv4
                url.host_ipv6 = b.host_ipv6
                if !starts_with_windows_drive_letter(input, ptr, n) &&
                b.path_segs.length() > 0 &&
                is_normalized_windows_drive_letter(b.path_segs[0]) {
                  url.path_segs.push(b.path_segs[0])
                }
              }
            }
            None => ()
          }
          state = ParseState::Path
          continue
        }
      }
      ParseState::FileHost => {
        if is_eof || c == 47 || c == 92 || c == 63 || c == 35 {
          let bstr = buf.to_string()
          let blen = bstr.length()
          if !has_override &&
          blen == 2 &&
          is_windows_drive_letter_pair(bstr.code_unit_at(0), bstr.code_unit_at(1)) {
            state = ParseState::Path
            continue
          } else if blen == 0 {
            url.set_host_val(Host::Domain(""))
            if has_override {
              return Ok(url)
            }
            state = ParseState::PathStart
            continue
          } else {
            let h = match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            match h {
              Host::Domain(d) => {
                if d == "localhost" {
                  url.set_host_val(Host::Domain(""))
                } else {
                  url.set_host_val(Host::Domain(d))
                }
              }
              _ => url.set_host_val(h)
            }
            if has_override {
              return Ok(url)
            }
            buf = StringBuilder::with_capacity(32)
            state = ParseState::PathStart
            continue
          }
        } else {
          buf.write_byte(c.to_byte())
        }
      }
      ParseState::PathStart => {
        if is_special_scheme(url.scheme) {
          state = ParseState::Path
          if c != 47 && c != 92 {
            continue
          }
        } else if !has_override && c == 63 {
          url.has_query = true
          url.query_str = ""
          state = ParseState::Query
        } else if !has_override && c == 35 {
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else if !is_eof {
          state = ParseState::Path
          if c != 47 {
            continue
          }
        } else if has_override && !url.has_host {
          url.path_segs.push("")
        }
      }
      ParseState::Path => {
        let special = is_special_scheme(url.scheme)
        if is_eof ||
        c == 47 ||
        (special && c == 92) ||
        (!has_override && (c == 63 || c == 35)) {
          let seg = buf.to_string()
          if is_double_dot_segment(seg) {
            url.shorten_path()
            if c != 47 && !(special && c == 92) {
              url.path_segs.push("")
            }
          } else if is_single_dot_segment(seg) &&
          c != 47 &&
          !(special && c == 92) {
            url.path_segs.push("")
          } else if !is_single_dot_segment(seg) {
            let final_seg = if url.scheme == "file" &&
            url.path_segs.length() == 0 &&
            seg.length() == 2 &&
            is_ascii_alpha(seg.code_unit_at(0)) &&
            seg.code_unit_at(1) == 124 {
              let dsb = StringBuilder::with_capacity(2)
              dsb.write_byte(seg.code_unit_at(0).to_byte())
              dsb.write_byte((58).to_byte())
              dsb.to_string()
            } else {
              seg
            }
            url.path_segs.push(final_seg)
          }
          buf = StringBuilder::with_capacity(32)
          if !has_override && c == 63 {
            url.has_query = true
            url.query_str = ""
            state = ParseState::Query
          } else if !has_override && c == 35 {
            url.has_fragment = true
            url.fragment_str = ""
            state = ParseState::Fragment
          }
        } else {
          // Fast-scan path segment run up to next delimiter
          let chunk_start = ptr
          let mut j = ptr
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 47 ||
            (special && ch == 92) ||
            (!has_override && (ch == 63 || ch == 35)) {
              break
            }
            j = j + 1
          }
          write_percent_encoded_slice(buf, input, chunk_start, j, mask_path)
          ptr = j
          continue
        }
      }
      ParseState::OpaquePath => {
        if c == 63 {
          let olen = url.opaque_path_str.length()
          if olen > 0 && url.opaque_path_str.code_unit_at(olen - 1) == 32 {
            url.opaque_path_str = url.opaque_path_str.slice(0, olen - 1) + "%20"
          }
          url.has_query = true
          url.query_str = ""
          state = ParseState::Query
        } else if c == 35 {
          let olen = url.opaque_path_str.length()
          if olen > 0 && url.opaque_path_str.code_unit_at(olen - 1) == 32 {
            url.opaque_path_str = url.opaque_path_str.slice(0, olen - 1) + "%20"
          }
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else if !is_eof {
          let chunk_start = ptr
          let mut j = ptr
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 63 || ch == 35 {
              break
            }
            j = j + 1
          }
          let osb = StringBuilder::with_capacity(
            url.opaque_path_str.length() + (j - chunk_start) + 8,
          )
          osb.write_string(url.opaque_path_str)
          write_percent_encoded_slice(osb, input, chunk_start, j, mask_controls)
          url.opaque_path_str = osb.to_string()
          ptr = j
          continue
        }
      }
      ParseState::Query => {
        let qmask = if is_special_scheme(url.scheme) {
          mask_special_query
        } else {
          mask_query
        }
        if is_eof {
          break
        }
        if !has_override && c == 35 {
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else {
          let chunk_start = ptr
          let mut j = ptr
          if !has_override {
            while j < n && input.code_unit_at(j) != 35 {
              j = j + 1
            }
          } else {
            j = n
          }
          let qsb = StringBuilder::with_capacity(j - chunk_start + 8)
          write_percent_encoded_slice(qsb, input, chunk_start, j, qmask)
          url.query_str = qsb.to_string()
          ptr = j
          continue
        }
      }
      ParseState::Fragment => {
        if !is_eof {
          let fsb = StringBuilder::with_capacity(n - ptr + 8)
          write_percent_encoded_slice(fsb, input, ptr, n, mask_fragment)
          url.fragment_str = fsb.to_string()
          ptr = n
          continue
        }
      }
    }
    ptr = ptr + 1
  }
  Ok(url)
}

fn copy_str_array(src : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Check if `s[start..end]` contains any dot-segment (`/./`, `/../`, `%2e`, trailing `/.` or `/..`),
///| backslash, or ASCII tab/LF/CR.
fn path_slice_needs_slow(s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 92 || b == 9 || b == 10 || b == 13 {
      return true
    }
    if b == 47 {
      // Check next segment for `.`, `..`, `%2e`
      let next = i + 1
      if next < end {
        let c1 = s.code_unit_at(next)
        if c1 == 46 {
          if next + 1 == end {
            return true
          }
          let c2 = s.code_unit_at(next + 1)
          if c2 == 47 || c2 == 46 || c2 == 37 {
            return true
          }
        } else if c1 == 37 && next + 2 < end {
          let c2 = s.code_unit_at(next + 1)
          let c3 = s.code_unit_at(next + 2)
          if c2 == 50 && (c3 == 101 || c3 == 69) {
            return true
          }
        }
      }
    }
    i = i + 1
  }
  false
}

///| Single-pass zero-intermediate-allocation fast path for common absolute special URLs
///| (`http://`, `https://`, `ws://`, `wss://`, `ftp://`).
///| Returns `None` on any edge case so the full WHATWG state machine handles it identically.
fn try_fast_parse_absolute(input : String) -> Option[Url] {
  let n = input.length()
  if n < 8 {
    return None
  }
  // Reject leading/trailing C0+space
  if input.code_unit_at(0) <= 0x20 || input.code_unit_at(n - 1) <= 0x20 {
    return None
  }
  // Match known lowercase special schemes followed by "://"
  let b0 = input.code_unit_at(0)
  let mut scheme_end = 0
  let mut def_port = -1
  if b0 == 104 {
    // http:// or https://
    if input.code_unit_at(1) == 116 &&
    input.code_unit_at(2) == 116 &&
    input.code_unit_at(3) == 112 {
      if input.code_unit_at(4) == 58 &&
      input.code_unit_at(5) == 47 &&
      input.code_unit_at(6) == 47 {
        scheme_end = 4
        def_port = 80
      } else if n >= 9 &&
      input.code_unit_at(4) == 115 &&
      input.code_unit_at(5) == 58 &&
      input.code_unit_at(6) == 47 &&
      input.code_unit_at(7) == 47 {
        scheme_end = 5
        def_port = 443
      } else {
        return None
      }
    } else {
      return None
    }
  } else if b0 == 119 {
    // ws:// or wss://
    if input.code_unit_at(1) == 115 {
      if input.code_unit_at(2) == 58 &&
      input.code_unit_at(3) == 47 &&
      input.code_unit_at(4) == 47 {
        scheme_end = 2
        def_port = 80
      } else if input.code_unit_at(2) == 115 &&
      input.code_unit_at(3) == 58 &&
      input.code_unit_at(4) == 47 &&
      input.code_unit_at(5) == 47 {
        scheme_end = 3
        def_port = 443
      } else {
        return None
      }
    } else {
      return None
    }
  } else if b0 == 102 {
    // ftp://
    if input.code_unit_at(1) == 116 &&
    input.code_unit_at(2) == 112 &&
    input.code_unit_at(3) == 58 &&
    input.code_unit_at(4) == 47 &&
    input.code_unit_at(5) == 47 {
      scheme_end = 3
      def_port = 21
    } else {
      return None
    }
  } else {
    return None
  }
  let auth_start = scheme_end + 3
  if auth_start >= n {
    return None
  }
  let first_auth = input.code_unit_at(auth_start)
  if first_auth == 47 || first_auth == 92 {
    return None
  }
  // Scan authority up to '/', '?', '#', or EOF
  let mut auth_end = auth_start
  let mut at_pos = -1
  let mut at_count = 0
  let mut colon_after_at = -1
  let mut in_brackets = false
  let mut has_non_ascii_host = false
  let mut has_upper_host = false
  let mut has_pct_host = false
  while auth_end < n {
    let ch = input.code_unit_at(auth_end)
    if ch == 47 || ch == 63 || ch == 35 {
      break
    }
    if ch == 92 || ch == 9 || ch == 10 || ch == 13 {
      return None
    }
    if ch == 64 {
      at_pos = auth_end
      at_count = at_count + 1
      colon_after_at = -1
      in_brackets = false
      has_non_ascii_host = false
      has_upper_host = false
      has_pct_host = false
    } else if ch == 91 {
      in_brackets = true
    } else if ch == 93 {
      in_brackets = false
    } else if ch == 58 && !in_brackets && colon_after_at < 0 {
      colon_after_at = auth_end
    } else if ch >= 0x80 {
      has_non_ascii_host = true
    } else if ch >= 65 && ch <= 90 {
      has_upper_host = true
    } else if ch == 37 {
      has_pct_host = true
    }
    auth_end = auth_end + 1
  }
  if at_count > 1 || in_brackets {
    return None
  }
  let host_s = if at_pos >= 0 { at_pos + 1 } else { auth_start }
  let host_e = if colon_after_at >= 0 { colon_after_at } else { auth_end }
  if host_e <= host_s {
    return None
  }
  // Parse port if present
  let mut port_val = -1
  let mut port_stripped = false
  if colon_after_at >= 0 {
    let ps = colon_after_at + 1
    if ps < auth_end {
      let mut pnum = 0
      let mut pi = ps
      while pi < auth_end {
        let ch = input.code_unit_at(pi)
        if ch < 48 || ch > 57 {
          return None
        }
        pnum = pnum * 10 + (ch - 48)
        if pnum > 65535 {
          return None
        }
        pi = pi + 1
      }
      if pnum != def_port {
        port_val = pnum
        // Leading zero in port (e.g. `:080`) requires canonical rewrite
        if auth_end - ps > 1 && input.code_unit_at(ps) == 48 {
          port_stripped = true
        }
      } else {
        port_stripped = true
      }
    } else {
      port_stripped = true
    }
  }
  // Scan path, query, fragment boundaries in ONE pass while tracking encoding/dot-segment flags
  let lut = encode_lut
  let mut path_s = auth_end
  let mut path_e = auth_end
  let mut path_has_dots = false
  let mut path_needs_enc = false
  let mut query_s = -1
  let mut query_e = -1
  let mut query_needs_enc = false
  let mut query_has_tab_nl = false
  let mut frag_s = -1
  let mut frag_needs_enc = false
  let mut frag_has_tab_nl = false
  let mut scan = auth_end
  if scan < n && input.code_unit_at(scan) == 47 {
    path_s = scan
    while scan < n {
      let ch = input.code_unit_at(scan)
      if ch == 63 || ch == 35 {
        break
      }
      if ch == 92 || ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_path) != 0 {
        path_needs_enc = true
      }
      if ch == 47 && scan + 1 < n {
        let c1 = input.code_unit_at(scan + 1)
        if c1 == 46 {
          if scan + 2 < n && input.code_unit_at(scan + 2) == 37 {
            return None
          }
          path_has_dots = true
        } else if c1 == 37 && scan + 3 < n {
          let c2 = input.code_unit_at(scan + 2)
          let c3 = input.code_unit_at(scan + 3)
          if c2 == 50 && (c3 == 101 || c3 == 69) {
            return None
          }
        }
      }
      scan = scan + 1
    }
    path_e = scan
  }
  if scan < n && input.code_unit_at(scan) == 63 {
    query_s = scan + 1
    scan = scan + 1
    while scan < n {
      let ch = input.code_unit_at(scan)
      if ch == 35 {
        break
      }
      if ch == 9 || ch == 10 || ch == 13 {
        query_has_tab_nl = true
      } else if (lut[ch] & mask_special_query) != 0 {
        query_needs_enc = true
      }
      scan = scan + 1
    }
    query_e = scan
  }
  if scan < n && input.code_unit_at(scan) == 35 {
    frag_s = scan + 1
    scan = scan + 1
    while scan < n {
      let ch = input.code_unit_at(scan)
      if ch == 9 || ch == 10 || ch == 13 {
        frag_has_tab_nl = true
      } else if (lut[ch] & mask_fragment) != 0 {
        frag_needs_enc = true
      }
      scan = scan + 1
    }
  }

  // Classify & parse host directly (zero slice allocation on ASCII & IPv4 & IPv6!)
  let mut host_kind = HostKind::DomainHost
  let mut ipv4 = Ipv4Addr::from_u32(0U)
  let mut ipv6 = Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 0)
  let mut slow_domain = ""
  let mut use_direct_host = false
  if input.code_unit_at(host_s) == 91 {
    if input.code_unit_at(host_e - 1) != 93 {
      return None
    }
    match parse_ipv6_slice(input, host_s + 1, host_e - 1) {
      Ok(ip) => {
        host_kind = HostKind::Ipv6Host
        ipv6 = ip
      }
      Err(_) => return None
    }
  } else if !has_non_ascii_host && !has_pct_host {
    let dlut = forbidden_domain_lut
    let mut hi = host_s
    let mut ls = host_s
    let mut has_xn = false
    while hi < host_e {
      let b = input.code_unit_at(hi)
      if dlut[b] != 0 {
        return None
      }
      if b == 46 {
        if label_is_punycode_ascii(input, ls, hi) {
          has_xn = true
          break
        }
        ls = hi + 1
      }
      hi = hi + 1
    }
    if !has_xn && label_is_punycode_ascii(input, ls, host_e) {
      has_xn = true
    }
    if has_xn {
      return None
    }
    let last_ch = input.code_unit_at(host_e - 1)
    let maybe_num = (last_ch >= 48 && last_ch <= 57) ||
    last_ch == 46 ||
    (last_ch >= 65 && last_ch <= 70) ||
    (last_ch >= 97 && last_ch <= 102) ||
    last_ch == 120 ||
    last_ch == 88
    if maybe_num && ends_in_a_number_slice(input, host_s, host_e) {
      match parse_ipv4_slice(input, host_s, host_e) {
        Ok(ip) => {
          host_kind = HostKind::Ipv4Host
          ipv4 = ip
          // Check if the IPv4 slice is already canonical (4 decimal octets, no leading zeros)
          let mut dots = 0
          let mut ok_canon = true
          let mut part_start = host_s
          let mut ii = host_s
          while ii <= host_e {
            if ii == host_e || input.code_unit_at(ii) == 46 {
              let plen = ii - part_start
              if plen == 0 || (plen > 1 && input.code_unit_at(part_start) == 48) {
                ok_canon = false
                break
              }
              if ii < host_e {
                dots = dots + 1
              }
              part_start = ii + 1
            } else {
              let ch = input.code_unit_at(ii)
              if ch < 48 || ch > 57 {
                ok_canon = false
                break
              }
            }
            ii = ii + 1
          }
          if ok_canon && dots == 3 {
            use_direct_host = true
          }
        }
        Err(_) => return None
      }
    } else {
      use_direct_host = true
    }
  } else if !has_pct_host {
    // Non-ASCII IDN host without '%': skip input.slice AND percent_decode_str!
    match domain_to_ascii_slice(input, host_s, host_e) {
      Ok(ascii) => {
        if ascii.length() == 0 {
          return None
        }
        if ends_in_a_number(ascii) {
          match parse_ipv4(ascii) {
            Ok(ip) => {
              host_kind = HostKind::Ipv4Host
              ipv4 = ip
            }
            Err(_) => return None
          }
        } else {
          host_kind = HostKind::DomainHost
          slow_domain = ascii
        }
      }
      Err(_) => return None
    }
  } else {
    match host_parse(input.slice(host_s, host_e)) {
      Ok(Host::Domain(d)) => {
        host_kind = HostKind::DomainHost
        slow_domain = d
      }
      Ok(Host::Ipv4(ip)) => {
        host_kind = HostKind::Ipv4Host
        ipv4 = ip
      }
      Ok(Host::Ipv6(ip)) => {
        host_kind = HostKind::Ipv6Host
        ipv6 = ip
      }
      Err(_) => return None
    }
  }

  // Zero-copy fast return when input is ALREADY in exact canonical form!
  if use_direct_host &&
  !has_upper_host &&
  !port_stripped &&
  !path_has_dots &&
  !path_needs_enc &&
  !query_needs_enc &&
  !query_has_tab_nl &&
  !frag_needs_enc &&
  !frag_has_tab_nl &&
  path_e > path_s {
    let mut user_ok = true
    let mut u_end = auth_start
    if at_pos >= 0 {
      if at_pos == auth_start {
        user_ok = false
      } else {
        let mut ui = auth_start
        let mut saw_colon = false
        while ui < at_pos {
          let ch = input.code_unit_at(ui)
          if ch == 58 && !saw_colon {
            saw_colon = true
            u_end = ui
            if ui + 1 == at_pos {
              // empty password `user:@host` must drop `:`
              user_ok = false
              break
            }
          } else if (lut[ch] & mask_userinfo) != 0 {
            user_ok = false
            break
          }
          ui = ui + 1
        }
        if !saw_colon {
          u_end = at_pos
        }
      }
    }
    if user_ok {
      return Some(
        Url::{
          serialization: input,
          scheme_end: scheme_end,
          username_end: u_end,
          host_start: host_s,
          host_end: host_e,
          host_kind: host_kind,
          ipv4: ipv4,
          ipv6: ipv6,
          port_val: port_val,
          path_start: path_s,
          query_start: if query_s >= 0 { query_s - 1 } else { -1 },
          fragment_start: if frag_s >= 0 { frag_s - 1 } else { -1 },
          opaque_path: false,
        },
      )
    }
  }

  // Build final serialization in ONE StringBuilder allocation!
  let sb = StringBuilder::with_capacity(n + 16)
  sb.write_substring(input, 0, auth_start)
  let mut username_end = auth_start
  let mut host_start = auth_start
  if at_pos >= 0 {
    let mut ucolon = -1
    let mut ui = auth_start
    while ui < at_pos {
      if input.code_unit_at(ui) == 58 {
        ucolon = ui
        break
      }
      ui = ui + 1
    }
    if ucolon >= 0 {
      write_percent_encoded_slice(sb, input, auth_start, ucolon, mask_userinfo)
      username_end = sb.length()
      if ucolon + 1 < at_pos {
        sb.write_byte((58).to_byte())
        write_percent_encoded_slice(sb, input, ucolon + 1, at_pos, mask_userinfo)
      }
      if sb.length() > auth_start {
        sb.write_byte((64).to_byte())
      }
    } else if at_pos > auth_start {
      write_percent_encoded_slice(sb, input, auth_start, at_pos, mask_userinfo)
      username_end = sb.length()
      sb.write_byte((64).to_byte())
    }
    host_start = sb.length()
  }
  match host_kind {
    HostKind::DomainHost => {
      if use_direct_host {
        if !has_upper_host {
          sb.write_substring(input, host_s, host_e)
        } else {
          let mut hi = host_s
          while hi < host_e {
            sb.write_byte(to_ascii_lower(input.code_unit_at(hi)).to_byte())
            hi = hi + 1
          }
        }
      } else {
        sb.write_string(slow_domain)
      }
    }
    HostKind::Ipv4Host => write_ipv4(sb, ipv4)
    HostKind::Ipv6Host => {
      sb.write_byte((91).to_byte())
      write_ipv6(sb, ipv6)
      sb.write_byte((93).to_byte())
    }
    HostKind::NoHost => ()
  }
  let host_end = sb.length()
  if port_val >= 0 {
    sb.write_byte((58).to_byte())
    write_uint_dec(sb, port_val)
  }
  let path_start = sb.length()
  if path_e > path_s {
    if !path_has_dots {
      if path_needs_enc {
        write_percent_encoded_slice(sb, input, path_s, path_e, mask_path)
      } else {
        sb.write_substring(input, path_s, path_e)
      }
    } else {
      // Inline dot-segment resolution using FixedArray slice index stack (zero String allocs!)
      let seg_s : FixedArray[Int] = FixedArray::make(64, 0)
      let seg_e : FixedArray[Int] = FixedArray::make(64, 0)
      let mut sp = 0
      let mut pi = path_s + 1
      while pi <= path_e {
        let mut pe = pi
        while pe < path_e && input.code_unit_at(pe) != 47 {
          pe = pe + 1
        }
        let slen = pe - pi
        let is_last = pe == path_e
        if slen == 2 &&
        input.code_unit_at(pi) == 46 &&
        input.code_unit_at(pi + 1) == 46 {
          if sp > 0 {
            sp = sp - 1
          }
          if is_last {
            if sp >= 64 {
              return None
            }
            seg_s[sp] = pe
            seg_e[sp] = pe
            sp = sp + 1
          }
        } else if slen == 1 && input.code_unit_at(pi) == 46 {
          if is_last {
            if sp >= 64 {
              return None
            }
            seg_s[sp] = pe
            seg_e[sp] = pe
            sp = sp + 1
          }
        } else {
          if sp >= 64 {
            return None
          }
          seg_s[sp] = pi
          seg_e[sp] = pe
          sp = sp + 1
        }
        pi = pe + 1
      }
      let mut si = 0
      while si < sp {
        sb.write_byte((47).to_byte())
        if seg_e[si] > seg_s[si] {
          if path_needs_enc {
            write_percent_encoded_slice(sb, input, seg_s[si], seg_e[si], mask_path)
          } else {
            sb.write_substring(input, seg_s[si], seg_e[si])
          }
        }
        si = si + 1
      }
    }
  } else {
    sb.write_byte((47).to_byte())
  }
  let mut out_query_start = -1
  if query_s >= 0 {
    out_query_start = sb.length()
    sb.write_byte((63).to_byte())
    if query_has_tab_nl {
      write_percent_encoded_strip_tab_nl(sb, input, query_s, query_e, mask_special_query)
    } else if query_needs_enc {
      write_percent_encoded_slice(sb, input, query_s, query_e, mask_special_query)
    } else {
      sb.write_substring(input, query_s, query_e)
    }
  }
  let mut out_frag_start = -1
  if frag_s >= 0 {
    out_frag_start = sb.length()
    sb.write_byte((35).to_byte())
    if frag_has_tab_nl {
      write_percent_encoded_strip_tab_nl(sb, input, frag_s, n, mask_fragment)
    } else if frag_needs_enc {
      write_percent_encoded_slice(sb, input, frag_s, n, mask_fragment)
    } else {
      sb.write_substring(input, frag_s, n)
    }
  }
  Some(
    Url::{
      serialization: sb.to_string(),
      scheme_end: scheme_end,
      username_end: username_end,
      host_start: host_start,
      host_end: host_end,
      host_kind: host_kind,
      ipv4: ipv4,
      ipv6: ipv6,
      port_val: port_val,
      path_start: path_start,
      query_start: out_query_start,
      fragment_start: out_frag_start,
      opaque_path: false,
    },
  )
}

///| Single-pass fast path for `base.join(rel)` on special non-file URLs with relative path.
fn try_fast_join(base : Url, rel_in : String) -> Option[Url] {
  let raw_len = rel_in.length()
  if raw_len == 0 || base.opaque_path || !base.has_host() {
    return None
  }
  // Strictly match special non-file scheme (`http`, `https`, `ws`, `wss`, `ftp`)
  let bsc_len = base.scheme_end
  let b0 = base.serialization.code_unit_at(0)
  let is_ok_scheme = if b0 == 104 {
    if bsc_len == 4 {
      base.serialization.code_unit_at(1) == 116 &&
      base.serialization.code_unit_at(2) == 116 &&
      base.serialization.code_unit_at(3) == 112
    } else if bsc_len == 5 {
      base.serialization.code_unit_at(1) == 116 &&
      base.serialization.code_unit_at(2) == 116 &&
      base.serialization.code_unit_at(3) == 112 &&
      base.serialization.code_unit_at(4) == 115
    } else {
      false
    }
  } else if b0 == 119 {
    if bsc_len == 2 {
      base.serialization.code_unit_at(1) == 115
    } else if bsc_len == 3 {
      base.serialization.code_unit_at(1) == 115 &&
      base.serialization.code_unit_at(2) == 115
    } else {
      false
    }
  } else if b0 == 102 {
    bsc_len == 3 &&
    base.serialization.code_unit_at(1) == 116 &&
    base.serialization.code_unit_at(2) == 112
  } else {
    false
  }
  if !is_ok_scheme {
    return None
  }
  // Trim leading/trailing C0+space without allocation if already clean
  let mut r_start = 0
  let mut r_end = raw_len
  while r_start < r_end && rel_in.code_unit_at(r_start) <= 0x20 {
    r_start = r_start + 1
  }
  while r_end > r_start && rel_in.code_unit_at(r_end - 1) <= 0x20 {
    r_end = r_end - 1
  }
  if r_start >= r_end {
    return None
  }
  let rel = if r_start == 0 && r_end == raw_len {
    rel_in
  } else {
    rel_in.slice(r_start, r_end)
  }
  let rn = rel.length()
  let r0 = rel.code_unit_at(0)
  // Fast branch: scheme-relative `//...`
  if r0 == 47 && rn >= 2 && rel.code_unit_at(1) == 47 {
    let full_sb = StringBuilder::with_capacity(bsc_len + 1 + rn)
    full_sb.write_substring(base.serialization, 0, bsc_len + 1)
    full_sb.write_string(rel)
    return try_fast_parse_absolute(full_sb.to_string())
  }
  let lut = encode_lut
  // Fast branch: fragment-only `#...`
  if r0 == 35 {
    let mut scan = 1
    let mut frag_needs_enc = false
    while scan < rn {
      let ch = rel.code_unit_at(scan)
      if ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_fragment) != 0 {
        frag_needs_enc = true
      }
      scan = scan + 1
    }
    let prefix_end = if base.fragment_start >= 0 {
      base.fragment_start
    } else {
      base.serialization.length()
    }
    let sb = StringBuilder::with_capacity(prefix_end + rn + 8)
    sb.write_substring(base.serialization, 0, prefix_end)
    let out_frag_start = sb.length()
    sb.write_byte((35).to_byte())
    if frag_needs_enc {
      write_percent_encoded_slice(sb, rel, 1, rn, mask_fragment)
    } else {
      sb.write_substring(rel, 1, rn)
    }
    return Some(
      Url::{
        serialization: sb.to_string(),
        scheme_end: base.scheme_end,
        username_end: base.username_end,
        host_start: base.host_start,
        host_end: base.host_end,
        host_kind: base.host_kind,
        ipv4: base.ipv4,
        ipv6: base.ipv6,
        port_val: base.port_val,
        path_start: base.path_start,
        query_start: base.query_start,
        fragment_start: out_frag_start,
        opaque_path: false,
      },
    )
  }
  // Fast branch: query-only `?query[#frag]`
  if r0 == 63 {
    let mut scan = 1
    let mut query_needs_enc = false
    while scan < rn {
      let ch = rel.code_unit_at(scan)
      if ch == 35 {
        break
      }
      if ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_special_query) != 0 {
        query_needs_enc = true
      }
      scan = scan + 1
    }
    let query_e = scan
    let mut frag_s = -1
    let mut frag_needs_enc = false
    if scan < rn && rel.code_unit_at(scan) == 35 {
      frag_s = scan + 1
      scan = scan + 1
      while scan < rn {
        let ch = rel.code_unit_at(scan)
        if ch == 9 || ch == 10 || ch == 13 {
          return None
        }
        if (lut[ch] & mask_fragment) != 0 {
          frag_needs_enc = true
        }
        scan = scan + 1
      }
    }
    let prefix_end = if base.query_start >= 0 {
      base.query_start
    } else if base.fragment_start >= 0 {
      base.fragment_start
    } else {
      base.serialization.length()
    }
    let sb = StringBuilder::with_capacity(prefix_end + rn + 8)
    sb.write_substring(base.serialization, 0, prefix_end)
    let out_query_start = sb.length()
    sb.write_byte((63).to_byte())
    if query_needs_enc {
      write_percent_encoded_slice(sb, rel, 1, query_e, mask_special_query)
    } else {
      sb.write_substring(rel, 1, query_e)
    }
    let mut out_frag_start = -1
    if frag_s >= 0 {
      out_frag_start = sb.length()
      sb.write_byte((35).to_byte())
      if frag_needs_enc {
        write_percent_encoded_slice(sb, rel, frag_s, rn, mask_fragment)
      } else {
        sb.write_substring(rel, frag_s, rn)
      }
    }
    return Some(
      Url::{
        serialization: sb.to_string(),
        scheme_end: base.scheme_end,
        username_end: base.username_end,
        host_start: base.host_start,
        host_end: base.host_end,
        host_kind: base.host_kind,
        ipv4: base.ipv4,
        ipv6: base.ipv6,
        port_val: base.port_val,
        path_start: base.path_start,
        query_start: out_query_start,
        fragment_start: out_frag_start,
        opaque_path: false,
      },
    )
  }
  // Fast branch: root-relative `/abs/path[?q][#f]` (not `//` or `/\`)
  if r0 == 47 {
    if rn >= 2 && (rel.code_unit_at(1) == 47 || rel.code_unit_at(1) == 92) {
      return None
    }
    let mut scan = 0
    let mut path_needs_enc = false
    while scan < rn {
      let ch = rel.code_unit_at(scan)
      if ch == 63 || ch == 35 {
        break
      }
      if ch == 92 || ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_path) != 0 {
        path_needs_enc = true
      }
      if ch == 47 && scan + 1 < rn {
        let c1 = rel.code_unit_at(scan + 1)
        if c1 == 46 {
          return None
        } else if c1 == 37 && scan + 3 < rn {
          let c2 = rel.code_unit_at(scan + 2)
          let c3 = rel.code_unit_at(scan + 3)
          if c2 == 50 && (c3 == 101 || c3 == 69) {
            return None
          }
        }
      }
      scan = scan + 1
    }
    let path_e = scan
    let mut query_s = -1
    let mut query_e = -1
    let mut query_needs_enc = false
    let mut frag_s = -1
    let mut frag_needs_enc = false
    if scan < rn && rel.code_unit_at(scan) == 63 {
      query_s = scan + 1
      scan = scan + 1
      while scan < rn {
        let ch = rel.code_unit_at(scan)
        if ch == 35 {
          break
        }
        if ch == 9 || ch == 10 || ch == 13 {
          return None
        }
        if (lut[ch] & mask_special_query) != 0 {
          query_needs_enc = true
        }
        scan = scan + 1
      }
      query_e = scan
    }
    if scan < rn && rel.code_unit_at(scan) == 35 {
      frag_s = scan + 1
      scan = scan + 1
      while scan < rn {
        let ch = rel.code_unit_at(scan)
        if ch == 9 || ch == 10 || ch == 13 {
          return None
        }
        if (lut[ch] & mask_fragment) != 0 {
          frag_needs_enc = true
        }
        scan = scan + 1
      }
    }
    let sb = StringBuilder::with_capacity(base.path_start + rn + 8)
    sb.write_substring(base.serialization, 0, base.path_start)
    if path_needs_enc {
      write_percent_encoded_slice(sb, rel, 0, path_e, mask_path)
    } else {
      sb.write_substring(rel, 0, path_e)
    }
    let mut out_query_start = -1
    if query_s >= 0 {
      out_query_start = sb.length()
      sb.write_byte((63).to_byte())
      if query_needs_enc {
        write_percent_encoded_slice(sb, rel, query_s, query_e, mask_special_query)
      } else {
        sb.write_substring(rel, query_s, query_e)
      }
    }
    let mut out_frag_start = -1
    if frag_s >= 0 {
      out_frag_start = sb.length()
      sb.write_byte((35).to_byte())
      if frag_needs_enc {
        write_percent_encoded_slice(sb, rel, frag_s, rn, mask_fragment)
      } else {
        sb.write_substring(rel, frag_s, rn)
      }
    }
    return Some(
      Url::{
        serialization: sb.to_string(),
        scheme_end: base.scheme_end,
        username_end: base.username_end,
        host_start: base.host_start,
        host_end: base.host_end,
        host_kind: base.host_kind,
        ipv4: base.ipv4,
        ipv6: base.ipv6,
        port_val: base.port_val,
        path_start: base.path_start,
        query_start: out_query_start,
        fragment_start: out_frag_start,
        opaque_path: false,
      },
    )
  }
  if r0 == 92 {
    return None
  }
  // Reject if `rel` might have a scheme (`alpha... :`)
  if is_ascii_alpha(r0) {
    let mut si = 1
    while si < rn {
      let c = rel.code_unit_at(si)
      if c == 58 {
        return None
      }
      if !(is_ascii_alnum(c) || c == 43 || c == 45 || c == 46) {
        break
      }
      si = si + 1
    }
  }
  // Consume leading `../` and `./` segments (plus trailing `..` / `.`)
  let mut up_count = 0
  let mut rp = 0
  while rp < rn {
    if rp + 2 < rn &&
    rel.code_unit_at(rp) == 46 &&
    rel.code_unit_at(rp + 1) == 46 &&
    rel.code_unit_at(rp + 2) == 47 {
      up_count = up_count + 1
      rp = rp + 3
    } else if rp + 1 < rn &&
    rel.code_unit_at(rp) == 46 &&
    rel.code_unit_at(rp + 1) == 47 {
      rp = rp + 2
    } else if rp + 2 == rn &&
    rel.code_unit_at(rp) == 46 &&
    rel.code_unit_at(rp + 1) == 46 {
      up_count = up_count + 1
      rp = rn
      break
    } else if rp + 1 == rn && rel.code_unit_at(rp) == 46 {
      rp = rn
      break
    } else {
      break
    }
  }
  // Single pass over remainder: track path/query/frag boundaries AND encoding needs
  let lut = encode_lut
  let mut path_e = rp
  let mut path_needs_enc = false
  if rp < rn {
    let first_rem = rel.code_unit_at(rp)
    if first_rem == 46 || first_rem == 37 {
      return None
    }
  }
  while path_e < rn {
    let ch = rel.code_unit_at(path_e)
    if ch == 63 || ch == 35 {
      break
    }
    if ch == 92 || ch == 9 || ch == 10 || ch == 13 {
      return None
    }
    if (lut[ch] & mask_path) != 0 {
      path_needs_enc = true
    }
    if ch == 47 && path_e + 1 < rn {
      let c1 = rel.code_unit_at(path_e + 1)
      if c1 == 46 {
        return None
      } else if c1 == 37 && path_e + 3 < rn {
        let c2 = rel.code_unit_at(path_e + 2)
        let c3 = rel.code_unit_at(path_e + 3)
        if c2 == 50 && (c3 == 101 || c3 == 69) {
          return None
        }
      }
    }
    path_e = path_e + 1
  }
  let mut query_s = -1
  let mut query_e = -1
  let mut query_needs_enc = false
  let mut frag_s = -1
  let mut frag_needs_enc = false
  let mut scan = path_e
  if scan < rn && rel.code_unit_at(scan) == 63 {
    query_s = scan + 1
    scan = scan + 1
    while scan < rn {
      let ch = rel.code_unit_at(scan)
      if ch == 35 {
        break
      }
      if ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_special_query) != 0 {
        query_needs_enc = true
      }
      scan = scan + 1
    }
    query_e = scan
  }
  if scan < rn && rel.code_unit_at(scan) == 35 {
    frag_s = scan + 1
    scan = scan + 1
    while scan < rn {
      let ch = rel.code_unit_at(scan)
      if ch == 9 || ch == 10 || ch == 13 {
        return None
      }
      if (lut[ch] & mask_fragment) != 0 {
        frag_needs_enc = true
      }
      scan = scan + 1
    }
  }
  // Find directory end in `base.serialization` (remove last segment + `up_count` segments)
  let base_path_end = if base.query_start >= 0 {
    base.query_start
  } else if base.fragment_start >= 0 {
    base.fragment_start
  } else {
    base.serialization.length()
  }
  let mut dir_end = base_path_end
  while dir_end > base.path_start + 1 &&
  base.serialization.code_unit_at(dir_end - 1) != 47 {
    dir_end = dir_end - 1
  }
  let mut u = 0
  while u < up_count && dir_end > base.path_start + 1 {
    dir_end = dir_end - 1
    while dir_end > base.path_start + 1 &&
    base.serialization.code_unit_at(dir_end - 1) != 47 {
      dir_end = dir_end - 1
    }
    u = u + 1
  }
  let sb = StringBuilder::with_capacity(dir_end + (rn - rp) + 16)
  sb.write_substring(base.serialization, 0, dir_end)
  if path_e > rp {
    if path_needs_enc {
      write_percent_encoded_slice(sb, rel, rp, path_e, mask_path)
    } else {
      sb.write_substring(rel, rp, path_e)
    }
  }
  let mut out_query_start = -1
  if query_s >= 0 {
    out_query_start = sb.length()
    sb.write_byte((63).to_byte())
    if query_needs_enc {
      write_percent_encoded_slice(sb, rel, query_s, query_e, mask_special_query)
    } else {
      sb.write_substring(rel, query_s, query_e)
    }
  }
  let mut out_frag_start = -1
  if frag_s >= 0 {
    out_frag_start = sb.length()
    sb.write_byte((35).to_byte())
    if frag_needs_enc {
      write_percent_encoded_slice(sb, rel, frag_s, rn, mask_fragment)
    } else {
      sb.write_substring(rel, frag_s, rn)
    }
  }
  Some(
    Url::{
      serialization: sb.to_string(),
      scheme_end: base.scheme_end,
      username_end: base.username_end,
      host_start: base.host_start,
      host_end: base.host_end,
      host_kind: base.host_kind,
      ipv4: base.ipv4,
      ipv6: base.ipv6,
      port_val: base.port_val,
      path_start: base.path_start,
      query_start: out_query_start,
      fragment_start: out_frag_start,
      opaque_path: false,
    },
  )
}

///| Parse an absolute URL string according to the WHATWG URL Standard.
pub fn Url::parse(input : String) -> Result[Url, ParseError] {
  match try_fast_parse_absolute(input) {
    Some(u) => Ok(u)
    None => Url::parse_with_base(input, None)
  }
}

///| Parse a URL string with an optional base URL according to the WHATWG URL Standard.
pub fn Url::parse_with_base(
  input : String,
  base : Option[Url],
) -> Result[Url, ParseError] {
  match base {
    None =>
    match try_fast_parse_absolute(input) {
      Some(u) => return Ok(u)
      None => ()
    }
    Some(b) =>
    match try_fast_join(b, input) {
      Some(u) => return Ok(u)
      None => ()
    }
  }
  match basic_url_parse(input, base, None, None) {
    Ok(rec) => Ok(rec.to_url())
    Err(e) => Err(e)
  }
}

///| Parse a relative URL reference against `self` as base.
pub fn Url::join(self : Url, rel : String) -> Result[Url, ParseError] {
  match try_fast_join(self, rel) {
    Some(u) => Ok(u)
    None => Url::parse_with_base(rel, Some(self))
  }
}
