///| WHATWG URL Standard Basic URL Parser (full state machine + canonical serializer).

///| Return default port for special schemes, or -1 if none.
fn default_port_for_scheme(scheme : String) -> Int {
  if scheme == "http" || scheme == "ws" {
    80
  } else if scheme == "https" || scheme == "wss" {
    443
  } else if scheme == "ftp" {
    21
  } else {
    -1
  }
}

///| Return true if `scheme` is a WHATWG special scheme.
fn is_special_scheme(scheme : String) -> Bool {
  scheme == "http" ||
  scheme == "https" ||
  scheme == "ws" ||
  scheme == "wss" ||
  scheme == "ftp" ||
  scheme == "file"
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alnum(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

fn to_ascii_lower(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

fn is_windows_drive_letter_pair(b0 : Int, b1 : Int) -> Bool {
  is_ascii_alpha(b0) && (b1 == 58 || b1 == 124)
}

fn is_normalized_windows_drive_letter(s : String) -> Bool {
  s.length() == 2 && is_ascii_alpha(s.code_unit_at(0)) && s.code_unit_at(1) == 58
}

fn starts_with_windows_drive_letter(s : String, pos : Int, end : Int) -> Bool {
  let rem = end - pos
  if rem < 2 {
    return false
  }
  if !is_windows_drive_letter_pair(s.code_unit_at(pos), s.code_unit_at(pos + 1)) {
    return false
  }
  if rem == 2 {
    return true
  }
  let c2 = s.code_unit_at(pos + 2)
  c2 == 47 || c2 == 92 || c2 == 63 || c2 == 35
}

fn is_single_dot_segment(seg : String) -> Bool {
  let n = seg.length()
  if n == 1 {
    return seg.code_unit_at(0) == 46
  }
  if n == 3 {
    return seg.code_unit_at(0) == 37 &&
    seg.code_unit_at(1) == 50 &&
    (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69)
  }
  false
}

fn is_double_dot_segment(seg : String) -> Bool {
  let n = seg.length()
  if n == 2 {
    return seg.code_unit_at(0) == 46 && seg.code_unit_at(1) == 46
  }
  if n == 4 {
    // `.%2e` or `%2e.`
    if seg.code_unit_at(0) == 46 {
      return seg.code_unit_at(1) == 37 &&
      seg.code_unit_at(2) == 50 &&
      (seg.code_unit_at(3) == 101 || seg.code_unit_at(3) == 69)
    }
    if seg.code_unit_at(3) == 46 {
      return seg.code_unit_at(0) == 37 &&
      seg.code_unit_at(1) == 50 &&
      (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69)
    }
  }
  if n == 6 {
    // `%2e%2e`
    return seg.code_unit_at(0) == 37 &&
    seg.code_unit_at(1) == 50 &&
    (seg.code_unit_at(2) == 101 || seg.code_unit_at(2) == 69) &&
    seg.code_unit_at(3) == 37 &&
    seg.code_unit_at(4) == 50 &&
    (seg.code_unit_at(5) == 101 || seg.code_unit_at(5) == 69)
  }
  false
}

///| Strip leading/trailing C0+space (when `trim_outer` is true) and all ASCII tab/LF/CR.
fn preprocess_input(input : String, trim_outer : Bool) -> String {
  let n = input.length()
  let mut start = 0
  let mut end = n
  if trim_outer {
    while start < end && input.code_unit_at(start) <= 0x20 {
      start = start + 1
    }
    while end > start && input.code_unit_at(end - 1) <= 0x20 {
      end = end - 1
    }
  }
  // Scan for \t, \n, \r
  let mut has_tab_nl = false
  let mut i = start
  while i < end {
    let b = input.code_unit_at(i)
    if b == 9 || b == 10 || b == 13 {
      has_tab_nl = true
      break
    }
    i = i + 1
  }
  if !has_tab_nl {
    if start == 0 && end == n {
      return input
    }
    return input.slice(start, end)
  }
  let sb = StringBuilder::with_capacity(end - start)
  let mut run_start = start
  i = start
  while i < end {
    let b = input.code_unit_at(i)
    if b == 9 || b == 10 || b == 13 {
      if i > run_start {
        sb.write_substring(input, run_start, i)
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < end {
    sb.write_substring(input, run_start, end)
  }
  sb.to_string()
}

///| Internal mutable URL record used during parsing and setters before serialization.
struct UrlRecord {
  mut scheme : String
  mut username : String
  mut password : String
  mut has_host : Bool
  mut host_kind : HostKind
  mut host_domain : String
  mut host_ipv4 : Ipv4Addr
  mut host_ipv6 : Ipv6Addr
  mut port_val : Int
  mut opaque_path : Bool
  mut opaque_path_str : String
  mut path_segs : Array[String]
  mut has_query : Bool
  mut query_str : String
  mut has_fragment : Bool
  mut fragment_str : String
}

fn UrlRecord::empty() -> UrlRecord {
  UrlRecord::{
    scheme: "",
    username: "",
    password: "",
    has_host: false,
    host_kind: HostKind::NoHost,
    host_domain: "",
    host_ipv4: Ipv4Addr::from_u32(0U),
    host_ipv6: Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 0),
    port_val: -1,
    opaque_path: false,
    opaque_path_str: "",
    path_segs: [],
    has_query: false,
    query_str: "",
    has_fragment: false,
    fragment_str: "",
  }
}

fn UrlRecord::from_url(u : Url) -> UrlRecord {
  let rec = UrlRecord::empty()
  rec.scheme = u.scheme()
  rec.username = u.username()
  match u.password() {
    Some(p) => rec.password = p
    None => rec.password = ""
  }
  rec.has_host = u.has_host()
  rec.host_kind = u.host_kind
  match u.host_kind {
    HostKind::DomainHost =>
    rec.host_domain = u.serialization.slice(u.host_start, u.host_end)
    HostKind::Ipv4Host => rec.host_ipv4 = u.ipv4
    HostKind::Ipv6Host => rec.host_ipv6 = u.ipv6
    HostKind::NoHost => ()
  }
  rec.port_val = u.port_val
  rec.opaque_path = u.opaque_path
  let p = u.path()
  if u.opaque_path {
    rec.opaque_path_str = p
  } else {
    // Decode path string back into segments.
    // Note: if !has_host and serialized with "/." prefix, `u.path()` starts with "/" (Wait: `u.path()` is the serialized path WITHOUT "/."? No, in WHATWG `/.` is only in href, pathname starts with `//`? Let's check!).
    // Actually in WHATWG URL Standard:
    // URL serializer emits `/.` before `path[0]` when host is null, path is list, path.len > 1, path[0] == "".
    // And `pathname` getter serializes URL path WITHOUT `/.`! Wait: let's check WPT `non-spec:/.//p`!
    // In WPT: `non-spec:/.//p` has href=`non-spec:/.//p`, pathname=`//p`!
    // So in `Url`, if we store `path_start` pointing to the start of pathname (after `/.` if present? Wait: if href is `non-spec:/.//p`, then `serialization[path_start..]` is `/.//p` unless we handle it).
    // Let's split `p` carefully:
    if p.length() == 0 {
      rec.path_segs = []
    } else if p.code_unit_at(0) == 47 {
      // Split by '/' starting after index 0
      let segs : Array[String] = []
      let mut start = 1
      let mut i = 1
      let pn = p.length()
      while i <= pn {
        if i == pn || p.code_unit_at(i) == 47 {
          segs.push(p.slice(start, i))
          start = i + 1
        }
        i = i + 1
      }
      rec.path_segs = segs
    } else {
      rec.path_segs = [p]
    }
  }
  match u.query() {
    Some(q) => {
      rec.has_query = true
      rec.query_str = q
    }
    None => ()
  }
  match u.fragment() {
    Some(f) => {
      rec.has_fragment = true
      rec.fragment_str = f
    }
    None => ()
  }
  rec
}

fn UrlRecord::includes_credentials(self : UrlRecord) -> Bool {
  self.username.length() > 0 || self.password.length() > 0
}

fn UrlRecord::set_host_val(self : UrlRecord, h : Host) -> Unit {
  self.has_host = true
  match h {
    Host::Domain(d) => {
      self.host_kind = HostKind::DomainHost
      self.host_domain = d
    }
    Host::Ipv4(ip) => {
      self.host_kind = HostKind::Ipv4Host
      self.host_ipv4 = ip
    }
    Host::Ipv6(ip) => {
      self.host_kind = HostKind::Ipv6Host
      self.host_ipv6 = ip
    }
  }
}

fn UrlRecord::clear_host(self : UrlRecord) -> Unit {
  self.has_host = false
  self.host_kind = HostKind::NoHost
  self.host_domain = ""
}

fn UrlRecord::shorten_path(self : UrlRecord) -> Unit {
  let len = self.path_segs.length()
  if len == 0 {
    return ()
  }
  if self.scheme == "file" &&
  len == 1 &&
  is_normalized_windows_drive_letter(self.path_segs[0]) {
    return ()
  }
  let _ = self.path_segs.pop()
}

///| Serialize a `UrlRecord` into a canonical `Url` with exact byte offsets.
fn UrlRecord::to_url(self : UrlRecord) -> Url {
  let est = self.scheme.length() +
  self.username.length() +
  self.password.length() +
  self.host_domain.length() +
  self.opaque_path_str.length() +
  self.query_str.length() +
  self.fragment_str.length() +
  32
  let sb = StringBuilder::with_capacity(est)
  sb.write_string(self.scheme)
  let scheme_end = self.scheme.length()
  sb.write_byte((58).to_byte()) // ':'
  let mut username_end = scheme_end + 1
  let mut host_start = scheme_end + 1
  let mut host_end = scheme_end + 1
  if self.has_host {
    sb.write_string("//")
    if self.includes_credentials() {
      sb.write_string(self.username)
      username_end = sb.length()
      if self.password.length() > 0 {
        sb.write_byte((58).to_byte())
        sb.write_string(self.password)
      }
      sb.write_byte((64).to_byte()) // '@'
      host_start = sb.length()
    } else {
      username_end = sb.length()
      host_start = sb.length()
    }
    match self.host_kind {
      HostKind::DomainHost => sb.write_string(self.host_domain)
      HostKind::Ipv4Host => sb.write_string(self.host_ipv4.to_string())
      HostKind::Ipv6Host => {
        sb.write_byte((91).to_byte())
        write_ipv6(sb, self.host_ipv6)
        sb.write_byte((93).to_byte())
      }
      HostKind::NoHost => ()
    }
    host_end = sb.length()
    if self.port_val >= 0 {
      sb.write_byte((58).to_byte())
      sb.write_string(self.port_val.to_string())
    }
  } else if !self.opaque_path &&
  self.path_segs.length() > 1 &&
  self.path_segs[0].length() == 0 {
    // WHATWG URL Serializer §4.5: if host is null, path is list, path.len > 1, path[0] == "",
    // append "/." to avoid ambiguity with authority "//"
    sb.write_string("/.")
  }
  let path_start = sb.length()
  if self.opaque_path {
    sb.write_string(self.opaque_path_str)
  } else {
    let plen = self.path_segs.length()
    let mut i = 0
    while i < plen {
      sb.write_byte((47).to_byte())
      sb.write_string(self.path_segs[i])
      i = i + 1
    }
  }
  let mut query_start = -1
  if self.has_query {
    query_start = sb.length()
    sb.write_byte((63).to_byte())
    sb.write_string(self.query_str)
  }
  let mut fragment_start = -1
  if self.has_fragment {
    fragment_start = sb.length()
    sb.write_byte((35).to_byte())
    sb.write_string(self.fragment_str)
  }
  Url::{
    serialization: sb.to_string(),
    scheme_end: scheme_end,
    username_end: username_end,
    host_start: host_start,
    host_end: host_end,
    host_kind: self.host_kind,
    ipv4: self.host_ipv4,
    ipv6: self.host_ipv6,
    port_val: self.port_val,
    path_start: path_start,
    query_start: query_start,
    fragment_start: fragment_start,
    opaque_path: self.opaque_path,
  }
}

///| Parser state enum matching WHATWG URL Standard §4.3.
enum ParseState {
  SchemeStart
  Scheme
  NoScheme
  SpecialRelativeOrAuthority
  PathOrAuthority
  Relative
  RelativeSlash
  SpecialAuthoritySlashes
  SpecialAuthorityIgnoreSlashes
  Authority
  Host
  Hostname
  Port
  File
  FileSlash
  FileHost
  PathStart
  Path
  OpaquePath
  Query
  Fragment
}

///| Basic URL Parser (WHATWG URL Standard §4.3).
fn basic_url_parse(
  raw_input : String,
  base : Option[Url],
  existing : Option[UrlRecord],
  state_override : Option[ParseState],
) -> Result[UrlRecord, ParseError] {
  let has_override = match state_override {
    Some(_) => true
    None => false
  }
  let input = preprocess_input(raw_input, !has_override)
  let n = input.length()
  let url = match existing {
    Some(r) => r
    None => UrlRecord::empty()
  }
  let base_rec : Option[UrlRecord] = match base {
    Some(b) => Some(UrlRecord::from_url(b))
    None => None
  }
  let mut state = match state_override {
    Some(st) => st
    None => ParseState::SchemeStart
  }
  let mut buf = StringBuilder::with_capacity(32)
  let mut at_sign_seen = false
  let mut inside_brackets = false
  let mut password_token_seen = false
  let mut ptr = 0

  while ptr <= n {
    let is_eof = ptr == n
    let c = if is_eof { -1 } else { input.code_unit_at(ptr) }
    match state {
      ParseState::SchemeStart => {
        if !is_eof && is_ascii_alpha(c) {
          buf.write_byte(to_ascii_lower(c).to_byte())
          state = ParseState::Scheme
        } else if !has_override {
          state = ParseState::NoScheme
          continue // reprocess without advancing ptr
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme start"))
        }
      }
      ParseState::Scheme => {
        if !is_eof &&
        (is_ascii_alnum(c) || c == 43 || c == 45 || c == 46) {
          buf.write_byte(to_ascii_lower(c).to_byte())
        } else if c == 58 {
          // ':'
          let new_scheme = buf.to_string()
          if has_override {
            let old_special = is_special_scheme(url.scheme)
            let new_special = is_special_scheme(new_scheme)
            if old_special && !new_special {
              return Ok(url)
            }
            if !old_special && new_special {
              return Ok(url)
            }
            if (url.includes_credentials() || url.port_val >= 0) &&
            new_scheme == "file" {
              return Ok(url)
            }
            if url.scheme == "file" &&
            (!url.has_host ||
              (match url.host_kind {
                HostKind::DomainHost => url.host_domain.length() == 0
                _ => false
            })) {
              return Ok(url)
            }
          }
          url.scheme = new_scheme
          if has_override {
            if url.port_val >= 0 &&
            url.port_val == default_port_for_scheme(url.scheme) {
              url.port_val = -1
            }
            return Ok(url)
          }
          buf = StringBuilder::with_capacity(32)
          if url.scheme == "file" {
            state = ParseState::File
          } else if is_special_scheme(url.scheme) {
            let same_base_scheme = match base_rec {
              Some(b) => b.scheme == url.scheme
              None => false
            }
            if same_base_scheme {
              state = ParseState::SpecialRelativeOrAuthority
            } else {
              state = ParseState::SpecialAuthoritySlashes
            }
          } else if ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
            state = ParseState::PathOrAuthority
            ptr = ptr + 1
          } else {
            url.opaque_path = true
            url.opaque_path_str = ""
            url.path_segs = []
            state = ParseState::OpaquePath
          }
        } else if !has_override {
          buf = StringBuilder::with_capacity(32)
          state = ParseState::NoScheme
          ptr = 0
          continue
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidScheme, "invalid scheme"))
        }
      }
      ParseState::NoScheme => {
        match base_rec {
          None =>
          return Err(
            ParseError::new(
              ParseErrorKind::RelativeUrlWithoutBase,
              "relative URL without a base",
            ),
          )
          Some(b) => {
            if b.opaque_path && c != 35 {
              return Err(
                ParseError::new(
                  ParseErrorKind::RelativeUrlWithCannotBeABaseBase,
                  "relative URL with cannot-be-a-base base",
                ),
              )
            } else if b.opaque_path && c == 35 {
              url.scheme = b.scheme
              url.opaque_path = true
              url.opaque_path_str = b.opaque_path_str
              url.has_query = b.has_query
              url.query_str = b.query_str
              url.has_fragment = true
              url.fragment_str = ""
              state = ParseState::Fragment
            } else if b.scheme != "file" {
              state = ParseState::Relative
              continue
            } else {
              state = ParseState::File
              continue
            }
          }
        }
      }
      ParseState::SpecialRelativeOrAuthority => {
        if c == 47 && ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          ptr = ptr + 1
        } else {
          state = ParseState::Relative
          continue
        }
      }
      ParseState::PathOrAuthority => {
        if c == 47 {
          state = ParseState::Authority
        } else {
          state = ParseState::Path
          continue
        }
      }
      ParseState::Relative => {
        let b = match base_rec {
          Some(v) => v
          None =>
          return Err(
            ParseError::new(
              ParseErrorKind::RelativeUrlWithoutBase,
              "missing base",
            ),
          )
        }
        url.scheme = b.scheme
        if c == 47 {
          state = ParseState::RelativeSlash
        } else if is_special_scheme(url.scheme) && c == 92 {
          state = ParseState::RelativeSlash
        } else {
          url.username = b.username
          url.password = b.password
          url.has_host = b.has_host
          url.host_kind = b.host_kind
          url.host_domain = b.host_domain
          url.host_ipv4 = b.host_ipv4
          url.host_ipv6 = b.host_ipv6
          url.port_val = b.port_val
          url.opaque_path = false
          url.path_segs = copy_str_array(b.path_segs)
          url.has_query = b.has_query
          url.query_str = b.query_str
          if c == 63 {
            url.has_query = true
            url.query_str = ""
            state = ParseState::Query
          } else if c == 35 {
            url.has_fragment = true
            url.fragment_str = ""
            state = ParseState::Fragment
          } else if !is_eof {
            url.has_query = false
            url.query_str = ""
            url.shorten_path()
            state = ParseState::Path
            continue
          }
        }
      }
      ParseState::RelativeSlash => {
        if is_special_scheme(url.scheme) && (c == 47 || c == 92) {
          state = ParseState::SpecialAuthorityIgnoreSlashes
        } else if c == 47 {
          state = ParseState::Authority
        } else {
          let b = match base_rec {
            Some(v) => v
            None =>
            return Err(
              ParseError::new(
                ParseErrorKind::RelativeUrlWithoutBase,
                "missing base",
              ),
            )
          }
          url.username = b.username
          url.password = b.password
          url.has_host = b.has_host
          url.host_kind = b.host_kind
          url.host_domain = b.host_domain
          url.host_ipv4 = b.host_ipv4
          url.host_ipv6 = b.host_ipv6
          url.port_val = b.port_val
          state = ParseState::Path
          continue
        }
      }
      ParseState::SpecialAuthoritySlashes => {
        if c == 47 && ptr + 1 < n && input.code_unit_at(ptr + 1) == 47 {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          ptr = ptr + 1
        } else {
          state = ParseState::SpecialAuthorityIgnoreSlashes
          continue
        }
      }
      ParseState::SpecialAuthorityIgnoreSlashes => {
        if c != 47 && c != 92 {
          state = ParseState::Authority
          continue
        }
      }
      ParseState::Authority => {
        if c == 64 {
          // '@'
          if at_sign_seen {
            // prepend "%40" to buffer (rare path: multiple '@')
            let prev = buf.to_string()
            buf = StringBuilder::with_capacity(prev.length() + 4)
            buf.write_string("%40")
            buf.write_string(prev)
          }
          at_sign_seen = true
          let bstr = buf.to_string()
          let bn = bstr.length()
          let mut bi = 0
          let u_sb = StringBuilder::with_capacity(url.username.length() + bn)
          u_sb.write_string(url.username)
          let p_sb = StringBuilder::with_capacity(url.password.length() + bn)
          p_sb.write_string(url.password)
          while bi < bn {
            let ch = bstr.code_unit_at(bi)
            if ch == 58 && !password_token_seen {
              password_token_seen = true
              bi = bi + 1
              continue
            }
            if password_token_seen {
              if (encode_lut[ch] & mask_userinfo) != 0 {
                write_pct_byte(p_sb, ch)
              } else {
                p_sb.write_byte(ch.to_byte())
              }
            } else {
              if (encode_lut[ch] & mask_userinfo) != 0 {
                write_pct_byte(u_sb, ch)
              } else {
                u_sb.write_byte(ch.to_byte())
              }
            }
            bi = bi + 1
          }
          url.username = u_sb.to_string()
          url.password = p_sb.to_string()
          buf = StringBuilder::with_capacity(32)
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) {
          if at_sign_seen && buf.length() == 0 {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host after @"))
          }
          // Rewind ptr by buf.length() + 1 (we use linear scan instead of O(n^2)!)
          // Actually since ptr only moves back over the current non-'@' host buffer once,
          // total work across the entire authority is strictly O(N)!
          ptr = ptr - buf.length()
          buf = StringBuilder::with_capacity(32)
          state = ParseState::Host
          continue
        } else {
          // Fast-scan authority chunk up to next '@', '/', '?', '#', or '\'
          let chunk_start = ptr
          let special = is_special_scheme(url.scheme)
          let mut j = ptr + 1
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 64 || ch == 47 || ch == 63 || ch == 35 || (special && ch == 92) {
              break
            }
            j = j + 1
          }
          buf.write_substring(input, chunk_start, j)
          ptr = j
          continue
        }
      }
      ParseState::Host | ParseState::Hostname => {
        if has_override && url.scheme == "file" {
          state = ParseState::FileHost
          continue
        }
        let is_hostname_state = match state {
          ParseState::Hostname => true
          _ => false
        }
        if c == 58 && !inside_brackets {
          let bstr = buf.to_string()
          if bstr.length() == 0 {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host before colon"))
          }
          if is_hostname_state {
            return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "colon in hostname"))
          }
          let h = if is_special_scheme(url.scheme) {
            match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          } else {
            match host_parse_opaque(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          }
          url.set_host_val(h)
          buf = StringBuilder::with_capacity(16)
          state = ParseState::Port
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) {
          let bstr = buf.to_string()
          if is_special_scheme(url.scheme) && bstr.length() == 0 {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host"))
          }
          if has_override &&
          bstr.length() == 0 &&
          (url.includes_credentials() || url.port_val >= 0) {
            return Err(ParseError::new(ParseErrorKind::EmptyHost, "cannot clear host with credentials or port"))
          }
          let h = if is_special_scheme(url.scheme) {
            match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          } else {
            match host_parse_opaque(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          }
          url.set_host_val(h)
          buf = StringBuilder::with_capacity(32)
          state = ParseState::PathStart
          if has_override {
            return Ok(url)
          }
          continue
        } else {
          if c == 91 {
            inside_brackets = true
          } else if c == 93 {
            inside_brackets = false
          }
          buf.write_byte(c.to_byte())
        }
      }
      ParseState::Port => {
        if !is_eof && is_ascii_digit(c) {
          buf.write_byte(c.to_byte())
        } else if is_eof ||
        c == 47 ||
        c == 63 ||
        c == 35 ||
        (is_special_scheme(url.scheme) && c == 92) ||
        has_override {
          let bstr = buf.to_string()
          if bstr.length() > 0 {
            let mut port_num = 0
            let mut pi = 0
            let pn = bstr.length()
            while pi < pn {
              port_num = port_num * 10 + (bstr.code_unit_at(pi) - 48)
              if port_num > 65535 {
                return Err(ParseError::new(ParseErrorKind::InvalidPort, "port > 65535"))
              }
              pi = pi + 1
            }
            if port_num == default_port_for_scheme(url.scheme) {
              url.port_val = -1
            } else {
              url.port_val = port_num
            }
            buf = StringBuilder::with_capacity(32)
            if has_override {
              return Ok(url)
            }
          }
          if has_override {
            match state_override {
              Some(ParseState::Host) => return Ok(url)
              _ => return Err(ParseError::new(ParseErrorKind::InvalidPort, "invalid port in override"))
            }
          }
          state = ParseState::PathStart
          continue
        } else {
          return Err(ParseError::new(ParseErrorKind::InvalidPort, "non-digit in port"))
        }
      }
      ParseState::File => {
        url.scheme = "file"
        url.set_host_val(Host::Domain(""))
        if c == 47 || c == 92 {
          state = ParseState::FileSlash
        } else {
          match base_rec {
            Some(b) => {
              if b.scheme == "file" {
                url.has_host = b.has_host
                url.host_kind = b.host_kind
                url.host_domain = b.host_domain
                url.host_ipv4 = b.host_ipv4
                url.host_ipv6 = b.host_ipv6
                url.opaque_path = false
                url.path_segs = copy_str_array(b.path_segs)
                url.has_query = b.has_query
                url.query_str = b.query_str
                if c == 63 {
                  url.has_query = true
                  url.query_str = ""
                  state = ParseState::Query
                } else if c == 35 {
                  url.has_fragment = true
                  url.fragment_str = ""
                  state = ParseState::Fragment
                } else if !is_eof {
                  url.has_query = false
                  url.query_str = ""
                  if !starts_with_windows_drive_letter(input, ptr, n) {
                    url.shorten_path()
                  } else {
                    url.path_segs = []
                  }
                  state = ParseState::Path
                  continue
                }
              } else {
                state = ParseState::Path
                continue
              }
            }
            None => {
              state = ParseState::Path
              continue
            }
          }
        }
      }
      ParseState::FileSlash => {
        if c == 47 || c == 92 {
          state = ParseState::FileHost
        } else {
          match base_rec {
            Some(b) => {
              if b.scheme == "file" {
                url.has_host = b.has_host
                url.host_kind = b.host_kind
                url.host_domain = b.host_domain
                url.host_ipv4 = b.host_ipv4
                url.host_ipv6 = b.host_ipv6
                if !starts_with_windows_drive_letter(input, ptr, n) &&
                b.path_segs.length() > 0 &&
                is_normalized_windows_drive_letter(b.path_segs[0]) {
                  url.path_segs.push(b.path_segs[0])
                }
              }
            }
            None => ()
          }
          state = ParseState::Path
          continue
        }
      }
      ParseState::FileHost => {
        if is_eof || c == 47 || c == 92 || c == 63 || c == 35 {
          let bstr = buf.to_string()
          let blen = bstr.length()
          if !has_override &&
          blen == 2 &&
          is_windows_drive_letter_pair(bstr.code_unit_at(0), bstr.code_unit_at(1)) {
            state = ParseState::Path
            continue
          } else if blen == 0 {
            url.set_host_val(Host::Domain(""))
            if has_override {
              return Ok(url)
            }
            state = ParseState::PathStart
            continue
          } else {
            let h = match host_parse(bstr) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            match h {
              Host::Domain(d) => {
                if d == "localhost" {
                  url.set_host_val(Host::Domain(""))
                } else {
                  url.set_host_val(Host::Domain(d))
                }
              }
              _ => url.set_host_val(h)
            }
            if has_override {
              return Ok(url)
            }
            buf = StringBuilder::with_capacity(32)
            state = ParseState::PathStart
            continue
          }
        } else {
          buf.write_byte(c.to_byte())
        }
      }
      ParseState::PathStart => {
        if is_special_scheme(url.scheme) {
          state = ParseState::Path
          if c != 47 && c != 92 {
            continue
          }
        } else if !has_override && c == 63 {
          url.has_query = true
          url.query_str = ""
          state = ParseState::Query
        } else if !has_override && c == 35 {
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else if !is_eof {
          state = ParseState::Path
          if c != 47 {
            continue
          }
        } else if has_override && !url.has_host {
          url.path_segs.push("")
        }
      }
      ParseState::Path => {
        let special = is_special_scheme(url.scheme)
        if is_eof ||
        c == 47 ||
        (special && c == 92) ||
        (!has_override && (c == 63 || c == 35)) {
          let seg = buf.to_string()
          if is_double_dot_segment(seg) {
            url.shorten_path()
            if c != 47 && !(special && c == 92) {
              url.path_segs.push("")
            }
          } else if is_single_dot_segment(seg) &&
          c != 47 &&
          !(special && c == 92) {
            url.path_segs.push("")
          } else if !is_single_dot_segment(seg) {
            let final_seg = if url.scheme == "file" &&
            url.path_segs.length() == 0 &&
            seg.length() == 2 &&
            is_ascii_alpha(seg.code_unit_at(0)) &&
            seg.code_unit_at(1) == 124 {
              let dsb = StringBuilder::with_capacity(2)
              dsb.write_byte(seg.code_unit_at(0).to_byte())
              dsb.write_byte((58).to_byte())
              dsb.to_string()
            } else {
              seg
            }
            url.path_segs.push(final_seg)
          }
          buf = StringBuilder::with_capacity(32)
          if !has_override && c == 63 {
            url.has_query = true
            url.query_str = ""
            state = ParseState::Query
          } else if !has_override && c == 35 {
            url.has_fragment = true
            url.fragment_str = ""
            state = ParseState::Fragment
          }
        } else {
          // Fast-scan path segment run up to next delimiter
          let chunk_start = ptr
          let mut j = ptr
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 47 ||
            (special && ch == 92) ||
            (!has_override && (ch == 63 || ch == 35)) {
              break
            }
            j = j + 1
          }
          write_percent_encoded_slice(buf, input, chunk_start, j, mask_path)
          ptr = j
          continue
        }
      }
      ParseState::OpaquePath => {
        if c == 63 {
          let olen = url.opaque_path_str.length()
          if olen > 0 && url.opaque_path_str.code_unit_at(olen - 1) == 32 {
            url.opaque_path_str = url.opaque_path_str.slice(0, olen - 1) + "%20"
          }
          url.has_query = true
          url.query_str = ""
          state = ParseState::Query
        } else if c == 35 {
          let olen = url.opaque_path_str.length()
          if olen > 0 && url.opaque_path_str.code_unit_at(olen - 1) == 32 {
            url.opaque_path_str = url.opaque_path_str.slice(0, olen - 1) + "%20"
          }
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else if !is_eof {
          let chunk_start = ptr
          let mut j = ptr
          while j < n {
            let ch = input.code_unit_at(j)
            if ch == 63 || ch == 35 {
              break
            }
            j = j + 1
          }
          let osb = StringBuilder::with_capacity(
            url.opaque_path_str.length() + (j - chunk_start) + 8,
          )
          osb.write_string(url.opaque_path_str)
          write_percent_encoded_slice(osb, input, chunk_start, j, mask_controls)
          url.opaque_path_str = osb.to_string()
          ptr = j
          continue
        }
      }
      ParseState::Query => {
        let qmask = if is_special_scheme(url.scheme) {
          mask_special_query
        } else {
          mask_query
        }
        if is_eof {
          break
        }
        if !has_override && c == 35 {
          url.has_fragment = true
          url.fragment_str = ""
          state = ParseState::Fragment
        } else {
          let chunk_start = ptr
          let mut j = ptr
          if !has_override {
            while j < n && input.code_unit_at(j) != 35 {
              j = j + 1
            }
          } else {
            j = n
          }
          let qsb = StringBuilder::with_capacity(j - chunk_start + 8)
          write_percent_encoded_slice(qsb, input, chunk_start, j, qmask)
          url.query_str = qsb.to_string()
          ptr = j
          continue
        }
      }
      ParseState::Fragment => {
        if !is_eof {
          let fsb = StringBuilder::with_capacity(n - ptr + 8)
          write_percent_encoded_slice(fsb, input, ptr, n, mask_fragment)
          url.fragment_str = fsb.to_string()
          ptr = n
          continue
        }
      }
    }
    ptr = ptr + 1
  }
  Ok(url)
}

fn copy_str_array(src : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Parse an absolute URL string according to the WHATWG URL Standard.
pub fn Url::parse(input : String) -> Result[Url, ParseError] {
  Url::parse_with_base(input, None)
}

///| Parse a URL string with an optional base URL according to the WHATWG URL Standard.
pub fn Url::parse_with_base(
  input : String,
  base : Option[Url],
) -> Result[Url, ParseError] {
  match basic_url_parse(input, base, None, None) {
    Ok(rec) => Ok(rec.to_url())
    Err(e) => Err(e)
  }
}

///| Parse a relative URL reference against `self` as base.
pub fn Url::join(self : Url, rel : String) -> Result[Url, ParseError] {
  Url::parse_with_base(rel, Some(self))
}
