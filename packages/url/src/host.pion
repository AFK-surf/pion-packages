///| Host, IPv4, and IPv6 parsing and canonical serialization per WHATWG URL Standard §3.

///| Write a non-negative integer (0..65535) in decimal directly into `sb` (zero alloc).
fn write_uint_dec(sb : StringBuilder, n : Int) -> Unit {
  if n < 10 {
    sb.write_byte((48 + n).to_byte())
  } else if n < 100 {
    sb.write_byte((48 + n / 10).to_byte())
    sb.write_byte((48 + n % 10).to_byte())
  } else if n < 1000 {
    sb.write_byte((48 + n / 100).to_byte())
    sb.write_byte((48 + (n / 10) % 10).to_byte())
    sb.write_byte((48 + n % 10).to_byte())
  } else if n < 10000 {
    sb.write_byte((48 + n / 1000).to_byte())
    sb.write_byte((48 + (n / 100) % 10).to_byte())
    sb.write_byte((48 + (n / 10) % 10).to_byte())
    sb.write_byte((48 + n % 10).to_byte())
  } else {
    sb.write_byte((48 + n / 10000).to_byte())
    sb.write_byte((48 + (n / 1000) % 10).to_byte())
    sb.write_byte((48 + (n / 100) % 10).to_byte())
    sb.write_byte((48 + (n / 10) % 10).to_byte())
    sb.write_byte((48 + n % 10).to_byte())
  }
}

///| Write an IPv4 address directly into `sb` (zero heap allocation).
fn write_ipv4(sb : StringBuilder, ip : Ipv4Addr) -> Unit {
  let bits = ip.bits
  write_uint_dec(sb, ((bits >> 24) & 0xFFU).to_int())
  sb.write_byte((46).to_byte())
  write_uint_dec(sb, ((bits >> 16) & 0xFFU).to_int())
  sb.write_byte((46).to_byte())
  write_uint_dec(sb, ((bits >> 8) & 0xFFU).to_int())
  sb.write_byte((46).to_byte())
  write_uint_dec(sb, (bits & 0xFFU).to_int())
}

pub fn ipv6_seg(ip : Ipv6Addr, idx : Int) -> Int {
  if idx == 0 {
    ip.s0
  } else if idx == 1 {
    ip.s1
  } else if idx == 2 {
    ip.s2
  } else if idx == 3 {
    ip.s3
  } else if idx == 4 {
    ip.s4
  } else if idx == 5 {
    ip.s5
  } else if idx == 6 {
    ip.s6
  } else {
    ip.s7
  }
}

///| Write an IPv6 address in RFC 5952 / WHATWG canonical form (without brackets, zero alloc).
fn write_ipv6(sb : StringBuilder, ip : Ipv6Addr) -> Unit {
  let mut best_start = -1
  let mut best_len = 1
  let mut cur_start = -1
  let mut i = 0
  while i < 8 {
    if ipv6_seg(ip, i) == 0 {
      if cur_start < 0 {
        cur_start = i
      }
    } else if cur_start >= 0 {
      let len = i - cur_start
      if len > best_len {
        best_start = cur_start
        best_len = len
      }
      cur_start = -1
    }
    i = i + 1
  }
  if cur_start >= 0 {
    let len = 8 - cur_start
    if len > best_len {
      best_start = cur_start
      best_len = len
    }
  }
  let compress_start = best_start
  let compress_end = if best_start >= 0 { best_start + best_len } else { -1 }
  let hex_lower = "0123456789abcdef"
  i = 0
  while i < 8 {
    if i == compress_start {
      sb.write_byte((58).to_byte())
      if i == 0 {
        sb.write_byte((58).to_byte())
      }
      if compress_end < 8 {
        i = compress_end
      } else {
        break
      }
    }
    let v = ipv6_seg(ip, i)
    if v == 0 {
      sb.write_byte((48).to_byte())
    } else {
      let mut started = false
      let mut shift = 12
      while shift >= 0 {
        let nib = (v >> shift) & 0xF
        if nib != 0 || started {
          sb.write_byte(hex_lower.code_unit_at(nib).to_byte())
          started = true
        }
        shift = shift - 4
      }
    }
    if i < 7 {
      sb.write_byte((58).to_byte())
    }
    i = i + 1
  }
}

///| Parse a single IPv4 number part (`s[start..end]`) in decimal, octal (`0...`), or hex (`0x...`).
///| Returns `(value_or_minus1, ok)`. Strictly rejects overflow > 0xFFFFFFFF.
fn parse_ipv4_number(s : String, start : Int, end : Int) -> (Int64, Bool) {
  if start >= end {
    return (-1L, false)
  }
  let mut p = start
  let mut radix = 10L
  let len = end - start
  if len >= 2 && s.code_unit_at(p) == 48 {
    let c1 = s.code_unit_at(p + 1)
    if c1 == 120 || c1 == 88 {
      radix = 16L
      p = p + 2
      if p == end {
        return (0L, true)
      }
    } else {
      radix = 8L
      p = p + 1
    }
  }
  let mut num = 0L
  while p < end {
    let b = s.code_unit_at(p)
    let d : Int64 = if b >= 48 && b <= 57 {
      (b - 48).to_int64()
    } else if radix == 16L && b >= 65 && b <= 70 {
      (b - 55).to_int64()
    } else if radix == 16L && b >= 97 && b <= 102 {
      (b - 87).to_int64()
    } else {
      return (-1L, false)
    }
    if d >= radix {
      return (-1L, false)
    }
    num = num * radix + d
    if num > 0xFFFFFFFFL {
      return (-1L, false)
    }
    p = p + 1
  }
  (num, true)
}

///| WHATWG `ends in a number` checker on slice `s[s_start..s_end]` (zero alloc).
fn ends_in_a_number_slice(s : String, s_start : Int, s_end : Int) -> Bool {
  if s_start >= s_end {
    return false
  }
  let mut end = s_end
  if s.code_unit_at(end - 1) == 46 {
    end = end - 1
    if end <= s_start {
      return false
    }
  }
  let mut start = end
  while start > s_start && s.code_unit_at(start - 1) != 46 {
    start = start - 1
  }
  if start == end {
    return false
  }
  let mut all_digits = true
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      all_digits = false
      break
    }
    i = i + 1
  }
  if all_digits {
    return true
  }
  if end - start >= 2 && s.code_unit_at(start) == 48 {
    let c1 = s.code_unit_at(start + 1)
    if c1 == 120 || c1 == 88 {
      i = start + 2
      while i < end {
        if hex_val(s.code_unit_at(i)) < 0 {
          return false
        }
        i = i + 1
      }
      return true
    }
  }
  false
}

///| WHATWG `ends in a number` checker for IPv4 detection.
fn ends_in_a_number(domain : String) -> Bool {
  ends_in_a_number_slice(domain, 0, domain.length())
}

///| WHATWG IPv4 parser on slice `input[s_start..s_end]` (zero alloc).
fn parse_ipv4_slice(
  input : String,
  s_start : Int,
  s_end : Int,
) -> Result[Ipv4Addr, ParseError] {
  if s_start >= s_end {
    return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "empty IPv4"))
  }
  let mut end = s_end
  if input.code_unit_at(end - 1) == 46 {
    end = end - 1
    if end <= s_start {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "dot-only IPv4"))
    }
  }
  let mut n0 = 0L
  let mut n1 = 0L
  let mut n2 = 0L
  let mut n3 = 0L
  let mut count = 0
  let mut start = s_start
  let mut i = s_start
  while i <= end {
    if i == end || input.code_unit_at(i) == 46 {
      if count >= 4 {
        return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "too many IPv4 parts"))
      }
      let (v, ok) = parse_ipv4_number(input, start, i)
      if !ok {
        return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "invalid IPv4 part"))
      }
      if count == 0 {
        n0 = v
      } else if count == 1 {
        n1 = v
      } else if count == 2 {
        n2 = v
      } else {
        n3 = v
      }
      count = count + 1
      start = i + 1
    }
    i = i + 1
  }
  if count == 1 {
    if n0 > 0xFFFFFFFFL {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "IPv4 overflow"))
    }
    return Ok(
      Ipv4Addr::new(
        ((n0 >> 24L) & 0xFFL).to_int(),
        ((n0 >> 16L) & 0xFFL).to_int(),
        ((n0 >> 8L) & 0xFFL).to_int(),
        (n0 & 0xFFL).to_int(),
      ),
    )
  } else if count == 2 {
    if n0 > 255L || n1 > 0xFFFFFFL {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "IPv4 overflow"))
    }
    let addr = (n0 << 24L) + n1
    return Ok(
      Ipv4Addr::new(
        ((addr >> 24L) & 0xFFL).to_int(),
        ((addr >> 16L) & 0xFFL).to_int(),
        ((addr >> 8L) & 0xFFL).to_int(),
        (addr & 0xFFL).to_int(),
      ),
    )
  } else if count == 3 {
    if n0 > 255L || n1 > 255L || n2 > 0xFFFFL {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "IPv4 overflow"))
    }
    let addr = (n0 << 24L) + (n1 << 16L) + n2
    return Ok(
      Ipv4Addr::new(
        ((addr >> 24L) & 0xFFL).to_int(),
        ((addr >> 16L) & 0xFFL).to_int(),
        ((addr >> 8L) & 0xFFL).to_int(),
        (addr & 0xFFL).to_int(),
      ),
    )
  } else if count == 4 {
    if n0 > 255L || n1 > 255L || n2 > 255L || n3 > 255L {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "IPv4 overflow"))
    }
    return Ok(Ipv4Addr::new(n0.to_int(), n1.to_int(), n2.to_int(), n3.to_int()))
  }
  Err(ParseError::new(ParseErrorKind::InvalidIpv4Address, "empty IPv4"))
}

///| WHATWG IPv4 parser (1..4 parts, optional single trailing dot, dec/oct/hex).
fn parse_ipv4(input : String) -> Result[Ipv4Addr, ParseError] {
  parse_ipv4_slice(input, 0, input.length())
}

///| WHATWG IPv6 parser (`input[start..end]`, without enclosing `[` and `]`).
fn parse_ipv6_slice(
  input : String,
  start : Int,
  end : Int,
) -> Result[Ipv6Addr, ParseError] {
  let err_v6 = ParseError::new(ParseErrorKind::InvalidIpv6Address, "invalid IPv6 address")
  if start >= end {
    return Err(err_v6)
  }
  let pieces : FixedArray[Int] = FixedArray::make(8, 0)
  let mut piece_idx = 0
  let mut compress = -1
  let mut i = start
  if input.code_unit_at(i) == 58 {
    if i + 1 >= end || input.code_unit_at(i + 1) != 58 {
      return Err(err_v6)
    }
    i = i + 2
    piece_idx = 1
    compress = 1
  }
  while i < end {
    if piece_idx == 8 {
      return Err(err_v6)
    }
    if input.code_unit_at(i) == 58 {
      if compress >= 0 {
        return Err(err_v6)
      }
      i = i + 1
      piece_idx = piece_idx + 1
      compress = piece_idx
      continue
    }
    let mut seg_val = 0
    let mut len = 0
    let piece_start = i
    while len < 4 && i < end {
      let hv = hex_val(input.code_unit_at(i))
      if hv < 0 {
        break
      }
      seg_val = (seg_val << 4) | hv
      i = i + 1
      len = len + 1
    }
    if i < end && input.code_unit_at(i) == 46 {
      if len == 0 {
        return Err(err_v6)
      }
      if piece_idx > 6 {
        return Err(err_v6)
      }
      i = piece_start
      let mut numbers_seen = 0
      while i < end {
        let mut ipv4_piece = -1
        if numbers_seen > 0 {
          if input.code_unit_at(i) == 46 && numbers_seen < 4 {
            i = i + 1
          } else {
            return Err(err_v6)
          }
        }
        if i >= end {
          return Err(err_v6)
        }
        let b0 = input.code_unit_at(i)
        if b0 < 48 || b0 > 57 {
          return Err(err_v6)
        }
        while i < end {
          let b = input.code_unit_at(i)
          if b < 48 || b > 57 {
            break
          }
          let d = b - 48
          if ipv4_piece < 0 {
            ipv4_piece = d
          } else if ipv4_piece == 0 {
            return Err(err_v6)
          } else {
            ipv4_piece = ipv4_piece * 10 + d
          }
          if ipv4_piece > 255 {
            return Err(err_v6)
          }
          i = i + 1
        }
        pieces[piece_idx] = (pieces[piece_idx] << 8) | ipv4_piece
        numbers_seen = numbers_seen + 1
        if numbers_seen == 2 || numbers_seen == 4 {
          piece_idx = piece_idx + 1
        }
      }
      if numbers_seen != 4 {
        return Err(err_v6)
      }
      break
    } else if i < end && input.code_unit_at(i) == 58 {
      i = i + 1
      if i >= end {
        return Err(err_v6)
      }
    } else if i < end {
      return Err(err_v6)
    }
    pieces[piece_idx] = seg_val
    piece_idx = piece_idx + 1
  }
  if compress >= 0 {
    let mut swaps = piece_idx - compress
    let mut idx = 7
    while idx != 0 && swaps > 0 {
      let src = compress + swaps - 1
      let tmp = pieces[idx]
      pieces[idx] = pieces[src]
      pieces[src] = tmp
      idx = idx - 1
      swaps = swaps - 1
    }
  } else if piece_idx != 8 {
    return Err(err_v6)
  }
  Ok(
    Ipv6Addr::new(
      pieces[0],
      pieces[1],
      pieces[2],
      pieces[3],
      pieces[4],
      pieces[5],
      pieces[6],
      pieces[7],
    ),
  )
}

///| Parse a special URL host (IPv6 in brackets, IPv4, or IDNA domain).
pub fn host_parse(input : String) -> Result[Host, ParseError] {
  let n = input.length()
  if n == 0 {
    return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host"))
  }
  if input.code_unit_at(0) == 91 {
    if input.code_unit_at(n - 1) != 93 {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv6Address, "missing closing bracket"))
    }
    match parse_ipv6_slice(input, 1, n - 1) {
      Ok(ip) => return Ok(Host::Ipv6(ip))
      Err(e) => return Err(e)
    }
  }
  let decoded = percent_decode_str(input)
  let ascii = match domain_to_ascii(decoded) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if ascii.length() == 0 {
    return Err(ParseError::new(ParseErrorKind::EmptyHost, "empty host"))
  }
  if ends_in_a_number(ascii) {
    match parse_ipv4(ascii) {
      Ok(ip) => return Ok(Host::Ipv4(ip))
      Err(e) => return Err(e)
    }
  }
  Ok(Host::Domain(ascii))
}

///| Parse a non-special (opaque) URL host per WHATWG §3.5.
pub fn host_parse_opaque(input : String) -> Result[Host, ParseError] {
  let n = input.length()
  if n > 0 && input.code_unit_at(0) == 91 {
    if input.code_unit_at(n - 1) != 93 {
      return Err(ParseError::new(ParseErrorKind::InvalidIpv6Address, "missing closing bracket"))
    }
    match parse_ipv6_slice(input, 1, n - 1) {
      Ok(ip) => return Ok(Host::Ipv6(ip))
      Err(e) => return Err(e)
    }
  }
  let mut i = 0
  while i < n {
    let b = input.code_unit_at(i)
    if b < 0x80 && is_forbidden_host_byte(b) {
      return Err(ParseError::new(ParseErrorKind::InvalidDomainCharacter, "forbidden host code point"))
    }
    i = i + 1
  }
  Ok(Host::Domain(percent_encode(input, EncodeSet::Controls)))
}
