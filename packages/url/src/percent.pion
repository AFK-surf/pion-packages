///| Percent-encoding and percent-decoding per WHATWG URL Standard §1.3.

///|
pub fn percent_encode(input : String, set : EncodeSet) -> String {
  let _ = input
  let _ = set
  ""
}

///|
pub fn percent_decode(input : String) -> Bytes {
  let _ = input
  Bytes::new(0)
}

///|
pub fn percent_decode_str(input : String) -> String {
  let _ = input
  ""
}
