///| Percent-encoding and percent-decoding per WHATWG URL Standard §1.3.

let mask_controls : Int = 1

let mask_fragment : Int = 2

let mask_query : Int = 4

let mask_special_query : Int = 8

let mask_path : Int = 16

let mask_userinfo : Int = 32

let mask_component : Int = 64

let mask_form : Int = 128

///| Build the 256-byte percent-encode lookup table.
fn build_encode_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut b = 0
  while b < 256 {
    let mut m = 0
    // Controls: C0 (<= 0x1F) or > 0x7E
    let is_ctrl = b <= 0x1F || b > 0x7E
    if is_ctrl {
      m = m | mask_controls
    }
    // Fragment: Controls + ' ', '"', '<', '>', '`'
    let is_frag = is_ctrl ||
    b == 0x20 ||
    b == 0x22 ||
    b == 0x3C ||
    b == 0x3E ||
    b == 0x60
    if is_frag {
      m = m | mask_fragment
    }
    // Query: Controls + ' ', '"', '#', '<', '>'
    let is_query = is_ctrl ||
    b == 0x20 ||
    b == 0x22 ||
    b == 0x23 ||
    b == 0x3C ||
    b == 0x3E
    if is_query {
      m = m | mask_query
    }
    // SpecialQuery: Query + '\''
    let is_squery = is_query || b == 0x27
    if is_squery {
      m = m | mask_special_query
    }
    // Path: Query + '?', '^', '`', '{', '}'
    let is_path = is_query ||
    b == 0x3F ||
    b == 0x5E ||
    b == 0x60 ||
    b == 0x7B ||
    b == 0x7D
    if is_path {
      m = m | mask_path
    }
    // Userinfo: Path + '/', ':', ';', '=', '@', '[', '\\', ']', '|'
    let is_userinfo = is_path ||
    b == 0x2F ||
    b == 0x3A ||
    b == 0x3B ||
    b == 0x3D ||
    b == 0x40 ||
    b == 0x5B ||
    b == 0x5C ||
    b == 0x5D ||
    b == 0x7C
    if is_userinfo {
      m = m | mask_userinfo
    }
    // Component: Userinfo + '$', '%', '&', '+', ','
    let is_comp = is_userinfo ||
    b == 0x24 ||
    b == 0x25 ||
    b == 0x26 ||
    b == 0x2B ||
    b == 0x2C
    if is_comp {
      m = m | mask_component
    }
    // application/x-www-form-urlencoded safe set: '*', '-', '.', '0'-'9', 'A'-'Z', '_', 'a'-'z'
    // Note: ' ' (0x20) is handled specially as '+' by form serializer; everything else encoded.
    let is_form_safe = b == 0x2A ||
    b == 0x2D ||
    b == 0x2E ||
    (b >= 0x30 && b <= 0x39) ||
    (b >= 0x41 && b <= 0x5A) ||
    b == 0x5F ||
    (b >= 0x61 && b <= 0x7A)
    if !is_form_safe {
      m = m | mask_form
    }
    lut[b] = m
    b = b + 1
  }
  lut
}

let encode_lut : FixedArray[Int] = build_encode_lut()

let hex_upper : String = "0123456789ABCDEF"

///|
fn encode_set_mask(set : EncodeSet) -> Int {
  match set {
    EncodeSet::Controls => mask_controls
    EncodeSet::Fragment => mask_fragment
    EncodeSet::Query => mask_query
    EncodeSet::SpecialQuery => mask_special_query
    EncodeSet::Path => mask_path
    EncodeSet::Userinfo => mask_userinfo
    EncodeSet::Component => mask_component
  }
}

///| Write a single byte as `%XX` (uppercase hex) into `sb`.
fn write_pct_byte(sb : StringBuilder, b : Int) -> Unit {
  sb.write_byte((37).to_byte())
  let hi = (b >> 4) & 0xF
  let lo = b & 0xF
  sb.write_byte((if hi < 10 { 48 + hi } else { 55 + hi }).to_byte())
  sb.write_byte((if lo < 10 { 48 + lo } else { 55 + lo }).to_byte())
}

///| Write `s[start..end]` into `sb`, percent-encoding bytes matching `mask`.
fn write_percent_encoded_slice(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  mask : Int,
) -> Unit {
  let lut = encode_lut
  let mut i = start
  let mut run_start = start
  while i < end {
    let b = s.code_unit_at(i)
    if (lut[b] & mask) != 0 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      write_pct_byte(sb, b)
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < end {
    sb.write_substring(s, run_start, end)
  }
}

///| Write `s[start..end]` into `sb`, stripping ASCII tab/LF/CR and percent-encoding bytes matching `mask`.
fn write_percent_encoded_strip_tab_nl(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  mask : Int,
) -> Unit {
  let mut i = start
  let mut run_start = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 9 || b == 10 || b == 13 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      run_start = i + 1
    } else if (encode_lut[b] & mask) != 0 {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      write_pct_byte(sb, b)
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < end {
    sb.write_substring(s, run_start, end)
  }
}

///|
pub fn percent_encode(input : String, set : EncodeSet) -> String {
  let n = input.length()
  if n == 0 {
    return ""
  }
  let mask = encode_set_mask(set)
  let mut i = 0
  while i < n {
    if (encode_lut[input.code_unit_at(i)] & mask) != 0 {
      let sb = StringBuilder::with_capacity(n + 16)
      if i > 0 {
        sb.write_substring(input, 0, i)
      }
      write_percent_encoded_slice(sb, input, i, n, mask)
      return sb.to_string()
    }
    i = i + 1
  }
  input
}

///| Decode hex digit byte to 0..15, or -1 if invalid.
fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///| Percent-decode `input` into raw `Bytes`.
pub fn percent_decode(input : String) -> Bytes {
  let n = input.length()
  let mut out_len = 0
  let mut i = 0
  while i < n {
    if input.code_unit_at(i) == 37 && i + 2 < n {
      let hi = hex_val(input.code_unit_at(i + 1))
      let lo = hex_val(input.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        out_len = out_len + 1
        i = i + 3
        continue
      }
    }
    out_len = out_len + 1
    i = i + 1
  }
  let mut buf = Bytes::new(out_len)
  let mut o = 0
  i = 0
  while i < n {
    let b = input.code_unit_at(i)
    if b == 37 && i + 2 < n {
      let hi = hex_val(input.code_unit_at(i + 1))
      let lo = hex_val(input.code_unit_at(i + 2))
      if hi >= 0 && lo >= 0 {
        buf[o] = ((hi << 4) | lo).to_byte()
        o = o + 1
        i = i + 3
        continue
      }
    }
    buf[o] = b.to_byte()
    o = o + 1
    i = i + 1
  }
  buf
}

///| Write UTF-8 bytes from `bs` into `sb`, replacing invalid UTF-8 sequences with U+FFFD.
fn write_utf8_lossy(sb : StringBuilder, bs : Bytes) -> Unit {
  let n = bs.length()
  let mut i = 0
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(b0.to_byte())
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n {
        let b1 = bs[i + 1].to_int()
        if (b1 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          i = i + 2
          continue
        }
      }
      sb.write_byte((0xEF).to_byte())
      sb.write_byte((0xBF).to_byte())
      sb.write_byte((0xBD).to_byte())
      i = i + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 < n {
        let b1 = bs[i + 1].to_int()
        let b2 = bs[i + 2].to_int()
        let valid_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 && (b2 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          i = i + 3
          continue
        }
      }
      sb.write_byte((0xEF).to_byte())
      sb.write_byte((0xBF).to_byte())
      sb.write_byte((0xBD).to_byte())
      // Maximal subpart of ill-formed subsequence (WHATWG Encoding Standard)
      if i + 1 < n {
        let b1 = bs[i + 1].to_int()
        let valid_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 {
          i = i + 2
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 < n {
        let b1 = bs[i + 1].to_int()
        let b2 = bs[i + 2].to_int()
        let b3 = bs[i + 3].to_int()
        let valid_b1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          sb.write_byte(b3.to_byte())
          i = i + 4
          continue
        }
      }
      sb.write_byte((0xEF).to_byte())
      sb.write_byte((0xBF).to_byte())
      sb.write_byte((0xBD).to_byte())
      if i + 1 < n {
        let b1 = bs[i + 1].to_int()
        let valid_b1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 {
          if i + 2 < n && (bs[i + 2].to_int() & 0xC0) == 0x80 {
            i = i + 3
          } else {
            i = i + 2
          }
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    } else {
      sb.write_byte((0xEF).to_byte())
      sb.write_byte((0xBF).to_byte())
      sb.write_byte((0xBD).to_byte())
      i = i + 1
    }
  }
}

///| Percent-decode `input` into a UTF-8 `String` (invalid UTF-8 replaced by U+FFFD).
pub fn percent_decode_str(input : String) -> String {
  let n = input.length()
  let mut has_pct = false
  let mut i = 0
  while i < n {
    if input.code_unit_at(i) == 37 {
      has_pct = true
      break
    }
    i = i + 1
  }
  if !has_pct {
    return input
  }
  let bs = percent_decode(input)
  let sb = StringBuilder::with_capacity(bs.length())
  write_utf8_lossy(sb, bs)
  sb.to_string()
}

///| Write a Unicode scalar value `cp` as UTF-8 into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Decode one UTF-8 scalar value from `s` starting at `pos`. Returns `(cp, next_pos)`.
fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      return (cp, pos + 3)
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x07) << 18) |
      ((b1 & 0x3F) << 12) |
      ((b2 & 0x3F) << 6) |
      (b3 & 0x3F)
      return (cp, pos + 4)
    }
  }
  (0xFFFD, pos + 1)
}
