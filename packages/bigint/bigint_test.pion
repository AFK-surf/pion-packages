///| Comprehensive test suite for `packages/bigint` (Red-phase upstream & adversarial vectors).
///| Covers:
///| - Canonicalization invariants (no `-0`, no trailing zero limbs, aliasing safety)
///| - Int / Int64 / UInt64 conversions including INT32_MIN, INT64_MIN, UINT64_MAX
///| - Strict parsing (base 10, radix 2..=36, hex with 0x/0X) & formatting
///| - Go `math/big` & MoonBit `core/bigint` arithmetic, shifts, bitwise, pow, gcd vectors
///| - Hacker's Delight `divmnu` & Knuth Algorithm D edge vectors (s=0, s=31, qhat-2, add-back)
///| - Single-limb fast paths and `BigIntBuf`
///| - Compile-time `Send` verification

fn assert_true(cond : Bool, msg : String) -> Unit {
  debug_assert(cond, msg)
}

fn assert_eq[T](a : T, b : T) -> Unit {
  debug_assert(a == b, "assert_eq failed")
}

fn must_str(s : String) -> BigInt {
  match BigInt::from_string(s) {
    Ok(v) => v
    Err(_) => panic("failed to parse BigInt: " + s)
  }
}

fn must_hex(s : String) -> BigInt {
  match BigInt::from_hex(s) {
    Ok(v) => v
    Err(_) => panic("failed to parse hex BigInt: " + s)
  }
}

fn check_div_rem(a : BigInt, b : BigInt, exp_q : String, exp_r : String) -> Unit {
  let (q, r) = a.div_rem(b)
  assert_eq(q.to_string(), exp_q)
  assert_eq(r.to_string(), exp_r)
  assert_eq(a.div(b).to_string(), exp_q)
  assert_eq(a.rem(b).to_string(), exp_r)
  // Fundamental invariant: a == q * b + r
  assert_true(q.mul(b).add(r) == a, "q*b + r != a")
  // |r| < |b|
  assert_true(r.abs().lt(b.abs()), "|r| >= |b|")
  // Sign of r matches sign of a (or r == 0)
  if !r.is_zero() {
    assert_eq(r.signum(), a.signum())
  }
  // Canonical zero check
  if q.is_zero() {
    assert_true(!q.is_neg(), "negative zero quotient")
  }
  if r.is_zero() {
    assert_true(!r.is_neg(), "negative zero remainder")
  }
}

test "constructors, zero canonicalization, and Send" {
  let z = BigInt::zero()
  let o = BigInt::one()
  assert_true(z.is_zero(), "zero is_zero")
  assert_true(!z.is_neg(), "zero not neg")
  assert_true(!z.is_pos(), "zero not pos")
  assert_eq(z.signum(), 0)
  assert_eq(z.bit_len(), 0)
  assert_eq(z.to_string(), "0")

  assert_true(!o.is_zero(), "one not zero")
  assert_true(!o.is_neg(), "one not neg")
  assert_true(o.is_pos(), "one is_pos")
  assert_eq(o.signum(), 1)
  assert_eq(o.bit_len(), 1)
  assert_eq(o.to_string(), "1")

  // Never -0
  assert_true(!z.neg().is_neg(), "neg(0) not neg")
  assert_true(z.neg() == z, "neg(0) == 0")
  assert_true(!o.sub(o).is_neg(), "1 - 1 not neg")
  assert_true(o.sub(o) == z, "1 - 1 == 0")
  let neg5 = BigInt::from_int(-5)
  assert_true(!neg5.mul(z).is_neg(), "-5 * 0 not neg")
  assert_true(!neg5.mul_int(0).is_neg(), "-5 * 0i not neg")
  assert_true(!neg5.mul_uint(0U).is_neg(), "-5 * 0u not neg")
  assert_true(!must_str("-0").is_neg(), "from_string(-0) not neg")
  assert_true(must_str("-0") == z, "from_string(-0) == 0")
  assert_true(!must_str("-000000000000").is_neg(), "from_string(-000..) not neg")
  assert_true(!must_hex("-0x0").is_neg(), "from_hex(-0x0) not neg")

  // Compile-time Send check via Channel[BigInt]
  let ch : Channel[BigInt] = Channel::new(2)
  ch.send(o)
  match ch.recv() {
    Some(got) => assert_true(got == o, "Channel[BigInt] Send roundtrip")
    None => panic("Channel[BigInt] recv returned None")
  }
}

test "int, int64, uint64 boundary roundtrips (INT32_MIN, INT64_MIN, UINT64_MAX)" {
  let i32_min = -2147483648
  let i32_max = 2147483647
  let bi32_min = BigInt::from_int(i32_min)
  let bi32_max = BigInt::from_int(i32_max)
  assert_eq(bi32_min.to_string(), "-2147483648")
  assert_eq(bi32_max.to_string(), "2147483647")
  assert_eq(bi32_min.bit_len(), 32)
  assert_eq(bi32_max.bit_len(), 31)
  match bi32_min.to_int() {
    Some(v) => assert_eq(v, i32_min)
    None => panic("INT32_MIN to_int failed")
  }
  match bi32_max.to_int() {
    Some(v) => assert_eq(v, i32_max)
    None => panic("INT32_MAX to_int failed")
  }
  // Out of Int range
  match bi32_min.sub(BigInt::one()).to_int() {
    None => ()
    Some(_) => panic("INT32_MIN - 1 should overflow to_int")
  }
  match bi32_max.add(BigInt::one()).to_int() {
    None => ()
    Some(_) => panic("INT32_MAX + 1 should overflow to_int")
  }

  let i64_min = -9223372036854775807L - 1L
  let i64_max = 9223372036854775807L
  let bi64_min = BigInt::from_int64(i64_min)
  let bi64_max = BigInt::from_int64(i64_max)
  assert_eq(bi64_min.to_string(), "-9223372036854775808")
  assert_eq(bi64_max.to_string(), "9223372036854775807")
  assert_eq(bi64_min.bit_len(), 64)
  assert_eq(bi64_max.bit_len(), 63)
  match bi64_min.to_int64() {
    Some(v) => assert_eq(v, i64_min)
    None => panic("INT64_MIN to_int64 failed")
  }
  match bi64_max.to_int64() {
    Some(v) => assert_eq(v, i64_max)
    None => panic("INT64_MAX to_int64 failed")
  }
  match bi64_min.sub(BigInt::one()).to_int64() {
    None => ()
    Some(_) => panic("INT64_MIN - 1 should overflow to_int64")
  }
  match bi64_max.add(BigInt::one()).to_int64() {
    None => ()
    Some(_) => panic("INT64_MAX + 1 should overflow to_int64")
  }

  let u64_max = 18446744073709551615UL
  let bu64_max = BigInt::from_uint64(u64_max)
  assert_eq(bu64_max.to_string(), "18446744073709551615")
  assert_eq(bu64_max.bit_len(), 64)
  match bu64_max.to_uint64() {
    Some(v) => assert_eq(v, u64_max)
    None => panic("UINT64_MAX to_uint64 failed")
  }
  match BigInt::from_int(-1).to_uint64() {
    None => ()
    Some(_) => panic("-1 should not convert to uint64")
  }
  match bu64_max.add(BigInt::one()).to_uint64() {
    None => ()
    Some(_) => panic("UINT64_MAX + 1 should overflow to_uint64")
  }
}

test "strict parsing and radix formatting" {
  // Valid decimal
  assert_eq(must_str("0").to_string(), "0")
  assert_eq(must_str("+0").to_string(), "0")
  assert_eq(must_str("-0").to_string(), "0")
  assert_eq(must_str("+123456789012345678901234567890").to_string(), "123456789012345678901234567890")
  assert_eq(must_str("-00000999999999999999999999999999999").to_string(), "-999999999999999999999999999999")

  // Strict rejection (never panic)
  let bad = [
    "", "+", "-", " ", " 123", "123 ", "12 3", "1_000", "0x10", "+-1", "--1", "12a", "\n1", "1\t",
  ]
  let mut i = 0
  while i < bad.length() {
    match BigInt::from_string(bad[i]) {
      Err(_) => ()
      Ok(_) => panic("from_string should reject: " + bad[i])
    }
    i = i + 1
  }

  // Hex
  assert_eq(must_hex("0xdeadbeefCAFEBABE0123456789abcdef").to_radix(16).unwrap_or(""), "deadbeefcafebabe0123456789abcdef")
  assert_eq(must_hex("-0XFF").to_string(), "-255")
  assert_eq(must_hex("+0x0000").to_string(), "0")
  assert_eq(must_hex("ff").to_string(), "255")
  let bad_hex = ["", "0x", "0X", "-0x", "+0X", "0x1g", " 0x1", "0x1 "]
  i = 0
  while i < bad_hex.length() {
    match BigInt::from_hex(bad_hex[i]) {
      Err(_) => ()
      Ok(_) => panic("from_hex should reject: " + bad_hex[i])
    }
    i = i + 1
  }

  // Radix 2..=36
  match BigInt::from_radix("10", 1) {
    Err(BigIntError::InvalidRadix) => ()
    _ => panic("radix 1 should fail")
  }
  match BigInt::from_radix("10", 37) {
    Err(BigIntError::InvalidRadix) => ()
    _ => panic("radix 37 should fail")
  }
  match BigInt::one().to_radix(1) {
    Err(BigIntError::InvalidRadix) => ()
    _ => panic("to_radix 1 should fail")
  }
  match BigInt::one().to_radix(37) {
    Err(BigIntError::InvalidRadix) => ()
    _ => panic("to_radix 37 should fail")
  }
  let v36 = match BigInt::from_radix("-zzzzzzzzzzzzzzzzzzzz", 36) {
    Ok(v) => v
    Err(_) => panic("base 36 parse failed")
  }
  assert_eq(v36.to_radix(36).unwrap_or(""), "-zzzzzzzzzzzzzzzzzzzz")
  let v2 = match BigInt::from_radix("1101011010110101011010101101010101011010110101", 2) {
    Ok(v) => v
    Err(_) => panic("base 2 parse failed")
  }
  assert_eq(v2.to_radix(2).unwrap_or(""), "1101011010110101011010101101010101011010110101")
}

test "arithmetic, aliasing, and Go math/big vectors" {
  let a = must_str("1234567890123456789012345678901234567890")
  let b = must_str("9876543210987654321098765432109876543210")
  assert_eq(a.add(b).to_string(), "11111111101111111110111111111011111111100")
  assert_eq(b.sub(a).to_string(), "8641975320864197532086419753208641975320")
  assert_eq(a.sub(b).to_string(), "-8641975320864197532086419753208641975320")
  assert_eq(
    a.mul(b).to_string(),
    "12193263113702179522618503273386678859448712086533622923332237463801111263526900",
  )

  // Aliasing safety: a op a
  assert_eq(a.add(a).to_string(), a.mul_int(2).to_string())
  assert_true(a.sub(a) == BigInt::zero(), "a - a == 0")
  assert_true(a.mul(a) == a.pow(2).unwrap_or(BigInt::zero()), "a * a == a^2")
  check_div_rem(a, a, "1", "0")
  check_div_rem(a.neg(), a, "-1", "0")

  // Truncating division toward zero sign matrix
  check_div_rem(BigInt::from_int(7), BigInt::from_int(3), "2", "1")
  check_div_rem(BigInt::from_int(-7), BigInt::from_int(3), "-2", "-1")
  check_div_rem(BigInt::from_int(7), BigInt::from_int(-3), "-2", "1")
  check_div_rem(BigInt::from_int(-7), BigInt::from_int(-3), "2", "-1")
  check_div_rem(BigInt::from_int(0), BigInt::from_int(-3), "0", "0")
}

test "Knuth Algorithm D and Hacker's Delight divmnu adversarial vectors" {
  // 1. Normalization shift s == 0 (top bit of divisor limb is already 1: 0x80000000)
  let u_s0 = must_hex("0xffffffffffffffffffffffffffffffff")
  let v_s0 = must_hex("0x8000000000000001")
  check_div_rem(u_s0, v_s0, "36893488147419103228", "3")

  // 2. Normalization shift s == 31 (top limb of divisor is 0x00000001)
  let u_s31 = must_hex("0x100000000000000000000000000000000")
  let v_s31 = must_hex("0x10000000100000001")
  check_div_rem(u_s31, v_s31, "18446744069414584320", "4294967296")

  // 3. qhat overestimated by 2 (v = 0x80000000_ffffffff_00000001, triggers qhat decremented twice)
  let u_q2 = must_hex("0x7fffffff000000000000000000000000")
  let v_q2 = must_hex("0x80000000ffffffff00000001")
  check_div_rem(u_q2, v_q2, "4294967292", "92233720347072921604")

  // 4. Classic Knuth TAOCP Vol 2 §4.3.1 / Hacker's Delight add-back trigger:
  // u = 0x7fffffff_80000000_00000000_00000000, v = 0x80000000_ffffffff_ffffffff
  // Refined qhat = 0xfffffffe = 4294967294, true quotient = 4294967293 -> hits Step D6 add-back!
  let u_addback = must_hex("0x7fffffff800000000000000000000000")
  let v_addback = must_hex("0x80000000ffffffffffffffff")
  check_div_rem(u_addback, v_addback, "4294967293", "55340232225423622141")

  // 5. u_hi == v1 case (qhat clamped to B-1, rhat = u_lo + v1 >= B)
  let u_eq = must_hex("0x800000008000000000000000")
  let v_eq = must_hex("0x80000000ffffffff")
  check_div_rem(u_eq, v_eq, "4294967295", "8589934591")

  // 6. Negative dividend/divisor with add-back vector
  check_div_rem(u_addback.neg(), v_addback, "-4294967293", "-55340232225423622141")
  check_div_rem(u_addback, v_addback.neg(), "-4294967293", "55340232225423622141")
  check_div_rem(u_addback.neg(), v_addback.neg(), "4294967293", "-55340232225423622141")
}

test "single-limb fast paths and BigIntBuf" {
  let a = must_str("987654321098765432109876543210")
  let b = must_str("123456789012345678901234567890")
  assert_true(a.add_int(42) == a.add(BigInt::from_int(42)), "add_int pos")
  assert_true(a.add_int(-42) == a.add(BigInt::from_int(-42)), "add_int neg")
  assert_true(a.mul_int(17) == a.mul(BigInt::from_int(17)), "mul_int pos")
  assert_true(a.mul_int(-17) == a.mul(BigInt::from_int(-17)), "mul_int neg")
  assert_true(a.mul_uint(1000000000U) == a.mul(BigInt::from_int(1000000000)), "mul_uint")
  assert_true(
    a.add_mul_int(b, 7) == a.add(b.mul(BigInt::from_int(7))),
    "add_mul_int pos",
  )
  assert_true(
    a.add_mul_int(b, -7) == a.add(b.mul(BigInt::from_int(-7))),
    "add_mul_int neg",
  )
  let (q, r) = a.div_rem_uint(1000000000U)
  assert_eq(q.to_string(), "987654321098765432109")
  assert_eq(r, 876543210U)

  // BigIntBuf
  let mut buf = BigIntBuf::from_int(1, 8)
  let mut other = BigIntBuf::from_int(3, 8)
  buf.mul_uint_in_place(10U)
  buf.add_mul_uint_in_place(other, 4U)
  assert_eq(buf.to_bigint().to_string(), "22")
  buf.sub_mul_uint_in_place(other, 2U)
  assert_eq(buf.to_bigint().to_string(), "16")
  assert_eq(buf.div_small_uint(other), 5U)
  other.set_int(16)
  assert_eq(buf.cmp(other), 0)
}

test "shifts, two's-complement bitwise, pow, and gcd" {
  // Shifts (flooring toward -infinity for negatives, matching Python/Go)
  assert_eq(BigInt::from_int(1).shl(100).to_string(), "1267650600228229401496703205376")
  assert_eq(BigInt::from_int(-1).shl(64).to_string(), "-18446744073709551616")
  assert_eq(BigInt::from_int(-1).shr(1).to_string(), "-1")
  assert_eq(BigInt::from_int(-1).shr(100).to_string(), "-1")
  assert_eq(BigInt::from_int(-4).shr(1).to_string(), "-2")
  assert_eq(BigInt::from_int(-5).shr(1).to_string(), "-3")
  assert_eq(BigInt::from_int(-16).shr(2).to_string(), "-4")
  assert_eq(BigInt::from_int(-17).shr(2).to_string(), "-5")
  assert_eq(BigInt::from_int(0).shr(100).to_string(), "0")
  match BigInt::one().checked_shl(-1) {
    Err(BigIntError::NegativeShift) => ()
    _ => panic("checked_shl(-1) should fail")
  }
  match BigInt::one().checked_shr(-1) {
    Err(BigIntError::NegativeShift) => ()
    _ => panic("checked_shr(-1) should fail")
  }

  // Two's complement bitwise (verified against Python)
  let p1 = BigInt::from_int(0x123456)
  let p2 = BigInt::from_int(0x0f0f0f)
  let n1 = BigInt::from_int(-13)
  let n2 = BigInt::from_int(-7)
  assert_eq(p1.bit_and(p2).to_string(), "132102")
  assert_eq(p1.bit_or(p2).to_string(), "2047839")
  assert_eq(p1.bit_xor(p2).to_string(), "1915737")
  // -13 & -7 == -15, -13 | -7 == -5, -13 ^ -7 == 10
  assert_eq(n1.bit_and(n2).to_string(), "-15")
  assert_eq(n1.bit_or(n2).to_string(), "-5")
  assert_eq(n1.bit_xor(n2).to_string(), "10")
  // 13 & -7 == 9, 13 | -7 == -3, 13 ^ -7 == -12
  let thirteen = BigInt::from_int(13)
  assert_eq(thirteen.bit_and(n2).to_string(), "9")
  assert_eq(thirteen.bit_or(n2).to_string(), "-3")
  assert_eq(thirteen.bit_xor(n2).to_string(), "-12")
  assert_eq(thirteen.bit_not().to_string(), "-14")
  assert_eq(n1.bit_not().to_string(), "12")

  // Multi-limb negative bitwise
  let big_neg = BigInt::from_int(-1).shl(70).sub(BigInt::from_int(5))
  let big_pos = BigInt::from_int(1).shl(70).add(BigInt::from_int(3))
  assert_eq(big_neg.bit_and(big_pos).to_string(), "3")
  assert_eq(big_neg.bit_or(big_pos).to_string(), "-5")
  assert_eq(big_neg.bit_xor(big_pos).to_string(), "-8")

  // Pow
  assert_eq(BigInt::zero().pow(0).unwrap_or(BigInt::zero()).to_string(), "1")
  assert_eq(BigInt::from_int(-3).pow(5).unwrap_or(BigInt::zero()).to_string(), "-243")
  assert_eq(BigInt::from_int(-3).pow(6).unwrap_or(BigInt::zero()).to_string(), "729")
  assert_eq(BigInt::from_int(2).pow(128).unwrap_or(BigInt::zero()).to_string(), "340282366920938463463374607431768211456")
  match BigInt::from_int(2).pow(-1) {
    Err(BigIntError::NegativeExponent) => ()
    _ => panic("negative exponent should fail")
  }

  // GCD
  assert_eq(BigInt::zero().gcd(BigInt::zero()).to_string(), "0")
  assert_eq(BigInt::zero().gcd(BigInt::from_int(-42)).to_string(), "42")
  assert_eq(BigInt::from_int(-48).gcd(BigInt::from_int(18)).to_string(), "6")
  let g1 = must_str("123456789012345678901234567890").mul(BigInt::from_int(1000000007))
  let g2 = must_str("987654321098765432109876543210").mul(BigInt::from_int(1000000007))
  assert_eq(g1.gcd(g2).to_string(), "9000000063900000006390000000630")
}
