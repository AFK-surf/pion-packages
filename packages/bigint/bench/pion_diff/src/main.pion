///| Comprehensive differential test driver for `packages/bigint` (Native + Wasm32).
///| Covers `div`/`rem`/`div_rem`, `pow`, `from_radix`/`to_radix` (2..36), `from_hex`,
///| `to_int`/`to_int64`/`to_uint64`/`bit_len`/`signum` roundtrips, shifts, bitwise ops,
///| `gcd`/`cmp`/`add`/`sub`/`mul`, single-limb fast paths, and all `BigIntBuf` methods
///| including `div_small_uint -> Option[UInt]` (both valid and overflow cases).

import "bigint"

fn p64(s : String) -> Int64 {
  let mut neg = false
  let mut i = 0
  let n = s.length()
  if n > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut acc = 0L
  while i < n {
    acc = acc * 10L + (s.code_unit_at(i) - 48).to_int64()
    i = i + 1
  }
  if neg { 0L - acc } else { acc }
}

fn split_tabs(line : String) -> Array[String] {
  let out : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      out.push(line.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn bi(s : String) -> bigint::BigInt {
  match bigint::BigInt::from_string(s) {
    Ok(v) => v
    Err(_) => panic("bad " + s)
  }
}

fn err_s(e : bigint::BigIntError) -> String {
  match e {
    bigint::BigIntError::EmptyInput => "E:empty"
    bigint::BigIntError::InvalidDigit => "E:digit"
    bigint::BigIntError::InvalidRadix => "E:radix"
    bigint::BigIntError::NegativeExponent => "E:negexp"
    bigint::BigIntError::NegativeShift => "E:negshift"
    bigint::BigIntError::OutputTooLarge => "E:toolarge"
  }
}

fn canon(v : bigint::BigInt) -> String {
  if v.is_zero() && v.is_neg() {
    return "NEGZERO"
  }
  let s = v.to_string()
  match bigint::BigInt::from_string(s) {
    Ok(w) => if w == v { s } else { "NONCANON:" + s }
    Err(_) => "BADFMT"
  }
}

fn opt_i(o : Option[Int]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "N"
  }
}

fn opt_l(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "N"
  }
}

fn opt_u(o : Option[UInt64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "N"
  }
}

fn opt_u32(o : Option[UInt]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "N"
  }
}

fn buf_s(b : bigint::BigIntBuf) -> String {
  canon(b.to_bigint())
}

pub fn main(world : World) -> Int {
  let args = args_get()
  if args.length() < 2 {
    io_println("usage: bigint_diff <cases_file>")
    return 1
  }
  let content = match fs_read(args[1]) {
    Ok(s) => s
    Err(e) => {
      io_println("read error: " + e)
      return 1
    }
  }
  let n = content.length()
  let mut pos = 0
  let sb = StringBuilder::new()
  while pos < n {
    let mut end = pos
    while end < n && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    let line = content.slice(pos, end)
    pos = end + 1
    if line.length() == 0 {
      continue
    }
    let c = split_tabs(line)
    let op = c[0]
    if op == "dr" {
      let a = bi(c[1])
      let b = bi(c[2])
      let (q, r) = a.div_rem(b)
      sb.write_string(canon(a.div(b)) + "|" + canon(q) + "|" + canon(r) + "|" + canon(a.rem(b)))
    } else if op == "pw" {
      match bi(c[1]).pow(p64(c[2]).to_int()) {
        Ok(v) => sb.write_string(canon(v))
        Err(e) => sb.write_string(err_s(e))
      }
    } else if op == "rx" {
      let a = bi(c[1])
      let r = p64(c[2]).to_int()
      match a.to_radix(r) {
        Ok(s) => {
          sb.write_string(s)
          match bigint::BigInt::from_radix(s, r) {
            Ok(w) => if !(w == a) { sb.write_string("|RTFAIL") }
            Err(e) => sb.write_string("|" + err_s(e))
          }
        }
        Err(e) => sb.write_string(err_s(e))
      }
    } else if op == "ps" {
      match bigint::BigInt::from_radix(c[1], p64(c[2]).to_int()) {
        Ok(v) => sb.write_string(canon(v))
        Err(e) => sb.write_string(err_s(e))
      }
    } else if op == "hx" {
      match bigint::BigInt::from_hex(c[1]) {
        Ok(v) => sb.write_string(canon(v))
        Err(e) => sb.write_string(err_s(e))
      }
    } else if op == "cv" {
      let a = bi(c[1])
      sb.write_string(opt_i(a.to_int()) + "|" + opt_l(a.to_int64()) + "|" + opt_u(a.to_uint64()) + "|" + a.bit_len().to_string() + "|" + a.signum().to_string())
      match a.to_int64() {
        Some(v) => if !(bigint::BigInt::from_int64(v) == a) { sb.write_string("|FROM64FAIL") }
        None => ()
      }
      match a.to_int() {
        Some(v) => if !(bigint::BigInt::from_int(v) == a) { sb.write_string("|FROM32FAIL") }
        None => ()
      }
      match a.to_uint64() {
        Some(v) => if !(bigint::BigInt::from_uint64(v) == a) { sb.write_string("|FROMU64FAIL") }
        None => ()
      }
    } else if op == "sh" {
      let a = bi(c[1])
      let k = p64(c[2]).to_int()
      sb.write_string(canon(a.shl(k)) + "|" + canon(a.shr(k)))
    } else if op == "bw" {
      let a = bi(c[1])
      let b = bi(c[2])
      sb.write_string(canon(a.bit_and(b)) + "|" + canon(a.bit_or(b)) + "|" + canon(a.bit_xor(b)) + "|" + canon(a.bit_not()) + "|" + canon(a.gcd(b)) + "|" + a.cmp(b).to_string() + "|" + canon(a.add(b)) + "|" + canon(a.sub(b)) + "|" + canon(a.mul(b)))
    } else if op == "sm" {
      let a = bi(c[1])
      let b = bi(c[2])
      let k = p64(c[3]).to_int()
      let du = p64(c[4]).to_uint64().to_uint()
      let (q, r) = a.div_rem_uint(du)
      sb.write_string(canon(a.add_int(k)) + "|" + canon(a.mul_int(k)) + "|" + canon(a.add_mul_int(b, k)) + "|" + canon(a.mul_uint(du)) + "|" + canon(q) + "," + r.to_string())
    } else if op == "buf" {
      let a = bi(c[1])
      let b = bi(c[2])
      let k = p64(c[3]).to_uint64().to_uint()
      let bb = bigint::BigIntBuf::from_bigint(b)
      let mut x1 = bigint::BigIntBuf::from_bigint(a)
      x1.add_mul_uint_in_place(bb, k)
      let mut x2 = bigint::BigIntBuf::from_bigint(a)
      x2.sub_mul_uint_in_place(bb, k)
      let mut x3 = bigint::BigIntBuf::from_bigint(a)
      x3.mul_uint_in_place(k)
      let mut x4 = bigint::BigIntBuf::from_bigint(a)
      x4.add_in_place(bb)
      let mut x5 = bigint::BigIntBuf::from_bigint(a)
      x5.sub_in_place(bb)
      let mut x6 = bigint::BigIntBuf::new(1)
      x6.copy_from(bb)
      x1.sub_mul_uint_in_place(bb, k)
      sb.write_string(buf_s(x2) + "|" + buf_s(x3) + "|" + buf_s(x4) + "|" + buf_s(x5) + "|" + buf_s(x6) + "|" + buf_s(x1) + "|" + x4.cmp(x5).to_string())
    } else if op == "dsu" {
      let a = bigint::BigIntBuf::from_bigint(bi(c[1]))
      let b = bigint::BigIntBuf::from_bigint(bi(c[2]))
      sb.write_string(opt_u32(a.div_small_uint(b)))
    }
    sb.write_string("\n")
  }
  io_print(sb.to_string())
  let _ = world
  0
}
