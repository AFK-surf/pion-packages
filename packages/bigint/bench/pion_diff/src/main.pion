///| Differential test driver: reads test cases from file path arg (or stdin lines)
///| and prints deterministic results for Python oracle comparison on Native and Wasm32.

import "bigint"

fn parse_line_i32(s : String) -> Int {
  let mut neg = false
  let mut i = 0
  let n = s.length()
  if n > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut acc = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg { -acc } else { acc }
}

fn split_tabs(line : String) -> Array[String] {
  let out : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      out.push(line.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out
}

pub fn main(world : World) -> Int {
  let args = args_get()
  if args.length() < 2 {
    io_println("usage: bigint_diff <cases_file>")
    return 1
  }
  let content = match fs_read(args[1]) {
    Ok(s) => s
    Err(e) => {
      io_println("read error: " + e)
      return 1
    }
  }
  let n = content.length()
  let mut pos = 0
  let mut sb = StringBuilder::new()
  while pos < n {
    let mut end = pos
    while end < n && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    let line = content.slice(pos, end)
    pos = end + 1
    if line.length() == 0 {
      continue
    }
    let cols = split_tabs(line)
    if cols.length() < 3 {
      continue
    }
    let op = cols[0]
    let a = match bigint::BigInt::from_string(cols[1]) {
      Ok(v) => v
      Err(_) => {
        sb.write_string("ERR_A\n")
        continue
      }
    }
    if op == "bin" && cols.length() >= 4 {
      let b = match bigint::BigInt::from_string(cols[2]) {
        Ok(v) => v
        Err(_) => {
          sb.write_string("ERR_B\n")
          continue
        }
      }
      let sh = parse_line_i32(cols[3])
      sb.write_string(a.add(b).to_string())
      sb.write_string("|")
      sb.write_string(a.sub(b).to_string())
      sb.write_string("|")
      sb.write_string(a.mul(b).to_string())
      sb.write_string("|")
      if !b.is_zero() {
        let (q, r) = a.div_rem(b)
        sb.write_string(q.to_string())
        sb.write_string(",")
        sb.write_string(r.to_string())
      } else {
        sb.write_string("DIV0")
      }
      sb.write_string("|")
      sb.write_string(a.bit_and(b).to_string())
      sb.write_string("|")
      sb.write_string(a.bit_or(b).to_string())
      sb.write_string("|")
      sb.write_string(a.bit_xor(b).to_string())
      sb.write_string("|")
      sb.write_string(a.gcd(b).to_string())
      sb.write_string("|")
      sb.write_string(a.shl(sh).to_string())
      sb.write_string("|")
      sb.write_string(a.shr(sh).to_string())
      sb.write_string("|")
      sb.write_string(a.bit_not().to_string())
      sb.write_string("|")
      sb.write_string(a.to_radix(16).unwrap_or("ERR"))
      sb.write_string("|")
      sb.write_string(a.to_radix(36).unwrap_or("ERR"))
      sb.write_string("\n")
    } else if op == "small" && cols.length() >= 4 {
      let b = match bigint::BigInt::from_string(cols[2]) {
        Ok(v) => v
        Err(_) => {
          sb.write_string("ERR_B\n")
          continue
        }
      }
      let k = parse_line_i32(cols[3])
      sb.write_string(a.add_int(k).to_string())
      sb.write_string("|")
      sb.write_string(a.mul_int(k).to_string())
      sb.write_string("|")
      sb.write_string(a.add_mul_int(b, k).to_string())
      sb.write_string("|")
      let d_u = if k == 0 { 1U } else if k < 0 { (0 - k).to_uint() } else { k.to_uint() }
      let (qd, rd) = a.div_rem_uint(d_u)
      sb.write_string(qd.to_string())
      sb.write_string(",")
      sb.write_string(rd.to_string())
      sb.write_string("\n")
    }
  }
  io_print(sb.to_string())
  let _ = world
  0
}
