///| Big multiplication and Knuth division benchmark (deterministic 256-bit to 2048-bit stream).

import "bigint"

pub fn main(world : World) -> Int {
  // Build deterministic 512-bit and 256-bit starting numbers
  let mut a = bigint::BigInt::from_hex("0xdeadbeefcafebabe0123456789abcdef112233445566778899aabbccddeeff01").unwrap_or(bigint::BigInt::one())
  let mut b = bigint::BigInt::from_hex("0x80000000ffffffff123456789abcdef0fedcba9876543210").unwrap_or(bigint::BigInt::one())
  a = a.mul(a).add_int(17)
  b = b.mul(b).add_int(31)
  let mut acc = bigint::BigInt::zero()
  let mut i = 0
  while i < 2000 {
    let prod = a.mul(b)
    let (q, r) = prod.div_rem(b.add_int(i + 1))
    acc = acc.add(q).sub(r)
    if (i & 7) == 0 {
      a = a.add_int(i * 13 + 7)
      b = b.add_int(i * 7 + 3)
    }
    i = i + 1
  }
  io_println(acc.to_string())
  let _ = world
  0
}
