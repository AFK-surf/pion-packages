///| CLBG `pidigits` N=2500 benchmark using `bigint::BigIntBuf` (zero-allocation hot loop)
///| and `bigint::BigInt` (pass `--immutable` to benchmark the immutable API).

import "bigint"

fn parse_u32_arg(s : String, default_val : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return default_val
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return default_val
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

fn run_buf(n : Int) -> String {
  let mut num = bigint::BigIntBuf::from_int(1, 128)
  let mut acc = bigint::BigIntBuf::from_int(0, 128)
  let mut den = bigint::BigIntBuf::from_int(1, 128)
  let mut tmp1 = bigint::BigIntBuf::new(128)
  let mut tmp2 = bigint::BigIntBuf::new(128)
  let mut k = 0U
  let mut i = 0
  let mut sb = StringBuilder::new()
  let mut line = Bytes::new(10)
  let mut col = 0
  while i < n {
    k = k + 1U
    let k2 = k * 2U + 1U
    // next_term(k):
    // acc += num * 2
    acc.add_mul_uint_in_place(num, 2U)
    // acc *= k2; den *= k2; num *= k
    acc.mul_uint_in_place(k2)
    den.mul_uint_in_place(k2)
    num.mul_uint_in_place(k)
    if num.cmp(acc) > 0 {
      continue
    }
    // extract_digit(3) and extract_digit(4)
    tmp1.copy_from(acc)
    tmp1.add_mul_uint_in_place(num, 3U)
    let d3 = tmp1.div_small_uint(den).unwrap_or(0U)
    tmp1.add_in_place(num)
    let d4 = tmp1.div_small_uint(den).unwrap_or(0U)
    if d3 != d4 {
      continue
    }
    line[col] = (48 + d3.to_int()).to_byte()
    col = col + 1
    i = i + 1
    if col == 10 {
      sb.write_string(line.to_string())
      sb.write_string("\t:")
      sb.write_string(i.to_string())
      sb.write_string("\n")
      col = 0
    }
    // eliminate_digit(d3):
    // acc -= den * d3; acc *= 10; num *= 10
    acc.sub_mul_uint_in_place(den, d3)
    acc.mul_uint_in_place(10U)
    num.mul_uint_in_place(10U)
  }
  if col > 0 {
    let mut k_pad = col
    while k_pad < 10 {
      line[k_pad] = b' '
      k_pad = k_pad + 1
    }
    sb.write_string(line.to_string())
    sb.write_string("\t:")
    sb.write_string(i.to_string())
    sb.write_string("\n")
  }
  sb.to_string()
}

fn run_immutable(n : Int) -> String {
  let mut num = bigint::BigInt::one()
  let mut acc = bigint::BigInt::zero()
  let mut den = bigint::BigInt::one()
  let mut k = 0
  let mut i = 0
  let mut sb = StringBuilder::new()
  let mut line = Bytes::new(10)
  let mut col = 0
  while i < n {
    k = k + 1
    let k2 = k * 2 + 1
    acc = acc.add_mul_int(num, 2).mul_int(k2)
    den = den.mul_int(k2)
    num = num.mul_int(k)
    if num.gt(acc) {
      continue
    }
    let t3 = acc.add_mul_int(num, 3)
    let d3 = t3.div(den).to_int().unwrap_or(0)
    let d4 = t3.add(num).div(den).to_int().unwrap_or(0)
    if d3 != d4 {
      continue
    }
    line[col] = (48 + d3).to_byte()
    col = col + 1
    i = i + 1
    if col == 10 {
      sb.write_string(line.to_string())
      sb.write_string("\t:")
      sb.write_string(i.to_string())
      sb.write_string("\n")
      col = 0
    }
    acc = acc.add_mul_int(den, -d3).mul_int(10)
    num = num.mul_int(10)
  }
  if col > 0 {
    let mut k_pad = col
    while k_pad < 10 {
      line[k_pad] = b' '
      k_pad = k_pad + 1
    }
    sb.write_string(line.to_string())
    sb.write_string("\t:")
    sb.write_string(i.to_string())
    sb.write_string("\n")
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = args_get()
  let mut n = 2500
  let mut use_imm = false
  let mut idx = 1
  while idx < args.length() {
    if args[idx] == "--immutable" {
      use_imm = true
    } else {
      n = parse_u32_arg(args[idx], n)
    }
    idx = idx + 1
  }
  let out = if use_imm { run_immutable(n) } else { run_buf(n) }
  io_print(out)
  let _ = world
  0
}
