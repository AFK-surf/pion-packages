///| Parsing and radix formatting for `BigInt`.

///| Convert an ASCII byte to its digit value in `radix`, or `-1` if invalid.
fn parse_digit(b : Byte, radix : Int) -> Int {
  let c = b.to_int()
  let d = if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 122 {
    c - 97 + 10
  } else if c >= 65 && c <= 90 {
    c - 65 + 10
  } else {
    -1
  }
  if d >= 0 && d < radix {
    d
  } else {
    -1
  }
}

///| Maximum number of digits in `radix` (2..=36) whose power fits in `UInt` (`<= 0xFFFFFFFF`).
fn max_chunk_digits(radix : Int) -> Int {
  let r = radix.to_int64().to_uint64()
  let mut limit = r
  let mut digits = 1
  while limit <= 0xFFFFFFFFUL / r {
    limit = limit * r
    digits = digits + 1
  }
  digits
}

///| Multiply mutable `limbs` in place by `mul` and add `add` (`limbs = limbs * mul + add`).
fn limbs_mul_add_u32(limbs : Array[UInt], mul : UInt, add : UInt) -> Unit {
  let m = mul.to_uint64()
  let mut carry = add.to_uint64()
  let n = limbs.length()
  let mut i = 0
  while i < n {
    let prod = limbs[i].to_uint64() * m + carry
    limbs[i] = (prod & 0xFFFFFFFFUL).to_uint()
    carry = prod >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    limbs.push(carry.to_uint())
  }
}

///| Core strict radix parser over byte slice `s[start..end]`.
fn parse_radix_slice(s : String, start : Int, end : Int, neg : Bool, radix : Int) -> Result[BigInt, BigIntError] {
  if start >= end {
    return Err(BigIntError::InvalidDigit)
  }
  // Skip leading zeros while still validating them as '0'
  let mut pos = start
  while pos < end && s.code_unit_at(pos) == 48 {
    pos = pos + 1
  }
  if pos == end {
    return Ok(BigInt::zero())
  }
  let chunk_len = max_chunk_digits(radix)
  let r64 = radix.to_int64().to_uint64()
  let limbs : Array[UInt] = Array::with_capacity(((end - pos) / chunk_len) + 2)
  while pos < end {
    let mut chunk = 0UL
    let mut mult = 1UL
    let mut count = 0
    while pos < end && count < chunk_len {
      let d = parse_digit(s.code_unit_at(pos).to_byte(), radix)
      if d < 0 {
        return Err(BigIntError::InvalidDigit)
      }
      chunk = chunk * r64 + d.to_int64().to_uint64()
      mult = mult * r64
      pos = pos + 1
      count = count + 1
    }
    if limbs.length() == 0 {
      if chunk != 0UL {
        limbs.push(chunk.to_uint())
      }
    } else {
      limbs_mul_add_u32(limbs, mult.to_uint(), chunk.to_uint())
    }
  }
  Ok(from_array_trimmed(neg, limbs))
}

///| Parse a strict base-10 integer string with optional leading `+` or `-`.
pub fn BigInt::from_string(s : String) -> Result[BigInt, BigIntError] {
  BigInt::from_radix(s, 10)
}

///| Parse a strict integer string in radix `2..=36` with optional leading `+` or `-`.
pub fn BigInt::from_radix(s : String, radix : Int) -> Result[BigInt, BigIntError] {
  if radix < 2 || radix > 36 {
    return Err(BigIntError::InvalidRadix)
  }
  let len = s.length()
  if len == 0 {
    return Err(BigIntError::EmptyInput)
  }
  let mut neg = false
  let mut start = 0
  let first = s.code_unit_at(0)
  if first == 45 {
    // '-'
    neg = true
    start = 1
  } else if first == 43 {
    // '+'
    start = 1
  }
  parse_radix_slice(s, start, len, neg, radix)
}

///| Parse a strict hexadecimal string with optional leading `+`/`-` and optional `0x`/`0X`.
pub fn BigInt::from_hex(s : String) -> Result[BigInt, BigIntError] {
  let len = s.length()
  if len == 0 {
    return Err(BigIntError::EmptyInput)
  }
  let mut neg = false
  let mut start = 0
  let first = s.code_unit_at(0)
  if first == 45 {
    neg = true
    start = 1
  } else if first == 43 {
    start = 1
  }
  if start + 2 <= len && s.code_unit_at(start) == 48 {
    let second = s.code_unit_at(start + 1)
    if second == 120 || second == 88 {
      // 'x' or 'X'
      start = start + 2
    }
  }
  parse_radix_slice(s, start, len, neg, 16)
}

///| Convert digit `0..35` to lowercase ASCII char (`'0'..'9'`, `'a'..'z'`).
fn digit_to_byte(d : Int) -> Byte {
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (87 + d).to_byte()
  }
}

///| Compute output byte length for power-of-two radix formatting using 64-bit arithmetic.
///| Returns `None` if the formatted length would exceed `INT32_MAX` (`2147483647`).
fn pow2_format_len(n_limbs : Int, top_limb : UInt, bits_per_digit : Int, neg : Bool) -> Option[Int] {
  if n_limbs <= 0 || top_limb == 0U {
    return Some(1)
  }
  let total_bits = bit_len_from_top(n_limbs, top_limb)
  let bpd = bits_per_digit.to_int64()
  let num_digits = (total_bits + bpd - 1L) / bpd
  let out_len64 = num_digits + (if neg { 1L } else { 0L })
  if out_len64 > 2147483647L {
    None
  } else {
    Some(out_len64.to_int())
  }
}

///| Format a non-zero `BigInt` in a power-of-two radix (`bits_per_digit` in 1..=5).
fn format_pow2(neg : Bool, limbs : ImmArray[UInt], bits_per_digit : Int) -> Result[String, BigIntError] {
  let n = limbs.length()
  let out_len = match pow2_format_len(n, limbs[n - 1], bits_per_digit, neg) {
    Some(v) => v
    None => return Err(BigIntError::OutputTooLarge)
  }
  let num_digits = out_len - (if neg { 1 } else { 0 })
  let mask = (1U << bits_per_digit.to_uint()) - 1U
  let mut out = Bytes::new(out_len)
  let mut write_idx = 0
  if neg {
    out[0] = b'-'
    write_idx = 1
  }
  let bpd64 = bits_per_digit.to_int64()
  let mut d_idx = num_digits - 1
  while d_idx >= 0 {
    let bit_pos = d_idx.to_int64() * bpd64
    let limb_idx = (bit_pos / 32L).to_int()
    let bit_off = (bit_pos % 32L).to_int()
    let mut digit_val = (limbs[limb_idx] >> bit_off.to_uint()) & mask
    if bit_off + bits_per_digit > 32 && limb_idx + 1 < n {
      let hi_part = limbs[limb_idx + 1] << (32 - bit_off).to_uint()
      digit_val = (digit_val | hi_part) & mask
    }
    out[write_idx] = digit_to_byte(digit_val.to_int())
    write_idx = write_idx + 1
    d_idx = d_idx - 1
  }
  Ok(out.to_string())
}

///| Divide mutable `work[0..len]` in place by `d`, returning `(new_len, rem)`.
fn work_div_rem_u32(work : FixedArray[UInt], len : Int, d : UInt) -> (Int, UInt) {
  let d64 = d.to_uint64()
  let mut rem = 0UL
  let mut i = len - 1
  while i >= 0 {
    let cur = (rem << 32UL) | work[i].to_uint64()
    work[i] = (cur / d64).to_uint()
    rem = cur % d64
    i = i - 1
  }
  let mut new_len = len
  while new_len > 0 && work[new_len - 1] == 0U {
    new_len = new_len - 1
  }
  (new_len, rem.to_uint())
}

///| Format a non-zero `BigInt` in base 10 using `10^9` chunked division.
fn format_base10(neg : Bool, limbs : ImmArray[UInt]) -> String {
  let n = limbs.length()
  if n == 1 {
    let v = limbs[0].to_uint64()
    if neg {
      return "-" + v.to_string()
    } else {
      return v.to_string()
    }
  }
  let work = FixedArray::make(n, 0U)
  let mut i = 0
  while i < n {
    work[i] = limbs[i]
    i = i + 1
  }
  let chunks : Array[UInt] = Array::with_capacity(n * 2)
  let mut cur_len = n
  while cur_len > 0 {
    let (nl, rem) = work_div_rem_u32(work, cur_len, 1000000000U)
    chunks.push(rem)
    cur_len = nl
  }
  let mut sb = StringBuilder::new()
  if neg {
    sb.write_string("-")
  }
  let top_idx = chunks.length() - 1
  sb.write_string(chunks[top_idx].to_string())
  let mut idx = top_idx - 1
  let mut pad = Bytes::new(9)
  while idx >= 0 {
    let mut v = chunks[idx].to_int()
    let mut p = 8
    while p >= 0 {
      pad[p] = (48 + (v % 10)).to_byte()
      v = v / 10
      p = p - 1
    }
    sb.write_string(pad.to_string())
    idx = idx - 1
  }
  sb.to_string()
}

///| Format as a base-10 string.
pub fn BigInt::to_string(self : BigInt) -> String {
  if self.limbs.length() == 0 {
    return "0"
  }
  format_base10(self.neg, self.limbs)
}

///| Format in radix `2..=36` using lowercase `0-9a-z`.
pub fn BigInt::to_radix(self : BigInt, radix : Int) -> Result[String, BigIntError] {
  if radix < 2 || radix > 36 {
    return Err(BigIntError::InvalidRadix)
  }
  if self.limbs.length() == 0 {
    return Ok("0")
  }
  if radix == 10 {
    return Ok(format_base10(self.neg, self.limbs))
  }
  if radix == 2 {
    return format_pow2(self.neg, self.limbs, 1)
  }
  if radix == 4 {
    return format_pow2(self.neg, self.limbs, 2)
  }
  if radix == 8 {
    return format_pow2(self.neg, self.limbs, 3)
  }
  if radix == 16 {
    return format_pow2(self.neg, self.limbs, 4)
  }
  if radix == 32 {
    return format_pow2(self.neg, self.limbs, 5)
  }
  // General radix: chunk by radix^k <= 2^32 - 1
  let k = max_chunk_digits(radix)
  let r64 = radix.to_int64().to_uint64()
  let mut chunk_base = 1UL
  let mut c = 0
  while c < k {
    chunk_base = chunk_base * r64
    c = c + 1
  }
  let base_u32 = chunk_base.to_uint()
  let n = self.limbs.length()
  let work = FixedArray::make(n, 0U)
  let mut i = 0
  while i < n {
    work[i] = self.limbs[i]
    i = i + 1
  }
  let chunks : Array[UInt] = Array::with_capacity(n * 2)
  let mut cur_len = n
  while cur_len > 0 {
    let (nl, rem) = work_div_rem_u32(work, cur_len, base_u32)
    chunks.push(rem)
    cur_len = nl
  }
  let mut sb = StringBuilder::new()
  if self.neg {
    sb.write_string("-")
  }
  let top_idx = chunks.length() - 1
  // Format top chunk without leading zeros
  let mut top_v = chunks[top_idx].to_uint64()
  let top_digits : Array[Byte] = Array::with_capacity(k)
  while top_v > 0UL {
    top_digits.push(digit_to_byte((top_v % r64).to_int()))
    top_v = top_v / r64
  }
  let mut top_bytes = Bytes::new(top_digits.length())
  let mut ti = 0
  while ti < top_digits.length() {
    top_bytes[ti] = top_digits[top_digits.length() - 1 - ti]
    ti = ti + 1
  }
  sb.write_string(top_bytes.to_string())
  // Format remaining chunks zero-padded to width k
  let mut pad = Bytes::new(k)
  let mut idx = top_idx - 1
  while idx >= 0 {
    let mut v = chunks[idx].to_uint64()
    let mut p = k - 1
    while p >= 0 {
      pad[p] = digit_to_byte((v % r64).to_int())
      v = v / r64
      p = p - 1
    }
    sb.write_string(pad.to_string())
    idx = idx - 1
  }
  Ok(sb.to_string())
}
