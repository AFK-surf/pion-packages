///| Arithmetic, Knuth Algorithm D division, bitwise ops, pow, gcd, and `BigIntBuf`.

// ── Core unsigned magnitude operations (base 2^32, little-endian limbs) ──

///| Add two unsigned magnitudes: `a + b`.
fn add_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  if al == 0 {
    return b
  }
  if bl == 0 {
    return a
  }
  let max_len = if al > bl { al } else { bl }
  let out : Array[UInt] = Array::with_capacity(max_len + 1)
  let mut carry = 0UL
  let mut i = 0
  while i < max_len {
    let av = if i < al { a[i].to_uint64() } else { 0UL }
    let bv = if i < bl { b[i].to_uint64() } else { 0UL }
    let s = av + bv + carry
    out.push((s & 0xFFFFFFFFUL).to_uint())
    carry = s >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    out.push(carry.to_uint())
  }
  out.to_imm()
}

///| Subtract two unsigned magnitudes assuming `|a| >= |b|`: `a - b`.
fn sub_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  let out : Array[UInt] = Array::with_capacity(al)
  let mut borrow = 0UL
  let mut i = 0
  while i < al {
    let av = a[i].to_uint64()
    let bv = (if i < bl { b[i].to_uint64() } else { 0UL }) + borrow
    if av >= bv {
      out.push((av - bv).to_uint())
      borrow = 0UL
    } else {
      out.push(((av + 0x100000000UL) - bv).to_uint())
      borrow = 1UL
    }
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Add unsigned `k` to unsigned magnitude `a`.
fn add_mag_uint(a : ImmArray[UInt], k : UInt) -> ImmArray[UInt] {
  if k == 0U {
    return a
  }
  let al = a.length()
  if al == 0 {
    return [k]
  }
  let out : Array[UInt] = Array::with_capacity(al + 1)
  let mut carry = k.to_uint64()
  let mut i = 0
  while i < al {
    let s = a[i].to_uint64() + carry
    out.push((s & 0xFFFFFFFFUL).to_uint())
    carry = s >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    out.push(carry.to_uint())
  }
  out.to_imm()
}

///| Subtract unsigned `k` from unsigned magnitude `a` assuming `|a| >= k`.
fn sub_mag_uint(a : ImmArray[UInt], k : UInt) -> ImmArray[UInt] {
  if k == 0U {
    return a
  }
  let al = a.length()
  let out : Array[UInt] = Array::with_capacity(al)
  let mut borrow = k.to_uint64()
  let mut i = 0
  while i < al {
    let av = a[i].to_uint64()
    if av >= borrow {
      out.push((av - borrow).to_uint())
      borrow = 0UL
    } else {
      out.push(((av + 0x100000000UL) - borrow).to_uint())
      borrow = 1UL
    }
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Multiply unsigned magnitude `a` by unsigned 32-bit `k`.
fn mul_mag_uint(a : ImmArray[UInt], k : UInt) -> ImmArray[UInt] {
  let al = a.length()
  if al == 0 || k == 0U {
    return ImmArray::new()
  }
  if k == 1U {
    return a
  }
  let k64 = k.to_uint64()
  let out : Array[UInt] = Array::with_capacity(al + 1)
  let mut carry = 0UL
  let mut i = 0
  while i < al {
    let prod = a[i].to_uint64() * k64 + carry
    out.push((prod & 0xFFFFFFFFUL).to_uint())
    carry = prod >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    out.push(carry.to_uint())
  }
  out.to_imm()
}

///| Multiply two unsigned magnitudes (schoolbook base 2^32).
fn mul_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  if al == 0 || bl == 0 {
    return ImmArray::new()
  }
  if al == 1 {
    return mul_mag_uint(b, a[0])
  }
  if bl == 1 {
    return mul_mag_uint(a, b[0])
  }
  let out_len = al + bl
  let out = FixedArray::make(out_len, 0U)
  let mut i = 0
  while i < al {
    let ai = a[i].to_uint64()
    if ai != 0UL {
      let mut carry = 0UL
      let mut j = 0
      while j < bl {
        let cur = out[i + j].to_uint64() + ai * b[j].to_uint64() + carry
        out[i + j] = (cur & 0xFFFFFFFFUL).to_uint()
        carry = cur >> 32UL
        j = j + 1
      }
      out[i + bl] = (out[i + bl].to_uint64() + carry).to_uint()
    }
    i = i + 1
  }
  let mut n = out_len
  while n > 0 && out[n - 1] == 0U {
    n = n - 1
  }
  if n == 0 {
    return ImmArray::new()
  }
  let arr : Array[UInt] = Array::with_capacity(n)
  let mut idx = 0
  while idx < n {
    arr.push(out[idx])
    idx = idx + 1
  }
  arr.to_imm()
}

///| Divide unsigned magnitude `u` by non-zero single limb `d`, returning `(q, r)`.
fn div_rem_uint_mag(u : ImmArray[UInt], d : UInt) -> (ImmArray[UInt], UInt) {
  if d == 0U {
    panic("BigInt division by zero")
  }
  let n = u.length()
  if n == 0 {
    return (ImmArray::new(), 0U)
  }
  if d == 1U {
    return (u, 0U)
  }
  let d64 = d.to_uint64()
  let q = FixedArray::make(n, 0U)
  let mut rem = 0UL
  let mut i = n - 1
  while i >= 0 {
    let cur = (rem << 32UL) | u[i].to_uint64()
    q[i] = (cur / d64).to_uint()
    rem = cur % d64
    i = i - 1
  }
  let mut qlen = n
  while qlen > 0 && q[qlen - 1] == 0U {
    qlen = qlen - 1
  }
  if qlen == 0 {
    return (ImmArray::new(), rem.to_uint())
  }
  let arr : Array[UInt] = Array::with_capacity(qlen)
  let mut idx = 0
  while idx < qlen {
    arr.push(q[idx])
    idx = idx + 1
  }
  (arr.to_imm(), rem.to_uint())
}

///| Knuth Algorithm D (TAOCP Vol. 2 §4.3.1, base B = 2^32): unsigned division `u / v`.
fn div_rem_mag(u : ImmArray[UInt], v : ImmArray[UInt]) -> (ImmArray[UInt], ImmArray[UInt]) {
  let vlen = v.length()
  if vlen == 0 {
    panic("BigInt division by zero")
  }
  let c = cmp_mag(u, v)
  if c < 0 {
    return (ImmArray::new(), u)
  }
  if c == 0 {
    return ([1U], ImmArray::new())
  }
  if vlen == 1 {
    let (q, r) = div_rem_uint_mag(u, v[0])
    let r_imm : ImmArray[UInt] = if r == 0U { ImmArray::new() } else { [r] }
    return (q, r_imm)
  }

  let ulen = u.length()
  let n = vlen
  let m = ulen - n
  let s = clz32(v[n - 1])

  // Step D1: Normalize `v` and `u` by shifting left by `s` (0..=31).
  let vn = FixedArray::make(n, 0U)
  let un = FixedArray::make(ulen + 1, 0U)
  if s == 0 {
    let mut i = 0
    while i < n {
      vn[i] = v[i]
      i = i + 1
    }
    i = 0
    while i < ulen {
      un[i] = u[i]
      i = i + 1
    }
    un[ulen] = 0U
  } else {
    let su = s.to_uint()
    let rsu = (32 - s).to_uint()
    let mut i = n - 1
    while i > 0 {
      vn[i] = (v[i] << su) | (v[i - 1] >> rsu)
      i = i - 1
    }
    vn[0] = v[0] << su

    un[ulen] = u[ulen - 1] >> rsu
    i = ulen - 1
    while i > 0 {
      un[i] = (u[i] << su) | (u[i - 1] >> rsu)
      i = i - 1
    }
    un[0] = u[0] << su
  }

  let q = FixedArray::make(m + 1, 0U)
  let v1 = vn[n - 1].to_uint64()
  let v2 = vn[n - 2].to_uint64()

  // Step D2..D7: Loop `j` from `m` down to `0`.
  let mut j = m
  while j >= 0 {
    // Step D3: Estimate `qhat` and `rhat` safely without UInt64 overflow.
    let u_hi = un[j + n].to_uint64()
    let u_lo = un[j + n - 1].to_uint64()
    let u_next = un[j + n - 2].to_uint64()
    let mut qhat = 0UL
    let mut rhat = 0UL
    if u_hi >= v1 {
      qhat = 0xFFFFFFFFUL
      rhat = u_lo + v1
    } else {
      let num = (u_hi << 32UL) | u_lo
      qhat = num / v1
      rhat = num % v1
    }
    // Check `rhat < B` BEFORE forming `(rhat << 32) + u_next` to prevent UInt64 overflow.
    while rhat < 0x100000000UL {
      if qhat * v2 > (rhat << 32UL) + u_next {
        qhat = qhat - 1UL
        rhat = rhat + v1
      } else {
        break
      }
    }

    // Step D4: Multiply and subtract `un[j..j+n+1] -= qhat * vn[0..n]`.
    let mut k = 0UL
    let mut borrow = 0UL
    let mut i = 0
    while i < n {
      let p = qhat * vn[i].to_uint64() + k
      let lo = p & 0xFFFFFFFFUL
      k = p >> 32UL
      let sub = lo + borrow
      let cur = un[j + i].to_uint64()
      if cur >= sub {
        un[j + i] = (cur - sub).to_uint()
        borrow = 0UL
      } else {
        un[j + i] = ((cur + 0x100000000UL) - sub).to_uint()
        borrow = 1UL
      }
      i = i + 1
    }
    let top_sub = k + borrow
    let top_cur = un[j + n].to_uint64()
    let negative = top_cur < top_sub
    if !negative {
      un[j + n] = (top_cur - top_sub).to_uint()
    } else {
      // Step D6: Add back `vn[0..n]` and decrement `qhat`.
      un[j + n] = ((top_cur + 0x100000000UL) - top_sub).to_uint()
      qhat = qhat - 1UL
      let mut carry = 0UL
      i = 0
      while i < n {
        let sum = un[j + i].to_uint64() + vn[i].to_uint64() + carry
        un[j + i] = (sum & 0xFFFFFFFFUL).to_uint()
        carry = sum >> 32UL
        i = i + 1
      }
      un[j + n] = (un[j + n].to_uint64() + carry).to_uint()
    }

    q[j] = qhat.to_uint()
    j = j - 1
  }

  // Step D8: Unnormalize remainder `un[0..n] >> s`.
  let rem = FixedArray::make(n, 0U)
  if s == 0 {
    let mut i = 0
    while i < n {
      rem[i] = un[i]
      i = i + 1
    }
  } else {
    let su = s.to_uint()
    let lsu = (32 - s).to_uint()
    let mut i = 0
    while i < n - 1 {
      rem[i] = (un[i] >> su) | (un[i + 1] << lsu)
      i = i + 1
    }
    rem[n - 1] = un[n - 1] >> su
  }

  // Trim quotient and remainder to canonical ImmArray[UInt].
  let mut qlen = m + 1
  while qlen > 0 && q[qlen - 1] == 0U {
    qlen = qlen - 1
  }
  let q_arr : Array[UInt] = Array::with_capacity(qlen)
  let mut qi = 0
  while qi < qlen {
    q_arr.push(q[qi])
    qi = qi + 1
  }

  let mut rlen = n
  while rlen > 0 && rem[rlen - 1] == 0U {
    rlen = rlen - 1
  }
  let r_arr : Array[UInt] = Array::with_capacity(rlen)
  let mut ri = 0
  while ri < rlen {
    r_arr.push(rem[ri])
    ri = ri + 1
  }

  (q_arr.to_imm(), r_arr.to_imm())
}

// ── Public signed BigInt arithmetic ──

///| Addition `self + other`.
pub fn BigInt::add(self : BigInt, other : BigInt) -> BigInt {
  if self.limbs.length() == 0 {
    return other
  }
  if other.limbs.length() == 0 {
    return self
  }
  if self.neg == other.neg {
    BigInt::{ neg: self.neg, limbs: add_mag(self.limbs, other.limbs) }
  } else {
    let c = cmp_mag(self.limbs, other.limbs)
    if c == 0 {
      BigInt::zero()
    } else if c > 0 {
      BigInt::{ neg: self.neg, limbs: sub_mag(self.limbs, other.limbs) }
    } else {
      BigInt::{ neg: other.neg, limbs: sub_mag(other.limbs, self.limbs) }
    }
  }
}

///| Subtraction `self - other`.
pub fn BigInt::sub(self : BigInt, other : BigInt) -> BigInt {
  if other.limbs.length() == 0 {
    return self
  }
  if self.limbs.length() == 0 {
    return other.neg()
  }
  if self.neg != other.neg {
    BigInt::{ neg: self.neg, limbs: add_mag(self.limbs, other.limbs) }
  } else {
    let c = cmp_mag(self.limbs, other.limbs)
    if c == 0 {
      BigInt::zero()
    } else if c > 0 {
      BigInt::{ neg: self.neg, limbs: sub_mag(self.limbs, other.limbs) }
    } else {
      BigInt::{ neg: !self.neg, limbs: sub_mag(other.limbs, self.limbs) }
    }
  }
}

///| Multiplication `self * other`.
pub fn BigInt::mul(self : BigInt, other : BigInt) -> BigInt {
  if self.limbs.length() == 0 || other.limbs.length() == 0 {
    return BigInt::zero()
  }
  let res = mul_mag(self.limbs, other.limbs)
  if res.length() == 0 {
    BigInt::zero()
  } else {
    BigInt::{ neg: self.neg != other.neg, limbs: res }
  }
}

///| Simultaneous truncating quotient and remainder `(self / other, self % other)`.
pub fn BigInt::div_rem(self : BigInt, other : BigInt) -> (BigInt, BigInt) {
  if other.limbs.length() == 0 {
    panic("BigInt division by zero")
  }
  if self.limbs.length() == 0 {
    return (BigInt::zero(), BigInt::zero())
  }
  let (q_mag, r_mag) = div_rem_mag(self.limbs, other.limbs)
  let q = if q_mag.length() == 0 {
    BigInt::zero()
  } else {
    BigInt::{ neg: self.neg != other.neg, limbs: q_mag }
  }
  let r = if r_mag.length() == 0 {
    BigInt::zero()
  } else {
    BigInt::{ neg: self.neg, limbs: r_mag }
  }
  (q, r)
}

///| Zero-allocation fast path for `floor(u / v)` when `u >= v`, `v.len >= 2`, and the quotient fits in a single `UInt`
///| (`u.len == v.len`, or `u.len == v.len + 1 && u[u.len - 1] < v[v.len - 1]`).
fn div_single_limb_mag(u : ImmArray[UInt], v : ImmArray[UInt]) -> UInt {
  let ul = u.length()
  let vl = v.length()
  let shift = clz32(v[vl - 1])
  let sh64 = shift.to_int64().to_uint64()
  let rsh64 = (32 - shift).to_int64().to_uint64()
  let d_hi = if shift == 0 {
    v[vl - 1].to_uint64()
  } else {
    ((v[vl - 1].to_uint64() << sh64) | (v[vl - 2].to_uint64() >> rsh64)) & 0xFFFFFFFFUL
  }
  let n_top = if ul == vl {
    if shift == 0 {
      u[ul - 1].to_uint64()
    } else {
      (u[ul - 1].to_uint64() << sh64) | (u[ul - 2].to_uint64() >> rsh64)
    }
  } else if shift == 0 {
    (u[ul - 1].to_uint64() << 32UL) | u[ul - 2].to_uint64()
  } else {
    let w2 = u[ul - 1].to_uint64()
    let w1 = u[ul - 2].to_uint64()
    let w0 = u[ul - 3].to_uint64()
    let hi = (w2 << sh64) | (w1 >> rsh64)
    let lo = ((w1 << sh64) | (w0 >> rsh64)) & 0xFFFFFFFFUL
    (hi << 32UL) | lo
  }
  let mut q = n_top / d_hi
  let rem_est = n_top - q * d_hi
  if rem_est >= q && q <= 0xFFFFFFFFUL {
    return q.to_uint()
  }
  if q > 0xFFFFFFFFUL {
    q = 0xFFFFFFFFUL
  }
  while q > 0UL {
    let mut carry = 0UL
    let mut borrow = 0UL
    let mut i = 0
    while i < vl {
      let p = v[i].to_uint64() * q + carry
      let lo = p & 0xFFFFFFFFUL
      carry = p >> 32UL
      let sub = lo + borrow
      let av = u[i].to_uint64()
      if av >= sub {
        borrow = 0UL
      } else {
        borrow = 1UL
      }
      i = i + 1
    }
    let rem_top = carry + borrow
    let u_top = if vl < ul { u[vl].to_uint64() } else { 0UL }
    if u_top >= rem_top {
      return q.to_uint()
    }
    q = q - 1UL
  }
  0U
}

///| Truncating division toward zero `self / other` (panics if `other == 0`).
pub fn BigInt::div(self : BigInt, other : BigInt) -> BigInt {
  let vl = other.limbs.length()
  if vl == 0 {
    panic("BigInt division by zero")
  }
  let ul = self.limbs.length()
  if ul == 0 {
    return BigInt::zero()
  }
  if vl >= 2 && (ul == vl || (ul == vl + 1 && self.limbs[ul - 1] < other.limbs[vl - 1])) {
    let c = cmp_mag(self.limbs, other.limbs)
    if c < 0 {
      return BigInt::zero()
    }
    if c == 0 {
      return BigInt::{ neg: self.neg != other.neg, limbs: [1U] }
    }
    let q = div_single_limb_mag(self.limbs, other.limbs)
    return BigInt::{ neg: self.neg != other.neg, limbs: [q] }
  }
  let (q, _) = self.div_rem(other)
  q
}

///| Truncating remainder `self % other` (sign matches `self` or `0`; panics if `other == 0`).
pub fn BigInt::rem(self : BigInt, other : BigInt) -> BigInt {
  let (_, r) = self.div_rem(other)
  r
}

// ── Single-limb fast paths ──

///| Single-limb fast path: `self + v`.
pub fn BigInt::add_int(self : BigInt, v : Int) -> BigInt {
  if v == 0 {
    return self
  }
  if self.limbs.length() == 0 {
    return BigInt::from_int(v)
  }
  let v_neg = v < 0
  let v_mag = if v_neg { (0L - v.to_int64()).to_uint64().to_uint() } else { v.to_uint() }
  if self.neg == v_neg {
    BigInt::{ neg: self.neg, limbs: add_mag_uint(self.limbs, v_mag) }
  } else if self.limbs.length() > 1 || self.limbs[0] > v_mag {
    BigInt::{ neg: self.neg, limbs: sub_mag_uint(self.limbs, v_mag) }
  } else if self.limbs[0] == v_mag {
    BigInt::zero()
  } else {
    BigInt::{ neg: v_neg, limbs: [v_mag - self.limbs[0]] }
  }
}

///| Single-limb fast path: `self * v` (unsigned 32-bit).
pub fn BigInt::mul_uint(self : BigInt, v : UInt) -> BigInt {
  if self.limbs.length() == 0 || v == 0U {
    return BigInt::zero()
  }
  if v == 1U {
    return self
  }
  BigInt::{ neg: self.neg, limbs: mul_mag_uint(self.limbs, v) }
}

///| Single-limb fast path: `self * v`.
pub fn BigInt::mul_int(self : BigInt, v : Int) -> BigInt {
  if self.limbs.length() == 0 || v == 0 {
    return BigInt::zero()
  }
  if v == 1 {
    return self
  }
  if v == -1 {
    return self.neg()
  }
  let v_neg = v < 0
  let v_mag = if v_neg { (0L - v.to_int64()).to_uint64().to_uint() } else { v.to_uint() }
  BigInt::{ neg: self.neg != v_neg, limbs: mul_mag_uint(self.limbs, v_mag) }
}

///| Fused single-limb multiply-add: `self + other * k`.
pub fn BigInt::add_mul_int(self : BigInt, other : BigInt, k : Int) -> BigInt {
  if k == 0 || other.limbs.length() == 0 {
    return self
  }
  if self.limbs.length() == 0 {
    return other.mul_int(k)
  }
  let k_neg = k < 0
  let k_mag = if k_neg { (0L - k.to_int64()).to_uint64().to_uint() } else { k.to_uint() }
  let prod_neg = other.neg != k_neg
  if self.neg == prod_neg {
    // Same sign: single-pass fused `|self| + |other| * k_mag`.
    let al = self.limbs.length()
    let bl = other.limbs.length()
    let max_len = if al > bl { al } else { bl }
    let out : Array[UInt] = Array::with_capacity(max_len + 1)
    let k64 = k_mag.to_uint64()
    let mut carry = 0UL
    let mut i = 0
    while i < max_len {
      let av = if i < al { self.limbs[i].to_uint64() } else { 0UL }
      let bv = if i < bl { other.limbs[i].to_uint64() } else { 0UL }
      let s = av + bv * k64 + carry
      out.push((s & 0xFFFFFFFFUL).to_uint())
      carry = s >> 32UL
      i = i + 1
    }
    if carry != 0UL {
      out.push(carry.to_uint())
    }
    BigInt::{ neg: self.neg, limbs: out.to_imm() }
  } else {
    let prod = BigInt::{ neg: prod_neg, limbs: mul_mag_uint(other.limbs, k_mag) }
    self.add(prod)
  }
}

///| Single-limb division by unsigned `d > 0`: returns `(quotient_with_sign, |self| % d)`.
pub fn BigInt::div_rem_uint(self : BigInt, d : UInt) -> (BigInt, UInt) {
  if d == 0U {
    panic("BigInt division by zero")
  }
  if self.limbs.length() == 0 {
    return (BigInt::zero(), 0U)
  }
  let (q_mag, rem) = div_rem_uint_mag(self.limbs, d)
  let q = if q_mag.length() == 0 {
    BigInt::zero()
  } else {
    BigInt::{ neg: self.neg, limbs: q_mag }
  }
  (q, rem)
}

// ── Shifts & Two's-Complement Bitwise Operations ──

///| Left shift `self << n` (panics if `n < 0`).
pub fn BigInt::shl(self : BigInt, n : Int) -> BigInt {
  if n < 0 {
    panic("BigInt::shl: negative shift count")
  }
  let len = self.limbs.length()
  if len == 0 || n == 0 {
    return self
  }
  let word_shift = n / 32
  let bit_shift = n % 32
  let out : Array[UInt] = Array::with_capacity(len + word_shift + 1)
  let mut i = 0
  while i < word_shift {
    out.push(0U)
    i = i + 1
  }
  if bit_shift == 0 {
    i = 0
    while i < len {
      out.push(self.limbs[i])
      i = i + 1
    }
  } else {
    let ls = bit_shift.to_uint()
    let rs = (32 - bit_shift).to_uint()
    let mut carry = 0U
    i = 0
    while i < len {
      let cur = self.limbs[i]
      out.push((cur << ls) | carry)
      carry = cur >> rs
      i = i + 1
    }
    if carry != 0U {
      out.push(carry)
    }
  }
  BigInt::{ neg: self.neg, limbs: out.to_imm() }
}

///| Arithmetic right shift `self >> n` (floor toward -infinity for negatives; panics if `n < 0`).
pub fn BigInt::shr(self : BigInt, n : Int) -> BigInt {
  if n < 0 {
    panic("BigInt::shr: negative shift count")
  }
  let len = self.limbs.length()
  if len == 0 || n == 0 {
    return self
  }
  let word_shift = n / 32
  let bit_shift = n % 32
  if word_shift >= len {
    if self.neg {
      return BigInt::from_int(-1)
    } else {
      return BigInt::zero()
    }
  }
  // Check whether any shifted-out bit is non-zero (needed for negative floor rounding).
  let mut had_low_bits = false
  if self.neg {
    let mut k = 0
    while k < word_shift {
      if self.limbs[k] != 0U {
        had_low_bits = true
        break
      }
      k = k + 1
    }
    if !had_low_bits && bit_shift > 0 {
      let mask = (1U << bit_shift.to_uint()) - 1U
      if (self.limbs[word_shift] & mask) != 0U {
        had_low_bits = true
      }
    }
  }
  let rem_len = len - word_shift
  let out : Array[UInt] = Array::with_capacity(rem_len)
  if bit_shift == 0 {
    let mut i = 0
    while i < rem_len {
      out.push(self.limbs[word_shift + i])
      i = i + 1
    }
  } else {
    let rs = bit_shift.to_uint()
    let ls = (32 - bit_shift).to_uint()
    let mut i = 0
    while i < rem_len - 1 {
      out.push((self.limbs[word_shift + i] >> rs) | (self.limbs[word_shift + i + 1] << ls))
      i = i + 1
    }
    let top = self.limbs[len - 1] >> rs
    if top != 0U {
      out.push(top)
    }
  }
  let shifted = from_array_trimmed(self.neg, out)
  if self.neg && had_low_bits {
    shifted.add_int(-1)
  } else {
    shifted
  }
}

///| Checked left shift returning `Err(NegativeShift)` if `n < 0`.
pub fn BigInt::checked_shl(self : BigInt, n : Int) -> Result[BigInt, BigIntError] {
  if n < 0 {
    Err(BigIntError::NegativeShift)
  } else {
    Ok(self.shl(n))
  }
}

///| Checked arithmetic right shift returning `Err(NegativeShift)` if `n < 0`.
pub fn BigInt::checked_shr(self : BigInt, n : Int) -> Result[BigInt, BigIntError] {
  if n < 0 {
    Err(BigIntError::NegativeShift)
  } else {
    Ok(self.shr(n))
  }
}

///| Bitwise AND of two non-negative magnitudes.
fn and_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  let n = if al < bl { al } else { bl }
  let out : Array[UInt] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    out.push(a[i] & b[i])
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Bitwise AND-NOT of two non-negative magnitudes: `a & ~b`.
fn and_not_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  let out : Array[UInt] = Array::with_capacity(al)
  let mut i = 0
  while i < al {
    let bv = if i < bl { b[i] } else { 0U }
    out.push(a[i] & (bv ^ 0xFFFFFFFFU))
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Bitwise OR of two non-negative magnitudes.
fn or_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  let n = if al > bl { al } else { bl }
  let out : Array[UInt] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let av = if i < al { a[i] } else { 0U }
    let bv = if i < bl { b[i] } else { 0U }
    out.push(av | bv)
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Bitwise XOR of two non-negative magnitudes.
fn xor_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> ImmArray[UInt] {
  let al = a.length()
  let bl = b.length()
  let n = if al > bl { al } else { bl }
  let out : Array[UInt] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let av = if i < al { a[i] } else { 0U }
    let bv = if i < bl { b[i] } else { 0U }
    out.push(av ^ bv)
    i = i + 1
  }
  while out.length() > 0 && out[out.length() - 1] == 0U {
    let _ = out.pop()
  }
  out.to_imm()
}

///| Bitwise NOT `~self == -(self + 1)`.
pub fn BigInt::bit_not(self : BigInt) -> BigInt {
  self.add_int(1).neg()
}

///| Bitwise AND (infinite two's-complement semantics for negatives).
pub fn BigInt::bit_and(self : BigInt, other : BigInt) -> BigInt {
  if !self.neg && !other.neg {
    let m = and_mag(self.limbs, other.limbs)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  } else if !self.neg && other.neg {
    // a & ~(mb - 1) = +(a & ~(mb - 1))
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = and_not_mag(self.limbs, mb1)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  } else if self.neg && !other.neg {
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let m = and_not_mag(other.limbs, ma1)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  } else {
    // ~(ma - 1) & ~(mb - 1) = -(((ma - 1) | (mb - 1)) + 1)
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = add_mag_uint(or_mag(ma1, mb1), 1U)
    BigInt::{ neg: true, limbs: m }
  }
}

///| Bitwise OR (infinite two's-complement semantics for negatives).
pub fn BigInt::bit_or(self : BigInt, other : BigInt) -> BigInt {
  if !self.neg && !other.neg {
    let m = or_mag(self.limbs, other.limbs)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  } else if !self.neg && other.neg {
    // a | ~(mb - 1) = -(((mb - 1) & ~a) + 1)
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = add_mag_uint(and_not_mag(mb1, self.limbs), 1U)
    BigInt::{ neg: true, limbs: m }
  } else if self.neg && !other.neg {
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let m = add_mag_uint(and_not_mag(ma1, other.limbs), 1U)
    BigInt::{ neg: true, limbs: m }
  } else {
    // ~(ma - 1) | ~(mb - 1) = -(((ma - 1) & (mb - 1)) + 1)
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = add_mag_uint(and_mag(ma1, mb1), 1U)
    BigInt::{ neg: true, limbs: m }
  }
}

///| Bitwise XOR (infinite two's-complement semantics for negatives).
pub fn BigInt::bit_xor(self : BigInt, other : BigInt) -> BigInt {
  if !self.neg && !other.neg {
    let m = xor_mag(self.limbs, other.limbs)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  } else if !self.neg && other.neg {
    // a ^ ~(mb - 1) = -((a ^ (mb - 1)) + 1)
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = add_mag_uint(xor_mag(self.limbs, mb1), 1U)
    BigInt::{ neg: true, limbs: m }
  } else if self.neg && !other.neg {
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let m = add_mag_uint(xor_mag(ma1, other.limbs), 1U)
    BigInt::{ neg: true, limbs: m }
  } else {
    // ~(ma - 1) ^ ~(mb - 1) = +((ma - 1) ^ (mb - 1))
    let ma1 = sub_mag_uint(self.limbs, 1U)
    let mb1 = sub_mag_uint(other.limbs, 1U)
    let m = xor_mag(ma1, mb1)
    if m.length() == 0 { BigInt::zero() } else { BigInt::{ neg: false, limbs: m } }
  }
}

// ── Exponentiation & GCD ──

///| Exponentiation `self^exp` (`exp < 0` returns `Err(NegativeExponent)`; `0^0 == 1`).
pub fn BigInt::pow(self : BigInt, exp : Int) -> Result[BigInt, BigIntError] {
  if exp < 0 {
    return Err(BigIntError::NegativeExponent)
  }
  if exp == 0 {
    return Ok(BigInt::one())
  }
  if exp == 1 {
    return Ok(self)
  }
  if self.limbs.length() == 0 {
    return Ok(BigInt::zero())
  }
  let mut base = self
  let mut e = exp
  let mut acc = BigInt::one()
  while e > 0 {
    if (e & 1) == 1 {
      acc = acc.mul(base)
    }
    e = e >> 1
    if e > 0 {
      base = base.mul(base)
    }
  }
  Ok(acc)
}

///| Fast Euclidean GCD on `UInt64`.
fn gcd_u64(a0 : UInt64, b0 : UInt64) -> UInt64 {
  let mut a = a0
  let mut b = b0
  while b != 0UL {
    let r = a % b
    a = b
    b = r
  }
  a
}

///| Greatest common divisor (always non-negative; `gcd(0, 0) == 0`).
pub fn BigInt::gcd(self : BigInt, other : BigInt) -> BigInt {
  let mut a = self.abs()
  let mut b = other.abs()
  if a.limbs.length() == 0 {
    return b
  }
  if b.limbs.length() == 0 {
    return a
  }
  while b.limbs.length() > 0 {
    if a.limbs.length() <= 2 && b.limbs.length() <= 2 {
      let av = a.limbs[0].to_uint64() | (if a.limbs.length() == 2 { a.limbs[1].to_uint64() << 32UL } else { 0UL })
      let bv = b.limbs[0].to_uint64() | (if b.limbs.length() == 2 { b.limbs[1].to_uint64() << 32UL } else { 0UL })
      return BigInt::from_uint64(gcd_u64(av, bv))
    }
    let r = a.rem(b)
    a = b
    b = r
  }
  a
}

// ── BigIntBuf (reusable mutable buffer for zero-allocation hot loops) ──

///| Ensure `self.limbs` has at least `need` slots.
fn buf_ensure(mut self : BigIntBuf, need : Int) -> Unit {
  if need <= self.limbs.length() {
    return
  }
  let mut new_cap = self.limbs.length() * 2
  if new_cap < need {
    new_cap = need
  }
  let next = FixedArray::make(new_cap, 0U)
  let mut i = 0
  while i < self.len {
    next[i] = self.limbs[i]
    i = i + 1
  }
  self.limbs = next
}

///| Trim trailing zeros and normalize `-0` on `BigIntBuf`.
fn buf_trim(mut self : BigIntBuf) -> Unit {
  let mut n = self.len
  while n > 0 && self.limbs[n - 1] == 0U {
    n = n - 1
  }
  self.len = n
  if n == 0 {
    self.neg = false
  }
}

///| Allocate a zero `BigIntBuf` with initial limb capacity `cap`.
pub fn BigIntBuf::new(cap : Int) -> BigIntBuf {
  let c = if cap > 0 { cap } else { 4 }
  BigIntBuf::{ neg: false, limbs: FixedArray::make(c, 0U), len: 0 }
}

///| Allocate a `BigIntBuf` initialized to `v` with capacity at least `cap`.
pub fn BigIntBuf::from_int(v : Int, cap : Int) -> BigIntBuf {
  let mut b = BigIntBuf::new(cap)
  b.set_int(v)
  b
}

///| Allocate a `BigIntBuf` copied from an immutable `BigInt`.
pub fn BigIntBuf::from_bigint(v : BigInt) -> BigIntBuf {
  let n = v.limbs.length()
  let c = if n > 4 { n } else { 4 }
  let limbs = FixedArray::make(c, 0U)
  let mut i = 0
  while i < n {
    limbs[i] = v.limbs[i]
    i = i + 1
  }
  BigIntBuf::{ neg: v.neg, limbs: limbs, len: n }
}

///| Snapshot this buffer into an immutable `Send` `BigInt`.
pub fn BigIntBuf::to_bigint(self : BigIntBuf) -> BigInt {
  from_fixed_trimmed(self.neg, self.limbs, self.len)
}

///| Reset buffer to zero without releasing capacity.
pub fn BigIntBuf::set_zero(mut self : BigIntBuf) -> Unit {
  self.neg = false
  self.len = 0
}

///| Set buffer to a signed `Int` without releasing capacity.
pub fn BigIntBuf::set_int(mut self : BigIntBuf, v : Int) -> Unit {
  if v == 0 {
    self.neg = false
    self.len = 0
  } else if v > 0 {
    buf_ensure(mut self, 1)
    self.neg = false
    self.limbs[0] = v.to_uint()
    self.len = 1
  } else {
    buf_ensure(mut self, 1)
    self.neg = true
    self.limbs[0] = (0L - v.to_int64()).to_uint64().to_uint()
    self.len = 1
  }
}

///| Copy value from `src` into `self`, reusing `self`'s backing buffer when large enough.
pub fn BigIntBuf::copy_from(mut self : BigIntBuf, src : BigIntBuf) -> Unit {
  let n = src.len
  buf_ensure(mut self, n)
  let mut i = 0
  while i < n {
    self.limbs[i] = src.limbs[i]
    i = i + 1
  }
  self.neg = src.neg
  self.len = n
}

///| In-place `self *= k` (unsigned 32-bit).
pub fn BigIntBuf::mul_uint_in_place(mut self : BigIntBuf, k : UInt) -> Unit {
  if self.len == 0 || k == 0U {
    self.neg = false
    self.len = 0
    return
  }
  if k == 1U {
    return
  }
  let n = self.len
  buf_ensure(mut self, n + 1)
  let limbs = self.limbs
  let k64 = k.to_uint64()
  let mut carry = 0UL
  let mut i = 0
  while i < n {
    let prod = limbs[i].to_uint64() * k64 + carry
    limbs[i] = (prod & 0xFFFFFFFFUL).to_uint()
    carry = prod >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    limbs[n] = carry.to_uint()
    self.len = n + 1
  }
}

///| Compare magnitudes of two `BigIntBuf`s: `-1`, `0`, or `1`.
fn buf_cmp_mag(a : BigIntBuf, b : BigIntBuf) -> Int {
  let al = a.len
  let bl = b.len
  if al < bl {
    return -1
  }
  if al > bl {
    return 1
  }
  let alimbs = a.limbs
  let blimbs = b.limbs
  let mut i = al - 1
  while i >= 0 {
    let av = alimbs[i]
    let bv = blimbs[i]
    if av < bv {
      return -1
    }
    if av > bv {
      return 1
    }
    i = i - 1
  }
  0
}

///| Compare `self` with `other`: `-1`, `0`, or `1`.
pub fn BigIntBuf::cmp(self : BigIntBuf, other : BigIntBuf) -> Int {
  if self.neg != other.neg {
    if self.neg { -1 } else { 1 }
  } else {
    let c = buf_cmp_mag(self, other)
    if self.neg { -c } else { c }
  }
}

///| In-place magnitude add: `|self| += |src| * k` (non-negative `k`).
fn buf_add_mul_mag(mut self : BigIntBuf, src : BigIntBuf, k : UInt) -> Unit {
  let sl = src.len
  if sl == 0 || k == 0U {
    return
  }
  let al = self.len
  let max_len = if al > sl { al } else { sl }
  buf_ensure(mut self, max_len + 1)
  let limbs = self.limbs
  let slimbs = src.limbs
  let k64 = k.to_uint64()
  let mut carry = 0UL
  let mut i = 0
  let min_len = if al < sl { al } else { sl }
  while i < min_len {
    let s = limbs[i].to_uint64() + slimbs[i].to_uint64() * k64 + carry
    limbs[i] = (s & 0xFFFFFFFFUL).to_uint()
    carry = s >> 32UL
    i = i + 1
  }
  while i < al {
    let s = limbs[i].to_uint64() + carry
    limbs[i] = (s & 0xFFFFFFFFUL).to_uint()
    carry = s >> 32UL
    i = i + 1
  }
  while i < sl {
    let s = slimbs[i].to_uint64() * k64 + carry
    limbs[i] = (s & 0xFFFFFFFFUL).to_uint()
    carry = s >> 32UL
    i = i + 1
  }
  if carry != 0UL {
    limbs[max_len] = carry.to_uint()
    self.len = max_len + 1
  } else {
    self.len = max_len
  }
  buf_trim(mut self)
}

///| In-place `self += src * k` (unsigned 32-bit `k`).
pub fn BigIntBuf::add_mul_uint_in_place(mut self : BigIntBuf, src : BigIntBuf, k : UInt) -> Unit {
  if src.len == 0 || k == 0U {
    return
  }
  if self.len == 0 {
    self.copy_from(src)
    self.mul_uint_in_place(k)
    return
  }
  if self.neg == src.neg {
    buf_add_mul_mag(mut self, src, k)
  } else {
    // Mixed sign: `self - (-src) * k`
    let mut tmp_src = BigIntBuf::{ neg: self.neg, limbs: src.limbs, len: src.len }
    self.sub_mul_uint_in_place(tmp_src, k)
  }
}

///| In-place `self -= src * k` (unsigned 32-bit `k`), zero-allocation for same-sign operands.
pub fn BigIntBuf::sub_mul_uint_in_place(mut self : BigIntBuf, src : BigIntBuf, k : UInt) -> Unit {
  let sl = src.len
  if sl == 0 || k == 0U {
    return
  }
  if self.len == 0 {
    self.copy_from(src)
    self.mul_uint_in_place(k)
    self.neg = !src.neg
    return
  }
  if self.neg != src.neg {
    buf_add_mul_mag(mut self, src, k)
    return
  }
  // Same sign: compute `|self| - |src| * k` in place over `work_len = max(al, sl + 1)` limbs.
  let al = self.len
  let work_len = if al > sl + 1 { al } else { sl + 1 }
  buf_ensure(mut self, work_len)
  let limbs = self.limbs
  let slimbs = src.limbs
  let mut z = al
  while z < work_len {
    limbs[z] = 0U
    z = z + 1
  }
  let k64 = k.to_uint64()
  let mut prod_carry = 0UL
  let mut borrow = 0UL
  let mut i = 0
  while i < sl {
    let p = slimbs[i].to_uint64() * k64 + prod_carry
    let lo = p & 0xFFFFFFFFUL
    prod_carry = p >> 32UL
    let sub = lo + borrow
    let av = limbs[i].to_uint64()
    if av >= sub {
      limbs[i] = (av - sub).to_uint()
      borrow = 0UL
    } else {
      limbs[i] = ((av + 0x100000000UL) - sub).to_uint()
      borrow = 1UL
    }
    i = i + 1
  }
  let mut rem_sub = prod_carry + borrow
  while i < work_len && rem_sub > 0UL {
    let av = limbs[i].to_uint64()
    if av >= rem_sub {
      limbs[i] = (av - rem_sub).to_uint()
      rem_sub = 0UL
    } else {
      limbs[i] = ((av + 0x100000000UL) - rem_sub).to_uint()
      rem_sub = 1UL
    }
    i = i + 1
  }
  if rem_sub > 0UL {
    // Underflow: `|self| < |src| * k`. Negate two's-complement magnitude in place and flip sign.
    let mut carry = 1UL
    let mut j = 0
    while j < work_len {
      let v = (limbs[j] ^ 0xFFFFFFFFU).to_uint64() + carry
      limbs[j] = (v & 0xFFFFFFFFUL).to_uint()
      carry = v >> 32UL
      j = j + 1
    }
    self.neg = !self.neg
  }
  self.len = work_len
  buf_trim(mut self)
}

///| In-place `self += src`.
pub fn BigIntBuf::add_in_place(mut self : BigIntBuf, src : BigIntBuf) -> Unit {
  self.add_mul_uint_in_place(src, 1U)
}

///| In-place `self -= src`.
pub fn BigIntBuf::sub_in_place(mut self : BigIntBuf, src : BigIntBuf) -> Unit {
  self.sub_mul_uint_in_place(src, 1U)
}

///| Internal helper returning `(Option[UInt], decrement_steps)` so tests can assert O(1) bounded refinement (`steps <= 2`).
fn buf_div_small_uint_with_steps(self : BigIntBuf, denom : BigIntBuf) -> (Option[UInt], Int) {
  let dl = denom.len
  if dl == 0 {
    panic("BigIntBuf division by zero")
  }
  let c = buf_cmp_mag(self, denom)
  if c < 0 {
    return (Some(0U), 0)
  }
  if c == 0 {
    return (Some(1U), 0)
  }
  let nl = self.len
  let slimbs = self.limbs
  let dlimbs = denom.limbs
  if dl == 1 {
    let dv = dlimbs[0]
    if nl == 1 {
      return (Some(slimbs[0] / dv), 0)
    }
    if nl == 2 && slimbs[1] < dv {
      let num = (slimbs[1].to_uint64() << 32UL) | slimbs[0].to_uint64()
      return (Some((num / dv.to_uint64()).to_uint()), 0)
    }
    return (None, 0)
  }
  if nl > dl + 1 {
    return (None, 0)
  }
  if nl == dl + 1 && slimbs[nl - 1] >= dlimbs[dl - 1] {
    if slimbs[nl - 1] > dlimbs[dl - 1] {
      return (None, 0)
    }
    // slimbs[nl - 1] == dlimbs[dl - 1]: compare slimbs[1..nl] vs dlimbs[0..dl].
    // If slimbs[1..nl] >= dlimbs[0..dl], then |self| >= 2^32 * |denom| -> None.
    let mut ge_shifted = true
    let mut k = dl - 1
    while k >= 0 {
      let sv = slimbs[k + 1]
      let dv = dlimbs[k]
      if sv != dv {
        ge_shifted = sv > dv
        break
      }
      k = k - 1
    }
    if ge_shifted {
      return (None, 0)
    }
  }
  // Normalized top-word estimation: guaranteed `hi <= 0xFFFFFFFF`, `d_hi >= 2^31`, and at most 2 decrements.
  let shift = clz32(dlimbs[dl - 1])
  let sh64 = shift.to_int64().to_uint64()
  let rsh64 = (32 - shift).to_int64().to_uint64()
  let d_hi = if shift == 0 {
    dlimbs[dl - 1].to_uint64()
  } else {
    ((dlimbs[dl - 1].to_uint64() << sh64) | (dlimbs[dl - 2].to_uint64() >> rsh64)) & 0xFFFFFFFFUL
  }
  let n_top = if nl == dl {
    if shift == 0 {
      slimbs[nl - 1].to_uint64()
    } else {
      (slimbs[nl - 1].to_uint64() << sh64) | (slimbs[nl - 2].to_uint64() >> rsh64)
    }
  } else if shift == 0 {
    (slimbs[nl - 1].to_uint64() << 32UL) | slimbs[nl - 2].to_uint64()
  } else {
    let w2 = slimbs[nl - 1].to_uint64()
    let w1 = slimbs[nl - 2].to_uint64()
    let w0 = slimbs[nl - 3].to_uint64()
    let hi = (w2 << sh64) | (w1 >> rsh64)
    let lo = ((w1 << sh64) | (w0 >> rsh64)) & 0xFFFFFFFFUL
    (hi << 32UL) | lo
  }
  let mut q = n_top / d_hi
  let rem_est = n_top - q * d_hi
  if rem_est >= q && q <= 0xFFFFFFFFUL {
    return (Some(q.to_uint()), 0)
  }
  if q > 0xFFFFFFFFUL {
    q = 0xFFFFFFFFUL
  }
  let mut steps = 0
  while q > 0UL {
    let mut carry = 0UL
    let mut borrow = 0UL
    let mut i = 0
    while i < dl {
      let p = dlimbs[i].to_uint64() * q + carry
      let lo = p & 0xFFFFFFFFUL
      carry = p >> 32UL
      let sub = lo + borrow
      let av = slimbs[i].to_uint64()
      if av >= sub {
        borrow = 0UL
      } else {
        borrow = 1UL
      }
      i = i + 1
    }
    let rem_top = carry + borrow
    let self_top = if dl < nl { slimbs[dl].to_uint64() } else { 0UL }
    if self_top >= rem_top {
      return (Some(q.to_uint()), steps)
    }
    q = q - 1UL
    steps = steps + 1
  }
  (Some(0U), steps)
}

///| Compute `floor(|self| / |denom|)` returning `Some(q)` iff the exact quotient fits in `UInt` (`0..=2^32-1`),
///| or `None` if `floor(|self| / |denom|) >= 2^32`. Panics if `denom == 0`.
pub fn BigIntBuf::div_small_uint(self : BigIntBuf, denom : BigIntBuf) -> Option[UInt] {
  let (res, _) = buf_div_small_uint_with_steps(self, denom)
  res
}
