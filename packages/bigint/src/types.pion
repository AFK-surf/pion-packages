///| Arbitrary-precision signed integer (`BigInt`) and reusable mutable buffer (`BigIntBuf`).
///|
///| Canonical invariants for `BigInt`:
///| - `0` is always uniquely represented as `neg = false` and `limbs.length() == 0` (never `-0`).
///| - No trailing high-order zero limbs (`limbs.length() == 0 || limbs[limbs.length() - 1] != 0U`).
///| - `BigInt` is an immutable `Send` value (`val struct` holding `Bool` + `ImmArray[UInt]`).

///| Error returned by fallible `BigInt` operations.
#derive(Eq)
pub enum BigIntError {
  EmptyInput
  InvalidDigit
  InvalidRadix
  NegativeExponent
  NegativeShift
}

///| Immutable, `Send` arbitrary-precision signed integer (sign-magnitude, base 2^32).
#derive(Eq)
pub val struct BigInt {
  priv neg : Bool
  priv limbs : ImmArray[UInt]
}

///| Mutable reusable arbitrary-precision signed integer buffer (`!Send`) for zero-allocation hot loops.
pub struct BigIntBuf {
  mut neg : Bool
  mut limbs : FixedArray[UInt]
  mut len : Int
}

///| Count leading zeros of a non-zero 32-bit unsigned integer (`0..31`; returns `32` for `0`).
fn clz32(x : UInt) -> Int {
  if x == 0U {
    return 32
  }
  let mut v = x
  let mut n = 0
  if (v & 0xFFFF0000U) == 0U {
    n = n + 16
    v = v << 16U
  }
  if (v & 0xFF000000U) == 0U {
    n = n + 8
    v = v << 8U
  }
  if (v & 0xF0000000U) == 0U {
    n = n + 4
    v = v << 4U
  }
  if (v & 0xC0000000U) == 0U {
    n = n + 2
    v = v << 2U
  }
  if (v & 0x80000000U) == 0U {
    n = n + 1
  }
  n
}

///| Trim trailing zero limbs from `arr` and construct a canonical `BigInt`.
fn from_array_trimmed(neg : Bool, arr : Array[UInt]) -> BigInt {
  while arr.length() > 0 && arr[arr.length() - 1] == 0U {
    let _ = arr.pop()
  }
  if arr.length() == 0 {
    BigInt::zero()
  } else {
    BigInt::{ neg: neg, limbs: arr.to_imm() }
  }
}

///| Trim trailing zero limbs from `buf[0..raw_len]` and construct a canonical `BigInt`.
fn from_fixed_trimmed(neg : Bool, buf : FixedArray[UInt], raw_len : Int) -> BigInt {
  let mut n = raw_len
  while n > 0 && buf[n - 1] == 0U {
    n = n - 1
  }
  if n == 0 {
    return BigInt::zero()
  }
  let arr : Array[UInt] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    arr.push(buf[i])
    i = i + 1
  }
  BigInt::{ neg: neg, limbs: arr.to_imm() }
}

///| Construct `0`.
pub fn BigInt::zero() -> BigInt {
  BigInt::{ neg: false, limbs: ImmArray::new() }
}

///| Construct `1`.
pub fn BigInt::one() -> BigInt {
  BigInt::{ neg: false, limbs: [1U] }
}

///| Construct from signed 32-bit `Int` (exact for `INT32_MIN`).
pub fn BigInt::from_int(v : Int) -> BigInt {
  if v == 0 {
    BigInt::zero()
  } else if v > 0 {
    BigInt::{ neg: false, limbs: [v.to_uint()] }
  } else {
    let mag = (0L - v.to_int64()).to_uint64().to_uint()
    BigInt::{ neg: true, limbs: [mag] }
  }
}

///| Construct from signed 64-bit `Int64` (exact for `INT64_MIN`).
pub fn BigInt::from_int64(v : Int64) -> BigInt {
  if v == 0L {
    return BigInt::zero()
  }
  if v > 0L {
    return BigInt::from_uint64(v.to_uint64())
  }
  // Two's-complement unsigned negation works for all negative Int64 including INT64_MIN.
  let mag = 0UL - v.to_uint64()
  let lo = (mag & 0xFFFFFFFFUL).to_uint()
  let hi = (mag >> 32UL).to_uint()
  if hi == 0U {
    BigInt::{ neg: true, limbs: [lo] }
  } else {
    BigInt::{ neg: true, limbs: [lo, hi] }
  }
}

///| Construct from unsigned 64-bit `UInt64`.
pub fn BigInt::from_uint64(v : UInt64) -> BigInt {
  if v == 0UL {
    return BigInt::zero()
  }
  let lo = (v & 0xFFFFFFFFUL).to_uint()
  let hi = (v >> 32UL).to_uint()
  if hi == 0U {
    BigInt::{ neg: false, limbs: [lo] }
  } else {
    BigInt::{ neg: false, limbs: [lo, hi] }
  }
}

///| Convert to `Int` if value is in `[-2147483648, 2147483647]`.
pub fn BigInt::to_int(self : BigInt) -> Option[Int] {
  let n = self.limbs.length()
  if n == 0 {
    return Some(0)
  }
  if n > 1 {
    return None
  }
  let w = self.limbs[0]
  if !self.neg {
    if w <= 0x7FFFFFFFU {
      Some(w.to_int())
    } else {
      None
    }
  } else if w <= 0x80000000U {
    Some((0L - w.to_uint64().to_int64()).to_int())
  } else {
    None
  }
}

///| Convert to `Int64` if value is in `[-9223372036854775808, 9223372036854775807]`.
pub fn BigInt::to_int64(self : BigInt) -> Option[Int64] {
  let n = self.limbs.length()
  if n == 0 {
    return Some(0L)
  }
  if n > 2 {
    return None
  }
  let lo = self.limbs[0].to_uint64()
  let hi = if n == 2 { self.limbs[1].to_uint64() } else { 0UL }
  let mag = lo | (hi << 32UL)
  if !self.neg {
    if mag <= 0x7FFFFFFFFFFFFFFFUL {
      Some(mag.to_int64())
    } else {
      None
    }
  } else if mag <= 0x8000000000000000UL {
    Some((0UL - mag).to_int64())
  } else {
    None
  }
}

///| Convert to `UInt64` if value is in `[0, 18446744073709551615]`.
pub fn BigInt::to_uint64(self : BigInt) -> Option[UInt64] {
  if self.neg {
    return None
  }
  let n = self.limbs.length()
  if n == 0 {
    return Some(0UL)
  }
  if n > 2 {
    return None
  }
  let lo = self.limbs[0].to_uint64()
  let hi = if n == 2 { self.limbs[1].to_uint64() } else { 0UL }
  Some(lo | (hi << 32UL))
}

///| Return `true` iff `self == 0`.
pub fn BigInt::is_zero(self : BigInt) -> Bool {
  self.limbs.length() == 0
}

///| Return `true` iff `self < 0`.
pub fn BigInt::is_neg(self : BigInt) -> Bool {
  self.neg
}

///| Return `true` iff `self > 0`.
pub fn BigInt::is_pos(self : BigInt) -> Bool {
  !self.neg && self.limbs.length() > 0
}

///| Return `-1` if `self < 0`, `0` if `self == 0`, `+1` if `self > 0`.
pub fn BigInt::signum(self : BigInt) -> Int {
  if self.limbs.length() == 0 {
    0
  } else if self.neg {
    -1
  } else {
    1
  }
}

///| Return minimum number of bits to represent `|self|` (`0` for `0`).
pub fn BigInt::bit_len(self : BigInt) -> Int {
  let n = self.limbs.length()
  if n == 0 {
    return 0
  }
  (n - 1) * 32 + (32 - clz32(self.limbs[n - 1]))
}

///| Return `|self|`.
pub fn BigInt::abs(self : BigInt) -> BigInt {
  if self.neg {
    BigInt::{ neg: false, limbs: self.limbs.copy() }
  } else {
    self
  }
}

///| Return `-self` (canonical: `neg(0) == 0`).
pub fn BigInt::neg(self : BigInt) -> BigInt {
  if self.limbs.length() == 0 {
    self
  } else {
    BigInt::{ neg: !self.neg, limbs: self.limbs.copy() }
  }
}

///| Compare magnitudes of two canonical limb arrays: `-1`, `0`, or `1`.
fn cmp_mag(a : ImmArray[UInt], b : ImmArray[UInt]) -> Int {
  let al = a.length()
  let bl = b.length()
  if al < bl {
    return -1
  }
  if al > bl {
    return 1
  }
  let mut i = al - 1
  while i >= 0 {
    let av = a[i]
    let bv = b[i]
    if av < bv {
      return -1
    }
    if av > bv {
      return 1
    }
    i = i - 1
  }
  0
}

///| Three-way comparison: `-1`, `0`, or `1`.
pub fn BigInt::cmp(self : BigInt, other : BigInt) -> Int {
  if self.neg != other.neg {
    if self.neg { -1 } else { 1 }
  } else {
    let c = cmp_mag(self.limbs, other.limbs)
    if self.neg { -c } else { c }
  }
}

///| Structural/value equality.
pub fn BigInt::eq(self : BigInt, other : BigInt) -> Bool {
  self == other
}

///| Less-than comparison.
pub fn BigInt::lt(self : BigInt, other : BigInt) -> Bool {
  self.cmp(other) < 0
}

///| Less-than-or-equal comparison.
pub fn BigInt::le(self : BigInt, other : BigInt) -> Bool {
  self.cmp(other) <= 0
}

///| Greater-than comparison.
pub fn BigInt::gt(self : BigInt, other : BigInt) -> Bool {
  self.cmp(other) > 0
}

///| Greater-than-or-equal comparison.
pub fn BigInt::ge(self : BigInt, other : BigInt) -> Bool {
  self.cmp(other) >= 0
}
