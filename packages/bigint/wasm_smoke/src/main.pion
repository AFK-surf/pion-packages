///| Wasm32 + Native 4-mode smoke entry for `packages/bigint`.

import "bigint"

///|
pub fn smoke() -> String {
  let a = match bigint::BigInt::from_string("1234567890123456789012345678901234567890") {
    Ok(v) => v
    Err(_) => return "ERR_PARSE_A"
  }
  let b = match bigint::BigInt::from_hex("-0x80000000ffffffffffffffff") {
    Ok(v) => v
    Err(_) => return "ERR_PARSE_B"
  }
  let sum = a.add(b)
  let prod = a.mul(b)
  let (q, r) = prod.div_rem(b)
  if q != a || !r.is_zero() {
    return "ERR_DIV_ROUNDTRIP"
  }
  let u_ab = match bigint::BigInt::from_hex("0x7fffffff800000000000000000000000") {
    Ok(v) => v
    Err(_) => return "ERR_PARSE_U"
  }
  let v_ab = match bigint::BigInt::from_hex("0x80000000ffffffffffffffff") {
    Ok(v) => v
    Err(_) => return "ERR_PARSE_V"
  }
  let (q_ab, r_ab) = u_ab.div_rem(v_ab)
  let i64_min = -9223372036854775807L - 1L
  let bi64 = bigint::BigInt::from_int64(i64_min)
  let rt_ok = match bi64.to_int64() {
    Some(v) => v == i64_min
    None => false
  }
  if !rt_ok {
    return "ERR_I64_MIN"
  }
  let g = a.gcd(b)
  let p = match bigint::BigInt::from_int(3).pow(50) {
    Ok(v) => v
    Err(_) => return "ERR_POW"
  }
  let sh = bigint::BigInt::from_int(-17).shr(2)
  let bx = bigint::BigInt::from_int(-13).bit_xor(bigint::BigInt::from_int(7))
  let mut sb = StringBuilder::new()
  sb.write_string("sum=")
  sb.write_string(sum.to_string())
  sb.write_string("\nq_ab=")
  sb.write_string(q_ab.to_string())
  sb.write_string("\nr_ab=")
  sb.write_string(r_ab.to_string())
  sb.write_string("\ngcd=")
  sb.write_string(g.to_string())
  sb.write_string("\npow3_50=")
  sb.write_string(p.to_string())
  sb.write_string("\nshr=")
  sb.write_string(sh.to_string())
  sb.write_string("\nbx=")
  sb.write_string(bx.to_string())
  sb.write_string("\nhex=")
  sb.write_string(p.to_radix(16).unwrap_or("ERR"))
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let out = smoke()
  io_println(out)
  if out.starts_with("ERR_") {
    1
  } else {
    0
  }
}
