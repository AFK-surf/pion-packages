///| Safe TAR extraction path sanitizer.
///| Rejects `..` traversal, absolute paths, NUL bytes, Windows drive-letter & NTFS ADS injection,
///| Windows reserved device names (`CON`, `PRN`, `AUX`, `NUL`, `COM1`..`COM9`, `LPT1`..`LPT9`), and empty/`.`.

///|
fn ascii_upper(c : Int) -> Int {
  if c >= 97 && c <= 122 {
    c - 32
  } else {
    c
  }
}

///| Check whether a path segment is a Windows reserved device name (case-insensitive, with optional extension).
fn is_windows_reserved_name(b : Bytes, start : Int, end : Int) -> Bool {
  // Base name ends at first '.' (if any)
  let mut base_end = start
  while base_end < end && b[base_end].to_int() != 46 {
    base_end = base_end + 1
  }
  // Trim trailing spaces on the base name (Windows ignores trailing spaces)
  while base_end > start && b[base_end - 1].to_int() == 32 {
    base_end = base_end - 1
  }
  let blen = base_end - start
  if blen == 3 {
    let c0 = ascii_upper(b[start].to_int())
    let c1 = ascii_upper(b[start + 1].to_int())
    let c2 = ascii_upper(b[start + 2].to_int())
    // CON, PRN, AUX, NUL
    if (c0 == 67 && c1 == 79 && c2 == 78) ||
    (c0 == 80 && c1 == 82 && c2 == 78) ||
    (c0 == 65 && c1 == 85 && c2 == 88) ||
    (c0 == 78 && c1 == 85 && c2 == 76) {
      return true
    }
  } else if blen == 4 {
    let c0 = ascii_upper(b[start].to_int())
    let c1 = ascii_upper(b[start + 1].to_int())
    let c2 = ascii_upper(b[start + 2].to_int())
    let c3 = b[start + 3].to_int()
    if c3 >= 49 && c3 <= 57 {
      // COM1..COM9, LPT1..LPT9
      if (c0 == 67 && c1 == 79 && c2 == 77) || (c0 == 76 && c1 == 80 && c2 == 84) {
        return true
      }
    }
  }
  false
}

///| Validate and normalize a TAR entry path for safe extraction.
pub fn clean_extract_path(name : String) -> Result[String, TarError] {
  let b = name.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(TarError::InsecurePath(name))
  }
  // Reject leading '/' or '\'
  let first = b[0].to_int()
  if first == 47 || first == 92 {
    return Err(TarError::InsecurePath(name))
  }
  // Reject any NUL byte or ':' (Windows drive letters & NTFS Alternate Data Streams)
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 0 || c == 58 {
      return Err(TarError::InsecurePath(name))
    }
    i = i + 1
  }
  // Split on '/' and '\', reject ".." and Windows reserved device names, skip "." and empty segments
  let segs : Array[String] = []
  let mut start = 0
  i = 0
  while i <= n {
    let is_sep = i == n || b[i].to_int() == 47 || b[i].to_int() == 92
    if is_sep {
      let seg_len = i - start
      if seg_len == 2 && b[start].to_int() == 46 && b[start + 1].to_int() == 46 {
        return Err(TarError::InsecurePath(name))
      }
      if seg_len > 0 && !(seg_len == 1 && b[start].to_int() == 46) {
        if is_windows_reserved_name(b, start, i) {
          return Err(TarError::InsecurePath(name))
        }
        segs.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if segs.length() == 0 {
    return Err(TarError::InsecurePath(name))
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < segs.length() {
    if i > 0 {
      sb.write_string("/")
    }
    sb.write_string(segs[i])
    i = i + 1
  }
  Ok(sb.to_string())
}
