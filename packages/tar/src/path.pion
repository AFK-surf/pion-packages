///| Safe TAR extraction path sanitizer.
///| Rejects `..` traversal, absolute paths, NUL bytes, Windows drive-letter injection, and empty/`.`.

///|
fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

///| Validate and normalize a TAR entry path for safe extraction.
pub fn clean_extract_path(name : String) -> Result[String, TarError] {
  let b = name.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(TarError::InsecurePath(name))
  }
  // Reject leading '/' or '\'
  let first = b[0].to_int()
  if first == 47 || first == 92 {
    return Err(TarError::InsecurePath(name))
  }
  // Reject Windows drive prefix (e.g. "C:", "c:/foo", "Z:\bar")
  if n >= 2 && is_ascii_alpha(first) && b[1].to_int() == 58 {
    return Err(TarError::InsecurePath(name))
  }
  // Reject any NUL byte
  let mut i = 0
  while i < n {
    if b[i].to_int() == 0 {
      return Err(TarError::InsecurePath(name))
    }
    i = i + 1
  }
  // Split on '/' and '\', reject "..", skip "." and empty segments
  let segs : Array[String] = []
  let mut start = 0
  i = 0
  while i <= n {
    let is_sep = i == n || b[i].to_int() == 47 || b[i].to_int() == 92
    if is_sep {
      let seg_len = i - start
      if seg_len == 2 && b[start].to_int() == 46 && b[start + 1].to_int() == 46 {
        return Err(TarError::InsecurePath(name))
      }
      if seg_len > 0 && !(seg_len == 1 && b[start].to_int() == 46) {
        segs.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if segs.length() == 0 {
    return Err(TarError::InsecurePath(name))
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < segs.length() {
    if i > 0 {
      sb.write_string("/")
    }
    sb.write_string(segs[i])
    i = i + 1
  }
  Ok(sb.to_string())
}
