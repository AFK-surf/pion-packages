///| Compliance tests ported from Go `archive/tar` `reader_test.go` and `writer_test.go`.
///| Exercises USTAR, PAX (x/g), GNU (L/K/base-256/sparse 0.0/0.1/1.0/oldgnu), V7, STAR,
///| signed/unsigned checksums, truncation, header-only types, and round-trips.

///|
test "go_reader_gnu_tar" {
  let entries = match read_all(td_gnu_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(entries.length() == 2, "gnu.tar entry count")
  let h0 = entries[0].header
  debug_assert(h0.name == "small.txt", "h0.name")
  debug_assert(h0.mode == 416L, "h0.mode 0640")
  debug_assert(h0.uid == 73025L && h0.gid == 5000L, "h0 uid/gid")
  debug_assert(h0.size == 5L, "h0.size")
  debug_assert(h0.mod_time.sec == 1244428340L, "h0.mtime")
  debug_assert(h0.typeflag == type_reg(), "h0.typeflag")
  debug_assert(h0.uname == "dsymonds" && h0.gname == "eng", "h0 uname/gname")
  debug_assert(format_equals(h0.format, TarFormat::Gnu), "h0.format GNU")
  debug_assert(crc32_ieee_hex(entries[0].data) == "6cbd88fc", "h0 crc32")

  let h1 = entries[1].header
  debug_assert(h1.name == "small2.txt" && h1.size == 11L, "h1 name/size")
  debug_assert(crc32_ieee_hex(entries[1].data) == "ddac04b3", "h1 crc32")
}

