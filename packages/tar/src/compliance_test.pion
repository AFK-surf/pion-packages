///|
test "go_reader_pax_tar" {
  let entries = match read_all(td_pax_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(entries.length() == 2, "pax.tar count")
  let h0 = entries[0].header
  debug_assert(h0.name.length() == 194, "pax long path length")
  debug_assert(h0.size == 7L, "pax h0 size")
  debug_assert(h0.mod_time.sec == 1350244992L && h0.mod_time.nsec == 23960108, "pax h0 mtime subsec")
  debug_assert(h0.access_time.sec == 1350244992L && h0.access_time.nsec == 23960108, "pax h0 atime")
  debug_assert(h0.change_time.sec == 1350244992L && h0.change_time.nsec == 23960108, "pax h0 ctime")
  debug_assert(format_equals(h0.format, TarFormat::Pax), "pax format")

  let h1 = entries[1].header
  debug_assert(h1.name == "a/b" && h1.typeflag == type_symlink(), "pax h1 symlink")
  debug_assert(h1.linkname.length() == 192, "pax h1 long linkname")
}

///|
test "go_reader_pax_records_global_xattrs" {
  // pax-records.tar
  let r1 = match read_all(td_pax_records_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-records.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(r1.length() == 1, "pax-records count")
  debug_assert(r1[0].header.uname == str_repeat("long", 10), "pax-records uname")
  match r1[0].header.pax_get("GOLANG.pkg") {
    Some(v) => debug_assert(v == "tar", "GOLANG.pkg")
    None => debug_assert(false, "missing GOLANG.pkg")
  }
  match r1[0].header.pax_get("comment") {
    Some(v) => debug_assert(v == "Hello, 世界", "comment utf8")
    None => debug_assert(false, "missing comment")
  }

  // pax-global-records.tar
  let r2 = match read_all(td_pax_global_records_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-global-records.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(r2.length() == 6, "pax-global-records count")
  debug_assert(r2[0].header.typeflag == type_x_global_header(), "global0 type")
  debug_assert(r2[0].header.name == "global1", "global0 name")
  debug_assert(r2[1].header.name == "file1", "file1")
  debug_assert(r2[3].header.typeflag == type_x_global_header(), "global3 type")
  debug_assert(r2[5].header.name == "file4" && r2[5].header.mod_time.sec == 1400000000L, "file4 mtime")

  // xattrs.tar
  let r3 = match read_all(td_xattrs_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "xattrs.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(r3.length() == 2, "xattrs count")
  match r3[0].header.xattr_get("user.key") {
    Some(v) => debug_assert(v == "value", "xattr user.key")
    None => debug_assert(false, "missing user.key")
  }
  match r3[0].header.xattr_get("user.key2") {
    Some(v) => debug_assert(v == "value2", "xattr user.key2")
    None => debug_assert(false, "missing user.key2")
  }

  // pax-pos-size-file.tar
  let r4 = match read_all(td_pax_pos_size_file_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-pos-size-file.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(r4.length() == 1 && r4[0].header.size == 999L, "pax-pos-size")
  debug_assert(crc32_ieee_hex(r4[0].data) == "5fd7e86a", "pax-pos-size crc32")
}

///|
test "go_reader_gnu_multi_long_nul_utf8_nil_uid_trailing" {
  let m1 = match read_all(td_gnu_multi_hdrs_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu-multi-hdrs failed: " + error_message(e))
      []
    }
  }
  debug_assert(m1.length() == 1, "gnu-multi count")
  debug_assert(m1[0].header.name == "GNU2/GNU2/long-path-name", "gnu-multi name")
  debug_assert(m1[0].header.linkname == "GNU4/GNU4/long-linkpath-name", "gnu-multi linkname")

  let m2 = match read_all(td_pax_multi_hdrs_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-multi-hdrs failed: " + error_message(e))
      []
    }
  }
  debug_assert(m2.length() == 1 && m2[0].header.name == "bar", "pax-multi name")
  debug_assert(m2[0].header.linkname == "PAX4/PAX4/long-linkpath-name", "pax-multi linkname")

  let m3 = match read_all(td_gnu_long_nul_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu-long-nul failed: " + error_message(e))
      []
    }
  }
  debug_assert(m3.length() == 1 && m3[0].header.name == "0123456789", "gnu-long-nul truncated at NUL")

  let m4 = match read_all(td_gnu_utf8_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu-utf8 failed: " + error_message(e))
      []
    }
  }
  debug_assert(m4.length() == 1 && m4[0].header.uname == "☺" && m4[0].header.gname == "⚹", "gnu-utf8")

  let m5 = match read_all(td_nil_uid_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "nil-uid failed: " + error_message(e))
      []
    }
  }
  debug_assert(m5.length() == 1 && m5[0].header.uid == 0L && m5[0].header.gid == 0L, "nil-uid")

  let m6 = match read_all(td_trailing_slash_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "trailing-slash failed: " + error_message(e))
      []
    }
  }
  debug_assert(m6.length() == 1 && m6[0].header.typeflag == type_dir(), "trailing-slash TypeDir")
  debug_assert(m6[0].header.name == str_repeat("123456789/", 30), "trailing-slash name")
}

///|
test "go_reader_sparse_all_4_formats" {
  // sparse-formats.tar has 5 entries:
  // 0: oldgnu sparse, 1: PAX 0.0, 2: PAX 0.1, 3: PAX 1.0, 4: regular "end"
  let entries = match read_all(td_sparse_formats_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "sparse-formats.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(entries.length() == 5, "sparse-formats count")
  debug_assert(entries[0].header.name == "sparse-gnu" && entries[0].header.size == 200L, "oldgnu")
  debug_assert(entries[1].header.name == "sparse-posix-0.0" && entries[1].header.size == 200L, "pax 0.0")
  debug_assert(entries[2].header.name == "sparse-posix-0.1" && entries[2].header.size == 200L, "pax 0.1")
  debug_assert(entries[3].header.name == "sparse-posix-1.0" && entries[3].header.size == 200L, "pax 1.0")
  debug_assert(entries[4].header.name == "end" && entries[4].header.size == 4L, "end")

  // Verify exact CRC32 checksums of expanded sparse data (from Go reader_test.go)
  debug_assert(crc32_ieee_hex(entries[0].data) == "5375e1d2", "oldgnu crc32")
  debug_assert(crc32_ieee_hex(entries[1].data) == "5375e1d2", "pax 0.0 crc32")
  debug_assert(crc32_ieee_hex(entries[2].data) == "5375e1d2", "pax 0.1 crc32")
  debug_assert(crc32_ieee_hex(entries[3].data) == "5375e1d2", "pax 1.0 crc32")
  debug_assert(crc32_ieee_hex(entries[4].data) == "8eb179ba", "end crc32")

  // Also test nil-sparse variants (all-data and all-hole)
  let ns1 = match read_all(td_gnu_nil_sparse_data_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu-nil-sparse-data failed: " + error_message(e))
      []
    }
  }
  debug_assert(ns1.length() == 1 && ns1[0].data.length() == 1000, "gnu-nil-sparse-data")

  let ns2 = match read_all(td_gnu_nil_sparse_hole_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "gnu-nil-sparse-hole failed: " + error_message(e))
      []
    }
  }
  debug_assert(ns2.length() == 1 && ns2[0].data.length() == 1000, "gnu-nil-sparse-hole")

  let ns3 = match read_all(td_pax_nil_sparse_data_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-nil-sparse-data failed: " + error_message(e))
      []
    }
  }
  debug_assert(ns3.length() == 1 && ns3[0].data.length() == 1000, "pax-nil-sparse-data")

  let ns4 = match read_all(td_pax_nil_sparse_hole_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "pax-nil-sparse-hole failed: " + error_message(e))
      []
    }
  }
  debug_assert(ns4.length() == 1 && ns4[0].data.length() == 1000, "pax-nil-sparse-hole")
}

///|
test "go_reader_header_only_types" {
  let entries = match read_all(td_hdr_only_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "hdr-only.tar failed: " + error_message(e))
      []
    }
  }
  debug_assert(entries.length() == 16, "hdr-only count == 16")
  let mut i = 0
  while i < 16 {
    if entries[i].header.typeflag != type_reg() {
      debug_assert(entries[i].data.length() == 0, "header-only entry must yield 0 data bytes")
    }
    i = i + 1
  }
}

///|
test "go_reader_malformed_archives_rejected" {
  let bad_archives = [
    ("neg-size.tar", td_neg_size_tar()),
    ("pax-bad-hdr-file.tar", td_pax_bad_hdr_file_tar()),
    ("pax-bad-mtime-file.tar", td_pax_bad_mtime_file_tar()),
    ("pax-nul-path.tar", td_pax_nul_path_tar()),
    ("pax-nul-xattrs.tar", td_pax_nul_xattrs_tar()),
    ("issue10968.tar", td_issue10968_tar()),
    ("issue11169.tar", td_issue11169_tar()),
    ("issue12435.tar", td_issue12435_tar()),
  ]
  let mut i = 0
  while i < bad_archives.length() {
    let (name, raw) = bad_archives[i]
    match read_all(raw) {
      Ok(_) => debug_assert(false, name + " must be rejected")
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "go_reader_truncation_and_eof_semantics" {
  let data1 = td_gnu_tar()
  let data2_base = td_ustar_file_reg_tar()
  let data2 = bytes_concat(data2_base, Bytes::new(10 * 512))
  let pax = td_pax_path_hdr_tar()
  let trash = bytes_from_ascii(str_repeat("garbage ", 64)) // 512 bytes

  // Empty archive -> 0 entries, Ok
  match read_all(Bytes::new(0)) {
    Ok(es) => debug_assert(es.length() == 0, "empty archive")
    Err(e) => debug_assert(false, "empty archive failed: " + error_message(e))
  }
  // Truncated header (511 bytes) -> Err(UnexpectedEof)
  match read_all(data1.slice(0, 511)) {
    Err(UnexpectedEof) => ()
    _ => debug_assert(false, "511B must be UnexpectedEof")
  }
  // Header present, payload missing (512 bytes) -> Err(UnexpectedEof)
  match read_all(data1.slice(0, 512)) {
    Err(UnexpectedEof) => ()
    _ => debug_assert(false, "512B missing payload must be UnexpectedEof")
  }
  // Exact 1st entry + padding (1024 bytes) -> Ok(1)
  match read_all(data1.slice(0, 1024)) {
    Ok(es) => debug_assert(es.length() == 1, "1024B == 1 entry")
    Err(e) => debug_assert(false, "1024B failed: " + error_message(e))
  }
  // Exact end of data before padding (1196 bytes) -> Ok(1)
  match read_all(data2.slice(0, 1196)) {
    Ok(es) => debug_assert(es.length() == 1, "1196B == 1 entry")
    Err(e) => debug_assert(false, "1196B failed: " + error_message(e))
  }
  // 1 zero block + EOF (2048 bytes) -> Ok(1)
  match read_all(data2.slice(0, 2048)) {
    Ok(es) => debug_assert(es.length() == 1, "1 zero block + EOF")
    Err(e) => debug_assert(false, "1 zero block failed: " + error_message(e))
  }
  // 1 zero block + non-zero block -> Err
  match read_all(bytes_concat(data2.slice(0, 2048), trash)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "1 zero block + trash must fail")
  }
  // 2 zero blocks + trailing garbage -> Ok(1) (normal EOF stops at 2 zero blocks)
  match read_all(bytes_concat(data2.slice(0, 2560), trash)) {
    Ok(es) => debug_assert(es.length() == 1, "2 zero blocks + trash")
    Err(e) => debug_assert(false, "2 zero blocks + trash failed: " + error_message(e))
  }
  // Standalone PAX header + EOF -> Ok(0)
  match read_all(pax) {
    Ok(es) => debug_assert(es.length() == 0, "orphan pax + EOF")
    Err(e) => debug_assert(false, "orphan pax failed: " + error_message(e))
  }
}

///|
test "go_reader_signed_checksum_compat" {
  // Build a valid USTAR header with a high-bit byte in name, then replace checksum with Sun signed checksum.
  let blk = Bytes::new(1536)
  // name = "a\xFF"
  blk[0] = (97).to_byte()
  blk[1] = (255).to_byte()
  // mode = "0000644\0"
  let mode_s = "0000644"
  let mut i = 0
  while i < mode_s.length() {
    blk[100 + i] = mode_s.code_unit_at(i).to_byte()
    i = i + 1
  }
  // typeflag = '0'
  blk[156] = type_reg()
  // compute signed checksum (bytes 148..156 treated as ' ')
  let mut signed_sum : Int64 = 0L
  i = 0
  while i < 512 {
    let b = if i >= 148 && i < 156 { 32 } else { blk[i].to_int() }
    let sb = if b >= 128 { b - 256 } else { b }
    signed_sum = signed_sum + sb.to_int64()
    i = i + 1
  }
  // write signed checksum in 6 octal digits + NUL + space
  let mut v = signed_sum
  let mut pos = 153
  while pos >= 148 {
    blk[pos] = (48 + (v & 7L).to_int()).to_byte()
    v = v >> 3
    pos = pos - 1
  }
  blk[154] = (0).to_byte()
  blk[155] = (32).to_byte()

  match read_all(blk) {
    Ok(es) => debug_assert(es.length() == 1, "signed checksum accepted")
    Err(e) => debug_assert(false, "signed checksum failed: " + error_message(e))
  }

  // Corrupt 1 byte -> must fail checksum
  blk[0] = (98).to_byte()
  match read_all(blk) {
    Err(InvalidChecksum(_)) => ()
    Err(InvalidHeader(_)) => ()
    Ok(_) => debug_assert(false, "corrupted checksum must fail")
    Err(e) => debug_assert(false, "unexpected error: " + error_message(e))
  }
}

///|
test "go_writer_matches_official_ustar_and_hardlink" {
  // Match official Go testdata/writer.tar byte-for-byte
  let w = Writer::new()
  let h1 = Header::{
    ..Header::new("small.txt", 5L),
    mode: 416L,
    uid: 73025L,
    gid: 5000L,
    uname: "dsymonds",
    gname: "eng",
    mod_time: Timestamp::unix(1246508266L, 0L),
  }
  debug_assert(
    match w.write_header(h1) {
      Ok(_) => true
      Err(_) => false
    },
    "write h1",
  )
  debug_assert(
    match w.write_data(bytes_from_ascii("Kilts")) {
      Ok(_) => true
      Err(_) => false
    },
    "write d1",
  )

  let h2 = Header::{
    ..Header::new("small2.txt", 11L),
    mode: 416L,
    uid: 73025L,
    gid: 5000L,
    uname: "dsymonds",
    gname: "eng",
    mod_time: Timestamp::unix(1245217492L, 0L),
  }
  debug_assert(
    match w.write_header(h2) {
      Ok(_) => true
      Err(_) => false
    },
    "write h2",
  )
  debug_assert(
    match w.write_data(bytes_from_ascii("Google.com\n")) {
      Ok(_) => true
      Err(_) => false
    },
    "write d2",
  )

  let h3 = Header::{
    ..Header::symlink("link.txt", "small.txt"),
    mode: 511L,
    uid: 1000L,
    gid: 1000L,
    uname: "strings",
    gname: "strings",
    mod_time: Timestamp::unix(1314603082L, 0L),
  }
  debug_assert(
    match w.write_header(h3) {
      Ok(_) => true
      Err(_) => false
    },
    "write h3",
  )
  let out = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "finish failed: " + error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(bytes_eq(out, td_writer_tar()), "writer.tar byte-for-byte match")

  // Match official Go testdata/ustar.tar byte-for-byte
  let wu = Writer::new()
  let hu = Header::{
    ..Header::new(str_repeat("longname/", 15) + "file.txt", 6L),
    mode: 420L,
    uid: 501L,
    gid: 20L,
    uname: "shane",
    gname: "staff",
    mod_time: Timestamp::unix(1360135598L, 0L),
  }
  let _ = wu.write_header(hu)
  let _ = wu.write_data(bytes_from_ascii("hello\n"))
  let out_u = match wu.finish() {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(bytes_eq(out_u, td_ustar_tar()), "ustar.tar byte-for-byte match")

  // Match official Go testdata/hardlink.tar byte-for-byte
  let wh = Writer::new()
  let hh1 = Header::{
    ..Header::new("file.txt", 15L),
    mode: 420L,
    uid: 1000L,
    gid: 100L,
    uname: "vbatts",
    gname: "users",
    mod_time: Timestamp::unix(1425484303L, 0L),
  }
  let _ = wh.write_header(hh1)
  let _ = wh.write_data(bytes_from_ascii("Slartibartfast\n"))
  let hh2 = Header::{
    ..Header::hardlink("hard.txt", "file.txt"),
    mode: 420L,
    uid: 1000L,
    gid: 100L,
    uname: "vbatts",
    gname: "users",
    mod_time: Timestamp::unix(1425484303L, 0L),
  }
  let _ = wh.write_header(hh2)
  let out_h = match wh.finish() {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(bytes_eq(out_h, td_hardlink_tar()), "hardlink.tar byte-for-byte match")
}

///|
test "roundtrip_ustar_pax_gnu_all_typeflags" {
  let long_path = "deep/" + str_repeat("segment_0123456789/", 16) + "target_file.txt"
  let long_link = "../" + str_repeat("linked_dir/", 14) + "dest.txt"
  let entries = [
    // 1. USTAR regular file
    Entry::new(
      Header::{
        ..Header::new("hello.txt", 12L),
        mode: 420L,
        uid: 1000L,
        gid: 1000L,
        uname: "alice",
        gname: "staff",
        mod_time: Timestamp::unix(1700000000L, 0L),
      },
      bytes_from_ascii("hello world\n"),
    ),
    // 2. PAX long path + UTF-8 + sub-second times + large UID + xattrs + custom PAX
    Entry::new(
      Header::{
        ..Header::new(long_path, 5L),
        mode: 493L,
        uid: 3000000L,
        gid: 4000000L,
        uname: "用户",
        gname: "组名",
        mod_time: Timestamp::unix(1700000001L, 123456789L),
        access_time: Timestamp::unix(1700000002L, 987654321L),
        change_time: Timestamp::unix(1700000003L, 500000000L),
        xattrs: [("user.mime", "text/plain")],
        pax_records: [("PION.custom", "wave4")],
        format: TarFormat::Pax,
      },
      bytes_from_ascii("12345"),
    ),
    // 3. GNU long path + long linkname + negative base-256 timestamp
    Entry::new(
      Header::{
        ..Header::symlink(long_path + ".lnk", long_link),
        uid: 5000000L,
        gid: 6000000L,
        mod_time: Timestamp::unix(-100000L, 0L),
        format: TarFormat::Gnu,
      },
      Bytes::new(0),
    ),
    // 4. Directory, Char, Block, Fifo, Hardlink
    Entry::new(Header::dir("sub/dir/"), Bytes::new(0)),
    Entry::new(
      Header::{
        ..Header::new("dev/null", 0L),
        typeflag: type_char(),
        devmajor: 1L,
        devminor: 3L,
      },
      Bytes::new(0),
    ),
    Entry::new(
      Header::{
        ..Header::new("dev/sda", 0L),
        typeflag: type_block(),
        devmajor: 8L,
        devminor: 0L,
      },
      Bytes::new(0),
    ),
    Entry::new(
      Header::{ ..Header::new("run/pipe", 0L), typeflag: type_fifo() },
      Bytes::new(0),
    ),
    Entry::new(Header::hardlink("hard_hello.txt", "hello.txt"), Bytes::new(0)),
  ]

  let archive = match write_all(entries) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "write_all failed: " + error_message(e))
      Bytes::new(0)
    }
  }
  let decoded = match read_all(archive) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "read_all failed: " + error_message(e))
      []
    }
  }
  debug_assert(decoded.length() == 8, "roundtrip count == 8")
  debug_assert(decoded[0].header.name == "hello.txt" && decoded[0].data.to_string() == "hello world\n", "rt 0")
  debug_assert(decoded[1].header.name == long_path, "rt 1 long path")
  debug_assert(decoded[1].header.uid == 3000000L && decoded[1].header.gid == 4000000L, "rt 1 uid/gid")
  debug_assert(decoded[1].header.uname == "用户" && decoded[1].header.gname == "组名", "rt 1 utf8 uname/gname")
  debug_assert(decoded[1].header.mod_time.nsec == 123456789, "rt 1 mtime nsec")
  debug_assert(decoded[1].header.access_time.nsec == 987654321, "rt 1 atime nsec")
  debug_assert(decoded[1].header.change_time.nsec == 500000000, "rt 1 ctime nsec")
  debug_assert(
    match decoded[1].header.xattr_get("user.mime") {
      Some(v) => v == "text/plain"
      None => false
    },
    "rt 1 xattr",
  )
  debug_assert(
    match decoded[1].header.pax_get("PION.custom") {
      Some(v) => v == "wave4"
      None => false
    },
    "rt 1 pax custom",
  )
  debug_assert(decoded[2].header.name == long_path + ".lnk", "rt 2 gnu longname")
  debug_assert(decoded[2].header.linkname == long_link, "rt 2 gnu longlink")
  debug_assert(decoded[2].header.mod_time.sec == -100000L, "rt 2 gnu neg mtime")
  debug_assert(decoded[3].header.typeflag == type_dir(), "rt 3 dir")
  debug_assert(decoded[4].header.typeflag == type_char() && decoded[4].header.devmajor == 1L && decoded[4].header.devminor == 3L, "rt 4 char")
  debug_assert(decoded[5].header.typeflag == type_block() && decoded[5].header.devmajor == 8L, "rt 5 block")
  debug_assert(decoded[6].header.typeflag == type_fifo(), "rt 6 fifo")
  debug_assert(decoded[7].header.typeflag == type_link() && decoded[7].header.linkname == "hello.txt", "rt 7 hardlink")
}

///|
test "writer_error_states" {
  // WriteTooLong
  let w1 = Writer::new()
  let _ = w1.write_header(Header::new("a.txt", 3L))
  match w1.write_data(bytes_from_ascii("1234")) {
    Err(WriteTooLong) => ()
    _ => debug_assert(false, "expected WriteTooLong")
  }

  // IncompleteWrite on finish
  let w2 = Writer::new()
  let _ = w2.write_header(Header::new("b.txt", 5L))
  let _ = w2.write_data(bytes_from_ascii("12"))
  match w2.finish() {
    Err(IncompleteWrite(rem)) => debug_assert(rem == 3L, "expected IncompleteWrite(3)")
    _ => debug_assert(false, "expected IncompleteWrite(3)")
  }

  // WriteAfterClose
  let w3 = Writer::new()
  let _ = w3.finish()
  match w3.write_header(Header::new("c.txt", 0L)) {
    Err(WriteAfterClose) => ()
    _ => debug_assert(false, "expected WriteAfterClose")
  }

  // NUL in name rejected
  let w4 = Writer::new()
  let nul_name = bytes_from_ascii("a").to_string() + "\u{0000}b"
  match w4.write_header(Header::new(nul_name, 0L)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NUL in name must fail")
  }

  // Trailing slash on regular file rejected
  let w5 = Writer::new()
  match w5.write_header(Header::new("dir/", 0L)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "trailing slash on TypeReg must fail")
  }

  // Manual TypeXHeader / TypeGNULongName rejected
  let w6 = Writer::new()
  match w6.write_header(Header::{ ..Header::new("x", 0L), typeflag: type_x_header() }) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "manual TypeXHeader must fail")
  }
}
