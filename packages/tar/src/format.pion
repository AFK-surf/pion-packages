///| TAR low-level format helpers: numeric encoding/decoding (octal + base-256),
///| single-pass checksum + ASCII detection, PAX records & timestamps, USTAR path splitting,
///| and sparse map math.

///| Standard TAR block size in bytes.
let block_size : Int = 512

///| Max length of V7/USTAR name field.
let name_size : Int = 100

///| Max length of USTAR prefix field.
let prefix_size : Int = 155

///| Max Int64 constant.
let max_int64 : Int64 = 9223372036854775807L

///| Compute bytes needed to pad `offset` up to the next 512-byte boundary (0..511).
fn block_padding(offset : Int64) -> Int64 {
  (-offset) & 511L
}

///| Check whether a 512-byte block at `data[off..off+512]` is all zero bytes.
fn is_zero_block(data : Bytes, off : Int) -> Bool {
  let end = off + 512
  let mut i = off
  while i + 8 <= end {
    let acc = data[i].to_int() |
    data[i + 1].to_int() |
    data[i + 2].to_int() |
    data[i + 3].to_int() |
    data[i + 4].to_int() |
    data[i + 5].to_int() |
    data[i + 6].to_int() |
    data[i + 7].to_int()
    if acc != 0 {
      return false
    }
    i = i + 8
  }
  true
}

///| Single-pass unsigned checksum, signed checksum, and high-bit (`>= 0x80`) detection for `data[off..off+512]`.
///| Fast path: branchless 8-byte unrolled unsigned sum; only computes signed sum when a high-bit byte exists.
fn compute_checksum_and_ascii(data : Bytes, off : Int) -> (Int64, Int64, Bool) {
  let mut unsigned_sum = 256 // 8 spaces (8 * 32) for bytes 148..156
  let mut hi_or = 0
  let mut i = off
  let mid1 = off + 148
  while i + 8 <= mid1 {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    let b3 = data[i + 3].to_int()
    let b4 = data[i + 4].to_int()
    let b5 = data[i + 5].to_int()
    let b6 = data[i + 6].to_int()
    let b7 = data[i + 7].to_int()
    unsigned_sum = unsigned_sum + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7
    hi_or = hi_or | b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7
    i = i + 8
  }
  while i < mid1 {
    let b = data[i].to_int()
    unsigned_sum = unsigned_sum + b
    hi_or = hi_or | b
    i = i + 1
  }
  // Check bytes 148..156 for high bit
  hi_or = hi_or |
  data[off + 148].to_int() |
  data[off + 149].to_int() |
  data[off + 150].to_int() |
  data[off + 151].to_int() |
  data[off + 152].to_int() |
  data[off + 153].to_int() |
  data[off + 154].to_int() |
  data[off + 155].to_int()
  i = off + 156
  let end = off + 512
  while i + 8 <= end {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    let b3 = data[i + 3].to_int()
    let b4 = data[i + 4].to_int()
    let b5 = data[i + 5].to_int()
    let b6 = data[i + 6].to_int()
    let b7 = data[i + 7].to_int()
    unsigned_sum = unsigned_sum + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7
    hi_or = hi_or | b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7
    i = i + 8
  }
  while i < end {
    let b = data[i].to_int()
    unsigned_sum = unsigned_sum + b
    hi_or = hi_or | b
    i = i + 1
  }
  let has_non_ascii = (hi_or & 0x80) != 0
  if !has_non_ascii {
    let u = unsigned_sum.to_int64()
    return (u, u, false)
  }
  let mut signed_sum = 256
  i = off
  while i < mid1 {
    let b = data[i].to_int()
    signed_sum = signed_sum + (if b >= 128 { b - 256 } else { b })
    i = i + 1
  }
  i = off + 156
  while i < end {
    let b = data[i].to_int()
    signed_sum = signed_sum + (if b >= 128 { b - 256 } else { b })
    i = i + 1
  }
  (unsigned_sum.to_int64(), signed_sum.to_int64(), true)
}

///| Write unsigned TAR checksum (6 octal digits + NUL + space) into `blk[off+148..off+156]`.
///| `scan_end` is the upper bound (relative to `off`, up to 512) beyond which all bytes are known zero.
fn stamp_checksum_bounded(blk : Bytes, off : Int, scan_end : Int) -> Unit {
  let mut sum = 256
  let mut i = off
  let mid1 = off + 148
  while i + 8 <= mid1 {
    sum = sum +
    blk[i].to_int() +
    blk[i + 1].to_int() +
    blk[i + 2].to_int() +
    blk[i + 3].to_int() +
    blk[i + 4].to_int() +
    blk[i + 5].to_int() +
    blk[i + 6].to_int() +
    blk[i + 7].to_int()
    i = i + 8
  }
  while i < mid1 {
    sum = sum + blk[i].to_int()
    i = i + 1
  }
  i = off + 156
  let end = off + scan_end
  while i + 8 <= end {
    sum = sum +
    blk[i].to_int() +
    blk[i + 1].to_int() +
    blk[i + 2].to_int() +
    blk[i + 3].to_int() +
    blk[i + 4].to_int() +
    blk[i + 5].to_int() +
    blk[i + 6].to_int() +
    blk[i + 7].to_int()
    i = i + 8
  }
  while i < end {
    sum = sum + blk[i].to_int()
    i = i + 1
  }
  let mut v = sum
  let mut pos = off + 153
  while pos >= off + 148 {
    blk[pos] = (48 + (v & 7)).to_byte()
    v = v >> 3
    pos = pos - 1
  }
  blk[off + 154] = (0).to_byte()
  blk[off + 155] = (32).to_byte()
}

///| Write unsigned TAR checksum over full 512-byte block.
fn stamp_checksum(blk : Bytes, off : Int) -> Unit {
  stamp_checksum_bounded(blk, off, 512)
}

///| Verify header checksum and detect format + non-ASCII flag in a single pass.
fn detect_block_format(data : Bytes, off : Int) -> Result[(TarFormat, Bool), TarError] {
  let want_sum = match parse_octal_slice(data, off + 148, off + 156) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (unsigned_sum, signed_sum, has_non_ascii) = compute_checksum_and_ascii(data, off)
  if want_sum != unsigned_sum && want_sum != signed_sum {
    return Err(TarError::InvalidChecksum(want_sum))
  }
  // Check magic at 257..263 ("ustar")
  let is_ustar_prefix = data[off + 257].to_int() == 117 &&
  data[off + 258].to_int() == 115 &&
  data[off + 259].to_int() == 116 &&
  data[off + 260].to_int() == 97 &&
  data[off + 261].to_int() == 114
  if is_ustar_prefix {
    let b262 = data[off + 262].to_int()
    if b262 == 0 {
      let is_star_trailer = data[off + 508].to_int() == 116 &&
      data[off + 509].to_int() == 97 &&
      data[off + 510].to_int() == 114 &&
      data[off + 511].to_int() == 0
      if is_star_trailer {
        return Ok((TarFormat::Star, has_non_ascii))
      }
      return Ok((TarFormat::Ustar, has_non_ascii))
    }
    if b262 == 32 && data[off + 263].to_int() == 32 && data[off + 264].to_int() == 0 {
      return Ok((TarFormat::Gnu, has_non_ascii))
    }
  }
  Ok((TarFormat::V7, has_non_ascii))
}

///| Reports whether `x` fits in an `width`-byte octal field with NUL terminator.
pub fn fits_in_octal(width : Int, x : Int64) -> Bool {
  if x < 0L || width <= 0 {
    return false
  }
  if width >= 22 {
    return true
  }
  let oct_bits = (width - 1) * 3
  x < (1L << oct_bits)
}

///| Reports whether `x` fits in a `width`-byte GNU base-256 field.
pub fn fits_in_base256(width : Int, x : Int64) -> Bool {
  if width <= 0 {
    return false
  }
  if width >= 9 {
    return true
  }
  let bin_bits = (width - 1) * 8
  let limit = 1L << bin_bits
  x >= -limit && x < limit
}

///| Parse an octal field from `data[start..end]`, trimming leading/trailing spaces and NULs.
fn parse_octal_slice(data : Bytes, start : Int, end : Int) -> Result[Int64, TarError] {
  let mut s = start
  let mut e = end
  while s < e {
    let b = data[s].to_int()
    if b == 32 || b == 0 {
      s = s + 1
    } else {
      break
    }
  }
  while e > s {
    let b = data[e - 1].to_int()
    if b == 32 || b == 0 {
      e = e - 1
    } else {
      break
    }
  }
  if s >= e {
    return Ok(0L)
  }
  // Stop at first embedded NUL (C-string semantics matching Go parseString)
  let mut i = s
  while i < e {
    if data[i].to_int() == 0 {
      e = i
      break
    }
    i = i + 1
  }
  if s >= e {
    return Ok(0L)
  }
  // Fast path: <= 20 octal digits can never overflow signed Int64
  if e - s <= 20 {
    let mut acc : Int64 = 0L
    i = s
    while i < e {
      let d = data[i].to_int() - 48
      if d < 0 || d > 7 {
        return Err(TarError::InvalidHeader("invalid octal digit"))
      }
      acc = (acc << 3) | d.to_int64()
      i = i + 1
    }
    return Ok(acc)
  }
  let mut acc : UInt64 = 0UL
  let max_before_shift : UInt64 = 0x1FFFFFFFFFFFFFFFUL
  i = s
  while i < e {
    let b = data[i].to_int()
    if b < 48 || b > 55 {
      return Err(TarError::InvalidHeader("invalid octal digit"))
    }
    if acc > max_before_shift {
      return Err(TarError::InvalidHeader("octal integer overflow"))
    }
    acc = (acc << 3) | (b - 48).to_int64().to_uint64()
    i = i + 1
  }
  Ok(acc.to_int64())
}

///| Parse a TAR numeric field (base-256 binary or base-8 octal) from `data[start..end]`.
fn parse_numeric_slice(data : Bytes, start : Int, end : Int) -> Result[Int64, TarError] {
  if start < end && (data[start].to_int() & 0x80) != 0 {
    let inv = if (data[start].to_int() & 0x40) != 0 { 0xFF } else { 0x00 }
    let mut x : UInt64 = 0UL
    let mut i = start
    while i < end {
      let mut c = data[i].to_int() ^ inv
      if i == start {
        c = c & 0x7F
      }
      if (x >> 56) > 0UL {
        return Err(TarError::InvalidHeader("base-256 integer overflow"))
      }
      x = (x << 8) | c.to_int64().to_uint64()
      i = i + 1
    }
    if (x >> 63) > 0UL {
      return Err(TarError::InvalidHeader("base-256 integer overflow"))
    }
    if inv == 0xFF {
      return Ok(-(x.to_int64()) - 1L)
    }
    return Ok(x.to_int64())
  }
  parse_octal_slice(data, start, end)
}

///| Parse a TAR numeric field (`Bytes`) encoded in base-256 or octal.
pub fn parse_numeric(b : Bytes) -> Result[Int64, TarError] {
  parse_numeric_slice(b, 0, b.length())
}

///| Format `x` into `buf[off..off+width]` using octal encoding with NUL terminator.
fn format_octal_into(buf : Bytes, off : Int, width : Int, x : Int64) -> Bool {
  if !fits_in_octal(width, x) {
    let mut i = 0
    while i < width - 1 {
      buf[off + i] = (48).to_byte()
      i = i + 1
    }
    if width > 0 {
      buf[off + width - 1] = (0).to_byte()
    }
    return false
  }
  let mut v = x
  let mut pos = off + width - 2
  while pos >= off {
    buf[pos] = (48 + (v & 7L).to_int()).to_byte()
    v = v >> 3
    pos = pos - 1
  }
  buf[off + width - 1] = (0).to_byte()
  true
}

///| Format `x` into `buf[off..off+width]` using octal if it fits, else base-256.
fn format_numeric_into(buf : Bytes, off : Int, width : Int, x : Int64) -> Bool {
  if fits_in_octal(width, x) {
    return format_octal_into(buf, off, width, x)
  }
  if fits_in_base256(width, x) {
    let mut v = x
    let mut i = width - 1
    while i >= 0 {
      buf[off + i] = (v & 0xFFL).to_int().to_byte()
      v = v >> 8
      i = i - 1
    }
    buf[off] = (buf[off].to_int() | 0x80).to_byte()
    return true
  }
  let _ = format_octal_into(buf, off, width, 0L)
  false
}

///| Encode `x` into a `width`-byte TAR numeric field (octal if possible, else base-256).
pub fn format_numeric(width : Int, x : Int64) -> Result[Bytes, TarError] {
  if width <= 0 {
    return Err(TarError::FieldTooLong("width must be > 0"))
  }
  let out = Bytes::new(width)
  if !format_numeric_into(out, 0, width, x) {
    return Err(TarError::FieldTooLong("integer does not fit in field"))
  }
  Ok(out)
}

///| Parse a NUL-terminated C-string from `data[start..start+len]` using cached `data_str` (zero intermediate `Bytes` alloc).
fn parse_c_string_from_str(data : Bytes, data_str : String, start : Int, len : Int) -> String {
  if len <= 0 || data[start].to_int() == 0 {
    return ""
  }
  let limit = start + len
  let mut end = start + 1
  while end < limit {
    if data[end].to_int() == 0 {
      break
    }
    end = end + 1
  }
  data_str.slice(start, end)
}

///| Copy string bytes directly into `buf[off..off+width]` via `code_unit_at` (zero `to_bytes()` alloc).
fn format_string_into(buf : Bytes, off : Int, width : Int, s : String) -> Bool {
  let slen = s.length()
  let copy_len = if slen < width { slen } else { width }
  let mut i = 0
  while i < copy_len {
    buf[off + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  if slen < width {
    buf[off + slen] = (0).to_byte()
    return true
  }
  if slen > width && width > 0 && buf[off + width - 1].to_int() == 47 {
    let mut n = width - 1
    while n > 0 && buf[off + n - 1].to_int() == 47 {
      n = n - 1
    }
    buf[off + n] = (0).to_byte()
  }
  slen <= width
}

///| Single-pass check of a string: returns `(has_nul, is_ascii)` with zero allocations.
fn scan_string_flags(s : String) -> (Bool, Bool) {
  let n = s.length()
  let mut ascii = true
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0 {
      return (true, false)
    }
    if c >= 0x80 {
      ascii = false
    }
    i = i + 1
  }
  (false, ascii)
}

///| Returns true if `s` contains a NUL byte (`0x00`).
fn has_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Returns true if `s` is a non-NUL ASCII string (all bytes in `1..127`).
fn is_ascii(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0 || c >= 0x80 {
      return false
    }
    i = i + 1
  }
  true
}

///| Best-effort strip of non-ASCII and NUL bytes for PAX fallback USTAR fields.
fn to_ascii(s : String) -> String {
  if is_ascii(s) {
    return s
  }
  let n = s.length()
  let mut count = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c > 0 && c < 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  let out = Bytes::new(count)
  let mut p = 0
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c > 0 && c < 0x80 {
      out[p] = c.to_byte()
      p = p + 1
    }
    i = i + 1
  }
  out.to_string()
}

///| Strict signed 64-bit ASCII decimal parser over `s[start..end]`.
fn parse_int64_dec_range(s : String, start : Int, end : Int) -> Result[Int64, TarError] {
  let n = end - start
  if n <= 0 {
    return Err(TarError::InvalidHeader("empty decimal integer"))
  }
  let mut neg = false
  let mut i = start
  if s.code_unit_at(start) == 45 {
    neg = true
    i = start + 1
    if n == 1 {
      return Err(TarError::InvalidHeader("bare minus sign"))
    }
  }
  let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
  let cutoff : UInt64 = limit / 10UL
  let cutlim : UInt64 = limit % 10UL
  let mut acc : UInt64 = 0UL
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return Err(TarError::InvalidHeader("invalid decimal digit"))
    }
    let d = (c - 48).to_int64().to_uint64()
    if acc > cutoff || (acc == cutoff && d > cutlim) {
      return Err(TarError::InvalidHeader("decimal integer overflow"))
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if neg {
    if acc == 9223372036854775808UL {
      return Ok(-9223372036854775807L - 1L)
    }
    return Ok(-(acc.to_int64()))
  }
  Ok(acc.to_int64())
}

///| Strict signed 64-bit ASCII decimal parser.
fn parse_int64_dec(s : String) -> Result[Int64, TarError] {
  parse_int64_dec_range(s, 0, s.length())
}

///| Parse a PAX timestamp of the form `%d` or `%d.%d` (including negative timestamps).
pub fn parse_pax_time(s : String) -> Result[Timestamp, TarError] {
  let n = s.length()
  if n == 0 {
    return Err(TarError::InvalidHeader("empty PAX timestamp"))
  }
  let mut dot = -1
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 46 {
      dot = i
      break
    }
    i = i + 1
  }
  let sec_end = if dot >= 0 { dot } else { n }
  let secs = match parse_int64_dec_range(s, 0, sec_end) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if dot < 0 || dot + 1 >= n {
    return Ok(Timestamp::unix(secs, 0L))
  }
  let mut nsecs : Int64 = 0L
  let mut place : Int64 = 100000000L
  i = dot + 1
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return Err(TarError::InvalidHeader("invalid PAX timestamp fraction"))
    }
    if place > 0L {
      nsecs = nsecs + (c - 48).to_int64() * place
      place = place / 10L
    }
    i = i + 1
  }
  if s.code_unit_at(0) == 45 {
    return Ok(Timestamp::unix(secs, -nsecs))
  }
  Ok(Timestamp::unix(secs, nsecs))
}

///| Format a `Timestamp` in PAX `%d.%d` format (trimming trailing fractional zeros).
pub fn format_pax_time(ts : Timestamp) -> String {
  let mut secs = ts.sec
  let mut nsecs = ts.nsec
  if nsecs == 0 {
    return secs.to_string()
  }
  let mut sign = ""
  if secs < 0L {
    sign = "-"
    secs = -(secs + 1L)
    nsecs = 1000000000 - nsecs
  }
  let digits = Bytes::new(9)
  let mut rem = nsecs
  let mut pos = 8
  while pos >= 0 {
    digits[pos] = (48 + (rem % 10)).to_byte()
    rem = rem / 10
    pos = pos - 1
  }
  let mut end = 9
  while end > 0 && digits[end - 1].to_int() == 48 {
    end = end - 1
  }
  sign + secs.to_string() + "." + digits.slice(0, end).to_string()
}

///| Reports whether `(k, v)` is a valid PAX key-value pair.
fn valid_pax_record(k : String, v : String) -> Bool {
  let kn = k.length()
  if kn == 0 {
    return false
  }
  let mut i = 0
  while i < kn {
    let c = k.code_unit_at(i)
    if c == 61 || c == 0 {
      return false
    }
    i = i + 1
  }
  if k == "path" || k == "linkpath" || k == "uname" || k == "gname" {
    return !has_nul(v)
  }
  true
}

///| Parse a single PAX record starting at `pos` inside `s[pos..end]`, returning `(k, v, next_pos)`.
fn parse_pax_record_at(
  s : String,
  pos : Int,
  end : Int,
) -> Result[(String, String, Int), TarError] {
  let mut sp = -1
  let mut i = pos
  while i < end {
    if s.code_unit_at(i) == 32 {
      sp = i
      break
    }
    i = i + 1
  }
  if sp <= pos {
    return Err(TarError::InvalidHeader("PAX record missing length space"))
  }
  let rec_len64 = match parse_int64_dec_range(s, pos, sp) {
    Ok(v) => v
    Err(_) => return Err(TarError::InvalidHeader("invalid PAX record length"))
  }
  let avail = (end - pos).to_int64()
  if rec_len64 < 5L || rec_len64 > avail {
    return Err(TarError::InvalidHeader("PAX record length out of range"))
  }
  let rec_len = rec_len64.to_int()
  let next_pos = pos + rec_len
  let rec_start = sp + 1
  let rec_end = next_pos - 1
  if rec_end <= rec_start {
    return Err(TarError::InvalidHeader("PAX record length too small"))
  }
  if s.code_unit_at(rec_end) != 10 {
    return Err(TarError::InvalidHeader("PAX record missing trailing newline"))
  }
  let mut eq = -1
  i = rec_start
  while i < rec_end {
    if s.code_unit_at(i) == 61 {
      eq = i
      break
    }
    i = i + 1
  }
  if eq < 0 {
    return Err(TarError::InvalidHeader("PAX record missing '='"))
  }
  let k = s.slice(rec_start, eq)
  let v = s.slice(eq + 1, rec_end)
  if !valid_pax_record(k, v) {
    return Err(TarError::InvalidHeader("invalid PAX key or value"))
  }
  Ok((k, v, next_pos))
}

///| Parse a single PAX record `"<len> <key>=<value>\n"` from the front of `s`.
///| Returns `(key, value, remainder)`.
pub fn parse_pax_record(s : String) -> Result[(String, String, String), TarError] {
  let total = s.length()
  match parse_pax_record_at(s, 0, total) {
    Ok((k, v, next_pos)) => {
      let rem = if next_pos < total { s.slice(next_pos, total) } else { "" }
      Ok((k, v, rem))
    }
    Err(e) => Err(e)
  }
}

///| Count decimal digits of a positive integer.
fn dec_digits(n : Int) -> Int {
  let mut v = n
  let mut d = 1
  while v >= 10 {
    v = v / 10
    d = d + 1
  }
  d
}

///| Format a single PAX record `"<len> <key>=<value>\n"`.
pub fn format_pax_record(k : String, v : String) -> Result[String, TarError] {
  if !valid_pax_record(k, v) {
    return Err(TarError::InvalidHeader("invalid PAX record"))
  }
  let base = k.length() + v.length() + 3
  let mut size = base + dec_digits(base)
  if base + dec_digits(size) != size {
    size = base + dec_digits(size)
  }
  Ok(size.to_string() + " " + k + "=" + v + "\n")
}

///| Append a pre-validated PAX record directly into `sb`.
fn write_pax_record_unchecked(sb : StringBuilder, k : String, v : String) -> Unit {
  let base = k.length() + v.length() + 3
  let mut size = base + dec_digits(base)
  if base + dec_digits(size) != size {
    size = base + dec_digits(size)
  }
  sb.write_string(size.to_string())
  sb.write_string(" ")
  sb.write_string(k)
  sb.write_string("=")
  sb.write_string(v)
  sb.write_string("\n")
}

///| Write `"0000000\0"` (8-byte zero octal) into `buf[off..off+8]`.
fn write_octal_zero_8(buf : Bytes, off : Int) -> Unit {
  let z = (48).to_byte()
  buf[off] = z
  buf[off + 1] = z
  buf[off + 2] = z
  buf[off + 3] = z
  buf[off + 4] = z
  buf[off + 5] = z
  buf[off + 6] = z
  buf[off + 7] = (0).to_byte()
}

///| Write `"00000000000\0"` (12-byte zero octal) into `buf[off..off+12]`.
fn write_octal_zero_12(buf : Bytes, off : Int) -> Unit {
  let z = (48).to_byte()
  buf[off] = z
  buf[off + 1] = z
  buf[off + 2] = z
  buf[off + 3] = z
  buf[off + 4] = z
  buf[off + 5] = z
  buf[off + 6] = z
  buf[off + 7] = z
  buf[off + 8] = z
  buf[off + 9] = z
  buf[off + 10] = z
  buf[off + 11] = (0).to_byte()
}

///| Split a path into USTAR `(prefix, suffix)` where `len(prefix) <= 155` and `len(suffix) <= 100`.
pub fn split_ustar_path(name : String) -> Option[(String, String)] {
  let total = name.length()
  if total <= name_size || !is_ascii(name) {
    return Option::None
  }
  let mut limit = total
  if limit > prefix_size + 1 {
    limit = prefix_size + 1
  } else if name.code_unit_at(limit - 1) == 47 {
    limit = limit - 1
  }
  let mut slash = -1
  let mut i = limit - 1
  while i >= 0 {
    if name.code_unit_at(i) == 47 {
      slash = i
      break
    }
    i = i - 1
  }
  let nlen = total - slash - 1
  let plen = slash
  if slash <= 0 || nlen > name_size || nlen == 0 || plen > prefix_size {
    return Option::None
  }
  Option::Some((name.slice(0, slash), name.slice(slash + 1, total)))
}

///| Validate a list of sparse fragments against logical file `size`.
pub fn validate_sparse_entries(sp : Array[SparseEntry], size : Int64) -> Bool {
  if size < 0L {
    return false
  }
  let mut prev_end : Int64 = 0L
  let n = sp.length()
  let mut i = 0
  while i < n {
    let cur = sp[i]
    if cur.offset < 0L || cur.length < 0L {
      return false
    }
    if cur.offset > max_int64 - cur.length {
      return false
    }
    let end_off = cur.offset + cur.length
    if end_off > size {
      return false
    }
    if prev_end > cur.offset {
      return false
    }
    prev_end = end_off
    i = i + 1
  }
  true
}

///| Align sparse fragments to 512-byte block boundaries (matching Go `alignSparseEntries`).
pub fn align_sparse_entries(sp : Array[SparseEntry], size : Int64) -> Array[SparseEntry] {
  let dst : Array[SparseEntry] = Array::with_capacity(sp.length())
  let n = sp.length()
  let mut i = 0
  while i < n {
    let s = sp[i]
    let mut pos = s.offset
    let mut end = s.offset + s.length
    pos = pos + block_padding(pos)
    if end != size {
      end = end - block_padding(-end)
    }
    if pos < end {
      dst.push(SparseEntry::new(pos, end - pos))
    }
    i = i + 1
  }
  dst
}

///| Convert between `sparseDatas` and `sparseHoles` (matching Go `invertSparseEntries`).
pub fn invert_sparse_entries(sp : Array[SparseEntry], size : Int64) -> Array[SparseEntry] {
  let dst : Array[SparseEntry] = Array::with_capacity(sp.length() + 1)
  let mut pre_off : Int64 = 0L
  let n = sp.length()
  let mut i = 0
  while i < n {
    let cur = sp[i]
    if cur.length == 0L {
      i = i + 1
      continue
    }
    let len = cur.offset - pre_off
    if len > 0L {
      dst.push(SparseEntry::new(pre_off, len))
    }
    pre_off = cur.offset + cur.length
    i = i + 1
  }
  dst.push(SparseEntry::new(pre_off, size - pre_off))
  dst
}
