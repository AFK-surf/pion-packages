///| Day-1 Red-Team security & boundary tests for `packages/tar`:
///| - 64-bit integer overflow & negative size defense
///| - PAX header bomb & GNU LongName bomb OOM defense
///| - Sparse hole bomb & malformed sparse map defense
///| - Entry count bomb defense
///| - Path traversal, absolute path, NUL byte, and Windows drive-letter injection defense

///| Helper: stamp a valid USTAR/GNU checksum into a 512-byte header block.
fn finalize_test_block(blk : Bytes) -> Unit {
  let mut sum : Int64 = 0L
  let mut i = 0
  while i < 512 {
    let b = if i >= 148 && i < 156 { 32 } else { blk[i].to_int() }
    sum = sum + b.to_int64()
    i = i + 1
  }
  let mut v = sum
  let mut pos = 153
  while pos >= 148 {
    blk[pos] = (48 + (v & 7L).to_int()).to_byte()
    v = v >> 3
    pos = pos - 1
  }
  blk[154] = (0).to_byte()
  blk[155] = (32).to_byte()
}

///| Helper: write ASCII string into block at offset.
fn put_ascii(blk : Bytes, off : Int, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    blk[off + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
}

///| Helper: write octal into block at offset with given width.
fn put_octal(blk : Bytes, off : Int, width : Int, n : Int64) -> Unit {
  let mut v = n
  let mut pos = off + width - 2
  while pos >= off {
    blk[pos] = (48 + (v & 7L).to_int()).to_byte()
    v = v >> 3
    pos = pos - 1
  }
  blk[off + width - 1] = (0).to_byte()
}

///|
test "redteam_64bit_maxint64_size_no_panic" {
  // Craft a GNU header with base-256 size = 0x7fff_ffff_ffff_ffff (MaxInt64)
  let tar = Bytes::new(1536)
  put_ascii(tar, 0, "bomb.bin")
  put_octal(tar, 100, 8, 420L)
  // Base-256 MaxInt64 in 12 bytes at offset 124
  let b256 = hex_to_bytes("800000007fffffffffffffff")
  let mut i = 0
  while i < 12 {
    tar[124 + i] = b256[i]
    i = i + 1
  }
  tar[156] = type_reg()
  put_ascii(tar, 257, "ustar ")
  tar[263] = (32).to_byte()
  tar[264] = (0).to_byte()
  finalize_test_block(tar)

  match read_all(tar) {
    Ok(_) => debug_assert(false, "MaxInt64 size must be rejected without OOM/panic")
    Err(LimitExceeded(_)) => ()
    Err(UnexpectedEof) => ()
    Err(_) => ()
  }
}

///|
test "redteam_negative_base256_size_rejected" {
  let tar = Bytes::new(1536)
  put_ascii(tar, 0, "neg.bin")
  put_octal(tar, 100, 8, 420L)
  // Base-256 -1 in 12 bytes
  let mut i = 0
  while i < 12 {
    tar[124 + i] = (255).to_byte()
    i = i + 1
  }
  tar[156] = type_reg()
  put_ascii(tar, 257, "ustar ")
  tar[263] = (32).to_byte()
  tar[264] = (0).to_byte()
  finalize_test_block(tar)

  match read_all(tar) {
    Err(InvalidHeader(_)) => ()
    _ => debug_assert(false, "negative base-256 size must return InvalidHeader")
  }
}

///|
test "redteam_pax_size_bomb_and_overflow" {
  // PAX header declaring size = 9223372036854775807 (MaxInt64)
  let pax_payload = "28 size=9223372036854775807\n"
  let tar = Bytes::new(2560)
  // Block 0: TypeXHeader
  put_ascii(tar, 0, "PaxHeaders.0/bomb")
  put_octal(tar, 124, 12, pax_payload.length().to_int64())
  tar[156] = type_x_header()
  put_ascii(tar, 257, "ustar")
  tar[262] = (0).to_byte()
  put_ascii(tar, 263, "00")
  finalize_test_block(tar)
  // Block 1: PAX payload
  put_ascii(tar, 512, pax_payload)
  // Block 2: Regular file header
  let blk2 = Bytes::new(512)
  put_ascii(blk2, 0, "bomb")
  put_octal(blk2, 124, 12, 0L)
  blk2[156] = type_reg()
  put_ascii(blk2, 257, "ustar")
  blk2[262] = (0).to_byte()
  put_ascii(blk2, 263, "00")
  finalize_test_block(blk2)
  let mut i = 0
  while i < 512 {
    tar[1024 + i] = blk2[i]
    i = i + 1
  }

  match read_all(tar) {
    Ok(_) => debug_assert(false, "PAX MaxInt64 size must fail")
    Err(_) => ()
  }
}

///|
test "redteam_limits_max_pax_bytes_and_records" {
  // Build a valid PAX archive with 10 records, then read with max_pax_records = 3 and max_pax_bytes = 32
  let mut recs : Array[(String, String)] = []
  let mut i = 0
  while i < 10 {
    recs.push(("PION.k" + i.to_string(), "value_" + i.to_string()))
    i = i + 1
  }
  let hdr = Header::{ ..Header::new("file.txt", 3L), pax_records: recs, format: TarFormat::Pax }
  let archive = match write_all([Entry::new(hdr, bytes_from_ascii("abc"))]) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "write failed: " + error_message(e))
      Bytes::new(0)
    }
  }

  // Succeeds with default limits
  match read_all(archive) {
    Ok(es) => debug_assert(es.length() == 1, "default limits ok")
    Err(e) => debug_assert(false, "default limits failed: " + error_message(e))
  }

  // Fails with max_pax_records = 3
  let lim_rec = Limits::{ ..Limits::default(), max_pax_records: 3 }
  match read_all_with_limits(archive, lim_rec) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_pax_records must trigger LimitExceeded")
  }

  // Fails with max_pax_bytes = 32
  let lim_bytes = Limits::{ ..Limits::default(), max_pax_bytes: 32 }
  match read_all_with_limits(archive, lim_bytes) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_pax_bytes must trigger LimitExceeded")
  }
}

///|
test "redteam_limits_max_entries_and_max_entry_size" {
  let entries = [
    Entry::new(Header::new("a.txt", 10L), Bytes::new(10)),
    Entry::new(Header::new("b.txt", 10L), Bytes::new(10)),
    Entry::new(Header::new("c.txt", 10L), Bytes::new(10)),
  ]
  let archive = match write_all(entries) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }

  let lim_ent = Limits::{ ..Limits::default(), max_entries: 2 }
  match read_all_with_limits(archive, lim_ent) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_entries must trigger LimitExceeded")
  }

  let lim_sz = Limits::{ ..Limits::default(), max_entry_size: 5L }
  match read_all_with_limits(archive, lim_sz) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_entry_size must trigger LimitExceeded")
  }
}

///|
test "redteam_sparse_hole_bomb_oom_defense" {
  // sparse-formats.tar has 95 sparse segments in entries 0..3.
  // With max_sparse_holes = 10, it MUST fail with LimitExceeded.
  let lim_holes = Limits::{ ..Limits::default(), max_sparse_holes: 10 }
  match read_all_with_limits(td_sparse_formats_tar(), lim_holes) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_sparse_holes must trigger LimitExceeded")
  }

  // Craft a 1 TiB sparse bomb (PAX 0.1 with GNU.sparse.size = 1099511627776, 0 data bytes)
  let pax_payload = "28 GNU.sparse.size=1099511627776\n24 GNU.sparse.numblocks=0\n16 GNU.sparse.map=\n26 GNU.sparse.name=bomb.img\n"
  // Fix exact PAX lengths using format_pax_record-style exact strings:
  // "33 GNU.sparse.size=1099511627776\n" (len 33)
  // "25 GNU.sparse.numblocks=0\n" (len 26 -> "26 GNU.sparse.numblocks=0\n")
  // "18 GNU.sparse.map=\n" (len 19 -> "19 GNU.sparse.map=\n")
  // "28 GNU.sparse.name=bomb.img\n" (len 28)
  let _ = pax_payload
  let exact_pax = "22 GNU.sparse.major=0\n22 GNU.sparse.minor=1\n33 GNU.sparse.size=1099511627776\n26 GNU.sparse.numblocks=0\n19 GNU.sparse.map=\n28 GNU.sparse.name=bomb.img\n"
  let tar = Bytes::new(2560)
  put_ascii(tar, 0, "PaxHeaders.0/bomb.img")
  put_octal(tar, 124, 12, exact_pax.length().to_int64())
  tar[156] = type_x_header()
  put_ascii(tar, 257, "ustar")
  tar[262] = (0).to_byte()
  put_ascii(tar, 263, "00")
  finalize_test_block(tar)
  put_ascii(tar, 512, exact_pax)

  let blk2 = Bytes::new(512)
  put_ascii(blk2, 0, "bomb.img")
  put_octal(blk2, 124, 12, 0L)
  blk2[156] = type_reg()
  put_ascii(blk2, 257, "ustar")
  blk2[262] = (0).to_byte()
  put_ascii(blk2, 263, "00")
  finalize_test_block(blk2)
  let mut i = 0
  while i < 512 {
    tar[1024 + i] = blk2[i]
    i = i + 1
  }

  // Must fail with LimitExceeded when trying to read_all (logical size 1 TiB > default 256 MiB)
  match read_all(tar) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "1 TiB sparse bomb must trigger LimitExceeded")
  }
}

///|
test "redteam_clean_extract_path_security" {
  // Valid relative paths
  let valid = [
    ("a/b/c.txt", "a/b/c.txt"),
    ("./a/./b", "a/b"),
    ("dir/", "dir"),
    ("dir///sub//file.txt", "dir/sub/file.txt"),
    ("a..b/c", "a..b/c"),
    ("...", "..."),
    ("日本語/ファイル.txt", "日本語/ファイル.txt"),
  ]
  let mut i = 0
  while i < valid.length() {
    let (inp, want) = valid[i]
    match clean_extract_path(inp) {
      Ok(got) => debug_assert(got == want, "clean(" + inp + ") = " + got + ", want " + want)
      Err(e) => debug_assert(false, "clean(" + inp + ") unexpected err: " + error_message(e))
    }
    i = i + 1
  }

  // Malicious / insecure paths that MUST be rejected
  let bad = [
    "",
    ".",
    "./",
    "..",
    "../etc/passwd",
    "a/../../etc/passwd",
    "a/b/..",
    "a/b/../c",
    "/etc/passwd",
    "//server/share/file",
    "\\etc\\passwd",
    "a\\..\\b",
    "C:/Windows/System32",
    "C:\\Windows\\win.ini",
    "c:relative.txt",
    "Z:foo",
    "foo\u{0000}bar",
    "a/b:stream",
    "file.txt::$DATA",
    "CON",
    "x/NUL",
    "aux",
    "con.txt",
    "COM1",
    "lpt9.bin",
    "dir/PRN",
  ]
  i = 0
  while i < bad.length() {
    match clean_extract_path(bad[i]) {
      Err(InsecurePath(_)) => ()
      Ok(got) => debug_assert(false, "insecure path accepted: " + bad[i] + " -> " + got)
      Err(e) => debug_assert(false, "expected InsecurePath for " + bad[i] + ", got " + error_message(e))
    }
    i = i + 1
  }
}

///|
test "redteam_sparse_streaming_read_chunk_and_query" {
  // Verify streaming read_chunk matches read_data byte-for-byte on all 4 sparse formats in sparse-formats.tar.
  let expected = match read_all(td_sparse_formats_tar()) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "read_all sparse-formats failed: " + error_message(e))
      []
    }
  }
  let r = Reader::new(td_sparse_formats_tar())
  let mut idx = 0
  while true {
    match r.next() {
      Ok(Some(hdr)) => {
        if idx < 4 {
          debug_assert(r.is_sparse(), "entry " + idx.to_string() + " must be sparse")
          debug_assert(r.sparse_entries().length() > 0, "sparse entries non-empty")
        } else {
          debug_assert(!r.is_sparse(), "entry 4 is regular")
        }
        let chunks : Array[Bytes] = []
        let mut total = 0
        while true {
          match r.read_chunk(17) {
            Ok(c) => {
              if c.length() == 0 {
                break
              }
              chunks.push(c)
              total = total + c.length()
            }
            Err(e) => {
              debug_assert(false, "read_chunk failed: " + error_message(e))
              break
            }
          }
        }
        debug_assert(total.to_int64() == hdr.size, "streamed total == hdr.size")
        let assembled = Bytes::new(total)
        let mut p = 0
        let mut ci = 0
        while ci < chunks.length() {
          let c = chunks[ci]
          let mut j = 0
          while j < c.length() {
            assembled[p] = c[j]
            p = p + 1
            j = j + 1
          }
          ci = ci + 1
        }
        debug_assert(bytes_eq(assembled, expected[idx].data), "streamed sparse data matches read_data")
        idx = idx + 1
      }
      Ok(None) => break
      Err(e) => {
        debug_assert(false, "next failed: " + error_message(e))
        break
      }
    }
  }
  debug_assert(idx == 5, "streamed 5 entries")
}

///|
test "redteam_p1_p2_regression_suite" {
  // P1-1: negative half-second rounding toward +inf
  debug_assert(Timestamp::unix(-1L, 500000000L).round_sec().sec == 0L, "-0.5s -> 0")
  debug_assert(Timestamp::unix(-2L, 500000000L).round_sec().sec == -1L, "-1.5s -> -1")
  debug_assert(Timestamp::unix(0L, -500000000L).round_sec().sec == 0L, "-0.5s norm -> 0")

  // P2-1: leading '+' in PAX numbers and timestamps
  match parse_pax_time("+5") {
    Ok(t) => debug_assert(t.sec == 5L && t.nsec == 0, "+5 pax time")
    Err(e) => debug_assert(false, "+5 pax time failed: " + error_message(e))
  }
  match parse_pax_record("+13 path=abc\n") {
    Ok((k, v, _)) => debug_assert(k == "path" && v == "abc", "+13 pax record")
    Err(e) => debug_assert(false, "+13 pax record failed: " + error_message(e))
  }

  // P2-4: TypeXGlobalHeader rejects non-zero size/mode
  let g_bad = Header::{
    ..Header::new("global", 10L),
    typeflag: type_x_global_header(),
    pax_records: [("comment", "x")],
  }
  let wg = Writer::new()
  match wg.write_header(g_bad) {
    Ok(_) => debug_assert(false, "global header with non-zero size/mode must fail")
    Err(_) => ()
  }

  // P2-5: matching numeric PAX records preserved
  let h_uid = Header::{ ..Header::new("u", 0L), uid: 7L, pax_records: [("uid", "7")] }
  match write_all([Entry::new(h_uid, Bytes::new(0))]) {
    Ok(ar) =>
    match read_all(ar) {
      Ok(es) =>
      match es[0].header.pax_get("uid") {
        Some(v) => debug_assert(v == "7", "uid PAX preserved")
        None => debug_assert(false, "uid PAX dropped")
      }
      Err(e) => debug_assert(false, error_message(e))
    }
    Err(e) => debug_assert(false, error_message(e))
  }

  // P2-6: PaxHeaders.0 path cleaning
  debug_assert(make_pax_header_name("./foo") == "PaxHeaders.0/foo", "clean ./foo")
  debug_assert(make_pax_header_name("a/../b") == "PaxHeaders.0/b", "clean a/../b")
  debug_assert(make_pax_header_name("/a//b") == "/a/PaxHeaders.0/b", "clean /a//b")
}
