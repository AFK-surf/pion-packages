///| Core TAR archive data model, format enums, constants, limits, and error types.
///| Pure logic, zero dependencies, no `World`, all public data types are immutable `Send` values.

// --- Standard TAR Typeflag constants ---

///| Regular file (`'0'`).
pub fn type_reg() -> Byte {
  (48).to_byte()
}

///| Legacy regular file (`'\x00'`). Automatically promoted to `type_reg()` or `type_dir()`.
pub fn type_reg_a() -> Byte {
  (0).to_byte()
}

///| Hard link (`'1'`). Header-only.
pub fn type_link() -> Byte {
  (49).to_byte()
}

///| Symbolic link (`'2'`). Header-only.
pub fn type_symlink() -> Byte {
  (50).to_byte()
}

///| Character device node (`'3'`). Header-only.
pub fn type_char() -> Byte {
  (51).to_byte()
}

///| Block device node (`'4'`). Header-only.
pub fn type_block() -> Byte {
  (52).to_byte()
}

///| Directory (`'5'`). Header-only.
pub fn type_dir() -> Byte {
  (53).to_byte()
}

///| FIFO node (`'6'`). Header-only.
pub fn type_fifo() -> Byte {
  (54).to_byte()
}

///| Reserved contiguous file (`'7'`).
pub fn type_cont() -> Byte {
  (55).to_byte()
}

///| PAX extended header for the next file (`'x'`).
pub fn type_x_header() -> Byte {
  (120).to_byte()
}

///| PAX global extended header (`'g'`).
pub fn type_x_global_header() -> Byte {
  (103).to_byte()
}

///| GNU sparse file (`'S'`).
pub fn type_gnu_sparse() -> Byte {
  (83).to_byte()
}

///| GNU long file name (`'L'`).
pub fn type_gnu_long_name() -> Byte {
  (76).to_byte()
}

///| GNU long link name (`'K'`).
pub fn type_gnu_long_link() -> Byte {
  (75).to_byte()
}

///| Returns true if `flag` is a header-only entry type with no data payload.
pub fn is_header_only_type(flag : Byte) -> Bool {
  let b = flag.to_int()
  b == 49 || b == 50 || b == 51 || b == 52 || b == 53 || b == 54
}

// --- Format enum ---

///| TAR archive header format.
pub enum TarFormat {
  Unknown
  V7
  Ustar
  Pax
  Gnu
  Star
}

///|
pub fn format_equals(a : TarFormat, b : TarFormat) -> Bool {
  match (a, b) {
    (Unknown, Unknown) => true
    (V7, V7) => true
    (Ustar, Ustar) => true
    (Pax, Pax) => true
    (Gnu, Gnu) => true
    (Star, Star) => true
    _ => false
  }
}

///|
pub fn format_to_string(f : TarFormat) -> String {
  match f {
    Unknown => "<unknown>"
    V7 => "V7"
    Ustar => "USTAR"
    Pax => "PAX"
    Gnu => "GNU"
    Star => "STAR"
  }
}

// --- Timestamp ---

///| Unix timestamp with nanosecond precision (`0 <= nsec < 1_000_000_000`).
///| `has_value == false` represents an unset/zero timestamp (analogous to Go `time.Time{}`).
pub val struct Timestamp {
  pub sec : Int64
  pub nsec : Int
  pub has_value : Bool
}

///| An unset (zero) timestamp.
pub fn Timestamp::zero() -> Timestamp {
  Timestamp::{ sec: 0L, nsec: 0, has_value: false }
}

///| Construct a normalized Unix timestamp `(sec, nsec)` where `0 <= nsec < 1_000_000_000`.
pub fn Timestamp::unix(sec : Int64, nsec : Int64) -> Timestamp {
  let mut s = sec
  let mut ns = nsec
  if ns < 0L || ns >= 1000000000L {
    let q = ns / 1000000000L
    s = s + q
    ns = ns - q * 1000000000L
    if ns < 0L {
      ns = ns + 1000000000L
      s = s - 1L
    }
  }
  Timestamp::{ sec: s, nsec: ns.to_int(), has_value: true }
}

///|
pub fn Timestamp::is_zero(self : Timestamp) -> Bool {
  !self.has_value
}

///| Round timestamp to nearest whole second (halves toward +inf, matching Go `time.Time.Round(time.Second)`).
pub fn Timestamp::round_sec(self : Timestamp) -> Timestamp {
  if !self.has_value {
    return self
  }
  if self.nsec == 0 {
    return self
  }
  if self.nsec >= 500000000 {
    Timestamp::{ sec: self.sec + 1L, nsec: 0, has_value: true }
  } else {
    Timestamp::{ sec: self.sec, nsec: 0, has_value: true }
  }
}

///|
pub fn timestamp_equals(a : Timestamp, b : Timestamp) -> Bool {
  if !a.has_value && !b.has_value {
    return true
  }
  a.has_value == b.has_value && a.sec == b.sec && a.nsec == b.nsec
}

// --- Sparse entry ---

///| Represents a `length`-byte fragment starting at `offset` in a sparse file.
pub val struct SparseEntry {
  pub offset : Int64
  pub length : Int64
}

///|
pub fn SparseEntry::new(offset : Int64, length : Int64) -> SparseEntry {
  SparseEntry::{ offset: offset, length: length }
}

///|
pub fn SparseEntry::end_offset(self : SparseEntry) -> Int64 {
  self.offset + self.length
}

// --- Resource limits ---

///| Explicit resource limits to defend against TAR bombs, PAX bombs, and sparse-hole OOM.
pub val struct Limits {
  pub max_entries : Int
  pub max_entry_size : Int64
  pub max_pax_bytes : Int
  pub max_pax_records : Int
  pub max_sparse_holes : Int
}

///| Default production-safe resource limits.
pub fn Limits::default() -> Limits {
  Limits::{
    max_entries: 1000000,
    max_entry_size: 268435456L, // 256 MiB (also caps read_all total materialized bytes)
    max_pax_bytes: 1048576, // 1 MiB (matches Go maxSpecialFileSize)
    max_pax_records: 65536,
    max_sparse_holes: 1048576, // 1<<20 (matches Go)
  }
}

// --- Error type ---

///| Explicit TAR error variants.
pub enum TarError {
  InvalidHeader(String)
  InvalidChecksum(Int64)
  UnexpectedEof
  FieldTooLong(String)
  WriteTooLong
  WriteAfterClose
  IncompleteWrite(Int64)
  InsecurePath(String)
  LimitExceeded(String)
  InvalidSparse(String)
}

///| Human-readable error message.
pub fn error_message(err : TarError) -> String {
  match err {
    InvalidHeader(msg) => "tar: invalid header: " + msg
    InvalidChecksum(got) => "tar: invalid header checksum: " + got.to_string()
    UnexpectedEof => "tar: unexpected EOF"
    FieldTooLong(msg) => "tar: header field too long: " + msg
    WriteTooLong => "tar: write too long"
    WriteAfterClose => "tar: write after close"
    IncompleteWrite(rem) => "tar: missed writing " + rem.to_string() + " bytes"
    InsecurePath(p) => "tar: insecure path: " + p
    LimitExceeded(msg) => "tar: resource limit exceeded: " + msg
    InvalidSparse(msg) => "tar: invalid sparse file: " + msg
  }
}

// --- Header & Entry ---

///| A single TAR archive header (immutable, `Send`-safe).
pub struct Header {
  pub typeflag : Byte
  pub name : String
  pub linkname : String
  pub size : Int64
  pub mode : Int64
  pub uid : Int64
  pub gid : Int64
  pub uname : String
  pub gname : String
  pub mod_time : Timestamp
  pub access_time : Timestamp
  pub change_time : Timestamp
  pub devmajor : Int64
  pub devminor : Int64
  pub xattrs : Array[(String, String)]
  pub pax_records : Array[(String, String)]
  pub format : TarFormat
}

///| Create a regular-file header with sensible defaults (`mode = 0o644`, `format = Unknown`).
pub fn Header::new(name : String, size : Int64) -> Header {
  Header::{
    typeflag: type_reg(),
    name: name,
    linkname: "",
    size: size,
    mode: 420L, // 0644
    uid: 0L,
    gid: 0L,
    uname: "",
    gname: "",
    mod_time: Timestamp::zero(),
    access_time: Timestamp::zero(),
    change_time: Timestamp::zero(),
    devmajor: 0L,
    devminor: 0L,
    xattrs: [],
    pax_records: [],
    format: TarFormat::Unknown,
  }
}

///| Create a directory header (`mode = 0o755`).
pub fn Header::dir(name : String) -> Header {
  Header::{
    typeflag: type_dir(),
    name: name,
    linkname: "",
    size: 0L,
    mode: 493L, // 0755
    uid: 0L,
    gid: 0L,
    uname: "",
    gname: "",
    mod_time: Timestamp::zero(),
    access_time: Timestamp::zero(),
    change_time: Timestamp::zero(),
    devmajor: 0L,
    devminor: 0L,
    xattrs: [],
    pax_records: [],
    format: TarFormat::Unknown,
  }
}

///| Create a symbolic link header (`mode = 0o777`).
pub fn Header::symlink(name : String, linkname : String) -> Header {
  Header::{
    typeflag: type_symlink(),
    name: name,
    linkname: linkname,
    size: 0L,
    mode: 511L, // 0777
    uid: 0L,
    gid: 0L,
    uname: "",
    gname: "",
    mod_time: Timestamp::zero(),
    access_time: Timestamp::zero(),
    change_time: Timestamp::zero(),
    devmajor: 0L,
    devminor: 0L,
    xattrs: [],
    pax_records: [],
    format: TarFormat::Unknown,
  }
}

///| Create a hard link header (`mode = 0o644`).
pub fn Header::hardlink(name : String, linkname : String) -> Header {
  Header::{
    typeflag: type_link(),
    name: name,
    linkname: linkname,
    size: 0L,
    mode: 420L, // 0644
    uid: 0L,
    gid: 0L,
    uname: "",
    gname: "",
    mod_time: Timestamp::zero(),
    access_time: Timestamp::zero(),
    change_time: Timestamp::zero(),
    devmajor: 0L,
    devminor: 0L,
    xattrs: [],
    pax_records: [],
    format: TarFormat::Unknown,
  }
}

///| Look up a key in an association list (`pax_records` or `xattrs`).
pub fn kv_get(pairs : Array[(String, String)], key : String) -> Option[String] {
  let n = pairs.length()
  let mut i = n - 1
  while i >= 0 {
    let (k, v) = pairs[i]
    if k == key {
      return Option::Some(v)
    }
    i = i - 1
  }
  Option::None
}

///| Look up a PAX record value on a `Header`.
pub fn Header::pax_get(self : Header, key : String) -> Option[String] {
  kv_get(self.pax_records, key)
}

///| Look up an extended attribute (`SCHILY.xattr.<key>`) value on a `Header`.
pub fn Header::xattr_get(self : Header, key : String) -> Option[String] {
  kv_get(self.xattrs, key)
}

///| A complete TAR entry (header + logical file data).
pub struct Entry {
  pub header : Header
  pub data : Bytes
}

///|
pub fn Entry::new(header : Header, data : Bytes) -> Entry {
  Entry::{ header: header, data: data }
}
