///| Embedded official Go 1.27 `archive/tar/testdata/*.tar` vectors (lossless sparse-hex encoding)
///| and shared test helpers (hex decoding, byte comparison, IEEE CRC-32).

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn build_sparse_tar(total_len : Int, runs : Array[(Int, String)]) -> Bytes {
  let out = Bytes::new(total_len)
  let mut r = 0
  while r < runs.length() {
    let (off, hex) = runs[r]
    let n = hex.length() / 2
    let mut i = 0
    while i < n {
      let hi = hex_nibble(hex.code_unit_at(i * 2))
      let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
      out[off + i] = ((hi << 4) | lo).to_byte()
      i = i + 1
    }
    r = r + 1
  }
  out
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn bytes_concat(a : Bytes, b : Bytes) -> Bytes {
  let na = a.length()
  let nb = b.length()
  let out = Bytes::new(na + nb)
  let mut i = 0
  while i < na {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < nb {
    out[na + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn crc32_ieee_hex(b : Bytes) -> String {
  let mut crc : UInt = 0xFFFFFFFFU
  let mut i = 0
  while i < b.length() {
    crc = crc ^ b[i].to_int().to_uint()
    let mut bit = 0
    while bit < 8 {
      if (crc & 1U) != 0U {
        crc = (crc >> 1) ^ 0xEDB88320U
      } else {
        crc = crc >> 1
      }
      bit = bit + 1
    }
    i = i + 1
  }
  let final_crc = crc ^ 0xFFFFFFFFU
  let hex_chars = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 28
  while shift >= 0 {
    let nib = ((final_crc >> shift) & 0xFU).to_int()
    sb.write_string(hex_chars.slice(nib, nib + 1))
    shift = shift - 4
  }
  sb.to_string()
}

///|
fn str_repeat(s : String, count : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < count {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn bytes_from_ascii(s : String) -> Bytes {
  s.to_bytes()
}

