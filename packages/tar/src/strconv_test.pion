///| Port of Go `archive/tar/strconv_test.go` and `tar_test.go` sparse/USTAR helpers.

///|
test "go_fits_in_base256" {
  let max_i64 : Int64 = 9223372036854775807L
  let min_i64 : Int64 = -9223372036854775807L - 1L
  let p56 : Int64 = 1L << 56
  debug_assert(fits_in_base256(8, 1L) == true, "base256 +1 in 8")
  debug_assert(fits_in_base256(8, 0L) == true, "base256 0 in 8")
  debug_assert(fits_in_base256(8, -1L) == true, "base256 -1 in 8")
  debug_assert(fits_in_base256(8, p56) == false, "base256 1<<56 in 8")
  debug_assert(fits_in_base256(8, p56 - 1L) == true, "base256 (1<<56)-1 in 8")
  debug_assert(fits_in_base256(8, -p56) == true, "base256 -1<<56 in 8")
  debug_assert(fits_in_base256(8, -p56 - 1L) == false, "base256 (-1<<56)-1 in 8")
  debug_assert(fits_in_base256(8, 121654L) == true, "base256 121654 in 8")
  debug_assert(fits_in_base256(8, -9849849L) == true, "base256 -9849849 in 8")
  debug_assert(fits_in_base256(9, max_i64) == true, "base256 MaxInt64 in 9")
  debug_assert(fits_in_base256(9, 0L) == true, "base256 0 in 9")
  debug_assert(fits_in_base256(9, min_i64) == true, "base256 MinInt64 in 9")
  debug_assert(fits_in_base256(12, max_i64) == true, "base256 MaxInt64 in 12")
  debug_assert(fits_in_base256(12, 0L) == true, "base256 0 in 12")
  debug_assert(fits_in_base256(12, min_i64) == true, "base256 MinInt64 in 12")
}

///|
test "go_fits_in_octal" {
  let max_i64 : Int64 = 9223372036854775807L
  debug_assert(fits_in_octal(1, -1L) == false, "octal -1 in 1")
  debug_assert(fits_in_octal(2, -1L) == false, "octal -1 in 2")
  debug_assert(fits_in_octal(3, -1L) == false, "octal -1 in 3")
  debug_assert(fits_in_octal(1, 0L) == true, "octal 0 in 1")
  debug_assert(fits_in_octal(1, 1L) == false, "octal 1 in 1")
  debug_assert(fits_in_octal(2, 0L) == true, "octal 0 in 2")
  debug_assert(fits_in_octal(2, 7L) == true, "octal 7 in 2")
  debug_assert(fits_in_octal(2, 8L) == false, "octal 8 in 2")
  debug_assert(fits_in_octal(4, 0L) == true, "octal 0 in 4")
  debug_assert(fits_in_octal(4, 511L) == true, "octal 0777 in 4")
  debug_assert(fits_in_octal(4, 512L) == false, "octal 0777+1 in 4")
  debug_assert(fits_in_octal(8, 0L) == true, "octal 0 in 8")
  debug_assert(fits_in_octal(8, 2097151L) == true, "octal 07777777 in 8")
  debug_assert(fits_in_octal(8, 2097152L) == false, "octal 07777777+1 in 8")
  debug_assert(fits_in_octal(12, 0L) == true, "octal 0 in 12")
  debug_assert(fits_in_octal(12, 8589934591L) == true, "octal 077777777777 in 12")
  debug_assert(fits_in_octal(12, 8589934592L) == false, "octal 077777777777+1 in 12")
  debug_assert(fits_in_octal(22, max_i64) == true, "octal MaxInt64 in 22")
  debug_assert(fits_in_octal(12, -1564164L) == false, "octal negative in 12")
  debug_assert(fits_in_octal(30, -1564164L) == false, "octal negative in 30")
}

///|
fn assert_parse_numeric_ok(hex : String, want : Int64, label : String) -> Unit {
  match parse_numeric(hex_to_bytes(hex)) {
    Ok(got) => debug_assert(got == want, label + ": got " + got.to_string() + ", want " + want.to_string())
    Err(e) => debug_assert(false, label + ": unexpected error: " + error_message(e))
  }
}

///|
fn assert_parse_numeric_err(hex : String, label : String) -> Unit {
  match parse_numeric(hex_to_bytes(hex)) {
    Ok(got) => debug_assert(false, label + ": expected error, got " + got.to_string())
    Err(_) => ()
  }
}

///|
test "go_parse_numeric_base256" {
  let max_i64 : Int64 = 9223372036854775807L
  let min_i64 : Int64 = -9223372036854775807L - 1L
  assert_parse_numeric_ok("", 0L, "empty")
  assert_parse_numeric_ok("80", 0L, "0x80")
  assert_parse_numeric_ok("8000", 0L, "0x8000")
  assert_parse_numeric_ok("800000", 0L, "0x800000")
  assert_parse_numeric_ok("bf", 63L, "0xbf")
  assert_parse_numeric_ok("bfff", 16383L, "0xbfff")
  assert_parse_numeric_ok("bfffff", 4194303L, "0xbfffff")
  assert_parse_numeric_ok("ff", -1L, "0xff")
  assert_parse_numeric_ok("ffff", -1L, "0xffff")
  assert_parse_numeric_ok("ffffff", -1L, "0xffffff")
  assert_parse_numeric_ok("c0", -64L, "0xc0")
  assert_parse_numeric_ok("c000", -16384L, "0xc000")
  assert_parse_numeric_ok("c00000", -4194304L, "0xc00000")
  assert_parse_numeric_ok("8776a222eb8a7261", 537795476381659745L, "pos8")
  assert_parse_numeric_ok("800000000776a222eb8a7261", 537795476381659745L, "pos12")
  assert_parse_numeric_ok("f776a222eb8a7261", -615126028225187231L, "neg8")
  assert_parse_numeric_ok("fffffffff776a222eb8a7261", -615126028225187231L, "neg12")
  assert_parse_numeric_ok("807fffffffffffffff", max_i64, "MaxInt64")
  assert_parse_numeric_err("808000000000000000", "MaxInt64+1 overflow")
  assert_parse_numeric_ok("ff8000000000000000", min_i64, "MinInt64")
  assert_parse_numeric_err("ff7fffffffffffffff", "MinInt64-1 overflow")
  assert_parse_numeric_err("f5ecd1c77e5f2648819f8f9b", "wide negative overflow")
}

///|
test "go_parse_numeric_octal" {
  assert_parse_numeric_ok("3030303030303000", 0L, "0000000\\0")
  assert_parse_numeric_ok("2000303030303000", 0L, " \\000000\\0")
  assert_parse_numeric_ok("2000303030303300", 3L, " \\000003\\0")
  assert_parse_numeric_ok("303030303030303032323700", 151L, "0227")
  assert_parse_numeric_ok("3033323033330020", 13339L, "032033\\0 ")
  assert_parse_numeric_ok("303030303636300020", 432L, "0660")
  assert_parse_numeric_ok("0020303030303636300020", 432L, "\\0 0000660\\0 ")
  assert_parse_numeric_ok("3031323334353637003839616263646566", 342391L, "01234567\\0trailing")
  assert_parse_numeric_err("30313233343536373839616263646566", "hex digits in octal")
  assert_parse_numeric_err("3031323334353637383900616263646566", "8/9 before nul")
  assert_parse_numeric_err("303132337e5f2634313233", "garbage in octal")
}

///|
fn assert_format_numeric_ok(width : Int, x : Int64, want_hex : String, label : String) -> Unit {
  match format_numeric(width, x) {
    Ok(got) => debug_assert(bytes_eq(got, hex_to_bytes(want_hex)), label + ": byte mismatch")
    Err(e) => debug_assert(false, label + ": unexpected err: " + error_message(e))
  }
}

///|
fn assert_format_numeric_err(width : Int, x : Int64, label : String) -> Unit {
  match format_numeric(width, x) {
    Ok(_) => debug_assert(false, label + ": expected error")
    Err(_) => ()
  }
}

///|
test "go_format_numeric" {
  let max_i64 : Int64 = 9223372036854775807L
  let min_i64 : Int64 = -9223372036854775807L - 1L
  assert_format_numeric_ok(2, 0L, "3000", "0 in 2")
  assert_format_numeric_ok(2, 7L, "3700", "7 in 2")
  assert_format_numeric_ok(2, 8L, "8008", "8 in 2 (base256)")
  assert_format_numeric_ok(3, 63L, "373700", "077 in 3")
  assert_format_numeric_ok(3, 64L, "800040", "0100 in 3 (base256)")
  assert_format_numeric_ok(8, 0L, "3030303030303000", "0 in 8")
  assert_format_numeric_ok(8, 83L, "3030303031323300", "0123 in 8")
  assert_format_numeric_ok(8, 2097151L, "3737373737373700", "07777777 in 8")
  assert_format_numeric_ok(8, 2097152L, "8000000000200000", "010000000 in 8")
  assert_format_numeric_ok(12, 8589934591L, "373737373737373737373700", "077777777777 in 12")
  assert_format_numeric_ok(12, 8589934592L, "800000000000000200000000", "0100000000000 in 12")
  assert_format_numeric_ok(1, -1L, "ff", "-1 in 1")
  assert_format_numeric_ok(2, -1L, "ffff", "-1 in 2")
  assert_format_numeric_ok(2, 255L, "80ff", "255 in 2")
  assert_format_numeric_err(2, 256L, "256 in 2 fails")
  assert_format_numeric_ok(2, -256L, "ff00", "-256 in 2")
  assert_format_numeric_err(2, -257L, "-257 in 2 fails")
  assert_format_numeric_ok(12, 537795476381659745L, "800000000776a222eb8a7261", "pos12")
  assert_format_numeric_ok(12, -615126028225187231L, "fffffffff776a222eb8a7261", "neg12")
  assert_format_numeric_ok(12, max_i64, "800000007fffffffffffffff", "MaxInt64 in 12")
  assert_format_numeric_ok(12, min_i64, "ffffffff8000000000000000", "MinInt64 in 12")
  assert_format_numeric_ok(9, max_i64, "807fffffffffffffff", "MaxInt64 in 9")
  assert_format_numeric_ok(9, min_i64, "ff8000000000000000", "MinInt64 in 9")
  assert_format_numeric_err(8, max_i64, "MaxInt64 in 8 fails")
  assert_format_numeric_err(8, min_i64, "MinInt64 in 8 fails")
}

///|
fn assert_pax_time_ok(s : String, want_sec : Int64, want_nsec : Int64) -> Unit {
  let want = Timestamp::unix(want_sec, want_nsec)
  match parse_pax_time(s) {
    Ok(got) =>
    debug_assert(
      timestamp_equals(got, want),
      "parse_pax_time(" + s + "): got (" + got.sec.to_string() + ", " + got.nsec.to_string() + "), want (" + want.sec.to_string() + ", " + want.nsec.to_string() + ")",
    )
    Err(e) => debug_assert(false, "parse_pax_time(" + s + ") failed: " + error_message(e))
  }
}

///|
fn assert_pax_time_err(s : String) -> Unit {
  match parse_pax_time(s) {
    Ok(_) => debug_assert(false, "parse_pax_time(" + s + "): expected error")
    Err(_) => ()
  }
}

///|
test "go_parse_pax_time" {
  assert_pax_time_ok("1350244992.023960108", 1350244992L, 23960108L)
  assert_pax_time_ok("1350244992.02396010", 1350244992L, 23960100L)
  assert_pax_time_ok("1350244992.0239601089", 1350244992L, 23960108L)
  assert_pax_time_ok("1350244992.3", 1350244992L, 300000000L)
  assert_pax_time_ok("1350244992", 1350244992L, 0L)
  assert_pax_time_ok("-1.000000001", -1L, -1L)
  assert_pax_time_ok("-1.000001", -1L, -1000L)
  assert_pax_time_ok("-1.001000", -1L, -1000000L)
  assert_pax_time_ok("-1", -1L, 0L)
  assert_pax_time_ok("-1.999999999", -1L, -999999999L)
  assert_pax_time_ok("0.000000001", 0L, 1L)
  assert_pax_time_ok("0", 0L, 0L)
  assert_pax_time_ok("1.", 1L, 0L)
  assert_pax_time_ok("0.0", 0L, 0L)
  assert_pax_time_ok("-0.0", 0L, 0L)
  assert_pax_time_ok("-0.1", 0L, -100000000L)
  assert_pax_time_ok("-0.99", 0L, -990000000L)
  assert_pax_time_ok("-1.3", -1L, -300000000L)
  assert_pax_time_ok("-1350244992.023960108", -1350244992L, -23960108L)
  assert_pax_time_err("")
  assert_pax_time_err(".5")
  assert_pax_time_err("-")
  assert_pax_time_err("+")
  assert_pax_time_err("-1.-1")
  assert_pax_time_err("99999999999999999999999999999999999999999999999")
  assert_pax_time_err("0.123456789abcdef")
  assert_pax_time_err("foo")
  assert_pax_time_err("98765﹒43210")
}

///|
test "go_format_pax_time" {
  debug_assert(format_pax_time(Timestamp::unix(1350244992L, 0L)) == "1350244992", "pos int")
  debug_assert(format_pax_time(Timestamp::unix(1350244992L, 300000000L)) == "1350244992.3", "pos .3")
  debug_assert(format_pax_time(Timestamp::unix(1350244992L, 23960100L)) == "1350244992.0239601", "pos trim")
  debug_assert(format_pax_time(Timestamp::unix(1350244992L, 23960108L)) == "1350244992.023960108", "pos full")
  debug_assert(format_pax_time(Timestamp::unix(0L, 0L)) == "0", "zero")
  debug_assert(format_pax_time(Timestamp::unix(0L, 1L)) == "0.000000001", "0+1ns")
  debug_assert(format_pax_time(Timestamp::unix(0L, -100000000L)) == "-0.1", "-0.1")
  debug_assert(format_pax_time(Timestamp::unix(-1L, 0L)) == "-1", "-1")
  debug_assert(format_pax_time(Timestamp::unix(-1L, -1L)) == "-1.000000001", "-1.000000001")
  debug_assert(format_pax_time(Timestamp::unix(-1L, -999999999L)) == "-1.999999999", "-1.999999999")
  debug_assert(format_pax_time(Timestamp::unix(-1350244992L, -23960108L)) == "-1350244992.023960108", "neg full")
}

///|
test "go_parse_pax_record" {
  let med_name = str_repeat("CD", 50)
  let long_name = str_repeat("AB", 100)
  match parse_pax_record("6 k=v\n\n") {
    Ok((k, v, r)) => debug_assert(k == "k" && v == "v" && r == "\n", "6 k=v")
    Err(_) => debug_assert(false, "6 k=v failed")
  }
  match parse_pax_record("19 path=/etc/hosts\n") {
    Ok((k, v, r)) => debug_assert(k == "path" && v == "/etc/hosts" && r == "", "19 path")
    Err(_) => debug_assert(false, "19 path failed")
  }
  match parse_pax_record("210 path=" + long_name + "\nabc") {
    Ok((k, v, r)) => debug_assert(k == "path" && v == long_name && r == "abc", "210 path")
    Err(_) => debug_assert(false, "210 path failed")
  }
  match parse_pax_record("110 path=" + med_name + "\n") {
    Ok((k, v, r)) => debug_assert(k == "path" && v == med_name && r == "", "110 path")
    Err(_) => debug_assert(false, "110 path failed")
  }
  match parse_pax_record("27 ☺☻☹=日a本b語ç\nmeow mix") {
    Ok((k, v, r)) => debug_assert(k == "☺☻☹" && v == "日a本b語ç" && r == "meow mix", "utf8 pax")
    Err(_) => debug_assert(false, "utf8 pax failed")
  }
  // Invalid PAX records
  let bad = [
    "1 k=1\n",
    "6 k~1\n",
    "6_k=1\n",
    "6 k=1 ",
    "632 k=1\n",
    "16 longkeyname=hahaha\n",
    "3 somelongkey=\n",
    "50 tooshort=\n",
    "06 k=v\n",
    "00006 k=v\n",
    "000006 k=v\n",
    "0 k=v\n",
    "+0000005 x=\n",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse_pax_record(bad[i]) {
      Ok(_) => debug_assert(false, "expected invalid PAX record: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "go_format_pax_record" {
  let med_name = str_repeat("CD", 50)
  let long_name = str_repeat("AB", 100)
  match format_pax_record("k", "v") {
    Ok(s) => debug_assert(s == "6 k=v\n", "format k=v")
    Err(_) => debug_assert(false, "format k=v err")
  }
  match format_pax_record("path", "/etc/hosts") {
    Ok(s) => debug_assert(s == "19 path=/etc/hosts\n", "format path")
    Err(_) => debug_assert(false, "format path err")
  }
  match format_pax_record("path", med_name) {
    Ok(s) => debug_assert(s == "110 path=" + med_name + "\n", "format med_name")
    Err(_) => debug_assert(false, "format med_name err")
  }
  match format_pax_record("path", long_name) {
    Ok(s) => debug_assert(s == "210 path=" + long_name + "\n", "format long_name")
    Err(_) => debug_assert(false, "format long_name err")
  }
  match format_pax_record("☺☻☹", "日a本b語ç") {
    Ok(s) => debug_assert(s == "27 ☺☻☹=日a本b語ç\n", "format utf8")
    Err(_) => debug_assert(false, "format utf8 err")
  }
  match format_pax_record("k=bad", "v") {
    Ok(_) => debug_assert(false, "key with '=' must fail")
    Err(_) => ()
  }
  match format_pax_record("", "v") {
    Ok(_) => debug_assert(false, "empty key must fail")
    Err(_) => ()
  }
}

///|
fn sparse_eq(a : Array[SparseEntry], b : Array[SparseEntry]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].offset != b[i].offset || a[i].length != b[i].length {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "go_sparse_entries_math" {
  let max_i64 : Int64 = 9223372036854775807L
  // Valid cases
  debug_assert(validate_sparse_entries([], 0L), "empty size 0")
  debug_assert(sparse_eq(invert_sparse_entries([], 0L), [SparseEntry::new(0L, 0L)]), "invert empty 0")
  debug_assert(validate_sparse_entries([], 5000L), "empty size 5000")
  debug_assert(sparse_eq(invert_sparse_entries([], 5000L), [SparseEntry::new(0L, 5000L)]), "invert empty 5000")

  let s1 = [SparseEntry::new(1000L, 4000L)]
  debug_assert(validate_sparse_entries(s1, 5000L), "s1 valid")
  debug_assert(sparse_eq(align_sparse_entries(s1, 5000L), [SparseEntry::new(1024L, 3976L)]), "s1 align")
  debug_assert(sparse_eq(invert_sparse_entries(s1, 5000L), [SparseEntry::new(0L, 1000L), SparseEntry::new(5000L, 0L)]), "s1 invert")

  let s2 = [SparseEntry::new(0L, 2000L), SparseEntry::new(8000L, 2000L)]
  debug_assert(validate_sparse_entries(s2, 10000L), "s2 valid")
  debug_assert(sparse_eq(align_sparse_entries(s2, 10000L), [SparseEntry::new(0L, 1536L), SparseEntry::new(8192L, 1808L)]), "s2 align")
  debug_assert(sparse_eq(invert_sparse_entries(s2, 10000L), [SparseEntry::new(2000L, 6000L), SparseEntry::new(10000L, 0L)]), "s2 invert")

  // Invalid cases
  debug_assert(!validate_sparse_entries([SparseEntry::new(1L, 0L)], 0L), "beyond 0")
  debug_assert(!validate_sparse_entries([SparseEntry::new(-1L, 0L)], 100L), "neg offset")
  debug_assert(!validate_sparse_entries([SparseEntry::new(0L, -1L)], 100L), "neg len")
  debug_assert(!validate_sparse_entries([SparseEntry::new(0L, 0L)], -100L), "neg size")
  debug_assert(!validate_sparse_entries([SparseEntry::new(max_i64, max_i64)], max_i64), "i64 overflow")
  debug_assert(!validate_sparse_entries([SparseEntry::new(3L, 3L)], 5L), "end > size")
  debug_assert(!validate_sparse_entries([SparseEntry::new(2L, 0L), SparseEntry::new(1L, 0L)], 3L), "unsorted")
  debug_assert(!validate_sparse_entries([SparseEntry::new(1L, 3L), SparseEntry::new(2L, 2L)], 10L), "overlap")
}

///|
test "go_split_ustar_path" {
  // <= 100 bytes does not need split
  match split_ustar_path("short/file.txt") {
    None => ()
    Some(_) => debug_assert(false, "short path should not split")
  }
  // 15 * 9 + 8 = 143 bytes -> splittable
  let long_ustar = str_repeat("longname/", 15) + "file.txt"
  match split_ustar_path(long_ustar) {
    Some((prefix, suffix)) => {
      debug_assert(prefix.length() <= 155 && suffix.length() <= 100, "split bounds")
      debug_assert(prefix + "/" + suffix == long_ustar, "reconstructed path")
    }
    None => debug_assert(false, "splittable USTAR path returned None")
  }
  // Non-ASCII cannot split in USTAR
  match split_ustar_path(str_repeat("a/", 60) + "日本語.txt") {
    None => ()
    Some(_) => debug_assert(false, "non-ASCII should not split in USTAR")
  }
  // > 256 bytes cannot split in USTAR
  match split_ustar_path(str_repeat("a", 160) + "/" + str_repeat("b", 105)) {
    None => ()
    Some(_) => debug_assert(false, ">256 path should not split in USTAR")
  }
}
