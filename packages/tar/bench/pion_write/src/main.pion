///| Benchmark Workload 2: Mixed USTAR/PAX/GNU TAR Archive Encoding (20 rounds x 2,000 entries).

import "tar"

///|
fn make_payload(idx : Int, size : Int) -> Bytes {
  let out = Bytes::new(size)
  let mut s = (idx * 31 + 17) & 0xFF
  let mut i = 0
  while i < size {
    out[i] = s.to_byte()
    s = (s * 73 + 19) & 0xFF
    i = i + 1
  }
  out
}

///|
fn build_entries(count : Int) -> Array[tar::Entry] {
  let out : Array[tar::Entry] = Array::with_capacity(count)
  let mut i = 0
  while i < count {
    let mod = i % 20
    if mod < 12 {
      if mod == 11 {
        let h = tar::Header::{
          ..tar::Header::dir("pkg/mod_" + (i / 20).to_string() + "/dir_" + i.to_string() + "/"),
          uid: 1000L,
          gid: 1000L,
          uname: "builder",
          gname: "staff",
          mod_time: tar::Timestamp::unix(1700000000L + i.to_int64(), 0L),
        }
        out.push(tar::Entry::new(h, Bytes::new(0)))
      } else if mod == 10 {
        let h = tar::Header::{
          ..tar::Header::symlink(
            "pkg/mod_" + (i / 20).to_string() + "/link_" + i.to_string(),
            "file_" + (i - 1).to_string() + ".dat",
          ),
          uid: 1000L,
          gid: 1000L,
          uname: "builder",
          gname: "staff",
          mod_time: tar::Timestamp::unix(1700000000L + i.to_int64(), 0L),
        }
        out.push(tar::Entry::new(h, Bytes::new(0)))
      } else {
        let sz = 256 + ((i * 397) % 3072)
        let data = make_payload(i, sz)
        let h = tar::Header::{
          ..tar::Header::new(
            "pkg/mod_" + (i / 20).to_string() + "/src/file_" + i.to_string() + ".dat",
            sz.to_int64(),
          ),
          uid: 1000L,
          gid: 1000L,
          uname: "builder",
          gname: "staff",
          mod_time: tar::Timestamp::unix(1700000000L + i.to_int64(), 0L),
        }
        out.push(tar::Entry::new(h, data))
      }
    } else if mod < 17 {
      let sz = 512 + ((i * 613) % 4096)
      let data = make_payload(i, sz)
      let long_name = "workspace/services/telemetry_cluster_v4/shards/region_ap_northeast_1/partition_" +
      (i / 10).to_string() +
      "/sub_component_alpha_beta_gamma/artifact_item_" +
      i.to_string() +
      ".bin"
      let h = tar::Header::{
        ..tar::Header::new(long_name, sz.to_int64()),
        uid: 2500000L + i.to_int64(),
        gid: 1000L,
        uname: "pax_user",
        gname: "pax_group",
        mod_time: tar::Timestamp::unix(1700000000L + i.to_int64(), 0L),
        format: tar::TarFormat::Pax,
      }
      out.push(tar::Entry::new(h, data))
    } else {
      let sz = 512 + ((i * 521) % 3584)
      let data = make_payload(i, sz)
      let gnu_name = "gnu_archive/deep_hierarchy/segment_0001/segment_0002/segment_0003/segment_0004/segment_0005/long_gnu_entry_" +
      i.to_string() +
      ".blob"
      let h = tar::Header::{
        ..tar::Header::new(gnu_name, sz.to_int64()),
        uid: 1000L,
        gid: 1000L,
        uname: "gnu_user",
        gname: "gnu_group",
        mod_time: tar::Timestamp::unix(1700000000L + i.to_int64(), 0L),
        format: tar::TarFormat::Gnu,
      }
      out.push(tar::Entry::new(h, data))
    }
    i = i + 1
  }
  out
}

///|
pub fn main(world : World) -> Int {
  let count = 2000
  let rounds = 20
  let entries = build_entries(count)
  let mut total_archive_bytes : Int64 = 0L
  let mut last_archive = Bytes::new(0)

  let mut r = 0
  while r < rounds {
    let encoded = match tar::write_all(entries) {
      Ok(b) => b
      Err(_) => return 1
    }
    total_archive_bytes = total_archive_bytes + encoded.length().to_int64()
    last_archive = encoded
    r = r + 1
  }

  // Verify encoded archive once via streaming readback for cross-language SHA-256 parity
  let reader = tar::Reader::new(last_archive)
  let mut verified_entries : Int64 = 0L
  let mut verified_payload : Int64 = 0L
  let mut checksum : UInt64 = 14695981039346656037UL
  while true {
    match reader.next() {
      Ok(Some(hdr)) => {
        verified_entries = verified_entries + 1L
        let nb = hdr.name.to_bytes()
        let mut j = 0
        while j < nb.length() {
          checksum = (checksum ^ nb[j].to_int().to_int64().to_uint64()) * 1099511628211UL
          j = j + 1
        }
        let body = match reader.read_data() {
          Ok(b) => b
          Err(_) => return 2
        }
        verified_payload = verified_payload + body.length().to_int64()
        if body.length() > 0 {
          checksum = (checksum ^ body[0].to_int().to_int64().to_uint64()) * 1099511628211UL
          checksum = (checksum ^ body[body.length() - 1].to_int().to_int64().to_uint64()) * 1099511628211UL
        }
      }
      Ok(None) => break
      Err(_) => return 3
    }
  }

  let block_aligned = if (total_archive_bytes % 512L) == 0L { 1 } else { 0 }
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "entries=" + verified_entries.to_string())
  io_println(world, "payload_bytes=" + verified_payload.to_string())
  io_println(world, "block_aligned=" + block_aligned.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
