///| Benchmark Workload 1: Mixed USTAR/PAX/GNU TAR Streaming Read + Payload Checksum.

import "tar"

///|
fn fnv1a_bytes(hash : UInt64, b : Bytes) -> UInt64 {
  let mut h = hash
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_read <corpus.tar>")
    return 1
  }
  let data = match fs_read_bytes(world, args[1]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let rounds = 20
  let mut total_entries : Int64 = 0L
  let mut total_name_bytes : Int64 = 0L
  let mut total_payload_bytes : Int64 = 0L
  let mut checksum : UInt64 = 14695981039346656037UL

  let mut r = 0
  while r < rounds {
    let reader = tar::Reader::new(data)
    while true {
      match reader.next() {
        Ok(Some(hdr)) => {
          total_entries = total_entries + 1L
          let nb = hdr.name.to_bytes()
          total_name_bytes = total_name_bytes + nb.length().to_int64()
          checksum = fnv1a_bytes(checksum, nb)
          checksum = (checksum ^ hdr.size.to_uint64()) * 1099511628211UL
          checksum = (checksum ^ hdr.typeflag.to_int().to_int64().to_uint64()) * 1099511628211UL
          let body = match reader.read_data() {
            Ok(b) => b
            Err(_) => return 2
          }
          total_payload_bytes = total_payload_bytes + body.length().to_int64()
          if body.length() > 0 {
            checksum = fnv1a_bytes(checksum, body)
          }
        }
        Ok(None) => break
        Err(_) => return 3
      }
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "entries=" + total_entries.to_string())
  io_println(world, "name_bytes=" + total_name_bytes.to_string())
  io_println(world, "payload_bytes=" + total_payload_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
