///| Wasm32 smoke entry for the `tar` package.

import "tar"

///|
pub fn smoke() -> Int {
  let long_name = "deep/dir/0123456789/0123456789/0123456789/0123456789/0123456789/0123456789/0123456789/0123456789/0123456789/file.txt"
  let entries = [
    tar::Entry::new(
      tar::Header::{
        ..tar::Header::new("hello.txt", 12L),
        mode: 420L,
        uname: "alice",
        gname: "staff",
        mod_time: tar::Timestamp::unix(1700000000L, 0L),
      },
      "hello world\n".to_bytes(),
    ),
    tar::Entry::new(
      tar::Header::{
        ..tar::Header::new(long_name, 4L),
        uid: 3000000L,
        mod_time: tar::Timestamp::unix(1700000001L, 123456789L),
        xattrs: [("user.tag", "wasm")],
        format: tar::TarFormat::Pax,
      },
      "wasm".to_bytes(),
    ),
    tar::Entry::new(tar::Header::dir("sub/"), Bytes::new(0)),
  ]
  let archive = match tar::write_all(entries) {
    Ok(b) => b
    Err(_) => return -1
  }
  let decoded = match tar::read_all(archive) {
    Ok(es) => es
    Err(_) => return -2
  }
  if decoded.length() != 3 {
    return -3
  }
  if decoded[0].data.to_string() != "hello world\n" {
    return -4
  }
  if decoded[1].header.name != long_name || decoded[1].header.uid != 3000000L {
    return -5
  }
  match tar::clean_extract_path("../etc/passwd") {
    Err(_) => ()
    Ok(_) => return -6
  }
  match tar::clean_extract_path("./a/b.txt") {
    Ok(p) => if p != "a/b.txt" { return -7 }
    Err(_) => return -8
  }
  archive.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "tar_wasm_smoke: OK archive_bytes=" + r.to_string())
    0
  } else {
    io_println(world, "tar_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
