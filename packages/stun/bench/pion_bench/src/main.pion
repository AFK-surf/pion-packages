///| Pion Native head-to-head benchmark for `packages/stun` vs Rust `webrtc-rs/stun`.
///| Modes:
///|   encode_sign   - Encode & sign 100,000 WebRTC ICE STUN packets (Binding Request + IPv4/IPv6 Responses)
///|   decode_verify - Decode + verify FINGERPRINT + MESSAGE-INTEGRITY on 100,000 WebRTC ICE STUN packets

import "stun"
import "crypto"

///|
fn make_tx_id(i : Int) -> Bytes {
  let mut tx = Bytes::new(12)
  let v = i.to_uint()
  tx[0] = (0xA5).to_byte()
  tx[1] = (0x5A).to_byte()
  tx[2] = (0x12).to_byte()
  tx[3] = (0x34).to_byte()
  tx[4] = ((v >> 24U) & 0xFFU).to_int().to_byte()
  tx[5] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  tx[6] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  tx[7] = (v & 0xFFU).to_int().to_byte()
  tx[8] = (0xFE).to_byte()
  tx[9] = (0xED).to_byte()
  tx[10] = (0xFA).to_byte()
  tx[11] = (0xCE).to_byte()
  tx
}

///|
fn make_ipv6_bytes(i : Int) -> Bytes {
  let mut ip = Bytes::new(16)
  ip[0] = (0x20).to_byte()
  ip[1] = (0x01).to_byte()
  ip[2] = (0x0d).to_byte()
  ip[3] = (0xb8).to_byte()
  ip[4] = (0x12).to_byte()
  ip[5] = (0x34).to_byte()
  ip[6] = (0x56).to_byte()
  ip[7] = (0x78).to_byte()
  ip[8] = (0x00).to_byte()
  ip[9] = (0x11).to_byte()
  ip[10] = (0x22).to_byte()
  ip[11] = (0x33).to_byte()
  ip[12] = ((i >> 24) & 0xFF).to_byte()
  ip[13] = ((i >> 16) & 0xFF).to_byte()
  ip[14] = ((i >> 8) & 0xFF).to_byte()
  ip[15] = (i & 0xFF).to_byte()
  ip
}

///|
fn build_packet(i : Int, key : Bytes) -> Bytes {
  let kind = i % 3
  let tx = make_tx_id(i)
  if kind == 0 {
    let msg = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx)
    msg.add(stun::Attribute::Username("rUfrag99:lUfrag42"))
    msg.add(stun::Attribute::Priority(2130706431U - (i & 0xFFFF).to_uint()))
    msg.add(stun::Attribute::IceControlling(0x1122334455667788UL + i.to_int64().to_uint64()))
    msg.add(stun::Attribute::UseCandidate)
    match stun::encode_message_signed(msg, Some(key), false, true) {
      Ok(w) => w
      Err(_) => Bytes::new(0)
    }
  } else if kind == 1 {
    let msg = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
    let addr = stun::socket_addr_ipv4(192, 0, 2, (i & 0xFF), 10000 + (i & 0x7FFF))
    msg.add(stun::Attribute::XorMappedAddress(addr))
    match stun::encode_message_signed(msg, Some(key), false, true) {
      Ok(w) => w
      Err(_) => Bytes::new(0)
    }
  } else {
    let msg = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
    let addr = stun::socket_addr_ipv6(make_ipv6_bytes(i), 20000 + (i & 0x7FFF))
    msg.add(stun::Attribute::XorMappedAddress(addr))
    match stun::encode_message_signed(msg, Some(key), false, true) {
      Ok(w) => w
      Err(_) => Bytes::new(0)
    }
  }
}

///|
fn bench_encode_sign(world : World, count : Int) -> Int {
  let key = stun::string_to_utf8_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  let hasher = crypto::Sha256::new()
  let mut total_bytes = 0L
  let mut i = 0
  while i < count {
    let w = build_packet(i, key)
    if w.length() == 0 {
      return 1
    }
    total_bytes = total_bytes + w.length().to_int64()
    hasher.update(w)
    i = i + 1
  }
  io_println(world, "mode=encode_sign")
  io_println(world, "count=" + count.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "sha256=" + hasher.finalize_hex())
  0
}

///|
fn bench_decode_verify(world : World, count : Int) -> Int {
  let key = stun::string_to_utf8_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  // Pre-build 300 distinct packets (100 of each kind) and decode/verify in a loop to reach `count`
  let corpus : Array[Bytes] = []
  let mut k = 0
  while k < 300 {
    corpus.push(build_packet(k, key))
    k = k + 1
  }

  let mut total_bytes = 0L
  let mut checksum = 0L
  let mut i = 0
  while i < count {
    let pkt = corpus[i % 300]
    total_bytes = total_bytes + pkt.length().to_int64()
    match stun::verify_fingerprint(pkt) {
      Ok(true) => ()
      _ => return 2
    }
    match stun::verify_message_integrity(pkt, key) {
      Ok(true) => ()
      _ => return 3
    }
    let msg = match stun::decode_message(pkt) {
      Ok(m) => m
      Err(_) => return 4
    }
    checksum = (checksum * 131L + msg.attributes.length().to_int64()) % 1000000007L
    let mut a = 0
    while a < msg.attributes.length() {
      match msg.attributes[a] {
        stun::Attribute::Priority(p) => {
          checksum = (checksum * 131L + p.to_int64()) % 1000000007L
        }
        stun::Attribute::XorMappedAddress(addr) => {
          match addr {
            stun::SocketAddr::Ipv4(ip, port) => {
              checksum = (checksum * 131L + ip.to_int64() + port.to_int64()) % 1000000007L
            }
            stun::SocketAddr::Ipv6(ip6, port) => {
              checksum = (checksum * 131L + ip6[15].to_int().to_int64() + port.to_int64()) % 1000000007L
            }
          }
        }
        _ => ()
      }
      a = a + 1
    }
    i = i + 1
  }
  io_println(world, "mode=decode_verify")
  io_println(world, "count=" + count.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: stun_bench <encode_sign|decode_verify> [count]")
    return 1
  }
  let mode = args[1]
  let count = 100000
  if mode == "encode_sign" {
    bench_encode_sign(world, count)
  } else if mode == "decode_verify" {
    bench_decode_verify(world, count)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
