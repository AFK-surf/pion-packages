///| RFC 8445 ICE candidate priority, pair priority, and Sans-IO IceAgent state machine.

///| RFC 8445 §5.1.2.1:
///| priority = (2^24)*(type_pref) + (2^8)*(local_pref) + (256 - component_id)
pub fn compute_candidate_priority(
  type_pref : Int,
  local_pref : Int,
  component_id : Int,
) -> Result[UInt, StunError] {
  if type_pref < 0 || type_pref > 126 {
    return Err(StunError::IceError("type_pref must be in 0..126"))
  }
  if local_pref < 0 || local_pref > 65535 {
    return Err(StunError::IceError("local_pref must be in 0..65535"))
  }
  if component_id < 1 || component_id > 256 {
    return Err(StunError::IceError("component_id must be in 1..256"))
  }
  let p : UInt = (type_pref.to_uint() << 24U) |
  (local_pref.to_uint() << 8U) |
  (256 - component_id).to_uint()
  Ok(p)
}

///| RFC 8445 §6.1.2.3:
///| pair priority = 2^32 * MIN(G, D) + 2 * MAX(G, D) + (G > D ? 1 : 0)
pub fn compute_pair_priority(controlling_prio : UInt, controlled_prio : UInt) -> Int64 {
  let g = controlling_prio.to_int64()
  let d = controlled_prio.to_int64()
  let mn = if g < d { g } else { d }
  let mx = if g > d { g } else { d }
  let tie = if g > d { 1L } else { 0L }
  (mn << 32) + (mx << 1) + tie
}

///|
fn same_addr_family(a : SocketAddr, b : SocketAddr) -> Bool {
  match (a, b) {
    (SocketAddr::Ipv4(_, _), SocketAddr::Ipv4(_, _)) => true
    (SocketAddr::Ipv6(_, _), SocketAddr::Ipv6(_, _)) => true
    _ => false
  }
}

///|
fn ice_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn IceAgent::new(
  role : IceRole,
  tie_breaker : UInt64,
  local_ufrag : String,
  local_pwd : String,
  aggressive_nomination : Bool,
) -> IceAgent {
  IceAgent::{
    role: role,
    tie_breaker: tie_breaker,
    local_ufrag: local_ufrag,
    local_pwd: local_pwd,
    remote_ufrag: "",
    remote_pwd: "",
    aggressive_nomination: aggressive_nomination,
    local_candidates: [],
    remote_candidates: [],
    pairs: [],
    tx_counter: 1UL,
    nominated_pair_idx: None,
  }
}

///|
pub fn IceAgent::set_remote_credentials(
  self : IceAgent,
  ufrag : String,
  pwd : String,
) -> Unit {
  self.remote_ufrag = ufrag
  self.remote_pwd = pwd
}

///|
fn ice_sort_pairs_desc(pairs : Array[CandidatePair]) -> Unit {
  let n = pairs.length()
  let mut i = 1
  while i < n {
    let cur = pairs[i]
    let mut j = i - 1
    while j >= 0 && pairs[j].priority < cur.priority {
      pairs[j + 1] = pairs[j]
      j = j - 1
    }
    pairs[j + 1] = cur
    i = i + 1
  }
}

///|
fn ice_has_pair(pairs : Array[CandidatePair], local_idx : Int, remote_idx : Int) -> Bool {
  let mut i = 0
  while i < pairs.length() {
    if pairs[i].local_idx == local_idx && pairs[i].remote_idx == remote_idx {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn ice_form_pairs_for(self : IceAgent, local_idx : Int, remote_idx : Int) -> Unit {
  let lc = self.local_candidates[local_idx]
  let rc = self.remote_candidates[remote_idx]
  if lc.component_id != rc.component_id || !same_addr_family(lc.addr, rc.addr) {
    return
  }
  if ice_has_pair(self.pairs, local_idx, remote_idx) {
    return
  }
  let p = match self.role {
    IceRole::Controlling => compute_pair_priority(lc.priority, rc.priority)
    IceRole::Controlled => compute_pair_priority(rc.priority, lc.priority)
  }
  self.pairs.push(CandidatePair::{
    local_idx: local_idx,
    remote_idx: remote_idx,
    priority: p,
    state: PairState::Waiting,
    nominated: false,
    last_tx_id: Bytes::new(0),
    mapped_addr: None,
  })
  ice_sort_pairs_desc(self.pairs)
}

///|
pub fn IceAgent::add_local_candidate(
  self : IceAgent,
  foundation : String,
  component_id : Int,
  addr : SocketAddr,
  cand_type : CandidateType,
  local_pref : Int,
) -> Result[Int, StunError] {
  let prio = match compute_candidate_priority(candidate_type_pref(cand_type), local_pref, component_id) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let idx = self.local_candidates.length()
  self.local_candidates.push(IceCandidate::{
    foundation: foundation,
    component_id: component_id,
    addr: addr,
    cand_type: cand_type,
    priority: prio,
  })
  let mut r = 0
  while r < self.remote_candidates.length() {
    ice_form_pairs_for(self, idx, r)
    r = r + 1
  }
  Ok(idx)
}

///|
pub fn IceAgent::add_remote_candidate(
  self : IceAgent,
  foundation : String,
  component_id : Int,
  addr : SocketAddr,
  cand_type : CandidateType,
  priority : UInt,
) -> Result[Int, StunError] {
  if component_id < 1 || component_id > 256 {
    return Err(StunError::IceError("component_id must be in 1..256"))
  }
  let idx = self.remote_candidates.length()
  self.remote_candidates.push(IceCandidate::{
    foundation: foundation,
    component_id: component_id,
    addr: addr,
    cand_type: cand_type,
    priority: priority,
  })
  let mut l = 0
  while l < self.local_candidates.length() {
    ice_form_pairs_for(self, l, idx)
    l = l + 1
  }
  Ok(idx)
}

///|
fn ice_next_tx_id(self : IceAgent) -> Bytes {
  let seq = self.tx_counter
  self.tx_counter = seq + 1UL
  let mut tx = Bytes::new(12)
  let tb_hi = ((self.tie_breaker >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  let tb_lo = (self.tie_breaker & 0xFFFFFFFFUL).to_int().to_uint()
  let s_lo = (seq & 0xFFFFFFFFUL).to_int().to_uint()
  write_u32_be(tx, 0, tb_hi)
  write_u32_be(tx, 4, tb_lo)
  write_u32_be(tx, 8, s_lo)
  tx
}

///|
fn ice_build_check_request(
  self : IceAgent,
  pair_idx : Int,
  use_candidate : Bool,
) -> Result[IceCheckPacket, StunError] {
  if self.remote_ufrag.length() == 0 || self.remote_pwd.length() == 0 {
    return Err(StunError::IceError("remote credentials not set"))
  }
  if pair_idx < 0 || pair_idx >= self.pairs.length() {
    return Err(StunError::IceError("pair_idx out of range"))
  }
  let pair = self.pairs[pair_idx]
  let lc = self.local_candidates[pair.local_idx]
  let rc = self.remote_candidates[pair.remote_idx]
  let tx_id = ice_next_tx_id(self)

  let msg = Message::new(MessageClass::Request, MessageMethod::Binding, tx_id)
  msg.add(Attribute::Username(self.remote_ufrag + ":" + self.local_ufrag))
  msg.add(Attribute::Priority(lc.priority))
  match self.role {
    IceRole::Controlling => msg.add(Attribute::IceControlling(self.tie_breaker))
    IceRole::Controlled => msg.add(Attribute::IceControlled(self.tie_breaker))
  }
  if use_candidate {
    msg.add(Attribute::UseCandidate)
  }

  let key = string_to_utf8_bytes(self.remote_pwd)
  let wire = match encode_message_signed(msg, Some(key), false, true) {
    Ok(w) => w
    Err(e) => return Err(e)
  }

  pair.last_tx_id = tx_id
  pair.state = PairState::InProgress
  if use_candidate {
    pair.nominated = true
  }

  Ok(IceCheckPacket::{
    pair_idx: pair_idx,
    local_addr: lc.addr,
    remote_addr: rc.addr,
    wire: wire,
    transaction_id: tx_id,
  })
}

///| Pop the highest-priority Waiting candidate pair and emit its signed STUN Binding Request.
pub fn IceAgent::next_check(self : IceAgent) -> Result[Option[IceCheckPacket], StunError] {
  let mut i = 0
  while i < self.pairs.length() {
    if pair_state_eq(self.pairs[i].state, PairState::Waiting) {
      let use_cand = ice_role_eq(self.role, IceRole::Controlling) && self.aggressive_nomination
      match ice_build_check_request(self, i, use_cand) {
        Ok(pkt) => return Ok(Some(pkt))
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }
  Ok(None)
}

///| Regular nomination (Controlling role): send Binding Request with USE-CANDIDATE for `pair_idx`.
pub fn IceAgent::nominate_pair(
  self : IceAgent,
  pair_idx : Int,
) -> Result[IceCheckPacket, StunError] {
  if !ice_role_eq(self.role, IceRole::Controlling) {
    return Err(StunError::IceError("only Controlling agent may nominate a pair"))
  }
  ice_build_check_request(self, pair_idx, true)
}

///|
pub fn IceAgent::mark_pair_failed(self : IceAgent, pair_idx : Int) -> Result[Unit, StunError] {
  if pair_idx < 0 || pair_idx >= self.pairs.length() {
    return Err(StunError::IceError("pair_idx out of range"))
  }
  self.pairs[pair_idx].state = PairState::Failed
  Ok(())
}

///|
fn ice_handle_binding_request(
  self : IceAgent,
  packet : Bytes,
  msg : Message,
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  let local_key = string_to_utf8_bytes(self.local_pwd)
  match verify_message_integrity(packet, local_key) {
    Ok(true) => ()
    Ok(false) => return Err(StunError::IntegrityMismatch("inbound ICE Binding Request integrity failed"))
    Err(e) => return Err(e)
  }

  let expected_user = self.local_ufrag + ":" + self.remote_ufrag
  let mut saw_user = false
  let mut has_use_candidate = false
  let mut i = 0
  while i < msg.attributes.length() {
    match msg.attributes[i] {
      Attribute::Username(u) => {
        if self.remote_ufrag.length() > 0 && u != expected_user {
          return Err(StunError::IceError("unexpected ICE USERNAME: " + u))
        }
        saw_user = true
      }
      Attribute::UseCandidate => has_use_candidate = true
      _ => ()
    }
    i = i + 1
  }
  if !saw_user {
    return Err(StunError::IceError("inbound ICE Binding Request missing USERNAME"))
  }

  if has_use_candidate && ice_role_eq(self.role, IceRole::Controlled) {
    let mut p = 0
    while p < self.pairs.length() {
      let rc = self.remote_candidates[self.pairs[p].remote_idx]
      if socket_addr_eq(rc.addr, from_addr) {
        self.pairs[p].nominated = true
        self.pairs[p].state = PairState::Succeeded
        self.nominated_pair_idx = Some(p)
        break
      }
      p = p + 1
    }
  }

  let resp = Message::new(MessageClass::SuccessResponse, MessageMethod::Binding, msg.transaction_id)
  resp.add(Attribute::XorMappedAddress(from_addr))
  let wire = match encode_message_signed(resp, Some(local_key), false, true) {
    Ok(w) => w
    Err(e) => return Err(e)
  }
  Ok(IceInboundResult::SendResponse(wire, from_addr))
}

///|
fn ice_handle_binding_response(
  self : IceAgent,
  packet : Bytes,
  msg : Message,
  is_error : Bool,
) -> Result[IceInboundResult, StunError] {
  let remote_key = string_to_utf8_bytes(self.remote_pwd)
  match verify_message_integrity(packet, remote_key) {
    Ok(true) => ()
    Ok(false) => return Err(StunError::IntegrityMismatch("inbound ICE Binding Response integrity failed"))
    Err(e) => return Err(e)
  }

  let mut pair_idx = -1
  let mut p = 0
  while p < self.pairs.length() {
    if ice_bytes_eq(self.pairs[p].last_tx_id, msg.transaction_id) {
      pair_idx = p
      break
    }
    p = p + 1
  }
  if pair_idx < 0 {
    return Ok(IceInboundResult::Ignored("unknown transaction_id"))
  }

  if is_error {
    let mut err_code = 0
    let mut i = 0
    while i < msg.attributes.length() {
      match msg.attributes[i] {
        Attribute::ErrorCode(ec) => {
          err_code = ec.code
          break
        }
        _ => ()
      }
      i = i + 1
    }
    self.pairs[pair_idx].state = PairState::Failed
    return Ok(IceInboundResult::PairFailed(pair_idx, err_code))
  }

  let mut mapped : Option[SocketAddr] = None
  let mut i = 0
  while i < msg.attributes.length() {
    match msg.attributes[i] {
      Attribute::XorMappedAddress(addr) => {
        mapped = Some(addr)
        break
      }
      _ => ()
    }
    i = i + 1
  }
  let pair = self.pairs[pair_idx]
  pair.state = PairState::Succeeded
  pair.mapped_addr = mapped
  if pair.nominated {
    self.nominated_pair_idx = Some(pair_idx)
  }
  Ok(IceInboundResult::PairSucceeded(pair_idx, mapped))
}

///| Process an inbound STUN packet in Sans-IO fashion.
pub fn IceAgent::handle_inbound(
  self : IceAgent,
  packet : Bytes,
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  if !is_stun_packet(packet) {
    return Ok(IceInboundResult::Ignored("not a STUN packet"))
  }
  // If FINGERPRINT is present, it must be valid
  match find_attr_offset(packet, attr_fingerprint) {
    Ok(Some(_)) => {
      match verify_fingerprint(packet) {
        Ok(true) => ()
        Ok(false) => return Err(StunError::FingerprintMismatch("STUN FINGERPRINT mismatch"))
        Err(e) => return Err(e)
      }
    }
    Ok(None) => ()
    Err(e) => return Err(e)
  }

  let msg = match decode_message(packet) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  if !message_method_eq(msg.method, MessageMethod::Binding) {
    return Ok(IceInboundResult::Ignored("non-Binding STUN method"))
  }

  match msg.msg_class {
    MessageClass::Request => ice_handle_binding_request(self, packet, msg, from_addr)
    MessageClass::SuccessResponse => ice_handle_binding_response(self, packet, msg, false)
    MessageClass::ErrorResponse => ice_handle_binding_response(self, packet, msg, true)
    MessageClass::Indication => Ok(IceInboundResult::Ignored("Binding Indication"))
  }
}

///| Return the currently nominated & succeeded candidate pair (if any).
pub fn IceAgent::selected_pair(self : IceAgent) -> Option[CandidatePair] {
  match self.nominated_pair_idx {
    Some(idx) => {
      if idx >= 0 && idx < self.pairs.length() {
        Some(self.pairs[idx])
      } else {
        None
      }
    }
    None => None
  }
}
