///| RFC 8445 ICE candidate priority, pair priority, and Sans-IO IceAgent state machine.

import "crypto"

///|
pub let ice_default_max_candidates : Int = 100

///|
pub let ice_default_max_pairs : Int = 100

///| RFC 8445 §5.3 minimum ice-pwd length (128 bits = 22 base64/ice-char characters)
pub let ice_min_pwd_len : Int = 22

///| RFC 8445 §5.1.2.1:
///| priority = (2^24)*(type_pref) + (2^8)*(local_pref) + (256 - component_id)
pub fn compute_candidate_priority(
  type_pref : Int,
  local_pref : Int,
  component_id : Int,
) -> Result[UInt, StunError] {
  if type_pref < 0 || type_pref > 126 {
    return Err(StunError::IceError("type_pref must be in 0..126"))
  }
  if local_pref < 0 || local_pref > 65535 {
    return Err(StunError::IceError("local_pref must be in 0..65535"))
  }
  if component_id < 1 || component_id > 256 {
    return Err(StunError::IceError("component_id must be in 1..256"))
  }
  let p : UInt = (type_pref.to_uint() << 24U) |
  (local_pref.to_uint() << 8U) |
  (256 - component_id).to_uint()
  Ok(p)
}

///| RFC 8445 §6.1.2.3:
///| pair priority = 2^32 * MIN(G, D) + 2 * MAX(G, D) + (G > D ? 1 : 0)
///| Computed in UInt64 to prevent Int64 overflow; saturates to Int64::MAX for
///| out-of-spec inputs >= 2^31 while remaining exact for all RFC-legal 1..2^31-1 priorities.
pub fn compute_pair_priority(controlling_prio : UInt, controlled_prio : UInt) -> Int64 {
  let g : UInt64 = controlling_prio.to_int64().to_uint64()
  let d : UInt64 = controlled_prio.to_int64().to_uint64()
  let mn = if g < d { g } else { d }
  let mx = if g > d { g } else { d }
  let tie = if g > d { 1UL } else { 0UL }
  if mn >= 0x80000000UL {
    return 0x7FFFFFFFFFFFFFFFL
  }
  let base = mn << 32
  let add = (mx << 1) + tie
  if base > 0x7FFFFFFFFFFFFFFFUL - add {
    0x7FFFFFFFFFFFFFFFL
  } else {
    (base + add).to_int64()
  }
}

///|
fn same_addr_family(a : SocketAddr, b : SocketAddr) -> Bool {
  match (a, b) {
    (SocketAddr::Ipv4(_, _), SocketAddr::Ipv4(_, _)) => true
    (SocketAddr::Ipv6(_, _), SocketAddr::Ipv6(_, _)) => true
    _ => false
  }
}

///|
fn ice_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn ice_starts_with(s : String, p : String) -> Bool {
  if s.length() < p.length() {
    return false
  }
  let mut i = 0
  while i < p.length() {
    if s.code_unit_at(i) != p.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn IceAgent::new(
  role : IceRole,
  tie_breaker : UInt64,
  local_ufrag : String,
  local_pwd : String,
  aggressive_nomination : Bool,
) -> IceAgent {
  IceAgent::{
    role: role,
    tie_breaker: tie_breaker,
    local_ufrag: local_ufrag,
    local_pwd: local_pwd,
    remote_ufrag: "",
    remote_pwd: "",
    aggressive_nomination: aggressive_nomination,
    local_candidates: [],
    remote_candidates: [],
    pairs: [],
    tx_counter: 1UL,
    nominated_pair_idx: None,
    max_candidates: ice_default_max_candidates,
    max_pairs: ice_default_max_pairs,
    tx_seed: Bytes::new(0),
  }
}

///| Configure checklist and candidate caps (RFC 8445 §6.1.2.5 / §14).
pub fn IceAgent::set_limits(
  self : IceAgent,
  max_candidates : Int,
  max_pairs : Int,
) -> Result[Unit, StunError] {
  if max_candidates < 0 || max_pairs < 0 {
    return Err(StunError::InvalidLimits("ICE limits must be >= 0"))
  }
  self.max_candidates = max_candidates
  self.max_pairs = max_pairs
  Ok(())
}

///| Inject caller-provided CSPRNG entropy seed for 96-bit transaction ID derivation (RFC 8489 §6).
pub fn IceAgent::set_tx_seed(self : IceAgent, seed : Bytes) -> Unit {
  self.tx_seed = seed
}

///|
pub fn IceAgent::set_remote_credentials(
  self : IceAgent,
  ufrag : String,
  pwd : String,
) -> Unit {
  self.remote_ufrag = ufrag
  self.remote_pwd = pwd
}

///|
fn ice_recompute_pair_priorities(self : IceAgent) -> Unit {
  let mut i = 0
  while i < self.pairs.length() {
    let p = self.pairs[i]
    let lc = self.local_candidates[p.local_idx]
    let rc = self.remote_candidates[p.remote_idx]
    let new_prio = match self.role {
      IceRole::Controlling => compute_pair_priority(lc.priority, rc.priority)
      IceRole::Controlled => compute_pair_priority(rc.priority, lc.priority)
    }
    self.pairs[i] = CandidatePair::{
      local_idx: p.local_idx,
      remote_idx: p.remote_idx,
      priority: new_prio,
      state: p.state,
      nominated: p.nominated,
      last_tx_id: p.last_tx_id,
      mapped_addr: p.mapped_addr,
    }
    i = i + 1
  }
}

///|
fn ice_switch_role(self : IceAgent) -> Unit {
  self.role = match self.role {
    IceRole::Controlling => IceRole::Controlled
    IceRole::Controlled => IceRole::Controlling
  }
  ice_recompute_pair_priorities(self)
}

///|
fn ice_has_pair(pairs : Array[CandidatePair], local_idx : Int, remote_idx : Int) -> Bool {
  let mut i = 0
  while i < pairs.length() {
    if pairs[i].local_idx == local_idx && pairs[i].remote_idx == remote_idx {
      return true
    }
    i = i + 1
  }
  false
}

///| Append-only pair formation: never reorders `self.pairs` so pair indices stay permanently stable
///| across trickle-ICE additions and role switches (P1-4), and strictly enforces `max_pairs` (P1-5).
fn ice_form_pairs_for(self : IceAgent, local_idx : Int, remote_idx : Int) -> Unit {
  if self.pairs.length() >= self.max_pairs {
    return
  }
  let lc = self.local_candidates[local_idx]
  let rc = self.remote_candidates[remote_idx]
  if lc.component_id != rc.component_id || !same_addr_family(lc.addr, rc.addr) {
    return
  }
  if ice_has_pair(self.pairs, local_idx, remote_idx) {
    return
  }
  let p = match self.role {
    IceRole::Controlling => compute_pair_priority(lc.priority, rc.priority)
    IceRole::Controlled => compute_pair_priority(rc.priority, lc.priority)
  }
  self.pairs.push(CandidatePair::{
    local_idx: local_idx,
    remote_idx: remote_idx,
    priority: p,
    state: PairState::Waiting,
    nominated: false,
    last_tx_id: Bytes::new(0),
    mapped_addr: None,
  })
}

///|
pub fn IceAgent::add_local_candidate(
  self : IceAgent,
  foundation : String,
  component_id : Int,
  addr : SocketAddr,
  cand_type : CandidateType,
  local_pref : Int,
) -> Result[Int, StunError] {
  if self.local_candidates.length() >= self.max_candidates {
    return Err(StunError::LimitExceeded("local candidate limit exceeded"))
  }
  let prio = match compute_candidate_priority(candidate_type_pref(cand_type), local_pref, component_id) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let idx = self.local_candidates.length()
  self.local_candidates.push(IceCandidate::{
    foundation: foundation,
    component_id: component_id,
    addr: addr,
    cand_type: cand_type,
    priority: prio,
  })
  let mut r = 0
  while r < self.remote_candidates.length() && self.pairs.length() < self.max_pairs {
    ice_form_pairs_for(self, idx, r)
    r = r + 1
  }
  Ok(idx)
}

///|
pub fn IceAgent::add_remote_candidate(
  self : IceAgent,
  foundation : String,
  component_id : Int,
  addr : SocketAddr,
  cand_type : CandidateType,
  priority : UInt,
) -> Result[Int, StunError] {
  if component_id < 1 || component_id > 256 {
    return Err(StunError::IceError("component_id must be in 1..256"))
  }
  // RFC 8445 §5.1.2: candidate priority MUST be in 1..2^31-1 (P2-6)
  if priority == 0U || priority > 0x7FFFFFFFU {
    return Err(StunError::IceError("remote candidate priority must be in 1..2^31-1"))
  }
  if self.remote_candidates.length() >= self.max_candidates {
    return Err(StunError::LimitExceeded("remote candidate limit exceeded"))
  }
  let idx = self.remote_candidates.length()
  self.remote_candidates.push(IceCandidate::{
    foundation: foundation,
    component_id: component_id,
    addr: addr,
    cand_type: cand_type,
    priority: priority,
  })
  let mut l = 0
  while l < self.local_candidates.length() && self.pairs.length() < self.max_pairs {
    ice_form_pairs_for(self, l, idx)
    l = l + 1
  }
  Ok(idx)
}

///| Derive a non-predictable 96-bit transaction ID by SHA-256 hashing secret local credentials,
///| optional caller CSPRNG seed, tie-breaker, and monotonic 64-bit counter (P2-5).
fn ice_next_tx_id(self : IceAgent) -> Bytes {
  let seq = self.tx_counter
  self.tx_counter = seq + 1UL
  let h = crypto::Sha256::new()
  h.update(string_to_utf8_bytes("pion-stun-txid-v1:"))
  h.update(string_to_utf8_bytes(self.local_ufrag))
  h.update(string_to_utf8_bytes(":"))
  h.update(string_to_utf8_bytes(self.local_pwd))
  if self.tx_seed.length() > 0 {
    h.update(self.tx_seed)
  }
  let ctr = Bytes::new(16)
  write_u64_be(ctr, 0, self.tie_breaker)
  write_u64_be(ctr, 8, seq)
  h.update(ctr)
  let digest = h.finalize()
  slice_bytes(digest, 0, 12)
}

///|
fn ice_build_check_request(
  self : IceAgent,
  pair_idx : Int,
  use_candidate : Bool,
  tx_id_override : Option[Bytes],
) -> Result[IceCheckPacket, StunError] {
  if self.local_ufrag.length() == 0 || self.local_pwd.length() < ice_min_pwd_len {
    return Err(StunError::IceError("invalid local ICE credentials (ice-pwd must be >= 22 chars)"))
  }
  if self.remote_ufrag.length() == 0 || self.remote_pwd.length() < ice_min_pwd_len {
    return Err(StunError::IceError("invalid remote ICE credentials (ice-pwd must be >= 22 chars)"))
  }
  if pair_idx < 0 || pair_idx >= self.pairs.length() {
    return Err(StunError::IceError("pair_idx out of range"))
  }
  let tx_id = match tx_id_override {
    Some(t) => {
      if t.length() != 12 {
        return Err(StunError::InvalidInput("transaction_id must be 12 bytes"))
      }
      t
    }
    None => ice_next_tx_id(self)
  }
  let pair = self.pairs[pair_idx]
  let lc = self.local_candidates[pair.local_idx]
  let rc = self.remote_candidates[pair.remote_idx]

  let msg = Message::new(MessageClass::Request, MessageMethod::Binding, tx_id)
  msg.add(Attribute::Username(self.remote_ufrag + ":" + self.local_ufrag))
  msg.add(Attribute::Priority(lc.priority))
  match self.role {
    IceRole::Controlling => msg.add(Attribute::IceControlling(self.tie_breaker))
    IceRole::Controlled => msg.add(Attribute::IceControlled(self.tie_breaker))
  }
  if use_candidate {
    msg.add(Attribute::UseCandidate)
  }

  let key = string_to_utf8_bytes(self.remote_pwd)
  let wire = match encode_message_signed(msg, Some(key), false, true) {
    Ok(w) => w
    Err(e) => return Err(e)
  }

  pair.last_tx_id = tx_id
  pair.state = PairState::InProgress
  if use_candidate {
    pair.nominated = true
  }

  Ok(IceCheckPacket::{
    pair_idx: pair_idx,
    local_addr: lc.addr,
    remote_addr: rc.addr,
    wire: wire,
    transaction_id: tx_id,
  })
}

///| Select the highest-priority Waiting candidate pair and emit its signed STUN Binding Request.
pub fn IceAgent::next_check(self : IceAgent) -> Result[Option[IceCheckPacket], StunError] {
  let mut best_idx = -1
  let mut best_prio = -1L
  let mut i = 0
  while i < self.pairs.length() {
    if pair_state_eq(self.pairs[i].state, PairState::Waiting) {
      if best_idx < 0 || self.pairs[i].priority > best_prio {
        best_idx = i
        best_prio = self.pairs[i].priority
      }
    }
    i = i + 1
  }
  if best_idx < 0 {
    return Ok(None)
  }
  let use_cand = ice_role_eq(self.role, IceRole::Controlling) && self.aggressive_nomination
  match ice_build_check_request(self, best_idx, use_cand, None) {
    Ok(pkt) => Ok(Some(pkt))
    Err(e) => Err(e)
  }
}

///| Same as `next_check` but uses caller-supplied 96-bit CSPRNG `tx_id` (RFC 8489 §6).
pub fn IceAgent::next_check_with_tx_id(
  self : IceAgent,
  tx_id : Bytes,
) -> Result[Option[IceCheckPacket], StunError] {
  let mut best_idx = -1
  let mut best_prio = -1L
  let mut i = 0
  while i < self.pairs.length() {
    if pair_state_eq(self.pairs[i].state, PairState::Waiting) {
      if best_idx < 0 || self.pairs[i].priority > best_prio {
        best_idx = i
        best_prio = self.pairs[i].priority
      }
    }
    i = i + 1
  }
  if best_idx < 0 {
    return Ok(None)
  }
  let use_cand = ice_role_eq(self.role, IceRole::Controlling) && self.aggressive_nomination
  match ice_build_check_request(self, best_idx, use_cand, Some(tx_id)) {
    Ok(pkt) => Ok(Some(pkt))
    Err(e) => Err(e)
  }
}

///| Regular nomination (Controlling role): send Binding Request with USE-CANDIDATE for `pair_idx`.
pub fn IceAgent::nominate_pair(
  self : IceAgent,
  pair_idx : Int,
) -> Result[IceCheckPacket, StunError] {
  if !ice_role_eq(self.role, IceRole::Controlling) {
    return Err(StunError::IceError("only Controlling agent may nominate a pair"))
  }
  ice_build_check_request(self, pair_idx, true, None)
}

///|
pub fn IceAgent::mark_pair_failed(self : IceAgent, pair_idx : Int) -> Result[Unit, StunError] {
  if pair_idx < 0 || pair_idx >= self.pairs.length() {
    return Err(StunError::IceError("pair_idx out of range"))
  }
  self.pairs[pair_idx].state = PairState::Failed
  Ok(())
}

///|
fn ice_send_error_response(
  tx_id : Bytes,
  code : Int,
  reason : String,
  unknown_attrs : Option[Array[Int]],
  local_key : Bytes,
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  let resp = Message::new(MessageClass::ErrorResponse, MessageMethod::Binding, tx_id)
  resp.add(Attribute::ErrorCode(ErrorCode::new(code, reason)))
  match unknown_attrs {
    Some(list) => resp.add(Attribute::UnknownAttributes(list))
    None => ()
  }
  match encode_message_signed(resp, Some(local_key), false, true) {
    Ok(w) => Ok(IceInboundResult::SendResponse(w, from_addr))
    Err(e) => Err(e)
  }
}

///|
fn ice_find_or_add_pair_for_inbound(
  self : IceAgent,
  local_addr : Option[SocketAddr],
  from_addr : SocketAddr,
  peer_priority : UInt,
) -> Option[Int] {
  match local_addr {
    None => None
    Some(laddr) => {
      let mut p = 0
      while p < self.pairs.length() {
        let lc = self.local_candidates[self.pairs[p].local_idx]
        let rc = self.remote_candidates[self.pairs[p].remote_idx]
        if socket_addr_eq(lc.addr, laddr) && socket_addr_eq(rc.addr, from_addr) {
          return Some(p)
        }
        p = p + 1
      }
      // RFC 8445 §7.3.1.3: discover Peer-Reflexive remote candidate if unknown
      let mut lidx = -1
      let mut l = 0
      while l < self.local_candidates.length() {
        if socket_addr_eq(self.local_candidates[l].addr, laddr) {
          lidx = l
          break
        }
        l = l + 1
      }
      if lidx < 0 {
        return None
      }
      let comp = self.local_candidates[lidx].component_id
      let ridx = match self.add_remote_candidate("prflx", comp, from_addr, CandidateType::PeerReflexive, peer_priority) {
        Ok(i) => i
        Err(_) => return None
      }
      let mut q = 0
      while q < self.pairs.length() {
        if self.pairs[q].local_idx == lidx && self.pairs[q].remote_idx == ridx {
          return Some(q)
        }
        q = q + 1
      }
      None
    }
  }
}

///|
fn ice_handle_binding_request(
  self : IceAgent,
  packet : Bytes,
  msg : Message,
  local_addr : Option[SocketAddr],
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  // P2-7: reject empty or short local ice-pwd (RFC 8445 §5.3)
  if self.local_ufrag.length() == 0 || self.local_pwd.length() < ice_min_pwd_len {
    return Err(StunError::IceError("invalid local ICE credentials (ice-pwd must be >= 22 chars)"))
  }
  let local_key = string_to_utf8_bytes(self.local_pwd)
  match verify_message_integrity(packet, local_key) {
    Ok(true) => ()
    Ok(false) => return Err(StunError::IntegrityMismatch("inbound ICE Binding Request integrity failed"))
    Err(e) => return Err(e)
  }

  let prefix = self.local_ufrag + ":"
  let expected_user = prefix + self.remote_ufrag
  let mut saw_user = false
  let mut has_use_candidate = false
  let mut peer_priority : Option[UInt] = None
  let mut peer_controlling : Option[UInt64] = None
  let mut peer_controlled : Option[UInt64] = None
  let unknown_req : Array[Int] = []

  let mut i = 0
  while i < msg.attributes.length() {
    match msg.attributes[i] {
      Attribute::Username(u) => {
        // P2-8: always verify local_ufrag + ":" prefix even before remote_ufrag is known
        if self.remote_ufrag.length() > 0 {
          if u != expected_user {
            return Err(StunError::IceError("unexpected ICE USERNAME: " + u))
          }
        } else {
          if !ice_starts_with(u, prefix) || u.length() <= prefix.length() {
            return Err(StunError::IceError("ICE USERNAME missing local_ufrag prefix: " + u))
          }
        }
        saw_user = true
      }
      Attribute::Priority(p) => peer_priority = Some(p)
      Attribute::IceControlling(tb) => peer_controlling = Some(tb)
      Attribute::IceControlled(tb) => peer_controlled = Some(tb)
      Attribute::UseCandidate => has_use_candidate = true
      Attribute::Unknown(t, _) => {
        // P2-2: comprehension-required unknown attributes (< 0x8000)
        if t < 0x8000 {
          unknown_req.push(t)
        }
      }
      _ => ()
    }
    i = i + 1
  }
  if !saw_user {
    return Err(StunError::IceError("inbound ICE Binding Request missing USERNAME"))
  }

  // P2-2: RFC 8489 §6.3.1 -> 420 Unknown Attribute + UNKNOWN-ATTRIBUTES
  if unknown_req.length() > 0 {
    return ice_send_error_response(
      msg.transaction_id,
      420,
      "Unknown Attribute",
      Some(unknown_req),
      local_key,
      from_addr,
    )
  }

  // P2-1: RFC 8445 §7.1.1-7.1.3 / §7.3 -> PRIORITY and exactly one role attr required -> 400
  let prio_val = match peer_priority {
    Some(p) => p
    None => {
      return ice_send_error_response(
        msg.transaction_id,
        400,
        "Bad Request",
        None,
        local_key,
        from_addr,
      )
    }
  }
  let has_ctl = match peer_controlling {
    Some(_) => true
    None => false
  }
  let has_ced = match peer_controlled {
    Some(_) => true
    None => false
  }
  if (has_ctl && has_ced) || (!has_ctl && !has_ced) {
    return ice_send_error_response(
      msg.transaction_id,
      400,
      "Bad Request",
      None,
      local_key,
      from_addr,
    )
  }

  // P1-2: RFC 8445 §7.3.1.1 Role Conflict resolution (64-bit unsigned tie-breaker)
  match (self.role, peer_controlling, peer_controlled) {
    (IceRole::Controlling, Some(peer_tb), _) => {
      if self.tie_breaker >= peer_tb {
        return ice_send_error_response(
          msg.transaction_id,
          487,
          "Role Conflict",
          None,
          local_key,
          from_addr,
        )
      } else {
        ice_switch_role(self)
      }
    }
    (IceRole::Controlled, _, Some(peer_tb)) => {
      if self.tie_breaker >= peer_tb {
        ice_switch_role(self)
      } else {
        return ice_send_error_response(
          msg.transaction_id,
          487,
          "Role Conflict",
          None,
          local_key,
          from_addr,
        )
      }
    }
    _ => ()
  }

  // P1-3: RFC 8445 §7.3.1.4 / §7.3.1.5 Controlled nomination & triggered check:
  // Match by (local_addr, remote_addr); NEVER mark Succeeded without our own check!
  if has_use_candidate && ice_role_eq(self.role, IceRole::Controlled) {
    match ice_find_or_add_pair_for_inbound(self, local_addr, from_addr, prio_val) {
      Some(pidx) => {
        self.pairs[pidx].nominated = true
        if pair_state_eq(self.pairs[pidx].state, PairState::Succeeded) {
          self.nominated_pair_idx = Some(pidx)
        } else if pair_state_eq(self.pairs[pidx].state, PairState::Frozen) {
          self.pairs[pidx].state = PairState::Waiting
        }
      }
      None => ()
    }
  }

  let resp = Message::new(MessageClass::SuccessResponse, MessageMethod::Binding, msg.transaction_id)
  resp.add(Attribute::XorMappedAddress(from_addr))
  let wire = match encode_message_signed(resp, Some(local_key), false, true) {
    Ok(w) => w
    Err(e) => return Err(e)
  }
  Ok(IceInboundResult::SendResponse(wire, from_addr))
}

///|
fn ice_handle_binding_response(
  self : IceAgent,
  packet : Bytes,
  msg : Message,
  from_addr : SocketAddr,
  is_error : Bool,
) -> Result[IceInboundResult, StunError] {
  if self.remote_pwd.length() < ice_min_pwd_len {
    return Err(StunError::IceError("invalid remote ICE credentials"))
  }
  let remote_key = string_to_utf8_bytes(self.remote_pwd)
  match verify_message_integrity(packet, remote_key) {
    Ok(true) => ()
    Ok(false) => return Err(StunError::IntegrityMismatch("inbound ICE Binding Response integrity failed"))
    Err(e) => return Err(e)
  }

  let mut pair_idx = -1
  let mut p = 0
  while p < self.pairs.length() {
    if self.pairs[p].last_tx_id.length() == 12 &&
    ice_bytes_eq(self.pairs[p].last_tx_id, msg.transaction_id) {
      pair_idx = p
      break
    }
    p = p + 1
  }
  if pair_idx < 0 {
    return Ok(IceInboundResult::Ignored("unknown transaction_id"))
  }

  // P2-3: RFC 8445 §7.2.5.2.1 symmetric source address check
  let expected_remote = self.remote_candidates[self.pairs[pair_idx].remote_idx].addr
  if !socket_addr_eq(from_addr, expected_remote) {
    self.pairs[pair_idx].state = PairState::Failed
    return Ok(IceInboundResult::PairFailed(pair_idx, 0))
  }

  // P2-2: fail transaction if response carries unknown comprehension-required attribute
  let mut u = 0
  while u < msg.attributes.length() {
    match msg.attributes[u] {
      Attribute::Unknown(t, _) => {
        if t < 0x8000 {
          self.pairs[pair_idx].state = PairState::Failed
          return Ok(IceInboundResult::PairFailed(pair_idx, 420))
        }
      }
      _ => ()
    }
    u = u + 1
  }

  if is_error {
    let mut err_code = 0
    let mut i = 0
    while i < msg.attributes.length() {
      match msg.attributes[i] {
        Attribute::ErrorCode(ec) => {
          err_code = ec.code
          break
        }
        _ => ()
      }
      i = i + 1
    }
    // P1-2: RFC 8445 §7.2.5.1 on 487 Role Conflict, switch role and re-queue pair
    if err_code == 487 {
      ice_switch_role(self)
      self.pairs[pair_idx].state = PairState::Waiting
      self.pairs[pair_idx].last_tx_id = Bytes::new(0)
      return Ok(IceInboundResult::Ignored("role conflict 487: switched role and requeued"))
    }
    self.pairs[pair_idx].state = PairState::Failed
    return Ok(IceInboundResult::PairFailed(pair_idx, err_code))
  }

  let mut mapped : Option[SocketAddr] = None
  let mut i = 0
  while i < msg.attributes.length() {
    match msg.attributes[i] {
      Attribute::XorMappedAddress(addr) => {
        mapped = Some(addr)
        break
      }
      _ => ()
    }
    i = i + 1
  }
  let pair = self.pairs[pair_idx]
  pair.state = PairState::Succeeded
  pair.mapped_addr = mapped
  if pair.nominated {
    self.nominated_pair_idx = Some(pair_idx)
  }
  Ok(IceInboundResult::PairSucceeded(pair_idx, mapped))
}

///|
fn ice_process_inbound(
  self : IceAgent,
  packet : Bytes,
  local_addr : Option[SocketAddr],
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  if !is_stun_packet(packet) {
    return Ok(IceInboundResult::Ignored("not a STUN packet"))
  }
  // P2-4: RFC 8445 §7.2.2 ICE checks & responses MUST carry a valid FINGERPRINT
  match find_attr_offset(packet, attr_fingerprint) {
    Ok(Some(_)) => {
      match verify_fingerprint(packet) {
        Ok(true) => ()
        Ok(false) => return Err(StunError::FingerprintMismatch("STUN FINGERPRINT mismatch"))
        Err(e) => return Err(e)
      }
    }
    Ok(None) => return Err(StunError::FingerprintMismatch("missing required STUN FINGERPRINT"))
    Err(e) => return Err(e)
  }

  let msg = match decode_message(packet) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  if !message_method_eq(msg.method, MessageMethod::Binding) {
    return Ok(IceInboundResult::Ignored("non-Binding STUN method"))
  }

  match msg.msg_class {
    MessageClass::Request => ice_handle_binding_request(self, packet, msg, local_addr, from_addr)
    MessageClass::SuccessResponse => ice_handle_binding_response(self, packet, msg, from_addr, false)
    MessageClass::ErrorResponse => ice_handle_binding_response(self, packet, msg, from_addr, true)
    MessageClass::Indication => Ok(IceInboundResult::Ignored("Binding Indication"))
  }
}

///| Process an inbound STUN packet received on a specific `local_addr` socket (RFC 8445 §7.3.1.4).
pub fn IceAgent::handle_inbound_on(
  self : IceAgent,
  packet : Bytes,
  local_addr : SocketAddr,
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  ice_process_inbound(self, packet, Some(local_addr), from_addr)
}

///| Process an inbound STUN packet in Sans-IO fashion.
///| When the agent has a single local candidate, it is used as the receiving local address;
///| multi-homed agents should call `handle_inbound_on(packet, local_addr, from_addr)`.
pub fn IceAgent::handle_inbound(
  self : IceAgent,
  packet : Bytes,
  from_addr : SocketAddr,
) -> Result[IceInboundResult, StunError] {
  let laddr = if self.local_candidates.length() == 1 {
    Some(self.local_candidates[0].addr)
  } else {
    None
  }
  ice_process_inbound(self, packet, laddr, from_addr)
}

///| Return the currently nominated & succeeded candidate pair (if any).
pub fn IceAgent::selected_pair(self : IceAgent) -> Option[CandidatePair] {
  match self.nominated_pair_idx {
    Some(idx) => {
      if idx >= 0 && idx < self.pairs.length() {
        Some(self.pairs[idx])
      } else {
        None
      }
    }
    None => None
  }
}
