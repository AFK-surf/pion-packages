///| RFC 8489 STUN wire codec, integrity/fingerprint signing & verification,
///| and RFC 7983 demultiplexing helper.

///|
fn read_u16_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

///|
fn read_u32_be(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24U) |
  (b[off + 1].to_int().to_uint() << 16U) |
  (b[off + 2].to_int().to_uint() << 8U) |
  b[off + 3].to_int().to_uint()
}

///|
fn read_u64_be(b : Bytes, off : Int) -> UInt64 {
  let hi : UInt64 = read_u32_be(b, off).to_int64().to_uint64()
  let lo : UInt64 = read_u32_be(b, off + 4).to_int64().to_uint64()
  (hi << 32) | lo
}

///|
fn slice_bytes(b : Bytes, start : Int, len : Int) -> Bytes {
  b.slice(start, start + len)
}

///| Strict RFC 3629 UTF-8 validation over `b[start .. start + len]` with 4-byte ASCII fast path.
fn is_valid_utf8(b : Bytes, start : Int, len : Int) -> Bool {
  let mut i = start
  let end = start + len
  while i + 4 <= end {
    if ((b[i].to_int() | b[i + 1].to_int() | b[i + 2].to_int() | b[i + 3].to_int()) & 0x80) != 0 {
      break
    }
    i = i + 4
  }
  while i < end {
    let b0 = b[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = b[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = b[i + 1].to_int()
      let b2 = b[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = b[i + 1].to_int()
      let b2 = b[i + 2].to_int()
      let b3 = b[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 >= 0x90 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
fn slice_utf8_string_checked(b : Bytes, start : Int, len : Int) -> Result[String, StunError] {
  if !is_valid_utf8(b, start, len) {
    return Err(StunError::InvalidAttribute("attribute contains invalid UTF-8"))
  }
  Ok(b.slice(start, start + len).to_string())
}

///|
fn align4(n : Int) -> Int {
  (n + 3) & -4
}

///| RFC 7983 §7 demultiplexing: fast check distinguishing STUN packets from
///| DTLS (20..63), TURN Channel (64..79), and RTP/RTCP (128..191).
pub fn is_stun_packet(data : Bytes) -> Bool {
  let n = data.length()
  if n < stun_header_size {
    return false
  }
  let b0 = data[0].to_int()
  if b0 > 3 {
    return false
  }
  if read_u32_be(data, 4) != stun_magic_cookie {
    return false
  }
  let msg_len = read_u16_be(data, 2)
  (msg_len & 3) == 0 && stun_header_size + msg_len == n
}

///| RFC 8489 §5: encode MessageClass + 12-bit MessageMethod into 14-bit STUN Message Type.
pub fn encode_message_type(
  msg_class : MessageClass,
  method : MessageMethod,
) -> Result[Int, StunError] {
  let m = message_method_to_code(method)
  if m < 0 || m > 0xFFF {
    return Err(StunError::InvalidHeader("method out of 12-bit range"))
  }
  let c = match msg_class {
    MessageClass::Request => 0
    MessageClass::Indication => 1
    MessageClass::SuccessResponse => 2
    MessageClass::ErrorResponse => 3
  }
  let c0 = c & 1
  let c1 = (c >> 1) & 1
  let raw = ((m & 0x0F80) << 2) | (c1 << 8) | ((m & 0x0070) << 1) | (c0 << 4) | (m & 0x000F)
  Ok(raw)
}

///| RFC 8489 §5: decode 16-bit STUN Message Type (top 2 bits must be 00).
pub fn decode_message_type(raw_type : Int) -> Result[(MessageClass, MessageMethod), StunError] {
  if (raw_type & 0xC000) != 0 {
    return Err(StunError::InvalidHeader("top 2 bits of STUN message type must be 00"))
  }
  let c0 = (raw_type >> 4) & 1
  let c1 = (raw_type >> 8) & 1
  let c = (c1 << 1) | c0
  let msg_class = if c == 0 {
    MessageClass::Request
  } else if c == 1 {
    MessageClass::Indication
  } else if c == 2 {
    MessageClass::SuccessResponse
  } else {
    MessageClass::ErrorResponse
  }
  let m = (raw_type & 0x000F) | ((raw_type >> 1) & 0x0070) | ((raw_type >> 2) & 0x0F80)
  Ok((msg_class, message_method_from_code(m)))
}

///|
fn decode_socket_addr(
  data : Bytes,
  off : Int,
  len : Int,
  tx_id : Bytes,
  is_xor : Bool,
) -> Result[SocketAddr, StunError] {
  if len < 4 {
    return Err(StunError::InvalidAttribute("address attribute too short"))
  }
  let family = data[off + 1].to_int()
  let raw_port = read_u16_be(data, off + 2)
  let port = if is_xor { raw_port ^ 0x2112 } else { raw_port }
  if family == 0x01 {
    if len != 8 {
      return Err(StunError::InvalidAttribute("IPv4 address attribute must be 8 bytes"))
    }
    let raw_ip = read_u32_be(data, off + 4)
    let ip = if is_xor { raw_ip ^ stun_magic_cookie } else { raw_ip }
    Ok(SocketAddr::Ipv4(ip, port))
  } else if family == 0x02 {
    if len != 20 {
      return Err(StunError::InvalidAttribute("IPv6 address attribute must be 20 bytes"))
    }
    if !is_xor {
      return Ok(SocketAddr::Ipv6(data.slice(off + 4, off + 20), port))
    }
    let mut ip6 = Bytes::new(16)
    ip6[0] = (data[off + 4].to_int() ^ 0x21).to_byte()
    ip6[1] = (data[off + 5].to_int() ^ 0x12).to_byte()
    ip6[2] = (data[off + 6].to_int() ^ 0xA4).to_byte()
    ip6[3] = (data[off + 7].to_int() ^ 0x42).to_byte()
    let mut i = 0
    while i < 12 {
      ip6[4 + i] = (data[off + 8 + i].to_int() ^ tx_id[i].to_int()).to_byte()
      i = i + 1
    }
    Ok(SocketAddr::Ipv6(ip6, port))
  } else {
    Err(StunError::InvalidAttribute("unsupported address family: " + family.to_string()))
  }
}

///|
pub fn decode_message(data : Bytes) -> Result[Message, StunError] {
  decode_message_with_limits(data, DecodeLimits::default())
}

///|
pub fn decode_message_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Message, StunError] {
  if limits.max_message_bytes < 0 {
    return Err(StunError::InvalidLimits("max_message_bytes must be >= 0"))
  }
  if limits.max_attributes < 0 {
    return Err(StunError::InvalidLimits("max_attributes must be >= 0"))
  }
  if limits.max_attribute_bytes < 0 {
    return Err(StunError::InvalidLimits("max_attribute_bytes must be >= 0"))
  }
  let n = data.length()
  if n > limits.max_message_bytes {
    return Err(
      StunError::LimitExceeded(
        "message size " + n.to_string() + " exceeds max_message_bytes",
      ),
    )
  }
  if n < stun_header_size {
    return Err(StunError::PacketTooShort("STUN header requires at least 20 bytes"))
  }

  let raw_type = read_u16_be(data, 0)
  if (raw_type & 0xC000) != 0 {
    return Err(StunError::InvalidHeader("top 2 bits of STUN message type must be 00"))
  }
  let c0 = (raw_type >> 4) & 1
  let c1 = (raw_type >> 8) & 1
  let c = (c1 << 1) | c0
  let msg_class = if c == 0 {
    MessageClass::Request
  } else if c == 1 {
    MessageClass::Indication
  } else if c == 2 {
    MessageClass::SuccessResponse
  } else {
    MessageClass::ErrorResponse
  }
  let m = (raw_type & 0x000F) | ((raw_type >> 1) & 0x0070) | ((raw_type >> 2) & 0x0F80)
  let method = message_method_from_code(m)

  let msg_len = read_u16_be(data, 2)
  if (msg_len & 3) != 0 {
    return Err(StunError::InvalidHeader("STUN message length must be a multiple of 4"))
  }

  let cookie = (data[4].to_int().to_uint() << 24U) |
  (data[5].to_int().to_uint() << 16U) |
  (data[6].to_int().to_uint() << 8U) |
  data[7].to_int().to_uint()
  if cookie != stun_magic_cookie {
    return Err(StunError::InvalidMagicCookie(cookie))
  }

  if stun_header_size + msg_len != n {
    return Err(
      StunError::LengthMismatch(
        "header length " + msg_len.to_string() + " does not match packet size " + n.to_string(),
      ),
    )
  }

  let tx_id = data.slice(8, 20)
  let attrs : Array[Attribute] = []
  let mut attr_count = 0
  let mut seen_mi = false
  let mut seen_mi256 = false
  let mut pos = stun_header_size
  let end = n

  while pos < end {
    if pos + 4 > end {
      return Err(StunError::TruncatedAttribute("attribute header truncated"))
    }
    if attr_count >= limits.max_attributes {
      return Err(StunError::LimitExceeded("attribute count exceeds max_attributes"))
    }
    let atype = read_u16_be(data, pos)
    let alen = read_u16_be(data, pos + 2)
    let val_off = pos + 4
    let padded_len = align4(alen)
    if val_off + alen > end || val_off + padded_len > end {
      return Err(StunError::TruncatedAttribute("attribute value exceeds message boundary"))
    }
    if alen > limits.max_attribute_bytes {
      return Err(StunError::LimitExceeded("attribute value exceeds max_attribute_bytes"))
    }
    attr_count = attr_count + 1

    // RFC 8489 §14.5 / §14.6: ignore all attributes after MESSAGE-INTEGRITY
    // except MESSAGE-INTEGRITY-SHA256 and FINGERPRINT; after MI-SHA256 only FINGERPRINT.
    if seen_mi256 && atype != attr_fingerprint {
      pos = val_off + padded_len
      continue
    }
    if seen_mi && atype != attr_message_integrity_sha256 && atype != attr_fingerprint {
      pos = val_off + padded_len
      continue
    }

    let attr = if atype == attr_xor_mapped_address {
      if alen == 8 && data[val_off + 1].to_int() == 0x01 {
        let port = ((data[val_off + 2].to_int() << 8) | data[val_off + 3].to_int()) ^ 0x2112
        let raw_ip = (data[val_off + 4].to_int().to_uint() << 24U) |
        (data[val_off + 5].to_int().to_uint() << 16U) |
        (data[val_off + 6].to_int().to_uint() << 8U) |
        data[val_off + 7].to_int().to_uint()
        Attribute::XorMappedAddress(SocketAddr::Ipv4(raw_ip ^ stun_magic_cookie, port))
      } else {
        match decode_socket_addr(data, val_off, alen, tx_id, true) {
          Ok(addr) => Attribute::XorMappedAddress(addr)
          Err(e) => return Err(e)
        }
      }
    } else if atype == attr_message_integrity {
      if alen != 20 {
        return Err(StunError::InvalidAttribute("MESSAGE-INTEGRITY must be 20 bytes"))
      }
      seen_mi = true
      Attribute::MessageIntegrity(data.slice(val_off, val_off + 20))
    } else if atype == attr_fingerprint {
      if alen != 4 {
        return Err(StunError::InvalidAttribute("FINGERPRINT must be 4 bytes"))
      }
      let fp = (data[val_off].to_int().to_uint() << 24U) |
      (data[val_off + 1].to_int().to_uint() << 16U) |
      (data[val_off + 2].to_int().to_uint() << 8U) |
      data[val_off + 3].to_int().to_uint()
      Attribute::Fingerprint(fp)
    } else if atype == attr_username {
      if alen > 512 {
        return Err(StunError::InvalidAttribute("USERNAME exceeds 512 bytes"))
      }
      match slice_utf8_string_checked(data, val_off, alen) {
        Ok(s) => Attribute::Username(s)
        Err(e) => return Err(e)
      }
    } else if atype == attr_priority {
      if alen != 4 {
        return Err(StunError::InvalidAttribute("PRIORITY must be 4 bytes"))
      }
      let prio = (data[val_off].to_int().to_uint() << 24U) |
      (data[val_off + 1].to_int().to_uint() << 16U) |
      (data[val_off + 2].to_int().to_uint() << 8U) |
      data[val_off + 3].to_int().to_uint()
      Attribute::Priority(prio)
    } else if atype == attr_ice_controlling {
      if alen != 8 {
        return Err(StunError::InvalidAttribute("ICE-CONTROLLING must be 8 bytes"))
      }
      let hi : UInt64 = ((data[val_off].to_int().to_uint() << 24U) |
        (data[val_off + 1].to_int().to_uint() << 16U) |
        (data[val_off + 2].to_int().to_uint() << 8U) |
        data[val_off + 3].to_int().to_uint()).to_int64().to_uint64()
      let lo : UInt64 = ((data[val_off + 4].to_int().to_uint() << 24U) |
        (data[val_off + 5].to_int().to_uint() << 16U) |
        (data[val_off + 6].to_int().to_uint() << 8U) |
        data[val_off + 7].to_int().to_uint()).to_int64().to_uint64()
      Attribute::IceControlling((hi << 32) | lo)
    } else if atype == attr_use_candidate {
      if alen != 0 {
        return Err(StunError::InvalidAttribute("USE-CANDIDATE must be 0 bytes"))
      }
      Attribute::UseCandidate
    } else if atype == attr_ice_controlled {
      if alen != 8 {
        return Err(StunError::InvalidAttribute("ICE-CONTROLLED must be 8 bytes"))
      }
      Attribute::IceControlled(read_u64_be(data, val_off))
    } else if atype == attr_mapped_address {
      match decode_socket_addr(data, val_off, alen, tx_id, false) {
        Ok(addr) => Attribute::MappedAddress(addr)
        Err(e) => return Err(e)
      }
    } else if atype == attr_realm {
      if alen > 763 {
        return Err(StunError::InvalidAttribute("REALM exceeds 763 bytes"))
      }
      match slice_utf8_string_checked(data, val_off, alen) {
        Ok(s) => Attribute::Realm(s)
        Err(e) => return Err(e)
      }
    } else if atype == attr_nonce {
      if alen > 763 {
        return Err(StunError::InvalidAttribute("NONCE exceeds 763 bytes"))
      }
      match slice_utf8_string_checked(data, val_off, alen) {
        Ok(s) => Attribute::Nonce(s)
        Err(e) => return Err(e)
      }
    } else if atype == attr_software {
      match slice_utf8_string_checked(data, val_off, alen) {
        Ok(s) => Attribute::Software(s)
        Err(e) => return Err(e)
      }
    } else if atype == attr_error_code {
      if alen < 4 {
        return Err(StunError::InvalidAttribute("ERROR-CODE must be at least 4 bytes"))
      }
      let reason_len = alen - 4
      if reason_len > 763 {
        return Err(StunError::InvalidAttribute("ERROR-CODE reason exceeds 763 bytes"))
      }
      let cls = data[val_off + 2].to_int() & 0x07
      let num = data[val_off + 3].to_int()
      if cls < 3 || cls > 6 || num > 99 {
        return Err(StunError::InvalidAttribute("invalid ERROR-CODE class/number"))
      }
      let reason = match slice_utf8_string_checked(data, val_off + 4, reason_len) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      Attribute::ErrorCode(ErrorCode::new(cls * 100 + num, reason))
    } else if atype == attr_unknown_attributes {
      if (alen & 1) != 0 {
        return Err(StunError::InvalidAttribute("UNKNOWN-ATTRIBUTES length must be even"))
      }
      let list : Array[Int] = []
      let mut k = 0
      while k < alen {
        list.push(read_u16_be(data, val_off + k))
        k = k + 2
      }
      Attribute::UnknownAttributes(list)
    } else if atype == attr_message_integrity_sha256 {
      // RFC 8489 §14.6: 16..32 bytes in multiples of 4 (truncation allowed)
      if alen < 16 || alen > 32 || (alen & 3) != 0 {
        return Err(
          StunError::InvalidAttribute("MESSAGE-INTEGRITY-SHA256 must be 16..32 bytes (multiple of 4)"),
        )
      }
      seen_mi256 = true
      Attribute::MessageIntegritySha256(data.slice(val_off, val_off + alen))
    } else {
      Attribute::Unknown(atype, data.slice(val_off, val_off + alen))
    }

    attrs.push(attr)
    pos = val_off + padded_len
  }

  Ok(Message::{
    msg_class: msg_class,
    method: method,
    transaction_id: tx_id,
    attributes: attrs,
  })
}

///|
pub fn encode_message(msg : Message) -> Result[Bytes, StunError] {
  encode_message_signed(msg, None, false, false)
}

///| Encode a STUN message, optionally appending MESSAGE-INTEGRITY (HMAC-SHA1 or HMAC-SHA256)
///| and/or FINGERPRINT (CRC-32 XOR 0x5354554E) with RFC 8489 §14.5/§14.7 length adjustments.
pub fn encode_message_signed(
  msg : Message,
  integrity_key : Option[Bytes],
  use_sha256 : Bool,
  with_fingerprint : Bool,
) -> Result[Bytes, StunError] {
  let tx_id = msg.transaction_id
  if tx_id.length() != 12 {
    return Err(StunError::InvalidInput("transaction_id must be exactly 12 bytes"))
  }
  let m = message_method_to_code(msg.method)
  if m < 0 || m > 0xFFF {
    return Err(StunError::InvalidHeader("method out of 12-bit range"))
  }
  let c = match msg.msg_class {
    MessageClass::Request => 0
    MessageClass::Indication => 1
    MessageClass::SuccessResponse => 2
    MessageClass::ErrorResponse => 3
  }
  let raw_type = ((m & 0x0F80) << 2) |
  (((c >> 1) & 1) << 8) |
  ((m & 0x0070) << 1) |
  ((c & 1) << 4) |
  (m & 0x000F)

  let has_integrity = match integrity_key {
    Some(_) => true
    None => false
  }
  let attrs = msg.attributes
  let num_attrs = attrs.length()
  let mut body_len = 0
  let mut i = 0
  while i < num_attrs {
    let vlen = match attrs[i] {
      Attribute::MappedAddress(addr) | Attribute::XorMappedAddress(addr) => {
        match addr {
          SocketAddr::Ipv4(_, _) => 8
          SocketAddr::Ipv6(ip6, _) => {
            if ip6.length() != 16 {
              return Err(StunError::InvalidInput("IPv6 address must be 16 bytes"))
            }
            20
          }
        }
      }
      Attribute::Username(s) => {
        let l = s.length()
        if l > 509 {
          return Err(StunError::InvalidInput("USERNAME exceeds 509 bytes"))
        }
        l
      }
      Attribute::Realm(s) => {
        let l = s.length()
        if l > 509 {
          return Err(StunError::InvalidInput("REALM exceeds 509 bytes"))
        }
        l
      }
      Attribute::Nonce(s) => {
        let l = s.length()
        if l > 509 {
          return Err(StunError::InvalidInput("NONCE exceeds 509 bytes"))
        }
        l
      }
      Attribute::Software(s) => {
        let l = s.length()
        if l > 509 {
          return Err(StunError::InvalidInput("SOFTWARE exceeds 509 bytes"))
        }
        l
      }
      Attribute::ErrorCode(ec) => {
        if ec.code < 300 || ec.code > 699 {
          return Err(StunError::InvalidInput("ERROR-CODE must be in 300..699"))
        }
        let l = ec.reason.length()
        if l > 509 {
          return Err(StunError::InvalidInput("ERROR-CODE reason exceeds 509 bytes"))
        }
        4 + l
      }
      Attribute::UnknownAttributes(list) => list.length() * 2
      Attribute::Priority(_) => 4
      Attribute::UseCandidate => 0
      Attribute::IceControlled(_) | Attribute::IceControlling(_) => 8
      Attribute::MessageIntegrity(b) => {
        if b.length() != 20 {
          return Err(StunError::InvalidInput("MESSAGE-INTEGRITY must be 20 bytes"))
        }
        20
      }
      Attribute::MessageIntegritySha256(b) => {
        let n = b.length()
        if n < 16 || n > 32 || (n & 3) != 0 {
          return Err(
            StunError::InvalidInput("MESSAGE-INTEGRITY-SHA256 must be 16..32 bytes (multiple of 4)"),
          )
        }
        n
      }
      Attribute::Fingerprint(_) => 4
      Attribute::Unknown(t, b) => {
        if t < 0 || t > 0xFFFF {
          return Err(StunError::InvalidInput("attribute type out of u16 range"))
        }
        b.length()
      }
    }
    if vlen > 0xFFFF {
      return Err(StunError::InvalidInput("attribute value exceeds 65535 bytes"))
    }
    body_len = body_len + 4 + align4(vlen)
    i = i + 1
  }

  let mi_total = if has_integrity {
    if use_sha256 { 36 } else { 24 }
  } else {
    0
  }
  let fp_total = if with_fingerprint { 8 } else { 0 }
  let final_body_len = body_len + mi_total + fp_total
  if final_body_len > 0xFFFF {
    return Err(StunError::InvalidInput("encoded STUN message exceeds 65535 bytes"))
  }

  let mut out = Bytes::new(stun_header_size + final_body_len)
  out[0] = ((raw_type >> 8) & 0xFF).to_byte()
  out[1] = (raw_type & 0xFF).to_byte()
  out[2] = ((final_body_len >> 8) & 0xFF).to_byte()
  out[3] = (final_body_len & 0xFF).to_byte()
  out[4] = (0x21).to_byte()
  out[5] = (0x12).to_byte()
  out[6] = (0xA4).to_byte()
  out[7] = (0x42).to_byte()
  let mut t = 0
  while t < 12 {
    out[8 + t] = tx_id[t]
    t = t + 1
  }

  let mut pos = stun_header_size
  let mut j = 0
  while j < num_attrs {
    match attrs[j] {
      Attribute::XorMappedAddress(addr) => {
        match addr {
          SocketAddr::Ipv4(ip, port) => {
            out[pos] = (0x00).to_byte()
            out[pos + 1] = (0x20).to_byte()
            out[pos + 2] = (0x00).to_byte()
            out[pos + 3] = (0x08).to_byte()
            out[pos + 4] = (0x00).to_byte()
            out[pos + 5] = (0x01).to_byte()
            let p = (port & 0xFFFF) ^ 0x2112
            out[pos + 6] = ((p >> 8) & 0xFF).to_byte()
            out[pos + 7] = (p & 0xFF).to_byte()
            let xip = ip ^ stun_magic_cookie
            out[pos + 8] = ((xip >> 24U) & 0xFFU).to_int().to_byte()
            out[pos + 9] = ((xip >> 16U) & 0xFFU).to_int().to_byte()
            out[pos + 10] = ((xip >> 8U) & 0xFFU).to_int().to_byte()
            out[pos + 11] = (xip & 0xFFU).to_int().to_byte()
            pos = pos + 12
          }
          SocketAddr::Ipv6(ip6, port) => {
            out[pos] = (0x00).to_byte()
            out[pos + 1] = (0x20).to_byte()
            out[pos + 2] = (0x00).to_byte()
            out[pos + 3] = (0x14).to_byte()
            out[pos + 4] = (0x00).to_byte()
            out[pos + 5] = (0x02).to_byte()
            let p = (port & 0xFFFF) ^ 0x2112
            out[pos + 6] = ((p >> 8) & 0xFF).to_byte()
            out[pos + 7] = (p & 0xFF).to_byte()
            out[pos + 8] = (ip6[0].to_int() ^ 0x21).to_byte()
            out[pos + 9] = (ip6[1].to_int() ^ 0x12).to_byte()
            out[pos + 10] = (ip6[2].to_int() ^ 0xA4).to_byte()
            out[pos + 11] = (ip6[3].to_int() ^ 0x42).to_byte()
            let mut k = 0
            while k < 12 {
              out[pos + 12 + k] = (ip6[4 + k].to_int() ^ tx_id[k].to_int()).to_byte()
              k = k + 1
            }
            pos = pos + 24
          }
        }
      }
      Attribute::MappedAddress(addr) => {
        match addr {
          SocketAddr::Ipv4(ip, port) => {
            out[pos] = (0x00).to_byte()
            out[pos + 1] = (0x01).to_byte()
            out[pos + 2] = (0x00).to_byte()
            out[pos + 3] = (0x08).to_byte()
            out[pos + 4] = (0x00).to_byte()
            out[pos + 5] = (0x01).to_byte()
            out[pos + 6] = ((port >> 8) & 0xFF).to_byte()
            out[pos + 7] = (port & 0xFF).to_byte()
            out[pos + 8] = ((ip >> 24U) & 0xFFU).to_int().to_byte()
            out[pos + 9] = ((ip >> 16U) & 0xFFU).to_int().to_byte()
            out[pos + 10] = ((ip >> 8U) & 0xFFU).to_int().to_byte()
            out[pos + 11] = (ip & 0xFFU).to_int().to_byte()
            pos = pos + 12
          }
          SocketAddr::Ipv6(ip6, port) => {
            out[pos] = (0x00).to_byte()
            out[pos + 1] = (0x01).to_byte()
            out[pos + 2] = (0x00).to_byte()
            out[pos + 3] = (0x14).to_byte()
            out[pos + 4] = (0x00).to_byte()
            out[pos + 5] = (0x02).to_byte()
            out[pos + 6] = ((port >> 8) & 0xFF).to_byte()
            out[pos + 7] = (port & 0xFF).to_byte()
            let mut k = 0
            while k < 16 {
              out[pos + 8 + k] = ip6[k]
              k = k + 1
            }
            pos = pos + 24
          }
        }
      }
      Attribute::Username(s) => {
        let vlen = s.length()
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x06).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < vlen {
          out[pos + 4 + k] = (s.code_unit_at(k) & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::Priority(p) => {
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x24).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x04).to_byte()
        out[pos + 4] = ((p >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 5] = ((p >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 6] = ((p >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 7] = (p & 0xFFU).to_int().to_byte()
        pos = pos + 8
      }
      Attribute::IceControlling(v) => {
        out[pos] = (0x80).to_byte()
        out[pos + 1] = (0x2A).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x08).to_byte()
        let hi : UInt = ((v >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
        let lo : UInt = (v & 0xFFFFFFFFUL).to_int().to_uint()
        out[pos + 4] = ((hi >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 5] = ((hi >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 6] = ((hi >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 7] = (hi & 0xFFU).to_int().to_byte()
        out[pos + 8] = ((lo >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 9] = ((lo >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 10] = ((lo >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 11] = (lo & 0xFFU).to_int().to_byte()
        pos = pos + 12
      }
      Attribute::UseCandidate => {
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x25).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x00).to_byte()
        pos = pos + 4
      }
      Attribute::IceControlled(v) => {
        out[pos] = (0x80).to_byte()
        out[pos + 1] = (0x29).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x08).to_byte()
        let hi : UInt = ((v >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
        let lo : UInt = (v & 0xFFFFFFFFUL).to_int().to_uint()
        out[pos + 4] = ((hi >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 5] = ((hi >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 6] = ((hi >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 7] = (hi & 0xFFU).to_int().to_byte()
        out[pos + 8] = ((lo >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 9] = ((lo >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 10] = ((lo >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 11] = (lo & 0xFFU).to_int().to_byte()
        pos = pos + 12
      }
      Attribute::Realm(s) => {
        let vlen = s.length()
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x14).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < vlen {
          out[pos + 4 + k] = (s.code_unit_at(k) & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::Nonce(s) => {
        let vlen = s.length()
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x15).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < vlen {
          out[pos + 4 + k] = (s.code_unit_at(k) & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::Software(s) => {
        let vlen = s.length()
        out[pos] = (0x80).to_byte()
        out[pos + 1] = (0x22).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < vlen {
          out[pos + 4 + k] = (s.code_unit_at(k) & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::ErrorCode(ec) => {
        let rlen = ec.reason.length()
        let vlen = 4 + rlen
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x09).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        out[pos + 4] = (0).to_byte()
        out[pos + 5] = (0).to_byte()
        out[pos + 6] = ((ec.code / 100) & 0x07).to_byte()
        out[pos + 7] = (ec.code % 100).to_byte()
        let mut k = 0
        while k < rlen {
          out[pos + 8 + k] = (ec.reason.code_unit_at(k) & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::UnknownAttributes(list) => {
        let n = list.length()
        let vlen = n * 2
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x0A).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < n {
          let v = list[k]
          out[pos + 4 + k * 2] = ((v >> 8) & 0xFF).to_byte()
          out[pos + 5 + k * 2] = (v & 0xFF).to_byte()
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
      Attribute::MessageIntegrity(b) => {
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x08).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x14).to_byte()
        let mut k = 0
        while k < 20 {
          out[pos + 4 + k] = b[k]
          k = k + 1
        }
        pos = pos + 24
      }
      Attribute::MessageIntegritySha256(b) => {
        let n = b.length()
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x1C).to_byte()
        out[pos + 2] = ((n >> 8) & 0xFF).to_byte()
        out[pos + 3] = (n & 0xFF).to_byte()
        let mut k = 0
        while k < n {
          out[pos + 4 + k] = b[k]
          k = k + 1
        }
        pos = pos + 4 + n
      }
      Attribute::Fingerprint(fp) => {
        out[pos] = (0x80).to_byte()
        out[pos + 1] = (0x28).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x04).to_byte()
        out[pos + 4] = ((fp >> 24U) & 0xFFU).to_int().to_byte()
        out[pos + 5] = ((fp >> 16U) & 0xFFU).to_int().to_byte()
        out[pos + 6] = ((fp >> 8U) & 0xFFU).to_int().to_byte()
        out[pos + 7] = (fp & 0xFFU).to_int().to_byte()
        pos = pos + 8
      }
      Attribute::Unknown(t, b) => {
        let vlen = b.length()
        out[pos] = ((t >> 8) & 0xFF).to_byte()
        out[pos + 1] = (t & 0xFF).to_byte()
        out[pos + 2] = ((vlen >> 8) & 0xFF).to_byte()
        out[pos + 3] = (vlen & 0xFF).to_byte()
        let mut k = 0
        while k < vlen {
          out[pos + 4 + k] = b[k]
          k = k + 1
        }
        pos = pos + 4 + align4(vlen)
      }
    }
    j = j + 1
  }

  match integrity_key {
    Some(key) => {
      let adj_len = (pos - stun_header_size) + mi_total
      if use_sha256 {
        let mac = hmac_sha256_stun_prefix(key, out, pos, adj_len)
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x1C).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x20).to_byte()
        let mut k = 0
        while k < 32 {
          out[pos + 4 + k] = mac[k]
          k = k + 1
        }
        pos = pos + 36
      } else {
        let mac_words = hmac_sha1_stun_prefix_words(key, out, pos, adj_len)
        out[pos] = (0x00).to_byte()
        out[pos + 1] = (0x08).to_byte()
        out[pos + 2] = (0x00).to_byte()
        out[pos + 3] = (0x14).to_byte()
        let mut k = 0
        while k < 5 {
          let v = mac_words[k]
          let p = pos + 4 + (k << 2)
          out[p] = ((v >> 24U) & 0xFFU).to_int().to_byte()
          out[p + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
          out[p + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
          out[p + 3] = (v & 0xFFU).to_int().to_byte()
          k = k + 1
        }
        pos = pos + 24
      }
    }
    None => ()
  }

  if with_fingerprint {
    let fp = crc32_ieee(out, 0, pos) ^ stun_fingerprint_xor
    out[pos] = (0x80).to_byte()
    out[pos + 1] = (0x28).to_byte()
    out[pos + 2] = (0x00).to_byte()
    out[pos + 3] = (0x04).to_byte()
    out[pos + 4] = ((fp >> 24U) & 0xFFU).to_int().to_byte()
    out[pos + 5] = ((fp >> 16U) & 0xFFU).to_int().to_byte()
    out[pos + 6] = ((fp >> 8U) & 0xFFU).to_int().to_byte()
    out[pos + 7] = (fp & 0xFFU).to_int().to_byte()
  }

  Ok(out)
}

///| Stack-allocated result of `find_attr_offset` (avoids Option[(Int, Int)] heap tuple).
val struct AttrSpan {
  found : Bool
  off : Int
  len : Int
}

///| Locate the first attribute of `target_type` while validating the ENTIRE TLV framing
///| from byte 20 to `raw.length()` (P2-12: prevents returning Ok(true) on truncated/malformed tails).
fn find_attr_offset(raw : Bytes, target_type : Int) -> Result[AttrSpan, StunError] {
  let n = raw.length()
  if n < stun_header_size {
    return Err(StunError::PacketTooShort("STUN packet shorter than 20 bytes"))
  }
  if (raw[0].to_int() & 0xC0) != 0 {
    return Err(StunError::InvalidHeader("top 2 bits must be 00"))
  }
  let msg_len = read_u16_be(raw, 2)
  if (msg_len & 3) != 0 || stun_header_size + msg_len != n {
    return Err(StunError::LengthMismatch("invalid STUN length"))
  }
  let cookie = (raw[4].to_int().to_uint() << 24U) |
  (raw[5].to_int().to_uint() << 16U) |
  (raw[6].to_int().to_uint() << 8U) |
  raw[7].to_int().to_uint()
  if cookie != stun_magic_cookie {
    return Err(StunError::InvalidMagicCookie(cookie))
  }

  let mut found = false
  let mut found_off = 0
  let mut found_len = 0
  let mut pos = stun_header_size
  while pos < n {
    if pos + 4 > n {
      return Err(StunError::TruncatedAttribute("truncated attribute header"))
    }
    let atype = read_u16_be(raw, pos)
    let alen = read_u16_be(raw, pos + 2)
    let padded = align4(alen)
    if pos + 4 + alen > n || pos + 4 + padded > n {
      return Err(StunError::TruncatedAttribute("truncated attribute value"))
    }
    if !found && atype == target_type {
      found = true
      found_off = pos
      found_len = alen
    }
    pos = pos + 4 + padded
  }
  Ok(AttrSpan::{ found: found, off: found_off, len: found_len })
}

///| Verify RFC 8489 §14.5 MESSAGE-INTEGRITY (HMAC-SHA1) over raw STUN wire bytes.
pub fn verify_message_integrity(raw : Bytes, key : Bytes) -> Result[Bool, StunError] {
  match find_attr_offset(raw, attr_message_integrity) {
    Err(e) => Err(e)
    Ok(span) => {
      if !span.found {
        return Ok(false)
      }
      if span.len != 20 {
        return Err(StunError::InvalidAttribute("MESSAGE-INTEGRITY must be 20 bytes"))
      }
      let adjusted_len = (span.off - stun_header_size) + 24
      let computed = hmac_sha1_stun_prefix(key, raw, span.off, adjusted_len)
      let expected = raw.slice(span.off + 4, span.off + 24)
      Ok(verify_ct_eq(computed, expected))
    }
  }
}

///| Verify RFC 8489 §14.6 MESSAGE-INTEGRITY-SHA256 (HMAC-SHA256, 16..32B multiple of 4).
pub fn verify_message_integrity_sha256(raw : Bytes, key : Bytes) -> Result[Bool, StunError] {
  match find_attr_offset(raw, attr_message_integrity_sha256) {
    Err(e) => Err(e)
    Ok(span) => {
      if !span.found {
        return Ok(false)
      }
      let alen = span.len
      if alen < 16 || alen > 32 || (alen & 3) != 0 {
        return Err(
          StunError::InvalidAttribute("MESSAGE-INTEGRITY-SHA256 must be 16..32 bytes (multiple of 4)"),
        )
      }
      let adjusted_len = (span.off - stun_header_size) + 4 + alen
      let full_mac = hmac_sha256_stun_prefix(key, raw, span.off, adjusted_len)
      let computed = if alen == 32 { full_mac } else { full_mac.slice(0, alen) }
      let expected = raw.slice(span.off + 4, span.off + 4 + alen)
      Ok(verify_ct_eq(computed, expected))
    }
  }
}

///| Verify RFC 8489 §14.7 FINGERPRINT (CRC-32 XOR 0x5354554E) as the final attribute.
pub fn verify_fingerprint(raw : Bytes) -> Result[Bool, StunError] {
  match find_attr_offset(raw, attr_fingerprint) {
    Err(e) => Err(e)
    Ok(span) => {
      if !span.found {
        return Ok(false)
      }
      if span.len != 4 {
        return Err(StunError::InvalidAttribute("FINGERPRINT must be 4 bytes"))
      }
      if span.off + 8 != raw.length() {
        return Err(StunError::InvalidAttribute("FINGERPRINT must be the last attribute"))
      }
      let computed = crc32_ieee(raw, 0, span.off) ^ stun_fingerprint_xor
      let expected = (raw[span.off + 4].to_int().to_uint() << 24U) |
      (raw[span.off + 5].to_int().to_uint() << 16U) |
      (raw[span.off + 6].to_int().to_uint() << 8U) |
      raw[span.off + 7].to_int().to_uint()
      Ok(computed == expected)
    }
  }
}
