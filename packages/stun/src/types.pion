///| Core types, constants, errors, limits, and ICE state structures for
///| pure-Pion RFC 8489 STUN and RFC 8445 ICE.

///|
pub let stun_magic_cookie : UInt = 0x2112A442U

///|
pub let stun_header_size : Int = 20

///|
pub let stun_fingerprint_xor : UInt = 0x5354554EU

///| STUN Attribute Type codes (RFC 8489 / RFC 8445)
pub let attr_mapped_address : Int = 0x0001

///|
pub let attr_username : Int = 0x0006

///|
pub let attr_message_integrity : Int = 0x0008

///|
pub let attr_error_code : Int = 0x0009

///|
pub let attr_unknown_attributes : Int = 0x000A

///|
pub let attr_realm : Int = 0x0014

///|
pub let attr_nonce : Int = 0x0015

///|
pub let attr_message_integrity_sha256 : Int = 0x001C

///|
pub let attr_xor_mapped_address : Int = 0x0020

///|
pub let attr_priority : Int = 0x0024

///|
pub let attr_use_candidate : Int = 0x0025

///|
pub let attr_software : Int = 0x8022

///|
pub let attr_fingerprint : Int = 0x8028

///|
pub let attr_ice_controlled : Int = 0x8029

///|
pub let attr_ice_controlling : Int = 0x802A

///| STUN / TURN 12-bit Method codes
pub let method_binding : Int = 0x001

///|
pub let method_allocate : Int = 0x003

///|
pub let method_refresh : Int = 0x004

///|
pub let method_send : Int = 0x006

///|
pub let method_data : Int = 0x007

///|
pub let method_create_permission : Int = 0x008

///|
pub let method_channel_bind : Int = 0x009

///| RFC 8445 §5.1.2.2 recommended ICE candidate type preferences
pub let type_pref_host : Int = 126

///|
pub let type_pref_prflx : Int = 110

///|
pub let type_pref_srflx : Int = 100

///|
pub let type_pref_relay : Int = 0

///|
pub enum StunError {
  InvalidLimits(String)
  PacketTooShort(String)
  InvalidHeader(String)
  InvalidMagicCookie(UInt)
  LengthMismatch(String)
  InvalidAttribute(String)
  TruncatedAttribute(String)
  LimitExceeded(String)
  IntegrityMismatch(String)
  FingerprintMismatch(String)
  InvalidInput(String)
  IceError(String)
}

///|
pub fn stun_error_message(err : StunError) -> String {
  match err {
    StunError::InvalidLimits(m) => "InvalidLimits: " + m
    StunError::PacketTooShort(m) => "PacketTooShort: " + m
    StunError::InvalidHeader(m) => "InvalidHeader: " + m
    StunError::InvalidMagicCookie(v) => "InvalidMagicCookie: " + v.to_string()
    StunError::LengthMismatch(m) => "LengthMismatch: " + m
    StunError::InvalidAttribute(m) => "InvalidAttribute: " + m
    StunError::TruncatedAttribute(m) => "TruncatedAttribute: " + m
    StunError::LimitExceeded(m) => "LimitExceeded: " + m
    StunError::IntegrityMismatch(m) => "IntegrityMismatch: " + m
    StunError::FingerprintMismatch(m) => "FingerprintMismatch: " + m
    StunError::InvalidInput(m) => "InvalidInput: " + m
    StunError::IceError(m) => "IceError: " + m
  }
}

///| Defensive decoding limits.
///| Any negative field is immediately rejected with `StunError::InvalidLimits`.
///| A value of `0` strictly means 0 allowed (e.g. `max_attributes == 0` rejects any attribute).
pub val struct DecodeLimits {
  pub max_message_bytes : Int
  pub max_attributes : Int
  pub max_attribute_bytes : Int
}

///|
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_message_bytes: 65552,
    max_attributes: 64,
    max_attribute_bytes: 4096,
  }
}

///|
pub fn DecodeLimits::new(
  max_message_bytes : Int,
  max_attributes : Int,
  max_attribute_bytes : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_message_bytes: max_message_bytes,
    max_attributes: max_attributes,
    max_attribute_bytes: max_attribute_bytes,
  }
}

///|
pub enum MessageClass {
  Request
  Indication
  SuccessResponse
  ErrorResponse
}

///|
pub fn message_class_eq(a : MessageClass, b : MessageClass) -> Bool {
  match (a, b) {
    (MessageClass::Request, MessageClass::Request) => true
    (MessageClass::Indication, MessageClass::Indication) => true
    (MessageClass::SuccessResponse, MessageClass::SuccessResponse) => true
    (MessageClass::ErrorResponse, MessageClass::ErrorResponse) => true
    _ => false
  }
}

///|
pub enum MessageMethod {
  Binding
  Allocate
  Refresh
  Send
  Data
  CreatePermission
  ChannelBind
  Other(Int)
}

///|
pub fn message_method_to_code(m : MessageMethod) -> Int {
  match m {
    MessageMethod::Binding => method_binding
    MessageMethod::Allocate => method_allocate
    MessageMethod::Refresh => method_refresh
    MessageMethod::Send => method_send
    MessageMethod::Data => method_data
    MessageMethod::CreatePermission => method_create_permission
    MessageMethod::ChannelBind => method_channel_bind
    MessageMethod::Other(code) => code
  }
}

///|
pub fn message_method_from_code(code : Int) -> MessageMethod {
  if code == method_binding {
    MessageMethod::Binding
  } else if code == method_allocate {
    MessageMethod::Allocate
  } else if code == method_refresh {
    MessageMethod::Refresh
  } else if code == method_send {
    MessageMethod::Send
  } else if code == method_data {
    MessageMethod::Data
  } else if code == method_create_permission {
    MessageMethod::CreatePermission
  } else if code == method_channel_bind {
    MessageMethod::ChannelBind
  } else {
    MessageMethod::Other(code)
  }
}

///|
pub fn message_method_eq(a : MessageMethod, b : MessageMethod) -> Bool {
  message_method_to_code(a) == message_method_to_code(b)
}

///|
pub enum SocketAddr {
  Ipv4(UInt, Int)
  Ipv6(Bytes, Int)
}

///|
pub fn socket_addr_ipv4(a : Int, b : Int, c : Int, d : Int, port : Int) -> SocketAddr {
  let ip : UInt = ((a & 0xFF).to_uint() << 24U) |
  ((b & 0xFF).to_uint() << 16U) |
  ((c & 0xFF).to_uint() << 8U) |
  (d & 0xFF).to_uint()
  SocketAddr::Ipv4(ip, port & 0xFFFF)
}

///|
pub fn socket_addr_ipv6(ip16 : Bytes, port : Int) -> SocketAddr {
  SocketAddr::Ipv6(ip16, port & 0xFFFF)
}

///|
pub fn socket_addr_eq(a : SocketAddr, b : SocketAddr) -> Bool {
  match a {
    SocketAddr::Ipv4(ip1, p1) => {
      match b {
        SocketAddr::Ipv4(ip2, p2) => ip1 == ip2 && p1 == p2
        SocketAddr::Ipv6(_, _) => false
      }
    }
    SocketAddr::Ipv6(b1, p1) => {
      match b {
        SocketAddr::Ipv4(_, _) => false
        SocketAddr::Ipv6(b2, p2) => {
          if p1 != p2 || b1.length() != b2.length() {
            return false
          }
          let mut i = 0
          while i < b1.length() {
            if b1[i] != b2[i] {
              return false
            }
            i = i + 1
          }
          true
        }
      }
    }
  }
}

///|
pub val struct ErrorCode {
  pub code : Int
  pub reason : String
}

///|
pub fn ErrorCode::new(code : Int, reason : String) -> ErrorCode {
  ErrorCode::{ code: code, reason: reason }
}

///|
pub enum Attribute {
  MappedAddress(SocketAddr)
  XorMappedAddress(SocketAddr)
  Username(String)
  Realm(String)
  Nonce(String)
  Software(String)
  ErrorCode(ErrorCode)
  UnknownAttributes(Array[Int])
  Priority(UInt)
  UseCandidate
  IceControlled(UInt64)
  IceControlling(UInt64)
  MessageIntegrity(Bytes)
  MessageIntegritySha256(Bytes)
  Fingerprint(UInt)
  Unknown(Int, Bytes)
}

///|
pub struct Message {
  pub msg_class : MessageClass
  pub method : MessageMethod
  pub transaction_id : Bytes
  pub attributes : Array[Attribute]
}

///|
pub fn Message::new(
  msg_class : MessageClass,
  method : MessageMethod,
  transaction_id : Bytes,
) -> Message {
  Message::{
    msg_class: msg_class,
    method: method,
    transaction_id: transaction_id,
    attributes: [],
  }
}

///|
pub fn Message::add(self : Message, attr : Attribute) -> Unit {
  self.attributes.push(attr)
}

///|
pub enum IceRole {
  Controlling
  Controlled
}

///|
pub fn ice_role_eq(a : IceRole, b : IceRole) -> Bool {
  match (a, b) {
    (IceRole::Controlling, IceRole::Controlling) => true
    (IceRole::Controlled, IceRole::Controlled) => true
    _ => false
  }
}

///|
pub enum CandidateType {
  Host
  PeerReflexive
  ServerReflexive
  Relay
}

///|
pub fn candidate_type_pref(ct : CandidateType) -> Int {
  match ct {
    CandidateType::Host => type_pref_host
    CandidateType::PeerReflexive => type_pref_prflx
    CandidateType::ServerReflexive => type_pref_srflx
    CandidateType::Relay => type_pref_relay
  }
}

///|
pub struct IceCandidate {
  pub foundation : String
  pub component_id : Int
  pub addr : SocketAddr
  pub cand_type : CandidateType
  pub priority : UInt
}

///|
pub enum PairState {
  Frozen
  Waiting
  InProgress
  Succeeded
  Failed
}

///|
pub fn pair_state_eq(a : PairState, b : PairState) -> Bool {
  match (a, b) {
    (PairState::Frozen, PairState::Frozen) => true
    (PairState::Waiting, PairState::Waiting) => true
    (PairState::InProgress, PairState::InProgress) => true
    (PairState::Succeeded, PairState::Succeeded) => true
    (PairState::Failed, PairState::Failed) => true
    _ => false
  }
}

///|
pub struct CandidatePair {
  pub local_idx : Int
  pub remote_idx : Int
  pub priority : Int64
  pub mut state : PairState
  pub mut nominated : Bool
  pub mut last_tx_id : Bytes
  pub mut mapped_addr : Option[SocketAddr]
}

///|
pub struct IceCheckPacket {
  pub pair_idx : Int
  pub local_addr : SocketAddr
  pub remote_addr : SocketAddr
  pub wire : Bytes
  pub transaction_id : Bytes
}

///|
pub enum IceInboundResult {
  SendResponse(Bytes, SocketAddr)
  PairSucceeded(Int, Option[SocketAddr])
  PairFailed(Int, Int)
  Ignored(String)
}

///|
pub struct IceAgent {
  pub mut role : IceRole
  pub tie_breaker : UInt64
  pub local_ufrag : String
  pub local_pwd : String
  pub mut remote_ufrag : String
  pub mut remote_pwd : String
  pub aggressive_nomination : Bool
  pub local_candidates : Array[IceCandidate]
  pub remote_candidates : Array[IceCandidate]
  pub pairs : Array[CandidatePair]
  pub mut tx_counter : UInt64
  pub mut nominated_pair_idx : Option[Int]
  pub mut max_candidates : Int
  pub mut max_pairs : Int
  pub mut tx_seed : Bytes
}
