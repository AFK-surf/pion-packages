///| Red-team differential / fuzz / DoS oracle for `packages/stun` (Pion side).
///|
///| Modes (line-oriented output, diffed against ../diff/rust and ../diff/ref.py):
///|   decode <corpus.tsv>          "<label>\tD=..\tFP=..\tMI=..\tM2=..\tXA=.." per "<label>\t<hex>\t<keyhex>" line
///|   encode <specs.tsv>           "<label>\tW=<hex>" per spec line (see diff/gen_corpus.py)
///|   fuzz <seed> <n> [dump]       deterministic mutation fuzzing; prints a digest (or the corpus with dump)
///|   dos cands <L> <R>            L local x R remote candidates -> pair count + ms
///|   dos attrs <n>                decode one message holding n zero-length attributes (limits lifted)
///|   dos big <n>                  decode + verify one 20+65532-byte message, n times
///|   dos inbound <R> <n>          n authenticated checks into an agent holding 1 x R pairs

import "stun"
import "crypto"

///|
let hex_digits : String = "0123456789abcdef"

///|
fn to_hex(b : Bytes) -> String {
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[2 * i] = hex_digits.code_unit_at(v >> 4).to_byte()
    out[2 * i + 1] = hex_digits.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn hex4(t : Int) -> String {
  let b = Bytes::new(2)
  b[0] = ((t >> 8) & 0xFF).to_byte()
  b[1] = (t & 0xFF).to_byte()
  to_hex(b)
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((hex_val(buf[start + 2 * i].to_int()) << 4) | hex_val(buf[start + 2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///|
fn find_byte(buf : Bytes, from : Int, end : Int, c : Int) -> Int {
  let mut i = from
  while i < end && buf[i].to_int() != c {
    i = i + 1
  }
  i
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn vstr(r : Result[Bool, stun::StunError], present : Bool) -> String {
  if !present {
    return "none"
  }
  match r {
    Ok(true) => "true"
    Ok(false) => "false"
    Err(_) => "err"
  }
}

///|
fn has_attr(raw : Bytes, t : Int) -> Bool {
  // framing-level scan identical to the RFC TLV walk (used only to print "none" vs "false")
  if raw.length() < 20 {
    return false
  }
  let n = raw.length()
  let mut pos = 20
  while pos + 4 <= n {
    let at = (raw[pos].to_int() << 8) | raw[pos + 1].to_int()
    let al = (raw[pos + 2].to_int() << 8) | raw[pos + 3].to_int()
    if at == t {
      return true
    }
    pos = pos + 4 + ((al + 3) & -4)
  }
  false
}

///|
fn addr_str(a : stun::SocketAddr) -> String {
  match a {
    stun::SocketAddr::Ipv4(ip, port) => {
      ((ip >> 24U) & 0xFFU).to_string() + "." + ((ip >> 16U) & 0xFFU).to_string() + "." +
      ((ip >> 8U) & 0xFFU).to_string() + "." + (ip & 0xFFU).to_string() + ":" + port.to_string()
    }
    stun::SocketAddr::Ipv6(b, port) => "[" + to_hex(b) + "]:" + port.to_string()
  }
}

///| Same canonical line as diff/ref.py and diff/rust.
fn decode_line(raw : Bytes, key : Bytes) -> String {
  let lim = stun::DecodeLimits::new(65552, 100000, 65535)
  let d = match stun::decode_message_with_limits(raw, lim) {
    Ok(m) => {
      let sb = StringBuilder::new()
      sb.write_string("ok:" + m.attributes.length().to_string() + ":")
      let mut i = 0
      while i < m.attributes.length() && i < 12 {
        let t = match m.attributes[i] {
          stun::Attribute::MappedAddress(_) => 0x0001
          stun::Attribute::XorMappedAddress(_) => 0x0020
          stun::Attribute::Username(_) => 0x0006
          stun::Attribute::Realm(_) => 0x0014
          stun::Attribute::Nonce(_) => 0x0015
          stun::Attribute::Software(_) => 0x8022
          stun::Attribute::ErrorCode(_) => 0x0009
          stun::Attribute::UnknownAttributes(_) => 0x000A
          stun::Attribute::Priority(_) => 0x0024
          stun::Attribute::UseCandidate => 0x0025
          stun::Attribute::IceControlled(_) => 0x8029
          stun::Attribute::IceControlling(_) => 0x802A
          stun::Attribute::MessageIntegrity(_) => 0x0008
          stun::Attribute::MessageIntegritySha256(_) => 0x001C
          stun::Attribute::Fingerprint(_) => 0x8028
          stun::Attribute::Unknown(t, _) => t
        }
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(hex4(t))
        i = i + 1
      }
      let mut xa = "-"
      let mut j = 0
      while j < m.attributes.length() {
        match m.attributes[j] {
          stun::Attribute::XorMappedAddress(a) => {
            xa = addr_str(a)
            break
          }
          _ => ()
        }
        j = j + 1
      }
      (sb.to_string(), xa)
    }
    Err(_) => ("err", "-")
  }
  let fp = vstr(stun::verify_fingerprint(raw), has_attr(raw, 0x8028))
  let mi = vstr(stun::verify_message_integrity(raw, key), has_attr(raw, 0x0008))
  let m2 = vstr(stun::verify_message_integrity_sha256(raw, key), has_attr(raw, 0x001C))
  "D=" + d.0 + "\tFP=" + fp + "\tMI=" + mi + "\tM2=" + m2 + "\tXA=" + d.1
}

///|
fn run_decode(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read " + path)
      return 1
    }
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    let le = find_byte(buf, pos, n, 10)
    let t1 = find_byte(buf, pos, le, 9)
    let t2 = find_byte(buf, t1 + 1, le, 9)
    let label = buf.slice(pos, t1).to_string()
    let raw = from_hex(buf, t1 + 1, t2)
    let key = if t2 < le { from_hex(buf, t2 + 1, le) } else { Bytes::new(0) }
    sb.write_string(label + "\t" + decode_line(raw, key) + "\n")
    pos = le + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn u32_of(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24U) | (b[off + 1].to_int().to_uint() << 16U) |
  (b[off + 2].to_int().to_uint() << 8U) | b[off + 3].to_int().to_uint()
}

///|
fn u64_of(b : Bytes) -> UInt64 {
  (u32_of(b, 0).to_int64().to_uint64() << 32) | u32_of(b, 4).to_int64().to_uint64()
}

///| plain (non-XOR) address value bytes -> SocketAddr
fn plain_addr(v : Bytes) -> stun::SocketAddr {
  let port = (v[2].to_int() << 8) | v[3].to_int()
  if v[1].to_int() == 1 {
    stun::SocketAddr::Ipv4(u32_of(v, 4), port)
  } else {
    stun::socket_addr_ipv6(v.slice(4, 20), port)
  }
}

///| Build one typed attribute from a raw "tttt:hex" token.
fn typed_attr(t : Int, v : Bytes) -> stun::Attribute {
  if t == 0x0006 {
    stun::Attribute::Username(v.to_string())
  } else if t == 0x8022 {
    stun::Attribute::Software(v.to_string())
  } else if t == 0x0014 {
    stun::Attribute::Realm(v.to_string())
  } else if t == 0x0015 {
    stun::Attribute::Nonce(v.to_string())
  } else if t == 0x0024 {
    stun::Attribute::Priority(u32_of(v, 0))
  } else if t == 0x0025 {
    stun::Attribute::UseCandidate
  } else if t == 0x802A {
    stun::Attribute::IceControlling(u64_of(v))
  } else if t == 0x8029 {
    stun::Attribute::IceControlled(u64_of(v))
  } else if t == 0x0020 {
    stun::Attribute::XorMappedAddress(plain_addr(v))
  } else if t == 0x0001 {
    stun::Attribute::MappedAddress(plain_addr(v))
  } else if t == 0x0009 {
    stun::Attribute::ErrorCode(stun::ErrorCode::new((v[2].to_int() & 7) * 100 + v[3].to_int(), v.slice(4, v.length()).to_string()))
  } else if t == 0x000A {
    let l : Array[Int] = []
    let mut i = 0
    while i + 1 < v.length() {
      l.push((v[i].to_int() << 8) | v[i + 1].to_int())
      i = i + 2
    }
    stun::Attribute::UnknownAttributes(l)
  } else {
    stun::Attribute::Unknown(t, v)
  }
}

///| spec: label \t msgtype(hex4) \t tx(hex24) \t key(hex) \t mode \t attrs("tttt:hex;...")
fn run_encode(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    let le = find_byte(buf, pos, n, 10)
    let t1 = find_byte(buf, pos, le, 9)
    let t2 = find_byte(buf, t1 + 1, le, 9)
    let t3 = find_byte(buf, t2 + 1, le, 9)
    let t4 = find_byte(buf, t3 + 1, le, 9)
    let t5 = find_byte(buf, t4 + 1, le, 9)
    let label = buf.slice(pos, t1).to_string()
    let mt = from_hex(buf, t1 + 1, t2)
    let tx = from_hex(buf, t2 + 1, t3)
    let key = from_hex(buf, t3 + 1, t4)
    let mode = buf.slice(t4 + 1, t5).to_string()
    let res = match stun::decode_message_type((mt[0].to_int() << 8) | mt[1].to_int()) {
      Err(e) => "ERR:" + stun::stun_error_message(e)
      Ok((cls, meth)) => {
        let msg = stun::Message::new(cls, meth, tx)
        let mut p = t5 + 1
        while p < le {
          let semi = find_byte(buf, p, le, 59)
          let colon = find_byte(buf, p, semi, 58)
          let tb = from_hex(buf, p, colon)
          let v = from_hex(buf, colon + 1, semi)
          msg.add(typed_attr((tb[0].to_int() << 8) | tb[1].to_int(), v))
          p = semi + 1
        }
        let ik : Option[Bytes] = if mode == "n" || mode == "f" { None } else { Some(key) }
        let s256 = mode == "s2" || mode == "s2f"
        let fp = mode == "f" || mode == "s1f" || mode == "s2f"
        match stun::encode_message_signed(msg, ik, s256, fp) {
          Ok(w) => "W=" + to_hex(w)
          Err(e) => "ERR:" + stun::stun_error_message(e)
        }
      }
    }
    sb.write_string(label + "\t" + res + "\n")
    pos = le + 1
  }
  io_print(world, sb.to_string())
  0
}

// ---------------------------------------------------------------------------
// fuzz
// ---------------------------------------------------------------------------

///|
struct Rng {
  mut s : UInt64
}

///|
fn Rng::next(self : Rng) -> Int {
  let mut x = self.s
  x = x ^ (x << 13)
  x = x ^ (x >> 7)
  x = x ^ (x << 17)
  self.s = x
  ((x >> 33) & 0x7FFFFFFFUL).to_int()
}

///|
fn Rng::below(self : Rng, n : Int) -> Int {
  if n <= 0 {
    0
  } else {
    self.next() % n
  }
}

///|
fn blit(dst : Bytes, doff : Int, src : Bytes, soff : Int, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    dst[doff + i] = src[soff + i]
    i = i + 1
  }
}

///|
fn fix_len(b : Bytes) -> Unit {
  let l = b.length() - 20
  if l >= 0 {
    b[2] = ((l >> 8) & 0xFF).to_byte()
    b[3] = (l & 0xFF).to_byte()
  }
}

///|
fn concat(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  blit(out, 0, a, 0, a.length())
  blit(out, a.length(), b, 0, b.length())
  out
}

///|
fn with_fp(b : Bytes) -> Bytes {
  let out = concat(b, Bytes::new(8))
  fix_len(out)
  let off = b.length()
  let fp = stun::crc32_ieee(out, 0, off) ^ 0x5354554EU
  out[off] = (0x80).to_byte()
  out[off + 1] = (0x28).to_byte()
  out[off + 3] = (4).to_byte()
  out[off + 4] = ((fp >> 24U) & 0xFFU).to_int().to_byte()
  out[off + 5] = ((fp >> 16U) & 0xFFU).to_int().to_byte()
  out[off + 6] = ((fp >> 8U) & 0xFFU).to_int().to_byte()
  out[off + 7] = (fp & 0xFFU).to_int().to_byte()
  out
}

///|
let fuzz_key : String = "fuzzKeyVOkJxbRl1RmTxUk/WvJxBt"

///|
fn seed_corpus() -> Array[Bytes] {
  let key = stun::string_to_utf8_bytes(fuzz_key)
  let out : Array[Bytes] = []
  let tx = Bytes::new(12)
  let mut q = 0
  while q < 12 {
    tx[q] = (q + 1).to_byte()
    q = q + 1
  }
  let req = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx)
  req.add(stun::Attribute::Username("uFz:uPeer"))
  req.add(stun::Attribute::Priority(1853824767U))
  req.add(stun::Attribute::IceControlling(0x0102030405060708UL))
  req.add(stun::Attribute::UseCandidate)
  let r4 = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
  r4.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(192, 0, 2, 1, 32853)))
  let r6 = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
  r6.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv6(Bytes::new(16), 65535)))
  r6.add(stun::Attribute::Software("fuzz"))
  let er = stun::Message::new(stun::MessageClass::ErrorResponse, stun::MessageMethod::Binding, tx)
  er.add(stun::Attribute::ErrorCode(stun::ErrorCode::new(487, "Role Conflict")))
  er.add(stun::Attribute::UnknownAttributes([0x0024, 0x7FFF]))
  let msgs = [req, r4, r6, er]
  let mut i = 0
  while i < msgs.length() {
    match stun::encode_message_signed(msgs[i], Some(key), false, true) {
      Ok(w) => out.push(w)
      Err(_) => ()
    }
    match stun::encode_message_signed(msgs[i], Some(key), true, true) {
      Ok(w) => out.push(w)
      Err(_) => ()
    }
    match stun::encode_message(msgs[i]) {
      Ok(w) => out.push(w)
      Err(_) => ()
    }
    i = i + 1
  }
  out
}

///| Authenticated random message (valid MI with the fuzz key): drives the agent's post-auth paths.
fn signed_random(rng : Rng) -> Bytes {
  let key = stun::string_to_utf8_bytes(fuzz_key)
  let tx = Bytes::new(12)
  let mut q = 0
  while q < 12 {
    tx[q] = rng.below(4).to_byte()
    q = q + 1
  }
  let cls = match rng.below(6) {
    0 => stun::MessageClass::Indication
    1 => stun::MessageClass::SuccessResponse
    2 => stun::MessageClass::ErrorResponse
    _ => stun::MessageClass::Request
  }
  let meth = if rng.below(8) == 0 { stun::MessageMethod::Other(rng.below(0x1000)) } else { stun::MessageMethod::Binding }
  let m = stun::Message::new(cls, meth, tx)
  let n = rng.below(8)
  let mut i = 0
  while i < n {
    let k = rng.below(10)
    if k == 0 {
      m.add(stun::Attribute::Username(if rng.below(4) == 0 { "x:y" } else { "uFz:uPeer" }))
    } else if k == 1 {
      m.add(stun::Attribute::Priority(rng.next().to_uint()))
    } else if k == 2 {
      m.add(stun::Attribute::IceControlling(rng.next().to_int64().to_uint64() << 33))
    } else if k == 3 {
      m.add(stun::Attribute::IceControlled(rng.next().to_int64().to_uint64()))
    } else if k == 4 {
      m.add(stun::Attribute::UseCandidate)
    } else if k == 5 {
      m.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(rng.below(256), 0, 0, 1, rng.below(65536))))
    } else if k == 6 {
      m.add(stun::Attribute::ErrorCode(stun::ErrorCode::new(300 + rng.below(400), "e")))
    } else if k == 7 {
      let v = Bytes::new(rng.below(40))
      m.add(stun::Attribute::Unknown(rng.below(0x10000), v))
    } else if k == 8 {
      m.add(stun::Attribute::Software("fz"))
    } else {
      m.add(stun::Attribute::UnknownAttributes([rng.below(0x10000)]))
    }
    i = i + 1
  }
  if rng.below(3) != 0 {
    m.add(stun::Attribute::Username("uFz:uPeer"))
  }
  let w = match stun::encode_message_signed(m, Some(key), rng.below(8) == 0, rng.below(4) != 0) {
    Ok(x) => x
    Err(_) => Bytes::new(0)
  }
  w
}

///|
fn mutate(rng : Rng, seeds : Array[Bytes]) -> Bytes {
  let base = seeds[rng.below(seeds.length())]
  let b = Bytes::new(base.length())
  blit(b, 0, base, 0, base.length())
  let op = rng.below(13)
  if op >= 11 {
    return signed_random(rng)
  }
  if op == 0 {
    let k = 1 + rng.below(4)
    let mut i = 0
    while i < k {
      let p = rng.below(b.length())
      b[p] = (b[p].to_int() ^ (1 << rng.below(8))).to_byte()
      i = i + 1
    }
    b
  } else if op == 1 {
    b.slice(0, rng.below(b.length() + 1))
  } else if op == 2 {
    let l = rng.below(0x10000)
    b[2] = ((l >> 8) & 0xFF).to_byte()
    b[3] = (l & 0xFF).to_byte()
    b
  } else if op == 3 {
    // patch an attribute length field
    let mut pos = 20
    let target = rng.below(6)
    let mut k = 0
    while pos + 4 <= b.length() && k < target {
      let al = (b[pos + 2].to_int() << 8) | b[pos + 3].to_int()
      pos = pos + 4 + ((al + 3) & -4)
      k = k + 1
    }
    if pos + 4 <= b.length() {
      let nl = if rng.below(2) == 0 { rng.below(0x10000) } else { rng.below(40) }
      b[pos + 2] = ((nl >> 8) & 0xFF).to_byte()
      b[pos + 3] = (nl & 0xFF).to_byte()
    }
    b
  } else if op == 4 {
    // append a random TLV after MI (strip FP, append, re-FP): the classic post-MI injection
    let types = [0x0025, 0x0006, 0x0020, 0x0008, 0x8028, 0x0009, 0x7FFF, 0x802A]
    let t = types[rng.below(types.length())]
    let vl = rng.below(24)
    let tlv = Bytes::new(4 + ((vl + 3) & -4))
    tlv[0] = ((t >> 8) & 0xFF).to_byte()
    tlv[1] = (t & 0xFF).to_byte()
    tlv[3] = vl.to_byte()
    let mut i = 0
    while i < vl {
      tlv[4 + i] = rng.below(256).to_byte()
      i = i + 1
    }
    let body = if b.length() >= 28 { b.slice(0, b.length() - 8) } else { b }
    let c = concat(body, tlv)
    fix_len(c)
    if rng.below(2) == 0 { with_fp(c) } else { c }
  } else if op == 5 {
    // duplicate the whole attribute section (two MI, two FP ...)
    let c = concat(b, b.slice(20, b.length()))
    fix_len(c)
    c
  } else if op == 6 {
    let n = 20 + 4 * rng.below(60)
    let r = Bytes::new(n)
    let mut i = 0
    while i < n {
      r[i] = rng.below(256).to_byte()
      i = i + 1
    }
    r[0] = (r[0].to_int() & 0x01).to_byte()
    r[4] = (0x21).to_byte()
    r[5] = (0x12).to_byte()
    r[6] = (0xA4).to_byte()
    r[7] = (0x42).to_byte()
    fix_len(r)
    r
  } else if op == 7 {
    // attribute bomb: up to 16383 zero-length attributes (64 KiB)
    let cnt = 1 + rng.below(16383)
    let r = Bytes::new(20 + 4 * cnt)
    blit(r, 0, b, 0, 20)
    let t = if rng.below(2) == 0 { 0x8022 } else { 0x0025 }
    let mut i = 0
    while i < cnt {
      r[20 + 4 * i] = ((t >> 8) & 0xFF).to_byte()
      r[21 + 4 * i] = (t & 0xFF).to_byte()
      i = i + 1
    }
    fix_len(r)
    r
  } else if op == 8 {
    // one huge attribute (value up to 65528) inside a max-size message
    let vl = 4092 + rng.below(65528 - 4092)
    let r = Bytes::new(20 + 4 + ((vl + 3) & -4))
    blit(r, 0, b, 0, 20)
    r[20] = (0x80).to_byte()
    r[21] = (0x22).to_byte()
    r[22] = ((vl >> 8) & 0xFF).to_byte()
    r[23] = (vl & 0xFF).to_byte()
    fix_len(r)
    if rng.below(2) == 0 { with_fp(r) } else { r }
  } else if op == 9 {
    b[0] = (b[0].to_int() | ((1 + rng.below(3)) << 6)).to_byte()
    b
  } else {
    // splice two seeds
    let o = seeds[rng.below(seeds.length())]
    let cut = 20 + rng.below(if b.length() > 20 { b.length() - 20 } else { 1 })
    let cut2 = 20 + rng.below(if o.length() > 20 { o.length() - 20 } else { 1 })
    let c = concat(b.slice(0, if cut < b.length() { cut } else { b.length() }), o.slice(if cut2 < o.length() { cut2 } else { o.length() }, o.length()))
    if rng.below(2) == 0 {
      fix_len(c)
    }
    c
  }
}

///|
fn fuzz_one(agent : stun::IceAgent, raw : Bytes, key : Bytes) -> String {
  let a = if stun::is_stun_packet(raw) { "S" } else { "n" }
  let b = match stun::decode_message(raw) {
    Ok(m) => "o" + m.attributes.length().to_string()
    Err(e) => {
      let s = stun::stun_error_message(e)
      "e" + s.slice(0, if s.length() < 6 { s.length() } else { 6 }).to_string()
    }
  }
  let c = decode_line(raw, key)
  let d = match agent.handle_inbound(raw, stun::socket_addr_ipv4(192, 168, 1, 10, 50000)) {
    Ok(stun::IceInboundResult::SendResponse(w, _)) => "R" + w.length().to_string()
    Ok(stun::IceInboundResult::PairSucceeded(i, _)) => "P" + i.to_string()
    Ok(stun::IceInboundResult::PairFailed(i, c)) => "F" + i.to_string() + "/" + c.to_string()
    Ok(stun::IceInboundResult::Ignored(_)) => "I"
    Err(_) => "E"
  }
  a + "|" + b + "|" + c + "|" + d
}

///|
fn run_fuzz(world : World, seed : Int, n : Int, dump : Bool) -> Int {
  let key = stun::string_to_utf8_bytes(fuzz_key)
  let seeds = seed_corpus()
  let rng = Rng::{ s: seed.to_int64().to_uint64() * 0x9E3779B97F4A7C15UL + 1UL }
  // agent whose local pwd = fuzz key and remote ufrag matches the seed USERNAME, so mutated
  // requests reach the authenticated paths
  let agent = stun::IceAgent::new(stun::IceRole::Controlled, 7UL, "uFz", fuzz_key, false)
  agent.set_remote_credentials("uPeer", fuzz_key)
  let _ = agent.add_local_candidate("l", 1, stun::socket_addr_ipv4(10, 0, 0, 1, 1), stun::CandidateType::Host, 65535)
  let _ = agent.add_remote_candidate("r", 1, stun::socket_addr_ipv4(192, 168, 1, 10, 50000), stun::CandidateType::Host, 1U)
  let h = crypto::Sha256::new()
  let sb = StringBuilder::new()
  let mut decoded = 0
  let mut mi_ok = 0
  let mut responses = 0
  let mut i = 0
  while i < n {
    let raw = mutate(rng, seeds)
    if dump {
      sb.write_string("fz" + i.to_string() + "\t" + to_hex(raw) + "\t" + to_hex(key) + "\n")
      if sb.to_string().length() > (1 << 22) {
        io_print(world, sb.to_string())
        sb.reset()
      }
    } else {
      let r = fuzz_one(agent, raw, key)
      if r.code_unit_at(2) == 111 {
        decoded = decoded + 1
      }
      if r.contains("MI=true") {
        mi_ok = mi_ok + 1
      }
      if r.contains("|R") {
        responses = responses + 1
      }
      h.update(stun::string_to_utf8_bytes(r + "\n"))
    }
    i = i + 1
  }
  if dump {
    io_print(world, sb.to_string())
  } else {
    io_println(world, "fuzz seed=" + seed.to_string() + " n=" + n.to_string() + " decoded=" + decoded.to_string() + " mi_ok=" + mi_ok.to_string() + " responses=" + responses.to_string() + " sha256=" + h.finalize_hex())
  }
  0
}

// ---------------------------------------------------------------------------
// dos
// ---------------------------------------------------------------------------

///|
fn run_dos(world : World, args : Array[String]) -> Int {
  let what = args[2]
  let t0 = clock_now_ms(world)
  if what == "cands" {
    let l = parse_int(args[3])
    let r = parse_int(args[4])
    let a = stun::IceAgent::new(stun::IceRole::Controlling, 1UL, "u", "p" + fuzz_key, false)
    let mut i = 0
    while i < l {
      let _ = a.add_local_candidate("l", 1, stun::socket_addr_ipv4(10, 0, (i >> 8) & 0xFF, i & 0xFF, 1000), stun::CandidateType::Host, 65535 - (i & 0xFFFF))
      i = i + 1
    }
    let mut j = 0
    while j < r {
      let _ = a.add_remote_candidate("r", 1, stun::socket_addr_ipv4(1, (j >> 16) & 0xFF, (j >> 8) & 0xFF, j & 0xFF, 9), stun::CandidateType::Host, (j + 1).to_uint())
      j = j + 1
    }
    io_println(world, "dos cands L=" + l.to_string() + " R=" + r.to_string() + " pairs=" + a.pairs.length().to_string() + " ms=" + (clock_now_ms(world) - t0).to_string())
  } else if what == "attrs" {
    let cnt = parse_int(args[3])
    let raw = Bytes::new(20 + 4 * cnt)
    raw[4] = (0x21).to_byte()
    raw[5] = (0x12).to_byte()
    raw[6] = (0xA4).to_byte()
    raw[7] = (0x42).to_byte()
    let mut i = 0
    while i < cnt {
      raw[20 + 4 * i] = (0x80).to_byte()
      raw[21 + 4 * i] = (0x22).to_byte()
      i = i + 1
    }
    fix_len(raw)
    let lifted = stun::DecodeLimits::new(65552, 1000000, 65535)
    let n_def = match stun::decode_message(raw) {
      Ok(m) => m.attributes.length().to_string()
      Err(e) => stun::stun_error_message(e)
    }
    let n_lift = match stun::decode_message_with_limits(raw, lifted) {
      Ok(m) => m.attributes.length().to_string()
      Err(e) => stun::stun_error_message(e)
    }
    io_println(world, "dos attrs n=" + cnt.to_string() + " default=[" + n_def + "] lifted=" + n_lift + " ms=" + (clock_now_ms(world) - t0).to_string())
  } else if what == "big" {
    let iters = parse_int(args[3])
    let vl = 65532 - 4 - 24 - 8
    let m = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, Bytes::new(12))
    m.add(stun::Attribute::Unknown(0x8022, Bytes::new(vl)))
    let key = stun::string_to_utf8_bytes(fuzz_key)
    let raw = match stun::encode_message_signed(m, Some(key), false, true) {
      Ok(w) => w
      Err(_) => Bytes::new(0)
    }
    let lifted = stun::DecodeLimits::new(65552, 64, 65535)
    let mut ok = 0
    let mut i = 0
    while i < iters {
      match stun::decode_message_with_limits(raw, lifted) {
        Ok(_) => ok = ok + 1
        Err(_) => ()
      }
      match stun::verify_message_integrity(raw, key) {
        Ok(true) => ok = ok + 1
        _ => ()
      }
      match stun::verify_fingerprint(raw) {
        Ok(true) => ok = ok + 1
        _ => ()
      }
      i = i + 1
    }
    io_println(world, "dos big bytes=" + raw.length().to_string() + " iters=" + iters.to_string() + " ok=" + ok.to_string() + " ms=" + (clock_now_ms(world) - t0).to_string())
  } else if what == "inbound" {
    let r = parse_int(args[3])
    let iters = parse_int(args[4])
    let a = stun::IceAgent::new(stun::IceRole::Controlled, 1UL, "uFz", fuzz_key, false)
    a.set_remote_credentials("uPeer", fuzz_key)
    let _ = a.add_local_candidate("l", 1, stun::socket_addr_ipv4(10, 0, 0, 1, 1), stun::CandidateType::Host, 65535)
    let mut j = 0
    while j < r {
      let _ = a.add_remote_candidate("r", 1, stun::socket_addr_ipv4(1, (j >> 16) & 0xFF, (j >> 8) & 0xFF, j & 0xFF, 9), stun::CandidateType::Host, (j + 1).to_uint())
      j = j + 1
    }
    let t1 = clock_now_ms(world)
    // authenticated success responses with unknown tx ids: each is a full linear scan of the pairs
    let key = stun::string_to_utf8_bytes(fuzz_key)
    let resp = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, Bytes::new(12))
    resp.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(1, 1, 1, 1, 1)))
    let w = match stun::encode_message_signed(resp, Some(key), false, true) {
      Ok(x) => x
      Err(_) => Bytes::new(0)
    }
    let mut ign = 0
    let mut i = 0
    while i < iters {
      match a.handle_inbound(w, stun::socket_addr_ipv4(1, 0, 0, 1, 9)) {
        Ok(stun::IceInboundResult::Ignored(_)) => ign = ign + 1
        _ => ()
      }
      i = i + 1
    }
    io_println(world, "dos inbound pairs=" + a.pairs.length().to_string() + " build_ms=" + (t1 - t0).to_string() + " iters=" + iters.to_string() + " ignored=" + ign.to_string() + " ms=" + (clock_now_ms(world) - t1).to_string())
  } else {
    io_eprintln(world, "unknown dos mode")
    return 2
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  if mode == "decode" && args.length() > 2 {
    run_decode(world, args[2])
  } else if mode == "encode" && args.length() > 2 {
    run_encode(world, args[2])
  } else if mode == "fuzz" && args.length() > 3 {
    run_fuzz(world, parse_int(args[2]), parse_int(args[3]), args.length() > 4 && args[4] == "dump")
  } else if mode == "dos" && args.length() > 3 {
    run_dos(world, args)
  } else {
    io_eprintln(world, "usage: oracle decode <tsv> | encode <tsv> | fuzz <seed> <n> [dump] | dos cands|attrs|big|inbound ...")
    2
  }
}
