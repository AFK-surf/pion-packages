///| Red-team CONTROL tests for `packages/stun` @ d31e5fd (feat/pkg-stun).
///|
///| Every `control_*` test pins an attack or malformed input the package already defeats.
///| They MUST PASS on the audited baseline and after any fix (regression guard).
///| The failing evidence for confirmed findings lives in `redteam_test.pion` (`p1_*` / `p2_*`).

import "stun"
import "crypto"

///|
fn expect_err(raw : Bytes, what : String) -> Unit {
  match stun::decode_message(raw) {
    Ok(_) => debug_assert(false, "decoder accepted " + what)
    Err(_) => ()
  }
}

///|
fn tx0() -> Bytes {
  hx("0102030405060708090a0b0c")
}

// ---------------------------------------------------------------------------
// A. Header / framing
// ---------------------------------------------------------------------------

///|
test "control_header_malformations_rejected" {
  let good = raw_msg(0x0001, tx0(), tlv(0x8022, ascii("abc")))
  match stun::decode_message(good) {
    Ok(m) => debug_assert(m.attributes.length() == 1, "good baseline decodes")
    Err(e) => debug_assert(false, "baseline: " + stun::stun_error_message(e))
  }
  // top two bits 01 / 10 / 11 (RTP/DTLS/TURN-channel style first byte)
  let mut tb = 0x40
  while tb <= 0xC0 {
    let b = copy_bytes(good)
    b[0] = tb.to_byte()
    expect_err(b, "top bits " + tb.to_string())
    debug_assert(!stun::is_stun_packet(b), "is_stun_packet must reject top bits")
    tb = tb + 0x40
  }
  // wrong magic cookie (RFC 3489 classic STUN)
  let c = copy_bytes(good)
  c[4] = (0x21).to_byte()
  c[7] = (0x43).to_byte()
  match stun::decode_message(c) {
    Err(stun::StunError::InvalidMagicCookie(_)) => ()
    _ => debug_assert(false, "cookie must be rejected")
  }
  // length not multiple of 4
  let l = copy_bytes(good)
  l[3] = (l[3].to_int() + 1).to_byte()
  expect_err(l, "len%4")
  // declared length > actual, < actual, trailing garbage
  let longer = copy_bytes(good)
  longer[3] = (longer[3].to_int() + 4).to_byte()
  expect_err(longer, "declared > actual")
  let trailing = cat2(good, hx("00000000"))
  expect_err(trailing, "trailing garbage")
  debug_assert(!stun::is_stun_packet(trailing), "demux rejects trailing garbage")
  // < 20 bytes
  expect_err(prefix(good, 19), "19-byte header")
  expect_err(Bytes::new(0), "empty")
  // attribute header truncated / value beyond boundary / 0xFFFF attr length
  expect_err(fix_len(cat2(raw_msg(1, tx0(), Bytes::new(0)), hx("8022"))), "2-byte attr header")
  expect_err(raw_msg(1, tx0(), hx("80220010616263")), "attr len > remaining")
  expect_err(raw_msg(1, tx0(), cat2(hx("8022ffff"), Bytes::new(64))), "0xFFFF attr length")
  // padding overflowing the message (len 3, no pad bytes)
  expect_err(raw_msg(1, tx0(), hx("80220003616263")), "missing padding")
  // empty message body is legal
  match stun::decode_message(raw_msg(1, tx0(), Bytes::new(0))) {
    Ok(m) => debug_assert(m.attributes.length() == 0, "empty body")
    Err(_) => debug_assert(false, "empty body must decode")
  }
}

///|
test "control_decode_limits_semantics" {
  let good = raw_msg(1, tx0(), cat2(tlv(0x8022, ascii("abcd")), tlv(0x8022, ascii("efgh"))))
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(-1, 10, 10)) {
    Err(stun::StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_message_bytes")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, -1, 10)) {
    Err(stun::StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_attributes")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, 10, -5)) {
    Err(stun::StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_attribute_bytes")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, 0, 10)) {
    Err(stun::StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attributes=0 must reject any attribute")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, 1, 10)) {
    Err(stun::StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attributes=1 vs 2 attrs")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, 2, 4)) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "exact limits must pass")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(1000, 2, 3)) {
    Err(stun::StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attribute_bytes=3 vs 4")
  }
  match stun::decode_message_with_limits(good, stun::DecodeLimits::new(good.length() - 1, 2, 4)) {
    Err(stun::StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_message_bytes")
  }
  match stun::decode_message_with_limits(raw_msg(1, tx0(), Bytes::new(0)), stun::DecodeLimits::new(0, 0, 0)) {
    Err(stun::StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_message_bytes=0 must reject a 20-byte message")
  }
}

// ---------------------------------------------------------------------------
// B. Address attributes
// ---------------------------------------------------------------------------

///|
test "control_address_attribute_shapes" {
  // MAPPED (0x0001) and XOR-MAPPED (0x0020): bad lengths & families rejected
  let types = [0x0001, 0x0020]
  let mut t = 0
  while t < 2 {
    let ty = types[t]
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("0001"))), "addr len 2")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00011234c0a801"))), "v4 len 7")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00011234c0a8010100"))), "v4 len 9")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00011234c0a80101000000000000000000000000"))), "v4 len 20")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00021234c0a80101"))), "v6 len 8")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00001234c0a80101"))), "family 0")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00031234c0a80101"))), "family 3")
    expect_err(raw_msg(0x0101, tx0(), tlv(ty, hx("00ff1234c0a80101"))), "family ff")
    t = t + 1
  }
  // non-zero reserved first byte is ignored (RFC 8489 §14.1 "MUST be ignored")
  match stun::decode_message(raw_msg(0x0101, tx0(), tlv(0x0001, hx("ff011234c0a80101")))) {
    Ok(m) => {
      match m.attributes[0] {
        stun::Attribute::MappedAddress(a) => {
          debug_assert(stun::socket_addr_eq(a, stun::socket_addr_ipv4(192, 168, 1, 1, 0x1234)), "reserved byte ignored")
        }
        _ => debug_assert(false, "mapped")
      }
    }
    Err(_) => debug_assert(false, "reserved byte must be ignored")
  }
}

///|
test "control_xor_address_roundtrip_edges" {
  let tx = hx("b7e7a701bc34d686fa87dfae")
  let v4 : Array[stun::SocketAddr] = [
    stun::socket_addr_ipv4(0, 0, 0, 0, 0),
    stun::socket_addr_ipv4(255, 255, 255, 255, 65535),
    stun::socket_addr_ipv4(127, 0, 0, 1, 1),
    stun::socket_addr_ipv4(0x21, 0x12, 0xA4, 0x42, 0x2112),
    stun::socket_addr_ipv6(hx("00000000000000000000000000000000"), 0),
    stun::socket_addr_ipv6(hx("ffffffffffffffffffffffffffffffff"), 65535),
    stun::socket_addr_ipv6(hx("00000000000000000000000000000001"), 3478),
    stun::socket_addr_ipv6(hx("2112a442b7e7a701bc34d686fa87dfae"), 0x2112),
  ]
  let mut i = 0
  while i < v4.length() {
    let m = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
    m.add(stun::Attribute::XorMappedAddress(v4[i]))
    m.add(stun::Attribute::MappedAddress(v4[i]))
    match stun::encode_message(m) {
      Ok(w) => {
        match stun::decode_message(w) {
          Ok(d) => {
            match (d.attributes[0], d.attributes[1]) {
              (stun::Attribute::XorMappedAddress(a), stun::Attribute::MappedAddress(b)) => {
                debug_assert(stun::socket_addr_eq(a, v4[i]), "xor roundtrip " + i.to_string())
                debug_assert(stun::socket_addr_eq(b, v4[i]), "plain roundtrip " + i.to_string())
              }
              _ => debug_assert(false, "shape")
            }
          }
          Err(_) => debug_assert(false, "decode")
        }
      }
      Err(_) => debug_assert(false, "encode")
    }
    i = i + 1
  }
  // RFC 5769 §2.2 XOR-MAPPED-ADDRESS bytes for 192.0.2.1:32853
  let w = raw_msg(0x0101, tx, tlv(0x0020, hx("0001a147e112a643")))
  match stun::decode_message(w) {
    Ok(d) => {
      match d.attributes[0] {
        stun::Attribute::XorMappedAddress(a) => debug_assert(stun::socket_addr_eq(a, stun::socket_addr_ipv4(192, 0, 2, 1, 32853)), "5769 v4")
        _ => debug_assert(false, "5769 v4 shape")
      }
    }
    Err(_) => debug_assert(false, "5769 v4 decode")
  }
}

// ---------------------------------------------------------------------------
// C. Integrity / fingerprint
// ---------------------------------------------------------------------------

///|
test "control_integrity_length_patching_and_tamper" {
  let key = ascii("VOkJxbRl1RmTxUk/WvJxBt")
  let m = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx0())
  m.add(stun::Attribute::Username("evtj:h6vY"))
  m.add(stun::Attribute::Software("STUN test client"))
  let with_fp = match stun::encode_message_signed(m, Some(key), false, true) {
    Ok(w) => w
    Err(_) => {
      debug_assert(false, "encode")
      return
    }
  }
  let no_fp = match stun::encode_message_signed(m, Some(key), false, false) {
    Ok(w) => w
    Err(_) => {
      debug_assert(false, "encode")
      return
    }
  }
  // MI computed over the length up to MI (not the outer length incl. FINGERPRINT)
  debug_assert(vt(stun::verify_message_integrity(with_fp, key)) == "true", "MI + FP verifies")
  debug_assert(vt(stun::verify_message_integrity(no_fp, key)) == "true", "MI alone verifies")
  debug_assert(vt(stun::verify_fingerprint(with_fp)) == "true", "FP verifies")
  // MI bytes of both encodings identical (length-adjusted HMAC)
  let mi_off = no_fp.length() - 20
  let mut same = true
  let mut i = 0
  while i < 20 {
    if with_fp[mi_off + i] != no_fp[mi_off + i] {
      same = false
    }
    i = i + 1
  }
  debug_assert(same, "MI identical with/without FINGERPRINT")
  // every single-byte flip outside the FP-only region breaks MI (or framing)
  let mut p = 0
  while p < no_fp.length() {
    let t = copy_bytes(no_fp)
    t[p] = (t[p].to_int() ^ 0x01).to_byte()
    match stun::verify_message_integrity(t, key) {
      Ok(true) => debug_assert(false, "flip at " + p.to_string() + " still verifies")
      _ => ()
    }
    p = p + 1
  }
  // wrong key, empty key, truncated MI attribute (len 19 / 21)
  debug_assert(vt(stun::verify_message_integrity(no_fp, ascii("VOkJxbRl1RmTxUk/WvJxBu"))) == "false", "wrong key")
  debug_assert(vt(stun::verify_message_integrity(no_fp, Bytes::new(0))) == "false", "empty key")
  let bad_mi = raw_msg(1, tx0(), tlv(0x0008, Bytes::new(19)))
  match stun::verify_message_integrity(bad_mi, key) {
    Ok(true) => debug_assert(false, "19-byte MI verified")
    _ => ()
  }
  expect_err(bad_mi, "19-byte MI")
  expect_err(raw_msg(1, tx0(), tlv(0x0008, Bytes::new(21))), "21-byte MI")
  expect_err(raw_msg(1, tx0(), tlv(0x001C, Bytes::new(19))), "19-byte MI-SHA256")
  expect_err(raw_msg(1, tx0(), tlv(0x8028, Bytes::new(3))), "3-byte FP")
  // no MI -> Ok(false) (never true)
  debug_assert(vt(stun::verify_message_integrity(raw_msg(1, tx0(), Bytes::new(0)), key)) == "false", "absent MI")
}

///|
test "control_fingerprint_position_and_duplicates" {
  let base = raw_msg(1, tx0(), tlv(0x8022, ascii("abcd")))
  let fp1 = add_fp(base)
  debug_assert(vt(stun::verify_fingerprint(fp1)) == "true", "single FP")
  // attribute after FINGERPRINT
  let after = fix_len(cat2(fp1, tlv(0x8022, ascii("evil"))))
  match stun::verify_fingerprint(after) {
    Ok(true) => debug_assert(false, "FP not last accepted")
    _ => ()
  }
  // two FINGERPRINTs (both valid for their own prefix)
  let two = add_fp(fp1)
  match stun::verify_fingerprint(two) {
    Ok(true) => debug_assert(false, "duplicate FP accepted")
    _ => ()
  }
  // corrupted CRC
  let bad = copy_bytes(fp1)
  bad[bad.length() - 1] = (bad[bad.length() - 1].to_int() ^ 1).to_byte()
  debug_assert(vt(stun::verify_fingerprint(bad)) == "false", "bad CRC")
}

///|
test "control_sha256_integrity_roundtrip_and_long_keys" {
  let mut klen = 0
  while klen <= 200 {
    let key = Bytes::new(klen)
    let mut i = 0
    while i < klen {
      key[i] = ((i * 7 + 3) & 0xFF).to_byte()
      i = i + 1
    }
    let m = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx0())
    m.add(stun::Attribute::Username("a:b"))
    match stun::encode_message_signed(m, Some(key), true, true) {
      Ok(w) => {
        debug_assert(vt(stun::verify_message_integrity_sha256(w, key)) == "true", "sha256 klen " + klen.to_string())
        debug_assert(vt(stun::verify_fingerprint(w)) == "true", "fp")
        let k2 = copy_bytes(key)
        if klen > 0 {
          k2[0] = (k2[0].to_int() ^ 1).to_byte()
          debug_assert(vt(stun::verify_message_integrity_sha256(w, k2)) == "false", "sha256 wrong key")
        }
      }
      Err(_) => debug_assert(false, "encode sha256")
    }
    match stun::encode_message_signed(m, Some(key), false, true) {
      Ok(w) => debug_assert(vt(stun::verify_message_integrity(w, key)) == "true", "sha1 klen " + klen.to_string())
      Err(_) => debug_assert(false, "encode sha1")
    }
    klen = klen + 1
  }
}

///|
test "control_crypto_primitives_reference_vectors" {
  // RFC 2202 HMAC-SHA1 #1 and #6 (80-byte key > block size -> key hashed first)
  debug_assert(
    crypto::bytes_to_hex(stun::hmac_sha1(hx("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), ascii("Hi There"))) ==
    "b617318655057264e28bc0b6fb378c8ef146be00",
    "rfc2202 #1",
  )
  let k80 = Bytes::new(80)
  let mut i = 0
  while i < 80 {
    k80[i] = (0xAA).to_byte()
    i = i + 1
  }
  debug_assert(
    crypto::bytes_to_hex(stun::hmac_sha1(k80, ascii("Test Using Larger Than Block-Size Key - Hash Key First"))) ==
    "aa4ae5e15272d00e95705637ce8a3b55ed402112",
    "rfc2202 #6",
  )
  // 64 / 65 byte and empty keys (python hmac reference)
  debug_assert(crypto::bytes_to_hex(stun::hmac_sha1(prefix(k80, 64), ascii("x"))) == "9c6d8ea88eaae0dda58c8f4a0f8e9a190edc28e4", "k64")
  debug_assert(crypto::bytes_to_hex(stun::hmac_sha1(prefix(k80, 65), ascii("x"))) == "349e9189de217e47242c1aaa2acfe9084d584f3f", "k65")
  debug_assert(crypto::bytes_to_hex(stun::hmac_sha1(Bytes::new(0), ascii("x"))) == "6244e66451a1c8695db9731ce2c4fd5de25ccf87", "k0")
  // RFC 1321 MD5 + block-boundary lengths (python hashlib reference)
  debug_assert(crypto::bytes_to_hex(stun::md5(Bytes::new(0))) == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty")
  debug_assert(crypto::bytes_to_hex(stun::md5(ascii("abc"))) == "900150983cd24fb0d6963f7d28e17f72", "md5 abc")
  debug_assert(crypto::bytes_to_hex(stun::md5(ascii("message digest"))) == "f96b697d7cb7938d525a2f31aaf161d0", "md5 md")
  let lens = [55, 56, 63, 64, 65, 119, 120]
  let want = [
    "ef1772b6dff9a122358552954ad0df65", "3b0c8ac703f828b04c6c197006d17218", "b06521f39153d618550606be297466d5",
    "014842d480b571495a4a0363793f7367", "c743a45e0d2e6a95cb859adae0248435", "8a7bd0732ed6a28ce75f6dabc90e1613",
    "5f61c0ccad4cac44c75ff505e1f1e537",
  ]
  let mut j = 0
  while j < lens.length() {
    let a = Bytes::new(lens[j])
    let mut k = 0
    while k < lens[j] {
      a[k] = (0x61).to_byte()
      k = k + 1
    }
    debug_assert(crypto::bytes_to_hex(stun::md5(a)) == want[j], "md5 a*" + lens[j].to_string())
    j = j + 1
  }
  // CRC-32/ISO-HDLC check value
  debug_assert(stun::crc32_ieee(ascii("123456789"), 0, 9) == 0xCBF43926U, "crc32 check")
  // constant-time compare semantics
  debug_assert(!stun::verify_ct_eq(hx("00"), hx("0000")), "ct len")
  debug_assert(!stun::verify_ct_eq(hx("0001"), hx("0000")), "ct last byte")
  debug_assert(stun::verify_ct_eq(Bytes::new(0), Bytes::new(0)), "ct empty")
}

// ---------------------------------------------------------------------------
// D. Typed attribute validation
// ---------------------------------------------------------------------------

///|
test "control_typed_attribute_lengths" {
  expect_err(raw_msg(1, tx0(), tlv(0x0024, hx("000000"))), "PRIORITY len 3")
  expect_err(raw_msg(1, tx0(), tlv(0x0024, hx("0000000000"))), "PRIORITY len 5")
  expect_err(raw_msg(1, tx0(), tlv(0x0025, hx("00000000"))), "USE-CANDIDATE len 4")
  expect_err(raw_msg(1, tx0(), tlv(0x802A, hx("00000000000000"))), "ICE-CONTROLLING len 7")
  expect_err(raw_msg(1, tx0(), tlv(0x8029, hx("000000000000000000"))), "ICE-CONTROLLED len 9")
  expect_err(raw_msg(1, tx0(), tlv(0x000A, hx("000100"))), "UNKNOWN-ATTRIBUTES odd")
  expect_err(raw_msg(0x0111, tx0(), tlv(0x0009, hx("000002"))), "ERROR-CODE len 3")
  expect_err(raw_msg(0x0111, tx0(), tlv(0x0009, hx("00000200"))), "ERROR-CODE class 2")
  expect_err(raw_msg(0x0111, tx0(), tlv(0x0009, hx("00000700"))), "ERROR-CODE class 7")
  expect_err(raw_msg(0x0111, tx0(), tlv(0x0009, hx("00000464"))), "ERROR-CODE number 100")
  match stun::decode_message(raw_msg(0x0111, tx0(), tlv(0x0009, cat2(hx("00000457"), ascii("Role Conflict"))))) {
    Ok(m) => {
      match m.attributes[0] {
        stun::Attribute::ErrorCode(ec) => debug_assert(ec.code == 487 && ec.reason == "Role Conflict", "487")
        _ => debug_assert(false, "487 shape")
      }
    }
    Err(_) => debug_assert(false, "487 decode")
  }
  // reserved high bits of class byte are masked, not mis-multiplied (0xFC|4 -> class 4)
  match stun::decode_message(raw_msg(0x0111, tx0(), tlv(0x0009, hx("fffffc01")))) {
    Ok(m) => {
      match m.attributes[0] {
        stun::Attribute::ErrorCode(ec) => debug_assert(ec.code == 401, "masked class")
        _ => debug_assert(false, "shape")
      }
    }
    Err(_) => debug_assert(false, "reserved bits must be ignored")
  }
  // encoder refuses out-of-range values
  let m = stun::Message::new(stun::MessageClass::ErrorResponse, stun::MessageMethod::Binding, tx0())
  m.add(stun::Attribute::ErrorCode(stun::ErrorCode::new(700, "x")))
  debug_assert(is_err(stun::encode_message(m)), "encode code 700")
  let m2 = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Other(0x1000), tx0())
  debug_assert(is_err(stun::encode_message(m2)), "13-bit method")
  let m3 = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, hx("0102"))
  debug_assert(is_err(stun::encode_message(m3)), "short tx id")
}

// ---------------------------------------------------------------------------
// E. ICE agent: authentication & transaction binding
// ---------------------------------------------------------------------------

///|
test "control_ice_rejects_unauthenticated_and_offpath" {
  let p = peers(stun::IceRole::Controlling, 10UL, stun::IceRole::Controlled, 20UL)
  // forged request signed with the wrong password + USE-CANDIDATE: no state change
  let forged = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx0())
  forged.add(stun::Attribute::Username("uBob:uAlice"))
  forged.add(stun::Attribute::Priority(1U))
  forged.add(stun::Attribute::IceControlling(10UL))
  forged.add(stun::Attribute::UseCandidate)
  let r = p.bob.handle_inbound(sign(forged, "guessed-password-xxxxxx"), p.alice_addr)
  debug_assert(starts(inbound_kind(r), "err:IntegrityMismatch"), "wrong pwd must be IntegrityMismatch")
  debug_assert(is_none(p.bob.selected_pair()), "no nomination from forged request")
  debug_assert(stun::pair_state_eq(p.bob.pairs[0].state, stun::PairState::Waiting), "pair untouched")
  // unsigned request: rejected
  let unsigned = match stun::encode_message_signed(forged, None, false, true) {
    Ok(w) => w
    Err(_) => Bytes::new(0)
  }
  debug_assert(is_err(p.bob.handle_inbound(unsigned, p.alice_addr)), "unsigned request rejected")
  // wrong USERNAME but correct pwd -> rejected
  let wrong_user = stun::Message::new(stun::MessageClass::Request, stun::MessageMethod::Binding, tx0())
  wrong_user.add(stun::Attribute::Username("uBob:mallory"))
  wrong_user.add(stun::Attribute::UseCandidate)
  debug_assert(is_err(p.bob.handle_inbound(sign(wrong_user, bob_pwd), p.alice_addr)), "wrong username rejected")
  debug_assert(is_none(p.bob.selected_pair()), "still not nominated")
  // Alice sends a check; off-path response with right MI but unknown tx id is ignored
  let w = check_wire(p.alice)
  debug_assert(w.length() > 0, "check")
  let resp = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx0())
  resp.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(6, 6, 6, 6, 6666)))
  let k = inbound_kind(p.alice.handle_inbound(sign(resp, bob_pwd), p.bob_addr))
  debug_assert(k == "ignored:unknown transaction_id", "unknown tx: " + k)
  debug_assert(stun::pair_state_eq(p.alice.pairs[0].state, stun::PairState::InProgress), "still InProgress")
  // response with the right tx id but forged MI -> rejected, still InProgress
  let txid = prefix(hx("000000000000000000000000"), 12)
  let mut i = 0
  while i < 12 {
    txid[i] = w[8 + i]
    i = i + 1
  }
  let resp2 = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, txid)
  resp2.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(6, 6, 6, 6, 6666)))
  debug_assert(is_err(p.alice.handle_inbound(sign(resp2, "not-bobs-password-xxxx"), p.bob_addr)), "forged MI response")
  debug_assert(stun::pair_state_eq(p.alice.pairs[0].state, stun::PairState::InProgress), "forged MI: still InProgress")
  // forged FINGERPRINT -> rejected before anything else
  let bad = copy_bytes(w)
  bad[bad.length() - 1] = (bad[bad.length() - 1].to_int() ^ 1).to_byte()
  debug_assert(starts(inbound_kind(p.bob.handle_inbound(bad, p.alice_addr)), "err:FingerprintMismatch"), "bad FP")
  // non-STUN (RTP / DTLS first byte) ignored
  let rtp = copy_bytes(w)
  rtp[0] = (0x80).to_byte()
  debug_assert(starts(inbound_kind(p.bob.handle_inbound(rtp, p.alice_addr)), "ignored:"), "RTP ignored")
}

///|
test "control_ice_priority_formulas_in_range" {
  // RFC 8445 §5.1.2.1 host / srflx / relay with local_pref 65535, comp 1
  debug_assert(prio_of(stun::compute_candidate_priority(126, 65535, 1)) == 2130706431U, "host")
  debug_assert(prio_of(stun::compute_candidate_priority(100, 65535, 1)) == 1694498815U, "srflx")
  debug_assert(prio_of(stun::compute_candidate_priority(0, 65535, 2)) == 16777214U, "relay comp2")
  debug_assert(is_err(stun::compute_candidate_priority(127, 0, 1)), "type_pref 127")
  debug_assert(is_err(stun::compute_candidate_priority(1, 65536, 1)), "local_pref 65536")
  debug_assert(is_err(stun::compute_candidate_priority(1, 1, 0)), "component 0")
  debug_assert(is_err(stun::compute_candidate_priority(1, 1, 257)), "component 257")
  // RFC 8445 §6.1.2.3 for G, D in 1..2^31-1 (the RFC range)
  let g = 2130706431U
  let d = 1694498815U
  let want : Int64 = 4294967296L * 1694498815L + 2L * 2130706431L + 1L
  debug_assert(stun::compute_pair_priority(g, d) == want, "G>D")
  debug_assert(stun::compute_pair_priority(d, g) == want - 1L, "G<D")
  debug_assert(stun::compute_pair_priority(0x7FFFFFFFU, 0x7FFFFFFFU) == 0x7FFFFFFFL * 4294967296L + 0xFFFFFFFEL, "max RFC")
}
