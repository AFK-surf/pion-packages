///| Shared helpers for the `packages/stun` red-team audit tests (audit-only code, never shipped).
///| Raw STUN wire surgery the way an on-path attacker does it: strip / append attributes after
///| MESSAGE-INTEGRITY, patch the header length and recompute the (unkeyed) FINGERPRINT.

import "stun"
import "crypto"

///|
pub fn hx(h : String) -> Bytes {
  match crypto::hex_to_bytes(h) {
    Some(b) => b
    None => {
      debug_assert(false, "invalid hex literal: " + h)
      Bytes::new(0)
    }
  }
}

///|
pub fn beq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn cat2(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
pub fn prefix(b : Bytes, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b[i]
    i = i + 1
  }
  out
}

///|
pub fn copy_bytes(b : Bytes) -> Bytes {
  prefix(b, b.length())
}

///|
pub fn ascii(s : String) -> Bytes {
  stun::string_to_utf8_bytes(s)
}

///| Rewrite the 16-bit STUN header length to `wire.length() - 20`.
pub fn fix_len(wire : Bytes) -> Bytes {
  let out = copy_bytes(wire)
  let l = out.length() - 20
  out[2] = ((l >> 8) & 0xFF).to_byte()
  out[3] = (l & 0xFF).to_byte()
  out
}

///| Append a FINGERPRINT attribute (header length patched first, as RFC 8489 §14.7 requires).
pub fn add_fp(wire_no_fp : Bytes) -> Bytes {
  let tmp = fix_len(cat2(wire_no_fp, Bytes::new(8)))
  let off = wire_no_fp.length()
  let fp = stun::crc32_ieee(tmp, 0, off) ^ 0x5354554EU
  tmp[off] = (0x80).to_byte()
  tmp[off + 1] = (0x28).to_byte()
  tmp[off + 2] = (0).to_byte()
  tmp[off + 3] = (4).to_byte()
  tmp[off + 4] = ((fp >> 24U) & 0xFFU).to_int().to_byte()
  tmp[off + 5] = ((fp >> 16U) & 0xFFU).to_int().to_byte()
  tmp[off + 6] = ((fp >> 8U) & 0xFFU).to_int().to_byte()
  tmp[off + 7] = (fp & 0xFFU).to_int().to_byte()
  tmp
}

///| Drop a trailing 8-byte FINGERPRINT and fix the header length.
pub fn strip_fp(wire : Bytes) -> Bytes {
  fix_len(prefix(wire, wire.length() - 8))
}

///| On-path attack: take a signed message with MI + FP, append `extra` (raw TLVs) after
///| MESSAGE-INTEGRITY, then re-add a valid FINGERPRINT. No key is needed.
pub fn inject_after_mi(signed_with_fp : Bytes, extra : Bytes) -> Bytes {
  add_fp(fix_len(cat2(prefix(signed_with_fp, signed_with_fp.length() - 8), extra)))
}

///| Raw TLV with zero padding.
pub fn tlv(t : Int, v : Bytes) -> Bytes {
  let n = v.length()
  let padded = (n + 3) & -4
  let out = Bytes::new(4 + padded)
  out[0] = ((t >> 8) & 0xFF).to_byte()
  out[1] = (t & 0xFF).to_byte()
  out[2] = ((n >> 8) & 0xFF).to_byte()
  out[3] = (n & 0xFF).to_byte()
  let mut i = 0
  while i < n {
    out[4 + i] = v[i]
    i = i + 1
  }
  out
}

///| 20-byte header + body (length patched).
pub fn raw_msg(msg_type : Int, tx : Bytes, body : Bytes) -> Bytes {
  let h = Bytes::new(20)
  h[0] = ((msg_type >> 8) & 0xFF).to_byte()
  h[1] = (msg_type & 0xFF).to_byte()
  h[4] = (0x21).to_byte()
  h[5] = (0x12).to_byte()
  h[6] = (0xA4).to_byte()
  h[7] = (0x42).to_byte()
  let mut i = 0
  while i < 12 {
    h[8 + i] = tx[i]
    i = i + 1
  }
  fix_len(cat2(h, body))
}

///| Two-peer fixture: Alice (role_a) and Bob (role_b), one host candidate each, credentials exchanged.
pub struct Peers {
  pub alice : stun::IceAgent
  pub bob : stun::IceAgent
  pub alice_addr : stun::SocketAddr
  pub bob_addr : stun::SocketAddr
}

///|
pub let alice_pwd : String = "pwdAliceSecret1234567890"

///|
pub let bob_pwd : String = "pwdBobSecret0987654321ab"

///|
pub fn peers(role_a : stun::IceRole, tb_a : UInt64, role_b : stun::IceRole, tb_b : UInt64) -> Peers {
  let alice_addr = stun::socket_addr_ipv4(192, 168, 1, 10, 50000)
  let bob_addr = stun::socket_addr_ipv4(198, 51, 100, 20, 60000)
  let alice = stun::IceAgent::new(role_a, tb_a, "uAlice", alice_pwd, false)
  let bob = stun::IceAgent::new(role_b, tb_b, "uBob", bob_pwd, false)
  alice.set_remote_credentials("uBob", bob_pwd)
  bob.set_remote_credentials("uAlice", alice_pwd)
  let _ = alice.add_local_candidate("1", 1, alice_addr, stun::CandidateType::Host, 65535)
  let _ = bob.add_local_candidate("1", 1, bob_addr, stun::CandidateType::Host, 65535)
  let _ = alice.add_remote_candidate("1", 1, bob_addr, stun::CandidateType::Host, bob.local_candidates[0].priority)
  let _ = bob.add_remote_candidate("1", 1, alice_addr, stun::CandidateType::Host, alice.local_candidates[0].priority)
  Peers::{ alice: alice, bob: bob, alice_addr: alice_addr, bob_addr: bob_addr }
}

///| Next connectivity-check wire of `a` (empty on error).
pub fn check_wire(a : stun::IceAgent) -> Bytes {
  match a.next_check() {
    Ok(Some(p)) => p.wire
    _ => Bytes::new(0)
  }
}

///| Classify an inbound result as a short string.
pub fn inbound_kind(r : Result[stun::IceInboundResult, stun::StunError]) -> String {
  match r {
    Ok(stun::IceInboundResult::SendResponse(w, _)) => {
      match stun::decode_message(w) {
        Ok(m) => {
          match m.msg_class {
            stun::MessageClass::SuccessResponse => "send:success"
            stun::MessageClass::ErrorResponse => {
              let mut code = 0
              let mut i = 0
              while i < m.attributes.length() {
                match m.attributes[i] {
                  stun::Attribute::ErrorCode(ec) => code = ec.code
                  _ => ()
                }
                i = i + 1
              }
              "send:error:" + code.to_string()
            }
            _ => "send:other"
          }
        }
        Err(_) => "send:undecodable"
      }
    }
    Ok(stun::IceInboundResult::PairSucceeded(i, _)) => "succeeded:" + i.to_string()
    Ok(stun::IceInboundResult::PairFailed(i, c)) => "failed:" + i.to_string() + ":" + c.to_string()
    Ok(stun::IceInboundResult::Ignored(why)) => "ignored:" + why
    Err(e) => "err:" + stun::stun_error_message(e)
  }
}

///| Build and sign (HMAC-SHA1 short-term key `pwd`, + FINGERPRINT) a message.
pub fn sign(msg : stun::Message, pwd : String) -> Bytes {
  match stun::encode_message_signed(msg, Some(ascii(pwd)), false, true) {
    Ok(w) => w
    Err(e) => {
      debug_assert(false, "sign: " + stun::stun_error_message(e))
      Bytes::new(0)
    }
  }
}

///| "true" / "false" / "err" for a verify_* result.
pub fn vt(r : Result[Bool, stun::StunError]) -> String {
  match r {
    Ok(true) => "true"
    Ok(false) => "false"
    Err(_) => "err"
  }
}

///|
pub fn is_err[T](r : Result[T, stun::StunError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
pub fn prio_of(r : Result[UInt, stun::StunError]) -> UInt {
  match r {
    Ok(v) => v
    Err(_) => 0xFFFFFFFFU
  }
}

///|
pub fn is_none[T](o : Option[T]) -> Bool {
  match o {
    Some(_) => false
    None => true
  }
}

///|
pub fn starts(s : String, p : String) -> Bool {
  if s.length() < p.length() {
    return false
  }
  let mut i = 0
  while i < p.length() {
    if s.code_unit_at(i) != p.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}
