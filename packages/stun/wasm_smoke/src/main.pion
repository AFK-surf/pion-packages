///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/stun`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "stun"
import "crypto"

///|
fn must_hex(h : String) -> Bytes {
  match crypto::hex_to_bytes(h) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
pub fn main(world : World) -> Int {
  // 1. Decode & verify RFC 5769 §2.1 Sample Request
  let req21 = must_hex(
    "000100582112a442b7e7a701bc34d686fa87dfae" +
    "802200105354554e207465737420636c69656e74" +
    "002400046e0001ff80290008932ff9b151263b36" +
    "000600096576746a3a68367659202020" +
    "000800149aeaa70cbfd8cb56781ef2b5b2d3f249c1b571a2" +
    "80280004e57a3bcf",
  )
  let key = stun::string_to_utf8_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  let ok_mi = match stun::verify_message_integrity(req21, key) {
    Ok(v) => v
    Err(_) => return 1
  }
  let ok_fp = match stun::verify_fingerprint(req21) {
    Ok(v) => v
    Err(_) => return 2
  }
  if !ok_mi || !ok_fp || !stun::is_stun_packet(req21) {
    return 3
  }

  // 2. Encode & sign an ICE Binding Success Response (IPv4 + IPv6)
  let tx = must_hex("0102030405060708090a0b0c")
  let m4 = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
  m4.add(stun::Attribute::XorMappedAddress(stun::socket_addr_ipv4(192, 0, 2, 1, 32853)))
  let w4 = match stun::encode_message_signed(m4, Some(key), false, true) {
    Ok(w) => w
    Err(_) => return 4
  }

  let m6 = stun::Message::new(stun::MessageClass::SuccessResponse, stun::MessageMethod::Binding, tx)
  m6.add(
    stun::Attribute::XorMappedAddress(
      stun::socket_addr_ipv6(must_hex("20010db8123456780011223344556677"), 32853),
    ),
  )
  let w6 = match stun::encode_message_signed(m6, Some(key), true, true) {
    Ok(w) => w
    Err(_) => return 5
  }

  // 3. Full Sans-IO ICE handshake
  let alice_addr = stun::socket_addr_ipv4(192, 168, 1, 10, 50000)
  let bob_addr = stun::socket_addr_ipv4(198, 51, 100, 20, 60000)
  let alice = stun::IceAgent::new(stun::IceRole::Controlling, 0x1111UL, "uA", "pwdAliceSmokeSecret12345", true)
  let bob = stun::IceAgent::new(stun::IceRole::Controlled, 0x2222UL, "uB", "pwdBobSmokeSecret0987654", false)
  alice.set_remote_credentials("uB", "pwdBobSmokeSecret0987654")
  bob.set_remote_credentials("uA", "pwdAliceSmokeSecret12345")
  let _ = alice.add_local_candidate("1", 1, alice_addr, stun::CandidateType::Host, 65535)
  let _ = bob.add_local_candidate("1", 1, bob_addr, stun::CandidateType::Host, 65535)
  let _ = alice.add_remote_candidate("1", 1, bob_addr, stun::CandidateType::Host, bob.local_candidates[0].priority)
  let _ = bob.add_remote_candidate("1", 1, alice_addr, stun::CandidateType::Host, alice.local_candidates[0].priority)

  let check = match alice.next_check() {
    Ok(Some(c)) => c
    _ => return 6
  }
  let resp = match bob.handle_inbound(check.wire, alice_addr) {
    Ok(stun::IceInboundResult::SendResponse(w, _)) => w
    _ => return 7
  }
  match alice.handle_inbound(resp, bob_addr) {
    Ok(stun::IceInboundResult::PairSucceeded(0, _)) => ()
    _ => return 8
  }

  // 4. Reject negative DecodeLimits
  match stun::decode_message_with_limits(req21, stun::DecodeLimits::new(-1, 10, 100)) {
    Err(stun::StunError::InvalidLimits(_)) => ()
    _ => return 9
  }

  io_println(world, "stun_wasm_smoke:ok")
  io_println(world, "w4_sha256=" + crypto::sha256_hex(w4))
  io_println(world, "w6_sha256=" + crypto::sha256_hex(w6))
  io_println(world, "ice_check_sha256=" + crypto::sha256_hex(check.wire))
  io_println(world, "ice_resp_sha256=" + crypto::sha256_hex(resp))
  0
}
