///| RFC 5769 Official Test Vectors, RFC 8489 STUN Codec & Security Tests,
///| RFC 7983 Demux Tests, and RFC 8445 Sans-IO ICE Handshake Tests.

import "crypto"

///|
fn must_hex(h : String) -> Bytes {
  match crypto::hex_to_bytes(h) {
    Some(b) => b
    None => {
      debug_assert(false, "invalid hex literal")
      Bytes::new(0)
    }
  }
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn str_to_bytes(s : String) -> Bytes {
  let n = s.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (s.code_unit_at(i) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
test "rfc5769_2_1_sample_request" {
  // RFC 5769 Section 2.1: Sample Request
  // Software: "STUN test client", Username: "evtj:h6vY", Password: "VOkJxbRl1RmTxUk/WvJxBt"
  let raw = must_hex(
    "00010058" +
    "2112a442" +
    "b7e7a701bc34d686fa87dfae" +
    "80220010" +
    "5354554e207465737420636c69656e74" +
    "00240004" +
    "6e0001ff" +
    "80290008" +
    "932ff9b151263b36" +
    "00060009" +
    "6576746a3a68367659202020" +
    "00080014" +
    "9aeaa70cbfd8cb56781ef2b5b2d3f249c1b571a2" +
    "80280004" +
    "e57a3bcf",
  )

  debug_assert(is_stun_packet(raw), "RFC 5769 2.1 must be detected as STUN")

  let msg = match decode_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode failed: " + stun_error_message(e))
      return
    }
  }
  debug_assert(message_class_eq(msg.msg_class, MessageClass::Request), "Request class")
  debug_assert(message_method_eq(msg.method, MessageMethod::Binding), "Binding method")
  debug_assert(bytes_eq(msg.transaction_id, must_hex("b7e7a701bc34d686fa87dfae")), "tx id")
  debug_assert(msg.attributes.length() == 6, "6 attributes")

  match msg.attributes[0] {
    Attribute::Software(s) => debug_assert(s == "STUN test client", "software")
    _ => debug_assert(false, "attr 0 must be Software")
  }
  match msg.attributes[1] {
    Attribute::Priority(p) => debug_assert(p == 0x6e0001ffU, "priority")
    _ => debug_assert(false, "attr 1 must be Priority")
  }
  match msg.attributes[2] {
    Attribute::IceControlled(v) => debug_assert(v == 0x932ff9b151263b36UL, "ice-controlled")
    _ => debug_assert(false, "attr 2 must be IceControlled")
  }
  match msg.attributes[3] {
    Attribute::Username(u) => debug_assert(u == "evtj:h6vY", "username")
    _ => debug_assert(false, "attr 3 must be Username")
  }
  match msg.attributes[4] {
    Attribute::MessageIntegrity(mi) => {
      debug_assert(
        bytes_eq(mi, must_hex("9aeaa70cbfd8cb56781ef2b5b2d3f249c1b571a2")),
        "MI bytes",
      )
    }
    _ => debug_assert(false, "attr 4 must be MessageIntegrity")
  }
  match msg.attributes[5] {
    Attribute::Fingerprint(fp) => debug_assert(fp == 0xe57a3bcfU, "fingerprint")
    _ => debug_assert(false, "attr 5 must be Fingerprint")
  }

  let key = str_to_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  match verify_message_integrity(raw, key) {
    Ok(ok) => debug_assert(ok, "MI must verify true")
    Err(e) => debug_assert(false, "verify MI err: " + stun_error_message(e))
  }
  match verify_fingerprint(raw) {
    Ok(ok) => debug_assert(ok, "FP must verify true")
    Err(e) => debug_assert(false, "verify FP err: " + stun_error_message(e))
  }

  // Tampering a byte must fail both MI and FP
  let mut tampered = Bytes::new(raw.length())
  let mut i = 0
  while i < raw.length() {
    tampered[i] = raw[i]
    i = i + 1
  }
  tampered[24] = (tampered[24].to_int() ^ 0x01).to_byte()
  match verify_message_integrity(tampered, key) {
    Ok(ok) => debug_assert(!ok, "tampered MI must be false")
    Err(_) => ()
  }
  match verify_fingerprint(tampered) {
    Ok(ok) => debug_assert(!ok, "tampered FP must be false")
    Err(_) => ()
  }
}

///|
test "rfc5769_2_2_sample_ipv4_response" {
  // RFC 5769 Section 2.2: Sample IPv4 Response
  // Software: "test vector", Mapped: 192.0.2.1:32853, Password: "VOkJxbRl1RmTxUk/WvJxBt"
  let raw = must_hex(
    "0101003c" +
    "2112a442" +
    "b7e7a701bc34d686fa87dfae" +
    "8022000b" +
    "7465737420766563746f7220" +
    "00200008" +
    "0001a147e112a643" +
    "00080014" +
    "2b91f599fd9e90c38c7489f92af9ba53f06be7d7" +
    "80280004" +
    "c07d4c96",
  )

  let msg = match decode_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode 2.2 failed: " + stun_error_message(e))
      return
    }
  }
  debug_assert(
    message_class_eq(msg.msg_class, MessageClass::SuccessResponse),
    "SuccessResponse",
  )
  debug_assert(message_method_eq(msg.method, MessageMethod::Binding), "Binding")
  debug_assert(msg.attributes.length() == 4, "4 attributes")

  match msg.attributes[0] {
    Attribute::Software(s) => debug_assert(s == "test vector", "software")
    _ => debug_assert(false, "attr 0 must be Software")
  }
  match msg.attributes[1] {
    Attribute::XorMappedAddress(addr) => {
      debug_assert(
        socket_addr_eq(addr, socket_addr_ipv4(192, 0, 2, 1, 32853)),
        "XOR-MAPPED-ADDRESS IPv4 192.0.2.1:32853",
      )
    }
    _ => debug_assert(false, "attr 1 must be XorMappedAddress")
  }

  let key = str_to_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  match verify_message_integrity(raw, key) {
    Ok(ok) => debug_assert(ok, "2.2 MI must verify")
    Err(e) => debug_assert(false, "2.2 MI err: " + stun_error_message(e))
  }
  match verify_fingerprint(raw) {
    Ok(ok) => debug_assert(ok, "2.2 FP must verify")
    Err(e) => debug_assert(false, "2.2 FP err: " + stun_error_message(e))
  }
}

///|
test "rfc5769_2_3_sample_ipv6_response" {
  // RFC 5769 Section 2.3: Sample IPv6 Response
  // Mapped: [2001:db8:1234:5678:11:2233:4455:6677]:32853
  let raw = must_hex(
    "01010048" +
    "2112a442" +
    "b7e7a701bc34d686fa87dfae" +
    "8022000b" +
    "7465737420766563746f7220" +
    "00200014" +
    "0002a1470113a9faa5d3f179bc25f4b5bed2b9d9" +
    "00080014" +
    "a382954e4be67bf11784c97c8292c275bfe3ed41" +
    "80280004" +
    "c8fb0b4c",
  )

  let msg = match decode_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode 2.3 failed: " + stun_error_message(e))
      return
    }
  }
  let expected_ip6 = must_hex("20010db8123456780011223344556677")
  match msg.attributes[1] {
    Attribute::XorMappedAddress(addr) => {
      debug_assert(
        socket_addr_eq(addr, socket_addr_ipv6(expected_ip6, 32853)),
        "XOR-MAPPED-ADDRESS IPv6",
      )
    }
    _ => debug_assert(false, "attr 1 must be XorMappedAddress IPv6")
  }

  let key = str_to_bytes("VOkJxbRl1RmTxUk/WvJxBt")
  match verify_message_integrity(raw, key) {
    Ok(ok) => debug_assert(ok, "2.3 MI must verify")
    Err(e) => debug_assert(false, "2.3 MI err: " + stun_error_message(e))
  }
  match verify_fingerprint(raw) {
    Ok(ok) => debug_assert(ok, "2.3 FP must verify")
    Err(e) => debug_assert(false, "2.3 FP err: " + stun_error_message(e))
  }
}

///|
test "rfc5769_2_4_long_term_credentials" {
  // RFC 5769 Section 2.4: Sample Request with Long-Term Authentication
  // Username: "<U+30DE><U+30C8><U+30EA><U+30C3><U+30AF><U+30B9>" (UTF-8: e3839ee38388e383aae38383e382afe382b9)
  // Password (after SASLprep): "TheMatrIX"
  // Realm: "example.org"
  // Nonce: "f//499k954d6OL34oL9FSTvy64sA"
  let raw = must_hex(
    "00010060" +
    "2112a442" +
    "78ad3433c6ad72c029da412e" +
    "00060012" +
    "e3839ee38388e383aae38383e382afe382b90000" +
    "0015001c" +
    "662f2f3439396b39353464364f4c33346f4c39465354767936347341" +
    "0014000b" +
    "6578616d706c652e6f726700" +
    "00080014" +
    "f67024656dd64a3e02b8e0712e85c9a28ca89666",
  )

  let msg = match decode_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode 2.4 failed: " + stun_error_message(e))
      return
    }
  }
  debug_assert(msg.attributes.length() == 4, "4 attributes in 2.4")

  let username = match msg.attributes[0] {
    Attribute::Username(u) => u
    _ => {
      debug_assert(false, "attr 0 must be Username")
      ""
    }
  }
  let realm = match msg.attributes[2] {
    Attribute::Realm(r) => r
    _ => {
      debug_assert(false, "attr 2 must be Realm")
      ""
    }
  }
  debug_assert(realm == "example.org", "realm")

  let key = long_term_key_md5(username, realm, "TheMatrIX")
  match verify_message_integrity(raw, key) {
    Ok(ok) => debug_assert(ok, "2.4 long-term MI must verify")
    Err(e) => debug_assert(false, "2.4 MI err: " + stun_error_message(e))
  }

  // Re-encode 2.4 (uses 0x00 padding) and verify byte-for-byte identical!
  let rebuilt = Message::new(
    MessageClass::Request,
    MessageMethod::Binding,
    must_hex("78ad3433c6ad72c029da412e"),
  )
  rebuilt.add(Attribute::Username(username))
  rebuilt.add(Attribute::Nonce("f//499k954d6OL34oL9FSTvy64sA"))
  rebuilt.add(Attribute::Realm("example.org"))
  let wire = match encode_message_signed(rebuilt, Some(key), false, false) {
    Ok(w) => w
    Err(e) => {
      debug_assert(false, "re-encode 2.4 failed: " + stun_error_message(e))
      return
    }
  }
  debug_assert(bytes_eq(wire, raw), "re-encoded 2.4 must match RFC 5769 byte-for-byte")
}

///|
test "rfc8489_message_integrity_sha256_and_all_attributes" {
  let tx = must_hex("0102030405060708090a0b0c")
  let msg = Message::new(MessageClass::ErrorResponse, MessageMethod::Allocate, tx)
  msg.add(Attribute::MappedAddress(socket_addr_ipv4(10, 0, 0, 1, 5000)))
  msg.add(Attribute::XorMappedAddress(socket_addr_ipv6(must_hex("fe800000000000000000000000000001"), 6000)))
  msg.add(Attribute::ErrorCode(ErrorCode::new(420, "Unknown Attribute")))
  msg.add(Attribute::UnknownAttributes([0x0024, 0x0025]))
  msg.add(Attribute::UseCandidate)
  msg.add(Attribute::IceControlling(0x1122334455667788UL))
  msg.add(Attribute::Unknown(0x8099, must_hex("deadbeef")))

  let key = long_term_key_sha256("alice", "example.org", "secret")
  let wire = match encode_message_signed(msg, Some(key), true, true) {
    Ok(w) => w
    Err(e) => {
      debug_assert(false, "encode sha256 failed: " + stun_error_message(e))
      return
    }
  }

  match verify_message_integrity_sha256(wire, key) {
    Ok(ok) => debug_assert(ok, "MI-SHA256 must verify")
    Err(e) => debug_assert(false, "verify MI-SHA256 err: " + stun_error_message(e))
  }
  match verify_fingerprint(wire) {
    Ok(ok) => debug_assert(ok, "FP must verify")
    Err(e) => debug_assert(false, "verify FP err: " + stun_error_message(e))
  }

  let dec = match decode_message(wire) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "decode failed: " + stun_error_message(e))
      return
    }
  }
  debug_assert(message_class_eq(dec.msg_class, MessageClass::ErrorResponse), "ErrorResponse")
  debug_assert(message_method_eq(dec.method, MessageMethod::Allocate), "Allocate")
  debug_assert(dec.attributes.length() == 9, "7 attrs + MI-SHA256 + FP")
  match dec.attributes[2] {
    Attribute::ErrorCode(ec) => {
      debug_assert(ec.code == 420 && ec.reason == "Unknown Attribute", "ErrorCode")
    }
    _ => debug_assert(false, "attr 2 ErrorCode")
  }
  match dec.attributes[3] {
    Attribute::UnknownAttributes(u) => {
      debug_assert(u.length() == 2 && u[0] == 0x0024 && u[1] == 0x0025, "UnknownAttributes")
    }
    _ => debug_assert(false, "attr 3 UnknownAttributes")
  }
  match dec.attributes[4] {
    Attribute::UseCandidate => ()
    _ => debug_assert(false, "attr 4 UseCandidate")
  }
  match dec.attributes[5] {
    Attribute::IceControlling(v) => debug_assert(v == 0x1122334455667788UL, "IceControlling")
    _ => debug_assert(false, "attr 5 IceControlling")
  }
}

///|
test "message_type_12bit_method_roundtrip" {
  let classes = [
    MessageClass::Request,
    MessageClass::Indication,
    MessageClass::SuccessResponse,
    MessageClass::ErrorResponse,
  ]
  let methods = [
    MessageMethod::Binding,
    MessageMethod::Allocate,
    MessageMethod::Refresh,
    MessageMethod::Send,
    MessageMethod::Data,
    MessageMethod::CreatePermission,
    MessageMethod::ChannelBind,
    MessageMethod::Other(0xFFF),
    MessageMethod::Other(0xABC),
  ]
  let mut ci = 0
  while ci < classes.length() {
    let mut mi = 0
    while mi < methods.length() {
      let raw = match encode_message_type(classes[ci], methods[mi]) {
        Ok(v) => v
        Err(_) => {
          debug_assert(false, "encode_message_type failed")
          return
        }
      }
      debug_assert((raw & 0xC000) == 0, "top 2 bits must be 00")
      match decode_message_type(raw) {
        Ok((c2, m2)) => {
          debug_assert(message_class_eq(classes[ci], c2), "class roundtrip")
          debug_assert(message_method_eq(methods[mi], m2), "method roundtrip")
        }
        Err(_) => debug_assert(false, "decode_message_type failed")
      }
      mi = mi + 1
    }
    ci = ci + 1
  }
}

///|
test "decode_limits_and_malformed_packets" {
  // Empty valid Binding Request (0 attributes)
  let empty_req = must_hex("000100002112a442000102030405060708090a0b")
  // Negative limits must be immediately rejected
  match decode_message_with_limits(empty_req, DecodeLimits::new(-1, 10, 100)) {
    Err(StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_message_bytes must fail")
  }
  match decode_message_with_limits(empty_req, DecodeLimits::new(100, -1, 100)) {
    Err(StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_attributes must fail")
  }
  match decode_message_with_limits(empty_req, DecodeLimits::new(100, 10, -1)) {
    Err(StunError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_attribute_bytes must fail")
  }

  // max_attributes == 0 strictly allows 0 attributes and rejects 1 attribute
  match decode_message_with_limits(empty_req, DecodeLimits::new(20, 0, 0)) {
    Ok(m) => debug_assert(m.attributes.length() == 0, "0 attrs allowed")
    Err(e) => debug_assert(false, "0 attrs should pass: " + stun_error_message(e))
  }
  let one_attr = must_hex("000100042112a442000102030405060708090a0b00250000")
  match decode_message_with_limits(one_attr, DecodeLimits::new(100, 0, 100)) {
    Err(StunError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attributes=0 must reject 1 attr")
  }

  // Top 2 bits non-zero
  let bad_top_bits = must_hex("400100002112a442000102030405060708090a0b")
  match decode_message(bad_top_bits) {
    Err(StunError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "non-zero top 2 bits must fail")
  }

  // Non-4-byte-aligned message length
  let bad_align = must_hex("000100022112a442000102030405060708090a0b0000")
  match decode_message(bad_align) {
    Err(StunError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "non-4-aligned length must fail")
  }

  // Bad magic cookie
  let bad_cookie = must_hex("00010000deadbeef000102030405060708090a0b")
  match decode_message(bad_cookie) {
    Err(StunError::InvalidMagicCookie(_)) => ()
    _ => debug_assert(false, "bad cookie must fail")
  }

  // Truncated attribute length overflow
  let trunc_attr = must_hex("000100042112a442000102030405060708090a0b0006ffff")
  match decode_message(trunc_attr) {
    Err(StunError::TruncatedAttribute(_)) => ()
    _ => debug_assert(false, "truncated attr must fail")
  }
}

///|
test "rfc7983_is_stun_packet_demux" {
  let valid_stun = must_hex("000100002112a442000102030405060708090a0b")
  debug_assert(is_stun_packet(valid_stun), "valid STUN packet")

  // DTLS record starts with 20..63 (e.g. 0x16 Handshake)
  let dtls = must_hex("16fefd002112a442000102030405060708090a0b")
  debug_assert(!is_stun_packet(dtls), "DTLS is not STUN")

  // RTP starts with 128..191 (e.g. 0x80)
  let rtp = must_hex("806000012112a442000102030405060708090a0b")
  debug_assert(!is_stun_packet(rtp), "RTP is not STUN")

  // Too short
  debug_assert(!is_stun_packet(must_hex("00010000")), "short packet is not STUN")
}

///|
test "rfc8445_ice_priority_formulas" {
  // RFC 8445 §5.1.2.1: (2^24 * 126) + (2^8 * 65535) + (256 - 1) = 2130706431
  match compute_candidate_priority(126, 65535, 1) {
    Ok(p) => debug_assert(p == 2130706431U, "host max priority == 2130706431")
    Err(_) => debug_assert(false, "compute_candidate_priority failed")
  }
  // Invalid component_id 0 or 257 must fail
  match compute_candidate_priority(126, 65535, 0) {
    Err(StunError::IceError(_)) => ()
    _ => debug_assert(false, "component_id=0 must fail")
  }

  // RFC 8445 §6.1.2.3: 2^32 * min(G, D) + 2 * max(G, D) + (G > D ? 1 : 0)
  let p1 = compute_pair_priority(100U, 200U)
  // min=100, max=200, G>D=0 -> 100 * 4294967296 + 400 = 429496730000
  debug_assert(p1 == 429496730000L, "pair priority G < D")
  let p2 = compute_pair_priority(200U, 100U)
  // min=100, max=200, G>D=1 -> 100 * 4294967296 + 401 = 429496730001
  debug_assert(p2 == 429496730001L, "pair priority G > D")
}

///|
test "rfc8445_ice_agent_two_peer_handshake" {
  // Full Sans-IO ICE connectivity check + nomination between Controlling (Alice) and Controlled (Bob)
  let alice_addr = socket_addr_ipv4(192, 168, 1, 10, 50000)
  let bob_addr = socket_addr_ipv4(198, 51, 100, 20, 60000)

  let alice = IceAgent::new(
    IceRole::Controlling,
    0x1111222233334444UL,
    "uAlice",
    "pwdAliceSecret1234567890",
    false,
  )
  let bob = IceAgent::new(
    IceRole::Controlled,
    0x5555666677778888UL,
    "uBob",
    "pwdBobSecret0987654321",
    false,
  )

  alice.set_remote_credentials("uBob", "pwdBobSecret0987654321")
  bob.set_remote_credentials("uAlice", "pwdAliceSecret1234567890")

  let _ = match alice.add_local_candidate("1", 1, alice_addr, CandidateType::Host, 65535) {
    Ok(idx) => idx
    Err(e) => {
      debug_assert(false, "alice local cand: " + stun_error_message(e))
      return
    }
  }
  let _ = match bob.add_local_candidate("1", 1, bob_addr, CandidateType::Host, 65535) {
    Ok(idx) => idx
    Err(e) => {
      debug_assert(false, "bob local cand: " + stun_error_message(e))
      return
    }
  }

  let bob_prio = bob.local_candidates[0].priority
  let alice_prio = alice.local_candidates[0].priority
  let _ = match alice.add_remote_candidate("1", 1, bob_addr, CandidateType::Host, bob_prio) {
    Ok(idx) => idx
    Err(e) => {
      debug_assert(false, "alice remote cand: " + stun_error_message(e))
      return
    }
  }
  let _ = match bob.add_remote_candidate("1", 1, alice_addr, CandidateType::Host, alice_prio) {
    Ok(idx) => idx
    Err(e) => {
      debug_assert(false, "bob remote cand: " + stun_error_message(e))
      return
    }
  }

  debug_assert(alice.pairs.length() == 1, "alice has 1 pair")
  debug_assert(pair_state_eq(alice.pairs[0].state, PairState::Waiting), "Waiting initially")

  // 1. Alice sends connectivity check Binding Request to Bob
  let check1 = match alice.next_check() {
    Ok(Some(pkt)) => pkt
    _ => {
      debug_assert(false, "alice next_check must produce packet")
      return
    }
  }
  debug_assert(pair_state_eq(alice.pairs[0].state, PairState::InProgress), "InProgress after send")

  // 2. Bob receives Alice's Binding Request and replies with Binding Success Response
  let resp1 = match bob.handle_inbound(check1.wire, alice_addr) {
    Ok(IceInboundResult::SendResponse(w, dst)) => {
      debug_assert(socket_addr_eq(dst, alice_addr), "response dst is alice_addr")
      w
    }
    _ => {
      debug_assert(false, "bob must send Binding Success Response")
      return
    }
  }

  // 3. Alice receives Bob's Binding Success Response -> Pair Succeeded
  match alice.handle_inbound(resp1, bob_addr) {
    Ok(IceInboundResult::PairSucceeded(pidx, Some(mapped))) => {
      debug_assert(pidx == 0, "pair 0 succeeded")
      debug_assert(socket_addr_eq(mapped, alice_addr), "XOR-MAPPED-ADDRESS == alice_addr")
    }
    _ => debug_assert(false, "alice must observe PairSucceeded")
  }
  debug_assert(pair_state_eq(alice.pairs[0].state, PairState::Succeeded), "Succeeded state")

  // 4. Alice performs regular nomination (USE-CANDIDATE)
  let nom_pkt = match alice.nominate_pair(0) {
    Ok(pkt) => pkt
    Err(e) => {
      debug_assert(false, "nominate_pair failed: " + stun_error_message(e))
      return
    }
  }
  let nom_resp = match bob.handle_inbound(nom_pkt.wire, alice_addr) {
    Ok(IceInboundResult::SendResponse(w, _)) => w
    _ => {
      debug_assert(false, "bob must accept nomination request")
      return
    }
  }
  match alice.handle_inbound(nom_resp, bob_addr) {
    Ok(IceInboundResult::PairSucceeded(0, _)) => ()
    _ => debug_assert(false, "alice must confirm nomination response")
  }
  match alice.selected_pair() {
    Some(p) => debug_assert(p.nominated && pair_state_eq(p.state, PairState::Succeeded), "alice nominated pair")
    None => debug_assert(false, "alice must have selected_pair")
  }
  // RFC 8445 §7.3.1.5: Bob recorded nominated=true on USE-CANDIDATE, and selects it once Bob's own check succeeds
  let bob_check = match bob.next_check() {
    Ok(Some(pkt)) => pkt
    _ => {
      debug_assert(false, "bob triggered check")
      return
    }
  }
  let alice_resp = match alice.handle_inbound(bob_check.wire, bob_addr) {
    Ok(IceInboundResult::SendResponse(w, _)) => w
    _ => {
      debug_assert(false, "alice response to bob")
      return
    }
  }
  match bob.handle_inbound(alice_resp, alice_addr) {
    Ok(IceInboundResult::PairSucceeded(0, _)) => ()
    _ => debug_assert(false, "bob pair succeeded")
  }
  match bob.selected_pair() {
    Some(p) => debug_assert(p.nominated && pair_state_eq(p.state, PairState::Succeeded), "bob selected nominated pair")
    None => debug_assert(false, "bob must have selected_pair")
  }
}

///|
test "rfc8445_ice_aggressive_nomination_multi_pair_and_rejection" {
  let host_a = socket_addr_ipv4(10, 0, 0, 1, 50001)
  let relay_a = socket_addr_ipv4(203, 0, 113, 1, 50002)
  let host_b = socket_addr_ipv4(10, 0, 0, 2, 60001)

  let alice = IceAgent::new(
    IceRole::Controlling,
    0xAABBCCDD11223344UL,
    "agA",
    "secretKeyAlice1234567890",
    true,
  )
  let bob = IceAgent::new(
    IceRole::Controlled,
    0x11223344AABBCCDDUL,
    "agB",
    "secretKeyBob654321009988",
    false,
  )
  alice.set_remote_credentials("agB", "secretKeyBob654321009988")
  bob.set_remote_credentials("agA", "secretKeyAlice1234567890")

  // Add Relay first (pair 0), then Host (pair 1) -> pairs stay append-only, next_check picks Host (pair 1) first!
  let _ = match alice.add_local_candidate("r1", 1, relay_a, CandidateType::Relay, 65535) {
    Ok(i) => i
    Err(_) => {
      debug_assert(false, "relay local")
      return
    }
  }
  let _ = match alice.add_local_candidate("h1", 1, host_a, CandidateType::Host, 65535) {
    Ok(i) => i
    Err(_) => {
      debug_assert(false, "host local")
      return
    }
  }
  let _ = match bob.add_local_candidate("h1", 1, host_b, CandidateType::Host, 65535) {
    Ok(i) => i
    Err(_) => {
      debug_assert(false, "bob host")
      return
    }
  }
  let _ = match alice.add_remote_candidate("h1", 1, host_b, CandidateType::Host, bob.local_candidates[0].priority) {
    Ok(i) => i
    Err(_) => {
      debug_assert(false, "alice remote")
      return
    }
  }
  let _ = match bob.add_remote_candidate("h1", 1, host_a, CandidateType::Host, alice.local_candidates[1].priority) {
    Ok(i) => i
    Err(_) => {
      debug_assert(false, "bob remote")
      return
    }
  }

  debug_assert(alice.pairs.length() == 2, "alice has 2 pairs")
  debug_assert(alice.pairs[1].priority > alice.pairs[0].priority, "host pair has higher priority")

  // Aggressive nomination sends USE-CANDIDATE on the highest-priority pair (pair 1: host)
  let pkt = match alice.next_check() {
    Ok(Some(p)) => p
    _ => {
      debug_assert(false, "next_check")
      return
    }
  }
  debug_assert(pkt.pair_idx == 1, "next_check must pick host pair 1 first")
  let resp = match bob.handle_inbound(pkt.wire, host_a) {
    Ok(IceInboundResult::SendResponse(w, _)) => w
    _ => {
      debug_assert(false, "bob response")
      return
    }
  }
  match alice.handle_inbound(resp, host_b) {
    Ok(IceInboundResult::PairSucceeded(1, _)) => ()
    _ => debug_assert(false, "alice aggressive pair succeeded")
  }
  match alice.selected_pair() {
    Some(p) => debug_assert(p.nominated && p.local_idx == 1, "aggressive nominated host pair")
    None => debug_assert(false, "alice must select pair immediately")
  }
  // Bob completes its own check -> selects pair 0
  let bob_pkt = match bob.next_check() {
    Ok(Some(p)) => p
    _ => {
      debug_assert(false, "bob next_check")
      return
    }
  }
  let alice_resp = match alice.handle_inbound(bob_pkt.wire, host_b) {
    Ok(IceInboundResult::SendResponse(w, _)) => w
    _ => {
      debug_assert(false, "alice resp to bob")
      return
    }
  }
  match bob.handle_inbound(alice_resp, host_a) {
    Ok(IceInboundResult::PairSucceeded(0, _)) => ()
    _ => debug_assert(false, "bob pair 0 succeeded")
  }
  match bob.selected_pair() {
    Some(p) => debug_assert(p.nominated, "bob nominated")
    None => debug_assert(false, "bob must select pair after own check")
  }

  // Mark relay pair 0 failed
  match alice.mark_pair_failed(0) {
    Ok(_) => debug_assert(pair_state_eq(alice.pairs[0].state, PairState::Failed), "pair 0 failed")
    Err(_) => debug_assert(false, "mark_pair_failed")
  }

  // Tampered packet must be rejected with FingerprintMismatch
  let mut bad = Bytes::new(pkt.wire.length())
  let mut i = 0
  while i < pkt.wire.length() {
    bad[i] = pkt.wire[i]
    i = i + 1
  }
  bad[24] = (bad[24].to_int() ^ 0xFF).to_byte()
  match bob.handle_inbound(bad, host_a) {
    Err(StunError::FingerprintMismatch(_)) => ()
    _ => debug_assert(false, "tampered packet must fail fingerprint")
  }
}

///|
test "rfc8445_multihomed_handle_inbound_on_exact_local_pair" {
  let alice_addr = socket_addr_ipv4(192, 168, 1, 10, 50000)
  let bob_eth = socket_addr_ipv4(10, 0, 0, 2, 60000)
  let bob_wifi = socket_addr_ipv4(10, 1, 0, 2, 60001)
  let alice = IceAgent::new(IceRole::Controlling, 1UL, "uAlice", "pwdAliceSecret1234567890", false)
  let bob = IceAgent::new(IceRole::Controlled, 2UL, "uBob", "pwdBobSecret0987654321ab", false)
  alice.set_remote_credentials("uBob", "pwdBobSecret0987654321ab")
  bob.set_remote_credentials("uAlice", "pwdAliceSecret1234567890")
  let _ = alice.add_local_candidate("a", 1, alice_addr, CandidateType::Host, 65535)
  let _ = bob.add_local_candidate("e", 1, bob_eth, CandidateType::Host, 65535)
  let _ = bob.add_local_candidate("w", 1, bob_wifi, CandidateType::Host, 100)
  let _ = alice.add_remote_candidate("e", 1, bob_eth, CandidateType::Host, bob.local_candidates[0].priority)
  let _ = alice.add_remote_candidate("w", 1, bob_wifi, CandidateType::Host, bob.local_candidates[1].priority)
  let _ = bob.add_remote_candidate("a", 1, alice_addr, CandidateType::Host, alice.local_candidates[0].priority)

  // Alice nominates wifi pair (idx 1)
  let pkt = match alice.nominate_pair(1) {
    Ok(p) => p
    Err(_) => {
      debug_assert(false, "nominate wifi")
      return
    }
  }
  // Packet arrives on bob_wifi socket -> marks wifi pair (idx 1) nominated, NOT Succeeded yet
  let _ = match bob.handle_inbound_on(pkt.wire, bob_wifi, alice_addr) {
    Ok(IceInboundResult::SendResponse(_, _)) => ()
    _ => {
      debug_assert(false, "bob resp on wifi")
      return
    }
  }
  debug_assert(bob.pairs[1].nominated && !bob.pairs[0].nominated, "only wifi pair marked nominated")
  debug_assert(pair_state_eq(bob.pairs[1].state, PairState::Waiting), "wifi pair not Succeeded before own check")
  // Bob checks eth (idx 0) and wifi (idx 1); wifi succeeds -> Bob selects wifi pair!
  let _ = bob.next_check() // eth
  let bob_wifi_chk = match bob.next_check() {
    Ok(Some(p)) => p
    _ => {
      debug_assert(false, "bob wifi check")
      return
    }
  }
  let a_resp = match alice.handle_inbound_on(bob_wifi_chk.wire, alice_addr, bob_wifi) {
    Ok(IceInboundResult::SendResponse(w, _)) => w
    _ => {
      debug_assert(false, "alice resp to bob wifi")
      return
    }
  }
  match bob.handle_inbound_on(a_resp, bob_wifi, alice_addr) {
    Ok(IceInboundResult::PairSucceeded(1, _)) => ()
    _ => debug_assert(false, "bob wifi pair succeeded")
  }
  match bob.selected_pair() {
    Some(sp) => debug_assert(socket_addr_eq(bob.local_candidates[sp.local_idx].addr, bob_wifi), "bob selected wifi")
    None => debug_assert(false, "bob must have selected wifi")
  }
}
