///| Comprehensive unit, conformance, and adversarial tests for `packages/unicode_linebreak`.

fn assert_eq_int(got : Int, expected : Int) -> Unit {
  debug_assert(
    got == expected,
    "expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_eq_str(got : String, expected : String) -> Unit {
  debug_assert(got == expected, "expected '" + expected + "', got '" + got + "'")
}

fn assert_true(cond : Bool) -> Unit {
  debug_assert(cond, "assertion failed")
}

fn assert_breaks(s : String, expected : Array[(Int, BreakKind)]) -> Unit {
  let got = line_breaks(s)
  assert_eq_int(got.length(), expected.length())
  let mut i = 0
  while i < expected.length() {
    let (exp_off, exp_kind) = expected[i]
    assert_eq_int(got[i].byte_offset, exp_off)
    assert_eq_str(got[i].kind.to_string(), exp_kind.to_string())
    i = i + 1
  }
}

fn repeat_str(unit : String, count : Int) -> String {
  let sb = StringBuilder::with_capacity(unit.length() * count)
  let mut i = 0
  while i < count {
    sb.write_string(unit)
    i = i + 1
  }
  sb.to_string()
}

test "empty string returns empty opportunities" {
  assert_eq_int(line_breaks("").length(), 0)
  match next_break_opportunity("", 0) {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "line_break_class covers Unicode 16.0.0 classes and unassigned defaults" {
  assert_eq_str(line_break_class(0x0020).to_string(), "SP")
  assert_eq_str(line_break_class(0x000A).to_string(), "LF")
  assert_eq_str(line_break_class(0x000D).to_string(), "CR")
  assert_eq_str(line_break_class(0x0085).to_string(), "NL")
  assert_eq_str(line_break_class(0x000B).to_string(), "BK")
  assert_eq_str(line_break_class(0x200B).to_string(), "ZW")
  assert_eq_str(line_break_class(0x200D).to_string(), "ZWJ")
  assert_eq_str(line_break_class(0x00A0).to_string(), "GL")
  assert_eq_str(line_break_class(0x2060).to_string(), "WJ")
  assert_eq_str(line_break_class(0x0041).to_string(), "AL")
  assert_eq_str(line_break_class(0x0030).to_string(), "NU")
  assert_eq_str(line_break_class(0x05D0).to_string(), "HL")
  assert_eq_str(line_break_class(0x4E00).to_string(), "ID")
  assert_eq_str(line_break_class(0x3041).to_string(), "CJ")
  assert_eq_str(line_break_class(0x0E01).to_string(), "SA")
  assert_eq_str(line_break_class(0x1B05).to_string(), "AK")
  assert_eq_str(line_break_class(0x1B44).to_string(), "VI")
  assert_eq_str(line_break_class(0x1F1FA).to_string(), "RI")
  assert_eq_str(line_break_class(0x1F466).to_string(), "EB")
  assert_eq_str(line_break_class(0x1F3FB).to_string(), "EM")
  // Unassigned defaults: Plane 2 ID, Currency PR, out-of-range XX
  assert_eq_str(line_break_class(0x2A6F0).to_string(), "ID")
  assert_eq_str(line_break_class(0x20CF).to_string(), "PR")
  assert_eq_str(line_break_class(-1).to_string(), "XX")
  assert_eq_str(line_break_class(0x110000).to_string(), "XX")
}

test "basic ASCII words and mandatory breaks (LB3/LB4/LB5/LB6/LB18)" {
  assert_breaks("hello world", [
    (6, BreakKind::Allowed),
    (11, BreakKind::Mandatory),
  ])
  assert_breaks("a\nb", [
    (2, BreakKind::Mandatory),
    (3, BreakKind::Mandatory),
  ])
  // CR+LF is a single mandatory break (LB5: CR x LF, LF !)
  assert_breaks("a\r\nb", [
    (3, BreakKind::Mandatory),
    (4, BreakKind::Mandatory),
  ])
  // Standalone CR, NL, BK
  assert_breaks("a\rb", [
    (2, BreakKind::Mandatory),
    (3, BreakKind::Mandatory),
  ])
  assert_breaks("a\u{0085}b", [
    (3, BreakKind::Mandatory),
    (4, BreakKind::Mandatory),
  ])
  assert_breaks("a\u{000C}b", [
    (2, BreakKind::Mandatory),
    (3, BreakKind::Mandatory),
  ])
}

test "CJK ideographs and kinsoku line-head/line-tail punctuation" {
  // "中文。" -> break between 中(3) and 文(6), NO break before 。(CL), mandatory at 9
  assert_breaks("中文。", [
    (3, BreakKind::Allowed),
    (9, BreakKind::Mandatory),
  ])
  // "「中文」" -> NO break after 「(OP), break between 中 and 文, NO break before 」(CL)
  assert_breaks("「中文」", [
    (6, BreakKind::Allowed),
    (12, BreakKind::Mandatory),
  ])
  // Small kana CJ -> NS: "あっ" no break before っ
  assert_breaks("あっ", [
    (6, BreakKind::Mandatory),
  ])
}

test "ZW, SP, GL, WJ, and combining marks (LB7-LB12a)" {
  // ZW SP* ÷ (LB8)
  assert_breaks("a\u{200B}  b", [
    (6, BreakKind::Allowed),
    (7, BreakKind::Mandatory),
  ])
  // WJ prevents break on both sides (LB11)
  assert_breaks("a\u{2060}b", [
    (5, BreakKind::Mandatory),
  ])
  // GL prevents break after and before except after SP/BA/HY (LB12/LB12a)
  assert_breaks("a\u{00A0}b", [
    (4, BreakKind::Mandatory),
  ])
  assert_breaks("a \u{00A0}b", [
    (2, BreakKind::Allowed),
    (5, BreakKind::Mandatory),
  ])
  // Combining mark stays attached to base (LB9)
  assert_breaks("e\u{0301} f", [
    (4, BreakKind::Allowed),
    (5, BreakKind::Mandatory),
  ])
}

test "Emoji ZWJ sequences and skin-tone modifiers (LB8a / LB30b)" {
  // Woman technologist: U+1F469 ZWJ U+1F4BB -> no internal break
  let emo = "\u{1F469}\u{200D}\u{1F4BB}"
  assert_breaks(emo, [
    (emo.length(), BreakKind::Mandatory),
  ])
  // EB x EM: U+1F466 U+1F3FB -> no break between
  let skin = "\u{1F466}\u{1F3FB}"
  assert_breaks(skin, [
    (skin.length(), BreakKind::Mandatory),
  ])
  // Extended_Pictographic & Cn x EM: U+1F777 (Cn, ExtPict) + U+1F3FB (EM)
  let ep_cn = "\u{1F777}\u{1F3FB}"
  assert_breaks(ep_cn, [
    (ep_cn.length(), BreakKind::Mandatory),
  ])
}

test "Regional Indicator flag pairs (LB30a)" {
  // US + JP = 4 RIs: break after pair 1 (byte 8), mandatory at end (byte 16)
  let flags = "\u{1F1FA}\u{1F1F8}\u{1F1EF}\u{1F1F5}"
  assert_breaks(flags, [
    (8, BreakKind::Allowed),
    (16, BreakKind::Mandatory),
  ])
}

test "LB15a/LB15b/LB15c/LB19a quotes and decimal marks" {
  // LB15c: SP ÷ IS NU ("subtract .5")
  assert_breaks("a .5", [
    (2, BreakKind::Allowed),
    (4, BreakKind::Mandatory),
  ])
  // LB15a: sot QU_Pi SP* × ("« a")
  assert_breaks("\u{00AB} a", [
    (4, BreakKind::Mandatory),
  ])
  // LB15b: × QU_Pf SP ("a » b" -> NO break before » even after space!)
  assert_breaks("a \u{00BB} b", [
    (5, BreakKind::Allowed),
    (6, BreakKind::Mandatory),
  ])
  // LB19a: Latin quotes do not break
  assert_breaks("a\"b", [
    (3, BreakKind::Mandatory),
  ])
  // East Asian surrounded quotes
  let cj_q = "中\u{201C}文\u{201D}"
  let brks = line_breaks(cj_q)
  assert_eq_int(brks[brks.length() - 1].byte_offset, cj_q.length())
  assert_eq_str(brks[brks.length() - 1].kind.to_string(), "Mandatory")
}

test "LB20a word-initial hyphen and LB21a Hebrew hyphen" {
  // LB20a: sot HY × AL ("-a")
  assert_breaks("-a", [
    (2, BreakKind::Mandatory),
  ])
  // Unicode 16.0.0 LB20a does NOT inhibit break for sot HY ÷ HL
  assert_breaks("-\u{05D0}", [
    (1, BreakKind::Allowed),
    (3, BreakKind::Mandatory),
  ])
  // LB21a: HL HY × [^HL]
  assert_breaks("\u{05D0}-a", [
    (4, BreakKind::Mandatory),
  ])
}

test "LB25 Unicode 16.0.0 numeric, currency, parentheses and fraction chains" {
  assert_breaks("$1,234.56", [
    (9, BreakKind::Mandatory),
  ])
  assert_breaks("$(123)%", [
    (7, BreakKind::Mandatory),
  ])
  assert_breaks("$(.5)", [
    (5, BreakKind::Mandatory),
  ])
  assert_breaks("1/2", [
    (3, BreakKind::Mandatory),
  ])
  assert_breaks("-42", [
    (3, BreakKind::Mandatory),
  ])
}

test "LB28a Brahmic orthographic syllables" {
  // AP × AK: U+11F02 (AP) + U+1B05 (AK)
  let s1 = "\u{11F02}\u{1B05}"
  assert_breaks(s1, [
    (s1.length(), BreakKind::Mandatory),
  ])
  // AK VI × AK: U+1B05 (AK) + U+1B44 (VI) + U+1B05 (AK)
  let s2 = "\u{1B05}\u{1B44}\u{1B05}"
  assert_breaks(s2, [
    (s2.length(), BreakKind::Mandatory),
  ])
  // AK × AK VF: U+1B05 (AK) + U+1B05 (AK) + U+1BF2 (VF)
  let s3 = "\u{1B05}\u{1B05}\u{1BF2}"
  assert_breaks(s3, [
    (s3.length(), BreakKind::Mandatory),
  ])
  // Dotted circle U+25CC participates as AK/AS in LB28a
  let s4 = "\u{25CC}\u{1B44}\u{25CC}"
  assert_breaks(s4, [
    (s4.length(), BreakKind::Mandatory),
  ])
}

test "invalid UTF-8 bytes are handled safely without panic or loop" {
  let sb = StringBuilder::with_capacity(6)
  sb.write_byte(0x61.to_byte()) // 'a'
  sb.write_byte(0xFF.to_byte()) // invalid UTF-8
  sb.write_byte(0x20.to_byte()) // ' '
  sb.write_byte(0xE0.to_byte()) // truncated 3-byte
  sb.write_byte(0x62.to_byte()) // 'b'
  let bad = sb.to_string()
  let brks = line_breaks(bad)
  assert_eq_int(brks.length(), 2)
  assert_eq_int(brks[0].byte_offset, 3)
  assert_eq_str(brks[0].kind.to_string(), "Allowed")
  assert_eq_int(brks[1].byte_offset, 5)
  assert_eq_str(brks[1].kind.to_string(), "Mandatory")
}

test "next_break_opportunity handles negative, mid-UTF-8, and out-of-bounds safely" {
  let s = "中文 a"
  // Opportunities: 3 (Allowed), 7 (Allowed), 8 (Mandatory)
  match next_break_opportunity(s, -5) {
    Some(op) => {
      assert_eq_int(op.byte_offset, 3)
      assert_eq_str(op.kind.to_string(), "Allowed")
    }
    None => assert_true(false)
  }
  // Mid-UTF-8 byte 1 (inside 中 [0..3]) -> next boundary break is 3
  match next_break_opportunity(s, 1) {
    Some(op) => assert_eq_int(op.byte_offset, 3)
    None => assert_true(false)
  }
  match next_break_opportunity(s, 3) {
    Some(op) => assert_eq_int(op.byte_offset, 7)
    None => assert_true(false)
  }
  match next_break_opportunity(s, 7) {
    Some(op) => {
      assert_eq_int(op.byte_offset, 8)
      assert_eq_str(op.kind.to_string(), "Mandatory")
    }
    None => assert_true(false)
  }
  match next_break_opportunity(s, 8) {
    None => ()
    Some(_) => assert_true(false)
  }
  match next_break_opportunity(s, 999) {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "line_breaks_with_limits enforces negative, zero, and exact bounds" {
  // Negative limits always fail even on empty string
  match line_breaks_with_limits("", LineBreakLimits::new(-1, 10)) {
    Err(e) => assert_eq_str(e.to_string(), "LimitExceeded")
    Ok(_) => assert_true(false)
  }
  match line_breaks_with_limits("", LineBreakLimits::new(10, -1)) {
    Err(e) => assert_eq_str(e.to_string(), "LimitExceeded")
    Ok(_) => assert_true(false)
  }
  // Zero limits: empty input OK (0 bytes, 0 opportunities), non-empty fails
  match line_breaks_with_limits("", LineBreakLimits::new(0, 0)) {
    Ok(arr) => assert_eq_int(arr.length(), 0)
    Err(_) => assert_true(false)
  }
  match line_breaks_with_limits("a", LineBreakLimits::new(0, 10)) {
    Err(e) => assert_eq_str(e.to_string(), "LimitExceeded")
    Ok(_) => assert_true(false)
  }
  match line_breaks_with_limits("a", LineBreakLimits::new(10, 0)) {
    Err(e) => assert_eq_str(e.to_string(), "LimitExceeded")
    Ok(_) => assert_true(false)
  }
  // Exact boundary succeeds; 1 below fails
  match line_breaks_with_limits("a b", LineBreakLimits::new(3, 2)) {
    Ok(arr) => assert_eq_int(arr.length(), 2)
    Err(_) => assert_true(false)
  }
  match line_breaks_with_limits("a b", LineBreakLimits::new(3, 1)) {
    Err(e) => assert_eq_str(e.to_string(), "LimitExceeded")
    Ok(_) => assert_true(false)
  }
}

test "O(n) linear-time DoS stress on 100k adversarial runs" {
  let sp_run = repeat_str(" ", 100000)
  let sp_brks = line_breaks(sp_run)
  assert_eq_int(sp_brks.length(), 1)
  assert_eq_int(sp_brks[0].byte_offset, 100000)

  let cm_run = "a" + repeat_str("\u{0301}", 100000) + " b"
  let cm_brks = line_breaks(cm_run)
  assert_eq_int(cm_brks.length(), 2)

  let zwj_run = "a" + repeat_str("\u{200D}", 100000) + "b"
  let zwj_brks = line_breaks(zwj_run)
  assert_eq_int(zwj_brks.length(), 1)

  let qu_run = repeat_str("\"", 100000)
  let qu_brks = line_breaks(qu_run)
  assert_eq_int(qu_brks.length(), 1)

  let nu_run = "1" + repeat_str(".", 100000) + "2"
  let nu_brks = line_breaks(nu_run)
  assert_eq_int(nu_brks.length(), 1)

  let op_run = repeat_str("(", 100000) + "a"
  let op_brks = line_breaks(op_run)
  assert_eq_int(op_brks.length(), 1)

  let cl_run = "a" + repeat_str(")", 100000)
  let cl_brks = line_breaks(cl_run)
  assert_eq_int(cl_brks.length(), 1)

  let ri_run = repeat_str("\u{1F1FA}", 40000)
  let ri_brks = line_breaks(ri_run)
  assert_eq_int(ri_brks.length(), 20000)

  let ak_run = repeat_str("\u{1B05}\u{1B44}", 25000) + "\u{1B05}"
  let ak_brks = line_breaks(ak_run)
  assert_eq_int(ak_brks.length(), 1)
}
