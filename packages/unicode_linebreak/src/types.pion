///| Public types for `packages/unicode_linebreak` (Unicode 16.0.0 UAX #14).
///| Pure Pion, zero external dependencies, zero `World`, zero `extern "C"`.

///| Official Unicode 16.0.0 UAX #14 `Line_Break` property values (all 48 classes).
pub enum LineBreakClass {
  AI
  AK
  AL
  AP
  AS
  B2
  BA
  BB
  BK
  CB
  CJ
  CL
  CM
  CP
  CR
  EB
  EM
  EX
  GL
  H2
  H3
  HL
  HY
  ID
  IN
  IS
  JL
  JT
  JV
  LF
  NL
  NS
  NU
  OP
  PO
  PR
  QU
  RI
  SA
  SG
  SP
  SY
  VF
  VI
  WJ
  XX
  ZW
  ZWJ
}

pub fn LineBreakClass::to_string(self : LineBreakClass) -> String {
  match self {
    LineBreakClass::AI => "AI"
    LineBreakClass::AK => "AK"
    LineBreakClass::AL => "AL"
    LineBreakClass::AP => "AP"
    LineBreakClass::AS => "AS"
    LineBreakClass::B2 => "B2"
    LineBreakClass::BA => "BA"
    LineBreakClass::BB => "BB"
    LineBreakClass::BK => "BK"
    LineBreakClass::CB => "CB"
    LineBreakClass::CJ => "CJ"
    LineBreakClass::CL => "CL"
    LineBreakClass::CM => "CM"
    LineBreakClass::CP => "CP"
    LineBreakClass::CR => "CR"
    LineBreakClass::EB => "EB"
    LineBreakClass::EM => "EM"
    LineBreakClass::EX => "EX"
    LineBreakClass::GL => "GL"
    LineBreakClass::H2 => "H2"
    LineBreakClass::H3 => "H3"
    LineBreakClass::HL => "HL"
    LineBreakClass::HY => "HY"
    LineBreakClass::ID => "ID"
    LineBreakClass::IN => "IN"
    LineBreakClass::IS => "IS"
    LineBreakClass::JL => "JL"
    LineBreakClass::JT => "JT"
    LineBreakClass::JV => "JV"
    LineBreakClass::LF => "LF"
    LineBreakClass::NL => "NL"
    LineBreakClass::NS => "NS"
    LineBreakClass::NU => "NU"
    LineBreakClass::OP => "OP"
    LineBreakClass::PO => "PO"
    LineBreakClass::PR => "PR"
    LineBreakClass::QU => "QU"
    LineBreakClass::RI => "RI"
    LineBreakClass::SA => "SA"
    LineBreakClass::SG => "SG"
    LineBreakClass::SP => "SP"
    LineBreakClass::SY => "SY"
    LineBreakClass::VF => "VF"
    LineBreakClass::VI => "VI"
    LineBreakClass::WJ => "WJ"
    LineBreakClass::XX => "XX"
    LineBreakClass::ZW => "ZW"
    LineBreakClass::ZWJ => "ZWJ"
  }
}

pub fn LineBreakClass::eq(self : LineBreakClass, other : LineBreakClass) -> Bool {
  self.to_string() == other.to_string()
}

///| Whether a line break opportunity is mandatory (hard break / end of text) or allowed.
pub enum BreakKind {
  Allowed
  Mandatory
}

pub fn BreakKind::to_string(self : BreakKind) -> String {
  match self {
    BreakKind::Allowed => "Allowed"
    BreakKind::Mandatory => "Mandatory"
  }
}

pub fn BreakKind::eq(self : BreakKind, other : BreakKind) -> Bool {
  match self {
    BreakKind::Allowed =>
    match other {
      BreakKind::Allowed => true
      BreakKind::Mandatory => false
    }
    BreakKind::Mandatory =>
    match other {
      BreakKind::Allowed => false
      BreakKind::Mandatory => true
    }
  }
}

///| A UTF-8 byte offset where a line break is allowed or mandatory.
///| `byte_offset` is always on a UTF-8 code point boundary in `1..=s.length()`.
pub val struct BreakOpportunity {
  pub byte_offset : Int
  pub kind : BreakKind
}

pub fn BreakOpportunity::new(byte_offset : Int, kind : BreakKind) -> BreakOpportunity {
  BreakOpportunity::{ byte_offset: byte_offset, kind: kind }
}

pub fn BreakOpportunity::eq(self : BreakOpportunity, other : BreakOpportunity) -> Bool {
  self.byte_offset == other.byte_offset && self.kind.eq(other.kind)
}

pub fn BreakOpportunity::to_string(self : BreakOpportunity) -> String {
  self.byte_offset.to_string() + ":" + self.kind.to_string()
}

///| Error returned by `line_breaks_with_limits`.
pub enum LineBreakError {
  LimitExceeded
}

pub fn LineBreakError::to_string(self : LineBreakError) -> String {
  match self {
    LineBreakError::LimitExceeded => "LimitExceeded"
  }
}

pub fn LineBreakError::eq(self : LineBreakError, other : LineBreakError) -> Bool {
  match self {
    LineBreakError::LimitExceeded =>
    match other {
      LineBreakError::LimitExceeded => true
    }
  }
}

///| Resource limits for `line_breaks_with_limits`.
///| Any negative limit fails immediately with `LineBreakError::LimitExceeded`.
///| `0` is enforced strictly.
pub val struct LineBreakLimits {
  pub max_input_bytes : Int
  pub max_opportunities : Int
}

pub fn LineBreakLimits::default() -> LineBreakLimits {
  LineBreakLimits::{
    max_input_bytes: 16777216,
    max_opportunities: 16777216,
  }
}

pub fn LineBreakLimits::new(
  max_input_bytes : Int,
  max_opportunities : Int,
) -> LineBreakLimits {
  LineBreakLimits::{
    max_input_bytes: max_input_bytes,
    max_opportunities: max_opportunities,
  }
}
