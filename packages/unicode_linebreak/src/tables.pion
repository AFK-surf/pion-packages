fn lookup_combo(cp : Int) -> Int {
  if cp < 0 || cp > 0x10FFFF {
    return 24
  }
  if cp < 128 {
    return dec91(ascii_combos.code_unit_at(cp))
  }
  let s1 = dec91(stage1_table.code_unit_at(cp >> 13))
  let s2_off = (s1 * 64 + ((cp >> 7) & 63)) * 2
  let b0 = dec91(stage2_table.code_unit_at(s2_off))
  let b1 = dec91(stage2_table.code_unit_at(s2_off + 1))
  let s3 = b0 * 91 + b1
  dec91(stage3_table.code_unit_at(s3 * 128 + (cp & 127)))
}

fn combo_raw_id(cid : Int) -> Int {
  dec91(combo_raw_table.code_unit_at(cid))
}

fn combo_res_cls(cid : Int) -> Int {
  dec91(combo_res_table.code_unit_at(cid))
}

fn combo_flags(cid : Int) -> Int {
  dec91(combo_flags_table.code_unit_at(cid))
}

fn raw_id_to_class(id : Int) -> LineBreakClass {
  match id {
    0 => LineBreakClass::AI
    1 => LineBreakClass::AK
    2 => LineBreakClass::AL
    3 => LineBreakClass::AP
    4 => LineBreakClass::AS
    5 => LineBreakClass::B2
    6 => LineBreakClass::BA
    7 => LineBreakClass::BB
    8 => LineBreakClass::BK
    9 => LineBreakClass::CB
    10 => LineBreakClass::CJ
    11 => LineBreakClass::CL
    12 => LineBreakClass::CM
    13 => LineBreakClass::CP
    14 => LineBreakClass::CR
    15 => LineBreakClass::EB
    16 => LineBreakClass::EM
    17 => LineBreakClass::EX
    18 => LineBreakClass::GL
    19 => LineBreakClass::H2
    20 => LineBreakClass::H3
    21 => LineBreakClass::HL
    22 => LineBreakClass::HY
    23 => LineBreakClass::ID
    24 => LineBreakClass::IN
    25 => LineBreakClass::IS
    26 => LineBreakClass::JL
    27 => LineBreakClass::JT
    28 => LineBreakClass::JV
    29 => LineBreakClass::LF
    30 => LineBreakClass::NL
    31 => LineBreakClass::NS
    32 => LineBreakClass::NU
    33 => LineBreakClass::OP
    34 => LineBreakClass::PO
    35 => LineBreakClass::PR
    36 => LineBreakClass::QU
    37 => LineBreakClass::RI
    38 => LineBreakClass::SA
    39 => LineBreakClass::SG
    40 => LineBreakClass::SP
    41 => LineBreakClass::SY
    42 => LineBreakClass::VF
    43 => LineBreakClass::VI
    44 => LineBreakClass::WJ
    45 => LineBreakClass::XX
    46 => LineBreakClass::ZW
    47 => LineBreakClass::ZWJ
    _ => LineBreakClass::XX
  }
}
