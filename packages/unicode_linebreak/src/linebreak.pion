///| Unicode 16.0.0 UAX #14 Line Breaking Algorithm (LB1-LB31).
///| Pure Pion, zero external dependencies, O(n) single-pass streaming scanner
///| with bounded O(1) lookahead and zero auxiliary token-array allocations.

///| Return the raw Unicode 16.0.0 `Line_Break` property class for `cp`.
///| Out-of-range values (`< 0` or `> 0x10FFFF`) return `LineBreakClass::XX`.
pub fn line_break_class(cp : Int) -> LineBreakClass {
  raw_id_to_class(combo_raw_id(lookup_combo(cp)))
}

fn is_hard_break(c : Int) -> Bool {
  c == cls_BK || c == cls_CR || c == cls_LF || c == cls_NL
}

fn is_lb9_no_base(c : Int) -> Bool {
  c == cls_BK ||
  c == cls_CR ||
  c == cls_LF ||
  c == cls_NL ||
  c == cls_SP ||
  c == cls_ZW
}

fn is_lb15a_before(c : Int) -> Bool {
  c == cls_BK ||
  c == cls_CR ||
  c == cls_LF ||
  c == cls_NL ||
  c == cls_OP ||
  c == cls_QU ||
  c == cls_GL ||
  c == cls_SP ||
  c == cls_ZW
}

fn is_lb15b_after(c : Int) -> Bool {
  c == cls_SP ||
  c == cls_GL ||
  c == cls_WJ ||
  c == cls_CL ||
  c == cls_QU ||
  c == cls_CP ||
  c == cls_EX ||
  c == cls_IS ||
  c == cls_SY ||
  c == cls_BK ||
  c == cls_CR ||
  c == cls_LF ||
  c == cls_NL ||
  c == cls_ZW
}

fn is_lb20a_before(c : Int) -> Bool {
  c == cls_BK ||
  c == cls_CR ||
  c == cls_LF ||
  c == cls_NL ||
  c == cls_SP ||
  c == cls_ZW ||
  c == cls_CB ||
  c == cls_GL
}

fn is_hangul(c : Int) -> Bool {
  c == cls_JL || c == cls_JV || c == cls_JT || c == cls_H2 || c == cls_H3
}

///| Peek the next base token starting at `from_pos`, skipping any `(CM | ZWJ)`
///| when `cur_is_no_base` is false.
///| Returns `(found, next_pos_after_base, effective_cls, flags)`.
fn peek_next_base(
  s : String,
  from_pos : Int,
  end : Int,
  cur_is_no_base : Bool,
) -> (Bool, Int, Int, Int) {
  let mut p = from_pos
  while p < end {
    let (cp, next_p) = decode_utf8_lossy(s, p, end)
    let cid = lookup_combo(cp)
    let rc = combo_res_cls(cid)
    if !cur_is_no_base && (rc == cls_CM || rc == cls_ZWJ) {
      p = next_p
      continue
    }
    if rc == cls_CM || rc == cls_ZWJ {
      return (true, next_p, cls_AL, 0)
    }
    return (true, next_p, rc, combo_flags(cid))
  }
  (false, end, -1, 0)
}

///| Check whether a code point at a valid UTF-8 boundary completely resets all
///| 19 UAX #14 state variables (so scanning from this position produces
///| bit-for-bit identical state to scanning from byte 0).
///| Only 12 resolved classes depend on left context (`CM`, `ZWJ`, `SP`, `QU`,
///| `HY`, `BA` incl. `U+2010`, `VI`, `SY`, `IS`, `CL`, `CP`, `RI`); all other
///| 31 resolved classes (including `AL`, `ID`, `NU`, `H2`, `H3`, `JL`, `JV`,
///| `JT`, `HL`, `NS`, `BK`, `LF`, `NL`, `CR`, `OP`, `ZW`, `B2`, `PR`, `PO`,
///| `EB`, `EM`, `AK`, `AP`, `AS`, `VF`, etc.) are exact state-reset anchors.
fn is_reset_anchor(res_cls : Int, flags : Int) -> Bool {
  if (flags & flag_u2010) != 0 {
    return false
  }
  !(res_cls == cls_CM ||
    res_cls == cls_ZWJ ||
    res_cls == cls_SP ||
    res_cls == cls_QU ||
    res_cls == cls_HY ||
    res_cls == cls_BA ||
    res_cls == cls_VI ||
    res_cls == cls_SY ||
    res_cls == cls_IS ||
    res_cls == cls_CL ||
    res_cls == cls_CP ||
    res_cls == cls_RI)
}

///| Find the closest backward state-reset anchor at or before `target`.
///| Guarantees exact equivalence with scanning from byte 0 while making
///| iterative `next_break_opportunity` O(n) total across all natural languages
///| and ill-formed UTF-8 byte streams.
fn find_backward_anchor(s : String, target : Int, n : Int) -> Int {
  if target <= 0 {
    return 0
  }
  let tbl = table_blob
  let mut p = if target >= n { n - 1 } else { target }
  while p > 0 {
    let b = s.code_unit_at(p)
    if b < 0x80 {
      // ASCII byte is always a true forward UTF-8 boundary
      let rc = tbl.code_unit_at(b) - 35
      if is_reset_anchor(rc, 0) {
        return p
      }
      p = p - 1
      continue
    }
    if (b & 0xC0) == 0x80 {
      // Continuation byte: walk back at most 4 bytes to check whether a valid
      // preceding lead byte consumes `saved`. Any 4+ consecutive continuation
      // bytes or unconsumed continuation byte decodes as standalone U+FFFD (AL),
      // which is itself an exact state-reset anchor!
      let saved = p
      let mut cont = 0
      while p > 0 && (s.code_unit_at(p) & 0xC0) == 0x80 && cont < 4 {
        p = p - 1
        cont = cont + 1
      }
      if cont == 4 || (s.code_unit_at(p) & 0xC0) == 0x80 {
        return saved
      }
      let (_, np) = decode_utf8_lossy(s, p, n)
      if np <= saved {
        return saved
      }
      // `p` is the true lead byte consuming `saved`; test `p` on next iteration
      continue
    }
    // Lead or invalid high byte (`0xC0..0xFF`) is always a true forward boundary
    // under maximal-subpart UTF-8 decoding; ill-formed bytes decode to U+FFFD (AL).
    let (cp, _) = decode_utf8_lossy(s, p, n)
    let cid = lookup_combo(cp)
    if is_reset_anchor(combo_res_cls(cid), combo_flags(cid)) {
      return p
    }
    p = p - 1
  }
  0
}

///| Cold contextual UAX #14 state kept out of the hot loop register file.
struct SlowCtx {
  mut prev : Int
  mut nu_state : Int
  mut prev_is_ea : Bool
  mut raw_prev_zwj : Bool
  mut ctx_dirty : Bool
  mut prev_qu_pi : Bool
  mut prev_qu_pf : Bool
  mut prev_ep_cn : Bool
  mut prev_2010 : Bool
  mut prev_25cc : Bool
  mut after_zw_sp : Bool
  mut after_op_sp : Bool
  mut after_qu_pi_sp : Bool
  mut after_cl_cp_sp : Bool
  mut after_b2_sp : Bool
  mut qu_after_non_ea : Bool
  mut after_word_init_hy : Bool
  mut after_hl_hy_ba : Bool
  mut after_ak_vi : Bool
  mut ri_odd : Bool
  mut la_from : Int
  mut la_found : Bool
  mut la_next_pos : Int
  mut la_eff : Int
  mut la_flags : Int
}

///| Full UAX #14 LB4-LB31 evaluation and state update for contextual/complex pairs.
///| Returns decision: 0 = no break, 1 = Allowed, 2 = Mandatory.
fn slow_step(
  ctx : SlowCtx,
  s : String,
  n : Int,
  next_pos : Int,
  cur_raw : Int,
  cur_flags : Int,
) -> Int {
  let mut prev = ctx.prev
  let mut nu_state = ctx.nu_state
  let mut prev_is_ea = ctx.prev_is_ea
  let mut raw_prev_zwj = ctx.raw_prev_zwj
  let mut prev_qu_pi = ctx.prev_qu_pi
  let mut prev_qu_pf = ctx.prev_qu_pf
  let mut prev_ep_cn = ctx.prev_ep_cn
  let mut prev_2010 = ctx.prev_2010
  let mut prev_25cc = ctx.prev_25cc
  let mut after_zw_sp = ctx.after_zw_sp
  let mut after_op_sp = ctx.after_op_sp
  let mut after_qu_pi_sp = ctx.after_qu_pi_sp
  let mut after_cl_cp_sp = ctx.after_cl_cp_sp
  let mut after_b2_sp = ctx.after_b2_sp
  let mut qu_after_non_ea = ctx.qu_after_non_ea
  let mut after_word_init_hy = ctx.after_word_init_hy
  let mut after_hl_hy_ba = ctx.after_hl_hy_ba
  let mut after_ak_vi = ctx.after_ak_vi
  let mut ri_odd = ctx.ri_odd
  let mut la_from = ctx.la_from
  let mut la_found = ctx.la_found
  let mut la_next_pos = ctx.la_next_pos
  let mut la_eff = ctx.la_eff
  let mut la_flags = ctx.la_flags

  let is_cur_cm_zwj = cur_raw == cls_CM || cur_raw == cls_ZWJ
  let is_lb10 = is_cur_cm_zwj && is_lb9_no_base(prev)
  let cur_ea = if is_lb10 { false } else { (cur_flags & flag_ea) != 0 }
  let cur_qu_pi = if is_lb10 { false } else { (cur_flags & flag_qu_pi) != 0 }
  let cur_qu_pf = if is_lb10 { false } else { (cur_flags & flag_qu_pf) != 0 }
  let cur_ep_cn = if is_lb10 { false } else { (cur_flags & flag_ep_cn) != 0 }
  let cur_2010 = if is_lb10 { false } else { (cur_flags & flag_u2010) != 0 }
  let cur_25cc = if is_lb10 { false } else { (cur_flags & flag_u25cc) != 0 }

  // Break decision: 0 = no break, 1 = Allowed, 2 = Mandatory
  let mut decision = 0

  if prev == cls_BK {
    decision = 2 // LB4
  } else if prev == cls_CR && cur_raw == cls_LF {
    decision = 0 // LB5: CR x LF
  } else if prev == cls_CR || prev == cls_LF || prev == cls_NL {
    decision = 2 // LB5: CR!, LF!, NL!
  } else if is_hard_break(cur_raw) {
    decision = 0 // LB6
  } else if cur_raw == cls_SP || cur_raw == cls_ZW {
    decision = 0 // LB7
  } else if after_zw_sp {
    decision = 1 // LB8
  } else if raw_prev_zwj {
    decision = 0 // LB8a
  } else if (cur_raw == cls_CM || cur_raw == cls_ZWJ) && !is_lb9_no_base(prev) {
    decision = 0 // LB9
  } else {
    // LB10: remaining CM/ZWJ treated as AL
    let cur = if cur_raw == cls_CM || cur_raw == cls_ZWJ {
      cls_AL
    } else {
      cur_raw
    }

    if prev == cls_WJ || cur == cls_WJ {
      decision = 0 // LB11
    } else if prev == cls_GL {
      decision = 0 // LB12
    } else if cur == cls_GL && prev != cls_SP && prev != cls_BA && prev != cls_HY {
      decision = 0 // LB12a
    } else if cur == cls_CL || cur == cls_CP || cur == cls_EX || cur == cls_SY {
      decision = 0 // LB13
    } else if after_op_sp {
      decision = 0 // LB14
    } else if after_qu_pi_sp {
      decision = 0 // LB15a
    } else {
      // Rules below may need 1-base lookahead; populate cache lazily
      let mut decided = false

      // LB15b: × QU_Pf ( SP | GL | WJ | CL | QU | CP | EX | IS | SY | BK | CR | LF | NL | ZW | eot )
      if cur_qu_pf {
        if la_from != next_pos {
          let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
          la_from = next_pos
          la_found = f
          la_next_pos = np
          la_eff = ef
          la_flags = fl
        }
        if !la_found || is_lb15b_after(la_eff) {
          decision = 0
          decided = true
        }
      }

      // LB15c: SP ÷ IS NU
      if !decided && prev == cls_SP && cur == cls_IS {
        if la_from != next_pos {
          let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
          la_from = next_pos
          la_found = f
          la_next_pos = np
          la_eff = ef
          la_flags = fl
        }
        if la_found && la_eff == cls_NU {
          decision = 1
          decided = true
        }
      }

      if !decided {
        if cur == cls_IS {
          decision = 0 // LB15d
        } else if after_cl_cp_sp && cur == cls_NS {
          decision = 0 // LB16
        } else if after_b2_sp && cur == cls_B2 {
          decision = 0 // LB17
        } else if prev == cls_SP {
          decision = 1 // LB18
        } else if (cur == cls_QU && !cur_qu_pi) || (prev == cls_QU && !prev_qu_pf) {
          decision = 0 // LB19
        } else {
          // LB19a before QU: [^$EastAsian] × QU ; × QU ( [^$EastAsian] | eot )
          if cur == cls_QU {
            if !prev_is_ea {
              decision = 0
              decided = true
            } else {
              if la_from != next_pos {
                let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                la_from = next_pos
                la_found = f
                la_next_pos = np
                la_eff = ef
                la_flags = fl
              }
              if !la_found || (la_flags & flag_ea) == 0 {
                decision = 0
                decided = true
              }
            }
          }
          if !decided {
            if prev == cls_QU && (!cur_ea || qu_after_non_ea) {
              decision = 0 // LB19a after QU
            } else if prev == cls_CB || cur == cls_CB {
              decision = 1 // LB20
            } else if after_word_init_hy && cur == cls_AL {
              decision = 0 // LB20a (Unicode 16.0.0)
            } else if cur == cls_BA || cur == cls_HY || cur == cls_NS || prev == cls_BB {
              decision = 0 // LB21
            } else if after_hl_hy_ba && cur != cls_HL {
              decision = 0 // LB21a
            } else if prev == cls_SY && cur == cls_HL {
              decision = 0 // LB21b
            } else if cur == cls_IN {
              decision = 0 // LB22
            } else if ((prev == cls_AL || prev == cls_HL) && cur == cls_NU) ||
            (prev == cls_NU && (cur == cls_AL || cur == cls_HL)) {
              decision = 0 // LB23
            } else if (prev == cls_PR && (cur == cls_ID || cur == cls_EB || cur == cls_EM)) ||
            ((prev == cls_ID || prev == cls_EB || prev == cls_EM) && cur == cls_PO) {
              decision = 0 // LB23a
            } else if ((prev == cls_PR || prev == cls_PO) && (cur == cls_AL || cur == cls_HL)) ||
            ((prev == cls_AL || prev == cls_HL) && (cur == cls_PR || cur == cls_PO)) {
              decision = 0 // LB24
            } else if (nu_state == 2 && (cur == cls_PO || cur == cls_PR)) ||
            (nu_state == 1 && (cur == cls_PO || cur == cls_PR || cur == cls_NU)) ||
            ((prev == cls_PR || prev == cls_PO) && cur == cls_NU) ||
            ((prev == cls_HY || prev == cls_IS) && cur == cls_NU) {
              decision = 0 // LB25 (non-OP branches)
            } else if (prev == cls_PR || prev == cls_PO) && cur == cls_OP {
              // LB25: (PR | PO) × OP NU  and  (PR | PO) × OP IS NU
              if la_from != next_pos {
                let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                la_from = next_pos
                la_found = f
                la_next_pos = np
                la_eff = ef
                la_flags = fl
              }
              if la_found && la_eff == cls_NU {
                decision = 0
              } else if la_found && la_eff == cls_IS {
                let (f2, _, ef2, _) = peek_next_base(s, la_next_pos, n, false)
                decision = if f2 && ef2 == cls_NU { 0 } else { 1 }
              } else {
                decision = 1
              }
            } else if (prev == cls_JL && (cur == cls_JL || cur == cls_JV || cur == cls_H2 || cur == cls_H3)) ||
            ((prev == cls_JV || prev == cls_H2) && (cur == cls_JV || cur == cls_JT)) ||
            ((prev == cls_JT || prev == cls_H3) && cur == cls_JT) {
              decision = 0 // LB26
            } else if (is_hangul(prev) && cur == cls_PO) || (prev == cls_PR && is_hangul(cur)) {
              decision = 0 // LB27
            } else if (prev == cls_AL || prev == cls_HL) && (cur == cls_AL || cur == cls_HL) {
              decision = 0 // LB28
            } else if (prev == cls_AP && (cur == cls_AK || cur == cls_AS || cur_25cc)) ||
            ((prev == cls_AK || prev == cls_AS || prev_25cc) && (cur == cls_VF || cur == cls_VI)) ||
            (after_ak_vi && (cur == cls_AK || cur_25cc)) {
              decision = 0 // LB28a (non-lookahead branches)
            } else if (prev == cls_AK || prev == cls_AS || prev_25cc) &&
            (cur == cls_AK || cur == cls_AS || cur_25cc) {
              // LB28a: (AK | ◌ | AS) × (AK | ◌ | AS) VF
              if la_from != next_pos {
                let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                la_from = next_pos
                la_found = f
                la_next_pos = np
                la_eff = ef
                la_flags = fl
              }
              if la_found && la_eff == cls_VF {
                decision = 0
              } else {
                decision = 1
              }
            } else if prev == cls_IS && (cur == cls_AL || cur == cls_HL) {
              decision = 0 // LB29
            } else if ((prev == cls_AL || prev == cls_HL || prev == cls_NU) && cur == cls_OP && !cur_ea) ||
            (prev == cls_CP && !prev_is_ea && (cur == cls_AL || cur == cls_HL || cur == cls_NU)) {
              decision = 0 // LB30
            } else if prev == cls_RI && cur == cls_RI && ri_odd {
              decision = 0 // LB30a
            } else if (prev == cls_EB || prev_ep_cn) && cur == cls_EM {
              decision = 0 // LB30b
            } else {
              decision = 1 // LB31
            }
          }
        }
      }
    }
  }

  // State update
  raw_prev_zwj = cur_raw == cls_ZWJ
  if !((cur_raw == cls_CM || cur_raw == cls_ZWJ) && !is_lb9_no_base(prev)) {
    let cur = if cur_raw == cls_CM || cur_raw == cls_ZWJ {
      cls_AL
    } else {
      cur_raw
    }

    if cur != cls_SP {
      after_zw_sp = cur == cls_ZW
      after_op_sp = cur == cls_OP
      after_qu_pi_sp = cur_qu_pi && is_lb15a_before(prev)
      after_cl_cp_sp = cur == cls_CL || cur == cls_CP
      after_b2_sp = cur == cls_B2
    }

    qu_after_non_ea = cur == cls_QU && !prev_is_ea
    after_word_init_hy = (cur == cls_HY || cur_2010) && is_lb20a_before(prev)
    // LB21a: HL (HY | [BA - $EastAsian]) × [^HL]
    after_hl_hy_ba = prev == cls_HL &&
    (cur == cls_HY || (cur == cls_BA && !cur_ea))
    after_ak_vi = (prev == cls_AK || prev == cls_AS || prev_25cc) && cur == cls_VI

    if cur == cls_NU {
      nu_state = 1
    } else if nu_state == 1 && (cur == cls_SY || cur == cls_IS) {
      nu_state = 1
    } else if nu_state == 1 && (cur == cls_CL || cur == cls_CP) {
      nu_state = 2
    } else {
      nu_state = 0
    }

    if cur == cls_RI {
      ri_odd = !ri_odd
    } else {
      ri_odd = false
    }

    prev = cur
    prev_is_ea = cur_ea
    prev_qu_pi = cur_qu_pi
    prev_qu_pf = cur_qu_pf
    prev_ep_cn = cur_ep_cn
    prev_2010 = cur_2010
    prev_25cc = cur_25cc
  }

  ctx.prev = prev
  ctx.nu_state = nu_state
  ctx.prev_is_ea = prev_is_ea
  ctx.raw_prev_zwj = raw_prev_zwj
  ctx.prev_qu_pi = prev_qu_pi
  ctx.prev_qu_pf = prev_qu_pf
  ctx.prev_ep_cn = prev_ep_cn
  ctx.prev_2010 = prev_2010
  ctx.prev_25cc = prev_25cc
  ctx.after_zw_sp = after_zw_sp
  ctx.after_op_sp = after_op_sp
  ctx.after_qu_pi_sp = after_qu_pi_sp
  ctx.after_cl_cp_sp = after_cl_cp_sp
  ctx.after_b2_sp = after_b2_sp
  ctx.qu_after_non_ea = qu_after_non_ea
  ctx.after_word_init_hy = after_word_init_hy
  ctx.after_hl_hy_ba = after_hl_hy_ba
  ctx.after_ak_vi = after_ak_vi
  ctx.ri_odd = ri_odd
  ctx.la_from = la_from
  ctx.la_found = la_found
  ctx.la_next_pos = la_next_pos
  ctx.la_eff = la_eff
  ctx.la_flags = la_flags
  ctx.ctx_dirty = raw_prev_zwj ||
  after_zw_sp ||
  after_op_sp ||
  after_qu_pi_sp ||
  after_cl_cp_sp ||
  after_b2_sp ||
  qu_after_non_ea ||
  after_word_init_hy ||
  after_hl_hy_ba ||
  after_ak_vi ||
  ri_odd ||
  prev_qu_pi ||
  prev_qu_pf ||
  prev_ep_cn ||
  prev_2010 ||
  prev_25cc

  decision
}

///| Core single-pass UAX #14 engine starting at `start_pos` (0 or a verified
///| backward state-reset anchor).
///| When `find_after >= 0`, stops immediately on the first break opportunity
///| strictly greater than `find_after` (used by `next_break_opportunity`).
///| When `max_opps >= 0`, returns `Err(LineBreakError::LimitExceeded)` if the
///| number of emitted opportunities would exceed `max_opps`.
fn run_linebreak(
  s : String,
  start_pos : Int,
  max_opps : Int,
  find_after : Int,
) -> Result[(Array[BreakOpportunity], Option[BreakOpportunity]), LineBreakError] {
  let n = s.length()
  if n == 0 {
    return Ok(([], None))
  }
  if find_after >= n {
    return Ok(([], None))
  }
  let out : Array[BreakOpportunity] = if find_after >= 0 {
    []
  } else {
    let est = (n >> 2) + 8
    let cap = if max_opps >= 0 && max_opps < est { max_opps } else { est }
    Array::with_capacity(cap)
  }

  // Hoist unified lookup table blob into a single local String
  let tbl = table_blob

  // Decode first code point at `start_pos` (LB2: never break at sot)
  let (cp0, pos0) = decode_utf8_lossy(s, start_pos, n)
  let cid0 = lookup_combo(cp0)
  let raw0 = combo_res_cls(cid0)
  let flags0 = combo_flags(cid0)

  let mut raw_prev_zwj = raw0 == cls_ZWJ
  let mut prev_is_ea = (flags0 & flag_ea) != 0
  let mut p_qu_pi = (flags0 & flag_qu_pi) != 0
  let mut p_qu_pf = (flags0 & flag_qu_pf) != 0
  let mut p_ep_cn = (flags0 & flag_ep_cn) != 0
  let mut p_2010 = (flags0 & flag_u2010) != 0
  let mut p_25cc = (flags0 & flag_u25cc) != 0

  let mut prev = if raw0 == cls_CM || raw0 == cls_ZWJ {
    // LB10: treat remaining CM/ZWJ as U+0041 (AL, EA=Na, no extended flags)
    prev_is_ea = false
    p_qu_pi = false
    p_qu_pf = false
    p_ep_cn = false
    p_2010 = false
    p_25cc = false
    cls_AL
  } else {
    raw0
  }

  let mut nu_state = if prev == cls_NU { 1 } else { 0 }
  let init_zw = prev == cls_ZW
  let init_op = prev == cls_OP
  let init_cl_cp = prev == cls_CL || prev == cls_CP
  let init_b2 = prev == cls_B2
  let init_qu = prev == cls_QU
  let init_hy = prev == cls_HY || p_2010
  let init_ri = prev == cls_RI
  let mut ctx_dirty = raw_prev_zwj ||
  init_zw ||
  init_op ||
  p_qu_pi ||
  init_cl_cp ||
  init_b2 ||
  init_qu ||
  init_hy ||
  init_ri ||
  p_qu_pf ||
  p_ep_cn ||
  p_2010 ||
  p_25cc

  let ctx = SlowCtx::{
    prev: prev,
    nu_state: nu_state,
    prev_is_ea: prev_is_ea,
    raw_prev_zwj: raw_prev_zwj,
    ctx_dirty: ctx_dirty,
    prev_qu_pi: p_qu_pi,
    prev_qu_pf: p_qu_pf,
    prev_ep_cn: p_ep_cn,
    prev_2010: p_2010,
    prev_25cc: p_25cc,
    after_zw_sp: init_zw,
    after_op_sp: init_op,
    after_qu_pi_sp: p_qu_pi,
    after_cl_cp_sp: init_cl_cp,
    after_b2_sp: init_b2,
    qu_after_non_ea: init_qu,
    after_word_init_hy: init_hy,
    after_hl_hy_ba: false,
    after_ak_vi: false,
    ri_odd: init_ri,
    la_from: -1,
    la_found: false,
    la_next_pos: 0,
    la_eff: -1,
    la_flags: 0,
  }

  let mut pos = pos0
  while pos < n {
    let cur_byte_offset = pos
    let b0 = s.code_unit_at(pos)
    let mut next_pos = pos + 1
    let mut cur_raw = 0
    let mut cur_flags = 0
    if b0 < 128 {
      cur_raw = tbl.code_unit_at(b0) - 35
      if !ctx_dirty && cur_raw != cls_OP && cur_raw != cls_CL && cur_raw != cls_CP {
        let act = tbl.code_unit_at(blob_off_pair + ((prev << 6) | cur_raw)) - 35
        if act < 5 && (act & 1) == 0 {
          if act < 4 {
            nu_state = act >> 1
          }
          prev = cur_raw
          prev_is_ea = false
          pos = next_pos
          continue
        }
      }
    } else {
      let packed = decode_and_lookup_non_ascii(s, pos, n, b0, tbl)
      next_pos = pos + (packed & 7)
      cur_raw = (packed >> 3) & 63
      cur_flags = packed >> 9
      if !ctx_dirty &&
      cur_flags <= 1 &&
      cur_raw != cls_OP &&
      cur_raw != cls_CL &&
      cur_raw != cls_CP {
        let act = tbl.code_unit_at(blob_off_pair + ((prev << 6) | cur_raw)) - 35
        if act < 5 && (act & 1) == 0 {
          if act < 4 {
            nu_state = act >> 1
          }
          prev = cur_raw
          prev_is_ea = cur_flags != 0
          pos = next_pos
          continue
        }
      }
    }

    ctx.prev = prev
    ctx.nu_state = nu_state
    ctx.prev_is_ea = prev_is_ea
    ctx.raw_prev_zwj = raw_prev_zwj
    let decision = slow_step(ctx, s, n, next_pos, cur_raw, cur_flags)
    if decision != 0 {
      let kind = if decision == 2 { BreakKind::Mandatory } else { BreakKind::Allowed }
      if find_after >= 0 {
        if cur_byte_offset > find_after {
          return Ok(
            (
              out,
              Some(BreakOpportunity::{ byte_offset: cur_byte_offset, kind: kind }),
            ),
          )
        }
      } else {
        if max_opps >= 0 && out.length() >= max_opps {
          return Err(LineBreakError::LimitExceeded)
        }
        out.push(BreakOpportunity::{ byte_offset: cur_byte_offset, kind: kind })
      }
    }
    prev = ctx.prev
    nu_state = ctx.nu_state
    prev_is_ea = ctx.prev_is_ea
    raw_prev_zwj = ctx.raw_prev_zwj
    ctx_dirty = ctx.ctx_dirty
    pos = next_pos
  }

  // LB3: Always break at end of text (Mandatory)
  let eot = BreakOpportunity::new(n, BreakKind::Mandatory)
  if find_after >= 0 {
    return Ok((out, Some(eot)))
  }
  if max_opps >= 0 && out.length() >= max_opps {
    return Err(LineBreakError::LimitExceeded)
  }
  out.push(eot)
  Ok((out, None))
}

///| Compute all Unicode 16.0.0 UAX #14 line break opportunities for `s`.
///| Empty input returns an empty array `[]`.
///| Non-empty input always ends with `(s.length(), BreakKind::Mandatory)`.
pub fn line_breaks(s : String) -> Array[BreakOpportunity] {
  let n = s.length()
  if n == 0 {
    return []
  }
  let out : Array[BreakOpportunity] = Array::with_capacity((n >> 2) + 8)
  let tbl = table_blob

  // Decode first code point at byte 0 (LB2: never break at sot)
  let (cp0, pos0) = decode_utf8_lossy(s, 0, n)
  let cid0 = lookup_combo(cp0)
  let raw0 = combo_res_cls(cid0)
  let flags0 = combo_flags(cid0)

  let mut raw_prev_zwj = raw0 == cls_ZWJ
  let mut prev_is_ea = (flags0 & flag_ea) != 0
  let mut p_qu_pi = (flags0 & flag_qu_pi) != 0
  let mut p_qu_pf = (flags0 & flag_qu_pf) != 0
  let mut p_ep_cn = (flags0 & flag_ep_cn) != 0
  let mut p_2010 = (flags0 & flag_u2010) != 0
  let mut p_25cc = (flags0 & flag_u25cc) != 0

  let mut prev = if raw0 == cls_CM || raw0 == cls_ZWJ {
    prev_is_ea = false
    p_qu_pi = false
    p_qu_pf = false
    p_ep_cn = false
    p_2010 = false
    p_25cc = false
    cls_AL
  } else {
    raw0
  }

  let mut nu_state = if prev == cls_NU { 1 } else { 0 }
  let init_zw = prev == cls_ZW
  let init_op = prev == cls_OP
  let init_cl_cp = prev == cls_CL || prev == cls_CP
  let init_b2 = prev == cls_B2
  let init_qu = prev == cls_QU
  let init_hy = prev == cls_HY || p_2010
  let init_ri = prev == cls_RI
  let mut ctx_dirty = raw_prev_zwj ||
  init_zw ||
  init_op ||
  p_qu_pi ||
  init_cl_cp ||
  init_b2 ||
  init_qu ||
  init_hy ||
  init_ri ||
  p_qu_pf ||
  p_ep_cn ||
  p_2010 ||
  p_25cc

  let ctx = SlowCtx::{
    prev: prev,
    nu_state: nu_state,
    prev_is_ea: prev_is_ea,
    raw_prev_zwj: raw_prev_zwj,
    ctx_dirty: ctx_dirty,
    prev_qu_pi: p_qu_pi,
    prev_qu_pf: p_qu_pf,
    prev_ep_cn: p_ep_cn,
    prev_2010: p_2010,
    prev_25cc: p_25cc,
    after_zw_sp: init_zw,
    after_op_sp: init_op,
    after_qu_pi_sp: p_qu_pi,
    after_cl_cp_sp: init_cl_cp,
    after_b2_sp: init_b2,
    qu_after_non_ea: init_qu,
    after_word_init_hy: init_hy,
    after_hl_hy_ba: false,
    after_ak_vi: false,
    ri_odd: init_ri,
    la_from: -1,
    la_found: false,
    la_next_pos: 0,
    la_eff: -1,
    la_flags: 0,
  }

  let mut pos = pos0
  while pos < n {
    let cur_byte_offset = pos
    let b0 = s.code_unit_at(pos)
    let mut next_pos = pos + 1
    let mut cur_raw = 0
    let mut cur_flags = 0
    if b0 < 128 {
      cur_raw = tbl.code_unit_at(b0) - 35
      // Fast path: ASCII AL following AL (no ZWJ) -> LB28 no break
      if cur_raw == cls_AL && prev == cls_AL && !raw_prev_zwj {
        prev_is_ea = false
        if ctx_dirty {
          ctx.prev_25cc = false
          ctx.prev_ep_cn = false
          ctx_dirty = false
        }
        pos = next_pos
        while pos < n {
          let bn = s.code_unit_at(pos)
          if (bn >= 97 && bn <= 122) || (bn >= 65 && bn <= 90) {
            pos = pos + 1
          } else {
            break
          }
        }
        continue
      }
      if !ctx_dirty {
        let act = tbl.code_unit_at(blob_off_pair + ((prev << 6) | cur_raw)) - 35
        if act < 5 {
          if (act & 1) != 0 {
            out.push(
              BreakOpportunity::{
                byte_offset: cur_byte_offset,
                kind: BreakKind::Allowed,
              },
            )
          }
          if act < 4 {
            nu_state = act >> 1
          }
          prev = cur_raw
          prev_is_ea = false
          pos = next_pos
          if cur_raw == cls_AL {
            while pos < n {
              let bn = s.code_unit_at(pos)
              if (bn >= 97 && bn <= 122) || (bn >= 65 && bn <= 90) {
                pos = pos + 1
              } else if bn == 32 && pos + 1 < n {
                let b1 = s.code_unit_at(pos + 1)
                if (b1 >= 97 && b1 <= 122) || (b1 >= 65 && b1 <= 90) {
                  out.push(
                    BreakOpportunity::{
                      byte_offset: pos + 1,
                      kind: BreakKind::Allowed,
                    },
                  )
                  pos = pos + 2
                } else {
                  break
                }
              } else {
                break
              }
            }
          } else if cur_raw == cls_NU {
            while pos < n {
              let bn = s.code_unit_at(pos)
              if bn >= 48 && bn <= 57 {
                pos = pos + 1
              } else {
                break
              }
            }
          }
          continue
        } else if act < 9 {
          nu_state = 0
          prev = act + 38
          prev_is_ea = false
          pos = next_pos
          continue
        } else if act == 9 {
          out.push(
            BreakOpportunity::{
              byte_offset: cur_byte_offset,
              kind: BreakKind::Allowed,
            },
          )
          nu_state = 0
          prev = 46
          prev_is_ea = false
          pos = next_pos
          continue
        } else if act < 12 {
          out.push(
            BreakOpportunity::{
              byte_offset: cur_byte_offset,
              kind: BreakKind::Mandatory,
            },
          )
          nu_state = act - 10
          prev = cur_raw
          prev_is_ea = false
          pos = next_pos
          if cur_raw == cls_AL {
            while pos < n {
              let bn = s.code_unit_at(pos)
              if (bn >= 97 && bn <= 122) || (bn >= 65 && bn <= 90) {
                pos = pos + 1
              } else if bn == 32 && pos + 1 < n {
                let b1 = s.code_unit_at(pos + 1)
                if (b1 >= 97 && b1 <= 122) || (b1 >= 65 && b1 <= 90) {
                  out.push(
                    BreakOpportunity::{
                      byte_offset: pos + 1,
                      kind: BreakKind::Allowed,
                    },
                  )
                  pos = pos + 2
                } else {
                  break
                }
              } else {
                break
              }
            }
          }
          continue
        }
      }
    } else {
      // Inline CJK ID ÷ ID tight loop (U+5000..U+9FFF)
      if b0 >= 0xE5 && b0 <= 0xE9 && !ctx_dirty && prev == cls_ID && pos + 2 < n {
        let b1 = s.code_unit_at(pos + 1)
        let b2 = s.code_unit_at(pos + 2)
        if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
          out.push(
            BreakOpportunity::{
              byte_offset: cur_byte_offset,
              kind: BreakKind::Allowed,
            },
          )
          // Every code point consumed here is East Asian Wide (LB19a)
          prev_is_ea = true
          pos = pos + 3
          while pos + 2 < n {
            let c0 = s.code_unit_at(pos)
            if c0 >= 0xE5 && c0 <= 0xE9 {
              let c1 = s.code_unit_at(pos + 1)
              let c2 = s.code_unit_at(pos + 2)
              if (c1 & 0xC0) == 0x80 && (c2 & 0xC0) == 0x80 {
                out.push(
                  BreakOpportunity::{
                    byte_offset: pos,
                    kind: BreakKind::Allowed,
                  },
                )
                pos = pos + 3
                continue
              }
            }
            break
          }
          continue
        }
      }
      let packed = decode_and_lookup_non_ascii(s, pos, n, b0, tbl)
      next_pos = pos + (packed & 7)
      cur_raw = (packed >> 3) & 63
      cur_flags = packed >> 9
      if !ctx_dirty &&
      (cur_flags == 0 ||
        (cur_flags == 1 &&
          cur_raw != cls_OP &&
          cur_raw != cls_CP &&
          cur_raw != cls_QU)) {
        let act = tbl.code_unit_at(blob_off_pair + ((prev << 6) | cur_raw)) - 35
        if act < 5 {
          if (act & 1) != 0 {
            out.push(
              BreakOpportunity::{
                byte_offset: cur_byte_offset,
                kind: BreakKind::Allowed,
              },
            )
          }
          if act < 4 {
            nu_state = act >> 1
          }
          prev = cur_raw
          prev_is_ea = cur_flags != 0
          pos = next_pos
          continue
        } else if act < 9 {
          nu_state = 0
          prev = act + 38
          prev_is_ea = cur_flags != 0
          pos = next_pos
          continue
        } else if act == 9 {
          out.push(
            BreakOpportunity::{
              byte_offset: cur_byte_offset,
              kind: BreakKind::Allowed,
            },
          )
          nu_state = 0
          prev = 46
          prev_is_ea = cur_flags != 0
          pos = next_pos
          continue
        } else if act < 12 {
          out.push(
            BreakOpportunity::{
              byte_offset: cur_byte_offset,
              kind: BreakKind::Mandatory,
            },
          )
          nu_state = act - 10
          prev = cur_raw
          prev_is_ea = cur_flags != 0
          pos = next_pos
          continue
        }
      }
    }

    if prev == cls_OP {
      ctx.after_op_sp = true
      ctx.prev = cls_OP
    } else if prev == cls_CL {
      ctx.after_cl_cp_sp = true
      ctx.prev = cls_CL
    } else if prev == 43 {
      ctx.after_op_sp = true
      ctx.prev = cls_SP
    } else if prev == 44 {
      ctx.after_cl_cp_sp = true
      ctx.prev = cls_SP
    } else if prev == 45 {
      ctx.after_cl_cp_sp = true
      ctx.prev = cls_CP
    } else if prev == 46 {
      ctx.prev = cls_QU
    } else {
      ctx.prev = prev
    }
    ctx.nu_state = nu_state
    ctx.prev_is_ea = prev_is_ea
    ctx.raw_prev_zwj = raw_prev_zwj
    let decision = slow_step(ctx, s, n, next_pos, cur_raw, cur_flags)
    if decision != 0 {
      let kind = if decision == 2 {
        BreakKind::Mandatory
      } else {
        BreakKind::Allowed
      }
      out.push(BreakOpportunity::{ byte_offset: cur_byte_offset, kind: kind })
    }
    prev = ctx.prev
    nu_state = ctx.nu_state
    prev_is_ea = ctx.prev_is_ea
    raw_prev_zwj = ctx.raw_prev_zwj
    ctx_dirty = ctx.ctx_dirty
    pos = next_pos
  }

  out.push(BreakOpportunity::{ byte_offset: n, kind: BreakKind::Mandatory })
  out
}

///| Compute all Unicode 16.0.0 UAX #14 line break opportunities for `s`,
///| enforcing `limits`. Any negative limit immediately returns
///| `Err(LineBreakError::LimitExceeded)`; `0` is enforced strictly.
pub fn line_breaks_with_limits(
  s : String,
  limits : LineBreakLimits,
) -> Result[Array[BreakOpportunity], LineBreakError] {
  if limits.max_input_bytes < 0 || limits.max_opportunities < 0 {
    return Err(LineBreakError::LimitExceeded)
  }
  if s.length() > limits.max_input_bytes {
    return Err(LineBreakError::LimitExceeded)
  }
  match run_linebreak(s, 0, limits.max_opportunities, -1) {
    Ok((arr, _)) => Ok(arr)
    Err(e) => Err(e)
  }
}

///| Return the first break opportunity strictly after `byte_offset`.
///| Negative offsets behave as `0`; offsets at or past `s.length()` return `None`.
///| Mid-UTF-8 byte offsets safely return the next valid UTF-8 boundary break opportunity.
///| Uses a backward state-reset anchor so iterative traversal is O(n) total.
pub fn next_break_opportunity(s : String, byte_offset : Int) -> Option[BreakOpportunity] {
  let n = s.length()
  if n == 0 || byte_offset >= n {
    return None
  }
  let target = if byte_offset < 0 { 0 } else { byte_offset }
  let anchor = find_backward_anchor(s, target, n)
  match run_linebreak(s, anchor, -1, target) {
    Ok((_, opt)) => opt
    Err(_) => None
  }
}

///| Resumable O(n) worst-case streaming iterator over Unicode 16.0.0 UAX #14
///| line break opportunities for any input string (including pure non-anchor
///| punctuation streams such as `"- "` or `"\" "` repeated).
pub struct LineBreakIter {
  s : String
  n : Int
  mut pos : Int
  mut initialized : Bool
  mut done : Bool
  mut prev : Int
  mut raw_prev_zwj : Bool
  mut prev_is_ea : Bool
  mut prev_qu_pi : Bool
  mut prev_qu_pf : Bool
  mut prev_ep_cn : Bool
  mut prev_2010 : Bool
  mut prev_25cc : Bool
  mut after_zw_sp : Bool
  mut after_op_sp : Bool
  mut after_qu_pi_sp : Bool
  mut after_cl_cp_sp : Bool
  mut after_b2_sp : Bool
  mut qu_after_non_ea : Bool
  mut after_word_init_hy : Bool
  mut after_hl_hy_ba : Bool
  mut nu_state : Int
  mut after_ak_vi : Bool
  mut ri_odd : Bool
  mut ctx_dirty : Bool
  mut la_from : Int
  mut la_found : Bool
  mut la_next_pos : Int
  mut la_eff : Int
  mut la_flags : Int
}

///| Construct a resumable streaming iterator over all UAX #14 break opportunities
///| in `s`. Yields the exact same sequence as `line_breaks(s)` in strict worst-case
///| O(n) time and O(1) auxiliary memory.
pub fn line_break_iter(s : String) -> LineBreakIter {
  let n = s.length()
  LineBreakIter::{
    s: s,
    n: n,
    pos: 0,
    initialized: false,
    done: n == 0,
    prev: 0,
    raw_prev_zwj: false,
    prev_is_ea: false,
    prev_qu_pi: false,
    prev_qu_pf: false,
    prev_ep_cn: false,
    prev_2010: false,
    prev_25cc: false,
    after_zw_sp: false,
    after_op_sp: false,
    after_qu_pi_sp: false,
    after_cl_cp_sp: false,
    after_b2_sp: false,
    qu_after_non_ea: false,
    after_word_init_hy: false,
    after_hl_hy_ba: false,
    nu_state: 0,
    after_ak_vi: false,
    ri_odd: false,
    ctx_dirty: false,
    la_from: -1,
    la_found: false,
    la_next_pos: 0,
    la_eff: -1,
    la_flags: 0,
  }
}

///| Advance the iterator to the next UAX #14 line break opportunity.
///| Returns `None` once all opportunities (including end-of-text Mandatory) have been yielded.
pub fn LineBreakIter::next(self : LineBreakIter) -> Option[BreakOpportunity] {
  if self.done {
    return None
  }
  let s = self.s
  let n = self.n
  if !self.initialized {
    self.initialized = true
    let (cp0, pos0) = decode_utf8_lossy(s, 0, n)
    let cid0 = lookup_combo(cp0)
    let raw0 = combo_res_cls(cid0)
    let flags0 = combo_flags(cid0)
    self.raw_prev_zwj = raw0 == cls_ZWJ
    if raw0 == cls_CM || raw0 == cls_ZWJ {
      self.prev = cls_AL
      self.prev_is_ea = false
      self.prev_qu_pi = false
      self.prev_qu_pf = false
      self.prev_ep_cn = false
      self.prev_2010 = false
      self.prev_25cc = false
    } else {
      self.prev = raw0
      self.prev_is_ea = (flags0 & flag_ea) != 0
      self.prev_qu_pi = (flags0 & flag_qu_pi) != 0
      self.prev_qu_pf = (flags0 & flag_qu_pf) != 0
      self.prev_ep_cn = (flags0 & flag_ep_cn) != 0
      self.prev_2010 = (flags0 & flag_u2010) != 0
      self.prev_25cc = (flags0 & flag_u25cc) != 0
    }
    self.after_zw_sp = self.prev == cls_ZW
    self.after_op_sp = self.prev == cls_OP
    self.after_qu_pi_sp = self.prev_qu_pi
    self.after_cl_cp_sp = self.prev == cls_CL || self.prev == cls_CP
    self.after_b2_sp = self.prev == cls_B2
    self.qu_after_non_ea = self.prev == cls_QU
    self.after_word_init_hy = self.prev == cls_HY || self.prev_2010
    self.after_hl_hy_ba = false
    self.nu_state = if self.prev == cls_NU { 1 } else { 0 }
    self.after_ak_vi = false
    self.ri_odd = self.prev == cls_RI
    self.ctx_dirty = self.raw_prev_zwj ||
    self.after_zw_sp ||
    self.after_op_sp ||
    self.after_qu_pi_sp ||
    self.after_cl_cp_sp ||
    self.after_b2_sp ||
    self.qu_after_non_ea ||
    self.after_word_init_hy ||
    self.after_hl_hy_ba ||
    self.after_ak_vi ||
    self.ri_odd ||
    self.prev_qu_pi ||
    self.prev_qu_pf ||
    self.prev_ep_cn ||
    self.prev_2010 ||
    self.prev_25cc
    self.pos = pos0
  }

  let tbl = table_blob

  while self.pos < n {
    let cur_byte_offset = self.pos
    let b0 = s.code_unit_at(cur_byte_offset)
    let mut next_pos = cur_byte_offset + 1
    let mut cur_raw = 0
    let mut cur_flags = 0
    if b0 < 128 {
      cur_raw = tbl.code_unit_at(b0) - 35
      if cur_raw == cls_AL && self.prev == cls_AL && !self.raw_prev_zwj {
        self.prev_is_ea = false
        self.prev_25cc = false
        self.prev_ep_cn = false
        let mut p = next_pos
        while p < n {
          let bn = s.code_unit_at(p)
          if (bn >= 97 && bn <= 122) || (bn >= 65 && bn <= 90) {
            p = p + 1
          } else {
            break
          }
        }
        self.pos = p
        continue
      }
      if cur_raw == cls_NU && self.prev == cls_NU && !self.ctx_dirty {
        self.prev_is_ea = false
        let mut p = next_pos
        while p < n {
          let bn = s.code_unit_at(p)
          if bn >= 48 && bn <= 57 {
            p = p + 1
          } else {
            break
          }
        }
        self.pos = p
        continue
      }
    } else {
      let packed = decode_and_lookup_non_ascii(s, cur_byte_offset, n, b0, tbl)
      next_pos = cur_byte_offset + (packed & 7)
      cur_raw = (packed >> 3) & 63
      cur_flags = packed >> 9
    }

    if !self.ctx_dirty &&
    cur_flags <= 1 &&
    cur_raw != cls_OP &&
    cur_raw != cls_CL &&
    cur_raw != cls_CP {
      let act = tbl.code_unit_at(blob_off_pair + ((self.prev << 6) | cur_raw)) - 35
      if act < 5 {
        if act == 0 || act == 1 {
          self.nu_state = 0
        } else if act == 2 || act == 3 {
          self.nu_state = 1
        }
        self.prev = cur_raw
        self.prev_is_ea = cur_flags != 0
        self.pos = next_pos
        if act == 1 || act == 3 {
          return Some(BreakOpportunity::new(cur_byte_offset, BreakKind::Allowed))
        }
        continue
      }
    }

    let is_cur_cm_zwj = cur_raw == cls_CM || cur_raw == cls_ZWJ
    let is_lb10 = is_cur_cm_zwj && is_lb9_no_base(self.prev)
    let cur_ea = if is_lb10 { false } else { (cur_flags & flag_ea) != 0 }
    let cur_qu_pi = if is_lb10 { false } else { (cur_flags & flag_qu_pi) != 0 }
    let cur_qu_pf = if is_lb10 { false } else { (cur_flags & flag_qu_pf) != 0 }
    let cur_ep_cn = if is_lb10 { false } else { (cur_flags & flag_ep_cn) != 0 }
    let cur_2010 = if is_lb10 { false } else { (cur_flags & flag_u2010) != 0 }
    let cur_25cc = if is_lb10 { false } else { (cur_flags & flag_u25cc) != 0 }

    let mut decision = 0
    if self.prev == cls_BK {
      decision = 2
    } else if self.prev == cls_CR && cur_raw == cls_LF {
      decision = 0
    } else if self.prev == cls_CR || self.prev == cls_LF || self.prev == cls_NL {
      decision = 2
    } else if is_hard_break(cur_raw) {
      decision = 0
    } else if cur_raw == cls_SP || cur_raw == cls_ZW {
      decision = 0
    } else if self.after_zw_sp {
      decision = 1
    } else if self.raw_prev_zwj {
      decision = 0
    } else if is_cur_cm_zwj && !is_lb9_no_base(self.prev) {
      decision = 0
    } else {
      let cur = if is_cur_cm_zwj { cls_AL } else { cur_raw }
      if self.prev == cls_WJ || cur == cls_WJ {
        decision = 0
      } else if self.prev == cls_GL {
        decision = 0
      } else if cur == cls_GL &&
      self.prev != cls_SP &&
      self.prev != cls_BA &&
      self.prev != cls_HY {
        decision = 0
      } else if cur == cls_CL || cur == cls_CP || cur == cls_EX || cur == cls_SY {
        decision = 0
      } else if self.after_op_sp {
        decision = 0
      } else if self.after_qu_pi_sp {
        decision = 0
      } else {
        let mut decided = false
        if cur_qu_pf {
          if self.la_from != next_pos {
            let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
            self.la_from = next_pos
            self.la_found = f
            self.la_next_pos = np
            self.la_eff = ef
            self.la_flags = fl
          }
          if !self.la_found || is_lb15b_after(self.la_eff) {
            decision = 0
            decided = true
          }
        }
        if !decided && self.prev == cls_SP && cur == cls_IS {
          if self.la_from != next_pos {
            let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
            self.la_from = next_pos
            self.la_found = f
            self.la_next_pos = np
            self.la_eff = ef
            self.la_flags = fl
          }
          if self.la_found && self.la_eff == cls_NU {
            decision = 1
            decided = true
          }
        }
        if !decided {
          if cur == cls_IS {
            decision = 0
          } else if self.after_cl_cp_sp && cur == cls_NS {
            decision = 0
          } else if self.after_b2_sp && cur == cls_B2 {
            decision = 0
          } else if self.prev == cls_SP {
            decision = 1
          } else if (cur == cls_QU && !cur_qu_pi) ||
          (self.prev == cls_QU && !self.prev_qu_pf) {
            decision = 0
          } else {
            if cur == cls_QU {
              if !self.prev_is_ea {
                decision = 0
                decided = true
              } else {
                if self.la_from != next_pos {
                  let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                  self.la_from = next_pos
                  self.la_found = f
                  self.la_next_pos = np
                  self.la_eff = ef
                  self.la_flags = fl
                }
                if !self.la_found || (self.la_flags & flag_ea) == 0 {
                  decision = 0
                  decided = true
                }
              }
            }
            if !decided {
              if self.prev == cls_QU && (!cur_ea || self.qu_after_non_ea) {
                decision = 0
              } else if self.prev == cls_CB || cur == cls_CB {
                decision = 1
              } else if self.after_word_init_hy && cur == cls_AL {
                decision = 0
              } else if cur == cls_BA ||
              cur == cls_HY ||
              cur == cls_NS ||
              self.prev == cls_BB {
                decision = 0
              } else if self.after_hl_hy_ba && cur != cls_HL {
                decision = 0
              } else if self.prev == cls_SY && cur == cls_HL {
                decision = 0
              } else if cur == cls_IN {
                decision = 0
              } else if ((self.prev == cls_AL || self.prev == cls_HL) &&
                cur == cls_NU) ||
              (self.prev == cls_NU && (cur == cls_AL || cur == cls_HL)) {
                decision = 0
              } else if (self.prev == cls_PR &&
                (cur == cls_ID || cur == cls_EB || cur == cls_EM)) ||
              ((self.prev == cls_ID ||
                self.prev == cls_EB ||
                self.prev == cls_EM) &&
              cur == cls_PO) {
                decision = 0
              } else if ((self.prev == cls_PR || self.prev == cls_PO) &&
                (cur == cls_AL || cur == cls_HL)) ||
              ((self.prev == cls_AL || self.prev == cls_HL) &&
                (cur == cls_PR || cur == cls_PO)) {
                decision = 0
              } else if (self.nu_state == 2 &&
                (cur == cls_PO || cur == cls_PR)) ||
              (self.nu_state == 1 &&
                (cur == cls_PO || cur == cls_PR || cur == cls_NU)) ||
              ((self.prev == cls_PR || self.prev == cls_PO) && cur == cls_NU) ||
              ((self.prev == cls_HY || self.prev == cls_IS) && cur == cls_NU) {
                decision = 0
              } else if (self.prev == cls_PR || self.prev == cls_PO) &&
              cur == cls_OP {
                if self.la_from != next_pos {
                  let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                  self.la_from = next_pos
                  self.la_found = f
                  self.la_next_pos = np
                  self.la_eff = ef
                  self.la_flags = fl
                }
                if self.la_found && self.la_eff == cls_NU {
                  decision = 0
                } else if self.la_found && self.la_eff == cls_IS {
                  let (f2, _, ef2, _) = peek_next_base(
                    s,
                    self.la_next_pos,
                    n,
                    false,
                  )
                  decision = if f2 && ef2 == cls_NU { 0 } else { 1 }
                } else {
                  decision = 1
                }
              } else if (self.prev == cls_JL &&
                (cur == cls_JL ||
                  cur == cls_JV ||
                  cur == cls_H2 ||
                  cur == cls_H3)) ||
              ((self.prev == cls_JV || self.prev == cls_H2) &&
                (cur == cls_JV || cur == cls_JT)) ||
              ((self.prev == cls_JT || self.prev == cls_H3) && cur == cls_JT) {
                decision = 0
              } else if (is_hangul(self.prev) && cur == cls_PO) ||
              (self.prev == cls_PR && is_hangul(cur)) {
                decision = 0
              } else if (self.prev == cls_AL || self.prev == cls_HL) &&
              (cur == cls_AL || cur == cls_HL) {
                decision = 0
              } else if (self.prev == cls_AP &&
                (cur == cls_AK || cur == cls_AS || cur_25cc)) ||
              ((self.prev == cls_AK || self.prev == cls_AS || self.prev_25cc) &&
                (cur == cls_VF || cur == cls_VI)) ||
              (self.after_ak_vi && (cur == cls_AK || cur_25cc)) {
                decision = 0
              } else if (self.prev == cls_AK ||
                self.prev == cls_AS ||
                self.prev_25cc) &&
              (cur == cls_AK || cur == cls_AS || cur_25cc) {
                if self.la_from != next_pos {
                  let (f, np, ef, fl) = peek_next_base(s, next_pos, n, false)
                  self.la_from = next_pos
                  self.la_found = f
                  self.la_next_pos = np
                  self.la_eff = ef
                  self.la_flags = fl
                }
                decision = if self.la_found && self.la_eff == cls_VF {
                  0
                } else {
                  1
                }
              } else if self.prev == cls_IS && (cur == cls_AL || cur == cls_HL) {
                decision = 0
              } else if ((self.prev == cls_AL ||
                self.prev == cls_HL ||
                self.prev == cls_NU) &&
              cur == cls_OP &&
              !cur_ea) ||
              (self.prev == cls_CP &&
                !self.prev_is_ea &&
                (cur == cls_AL || cur == cls_HL || cur == cls_NU)) {
                decision = 0
              } else if self.prev == cls_RI && cur == cls_RI && self.ri_odd {
                decision = 0
              } else if (self.prev == cls_EB || self.prev_ep_cn) &&
              cur == cls_EM {
                decision = 0
              } else {
                decision = 1
              }
            }
          }
        }
      }
    }

    // State update before returning (so iterator is ready for next call)
    self.raw_prev_zwj = cur_raw == cls_ZWJ
    if !(is_cur_cm_zwj && !is_lb9_no_base(self.prev)) {
      let cur = if is_cur_cm_zwj { cls_AL } else { cur_raw }
      if cur != cls_SP {
        self.after_zw_sp = cur == cls_ZW
        self.after_op_sp = cur == cls_OP
        self.after_qu_pi_sp = cur_qu_pi && is_lb15a_before(self.prev)
        self.after_cl_cp_sp = cur == cls_CL || cur == cls_CP
        self.after_b2_sp = cur == cls_B2
      }
      self.qu_after_non_ea = cur == cls_QU && !self.prev_is_ea
      self.after_word_init_hy = (cur == cls_HY || cur_2010) &&
      is_lb20a_before(self.prev)
      self.after_hl_hy_ba = self.prev == cls_HL &&
      (cur == cls_HY || (cur == cls_BA && !cur_ea))
      self.after_ak_vi = (self.prev == cls_AK ||
        self.prev == cls_AS ||
        self.prev_25cc) &&
      cur == cls_VI
      if cur == cls_NU {
        self.nu_state = 1
      } else if self.nu_state == 1 && (cur == cls_SY || cur == cls_IS) {
        self.nu_state = 1
      } else if self.nu_state == 1 && (cur == cls_CL || cur == cls_CP) {
        self.nu_state = 2
      } else {
        self.nu_state = 0
      }
      if cur == cls_RI {
        self.ri_odd = !self.ri_odd
      } else {
        self.ri_odd = false
      }
      self.prev = cur
      self.prev_is_ea = cur_ea
      self.prev_qu_pi = cur_qu_pi
      self.prev_qu_pf = cur_qu_pf
      self.prev_ep_cn = cur_ep_cn
      self.prev_2010 = cur_2010
      self.prev_25cc = cur_25cc
    }
    self.ctx_dirty = self.raw_prev_zwj ||
    self.after_zw_sp ||
    self.after_op_sp ||
    self.after_qu_pi_sp ||
    self.after_cl_cp_sp ||
    self.after_b2_sp ||
    self.qu_after_non_ea ||
    self.after_word_init_hy ||
    self.after_hl_hy_ba ||
    self.after_ak_vi ||
    self.ri_odd ||
    self.prev_qu_pi ||
    self.prev_qu_pf ||
    self.prev_ep_cn ||
    self.prev_2010 ||
    self.prev_25cc
    self.pos = next_pos

    if decision != 0 {
      let kind = if decision == 2 {
        BreakKind::Mandatory
      } else {
        BreakKind::Allowed
      }
      return Some(BreakOpportunity::new(cur_byte_offset, kind))
    }
  }

  // LB3: Always break at end of text (Mandatory)
  self.done = true
  Some(BreakOpportunity::new(n, BreakKind::Mandatory))
}
