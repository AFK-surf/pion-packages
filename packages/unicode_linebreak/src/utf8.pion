///| Safe UTF-8 decoding helpers for `packages/unicode_linebreak`.
///| Invalid UTF-8 sequences decode to U+FFFD following the Unicode maximal
///| subpart rule and always advance at least 1 byte (never panics or loops).

///| Decode one Unicode scalar value starting at `s[pos..end]`.
///| Returns `(codepoint, next_pos)`.
fn decode_utf8_lossy(s : String, pos : Int, end : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xE0 {
        b1 > 0x9F && b1 < 0xC0
      } else if b0 == 0xED {
        b1 >= 0x80 && b1 <= 0x9F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
            return (cp, pos + 3)
          }
        }
        return (0xFFFD, pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xF0 {
        b1 >= 0x90 && b1 <= 0xBF
      } else if b0 == 0xF4 {
        b1 >= 0x80 && b1 <= 0x8F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            if pos + 3 < end {
              let b3 = s.code_unit_at(pos + 3)
              if (b3 & 0xC0) == 0x80 {
                let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                return (cp, pos + 4)
              }
            }
            return (0xFFFD, pos + 3)
          }
        }
        return (0xFFFD, pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  (0xFFFD, pos + 1)
}

///| Decode one non-ASCII UTF-8 scalar value at `s[pos..end]` given lead byte `b0 >= 0x80`
///| and look up its `(cur_flags << 9) | (cur_raw << 3) | byte_len` in a single Int.
fn decode_and_lookup_non_ascii(
  s : String,
  pos : Int,
  end : Int,
  b0 : Int,
  tbl : String,
) -> Int {
  // Fast path for 3-byte UTF-8 (CJK/Hangul/punct, ~66% of non-ASCII)
  if b0 >= 0xE0 && b0 <= 0xEF {
    if b0 >= 0xE5 && b0 <= 0xE9 && pos + 2 < end {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
        return (flag_ea << 9) | (cls_ID << 3) | 3
      }
    }
    let mut cp = 0xFFFD
    let mut len = 1
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xE0 {
        b1 >= 0xA0 && b1 <= 0xBF
      } else if b0 == 0xED {
        b1 >= 0x80 && b1 <= 0x9F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
            len = 3
            if cp >= 0x4E00 && cp <= 0x9FFF {
              return (flag_ea << 9) | (cls_ID << 3) | 3
            }
          } else {
            len = 2
          }
        } else {
          len = 2
        }
      }
    }
    let s1 = tbl.code_unit_at(blob_off_s1 + (cp >> 13)) - 35
    let s2_off = blob_off_s2 + (((s1 << 6) | ((cp >> 7) & 63)) << 1)
    let sb0 = tbl.code_unit_at(s2_off) - 35
    let sb1 = tbl.code_unit_at(s2_off + 1) - 35
    let s3 = (sb0 << 5) | sb1
    let c3 = tbl.code_unit_at(blob_off_s3 + ((s3 << 7) | (cp & 127)))
    let cid = if c3 > 92 { c3 - 36 } else { c3 - 35 }
    return ((tbl.code_unit_at(blob_off_cflg + cid) - 35) << 9) |
    ((tbl.code_unit_at(blob_off_cres + cid) - 35) << 3) |
    len
  }
  let mut cp = 0xFFFD
  let mut len = 1
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        len = 2
      }
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xF0 {
        b1 >= 0x90 && b1 <= 0xBF
      } else if b0 == 0xF4 {
        b1 >= 0x80 && b1 <= 0x8F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            if pos + 3 < end {
              let b3 = s.code_unit_at(pos + 3)
              if (b3 & 0xC0) == 0x80 {
                cp = ((b0 & 0x07) << 18) |
                ((b1 & 0x3F) << 12) |
                ((b2 & 0x3F) << 6) |
                (b3 & 0x3F)
                len = 4
              } else {
                len = 3
              }
            } else {
              len = 3
            }
          } else {
            len = 2
          }
        } else {
          len = 2
        }
      }
    }
  }

  let s1 = tbl.code_unit_at(blob_off_s1 + (cp >> 13)) - 35
  let s2_off = blob_off_s2 + (((s1 << 6) | ((cp >> 7) & 63)) << 1)
  let sb0 = tbl.code_unit_at(s2_off) - 35
  let sb1 = tbl.code_unit_at(s2_off + 1) - 35
  let s3 = (sb0 << 5) | sb1
  let c3 = tbl.code_unit_at(blob_off_s3 + ((s3 << 7) | (cp & 127)))
  let cid = if c3 > 92 { c3 - 36 } else { c3 - 35 }
  ((tbl.code_unit_at(blob_off_cflg + cid) - 35) << 9) |
  ((tbl.code_unit_at(blob_off_cres + cid) - 35) << 3) |
  len
}
