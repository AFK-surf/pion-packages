///| Safe UTF-8 decoding helpers for `packages/unicode_linebreak`.
///| Invalid UTF-8 sequences decode to U+FFFD following the Unicode maximal
///| subpart rule and always advance at least 1 byte (never panics or loops).

///| Decode one Unicode scalar value starting at `s[pos..end]`.
///| Returns `(codepoint, next_pos)`.
fn decode_utf8_lossy(s : String, pos : Int, end : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xE0 {
        b1 >= 0xA0 && b1 <= 0xBF
      } else if b0 == 0xED {
        b1 >= 0x80 && b1 <= 0x9F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
            return (cp, pos + 3)
          }
        }
        return (0xFFFD, pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 1 < end {
      let b1 = s.code_unit_at(pos + 1)
      let valid_b1 = if b0 == 0xF0 {
        b1 >= 0x90 && b1 <= 0xBF
      } else if b0 == 0xF4 {
        b1 >= 0x80 && b1 <= 0x8F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 {
        if pos + 2 < end {
          let b2 = s.code_unit_at(pos + 2)
          if (b2 & 0xC0) == 0x80 {
            if pos + 3 < end {
              let b3 = s.code_unit_at(pos + 3)
              if (b3 & 0xC0) == 0x80 {
                let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                return (cp, pos + 4)
              }
            }
            return (0xFFFD, pos + 3)
          }
        }
        return (0xFFFD, pos + 2)
      }
    }
    return (0xFFFD, pos + 1)
  }
  (0xFFFD, pos + 1)
}
