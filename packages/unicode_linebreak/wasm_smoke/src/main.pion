///| Wasm32 + Native 4-mode deterministic smoke entry for `packages/unicode_linebreak`.
///| Uses integer-only formatting to guarantee byte-identical stdout across
///| Native Debug, Native Release, Wasm32 Debug, and Wasm32 Release.

import "unicode_linebreak"

fn fnv1a_int(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

pub fn main(world : World) -> Int {
  let samples : Array[String] = [
    "",
    "hello world",
    "a\r\nb\nc\rd\u{0085}e\u{000C}f",
    "中文排版测试。「引号」、小仮名あっ！",
    "subtract .5 from $(1,234.56)% and 1/2",
    "\u{00AB} quote \u{00BB} and \"latin\"",
    "e\u{0301} a\u{200B}  b a\u{2060}b a\u{00A0}b",
    "\u{1F469}\u{200D}\u{1F4BB} \u{1F466}\u{1F3FB} \u{1F777}\u{1F3FB}",
    "\u{1F1FA}\u{1F1F8}\u{1F1EF}\u{1F1F5}\u{1F1EC}\u{1F1E7}",
    "-word -\u{05D0} \u{05D0}-x",
    "\u{11F02}\u{1B05}\u{1B44}\u{1B05}\u{1BF2} \u{25CC}\u{1B44}\u{25CC}",
    "https://example.com/path/to/file?a=1&b=2#frag",
  ]

  let mut h : UInt64 = 14695981039346656037UL
  let mut total_opps = 0
  let mut mandatory_opps = 0

  let mut i = 0
  while i < samples.length() {
    let s = samples[i]
    let brks = unicode_linebreak::line_breaks(s)
    h = fnv1a_int(h, brks.length())
    let mut j = 0
    while j < brks.length() {
      let op = brks[j]
      total_opps = total_opps + 1
      let k = match op.kind {
        unicode_linebreak::BreakKind::Allowed => 1
        unicode_linebreak::BreakKind::Mandatory => {
          mandatory_opps = mandatory_opps + 1
          2
        }
      }
      h = fnv1a_int(h, op.byte_offset)
      h = fnv1a_int(h, k)
      j = j + 1
    }
    match unicode_linebreak::next_break_opportunity(s, 0) {
      Some(op) => h = fnv1a_int(h, op.byte_offset)
      None => h = fnv1a_int(h, -1)
    }
    i = i + 1
  }

  let cls_samples : Array[Int] = [
    0x0020, 0x000A, 0x000D, 0x0085, 0x200B, 0x200D, 0x4E00, 0x1B05, 0x1F1FA,
    0x2A6F0, 0x20CF,
  ]
  let mut c = 0
  while c < cls_samples.length() {
    let name = unicode_linebreak::line_break_class(cls_samples[c]).to_string()
    let mut k = 0
    while k < name.length() {
      h = fnv1a_int(h, name.code_unit_at(k))
      k = k + 1
    }
    c = c + 1
  }

  io_println(
    world,
    "unicode_linebreak_wasm_smoke: OK samples=" +
    samples.length().to_string() +
    " opps=" +
    total_opps.to_string() +
    " mandatory=" +
    mandatory_opps.to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}
