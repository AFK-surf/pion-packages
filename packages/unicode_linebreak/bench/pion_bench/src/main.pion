///| Conformance runner (`ucd`), differential oracle (`diff`), and benchmark (`bench`)
///| for `packages/unicode_linebreak`.

import "unicode_linebreak"

fn fnv1a_int(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

fn bytes_to_string(b : Bytes) -> String {
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    sb.write_byte(b[i])
    i = i + 1
  }
  sb.to_string()
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn utf8_len_cp(cp : Int) -> Int {
  if cp < 0x80 {
    1
  } else if cp < 0x800 {
    2
  } else if cp < 0x10000 {
    3
  } else {
    4
  }
}

fn parse_int(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

fn parse_hex(s : String) -> Int {
  let n = s.length()
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if b >= 65 && b <= 70 {
      b - 55
    } else if b >= 97 && b <= 102 {
      b - 87
    } else {
      return -1
    }
    v = (v << 4) | d
    i = i + 1
  }
  v
}

fn split_lines_raw(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && s.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      out.push(s.slice(start, end))
      start = i + 1
    }
    i = i + 1
  }
  out
}

///| Unescape `\n`, `\r`, `\t`, `\\` in a TSV diff line.
fn unescape_line(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 && i + 1 < n {
      let nx = s.code_unit_at(i + 1)
      if nx == 110 {
        sb.write_byte(10.to_byte())
        i = i + 2
        continue
      } else if nx == 114 {
        sb.write_byte(13.to_byte())
        i = i + 2
        continue
      } else if nx == 116 {
        sb.write_byte(9.to_byte())
        i = i + 2
        continue
      } else if nx == 92 {
        sb.write_byte(92.to_byte())
        i = i + 2
        continue
      }
    }
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn run_ucd(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let text = bytes_to_string(raw)
  let lines = split_lines_raw(text)
  let mut total = 0
  let mut passed = 0
  let mut failed = 0
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    // Strip comment after '#'
    let mut end = line.length()
    let mut k = 0
    while k < end {
      if line.code_unit_at(k) == 35 {
        end = k
        break
      }
      k = k + 1
    }
    // Tokenize by ASCII whitespace (space=32, tab=9)
    let sb = StringBuilder::with_capacity(32)
    let expected : Array[Int] = []
    let mut byte_pos = 0
    let mut has_token = false
    let mut p = 0
    while p < end {
      while p < end && (line.code_unit_at(p) == 32 || line.code_unit_at(p) == 9) {
        p = p + 1
      }
      if p >= end {
        break
      }
      let tstart = p
      while p < end && line.code_unit_at(p) != 32 && line.code_unit_at(p) != 9 {
        p = p + 1
      }
      let tok = line.slice(tstart, p)
      has_token = true
      if tok == "÷" {
        if byte_pos > 0 {
          expected.push(byte_pos)
        }
      } else if tok == "×" {
        ()
      } else {
        let cp = parse_hex(tok)
        if cp >= 0 {
          write_utf8_cp(sb, cp)
          byte_pos = byte_pos + utf8_len_cp(cp)
        }
      }
    }
    if has_token {
      total = total + 1
      let input = sb.to_string()
      let got = unicode_linebreak::line_breaks(input)
      let mut ok = got.length() == expected.length()
      if ok {
        let mut j = 0
        while j < expected.length() {
          if got[j].byte_offset != expected[j] {
            ok = false
            break
          }
          j = j + 1
        }
      }
      if ok {
        passed = passed + 1
      } else {
        failed = failed + 1
        if failed <= 10 {
          io_println(world, "FAIL line " + (li + 1).to_string() + ": " + line)
        }
      }
    }
    li = li + 1
  }
  io_println(
    world,
    "LineBreakTest.txt: passed=" +
    passed.to_string() +
    "/" +
    total.to_string() +
    " failed=" +
    failed.to_string(),
  )
  if failed == 0 && total > 0 { 0 } else { 1 }
}

fn run_diff(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let text = bytes_to_string(raw)
  let lines = split_lines_raw(text)
  let mut i = 0
  while i < lines.length() {
    let raw_line = lines[i]
    if raw_line.length() == 0 && i + 1 == lines.length() {
      break
    }
    let s = unescape_line(raw_line)
    let brks = unicode_linebreak::line_breaks(s)
    let sb = StringBuilder::with_capacity(brks.length() * 6)
    let mut j = 0
    while j < brks.length() {
      if j > 0 {
        sb.write_byte(44.to_byte())
      }
      sb.write_string(brks[j].byte_offset.to_string())
      j = j + 1
    }
    io_println(world, sb.to_string())
    i = i + 1
  }
  0
}

fn run_bench(world : World, path : String, iters : Int) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let text = bytes_to_string(raw)
  let mut h : UInt64 = 14695981039346656037UL
  let mut total_opps = 0
  let mut it = 0
  while it < iters {
    let brks = unicode_linebreak::line_breaks(text)
    let n = brks.length()
    total_opps = total_opps + n
    let mut j = 0
    while j < n {
      h = fnv1a_int(h, brks[j].byte_offset)
      j = j + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "linebreak_bench: bytes=" +
    text.length().to_string() +
    " iters=" +
    iters.to_string() +
    " opps=" +
    total_opps.to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_linebreak <ucd|diff|bench> <path> [iters]")
    return 2
  }
  let cmd = args[1]
  let path = args[2]
  if cmd == "ucd" {
    run_ucd(world, path)
  } else if cmd == "diff" {
    run_diff(world, path)
  } else if cmd == "bench" {
    let iters = if args.length() >= 4 { parse_int(args[3], 100) } else { 100 }
    run_bench(world, path, iters)
  } else {
    io_println(world, "unknown subcommand: " + cmd)
    2
  }
}
