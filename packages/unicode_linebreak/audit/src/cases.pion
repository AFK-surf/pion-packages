///| Red-team (`redteam_p<sev>_<n>_*`) and control (`control_*`) cases. Each returns "" on PASS, else the reason.
///|
///| Red-team cases assert the UAX #14 16.0.0 behaviour and FAIL while the finding of the same id in REPORT.md is
///| open; they use the public API only. Control cases pin behaviour the package gets right (expected values from
///| the independent model in ../diff/model.py, cross-checked with Rust icu_segmenter 2.4.0 where it implements the
///| rule): they must PASS before and after any fix, and the bug-injection gate of run_audit.sh relies on them.

///| (name, input bytes as hex, expected `<off><a|m>,...`)
fn control_vectors() -> Array[(String, String, String)] {
  [
    ("control_hard_breaks", "610d0a620a630d64c285650b660c67e280a868e280a9690d0d0a0a", "3m,5m,7m,10m,12m,14m,18m,22m,24m,26m,27m"),
    ("control_spaces_zw", "612062202063e2808b64e2808b206520c2a066e281a02067", "2a,5a,9a,14a,16a,23a,24m"),
    ("control_lb9_lb10", "61cc816220cc81630bcc8164e2808bcc8165e2808d660dcc810ae2808de4b880", "5a,9m,15a,23m,26m,32m"),
    ("control_quotes", "c2ab207820c2bb207920e2809c7ae2809d20e4b880e2809ce4b880e2809de4b88020612262222028c2ab2078", "8a,10a,18a,21a,30a,34a,39a,44m"),
    ("control_lb15cd", "7375627472616374202e3520616e6420612e622078202c352079", "9a,12a,16a,20a,22a,25a,26m"),
    ("control_lb20a_lb21", "78202d6120d7902d6120d7902dd79120e2809061202d3520782d6120c2b461202fd790", "2a,5a,10a,13a,16a,21a,24a,26a,28a,35m"),
    ("control_lb25", "242831322e333529202831322e3529252024282e352920252835292031322c3334352e3637382f39202924203529292520355d242024286120352025", "9a,17a,23a,28a,42a,44a,47a,49a,53a,54a,57a,59a,60m"),
    ("control_lb28a", "f091bc82f091bc8520e1ac85e1ad8420e1ac85e1afb2e1ac8520e2978ce1ad84e2978c20e1ac85e1ac85e1ad8420e1ac85e1ac8520e1ac85e1acb4e1ad84", "9a,16a,22a,26a,36a,39a,46a,49a,53a,62m"),
    ("control_lb30", "6128622061efbc8862202861296220efbc8861efbc8962", "4a,5a,10a,15a,22a,23m"),
    ("control_lb30a", "f09f87a6f09f87a6f09f87a6f09f87a6f09f87a620f09f87bacc81f09f87b8f09f87af2061f09f87a6f09f87a6f09f87a6", "8a,16a,21a,31a,36a,37a,45a,49m"),
    ("control_lb30b", "f09f91a6f09f8fbb20f09f9db7f09f8fbb20e29881f09f8fbb20f09f91a9e2808df09f92bb20f09fbfbdf09f8fbb", "9a,18a,21a,26a,38a,46m"),
    ("control_fastpath", "6162cc816364206162e2808d63642061622263642061622863642061622d63642061622e63642061622f636420616231326364206162246364206162256364206162d7906364206162e4b8806364206162216364206162296364", "7a,15a,21a,27a,30a,33a,39a,42a,45a,52a,58a,64a,71a,73a,76a,79a,82a,85a,90m"),
    ("control_cjk", "e4b8ade69687e68e92e78988e6b58be8af95e38082e3808ce5bc95e58fb7e3808de38081e5b08fe4bbaee5908de38182e381a3efbc81", "3a,6a,9a,12a,15a,21a,27a,36a,39a,42a,45a,54m"),
    ("control_utf8", "618062e4b820eda080f09f982063ffc0aff49080806420e080af62e4", "6a,13a,23a,28m"),
    ("control_korean", "e18480e185a1e186a820eab080eab0812024eab08020eab08025", "10a,13a,17a,22a,26m"),
  ]
}

///|
fn chk(hex : String, want : String) -> String {
  let got = fmt_breaks(unicode_linebreak::line_breaks(unhex(hex)))
  if got == want {
    ""
  } else {
    "line_breaks(" + hex + ")=" + got + " want " + want
  }
}

///|
fn cls(cp : Int, want : String) -> String {
  let got = unicode_linebreak::line_break_class(cp).to_string()
  if got == want {
    ""
  } else {
    "line_break_class(" + cp.to_string() + ")=" + got + " want " + want
  }
}

///|
fn first_err(rs : Array[String]) -> String {
  let mut i = 0
  while i < rs.length() {
    if rs[i] != "" {
      return rs[i]
    }
    i = i + 1
  }
  ""
}

///|
fn lim(s : String, b : Int, o : Int) -> String {
  fmt_res(unicode_linebreak::line_breaks_with_limits(s, unicode_linebreak::LineBreakLimits::new(b, o)))
}

///|
fn eq(got : String, want : String, what : String) -> String {
  if got == want {
    ""
  } else {
    what + "=" + got + " want " + want
  }
}

///| LineBreakLimits: negative, 0, exact and exact +/- 1 on both limits.
fn ctl_limits() -> String {
  let s = "a b\u{4E2D}\u{6587}"
  let full = fmt_breaks(unicode_linebreak::line_breaks(s))
  let m = unicode_linebreak::line_breaks(s).length()
  let n = s.length()
  first_err([
    eq(full, "2a,3a,6a,9m", "line_breaks"),
    eq(lim(s, n, m), "Ok(" + full + ")", "exact"),
    eq(lim(s, n - 1, m), "Err(LimitExceeded)", "bytes-1"),
    eq(lim(s, n, m - 1), "Err(LimitExceeded)", "opps-1"),
    eq(lim(s, n + 1, m + 1), "Ok(" + full + ")", "+1"),
    eq(lim(s, -1, m), "Err(LimitExceeded)", "bytes=-1"),
    eq(lim(s, n, -1), "Err(LimitExceeded)", "opps=-1"),
    eq(lim(s, -2147483647 - 1, 100), "Err(LimitExceeded)", "bytes=INT_MIN"),
    eq(lim(s, 0, 0), "Err(LimitExceeded)", "0,0"),
    eq(lim("", 0, 0), "Ok(-)", "empty 0,0"),
    eq(lim("", -1, 0), "Err(LimitExceeded)", "empty -1"),
    eq(lim("", 0, -1), "Err(LimitExceeded)", "empty opps -1"),
    eq(lim("a", 1, 1), "Ok(1m)", "a 1,1"),
    eq(lim("a", 1, 0), "Err(LimitExceeded)", "a 1,0"),
    eq(lim("a", 0, 1), "Err(LimitExceeded)", "a 0,1"),
    eq(
      fmt_res(unicode_linebreak::line_breaks_with_limits(s, unicode_linebreak::LineBreakLimits::default())),
      "Ok(" + full + ")",
      "default",
    ),
    eq(unicode_linebreak::LineBreakLimits::default().max_input_bytes.to_string(), "16777216", "default bytes"),
  ])
}

///| next_break_opportunity on hostile offsets.
fn ctl_nbo() -> String {
  let s = "\u{4E2D}\u{6587} a\u{1F600}"
  let r = api_check(s)
  if r != "" {
    return r
  }
  first_err([
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, -5)), "3:Allowed", "-5"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 1)), "3:Allowed", "mid-UTF-8 1"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 3)), "7:Allowed", "3"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 9)), "12:Mandatory", "mid-UTF-8 9"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 12)), "None", "len"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 13)), "None", "len+1"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, 2147483647)), "None", "INT_MAX"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity(s, -2147483647 - 1)), "3:Allowed", "INT_MIN"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity("", 0)), "None", "empty 0"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity("", -1)), "None", "empty -1"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity("a\r\nb", 0)), "3:Mandatory", "crlf 0"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity("a\r\nb", 1)), "3:Mandatory", "crlf 1"),
    eq(fmt_opt(unicode_linebreak::next_break_opportunity("a\r\nb", 2)), "3:Mandatory", "crlf 2"),
    eq(fmt_breaks(unicode_linebreak::line_breaks("")), "-", "line_breaks empty"),
  ])
}

///| line_break_class: Unicode 16.0.0 values, defaults and hostile code points.
fn ctl_class() -> String {
  first_err([
    cls(0x20, "SP"),
    cls(0x0A, "LF"),
    cls(0x0D, "CR"),
    cls(0x85, "NL"),
    cls(0x0B, "BK"),
    cls(0x200B, "ZW"),
    cls(0x200D, "ZWJ"),
    cls(0x2060, "WJ"),
    cls(0x4E00, "ID"),
    cls(0x3400, "ID"),
    cls(0x2A6E0, "ID"),
    cls(0x3FFFD, "ID"),
    cls(0x20C0, "PO"),
    cls(0x20C1, "PR"),
    cls(0x20CF, "PR"),
    cls(0x1B05, "AK"),
    cls(0x11F02, "AP"),
    cls(0x1B44, "VI"),
    cls(0x1BF2, "VF"),
    cls(0x25CC, "AL"),
    cls(0x1F1E6, "RI"),
    cls(0x1F3FB, "EM"),
    cls(0x1F466, "EB"),
    cls(0x0E01, "SA"),
    cls(0xD800, "SG"),
    cls(0xFFFD, "AI"),
    cls(0x00A7, "AI"),
    cls(0x3000, "BA"),
    cls(0x2010, "BA"),
    cls(0x05D0, "HL"),
    cls(0xE000, "XX"),
    cls(0x10FFFF, "XX"),
    cls(0xE0000, "XX"),
    cls(-1, "XX"),
    cls(-2147483647 - 1, "XX"),
    cls(0x110000, "XX"),
    cls(2147483647, "XX"),
  ])
}

///| Mandatory vs Allowed: CR LF only after LF, lone CR, BK, NL, eot Mandatory; SP / ZW only Allowed.
fn ctl_kinds() -> String {
  first_err([
    chk("610d0a62", "3m,4m"),
    chk("610d62", "2m,3m"),
    chk("610a62", "2m,3m"),
    chk("61c28562", "3m,4m"),
    chk("610b62", "2m,3m"),
    chk("610c62", "2m,3m"),
    chk("61e280a862", "4m,5m"),
    chk("61e280a962", "4m,5m"),
    chk("612062", "2a,3m"),
    chk("61e2808b62", "4a,5m"),
    chk("0d0d0a", "1m,3m"),
    chk("0d", "1m"),
    chk("0a0d", "1m,2m"),
    chk("20", "1m"),
    chk("", "-"),
  ])
}

///|
fn run_control_vector(name : String) -> String {
  let v = control_vectors()
  let mut i = 0
  while i < v.length() {
    let (n, h, want) = v[i]
    if n == name {
      return chk(h, want)
    }
    i = i + 1
  }
  "no such vector " + name
}

///| P2-1: the 94 unassigned code points of Supplemental Arrows-C (U+1F80C..1F80F, 1F848..1F84F, 1F85A..1F85F,
///| 1F888..1F88F, 1F8AE..1F8AF, 1F8BC..1F8BF, 1F8C2..1F8FF) are Line_Break=XX in Unicode 16.0.0 (LineBreak.txt
///| `@missing: 0000..10FFFF; XX`, DerivedLineBreak.txt ID defaults stop at 1F7FF and restart at 1F900).
fn rt_p2_1() -> String {
  first_err([
    cls(0x1F80C, "XX"),
    cls(0x1F84F, "XX"),
    cls(0x1F8C2, "XX"),
    cls(0x1F8FF, "XX"),
    chk("61f09fa08c62", "6m"), // a U+1F80C b: XX -> AL, LB28 AL x AL
  ])
}

///| P2-2: LB21a is `HL (HY | [ BA - $EastAsian ]) x [^HL]`: U+3000 IDEOGRAPHIC SPACE (BA, ea=F) is excluded.
fn rt_p2_2() -> String {
  first_err([
    chk("d790e3808061", "5a,6m"), // HEBREW ALEF, IDEOGRAPHIC SPACE, a: LB31 break before a
    chk("d790cc81e3808061", "7a,8m"),
  ])
}

///| P2-3: LB10 gives a remaining CM / ZWJ the properties of U+0041 (East_Asian_Width=Na), so LB19a sees it as
///| non-East-Asian even when the mark itself is ea=W (U+3099, U+302A, U+16FF0).
fn rt_p2_3() -> String {
  first_err([
    chk("20e38299e2809ce4b880", "1a,10m"), // SP, U+3099, U+201C, U+4E00: [^EastAsian] x QU
    chk("e38299e2809ce4b880", "9m"), // same at sot
    chk("20e380aae2809de4b880", "1a,10m"), // SP, U+302A, U+201D, U+4E00
  ])
}

///|
pub fn case_names() -> Array[String] {
  let out : Array[String] = [
    "control_limits", "control_nbo", "control_class", "control_kinds",
  ]
  let v = control_vectors()
  let mut i = 0
  while i < v.length() {
    let (n, _, _) = v[i]
    out.push(n)
    i = i + 1
  }
  out.push("redteam_p2_1_unassigned_arrows_xx")
  out.push("redteam_p2_2_lb21a_ideographic_space")
  out.push("redteam_p2_3_lb10_cm_east_asian_width")
  out
}

///|
pub fn run_case(name : String) -> String {
  if name == "control_limits" {
    ctl_limits()
  } else if name == "control_nbo" {
    ctl_nbo()
  } else if name == "control_class" {
    ctl_class()
  } else if name == "control_kinds" {
    ctl_kinds()
  } else if name == "redteam_p2_1_unassigned_arrows_xx" {
    rt_p2_1()
  } else if name == "redteam_p2_2_lb21a_ideographic_space" {
    rt_p2_2()
  } else if name == "redteam_p2_3_lb10_cm_east_asian_width" {
    rt_p2_3()
  } else {
    run_control_vector(name)
  }
}
