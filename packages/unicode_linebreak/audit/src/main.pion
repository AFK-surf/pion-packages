///| Red-team CLI for `packages/unicode_linebreak` (native + wasm32, see ../REPORT.md). Public API only.
///|   classes                    -> run-length dump of line_break_class over U+0000..U+10FFFF + out-of-range probes
///|   dump <cases>               -> one line per `<name>\t<hex>` case: `<off><a|m>,...` (`-` for no opportunity)
///|   api <cases>                -> per case: next_break_opportunity at every byte offset (and hostile offsets)
///|                                 and LineBreakIter vs line_breaks, line_breaks_with_limits boundary sweep; `ok` or the mismatch
///|   bomb <hex unit> <reps> <rounds> <op> -> build unit*reps in process, run <op> `rounds` times and print
///|                                 `<median us> <min us> <bytes> <opportunities> <fnv>` (self-timed, no process
///|                                 start-up or I/O inside the timed region); op = breaks | limits | nbo_iter | iter | nbo_last
///|   list | case <name>         -> red-team / control cases (src/cases.pion)

import "unicode_linebreak"

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Bytes of a hex string as a (possibly ill-formed UTF-8) String.
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hex4(v : Int) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder::new()
  let mut shift = 20
  let mut started = false
  while shift >= 0 {
    let d = (v >> shift) & 15
    if d != 0 || started || shift <= 12 {
      sb.write_byte(digits.code_unit_at(d).to_byte())
      started = true
    }
    shift = shift - 4
  }
  sb.to_string()
}

///| `<off><a|m>,...` or `-`.
pub fn fmt_breaks(b : Array[unicode_linebreak::BreakOpportunity]) -> String {
  if b.length() == 0 {
    return "-"
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    if i > 0 {
      sb.write_byte(44.to_byte())
    }
    sb.write_string(b[i].byte_offset.to_string())
    sb.write_string(
      match b[i].kind {
        unicode_linebreak::BreakKind::Allowed => "a"
        unicode_linebreak::BreakKind::Mandatory => "m"
      },
    )
    i = i + 1
  }
  sb.to_string()
}

///|
fn fmt_opt(o : Option[unicode_linebreak::BreakOpportunity]) -> String {
  match o {
    Some(op) => op.to_string()
    None => "None"
  }
}

///|
fn fmt_res(
  r : Result[Array[unicode_linebreak::BreakOpportunity], unicode_linebreak::LineBreakError],
) -> String {
  match r {
    Ok(b) => "Ok(" + fmt_breaks(b) + ")"
    Err(e) => "Err(" + e.to_string() + ")"
  }
}

///|
pub fn run_classes() -> String {
  let sb = StringBuilder::new()
  let mut lo = 0
  let mut cur = unicode_linebreak::line_break_class(0).to_string()
  let mut cp = 1
  while cp <= 0x110000 {
    let c = if cp < 0x110000 {
      unicode_linebreak::line_break_class(cp).to_string()
    } else {
      ""
    }
    if c != cur {
      sb.write_string(hex4(lo) + " " + hex4(cp - 1) + " " + cur + "\n")
      lo = cp
      cur = c
    }
    cp = cp + 1
  }
  let probes : Array[Int] = [
    -1,
    -2,
    -0x110000,
    -2147483647 - 1,
    0x110000,
    0x110001,
    0x7FFFFFFF,
    0x1FFFFF,
  ]
  let mut i = 0
  while i < probes.length() {
    sb.write_string(
      "X " +
      probes[i].to_string() +
      " " +
      unicode_linebreak::line_break_class(probes[i]).to_string() +
      "\n",
    )
    i = i + 1
  }
  sb.to_string()
}

///|
fn case_text(l : String) -> Option[String] {
  let mut t = 0
  while t < l.length() && l.code_unit_at(t) != 9 {
    t = t + 1
  }
  if t >= l.length() {
    return None
  }
  Some(unhex(l.slice(t + 1, l.length())))
}

///|
pub fn run_dump(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    match case_text(lines[i]) {
      Some(s) => sb.write_string(fmt_breaks(unicode_linebreak::line_breaks(s)) + "\n")
      None => ()
    }
    i = i + 1
  }
  sb.to_string()
}

///| The answer `next_break_opportunity(s, off)` must give, derived from `line_breaks(s)` alone:
///| the first opportunity strictly after `off`, `None` when there is none.
fn expected_next(
  b : Array[unicode_linebreak::BreakOpportunity],
  off : Int,
) -> Option[unicode_linebreak::BreakOpportunity] {
  let mut i = 0
  while i < b.length() {
    if b[i].byte_offset > off {
      return Some(b[i])
    }
    i = i + 1
  }
  None
}

///| next_break_opportunity / line_breaks_with_limits consistency for one input; "" when consistent.
pub fn api_check(s : String) -> String {
  let b = unicode_linebreak::line_breaks(s)
  let n = s.length()
  let offs : Array[Int] = [-2147483647 - 1, -1000000, -2, -1, n, n + 1, n + 2, 2147483647]
  let mut o = 0
  while o < n {
    offs.push(o)
    o = o + 1
  }
  let mut i = 0
  while i < offs.length() {
    let got = fmt_opt(unicode_linebreak::next_break_opportunity(s, offs[i]))
    let want = fmt_opt(expected_next(b, offs[i]))
    if got != want {
      return "next_break_opportunity(off=" + offs[i].to_string() + ")=" + got + " want " + want
    }
    i = i + 1
  }
  // LineBreakIter must stream exactly line_breaks(s), then stay exhausted
  let it = unicode_linebreak::line_break_iter(s)
  let got_it : Array[unicode_linebreak::BreakOpportunity] = []
  let mut steps = 0
  let mut go = true
  while go && steps <= n + 2 {
    match it.next() {
      Some(op) => got_it.push(op)
      None => go = false
    }
    steps = steps + 1
  }
  if fmt_breaks(got_it) != fmt_breaks(b) {
    return "LineBreakIter=" + fmt_breaks(got_it) + " want " + fmt_breaks(b)
  }
  let mut extra = 0
  while extra < 3 {
    match it.next() {
      Some(op) => return "LineBreakIter yields " + op.to_string() + " after exhaustion"
      None => ()
    }
    extra = extra + 1
  }
  let m = b.length()
  let full = "Ok(" + fmt_breaks(b) + ")"
  let checks : Array[(Int, Int, Bool)] = [
    (n, m, true),
    (n + 1, m + 1, true),
    (2147483647, 2147483647, true),
    (n, m - 1, false),
    (n - 1, m, false),
    (-1, m, false),
    (n, -1, false),
    (-2147483647 - 1, -2147483647 - 1, false),
  ]
  let mut k = 0
  while k < checks.length() {
    let (mb, mo, ok) = checks[k]
    let r = fmt_res(
      unicode_linebreak::line_breaks_with_limits(s, unicode_linebreak::LineBreakLimits::new(mb, mo)),
    )
    let want = if ok { full } else { "Err(LimitExceeded)" }
    if r != want {
      return "line_breaks_with_limits(" + mb.to_string() + ", " + mo.to_string() + ")=" + r + " want " + want
    }
    k = k + 1
  }
  let d = fmt_res(
    unicode_linebreak::line_breaks_with_limits(s, unicode_linebreak::LineBreakLimits::default()),
  )
  if n <= 16777216 && d != full {
    return "default limits " + d + " want " + full
  }
  ""
}

///|
pub fn run_api(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    match case_text(lines[i]) {
      Some(s) => {
        let r = api_check(s)
        sb.write_string((if r == "" { "ok" } else { r }) + "\n")
      }
      None => ()
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn fnv(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

///| One timed run of `op` over `s`: (opportunities, fnv of offsets).
fn bomb_once(s : String, op : String) -> (Int, UInt64) {
  let mut h = 14695981039346656037UL
  let mut cnt = 0
  if op == "breaks" || op == "limits" {
    let b = if op == "breaks" {
      unicode_linebreak::line_breaks(s)
    } else {
      match unicode_linebreak::line_breaks_with_limits(s, unicode_linebreak::LineBreakLimits::default()) {
        Ok(x) => x
        Err(_) => []
      }
    }
    let mut i = 0
    while i < b.length() {
      h = fnv(h, b[i].byte_offset)
      i = i + 1
    }
    cnt = b.length()
  } else if op == "nbo_iter" {
    // the natural incremental-layout loop: ask for the next opportunity after the previous one
    let mut off = 0
    let mut go = true
    while go {
      match unicode_linebreak::next_break_opportunity(s, off) {
        Some(op2) => {
          h = fnv(h, op2.byte_offset)
          cnt = cnt + 1
          off = op2.byte_offset
        }
        None => go = false
      }
    }
  } else if op == "iter" {
    let it = unicode_linebreak::line_break_iter(s)
    let mut go = true
    while go {
      match it.next() {
        Some(op2) => {
          h = fnv(h, op2.byte_offset)
          cnt = cnt + 1
        }
        None => go = false
      }
    }
  } else if op == "nbo_last" {
    match unicode_linebreak::next_break_opportunity(s, s.length() - 1) {
      Some(op2) => {
        h = fnv(h, op2.byte_offset)
        cnt = 1
      }
      None => ()
    }
  }
  (cnt, h)
}

///|
pub fn run_bomb(unit_hex : String, reps : Int, rounds : Int, op : String) -> String {
  let u = unhex(unit_hex)
  let sb = StringBuilder::with_capacity(u.length() * reps)
  let mut i = 0
  while i < reps {
    sb.write_string(u)
    i = i + 1
  }
  let s = sb.to_string()
  let times : Array[Int64] = []
  let mut cnt = 0
  let mut h = 0UL
  let mut r = 0
  let nr = if rounds < 1 { 1 } else { rounds }
  while r < nr {
    let t0 = clock_monotonic_us()
    let (c, hh) = bomb_once(s, op)
    let t1 = clock_monotonic_us()
    times.push(t1 - t0)
    cnt = c
    h = hh
    r = r + 1
  }
  // insertion sort (rounds is small)
  let mut a = 1
  while a < times.length() {
    let x = times[a]
    let mut b = a - 1
    while b >= 0 && times[b] > x {
      times[b + 1] = times[b]
      b = b - 1
    }
    times[b + 1] = x
    a = a + 1
  }
  let med = times[times.length() / 2]
  let mn = times[0]
  med.to_string() +
  " " +
  mn.to_string() +
  " " +
  s.length().to_string() +
  " " +
  cnt.to_string() +
  " " +
  h.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: unicode_linebreak_audit classes | dump|api <cases> | bomb <hex> <reps> <rounds> <op> | list | case <name>")
    return 2
  }
  let mode = args[1]
  if mode == "classes" {
    io_print(world, run_classes())
    return 0
  }
  if (mode == "dump" || mode == "api") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    io_print(world, if mode == "dump" { run_dump(text) } else { run_api(text) })
    return 0
  }
  if mode == "bomb" && args.length() >= 6 {
    io_println(world, run_bomb(args[2], parse_int(args[3]), parse_int(args[4]), args[5]))
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
