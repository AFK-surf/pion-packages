///| White-box table dump for the RT-unicode-linebreak audit. run_audit.sh copies this file next to a
///| byte-identical copy of packages/unicode_linebreak/src/*.pion (tests excluded) in $AUDIT_OUT, so the exact
///| shipped tables are read through their private accessors: per code point the raw Line_Break class, the
///| LB1-resolved class the state machine uses, and the flag bits (EA, QU_Pi, QU_Pf, ExtPict&Cn, U+2010, U+25CC).
///| Output: run-length lines `<lo> <hi> <raw> <resolved> <flags>` (hex code points). Never part of the package.

///|
fn wb_res_name(c : Int) -> String {
  let names = [
    "AK", "AL", "AP", "AS", "B2", "BA", "BB", "BK", "CB", "CL", "CM", "CP", "CR", "EB", "EM", "EX", "GL", "H2",
    "H3", "HL", "HY", "ID", "IN", "IS", "JL", "JT", "JV", "LF", "NL", "NS", "NU", "OP", "PO", "PR", "QU", "RI",
    "SP", "SY", "VF", "VI", "WJ", "ZW", "ZWJ",
  ]
  let ids = [
    cls_AK, cls_AL, cls_AP, cls_AS, cls_B2, cls_BA, cls_BB, cls_BK, cls_CB, cls_CL, cls_CM, cls_CP, cls_CR,
    cls_EB, cls_EM, cls_EX, cls_GL, cls_H2, cls_H3, cls_HL, cls_HY, cls_ID, cls_IN, cls_IS, cls_JL, cls_JT,
    cls_JV, cls_LF, cls_NL, cls_NS, cls_NU, cls_OP, cls_PO, cls_PR, cls_QU, cls_RI, cls_SP, cls_SY, cls_VF,
    cls_VI, cls_WJ, cls_ZW, cls_ZWJ,
  ]
  let mut i = 0
  while i < ids.length() {
    if ids[i] == c {
      return names[i]
    }
    i = i + 1
  }
  "?" + c.to_string()
}

///|
fn wb_hex(v : Int) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder::new()
  let mut shift = 20
  let mut started = false
  while shift >= 0 {
    let d = (v >> shift) & 15
    if d != 0 || started || shift <= 12 {
      sb.write_byte(digits.code_unit_at(d).to_byte())
      started = true
    }
    shift = shift - 4
  }
  sb.to_string()
}

///|
fn wb_key(cp : Int) -> String {
  let cid = lookup_combo(cp)
  raw_id_to_class(combo_raw_id(cid)).to_string() +
  " " +
  wb_res_name(combo_res_cls(cid)) +
  " " +
  combo_flags(cid).to_string()
}

///|
pub fn main(world : World) -> Int {
  let sb = StringBuilder::new()
  let mut lo = 0
  let mut cur = wb_key(0)
  let mut cp = 1
  while cp <= 0x110000 {
    let k = if cp < 0x110000 { wb_key(cp) } else { "" }
    if k != cur {
      sb.write_string(wb_hex(lo) + " " + wb_hex(cp - 1) + " " + cur + "\n")
      lo = cp
      cur = k
    }
    cp = cp + 1
  }
  io_print(world, sb.to_string())
  0
}
