///|
pub fn Template::name(self : Template) -> String {
  self.name
}

///|
pub fn Template::render(
  self : Template,
  ctx : Value,
) -> Result[String, TemplateError] {
  let _ = self
  let _ = ctx
  Err(
    TemplateError::new(
      ErrorKind::InvalidOperation,
      "not implemented",
      None,
      0,
      0,
    ),
  )
}

///|
pub fn Template::render_to_builder(
  self : Template,
  ctx : Value,
  out : StringBuilder,
) -> Result[Unit, TemplateError] {
  let _ = self
  let _ = ctx
  let _ = out
  Err(
    TemplateError::new(
      ErrorKind::InvalidOperation,
      "not implemented",
      None,
      0,
      0,
    ),
  )
}

///|
pub fn render(source : String, ctx : Value) -> Result[String, TemplateError] {
  let env = Environment::new()
  env.render_str(source, ctx)
}

///|
pub fn render_html(
  source : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  let env = Environment::new()
  env.set_auto_escape(AutoEscape::Html)
  env.render_str(source, ctx)
}

///|
pub fn escape_html(s : String) -> String {
  let _ = s
  ""
}
