///| Pure-Pion MiniJinja-compatible Jinja2 template engine.
///| Zero C dependencies, Native + Wasm32 compatible, no `World` dependency.

///| Template compilation and rendering environment.
pub struct Environment {
  mut auto_escape_override : Option[AutoEscape]
  mut undefined_behavior : UndefinedBehavior
  mut keep_trailing_newline : Bool
  mut trim_blocks : Bool
  mut lstrip_blocks : Bool
  mut max_depth : Int
  mut fuel : Option[Int64]
  mut max_output_bytes : Int
  templates : Array[(String, CompiledTemplate)]
  globals : Array[(String, Value)]
  filters : Array[(String, (Value, Array[Value]) -> Result[Value, TemplateError])]
  tests : Array[(String, (Value, Array[Value]) -> Result[Bool, TemplateError])]
  functions : Array[(String, (Array[Value]) -> Result[Value, TemplateError])]
}

///| Pre-compiled template handle bound to an `Environment`.
pub struct Template {
  pub name : String
  env : Environment
  compiled : CompiledTemplate
}

///|
pub fn Environment::new() -> Environment {
  Environment::{
    auto_escape_override: None,
    undefined_behavior: UndefinedBehavior::Lenient,
    keep_trailing_newline: false,
    trim_blocks: false,
    lstrip_blocks: false,
    max_depth: 64,
    fuel: Some(10000000L),
    max_output_bytes: 16777216,
    templates: [],
    globals: [],
    filters: [],
    tests: [],
    functions: [],
  }
}

///|
pub fn Environment::set_auto_escape(
  self : Environment,
  mode : AutoEscape,
) -> Unit {
  self.auto_escape_override = Some(mode)
}

///|
pub fn Environment::set_auto_escape_by_extension(self : Environment) -> Unit {
  self.auto_escape_override = None
}

///|
pub fn Environment::set_undefined_behavior(
  self : Environment,
  behavior : UndefinedBehavior,
) -> Unit {
  self.undefined_behavior = behavior
}

///|
pub fn Environment::set_keep_trailing_newline(
  self : Environment,
  keep : Bool,
) -> Unit {
  self.keep_trailing_newline = keep
}

///|
pub fn Environment::set_trim_blocks(self : Environment, trim : Bool) -> Unit {
  self.trim_blocks = trim
}

///|
pub fn Environment::set_lstrip_blocks(
  self : Environment,
  lstrip : Bool,
) -> Unit {
  self.lstrip_blocks = lstrip
}

///|
pub fn Environment::set_max_depth(self : Environment, depth : Int) -> Unit {
  self.max_depth = depth
}

///|
pub fn Environment::set_fuel(
  self : Environment,
  fuel : Option[Int64],
) -> Unit {
  self.fuel = fuel
}

///|
pub fn Environment::set_max_output_bytes(
  self : Environment,
  max_bytes : Int,
) -> Unit {
  self.max_output_bytes = max_bytes
}

///|
pub fn Environment::add_global(
  self : Environment,
  name : String,
  value : Value,
) -> Unit {
  let mut i = 0
  while i < self.globals.length() {
    let (k, _) = self.globals[i]
    if k == name {
      self.globals[i] = (name, value)
      return
    }
    i = i + 1
  }
  self.globals.push((name, value))
}

///|
pub fn Environment::add_filter(
  self : Environment,
  name : String,
  f : (Value, Array[Value]) -> Result[Value, TemplateError],
) -> Unit {
  let mut i = 0
  while i < self.filters.length() {
    let (k, _) = self.filters[i]
    if k == name {
      self.filters[i] = (name, f)
      return
    }
    i = i + 1
  }
  self.filters.push((name, f))
}

///|
pub fn Environment::add_test(
  self : Environment,
  name : String,
  f : (Value, Array[Value]) -> Result[Bool, TemplateError],
) -> Unit {
  let mut i = 0
  while i < self.tests.length() {
    let (k, _) = self.tests[i]
    if k == name {
      self.tests[i] = (name, f)
      return
    }
    i = i + 1
  }
  self.tests.push((name, f))
}

///|
pub fn Environment::add_function(
  self : Environment,
  name : String,
  f : (Array[Value]) -> Result[Value, TemplateError],
) -> Unit {
  let mut i = 0
  while i < self.functions.length() {
    let (k, _) = self.functions[i]
    if k == name {
      self.functions[i] = (name, f)
      return
    }
    i = i + 1
  }
  self.functions.push((name, f))
}

fn Environment::lex_config(self : Environment) -> LexConfig {
  LexConfig::{
    keep_trailing_newline: self.keep_trailing_newline,
    trim_blocks: self.trim_blocks,
    lstrip_blocks: self.lstrip_blocks,
  }
}

fn Environment::resolve_auto_escape(
  self : Environment,
  name : String,
) -> AutoEscape {
  match self.auto_escape_override {
    Some(mode) => mode
    None =>
    if str_ends_with(name, ".html") ||
    str_ends_with(name, ".htm") ||
    str_ends_with(name, ".xml") ||
    str_ends_with(name, ".xhtml") ||
    str_ends_with(name, ".svg") {
      AutoEscape::Html
    } else if str_ends_with(name, ".json") {
      AutoEscape::Json
    } else {
      AutoEscape::None
    }
  }
}

fn Environment::find_compiled(
  self : Environment,
  name : String,
) -> Option[CompiledTemplate] {
  let mut i = 0
  while i < self.templates.length() {
    let (k, ct) = self.templates[i]
    if k == name {
      return Some(ct)
    }
    i = i + 1
  }
  None
}

///|
pub fn Environment::add_template(
  self : Environment,
  name : String,
  source : String,
) -> Result[Unit, TemplateError] {
  let compiled = match compile_template(
    name,
    source,
    self.lex_config(),
    self.max_depth,
  ) {
    Ok(ct) => ct
    Err(e) => return Err(e)
  }
  let mut i = 0
  while i < self.templates.length() {
    let (k, _) = self.templates[i]
    if k == name {
      self.templates[i] = (name, compiled)
      return Ok(())
    }
    i = i + 1
  }
  self.templates.push((name, compiled))
  Ok(())
}

///|
pub fn Environment::remove_template(self : Environment, name : String) -> Unit {
  let mut i = 0
  while i < self.templates.length() {
    let (k, _) = self.templates[i]
    if k == name {
      let last = self.templates.length() - 1
      if i < last {
        self.templates[i] = self.templates[last]
      }
      let _ = self.templates.pop()
      return
    }
    i = i + 1
  }
}

///|
pub fn Environment::get_template(
  self : Environment,
  name : String,
) -> Result[Template, TemplateError] {
  match self.find_compiled(name) {
    Some(ct) => Ok(Template::{ name: name, env: self, compiled: ct })
    None =>
    Err(
      TemplateError::new(
        ErrorKind::TemplateNotFound,
        "template not found: '" + name + "'",
        None,
        0,
        0,
      ),
    )
  }
}

///|
pub fn Environment::render_str(
  self : Environment,
  source : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  self.render_named_str("", source, ctx)
}

///|
pub fn Environment::render_named_str(
  self : Environment,
  name : String,
  source : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  let ct = match compile_template(name, source, self.lex_config(), self.max_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::with_capacity(source.length() + 64)
  match render_compiled(self, ct, ctx, sb) {
    Ok(()) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///|
pub fn Environment::render_template(
  self : Environment,
  name : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  match self.get_template(name) {
    Ok(tpl) => tpl.render(ctx)
    Err(e) => Err(e)
  }
}

///|
pub fn Environment::eval_expr(
  self : Environment,
  expr : String,
  ctx : Value,
) -> Result[Value, TemplateError] {
  let ast = match parse_expr_string(expr, self.max_depth) {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  let state = EvalState::new(self, None, AutoEscape::None, StringBuilder::new())
  state.push_scope()
  match ctx.kind {
    ValueKind::Map(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, v) = entries[i]
        state.set_local(k, v)
        i = i + 1
      }
    }
    _ => ()
  }
  state.eval_expr(ast)
}

///|
pub fn Template::name(self : Template) -> String {
  self.name
}

///|
pub fn Template::render(
  self : Template,
  ctx : Value,
) -> Result[String, TemplateError] {
  let sb = StringBuilder::with_capacity(256)
  match render_compiled(self.env, self.compiled, ctx, sb) {
    Ok(()) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///|
pub fn Template::render_to_builder(
  self : Template,
  ctx : Value,
  out : StringBuilder,
) -> Result[Unit, TemplateError] {
  render_compiled(self.env, self.compiled, ctx, out)
}

///|
pub fn render(source : String, ctx : Value) -> Result[String, TemplateError] {
  let env = Environment::new()
  env.render_str(source, ctx)
}

///|
pub fn render_html(
  source : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  let env = Environment::new()
  env.set_auto_escape(AutoEscape::Html)
  env.render_str(source, ctx)
}
