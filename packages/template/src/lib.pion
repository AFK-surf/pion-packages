  let _ = self
  let _ = name
  let _ = source
  let _ = ctx
  Err(
    TemplateError::new(
      ErrorKind::InvalidOperation,
      "not implemented",
      None,
      0,
      0,
    ),
  )
}

///|
pub fn Environment::render_template(
  self : Environment,
  name : String,
  ctx : Value,
) -> Result[String, TemplateError] {
  let _ = self
  let _ = name
  let _ = ctx
  Err(
    TemplateError::new(
      ErrorKind::InvalidOperation,
