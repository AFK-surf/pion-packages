///| AST evaluator for Jinja2/MiniJinja templates with Day-1 security limits.

struct LoopFrame {
  mut index0 : Int
  length : Int
  depth : Int
  is_range : Bool
  r_start : Int64
  r_step : Int64
  items : Array[Value]
}

fn LoopFrame::previtem(self : LoopFrame) -> Value {
  if self.index0 > 0 {
    if self.is_range {
      Value::from_i64(self.r_start + (self.index0 - 1).to_int64() * self.r_step)
    } else {
      self.items[self.index0 - 1]
    }
  } else {
    Value::undefined()
  }
}

fn LoopFrame::nextitem(self : LoopFrame) -> Value {
  if self.index0 + 1 < self.length {
    if self.is_range {
      Value::from_i64(self.r_start + (self.index0 + 1).to_int64() * self.r_step)
    } else {
      self.items[self.index0 + 1]
    }
  } else {
    Value::undefined()
  }
}

struct EvalState {
  env : Environment
  mut template_name : Option[String]
  root_ctx : Option[ValueMap]
  mut rc_k0 : String
  mut rc_v0 : Value
  mut rc_k1 : String
  mut rc_v1 : Value
  mut range_var_name : String
  mut range_var_val : Int64
  mut range_var_mark : Int
  scope_keys : Array[String]
  scope_vals : Array[Value]
  scope_marks : Array[Int]
  macro_names : Array[String]
  macro_defs : Array[MacroDef]
  module_names : Array[String]
  module_defs : Array[Array[MacroDef]]
  block_names : Array[String]
  block_bodies : Array[Array[Array[Stmt]]]
  active_block_names : Array[String]
  active_block_idxs : Array[Int]
  include_stack : Array[String]
  caller_stack : Array[Option[(Array[String], Array[Stmt])]]
  loop_stack : Array[LoopFrame]
  mut auto_escape : AutoEscape
  mut depth : Int
  mut has_fuel : Bool
  mut fuel_left : Int64
  max_output_bytes : Int
  mut out : StringBuilder
  mut out_bytes : Int
  mut suppress_output : Bool
  mut pending_extends : Option[(String, Int, Int)]
}

fn EvalState::new(
  env : Environment,
  template_name : Option[String],
  auto_escape : AutoEscape,
  out : StringBuilder,
  root_ctx : Option[ValueMap],
) -> EvalState {
  let (has_fuel, fuel_left) = match env.fuel {
    Some(f) => (true, f)
    None => (false, 0L)
  }
  EvalState::{
    env: env,
    template_name: template_name,
    root_ctx: root_ctx,
    rc_k0: "",
    rc_v0: Value::undefined(),
    rc_k1: "",
    rc_v1: Value::undefined(),
    range_var_name: "",
    range_var_val: 0L,
    range_var_mark: -1,
    scope_keys: [],
    scope_vals: [],
    scope_marks: [],
    macro_names: [],
    macro_defs: [],
    module_names: [],
    module_defs: [],
    block_names: [],
    block_bodies: [],
    active_block_names: [],
    active_block_idxs: [],
    include_stack: [],
    caller_stack: [],
    loop_stack: [],
    auto_escape: auto_escape,
    depth: 0,
    has_fuel: has_fuel,
    fuel_left: fuel_left,
    max_output_bytes: env.max_output_bytes,
    out: out,
    out_bytes: 0,
    suppress_output: false,
    pending_extends: None,
  }
}

fn EvalState::err(
  self : EvalState,
  kind : ErrorKind,
  msg : String,
  line : Int,
  col : Int,
) -> TemplateError {
  TemplateError::new(kind, msg, self.template_name, line, col)
}

fn EvalState::consume_fuel(
  self : EvalState,
  cost : Int64,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  if self.has_fuel {
    self.fuel_left = self.fuel_left - cost
    if self.fuel_left < 0L {
      return Err(
        self.err(
          ErrorKind::FuelExhausted,
          "template execution fuel exhausted",
          line,
          col,
        ),
      )
    }
  }
  Ok(())
}

fn EvalState::enter_depth(
  self : EvalState,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  self.depth = self.depth + 1
  if self.depth > self.env.max_depth {
    return Err(
      self.err(
        ErrorKind::RecursionLimit,
        "maximum recursion depth exceeded",
        line,
        col,
      ),
    )
  }
  Ok(())
}

fn EvalState::leave_depth(self : EvalState) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn EvalState::check_output_add(
  self : EvalState,
  add_bytes : Int,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  if self.max_output_bytes > 0 &&
  (add_bytes > self.max_output_bytes ||
    self.out_bytes + add_bytes > self.max_output_bytes) {
    return Err(
      self.err(
        ErrorKind::OutputLimitExceeded,
        "template output size limit exceeded",
        line,
        col,
      ),
    )
  }
  self.out_bytes = self.out_bytes + add_bytes
  Ok(())
}

fn EvalState::write_raw(
  self : EvalState,
  s : String,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  match self.check_output_add(s.length(), line, col) {
    Ok(()) => {
      self.out.write_string(s)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

fn EvalState::write_i64_direct(
  self : EvalState,
  n : Int64,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  if n >= 0L && n < 10L {
    if self.max_output_bytes > 0 && self.out_bytes + 1 > self.max_output_bytes {
      return Err(
        self.err(
          ErrorKind::OutputLimitExceeded,
          "template output size limit exceeded",
          line,
          col,
        ),
      )
    }
    self.out_bytes = self.out_bytes + 1
    self.out.write_byte((48 + n.to_int()).to_byte())
    return Ok(())
  }
  if n >= 10L && n < 100L {
    if self.max_output_bytes > 0 && self.out_bytes + 2 > self.max_output_bytes {
      return Err(
        self.err(
          ErrorKind::OutputLimitExceeded,
          "template output size limit exceeded",
          line,
          col,
        ),
      )
    }
    self.out_bytes = self.out_bytes + 2
    let v = n.to_int()
    self.out.write_byte((48 + v / 10).to_byte())
    self.out.write_byte((48 + v % 10).to_byte())
    return Ok(())
  }
  if n >= 100L && n < 1000L {
    if self.max_output_bytes > 0 && self.out_bytes + 3 > self.max_output_bytes {
      return Err(
        self.err(
          ErrorKind::OutputLimitExceeded,
          "template output size limit exceeded",
          line,
          col,
        ),
      )
    }
    self.out_bytes = self.out_bytes + 3
    let v = n.to_int()
    self.out.write_byte((48 + v / 100).to_byte())
    self.out.write_byte((48 + (v / 10) % 10).to_byte())
    self.out.write_byte((48 + v % 10).to_byte())
    return Ok(())
  }
  let s = n.to_string()
  self.write_raw(s, line, col)
}

fn EvalState::write_value_escaped(
  self : EvalState,
  v : Value,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  match self.auto_escape {
    AutoEscape::Html =>
    match v.kind {
      ValueKind::String(s) => {
        let slen = s.length()
        if self.max_output_bytes <= 0 ||
        (slen <= self.max_output_bytes / 6 &&
          self.out_bytes + slen * 6 <= self.max_output_bytes) {
          let written = write_escaped_html_count(self.out, s)
          self.out_bytes = self.out_bytes + written
          Ok(())
        } else {
          let elen = escaped_html_len(s)
          match self.check_output_add(elen, line, col) {
            Ok(()) => {
              let _ = write_escaped_html_count(self.out, s)
              Ok(())
            }
            Err(e) => Err(e)
          }
        }
      }
      ValueKind::Int(n) => self.write_i64_direct(n, line, col)
      ValueKind::SafeString(s) => self.write_raw(s, line, col)
      ValueKind::Undefined(_) =>
      match self.env.undefined_behavior {
        UndefinedBehavior::Strict =>
        Err(
          self.err(
            ErrorKind::UndefinedError,
            "undefined value cannot be rendered in strict mode",
            line,
            col,
          ),
        )
        UndefinedBehavior::Lenient => Ok(())
      }
      ValueKind::Bool(b) => self.write_raw(if b { "True" } else { "False" }, line, col)
      ValueKind::None(_) => self.write_raw("None", line, col)
      _ => {
        let s = v.to_display_string()
        let slen = s.length()
        if self.max_output_bytes <= 0 ||
        (slen <= self.max_output_bytes / 6 &&
          self.out_bytes + slen * 6 <= self.max_output_bytes) {
          let written = write_escaped_html_count(self.out, s)
          self.out_bytes = self.out_bytes + written
          Ok(())
        } else {
          let elen = escaped_html_len(s)
          match self.check_output_add(elen, line, col) {
            Ok(()) => {
              let _ = write_escaped_html_count(self.out, s)
              Ok(())
            }
            Err(e) => Err(e)
          }
        }
      }
    }
    AutoEscape::None =>
    match v.kind {
      ValueKind::String(s) => self.write_raw(s, line, col)
      ValueKind::SafeString(s) => self.write_raw(s, line, col)
      ValueKind::Int(n) => self.write_i64_direct(n, line, col)
      ValueKind::Undefined(_) =>
      match self.env.undefined_behavior {
        UndefinedBehavior::Strict =>
        Err(
          self.err(
            ErrorKind::UndefinedError,
            "undefined value cannot be rendered in strict mode",
            line,
            col,
          ),
        )
        UndefinedBehavior::Lenient => Ok(())
      }
      ValueKind::Bool(b) => self.write_raw(if b { "True" } else { "False" }, line, col)
      ValueKind::None(_) => self.write_raw("None", line, col)
      _ => self.write_raw(v.to_display_string(), line, col)
    }
    AutoEscape::Json =>
    match v.kind {
      ValueKind::Undefined(_) =>
      match self.env.undefined_behavior {
        UndefinedBehavior::Strict =>
        Err(
          self.err(
            ErrorKind::UndefinedError,
            "undefined value cannot be rendered in strict mode",
            line,
            col,
          ),
        )
        UndefinedBehavior::Lenient => Ok(())
      }
      ValueKind::SafeString(s) => self.write_raw(s, line, col)
      _ => {
        let sb = StringBuilder::new()
        match write_json_value(sb, v, -1, 0, false) {
          Ok(()) => self.write_raw(sb.to_string(), line, col)
          Err(e) => Err(e)
        }
      }
    }
  }
}

fn EvalState::push_scope(self : EvalState) -> Unit {
  self.scope_marks.push(self.scope_keys.length())
}

fn EvalState::pop_scope(self : EvalState) -> Unit {
  match self.scope_marks.pop() {
    Some(mark) => {
      while self.scope_keys.length() > mark {
        let _ = self.scope_keys.pop()
        let _ = self.scope_vals.pop()
      }
    }
    None => ()
  }
}

fn EvalState::set_local(self : EvalState, name : String, item_val : Value) -> Unit {
  let mlen = self.scope_marks.length()
  let start = if mlen > 0 { self.scope_marks[mlen - 1] } else { 0 }
  let ks = self.scope_keys
  let n = ks.length()
  let mut i = start
  while i < n {
    if ks[i] == name {
      self.scope_vals[i] = item_val
      return
    }
    i = i + 1
  }
  self.scope_keys.push(name)
  self.scope_vals.push(item_val)
}

fn EvalState::lookup_var(self : EvalState, name : String) -> Value {
  // Check `loop` magic variable if inside a loop (fast length+first-char guard)
  if self.loop_stack.length() > 0 && name.length() == 4 && name.code_unit_at(0) == 108 && name == "loop" {
    let lf = self.loop_stack[self.loop_stack.length() - 1]
    return Value::from_map([
      ("index", Value::from_int(lf.index0 + 1)),
      ("index0", Value::from_int(lf.index0)),
      ("revindex", Value::from_int(lf.length - lf.index0)),
      ("revindex0", Value::from_int(lf.length - lf.index0 - 1)),
      ("first", Value::from_bool(lf.index0 == 0)),
      ("last", Value::from_bool(lf.index0 + 1 == lf.length)),
      ("length", Value::from_int(lf.length)),
      ("depth", Value::from_int(lf.depth)),
      ("depth0", Value::from_int(lf.depth - 1)),
      ("previtem", lf.previtem()),
      ("nextitem", lf.nextitem()),
    ])
  }
  // Flat lexical scopes top-down (with unboxed range loop variable slot)
  let ks = self.scope_keys
  let rmark = self.range_var_mark
  let mut i = ks.length() - 1
  if rmark >= 0 {
    while i >= rmark {
      if ks[i] == name {
        return self.scope_vals[i]
      }
      i = i - 1
    }
    if self.range_var_name == name {
      return Value::from_i64(self.range_var_val)
    }
  }
  while i >= 0 {
    if ks[i] == name {
      return self.scope_vals[i]
    }
    i = i - 1
  }
  // 2-slot MRU cache for immutable root_ctx
  if self.rc_k0.length() > 0 && self.rc_k0 == name {
    return self.rc_v0
  }
  if self.rc_k1.length() > 0 && self.rc_k1 == name {
    return self.rc_v1
  }
  // Root context map (O(1) for >= 8 keys, parallel array scan for < 8 keys)
  match self.root_ctx {
    Some(rc) => {
      let rv = rc.get(name)
      if !rv.is_undefined() {
        self.rc_k1 = self.rc_k0
        self.rc_v1 = self.rc_v0
        self.rc_k0 = name
        self.rc_v0 = rv
        return rv
      }
    }
    None => ()
  }
  // Environment globals
  if self.env.global_names.length() > 0 {
    let mut gi = 0
    while gi < self.env.global_names.length() {
      if self.env.global_names[gi] == name {
        return self.env.global_vals[gi]
      }
      gi = gi + 1
    }
  }
  Value::undefined()
}

fn EvalState::find_macro(self : EvalState, name : String) -> Option[MacroDef] {
  let mut i = self.macro_names.length() - 1
  while i >= 0 {
    if self.macro_names[i] == name {
      return Some(self.macro_defs[i])
    }
    i = i - 1
  }
  None
}

fn EvalState::find_module_macro(
  self : EvalState,
  mod_name : String,
  macro_name : String,
) -> Option[MacroDef] {
  let mut i = self.module_names.length() - 1
  while i >= 0 {
    if self.module_names[i] == mod_name {
      let defs = self.module_defs[i]
      let mut j = 0
      while j < defs.length() {
        if defs[j].name == macro_name {
          return Some(defs[j])
        }
        j = j + 1
      }
      return None
    }
    i = i - 1
  }
  None
}

fn EvalState::find_block_chain(
  self : EvalState,
  bname : String,
) -> Option[Array[Array[Stmt]]] {
  let mut i = 0
  while i < self.block_names.length() {
    if self.block_names[i] == bname {
      return Some(self.block_bodies[i])
    }
    i = i + 1
  }
  None
}

fn EvalState::push_block_body(
  self : EvalState,
  bname : String,
  bbody : Array[Stmt],
) -> Unit {
  let mut i = 0
  while i < self.block_names.length() {
    if self.block_names[i] == bname {
      self.block_bodies[i].push(bbody)
      return
    }
    i = i + 1
  }
  self.block_names.push(bname)
  self.block_bodies.push([bbody])
}

fn EvalState::check_truthy(
  self : EvalState,
  v : Value,
  line : Int,
  col : Int,
) -> Result[Bool, TemplateError] {
  if v.is_undefined() {
    match self.env.undefined_behavior {
      UndefinedBehavior::Strict =>
      return Err(
        self.err(
          ErrorKind::UndefinedError,
          "undefined value used in boolean context",
          line,
          col,
        ),
      )
      UndefinedBehavior::Lenient => return Ok(false)
    }
  }
  Ok(v.is_truthy())
}

fn EvalState::eval_call_args(
  self : EvalState,
  args : Array[CallArg],
) -> Result[(Array[Value], Array[(String, Value)]), TemplateError] {
  let pos : Array[Value] = []
  let kw : Array[(String, Value)] = []
  let mut i = 0
  while i < args.length() {
    let v = match self.eval_expr(args[i].expr) {
      Ok(item_val) => item_val
      Err(e) => return Err(e)
    }
    match args[i].name {
      Some(k) => kw.push((k, v))
      None => pos.push(v)
    }
    i = i + 1
  }
  Ok((pos, kw))
}

fn EvalState::invoke_macro(
  self : EvalState,
  md : MacroDef,
  pos_args : Array[Value],
  kwargs : Array[(String, Value)],
  caller_opt : Option[(Array[String], Array[Stmt])],
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  // Reject too many positional arguments (P1-12)
  if pos_args.length() > md.params.length() {
    return Err(
      self.err(
        ErrorKind::TooManyArguments,
        "macro '" + md.name + "' takes at most " + md.params.length().to_string() + " arguments",
        line,
        col,
      ),
    )
  }
  // Reject unknown keyword arguments or duplicate positional+keyword binding (P1-12)
  let mut ki = 0
  while ki < kwargs.length() {
    let (kname, _) = kwargs[ki]
    let mut found_idx = -1
    let mut pj = 0
    while pj < md.params.length() {
      let (pn, _) = md.params[pj]
      if pn == kname {
        found_idx = pj
        break
      }
      pj = pj + 1
    }
    if found_idx < 0 {
      return Err(
        self.err(
          ErrorKind::TooManyArguments,
          "macro '" + md.name + "' got an unexpected keyword argument '" + kname + "'",
          line,
          col,
        ),
      )
    }
    if found_idx < pos_args.length() {
      return Err(
        self.err(
          ErrorKind::InvalidOperation,
          "macro '" + md.name + "' got multiple values for argument '" + kname + "'",
          line,
          col,
        ),
      )
    }
    ki = ki + 1
  }
  match self.enter_depth(line, col) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  match self.consume_fuel(1L, line, col) {
    Ok(()) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  self.push_scope()
  self.caller_stack.push(caller_opt)
  let mut pi = 0
  while pi < md.params.length() {
    let (pname, def_opt) = md.params[pi]
    let item_val = if pi < pos_args.length() {
      pos_args[pi]
    } else {
      match get_kwarg(kwargs, pname) {
        Some(kv) => kv
        None =>
        match def_opt {
          Some(def_expr) =>
          match self.eval_expr(def_expr) {
            Ok(dv) => dv
            Err(e) => {
              let _ = self.caller_stack.pop()
              self.pop_scope()
              self.leave_depth()
              return Err(e)
            }
          }
          None => Value::undefined()
        }
      }
    }
    self.set_local(pname, item_val)
    pi = pi + 1
  }
  let saved_out = self.out
  let saved_bytes = self.out_bytes
  let cap_sb = StringBuilder::new()
  self.out = cap_sb
  let res = self.exec_stmts(md.body)
  let captured = self.out.to_string()
  self.out = saved_out
  self.out_bytes = saved_bytes
  let _ = self.caller_stack.pop()
  self.pop_scope()
  self.leave_depth()
  match res {
    Ok(()) =>
    match self.auto_escape {
      AutoEscape::Html => Ok(Value::safe(captured))
      _ => Ok(Value::from_string(captured))
    }
    Err(e) => Err(e)
  }
}

///| Check whether `v` has container nesting depth >= `limit` (stops at `limit`,
///| preventing runtime-built deeply nested lists/maps from overflowing Wasm32 stack).
fn container_exceeds_depth(v : Value, limit : Int) -> Bool {
  if limit <= 0 {
    return match v.kind {
      ValueKind::Seq(_) => true
      ValueKind::Map(_) => true
      _ => false
    }
  }
  match v.kind {
    ValueKind::Seq(items) => {
      // Only need to descend into nested containers; cap scan width for O(1) fast path
      let n = if items.length() < 8 { items.length() } else { 8 }
      let mut i = 0
      while i < n {
        if container_exceeds_depth(items[i], limit - 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    ValueKind::Map(m) => {
      let n = if m.vals.length() < 8 { m.vals.length() } else { 8 }
      let mut i = 0
      while i < n {
        if container_exceeds_depth(m.vals[i], limit - 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

fn EvalState::eval_expr(
  self : EvalState,
  expr : Expr,
) -> Result[Value, TemplateError] {
  match expr {
    Expr::Const(v, _, _) => Ok(v)
    Expr::Var(name, _, _) => Ok(self.lookup_var(name))
    Expr::List(items, line, col) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < items.length() {
        match self.eval_expr(items[i]) {
          Ok(v) => {
            if self.env.max_depth > 0 && container_exceeds_depth(v, self.env.max_depth) {
              return Err(
                self.err(
                  ErrorKind::RecursionLimit,
                  "maximum container nesting depth exceeded",
                  line,
                  col,
                ),
              )
            }
            out.push(v)
          }
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(Value::from_seq(out))
    }
    Expr::Map(pairs, line, col) => {
      let keys : Array[String] = []
      let vals : Array[Value] = []
      let mut i = 0
      while i < pairs.length() {
        let (ke, ve) = pairs[i]
        let kv = match self.eval_expr(ke) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let vv = match self.eval_expr(ve) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if self.env.max_depth > 0 && container_exceeds_depth(vv, self.env.max_depth) {
          return Err(
            self.err(
              ErrorKind::RecursionLimit,
              "maximum container nesting depth exceeded",
              line,
              col,
            ),
          )
        }
        keys.push(kv.to_display_string())
        vals.push(vv)
        i = i + 1
      }
      Ok(value_from_map_parallel(keys, vals))
    }
    Expr::Unary(op, sub, line, col) => {
      let v = match self.eval_expr(sub) {
        Ok(item_val) => item_val
        Err(e) => return Err(e)
      }
      match op {
        UnaryOp::Not => {
          match self.check_truthy(v, line, col) {
            Ok(b) => Ok(Value::from_bool(!b))
            Err(e) => Err(e)
          }
        }
        UnaryOp::Neg =>
        match v.kind {
          ValueKind::Int(n) =>
          if n == I64_MIN {
            match i128_neg(i128_from_i64(n)) {
              Some(r) => Ok(value_from_i128(r))
              None =>
              Err(
                self.err(ErrorKind::InvalidOperation, "integer negation overflow", line, col),
              )
            }
          } else {
            Ok(Value::from_i64(0L - n))
          }
          ValueKind::BigInt(b) =>
          match i128_neg(b) {
            Some(r) => Ok(value_from_i128(r))
            None =>
            Err(
              self.err(ErrorKind::InvalidOperation, "integer negation overflow", line, col),
            )
          }
          ValueKind::Float(f) => Ok(Value::from_float(0.0 - f))
          _ =>
          Err(
            self.err(
              ErrorKind::InvalidOperation,
              "cannot negate non-number",
              line,
              col,
            ),
          )
        }
        UnaryOp::Pos =>
        match v.kind {
          ValueKind::Int(_) => Ok(v)
          ValueKind::BigInt(_) => Ok(v)
          ValueKind::Float(_) => Ok(v)
          _ =>
          Err(
            self.err(
              ErrorKind::InvalidOperation,
              "unary + requires a number",
              line,
              col,
            ),
          )
        }
      }
    }
    Expr::IfExpr(cond, then_e, else_opt, line, col) => {
      let cv = match self.eval_expr(cond) {
        Ok(item_val) => item_val
        Err(e) => return Err(e)
      }
      let truthy = match self.check_truthy(cv, line, col) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      if truthy {
        self.eval_expr(then_e)
      } else {
        match else_opt {
          Some(ee) => self.eval_expr(ee)
          None => Ok(Value::undefined())
        }
      }
    }
    Expr::Compare(first_e, cmps, line, col) => {
      let mut prev = match self.eval_expr(first_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < cmps.length() {
        let (op, rhs_e) = cmps[i]
        let cur = match self.eval_expr(rhs_e) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match self.eval_binop(op, prev, cur, line, col) {
          Ok(res) =>
          if !res.is_truthy() {
            return Ok(Value::from_bool(false))
          }
          Err(e) => return Err(e)
        }
        prev = cur
        i = i + 1
      }
      Ok(Value::from_bool(true))
    }
    Expr::Bin(op, lhs_e, rhs_e, line, col) => {
      // Short-circuit logical operators
      match op {
        BinOp::And => {
          let lv = match self.eval_expr(lhs_e) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let lt = match self.check_truthy(lv, line, col) {
            Ok(b) => b
            Err(e) => return Err(e)
          }
          if !lt {
            return Ok(lv)
          }
          return self.eval_expr(rhs_e)
        }
        BinOp::Or => {
          let lv = match self.eval_expr(lhs_e) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let lt = match self.check_truthy(lv, line, col) {
            Ok(b) => b
            Err(e) => return Err(e)
          }
          if lt {
            return Ok(lv)
          }
          return self.eval_expr(rhs_e)
        }
        _ => ()
      }
      let lv = match self.eval_expr(lhs_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rv = match self.eval_expr(rhs_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      self.eval_binop(op, lv, rv, line, col)
    }
    Expr::GetAttr(obj_e, attr, line, col) => {
      // Zero-allocation fast path for `loop.<field>` inside `for` loops
      match obj_e {
        Expr::Var(vname, _, _) =>
        if vname == "loop" && self.loop_stack.length() > 0 {
          let lf = self.loop_stack[self.loop_stack.length() - 1]
          if attr == "index" {
            return Ok(Value::from_int(lf.index0 + 1))
          }
          if attr == "index0" {
            return Ok(Value::from_int(lf.index0))
          }
          if attr == "first" {
            return Ok(Value::from_bool(lf.index0 == 0))
          }
          if attr == "last" {
            return Ok(Value::from_bool(lf.index0 + 1 == lf.length))
          }
          if attr == "length" {
            return Ok(Value::from_int(lf.length))
          }
          if attr == "revindex" {
            return Ok(Value::from_int(lf.length - lf.index0))
          }
          if attr == "revindex0" {
            return Ok(Value::from_int(lf.length - lf.index0 - 1))
          }
          if attr == "depth" {
            return Ok(Value::from_int(lf.depth))
          }
          if attr == "depth0" {
            return Ok(Value::from_int(lf.depth - 1))
          }
          if attr == "previtem" {
            return Ok(lf.previtem())
          }
          if attr == "nextitem" {
            return Ok(lf.nextitem())
          }
          return Ok(Value::undefined())
        }
        _ => ()
      }
      let obj = match self.eval_expr(obj_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if obj.is_undefined() {
        match self.env.undefined_behavior {
          UndefinedBehavior::Strict =>
          return Err(
            self.err(
              ErrorKind::UndefinedError,
              "cannot access attribute '" + attr + "' on undefined",
              line,
              col,
            ),
          )
          UndefinedBehavior::Lenient => return Ok(Value::undefined())
        }
      }
      Ok(obj.get_attr(attr))
    }
    Expr::GetItem(obj_e, idx_e, line, col) => {
      let obj = match self.eval_expr(obj_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if obj.is_undefined() {
        match self.env.undefined_behavior {
          UndefinedBehavior::Strict =>
          return Err(
            self.err(
              ErrorKind::UndefinedError,
              "cannot subscript undefined",
              line,
              col,
            ),
          )
          UndefinedBehavior::Lenient => return Ok(Value::undefined())
        }
      }
      // Unboxed Int64 fast path for sequence indexing (e.g. `users[i % 3]`, `items[i]`)
      match self.try_eval_i64(idx_e) {
        Some(n) => return Ok(obj.get_index(n.to_int()))
        None => ()
      }
      let idx = match self.eval_expr(idx_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match idx.kind {
        ValueKind::Int(n) => Ok(obj.get_index(n.to_int()))
        _ =>
        match idx.as_i64() {
          Some(n) => Ok(obj.get_index(n.to_int()))
          None => Ok(obj.get_attr(idx.to_display_string()))
        }
      }
    }
    Expr::Slice(obj_e, start_opt, stop_opt, step_opt, line, col) => {
      let obj = match self.eval_expr(obj_e) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let start_v : Option[Int] = match start_opt {
        Some(e) =>
        match self.eval_expr(e) {
          Ok(v) =>
          match v.as_i64() {
            Some(n) => Some(n.to_int())
            None => None
          }
          Err(er) => return Err(er)
        }
        None => None
      }
      let stop_v : Option[Int] = match stop_opt {
        Some(e) =>
        match self.eval_expr(e) {
          Ok(v) =>
          match v.as_i64() {
            Some(n) => Some(n.to_int())
            None => None
          }
          Err(er) => return Err(er)
        }
        None => None
      }
      let step = match step_opt {
        Some(e) =>
        match self.eval_expr(e) {
          Ok(v) =>
          match v.as_i64() {
            Some(n) => n.to_int()
            None => 1
          }
          Err(er) => return Err(er)
        }
        None => 1
      }
      if step == 0 {
        return Err(
          self.err(
            ErrorKind::InvalidOperation,
            "slice step cannot be zero",
            line,
            col,
          ),
        )
      }
      self.eval_slice(obj, start_v, stop_v, step, line, col)
    }
    Expr::Filter(target_e, fname, args, line, col) => {
      let v = match self.eval_expr(target_e) {
        Ok(item_val) => item_val
        Err(e) => return Err(e)
      }
      if self.env.filter_names.length() == 0 {
        let nargs = args.length()
        if nargs == 0 {
          if fname == "upper" {
            return Ok(preserve_safe_str(v, utf8_to_upper(v.to_display_string())))
          }
          if fname == "lower" {
            return Ok(preserve_safe_str(v, utf8_to_lower(v.to_display_string())))
          }
          if fname == "title" {
            return Ok(preserve_safe_str(v, utf8_to_title(v.to_display_string())))
          }
          if fname == "trim" {
            return Ok(preserve_safe_str(v, str_trim(v.to_display_string(), None)))
          }
          if fname == "length" || fname == "count" {
            let n = match v.kind {
              ValueKind::String(s) => utf8_codepoint_count(s).to_int64()
              ValueKind::SafeString(s) => utf8_codepoint_count(s).to_int64()
              ValueKind::Seq(a) => a.length().to_int64()
              ValueKind::Map(m) => m.length().to_int64()
              ValueKind::Range(a, b, s) => range_len(a, b, s)
              _ => 0L
            }
            return Ok(Value::from_i64(n))
          }
          if fname == "safe" {
            return Ok(Value::safe(v.to_display_string()))
          }
          if fname == "e" || fname == "escape" {
            if v.is_safe() {
              return Ok(v)
            }
            return Ok(Value::safe(escape_html(v.to_display_string())))
          }
          if fname == "default" || fname == "d" {
            return Ok(if v.is_undefined() { Value::from_string("") } else { v })
          }
        } else if nargs == 1 && args[0].name.is_none() && (fname == "default" || fname == "d") {
          let def_val = match self.eval_expr(args[0].expr) {
            Ok(dv) => dv
            Err(e) => return Err(e)
          }
          return Ok(if v.is_undefined() { def_val } else { v })
        }
      }
      let (pos, kw) = match self.eval_call_args(args) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      eval_filter(self, fname, v, pos, kw, self.template_name, line, col)
    }
    Expr::Test(target_e, tname, args, negated, line, col) => {
      let v = match self.eval_expr(target_e) {
        Ok(item_val) => item_val
        Err(e) => return Err(e)
      }
      let (pos, _) = match self.eval_call_args(args) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match eval_test(self.env, tname, v, pos, self.template_name, line, col) {
        Ok(b) => Ok(Value::from_bool(if negated { !b } else { b }))
        Err(e) => Err(e)
      }
    }
    Expr::Call(callee, args, line, col) => {
      // Zero-allocation fast path for `loop.cycle(...)`
      match callee {
        Expr::GetAttr(obj_e, mname, _, _) =>
        if mname == "cycle" && self.loop_stack.length() > 0 {
          match obj_e {
            Expr::Var(vname, _, _) =>
            if vname == "loop" {
              let nargs = args.length()
              if nargs == 0 {
                return Ok(Value::undefined())
              }
              let lf = self.loop_stack[self.loop_stack.length() - 1]
              return self.eval_expr(args[lf.index0 % nargs].expr)
            }
            _ => ()
          }
        }
        _ => ()
      }
      let (pos, kw) = match self.eval_call_args(args) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      self.eval_call(callee, pos, kw, None, line, col)
    }
  }
}

fn EvalState::eval_slice(
  self : EvalState,
  obj : Value,
  start_opt : Option[Int],
  stop_opt : Option[Int],
  step : Int,
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  match obj.kind {
    ValueKind::Seq(items) => {
      let n = items.length()
      let out : Array[Value] = []
      if step > 0 {
        let mut s = match start_opt {
          Some(x) => if x < 0 { n + x } else { x }
          None => 0
        }
        let mut e = match stop_opt {
          Some(x) => if x < 0 { n + x } else { x }
          None => n
        }
        if s < 0 { s = 0 }
        if s > n { s = n }
        if e < 0 { e = 0 }
        if e > n { e = n }
        let mut i = s
        while i < e {
          out.push(items[i])
          i = i + step
        }
      } else {
        let mut s = match start_opt {
          Some(x) => if x < 0 { n + x } else { x }
          None => n - 1
        }
        let mut e = match stop_opt {
          Some(x) => if x < 0 { n + x } else { x }
          None => -1
        }
        if s >= n { s = n - 1 }
        if s < -1 { s = -1 }
        if e >= n { e = n - 1 }
        if e < -1 { e = -1 }
        let mut i = s
        while i > e {
          out.push(items[i])
          i = i + step
        }
      }
      Ok(Value::from_seq(out))
    }
    ValueKind::String(str_val) =>
    Ok(Value::from_string(utf8_slice(str_val, start_opt, stop_opt, step)))
    ValueKind::SafeString(str_val) =>
    Ok(Value::from_string(utf8_slice(str_val, start_opt, stop_opt, step)))
    _ =>
    Err(
      self.err(
        ErrorKind::InvalidOperation,
        "value is not sliceable",
        line,
        col,
      ),
    )
  }
}

fn eval_float_pow(base : Double, exp : Double) -> Double {
  if exp == 0.0 {
    return 1.0
  }
  if exp == 1.0 {
    return base
  }
  // Exact integer exponent fast path
  if exp >= -1000.0 && exp <= 1000.0 {
    let ei = exp.to_int64()
    if ei.to_double() == exp {
      let neg = ei < 0L
      let mut e = if neg { 0L - ei } else { ei }
      let mut acc = 1.0
      let mut b = base
      while e > 0L {
        if (e & 1L) != 0L {
          acc = acc * b
        }
        b = b * b
        e = e >> 1
      }
      return if neg { 1.0 / acc } else { acc }
    }
  }
  // Common 0.5 (sqrt via Newton-Raphson)
  if exp == 0.5 && base >= 0.0 {
    if base == 0.0 {
      return 0.0
    }
    let mut x = if base > 1.0 { base * 0.5 } else { 1.0 }
    let mut k = 0
    while k < 30 {
      x = 0.5 * (x + base / x)
      k = k + 1
    }
    return x
  }
  // Fallback for positive base: exp(exp * ln(base)) via range-reduced series
  if base > 0.0 {
    // Reduce base = m * 2^k with m in [0.5, 1.5]
    let mut m = base
    let mut k = 0
    while m > 1.5 {
      m = m * 0.5
      k = k + 1
    }
    while m < 0.75 {
      m = m * 2.0
      k = k - 1
    }
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    let mut term = y
    let mut sum = y
    let mut n = 3
    while n <= 25 {
      term = term * y2
      sum = sum + term / n.to_double()
      n = n + 2
    }
    let ln_base = 2.0 * sum + k.to_double() * 0.6931471805599453
    let p = exp * ln_base
    // Compute exp(p) = 2^q * exp(r)
    let ln2 = 0.6931471805599453
    let q_d = p / ln2
    if q_d > 1024.0 {
      return 1.0 / 0.0
    }
    if q_d < -1075.0 {
      return 0.0
    }
    let q = safe_floor_i64(q_d + 0.5).to_int()
    let r = p - q.to_double() * ln2
    let mut eterm = 1.0
    let mut esum = 1.0
    let mut j = 1
    while j <= 20 {
      eterm = eterm * r / j.to_double()
      esum = esum + eterm
      j = j + 1
    }
    let mut scale = 1.0
    let mut abs_q = if q < 0 { 0 - q } else { q }
    let mut step_b = if q < 0 { 0.5 } else { 2.0 }
    while abs_q > 0 {
      if (abs_q & 1) != 0 {
        scale = scale * step_b
      }
      step_b = step_b * step_b
      abs_q = abs_q >> 1
    }
    return esum * scale
  }
  0.0 / 0.0
}

fn EvalState::eval_binop(
  self : EvalState,
  op : BinOp,
  lv : Value,
  rv : Value,
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  match op {
    BinOp::Concat => {
      let is_html = match self.auto_escape {
        AutoEscape::Html => true
        _ => false
      }
      let any_safe = is_html && (lv.is_safe() || rv.is_safe())
      let ls = if any_safe && !lv.is_safe() {
        escape_html(lv.to_display_string())
      } else {
        lv.to_display_string()
      }
      let rs = if any_safe && !rv.is_safe() {
        escape_html(rv.to_display_string())
      } else {
        rv.to_display_string()
      }
      if self.max_output_bytes > 0 &&
      ls.length() + rs.length() > self.max_output_bytes {
        return Err(
          self.err(
            ErrorKind::OutputLimitExceeded,
            "string concatenation exceeds output limit",
            line,
            col,
          ),
        )
      }
      Ok(if any_safe { Value::safe(ls + rs) } else { Value::from_string(ls + rs) })
    }
    BinOp::Eq => Ok(Value::from_bool(lv.equals(rv)))
    BinOp::Ne => Ok(Value::from_bool(!lv.equals(rv)))
    BinOp::Lt => Ok(Value::from_bool(value_sort_compare(lv, rv, true, 0) < 0))
    BinOp::Le => Ok(Value::from_bool(value_sort_compare(lv, rv, true, 0) <= 0))
    BinOp::Gt => Ok(Value::from_bool(value_sort_compare(lv, rv, true, 0) > 0))
    BinOp::Ge => Ok(Value::from_bool(value_sort_compare(lv, rv, true, 0) >= 0))
    BinOp::In => Ok(Value::from_bool(eval_in(lv, rv)))
    BinOp::NotIn => Ok(Value::from_bool(!eval_in(lv, rv)))
    BinOp::Add =>
    match (lv.kind, rv.kind) {
      (ValueKind::Int(a), ValueKind::Int(b)) =>
      match checked_add_i64(a, b) {
        Some(v) => Ok(v)
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer addition overflow", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::BigInt(b)) =>
      match i128_add(a, b) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer addition overflow", line, col))
      }
      (ValueKind::Int(a), ValueKind::BigInt(b)) =>
      match i128_add(i128_from_i64(a), b) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer addition overflow", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::Int(b)) =>
      match i128_add(a, i128_from_i64(b)) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer addition overflow", line, col))
      }
      (ValueKind::Float(a), ValueKind::Float(b)) => Ok(Value::from_float(a + b))
      (ValueKind::Int(a), ValueKind::Float(b)) =>
      Ok(Value::from_float(a.to_double() + b))
      (ValueKind::Float(a), ValueKind::Int(b)) =>
      Ok(Value::from_float(a + b.to_double()))
      (ValueKind::BigInt(a), ValueKind::Float(b)) =>
      Ok(Value::from_float(i128_to_double(a) + b))
      (ValueKind::Float(a), ValueKind::BigInt(b)) =>
      Ok(Value::from_float(a + i128_to_double(b)))
      (ValueKind::String(a), ValueKind::String(b)) => {
        if self.max_output_bytes > 0 &&
        a.length() + b.length() > self.max_output_bytes {
          return Err(
            self.err(
              ErrorKind::OutputLimitExceeded,
              "string concat exceeds output limit",
              line,
              col,
            ),
          )
        }
        Ok(Value::from_string(a + b))
      }
      (ValueKind::SafeString(_), ValueKind::String(_)) =>
      self.eval_binop(BinOp::Concat, lv, rv, line, col)
      (ValueKind::String(_), ValueKind::SafeString(_)) =>
      self.eval_binop(BinOp::Concat, lv, rv, line, col)
      (ValueKind::SafeString(_), ValueKind::SafeString(_)) =>
      self.eval_binop(BinOp::Concat, lv, rv, line, col)
      (ValueKind::Seq(a), ValueKind::Seq(b)) => {
        let total = a.length() + b.length()
        let max_elems = if self.max_output_bytes > 0 {
          let by_bytes = self.max_output_bytes / 8
          if by_bytes < 100000 { by_bytes } else { 100000 }
        } else {
          100000
        }
        if total > max_elems {
          return Err(
            self.err(
              ErrorKind::OutputLimitExceeded,
              "list concatenation exceeds size limit",
              line,
              col,
            ),
          )
        }
        match self.consume_fuel(total.to_int64(), line, col) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let out : Array[Value] = []
        let mut i = 0
        while i < a.length() {
          out.push(a[i])
          i = i + 1
        }
        i = 0
        while i < b.length() {
          out.push(b[i])
          i = i + 1
        }
        Ok(Value::from_seq(out))
      }
      _ =>
      Err(
        self.err(
          ErrorKind::InvalidOperation,
          "invalid operands for '+'",
          line,
          col,
        ),
      )
    }
    BinOp::Sub =>
    match (lv.kind, rv.kind) {
      (ValueKind::Int(a), ValueKind::Int(b)) =>
      match checked_sub_i64(a, b) {
        Some(v) => Ok(v)
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer subtraction overflow", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::BigInt(b)) =>
      match i128_sub(a, b) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer subtraction overflow", line, col))
      }
      (ValueKind::Int(a), ValueKind::BigInt(b)) =>
      match i128_sub(i128_from_i64(a), b) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer subtraction overflow", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::Int(b)) =>
      match i128_sub(a, i128_from_i64(b)) {
        Some(r) => Ok(value_from_i128(r))
        None =>
        Err(self.err(ErrorKind::InvalidOperation, "integer subtraction overflow", line, col))
      }
      (ValueKind::Float(a), ValueKind::Float(b)) => Ok(Value::from_float(a - b))
      (ValueKind::Int(a), ValueKind::Float(b)) =>
      Ok(Value::from_float(a.to_double() - b))
      (ValueKind::Float(a), ValueKind::Int(b)) =>
      Ok(Value::from_float(a - b.to_double()))
      (ValueKind::BigInt(a), ValueKind::Float(b)) =>
      Ok(Value::from_float(i128_to_double(a) - b))
      (ValueKind::Float(a), ValueKind::BigInt(b)) =>
      Ok(Value::from_float(a - i128_to_double(b)))
      _ =>
      Err(
        self.err(
          ErrorKind::InvalidOperation,
          "invalid operands for '-'",
          line,
          col,
        ),
      )
    }
    BinOp::Mul => {
      // String repeat or list repeat with output limit protection!
      match (lv.kind, rv.kind) {
        (ValueKind::Int(a), ValueKind::Int(b)) =>
        match checked_mul_i64(a, b) {
          Some(v) => Ok(v)
          None =>
          Err(self.err(ErrorKind::InvalidOperation, "integer multiplication overflow", line, col))
        }
        (ValueKind::BigInt(a), ValueKind::BigInt(b)) =>
        match i128_mul(a, b) {
          Some(r) => Ok(value_from_i128(r))
          None =>
          Err(self.err(ErrorKind::InvalidOperation, "integer multiplication overflow", line, col))
        }
        (ValueKind::Int(a), ValueKind::BigInt(b)) =>
        match i128_mul(i128_from_i64(a), b) {
          Some(r) => Ok(value_from_i128(r))
          None =>
          Err(self.err(ErrorKind::InvalidOperation, "integer multiplication overflow", line, col))
        }
        (ValueKind::BigInt(a), ValueKind::Int(b)) =>
        match i128_mul(a, i128_from_i64(b)) {
          Some(r) => Ok(value_from_i128(r))
          None =>
          Err(self.err(ErrorKind::InvalidOperation, "integer multiplication overflow", line, col))
        }
        (ValueKind::Float(a), ValueKind::Float(b)) => Ok(Value::from_float(a * b))
        (ValueKind::Int(a), ValueKind::Float(b)) =>
        Ok(Value::from_float(a.to_double() * b))
        (ValueKind::Float(a), ValueKind::Int(b)) =>
        Ok(Value::from_float(a * b.to_double()))
        (ValueKind::BigInt(a), ValueKind::Float(b)) =>
        Ok(Value::from_float(i128_to_double(a) * b))
        (ValueKind::Float(a), ValueKind::BigInt(b)) =>
        Ok(Value::from_float(a * i128_to_double(b)))
        (ValueKind::String(s), ValueKind::Int(n)) => self.repeat_string(s, n, false, line, col)
        (ValueKind::Int(n), ValueKind::String(s)) => self.repeat_string(s, n, false, line, col)
        (ValueKind::SafeString(s), ValueKind::Int(n)) => self.repeat_string(s, n, true, line, col)
        (ValueKind::Int(n), ValueKind::SafeString(s)) => self.repeat_string(s, n, true, line, col)
        (ValueKind::Seq(items), ValueKind::Int(n)) => self.repeat_seq(items, n, line, col)
        (ValueKind::Int(n), ValueKind::Seq(items)) => self.repeat_seq(items, n, line, col)
        _ =>
        Err(
          self.err(
            ErrorKind::InvalidOperation,
            "invalid operands for '*'",
            line,
            col,
          ),
        )
      }
    }
    BinOp::Div =>
    match (lv.as_f64(), rv.as_f64()) {
      (Some(a), Some(b)) => {
        if b == 0.0 {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "division by zero",
              line,
              col,
            ),
          )
        }
        Ok(Value::from_float(a / b))
      }
      _ =>
      Err(
        self.err(
          ErrorKind::InvalidOperation,
          "invalid operands for '/'",
          line,
          col,
        ),
      )
    }
    BinOp::FloorDiv =>
    match (lv.kind, rv.kind) {
      (ValueKind::Int(a), ValueKind::Int(b)) => {
        if b == 0L {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "integer division by zero",
              line,
              col,
            ),
          )
        }
        // Guard I64_MIN // -1 against hardware / Wasm32 trap (P0-2)
        if a == I64_MIN && b == -1L {
          return Ok(
            value_from_i128(I128::{ neg: false, l0: 0L, l1: 0L, l2: 2048L, l3: 0L, l4: 0L }),
          )
        }
        let q = a / b
        let r = a % b
        let adj = if r != 0L && ((r < 0L) != (b < 0L)) { q - 1L } else { q }
        Ok(Value::from_i64(adj))
      }
      (ValueKind::BigInt(a), ValueKind::BigInt(b)) =>
      match i128_floor_divmod(a, b) {
        Some((q, _)) => Ok(value_from_i128(q))
        None => Err(self.err(ErrorKind::InvalidOperation, "integer division error", line, col))
      }
      (ValueKind::Int(a), ValueKind::BigInt(b)) =>
      match i128_floor_divmod(i128_from_i64(a), b) {
        Some((q, _)) => Ok(value_from_i128(q))
        None => Err(self.err(ErrorKind::InvalidOperation, "integer division error", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::Int(b)) =>
      match i128_floor_divmod(a, i128_from_i64(b)) {
        Some((q, _)) => Ok(value_from_i128(q))
        None => Err(self.err(ErrorKind::InvalidOperation, "integer division error", line, col))
      }
      _ =>
      match (lv.as_f64(), rv.as_f64()) {
        (Some(a), Some(b)) => {
          if b == 0.0 {
            return Err(
              self.err(
                ErrorKind::InvalidOperation,
                "division by zero",
                line,
                col,
              ),
            )
          }
          let q = a / b
          if q != q || (q - q) != 0.0 || q >= 4503599627370496.0 || q <= -4503599627370496.0 {
            return Ok(Value::from_float(q))
          }
          Ok(Value::from_float(safe_floor_i64(q).to_double()))
        }
        _ =>
        Err(
          self.err(
            ErrorKind::InvalidOperation,
            "invalid operands for '//'",
            line,
            col,
          ),
        )
      }
    }
    BinOp::Rem =>
    match (lv.kind, rv.kind) {
      (ValueKind::Int(a), ValueKind::Int(b)) => {
        if b == 0L {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "modulo by zero",
              line,
              col,
            ),
          )
        }
        // Guard I64_MIN % -1 against Wasm32 trap (P0-2)
        if a == I64_MIN && b == -1L {
          return Ok(Value::from_i64(0L))
        }
        let r = a % b
        let adj = if r != 0L && ((r < 0L) != (b < 0L)) { r + b } else { r }
        Ok(Value::from_i64(adj))
      }
      (ValueKind::BigInt(a), ValueKind::BigInt(b)) =>
      match i128_floor_divmod(a, b) {
        Some((_, r)) => Ok(value_from_i128(r))
        None => Err(self.err(ErrorKind::InvalidOperation, "modulo error", line, col))
      }
      (ValueKind::Int(a), ValueKind::BigInt(b)) =>
      match i128_floor_divmod(i128_from_i64(a), b) {
        Some((_, r)) => Ok(value_from_i128(r))
        None => Err(self.err(ErrorKind::InvalidOperation, "modulo error", line, col))
      }
      (ValueKind::BigInt(a), ValueKind::Int(b)) =>
      match i128_floor_divmod(a, i128_from_i64(b)) {
        Some((_, r)) => Ok(value_from_i128(r))
        None => Err(self.err(ErrorKind::InvalidOperation, "modulo error", line, col))
      }
      _ =>
      match (lv.as_f64(), rv.as_f64()) {
        (Some(a), Some(b)) => {
          if b == 0.0 {
            return Err(
              self.err(ErrorKind::InvalidOperation, "modulo by zero", line, col),
            )
          }
          let q = a / b
          if q != q || (q - q) != 0.0 || q >= 4503599627370496.0 || q <= -4503599627370496.0 {
            return Ok(Value::from_float(0.0))
          }
          let fl = safe_floor_i64(q).to_double()
          Ok(Value::from_float(a - fl * b))
        }
        _ =>
        Err(
          self.err(
            ErrorKind::InvalidOperation,
            "invalid operands for '%'",
            line,
            col,
          ),
        )
      }
    }
    BinOp::Pow =>
    match (lv.kind, rv.kind) {
      (ValueKind::Int(base), ValueKind::Int(exp)) => {
        if exp < 0L {
          if base == 0L {
            return Err(
              self.err(ErrorKind::InvalidOperation, "0 cannot be raised to a negative power", line, col),
            )
          }
          if exp < -1075L {
            return Ok(Value::from_float(0.0))
          }
          let mut acc = 1.0
          let mut e = 0L - exp
          let mut b = base.to_double()
          while e > 0L {
            if (e & 1L) != 0L {
              acc = acc * b
            }
            b = b * b
            e = e >> 1
          }
          return Ok(Value::from_float(1.0 / acc))
        }
        if exp == 0L {
          return Ok(Value::from_i64(1L))
        }
        if base == 0L {
          return Ok(Value::from_i64(0L))
        }
        if base == 1L {
          return Ok(Value::from_i64(1L))
        }
        if base == -1L {
          return Ok(Value::from_i64(if (exp & 1L) == 0L { 1L } else { -1L }))
        }
        if exp > 127L {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "integer exponent overflow",
              line,
              col,
            ),
          )
        }
        let mut acc = i128_from_i64(1L)
        let mut b = i128_from_i64(base)
        let mut e = exp
        while e > 0L {
          if (e & 1L) != 0L {
            match i128_mul(acc, b) {
              Some(na) => acc = na
              None =>
              return Err(
                self.err(ErrorKind::InvalidOperation, "integer exponent overflow", line, col),
              )
            }
          }
          e = e >> 1
          if e > 0L {
            match i128_mul(b, b) {
              Some(nb) => b = nb
              None =>
              return Err(
                self.err(ErrorKind::InvalidOperation, "integer exponent overflow", line, col),
              )
            }
          }
        }
        Ok(value_from_i128(acc))
      }
      _ =>
      match (lv.as_f64(), rv.as_f64()) {
        (Some(a), Some(b)) => Ok(Value::from_float(eval_float_pow(a, b)))
        _ =>
        Err(
          self.err(
            ErrorKind::InvalidOperation,
            "invalid operands for '**'",
            line,
            col,
          ),
        )
      }
    }
    _ => Ok(Value::undefined())
  }
}

fn EvalState::repeat_string(
  self : EvalState,
  s : String,
  n : Int64,
  is_safe : Bool,
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  if n <= 0L || s.length() == 0 {
    return Ok(if is_safe { Value::safe("") } else { Value::from_string("") })
  }
  let limit = if self.max_output_bytes > 0 {
    self.max_output_bytes.to_int64()
  } else {
    16777216L
  }
  let slen = s.length().to_int64()
  if n > limit / slen + 1L || slen * n > limit {
    return Err(
      self.err(
        ErrorKind::OutputLimitExceeded,
        "string repetition exceeds output size limit",
        line,
        col,
      ),
    )
  }
  let count = n.to_int()
  let sb = StringBuilder::with_capacity(s.length() * count)
  let mut i = 0
  while i < count {
    sb.write_string(s)
    i = i + 1
  }
  Ok(if is_safe { Value::safe(sb.to_string()) } else { Value::from_string(sb.to_string()) })
}

fn EvalState::repeat_seq(
  self : EvalState,
  items : Array[Value],
  n : Int64,
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  if n <= 0L || items.length() == 0 {
    return Ok(Value::from_seq([]))
  }
  let limit = if self.max_output_bytes > 0 {
    let by_bytes = (self.max_output_bytes / 8).to_int64()
    if by_bytes < 100000L { by_bytes } else { 100000L }
  } else {
    100000L
  }
  let ilen = items.length().to_int64()
  if n > limit || ilen * n > limit {
    return Err(
      self.err(
        ErrorKind::OutputLimitExceeded,
        "list repetition exceeds size limit",
        line,
        col,
      ),
    )
  }
  match self.consume_fuel(ilen * n, line, col) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let out : Array[Value] = []
  let count = n.to_int()
  let mut i = 0
  while i < count {
    let mut j = 0
    while j < items.length() {
      out.push(items[j])
      j = j + 1
    }
    i = i + 1
  }
  Ok(Value::from_seq(out))
}

fn EvalState::eval_call(
  self : EvalState,
  callee : Expr,
  pos_args : Array[Value],
  kwargs : Array[(String, Value)],
  caller_opt : Option[(Array[String], Array[Stmt])],
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  match callee {
    Expr::Var(name, _, _) => {
      // Built-in functions
      if name == "range" {
        if pos_args.length() == 1 {
          match pos_args[0].as_i64() {
            Some(stop) => return Ok(Value::from_range(0L, stop, 1L))
            None =>
            return Err(
              self.err(ErrorKind::InvalidOperation, "range expects int", line, col),
            )
          }
        }
        if pos_args.length() == 2 {
          match (pos_args[0].as_i64(), pos_args[1].as_i64()) {
            (Some(a), Some(b)) => return Ok(Value::from_range(a, b, 1L))
            _ =>
            return Err(
              self.err(ErrorKind::InvalidOperation, "range expects ints", line, col),
            )
          }
        }
        if pos_args.length() == 3 {
          match (pos_args[0].as_i64(), pos_args[1].as_i64(), pos_args[2].as_i64()) {
            (Some(a), Some(b), Some(s)) => {
              if s == 0L {
                return Err(
                  self.err(
                    ErrorKind::InvalidOperation,
                    "range step cannot be 0",
                    line,
                    col,
                  ),
                )
              }
              return Ok(Value::from_range(a, b, s))
            }
            _ =>
            return Err(
              self.err(ErrorKind::InvalidOperation, "range expects ints", line, col),
            )
          }
        }
        return Err(
          self.err(
            ErrorKind::InvalidOperation,
            "range expects 1 to 3 arguments",
            line,
            col,
          ),
        )
      }
      if name == "dict" || name == "namespace" {
        let vm = ValueMap::new()
        if pos_args.length() >= 1 {
          match pos_args[0].kind {
            ValueKind::Map(base_m) => {
              let mut bi = 0
              while bi < base_m.keys.length() {
                vm.set(base_m.keys[bi], base_m.vals[bi])
                bi = bi + 1
              }
            }
            _ => ()
          }
        }
        let mut i = 0
        while i < kwargs.length() {
          let (kk, kv) = kwargs[i]
          vm.set(kk, kv)
          i = i + 1
        }
        return Ok(Value::{ kind: ValueKind::Map(vm) })
      }
      if name == "super" {
        if self.active_block_names.length() == 0 {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "super() called outside of a block",
              line,
              col,
            ),
          )
        }
        let top = self.active_block_names.length() - 1
        let bname = self.active_block_names[top]
        let bidx = self.active_block_idxs[top]
        match self.find_block_chain(bname) {
          Some(chain) => {
            if bidx + 1 >= chain.length() {
              return Err(
                self.err(
                  ErrorKind::InvalidOperation,
                  "no parent block for super()",
                  line,
                  col,
                ),
              )
            }
            let parent_body = chain[bidx + 1]
            self.active_block_names.push(bname)
            self.active_block_idxs.push(bidx + 1)
            let saved_out = self.out
            let saved_bytes = self.out_bytes
            self.out = StringBuilder::new()
            let res = self.exec_stmts(parent_body)
            let captured = self.out.to_string()
            self.out = saved_out
            self.out_bytes = saved_bytes
            let _ = self.active_block_names.pop()
            let _ = self.active_block_idxs.pop()
            match res {
              Ok(()) => return Ok(Value::safe(captured))
              Err(e) => return Err(e)
            }
          }
          None =>
          return Err(
            self.err(ErrorKind::UnknownBlock, "unknown block", line, col),
          )
        }
      }
      if name == "caller" {
        if self.caller_stack.length() == 0 {
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "caller() called outside of {% call %}",
              line,
              col,
            ),
          )
        }
        match self.caller_stack[self.caller_stack.length() - 1] {
          Some((cparams, cbody)) => {
            self.push_scope()
            let mut ci = 0
            while ci < cparams.length() {
              let v = if ci < pos_args.length() {
                pos_args[ci]
              } else {
                Value::undefined()
              }
              self.set_local(cparams[ci], v)
              ci = ci + 1
            }
            let saved_out = self.out
            let saved_bytes = self.out_bytes
            self.out = StringBuilder::new()
            let res = self.exec_stmts(cbody)
            let captured = self.out.to_string()
            self.out = saved_out
            self.out_bytes = saved_bytes
            self.pop_scope()
            match res {
              Ok(()) =>
              return match self.auto_escape {
                AutoEscape::Html => Ok(Value::safe(captured))
                _ => Ok(Value::from_string(captured))
              }
              Err(e) => return Err(e)
            }
          }
          None =>
          return Err(
            self.err(
              ErrorKind::InvalidOperation,
              "macro was not invoked via {% call %}",
              line,
              col,
            ),
          )
        }
      }
      // Local macro
      match self.find_macro(name) {
        Some(md) =>
        return self.invoke_macro(md, pos_args, kwargs, caller_opt, line, col)
        None => ()
      }
      // Custom environment function
      if self.env.fn_names.length() > 0 {
        let mut fi = 0
        while fi < self.env.fn_names.length() {
          if self.env.fn_names[fi] == name {
            return self.env.fn_fns[fi](pos_args)
          }
          fi = fi + 1
        }
      }
      Err(
        self.err(
          ErrorKind::UnknownFunction,
          "unknown function or macro '" + name + "'",
          line,
          col,
        ),
      )
    }
    Expr::GetAttr(obj_e, method_name, _, _) => {
      // Check `loop.cycle(...)`
      match obj_e {
        Expr::Var(vname, _, _) => {
          if vname == "loop" && method_name == "cycle" && self.loop_stack.length() > 0 {
            if pos_args.length() == 0 {
              return Ok(Value::undefined())
            }
            let lf = self.loop_stack[self.loop_stack.length() - 1]
            return Ok(pos_args[lf.index0 % pos_args.length()])
          }
          // Check imported module macro call `m.foo(...)`
          match self.find_module_macro(vname, method_name) {
            Some(md) =>
            return self.invoke_macro(md, pos_args, kwargs, caller_opt, line, col)
            None => ()
          }
        }
        _ => ()
      }
      Err(
        self.err(
          ErrorKind::InvalidOperation,
          "method '" + method_name + "' is not callable",
          line,
          col,
        ),
      )
    }
    _ =>
    Err(
      self.err(
        ErrorKind::InvalidOperation,
        "expression is not callable",
        line,
        col,
      ),
    )
  }
}

///| Try to evaluate an expression to an unboxed `Int64` without allocating `Value` / `Result`.
///| Returns `None` if the expression is not a simple safe integer expression.
fn EvalState::try_eval_i64(self : EvalState, expr : Expr) -> Option[Int64] {
  match expr {
    Expr::Const(v, _, _) =>
    match v.kind {
      ValueKind::Int(n) => Some(n)
      _ => None
    }
    Expr::Var(name, _, _) => {
      if self.range_var_mark >= 0 &&
      self.scope_keys.length() == self.range_var_mark &&
      self.range_var_name == name {
        return Some(self.range_var_val)
      }
      match self.lookup_var(name).kind {
        ValueKind::Int(n) => Some(n)
        _ => None
      }
    }
    Expr::Bin(op, lhs_e, rhs_e, _, _) =>
    match op {
      BinOp::Rem => {
        match (lhs_e, rhs_e) {
          (Expr::Var(vname, _, _), Expr::Const(cv, _, _)) =>
          match cv.kind {
            ValueKind::Int(b) =>
            if b > 0L && self.range_var_mark >= 0 &&
            self.scope_keys.length() == self.range_var_mark &&
            self.range_var_name == vname && self.range_var_val >= 0L {
              return Some(self.range_var_val % b)
            }
            _ => ()
          }
          _ => ()
        }
        match self.try_eval_i64(lhs_e) {
          Some(a) =>
          match self.try_eval_i64(rhs_e) {
            Some(b) =>
            if b > 0L && a >= 0L {
              Some(a % b)
            } else {
              None
            }
            None => None
          }
          None => None
        }
      }
      BinOp::Add =>
      match self.try_eval_i64(lhs_e) {
        Some(a) =>
        match self.try_eval_i64(rhs_e) {
          Some(b) =>
          if a >= -4611686018427387904L && a <= 4611686018427387903L &&
          b >= -4611686018427387904L && b <= 4611686018427387903L {
            Some(a + b)
          } else {
            None
          }
          None => None
        }
        None => None
      }
      BinOp::Sub =>
      match self.try_eval_i64(lhs_e) {
        Some(a) =>
        match self.try_eval_i64(rhs_e) {
          Some(b) =>
          if a >= -4611686018427387904L && a <= 4611686018427387903L &&
          b >= -4611686018427387904L && b <= 4611686018427387903L {
            Some(a - b)
          } else {
            None
          }
          None => None
        }
        None => None
      }
      _ => None
    }
    _ => None
  }
}

///| Fast evaluation for simple expressions (`Var`, `Const`, `GetAttr(Var, attr)`).
fn EvalState::eval_simple_expr(
  self : EvalState,
  e : Expr,
) -> Result[Value, TemplateError] {
  match e {
    Expr::Var(name, _, _) => Ok(self.lookup_var(name))
    Expr::Const(v, _, _) => Ok(v)
    Expr::GetAttr(Expr::Var(vname, _, _), attr, gline, gcol) => {
      if self.loop_stack.length() > 0 && vname.length() == 4 && vname.code_unit_at(0) == 108 && vname == "loop" {
        return self.eval_expr(e)
      }
      let obj = self.lookup_var(vname)
      if obj.is_undefined() {
        match self.env.undefined_behavior {
          UndefinedBehavior::Strict =>
          return Err(
            self.err(
              ErrorKind::UndefinedError,
              "cannot access attribute '" + attr + "' on undefined",
              gline,
              gcol,
            ),
          )
          UndefinedBehavior::Lenient => return Ok(Value::undefined())
        }
      }
      Ok(obj.get_attr(attr))
    }
    _ => self.eval_expr(e)
  }
}

fn EvalState::emit_expr_fast(
  self : EvalState,
  e : Expr,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  match e {
    Expr::Var(name, _, _) => {
      if self.range_var_mark >= 0 &&
      self.scope_keys.length() == self.range_var_mark &&
      self.range_var_name == name {
        return self.write_i64_direct(self.range_var_val, line, col)
      }
      self.write_value_escaped(self.lookup_var(name), line, col)
    }
    Expr::Const(v, _, _) => self.write_value_escaped(v, line, col)
    Expr::GetAttr(obj_e, attr, gline, gcol) =>
    match obj_e {
      Expr::Var(vname, _, _) => {
        if self.loop_stack.length() > 0 && vname.length() == 4 && vname.code_unit_at(0) == 108 && vname == "loop" {
          let lf = self.loop_stack[self.loop_stack.length() - 1]
          if attr == "index" {
            return self.write_i64_direct((lf.index0 + 1).to_int64(), line, col)
          }
          if attr == "index0" {
            return self.write_i64_direct(lf.index0.to_int64(), line, col)
          }
          if attr == "revindex" {
            return self.write_i64_direct((lf.length - lf.index0).to_int64(), line, col)
          }
          if attr == "revindex0" {
            return self.write_i64_direct((lf.length - lf.index0 - 1).to_int64(), line, col)
          }
          if attr == "length" {
            return self.write_i64_direct(lf.length.to_int64(), line, col)
          }
          if attr == "first" {
            return self.write_raw(if lf.index0 == 0 { "True" } else { "False" }, line, col)
          }
          if attr == "last" {
            return self.write_raw(if lf.index0 + 1 == lf.length { "True" } else { "False" }, line, col)
          }
        }
        let obj = self.lookup_var(vname)
        if obj.is_undefined() {
          match self.env.undefined_behavior {
            UndefinedBehavior::Strict =>
            return Err(
              self.err(
                ErrorKind::UndefinedError,
                "cannot access attribute '" + attr + "' on undefined",
                gline,
                gcol,
              ),
            )
            UndefinedBehavior::Lenient => return Ok(())
          }
        }
        self.write_value_escaped(obj.get_attr(attr), line, col)
      }
      Expr::GetItem(Expr::Var(arr_name, _, _), idx_e, iline, icol) => {
        let arr_v = self.lookup_var(arr_name)
        if arr_v.is_undefined() {
          match self.env.undefined_behavior {
            UndefinedBehavior::Strict =>
            return Err(
              self.err(
                ErrorKind::UndefinedError,
                "cannot subscript undefined",
                iline,
                icol,
              ),
            )
            UndefinedBehavior::Lenient => return Ok(())
          }
        }
        let elem = match self.try_eval_i64(idx_e) {
          Some(n) => arr_v.get_index(n.to_int())
          None => {
            let idx = match self.eval_expr(idx_e) {
              Ok(v) => v
              Err(er) => return Err(er)
            }
            match idx.as_i64() {
              Some(n) => arr_v.get_index(n.to_int())
              None => arr_v.get_attr(idx.to_display_string())
            }
          }
        }
        if elem.is_undefined() {
          match self.env.undefined_behavior {
            UndefinedBehavior::Strict =>
            return Err(
              self.err(
                ErrorKind::UndefinedError,
                "cannot access attribute '" + attr + "' on undefined",
                gline,
                gcol,
              ),
            )
            UndefinedBehavior::Lenient => return Ok(())
          }
        }
        self.write_value_escaped(elem.get_attr(attr), line, col)
      }
      _ => {
        let v = match self.eval_expr(e) {
          Ok(item_val) => item_val
          Err(er) => return Err(er)
        }
        self.write_value_escaped(v, line, col)
      }
    }
    Expr::Filter(inner, fname, args, _, _) => {
      if self.env.filter_names.length() == 0 {
        let nargs = args.length()
        if nargs == 0 {
          if fname == "upper" || fname == "lower" {
            let iv = match self.eval_simple_expr(inner) {
              Ok(val_in) => val_in
              Err(er) => return Err(er)
            }
            match self.auto_escape {
              AutoEscape::Html =>
              match iv.kind {
                ValueKind::String(s) => {
                  let slen = s.length()
                  if self.max_output_bytes <= 0 ||
                  (slen <= self.max_output_bytes / 6 &&
                    self.out_bytes + slen * 6 <= self.max_output_bytes) {
                    let w = if fname == "upper" {
                      try_write_upper_html_ascii(self.out, s)
                    } else {
                      try_write_lower_html_ascii(self.out, s)
                    }
                    if w >= 0 {
                      self.out_bytes = self.out_bytes + w
                      return Ok(())
                    }
                  }
                }
                _ => ()
              }
              _ => ()
            }
            let out_v = if fname == "upper" {
              preserve_safe_str(iv, utf8_to_upper(iv.to_display_string()))
            } else {
              preserve_safe_str(iv, utf8_to_lower(iv.to_display_string()))
            }
            return self.write_value_escaped(out_v, line, col)
          }
          if fname == "length" || fname == "count" {
            let iv = match self.eval_simple_expr(inner) {
              Ok(val_in) => val_in
              Err(er) => return Err(er)
            }
            let n = match iv.kind {
              ValueKind::String(s) => utf8_codepoint_count(s).to_int64()
              ValueKind::SafeString(s) => utf8_codepoint_count(s).to_int64()
              ValueKind::Seq(a) => a.length().to_int64()
              ValueKind::Map(m) => m.length().to_int64()
              ValueKind::Range(a, b, s) => range_len(a, b, s)
              _ => 0L
            }
            return self.write_i64_direct(n, line, col)
          }
        } else if nargs == 1 && args[0].name.is_none() && (fname == "default" || fname == "d") {
          let iv = match self.eval_simple_expr(inner) {
            Ok(val_in) => val_in
            Err(er) => return Err(er)
          }
          if iv.is_undefined() {
            return self.emit_expr_fast(args[0].expr, line, col)
          }
          return self.write_value_escaped(iv, line, col)
        }
      }
      let v = match self.eval_expr(e) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      self.write_value_escaped(v, line, col)
    }
    Expr::Call(callee, args, cline, ccol) => {
      // Zero-allocation fast path for `{{ loop.cycle(...) }}`
      match callee {
        Expr::GetAttr(Expr::Var(vname, _, _), mname, _, _) =>
        if self.loop_stack.length() > 0 && mname == "cycle" && vname == "loop" {
          let nargs = args.length()
          if nargs == 0 {
            return Ok(())
          }
          let lf = self.loop_stack[self.loop_stack.length() - 1]
          return self.emit_expr_fast(args[lf.index0 % nargs].expr, line, col)
        }
        _ => ()
      }
      // Zero-allocation fast path for `{{ super() }}` (streams parent block directly to `self.out`)
      if args.length() == 0 {
        match callee {
          Expr::Var(vname, _, _) =>
          if vname == "super" {
            let is_json = match self.auto_escape {
              AutoEscape::Json => true
              _ => false
            }
            if !is_json {
              if self.active_block_names.length() == 0 {
                return Err(
                  self.err(
                    ErrorKind::InvalidOperation,
                    "super() called outside of a block",
                    cline,
                    ccol,
                  ),
                )
              }
              let top = self.active_block_names.length() - 1
              let bname = self.active_block_names[top]
              let bidx = self.active_block_idxs[top]
              match self.find_block_chain(bname) {
                Some(chain) => {
                  if bidx + 1 >= chain.length() {
                    return Err(
                      self.err(
                        ErrorKind::InvalidOperation,
                        "no parent block for super()",
                        cline,
                        ccol,
                      ),
                    )
                  }
                  let parent_body = chain[bidx + 1]
                  self.active_block_names.push(bname)
                  self.active_block_idxs.push(bidx + 1)
                  let res = self.exec_stmts(parent_body)
                  let _ = self.active_block_names.pop()
                  let _ = self.active_block_idxs.pop()
                  return res
                }
                None =>
                return Err(
                  self.err(ErrorKind::UnknownBlock, "unknown block", cline, ccol),
                )
              }
            }
          }
          _ => ()
        }
      }
      let v = match self.eval_expr(e) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      self.write_value_escaped(v, line, col)
    }
    _ => {
      let v = match self.eval_expr(e) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      self.write_value_escaped(v, line, col)
    }
  }
}

fn EvalState::exec_stmts(
  self : EvalState,
  stmts : Array[Stmt],
) -> Result[Unit, TemplateError] {
  let n = stmts.length()
  let mut i = 0
  while i < n {
    let stmt = stmts[i]
    match stmt {
      Stmt::EmitRaw(s) =>
      if !self.suppress_output {
        let slen = s.length()
        if self.max_output_bytes > 0 &&
        (slen > self.max_output_bytes || self.out_bytes + slen > self.max_output_bytes) {
          return Err(
            self.err(
              ErrorKind::OutputLimitExceeded,
              "template output size limit exceeded",
              0,
              0,
            ),
          )
        }
        self.out_bytes = self.out_bytes + slen
        self.out.write_string(s)
      }
      Stmt::EmitExpr(e, line, col) =>
      if !self.suppress_output {
        if self.has_fuel {
          self.fuel_left = self.fuel_left - 1L
          if self.fuel_left < 0L {
            return Err(
              self.err(
                ErrorKind::FuelExhausted,
                "template execution fuel exhausted",
                line,
                col,
              ),
            )
          }
        }
        match self.emit_expr_fast(e, line, col) {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      _ =>
      match self.exec_stmt(stmt) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }
  Ok(())
}

fn EvalState::exec_stmt(
  self : EvalState,
  stmt : Stmt,
) -> Result[Unit, TemplateError] {
  match stmt {
    Stmt::EmitRaw(s) =>
    if self.suppress_output { Ok(()) } else { self.write_raw(s, 0, 0) }
    Stmt::EmitExpr(e, line, col) => {
      if self.suppress_output {
        return Ok(())
      }
      match self.consume_fuel(1L, line, col) {
        Ok(()) => ()
        Err(er) => return Err(er)
      }
      let v = match self.eval_expr(e) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      self.write_value_escaped(v, line, col)
    }
    Stmt::If(branches, else_body, line, col) => {
      match self.consume_fuel(1L, line, col) {
        Ok(()) => ()
        Err(er) => return Err(er)
      }
      let mut bi = 0
      while bi < branches.length() {
        let (cond, body) = branches[bi]
        let cv = match self.eval_expr(cond) {
          Ok(v) => v
          Err(er) => return Err(er)
        }
        let truthy = match self.check_truthy(cv, line, col) {
          Ok(b) => b
          Err(er) => return Err(er)
        }
        if truthy {
          return self.exec_stmts(body)
        }
        bi = bi + 1
      }
      self.exec_stmts(else_body)
    }
    Stmt::For(targets, iter_expr, filter_opt, body, else_body, line, col) => {
      match self.consume_fuel(1L, line, col) {
        Ok(()) => ()
        Err(er) => return Err(er)
      }
      let iter_v = match self.eval_expr(iter_expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      if iter_v.is_undefined() {
        match self.env.undefined_behavior {
          UndefinedBehavior::Strict =>
          return Err(
            self.err(
              ErrorKind::UndefinedError,
              "cannot iterate over undefined in strict mode",
              line,
              col,
            ),
          )
          UndefinedBehavior::Lenient => return self.exec_stmts(else_body)
        }
      }
      // Lazy fast-path for `Range` (avoids OOM on `range(100000000)` and respects fuel!)
      match iter_v.kind {
        ValueKind::Range(start, stop, step) => {
          if targets.length() != 1 {
            return Err(
              self.err(
                ErrorKind::InvalidOperation,
                "cannot unpack int in for loop",
                line,
                col,
              ),
            )
          }
          let total = range_len(start, stop, step)
          if total == 0L {
            return self.exec_stmts(else_body)
          }
          let depth = 1
          let tname = targets[0]
          let mark = self.scope_keys.length()
          self.scope_marks.push(mark)
          let lf = LoopFrame::{
            index0: 0,
            length: total.to_int(),
            depth: depth,
            is_range: true,
            r_start: start,
            r_step: step,
            items: [],
          }
          let mut ran_any = false
          match filter_opt {
            None => {
              ran_any = true
              // If an outer range loop was using the unboxed slot, materialize it into scope_keys
              let prev_rname = self.range_var_name
              let prev_rval = self.range_var_val
              let prev_rmark = self.range_var_mark
              let mut pushed_outer = false
              if prev_rmark >= 0 {
                self.scope_keys.push(prev_rname)
                self.scope_vals.push(Value::from_i64(prev_rval))
                pushed_outer = true
              }
              let inner_mark = self.scope_keys.length()
              self.range_var_name = tname
              self.range_var_val = start
              self.range_var_mark = inner_mark
              self.loop_stack.push(lf)
              let mut idx = 0L
              let mut cur_val = start
              while idx < total {
                if self.has_fuel {
                  self.fuel_left = self.fuel_left - 1L
                  if self.fuel_left < 0L {
                    self.range_var_name = prev_rname
                    self.range_var_val = prev_rval
                    self.range_var_mark = prev_rmark
                    let _ = self.loop_stack.pop()
                    self.pop_scope()
                    return Err(
                      self.err(
                        ErrorKind::FuelExhausted,
                        "template execution fuel exhausted",
                        line,
                        col,
                      ),
                    )
                  }
                }
                while self.scope_keys.length() > inner_mark {
                  let _ = self.scope_keys.pop()
                  let _ = self.scope_vals.pop()
                }
                self.range_var_val = cur_val
                lf.index0 = idx.to_int()
                match self.exec_stmts(body) {
                  Ok(()) => ()
                  Err(er) => {
                    self.range_var_name = prev_rname
                    self.range_var_val = prev_rval
                    self.range_var_mark = prev_rmark
                    let _ = self.loop_stack.pop()
                    self.pop_scope()
                    return Err(er)
                  }
                }
                cur_val = cur_val + step
                idx = idx + 1L
              }
              let _ = pushed_outer
              self.range_var_name = prev_rname
              self.range_var_val = prev_rval
              self.range_var_mark = prev_rmark
              let _ = self.loop_stack.pop()
              self.pop_scope()
            }
            Some(fe) => {
              self.scope_keys.push(tname)
              self.scope_vals.push(Value::undefined())
              let mut idx = 0L
              let mut cur_val = start
              while idx < total {
                match self.consume_fuel(1L, line, col) {
                  Ok(()) => ()
                  Err(er) => {
                    self.pop_scope()
                    return Err(er)
                  }
                }
                while self.scope_keys.length() > mark + 1 {
                  let _ = self.scope_keys.pop()
                  let _ = self.scope_vals.pop()
                }
                self.scope_vals[mark] = Value::from_i64(cur_val)
                let fv = match self.eval_expr(fe) {
                  Ok(v) => v
                  Err(er) => {
                    self.pop_scope()
                    return Err(er)
                  }
                }
                let keep = match self.check_truthy(fv, line, col) {
                  Ok(b) => b
                  Err(er) => {
                    self.pop_scope()
                    return Err(er)
                  }
                }
                if keep {
                  ran_any = true
                  lf.index0 = idx.to_int()
                  self.loop_stack.push(lf)
                  let res = self.exec_stmts(body)
                  let _ = self.loop_stack.pop()
                  match res {
                    Ok(()) => ()
                    Err(er) => {
                      self.pop_scope()
                      return Err(er)
                    }
                  }
                }
                cur_val = cur_val + step
                idx = idx + 1L
              }
              self.pop_scope()
            }
          }
          if !ran_any {
            return self.exec_stmts(else_body)
          }
          return Ok(())
        }
        _ => ()
      }

      let raw_items = match iter_v.kind {
        ValueKind::Seq(arr) => arr
        _ =>
        match value_to_items(iter_v, 100000) {
          Ok(it) => it
          Err(er) => return Err(er)
        }
      }
      // Apply optional `if` filter before computing `loop.length` / `loop.last`
      let items : Array[Value] = match filter_opt {
        None => raw_items
        Some(fe) => {
          let filtered : Array[Value] = []
          let mut ri = 0
          while ri < raw_items.length() {
            match self.consume_fuel(1L, line, col) {
              Ok(()) => ()
              Err(er) => return Err(er)
            }
            self.push_scope()
            match self.bind_for_targets(targets, raw_items[ri], line, col) {
              Ok(()) => ()
              Err(er) => {
                self.pop_scope()
                return Err(er)
              }
            }
            let fv = match self.eval_expr(fe) {
              Ok(v) => v
              Err(er) => {
                self.pop_scope()
                return Err(er)
              }
            }
            let keep = match self.check_truthy(fv, line, col) {
              Ok(b) => b
              Err(er) => {
                self.pop_scope()
                return Err(er)
              }
            }
            self.pop_scope()
            if keep {
              filtered.push(raw_items[ri])
            }
            ri = ri + 1
          }
          filtered
        }
      }
      if items.length() == 0 {
        return self.exec_stmts(else_body)
      }
      let depth = 1
      let len = items.length()
      let lf = LoopFrame::{
        index0: 0,
        length: len,
        depth: depth,
        is_range: false,
        r_start: 0L,
        r_step: 1L,
        items: items,
      }
      let mark = self.scope_keys.length()
      self.scope_marks.push(mark)
      self.loop_stack.push(lf)
      if targets.length() == 1 {
        self.scope_keys.push(targets[0])
        self.scope_vals.push(Value::undefined())
        let mut idx = 0
        while idx < len {
          if self.has_fuel {
            self.fuel_left = self.fuel_left - 1L
            if self.fuel_left < 0L {
              let _ = self.loop_stack.pop()
              self.pop_scope()
              return Err(
                self.err(
                  ErrorKind::FuelExhausted,
                  "template execution fuel exhausted",
                  line,
                  col,
                ),
              )
            }
          }
          while self.scope_keys.length() > mark + 1 {
            let _ = self.scope_keys.pop()
            let _ = self.scope_vals.pop()
          }
          self.scope_vals[mark] = items[idx]
          lf.index0 = idx
          match self.exec_stmts(body) {
            Ok(()) => ()
            Err(er) => {
              let _ = self.loop_stack.pop()
              self.pop_scope()
              return Err(er)
            }
          }
          idx = idx + 1
        }
      } else {
        let mut idx = 0
        while idx < len {
          match self.consume_fuel(1L, line, col) {
            Ok(()) => ()
            Err(er) => {
              let _ = self.loop_stack.pop()
              self.pop_scope()
              return Err(er)
            }
          }
          while self.scope_keys.length() > mark {
            let _ = self.scope_keys.pop()
            let _ = self.scope_vals.pop()
          }
          match self.bind_for_targets(targets, items[idx], line, col) {
            Ok(()) => ()
            Err(er) => {
              let _ = self.loop_stack.pop()
              self.pop_scope()
              return Err(er)
            }
          }
          lf.index0 = idx
          match self.exec_stmts(body) {
            Ok(()) => ()
            Err(er) => {
              let _ = self.loop_stack.pop()
              self.pop_scope()
              return Err(er)
            }
          }
          idx = idx + 1
        }
      }
      let _ = self.loop_stack.pop()
      self.pop_scope()
      Ok(())
    }
    Stmt::Set(target, val_expr, line, col) => {
      let v = match self.eval_expr(val_expr) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      match target {
        SetTarget::Var(name) => self.set_local(name, v)
        SetTarget::Tuple(names) =>
        match self.bind_for_targets(names, v, line, col) {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
        SetTarget::Attr(obj_name, attr) => {
          let obj = self.lookup_var(obj_name)
          match obj.kind {
            ValueKind::Map(m) => m.set(attr, v)
            _ =>
            return Err(
              self.err(
                ErrorKind::InvalidOperation,
                "cannot set attribute on non-namespace/map",
                line,
                col,
              ),
            )
          }
        }
      }
      Ok(())
    }
    Stmt::SetBlock(name, filter_opt, body, line, col) => {
      let saved_out = self.out
      let saved_bytes = self.out_bytes
      let saved_suppress = self.suppress_output
      self.suppress_output = false
      self.out = StringBuilder::new()
      let res = self.exec_stmts(body)
      let captured = self.out.to_string()
      self.out = saved_out
      self.out_bytes = saved_bytes
      self.suppress_output = saved_suppress
      match res {
        Ok(()) => ()
        Err(er) => return Err(er)
      }
      let mut item_val = match self.auto_escape {
        AutoEscape::Html => Value::safe(captured)
        _ => Value::from_string(captured)
      }
      match filter_opt {
        Some((fname, fargs)) => {
          let (pos, kw) = match self.eval_call_args(fargs) {
            Ok(p) => p
            Err(er) => return Err(er)
          }
          item_val = match eval_filter(
            self,
            fname,
            item_val,
            pos,
            kw,
            self.template_name,
            line,
            col,
          ) {
            Ok(fv) => fv
            Err(er) => return Err(er)
          }
        }
        None => ()
      }
      self.set_local(name, item_val)
      Ok(())
    }
    Stmt::With(bindings, body, _, _) => {
      let evaled : Array[(String, Value)] = []
      let mut i = 0
      while i < bindings.length() {
        let (k, expr) = bindings[i]
        let v = match self.eval_expr(expr) {
          Ok(item_val) => item_val
          Err(er) => return Err(er)
        }
        evaled.push((k, v))
        i = i + 1
      }
      self.push_scope()
      i = 0
      while i < evaled.length() {
        let (k, v) = evaled[i]
        self.set_local(k, v)
        i = i + 1
      }
      let res = self.exec_stmts(body)
      self.pop_scope()
      res
    }
    Stmt::FilterBlock(fname, fargs, body, line, col) => {
      if self.suppress_output {
        return Ok(())
      }
      let saved_out = self.out
      let saved_bytes = self.out_bytes
      self.out = StringBuilder::new()
      let res = self.exec_stmts(body)
      let captured = self.out.to_string()
      self.out = saved_out
      self.out_bytes = saved_bytes
      match res {
        Ok(()) => ()
        Err(er) => return Err(er)
      }
      let (pos, kw) = match self.eval_call_args(fargs) {
        Ok(p) => p
        Err(er) => return Err(er)
      }
      // Body rendered inside {% filter %} already underwent auto-escaping (P1-5)
      let cap_val = match self.auto_escape {
        AutoEscape::Html => Value::safe(captured)
        _ => Value::from_string(captured)
      }
      let fv = match eval_filter(
        self,
        fname,
        cap_val,
        pos,
        kw,
        self.template_name,
        line,
        col,
      ) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      self.write_value_escaped(fv, line, col)
    }
    Stmt::Block(bname, body, _, _) => {
      if self.suppress_output {
        return Ok(())
      }
      match self.find_block_chain(bname) {
        Some(chain) => {
          if chain.length() > 0 {
            let top_body = chain[0]
            self.active_block_names.push(bname)
            self.active_block_idxs.push(0)
            let res = self.exec_stmts(top_body)
            let _ = self.active_block_names.pop()
            let _ = self.active_block_idxs.pop()
            return res
          }
          self.exec_stmts(body)
        }
        None => self.exec_stmts(body)
      }
    }
    Stmt::Extends(expr, line, col) => {
      let pv = match self.eval_expr(expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      self.pending_extends = Some((pv.to_display_string(), line, col))
      Ok(())
    }
    Stmt::Include(tpl_expr, ignore_missing, line, col) => {
      if self.suppress_output {
        return Ok(())
      }
      let name_v = match self.eval_expr(tpl_expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      // Support both single template name and list of fallback names
      let candidates : Array[String] = match name_v.kind {
        ValueKind::Seq(arr) => {
          let cs : Array[String] = []
          let mut ci = 0
          while ci < arr.length() {
            cs.push(arr[ci].to_display_string())
            ci = ci + 1
          }
          cs
        }
        _ => [name_v.to_display_string()]
      }
      let mut found_pair : Option[(String, CompiledTemplate)] = None
      let mut ci = 0
      while ci < candidates.length() {
        let cname = candidates[ci]
        match self.env.find_compiled(cname) {
          Some(ct) => {
            found_pair = Some((cname, ct))
            break
          }
          None => ()
        }
        ci = ci + 1
      }
      match found_pair {
        None =>
        if ignore_missing {
          Ok(())
        } else {
          Err(
            self.err(
              ErrorKind::TemplateNotFound,
              "included template not found: '" + name_v.to_display_string() + "'",
              line,
              col,
            ),
          )
        }
        Some((inc_name, ct)) => {
          // Cycle check
          let mut si = 0
          while si < self.include_stack.length() {
            if self.include_stack[si] == inc_name {
              return Err(
                self.err(
                  ErrorKind::RecursionLimit,
                  "include cycle detected: '" + inc_name + "'",
                  line,
                  col,
                ),
              )
            }
            si = si + 1
          }
          match self.enter_depth(line, col) {
            Ok(()) => ()
            Err(er) => return Err(er)
          }
          self.include_stack.push(inc_name)
          let prev_name = self.template_name
          self.template_name = Some(inc_name)
          let res = self.exec_stmts(ct.body)
          self.template_name = prev_name
          let _ = self.include_stack.pop()
          self.leave_depth()
          res
        }
      }
    }
    Stmt::Macro(md) => {
      self.macro_names.push(md.name)
      self.macro_defs.push(md)
      Ok(())
    }
    Stmt::CallBlock(callee, args, caller_params, body, line, col) => {
      if self.suppress_output {
        return Ok(())
      }
      let (pos, kw) = match self.eval_call_args(args) {
        Ok(p) => p
        Err(er) => return Err(er)
      }
      let v = match self.eval_call(
        callee,
        pos,
        kw,
        Some((caller_params, body)),
        line,
        col,
      ) {
        Ok(item_val) => item_val
        Err(er) => return Err(er)
      }
      self.write_value_escaped(v, line, col)
    }
    Stmt::Import(tpl_expr, alias, line, col) => {
      let name_v = match self.eval_expr(tpl_expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      let mod_tpl_name = name_v.to_display_string()
      match self.eval_imported_module(mod_tpl_name, line, col) {
        Ok((exports, defs)) => {
          self.module_names.push(alias)
          self.module_defs.push(defs)
          self.set_local(alias, Value::from_map(exports))
          Ok(())
        }
        Err(er) => Err(er)
      }
    }
    Stmt::FromImport(tpl_expr, names, line, col) => {
      let name_v = match self.eval_expr(tpl_expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      let mod_tpl_name = name_v.to_display_string()
      let (exports, defs) = match self.eval_imported_module(mod_tpl_name, line, col) {
        Ok(pair) => pair
        Err(er) => return Err(er)
      }
      let mut ni = 0
      while ni < names.length() {
        let (orig, alias) = names[ni]
        let mut found = false
        let mut di = 0
        while di < defs.length() {
          if defs[di].name == orig {
            self.macro_names.push(alias)
            self.macro_defs.push(defs[di])
            found = true
            break
          }
          di = di + 1
        }
        if !found {
          let mut ei = 0
          while ei < exports.length() {
            let (ek, ev) = exports[ei]
            if ek == orig {
              self.set_local(alias, ev)
              found = true
              break
            }
            ei = ei + 1
          }
        }
        if !found {
          return Err(
            self.err(
              ErrorKind::UndefinedError,
              "symbol '" + orig + "' not found in '" + mod_tpl_name + "'",
              line,
              col,
            ),
          )
        }
        ni = ni + 1
      }
      Ok(())
    }
    Stmt::AutoEscapeBlock(flag_expr, body, line, col) => {
      let fv = match self.eval_expr(flag_expr) {
        Ok(v) => v
        Err(er) => return Err(er)
      }
      let prev = self.auto_escape
      self.auto_escape = match fv.kind {
        ValueKind::Bool(b) => if b { AutoEscape::Html } else { AutoEscape::None }
        ValueKind::String(s) =>
        if s == "html" || s == "xml" {
          AutoEscape::Html
        } else if s == "json" {
          AutoEscape::Json
        } else {
          AutoEscape::None
        }
        _ =>
        match self.check_truthy(fv, line, col) {
          Ok(b) => if b { AutoEscape::Html } else { AutoEscape::None }
          Err(er) => return Err(er)
        }
      }
      let res = self.exec_stmts(body)
      self.auto_escape = prev
      res
    }
    Stmt::Do(e, _, _) => {
      match self.eval_expr(e) {
        Ok(_) => Ok(())
        Err(er) => Err(er)
      }
    }
  }
}

///| Execute an imported template in an isolated module scope to collect both
///| exported variables (`{% set %}`) and macros, with cycle detection (P1-8).
fn EvalState::eval_imported_module(
  self : EvalState,
  mod_tpl_name : String,
  line : Int,
  col : Int,
) -> Result[(Array[(String, Value)], Array[MacroDef]), TemplateError] {
  // Cycle check via include_stack
  let mut si = 0
  while si < self.include_stack.length() {
    if self.include_stack[si] == mod_tpl_name {
      return Err(
        self.err(
          ErrorKind::BadInclude,
          "import cycle detected: '" + mod_tpl_name + "'",
          line,
          col,
        ),
      )
    }
    si = si + 1
  }
  let ct = match self.env.find_compiled(mod_tpl_name) {
    Some(c) => c
    None =>
    return Err(
      self.err(
        ErrorKind::TemplateNotFound,
        "imported template not found: '" + mod_tpl_name + "'",
        line,
        col,
      ),
    )
  }
  match self.enter_depth(line, col) {
    Ok(()) => ()
    Err(er) => return Err(er)
  }
  let sub = EvalState::new(
    self.env,
    Some(mod_tpl_name),
    self.auto_escape,
    StringBuilder::new(),
    self.root_ctx,
  )
  sub.depth = self.depth
  sub.has_fuel = self.has_fuel
  sub.fuel_left = self.fuel_left
  let mut ii = 0
  while ii < self.include_stack.length() {
    sub.include_stack.push(self.include_stack[ii])
    ii = ii + 1
  }
  sub.include_stack.push(mod_tpl_name)
  // Expose root scope locals in scope 0 and capture module-defined vars in scope 1
  sub.push_scope()
  let root_end = if self.scope_marks.length() > 1 {
    self.scope_marks[1]
  } else {
    self.scope_keys.length()
  }
  let mut ri = 0
  while ri < root_end {
    sub.set_local(self.scope_keys[ri], self.scope_vals[ri])
    ri = ri + 1
  }
  sub.push_scope()
  let mod_mark = sub.scope_keys.length()
  let res = sub.exec_stmts(ct.body)
  self.fuel_left = sub.fuel_left
  self.leave_depth()
  match res {
    Ok(()) => {
      let exports : Array[(String, Value)] = []
      let mut ei = mod_mark
      while ei < sub.scope_keys.length() {
        exports.push((sub.scope_keys[ei], sub.scope_vals[ei]))
        ei = ei + 1
      }
      Ok((exports, sub.macro_defs))
    }
    Err(er) => Err(er)
  }
}

fn EvalState::bind_for_targets(
  self : EvalState,
  targets : Array[String],
  item : Value,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  if targets.length() == 1 {
    self.set_local(targets[0], item)
    return Ok(())
  }
  match item.kind {
    ValueKind::Seq(elems) => {
      if elems.length() != targets.length() {
        return Err(
          self.err(
            ErrorKind::InvalidOperation,
            "cannot unpack sequence of length " +
            elems.length().to_string() +
            " into " +
            targets.length().to_string() +
            " variables",
            line,
            col,
          ),
        )
      }
      let mut i = 0
      while i < targets.length() {
        self.set_local(targets[i], elems[i])
        i = i + 1
      }
      Ok(())
    }
    _ =>
    Err(
      self.err(
        ErrorKind::InvalidOperation,
        "cannot unpack non-sequence value",
        line,
        col,
      ),
    )
  }
}

///| Render a compiled template (handling unconditional & conditional `extends`,
///| child top-level `set`/`macro`/`import`, and cycle detection).
fn render_compiled(
  env : Environment,
  ct : CompiledTemplate,
  ctx : Value,
  out : StringBuilder,
) -> Result[Unit, TemplateError] {
  let esc = env.resolve_auto_escape(ct.name)
  let opt_name = if ct.name.length() > 0 { Some(ct.name) } else { None }
  let root_ctx = match ctx.kind {
    ValueKind::Map(m) => Some(m)
    _ => None
  }
  let state = EvalState::new(env, opt_name, esc, out, root_ctx)

  // Push root local scope (shadowing `root_ctx` on `{% set %}` without copying `ctx`!)
  state.push_scope()
  if ct.name.length() > 0 {
    state.include_stack.push(ct.name)
  }

  if !ct.has_extends {
    return state.exec_stmts(ct.body)
  }

  // Fast path for static 2-level `{% extends 'base.html' %}` with no top-level statements
  match ct.static_extends {
    Some(pname) =>
    if pname != ct.name {
      match env.find_compiled(pname) {
        Some(parent_ct) =>
        if !parent_ct.has_extends {
          let mut bi = 0
          while bi < ct.blocks.length() {
            let (bname, bbody) = ct.blocks[bi]
            state.push_block_body(bname, bbody)
            bi = bi + 1
          }
          bi = 0
          while bi < parent_ct.blocks.length() {
            let (bname, bbody) = parent_ct.blocks[bi]
            state.push_block_body(bname, bbody)
            bi = bi + 1
          }
          return state.exec_stmts(parent_ct.body)
        }
        None => ()
      }
    }
    None => ()
  }

  // Build inheritance chain [leaf, ..., root_base] dynamically so conditional
  // `{% if ... %}{% extends ... %}{% endif %}` and child top-level `{% set %}`
  // / `{% macro %}` / `{% import %}` are evaluated in order (P1-7 & P1-8).
  let chain : Array[CompiledTemplate] = [ct]
  let visited : Array[String] = []
  if ct.name.length() > 0 {
    visited.push(ct.name)
  }
  let mut cur = ct
  while cur.has_extends {
    state.suppress_output = true
    state.pending_extends = None
    match state.exec_stmts(cur.body) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    state.suppress_output = false
    match state.pending_extends {
      None => break
      Some((pname, line, col)) => {
        let mut vi = 0
        while vi < visited.length() {
          if visited[vi] == pname {
            return Err(
              state.err(
                ErrorKind::RecursionLimit,
                "extends cycle detected: '" + pname + "'",
                line,
                col,
              ),
            )
          }
          vi = vi + 1
        }
        if chain.length() >= env.max_depth {
          return Err(
            state.err(
              ErrorKind::RecursionLimit,
              "extends depth limit exceeded",
              line,
              col,
            ),
          )
        }
        match env.find_compiled(pname) {
          None =>
          return Err(
            state.err(
              ErrorKind::TemplateNotFound,
              "parent template not found: '" + pname + "'",
              line,
              col,
            ),
          )
          Some(parent_ct) => {
            visited.push(pname)
            chain.push(parent_ct)
            cur = parent_ct
          }
        }
      }
    }
  }

  // If conditional extends never triggered on the leaf template, render it normally.
  if chain.length() == 1 {
    return state.exec_stmts(ct.body)
  }

  // Populate block chains from leaf -> root so index 0 is most-derived override,
  // and `super()` walks index + 1 toward root!
  let mut ci = 0
  while ci < chain.length() {
    let tpl = chain[ci]
    let mut bi = 0
    while bi < tpl.blocks.length() {
      let (bname, bbody) = tpl.blocks[bi]
      state.push_block_body(bname, bbody)
      bi = bi + 1
    }
    ci = ci + 1
  }

  // Execute root base template
  let root = chain[chain.length() - 1]
  state.exec_stmts(root.body)
}
