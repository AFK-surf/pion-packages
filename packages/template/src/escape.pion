///| HTML/XML escaping, JSON serialization, and URL encoding helpers.

///| Write HTML-escaped `s` into `sb` using fast-path substring copies.
///| Matches MiniJinja `HtmlEscape`: `&`, `<`, `>`, `"`, `'`, `/`.
fn write_escaped_html(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 || b == 60 || b == 62 || b == 34 || b == 39 || b == 47 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else if b == 60 {
        sb.write_string("&lt;")
      } else if b == 62 {
        sb.write_string("&gt;")
      } else if b == 34 {
        sb.write_string("&quot;")
      } else if b == 39 {
        sb.write_string("&#x27;")
      } else {
        sb.write_string("&#x2f;")
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < n {
    if mark == 0 {
      sb.write_string(s)
    } else {
      sb.write_substring(s, mark, n)
    }
  }
}

///| Escape HTML/XML special characters (`&`, `<`, `>`, `"`, `'`, `/`).
pub fn escape_html(s : String) -> String {
  let n = s.length()
  let mut needs_escape = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 || b == 60 || b == 62 || b == 34 || b == 39 || b == 47 {
      needs_escape = true
      break
    }
    i = i + 1
  }
  if !needs_escape {
    return s
  }
  let sb = StringBuilder::with_capacity(n + 16)
  write_escaped_html(sb, s)
  sb.to_string()
}

///| Compute exact escaped HTML byte length without allocating (for output limit checks).
fn escaped_html_len(s : String) -> Int {
  let n = s.length()
  let mut total = n
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      total = total + 4 // & -> &amp;
    } else if b == 60 || b == 62 {
      total = total + 3 // < -> &lt;
    } else if b == 34 || b == 39 || b == 47 {
      total = total + 5 // " -> &quot; / ' -> &#x27; / / -> &#x2f;
    }
    i = i + 1
  }
  total
}

fn hex_upper(n : Int) -> Byte {
  let d = n & 0x0F
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (55 + d).to_byte()
  }
}

///| Write a JSON-escaped string (including surrounding quotes) to `sb`.
fn write_json_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 || b < 32 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_upper(b >> 4))
        sb.write_byte(hex_upper(b))
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < n {
    if mark == 0 {
      sb.write_string(s)
    } else {
      sb.write_substring(s, mark, n)
    }
  }
  sb.write_byte((34).to_byte())
}

fn write_spaces(sb : StringBuilder, count : Int) -> Unit {
  let mut i = 0
  while i < count {
    sb.write_byte((32).to_byte())
    i = i + 1
  }
}

///| Serialize a `Value` to JSON (compact when `indent <= 0`, pretty when `indent > 0`).
fn write_json_value(
  sb : StringBuilder,
  v : Value,
  indent : Int,
  level : Int,
) -> Result[Unit, TemplateError] {
  if level > 64 {
    return Err(
      TemplateError::new(
        ErrorKind::RecursionLimit,
        "tojson recursion limit exceeded",
        None,
        0,
        0,
      ),
    )
  }
  match v.kind {
    ValueKind::Undefined => sb.write_string("null")
    ValueKind::None => sb.write_string("null")
    ValueKind::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    ValueKind::Int(n) => sb.write_string(n.to_string())
    ValueKind::Float(f) => sb.write_string(format_float_str(f))
    ValueKind::String(s) => write_json_string(sb, s)
    ValueKind::SafeString(s) => write_json_string(sb, s)
    ValueKind::Seq(items) => {
      let n = items.length()
      if n == 0 {
        sb.write_string("[]")
        return Ok(())
      }
      sb.write_byte((91).to_byte())
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        if indent > 0 {
          sb.write_byte((10).to_byte())
          write_spaces(sb, (level + 1) * indent)
        }
        match write_json_value(sb, items[i], indent, level + 1) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      if indent > 0 {
        sb.write_byte((10).to_byte())
        write_spaces(sb, level * indent)
      }
      sb.write_byte((93).to_byte())
    }
    ValueKind::Map(entries) => {
      let n = entries.length()
      if n == 0 {
        sb.write_string("{}")
        return Ok(())
      }
      sb.write_byte((123).to_byte())
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        if indent > 0 {
          sb.write_byte((10).to_byte())
          write_spaces(sb, (level + 1) * indent)
        }
        let (k, item_val) = entries[i]
        write_json_string(sb, k)
        if indent > 0 {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        match write_json_value(sb, item_val, indent, level + 1) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      if indent > 0 {
        sb.write_byte((10).to_byte())
        write_spaces(sb, level * indent)
      }
      sb.write_byte((125).to_byte())
    }
    ValueKind::Range(start, stop, step) => {
      let len = range_len(start, stop, step)
      if len > 100000L {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "range too large for tojson",
            None,
            0,
            0,
          ),
        )
      }
      sb.write_byte((91).to_byte())
      let mut i = 0L
      while i < len {
        if i > 0L {
          sb.write_byte((44).to_byte())
        }
        sb.write_string((start + i * step).to_string())
        i = i + 1L
      }
      sb.write_byte((93).to_byte())
    }
  }
  Ok(())
}

///| Percent-encode a string matching MiniJinja `urlencode` (keeps unreserved + `/`).
fn urlencode_str(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n + 8)
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let safe = (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    (b >= 48 && b <= 57) ||
    b == 45 ||
    b == 46 ||
    b == 95 ||
    b == 126 ||
    b == 47
    if safe {
      sb.write_byte(s.code_unit_at(i).to_byte())
    } else {
      sb.write_byte((37).to_byte())
      sb.write_byte(hex_upper(b >> 4))
      sb.write_byte(hex_upper(b))
    }
    i = i + 1
  }
  sb.to_string()
}
