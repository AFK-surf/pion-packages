///| Core public types for `template` (MiniJinja-compatible Jinja2 engine).

///| Categorized error kinds matching MiniJinja semantics plus Day-1 security limits.
pub enum ErrorKind {
  SyntaxError
  UndefinedError
  InvalidOperation
  UnknownFilter
  UnknownTest
  UnknownFunction
  UnknownBlock
  TemplateNotFound
  BadEscape
  BadSerialization
  RecursionLimit
  FuelExhausted
  OutputLimitExceeded
  MissingArgument
  TooManyArguments
  BadInclude
}

///|
pub fn error_kind_as_str(kind : ErrorKind) -> String {
  match kind {
    ErrorKind::SyntaxError => "SyntaxError"
    ErrorKind::UndefinedError => "UndefinedError"
    ErrorKind::InvalidOperation => "InvalidOperation"
    ErrorKind::UnknownFilter => "UnknownFilter"
    ErrorKind::UnknownTest => "UnknownTest"
    ErrorKind::UnknownFunction => "UnknownFunction"
    ErrorKind::UnknownBlock => "UnknownBlock"
    ErrorKind::TemplateNotFound => "TemplateNotFound"
    ErrorKind::BadEscape => "BadEscape"
    ErrorKind::BadSerialization => "BadSerialization"
    ErrorKind::RecursionLimit => "RecursionLimit"
    ErrorKind::FuelExhausted => "FuelExhausted"
    ErrorKind::OutputLimitExceeded => "OutputLimitExceeded"
    ErrorKind::MissingArgument => "MissingArgument"
    ErrorKind::TooManyArguments => "TooManyArguments"
    ErrorKind::BadInclude => "BadInclude"
  }
}

///|
pub fn error_kind_eq(a : ErrorKind, b : ErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured error with optional template name and 1-based line/column location.
pub struct TemplateError {
  pub kind : ErrorKind
  pub message : String
  pub template_name : Option[String]
  pub line : Int
  pub col : Int
}

///|
pub fn TemplateError::new(
  kind : ErrorKind,
  message : String,
  template_name : Option[String],
  line : Int,
  col : Int,
) -> TemplateError {
  TemplateError::{
    kind: kind,
    message: message,
    template_name: template_name,
    line: line,
    col: col,
  }
}

///|
pub fn TemplateError::kind(self : TemplateError) -> ErrorKind {
  self.kind
}

///|
pub fn TemplateError::is_kind(
  self : TemplateError,
  expected : ErrorKind,
) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn TemplateError::line(self : TemplateError) -> Int {
  self.line
}

///|
pub fn TemplateError::col(self : TemplateError) -> Int {
  self.col
}

///|
pub fn TemplateError::to_string(self : TemplateError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  match self.template_name {
    Some(name) => {
      sb.write_string(" in ")
      sb.write_string(name)
    }
    None => ()
  }
  if self.line > 0 {
    sb.write_string(" (line ")
    sb.write_string(self.line.to_string())
    if self.col > 0 {
      sb.write_string(", col ")
      sb.write_string(self.col.to_string())
    }
    sb.write_string(")")
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Auto-escaping mode for template output.
pub enum AutoEscape {
  None
  Html
  Json
}

///| Undefined variable handling policy.
pub enum UndefinedBehavior {
  Lenient
  Strict
}

///| Internal representation of a dynamic template value.
///| `Map` preserves key insertion order for deterministic iteration and JSON output.
pub enum ValueKind {
  Undefined
  None
  Bool(Bool)
  Int(Int64)
  Float(Double)
  String(String)
  SafeString(String)
  Seq(Array[Value])
  Map(Array[(String, Value)])
  Range(Int64, Int64, Int64)
}

///| Dynamic template value wrapper.
pub struct Value {
  pub kind : ValueKind
}

///|
pub fn Value::undefined() -> Value {
  Value::{ kind: ValueKind::Undefined }
}

///|
pub fn Value::none() -> Value {
  Value::{ kind: ValueKind::None }
}

///|
pub fn Value::from_bool(b : Bool) -> Value {
  Value::{ kind: ValueKind::Bool(b) }
}

///|
pub fn Value::from_int(n : Int) -> Value {
  Value::{ kind: ValueKind::Int(n.to_int64()) }
}

///|
pub fn Value::from_i64(n : Int64) -> Value {
  Value::{ kind: ValueKind::Int(n) }
}

///|
pub fn Value::from_float(f : Double) -> Value {
  Value::{ kind: ValueKind::Float(f) }
}

///|
pub fn Value::from_string(s : String) -> Value {
  Value::{ kind: ValueKind::String(s) }
}

///|
pub fn Value::safe(s : String) -> Value {
  Value::{ kind: ValueKind::SafeString(s) }
}

///|
pub fn Value::from_seq(items : Array[Value]) -> Value {
  Value::{ kind: ValueKind::Seq(items) }
}

///|
pub fn Value::from_map(entries : Array[(String, Value)]) -> Value {
  Value::{ kind: ValueKind::Map(entries) }
}

///|
pub fn Value::from_range(start : Int64, stop : Int64, step : Int64) -> Value {
  Value::{ kind: ValueKind::Range(start, stop, step) }
}

///|
pub fn range_len(start : Int64, stop : Int64, step : Int64) -> Int64 {
  if step == 0L {
    return 0L
  }
  if step > 0L {
    if start >= stop {
      return 0L
    }
    (stop - start + step - 1L) / step
  } else {
    if start <= stop {
      return 0L
    }
    let pos_step = 0L - step
    (start - stop + pos_step - 1L) / pos_step
  }
}

///|
pub fn Value::is_undefined(self : Value) -> Bool {
  match self.kind {
    ValueKind::Undefined => true
    _ => false
  }
}

///|
pub fn Value::is_none(self : Value) -> Bool {
  match self.kind {
    ValueKind::None => true
    _ => false
  }
}

///|
pub fn Value::is_safe(self : Value) -> Bool {
  match self.kind {
    ValueKind::SafeString(_) => true
    _ => false
  }
}

///|
pub fn Value::is_truthy(self : Value) -> Bool {
  match self.kind {
    ValueKind::Undefined => false
    ValueKind::None => false
    ValueKind::Bool(b) => b
    ValueKind::Int(n) => n != 0L
    ValueKind::Float(f) => f != 0.0
    ValueKind::String(s) => s.length() > 0
    ValueKind::SafeString(s) => s.length() > 0
    ValueKind::Seq(arr) => arr.length() > 0
    ValueKind::Map(entries) => entries.length() > 0
    ValueKind::Range(a, b, s) => range_len(a, b, s) > 0L
  }
}

///|
pub fn Value::as_str(self : Value) -> Option[String] {
  match self.kind {
    ValueKind::String(s) => Some(s)
    ValueKind::SafeString(s) => Some(s)
    _ => None
  }
}

///|
pub fn Value::as_i64(self : Value) -> Option[Int64] {
  match self.kind {
    ValueKind::Int(n) => Some(n)
    _ => None
  }
}

///|
pub fn Value::as_f64(self : Value) -> Option[Double] {
  match self.kind {
    ValueKind::Float(f) => Some(f)
    ValueKind::Int(n) => Some(n.to_double())
    _ => None
  }
}

///|
pub fn Value::as_bool(self : Value) -> Option[Bool] {
  match self.kind {
    ValueKind::Bool(b) => Some(b)
    _ => None
  }
}

///|
pub fn Value::get_attr(self : Value, key : String) -> Value {
  match self.kind {
    ValueKind::Map(entries) => {
      let mut i = 0
      let n = entries.length()
      while i < n {
        let (k, v) = entries[i]
        if k == key {
          return v
        }
        i = i + 1
      }
      Value::undefined()
    }
    _ => Value::undefined()
  }
}

///|
pub fn Value::get_index(self : Value, idx : Int) -> Value {
  match self.kind {
    ValueKind::Seq(items) => {
      let n = items.length()
      let actual = if idx < 0 { n + idx } else { idx }
      if actual >= 0 && actual < n {
        items[actual]
      } else {
        Value::undefined()
      }
    }
    ValueKind::Range(start, stop, step) => {
      let len = range_len(start, stop, step)
      let i64 = idx.to_int64()
      let actual = if i64 < 0L { len + i64 } else { i64 }
      if actual >= 0L && actual < len {
        Value::from_i64(start + actual * step)
      } else {
        Value::undefined()
      }
    }
    ValueKind::String(s) => {
      let n = s.length()
      let actual = if idx < 0 { n + idx } else { idx }
      if actual >= 0 && actual < n {
        Value::from_string(s.slice(actual, actual + 1))
      } else {
        Value::undefined()
      }
    }
    ValueKind::SafeString(s) => {
      let n = s.length()
      let actual = if idx < 0 { n + idx } else { idx }
      if actual >= 0 && actual < n {
        Value::from_string(s.slice(actual, actual + 1))
      } else {
        Value::undefined()
      }
    }
    _ => Value::undefined()
  }
}

///| Format a Double matching MiniJinja (always includes `.0` for integer-valued floats).
fn format_float_str(f : Double) -> String {
  let s = f.to_string()
  let mut has_dot_or_e = false
  let mut i = 0
  let n = s.length()
  while i < n {
    let b = s.code_unit_at(i)
    if b == 46 || b == 101 || b == 69 {
      has_dot_or_e = true
      break
    }
    i = i + 1
  }
  if has_dot_or_e {
    s
  } else {
    s + ".0"
  }
}

///| Write JSON/MiniJinja-style quoted string representation.
fn write_quoted_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let mut i = 0
  let n = s.length()
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_byte(s.code_unit_at(i).to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///| Write debug/container-element representation of a Value.
fn write_value_repr(sb : StringBuilder, v : Value, depth : Int) -> Unit {
  if depth > 64 {
    sb.write_string("...")
    return
  }
  match v.kind {
    ValueKind::Undefined => sb.write_string("undefined")
    ValueKind::None => sb.write_string("none")
    ValueKind::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    ValueKind::Int(n) => sb.write_string(n.to_string())
    ValueKind::Float(f) => sb.write_string(format_float_str(f))
    ValueKind::String(s) => write_quoted_str(sb, s)
    ValueKind::SafeString(s) => write_quoted_str(sb, s)
    ValueKind::Seq(items) => {
      sb.write_byte((91).to_byte())
      let mut i = 0
      let n = items.length()
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        write_value_repr(sb, items[i], depth + 1)
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    ValueKind::Map(entries) => {
      sb.write_byte((123).to_byte())
      let mut i = 0
      let n = entries.length()
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        let (k, item_val) = entries[i]
        write_quoted_str(sb, k)
        sb.write_string(": ")
        write_value_repr(sb, item_val, depth + 1)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
    ValueKind::Range(start, stop, step) => {
      sb.write_string("range(")
      sb.write_string(start.to_string())
      sb.write_string(", ")
      sb.write_string(stop.to_string())
      if step != 1L {
        sb.write_string(", ")
        sb.write_string(step.to_string())
      }
      sb.write_string(")")
    }
  }
}

///| Write display representation of a Value to `StringBuilder`.
fn write_value_display(sb : StringBuilder, v : Value) -> Unit {
  match v.kind {
    ValueKind::Undefined => ()
    ValueKind::None => sb.write_string("none")
    ValueKind::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    ValueKind::Int(n) => sb.write_string(n.to_string())
    ValueKind::Float(f) => sb.write_string(format_float_str(f))
    ValueKind::String(s) => sb.write_string(s)
    ValueKind::SafeString(s) => sb.write_string(s)
    ValueKind::Seq(_) => write_value_repr(sb, v, 0)
    ValueKind::Map(_) => write_value_repr(sb, v, 0)
    ValueKind::Range(_, _, _) => write_value_repr(sb, v, 0)
  }
}

///|
pub fn Value::to_display_string(self : Value) -> String {
  match self.kind {
    ValueKind::Undefined => ""
    ValueKind::None => "none"
    ValueKind::Bool(b) => if b { "true" } else { "false" }
    ValueKind::Int(n) => n.to_string()
    ValueKind::Float(f) => format_float_str(f)
    ValueKind::String(s) => s
    ValueKind::SafeString(s) => s
    _ => {
      let sb = StringBuilder::new()
      write_value_display(sb, self)
      sb.to_string()
    }
  }
}

///|
pub fn Value::equals(self : Value, other : Value) -> Bool {
  match (self.kind, other.kind) {
    (ValueKind::Undefined, ValueKind::Undefined) => true
    (ValueKind::None, ValueKind::None) => true
    (ValueKind::Bool(a), ValueKind::Bool(b)) => a == b
    (ValueKind::Int(a), ValueKind::Int(b)) => a == b
    (ValueKind::Float(a), ValueKind::Float(b)) => a == b
    (ValueKind::Int(a), ValueKind::Float(b)) => a.to_double() == b
    (ValueKind::Float(a), ValueKind::Int(b)) => a == b.to_double()
    (ValueKind::String(a), ValueKind::String(b)) => a == b
    (ValueKind::SafeString(a), ValueKind::SafeString(b)) => a == b
    (ValueKind::String(a), ValueKind::SafeString(b)) => a == b
    (ValueKind::SafeString(a), ValueKind::String(b)) => a == b
    (ValueKind::Seq(a), ValueKind::Seq(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        if !a[i].equals(b[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Map(a), ValueKind::Map(b)) => {
      if a.length() != b.length() {
        return false
      }
      let mut i = 0
      while i < a.length() {
        let (ka, va) = a[i]
        let vb = other.get_attr(ka)
        if vb.is_undefined() && !va.is_undefined() {
          return false
        }
        if !va.equals(vb) {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Range(a1, b1, s1), ValueKind::Range(a2, b2, s2)) =>
    a1 == a2 && b1 == b2 && s1 == s2
    _ => false
  }
}

///| Compare two values for ordering (`<`, `<=`, `>`, `>=`, `sort`).
///| Returns `Some(-1 | 0 | 1)` when comparable, `None` otherwise.
fn value_compare(a : Value, b : Value) -> Option[Int] {
  match (a.kind, b.kind) {
    (ValueKind::Int(x), ValueKind::Int(y)) =>
    if x < y {
      Some(-1)
    } else if x > y {
      Some(1)
    } else {
      Some(0)
    }
    (ValueKind::Float(x), ValueKind::Float(y)) =>
    if x < y {
      Some(-1)
    } else if x > y {
      Some(1)
    } else {
      Some(0)
    }
    (ValueKind::Int(x), ValueKind::Float(y)) => {
      let xf = x.to_double()
      if xf < y {
        Some(-1)
      } else if xf > y {
        Some(1)
      } else {
        Some(0)
      }
    }
    (ValueKind::Float(x), ValueKind::Int(y)) => {
      let yf = y.to_double()
      if x < yf {
        Some(-1)
      } else if x > yf {
        Some(1)
      } else {
        Some(0)
      }
    }
    (ValueKind::Bool(x), ValueKind::Bool(y)) => {
      let xi = if x { 1 } else { 0 }
      let yi = if y { 1 } else { 0 }
      if xi < yi {
        Some(-1)
      } else if xi > yi {
        Some(1)
      } else {
        Some(0)
      }
    }
    (ValueKind::String(x), ValueKind::String(y)) => Some(str_compare(x, y))
    (ValueKind::SafeString(x), ValueKind::SafeString(y)) => Some(str_compare(x, y))
    (ValueKind::String(x), ValueKind::SafeString(y)) => Some(str_compare(x, y))
    (ValueKind::SafeString(x), ValueKind::String(y)) => Some(str_compare(x, y))
    (ValueKind::Seq(xs), ValueKind::Seq(ys)) => {
      let n = if xs.length() < ys.length() { xs.length() } else { ys.length() }
      let mut i = 0
      while i < n {
        match value_compare(xs[i], ys[i]) {
          Some(0) => i = i + 1
          Some(c) => return Some(c)
          None => return None
        }
      }
      if xs.length() < ys.length() {
        Some(-1)
      } else if xs.length() > ys.length() {
        Some(1)
      } else {
        Some(0)
      }
    }
    _ => None
  }
}

///| Lexicographical byte comparison of two strings.
fn str_compare(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let n = if na < nb { na } else { nb }
  let mut i = 0
  while i < n {
    let ba = a.code_unit_at(i)
    let bb = b.code_unit_at(i)
    if ba < bb {
      return -1
    }
    if ba > bb {
      return 1
    }
    i = i + 1
  }
  if na < nb {
    -1
  } else if na > nb {
    1
  } else {
    0
  }
}
