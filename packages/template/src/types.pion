///| Core public types for `template` (MiniJinja-compatible Jinja2 engine).

///| Categorized error kinds matching MiniJinja semantics plus Day-1 security limits.
pub enum ErrorKind {
  SyntaxError
  UndefinedError
  InvalidOperation
  UnknownFilter
  UnknownTest
  UnknownFunction
  UnknownBlock
  TemplateNotFound
  BadEscape
  BadSerialization
  RecursionLimit
  FuelExhausted
  OutputLimitExceeded
  MissingArgument
  TooManyArguments
  BadInclude
}

///|
pub fn error_kind_as_str(kind : ErrorKind) -> String {
  match kind {
    ErrorKind::SyntaxError => "SyntaxError"
    ErrorKind::UndefinedError => "UndefinedError"
    ErrorKind::InvalidOperation => "InvalidOperation"
    ErrorKind::UnknownFilter => "UnknownFilter"
    ErrorKind::UnknownTest => "UnknownTest"
    ErrorKind::UnknownFunction => "UnknownFunction"
    ErrorKind::UnknownBlock => "UnknownBlock"
    ErrorKind::TemplateNotFound => "TemplateNotFound"
    ErrorKind::BadEscape => "BadEscape"
    ErrorKind::BadSerialization => "BadSerialization"
    ErrorKind::RecursionLimit => "RecursionLimit"
    ErrorKind::FuelExhausted => "FuelExhausted"
    ErrorKind::OutputLimitExceeded => "OutputLimitExceeded"
    ErrorKind::MissingArgument => "MissingArgument"
    ErrorKind::TooManyArguments => "TooManyArguments"
    ErrorKind::BadInclude => "BadInclude"
  }
}

///|
pub fn error_kind_eq(a : ErrorKind, b : ErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured error with optional template name and 1-based line/column location.
pub struct TemplateError {
  pub kind : ErrorKind
  pub message : String
  pub template_name : Option[String]
  pub line : Int
  pub col : Int
}

///|
pub fn TemplateError::new(
  kind : ErrorKind,
  message : String,
  template_name : Option[String],
  line : Int,
  col : Int,
) -> TemplateError {
  TemplateError::{
    kind: kind,
    message: message,
    template_name: template_name,
    line: line,
    col: col,
  }
}

///|
pub fn TemplateError::kind(self : TemplateError) -> ErrorKind {
  self.kind
}

///|
pub fn TemplateError::is_kind(
  self : TemplateError,
  expected : ErrorKind,
) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn TemplateError::line(self : TemplateError) -> Int {
  self.line
}

///|
pub fn TemplateError::col(self : TemplateError) -> Int {
  self.col
}

///|
pub fn TemplateError::to_string(self : TemplateError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  match self.template_name {
    Some(name) => {
      sb.write_string(" in ")
      sb.write_string(name)
    }
    None => ()
  }
  if self.line > 0 {
    sb.write_string(" (line ")
    sb.write_string(self.line.to_string())
    if self.col > 0 {
      sb.write_string(", col ")
      sb.write_string(self.col.to_string())
    }
    sb.write_string(")")
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Auto-escaping mode for template output.
pub enum AutoEscape {
  None
  Html
  Json
}

///| Undefined variable handling policy.
pub enum UndefinedBehavior {
  Lenient
  Strict
}

///| Internal representation of a dynamic template value.
///| `Map` preserves key insertion order for deterministic iteration and JSON output.
pub enum ValueKind {
  Undefined(Int)
  None(Int)
  Bool(Bool)
  Int(Int64)
  BigInt(I128)
  Float(Double)
  String(String)
  SafeString(String)
  Seq(Array[Value])
  Map(Array[(String, Value)])
  Range(Int64, Int64, Int64)
}

///| Dynamic template value wrapper.
pub struct Value {
  pub kind : ValueKind
}

///|
pub fn Value::undefined() -> Value {
  Value::{ kind: ValueKind::Undefined(0) }
}

///|
pub fn Value::none() -> Value {
  Value::{ kind: ValueKind::None(0) }
}

///|
pub fn Value::from_bool(b : Bool) -> Value {
  Value::{ kind: ValueKind::Bool(b) }
}

///|
pub fn Value::from_int(n : Int) -> Value {
  Value::{ kind: ValueKind::Int(n.to_int64()) }
}

///|
pub fn Value::from_i64(n : Int64) -> Value {
  Value::{ kind: ValueKind::Int(n) }
}

///|
pub fn Value::from_float(f : Double) -> Value {
  Value::{ kind: ValueKind::Float(f) }
}

///|
pub fn Value::from_string(s : String) -> Value {
  Value::{ kind: ValueKind::String(s) }
}

///|
pub fn Value::safe(s : String) -> Value {
  Value::{ kind: ValueKind::SafeString(s) }
}

///|
pub fn Value::from_seq(items : Array[Value]) -> Value {
  Value::{ kind: ValueKind::Seq(items) }
}

///|
pub fn Value::from_map(entries : Array[(String, Value)]) -> Value {
  Value::{ kind: ValueKind::Map(entries) }
}

///|
pub fn Value::from_range(start : Int64, stop : Int64, step : Int64) -> Value {
  Value::{ kind: ValueKind::Range(start, stop, step) }
}

///|
pub fn range_len(start : Int64, stop : Int64, step : Int64) -> Int64 {
  if step == 0L {
    return 0L
  }
  if step > 0L {
    if start >= stop {
      return 0L
    }
    (stop - start + step - 1L) / step
  } else {
    if start <= stop {
      return 0L
    }
    let pos_step = 0L - step
    (start - stop + pos_step - 1L) / pos_step
  }
}

///|
pub fn Value::is_undefined(self : Value) -> Bool {
  match self.kind {
    ValueKind::Undefined(_) => true
    _ => false
  }
}

///|
pub fn Value::is_none(self : Value) -> Bool {
  match self.kind {
    ValueKind::None(_) => true
    _ => false
  }
}

///|
pub fn Value::is_safe(self : Value) -> Bool {
  match self.kind {
    ValueKind::SafeString(_) => true
    _ => false
  }
}

///|
pub fn Value::is_truthy(self : Value) -> Bool {
  match self.kind {
    ValueKind::Undefined(_) => false
    ValueKind::None(_) => false
    ValueKind::Bool(b) => b
    ValueKind::Int(n) => n != 0L
    ValueKind::BigInt(b) => !i128_is_zero(b)
    ValueKind::Float(f) => f != 0.0
    ValueKind::String(s) => s.length() > 0
    ValueKind::SafeString(s) => s.length() > 0
    ValueKind::Seq(arr) => arr.length() > 0
    ValueKind::Map(entries) => entries.length() > 0
    ValueKind::Range(a, b, s) => range_len(a, b, s) > 0L
  }
}

///|
pub fn Value::as_str(self : Value) -> Option[String] {
  match self.kind {
    ValueKind::String(s) => Some(s)
    ValueKind::SafeString(s) => Some(s)
    _ => None
  }
}

///|
pub fn Value::as_i64(self : Value) -> Option[Int64] {
  match self.kind {
    ValueKind::Int(n) => Some(n)
    ValueKind::BigInt(b) => i128_to_i64_opt(b)
    _ => None
  }
}

///|
pub fn Value::as_f64(self : Value) -> Option[Double] {
  match self.kind {
    ValueKind::Float(f) => Some(f)
    ValueKind::Int(n) => Some(n.to_double())
    ValueKind::BigInt(b) => Some(i128_to_double(b))
    _ => None
  }
}

///|
pub fn Value::as_bool(self : Value) -> Option[Bool] {
  match self.kind {
    ValueKind::Bool(b) => Some(b)
    _ => None
  }
}

fn parse_nonneg_index(key : String) -> Option[Int] {
  let n = key.length()
  if n == 0 || n > 9 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = key.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

///|
pub fn Value::get_attr(self : Value, key : String) -> Value {
  match self.kind {
    ValueKind::Map(entries) => {
      let mut i = 0
      let n = entries.length()
      while i < n {
        let (k, v) = entries[i]
        if k == key {
          return v
        }
        i = i + 1
      }
      Value::undefined()
    }
    ValueKind::Seq(_) =>
    match parse_nonneg_index(key) {
      Some(idx) => self.get_index(idx)
      None => Value::undefined()
    }
    _ => Value::undefined()
  }
}

///|
pub fn Value::get_index(self : Value, idx : Int) -> Value {
  match self.kind {
    ValueKind::Seq(items) => {
      let n = items.length()
      let actual = if idx < 0 { n + idx } else { idx }
      if actual >= 0 && actual < n {
        items[actual]
      } else {
        Value::undefined()
      }
    }
    ValueKind::Range(start, stop, step) => {
      let len = range_len(start, stop, step)
      let i64 = idx.to_int64()
      let actual = if i64 < 0L { len + i64 } else { i64 }
      if actual >= 0L && actual < len {
        Value::from_i64(start + actual * step)
      } else {
        Value::undefined()
      }
    }
    ValueKind::String(s) =>
    match utf8_char_at(s, idx) {
      Some(ch) => Value::from_string(ch)
      None => Value::undefined()
    }
    ValueKind::SafeString(s) =>
    match utf8_char_at(s, idx) {
      Some(ch) => Value::from_string(ch)
      None => Value::undefined()
    }
    _ => Value::undefined()
  }
}

///| Format a Double matching MiniJinja (always includes `.0` for integer-valued floats).
fn format_float_str(f : Double) -> String {
  if f == 0.0 {
    // Normalize -0.0 / 0.0
    let raw = f.to_string()
    if raw.length() > 0 && raw.code_unit_at(0) == 45 {
      return "-0.0"
    }
    return "0.0"
  }
  let s = f.to_string()
  let mut has_dot_or_e = false
  let mut i = 0
  let n = s.length()
  while i < n {
    let b = s.code_unit_at(i)
    if b == 46 || b == 101 || b == 69 {
      has_dot_or_e = true
      break
    }
    i = i + 1
  }
  if has_dot_or_e {
    s
  } else {
    s + ".0"
  }
}

///| Write Python/MiniJinja-style quoted string representation.
///| Uses single quotes unless the string contains `'` and no `"`, matching Python/MiniJinja.
fn write_quoted_str(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut has_sq = false
  let mut has_dq = false
  let mut si = 0
  while si < n {
    let b = s.code_unit_at(si)
    if b == 39 { has_sq = true }
    if b == 34 { has_dq = true }
    si = si + 1
  }
  let q = if has_sq && !has_dq { 34 } else { 39 }
  sb.write_byte(q.to_byte())
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == q {
      sb.write_byte((92).to_byte())
      sb.write_byte(q.to_byte())
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(q.to_byte())
}

///| Iterative repr writer with depth cap (zero recursion -> zero Wasm32 stack risk).
enum ReprTask {
  Val(Value, Int)
  Lit(String)
}

fn write_value_repr(sb : StringBuilder, root : Value, start_depth : Int) -> Unit {
  let stack : Array[ReprTask] = [ReprTask::Val(root, start_depth)]
  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      ReprTask::Lit(s) => sb.write_string(s)
      ReprTask::Val(v, depth) => {
        if depth > 64 {
          sb.write_string("...")
          continue
        }
        match v.kind {
          ValueKind::Undefined(_) => sb.write_string("undefined")
          ValueKind::None(_) => sb.write_string("None")
          ValueKind::Bool(b) => sb.write_string(if b { "True" } else { "False" })
          ValueKind::Int(n) => sb.write_string(n.to_string())
          ValueKind::BigInt(b) => sb.write_string(i128_to_string(b))
          ValueKind::Float(f) => sb.write_string(format_float_str(f))
          ValueKind::String(s) => write_quoted_str(sb, s)
          ValueKind::SafeString(s) => write_quoted_str(sb, s)
          ValueKind::Seq(items) => {
            sb.write_byte((91).to_byte())
            stack.push(ReprTask::Lit("]"))
            let mut i = items.length() - 1
            while i >= 0 {
              stack.push(ReprTask::Val(items[i], depth + 1))
              if i > 0 {
                stack.push(ReprTask::Lit(", "))
              }
              i = i - 1
            }
          }
          ValueKind::Map(entries) => {
            sb.write_byte((123).to_byte())
            stack.push(ReprTask::Lit("}"))
            let mut i = entries.length() - 1
            while i >= 0 {
              let (k, item_val) = entries[i]
              stack.push(ReprTask::Val(item_val, depth + 1))
              stack.push(ReprTask::Lit(": "))
              stack.push(ReprTask::Val(Value::from_string(k), depth + 1))
              if i > 0 {
                stack.push(ReprTask::Lit(", "))
              }
              i = i - 1
            }
          }
          ValueKind::Range(start, stop, step) => {
            sb.write_string("range(")
            sb.write_string(start.to_string())
            sb.write_string(", ")
            sb.write_string(stop.to_string())
            if step != 1L {
              sb.write_string(", ")
              sb.write_string(step.to_string())
            }
            sb.write_string(")")
          }
        }
      }
    }
  }
}

///| Write display representation of a Value to `StringBuilder`.
fn write_value_display(sb : StringBuilder, v : Value) -> Unit {
  match v.kind {
    ValueKind::Undefined(_) => ()
    ValueKind::None(_) => sb.write_string("None")
    ValueKind::Bool(b) => sb.write_string(if b { "True" } else { "False" })
    ValueKind::Int(n) => sb.write_string(n.to_string())
    ValueKind::BigInt(b) => sb.write_string(i128_to_string(b))
    ValueKind::Float(f) => sb.write_string(format_float_str(f))
    ValueKind::String(s) => sb.write_string(s)
    ValueKind::SafeString(s) => sb.write_string(s)
    ValueKind::Seq(_) => write_value_repr(sb, v, 0)
    ValueKind::Map(_) => write_value_repr(sb, v, 0)
    ValueKind::Range(_, _, _) => write_value_repr(sb, v, 0)
  }
}

///|
pub fn Value::to_display_string(self : Value) -> String {
  match self.kind {
    ValueKind::Undefined(_) => ""
    ValueKind::None(_) => "None"
    ValueKind::Bool(b) => if b { "True" } else { "False" }
    ValueKind::Int(n) => n.to_string()
    ValueKind::BigInt(b) => i128_to_string(b)
    ValueKind::Float(f) => format_float_str(f)
    ValueKind::String(s) => s
    ValueKind::SafeString(s) => s
    _ => {
      let sb = StringBuilder::new()
      write_value_display(sb, self)
      sb.to_string()
    }
  }
}

///| Iterative/depth-bounded value equality (safe on 5000-deep nested lists on Wasm32).
fn value_equals_depth(a : Value, b : Value, depth : Int) -> Bool {
  if depth > 64 {
    return true
  }
  match (a.kind, b.kind) {
    (ValueKind::Undefined(_), ValueKind::Undefined(_)) => true
    (ValueKind::None(_), ValueKind::None(_)) => true
    (ValueKind::Bool(x), ValueKind::Bool(y)) => x == y
    (ValueKind::Int(x), ValueKind::Int(y)) => x == y
    (ValueKind::BigInt(x), ValueKind::BigInt(y)) => i128_eq(x, y)
    (ValueKind::Int(x), ValueKind::BigInt(y)) => i128_eq(i128_from_i64(x), y)
    (ValueKind::BigInt(x), ValueKind::Int(y)) => i128_eq(x, i128_from_i64(y))
    (ValueKind::Float(x), ValueKind::Float(y)) => x == y
    (ValueKind::Int(x), ValueKind::Float(y)) => x.to_double() == y
    (ValueKind::Float(x), ValueKind::Int(y)) => x == y.to_double()
    (ValueKind::BigInt(x), ValueKind::Float(y)) => i128_to_double(x) == y
    (ValueKind::Float(x), ValueKind::BigInt(y)) => x == i128_to_double(y)
    (ValueKind::String(x), ValueKind::String(y)) => x == y
    (ValueKind::SafeString(x), ValueKind::SafeString(y)) => x == y
    (ValueKind::String(x), ValueKind::SafeString(y)) => x == y
    (ValueKind::SafeString(x), ValueKind::String(y)) => x == y
    (ValueKind::Seq(xs), ValueKind::Seq(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !value_equals_depth(xs[i], ys[i], depth + 1) {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Map(xs), ValueKind::Map(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        let (ka, va) = xs[i]
        let vb = b.get_attr(ka)
        if vb.is_undefined() && !va.is_undefined() {
          return false
        }
        if !value_equals_depth(va, vb, depth + 1) {
          return false
        }
        i = i + 1
      }
      true
    }
    (ValueKind::Range(a1, b1, s1), ValueKind::Range(a2, b2, s2)) =>
    a1 == a2 && b1 == b2 && s1 == s2
    _ => false
  }
}

///|
pub fn Value::equals(self : Value, other : Value) -> Bool {
  value_equals_depth(self, other, 0)
}

///| Compare two values for ordering (`<`, `<=`, `>`, `>=`).
///| Returns `Some(-1 | 0 | 1)` when comparable, `None` otherwise.
fn value_compare_depth(a : Value, b : Value, depth : Int) -> Option[Int] {
  if depth > 64 {
    return Some(0)
  }
  match (a.kind, b.kind) {
    (ValueKind::Int(x), ValueKind::Int(y)) =>
    if x < y { Some(-1) } else if x > y { Some(1) } else { Some(0) }
    (ValueKind::BigInt(x), ValueKind::BigInt(y)) => Some(i128_cmp(x, y))
    (ValueKind::Int(x), ValueKind::BigInt(y)) => Some(i128_cmp(i128_from_i64(x), y))
    (ValueKind::BigInt(x), ValueKind::Int(y)) => Some(i128_cmp(x, i128_from_i64(y)))
    (ValueKind::Float(x), ValueKind::Float(y)) =>
    if x < y { Some(-1) } else if x > y { Some(1) } else { Some(0) }
    (ValueKind::Int(x), ValueKind::Float(y)) => {
      let xf = x.to_double()
      if xf < y { Some(-1) } else if xf > y { Some(1) } else { Some(0) }
    }
    (ValueKind::Float(x), ValueKind::Int(y)) => {
      let yf = y.to_double()
      if x < yf { Some(-1) } else if x > yf { Some(1) } else { Some(0) }
    }
    (ValueKind::BigInt(x), ValueKind::Float(y)) => {
      let xf = i128_to_double(x)
      if xf < y { Some(-1) } else if xf > y { Some(1) } else { Some(0) }
    }
    (ValueKind::Float(x), ValueKind::BigInt(y)) => {
      let yf = i128_to_double(y)
      if x < yf { Some(-1) } else if x > yf { Some(1) } else { Some(0) }
    }
    (ValueKind::Bool(x), ValueKind::Bool(y)) => {
      let xi = if x { 1 } else { 0 }
      let yi = if y { 1 } else { 0 }
      if xi < yi { Some(-1) } else if xi > yi { Some(1) } else { Some(0) }
    }
    (ValueKind::String(x), ValueKind::String(y)) => Some(str_compare(x, y))
    (ValueKind::SafeString(x), ValueKind::SafeString(y)) => Some(str_compare(x, y))
    (ValueKind::String(x), ValueKind::SafeString(y)) => Some(str_compare(x, y))
    (ValueKind::SafeString(x), ValueKind::String(y)) => Some(str_compare(x, y))
    (ValueKind::Seq(xs), ValueKind::Seq(ys)) => {
      let n = if xs.length() < ys.length() { xs.length() } else { ys.length() }
      let mut i = 0
      while i < n {
        match value_compare_depth(xs[i], ys[i], depth + 1) {
          Some(0) => i = i + 1
          Some(c) => return Some(c)
          None => return None
        }
      }
      if xs.length() < ys.length() {
        Some(-1)
      } else if xs.length() > ys.length() {
        Some(1)
      } else {
        Some(0)
      }
    }
    _ => None
  }
}

fn value_compare(a : Value, b : Value) -> Option[Int] {
  value_compare_depth(a, b, 0)
}

///| MiniJinja 3.1.0 total ordering rank for mixed-type sorting / comparison.
fn value_type_rank(v : Value) -> Int {
  match v.kind {
    ValueKind::Undefined(_) => 0
    ValueKind::None(_) => 1
    ValueKind::Bool(_) => 2
    ValueKind::Int(_) => 3
    ValueKind::BigInt(_) => 3
    ValueKind::Float(_) => 3
    ValueKind::String(_) => 4
    ValueKind::SafeString(_) => 4
    ValueKind::Seq(_) => 5
    ValueKind::Range(_, _, _) => 5
    ValueKind::Map(_) => 6
  }
}

///| Total ordering matching MiniJinja 3.1.0 (`|sort`, `|min`, `|max`).
fn value_sort_compare(
  a : Value,
  b : Value,
  case_sensitive : Bool,
  depth : Int,
) -> Int {
  if depth > 64 {
    return 0
  }
  let ra = value_type_rank(a)
  let rb = value_type_rank(b)
  if ra != rb {
    return if ra < rb { -1 } else { 1 }
  }
  match (a.kind, b.kind) {
    (ValueKind::String(x), ValueKind::String(y)) =>
    if case_sensitive { str_compare(x, y) } else { str_compare_ci(x, y) }
    (ValueKind::SafeString(x), ValueKind::SafeString(y)) =>
    if case_sensitive { str_compare(x, y) } else { str_compare_ci(x, y) }
    (ValueKind::String(x), ValueKind::SafeString(y)) =>
    if case_sensitive { str_compare(x, y) } else { str_compare_ci(x, y) }
    (ValueKind::SafeString(x), ValueKind::String(y)) =>
    if case_sensitive { str_compare(x, y) } else { str_compare_ci(x, y) }
    (ValueKind::Seq(xs), ValueKind::Seq(ys)) => {
      let n = if xs.length() < ys.length() { xs.length() } else { ys.length() }
      let mut i = 0
      while i < n {
        let c = value_sort_compare(xs[i], ys[i], case_sensitive, depth + 1)
        if c != 0 {
          return c
        }
        i = i + 1
      }
      if xs.length() < ys.length() { -1 } else if xs.length() > ys.length() { 1 } else { 0 }
    }
    _ =>
    match value_compare_depth(a, b, depth) {
      Some(c) => c
      None => 0
    }
  }
}

///| Case-insensitive string comparison (Unicode-aware).
fn str_compare_ci(a : String, b : String) -> Int {
  let c = str_compare(utf8_to_lower(a), utf8_to_lower(b))
  if c != 0 { c } else { 0 }
}

///| Lexicographical byte comparison of two strings.
fn str_compare(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let n = if na < nb { na } else { nb }
  let mut i = 0
  while i < n {
    let ba = a.code_unit_at(i)
    let bb = b.code_unit_at(i)
    if ba < bb {
      return -1
    }
    if ba > bb {
      return 1
    }
    i = i + 1
  }
  if na < nb {
    -1
  } else if na > nb {
    1
  } else {
    0
  }
}
