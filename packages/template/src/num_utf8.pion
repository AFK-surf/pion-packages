///| Exact 128-bit signed integer arithmetic (zero-trap on Native & Wasm32)
///| and UTF-8 codepoint string utilities.
///|
///| `I128` stores sign-magnitude in 5 base-2^26 limbs (`l0`..`l4`, each in `0..2^26-1`),
///| covering the exact Rust `i128` range `[-2^127, 2^127 - 1]`.
///| Because `(2^26 - 1)^2 < 2^52` and summing 5 products `< 2^55 < 2^63`,
///| every intermediate arithmetic operation stays strictly within non-negative `Int64`
///| and can never trigger a Wasm32 integer overflow/division trap.

let I64_MIN : Int64 = -9223372036854775807L - 1L

let I64_MAX : Int64 = 9223372036854775807L

let LIMB_BITS : Int = 26

let LIMB_BASE : Int64 = 67108864L // 2^26

let LIMB_MASK : Int64 = 67108863L // 2^26 - 1

///| Signed 128-bit integer in sign-magnitude 5x26-bit limb representation.
pub struct I128 {
  neg : Bool
  l0 : Int64
  l1 : Int64
  l2 : Int64
  l3 : Int64
  l4 : Int64 // bits 104..127 (max 2^23 for -2^127, max 2^23 - 1 for 2^127 - 1)
}

fn i128_zero() -> I128 {
  I128::{ neg: false, l0: 0L, l1: 0L, l2: 0L, l3: 0L, l4: 0L }
}

fn i128_is_zero(a : I128) -> Bool {
  a.l0 == 0L && a.l1 == 0L && a.l2 == 0L && a.l3 == 0L && a.l4 == 0L
}

///| Check whether magnitude fits in exact `i128` range:
///| positive: < 2^127 (`l4 < 2^23 = 8388608`)
///| negative: <= 2^127 (`l4 < 8388608` or (`l4 == 8388608` and l0..l3 == 0))
fn i128_in_range(neg : Bool, l0 : Int64, l1 : Int64, l2 : Int64, l3 : Int64, l4 : Int64) -> Bool {
  if l4 < 0L {
    return false
  }
  if l4 < 8388608L {
    return true
  }
  if neg && l4 == 8388608L && l3 == 0L && l2 == 0L && l1 == 0L && l0 == 0L {
    return true
  }
  false
}

fn i128_make(neg : Bool, l0 : Int64, l1 : Int64, l2 : Int64, l3 : Int64, l4 : Int64) -> Option[I128] {
  if l0 == 0L && l1 == 0L && l2 == 0L && l3 == 0L && l4 == 0L {
    return Some(i128_zero())
  }
  if !i128_in_range(neg, l0, l1, l2, l3, l4) {
    return None
  }
  Some(I128::{ neg: neg, l0: l0, l1: l1, l2: l2, l3: l3, l4: l4 })
}

fn i128_from_i64(n : Int64) -> I128 {
  if n == 0L {
    return i128_zero()
  }
  if n == I64_MIN {
    // 2^63 = 2^(26 + 26 + 11) -> l2 = 2048
    return I128::{ neg: true, l0: 0L, l1: 0L, l2: 2048L, l3: 0L, l4: 0L }
  }
  let neg = n < 0L
  let mag = if neg { 0L - n } else { n }
  let l0 = mag & LIMB_MASK
  let r1 = mag >> LIMB_BITS
  let l1 = r1 & LIMB_MASK
  let l2 = r1 >> LIMB_BITS
  I128::{ neg: neg, l0: l0, l1: l1, l2: l2, l3: 0L, l4: 0L }
}

fn i128_to_i64_opt(a : I128) -> Option[Int64] {
  if a.l4 != 0L || a.l3 != 0L {
    return None
  }
  if a.neg && a.l2 == 2048L && a.l1 == 0L && a.l0 == 0L {
    return Some(I64_MIN)
  }
  if a.l2 >= 2048L {
    return None
  }
  let mag = a.l0 + (a.l1 << LIMB_BITS) + (a.l2 << 52)
  Some(if a.neg { 0L - mag } else { mag })
}

fn i128_to_double(a : I128) -> Double {
  let base = 67108864.0
  let v = (((a.l4.to_double() * base + a.l3.to_double()) * base + a.l2.to_double()) * base + a.l1.to_double()) * base + a.l0.to_double()
  if a.neg { 0.0 - v } else { v }
}

fn i128_cmp_mag(a : I128, b : I128) -> Int {
  if a.l4 != b.l4 { return if a.l4 < b.l4 { -1 } else { 1 } }
  if a.l3 != b.l3 { return if a.l3 < b.l3 { -1 } else { 1 } }
  if a.l2 != b.l2 { return if a.l2 < b.l2 { -1 } else { 1 } }
  if a.l1 != b.l1 { return if a.l1 < b.l1 { -1 } else { 1 } }
  if a.l0 != b.l0 { return if a.l0 < b.l0 { -1 } else { 1 } }
  0
}

fn i128_cmp(a : I128, b : I128) -> Int {
  let az = i128_is_zero(a)
  let bz = i128_is_zero(b)
  if az && bz {
    return 0
  }
  if a.neg && !b.neg {
    return -1
  }
  if !a.neg && b.neg {
    return 1
  }
  let c = i128_cmp_mag(a, b)
  if a.neg { 0 - c } else { c }
}

fn i128_eq(a : I128, b : I128) -> Bool {
  i128_cmp(a, b) == 0
}

fn i128_neg(a : I128) -> Option[I128] {
  if i128_is_zero(a) {
    return Some(i128_zero())
  }
  i128_make(!a.neg, a.l0, a.l1, a.l2, a.l3, a.l4)
}

fn i128_abs(a : I128) -> Option[I128] {
  if !a.neg {
    return Some(a)
  }
  i128_make(false, a.l0, a.l1, a.l2, a.l3, a.l4)
}

fn i128_add_mag(neg : Bool, a : I128, b : I128) -> Option[I128] {
  let s0 = a.l0 + b.l0
  let c0 = s0 >> LIMB_BITS
  let r0 = s0 & LIMB_MASK
  let s1 = a.l1 + b.l1 + c0
  let c1 = s1 >> LIMB_BITS
  let r1 = s1 & LIMB_MASK
  let s2 = a.l2 + b.l2 + c1
  let c2 = s2 >> LIMB_BITS
  let r2 = s2 & LIMB_MASK
  let s3 = a.l3 + b.l3 + c2
  let c3 = s3 >> LIMB_BITS
  let r3 = s3 & LIMB_MASK
  let r4 = a.l4 + b.l4 + c3
  i128_make(neg, r0, r1, r2, r3, r4)
}

///| Assumes |a| >= |b|.
fn i128_sub_mag(neg : Bool, a : I128, b : I128) -> I128 {
  let mut d0 = a.l0 - b.l0
  let mut borrow = 0L
  if d0 < 0L {
    d0 = d0 + LIMB_BASE
    borrow = 1L
  }
  let mut d1 = a.l1 - b.l1 - borrow
  borrow = 0L
  if d1 < 0L {
    d1 = d1 + LIMB_BASE
    borrow = 1L
  }
  let mut d2 = a.l2 - b.l2 - borrow
  borrow = 0L
  if d2 < 0L {
    d2 = d2 + LIMB_BASE
    borrow = 1L
  }
  let mut d3 = a.l3 - b.l3 - borrow
  borrow = 0L
  if d3 < 0L {
    d3 = d3 + LIMB_BASE
    borrow = 1L
  }
  let d4 = a.l4 - b.l4 - borrow
  if d0 == 0L && d1 == 0L && d2 == 0L && d3 == 0L && d4 == 0L {
    i128_zero()
  } else {
    I128::{ neg: neg, l0: d0, l1: d1, l2: d2, l3: d3, l4: d4 }
  }
}

fn i128_add(a : I128, b : I128) -> Option[I128] {
  if a.neg == b.neg {
    return i128_add_mag(a.neg, a, b)
  }
  let c = i128_cmp_mag(a, b)
  if c == 0 {
    return Some(i128_zero())
  }
  if c > 0 {
    Some(i128_sub_mag(a.neg, a, b))
  } else {
    Some(i128_sub_mag(b.neg, b, a))
  }
}

fn i128_sub(a : I128, b : I128) -> Option[I128] {
  let bneg = I128::{ neg: !b.neg, l0: b.l0, l1: b.l1, l2: b.l2, l3: b.l3, l4: b.l4 }
  i128_add(a, bneg)
}

fn i128_mul(a : I128, b : I128) -> Option[I128] {
  if i128_is_zero(a) || i128_is_zero(b) {
    return Some(i128_zero())
  }
  let al = [a.l0, a.l1, a.l2, a.l3, a.l4]
  let bl = [b.l0, b.l1, b.l2, b.l3, b.l4]
  let prod = [0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L]
  let mut i = 0
  while i < 5 {
    if al[i] != 0L {
      let mut j = 0
      while j < 5 {
        if bl[j] != 0L {
          let p = al[i] * bl[j]
          let k = i + j
          let lo = p & LIMB_MASK
          let hi = p >> LIMB_BITS
          prod[k] = prod[k] + lo
          prod[k + 1] = prod[k + 1] + hi
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  let mut carry = 0L
  let mut k = 0
  while k < 10 {
    let s = prod[k] + carry
    prod[k] = s & LIMB_MASK
    carry = s >> LIMB_BITS
    k = k + 1
  }
  if carry != 0L || prod[5] != 0L || prod[6] != 0L || prod[7] != 0L || prod[8] != 0L || prod[9] != 0L {
    return None
  }
  let neg = a.neg != b.neg
  i128_make(neg, prod[0], prod[1], prod[2], prod[3], prod[4])
}

///| Extract bit `bit_idx` (0..127) of magnitude of `a`.
fn i128_get_bit(a : I128, bit_idx : Int) -> Int64 {
  let limb_idx = bit_idx / LIMB_BITS
  let offset = bit_idx % LIMB_BITS
  let limb = if limb_idx == 0 {
    a.l0
  } else if limb_idx == 1 {
    a.l1
  } else if limb_idx == 2 {
    a.l2
  } else if limb_idx == 3 {
    a.l3
  } else {
    a.l4
  }
  (limb >> offset) & 1L
}

fn i128_shl1_add(a : I128, bit : Int64) -> I128 {
  let s0 = (a.l0 << 1) | bit
  let c0 = s0 >> LIMB_BITS
  let r0 = s0 & LIMB_MASK
  let s1 = (a.l1 << 1) | c0
  let c1 = s1 >> LIMB_BITS
  let r1 = s1 & LIMB_MASK
  let s2 = (a.l2 << 1) | c1
  let c2 = s2 >> LIMB_BITS
  let r2 = s2 & LIMB_MASK
  let s3 = (a.l3 << 1) | c2
  let c3 = s3 >> LIMB_BITS
  let r3 = s3 & LIMB_MASK
  let r4 = (a.l4 << 1) | c3
  I128::{ neg: false, l0: r0, l1: r1, l2: r2, l3: r3, l4: r4 }
}

///| Unsigned division of magnitudes: returns `(q_mag, r_mag)`. Assumes `b != 0`.
fn i128_divmod_mag(a : I128, b : I128) -> (I128, I128) {
  let am = I128::{ neg: false, l0: a.l0, l1: a.l1, l2: a.l2, l3: a.l3, l4: a.l4 }
  let bm = I128::{ neg: false, l0: b.l0, l1: b.l1, l2: b.l2, l3: b.l3, l4: b.l4 }
  if i128_cmp_mag(am, bm) < 0 {
    return (i128_zero(), am)
  }
  let mut q = i128_zero()
  let mut r = i128_zero()
  let mut bit = 127
  while bit >= 0 {
    r = i128_shl1_add(r, i128_get_bit(am, bit))
    if i128_cmp_mag(r, bm) >= 0 {
      r = i128_sub_mag(false, r, bm)
      q = i128_shl1_add(q, 1L)
    } else {
      q = i128_shl1_add(q, 0L)
    }
    bit = bit - 1
  }
  (q, r)
}

///| Python/MiniJinja floor division and modulo on `I128`. Returns `None` on div-by-zero or overflow.
fn i128_floor_divmod(a : I128, b : I128) -> Option[(I128, I128)] {
  if i128_is_zero(b) {
    return None
  }
  let (qm, rm) = i128_divmod_mag(a, b)
  let q_neg = a.neg != b.neg
  let r_zero = i128_is_zero(rm)
  if !r_zero && q_neg {
    // Floor towards -infinity: q = -(qm + 1), r = |b| - rm with sign of b
    let one = i128_from_i64(1L)
    match i128_add_mag(true, qm, one) {
      Some(q) => {
        let r = i128_sub_mag(b.neg, b, rm)
        Some((q, r))
      }
      None => None
    }
  } else {
    match i128_make(q_neg, qm.l0, qm.l1, qm.l2, qm.l3, qm.l4) {
      Some(q) => {
        let r = if r_zero {
          i128_zero()
        } else {
          I128::{ neg: a.neg, l0: rm.l0, l1: rm.l1, l2: rm.l2, l3: rm.l3, l4: rm.l4 }
        }
        Some((q, r))
      }
      None => None
    }
  }
}

///| Divide magnitude by small positive `d` (`1 <= d <= 1_000_000_000`). Returns `(quotient, rem)`.
fn i128_div_small(a : I128, d : Int64) -> (I128, Int64) {
  let mut rem = 0L
  let n4 = rem * LIMB_BASE + a.l4
  let q4 = n4 / d
  rem = n4 % d
  let n3 = rem * LIMB_BASE + a.l3
  let q3 = n3 / d
  rem = n3 % d
  let n2 = rem * LIMB_BASE + a.l2
  let q2 = n2 / d
  rem = n2 % d
  let n1 = rem * LIMB_BASE + a.l1
  let q1 = n1 / d
  rem = n1 % d
  let n0 = rem * LIMB_BASE + a.l0
  let q0 = n0 / d
  rem = n0 % d
  (I128::{ neg: false, l0: q0, l1: q1, l2: q2, l3: q3, l4: q4 }, rem)
}

fn i128_to_string(a : I128) -> String {
  if i128_is_zero(a) {
    return "0"
  }
  match i128_to_i64_opt(a) {
    Some(n) => return n.to_string()
    None => ()
  }
  let chunks : Array[Int64] = []
  let mut cur = I128::{ neg: false, l0: a.l0, l1: a.l1, l2: a.l2, l3: a.l3, l4: a.l4 }
  while !i128_is_zero(cur) {
    let (q, rem) = i128_div_small(cur, 1000000000L)
    chunks.push(rem)
    cur = q
  }
  let sb = StringBuilder::new()
  if a.neg {
    sb.write_byte((45).to_byte())
  }
  let mut i = chunks.length() - 1
  sb.write_string(chunks[i].to_string())
  i = i - 1
  while i >= 0 {
    let cs = chunks[i].to_string()
    let mut pad = 9 - cs.length()
    while pad > 0 {
      sb.write_byte((48).to_byte())
      pad = pad - 1
    }
    sb.write_string(cs)
    i = i - 1
  }
  sb.to_string()
}

///| Multiply non-negative `I128` by small radix (`<= 16`) and add `digit`.
fn i128_mul_add_small(a : I128, radix : Int64, digit : Int64) -> Option[I128] {
  let s0 = a.l0 * radix + digit
  let c0 = s0 >> LIMB_BITS
  let r0 = s0 & LIMB_MASK
  let s1 = a.l1 * radix + c0
  let c1 = s1 >> LIMB_BITS
  let r1 = s1 & LIMB_MASK
  let s2 = a.l2 * radix + c1
  let c2 = s2 >> LIMB_BITS
  let r2 = s2 & LIMB_MASK
  let s3 = a.l3 * radix + c2
  let c3 = s3 >> LIMB_BITS
  let r3 = s3 & LIMB_MASK
  let r4 = a.l4 * radix + c3
  i128_make(false, r0, r1, r2, r3, r4)
}

///| Helper to construct a `Value` from `I128`, shrinking to `Int` when it fits `Int64`.
fn value_from_i128(a : I128) -> Value {
  match i128_to_i64_opt(a) {
    Some(n) => Value::from_i64(n)
    None => Value::{ kind: ValueKind::BigInt(a) }
  }
}

///| Checked `Int64` addition with automatic `I128` promotion.
fn checked_add_i64(a : Int64, b : Int64) -> Option[Value] {
  if (b > 0L && a > I64_MAX - b) || (b < 0L && a < I64_MIN - b) {
    match i128_add(i128_from_i64(a), i128_from_i64(b)) {
      Some(r) => Some(value_from_i128(r))
      None => None
    }
  } else {
    Some(Value::from_i64(a + b))
  }
}

///| Checked `Int64` subtraction with automatic `I128` promotion.
fn checked_sub_i64(a : Int64, b : Int64) -> Option[Value] {
  if (b < 0L && a > I64_MAX + b) || (b > 0L && a < I64_MIN + b) {
    match i128_sub(i128_from_i64(a), i128_from_i64(b)) {
      Some(r) => Some(value_from_i128(r))
      None => None
    }
  } else {
    Some(Value::from_i64(a - b))
  }
}

///| Checked `Int64` multiplication with automatic `I128` promotion.
fn checked_mul_i64(a : Int64, b : Int64) -> Option[Value] {
  if a == 0L || b == 0L {
    return Some(Value::from_i64(0L))
  }
  // Fast path: both fit in signed 31-bit so product fits comfortably in Int64
  if a >= -2147483648L && a <= 2147483647L && b >= -2147483648L && b <= 2147483647L {
    return Some(Value::from_i64(a * b))
  }
  match i128_mul(i128_from_i64(a), i128_from_i64(b)) {
    Some(r) => Some(value_from_i128(r))
    None => None
  }
}

// ---------------------------------------------------------------------------
// UTF-8 codepoint string utilities
// ---------------------------------------------------------------------------

///| Byte length of a UTF-8 sequence given its leading byte.
fn utf8_char_len(b : Int) -> Int {
  if b < 128 {
    1
  } else if (b & 0xE0) == 0xC0 {
    2
  } else if (b & 0xF0) == 0xE0 {
    3
  } else if (b & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

///| Decode a UTF-8 codepoint starting at byte offset `pos`. Returns `(codepoint, byte_len)`.
fn utf8_decode_at(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  let b0 = s.code_unit_at(pos)
  if b0 < 128 {
    return (b0, 1)
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
    }
  }
  if (b0 & 0xF0) == 0xE0 && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
    }
  }
  if (b0 & 0xF8) == 0xF0 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (
        ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
        4,
      )
    }
  }
  (b0, 1)
}

///| Write a Unicode scalar value `cp` as UTF-8 bytes into `sb`.
fn utf8_write_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Count UTF-8 codepoints in `s`.
fn utf8_codepoint_count(s : String) -> Int {
  let n = s.length()
  let mut count = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      i = i + 1
    } else {
      let clen = utf8_char_len(b)
      i = if i + clen <= n { i + clen } else { n }
    }
    count = count + 1
  }
  count
}

///| Collect starting byte offsets of every UTF-8 codepoint in `s`, with trailing `s.length()`.
fn utf8_char_offsets(s : String) -> Array[Int] {
  let n = s.length()
  let offsets : Array[Int] = []
  let mut i = 0
  while i < n {
    offsets.push(i)
    let clen = utf8_char_len(s.code_unit_at(i))
    i = if i + clen <= n { i + clen } else { n }
  }
  offsets.push(n)
  offsets
}

///| Index into `s` by UTF-8 codepoint (supports negative indices).
fn utf8_char_at(s : String, idx : Int) -> Option[String] {
  let n = s.length()
  // Fast path: check if pure ASCII when idx >= 0 and small
  let offsets = utf8_char_offsets(s)
  let count = offsets.length() - 1
  let actual = if idx < 0 { count + idx } else { idx }
  if actual >= 0 && actual < count {
    let _ = n
    Some(s.slice(offsets[actual], offsets[actual + 1]))
  } else {
    None
  }
}

///| Slice `s` by UTF-8 codepoint indices with arbitrary non-zero step.
fn utf8_slice(
  s : String,
  start_opt : Option[Int],
  stop_opt : Option[Int],
  step : Int,
) -> String {
  let offsets = utf8_char_offsets(s)
  let count = offsets.length() - 1
  let sb = StringBuilder::new()
  if step > 0 {
    let mut st = match start_opt {
      Some(x) => if x < 0 { count + x } else { x }
      None => 0
    }
    let mut en = match stop_opt {
      Some(x) => if x < 0 { count + x } else { x }
      None => count
    }
    if st < 0 { st = 0 }
    if st > count { st = count }
    if en < 0 { en = 0 }
    if en > count { en = count }
    if step == 1 {
      if st < en {
        return s.slice(offsets[st], offsets[en])
      }
      return ""
    }
    let mut i = st
    while i < en {
      sb.write_substring(s, offsets[i], offsets[i + 1])
      i = i + step
    }
  } else {
    let mut st = match start_opt {
      Some(x) => if x < 0 { count + x } else { x }
      None => count - 1
    }
    let mut en = match stop_opt {
      Some(x) => if x < 0 { count + x } else { x }
      None => -1
    }
    if st >= count { st = count - 1 }
    if st < -1 { st = -1 }
    if en >= count { en = count - 1 }
    if en < -1 { en = -1 }
    let mut i = st
    while i > en {
      sb.write_substring(s, offsets[i], offsets[i + 1])
      i = i + step
    }
  }
  sb.to_string()
}

///| Reverse `s` by UTF-8 codepoints (never splits multi-byte sequences).
fn utf8_reverse(s : String) -> String {
  let offsets = utf8_char_offsets(s)
  let count = offsets.length() - 1
  let sb = StringBuilder::with_capacity(s.length())
  let mut i = count - 1
  while i >= 0 {
    sb.write_substring(s, offsets[i], offsets[i + 1])
    i = i - 1
  }
  sb.to_string()
}

///| First UTF-8 codepoint of `s`.
fn utf8_first(s : String) -> Option[String] {
  if s.length() == 0 {
    return None
  }
  let clen = utf8_char_len(s.code_unit_at(0))
  let end = if clen <= s.length() { clen } else { s.length() }
  Some(s.slice(0, end))
}

///| Last UTF-8 codepoint of `s`.
fn utf8_last(s : String) -> Option[String] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = n - 1
  while i > 0 && (s.code_unit_at(i) & 0xC0) == 0x80 {
    i = i - 1
  }
  Some(s.slice(i, n))
}

///| Unicode-aware uppercase mapping for common Latin / Greek / Cyrillic codepoints.
fn write_cp_upper(sb : StringBuilder, cp : Int) -> Unit {
  if cp >= 97 && cp <= 122 {
    sb.write_byte((cp - 32).to_byte())
  } else if cp == 0x00DF {
    // German sharp s -> SS
    sb.write_string("SS")
  } else if (cp >= 0x00E0 && cp <= 0x00F6) || (cp >= 0x00F8 && cp <= 0x00FE) {
    utf8_write_cp(sb, cp - 32)
  } else if cp == 0x00FF {
    utf8_write_cp(sb, 0x0178)
  } else if cp >= 0x0100 && cp <= 0x0177 {
    if (cp & 1) == 1 && cp != 0x0131 && cp != 0x0138 && cp != 0x0149 {
      utf8_write_cp(sb, cp - 1)
    } else {
      utf8_write_cp(sb, cp)
    }
  } else if cp >= 0x03B1 && cp <= 0x03C9 {
    utf8_write_cp(sb, cp - 32)
  } else if cp >= 0x0430 && cp <= 0x044F {
    utf8_write_cp(sb, cp - 32)
  } else {
    utf8_write_cp(sb, cp)
  }
}

///| Unicode-aware lowercase mapping for common Latin / Greek / Cyrillic codepoints.
fn write_cp_lower(sb : StringBuilder, cp : Int) -> Unit {
  if cp >= 65 && cp <= 90 {
    sb.write_byte((cp + 32).to_byte())
  } else if (cp >= 0x00C0 && cp <= 0x00D6) || (cp >= 0x00D8 && cp <= 0x00DE) {
    utf8_write_cp(sb, cp + 32)
  } else if cp == 0x0178 {
    utf8_write_cp(sb, 0x00FF)
  } else if cp >= 0x0100 && cp <= 0x0177 {
    if (cp & 1) == 0 && cp != 0x0130 {
      utf8_write_cp(sb, cp + 1)
    } else {
      utf8_write_cp(sb, cp)
    }
  } else if cp >= 0x0391 && cp <= 0x03A9 {
    utf8_write_cp(sb, cp + 32)
  } else if cp >= 0x0410 && cp <= 0x042F {
    utf8_write_cp(sb, cp + 32)
  } else {
    utf8_write_cp(sb, cp)
  }
}

fn utf8_to_upper(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      sb.write_byte((if b >= 97 && b <= 122 { b - 32 } else { b }).to_byte())
      i = i + 1
    } else {
      let (cp, clen) = utf8_decode_at(s, i)
      write_cp_upper(sb, cp)
      i = i + clen
    }
  }
  sb.to_string()
}

fn utf8_to_lower(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      sb.write_byte((if b >= 65 && b <= 90 { b + 32 } else { b }).to_byte())
      i = i + 1
    } else {
      let (cp, clen) = utf8_decode_at(s, i)
      write_cp_lower(sb, cp)
      i = i + clen
    }
  }
  sb.to_string()
}

fn is_title_sep(cp : Int) -> Bool {
  cp == 32 || cp == 9 || cp == 10 || cp == 13 || cp == 45 || cp == 95 || cp == 47 || cp == 44 || cp == 46 || cp == 58 || cp == 59 || cp == 33 || cp == 63
}

fn utf8_to_title(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut capitalize_next = true
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      if is_title_sep(b) {
        capitalize_next = true
        sb.write_byte(b.to_byte())
      } else if capitalize_next {
        sb.write_byte((if b >= 97 && b <= 122 { b - 32 } else { b }).to_byte())
        capitalize_next = false
      } else {
        sb.write_byte((if b >= 65 && b <= 90 { b + 32 } else { b }).to_byte())
      }
      i = i + 1
    } else {
      let (cp, clen) = utf8_decode_at(s, i)
      if is_title_sep(cp) {
        capitalize_next = true
        utf8_write_cp(sb, cp)
      } else if capitalize_next {
        write_cp_upper(sb, cp)
        capitalize_next = false
      } else {
        write_cp_lower(sb, cp)
      }
      i = i + clen
    }
  }
  sb.to_string()
}

fn utf8_capitalize(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::with_capacity(n)
  let b0 = s.code_unit_at(0)
  let mut i = if b0 < 128 {
    sb.write_byte((if b0 >= 97 && b0 <= 122 { b0 - 32 } else { b0 }).to_byte())
    1
  } else {
    let (cp0, clen0) = utf8_decode_at(s, 0)
    write_cp_upper(sb, cp0)
    clen0
  }
  while i < n {
    let b = s.code_unit_at(i)
    if b < 128 {
      sb.write_byte((if b >= 65 && b <= 90 { b + 32 } else { b }).to_byte())
      i = i + 1
    } else {
      let (cp, clen) = utf8_decode_at(s, i)
      write_cp_lower(sb, cp)
      i = i + clen
    }
  }
  sb.to_string()
}
