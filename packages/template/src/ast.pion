///| AST definitions for compiled Jinja2/MiniJinja templates.

///|
enum UnaryOp {
  Neg
  Pos
  Not
}

///|
enum BinOp {
  Add
  Sub
  Mul
  Div
  FloorDiv
  Rem
  Pow
  Concat
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  In
  NotIn
  And
  Or
}

///| Call argument: positional or keyword (`name=expr`).
struct CallArg {
  name : Option[String]
  expr : Expr
}

///| Expression AST node with source position.
enum Expr {
  Const(Value, Int, Int)
  Var(String, Int, Int)
  List(Array[Expr], Int, Int)
  Map(Array[(Expr, Expr)], Int, Int)
  Unary(UnaryOp, Expr, Int, Int)
  Bin(BinOp, Expr, Expr, Int, Int)
  IfExpr(Expr, Expr, Option[Expr], Int, Int)
  GetAttr(Expr, String, Int, Int)
  GetItem(Expr, Expr, Int, Int)
  Slice(Expr, Option[Expr], Option[Expr], Option[Expr], Int, Int)
  Filter(Expr, String, Array[CallArg], Int, Int)
  Test(Expr, String, Array[CallArg], Bool, Int, Int)
  Call(Expr, Array[CallArg], Int, Int)
}

///| Assignment target for `{% set ... %}`.
enum SetTarget {
  Var(String)
  Attr(String, String)
}

///| Macro definition.
struct MacroDef {
  name : String
  params : Array[(String, Option[Expr])]
  body : Array[Stmt]
  line : Int
  col : Int
}

///| Statement AST node.
enum Stmt {
  EmitRaw(String)
  EmitExpr(Expr, Int, Int)
  If(Array[(Expr, Array[Stmt])], Array[Stmt], Int, Int)
  For(Array[String], Expr, Option[Expr], Array[Stmt], Array[Stmt], Int, Int)
  Set(SetTarget, Expr, Int, Int)
  SetBlock(String, Option[(String, Array[CallArg])], Array[Stmt], Int, Int)
  With(Array[(String, Expr)], Array[Stmt], Int, Int)
  FilterBlock(String, Array[CallArg], Array[Stmt], Int, Int)
  Block(String, Array[Stmt], Int, Int)
  Extends(Expr, Int, Int)
  Include(Expr, Bool, Int, Int)
  Macro(MacroDef)
  CallBlock(Expr, Array[CallArg], Array[String], Array[Stmt], Int, Int)
  Import(Expr, String, Int, Int)
  FromImport(Expr, Array[(String, String)], Int, Int)
  AutoEscapeBlock(Expr, Array[Stmt], Int, Int)
  Do(Expr, Int, Int)
}

///| Pre-compiled template AST.
struct CompiledTemplate {
  name : String
  body : Array[Stmt]
  blocks : Array[(String, Array[Stmt])]
  has_extends : Bool
}
