///| Lexer for Jinja2/MiniJinja templates and expressions.
///| Tracks 1-based line and column numbers for accurate error diagnostics.

///|
enum TokKind {
  TemplateData(String)
  VarStart
  VarEnd
  BlockStart
  BlockEnd
  Ident(String)
  Str(String)
  IntLit(Int64)
  FloatLit(Double)
  Plus
  Minus
  Mul
  Div
  FloorDiv
  Mod
  Pow
  Tilde
  Pipe
  Dot
  Comma
  Colon
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  Assign
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  Eof
}

///|
struct Token {
  kind : TokKind
  line : Int
  col : Int
}

///|
struct LexConfig {
  keep_trailing_newline : Bool
  trim_blocks : Bool
  lstrip_blocks : Bool
}

fn is_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

fn is_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}

fn is_ident_cont(b : Int) -> Bool {
  is_ident_start(b) || (b >= 48 && b <= 57)
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    b - 87
  }
}

///| Trim trailing whitespace from a string.
fn rtrim_ws(s : String) -> String {
  let mut end = s.length()
  while end > 0 && is_ws(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  if end == s.length() {
    s
  } else {
    s.slice(0, end)
  }
}

///| Strip trailing horizontal spaces/tabs after the last newline (for `lstrip_blocks`).
fn lstrip_block_tail(s : String) -> String {
  let n = s.length()
  let mut i = n
  while i > 0 {
    let b = s.code_unit_at(i - 1)
    if b == 32 || b == 9 {
      i = i - 1
    } else if b == 10 {
      return s.slice(0, i)
    } else {
      return s
    }
  }
  // Start of file with only spaces/tabs
  if i == 0 {
    ""
  } else {
    s
  }
}

///| Strip a single trailing `\n` or `\r\n` if `!keep_trailing_newline`.
fn normalize_source(src : String, keep_trailing_newline : Bool) -> String {
  if keep_trailing_newline {
    return src
  }
  let n = src.length()
  if n >= 2 &&
  src.code_unit_at(n - 2) == 13 &&
  src.code_unit_at(n - 1) == 10 {
    src.slice(0, n - 2)
  } else if n >= 1 && src.code_unit_at(n - 1) == 10 {
    src.slice(0, n - 1)
  } else {
    src
  }
}

struct Lexer {
  src : String
  len : Int
  name : Option[String]
  cfg : LexConfig
  mut pos : Int
  mut line : Int
  mut col : Int
}

fn Lexer::new(
  src : String,
  name : Option[String],
  cfg : LexConfig,
) -> Lexer {
  Lexer::{ src: src, len: src.length(), name: name, cfg: cfg, pos: 0, line: 1, col: 1 }
}

fn Lexer::err(self : Lexer, msg : String, line : Int, col : Int) -> TemplateError {
  TemplateError::new(ErrorKind::SyntaxError, msg, self.name, line, col)
}

fn Lexer::advance(self : Lexer) -> Int {
  let b = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  if b == 10 {
    self.line = self.line + 1
    self.col = 1
  } else {
    self.col = self.col + 1
  }
  b
}

fn Lexer::advance_n(self : Lexer, count : Int) -> Unit {
  let mut i = 0
  while i < count && self.pos < self.len {
    let _ = self.advance()
    i = i + 1
  }
}

fn Lexer::peek_at(self : Lexer, offset : Int) -> Int {
  let idx = self.pos + offset
  if idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Lexer::skip_ws_all(self : Lexer) -> Unit {
  while self.pos < self.len && is_ws(self.src.code_unit_at(self.pos)) {
    let _ = self.advance()
  }
}

fn Lexer::skip_one_newline(self : Lexer) -> Unit {
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 13 && self.peek_at(1) == 10 {
      self.advance_n(2)
    } else if b == 10 {
      let _ = self.advance()
    }
  }
}

///| Lex a string literal starting at `quote` (`'` or `"`).
fn Lexer::lex_string(self : Lexer) -> Result[Token, TemplateError] {
  let start_line = self.line
  let start_col = self.col
  let quote = self.advance()
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.advance()
    if b == quote {
      return Ok(Token::{ kind: TokKind::Str(sb.to_string()), line: start_line, col: start_col })
    }
    if b == 92 {
      if self.pos >= self.len {
        return Err(self.err("unterminated escape sequence", start_line, start_col))
      }
      let esc = self.advance()
      if esc == 110 {
        sb.write_byte((10).to_byte())
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
      } else if esc == 39 {
        sb.write_byte((39).to_byte())
      } else if esc == 34 {
        sb.write_byte((34).to_byte())
      } else if esc == 48 {
        sb.write_byte((0).to_byte())
      } else if esc == 120 {
        if self.pos + 2 > self.len {
          return Err(self.err("invalid \\x escape", self.line, self.col))
        }
        let h1 = self.advance()
        let h2 = self.advance()
        if !is_hex_digit(h1) || !is_hex_digit(h2) {
          return Err(self.err("invalid hex in \\x escape", self.line, self.col))
        }
        sb.write_byte(((hex_val(h1) << 4) | hex_val(h2)).to_byte())
      } else {
        sb.write_byte(esc.to_byte())
      }
    } else {
      sb.write_byte(b.to_byte())
    }
  }
  Err(self.err("unterminated string literal", start_line, start_col))
}

///| Lex an integer or float literal.
fn Lexer::lex_number(self : Lexer) -> Result[Token, TemplateError] {
  let start_line = self.line
  let start_col = self.col
  // Hex / Octal / Binary
  if self.peek_at(0) == 48 {
    let p1 = self.peek_at(1)
    if p1 == 120 || p1 == 88 {
      self.advance_n(2)
      let mut item_val = 0L
      let mut digits = 0
      while self.pos < self.len {
        let b = self.peek_at(0)
        if b == 95 {
          let _ = self.advance()
        } else if is_hex_digit(b) {
          item_val = item_val * 16L + hex_val(b).to_int64()
          digits = digits + 1
          let _ = self.advance()
        } else {
          break
        }
      }
      if digits == 0 {
        return Err(self.err("invalid hex literal", start_line, start_col))
      }
      return Ok(Token::{ kind: TokKind::IntLit(item_val), line: start_line, col: start_col })
    }
    if p1 == 111 || p1 == 79 {
      self.advance_n(2)
      let mut item_val = 0L
      let mut digits = 0
      while self.pos < self.len {
        let b = self.peek_at(0)
        if b == 95 {
          let _ = self.advance()
        } else if b >= 48 && b <= 55 {
          item_val = item_val * 8L + (b - 48).to_int64()
          digits = digits + 1
          let _ = self.advance()
        } else {
          break
        }
      }
      if digits == 0 {
        return Err(self.err("invalid octal literal", start_line, start_col))
      }
      return Ok(Token::{ kind: TokKind::IntLit(item_val), line: start_line, col: start_col })
    }
    if p1 == 98 || p1 == 66 {
      self.advance_n(2)
      let mut item_val = 0L
      let mut digits = 0
      while self.pos < self.len {
        let b = self.peek_at(0)
        if b == 95 {
          let _ = self.advance()
        } else if b == 48 || b == 49 {
          item_val = item_val * 2L + (b - 48).to_int64()
          digits = digits + 1
          let _ = self.advance()
        } else {
          break
        }
      }
      if digits == 0 {
        return Err(self.err("invalid binary literal", start_line, start_col))
      }
      return Ok(Token::{ kind: TokKind::IntLit(item_val), line: start_line, col: start_col })
    }
  }

  let sb = StringBuilder::new()
  let mut is_float = false
  let mut int_val = 0L
  while self.pos < self.len {
    let b = self.peek_at(0)
    if b == 95 {
      let _ = self.advance()
    } else if is_digit(b) {
      int_val = int_val * 10L + (b - 48).to_int64()
      sb.write_byte(b.to_byte())
      let _ = self.advance()
    } else {
      break
    }
  }
  if self.peek_at(0) == 46 && is_digit(self.peek_at(1)) {
    is_float = true
    sb.write_byte((46).to_byte())
    let _ = self.advance()
    while self.pos < self.len {
      let b = self.peek_at(0)
      if b == 95 {
        let _ = self.advance()
      } else if is_digit(b) {
        sb.write_byte(b.to_byte())
        let _ = self.advance()
      } else {
        break
      }
    }
  }
  let pe = self.peek_at(0)
  if pe == 101 || pe == 69 {
    is_float = true
    sb.write_byte(pe.to_byte())
    let _ = self.advance()
    let ps = self.peek_at(0)
    if ps == 43 || ps == 45 {
      sb.write_byte(ps.to_byte())
      let _ = self.advance()
    }
    let mut exp_digits = 0
    while self.pos < self.len {
      let b = self.peek_at(0)
      if b == 95 {
        let _ = self.advance()
      } else if is_digit(b) {
        sb.write_byte(b.to_byte())
        exp_digits = exp_digits + 1
        let _ = self.advance()
      } else {
        break
      }
    }
    if exp_digits == 0 {
      return Err(self.err("invalid float exponent", start_line, start_col))
    }
  }
  if is_float {
    match parse_double_str(sb.to_string()) {
      Some(f) =>
      Ok(Token::{ kind: TokKind::FloatLit(f), line: start_line, col: start_col })
      None => Err(self.err("invalid float literal", start_line, start_col))
    }
  } else {
    Ok(Token::{ kind: TokKind::IntLit(int_val), line: start_line, col: start_col })
  }
}

///| Parse decimal float string into `Option[Double]`.
fn parse_double_str(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if s.code_unit_at(i) == 43 {
    i = i + 1
  }
  let mut int_part = 0.0
  let mut has_digits = false
  while i < n && is_digit(s.code_unit_at(i)) {
    int_part = int_part * 10.0 + (s.code_unit_at(i) - 48).to_double()
    has_digits = true
    i = i + 1
  }
  let mut frac_part = 0.0
  let mut frac_scale = 1.0
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    while i < n && is_digit(s.code_unit_at(i)) {
      frac_part = frac_part * 10.0 + (s.code_unit_at(i) - 48).to_double()
      frac_scale = frac_scale * 10.0
      has_digits = true
      i = i + 1
    }
  }
  if !has_digits {
    return None
  }
  let mut item_val = int_part + frac_part / frac_scale
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let mut exp = 0
    let mut exp_digits = 0
    while i < n && is_digit(s.code_unit_at(i)) {
      if exp < 1000 {
        exp = exp * 10 + (s.code_unit_at(i) - 48)
      }
      exp_digits = exp_digits + 1
      i = i + 1
    }
    if exp_digits == 0 {
      return None
    }
    let mut p = 1.0
    let mut k = 0
    while k < exp {
      p = p * 10.0
      k = k + 1
    }
    if exp_neg {
      item_val = item_val / p
    } else {
      item_val = item_val * p
    }
  }
  if i != n {
    return None
  }
  Some(if neg { 0.0 - item_val } else { item_val })
}

///| Lex expression tokens until `end_c1`+`end_c2` (e.g. `}}` or `%}`), or EOF if `end_c1 == 0`.
///| Returns `Ok(trim_right)` indicating whether `-}}` / `-%}` was seen.
fn Lexer::lex_expr_tokens(
  self : Lexer,
  tokens : Array[Token],
  end_c1 : Int,
  end_c2 : Int,
) -> Result[Bool, TemplateError] {
  while self.pos < self.len {
    self.skip_ws_all()
    if self.pos >= self.len {
      if end_c1 == 0 {
        return Ok(false)
      }
      return Err(self.err("unexpected end of template inside tag", self.line, self.col))
    }
    let line = self.line
    let col = self.col
    let b0 = self.peek_at(0)
    let b1 = self.peek_at(1)
    let b2 = self.peek_at(2)

    if end_c1 != 0 {
      // Check `-}}` or `-%}`
      if b0 == 45 && b1 == end_c1 && b2 == end_c2 {
        self.advance_n(3)
        let end_tok = if end_c1 == 125 { TokKind::VarEnd } else { TokKind::BlockEnd }
        tokens.push(Token::{ kind: end_tok, line: line, col: col })
        return Ok(true)
      }
      if b0 == end_c1 && b1 == end_c2 {
        self.advance_n(2)
        let end_tok = if end_c1 == 125 { TokKind::VarEnd } else { TokKind::BlockEnd }
        tokens.push(Token::{ kind: end_tok, line: line, col: col })
        return Ok(false)
      }
    }

    if b0 == 39 || b0 == 34 {
      match self.lex_string() {
        Ok(tok) => tokens.push(tok)
        Err(e) => return Err(e)
      }
    } else if is_digit(b0) {
      match self.lex_number() {
        Ok(tok) => tokens.push(tok)
        Err(e) => return Err(e)
      }
    } else if is_ident_start(b0) {
      let start = self.pos
      while self.pos < self.len && is_ident_cont(self.peek_at(0)) {
        let _ = self.advance()
      }
      let ident = self.src.slice(start, self.pos)
      tokens.push(Token::{ kind: TokKind::Ident(ident), line: line, col: col })
    } else if b0 == 61 && b1 == 61 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::Eq, line: line, col: col })
    } else if b0 == 33 && b1 == 61 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::Ne, line: line, col: col })
    } else if b0 == 60 && b1 == 61 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::Le, line: line, col: col })
    } else if b0 == 62 && b1 == 61 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::Ge, line: line, col: col })
    } else if b0 == 47 && b1 == 47 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::FloorDiv, line: line, col: col })
    } else if b0 == 42 && b1 == 42 {
      self.advance_n(2)
      tokens.push(Token::{ kind: TokKind::Pow, line: line, col: col })
    } else {
      let _ = self.advance()
      let kind = if b0 == 43 {
        TokKind::Plus
      } else if b0 == 45 {
        TokKind::Minus
      } else if b0 == 42 {
        TokKind::Mul
      } else if b0 == 47 {
        TokKind::Div
      } else if b0 == 37 {
        TokKind::Mod
      } else if b0 == 126 {
        TokKind::Tilde
      } else if b0 == 124 {
        TokKind::Pipe
      } else if b0 == 46 {
        TokKind::Dot
      } else if b0 == 44 {
        TokKind::Comma
      } else if b0 == 58 {
        TokKind::Colon
      } else if b0 == 40 {
        TokKind::LParen
      } else if b0 == 41 {
        TokKind::RParen
      } else if b0 == 91 {
        TokKind::LBracket
      } else if b0 == 93 {
        TokKind::RBracket
      } else if b0 == 123 {
        TokKind::LBrace
      } else if b0 == 125 {
        TokKind::RBrace
      } else if b0 == 61 {
        TokKind::Assign
      } else if b0 == 60 {
        TokKind::Lt
      } else if b0 == 62 {
        TokKind::Gt
      } else {
        return Err(
          self.err(
            "unexpected character in expression",
            line,
            col,
          ),
        )
      }
      tokens.push(Token::{ kind: kind, line: line, col: col })
    }
  }
  if end_c1 == 0 {
    Ok(false)
  } else {
    Err(self.err("unclosed tag", self.line, self.col))
  }
}

///| Check if current position inside `{%` starts a `raw` tag, and if so consume until `{% endraw %}`.
///| Returns `Ok(Some((raw_text, trim_right)))` if it was a raw block, `Ok(None)` otherwise.
fn Lexer::try_lex_raw_block(
  self : Lexer,
) -> Result[Option[(String, Bool)], TemplateError] {
  let saved_pos = self.pos
  let saved_line = self.line
  let saved_col = self.col
  self.skip_ws_all()
  if self.pos + 3 <= self.len &&
  self.src.slice(self.pos, self.pos + 3) == "raw" &&
  (self.pos + 3 == self.len || !is_ident_cont(self.src.code_unit_at(self.pos + 3))) {
    self.advance_n(3)
    self.skip_ws_all()
    let mut trim_after_raw_open = false
    if self.peek_at(0) == 45 && self.peek_at(1) == 37 && self.peek_at(2) == 125 {
      trim_after_raw_open = true
      self.advance_n(3)
    } else if self.peek_at(0) == 37 && self.peek_at(1) == 125 {
      self.advance_n(2)
    } else {
      self.pos = saved_pos
      self.line = saved_line
      self.col = saved_col
      return Ok(None)
    }
    let _ = trim_after_raw_open
    let raw_start = self.pos
    while self.pos < self.len {
      if self.peek_at(0) == 123 && self.peek_at(1) == 37 {
        let tag_start = self.pos
        let mut scan = self.pos + 2
        if scan < self.len && self.src.code_unit_at(scan) == 45 {
          scan = scan + 1
        }
        while scan < self.len && is_ws(self.src.code_unit_at(scan)) {
          scan = scan + 1
        }
        if scan + 6 <= self.len &&
        self.src.slice(scan, scan + 6) == "endraw" &&
        (scan + 6 == self.len || !is_ident_cont(self.src.code_unit_at(scan + 6))) {
          let mut scan2 = scan + 6
          while scan2 < self.len && is_ws(self.src.code_unit_at(scan2)) {
            scan2 = scan2 + 1
          }
          let mut trim_right = false
          if scan2 + 3 <= self.len &&
          self.src.code_unit_at(scan2) == 45 &&
          self.src.code_unit_at(scan2 + 1) == 37 &&
          self.src.code_unit_at(scan2 + 2) == 125 {
            trim_right = true
            scan2 = scan2 + 3
          } else if scan2 + 2 <= self.len &&
          self.src.code_unit_at(scan2) == 37 &&
          self.src.code_unit_at(scan2 + 1) == 125 {
            scan2 = scan2 + 2
          } else {
            let _ = self.advance()
            continue
          }
          let raw_text = self.src.slice(raw_start, tag_start)
          self.advance_n(scan2 - self.pos)
          return Ok(Some((raw_text, trim_right)))
        }
      }
      let _ = self.advance()
    }
    return Err(self.err("unclosed {% raw %} block", saved_line, saved_col))
  }
  self.pos = saved_pos
  self.line = saved_line
  self.col = saved_col
  Ok(None)
}

///| Tokenize a full template source into a stream of `Token`s.
fn lex_template(
  raw_src : String,
  name : Option[String],
  cfg : LexConfig,
) -> Result[Array[Token], TemplateError] {
  let src = normalize_source(raw_src, cfg.keep_trailing_newline)
  let lex = Lexer::new(src, name, cfg)
  let tokens : Array[Token] = []
  let mut pending_trim_leading = false

  while lex.pos < lex.len {
    let text_start = lex.pos
    let text_line = lex.line
    let text_col = lex.col
    while lex.pos < lex.len {
      if lex.peek_at(0) == 123 {
        let p1 = lex.peek_at(1)
        if p1 == 123 || p1 == 37 || p1 == 35 {
          break
        }
      }
      let _ = lex.advance()
    }
    let mut chunk = if lex.pos > text_start {
      lex.src.slice(text_start, lex.pos)
    } else {
      ""
    }
    if pending_trim_leading && chunk.length() > 0 {
      let mut i = 0
      while i < chunk.length() && is_ws(chunk.code_unit_at(i)) {
        i = i + 1
      }
      chunk = chunk.slice(i, chunk.length())
      pending_trim_leading = false
    }

    if lex.pos >= lex.len {
      if chunk.length() > 0 {
        tokens.push(Token::{ kind: TokKind::TemplateData(chunk), line: text_line, col: text_col })
      }
      break
    }

    let tag_line = lex.line
    let tag_col = lex.col
    let p1 = lex.peek_at(1)
    let p2 = lex.peek_at(2)
    let trim_left = p2 == 45

    if trim_left {
      chunk = rtrim_ws(chunk)
    } else if (p1 == 37 || p1 == 35) && cfg.lstrip_blocks {
      chunk = lstrip_block_tail(chunk)
    }

    if chunk.length() > 0 {
      tokens.push(Token::{ kind: TokKind::TemplateData(chunk), line: text_line, col: text_col })
    }

    if p1 == 35 {
      // Comment {# ... #}
      lex.advance_n(if trim_left { 3 } else { 2 })
      let mut closed = false
      let mut trim_right = false
      while lex.pos < lex.len {
        if lex.peek_at(0) == 45 && lex.peek_at(1) == 35 && lex.peek_at(2) == 125 {
          lex.advance_n(3)
          closed = true
          trim_right = true
          break
        }
        if lex.peek_at(0) == 35 && lex.peek_at(1) == 125 {
          lex.advance_n(2)
          closed = true
          break
        }
        let _ = lex.advance()
      }
      if !closed {
        return Err(lex.err("unclosed comment", tag_line, tag_col))
      }
      if trim_right {
        pending_trim_leading = true
      } else if cfg.trim_blocks {
        lex.skip_one_newline()
      }
    } else if p1 == 123 {
      // Variable {{ ... }}
      lex.advance_n(if trim_left { 3 } else { 2 })
      tokens.push(Token::{ kind: TokKind::VarStart, line: tag_line, col: tag_col })
      match lex.lex_expr_tokens(tokens, 125, 125) {
        Ok(trim_right) => {
          if trim_right {
            pending_trim_leading = true
          }
        }
        Err(e) => return Err(e)
      }
    } else {
      // Block {% ... %}
      lex.advance_n(if trim_left { 3 } else { 2 })
      match lex.try_lex_raw_block() {
        Ok(Some((raw_text, trim_right))) => {
          if raw_text.length() > 0 {
            tokens.push(Token::{ kind: TokKind::TemplateData(raw_text), line: tag_line, col: tag_col })
          }
          if trim_right {
            pending_trim_leading = true
          } else if cfg.trim_blocks {
            lex.skip_one_newline()
          }
        }
        Ok(None) => {
          tokens.push(Token::{ kind: TokKind::BlockStart, line: tag_line, col: tag_col })
          match lex.lex_expr_tokens(tokens, 37, 125) {
            Ok(trim_right) => {
              if trim_right {
                pending_trim_leading = true
              } else if cfg.trim_blocks {
                lex.skip_one_newline()
              }
            }
            Err(e) => return Err(e)
          }
        }
        Err(e) => return Err(e)
      }
    }
  }

  tokens.push(Token::{ kind: TokKind::Eof, line: lex.line, col: lex.col })
  Ok(tokens)
}

///| Tokenize a standalone expression (for `Environment::eval_expr`).
fn lex_expression(
  src : String,
  name : Option[String],
) -> Result[Array[Token], TemplateError] {
  let cfg = LexConfig::{
    keep_trailing_newline: true,
    trim_blocks: false,
    lstrip_blocks: false,
  }
  let lex = Lexer::new(src, name, cfg)
  let tokens : Array[Token] = []
  match lex.lex_expr_tokens(tokens, 0, 0) {
    Ok(_) => {
      tokens.push(Token::{ kind: TokKind::Eof, line: lex.line, col: lex.col })
      Ok(tokens)
    }
    Err(e) => Err(e)
  }
}
