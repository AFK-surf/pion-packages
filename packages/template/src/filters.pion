      Some(a) => a.as_str()
      None =>
      if pos_args.length() >= 2 { pos_args[1].as_str() } else { None }
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let n = items.length()
    // Charge fuel proportional to work (3 per element so 20k items exceed 100k fuel budget,
    // while 100k items stay well within default 10M fuel budget).
    match state.consume_fuel(n.to_int64() * 3L, line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let buckets : Map[String, Array[Value]] = Map::new()
    let out : Array[Value] = []
    let mut i = 0
    while i < n {
      let key_val = match attr_opt {
        Some(a) => get_attr_path(items[i], a)
        None => items[i]
