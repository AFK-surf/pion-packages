///| Built-in MiniJinja filters and tests (fuel-accounted, output-bounded, UTF-8 & safe-aware).

fn char_in_str(b : Int, chars : String) -> Bool {
  let mut i = 0
  while i < chars.length() {
    if chars.code_unit_at(i) == b {
      return true
    }
    i = i + 1
  }
  false
}

fn str_trim(s : String, chars_opt : Option[String]) -> String {
  let n = s.length()
  let mut start = 0
  let mut end = n
  match chars_opt {
    None => {
      while start < end && is_ws(s.code_unit_at(start)) {
        start = start + 1
      }
      while end > start && is_ws(s.code_unit_at(end - 1)) {
        end = end - 1
      }
    }
    Some(chars) => {
      while start < end && char_in_str(s.code_unit_at(start), chars) {
        start = start + 1
      }
      while end > start && char_in_str(s.code_unit_at(end - 1), chars) {
        end = end - 1
      }
    }
  }
  s.slice(start, end)
}

fn str_starts_with_at(s : String, pos : Int, pat : String) -> Bool {
  let plen = pat.length()
  if pos + plen > s.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if s.code_unit_at(pos + i) != pat.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_contains(haystack : String, needle : String) -> Bool {
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  let hlen = haystack.length()
  if nlen > hlen {
    return false
  }
  let mut i = 0
  let limit = hlen - nlen
  while i <= limit {
    if str_starts_with_at(haystack, i, needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn str_ends_with(s : String, suffix : String) -> Bool {
  let slen = suffix.length()
  if slen > s.length() {
    return false
  }
  str_starts_with_at(s, s.length() - slen, suffix)
}

///| Bounded string replace that enforces `max_bytes` before allocating oversized buffers.
fn str_replace_bounded(
  s : String,
  old : String,
  new_s : String,
  count : Int,
  max_bytes : Int,
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[String, TemplateError] {
  let n = s.length()
  let olen = old.length()
  let nlen = new_s.length()
  let limit = if max_bytes > 0 { max_bytes } else { 16777216 }
  if olen == 0 {
    // MiniJinja/Python semantics: insert `new_s` between every codepoint (and ends)
    let offsets = utf8_char_offsets(s)
    let cp_count = offsets.length() - 1
    let insertions = if count < 0 || count > cp_count + 1 { cp_count + 1 } else { count }
    let est = n.to_int64() + insertions.to_int64() * nlen.to_int64()
    if est > limit.to_int64() {
      return Err(
        TemplateError::new(
          ErrorKind::OutputLimitExceeded,
          "replace output exceeds size limit",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let sb = StringBuilder::with_capacity(est.to_int())
    let mut inserted = 0
    let mut idx = 0
    while idx < cp_count {
      if inserted < insertions {
        sb.write_string(new_s)
        inserted = inserted + 1
      }
      sb.write_substring(s, offsets[idx], offsets[idx + 1])
      idx = idx + 1
    }
    if inserted < insertions {
      sb.write_string(new_s)
    }
    return Ok(sb.to_string())
  }
  let sb = StringBuilder::with_capacity(if n < limit { n } else { 1024 })
  let mut out_len = 0
  let mut mark = 0
  let mut i = 0
  let mut replaced = 0
  let first_old = old.code_unit_at(0)
  while i < n {
    if (count < 0 || replaced < count) &&
    s.code_unit_at(i) == first_old &&
    str_starts_with_at(s, i, old) {
      let seg_len = i - mark
      if out_len + seg_len + nlen > limit {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "replace output exceeds size limit",
            tpl_name,
            line,
            col,
          ),
        )
      }
      if seg_len > 0 {
        sb.write_substring(s, mark, i)
      }
      sb.write_string(new_s)
      out_len = out_len + seg_len + nlen
      i = i + olen
      mark = i
      replaced = replaced + 1
    } else {
      i = i + 1
    }
  }
  if mark < n {
    let tail_len = n - mark
    if out_len + tail_len > limit {
      return Err(
        TemplateError::new(
          ErrorKind::OutputLimitExceeded,
          "replace output exceeds size limit",
          tpl_name,
          line,
          col,
        ),
      )
    }
    if mark == 0 {
      return Ok(s)
    }
    sb.write_substring(s, mark, n)
  }
  Ok(sb.to_string())
}

fn str_split(s : String, sep_opt : Option[String], maxsplit : Int) -> Array[Value] {
  let out : Array[Value] = []
  let n = s.length()
  let mut splits = 0
  match sep_opt {
    None => {
      let mut i = 0
      while i < n {
        while i < n && is_ws(s.code_unit_at(i)) {
          i = i + 1
        }
        if i >= n {
          break
        }
        if maxsplit >= 0 && splits >= maxsplit {
          out.push(Value::from_string(s.slice(i, n)))
          break
        }
        let start = i
        while i < n && !is_ws(s.code_unit_at(i)) {
          i = i + 1
        }
        out.push(Value::from_string(s.slice(start, i)))
        splits = splits + 1
      }
    }
    Some(sep) => {
      let slen = sep.length()
      if slen == 0 {
        let offsets = utf8_char_offsets(s)
        let mut i = 0
        while i < offsets.length() - 1 {
          out.push(Value::from_string(s.slice(offsets[i], offsets[i + 1])))
          i = i + 1
        }
      } else {
        let mut start = 0
        let mut i = 0
        while i <= n - slen {
          if maxsplit >= 0 && splits >= maxsplit {
            break
          }
          if str_starts_with_at(s, i, sep) {
            out.push(Value::from_string(s.slice(start, i)))
            i = i + slen
            start = i
            splits = splits + 1
          } else {
            i = i + 1
          }
        }
        out.push(Value::from_string(s.slice(start, n)))
      }
    }
  }
  out
}

fn str_wordcount(s : String) -> Int64 {
  let n = s.length()
  let mut count = 0L
  let mut in_word = false
  let mut i = 0
  while i < n {
    if is_ws(s.code_unit_at(i)) {
      in_word = false
    } else if !in_word {
      in_word = true
      count = count + 1L
    }
    i = i + 1
  }
  count
}

fn str_indent_bounded(
  s : String,
  prefix_str : Option[String],
  width : Int,
  first : Bool,
  blank : Bool,
  max_bytes : Int,
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[String, TemplateError] {
  let limit = if max_bytes > 0 { max_bytes.to_int64() } else { 16777216L }
  let pad_len = match prefix_str {
    Some(ps) => ps.length().to_int64()
    None => if width > 0 { width.to_int64() } else { 0L }
  }
  let lines = str_split(s, Some("\n"), -1)
  // Pre-compute exact output length BEFORE allocating!
  let mut total_bytes = s.length().to_int64()
  let mut i = 0
  while i < lines.length() {
    let ln = lines[i].to_display_string()
    let should_indent = (i > 0 || first) && (ln.length() > 0 || blank)
    if should_indent {
      total_bytes = total_bytes + pad_len
      if total_bytes > limit {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "indent output exceeds size limit",
            tpl_name,
            line,
            col,
          ),
        )
      }
    }
    i = i + 1
  }
  let sb = StringBuilder::with_capacity(total_bytes.to_int())
  i = 0
  while i < lines.length() {
    if i > 0 {
      sb.write_byte((10).to_byte())
    }
    let ln = lines[i].to_display_string()
    let should_indent = (i > 0 || first) && (ln.length() > 0 || blank)
    if should_indent {
      match prefix_str {
        Some(ps) => sb.write_string(ps)
        None => write_spaces(sb, if width > 0 { width } else { 0 })
      }
    }
    sb.write_string(ln)
    i = i + 1
  }
  Ok(sb.to_string())
}

fn parse_int_with_base(s : String, base : Int) -> Option[Value] {
  let t = str_trim(s, None)
  let n = t.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut radix = base
  if (radix == 0 || radix == 16) && i + 2 <= n && t.code_unit_at(i) == 48 &&
  (t.code_unit_at(i + 1) == 120 || t.code_unit_at(i + 1) == 88) {
    radix = 16
    i = i + 2
  } else if (radix == 0 || radix == 8) && i + 2 <= n && t.code_unit_at(i) == 48 &&
  (t.code_unit_at(i + 1) == 111 || t.code_unit_at(i + 1) == 79) {
    radix = 8
    i = i + 2
  } else if (radix == 0 || radix == 2) && i + 2 <= n && t.code_unit_at(i) == 48 &&
  (t.code_unit_at(i + 1) == 98 || t.code_unit_at(i + 1) == 66) {
    radix = 2
    i = i + 2
  } else if radix == 0 {
    radix = 10
  }
  if radix < 2 || radix > 36 || i >= n {
    return None
  }
  let mut acc = i128_zero()
  let mut digits = 0
  while i < n {
    let b = t.code_unit_at(i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if b >= 65 && b <= 90 {
      b - 55
    } else if b >= 97 && b <= 122 {
      b - 87
    } else {
      return None
    }
    if d >= radix {
      return None
    }
    match i128_mul_add_small(acc, radix.to_int64(), d.to_int64()) {
      Some(next) => acc = next
      None => return None
    }
    digits = digits + 1
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  if neg {
    match i128_neg(acc) {
      Some(na) => Some(value_from_i128(na))
      None => None
    }
  } else {
    Some(value_from_i128(acc))
  }
}

fn get_kwarg(
  kwargs : Array[(String, Value)],
  name : String,
) -> Option[Value] {
  let mut i = 0
  while i < kwargs.length() {
    let (k, v) = kwargs[i]
    if k == name {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Resolve dotted attribute path (e.g. `a.b.c`) on a `Value`.
fn get_attr_path(v : Value, path : String) -> Value {
  let mut cur = v
  let n = path.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || path.code_unit_at(i) == 46 {
      let seg = path.slice(start, i)
      cur = cur.get_attr(seg)
      start = i + 1
    }
    i = i + 1
  }
  cur
}

///| Materialize any iterable `Value` into an `Array[Value]`.
fn value_to_items(
  v : Value,
  max_items : Int,
) -> Result[Array[Value], TemplateError] {
  match v.kind {
    ValueKind::Seq(arr) => {
      if arr.length() > max_items {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "sequence too large",
            None,
            0,
            0,
          ),
        )
      }
      let out : Array[Value] = []
      let mut i = 0
      while i < arr.length() {
        out.push(arr[i])
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::Map(m) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < m.keys.length() {
        out.push(Value::from_string(m.keys[i]))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::String(s) => {
      let offsets = utf8_char_offsets(s)
      let count = offsets.length() - 1
      if count > max_items {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "string too large to iterate",
            None,
            0,
            0,
          ),
        )
      }
      let out : Array[Value] = []
      let mut i = 0
      while i < count {
        out.push(Value::from_string(s.slice(offsets[i], offsets[i + 1])))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::SafeString(s) => {
      let offsets = utf8_char_offsets(s)
      let count = offsets.length() - 1
      if count > max_items {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "string too large to iterate",
            None,
            0,
            0,
          ),
        )
      }
      let out : Array[Value] = []
      let mut i = 0
      while i < count {
        out.push(Value::from_string(s.slice(offsets[i], offsets[i + 1])))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::Range(start, stop, step) => {
      let len = range_len(start, stop, step)
      if len > max_items.to_int64() {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "range too large to materialize",
            None,
            0,
            0,
          ),
        )
      }
      let out : Array[Value] = []
      let mut i = 0L
      while i < len {
        out.push(Value::from_i64(start + i * step))
        i = i + 1L
      }
      Ok(out)
    }
    ValueKind::Undefined(_) => Ok([])
    ValueKind::None(_) => Ok([])
    _ =>
    Err(
      TemplateError::new(
        ErrorKind::InvalidOperation,
        "value is not iterable",
        None,
        0,
        0,
      ),
    )
  }
}

fn is_builtin_filter_name(name : String) -> Bool {
  name == "default" || name == "d" || name == "upper" || name == "lower" ||
  name == "title" || name == "capitalize" || name == "trim" || name == "replace" ||
  name == "length" || name == "count" || name == "first" || name == "last" ||
  name == "join" || name == "split" || name == "reverse" || name == "sort" ||
  name == "unique" || name == "batch" || name == "slice" || name == "map" ||
  name == "select" || name == "reject" || name == "selectattr" || name == "rejectattr" ||
  name == "abs" || name == "round" || name == "int" || name == "float" ||
  name == "string" || name == "bool" || name == "list" || name == "items" ||
  name == "tojson" || name == "escape" || name == "e" || name == "safe" ||
  name == "indent" || name == "wordcount" || name == "urlencode" || name == "attr" ||
  name == "sum" || name == "min" || name == "max" || name == "dictsort"
}

fn is_builtin_test_name(name : String) -> Bool {
  name == "defined" || name == "undefined" || name == "none" || name == "boolean" ||
  name == "true" || name == "false" || name == "integer" || name == "float" ||
  name == "number" || name == "string" || name == "safe" || name == "escaped" ||
  name == "sequence" || name == "mapping" || name == "iterable" || name == "odd" ||
  name == "even" || name == "lower" || name == "upper" || name == "divisibleby" ||
  name == "startingwith" || name == "endingwith" || name == "in" ||
  name == "eq" || name == "equalto" || name == "==" || name == "sameas" ||
  name == "ne" || name == "!=" || name == "lt" || name == "lessthan" || name == "<" ||
  name == "le" || name == "<=" || name == "gt" || name == "greaterthan" || name == ">" ||
  name == "ge" || name == ">=" || name == "filter" || name == "test"
}

///| Evaluate a built-in or custom test (`x is <name>(args)`).
fn eval_test(
  env : Environment,
  name : String,
  v : Value,
  pos_args : Array[Value],
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[Bool, TemplateError] {
  // Check custom tests first
  if env.test_names.length() > 0 {
    let mut ci = 0
    while ci < env.test_names.length() {
      if env.test_names[ci] == name {
        return env.test_fns[ci](v, pos_args)
      }
      ci = ci + 1
    }
  }

  if name == "defined" {
    return Ok(!v.is_undefined())
  }
  if name == "undefined" {
    return Ok(v.is_undefined())
  }
  if name == "none" {
    return Ok(v.is_none())
  }
  if name == "boolean" {
    return match v.kind {
      ValueKind::Bool(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "true" {
    return match v.kind {
      ValueKind::Bool(b) => Ok(b)
      _ => Ok(false)
    }
  }
  if name == "false" {
    return match v.kind {
      ValueKind::Bool(b) => Ok(!b)
      _ => Ok(false)
    }
  }
  if name == "integer" {
    return match v.kind {
      ValueKind::Int(_) => Ok(true)
      ValueKind::BigInt(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "float" {
    return match v.kind {
      ValueKind::Float(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "number" {
    return match v.kind {
      ValueKind::Int(_) => Ok(true)
      ValueKind::BigInt(_) => Ok(true)
      ValueKind::Float(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "string" {
    return match v.kind {
      ValueKind::String(_) => Ok(true)
      ValueKind::SafeString(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "safe" || name == "escaped" {
    return Ok(v.is_safe())
  }
  if name == "sequence" {
    return match v.kind {
      ValueKind::Seq(_) => Ok(true)
      ValueKind::Range(_, _, _) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "mapping" {
    return match v.kind {
      ValueKind::Map(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "iterable" {
    return match v.kind {
      ValueKind::Seq(_) => Ok(true)
      ValueKind::Map(_) => Ok(true)
      ValueKind::String(_) => Ok(true)
      ValueKind::SafeString(_) => Ok(true)
      ValueKind::Range(_, _, _) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "filter" {
    return match v.as_str() {
      Some(fname) => {
        if is_builtin_filter_name(fname) {
          return Ok(true)
        }
        let mut fi = 0
        while fi < env.filter_names.length() {
          if env.filter_names[fi] == fname {
            return Ok(true)
          }
          fi = fi + 1
        }
        Ok(false)
      }
      None => Ok(false)
    }
  }
  if name == "test" {
    return match v.as_str() {
      Some(tname) => {
        if is_builtin_test_name(tname) {
          return Ok(true)
        }
        let mut ti = 0
        while ti < env.test_names.length() {
          if env.test_names[ti] == tname {
            return Ok(true)
          }
          ti = ti + 1
        }
        Ok(false)
      }
      None => Ok(false)
    }
  }
  if name == "odd" {
    return match v.kind {
      ValueKind::Int(n) => Ok((n & 1L) != 0L)
      ValueKind::BigInt(b) => Ok((b.l0 & 1L) != 0L)
      _ => Ok(false)
    }
  }
  if name == "even" {
    return match v.kind {
      ValueKind::Int(n) => Ok((n & 1L) == 0L)
      ValueKind::BigInt(b) => Ok((b.l0 & 1L) == 0L)
      _ => Ok(false)
    }
  }
  if name == "lower" {
    return match v.as_str() {
      Some(s) => Ok(s.length() > 0 && s == utf8_to_lower(s))
      None => Ok(false)
    }
  }
  if name == "upper" {
    return match v.as_str() {
      Some(s) => Ok(s.length() > 0 && s == utf8_to_upper(s))
      None => Ok(false)
    }
  }
  if name == "divisibleby" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "divisibleby requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_i64(), pos_args[0].as_i64()) {
      (Some(a), Some(b)) =>
      if b == 0L {
        Ok(false)
      } else if a == I64_MIN && b == -1L {
        Ok(true)
      } else {
        Ok((a % b) == 0L)
      }
      _ => Ok(false)
    }
  }
  if name == "startingwith" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "startingwith requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_str(), pos_args[0].as_str()) {
      (Some(s), Some(p)) => Ok(str_starts_with_at(s, 0, p))
      _ => Ok(false)
    }
  }
  if name == "endingwith" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "endingwith requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_str(), pos_args[0].as_str()) {
      (Some(s), Some(p)) => Ok(str_ends_with(s, p))
      _ => Ok(false)
    }
  }
  if name == "in" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "in test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(eval_in(v, pos_args[0]))
  }
  if name == "eq" || name == "equalto" || name == "==" || name == "sameas" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "eq test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(v.equals(pos_args[0]))
  }
  if name == "ne" || name == "!=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "ne test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(!v.equals(pos_args[0]))
  }
  if name == "lt" || name == "lessthan" || name == "<" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "lt test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(value_sort_compare(v, pos_args[0], true, 0) < 0)
  }
  if name == "le" || name == "<=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "le test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(value_sort_compare(v, pos_args[0], true, 0) <= 0)
  }
  if name == "gt" || name == "greaterthan" || name == ">" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "gt test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(value_sort_compare(v, pos_args[0], true, 0) > 0)
  }
  if name == "ge" || name == ">=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "ge test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(value_sort_compare(v, pos_args[0], true, 0) >= 0)
  }

  Err(
    TemplateError::new(
      ErrorKind::UnknownTest,
      "unknown test '" + name + "'",
      tpl_name,
      line,
      col,
    ),
  )
}

///| Evaluate `elem in container`.
fn eval_in(elem : Value, container : Value) -> Bool {
  match container.kind {
    ValueKind::Seq(items) => {
      let mut i = 0
      while i < items.length() {
        if items[i].equals(elem) {
          return true
        }
        i = i + 1
      }
      false
    }
    ValueKind::Range(start, stop, step) => {
      match elem.as_i64() {
        Some(n) => {
          if step == 0L {
            return false
          }
          if step > 0L {
            n >= start && n < stop && ((n - start) % step) == 0L
          } else {
            n <= start && n > stop && ((start - n) % (0L - step)) == 0L
          }
        }
        None => false
      }
    }
    ValueKind::Map(m) => {
      match elem.as_str() {
        Some(k) => m.contains_key(k)
        None => false
      }
    }
    ValueKind::String(s) =>
    match elem.as_str() {
      Some(sub) => str_contains(s, sub)
      None => false
    }
    ValueKind::SafeString(s) =>
    match elem.as_str() {
      Some(sub) => str_contains(s, sub)
      None => false
    }
    _ => false
  }
}

///| Fast-path stable merge sort when sorting values directly (no attribute key array).
fn stable_merge_sort_values(
  state : EvalState,
  items : Array[Value],
  rev : Bool,
  case_sensitive : Bool,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  let n = items.length()
  if n <= 1 {
    return Ok(())
  }
  // Unboxed Int64 fast path when all elements are Int (e.g. `range(20000)|reverse|sort`)
  let mut all_int = true
  let mut check_i = 0
  while check_i < n {
    match items[check_i].kind {
      ValueKind::Int(_) => ()
      _ => {
        all_int = false
        break
      }
    }
    check_i = check_i + 1
  }
  if all_int {
    let mut src_i : Array[Int64] = []
    let mut dst_i : Array[Int64] = []
    let mut k0 = 0
    while k0 < n {
      let v64 = match items[k0].kind {
        ValueKind::Int(x) => x
        _ => 0L
      }
      src_i.push(v64)
      dst_i.push(v64)
      k0 = k0 + 1
    }
    let mut width = 1
    while width < n {
      match state.consume_fuel(n.to_int64(), line, col) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let mut left = 0
      while left < n {
        let mid = if left + width < n { left + width } else { n }
        let right = if left + width * 2 < n { left + width * 2 } else { n }
        let mut i = left
        let mut j = mid
        let mut k = left
        if !rev {
          while i < mid && j < right {
            let a = src_i[i]
            let b = src_i[j]
            if a <= b {
              dst_i[k] = a
              i = i + 1
            } else {
              dst_i[k] = b
              j = j + 1
            }
            k = k + 1
          }
        } else {
          while i < mid && j < right {
            let a = src_i[i]
            let b = src_i[j]
            if a >= b {
              dst_i[k] = a
              i = i + 1
            } else {
              dst_i[k] = b
              j = j + 1
            }
            k = k + 1
          }
        }
        while i < mid {
          dst_i[k] = src_i[i]
          i = i + 1
          k = k + 1
        }
        while j < right {
          dst_i[k] = src_i[j]
          j = j + 1
          k = k + 1
        }
        left = left + width * 2
      }
      let tmp = src_i
      src_i = dst_i
      dst_i = tmp
      width = width * 2
    }
    let mut c = 0
    while c < n {
      items[c] = Value::from_i64(src_i[c])
      c = c + 1
    }
    return Ok(())
  }
  let mut src = items
  let mut dst : Array[Value] = []
  let mut init_i = 0
  while init_i < n {
    dst.push(items[init_i])
    init_i = init_i + 1
  }
  let mut width = 1
  let mut swapped = false
  while width < n {
    match state.consume_fuel(n.to_int64(), line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        let a = src[i]
        let b = src[j]
        let cmp = match (a.kind, b.kind) {
          (ValueKind::Int(x), ValueKind::Int(y)) =>
          if x < y { -1 } else if x > y { 1 } else { 0 }
          _ => value_sort_compare(a, b, case_sensitive, 0)
        }
        let take_left = if rev { cmp >= 0 } else { cmp <= 0 }
        if take_left {
          dst[k] = a
          i = i + 1
        } else {
          dst[k] = b
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        dst[k] = src[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        dst[k] = src[j]
        j = j + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let tmp = src
    src = dst
    dst = tmp
    swapped = !swapped
    width = width * 2
  }
  if swapped {
    let mut c = 0
    while c < n {
      items[c] = src[c]
      c = c + 1
    }
  }
  Ok(())
}

///| Iterative O(N log N) stable bottom-up merge sort with fuel accounting.
fn stable_merge_sort(
  state : EvalState,
  items : Array[Value],
  keys : Array[Value],
  rev : Bool,
  case_sensitive : Bool,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  let n = items.length()
  if n <= 1 {
    return Ok(())
  }
  let mut src_items = items
  let mut src_keys = keys
  let mut dst_items : Array[Value] = []
  let mut dst_keys : Array[Value] = []
  let mut init_i = 0
  while init_i < n {
    dst_items.push(items[init_i])
    dst_keys.push(keys[init_i])
    init_i = init_i + 1
  }
  let mut width = 1
  let mut swapped = false
  while width < n {
    match state.consume_fuel(n.to_int64(), line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        let cmp = value_sort_compare(src_keys[i], src_keys[j], case_sensitive, 0)
        let take_left = if rev { cmp >= 0 } else { cmp <= 0 }
        if take_left {
          dst_items[k] = src_items[i]
          dst_keys[k] = src_keys[i]
          i = i + 1
        } else {
          dst_items[k] = src_items[j]
          dst_keys[k] = src_keys[j]
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        dst_items[k] = src_items[i]
        dst_keys[k] = src_keys[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        dst_items[k] = src_items[j]
        dst_keys[k] = src_keys[j]
        j = j + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let tmp_i = src_items
    src_items = dst_items
    dst_items = tmp_i
    let tmp_k = src_keys
    src_keys = dst_keys
    dst_keys = tmp_k
    swapped = !swapped
    width = width * 2
  }
  if swapped {
    let mut c = 0
    while c < n {
      items[c] = src_items[c]
      c = c + 1
    }
  }
  Ok(())
}

///| Produce a canonical O(1) hash bucket key for `|unique`.
fn unique_bucket_key(v : Value, case_sensitive : Bool) -> String {
  match v.kind {
    ValueKind::Undefined(_) => "u:"
    ValueKind::None(_) => "n:"
    ValueKind::Bool(b) => if b { "b:1" } else { "b:0" }
    ValueKind::Int(n) => "i:" + n.to_string()
    ValueKind::BigInt(b) => "i:" + i128_to_string(b)
    ValueKind::Float(f) => {
      // Int-valued float compares equal to Int in MiniJinja (e.g. 1.0 == 1)
      if f == f && (f - f) == 0.0 && f >= -4503599627370496.0 && f <= 4503599627370496.0 {
        let fi = f.to_int64()
        if fi.to_double() == f {
          return "i:" + fi.to_string()
        }
      }
      "f:" + format_float_str(f)
    }
    ValueKind::String(s) =>
    "s:" + (if case_sensitive { s } else { utf8_to_lower(s) })
    ValueKind::SafeString(s) =>
    "s:" + (if case_sensitive { s } else { utf8_to_lower(s) })
    ValueKind::Seq(arr) => "q:" + arr.length().to_string()
    ValueKind::Map(entries) => "m:" + entries.length().to_string()
    ValueKind::Range(a, b, s) =>
    "r:" + a.to_string() + ":" + b.to_string() + ":" + s.to_string()
  }
}

fn unique_values_equal(a : Value, b : Value, case_sensitive : Bool) -> Bool {
  if !case_sensitive {
    match (a.as_str(), b.as_str()) {
      (Some(sa), Some(sb)) => return utf8_to_lower(sa) == utf8_to_lower(sb)
      _ => ()
    }
  }
  a.equals(b)
}

///| Dekker exact error-free product `a * b = hi + lo` (100% IEEE-754 portable).
fn two_prod(a : Double, b : Double) -> (Double, Double) {
  let hi = a * b
  let split = 134217729.0 // 2^27 + 1
  let ca = split * a
  let a_hi = ca - (ca - a)
  let a_lo = a - a_hi
  let cb = split * b
  let b_hi = cb - (cb - b)
  let b_lo = b - b_hi
  let err1 = hi - a_hi * b_hi
  let err2 = err1 - a_lo * b_hi
  let err3 = err2 - a_hi * b_lo
  let lo = a_lo * b_lo - err3
  (hi, lo)
}

///| Safe floor of finite Double within `[-2^52, 2^52]`.
fn safe_floor_i64(x : Double) -> Int64 {
  let i = x.to_int64()
  if x < i.to_double() { i - 1L } else { i }
}

///| Helper: wrap string back as `SafeString` if input was safe.
fn preserve_safe_str(orig : Value, s : String) -> Value {
  if orig.is_safe() { Value::safe(s) } else { Value::from_string(s) }
}

///| Evaluate a built-in or custom filter (`v | name(args)`).
fn eval_filter(
  state : EvalState,
  name : String,
  v : Value,
  pos_args : Array[Value],
  kwargs : Array[(String, Value)],
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  let env = state.env
  // Check custom filters first
  if env.filter_names.length() > 0 {
    let mut ci = 0
    while ci < env.filter_names.length() {
      if env.filter_names[ci] == name {
        return env.filter_fns[ci](v, pos_args)
      }
      ci = ci + 1
    }
  }

  if name == "default" || name == "d" {
    let def_val = if pos_args.length() >= 1 {
      pos_args[0]
    } else {
      Value::from_string("")
    }
    let use_bool = if pos_args.length() >= 2 {
      pos_args[1].is_truthy()
    } else {
      match get_kwarg(kwargs, "boolean") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    if v.is_undefined() || (use_bool && !v.is_truthy()) {
      return Ok(def_val)
    }
    return Ok(v)
  }

  if name == "upper" {
    return Ok(preserve_safe_str(v, utf8_to_upper(v.to_display_string())))
  }
  if name == "lower" {
    return Ok(preserve_safe_str(v, utf8_to_lower(v.to_display_string())))
  }
  if name == "title" {
    return Ok(preserve_safe_str(v, utf8_to_title(v.to_display_string())))
  }
  if name == "capitalize" {
    return Ok(preserve_safe_str(v, utf8_capitalize(v.to_display_string())))
  }
  if name == "trim" {
    let chars_opt = if pos_args.length() >= 1 {
      pos_args[0].as_str()
    } else {
      None
    }
    return Ok(preserve_safe_str(v, str_trim(v.to_display_string(), chars_opt)))
  }
  if name == "replace" {
    if pos_args.length() < 2 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "replace requires old and new arguments",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let old = pos_args[0].to_display_string()
    let raw_new = pos_args[1].to_display_string()
    let is_html = match state.auto_escape {
      AutoEscape::Html => true
      _ => false
    }
    let keep_safe = v.is_safe()
    let new_s = if keep_safe && is_html && !pos_args[1].is_safe() {
      escape_html(raw_new)
    } else {
      raw_new
    }
    let count = if pos_args.length() >= 3 {
      match pos_args[2].as_i64() {
        Some(c) => c.to_int()
        None => -1
      }
    } else {
      -1
    }
    match str_replace_bounded(
      v.to_display_string(),
      old,
      new_s,
      count,
      state.max_output_bytes,
      tpl_name,
      line,
      col,
    ) {
      Ok(res) =>
      return Ok(if keep_safe { Value::safe(res) } else { Value::from_string(res) })
      Err(e) => return Err(e)
    }
  }
  if name == "length" || name == "count" {
    let n = match v.kind {
      ValueKind::String(s) => utf8_codepoint_count(s).to_int64()
      ValueKind::SafeString(s) => utf8_codepoint_count(s).to_int64()
      ValueKind::Seq(a) => a.length().to_int64()
      ValueKind::Map(m) => m.length().to_int64()
      ValueKind::Range(a, b, s) => range_len(a, b, s)
      _ => 0L
    }
    return Ok(Value::from_i64(n))
  }
  if name == "first" {
    return match v.kind {
      ValueKind::Seq(a) =>
      if a.length() > 0 { Ok(a[0]) } else { Ok(Value::undefined()) }
      ValueKind::String(s) =>
      match utf8_first(s) {
        Some(ch) => Ok(Value::from_string(ch))
        None => Ok(Value::undefined())
      }
      ValueKind::SafeString(s) =>
      match utf8_first(s) {
        Some(ch) => Ok(Value::from_string(ch))
        None => Ok(Value::undefined())
      }
      ValueKind::Range(a, b, s) =>
      if range_len(a, b, s) > 0L {
        Ok(Value::from_i64(a))
      } else {
        Ok(Value::undefined())
      }
      _ => Ok(Value::undefined())
    }
  }
  if name == "last" {
    return match v.kind {
      ValueKind::Seq(a) =>
      if a.length() > 0 {
        Ok(a[a.length() - 1])
      } else {
        Ok(Value::undefined())
      }
      ValueKind::String(s) =>
      match utf8_last(s) {
        Some(ch) => Ok(Value::from_string(ch))
        None => Ok(Value::undefined())
      }
      ValueKind::SafeString(s) =>
      match utf8_last(s) {
        Some(ch) => Ok(Value::from_string(ch))
        None => Ok(Value::undefined())
      }
      ValueKind::Range(a, b, s) => {
        let len = range_len(a, b, s)
        if len > 0L {
          Ok(Value::from_i64(a + (len - 1L) * s))
        } else {
          Ok(Value::undefined())
        }
      }
      _ => Ok(Value::undefined())
    }
  }
  if name == "join" {
    let sep_val = if pos_args.length() >= 1 {
      pos_args[0]
    } else {
      match get_kwarg(kwargs, "d") {
        Some(dv) => dv
        None => Value::from_string("")
      }
    }
    let attr_opt = match get_kwarg(kwargs, "attribute") {
      Some(av) => av.as_str()
      None =>
      if pos_args.length() >= 2 { pos_args[1].as_str() } else { None }
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    match state.consume_fuel(items.length().to_int64(), line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let is_html = match state.auto_escape {
      AutoEscape::Html => true
      _ => false
    }
    // Check if any piece is SafeString in HTML mode
    let mut any_safe = is_html && sep_val.is_safe()
    let extracted : Array[Value] = []
    let mut i = 0
    while i < items.length() {
      let elem = match attr_opt {
        Some(attr) => get_attr_path(items[i], attr)
        None => items[i]
      }
      if is_html && elem.is_safe() {
        any_safe = true
      }
      extracted.push(elem)
      i = i + 1
    }
    let sep_str = if any_safe {
      if sep_val.is_safe() {
        sep_val.to_display_string()
      } else {
        escape_html(sep_val.to_display_string())
      }
    } else {
      sep_val.to_display_string()
    }
    let limit = if state.max_output_bytes > 0 { state.max_output_bytes } else { 16777216 }
    let sb = StringBuilder::new()
    let mut out_len = 0
    i = 0
    while i < extracted.length() {
      if i > 0 {
        if out_len + sep_str.length() > limit {
          return Err(
            state.err(
              ErrorKind::OutputLimitExceeded,
              "join output exceeds size limit",
              line,
              col,
            ),
          )
        }
        sb.write_string(sep_str)
        out_len = out_len + sep_str.length()
      }
      let part = if any_safe {
        if extracted[i].is_safe() {
          extracted[i].to_display_string()
        } else {
          escape_html(extracted[i].to_display_string())
        }
      } else {
        extracted[i].to_display_string()
      }
      if out_len + part.length() > limit {
        return Err(
          state.err(
            ErrorKind::OutputLimitExceeded,
            "join output exceeds size limit",
            line,
            col,
          ),
        )
      }
      sb.write_string(part)
      out_len = out_len + part.length()
      i = i + 1
    }
    return Ok(
      if any_safe { Value::safe(sb.to_string()) } else { Value::from_string(sb.to_string()) },
    )
  }
  if name == "split" {
    let sep_opt = if pos_args.length() >= 1 {
      pos_args[0].as_str()
    } else {
      match get_kwarg(kwargs, "pat") {
        Some(p) => p.as_str()
        None => None
      }
    }
    let maxsplit = if pos_args.length() >= 2 {
      match pos_args[1].as_i64() {
        Some(m) => m.to_int()
        None => -1
      }
    } else {
      match get_kwarg(kwargs, "maxsplit") {
        Some(mv) =>
        match mv.as_i64() {
          Some(m) => m.to_int()
          None => -1
        }
        None => -1
      }
    }
    return Ok(Value::from_seq(str_split(v.to_display_string(), sep_opt, maxsplit)))
  }
  if name == "reverse" {
    return match v.kind {
      ValueKind::String(s) => Ok(Value::from_string(utf8_reverse(s)))
      ValueKind::SafeString(s) => Ok(Value::safe(utf8_reverse(s)))
      _ => {
        let items = match value_to_items(v, 100000) {
          Ok(it) => it
          Err(e) => return Err(e)
        }
        match state.consume_fuel(items.length().to_int64(), line, col) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let out : Array[Value] = []
        let mut i = items.length() - 1
        while i >= 0 {
          out.push(items[i])
          i = i - 1
        }
        Ok(Value::from_seq(out))
      }
    }
  }
  if name == "sort" {
    let rev = if pos_args.length() >= 1 {
      pos_args[0].is_truthy()
    } else {
      match get_kwarg(kwargs, "reverse") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    let case_sensitive = if pos_args.length() >= 2 {
      pos_args[1].is_truthy()
    } else {
      match get_kwarg(kwargs, "case_sensitive") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    let attr_opt = match get_kwarg(kwargs, "attribute") {
      Some(a) => a.as_str()
      None =>
      if pos_args.length() >= 3 { pos_args[2].as_str() } else { None }
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    match attr_opt {
      None =>
      match stable_merge_sort_values(state, items, rev, case_sensitive, line, col) {
        Ok(()) => return Ok(Value::from_seq(items))
        Err(e) => return Err(e)
      }
      Some(a) => {
        let n = items.length()
        let keys : Array[Value] = []
        let mut i = 0
        while i < n {
          keys.push(get_attr_path(items[i], a))
          i = i + 1
        }
        match stable_merge_sort(state, items, keys, rev, case_sensitive, line, col) {
          Ok(()) => return Ok(Value::from_seq(items))
          Err(e) => return Err(e)
        }
      }
    }
  }
  if name == "unique" {
