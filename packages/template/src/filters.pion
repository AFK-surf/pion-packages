      let bkey = unique_bucket_key(key_val, case_sensitive)
      match buckets.get(bkey) {
        Some(bucket) => {
          let mut seen = false
          let mut j = 0
          while j < bucket.length() {
            if unique_values_equal(bucket[j], key_val, case_sensitive) {
              seen = true
              break
            }
            j = j + 1
          }
          if !seen {
            bucket.push(key_val)
            out.push(items[i])
          }
        }
        None => {
