///| Built-in MiniJinja filters and tests.

fn ascii_upper_byte(b : Int) -> Int {
  if b >= 97 && b <= 122 { b - 32 } else { b }
}

fn ascii_lower_byte(b : Int) -> Int {
  if b >= 65 && b <= 90 { b + 32 } else { b }
}

fn str_to_upper(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    sb.write_byte(ascii_upper_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn str_to_lower(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    sb.write_byte(ascii_lower_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn str_to_title(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut capitalize_next = true
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if is_ws(b) || b == 45 || b == 95 || b == 47 {
      capitalize_next = true
      sb.write_byte(b.to_byte())
    } else if capitalize_next {
      sb.write_byte(ascii_upper_byte(b).to_byte())
      capitalize_next = false
    } else {
      sb.write_byte(ascii_lower_byte(b).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_capitalize(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::with_capacity(n)
  sb.write_byte(ascii_upper_byte(s.code_unit_at(0)).to_byte())
  let mut i = 1
  while i < n {
    sb.write_byte(ascii_lower_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn char_in_str(b : Int, chars : String) -> Bool {
  let mut i = 0
  while i < chars.length() {
    if chars.code_unit_at(i) == b {
      return true
    }
    i = i + 1
  }
  false
}

fn str_trim(s : String, chars_opt : Option[String]) -> String {
  let n = s.length()
  let mut start = 0
  let mut end = n
  match chars_opt {
    None => {
      while start < end && is_ws(s.code_unit_at(start)) {
        start = start + 1
      }
      while end > start && is_ws(s.code_unit_at(end - 1)) {
        end = end - 1
      }
    }
    Some(chars) => {
      while start < end && char_in_str(s.code_unit_at(start), chars) {
        start = start + 1
      }
      while end > start && char_in_str(s.code_unit_at(end - 1), chars) {
        end = end - 1
      }
    }
  }
  s.slice(start, end)
}

fn str_starts_with_at(s : String, pos : Int, pat : String) -> Bool {
  let plen = pat.length()
  if pos + plen > s.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if s.code_unit_at(pos + i) != pat.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_contains(haystack : String, needle : String) -> Bool {
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  let hlen = haystack.length()
  if nlen > hlen {
    return false
  }
  let mut i = 0
  let limit = hlen - nlen
  while i <= limit {
    if str_starts_with_at(haystack, i, needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn str_ends_with(s : String, suffix : String) -> Bool {
  let slen = suffix.length()
  if slen > s.length() {
    return false
  }
  str_starts_with_at(s, s.length() - slen, suffix)
}

fn str_replace(s : String, old : String, new_s : String, count : Int) -> String {
  if old.length() == 0 {
    return s
  }
  let sb = StringBuilder::with_capacity(s.length())
  let n = s.length()
  let olen = old.length()
  let mut i = 0
  let mut replaced = 0
  while i < n {
    if (count < 0 || replaced < count) && str_starts_with_at(s, i, old) {
      sb.write_string(new_s)
      i = i + olen
      replaced = replaced + 1
    } else {
      sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

fn str_split(s : String, sep_opt : Option[String]) -> Array[Value] {
  let out : Array[Value] = []
  let n = s.length()
  match sep_opt {
    None => {
      let mut i = 0
      while i < n {
        while i < n && is_ws(s.code_unit_at(i)) {
          i = i + 1
        }
        if i >= n {
          break
        }
        let start = i
        while i < n && !is_ws(s.code_unit_at(i)) {
          i = i + 1
        }
        out.push(Value::from_string(s.slice(start, i)))
      }
    }
    Some(sep) => {
      let slen = sep.length()
      if slen == 0 {
        let mut i = 0
        while i < n {
          out.push(Value::from_string(s.slice(i, i + 1)))
          i = i + 1
        }
      } else {
        let mut start = 0
        let mut i = 0
        while i <= n - slen {
          if str_starts_with_at(s, i, sep) {
            out.push(Value::from_string(s.slice(start, i)))
            i = i + slen
            start = i
          } else {
            i = i + 1
          }
        }
        out.push(Value::from_string(s.slice(start, n)))
      }
    }
  }
  out
}

fn str_reverse(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = n - 1
  while i >= 0 {
    sb.write_byte(s.code_unit_at(i).to_byte())
    i = i - 1
  }
  sb.to_string()
}

fn str_wordcount(s : String) -> Int64 {
  let n = s.length()
  let mut count = 0L
  let mut in_word = false
  let mut i = 0
  while i < n {
    if is_ws(s.code_unit_at(i)) {
      in_word = false
    } else if !in_word {
      in_word = true
      count = count + 1L
    }
    i = i + 1
  }
  count
}

fn str_indent(
  s : String,
  width : Int,
  first : Bool,
  blank : Bool,
) -> String {
  let sb = StringBuilder::with_capacity(s.length() + 32)
  let lines = str_split(s, Some("\n"))
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      sb.write_byte((10).to_byte())
    }
    let line = lines[i].to_display_string()
    let should_indent = (i > 0 || first) && (line.length() > 0 || blank)
    if should_indent {
      write_spaces(sb, width)
    }
    sb.write_string(line)
    i = i + 1
  }
  sb.to_string()
}

fn parse_int64_str(s : String) -> Option[Int64] {
  let t = str_trim(s, None)
  let n = t.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc = 0L
  while i < n {
    let b = t.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    i = i + 1
  }
  Some(if neg { 0L - acc } else { acc })
}

fn get_kwarg(
  kwargs : Array[(String, Value)],
  name : String,
) -> Option[Value] {
  let mut i = 0
  while i < kwargs.length() {
    let (k, v) = kwargs[i]
    if k == name {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Materialize any iterable `Value` into an `Array[Value]`.
fn value_to_items(
  v : Value,
  max_items : Int,
) -> Result[Array[Value], TemplateError] {
  match v.kind {
    ValueKind::Seq(arr) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < arr.length() {
        out.push(arr[i])
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::Map(entries) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < entries.length() {
        let (k, _) = entries[i]
        out.push(Value::from_string(k))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::String(s) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < s.length() {
        out.push(Value::from_string(s.slice(i, i + 1)))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::SafeString(s) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < s.length() {
        out.push(Value::from_string(s.slice(i, i + 1)))
        i = i + 1
      }
      Ok(out)
    }
    ValueKind::Range(start, stop, step) => {
      let len = range_len(start, stop, step)
      if len > max_items.to_int64() {
        return Err(
          TemplateError::new(
            ErrorKind::OutputLimitExceeded,
            "range too large to materialize",
            None,
            0,
            0,
          ),
        )
      }
      let out : Array[Value] = []
      let mut i = 0L
      while i < len {
        out.push(Value::from_i64(start + i * step))
        i = i + 1L
      }
      Ok(out)
    }
    ValueKind::Undefined => Ok([])
    ValueKind::None => Ok([])
    _ =>
    Err(
      TemplateError::new(
        ErrorKind::InvalidOperation,
        "value is not iterable",
        None,
        0,
        0,
      ),
    )
  }
}

///| Evaluate a built-in or custom test (`x is <name>(args)`).
fn eval_test(
  env : Environment,
  name : String,
  v : Value,
  pos_args : Array[Value],
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[Bool, TemplateError] {
  // Check custom tests first
  let mut ci = 0
  while ci < env.tests.length() {
    let (tn, tf) = env.tests[ci]
    if tn == name {
      return tf(v, pos_args)
    }
    ci = ci + 1
  }

  if name == "defined" {
    return Ok(!v.is_undefined())
  }
  if name == "undefined" {
    return Ok(v.is_undefined())
  }
  if name == "none" {
    return Ok(v.is_none())
  }
  if name == "boolean" {
    return match v.kind {
      ValueKind::Bool(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "true" {
    return match v.kind {
      ValueKind::Bool(b) => Ok(b)
      _ => Ok(false)
    }
  }
  if name == "false" {
    return match v.kind {
      ValueKind::Bool(b) => Ok(!b)
      _ => Ok(false)
    }
  }
  if name == "integer" {
    return match v.kind {
      ValueKind::Int(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "float" {
    return match v.kind {
      ValueKind::Float(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "number" {
    return match v.kind {
      ValueKind::Int(_) => Ok(true)
      ValueKind::Float(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "string" {
    return match v.kind {
      ValueKind::String(_) => Ok(true)
      ValueKind::SafeString(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "safe" || name == "escaped" {
    return Ok(v.is_safe())
  }
  if name == "sequence" {
    return match v.kind {
      ValueKind::Seq(_) => Ok(true)
      ValueKind::Range(_, _, _) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "mapping" {
    return match v.kind {
      ValueKind::Map(_) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "iterable" {
    return match v.kind {
      ValueKind::Seq(_) => Ok(true)
      ValueKind::Map(_) => Ok(true)
      ValueKind::String(_) => Ok(true)
      ValueKind::SafeString(_) => Ok(true)
      ValueKind::Range(_, _, _) => Ok(true)
      _ => Ok(false)
    }
  }
  if name == "odd" {
    return match v.as_i64() {
      Some(n) => Ok((n % 2L) != 0L)
      None => Ok(false)
    }
  }
  if name == "even" {
    return match v.as_i64() {
      Some(n) => Ok((n % 2L) == 0L)
      None => Ok(false)
    }
  }
  if name == "lower" {
    return match v.as_str() {
      Some(s) => Ok(s.length() > 0 && s == str_to_lower(s))
      None => Ok(false)
    }
  }
  if name == "upper" {
    return match v.as_str() {
      Some(s) => Ok(s.length() > 0 && s == str_to_upper(s))
      None => Ok(false)
    }
  }
  if name == "divisibleby" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "divisibleby requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_i64(), pos_args[0].as_i64()) {
      (Some(a), Some(b)) => Ok(b != 0L && (a % b) == 0L)
      _ => Ok(false)
    }
  }
  if name == "startingwith" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "startingwith requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_str(), pos_args[0].as_str()) {
      (Some(s), Some(p)) => Ok(str_starts_with_at(s, 0, p))
      _ => Ok(false)
    }
  }
  if name == "endingwith" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "endingwith requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match (v.as_str(), pos_args[0].as_str()) {
      (Some(s), Some(p)) => Ok(str_ends_with(s, p))
      _ => Ok(false)
    }
  }
  if name == "in" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "in test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(eval_in(v, pos_args[0]))
  }
  if name == "eq" || name == "equalto" || name == "==" || name == "sameas" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "eq test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(v.equals(pos_args[0]))
  }
  if name == "ne" || name == "!=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "ne test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return Ok(!v.equals(pos_args[0]))
  }
  if name == "lt" || name == "lessthan" || name == "<" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "lt test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match value_compare(v, pos_args[0]) {
      Some(c) => Ok(c < 0)
      None => Ok(false)
    }
  }
  if name == "le" || name == "<=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "le test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match value_compare(v, pos_args[0]) {
      Some(c) => Ok(c <= 0)
      None => Ok(false)
    }
  }
  if name == "gt" || name == "greaterthan" || name == ">" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "gt test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match value_compare(v, pos_args[0]) {
      Some(c) => Ok(c > 0)
      None => Ok(false)
    }
  }
  if name == "ge" || name == ">=" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "ge test requires 1 argument",
          tpl_name,
          line,
          col,
        ),
      )
    }
    return match value_compare(v, pos_args[0]) {
      Some(c) => Ok(c >= 0)
      None => Ok(false)
    }
  }

  Err(
    TemplateError::new(
      ErrorKind::UnknownTest,
      "unknown test '" + name + "'",
      tpl_name,
      line,
      col,
    ),
  )
}

///| Evaluate `elem in container`.
fn eval_in(elem : Value, container : Value) -> Bool {
  match container.kind {
    ValueKind::Seq(items) => {
      let mut i = 0
      while i < items.length() {
        if items[i].equals(elem) {
          return true
        }
        i = i + 1
      }
      false
    }
    ValueKind::Range(start, stop, step) => {
      match elem.as_i64() {
        Some(n) => {
          if step == 0L {
            return false
          }
          if step > 0L {
            n >= start && n < stop && ((n - start) % step) == 0L
          } else {
            n <= start && n > stop && ((start - n) % (0L - step)) == 0L
          }
        }
        None => false
      }
    }
    ValueKind::Map(entries) => {
      match elem.as_str() {
        Some(k) => {
          let mut i = 0
          while i < entries.length() {
            let (ek, _) = entries[i]
            if ek == k {
              return true
            }
            i = i + 1
          }
          false
        }
        None => false
      }
    }
    ValueKind::String(s) =>
    match elem.as_str() {
      Some(sub) => str_contains(s, sub)
      None => false
    }
    ValueKind::SafeString(s) =>
    match elem.as_str() {
      Some(sub) => str_contains(s, sub)
      None => false
    }
    _ => false
  }
}

///| Evaluate a built-in or custom filter (`v | name(args)`).
fn eval_filter(
  env : Environment,
  name : String,
  v : Value,
  pos_args : Array[Value],
  kwargs : Array[(String, Value)],
  tpl_name : Option[String],
  line : Int,
  col : Int,
) -> Result[Value, TemplateError] {
  // Check custom filters first
  let mut ci = 0
  while ci < env.filters.length() {
    let (fnm, ff) = env.filters[ci]
    if fnm == name {
      return ff(v, pos_args)
    }
    ci = ci + 1
  }

  if name == "default" || name == "d" {
    let def_val = if pos_args.length() >= 1 {
      pos_args[0]
    } else {
      Value::from_string("")
    }
    let use_bool = if pos_args.length() >= 2 {
      pos_args[1].is_truthy()
    } else {
      match get_kwarg(kwargs, "boolean") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    if v.is_undefined() || (use_bool && !v.is_truthy()) {
      return Ok(def_val)
    }
    return Ok(v)
  }

  if name == "upper" {
    return Ok(Value::from_string(str_to_upper(v.to_display_string())))
  }
  if name == "lower" {
    return Ok(Value::from_string(str_to_lower(v.to_display_string())))
  }
  if name == "title" {
    return Ok(Value::from_string(str_to_title(v.to_display_string())))
  }
  if name == "capitalize" {
    return Ok(Value::from_string(str_capitalize(v.to_display_string())))
  }
  if name == "trim" {
    let chars_opt = if pos_args.length() >= 1 {
      pos_args[0].as_str()
    } else {
      None
    }
    return Ok(Value::from_string(str_trim(v.to_display_string(), chars_opt)))
  }
  if name == "replace" {
    if pos_args.length() < 2 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "replace requires old and new arguments",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let old = pos_args[0].to_display_string()
    let new_s = pos_args[1].to_display_string()
    let count = if pos_args.length() >= 3 {
      match pos_args[2].as_i64() {
        Some(c) => c.to_int()
        None => -1
      }
    } else {
      -1
    }
    return Ok(
      Value::from_string(str_replace(v.to_display_string(), old, new_s, count)),
    )
  }
  if name == "length" || name == "count" {
    let n = match v.kind {
      ValueKind::String(s) => s.length().to_int64()
      ValueKind::SafeString(s) => s.length().to_int64()
      ValueKind::Seq(a) => a.length().to_int64()
      ValueKind::Map(m) => m.length().to_int64()
      ValueKind::Range(a, b, s) => range_len(a, b, s)
      _ => 0L
    }
    return Ok(Value::from_i64(n))
  }
  if name == "first" {
    return match v.kind {
      ValueKind::Seq(a) =>
      if a.length() > 0 { Ok(a[0]) } else { Ok(Value::undefined()) }
      ValueKind::String(s) =>
      if s.length() > 0 {
        Ok(Value::from_string(s.slice(0, 1)))
      } else {
        Ok(Value::undefined())
      }
      ValueKind::SafeString(s) =>
      if s.length() > 0 {
        Ok(Value::from_string(s.slice(0, 1)))
      } else {
        Ok(Value::undefined())
      }
      ValueKind::Range(a, b, s) =>
      if range_len(a, b, s) > 0L {
        Ok(Value::from_i64(a))
      } else {
        Ok(Value::undefined())
      }
      _ => Ok(Value::undefined())
    }
  }
  if name == "last" {
    return match v.kind {
      ValueKind::Seq(a) =>
      if a.length() > 0 {
        Ok(a[a.length() - 1])
      } else {
        Ok(Value::undefined())
      }
      ValueKind::String(s) =>
      if s.length() > 0 {
        Ok(Value::from_string(s.slice(s.length() - 1, s.length())))
      } else {
        Ok(Value::undefined())
      }
      ValueKind::SafeString(s) =>
      if s.length() > 0 {
        Ok(Value::from_string(s.slice(s.length() - 1, s.length())))
      } else {
        Ok(Value::undefined())
      }
      ValueKind::Range(a, b, s) => {
        let len = range_len(a, b, s)
        if len > 0L {
          Ok(Value::from_i64(a + (len - 1L) * s))
        } else {
          Ok(Value::undefined())
        }
      }
      _ => Ok(Value::undefined())
    }
  }
  if name == "join" {
    let sep = if pos_args.length() >= 1 {
      pos_args[0].to_display_string()
    } else {
      ""
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let sb = StringBuilder::new()
    let mut i = 0
    while i < items.length() {
      if i > 0 {
        sb.write_string(sep)
      }
      write_value_display(sb, items[i])
      i = i + 1
    }
    return Ok(Value::from_string(sb.to_string()))
  }
  if name == "split" {
    let sep_opt = if pos_args.length() >= 1 {
      pos_args[0].as_str()
    } else {
      None
    }
    return Ok(Value::from_seq(str_split(v.to_display_string(), sep_opt)))
  }
  if name == "reverse" {
    return match v.kind {
      ValueKind::String(s) => Ok(Value::from_string(str_reverse(s)))
      ValueKind::SafeString(s) => Ok(Value::safe(str_reverse(s)))
      _ => {
        let items = match value_to_items(v, 100000) {
          Ok(it) => it
          Err(e) => return Err(e)
        }
        let out : Array[Value] = []
        let mut i = items.length() - 1
        while i >= 0 {
          out.push(items[i])
          i = i - 1
        }
        Ok(Value::from_seq(out))
      }
    }
  }
  if name == "sort" {
    let rev = if pos_args.length() >= 1 {
      pos_args[0].is_truthy()
    } else {
      match get_kwarg(kwargs, "reverse") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    let attr_opt = match get_kwarg(kwargs, "attribute") {
      Some(a) => a.as_str()
      None => None
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    // Insertion sort (stable, fast for typical template lists)
    let mut i = 1
    while i < items.length() {
      let cur = items[i]
      let cur_key = match attr_opt {
        Some(a) => cur.get_attr(a)
        None => cur
      }
      let mut j = i - 1
      while j >= 0 {
        let prev_key = match attr_opt {
          Some(a) => items[j].get_attr(a)
          None => items[j]
        }
        let cmp = match value_compare(prev_key, cur_key) {
          Some(c) => c
          None => 0
        }
        let swap = if rev { cmp < 0 } else { cmp > 0 }
        if swap {
          items[j + 1] = items[j]
          j = j - 1
        } else {
          break
        }
      }
      items[j + 1] = cur
      i = i + 1
    }
    return Ok(Value::from_seq(items))
  }
  if name == "unique" {
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let out : Array[Value] = []
    let mut i = 0
    while i < items.length() {
      let mut seen = false
      let mut j = 0
      while j < out.length() {
        if out[j].equals(items[i]) {
          seen = true
          break
        }
        j = j + 1
      }
      if !seen {
        out.push(items[i])
      }
      i = i + 1
    }
    return Ok(Value::from_seq(out))
  }
  if name == "batch" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "batch requires linecount",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let sz = match pos_args[0].as_i64() {
      Some(n) => if n > 0L { n.to_int() } else { 1 }
      None => 1
    }
    let fill_opt : Option[Value] = if pos_args.length() >= 2 {
      Some(pos_args[1])
    } else {
      get_kwarg(kwargs, "fill_with")
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let out : Array[Value] = []
    let mut i = 0
    while i < items.length() {
      let chunk : Array[Value] = []
      let mut k = 0
      while k < sz && i + k < items.length() {
        chunk.push(items[i + k])
        k = k + 1
      }
      match fill_opt {
        Some(fv) => {
          while chunk.length() < sz {
            chunk.push(fv)
          }
        }
        None => ()
      }
      out.push(Value::from_seq(chunk))
      i = i + sz
    }
    return Ok(Value::from_seq(out))
  }
  if name == "slice" {
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "slice requires slices count",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let slices = match pos_args[0].as_i64() {
      Some(n) => if n > 0L { n.to_int() } else { 1 }
      None => 1
    }
    let fill_opt : Option[Value] = if pos_args.length() >= 2 {
      Some(pos_args[1])
    } else {
      get_kwarg(kwargs, "fill_with")
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let len = items.length()
    let base = len / slices
    let extra = len % slices
    let out : Array[Value] = []
    let mut offset = 0
    let mut s_idx = 0
    while s_idx < slices {
      let take = base + (if s_idx < extra { 1 } else { 0 })
      let chunk : Array[Value] = []
      let mut k = 0
      while k < take {
        chunk.push(items[offset + k])
        k = k + 1
      }
      if s_idx >= extra && extra > 0 {
        match fill_opt {
          Some(fv) => chunk.push(fv)
          None => ()
        }
      }
      out.push(Value::from_seq(chunk))
      offset = offset + take
      s_idx = s_idx + 1
    }
    return Ok(Value::from_seq(out))
  }
  if name == "map" {
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let out : Array[Value] = []
    match get_kwarg(kwargs, "attribute") {
      Some(attr_v) => {
        let attr = attr_v.to_display_string()
        let def_opt = get_kwarg(kwargs, "default")
        let mut i = 0
        while i < items.length() {
          let got = items[i].get_attr(attr)
          if got.is_undefined() {
            match def_opt {
              Some(dv) => out.push(dv)
              None => out.push(got)
            }
          } else {
            out.push(got)
          }
          i = i + 1
        }
        return Ok(Value::from_seq(out))
      }
      None => ()
    }
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          "map requires a filter name or attribute",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let fname = pos_args[0].to_display_string()
    let fargs : Array[Value] = []
    let mut ai = 1
    while ai < pos_args.length() {
      fargs.push(pos_args[ai])
      ai = ai + 1
    }
    let mut i = 0
    while i < items.length() {
      match eval_filter(env, fname, items[i], fargs, kwargs, tpl_name, line, col) {
        Ok(res) => out.push(res)
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    return Ok(Value::from_seq(out))
  }
  if name == "select" || name == "reject" {
    let reject = name == "reject"
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let out : Array[Value] = []
    let mut i = 0
    while i < items.length() {
      let matched = if pos_args.length() == 0 {
        items[i].is_truthy()
      } else {
        let tname = pos_args[0].to_display_string()
        let targs : Array[Value] = []
        let mut ai = 1
        while ai < pos_args.length() {
          targs.push(pos_args[ai])
          ai = ai + 1
        }
        match eval_test(env, tname, items[i], targs, tpl_name, line, col) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
      }
      if matched != reject {
        out.push(items[i])
      }
      i = i + 1
    }
    return Ok(Value::from_seq(out))
  }
  if name == "selectattr" || name == "rejectattr" {
    let reject = name == "rejectattr"
    if pos_args.length() < 1 {
      return Err(
        TemplateError::new(
          ErrorKind::MissingArgument,
          name + " requires attribute name",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let attr = pos_args[0].to_display_string()
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let out : Array[Value] = []
    let mut i = 0
    while i < items.length() {
      let field = items[i].get_attr(attr)
      let matched = if pos_args.length() == 1 {
        field.is_truthy()
      } else {
        let tname = pos_args[1].to_display_string()
        let targs : Array[Value] = []
        let mut ai = 2
        while ai < pos_args.length() {
          targs.push(pos_args[ai])
          ai = ai + 1
        }
        match eval_test(env, tname, field, targs, tpl_name, line, col) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
      }
      if matched != reject {
        out.push(items[i])
      }
      i = i + 1
    }
    return Ok(Value::from_seq(out))
  }
  if name == "abs" {
    return match v.kind {
      ValueKind::Int(n) => Ok(Value::from_i64(if n < 0L { 0L - n } else { n }))
      ValueKind::Float(f) => Ok(Value::from_float(if f < 0.0 { 0.0 - f } else { f }))
      _ =>
      Err(
        TemplateError::new(
          ErrorKind::InvalidOperation,
          "abs requires a number",
          tpl_name,
          line,
          col,
        ),
      )
    }
  }
  if name == "round" {
    let prec = if pos_args.length() >= 1 {
      match pos_args[0].as_i64() {
        Some(p) => p.to_int()
        None => 0
      }
    } else {
      0
    }
    let f = match v.as_f64() {
      Some(d) => d
      None =>
      return Err(
        TemplateError::new(
          ErrorKind::InvalidOperation,
          "round requires a number",
          tpl_name,
          line,
          col,
        ),
      )
    }
    let mut factor = 1.0
    let mut k = 0
    while k < prec {
      factor = factor * 10.0
      k = k + 1
    }
    let scaled = f * factor
    let rounded = if scaled >= 0.0 {
      (scaled + 0.5).to_int64().to_double()
    } else {
      (scaled - 0.5).to_int64().to_double()
    }
    return Ok(Value::from_float(rounded / factor))
  }
  if name == "int" {
    return match v.kind {
      ValueKind::Int(n) => Ok(Value::from_i64(n))
      ValueKind::Float(f) => Ok(Value::from_i64(f.to_int64()))
      ValueKind::Bool(b) => Ok(Value::from_i64(if b { 1L } else { 0L }))
      ValueKind::String(s) =>
      match parse_int64_str(s) {
        Some(n) => Ok(Value::from_i64(n))
        None =>
        Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "cannot parse int from '" + s + "'",
            tpl_name,
            line,
            col,
          ),
        )
      }
      ValueKind::SafeString(s) =>
      match parse_int64_str(s) {
        Some(n) => Ok(Value::from_i64(n))
        None =>
        Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "cannot parse int from '" + s + "'",
            tpl_name,
            line,
            col,
          ),
        )
      }
      _ => Ok(Value::from_i64(0L))
    }
  }
  if name == "float" {
    return match v.kind {
      ValueKind::Float(f) => Ok(Value::from_float(f))
      ValueKind::Int(n) => Ok(Value::from_float(n.to_double()))
      ValueKind::Bool(b) => Ok(Value::from_float(if b { 1.0 } else { 0.0 }))
      ValueKind::String(s) =>
      match parse_double_str(str_trim(s, None)) {
        Some(f) => Ok(Value::from_float(f))
        None =>
        Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "cannot parse float from '" + s + "'",
            tpl_name,
            line,
            col,
          ),
        )
      }
      ValueKind::SafeString(s) =>
      match parse_double_str(str_trim(s, None)) {
        Some(f) => Ok(Value::from_float(f))
        None =>
        Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "cannot parse float from '" + s + "'",
            tpl_name,
            line,
            col,
          ),
        )
      }
      _ => Ok(Value::from_float(0.0))
    }
  }
  if name == "string" {
    return Ok(Value::from_string(v.to_display_string()))
  }
  if name == "bool" {
    return Ok(Value::from_bool(v.is_truthy()))
  }
  if name == "list" {
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    return Ok(Value::from_seq(items))
  }
  if name == "items" {
    return match v.kind {
      ValueKind::Map(entries) => {
        let out : Array[Value] = []
        let mut i = 0
        while i < entries.length() {
          let (k, item_val) = entries[i]
          out.push(Value::from_seq([Value::from_string(k), item_val]))
          i = i + 1
        }
        Ok(Value::from_seq(out))
      }
      _ => Ok(Value::from_seq([]))
    }
  }
  if name == "tojson" {
    let indent = if pos_args.length() >= 1 {
      match pos_args[0].kind {
        ValueKind::Bool(b) => if b { 2 } else { 0 }
        ValueKind::Int(n) => n.to_int()
        _ => 0
      }
    } else {
      match get_kwarg(kwargs, "indent") {
        Some(iv) =>
        match iv.kind {
          ValueKind::Bool(b) => if b { 2 } else { 0 }
          ValueKind::Int(n) => n.to_int()
          _ => 0
        }
        None => 0
      }
    }
    let sb = StringBuilder::new()
    match write_json_value(sb, v, indent, 0) {
      Ok(()) => return Ok(Value::safe(sb.to_string()))
      Err(e) => return Err(e)
    }
  }
  if name == "escape" || name == "e" {
    if v.is_safe() {
      return Ok(v)
    }
    return Ok(Value::safe(escape_html(v.to_display_string())))
  }
  if name == "safe" {
    return Ok(Value::safe(v.to_display_string()))
  }
  if name == "indent" {
    let width = if pos_args.length() >= 1 {
      match pos_args[0].as_i64() {
        Some(w) => w.to_int()
        None => 4
      }
    } else {
      4
    }
    let first = if pos_args.length() >= 2 {
      pos_args[1].is_truthy()
    } else {
      match get_kwarg(kwargs, "first") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    let blank = if pos_args.length() >= 3 {
      pos_args[2].is_truthy()
    } else {
      match get_kwarg(kwargs, "blank") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    return Ok(
      Value::from_string(str_indent(v.to_display_string(), width, first, blank)),
    )
  }
  if name == "wordcount" {
    return Ok(Value::from_i64(str_wordcount(v.to_display_string())))
  }
  if name == "urlencode" {
    return Ok(Value::from_string(urlencode_str(v.to_display_string())))
  }
  if name == "attr" {
    if pos_args.length() < 1 {
      return Ok(Value::undefined())
    }
    return Ok(v.get_attr(pos_args[0].to_display_string()))
  }
  if name == "sum" {
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    let mut int_sum = 0L
    let mut flt_sum = 0.0
    let mut is_flt = false
    let mut i = 0
    while i < items.length() {
      match items[i].kind {
        ValueKind::Int(n) =>
        if is_flt { flt_sum = flt_sum + n.to_double() } else { int_sum = int_sum + n }
        ValueKind::Float(f) => {
          if !is_flt {
            flt_sum = int_sum.to_double()
            is_flt = true
          }
          flt_sum = flt_sum + f
        }
        _ => ()
      }
      i = i + 1
    }
    return if is_flt { Ok(Value::from_float(flt_sum)) } else { Ok(Value::from_i64(int_sum)) }
  }

  Err(
    TemplateError::new(
      ErrorKind::UnknownFilter,
      "unknown filter '" + name + "'",
      tpl_name,
      line,
      col,
    ),
  )
}
