        }
        None => ()
      }
    }
    let first = if pos_args.length() >= 2 {
      pos_args[1].is_truthy()
    } else {
      match get_kwarg(kwargs, "first") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    let blank = if pos_args.length() >= 3 {
      pos_args[2].is_truthy()
    } else {
      match get_kwarg(kwargs, "blank") {
        Some(b) => b.is_truthy()
        None => false
      }
    }
    match str_indent_bounded(
      v.to_display_string(),
      prefix_str,
      width,
      first,
      blank,
      state.max_output_bytes,
      tpl_name,
      line,
      col,
    ) {
      Ok(res) => return Ok(preserve_safe_str(v, res))
      Err(e) => return Err(e)
    }
  }
  if name == "wordcount" {
    return Ok(Value::from_i64(str_wordcount(v.to_display_string())))
  }
  if name == "urlencode" {
    return match v.kind {
      ValueKind::Map(entries) => Ok(Value::from_string(urlencode_map(entries)))
      _ => Ok(Value::from_string(urlencode_str(v.to_display_string())))
    }
  }
  if name == "attr" {
    if pos_args.length() < 1 {
      return Ok(Value::undefined())
    }
    return Ok(get_attr_path(v, pos_args[0].to_display_string()))
  }
  if name == "sum" {
    let attr_opt = match get_kwarg(kwargs, "attribute") {
      Some(a) => a.as_str()
      None =>
      if pos_args.length() >= 1 { pos_args[0].as_str() } else { None }
    }
    let start_val = match get_kwarg(kwargs, "start") {
      Some(sv) => sv
      None =>
      if pos_args.length() >= 2 {
        pos_args[1]
      } else if pos_args.length() >= 1 && attr_opt.is_none() {
        pos_args[0]
      } else {
        Value::from_i64(0L)
      }
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    match state.consume_fuel(items.length().to_int64(), line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let mut acc = start_val
    let mut i = 0
    while i < items.length() {
      let elem = match attr_opt {
        Some(a) => get_attr_path(items[i], a)
        None => items[i]
      }
      if !elem.is_undefined() && !elem.is_none() {
        match state.eval_binop(BinOp::Add, acc, elem, line, col) {
          Ok(next_acc) => acc = next_acc
          Err(e) => return Err(e)
        }
      }
      i = i + 1
    }
    return Ok(acc)
  }
  if name == "min" || name == "max" {
    let is_max = name == "max"
    let case_sensitive = match get_kwarg(kwargs, "case_sensitive") {
      Some(b) => b.is_truthy()
      None => false
    }
    let attr_opt = match get_kwarg(kwargs, "attribute") {
      Some(a) => a.as_str()
      None => None
    }
    let items = match value_to_items(v, 100000) {
      Ok(it) => it
      Err(e) => return Err(e)
    }
    if items.length() == 0 {
      return Ok(Value::undefined())
    }
    match state.consume_fuel(items.length().to_int64(), line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let mut best = items[0]
    let mut best_key = match attr_opt {
      Some(a) => get_attr_path(best, a)
      None => best
    }
    let mut i = 1
    while i < items.length() {
      let cur_key = match attr_opt {
        Some(a) => get_attr_path(items[i], a)
        None => items[i]
      }
      let cmp = value_sort_compare(cur_key, best_key, case_sensitive, 0)
      if (is_max && cmp > 0) || (!is_max && cmp < 0) {
        best = items[i]
        best_key = cur_key
      }
      i = i + 1
    }
    return Ok(best)
  }

  Err(
    TemplateError::new(
      ErrorKind::UnknownFilter,
      "unknown filter '" + name + "'",
      tpl_name,
      line,
      col,
    ),
  )
}
