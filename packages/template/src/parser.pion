///| Recursive-descent parser for Jinja2/MiniJinja templates and expressions.

struct Parser {
  tokens : Array[Token]
  len : Int
  name : Option[String]
  max_depth : Int
  mut pos : Int
  mut depth : Int
  blocks : Array[(String, Array[Stmt])]
  mut has_extends : Bool
}

fn Parser::new(
  tokens : Array[Token],
  name : Option[String],
  max_depth : Int,
) -> Parser {
  Parser::{
    tokens: tokens,
    len: tokens.length(),
    name: name,
    max_depth: max_depth,
    pos: 0,
    depth: 0,
    blocks: [],
    has_extends: false,
  }
}

fn Parser::peek(self : Parser) -> Token {
  if self.pos < self.len {
    self.tokens[self.pos]
  } else {
    Token::{ kind: TokKind::Eof, line: 1, col: 1 }
  }
}

fn Parser::peek_at(self : Parser, offset : Int) -> Token {
  let idx = self.pos + offset
  if idx < self.len {
    self.tokens[idx]
  } else {
    Token::{ kind: TokKind::Eof, line: 1, col: 1 }
  }
}

fn Parser::next(self : Parser) -> Token {
  let t = self.peek()
  if self.pos < self.len {
    self.pos = self.pos + 1
  }
  t
}

fn Parser::err(
  self : Parser,
  kind : ErrorKind,
  msg : String,
  line : Int,
  col : Int,
) -> TemplateError {
  TemplateError::new(kind, msg, self.name, line, col)
}

fn Parser::enter_depth(
  self : Parser,
  line : Int,
  col : Int,
) -> Result[Unit, TemplateError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(
      self.err(
        ErrorKind::RecursionLimit,
        "maximum nesting depth exceeded",
        line,
        col,
      ),
    )
  }
  Ok(())
}

fn Parser::leave_depth(self : Parser) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn Parser::is_ident(self : Parser, expected : String) -> Bool {
  match self.peek().kind {
    TokKind::Ident(s) => s == expected
    _ => false
  }
}

fn Parser::consume_ident(self : Parser, expected : String) -> Bool {
  if self.is_ident(expected) {
    let _ = self.next()
    true
  } else {
    false
  }
}

fn Parser::expect_ident(self : Parser) -> Result[(String, Int, Int), TemplateError] {
  let t = self.next()
  match t.kind {
    TokKind::Ident(s) => Ok((s, t.line, t.col))
    _ =>
    Err(
      self.err(ErrorKind::SyntaxError, "expected identifier", t.line, t.col),
    )
  }
}

fn Parser::expect_block_end(self : Parser) -> Result[Unit, TemplateError] {
  let t = self.next()
  match t.kind {
    TokKind::BlockEnd => Ok(())
    _ =>
    Err(
      self.err(ErrorKind::SyntaxError, "expected '%}'", t.line, t.col),
    )
  }
}

fn Parser::expect_var_end(self : Parser) -> Result[Unit, TemplateError] {
  let t = self.next()
  match t.kind {
    TokKind::VarEnd => Ok(())
    _ =>
    Err(
      self.err(ErrorKind::SyntaxError, "expected '}}'", t.line, t.col),
    )
  }
}

fn expr_pos(e : Expr) -> (Int, Int) {
  match e {
    Expr::Const(_, l, c) => (l, c)
    Expr::Var(_, l, c) => (l, c)
    Expr::List(_, l, c) => (l, c)
    Expr::Map(_, l, c) => (l, c)
    Expr::Unary(_, _, l, c) => (l, c)
    Expr::Bin(_, _, _, l, c) => (l, c)
    Expr::IfExpr(_, _, _, l, c) => (l, c)
    Expr::GetAttr(_, _, l, c) => (l, c)
    Expr::GetItem(_, _, l, c) => (l, c)
    Expr::Slice(_, _, _, _, l, c) => (l, c)
    Expr::Filter(_, _, _, l, c) => (l, c)
    Expr::Test(_, _, _, _, l, c) => (l, c)
    Expr::Call(_, _, l, c) => (l, c)
  }
}

///| Parse call argument list `(a, b, k=v)`. Assumes `(` was already consumed.
fn Parser::parse_call_args(self : Parser) -> Result[Array[CallArg], TemplateError] {
  let args : Array[CallArg] = []
  match self.peek().kind {
    TokKind::RParen => {
      let _ = self.next()
      return Ok(args)
    }
    _ => ()
  }
  while true {
    // Check keyword argument `ident = expr`
    let mut kw : Option[String] = None
    match (self.peek().kind, self.peek_at(1).kind) {
      (TokKind::Ident(k), TokKind::Assign) => {
        let _ = self.next()
        let _ = self.next()
        kw = Some(k)
      }
      _ => ()
    }
    let e = match self.parse_expr() {
      Ok(ex) => ex
      Err(er) => return Err(er)
    }
    args.push(CallArg::{ name: kw, expr: e })
    match self.peek().kind {
      TokKind::Comma => {
        let _ = self.next()
        match self.peek().kind {
          TokKind::RParen => {
            let _ = self.next()
            return Ok(args)
          }
          _ => ()
        }
      }
      TokKind::RParen => {
        let _ = self.next()
        return Ok(args)
      }
      _ => {
        let t = self.peek()
        return Err(
          self.err(ErrorKind::SyntaxError, "expected ',' or ')'", t.line, t.col),
        )
      }
    }
  }
  Ok(args)
}

///| Entry point for parsing an expression (lowest precedence: ternary).
fn Parser::parse_expr(self : Parser) -> Result[Expr, TemplateError] {
  let t = self.peek()
  match self.enter_depth(t.line, t.col) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let res = self.parse_ternary()
  self.leave_depth()
  res
}

fn Parser::parse_ternary(self : Parser) -> Result[Expr, TemplateError] {
  let expr = match self.parse_or() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  if self.consume_ident("if") {
    let (line, col) = expr_pos(expr)
    let cond = match self.parse_or() {
      Ok(c) => c
      Err(er) => return Err(er)
    }
    let else_expr = if self.consume_ident("else") {
      match self.parse_ternary() {
        Ok(e2) => Some(e2)
        Err(er) => return Err(er)
      }
    } else {
      None
    }
    return Ok(Expr::IfExpr(cond, expr, else_expr, line, col))
  }
  Ok(expr)
}

fn Parser::parse_or(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_and() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while self.consume_ident("or") {
    let (l, c) = expr_pos(lhs)
    let rhs = match self.parse_and() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    lhs = Expr::Bin(BinOp::Or, lhs, rhs, l, c)
  }
  Ok(lhs)
}

fn Parser::parse_and(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_not() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while self.consume_ident("and") {
    let (l, c) = expr_pos(lhs)
    let rhs = match self.parse_not() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    lhs = Expr::Bin(BinOp::And, lhs, rhs, l, c)
  }
  Ok(lhs)
}

fn Parser::parse_not(self : Parser) -> Result[Expr, TemplateError] {
  if self.is_ident("not") {
    let t = self.next()
    let sub = match self.parse_not() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    return Ok(Expr::Unary(UnaryOp::Not, sub, t.line, t.col))
  }
  self.parse_compare()
}

fn Parser::parse_compare(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_concat() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    let t = self.peek()
    match t.kind {
      TokKind::Eq => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Eq, lhs, rhs, t.line, t.col)
      }
      TokKind::Ne => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Ne, lhs, rhs, t.line, t.col)
      }
      TokKind::Lt => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Lt, lhs, rhs, t.line, t.col)
      }
      TokKind::Le => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Le, lhs, rhs, t.line, t.col)
      }
      TokKind::Gt => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Gt, lhs, rhs, t.line, t.col)
      }
      TokKind::Ge => {
        let _ = self.next()
        let rhs = match self.parse_concat() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Ge, lhs, rhs, t.line, t.col)
      }
      TokKind::Ident(kw) => {
        if kw == "in" {
          let _ = self.next()
          let rhs = match self.parse_concat() {
            Ok(e) => e
            Err(er) => return Err(er)
          }
          lhs = Expr::Bin(BinOp::In, lhs, rhs, t.line, t.col)
        } else if kw == "not" {
          match self.peek_at(1).kind {
            TokKind::Ident(kw2) => {
              if kw2 == "in" {
                let _ = self.next()
                let _ = self.next()
                let rhs = match self.parse_concat() {
                  Ok(e) => e
                  Err(er) => return Err(er)
                }
                lhs = Expr::Bin(BinOp::NotIn, lhs, rhs, t.line, t.col)
              } else {
                break
              }
            }
            _ => break
          }
        } else if kw == "is" {
          let _ = self.next()
          let negated = self.consume_ident("not")
          let (test_name, tl, tc) = match self.expect_ident() {
            Ok(pair) => pair
            Err(er) => return Err(er)
          }
          let args = match self.peek().kind {
            TokKind::LParen => {
              let _ = self.next()
              match self.parse_call_args() {
                Ok(a) => a
                Err(er) => return Err(er)
              }
            }
            _ => []
          }
          lhs = Expr::Test(lhs, test_name, args, negated, tl, tc)
        } else {
          break
        }
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_concat(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_add() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    let t = self.peek()
    match t.kind {
      TokKind::Tilde => {
        let _ = self.next()
        let rhs = match self.parse_add() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Concat, lhs, rhs, t.line, t.col)
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_add(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_mul() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    let t = self.peek()
    match t.kind {
      TokKind::Plus => {
        let _ = self.next()
        let rhs = match self.parse_mul() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Add, lhs, rhs, t.line, t.col)
      }
      TokKind::Minus => {
        let _ = self.next()
        let rhs = match self.parse_mul() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Sub, lhs, rhs, t.line, t.col)
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_mul(self : Parser) -> Result[Expr, TemplateError] {
  let mut lhs = match self.parse_unary() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    let t = self.peek()
    match t.kind {
      TokKind::Mul => {
        let _ = self.next()
        let rhs = match self.parse_unary() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Mul, lhs, rhs, t.line, t.col)
      }
      TokKind::Div => {
        let _ = self.next()
        let rhs = match self.parse_unary() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Div, lhs, rhs, t.line, t.col)
      }
      TokKind::FloorDiv => {
        let _ = self.next()
        let rhs = match self.parse_unary() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::FloorDiv, lhs, rhs, t.line, t.col)
      }
      TokKind::Mod => {
        let _ = self.next()
        let rhs = match self.parse_unary() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        lhs = Expr::Bin(BinOp::Rem, lhs, rhs, t.line, t.col)
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_unary(self : Parser) -> Result[Expr, TemplateError] {
  let t = self.peek()
  match t.kind {
    TokKind::Minus => {
      let _ = self.next()
      let sub = match self.parse_unary() {
        Ok(e) => e
        Err(er) => return Err(er)
      }
      Ok(Expr::Unary(UnaryOp::Neg, sub, t.line, t.col))
    }
    TokKind::Plus => {
      let _ = self.next()
      let sub = match self.parse_unary() {
        Ok(e) => e
        Err(er) => return Err(er)
      }
      Ok(Expr::Unary(UnaryOp::Pos, sub, t.line, t.col))
    }
    _ => self.parse_pow()
  }
}

fn Parser::parse_pow(self : Parser) -> Result[Expr, TemplateError] {
  let lhs = match self.parse_filter() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  match self.peek().kind {
    TokKind::Pow => {
      let t = self.next()
      let rhs = match self.parse_unary() {
        Ok(e) => e
        Err(er) => return Err(er)
      }
      Ok(Expr::Bin(BinOp::Pow, lhs, rhs, t.line, t.col))
    }
    _ => Ok(lhs)
  }
}

fn Parser::parse_filter(self : Parser) -> Result[Expr, TemplateError] {
  let mut expr = match self.parse_postfix() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    match self.peek().kind {
      TokKind::Pipe => {
        let _ = self.next()
        let (fname, fl, fc) = match self.expect_ident() {
          Ok(p) => p
          Err(er) => return Err(er)
        }
        let args = match self.peek().kind {
          TokKind::LParen => {
            let _ = self.next()
            match self.parse_call_args() {
              Ok(a) => a
              Err(er) => return Err(er)
            }
          }
          _ => []
        }
        expr = Expr::Filter(expr, fname, args, fl, fc)
      }
      _ => break
    }
  }
  Ok(expr)
}

fn Parser::parse_postfix(self : Parser) -> Result[Expr, TemplateError] {
  let mut expr = match self.parse_primary() {
    Ok(e) => e
    Err(er) => return Err(er)
  }
  while true {
    let t = self.peek()
    match t.kind {
      TokKind::Dot => {
        let _ = self.next()
        let (attr, al, ac) = match self.expect_ident() {
          Ok(p) => p
          Err(er) => return Err(er)
        }
        expr = Expr::GetAttr(expr, attr, al, ac)
      }
      TokKind::LParen => {
        let _ = self.next()
        let args = match self.parse_call_args() {
          Ok(a) => a
          Err(er) => return Err(er)
        }
        expr = Expr::Call(expr, args, t.line, t.col)
      }
      TokKind::LBracket => {
        let _ = self.next()
        let first_opt : Option[Expr] = match self.peek().kind {
          TokKind::Colon => None
          _ =>
          match self.parse_expr() {
            Ok(e) => Some(e)
            Err(er) => return Err(er)
          }
        }
        match self.peek().kind {
          TokKind::Colon => {
            let _ = self.next()
            let stop_opt : Option[Expr] = match self.peek().kind {
              TokKind::Colon => None
              TokKind::RBracket => None
              _ =>
              match self.parse_expr() {
                Ok(e) => Some(e)
                Err(er) => return Err(er)
              }
            }
            let step_opt : Option[Expr] = match self.peek().kind {
              TokKind::Colon => {
                let _ = self.next()
                match self.peek().kind {
                  TokKind::RBracket => None
                  _ =>
                  match self.parse_expr() {
                    Ok(e) => Some(e)
                    Err(er) => return Err(er)
                  }
                }
              }
              _ => None
            }
            match self.next().kind {
              TokKind::RBracket => ()
              _ =>
              return Err(
                self.err(ErrorKind::SyntaxError, "expected ']'", t.line, t.col),
              )
            }
            expr = Expr::Slice(expr, first_opt, stop_opt, step_opt, t.line, t.col)
          }
          TokKind::RBracket => {
            let _ = self.next()
            match first_opt {
              Some(idx_expr) => expr = Expr::GetItem(expr, idx_expr, t.line, t.col)
              None =>
              return Err(
                self.err(ErrorKind::SyntaxError, "empty subscript", t.line, t.col),
              )
            }
          }
          _ => {
            let bad = self.peek()
            return Err(
              self.err(
                ErrorKind::SyntaxError,
                "expected ']' or ':'",
                bad.line,
                bad.col,
              ),
            )
          }
        }
      }
      _ => break
    }
  }
  Ok(expr)
}

fn Parser::parse_primary(self : Parser) -> Result[Expr, TemplateError] {
  let t = self.next()
  match t.kind {
    TokKind::Str(s) => Ok(Expr::Const(Value::from_string(s), t.line, t.col))
    TokKind::IntLit(n) => Ok(Expr::Const(Value::from_i64(n), t.line, t.col))
    TokKind::FloatLit(f) => Ok(Expr::Const(Value::from_float(f), t.line, t.col))
    TokKind::Ident(name) => {
      if name == "true" || name == "True" {
        Ok(Expr::Const(Value::from_bool(true), t.line, t.col))
      } else if name == "false" || name == "False" {
        Ok(Expr::Const(Value::from_bool(false), t.line, t.col))
      } else if name == "none" || name == "None" {
        Ok(Expr::Const(Value::none(), t.line, t.col))
      } else {
        Ok(Expr::Var(name, t.line, t.col))
      }
    }
    TokKind::LParen => {
      let inner = match self.parse_expr() {
        Ok(e) => e
        Err(er) => return Err(er)
      }
      match self.peek().kind {
        TokKind::RParen => {
          let _ = self.next()
          Ok(inner)
        }
        TokKind::Comma => {
          // Tuple literal -> List
          let items : Array[Expr] = [inner]
          while true {
            match self.peek().kind {
              TokKind::Comma => {
                let _ = self.next()
                match self.peek().kind {
                  TokKind::RParen => {
                    let _ = self.next()
                    return Ok(Expr::List(items, t.line, t.col))
                  }
                  _ => ()
                }
                let next_item = match self.parse_expr() {
                  Ok(e) => e
                  Err(er) => return Err(er)
                }
                items.push(next_item)
              }
              TokKind::RParen => {
                let _ = self.next()
                return Ok(Expr::List(items, t.line, t.col))
              }
              _ => {
                let bad = self.peek()
                return Err(
                  self.err(
                    ErrorKind::SyntaxError,
                    "expected ')' or ','",
                    bad.line,
                    bad.col,
                  ),
                )
              }
            }
          }
          Ok(Expr::List(items, t.line, t.col))
        }
        _ => {
          let bad = self.peek()
          Err(
            self.err(ErrorKind::SyntaxError, "expected ')'", bad.line, bad.col),
          )
        }
      }
    }
    TokKind::LBracket => {
      let items : Array[Expr] = []
      match self.peek().kind {
        TokKind::RBracket => {
          let _ = self.next()
          return Ok(Expr::List(items, t.line, t.col))
        }
        _ => ()
      }
      while true {
        let e = match self.parse_expr() {
          Ok(ex) => ex
          Err(er) => return Err(er)
        }
        items.push(e)
        match self.peek().kind {
          TokKind::Comma => {
            let _ = self.next()
            match self.peek().kind {
              TokKind::RBracket => {
                let _ = self.next()
                return Ok(Expr::List(items, t.line, t.col))
              }
              _ => ()
            }
          }
          TokKind::RBracket => {
            let _ = self.next()
            return Ok(Expr::List(items, t.line, t.col))
          }
          _ => {
            let bad = self.peek()
            return Err(
              self.err(
                ErrorKind::SyntaxError,
                "expected ',' or ']'",
                bad.line,
                bad.col,
              ),
            )
          }
        }
      }
      Ok(Expr::List(items, t.line, t.col))
    }
    TokKind::LBrace => {
      let pairs : Array[(Expr, Expr)] = []
      match self.peek().kind {
        TokKind::RBrace => {
          let _ = self.next()
          return Ok(Expr::Map(pairs, t.line, t.col))
        }
        _ => ()
      }
      while true {
        let k = match self.parse_expr() {
          Ok(ex) => ex
          Err(er) => return Err(er)
        }
        match self.next().kind {
          TokKind::Colon => ()
          _ =>
          return Err(
            self.err(ErrorKind::SyntaxError, "expected ':' in dict", t.line, t.col),
          )
        }
        let v = match self.parse_expr() {
          Ok(ex) => ex
          Err(er) => return Err(er)
        }
        pairs.push((k, v))
        match self.peek().kind {
          TokKind::Comma => {
            let _ = self.next()
            match self.peek().kind {
              TokKind::RBrace => {
                let _ = self.next()
                return Ok(Expr::Map(pairs, t.line, t.col))
              }
              _ => ()
            }
          }
          TokKind::RBrace => {
            let _ = self.next()
            return Ok(Expr::Map(pairs, t.line, t.col))
          }
          _ => {
            let bad = self.peek()
            return Err(
              self.err(
                ErrorKind::SyntaxError,
                "expected ',' or '}'",
                bad.line,
                bad.col,
              ),
            )
          }
        }
      }
      Ok(Expr::Map(pairs, t.line, t.col))
    }
    _ =>
    Err(
      self.err(
        ErrorKind::SyntaxError,
        "unexpected token in expression",
        t.line,
        t.col,
      ),
    )
  }
}

///| Peek if current position is `{% <one of end_tags> ... %}`.
fn Parser::at_end_tag(self : Parser, end_tags : Array[String]) -> Option[String] {
  match (self.peek().kind, self.peek_at(1).kind) {
    (TokKind::BlockStart, TokKind::Ident(tag)) => {
      let mut i = 0
      while i < end_tags.length() {
        if end_tags[i] == tag {
          return Some(tag)
        }
        i = i + 1
      }
      None
    }
    _ => None
  }
}

///| Parse statements until EOF or one of `end_tags`.
fn Parser::parse_stmts(
  self : Parser,
  end_tags : Array[String],
) -> Result[Array[Stmt], TemplateError] {
  let stmts : Array[Stmt] = []
  while true {
    match self.peek().kind {
      TokKind::Eof => break
      TokKind::TemplateData(s) => {
        let _ = self.next()
        stmts.push(Stmt::EmitRaw(s))
      }
      TokKind::VarStart => {
        let t = self.next()
        let e = match self.parse_expr() {
          Ok(ex) => ex
          Err(er) => return Err(er)
        }
        match self.expect_var_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
        stmts.push(Stmt::EmitExpr(e, t.line, t.col))
      }
      TokKind::BlockStart => {
        match self.at_end_tag(end_tags) {
          Some(_) => break
          None => ()
        }
        let st = match self.parse_block_stmt() {
          Ok(s) => s
          Err(er) => return Err(er)
        }
        stmts.push(st)
      }
      _ => {
        let t = self.peek()
        return Err(
          self.err(ErrorKind::SyntaxError, "unexpected token", t.line, t.col),
        )
      }
    }
  }
  Ok(stmts)
}

fn Parser::parse_block_stmt(self : Parser) -> Result[Stmt, TemplateError] {
  let start_tok = self.next() // BlockStart
  let (tag, line, col) = match self.expect_ident() {
    Ok(p) => p
    Err(er) => return Err(er)
  }

  if tag == "if" {
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let cond = match self.parse_expr() {
      Ok(e) => e
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    let body = match self.parse_stmts(["elif", "else", "endif"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    let branches : Array[(Expr, Array[Stmt])] = [(cond, body)]
    let mut else_body : Array[Stmt] = []
    let mut closed = false
    while !closed {
      match self.at_end_tag(["elif", "else", "endif"]) {
        Some(next_tag) => {
          let _ = self.next() // BlockStart
          let _ = self.next() // tag ident
          if next_tag == "elif" {
            let econd = match self.parse_expr() {
              Ok(e) => e
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
            match self.expect_block_end() {
              Ok(()) => ()
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
            let ebody = match self.parse_stmts(["elif", "else", "endif"]) {
              Ok(b) => b
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
            branches.push((econd, ebody))
          } else if next_tag == "else" {
            match self.expect_block_end() {
              Ok(()) => ()
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
            else_body = match self.parse_stmts(["endif"]) {
              Ok(b) => b
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
          } else {
            match self.expect_block_end() {
              Ok(()) => ()
              Err(er) => {
                self.leave_depth()
                return Err(er)
              }
            }
            closed = true
          }
        }
        None => {
          self.leave_depth()
          return Err(
            self.err(ErrorKind::SyntaxError, "unclosed {% if %} block", line, col),
          )
        }
      }
    }
    self.leave_depth()
    return Ok(Stmt::If(branches, else_body, line, col))
  }

  if tag == "for" {
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let targets : Array[String] = []
    let (first_t, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    targets.push(first_t)
    while true {
      match self.peek().kind {
        TokKind::Comma => {
          let _ = self.next()
          let (nt, _, _) = match self.expect_ident() {
            Ok(p) => p
            Err(er) => {
              self.leave_depth()
              return Err(er)
            }
          }
          targets.push(nt)
        }
        _ => break
      }
    }
    if !self.consume_ident("in") {
      self.leave_depth()
      return Err(
        self.err(ErrorKind::SyntaxError, "expected 'in' in for loop", line, col),
      )
    }
    // Parse iterable without consuming trailing `if` filter as ternary!
    let iter_expr = match self.parse_or() {
      Ok(e) => e
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    let filter_expr : Option[Expr] = if self.consume_ident("if") {
      match self.parse_expr() {
        Ok(e) => Some(e)
        Err(er) => {
          self.leave_depth()
          return Err(er)
        }
      }
    } else {
      None
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    let body = match self.parse_stmts(["else", "endfor"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    let mut else_body : Array[Stmt] = []
    match self.at_end_tag(["else", "endfor"]) {
      Some(next_tag) => {
        let _ = self.next()
        let _ = self.next()
        if next_tag == "else" {
          match self.expect_block_end() {
            Ok(()) => ()
            Err(er) => {
              self.leave_depth()
              return Err(er)
            }
          }
          else_body = match self.parse_stmts(["endfor"]) {
            Ok(b) => b
            Err(er) => {
              self.leave_depth()
              return Err(er)
            }
          }
          match self.at_end_tag(["endfor"]) {
            Some(_) => {
              let _ = self.next()
              let _ = self.next()
              match self.expect_block_end() {
                Ok(()) => ()
                Err(er) => {
                  self.leave_depth()
                  return Err(er)
                }
              }
            }
            None => {
              self.leave_depth()
              return Err(
                self.err(
                  ErrorKind::SyntaxError,
                  "unclosed {% for %} block",
                  line,
                  col,
                ),
              )
            }
          }
        } else {
          match self.expect_block_end() {
            Ok(()) => ()
            Err(er) => {
              self.leave_depth()
              return Err(er)
            }
          }
        }
      }
      None => {
        self.leave_depth()
        return Err(
          self.err(ErrorKind::SyntaxError, "unclosed {% for %} block", line, col),
        )
      }
    }
    self.leave_depth()
    return Ok(Stmt::For(targets, iter_expr, filter_expr, body, else_body, line, col))
  }

  if tag == "set" {
    let (vname, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => return Err(er)
    }
    // Check `set ns.attr = expr`
    match self.peek().kind {
      TokKind::Dot => {
        let _ = self.next()
        let (attr, _, _) = match self.expect_ident() {
          Ok(p) => p
          Err(er) => return Err(er)
        }
        match self.next().kind {
          TokKind::Assign => ()
          _ =>
          return Err(
            self.err(ErrorKind::SyntaxError, "expected '=' in set", line, col),
          )
        }
        let item_val = match self.parse_expr() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
        return Ok(Stmt::Set(SetTarget::Attr(vname, attr), item_val, line, col))
      }
      TokKind::Assign => {
        let _ = self.next()
        let item_val = match self.parse_expr() {
          Ok(e) => e
          Err(er) => return Err(er)
        }
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
        return Ok(Stmt::Set(SetTarget::Var(vname), item_val, line, col))
      }
      _ => {
        // Block set: {% set name [| filter] %} ... {% endset %}
        let mut filter_opt : Option[(String, Array[CallArg])] = None
        match self.peek().kind {
          TokKind::Pipe => {
            let _ = self.next()
            let (fnm, _, _) = match self.expect_ident() {
              Ok(p) => p
              Err(er) => return Err(er)
            }
            let fargs = match self.peek().kind {
              TokKind::LParen => {
                let _ = self.next()
                match self.parse_call_args() {
                  Ok(a) => a
                  Err(er) => return Err(er)
                }
              }
              _ => []
            }
            filter_opt = Some((fnm, fargs))
          }
          _ => ()
        }
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
        match self.enter_depth(line, col) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let body = match self.parse_stmts(["endset"]) {
          Ok(b) => b
          Err(er) => {
            self.leave_depth()
            return Err(er)
          }
        }
        self.leave_depth()
        match self.at_end_tag(["endset"]) {
          Some(_) => {
            let _ = self.next()
            let _ = self.next()
            match self.expect_block_end() {
              Ok(()) => ()
              Err(er) => return Err(er)
            }
          }
          None =>
          return Err(
            self.err(ErrorKind::SyntaxError, "unclosed {% set %} block", line, col),
          )
        }
        return Ok(Stmt::SetBlock(vname, filter_opt, body, line, col))
      }
    }
  }

  if tag == "with" {
    let bindings : Array[(String, Expr)] = []
    match self.peek().kind {
      TokKind::BlockEnd => ()
      _ => {
        while true {
          let (k, _, _) = match self.expect_ident() {
            Ok(p) => p
            Err(er) => return Err(er)
          }
          match self.next().kind {
            TokKind::Assign => ()
            _ =>
            return Err(
              self.err(ErrorKind::SyntaxError, "expected '=' in with", line, col),
            )
          }
          let v = match self.parse_expr() {
            Ok(e) => e
            Err(er) => return Err(er)
          }
          bindings.push((k, v))
          match self.peek().kind {
            TokKind::Comma => {
              let _ = self.next()
            }
            _ => break
          }
        }
      }
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endwith"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endwith"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(ErrorKind::SyntaxError, "unclosed {% with %} block", line, col),
      )
    }
    return Ok(Stmt::With(bindings, body, line, col))
  }

  if tag == "filter" {
    let (fname, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => return Err(er)
    }
    let fargs = match self.peek().kind {
      TokKind::LParen => {
        let _ = self.next()
        match self.parse_call_args() {
          Ok(a) => a
          Err(er) => return Err(er)
        }
      }
      _ => []
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endfilter"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endfilter"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(
          ErrorKind::SyntaxError,
          "unclosed {% filter %} block",
          line,
          col,
        ),
      )
    }
    return Ok(Stmt::FilterBlock(fname, fargs, body, line, col))
  }

  if tag == "block" {
    let (bname, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => return Err(er)
    }
    let _ = self.consume_ident("scoped")
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endblock"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endblock"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        // Optional block name after endblock
        match self.peek().kind {
          TokKind::Ident(_) => {
            let _ = self.next()
          }
          _ => ()
        }
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(ErrorKind::SyntaxError, "unclosed {% block %}", line, col),
      )
    }
    self.blocks.push((bname, body))
    return Ok(Stmt::Block(bname, body, line, col))
  }

  if tag == "extends" {
    let e = match self.parse_expr() {
      Ok(ex) => ex
      Err(er) => return Err(er)
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    self.has_extends = true
    return Ok(Stmt::Extends(e, line, col))
  }

  if tag == "include" {
    let e = match self.parse_expr() {
      Ok(ex) => ex
      Err(er) => return Err(er)
    }
    let mut ignore_missing = false
    if self.consume_ident("ignore") {
      if !self.consume_ident("missing") {
        return Err(
          self.err(
            ErrorKind::SyntaxError,
            "expected 'missing' after 'ignore'",
            line,
            col,
          ),
        )
      }
      ignore_missing = true
    }
    if self.consume_ident("with") || self.consume_ident("without") {
      let _ = self.consume_ident("context")
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    return Ok(Stmt::Include(e, ignore_missing, line, col))
  }

  if tag == "macro" {
    let (mname, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => return Err(er)
    }
    match self.next().kind {
      TokKind::LParen => ()
      _ =>
      return Err(
        self.err(ErrorKind::SyntaxError, "expected '(' after macro name", line, col),
      )
    }
    let params : Array[(String, Option[Expr])] = []
    match self.peek().kind {
      TokKind::RParen => {
        let _ = self.next()
      }
      _ => {
        while true {
          let (pname, _, _) = match self.expect_ident() {
            Ok(p) => p
            Err(er) => return Err(er)
          }
          let def_opt : Option[Expr] = match self.peek().kind {
            TokKind::Assign => {
              let _ = self.next()
              match self.parse_expr() {
                Ok(e) => Some(e)
                Err(er) => return Err(er)
              }
            }
            _ => None
          }
          params.push((pname, def_opt))
          match self.peek().kind {
            TokKind::Comma => {
              let _ = self.next()
              match self.peek().kind {
                TokKind::RParen => {
                  let _ = self.next()
                  break
                }
                _ => ()
              }
            }
            TokKind::RParen => {
              let _ = self.next()
              break
            }
            _ =>
            return Err(
              self.err(
                ErrorKind::SyntaxError,
                "expected ',' or ')' in macro params",
                line,
                col,
              ),
            )
          }
        }
      }
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endmacro"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endmacro"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(ErrorKind::SyntaxError, "unclosed {% macro %}", line, col),
      )
    }
    return Ok(
      Stmt::Macro(
        MacroDef::{ name: mname, params: params, body: body, line: line, col: col },
      ),
    )
  }

  if tag == "call" {
    let caller_params : Array[String] = []
    match self.peek().kind {
      TokKind::LParen => {
        let _ = self.next()
        match self.peek().kind {
          TokKind::RParen => {
            let _ = self.next()
          }
          _ => {
            while true {
              let (pn, _, _) = match self.expect_ident() {
                Ok(p) => p
                Err(er) => return Err(er)
              }
              caller_params.push(pn)
              match self.peek().kind {
                TokKind::Comma => {
                  let _ = self.next()
                }
                TokKind::RParen => {
                  let _ = self.next()
                  break
                }
                _ =>
                return Err(
                  self.err(
                    ErrorKind::SyntaxError,
                    "expected ',' or ')' in call params",
                    line,
                    col,
                  ),
                )
              }
            }
          }
        }
      }
      _ => ()
    }
    let call_expr = match self.parse_expr() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    let (callee, args) = match call_expr {
      Expr::Call(c, a, _, _) => (c, a)
      _ =>
      return Err(
        self.err(
          ErrorKind::SyntaxError,
          "expected macro call expression in {% call %}",
          line,
          col,
        ),
      )
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endcall"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endcall"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(ErrorKind::SyntaxError, "unclosed {% call %}", line, col),
      )
    }
    return Ok(Stmt::CallBlock(callee, args, caller_params, body, line, col))
  }

  if tag == "import" {
    let tpl_expr = match self.parse_expr() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    if !self.consume_ident("as") {
      return Err(
        self.err(ErrorKind::SyntaxError, "expected 'as' in import", line, col),
      )
    }
    let (alias, _, _) = match self.expect_ident() {
      Ok(p) => p
      Err(er) => return Err(er)
    }
    if self.consume_ident("with") || self.consume_ident("without") {
      let _ = self.consume_ident("context")
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    return Ok(Stmt::Import(tpl_expr, alias, line, col))
  }

  if tag == "from" {
    let tpl_expr = match self.parse_expr() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    if !self.consume_ident("import") {
      return Err(
        self.err(ErrorKind::SyntaxError, "expected 'import' after from", line, col),
      )
    }
    let names : Array[(String, String)] = []
    while true {
      let (orig, _, _) = match self.expect_ident() {
        Ok(p) => p
        Err(er) => return Err(er)
      }
      let alias = if self.consume_ident("as") {
        match self.expect_ident() {
          Ok((a, _, _)) => a
          Err(er) => return Err(er)
        }
      } else {
        orig
      }
      names.push((orig, alias))
      match self.peek().kind {
        TokKind::Comma => {
          let _ = self.next()
        }
        _ => break
      }
    }
    if self.consume_ident("with") || self.consume_ident("without") {
      let _ = self.consume_ident("context")
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    return Ok(Stmt::FromImport(tpl_expr, names, line, col))
  }

  if tag == "autoescape" {
    let flag_expr = match self.parse_expr() {
      Ok(e) => e
      Err(er) => return Err(er)
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    match self.enter_depth(line, col) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_stmts(["endautoescape"]) {
      Ok(b) => b
      Err(er) => {
        self.leave_depth()
        return Err(er)
      }
    }
    self.leave_depth()
    match self.at_end_tag(["endautoescape"]) {
      Some(_) => {
        let _ = self.next()
        let _ = self.next()
        match self.expect_block_end() {
          Ok(()) => ()
          Err(er) => return Err(er)
        }
      }
      None =>
      return Err(
        self.err(
          ErrorKind::SyntaxError,
          "unclosed {% autoescape %}",
          line,
          col,
        ),
      )
    }
    return Ok(Stmt::AutoEscapeBlock(flag_expr, body, line, col))
  }

  if tag == "do" {
    let e = match self.parse_expr() {
      Ok(ex) => ex
      Err(er) => return Err(er)
    }
    match self.expect_block_end() {
      Ok(()) => ()
      Err(er) => return Err(er)
    }
    return Ok(Stmt::Do(e, line, col))
  }

  let _ = start_tok
  Err(
    self.err(
      ErrorKind::SyntaxError,
      "unknown block tag '" + tag + "'",
      line,
      col,
    ),
  )
}

///| Compile a template source string into a `CompiledTemplate`.
fn compile_template(
  name : String,
  src : String,
  cfg : LexConfig,
  max_depth : Int,
) -> Result[CompiledTemplate, TemplateError] {
  let opt_name = if name.length() > 0 { Some(name) } else { None }
  let tokens = match lex_template(src, opt_name, cfg) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let p = Parser::new(tokens, opt_name, max_depth)
  let body = match p.parse_stmts([]) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  Ok(
    CompiledTemplate::{
      name: name,
      body: body,
      blocks: p.blocks,
      has_extends: p.has_extends,
    },
  )
}

///| Parse a standalone expression string.
fn parse_expr_string(
  src : String,
  max_depth : Int,
) -> Result[Expr, TemplateError] {
  let tokens = match lex_expression(src, None) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let p = Parser::new(tokens, None, max_depth)
  let e = match p.parse_expr() {
    Ok(ex) => ex
    Err(er) => return Err(er)
  }
  match p.peek().kind {
    TokKind::Eof => Ok(e)
    _ => {
      let t = p.peek()
      Err(
        p.err(
          ErrorKind::SyntaxError,
          "unexpected trailing token in expression",
          t.line,
          t.col,
        ),
      )
    }
  }
}
