///| Red-team prosecution suite for `packages/template` (branch audit/redteam-template).
///|
///| Every non-`control_` test asserts the behaviour Rust `minijinja =3.1.0` exhibits on
///| the same template (each expected string was produced by audit/diff/rust, see
///| REPORT.md), or the limit the package README promises. A FAILING test is evidence
///| against the Pion package; it should PASS once the defect is fixed.
///| Tests prefixed `control_` are negative controls expected to PASS: attack surface
///| that was probed and found sound.
///| Crash / OOM / hang attacks are NOT here (they would take the test runner down):
///| they run process-isolated via `run_audit.sh dos`.

import "template"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn s(x : String) -> template::Value {
  template::Value::from_string(x)
}

///|
fn ctx() -> template::Value {
  template::Value::from_map([
    ("close", s("</script><script>alert(1)</script>")),
    ("xss", s("<b>&'")),
    ("amp", s("a&b")),
    ("safe_html", template::Value::safe("<b>ok</b>")),
    ("uni", s("héllo wörld ✓")),
    ("imax", template::Value::from_i64(9223372036854775807L)),
    ("imin", template::Value::from_i64(-9223372036854775807L - 1L)),
    (
      "users",
      template::Value::from_seq([
        template::Value::from_map([
          ("name", s("alice")),
          ("age", template::Value::from_int(30)),
          ("group", s("admin")),
        ]),
        template::Value::from_map([
          ("name", s("bob")),
          ("age", template::Value::from_int(25)),
          ("group", s("dev")),
        ]),
        template::Value::from_map([
          ("name", s("carol")),
          ("age", template::Value::from_int(35)),
          ("group", s("dev")),
        ]),
      ]),
    ),
  ])
}

///|
fn env_of(mode : template::AutoEscape) -> template::Environment {
  let env = template::Environment::new()
  env.set_auto_escape(mode)
  env
}

///|
fn render_with(env : template::Environment, src : String) -> String {
  match env.render_str(src, ctx()) {
    Ok(out) => out
    Err(e) => "<ERR " + e.to_string() + ">"
  }
}

///|
fn expect(
  mode : template::AutoEscape,
  src : String,
  want : String,
  label : String,
) -> Unit {
  let got = render_with(env_of(mode), src)
  debug_assert(got == want, label + ": expected `" + want + "`, got `" + got + "`")
}

///|
fn html(src : String, want : String, label : String) -> Unit {
  expect(template::AutoEscape::Html, src, want, label)
}

///|
fn txt(src : String, want : String, label : String) -> Unit {
  expect(template::AutoEscape::None, src, want, label)
}

///|
fn expect_err(src : String, label : String) -> Unit {
  let env = env_of(template::AutoEscape::None)
  match env.render_str(src, ctx()) {
    Ok(out) => debug_assert(false, label + ": expected an error, got `" + out + "`")
    Err(_) => ()
  }
}

///|
fn not_contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return false
    }
    i = i + 1
  }
  true
}

// ---------------------------------------------------------------------------
// P0 — XSS: |tojson is not HTML-safe but is marked safe
// ---------------------------------------------------------------------------

///|
test "p0_tojson_script_breakout" {
  let out = render_with(
    env_of(template::AutoEscape::Html),
    "<script>var x = {{ close|tojson }};</script>",
  )
  debug_assert(
    not_contains(out, "</script><script>"),
    "tojson output inside <script> must not contain a raw </script>: " + out,
  )
  html(
    "{{ close|tojson }}",
    "\"\\u003c/script\\u003e\\u003cscript\\u003ealert(1)\\u003c/script\\u003e\"",
    "tojson must escape < > as \\u003c \\u003e",
  )
}

///|
test "p0_tojson_attr_breakout" {
  // Single-quoted HTML attribute: ' must become \u0027, & must become \u0026.
  html(
    "<div data-x='{{ xss|tojson }}'>",
    "<div data-x='\"\\u003cb\\u003e\\u0026\\u0027\"'>",
    "tojson inside single-quoted attribute",
  )
}

// ---------------------------------------------------------------------------
// P0 — sandbox limits bypassed (small-scale reproductions; full-size in dos)
// ---------------------------------------------------------------------------

///|
test "p0_replace_chain_bypasses_max_output_bytes" {
  // 10 -> 10^7 bytes through |replace never touches the output check.
  let env = template::Environment::new()
  env.set_max_output_bytes(1048576)
  let src = "{{ 'aaaaaaaaaa'" +
  "|replace('a', 'aaaaaaaaaa')|replace('a', 'aaaaaaaaaa')|replace('a', 'aaaaaaaaaa')" +
  "|replace('a', 'aaaaaaaaaa')|replace('a', 'aaaaaaaaaa')|replace('a', 'aaaaaaaaaa')" +
  "|length }}"
  match env.render_str(src, ctx()) {
    Ok(out) =>
    debug_assert(
      false,
      "a 10 MB intermediate string must hit max_output_bytes (1 MiB), rendered " + out,
    )
    Err(_) => ()
  }
}

///|
test "p0_list_doubling_bypasses_max_output_bytes" {
  // 2^22 elements via `l + l` while max_output_bytes = 1 MiB.
  let env = template::Environment::new()
  env.set_max_output_bytes(1048576)
  let src = "{% set ns = namespace(l=[1]) %}{% for i in range(22) %}{% set ns.l = ns.l + ns.l %}{% endfor %}{{ ns.l|length }}"
  match env.render_str(src, ctx()) {
    Ok(out) =>
    debug_assert(false, "4M-element list must hit a memory limit, rendered " + out)
    Err(_) => ()
  }
}

///|
test "p0_unique_quadratic_not_fueled" {
  // |unique is O(n^2) and charges no fuel: 20000 distinct items = 2*10^8 compares
  // under a 100000-step fuel budget.
  let env = template::Environment::new()
  env.set_fuel(Some(100000L))
  match env.render_str("{{ (range(20000)|list)|unique|list|length }}", ctx()) {
    Ok(out) =>
    debug_assert(false, "O(n^2) |unique must be charged fuel, rendered " + out)
    Err(_) => ()
  }
}

///|
test "p0_binop_chain_bypasses_max_depth" {
  // `1 + 1 + ... + 1` builds a 2000-deep left-leaning AST that the evaluator
  // recurses into; max_depth=64 is never consulted (100000 terms = SIGSEGV).
  let env = template::Environment::new()
  env.set_max_depth(64)
  let sb = StringBuilder::new()
  sb.write_string("{{ 1")
  let mut i = 0
  while i < 2000 {
    sb.write_string(" + 1")
    i = i + 1
  }
  sb.write_string(" }}")
  match env.render_str(sb.to_string(), ctx()) {
    Ok(out) =>
    debug_assert(false, "2001-term chain must hit max_depth=64, rendered " + out)
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P1 — integer overflow wraps silently / traps on wasm32
// ---------------------------------------------------------------------------

///|
test "p1_int_overflow_no_silent_wrap" {
  txt("{{ imax + 1 }}", "9223372036854775808", "imax + 1 (minijinja: i128 promotion)")
  txt("{{ imax * 2 }}", "18446744073709551614", "imax * 2")
  txt("{{ -imin }}", "9223372036854775808", "-imin")
  txt("{{ imin // -1 }}", "9223372036854775808", "imin // -1 (traps on wasm32)")
  txt("{{ 99999999999999999999 }}", "99999999999999999999", "big int literal")
}

// ---------------------------------------------------------------------------
// P1 — expression semantics
// ---------------------------------------------------------------------------

///|
test "p1_chained_comparison" {
  txt("{{ 1 < 2 < 3 }}", "True", "1 < 2 < 3")
  txt("{{ 3 > 2 > 1 }}", "True", "3 > 2 > 1")
  txt("{% if 1 < 2 < 3 %}y{% else %}n{% endif %}", "y", "chain in if")
}

///|
test "p1_bool_none_display" {
  // minijinja 3.x prints Python-style True/False/None.
  txt("{{ true }} {{ false }} {{ none }}", "True False None", "literals")
  txt("{{ [none, true] }}", "[None, True]", "inside list repr")
}

///|
test "p1_test_with_bare_argument" {
  txt("{{ 9 is divisibleby 3 }}", "True", "is divisibleby 3")
  txt("{{ 2 is gt 1 }}", "True", "is gt 1")
  txt("{{ 'abc' is startingwith 'a' }}", "True", "is startingwith 'a'")
}

///|
test "p1_unicode_strings_are_bytes" {
  txt("{{ uni|length }}", "13", "length counts chars")
  txt("{{ uni[1] }}", "é", "index yields a char")
  txt("{{ uni[::-1] }}", "✓ dlröw olléh", "reverse keeps UTF-8 valid")
  txt("{{ uni|upper }}", "HÉLLO WÖRLD ✓", "upper is Unicode-aware")
}

///|
test "p1_string_unicode_escape" {
  txt("{{ '\\u00e9\\u2713' }}", "é✓", "\\uXXXX in string literal")
}

///|
test "p1_conditional_extends" {
  let env = template::Environment::new()
  let _ = env.add_template("a", "A{% block x %}{% endblock %}")
  let _ = env.add_template("b", "B{% block x %}{% endblock %}")
  let _ = env.add_template(
    "c",
    "{% if true %}{% extends 'a' %}{% else %}{% extends 'b' %}{% endif %}{% block x %}X{% endblock %}",
  )
  let got = match env.render_template("c", ctx()) {
    Ok(o) => o
    Err(e) => "<ERR " + e.to_string() + ">"
  }
  debug_assert(got == "AX", "conditional extends: expected `AX`, got `" + got + "`")
}

///|
test "p1_child_toplevel_set_visible_in_blocks" {
  let env = template::Environment::new()
  let _ = env.add_template("base", "[{% block b %}{% endblock %}]")
  let _ = env.add_template(
    "child",
    "{% extends 'base' %}{% set g = 'G' %}{% block b %}{{ g }}{% endblock %}",
  )
  let got = match env.render_template("child", ctx()) {
    Ok(o) => o
    Err(e) => "<ERR " + e.to_string() + ">"
  }
  debug_assert(got == "[G]", "expected `[G]`, got `" + got + "`")
}

///|
test "p1_import_exports_variables" {
  let env = template::Environment::new()
  let _ = env.add_template("lib", "{% set x = 42 %}")
  let got = match env.render_str("{% import 'lib' as l %}{{ l.x }}", ctx()) {
    Ok(o) => o
    Err(e) => "<ERR " + e.to_string() + ">"
  }
  debug_assert(got == "42", "expected `42`, got `" + got + "`")
}

// ---------------------------------------------------------------------------
// P1 — safe-string taint is dropped => double escaping
// ---------------------------------------------------------------------------

///|
test "p1_filter_block_double_escapes" {
  html(
    "{% filter upper %}<b>{{ amp }}</b>{% endfilter %}",
    "<B>A&AMP;B</B>",
    "filter block output is already escaped",
  )
}

///|
test "p1_set_block_capture_is_safe" {
  html("{% set x %}<i>{{ amp }}{% endset %}{{ x|upper }}", "<I>A&AMP;B", "set block |upper")
}

///|
test "p1_macro_output_filter_double_escapes" {
  html(
    "{% macro m(v) %}<p>{{ v }}</p>{% endmacro %}{{ m(amp)|upper }}",
    "<P>A&AMP;B</P>",
    "macro result |upper",
  )
}

///|
test "p1_safe_preserving_ops" {
  html("{{ safe_html ~ amp }}", "<b>ok</b>a&amp;b", "safe ~ unsafe")
  html("{{ safe_html|upper }}", "<B>OK</B>", "upper keeps safe")
  html("{{ [safe_html, amp]|join('<br>') }}", "<b>ok</b>&lt;br&gt;a&amp;b", "join with safe items")
  html("{{ safe_html|replace('ok', '<i>') }}", "<b>&lt;i&gt;</b>", "replace on safe escapes only the new part")
}

// ---------------------------------------------------------------------------
// P1 — silently ignored filter arguments
// ---------------------------------------------------------------------------

///|
test "p1_filter_kwargs_ignored" {
  txt("{{ users|sum(attribute='age') }}", "90", "sum(attribute=)")
  txt("{{ [1, 2]|sum(start=10) }}", "13", "sum(start=)")
  txt("{{ users|join(', ', attribute='name') }}", "alice, bob, carol", "join(attribute=)")
  txt("{{ users|unique(attribute='group')|map(attribute='name')|join(',') }}", "alice,bob", "unique(attribute=)")
  txt("{{ 'a,b,c'|split(',', 1)|list }}", "['a', 'b,c']", "split maxsplit")
  txt("{{ 2.7|round(method='floor') }} {{ 2.1|round(method='ceil') }}", "2.0 3.0", "round(method=)")
  txt("{{ 'x'|int(5) }}", "5", "int default")
}

///|
test "p1_sort_semantics" {
  txt("{{ ['b', 'a', 'C']|sort }}", "['a', 'b', 'C']", "case-insensitive default")
  txt("{{ [3, 'a', 1.5, none, true]|sort }}", "[None, True, 1.5, 3, 'a']", "mixed types are ordered")
}

///|
test "p1_round_half_even" {
  txt("{{ 2.5|round }} {{ -2.5|round }} {{ 2.675|round(2) }}", "2.0 -2.0 2.67", "round")
  txt("{{ 42|round }}", "42", "int round stays int")
}

///|
test "p1_loop_depth_non_recursive" {
  txt(
    "{% for a in [1] %}{% for b in [1] %}{{ loop.depth }}{% endfor %}{% endfor %}",
    "1",
    "inner non-recursive loop has depth 1",
  )
}

///|
test "p1_arg_count_errors" {
  expect_err("{% macro m(a) %}{{ a }}{% endmacro %}{{ m(1, 2) }}", "too many args")
  expect_err("{% macro m(a) %}{{ a }}{% endmacro %}{{ m(1, z=2) }}", "unknown kwarg")
  expect_err("{% for a, b in [[1, 2, 3]] %}{% endfor %}", "unpack length")
  expect_err("{% block a %}1{% endblock %}{% block a %}2{% endblock %}", "duplicate block")
}

// ---------------------------------------------------------------------------
// controls (expected to PASS)
// ---------------------------------------------------------------------------

///|
test "control_html_escape" {
  html("{{ xss }}", "&lt;b&gt;&amp;&#x27;", "basic escape")
  html("{{ safe_html }}", "<b>ok</b>", "safe passthrough")
  html("{{ xss|e|e }}", "&lt;b&gt;&amp;&#x27;", "no double escape of |e")
  html("{{ xss|upper }}", "&lt;B&gt;&amp;&#x27;", "upper of unsafe stays escaped")
  html("{% set x = xss ~ amp %}{{ x }}", "&lt;b&gt;&amp;&#x27;a&amp;b", "unsafe ~ unsafe stays escaped")
}

///|
test "control_floor_div_mod_negative" {
  txt("{{ (-7) // 2 }} {{ (-7) % 2 }} {{ 7 // -2 }} {{ 7 % -2 }}", "-4 1 -4 -1", "python floor semantics")
}

///|
test "control_short_circuit" {
  txt("{{ 0 or 'fallback' }}|{{ 'a' or 'b' }}|{{ 0 and 1 / 0 }}", "fallback|a|0", "and/or return operands")
}

///|
test "control_for_scope_and_cycles" {
  txt("{% set x = 1 %}{% for i in [1, 2] %}{% set x = i %}{% endfor %}{{ x }}", "1", "for scope")
  let env = template::Environment::new()
  let _ = env.add_template("a", "{% extends 'b' %}")
  let _ = env.add_template("b", "{% extends 'a' %}")
  match env.render_template("a", ctx()) {
    Ok(_) => debug_assert(false, "extends cycle must fail")
    Err(_) => ()
  }
}

///|
test "control_deep_parens_rejected" {
  let sb = StringBuilder::new()
  sb.write_string("{{ ")
  let mut i = 0
  while i < 10000 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 10000 {
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string(" }}")
  match template::render(sb.to_string(), ctx()) {
    Ok(_) => debug_assert(false, "10000 nested parens must be rejected")
    Err(_) => ()
  }
}
