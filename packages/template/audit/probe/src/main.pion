///| Red-team probe for `packages/template` (branch audit/redteam-template).
///|
///|   probe diff <corpus>        render every case, print one record per case
///|   probe one <corpus> <name>  render a single case (DoS / crash isolation)
///|
///| Corpus records (written by audit/diff/gen_corpus.py) are separated by 0x1E,
///| fields by 0x1F: name, flags, main source, then (template name, source) pairs.
///| Output records: name 0x1F status(OK|ERR) 0x1F output-or-error 0x1E.
///| The render context is fixed and mirrored byte-for-byte in audit/diff/rust.

import "template"

///|
fn s(x : String) -> template::Value {
  template::Value::from_string(x)
}

///|
fn i(x : Int) -> template::Value {
  template::Value::from_int(x)
}

///|
fn user(name : String, age : Int, active : Bool, group : String) -> template::Value {
  template::Value::from_map([
    ("name", s(name)),
    ("age", i(age)),
    ("active", template::Value::from_bool(active)),
    ("group", s(group)),
  ])
}

///|
fn ctx() -> template::Value {
  template::Value::from_map([
    ("xss", s("<script>alert(\"x\")</script> & 'q' /")),
    ("close", s("</script><script>alert(1)</script>")),
    ("attr", s("\" onmouseover=\"alert(1)")),
    ("amp", s("a&b")),
    ("plain", s("hello world")),
    ("padded", s("  padded  ")),
    ("multi", s("line1\nline2\n\nline4")),
    ("uni", s("héllo wörld ✓")),
    ("n", i(42)),
    ("neg", i(-7)),
    ("zero", i(0)),
    ("f", template::Value::from_float(2.5)),
    ("imax", template::Value::from_i64(9223372036854775807L)),
    ("imin", template::Value::from_i64(-9223372036854775807L - 1L)),
    ("t", template::Value::from_bool(true)),
    ("fz", template::Value::from_bool(false)),
    ("nil", template::Value::none()),
    ("items", template::Value::from_seq([i(3), i(1), i(2), i(3)])),
    ("words", template::Value::from_seq([s("b"), s("a"), s("C"), s("a")])),
    ("empty", template::Value::from_seq([])),
    (
      "users",
      template::Value::from_seq([
        user("alice<b>", 30, true, "admin"),
        user("bob", 25, false, "dev"),
        user("carol", 35, true, "dev"),
      ]),
    ),
    ("m", template::Value::from_map([("b", i(1)), ("a", i(2))])),
    ("safe_html", template::Value::safe("<b>ok</b>")),
  ])
}

///|
fn has_flag(flags : String, f : String) -> Bool {
  let b = flags.to_bytes()
  let fb = f.to_bytes()
  let n = b.length()
  let m = fb.length()
  let mut st = 0
  while st <= n {
    let mut en = st
    while en < n && b[en].to_int() != 44 {
      en = en + 1
    }
    if en - st == m {
      let mut ok = true
      let mut k = 0
      while k < m {
        if b[st + k].to_int() != fb[k].to_int() {
          ok = false
          break
        }
        k = k + 1
      }
      if ok {
        return true
      }
    }
    st = en + 1
  }
  false
}

///|
fn run_case(fields : Array[String]) -> String {
  let name = fields[0]
  let flags = fields[1]
  let env = template::Environment::new()
  if has_flag(flags, "html") {
    env.set_auto_escape(template::AutoEscape::Html)
  } else if has_flag(flags, "json") {
    env.set_auto_escape(template::AutoEscape::Json)
  } else {
    env.set_auto_escape(template::AutoEscape::None)
  }
  if has_flag(flags, "strict") {
    env.set_undefined_behavior(template::UndefinedBehavior::Strict)
  }
  if has_flag(flags, "trim") {
    env.set_trim_blocks(true)
  }
  if has_flag(flags, "lstrip") {
    env.set_lstrip_blocks(true)
  }
  if has_flag(flags, "keepnl") {
    env.set_keep_trailing_newline(true)
  }
  if has_flag(flags, "nolimits") {
    env.set_fuel(None)
    env.set_max_output_bytes(2147483647)
  }
  let mut k = 3
  while k + 1 < fields.length() {
    match env.add_template(fields[k], fields[k + 1]) {
      Ok(()) => ()
      Err(e) =>
      return name +
      "\u{1f}ERR\u{1f}" +
      template::error_kind_as_str(e.kind()) +
      ": " +
      e.to_string() +
      "\u{1e}"
    }
    k = k + 2
  }
  let res = match env.add_template("main", fields[2]) {
    Ok(()) => env.render_template("main", ctx())
    Err(e) => Err(e)
  }
  match res {
    Ok(out) => name + "\u{1f}OK\u{1f}" + out + "\u{1e}"
    Err(e) =>
    name +
    "\u{1f}ERR\u{1f}" +
    template::error_kind_as_str(e.kind()) +
    ": " +
    e.to_string() +
    "\u{1e}"
  }
}

///|
fn parse_corpus(data : Bytes) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  let n = data.length()
  let mut rs = 0
  while rs < n {
    let mut re = rs
    while re < n && data[re].to_int() != 30 {
      re = re + 1
    }
    let fields : Array[String] = []
    let mut fs = rs
    while fs <= re {
      let mut fe = fs
      while fe < re && data[fe].to_int() != 31 {
        fe = fe + 1
      }
      fields.push(data.slice(fs, fe).to_string())
      fs = fe + 1
    }
    if fields.length() >= 3 {
      out.push(fields)
    }
    rs = re + 1
  }
  out
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: probe diff <corpus> | probe one <corpus> <name>")
    return 2
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "cannot read corpus " + args[2])
      return 1
    }
  }
  let cases = parse_corpus(data)
  let only = if args[1] == "one" && args.length() > 3 { args[3] } else { "" }
  let mut c = 0
  while c < cases.length() {
    let f = cases[c]
    if only == "" || f[0] == only {
      io_print(world, run_case(f))
    }
    c = c + 1
  }
  0
}
