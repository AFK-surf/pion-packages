///| Day-1 red-team security tests: cycle detection (extends/include/macro),
///| max_depth stack overflow protection, fuel DoS protection, max_output_bytes
///| memory bomb protection, and accurate line/col error diagnostics.

///|
test "redteam_extends_cycle_detected" {
  let env = Environment::new()
  must_add(env, "a.txt", "{% extends 'b.txt' %}")
  must_add(env, "b.txt", "{% extends 'a.txt' %}")
  match env.render_template("a.txt", empty_ctx()) {
    Ok(_) => debug_assert(false, "extends cycle must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::RecursionLimit),
      "extends cycle must report RecursionLimit, got " + e.to_string(),
    )
  }
}

///|
test "redteam_include_cycle_detected" {
  let env = Environment::new()
  must_add(env, "inc_a.txt", "A{% include 'inc_b.txt' %}")
  must_add(env, "inc_b.txt", "B{% include 'inc_a.txt' %}")
  match env.render_template("inc_a.txt", empty_ctx()) {
    Ok(_) => debug_assert(false, "include cycle must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::RecursionLimit),
      "include cycle must report RecursionLimit, got " + e.to_string(),
    )
  }
}

///|
test "redteam_macro_recursion_limit" {
  let env = Environment::new()
  env.set_max_depth(16)
  let tpl = "{% macro boom(n) %}{{ boom(n + 1) }}{% endmacro %}{{ boom(0) }}"
  match env.render_str(tpl, empty_ctx()) {
    Ok(_) => debug_assert(false, "infinite macro recursion must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::RecursionLimit) ||
      e.is_kind(ErrorKind::FuelExhausted),
      "macro recursion limit error, got " + e.to_string(),
    )
  }
}

///|
test "redteam_deep_nesting_max_depth" {
  let env = Environment::new()
  env.set_max_depth(16)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 40 {
    sb.write_string("{% if true %}")
    i = i + 1
  }
  sb.write_string("x")
  i = 0
  while i < 40 {
    sb.write_string("{% endif %}")
    i = i + 1
  }
  match env.render_str(sb.to_string(), empty_ctx()) {
    Ok(_) => debug_assert(false, "deep nesting must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::RecursionLimit) ||
      e.is_kind(ErrorKind::SyntaxError),
      "deep nesting error, got " + e.to_string(),
    )
  }
}

///|
test "redteam_fuel_exhaustion_dos" {
  let env = Environment::new()
  env.set_fuel(Some(500L))
  let tpl = "{% for i in range(100000000) %}{{ i }}{% endfor %}"
  match env.render_str(tpl, empty_ctx()) {
    Ok(_) => debug_assert(false, "huge range loop must hit fuel limit")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::FuelExhausted),
      "expected FuelExhausted, got " + e.to_string(),
    )
  }
}

///|
test "redteam_output_limit_string_mul_bomb" {
  let env = Environment::new()
  env.set_max_output_bytes(1024)
  match env.render_str("{{ 'a' * 10000000 }}", empty_ctx()) {
    Ok(_) => debug_assert(false, "string mul bomb must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded, got " + e.to_string(),
    )
  }
  // Loop output bomb
  match env.render_str("{% for i in range(2000) %}0123456789{% endfor %}", empty_ctx()) {
    Ok(_) => debug_assert(false, "loop output bomb must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded on loop, got " + e.to_string(),
    )
  }
}

///|
test "redteam_error_line_and_col" {
  // Syntax error on line 3
  let bad_syntax = "line1\nline2\n  {% if true %} unclosed"
  match render(bad_syntax, empty_ctx()) {
    Ok(_) => debug_assert(false, "unclosed if must fail")
    Err(e) => {
      debug_assert(
        e.is_kind(ErrorKind::SyntaxError),
        "expected SyntaxError, got " + e.to_string(),
      )
      debug_assert(
        e.line() == 3,
        "expected line 3, got " + e.line().to_string(),
      )
    }
  }
  // Runtime error (unknown filter) on line 2, col >= 5
  let bad_filter = "ok\n    {{ 'hi'|no_such_filter }}"
  match render(bad_filter, empty_ctx()) {
    Ok(_) => debug_assert(false, "unknown filter must fail")
    Err(e) => {
      debug_assert(
        e.is_kind(ErrorKind::UnknownFilter),
        "expected UnknownFilter, got " + e.to_string(),
      )
      debug_assert(
        e.line() == 2,
        "expected line 2, got " + e.line().to_string(),
      )
      debug_assert(
        e.col() >= 5,
        "expected col >= 5, got " + e.col().to_string(),
      )
    }
  }
}

///|
test "redteam_p0_tojson_html_safe_xss" {
  let env = Environment::new()
  env.set_auto_escape(AutoEscape::Html)
  let ctx = Value::from_map([
    ("s", Value::from_string("</script><script>alert('x' & 1)</script>")),
  ])
  assert_env_render(
    env,
    "<script>var x = {{ s|tojson }};</script>",
    ctx,
    "<script>var x = \"\\u003c/script\\u003e\\u003cscript\\u003ealert(\\u0027x\\u0027 \\u0026 1)\\u003c/script\\u003e\";</script>",
    "tojson escapes < > & ' inside script/attr",
  )
}

///|
test "redteam_p0_no_trap_int_overflow_and_round" {
  let ctx = Value::from_map([
    ("imax", Value::from_i64(9223372036854775807L)),
    ("imin", Value::from_i64(-9223372036854775807L - 1L)),
  ])
  assert_render("{{ imax + 1 }}", ctx, "9223372036854775808", "i128 add")
  assert_render("{{ imin // -1 }}", ctx, "9223372036854775808", "imin // -1 no trap")
  assert_render("{{ imin % -1 }}", ctx, "0", "imin % -1 no trap")
  assert_render("{{ 1.5|round(1000000) }}", ctx, "1.5", "round huge precision no trap")
  assert_render("{{ 2.5|round }} {{ -2.5|round }} {{ 2.675|round(2) }}", ctx, "2.0 -2.0 2.67", "half-to-even round")
}

///|
test "redteam_p0_chain_depth_and_memory_bombs" {
  let env = Environment::new()
  env.set_max_depth(32)
  let sb = StringBuilder::new()
  sb.write_string("{{ 1")
  let mut i = 0
  while i < 100 {
    sb.write_string(" + 1")
    i = i + 1
  }
  sb.write_string(" }}")
  match env.render_str(sb.to_string(), empty_ctx()) {
    Ok(_) => debug_assert(false, "long binop chain must hit max_depth")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::RecursionLimit),
      "expected RecursionLimit, got " + e.to_string(),
    )
  }

  let env2 = Environment::new()
  env2.set_max_output_bytes(65536)
  match env2.render_str(
    "{{ 'aaaaaaaaaa'|replace('a','aaaaaaaaaa')|replace('a','aaaaaaaaaa')|replace('a','aaaaaaaaaa')|replace('a','aaaaaaaaaa')|replace('a','aaaaaaaaaa')|length }}",
    empty_ctx(),
  ) {
    Ok(_) => debug_assert(false, "replace bomb must hit OutputLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded on replace bomb, got " + e.to_string(),
    )
  }
  match env2.render_str("{{ [1, 2]|batch(1000000000, 0)|length }}", empty_ctx()) {
    Ok(_) => debug_assert(false, "batch fill bomb must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded on batch fill bomb, got " + e.to_string(),
    )
  }
  match env2.render_str("{{ [1, 2]|slice(1000000000)|length }}", empty_ctx()) {
    Ok(_) => debug_assert(false, "slice bomb must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded on slice bomb, got " + e.to_string(),
    )
  }
}

///|
test "redteam_p1_unicode_safe_and_semantics" {
  let env = Environment::new()
  env.set_auto_escape(AutoEscape::Html)
  let ctx = Value::from_map([
    ("amp", Value::from_string("a&b")),
    ("safe_html", Value::safe("<b>ok</b>")),
    ("uni", Value::from_string("héllo wörld ✓")),
  ])
  assert_env_render(env, "{{ uni|length }}|{{ uni[1] }}|{{ uni[::-1] }}|{{ uni|upper }}", ctx, "13|é|✓ dlröw olléh|HÉLLO WÖRLD ✓", "utf-8 codepoint semantics")
  assert_env_render(env, "{% filter upper %}<b>{{ amp }}</b>{% endfilter %}", ctx, "<B>A&AMP;B</B>", "filter block safe")
  assert_env_render(env, "{{ safe_html ~ amp }}", ctx, "<b>ok</b>a&amp;b", "safe concat")
  assert_env_render(env, "{{ 1 < 2 < 3 }} {{ 9 is divisibleby 3 }}", ctx, "True True", "chained cmp and bare test arg")
}
