///| Wasm32 + Native (debug & release) smoke entry for the `template` package.

import "template"

///|
pub fn smoke() -> Int {
  let env = template::Environment::new()
  env.set_auto_escape(template::AutoEscape::Html)
  env.set_undefined_behavior(template::UndefinedBehavior::Strict)
  match env.add_template(
    "base.html",
    "<h1>{% block title %}Base{% endblock %}</h1><div>{% block body %}{% endblock %}</div>",
  ) {
    Ok(()) => ()
    Err(_) => return -1
  }
  match env.add_template(
    "page.html",
    "{% extends 'base.html' %}{% block title %}{{ super() }}: {{ title }}{% endblock %}{% block body %}{% for x in items %}[{{ x|upper }}]{% endfor %}|{{ safe_html }}{% endblock %}",
  ) {
    Ok(()) => ()
    Err(_) => return -2
  }
  let ctx = template::Value::from_map([
    ("title", template::Value::from_string("<Pion & MiniJinja>")),
    (
      "items",
      template::Value::from_seq([
        template::Value::from_string("a"),
        template::Value::from_string("b"),
      ]),
    ),
    ("safe_html", template::Value::safe("<b>ok</b>")),
  ])
  let out = match env.render_template("page.html", ctx) {
    Ok(s) => s
    Err(_) => return -3
  }
  let expected = "<h1>Base: &lt;Pion &amp; MiniJinja&gt;</h1><div>[A][B]|<b>ok</b></div>"
  if out != expected {
    return -4
  }
  // Verify strict undefined rejection
  match env.render_str("{{ nope }}", template::Value::from_map([])) {
    Ok(_) => return -5
    Err(e) =>
    if !e.is_kind(template::ErrorKind::UndefinedError) {
      return -6
    }
  }
  // Verify fuel DoS protection
  let env2 = template::Environment::new()
  env2.set_fuel(Some(100L))
  match env2.render_str("{% for i in range(1000000) %}{{ i }}{% endfor %}", template::Value::from_map([])) {
    Ok(_) => return -7
    Err(e) =>
    if !e.is_kind(template::ErrorKind::FuelExhausted) {
      return -8
    }
  }
  out.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  if smoke() > 0 {
    0
  } else {
    1
  }
}
