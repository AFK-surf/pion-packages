///| Compliance tests for expressions: arithmetic, comparisons, logic, membership,
///| ternary, string concat, indexing, slicing, attribute access, literals, precedence.

///|
test "expr_arithmetic_and_precedence" {
  assert_render("{{ 1 + 2 * 3 }}", empty_ctx(), "7", "mul before add")
  assert_render("{{ (1 + 2) * 3 }}", empty_ctx(), "9", "parens")
  assert_render("{{ 10 - 3 - 2 }}", empty_ctx(), "5", "left assoc sub")
  assert_render("{{ 7 // 2 }}", empty_ctx(), "3", "floor div pos")
  assert_render("{{ -7 // 2 }}", empty_ctx(), "-4", "floor div neg")
  assert_render("{{ 5 / 2 }}", empty_ctx(), "2.5", "float div")
  assert_render("{{ 10 % 3 }}", empty_ctx(), "1", "modulo")
  assert_render("{{ 2 ** 10 }}", empty_ctx(), "1024", "power")
  assert_render("{{ -5 + +3 }}", empty_ctx(), "-2", "unary plus/minus")
  assert_render("{{ 'ab' * 3 }}", empty_ctx(), "ababab", "string repeat")
  assert_render("{{ 3 * 'xy' }}", empty_ctx(), "xyxyxy", "int * string")
  assert_render("{{ [1, 2] + [3, 4] }}", empty_ctx(), "[1, 2, 3, 4]", "list concat")
}

///|
test "expr_comparisons_and_logic" {
  assert_render("{{ 1 == 1 }} {{ 1 != 2 }}", empty_ctx(), "true true", "eq ne")
  assert_render("{{ 1 == 1.0 }}", empty_ctx(), "true", "int float eq")
  assert_render("{{ 2 < 3 }} {{ 3 <= 3 }} {{ 4 > 3 }} {{ 4 >= 5 }}", empty_ctx(), "true true true false", "ordering")
  assert_render("{{ 'abc' < 'abd' }}", empty_ctx(), "true", "string ordering")
  assert_render("{{ true and false }} {{ true or false }}", empty_ctx(), "false true", "and or")
  assert_render("{{ not false }} {{ not true }}", empty_ctx(), "true false", "not")
  // Short-circuiting: 1 / 0 must not be evaluated
  assert_render("{{ false and (1 / 0) }}", empty_ctx(), "false", "and short-circuit")
  assert_render("{{ true or (1 / 0) }}", empty_ctx(), "true", "or short-circuit")
  // Value-returning and/or semantics
  assert_render("{{ '' or 'fallback' }}", empty_ctx(), "fallback", "or returns rhs")
  assert_render("{{ 'a' and 'b' }}", empty_ctx(), "b", "and returns rhs")
}

///|
test "expr_membership_and_concat" {
  assert_render("{{ 2 in [1, 2, 3] }}", empty_ctx(), "true", "in list")
  assert_render("{{ 4 not in [1, 2, 3] }}", empty_ctx(), "true", "not in list")
  assert_render("{{ 'ell' in 'hello' }}", empty_ctx(), "true", "substr in str")
  assert_render("{{ 'z' in 'hello' }}", empty_ctx(), "false", "substr not in str")
  assert_render("{{ 'a' in {'a': 1, 'b': 2} }}", empty_ctx(), "true", "key in map")
  assert_render("{{ 'c' not in {'a': 1} }}", empty_ctx(), "true", "key not in map")
  assert_render("{{ 'hello' ~ ' ' ~ 42 }}", empty_ctx(), "hello 42", "tilde concat")
}

///|
test "expr_ternary" {
  let ctx = Value::from_map([("ok", Value::from_bool(true)), ("no", Value::from_bool(false))])
  assert_render("{{ 'yes' if ok else 'no' }}", ctx, "yes", "ternary true")
  assert_render("{{ 'yes' if no else 'no' }}", ctx, "no", "ternary false")
  assert_render("{{ 'only' if no }}", ctx, "", "ternary without else falsy")
  assert_render("{{ 'only' if ok }}", ctx, "only", "ternary without else truthy")
}

///|
test "expr_indexing_slicing_and_attr" {
  let ctx = Value::from_map([
    (
      "arr",
      Value::from_seq([
        Value::from_int(10),
        Value::from_int(20),
        Value::from_int(30),
        Value::from_int(40),
        Value::from_int(50),
      ]),
    ),
    ("s", Value::from_string("abcdef")),
    (
      "user",
      Value::from_map([
        ("name", Value::from_string("Ada")),
        (
          "meta",
          Value::from_map([("role", Value::from_string("admin"))]),
        ),
      ]),
    ),
  ])
  assert_render("{{ arr[0] }} {{ arr[-1] }}", ctx, "10 50", "list index")
  assert_render("{{ arr[1:3] }}", ctx, "[20, 30]", "list slice 1:3")
  assert_render("{{ arr[:2] }}", ctx, "[10, 20]", "list slice :2")
  assert_render("{{ arr[3:] }}", ctx, "[40, 50]", "list slice 3:")
  assert_render("{{ arr[::2] }}", ctx, "[10, 30, 50]", "list slice step 2")
  assert_render("{{ arr[::-1] }}", ctx, "[50, 40, 30, 20, 10]", "list slice reverse")
  assert_render("{{ s[1:4] }}", ctx, "bcd", "string slice")
  assert_render("{{ s[::-1] }}", ctx, "fedcba", "string reverse slice")
  assert_render("{{ user.name }}-{{ user['meta'].role }}", ctx, "Ada-admin", "attr and key")
}

///|
test "expr_list_dict_literals_and_eval_expr" {
  assert_render("{{ [1, 2, 3]|length }}", empty_ctx(), "3", "list literal")
  assert_render("{{ {'a': 1, 'b': 2}.b }}", empty_ctx(), "2", "dict literal")
  let env = Environment::new()
  let ctx = Value::from_map([("x", Value::from_int(6)), ("y", Value::from_int(7))])
  match env.eval_expr("x * y", ctx) {
    Ok(v) =>
    debug_assert(v.equals(Value::from_int(42)), "eval_expr 6*7==42")
    Err(e) => debug_assert(false, "eval_expr failed: " + e.to_string())
  }
}
