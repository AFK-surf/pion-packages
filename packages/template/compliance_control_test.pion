///| Compliance tests for control flow: if/elif/else, for loops (loop.* vars,
///| else, filtering, unpacking, nested), set (inline & block), with, filter block,
///| built-in functions (range, dict, namespace).

///|
test "control_if_elif_else" {
  let tpl = "{% if x > 10 %}big{% elif x > 0 %}small{% else %}zero_or_neg{% endif %}"
  assert_render(tpl, Value::from_map([("x", Value::from_int(20))]), "big", "if branch")
  assert_render(tpl, Value::from_map([("x", Value::from_int(5))]), "small", "elif branch")
  assert_render(tpl, Value::from_map([("x", Value::from_int(0))]), "zero_or_neg", "else branch")
}

///|
test "control_for_loop_variables" {
  let tpl = "{% for x in ['a', 'b', 'c'] %}{{ loop.index }}/{{ loop.index0 }}/{{ loop.revindex }}/{{ loop.revindex0 }}/{{ loop.length }}/{{ loop.first }}/{{ loop.last }}:{{ x }};{% endfor %}"
  let expected = "1/0/3/2/3/True/False:a;2/1/2/1/3/False/False:b;3/2/1/0/3/False/True:c;"
  assert_render(tpl, empty_ctx(), expected, "loop vars")
}

///|
test "control_for_prev_next_cycle_depth" {
  let tpl = "{% for x in [1, 2, 3] %}[{{ loop.previtem|default('-') }},{{ x }},{{ loop.nextitem|default('-') }},{{ loop.cycle('odd', 'even') }}]{% endfor %}"
  assert_render(
    tpl,
    empty_ctx(),
    "[-,1,2,odd][1,2,3,even][2,3,-,odd]",
    "previtem/nextitem/cycle",
  )
  let nested = "{% for a in [1] %}{{ loop.depth }}/{% for b in [2] %}{{ loop.depth }}/{{ loop.depth0 }}{% endfor %}{% endfor %}"
  assert_render(nested, empty_ctx(), "1/1/0", "nested loop depth")
}

///|
test "control_for_else_and_filter_and_unpack" {
  assert_render(
    "{% for x in [] %}{{ x }}{% else %}empty{% endfor %}",
    empty_ctx(),
    "empty",
    "for else empty",
  )
  assert_render(
    "{% for x in [1, 2, 3, 4, 5] if x is even %}{{ x }}{% endfor %}",
    empty_ctx(),
    "24",
    "for if filter",
  )
  let ctx = Value::from_map([
    (
      "m",
      Value::from_map([
        ("a", Value::from_int(1)),
        ("b", Value::from_int(2)),
      ]),
    ),
  ])
  assert_render(
    "{% for k, v in m|items %}{{ k }}={{ v }};{% endfor %}",
    ctx,
    "a=1;b=2;",
    "for k, v in dict|items",
  )
  assert_render(
    "{% for a, b in [[1, 'x'], [2, 'y']] %}{{ a }}:{{ b }};{% endfor %}",
    empty_ctx(),
    "1:x;2:y;",
    "tuple unpack seq",
  )
}

///|
test "control_set_with_filter_block" {
  assert_render(
    "{% set x = 10 %}{% set y = x * 2 %}{{ y }}",
    empty_ctx(),
    "20",
    "set inline",
  )
  assert_render(
    "{% set msg %}hello {{ 'world'|upper }}{% endset %}[{{ msg }}]",
    empty_ctx(),
    "[hello WORLD]",
    "set block",
  )
  assert_render(
    "{% set x = 1 %}{% with x = 2, y = 3 %}{{ x }}-{{ y }}{% endwith %}-{{ x }}",
    empty_ctx(),
    "2-3-1",
    "with scoping",
  )
  assert_render(
    "{% filter upper %}hello {{ 'pion' }}{% endfilter %}",
    empty_ctx(),
    "HELLO PION",
    "filter block",
  )
}

///|
test "control_builtin_functions_range_dict_namespace" {
  assert_render(
    "{% for i in range(4) %}{{ i }}{% endfor %}",
    empty_ctx(),
    "0123",
    "range(stop)",
  )
  assert_render(
    "{% for i in range(1, 6, 2) %}{{ i }}{% endfor %}",
    empty_ctx(),
    "135",
    "range(start, stop, step)",
  )
  assert_render(
    "{% set d = dict(a=1, b='two') %}{{ d.a }}-{{ d.b }}",
    empty_ctx(),
    "1-two",
    "dict() kwargs",
  )
  assert_render(
    "{% set ns = namespace(total=0) %}{% for i in [1, 2, 3, 4] %}{% set ns.total = ns.total + i %}{% endfor %}{{ ns.total }}",
    empty_ctx(),
    "10",
    "namespace mutation across loop",
  )
}
