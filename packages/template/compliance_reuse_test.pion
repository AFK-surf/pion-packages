///| Compliance tests for template reuse: extends, block, super(), multilevel
///| inheritance, include (normal + ignore missing), macro (defaults, kwargs, caller),
///| import / from ... import.

fn must_add(env : Environment, name : String, src : String) -> Unit {
  match env.add_template(name, src) {
    Ok(()) => ()
    Err(e) =>
    debug_assert(false, "add_template(" + name + ") failed: " + e.to_string())
  }
}

fn assert_tpl(
  env : Environment,
  name : String,
  ctx : Value,
  expected : String,
  label : String,
) -> Unit {
  match env.render_template(name, ctx) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) => debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

///|
test "reuse_extends_and_super_multilevel" {
  let env = Environment::new()
  must_add(
    env,
    "base.txt",
    "[{% block title %}Base{% endblock %}|{% block body %}BaseBody{% endblock %}]",
  )
  must_add(
    env,
    "mid.txt",
    "{% extends 'base.txt' %}{% block title %}{{ super() }} > Mid{% endblock %}{% block body %}Mid({{ super() }}){% endblock %}",
  )
  must_add(
    env,
    "leaf.txt",
    "{% extends 'mid.txt' %}{% block title %}{{ super() }} > Leaf{% endblock %}",
  )
  assert_tpl(
    env,
    "leaf.txt",
    empty_ctx(),
    "[Base > Mid > Leaf|Mid(BaseBody)]",
    "3-level extends + super()",
  )
}

///|
test "reuse_include_and_ignore_missing" {
  let env = Environment::new()
  must_add(env, "header.txt", "HDR({{ user }})")
  must_add(
    env,
    "page.txt",
    "{% include 'header.txt' %}-BODY-{% include 'nope.txt' ignore missing %}END",
  )
  let ctx = Value::from_map([("user", Value::from_string("Ada"))])
  assert_tpl(env, "page.txt", ctx, "HDR(Ada)-BODY-END", "include + ignore missing")

  must_add(env, "bad.txt", "{% include 'missing.txt' %}")
  match env.render_template("bad.txt", empty_ctx()) {
    Ok(_) => debug_assert(false, "missing include must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::TemplateNotFound),
      "missing include error kind",
    )
  }
}

///|
test "reuse_macro_defaults_kwargs_and_caller" {
  let tpl = "{% macro greet(name, punct='!') %}Hello {{ name }}{{ punct }}{% endmacro %}{{ greet('Pion') }}|{{ greet('Rust', '?') }}|{{ greet(name='World', punct='...') }}"
  assert_render(
    tpl,
    empty_ctx(),
    "Hello Pion!|Hello Rust?|Hello World...",
    "macro args/defaults/kwargs",
  )
  let call_tpl = "{% macro box(title) %}[{{ title }}: {{ caller() }}]{% endmacro %}{% call box('Note') %}inner {{ 1 + 2 }}{% endcall %}"
  assert_render(call_tpl, empty_ctx(), "[Note: inner 3]", "macro call/caller")
}

///|
test "reuse_import_and_from_import" {
  let env = Environment::new()
  must_add(
    env,
    "macros.txt",
    "{% macro double(x) %}{{ x * 2 }}{% endmacro %}{% macro wrap(s, tag='b') %}<{{ tag }}>{{ s }}</{{ tag }}>{% endmacro %}",
  )
  must_add(
    env,
    "use_import.txt",
    "{% import 'macros.txt' as m %}{{ m.double(21) }}|{{ m.wrap('hi', 'i') }}",
  )
  must_add(
    env,
    "use_from.txt",
    "{% from 'macros.txt' import double as dbl, wrap %}{{ dbl(5) }}|{{ wrap('ok') }}",
  )
  assert_tpl(env, "use_import.txt", empty_ctx(), "42|<i>hi</i>", "import as")
  assert_tpl(env, "use_from.txt", empty_ctx(), "10|<b>ok</b>", "from import as")
}
