///| Compliance tests for lexer, whitespace control, comments, raw blocks, literals.

fn assert_render(src : String, ctx : Value, expected : String, label : String) -> Unit {
  match render(src, ctx) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) => debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

fn assert_env_render(
  env : Environment,
  src : String,
  ctx : Value,
  expected : String,
  label : String,
) -> Unit {
  match env.render_str(src, ctx) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) => debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

fn empty_ctx() -> Value {
  Value::from_map([])
}

///|
test "syntax_plain_text_and_basic_var" {
  assert_render("Hello, world!", empty_ctx(), "Hello, world!", "plain")
  let ctx = Value::from_map([("name", Value::from_string("Pion"))])
  assert_render("Hello, {{ name }}!", ctx, "Hello, Pion!", "basic var")
  assert_render("{{name}}", ctx, "Pion", "no spaces")
}

///|
test "syntax_comments" {
  assert_render("a{# comment #}b", empty_ctx(), "ab", "inline comment")
  assert_render(
    "a{# multi\nline\ncomment #}b",
    empty_ctx(),
    "ab",
    "multiline comment",
  )
  assert_render("a  {#- trim -#}  b", empty_ctx(), "ab", "comment whitespace trim")
}

///|
test "syntax_whitespace_control" {
  let ctx = Value::from_map([("x", Value::from_string("ok"))])
  assert_render("a  {{- x -}}  b", ctx, "aokb", "var trim both")
  assert_render("a\n  {{- x }}  b", ctx, "aok  b", "var trim left")
  assert_render("a  {{ x -}}\n  b", ctx, "a  okb", "var trim right")
  assert_render(
    "a  {%- if true -%}  yes  {%- endif -%}  b",
    empty_ctx(),
    "ayesb",
    "stmt trim both",
  )
  assert_render(
    "[\n  {%- for i in [1, 2, 3] -%}\n    {{ i }}\n  {%- endfor -%}\n]",
    empty_ctx(),
    "[123]",
    "loop trim",
  )
}

///|
test "syntax_raw_block" {
  assert_render(
    "{% raw %}{{ not_eval }} {% if x %}{# not comment #}{% endraw %}",
    empty_ctx(),
    "{{ not_eval }} {% if x %}{# not comment #}",
    "raw block",
  )
  assert_render(
    "a  {%- raw -%}  {{ x }}  {%- endraw -%}  b",
    empty_ctx(),
    "a  {{ x }}  b",
    "raw block with trim",
  )
}

///|
test "syntax_trailing_newline_policy" {
  let env_default = Environment::new()
  assert_env_render(
    env_default,
    "hello\n",
    empty_ctx(),
    "hello",
    "strip single trailing lf",
  )
  assert_env_render(
    env_default,
    "hello\r\n",
    empty_ctx(),
    "hello",
    "strip single trailing crlf",
  )
  assert_env_render(
    env_default,
    "hello\n\n",
    empty_ctx(),
    "hello\n",
    "strip only one trailing lf",
  )
  let env_keep = Environment::new()
  env_keep.set_keep_trailing_newline(true)
  assert_env_render(
    env_keep,
    "hello\n",
    empty_ctx(),
    "hello\n",
    "keep trailing newline",
  )
}

///|
test "syntax_trim_and_lstrip_blocks" {
  let env = Environment::new()
  env.set_trim_blocks(true)
  env.set_lstrip_blocks(true)
  let tpl = "<div>\n  {% if true %}\n  hello\n  {% endif %}\n</div>"
  assert_env_render(
    env,
    tpl,
    empty_ctx(),
    "<div>\n  hello\n</div>",
    "trim_blocks + lstrip_blocks",
  )
}

///|
test "syntax_literals_and_escapes" {
  assert_render("{{ 'single' }}", empty_ctx(), "single", "single quoted")
  assert_render("{{ \"double\" }}", empty_ctx(), "double", "double quoted")
  assert_render(
    "{{ \"a\\nb\\tc\\\\d\\\"e\" }}",
    empty_ctx(),
    "a\nb\tc\\d\"e",
    "string escapes",
  )
  assert_render("{{ 42 }}", empty_ctx(), "42", "int literal")
  assert_render("{{ 1_000_000 }}", empty_ctx(), "1000000", "underscore int")
  assert_render("{{ 0xff }}", empty_ctx(), "255", "hex int")
  assert_render("{{ 3.14 }}", empty_ctx(), "3.14", "float literal")
  assert_render("{{ true }} {{ false }}", empty_ctx(), "true false", "bool literals")
  assert_render("{{ True }} {{ False }}", empty_ctx(), "true false", "python bool literals")
  assert_render("{{ none }} {{ None }}", empty_ctx(), "none none", "none literals")
}
