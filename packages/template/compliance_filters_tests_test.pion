///| Compliance tests for all core built-in filters, built-in tests,
///| and custom filters/tests/functions.

///|
test "filters_string_ops" {
  assert_render("{{ 'hello'|upper }}", empty_ctx(), "HELLO", "upper")
  assert_render("{{ 'HeLLo'|lower }}", empty_ctx(), "hello", "lower")
  assert_render("{{ 'hello world'|title }}", empty_ctx(), "Hello World", "title")
  assert_render("{{ 'hELLO wORLD'|capitalize }}", empty_ctx(), "Hello world", "capitalize")
  assert_render("{{ '  hi  '|trim }}", empty_ctx(), "hi", "trim default")
  assert_render("{{ '--hi--'|trim('-') }}", empty_ctx(), "hi", "trim chars")
  assert_render("{{ 'foo bar foo'|replace('foo', 'baz') }}", empty_ctx(), "baz bar baz", "replace all")
  assert_render("{{ 'foo bar foo'|replace('foo', 'baz', 1) }}", empty_ctx(), "baz bar foo", "replace count")
  assert_render("{{ 'a,b,c'|split(',')|join('-') }}", empty_ctx(), "a-b-c", "split + join")
  assert_render("{{ 'one two  three'|wordcount }}", empty_ctx(), "3", "wordcount")
  assert_render("{{ 'a\nb'|indent(2) }}", empty_ctx(), "a\n  b", "indent default")
  assert_render("{{ 'a\nb'|indent(2, true) }}", empty_ctx(), "  a\n  b", "indent first")
  assert_render("{{ 'hello world/a?b=1'|urlencode }}", empty_ctx(), "hello%20world/a%3Fb%3D1", "urlencode")
}

///|
test "filters_sequence_and_mapping" {
  assert_render("{{ [1, 2, 3]|length }}", empty_ctx(), "3", "length")
  assert_render("{{ [10, 20, 30]|first }}", empty_ctx(), "10", "first")
  assert_render("{{ [10, 20, 30]|last }}", empty_ctx(), "30", "last")
  assert_render("{{ [3, 1, 2]|sort }}", empty_ctx(), "[1, 2, 3]", "sort")
  assert_render("{{ [3, 1, 2]|sort(true) }}", empty_ctx(), "[3, 2, 1]", "sort reverse")
  assert_render("{{ [1, 2, 3]|reverse }}", empty_ctx(), "[3, 2, 1]", "reverse list")
  assert_render("{{ 'abc'|reverse }}", empty_ctx(), "cba", "reverse str")
  assert_render("{{ [1, 2, 1, 3, 2]|unique }}", empty_ctx(), "[1, 2, 3]", "unique")
  assert_render("{{ [1, 2, 3, 4, 5]|batch(2) }}", empty_ctx(), "[[1, 2], [3, 4], [5]]", "batch")
  assert_render("{{ [1, 2, 3, 4, 5]|batch(2, 0) }}", empty_ctx(), "[[1, 2], [3, 4], [5, 0]]", "batch fill")
  assert_render("{{ [1, 2, 3, 4, 5]|slice(2) }}", empty_ctx(), "[[1, 2, 3], [4, 5]]", "slice")
  assert_render("{{ 'abc'|list }}", empty_ctx(), "['a', 'b', 'c']", "list of str")
  assert_render("{{ {'k': 1}|items }}", empty_ctx(), "[['k', 1]]", "items")
}

///|
test "filters_map_select_reject" {
  let ctx = Value::from_map([
    (
      "users",
      Value::from_seq([
        Value::from_map([
          ("name", Value::from_string("alice")),
          ("active", Value::from_bool(true)),
        ]),
        Value::from_map([
          ("name", Value::from_string("bob")),
          ("active", Value::from_bool(false)),
        ]),
        Value::from_map([
          ("name", Value::from_string("carol")),
          ("active", Value::from_bool(true)),
        ]),
      ]),
    ),
  ])
  assert_render(
    "{{ users|map(attribute='name')|join(',') }}",
    ctx,
    "alice,bob,carol",
    "map attribute",
  )
  assert_render(
    "{{ ['a', 'b']|map('upper')|join(',') }}",
    empty_ctx(),
    "A,B",
    "map filter",
  )
  assert_render(
    "{{ [1, 2, 3, 4]|select('even')|join(',') }}",
    empty_ctx(),
    "2,4",
    "select",
  )
  assert_render(
    "{{ [1, 2, 3, 4]|reject('even')|join(',') }}",
    empty_ctx(),
    "1,3",
    "reject",
  )
  assert_render(
    "{{ users|selectattr('active')|map(attribute='name')|join(',') }}",
    ctx,
    "alice,carol",
    "selectattr truthy",
  )
  assert_render(
    "{{ users|rejectattr('active')|map(attribute='name')|join(',') }}",
    ctx,
    "bob",
    "rejectattr truthy",
  )
  assert_render(
    "{{ users|selectattr('name', 'eq', 'bob')|map(attribute='name')|join(',') }}",
    ctx,
    "bob",
    "selectattr with test",
  )
}

///|
test "filters_numeric_type_default_tojson" {
  assert_render("{{ (-42)|abs }}", empty_ctx(), "42", "abs int")
  assert_render("{{ (-3.5)|abs }}", empty_ctx(), "3.5", "abs float")
  assert_render("{{ 3.14159|round(2) }}", empty_ctx(), "3.14", "round 2")
  assert_render("{{ 3.6|round }}", empty_ctx(), "4.0", "round 0")
  assert_render("{{ '42'|int }}", empty_ctx(), "42", "int from str")
  assert_render("{{ '3.5'|float }}", empty_ctx(), "3.5", "float from str")
  assert_render("{{ 123|string }}", empty_ctx(), "123", "string from int")
  assert_render("{{ missing|default('N/A') }}", empty_ctx(), "N/A", "default undef")
  assert_render("{{ ''|default('N/A') }}", empty_ctx(), "", "default empty non-bool")
  assert_render("{{ ''|default('N/A', true) }}", empty_ctx(), "N/A", "default empty bool")
  assert_render(
    "{{ {'a': 1, 'b': [true, 'hi']}|tojson }}",
    empty_ctx(),
    "{\"a\": 1, \"b\": [true, \"hi\"]}",
    "tojson default",
  )
}

///|
test "builtin_tests_all" {
  let ctx = Value::from_map([("x", Value::from_int(4)), ("n", Value::none())])
  assert_render("{{ x is defined }} {{ y is undefined }}", ctx, "True True", "defined/undefined")
  assert_render("{{ n is none }} {{ x is not none }}", ctx, "True True", "none")
  assert_render("{{ true is boolean }} {{ 1 is boolean }}", empty_ctx(), "True False", "boolean")
  assert_render("{{ 4 is integer }} {{ 4.5 is float }} {{ 4 is number }} {{ 4.5 is number }}", empty_ctx(), "True True True True", "numeric tests")
  assert_render("{{ 'hi' is string }} {{ [1] is sequence }} {{ {'a': 1} is mapping }}", empty_ctx(), "True True True", "type tests")
  assert_render("{{ [1] is iterable }} {{ 'hi' is iterable }} {{ 1 is iterable }}", empty_ctx(), "True True False", "iterable")
  assert_render("{{ 3 is odd }} {{ 4 is even }} {{ 12 is divisibleby(4) }}", empty_ctx(), "True True True", "odd/even/divisibleby")
  assert_render("{{ 'foobar' is startingwith('foo') }} {{ 'foobar' is endingwith('bar') }}", empty_ctx(), "True True", "startingwith/endingwith")
  assert_render("{{ 2 is in([1, 2, 3]) }}", empty_ctx(), "True", "is in")
  assert_render(
    "{{ 2 is eq(2) }} {{ 2 is ne(3) }} {{ 2 is lt(3) }} {{ 2 is le(2) }} {{ 3 is gt(2) }} {{ 3 is ge(3) }}",
    empty_ctx(),
    "True True True True True True",
    "comparison tests",
  )
}

///|
test "custom_filter_test_function_global" {
  let env = Environment::new()
  env.add_global("app", Value::from_string("Pion"))
  env.add_filter(
    "exclaim",
    fn(v : Value, args : Array[Value]) -> Result[Value, TemplateError] {
      let _ = args
      Ok(Value::from_string(v.to_display_string() + "!!!"))
    },
  )
  env.add_test(
    "positive",
    fn(v : Value, args : Array[Value]) -> Result[Bool, TemplateError] {
      let _ = args
      match v.as_i64() {
        Some(n) => Ok(n > 0L)
        None => Ok(false)
      }
    },
  )
  env.add_function(
    "add_two",
    fn(args : Array[Value]) -> Result[Value, TemplateError] {
      if args.length() != 2 {
        return Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "expected 2 args",
            None,
            0,
            0,
          ),
        )
      }
      match (args[0].as_i64(), args[1].as_i64()) {
        (Some(a), Some(b)) => Ok(Value::from_i64(a + b))
        _ =>
        Err(
          TemplateError::new(
            ErrorKind::InvalidOperation,
            "expected ints",
            None,
            0,
            0,
          ),
        )
      }
    },
  )
  assert_env_render(
    env,
    "{{ app|exclaim }}|{{ 5 is positive }}|{{ add_two(19, 23) }}",
    empty_ctx(),
    "Pion!!!|True|42",
    "custom extensions",
  )
}
