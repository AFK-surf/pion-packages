///| Bench 2: AI Agent Prompt Template Rendering (conditionals + tool list + tojson + join, 20,000 renders).

import "template"

///|
pub fn main(world : World) -> Int {
  let env = template::Environment::new()
  let prompt_tpl = "System: You are {{ agent.name }} (mode={{ agent.mode|default('balanced') }}).\n{% if agent.strict %}Follow all constraints strictly.\n{% endif %}Capabilities: {{ capabilities|join(', ') }}.\nTools ({{ tools|length }}):\n{% for tool in tools %}- {{ loop.index }}. {{ tool.name }}: {{ tool.desc }} | schema={{ tool.schema|tojson(indent=2) }}\n{% endfor %}User: {{ query }}"
  let _ = env.add_template("prompt.txt", prompt_tpl)
  let tpl = match env.get_template("prompt.txt") {
    Ok(t) => t
    Err(_) => return 1
  }

  let ctx = template::Value::from_map([
    (
      "agent",
      template::Value::from_map([
        ("name", template::Value::from_string("PionCoder")),
        ("strict", template::Value::from_bool(true)),
      ]),
    ),
    (
      "capabilities",
      template::Value::from_seq([
        template::Value::from_string("code-search"),
        template::Value::from_string("shell"),
        template::Value::from_string("patch"),
        template::Value::from_string("test"),
      ]),
    ),
    (
      "tools",
      template::Value::from_seq([
        template::Value::from_map([
          ("name", template::Value::from_string("read_file")),
          ("desc", template::Value::from_string("Read a file from workspace")),
          (
            "schema",
            template::Value::from_map([
              ("path", template::Value::from_string("string")),
              ("limit", template::Value::from_int(800)),
            ]),
          ),
        ]),
        template::Value::from_map([
          ("name", template::Value::from_string("edit_file")),
          ("desc", template::Value::from_string("Apply a targeted replacement")),
          (
            "schema",
            template::Value::from_map([
              ("path", template::Value::from_string("string")),
              ("atomic", template::Value::from_bool(true)),
            ]),
          ),
        ]),
        template::Value::from_map([
          ("name", template::Value::from_string("run_test")),
          ("desc", template::Value::from_string("Execute package test suite")),
          (
            "schema",
            template::Value::from_map([
              ("pkg", template::Value::from_string("string")),
              ("jobs", template::Value::from_int(4)),
            ]),
          ),
        ]),
      ]),
    ),
    ("query", template::Value::from_string("Optimize the template AST evaluator hot path.")),
  ])

  let iters = 20000
  let mut total_bytes = 0L
  let mut last = ""
  let mut r = 0
  while r < iters {
    match tpl.render(ctx) {
      Ok(out) => {
        total_bytes = total_bytes + out.length().to_int64()
        if r == iters - 1 {
          last = out
        }
      }
      Err(_) => return 2
    }
    r = r + 1
  }

  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, last)
  0
}
