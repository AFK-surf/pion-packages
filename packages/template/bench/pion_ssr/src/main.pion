///| Bench 1: HTML Page SSR Rendering (extends + block + super() + for table + HTML auto-escape + filters, 10,000 renders).

import "template"

///|
pub fn main(world : World) -> Int {
  let env = template::Environment::new()
  let base_tpl = "<!DOCTYPE html><html><head><title>{% block title %}Dashboard{% endblock %}</title></head><body><main>{% block content %}{% endblock %}</main></body></html>"
  let page_tpl = "{% extends 'base.html' %}{% block title %}{{ super() }} - {{ page_title }}{% endblock %}{% block content %}<h1>{{ heading|title }}</h1><table><tbody>{% for row in rows %}<tr class=\"{{ loop.cycle('odd', 'even') }}\"><td>{{ loop.index }}</td><td>{{ row.name }}</td><td>{{ row.role|upper }}</td><td>{{ row.bio|default('N/A') }}</td></tr>{% endfor %}</tbody></table><p>Total: {{ rows|length }}</p>{% endblock %}"
  let _ = env.add_template("base.html", base_tpl)
  let _ = env.add_template("page.html", page_tpl)
  let tpl = match env.get_template("page.html") {
    Ok(t) => t
    Err(_) => return 1
  }

  let rows : Array[template::Value] = []
  let mut i = 0
  while i < 20 {
    let idx = i.to_string()
    let bio = if i % 3 == 0 {
      template::Value::from_string("Engineer <team-" + idx + "> & \"core\" / R&D")
    } else if i % 3 == 1 {
      template::Value::from_string("Designer 'ui' & layout #" + idx)
    } else {
      template::Value::undefined()
    }
    rows.push(
      template::Value::from_map([
        ("name", template::Value::from_string("User " + idx)),
        ("role", template::Value::from_string(if i % 2 == 0 { "admin" } else { "member" })),
        ("bio", bio),
      ]),
    )
    i = i + 1
  }
  let ctx = template::Value::from_map([
    ("page_title", template::Value::from_string("Team <Overview> & Roster")),
    ("heading", template::Value::from_string("engineering roster")),
    ("rows", template::Value::from_seq(rows)),
  ])

  let iters = 10000
  let mut total_bytes = 0L
  let mut last = ""
  let mut r = 0
  while r < iters {
    match tpl.render(ctx) {
      Ok(out) => {
        total_bytes = total_bytes + out.length().to_int64()
        if r == iters - 1 {
          last = out
        }
      }
      Err(_) => return 2
    }
    r = r + 1
  }

  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, last)
  0
}
