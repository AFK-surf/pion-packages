///| Bench 3: Compile + Render End-to-End (parse & compile 3 templates + render with extends/include/for/escape, 2,000 iterations).

import "template"

///|
pub fn main(world : World) -> Int {
  let base_tpl = "<!DOCTYPE html><html><head><title>{% block title %}App{% endblock %}</title></head><body>{% include 'nav.html' %}{% block body %}{% endblock %}</body></html>"
  let nav_tpl = "<nav>{% for link in nav %}<a href=\"{{ link.href }}\">{{ link.label }}</a>{% endfor %}</nav>"
  let page_tpl = "{% extends 'base.html' %}{% block title %}{{ title }}{% endblock %}{% block body %}<section>{% for item in items %}<article><h2>{{ item.title }}</h2><p>{{ item.summary }}</p></article>{% endfor %}</section>{% endblock %}"

  let ctx = template::Value::from_map([
    ("title", template::Value::from_string("Release Notes <v0.1.0>")),
    (
      "nav",
      template::Value::from_seq([
        template::Value::from_map([
          ("href", template::Value::from_string("/docs")),
          ("label", template::Value::from_string("Docs")),
        ]),
        template::Value::from_map([
          ("href", template::Value::from_string("/bench")),
          ("label", template::Value::from_string("Benchmarks")),
        ]),
      ]),
    ),
    (
      "items",
      template::Value::from_seq([
        template::Value::from_map([
          ("title", template::Value::from_string("Lexer & AST")),
          ("summary", template::Value::from_string("Fast pure-Pion parser & evaluator.")),
        ]),
        template::Value::from_map([
          ("title", template::Value::from_string("Security & Fuel")),
          ("summary", template::Value::from_string("Cycle detection & output limits <safe>.")),
        ]),
        template::Value::from_map([
          ("title", template::Value::from_string("Wasm32 Ready")),
          ("summary", template::Value::from_string("Zero C deps & deterministic output.")),
        ]),
      ]),
    ),
  ])

  let iters = 2000
  let mut total_bytes = 0L
  let mut last = ""
  let mut r = 0
  while r < iters {
    let env = template::Environment::new()
    let _ = env.add_template("base.html", base_tpl)
    let _ = env.add_template("nav.html", nav_tpl)
    let _ = env.add_template("page.html", page_tpl)
    match env.render_template("page.html", ctx) {
      Ok(out) => {
        total_bytes = total_bytes + out.length().to_int64()
        if r == iters - 1 {
          last = out
        }
      }
      Err(_) => return 1
    }
    r = r + 1
  }

  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, last)
  0
}
