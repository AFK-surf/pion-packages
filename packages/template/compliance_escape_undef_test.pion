///| Compliance tests for HTML/XML auto-escaping, safe strings, XSS vectors,
///| extension-based auto-escaping, and UndefinedBehavior (Lenient vs Strict).

///|
test "escape_html_and_xss_vectors" {
  let xss = "<script>alert(\"xss\" & '1')</script>"
  let expected = "&lt;script&gt;alert(&quot;xss&quot; &amp; &#x27;1&#x27;)&lt;&#x2f;script&gt;"
  debug_assert(
    escape_html(xss) == expected,
    "escape_html XSS vector: got " + escape_html(xss),
  )
  let ctx = Value::from_map([("payload", Value::from_string(xss))])
  match render_html("<p>{{ payload }}</p>", ctx) {
    Ok(actual) =>
    debug_assert(
      actual == "<p>" + expected + "</p>",
      "render_html escapes XSS: got " + actual,
    )
    Err(e) => debug_assert(false, "render_html failed: " + e.to_string())
  }
}

///|
test "escape_safe_prevents_double_escape" {
  let ctx = Value::from_map([
    ("trusted", Value::safe("<b>Bold</b>")),
    ("raw", Value::from_string("<b>Raw</b>")),
  ])
  let env = Environment::new()
  env.set_auto_escape(AutoEscape::Html)
  assert_env_render(
    env,
    "{{ trusted }}|{{ raw|safe }}|{{ raw|escape }}",
    ctx,
    "<b>Bold</b>|<b>Raw</b>|&lt;b&gt;Raw&lt;&#x2f;b&gt;",
    "Value::safe, |safe, |escape no double escape",
  )
}

///|
test "escape_by_template_extension" {
  let env = Environment::new()
  must_add(env, "page.html", "{{ v }}")
  must_add(env, "doc.xml", "{{ v }}")
  must_add(env, "note.txt", "{{ v }}")
  let ctx = Value::from_map([("v", Value::from_string("<a>"))])
  assert_tpl(env, "page.html", ctx, "&lt;a&gt;", ".html auto-escaped")
  assert_tpl(env, "doc.xml", ctx, "&lt;a&gt;", ".xml auto-escaped")
  assert_tpl(env, "note.txt", ctx, "<a>", ".txt not escaped")
}

///|
test "escape_autoescape_block" {
  let env = Environment::new()
  let ctx = Value::from_map([("v", Value::from_string("<a>"))])
  assert_env_render(
    env,
    "{% autoescape true %}{{ v }}{% endautoescape %}|{% autoescape false %}{{ v }}{% endautoescape %}",
    ctx,
    "&lt;a&gt;|<a>",
    "autoescape block toggle",
  )
}

///|
test "undefined_behavior_lenient_vs_strict" {
  // Lenient (default)
  assert_render("x={{ missing }}", empty_ctx(), "x=", "lenient render")
  assert_render("{% if missing %}y{% else %}n{% endif %}", empty_ctx(), "n", "lenient if")
  assert_render("{% for i in missing %}{{ i }}{% endfor %}ok", empty_ctx(), "ok", "lenient for")

  // Strict
  let strict = Environment::new()
  strict.set_undefined_behavior(UndefinedBehavior::Strict)
  match strict.render_str("{{ missing }}", empty_ctx()) {
    Ok(_) => debug_assert(false, "strict undefined render must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::UndefinedError),
      "strict render error kind",
    )
  }
  match strict.render_str("{% if missing %}y{% endif %}", empty_ctx()) {
    Ok(_) => debug_assert(false, "strict undefined if must fail")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::UndefinedError),
      "strict if error kind",
    )
  }
  // Allowed in Strict: is defined / is undefined / |default
  assert_env_render(
    strict,
    "{{ missing is undefined }}|{{ missing is defined }}|{{ missing|default('ok') }}",
    empty_ctx(),
    "True|False|ok",
    "strict allows defined/undefined/default",
  )
}
