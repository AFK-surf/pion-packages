///| Wasm32 + Native 4-mode smoke entry for `packages/proxy`.

import "proxy"

///|
fn smoke() -> Int {
  // 1. ProxyUrl parsing, credential redaction, SSH identity query stripping
  let u1 = match proxy::parse_proxy_url(
    "http://alice:p%40ss:w0rd@proxy.example:8080",
  ) {
    Ok(u) => u
    Err(_) => return -1
  }
  if u1.redacted() != "http://***@proxy.example:8080" || !u1.uses_remote_dns() {
    return -2
  }
  let u2 = match proxy::parse_proxy_url(
    "ssh://monoid@station-us:2222?identity=/secret/key",
  ) {
    Ok(u) => u
    Err(_) => return -3
  }
  if u2.redacted() != "ssh://monoid@station-us:2222" {
    return -4
  }
  match proxy::parse_proxy_url("ssh://monoid:secret@station-us:2222") {
    Ok(_) => return -5
    Err(_) => ()
  }

  // 2. NO_PROXY CIDR + domain + IPv6 matching
  let m = proxy::NoProxyMatcher::parse(
    "localhost, 127.0.0.0/8, .corp.internal, [::1]:8080",
  )
  if !m.matches("127.0.0.9", 443) ||
  !m.matches("api.corp.internal", 443) ||
  m.matches("corp.internal", 443) ||
  !m.matches("::1", 8080) ||
  m.matches("github.com", 443) {
    return -6
  }

  // 3. Bidirectional SOCKS5 handshake with 1-byte fragmentation + ATYP=0x03
  let req_wire = match proxy::socks5_encode_request(
    proxy::SocksCommand::Connect,
    proxy::SocksAddr::Domain("api.github.com"),
    443,
  ) {
    Ok(b) => b
    Err(_) => return -7
  }
  match proxy::socks5_decode_request(req_wire.slice(0, 5)) {
    Ok(proxy::DecodeStatus::NeedMore(_)) => ()
    _ => return -8
  }
  match proxy::socks5_decode_request(req_wire) {
    Ok(proxy::DecodeStatus::Complete(r, c)) =>
    if c != req_wire.length() || r.port != 443 {
      return -9
    }
    _ => return -10
  }

  // 4. HTTP CONNECT IPv6 + Basic auth + 407 pass-through + pipelined TLS offset
  let lim = proxy::ProxyLimits::default()
  let conn_req = match proxy::encode_connect_request(
    "::1",
    443,
    Some(proxy::ProxyAuth::new("alice", "p@ss:w0rd")),
    [],
  ) {
    Ok(b) => b
    Err(_) => return -11
  }
  match proxy::decode_connect_request(conn_req, lim) {
    Ok(proxy::DecodeStatus::Complete(req, c)) =>
    if c != conn_req.length() || req.host != "::1" || req.port != 443 {
      return -12
    }
    _ => return -13
  }
  let r407 = match proxy::encode_connect_response(
    407,
    "Proxy Authentication Required",
    [proxy::HttpHeader::new("Proxy-Authenticate", "Basic realm=\"corp\"")],
  ) {
    Ok(b) => b
    Err(_) => return -14
  }
  match proxy::decode_connect_response(r407, lim) {
    Ok(proxy::DecodeStatus::Complete(resp, _)) =>
    if resp.status != 407 || !resp.is_auth_required() {
      return -15
    }
    _ => return -16
  }

  // 5. Plaintext HTTP forward-proxy rewrite + hop-by-hop strip + smuggling rejection
  let fwd = (
    "GET http://example.com:8080/v1/ok HTTP/1.1\r\n" +
    "Connection: X-Hop\r\n" +
    "Proxy-Authorization: Basic YWxpY2U6c2VjcmV0\r\n" +
    "X-Hop: drop\r\n" +
    "Accept: */*\r\n\r\n"
  ).to_bytes()
  match proxy::parse_and_sanitize_forward_request(fwd, lim) {
    Ok(proxy::DecodeStatus::Complete(s, c)) =>
    if c != fwd.length() ||
    s.origin_path != "/v1/ok" ||
    s.headers.length() != 2 {
      return -17
    }
    _ => return -18
  }
  let smug = (
    "POST http://example.com/a HTTP/1.1\r\n" +
    "Transfer-Encoding: chunked\r\n" +
    "Content-Length: 5\r\n\r\n"
  ).to_bytes()
  match proxy::parse_and_sanitize_forward_request(smug, lim) {
    Err(proxy::ProxyError::SmugglingDetected(_)) => ()
    _ => return -19
  }
  5
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "proxy_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "proxy_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
