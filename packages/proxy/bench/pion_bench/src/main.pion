///| Pion Native head-to-head benchmark for `packages/proxy`.
///| Modes: "url" (200k ops) | "socks5" (500k rounds) | "http" (100k requests)

import "proxy"

///|
fn hash_str(h : Int64, s : String) -> Int64 {
  let mut acc = h
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    acc = (acc * 131L + b[i].to_int().to_int64()) % 1000000007L
    i = i + 1
  }
  acc
}

///|
fn hash_bytes(h : Int64, b : Bytes) -> Int64 {
  let mut acc = h
  let n = b.length()
  let mut i = 0
  while i < n {
    acc = (acc * 131L + b[i].to_int().to_int64()) % 1000000007L
    i = i + 1
  }
  acc
}

///| W1: Proxy URL parse + mandatory redaction + NO_PROXY matching (200,000 ops).
fn bench_url(world : World) -> Int {
  let urls = [
    "http://alice:p%40ss:w0rd@proxy.example:8080",
    "socks5h://bob:s3cr@t@127.0.0.1:9050",
    "ssh://monoid@station-us:2222?identity=/secret/key",
    "https://[::1]:8443",
  ]
  let targets_host = [
    "127.0.0.1", "sub.example.com", "api.svc.local", "github.com",
  ]
  let targets_port = [8080, 443, 8443, 443]
  let matcher = proxy::NoProxyMatcher::parse(
    "localhost, 127.0.0.0/8, 10.0.0.0/8, ::1, example.com, .corp.internal, api.svc.local:8443",
  )

  let ops = 200000
  let mut i = 0
  let mut bypass_count : Int64 = 0L
  let mut remote_dns_count : Int64 = 0L
  let mut total_redacted_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  while i < ops {
    let idx = i & 3
    match proxy::parse_proxy_url(urls[idx]) {
      Ok(u) => {
        let safe = u.redacted()
        total_redacted_bytes = total_redacted_bytes + safe.length().to_int64()
        hash = hash_str(hash, safe)
        if u.uses_remote_dns() {
          remote_dns_count = remote_dns_count + 1L
        }
        if matcher.matches(targets_host[idx], targets_port[idx]) {
          bypass_count = bypass_count + 1L
          hash = (hash * 131L + 1L) % 1000000007L
        } else {
          hash = (hash * 131L + 2L) % 1000000007L
        }
      }
      Err(_) => return 1
    }
    i = i + 1
  }
  io_println(
    world,
    "url ops=" +
    ops.to_string() +
    " remote_dns=" +
    remote_dns_count.to_string() +
    " bypass=" +
    bypass_count.to_string() +
    " redacted_bytes=" +
    total_redacted_bytes.to_string() +
    " hash=" +
    hash.to_string(),
  )
  0
}

///| W2: SOCKS5 full bidirectional handshake (UserPass + ATYP=0x03 Domain, 500,000 rounds).
fn bench_socks5(world : World) -> Int {
  let domains = [
    "api.github.com",
    "registry.npmjs.org",
    "auth.example.com",
    "station-us.internal",
  ]
  let ports = [443, 443, 8443, 2222]
  let mut bind_ip = Bytes::new(4)
  bind_ip[0] = (127).to_byte()
  bind_ip[1] = (0).to_byte()
  bind_ip[2] = (0).to_byte()
  bind_ip[3] = (1).to_byte()
  let methods = [proxy::SocksAuthMethod::NoAuth, proxy::SocksAuthMethod::UserPass]

  let rounds = 500000
  let mut i = 0
  let mut total_wire : Int64 = 0L
  let mut total_ports : Int64 = 0L
  let mut hash : Int64 = 0L
  while i < rounds {
    let idx = i & 3
    let g_wire = match proxy::socks5_encode_greeting(methods) {
      Ok(b) => b
      Err(_) => return 1
    }
    let g_dec = match proxy::socks5_decode_greeting(g_wire) {
      Ok(proxy::DecodeStatus::Complete(g, c)) => {
        total_wire = total_wire + c.to_int64()
        g.methods.length()
      }
      _ => return 2
    }
    let ms_wire = proxy::socks5_encode_method_selection(
      proxy::SocksAuthMethod::UserPass,
    )
    match proxy::socks5_decode_method_selection(ms_wire) {
      Ok(proxy::DecodeStatus::Complete(_, c)) =>
      total_wire = total_wire + c.to_int64()
      _ => return 3
    }
    let up_wire = match proxy::socks5_encode_userpass_request(
      "alice", "s3cr3t!",
    ) {
      Ok(b) => b
      Err(_) => return 4
    }
    let up_len = match proxy::socks5_decode_userpass_request(up_wire) {
      Ok(proxy::DecodeStatus::Complete(up, c)) => {
        total_wire = total_wire + c.to_int64()
        up.username.length() + up.password.length()
      }
      _ => return 5
    }
    let up_resp = proxy::socks5_encode_userpass_response(true)
    match proxy::socks5_decode_userpass_response(up_resp) {
      Ok(proxy::DecodeStatus::Complete(_, c)) =>
      total_wire = total_wire + c.to_int64()
      _ => return 6
    }
    let req_wire = match proxy::socks5_encode_request(
      proxy::SocksCommand::Connect,
      proxy::SocksAddr::Domain(domains[idx]),
      ports[idx],
    ) {
      Ok(b) => b
      Err(_) => return 7
    }
    match proxy::socks5_decode_request(req_wire) {
      Ok(proxy::DecodeStatus::Complete(r, c)) => {
        total_wire = total_wire + c.to_int64()
        total_ports = total_ports + r.port.to_int64()
        match r.addr {
          proxy::SocksAddr::Domain(d) => hash = hash_str(hash, d)
          _ => return 8
        }
      }
      _ => return 9
    }
    let rep_wire = match proxy::socks5_encode_reply(
      proxy::SocksReplyCode::Succeeded,
      proxy::SocksAddr::Ipv4(bind_ip),
      51234,
    ) {
      Ok(b) => b
      Err(_) => return 10
    }
    match proxy::socks5_decode_reply(rep_wire) {
      Ok(proxy::DecodeStatus::Complete(rep, c)) => {
        total_wire = total_wire + c.to_int64()
        total_ports = total_ports + rep.bind_port.to_int64()
        hash = (hash * 131L + (g_dec + up_len).to_int64()) % 1000000007L
      }
      _ => return 11
    }
    i = i + 1
  }
  io_println(
    world,
    "socks5 rounds=" +
    rounds.to_string() +
    " wire_bytes=" +
    total_wire.to_string() +
    " port_sum=" +
    total_ports.to_string() +
    " hash=" +
    hash.to_string(),
  )
  0
}

///| W3: HTTP CONNECT + plaintext HTTP forward-proxy header sanitization (100,000 requests).
fn bench_http(world : World) -> Int {
  let lim = proxy::ProxyLimits::default()
  let auth = Some(proxy::ProxyAuth::new("alice", "p@ss:w0rd"))
  let extra = [proxy::HttpHeader::new("User-Agent", "pion-proxy/1.0")]
  let hosts = ["::1", "api.github.com"]
  let resp_200 = "HTTP/1.1 200 Connection Established\r\nProxy-Agent: monoid/1\r\n\r\n\u{0016}\u{0003}\u{0001}\u{0002}\u{0000}".to_bytes()
  let fwd_raw = (
    "GET http://example.com:8080/v1/items?limit=10 HTTP/1.1\r\n" +
    "Host: spoofed.invalid\r\n" +
    "Proxy-Connection: keep-alive\r\n" +
    "Proxy-Authorization: Basic YWxpY2U6c2VjcmV0\r\n" +
    "Connection: keep-alive, X-Custom-Hop\r\n" +
    "Keep-Alive: timeout=5\r\n" +
    "TE: trailers\r\n" +
    "X-Custom-Hop: drop-me\r\n" +
    "Accept: application/json\r\n" +
    "X-Trace-Id: trace-123\r\n" +
    "\r\n"
  ).to_bytes()

  let reqs = 100000
  let mut i = 0
  let mut total_consumed : Int64 = 0L
  let mut total_wire : Int64 = 0L
  let mut total_headers : Int64 = 0L
  let mut hash : Int64 = 0L
  while i < reqs {
    let idx = i & 1
    let c_wire = match proxy::encode_connect_request(
      hosts[idx],
      443,
      auth,
      extra,
    ) {
      Ok(b) => b
      Err(_) => return 1
    }
    match proxy::decode_connect_request(c_wire, lim) {
      Ok(proxy::DecodeStatus::Complete(cr, c)) => {
        total_consumed = total_consumed + c.to_int64()
        total_headers = total_headers + cr.headers.length().to_int64()
        hash = hash_str(hash, cr.host)
      }
      _ => return 2
    }
    match proxy::decode_connect_response(resp_200, lim) {
      Ok(proxy::DecodeStatus::Complete(rp, c)) => {
        total_consumed = total_consumed + c.to_int64()
        hash = (hash * 131L + rp.status.to_int64()) % 1000000007L
      }
      _ => return 3
    }
    match proxy::parse_and_sanitize_forward_request(fwd_raw, lim) {
      Ok(proxy::DecodeStatus::Complete(fr, c)) => {
        total_consumed = total_consumed + c.to_int64()
        total_wire = total_wire + fr.wire_head.length().to_int64()
        total_headers = total_headers + fr.headers.length().to_int64()
        hash = hash_bytes(hash, fr.wire_head)
      }
      _ => return 4
    }
    i = i + 1
  }
  io_println(
    world,
    "http reqs=" +
    reqs.to_string() +
    " consumed=" +
    total_consumed.to_string() +
    " wire_bytes=" +
    total_wire.to_string() +
    " headers=" +
    total_headers.to_string() +
    " hash=" +
    hash.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: proxy_bench <url|socks5|http>")
    return 1
  }
  let mode = args[1]
  if mode == "url" {
    bench_url(world)
  } else if mode == "socks5" {
    bench_socks5(world)
  } else if mode == "http" {
    bench_http(world)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
