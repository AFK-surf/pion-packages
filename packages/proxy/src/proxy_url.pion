///| Proxy URL parser, mandatory credential redaction, SSH rules, and NO_PROXY matcher.

///| Supported proxy URL schemes.
pub enum ProxyScheme {
  Http
  Https
  Socks5
  Socks5h
  Ssh
}

///|
pub fn ProxyScheme::default_port(self : ProxyScheme) -> Int {
  match self {
    ProxyScheme::Http => 80
    ProxyScheme::Https => 443
    ProxyScheme::Socks5 => 1080
    ProxyScheme::Socks5h => 1080
    ProxyScheme::Ssh => 22
  }
}

///|
pub fn ProxyScheme::as_str(self : ProxyScheme) -> String {
  match self {
    ProxyScheme::Http => "http"
    ProxyScheme::Https => "https"
    ProxyScheme::Socks5 => "socks5"
    ProxyScheme::Socks5h => "socks5h"
    ProxyScheme::Ssh => "ssh"
  }
}

///|
pub fn ProxyScheme::uses_remote_dns(self : ProxyScheme) -> Bool {
  match self {
    ProxyScheme::Socks5 => false
    _ => true
  }
}

///|
pub fn proxy_scheme_eq(a : ProxyScheme, b : ProxyScheme) -> Bool {
  match (a, b) {
    (ProxyScheme::Http, ProxyScheme::Http) => true
    (ProxyScheme::Https, ProxyScheme::Https) => true
    (ProxyScheme::Socks5, ProxyScheme::Socks5) => true
    (ProxyScheme::Socks5h, ProxyScheme::Socks5h) => true
    (ProxyScheme::Ssh, ProxyScheme::Ssh) => true
    _ => false
  }
}

///| Parsed proxy URL with safe redaction helpers.
pub val struct ProxyUrl {
  pub scheme : ProxyScheme
  pub host : String
  pub port : Int
  pub explicit_port : Bool
  pub username : Option[String]
  pub password : Option[String]
  pub query : Option[String]
  pub identity : Option[String]
}

///| Internal: extract `identity=<val>` from a raw query string (percent-decoded).
fn extract_identity_param(query : String) -> Option[String] {
  let b = query.to_bytes()
  let n = b.length()
  let mut pos = 0
  while pos < n {
    let mut amp = pos
    while amp < n && b[amp].to_int() != 38 {
      amp = amp + 1
    }
    let mut eq = pos
    while eq < amp && b[eq].to_int() != 61 {
      eq = eq + 1
    }
    if eq < amp {
      let key = b.slice(pos, eq).to_string()
      if key == "identity" {
        let raw_val = b.slice(eq + 1, amp).to_string()
        match percent_decode(raw_val) {
          Some(v) => {
            if v.length() > 0 && !has_crlf_or_nul(v) {
              return Some(v)
            }
            return None
          }
          None => return None
        }
      }
    }
    pos = amp + 1
  }
  None
}

///| Internal: validate a non-IPv6 hostname (domain or IPv4).
fn validate_plain_host(host : String) -> Bool {
  let b = host.to_bytes()
  let n = b.length()
  if n == 0 || n > 255 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c <= 32 ||
    c >= 127 ||
    c == 47 ||
    c == 63 ||
    c == 35 ||
    c == 64 ||
    c == 91 ||
    c == 93 ||
    c == 58 {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a proxy URL (`http`, `https`, `socks5`, `socks5h`, `ssh`).
///| Error messages never echo credentials or sensitive query parameters.
pub fn parse_proxy_url(raw : String) -> Result[ProxyUrl, ProxyError] {
  let b = raw.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(ProxyError::InvalidUrl("empty URL"))
  }
  // Reject any control character, NUL, or space anywhere in raw URL.
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c <= 32 || c == 127 {
      return Err(ProxyError::InvalidUrl("control character or whitespace in URL"))
    }
    i = i + 1
  }
  // Find "://"
  let mut sep = -1
  let mut j = 0
  while j + 2 < n {
    if b[j].to_int() == 58 &&
    b[j + 1].to_int() == 47 &&
    b[j + 2].to_int() == 47 {
      sep = j
      break
    }
    j = j + 1
  }
  if sep <= 0 {
    return Err(ProxyError::InvalidUrl("missing scheme separator '://'"))
  }
  let scheme_raw = b.slice(0, sep).to_string()
  let scheme = if str_eq_lower_lit(scheme_raw, "http") {
    ProxyScheme::Http
  } else if str_eq_lower_lit(scheme_raw, "https") {
    ProxyScheme::Https
  } else if str_eq_lower_lit(scheme_raw, "socks5") {
    ProxyScheme::Socks5
  } else if str_eq_lower_lit(scheme_raw, "socks5h") {
    ProxyScheme::Socks5h
  } else if str_eq_lower_lit(scheme_raw, "ssh") {
    ProxyScheme::Ssh
  } else {
    // Only echo safe ASCII scheme token (never credentials).
    let safe_scheme = ascii_to_lower(scheme_raw)
    return Err(ProxyError::UnsupportedScheme(safe_scheme))
  }

  let auth_start = sep + 3
  if auth_start >= n {
    return Err(ProxyError::InvalidHost("empty authority"))
  }
  // Split authority from optional /path, ?query, #fragment
  let mut auth_end = n
  let mut k = auth_start
  while k < n {
    let c = b[k].to_int()
    if c == 47 || c == 63 || c == 35 {
      auth_end = k
      break
    }
    k = k + 1
  }
  if auth_end == auth_start {
    return Err(ProxyError::InvalidHost("empty host"))
  }

  // Extract optional query (?...) up to #fragment
  let mut query_opt : Option[String] = None
  let mut identity_opt : Option[String] = None
  let mut q_pos = auth_end
  while q_pos < n && b[q_pos].to_int() != 63 && b[q_pos].to_int() != 35 {
    q_pos = q_pos + 1
  }
  if q_pos < n && b[q_pos].to_int() == 63 {
    let mut q_end = q_pos + 1
    while q_end < n && b[q_end].to_int() != 35 {
      q_end = q_end + 1
    }
    if q_end > q_pos + 1 {
      let q_str = b.slice(q_pos + 1, q_end).to_string()
      query_opt = Some(q_str)
      identity_opt = extract_identity_param(q_str)
    }
  }

  // Split authority on LAST '@' so passwords containing literal '@' work.
  let mut last_at = -1
  let mut m = auth_start
  while m < auth_end {
    if b[m].to_int() == 64 {
      last_at = m
    }
    m = m + 1
  }

  let mut username : Option[String] = None
  let mut password : Option[String] = None
  let mut hp_start = auth_start
  if last_at >= 0 {
    hp_start = last_at + 1
    // Find FIRST ':' in userinfo so passwords containing ':' work.
    let mut first_colon = -1
    let mut u_idx = auth_start
    while u_idx < last_at {
      if b[u_idx].to_int() == 58 {
        first_colon = u_idx
        break
      }
      u_idx = u_idx + 1
    }
    if first_colon >= 0 {
      let raw_user = b.slice(auth_start, first_colon).to_string()
      let raw_pass = b.slice(first_colon + 1, last_at).to_string()
      let dec_user = match percent_decode(raw_user) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials("invalid percent-encoding in username"),
        )
      }
      let dec_pass = match percent_decode(raw_pass) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials(
            "invalid percent-encoding in credentials",
          ),
        )
      }
      if has_crlf_or_nul(dec_user) || has_crlf_or_nul(dec_pass) {
        return Err(
          ProxyError::InvalidCredentials("control character in credentials"),
        )
      }
      if dec_user.length() > 0 {
        username = Some(dec_user)
      }
      password = Some(dec_pass)
    } else {
      let raw_user = b.slice(auth_start, last_at).to_string()
      let dec_user = match percent_decode(raw_user) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials("invalid percent-encoding in username"),
        )
      }
      if has_crlf_or_nul(dec_user) {
        return Err(
          ProxyError::InvalidCredentials("control character in username"),
        )
      }
      if dec_user.length() > 0 {
        username = Some(dec_user)
      }
    }
  }

  // SSH special rule: reject password in ssh:// URL without echoing credentials.
  match (scheme, password) {
    (ProxyScheme::Ssh, Some(_)) =>
    return Err(
      ProxyError::InvalidCredentials(
        "ssh proxy URL must not contain a password",
      ),
    )
    _ => ()
  }

  if hp_start >= auth_end {
    return Err(ProxyError::InvalidHost("empty host"))
  }

  // Parse hostport: either [IPv6](:port)? or host(:port)?
  let mut host = ""
  let mut port = scheme.default_port()
  let mut explicit_port = false

  if b[hp_start].to_int() == 91 {
    // Bracketed IPv6 literal
    let mut close_br = -1
    let mut p = hp_start + 1
    while p < auth_end {
      if b[p].to_int() == 93 {
        close_br = p
        break
      }
      p = p + 1
    }
    if close_br < 0 || close_br == hp_start + 1 {
      return Err(ProxyError::InvalidHost("invalid bracketed IPv6 host"))
    }
    let raw_v6 = b.slice(hp_start + 1, close_br).to_string()
    match parse_ipv6_octets(raw_v6) {
      Some(_) => host = ascii_to_lower(raw_v6)
      None => return Err(ProxyError::InvalidHost("malformed IPv6 literal"))
    }
    let after = close_br + 1
    if after < auth_end {
      if b[after].to_int() != 58 {
        return Err(ProxyError::InvalidHost("unexpected character after IPv6"))
      }
      let port_str = b.slice(after + 1, auth_end).to_string()
      match parse_port_strict(port_str) {
        Some(pv) => {
          port = pv
          explicit_port = true
        }
        None => return Err(ProxyError::InvalidPort("port must be in 1..65535"))
      }
    }
  } else {
    // Plain host (domain or IPv4), at most one ':'
    let mut colon = -1
    let mut colon_count = 0
    let mut p = hp_start
    while p < auth_end {
      if b[p].to_int() == 58 {
        colon = p
        colon_count = colon_count + 1
      }
      p = p + 1
    }
    if colon_count > 1 {
      return Err(
        ProxyError::InvalidHost("unbracketed IPv6 or multiple colons in host"),
      )
    }
    let host_end = if colon >= 0 { colon } else { auth_end }
    if host_end == hp_start {
      return Err(ProxyError::InvalidHost("empty host"))
    }
    let raw_host = b.slice(hp_start, host_end).to_string()
    if !validate_plain_host(raw_host) {
      return Err(ProxyError::InvalidHost("invalid host characters"))
    }
    host = ascii_to_lower(raw_host)
    if colon >= 0 {
      let port_str = b.slice(colon + 1, auth_end).to_string()
      match parse_port_strict(port_str) {
        Some(pv) => {
          port = pv
          explicit_port = true
        }
        None => return Err(ProxyError::InvalidPort("port must be in 1..65535"))
      }
    }
  }

  Ok(
    ProxyUrl::{
      scheme: scheme,
      host: host,
      port: port,
      explicit_port: explicit_port,
      username: username,
      password: password,
      query: query_opt,
      identity: identity_opt,
    },
  )
}

///| Internal: check whether host string contains ':' (IPv6 literal).
fn host_is_ipv6(host : String) -> Bool {
  let n = host.length()
  let mut i = 0
  while i < n {
    if host.code_unit_at(i) == 58 {
      return true
    }
    i = i + 1
  }
  false
}

///| Render a log-safe URL string.
///| - Never outputs plaintext passwords; when a password is present, redacts the entire userinfo to `***@`.
///| - Strips query parameters (including SSH `identity` key paths).
pub fn ProxyUrl::redacted(self : ProxyUrl) -> String {
  let sb = StringBuilder::new()
  sb.write_string(self.scheme.as_str())
  sb.write_string("://")
  match self.password {
    Some(_) => sb.write_string("***@")
    None =>
    match self.username {
      Some(u) =>
      if u.length() > 0 {
        sb.write_string(u)
        sb.write_string("@")
      }
      None => ()
    }
  }
  if host_is_ipv6(self.host) {
    sb.write_string("[")
    sb.write_string(self.host)
    sb.write_string("]")
  } else {
    sb.write_string(self.host)
  }
  sb.write_string(":")
  sb.write_string(self.port.to_string())
  sb.to_string()
}

///| Alias of `ProxyUrl::redacted`.
pub fn ProxyUrl::to_safe_string(self : ProxyUrl) -> String {
  self.redacted()
}

///| Returns `true` for schemes that resolve target hostnames remotely (`socks5h`, `http`, `https`, `ssh`),
///| and `false` for `socks5` (local DNS resolution).
pub fn ProxyUrl::uses_remote_dns(self : ProxyUrl) -> Bool {
  self.scheme.uses_remote_dns()
}

///| Extract credentials as `Option[ProxyAuth]` when username or password is present.
pub fn ProxyUrl::auth(self : ProxyUrl) -> Option[ProxyAuth] {
  match self.username {
    Some(u) =>
    match self.password {
      Some(p) => Some(ProxyAuth::new(u, p))
      None => Some(ProxyAuth::new(u, ""))
    }
    None =>
    match self.password {
      Some(p) => Some(ProxyAuth::new("", p))
      None => None
    }
  }
}

///| Internal NO_PROXY rule representation.
pub enum NoProxyRule {
  Wildcard
  Domain(String, Bool, Option[Int])
  Ipv4(Bytes, Option[Int])
  Ipv6(Bytes, Option[Int])
  Ipv4Cidr(Bytes, Int)
  Ipv6Cidr(Bytes, Int)
}

///| Compiled comma-separated NO_PROXY matcher.
pub struct NoProxyMatcher {
  pub rules : Array[NoProxyRule]
}

///| Internal: strip trailing '.' from an ASCII hostname/domain.
fn strip_trailing_dot(s : String) -> String {
  let n = s.length()
  if n > 0 && s.code_unit_at(n - 1) == 46 {
    str_slice_ascii(s, 0, n - 1)
  } else {
    s
  }
}

///| Internal: parse non-negative integer prefix length in 0..=max_bits.
fn parse_prefix_len(s : String, max_bits : Int) -> Option[Int] {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 || n > 3 {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  if v < 0 || v > max_bits {
    return None
  }
  Some(v)
}

///| Internal: check whether `ip` and `net` match on the top `prefix` bits.
fn bytes_match_cidr(ip : Bytes, net : Bytes, prefix : Int) -> Bool {
  let full_bytes = prefix / 8
  let rem_bits = prefix % 8
  let mut i = 0
  while i < full_bytes {
    if ip[i] != net[i] {
      return false
    }
    i = i + 1
  }
  if rem_bits > 0 {
    let mask = (0xFF << (8 - rem_bits)) & 0xFF
    if (ip[full_bytes].to_int() & mask) != (net[full_bytes].to_int() & mask) {
      return false
    }
  }
  true
}

///| Parse a single trimmed NO_PROXY entry into a rule.
fn parse_single_no_proxy_rule(entry : String) -> Option[NoProxyRule] {
  if entry.length() == 0 {
    return None
  }
  if entry == "*" {
    return Some(NoProxyRule::Wildcard)
  }
  let b = entry.to_bytes()
  let n = b.length()
  // Check for CIDR '/'
  let mut slash = -1
  let mut i = 0
  while i < n {
    if b[i].to_int() == 47 {
      slash = i
      break
    }
    i = i + 1
  }
  if slash >= 0 {
    let ip_part = b.slice(0, slash).to_string()
    let pfx_part = b.slice(slash + 1, n).to_string()
    match parse_ipv4_octets(ip_part) {
      Some(v4) =>
      match parse_prefix_len(pfx_part, 32) {
        Some(bits) => return Some(NoProxyRule::Ipv4Cidr(v4, bits))
        None => return None
      }
      None =>
      match parse_ipv6_octets(ip_part) {
        Some(v6) =>
        match parse_prefix_len(pfx_part, 128) {
          Some(bits) => return Some(NoProxyRule::Ipv6Cidr(v6, bits))
          None => return None
        }
        None => return None
      }
    }
  }

  // Check for [IPv6] or [IPv6]:port
  if b[0].to_int() == 91 {
    let mut close_br = -1
    let mut p = 1
    while p < n {
      if b[p].to_int() == 93 {
        close_br = p
        break
      }
      p = p + 1
    }
    if close_br < 0 {
      return None
    }
    let ip_part = b.slice(1, close_br).to_string()
    let v6 = match parse_ipv6_octets(ip_part) {
      Some(v) => v
      None => return None
    }
    let mut port_opt : Option[Int] = None
    if close_br + 1 < n {
      if b[close_br + 1].to_int() != 58 {
        return None
      }
      match parse_port_strict(b.slice(close_br + 2, n).to_string()) {
        Some(pv) => port_opt = Some(pv)
        None => return None
      }
    }
    return Some(NoProxyRule::Ipv6(v6, port_opt))
  }

  // Bare IPv6 literal (contains >= 2 colons)
  let mut colons = 0
  let mut last_colon = -1
  let mut k = 0
  while k < n {
    if b[k].to_int() == 58 {
      colons = colons + 1
      last_colon = k
    }
    k = k + 1
  }
  if colons >= 2 {
    match parse_ipv6_octets(entry) {
      Some(v6) => return Some(NoProxyRule::Ipv6(v6, None))
      None => return None
    }
  }

  // Optional :port suffix for IPv4 or domain
  let mut host_part = entry
  let mut port_opt : Option[Int] = None
  if colons == 1 {
    host_part = b.slice(0, last_colon).to_string()
    match parse_port_strict(b.slice(last_colon + 1, n).to_string()) {
      Some(pv) => port_opt = Some(pv)
      None => return None
    }
  }
  if host_part.length() == 0 {
    return None
  }

  // IPv4 literal?
  match parse_ipv4_octets(host_part) {
    Some(v4) => return Some(NoProxyRule::Ipv4(v4, port_opt))
    None => ()
  }

  // Domain rule (`example.com` -> match_exact=true; `.example.com` -> match_exact=false)
  let mut lower = strip_trailing_dot(ascii_to_lower(host_part))
  let mut match_exact = true
  if lower.length() > 0 && lower.code_unit_at(0) == 46 {
    match_exact = false
    lower = str_slice_ascii(lower, 1, lower.length())
  }
  if lower.length() == 0 {
    return None
  }
  Some(NoProxyRule::Domain(lower, match_exact, port_opt))
}

///| Parse a comma-separated `NO_PROXY` rule list.
pub fn NoProxyMatcher::parse(raw : String) -> NoProxyMatcher {
  let rules : Array[NoProxyRule] = []
  let b = raw.to_bytes()
  let n = b.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || b[i].to_int() == 44 {
      let item = trim_ascii_ws(b.slice(start, i).to_string())
      match parse_single_no_proxy_rule(item) {
        Some(r) => rules.push(r)
        None => ()
      }
      start = i + 1
    }
    i = i + 1
  }
  NoProxyMatcher::{ rules: rules }
}

///| Internal: check optional rule port against target port.
fn port_matches(rule_port : Option[Int], target_port : Int) -> Bool {
  match rule_port {
    None => true
    Some(rp) => target_port > 0 && rp == target_port
  }
}

///| Internal: check whether `host` is a strict subdomain of `suffix` (i.e. ends with "." + suffix).
fn is_subdomain_of(host : String, suffix : String) -> Bool {
  let hn = host.length()
  let sn = suffix.length()
  if hn <= sn {
    return false
  }
  let dot_pos = hn - sn - 1
  if host.code_unit_at(dot_pos) != 46 {
    return false
  }
  let mut i = 0
  while i < sn {
    if host.code_unit_at(dot_pos + 1 + i) != suffix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Return `true` if `(host, port)` should bypass the proxy.
pub fn NoProxyMatcher::matches(
  self : NoProxyMatcher,
  host : String,
  port : Int,
) -> Bool {
  if self.rules.length() == 0 {
    return false
  }
  let trimmed = trim_ascii_ws(host)
  if trimmed.length() == 0 {
    return false
  }
  // Strip optional surrounding [ ] for IPv6 targets
  let mut clean = trimmed
  if clean.length() >= 2 &&
  clean.code_unit_at(0) == 91 &&
  clean.code_unit_at(clean.length() - 1) == 93 {
    clean = str_slice_ascii(clean, 1, clean.length() - 1)
  }
  let target_v4 = parse_ipv4_octets(clean)
  let target_v6 = match target_v4 {
    Some(_) => None
    None => parse_ipv6_octets(clean)
  }
  let target_domain = strip_trailing_dot(ascii_to_lower(clean))

  let mut i = 0
  while i < self.rules.length() {
    match self.rules[i] {
      NoProxyRule::Wildcard => return true
      NoProxyRule::Ipv4(rule_v4, rp) =>
      match target_v4 {
        Some(tv4) =>
        if port_matches(rp, port) && internal_bytes_eq(tv4, rule_v4) {
          return true
        }
        None => ()
      }
      NoProxyRule::Ipv6(rule_v6, rp) =>
      match target_v6 {
        Some(tv6) =>
        if port_matches(rp, port) && internal_bytes_eq(tv6, rule_v6) {
          return true
        }
        None => ()
      }
      NoProxyRule::Ipv4Cidr(net, bits) =>
      match target_v4 {
        Some(tv4) =>
        if bytes_match_cidr(tv4, net, bits) {
          return true
        }
        None => ()
      }
      NoProxyRule::Ipv6Cidr(net, bits) =>
      match target_v6 {
        Some(tv6) =>
        if bytes_match_cidr(tv6, net, bits) {
          return true
        }
        None => ()
      }
      NoProxyRule::Domain(suffix, match_exact, rp) =>
      if port_matches(rp, port) {
        if match_exact && target_domain == suffix {
          return true
        }
        if is_subdomain_of(target_domain, suffix) {
          return true
        }
      }
    }
    i = i + 1
  }
  false
}

///| Convenience wrapper matching a host without a port constraint.
pub fn NoProxyMatcher::matches_host(self : NoProxyMatcher, host : String) -> Bool {
  self.matches(host, 0)
}
