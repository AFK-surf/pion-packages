///| Proxy URL parser, mandatory credential redaction, SSH rules, and NO_PROXY matcher.

///| Supported proxy URL schemes.
pub enum ProxyScheme {
  Http
  Https
  Socks5
  Socks5h
  Ssh
}

///|
pub fn ProxyScheme::default_port(self : ProxyScheme) -> Int {
  match self {
    ProxyScheme::Http => 80
    ProxyScheme::Https => 443
    ProxyScheme::Socks5 => 1080
    ProxyScheme::Socks5h => 1080
    ProxyScheme::Ssh => 22
  }
}

///|
pub fn ProxyScheme::as_str(self : ProxyScheme) -> String {
  match self {
    ProxyScheme::Http => "http"
    ProxyScheme::Https => "https"
    ProxyScheme::Socks5 => "socks5"
    ProxyScheme::Socks5h => "socks5h"
    ProxyScheme::Ssh => "ssh"
  }
}

///|
pub fn ProxyScheme::uses_remote_dns(self : ProxyScheme) -> Bool {
  match self {
    ProxyScheme::Socks5 => false
    _ => true
  }
}

///|
pub fn proxy_scheme_eq(a : ProxyScheme, b : ProxyScheme) -> Bool {
  match (a, b) {
    (ProxyScheme::Http, ProxyScheme::Http) => true
    (ProxyScheme::Https, ProxyScheme::Https) => true
    (ProxyScheme::Socks5, ProxyScheme::Socks5) => true
    (ProxyScheme::Socks5h, ProxyScheme::Socks5h) => true
    (ProxyScheme::Ssh, ProxyScheme::Ssh) => true
    _ => false
  }
}

///| Parsed proxy URL with safe redaction helpers.
pub val struct ProxyUrl {
  pub scheme : ProxyScheme
  pub host : String
  pub port : Int
  pub explicit_port : Bool
  pub username : Option[String]
  pub password : Option[String]
  pub query : Option[String]
  pub identity : Option[String]
}

///| Internal: extract `identity=<val>` from `raw[q_start..q_end]` (percent-decoded, zero-alloc scan).
fn extract_identity_param_range(
  raw : String,
  q_start : Int,
  q_end : Int,
) -> Option[String] {
  let mut pos = q_start
  while pos < q_end {
    let mut amp = pos
    while amp < q_end && raw.code_unit_at(amp) != 38 {
      amp = amp + 1
    }
    let mut eq = pos
    while eq < amp && raw.code_unit_at(eq) != 61 {
      eq = eq + 1
    }
    if eq < amp && eq - pos == 8 && str_eq_lower_lit_range(raw, pos, eq, "identity") {
      // Exact case match for "identity"
      let mut exact = true
      let mut ci = 0
      while ci < 8 {
        let c = raw.code_unit_at(pos + ci)
        if c >= 65 && c <= 90 {
          exact = false
          break
        }
        ci = ci + 1
      }
      if exact {
        match percent_decode_range(raw, eq + 1, amp) {
          Some(v) => {
            if v.length() > 0 && !has_crlf_or_nul(v) {
              return Some(v)
            }
            return None
          }
          None => return None
        }
      }
    }
    pos = amp + 1
  }
  None
}

///| Internal: validate a non-IPv6 hostname `s[start..end]` (domain or IPv4).
fn validate_plain_host_range(s : String, start : Int, end : Int) -> Bool {
  let n = end - start
  if n <= 0 || n > 255 {
    return false
  }
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c <= 32 ||
    c >= 127 ||
    c == 47 ||
    c == 63 ||
    c == 35 ||
    c == 64 ||
    c == 91 ||
    c == 93 ||
    c == 58 ||
    c == 37 ||
    c == 92 ||
    c == 60 ||
    c == 62 ||
    c == 94 ||
    c == 124 {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: validate a non-IPv6 hostname in `b[start..end]`.
fn validate_plain_host_bytes(b : Bytes, start : Int, end : Int) -> Bool {
  let n = end - start
  if n <= 0 || n > 255 {
    return false
  }
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c <= 32 ||
    c >= 127 ||
    c == 47 ||
    c == 63 ||
    c == 35 ||
    c == 64 ||
    c == 91 ||
    c == 93 ||
    c == 58 ||
    c == 37 ||
    c == 92 ||
    c == 60 ||
    c == 62 ||
    c == 94 ||
    c == 124 {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: validate RFC 3986 scheme token on `s[start..end]` (`ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )`, max 32 bytes).
fn is_valid_rfc3986_scheme_range(s : String, start : Int, end : Int) -> Bool {
  let n = end - start
  if n <= 0 || n > 32 {
    return false
  }
  let c0 = s.code_unit_at(start)
  if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)) {
    return false
  }
  let mut i = start + 1
  while i < end {
    let c = s.code_unit_at(i)
    let ok = (c >= 97 && c <= 122) ||
    (c >= 65 && c <= 90) ||
    (c >= 48 && c <= 57) ||
    c == 43 ||
    c == 45 ||
    c == 46
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: check for any C0 control byte (0x00..0x1F) or DEL (0x7F) (zero allocation).
fn has_ctl_byte(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 32 || c == 127 {
      return true
    }
    i = i + 1
  }
  false
}

///| Parse a proxy URL (`http`, `https`, `socks5`, `socks5h`, `ssh`).
///| Error messages never echo credentials or sensitive query parameters.
pub fn parse_proxy_url(raw : String) -> Result[ProxyUrl, ProxyError] {
  let n = raw.length()
  if n == 0 {
    return Err(ProxyError::InvalidUrl("empty URL"))
  }
  // Single pass: reject any control character/space and locate first "://".
  let mut sep = -1
  let mut i = 0
  while i < n {
    let c = raw.code_unit_at(i)
    if c <= 32 || c == 127 {
      return Err(ProxyError::InvalidUrl("control character or whitespace in URL"))
    }
    if sep < 0 &&
    c == 58 &&
    i + 2 < n &&
    raw.code_unit_at(i + 1) == 47 &&
    raw.code_unit_at(i + 2) == 47 {
      sep = i
    }
    i = i + 1
  }
  if sep <= 0 {
    return Err(ProxyError::InvalidUrl("missing scheme separator '://'"))
  }
  let scheme = if sep == 4 && str_eq_lower_lit_range(raw, 0, 4, "http") {
    ProxyScheme::Http
  } else if sep == 5 && str_eq_lower_lit_range(raw, 0, 5, "https") {
    ProxyScheme::Https
  } else if sep == 6 && str_eq_lower_lit_range(raw, 0, 6, "socks5") {
    ProxyScheme::Socks5
  } else if sep == 7 && str_eq_lower_lit_range(raw, 0, 7, "socks5h") {
    ProxyScheme::Socks5h
  } else if sep == 3 && str_eq_lower_lit_range(raw, 0, 3, "ssh") {
    ProxyScheme::Ssh
  } else {
    // Only echo a syntactically valid RFC 3986 scheme token (never credentials).
    if !is_valid_rfc3986_scheme_range(raw, 0, sep) {
      return Err(ProxyError::UnsupportedScheme("<invalid>"))
    }
    let safe_scheme = str_slice_ascii_lower(raw, 0, sep)
    return Err(ProxyError::UnsupportedScheme(safe_scheme))
  }

  let auth_start = sep + 3
  if auth_start >= n {
    return Err(ProxyError::InvalidHost("empty authority"))
  }
  // Single pass over authority: find auth_end ('/', '?', '#'), detect '\', and locate LAST '@'.
  let mut auth_end = n
  let mut has_backslash = false
  let mut last_at = -1
  let mut k = auth_start
  while k < n {
    let c = raw.code_unit_at(k)
    if c == 47 || c == 63 || c == 35 {
      auth_end = k
      break
    }
    if c == 92 {
      has_backslash = true
    } else if c == 64 {
      last_at = k
    }
    k = k + 1
  }
  if auth_end == auth_start {
    return Err(ProxyError::InvalidHost("empty host"))
  }
  if has_backslash {
    return Err(ProxyError::InvalidUrl("backslash not allowed in authority"))
  }

  // Extract optional query (?...) up to #fragment
  let mut query_opt : Option[String] = None
  let mut identity_opt : Option[String] = None
  if auth_end < n {
    let mut q_pos = auth_end
    while q_pos < n {
      let c = raw.code_unit_at(q_pos)
      if c == 63 || c == 35 {
        break
      }
      q_pos = q_pos + 1
    }
    if q_pos < n && raw.code_unit_at(q_pos) == 63 {
      let mut q_end = q_pos + 1
      while q_end < n && raw.code_unit_at(q_end) != 35 {
        q_end = q_end + 1
      }
      if q_end > q_pos + 1 {
        query_opt = Some(raw.slice(q_pos + 1, q_end))
        identity_opt = extract_identity_param_range(raw, q_pos + 1, q_end)
      }
    }
  }

  let mut username : Option[String] = None
  let mut password : Option[String] = None
  let mut hp_start = auth_start
  if last_at >= 0 {
    hp_start = last_at + 1
    // Find FIRST ':' in userinfo so passwords containing ':' work.
    let mut first_colon = -1
    let mut u_idx = auth_start
    while u_idx < last_at {
      if raw.code_unit_at(u_idx) == 58 {
        first_colon = u_idx
        break
      }
      u_idx = u_idx + 1
    }
    if first_colon >= 0 {
      let dec_user = match percent_decode_range(raw, auth_start, first_colon) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials("invalid percent-encoding in username"),
        )
      }
      let dec_pass = match percent_decode_range(raw, first_colon + 1, last_at) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials(
            "invalid percent-encoding in credentials",
          ),
        )
      }
      if has_ctl_byte(dec_user) || has_ctl_byte(dec_pass) {
        return Err(
          ProxyError::InvalidCredentials("control character in credentials"),
        )
      }
      if dec_user.length() > 0 {
        username = Some(dec_user)
      }
      password = Some(dec_pass)
    } else {
      let dec_user = match percent_decode_range(raw, auth_start, last_at) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::InvalidCredentials("invalid percent-encoding in username"),
        )
      }
      if has_ctl_byte(dec_user) {
        return Err(
          ProxyError::InvalidCredentials("control character in username"),
        )
      }
      if dec_user.length() > 0 {
        username = Some(dec_user)
      }
    }
  }

  // SSH special rule: reject password in ssh:// URL without echoing credentials.
  match (scheme, password) {
    (ProxyScheme::Ssh, Some(_)) =>
    return Err(
      ProxyError::InvalidCredentials(
        "ssh proxy URL must not contain a password",
      ),
    )
    _ => ()
  }

  if hp_start >= auth_end {
    return Err(ProxyError::InvalidHost("empty host"))
  }

  // Parse hostport: either [IPv6](:port)? or host(:port)?
  let mut host = ""
  let mut port = scheme.default_port()
  let mut explicit_port = false

  if raw.code_unit_at(hp_start) == 91 {
    // Bracketed IPv6 literal
    let mut close_br = -1
    let mut p = hp_start + 1
    while p < auth_end {
      if raw.code_unit_at(p) == 93 {
        close_br = p
        break
      }
      p = p + 1
    }
    if close_br < 0 || close_br == hp_start + 1 {
      return Err(ProxyError::InvalidHost("invalid bracketed IPv6 host"))
    }
    if !is_valid_ipv6_range(raw, hp_start + 1, close_br) {
      return Err(ProxyError::InvalidHost("malformed IPv6 literal"))
    }
    host = str_slice_ascii_lower(raw, hp_start + 1, close_br)
    let after = close_br + 1
    if after < auth_end {
      if raw.code_unit_at(after) != 58 {
        return Err(ProxyError::InvalidHost("unexpected character after IPv6"))
      }
      match parse_port_range(raw, after + 1, auth_end) {
        Some(pv) => {
          port = pv
          explicit_port = true
        }
        None => return Err(ProxyError::InvalidPort("port must be in 1..65535"))
      }
    }
  } else {
    // Plain host (domain or IPv4), at most one ':'
    let mut colon = -1
    let mut colon_count = 0
    let mut p = hp_start
    while p < auth_end {
      if raw.code_unit_at(p) == 58 {
        colon = p
        colon_count = colon_count + 1
      }
      p = p + 1
    }
    if colon_count > 1 {
      return Err(
        ProxyError::InvalidHost("unbracketed IPv6 or multiple colons in host"),
      )
    }
    let host_end = if colon >= 0 { colon } else { auth_end }
    if host_end == hp_start {
      return Err(ProxyError::InvalidHost("empty host"))
    }
    if !validate_plain_host_range(raw, hp_start, host_end) {
      return Err(ProxyError::InvalidHost("invalid host characters"))
    }
    host = str_slice_ascii_lower(raw, hp_start, host_end)
    if colon >= 0 {
      match parse_port_range(raw, colon + 1, auth_end) {
        Some(pv) => {
          port = pv
          explicit_port = true
        }
        None => return Err(ProxyError::InvalidPort("port must be in 1..65535"))
      }
    }
  }

  Ok(
    ProxyUrl::{
      scheme: scheme,
      host: host,
      port: port,
      explicit_port: explicit_port,
      username: username,
      password: password,
      query: query_opt,
      identity: identity_opt,
    },
  )
}

///| Internal: check whether host string contains ':' (IPv6 literal).
fn host_is_ipv6(host : String) -> Bool {
  let n = host.length()
  let mut i = 0
  while i < n {
    if host.code_unit_at(i) == 58 {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal: hex uppercase byte for nibble 0..15.
fn hex_upper_byte(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (55 + v).to_byte()
  }
}

///| Internal: write percent-encoded userinfo directly into StringBuilder (zero alloc when all unreserved).
fn write_pct_encoded_userinfo_sb(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut needs_enc = false
  let mut has_non_ascii = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 128 {
      needs_enc = true
      has_non_ascii = true
      break
    }
    if !(
      (c >= 97 && c <= 122) ||
      (c >= 65 && c <= 90) ||
      (c >= 48 && c <= 57) ||
      c == 45 ||
      c == 46 ||
      c == 95 ||
      c == 126
    ) {
      needs_enc = true
    }
    i = i + 1
  }
  if !needs_enc {
    sb.write_string(s)
    return
  }
  if !has_non_ascii {
    let mut k = 0
    while k < n {
      let c = s.code_unit_at(k)
      if (c >= 97 && c <= 122) ||
      (c >= 65 && c <= 90) ||
      (c >= 48 && c <= 57) ||
      c == 45 ||
      c == 46 ||
      c == 95 ||
      c == 126 {
        sb.write_byte(c.to_byte())
      } else {
        sb.write_byte((37).to_byte())
        sb.write_byte(hex_upper_byte(c >> 4))
        sb.write_byte(hex_upper_byte(c & 0x0F))
      }
      k = k + 1
    }
    return
  }
  let b = s.to_bytes()
  let bn = b.length()
  let mut j = 0
  while j < bn {
    let c = b[j].to_int()
    if (c >= 97 && c <= 122) ||
    (c >= 65 && c <= 90) ||
    (c >= 48 && c <= 57) ||
    c == 45 ||
    c == 46 ||
    c == 95 ||
    c == 126 {
      sb.write_byte(b[j])
    } else {
      sb.write_byte((37).to_byte())
      sb.write_byte(hex_upper_byte(c >> 4))
      sb.write_byte(hex_upper_byte(c & 0x0F))
    }
    j = j + 1
  }
}

///| Render a log-safe URL string.
///| - Redacts userinfo to `***@` for all non-SSH schemes whenever username or password is present.
///| - Preserves percent-encoded username for `ssh://` (never outputs passwords).
///| - Strips query parameters (including SSH `identity` key paths).
pub fn ProxyUrl::redacted(self : ProxyUrl) -> String {
  let scheme_str = self.scheme.as_str()
  let cap = scheme_str.length() + 3 + 4 + self.host.length() + 8
  let sb = StringBuilder::with_capacity(cap)
  sb.write_string(scheme_str)
  sb.write_string("://")
  let is_ssh = match self.scheme {
    ProxyScheme::Ssh => true
    _ => false
  }
  match (self.username, self.password) {
    (_, Some(_)) => sb.write_string("***@")
    (Some(u), None) =>
    if is_ssh {
      if u.length() > 0 {
        write_pct_encoded_userinfo_sb(sb, u)
        sb.write_byte((64).to_byte())
      }
    } else {
      sb.write_string("***@")
    }
    _ => ()
  }
  if host_is_ipv6(self.host) {
    sb.write_byte((91).to_byte())
    sb.write_string(self.host)
    sb.write_byte((93).to_byte())
  } else {
    sb.write_string(self.host)
  }
  sb.write_byte((58).to_byte())
  write_nonneg_int_sb(sb, self.port)
  sb.to_string()
}

///| Alias of `ProxyUrl::redacted`.
pub fn ProxyUrl::to_safe_string(self : ProxyUrl) -> String {
  self.redacted()
}

///| Returns `true` for schemes that resolve target hostnames remotely (`socks5h`, `http`, `https`, `ssh`),
///| and `false` for `socks5` (local DNS resolution).
pub fn ProxyUrl::uses_remote_dns(self : ProxyUrl) -> Bool {
  self.scheme.uses_remote_dns()
}

///| Extract credentials as `Option[ProxyAuth]` when username or password is present.
pub fn ProxyUrl::auth(self : ProxyUrl) -> Option[ProxyAuth] {
  match self.username {
    Some(u) =>
    match self.password {
      Some(p) => Some(ProxyAuth::new(u, p))
      None => Some(ProxyAuth::new(u, ""))
    }
    None =>
    match self.password {
      Some(p) => Some(ProxyAuth::new("", p))
      None => None
    }
  }
}

///| Internal NO_PROXY rule representation.
pub enum NoProxyRule {
  Wildcard
  Domain(String, Bool, Option[Int])
  Ipv4(Bytes, Option[Int])
  Ipv6(Bytes, Option[Int])
  Ipv4Cidr(Bytes, Int)
  Ipv6Cidr(Bytes, Int)
}

///| Compiled comma-separated NO_PROXY matcher with pre-indexed fast tables.
pub struct NoProxyMatcher {
  pub rules : Array[NoProxyRule]
  has_wildcard : Bool
  v4_nets : Array[Int64]
  v4_masks : Array[Int64]
  v4_ports : Array[Int]
  v6_rules : Array[NoProxyRule]
  dom_suffixes : Array[String]
  dom_exact : Array[Bool]
  dom_ports : Array[Int]
}

///| Internal: parse non-negative integer prefix length in 0..=max_bits from `s[start..end]`.
fn parse_prefix_len_range(
  s : String,
  start : Int,
  end : Int,
  max_bits : Int,
) -> Option[Int] {
  let n = end - start
  if n <= 0 || n > 3 {
    return None
  }
  let mut v = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  if v < 0 || v > max_bits {
    return None
  }
  Some(v)
}

///| Internal: check whether `ip` and `net` match on the top `prefix` bits.
fn bytes_match_cidr(ip : Bytes, net : Bytes, prefix : Int) -> Bool {
  let full_bytes = prefix >> 3
  let rem_bits = prefix & 7
  let mut i = 0
  while i < full_bytes {
    if ip[i] != net[i] {
      return false
    }
    i = i + 1
  }
  if rem_bits > 0 {
    let mask = (0xFF << (8 - rem_bits)) & 0xFF
    if (ip[full_bytes].to_int() & mask) != (net[full_bytes].to_int() & mask) {
      return false
    }
  }
  true
}

///| Parse a single trimmed NO_PROXY entry into a rule.
fn parse_single_no_proxy_rule(entry : String) -> Option[NoProxyRule] {
  let n = entry.length()
  if n == 0 {
    return None
  }
  if n == 1 && entry.code_unit_at(0) == 42 {
    return Some(NoProxyRule::Wildcard)
  }
  if n > 2 && entry.code_unit_at(0) == 42 && entry.code_unit_at(1) == 46 {
    return parse_single_no_proxy_rule(entry.slice(1, n))
  }
  // Check for CIDR '/'
  let mut slash = -1
  let mut i = 0
  while i < n {
    if entry.code_unit_at(i) == 47 {
      slash = i
      break
    }
    i = i + 1
  }
  if slash >= 0 {
    let v4 = parse_ipv4_u32_range(entry, 0, slash)
    if v4 >= 0L {
      match parse_prefix_len_range(entry, slash + 1, n, 32) {
        Some(bits) => return Some(NoProxyRule::Ipv4Cidr(ipv4_u32_to_bytes(v4), bits))
        None => return None
      }
    }
    match parse_ipv6_octets_range(entry, 0, slash) {
      Some(v6) =>
      match parse_prefix_len_range(entry, slash + 1, n, 128) {
        Some(bits) => return Some(NoProxyRule::Ipv6Cidr(v6, bits))
        None => return None
      }
      None => return None
    }
  }

  // Check for [IPv6] or [IPv6]:port
  if entry.code_unit_at(0) == 91 {
    let mut close_br = -1
    let mut p = 1
    while p < n {
      if entry.code_unit_at(p) == 93 {
        close_br = p
        break
      }
      p = p + 1
    }
    if close_br < 0 {
      return None
    }
    let v6 = match parse_ipv6_octets_range(entry, 1, close_br) {
      Some(v) => v
      None => return None
    }
    let mut port_opt : Option[Int] = None
    if close_br + 1 < n {
      if entry.code_unit_at(close_br + 1) != 58 {
        return None
      }
      match parse_port_range(entry, close_br + 2, n) {
        Some(pv) => port_opt = Some(pv)
        None => return None
      }
    }
    return Some(NoProxyRule::Ipv6(v6, port_opt))
  }

  // Bare IPv6 literal (contains >= 2 colons)
  let mut colons = 0
  let mut last_colon = -1
  let mut k = 0
  while k < n {
    if entry.code_unit_at(k) == 58 {
      colons = colons + 1
      last_colon = k
    }
    k = k + 1
  }
  if colons >= 2 {
    match parse_ipv6_octets_range(entry, 0, n) {
      Some(v6) => return Some(NoProxyRule::Ipv6(v6, None))
      None => return None
    }
  }

  // Optional :port suffix for IPv4 or domain
  let mut host_end = n
  let mut port_opt : Option[Int] = None
  if colons == 1 {
    host_end = last_colon
    match parse_port_range(entry, last_colon + 1, n) {
      Some(pv) => port_opt = Some(pv)
      None => return None
    }
  }
  if host_end == 0 {
    return None
  }

  // IPv4 literal?
  let v4 = parse_ipv4_u32_range(entry, 0, host_end)
  if v4 >= 0L {
    return Some(NoProxyRule::Ipv4(ipv4_u32_to_bytes(v4), port_opt))
  }

  // Domain rule (`example.com` -> match_exact=true; `.example.com` -> match_exact=false)
  let mut d_start = 0
  let mut d_end = host_end
  if d_end > d_start && entry.code_unit_at(d_end - 1) == 46 {
    d_end = d_end - 1
  }
  let mut match_exact = true
  if d_end > d_start && entry.code_unit_at(d_start) == 46 {
    match_exact = false
    d_start = d_start + 1
  }
  if d_start >= d_end {
    return None
  }
  let lower = str_slice_ascii_lower(entry, d_start, d_end)
  Some(NoProxyRule::Domain(lower, match_exact, port_opt))
}

///| Internal: convert 4-byte IPv4 Bytes to packed Int64.
fn ipv4_bytes_to_u32(b : Bytes) -> Int64 {
  ((b[0].to_int().to_int64() << 24) |
    (b[1].to_int().to_int64() << 16) |
    (b[2].to_int().to_int64() << 8) |
    b[3].to_int().to_int64())
}

///| Parse a comma-separated `NO_PROXY` rule list.
pub fn NoProxyMatcher::parse(raw : String) -> NoProxyMatcher {
  let rules : Array[NoProxyRule] = []
  let mut has_wildcard = false
  let v4_nets : Array[Int64] = []
  let v4_masks : Array[Int64] = []
  let v4_ports : Array[Int] = []
  let v6_rules : Array[NoProxyRule] = []
  let dom_suffixes : Array[String] = []
  let dom_exact : Array[Bool] = []
  let dom_ports : Array[Int] = []

  let n = raw.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || raw.code_unit_at(i) == 44 {
      let item = trim_ascii_ws(raw.slice(start, i))
      match parse_single_no_proxy_rule(item) {
        Some(r) => {
          rules.push(r)
          match r {
            NoProxyRule::Wildcard => has_wildcard = true
            NoProxyRule::Ipv4(b, rp) => {
              v4_nets.push(ipv4_bytes_to_u32(b))
              v4_masks.push(0xFFFFFFFFL)
              v4_ports.push(match rp { Some(p) => p; None => 0 })
            }
            NoProxyRule::Ipv4Cidr(b, bits) => {
              let mask = if bits == 0 {
                0L
              } else {
                (0xFFFFFFFFL << (32 - bits)) & 0xFFFFFFFFL
              }
              v4_nets.push(ipv4_bytes_to_u32(b) & mask)
              v4_masks.push(mask)
              v4_ports.push(0)
            }
            NoProxyRule::Ipv6(_, _) => v6_rules.push(r)
            NoProxyRule::Ipv6Cidr(_, _) => v6_rules.push(r)
            NoProxyRule::Domain(sfx, ex, rp) => {
              dom_suffixes.push(sfx)
              dom_exact.push(ex)
              dom_ports.push(match rp { Some(p) => p; None => 0 })
            }
          }
        }
        None => ()
      }
      start = i + 1
    }
    i = i + 1
  }
  NoProxyMatcher::{
    rules: rules,
    has_wildcard: has_wildcard,
    v4_nets: v4_nets,
    v4_masks: v4_masks,
    v4_ports: v4_ports,
    v6_rules: v6_rules,
    dom_suffixes: dom_suffixes,
    dom_exact: dom_exact,
    dom_ports: dom_ports,
  }
}

///| Internal: check optional rule port against target port.
fn port_matches(rule_port : Option[Int], target_port : Int) -> Bool {
  match rule_port {
    None => true
    Some(rp) => target_port > 0 && rp == target_port
  }
}

///| Internal: match packed IPv4 u32 against pre-indexed IPv4 / IPv4-CIDR rules.
fn match_v4_rules(
  self : NoProxyMatcher,
  ip : Int64,
  port : Int,
) -> Bool {
  let n = self.v4_nets.length()
  let mut i = 0
  while i < n {
    let rp = self.v4_ports[i]
    if (rp == 0 || rp == port) && (ip & self.v4_masks[i]) == self.v4_nets[i] {
      return true
    }
    i = i + 1
  }
  false
}

///| Return `true` if `(host, port)` should bypass the proxy.
pub fn NoProxyMatcher::matches(
  self : NoProxyMatcher,
  host : String,
  port : Int,
) -> Bool {
  if self.rules.length() == 0 {
    return false
  }
  // Trim ASCII whitespace in-place (zero allocation).
  let mut start = 0
  let mut end = host.length()
  while start < end {
    let c = host.code_unit_at(start)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      start = start + 1
    } else {
      break
    }
  }
  while end > start {
    let c = host.code_unit_at(end - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      end = end - 1
    } else {
      break
    }
  }
  if start >= end {
    return false
  }
  if self.has_wildcard {
    return true
  }
  // Strip optional surrounding [ ] for IPv6 targets (zero allocation).
  if end - start >= 2 &&
  host.code_unit_at(start) == 91 &&
  host.code_unit_at(end - 1) == 93 {
    start = start + 1
    end = end - 1
    if start >= end {
      return false
    }
  }

  let len = end - start
  let c0 = host.code_unit_at(start)

  // Fast IPv4 check: only when first byte is '0'..'9' and length is 7..15.
  if c0 >= 48 && c0 <= 57 && len >= 7 && len <= 15 {
    let v4 = parse_ipv4_u32_range(host, start, end)
    if v4 >= 0L {
      return match_v4_rules(self, v4, port)
    }
  }

  // Fast IPv6 check: only when we have IPv6 or IPv4 rules AND first char can start IPv6 (':' or hex digit) AND string contains ':'.
  if (self.v6_rules.length() > 0 || self.v4_nets.length() > 0) &&
  len >= 2 &&
  len <= 45 &&
  (c0 == 58 || (c0 >= 48 && c0 <= 57) || (c0 >= 97 && c0 <= 102) || (c0 >= 65 && c0 <= 70)) {
    let mut has_colon = c0 == 58
    if !has_colon {
      let mut ci = start + 1
      while ci < end {
        let ch = host.code_unit_at(ci)
        if ch == 58 {
          has_colon = true
          break
        }
        if !((ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)) {
          break
        }
        ci = ci + 1
      }
    }
    if has_colon {
      match parse_ipv6_octets_range(host, start, end) {
        Some(v6) => {
          // Check IPv6 rules first.
          let v6n = self.v6_rules.length()
          let mut vi = 0
          while vi < v6n {
            match self.v6_rules[vi] {
              NoProxyRule::Ipv6(rule_v6, rp) =>
              if port_matches(rp, port) && internal_bytes_eq(v6, rule_v6) {
                return true
              }
              NoProxyRule::Ipv6Cidr(net, bits) =>
              if bytes_match_cidr(v6, net, bits) {
                return true
              }
              _ => ()
            }
            vi = vi + 1
          }
          // Unmap IPv4-mapped IPv6 (::ffff:a.b.c.d) so IPv4 / IPv4-CIDR rules match.
          if self.v4_nets.length() > 0 &&
          v6[10].to_int() == 255 &&
          v6[11].to_int() == 255 {
            let mut mapped = true
            let mut z = 0
            while z < 10 {
              if v6[z].to_int() != 0 {
                mapped = false
                break
              }
              z = z + 1
            }
            if mapped {
              let mapped_v4 = ((v6[12].to_int().to_int64() << 24) |
                (v6[13].to_int().to_int64() << 16) |
                (v6[14].to_int().to_int64() << 8) |
                v6[15].to_int().to_int64())
              if match_v4_rules(self, mapped_v4, port) {
                return true
              }
            }
          }
          return false
        }
        None => ()
      }
    }
  }

  // Domain rules (zero-allocation case-insensitive matching).
  let dn = self.dom_suffixes.length()
  if dn == 0 {
    return false
  }
  let mut dom_end = end
  if dom_end > start && host.code_unit_at(dom_end - 1) == 46 {
    dom_end = dom_end - 1
  }
  let dom_len = dom_end - start
  if dom_len <= 0 {
    return false
  }
  let last_c = ascii_lower_cu(host.code_unit_at(dom_end - 1))
  let mut di = 0
  while di < dn {
    let rp = self.dom_ports[di]
    if rp == 0 || rp == port {
      let sfx = self.dom_suffixes[di]
      let slen = sfx.length()
      if dom_len >= slen && last_c == sfx.code_unit_at(slen - 1) {
        if dom_len == slen {
          if self.dom_exact[di] && str_eq_lower_lit_range(host, start, dom_end, sfx) {
            return true
          }
        } else if host.code_unit_at(dom_end - slen - 1) == 46 &&
        str_eq_lower_lit_range(host, dom_end - slen, dom_end, sfx) {
          return true
        }
      }
    }
    di = di + 1
  }
  false
}

///| Convenience wrapper matching a host without a port constraint.
pub fn NoProxyMatcher::matches_host(self : NoProxyMatcher, host : String) -> Bool {
  self.matches(host, 0)
}
