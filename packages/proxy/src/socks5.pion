///| Bidirectional Sans-IO SOCKS5 protocol codec (RFC 1928 + RFC 1929).

///| RFC 1928 §3 authentication method identifiers.
pub enum SocksAuthMethod {
  NoAuth
  GssApi
  UserPass
  NoAcceptable
  Other(Int)
}

///|
pub fn SocksAuthMethod::to_byte(self : SocksAuthMethod) -> Byte {
  match self {
    SocksAuthMethod::NoAuth => (0x00).to_byte()
    SocksAuthMethod::GssApi => (0x01).to_byte()
    SocksAuthMethod::UserPass => (0x02).to_byte()
    SocksAuthMethod::NoAcceptable => (0xFF).to_byte()
    SocksAuthMethod::Other(v) => v.to_byte()
  }
}

///|
pub fn socks_auth_method_from_byte(b : Byte) -> SocksAuthMethod {
  let v = b.to_int()
  if v == 0x00 {
    SocksAuthMethod::NoAuth
  } else if v == 0x01 {
    SocksAuthMethod::GssApi
  } else if v == 0x02 {
    SocksAuthMethod::UserPass
  } else if v == 0xFF {
    SocksAuthMethod::NoAcceptable
  } else {
    SocksAuthMethod::Other(v)
  }
}

///|
pub fn socks_auth_method_eq(a : SocksAuthMethod, b : SocksAuthMethod) -> Bool {
  a.to_byte() == b.to_byte()
}

///| RFC 1928 §4 command codes.
pub enum SocksCommand {
  Connect
  Bind
  UdpAssociate
}

///|
pub fn SocksCommand::to_byte(self : SocksCommand) -> Byte {
  match self {
    SocksCommand::Connect => (0x01).to_byte()
    SocksCommand::Bind => (0x02).to_byte()
    SocksCommand::UdpAssociate => (0x03).to_byte()
  }
}

///|
pub fn socks_command_eq(a : SocksCommand, b : SocksCommand) -> Bool {
  a.to_byte() == b.to_byte()
}

///| RFC 1928 §5 target/bind address (`ATYP=0x01`, `0x03`, `0x04`).
pub enum SocksAddr {
  Ipv4(Bytes)
  Ipv6(Bytes)
  Domain(String)
}

///|
pub fn socks_addr_eq(a : SocksAddr, b : SocksAddr) -> Bool {
  match (a, b) {
    (SocksAddr::Ipv4(x), SocksAddr::Ipv4(y)) => internal_bytes_eq(x, y)
    (SocksAddr::Ipv6(x), SocksAddr::Ipv6(y)) => internal_bytes_eq(x, y)
    (SocksAddr::Domain(x), SocksAddr::Domain(y)) => x == y
    _ => false
  }
}

///| Client greeting message.
pub struct SocksGreeting {
  pub methods : Array[SocksAuthMethod]
}

///| RFC 1929 username/password authentication request.
pub val struct SocksUserPassRequest {
  pub username : String
  pub password : String
}

///| RFC 1928 §4 client request.
pub struct SocksRequest {
  pub command : SocksCommand
  pub addr : SocksAddr
  pub port : Int
}

///| RFC 1928 §6 server reply.
pub struct SocksReply {
  pub reply : SocksReplyCode
  pub bind_addr : SocksAddr
  pub bind_port : Int
}

///| Internal: encode the 4-byte header + address + 2-byte big-endian port used by both requests and replies.
fn socks5_encode_addr_frame(
  b1 : Byte,
  addr : SocksAddr,
  port : Int,
) -> Result[Bytes, ProxyError] {
  match addr {
    SocksAddr::Ipv4(ip) => {
      if ip.length() != 4 {
        return Err(ProxyError::InvalidAddress("IPv4 address must be 4 bytes"))
      }
      let mut out = Bytes::new(10)
      out[0] = (0x05).to_byte()
      out[1] = b1
      out[2] = (0x00).to_byte()
      out[3] = (0x01).to_byte()
      out[4] = ip[0]
      out[5] = ip[1]
      out[6] = ip[2]
      out[7] = ip[3]
      out[8] = ((port >> 8) & 0xFF).to_byte()
      out[9] = (port & 0xFF).to_byte()
      Ok(out)
    }
    SocksAddr::Ipv6(ip) => {
      if ip.length() != 16 {
        return Err(ProxyError::InvalidAddress("IPv6 address must be 16 bytes"))
      }
      let mut out = Bytes::new(22)
      out[0] = (0x05).to_byte()
      out[1] = b1
      out[2] = (0x00).to_byte()
      out[3] = (0x04).to_byte()
      let mut i = 0
      while i < 16 {
        out[4 + i] = ip[i]
        i = i + 1
      }
      out[20] = ((port >> 8) & 0xFF).to_byte()
      out[21] = (port & 0xFF).to_byte()
      Ok(out)
    }
    SocksAddr::Domain(d) => {
      let dn = d.length()
      if dn == 0 || dn > 255 {
        return Err(
          ProxyError::InvalidAddress("SOCKS5 domain must be 1..255 bytes"),
        )
      }
      // Single-pass ASCII fast path: validate CRLF/NUL and write directly into out.
      let mut out = Bytes::new(7 + dn)
      out[0] = (0x05).to_byte()
      out[1] = b1
      out[2] = (0x00).to_byte()
      out[3] = (0x03).to_byte()
      out[4] = dn.to_byte()
      let mut non_ascii = false
      let mut i = 0
      while i < dn {
        let c = d.code_unit_at(i)
        if c == 13 || c == 10 || c == 0 {
          return Err(
            ProxyError::CrlfInjection("CRLF/NUL not allowed in SOCKS5 domain"),
          )
        }
        if c >= 128 {
          non_ascii = true
          break
        }
        out[5 + i] = c.to_byte()
        i = i + 1
      }
      if !non_ascii {
        out[5 + dn] = ((port >> 8) & 0xFF).to_byte()
        out[6 + dn] = (port & 0xFF).to_byte()
        return Ok(out)
      }
      // Fallback for non-ASCII UTF-8 domains.
      let db = d.to_bytes()
      let dlen = db.length()
      if dlen == 0 || dlen > 255 {
        return Err(
          ProxyError::InvalidAddress("SOCKS5 domain must be 1..255 bytes"),
        )
      }
      let mut out2 = Bytes::new(7 + dlen)
      out2[0] = (0x05).to_byte()
      out2[1] = b1
      out2[2] = (0x00).to_byte()
      out2[3] = (0x03).to_byte()
      out2[4] = dlen.to_byte()
      let mut j = 0
      while j < dlen {
        let c = db[j].to_int()
        if c == 13 || c == 10 || c == 0 {
          return Err(
            ProxyError::CrlfInjection("CRLF/NUL not allowed in SOCKS5 domain"),
          )
        }
        out2[5 + j] = db[j]
        j = j + 1
      }
      out2[5 + dlen] = ((port >> 8) & 0xFF).to_byte()
      out2[6 + dlen] = (port & 0xFF).to_byte()
      Ok(out2)
    }
  }
}

///| Client -> Server: encode RFC 1928 §3 greeting (`VER=0x05, NMETHODS, METHODS...`).
pub fn socks5_encode_greeting(
  methods : Array[SocksAuthMethod],
) -> Result[Bytes, ProxyError] {
  let n = methods.length()
  if n == 0 || n > 255 {
    return Err(
      ProxyError::InvalidCredentials(
        "SOCKS5 greeting requires 1..255 auth methods",
      ),
    )
  }
  let mut out = Bytes::new(2 + n)
  out[0] = (0x05).to_byte()
  out[1] = n.to_byte()
  let mut i = 0
  while i < n {
    let m = methods[i]
    let b = match m {
      SocksAuthMethod::NoAuth => (0x00).to_byte()
      SocksAuthMethod::GssApi => (0x01).to_byte()
      SocksAuthMethod::UserPass => (0x02).to_byte()
      SocksAuthMethod::NoAcceptable => (0xFF).to_byte()
      SocksAuthMethod::Other(v) => {
        if v < 3 || v > 254 {
          return Err(
            ProxyError::InvalidCredentials(
              "SOCKS5 Other auth method must be in 3..254",
            ),
          )
        }
        v.to_byte()
      }
    }
    out[2 + i] = b
    i = i + 1
  }
  Ok(out)
}

///| Server side: streaming decode of RFC 1928 §3 client greeting.
pub fn socks5_decode_greeting(
  buf : Bytes,
) -> Result[DecodeStatus[SocksGreeting], ProxyError] {
  let n = buf.length()
  if n < 2 {
    return Ok(DecodeStatus::NeedMore(2 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x05 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  let nmethods = buf[1].to_int()
  if nmethods == 0 {
    return Err(ProxyError::NoAcceptableAuthMethods)
  }
  let total = 2 + nmethods
  if n < total {
    return Ok(DecodeStatus::NeedMore(total - n))
  }
  let methods : Array[SocksAuthMethod] = Array::with_capacity(nmethods)
  let mut i = 0
  while i < nmethods {
    methods.push(socks_auth_method_from_byte(buf[2 + i]))
    i = i + 1
  }
  Ok(DecodeStatus::Complete(SocksGreeting::{ methods: methods }, total))
}

///| Server -> Client: encode RFC 1928 §3 method selection (`VER=0x05, METHOD`).
pub fn socks5_encode_method_selection(method : SocksAuthMethod) -> Bytes {
  let mut out = Bytes::new(2)
  out[0] = (0x05).to_byte()
  out[1] = method.to_byte()
  out
}

///| Client side: streaming decode of RFC 1928 §3 method selection.
pub fn socks5_decode_method_selection(
  buf : Bytes,
) -> Result[DecodeStatus[SocksAuthMethod], ProxyError] {
  let n = buf.length()
  if n < 2 {
    return Ok(DecodeStatus::NeedMore(2 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x05 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  let m = socks_auth_method_from_byte(buf[1])
  match m {
    SocksAuthMethod::NoAcceptable => Err(ProxyError::NoAcceptableAuthMethods)
    _ => Ok(DecodeStatus::Complete(m, 2))
  }
}

///| Client -> Server: encode RFC 1929 username/password authentication request (`VER=0x01`).
pub fn socks5_encode_userpass_request(
  username : String,
  password : String,
) -> Result[Bytes, ProxyError] {
  let un = username.length()
  let pn = password.length()
  if un == 0 || un > 255 {
    return Err(
      ProxyError::InvalidCredentials("SOCKS5 username must be 1..255 bytes"),
    )
  }
  if pn == 0 || pn > 255 {
    return Err(
      ProxyError::InvalidCredentials("SOCKS5 password must be 1..255 bytes"),
    )
  }
  // Single-allocation ASCII fast path.
  let mut out = Bytes::new(3 + un + pn)
  out[0] = (0x01).to_byte()
  out[1] = un.to_byte()
  let mut non_ascii = false
  let mut i = 0
  while i < un {
    let c = username.code_unit_at(i)
    if c >= 128 {
      non_ascii = true
      break
    }
    out[2 + i] = c.to_byte()
    i = i + 1
  }
  if !non_ascii {
    out[2 + un] = pn.to_byte()
    let mut j = 0
    while j < pn {
      let c = password.code_unit_at(j)
      if c >= 128 {
        non_ascii = true
        break
      }
      out[3 + un + j] = c.to_byte()
      j = j + 1
    }
    if !non_ascii {
      return Ok(out)
    }
  }
  // Fallback for non-ASCII UTF-8 credentials.
  let ub = username.to_bytes()
  let pb = password.to_bytes()
  let ulen = ub.length()
  let plen = pb.length()
  if ulen == 0 || ulen > 255 {
    return Err(
      ProxyError::InvalidCredentials("SOCKS5 username must be 1..255 bytes"),
    )
  }
  if plen == 0 || plen > 255 {
    return Err(
      ProxyError::InvalidCredentials("SOCKS5 password must be 1..255 bytes"),
    )
  }
  let mut out2 = Bytes::new(3 + ulen + plen)
  out2[0] = (0x01).to_byte()
  out2[1] = ulen.to_byte()
  let mut ui = 0
  while ui < ulen {
    out2[2 + ui] = ub[ui]
    ui = ui + 1
  }
  out2[2 + ulen] = plen.to_byte()
  let mut pi = 0
  while pi < plen {
    out2[3 + ulen + pi] = pb[pi]
    pi = pi + 1
  }
  Ok(out2)
}

///| Server side: streaming decode of RFC 1929 username/password request.
pub fn socks5_decode_userpass_request(
  buf : Bytes,
) -> Result[DecodeStatus[SocksUserPassRequest], ProxyError] {
  let n = buf.length()
  if n < 2 {
    return Ok(DecodeStatus::NeedMore(2 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x01 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  let ulen = buf[1].to_int()
  if ulen == 0 {
    return Err(ProxyError::InvalidCredentials("empty SOCKS5 username"))
  }
  if n < 3 + ulen {
    return Ok(DecodeStatus::NeedMore(3 + ulen - n))
  }
  let plen = buf[2 + ulen].to_int()
  if plen == 0 {
    return Err(ProxyError::InvalidCredentials("empty SOCKS5 password"))
  }
  let total = 3 + ulen + plen
  if n < total {
    return Ok(DecodeStatus::NeedMore(total - n))
  }
  let username = buf.slice(2, 2 + ulen).to_string()
  let password = buf.slice(3 + ulen, total).to_string()
  Ok(
    DecodeStatus::Complete(
      SocksUserPassRequest::{ username: username, password: password },
      total,
    ),
  )
}

///| Server -> Client: encode RFC 1929 authentication response (`VER=0x01, STATUS`).
pub fn socks5_encode_userpass_response(accepted : Bool) -> Bytes {
  let mut out = Bytes::new(2)
  out[0] = (0x01).to_byte()
  out[1] = if accepted { (0x00).to_byte() } else { (0x01).to_byte() }
  out
}

///| Client side: streaming decode of RFC 1929 authentication response.
pub fn socks5_decode_userpass_response(
  buf : Bytes,
) -> Result[DecodeStatus[Bool], ProxyError] {
  let n = buf.length()
  if n < 2 {
    return Ok(DecodeStatus::NeedMore(2 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x01 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  let status = buf[1].to_int()
  if status == 0x00 {
    Ok(DecodeStatus::Complete(true, 2))
  } else {
    Err(ProxyError::AuthRejected(status))
  }
}

///| Client -> Server: encode RFC 1928 §4 request (`CONNECT`, `BIND`, `UDP_ASSOCIATE`).
pub fn socks5_encode_request(
  cmd : SocksCommand,
  addr : SocksAddr,
  port : Int,
) -> Result[Bytes, ProxyError] {
  let cmd_b = match cmd {
    SocksCommand::Connect => {
      if port <= 0 || port > 65535 {
        return Err(
          ProxyError::InvalidPort("SOCKS5 CONNECT port must be 1..65535"),
        )
      }
      (0x01).to_byte()
    }
    SocksCommand::Bind => {
      if port < 0 || port > 65535 {
        return Err(ProxyError::InvalidPort("SOCKS5 port must be 0..65535"))
      }
      (0x02).to_byte()
    }
    SocksCommand::UdpAssociate => {
      if port < 0 || port > 65535 {
        return Err(ProxyError::InvalidPort("SOCKS5 port must be 0..65535"))
      }
      (0x03).to_byte()
    }
  }
  socks5_encode_addr_frame(cmd_b, addr, port)
}

///| Server side: streaming decode of RFC 1928 §4 client request.
pub fn socks5_decode_request(
  buf : Bytes,
) -> Result[DecodeStatus[SocksRequest], ProxyError] {
  let n = buf.length()
  if n < 4 {
    return Ok(DecodeStatus::NeedMore(4 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x05 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  let cmd_byte = buf[1].to_int()
  let cmd = if cmd_byte == 0x01 {
    SocksCommand::Connect
  } else if cmd_byte == 0x02 {
    SocksCommand::Bind
  } else if cmd_byte == 0x03 {
    SocksCommand::UdpAssociate
  } else {
    return Err(ProxyError::InvalidSocksCommand(cmd_byte))
  }
  if buf[2].to_int() != 0x00 {
    return Err(ProxyError::InvalidAddress("non-zero RSV byte in SOCKS5 request"))
  }
  let atyp = buf[3].to_int()
  if atyp == 0x03 {
    if n < 5 {
      return Ok(DecodeStatus::NeedMore(5 - n))
    }
    let dlen = buf[4].to_int()
    if dlen == 0 {
      return Err(ProxyError::InvalidAddress("empty SOCKS5 domain"))
    }
    let total = 7 + dlen
    if n < total {
      return Ok(DecodeStatus::NeedMore(total - n))
    }
    let end = 5 + dlen
    let mut i = 5
    while i < end {
      let c = buf[i].to_int()
      if c == 13 || c == 10 || c == 0 {
        return Err(
          ProxyError::CrlfInjection("CRLF/NUL not allowed in SOCKS5 domain"),
        )
      }
      i = i + 1
    }
    let dom = buf.slice(5, end).to_string()
    let port = (buf[end].to_int() << 8) | buf[end + 1].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksRequest::{ command: cmd, addr: SocksAddr::Domain(dom), port: port },
        total,
      ),
    )
  } else if atyp == 0x01 {
    if n < 10 {
      return Ok(DecodeStatus::NeedMore(10 - n))
    }
    let ip = buf.slice(4, 8)
    let port = (buf[8].to_int() << 8) | buf[9].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksRequest::{ command: cmd, addr: SocksAddr::Ipv4(ip), port: port },
        10,
      ),
    )
  } else if atyp == 0x04 {
    if n < 22 {
      return Ok(DecodeStatus::NeedMore(22 - n))
    }
    let ip = buf.slice(4, 20)
    let port = (buf[20].to_int() << 8) | buf[21].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksRequest::{ command: cmd, addr: SocksAddr::Ipv6(ip), port: port },
        22,
      ),
    )
  } else {
    Err(ProxyError::InvalidAddressType(atyp))
  }
}

///| Server -> Client: encode RFC 1928 §6 reply.
pub fn socks5_encode_reply(
  reply : SocksReplyCode,
  bind_addr : SocksAddr,
  bind_port : Int,
) -> Result[Bytes, ProxyError] {
  if bind_port < 0 || bind_port > 65535 {
    return Err(ProxyError::InvalidPort("SOCKS5 bind port must be 0..65535"))
  }
  match reply {
    SocksReplyCode::Unassigned(v) =>
    if v < 9 || v > 255 {
      return Err(ProxyError::InvalidSocksReply(v))
    }
    _ => ()
  }
  socks5_encode_addr_frame(reply.to_byte(), bind_addr, bind_port)
}

///| Client side: streaming decode of RFC 1928 §6 server reply (preserves trailing pipelined bytes).
pub fn socks5_decode_reply(
  buf : Bytes,
) -> Result[DecodeStatus[SocksReply], ProxyError] {
  let n = buf.length()
  if n < 4 {
    return Ok(DecodeStatus::NeedMore(4 - n))
  }
  let ver = buf[0].to_int()
  if ver != 0x05 {
    return Err(ProxyError::InvalidProtocolVersion(ver))
  }
  if buf[2].to_int() != 0x00 {
    return Err(ProxyError::InvalidSocksReply(buf[2].to_int()))
  }
  let rep_b = buf[1]
  let rep_i = rep_b.to_int()
  let reply = if rep_i == 0x00 {
    SocksReplyCode::Succeeded
  } else {
    socks_reply_code_from_byte(rep_b)
  }
  let is_failure = rep_i != 0x00
  let atyp = buf[3].to_int()
  if atyp == 0x01 {
    if n < 10 {
      return Ok(DecodeStatus::NeedMore(10 - n))
    }
    let ip = buf.slice(4, 8)
    let port = (buf[8].to_int() << 8) | buf[9].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksReply::{
          reply: reply,
          bind_addr: SocksAddr::Ipv4(ip),
          bind_port: port,
        },
        10,
      ),
    )
  } else if atyp == 0x04 {
    if n < 22 {
      return Ok(DecodeStatus::NeedMore(22 - n))
    }
    let ip = buf.slice(4, 20)
    let port = (buf[20].to_int() << 8) | buf[21].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksReply::{
          reply: reply,
          bind_addr: SocksAddr::Ipv6(ip),
          bind_port: port,
        },
        22,
      ),
    )
  } else if atyp == 0x03 {
    if n < 5 {
      return Ok(DecodeStatus::NeedMore(5 - n))
    }
    let dlen = buf[4].to_int()
    if dlen == 0 {
      if is_failure {
        return Err(ProxyError::SocksFailure(reply))
      }
      return Err(ProxyError::InvalidAddress("empty SOCKS5 domain"))
    }
    let total = 7 + dlen
    if n < total {
      return Ok(DecodeStatus::NeedMore(total - n))
    }
    let end = 5 + dlen
    let mut i = 5
    while i < end {
      let c = buf[i].to_int()
      if c == 13 || c == 10 || c == 0 {
        if is_failure {
          return Err(ProxyError::SocksFailure(reply))
        }
        return Err(
          ProxyError::CrlfInjection("CRLF/NUL not allowed in SOCKS5 domain"),
        )
      }
      i = i + 1
    }
    let dom = buf.slice(5, end).to_string()
    let port = (buf[end].to_int() << 8) | buf[end + 1].to_int()
    Ok(
      DecodeStatus::Complete(
        SocksReply::{
          reply: reply,
          bind_addr: SocksAddr::Domain(dom),
          bind_port: port,
        },
        total,
      ),
    )
  } else if is_failure {
    Err(ProxyError::SocksFailure(reply))
  } else {
    Err(ProxyError::InvalidAddressType(atyp))
  }
}
