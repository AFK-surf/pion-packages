///| Bidirectional Sans-IO SOCKS5 protocol codec (RFC 1928 + RFC 1929).

///| RFC 1928 §3 authentication method identifiers.
pub enum SocksAuthMethod {
  NoAuth
  GssApi
  UserPass
  NoAcceptable
  Other(Int)
}

///|
pub fn SocksAuthMethod::to_byte(self : SocksAuthMethod) -> Byte {
  let _ = self
  (0).to_byte()
}

///|
pub fn socks_auth_method_from_byte(b : Byte) -> SocksAuthMethod {
  let _ = b
  SocksAuthMethod::NoAcceptable
}

///|
pub fn socks_auth_method_eq(a : SocksAuthMethod, b : SocksAuthMethod) -> Bool {
  let _ = a
  let _ = b
  false
}

///| RFC 1928 §4 command codes.
pub enum SocksCommand {
  Connect
  Bind
  UdpAssociate
}

///|
pub fn SocksCommand::to_byte(self : SocksCommand) -> Byte {
  let _ = self
  (0).to_byte()
}

///|
pub fn socks_command_eq(a : SocksCommand, b : SocksCommand) -> Bool {
  let _ = a
  let _ = b
  false
}

///| RFC 1928 §5 target/bind address (`ATYP=0x01`, `0x03`, `0x04`).
pub enum SocksAddr {
  Ipv4(Bytes)
  Ipv6(Bytes)
  Domain(String)
}

///|
pub fn socks_addr_eq(a : SocksAddr, b : SocksAddr) -> Bool {
  let _ = a
  let _ = b
  false
}

///| Client greeting message.
pub struct SocksGreeting {
  pub methods : Array[SocksAuthMethod]
}

///| RFC 1929 username/password authentication request.
pub val struct SocksUserPassRequest {
  pub username : String
  pub password : String
}

///| RFC 1928 §4 client request.
pub struct SocksRequest {
  pub command : SocksCommand
  pub addr : SocksAddr
  pub port : Int
}

///| RFC 1928 §6 server reply.
pub struct SocksReply {
  pub reply : SocksReplyCode
  pub bind_addr : SocksAddr
  pub bind_port : Int
}

///|
pub fn socks5_encode_greeting(
  methods : Array[SocksAuthMethod],
) -> Result[Bytes, ProxyError] {
  let _ = methods
  Err(ProxyError::InvalidProtocolVersion(0))
}

///|
pub fn socks5_decode_greeting(
  buf : Bytes,
) -> Result[DecodeStatus[SocksGreeting], ProxyError] {
  let _ = buf
  Err(ProxyError::InvalidProtocolVersion(0))
}

///|
pub fn socks5_encode_method_selection(method : SocksAuthMethod) -> Bytes {
  let _ = method
  Bytes::new(0)
}

///|
pub fn socks5_decode_method_selection(
  buf : Bytes,
) -> Result[DecodeStatus[SocksAuthMethod], ProxyError] {
  let _ = buf
  Err(ProxyError::InvalidProtocolVersion(0))
}

///|
pub fn socks5_encode_userpass_request(
  username : String,
  password : String,
) -> Result[Bytes, ProxyError] {
  let _ = username
  let _ = password
  Err(ProxyError::InvalidCredentials("unimplemented"))
}

///|
pub fn socks5_decode_userpass_request(
  buf : Bytes,
) -> Result[DecodeStatus[SocksUserPassRequest], ProxyError] {
  let _ = buf
  Err(ProxyError::InvalidCredentials("unimplemented"))
}

///|
pub fn socks5_encode_userpass_response(accepted : Bool) -> Bytes {
  let _ = accepted
  Bytes::new(0)
}

///|
pub fn socks5_decode_userpass_response(
  buf : Bytes,
) -> Result[DecodeStatus[Bool], ProxyError] {
  let _ = buf
  Err(ProxyError::AuthRejected(1))
}

///|
pub fn socks5_encode_request(
  cmd : SocksCommand,
  addr : SocksAddr,
  port : Int,
) -> Result[Bytes, ProxyError] {
  let _ = cmd
  let _ = addr
  let _ = port
  Err(ProxyError::InvalidAddress("unimplemented"))
}

///|
pub fn socks5_decode_request(
  buf : Bytes,
) -> Result[DecodeStatus[SocksRequest], ProxyError] {
  let _ = buf
  Err(ProxyError::InvalidAddress("unimplemented"))
}

///|
pub fn socks5_encode_reply(
  reply : SocksReplyCode,
  bind_addr : SocksAddr,
  bind_port : Int,
) -> Result[Bytes, ProxyError] {
  let _ = reply
  let _ = bind_addr
  let _ = bind_port
  Err(ProxyError::InvalidAddress("unimplemented"))
}

///|
pub fn socks5_decode_reply(
  buf : Bytes,
) -> Result[DecodeStatus[SocksReply], ProxyError] {
  let _ = buf
  Err(ProxyError::InvalidAddress("unimplemented"))
}
