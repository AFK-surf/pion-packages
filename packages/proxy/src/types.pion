///| Core types, limits, errors, and zero-dependency helpers for the Sans-IO `proxy` package.

///| Streaming decode result carrying the exact consumed byte count or minimum bytes needed.
pub enum DecodeStatus[T] {
  Complete(T, Int)
  NeedMore(Int)
}

///| Proxy authentication credentials.
pub val struct ProxyAuth {
  pub username : String
  pub password : String
}

///|
pub fn ProxyAuth::new(username : String, password : String) -> ProxyAuth {
  ProxyAuth::{ username: username, password: password }
}

///| HTTP header name/value pair.
pub val struct HttpHeader {
  pub name : String
  pub value : String
}

///|
pub fn HttpHeader::new(name : String, value : String) -> HttpHeader {
  HttpHeader::{ name: name, value: value }
}

///| Resource limits protecting HTTP CONNECT and forward-proxy parsers against DoS.
pub val struct ProxyLimits {
  pub max_header_bytes : Int
  pub max_headers : Int
  pub max_line_bytes : Int
}

///|
pub fn ProxyLimits::default() -> ProxyLimits {
  ProxyLimits::{ max_header_bytes: 65536, max_headers: 100, max_line_bytes: 8192 }
}

///| RFC 1928 §6 SOCKS5 reply codes.
pub enum SocksReplyCode {
  Succeeded
  GeneralFailure
  ConnectionNotAllowed
  NetworkUnreachable
  HostUnreachable
  ConnectionRefused
  TtlExpired
  CommandNotSupported
  AddressTypeNotSupported
  Unassigned(Int)
}

///|
pub fn SocksReplyCode::to_byte(self : SocksReplyCode) -> Byte {
  match self {
    SocksReplyCode::Succeeded => (0x00).to_byte()
    SocksReplyCode::GeneralFailure => (0x01).to_byte()
    SocksReplyCode::ConnectionNotAllowed => (0x02).to_byte()
    SocksReplyCode::NetworkUnreachable => (0x03).to_byte()
    SocksReplyCode::HostUnreachable => (0x04).to_byte()
    SocksReplyCode::ConnectionRefused => (0x05).to_byte()
    SocksReplyCode::TtlExpired => (0x06).to_byte()
    SocksReplyCode::CommandNotSupported => (0x07).to_byte()
    SocksReplyCode::AddressTypeNotSupported => (0x08).to_byte()
    SocksReplyCode::Unassigned(v) => v.to_byte()
  }
}

///|
pub fn socks_reply_code_from_byte(b : Byte) -> SocksReplyCode {
  let v = b.to_int()
  if v == 0x00 {
    SocksReplyCode::Succeeded
  } else if v == 0x01 {
    SocksReplyCode::GeneralFailure
  } else if v == 0x02 {
    SocksReplyCode::ConnectionNotAllowed
  } else if v == 0x03 {
    SocksReplyCode::NetworkUnreachable
  } else if v == 0x04 {
    SocksReplyCode::HostUnreachable
  } else if v == 0x05 {
    SocksReplyCode::ConnectionRefused
  } else if v == 0x06 {
    SocksReplyCode::TtlExpired
  } else if v == 0x07 {
    SocksReplyCode::CommandNotSupported
  } else if v == 0x08 {
    SocksReplyCode::AddressTypeNotSupported
  } else {
    SocksReplyCode::Unassigned(v)
  }
}

///|
pub fn socks_reply_code_eq(a : SocksReplyCode, b : SocksReplyCode) -> Bool {
  a.to_byte() == b.to_byte()
}

///| Structured error enum for proxy URL, NO_PROXY, SOCKS5, and HTTP proxy codecs.
pub enum ProxyError {
  InvalidUrl(String)
  UnsupportedScheme(String)
  InvalidHost(String)
  InvalidPort(String)
  InvalidCredentials(String)
  InvalidNoProxyRule(String)
  InvalidProtocolVersion(Int)
  NoAcceptableAuthMethods
  AuthRejected(Int)
  InvalidSocksCommand(Int)
  InvalidAddressType(Int)
  InvalidAddress(String)
  InvalidSocksReply(Int)
  SocksFailure(SocksReplyCode)
  CrlfInjection(String)
  InvalidHttpSyntax(String)
  InvalidHeader(String)
  SmugglingDetected(String)
  LimitExceeded(String)
  ProxyAuthRequired(String)
  HttpConnectFailed(Int, String)
}

///| Human-readable error message (guaranteed never to echo raw credentials).
pub fn ProxyError::message(self : ProxyError) -> String {
  match self {
    ProxyError::InvalidUrl(m) => "invalid proxy URL: " + m
    ProxyError::UnsupportedScheme(s) => "unsupported proxy scheme: " + s
    ProxyError::InvalidHost(m) => "invalid proxy host: " + m
    ProxyError::InvalidPort(m) => "invalid proxy port: " + m
    ProxyError::InvalidCredentials(m) => "invalid proxy credentials: " + m
    ProxyError::InvalidNoProxyRule(m) => "invalid NO_PROXY rule: " + m
    ProxyError::InvalidProtocolVersion(v) =>
    "invalid SOCKS protocol version: " + v.to_string()
    ProxyError::NoAcceptableAuthMethods =>
    "no acceptable SOCKS5 authentication methods"
    ProxyError::AuthRejected(code) =>
    "SOCKS5 authentication rejected: status=" + code.to_string()
    ProxyError::InvalidSocksCommand(c) =>
    "invalid SOCKS5 command: " + c.to_string()
    ProxyError::InvalidAddressType(t) =>
    "invalid SOCKS5 address type: " + t.to_string()
    ProxyError::InvalidAddress(m) => "invalid SOCKS5 address: " + m
    ProxyError::InvalidSocksReply(r) => "invalid SOCKS5 reply: " + r.to_string()
    ProxyError::SocksFailure(code) =>
    "SOCKS5 request failed: code=" + code.to_byte().to_int().to_string()
    ProxyError::CrlfInjection(m) => "CRLF/NUL injection rejected: " + m
    ProxyError::InvalidHttpSyntax(m) => "invalid HTTP proxy syntax: " + m
    ProxyError::InvalidHeader(m) => "invalid HTTP header: " + m
    ProxyError::SmugglingDetected(m) => "HTTP request smuggling rejected: " + m
    ProxyError::LimitExceeded(m) => "proxy parser limit exceeded: " + m
    ProxyError::ProxyAuthRequired(m) => "proxy authentication required: " + m
    ProxyError::HttpConnectFailed(code, reason) =>
    "HTTP CONNECT failed: " + code.to_string() + " " + reason
  }
}

///| Internal: byte equality.
fn internal_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII lowercase for a single code unit.
fn ascii_lower_cu(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| Internal: ASCII case-insensitive equality between two strings.
fn str_eq_ascii_ci(a : String, b : String) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if ascii_lower_cu(a.code_unit_at(i)) != ascii_lower_cu(b.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII case-insensitive equality between a string and a lowercase literal.
fn str_eq_lower_lit(a : String, lower_lit : String) -> Bool {
  if a.length() != lower_lit.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if ascii_lower_cu(a.code_unit_at(i)) != lower_lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII lowercase copy of a string.
fn ascii_to_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let mut out = Bytes::new(n)
  let b = s.to_bytes()
  let bn = b.length()
  if bn != n {
    let mut out2 = Bytes::new(bn)
    let mut j = 0
    while j < bn {
      let v = b[j].to_int()
      if v >= 65 && v <= 90 {
        out2[j] = (v + 32).to_byte()
      } else {
        out2[j] = b[j]
      }
      j = j + 1
    }
    return out2.to_string()
  }
  let mut k = 0
  while k < n {
    let v = b[k].to_int()
    if v >= 65 && v <= 90 {
      out[k] = (v + 32).to_byte()
    } else {
      out[k] = b[k]
    }
    k = k + 1
  }
  out.to_string()
}

///| Internal: substring by byte/ASCII code unit range (valid for ASCII slices).
fn str_slice_ascii(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let b = s.to_bytes()
  b.slice(start, end).to_string()
}

///| Internal: trim ASCII whitespace (SP, HTAB, CR, LF) from both ends.
fn trim_ascii_ws(s : String) -> String {
  let b = s.to_bytes()
  let mut start = 0
  let mut end = b.length()
  while start < end {
    let c = b[start].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      start = start + 1
    } else {
      break
    }
  }
  while end > start {
    let c = b[end - 1].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      end = end - 1
    } else {
      break
    }
  }
  if start == 0 && end == b.length() {
    s
  } else {
    b.slice(start, end).to_string()
  }
}

///| Internal: check for CR, LF, or NUL in a string.
fn has_crlf_or_nul(s : String) -> Bool {
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal: check RFC 9110 tchar byte.
fn is_http_tchar(c : Int) -> Bool {
  if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
    return true
  }
  c == 33 ||
  c == 35 ||
  c == 36 ||
  c == 37 ||
  c == 38 ||
  c == 39 ||
  c == 42 ||
  c == 43 ||
  c == 45 ||
  c == 46 ||
  c == 94 ||
  c == 95 ||
  c == 96 ||
  c == 124 ||
  c == 126
}

///| Internal: hex digit value or -1.
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

///| Internal: percent-decode a string, rejecting malformed `%` sequences.
fn percent_decode(s : String) -> Option[String] {
  let b = s.to_bytes()
  let n = b.length()
  let mut has_pct = false
  let mut i = 0
  while i < n {
    if b[i].to_int() == 37 {
      has_pct = true
      break
    }
    i = i + 1
  }
  if !has_pct {
    return Some(s)
  }
  let mut out = Bytes::new(n)
  let mut out_len = 0
  let mut pos = 0
  while pos < n {
    let c = b[pos].to_int()
    if c == 37 {
      if pos + 2 >= n {
        return None
      }
      let hi = hex_val(b[pos + 1].to_int())
      let lo = hex_val(b[pos + 2].to_int())
      if hi < 0 || lo < 0 {
        return None
      }
      out[out_len] = ((hi * 16) + lo).to_byte()
      out_len = out_len + 1
      pos = pos + 3
    } else {
      out[out_len] = b[pos]
      out_len = out_len + 1
      pos = pos + 1
    }
  }
  Some(out.slice(0, out_len).to_string())
}

///| Internal: parse strict decimal port in 1..=65535.
fn parse_port_strict(s : String) -> Option[Int] {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 || n > 5 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc <= 0 || acc > 65535 {
    return None
  }
  Some(acc)
}

///| Internal: parse strict non-negative Int64 decimal digits.
fn parse_u64_strict(s : String) -> Option[Int64] {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 || n > 19 {
    return None
  }
  let mut acc = 0L
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return None
    }
    let digit = (c - 48).to_int64()
    if acc > (9223372036854775807L - digit) / 10L {
      return None
    }
    acc = acc * 10L + digit
    i = i + 1
  }
  Some(acc)
}

///| Internal: parse strict IPv4 dotted-quad into 4 bytes.
fn parse_ipv4_octets(s : String) -> Option[Bytes] {
  let b = s.to_bytes()
  let n = b.length()
  if n < 7 || n > 15 {
    return None
  }
  let mut out = Bytes::new(4)
  let mut part = 0
  let mut i = 0
  while part < 4 {
    if i >= n {
      return None
    }
    let start = i
    let mut acc = 0
    while i < n && b[i].to_int() != 46 {
      let c = b[i].to_int()
      if c < 48 || c > 57 {
        return None
      }
      acc = acc * 10 + (c - 48)
      if acc > 255 {
        return None
      }
      i = i + 1
    }
    let digits = i - start
    if digits == 0 || digits > 3 {
      return None
    }
    if digits > 1 && b[start].to_int() == 48 {
      return None
    }
    out[part] = acc.to_byte()
    part = part + 1
    if part < 4 {
      if i >= n || b[i].to_int() != 46 {
        return None
      }
      i = i + 1
    }
  }
  if i != n {
    return None
  }
  Some(out)
}

///| Internal: parse strict IPv6 literal (without brackets) into 16 bytes.
fn parse_ipv6_octets(s : String) -> Option[Bytes] {
  let b = s.to_bytes()
  let n = b.length()
  if n < 2 || n > 45 {
    return None
  }
  let left : Array[Int] = []
  let right : Array[Int] = []
  let mut seen_compress = false
  let mut i = 0
  if b[0].to_int() == 58 {
    if b[1].to_int() != 58 {
      return None
    }
    seen_compress = true
    i = 2
    if i == n {
      return Some(Bytes::new(16))
    }
  }
  while i < n {
    let start = i
    let mut has_dot = false
    let mut acc = 0
    let mut digits = 0
    while i < n {
      let c = b[i].to_int()
      if c == 58 {
        break
      }
      if c == 46 {
        has_dot = true
        break
      }
      let hv = hex_val(c)
      if hv < 0 {
        return None
      }
      acc = (acc * 16) + hv
      digits = digits + 1
      if digits > 4 {
        return None
      }
      i = i + 1
    }
    if has_dot {
      // Embedded IPv4 tail at start..n
      match parse_ipv4_octets(b.slice(start, n).to_string()) {
        Some(v4) => {
          let g1 = v4[0].to_int() * 256 + v4[1].to_int()
          let g2 = v4[2].to_int() * 256 + v4[3].to_int()
          if seen_compress {
            right.push(g1)
            right.push(g2)
          } else {
            left.push(g1)
            left.push(g2)
          }
          i = n
          break
        }
        None => return None
      }
    }
    if digits == 0 {
      return None
    }
    if seen_compress {
      right.push(acc)
    } else {
      left.push(acc)
    }
    if i == n {
      break
    }
    // b[i] == ':'
    i = i + 1
    if i == n {
      return None
    }
    if b[i].to_int() == 58 {
      if seen_compress {
        return None
      }
      seen_compress = true
      i = i + 1
      if i == n {
        break
      }
    }
  }
  let total = left.length() + right.length()
  if seen_compress {
    if total >= 8 {
      return None
    }
  } else if total != 8 {
    return None
  }
  let zeros = 8 - total
  let mut out = Bytes::new(16)
  let mut pos = 0
  let mut li = 0
  while li < left.length() {
    let g = left[li]
    out[pos] = ((g >> 8) & 0xFF).to_byte()
    out[pos + 1] = (g & 0xFF).to_byte()
    pos = pos + 2
    li = li + 1
  }
  pos = pos + zeros * 2
  let mut ri = 0
  while ri < right.length() {
    let g = right[ri]
    out[pos] = ((g >> 8) & 0xFF).to_byte()
    out[pos + 1] = (g & 0xFF).to_byte()
    pos = pos + 2
    ri = ri + 1
  }
  Some(out)
}

///| Internal: standard RFC 4648 Base64 alphabet byte for 6-bit value 0..63.
fn b64_enc_char(v : Int) -> Byte {
  if v < 26 {
    (65 + v).to_byte()
  } else if v < 52 {
    (97 + (v - 26)).to_byte()
  } else if v < 62 {
    (48 + (v - 52)).to_byte()
  } else if v == 62 {
    (43).to_byte()
  } else {
    (47).to_byte()
  }
}

///| Internal: decode single Base64 character to 0..63, or -1 if invalid.
fn b64_dec_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

///| Internal: Base64-encode bytes (RFC 4648 with `=` padding).
fn base64_encode(data : Bytes) -> String {
  let n = data.length()
  if n == 0 {
    return ""
  }
  let out_len = ((n + 2) / 3) * 4
  let mut out = Bytes::new(out_len)
  let mut i = 0
  let mut j = 0
  while i + 3 <= n {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    let triple = (b0 << 16) | (b1 << 8) | b2
    out[j] = b64_enc_char((triple >> 18) & 0x3F)
    out[j + 1] = b64_enc_char((triple >> 12) & 0x3F)
    out[j + 2] = b64_enc_char((triple >> 6) & 0x3F)
    out[j + 3] = b64_enc_char(triple & 0x3F)
    i = i + 3
    j = j + 4
  }
  let rem = n - i
  if rem == 1 {
    let b0 = data[i].to_int()
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char((b0 << 4) & 0x3F)
    out[j + 2] = (61).to_byte()
    out[j + 3] = (61).to_byte()
  } else if rem == 2 {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char(((b0 << 4) | (b1 >> 4)) & 0x3F)
    out[j + 2] = b64_enc_char((b1 << 2) & 0x3F)
    out[j + 3] = (61).to_byte()
  }
  out.to_string()
}

///| Internal: Base64-decode standard padded string.
fn base64_decode(s : String) -> Option[Bytes] {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 {
    return Some(Bytes::new(0))
  }
  if n % 4 != 0 {
    return None
  }
  let mut pad = 0
  if b[n - 1].to_int() == 61 {
    pad = pad + 1
  }
  if b[n - 2].to_int() == 61 {
    pad = pad + 1
  }
  let out_len = (n / 4) * 3 - pad
  let mut out = Bytes::new(out_len)
  let mut i = 0
  let mut j = 0
  while i < n {
    let c0 = b[i].to_int()
    let c1 = b[i + 1].to_int()
    let c2 = b[i + 2].to_int()
    let c3 = b[i + 3].to_int()
    let v0 = b64_dec_val(c0)
    let v1 = b64_dec_val(c1)
    if v0 < 0 || v1 < 0 {
      return None
    }
    let last_quad = i + 4 == n
    if c2 == 61 {
      if !last_quad || c3 != 61 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      j = j + 1
    } else if c3 == 61 {
      if !last_quad {
        return None
      }
      let v2 = b64_dec_val(c2)
      if v2 < 0 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[j + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      j = j + 2
    } else {
      let v2 = b64_dec_val(c2)
      let v3 = b64_dec_val(c3)
      if v2 < 0 || v3 < 0 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[j + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      out[j + 2] = (((v2 & 0x03) << 6) | v3).to_byte()
      j = j + 3
    }
    i = i + 4
  }
  Some(out)
}
