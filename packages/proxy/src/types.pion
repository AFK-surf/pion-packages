///| Core types, limits, errors, and zero-dependency helpers for the Sans-IO `proxy` package.

///| Streaming decode result carrying the exact consumed byte count or minimum bytes needed.
pub enum DecodeStatus[T] {
  Complete(T, Int)
  NeedMore(Int)
}

///| Proxy authentication credentials.
pub val struct ProxyAuth {
  pub username : String
  pub password : String
}

///|
pub fn ProxyAuth::new(username : String, password : String) -> ProxyAuth {
  ProxyAuth::{ username: username, password: password }
}

///| HTTP header name/value pair.
pub val struct HttpHeader {
  pub name : String
  pub value : String
}

///|
pub fn HttpHeader::new(name : String, value : String) -> HttpHeader {
  HttpHeader::{ name: name, value: value }
}

///| Resource limits protecting HTTP CONNECT and forward-proxy parsers against DoS.
pub val struct ProxyLimits {
  pub max_header_bytes : Int
  pub max_headers : Int
  pub max_line_bytes : Int
}

///|
pub fn ProxyLimits::default() -> ProxyLimits {
  ProxyLimits::{ max_header_bytes: 65536, max_headers: 100, max_line_bytes: 8192 }
}

///| RFC 1928 §6 SOCKS5 reply codes.
pub enum SocksReplyCode {
  Succeeded
  GeneralFailure
  ConnectionNotAllowed
  NetworkUnreachable
  HostUnreachable
  ConnectionRefused
  TtlExpired
  CommandNotSupported
  AddressTypeNotSupported
  Unassigned(Int)
}

///|
pub fn SocksReplyCode::to_byte(self : SocksReplyCode) -> Byte {
  match self {
    SocksReplyCode::Succeeded => (0x00).to_byte()
    SocksReplyCode::GeneralFailure => (0x01).to_byte()
    SocksReplyCode::ConnectionNotAllowed => (0x02).to_byte()
    SocksReplyCode::NetworkUnreachable => (0x03).to_byte()
    SocksReplyCode::HostUnreachable => (0x04).to_byte()
    SocksReplyCode::ConnectionRefused => (0x05).to_byte()
    SocksReplyCode::TtlExpired => (0x06).to_byte()
    SocksReplyCode::CommandNotSupported => (0x07).to_byte()
    SocksReplyCode::AddressTypeNotSupported => (0x08).to_byte()
    SocksReplyCode::Unassigned(v) => v.to_byte()
  }
}

///|
pub fn socks_reply_code_from_byte(b : Byte) -> SocksReplyCode {
  let v = b.to_int()
  if v == 0x00 {
    SocksReplyCode::Succeeded
  } else if v == 0x01 {
    SocksReplyCode::GeneralFailure
  } else if v == 0x02 {
    SocksReplyCode::ConnectionNotAllowed
  } else if v == 0x03 {
    SocksReplyCode::NetworkUnreachable
  } else if v == 0x04 {
    SocksReplyCode::HostUnreachable
  } else if v == 0x05 {
    SocksReplyCode::ConnectionRefused
  } else if v == 0x06 {
    SocksReplyCode::TtlExpired
  } else if v == 0x07 {
    SocksReplyCode::CommandNotSupported
  } else if v == 0x08 {
    SocksReplyCode::AddressTypeNotSupported
  } else {
    SocksReplyCode::Unassigned(v)
  }
}

///|
pub fn socks_reply_code_eq(a : SocksReplyCode, b : SocksReplyCode) -> Bool {
  a.to_byte() == b.to_byte()
}

///| Structured error enum for proxy URL, NO_PROXY, SOCKS5, and HTTP proxy codecs.
pub enum ProxyError {
  InvalidUrl(String)
  UnsupportedScheme(String)
  InvalidHost(String)
  InvalidPort(String)
  InvalidCredentials(String)
  InvalidNoProxyRule(String)
  InvalidProtocolVersion(Int)
  NoAcceptableAuthMethods
  AuthRejected(Int)
  InvalidSocksCommand(Int)
  InvalidAddressType(Int)
  InvalidAddress(String)
  InvalidSocksReply(Int)
  SocksFailure(SocksReplyCode)
  CrlfInjection(String)
  InvalidHttpSyntax(String)
  InvalidHeader(String)
  SmugglingDetected(String)
  LimitExceeded(String)
  ProxyAuthRequired(String)
  HttpConnectFailed(Int, String)
}

///| Human-readable error message (guaranteed never to echo raw credentials).
pub fn ProxyError::message(self : ProxyError) -> String {
  match self {
    ProxyError::InvalidUrl(m) => "invalid proxy URL: " + m
    ProxyError::UnsupportedScheme(s) => "unsupported proxy scheme: " + s
    ProxyError::InvalidHost(m) => "invalid proxy host: " + m
    ProxyError::InvalidPort(m) => "invalid proxy port: " + m
    ProxyError::InvalidCredentials(m) => "invalid proxy credentials: " + m
    ProxyError::InvalidNoProxyRule(m) => "invalid NO_PROXY rule: " + m
    ProxyError::InvalidProtocolVersion(v) =>
    "invalid SOCKS protocol version: " + v.to_string()
    ProxyError::NoAcceptableAuthMethods =>
    "no acceptable SOCKS5 authentication methods"
    ProxyError::AuthRejected(code) =>
    "SOCKS5 authentication rejected: status=" + code.to_string()
    ProxyError::InvalidSocksCommand(c) =>
    "invalid SOCKS5 command: " + c.to_string()
    ProxyError::InvalidAddressType(t) =>
    "invalid SOCKS5 address type: " + t.to_string()
    ProxyError::InvalidAddress(m) => "invalid SOCKS5 address: " + m
    ProxyError::InvalidSocksReply(r) => "invalid SOCKS5 reply: " + r.to_string()
    ProxyError::SocksFailure(code) =>
    "SOCKS5 request failed: code=" + code.to_byte().to_int().to_string()
    ProxyError::CrlfInjection(m) => "CRLF/NUL injection rejected: " + m
    ProxyError::InvalidHttpSyntax(m) => "invalid HTTP proxy syntax: " + m
    ProxyError::InvalidHeader(m) => "invalid HTTP header: " + m
    ProxyError::SmugglingDetected(m) => "HTTP request smuggling rejected: " + m
    ProxyError::LimitExceeded(m) => "proxy parser limit exceeded: " + m
    ProxyError::ProxyAuthRequired(m) => "proxy authentication required: " + m
    ProxyError::HttpConnectFailed(code, reason) =>
    "HTTP CONNECT failed: " + code.to_string() + " " + reason
  }
}

///| Internal: byte equality.
fn internal_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII lowercase for a single code unit / byte.
fn ascii_lower_cu(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| Internal: ASCII case-insensitive equality between a string and a lowercase literal.
fn str_eq_lower_lit(a : String, lower_lit : String) -> Bool {
  let n = lower_lit.length()
  if a.length() != n {
    return false
  }
  let mut i = 0
  while i < n {
    let c = a.code_unit_at(i)
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != lower_lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII case-insensitive equality between `s[start..end]` and a lowercase literal.
fn str_eq_lower_lit_range(
  s : String,
  start : Int,
  end : Int,
  lower_lit : String,
) -> Bool {
  let n = end - start
  if n != lower_lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(start + i)
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != lower_lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII case-insensitive equality between `b[start..end]` and a lowercase literal.
fn bytes_eq_lower_lit(
  b : Bytes,
  start : Int,
  end : Int,
  lower_lit : String,
) -> Bool {
  let n = end - start
  if n != lower_lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let c = b[start + i].to_int()
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != lower_lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: exact equality between `b[start..end]` and an ASCII literal.
fn bytes_eq_lit(b : Bytes, start : Int, end : Int, lit : String) -> Bool {
  let n = end - start
  if n != lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if b[start + i].to_int() != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Internal: ASCII lowercase copy of a string (zero-alloc if already lowercase).
fn ascii_to_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut has_non_ascii = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
    } else if c >= 128 {
      has_non_ascii = true
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  if !has_non_ascii {
    let mut out = Bytes::new(n)
    let mut k = 0
    while k < n {
      let v = s.code_unit_at(k)
      if v >= 65 && v <= 90 {
        out[k] = (v + 32).to_byte()
      } else {
        out[k] = v.to_byte()
      }
      k = k + 1
    }
    return out.to_string()
  }
  let b = s.to_bytes()
  let bn = b.length()
  let mut out2 = Bytes::new(bn)
  let mut j = 0
  while j < bn {
    let v = b[j].to_int()
    if v >= 65 && v <= 90 {
      out2[j] = (v + 32).to_byte()
    } else {
      out2[j] = b[j]
    }
    j = j + 1
  }
  out2.to_string()
}

///| Internal: slice `s[start..end]` and ASCII-lowercase only if needed.
fn str_slice_ascii_lower(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let mut has_upper = false
  let mut has_non_ascii = false
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
    } else if c >= 128 {
      has_non_ascii = true
    }
    i = i + 1
  }
  if !has_upper {
    return s.slice(start, end)
  }
  if !has_non_ascii {
    let len = end - start
    let mut out = Bytes::new(len)
    let mut k = 0
    while k < len {
      let v = s.code_unit_at(start + k)
      if v >= 65 && v <= 90 {
        out[k] = (v + 32).to_byte()
      } else {
        out[k] = v.to_byte()
      }
      k = k + 1
    }
    return out.to_string()
  }
  ascii_to_lower(s.slice(start, end))
}

///| Internal: slice `b[start..end]` to String and ASCII-lowercase only if needed.
fn bytes_slice_ascii_lower(b : Bytes, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let mut has_upper = false
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return b.slice(start, end).to_string()
  }
  let len = end - start
  let mut out = Bytes::new(len)
  let mut k = 0
  while k < len {
    let v = b[start + k].to_int()
    if v >= 65 && v <= 90 {
      out[k] = (v + 32).to_byte()
    } else {
      out[k] = b[start + k]
    }
    k = k + 1
  }
  out.to_string()
}

///| Internal: substring by code unit range.
fn str_slice_ascii(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  s.slice(start, end)
}

///| Internal: trim ASCII whitespace (SP, HTAB, CR, LF) from both ends without copying when already trimmed.
fn trim_ascii_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  let mut end = n
  while start < end {
    let c = s.code_unit_at(start)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      start = start + 1
    } else {
      break
    }
  }
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      end = end - 1
    } else {
      break
    }
  }
  if start == 0 && end == n {
    s
  } else if start >= end {
    ""
  } else {
    s.slice(start, end)
  }
}

///| Internal: check for CR, LF, or NUL in a string (zero allocation).
fn has_crlf_or_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal: check RFC 9110 tchar byte (hot path ordered for common HTTP header names).
fn is_http_tchar(c : Int) -> Bool {
  if (c >= 97 && c <= 122) ||
  (c >= 65 && c <= 90) ||
  c == 45 ||
  (c >= 48 && c <= 57) {
    return true
  }
  c == 33 ||
  c == 35 ||
  c == 36 ||
  c == 37 ||
  c == 38 ||
  c == 39 ||
  c == 42 ||
  c == 43 ||
  c == 46 ||
  c == 94 ||
  c == 95 ||
  c == 96 ||
  c == 124 ||
  c == 126
}

///| Internal: hex digit value or -1.
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///| Internal: percent-decode `s[start..end]`, rejecting malformed `%` sequences.
///| Zero extra allocation when no `%` is present.
fn percent_decode_range(s : String, start : Int, end : Int) -> Option[String] {
  let mut has_pct = false
  let mut has_non_ascii = false
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 37 {
      has_pct = true
    } else if c >= 128 {
      has_non_ascii = true
    }
    i = i + 1
  }
  if !has_pct {
    if start >= end {
      return Some("")
    }
    return Some(s.slice(start, end))
  }
  if !has_non_ascii {
    let sb = StringBuilder::with_capacity(end - start)
    let mut pos = start
    while pos < end {
      let c = s.code_unit_at(pos)
      if c == 37 {
        if pos + 2 >= end {
          return None
        }
        let hi = hex_val(s.code_unit_at(pos + 1))
        let lo = hex_val(s.code_unit_at(pos + 2))
        if hi < 0 || lo < 0 {
          return None
        }
        sb.write_byte(((hi << 4) | lo).to_byte())
        pos = pos + 3
      } else {
        sb.write_byte(c.to_byte())
        pos = pos + 1
      }
    }
    return Some(sb.to_string())
  }
  let b = s.slice(start, end).to_bytes()
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut pos = 0
  while pos < n {
    let c = b[pos].to_int()
    if c == 37 {
      if pos + 2 >= n {
        return None
      }
      let hi = hex_val(b[pos + 1].to_int())
      let lo = hex_val(b[pos + 2].to_int())
      if hi < 0 || lo < 0 {
        return None
      }
      sb.write_byte(((hi << 4) | lo).to_byte())
      pos = pos + 3
    } else {
      sb.write_byte(b[pos])
      pos = pos + 1
    }
  }
  Some(sb.to_string())
}

///| Internal: parse strict decimal port in 1..=65535 from `s[start..end]`.
fn parse_port_range(s : String, start : Int, end : Int) -> Option[Int] {
  let n = end - start
  if n <= 0 || n > 5 {
    return None
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc <= 0 || acc > 65535 {
    return None
  }
  Some(acc)
}

///| Internal: parse strict decimal port in 1..=65535 from `b[start..end]`.
fn parse_port_bytes(b : Bytes, start : Int, end : Int) -> Option[Int] {
  let n = end - start
  if n <= 0 || n > 5 {
    return None
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc <= 0 || acc > 65535 {
    return None
  }
  Some(acc)
}

///| Internal: parse strict non-negative Int64 decimal digits from `b[start..end]`.
fn parse_u64_bytes(b : Bytes, start : Int, end : Int) -> Option[Int64] {
  let n = end - start
  if n <= 0 || n > 19 {
    return None
  }
  let mut acc = 0L
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return None
    }
    let digit = (c - 48).to_int64()
    if acc > (9223372036854775807L - digit) / 10L {
      return None
    }
    acc = acc * 10L + digit
    i = i + 1
  }
  Some(acc)
}

///| Internal: parse strict IPv4 dotted-quad from `s[start..end]` into packed 32-bit unsigned Int64, or -1L.
fn parse_ipv4_u32_range(s : String, start : Int, end : Int) -> Int64 {
  let n = end - start
  if n < 7 || n > 15 {
    return -1L
  }
  let mut out = 0L
  let mut part = 0
  let mut i = start
  while part < 4 {
    if i >= end {
      return -1L
    }
    let pstart = i
    let mut acc = 0
    while i < end {
      let c = s.code_unit_at(i)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        return -1L
      }
      acc = acc * 10 + (c - 48)
      if acc > 255 {
        return -1L
      }
      i = i + 1
    }
    let digits = i - pstart
    if digits == 0 || digits > 3 {
      return -1L
    }
    if digits > 1 && s.code_unit_at(pstart) == 48 {
      return -1L
    }
    out = (out << 8) | acc.to_int64()
    part = part + 1
    if part < 4 {
      if i >= end || s.code_unit_at(i) != 46 {
        return -1L
      }
      i = i + 1
    }
  }
  if i != end {
    return -1L
  }
  out
}

///| Internal: parse strict IPv4 dotted-quad from `b[start..end]` into packed 32-bit unsigned Int64, or -1L.
fn parse_ipv4_u32_bytes(b : Bytes, start : Int, end : Int) -> Int64 {
  let n = end - start
  if n < 7 || n > 15 {
    return -1L
  }
  let mut out = 0L
  let mut part = 0
  let mut i = start
  while part < 4 {
    if i >= end {
      return -1L
    }
    let pstart = i
    let mut acc = 0
    while i < end {
      let c = b[i].to_int()
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        return -1L
      }
      acc = acc * 10 + (c - 48)
      if acc > 255 {
        return -1L
      }
      i = i + 1
    }
    let digits = i - pstart
    if digits == 0 || digits > 3 {
      return -1L
    }
    if digits > 1 && b[pstart].to_int() == 48 {
      return -1L
    }
    out = (out << 8) | acc.to_int64()
    part = part + 1
    if part < 4 {
      if i >= end || b[i].to_int() != 46 {
        return -1L
      }
      i = i + 1
    }
  }
  if i != end {
    return -1L
  }
  out
}

///| Internal: convert packed IPv4 u32 Int64 into 4 Bytes.
fn ipv4_u32_to_bytes(v : Int64) -> Bytes {
  let mut out = Bytes::new(4)
  out[0] = ((v >> 24) & 0xFFL).to_int().to_byte()
  out[1] = ((v >> 16) & 0xFFL).to_int().to_byte()
  out[2] = ((v >> 8) & 0xFFL).to_int().to_byte()
  out[3] = (v & 0xFFL).to_int().to_byte()
  out
}

///| Internal: zero-allocation strict IPv6 literal validation on `s[start..end]`.
fn is_valid_ipv6_range(s : String, start : Int, end : Int) -> Bool {
  let n = end - start
  if n < 2 || n > 45 {
    return false
  }
  let mut groups = 0
  let mut seen_compress = false
  let mut i = start
  if s.code_unit_at(i) == 58 {
    if s.code_unit_at(i + 1) != 58 {
      return false
    }
    seen_compress = true
    i = i + 2
    if i == end {
      return true
    }
  }
  while i < end {
    let gstart = i
    let mut has_dot = false
    let mut digits = 0
    while i < end {
      let c = s.code_unit_at(i)
      if c == 58 {
        break
      }
      if c == 46 {
        has_dot = true
        break
      }
      if hex_val(c) < 0 {
        return false
      }
      digits = digits + 1
      if digits > 4 {
        return false
      }
      i = i + 1
    }
    if has_dot {
      if parse_ipv4_u32_range(s, gstart, end) < 0L {
        return false
      }
      groups = groups + 2
      break
    }
    if digits == 0 {
      return false
    }
    groups = groups + 1
    if groups > 8 {
      return false
    }
    if i == end {
      break
    }
    i = i + 1
    if i == end {
      return false
    }
    if s.code_unit_at(i) == 58 {
      if seen_compress {
        return false
      }
      seen_compress = true
      i = i + 1
      if i == end {
        break
      }
    }
  }
  if seen_compress {
    groups < 8
  } else {
    groups == 8
  }
}

///| Internal: zero-allocation strict IPv6 literal validation on `b[start..end]`.
fn is_valid_ipv6_bytes(b : Bytes, start : Int, end : Int) -> Bool {
  let n = end - start
  if n < 2 || n > 45 {
    return false
  }
  let mut groups = 0
  let mut seen_compress = false
  let mut i = start
  if b[i].to_int() == 58 {
    if b[i + 1].to_int() != 58 {
      return false
    }
    seen_compress = true
    i = i + 2
    if i == end {
      return true
    }
  }
  while i < end {
    let gstart = i
    let mut has_dot = false
    let mut digits = 0
    while i < end {
      let c = b[i].to_int()
      if c == 58 {
        break
      }
      if c == 46 {
        has_dot = true
        break
      }
      if hex_val(c) < 0 {
        return false
      }
      digits = digits + 1
      if digits > 4 {
        return false
      }
      i = i + 1
    }
    if has_dot {
      if parse_ipv4_u32_bytes(b, gstart, end) < 0L {
        return false
      }
      groups = groups + 2
      break
    }
    if digits == 0 {
      return false
    }
    groups = groups + 1
    if groups > 8 {
      return false
    }
    if i == end {
      break
    }
    i = i + 1
    if i == end {
      return false
    }
    if b[i].to_int() == 58 {
      if seen_compress {
        return false
      }
      seen_compress = true
      i = i + 1
      if i == end {
        break
      }
    }
  }
  if seen_compress {
    groups < 8
  } else {
    groups == 8
  }
}

///| Internal: parse strict IPv6 literal `s[start..end]` (without brackets) into 16 bytes.
fn parse_ipv6_octets_range(s : String, start : Int, end : Int) -> Option[Bytes] {
  let n = end - start
  if n < 2 || n > 45 {
    return None
  }
  let groups : FixedArray[Int] = FixedArray::make(8, 0)
  let mut left_len = 0
  let mut right_len = 0
  let mut seen_compress = false
  let mut i = start
  if s.code_unit_at(i) == 58 {
    if s.code_unit_at(i + 1) != 58 {
      return None
    }
    seen_compress = true
    i = i + 2
    if i == end {
      return Some(Bytes::new(16))
    }
  }
  while i < end {
    let gstart = i
    let mut has_dot = false
    let mut acc = 0
    let mut digits = 0
    while i < end {
      let c = s.code_unit_at(i)
      if c == 58 {
        break
      }
      if c == 46 {
        has_dot = true
        break
      }
      let hv = hex_val(c)
      if hv < 0 {
        return None
      }
      acc = (acc << 4) | hv
      digits = digits + 1
      if digits > 4 {
        return None
      }
      i = i + 1
    }
    if has_dot {
      let v4 = parse_ipv4_u32_range(s, gstart, end)
      if v4 < 0L {
        return None
      }
      let total = left_len + right_len
      if total + 2 > 8 {
        return None
      }
      let g1 = ((v4 >> 16) & 0xFFFFL).to_int()
      let g2 = (v4 & 0xFFFFL).to_int()
      if seen_compress {
        groups[left_len + right_len] = g1
        groups[left_len + right_len + 1] = g2
        right_len = right_len + 2
      } else {
        groups[left_len] = g1
        groups[left_len + 1] = g2
        left_len = left_len + 2
      }
      break
    }
    if digits == 0 {
      return None
    }
    let total = left_len + right_len
    if total >= 8 {
      return None
    }
    if seen_compress {
      groups[total] = acc
      right_len = right_len + 1
    } else {
      groups[left_len] = acc
      left_len = left_len + 1
    }
    if i == end {
      break
    }
    i = i + 1
    if i == end {
      return None
    }
    if s.code_unit_at(i) == 58 {
      if seen_compress {
        return None
      }
      seen_compress = true
      i = i + 1
      if i == end {
        break
      }
    }
  }
  let total = left_len + right_len
  if seen_compress {
    if total >= 8 {
      return None
    }
  } else if total != 8 {
    return None
  }
  let zeros = 8 - total
  let mut out = Bytes::new(16)
  let mut pos = 0
  let mut li = 0
  while li < left_len {
    let g = groups[li]
    out[pos] = ((g >> 8) & 0xFF).to_byte()
    out[pos + 1] = (g & 0xFF).to_byte()
    pos = pos + 2
    li = li + 1
  }
  pos = pos + zeros * 2
  let mut ri = 0
  while ri < right_len {
    let g = groups[left_len + ri]
    out[pos] = ((g >> 8) & 0xFF).to_byte()
    out[pos + 1] = (g & 0xFF).to_byte()
    pos = pos + 2
    ri = ri + 1
  }
  Some(out)
}

///| Internal: standard RFC 4648 Base64 alphabet byte for 6-bit value 0..63.
fn b64_enc_char(v : Int) -> Byte {
  if v < 26 {
    (65 + v).to_byte()
  } else if v < 52 {
    (97 + (v - 26)).to_byte()
  } else if v < 62 {
    (48 + (v - 52)).to_byte()
  } else if v == 62 {
    (43).to_byte()
  } else {
    (47).to_byte()
  }
}

///| Internal: decode single Base64 character to 0..63, or -1 if invalid.
fn b64_dec_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 71
  } else if c >= 48 && c <= 57 {
    c + 4
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

///| Internal: write Base64 encoding of `data` directly into `out` starting at `dst`, returning new pos.
fn base64_encode_into(out : Bytes, dst : Int, data : Bytes) -> Int {
  let n = data.length()
  let mut i = 0
  let mut j = dst
  while i + 3 <= n {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    let triple = (b0 << 16) | (b1 << 8) | b2
    out[j] = b64_enc_char((triple >> 18) & 0x3F)
    out[j + 1] = b64_enc_char((triple >> 12) & 0x3F)
    out[j + 2] = b64_enc_char((triple >> 6) & 0x3F)
    out[j + 3] = b64_enc_char(triple & 0x3F)
    i = i + 3
    j = j + 4
  }
  let rem = n - i
  if rem == 1 {
    let b0 = data[i].to_int()
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char((b0 << 4) & 0x3F)
    out[j + 2] = (61).to_byte()
    out[j + 3] = (61).to_byte()
    j = j + 4
  } else if rem == 2 {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char(((b0 << 4) | (b1 >> 4)) & 0x3F)
    out[j + 2] = b64_enc_char((b1 << 2) & 0x3F)
    out[j + 3] = (61).to_byte()
    j = j + 4
  }
  j
}

///| Internal: Base64-decode standard padded bytes `b[start..end]`.
fn base64_decode_bytes(b : Bytes, start : Int, end : Int) -> Option[Bytes] {
  let n = end - start
  if n == 0 {
    return Some(Bytes::new(0))
  }
  if (n & 3) != 0 {
    return None
  }
  let mut pad = 0
  if b[end - 1].to_int() == 61 {
    pad = pad + 1
  }
  if b[end - 2].to_int() == 61 {
    pad = pad + 1
  }
  let out_len = (n >> 2) * 3 - pad
  let mut out = Bytes::new(out_len)
  let mut i = start
  let mut j = 0
  while i < end {
    let c0 = b[i].to_int()
    let c1 = b[i + 1].to_int()
    let c2 = b[i + 2].to_int()
    let c3 = b[i + 3].to_int()
    let v0 = b64_dec_val(c0)
    let v1 = b64_dec_val(c1)
    if v0 < 0 || v1 < 0 {
      return None
    }
    let last_quad = i + 4 == end
    if c2 == 61 {
      if !last_quad || c3 != 61 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      j = j + 1
    } else if c3 == 61 {
      if !last_quad {
        return None
      }
      let v2 = b64_dec_val(c2)
      if v2 < 0 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[j + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      j = j + 2
    } else {
      let v2 = b64_dec_val(c2)
      let v3 = b64_dec_val(c3)
      if v2 < 0 || v3 < 0 {
        return None
      }
      out[j] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[j + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      out[j + 2] = (((v2 & 0x03) << 6) | v3).to_byte()
      j = j + 3
    }
    i = i + 4
  }
  Some(out)
}

///| Internal: decimal digit count for a non-negative Int (0..=65535 or larger).
fn int_decimal_len(v : Int) -> Int {
  if v < 10 {
    1
  } else if v < 100 {
    2
  } else if v < 1000 {
    3
  } else if v < 10000 {
    4
  } else if v < 100000 {
    5
  } else {
    let mut x = v
    let mut d = 0
    while x > 0 {
      x = x / 10
      d = d + 1
    }
    d
  }
}

///| Internal: write a non-negative Int in decimal directly to a StringBuilder (zero allocation).
fn write_nonneg_int_sb(sb : StringBuilder, v : Int) -> Unit {
  if v < 10 {
    sb.write_byte((48 + v).to_byte())
    return
  }
  if v < 100 {
    sb.write_byte((48 + v / 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  if v < 1000 {
    sb.write_byte((48 + v / 100).to_byte())
    sb.write_byte((48 + (v / 10) % 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  if v < 10000 {
    sb.write_byte((48 + v / 1000).to_byte())
    sb.write_byte((48 + (v / 100) % 10).to_byte())
    sb.write_byte((48 + (v / 10) % 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  if v < 100000 {
    sb.write_byte((48 + v / 10000).to_byte())
    sb.write_byte((48 + (v / 1000) % 10).to_byte())
    sb.write_byte((48 + (v / 100) % 10).to_byte())
    sb.write_byte((48 + (v / 10) % 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  sb.write_string(v.to_string())
}

///| Internal: write a non-negative Int in decimal directly into `out` at `pos`, returning new pos.
fn write_nonneg_int_bytes(out : Bytes, pos : Int, v : Int) -> Int {
  if v < 10 {
    out[pos] = (48 + v).to_byte()
    return pos + 1
  }
  if v < 100 {
    out[pos] = (48 + v / 10).to_byte()
    out[pos + 1] = (48 + v % 10).to_byte()
    return pos + 2
  }
  if v < 1000 {
    out[pos] = (48 + v / 100).to_byte()
    out[pos + 1] = (48 + (v / 10) % 10).to_byte()
    out[pos + 2] = (48 + v % 10).to_byte()
    return pos + 3
  }
  if v < 10000 {
    out[pos] = (48 + v / 1000).to_byte()
    out[pos + 1] = (48 + (v / 100) % 10).to_byte()
    out[pos + 2] = (48 + (v / 10) % 10).to_byte()
    out[pos + 3] = (48 + v % 10).to_byte()
    return pos + 4
  }
  if v < 100000 {
    out[pos] = (48 + v / 10000).to_byte()
    out[pos + 1] = (48 + (v / 1000) % 10).to_byte()
    out[pos + 2] = (48 + (v / 100) % 10).to_byte()
    out[pos + 3] = (48 + (v / 10) % 10).to_byte()
    out[pos + 4] = (48 + v % 10).to_byte()
    return pos + 5
  }
  let s = v.to_string()
  write_ascii_str_bytes(out, pos, s)
}

///| Internal: write an ASCII string directly into `out` at `pos`, returning new pos.
fn write_ascii_str_bytes(out : Bytes, pos : Int, s : String) -> Int {
  let n = s.length()
  let mut i = 0
  while i < n {
    out[pos + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  pos + n
}

///| Internal: write an ASCII string lowercased directly into `out` at `pos`, returning new pos.
fn write_ascii_str_lower_bytes(
  out : Bytes,
  pos : Int,
  s : String,
  start : Int,
  end : Int,
) -> Int {
  let len = end - start
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(start + i)
    out[pos + i] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    i = i + 1
  }
  pos + len
}

///| Internal: copy `src[s_start..s_end]` into `out[dst..]`, returning new dst.
fn copy_bytes_slice(
  out : Bytes,
  dst : Int,
  src : Bytes,
  s_start : Int,
  s_end : Int,
) -> Int {
  let len = s_end - s_start
  let mut i = 0
  while i < len {
    out[dst + i] = src[s_start + i]
    i = i + 1
  }
  dst + len
}
