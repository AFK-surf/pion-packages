///| Sans-IO HTTP CONNECT and plaintext HTTP forward-proxy codecs (RFC 9110 / RFC 9112).

///| Parsed HTTP CONNECT request (proxy bridge server side).
pub struct HttpConnectRequest {
  pub host : String
  pub port : Int
  pub version : String
  pub auth : Option[ProxyAuth]
  pub headers : Array[HttpHeader]
}

///| Parsed HTTP CONNECT response (proxy client side).
pub struct HttpConnectResponse {
  pub version : String
  pub status : Int
  pub reason : String
  pub proxy_authenticate : Option[String]
  pub headers : Array[HttpHeader]
}

///|
pub fn HttpConnectResponse::is_success(self : HttpConnectResponse) -> Bool {
  self.status >= 200 && self.status < 300
}

///|
pub fn HttpConnectResponse::is_auth_required(self : HttpConnectResponse) -> Bool {
  self.status == 407
}

///| Parsed and sanitized plaintext HTTP forward-proxy request.
pub struct SanitizedForwardRequest {
  pub method : String
  pub target_host : String
  pub target_port : Int
  pub origin_path : String
  pub version : String
  pub headers : Array[HttpHeader]
  pub wire_head : Bytes
  pub content_length : Option[Int64]
  pub is_chunked : Bool
  pub proxy_auth : Option[ProxyAuth]
}

///| Internal: validate an HTTP header token name (zero allocation).
fn validate_http_header_name(name : String) -> Result[Unit, ProxyError] {
  let n = name.length()
  if n == 0 {
    return Err(ProxyError::InvalidHeader("empty header name"))
  }
  let mut i = 0
  while i < n {
    let c = name.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in header name"))
    }
    if !is_http_tchar(c) {
      return Err(ProxyError::InvalidHeader("invalid token character in header name"))
    }
    i = i + 1
  }
  Ok(())
}

///| Internal: validate an HTTP header value (zero allocation; returns whether non-ASCII seen).
fn validate_http_header_value_ascii(hv : String) -> Result[Bool, ProxyError] {
  let n = hv.length()
  let mut non_ascii = false
  let mut i = 0
  while i < n {
    let c = hv.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in header value"))
    }
    if (c < 32 && c != 9) || c == 127 {
      return Err(ProxyError::InvalidHeader("control character in header value"))
    }
    if c >= 128 {
      non_ascii = true
    }
    i = i + 1
  }
  Ok(non_ascii)
}

///| Internal: parse `authority` directly from `buf[start..end]`, returning unbracketed lowercase host + port.
fn parse_authority_bytes(
  buf : Bytes,
  start : Int,
  end : Int,
  default_port : Option[Int],
) -> Result[(String, Int), ProxyError] {
  if start >= end {
    return Err(ProxyError::InvalidHost("empty authority"))
  }
  if buf[start].to_int() == 91 {
    let mut close_br = -1
    let mut i = start + 1
    while i < end {
      if buf[i].to_int() == 93 {
        close_br = i
        break
      }
      i = i + 1
    }
    if close_br < 0 || close_br == start + 1 {
      return Err(ProxyError::InvalidHost("malformed bracketed IPv6"))
    }
    if !is_valid_ipv6_bytes(buf, start + 1, close_br) {
      return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
    let host = bytes_slice_ascii_lower(buf, start + 1, close_br)
    let after = close_br + 1
    if after == end {
      match default_port {
        Some(dp) => return Ok((host, dp))
        None => return Err(ProxyError::InvalidPort("missing port in authority"))
      }
    }
    if buf[after].to_int() != 58 {
      return Err(ProxyError::InvalidHost("unexpected character after ']'"))
    }
    match parse_port_bytes(buf, after + 1, end) {
      Some(p) => return Ok((host, p))
      None => return Err(ProxyError::InvalidPort("invalid port"))
    }
  }
  let mut colon = -1
  let mut colons = 0
  let mut j = start
  while j < end {
    if buf[j].to_int() == 58 {
      colon = j
      colons = colons + 1
    }
    j = j + 1
  }
  if colons > 1 {
    return Err(ProxyError::InvalidHost("unbracketed IPv6 in authority"))
  }
  if colon < 0 {
    if !validate_plain_host_bytes(buf, start, end) {
      return Err(ProxyError::InvalidHost("invalid host"))
    }
    match default_port {
      Some(dp) => return Ok((bytes_slice_ascii_lower(buf, start, end), dp))
      None => return Err(ProxyError::InvalidPort("missing port in authority"))
    }
  }
  if !validate_plain_host_bytes(buf, start, colon) {
    return Err(ProxyError::InvalidHost("invalid host"))
  }
  match parse_port_bytes(buf, colon + 1, end) {
    Some(p) => Ok((bytes_slice_ascii_lower(buf, start, colon), p))
    None => Err(ProxyError::InvalidPort("invalid port"))
  }
}

///| Internal: parse `Proxy-Authorization: Basic <b64>` directly from `buf[start..end]`.
fn parse_basic_proxy_auth_bytes(
  buf : Bytes,
  start : Int,
  end : Int,
) -> Option[ProxyAuth] {
  let mut s = start
  let mut e = end
  while s < e {
    let c = buf[s].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      s = s + 1
    } else {
      break
    }
  }
  while e > s {
    let c = buf[e - 1].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      e = e - 1
    } else {
      break
    }
  }
  if e - s < 7 || !bytes_eq_lower_lit(buf, s, s + 6, "basic ") {
    return None
  }
  let mut ts = s + 6
  let mut te = e
  while ts < te {
    let c = buf[ts].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      ts = ts + 1
    } else {
      break
    }
  }
  while te > ts {
    let c = buf[te - 1].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      te = te - 1
    } else {
      break
    }
  }
  let decoded = match base64_decode_bytes(buf, ts, te) {
    Some(d) => d
    None => return None
  }
  let dn = decoded.length()
  let mut colon = -1
  let mut i = 0
  while i < dn {
    let c = decoded[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return None
    }
    if c == 58 && colon < 0 {
      colon = i
    }
    i = i + 1
  }
  if colon < 0 {
    return None
  }
  let user = decoded.slice(0, colon).to_string()
  let pass = decoded.slice(colon + 1, dn).to_string()
  Some(ProxyAuth::new(user, pass))
}

///| Internal: find `\r\n\r\n` end of HTTP header block while enforcing `max_header_bytes` and rejecting bare LF/NUL.
fn find_http_head_end(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[Option[Int], ProxyError] {
  let n = buf.length()
  let scan_limit = if n < limits.max_header_bytes {
    n
  } else {
    limits.max_header_bytes
  }
  let mut i = 0
  while i < scan_limit {
    let c = buf[i].to_int()
    if c == 0 {
      return Err(ProxyError::CrlfInjection("NUL byte in HTTP header block"))
    }
    if c == 10 {
      if i == 0 || buf[i - 1].to_int() != 13 {
        return Err(
          ProxyError::InvalidHttpSyntax("bare LF not allowed in HTTP headers"),
        )
      }
      if i >= 3 &&
      buf[i - 3].to_int() == 13 &&
      buf[i - 2].to_int() == 10 {
        return Ok(Some(i + 1))
      }
    }
    i = i + 1
  }
  if n > limits.max_header_bytes {
    return Err(
      ProxyError::LimitExceeded("HTTP header block exceeds max_header_bytes"),
    )
  }
  Ok(None)
}

///| Internal: match HTTP version literal on `buf[start..end]`, returning static string literal.
fn match_http_version_bytes(buf : Bytes, start : Int, end : Int) -> Option[String] {
  if end - start != 8 {
    return None
  }
  if buf[start].to_int() == 72 &&
  buf[start + 1].to_int() == 84 &&
  buf[start + 2].to_int() == 84 &&
  buf[start + 3].to_int() == 80 &&
  buf[start + 4].to_int() == 47 &&
  buf[start + 5].to_int() == 49 &&
  buf[start + 6].to_int() == 46 {
    let minor = buf[start + 7].to_int()
    if minor == 49 {
      return Some("HTTP/1.1")
    }
    if minor == 48 {
      return Some("HTTP/1.0")
    }
  }
  None
}

///| Internal: write Base64 of `user + ":" + pass` (ASCII fast path) directly into `out[dst..]`.
fn base64_encode_userpass_ascii_into(
  out : Bytes,
  dst : Int,
  user : String,
  pass : String,
) -> Int {
  let ulen = user.length()
  let plen = pass.length()
  let total = ulen + 1 + plen
  let mut i = 0
  let mut j = dst
  while i + 3 <= total {
    let b0 = if i < ulen {
      user.code_unit_at(i)
    } else if i == ulen {
      58
    } else {
      pass.code_unit_at(i - ulen - 1)
    }
    let i1 = i + 1
    let b1 = if i1 < ulen {
      user.code_unit_at(i1)
    } else if i1 == ulen {
      58
    } else {
      pass.code_unit_at(i1 - ulen - 1)
    }
    let i2 = i + 2
    let b2 = if i2 < ulen {
      user.code_unit_at(i2)
    } else if i2 == ulen {
      58
    } else {
      pass.code_unit_at(i2 - ulen - 1)
    }
    let triple = (b0 << 16) | (b1 << 8) | b2
    out[j] = b64_enc_char((triple >> 18) & 0x3F)
    out[j + 1] = b64_enc_char((triple >> 12) & 0x3F)
    out[j + 2] = b64_enc_char((triple >> 6) & 0x3F)
    out[j + 3] = b64_enc_char(triple & 0x3F)
    i = i + 3
    j = j + 4
  }
  let rem = total - i
  if rem == 1 {
    let b0 = if i < ulen {
      user.code_unit_at(i)
    } else if i == ulen {
      58
    } else {
      pass.code_unit_at(i - ulen - 1)
    }
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char((b0 << 4) & 0x3F)
    out[j + 2] = (61).to_byte()
    out[j + 3] = (61).to_byte()
    j = j + 4
  } else if rem == 2 {
    let b0 = if i < ulen {
      user.code_unit_at(i)
    } else if i == ulen {
      58
    } else {
      pass.code_unit_at(i - ulen - 1)
    }
    let i1 = i + 1
    let b1 = if i1 < ulen {
      user.code_unit_at(i1)
    } else if i1 == ulen {
      58
    } else {
      pass.code_unit_at(i1 - ulen - 1)
    }
    out[j] = b64_enc_char((b0 >> 2) & 0x3F)
    out[j + 1] = b64_enc_char(((b0 << 4) | (b1 >> 4)) & 0x3F)
    out[j + 2] = b64_enc_char((b1 << 2) & 0x3F)
    out[j + 3] = (61).to_byte()
    j = j + 4
  }
  j
}

///| Encode an HTTP `CONNECT` request with IPv6 bracketing, `Host`, optional `Proxy-Authorization: Basic`,
///| and strict CRLF/NUL/colon injection protection.
pub fn encode_connect_request(
  host : String,
  port : Int,
  auth : Option[ProxyAuth],
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  if port <= 0 || port > 65535 {
    return Err(ProxyError::InvalidPort("CONNECT port must be 1..65535"))
  }
  let hn = host.length()
  if hn == 0 {
    return Err(ProxyError::InvalidHost("empty CONNECT host"))
  }
  let mut has_colon = false
  let mut i = 0
  while i < hn {
    let c = host.code_unit_at(i)
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in CONNECT host"))
    }
    if c <= 32 || c == 127 {
      return Err(ProxyError::InvalidHost("whitespace or control char in host"))
    }
    if c == 58 {
      has_colon = true
    }
    i = i + 1
  }
  let mut h_start = 0
  let mut h_end = hn
  let mut is_v6 = false
  if host.code_unit_at(0) == 91 {
    if host.code_unit_at(hn - 1) != 93 || hn < 4 {
      return Err(ProxyError::InvalidHost("malformed bracketed IPv6 host"))
    }
    h_start = 1
    h_end = hn - 1
    if !is_valid_ipv6_range(host, h_start, h_end) {
      return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
    is_v6 = true
  } else if has_colon {
    if !is_valid_ipv6_range(host, 0, hn) {
      return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
    is_v6 = true
  } else if !validate_plain_host_range(host, 0, hn) {
    return Err(ProxyError::InvalidHost("invalid characters in CONNECT host"))
  }

  let mut auth_non_ascii = false
  let mut auth_joined_bytes : Option[Bytes] = None
  let mut auth_b64_len = 0
  match auth {
    None => ()
    Some(a) => {
      let un = a.username.length()
      let mut ui = 0
      while ui < un {
        let c = a.username.code_unit_at(ui)
        if c == 13 || c == 10 || c == 0 {
          return Err(
            ProxyError::CrlfInjection("CRLF/NUL in Proxy-Authorization credentials"),
          )
        }
        if c == 58 {
          return Err(
            ProxyError::InvalidCredentials(
              "Basic auth username must not contain ':'",
            ),
          )
        }
        if c >= 128 {
          auth_non_ascii = true
        }
        ui = ui + 1
      }
      let pn = a.password.length()
      let mut pi = 0
      while pi < pn {
        let c = a.password.code_unit_at(pi)
        if c == 13 || c == 10 || c == 0 {
          return Err(
            ProxyError::CrlfInjection("CRLF/NUL in Proxy-Authorization credentials"),
          )
        }
        if c >= 128 {
          auth_non_ascii = true
        }
        pi = pi + 1
      }
      if auth_non_ascii {
        let jb = (a.username + ":" + a.password).to_bytes()
        auth_b64_len = ((jb.length() + 2) / 3) * 4
        auth_joined_bytes = Some(jb)
      } else {
        auth_b64_len = ((un + 1 + pn + 2) / 3) * 4
      }
    }
  }

  let extra_len = extra_headers.length()
  let mut extra_wire_len = 0
  let mut extra_non_ascii = false
  let mut hi = 0
  while hi < extra_len {
    let h = extra_headers[hi]
    match validate_http_header_name(h.name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_http_header_value_ascii(h.value) {
      Ok(na) => if na { extra_non_ascii = true }
      Err(e) => return Err(e)
    }
    let nl = h.name.length()
    if (nl == 4 && str_eq_lower_lit(h.name, "host")) ||
    (nl == 19 && str_eq_lower_lit(h.name, "proxy-authorization")) {
      return Err(
        ProxyError::InvalidHeader(
          "extra_headers must not duplicate Host or Proxy-Authorization",
        ),
      )
    }
    extra_wire_len = extra_wire_len + nl + 2 + h.value.length() + 2
    hi = hi + 1
  }

  if extra_non_ascii {
    // Fallback for non-ASCII header values.
    let sb = StringBuilder::with_capacity(128 + extra_wire_len)
    sb.write_string("CONNECT ")
    if is_v6 {
      sb.write_byte((91).to_byte())
      sb.write_string(str_slice_ascii_lower(host, h_start, h_end))
      sb.write_byte((93).to_byte())
    } else {
      sb.write_string(host)
    }
    sb.write_byte((58).to_byte())
    write_nonneg_int_sb(sb, port)
    sb.write_string(" HTTP/1.1\r\nHost: ")
    if is_v6 {
      sb.write_byte((91).to_byte())
      sb.write_string(str_slice_ascii_lower(host, h_start, h_end))
      sb.write_byte((93).to_byte())
    } else {
      sb.write_string(host)
    }
    sb.write_byte((58).to_byte())
    write_nonneg_int_sb(sb, port)
    sb.write_string("\r\n")
    match auth {
      Some(a) => {
        sb.write_string("Proxy-Authorization: Basic ")
        let b64_buf = Bytes::new(auth_b64_len)
        match auth_joined_bytes {
          Some(jb) => {
            let _ = base64_encode_into(b64_buf, 0, jb)
          }
          None => {
            let _ = base64_encode_userpass_ascii_into(
              b64_buf, 0, a.username, a.password,
            )
          }
        }
        sb.write_string(b64_buf.to_string())
        sb.write_string("\r\n")
      }
      None => ()
    }
    let mut ei = 0
    while ei < extra_len {
      sb.write_string(extra_headers[ei].name)
      sb.write_string(": ")
      sb.write_string(extra_headers[ei].value)
      sb.write_string("\r\n")
      ei = ei + 1
    }
    sb.write_string("\r\n")
    return Ok(sb.to_string().to_bytes())
  }

  // Single-allocation direct Bytes encoding fast path.
  let port_len = int_decimal_len(port)
  let auth_part_len = (h_end - h_start) + (if is_v6 { 2 } else { 0 }) + 1 + port_len
  let proxy_auth_line_len = match auth {
    Some(_) => 27 + auth_b64_len + 2 // "Proxy-Authorization: Basic " (27) + b64 + "\r\n"
    None => 0
  }
  let total_len = 8 +
  auth_part_len +
  17 + // " HTTP/1.1\r\nHost: "
  auth_part_len +
  2 +
  proxy_auth_line_len +
  extra_wire_len +
  2
  let mut out = Bytes::new(total_len)
  let mut pos = write_ascii_str_bytes(out, 0, "CONNECT ")
  if is_v6 {
    out[pos] = (91).to_byte()
    pos = write_ascii_str_lower_bytes(out, pos + 1, host, h_start, h_end)
    out[pos] = (93).to_byte()
    pos = pos + 1
  } else {
    pos = write_ascii_str_bytes(out, pos, host)
  }
  out[pos] = (58).to_byte()
  pos = write_nonneg_int_bytes(out, pos + 1, port)
  pos = write_ascii_str_bytes(out, pos, " HTTP/1.1\r\nHost: ")
  if is_v6 {
    out[pos] = (91).to_byte()
    pos = write_ascii_str_lower_bytes(out, pos + 1, host, h_start, h_end)
    out[pos] = (93).to_byte()
    pos = pos + 1
  } else {
    pos = write_ascii_str_bytes(out, pos, host)
  }
  out[pos] = (58).to_byte()
  pos = write_nonneg_int_bytes(out, pos + 1, port)
  out[pos] = (13).to_byte()
  out[pos + 1] = (10).to_byte()
  pos = pos + 2
  match auth {
    Some(a) => {
      pos = write_ascii_str_bytes(out, pos, "Proxy-Authorization: Basic ")
      match auth_joined_bytes {
        Some(jb) => pos = base64_encode_into(out, pos, jb)
        None =>
        pos = base64_encode_userpass_ascii_into(
          out, pos, a.username, a.password,
        )
      }
      out[pos] = (13).to_byte()
      out[pos + 1] = (10).to_byte()
      pos = pos + 2
    }
    None => ()
  }
  let mut ei = 0
  while ei < extra_len {
    pos = write_ascii_str_bytes(out, pos, extra_headers[ei].name)
    out[pos] = (58).to_byte()
    out[pos + 1] = (32).to_byte()
    pos = write_ascii_str_bytes(out, pos + 2, extra_headers[ei].value)
    out[pos] = (13).to_byte()
    out[pos + 1] = (10).to_byte()
    pos = pos + 2
    ei = ei + 1
  }
  out[pos] = (13).to_byte()
  out[pos + 1] = (10).to_byte()
  Ok(out)
}

///| Streaming decode of an HTTP `CONNECT` request (proxy bridge server side).
pub fn decode_connect_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectRequest], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  // Parse request line
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in request line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("request line exceeds max_line_bytes"))
  }
  let mut sp1 = -1
  let mut sp2 = -1
  let mut i = 0
  while i < line_end {
    if buf[i].to_int() == 32 {
      if sp1 < 0 {
        sp1 = i
      } else if sp2 < 0 {
        sp2 = i
      } else {
        return Err(
          ProxyError::InvalidHttpSyntax("extra space in CONNECT request line"),
        )
      }
    }
    i = i + 1
  }
  if sp1 <= 0 || sp2 <= sp1 + 1 || sp2 + 1 >= line_end {
    return Err(ProxyError::InvalidHttpSyntax("malformed CONNECT request line"))
  }
  if !bytes_eq_lit(buf, 0, sp1, "CONNECT") {
    return Err(ProxyError::InvalidHttpSyntax("expected CONNECT method"))
  }
  let version = match match_http_version_bytes(buf, sp2 + 1, line_end) {
    Some(v) => v
    None => return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }
  let (host, port) = match parse_authority_bytes(buf, sp1 + 1, sp2, None) {
    Ok(hp) => hp
    Err(e) => return Err(e)
  }

  // Parse headers and extract Proxy-Authorization in a single pass.
  let headers : Array[HttpHeader] = Array::with_capacity(4)
  let mut auth : Option[ProxyAuth] = None
  let mut seen_proxy_auth = false
  let mut pos = line_end + 2
  let body_end = head_end - 2
  while pos < body_end {
    let mut h_end = pos
    while h_end + 1 < head_end {
      if buf[h_end].to_int() == 13 {
        if buf[h_end + 1].to_int() != 10 {
          return Err(ProxyError::InvalidHttpSyntax("bare CR in header line"))
        }
        break
      }
      h_end = h_end + 1
    }
    let line_len = h_end - pos
    if line_len > limits.max_line_bytes {
      return Err(ProxyError::LimitExceeded("header line exceeds max_line_bytes"))
    }
    if line_len == 0 {
      break
    }
    let first = buf[pos].to_int()
    if first == 32 || first == 9 {
      return Err(ProxyError::SmugglingDetected("obs-fold header rejected"))
    }
    let mut colon = -1
    let mut j = pos
    while j < h_end {
      let c = buf[j].to_int()
      if c == 58 {
        colon = j
        break
      }
      if !((c >= 97 && c <= 122) ||
        (c >= 65 && c <= 90) ||
        c == 45 ||
        (c >= 48 && c <= 57)) &&
      !is_http_tchar(c) {
        return Err(
          ProxyError::InvalidHeader(
            "invalid character or whitespace before ':' in header name",
          ),
        )
      }
      j = j + 1
    }
    if colon <= pos {
      return Err(ProxyError::InvalidHeader("missing ':' or empty header name"))
    }
    if headers.length() >= limits.max_headers {
      return Err(ProxyError::LimitExceeded("header count exceeds max_headers"))
    }
    let mut vs = colon + 1
    let mut ve = h_end
    while vs < ve && (buf[vs].to_int() == 32 || buf[vs].to_int() == 9) {
      vs = vs + 1
    }
    while ve > vs && (buf[ve - 1].to_int() == 32 || buf[ve - 1].to_int() == 9) {
      ve = ve - 1
    }
    let mut k = vs
    while k < ve {
      let c = buf[k].to_int()
      if (c < 32 && c != 9) || c == 127 {
        return Err(ProxyError::InvalidHeader("control character in header value"))
      }
      k = k + 1
    }
    if colon - pos == 19 && bytes_eq_lower_lit(buf, pos, colon, "proxy-authorization") {
      if seen_proxy_auth {
        return Err(
          ProxyError::InvalidHeader("duplicate Proxy-Authorization header"),
        )
      }
      seen_proxy_auth = true
      auth = parse_basic_proxy_auth_bytes(buf, vs, ve)
    }
    headers.push(
      HttpHeader::new(
        buf.slice(pos, colon).to_string(),
        buf.slice(vs, ve).to_string(),
      ),
    )
    pos = h_end + 2
  }
  Ok(
    DecodeStatus::Complete(
      HttpConnectRequest::{
        host: host,
        port: port,
        version: version,
        auth: auth,
        headers: headers,
      },
      head_end,
    ),
  )
}

///| Encode an HTTP `CONNECT` response (proxy bridge server side).
pub fn encode_connect_response(
  status : Int,
  reason : String,
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  if status < 100 || status > 999 {
    return Err(ProxyError::InvalidHttpSyntax("HTTP status must be 100..999"))
  }
  if has_crlf_or_nul(reason) {
    return Err(ProxyError::CrlfInjection("CRLF/NUL in reason phrase"))
  }
  let extra_len = extra_headers.length()
  let mut extra_wire_len = 0
  let mut hi = 0
  while hi < extra_len {
    let h = extra_headers[hi]
    match validate_http_header_name(h.name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_http_header_value_ascii(h.value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    extra_wire_len = extra_wire_len + h.name.length() + 2 + h.value.length() + 2
    hi = hi + 1
  }
  let sb = StringBuilder::with_capacity(20 + reason.length() + extra_wire_len)
  sb.write_string("HTTP/1.1 ")
  write_nonneg_int_sb(sb, status)
  if reason.length() > 0 {
    sb.write_byte((32).to_byte())
    sb.write_string(reason)
  }
  sb.write_string("\r\n")
  let mut ei = 0
  while ei < extra_len {
    sb.write_string(extra_headers[ei].name)
    sb.write_string(": ")
    sb.write_string(extra_headers[ei].value)
    sb.write_string("\r\n")
    ei = ei + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}

///| Streaming decode of an HTTP `CONNECT` response (proxy client side).
///| Preserves `407 Proxy Authentication Required` and `Proxy-Authenticate` structurally,
///| and returns exact `consumed` so pipelined TLS ClientHello bytes are never lost.
pub fn decode_connect_response(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectResponse], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in status line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("status line exceeds max_line_bytes"))
  }
  // Format: HTTP/1.x <3-digit-status>[ <reason>]
  if line_end < 12 || buf[8].to_int() != 32 {
    return Err(ProxyError::InvalidHttpSyntax("malformed HTTP status line"))
  }
  let version = match match_http_version_bytes(buf, 0, 8) {
    Some(v) => v
    None => return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }
  let d0 = buf[9].to_int()
  let d1 = buf[10].to_int()
  let d2 = buf[11].to_int()
  if d0 < 48 || d0 > 57 || d1 < 48 || d1 > 57 || d2 < 48 || d2 > 57 {
    return Err(ProxyError::InvalidHttpSyntax("non-numeric HTTP status code"))
  }
  let status = (d0 - 48) * 100 + (d1 - 48) * 10 + (d2 - 48)
  let mut reason = ""
  if line_end > 12 {
    if buf[12].to_int() != 32 {
      return Err(ProxyError::InvalidHttpSyntax("missing space after status code"))
    }
    reason = buf.slice(13, line_end).to_string()
  }

  let headers : Array[HttpHeader] = Array::with_capacity(4)
  let mut proxy_auth_chal : Option[String] = None
  let mut pos = line_end + 2
  let body_end = head_end - 2
  while pos < body_end {
    let mut h_end = pos
    while h_end + 1 < head_end {
      if buf[h_end].to_int() == 13 {
        if buf[h_end + 1].to_int() != 10 {
          return Err(ProxyError::InvalidHttpSyntax("bare CR in header line"))
        }
        break
      }
      h_end = h_end + 1
    }
    let line_len = h_end - pos
    if line_len > limits.max_line_bytes {
      return Err(ProxyError::LimitExceeded("header line exceeds max_line_bytes"))
    }
    if line_len == 0 {
      break
    }
    let first = buf[pos].to_int()
    if first == 32 || first == 9 {
      return Err(ProxyError::SmugglingDetected("obs-fold header rejected"))
    }
    let mut colon = -1
    let mut j = pos
    while j < h_end {
      let c = buf[j].to_int()
      if c == 58 {
        colon = j
        break
      }
      if !((c >= 97 && c <= 122) ||
        (c >= 65 && c <= 90) ||
        c == 45 ||
        (c >= 48 && c <= 57)) &&
      !is_http_tchar(c) {
        return Err(
          ProxyError::InvalidHeader(
            "invalid character or whitespace before ':' in header name",
          ),
        )
      }
      j = j + 1
    }
    if colon <= pos {
      return Err(ProxyError::InvalidHeader("missing ':' or empty header name"))
    }
    if headers.length() >= limits.max_headers {
      return Err(ProxyError::LimitExceeded("header count exceeds max_headers"))
    }
    let mut vs = colon + 1
    let mut ve = h_end
    while vs < ve && (buf[vs].to_int() == 32 || buf[vs].to_int() == 9) {
      vs = vs + 1
    }
    while ve > vs && (buf[ve - 1].to_int() == 32 || buf[ve - 1].to_int() == 9) {
      ve = ve - 1
    }
    let mut k = vs
    while k < ve {
      let c = buf[k].to_int()
      if (c < 32 && c != 9) || c == 127 {
        return Err(ProxyError::InvalidHeader("control character in header value"))
      }
      k = k + 1
    }
    let name = buf.slice(pos, colon).to_string()
    let value = buf.slice(vs, ve).to_string()
    if colon - pos == 18 && bytes_eq_lower_lit(buf, pos, colon, "proxy-authenticate") {
      proxy_auth_chal = Some(value)
    }
    headers.push(HttpHeader::new(name, value))
    pos = h_end + 2
  }
  Ok(
    DecodeStatus::Complete(
      HttpConnectResponse::{
        version: version,
        status: status,
        reason: reason,
        proxy_authenticate: proxy_auth_chal,
        headers: headers,
      },
      head_end,
    ),
  )
}

///| Internal: append comma-separated header names from `buf[vs..ve]` (lowercased).
fn collect_connection_tokens_bytes(
  buf : Bytes,
  vs : Int,
  ve : Int,
  out : Array[String],
) -> Unit {
  let mut start = vs
  let mut i = vs
  while i <= ve {
    if i == ve || buf[i].to_int() == 44 {
      let mut ts = start
      let mut te = i
      while ts < te {
        let c = buf[ts].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          ts = ts + 1
        } else {
          break
        }
      }
      while te > ts {
        let c = buf[te - 1].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          te = te - 1
        } else {
          break
        }
      }
      if ts < te {
        out.push(bytes_slice_ascii_lower(buf, ts, te))
      }
      start = i + 1
    }
    i = i + 1
  }
}

///| Internal: check whether `buf[ns..ne]` (case-insensitive) appears in `nominated_lower`.
fn bytes_is_nominated_hop(
  buf : Bytes,
  ns : Int,
  ne : Int,
  nominated_lower : Array[String],
) -> Bool {
  let n = nominated_lower.length()
  let mut i = 0
  while i < n {
    if bytes_eq_lower_lit(buf, ns, ne, nominated_lower[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal: parse comma-separated `Content-Length` values from `buf[vs..ve]` and check against previous value.
fn parse_and_check_content_length_bytes(
  buf : Bytes,
  vs : Int,
  ve : Int,
  prev : Option[Int64],
) -> Result[Int64, ProxyError] {
  let mut current = prev
  let mut start = vs
  let mut i = vs
  let mut count = 0
  while i <= ve {
    if i == ve || buf[i].to_int() == 44 {
      let mut ts = start
      let mut te = i
      while ts < te {
        let c = buf[ts].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          ts = ts + 1
        } else {
          break
        }
      }
      while te > ts {
        let c = buf[te - 1].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          te = te - 1
        } else {
          break
        }
      }
      let parsed = match parse_u64_bytes(buf, ts, te) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::SmugglingDetected("invalid Content-Length value"),
        )
      }
      match current {
        Some(existing) =>
        if existing != parsed {
          return Err(
            ProxyError::SmugglingDetected("conflicting Content-Length headers"),
          )
        }
        None => current = Some(parsed)
      }
      count = count + 1
      start = i + 1
    }
    i = i + 1
  }
  if count == 0 {
    return Err(ProxyError::SmugglingDetected("empty Content-Length header"))
  }
  match current {
    Some(v) => Ok(v)
    None => Err(ProxyError::SmugglingDetected("empty Content-Length header"))
  }
}

///| Internal: validate `Transfer-Encoding` value from `buf[vs..ve]` for forward requests (RFC 9112 §6.3).
fn validate_transfer_encoding_bytes(
  buf : Bytes,
  vs : Int,
  ve : Int,
  is_http10 : Bool,
  already_chunked : Bool,
) -> Result[Bool, ProxyError] {
  if is_http10 {
    return Err(
      ProxyError::SmugglingDetected("Transfer-Encoding not allowed in HTTP/1.0"),
    )
  }
  let mut saw_chunked = already_chunked
  let mut start = vs
  let mut i = vs
  let mut count = 0
  while i <= ve {
    if i == ve || buf[i].to_int() == 44 {
      let mut ts = start
      let mut te = i
      while ts < te {
        let c = buf[ts].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          ts = ts + 1
        } else {
          break
        }
      }
      while te > ts {
        let c = buf[te - 1].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          te = te - 1
        } else {
          break
        }
      }
      let tlen = te - ts
      if tlen == 0 {
        return Err(
          ProxyError::SmugglingDetected("empty Transfer-Encoding coding"),
        )
      }
      if saw_chunked {
        return Err(
          ProxyError::SmugglingDetected(
            "chunked must be the final Transfer-Encoding",
          ),
        )
      }
      if tlen == 7 && bytes_eq_lower_lit(buf, ts, te, "chunked") {
        saw_chunked = true
      } else if !(
        (tlen == 4 && bytes_eq_lower_lit(buf, ts, te, "gzip")) ||
        (tlen == 7 && bytes_eq_lower_lit(buf, ts, te, "deflate")) ||
        (tlen == 8 && bytes_eq_lower_lit(buf, ts, te, "compress"))
      ) {
        return Err(
          ProxyError::SmugglingDetected("unknown Transfer-Encoding coding"),
        )
      }
      count = count + 1
      start = i + 1
    }
    i = i + 1
  }
  if count == 0 {
    return Err(ProxyError::SmugglingDetected("empty Transfer-Encoding header"))
  }
  Ok(saw_chunked)
}

///| Internal: fast-path common HTTP methods to static string literals (zero alloc).
fn extract_method_bytes(buf : Bytes, end : Int) -> String {
  if end == 3 && bytes_eq_lit(buf, 0, 3, "GET") {
    return "GET"
  }
  if end == 4 && bytes_eq_lit(buf, 0, 4, "POST") {
    return "POST"
  }
  if end == 3 && bytes_eq_lit(buf, 0, 3, "PUT") {
    return "PUT"
  }
  if end == 4 && bytes_eq_lit(buf, 0, 4, "HEAD") {
    return "HEAD"
  }
  if end == 6 && bytes_eq_lit(buf, 0, 6, "DELETE") {
    return "DELETE"
  }
  buf.slice(0, end).to_string()
}

///| Parse a plaintext HTTP forward-proxy request, rewrite absolute-form to origin-form,
///| enforce anti-smuggling checks, strip all RFC 9110 §7.6.1 hop-by-hop + `Connection`-nominated headers,
///| and return the sanitized upstream request head.
pub fn parse_and_sanitize_forward_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[SanitizedForwardRequest], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in request line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("request line exceeds max_line_bytes"))
  }
  let mut sp1 = -1
  let mut sp2 = -1
  let mut i = 0
  while i < line_end {
    if buf[i].to_int() == 32 {
      if sp1 < 0 {
        sp1 = i
      } else if sp2 < 0 {
        sp2 = i
      } else {
        return Err(ProxyError::InvalidHttpSyntax("extra space in request line"))
      }
    }
    i = i + 1
  }
  if sp1 <= 0 || sp2 <= sp1 + 1 || sp2 + 1 >= line_end {
    return Err(ProxyError::InvalidHttpSyntax("malformed HTTP request line"))
  }
  // Validate method directly on buf[0..sp1].
  let mut mi = 0
  while mi < sp1 {
    if !is_http_tchar(buf[mi].to_int()) {
      return Err(ProxyError::InvalidHttpSyntax("invalid HTTP method token"))
    }
    mi = mi + 1
  }
  // Validate request-target directly on buf[sp1+1..sp2].
  let t_start = sp1 + 1
  let t_end = sp2
  let mut ti = t_start
  while ti < t_end {
    let tc = buf[ti].to_int()
    if tc < 33 || tc == 127 || tc == 35 {
      return Err(
        ProxyError::InvalidHttpSyntax(
          "invalid control, whitespace, or fragment byte in request-target",
        ),
      )
    }
    ti = ti + 1
  }
  let version = match match_http_version_bytes(buf, sp2 + 1, line_end) {
    Some(v) => v
    None => return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }
  let is_http10 = buf[sp2 + 8].to_int() == 48

  // Pass 1: parse and classify headers directly on buf spans (ZERO String allocations for dropped headers).
  // Flat array: 5 ints per candidate header [ns, ne, vs, ve, tag].
  // tag: 0 = normal header, 1 = first Content-Length slot, 2 = Transfer-Encoding (framing), -1 = dropped.
  let kept : Array[Int] = Array::with_capacity(40)

  let nominated_hops : Array[String] = []
  let mut proxy_auth : Option[ProxyAuth] = None
  let mut seen_proxy_auth = false
  let mut content_length : Option[Int64] = None
  let mut has_cl_slot = false
  let mut has_te = false
  let mut is_chunked = false
  let mut host_count = 0
  let mut host_vs = -1
  let mut host_ve = -1
  let mut total_raw_headers = 0

  let mut pos = line_end + 2
  let body_end = head_end - 2
  while pos < body_end {
    let mut h_end = pos
    while h_end + 1 < head_end {
      if buf[h_end].to_int() == 13 {
        if buf[h_end + 1].to_int() != 10 {
          return Err(ProxyError::InvalidHttpSyntax("bare CR in header line"))
        }
        break
      }
      h_end = h_end + 1
    }
    let line_len = h_end - pos
    if line_len > limits.max_line_bytes {
      return Err(ProxyError::LimitExceeded("header line exceeds max_line_bytes"))
    }
    if line_len == 0 {
      break
    }
    let first = buf[pos].to_int()
    if first == 32 || first == 9 {
      return Err(ProxyError::SmugglingDetected("obs-fold header rejected"))
    }
    let mut colon = -1
    let mut j = pos
    while j < h_end {
      let c = buf[j].to_int()
      if c == 58 {
        colon = j
        break
      }
      if !((c >= 97 && c <= 122) ||
        (c >= 65 && c <= 90) ||
        c == 45 ||
        (c >= 48 && c <= 57)) &&
      !is_http_tchar(c) {
        return Err(
          ProxyError::InvalidHeader(
            "invalid character or whitespace before ':' in header name",
          ),
        )
      }
      j = j + 1
    }
    if colon <= pos {
      return Err(ProxyError::InvalidHeader("missing ':' or empty header name"))
    }
    if total_raw_headers >= limits.max_headers {
      return Err(ProxyError::LimitExceeded("header count exceeds max_headers"))
    }
    total_raw_headers = total_raw_headers + 1

    let mut vs = colon + 1
    let mut ve = h_end
    while vs < ve && (buf[vs].to_int() == 32 || buf[vs].to_int() == 9) {
      vs = vs + 1
    }
    while ve > vs && (buf[ve - 1].to_int() == 32 || buf[ve - 1].to_int() == 9) {
      ve = ve - 1
    }
    let mut k = vs
    while k < ve {
      let c = buf[k].to_int()
      if (c < 32 && c != 9) || c == 127 {
        return Err(ProxyError::InvalidHeader("control character in header value"))
      }
      k = k + 1
    }

    // Dispatch header by length + lowercased first byte (zero allocation).
    let nlen = colon - pos
    let c0 = ascii_lower_cu(first)
    let mut drop_static = false
    let mut tag = 0

    if c0 == 104 {
      // 'h': host (4)
      if nlen == 4 && bytes_eq_lower_lit(buf, pos, colon, "host") {
        host_count = host_count + 1
        host_vs = vs
        host_ve = ve
        drop_static = true
      }
    } else if c0 == 99 {
      // 'c': connection (10), content-length (14)
      if nlen == 10 && bytes_eq_lower_lit(buf, pos, colon, "connection") {
        collect_connection_tokens_bytes(buf, vs, ve, nominated_hops)
        drop_static = true
      } else if nlen == 14 && bytes_eq_lower_lit(buf, pos, colon, "content-length") {
        if has_te {
          return Err(
            ProxyError::SmugglingDetected(
              "both Transfer-Encoding and Content-Length present",
            ),
          )
        }
        match parse_and_check_content_length_bytes(buf, vs, ve, content_length) {
          Ok(v) => content_length = Some(v)
          Err(e) => return Err(e)
        }
        if has_cl_slot {
          drop_static = true
        } else {
          has_cl_slot = true
          tag = 1
        }
      }
    } else if c0 == 112 {
      // 'p': proxy-connection (16), proxy-authenticate (18), proxy-authorization (19)
      if nlen == 19 && bytes_eq_lower_lit(buf, pos, colon, "proxy-authorization") {
        if seen_proxy_auth {
          return Err(
            ProxyError::InvalidHeader("duplicate Proxy-Authorization header"),
          )
        }
        seen_proxy_auth = true
        proxy_auth = parse_basic_proxy_auth_bytes(buf, vs, ve)
        drop_static = true
      } else if nlen == 16 && bytes_eq_lower_lit(buf, pos, colon, "proxy-connection") {
        drop_static = true
      } else if nlen == 18 && bytes_eq_lower_lit(buf, pos, colon, "proxy-authenticate") {
        drop_static = true
      }
    } else if c0 == 107 {
      // 'k': keep-alive (10)
      if nlen == 10 && bytes_eq_lower_lit(buf, pos, colon, "keep-alive") {
        drop_static = true
      }
    } else if c0 == 116 {
      // 't': te (2), trailer (7), transfer-encoding (17)
      if nlen == 2 && bytes_eq_lower_lit(buf, pos, colon, "te") {
        drop_static = true
      } else if nlen == 7 && bytes_eq_lower_lit(buf, pos, colon, "trailer") {
        drop_static = true
      } else if nlen == 17 && bytes_eq_lower_lit(buf, pos, colon, "transfer-encoding") {
        match content_length {
          Some(_) =>
          return Err(
            ProxyError::SmugglingDetected(
              "both Transfer-Encoding and Content-Length present",
            ),
          )
          None => ()
        }
        match validate_transfer_encoding_bytes(buf, vs, ve, is_http10, is_chunked) {
          Ok(ch) => {
            has_te = true
            is_chunked = ch
          }
          Err(e) => return Err(e)
        }
        tag = 2
      }
    } else if c0 == 117 {
      // 'u': upgrade (7)
      if nlen == 7 && bytes_eq_lower_lit(buf, pos, colon, "upgrade") {
        drop_static = true
      }
    }

    if !drop_static {
      kept.push(pos)
      kept.push(colon)
      kept.push(vs)
      kept.push(ve)
      kept.push(tag)
    }
    pos = h_end + 2
  }

  // Parse target: absolute-form `http://authority[/path[?query]]` or origin-form `/...`
  let tn = t_end - t_start
  let mut target_host = ""
  let mut target_port = 80
  let mut origin_path = "/"

  if tn >= 7 && bytes_eq_lower_lit(buf, t_start, t_start + 7, "http://") {
    let mut path_start = t_end
    let mut p = t_start + 7
    while p < t_end {
      let c = buf[p].to_int()
      if c == 47 || c == 63 {
        path_start = p
        break
      }
      if c == 35 {
        return Err(
          ProxyError::InvalidHttpSyntax("fragment not allowed in request-target"),
        )
      }
      p = p + 1
    }
    let (h, pt) = match parse_authority_bytes(buf, t_start + 7, path_start, Some(80)) {
      Ok(hp) => hp
      Err(e) => return Err(e)
    }
    target_host = h
    target_port = pt
    if path_start < t_end {
      if buf[path_start].to_int() == 63 {
        origin_path = "/" + buf.slice(path_start, t_end).to_string()
      } else {
        origin_path = buf.slice(path_start, t_end).to_string()
      }
    } else {
      origin_path = "/"
    }
  } else if tn >= 1 && buf[t_start].to_int() == 47 {
    origin_path = buf.slice(t_start, t_end).to_string()
    if host_count > 1 {
      return Err(ProxyError::SmugglingDetected("duplicate Host header"))
    }
    if host_count == 0 {
      return Err(
        ProxyError::InvalidHttpSyntax("missing Host header in origin-form"),
      )
    }
    let (h, pt) = match parse_authority_bytes(buf, host_vs, host_ve, Some(80)) {
      Ok(hp) => hp
      Err(e) => return Err(e)
    }
    target_host = h
    target_port = pt
  } else {
    return Err(
      ProxyError::InvalidHttpSyntax(
        "forward proxy requires http:// absolute-form or origin-form target",
      ),
    )
  }

  if has_te && !is_chunked {
    return Err(
      ProxyError::SmugglingDetected(
        "request Transfer-Encoding must end with chunked",
      ),
    )
  }

  // Build canonical Host header value
  let canonical_host = if host_is_ipv6(target_host) {
    if target_port == 80 {
      "[" + target_host + "]"
    } else {
      let sb = StringBuilder::with_capacity(target_host.length() + 8)
      sb.write_byte((91).to_byte())
      sb.write_string(target_host)
      sb.write_byte((93).to_byte())
      sb.write_byte((58).to_byte())
      write_nonneg_int_sb(sb, target_port)
      sb.to_string()
    }
  } else if target_port == 80 {
    target_host
  } else {
    let sb = StringBuilder::with_capacity(target_host.length() + 6)
    sb.write_string(target_host)
    sb.write_byte((58).to_byte())
    write_nonneg_int_sb(sb, target_port)
    sb.to_string()
  }

  let method = extract_method_bytes(buf, sp1)

  // Pass 2: filter dynamically nominated hop-by-hop headers in-place,
  // materialize final HttpHeader list, and compute exact wire_head length.
  let kept_total = kept.length()
  let cand_n = kept_total / 5
  let has_nominated = nominated_hops.length() > 0
  let sanitized : Array[HttpHeader] = Array::with_capacity(cand_n + 1)
  sanitized.push(HttpHeader::new("Host", canonical_host))

  let mut cl_str = ""
  let mut wire_len = sp1 + 1 + origin_path.length() + 1 + 8 + 2 + 6 + canonical_host.length() + 2 + 2
  let mut off = 0
  while off < kept_total {
    let ns = kept[off]
    let ne = kept[off + 1]
    let tag = kept[off + 4]
    if tag == 0 && has_nominated && bytes_is_nominated_hop(buf, ns, ne, nominated_hops) {
      kept[off + 4] = -1
      off = off + 5
      continue
    }
    if tag == 1 {
      match content_length {
        Some(clv) => {
          cl_str = clv.to_string()
          sanitized.push(HttpHeader::new("Content-Length", cl_str))
          wire_len = wire_len + 14 + 2 + cl_str.length() + 2
        }
        None => kept[off + 4] = -1
      }
      off = off + 5
      continue
    }
    let vs = kept[off + 2]
    let ve = kept[off + 3]
    sanitized.push(
      HttpHeader::new(
        buf.slice(ns, ne).to_string(),
        buf.slice(vs, ve).to_string(),
      ),
    )
    wire_len = wire_len + (ne - ns) + 2 + (ve - vs) + 2
    off = off + 5
  }

  // Single-allocation wire_head assembly directly from buf + canonical strings.
  let mut wire_head = Bytes::new(wire_len)
  let mut wpos = copy_bytes_slice(wire_head, 0, buf, 0, sp1)
  wire_head[wpos] = (32).to_byte()
  wpos = write_ascii_str_bytes(wire_head, wpos + 1, origin_path)
  wire_head[wpos] = (32).to_byte()
  wpos = write_ascii_str_bytes(wire_head, wpos + 1, version)
  wpos = write_ascii_str_bytes(wire_head, wpos, "\r\nHost: ")
  wpos = write_ascii_str_bytes(wire_head, wpos, canonical_host)
  wire_head[wpos] = (13).to_byte()
  wire_head[wpos + 1] = (10).to_byte()
  wpos = wpos + 2
  let mut woff = 0
  while woff < kept_total {
    let tag = kept[woff + 4]
    if tag >= 0 {
      if tag == 1 {
        wpos = write_ascii_str_bytes(wire_head, wpos, "Content-Length: ")
        wpos = write_ascii_str_bytes(wire_head, wpos, cl_str)
      } else {
        wpos = copy_bytes_slice(wire_head, wpos, buf, kept[woff], kept[woff + 1])
        wire_head[wpos] = (58).to_byte()
        wire_head[wpos + 1] = (32).to_byte()
        wpos = copy_bytes_slice(
          wire_head,
          wpos + 2,
          buf,
          kept[woff + 2],
          kept[woff + 3],
        )
      }
      wire_head[wpos] = (13).to_byte()
      wire_head[wpos + 1] = (10).to_byte()
      wpos = wpos + 2
    }
    woff = woff + 5
  }
  wire_head[wpos] = (13).to_byte()
  wire_head[wpos + 1] = (10).to_byte()

  Ok(
    DecodeStatus::Complete(
      SanitizedForwardRequest::{
        method: method,
        target_host: target_host,
        target_port: target_port,
        origin_path: origin_path,
        version: version,
        headers: sanitized,
        wire_head: wire_head,
        content_length: content_length,
        is_chunked: is_chunked,
        proxy_auth: proxy_auth,
      },
      head_end,
    ),
  )
}
