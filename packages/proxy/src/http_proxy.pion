///| Sans-IO HTTP CONNECT and plaintext HTTP forward-proxy codecs (RFC 9110 / RFC 9112).

///| Parsed HTTP CONNECT request (proxy bridge server side).
pub struct HttpConnectRequest {
  pub host : String
  pub port : Int
  pub version : String
  pub auth : Option[ProxyAuth]
  pub headers : Array[HttpHeader]
}

///| Parsed HTTP CONNECT response (proxy client side).
pub struct HttpConnectResponse {
  pub version : String
  pub status : Int
  pub reason : String
  pub proxy_authenticate : Option[String]
  pub headers : Array[HttpHeader]
}

///|
pub fn HttpConnectResponse::is_success(self : HttpConnectResponse) -> Bool {
  self.status >= 200 && self.status < 300
}

///|
pub fn HttpConnectResponse::is_auth_required(self : HttpConnectResponse) -> Bool {
  self.status == 407
}

///| Parsed and sanitized plaintext HTTP forward-proxy request.
pub struct SanitizedForwardRequest {
  pub method : String
  pub target_host : String
  pub target_port : Int
  pub origin_path : String
  pub version : String
  pub headers : Array[HttpHeader]
  pub wire_head : Bytes
  pub content_length : Option[Int64]
  pub is_chunked : Bool
  pub proxy_auth : Option[ProxyAuth]
}

///|
pub fn encode_connect_request(
  host : String,
  port : Int,
  auth : Option[ProxyAuth],
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  let _ = host
  let _ = port
  let _ = auth
  let _ = extra_headers
  Err(ProxyError::InvalidHttpSyntax("unimplemented"))
}

///|
pub fn decode_connect_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectRequest], ProxyError] {
  let _ = buf
  let _ = limits
  Err(ProxyError::InvalidHttpSyntax("unimplemented"))
}

///|
pub fn encode_connect_response(
  status : Int,
  reason : String,
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  let _ = status
  let _ = reason
  let _ = extra_headers
  Err(ProxyError::InvalidHttpSyntax("unimplemented"))
}

///|
pub fn decode_connect_response(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectResponse], ProxyError] {
  let _ = buf
  let _ = limits
  Err(ProxyError::InvalidHttpSyntax("unimplemented"))
}

///|
pub fn parse_and_sanitize_forward_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[SanitizedForwardRequest], ProxyError] {
  let _ = buf
  let _ = limits
  Err(ProxyError::InvalidHttpSyntax("unimplemented"))
}
