///| Sans-IO HTTP CONNECT and plaintext HTTP forward-proxy codecs (RFC 9110 / RFC 9112).

///| Parsed HTTP CONNECT request (proxy bridge server side).
pub struct HttpConnectRequest {
  pub host : String
  pub port : Int
  pub version : String
  pub auth : Option[ProxyAuth]
  pub headers : Array[HttpHeader]
}

///| Parsed HTTP CONNECT response (proxy client side).
pub struct HttpConnectResponse {
  pub version : String
  pub status : Int
  pub reason : String
  pub proxy_authenticate : Option[String]
  pub headers : Array[HttpHeader]
}

///|
pub fn HttpConnectResponse::is_success(self : HttpConnectResponse) -> Bool {
  self.status >= 200 && self.status < 300
}

///|
pub fn HttpConnectResponse::is_auth_required(self : HttpConnectResponse) -> Bool {
  self.status == 407
}

///| Parsed and sanitized plaintext HTTP forward-proxy request.
pub struct SanitizedForwardRequest {
  pub method : String
  pub target_host : String
  pub target_port : Int
  pub origin_path : String
  pub version : String
  pub headers : Array[HttpHeader]
  pub wire_head : Bytes
  pub content_length : Option[Int64]
  pub is_chunked : Bool
  pub proxy_auth : Option[ProxyAuth]
}

///| Internal: validate an HTTP header token name (rejects CRLF/NUL and non-tchar).
fn validate_http_header_name(name : String) -> Result[Unit, ProxyError] {
  let b = name.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(ProxyError::InvalidHeader("empty header name"))
  }
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in header name"))
    }
    if !is_http_tchar(c) {
      return Err(ProxyError::InvalidHeader("invalid token character in header name"))
    }
    i = i + 1
  }
  Ok(())
}

///| Internal: validate an HTTP header value (rejects CRLF/NUL/control chars other than HTAB).
fn validate_http_header_value(hv : String) -> Result[Unit, ProxyError] {
  let b = hv.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in header value"))
    }
    if (c < 32 && c != 9) || c == 127 {
      return Err(ProxyError::InvalidHeader("control character in header value"))
    }
    i = i + 1
  }
  Ok(())
}

///| Internal: format authority `host:port` or `[ipv6]:port` for CONNECT / Host.
fn format_authority_with_port(host : String, port : Int) -> Result[String, ProxyError] {
  let b = host.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(ProxyError::InvalidHost("empty CONNECT host"))
  }
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return Err(ProxyError::CrlfInjection("CRLF/NUL in CONNECT host"))
    }
    if c <= 32 || c == 127 {
      return Err(ProxyError::InvalidHost("whitespace or control char in host"))
    }
    i = i + 1
  }
  // Handle bracketed or bare IPv6
  let mut clean = host
  if b[0].to_int() == 91 {
    if b[n - 1].to_int() != 93 || n < 4 {
      return Err(ProxyError::InvalidHost("malformed bracketed IPv6 host"))
    }
    clean = b.slice(1, n - 1).to_string()
    match parse_ipv6_octets(clean) {
      Some(_) => ()
      None => return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
    return Ok("[" + ascii_to_lower(clean) + "]:" + port.to_string())
  }
  if host_is_ipv6(clean) {
    match parse_ipv6_octets(clean) {
      Some(_) => return Ok("[" + ascii_to_lower(clean) + "]:" + port.to_string())
      None => return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
  }
  if !validate_plain_host(clean) {
    return Err(ProxyError::InvalidHost("invalid characters in CONNECT host"))
  }
  Ok(clean + ":" + port.to_string())
}

///| Internal: parse `authority` (`host:port` or `[ipv6]:port`), returning unbracketed host + port.
fn parse_authority_host_port(
  authority : String,
  default_port : Option[Int],
) -> Result[(String, Int), ProxyError] {
  let b = authority.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(ProxyError::InvalidHost("empty authority"))
  }
  if b[0].to_int() == 91 {
    let mut close_br = -1
    let mut i = 1
    while i < n {
      if b[i].to_int() == 93 {
        close_br = i
        break
      }
      i = i + 1
    }
    if close_br < 0 || close_br == 1 {
      return Err(ProxyError::InvalidHost("malformed bracketed IPv6"))
    }
    let raw_v6 = b.slice(1, close_br).to_string()
    match parse_ipv6_octets(raw_v6) {
      Some(_) => ()
      None => return Err(ProxyError::InvalidHost("invalid IPv6 literal"))
    }
    let host = ascii_to_lower(raw_v6)
    let after = close_br + 1
    if after == n {
      match default_port {
        Some(dp) => return Ok((host, dp))
        None => return Err(ProxyError::InvalidPort("missing port in authority"))
      }
    }
    if b[after].to_int() != 58 {
      return Err(ProxyError::InvalidHost("unexpected character after ']'"))
    }
    match parse_port_strict(b.slice(after + 1, n).to_string()) {
      Some(p) => return Ok((host, p))
      None => return Err(ProxyError::InvalidPort("invalid port"))
    }
  }
  let mut colon = -1
  let mut colons = 0
  let mut j = 0
  while j < n {
    if b[j].to_int() == 58 {
      colon = j
      colons = colons + 1
    }
    j = j + 1
  }
  if colons > 1 {
    return Err(ProxyError::InvalidHost("unbracketed IPv6 in authority"))
  }
  if colon < 0 {
    if !validate_plain_host(authority) {
      return Err(ProxyError::InvalidHost("invalid host"))
    }
    match default_port {
      Some(dp) => return Ok((ascii_to_lower(authority), dp))
      None => return Err(ProxyError::InvalidPort("missing port in authority"))
    }
  }
  let raw_host = b.slice(0, colon).to_string()
  if !validate_plain_host(raw_host) {
    return Err(ProxyError::InvalidHost("invalid host"))
  }
  match parse_port_strict(b.slice(colon + 1, n).to_string()) {
    Some(p) => Ok((ascii_to_lower(raw_host), p))
    None => Err(ProxyError::InvalidPort("invalid port"))
  }
}

///| Internal: parse `Proxy-Authorization: Basic <b64>` header value.
fn parse_basic_proxy_auth(hv : String) -> Option[ProxyAuth] {
  let trimmed = trim_ascii_ws(hv)
  let b = trimmed.to_bytes()
  let n = b.length()
  if n < 7 {
    return None
  }
  let scheme = b.slice(0, 6).to_string()
  if !str_eq_lower_lit(scheme, "basic ") {
    return None
  }
  let token = trim_ascii_ws(b.slice(6, n).to_string())
  let decoded = match base64_decode(token) {
    Some(d) => d
    None => return None
  }
  let dn = decoded.length()
  let mut colon = -1
  let mut i = 0
  while i < dn {
    let c = decoded[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return None
    }
    if c == 58 && colon < 0 {
      colon = i
    }
    i = i + 1
  }
  if colon < 0 {
    return None
  }
  let user = decoded.slice(0, colon).to_string()
  let pass = decoded.slice(colon + 1, dn).to_string()
  Some(ProxyAuth::new(user, pass))
}

///| Internal: find `\r\n\r\n` end of HTTP header block while enforcing `max_header_bytes` and rejecting bare LF/NUL.
///| Returns `Ok(Some(end_offset))` (offset immediately after `\r\n\r\n`), `Ok(None)` if incomplete, or `Err`.
fn find_http_head_end(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[Option[Int], ProxyError] {
  let n = buf.length()
  let scan_limit = if n < limits.max_header_bytes {
    n
  } else {
    limits.max_header_bytes
  }
  let mut i = 0
  while i < scan_limit {
    let c = buf[i].to_int()
    if c == 0 {
      return Err(ProxyError::CrlfInjection("NUL byte in HTTP header block"))
    }
    if c == 10 {
      if i == 0 || buf[i - 1].to_int() != 13 {
        return Err(
          ProxyError::InvalidHttpSyntax("bare LF not allowed in HTTP headers"),
        )
      }
      if i >= 3 &&
      buf[i - 3].to_int() == 13 &&
      buf[i - 2].to_int() == 10 {
        return Ok(Some(i + 1))
      }
    }
    i = i + 1
  }
  if n > limits.max_header_bytes {
    return Err(
      ProxyError::LimitExceeded("HTTP header block exceeds max_header_bytes"),
    )
  }
  Ok(None)
}

///| Internal: parse HTTP header lines from `buf[start..head_end - 2]` (ending at the final `\r\n`).
fn parse_http_headers(
  buf : Bytes,
  start : Int,
  head_end : Int,
  limits : ProxyLimits,
) -> Result[Array[HttpHeader], ProxyError] {
  let headers : Array[HttpHeader] = []
  let mut pos = start
  let body_end = head_end - 2 // points to the final empty \r\n
  while pos < body_end {
    // Find \r\n
    let mut line_end = pos
    while line_end + 1 < head_end {
      if buf[line_end].to_int() == 13 {
        if buf[line_end + 1].to_int() != 10 {
          return Err(ProxyError::InvalidHttpSyntax("bare CR in header line"))
        }
        break
      }
      line_end = line_end + 1
    }
    let line_len = line_end - pos
    if line_len > limits.max_line_bytes {
      return Err(ProxyError::LimitExceeded("header line exceeds max_line_bytes"))
    }
    if line_len == 0 {
      break
    }
    // Reject obs-fold (leading SP or HTAB)
    let first = buf[pos].to_int()
    if first == 32 || first == 9 {
      return Err(ProxyError::SmugglingDetected("obs-fold header rejected"))
    }
    // Find ':'
    let mut colon = -1
    let mut j = pos
    while j < line_end {
      let c = buf[j].to_int()
      if c == 58 {
        colon = j
        break
      }
      if !is_http_tchar(c) {
        return Err(
          ProxyError::InvalidHeader(
            "invalid character or whitespace before ':' in header name",
          ),
        )
      }
      j = j + 1
    }
    if colon <= pos {
      return Err(ProxyError::InvalidHeader("missing ':' or empty header name"))
    }
    if headers.length() >= limits.max_headers {
      return Err(ProxyError::LimitExceeded("header count exceeds max_headers"))
    }
    let name = buf.slice(pos, colon).to_string()
    // Trim OWS (SP / HTAB) around value
    let mut vs = colon + 1
    let mut ve = line_end
    while vs < ve && (buf[vs].to_int() == 32 || buf[vs].to_int() == 9) {
      vs = vs + 1
    }
    while ve > vs && (buf[ve - 1].to_int() == 32 || buf[ve - 1].to_int() == 9) {
      ve = ve - 1
    }
    let mut k = vs
    while k < ve {
      let c = buf[k].to_int()
      if (c < 32 && c != 9) || c == 127 {
        return Err(ProxyError::InvalidHeader("control character in header value"))
      }
      k = k + 1
    }
    let value = buf.slice(vs, ve).to_string()
    headers.push(HttpHeader::new(name, value))
    pos = line_end + 2
  }
  Ok(headers)
}

///| Encode an HTTP `CONNECT` request with IPv6 bracketing, `Host`, optional `Proxy-Authorization: Basic`,
///| and strict CRLF/NUL/colon injection protection.
pub fn encode_connect_request(
  host : String,
  port : Int,
  auth : Option[ProxyAuth],
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  if port <= 0 || port > 65535 {
    return Err(ProxyError::InvalidPort("CONNECT port must be 1..65535"))
  }
  let authority = match format_authority_with_port(host, port) {
    Ok(a) => a
    Err(e) => return Err(e)
  }
  let auth_header : Option[String] = match auth {
    None => None
    Some(a) => {
      if has_crlf_or_nul(a.username) || has_crlf_or_nul(a.password) {
        return Err(
          ProxyError::CrlfInjection("CRLF/NUL in Proxy-Authorization credentials"),
        )
      }
      // RFC 7617: Basic username MUST NOT contain ':'
      let ub = a.username.to_bytes()
      let mut ui = 0
      while ui < ub.length() {
        if ub[ui].to_int() == 58 {
          return Err(
            ProxyError::InvalidCredentials(
              "Basic auth username must not contain ':'",
            ),
          )
        }
        ui = ui + 1
      }
      let joined = (a.username + ":" + a.password).to_bytes()
      Some("Basic " + base64_encode(joined))
    }
  }
  let mut hi = 0
  while hi < extra_headers.length() {
    match validate_http_header_name(extra_headers[hi].name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_http_header_value(extra_headers[hi].value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if str_eq_lower_lit(extra_headers[hi].name, "host") ||
    str_eq_lower_lit(extra_headers[hi].name, "proxy-authorization") {
      return Err(
        ProxyError::InvalidHeader(
          "extra_headers must not duplicate Host or Proxy-Authorization",
        ),
      )
    }
    hi = hi + 1
  }

  let sb = StringBuilder::new()
  sb.write_string("CONNECT ")
  sb.write_string(authority)
  sb.write_string(" HTTP/1.1\r\nHost: ")
  sb.write_string(authority)
  sb.write_string("\r\n")
  match auth_header {
    Some(v) => {
      sb.write_string("Proxy-Authorization: ")
      sb.write_string(v)
      sb.write_string("\r\n")
    }
    None => ()
  }
  let mut ei = 0
  while ei < extra_headers.length() {
    sb.write_string(extra_headers[ei].name)
    sb.write_string(": ")
    sb.write_string(extra_headers[ei].value)
    sb.write_string("\r\n")
    ei = ei + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}

///| Streaming decode of an HTTP `CONNECT` request (proxy bridge server side).
pub fn decode_connect_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectRequest], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  // Parse request line
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in request line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("request line exceeds max_line_bytes"))
  }
  // Split into 3 SP-separated parts: CONNECT <authority> <version>
  let mut sp1 = -1
  let mut sp2 = -1
  let mut i = 0
  while i < line_end {
    if buf[i].to_int() == 32 {
      if sp1 < 0 {
        sp1 = i
      } else if sp2 < 0 {
        sp2 = i
      } else {
        return Err(
          ProxyError::InvalidHttpSyntax("extra space in CONNECT request line"),
        )
      }
    }
    i = i + 1
  }
  if sp1 <= 0 || sp2 <= sp1 + 1 || sp2 + 1 >= line_end {
    return Err(ProxyError::InvalidHttpSyntax("malformed CONNECT request line"))
  }
  let method = buf.slice(0, sp1).to_string()
  if method != "CONNECT" {
    return Err(ProxyError::InvalidHttpSyntax("expected CONNECT method"))
  }
  let authority = buf.slice(sp1 + 1, sp2).to_string()
  let version = buf.slice(sp2 + 1, line_end).to_string()
  if version != "HTTP/1.1" && version != "HTTP/1.0" {
    return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }
  let (host, port) = match parse_authority_host_port(authority, None) {
    Ok(hp) => hp
    Err(e) => return Err(e)
  }
  let headers = match parse_http_headers(buf, line_end + 2, head_end, limits) {
    Ok(hs) => hs
    Err(e) => return Err(e)
  }
  let mut auth : Option[ProxyAuth] = None
  let mut seen_proxy_auth = false
  let mut hi = 0
  while hi < headers.length() {
    if str_eq_lower_lit(headers[hi].name, "proxy-authorization") {
      if seen_proxy_auth {
        return Err(
          ProxyError::InvalidHeader("duplicate Proxy-Authorization header"),
        )
      }
      seen_proxy_auth = true
      auth = parse_basic_proxy_auth(headers[hi].value)
    }
    hi = hi + 1
  }
  Ok(
    DecodeStatus::Complete(
      HttpConnectRequest::{
        host: host,
        port: port,
        version: version,
        auth: auth,
        headers: headers,
      },
      head_end,
    ),
  )
}

///| Encode an HTTP `CONNECT` response (proxy bridge server side).
pub fn encode_connect_response(
  status : Int,
  reason : String,
  extra_headers : Array[HttpHeader],
) -> Result[Bytes, ProxyError] {
  if status < 100 || status > 999 {
    return Err(ProxyError::InvalidHttpSyntax("HTTP status must be 100..999"))
  }
  if has_crlf_or_nul(reason) {
    return Err(ProxyError::CrlfInjection("CRLF/NUL in reason phrase"))
  }
  let mut hi = 0
  while hi < extra_headers.length() {
    match validate_http_header_name(extra_headers[hi].name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_http_header_value(extra_headers[hi].value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    hi = hi + 1
  }
  let sb = StringBuilder::new()
  sb.write_string("HTTP/1.1 ")
  sb.write_string(status.to_string())
  if reason.length() > 0 {
    sb.write_string(" ")
    sb.write_string(reason)
  }
  sb.write_string("\r\n")
  let mut ei = 0
  while ei < extra_headers.length() {
    sb.write_string(extra_headers[ei].name)
    sb.write_string(": ")
    sb.write_string(extra_headers[ei].value)
    sb.write_string("\r\n")
    ei = ei + 1
  }
  sb.write_string("\r\n")
  Ok(sb.to_string().to_bytes())
}

///| Streaming decode of an HTTP `CONNECT` response (proxy client side).
///| Preserves `407 Proxy Authentication Required` and `Proxy-Authenticate` structurally,
///| and returns exact `consumed` so pipelined TLS ClientHello bytes are never lost.
pub fn decode_connect_response(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[HttpConnectResponse], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in status line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("status line exceeds max_line_bytes"))
  }
  // Format: HTTP/1.x <3-digit-status>[ <reason>]
  if line_end < 12 || buf[8].to_int() != 32 {
    return Err(ProxyError::InvalidHttpSyntax("malformed HTTP status line"))
  }
  let version = buf.slice(0, 8).to_string()
  if version != "HTTP/1.1" && version != "HTTP/1.0" {
    return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }
  let d0 = buf[9].to_int()
  let d1 = buf[10].to_int()
  let d2 = buf[11].to_int()
  if d0 < 48 || d0 > 57 || d1 < 48 || d1 > 57 || d2 < 48 || d2 > 57 {
    return Err(ProxyError::InvalidHttpSyntax("non-numeric HTTP status code"))
  }
  let status = (d0 - 48) * 100 + (d1 - 48) * 10 + (d2 - 48)
  let mut reason = ""
  if line_end > 12 {
    if buf[12].to_int() != 32 {
      return Err(ProxyError::InvalidHttpSyntax("missing space after status code"))
    }
    reason = buf.slice(13, line_end).to_string()
  }
  let headers = match parse_http_headers(buf, line_end + 2, head_end, limits) {
    Ok(hs) => hs
    Err(e) => return Err(e)
  }
  let mut proxy_auth_chal : Option[String] = None
  let mut hi = 0
  while hi < headers.length() {
    if str_eq_lower_lit(headers[hi].name, "proxy-authenticate") {
      proxy_auth_chal = Some(headers[hi].value)
    }
    hi = hi + 1
  }
  Ok(
    DecodeStatus::Complete(
      HttpConnectResponse::{
        version: version,
        status: status,
        reason: reason,
        proxy_authenticate: proxy_auth_chal,
        headers: headers,
      },
      head_end,
    ),
  )
}

///| Internal: check whether a header name is a static RFC 9110 §7.6.1 hop-by-hop header.
fn is_static_hop_by_hop(name : String) -> Bool {
  str_eq_lower_lit(name, "connection") ||
  str_eq_lower_lit(name, "proxy-connection") ||
  str_eq_lower_lit(name, "proxy-authorization") ||
  str_eq_lower_lit(name, "proxy-authenticate") ||
  str_eq_lower_lit(name, "keep-alive") ||
  str_eq_lower_lit(name, "te") ||
  str_eq_lower_lit(name, "trailer") ||
  str_eq_lower_lit(name, "upgrade")
}

///| Internal: append comma-separated header names from a `Connection` header value (lowercased).
fn collect_connection_tokens(hv : String, out : Array[String]) -> Unit {
  let b = hv.to_bytes()
  let n = b.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || b[i].to_int() == 44 {
      let tok = ascii_to_lower(trim_ascii_ws(b.slice(start, i).to_string()))
      if tok.length() > 0 {
        out.push(tok)
      }
      start = i + 1
    }
    i = i + 1
  }
}

///| Internal: check whether `name` (case-insensitive) appears in `nominated_lower`.
fn is_nominated_hop(name : String, nominated_lower : Array[String]) -> Bool {
  let mut i = 0
  while i < nominated_lower.length() {
    if str_eq_lower_lit(name, nominated_lower[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal: parse comma-separated `Content-Length` values and check against previous value.
fn parse_and_check_content_length(
  hv : String,
  prev : Option[Int64],
) -> Result[Int64, ProxyError] {
  let b = hv.to_bytes()
  let n = b.length()
  let mut current = prev
  let mut start = 0
  let mut i = 0
  let mut count = 0
  while i <= n {
    if i == n || b[i].to_int() == 44 {
      let item = trim_ascii_ws(b.slice(start, i).to_string())
      let parsed = match parse_u64_strict(item) {
        Some(v) => v
        None =>
        return Err(
          ProxyError::SmugglingDetected("invalid Content-Length value"),
        )
      }
      match current {
        Some(existing) =>
        if existing != parsed {
          return Err(
            ProxyError::SmugglingDetected("conflicting Content-Length headers"),
          )
        }
        None => current = Some(parsed)
      }
      count = count + 1
      start = i + 1
    }
    i = i + 1
  }
  if count == 0 {
    return Err(ProxyError::SmugglingDetected("empty Content-Length header"))
  }
  match current {
    Some(v) => Ok(v)
    None => Err(ProxyError::SmugglingDetected("empty Content-Length header"))
  }
}

///| Internal: validate `Transfer-Encoding` value for forward requests (RFC 9112 §6.3).
fn validate_transfer_encoding(
  hv : String,
  version : String,
  already_chunked : Bool,
) -> Result[Bool, ProxyError] {
  if version == "HTTP/1.0" {
    return Err(
      ProxyError::SmugglingDetected("Transfer-Encoding not allowed in HTTP/1.0"),
    )
  }
  let b = hv.to_bytes()
  let n = b.length()
  let mut saw_chunked = already_chunked
  let mut start = 0
  let mut i = 0
  let mut count = 0
  while i <= n {
    if i == n || b[i].to_int() == 44 {
      let tok = ascii_to_lower(trim_ascii_ws(b.slice(start, i).to_string()))
      if tok.length() == 0 {
        return Err(
          ProxyError::SmugglingDetected("empty Transfer-Encoding coding"),
        )
      }
      if saw_chunked {
        return Err(
          ProxyError::SmugglingDetected(
            "chunked must be the final Transfer-Encoding",
          ),
        )
      }
      if tok == "chunked" {
        saw_chunked = true
      } else if tok != "gzip" && tok != "deflate" && tok != "compress" {
        return Err(
          ProxyError::SmugglingDetected("unknown Transfer-Encoding coding"),
        )
      }
      count = count + 1
      start = i + 1
    }
    i = i + 1
  }
  if count == 0 {
    return Err(ProxyError::SmugglingDetected("empty Transfer-Encoding header"))
  }
  Ok(saw_chunked)
}

///| Parse a plaintext HTTP forward-proxy request, rewrite absolute-form to origin-form,
///| enforce anti-smuggling checks, strip all RFC 9110 §7.6.1 hop-by-hop + `Connection`-nominated headers,
///| and return the sanitized upstream request head.
pub fn parse_and_sanitize_forward_request(
  buf : Bytes,
  limits : ProxyLimits,
) -> Result[DecodeStatus[SanitizedForwardRequest], ProxyError] {
  let head_end = match find_http_head_end(buf, limits) {
    Ok(Some(end)) => end
    Ok(None) => return Ok(DecodeStatus::NeedMore(1))
    Err(e) => return Err(e)
  }
  let mut line_end = 0
  while line_end + 1 < head_end {
    if buf[line_end].to_int() == 13 {
      if buf[line_end + 1].to_int() != 10 {
        return Err(ProxyError::InvalidHttpSyntax("bare CR in request line"))
      }
      break
    }
    line_end = line_end + 1
  }
  if line_end > limits.max_line_bytes {
    return Err(ProxyError::LimitExceeded("request line exceeds max_line_bytes"))
  }
  let mut sp1 = -1
  let mut sp2 = -1
  let mut i = 0
  while i < line_end {
    if buf[i].to_int() == 32 {
      if sp1 < 0 {
        sp1 = i
      } else if sp2 < 0 {
        sp2 = i
      } else {
        return Err(ProxyError::InvalidHttpSyntax("extra space in request line"))
      }
    }
    i = i + 1
  }
  if sp1 <= 0 || sp2 <= sp1 + 1 || sp2 + 1 >= line_end {
    return Err(ProxyError::InvalidHttpSyntax("malformed HTTP request line"))
  }
  let method = buf.slice(0, sp1).to_string()
  let mb = method.to_bytes()
  let mut mi = 0
  while mi < mb.length() {
    if !is_http_tchar(mb[mi].to_int()) {
      return Err(ProxyError::InvalidHttpSyntax("invalid HTTP method token"))
    }
    mi = mi + 1
  }
  let mut ti = sp1 + 1
  while ti < sp2 {
    let tc = buf[ti].to_int()
    if tc < 33 || tc == 127 || tc == 35 {
      return Err(
        ProxyError::InvalidHttpSyntax(
          "invalid control, whitespace, or fragment byte in request-target",
        ),
      )
    }
    ti = ti + 1
  }
  let target = buf.slice(sp1 + 1, sp2).to_string()
  let version = buf.slice(sp2 + 1, line_end).to_string()
  if version != "HTTP/1.1" && version != "HTTP/1.0" {
    return Err(ProxyError::InvalidHttpSyntax("unsupported HTTP version"))
  }

  let raw_headers = match parse_http_headers(buf, line_end + 2, head_end, limits) {
    Ok(hs) => hs
    Err(e) => return Err(e)
  }

  // Parse target: absolute-form `http://authority[/path[?query]]` or origin-form `/...`
  let tb = target.to_bytes()
  let tn = tb.length()
  let mut target_host = ""
  let mut target_port = 80
  let mut origin_path = "/"

  if tn >= 7 && str_eq_lower_lit(tb.slice(0, 7).to_string(), "http://") {
    let mut path_start = tn
    let mut p = 7
    while p < tn {
      let c = tb[p].to_int()
      if c == 47 || c == 63 {
        path_start = p
        break
      }
      if c == 35 {
        return Err(
          ProxyError::InvalidHttpSyntax("fragment not allowed in request-target"),
        )
      }
      p = p + 1
    }
    let authority = tb.slice(7, path_start).to_string()
    let (h, pt) = match parse_authority_host_port(authority, Some(80)) {
      Ok(hp) => hp
      Err(e) => return Err(e)
    }
    target_host = h
    target_port = pt
    if path_start < tn {
      if tb[path_start].to_int() == 63 {
        origin_path = "/" + tb.slice(path_start, tn).to_string()
      } else {
        origin_path = tb.slice(path_start, tn).to_string()
      }
    } else {
      origin_path = "/"
    }
  } else if tn >= 1 && tb[0].to_int() == 47 {
    origin_path = target
    // Derive target_host/target_port from Host header
    let mut found_host : Option[String] = None
    let mut hi = 0
    while hi < raw_headers.length() {
      if str_eq_lower_lit(raw_headers[hi].name, "host") {
        match found_host {
          Some(_) =>
          return Err(ProxyError::SmugglingDetected("duplicate Host header"))
          None => found_host = Some(raw_headers[hi].value)
        }
      }
      hi = hi + 1
    }
    match found_host {
      Some(hv) => {
        let (h, pt) = match parse_authority_host_port(hv, Some(80)) {
          Ok(hp) => hp
          Err(e) => return Err(e)
        }
        target_host = h
        target_port = pt
      }
      None =>
      return Err(
        ProxyError::InvalidHttpSyntax("missing Host header in origin-form"),
      )
    }
  } else {
    return Err(
      ProxyError::InvalidHttpSyntax(
        "forward proxy requires http:// absolute-form or origin-form target",
      ),
    )
  }

  // First pass over headers: collect Connection nominations, extract Proxy-Authorization,
  // and validate framing (Content-Length / Transfer-Encoding anti-smuggling).
  let nominated_hops : Array[String] = []
  let mut proxy_auth : Option[ProxyAuth] = None
  let mut seen_proxy_auth = false
  let mut content_length : Option[Int64] = None
  let mut has_te = false
  let mut is_chunked = false

  let mut hi = 0
  while hi < raw_headers.length() {
    let h = raw_headers[hi]
    if str_eq_lower_lit(h.name, "connection") {
      collect_connection_tokens(h.value, nominated_hops)
    } else if str_eq_lower_lit(h.name, "proxy-authorization") {
      if seen_proxy_auth {
        return Err(
          ProxyError::InvalidHeader("duplicate Proxy-Authorization header"),
        )
      }
      seen_proxy_auth = true
      proxy_auth = parse_basic_proxy_auth(h.value)
    } else if str_eq_lower_lit(h.name, "content-length") {
      if has_te {
        return Err(
          ProxyError::SmugglingDetected(
            "both Transfer-Encoding and Content-Length present",
          ),
        )
      }
      match parse_and_check_content_length(h.value, content_length) {
        Ok(v) => content_length = Some(v)
        Err(e) => return Err(e)
      }
    } else if str_eq_lower_lit(h.name, "transfer-encoding") {
      match content_length {
        Some(_) =>
        return Err(
          ProxyError::SmugglingDetected(
            "both Transfer-Encoding and Content-Length present",
          ),
        )
        None => ()
      }
      match validate_transfer_encoding(h.value, version, is_chunked) {
        Ok(ch) => {
          has_te = true
          is_chunked = ch
        }
        Err(e) => return Err(e)
      }
    }
    hi = hi + 1
  }
  if has_te && !is_chunked {
    return Err(
      ProxyError::SmugglingDetected(
        "request Transfer-Encoding must end with chunked",
      ),
    )
  }

  // Build canonical Host header value
  let canonical_host = if host_is_ipv6(target_host) {
    if target_port == 80 {
      "[" + target_host + "]"
    } else {
      "[" + target_host + "]:" + target_port.to_string()
    }
  } else if target_port == 80 {
    target_host
  } else {
    target_host + ":" + target_port.to_string()
  }

  // Second pass: emit canonical Host + sanitized end-to-end headers
  let sanitized : Array[HttpHeader] = []
  sanitized.push(HttpHeader::new("Host", canonical_host))
  let mut emitted_cl = false
  let mut si = 0
  while si < raw_headers.length() {
    let h = raw_headers[si]
    let is_framing = str_eq_lower_lit(h.name, "content-length") ||
    str_eq_lower_lit(h.name, "transfer-encoding")
    if str_eq_lower_lit(h.name, "host") ||
    is_static_hop_by_hop(h.name) ||
    (!is_framing && is_nominated_hop(h.name, nominated_hops)) {
      si = si + 1
      continue
    }
    if str_eq_lower_lit(h.name, "content-length") {
      if !emitted_cl {
        match content_length {
          Some(clv) => {
            sanitized.push(HttpHeader::new("Content-Length", clv.to_string()))
            emitted_cl = true
          }
          None => ()
        }
      }
      si = si + 1
      continue
    }
    sanitized.push(h)
    si = si + 1
  }

  // Re-encode sanitized upstream request head
  let sb = StringBuilder::new()
  sb.write_string(method)
  sb.write_string(" ")
  sb.write_string(origin_path)
  sb.write_string(" ")
  sb.write_string(version)
  sb.write_string("\r\n")
  let mut wi = 0
  while wi < sanitized.length() {
    sb.write_string(sanitized[wi].name)
    sb.write_string(": ")
    sb.write_string(sanitized[wi].value)
    sb.write_string("\r\n")
    wi = wi + 1
  }
  sb.write_string("\r\n")
  let wire_head = sb.to_string().to_bytes()

  Ok(
    DecodeStatus::Complete(
      SanitizedForwardRequest::{
        method: method,
        target_host: target_host,
        target_port: target_port,
        origin_path: origin_path,
        version: version,
        headers: sanitized,
        wire_head: wire_head,
        content_length: content_length,
        is_chunked: is_chunked,
        proxy_auth: proxy_auth,
      },
      head_end,
    ),
  )
}
