///| Red-team audit of `packages/proxy` v0.1.0 (Wave 18 RT-proxy), baseline `feat/pkg-proxy` @ d4fb097.
///|
///| Every `p0_*` / `p1_*` / `p2_*` test asserts what the references require (RFC 1928 / 1929 /
///| 9110 / 9112, Go `golang.org/x/net/http/httpproxy`) and
///| therefore FAILS on the audited baseline: the failure is the evidence. Every assertion accepts
///| any reasonable fix (reject the input, or produce the safe result). Every `control_*` test pins
///| an attack the package already defeats and must keep passing. See REPORT.md.

import "proxy"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn contains(h : String, n : String) -> Bool {
  let hb = h.to_bytes()
  let nb = n.to_bytes()
  if nb.length() == 0 {
    return true
  }
  let mut i = 0
  while i + nb.length() <= hb.length() {
    let mut j = 0
    while j < nb.length() && hb[i + j] == nb[j] {
      j = j + 1
    }
    if j == nb.length() {
      return true
    }
    i = i + 1
  }
  false
}

///| ASCII-lowercase copy.
fn lower(s : String) -> String {
  let b = s.to_bytes()
  let out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    out[i] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn bs(vals : Array[Int]) -> Bytes {
  let out = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    out[i] = vals[i].to_byte()
    i = i + 1
  }
  out
}

///|
fn cat(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn has_ctl(s : String) -> Bool {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c < 32 || c == 127 {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn lim() -> proxy::ProxyLimits {
  proxy::ProxyLimits::default()
}

///| Fails the enclosing test with every collected violation.
fn verdict(f : Array[String]) -> Unit {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < f.length() {
    sb.write_string(" | ")
    sb.write_string(f[i])
    i = i + 1
  }
  debug_assert(
    f.length() == 0,
    f.length().to_string() + " violation(s):" + sb.to_string(),
  )
}

///| Forward-proxy parse of a whole request; None on Err or NeedMore.
fn fwd(raw : String) -> Option[proxy::SanitizedForwardRequest] {
  match proxy::parse_and_sanitize_forward_request(raw.to_bytes(), lim()) {
    Ok(proxy::DecodeStatus::Complete(r, _)) => Some(r)
    _ => None
  }
}

///| Wire framing must agree with the framing the parser reports to its caller.
fn framing_consistent(r : proxy::SanitizedForwardRequest) -> String {
  let w = lower(r.wire_head.to_string())
  let wire_cl = contains(w, "\r\ncontent-length:")
  let wire_te = contains(w, "\r\ntransfer-encoding:") && contains(w, "chunked")
  let mut msg = ""
  match r.content_length {
    Some(v) =>
    if !wire_cl {
      msg = msg +
      "parser reports content_length=" +
      v.to_string() +
      " but wire_head has no Content-Length; "
    }
    None => ()
  }
  if r.is_chunked && !wire_te {
    msg = msg + "parser reports is_chunked but wire_head has no Transfer-Encoding: chunked; "
  }
  msg
}

// ---------------------------------------------------------------------------
// P0: request smuggling through Connection-nominated framing headers
// ---------------------------------------------------------------------------

///| `Connection: Content-Length` makes the sanitizer drop `Content-Length` from `wire_head`
///| (src/http_proxy.pion:994-999 runs `is_nominated_hop` before the framing branch at :1000)
///| while still returning `content_length = Some(n)`. The caller forwards n body bytes after a
///| head with no framing: the upstream treats the body as the next request (CL.0 desync).
test "p0_connection_nominated_content_length_stripped_body_desync" {
  let f : Array[String] = []
  let reqs = [
    "POST http://victim.example/upload HTTP/1.1\r\nConnection: Content-Length\r\nContent-Length: 40\r\n\r\n",
    "POST /upload HTTP/1.1\r\nHost: victim.example\r\nContent-Length: 40\r\nConnection: keep-alive, CONTENT-length\r\n\r\n",
    "POST http://victim.example/ HTTP/1.0\r\nContent-Length: 7\r\nConnection: close\r\nConnection: content-length\r\n\r\n",
  ]
  let mut i = 0
  while i < reqs.length() {
    match fwd(reqs[i]) {
      Some(r) => {
        let m = framing_consistent(r)
        if m.length() > 0 {
          f.push("req#" + i.to_string() + ": " + m)
        }
      }
      None => ()
    }
    i = i + 1
  }
  verdict(f)
}

///| Same flaw with `Connection: Transfer-Encoding`: `is_chunked = true` is returned but the
///| `Transfer-Encoding: chunked` line is stripped, so the chunked body is parsed upstream as a
///| new request (TE.0 desync).
test "p0_connection_nominated_transfer_encoding_stripped_body_desync" {
  let f : Array[String] = []
  let reqs = [
    "POST http://victim.example/ HTTP/1.1\r\nConnection: Transfer-Encoding\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST /x HTTP/1.1\r\nHost: victim.example\r\nTransfer-Encoding: gzip, chunked\r\nConnection: transfer-ENCODING, close\r\n\r\n",
  ]
  let mut i = 0
  while i < reqs.length() {
    match fwd(reqs[i]) {
      Some(r) => {
        let m = framing_consistent(r)
        if m.length() > 0 {
          f.push("req#" + i.to_string() + ": " + m)
        }
      }
      None => ()
    }
    i = i + 1
  }
  verdict(f)
}

// ---------------------------------------------------------------------------
// P1: credential leaks
// ---------------------------------------------------------------------------

///| `parse_proxy_url` takes everything before the FIRST `://` as the scheme and echoes it in
///| `UnsupportedScheme` (src/proxy_url.pion:158-172). A scheme-less proxy value such as
///| `alice:hunter2@proxy:8080` (accepted by curl and by reference `withScheme` helpers) whose path
///| or query contains a URL puts the username and password into the error message.
test "p1_unsupported_scheme_error_echoes_userinfo" {
  let f : Array[String] = []
  let raws = [
    "alice:hunter2@proxy.example:8080/?next=http://intranet",
    "alice:hunter2@proxy.example:8080/http://x",
    "alice:hunter2@proxy.example:3128#ssh://x",
  ]
  let mut i = 0
  while i < raws.length() {
    match proxy::parse_proxy_url(raws[i]) {
      Ok(_) => ()
      Err(e) => {
        let m = e.message()
        if contains(m, "hunter2") || contains(m, "alice") {
          f.push("error leaks userinfo: " + m)
        }
      }
    }
    i = i + 1
  }
  verdict(f)
}

///| With a username and no password, `redacted()` prints the username verbatim
///| (src/proxy_url.pion:413-420). Proxy providers and token proxies put the secret in the
///| username (`http://<token>@proxy`); standard proxy URL redaction prints `***@` whenever
///| a username is present for http/https/socks5/socks5h (ssh user names are not secrets).
///| Note: proxy_url_test.pion:166 pins the leaky output and must be updated by the fix.
test "p1_redacted_echoes_username_only_userinfo" {
  let f : Array[String] = []
  let raws = [
    "http://ghp_tok3nSECRET@proxy.example:8080",
    "https://tok3nSECRET@proxy.example",
    "socks5://tok3nSECRET@127.0.0.1:1080",
    "socks5h://tok3nSECRET@127.0.0.1:9050",
  ]
  let mut i = 0
  while i < raws.length() {
    match proxy::parse_proxy_url(raws[i]) {
      Ok(u) => {
        if contains(u.redacted(), "tok3nSECRET") ||
        contains(u.to_safe_string(), "tok3nSECRET") {
          f.push(raws[i] + " -> " + u.redacted())
        }
      }
      Err(_) => ()
    }
    i = i + 1
  }
  verdict(f)
}

// ---------------------------------------------------------------------------
// P2
// ---------------------------------------------------------------------------

///| ssh user names are shown by design, but unescaped (src/proxy_url.pion:415-418): a decoded
///| `@ : #` or an ESC byte (`has_crlf_or_nul` only checks CR/LF/NUL) lets the "safe" log string
///| name another host or inject terminal escapes. Standard URL redaction uses `encodeURIComponent`.
test "p2_redacted_ssh_username_unescaped_log_spoofing" {
  let f : Array[String] = []
  match proxy::parse_proxy_url("ssh://admin%40evil.example%3A22%23@good.example") {
    Ok(u) => {
      let r = u.redacted()
      match proxy::parse_proxy_url(r) {
        Ok(v) =>
        if v.host != "good.example" {
          f.push("redacted '" + r + "' re-parses to host " + v.host)
        }
        Err(_) => f.push("redacted '" + r + "' is not a parseable URL")
      }
    }
    Err(_) => ()
  }
  match proxy::parse_proxy_url("ssh://x%1B%5B2J%1B%5D0%3Bpwned%07@good.example") {
    Ok(u) =>
    if has_ctl(u.redacted()) {
      f.push("redacted contains control bytes (ESC/BEL)")
    }
    Err(_) => ()
  }
  match proxy::parse_proxy_url("http://u%09ser%1B:pw@good.example") {
    Ok(u) =>
    match u.auth() {
      Some(a) =>
      if has_ctl(a.username) {
        f.push("C0 control bytes accepted in decoded username")
      }
      None => ()
    }
    Err(_) => ()
  }
  verdict(f)
}

///| `\` is not a valid userinfo/host character (RFC 3986) and is a path separator for WHATWG
///| special schemes. WHATWG `new URL` connects to `evil.example` with user `u`/`p`;
///| this parser connects to `good.example` with password `p@evil.example\`. Reject or agree.
test "p2_backslash_userinfo_parser_differential" {
  let f : Array[String] = []
  match proxy::parse_proxy_url("http://u:p@evil.example\\@good.example:8080") {
    Ok(u) =>
    if u.host != "evil.example" {
      f.push("host=" + u.host + " (WHATWG `new URL`: evil.example)")
    }
    Err(_) => ()
  }
  verdict(f)
}

///| `validate_plain_host` (src/proxy_url.pion:101-124) accepts `%`, `\`, `<`, `>`, `^`, `|`,
///| which WHATWG forbids in hosts; `%6d` is kept literally instead of decoding to `m`.
test "p2_proxy_host_accepts_non_rfc3986_characters" {
  let f : Array[String] = []
  match proxy::parse_proxy_url("http://exa%6dple.com:8080") {
    Ok(u) =>
    if u.host != "example.com" {
      f.push("host kept percent-encoded: " + u.host)
    }
    Err(_) => ()
  }
  let bad = [
    "http://a\\b.example:8080", "http://a<b.example:8080", "http://a>b.example:8080",
    "http://a^b.example:8080", "http://a|b.example:8080",
  ]
  let mut i = 0
  while i < bad.length() {
    match proxy::parse_proxy_url(bad[i]) {
      Ok(u) => f.push("accepted host " + u.host)
      Err(_) => ()
    }
    i = i + 1
  }
  verdict(f)
}

///| IPv4 / IPv4-CIDR rules never match the IPv4-mapped IPv6 form of the same address
///| (src/proxy_url.pion:735-758). Go `x/net/http/httpproxy` (net.IPNet.Contains unmaps) does.
test "p2_no_proxy_ipv4_mapped_ipv6_not_matched" {
  let f : Array[String] = []
  let m = proxy::NoProxyMatcher::parse("10.0.0.0/8, 192.168.7.9")
  let targets = ["::ffff:10.1.2.3", "[::ffff:10.1.2.3]", "::ffff:192.168.7.9", "::FFFF:a01:203"]
  let mut i = 0
  while i < targets.length() {
    if !m.matches(targets[i], 443) {
      f.push(targets[i] + " not matched")
    }
    i = i + 1
  }
  verdict(f)
}

///| `*.example.com` is silently compiled to a domain rule that can never match.
///| Go `x/net/http/httpproxy` treats a leading `*.` as `.` (subdomains).
test "p2_no_proxy_star_dot_wildcard_ignored" {
  let m = proxy::NoProxyMatcher::parse("*.corp.example")
  debug_assert(
    m.matches("api.corp.example", 443) && !m.matches("evilcorp.example", 443),
    "*.corp.example must match api.corp.example (and not evilcorp.example)",
  )
}

///| `Unassigned(v)` / `Other(v)` are encoded with a truncating `to_byte()` (src/types.pion:69,
///| src/socks5.pion:19): `Unassigned(0)` and `Unassigned(256)` go on the wire as REP=0x00
///| (Succeeded); `Other(256)` as METHOD=0x00 (NoAuth), `Other(-1)` as 0xFF.
test "p2_socks_unassigned_codes_alias_success_and_noauth" {
  let f : Array[String] = []
  let codes = [0, 256, 0x105]
  let mut i = 0
  while i < codes.length() {
    match proxy::socks5_encode_reply(
      proxy::SocksReplyCode::Unassigned(codes[i]),
      proxy::SocksAddr::Ipv4(bs([0, 0, 0, 0])),
      0,
    ) {
      Ok(w) =>
      if w[1].to_int() <= 8 {
        f.push(
          "Unassigned(" +
          codes[i].to_string() +
          ") encoded as REP=" +
          w[1].to_int().to_string(),
        )
      }
      Err(_) => ()
    }
    i = i + 1
  }
  let ms = [256, 258, -1]
  let mut j = 0
  while j < ms.length() {
    match proxy::socks5_encode_greeting([proxy::SocksAuthMethod::Other(ms[j])]) {
      Ok(w) => {
        let v = w[2].to_int()
        if v == 0 || v == 2 || v == 0xFF {
          f.push(
            "Other(" + ms[j].to_string() + ") encoded as METHOD=" + v.to_string(),
          )
        }
      }
      Err(_) => ()
    }
    j = j + 1
  }
  verdict(f)
}

///| A failure reply whose BND.ADDR is junk (servers commonly send ATYP=0 on errors) yields
///| `InvalidAddressType(0)`: the real cause (REP=5 connection refused) is lost. Standard SOCKS5 parsers
///| check REP before parsing BND.ADDR.
test "p2_socks_failure_reply_code_lost" {
  match proxy::socks5_decode_reply(bs([5, 5, 0, 0, 0, 0, 0, 0, 0, 0])) {
    Err(proxy::ProxyError::SocksFailure(c)) =>
    debug_assert(c.to_byte().to_int() == 5, "wrong failure code")
    Ok(proxy::DecodeStatus::Complete(r, _)) =>
    debug_assert(r.reply.to_byte().to_int() == 5, "wrong failure code")
    Ok(proxy::DecodeStatus::NeedMore(_)) => ()
    Err(e) => debug_assert(false, "REP=5 lost, got: " + e.message())
  }
}

///| The forward-proxy request-target is copied to the upstream request line unvalidated
///| (src/http_proxy.pion:832, 873-884): HTAB / C0 / DEL bytes (RFC 9112 §3.2 forbids them;
///| many servers split the request line on HTAB) and `#fragment` in the path pass through.
test "p2_forward_request_target_ctl_and_fragment_passthrough" {
  let f : Array[String] = []
  let reqs = [
    "GET /a\tb HTTP/1.1\r\nHost: x.example\r\n\r\n", "GET /a\u{0001}b HTTP/1.1\r\nHost: x.example\r\n\r\n",
    "GET /a\u{007f}b HTTP/1.1\r\nHost: x.example\r\n\r\n", "GET http://x.example/a\u{000b}b HTTP/1.1\r\n\r\n",
  ]
  let mut i = 0
  while i < reqs.length() {
    match fwd(reqs[i]) {
      Some(r) =>
      if has_ctl(r.origin_path) {
        f.push("req#" + i.to_string() + " CTL forwarded in request-target")
      }
      None => ()
    }
    i = i + 1
  }
  match fwd("GET http://x.example/a#frag HTTP/1.1\r\n\r\n") {
    Some(r) =>
    if contains(r.origin_path, "#") {
      f.push("fragment forwarded: " + r.origin_path)
    }
    None => ()
  }
  verdict(f)
}

///| `DecodeStatus::NeedMore(Int)` is documented as the minimum number of bytes still needed;
///| all three HTTP decoders return `NeedMore(0)` (src/http_proxy.pion:450, 580, 789), which
///| a `read_exact(need)` loop turns into a busy spin.
test "p2_http_decoders_need_more_zero" {
  let f : Array[String] = []
  match proxy::decode_connect_response("HTTP/1.1 200 OK\r\n".to_bytes(), lim()) {
    Ok(proxy::DecodeStatus::NeedMore(k)) =>
    if k < 1 {
      f.push("decode_connect_response NeedMore(" + k.to_string() + ")")
    }
    _ => ()
  }
  match proxy::decode_connect_request("CONNECT a:1 HTTP/1.1\r\n".to_bytes(), lim()) {
    Ok(proxy::DecodeStatus::NeedMore(k)) =>
    if k < 1 {
      f.push("decode_connect_request NeedMore(" + k.to_string() + ")")
    }
    _ => ()
  }
  match proxy::parse_and_sanitize_forward_request("GET / HTTP/1.1\r\n".to_bytes(), lim()) {
    Ok(proxy::DecodeStatus::NeedMore(k)) =>
    if k < 1 {
      f.push("parse_and_sanitize_forward_request NeedMore(" + k.to_string() + ")")
    }
    _ => ()
  }
  verdict(f)
}

///| Two different `Proxy-Authorization` headers: the last one silently wins
///| (src/http_proxy.pion:507-512, 932-933). A front component that checks the first header and
///| this parser disagree on who the client is. Reject, or refuse to pick one.
test "p2_duplicate_proxy_authorization_last_wins" {
  let f : Array[String] = []
  // YWxpY2U6YQ== = alice:a, bWFsbG9yeTpt = mallory:m
  let hdrs = "Proxy-Authorization: Basic YWxpY2U6YQ==\r\nProxy-Authorization: Basic bWFsbG9yeTpt\r\n\r\n"
  match proxy::decode_connect_request(
    ("CONNECT a.example:443 HTTP/1.1\r\nHost: a.example:443\r\n" + hdrs).to_bytes(),
    lim(),
  ) {
    Ok(proxy::DecodeStatus::Complete(r, _)) =>
    match r.auth {
      Some(a) => f.push("CONNECT picked user " + a.username)
      None => ()
    }
    _ => ()
  }
  match fwd("GET http://a.example/ HTTP/1.1\r\n" + hdrs) {
    Some(r) =>
    match r.proxy_auth {
      Some(a) => f.push("forward picked user " + a.username)
      None => ()
    }
    None => ()
  }
  verdict(f)
}

///| `encode_connect_request` lets `extra_headers` add a second `Host` / `Proxy-Authorization`
///| next to the ones it generates (src/http_proxy.pion:404-438): duplicate Host is a 400 per
///| RFC 9112 §3.2 and two credentials are ambiguous.
test "p2_encode_connect_extra_headers_duplicate_host_or_auth" {
  let f : Array[String] = []
  match proxy::encode_connect_request(
    "a.example",
    443,
    None,
    [proxy::HttpHeader::new("Host", "evil.example:443")],
  ) {
    Ok(_) => f.push("second Host header emitted")
    Err(_) => ()
  }
  match proxy::encode_connect_request(
    "a.example",
    443,
    Some(proxy::ProxyAuth::new("alice", "pw")),
    [proxy::HttpHeader::new("proxy-authorization", "Basic bWFsbG9yeTpt")],
  ) {
    Ok(_) => f.push("second Proxy-Authorization header emitted")
    Err(_) => ()
  }
  verdict(f)
}

// ---------------------------------------------------------------------------
// controls (must PASS)
// ---------------------------------------------------------------------------

///| Credential matrix from the task: no secret in `redacted()`, `to_safe_string()` or any error.
test "control_url_credential_matrix_no_leak" {
  let f : Array[String] = []
  let raws = [
    "http://alice:p%40ss:w0rd@proxy.example:8080", "http://:s3cretPW@host.example:8080",
    "http://alice:@host.example:8080", "http://alice:s3cretPW@evil.com@good.com:8080",
    "ssh://alice:s3cretPW@host.example", "ssh://alice:@host.example",
    "ssh://monoid@station-us:2222?identity=/s3cret/key#frag", "ftp://alice:s3cretPW@x",
    "http://alice:s3cretPW%ZZ@host.example", "http://alice:s3cretPW%0@host.example",
    "http://alice:s3cretPW%00@host.example", "http://alice:s3cretPW%0D%0A@host.example",
    "http://alice%0A:s3cretPW@host.example", "http://alice:s3cretPW@ho%0Ast.example",
    "http://alice:s3cretPW@host.example:0", "http://alice:s3cretPW@host.example:65536",
    "http://alice:s3cretPW@host.example:99999999999999999999", "http://alice:s3cretPW@host.example:-1",
    "http://alice:s3cretPW@[::1", "http://alice:s3cretPW@[fe80::1%25eth0]:80",
    "http://alice:s3cretPW@[1.2.3.4]:80", "http://alice:s3cretPW@:8080", "socks5h://alice:s3cretPW@[::1]x",
    "http://alice:s3cretPW@a:b:c", "HTTP://alice:s3cretPW@host.example",
  ]
  let mut i = 0
  while i < raws.length() {
    match proxy::parse_proxy_url(raws[i]) {
      Ok(u) => {
        let r = u.redacted() + " " + u.to_safe_string()
        if contains(r, "s3cret") || contains(r, "p@ss") || contains(r, "w0rd") {
          f.push("redacted leak: " + r)
        }
        if contains(r, "alice") {
          f.push("redacted username leak: " + r)
        }
      }
      Err(e) => {
        let m = e.message()
        if contains(m, "s3cret") || contains(m, "alice") || contains(m, "p@ss") {
          f.push("error leak: " + m)
        }
      }
    }
    i = i + 1
  }
  // passwords are rejected for ssh, and identity never leaves the struct
  match proxy::parse_proxy_url("ssh://alice:s3cretPW@host.example") {
    Ok(_) => f.push("ssh password accepted")
    Err(_) => ()
  }
  match proxy::parse_proxy_url("ssh://monoid@station-us:2222?identity=/s3cret/key#frag") {
    Ok(u) => {
      if u.redacted() != "ssh://monoid@station-us:2222" {
        f.push("ssh redacted " + u.redacted())
      }
      match u.identity {
        Some(id) => if id != "/s3cret/key" { f.push("identity " + id) }
        None => f.push("identity lost")
      }
    }
    Err(e) => f.push("ssh identity url rejected: " + e.message())
  }
  // last '@' splits userinfo (WHATWG-compatible)
  match proxy::parse_proxy_url("http://u:p@evil.com@good.com:8080") {
    Ok(u) =>
    if u.host != "good.com" || u.port != 8080 {
      f.push("last-@ split wrong: " + u.host)
    }
    Err(_) => f.push("last-@ URL rejected")
  }
  verdict(f)
}

///|
test "control_url_port_and_host_bounds" {
  let f : Array[String] = []
  let bad = [
    "http://h:0", "http://h:65536", "http://h:99999999999999999999", "http://h:-1", "http://h:+80",
    "http://[::1", "http://[]:80", "http://[::1]x", "http://[fe80::1%25eth0]", "http://[1.2.3.4]",
    "http://::1:80", "http://", "http://@", "http://u@", "http://h:80:81", "http://h\u{0000}x",
    "http://h x", "socks4://h", "http://[1:2:3:4:5:6:7:8:9]", "http://[1::2::3]",
  ]
  let mut i = 0
  while i < bad.length() {
    match proxy::parse_proxy_url(bad[i]) {
      Ok(u) => f.push("accepted " + bad[i] + " host=" + u.host)
      Err(_) => ()
    }
    i = i + 1
  }
  let mut long = StringBuilder::new()
  long.write_string("http://")
  let mut k = 0
  while k < 300 {
    long.write_string("a")
    k = k + 1
  }
  match proxy::parse_proxy_url(long.to_string()) {
    Ok(_) => f.push("300-byte host accepted")
    Err(_) => ()
  }
  match proxy::parse_proxy_url("socks5h://[2001:DB8::1]:65535") {
    Ok(u) =>
    if u.host != "2001:db8::1" || u.port != 65535 {
      f.push("ipv6 max port " + u.host)
    }
    Err(_) => f.push("valid ipv6 rejected")
  }
  verdict(f)
}

///|
test "control_no_proxy_suffix_case_dot_cidr_port" {
  let f : Array[String] = []
  let m = proxy::NoProxyMatcher::parse(
    " , example.com ,, .corp.example, 10.0.0.0/8, 192.168.1.0/33, 172.16.0.0/-1, ::1/128, fd00::/129, api.svc:8443 ,",
  )
  let yes = [
    ("example.com", 443), ("EXAMPLE.COM", 443), ("example.com.", 443), ("a.b.example.com", 1),
    ("x.corp.example", 1), ("10.255.255.255", 1), ("::1", 1), ("[::1]", 1), ("api.svc", 8443),
  ]
  let no = [
    ("evil-example.com", 443), ("example.com.evil", 443), ("notexample.com", 443),
    ("corp.example", 1), ("evilcorp.example", 1), ("11.0.0.0", 1), ("9.255.255.255", 1),
    ("192.168.1.1", 1), ("172.16.0.1", 1), ("::2", 1), ("fd00::1", 1), ("api.svc", 443),
    ("api.svc", 0), ("", 1), ("  ", 1),
  ]
  let mut i = 0
  while i < yes.length() {
    let (h, p) = yes[i]
    if !m.matches(h, p) {
      f.push("should bypass " + h)
    }
    i = i + 1
  }
  let mut j = 0
  while j < no.length() {
    let (h, p) = no[j]
    if m.matches(h, p) {
      f.push("wrongly bypasses '" + h + "':" + p.to_string())
    }
    j = j + 1
  }
  let all = proxy::NoProxyMatcher::parse("0.0.0.0/0")
  if !all.matches("203.0.113.9", 1) || all.matches("example.org", 1) {
    f.push("/0 semantics")
  }
  let v6all = proxy::NoProxyMatcher::parse("::/0")
  if !v6all.matches("2001:db8::1", 1) || v6all.matches("1.2.3.4", 1) {
    f.push("::/0 semantics")
  }
  let p64 = proxy::NoProxyMatcher::parse("2001:db8:1:2::/64")
  if !p64.matches("2001:db8:1:2:ffff::1", 1) || p64.matches("2001:db8:1:3::1", 1) {
    f.push("/64 semantics")
  }
  let p32 = proxy::NoProxyMatcher::parse("1.2.3.4/32")
  if !p32.matches("1.2.3.4", 1) || p32.matches("1.2.3.5", 1) {
    f.push("/32 semantics")
  }
  verdict(f)
}

///|
test "control_socks_malformed_rejected" {
  let f : Array[String] = []
  let greet_bad = [[4, 1, 0], [5, 0], [0, 1, 0]]
  let mut i = 0
  while i < greet_bad.length() {
    match proxy::socks5_decode_greeting(bs(greet_bad[i])) {
      Err(_) => ()
      Ok(_) => f.push("greeting accepted #" + i.to_string())
    }
    i = i + 1
  }
  let req_bad = [
    [4, 1, 0, 1, 1, 2, 3, 4, 0, 80], [5, 1, 1, 1, 1, 2, 3, 4, 0, 80], [5, 9, 0, 1, 1, 2, 3, 4, 0, 80],
    [5, 0, 0, 1, 1, 2, 3, 4, 0, 80], [5, 1, 0, 0, 1, 2, 3, 4, 0, 80], [5, 1, 0, 2, 1, 2, 3, 4, 0, 80],
    [5, 1, 0, 5, 1, 2, 3, 4, 0, 80], [5, 1, 0, 255, 1, 2, 3, 4, 0, 80], [5, 1, 0, 3, 0, 0, 80],
    [5, 1, 0, 3, 3, 97, 0, 98, 0, 80], [5, 1, 0, 3, 3, 97, 13, 98, 0, 80], [5, 1, 0, 3, 3, 97, 10, 98, 0, 80],
  ]
  let mut j = 0
  while j < req_bad.length() {
    match proxy::socks5_decode_request(bs(req_bad[j])) {
      Err(_) => ()
      Ok(_) => f.push("request accepted #" + j.to_string())
    }
    j = j + 1
  }
  let up_bad = [[2, 1, 97, 1, 98], [1, 0, 1, 98], [1, 1, 97, 0]]
  let mut k = 0
  while k < up_bad.length() {
    match proxy::socks5_decode_userpass_request(bs(up_bad[k])) {
      Err(_) => ()
      Ok(_) => f.push("userpass accepted #" + k.to_string())
    }
    k = k + 1
  }
  match proxy::socks5_decode_method_selection(bs([5, 0xFF])) {
    Err(proxy::ProxyError::NoAcceptableAuthMethods) => ()
    _ => f.push("0xFF method selection")
  }
  match proxy::socks5_decode_reply(bs([5, 0, 1, 1, 1, 2, 3, 4, 0, 80])) {
    Err(_) => ()
    Ok(_) => f.push("reply RSV!=0 accepted")
  }
  match proxy::socks5_decode_userpass_response(bs([1, 1])) {
    Err(proxy::ProxyError::AuthRejected(1)) => ()
    _ => f.push("auth rejection")
  }
  // 255-byte domain round-trips; 256 / wrong-length IPs are refused by the encoder
  let d = StringBuilder::new()
  let mut n = 0
  while n < 255 {
    d.write_string("a")
    n = n + 1
  }
  match proxy::socks5_encode_request(proxy::SocksCommand::Connect, proxy::SocksAddr::Domain(d.to_string()), 443) {
    Ok(w) =>
    match proxy::socks5_decode_request(w) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => if c != 262 { f.push("255 domain consumed") }
      _ => f.push("255 domain decode")
    }
    Err(_) => f.push("255 domain encode")
  }
  match proxy::socks5_encode_request(proxy::SocksCommand::Connect, proxy::SocksAddr::Domain(d.to_string() + "a"), 443) {
    Ok(_) => f.push("256 domain")
    Err(_) => ()
  }
  let ipbad = [
    proxy::SocksAddr::Ipv4(bs([1, 2, 3])), proxy::SocksAddr::Ipv4(bs([1, 2, 3, 4, 5])),
    proxy::SocksAddr::Ipv6(bs([1, 2, 3, 4])), proxy::SocksAddr::Ipv6(Bytes::new(17)),
  ]
  let mut q = 0
  while q < ipbad.length() {
    match proxy::socks5_encode_request(proxy::SocksCommand::Connect, ipbad[q], 443) {
      Ok(_) => f.push("bad ip len accepted #" + q.to_string())
      Err(_) => ()
    }
    match proxy::socks5_encode_reply(proxy::SocksReplyCode::Succeeded, ipbad[q], 0) {
      Ok(_) => f.push("bad ip len accepted in reply #" + q.to_string())
      Err(_) => ()
    }
    q = q + 1
  }
  let ports = [0, -1, 65536]
  let mut r = 0
  while r < ports.length() {
    match proxy::socks5_encode_request(proxy::SocksCommand::Connect, proxy::SocksAddr::Domain("a"), ports[r]) {
      Ok(_) => f.push("CONNECT port " + ports[r].to_string())
      Err(_) => ()
    }
    r = r + 1
  }
  match proxy::socks5_encode_userpass_request("", "p") {
    Ok(_) => f.push("ULEN=0")
    Err(_) => ()
  }
  match proxy::socks5_encode_userpass_request(d.to_string() + "a", "p") {
    Ok(_) => f.push("ULEN=256")
    Err(_) => ()
  }
  verdict(f)
}

///| Every message in both directions: whole / 1-byte drip / +32 B pipelined tail give the same
///| value and exact `consumed`.
test "control_socks_fragmentation_and_pipelining" {
  let f : Array[String] = []
  let tail = Bytes::new(32)
  let mut t = 0
  while t < 32 {
    tail[t] = (0x16 + t).to_byte()
    t = t + 1
  }
  let msgs : Array[(String, Bytes)] = []
  match proxy::socks5_encode_greeting([proxy::SocksAuthMethod::NoAuth, proxy::SocksAuthMethod::UserPass]) {
    Ok(w) => msgs.push(("greeting", w))
    Err(_) => f.push("enc greeting")
  }
  msgs.push(("method", proxy::socks5_encode_method_selection(proxy::SocksAuthMethod::UserPass)))
  match proxy::socks5_encode_userpass_request("alice", "s3cr3t!") {
    Ok(w) => msgs.push(("userpass_req", w))
    Err(_) => f.push("enc up")
  }
  msgs.push(("userpass_resp", proxy::socks5_encode_userpass_response(true)))
  let addrs = [
    proxy::SocksAddr::Ipv4(bs([10, 0, 0, 1])), proxy::SocksAddr::Ipv6(Bytes::new(16)),
    proxy::SocksAddr::Domain("api.github.com"),
  ]
  let mut a = 0
  while a < addrs.length() {
    match proxy::socks5_encode_request(proxy::SocksCommand::Connect, addrs[a], 443) {
      Ok(w) => msgs.push(("request", w))
      Err(_) => f.push("enc req")
    }
    match proxy::socks5_encode_reply(proxy::SocksReplyCode::Succeeded, addrs[a], 1080) {
      Ok(w) => msgs.push(("reply", w))
      Err(_) => f.push("enc reply")
    }
    a = a + 1
  }
  let mut i = 0
  while i < msgs.length() {
    let (kind, w) = msgs[i]
    let whole = consumed_of(kind, w)
    let piped = consumed_of(kind, cat(w, tail))
    if whole != w.length() || piped != w.length() {
      f.push(kind + " whole=" + whole.to_string() + " piped=" + piped.to_string())
    }
    let mut k = 0
    while k < w.length() {
      let c = consumed_of(kind, w.slice(0, k))
      if c != -1 {
        f.push(kind + " prefix " + k.to_string() + " gave " + c.to_string())
      }
      k = k + 1
    }
    i = i + 1
  }
  verdict(f)
}

///| consumed on Complete, -1 on NeedMore, -2 on Err.
fn consumed_of(kind : String, b : Bytes) -> Int {
  if kind == "greeting" {
    match proxy::socks5_decode_greeting(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  } else if kind == "method" {
    match proxy::socks5_decode_method_selection(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  } else if kind == "userpass_req" {
    match proxy::socks5_decode_userpass_request(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  } else if kind == "userpass_resp" {
    match proxy::socks5_decode_userpass_response(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  } else if kind == "request" {
    match proxy::socks5_decode_request(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  } else {
    match proxy::socks5_decode_reply(b) {
      Ok(proxy::DecodeStatus::Complete(_, c)) => c
      Ok(proxy::DecodeStatus::NeedMore(_)) => -1
      Err(_) => -2
    }
  }
}

///|
test "control_http_smuggling_rejections" {
  let f : Array[String] = []
  let bad = [
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\ntransfer-encoding: CHUNKED\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: gzip, chunked\r\nContent-Length: 5\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding : chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, gzip\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: xchunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: gzip\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding:\r\n\r\n",
    "POST / HTTP/1.0\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5, 10\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: -1\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: +5\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0x5\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 99999999999999999999\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5,\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length:\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\nX: b\r\n\r\n", "GET / HTTP/1.1\r\nHost: a\rX: b\r\n\r\n",
    "GET / HTTP/1.1\nHost: a\r\n\r\n", "GET / HTTP/1.1\r\nHost: a\r\nX: b\r\n c\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\n\tX: c\r\n\r\n", "GET / HTTP/1.1\r\nHost : evil.example\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nX\u{0000}Y: b\r\n\r\n", "GET / HTTP/1.1\r\nHost: a\r\nX: b\u{0000}c\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nX: b\u{0001}c\r\n\r\n", "GET / HTTP/1.1\r\nHost: a\r\nX\u{0001}: b\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n", "GET / HTTP/1.1\r\n\r\n",
    "GET  / HTTP/1.1\r\nHost: a\r\n\r\n", "GET / HTTP/1.1 \r\nHost: a\r\n\r\n", "GET / HTTP/2.0\r\nHost: a\r\n\r\n",
    "G(T / HTTP/1.1\r\nHost: a\r\n\r\n", "GET https://a/ HTTP/1.1\r\n\r\n", "GET http://u:p@a/ HTTP/1.1\r\n\r\n",
    "GET http://a@b/ HTTP/1.1\r\n\r\n", "GET http://a:0/ HTTP/1.1\r\n\r\n", "GET http://a#x HTTP/1.1\r\n\r\n",
    "GET * HTTP/1.1\r\nHost: a\r\n\r\n", "GET / HTTP/1.1\r\nHost: a:99999\r\n\r\n",
  ]
  let mut i = 0
  while i < bad.length() {
    match fwd(bad[i]) {
      Some(r) => f.push("accepted #" + i.to_string() + ": " + r.wire_head.to_string())
      None => ()
    }
    i = i + 1
  }
  // identical duplicate CL is allowed and canonicalised to one header
  match fwd("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nContent-Length: 5, 5\r\n\r\n") {
    Some(r) => {
      let w = lower(r.wire_head.to_string())
      if !contains(w, "content-length: 5\r\n") || contains(w, "5, 5") {
        f.push("CL canonicalisation: " + w)
      }
    }
    None => f.push("identical CL rejected")
  }
  verdict(f)
}

///|
test "control_http_hop_by_hop_stripped_and_connection_host_safe" {
  let f : Array[String] = []
  let raw = "GET http://Target.Example:8080/p?q=1 HTTP/1.1\r\nHost: spoofed.invalid\r\nConnection: , X-Custom ,keep-alive\r\nCONNECTION: Host, x-other\r\nProxy-Connection: keep-alive\r\nproxy-authorization: Basic YTpi\r\nProxy-Authenticate: Basic\r\nKeep-Alive: 5\r\nTE: trailers\r\nTrailer: X\r\nUpgrade: h2c\r\nX-Custom: drop\r\nx-other: drop\r\nAccept: */*\r\n\r\n"
  match fwd(raw) {
    Some(r) => {
      let w = lower(r.wire_head.to_string())
      let gone = [
        "connection:", "proxy-connection", "proxy-authorization", "proxy-authenticate", "keep-alive:",
        "\r\nte:", "trailer:", "upgrade:", "x-custom", "x-other", "spoofed",
      ]
      let mut i = 0
      while i < gone.length() {
        if contains(w, gone[i]) {
          f.push("not stripped: " + gone[i])
        }
        i = i + 1
      }
      if !contains(w, "\r\nhost: target.example:8080\r\n") {
        f.push("Host lost under Connection: Host -> " + w)
      }
      if !contains(w, "get /p?q=1 http/1.1\r\n") || !contains(w, "accept: */*") {
        f.push("rewrite: " + w)
      }
      match r.proxy_auth {
        Some(a) => if a.username != "a" || a.password != "b" { f.push("auth") }
        None => f.push("auth lost")
      }
    }
    None => f.push("rejected")
  }
  // origin-form with Connection: Host keeps the Host header too
  match fwd("GET / HTTP/1.1\r\nConnection: host\r\nHost: [::1]:81\r\n\r\n") {
    Some(r) =>
    if !contains(lower(r.wire_head.to_string()), "\r\nhost: [::1]:81\r\n") {
      f.push("origin-form Host lost: " + r.wire_head.to_string())
    }
    None => f.push("origin-form rejected")
  }
  verdict(f)
}

///|
test "control_connect_authority_and_response_consumed" {
  let f : Array[String] = []
  let good = [
    ("CONNECT [::1]:443 HTTP/1.1\r\n\r\n", "::1", 443), ("CONNECT A.Example:1 HTTP/1.0\r\nHost: x\r\n\r\n", "a.example", 1),
  ]
  let mut i = 0
  while i < good.length() {
    let (raw, h, p) = good[i]
    match proxy::decode_connect_request(raw.to_bytes(), lim()) {
      Ok(proxy::DecodeStatus::Complete(r, c)) =>
      if r.host != h || r.port != p || c != raw.length() {
        f.push("connect " + raw)
      }
      _ => f.push("connect rejected " + raw)
    }
    i = i + 1
  }
  let bad = [
    "CONNECT a.example HTTP/1.1\r\n\r\n", "CONNECT a.example:0 HTTP/1.1\r\n\r\n", "CONNECT a.example:65536 HTTP/1.1\r\n\r\n",
    "CONNECT a.example:443/p HTTP/1.1\r\n\r\n", "CONNECT a.example:443?q HTTP/1.1\r\n\r\n",
    "CONNECT u:p@a.example:443 HTTP/1.1\r\n\r\n", "CONNECT u@a.example:443 HTTP/1.1\r\n\r\n",
    "CONNECT a.example:99999999999 HTTP/1.1\r\n\r\n", "CONNECT ::1:443 HTTP/1.1\r\n\r\n", "CONNECT [::1 HTTP/1.1\r\n\r\n",
    "CONNECT []:443 HTTP/1.1\r\n\r\n", "CONNECT [::g]:443 HTTP/1.1\r\n\r\n", "CONNECT http://a:443 HTTP/1.1\r\n\r\n",
    "connect a:443 HTTP/1.1\r\n\r\n", "CONNECT a:443 HTTP/1.1\r\nX : y\r\n\r\n",
  ]
  let mut j = 0
  while j < bad.length() {
    match proxy::decode_connect_request(bad[j].to_bytes(), lim()) {
      Ok(proxy::DecodeStatus::Complete(r, _)) => f.push("accepted " + bad[j] + " host=" + r.host)
      _ => ()
    }
    j = j + 1
  }
  // 200 + pipelined TLS ClientHello: whole, 1-byte drip, exact consumed
  let head = "HTTP/1.1 200 Connection Established\r\n\r\n".to_bytes()
  let hello = bs([0x16, 0x03, 0x01, 0x02, 0x00, 0x01, 0x00, 0x01, 0xfc, 0x03, 0x03])
  let all = cat(head, hello)
  let mut k = 0
  while k <= all.length() {
    match proxy::decode_connect_response(all.slice(0, k), lim()) {
      Ok(proxy::DecodeStatus::Complete(r, c)) =>
      if k < head.length() || c != head.length() || r.status != 200 || !r.is_success() {
        f.push("drip " + k.to_string() + " consumed " + c.to_string())
      }
      Ok(proxy::DecodeStatus::NeedMore(_)) =>
      if k >= head.length() {
        f.push("NeedMore at " + k.to_string())
      }
      Err(e) => f.push("drip err " + e.message())
    }
    k = k + 1
  }
  // 407 with two challenges: both kept in headers
  let r407 = "HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"a\"\r\nProxy-Authenticate: Negotiate\r\nContent-Length: 0\r\n\r\n"
  match proxy::decode_connect_response(r407.to_bytes(), lim()) {
    Ok(proxy::DecodeStatus::Complete(r, c)) => {
      let mut n = 0
      let mut h = 0
      while h < r.headers.length() {
        if lower(r.headers[h].name) == "proxy-authenticate" {
          n = n + 1
        }
        h = h + 1
      }
      if !r.is_auth_required() || n != 2 || c != r407.length() || (match r.proxy_authenticate { Some(_) => false
        None => true }) {
        f.push("407 structure")
      }
    }
    _ => f.push("407 rejected")
  }
  let bad_resp = [
    "HTTP/1.1 20 OK\r\n\r\n", "HTTP/1.1 2000 OK\r\n\r\n", "HTTP/1.1 abc OK\r\n\r\n", "HTTP/2 200 OK\r\n\r\n",
    "HTTP/1.1 200 OK\nX: y\r\n\r\n", "HTTP/1.1 200OK\r\n\r\n",
  ]
  let mut q = 0
  while q < bad_resp.length() {
    match proxy::decode_connect_response(bad_resp[q].to_bytes(), lim()) {
      Ok(proxy::DecodeStatus::Complete(_, _)) => f.push("accepted response #" + q.to_string())
      _ => ()
    }
    q = q + 1
  }
  verdict(f)
}

///|
test "control_encoder_injection_rejected" {
  let f : Array[String] = []
  let hosts = [
    "a.example\r\nX: y", "a\u{0000}b", "a b", "", "a.example:443", "a/b", "a@b", "[::1", "[zz::1]", "::g", "a\tb",
  ]
  let mut i = 0
  while i < hosts.length() {
    match proxy::encode_connect_request(hosts[i], 443, None, []) {
      Ok(w) => f.push("host accepted: " + w.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
  let ports = [0, -1, 65536]
  let mut p = 0
  while p < ports.length() {
    match proxy::encode_connect_request("a", ports[p], None, []) {
      Ok(_) => f.push("port " + ports[p].to_string())
      Err(_) => ()
    }
    p = p + 1
  }
  let auths = [
    proxy::ProxyAuth::new("a:b", "c"), proxy::ProxyAuth::new("a\r\n", "c"), proxy::ProxyAuth::new("a", "c\r\nX: y"),
    proxy::ProxyAuth::new("a", "c\u{0000}"),
  ]
  let mut a = 0
  while a < auths.length() {
    match proxy::encode_connect_request("a", 1, Some(auths[a]), []) {
      Ok(_) => f.push("auth #" + a.to_string())
      Err(_) => ()
    }
    a = a + 1
  }
  let hs = [
    proxy::HttpHeader::new("X\r\nY", "v"), proxy::HttpHeader::new("X:Y", "v"), proxy::HttpHeader::new("X Y", "v"),
    proxy::HttpHeader::new("", "v"), proxy::HttpHeader::new("X", "v\r\nY: z"), proxy::HttpHeader::new("X", "v\u{0000}"),
    proxy::HttpHeader::new("X", "v\u{001b}"), proxy::HttpHeader::new("X", "v\u{007f}"),
  ]
  let mut h = 0
  while h < hs.length() {
    match proxy::encode_connect_request("a", 1, None, [hs[h]]) {
      Ok(_) => f.push("header #" + h.to_string())
      Err(_) => ()
    }
    match proxy::encode_connect_response(200, "OK", [hs[h]]) {
      Ok(_) => f.push("resp header #" + h.to_string())
      Err(_) => ()
    }
    h = h + 1
  }
  match proxy::encode_connect_response(200, "OK\r\nX: y", []) {
    Ok(_) => f.push("reason CRLF")
    Err(_) => ()
  }
  match proxy::encode_connect_response(99, "x", []) {
    Ok(_) => f.push("status 99")
    Err(_) => ()
  }
  // ipv6 is bracketed, auth round-trips through the decoder
  match proxy::encode_connect_request("2001:DB8::1", 443, Some(proxy::ProxyAuth::new("alice", "p@ss:w0rd")), []) {
    Ok(w) =>
    match proxy::decode_connect_request(w, lim()) {
      Ok(proxy::DecodeStatus::Complete(r, c)) =>
      match r.auth {
        Some(au) =>
        if r.host != "2001:db8::1" || au.password != "p@ss:w0rd" || c != w.length() {
          f.push("roundtrip")
        }
        None => f.push("auth lost")
      }
      _ => f.push("roundtrip decode")
    }
    Err(_) => f.push("ipv6 encode")
  }
  verdict(f)
}

///| Forged/zero/negative limits fail closed; an unterminated 1 MiB head is refused at the limit.
test "control_limits_dos" {
  let f : Array[String] = []
  let req = "GET / HTTP/1.1\r\nHost: a\r\nX: 1\r\n\r\n".to_bytes()
  let forged = [
    proxy::ProxyLimits::{ max_header_bytes: 0, max_headers: 100, max_line_bytes: 8192 },
    proxy::ProxyLimits::{ max_header_bytes: -1, max_headers: 100, max_line_bytes: 8192 },
    proxy::ProxyLimits::{ max_header_bytes: 65536, max_headers: 0, max_line_bytes: 8192 },
    proxy::ProxyLimits::{ max_header_bytes: 65536, max_headers: -5, max_line_bytes: 8192 },
    proxy::ProxyLimits::{ max_header_bytes: 65536, max_headers: 100, max_line_bytes: 0 },
    proxy::ProxyLimits::{ max_header_bytes: 65536, max_headers: 100, max_line_bytes: -9 },
    proxy::ProxyLimits::{ max_header_bytes: 10, max_headers: 100, max_line_bytes: 8192 },
    proxy::ProxyLimits::{ max_header_bytes: 65536, max_headers: 1, max_line_bytes: 8192 },
  ]
  let mut i = 0
  while i < forged.length() {
    match proxy::parse_and_sanitize_forward_request(req, forged[i]) {
      Ok(proxy::DecodeStatus::Complete(_, _)) => f.push("forged limits #" + i.to_string() + " accepted")
      _ => ()
    }
    i = i + 1
  }
  let big = Bytes::new(1048576)
  let pre = "GET / HTTP/1.1\r\nX: ".to_bytes()
  let mut k = 0
  while k < big.length() {
    big[k] = (if k < pre.length() { pre[k].to_int() } else { 97 }).to_byte()
    k = k + 1
  }
  match proxy::parse_and_sanitize_forward_request(big, lim()) {
    Err(proxy::ProxyError::LimitExceeded(_)) => ()
    _ => f.push("1 MiB unterminated head not refused")
  }
  match proxy::decode_connect_response(big, lim()) {
    Err(_) => ()
    _ => f.push("1 MiB response head not refused")
  }
  // 101 headers > max_headers
  let sb = StringBuilder::new()
  sb.write_string("GET / HTTP/1.1\r\nHost: a\r\n")
  let mut h = 0
  while h < 100 {
    sb.write_string("X: 1\r\n")
    h = h + 1
  }
  sb.write_string("\r\n")
  match proxy::parse_and_sanitize_forward_request(sb.to_string().to_bytes(), lim()) {
    Err(proxy::ProxyError::LimitExceeded(_)) => ()
    _ => f.push("101 headers accepted")
  }
  verdict(f)
}
