+///| Internal: any C0 control or DEL.
+fn has_ctl_url(s : String) -> Bool {
+  let b = s.to_bytes()
+  let mut i = 0
+  while i < b.length() {
+    let c = b[i].to_int()
+    if c < 32 || c == 127 {
+      return true
+    }
+    i = i + 1
+  }
+  false
+}
+
+///| Internal: percent-encode everything but RFC 3986 unreserved.
+fn pct_encode_userinfo(s : String) -> String {
+  let b = s.to_bytes()
+  let sb = StringBuilder::new()
+  let hx = "0123456789ABCDEF".to_bytes()
+  let mut i = 0
+  while i < b.length() {
+    let c = b[i].to_int()
+    if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 || c == 126 {
+      sb.write_string(b.slice(i, i + 1).to_string())
+    } else {
+      sb.write_string("%")
+      sb.write_string(hx.slice(c / 16, c / 16 + 1).to_string())
+      sb.write_string(hx.slice(c % 16, c % 16 + 1).to_string())
+    }
+    i = i + 1
+  }
+  sb.to_string()
+}
