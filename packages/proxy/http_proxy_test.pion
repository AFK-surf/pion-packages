///| RFC 9110 / RFC 9112 HTTP CONNECT & plaintext HTTP forward-proxy compliance & security tests.

///|
fn http_find_header(headers : Array[HttpHeader], name_lower : String) -> Option[String] {
  let mut i = 0
  while i < headers.length() {
    let h = headers[i]
    if h.name.length() == name_lower.length() {
      let mut j = 0
      let mut eq = true
      while j < h.name.length() {
        let mut c = h.name.code_unit_at(j)
        if c >= 65 && c <= 90 {
          c = c + 32
        }
        if c != name_lower.code_unit_at(j) {
          eq = false
          break
        }
        j = j + 1
      }
      if eq {
        return Some(h.value)
      }
    }
    i = i + 1
  }
  None
}

///|
fn http_opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
fn http_opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
fn http_concat(a : Bytes, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
test "http_connect_encode_decode_ipv6_and_basic_auth" {
  // IPv6 host ::1 with Basic auth + extra header
  let auth = Some(ProxyAuth::new("alice", "p@ss:w0rd"))
  let wire = match encode_connect_request(
    "::1",
    443,
    auth,
    [HttpHeader::new("User-Agent", "monoid-login/1.0")],
  ) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode connect ipv6")
      Bytes::new(0)
    }
  }
  let s = wire.to_string()
  debug_assert(
    s ==
    "CONNECT [::1]:443 HTTP/1.1\r\nHost: [::1]:443\r\nProxy-Authorization: Basic YWxpY2U6cEBzczp3MHJk\r\nUser-Agent: monoid-login/1.0\r\n\r\n",
    "exact CONNECT wire format",
  )

  // Streaming 1-byte fragmentation decode
  let lim = ProxyLimits::default()
  let mut cut = 0
  while cut < wire.length() {
    match decode_connect_request(wire.slice(0, cut), lim) {
      Ok(DecodeStatus::NeedMore(_)) => ()
      _ => debug_assert(false, "expected NeedMore on partial CONNECT")
    }
    cut = cut + 1
  }
  match decode_connect_request(wire, lim) {
    Ok(DecodeStatus::Complete(req, consumed)) => {
      debug_assert(consumed == wire.length(), "consumed full CONNECT")
      debug_assert(req.host == "::1", "ipv6 brackets stripped")
      debug_assert(req.port == 443, "port 443")
      debug_assert(req.version == "HTTP/1.1", "HTTP/1.1")
      match req.auth {
        Some(a) => {
          debug_assert(a.username == "alice", "decoded basic user")
          debug_assert(a.password == "p@ss:w0rd", "decoded basic pass with colon")
        }
        None => debug_assert(false, "expected decoded Basic auth")
      }
    }
    _ => debug_assert(false, "expected Complete CONNECT request")
  }

  // [2001:db8::1]:443 already-bracketed input also works
  let wire2 = match encode_connect_request("[2001:db8::1]", 443, None, []) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode bracketed ipv6")
      Bytes::new(0)
    }
  }
  match decode_connect_request(wire2, lim) {
    Ok(DecodeStatus::Complete(req, _)) => {
      debug_assert(req.host == "2001:db8::1", "unbracketed 2001:db8::1")
      debug_assert(req.port == 443, "port 443")
    }
    _ => debug_assert(false, "decode bracketed ipv6")
  }
}

///|
test "http_connect_response_200_pipelined_tls_and_407_passthrough" {
  let lim = ProxyLimits::default()
  let head = "HTTP/1.1 200 Connection Established\r\nProxy-Agent: monoid-bridge/1\r\n\r\n".to_bytes()
  // Pipelined TLS ClientHello bytes immediately after \r\n\r\n
  let mut tls = Bytes::new(5)
  tls[0] = (0x16).to_byte()
  tls[1] = (0x03).to_byte()
  tls[2] = (0x01).to_byte()
  tls[3] = (0x02).to_byte()
  tls[4] = (0x00).to_byte()
  let combined = http_concat(head, tls)
  match decode_connect_response(combined, lim) {
    Ok(DecodeStatus::Complete(resp, consumed)) => {
      debug_assert(consumed == head.length(), "exact consumed before TLS")
      debug_assert(resp.status == 200, "status 200")
      debug_assert(resp.is_success(), "is_success")
      debug_assert(!resp.is_auth_required(), "not 407")
      debug_assert(resp.reason == "Connection Established", "reason")
      let remainder = combined.slice(consumed, combined.length())
      debug_assert(remainder.length() == 5, "5 TLS bytes preserved")
      debug_assert(remainder[0].to_int() == 0x16, "TLS record type preserved")
    }
    _ => debug_assert(false, "expected Complete 200 response")
  }

  // Upstream 407 Proxy Authentication Required MUST be preserved structurally
  let resp407 = match encode_connect_response(
    407,
    "Proxy Authentication Required",
    [HttpHeader::new("Proxy-Authenticate", "Basic realm=\"corp\"")],
  ) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode 407")
      Bytes::new(0)
    }
  }
  match decode_connect_response(resp407, lim) {
    Ok(DecodeStatus::Complete(resp, consumed)) => {
      debug_assert(consumed == resp407.length(), "407 consumed")
      debug_assert(resp.status == 407, "status 407 preserved")
      debug_assert(resp.is_auth_required(), "is_auth_required true")
      debug_assert(!resp.is_success(), "not success")
      debug_assert(
        http_opt_str_eq(resp.proxy_authenticate, Some("Basic realm=\"corp\"")),
        "Proxy-Authenticate preserved",
      )
    }
    _ => debug_assert(false, "expected Complete 407 response (not generic Err)")
  }
}

///|
test "http_connect_injection_rejection" {
  // CRLF / NUL in host, user, pass, extra header, and ':' in Basic username
  match encode_connect_request("evil.com\r\nX-Inject: 1", 443, None, []) {
    Err(ProxyError::CrlfInjection(_)) => ()
    _ => debug_assert(false, "CRLF in host must fail")
  }
  match encode_connect_request("evil.com\u{0000}", 443, None, []) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NUL in host must fail")
  }
  match encode_connect_request(
    "example.com",
    443,
    Some(ProxyAuth::new("bad:user", "pass")),
    [],
  ) {
    Err(ProxyError::InvalidCredentials(_)) => ()
    _ => debug_assert(false, "colon in Basic username must fail")
  }
  match encode_connect_request(
    "example.com",
    443,
    Some(ProxyAuth::new("user", "bad\r\npass")),
    [],
  ) {
    Err(ProxyError::CrlfInjection(_)) => ()
    _ => debug_assert(false, "CRLF in password must fail")
  }
  match encode_connect_request(
    "example.com",
    443,
    None,
    [HttpHeader::new("X-Test", "val\r\nEvil: 1")],
  ) {
    Err(ProxyError::CrlfInjection(_)) => ()
    _ => debug_assert(false, "CRLF in header value must fail")
  }
  match encode_connect_request("example.com", 0, None, []) {
    Err(ProxyError::InvalidPort(_)) => ()
    _ => debug_assert(false, "port 0 must fail")
  }
}

///|
test "http_forward_proxy_rewrite_and_hop_by_hop_sanitization" {
  let lim = ProxyLimits::default()
  let raw = (
    "GET http://example.com:8080/v1/items?limit=10 HTTP/1.1\r\n" +
    "Host: spoofed.invalid\r\n" +
    "Proxy-Connection: keep-alive\r\n" +
    "Proxy-Authorization: Basic YWxpY2U6c2VjcmV0\r\n" +
    "Proxy-Authenticate: Basic realm=\"x\"\r\n" +
    "Connection: keep-alive, X-Custom-Hop, X-Second-Hop\r\n" +
    "Keep-Alive: timeout=5\r\n" +
    "TE: trailers\r\n" +
    "Trailer: X-Checksum\r\n" +
    "Upgrade: h2c\r\n" +
    "X-Custom-Hop: drop-me\r\n" +
    "x-second-hop: drop-me-too\r\n" +
    "Accept: application/json\r\n" +
    "X-Trace-Id: trace-123\r\n" +
    "\r\n" +
    "TRAILING"
  ).to_bytes()
  match parse_and_sanitize_forward_request(raw, lim) {
    Ok(DecodeStatus::Complete(req, consumed)) => {
      debug_assert(consumed == raw.length() - 8, "exact consumed before body")
      debug_assert(req.method == "GET", "method GET")
      debug_assert(req.target_host == "example.com", "target host")
      debug_assert(req.target_port == 8080, "target port 8080")
      debug_assert(req.origin_path == "/v1/items?limit=10", "origin-form path")
      debug_assert(req.version == "HTTP/1.1", "HTTP/1.1")
      // Proxy-Authorization extracted before stripping
      match req.proxy_auth {
        Some(a) => {
          debug_assert(a.username == "alice", "extracted proxy user")
          debug_assert(a.password == "secret", "extracted proxy pass")
        }
        None => debug_assert(false, "expected extracted proxy_auth")
      }
      // Canonical Host set from target URI
      debug_assert(
        http_opt_str_eq(http_find_header(req.headers, "host"), Some("example.com:8080")),
        "canonical Host header",
      )
      // End-to-end headers preserved
      debug_assert(
        http_opt_str_eq(
          http_find_header(req.headers, "accept"),
          Some("application/json"),
        ),
        "Accept preserved",
      )
      debug_assert(
        http_opt_str_eq(
          http_find_header(req.headers, "x-trace-id"),
          Some("trace-123"),
        ),
        "X-Trace-Id preserved",
      )
      // All hop-by-hop + Connection-nominated headers stripped
      let forbidden = [
        "proxy-connection",
        "proxy-authorization",
        "proxy-authenticate",
        "connection",
        "keep-alive",
        "te",
        "trailer",
        "upgrade",
        "x-custom-hop",
        "x-second-hop",
      ]
      let mut fi = 0
      while fi < forbidden.length() {
        debug_assert(
          http_opt_str_eq(http_find_header(req.headers, forbidden[fi]), None),
          "hop-by-hop header must be stripped",
        )
        fi = fi + 1
      }
      // Re-encoded wire_head starts with origin-form request line
      let wire_s = req.wire_head.to_string()
      debug_assert(
        wire_s ==
        "GET /v1/items?limit=10 HTTP/1.1\r\nHost: example.com:8080\r\nAccept: application/json\r\nX-Trace-Id: trace-123\r\n\r\n",
        "sanitized wire_head",
      )
    }
    _ => debug_assert(false, "expected Complete sanitized forward request")
  }
}

///|
test "http_forward_proxy_smuggling_and_limits_rejection" {
  let lim = ProxyLimits::default()

  // 1. TE + CL smuggling
  let te_cl = (
    "POST http://example.com/api HTTP/1.1\r\n" +
    "Host: example.com\r\n" +
    "Transfer-Encoding: chunked\r\n" +
    "Content-Length: 5\r\n" +
    "\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(te_cl, lim) {
    Err(ProxyError::SmugglingDetected(_)) => ()
    _ => debug_assert(false, "TE + CL must be rejected as smuggling")
  }

  // 2. Conflicting duplicate Content-Length
  let dup_cl = (
    "POST http://example.com/api HTTP/1.1\r\n" +
    "Host: example.com\r\n" +
    "Content-Length: 5\r\n" +
    "Content-Length: 10\r\n" +
    "\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(dup_cl, lim) {
    Err(ProxyError::SmugglingDetected(_)) => ()
    _ => debug_assert(false, "conflicting CL must be rejected as smuggling")
  }

  // 3. Valid Content-Length preserved
  let ok_cl = (
    "POST http://example.com/submit HTTP/1.1\r\n" +
    "Content-Length: 42\r\n" +
    "\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(ok_cl, lim) {
    Ok(DecodeStatus::Complete(req, _)) => {
      debug_assert(http_opt_i64_eq(req.content_length, Some(42L)), "CL 42")
      debug_assert(!req.is_chunked, "not chunked")
      debug_assert(
        http_opt_str_eq(http_find_header(req.headers, "host"), Some("example.com")),
        "default port 80 omitted from Host",
      )
    }
    _ => debug_assert(false, "valid CL request should pass")
  }

  // 4. Valid Transfer-Encoding: chunked preserved on HTTP/1.1
  let ok_te = (
    "POST http://example.com/stream HTTP/1.1\r\n" +
    "Transfer-Encoding: chunked\r\n" +
    "\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(ok_te, lim) {
    Ok(DecodeStatus::Complete(req, _)) => {
      debug_assert(req.is_chunked, "chunked true")
      debug_assert(http_opt_i64_eq(req.content_length, None), "no CL")
      debug_assert(
        http_opt_str_eq(
          http_find_header(req.headers, "transfer-encoding"),
          Some("chunked"),
        ),
        "TE preserved",
      )
    }
    _ => debug_assert(false, "valid chunked request should pass")
  }

  // 5. ProxyLimits DoS protection (unterminated header > max_header_bytes, too many headers, long line)
  let small_lim = ProxyLimits::{
    max_header_bytes: 32,
    max_headers: 2,
    max_line_bytes: 24,
  }
  let huge_unterminated = "GET http://example.com/very/long/path/that/exceeds/limit HTTP/1.1\r\n".to_bytes()
  match parse_and_sanitize_forward_request(huge_unterminated, small_lim) {
    Err(ProxyError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "oversized unterminated header must fail LimitExceeded")
  }
  let too_many = (
    "GET / HTTP/1.1\r\nHost: a\r\nX-1: 1\r\nX-2: 2\r\n\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(
    too_many,
    ProxyLimits::{ max_header_bytes: 1024, max_headers: 2, max_line_bytes: 256 },
  ) {
    Err(ProxyError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "too many headers must fail LimitExceeded")
  }
}

///|
test "http_proxy_redteam_regressions" {
  let lim = ProxyLimits::default()

  // P0-1: Connection-nominated Content-Length must NOT be stripped from wire_head
  let cl_nom = (
    "POST http://victim.example/upload HTTP/1.1\r\n" +
    "Connection: Content-Length\r\n" +
    "Content-Length: 40\r\n\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(cl_nom, lim) {
    Ok(DecodeStatus::Complete(req, _)) => {
      debug_assert(http_opt_i64_eq(req.content_length, Some(40L)), "CL 40")
      debug_assert(
        http_opt_str_eq(http_find_header(req.headers, "content-length"), Some("40")),
        "Content-Length preserved despite Connection nomination",
      )
    }
    _ => debug_assert(false, "expected Complete for Connection: Content-Length")
  }

  // P0-2: Connection-nominated Transfer-Encoding must NOT be stripped from wire_head
  let te_nom = (
    "POST http://victim.example/ HTTP/1.1\r\n" +
    "Connection: Transfer-Encoding\r\n" +
    "Transfer-Encoding: chunked\r\n\r\n"
  ).to_bytes()
  match parse_and_sanitize_forward_request(te_nom, lim) {
    Ok(DecodeStatus::Complete(req, _)) => {
      debug_assert(req.is_chunked, "is_chunked true")
      debug_assert(
        http_opt_str_eq(
          http_find_header(req.headers, "transfer-encoding"),
          Some("chunked"),
        ),
        "Transfer-Encoding preserved despite Connection nomination",
      )
    }
    _ => debug_assert(false, "expected Complete for Connection: Transfer-Encoding")
  }

  // P2-8: request-target rejects HTAB / C0 / DEL / #fragment
  let bad_targets = [
    "GET /a\tb HTTP/1.1\r\nHost: x.example\r\n\r\n",
    "GET /a\u{0001}b HTTP/1.1\r\nHost: x.example\r\n\r\n",
    "GET /a\u{007f}b HTTP/1.1\r\nHost: x.example\r\n\r\n",
    "GET http://x.example/a#frag HTTP/1.1\r\n\r\n",
  ]
  let mut ti = 0
  while ti < bad_targets.length() {
    match parse_and_sanitize_forward_request(bad_targets[ti].to_bytes(), lim) {
      Err(ProxyError::InvalidHttpSyntax(_)) => ()
      _ => debug_assert(false, "invalid request-target must be rejected")
    }
    ti = ti + 1
  }

  // P2-9: all three HTTP decoders return NeedMore(n) with n >= 1
  match decode_connect_request("CONNECT a:1 HTTP/1.1\r\n".to_bytes(), lim) {
    Ok(DecodeStatus::NeedMore(k)) => debug_assert(k >= 1, "connect req NeedMore >= 1")
    _ => debug_assert(false, "expected NeedMore for connect req")
  }
  match decode_connect_response("HTTP/1.1 200 OK\r\n".to_bytes(), lim) {
    Ok(DecodeStatus::NeedMore(k)) => debug_assert(k >= 1, "connect resp NeedMore >= 1")
    _ => debug_assert(false, "expected NeedMore for connect resp")
  }
  match parse_and_sanitize_forward_request("GET / HTTP/1.1\r\n".to_bytes(), lim) {
    Ok(DecodeStatus::NeedMore(k)) => debug_assert(k >= 1, "forward req NeedMore >= 1")
    _ => debug_assert(false, "expected NeedMore for forward req")
  }

  // P2-10: duplicate Proxy-Authorization rejected in both CONNECT and forward
  let dup_auth_hdrs = "Proxy-Authorization: Basic YWxpY2U6YQ==\r\nProxy-Authorization: Basic bWFsbG9yeTpt\r\n\r\n"
  match decode_connect_request(
    ("CONNECT a.example:443 HTTP/1.1\r\nHost: a.example:443\r\n" + dup_auth_hdrs).to_bytes(),
    lim,
  ) {
    Err(ProxyError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "duplicate Proxy-Authorization in CONNECT must fail")
  }
  match parse_and_sanitize_forward_request(
    ("GET http://a.example/ HTTP/1.1\r\n" + dup_auth_hdrs).to_bytes(),
    lim,
  ) {
    Err(ProxyError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "duplicate Proxy-Authorization in forward must fail")
  }

  // P2-11: encode_connect_request rejects duplicate Host or Proxy-Authorization in extra_headers
  match encode_connect_request(
    "a.example",
    443,
    None,
    [HttpHeader::new("Host", "evil.example:443")],
  ) {
    Err(ProxyError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "extra Host header must fail")
  }
  match encode_connect_request(
    "a.example",
    443,
    Some(ProxyAuth::new("alice", "pw")),
    [HttpHeader::new("proxy-authorization", "Basic bWFsbG9yeTpt")],
  ) {
    Err(ProxyError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "extra Proxy-Authorization header must fail")
  }
}
