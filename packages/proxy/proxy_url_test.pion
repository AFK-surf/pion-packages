///| Specification & adversarial tests for ProxyUrl, redaction, SSH rules, and NoProxyMatcher.

///|
fn opt_str_eq_u(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
fn str_contains(haystack : String, needle : String) -> Bool {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  while i <= hn - nn {
    let mut j = 0
    let mut matched = true
    while j < nn {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        matched = false
        break
      }
      j = j + 1
    }
    if matched {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "proxy_url_schemes_and_default_ports" {
  match parse_proxy_url("HTTP://proxy.example.com") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Http), "http scheme")
      debug_assert(u.host == "proxy.example.com", "host")
      debug_assert(u.port == 80, "default port 80")
      debug_assert(!u.explicit_port, "implicit port")
      debug_assert(u.uses_remote_dns(), "http uses remote dns")
      debug_assert(u.redacted() == "http://proxy.example.com:80", "redacted http")
    }
    Err(_) => debug_assert(false, "expected Ok for HTTP")
  }
  match parse_proxy_url("HtTpS://Secure.Example.COM/") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Https), "https scheme")
      debug_assert(u.host == "secure.example.com", "lowercased host")
      debug_assert(u.port == 443, "default port 443")
      debug_assert(u.uses_remote_dns(), "https uses remote dns")
      debug_assert(
        u.to_safe_string() == "https://secure.example.com:443",
        "safe string",
      )
    }
    Err(_) => debug_assert(false, "expected Ok for HTTPS")
  }
  match parse_proxy_url("socks5://127.0.0.1") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Socks5), "socks5")
      debug_assert(u.port == 1080, "default port 1080")
      debug_assert(!u.uses_remote_dns(), "socks5 local dns")
    }
    Err(_) => debug_assert(false, "expected Ok for socks5")
  }
  match parse_proxy_url("SOCKS5H://127.0.0.1:1081") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Socks5h), "socks5h")
      debug_assert(u.port == 1081, "explicit port 1081")
      debug_assert(u.explicit_port, "explicit_port true")
      debug_assert(u.uses_remote_dns(), "socks5h remote dns")
    }
    Err(_) => debug_assert(false, "expected Ok for socks5h")
  }
  match parse_proxy_url("ssh://monoid@station-us") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Ssh), "ssh")
      debug_assert(u.port == 22, "default port 22")
      debug_assert(u.uses_remote_dns(), "ssh remote dns")
      debug_assert(opt_str_eq_u(u.username, Some("monoid")), "ssh user")
      debug_assert(opt_str_eq_u(u.password, None), "ssh no pass")
      debug_assert(
        u.redacted() == "ssh://monoid@station-us:22",
        "ssh redacted keeps user",
      )
    }
    Err(_) => debug_assert(false, "expected Ok for ssh")
  }
}

///|
test "proxy_url_credentials_percent_colons_and_full_redaction" {
  // Exact monoid-login boundary: percent-encoded @ and extra colon in password,
  // redacted() must hide entire userinfo as *** (neither username nor password leaked).
  match parse_proxy_url("http://alice:p%40ss:w0rd@proxy.example:8080") {
    Ok(u) => {
      debug_assert(opt_str_eq_u(u.username, Some("alice")), "username alice")
      debug_assert(
        opt_str_eq_u(u.password, Some("p@ss:w0rd")),
        "decoded password with @ and :",
      )
      debug_assert(u.host == "proxy.example", "host")
      debug_assert(u.port == 8080, "port 8080")
      let safe = u.redacted()
      debug_assert(
        safe == "http://***@proxy.example:8080",
        "redacted must hide entire userinfo",
      )
      debug_assert(!str_contains(safe, "alice"), "must not leak username")
      debug_assert(!str_contains(safe, "p@ss"), "must not leak password")
      debug_assert(!str_contains(safe, "w0rd"), "must not leak password suffix")
      match u.auth() {
        Some(a) => {
          debug_assert(a.username == "alice", "auth username")
          debug_assert(a.password == "p@ss:w0rd", "auth password")
        }
        None => debug_assert(false, "expected Some(auth)")
      }
    }
    Err(_) => debug_assert(false, "expected Ok for credential URL")
  }

  // Literal '@' inside password (split on LAST '@')
  match parse_proxy_url("socks5h://bob:s3cr@t:key@127.0.0.1:9050") {
    Ok(u) => {
      debug_assert(opt_str_eq_u(u.username, Some("bob")), "username bob")
      debug_assert(
        opt_str_eq_u(u.password, Some("s3cr@t:key")),
        "password with literal @ and :",
      )
      debug_assert(u.host == "127.0.0.1", "ipv4 host")
      debug_assert(u.port == 9050, "port 9050")
      debug_assert(
        u.redacted() == "socks5h://***@127.0.0.1:9050",
        "redacted hides userinfo",
      )
    }
    Err(_) => debug_assert(false, "expected Ok for literal @ in password")
  }

  // Password-only userinfo
  match parse_proxy_url("http://:onlypass@proxy.local:3128") {
    Ok(u) => {
      debug_assert(opt_str_eq_u(u.username, None), "no username")
      debug_assert(opt_str_eq_u(u.password, Some("onlypass")), "password only")
      debug_assert(u.redacted() == "http://***@proxy.local:3128", "redacted")
    }
    Err(_) => debug_assert(false, "expected Ok for password-only")
  }

  // Username-only userinfo (no password)
  match parse_proxy_url("http://carol@proxy.local:3128") {
    Ok(u) => {
      debug_assert(opt_str_eq_u(u.username, Some("carol")), "username carol")
      debug_assert(opt_str_eq_u(u.password, None), "no password")
      debug_assert(
        u.redacted() == "http://carol@proxy.local:3128",
        "username preserved when no password",
      )
    }
    Err(_) => debug_assert(false, "expected Ok for username-only")
  }
}

///|
test "proxy_url_ssh_rules_and_query_redaction" {
  // ssh:// with password MUST be rejected without echoing credentials
  match parse_proxy_url("ssh://monoid:topsecret99@station-us:2222") {
    Ok(_) => debug_assert(false, "ssh with password must be rejected")
    Err(e) => {
      let msg = e.message()
      debug_assert(!str_contains(msg, "topsecret99"), "no password in error")
      debug_assert(!str_contains(msg, "monoid"), "no username in error")
    }
  }

  // ssh:// with identity query param: parsed into query & identity, stripped from redacted()
  match parse_proxy_url("ssh://monoid@station-us:2222?identity=/secret/key") {
    Ok(u) => {
      debug_assert(proxy_scheme_eq(u.scheme, ProxyScheme::Ssh), "ssh scheme")
      debug_assert(opt_str_eq_u(u.username, Some("monoid")), "user monoid")
      debug_assert(u.host == "station-us", "host station-us")
      debug_assert(u.port == 2222, "port 2222")
      debug_assert(
        opt_str_eq_u(u.query, Some("identity=/secret/key")),
        "query preserved",
      )
      debug_assert(
        opt_str_eq_u(u.identity, Some("/secret/key")),
        "identity extracted",
      )
      let safe = u.redacted()
      debug_assert(
        safe == "ssh://monoid@station-us:2222",
        "redacted must strip query/identity",
      )
      debug_assert(!str_contains(safe, "secret"), "no key path leak")
      debug_assert(!str_contains(safe, "identity"), "no query param leak")
    }
    Err(_) => debug_assert(false, "expected Ok for ssh with identity query")
  }
}

///|
test "proxy_url_ipv6_and_error_redaction" {
  match parse_proxy_url("socks5h://[::1]:1080") {
    Ok(u) => {
      debug_assert(u.host == "::1", "ipv6 unbracketed")
      debug_assert(u.port == 1080, "port 1080")
      debug_assert(u.redacted() == "socks5h://[::1]:1080", "ipv6 rebracketed")
    }
    Err(_) => debug_assert(false, "expected Ok for [::1]:1080")
  }
  match parse_proxy_url("http://u:p@[2001:DB8::1]:8443") {
    Ok(u) => {
      debug_assert(u.host == "2001:db8::1", "ipv6 lowercased")
      debug_assert(u.port == 8443, "port 8443")
      debug_assert(
        u.redacted() == "http://***@[2001:db8::1]:8443",
        "ipv6 redacted",
      )
    }
    Err(_) => debug_assert(false, "expected Ok for ipv6 with creds")
  }

  // Unsupported scheme must NOT echo credentials in error message
  match parse_proxy_url("ftp://bob:hunter2@x") {
    Ok(_) => debug_assert(false, "ftp must fail")
    Err(e) => {
      let msg = e.message()
      debug_assert(!str_contains(msg, "bob"), "no user leak in error")
      debug_assert(!str_contains(msg, "hunter2"), "no pass leak in error")
    }
  }

  // Invalid port / empty host / CRLF / NUL / invalid percent-encoding must fail safely
  let bad_urls = [
    "",
    "http://",
    "http://:8080",
    "http://user:pass@:8080",
    "http://proxy.example:0",
    "http://proxy.example:65536",
    "http://proxy.example:-1",
    "http://proxy.example:abc",
    "http://proxy.example:",
    "http://user:secret@proxy.example\r\n:8080",
    "http://user:secret@proxy.example\n:8080",
    "http://user:secret@proxy.example\u{0000}:8080",
    "http://user:sec%ZZ@proxy.example:8080",
    "http://::1:8080",
    "http://[not-ipv6]:8080",
    "http://proxy host:8080",
  ]
  let mut i = 0
  while i < bad_urls.length() {
    match parse_proxy_url(bad_urls[i]) {
      Ok(_) => debug_assert(false, "expected Err for bad URL")
      Err(e) => {
        let msg = e.message()
        debug_assert(!str_contains(msg, "secret"), "no secret leak")
        debug_assert(!str_contains(msg, "pass"), "no pass leak")
      }
    }
    i = i + 1
  }
}

///|
test "no_proxy_matcher_rules" {
  // Wildcard
  let star = NoProxyMatcher::parse("*")
  debug_assert(star.matches("example.com", 443), "* matches domain")
  debug_assert(star.matches("1.2.3.4", 80), "* matches ip")

  // Mixed production NO_PROXY list
  let m = NoProxyMatcher::parse(
    "localhost, 127.0.0.0/8, 10.0.0.0/8, ::1, example.com, .corp.internal, api.svc.local:8443, [2001:db8::1]:443",
  )
  debug_assert(m.matches("localhost", 80), "exact localhost")
  debug_assert(m.matches("LOCALHOST.", 443), "case-insensitive + trailing dot")
  debug_assert(m.matches("127.0.0.1", 8080), "127/8 CIDR match")
  debug_assert(m.matches("127.255.254.1", 80), "127/8 CIDR upper match")
  debug_assert(!m.matches("128.0.0.1", 80), "outside 127/8")
  debug_assert(m.matches("10.42.0.9", 443), "10/8 CIDR match")
  debug_assert(!m.matches("11.0.0.1", 443), "outside 10/8")
  debug_assert(m.matches("::1", 8080), "ipv6 literal ::1")
  debug_assert(m.matches("[0:0:0:0:0:0:0:1]", 8080), "ipv6 canonicalized")
  debug_assert(m.matches("example.com", 443), "domain exact")
  debug_assert(m.matches("sub.example.com", 443), "domain suffix")
  debug_assert(!m.matches("badexample.com", 443), "no partial label match")
  debug_assert(m.matches("a.corp.internal", 443), "leading-dot subdomain")
  debug_assert(!m.matches("corp.internal", 443), "leading-dot excludes apex")
  debug_assert(m.matches("api.svc.local", 8443), "host:port match")
  debug_assert(!m.matches("api.svc.local", 443), "host:port wrong port")
  debug_assert(m.matches("2001:db8::1", 443), "ipv6:port match")
  debug_assert(!m.matches("2001:db8::1", 8443), "ipv6:port wrong port")
  debug_assert(!m.matches("github.com", 443), "non-matching public host")

  // Empty NO_PROXY matches nothing
  let empty = NoProxyMatcher::parse("  , , ")
  debug_assert(!empty.matches("localhost", 80), "empty matches nothing")
}
