///|
test "non_minimal_length_126_for_0_rejected" {
  let raw = bytes_from_arr([0x82, 0x7E, 0x00, 0x00])
  debug_assert(decode_single_err(Role::Client, 65536, raw), "126 for 0 rejected")
}

///|
test "non_minimal_length_126_for_125_rejected" {
  let mut raw = Bytes::new(4 + 125)
  raw[0] = (0x82).to_byte()
  raw[1] = (0x7E).to_byte()
  raw[2] = (0x00).to_byte()
  raw[3] = (125).to_byte()
  debug_assert(decode_single_err(Role::Client, 65536, raw), "126 for 125 rejected")
}

