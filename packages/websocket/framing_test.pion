///| RFC 6455 & Autobahn §1-§4 framing, opcode, RSV, length boundary, masking, and OOM limit tests (47 tests).

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  let n = a.length()
  while i < n {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn make_pattern_bytes(n : Int) -> Bytes {
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((i * 37 + 13) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn make_ascii_string(n : Int) -> String {
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (65 + (i % 26)).to_byte()
    i = i + 1
  }
  b.to_string()
}

///|
fn decode_single_err(role : Role, max_size : Int, raw : Bytes) -> Bool {
  let d = Decoder::new(role, max_size)
  d.feed(raw)
  match d.next_message() {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "rfc6455_sec5_7_unmasked_hello_wire_bytes" {
  let wire = encode_frame(Frame::text("Hello", None))
  let expected = bytes_from_arr([0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f])
  debug_assert(bytes_eq(wire, expected), "unmasked Hello wire bytes")
}

///|
test "rfc6455_sec5_7_masked_hello_wire_bytes" {
  let wire = encode_frame(Frame::text("Hello", Some(0x37FA213DU)))
  let expected = bytes_from_arr([
    0x81, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58,
  ])
  debug_assert(bytes_eq(wire, expected), "masked Hello wire bytes")
}

///|
test "rfc6455_sec5_7_ping_unmasked_wire_bytes" {
  let wire = encode_frame(Frame::ping("Hello".to_bytes(), None))
  let expected = bytes_from_arr([0x89, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f])
  debug_assert(bytes_eq(wire, expected), "unmasked Ping wire bytes")
}

///|
test "rfc6455_sec5_7_pong_masked_wire_bytes" {
  let wire = encode_frame(Frame::pong("Hello".to_bytes(), Some(0x37FA213DU)))
  let expected = bytes_from_arr([
    0x8a, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58,
  ])
  debug_assert(bytes_eq(wire, expected), "masked Pong wire bytes")
}

///|
test "autobahn_1_1_1_text_empty" {
  let wire = encode_frame(Frame::text("", Some(0x11223344U)))
  let d = Decoder::new(Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "", "empty text")
    _ => debug_assert(false, "expected empty text")
  }
}

///|
test "autobahn_1_1_2_text_125" {
  let s = make_ascii_string(125)
  let wire = encode_frame(Frame::text(s, Some(0xAABBCCDDU)))
  debug_assert(wire.length() == 2 + 4 + 125, "125B header is 6 bytes")
  let d = Decoder::new(Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "text 125")
    _ => debug_assert(false, "expected text 125")
  }
}

///|
test "autobahn_1_1_3_text_126" {
  let s = make_ascii_string(126)
  let wire = encode_frame(Frame::text(s, Some(0x12345678U)))
  debug_assert(wire.length() == 2 + 2 + 4 + 126, "126B header is 8 bytes")
  debug_assert((wire[1].to_int() & 0x7F) == 126, "len7 is 126")
  let d = Decoder::new(Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "text 126")
    _ => debug_assert(false, "expected text 126")
  }
}

///|
test "autobahn_1_1_4_text_127" {
  let s = make_ascii_string(127)
  let wire = encode_frame(Frame::text(s, None))
  let d = Decoder::new(Role::Client, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "text 127")
    _ => debug_assert(false, "expected text 127")
  }
}

///|
test "autobahn_1_1_5_text_65535" {
  let s = make_ascii_string(65535)
  let wire = encode_frame(Frame::text(s, Some(0xDEADBEEFU)))
  debug_assert(wire.length() == 2 + 2 + 4 + 65535, "65535B uses 16-bit ext len")
  let d = Decoder::new(Role::Server, 131072)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "text 65535")
    _ => debug_assert(false, "expected text 65535")
  }
}

///|
test "autobahn_1_1_6_text_65536" {
  let s = make_ascii_string(65536)
  let wire = encode_frame(Frame::text(s, Some(0xCAFEBABEU)))
  debug_assert(wire.length() == 2 + 8 + 4 + 65536, "65536B uses 64-bit ext len")
  debug_assert((wire[1].to_int() & 0x7F) == 127, "len7 is 127")
  let d = Decoder::new(Role::Server, 131072)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "text 65536")
    _ => debug_assert(false, "expected text 65536")
  }
}

///|
test "autobahn_1_2_1_binary_empty" {
  let wire = encode_frame(Frame::binary(Bytes::new(0), None))
  let d = Decoder::new(Role::Client, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Binary(b))) => debug_assert(b.length() == 0, "empty bin")
    _ => debug_assert(false, "expected empty bin")
  }
}

