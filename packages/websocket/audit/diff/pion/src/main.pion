///| Red-team differential runner: Pion `packages/websocket` decoder over the shared corpus.

import "websocket"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    0
  }
}

///|
fn hex_decode(s : String) -> Bytes {
  let n = s.length() / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((hexval(s.code_unit_at(2 * i)) << 4) | hexval(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn fnv32(b : Bytes) -> Int64 {
  let mut h : Int64 = 2166136261L
  let mut i = 0
  while i < b.length() {
    h = ((h ^ b[i].to_int().to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

///|
fn err_code(e : websocket::WsError) -> Int {
  match e {
    websocket::WsError::InvalidUtf8(_) => 1007
    websocket::WsError::MessageTooLarge(_, _) => 1009
    _ => 1002
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn run_case(line : String) -> String {
  let parts = line.split(" ")
  let name = parts[0]
  let role = if parts[1] == "s" {
    websocket::Role::Server
  } else {
    websocket::Role::Client
  }
  let maxsz = parse_int(parts[2])
  let chunk = parse_int(parts[3])
  let wire = hex_decode(parts[4])
  let d = websocket::Decoder::new(role, maxsz)
  let sb = StringBuilder::new()
  sb.write_string(name)
  let n = wire.length()
  let step = if chunk == 0 { n } else { chunk }
  let mut off = 0
  while off < n {
    let end = if off + step > n { n } else { off + step }
    d.feed(wire.slice(off, end))
    off = end
    while true {
      match d.next_message() {
        Ok(Some(websocket::Message::Text(s))) => {
          let b = s.to_bytes()
          sb.write_string(" T" + b.length().to_string() + ":" + fnv32(b).to_string())
        }
        Ok(Some(websocket::Message::Binary(b))) =>
        sb.write_string(" B" + b.length().to_string() + ":" + fnv32(b).to_string())
        Ok(Some(websocket::Message::Close(Some(cf)))) =>
        sb.write_string(" C" + cf.code.to_string())
        Ok(Some(websocket::Message::Close(None))) => sb.write_string(" C-")
        Ok(Some(_)) => ()
        Ok(None) => break
        Err(e) => {
          sb.write_string(" ERR" + err_code(e).to_string())
          return sb.to_string()
        }
      }
    }
  }
  sb.write_string(" END")
  sb.to_string()
}

///|
fn key_const() -> String {
  "dGhlIHNhbXBsZSBub25jZQ=="
}

///|
fn fill_accept(raw : String, accept : String) -> String {
  let at = raw.index_of("{ACCEPT}")
  if at < 0 {
    raw
  } else {
    raw.slice(0, at) + accept + raw.slice(at + 8, raw.length())
  }
}

///|
fn run_hs_case(line : String) -> String {
  let parts = line.split(" ")
  let key = "dGhlIHNhbXBsZSBub25jZQ=="
  let raw = fill_accept(hex_decode(parts[2]).to_string(), websocket::compute_accept_key(key))
  let ok = if parts[1] == "req" {
    match websocket::parse_client_handshake(raw) {
      Ok(r) => "OK key=" + r.key
      Err(_) => "ERR"
    }
  } else {
    match websocket::verify_server_handshake(raw, key, []) {
      Ok(_) => "OK"
      Err(_) => "ERR"
    }
  }
  parts[0] + " " + ok
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() == 3 && args[1] == "hs" {
    let text = match fs_read(world, args[2]) {
      Ok(t) => t
      Err(_) => return 2
    }
    let lines = text.split("\n")
    let mut i = 0
    while i < lines.length() {
      if lines[i].length() > 0 {
        io_println(world, run_hs_case(lines[i]))
      }
      i = i + 1
    }
    // Builder: a subprotocol carrying CRLF must not reach the wire as an extra header.
    let built = websocket::build_client_handshake("example.com", "/ws", key_const(), ["chat\r\nX-Evil: 1"])
    io_println(
      world,
      if built.index_of("\r\nX-Evil: 1\r\n") >= 0 {
        "builder_crlf_subprotocol INJECTED"
      } else {
        "builder_crlf_subprotocol REJECTED"
      },
    )
    return 0
  }
  if args.length() < 2 {
    io_eprintln(world, "usage: diff_pion <corpus>")
    return 2
  }
  let text = match fs_read(world, args[1]) {
    Ok(t) => t
    Err(_) => {
      io_eprintln(world, "cannot read corpus")
      return 2
    }
  }
  let lines = text.split("\n")
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    if l.length() > 0 {
      io_println(world, run_case(l))
    }
    i = i + 1
  }
  0
}
