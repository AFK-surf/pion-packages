///| Red-team prosecution suite for `packages/websocket` (audit/redteam-websocket).
///|
///| Every test asserts the RFC 6455 / RFC 7230 / Autobahn-strict behaviour, which
///| Rust `tungstenite` 0.26.2 and/or Go `coder/websocket` v1.8.14 exhibit on the same
///| bytes (see `audit/diff`). A FAILING test is evidence against the Pion package.
///| Tests prefixed `control_` are negative controls that are expected to PASS: they
///| document attack surface that was probed and found sound.

import "websocket"

///|
fn bytes_of(vals : Array[Int]) -> Bytes {
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn cat(parts : Array[Bytes]) -> Bytes {
  let mut n = 0
  let mut i = 0
  while i < parts.length() {
    n = n + parts[i].length()
    i = i + 1
  }
  let mut out = Bytes::new(n)
  let mut off = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      out[off + j] = p[j]
      j = j + 1
    }
    off = off + p.length()
    i = i + 1
  }
  out
}

///| Masked client->server frame.
fn cframe(fin : Bool, op : websocket::Opcode, payload : Bytes) -> Bytes {
  websocket::encode_frame(websocket::Frame::new(fin, op, Some(0x37FA213DU), payload))
}

///| Result of decoding a whole stream: number of data messages before the first error,
///| and whether an error was reported at all.
struct Outcome {
  texts : Int
  binaries : Int
  closes : Int
  errored : Bool
  data_after_close : Int
}

///|
fn drain(d : websocket::Decoder, acc : Outcome) -> Outcome {
  let mut texts = acc.texts
  let mut bins = acc.binaries
  let mut closes = acc.closes
  let mut after = acc.data_after_close
  while true {
    match d.next_message() {
      Ok(Some(websocket::Message::Text(_))) => {
        texts = texts + 1
        if closes > 0 {
          after = after + 1
        }
      }
      Ok(Some(websocket::Message::Binary(_))) => {
        bins = bins + 1
        if closes > 0 {
          after = after + 1
        }
      }
      Ok(Some(websocket::Message::Close(_))) => closes = closes + 1
      Ok(Some(_)) => ()
      Ok(None) => break
      Err(_) =>
      return Outcome::{
        texts,
        binaries: bins,
        closes,
        errored: true,
        data_after_close: after,
      }
    }
  }
  Outcome::{ texts, binaries: bins, closes, errored: false, data_after_close: after }
}

///| Feed `wire` `step` bytes at a time (0 = whole), draining after every feed.
fn run(role : websocket::Role, max : Int, wire : Bytes, step : Int) -> Outcome {
  let d = websocket::Decoder::new(role, max)
  let mut acc = Outcome::{
    texts: 0,
    binaries: 0,
    closes: 0,
    errored: false,
    data_after_close: 0,
  }
  let n = wire.length()
  let s = if step == 0 { n } else { step }
  let mut off = 0
  while off < n {
    let end = if off + s > n { n } else { off + s }
    d.feed(wire.slice(off, end))
    off = end
    acc = drain(d, acc)
    if acc.errored {
      return acc
    }
  }
  acc
}

///|
fn kosme() -> Bytes {
  "κόσμε".to_bytes()
}

// ---------------------------------------------------------------------------
// P1 — Autobahn 6.4.x: UTF-8 must fail fast on the first invalid fragment.
// tungstenite: ERR 1007 immediately. Pion: keeps buffering until FIN.
// ---------------------------------------------------------------------------

///|
test "p1_autobahn_6_4_1_utf8_failfast_before_final_fragment" {
  // valid "κόσμε" | invalid F4 90 80 80 | (final fragment never arrives)
  let wire = cat([
    cframe(false, websocket::Opcode::Text, kosme()),
    cframe(false, websocket::Opcode::Continuation, bytes_of([0xF4, 0x90, 0x80, 0x80])),
  ])
  debug_assert(
    run(websocket::Role::Server, 65536, wire, 0).errored,
    "6.4.1: invalid UTF-8 in fragment 2 must fail the connection without waiting for FIN",
  )
}

///|
test "p1_autobahn_6_4_2_utf8_failfast_split_codepoint" {
  let wire = cat([
    cframe(false, websocket::Opcode::Text, cat([kosme(), bytes_of([0xF4])])),
    cframe(false, websocket::Opcode::Continuation, bytes_of([0x90, 0x80, 0x80])),
  ])
  debug_assert(
    run(websocket::Role::Server, 65536, wire, 0).errored,
    "6.4.2: F4 | 90 80 80 can never be valid, must fail fast",
  )
}

///|
test "p1_utf8_failfast_first_fragment_0xff" {
  let wire = cframe(false, websocket::Opcode::Text, bytes_of([0x61, 0x62, 0x63, 0xFF]))
  debug_assert(
    run(websocket::Role::Server, 65536, wire, 0).errored,
    "0xFF in the first fragment must fail immediately",
  )
}

///|
test "p1_utf8_failfast_first_fragment_overlong_and_surrogate" {
  let overlong = cframe(false, websocket::Opcode::Text, bytes_of([0xC0, 0x80]))
  let surrogate = cframe(false, websocket::Opcode::Text, bytes_of([0xED, 0xA0, 0x80]))
  debug_assert(run(websocket::Role::Server, 65536, overlong, 0).errored, "C0 80 must fail fast")
  debug_assert(run(websocket::Role::Server, 65536, surrogate, 0).errored, "ED A0 80 must fail fast")
}

///|
test "p1_utf8_failfast_1_byte_drip" {
  let wire = cat([
    cframe(false, websocket::Opcode::Text, kosme()),
    cframe(false, websocket::Opcode::Continuation, bytes_of([0xF4, 0x90, 0x80, 0x80])),
  ])
  debug_assert(
    run(websocket::Role::Server, 65536, wire, 1).errored,
    "fail-fast must not depend on chunking",
  )
}

///| A 1 MiB-limit server is fed 1000 invalid fragments; it must stop at the first one
///| instead of buffering ~1 MiB of known-garbage text.
test "p1_utf8_failfast_bounds_garbage_buffering" {
  let mut parts : Array[Bytes] = [cframe(false, websocket::Opcode::Text, bytes_of([0xFF]))]
  let junk = Bytes::new(1000)
  let mut i = 0
  while i < 1000 {
    parts.push(cframe(false, websocket::Opcode::Continuation, junk))
    i = i + 1
  }
  let o = run(websocket::Role::Server, 1048576, cat(parts), 0)
  debug_assert(o.errored, "must reject at fragment 1, not keep buffering")
}

// ---------------------------------------------------------------------------
// P0 — 32-bit `frame_total` overflow -> remote panic (process abort).
// ---------------------------------------------------------------------------

///|
fn hdr64(b0 : Int, masked : Bool, len : Int) -> Bytes {
  let mut b = Bytes::new(if masked { 14 } else { 10 })
  b[0] = b0.to_byte()
  b[1] = (if masked { 0xFF } else { 0x7F }).to_byte()
  b[6] = ((len >> 24) & 0xFF).to_byte()
  b[7] = ((len >> 16) & 0xFF).to_byte()
  b[8] = ((len >> 8) & 0xFF).to_byte()
  b[9] = (len & 0xFF).to_byte()
  b
}

///|
test "p0_int_max_limit_len64_overflow_must_not_panic_server" {
  // max_message_size = Int max ("unlimited"); header declares 0x7FFFFFF8 bytes,
  // only 16 payload bytes follow. 14 + 0x7FFFFFF8 wraps negative in 32-bit Int.
  let d = websocket::Decoder::new(websocket::Role::Server, 2147483647)
  d.feed(hdr64(0x82, true, 2147483640))
  d.feed(Bytes::new(16))
  let ok = match d.next_message() {
    Ok(None) => true
    _ => false
  }
  debug_assert(ok, "must wait for the payload (Ok(None)); Pion panics: index out of bounds")
}

///|
test "p0_int_max_limit_len64_overflow_must_not_panic_client" {
  let d = websocket::Decoder::new(websocket::Role::Client, 2147483647)
  d.feed(hdr64(0x82, false, 2147483645))
  d.feed(Bytes::new(16))
  let ok = match d.next_message() {
    Ok(None) => true
    _ => false
  }
  debug_assert(ok, "client role: 10 + 0x7FFFFFFD wraps negative -> panic")
}

// ---------------------------------------------------------------------------
// P2 — close state machine: nothing after the first Close is delivered.
// tungstenite and coder/websocket both stop at the Close.
// ---------------------------------------------------------------------------

///|
test "p2_no_data_delivered_after_close" {
  let wire = cat([
    websocket::encode_frame(
      websocket::Frame::close(Some(websocket::CloseFrame::new(1000, "")), Some(1U)),
    ),
    cframe(true, websocket::Opcode::Text, "after".to_bytes()),
  ])
  let o = run(websocket::Role::Server, 65536, wire, 0)
  debug_assert(o.data_after_close == 0, "RFC 6455 §1.4/§5.5.1: data after Close must not reach the app")
}

///|
test "p2_second_close_not_delivered" {
  let c1 = websocket::encode_frame(
    websocket::Frame::close(Some(websocket::CloseFrame::new(1000, "")), Some(1U)),
  )
  let c2 = websocket::encode_frame(
    websocket::Frame::close(Some(websocket::CloseFrame::new(1001, "")), Some(1U)),
  )
  let o = run(websocket::Role::Server, 65536, cat([c1, c2]), 0)
  debug_assert(o.closes == 1, "only the first Close may be processed")
}

// ---------------------------------------------------------------------------
// P1 — handshake builders: CRLF header injection (Go net/http and Rust http
// both reject such values; Pion emits them verbatim).
// ---------------------------------------------------------------------------

///|
test "p1_build_client_handshake_rejects_crlf_in_subprotocol" {
  let req = websocket::build_client_handshake(
    "example.com",
    "/ws",
    "dGhlIHNhbXBsZSBub25jZQ==",
    ["chat\r\nX-Evil: 1"],
  )
  debug_assert(req.index_of("\r\nX-Evil: 1\r\n") < 0, "subprotocol CRLF injected a header")
}

///|
test "p1_build_client_handshake_rejects_crlf_in_host_and_path" {
  let r1 = websocket::build_client_handshake(
    "example.com\r\nCookie: stolen=1",
    "/ws",
    "dGhlIHNhbXBsZSBub25jZQ==",
    [],
  )
  let r2 = websocket::build_client_handshake(
    "example.com",
    "/ws HTTP/1.1\r\nX-Evil: 1\r\nX-Pad:",
    "dGhlIHNhbXBsZSBub25jZQ==",
    [],
  )
  debug_assert(r1.index_of("\r\nCookie: stolen=1\r\n") < 0, "host CRLF injected a header")
  debug_assert(r2.index_of("\r\nX-Evil: 1\r\n") < 0, "path CRLF injected a header")
}

///|
test "p1_build_server_handshake_rejects_crlf_in_protocol" {
  let resp = websocket::build_server_handshake(
    "dGhlIHNhbXBsZSBub25jZQ==",
    Some("chat\r\nSet-Cookie: session=attacker"),
  )
  debug_assert(resp.index_of("\r\nSet-Cookie: session=attacker\r\n") < 0, "response splitting")
}

// ---------------------------------------------------------------------------
// P2 — handshake parsers are laxer than both references.
// ---------------------------------------------------------------------------

///|
fn base_req(extra : String) -> String {
  "GET /ws HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n" +
  extra +
  "\r\n"
}

///|
fn accept_resp(extra : String) -> String {
  "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n" +
  extra +
  "\r\n"
}

///|
test "p2_verify_server_handshake_rejects_unoffered_extension" {
  // RFC 6455 §4.1 (5): an extension not requested by the client -> client MUST fail.
  // coder/websocket fails; Pion and tungstenite accept.
  let r = websocket::verify_server_handshake(
    accept_resp("Sec-WebSocket-Extensions: permessage-deflate\r\n"),
    "dGhlIHNhbXBsZSBub25jZQ==",
    [],
  )
  let rejected = match r {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "unrequested permessage-deflate accepted -> RSV1 frames will then be rejected")
}

///|
test "p2_verify_server_handshake_rejects_duplicate_accept" {
  // A bogus first Sec-WebSocket-Accept followed by the correct one: Pion takes the
  // last value and accepts; tungstenite and coder/websocket reject.
  let raw = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: AAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  let rejected = match websocket::verify_server_handshake(raw, "dGhlIHNhbXBsZSBub25jZQ==", []) {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "duplicate Sec-WebSocket-Accept must be rejected")
}

///|
test "p2_parse_client_handshake_rejects_duplicate_key" {
  // Pion keeps the LAST key, tungstenite the FIRST: a proxy and a backend disagree on
  // the Accept value. coder/websocket rejects.
  let raw = base_req("Sec-WebSocket-Key: AQIDBAUGBwgJCgsMDQ4PEA==\r\n")
  let rejected = match websocket::parse_client_handshake(raw) {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "duplicate Sec-WebSocket-Key must be rejected")
}

///|
test "p2_parse_client_handshake_rejects_control_chars_in_value" {
  // RFC 7230 §3.2: field-value is VCHAR / obs-text / SP / HTAB. Both references reject.
  let rejected = match websocket::parse_client_handshake(base_req("X-Evil: a\u{01}b\r\n")) {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "control characters in header values must be rejected")
}

///|
test "p2_parse_client_handshake_rejects_space_before_colon" {
  // RFC 7230 §3.2.4: "No whitespace is allowed between the header field-name and colon.
  // A server MUST reject any received request message that contains whitespace between
  // a header field-name and colon with a response code of 400". tungstenite rejects.
  let raw = "GET /ws HTTP/1.1\r\nHost : example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  let rejected = match websocket::parse_client_handshake(raw) {
    Err(_) => true
    Ok(_) => false
  }
  debug_assert(rejected, "whitespace before colon must be rejected (request smuggling vector)")
}

// ---------------------------------------------------------------------------
// GAP — permessage-deflate (RFC 7692, Autobahn §12/§13: 216 cases).
// coder/websocket implements it; Pion has no extension API at all, so a peer that
// negotiates it cannot be served. This test documents the gap with the RFC 7692
// §7.2.3.1 "Hello" vector.
// ---------------------------------------------------------------------------

///|
test "gap_rfc7692_permessage_deflate_hello" {
  // c1 07 f2 48 cd c9 c9 07 00 = compressed "Hello" (unmasked, server->client)
  let d = websocket::Decoder::new(websocket::Role::Client, 65536)
  d.feed(bytes_of([0xC1, 0x07, 0xF2, 0x48, 0xCD, 0xC9, 0xC9, 0x07, 0x00]))
  let ok = match d.next_message() {
    Ok(Some(websocket::Message::Text(s))) => s == "Hello"
    _ => false
  }
  debug_assert(ok, "no permessage-deflate support (and no API to negotiate it)")
}

// ---------------------------------------------------------------------------
// Negative controls (expected to PASS): probed and found sound.
// ---------------------------------------------------------------------------

///|
test "control_1_byte_drip_with_interleaved_controls" {
  let wire = cat([
    cframe(false, websocket::Opcode::Text, bytes_of([0xF0, 0x9F])),
    cframe(true, websocket::Opcode::Ping, Bytes::new(125)),
    cframe(false, websocket::Opcode::Continuation, bytes_of([0x8C])),
    cframe(true, websocket::Opcode::Pong, Bytes::new(0)),
    cframe(true, websocket::Opcode::Continuation, bytes_of([0x8D])),
    cframe(true, websocket::Opcode::Binary, Bytes::new(70000)),
  ])
  let a = run(websocket::Role::Server, 1048576, wire, 1)
  let b = run(websocket::Role::Server, 1048576, wire, 0)
  debug_assert(!a.errored && a.texts == 1 && a.binaries == 1, "drip decode")
  debug_assert(b.texts == a.texts && b.binaries == a.binaries, "drip == whole")
}

///|
test "control_len64_msb_and_huge_lengths_fail_fast" {
  let mut msb = hdr64(0x82, true, 0)
  msb[2] = 0x80.to_byte()
  debug_assert(run(websocket::Role::Server, 65536, msb, 1).errored, "MSB set")
  let mut huge = hdr64(0x82, true, 0)
  huge[2] = 0x7F.to_byte()
  huge[3] = 0xFF.to_byte()
  debug_assert(run(websocket::Role::Server, 65536, huge, 0).errored, "0x7FFF... rejected on header")
}

///|
test "control_bad_control_frames" {
  let ping126 = cframe(true, websocket::Opcode::Ping, Bytes::new(126))
  let ping_frag = cframe(false, websocket::Opcode::Ping, Bytes::new(1))
  let close1 = cframe(true, websocket::Opcode::Close, bytes_of([0x03]))
  debug_assert(run(websocket::Role::Server, 65536, ping126, 1).errored, "126-byte ping")
  debug_assert(run(websocket::Role::Server, 65536, ping_frag, 0).errored, "FIN=0 ping")
  debug_assert(run(websocket::Role::Server, 65536, close1, 0).errored, "1-byte close")
}

///|
test "control_fragment_bomb_over_limit_rejected" {
  let mut parts : Array[Bytes] = [cframe(false, websocket::Opcode::Binary, Bytes::new(600))]
  parts.push(cframe(true, websocket::Opcode::Continuation, Bytes::new(600)))
  debug_assert(run(websocket::Role::Server, 1024, cat(parts), 0).errored, "600+600 > 1024")
}
