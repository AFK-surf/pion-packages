///| Crash probes that must run in their own process (a crash would take down `pionc test`).
///| usage: probe <name>
///|   overflow_len64   max_message_size = Int max, 64-bit length 0x7FFFFFF8 (frame_total wraps negative)
///|   queue_retention  feed two frames ahead of the drain for N rounds, print retained RSS proxy

import "websocket"

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn hdr64(len : Int) -> Bytes {
  let mut b = Bytes::new(14)
  b[0] = 0x82.to_byte()
  b[1] = 0xFF.to_byte()
  b[6] = ((len >> 24) & 0xFF).to_byte()
  b[7] = ((len >> 16) & 0xFF).to_byte()
  b[8] = ((len >> 8) & 0xFF).to_byte()
  b[9] = (len & 0xFF).to_byte()
  b
}

///|
fn frame_of(size : Int, key : UInt) -> Bytes {
  websocket::encode_frame(websocket::Frame::binary(Bytes::new(size), Some(key)))
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let name = if args.length() > 1 { args[1] } else { "" }
  if name == "overflow_len64" {
    // Only the 14-byte header plus 16 payload bytes are on the wire.
    let d = websocket::Decoder::new(websocket::Role::Server, 2147483647)
    d.feed(hdr64(2147483640))
    d.feed(Bytes::new(16))
    match d.next_message() {
      Ok(None) => io_println(world, "overflow_len64: Ok(None) (correct: waiting for payload)")
      Ok(Some(_)) => io_println(world, "overflow_len64: BUG returned a message from 30 wire bytes")
      Err(e) => io_println(world, "overflow_len64: Err " + websocket::ws_error_string(e))
    }
    return 0
  }
  if name == "queue_retention" || name == "queue_drain" {
    let rounds = if args.length() > 2 { parse_int(args[2]) } else { 20000 }
    let size = 65536
    let d = websocket::Decoder::new(websocket::Role::Server, 1 << 20)
    let mut got = 0
    let ahead = if name == "queue_retention" { 2 } else { 0 }
    let mut fed = 0
    // Producer keeps `ahead` whole frames buffered beyond the one being drained
    while fed < ahead {
      d.feed(frame_of(size, 0x11223344U))
      fed = fed + 1
    }
    let mut r = 0
    while r < rounds {
      d.feed(frame_of(size, 0x11223344U))
      fed = fed + 1
      match d.next_message() {
        Ok(Some(_)) => got = got + 1
        _ => ()
      }
      r = r + 1
    }
    io_println(world, name + ": rounds=" + rounds.to_string() + " msgs=" + got.to_string() + " buffered_len=" + d.buffered_len().to_string())
    return 0
  }
  io_eprintln(world, "unknown probe")
  2
}
