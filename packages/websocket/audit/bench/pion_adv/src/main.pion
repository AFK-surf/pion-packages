///| Red-team adversarial benchmark: Pion `packages/websocket` Decoder.
///| usage: adv <wire.ws> <chunk_bytes> <msgs_per_round> <rounds>
///| Feeds the wire stream `chunk_bytes` at a time (like socket reads) and drains after every feed.

import "websocket"

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn fold(h : Int64, v : Int64) -> Int64 {
  (h * 31L + v) & 0x1FFFFFFFFFFFFFFFL
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let wire = match fs_read_bytes(world, args[1]) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read wire file")
      return 2
    }
  }
  let chunk = parse_int(args[2])
  let d = websocket::Decoder::new(websocket::Role::Server, 33554432)
  let mut msgs = 0
  let mut h : Int64 = 7L
  let rounds = parse_int(args[4])
  let n = wire.length()
  let mut r = 0
  while r < rounds {
    let mut off = 0
    while off < n {
      let end = if off + chunk > n { n } else { off + chunk }
      d.feed(wire.slice(off, end))
      off = end
      while true {
        match d.next_message() {
          Ok(Some(websocket::Message::Binary(b))) => {
            let l = b.length()
            msgs = msgs + 1
            let v = l.to_int64() +
            b[0].to_int().to_int64() +
            b[l / 2].to_int().to_int64() * 256L +
            b[l - 1].to_int().to_int64() * 65536L
            h = fold(h, v)
          }
          Ok(Some(websocket::Message::Text(_))) => {
            msgs = msgs + 1
            h = fold(h, 1L)
          }
          Ok(Some(_)) => ()
          Ok(None) => break
          Err(e) => {
            io_eprintln(world, "decode error: " + websocket::ws_error_string(e))
            return 1
          }
        }
      }
    }
    r = r + 1
  }
  io_println(world, "msgs=" + msgs.to_string())
  io_println(world, "digest=" + h.to_string())
  0
}
