///| Regression unit tests for red-team audit findings (P0, P1, P2).

///|
fn rt_hdr64(b0 : Int, masked : Bool, len : Int) -> Bytes {
  let mut b = Bytes::new(if masked { 14 } else { 10 })
  b[0] = b0.to_byte()
  b[1] = (if masked { 0xFF } else { 0x7F }).to_byte()
  b[6] = ((len >> 24) & 0xFF).to_byte()
  b[7] = ((len >> 16) & 0xFF).to_byte()
  b[8] = ((len >> 8) & 0xFF).to_byte()
  b[9] = (len & 0xFF).to_byte()
  b
}

///|
test "rt_p0_queue_compaction_producer_ahead" {
  let d = Decoder::new(Role::Server, 65536)
  let frame = encode_frame(Frame::binary(Bytes::new(1024), Some(0x11223344U)))
  d.feed(frame)
  d.feed(frame)
  let mut i = 0
  while i < 200 {
    d.feed(frame)
    match d.next_message() {
      Ok(Some(Message::Binary(b))) => debug_assert(b.length() == 1024, "1024B payload")
      _ => debug_assert(false, "expected binary message")
    }
    i = i + 1
  }
  debug_assert(d.buffered_len() == frame.length() * 2, "exactly 2 frames remain buffered")
}

///|
test "rt_p0_frame_total_64bit_no_overflow" {
  let ds = Decoder::new(Role::Server, 2147483647)
  ds.feed(rt_hdr64(0x82, true, 2147483640))
  ds.feed(Bytes::new(16))
  match ds.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "server int max len64 must return Ok(None)")
  }

  let dc = Decoder::new(Role::Client, 2147483647)
  dc.feed(rt_hdr64(0x82, false, 2147483645))
  dc.feed(Bytes::new(16))
  match dc.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "client int max len64 must return Ok(None)")
  }
}

///|
test "rt_p1_utf8_incremental_failfast" {
  let d = Decoder::new(Role::Server, 65536)
  let f1 = encode_frame(Frame::new(false, Opcode::Text, Some(1U), "κόσμε".to_bytes()))
  let f2 = encode_frame(
    Frame::new(false, Opcode::Continuation, Some(2U), bytes_from_arr([0xF4, 0x90, 0x80, 0x80])),
  )
  d.feed(f1)
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "valid first fragment waits")
  }
  d.feed(f2)
  match d.next_message() {
    Err(WsError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "invalid second fragment must fail fast with InvalidUtf8")
  }
}

///|
test "rt_p1_try_build_handshake_crlf_rejected" {
  match
  try_build_client_handshake(
    "example.com\r\nCookie: a=1",
    "/ws",
    "dGhlIHNhbXBsZSBub25jZQ==",
    [],
  ) {
    Err(WsError::InvalidHandshake(_)) => ()
    _ => debug_assert(false, "host CRLF must fail")
  }
  match
  try_build_client_handshake(
    "example.com",
    "/ws HTTP/1.1\r\nX-Evil: 1",
    "dGhlIHNhbXBsZSBub25jZQ==",
    [],
  ) {
    Err(WsError::InvalidHandshake(_)) => ()
    _ => debug_assert(false, "path CRLF must fail")
  }
  match
  try_build_client_handshake(
    "example.com",
    "/ws",
    "dGhlIHNhbXBsZSBub25jZQ==",
    ["chat\r\nX-Evil: 1"],
  ) {
    Err(WsError::InvalidHandshake(_)) => ()
    _ => debug_assert(false, "subprotocol CRLF must fail")
  }
  match try_build_server_handshake("dGhlIHNhbXBsZSBub25jZQ==", Some("chat\r\nSet-Cookie: x=1")) {
    Err(WsError::InvalidHandshake(_)) => ()
    _ => debug_assert(false, "server protocol CRLF must fail")
  }
  debug_assert(
    build_client_handshake("example.com\r\nX: 1", "/ws", "dGhlIHNhbXBsZSBub25jZQ==", []) == "",
    "legacy builder returns empty on CRLF",
  )
  debug_assert(
    build_server_handshake("dGhlIHNhbXBsZSBub25jZQ==", Some("a\r\nB: 1")) == "",
    "legacy server builder returns empty on CRLF",
  )
}

///|
test "rt_p2_close_state_and_reset" {
  let d = Decoder::new(Role::Server, 65536)
  d.feed(encode_frame(Frame::close(Some(CloseFrame::new(1000, "bye")), Some(1U))))
  d.feed(encode_frame(Frame::text("after", Some(2U))))
  d.feed(encode_frame(Frame::close(Some(CloseFrame::new(1001, "")), Some(3U))))
  match d.next_message() {
    Ok(Some(Message::Close(Some(cf)))) => debug_assert(cf.code == 1000, "first close delivered")
    _ => debug_assert(false, "expected first close")
  }
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "nothing delivered after close")
  }
  d.reset()
  d.feed(encode_frame(Frame::text("reused", Some(4U))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "reused", "reset clears closed state")
    _ => debug_assert(false, "expected text after reset")
  }
}

///|
test "rt_p2_strict_handshake_headers" {
  let dup_key = "GET /ws HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Key: AQIDBAUGBwgJCgsMDQ4PEA==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  debug_assert(is_err_req(parse_client_handshake(dup_key)), "duplicate key rejected")

  let space_colon = "GET /ws HTTP/1.1\r\nHost : example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  debug_assert(is_err_req(parse_client_handshake(space_colon)), "space before colon rejected")

  let ctl_val = "GET /ws HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nX-Evil: a\u{01}b\r\n\r\n"
  debug_assert(is_err_req(parse_client_handshake(ctl_val)), "CTL in value rejected")

  let dup_accept = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: AAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  debug_assert(
    is_err_resp(verify_server_handshake(dup_accept, "dGhlIHNhbXBsZSBub25jZQ==", [])),
    "duplicate accept rejected",
  )

  let unoffered_ext = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n"
  debug_assert(
    is_err_resp(verify_server_handshake(unoffered_ext, "dGhlIHNhbXBsZSBub25jZQ==", [])),
    "unoffered extension rejected",
  )
}
