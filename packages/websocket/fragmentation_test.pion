///| RFC 6455 & Autobahn §5 fragmentation and interleaved control frame tests (25 tests).

///|
test "autobahn_5_1_fragmented_ping_rejected" {
  let wire = encode_frame(Frame::new(false, Opcode::Ping, None, "hi".to_bytes()))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "fragmented ping rejected")
}

///|
test "autobahn_5_2_fragmented_pong_rejected" {
  let wire = encode_frame(Frame::new(false, Opcode::Pong, None, "hi".to_bytes()))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "fragmented pong rejected")
}

///|
test "autobahn_5_2b_fragmented_close_rejected" {
  let wire = encode_frame(Frame::new(false, Opcode::Close, None, Bytes::new(0)))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "fragmented close rejected")
}

///|
test "autobahn_2_4_ping_126_bytes_rejected" {
  let wire = encode_frame(Frame::ping(make_pattern_bytes(126), None))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "ping >125 rejected")
}

///|
test "autobahn_2_4b_pong_126_bytes_rejected" {
  let wire = encode_frame(Frame::pong(make_pattern_bytes(126), None))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "pong >125 rejected")
}

///|
test "autobahn_2_4c_close_126_bytes_rejected" {
  let wire = encode_frame(Frame::new(true, Opcode::Close, None, make_pattern_bytes(126)))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "close >125 rejected")
}

///|
test "autobahn_2_3_ping_125_bytes_accepted" {
  let payload = make_pattern_bytes(125)
  let wire = encode_frame(Frame::ping(payload, Some(0x12345678U)))
  let d = Decoder::new(Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Ping(b))) => debug_assert(bytes_eq(b, payload), "ping 125 ok")
    _ => debug_assert(false, "expected ping 125")
  }
}

///|
test "autobahn_2_3b_pong_125_bytes_accepted" {
  let payload = make_pattern_bytes(125)
  let wire = encode_frame(Frame::pong(payload, None))
  let d = Decoder::new(Role::Client, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Pong(b))) => debug_assert(bytes_eq(b, payload), "pong 125 ok")
    _ => debug_assert(false, "expected pong 125")
  }
}

///|
test "autobahn_5_3_two_fragment_text" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "Hel".to_bytes())))
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "should wait for continuation")
  }
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, "lo!".to_bytes())))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "Hello!", "reassembled text")
    _ => debug_assert(false, "expected Hello!")
  }
}

///|
test "autobahn_5_4_three_fragment_text" {
  let d = Decoder::new(Role::Server, 65536)
  let k = Some(0x11223344U)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, k, "one-".to_bytes())))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, k, "two-".to_bytes())))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, k, "three".to_bytes())))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "one-two-three", "3-frag text")
    _ => debug_assert(false, "expected 3-frag text")
  }
}

///|
test "autobahn_5_5_ten_fragment_binary" {
  let d = Decoder::new(Role::Client, 65536)
  let mut i = 0
  while i < 10 {
    let op = if i == 0 { Opcode::Binary } else { Opcode::Continuation }
    let fin = i == 9
    d.feed(encode_frame(Frame::new(fin, op, None, bytes_from_arr([i, i + 10]))))
    i = i + 1
  }
  match d.next_message() {
    Ok(Some(Message::Binary(b))) => {
      debug_assert(b.length() == 20, "20 bytes")
      let mut j = 0
      while j < 10 {
        debug_assert(b[j * 2].to_int() == j, "even byte")
        debug_assert(b[j * 2 + 1].to_int() == j + 10, "odd byte")
        j = j + 1
      }
    }
    _ => debug_assert(false, "expected 10-frag binary")
  }
}

///|
test "autobahn_5_6_ping_interleaved_in_text_fragments" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "fragment1-".to_bytes())))
  d.feed(encode_frame(Frame::ping("in-the-middle".to_bytes(), None)))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, "fragment2".to_bytes())))
  match d.next_message() {
    Ok(Some(Message::Ping(p))) => debug_assert(p.to_string() == "in-the-middle", "interleaved ping")
    _ => debug_assert(false, "expected interleaved ping first")
  }
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "fragment1-fragment2", "reassembled text after ping")
    _ => debug_assert(false, "expected reassembled text")
  }
}

///|
test "autobahn_5_7_pong_interleaved_in_binary_fragments" {
  let d = Decoder::new(Role::Server, 65536)
  let k = Some(0x55667788U)
  d.feed(encode_frame(Frame::new(false, Opcode::Binary, k, bytes_from_arr([1, 2]))))
  d.feed(encode_frame(Frame::pong(bytes_from_arr([9, 8]), k)))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, k, bytes_from_arr([3, 4]))))
  match d.next_message() {
    Ok(Some(Message::Pong(p))) => debug_assert(bytes_eq(p, bytes_from_arr([9, 8])), "interleaved pong")
    _ => debug_assert(false, "expected interleaved pong")
  }
  match d.next_message() {
    Ok(Some(Message::Binary(b))) => debug_assert(bytes_eq(b, bytes_from_arr([1, 2, 3, 4])), "reassembled bin")
    _ => debug_assert(false, "expected reassembled bin")
  }
}

///|
test "autobahn_5_8_multiple_controls_interleaved" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "A".to_bytes())))
  d.feed(encode_frame(Frame::ping("p1".to_bytes(), None)))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, None, "B".to_bytes())))
  d.feed(encode_frame(Frame::pong("p2".to_bytes(), None)))
  d.feed(encode_frame(Frame::ping("p3".to_bytes(), None)))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, "C".to_bytes())))
  match d.next_message() {
    Ok(Some(Message::Ping(p))) => debug_assert(p.to_string() == "p1", "p1")
    _ => debug_assert(false, "expected p1")
  }
  match d.next_message() {
    Ok(Some(Message::Pong(p))) => debug_assert(p.to_string() == "p2", "p2")
    _ => debug_assert(false, "expected p2")
  }
  match d.next_message() {
    Ok(Some(Message::Ping(p))) => debug_assert(p.to_string() == "p3", "p3")
    _ => debug_assert(false, "expected p3")
  }
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "ABC", "ABC")
    _ => debug_assert(false, "expected ABC")
  }
}

///|
test "autobahn_5_9_orphan_continuation_non_final_rejected" {
  let wire = encode_frame(Frame::new(false, Opcode::Continuation, None, "bad".to_bytes()))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "orphan cont fin=0 rejected")
}

///|
test "autobahn_5_10_orphan_continuation_final_rejected" {
  let wire = encode_frame(Frame::new(true, Opcode::Continuation, None, "bad".to_bytes()))
  debug_assert(decode_single_err(Role::Client, 65536, wire), "orphan cont fin=1 rejected")
}

///|
test "autobahn_5_11_orphan_continuation_after_complete_message_rejected" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::text("ok", None)))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, "bad".to_bytes())))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "ok", "first ok")
    _ => debug_assert(false, "expected ok")
  }
  match d.next_message() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "orphan cont after complete msg rejected")
  }
}

///|
test "autobahn_5_12_new_text_frame_during_fragmentation_rejected" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "part1".to_bytes())))
  d.feed(encode_frame(Frame::text("unexpected", None)))
  match d.next_message() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "new text during frag rejected")
  }
}

