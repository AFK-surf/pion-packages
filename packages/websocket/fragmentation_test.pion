  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "part1".to_bytes())))
  d.feed(encode_frame(Frame::binary(bytes_from_arr([1, 2]), None)))
  match d.next_message() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "new binary during text frag rejected")
  }
}

///|
test "autobahn_5_14_new_text_frame_during_binary_fragmentation_rejected" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Binary, None, bytes_from_arr([1]))))
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "x".to_bytes())))
  match d.next_message() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "new text during binary frag rejected")
  }
}

///|
test "autobahn_5_15_empty_fragments_all_empty" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, Bytes::new(0))))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, None, Bytes::new(0))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, Bytes::new(0))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "", "empty text from empty frags")
    _ => debug_assert(false, "expected empty text")
  }
}

///|
test "autobahn_5_16_empty_initial_and_final_fragments" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, Bytes::new(0))))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, None, "middle".to_bytes())))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, Bytes::new(0))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "middle", "middle")
    _ => debug_assert(false, "expected middle")
  }
}

///|
test "autobahn_5_17_fragmented_exceeds_max_message_size_rejected" {
  let d = Decoder::new(Role::Client, 10)
  d.feed(encode_frame(Frame::new(false, Opcode::Binary, None, make_pattern_bytes(6))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, make_pattern_bytes(5))))
  match d.next_message() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "fragmented > max_message_size rejected")
  }
}

///|
test "autobahn_5_18_close_interleaved_during_fragmentation" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "partial".to_bytes())))
  d.feed(encode_frame(Frame::close(Some(CloseFrame::new(1000, "done")), None)))
  match d.next_message() {
    Ok(Some(Message::Close(Some(cf)))) => {
      debug_assert(cf.code == 1000, "close code 1000")
      debug_assert(cf.reason == "done", "close reason")
    }
    _ => debug_assert(false, "expected interleaved close")
  }
}

///|
test "autobahn_5_19_back_to_back_fragmented_messages" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, "first-".to_bytes())))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, "one".to_bytes())))
  d.feed(encode_frame(Frame::new(false, Opcode::Binary, None, bytes_from_arr([0xAA]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, bytes_from_arr([0xBB]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "first-one", "first-one")
    _ => debug_assert(false, "expected first-one")
  }
  match d.next_message() {
    Ok(Some(Message::Binary(b))) => debug_assert(bytes_eq(b, bytes_from_arr([0xAA, 0xBB])), "AABB")
    _ => debug_assert(false, "expected AABB")
  }
}
