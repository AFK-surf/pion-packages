///| RFC 6455 & Autobahn §7 close codes and streaming half/sticky packet tests (38 tests).

///|
fn close_code_frame(code : Int) -> Bytes {
  let payload = bytes_from_arr([(code >> 8) & 0xFF, code & 0xFF])
  encode_frame(Frame::new(true, Opcode::Close, None, payload))
}

///|
fn decode_close_ok(code : Int) -> Bool {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(close_code_frame(code))
  match d.next_message() {
    Ok(Some(Message::Close(Some(cf)))) => cf.code == code && cf.reason == ""
    _ => false
  }
}

///|
fn decode_close_err(code : Int) -> Bool {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(close_code_frame(code))
  match d.next_message() {
    Err(_) => true
    Ok(_) => false
  }
}

///|
test "autobahn_7_1_empty_close_frame_valid" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::close(None, None)))
  match d.next_message() {
    Ok(Some(Message::Close(None))) => ()
    _ => debug_assert(false, "empty close frame must be Ok(Some(Close(None)))")
  }
}

///|
test "autobahn_7_3_1_one_byte_close_frame_rejected" {
  let raw = encode_frame(Frame::new(true, Opcode::Close, None, bytes_from_arr([0x03])))
  debug_assert(decode_single_err(Role::Client, 65536, raw), "1-byte close rejected")
}

///|
test "autobahn_7_5_1_close_invalid_utf8_reason_rejected" {
  let payload = bytes_from_arr([0x03, 0xE8, 0xFF, 0xFE])
  let raw = encode_frame(Frame::new(true, Opcode::Close, None, payload))
  debug_assert(decode_single_err(Role::Client, 65536, raw), "close invalid utf8 reason rejected")
}

///|
test "autobahn_7_5_2_close_valid_utf8_reason_accepted" {
  let wire = encode_frame(Frame::close(Some(CloseFrame::new(1000, "再见 👋")), Some(0x11223344U)))
  let d = Decoder::new(Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Close(Some(cf)))) => {
      debug_assert(cf.code == 1000, "code 1000")
      debug_assert(cf.reason == "再见 👋", "utf8 reason")
    }
    _ => debug_assert(false, "expected valid close with utf8 reason")
  }
}

///|
test "autobahn_7_5_3_close_max_123_byte_reason_accepted" {
  let reason = make_ascii_string(123)
  let wire = encode_frame(Frame::close(Some(CloseFrame::new(1001, reason)), None))
  let d = Decoder::new(Role::Client, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(Message::Close(Some(cf)))) => {
      debug_assert(cf.code == 1001, "code 1001")
      debug_assert(cf.reason == reason, "123 byte reason")
    }
    _ => debug_assert(false, "expected 123B close reason ok")
  }
}

