///|
fn build_mixed_stream() -> Bytes {
  let k = Some(0x4A3B2C1DU)
  let mut parts : Array[Bytes] = []
  parts.push(encode_frame(Frame::text("Hello, stream!", k)))
  parts.push(encode_frame(Frame::binary(make_pattern_bytes(0), k)))
  parts.push(encode_frame(Frame::ping("ping-1".to_bytes(), k)))
  parts.push(encode_frame(Frame::binary(make_pattern_bytes(125), k)))
  parts.push(encode_frame(Frame::text(make_ascii_string(126), k)))
  parts.push(encode_frame(Frame::new(false, Opcode::Text, k, "frag-A-".to_bytes())))
  parts.push(encode_frame(Frame::pong("mid-pong".to_bytes(), k)))
  parts.push(encode_frame(Frame::new(false, Opcode::Continuation, k, "世界-".to_bytes())))
  parts.push(encode_frame(Frame::new(true, Opcode::Continuation, k, "🌍".to_bytes())))
  parts.push(encode_frame(Frame::binary(make_pattern_bytes(513), k)))
  parts.push(encode_frame(Frame::close(Some(CloseFrame::new(1000, "bye")), k)))
  let mut total = 0
  let mut i = 0
  while i < parts.length() {
    total = total + parts[i].length()
    i = i + 1
  }
  let mut out = Bytes::new(total)
  let mut off = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      out[off] = p[j]
      off = off + 1
      j = j + 1
    }
    i = i + 1
  }
  out
}

///|
fn msg_summary(m : Message) -> String {
  match m {
    Message::Text(s) => "T:" + s.length().to_string() + ":" + s
    Message::Binary(b) => "B:" + b.length().to_string() + ":" + bytes_to_hex(b)
    Message::Ping(b) => "PI:" + b.to_string()
    Message::Pong(b) => "PO:" + b.to_string()
    Message::Close(None) => "C:none"
    Message::Close(Some(cf)) => "C:" + cf.code.to_string() + ":" + cf.reason
  }
}

///|
fn decode_all_chunks(stream : Bytes, chunk_sizes : Array[Int]) -> Array[String] {
  let d = Decoder::new(Role::Server, 131072)
  let mut out : Array[String] = []
  let mut pos = 0
  let mut ci = 0
  let n = stream.length()
  while pos < n {
    let sz = chunk_sizes[ci % chunk_sizes.length()]
    let end = if pos + sz > n { n } else { pos + sz }
    d.feed(stream.slice(pos, end))
    pos = end
    ci = ci + 1
    while true {
      match d.next_message() {
        Ok(Some(m)) => out.push(msg_summary(m))
        Ok(None) => break
        Err(e) => {
          debug_assert(false, "stream decode err: " + ws_error_string(e))
          break
        }
      }
    }
  }
  debug_assert(d.buffered_len() == 0, "all bytes consumed")
  out
}

///|
fn arrays_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "stream_decode_coalesced_whole_buffer" {
  let stream = build_mixed_stream()
  let whole = decode_all_chunks(stream, [stream.length()])
  debug_assert(whole.length() == 9, "9 messages from 11 frames")
}

///|
test "stream_decode_1_byte_chunks_matches_whole" {
  let stream = build_mixed_stream()
  let whole = decode_all_chunks(stream, [stream.length()])
  let by1 = decode_all_chunks(stream, [1])
  debug_assert(arrays_eq(whole, by1), "1-byte chunks == whole")
}

///|
test "stream_decode_3_byte_chunks_matches_whole" {
  let stream = build_mixed_stream()
  let whole = decode_all_chunks(stream, [stream.length()])
  let by3 = decode_all_chunks(stream, [3])
  debug_assert(arrays_eq(whole, by3), "3-byte chunks == whole")
}

///|
test "stream_decode_7_byte_chunks_matches_whole" {
  let stream = build_mixed_stream()
  let whole = decode_all_chunks(stream, [stream.length()])
  let by7 = decode_all_chunks(stream, [7])
  debug_assert(arrays_eq(whole, by7), "7-byte chunks == whole")
}

///|
test "stream_decode_pseudo_random_chunks_matches_whole" {
  let stream = build_mixed_stream()
  let whole = decode_all_chunks(stream, [stream.length()])
  let rand_sizes = [1, 13, 2, 37, 5, 19, 3, 29, 7, 11, 4, 23, 2, 17]
  let by_rand = decode_all_chunks(stream, rand_sizes)
  debug_assert(arrays_eq(whole, by_rand), "random chunks == whole")
}

///|
test "stream_empty_feed_and_reset" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(Bytes::new(0))
  debug_assert(d.buffered_len() == 0, "empty feed len 0")
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "empty decoder returns Ok(None)")
  }
  let wire = encode_frame(Frame::text("partial", None))
  d.feed(wire.slice(0, 3))
  debug_assert(d.buffered_len() == 3, "buffered 3")
  d.reset()
  debug_assert(d.buffered_len() == 0, "reset clears buffer")
}

///|
test "stream_partial_extended_length_and_mask_boundaries" {
  let wire = encode_frame(Frame::text(make_ascii_string(200), Some(0x12345678U)))
  let d = Decoder::new(Role::Server, 65536)
  // Feed 1 byte (partial base header)
  d.feed(wire.slice(0, 1))
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "1B partial")
  }
  // Feed 2 more bytes (1 byte of 16-bit ext len)
  d.feed(wire.slice(1, 3))
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "3B partial")
  }
  // Feed 3 more bytes (half of 4-byte mask key)
  d.feed(wire.slice(3, 6))
  match d.next_message() {
    Ok(None) => ()
    _ => debug_assert(false, "6B partial")
  }
  // Feed rest
  d.feed(wire.slice(6, wire.length()))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s.length() == 200, "200B decoded")
    _ => debug_assert(false, "expected 200B text")
  }
}
