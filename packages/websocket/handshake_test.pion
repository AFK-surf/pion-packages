///|
test "build_server_handshake_basic" {
  let resp = build_server_handshake("dGhlIHNhbXBsZSBub25jZQ==", None)
  debug_assert(resp.starts_with("HTTP/1.1 101 Switching Protocols\r\n"), "101 status")
  debug_assert(resp.contains("Upgrade: websocket\r\n"), "upgrade")
  debug_assert(resp.contains("Connection: Upgrade\r\n"), "connection")
  debug_assert(resp.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"), "accept")
  debug_assert(!resp.contains("Sec-WebSocket-Protocol"), "no protocol")
  debug_assert(resp.ends_with("\r\n\r\n"), "terminator")
}

///|
test "build_server_handshake_with_protocol" {
  let resp = build_server_handshake("dGhlIHNhbXBsZSBub25jZQ==", Some("chat"))
  debug_assert(resp.contains("Sec-WebSocket-Protocol: chat\r\n"), "protocol")
}

///|
test "verify_server_handshake_valid_roundtrip" {
  let key = "dGhlIHNhbXBsZSBub25jZQ=="
  let req = build_client_handshake("server.example.com", "/chat", key, ["chat", "superchat"])
  let parsed = match parse_client_handshake(req) {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "parse client handshake")
      return ()
    }
  }
  let resp = build_server_handshake(parsed.key, Some("chat"))
  match verify_server_handshake(resp, key, ["chat", "superchat"]) {
    Ok(vr) => {
      debug_assert(vr.accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "accept matches")
      match vr.protocol {
        Some(p) => debug_assert(p == "chat", "protocol matches")
        None => debug_assert(false, "expected protocol")
      }
    }
    Err(e) => debug_assert(false, "verify failed: " + ws_error_string(e))
  }
}

///|
test "verify_server_handshake_reject_status_200" {
  let raw = "HTTP/1.1 200 OK\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  debug_assert(is_err_resp(verify_server_handshake(raw, "dGhlIHNhbXBsZSBub25jZQ==", [])), "200 rejected")
}

///|
test "verify_server_handshake_reject_wrong_accept" {
  let raw = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: AAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\n\r\n"
  debug_assert(is_err_resp(verify_server_handshake(raw, "dGhlIHNhbXBsZSBub25jZQ==", [])), "wrong accept rejected")
}

///|
test "verify_server_handshake_reject_unoffered_protocol" {
  let resp = build_server_handshake("dGhlIHNhbXBsZSBub25jZQ==", Some("evil"))
  debug_assert(is_err_resp(verify_server_handshake(resp, "dGhlIHNhbXBsZSBub25jZQ==", ["chat"])), "unoffered protocol rejected")
}

///|
test "verify_server_handshake_reject_missing_upgrade_or_connection" {
  let r1 = "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  debug_assert(is_err_resp(verify_server_handshake(r1, "dGhlIHNhbXBsZSBub25jZQ==", [])), "missing upgrade rejected")
  let r2 = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  debug_assert(is_err_resp(verify_server_handshake(r2, "dGhlIHNhbXBsZSBub25jZQ==", [])), "missing connection rejected")
}
