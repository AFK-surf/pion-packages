///| RFC 6455 HTTP Upgrade handshake, SHA-1, and Base64 compliance tests (34 tests).

///|
fn bytes_from_arr(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn bytes_to_hex(b : Bytes) -> String {
  let hex = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  let n = b.length()
  while i < n {
    let v = b[i].to_int()
    let hi = (v >> 4) & 0xF
    let lo = v & 0xF
    sb.write_string(hex.slice(hi, hi + 1))
    sb.write_string(hex.slice(lo, lo + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn is_err_req(r : Result[HandshakeRequest, WsError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_resp(r : Result[HandshakeResponse, WsError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "sha1_empty" {
  let h = sha1(Bytes::new(0))
  debug_assert(bytes_to_hex(h) == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 empty")
}

///|
test "sha1_abc" {
  let h = sha1("abc".to_bytes())
  debug_assert(bytes_to_hex(h) == "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc")
}

///|
test "sha1_448_bits_two_blocks" {
  let s = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  let h = sha1(s.to_bytes())
  debug_assert(bytes_to_hex(h) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "sha1 56 bytes")
}

///|
test "sha1_55_bytes_single_block_boundary" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 55 {
    sb.write_string("a")
    i = i + 1
  }
  let h = sha1(sb.to_string().to_bytes())
  debug_assert(bytes_to_hex(h) == "41653c84a836355748966052124234157a098d8b", "sha1 55 a")
}

///|
test "sha1_64_bytes_exact_block" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 64 {
    sb.write_string("a")
    i = i + 1
  }
  let h = sha1(sb.to_string().to_bytes())
  debug_assert(bytes_to_hex(h) == "0098ba824b5c16427bd7a1122a5a442a25ec644d", "sha1 64 a")
}

///|
test "sha1_1000_a" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1000 {
    sb.write_string("a")
    i = i + 1
  }
  let h = sha1(sb.to_string().to_bytes())
  debug_assert(bytes_to_hex(h) == "291e9a6c66994949b57ba5e650361e98fc36b1ba", "sha1 1000 a")
}

///|
test "base64_rfc4648_vectors" {
  debug_assert(base64_encode("".to_bytes()) == "", "b64 empty")
  debug_assert(base64_encode("f".to_bytes()) == "Zg==", "b64 f")
  debug_assert(base64_encode("fo".to_bytes()) == "Zm8=", "b64 fo")
  debug_assert(base64_encode("foo".to_bytes()) == "Zm9v", "b64 foo")
  debug_assert(base64_encode("foob".to_bytes()) == "Zm9vYg==", "b64 foob")
  debug_assert(base64_encode("fooba".to_bytes()) == "Zm9vYmE=", "b64 fooba")
  debug_assert(base64_encode("foobar".to_bytes()) == "Zm9vYmFy", "b64 foobar")
}

///|
test "base64_binary_roundtrip" {
  let mut raw = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    raw[i] = i.to_byte()
    i = i + 1
  }
  let enc = base64_encode(raw)
  match base64_decode(enc) {
    Ok(dec) => {
      debug_assert(dec.length() == 256, "len 256")
      let mut j = 0
      while j < 256 {
        debug_assert(dec[j].to_int() == j, "byte match")
        j = j + 1
      }
    }
    Err(_) => debug_assert(false, "decode should succeed")
  }
}

///|
test "base64_decode_invalid_rejected" {
  match base64_decode("abc") {
    Ok(_) => debug_assert(false, "bad len")
    Err(_) => ()
  }
  match base64_decode("ab!d") {
    Ok(_) => debug_assert(false, "bad char")
    Err(_) => ()
  }
}

///|
test "rfc6455_sec1_3_golden_accept_key" {
  let accept = compute_accept_key("dGhlIHNhbXBsZSBub25jZQ==")
  debug_assert(accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "RFC 6455 §1.3 golden vector")
}

///|
test "compute_accept_key_additional_vectors" {
  let a1 = compute_accept_key("x3JJHMbDL1EzLkh9GBhXDw==")
  debug_assert(a1 == "HSmrc0sMlYUkAGmm5OPpG2HaGWk=", "RFC 6455 §4.2.2 vector")
  let a2 = compute_accept_key("AQIDBAUGBwgJCgsMDQ4PEA==")
  debug_assert(a2.length() == 28, "base64 sha1 length 28")
}

///|
test "build_client_handshake_basic" {
  let req = build_client_handshake("server.example.com", "/chat", "dGhlIHNhbXBsZSBub25jZQ==", [])
  debug_assert(req.starts_with("GET /chat HTTP/1.1\r\n"), "request line")
  debug_assert(req.contains("Host: server.example.com\r\n"), "host header")
  debug_assert(req.contains("Upgrade: websocket\r\n"), "upgrade header")
  debug_assert(req.contains("Connection: Upgrade\r\n"), "connection header")
  debug_assert(req.contains("Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"), "key header")
  debug_assert(req.contains("Sec-WebSocket-Version: 13\r\n"), "version header")
  debug_assert(req.ends_with("\r\n\r\n"), "header terminator")
}

///|
test "build_client_handshake_with_protocols" {
  let req = build_client_handshake(
    "example.com:8080",
    "/ws?token=abc",
    "dGhlIHNhbXBsZSBub25jZQ==",
    ["chat", "superchat"],
  )
  debug_assert(req.starts_with("GET /ws?token=abc HTTP/1.1\r\n"), "path with query")
  debug_assert(req.contains("Sec-WebSocket-Protocol: chat, superchat\r\n"), "protocols")
}

///|
test "parse_client_handshake_valid" {
  let raw = "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nOrigin: http://example.com\r\nSec-WebSocket-Protocol: chat, superchat\r\nSec-WebSocket-Version: 13\r\n\r\n"
  match parse_client_handshake(raw) {
    Ok(req) => {
      debug_assert(req.path == "/chat", "path")
      debug_assert(req.host == "server.example.com", "host")
      debug_assert(req.key == "dGhlIHNhbXBsZSBub25jZQ==", "key")
      debug_assert(req.protocols.length() == 2, "2 protocols")
      debug_assert(req.protocols[0] == "chat", "proto 0")
      debug_assert(req.protocols[1] == "superchat", "proto 1")
      match req.origin {
        Some(o) => debug_assert(o == "http://example.com", "origin")
        None => debug_assert(false, "expected origin")
      }
    }
    Err(e) => debug_assert(false, "unexpected err: " + ws_error_string(e))
  }
}

///|
test "parse_client_handshake_case_insensitive_headers" {
  let raw = "GET /ws HTTP/1.1\r\nhost: example.com\r\nUPGRADE: WebSocket\r\nconnection: keep-alive, UPGRADE\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\n\r\n"
  match parse_client_handshake(raw) {
    Ok(req) => {
      debug_assert(req.path == "/ws", "path")
      debug_assert(req.host == "example.com", "host")
      debug_assert(req.protocols.length() == 0, "no protocols")
    }
    Err(e) => debug_assert(false, "unexpected err: " + ws_error_string(e))
  }
}

///|
test "parse_client_handshake_reject_post_method" {
  let raw = "POST /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  debug_assert(is_err_req(parse_client_handshake(raw)), "POST must be rejected")
}

