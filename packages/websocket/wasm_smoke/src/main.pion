///| Wasm32 smoke entry for the `websocket` package.

import "websocket"

///|
pub fn smoke() -> Int {
  let accept = websocket::compute_accept_key("dGhlIHNhbXBsZSBub25jZQ==")
  if accept != "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" {
    return 1
  }
  let wire = websocket::encode_frame(
    websocket::Frame::text("Hello Wasm32!", Some(0x37FA213DU)),
  )
  let d = websocket::Decoder::new(websocket::Role::Server, 65536)
  d.feed(wire)
  match d.next_message() {
    Ok(Some(websocket::Message::Text(s))) => s.length()
    _ => 0
  }
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r == 13 {
    0
  } else {
    1
  }
}
