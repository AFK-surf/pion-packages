///|
test "autobahn_6_14_2_truncated_3byte_rejected" {
  debug_assert(text_frame_err(bytes_from_arr([0xE0, 0xA0])), "truncated 3B (2 bytes)")
  debug_assert(text_frame_err(bytes_from_arr([0xE2])), "truncated 3B (1 byte)")
}

///|
test "autobahn_6_14_3_truncated_4byte_rejected" {
  debug_assert(text_frame_err(bytes_from_arr([0xF0, 0x90, 0x80])), "truncated 4B (3 bytes)")
  debug_assert(text_frame_err(bytes_from_arr([0xF0, 0x90])), "truncated 4B (2 bytes)")
  debug_assert(text_frame_err(bytes_from_arr([0xF4])), "truncated 4B (1 byte)")
}

///|
test "autobahn_6_15_invalid_continuation_in_sequence_rejected" {
  debug_assert(text_frame_err(bytes_from_arr([0xC2, 0x41])), "2B bad cont")
  debug_assert(text_frame_err(bytes_from_arr([0xE2, 0x82, 0x41])), "3B bad 3rd byte")
  debug_assert(text_frame_err(bytes_from_arr([0xF0, 0x90, 0x80, 0x41])), "4B bad 4th byte")
}

///|
test "autobahn_6_16_invalid_utf8_in_binary_frame_allowed" {
  let bad = bytes_from_arr([0xFF, 0xFE, 0xED, 0xA0, 0x80, 0xC0, 0x80])
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::binary(bad, None)))
  match d.next_message() {
    Ok(Some(Message::Binary(b))) => debug_assert(bytes_eq(b, bad), "binary allows non-utf8")
    _ => debug_assert(false, "expected binary frame ok")
  }
}
