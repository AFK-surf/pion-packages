///| RFC 6455 & Autobahn §6 strict UTF-8 validation tests (36 tests).

///|
fn text_frame_ok(payload : Bytes) -> Bool {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(true, Opcode::Text, None, payload)))
  match d.next_message() {
    Ok(Some(Message::Text(_))) => true
    _ => false
  }
}

///|
fn text_frame_err(payload : Bytes) -> Bool {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(true, Opcode::Text, None, payload)))
  match d.next_message() {
    Err(_) => true
    Ok(_) => false
  }
}

///|
test "utf8_valid_empty_and_ascii" {
  debug_assert(validate_utf8(Bytes::new(0)), "empty valid")
  debug_assert(validate_utf8("Hello, WebSocket 123!".to_bytes()), "ascii valid")
  debug_assert(text_frame_ok(bytes_from_arr([0x00, 0x7F])), "NUL and DEL valid")
}

///|
test "utf8_valid_2byte_boundaries" {
  // U+0080 (C2 80) and U+07FF (DF BF)
  debug_assert(text_frame_ok(bytes_from_arr([0xC2, 0x80, 0xDF, 0xBF])), "2-byte boundaries")
}

///|
test "utf8_valid_3byte_boundaries" {
  // U+0800 (E0 A0 80), U+D7FF (ED 9F BF), U+E000 (EE 80 80), U+FFFF (EF BF BF)
  debug_assert(
    text_frame_ok(bytes_from_arr([
      0xE0, 0xA0, 0x80, 0xED, 0x9F, 0xBF, 0xEE, 0x80, 0x80, 0xEF, 0xBF, 0xBF,
    ])),
    "3-byte boundaries",
  )
}

///|
test "utf8_valid_4byte_boundaries" {
  // U+10000 (F0 90 80 80) and U+10FFFF (F4 8F BF BF)
  debug_assert(
    text_frame_ok(bytes_from_arr([0xF0, 0x90, 0x80, 0x80, 0xF4, 0x8F, 0xBF, 0xBF])),
    "4-byte boundaries",
  )
}

///|
test "utf8_valid_multilingual_cjk_emoji" {
  let s = "Hello 世界 🌍 Привет Γειά σου 🚀✨"
  let d = Decoder::new(Role::Server, 65536)
  d.feed(encode_frame(Frame::text(s, Some(0x13572468U))))
  match d.next_message() {
    Ok(Some(Message::Text(got))) => debug_assert(got == s, "multilingual text")
    _ => debug_assert(false, "expected multilingual text")
  }
}

///|
test "autobahn_6_2_1_split_2byte_utf8_across_fragments" {
  // U+00E9 (é) = C3 A9 split 1+1
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, bytes_from_arr([0xC3]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, bytes_from_arr([0xA9]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(bytes_eq(s.to_bytes(), bytes_from_arr([0xC3, 0xA9])), "split 2B")
    _ => debug_assert(false, "expected split 2B utf8")
  }
}

///|
test "autobahn_6_2_2_split_3byte_utf8_1_plus_2" {
  // '中' = E4 B8 AD split 1+2
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, bytes_from_arr([0xE4]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, bytes_from_arr([0xB8, 0xAD]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "中", "split 3B 1+2")
    _ => debug_assert(false, "expected 中")
  }
}

///|
test "autobahn_6_2_3_split_3byte_utf8_1_1_1" {
  // '中' = E4 B8 AD split 1+1+1
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, bytes_from_arr([0xE4]))))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, None, bytes_from_arr([0xB8]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, bytes_from_arr([0xAD]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "中", "split 3B 1+1+1")
    _ => debug_assert(false, "expected 中")
  }
}

///|
test "autobahn_6_2_4_split_4byte_emoji_1_1_1_1" {
  // '🌍' = F0 9F 8C 8D split 1+1+1+1
  let d = Decoder::new(Role::Server, 65536)
  let k = Some(0x22334455U)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, k, bytes_from_arr([0xF0]))))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, k, bytes_from_arr([0x9F]))))
  d.feed(encode_frame(Frame::new(false, Opcode::Continuation, k, bytes_from_arr([0x8C]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, k, bytes_from_arr([0x8D]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "🌍", "split 4B 1+1+1+1")
    _ => debug_assert(false, "expected 🌍")
  }
}

///|
test "autobahn_6_2_5_split_4byte_emoji_2_plus_2" {
  let d = Decoder::new(Role::Client, 65536)
  d.feed(encode_frame(Frame::new(false, Opcode::Text, None, bytes_from_arr([0xF0, 0x9F]))))
  d.feed(encode_frame(Frame::new(true, Opcode::Continuation, None, bytes_from_arr([0x8C, 0x8D]))))
  match d.next_message() {
    Ok(Some(Message::Text(s))) => debug_assert(s == "🌍", "split 4B 2+2")
    _ => debug_assert(false, "expected 🌍")
  }
}

