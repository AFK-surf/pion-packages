///| Head-to-head benchmark for packages/websocket (Pion Native).
///| Workload: 50,000 masked client frames (~50.8 MB mixed Text + Binary + fragmented Text + interleaved Ping)
///| batch-encoded and stream-decoded with unmasking, fragment reassembly, and strict UTF-8 validation.

import "websocket"

///|
fn build_text_pool(size : Int) -> Bytes {
  // 16-byte valid UTF-8 unit: "WS:" (3) + "世界" (6) + "🌍" (4) + "123" (3) = 16 bytes
  let unit = "WS:世界🌍123".to_bytes()
  let mut pool = Bytes::new(size)
  let mut i = 0
  while i < size {
    pool[i] = unit[i & 15]
    i = i + 1
  }
  pool
}

///|
fn build_bin_pool(size : Int) -> Bytes {
  let mut pool = Bytes::new(size)
  let mut i = 0
  while i < size {
    pool[i] = ((i * 37 + 13) & 0xFF).to_byte()
    i = i + 1
  }
  pool
}

///|
fn build_ping_pool(size : Int) -> Bytes {
  let mut pool = Bytes::new(size)
  let mut i = 0
  while i < size {
    pool[i] = (65 + (i % 26)).to_byte()
    i = i + 1
  }
  pool
}

///|
fn update_digest_bytes(h_in : Int64, b : Bytes) -> Int64 {
  let mut h = h_in
  let n = b.length()
  let mut i = 0
  while i < n {
    h = ((h & 0x00FFFFFFFFFFFFFFL) * 31L + b[i].to_int().to_int64()) & 0x3FFFFFFFFFFFFFFFL
    i = i + 1
  }
  h
}

///|
fn update_digest_str(h_in : Int64, s : String) -> Int64 {
  let mut h = h_in
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h & 0x00FFFFFFFFFFFFFFL) * 31L + s.code_unit_at(i).to_int64()) & 0x3FFFFFFFFFFFFFFFL
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let cycles = 10000
  let text_pool = build_text_pool(2048)
  let bin_pool = build_bin_pool(4096)
  let ping_pool = build_ping_pool(32)

  // Pre-slice templates so the benchmark measures WebSocket codec, not pool slicing
  let mut text_t0 : Array[Bytes] = []
  let mut k = 0
  while k < 16 {
    text_t0.push(text_pool.slice(0, 1024 + k * 16))
    k = k + 1
  }
  let mut bin_t1 : Array[Bytes] = []
  k = 0
  while k < 32 {
    bin_t1.push(bin_pool.slice(0, 2048 + k * 16))
    k = k + 1
  }
  let frag_p1 = text_pool.slice(0, 517)
  let mut frag_p2 : Array[Bytes] = []
  k = 0
  while k < 8 {
    frag_p2.push(text_pool.slice(517, 1536 + k * 16))
    k = k + 1
  }

  let decoder = websocket::Decoder::new(websocket::Role::Server, 1048576)
  let mut text_msgs : Int64 = 0L
  let mut bin_msgs : Int64 = 0L
  let mut ping_msgs : Int64 = 0L
  let mut wire_bytes : Int64 = 0L
  let mut payload_bytes : Int64 = 0L
  let mut digest : Int64 = 1469598103L

  let mut c = 0
  while c < cycles {
    let mk64 = (c.to_int64() * 2654435761L + 0x37FA213DL) & 0xFFFFFFFFL
    let mk = mk64.to_int().to_uint()

    let f0 = websocket::encode_frame(
      websocket::Frame::new(true, websocket::Opcode::Text, Some(mk), text_t0[c & 15]),
    )
    let f1 = websocket::encode_frame(
      websocket::Frame::new(true, websocket::Opcode::Binary, Some(mk ^ 0x11111111U), bin_t1[c & 31]),
    )
    let f2 = websocket::encode_frame(
      websocket::Frame::new(false, websocket::Opcode::Text, Some(mk ^ 0x22222222U), frag_p1),
    )
    let f3 = websocket::encode_frame(
      websocket::Frame::new(true, websocket::Opcode::Ping, Some(mk ^ 0x33333333U), ping_pool),
    )
    let f4 = websocket::encode_frame(
      websocket::Frame::new(true, websocket::Opcode::Continuation, Some(mk ^ 0x44444444U), frag_p2[c & 7]),
    )

    wire_bytes = wire_bytes +
    f0.length().to_int64() +
    f1.length().to_int64() +
    f2.length().to_int64() +
    f3.length().to_int64() +
    f4.length().to_int64()

    decoder.feed(f0)
    decoder.feed(f1)
    decoder.feed(f2)
    decoder.feed(f3)
    decoder.feed(f4)

    while true {
      match decoder.next_message() {
        Ok(Some(websocket::Message::Text(s))) => {
          text_msgs = text_msgs + 1L
          payload_bytes = payload_bytes + s.length().to_int64()
          digest = update_digest_str(digest, s)
        }
        Ok(Some(websocket::Message::Binary(b))) => {
          bin_msgs = bin_msgs + 1L
          payload_bytes = payload_bytes + b.length().to_int64()
          digest = update_digest_bytes(digest, b)
        }
        Ok(Some(websocket::Message::Ping(b))) => {
          ping_msgs = ping_msgs + 1L
          payload_bytes = payload_bytes + b.length().to_int64()
          digest = update_digest_bytes(digest, b)
        }
        Ok(Some(_)) => ()
        Ok(None) => break
        Err(e) => {
          io_eprintln(world, "decode error: " + websocket::ws_error_string(e))
          return 1
        }
      }
    }
    c = c + 1
  }

  io_println(world, "frames=" + (cycles * 5).to_string())
  io_println(world, "text_msgs=" + text_msgs.to_string())
  io_println(world, "binary_msgs=" + bin_msgs.to_string())
  io_println(world, "ping_msgs=" + ping_msgs.to_string())
  io_println(world, "wire_bytes=" + wire_bytes.to_string())
  io_println(world, "payload_bytes=" + payload_bytes.to_string())
  io_println(world, "digest=" + digest.to_string())
  0
}
