///| RFC 6455 frame encoding and 4-byte XOR masking (stub for Red phase).

///|
pub fn mask_bytes(data : Bytes, mask_key : UInt) -> Bytes {
  let _ = data
  let _ = mask_key
  Bytes::new(0)
}

///|
pub fn encode_frame(frame : Frame) -> Bytes {
  let _ = frame
  Bytes::new(0)
}

///|
pub fn encode_message(msg : Message, mask : Option[UInt]) -> Bytes {
  let _ = msg
  let _ = mask
  Bytes::new(0)
}
