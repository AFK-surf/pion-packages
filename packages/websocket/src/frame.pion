///| RFC 6455 frame encoding and 8-byte batch XOR masking.

///| RFC 6455 §5.3 single-byte XOR masking kernel (`mask(mask(b)) = b`).
#verify
pub fn mask_byte_xor(b : Int, m : Int) -> Int {
  b ^ m
}

///| Extract big-endian mask key byte `idx mod 4` in `[0, 255]`.
#verify
pub fn mask_key_byte(mask_key : UInt, idx : Int) -> Int {
  let lane = idx & 3
  let shift = (3 - lane) * 8
  ((mask_key >> shift) & 0xFFU).to_int()
}

///| RFC 6455 §5.2 minimal extended payload length field size in bytes (`0`, `2`, or `8`).
#verify
pub fn encoded_ext_len(plen : Int) -> Int {
  if plen < 126 {
    0
  } else if plen <= 65535 {
    2
  } else {
    8
  }
}

///| RFC 6455 §5.2 encoded frame header length in bytes (`2..14`).
#verify
pub fn encoded_header_len(plen : Int, masked : Bool) -> Int {
  2 + encoded_ext_len(plen) + (if masked { 4 } else { 0 })
}

///| Apply RFC 6455 §5.3 4-byte XOR masking with 16-byte unrolled batch loop.
///| `mask_key` is interpreted in network (big-endian) byte order.
pub fn mask_bytes(data : Bytes, mask_key : UInt) -> Bytes {
  let n = data.length()
  let out = Bytes::new(n)
  if n == 0 {
    return out
  }
  let m0 = ((mask_key >> 24) & 0xFFU).to_int()
  let m1 = ((mask_key >> 16) & 0xFFU).to_int()
  let m2 = ((mask_key >> 8) & 0xFFU).to_int()
  let m3 = (mask_key & 0xFFU).to_int()
  let mut i = 0
  while i + 16 <= n {
    out[i] = (data[i].to_int() ^ m0).to_byte()
    out[i + 1] = (data[i + 1].to_int() ^ m1).to_byte()
    out[i + 2] = (data[i + 2].to_int() ^ m2).to_byte()
    out[i + 3] = (data[i + 3].to_int() ^ m3).to_byte()
    out[i + 4] = (data[i + 4].to_int() ^ m0).to_byte()
    out[i + 5] = (data[i + 5].to_int() ^ m1).to_byte()
    out[i + 6] = (data[i + 6].to_int() ^ m2).to_byte()
    out[i + 7] = (data[i + 7].to_int() ^ m3).to_byte()
    out[i + 8] = (data[i + 8].to_int() ^ m0).to_byte()
    out[i + 9] = (data[i + 9].to_int() ^ m1).to_byte()
    out[i + 10] = (data[i + 10].to_int() ^ m2).to_byte()
    out[i + 11] = (data[i + 11].to_int() ^ m3).to_byte()
    out[i + 12] = (data[i + 12].to_int() ^ m0).to_byte()
    out[i + 13] = (data[i + 13].to_int() ^ m1).to_byte()
    out[i + 14] = (data[i + 14].to_int() ^ m2).to_byte()
    out[i + 15] = (data[i + 15].to_int() ^ m3).to_byte()
    i = i + 16
  }
  if i + 8 <= n {
    out[i] = (data[i].to_int() ^ m0).to_byte()
    out[i + 1] = (data[i + 1].to_int() ^ m1).to_byte()
    out[i + 2] = (data[i + 2].to_int() ^ m2).to_byte()
    out[i + 3] = (data[i + 3].to_int() ^ m3).to_byte()
    out[i + 4] = (data[i + 4].to_int() ^ m0).to_byte()
    out[i + 5] = (data[i + 5].to_int() ^ m1).to_byte()
    out[i + 6] = (data[i + 6].to_int() ^ m2).to_byte()
    out[i + 7] = (data[i + 7].to_int() ^ m3).to_byte()
    i = i + 8
  }
  if i + 4 <= n {
    out[i] = (data[i].to_int() ^ m0).to_byte()
    out[i + 1] = (data[i + 1].to_int() ^ m1).to_byte()
    out[i + 2] = (data[i + 2].to_int() ^ m2).to_byte()
    out[i + 3] = (data[i + 3].to_int() ^ m3).to_byte()
    i = i + 4
  }
  if i < n {
    out[i] = (data[i].to_int() ^ m0).to_byte()
    i = i + 1
  }
  if i < n {
    out[i] = (data[i].to_int() ^ m1).to_byte()
    i = i + 1
  }
  if i < n {
    out[i] = (data[i].to_int() ^ m2).to_byte()
  }
  out
}

///| Encode a single RFC 6455 `Frame` into wire bytes in a single allocation.
pub fn encode_frame(frame : Frame) -> Bytes {
  let payload = frame.payload
  let plen = payload.length()
  let b0 = (if frame.fin { 0x80 } else { 0 }) | opcode_to_int(frame.opcode)
  match frame.mask {
    Some(mask_key) => {
      let hdr_len = if plen < 126 {
        6
      } else if plen <= 65535 {
        8
      } else {
        14
      }
      let out = Bytes::new(hdr_len + plen)
      out[0] = b0.to_byte()
      let mut off = 2
      if plen < 126 {
        out[1] = (0x80 | plen).to_byte()
      } else if plen <= 65535 {
        out[1] = (0x80 | 126).to_byte()
        out[2] = ((plen >> 8) & 0xFF).to_byte()
        out[3] = (plen & 0xFF).to_byte()
        off = 4
      } else {
        out[1] = (0x80 | 127).to_byte()
        let p64 = plen.to_int64()
        out[2] = ((p64 >> 56L) & 0xFFL).to_int().to_byte()
        out[3] = ((p64 >> 48L) & 0xFFL).to_int().to_byte()
        out[4] = ((p64 >> 40L) & 0xFFL).to_int().to_byte()
        out[5] = ((p64 >> 32L) & 0xFFL).to_int().to_byte()
        out[6] = ((p64 >> 24L) & 0xFFL).to_int().to_byte()
        out[7] = ((p64 >> 16L) & 0xFFL).to_int().to_byte()
        out[8] = ((p64 >> 8L) & 0xFFL).to_int().to_byte()
        out[9] = (p64 & 0xFFL).to_int().to_byte()
        off = 10
      }
      let m0 = ((mask_key >> 24) & 0xFFU).to_int()
      let m1 = ((mask_key >> 16) & 0xFFU).to_int()
      let m2 = ((mask_key >> 8) & 0xFFU).to_int()
      let m3 = (mask_key & 0xFFU).to_int()
      out[off] = m0.to_byte()
      out[off + 1] = m1.to_byte()
      out[off + 2] = m2.to_byte()
      out[off + 3] = m3.to_byte()
      let mut di = off + 4
      let mut i = 0
      while i + 16 <= plen {
        out[di] = (payload[i].to_int() ^ m0).to_byte()
        out[di + 1] = (payload[i + 1].to_int() ^ m1).to_byte()
        out[di + 2] = (payload[i + 2].to_int() ^ m2).to_byte()
        out[di + 3] = (payload[i + 3].to_int() ^ m3).to_byte()
        out[di + 4] = (payload[i + 4].to_int() ^ m0).to_byte()
        out[di + 5] = (payload[i + 5].to_int() ^ m1).to_byte()
        out[di + 6] = (payload[i + 6].to_int() ^ m2).to_byte()
        out[di + 7] = (payload[i + 7].to_int() ^ m3).to_byte()
        out[di + 8] = (payload[i + 8].to_int() ^ m0).to_byte()
        out[di + 9] = (payload[i + 9].to_int() ^ m1).to_byte()
        out[di + 10] = (payload[i + 10].to_int() ^ m2).to_byte()
        out[di + 11] = (payload[i + 11].to_int() ^ m3).to_byte()
        out[di + 12] = (payload[i + 12].to_int() ^ m0).to_byte()
        out[di + 13] = (payload[i + 13].to_int() ^ m1).to_byte()
        out[di + 14] = (payload[i + 14].to_int() ^ m2).to_byte()
        out[di + 15] = (payload[i + 15].to_int() ^ m3).to_byte()
        di = di + 16
        i = i + 16
      }
      if i + 8 <= plen {
        out[di] = (payload[i].to_int() ^ m0).to_byte()
        out[di + 1] = (payload[i + 1].to_int() ^ m1).to_byte()
        out[di + 2] = (payload[i + 2].to_int() ^ m2).to_byte()
        out[di + 3] = (payload[i + 3].to_int() ^ m3).to_byte()
        out[di + 4] = (payload[i + 4].to_int() ^ m0).to_byte()
        out[di + 5] = (payload[i + 5].to_int() ^ m1).to_byte()
        out[di + 6] = (payload[i + 6].to_int() ^ m2).to_byte()
        out[di + 7] = (payload[i + 7].to_int() ^ m3).to_byte()
        di = di + 8
        i = i + 8
      }
      if i + 4 <= plen {
        out[di] = (payload[i].to_int() ^ m0).to_byte()
        out[di + 1] = (payload[i + 1].to_int() ^ m1).to_byte()
        out[di + 2] = (payload[i + 2].to_int() ^ m2).to_byte()
        out[di + 3] = (payload[i + 3].to_int() ^ m3).to_byte()
        di = di + 4
        i = i + 4
      }
      if i < plen {
        out[di] = (payload[i].to_int() ^ m0).to_byte()
        di = di + 1
        i = i + 1
      }
      if i < plen {
        out[di] = (payload[i].to_int() ^ m1).to_byte()
        di = di + 1
        i = i + 1
      }
      if i < plen {
        out[di] = (payload[i].to_int() ^ m2).to_byte()
      }
      out
    }
    None => {
      let hdr_len = if plen < 126 {
        2
      } else if plen <= 65535 {
        4
      } else {
        10
      }
      if plen >= 64 {
        let hdr = Bytes::new(hdr_len)
        hdr[0] = b0.to_byte()
        if plen < 126 {
          hdr[1] = plen.to_byte()
        } else if plen <= 65535 {
          hdr[1] = (126).to_byte()
          hdr[2] = ((plen >> 8) & 0xFF).to_byte()
          hdr[3] = (plen & 0xFF).to_byte()
        } else {
          hdr[1] = (127).to_byte()
          let p64 = plen.to_int64()
          hdr[2] = ((p64 >> 56L) & 0xFFL).to_int().to_byte()
          hdr[3] = ((p64 >> 48L) & 0xFFL).to_int().to_byte()
          hdr[4] = ((p64 >> 40L) & 0xFFL).to_int().to_byte()
          hdr[5] = ((p64 >> 32L) & 0xFFL).to_int().to_byte()
          hdr[6] = ((p64 >> 24L) & 0xFFL).to_int().to_byte()
          hdr[7] = ((p64 >> 16L) & 0xFFL).to_int().to_byte()
          hdr[8] = ((p64 >> 8L) & 0xFFL).to_int().to_byte()
          hdr[9] = (p64 & 0xFFL).to_int().to_byte()
        }
        return hdr.concat(payload)
      }
      let out = Bytes::new(hdr_len + plen)
      out[0] = b0.to_byte()
      out[1] = plen.to_byte()
      let mut di = 2
      let mut i = 0
      while i + 8 <= plen {
        out[di] = payload[i]
        out[di + 1] = payload[i + 1]
        out[di + 2] = payload[i + 2]
        out[di + 3] = payload[i + 3]
        out[di + 4] = payload[i + 4]
        out[di + 5] = payload[i + 5]
        out[di + 6] = payload[i + 6]
        out[di + 7] = payload[i + 7]
        di = di + 8
        i = i + 8
      }
      while i < plen {
        out[di] = payload[i]
        di = di + 1
        i = i + 1
      }
      out
    }
  }
}

///| Encode a high-level `Message` into a single wire frame.
pub fn encode_message(msg : Message, mask : Option[UInt]) -> Bytes {
  match msg {
    Message::Text(s) => encode_frame(Frame::text(s, mask))
    Message::Binary(b) => encode_frame(Frame::binary(b, mask))
    Message::Ping(b) => encode_frame(Frame::ping(b, mask))
    Message::Pong(b) => encode_frame(Frame::pong(b, mask))
    Message::Close(cf) => encode_frame(Frame::close(cf, mask))
  }
}
