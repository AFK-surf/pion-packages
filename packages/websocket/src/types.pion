///| Core RFC 6455 WebSocket types, opcodes, close codes, UTF-8 validation, and errors.

///|
pub enum Role {
  Client
  Server
}

///|
pub enum Opcode {
  Continuation
  Text
  Binary
  Close
  Ping
  Pong
}

///|
pub val struct CloseFrame {
  pub code : Int
  pub reason : String
}

///|
pub enum Message {
  Text(String)
  Binary(Bytes)
  Ping(Bytes)
  Pong(Bytes)
  Close(Option[CloseFrame])
}

///|
pub struct Frame {
  pub fin : Bool
  pub opcode : Opcode
  pub mask : Option[UInt]
  pub payload : Bytes
}

///|
pub enum WsError {
  InvalidHandshake(String)
  InvalidOpcode(Int)
  NonZeroRsv(Int)
  UnmaskedClientFrame
  MaskedServerFrame
  NonMinimalLength
  InvalidPayloadLength(String)
  MessageTooLarge(Int, Int)
  FragmentedControlFrame
  ControlFrameTooLarge(Int)
  UnexpectedContinuation
  ExpectedContinuation
  InvalidUtf8(String)
  InvalidCloseFrame(String)
  InvalidCloseCode(Int)
}

///|
pub struct HandshakeRequest {
  pub path : String
  pub host : String
  pub key : String
  pub protocols : Array[String]
  pub origin : Option[String]
}

///|
pub struct HandshakeResponse {
  pub accept : String
  pub protocol : Option[String]
}

///|
pub fn Frame::new(
  fin : Bool,
  opcode : Opcode,
  mask : Option[UInt],
  payload : Bytes,
) -> Frame {
  Frame::{ fin: fin, opcode: opcode, mask: mask, payload: payload }
}

///|
pub fn Frame::text(text : String, mask : Option[UInt]) -> Frame {
  Frame::{
    fin: true,
    opcode: Opcode::Text,
    mask: mask,
    payload: text.to_bytes(),
  }
}

///|
pub fn Frame::binary(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Binary, mask: mask, payload: data }
}

///|
pub fn Frame::ping(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Ping, mask: mask, payload: data }
}

///|
pub fn Frame::pong(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Pong, mask: mask, payload: data }
}

///|
pub fn Frame::close(cf : Option[CloseFrame], mask : Option[UInt]) -> Frame {
  let payload = match cf {
    None => Bytes::new(0)
    Some(c) => {
      let reason_bytes = c.reason.to_bytes()
      let rlen = reason_bytes.length()
      let mut out = Bytes::new(2 + rlen)
      out[0] = ((c.code >> 8) & 0xFF).to_byte()
      out[1] = (c.code & 0xFF).to_byte()
      let mut i = 0
      while i < rlen {
        out[2 + i] = reason_bytes[i]
        i = i + 1
      }
      out
    }
  }
  Frame::{ fin: true, opcode: Opcode::Close, mask: mask, payload: payload }
}

///|
pub fn CloseFrame::new(code : Int, reason : String) -> CloseFrame {
  CloseFrame::{ code: code, reason: reason }
}

///|
pub fn opcode_to_int(op : Opcode) -> Int {
  match op {
    Opcode::Continuation => 0
    Opcode::Text => 1
    Opcode::Binary => 2
    Opcode::Close => 8
    Opcode::Ping => 9
    Opcode::Pong => 10
  }
}

///|
pub fn ws_error_string(err : WsError) -> String {
  match err {
    WsError::InvalidHandshake(msg) => "invalid handshake: " + msg
    WsError::InvalidOpcode(op) => "invalid opcode: " + op.to_string()
    WsError::NonZeroRsv(bits) => "non-zero rsv bits: " + bits.to_string()
    WsError::UnmaskedClientFrame => "unmasked frame from client"
    WsError::MaskedServerFrame => "masked frame from server"
    WsError::NonMinimalLength => "non-minimal payload length encoding"
    WsError::InvalidPayloadLength(msg) => "invalid payload length: " + msg
    WsError::MessageTooLarge(actual, max) =>
    "message too large: " + actual.to_string() + " > " + max.to_string()
    WsError::FragmentedControlFrame => "fragmented control frame"
    WsError::ControlFrameTooLarge(len) =>
    "control frame too large: " + len.to_string()
    WsError::UnexpectedContinuation => "unexpected continuation frame"
    WsError::ExpectedContinuation => "expected continuation frame"
    WsError::InvalidUtf8(msg) => "invalid utf-8: " + msg
    WsError::InvalidCloseFrame(msg) => "invalid close frame: " + msg
    WsError::InvalidCloseCode(code) => "invalid close code: " + code.to_string()
  }
}

///| RFC 6455 §7.4.1 & IANA WebSocket Close Code Number Registry.
pub fn is_valid_close_code(code : Int) -> Bool {
  (code >= 1000 && code <= 1003) ||
  (code >= 1007 && code <= 1014) ||
  (code >= 3000 && code <= 4999)
}

///| Strict RFC 3629 UTF-8 validation over a byte range `[start, end)`.
pub fn validate_utf8_range(data : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    // Fast-path 8-byte ASCII batch skip
    while i + 8 <= end {
      let mask = data[i].to_int() |
      data[i + 1].to_int() |
      data[i + 2].to_int() |
      data[i + 3].to_int() |
      data[i + 4].to_int() |
      data[i + 5].to_int() |
      data[i + 6].to_int() |
      data[i + 7].to_int()
      if (mask & 0x80) == 0 {
        i = i + 8
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 == 0xE0 {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if b1 < 0xA0 || b1 > 0xBF || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if (b0 >= 0xE1 && b0 <= 0xEC) || (b0 >= 0xEE && b0 <= 0xEF) {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 == 0xED {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      // Reject UTF-16 surrogates U+D800..U+DFFF (b1 >= 0xA0)
      if b1 < 0x80 || b1 > 0x9F || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 == 0xF0 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if b1 < 0x90 || b1 > 0xBF || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else if b0 >= 0xF1 && b0 <= 0xF3 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else if b0 == 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      // Reject > U+10FFFF (b1 >= 0x90)
      if b1 < 0x80 || b1 > 0x8F || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Strict RFC 3629 UTF-8 validation over an entire `Bytes` buffer.
pub fn validate_utf8(data : Bytes) -> Bool {
  validate_utf8_range(data, 0, data.length())
}
