///| Core RFC 6455 WebSocket types, opcodes, close codes, UTF-8 validation, and errors.

///|
pub enum Role {
  Client
  Server
}

///|
pub enum Opcode {
  Continuation
  Text
  Binary
  Close
  Ping
  Pong
}

///|
pub val struct CloseFrame {
  pub code : Int
  pub reason : String
}

///|
pub enum Message {
  Text(String)
  Binary(Bytes)
  Ping(Bytes)
  Pong(Bytes)
  Close(Option[CloseFrame])
}

///|
pub struct Frame {
  pub fin : Bool
  pub opcode : Opcode
  pub mask : Option[UInt]
  pub payload : Bytes
}

///|
pub enum WsError {
  InvalidHandshake(String)
  InvalidOpcode(Int)
  NonZeroRsv(Int)
  UnmaskedClientFrame
  MaskedServerFrame
  NonMinimalLength
  InvalidPayloadLength(String)
  MessageTooLarge(Int, Int)
  FragmentedControlFrame
  ControlFrameTooLarge(Int)
  UnexpectedContinuation
  ExpectedContinuation
  InvalidUtf8(String)
  InvalidCloseFrame(String)
  InvalidCloseCode(Int)
}

///|
pub struct HandshakeRequest {
  pub path : String
  pub host : String
  pub key : String
  pub protocols : Array[String]
  pub origin : Option[String]
}

///|
pub struct HandshakeResponse {
  pub accept : String
  pub protocol : Option[String]
}

///|
pub fn Frame::new(
  fin : Bool,
  opcode : Opcode,
  mask : Option[UInt],
  payload : Bytes,
) -> Frame {
  Frame::{ fin: fin, opcode: opcode, mask: mask, payload: payload }
}

///|
pub fn Frame::text(text : String, mask : Option[UInt]) -> Frame {
  Frame::{
    fin: true,
    opcode: Opcode::Text,
    mask: mask,
    payload: text.to_bytes(),
  }
}

///|
pub fn Frame::binary(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Binary, mask: mask, payload: data }
}

///|
pub fn Frame::ping(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Ping, mask: mask, payload: data }
}

///|
pub fn Frame::pong(data : Bytes, mask : Option[UInt]) -> Frame {
  Frame::{ fin: true, opcode: Opcode::Pong, mask: mask, payload: data }
}

///|
pub fn Frame::close(cf : Option[CloseFrame], mask : Option[UInt]) -> Frame {
  let payload = match cf {
    None => Bytes::new(0)
    Some(c) => {
      let reason_bytes = c.reason.to_bytes()
      let rlen = reason_bytes.length()
      let mut out = Bytes::new(2 + rlen)
      out[0] = ((c.code >> 8) & 0xFF).to_byte()
      out[1] = (c.code & 0xFF).to_byte()
      let mut i = 0
      while i < rlen {
        out[2 + i] = reason_bytes[i]
        i = i + 1
      }
      out
    }
  }
  Frame::{ fin: true, opcode: Opcode::Close, mask: mask, payload: payload }
}

///|
pub fn CloseFrame::new(code : Int, reason : String) -> CloseFrame {
  CloseFrame::{ code: code, reason: reason }
}

///|
#verify
pub fn opcode_to_int(op : Opcode) -> Int {
  match op {
    Opcode::Continuation => 0
    Opcode::Text => 1
    Opcode::Binary => 2
    Opcode::Close => 8
    Opcode::Ping => 9
    Opcode::Pong => 10
  }
}

///| RFC 6455 §5.2 opcode decoder (returns `None` for reserved or out-of-range opcodes).
#verify
pub fn opcode_from_int(raw : Int) -> Option[Opcode] {
  match raw {
    0 => Some(Opcode::Continuation)
    1 => Some(Opcode::Text)
    2 => Some(Opcode::Binary)
    8 => Some(Opcode::Close)
    9 => Some(Opcode::Ping)
    10 => Some(Opcode::Pong)
    _ => None
  }
}

///| RFC 6455 §5.5 control opcode predicate (`Close`, `Ping`, `Pong`).
pub fn is_control_opcode(op : Opcode) -> Bool {
  match op {
    Opcode::Close => true
    Opcode::Ping => true
    Opcode::Pong => true
    _ => false
  }
}

///| RFC 6455 §5.1 role-based masking direction check (`0` = ok, `1` = UnmaskedClientFrame, `2` = MaskedServerFrame).
pub fn check_role_mask(role : Role, masked : Bool) -> Int {
  match role {
    Role::Server => if !masked { 1 } else { 0 }
    Role::Client => if masked { 2 } else { 0 }
  }
}

///| RFC 6455 §5.5 control frame invariants (`0` = ok, `1` = FragmentedControlFrame, `2` = ControlFrameTooLarge).
pub fn check_control_frame(is_control : Bool, fin : Bool, len7 : Int) -> Int {
  if !is_control {
    return 0
  }
  if !fin {
    return 1
  }
  if len7 > 125 {
    return 2
  }
  0
}

///| RFC 6455 §5.2 extended 16-bit payload length minimal-encoding check (`true` iff `126 <= payload_len <= 65535`).
pub fn is_minimal_len16(payload_len : Int) -> Bool {
  payload_len >= 126 && payload_len <= 65535
}

///| RFC 6455 §5.2 extended 64-bit payload length validation:
///| `0` = ok, `1` = MSB set (InvalidPayloadLength), `2` = NonMinimalLength (< 65536), `3` = MessageTooLarge.
#verify
pub fn check_ext_len64(h2 : Int, len64 : Int64, max_message_size : Int) -> Int {
  if (h2 & 0x80) != 0 {
    return 1
  }
  if len64 < 65536L {
    return 2
  }
  if len64 > max_message_size.to_int64() {
    return 3
  }
  0
}

///| Clamp a 64-bit length to `INT32_MAX` for `WsError::MessageTooLarge` reporting.
pub fn clamp_i64_to_i32_max(n : Int64) -> Int {
  if n > 2147483647L {
    2147483647
  } else {
    n.to_int()
  }
}

///| 64-bit overflow-safe total frame byte size (`header + optional 4-byte mask + payload`).
pub fn frame_total_bytes(hdr_len : Int, masked : Bool, payload_len : Int) -> Int64 {
  let mask_end = if masked { hdr_len + 4 } else { hdr_len }
  mask_end.to_int64() + payload_len.to_int64()
}

///| 64-bit overflow-safe fragmented message length sum.
pub fn frag_sum_i64(frag_total : Int, payload_len : Int) -> Int64 {
  frag_total.to_int64() + payload_len.to_int64()
}

///|
pub fn ws_error_string(err : WsError) -> String {
  match err {
    WsError::InvalidHandshake(msg) => "invalid handshake: " + msg
    WsError::InvalidOpcode(op) => "invalid opcode: " + op.to_string()
    WsError::NonZeroRsv(bits) => "non-zero rsv bits: " + bits.to_string()
    WsError::UnmaskedClientFrame => "unmasked frame from client"
    WsError::MaskedServerFrame => "masked frame from server"
    WsError::NonMinimalLength => "non-minimal payload length encoding"
    WsError::InvalidPayloadLength(msg) => "invalid payload length: " + msg
    WsError::MessageTooLarge(actual, max) =>
    "message too large: " + actual.to_string() + " > " + max.to_string()
    WsError::FragmentedControlFrame => "fragmented control frame"
    WsError::ControlFrameTooLarge(len) =>
    "control frame too large: " + len.to_string()
    WsError::UnexpectedContinuation => "unexpected continuation frame"
    WsError::ExpectedContinuation => "expected continuation frame"
    WsError::InvalidUtf8(msg) => "invalid utf-8: " + msg
    WsError::InvalidCloseFrame(msg) => "invalid close frame: " + msg
    WsError::InvalidCloseCode(code) => "invalid close code: " + code.to_string()
  }
}

///| RFC 6455 §7.4.1 & IANA WebSocket Close Code Number Registry.
pub fn is_valid_close_code(code : Int) -> Bool {
  (code >= 1000 && code <= 1003) ||
  (code >= 1007 && code <= 1014) ||
  (code >= 3000 && code <= 4999)
}

///| Single-byte RFC 3629 UTF-8 DFA transition function (states `0..7`, sticky error `-1`).
#verify
pub fn utf8_dfa_step(st : Int, b : Int) -> Int {
  if st < 0 {
    return -1
  }
  if st == 0 {
    if b >= 0 && b < 0x80 {
      0
    } else if b >= 0xC2 && b <= 0xDF {
      1
    } else if b == 0xE0 {
      3
    } else if (b >= 0xE1 && b <= 0xEC) || (b >= 0xEE && b <= 0xEF) {
      2
    } else if b == 0xED {
      4
    } else if b == 0xF0 {
      5
    } else if b >= 0xF1 && b <= 0xF3 {
      6
    } else if b == 0xF4 {
      7
    } else {
      -1
    }
  } else if st == 1 {
    if (b & 0xC0) != 0x80 { -1 } else { 0 }
  } else if st == 2 {
    if (b & 0xC0) != 0x80 { -1 } else { 1 }
  } else if st == 3 {
    if b < 0xA0 || b > 0xBF { -1 } else { 1 }
  } else if st == 4 {
    if b < 0x80 || b > 0x9F { -1 } else { 1 }
  } else if st == 5 {
    if b < 0x90 || b > 0xBF { -1 } else { 2 }
  } else if st == 6 {
    if (b & 0xC0) != 0x80 { -1 } else { 2 }
  } else if st == 7 {
    if b < 0x80 || b > 0x8F { -1 } else { 2 }
  } else {
    -1
  }
}

///| Incremental RFC 3629 UTF-8 validator over a byte range `[start, end)`.
///| State encoding:
///|   0 = accept (ready for next code point)
///|   1 = expect 1 continuation byte in 0x80..0xBF -> 0
///|   2 = expect 2 continuation bytes, next in 0x80..0xBF -> 1
///|   3 = expect 2 continuation bytes, next in 0xA0..0xBF (after 0xE0) -> 1
///|   4 = expect 2 continuation bytes, next in 0x80..0x9F (after 0xED) -> 1
///|   5 = expect 3 continuation bytes, next in 0x90..0xBF (after 0xF0) -> 2
///|   6 = expect 3 continuation bytes, next in 0x80..0xBF (after 0xF1..0xF3) -> 2
///|   7 = expect 3 continuation bytes, next in 0x80..0x8F (after 0xF4) -> 2
///|  -1 = invalid UTF-8 (sticky error)
pub fn validate_utf8_step(
  init_state : Int,
  data : Bytes,
  start : Int,
  end : Int,
) -> Int {
  let mut st = init_state
  if st < 0 {
    return -1
  }
  let mut i = start
  while st != 0 && i < end {
    st = utf8_dfa_step(st, data[i].to_int())
    if st < 0 {
      return -1
    }
    i = i + 1
  }
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      if i < end && data[i].to_int() < 0x80 {
        i = i + 1
        if i + 8 <= end && data[i + 7].to_int() < 0x80 {
          while i + 8 <= end {
            let m = data[i].to_int() |
            data[i + 1].to_int() |
            data[i + 2].to_int() |
            data[i + 3].to_int() |
            data[i + 4].to_int() |
            data[i + 5].to_int() |
            data[i + 6].to_int() |
            data[i + 7].to_int()
            if (m & 0x80) == 0 {
              i = i + 8
            } else {
              break
            }
          }
        }
      }
    } else if b0 < 0xE0 {
      if b0 < 0xC2 {
        return -1
      }
      if i + 1 >= end {
        return 1
      }
      if (data[i + 1].to_int() & 0xC0) != 0x80 {
        return -1
      }
      i = i + 2
    } else if b0 < 0xF0 {
      if i + 2 < end {
        let b1 = data[i + 1].to_int()
        let b2 = data[i + 2].to_int()
        if b0 != 0xE0 && b0 != 0xED {
          if (((b1 ^ 0x80) | (b2 ^ 0x80)) & 0xC0) != 0 {
            return -1
          }
        } else if b0 == 0xE0 {
          if b1 < 0xA0 || b1 > 0xBF || (b2 & 0xC0) != 0x80 {
            return -1
          }
        } else {
          if b1 < 0x80 || b1 > 0x9F || (b2 & 0xC0) != 0x80 {
            return -1
          }
        }
        i = i + 3
      } else {
        let next_st = if b0 == 0xE0 {
          3
        } else if b0 == 0xED {
          4
        } else {
          2
        }
        if i + 1 == end {
          return next_st
        }
        let b1 = data[i + 1].to_int()
        if next_st == 3 {
          if b1 < 0xA0 || b1 > 0xBF {
            return -1
          }
        } else if next_st == 4 {
          if b1 < 0x80 || b1 > 0x9F {
            return -1
          }
        } else if (b1 & 0xC0) != 0x80 {
          return -1
        }
        return 1
      }
    } else if b0 <= 0xF4 {
      if i + 3 < end {
        let b1 = data[i + 1].to_int()
        let b2 = data[i + 2].to_int()
        let b3 = data[i + 3].to_int()
        if (((b2 ^ 0x80) | (b3 ^ 0x80)) & 0xC0) != 0 {
          return -1
        }
        if b0 == 0xF0 {
          if b1 < 0x90 || b1 > 0xBF {
            return -1
          }
        } else if b0 == 0xF4 {
          if b1 < 0x80 || b1 > 0x8F {
            return -1
          }
        } else if (b1 & 0xC0) != 0x80 {
          return -1
        }
        i = i + 4
      } else {
        let next_st = if b0 == 0xF0 {
          5
        } else if b0 == 0xF4 {
          7
        } else {
          6
        }
        if i + 1 == end {
          return next_st
        }
        let b1 = data[i + 1].to_int()
        if next_st == 5 {
          if b1 < 0x90 || b1 > 0xBF {
            return -1
          }
        } else if next_st == 7 {
          if b1 < 0x80 || b1 > 0x8F {
            return -1
          }
        } else if (b1 & 0xC0) != 0x80 {
          return -1
        }
        if i + 2 == end {
          return 2
        }
        let b2 = data[i + 2].to_int()
        if (b2 & 0xC0) != 0x80 {
          return -1
        }
        return 1
      }
    } else {
      return -1
    }
  }
  st
}

///| Strict RFC 3629 UTF-8 validation over a byte range `[start, end)`.
pub fn validate_utf8_range(data : Bytes, start : Int, end : Int) -> Bool {
  validate_utf8_step(0, data, start, end) == 0
}

///| Strict RFC 3629 UTF-8 validation over an entire `Bytes` buffer.
pub fn validate_utf8(data : Bytes) -> Bool {
  validate_utf8_step(0, data, 0, data.length()) == 0
}
