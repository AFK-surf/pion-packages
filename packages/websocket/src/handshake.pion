///| RFC 6455 HTTP Upgrade handshake, pure Pion FIPS 180-4 SHA-1, and RFC 4648 Base64.

///|
fn rotl32(x : UInt, n : UInt) -> UInt {
  ((x << n) | (x >> (32U - n))) & 0xFFFFFFFFU
}

///| Pure Pion FIPS 180-4 SHA-1 returning a 20-byte digest.
pub fn sha1(data : Bytes) -> Bytes {
  let len = data.length()
  let bit_len : Int64 = len.to_int64() * 8L
  // Total padded length: multiple of 64 bytes with 0x80 + zeros + 8-byte BE bit length
  let rem = (len + 9) % 64
  let pad_zeros = if rem == 0 { 0 } else { 64 - rem }
  let total = len + 1 + pad_zeros + 8
  let mut msg = Bytes::new(total)
  let mut i = 0
  while i < len {
    msg[i] = data[i]
    i = i + 1
  }
  msg[len] = (0x80).to_byte()
  // Write 64-bit big-endian bit length into last 8 bytes
  let mut bi = 0
  while bi < 8 {
    let shift = ((7 - bi) * 8).to_int64()
    msg[total - 8 + bi] = ((bit_len >> shift) & 0xFFL).to_int().to_byte()
    bi = bi + 1
  }

  let mut h0 : UInt = 0x67452301U
  let mut h1 : UInt = 0xEFCDAB89U
  let mut h2 : UInt = 0x98BADCFEU
  let mut h3 : UInt = 0x10325476U
  let mut h4 : UInt = 0xC3D2E1F0U

  let w : FixedArray[UInt] = FixedArray::make(80, 0U)
  let mut off = 0
  while off < total {
    let mut t = 0
    while t < 16 {
      let base = off + t * 4
      let b0 = msg[base].to_int().to_uint()
      let b1 = msg[base + 1].to_int().to_uint()
      let b2 = msg[base + 2].to_int().to_uint()
      let b3 = msg[base + 3].to_int().to_uint()
      w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
      t = t + 1
    }
    while t < 80 {
      w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1U)
      t = t + 1
    }

    let mut a = h0
    let mut b = h1
    let mut c = h2
    let mut d = h3
    let mut e = h4

    t = 0
    while t < 80 {
      let f = if t < 20 {
        (b & c) | ((b ^ 0xFFFFFFFFU) & d)
      } else if t < 40 {
        b ^ c ^ d
      } else if t < 60 {
        (b & c) | (b & d) | (c & d)
      } else {
        b ^ c ^ d
      }
      let k = if t < 20 {
        0x5A827999U
      } else if t < 40 {
        0x6ED9EBA1U
      } else if t < 60 {
        0x8F1BBCDCU
      } else {
        0xCA62C1D6U
      }
      let temp = (rotl32(a, 5U) + f + e + k + w[t]) & 0xFFFFFFFFU
      e = d
      d = c
      c = rotl32(b, 30U)
      b = a
      a = temp
      t = t + 1
    }

    h0 = (h0 + a) & 0xFFFFFFFFU
    h1 = (h1 + b) & 0xFFFFFFFFU
    h2 = (h2 + c) & 0xFFFFFFFFU
    h3 = (h3 + d) & 0xFFFFFFFFU
    h4 = (h4 + e) & 0xFFFFFFFFU
    off = off + 64
  }

  let mut digest = Bytes::new(20)
  let hs = [h0, h1, h2, h3, h4]
  let mut hi = 0
  while hi < 5 {
    let hv = hs[hi]
    digest[hi * 4] = ((hv >> 24) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 1] = ((hv >> 16) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 2] = ((hv >> 8) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 3] = (hv & 0xFFU).to_int().to_byte()
    hi = hi + 1
  }
  digest
}

///| Pure Pion RFC 4648 Base64 encoder.
pub fn base64_encode(data : Bytes) -> String {
  let n = data.length()
  if n == 0 {
    return ""
  }
  let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let out_len = ((n + 2) / 3) * 4
  let mut out = Bytes::new(out_len)
  let mut i = 0
  let mut o = 0
  while i + 3 <= n {
    let v = (data[i].to_int() << 16) |
    (data[i + 1].to_int() << 8) |
    data[i + 2].to_int()
    out[o] = alpha.code_unit_at((v >> 18) & 0x3F).to_byte()
    out[o + 1] = alpha.code_unit_at((v >> 12) & 0x3F).to_byte()
    out[o + 2] = alpha.code_unit_at((v >> 6) & 0x3F).to_byte()
    out[o + 3] = alpha.code_unit_at(v & 0x3F).to_byte()
    i = i + 3
    o = o + 4
  }
  let rem = n - i
  if rem == 1 {
    let v = data[i].to_int() << 16
    out[o] = alpha.code_unit_at((v >> 18) & 0x3F).to_byte()
    out[o + 1] = alpha.code_unit_at((v >> 12) & 0x3F).to_byte()
    out[o + 2] = (61).to_byte() // '='
    out[o + 3] = (61).to_byte()
  } else if rem == 2 {
    let v = (data[i].to_int() << 16) | (data[i + 1].to_int() << 8)
    out[o] = alpha.code_unit_at((v >> 18) & 0x3F).to_byte()
    out[o + 1] = alpha.code_unit_at((v >> 12) & 0x3F).to_byte()
    out[o + 2] = alpha.code_unit_at((v >> 6) & 0x3F).to_byte()
    out[o + 3] = (61).to_byte()
  }
  out.to_string()
}

///|
fn b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

///| Pure Pion RFC 4648 Base64 decoder.
pub fn base64_decode(s : String) -> Result[Bytes, WsError] {
  let n = s.length()
  if n == 0 {
    return Ok(Bytes::new(0))
  }
  if n % 4 != 0 {
    return Err(WsError::InvalidHandshake("invalid base64 length"))
  }
  let mut pad = 0
  if s.code_unit_at(n - 1) == 61 {
    pad = pad + 1
  }
  if n >= 2 && s.code_unit_at(n - 2) == 61 {
    pad = pad + 1
  }
  let out_len = (n / 4) * 3 - pad
  let mut out = Bytes::new(out_len)
  let mut i = 0
  let mut o = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    let c1 = s.code_unit_at(i + 1)
    let c2 = s.code_unit_at(i + 2)
    let c3 = s.code_unit_at(i + 3)
    let v0 = b64_val(c0)
    let v1 = b64_val(c1)
    if v0 < 0 || v1 < 0 {
      return Err(WsError::InvalidHandshake("invalid base64 character"))
    }
    let is_last = i + 4 == n
    if is_last && c2 == 61 && c3 == 61 {
      out[o] = (((v0 << 2) | (v1 >> 4)) & 0xFF).to_byte()
      o = o + 1
    } else if is_last && c3 == 61 {
      let v2 = b64_val(c2)
      if v2 < 0 {
        return Err(WsError::InvalidHandshake("invalid base64 character"))
      }
      out[o] = (((v0 << 2) | (v1 >> 4)) & 0xFF).to_byte()
      out[o + 1] = (((v1 << 4) | (v2 >> 2)) & 0xFF).to_byte()
      o = o + 2
    } else {
      let v2 = b64_val(c2)
      let v3 = b64_val(c3)
      if v2 < 0 || v3 < 0 {
        return Err(WsError::InvalidHandshake("invalid base64 character"))
      }
      out[o] = (((v0 << 2) | (v1 >> 4)) & 0xFF).to_byte()
      out[o + 1] = (((v1 << 4) | (v2 >> 2)) & 0xFF).to_byte()
      out[o + 2] = (((v2 << 6) | v3) & 0xFF).to_byte()
      o = o + 3
    }
    i = i + 4
  }
  Ok(out)
}

///| Compute RFC 6455 §1.3 `Sec-WebSocket-Accept` from a client `Sec-WebSocket-Key`.
pub fn compute_accept_key(sec_key : String) -> String {
  let guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
  let digest = sha1((sec_key + guid).to_bytes())
  base64_encode(digest)
}

///|
fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = (c & 0xFF).to_byte()
    }
    i = i + 1
  }
  out.to_string()
}

///|
fn header_has_token_ci(hdr_val : String, token_lower : String) -> Bool {
  let parts = hdr_val.split(",")
  let mut i = 0
  while i < parts.length() {
    if ascii_lower(parts[i].trim()) == token_lower {
      return true
    }
    i = i + 1
  }
  false
}

///| Build an RFC 6455 HTTP/1.1 client WebSocket Upgrade request.
pub fn build_client_handshake(
  host : String,
  path : String,
  sec_key : String,
  protocols : Array[String],
) -> String {
  let sb = StringBuilder::new()
  sb.write_string("GET ")
  sb.write_string(path)
  sb.write_string(" HTTP/1.1\r\n")
  sb.write_string("Host: ")
  sb.write_string(host)
  sb.write_string("\r\n")
  sb.write_string("Upgrade: websocket\r\n")
  sb.write_string("Connection: Upgrade\r\n")
  sb.write_string("Sec-WebSocket-Key: ")
  sb.write_string(sec_key)
  sb.write_string("\r\n")
  sb.write_string("Sec-WebSocket-Version: 13\r\n")
  if protocols.length() > 0 {
    sb.write_string("Sec-WebSocket-Protocol: ")
    let mut i = 0
    while i < protocols.length() {
      if i > 0 {
        sb.write_string(", ")
      }
      sb.write_string(protocols[i])
      i = i + 1
    }
    sb.write_string("\r\n")
  }
  sb.write_string("\r\n")
  sb.to_string()
}

///| Parse and strictly validate an RFC 6455 client HTTP Upgrade request.
pub fn parse_client_handshake(raw : String) -> Result[HandshakeRequest, WsError] {
  let hdr_end = raw.index_of("\r\n\r\n")
  if hdr_end < 0 {
    return Err(WsError::InvalidHandshake("incomplete HTTP headers"))
  }
  let head = raw.slice(0, hdr_end)
  let lines = head.split("\r\n")
  if lines.length() < 2 {
    return Err(WsError::InvalidHandshake("missing request headers"))
  }
  // Request line: GET <path> HTTP/1.1
  let req_parts = lines[0].split(" ")
  if req_parts.length() != 3 {
    return Err(WsError::InvalidHandshake("malformed request line"))
  }
  if req_parts[0] != "GET" {
    return Err(WsError::InvalidHandshake("method must be GET"))
  }
  let path = req_parts[1]
  if path.length() == 0 {
    return Err(WsError::InvalidHandshake("empty request path"))
  }
  if req_parts[2] != "HTTP/1.1" {
    return Err(WsError::InvalidHandshake("HTTP version must be HTTP/1.1"))
  }

  let mut host = ""
  let mut has_host = false
  let mut has_upgrade = false
  let mut has_connection = false
  let mut key = ""
  let mut has_key = false
  let mut version = ""
  let mut origin : Option[String] = None
  let mut protocols : Array[String] = []

  let mut i = 1
  while i < lines.length() {
    let line = lines[i]
    let colon = line.index_of(":")
    if colon <= 0 {
      return Err(WsError::InvalidHandshake("malformed header line"))
    }
    let name = ascii_lower(line.slice(0, colon).trim())
    let value = line.slice(colon + 1, line.length()).trim()
    if name == "host" {
      host = value
      has_host = value.length() > 0
    } else if name == "upgrade" {
      if header_has_token_ci(value, "websocket") {
        has_upgrade = true
      }
    } else if name == "connection" {
      if header_has_token_ci(value, "upgrade") {
        has_connection = true
      }
    } else if name == "sec-websocket-key" {
      key = value
      has_key = true
    } else if name == "sec-websocket-version" {
      version = value
    } else if name == "origin" {
      origin = Some(value)
    } else if name == "sec-websocket-protocol" {
      let ps = value.split(",")
      let mut pi = 0
      while pi < ps.length() {
        let p = ps[pi].trim()
        if p.length() > 0 {
          protocols.push(p)
        }
        pi = pi + 1
      }
    }
    i = i + 1
  }

  if !has_host {
    return Err(WsError::InvalidHandshake("missing Host header"))
  }
  if !has_upgrade {
    return Err(WsError::InvalidHandshake("missing or invalid Upgrade header"))
  }
  if !has_connection {
    return Err(WsError::InvalidHandshake("missing or invalid Connection header"))
  }
  if version != "13" {
    return Err(WsError::InvalidHandshake("Sec-WebSocket-Version must be 13"))
  }
  if !has_key {
    return Err(WsError::InvalidHandshake("missing Sec-WebSocket-Key header"))
  }
  match base64_decode(key) {
    Ok(decoded) =>
    if decoded.length() != 16 {
      return Err(
        WsError::InvalidHandshake(
          "Sec-WebSocket-Key must decode to 16 bytes",
        ),
      )
    }
    Err(e) => return Err(e)
  }

  Ok(HandshakeRequest::{
    path: path,
    host: host,
    key: key,
    protocols: protocols,
    origin: origin,
  })
}

///| Build an RFC 6455 HTTP/1.1 101 Switching Protocols server response.
pub fn build_server_handshake(
  sec_key : String,
  protocol : Option[String],
) -> String {
  let accept = compute_accept_key(sec_key)
  let sb = StringBuilder::new()
  sb.write_string("HTTP/1.1 101 Switching Protocols\r\n")
  sb.write_string("Upgrade: websocket\r\n")
  sb.write_string("Connection: Upgrade\r\n")
  sb.write_string("Sec-WebSocket-Accept: ")
  sb.write_string(accept)
  sb.write_string("\r\n")
  match protocol {
    Some(p) =>
    if p.length() > 0 {
      sb.write_string("Sec-WebSocket-Protocol: ")
      sb.write_string(p)
      sb.write_string("\r\n")
    }
    None => ()
  }
  sb.write_string("\r\n")
  sb.to_string()
}

///| Verify an RFC 6455 server 101 Switching Protocols response.
pub fn verify_server_handshake(
  raw : String,
  expected_key : String,
  offered_protocols : Array[String],
) -> Result[HandshakeResponse, WsError] {
  let hdr_end = raw.index_of("\r\n\r\n")
  if hdr_end < 0 {
    return Err(WsError::InvalidHandshake("incomplete HTTP response"))
  }
  let head = raw.slice(0, hdr_end)
  let lines = head.split("\r\n")
  if lines.length() < 2 {
    return Err(WsError::InvalidHandshake("missing response headers"))
  }
  let status_line = lines[0]
  if !status_line.starts_with("HTTP/1.1 101") {
    return Err(WsError::InvalidHandshake("expected HTTP/1.1 101 status"))
  }
  if status_line.length() > 12 && status_line.code_unit_at(12) != 32 {
    return Err(WsError::InvalidHandshake("malformed 101 status line"))
  }

  let mut has_upgrade = false
  let mut has_connection = false
  let mut accept = ""
  let mut protocol : Option[String] = None

  let mut i = 1
  while i < lines.length() {
    let line = lines[i]
    let colon = line.index_of(":")
    if colon <= 0 {
      return Err(WsError::InvalidHandshake("malformed header line"))
    }
    let name = ascii_lower(line.slice(0, colon).trim())
    let value = line.slice(colon + 1, line.length()).trim()
    if name == "upgrade" {
      if header_has_token_ci(value, "websocket") {
        has_upgrade = true
      }
    } else if name == "connection" {
      if header_has_token_ci(value, "upgrade") {
        has_connection = true
      }
    } else if name == "sec-websocket-accept" {
      accept = value
    } else if name == "sec-websocket-protocol" {
      protocol = Some(value)
    }
    i = i + 1
  }

  if !has_upgrade {
    return Err(WsError::InvalidHandshake("missing or invalid Upgrade header"))
  }
  if !has_connection {
    return Err(WsError::InvalidHandshake("missing or invalid Connection header"))
  }
  let expected_accept = compute_accept_key(expected_key)
  if accept != expected_accept {
    return Err(WsError::InvalidHandshake("Sec-WebSocket-Accept mismatch"))
  }
  match protocol {
    Some(p) => {
      let mut found = false
      let mut pi = 0
      while pi < offered_protocols.length() {
        if offered_protocols[pi] == p {
          found = true
          break
        }
        pi = pi + 1
      }
      if !found {
        return Err(
          WsError::InvalidHandshake(
            "server selected unoffered Sec-WebSocket-Protocol",
          ),
        )
      }
    }
    None => ()
  }

  Ok(HandshakeResponse::{ accept: accept, protocol: protocol })
}
