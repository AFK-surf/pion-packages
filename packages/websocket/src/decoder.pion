///| RFC 6455 streaming Sans-IO WebSocket decoder.

///|
pub struct Decoder {
  pub role : Role
  pub max_message_size : Int
  mut buf : Bytes
  mut read_pos : Int
  mut write_pos : Int
  mut frag_opcode : Option[Opcode]
  mut frag_chunks : Array[Bytes]
  mut frag_total_len : Int
}

///| Create a new streaming Sans-IO WebSocket `Decoder`.
pub fn Decoder::new(role : Role, max_message_size : Int) -> Decoder {
  Decoder::{
    role: role,
    max_message_size: max_message_size,
    buf: Bytes::new(4096),
    read_pos: 0,
    write_pos: 0,
    frag_opcode: None,
    frag_chunks: [],
    frag_total_len: 0,
  }
}

///| Return the number of unparsed bytes currently buffered.
pub fn Decoder::buffered_len(self : Decoder) -> Int {
  self.write_pos - self.read_pos
}

///| Reset all buffered bytes and in-progress fragmentation state.
pub fn Decoder::reset(self : Decoder) -> Unit {
  self.read_pos = 0
  self.write_pos = 0
  self.frag_opcode = None
  self.frag_chunks = []
  self.frag_total_len = 0
}

///| Feed raw network bytes into the decoder buffer (amortized O(1) compaction).
pub fn Decoder::feed(self : Decoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  let avail = self.write_pos - self.read_pos
  if avail == 0 {
    self.read_pos = 0
    self.write_pos = 0
  }
  let cap = self.buf.length()
  if self.write_pos + clen > cap {
    let needed = avail + clen
    if needed <= cap {
      // Compact unread bytes to front of existing buffer
      let mut i = 0
      while i < avail {
        self.buf[i] = self.buf[self.read_pos + i]
        i = i + 1
      }
      self.read_pos = 0
      self.write_pos = avail
    } else {
      let mut new_cap = if cap > 0 { cap * 2 } else { 4096 }
      while new_cap < needed {
        new_cap = new_cap * 2
      }
      let mut next_buf = Bytes::new(new_cap)
      let mut i = 0
      while i < avail {
        next_buf[i] = self.buf[self.read_pos + i]
        i = i + 1
      }
      self.buf = next_buf
      self.read_pos = 0
      self.write_pos = avail
    }
  }
  let base = self.write_pos
  let mut i = 0
  while i + 8 <= clen {
    self.buf[base + i] = chunk[i]
    self.buf[base + i + 1] = chunk[i + 1]
    self.buf[base + i + 2] = chunk[i + 2]
    self.buf[base + i + 3] = chunk[i + 3]
    self.buf[base + i + 4] = chunk[i + 4]
    self.buf[base + i + 5] = chunk[i + 5]
    self.buf[base + i + 6] = chunk[i + 6]
    self.buf[base + i + 7] = chunk[i + 7]
    i = i + 8
  }
  while i < clen {
    self.buf[base + i] = chunk[i]
    i = i + 1
  }
  self.write_pos = base + clen
}

///|
fn extract_payload(
  buf : Bytes,
  start : Int,
  len : Int,
  masked : Bool,
  m0 : Int,
  m1 : Int,
  m2 : Int,
  m3 : Int,
) -> Bytes {
  let mut out = Bytes::new(len)
  if len == 0 {
    return out
  }
  if masked {
    let mut i = 0
    while i + 8 <= len {
      out[i] = (buf[start + i].to_int() ^ m0).to_byte()
      out[i + 1] = (buf[start + i + 1].to_int() ^ m1).to_byte()
      out[i + 2] = (buf[start + i + 2].to_int() ^ m2).to_byte()
      out[i + 3] = (buf[start + i + 3].to_int() ^ m3).to_byte()
      out[i + 4] = (buf[start + i + 4].to_int() ^ m0).to_byte()
      out[i + 5] = (buf[start + i + 5].to_int() ^ m1).to_byte()
      out[i + 6] = (buf[start + i + 6].to_int() ^ m2).to_byte()
      out[i + 7] = (buf[start + i + 7].to_int() ^ m3).to_byte()
      i = i + 8
    }
    if i + 4 <= len {
      out[i] = (buf[start + i].to_int() ^ m0).to_byte()
      out[i + 1] = (buf[start + i + 1].to_int() ^ m1).to_byte()
      out[i + 2] = (buf[start + i + 2].to_int() ^ m2).to_byte()
      out[i + 3] = (buf[start + i + 3].to_int() ^ m3).to_byte()
      i = i + 4
    }
    if i < len {
      out[i] = (buf[start + i].to_int() ^ m0).to_byte()
      i = i + 1
    }
    if i < len {
      out[i] = (buf[start + i].to_int() ^ m1).to_byte()
      i = i + 1
    }
    if i < len {
      out[i] = (buf[start + i].to_int() ^ m2).to_byte()
    }
  } else {
    let mut i = 0
    while i + 8 <= len {
      out[i] = buf[start + i]
      out[i + 1] = buf[start + i + 1]
      out[i + 2] = buf[start + i + 2]
      out[i + 3] = buf[start + i + 3]
      out[i + 4] = buf[start + i + 4]
      out[i + 5] = buf[start + i + 5]
      out[i + 6] = buf[start + i + 6]
      out[i + 7] = buf[start + i + 7]
      i = i + 8
    }
    while i < len {
      out[i] = buf[start + i]
      i = i + 1
    }
  }
  out
}

///|
fn concat_chunks(chunks : Array[Bytes], total_len : Int) -> Bytes {
  let mut out = Bytes::new(total_len)
  let mut off = 0
  let mut ci = 0
  let nchunks = chunks.length()
  while ci < nchunks {
    let c = chunks[ci]
    let clen = c.length()
    let mut j = 0
    while j + 8 <= clen {
      out[off + j] = c[j]
      out[off + j + 1] = c[j + 1]
      out[off + j + 2] = c[j + 2]
      out[off + j + 3] = c[j + 3]
      out[off + j + 4] = c[j + 4]
      out[off + j + 5] = c[j + 5]
      out[off + j + 6] = c[j + 6]
      out[off + j + 7] = c[j + 7]
      j = j + 8
    }
    while j < clen {
      out[off + j] = c[j]
      j = j + 1
    }
    off = off + clen
    ci = ci + 1
  }
  out
}

///| Attempt to decode the next complete WebSocket `Message` from buffered bytes.
///| Returns `Ok(None)` when more bytes are needed.
pub fn Decoder::next_message(self : Decoder) -> Result[Option[Message], WsError] {
  while true {
    let avail = self.write_pos - self.read_pos
    if avail < 2 {
      return Ok(None)
    }
    let base = self.read_pos
    let b0 = self.buf[base].to_int()
    let b1 = self.buf[base + 1].to_int()

    let fin = (b0 & 0x80) != 0
    let rsv = (b0 >> 4) & 0x07
    if rsv != 0 {
      return Err(WsError::NonZeroRsv(rsv))
    }
    let op_raw = b0 & 0x0F
    let opcode = match op_raw {
      0 => Opcode::Continuation
      1 => Opcode::Text
      2 => Opcode::Binary
      8 => Opcode::Close
      9 => Opcode::Ping
      10 => Opcode::Pong
      _ => return Err(WsError::InvalidOpcode(op_raw))
    }

    let masked = (b1 & 0x80) != 0
    match self.role {
      Role::Server =>
      if !masked {
        return Err(WsError::UnmaskedClientFrame)
      }
      Role::Client =>
      if masked {
        return Err(WsError::MaskedServerFrame)
      }
    }

    let is_control = op_raw >= 8
    let len7 = b1 & 0x7F
    if is_control {
      if !fin {
        return Err(WsError::FragmentedControlFrame)
      }
      if len7 > 125 {
        return Err(WsError::ControlFrameTooLarge(len7))
      }
    }

    let mut hdr_len = 2
    let mut payload_len = len7
    if len7 == 126 {
      if avail < 4 {
        return Ok(None)
      }
      payload_len = (self.buf[base + 2].to_int() << 8) |
      self.buf[base + 3].to_int()
      if payload_len < 126 {
        return Err(WsError::NonMinimalLength)
      }
      hdr_len = 4
    } else if len7 == 127 {
      if avail < 10 {
        return Ok(None)
      }
      let hi_byte = self.buf[base + 2].to_int()
      if (hi_byte & 0x80) != 0 {
        return Err(
          WsError::InvalidPayloadLength("64-bit payload length MSB must be 0"),
        )
      }
      let len64 : Int64 = (self.buf[base + 2].to_int().to_int64() << 56L) |
      (self.buf[base + 3].to_int().to_int64() << 48L) |
      (self.buf[base + 4].to_int().to_int64() << 40L) |
      (self.buf[base + 5].to_int().to_int64() << 32L) |
      (self.buf[base + 6].to_int().to_int64() << 24L) |
      (self.buf[base + 7].to_int().to_int64() << 16L) |
      (self.buf[base + 8].to_int().to_int64() << 8L) |
      self.buf[base + 9].to_int().to_int64()
      if len64 < 65536L {
        return Err(WsError::NonMinimalLength)
      }
      if len64 > self.max_message_size.to_int64() {
        return Err(
          WsError::MessageTooLarge(
            if len64 > 2147483647L { 2147483647 } else { len64.to_int() },
            self.max_message_size,
          ),
        )
      }
      payload_len = len64.to_int()
      hdr_len = 10
    }

    if !is_control && payload_len > self.max_message_size {
      return Err(WsError::MessageTooLarge(payload_len, self.max_message_size))
    }
    if op_raw == 0 && self.frag_total_len + payload_len > self.max_message_size {
      return Err(
        WsError::MessageTooLarge(
          self.frag_total_len + payload_len,
          self.max_message_size,
        ),
      )
    }

    let mut m0 = 0
    let mut m1 = 0
    let mut m2 = 0
    let mut m3 = 0
    if masked {
      if avail < hdr_len + 4 {
        return Ok(None)
      }
      m0 = self.buf[base + hdr_len].to_int()
      m1 = self.buf[base + hdr_len + 1].to_int()
      m2 = self.buf[base + hdr_len + 2].to_int()
      m3 = self.buf[base + hdr_len + 3].to_int()
      hdr_len = hdr_len + 4
    }

    let frame_total = hdr_len + payload_len
    if avail < frame_total {
      return Ok(None)
    }

    let payload = extract_payload(
      self.buf,
      base + hdr_len,
      payload_len,
      masked,
      m0,
      m1,
      m2,
      m3,
    )
    self.read_pos = base + frame_total
    if self.read_pos == self.write_pos {
      self.read_pos = 0
      self.write_pos = 0
    }

    match opcode {
      Opcode::Ping => return Ok(Some(Message::Ping(payload)))
      Opcode::Pong => return Ok(Some(Message::Pong(payload)))
      Opcode::Close => {
        let plen = payload.length()
        if plen == 0 {
          return Ok(Some(Message::Close(None)))
        }
        if plen == 1 {
          return Err(
            WsError::InvalidCloseFrame("1-byte close frame is illegal"),
          )
        }
        let code = (payload[0].to_int() << 8) | payload[1].to_int()
        if !is_valid_close_code(code) {
          return Err(WsError::InvalidCloseCode(code))
        }
        if !validate_utf8_range(payload, 2, plen) {
          return Err(WsError::InvalidUtf8("invalid UTF-8 in close reason"))
        }
        let reason = if plen == 2 {
          ""
        } else {
          payload.slice(2, plen).to_string()
        }
        return Ok(Some(Message::Close(Some(CloseFrame::new(code, reason)))))
      }
      Opcode::Text => {
        match self.frag_opcode {
          Some(_) => return Err(WsError::ExpectedContinuation)
          None => ()
        }
        if fin {
          if !validate_utf8(payload) {
            return Err(WsError::InvalidUtf8("invalid UTF-8 in text frame"))
          }
          return Ok(Some(Message::Text(payload.to_string())))
        } else {
          self.frag_opcode = Some(Opcode::Text)
          self.frag_chunks = [payload]
          self.frag_total_len = payload.length()
        }
      }
      Opcode::Binary => {
        match self.frag_opcode {
          Some(_) => return Err(WsError::ExpectedContinuation)
          None => ()
        }
        if fin {
          return Ok(Some(Message::Binary(payload)))
        } else {
          self.frag_opcode = Some(Opcode::Binary)
          self.frag_chunks = [payload]
          self.frag_total_len = payload.length()
        }
      }
      Opcode::Continuation => {
        let orig = match self.frag_opcode {
          Some(op) => op
          None => return Err(WsError::UnexpectedContinuation)
        }
        self.frag_chunks.push(payload)
        self.frag_total_len = self.frag_total_len + payload.length()
        if fin {
          let full = concat_chunks(self.frag_chunks, self.frag_total_len)
          self.frag_opcode = None
          self.frag_chunks = []
          self.frag_total_len = 0
          match orig {
            Opcode::Text => {
              if !validate_utf8(full) {
                return Err(
                  WsError::InvalidUtf8("invalid UTF-8 in fragmented text"),
                )
              }
              return Ok(Some(Message::Text(full.to_string())))
            }
            _ => return Ok(Some(Message::Binary(full)))
          }
        }
      }
    }
  }
  Ok(None)
}
