///| RFC 6455 streaming Sans-IO WebSocket decoder with bounded zero-copy chunk queue
///| and direct cross-chunk unmasking.

///|
pub struct Decoder {
  pub role : Role
  pub max_message_size : Int
  mut cur : Bytes
  mut cur_pos : Int
  mut cur_len : Int
  mut queue : Array[Bytes]
  mut queue_head : Int
  mut pending_total : Int
  mut frag_opcode : Option[Opcode]
  mut frag_chunks : Array[Bytes]
  mut frag_total_len : Int
  mut frag_utf8_state : Int
  mut closed : Bool
  empty_bytes : Bytes
}

///| Create a new streaming Sans-IO WebSocket `Decoder`.
pub fn Decoder::new(role : Role, max_message_size : Int) -> Decoder {
  let empty = Bytes::new(0)
  Decoder::{
    role: role,
    max_message_size: max_message_size,
    cur: empty,
    cur_pos: 0,
    cur_len: 0,
    queue: [],
    queue_head: 0,
    pending_total: 0,
    frag_opcode: None,
    frag_chunks: [],
    frag_total_len: 0,
    frag_utf8_state: 0,
    closed: false,
    empty_bytes: empty,
  }
}

///| Return the number of unparsed bytes currently buffered.
pub fn Decoder::buffered_len(self : Decoder) -> Int {
  self.pending_total
}

///| Reset all buffered bytes, close state, and in-progress fragmentation state.
pub fn Decoder::reset(self : Decoder) -> Unit {
  self.cur = self.empty_bytes
  self.cur_pos = 0
  self.cur_len = 0
  self.queue = []
  self.queue_head = 0
  self.pending_total = 0
  self.frag_opcode = None
  self.frag_chunks = []
  self.frag_total_len = 0
  self.frag_utf8_state = 0
  self.closed = false
}

///| Feed raw network bytes into the decoder (O(1) zero-copy queue).
pub fn Decoder::feed(self : Decoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  if self.pending_total == 0 {
    self.cur = chunk
    self.cur_pos = 0
    self.cur_len = clen
    self.pending_total = clen
  } else {
    self.queue.push(chunk)
    self.pending_total = self.pending_total + clen
  }
}

///|
fn copy_bytes_slice(
  dst : Bytes,
  dst_off : Int,
  src : Bytes,
  src_off : Int,
  len : Int,
) -> Unit {
  let mut di = dst_off
  let mut si = src_off
  let end = src_off + len
  while si + 8 <= end {
    dst[di] = src[si]
    dst[di + 1] = src[si + 1]
    dst[di + 2] = src[si + 2]
    dst[di + 3] = src[si + 3]
    dst[di + 4] = src[si + 4]
    dst[di + 5] = src[si + 5]
    dst[di + 6] = src[si + 6]
    dst[di + 7] = src[si + 7]
    di = di + 8
    si = si + 8
  }
  while si < end {
    dst[di] = src[si]
    di = di + 1
    si = si + 1
  }
}

///| Advance `cur` to the next queued chunk once `cur` is fully consumed,
///| immediately releasing consumed chunks and compacting the queue to stay O(1) memory.
fn Decoder::advance_chunk(self : Decoder) -> Unit {
  if self.cur_pos >= self.cur_len {
    let q = self.queue
    let qlen = q.length()
    if self.queue_head < qlen {
      let next = q[self.queue_head]
      q[self.queue_head] = self.empty_bytes
      self.queue_head = self.queue_head + 1
      if self.queue_head == qlen {
        q.clear()
        self.queue_head = 0
      } else if self.queue_head >= 16 && self.queue_head * 2 >= qlen {
        let rem = qlen - self.queue_head
        let mut new_q : Array[Bytes] = []
        let mut i = 0
        while i < rem {
          new_q.push(q[self.queue_head + i])
          i = i + 1
        }
        self.queue = new_q
        self.queue_head = 0
      }
      self.cur = next
      self.cur_pos = 0
      self.cur_len = next.length()
    } else {
      self.cur = self.empty_bytes
      self.cur_pos = 0
      self.cur_len = 0
    }
  }
}

///| Peek a single byte at `offset` from the logical read head without coalescing.
fn Decoder::peek_byte(self : Decoder, offset : Int) -> Int {
  let avail = self.cur_len - self.cur_pos
  if offset < avail {
    return self.cur[self.cur_pos + offset].to_int()
  }
  let mut rem = offset - avail
  let q = self.queue
  let qlen = q.length()
  let mut qi = self.queue_head
  while qi < qlen {
    let c = q[qi]
    let clen = c.length()
    if rem < clen {
      return c[rem].to_int()
    }
    rem = rem - clen
    qi = qi + 1
  }
  0
}

///| Discard `count` bytes from the logical read head (caller ensures `count <= pending_total`).
fn Decoder::skip_bytes(self : Decoder, count : Int) -> Unit {
  self.pending_total = self.pending_total - count
  let avail = self.cur_len - self.cur_pos
  if count < avail {
    self.cur_pos = self.cur_pos + count
    return ()
  }
  let mut rem = count
  while rem > 0 {
    let a = self.cur_len - self.cur_pos
    if rem < a {
      self.cur_pos = self.cur_pos + rem
      return ()
    }
    rem = rem - a
    self.cur_pos = self.cur_len
    self.advance_chunk()
  }
}

///|
fn extract_payload_into(
  dst : Bytes,
  dst_off : Int,
  buf : Bytes,
  start : Int,
  len : Int,
  masked : Bool,
  m0 : Int,
  m1 : Int,
  m2 : Int,
  m3 : Int,
) -> Unit {
  if len == 0 {
    return ()
  }
  if masked {
    let mut di = dst_off
    let mut si = start
    let end = start + len
    while si + 16 <= end {
      dst[di] = (buf[si].to_int() ^ m0).to_byte()
      dst[di + 1] = (buf[si + 1].to_int() ^ m1).to_byte()
      dst[di + 2] = (buf[si + 2].to_int() ^ m2).to_byte()
      dst[di + 3] = (buf[si + 3].to_int() ^ m3).to_byte()
      dst[di + 4] = (buf[si + 4].to_int() ^ m0).to_byte()
      dst[di + 5] = (buf[si + 5].to_int() ^ m1).to_byte()
      dst[di + 6] = (buf[si + 6].to_int() ^ m2).to_byte()
      dst[di + 7] = (buf[si + 7].to_int() ^ m3).to_byte()
      dst[di + 8] = (buf[si + 8].to_int() ^ m0).to_byte()
      dst[di + 9] = (buf[si + 9].to_int() ^ m1).to_byte()
      dst[di + 10] = (buf[si + 10].to_int() ^ m2).to_byte()
      dst[di + 11] = (buf[si + 11].to_int() ^ m3).to_byte()
      dst[di + 12] = (buf[si + 12].to_int() ^ m0).to_byte()
      dst[di + 13] = (buf[si + 13].to_int() ^ m1).to_byte()
      dst[di + 14] = (buf[si + 14].to_int() ^ m2).to_byte()
      dst[di + 15] = (buf[si + 15].to_int() ^ m3).to_byte()
      di = di + 16
      si = si + 16
    }
    if si + 8 <= end {
      dst[di] = (buf[si].to_int() ^ m0).to_byte()
      dst[di + 1] = (buf[si + 1].to_int() ^ m1).to_byte()
      dst[di + 2] = (buf[si + 2].to_int() ^ m2).to_byte()
      dst[di + 3] = (buf[si + 3].to_int() ^ m3).to_byte()
      dst[di + 4] = (buf[si + 4].to_int() ^ m0).to_byte()
      dst[di + 5] = (buf[si + 5].to_int() ^ m1).to_byte()
      dst[di + 6] = (buf[si + 6].to_int() ^ m2).to_byte()
      dst[di + 7] = (buf[si + 7].to_int() ^ m3).to_byte()
      di = di + 8
      si = si + 8
    }
    if si + 4 <= end {
      dst[di] = (buf[si].to_int() ^ m0).to_byte()
      dst[di + 1] = (buf[si + 1].to_int() ^ m1).to_byte()
      dst[di + 2] = (buf[si + 2].to_int() ^ m2).to_byte()
      dst[di + 3] = (buf[si + 3].to_int() ^ m3).to_byte()
      di = di + 4
      si = si + 4
    }
    if si < end {
      dst[di] = (buf[si].to_int() ^ m0).to_byte()
      di = di + 1
      si = si + 1
    }
    if si < end {
      dst[di] = (buf[si].to_int() ^ m1).to_byte()
      di = di + 1
      si = si + 1
    }
    if si < end {
      dst[di] = (buf[si].to_int() ^ m2).to_byte()
    }
  } else {
    copy_bytes_slice(dst, dst_off, buf, start, len)
  }
}

///| Read and unmask `len` payload bytes directly from the chunk queue into `dst[dst_off..]`,
///| avoiding any intermediate `coalesce()` allocation or double copy.
fn Decoder::read_payload_into(
  self : Decoder,
  dst : Bytes,
  dst_off : Int,
  len : Int,
  masked : Bool,
  m0 : Int,
  m1 : Int,
  m2 : Int,
  m3 : Int,
) -> Unit {
  if len == 0 {
    return ()
  }
  let avail = self.cur_len - self.cur_pos
  if avail >= len {
    extract_payload_into(
      dst,
      dst_off,
      self.cur,
      self.cur_pos,
      len,
      masked,
      m0,
      m1,
      m2,
      m3,
    )
    self.cur_pos = self.cur_pos + len
    self.pending_total = self.pending_total - len
    if self.cur_pos >= self.cur_len {
      self.advance_chunk()
    }
    return ()
  }
  self.pending_total = self.pending_total - len
  let mut remaining = len
  let mut out_off = dst_off
  let mut km0 = m0
  let mut km1 = m1
  let mut km2 = m2
  let mut km3 = m3
  while remaining > 0 {
    let a = self.cur_len - self.cur_pos
    let take = if remaining < a { remaining } else { a }
    extract_payload_into(
      dst,
      out_off,
      self.cur,
      self.cur_pos,
      take,
      masked,
      km0,
      km1,
      km2,
      km3,
    )
    out_off = out_off + take
    remaining = remaining - take
    self.cur_pos = self.cur_pos + take
    if self.cur_pos >= self.cur_len {
      self.advance_chunk()
    }
    if masked && remaining > 0 {
      let rot = take & 3
      if rot == 1 {
        let t = km0
        km0 = km1
        km1 = km2
        km2 = km3
        km3 = t
      } else if rot == 2 {
        let t0 = km0
        let t1 = km1
        km0 = km2
        km1 = km3
        km2 = t0
        km3 = t1
      } else if rot == 3 {
        let t = km3
        km3 = km2
        km2 = km1
        km1 = km0
        km0 = t
      }
    }
  }
}

///| Attempt to decode the next complete WebSocket `Message` from buffered bytes.
///| Returns `Ok(None)` when more bytes are needed or after a Close frame has been delivered.
pub fn Decoder::next_message(self : Decoder) -> Result[Option[Message], WsError] {
  if self.closed {
    return Ok(None)
  }
  while true {
    if self.pending_total < 2 {
      return Ok(None)
    }
    let cur_avail = self.cur_len - self.cur_pos
    let buf = self.cur
    let base = self.cur_pos
    let b0 = buf[base].to_int()
    let b1 = if cur_avail >= 2 {
      buf[base + 1].to_int()
    } else {
      self.queue[self.queue_head][0].to_int()
    }

    let fin = (b0 & 0x80) != 0
    let rsv = (b0 >> 4) & 0x07
    if rsv != 0 {
      return Err(WsError::NonZeroRsv(rsv))
    }
    let op_raw = b0 & 0x0F
    let opcode = match op_raw {
      0 => Opcode::Continuation
      1 => Opcode::Text
      2 => Opcode::Binary
      8 => Opcode::Close
      9 => Opcode::Ping
      10 => Opcode::Pong
      _ => return Err(WsError::InvalidOpcode(op_raw))
    }

    let masked = (b1 & 0x80) != 0
    match self.role {
      Role::Server =>
      if !masked {
        return Err(WsError::UnmaskedClientFrame)
      }
      Role::Client =>
      if masked {
        return Err(WsError::MaskedServerFrame)
      }
    }

    let is_control = op_raw >= 8
    let len7 = b1 & 0x7F
    if is_control {
      if !fin {
        return Err(WsError::FragmentedControlFrame)
      }
      if len7 > 125 {
        return Err(WsError::ControlFrameTooLarge(len7))
      }
    }

    let mut hdr_len = 2
    let mut payload_len = len7
    if len7 == 126 {
      if self.pending_total < 4 {
        return Ok(None)
      }
      if cur_avail >= 4 {
        payload_len = (buf[base + 2].to_int() << 8) | buf[base + 3].to_int()
      } else {
        payload_len = (self.peek_byte(2) << 8) | self.peek_byte(3)
      }
      if payload_len < 126 {
        return Err(WsError::NonMinimalLength)
      }
      hdr_len = 4
    } else if len7 == 127 {
      if self.pending_total < 10 {
        return Ok(None)
      }
      let h2 = if cur_avail >= 10 { buf[base + 2].to_int() } else { self.peek_byte(2) }
      if (h2 & 0x80) != 0 {
        return Err(
          WsError::InvalidPayloadLength("64-bit payload length MSB must be 0"),
        )
      }
      let len64 : Int64 = if cur_avail >= 10 {
        (h2.to_int64() << 56L) |
        (buf[base + 3].to_int().to_int64() << 48L) |
        (buf[base + 4].to_int().to_int64() << 40L) |
        (buf[base + 5].to_int().to_int64() << 32L) |
        (buf[base + 6].to_int().to_int64() << 24L) |
        (buf[base + 7].to_int().to_int64() << 16L) |
        (buf[base + 8].to_int().to_int64() << 8L) |
        buf[base + 9].to_int().to_int64()
      } else {
        (h2.to_int64() << 56L) |
        (self.peek_byte(3).to_int64() << 48L) |
        (self.peek_byte(4).to_int64() << 40L) |
        (self.peek_byte(5).to_int64() << 32L) |
        (self.peek_byte(6).to_int64() << 24L) |
        (self.peek_byte(7).to_int64() << 16L) |
        (self.peek_byte(8).to_int64() << 8L) |
        self.peek_byte(9).to_int64()
      }
      if len64 < 65536L {
        return Err(WsError::NonMinimalLength)
      }
      if len64 > self.max_message_size.to_int64() {
        return Err(
          WsError::MessageTooLarge(
            if len64 > 2147483647L { 2147483647 } else { len64.to_int() },
            self.max_message_size,
          ),
        )
      }
      payload_len = len64.to_int()
      hdr_len = 10
    }

    if !is_control && payload_len > self.max_message_size {
      return Err(WsError::MessageTooLarge(payload_len, self.max_message_size))
    }
    if op_raw == 0 {
      let total_frag64 = self.frag_total_len.to_int64() + payload_len.to_int64()
      if total_frag64 > self.max_message_size.to_int64() {
        return Err(
          WsError::MessageTooLarge(
            if total_frag64 > 2147483647L {
              2147483647
            } else {
              total_frag64.to_int()
            },
            self.max_message_size,
          ),
        )
      }
    }

    let mask_end = if masked { hdr_len + 4 } else { hdr_len }
    let frame_total64 : Int64 = mask_end.to_int64() + payload_len.to_int64()
    if self.pending_total.to_int64() < frame_total64 {
      return Ok(None)
    }

    let mut m0 = 0
    let mut m1 = 0
    let mut m2 = 0
    let mut m3 = 0
    if masked {
      if cur_avail >= mask_end {
        m0 = buf[base + hdr_len].to_int()
        m1 = buf[base + hdr_len + 1].to_int()
        m2 = buf[base + hdr_len + 2].to_int()
        m3 = buf[base + hdr_len + 3].to_int()
      } else {
        m0 = self.peek_byte(hdr_len)
        m1 = self.peek_byte(hdr_len + 1)
        m2 = self.peek_byte(hdr_len + 2)
        m3 = self.peek_byte(hdr_len + 3)
      }
    }

    self.skip_bytes(mask_end)

    // Fast path for final Continuation frame: unmask directly into the reassembled buffer
    // without allocating or copying an intermediate Bytes for the final fragment.
    match opcode {
      Opcode::Continuation => {
        let orig = match self.frag_opcode {
          Some(op) => op
          None => return Err(WsError::UnexpectedContinuation)
        }
        if fin {
          let total_len = self.frag_total_len + payload_len
          let full = Bytes::new(total_len)
          let mut off = 0
          let chunks = self.frag_chunks
          let nchunks = chunks.length()
          let mut ci = 0
          while ci < nchunks {
            let c = chunks[ci]
            let clen = c.length()
            copy_bytes_slice(full, off, c, 0, clen)
            off = off + clen
            ci = ci + 1
          }
          self.read_payload_into(
            full,
            off,
            payload_len,
            masked,
            m0,
            m1,
            m2,
            m3,
          )
          let utf8_st = self.frag_utf8_state
          self.frag_opcode = None
          self.frag_chunks.clear()
          self.frag_total_len = 0
          self.frag_utf8_state = 0
          match orig {
            Opcode::Text => {
              let final_st = validate_utf8_step(utf8_st, full, off, total_len)
              if final_st != 0 {
                return Err(
                  WsError::InvalidUtf8("invalid UTF-8 in fragmented text"),
                )
              }
              return Ok(Some(Message::Text(full.to_string())))
            }
            _ => return Ok(Some(Message::Binary(full)))
          }
        } else {
          let payload = Bytes::new(payload_len)
          self.read_payload_into(
            payload,
            0,
            payload_len,
            masked,
            m0,
            m1,
            m2,
            m3,
          )
          match orig {
            Opcode::Text => {
              let next_st = validate_utf8_step(
                self.frag_utf8_state,
                payload,
                0,
                payload_len,
              )
              if next_st < 0 {
                self.frag_opcode = None
                self.frag_chunks.clear()
                self.frag_total_len = 0
                self.frag_utf8_state = 0
                return Err(
                  WsError::InvalidUtf8("invalid UTF-8 in text fragment"),
                )
              }
              self.frag_utf8_state = next_st
            }
            _ => ()
          }
          self.frag_chunks.push(payload)
          self.frag_total_len = self.frag_total_len + payload_len
        }
      }
      _ => {
        let payload = Bytes::new(payload_len)
        self.read_payload_into(
          payload,
          0,
          payload_len,
          masked,
          m0,
          m1,
          m2,
          m3,
        )
        match opcode {
          Opcode::Ping => return Ok(Some(Message::Ping(payload)))
          Opcode::Pong => return Ok(Some(Message::Pong(payload)))
          Opcode::Close => {
            let plen = payload.length()
            if plen == 0 {
              self.closed = true
              return Ok(Some(Message::Close(None)))
            }
            if plen == 1 {
              return Err(
                WsError::InvalidCloseFrame("1-byte close frame is illegal"),
              )
            }
            let code = (payload[0].to_int() << 8) | payload[1].to_int()
            if !is_valid_close_code(code) {
              return Err(WsError::InvalidCloseCode(code))
            }
            if !validate_utf8_range(payload, 2, plen) {
              return Err(WsError::InvalidUtf8("invalid UTF-8 in close reason"))
            }
            let reason = if plen == 2 {
              ""
            } else {
              payload.slice(2, plen).to_string()
            }
            self.closed = true
            return Ok(Some(Message::Close(Some(CloseFrame::new(code, reason)))))
          }
          Opcode::Text => {
            match self.frag_opcode {
              Some(_) => return Err(WsError::ExpectedContinuation)
              None => ()
            }
            if fin {
              if !validate_utf8(payload) {
                return Err(WsError::InvalidUtf8("invalid UTF-8 in text frame"))
              }
              return Ok(Some(Message::Text(payload.to_string())))
            } else {
              let st = validate_utf8_step(0, payload, 0, payload_len)
              if st < 0 {
                return Err(
                  WsError::InvalidUtf8("invalid UTF-8 in text fragment"),
                )
              }
              self.frag_opcode = Some(Opcode::Text)
              self.frag_chunks.clear()
              self.frag_chunks.push(payload)
              self.frag_total_len = payload_len
              self.frag_utf8_state = st
            }
          }
          Opcode::Binary => {
            match self.frag_opcode {
              Some(_) => return Err(WsError::ExpectedContinuation)
              None => ()
            }
            if fin {
              return Ok(Some(Message::Binary(payload)))
            } else {
              self.frag_opcode = Some(Opcode::Binary)
              self.frag_chunks.clear()
              self.frag_chunks.push(payload)
              self.frag_total_len = payload_len
            }
          }
          Opcode::Continuation => ()
        }
      }
    }
  }
  Ok(None)
}
