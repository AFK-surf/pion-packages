///| RFC 6455 streaming Sans-IO WebSocket decoder with zero-copy chunk queue fast path.

///|
pub struct Decoder {
  pub role : Role
  pub max_message_size : Int
  mut cur : Bytes
  mut cur_pos : Int
  mut cur_len : Int
  mut queue : Array[Bytes]
  mut queue_head : Int
  mut pending_total : Int
  mut frag_opcode : Option[Opcode]
  mut frag_chunks : Array[Bytes]
  mut frag_total_len : Int
}

///| Create a new streaming Sans-IO WebSocket `Decoder`.
pub fn Decoder::new(role : Role, max_message_size : Int) -> Decoder {
  Decoder::{
    role: role,
    max_message_size: max_message_size,
    cur: Bytes::new(0),
    cur_pos: 0,
    cur_len: 0,
    queue: [],
    queue_head: 0,
    pending_total: 0,
    frag_opcode: None,
    frag_chunks: [],
    frag_total_len: 0,
  }
}

///| Return the number of unparsed bytes currently buffered.
pub fn Decoder::buffered_len(self : Decoder) -> Int {
  self.pending_total
}

///| Reset all buffered bytes and in-progress fragmentation state.
pub fn Decoder::reset(self : Decoder) -> Unit {
  self.cur = Bytes::new(0)
  self.cur_pos = 0
  self.cur_len = 0
  self.queue = []
  self.queue_head = 0
  self.pending_total = 0
  self.frag_opcode = None
  self.frag_chunks = []
  self.frag_total_len = 0
}

///| Feed raw network bytes into the decoder (O(1) zero-copy queue).
pub fn Decoder::feed(self : Decoder, chunk : Bytes) -> Unit {
  let clen = chunk.length()
  if clen == 0 {
    return ()
  }
  if self.pending_total == 0 {
    self.cur = chunk
    self.cur_pos = 0
    self.cur_len = clen
    self.pending_total = clen
  } else {
    self.queue.push(chunk)
    self.pending_total = self.pending_total + clen
  }
}

///|
fn copy_bytes_slice(
  dst : Bytes,
  dst_off : Int,
  src : Bytes,
  src_off : Int,
  len : Int,
) -> Unit {
  let mut i = 0
  while i + 8 <= len {
    dst[dst_off + i] = src[src_off + i]
    dst[dst_off + i + 1] = src[src_off + i + 1]
    dst[dst_off + i + 2] = src[src_off + i + 2]
    dst[dst_off + i + 3] = src[src_off + i + 3]
    dst[dst_off + i + 4] = src[src_off + i + 4]
    dst[dst_off + i + 5] = src[src_off + i + 5]
    dst[dst_off + i + 6] = src[src_off + i + 6]
    dst[dst_off + i + 7] = src[src_off + i + 7]
    i = i + 8
  }
  while i < len {
    dst[dst_off + i] = src[src_off + i]
    i = i + 1
  }
}

///| Coalesce current unread slice and queued chunks into a single contiguous buffer
///| when a frame spans across chunk boundaries.
fn Decoder::coalesce(self : Decoder) -> Unit {
  let total = self.pending_total
  let mut merged = Bytes::new(total)
  let rem = self.cur_len - self.cur_pos
  if rem > 0 {
    copy_bytes_slice(merged, 0, self.cur, self.cur_pos, rem)
  }
  let mut off = rem
  let q = self.queue
  let qlen = q.length()
  let mut qi = self.queue_head
  while qi < qlen {
    let c = q[qi]
    let clen = c.length()
    copy_bytes_slice(merged, off, c, 0, clen)
    off = off + clen
    qi = qi + 1
  }
  self.cur = merged
  self.cur_pos = 0
  self.cur_len = total
  self.queue.clear()
  self.queue_head = 0
}

///| Advance `cur` to the next queued chunk once `cur` is fully consumed.
fn Decoder::advance_chunk(self : Decoder) -> Unit {
  if self.cur_pos >= self.cur_len {
    let q = self.queue
    let qlen = q.length()
    if self.queue_head < qlen {
      let next = q[self.queue_head]
      self.queue_head = self.queue_head + 1
      if self.queue_head == qlen {
        q.clear()
        self.queue_head = 0
      }
      self.cur = next
      self.cur_pos = 0
      self.cur_len = next.length()
    } else {
      self.cur_pos = 0
      self.cur_len = 0
    }
  }
}

///|
fn extract_payload_into(
  dst : Bytes,
  dst_off : Int,
  buf : Bytes,
  start : Int,
  len : Int,
  masked : Bool,
  m0 : Int,
  m1 : Int,
  m2 : Int,
  m3 : Int,
) -> Unit {
  if len == 0 {
    return ()
  }
  if masked {
    let mut i = 0
    while i + 8 <= len {
      dst[dst_off + i] = (buf[start + i].to_int() ^ m0).to_byte()
      dst[dst_off + i + 1] = (buf[start + i + 1].to_int() ^ m1).to_byte()
      dst[dst_off + i + 2] = (buf[start + i + 2].to_int() ^ m2).to_byte()
      dst[dst_off + i + 3] = (buf[start + i + 3].to_int() ^ m3).to_byte()
      dst[dst_off + i + 4] = (buf[start + i + 4].to_int() ^ m0).to_byte()
      dst[dst_off + i + 5] = (buf[start + i + 5].to_int() ^ m1).to_byte()
      dst[dst_off + i + 6] = (buf[start + i + 6].to_int() ^ m2).to_byte()
      dst[dst_off + i + 7] = (buf[start + i + 7].to_int() ^ m3).to_byte()
      i = i + 8
    }
    if i + 4 <= len {
      dst[dst_off + i] = (buf[start + i].to_int() ^ m0).to_byte()
      dst[dst_off + i + 1] = (buf[start + i + 1].to_int() ^ m1).to_byte()
      dst[dst_off + i + 2] = (buf[start + i + 2].to_int() ^ m2).to_byte()
      dst[dst_off + i + 3] = (buf[start + i + 3].to_int() ^ m3).to_byte()
      i = i + 4
    }
    if i < len {
      dst[dst_off + i] = (buf[start + i].to_int() ^ m0).to_byte()
      i = i + 1
    }
    if i < len {
      dst[dst_off + i] = (buf[start + i].to_int() ^ m1).to_byte()
      i = i + 1
    }
    if i < len {
      dst[dst_off + i] = (buf[start + i].to_int() ^ m2).to_byte()
    }
  } else {
    copy_bytes_slice(dst, dst_off, buf, start, len)
  }
}

///|
fn extract_payload(
  buf : Bytes,
  start : Int,
  len : Int,
  masked : Bool,
  m0 : Int,
  m1 : Int,
  m2 : Int,
  m3 : Int,
) -> Bytes {
  let out = Bytes::new(len)
  extract_payload_into(out, 0, buf, start, len, masked, m0, m1, m2, m3)
  out
}

///| Attempt to decode the next complete WebSocket `Message` from buffered bytes.
///| Returns `Ok(None)` when more bytes are needed.
pub fn Decoder::next_message(self : Decoder) -> Result[Option[Message], WsError] {
  while true {
    if self.pending_total < 2 {
      return Ok(None)
    }
    let mut cur_avail = self.cur_len - self.cur_pos
    if cur_avail < 2 {
      self.coalesce()
      cur_avail = self.cur_len - self.cur_pos
    }
    let mut buf = self.cur
    let mut base = self.cur_pos
    let b0 = buf[base].to_int()
    let b1 = buf[base + 1].to_int()

    let fin = (b0 & 0x80) != 0
    let rsv = (b0 >> 4) & 0x07
    if rsv != 0 {
      return Err(WsError::NonZeroRsv(rsv))
    }
    let op_raw = b0 & 0x0F
    let opcode = match op_raw {
      0 => Opcode::Continuation
      1 => Opcode::Text
      2 => Opcode::Binary
      8 => Opcode::Close
      9 => Opcode::Ping
      10 => Opcode::Pong
      _ => return Err(WsError::InvalidOpcode(op_raw))
    }

    let masked = (b1 & 0x80) != 0
    match self.role {
      Role::Server =>
      if !masked {
        return Err(WsError::UnmaskedClientFrame)
      }
      Role::Client =>
      if masked {
        return Err(WsError::MaskedServerFrame)
      }
    }

    let is_control = op_raw >= 8
    let len7 = b1 & 0x7F
    if is_control {
      if !fin {
        return Err(WsError::FragmentedControlFrame)
      }
      if len7 > 125 {
        return Err(WsError::ControlFrameTooLarge(len7))
      }
    }

    let mut hdr_len = 2
    let mut payload_len = len7
    if len7 == 126 {
      if self.pending_total < 4 {
        return Ok(None)
      }
      if cur_avail < 4 {
        self.coalesce()
        buf = self.cur
        base = self.cur_pos
        cur_avail = self.cur_len - base
      }
      payload_len = (buf[base + 2].to_int() << 8) | buf[base + 3].to_int()
      if payload_len < 126 {
        return Err(WsError::NonMinimalLength)
      }
      hdr_len = 4
    } else if len7 == 127 {
      if self.pending_total < 10 {
        return Ok(None)
      }
      if cur_avail < 10 {
        self.coalesce()
        buf = self.cur
        base = self.cur_pos
        cur_avail = self.cur_len - base
      }
      let hi_byte = buf[base + 2].to_int()
      if (hi_byte & 0x80) != 0 {
        return Err(
          WsError::InvalidPayloadLength("64-bit payload length MSB must be 0"),
        )
      }
      let len64 : Int64 = (buf[base + 2].to_int().to_int64() << 56L) |
      (buf[base + 3].to_int().to_int64() << 48L) |
      (buf[base + 4].to_int().to_int64() << 40L) |
      (buf[base + 5].to_int().to_int64() << 32L) |
      (buf[base + 6].to_int().to_int64() << 24L) |
      (buf[base + 7].to_int().to_int64() << 16L) |
      (buf[base + 8].to_int().to_int64() << 8L) |
      buf[base + 9].to_int().to_int64()
      if len64 < 65536L {
        return Err(WsError::NonMinimalLength)
      }
      if len64 > self.max_message_size.to_int64() {
        return Err(
          WsError::MessageTooLarge(
            if len64 > 2147483647L { 2147483647 } else { len64.to_int() },
            self.max_message_size,
          ),
        )
      }
      payload_len = len64.to_int()
      hdr_len = 10
    }

    if !is_control && payload_len > self.max_message_size {
      return Err(WsError::MessageTooLarge(payload_len, self.max_message_size))
    }
    if op_raw == 0 && self.frag_total_len + payload_len > self.max_message_size {
      return Err(
        WsError::MessageTooLarge(
          self.frag_total_len + payload_len,
          self.max_message_size,
        ),
      )
    }

    let mask_end = if masked { hdr_len + 4 } else { hdr_len }
    let frame_total = mask_end + payload_len
    if self.pending_total < frame_total {
      return Ok(None)
    }
    if cur_avail < frame_total {
      self.coalesce()
      buf = self.cur
      base = self.cur_pos
    }

    let mut m0 = 0
    let mut m1 = 0
    let mut m2 = 0
    let mut m3 = 0
    if masked {
      m0 = buf[base + hdr_len].to_int()
      m1 = buf[base + hdr_len + 1].to_int()
      m2 = buf[base + hdr_len + 2].to_int()
      m3 = buf[base + hdr_len + 3].to_int()
      hdr_len = mask_end
    }

    let payload_start = base + hdr_len
    self.cur_pos = base + frame_total
    self.pending_total = self.pending_total - frame_total
    self.advance_chunk()

    // Fast path for final Continuation frame: unmask directly into the reassembled buffer
    // without allocating or copying an intermediate Bytes for the final fragment.
    match opcode {
      Opcode::Continuation => {
        let orig = match self.frag_opcode {
          Some(op) => op
          None => return Err(WsError::UnexpectedContinuation)
        }
        if fin {
          let total_len = self.frag_total_len + payload_len
          let full = Bytes::new(total_len)
          let mut off = 0
          let chunks = self.frag_chunks
          let nchunks = chunks.length()
          let mut ci = 0
          while ci < nchunks {
            let c = chunks[ci]
            let clen = c.length()
            copy_bytes_slice(full, off, c, 0, clen)
            off = off + clen
            ci = ci + 1
          }
          extract_payload_into(
            full,
            off,
            buf,
            payload_start,
            payload_len,
            masked,
            m0,
            m1,
            m2,
            m3,
          )
          self.frag_opcode = None
          self.frag_chunks.clear()
          self.frag_total_len = 0
          match orig {
            Opcode::Text => {
              if !validate_utf8(full) {
                return Err(
                  WsError::InvalidUtf8("invalid UTF-8 in fragmented text"),
                )
              }
              return Ok(Some(Message::Text(full.to_string())))
            }
            _ => return Ok(Some(Message::Binary(full)))
          }
        } else {
          let payload = extract_payload(
            buf,
            payload_start,
            payload_len,
            masked,
            m0,
            m1,
            m2,
            m3,
          )
          self.frag_chunks.push(payload)
          self.frag_total_len = self.frag_total_len + payload_len
        }
      }
      _ => {
        let payload = extract_payload(
          buf,
          payload_start,
          payload_len,
          masked,
          m0,
          m1,
          m2,
          m3,
        )
        match opcode {
          Opcode::Ping => return Ok(Some(Message::Ping(payload)))
          Opcode::Pong => return Ok(Some(Message::Pong(payload)))
          Opcode::Close => {
            let plen = payload.length()
            if plen == 0 {
              return Ok(Some(Message::Close(None)))
            }
            if plen == 1 {
              return Err(
                WsError::InvalidCloseFrame("1-byte close frame is illegal"),
              )
            }
            let code = (payload[0].to_int() << 8) | payload[1].to_int()
            if !is_valid_close_code(code) {
              return Err(WsError::InvalidCloseCode(code))
            }
            if !validate_utf8_range(payload, 2, plen) {
              return Err(WsError::InvalidUtf8("invalid UTF-8 in close reason"))
            }
            let reason = if plen == 2 {
              ""
            } else {
              payload.slice(2, plen).to_string()
            }
            return Ok(Some(Message::Close(Some(CloseFrame::new(code, reason)))))
          }
          Opcode::Text => {
            match self.frag_opcode {
              Some(_) => return Err(WsError::ExpectedContinuation)
              None => ()
            }
            if fin {
              if !validate_utf8(payload) {
                return Err(WsError::InvalidUtf8("invalid UTF-8 in text frame"))
              }
              return Ok(Some(Message::Text(payload.to_string())))
            } else {
              self.frag_opcode = Some(Opcode::Text)
              self.frag_chunks.clear()
              self.frag_chunks.push(payload)
              self.frag_total_len = payload_len
            }
          }
          Opcode::Binary => {
            match self.frag_opcode {
              Some(_) => return Err(WsError::ExpectedContinuation)
              None => ()
            }
            if fin {
              return Ok(Some(Message::Binary(payload)))
            } else {
              self.frag_opcode = Some(Opcode::Binary)
              self.frag_chunks.clear()
              self.frag_chunks.push(payload)
              self.frag_total_len = payload_len
            }
          }
          Opcode::Continuation => ()
        }
      }
    }
  }
  Ok(None)
}
