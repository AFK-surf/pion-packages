///| Atom 1.0 (RFC 4287) compliance tests: text/html/xhtml constructs, xml:base resolution,
///| links, authors/contributors, categories, timestamps, and prefixed namespaces.

///|
fn atom_assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn atom_assert_opt_str(
  got : Option[String],
  expected : String,
  label : String,
) -> Unit {
  match got {
    Some(s) => atom_assert_str(s, expected, label)
    None => debug_assert(false, label + ": expected Some(\"" + expected + "\"), got None")
  }
}

///|
test "atom10_rfc4287_full_and_xhtml_subtree" {
  let atom_src = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" +
  "<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:base=\"https://example.org/blog/\" xml:lang=\"en\">\n" +
  "  <id>urn:uuid:60a76c80-d399-11d9-b93C-0003939e0af6</id>\n" +
  "  <title type=\"text\">Example Feed</title>\n" +
  "  <subtitle type=\"html\">A &lt;em&gt;great&lt;/em&gt; subtitle</subtitle>\n" +
  "  <updated>2026-11-23T18:30:02Z</updated>\n" +
  "  <rights>Copyright (c) 2026 Example Org</rights>\n" +
  "  <icon>favicon.ico</icon>\n" +
  "  <logo>/assets/logo.svg</logo>\n" +
  "  <generator uri=\"https://pion.dev/\" version=\"0.1.0\">PionFeed</generator>\n" +
  "  <link rel=\"self\" type=\"application/atom+xml\" href=\"feed.atom\"/>\n" +
  "  <link rel=\"alternate\" type=\"text/html\" hreflang=\"en\" title=\"Home\" href=\"index.html\"/>\n" +
  "  <author>\n" +
  "    <name>John Doe</name>\n" +
  "    <email>john@example.org</email>\n" +
  "    <uri>https://example.org/~john</uri>\n" +
  "  </author>\n" +
  "  <contributor>\n" +
  "    <name>Jane Contributor</name>\n" +
  "  </contributor>\n" +
  "  <category term=\"engineering\" scheme=\"https://example.org/ns\" label=\"Engineering\"/>\n" +
  "  <entry xml:base=\"2026/11/\">\n" +
  "    <id>urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a</id>\n" +
  "    <title>Atom-Powered Robots Run Amok</title>\n" +
  "    <link rel=\"alternate\" href=\"robots.html\" length=\"2048\"/>\n" +
  "    <link rel=\"enclosure\" type=\"application/pdf\" href=\"../docs/robots.pdf\" length=\"65536\"/>\n" +
  "    <published>2026-11-22T09:00:00+02:00</published>\n" +
  "    <updated>2026-11-23T18:30:02Z</updated>\n" +
  "    <summary type=\"text\">Some summary text.</summary>\n" +
  "    <content type=\"xhtml\">\n" +
  "      <div xmlns=\"http://www.w3.org/1999/xhtml\">\n" +
  "        <p>Hello <em>XHTML</em> &amp; <a href=\"https://example.org\">links</a><br/></p>\n" +
  "      </div>\n" +
  "    </content>\n" +
  "    <category term=\"robotics\" label=\"Robotics\"/>\n" +
  "  </entry>\n" +
  "  <entry>\n" +
  "    <id>urn:uuid:2225c695-cfb8-4ebb-aaaa-80da344efa6b</id>\n" +
  "    <title>Out-of-line Content</title>\n" +
  "    <updated>2026-11-23T19:00:00Z</updated>\n" +
  "    <content type=\"application/pdf\" src=\"papers/spec.pdf\"/>\n" +
  "  </entry>\n" +
  "</feed>"

  let feed = match parse(atom_src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "atom parse failed: " + e.message)
      return ()
    }
  }

  debug_assert(feed.format.eq(FeedFormat::Atom), "format should be Atom")
  atom_assert_str(feed.id, "urn:uuid:60a76c80-d399-11d9-b93C-0003939e0af6", "feed id")
  atom_assert_opt_str(feed.language, "en", "xml:lang")
  atom_assert_opt_str(feed.base_url, "https://example.org/blog/", "xml:base")

  match feed.title {
    Some(t) => {
      debug_assert(t.content_type.eq(TextType::Text), "title type text")
      atom_assert_str(t.value, "Example Feed", "feed title")
    }
    None => debug_assert(false, "feed title missing")
  }
  match feed.subtitle {
    Some(s) => {
      debug_assert(s.content_type.eq(TextType::Html), "subtitle type html")
      atom_assert_str(s.value, "A <em>great</em> subtitle", "feed subtitle")
    }
    None => debug_assert(false, "feed subtitle missing")
  }
  match feed.icon {
    Some(ic) => atom_assert_str(ic.uri, "https://example.org/blog/favicon.ico", "icon resolved with xml:base")
    None => debug_assert(false, "icon missing")
  }
  match feed.logo {
    Some(lg) => atom_assert_str(lg.uri, "https://example.org/assets/logo.svg", "logo resolved with xml:base")
    None => debug_assert(false, "logo missing")
  }
  match feed.generator {
    Some(g) => {
      atom_assert_str(g.content, "PionFeed", "generator content")
      atom_assert_opt_str(g.uri, "https://pion.dev/", "generator uri")
      atom_assert_opt_str(g.version, "0.1.0", "generator version")
    }
    None => debug_assert(false, "generator missing")
  }

  debug_assert(feed.links.length() == 2, "feed links count")
  atom_assert_str(feed.links[0].href, "https://example.org/blog/feed.atom", "self link resolved")
  atom_assert_opt_str(feed.links[0].rel, "self", "self link rel")
  atom_assert_str(feed.links[1].href, "https://example.org/blog/index.html", "alt link resolved")
  atom_assert_opt_str(feed.links[1].href_lang, "en", "alt link hreflang")
  atom_assert_opt_str(feed.links[1].title, "Home", "alt link title")

  debug_assert(feed.authors.length() == 1, "feed author")
  atom_assert_str(feed.authors[0].name, "John Doe", "author name")
  atom_assert_opt_str(feed.authors[0].email, "john@example.org", "author email")
  atom_assert_opt_str(feed.authors[0].uri, "https://example.org/~john", "author uri")
  debug_assert(feed.contributors.length() == 1, "feed contributor")
  atom_assert_str(feed.contributors[0].name, "Jane Contributor", "contributor name")

  debug_assert(feed.categories.length() == 1, "feed category")
  atom_assert_str(feed.categories[0].term, "engineering", "category term")
  atom_assert_opt_str(feed.categories[0].scheme, "https://example.org/ns", "category scheme")
  atom_assert_opt_str(feed.categories[0].label, "Engineering", "category label")

  debug_assert(feed.entries.length() == 2, "entry count")
  let e1 = feed.entries[0]
  atom_assert_str(e1.links[0].href, "https://example.org/blog/2026/11/robots.html", "nested xml:base resolution")
  match e1.links[0].length {
    Some(n) => debug_assert(n == 2048L, "link length")
    None => debug_assert(false, "link length missing")
  }
  atom_assert_str(e1.links[1].href, "https://example.org/blog/2026/docs/robots.pdf", "dot-dot xml:base resolution")
  match e1.links[1].length {
    Some(n) => debug_assert(n == 65536L, "enclosure link length")
    None => debug_assert(false, "enclosure link length missing")
  }

  // XHTML subtree preservation
  match e1.content {
    Some(c) => {
      debug_assert(c.content_type.eq(TextType::Xhtml), "content type xhtml")
      debug_assert(c.value.contains("<p>Hello <em>XHTML</em> &amp; <a href=\"https://example.org\">links</a>"), "xhtml markup preserved: got " + c.value)
      debug_assert(c.value.contains("<br/>") || c.value.contains("<br />"), "xhtml empty tag preserved")
    }
    None => debug_assert(false, "e1 xhtml content missing")
  }

  // Entry 2 out-of-line content src resolved against feed xml:base
  let e2 = feed.entries[1]
  match e2.content {
    Some(c) => atom_assert_opt_str(c.src, "https://example.org/blog/papers/spec.pdf", "content src resolved")
    None => debug_assert(false, "e2 content missing")
  }
}

///|
test "atom10_prefixed_namespace_and_xml_base_edge_cases" {
  let prefixed = "<atom:feed xmlns:atom=\"http://www.w3.org/2005/Atom\">\n" +
  "  <atom:id>tag:example.com,2026:feed</atom:id>\n" +
  "  <atom:title>Prefixed Atom</atom:title>\n" +
  "  <atom:updated>2026-11-23T00:00:00Z</atom:updated>\n" +
  "  <atom:entry>\n" +
  "    <atom:id>tag:example.com,2026:1</atom:id>\n" +
  "    <atom:title>Prefixed Entry</atom:title>\n" +
  "    <atom:updated>2026-11-23T00:00:00Z</atom:updated>\n" +
  "    <atom:link href=\"https://example.com/1\"/>\n" +
  "  </atom:entry>\n" +
  "</atom:feed>"
  let feed = match parse(prefixed) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "prefixed atom parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(feed.format.eq(FeedFormat::Atom), "prefixed atom format")
  debug_assert(feed.entries.length() == 1, "prefixed atom entry count")

  // RFC 3986 resolve_url checks
  atom_assert_str(resolve_url("https://a.com/b/c/d", "e.html"), "https://a.com/b/c/e.html", "relative file")
  atom_assert_str(resolve_url("https://a.com/b/c/d", "../e.html"), "https://a.com/b/e.html", "parent dir")
  atom_assert_str(resolve_url("https://a.com/b/c/", "/root.png"), "https://a.com/root.png", "root-relative")
  atom_assert_str(resolve_url("https://a.com/b/c/", "//cdn.a.com/x.js"), "https://cdn.a.com/x.js", "scheme-relative")
  atom_assert_str(resolve_url("https://a.com/b/c/", "https://other.org/y"), "https://other.org/y", "absolute unchanged")
}
