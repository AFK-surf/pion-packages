///| Red-team differential / serialization / DoS probe for packages/feed.
/// usage:
///   feed_audit_probe batch <requests.tsv>   one block per request line `<id>\t<op>\t<hex utf-8 input>`:
///       op P  -> parse, canonical dump (see `dump`)
///       op R2 / RA / RJ -> parse, then to_rss2 / to_atom / to_json_feed: `ser\t<hex output>` or `ser_err\t<kind>`
///     every block starts with `@@ <id>` and ends with `@@ end`.
///   feed_audit_probe stat <file>             parse with default limits, print a one-line summary (DoS runs)
///   feed_audit_probe bench <file> <iters>    in-process parse loop for the benchmark-fairness step

import "feed"
import "time"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (nib(s.code_unit_at(2 * i)) * 16 + nib(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(s : String) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::with_capacity(s.length() * 2)
  let mut i = 0
  while i < s.length() {
    let v = s.code_unit_at(i)
    sb.write_byte(d.code_unit_at(v >> 4).to_byte())
    sb.write_byte(d.code_unit_at(v & 15).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Escape a value onto one line: `\\`, `\n`, `\r`, `\t`, other bytes < 0x20 and 0x7F as `\xHH`.
fn esc(s : String) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 92 {
      sb.write_string("\\\\")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c < 32 || c == 127 {
      sb.write_string("\\x")
      sb.write_byte(d.code_unit_at(c >> 4).to_byte())
      sb.write_byte(d.code_unit_at(c & 15).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn opt(o : Option[String]) -> String {
  match o {
    Some(s) => esc(s)
    None => "-"
  }
}

///|
fn opt_i64(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
fn ts(o : Option[time::Timestamp]) -> String {
  match o {
    Some(t) => t.as_second().to_string()
    None => "-"
  }
}

///|
fn kind_name(k : feed::FeedErrorKind) -> String {
  match k {
    feed::FeedErrorKind::EmptyInput => "EmptyInput"
    feed::FeedErrorKind::UnknownFormat => "UnknownFormat"
    feed::FeedErrorKind::XmlError => "XmlError"
    feed::FeedErrorKind::JsonError => "JsonError"
    feed::FeedErrorKind::InvalidStructure => "InvalidStructure"
    feed::FeedErrorKind::InvalidDate => "InvalidDate"
    feed::FeedErrorKind::LimitExceeded => "LimitExceeded"
    feed::FeedErrorKind::SerializationError => "SerializationError"
    feed::FeedErrorKind::Unimplemented => "Unimplemented"
    _ => "Other"
  }
}

///|
fn put(sb : StringBuilder, k : String, v : String) -> Unit {
  sb.write_string(k)
  sb.write_byte(b'\t')
  sb.write_string(v)
  sb.write_byte(b'\n')
}

///|
fn put_text(sb : StringBuilder, k : String, t : Option[feed::TextContent]) -> Unit {
  match t {
    Some(tc) => {
      put(sb, k, esc(tc.value))
      put(sb, k + ".t", tc.content_type.to_string())
      match tc.src {
        Some(s) => put(sb, k + ".src", esc(s))
        None => ()
      }
    }
    None => put(sb, k, "-")
  }
}

///|
fn put_links(sb : StringBuilder, k : String, links : Array[feed::Link]) -> Unit {
  put(sb, k + ".n", links.length().to_string())
  let mut i = 0
  while i < links.length() {
    let l = links[i]
    put(sb, k + "." + i.to_string(), esc(l.href) + "|" + opt(l.rel) + "|" + opt(l.media_type) + "|" + opt_i64(l.length))
    i = i + 1
  }
}

///|
fn put_people(sb : StringBuilder, k : String, ps : Array[feed::Person]) -> Unit {
  put(sb, k + ".n", ps.length().to_string())
  let mut i = 0
  while i < ps.length() {
    let p = ps[i]
    put(sb, k + "." + i.to_string(), esc(p.name) + "|" + opt(p.email) + "|" + opt(p.uri))
    i = i + 1
  }
}

///|
fn put_cats(sb : StringBuilder, k : String, cs : Array[feed::Category]) -> Unit {
  put(sb, k + ".n", cs.length().to_string())
  let mut i = 0
  while i < cs.length() {
    let c = cs[i]
    put(sb, k + "." + i.to_string(), esc(c.term) + "|" + opt(c.scheme) + "|" + opt(c.label))
    i = i + 1
  }
}

///|
fn dump(sb : StringBuilder, f : feed::Feed) -> Unit {
  put(sb, "fmt", f.format.to_string())
  put(sb, "feed.id", esc(f.id))
  put_text(sb, "feed.title", f.title)
  put_text(sb, "feed.desc", f.description)
  put_text(sb, "feed.rights", f.rights)
  put_links(sb, "feed.link", f.links)
  put_people(sb, "feed.author", f.authors)
  put_people(sb, "feed.contrib", f.contributors)
  put_cats(sb, "feed.cat", f.categories)
  put(sb, "feed.logo", match f.logo { Some(i) => esc(i.uri); None => "-" })
  put(sb, "feed.icon", match f.icon { Some(i) => esc(i.uri); None => "-" })
  put(sb, "feed.lang", opt(f.language))
  put(sb, "feed.updated", ts(f.updated))
  put(sb, "feed.published", ts(f.published))
  put(sb, "feed.gen", match f.generator { Some(g) => esc(g.content); None => "-" })
  put(sb, "feed.ttl", match f.ttl { Some(t) => t.to_string(); None => "-" })
  put(sb, "n", f.entries.length().to_string())
  let mut i = 0
  while i < f.entries.length() {
    let e = f.entries[i]
    let p = "e" + i.to_string()
    put(sb, p + ".id", esc(e.id))
    put(sb, p + ".permalink", match e.id_is_permalink { Some(true) => "true"; Some(false) => "false"; None => "-" })
    put_text(sb, p + ".title", e.title)
    put_text(sb, p + ".summary", e.summary)
    put_text(sb, p + ".content", e.content)
    put_text(sb, p + ".rights", e.rights)
    put(sb, p + ".published", ts(e.published))
    put(sb, p + ".updated", ts(e.updated))
    put_links(sb, p + ".link", e.links)
    put_people(sb, p + ".author", e.authors)
    put_cats(sb, p + ".cat", e.categories)
    put(sb, p + ".comments", opt(e.comments_url))
    put(sb, p + ".source", opt(e.source))
    put(sb, p + ".media.n", e.media.length().to_string())
    put(sb, p + ".itunes.duration", match e.itunes { Some(m) => opt_i64(m.duration); None => "-" })
    i = i + 1
  }
}

///|
fn run_one(sb : StringBuilder, op : String, input : String) -> Unit {
  match feed::parse(input) {
    Err(e) => put(sb, "err", kind_name(e.kind))
    Ok(f) => {
      if op == "P" {
        dump(sb, f)
      } else {
        let r = if op == "R2" {
          feed::to_rss2(f)
        } else if op == "RA" {
          feed::to_atom(f)
        } else {
          feed::to_json_feed(f)
        }
        match r {
          Ok(s) => put(sb, "ser", tohex(s))
          Err(e) => put(sb, "ser_err", kind_name(e.kind))
        }
      }
    }
  }
}

///| One-line summary of a parse result (used by the DoS / limits runs).
pub fn summary(r : Result[feed::Feed, feed::FeedError]) -> String {
  match r {
    Err(e) => "err " + kind_name(e.kind)
    Ok(f) => {
      let mut links = 0
      let mut cats = 0
      let mut authors = 0
      let mut clen = 0
      let mut i = 0
      while i < f.entries.length() {
        let e = f.entries[i]
        links = links + e.links.length()
        cats = cats + e.categories.length()
        authors = authors + e.authors.length()
        match e.content {
          Some(c) => clen = clen + c.value.length()
          None => ()
        }
        i = i + 1
      }
      let tlen = match f.title {
        Some(t) => t.value.length()
        None => 0
      }
      "ok entries=" + f.entries.length().to_string() + " feed_links=" + f.links.length().to_string() +
      " links=" + links.to_string() + " cats=" + cats.to_string() + " authors=" + authors.to_string() +
      " content_bytes=" + clen.to_string() + " title_bytes=" + tlen.to_string()
    }
  }
}

///|
fn tab_at(s : String, from : Int) -> Int {
  let mut i = from
  while i < s.length() {
    if s.code_unit_at(i) == 9 {
      return i
    }
    i = i + 1
  }
  s.length()
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///| In-process benchmark loop (no process start-up / file read in the timed region of interest):
/// parse `iters` times and print a deterministic digest that the Rust oracle reproduces byte for byte.
fn bench(world : World, path : String, iters : Int) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => return 2
  }
  let mut entries = 0
  let mut tbytes = 0
  let mut k = 0
  while k < iters {
    match feed::parse(raw) {
      Ok(f) => {
        entries = entries + f.entries.length()
        let mut i = 0
        while i < f.entries.length() {
          match f.entries[i].title {
            Some(t) => tbytes = tbytes + t.value.length()
            None => ()
          }
          i = i + 1
        }
      }
      Err(e) => {
        io_println(world, "parse error " + kind_name(e.kind))
        return 3
      }
    }
    k = k + 1
  }
  io_println(world, "iters=" + iters.to_string() + " entries=" + entries.to_string() + " title_bytes=" + tbytes.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 3 && args[1] == "stat" {
    return match fs_read_bytes(world, args[2]) {
      Ok(b) => {
        io_println(world, summary(feed::parse(b.to_string())))
        0
      }
      Err(_) => 2
    }
  }
  if args.length() >= 4 && args[1] == "bench" {
    return bench(world, args[2], parse_int(args[3]))
  }
  if args.length() < 3 || args[1] != "batch" {
    io_eprintln(world, "usage: feed_audit_probe batch <requests.tsv> | stat <file> | bench <file> <iters>")
    return 2
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_eprintln(world, "cannot read input")
      return 2
    }
  }
  let sb = StringBuilder::new()
  let mut start = 0
  let n = data.length()
  let mut i = 0
  while i <= n {
    if i == n || data.code_unit_at(i) == 10 {
      if i > start {
        let line = data.slice(start, i)
        let t1 = tab_at(line, 0)
        let t2 = tab_at(line, t1 + 1)
        let id = line.slice(0, t1)
        let op = line.slice(t1 + 1, t2)
        let input = unhex(line.slice(t2 + 1, line.length())).to_string()
        sb.write_string("@@ " + id + "\n")
        run_one(sb, op, input)
        sb.write_string("@@ end\n")
      }
      start = i + 1
    }
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}
