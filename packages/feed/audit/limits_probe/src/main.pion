///| Limits probe for packages/feed: parses a file with explicit `FeedLimits`.
/// usage: feed_audit_limits_probe <lifted|zero|negative|default> <file>
/// Kept apart from audit/probe because it is the only audit code that builds a `FeedLimits` literal:
/// if a fix adds a field to `FeedLimits`, run_audit.sh reports this step as SKIPPED instead of failing.

import "feed"

///|
fn kind_name(k : feed::FeedErrorKind) -> String {
  match k {
    feed::FeedErrorKind::EmptyInput => "EmptyInput"
    feed::FeedErrorKind::UnknownFormat => "UnknownFormat"
    feed::FeedErrorKind::XmlError => "XmlError"
    feed::FeedErrorKind::JsonError => "JsonError"
    feed::FeedErrorKind::InvalidStructure => "InvalidStructure"
    feed::FeedErrorKind::InvalidDate => "InvalidDate"
    feed::FeedErrorKind::LimitExceeded => "LimitExceeded"
    feed::FeedErrorKind::SerializationError => "SerializationError"
    _ => "Other"
  }
}

///|
fn limits(which : String) -> feed::FeedLimits {
  if which == "lifted" {
    feed::FeedLimits::{
      max_bytes: 2147483647,
      max_entries: 2147483647,
      max_depth: 2147483647,
      max_links_per_entry: 2147483647,
      max_text_bytes: 2147483647,
    }
  } else if which == "zero" {
    feed::FeedLimits::{ max_bytes: 0, max_entries: 0, max_depth: 0, max_links_per_entry: 0, max_text_bytes: 0 }
  } else if which == "negative" {
    feed::FeedLimits::{
      max_bytes: -1,
      max_entries: -1,
      max_depth: -1,
      max_links_per_entry: -1,
      max_text_bytes: -1,
    }
  } else {
    feed::FeedLimits::default()
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: feed_audit_limits_probe <lifted|zero|negative|default> <file>")
    return 2
  }
  let raw = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => return 2
  }
  let line = match feed::parse_with_limits(raw, limits(args[1])) {
    Err(e) => "err " + kind_name(e.kind)
    Ok(f) => {
      let mut links = 0
      let mut cats = 0
      let mut authors = 0
      let mut clen = 0
      let mut i = 0
      while i < f.entries.length() {
        let e = f.entries[i]
        links = links + e.links.length()
        cats = cats + e.categories.length()
        authors = authors + e.authors.length()
        match e.content {
          Some(c) => clen = clen + c.value.length()
          None => ()
        }
        i = i + 1
      }
      "ok entries=" + f.entries.length().to_string() + " feed_links=" + f.links.length().to_string() +
      " links=" + links.to_string() + " cats=" + cats.to_string() + " authors=" + authors.to_string() +
      " content_bytes=" + clen.to_string()
    }
  }
  io_println(world, line)
  0
}
