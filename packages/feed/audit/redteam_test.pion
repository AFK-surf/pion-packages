///| Red-team regression tests for packages/feed v0.1.0 @ 5c5b6fd (branch feat/pkg-feed).
///
/// Every `p1_` / `p2_` test asserts behaviour required by the cited specification (RFC 4287 Atom 1.0,
/// RSS 2.0 / RSS Advisory Board profile, JSON Feed 1.1, RFC 3986, RFC 3339, XML 1.0 / Namespaces 1.0).
/// Where Rust `feed-rs =2.4.0` agrees, the comment says so. A FAILURE of a `p*_` test is the evidence for
/// the finding of the same id in REPORT.md. `control_` tests are attacks the package survived; they must
/// keep passing.
///
/// Only the public API is used (parse / detect_format / parse_feed_date / resolve_url / to_* and field
/// reads), never struct literals of `feed` types (not even FeedLimits), so a fix that adds fields or
/// variants does not need to touch this file. Lifted-limit DoS and zero/negative limits live in
/// audit/limits_probe, which run_audit.sh builds separately.

import "feed"
import "xml"

///|
fn must(src : String) -> feed::Feed {
  match feed::parse(src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      panic()
    }
  }
}

///|
fn txt(t : Option[feed::TextContent]) -> String {
  match t {
    Some(v) => v.value
    None => "<None>"
  }
}

///|
fn ttype(t : Option[feed::TextContent]) -> String {
  match t {
    Some(v) => v.content_type.to_string()
    None => "<None>"
  }
}

///|
fn eq(got : String, want : String, label : String) -> Unit {
  debug_assert(got == want, label + ": want \"" + want + "\", got \"" + got + "\"")
}

///|
fn opt_s(o : Option[String]) -> String {
  match o {
    Some(s) => s
    None => "<None>"
  }
}

///|
fn opt_l(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "<None>"
  }
}

///|
fn date_s(s : String) -> String {
  match feed::parse_feed_date(s) {
    Ok(t) => t.as_second().to_string()
    Err(_) => "<Err>"
  }
}

///|
fn ok_s(r : Result[String, feed::FeedError]) -> String {
  match r {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "serialize failed: " + e.message)
      ""
    }
  }
}

///| Text between the first `<tag` (followed by ' ', '>' or '/') and the next '>' (inclusive).
fn start_tag(doc : String, tag : String) -> String {
  let open = "<" + tag
  let n = doc.length()
  let mut i = 0
  while i + open.length() < n {
    if doc.slice(i, i + open.length()) == open {
      let c = doc.code_unit_at(i + open.length())
      if c == 32 || c == 62 || c == 47 {
        let mut j = i
        while j < n && doc.code_unit_at(j) != 62 {
          j = j + 1
        }
        return doc.slice(i, if j < n { j + 1 } else { n })
      }
    }
    i = i + 1
  }
  ""
}

///|
fn contains(h : String, needle : String) -> Bool {
  h.contains(needle)
}

// ---------------------------------------------------------------------------------------------------
// P1-1  Namespace-blind element dispatch: foreign-namespace children clobber core fields.
// RSS 2.0 core elements live in no namespace (RSS 1.0 in http://purl.org/rss/1.0/), Atom elements in
// http://www.w3.org/2005/Atom (XML Namespaces 1.0 §1: names are {URI, local}). feed-rs dispatches on
// (namespace, local) and is unaffected in all four cases.
// ---------------------------------------------------------------------------------------------------

///| WordPress emits `<comments>URL</comments>` and then `<slash:comments>12</slash:comments>` in every item.
test "p1_rss_slash_comments_clobbers_comments_url" {
  let f = must(
    "<rss version=\"2.0\" xmlns:slash=\"http://purl.org/rss/1.0/modules/slash/\"><channel><title>t</title>" +
    "<item><guid>g</guid><comments>https://ex.com/p/1#comments</comments><slash:comments>12</slash:comments></item>" +
    "</channel></rss>",
  )
  eq(opt_s(f.entries[0].comments_url), "https://ex.com/p/1#comments", "item comments")
}

///| Google Play podcast feeds put `<googleplay:image href=...>` next to the RSS `<image>`.
test "p1_rss_foreign_image_erases_channel_logo" {
  let f = must(
    "<rss version=\"2.0\" xmlns:googleplay=\"http://www.google.com/schemas/play-podcasts/1.0\"><channel><title>t</title>" +
    "<image><url>https://ex.com/logo.png</url><title>t</title><link>https://ex.com/</link></image>" +
    "<googleplay:image href=\"https://ex.com/gp.png\"/></channel></rss>",
  )
  let logo = match f.logo {
    Some(i) => i.uri
    None => "<None>"
  }
  eq(logo, "https://ex.com/logo.png", "channel logo")
}

///| Media RSS allows media:title / media:description at channel level; they must not replace the RSS title.
test "p1_rss_channel_media_title_overrides_title" {
  let f = must(
    "<rss version=\"2.0\" xmlns:media=\"http://search.yahoo.com/mrss/\"><channel><title>Real</title>" +
    "<media:title>Fake</media:title><description>D</description><media:description>FakeD</media:description></channel></rss>",
  )
  eq(txt(f.title), "Real", "channel title")
  eq(txt(f.description), "D", "channel description")
}

///| Any extension element whose local name is id/title/rights/... overwrites the Atom value.
test "p1_atom_foreign_namespace_children_override_core" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\" xmlns:x=\"urn:x\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">" +
    "<id>urn:feed</id><x:id>evil-feed</x:id><title>T</title><dc:title>DC</dc:title>" +
    "<entry><id>urn:e</id><x:id>evil</x:id><title>E</title><dc:title>DC</dc:title><dc:rights>R2</dc:rights>" +
    "<author><name>Alice</name><x:name>Mallory</x:name></author></entry></feed>",
  )
  eq(f.id, "urn:feed", "feed id")
  eq(txt(f.title), "T", "feed title")
  eq(f.entries[0].id, "urn:e", "entry id")
  eq(txt(f.entries[0].title), "E", "entry title")
  eq(txt(f.entries[0].rights), "<None>", "entry rights")
  eq(f.entries[0].authors[0].name, "Alice", "author name")
}

// ---------------------------------------------------------------------------------------------------
// P1-2  Any <!DOCTYPE> is a hard XmlError (lib.pion allow_dtd: false); every Netscape RSS 0.91 feed carries
// one. XML 1.0 §2.8 makes the doctypedecl optional-but-legal; feed-rs parses both documents.
// ---------------------------------------------------------------------------------------------------

///|
test "p1_doctype_rss091_rejected" {
  let src = "<?xml version=\"1.0\"?>\n" +
  "<!DOCTYPE rss PUBLIC \"-//Netscape Communications//DTD RSS 0.91//EN\" \"http://my.netscape.com/publish/formats/rss-0.91.dtd\">\n" +
  "<rss version=\"0.91\"><channel><title>T</title><item><title>I</title><link>http://x/1</link></item></channel></rss>"
  let ok = match feed::detect_format(src) {
    Ok(fmt) => fmt.to_string()
    Err(e) => "Err " + e.message
  }
  eq(ok, "rss2", "detect_format")
  match feed::parse(src) {
    Ok(f) => {
      eq(txt(f.title), "T", "title")
      eq(f.entries.length().to_string(), "1", "entries")
    }
    Err(e) => debug_assert(false, "parse rejected a DOCTYPE without internal subset: " + e.message)
  }
}

// ---------------------------------------------------------------------------------------------------
// P1-3  RSS item <description> is entity-encoded HTML (RSS 2.0 spec "An item may also be
// complete in itself ... the description ... may contain entity-encoded HTML"; RSS profile §description).
// Pion types it TextType::Text, so to_atom emits `type="text"` and readers show literal tags.
// feed-rs types it text/html.
// ---------------------------------------------------------------------------------------------------

///|
test "p1_rss_description_typed_plain_text" {
  let f = must(
    "<rss version=\"2.0\"><channel><title>t</title><description>&lt;b&gt;D&lt;/b&gt;</description>" +
    "<item><guid>g</guid><description>&lt;p&gt;hi&lt;/p&gt;</description></item></channel></rss>",
  )
  eq(ttype(f.entries[0].summary), "html", "item description type")
  let atom = ok_s(feed::to_atom(f))
  let summ = start_tag(atom, "summary")
  debug_assert(!contains(summ, "type=\"text\""), "to_atom wrote RSS HTML description as " + summ)
}

// ---------------------------------------------------------------------------------------------------
// P1-4  JSON Feed 1.1 §items: "id (required, string) ... If the id is presented as a number or other type,
// a JSON Feed reader must coerce it to a string." Pion silently returns "" (entry identity lost).
// ---------------------------------------------------------------------------------------------------

///|
test "p1_json_numeric_id_not_coerced" {
  let f = must(
    "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"t\",\"items\":[{\"id\":123,\"content_text\":\"a\"},{\"id\":4.0e1,\"content_text\":\"b\"}]}",
  )
  eq(f.entries[0].id, "123", "numeric id")
  debug_assert(f.entries[1].id.length() > 0, "float id coerced to empty string")
}

// ---------------------------------------------------------------------------------------------------
// P1-5  RFC 4287 §4.1.3.1: when atom:content has `src`, `type` MUST be a MIME media type, not
// text/html/xhtml. Parsing drops the MIME type (TextType::Text) and to_atom writes `type="text" src=...`,
// which feed-rs rejects as a whole document (UnknownMimeType).
// ---------------------------------------------------------------------------------------------------

///|
test "p1_atom_out_of_line_content_reserialized_invalid" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><title>T</title><updated>2026-11-23T12:00:00Z</updated>" +
    "<entry><id>e</id><title>E</title><updated>2026-11-23T12:00:00Z</updated>" +
    "<content type=\"image/png\" src=\"http://x/a.png\"/></entry></feed>",
  )
  let atom = ok_s(feed::to_atom(f))
  let tag = start_tag(atom, "content")
  debug_assert(contains(tag, "src=\"http://x/a.png\""), "src lost: " + tag)
  debug_assert(
    !contains(tag, "type=\"text\"") && !contains(tag, "type=\"html\"") && !contains(tag, "type=\"xhtml\""),
    "out-of-line content written with a text-construct type: " + tag,
  )
}

// ---------------------------------------------------------------------------------------------------
// P2 findings
// ---------------------------------------------------------------------------------------------------

///| P2-1 RFC 4287 §4.2.7.2: "atom:link elements MAY have a rel attribute ... If not, the link element MUST
/// be interpreted as if the link relation type is "alternate"." feed-rs fills in "alternate".
test "p2_atom_link_rel_default_alternate" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><link href=\"http://x/\"/>" +
    "<entry><id>e</id><link href=\"http://x/1\"/></entry></feed>",
  )
  eq(opt_s(f.links[0].rel), "alternate", "feed link rel")
  eq(opt_s(f.entries[0].links[0].rel), "alternate", "entry link rel")
  let r = must(
    "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\"><channel><title>t</title>" +
    "<item><guid>g</guid><atom:link href=\"http://x/2\"/></item></channel></rss>",
  )
  eq(opt_s(r.entries[0].links[0].rel), "alternate", "rss atom:link rel")
}

///| P2-2 RFC 3986 §5.2.4 / §5.4: empty path segments are data, and network-path references are
/// dot-normalised (T.path = remove_dot_segments(R.path)). feed-rs (WHATWG url) agrees on all three.
test "p2_resolve_url_rfc3986_empty_segments_and_netpath" {
  let b = "http://a/b/c/d;p?q"
  eq(feed::resolve_url(b, "g//h"), "http://a/b/c/g//h", "g//h")
  eq(feed::resolve_url(b, "/a//b/../c"), "http://a/a//c", "/a//b/../c")
  eq(feed::resolve_url(b, "//h/p/../q"), "http://h/q", "//h/p/../q")
}

///| P2-3 xml:base on atom:icon / atom:logo applies to the element itself (XML Base §4.2, RFC 4287 §2).
test "p2_atom_icon_logo_own_xml_base_ignored" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:base=\"http://ex.com/a/\"><id>f</id>" +
    "<icon xml:base=\"http://cdn.com/i/\">fav.ico</icon><logo xml:base=\"/img/\">l.png</logo></feed>",
  )
  eq(match f.icon { Some(i) => i.uri; None => "<None>" }, "http://cdn.com/i/fav.ico", "icon")
  eq(match f.logo { Some(i) => i.uri; None => "<None>" }, "http://ex.com/img/l.png", "logo")
}

///| P2-4 Unchecked Int64 parsing: 9999999999999999999 wraps to -8446744073709551617, negative sizes
/// accepted (RSS 2.0 enclosure length = "how big it is in bytes"; feed-rs parses u64 and drops both).
test "p2_enclosure_length_overflow_and_negative" {
  let f = must(
    "<rss version=\"2.0\"><channel><title>t</title><item><guid>g</guid>" +
    "<enclosure url=\"http://x/a.mp3\" length=\"9999999999999999999\" type=\"audio/mpeg\"/>" +
    "<enclosure url=\"http://x/b.mp3\" length=\"-5\" type=\"audio/mpeg\"/>" +
    "<enclosure url=\"http://x/c.mp3\" length=\"12345\" type=\"audio/mpeg\"/></item></channel></rss>",
  )
  let ls = f.entries[0].links
  eq(opt_l(ls[0].length), "<None>", "overflowing length")
  eq(opt_l(ls[1].length), "<None>", "negative length")
  eq(opt_l(ls[2].length), "12345", "valid length")
}

///|
fn itunes_dur(d : String) -> String {
  let f = must(
    "<rss version=\"2.0\" xmlns:itunes=\"http://www.itunes.com/dtds/podcast-1.0.dtd\"><channel><title>t</title>" +
    "<item><guid>g</guid><itunes:duration>" + d + "</itunes:duration></item></channel></rss>",
  )
  match f.entries[0].itunes {
    Some(m) => opt_l(m.duration)
    None => "<None>"
  }
}

///|
fn well_formed_fragment(v : String) -> Bool {
  match xml::Document::parse("<r>" + v + "</r>") {
    Ok(_) => true
    Err(_) => false
  }
}

///| P2-4b iTunes duration: negative components and Int64 overflow produce negative durations.
test "p2_itunes_duration_negative_and_overflow" {
  eq(itunes_dur("-5"), "<None>", "-5")
  eq(itunes_dur("00:-30"), "<None>", "00:-30")
  eq(itunes_dur("9223372036854775807:00:00"), "<None>", "overflow")
  eq(itunes_dur("1:02:03"), "3723", "valid HH:MM:SS")
}

///| P2-5 RFC 3339 §5.6 time-numoffset uses time-hour (00-23); RFC 5322 zone is +-HHMM with the same
/// meaning. +2400 / +24:00 are accepted and shift the instant by a full day (feed-rs rejects both).
/// Root cause is packages/time parse_rfc2822 / parse_rfc3339, reached first from date.pion.
test "p2_date_offset_24h_accepted" {
  eq(date_s("23 Nov 2026 12:00:00 +2400"), "<Err>", "+2400")
  eq(date_s("2026-11-23T12:00:00+24:00"), "<Err>", "+24:00")
  eq(date_s("2026-11-23T12:00:00+2400"), "<Err>", "+2400 iso")
}

///| P2-6 XHTML text constructs: namespace declarations below the wrapper div are dropped, so prefixed
/// XHTML comes out with unbound prefixes (value is not a well-formed fragment).
test "p2_xhtml_prefixes_unbound_after_serialization" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><entry><id>e</id><content type=\"xhtml\">" +
    "<xh:div xmlns:xh=\"http://www.w3.org/1999/xhtml\"><xh:p>Hi <xh:b>B</xh:b></xh:p></xh:div></content>" +
    "<summary type=\"xhtml\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><p xmlns:m=\"http://www.w3.org/1998/Math/MathML\">x<m:mi>y</m:mi></p></div></summary>" +
    "</entry></feed>",
  )
  let c = txt(f.entries[0].content)
  let s = txt(f.entries[0].summary)
  debug_assert(well_formed_fragment(c), "content xhtml not well-formed: " + c)
  debug_assert(well_formed_fragment(s), "summary xhtml not well-formed: " + s)
}

///| P2-6b to_atom writes TextType::Xhtml as type="html"; the type is lost on the roundtrip.
test "p2_xhtml_roundtrip_becomes_html" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><title>T</title><updated>2026-11-23T12:00:00Z</updated>" +
    "<entry><id>e</id><title>E</title><updated>2026-11-23T12:00:00Z</updated>" +
    "<content type=\"xhtml\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Hi <b>there</b></p></div></content></entry></feed>",
  )
  let g = must(ok_s(feed::to_atom(f)))
  eq(ttype(g.entries[0].content), "xhtml", "content type after to_atom/parse")
  eq(txt(g.entries[0].content), txt(f.entries[0].content), "content value after to_atom/parse")
}

///| P2-7 to_rss2 drops feed-level authors (managingEditor / dc:creator never written).
test "p2_to_rss2_drops_feed_authors" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>http://x/</id><title>T</title><updated>2026-11-23T12:00:00Z</updated>" +
    "<author><name>Ed</name><email>ed@x.com</email></author></feed>",
  )
  let g = must(ok_s(feed::to_rss2(f)))
  eq(g.authors.length().to_string(), "1", "feed authors after to_rss2/parse")
}

///| P2-8 JSON limit errors are classified by substring ("depth" / "limit" / "nodes") of the json5 message;
/// json5 reports the node cap as "maximum node count exceeded", so a 2 MB JSON Feed (well under max_bytes)
/// with > 1,000,000 values comes back as JsonError instead of LimitExceeded (json_feed.pion:319).
test "p2_json_node_cap_reported_as_json_error" {
  let sb = StringBuilder::new()
  sb.write_string("{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"t\",\"x\":[")
  let mut i = 0
  while i < 1000001 {
    sb.write_string("0,")
    i = i + 1
  }
  sb.write_string("0],\"items\":[]}")
  let k = match feed::parse(sb.to_string()) {
    Ok(_) => "ok"
    Err(e) => if e.kind.eq(feed::FeedErrorKind::LimitExceeded) { "LimitExceeded" } else { "other: " + e.message }
  }
  eq(k, "LimitExceeded", "1,000,002-node JSON Feed")
}

// ---------------------------------------------------------------------------------------------------
// Controls: attacks the package survived. They must keep passing.
// ---------------------------------------------------------------------------------------------------

///| Injection: every serializer escapes markup / CDATA terminators / quotes and the output reparses to
/// the same values.
test "control_serializer_injection_roundtrip" {
  let nasty = "a]]>b <script>alert(1)</script> & \" ' \r\n\t \u{2028} \u{1F600}"
  let jnasty = "a]]>b <script>alert(1)</script> & \\\" ' \\r\\n\\t \\u2028 \\ud83d\\ude00"
  let f = must(
    "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"" + jnasty + "\",\"home_page_url\":\"http://x/?a=1&b=" +
    jnasty + "\",\"items\":[{\"id\":\"" + jnasty + "\",\"url\":\"http://x/\",\"title\":\"" + jnasty +
    "\",\"content_html\":\"" + jnasty + "\",\"tags\":[\"" + jnasty + "\"],\"authors\":[{\"name\":\"" + jnasty + "\"}]}]}",
  )
  eq(txt(f.title), nasty, "json title decoded")
  let outs = [ok_s(feed::to_rss2(f)), ok_s(feed::to_atom(f)), ok_s(feed::to_json_feed(f))]
  let mut i = 0
  while i < outs.length() {
    let g = must(outs[i])
    eq(txt(g.title), nasty, "title after serializer " + i.to_string())
    eq(g.entries[0].id, nasty, "id after serializer " + i.to_string())
    eq(txt(g.entries[0].content), nasty, "content after serializer " + i.to_string())
    eq(g.entries[0].categories[0].term, nasty, "category after serializer " + i.to_string())
    if i < 2 {
      debug_assert(!contains(outs[i], "<script>"), "raw <script> in XML serializer output " + i.to_string())
    }
    i = i + 1
  }
}

///| Illegal XML 1.0 characters: XML serializers refuse (SerializationError) instead of emitting a
/// malformed document; JSON escapes them.
test "control_serializer_illegal_xml_chars_refused" {
  let f = must("{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"a\\u000bb\\u0000c\",\"items\":[]}")
  let rss_err = match feed::to_rss2(f) {
    Ok(_) => false
    Err(e) => e.kind.eq(feed::FeedErrorKind::SerializationError)
  }
  let atom_err = match feed::to_atom(f) {
    Ok(_) => false
    Err(e) => e.kind.eq(feed::FeedErrorKind::SerializationError)
  }
  debug_assert(rss_err && atom_err, "illegal XML chars must be refused")
  let g = must(ok_s(feed::to_json_feed(f)))
  eq(txt(g.title), "a\u{000B}b\u{0000}c", "json roundtrip of control chars")
}

///| Atom type="html" is unescaped exactly once; type="text" keeps markup as text.
test "control_atom_html_no_double_unescape" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><entry><id>e</id>" +
    "<title type=\"html\">AT&amp;amp;T &amp;lt;b&amp;gt;</title><summary type=\"text\">&lt;b&gt;</summary></entry></feed>",
  )
  eq(txt(f.entries[0].title), "AT&amp;T &lt;b&gt;", "html title")
  eq(ttype(f.entries[0].title), "html", "html title type")
  eq(txt(f.entries[0].summary), "<b>", "text summary")
}

///| Prefixes are resolved by namespace URI, not by literal prefix strings.
test "control_custom_prefixes_by_namespace_uri" {
  let a = must(
    "<a:feed xmlns:a=\"http://www.w3.org/2005/Atom\"><a:id>f</a:id><a:title>T</a:title>" +
    "<a:entry><a:id>e</a:id><a:link rel=\"alternate\" href=\"http://x/\"/></a:entry></a:feed>",
  )
  eq(a.format.to_string(), "atom", "atom fmt")
  eq(a.entries[0].id, "e", "atom entry id")
  let r = must(
    "<r:RDF xmlns:r=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns=\"http://purl.org/rss/1.0/\">" +
    "<channel r:about=\"http://x/\"><title>T</title><link>http://x/</link></channel>" +
    "<item r:about=\"http://x/1\"><title>I</title><link>http://x/1</link></item></r:RDF>",
  )
  eq(r.format.to_string(), "rss1", "rdf fmt")
  eq(r.entries[0].id, "http://x/1", "rdf about")
  let m = must(
    "<rss version=\"2.0\" xmlns:a10=\"http://www.w3.org/2005/Atom\" xmlns:m2=\"http://search.yahoo.com/mrss/\" " +
    "xmlns:c=\"http://purl.org/rss/1.0/modules/content/\"><channel><title>t</title><item><guid>g</guid>" +
    "<a10:link rel=\"self\" href=\"http://x/s\"/><m2:content url=\"http://x/v.mp4\"/><c:encoded>&lt;p&gt;B&lt;/p&gt;</c:encoded>" +
    "</item></channel></rss>",
  )
  eq(m.entries[0].links[0].href, "http://x/s", "atom10 link")
  eq(m.entries[0].media.length().to_string(), "1", "media2 content")
  eq(txt(m.entries[0].content), "<p>B</p>", "content:encoded via c:")
}

///|
fn fn_permalink(o : Option[Bool]) -> String {
  match o {
    Some(true) => "true"
    Some(false) => "false"
    None => "<None>"
  }
}

///| guid isPermaLink default true / explicit false.
test "control_guid_permalink" {
  let f = must(
    "<rss version=\"2.0\"><channel><title>t</title><item><guid>http://x/1</guid></item>" +
    "<item><guid isPermaLink=\"false\">tag:x,2026:2</guid></item></channel></rss>",
  )
  let pl = fn_permalink(f.entries[0].id_is_permalink) + "," + fn_permalink(f.entries[1].id_is_permalink)
  eq(pl, "true,false", "isPermaLink default / explicit false")
}

///| Date edge cases (RFC 2822 §4.3 two-digit years, leap years, invalid fields, zones, comments;
/// RFC 3339 lowercase, fractional, leap second). feed-rs agrees on every row it can parse.
test "control_date_matrix" {
  eq(date_s("Mon, 23 Nov 26 12:00:00 GMT"), "1795435200", "yy 26")
  eq(date_s("Wed, 23 Nov 49 12:00:00 GMT"), "2521281600", "yy 49 -> 2049")
  eq(date_s("Tue, 23 Nov 50 12:00:00 GMT"), "-602942400", "yy 50 -> 1950")
  eq(date_s("Tue, 29 Feb 2000 00:00:00 GMT"), "951782400", "leap 2000")
  eq(date_s("Thu, 29 Feb 1900 00:00:00 GMT"), "<Err>", "1900 not leap")
  eq(date_s("31 Feb 2026 00:00:00 GMT"), "<Err>", "31 Feb")
  eq(date_s("32 Jan 2026 00:00:00 GMT"), "<Err>", "32 Jan")
  eq(date_s("23 Nov 2026 25:00:00 GMT"), "<Err>", "25h")
  eq(date_s("23 Nov 2026 12:00:00 +0530"), "1795415400", "+0530")
  eq(date_s("23 Nov 2026 12:00:00 -0000"), "1795435200", "-0000")
  eq(date_s("Mon, 23 Nov 2026 12:00:00 -0800 (PST)"), "1795464000", "comment")
  eq(date_s("23 Nov 2026 12:00:00 EST"), "1795453200", "EST")
  eq(date_s("23 Nov 2026 12:00:00 PDT"), "1795460400", "PDT")
  eq(date_s("2026-11-23t12:00:00z"), "1795435200", "lowercase t z")
  eq(date_s("2026-11-23T12:00:00.123456789123Z"), "1795435200", "long fraction")
  eq(date_s("2026-11-23T12:00:60Z"), "1795435259", "leap second")
  eq(date_s("2026-11-23"), "1795392000", "date only")
  eq(date_s("2026-11-23T12:00:00+0800"), "1795406400", "compact offset")
  eq(date_s("2026-02-30T00:00:00Z"), "<Err>", "30 Feb")
  eq(date_s("2026-11-23T24:00:00Z"), "<Err>", "24h")
}

///| RFC 3986 §5.4.1 / §5.4.2 reference resolution examples (all pass).
test "control_resolve_url_rfc3986_examples" {
  let b = "http://a/b/c/d;p?q"
  let cases = [
    ("g:h", "g:h"), ("g", "http://a/b/c/g"), ("./g", "http://a/b/c/g"), ("g/", "http://a/b/c/g/"),
    ("/g", "http://a/g"), ("//g", "http://g"), ("?y", "http://a/b/c/d;p?y"), ("g?y", "http://a/b/c/g?y"),
    ("#s", "http://a/b/c/d;p?q#s"), ("g#s", "http://a/b/c/g#s"), ("g?y#s", "http://a/b/c/g?y#s"),
    (";x", "http://a/b/c/;x"), ("g;x", "http://a/b/c/g;x"), ("g;x?y#s", "http://a/b/c/g;x?y#s"),
    ("", "http://a/b/c/d;p?q"), (".", "http://a/b/c/"), ("./", "http://a/b/c/"), ("..", "http://a/b/"),
    ("../", "http://a/b/"), ("../g", "http://a/b/g"), ("../..", "http://a/"), ("../../", "http://a/"),
    ("../../g", "http://a/g"), ("../../../g", "http://a/g"), ("../../../../g", "http://a/g"),
    ("/./g", "http://a/g"), ("/../g", "http://a/g"), ("g.", "http://a/b/c/g."), (".g", "http://a/b/c/.g"),
    ("g..", "http://a/b/c/g.."), ("..g", "http://a/b/c/..g"), ("./../g", "http://a/b/g"),
    ("./g/.", "http://a/b/c/g/"), ("g/./h", "http://a/b/c/g/h"), ("g/../h", "http://a/b/c/h"),
    ("g;x=1/./y", "http://a/b/c/g;x=1/y"), ("g;x=1/../y", "http://a/b/c/y"), ("g?y/./x", "http://a/b/c/g?y/./x"),
    ("g?y/../x", "http://a/b/c/g?y/../x"), ("g#s/./x", "http://a/b/c/g#s/./x"), ("g#s/../x", "http://a/b/c/g#s/../x"),
    ("http:g", "http:g"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (r, want) = cases[i]
    eq(feed::resolve_url(b, r), want, "resolve " + r)
    i = i + 1
  }
}

///| Nested xml:base (feed -> entry -> link / content / author) resolves layer by layer.
test "control_nested_xml_base" {
  let f = must(
    "<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:base=\"http://ex.com/a/\"><id>f</id><entry xml:base=\"b/\"><id>e</id>" +
    "<link xml:base=\"c/\" href=\"d.html\"/><content type=\"image/png\" src=\"img.png\" xml:base=\"../z/\"/>" +
    "<author xml:base=\"/root/\"><name>n</name><uri>me</uri></author></entry></feed>",
  )
  eq(f.entries[0].links[0].href, "http://ex.com/a/b/c/d.html", "link")
  eq(match f.entries[0].content { Some(c) => opt_s(c.src); None => "<None>" }, "http://ex.com/a/z/img.png", "content src")
  eq(opt_s(f.entries[0].authors[0].uri), "http://ex.com/root/me", "author uri")
}

///| JSON Feed: strict RFC 8259 (no JSON5 comments / trailing commas / single quotes), 1.1 `authors` wins
/// over deprecated 1.0 `author`, mixed-type tags do not crash.
test "control_json_feed_strictness" {
  let bad = [
    "{\"version\":\"https://jsonfeed.org/version/1.1\",/*c*/\"title\":\"T\",\"items\":[]}",
    "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"T\",\"items\":[],}",
    "{'version':'https://jsonfeed.org/version/1.1','title':'T','items':[]}",
    "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"T\",\"items\":[]} trailing",
    "{\"title\":\"T\",\"items\":[]}",
  ]
  let mut i = 0
  while i < bad.length() {
    match feed::parse(bad[i]) {
      Ok(_) => debug_assert(false, "accepted non-JSON-Feed input " + i.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
  let f = must(
    "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"T\",\"author\":{\"name\":\"Old\"},\"authors\":[{\"name\":\"New\"}]," +
    "\"items\":[{\"id\":\"1\",\"tags\":[null,1,\"ok\",true,{}]}]}",
  )
  eq(f.authors[0].name, "New", "authors precedence")
  eq(f.entries[0].categories.length().to_string(), "1", "string tags only")
}
