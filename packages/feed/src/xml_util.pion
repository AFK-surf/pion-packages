///| Shared XML, string, namespace, XHTML serialization, and podcast/author helpers for `packages/feed`.

import "xml"

///|
let ns_atom : String = "http://www.w3.org/2005/Atom"

///|
let ns_xml : String = "http://www.w3.org/XML/1998/namespace"

///|
let ns_rdf : String = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"

///|
let ns_rss1 : String = "http://purl.org/rss/1.0/"

///|
let ns_content : String = "http://purl.org/rss/1.0/modules/content/"

///|
let ns_dc : String = "http://purl.org/dc/elements/1.1/"

///|
let ns_media : String = "http://search.yahoo.com/mrss/"

///|
let ns_media_https : String = "https://search.yahoo.com/mrss/"

///|
let ns_itunes : String = "http://www.itunes.com/dtds/podcast-1.0.dtd"

///|
let ns_itunes_https : String = "https://www.itunes.com/dtds/podcast-1.0.dtd"

///|
fn strip_bom_str(s : String) -> String {
  if s.length() >= 3 &&
  s.code_unit_at(0) == 0xEF &&
  s.code_unit_at(1) == 0xBB &&
  s.code_unit_at(2) == 0xBF {
    s.slice(3, s.length())
  } else {
    s
  }
}

///|
fn trim_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && is_ascii_ws(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_ascii_ws(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

///|
fn to_lower_ascii(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < n {
    sb.write_byte(ascii_lower_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn parse_int_trimmed(s : String) -> Option[Int] {
  let t = trim_ws(s)
  let n = t.length()
  if n == 0 || n > 10 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc : Int64 = 0L
  while i < n {
    let b = t.code_unit_at(i)
    if !is_ascii_digit(b) {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    if acc > 2147483647L {
      return None
    }
    i = i + 1
  }
  if neg {
    Some((-acc).to_int())
  } else {
    Some(acc.to_int())
  }
}

///|
fn parse_i64_trimmed(s : String) -> Option[Int64] {
  let t = trim_ws(s)
  let n = t.length()
  if n == 0 || n > 19 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc : Int64 = 0L
  while i < n {
    let b = t.code_unit_at(i)
    if !is_ascii_digit(b) {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    i = i + 1
  }
  if neg {
    Some(-acc)
  } else {
    Some(acc)
  }
}

///|
fn check_text_limit(s : String, limits : FeedLimits) -> Result[String, FeedError] {
  if s.length() > limits.max_text_bytes {
    return Err(
      FeedError::new(
        FeedErrorKind::LimitExceeded,
        "text length " + s.length().to_string() + " exceeds max_text_bytes",
      ),
    )
  }
  Ok(s)
}

///| Extract concatenated text from all direct text/CDATA children of `node`, respecting `max_text_bytes`.
fn node_full_text(
  node : xml::Node,
  limits : FeedLimits,
) -> Result[String, FeedError] {
  let first = match node.first_child() {
    Some(c) => c
    None => return Ok("")
  }
  // Fast path: single text child
  if first.is_text() {
    match first.next_sibling() {
      None => {
        if first.text_len() > limits.max_text_bytes {
          return Err(FeedError::new(FeedErrorKind::LimitExceeded, "text exceeds max_text_bytes"))
        }
        return match first.text() {
          Some(s) => Ok(s)
          None => Ok("")
        }
      }
      Some(_) => ()
    }
  }
  let sb = StringBuilder::new()
  let mut total = 0
  let mut cur : Option[xml::Node] = Some(first)
  while true {
    let c = match cur {
      Some(v) => v
      None => break
    }
    if c.is_text() {
      let tlen = c.text_len()
      if total + tlen > limits.max_text_bytes {
        return Err(FeedError::new(FeedErrorKind::LimitExceeded, "text exceeds max_text_bytes"))
      }
      match c.text() {
        Some(t) => {
          sb.write_string(t)
          total = total + t.length()
        }
        None => ()
      }
    }
    cur = c.next_sibling()
  }
  Ok(sb.to_string())
}

///|
fn write_xml_escaped_text(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut mark = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&amp;")
      i = i + 1
      mark = i
    } else if b == 60 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&lt;")
      i = i + 1
      mark = i
    } else if b == 62 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&gt;")
      i = i + 1
      mark = i
    } else {
      i = i + 1
    }
  }
  if mark < n {
    sb.write_substring(s, mark, n)
  }
}

///|
fn write_xml_escaped_attr(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut mark = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&amp;")
      i = i + 1
      mark = i
    } else if b == 60 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&lt;")
      i = i + 1
      mark = i
    } else if b == 62 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&gt;")
      i = i + 1
      mark = i
    } else if b == 34 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      sb.write_string("&quot;")
      i = i + 1
      mark = i
    } else {
      i = i + 1
    }
  }
  if mark < n {
    sb.write_substring(s, mark, n)
  }
}

///| Iteratively serialize the inner XHTML subtree of an Atom `type="xhtml"` element.
///| Unwraps the RFC 4287 §3.1.1.3 `<div xmlns="http://www.w3.org/1999/xhtml">` container if present.
fn serialize_xhtml_children(
  node : xml::Node,
  limits : FeedLimits,
) -> Result[String, FeedError] {
  // Check if there is a single wrapper <div> element child
  let mut container = node
  match node.first_element_child() {
    Some(fe) => {
      if fe.has_tag_name("div") {
        match fe.next_sibling_element() {
          None => container = fe
          Some(_) => ()
        }
      }
    }
    None => ()
  }
  let sb = StringBuilder::new()
  // Stack entries: (node, is_close_tag)
  let stack : Array[(xml::Node, Bool)] = []
  // Push children of container in reverse order
  let root_children = container.children()
  let mut ci = root_children.length() - 1
  while ci >= 0 {
    stack.push((root_children[ci], false))
    ci = ci - 1
  }
  while stack.length() > 0 {
    let item = match stack.pop() {
      Some(v) => v
      None => break
    }
    let (cur, is_close) = item
    if is_close {
      let tn = cur.tag_name()
      sb.write_string("</")
      sb.write_string(tn.qualified_name())
      sb.write_byte((62).to_byte())
    } else if cur.is_text() {
      match cur.text() {
        Some(t) => write_xml_escaped_text(sb, t)
        None => ()
      }
    } else if cur.is_element() {
      let tn = cur.tag_name()
      let qname = tn.qualified_name()
      sb.write_byte((60).to_byte())
      sb.write_string(qname)
      let attrs = cur.attributes()
      let mut ai = 0
      while ai < attrs.length() {
        let a = attrs[ai]
        sb.write_byte((32).to_byte())
        match a.prefix {
          Some(p) => {
            sb.write_string(p)
            sb.write_byte((58).to_byte())
            sb.write_string(a.local)
          }
          None => sb.write_string(a.local)
        }
        sb.write_string("=\"")
        write_xml_escaped_attr(sb, a.value)
        sb.write_byte((34).to_byte())
        ai = ai + 1
      }
      if !cur.has_children() {
        sb.write_string("/>")
      } else {
        sb.write_byte((62).to_byte())
        stack.push((cur, true))
        let ch = cur.children()
        let mut k = ch.length() - 1
        while k >= 0 {
          stack.push((ch[k], false))
          k = k - 1
        }
      }
    }
    if sb.length() > limits.max_text_bytes {
      return Err(FeedError::new(FeedErrorKind::LimitExceeded, "XHTML content exceeds max_text_bytes"))
    }
  }
  Ok(trim_ws(sb.to_string()))
}

///|
fn is_elem_ns(
  node : xml::Node,
  ns1 : String,
  ns2 : String,
  fallback_prefix : String,
) -> Bool {
  match node.namespace() {
    Some(u) => u == ns1 || (ns2.length() > 0 && u == ns2)
    None => {
      let tn = node.tag_name()
      match tn.prefix {
        Some(p) => p == fallback_prefix
        None => false
      }
    }
  }
}

///|
fn is_dc_elem(node : xml::Node) -> Bool {
  is_elem_ns(node, ns_dc, "https://purl.org/dc/elements/1.1/", "dc")
}

///|
fn is_content_elem(node : xml::Node) -> Bool {
  is_elem_ns(node, ns_content, "https://purl.org/rss/1.0/modules/content/", "content")
}

///|
fn is_media_elem(node : xml::Node) -> Bool {
  is_elem_ns(node, ns_media, ns_media_https, "media")
}

///|
fn is_itunes_elem(node : xml::Node) -> Bool {
  is_elem_ns(node, ns_itunes, ns_itunes_https, "itunes")
}

///|
fn is_atom_elem(node : xml::Node) -> Bool {
  is_elem_ns(node, ns_atom, "https://www.w3.org/2005/Atom", "atom")
}

///|
fn get_xml_base(node : xml::Node, parent_base : String) -> String {
  match node.attribute_ns(ns_xml, "base") {
    Some(b) => {
      let trimmed = trim_ws(b)
      if trimmed.length() > 0 {
        resolve_url(parent_base, trimmed)
      } else {
        parent_base
      }
    }
    None => parent_base
  }
}

///|
fn get_xml_lang(node : xml::Node) -> Option[String] {
  match node.attribute_ns(ns_xml, "lang") {
    Some(l) => {
      let t = trim_ws(l)
      if t.length() > 0 {
        Some(t)
      } else {
        None
      }
    }
    None => None
  }
}

///| Parse RSS author / managingEditor / webMaster formats:
///| - `user@example.com (Display Name)` -> name="Display Name", email=Some("user@example.com")
///| - `Display Name <user@example.com>` -> name="Display Name", email=Some("user@example.com")
///| - `user@example.com` -> name="user@example.com", email=Some("user@example.com")
///| - `Display Name` -> name="Display Name", email=None
fn parse_rss_person(raw : String) -> Person {
  let s = trim_ws(raw)
  let n = s.length()
  // Check for "email (Name)"
  let mut lp = -1
  let mut rp = -1
  let mut lt = -1
  let mut gt = -1
  let mut has_at = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 40 && lp < 0 {
      lp = i
    } else if b == 41 {
      rp = i
    } else if b == 60 && lt < 0 {
      lt = i
    } else if b == 62 {
      gt = i
    } else if b == 64 {
      has_at = true
    }
    i = i + 1
  }
  if lp >= 0 && rp > lp {
    let before = trim_ws(s.slice(0, lp))
    let inside = trim_ws(s.slice(lp + 1, rp))
    if inside.length() > 0 && before.length() > 0 {
      return Person::{ name: inside, uri: None, email: Some(before), avatar: None }
    }
  }
  if lt >= 0 && gt > lt {
    let before = trim_ws(s.slice(0, lt))
    let inside = trim_ws(s.slice(lt + 1, gt))
    if inside.length() > 0 {
      let name = if before.length() > 0 { before } else { inside }
      return Person::{ name: name, uri: None, email: Some(inside), avatar: None }
    }
  }
  if has_at {
    Person::{ name: s, uri: None, email: Some(s), avatar: None }
  } else {
    Person::new(s)
  }
}

///| Parse iTunes duration (`SS`, `MM:SS`, or `HH:MM:SS`) to total seconds.
fn parse_itunes_duration(raw : String) -> Option[Int64] {
  let s = trim_ws(raw)
  let n = s.length()
  if n == 0 {
    return None
  }
  let parts : Array[Int64] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 58 {
      let seg = s.slice(start, i)
      // Truncate fractional seconds if present
      let mut dot = seg.length()
      let mut j = 0
      while j < seg.length() {
        if seg.code_unit_at(j) == 46 {
          dot = j
          break
        }
        j = j + 1
      }
      match parse_i64_trimmed(seg.slice(0, dot)) {
        Some(v) => parts.push(v)
        None => return None
      }
      start = i + 1
    }
    i = i + 1
  }
  if parts.length() == 1 {
    Some(parts[0])
  } else if parts.length() == 2 {
    Some(parts[0] * 60L + parts[1])
  } else if parts.length() == 3 {
    Some(parts[0] * 3600L + parts[1] * 60L + parts[2])
  } else {
    None
  }
}

///|
fn parse_itunes_explicit(raw : String) -> Option[Bool] {
  let l = to_lower_ascii(trim_ws(raw))
  if l == "yes" || l == "true" || l == "explicit" {
    Some(true)
  } else if l == "no" || l == "false" || l == "clean" {
    Some(false)
  } else {
    None
  }
}
