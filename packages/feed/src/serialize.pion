///| Safe, standards-compliant serializers for RSS 2.0, Atom 1.0 (RFC 4287), and JSON Feed 1.1.

import "xml"
import "json5"
import "time"

///|
fn map_xml_write_err(res : Result[Unit, xml::XmlError]) -> Result[Unit, FeedError] {
  match res {
    Ok(_) => Ok(())
    Err(e) => Err(FeedError::new(FeedErrorKind::SerializationError, e.message))
  }
}

///|
fn write_text_elem(
  w : xml::Writer,
  name : String,
  attrs : Array[(String, String)],
  text : String,
) -> Result[Unit, FeedError] {
  match map_xml_write_err(w.write_start_element(name, attrs)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match map_xml_write_err(w.write_text(text)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  map_xml_write_err(w.write_end_element(name))
}

///|
fn find_link_by_rel(links : Array[Link], rel : String) -> Option[Link] {
  let mut i = 0
  while i < links.length() {
    match links[i].rel {
      Some(r) => {
        if r == rel {
          return Some(links[i])
        }
      }
      None => ()
    }
    i = i + 1
  }
  None
}

///|
fn find_primary_link(links : Array[Link]) -> Option[Link] {
  match find_link_by_rel(links, "alternate") {
    Some(l) => Some(l)
    None => {
      let mut i = 0
      while i < links.length() {
        match links[i].rel {
          Some(r) => {
            if r != "self" && r != "enclosure" {
              return Some(links[i])
            }
          }
          None => return Some(links[i])
        }
        i = i + 1
      }
      if links.length() > 0 { Some(links[0]) } else { None }
    }
  }
}

///|
fn write_rss_entry(w : xml::Writer, entry : Entry) -> Result[Unit, FeedError] {
  match map_xml_write_err(w.write_start_element("item", [])) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match entry.title {
    Some(t) => { match write_text_elem(w, "title", [], t.value) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  match find_primary_link(entry.links) {
    Some(l) => { match write_text_elem(w, "link", [], l.href) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  if entry.id.length() > 0 {
    let gattrs : Array[(String, String)] = []
    match entry.id_is_permalink {
      Some(false) => gattrs.push(("isPermaLink", "false"))
      Some(true) => gattrs.push(("isPermaLink", "true"))
      None => ()
    }
    match write_text_elem(w, "guid", gattrs, entry.id) { Ok(_) => (); Err(e) => return Err(e) }
  }
  let ts_opt = match entry.published { Some(t) => Some(t); None => entry.updated }
  match ts_opt {
    Some(ts) => { match write_text_elem(w, "pubDate", [], ts.to_rfc2822()) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  let mut ai = 0
  while ai < entry.authors.length() {
    let a = entry.authors[ai]
    match a.email {
      Some(em) => {
        let author_str = if a.name.length() > 0 && a.name != em { em + " (" + a.name + ")" } else { em }
        match write_text_elem(w, "author", [], author_str) { Ok(_) => (); Err(e) => return Err(e) }
      }
      None => {
        if a.name.length() > 0 {
          match write_text_elem(w, "dc:creator", [], a.name) { Ok(_) => (); Err(e) => return Err(e) }
        }
      }
    }
    ai = ai + 1
  }
  match entry.summary {
    Some(s) => { match write_text_elem(w, "description", [], s.value) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  match entry.content {
    Some(c) => { match write_text_elem(w, "content:encoded", [], c.value) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  match entry.comments_url {
    Some(u) => { match write_text_elem(w, "comments", [], u) { Ok(_) => (); Err(e) => return Err(e) } }
    None => ()
  }
  let mut k = 0
  while k < entry.categories.length() {
    let cat = entry.categories[k]
    let attrs : Array[(String, String)] = []
    match cat.scheme { Some(s) => attrs.push(("domain", s)); None => () }
    match write_text_elem(w, "category", attrs, cat.term) { Ok(_) => (); Err(e) => return Err(e) }
    k = k + 1
  }
  let mut li = 0
  while li < entry.links.length() {
    let lk = entry.links[li]
    match lk.rel {
      Some(r) => {
        if r == "enclosure" {
          let eattrs : Array[(String, String)] = [
            ("url", lk.href),
            ("length", match lk.length { Some(n) => n.to_string(); None => "0" }),
            ("type", match lk.media_type { Some(mt) => mt; None => "application/octet-stream" }),
          ]
          match map_xml_write_err(w.write_empty_element("enclosure", eattrs)) { Ok(_) => (); Err(e) => return Err(e) }
        }
      }
      None => ()
    }
    li = li + 1
  }
  map_xml_write_err(w.write_end_element("item"))
}

///| Serialize a unified `Feed` into a well-formed RSS 2.0 XML document.
pub fn to_rss2(feed : Feed) -> Result[String, FeedError] {
  let w = xml::Writer::new_with_indent((32).to_byte(), 2)
  match map_xml_write_err(w.write_xml_decl("1.0", Some("UTF-8"), None)) { Ok(_) => (); Err(e) => return Err(e) }
  let rss_attrs : Array[(String, String)] = [
    ("version", "2.0"),
    ("xmlns:content", ns_content),
    ("xmlns:dc", ns_dc),
    ("xmlns:atom", ns_atom),
  ]
  match map_xml_write_err(w.write_start_element("rss", rss_attrs)) { Ok(_) => (); Err(e) => return Err(e) }
  match map_xml_write_err(w.write_start_element("channel", [])) { Ok(_) => (); Err(e) => return Err(e) }

  let ch_title = match feed.title { Some(t) => t.value; None => "" }
  match write_text_elem(w, "title", [], ch_title) { Ok(_) => (); Err(e) => return Err(e) }
  let ch_link = match find_primary_link(feed.links) { Some(l) => l.href; None => feed.id }
  match write_text_elem(w, "link", [], ch_link) { Ok(_) => (); Err(e) => return Err(e) }

  match find_link_by_rel(feed.links, "self") {
    Some(self_l) => {
      let a : Array[(String, String)] = [("href", self_l.href), ("rel", "self"), ("type", "application/rss+xml")]
      match map_xml_write_err(w.write_empty_element("atom:link", a)) { Ok(_) => (); Err(e) => return Err(e) }
    }
    None => ()
  }
  let ch_desc = match feed.description {
    Some(d) => d.value
    None => match feed.subtitle { Some(s) => s.value; None => "" }
  }
  match write_text_elem(w, "description", [], ch_desc) { Ok(_) => (); Err(e) => return Err(e) }
  match feed.language { Some(l) => { match write_text_elem(w, "language", [], l) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.rights { Some(r) => { match write_text_elem(w, "copyright", [], r.value) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.published { Some(ts) => { match write_text_elem(w, "pubDate", [], ts.to_rfc2822()) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.updated { Some(ts) => { match write_text_elem(w, "lastBuildDate", [], ts.to_rfc2822()) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.generator { Some(g) => { match write_text_elem(w, "generator", [], g.content) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.ttl { Some(t) => { match write_text_elem(w, "ttl", [], t.to_string()) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }

  let mut ci = 0
  while ci < feed.categories.length() {
    let cat = feed.categories[ci]
    let attrs : Array[(String, String)] = []
    match cat.scheme { Some(s) => attrs.push(("domain", s)); None => () }
    match write_text_elem(w, "category", attrs, cat.term) { Ok(_) => (); Err(e) => return Err(e) }
    ci = ci + 1
  }
  match feed.logo {
    Some(img) => {
      match map_xml_write_err(w.write_start_element("image", [])) { Ok(_) => (); Err(e) => return Err(e) }
      match write_text_elem(w, "url", [], img.uri) { Ok(_) => (); Err(e) => return Err(e) }
      match write_text_elem(w, "title", [], match img.title { Some(t) => t; None => ch_title }) { Ok(_) => (); Err(e) => return Err(e) }
      match write_text_elem(w, "link", [], match img.link { Some(l) => l; None => ch_link }) { Ok(_) => (); Err(e) => return Err(e) }
      match map_xml_write_err(w.write_end_element("image")) { Ok(_) => (); Err(e) => return Err(e) }
    }
    None => ()
  }

  let mut ei = 0
  while ei < feed.entries.length() {
    match write_rss_entry(w, feed.entries[ei]) { Ok(_) => (); Err(e) => return Err(e) }
    ei = ei + 1
  }
  match map_xml_write_err(w.write_end_element("channel")) { Ok(_) => (); Err(e) => return Err(e) }
  match map_xml_write_err(w.write_end_element("rss")) { Ok(_) => (); Err(e) => return Err(e) }
  Ok(w.into_string())
}

///|
fn write_atom_text_elem(
  w : xml::Writer,
  name : String,
  tc : TextContent,
) -> Result[Unit, FeedError] {
  let attrs : Array[(String, String)] = []
  match tc.content_type {
    TextType::Html => attrs.push(("type", "html"))
    TextType::Xhtml => attrs.push(("type", "html"))
    TextType::Text => attrs.push(("type", "text"))
  }
  match tc.lang { Some(l) => attrs.push(("xml:lang", l)); None => () }
  match tc.src {
    Some(s) => {
      attrs.push(("src", s))
      return map_xml_write_err(w.write_empty_element(name, attrs))
    }
    None => ()
  }
  write_text_elem(w, name, attrs, tc.value)
}

///|
fn write_atom_person(
  w : xml::Writer,
  tag : String,
  p : Person,
) -> Result[Unit, FeedError] {
  match map_xml_write_err(w.write_start_element(tag, [])) { Ok(_) => (); Err(e) => return Err(e) }
  match write_text_elem(w, "name", [], p.name) { Ok(_) => (); Err(e) => return Err(e) }
  match p.email { Some(em) => { match write_text_elem(w, "email", [], em) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match p.uri { Some(u) => { match write_text_elem(w, "uri", [], u) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  map_xml_write_err(w.write_end_element(tag))
}

///|
fn write_atom_link(w : xml::Writer, lk : Link) -> Result[Unit, FeedError] {
  let attrs : Array[(String, String)] = [("href", lk.href)]
  match lk.rel { Some(r) => attrs.push(("rel", r)); None => () }
  match lk.media_type { Some(mt) => attrs.push(("type", mt)); None => () }
  match lk.href_lang { Some(hl) => attrs.push(("hreflang", hl)); None => () }
  match lk.title { Some(t) => attrs.push(("title", t)); None => () }
  match lk.length { Some(n) => attrs.push(("length", n.to_string())); None => () }
  map_xml_write_err(w.write_empty_element("link", attrs))
}

///|
fn write_atom_category(w : xml::Writer, c : Category) -> Result[Unit, FeedError] {
  let attrs : Array[(String, String)] = [("term", c.term)]
  match c.scheme { Some(s) => attrs.push(("scheme", s)); None => () }
  match c.label { Some(l) => attrs.push(("label", l)); None => () }
  map_xml_write_err(w.write_empty_element("category", attrs))
}

///|
fn write_atom_entry(
  w : xml::Writer,
  entry : Entry,
  idx : Int,
  fallback_upd : String,
) -> Result[Unit, FeedError] {
  match map_xml_write_err(w.write_start_element("entry", [])) { Ok(_) => (); Err(e) => return Err(e) }
  let eid = if entry.id.length() > 0 { entry.id } else { "urn:pion:entry:" + idx.to_string() }
  match write_text_elem(w, "id", [], eid) { Ok(_) => (); Err(e) => return Err(e) }
  let etitle = match entry.title { Some(t) => t; None => TextContent::plain("") }
  match write_atom_text_elem(w, "title", etitle) { Ok(_) => (); Err(e) => return Err(e) }
  let eupd = match entry.updated {
    Some(ts) => ts.to_rfc3339()
    None => match entry.published { Some(ts) => ts.to_rfc3339(); None => fallback_upd }
  }
  match write_text_elem(w, "updated", [], eupd) { Ok(_) => (); Err(e) => return Err(e) }
  match entry.published { Some(ts) => { match write_text_elem(w, "published", [], ts.to_rfc3339()) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  let mut k = 0
  while k < entry.links.length() {
    match write_atom_link(w, entry.links[k]) { Ok(_) => (); Err(e) => return Err(e) }
    k = k + 1
  }
  k = 0
  while k < entry.authors.length() {
    match write_atom_person(w, "author", entry.authors[k]) { Ok(_) => (); Err(e) => return Err(e) }
    k = k + 1
  }
  k = 0
  while k < entry.contributors.length() {
    match write_atom_person(w, "contributor", entry.contributors[k]) { Ok(_) => (); Err(e) => return Err(e) }
    k = k + 1
  }
  k = 0
  while k < entry.categories.length() {
    match write_atom_category(w, entry.categories[k]) { Ok(_) => (); Err(e) => return Err(e) }
    k = k + 1
  }
  match entry.summary { Some(s) => { match write_atom_text_elem(w, "summary", s) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match entry.content { Some(c) => { match write_atom_text_elem(w, "content", c) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match entry.rights { Some(r) => { match write_atom_text_elem(w, "rights", r) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  map_xml_write_err(w.write_end_element("entry"))
}

///| Serialize a unified `Feed` into a well-formed Atom 1.0 (RFC 4287) XML document.
pub fn to_atom(feed : Feed) -> Result[String, FeedError] {
  let w = xml::Writer::new_with_indent((32).to_byte(), 2)
  match map_xml_write_err(w.write_xml_decl("1.0", Some("UTF-8"), None)) { Ok(_) => (); Err(e) => return Err(e) }
  let root_attrs : Array[(String, String)] = [("xmlns", ns_atom)]
  match feed.language { Some(l) => root_attrs.push(("xml:lang", l)); None => () }
  match feed.base_url { Some(b) => root_attrs.push(("xml:base", b)); None => () }
  match map_xml_write_err(w.write_start_element("feed", root_attrs)) { Ok(_) => (); Err(e) => return Err(e) }

  let feed_id = if feed.id.length() > 0 { feed.id } else { "urn:pion:feed" }
  match write_text_elem(w, "id", [], feed_id) { Ok(_) => (); Err(e) => return Err(e) }
  let title_tc = match feed.title { Some(t) => t; None => TextContent::plain("") }
  match write_atom_text_elem(w, "title", title_tc) { Ok(_) => (); Err(e) => return Err(e) }
  match feed.subtitle {
    Some(s) => { match write_atom_text_elem(w, "subtitle", s) { Ok(_) => (); Err(e) => return Err(e) } }
    None => match feed.description { Some(d) => { match write_atom_text_elem(w, "subtitle", d) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  }
  let upd = match feed.updated {
    Some(ts) => ts.to_rfc3339()
    None => match feed.published { Some(ts) => ts.to_rfc3339(); None => "1970-01-01T00:00:00Z" }
  }
  match write_text_elem(w, "updated", [], upd) { Ok(_) => (); Err(e) => return Err(e) }
  match feed.rights { Some(r) => { match write_atom_text_elem(w, "rights", r) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.icon { Some(ic) => { match write_text_elem(w, "icon", [], ic.uri) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.logo { Some(lg) => { match write_text_elem(w, "logo", [], lg.uri) { Ok(_) => (); Err(e) => return Err(e) } }; None => () }
  match feed.generator {
    Some(g) => {
      let gattrs : Array[(String, String)] = []
      match g.uri { Some(u) => gattrs.push(("uri", u)); None => () }
      match g.version { Some(v) => gattrs.push(("version", v)); None => () }
      match write_text_elem(w, "generator", gattrs, g.content) { Ok(_) => (); Err(e) => return Err(e) }
    }
    None => ()
  }
  let mut i = 0
  while i < feed.links.length() {
    match write_atom_link(w, feed.links[i]) { Ok(_) => (); Err(e) => return Err(e) }
    i = i + 1
  }
  i = 0
  while i < feed.authors.length() {
    match write_atom_person(w, "author", feed.authors[i]) { Ok(_) => (); Err(e) => return Err(e) }
    i = i + 1
  }
  i = 0
  while i < feed.contributors.length() {
    match write_atom_person(w, "contributor", feed.contributors[i]) { Ok(_) => (); Err(e) => return Err(e) }
    i = i + 1
  }
  i = 0
  while i < feed.categories.length() {
    match write_atom_category(w, feed.categories[i]) { Ok(_) => (); Err(e) => return Err(e) }
    i = i + 1
  }
  let mut ei = 0
  while ei < feed.entries.length() {
    match write_atom_entry(w, feed.entries[ei], ei, upd) { Ok(_) => (); Err(e) => return Err(e) }
    ei = ei + 1
  }
  match map_xml_write_err(w.write_end_element("feed")) { Ok(_) => (); Err(e) => return Err(e) }
  Ok(w.into_string())
}

///|
fn person_to_json(p : Person) -> json5::Json5Value {
  let obj : Array[(String, json5::Json5Value)] = []
  if p.name.length() > 0 { obj.push(("name", json5::Json5Value::Str(p.name))) }
  match p.uri { Some(u) => obj.push(("url", json5::Json5Value::Str(u))); None => () }
  match p.avatar { Some(a) => obj.push(("avatar", json5::Json5Value::Str(a))); None => () }
  json5::Json5Value::Object(obj)
}

///|
fn entry_to_json(e : Entry, idx : Int) -> json5::Json5Value {
  let obj : Array[(String, json5::Json5Value)] = [
    ("id", json5::Json5Value::Str(if e.id.length() > 0 { e.id } else { idx.to_string() })),
  ]
  match find_primary_link(e.links) { Some(l) => obj.push(("url", json5::Json5Value::Str(l.href))); None => () }
  match e.external_url { Some(u) => obj.push(("external_url", json5::Json5Value::Str(u))); None => () }
  match e.title { Some(t) => obj.push(("title", json5::Json5Value::Str(t.value))); None => () }
  match e.content {
    Some(c) => match c.content_type {
      TextType::Text => obj.push(("content_text", json5::Json5Value::Str(c.value)))
      _ => obj.push(("content_html", json5::Json5Value::Str(c.value)))
    }
    None => ()
  }
  match e.summary { Some(s) => obj.push(("summary", json5::Json5Value::Str(s.value))); None => () }
  match e.image { Some(im) => obj.push(("image", json5::Json5Value::Str(im))); None => () }
  match e.banner_image { Some(bi) => obj.push(("banner_image", json5::Json5Value::Str(bi))); None => () }
  match e.published { Some(ts) => obj.push(("date_published", json5::Json5Value::Str(ts.to_rfc3339()))); None => () }
  match e.updated { Some(ts) => obj.push(("date_modified", json5::Json5Value::Str(ts.to_rfc3339()))); None => () }
  if e.authors.length() > 0 {
    let arr : Array[json5::Json5Value] = []
    let mut ai = 0
    while ai < e.authors.length() { arr.push(person_to_json(e.authors[ai])); ai = ai + 1 }
    obj.push(("authors", json5::Json5Value::Array(arr)))
  }
  if e.categories.length() > 0 {
    let tags : Array[json5::Json5Value] = []
    let mut ci = 0
    while ci < e.categories.length() { tags.push(json5::Json5Value::Str(e.categories[ci].term)); ci = ci + 1 }
    obj.push(("tags", json5::Json5Value::Array(tags)))
  }
  match e.language { Some(l) => obj.push(("language", json5::Json5Value::Str(l))); None => () }
  let atts : Array[json5::Json5Value] = []
  let mut li = 0
  while li < e.links.length() {
    let lk = e.links[li]
    match lk.rel {
      Some(r) => {
        if r == "enclosure" {
          let aobj : Array[(String, json5::Json5Value)] = [
            ("url", json5::Json5Value::Str(lk.href)),
            ("mime_type", json5::Json5Value::Str(match lk.media_type { Some(mt) => mt; None => "application/octet-stream" })),
          ]
          match lk.title { Some(t) => aobj.push(("title", json5::Json5Value::Str(t))); None => () }
          match lk.length { Some(sz) => aobj.push(("size_in_bytes", json5::Json5Value::Number(sz.to_double()))); None => () }
          atts.push(json5::Json5Value::Object(aobj))
        }
      }
      None => ()
    }
    li = li + 1
  }
  if atts.length() > 0 { obj.push(("attachments", json5::Json5Value::Array(atts))) }
  json5::Json5Value::Object(obj)
}

///| Serialize a unified `Feed` into a valid JSON Feed 1.1 document.
pub fn to_json_feed(feed : Feed) -> Result[String, FeedError] {
  let root : Array[(String, json5::Json5Value)] = [
    ("version", json5::Json5Value::Str("https://jsonfeed.org/version/1.1")),
    ("title", json5::Json5Value::Str(match feed.title { Some(t) => t.value; None => "" })),
  ]
  match find_primary_link(feed.links) { Some(l) => root.push(("home_page_url", json5::Json5Value::Str(l.href))); None => () }
  match find_link_by_rel(feed.links, "self") { Some(l) => root.push(("feed_url", json5::Json5Value::Str(l.href))); None => () }
  match feed.description {
    Some(d) => root.push(("description", json5::Json5Value::Str(d.value)))
    None => match feed.subtitle { Some(s) => root.push(("description", json5::Json5Value::Str(s.value))); None => () }
  }
  match feed.logo { Some(lg) => root.push(("icon", json5::Json5Value::Str(lg.uri))); None => () }
  match feed.icon { Some(ic) => root.push(("favicon", json5::Json5Value::Str(ic.uri))); None => () }
  match feed.language { Some(l) => root.push(("language", json5::Json5Value::Str(l))); None => () }
  if feed.authors.length() > 0 {
    let arr : Array[json5::Json5Value] = []
    let mut i = 0
    while i < feed.authors.length() { arr.push(person_to_json(feed.authors[i])); i = i + 1 }
    root.push(("authors", json5::Json5Value::Array(arr)))
  }
  let items : Array[json5::Json5Value] = []
  let mut ei = 0
  while ei < feed.entries.length() {
    items.push(entry_to_json(feed.entries[ei], ei))
    ei = ei + 1
  }
  root.push(("items", json5::Json5Value::Array(items)))
  match json5::to_json_string(json5::Json5Value::Object(root)) {
    Ok(s) => Ok(s)
    Err(e) => Err(FeedError::new(FeedErrorKind::SerializationError, e.message))
  }
}
