///| RFC 3986 relative URL resolution for Atom `xml:base` and relative feed links.

///|
fn find_scheme_end(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  let c0 = s.code_unit_at(0)
  if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)) {
    return -1
  }
  let mut i = 1
  while i < n {
    let b = s.code_unit_at(i)
    if b == 58 {
      return i
    }
    let ok = (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    (b >= 48 && b <= 57) ||
    b == 43 ||
    b == 45 ||
    b == 46
    if !ok {
      return -1
    }
    i = i + 1
  }
  -1
}

///|
fn remove_dot_segments(path : String) -> String {
  let n = path.length()
  if n == 0 {
    return ""
  }
  let leading_slash = path.code_unit_at(0) == 47
  let trailing_slash = n > 0 && path.code_unit_at(n - 1) == 47
  let segs : Array[String] = []
  let mut i = 0
  let mut ends_with_dot = false
  while i < n {
    while i < n && path.code_unit_at(i) == 47 {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && path.code_unit_at(i) != 47 {
      i = i + 1
    }
    let seg = path.slice(start, i)
    if seg == "." {
      ends_with_dot = true
    } else if seg == ".." {
      if segs.length() > 0 {
        let _ = segs.pop()
      }
      ends_with_dot = true
    } else {
      segs.push(seg)
      ends_with_dot = false
    }
  }
  let sb = StringBuilder::with_capacity(n)
  if leading_slash {
    sb.write_byte((47).to_byte())
  }
  let mut k = 0
  while k < segs.length() {
    if k > 0 {
      sb.write_byte((47).to_byte())
    }
    sb.write_string(segs[k])
    k = k + 1
  }
  if (trailing_slash || ends_with_dot) && segs.length() > 0 {
    sb.write_byte((47).to_byte())
  }
  sb.to_string()
}

///|
fn split_path_query_frag(s : String) -> (String, String) {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 63 || b == 35 {
      return (s.slice(0, i), s.slice(i, n))
    }
    i = i + 1
  }
  (s, "")
}

///| Resolve a relative URL reference against a base URL per RFC 3986 (used for `xml:base`).
pub fn resolve_url(base : String, rel : String) -> String {
  if rel.length() == 0 {
    return base
  }
  if base.length() == 0 {
    return rel
  }
  // Absolute URI in rel
  if find_scheme_end(rel) >= 0 {
    return rel
  }
  let base_scheme_end = find_scheme_end(base)
  if base_scheme_end < 0 {
    return rel
  }
  let scheme = base.slice(0, base_scheme_end)
  // Scheme-relative //authority/path
  if rel.length() >= 2 && rel.code_unit_at(0) == 47 && rel.code_unit_at(1) == 47 {
    return scheme + ":" + rel
  }
  // Extract base authority and base path
  let bn = base.length()
  let mut pos = base_scheme_end + 1
  let mut has_auth = false
  let mut authority = ""
  if pos + 1 < bn && base.code_unit_at(pos) == 47 && base.code_unit_at(pos + 1) == 47 {
    has_auth = true
    pos = pos + 2
    let auth_start = pos
    while pos < bn {
      let b = base.code_unit_at(pos)
      if b == 47 || b == 63 || b == 35 {
        break
      }
      pos = pos + 1
    }
    authority = base.slice(auth_start, pos)
  }
  let mut base_path_end = pos
  while base_path_end < bn {
    let b = base.code_unit_at(base_path_end)
    if b == 63 || b == 35 {
      break
    }
    base_path_end = base_path_end + 1
  }
  let base_path = base.slice(pos, base_path_end)
  let prefix = if has_auth { scheme + "://" + authority } else { scheme + ":" }

  let r0 = rel.code_unit_at(0)
  if r0 == 35 {
    // Fragment-only
    let mut base_no_frag = bn
    let mut i = 0
    while i < bn {
      if base.code_unit_at(i) == 35 {
        base_no_frag = i
        break
      }
      i = i + 1
    }
    return base.slice(0, base_no_frag) + rel
  }
  if r0 == 63 {
    // Query-only
    return prefix + base_path + rel
  }
  let (rel_path, rel_suffix) = split_path_query_frag(rel)
  let merged_path = if r0 == 47 {
    remove_dot_segments(rel_path)
  } else {
    // Find last '/' in base_path
    let mut last_slash = -1
    let mut j = base_path.length() - 1
    while j >= 0 {
      if base_path.code_unit_at(j) == 47 {
        last_slash = j
        break
      }
      j = j - 1
    }
    let dir = if last_slash >= 0 {
      base_path.slice(0, last_slash + 1)
    } else if has_auth {
      "/"
    } else {
      ""
    }
    remove_dot_segments(dir + rel_path)
  }
  prefix + merged_path + rel_suffix
}
