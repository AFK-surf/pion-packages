///| Atom 1.0 (RFC 4287) parser with full text/html/xhtml constructs and `xml:base` inheritance.

import "xml"
import "time"

///|
fn parse_atom_text_construct(
  node : xml::Node,
  base_url : String,
  limits : FeedLimits,
) -> Result[TextContent, FeedError] {
  let elem_base = get_xml_base(node, base_url)
  let lang = get_xml_lang(node)
  let type_attr = match node.attribute("type") {
    Some(t) => to_lower_ascii(trim_ws(t))
    None => "text"
  }
  let src = match node.attribute("src") {
    Some(s) => Some(resolve_url(elem_base, trim_ws(s)))
    None => None
  }
  if type_attr == "xhtml" {
    let text_val = match serialize_xhtml_children(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(TextContent::{ content_type: TextType::Xhtml, value: text_val, src: src, lang: lang })
  }
  let text_val = match node_full_text(node, limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let ct = if type_attr == "html" || type_attr == "text/html" {
    TextType::Html
  } else {
    TextType::Text
  }
  Ok(TextContent::{ content_type: ct, value: text_val, src: src, lang: lang })
}

///|
fn parse_atom_person(
  node : xml::Node,
  base_url : String,
  limits : FeedLimits,
) -> Result[Person, FeedError] {
  let p_base = get_xml_base(node, base_url)
  let mut name = ""
  let mut uri : Option[String] = None
  let mut email : Option[String] = None
  let mut cur = node.first_element_child()
  while true {
    let ch = match cur {
      Some(v) => v
      None => break
    }
    let local = ch.tag_name().local
    if local == "name" {
      name = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
    } else if local == "uri" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 { uri = Some(resolve_url(p_base, t)) }
    } else if local == "email" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 { email = Some(t) }
    }
    cur = ch.next_sibling_element()
  }
  Ok(Person::{ name: name, uri: uri, email: email, avatar: None })
}

///|
fn apply_atom_entry_child(
  eb : EntryBuilder,
  ch : xml::Node,
  entry_base : String,
  limits : FeedLimits,
) -> Result[Unit, FeedError] {
  let local = ch.tag_name().local
  if is_media_elem(ch) {
    if local == "group" {
      match parse_media_group_elem(ch, limits) {
        Ok(mg) => eb.media.push(mg)
        Err(e) => return Err(e)
      }
    } else if local == "content" {
      eb.standalone_mc.push(parse_media_content_elem(ch))
    } else if local == "thumbnail" {
      match parse_media_thumbnail_elem(ch) {
        Some(th) => eb.standalone_mt.push(th)
        None => ()
      }
    }
    return Ok(())
  }
  if is_itunes_elem(ch) {
    eb.itunes = match apply_itunes_elem(ch, eb.itunes, limits) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    return Ok(())
  }
  if local == "id" {
    eb.id = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
  } else if local == "title" {
    let tc = match parse_atom_text_construct(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.title = Some(tc)
  } else if local == "summary" {
    let tc = match parse_atom_text_construct(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.summary = Some(tc)
  } else if local == "content" {
    let tc = match parse_atom_text_construct(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.content = Some(tc)
  } else if local == "rights" {
    let tc = match parse_atom_text_construct(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.rights = Some(tc)
  } else if local == "updated" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    match parse_feed_date(t) { Ok(ts) => eb.updated = Some(ts); Err(_) => () }
  } else if local == "published" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    match parse_feed_date(t) { Ok(ts) => eb.published = Some(ts); Err(_) => () }
  } else if local == "author" {
    let p = match parse_atom_person(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.authors.push(p)
  } else if local == "contributor" {
    let p = match parse_atom_person(ch, entry_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    eb.contributors.push(p)
  } else if local == "link" {
    let link_base = get_xml_base(ch, entry_base)
    match parse_atom_link_elem(ch, link_base) {
      Some(lk) => {
        if eb.links.length() >= limits.max_links_per_entry {
          return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
        }
        eb.links.push(lk)
      }
      None => ()
    }
  } else if local == "category" {
    match ch.attribute("term") {
      Some(term) => eb.categories.push(Category::{ term: term, scheme: ch.attribute("scheme"), label: ch.attribute("label") })
      None => ()
    }
  } else if local == "source" {
    let mut sc = ch.first_element_child()
    while true {
      let sub = match sc { Some(v) => v; None => break }
      if sub.tag_name().local == "id" {
        let sid = match node_full_text(sub, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
        if sid.length() > 0 { eb.source = Some(sid) }
        break
      }
      sc = sub.next_sibling_element()
    }
  }
  Ok(())
}

///|
fn parse_atom_entry(
  node : xml::Node,
  feed_base : String,
  limits : FeedLimits,
) -> Result[Entry, FeedError] {
  let entry_base = get_xml_base(node, feed_base)
  let eb = EntryBuilder::new("", get_xml_lang(node))
  let mut cur = node.first_element_child()
  while true {
    let ch = match cur { Some(v) => v; None => break }
    match apply_atom_entry_child(eb, ch, entry_base, limits) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    cur = ch.next_sibling_element()
  }
  Ok(eb.build())
}

///|
fn apply_atom_feed_child(
  fb : FeedBuilder,
  ch : xml::Node,
  feed_base : String,
  limits : FeedLimits,
) -> Result[Unit, FeedError] {
  let local = ch.tag_name().local
  if is_itunes_elem(ch) {
    fb.itunes = match apply_itunes_elem(ch, fb.itunes, limits) { Ok(m) => m; Err(e) => return Err(e) }
    return Ok(())
  }
  if local == "id" {
    fb.id = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
  } else if local == "title" {
    let tc = match parse_atom_text_construct(ch, feed_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    fb.title = Some(tc)
  } else if local == "subtitle" {
    let tc = match parse_atom_text_construct(ch, feed_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    fb.subtitle = Some(tc)
  } else if local == "rights" {
    let tc = match parse_atom_text_construct(ch, feed_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    fb.rights = Some(tc)
  } else if local == "updated" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    match parse_feed_date(t) { Ok(ts) => fb.updated = Some(ts); Err(_) => () }
  } else if local == "author" {
    let p = match parse_atom_person(ch, feed_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    fb.authors.push(p)
  } else if local == "contributor" {
    let p = match parse_atom_person(ch, feed_base, limits) { Ok(v) => v; Err(e) => return Err(e) }
    fb.contributors.push(p)
  } else if local == "link" {
    let link_base = get_xml_base(ch, feed_base)
    match parse_atom_link_elem(ch, link_base) { Some(lk) => fb.links.push(lk); None => () }
  } else if local == "category" {
    match ch.attribute("term") {
      Some(term) => fb.categories.push(Category::{ term: term, scheme: ch.attribute("scheme"), label: ch.attribute("label") })
      None => ()
    }
  } else if local == "generator" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    let g_uri = match ch.attribute("uri") { Some(u) => Some(resolve_url(feed_base, trim_ws(u))); None => None }
    fb.generator = Some(Generator::{ content: t, uri: g_uri, version: ch.attribute("version") })
  } else if local == "icon" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.icon = Some(Image::new(resolve_url(feed_base, t))) }
  } else if local == "logo" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.logo = Some(Image::new(resolve_url(feed_base, t))) }
  } else if local == "entry" {
    if fb.entries.length() >= limits.max_entries {
      return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry count exceeds max_entries"))
    }
    match parse_atom_entry(ch, feed_base, limits) {
      Ok(e) => fb.entries.push(e)
      Err(err) => return Err(err)
    }
  }
  Ok(())
}

///|
fn parse_atom_doc(
  doc : xml::Document,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  let root = doc.root_element()
  let feed_base = get_xml_base(root, "")
  let fb = FeedBuilder::new("", get_xml_lang(root))
  let mut cur = root.first_element_child()
  while true {
    let ch = match cur { Some(v) => v; None => break }
    match apply_atom_feed_child(fb, ch, feed_base, limits) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    cur = ch.next_sibling_element()
  }
  let base_opt = if feed_base.length() > 0 { Some(feed_base) } else { None }
  Ok(
    Feed::{
      format: FeedFormat::Atom,
      id: fb.id,
      title: fb.title,
      subtitle: fb.subtitle,
      description: fb.subtitle,
      updated: fb.updated,
      published: None,
      authors: fb.authors,
      contributors: fb.contributors,
      links: fb.links,
      categories: fb.categories,
      generator: fb.generator,
      icon: fb.icon,
      logo: fb.logo,
      rights: fb.rights,
      language: fb.language,
      ttl: None,
      base_url: base_opt,
      itunes: fb.itunes,
      entries: fb.entries,
    },
  )
}
