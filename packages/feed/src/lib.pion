///| Pure-Pion unified syndication feed parser and generator (RSS 2.0, RSS 1.0/RDF, Atom 1.0, JSON Feed 1.1).

import "time"

///| Detect the syndication format of `input` without performing a full parse.
pub fn detect_format(input : String) -> Result[FeedFormat, FeedError] {
  let _ = input
  Err(FeedError::new(FeedErrorKind::Unimplemented, "detect_format not implemented"))
}

///| Parse a syndication feed (RSS 2.0, RSS 1.0/RDF, Atom 1.0, or JSON Feed 1.0/1.1) using default limits.
pub fn parse(input : String) -> Result[Feed, FeedError] {
  parse_with_limits(input, FeedLimits::default())
}

///| Parse a syndication feed with explicit DoS limits.
pub fn parse_with_limits(
  input : String,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  let _ = input
  let _ = limits
  Err(FeedError::new(FeedErrorKind::Unimplemented, "parse_with_limits not implemented"))
}

///| Parse a syndication feed from raw UTF-8 `Bytes` using default limits.
pub fn parse_bytes(input : Bytes) -> Result[Feed, FeedError] {
  parse_bytes_with_limits(input, FeedLimits::default())
}

///| Parse a syndication feed from raw UTF-8 `Bytes` with explicit DoS limits.
pub fn parse_bytes_with_limits(
  input : Bytes,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  let _ = input
  let _ = limits
  Err(FeedError::new(FeedErrorKind::Unimplemented, "parse_bytes_with_limits not implemented"))
}

///| Parse an RFC 3339, ISO 8601, RFC 2822, RFC 822, or common real-world feed date into `time::Timestamp`.
pub fn parse_feed_date(input : String) -> Result[time::Timestamp, FeedError] {
  let _ = input
  Err(FeedError::new(FeedErrorKind::Unimplemented, "parse_feed_date not implemented"))
}

///| Resolve a relative URL reference against a base URL per RFC 3986 (used for `xml:base`).
pub fn resolve_url(base : String, rel : String) -> String {
  let _ = base
  rel
}

///| Serialize a unified `Feed` into a well-formed RSS 2.0 XML document.
pub fn to_rss2(feed : Feed) -> Result[String, FeedError] {
  let _ = feed
  Err(FeedError::new(FeedErrorKind::Unimplemented, "to_rss2 not implemented"))
}

///| Serialize a unified `Feed` into a well-formed Atom 1.0 (RFC 4287) XML document.
pub fn to_atom(feed : Feed) -> Result[String, FeedError] {
  let _ = feed
  Err(FeedError::new(FeedErrorKind::Unimplemented, "to_atom not implemented"))
}

///| Serialize a unified `Feed` into a valid JSON Feed 1.1 document.
pub fn to_json_feed(feed : Feed) -> Result[String, FeedError] {
  let _ = feed
  Err(FeedError::new(FeedErrorKind::Unimplemented, "to_json_feed not implemented"))
}
