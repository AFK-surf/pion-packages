///| Pure-Pion unified syndication feed parser and generator (RSS 2.0, RSS 1.0/RDF, Atom 1.0, JSON Feed 1.1).

import "xml"
import "time"

///| Skip leading UTF-8 BOM, whitespace, XML declarations, PIs, and comments to inspect root token.
fn skip_xml_prolog_to_root(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && is_ascii_ws(s.code_unit_at(i)) {
      i = i + 1
    }
    if i >= n {
      return n
    }
    if s.code_unit_at(i) != 60 {
      return i
    }
    // Check <? ... ?>
    if i + 1 < n && s.code_unit_at(i + 1) == 63 {
      i = i + 2
      while i + 1 < n {
        if s.code_unit_at(i) == 63 && s.code_unit_at(i + 1) == 62 {
          i = i + 2
          break
        }
        i = i + 1
      }
      continue
    }
    // Check <!-- ... -->
    if i + 3 < n &&
    s.code_unit_at(i + 1) == 33 &&
    s.code_unit_at(i + 2) == 45 &&
    s.code_unit_at(i + 3) == 45 {
      i = i + 4
      while i + 2 < n {
        if s.code_unit_at(i) == 45 &&
        s.code_unit_at(i + 1) == 45 &&
        s.code_unit_at(i + 2) == 62 {
          i = i + 3
          break
        }
        i = i + 1
      }
      continue
    }
    return i
  }
  n
}

///| Extract the local name of the XML root tag starting at `pos` (where `s[pos] == '<'`).
fn peek_xml_root_local_name(s : String, pos : Int) -> String {
  let n = s.length()
  let mut i = pos + 1
  let start = i
  let mut colon = -1
  while i < n {
    let b = s.code_unit_at(i)
    if is_ascii_ws(b) || b == 62 || b == 47 {
      break
    }
    if b == 58 {
      colon = i
    }
    i = i + 1
  }
  if colon >= 0 && colon + 1 <= i {
    s.slice(colon + 1, i)
  } else {
    s.slice(start, i)
  }
}

///| Detect the syndication format of `input` without performing a full parse.
pub fn detect_format(input : String) -> Result[FeedFormat, FeedError] {
  let s = strip_bom_str(input)
  let n = s.length()
  let mut i = 0
  while i < n && is_ascii_ws(s.code_unit_at(i)) {
    i = i + 1
  }
  if i >= n {
    return Err(FeedError::new(FeedErrorKind::EmptyInput, "empty feed input"))
  }
  let c0 = s.code_unit_at(i)
  if c0 == 123 {
    // '{' -> JSON Feed
    if s.contains("jsonfeed.org/version/") {
      return Ok(FeedFormat::JsonFeed)
    }
    return Err(FeedError::new(FeedErrorKind::UnknownFormat, "JSON object is not a JSON Feed"))
  }
  if c0 == 60 {
    let root_pos = skip_xml_prolog_to_root(s)
    if root_pos >= n || s.code_unit_at(root_pos) != 60 {
      return Err(FeedError::new(FeedErrorKind::UnknownFormat, "no XML root element found"))
    }
    let local = to_lower_ascii(peek_xml_root_local_name(s, root_pos))
    if local == "rss" {
      return Ok(FeedFormat::Rss2)
    } else if local == "rdf" {
      return Ok(FeedFormat::Rss1)
    } else if local == "feed" {
      return Ok(FeedFormat::Atom)
    }
    return Err(FeedError::new(FeedErrorKind::UnknownFormat, "unrecognized XML root element: " + local))
  }
  Err(FeedError::new(FeedErrorKind::UnknownFormat, "input is neither XML nor JSON Feed"))
}

///| Parse a syndication feed (RSS 2.0, RSS 1.0/RDF, Atom 1.0, or JSON Feed 1.0/1.1) using default limits.
pub fn parse(input : String) -> Result[Feed, FeedError] {
  parse_with_limits(input, FeedLimits::default())
}

///| Parse a syndication feed with explicit DoS limits.
pub fn parse_with_limits(
  input : String,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  if input.length() > limits.max_bytes {
    return Err(
      FeedError::new(
        FeedErrorKind::LimitExceeded,
        "input size " + input.length().to_string() + " exceeds max_bytes",
      ),
    )
  }
  let s = strip_bom_str(input)
  let n = s.length()
  let mut i = 0
  while i < n && is_ascii_ws(s.code_unit_at(i)) {
    i = i + 1
  }
  if i >= n {
    return Err(FeedError::new(FeedErrorKind::EmptyInput, "empty feed input"))
  }
  let c0 = s.code_unit_at(i)
  if c0 == 123 {
    return parse_json_feed(s, limits)
  }
  if c0 != 60 {
    return Err(FeedError::new(FeedErrorKind::UnknownFormat, "input is neither XML nor JSON Feed"))
  }

  let def_xml_limits = xml::Limits::default()
  let xml_opts = xml::ParseOptions::{
    allow_dtd: false,
    limits: xml::Limits::{
      max_depth: limits.max_depth,
      max_nodes: def_xml_limits.max_nodes,
      max_attributes: def_xml_limits.max_attributes,
      max_entity_expansions: def_xml_limits.max_entity_expansions,
      max_entity_bytes: def_xml_limits.max_entity_bytes,
    },
  }
  let doc = match xml::Document::parse_with_options(s, xml_opts) {
    Ok(d) => d
    Err(e) => {
      match e.kind {
        xml::XmlErrorKind::LimitExceeded =>
        return Err(FeedError::new(FeedErrorKind::LimitExceeded, e.to_string()))
        _ => return Err(FeedError::new(FeedErrorKind::XmlError, e.to_string()))
      }
    }
  }
  let root = doc.root_element()
  let local = to_lower_ascii(root.tag_name().local)
  if local == "rss" {
    parse_rss_doc(doc, false, limits)
  } else if local == "rdf" {
    parse_rss_doc(doc, true, limits)
  } else if local == "feed" {
    parse_atom_doc(doc, limits)
  } else {
    Err(FeedError::new(FeedErrorKind::UnknownFormat, "unrecognized XML root element: " + local))
  }
}

///| Parse a syndication feed from raw UTF-8 `Bytes` using default limits.
pub fn parse_bytes(input : Bytes) -> Result[Feed, FeedError] {
  parse_bytes_with_limits(input, FeedLimits::default())
}

///| Parse a syndication feed from raw UTF-8 `Bytes` with explicit DoS limits.
pub fn parse_bytes_with_limits(
  input : Bytes,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  if input.length() > limits.max_bytes {
    return Err(
      FeedError::new(
        FeedErrorKind::LimitExceeded,
        "input size " + input.length().to_string() + " exceeds max_bytes",
      ),
    )
  }
  parse_with_limits(input.to_string(), limits)
}
