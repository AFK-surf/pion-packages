///| RSS 2.0 (including 0.91/0.92 compatibility) and RSS 1.0 (RDF) parser,
///| with full support for `content:encoded`, `dc:*`, `media:*`, `itunes:*`, and `atom:link`.

import "xml"
import "time"

///|
struct EntryBuilder {
  mut id : String
  mut has_explicit_guid : Bool
  mut id_is_permalink : Option[Bool]
  mut title : Option[TextContent]
  mut updated : Option[time::Timestamp]
  mut published : Option[time::Timestamp]
  authors : Array[Person]
  contributors : Array[Person]
  links : Array[Link]
  mut summary : Option[TextContent]
  mut content : Option[TextContent]
  categories : Array[Category]
  mut rights : Option[TextContent]
  mut source : Option[String]
  mut comments_url : Option[String]
  mut language : Option[String]
  media : Array[MediaObject]
  standalone_mc : Array[MediaContent]
  standalone_mt : Array[MediaThumbnail]
  mut standalone_mtitle : Option[String]
  mut standalone_mdesc : Option[String]
  mut itunes : Option[ItunesMeta]
}

///|
fn EntryBuilder::new(id : String, lang : Option[String]) -> EntryBuilder {
  EntryBuilder::{
    id: id,
    has_explicit_guid: false,
    id_is_permalink: None,
    title: None,
    updated: None,
    published: None,
    authors: [],
    contributors: [],
    links: [],
    summary: None,
    content: None,
    categories: [],
    rights: None,
    source: None,
    comments_url: None,
    language: lang,
    media: [],
    standalone_mc: [],
    standalone_mt: [],
    standalone_mtitle: None,
    standalone_mdesc: None,
    itunes: None,
  }
}

///|
fn EntryBuilder::build(self : EntryBuilder) -> Entry {
  if self.standalone_mc.length() > 0 || self.standalone_mt.length() > 0 {
    self.media.push(
      MediaObject::{
        title: self.standalone_mtitle,
        description: self.standalone_mdesc,
        content: self.standalone_mc,
        thumbnails: self.standalone_mt,
      },
    )
  }
  let final_id = if self.id.length() == 0 && self.links.length() > 0 {
    self.links[0].href
  } else {
    self.id
  }
  Entry::{
    id: final_id,
    id_is_permalink: self.id_is_permalink,
    title: self.title,
    updated: self.updated,
    published: self.published,
    authors: self.authors,
    contributors: self.contributors,
    links: self.links,
    summary: self.summary,
    content: self.content,
    categories: self.categories,
    rights: self.rights,
    source: self.source,
    comments_url: self.comments_url,
    language: self.language,
    image: None,
    banner_image: None,
    external_url: None,
    media: self.media,
    itunes: self.itunes,
  }
}

///|
struct FeedBuilder {
  mut id : String
  mut title : Option[TextContent]
  mut subtitle : Option[TextContent]
  mut description : Option[TextContent]
  mut updated : Option[time::Timestamp]
  mut published : Option[time::Timestamp]
  authors : Array[Person]
  contributors : Array[Person]
  links : Array[Link]
  categories : Array[Category]
  mut generator : Option[Generator]
  mut icon : Option[Image]
  mut logo : Option[Image]
  mut rights : Option[TextContent]
  mut language : Option[String]
  mut ttl : Option[Int]
  mut itunes : Option[ItunesMeta]
  entries : Array[Entry]
}

///|
fn FeedBuilder::new(id : String, lang : Option[String]) -> FeedBuilder {
  FeedBuilder::{
    id: id,
    title: None,
    subtitle: None,
    description: None,
    updated: None,
    published: None,
    authors: [],
    contributors: [],
    links: [],
    categories: [],
    generator: None,
    icon: None,
    logo: None,
    rights: None,
    language: lang,
    ttl: None,
    itunes: None,
    entries: [],
  }
}

///|
fn parse_media_content_elem(node : xml::Node) -> MediaContent {
  let url = node.attribute("url")
  let content_type = node.attribute("type")
  let length = match node.attribute("fileSize") {
    Some(s) => parse_i64_trimmed(s)
    None => None
  }
  let width = match node.attribute("width") {
    Some(s) => parse_int_trimmed(s)
    None => None
  }
  let height = match node.attribute("height") {
    Some(s) => parse_int_trimmed(s)
    None => None
  }
  let duration = match node.attribute("duration") {
    Some(s) => parse_i64_trimmed(s)
    None => None
  }
  let medium = node.attribute("medium")
  MediaContent::{
    url: url,
    content_type: content_type,
    length: length,
    width: width,
    height: height,
    duration: duration,
    medium: medium,
  }
}

///|
fn parse_media_thumbnail_elem(node : xml::Node) -> Option[MediaThumbnail] {
  match node.attribute("url") {
    Some(u) => {
      let w = match node.attribute("width") {
        Some(s) => parse_int_trimmed(s)
        None => None
      }
      let h = match node.attribute("height") {
        Some(s) => parse_int_trimmed(s)
        None => None
      }
      Some(MediaThumbnail::{ url: u, width: w, height: h })
    }
    None => None
  }
}

///|
fn parse_media_group_elem(
  node : xml::Node,
  limits : FeedLimits,
) -> Result[MediaObject, FeedError] {
  let mut title : Option[String] = None
  let mut description : Option[String] = None
  let content : Array[MediaContent] = []
  let thumbnails : Array[MediaThumbnail] = []
  let mut cur = node.first_element_child()
  while true {
    let ch = match cur {
      Some(v) => v
      None => break
    }
    if is_media_elem(ch) {
      let local = ch.tag_name().local
      if local == "title" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        title = Some(t)
      } else if local == "description" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        description = Some(t)
      } else if local == "content" {
        content.push(parse_media_content_elem(ch))
      } else if local == "thumbnail" {
        match parse_media_thumbnail_elem(ch) {
          Some(th) => thumbnails.push(th)
          None => ()
        }
      }
    }
    cur = ch.next_sibling_element()
  }
  Ok(
    MediaObject::{
      title: title,
      description: description,
      content: content,
      thumbnails: thumbnails,
    },
  )
}

///|
fn apply_itunes_elem(
  node : xml::Node,
  meta : Option[ItunesMeta],
  limits : FeedLimits,
) -> Result[Option[ItunesMeta], FeedError] {
  let local = node.tag_name().local
  let cur = match meta {
    Some(m) => m
    None => ItunesMeta::empty()
  }
  if local == "author" {
    let t = match node_full_text(node, limits) {
      Ok(s) => trim_ws(s)
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: Some(t), duration: cur.duration, explicit: cur.explicit, image: cur.image, episode: cur.episode, season: cur.season, summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "duration" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: parse_itunes_duration(t), explicit: cur.explicit, image: cur.image, episode: cur.episode, season: cur.season, summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "explicit" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: parse_itunes_explicit(t), image: cur.image, episode: cur.episode, season: cur.season, summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "image" {
    let href = match node.attribute("href") {
      Some(h) => Some(trim_ws(h))
      None => {
        let t = match node_full_text(node, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        if t.length() > 0 { Some(t) } else { None }
      }
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: cur.explicit, image: href, episode: cur.episode, season: cur.season, summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "episode" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: cur.explicit, image: cur.image, episode: parse_int_trimmed(t), season: cur.season, summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "season" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: cur.explicit, image: cur.image, episode: cur.episode, season: parse_int_trimmed(t), summary: cur.summary, subtitle: cur.subtitle }))
  } else if local == "summary" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: cur.explicit, image: cur.image, episode: cur.episode, season: cur.season, summary: Some(t), subtitle: cur.subtitle }))
  } else if local == "subtitle" {
    let t = match node_full_text(node, limits) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(Some(ItunesMeta::{ author: cur.author, duration: cur.duration, explicit: cur.explicit, image: cur.image, episode: cur.episode, season: cur.season, summary: cur.summary, subtitle: Some(t) }))
  }
  Ok(meta)
}

///|
fn parse_atom_link_elem(node : xml::Node, base_url : String) -> Option[Link] {
  match node.attribute("href") {
    Some(h) => {
      let href = resolve_url(base_url, trim_ws(h))
      let length = match node.attribute("length") {
        Some(s) => parse_i64_trimmed(s)
        None => None
      }
      Some(
        Link::{
          href: href,
          rel: node.attribute("rel"),
          media_type: node.attribute("type"),
          href_lang: node.attribute("hreflang"),
          title: node.attribute("title"),
          length: length,
        },
      )
    }
    None => None
  }
}

///|
fn parse_rss_image_elem(
  node : xml::Node,
  limits : FeedLimits,
) -> Result[Option[Image], FeedError] {
  let mut uri = ""
  let mut title : Option[String] = None
  let mut link : Option[String] = None
  let mut width : Option[Int] = None
  let mut height : Option[Int] = None
  let mut description : Option[String] = None
  let mut cur = node.first_element_child()
  while true {
    let ch = match cur {
      Some(v) => v
      None => break
    }
    let local = ch.tag_name().local
    if local == "url" {
      uri = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
    } else if local == "title" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      title = Some(t)
    } else if local == "link" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      link = Some(t)
    } else if local == "width" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      width = parse_int_trimmed(t)
    } else if local == "height" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      height = parse_int_trimmed(t)
    } else if local == "description" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      description = Some(t)
    }
    cur = ch.next_sibling_element()
  }
  if uri.length() == 0 {
    match node.attribute_ns(ns_rdf, "about") {
      Some(a) => uri = trim_ws(a)
      None => ()
    }
  }
  if uri.length() == 0 {
    return Ok(None)
  }
  Ok(Some(Image::{ uri: uri, title: title, link: link, width: width, height: height, description: description }))
}

///|
fn apply_rss_item_ext(
  eb : EntryBuilder,
  ch : xml::Node,
  item_base : String,
  limits : FeedLimits,
) -> Result[Bool, FeedError] {
  let local = ch.tag_name().local
  if is_content_elem(ch) {
    if local == "encoded" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      eb.content = Some(TextContent::html(t))
    }
    return Ok(true)
  }
  if is_dc_elem(ch) {
    if local == "creator" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 { eb.authors.push(parse_rss_person(t)) }
    } else if local == "date" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match parse_feed_date(t) {
        Ok(ts) => { if eb.published is None { eb.published = Some(ts) } }
        Err(_) => ()
      }
    } else if local == "subject" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 { eb.categories.push(Category::new(t)) }
    } else if local == "rights" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      eb.rights = Some(TextContent::plain(t))
    } else if local == "identifier" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 && !eb.has_explicit_guid { eb.id = t }
    } else if local == "language" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => trim_ws(s)
        Err(e) => return Err(e)
      }
      if t.length() > 0 { eb.language = Some(t) }
    }
    return Ok(true)
  }
  if is_media_elem(ch) {
    if local == "group" {
      match parse_media_group_elem(ch, limits) {
        Ok(mg) => eb.media.push(mg)
        Err(e) => return Err(e)
      }
    } else if local == "content" {
      eb.standalone_mc.push(parse_media_content_elem(ch))
    } else if local == "thumbnail" {
      match parse_media_thumbnail_elem(ch) {
        Some(th) => eb.standalone_mt.push(th)
        None => ()
      }
    } else if local == "title" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      eb.standalone_mtitle = Some(t)
    } else if local == "description" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      eb.standalone_mdesc = Some(t)
    }
    return Ok(true)
  }
  if is_itunes_elem(ch) {
    eb.itunes = match apply_itunes_elem(ch, eb.itunes, limits) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    return Ok(true)
  }
  if is_atom_elem(ch) {
    if local == "link" {
      match parse_atom_link_elem(ch, item_base) {
        Some(lk) => {
          if eb.links.length() >= limits.max_links_per_entry {
            return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
          }
          eb.links.push(lk)
        }
        None => ()
      }
    } else if local == "updated" {
      let t = match node_full_text(ch, limits) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match parse_feed_date(t) {
        Ok(ts) => eb.updated = Some(ts)
        Err(_) => ()
      }
    }
    return Ok(true)
  }
  Ok(false)
}

///|
fn parse_rss_item(
  node : xml::Node,
  base_url : String,
  limits : FeedLimits,
) -> Result[Entry, FeedError] {
  let item_base = get_xml_base(node, base_url)
  let init_id = match node.attribute_ns(ns_rdf, "about") {
    Some(a) => trim_ws(a)
    None => ""
  }
  let eb = EntryBuilder::new(init_id, get_xml_lang(node))

  let mut cur = node.first_element_child()
  while true {
    let ch = match cur {
      Some(v) => v
      None => break
    }
    let handled = match apply_rss_item_ext(eb, ch, item_base, limits) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if !handled {
      let local = ch.tag_name().local
      if local == "title" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        eb.title = Some(TextContent::plain(t))
      } else if local == "link" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        if t.length() > 0 {
          if eb.links.length() >= limits.max_links_per_entry {
            return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
          }
          eb.links.push(Link::{ href: resolve_url(item_base, t), rel: Some("alternate"), media_type: None, href_lang: None, title: None, length: None })
        }
      } else if local == "description" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        eb.summary = Some(TextContent::plain(t))
      } else if local == "guid" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        eb.id = t
        eb.has_explicit_guid = true
        eb.id_is_permalink = match ch.attribute("isPermaLink") {
          Some(v) => Some(to_lower_ascii(trim_ws(v)) != "false")
          None => Some(true)
        }
      } else if local == "pubDate" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        match parse_feed_date(t) {
          Ok(ts) => eb.published = Some(ts)
          Err(_) => ()
        }
      } else if local == "author" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        if t.length() > 0 { eb.authors.push(parse_rss_person(t)) }
      } else if local == "category" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        if t.length() > 0 {
          eb.categories.push(Category::{ term: t, scheme: ch.attribute("domain"), label: None })
        }
      } else if local == "comments" {
        let t = match node_full_text(ch, limits) {
          Ok(s) => trim_ws(s)
          Err(e) => return Err(e)
        }
        if t.length() > 0 { eb.comments_url = Some(resolve_url(item_base, t)) }
      } else if local == "source" {
        match ch.attribute("url") {
          Some(u) => eb.source = Some(trim_ws(u))
          None => {
            let t = match node_full_text(ch, limits) {
              Ok(s) => trim_ws(s)
              Err(e) => return Err(e)
            }
            if t.length() > 0 { eb.source = Some(t) }
          }
        }
      } else if local == "enclosure" {
        match ch.attribute("url") {
          Some(u) => {
            if eb.links.length() >= limits.max_links_per_entry {
              return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
            }
            let len = match ch.attribute("length") {
              Some(s) => parse_i64_trimmed(s)
              None => None
            }
            eb.links.push(Link::{ href: resolve_url(item_base, trim_ws(u)), rel: Some("enclosure"), media_type: ch.attribute("type"), href_lang: None, title: None, length: len })
          }
          None => ()
        }
      }
    }
    cur = ch.next_sibling_element()
  }

  Ok(eb.build())
}

///|
fn apply_rss_channel_child(
  fb : FeedBuilder,
  ch : xml::Node,
  ch_base : String,
  limits : FeedLimits,
) -> Result[Unit, FeedError] {
  let local = ch.tag_name().local
  if is_atom_elem(ch) {
    if local == "link" {
      match parse_atom_link_elem(ch, ch_base) {
        Some(lk) => fb.links.push(lk)
        None => ()
      }
    }
    return Ok(())
  }
  if is_itunes_elem(ch) {
    fb.itunes = match apply_itunes_elem(ch, fb.itunes, limits) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    return Ok(())
  }
  if is_dc_elem(ch) {
    if local == "language" {
      let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
      if t.length() > 0 { fb.language = Some(t) }
    } else if local == "date" {
      let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
      match parse_feed_date(t) {
        Ok(ts) => { if fb.updated is None { fb.updated = Some(ts) } }
        Err(_) => ()
      }
    } else if local == "rights" {
      let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
      fb.rights = Some(TextContent::plain(t))
    } else if local == "creator" {
      let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
      if t.length() > 0 { fb.authors.push(parse_rss_person(t)) }
    }
    return Ok(())
  }
  if local == "title" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    fb.title = Some(TextContent::plain(t))
  } else if local == "link" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 {
      fb.links.push(Link::{ href: resolve_url(ch_base, t), rel: Some("alternate"), media_type: None, href_lang: None, title: None, length: None })
    }
  } else if local == "description" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    fb.description = Some(TextContent::plain(t))
  } else if local == "language" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.language = Some(t) }
  } else if local == "copyright" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    fb.rights = Some(TextContent::plain(t))
  } else if local == "managingEditor" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.authors.push(parse_rss_person(t)) }
  } else if local == "webMaster" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.contributors.push(parse_rss_person(t)) }
  } else if local == "pubDate" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    match parse_feed_date(t) { Ok(ts) => fb.published = Some(ts); Err(_) => () }
  } else if local == "lastBuildDate" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    match parse_feed_date(t) { Ok(ts) => fb.updated = Some(ts); Err(_) => () }
  } else if local == "generator" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.generator = Some(Generator::new(t)) }
  } else if local == "ttl" {
    let t = match node_full_text(ch, limits) { Ok(s) => s; Err(e) => return Err(e) }
    fb.ttl = parse_int_trimmed(t)
  } else if local == "category" {
    let t = match node_full_text(ch, limits) { Ok(s) => trim_ws(s); Err(e) => return Err(e) }
    if t.length() > 0 { fb.categories.push(Category::{ term: t, scheme: ch.attribute("domain"), label: None }) }
  } else if local == "image" {
    match parse_rss_image_elem(ch, limits) { Ok(img) => fb.logo = img; Err(e) => return Err(e) }
  } else if local == "item" {
    if fb.entries.length() >= limits.max_entries {
      return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry count exceeds max_entries"))
    }
    match parse_rss_item(ch, ch_base, limits) {
      Ok(e) => fb.entries.push(e)
      Err(err) => return Err(err)
    }
  }
  Ok(())
}

///|
fn parse_rss_doc(
  doc : xml::Document,
  is_rdf : Bool,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  let root = doc.root_element()
  let root_base = get_xml_base(root, "")
  let mut channel_opt : Option[xml::Node] = None
  let mut rdf_image : Option[Image] = None
  let rdf_items : Array[xml::Node] = []

  let mut cur = root.first_element_child()
  while true {
    let ch = match cur {
      Some(v) => v
      None => break
    }
    let local = ch.tag_name().local
    if local == "channel" {
      channel_opt = Some(ch)
      if !is_rdf { break }
    } else if is_rdf && local == "image" {
      match parse_rss_image_elem(ch, limits) {
        Ok(img) => rdf_image = img
        Err(e) => return Err(e)
      }
    } else if is_rdf && local == "item" {
      rdf_items.push(ch)
    }
    cur = ch.next_sibling_element()
  }

  let channel = match channel_opt {
    Some(c) => c
    None => return Err(FeedError::new(FeedErrorKind::InvalidStructure, "RSS document missing <channel> element"))
  }

  let ch_base = get_xml_base(channel, root_base)
  let init_id = match channel.attribute_ns(ns_rdf, "about") {
    Some(a) => trim_ws(a)
    None => ""
  }
  let fb = FeedBuilder::new(init_id, get_xml_lang(channel))
  fb.logo = rdf_image

  let mut c2 = channel.first_element_child()
  while true {
    let ch = match c2 {
      Some(v) => v
      None => break
    }
    match apply_rss_channel_child(fb, ch, ch_base, limits) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    c2 = ch.next_sibling_element()
  }

  if is_rdf {
    let mut ri = 0
    while ri < rdf_items.length() {
      if fb.entries.length() >= limits.max_entries {
        return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry count exceeds max_entries"))
      }
      match parse_rss_item(rdf_items[ri], ch_base, limits) {
        Ok(e) => fb.entries.push(e)
        Err(err) => return Err(err)
      }
      ri = ri + 1
    }
  }

  let final_id = if fb.id.length() == 0 && fb.links.length() > 0 { fb.links[0].href } else { fb.id }
  let base_opt = if ch_base.length() > 0 { Some(ch_base) } else { None }
  Ok(
    Feed::{
      format: if is_rdf { FeedFormat::Rss1 } else { FeedFormat::Rss2 },
      id: final_id,
      title: fb.title,
      subtitle: None,
      description: fb.description,
      updated: fb.updated,
      published: fb.published,
      authors: fb.authors,
      contributors: fb.contributors,
      links: fb.links,
      categories: fb.categories,
      generator: fb.generator,
      icon: None,
      logo: fb.logo,
      rights: fb.rights,
      language: fb.language,
      ttl: fb.ttl,
      base_url: base_opt,
      itunes: fb.itunes,
      entries: fb.entries,
    },
  )
}
