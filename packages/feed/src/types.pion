///| Core unified syndication feed data model, errors, and DoS limits for `packages/feed`.

import "time"

///| Detected or target syndication feed format.
pub enum FeedFormat {
  Rss2
  Rss1
  Atom
  JsonFeed
}

///|
pub fn FeedFormat::eq(self : FeedFormat, other : FeedFormat) -> Bool {
  match (self, other) {
    (FeedFormat::Rss2, FeedFormat::Rss2) => true
    (FeedFormat::Rss1, FeedFormat::Rss1) => true
    (FeedFormat::Atom, FeedFormat::Atom) => true
    (FeedFormat::JsonFeed, FeedFormat::JsonFeed) => true
    _ => false
  }
}

///|
pub fn FeedFormat::to_string(self : FeedFormat) -> String {
  match self {
    FeedFormat::Rss2 => "rss2"
    FeedFormat::Rss1 => "rss1"
    FeedFormat::Atom => "atom"
    FeedFormat::JsonFeed => "json_feed"
  }
}

///| Categories of feed parsing, detection, and serialization errors.
pub enum FeedErrorKind {
  EmptyInput
  UnknownFormat
  XmlError
  JsonError
  InvalidStructure
  InvalidDate
  LimitExceeded
  SerializationError
  Unimplemented
}

///|
pub fn FeedErrorKind::eq(self : FeedErrorKind, other : FeedErrorKind) -> Bool {
  match (self, other) {
    (FeedErrorKind::EmptyInput, FeedErrorKind::EmptyInput) => true
    (FeedErrorKind::UnknownFormat, FeedErrorKind::UnknownFormat) => true
    (FeedErrorKind::XmlError, FeedErrorKind::XmlError) => true
    (FeedErrorKind::JsonError, FeedErrorKind::JsonError) => true
    (FeedErrorKind::InvalidStructure, FeedErrorKind::InvalidStructure) => true
    (FeedErrorKind::InvalidDate, FeedErrorKind::InvalidDate) => true
    (FeedErrorKind::LimitExceeded, FeedErrorKind::LimitExceeded) => true
    (FeedErrorKind::SerializationError, FeedErrorKind::SerializationError) => true
    (FeedErrorKind::Unimplemented, FeedErrorKind::Unimplemented) => true
    _ => false
  }
}

///| Structured error returned by feed parsing and serialization APIs.
pub struct FeedError {
  pub kind : FeedErrorKind
  pub message : String
}

///|
pub fn FeedError::new(kind : FeedErrorKind, message : String) -> FeedError {
  FeedError::{ kind: kind, message: message }
}

///|
pub fn FeedError::to_string(self : FeedError) -> String {
  self.message
}

///| Explicit resource and DoS limits enforced during feed parsing.
pub struct FeedLimits {
  pub max_bytes : Int
  pub max_entries : Int
  pub max_depth : Int
  pub max_links_per_entry : Int
  pub max_text_bytes : Int
}

///|
pub fn FeedLimits::default() -> FeedLimits {
  FeedLimits::{
    max_bytes: 16777216,
    max_entries: 10000,
    max_depth: 64,
    max_links_per_entry: 64,
    max_text_bytes: 4194304,
  }
}

///| Content representation type for text constructs (`text`, `html`, `xhtml`).
pub enum TextType {
  Text
  Html
  Xhtml
}

///|
pub fn TextType::eq(self : TextType, other : TextType) -> Bool {
  match (self, other) {
    (TextType::Text, TextType::Text) => true
    (TextType::Html, TextType::Html) => true
    (TextType::Xhtml, TextType::Xhtml) => true
    _ => false
  }
}

///|
pub fn TextType::to_string(self : TextType) -> String {
  match self {
    TextType::Text => "text"
    TextType::Html => "html"
    TextType::Xhtml => "xhtml"
  }
}

///| Text or markup construct (Atom text/content, RSS title/description/content:encoded, JSON Feed content).
pub struct TextContent {
  pub content_type : TextType
  pub value : String
  pub src : Option[String]
  pub lang : Option[String]
}

///|
pub fn TextContent::plain(value : String) -> TextContent {
  TextContent::{ content_type: TextType::Text, value: value, src: None, lang: None }
}

///|
pub fn TextContent::html(value : String) -> TextContent {
  TextContent::{ content_type: TextType::Html, value: value, src: None, lang: None }
}

///|
pub fn TextContent::xhtml(value : String) -> TextContent {
  TextContent::{ content_type: TextType::Xhtml, value: value, src: None, lang: None }
}

///| Author or contributor person construct.
pub struct Person {
  pub name : String
  pub uri : Option[String]
  pub email : Option[String]
  pub avatar : Option[String]
}

///|
pub fn Person::new(name : String) -> Person {
  Person::{ name: name, uri: None, email: None, avatar: None }
}

///| Hyperlink or enclosure/attachment reference.
pub struct Link {
  pub href : String
  pub rel : Option[String]
  pub media_type : Option[String]
  pub href_lang : Option[String]
  pub title : Option[String]
  pub length : Option[Int64]
}

///|
pub fn Link::new(href : String) -> Link {
  Link::{
    href: href,
    rel: None,
    media_type: None,
    href_lang: None,
    title: None,
    length: None,
  }
}

///| Category or tag metadata.
pub struct Category {
  pub term : String
  pub scheme : Option[String]
  pub label : Option[String]
}

///|
pub fn Category::new(term : String) -> Category {
  Category::{ term: term, scheme: None, label: None }
}

///| Feed icon, logo, or RSS channel image.
pub struct Image {
  pub uri : String
  pub title : Option[String]
  pub link : Option[String]
  pub width : Option[Int]
  pub height : Option[Int]
  pub description : Option[String]
}

///|
pub fn Image::new(uri : String) -> Image {
  Image::{
    uri: uri,
    title: None,
    link: None,
    width: None,
    height: None,
    description: None,
  }
}

///| Feed generator metadata.
pub struct Generator {
  pub content : String
  pub uri : Option[String]
  pub version : Option[String]
}

///|
pub fn Generator::new(content : String) -> Generator {
  Generator::{ content: content, uri: None, version: None }
}

///| Media RSS thumbnail (`media:thumbnail`).
pub struct MediaThumbnail {
  pub url : String
  pub width : Option[Int]
  pub height : Option[Int]
}

///| Media RSS content item (`media:content`).
pub struct MediaContent {
  pub url : Option[String]
  pub content_type : Option[String]
  pub length : Option[Int64]
  pub width : Option[Int]
  pub height : Option[Int]
  pub duration : Option[Int64]
  pub medium : Option[String]
}

///| Media RSS group or standalone media object (`media:group` / `media:*`).
pub struct MediaObject {
  pub title : Option[String]
  pub description : Option[String]
  pub content : Array[MediaContent]
  pub thumbnails : Array[MediaThumbnail]
}

///| iTunes Podcast extension metadata (`itunes:*`).
pub struct ItunesMeta {
  pub author : Option[String]
  pub duration : Option[Int64]
  pub explicit : Option[Bool]
  pub image : Option[String]
  pub episode : Option[Int]
  pub season : Option[Int]
  pub summary : Option[String]
  pub subtitle : Option[String]
}

///|
pub fn ItunesMeta::empty() -> ItunesMeta {
  ItunesMeta::{
    author: None,
    duration: None,
    explicit: None,
    image: None,
    episode: None,
    season: None,
    summary: None,
    subtitle: None,
  }
}

///| Unified feed entry / item (Atom `<entry>`, RSS `<item>`, JSON Feed `items[]`).
pub struct Entry {
  pub id : String
  pub id_is_permalink : Option[Bool]
  pub title : Option[TextContent]
  pub updated : Option[time::Timestamp]
  pub published : Option[time::Timestamp]
  pub authors : Array[Person]
  pub contributors : Array[Person]
  pub links : Array[Link]
  pub summary : Option[TextContent]
  pub content : Option[TextContent]
  pub categories : Array[Category]
  pub rights : Option[TextContent]
  pub source : Option[String]
  pub comments_url : Option[String]
  pub language : Option[String]
  pub image : Option[String]
  pub banner_image : Option[String]
  pub external_url : Option[String]
  pub media : Array[MediaObject]
  pub itunes : Option[ItunesMeta]
}

///|
pub fn Entry::new(id : String) -> Entry {
  Entry::{
    id: id,
    id_is_permalink: None,
    title: None,
    updated: None,
    published: None,
    authors: [],
    contributors: [],
    links: [],
    summary: None,
    content: None,
    categories: [],
    rights: None,
    source: None,
    comments_url: None,
    language: None,
    image: None,
    banner_image: None,
    external_url: None,
    media: [],
    itunes: None,
  }
}

///| Unified syndication feed (RSS 2.0, RSS 1.0/RDF, Atom 1.0, JSON Feed 1.0/1.1).
pub struct Feed {
  pub format : FeedFormat
  pub id : String
  pub title : Option[TextContent]
  pub subtitle : Option[TextContent]
  pub description : Option[TextContent]
  pub updated : Option[time::Timestamp]
  pub published : Option[time::Timestamp]
  pub authors : Array[Person]
  pub contributors : Array[Person]
  pub links : Array[Link]
  pub categories : Array[Category]
  pub generator : Option[Generator]
  pub icon : Option[Image]
  pub logo : Option[Image]
  pub rights : Option[TextContent]
  pub language : Option[String]
  pub ttl : Option[Int]
  pub base_url : Option[String]
  pub itunes : Option[ItunesMeta]
  pub entries : Array[Entry]
}

///|
pub fn Feed::new(id : String) -> Feed {
  Feed::{
    format: FeedFormat::Atom,
    id: id,
    title: None,
    subtitle: None,
    description: None,
    updated: None,
    published: None,
    authors: [],
    contributors: [],
    links: [],
    categories: [],
    generator: None,
    icon: None,
    logo: None,
    rights: None,
    language: None,
    ttl: None,
    base_url: None,
    itunes: None,
    entries: [],
  }
}
