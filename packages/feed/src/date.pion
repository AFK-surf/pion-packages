///| Robust syndication feed date parser (RFC 3339, ISO 8601, RFC 2822/822, and real-world dirty dates).

import "time"

///|
fn is_ascii_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///|
fn ascii_lower_byte(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///|
fn trim_date_str(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && is_ascii_ws(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_ascii_ws(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

///|
fn parse_uint_slice(s : String, start : Int, end : Int) -> Option[Int] {
  if start >= end || end - start > 9 {
    return None
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if !is_ascii_digit(b) {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

///|
fn parse_tz_offset_str(tok : String) -> Option[Int] {
  let n = tok.length()
  if n == 0 {
    return None
  }
  let b0 = tok.code_unit_at(0)
  // Numeric offset: +HHMM, -HHMM, +HH:MM, -HH:MM, +HH, -HH
  if b0 == 43 || b0 == 45 {
    let sign = if b0 == 45 { -1 } else { 1 }
    if n == 5 &&
    is_ascii_digit(tok.code_unit_at(1)) &&
    is_ascii_digit(tok.code_unit_at(2)) &&
    is_ascii_digit(tok.code_unit_at(3)) &&
    is_ascii_digit(tok.code_unit_at(4)) {
      let hh = (tok.code_unit_at(1) - 48) * 10 + (tok.code_unit_at(2) - 48)
      let mm = (tok.code_unit_at(3) - 48) * 10 + (tok.code_unit_at(4) - 48)
      if hh <= 23 && mm <= 59 {
        return Some(sign * (hh * 3600 + mm * 60))
      }
      return None
    }
    if n == 6 &&
    tok.code_unit_at(3) == 58 &&
    is_ascii_digit(tok.code_unit_at(1)) &&
    is_ascii_digit(tok.code_unit_at(2)) &&
    is_ascii_digit(tok.code_unit_at(4)) &&
    is_ascii_digit(tok.code_unit_at(5)) {
      let hh = (tok.code_unit_at(1) - 48) * 10 + (tok.code_unit_at(2) - 48)
      let mm = (tok.code_unit_at(4) - 48) * 10 + (tok.code_unit_at(5) - 48)
      if hh <= 23 && mm <= 59 {
        return Some(sign * (hh * 3600 + mm * 60))
      }
      return None
    }
    if n == 3 &&
    is_ascii_digit(tok.code_unit_at(1)) &&
    is_ascii_digit(tok.code_unit_at(2)) {
      let hh = (tok.code_unit_at(1) - 48) * 10 + (tok.code_unit_at(2) - 48)
      if hh <= 23 {
        return Some(sign * hh * 3600)
      }
      return None
    }
    return None
  }
  // Named timezone abbreviations (case-insensitive)
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = tok.code_unit_at(i)
    if b >= 97 && b <= 122 {
      sb.write_byte((b - 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  let u = sb.to_string()
  if u == "Z" || u == "GMT" || u == "UTC" || u == "UT" || u == "WET" {
    Some(0)
  } else if u == "EST" || u == "CDT" {
    Some(-18000)
  } else if u == "EDT" || u == "AST" {
    Some(-14400)
  } else if u == "CST" || u == "MDT" {
    Some(-21600)
  } else if u == "MST" || u == "PDT" {
    Some(-25200)
  } else if u == "PST" {
    Some(-28800)
  } else if u == "AKST" {
    Some(-32400)
  } else if u == "AKDT" {
    Some(-28800)
  } else if u == "HST" {
    Some(-36000)
  } else if u == "BST" || u == "WEST" || u == "CET" {
    Some(3600)
  } else if u == "CEST" || u == "EET" {
    Some(7200)
  } else if u == "EEST" || u == "MSK" {
    Some(10800)
  } else if u == "IST" {
    Some(19800)
  } else if u == "JST" || u == "KST" {
    Some(32400)
  } else if u == "AEST" {
    Some(36000)
  } else if u == "AEDT" {
    Some(39600)
  } else if u == "NZST" {
    Some(43200)
  } else if u == "NZDT" {
    Some(46800)
  } else {
    None
  }
}

///|
fn parse_month_name(tok : String) -> Option[Int] {
  let n = tok.length()
  if n < 3 {
    return None
  }
  let c0 = ascii_lower_byte(tok.code_unit_at(0))
  let c1 = ascii_lower_byte(tok.code_unit_at(1))
  let c2 = ascii_lower_byte(tok.code_unit_at(2))
  if c0 == 106 && c1 == 97 && c2 == 110 {
    // jan
    Some(1)
  } else if c0 == 102 && c1 == 101 && c2 == 98 {
    // feb
    Some(2)
  } else if c0 == 109 && c1 == 97 && c2 == 114 {
    // mar
    Some(3)
  } else if c0 == 97 && c1 == 112 && c2 == 114 {
    // apr
    Some(4)
  } else if c0 == 109 && c1 == 97 && c2 == 121 {
    // may
    Some(5)
  } else if c0 == 106 && c1 == 117 && c2 == 110 {
    // jun
    Some(6)
  } else if c0 == 106 && c1 == 117 && c2 == 108 {
    // jul
    Some(7)
  } else if c0 == 97 && c1 == 117 && c2 == 103 {
    // aug
    Some(8)
  } else if c0 == 115 && c1 == 101 && c2 == 112 {
    // sep
    Some(9)
  } else if c0 == 111 && c1 == 99 && c2 == 116 {
    // oct
    Some(10)
  } else if c0 == 110 && c1 == 111 && c2 == 118 {
    // nov
    Some(11)
  } else if c0 == 100 && c1 == 101 && c2 == 99 {
    // dec
    Some(12)
  } else {
    None
  }
}

///|
fn build_timestamp(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
  nanos : Int,
  offset_secs : Int,
) -> Result[time::Timestamp, FeedError] {
  let d = match time::Date::new(year, month, day) {
    Ok(v) => v
    Err(e) => return Err(FeedError::new(FeedErrorKind::InvalidDate, e.message))
  }
  let sec_clamped = if second == 60 { 59 } else { second }
  let t = match time::Time::new(hour, minute, sec_clamped, nanos) {
    Ok(v) => v
    Err(e) => return Err(FeedError::new(FeedErrorKind::InvalidDate, e.message))
  }
  let dt = time::DateTime::{ date: d, time: t }
  let off = match time::Offset::from_seconds(offset_secs) {
    Ok(v) => v
    Err(e) => return Err(FeedError::new(FeedErrorKind::InvalidDate, e.message))
  }
  match off.to_timestamp(dt) {
    Ok(ts) => Ok(ts)
    Err(e) => Err(FeedError::new(FeedErrorKind::InvalidDate, e.message))
  }
}

///|
fn parse_iso8601_flexible(s : String) -> Option[time::Timestamp] {
  let n = s.length()
  if n < 10 {
    return None
  }
  if s.code_unit_at(4) != 45 || s.code_unit_at(7) != 45 {
    return None
  }
  let year = match parse_uint_slice(s, 0, 4) {
    Some(v) => v
    None => return None
  }
  let month = match parse_uint_slice(s, 5, 7) {
    Some(v) => v
    None => return None
  }
  let day = match parse_uint_slice(s, 8, 10) {
    Some(v) => v
    None => return None
  }
  if n == 10 {
    return match build_timestamp(year, month, day, 0, 0, 0, 0, 0) {
      Ok(ts) => Some(ts)
      Err(_) => None
    }
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 && sep != 32 {
    return None
  }
  let mut pos = 11
  while pos < n && s.code_unit_at(pos) == 32 {
    pos = pos + 1
  }
  if pos + 5 > n || s.code_unit_at(pos + 2) != 58 {
    return None
  }
  let hour = match parse_uint_slice(s, pos, pos + 2) {
    Some(v) => v
    None => return None
  }
  let minute = match parse_uint_slice(s, pos + 3, pos + 5) {
    Some(v) => v
    None => return None
  }
  pos = pos + 5
  let mut second = 0
  let mut nanos = 0
  if pos < n && s.code_unit_at(pos) == 58 {
    if pos + 3 > n {
      return None
    }
    second = match parse_uint_slice(s, pos + 1, pos + 3) {
      Some(v) => v
      None => return None
    }
    pos = pos + 3
    if pos < n && (s.code_unit_at(pos) == 46 || s.code_unit_at(pos) == 44) {
      pos = pos + 1
      let frac_start = pos
      let mut scale = 100000000
      while pos < n && is_ascii_digit(s.code_unit_at(pos)) {
        if scale > 0 {
          nanos = nanos + (s.code_unit_at(pos) - 48) * scale
          scale = scale / 10
        }
        pos = pos + 1
      }
      if pos == frac_start {
        return None
      }
    }
  }
  while pos < n && s.code_unit_at(pos) == 32 {
    pos = pos + 1
  }
  let mut offset_secs = 0
  if pos < n {
    let tz_str = s.slice(pos, n)
    match parse_tz_offset_str(tz_str) {
      Some(o) => offset_secs = o
      None => return None
    }
  }
  match build_timestamp(year, month, day, hour, minute, second, nanos, offset_secs) {
    Ok(ts) => Some(ts)
    Err(_) => None
  }
}

///|
fn parse_hms_token(tok : String) -> Option[(Int, Int, Int)] {
  let n = tok.length()
  let mut c1 = -1
  let mut c2 = -1
  let mut i = 0
  while i < n {
    if tok.code_unit_at(i) == 58 {
      if c1 < 0 {
        c1 = i
      } else if c2 < 0 {
        c2 = i
      } else {
        return None
      }
    }
    i = i + 1
  }
  if c1 < 1 {
    return None
  }
  let h = match parse_uint_slice(tok, 0, c1) {
    Some(v) => v
    None => return None
  }
  if c2 < 0 {
    let m = match parse_uint_slice(tok, c1 + 1, n) {
      Some(v) => v
      None => return None
    }
    return Some((h, m, 0))
  }
  let m = match parse_uint_slice(tok, c1 + 1, c2) {
    Some(v) => v
    None => return None
  }
  // Allow optional fractional seconds after '.'
  let mut sec_end = n
  let mut j = c2 + 1
  while j < n {
    if tok.code_unit_at(j) == 46 {
      sec_end = j
      break
    }
    j = j + 1
  }
  let sec = match parse_uint_slice(tok, c2 + 1, sec_end) {
    Some(v) => v
    None => return None
  }
  Some((h, m, sec))
}

///|
fn tokenize_rfc2822_dirty(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  let mut paren_depth = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 40 {
      paren_depth = paren_depth + 1
      i = i + 1
      continue
    }
    if b == 41 {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
      i = i + 1
      continue
    }
    if paren_depth > 0 || is_ascii_ws(b) || b == 44 {
      i = i + 1
      continue
    }
    let start = i
    while i < n {
      let c = s.code_unit_at(i)
      if is_ascii_ws(c) || c == 44 || c == 40 || c == 41 {
        break
      }
      i = i + 1
    }
    if i > start {
      out.push(s.slice(start, i))
    }
  }
  out
}

///|
fn parse_rfc2822_flexible(s : String) -> Option[time::Timestamp] {
  let toks = tokenize_rfc2822_dirty(s)
  let n = toks.length()
  if n < 3 {
    return None
  }
  let mut idx = 0
  // Skip optional leading weekday (any alpha token whose first char is alpha and is not a month)
  if idx < n && is_ascii_alpha(toks[idx].code_unit_at(0)) {
    match parse_month_name(toks[idx]) {
      Some(_) => ()
      None => idx = idx + 1
    }
  }
  if idx + 2 >= n {
    return None
  }
  // Support both "DD Mon YYYY ..." and "Mon DD YYYY ..."
  let mut day = 0
  let mut month = 0
  match parse_month_name(toks[idx]) {
    Some(m) => {
      month = m
      day = match parse_uint_slice(toks[idx + 1], 0, toks[idx + 1].length()) {
        Some(v) => v
        None => return None
      }
    }
    None => {
      day = match parse_uint_slice(toks[idx], 0, toks[idx].length()) {
        Some(v) => v
        None => return None
      }
      month = match parse_month_name(toks[idx + 1]) {
        Some(m) => m
        None => return None
      }
    }
  }
  let year_tok = toks[idx + 2]
  let raw_year = match parse_uint_slice(year_tok, 0, year_tok.length()) {
    Some(v) => v
    None => return None
  }
  let year = if year_tok.length() == 2 {
    if raw_year >= 50 {
      1900 + raw_year
    } else {
      2000 + raw_year
    }
  } else {
    raw_year
  }
  idx = idx + 3
  let mut hour = 0
  let mut minute = 0
  let mut second = 0
  if idx < n {
    match parse_hms_token(toks[idx]) {
      Some(hms) => {
        let (h, m, sec) = hms
        hour = h
        minute = m
        second = sec
        idx = idx + 1
      }
      None => ()
    }
  }
  let mut offset_secs = 0
  if idx < n {
    match parse_tz_offset_str(toks[idx]) {
      Some(o) => offset_secs = o
      None => return None
    }
  }
  match build_timestamp(year, month, day, hour, minute, second, 0, offset_secs) {
    Ok(ts) => Some(ts)
    Err(_) => None
  }
}

///| Parse an RFC 3339, ISO 8601, RFC 2822, RFC 822, or common real-world feed date into `time::Timestamp`.
pub fn parse_feed_date(input : String) -> Result[time::Timestamp, FeedError] {
  let s = trim_date_str(input)
  let n = s.length()
  if n == 0 {
    return Err(FeedError::new(FeedErrorKind::InvalidDate, "empty date string"))
  }
  // Fast path: starts with YYYY-
  if n >= 10 && is_ascii_digit(s.code_unit_at(0)) && s.code_unit_at(4) == 45 {
    match time::Timestamp::parse_rfc3339(s) {
      Ok(ts) => return Ok(ts)
      Err(_) => ()
    }
    match parse_iso8601_flexible(s) {
      Some(ts) => return Ok(ts)
      None => ()
    }
  }
  // Fast path: strict RFC 2822
  match time::Timestamp::parse_rfc2822(s) {
    Ok(ts) => return Ok(ts)
    Err(_) => ()
  }
  // Flexible RFC 2822 / RFC 822 / real-world dirty dates
  match parse_rfc2822_flexible(s) {
    Some(ts) => Ok(ts)
    None => Err(FeedError::new(FeedErrorKind::InvalidDate, "unrecognized feed date: " + s))
  }
}
