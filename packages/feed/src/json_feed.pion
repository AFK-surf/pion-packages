///| JSON Feed 1.0 and 1.1 parser backed by `packages/json5`.

import "json5"
import "time"

///|
fn jf_get_str(
  obj : json5::Json5Value,
  key : String,
  limits : FeedLimits,
) -> Result[Option[String], FeedError] {
  match json5::get(obj, key) {
    Some(v) => {
      match json5::as_str(v) {
        Some(s) => {
          match check_text_limit(s, limits) {
            Ok(ok) => Ok(Some(ok))
            Err(e) => Err(e)
          }
        }
        None => Ok(None)
      }
    }
    None => Ok(None)
  }
}

///|
fn jf_parse_author(
  v : json5::Json5Value,
  limits : FeedLimits,
) -> Result[Option[Person], FeedError] {
  let name = match jf_get_str(v, "name", limits) {
    Ok(Some(s)) => s
    Ok(None) => ""
    Err(e) => return Err(e)
  }
  let url = match jf_get_str(v, "url", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let avatar = match jf_get_str(v, "avatar", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  if name.length() == 0 && url is None && avatar is None {
    return Ok(None)
  }
  Ok(Some(Person::{ name: name, uri: url, email: None, avatar: avatar }))
}

///|
fn jf_parse_authors(
  obj : json5::Json5Value,
  limits : FeedLimits,
) -> Result[Array[Person], FeedError] {
  let out : Array[Person] = []
  match json5::get(obj, "authors") {
    Some(arr_v) => {
      match json5::as_array(arr_v) {
        Some(items) => {
          let mut i = 0
          while i < items.length() {
            match jf_parse_author(items[i], limits) {
              Ok(Some(p)) => out.push(p)
              Ok(None) => ()
              Err(e) => return Err(e)
            }
            i = i + 1
          }
        }
        None => ()
      }
    }
    None => ()
  }
  if out.length() == 0 {
    match json5::get(obj, "author") {
      Some(av) => {
        match jf_parse_author(av, limits) {
          Ok(Some(p)) => out.push(p)
          Ok(None) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
  }
  Ok(out)
}

///|
fn jf_parse_tags(
  it : json5::Json5Value,
  limits : FeedLimits,
) -> Result[Array[Category], FeedError] {
  let categories : Array[Category] = []
  match json5::get(it, "tags") {
    Some(tv) => {
      match json5::as_array(tv) {
        Some(tags) => {
          let mut ti = 0
          while ti < tags.length() {
            match json5::as_str(tags[ti]) {
              Some(ts) => {
                match check_text_limit(ts, limits) {
                  Ok(ok) => categories.push(Category::new(ok))
                  Err(e) => return Err(e)
                }
              }
              None => ()
            }
            ti = ti + 1
          }
        }
        None => ()
      }
    }
    None => ()
  }
  Ok(categories)
}

///|
fn jf_parse_item_links(
  it : json5::Json5Value,
  item_url : Option[String],
  limits : FeedLimits,
) -> Result[Array[Link], FeedError] {
  let item_links : Array[Link] = []
  match item_url {
    Some(u) => item_links.push(Link::{ href: u, rel: Some("alternate"), media_type: None, href_lang: None, title: None, length: None })
    None => ()
  }
  match json5::get(it, "attachments") {
    Some(av) => {
      match json5::as_array(av) {
        Some(atts) => {
          let mut ai = 0
          while ai < atts.length() {
            let a = atts[ai]
            match jf_get_str(a, "url", limits) {
              Ok(Some(au)) => {
                if item_links.length() >= limits.max_links_per_entry {
                  return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
                }
                let mime = match jf_get_str(a, "mime_type", limits) {
                  Ok(o) => o
                  Err(e) => return Err(e)
                }
                let atitle = match jf_get_str(a, "title", limits) {
                  Ok(o) => o
                  Err(e) => return Err(e)
                }
                let size = match json5::get(a, "size_in_bytes") {
                  Some(sv) => json5::as_int(sv)
                  None => None
                }
                item_links.push(
                  Link::{
                    href: au,
                    rel: Some("enclosure"),
                    media_type: mime,
                    href_lang: None,
                    title: atitle,
                    length: size,
                  },
                )
              }
              Ok(None) => ()
              Err(e) => return Err(e)
            }
            ai = ai + 1
          }
        }
        None => ()
      }
    }
    None => ()
  }
  if item_links.length() > limits.max_links_per_entry {
    return Err(FeedError::new(FeedErrorKind::LimitExceeded, "entry links exceed max_links_per_entry"))
  }
  Ok(item_links)
}

///|
fn jf_parse_date_field(
  it : json5::Json5Value,
  key : String,
  limits : FeedLimits,
) -> Result[Option[time::Timestamp], FeedError] {
  match jf_get_str(it, key, limits) {
    Ok(Some(ds)) => {
      match parse_feed_date(ds) {
        Ok(ts) => Ok(Some(ts))
        Err(_) => Ok(None)
      }
    }
    Ok(None) => Ok(None)
    Err(e) => Err(e)
  }
}

///|
fn jf_parse_item(
  it : json5::Json5Value,
  limits : FeedLimits,
) -> Result[Entry, FeedError] {
  let item_id = match jf_get_str(it, "id", limits) {
    Ok(Some(s)) => s
    Ok(None) => ""
    Err(e) => return Err(e)
  }
  let item_title = match jf_get_str(it, "title", limits) {
    Ok(Some(s)) => Some(TextContent::plain(s))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let item_summary = match jf_get_str(it, "summary", limits) {
    Ok(Some(s)) => Some(TextContent::plain(s))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let content = match jf_get_str(it, "content_html", limits) {
    Ok(Some(h)) => Some(TextContent::html(h))
    Ok(None) =>
    match jf_get_str(it, "content_text", limits) {
      Ok(Some(t)) => Some(TextContent::plain(t))
      Ok(None) => None
      Err(e) => return Err(e)
    }
    Err(e) => return Err(e)
  }
  let item_url = match jf_get_str(it, "url", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let external_url = match jf_get_str(it, "external_url", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let item_image = match jf_get_str(it, "image", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let banner_image = match jf_get_str(it, "banner_image", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let item_lang = match jf_get_str(it, "language", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let published = match jf_parse_date_field(it, "date_published", limits) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let updated = match jf_parse_date_field(it, "date_modified", limits) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let item_authors = match jf_parse_authors(it, limits) {
    Ok(a) => a
    Err(e) => return Err(e)
  }
  let categories = match jf_parse_tags(it, limits) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let item_links = match jf_parse_item_links(it, item_url, limits) {
    Ok(l) => l
    Err(e) => return Err(e)
  }
  Ok(
    Entry::{
      id: item_id,
      id_is_permalink: None,
      title: item_title,
      updated: updated,
      published: published,
      authors: item_authors,
      contributors: [],
      links: item_links,
      summary: item_summary,
      content: content,
      categories: categories,
      rights: None,
      source: None,
      comments_url: None,
      language: item_lang,
      image: item_image,
      banner_image: banner_image,
      external_url: external_url,
      media: [],
      itunes: None,
    },
  )
}

///|
fn parse_json_feed(
  src : String,
  limits : FeedLimits,
) -> Result[Feed, FeedError] {
  let base_opts = json5::ParseOptions::strict_json()
  let opts = json5::ParseOptions::{
    max_depth: limits.max_depth,
    max_nodes: base_opts.max_nodes,
    duplicate_keys: base_opts.duplicate_keys,
    allow_json5: false,
    allow_comments: false,
    allow_trailing_commas: false,
    reject_overflow: true,
  }
  let root = match json5::parse_with_options(src, opts) {
    Ok(v) => v
    Err(e) => {
      if e.message.contains("depth") || e.message.contains("limit") || e.message.contains("nodes") {
        return Err(FeedError::new(FeedErrorKind::LimitExceeded, e.message))
      }
      return Err(FeedError::new(FeedErrorKind::JsonError, e.message))
    }
  }
  let version = match jf_get_str(root, "version", limits) {
    Ok(Some(v)) => v
    Ok(None) => return Err(FeedError::new(FeedErrorKind::InvalidStructure, "JSON Feed missing version field"))
    Err(e) => return Err(e)
  }
  if !version.starts_with("https://jsonfeed.org/version/") &&
  !version.starts_with("http://jsonfeed.org/version/") {
    return Err(FeedError::new(FeedErrorKind::UnknownFormat, "unsupported JSON Feed version: " + version))
  }

  let title = match jf_get_str(root, "title", limits) {
    Ok(Some(s)) => Some(TextContent::plain(s))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let home_page_url = match jf_get_str(root, "home_page_url", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let feed_url = match jf_get_str(root, "feed_url", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let description = match jf_get_str(root, "description", limits) {
    Ok(Some(s)) => Some(TextContent::plain(s))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let language = match jf_get_str(root, "language", limits) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let logo = match jf_get_str(root, "icon", limits) {
    Ok(Some(u)) => Some(Image::new(u))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let icon = match jf_get_str(root, "favicon", limits) {
    Ok(Some(u)) => Some(Image::new(u))
    Ok(None) => None
    Err(e) => return Err(e)
  }
  let authors = match jf_parse_authors(root, limits) {
    Ok(a) => a
    Err(e) => return Err(e)
  }

  let links : Array[Link] = []
  match home_page_url {
    Some(u) => links.push(Link::{ href: u, rel: Some("alternate"), media_type: Some("text/html"), href_lang: None, title: None, length: None })
    None => ()
  }
  match feed_url {
    Some(u) => links.push(Link::{ href: u, rel: Some("self"), media_type: Some("application/feed+json"), href_lang: None, title: None, length: None })
    None => ()
  }

  let feed_id = match feed_url {
    Some(u) => u
    None =>
    match home_page_url {
      Some(u) => u
      None =>
      match title {
        Some(t) => t.value
        None => ""
      }
    }
  }

  let entries : Array[Entry] = []
  match json5::get(root, "items") {
    Some(items_v) => {
      match json5::as_array(items_v) {
        Some(items) => {
          if items.length() > limits.max_entries {
            return Err(FeedError::new(FeedErrorKind::LimitExceeded, "item count exceeds max_entries"))
          }
          let mut i = 0
          while i < items.length() {
            match jf_parse_item(items[i], limits) {
              Ok(e) => entries.push(e)
              Err(err) => return Err(err)
            }
            i = i + 1
          }
        }
        None => ()
      }
    }
    None => ()
  }

  Ok(
    Feed::{
      format: FeedFormat::JsonFeed,
      id: feed_id,
      title: title,
      subtitle: None,
      description: description,
      updated: None,
      published: None,
      authors: authors,
      contributors: [],
      links: links,
      categories: [],
      generator: None,
      icon: icon,
      logo: logo,
      rights: None,
      language: language,
      ttl: None,
      base_url: None,
      itunes: None,
      entries: entries,
    },
  )
}
