///| Robust feed date parsing, format detection, DoS limits, and 3-format serialization + roundtrip tests.

import "time"

///|
fn dls_assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn dls_assert_ts(input : String, expected_sec : Int64, label : String) -> Unit {
  match parse_feed_date(input) {
    Ok(ts) =>
    debug_assert(
      ts.as_second() == expected_sec,
      label +
      " (" +
      input +
      "): expected " +
      expected_sec.to_string() +
      ", got " +
      ts.as_second().to_string(),
    )
    Err(e) => debug_assert(false, label + " (" + input + ") failed: " + e.message)
  }
}

///|
test "date_parsing_rfc3339_rfc2822_and_realworld_dirty" {
  // 2026-11-23T12:00:00Z == 1795435200
  let target : Int64 = 1795435200L

  // RFC 3339 / ISO 8601 variants
  dls_assert_ts("2026-11-23T12:00:00Z", target, "rfc3339 Z")
  dls_assert_ts("2026-11-23t12:00:00z", target, "rfc3339 lowercase t/z")
  dls_assert_ts("2026-11-23T20:00:00+08:00", target, "rfc3339 +08:00")
  dls_assert_ts("2026-11-23T07:00:00-05:00", target, "rfc3339 -05:00")
  dls_assert_ts("2026-11-23T12:00:00.123456Z", target, "rfc3339 fractional")
  dls_assert_ts("2026-11-23 12:00:00Z", target, "iso8601 space separator")
  dls_assert_ts("2026-11-23T20:00:00+0800", target, "iso8601 compact offset")
  dls_assert_ts("2026-11-23", 1795392000L, "iso8601 date-only")

  // RFC 2822 / RFC 822 & timezone abbreviations
  dls_assert_ts("Mon, 23 Nov 2026 12:00:00 GMT", target, "rfc2822 GMT")
  dls_assert_ts("Mon, 23 Nov 2026 12:00:00 UTC", target, "rfc2822 UTC")
  dls_assert_ts("Mon, 23 Nov 2026 12:00:00 +0000", target, "rfc2822 +0000")
  dls_assert_ts("Mon, 23 Nov 2026 07:00:00 EST", target, "rfc2822 EST")
  dls_assert_ts("Mon, 23 Nov 2026 08:00:00 EDT", target, "rfc2822 EDT")
  dls_assert_ts("Mon, 23 Nov 2026 06:00:00 CST", target, "rfc2822 CST")
  dls_assert_ts("Mon, 23 Nov 2026 07:00:00 CDT", target, "rfc2822 CDT")
  dls_assert_ts("Mon, 23 Nov 2026 05:00:00 MST", target, "rfc2822 MST")
  dls_assert_ts("Mon, 23 Nov 2026 06:00:00 MDT", target, "rfc2822 MDT")
  dls_assert_ts("Mon, 23 Nov 2026 04:00:00 PST", target, "rfc2822 PST")
  dls_assert_ts("Mon, 23 Nov 2026 05:00:00 PDT", target, "rfc2822 PDT")

  // Real-world dirty dates: missing seconds, full weekday, wrong/misspelled weekday, 2-digit year, extra spaces
  dls_assert_ts("Monday, 23 Nov 2026 12:00 GMT", target, "full weekday + missing seconds")
  dls_assert_ts("Wed, 23 Nov 2026 12:00:00 +0000", target, "mismatched weekday tolerated")
  dls_assert_ts("23 Nov 26 12:00:00 GMT", target, "no weekday + 2-digit year 26 -> 2026")
  dls_assert_ts("Sun, 31 Dec 99 23:59:59 GMT", 946684799L, "2-digit year 99 -> 1999")
  dls_assert_ts("  Mon,   23  November  2026  12:00:00  GMT  ", target, "full month + extra spaces")

  // Invalid dates rejected
  match parse_feed_date("") {
    Ok(_) => debug_assert(false, "empty date must fail")
    Err(_) => ()
  }
  match parse_feed_date("not a date at all") {
    Ok(_) => debug_assert(false, "garbage date must fail")
    Err(_) => ()
  }
  match parse_feed_date("2026-13-45T99:99:99Z") {
    Ok(_) => debug_assert(false, "out-of-range date must fail")
    Err(_) => ()
  }
}

///|
test "detect_format_all_and_errors" {
  match detect_format("<?xml version=\"1.0\"?><!-- comment --><rss version=\"2.0\"><channel/></rss>") {
    Ok(f) => debug_assert(f.eq(FeedFormat::Rss2), "detect rss2")
    Err(e) => debug_assert(false, "detect rss2 failed: " + e.message)
  }
  match detect_format("<rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><channel/></rdf:RDF>") {
    Ok(f) => debug_assert(f.eq(FeedFormat::Rss1), "detect rss1")
    Err(e) => debug_assert(false, "detect rss1 failed: " + e.message)
  }
  match detect_format("\u{FEFF}\n  <feed xmlns=\"http://www.w3.org/2005/Atom\"/>") {
    Ok(f) => debug_assert(f.eq(FeedFormat::Atom), "detect atom")
    Err(e) => debug_assert(false, "detect atom failed: " + e.message)
  }
  match detect_format("  {\"version\": \"https://jsonfeed.org/version/1.1\", \"title\": \"x\"}") {
    Ok(f) => debug_assert(f.eq(FeedFormat::JsonFeed), "detect json feed")
    Err(e) => debug_assert(false, "detect json feed failed: " + e.message)
  }
  match detect_format("   \n\t ") {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::EmptyInput), "empty input error")
    Ok(_) => debug_assert(false, "empty input must fail")
  }
  match detect_format("<html><body>not a feed</body></html>") {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::UnknownFormat), "unknown format error")
    Ok(_) => debug_assert(false, "html must fail")
  }
}

///|
test "dos_limits_enforced" {
  // max_bytes
  let small_bytes = FeedLimits::{
    max_bytes: 32,
    max_entries: 100,
    max_depth: 32,
    max_links_per_entry: 16,
    max_text_bytes: 1024,
  }
  let rss = "<rss version=\"2.0\"><channel><title>T</title><link>https://x.test</link><description>D</description></channel></rss>"
  match parse_with_limits(rss, small_bytes) {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::LimitExceeded), "max_bytes limit")
    Ok(_) => debug_assert(false, "expected max_bytes LimitExceeded")
  }

  // max_entries
  let two_items = "<rss version=\"2.0\"><channel><title>T</title><link>https://x.test</link><description>D</description>" +
  "<item><title>1</title></item><item><title>2</title></item><item><title>3</title></item></channel></rss>"
  let lim_entries = FeedLimits::{
    max_bytes: 65536,
    max_entries: 2,
    max_depth: 32,
    max_links_per_entry: 16,
    max_text_bytes: 65536,
  }
  match parse_with_limits(two_items, lim_entries) {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::LimitExceeded), "max_entries limit")
    Ok(_) => debug_assert(false, "expected max_entries LimitExceeded")
  }

  // max_links_per_entry
  let many_links = "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><title>T</title><updated>2026-11-23T00:00:00Z</updated>" +
  "<entry><id>e1</id><title>E</title><updated>2026-11-23T00:00:00Z</updated>" +
  "<link href=\"https://a.test/1\"/><link href=\"https://a.test/2\"/><link href=\"https://a.test/3\"/></entry></feed>"
  let lim_links = FeedLimits::{
    max_bytes: 65536,
    max_entries: 10,
    max_depth: 32,
    max_links_per_entry: 2,
    max_text_bytes: 65536,
  }
  match parse_with_limits(many_links, lim_links) {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::LimitExceeded), "max_links_per_entry limit")
    Ok(_) => debug_assert(false, "expected max_links_per_entry LimitExceeded")
  }

  // max_text_bytes
  let big_text = "<feed xmlns=\"http://www.w3.org/2005/Atom\"><id>f</id><title>012345678901234567890123456789</title><updated>2026-11-23T00:00:00Z</updated></feed>"
  let lim_text = FeedLimits::{
    max_bytes: 65536,
    max_entries: 10,
    max_depth: 32,
    max_links_per_entry: 16,
    max_text_bytes: 16,
  }
  match parse_with_limits(big_text, lim_text) {
    Err(e) => debug_assert(e.kind.eq(FeedErrorKind::LimitExceeded), "max_text_bytes limit")
    Ok(_) => debug_assert(false, "expected max_text_bytes LimitExceeded")
  }
}

///|
test "serialize_rss2_atom_json_feed_and_roundtrip_escaping" {
  let ts = match time::Timestamp::from_second(1795435200L) {
    Ok(t) => t
    Err(_) => return ()
  }
  let entry = Entry::{
    id: "https://example.org/posts/1",
    id_is_permalink: Some(true),
    title: Some(TextContent::plain("Hello <World> & \"Quotes\" 'Single'")),
    updated: Some(ts),
    published: Some(ts),
    authors: [Person::{ name: "Alice & Bob", uri: Some("https://example.org/ab"), email: Some("ab@example.org"), avatar: None }],
    contributors: [],
    links: [
      Link::{ href: "https://example.org/posts/1?a=1&b=2", rel: Some("alternate"), media_type: Some("text/html"), href_lang: None, title: None, length: None },
      Link::{ href: "https://example.org/posts/1.mp3", rel: Some("enclosure"), media_type: Some("audio/mpeg"), href_lang: None, title: Some("Audio"), length: Some(4096L) },
    ],
    summary: Some(TextContent::plain("Summary with <tag> & ampersand")),
    content: Some(TextContent::html("<p>Body &amp; <b>bold</b></p>")),
    categories: [Category::{ term: "tech", scheme: Some("https://example.org/cat"), label: Some("Tech") }],
    rights: None,
    source: None,
    comments_url: None,
    language: Some("en"),
    image: None,
    banner_image: None,
    external_url: None,
    media: [],
    itunes: None,
  }
  let feed = Feed::{
    format: FeedFormat::Atom,
    id: "https://example.org/feed",
    title: Some(TextContent::plain("Pion & Friends <Blog>")),
    subtitle: Some(TextContent::plain("All about Pion")),
    description: Some(TextContent::plain("All about Pion")),
    updated: Some(ts),
    published: Some(ts),
    authors: [Person::new("Pion Team")],
    contributors: [],
    links: [
      Link::{ href: "https://example.org/", rel: Some("alternate"), media_type: Some("text/html"), href_lang: None, title: None, length: None },
      Link::{ href: "https://example.org/feed", rel: Some("self"), media_type: Some("application/atom+xml"), href_lang: None, title: None, length: None },
    ],
    categories: [Category::new("compilers")],
    generator: Some(Generator::{ content: "PionFeed", uri: Some("https://pion.dev"), version: Some("0.1.0") }),
    icon: None,
    logo: None,
    rights: Some(TextContent::plain("MIT")),
    language: Some("en"),
    ttl: Some(30),
    base_url: None,
    itunes: None,
    entries: [entry],
  }

  // 1. RSS 2.0 roundtrip
  let rss_xml = match to_rss2(feed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_rss2 failed: " + e.message)
      return ()
    }
  }
  let parsed_rss = match parse(rss_xml) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "roundtrip rss2 parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(parsed_rss.format.eq(FeedFormat::Rss2), "roundtrip rss2 format")
  match parsed_rss.title {
    Some(t) => dls_assert_str(t.value, "Pion & Friends <Blog>", "roundtrip rss2 title")
    None => debug_assert(false, "roundtrip rss2 title missing")
  }
  debug_assert(parsed_rss.entries.length() == 1, "roundtrip rss2 entries")
  match parsed_rss.entries[0].title {
    Some(t) => dls_assert_str(t.value, "Hello <World> & \"Quotes\" 'Single'", "roundtrip rss2 entry title")
    None => debug_assert(false, "roundtrip rss2 entry title missing")
  }

  // 2. Atom 1.0 roundtrip
  let atom_xml = match to_atom(feed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_atom failed: " + e.message)
      return ()
    }
  }
  let parsed_atom = match parse(atom_xml) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "roundtrip atom parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(parsed_atom.format.eq(FeedFormat::Atom), "roundtrip atom format")
  dls_assert_str(parsed_atom.id, "https://example.org/feed", "roundtrip atom id")
  match parsed_atom.entries[0].title {
    Some(t) => dls_assert_str(t.value, "Hello <World> & \"Quotes\" 'Single'", "roundtrip atom entry title")
    None => debug_assert(false, "roundtrip atom entry title missing")
  }
  match parsed_atom.entries[0].content {
    Some(c) => dls_assert_str(c.value, "<p>Body &amp; <b>bold</b></p>", "roundtrip atom entry content")
    None => debug_assert(false, "roundtrip atom entry content missing")
  }

  // 3. JSON Feed 1.1 roundtrip
  let jf_json = match to_json_feed(feed) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_json_feed failed: " + e.message)
      return ()
    }
  }
  let parsed_jf = match parse(jf_json) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "roundtrip json_feed parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(parsed_jf.format.eq(FeedFormat::JsonFeed), "roundtrip json_feed format")
  match parsed_jf.title {
    Some(t) => dls_assert_str(t.value, "Pion & Friends <Blog>", "roundtrip json_feed title")
    None => debug_assert(false, "roundtrip json_feed title missing")
  }
  match parsed_jf.entries[0].title {
    Some(t) => dls_assert_str(t.value, "Hello <World> & \"Quotes\" 'Single'", "roundtrip json_feed entry title")
    None => debug_assert(false, "roundtrip json_feed entry title missing")
  }
}
