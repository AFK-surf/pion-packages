///| RSS 2.0, RSS 0.91/0.92, RSS 1.0 (RDF), and namespace extension tests
///| (`content:encoded`, `dc:*`, `media:*`, `itunes:*`, `atom:link`).

import "time"

///|
fn rss_assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn rss_assert_opt_str(
  got : Option[String],
  expected : String,
  label : String,
) -> Unit {
  match got {
    Some(s) => rss_assert_str(s, expected, label)
    None => debug_assert(false, label + ": expected Some(\"" + expected + "\"), got None")
  }
}

///|
fn rss_assert_text(
  got : Option[TextContent],
  expected : String,
  label : String,
) -> Unit {
  match got {
    Some(tc) => rss_assert_str(tc.value, expected, label)
    None => debug_assert(false, label + ": expected Some(TextContent), got None")
  }
}

///|
fn rss_assert_opt_int(got : Option[Int], expected : Int, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected " + expected.to_string() + ", got " + v.to_string())
    None => debug_assert(false, label + ": expected Some(" + expected.to_string() + "), got None")
  }
}

///|
fn rss_assert_opt_i64(got : Option[Int64], expected : Int64, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected " + expected.to_string() + ", got " + v.to_string())
    None => debug_assert(false, label + ": expected Some(" + expected.to_string() + "), got None")
  }
}

///|
fn rss_assert_opt_bool(got : Option[Bool], expected : Bool, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label)
    None => debug_assert(false, label + ": got None")
  }
}

///|
test "rss2_full_spec_and_extensions" {
  let xml_src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<rss version=\"2.0\"\n" +
  "  xmlns:content=\"http://purl.org/rss/1.0/modules/content/\"\n" +
  "  xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n" +
  "  xmlns:media=\"http://search.yahoo.com/mrss/\"\n" +
  "  xmlns:itunes=\"http://www.itunes.com/dtds/podcast-1.0.dtd\"\n" +
  "  xmlns:atom=\"http://www.w3.org/2005/Atom\">\n" +
  "  <channel>\n" +
  "    <title>Pion Engineering Podcast</title>\n" +
  "    <link>https://pion.dev/podcast</link>\n" +
  "    <atom:link href=\"https://pion.dev/podcast/feed.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n" +
  "    <description>Systems engineering &amp; compilers</description>\n" +
  "    <language>en-us</language>\n" +
  "    <copyright>Copyright 2026 Pion</copyright>\n" +
  "    <managingEditor>editor@pion.dev (Jane Editor)</managingEditor>\n" +
  "    <webMaster>webmaster@pion.dev</webMaster>\n" +
  "    <pubDate>Mon, 23 Nov 2026 08:00:00 GMT</pubDate>\n" +
  "    <lastBuildDate>Mon, 23 Nov 2026 12:30:00 +0000</lastBuildDate>\n" +
  "    <generator>PionFeed 1.0</generator>\n" +
  "    <ttl>60</ttl>\n" +
  "    <category domain=\"https://pion.dev/cat\">Technology</category>\n" +
  "    <image>\n" +
  "      <url>https://pion.dev/logo.png</url>\n" +
  "      <title>Pion Logo</title>\n" +
  "      <link>https://pion.dev/</link>\n" +
  "      <width>144</width>\n" +
  "      <height>144</height>\n" +
  "      <description>Official logo</description>\n" +
  "    </image>\n" +
  "    <itunes:author>Pion Team</itunes:author>\n" +
  "    <itunes:explicit>false</itunes:explicit>\n" +
  "    <itunes:image href=\"https://pion.dev/podcast-cover.jpg\"/>\n" +
  "    <item>\n" +
  "      <title>Episode 1: Pure Pion Syndication</title>\n" +
  "      <link>https://pion.dev/podcast/ep1</link>\n" +
  "      <guid isPermaLink=\"false\">urn:pion:ep:1</guid>\n" +
  "      <pubDate>Mon, 23 Nov 2026 09:15:00 -0500</pubDate>\n" +
  "      <dc:creator>Alice Chen</dc:creator>\n" +
  "      <dc:subject>Compilers</dc:subject>\n" +
  "      <dc:rights>CC-BY-4.0</dc:rights>\n" +
  "      <description>Short summary of episode 1.</description>\n" +
  "      <content:encoded><![CDATA[<p>Full <strong>HTML</strong> show notes.</p>]]></content:encoded>\n" +
  "      <comments>https://pion.dev/podcast/ep1#comments</comments>\n" +
  "      <source url=\"https://pion.dev/podcast/feed.xml\">Pion Engineering Podcast</source>\n" +
  "      <category domain=\"https://pion.dev/tags\">RSS</category>\n" +
  "      <enclosure url=\"https://cdn.pion.dev/ep1.mp3\" length=\"12345678\" type=\"audio/mpeg\"/>\n" +
  "      <media:group>\n" +
  "        <media:title>Ep1 Media</media:title>\n" +
  "        <media:description>HD audio and video</media:description>\n" +
  "        <media:content url=\"https://cdn.pion.dev/ep1.mp4\" type=\"video/mp4\" fileSize=\"98765432\" width=\"1920\" height=\"1080\" duration=\"3661\" medium=\"video\"/>\n" +
  "        <media:thumbnail url=\"https://cdn.pion.dev/ep1-thumb.jpg\" width=\"320\" height=\"180\"/>\n" +
  "      </media:group>\n" +
  "      <itunes:author>Alice Chen</itunes:author>\n" +
  "      <itunes:duration>01:01:01</itunes:duration>\n" +
  "      <itunes:explicit>no</itunes:explicit>\n" +
  "      <itunes:image href=\"https://cdn.pion.dev/ep1-art.jpg\"/>\n" +
  "      <itunes:episode>1</itunes:episode>\n" +
  "      <itunes:season>2</itunes:season>\n" +
  "    </item>\n" +
  "    <item>\n" +
  "      <title>Episode 2: Default Permalink</title>\n" +
  "      <link>https://pion.dev/podcast/ep2</link>\n" +
  "      <guid>https://pion.dev/podcast/ep2</guid>\n" +
  "      <author>bob@pion.dev (Bob)</author>\n" +
  "      <dc:date>2026-11-23T15:00:00Z</dc:date>\n" +
  "      <description>Episode 2 summary</description>\n" +
  "      <media:content url=\"https://cdn.pion.dev/ep2.mp3\" type=\"audio/mpeg\" fileSize=\"4096\"/>\n" +
  "      <media:thumbnail url=\"https://cdn.pion.dev/ep2.png\" width=\"120\" height=\"90\"/>\n" +
  "      <itunes:duration>15:30</itunes:duration>\n" +
  "      <itunes:explicit>yes</itunes:explicit>\n" +
  "    </item>\n" +
  "  </channel>\n" +
  "</rss>"

  let feed = match parse(xml_src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "rss2 parse failed: " + e.message)
      return ()
    }
  }

  debug_assert(feed.format.eq(FeedFormat::Rss2), "format should be Rss2")
  rss_assert_text(feed.title, "Pion Engineering Podcast", "channel title")
  rss_assert_text(feed.description, "Systems engineering & compilers", "channel description")
  rss_assert_opt_str(feed.language, "en-us", "channel language")
  rss_assert_text(feed.rights, "Copyright 2026 Pion", "channel rights")
  rss_assert_opt_int(feed.ttl, 60, "channel ttl")
  debug_assert(feed.links.length() >= 2, "channel links include link + atom:link")
  let mut saw_self = false
  let mut li = 0
  while li < feed.links.length() {
    match feed.links[li].rel {
      Some(r) => {
        if r == "self" {
          saw_self = true
          rss_assert_str(feed.links[li].href, "https://pion.dev/podcast/feed.xml", "atom:link self href")
        }
      }
      None => ()
    }
    li = li + 1
  }
  debug_assert(saw_self, "should preserve atom:link rel=self")

  match feed.generator {
    Some(g) => rss_assert_str(g.content, "PionFeed 1.0", "generator")
    None => debug_assert(false, "generator missing")
  }
  match feed.logo {
    Some(img) => {
      rss_assert_str(img.uri, "https://pion.dev/logo.png", "image url")
      rss_assert_opt_str(img.title, "Pion Logo", "image title")
      rss_assert_opt_int(img.width, 144, "image width")
      rss_assert_opt_int(img.height, 144, "image height")
    }
    None => debug_assert(false, "channel image missing")
  }
  debug_assert(feed.authors.length() >= 1, "managingEditor/webMaster parsed as authors/contributors")
  debug_assert(feed.categories.length() == 1, "channel categories")
  rss_assert_str(feed.categories[0].term, "Technology", "channel category term")
  rss_assert_opt_str(feed.categories[0].scheme, "https://pion.dev/cat", "channel category domain")

  match feed.itunes {
    Some(it) => {
      rss_assert_opt_str(it.author, "Pion Team", "channel itunes:author")
      rss_assert_opt_bool(it.explicit, false, "channel itunes:explicit")
      rss_assert_opt_str(it.image, "https://pion.dev/podcast-cover.jpg", "channel itunes:image")
    }
    None => debug_assert(false, "channel itunes missing")
  }

  // Channel timestamps
  match feed.published {
    Some(ts) => debug_assert(ts.as_second() == 1795420800L, "channel pubDate epoch")
    None => debug_assert(false, "channel pubDate missing")
  }
  match feed.updated {
    Some(ts) => debug_assert(ts.as_second() == 1795437000L, "channel lastBuildDate epoch")
    None => debug_assert(false, "channel lastBuildDate missing")
  }

  // Entries
  debug_assert(feed.entries.length() == 2, "expected 2 entries")
  let e1 = feed.entries[0]
  rss_assert_str(e1.id, "urn:pion:ep:1", "ep1 guid")
  rss_assert_opt_bool(e1.id_is_permalink, false, "ep1 isPermaLink=false")
  rss_assert_text(e1.title, "Episode 1: Pure Pion Syndication", "ep1 title")
  rss_assert_text(e1.summary, "Short summary of episode 1.", "ep1 summary")
  match e1.content {
    Some(c) => {
      debug_assert(c.content_type.eq(TextType::Html), "content:encoded type should be Html")
      rss_assert_str(c.value, "<p>Full <strong>HTML</strong> show notes.</p>", "ep1 content:encoded")
    }
    None => debug_assert(false, "ep1 content:encoded missing")
  }
  debug_assert(e1.authors.length() >= 1, "ep1 dc:creator")
  rss_assert_str(e1.authors[0].name, "Alice Chen", "ep1 author name")
  rss_assert_text(e1.rights, "CC-BY-4.0", "ep1 dc:rights")
  rss_assert_opt_str(e1.comments_url, "https://pion.dev/podcast/ep1#comments", "ep1 comments")
  rss_assert_opt_str(e1.source, "https://pion.dev/podcast/feed.xml", "ep1 source")
  debug_assert(e1.categories.length() == 2, "ep1 categories (dc:subject + category)")

  // Enclosure link
  let mut saw_enclosure = false
  let mut k = 0
  while k < e1.links.length() {
    match e1.links[k].rel {
      Some(r) => {
        if r == "enclosure" {
          saw_enclosure = true
          rss_assert_str(e1.links[k].href, "https://cdn.pion.dev/ep1.mp3", "enclosure url")
          rss_assert_opt_str(e1.links[k].media_type, "audio/mpeg", "enclosure type")
          rss_assert_opt_i64(e1.links[k].length, 12345678L, "enclosure length")
        }
      }
      None => ()
    }
    k = k + 1
  }
  debug_assert(saw_enclosure, "ep1 enclosure link missing")

  // Media RSS group
  debug_assert(e1.media.length() >= 1, "ep1 media:group missing")
  let mg = e1.media[0]
  rss_assert_opt_str(mg.title, "Ep1 Media", "media:title")
  rss_assert_opt_str(mg.description, "HD audio and video", "media:description")
  debug_assert(mg.content.length() == 1, "media:content count")
  rss_assert_opt_str(mg.content[0].url, "https://cdn.pion.dev/ep1.mp4", "media:content url")
  rss_assert_opt_i64(mg.content[0].length, 98765432L, "media:content fileSize")
  rss_assert_opt_int(mg.content[0].width, 1920, "media:content width")
  rss_assert_opt_int(mg.content[0].height, 1080, "media:content height")
  rss_assert_opt_i64(mg.content[0].duration, 3661L, "media:content duration")
  debug_assert(mg.thumbnails.length() == 1, "media:thumbnail count")
  rss_assert_str(mg.thumbnails[0].url, "https://cdn.pion.dev/ep1-thumb.jpg", "media:thumbnail url")

  // iTunes item metadata
  match e1.itunes {
    Some(it) => {
      rss_assert_opt_str(it.author, "Alice Chen", "ep1 itunes:author")
      rss_assert_opt_i64(it.duration, 3661L, "ep1 itunes:duration 01:01:01 -> 3661")
      rss_assert_opt_bool(it.explicit, false, "ep1 itunes:explicit no -> false")
      rss_assert_opt_str(it.image, "https://cdn.pion.dev/ep1-art.jpg", "ep1 itunes:image")
      rss_assert_opt_int(it.episode, 1, "ep1 episode")
      rss_assert_opt_int(it.season, 2, "ep1 season")
    }
    None => debug_assert(false, "ep1 itunes missing")
  }

  // Entry 2: default isPermaLink=true, dc:date, standalone media:content/thumbnail, MM:SS duration
  let e2 = feed.entries[1]
  rss_assert_opt_bool(e2.id_is_permalink, true, "ep2 default isPermaLink=true")
  debug_assert(e2.authors.length() == 1, "ep2 author")
  rss_assert_str(e2.authors[0].name, "Bob", "ep2 parsed email display name")
  rss_assert_opt_str(e2.authors[0].email, "bob@pion.dev", "ep2 parsed email")
  match e2.published {
    Some(ts) => debug_assert(ts.as_second() == 1795446000L, "ep2 dc:date epoch")
    None => debug_assert(false, "ep2 dc:date missing")
  }
  debug_assert(e2.media.length() >= 1, "ep2 standalone media object")
  match e2.itunes {
    Some(it) => {
      rss_assert_opt_i64(it.duration, 930L, "ep2 itunes:duration 15:30 -> 930")
      rss_assert_opt_bool(it.explicit, true, "ep2 itunes:explicit yes -> true")
    }
    None => debug_assert(false, "ep2 itunes missing")
  }
}

///|
test "rss1_rdf_spec" {
  let rdf_src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<rdf:RDF\n" +
  "  xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"\n" +
  "  xmlns=\"http://purl.org/rss/1.0/\"\n" +
  "  xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n" +
  "  xmlns:content=\"http://purl.org/rss/1.0/modules/content/\">\n" +
  "  <channel rdf:about=\"https://example.org/rss1.xml\">\n" +
  "    <title>RDF Site Summary</title>\n" +
  "    <link>https://example.org/</link>\n" +
  "    <description>Classic RSS 1.0 feed</description>\n" +
  "    <dc:language>en</dc:language>\n" +
  "    <dc:date>2026-11-20T10:00:00Z</dc:date>\n" +
  "  </channel>\n" +
  "  <image rdf:about=\"https://example.org/img.png\">\n" +
  "    <title>Example Logo</title>\n" +
  "    <url>https://example.org/img.png</url>\n" +
  "    <link>https://example.org/</link>\n" +
  "  </image>\n" +
  "  <item rdf:about=\"https://example.org/post/1\">\n" +
  "    <title>First RDF Item</title>\n" +
  "    <link>https://example.org/post/1</link>\n" +
  "    <description>RDF summary text</description>\n" +
  "    <dc:creator>RDF Author</dc:creator>\n" +
  "    <dc:date>2026-11-21T11:30:00Z</dc:date>\n" +
  "    <dc:identifier>urn:rdf:1</dc:identifier>\n" +
  "    <content:encoded>&lt;p&gt;Full RDF HTML&lt;/p&gt;</content:encoded>\n" +
  "  </item>\n" +
  "</rdf:RDF>"

  let feed = match parse(rdf_src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "rss1 parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(feed.format.eq(FeedFormat::Rss1), "format should be Rss1")
  rss_assert_str(feed.id, "https://example.org/rss1.xml", "rss1 channel rdf:about")
  rss_assert_text(feed.title, "RDF Site Summary", "rss1 channel title")
  rss_assert_opt_str(feed.language, "en", "rss1 dc:language")
  match feed.logo {
    Some(img) => rss_assert_str(img.uri, "https://example.org/img.png", "rss1 image")
    None => debug_assert(false, "rss1 image missing")
  }
  debug_assert(feed.entries.length() == 1, "rss1 entries count")
  let item = feed.entries[0]
  rss_assert_str(item.id, "urn:rdf:1", "rss1 dc:identifier or rdf:about")
  rss_assert_text(item.title, "First RDF Item", "rss1 item title")
  rss_assert_text(item.summary, "RDF summary text", "rss1 item description")
  rss_assert_text(item.content, "<p>Full RDF HTML</p>", "rss1 content:encoded")
  debug_assert(item.authors.length() == 1, "rss1 dc:creator")
  rss_assert_str(item.authors[0].name, "RDF Author", "rss1 author name")
}

///|
test "rss091_compat_and_bom" {
  let bom = "\u{FEFF}"
  let rss091 = bom + "  \n<rss version=\"0.91\"><channel><title>Old Feed</title><link>http://old.example/</link><description>Legacy</description><item><title>Legacy Item</title><link>http://old.example/1</link></item></channel></rss>"
  let feed = match parse(rss091) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "rss091 parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(feed.format.eq(FeedFormat::Rss2), "rss 0.91 maps to Rss2")
  rss_assert_text(feed.title, "Old Feed", "rss091 title")
  debug_assert(feed.entries.length() == 1, "rss091 entry count")
  rss_assert_str(feed.entries[0].id, "http://old.example/1", "fallback id from link")
}
