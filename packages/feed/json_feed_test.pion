///| JSON Feed 1.1 and 1.0 compatibility tests.

///|
fn jf_assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn jf_assert_opt_str(
  got : Option[String],
  expected : String,
  label : String,
) -> Unit {
  match got {
    Some(s) => jf_assert_str(s, expected, label)
    None => debug_assert(false, label + ": expected Some(\"" + expected + "\"), got None")
  }
}

///|
test "json_feed_1_1_full" {
  let src = "{\n" +
  "  \"version\": \"https://jsonfeed.org/version/1.1\",\n" +
  "  \"title\": \"My Example Feed\",\n" +
  "  \"home_page_url\": \"https://example.org/\",\n" +
  "  \"feed_url\": \"https://example.org/feed.json\",\n" +
  "  \"description\": \"Updates from Example Org\",\n" +
  "  \"icon\": \"https://example.org/icon.png\",\n" +
  "  \"favicon\": \"https://example.org/favicon.ico\",\n" +
  "  \"language\": \"en-US\",\n" +
  "  \"authors\": [\n" +
  "    {\"name\": \"Alice\", \"url\": \"https://example.org/alice\", \"avatar\": \"https://example.org/alice.png\"}\n" +
  "  ],\n" +
  "  \"items\": [\n" +
  "    {\n" +
  "      \"id\": \"item-2\",\n" +
  "      \"url\": \"https://example.org/second-item\",\n" +
  "      \"external_url\": \"https://external.example/ref\",\n" +
  "      \"title\": \"Second Item\",\n" +
  "      \"content_html\": \"<p>Hello <b>JSON Feed</b></p>\",\n" +
  "      \"content_text\": \"Hello JSON Feed\",\n" +
  "      \"summary\": \"Short summary\",\n" +
  "      \"image\": \"https://example.org/img2.png\",\n" +
  "      \"banner_image\": \"https://example.org/banner2.png\",\n" +
  "      \"date_published\": \"2026-11-23T10:00:00Z\",\n" +
  "      \"date_modified\": \"2026-11-23T11:00:00+01:00\",\n" +
  "      \"authors\": [{\"name\": \"Bob\"}],\n" +
  "      \"tags\": [\"pion\", \"jsonfeed\"],\n" +
  "      \"language\": \"en\",\n" +
  "      \"attachments\": [\n" +
  "        {\"url\": \"https://example.org/ep2.mp3\", \"mime_type\": \"audio/mpeg\", \"title\": \"Audio\", \"size_in_bytes\": 98765, \"duration_in_seconds\": 120}\n" +
  "      ]\n" +
  "    },\n" +
  "    {\n" +
  "      \"id\": \"item-1\",\n" +
  "      \"content_text\": \"Plain text only\"\n" +
  "    }\n" +
  "  ]\n" +
  "}"

  let feed = match parse(src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "json feed 1.1 parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(feed.format.eq(FeedFormat::JsonFeed), "format should be JsonFeed")
  jf_assert_str(feed.id, "https://example.org/feed.json", "feed id from feed_url")
  match feed.title {
    Some(t) => jf_assert_str(t.value, "My Example Feed", "title")
    None => debug_assert(false, "title missing")
  }
  match feed.description {
    Some(d) => jf_assert_str(d.value, "Updates from Example Org", "description")
    None => debug_assert(false, "description missing")
  }
  jf_assert_opt_str(feed.language, "en-US", "language")
  match feed.icon {
    Some(ic) => jf_assert_str(ic.uri, "https://example.org/favicon.ico", "favicon")
    None => debug_assert(false, "favicon missing")
  }
  match feed.logo {
    Some(lg) => jf_assert_str(lg.uri, "https://example.org/icon.png", "icon/logo")
    None => debug_assert(false, "logo missing")
  }
  debug_assert(feed.authors.length() == 1, "feed authors")
  jf_assert_str(feed.authors[0].name, "Alice", "author name")
  jf_assert_opt_str(feed.authors[0].uri, "https://example.org/alice", "author url")
  jf_assert_opt_str(feed.authors[0].avatar, "https://example.org/alice.png", "author avatar")

  debug_assert(feed.entries.length() == 2, "items count")
  let e1 = feed.entries[0]
  jf_assert_str(e1.id, "item-2", "item id")
  jf_assert_opt_str(e1.external_url, "https://external.example/ref", "external_url")
  jf_assert_opt_str(e1.image, "https://example.org/img2.png", "image")
  jf_assert_opt_str(e1.banner_image, "https://example.org/banner2.png", "banner_image")
  jf_assert_opt_str(e1.language, "en", "item language")
  match e1.content {
    Some(c) => {
      debug_assert(c.content_type.eq(TextType::Html), "prefer content_html when both present")
      jf_assert_str(c.value, "<p>Hello <b>JSON Feed</b></p>", "content_html")
    }
    None => debug_assert(false, "e1 content missing")
  }
  match e1.summary {
    Some(s) => jf_assert_str(s.value, "Short summary", "summary")
    None => debug_assert(false, "e1 summary missing")
  }
  debug_assert(e1.categories.length() == 2, "tags mapped to categories")
  jf_assert_str(e1.categories[0].term, "pion", "tag 0")
  jf_assert_str(e1.categories[1].term, "jsonfeed", "tag 1")
  match e1.published {
    Some(ts) => debug_assert(ts.as_second() == 1795428000L, "date_published epoch")
    None => debug_assert(false, "date_published missing")
  }
  match e1.updated {
    Some(ts) => debug_assert(ts.as_second() == 1795428000L, "date_modified 11:00+01:00 == 10:00Z")
    None => debug_assert(false, "date_modified missing")
  }
  // Attachment mapped to enclosure link
  let mut saw_att = false
  let mut i = 0
  while i < e1.links.length() {
    match e1.links[i].rel {
      Some(r) => {
        if r == "enclosure" {
          saw_att = true
          jf_assert_str(e1.links[i].href, "https://example.org/ep2.mp3", "attachment url")
          jf_assert_opt_str(e1.links[i].media_type, "audio/mpeg", "attachment mime_type")
          match e1.links[i].length {
            Some(n) => debug_assert(n == 98765L, "attachment size")
            None => debug_assert(false, "attachment size missing")
          }
        }
      }
      None => ()
    }
    i = i + 1
  }
  debug_assert(saw_att, "attachment link missing")

  let e2 = feed.entries[1]
  match e2.content {
    Some(c) => {
      debug_assert(c.content_type.eq(TextType::Text), "content_text type")
      jf_assert_str(c.value, "Plain text only", "content_text value")
    }
    None => debug_assert(false, "e2 content_text missing")
  }
}

///|
test "json_feed_1_0_compat_and_bom" {
  let src = "\u{FEFF} {\n" +
  "  \"version\": \"https://jsonfeed.org/version/1\",\n" +
  "  \"title\": \"Legacy 1.0 Feed\",\n" +
  "  \"author\": {\"name\": \"Legacy Author\", \"url\": \"https://example.org/legacy\"},\n" +
  "  \"items\": [\n" +
  "    {\"id\": \"1\", \"title\": \"One\", \"author\": {\"name\": \"Item Author\"}}\n" +
  "  ]\n" +
  "}"
  let feed = match parse(src) {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "json feed 1.0 parse failed: " + e.message)
      return ()
    }
  }
  debug_assert(feed.format.eq(FeedFormat::JsonFeed), "format JsonFeed")
  debug_assert(feed.authors.length() == 1, "1.0 top-level author")
  jf_assert_str(feed.authors[0].name, "Legacy Author", "1.0 author name")
  debug_assert(feed.entries.length() == 1, "1.0 item")
  debug_assert(feed.entries[0].authors.length() == 1, "1.0 item author")
  jf_assert_str(feed.entries[0].authors[0].name, "Item Author", "1.0 item author name")
}

///|
test "json_feed_invalid_rejected" {
  match parse("{\"not_a_feed\": true}") {
    Ok(_) => debug_assert(false, "non-feed JSON must fail")
    Err(e) => debug_assert(!e.kind.eq(FeedErrorKind::Unimplemented), "must not be Unimplemented")
  }
  match parse("{invalid json") {
    Ok(_) => debug_assert(false, "malformed JSON must fail")
    Err(e) => debug_assert(!e.kind.eq(FeedErrorKind::Unimplemented), "must not be Unimplemented")
  }
}
