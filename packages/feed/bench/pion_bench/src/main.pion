///| Pion Native head-to-head benchmark for `packages/feed` (W1 RSS 2.0, W2 Atom 1.0, W3 JSON Feed 1.1).

import "feed"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  let m = 1000000007L
  let r = (h * 131L + (v % m) + m) % m
  r
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let b = s.to_bytes()
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_feed_bench <mode> <corpus_path>")
    return 1
  }
  let mode = args[1]
  let raw = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let parsed = match feed::parse(raw) {
    Ok(f) => f
    Err(e) => {
      io_println(world, "parse error: " + e.message)
      return 2
    }
  }

  let mut checksum = 0L
  let feed_title = match parsed.title {
    Some(t) => t.value
    None => ""
  }
  checksum = hash_str(checksum, feed_title)
  let n = parsed.entries.length()
  let mut total_authors = 0
  let mut total_cats = 0
  let mut i = 0
  while i < n {
    let e = parsed.entries[i]
    checksum = hash_str(checksum, e.id)
    match e.title {
      Some(t) => checksum = hash_str(checksum, t.value)
      None => ()
    }
    match e.published {
      Some(ts) => checksum = mix(checksum, ts.as_second())
      None => ()
    }
    match e.summary {
      Some(s) => checksum = hash_str(checksum, s.value)
      None => ()
    }
    total_authors = total_authors + e.authors.length()
    total_cats = total_cats + e.categories.length()
    let mut ai = 0
    while ai < e.authors.length() {
      checksum = hash_str(checksum, e.authors[ai].name)
      ai = ai + 1
    }
    let mut ci = 0
    while ci < e.categories.length() {
      checksum = hash_str(checksum, e.categories[ci].term)
      ci = ci + 1
    }
    i = i + 1
  }

  io_println(world, "mode=" + mode)
  io_println(world, "entries=" + n.to_string())
  io_println(world, "authors=" + total_authors.to_string())
  io_println(world, "categories=" + total_cats.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
