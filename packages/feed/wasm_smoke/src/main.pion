///| Native + Wasm32 4-mode smoke entry for `packages/feed`.

import "feed"

///|
pub fn main(world : World) -> Int {
  // 1. RSS 2.0 + extensions
  let rss_src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
  "<rss version=\"2.0\" xmlns:content=\"http://purl.org/rss/1.0/modules/content/\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:media=\"http://search.yahoo.com/mrss/\" xmlns:itunes=\"http://www.itunes.com/dtds/podcast-1.0.dtd\" xmlns:atom=\"http://www.w3.org/2005/Atom\">" +
  "<channel><title>Pion News</title><link>https://pion.dev/</link><description>Systems &amp; Feeds</description>" +
  "<atom:link href=\"https://pion.dev/rss.xml\" rel=\"self\" type=\"application/rss+xml\"/>" +
  "<item><title>Wave 16</title><link>https://pion.dev/w16</link><guid isPermaLink=\"false\">w16-1</guid>" +
  "<pubDate>Mon, 23 Nov 2026 12:00:00 GMT</pubDate><dc:creator>Alice</dc:creator>" +
  "<description>Summary</description><content:encoded><![CDATA[<p>Body</p>]]></content:encoded>" +
  "<media:content url=\"https://cdn.pion.dev/w16.mp3\" type=\"audio/mpeg\" fileSize=\"1024\"/>" +
  "<itunes:duration>10:05</itunes:duration></item></channel></rss>"
  let rss_feed = match feed::parse(rss_src) {
    Ok(f) => f
    Err(_) => return 1
  }
  if rss_feed.entries.length() != 1 {
    return 2
  }

  // 2. Atom 1.0 + xml:base + XHTML
  let atom_src = "<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:base=\"https://pion.dev/blog/\">" +
  "<id>urn:pion:blog</id><title>Pion Blog</title><updated>2026-11-23T12:00:00Z</updated>" +
  "<entry><id>urn:pion:1</id><title>Post 1</title><updated>2026-11-23T12:00:00Z</updated>" +
  "<link href=\"2026/post1.html\"/>" +
  "<content type=\"xhtml\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Hi <em>Wasm</em></p></div></content>" +
  "</entry></feed>"
  let atom_feed = match feed::parse(atom_src) {
    Ok(f) => f
    Err(_) => return 3
  }
  if atom_feed.entries.length() != 1 {
    return 4
  }

  // 3. JSON Feed 1.1
  let jf_src = "{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"JF\",\"items\":[{\"id\":\"jf1\",\"title\":\"Hello\",\"content_text\":\"World\",\"date_published\":\"2026-11-23T12:00:00Z\",\"tags\":[\"pion\"]}]}"
  let jf_feed = match feed::parse(jf_src) {
    Ok(f) => f
    Err(_) => return 5
  }
  if jf_feed.entries.length() != 1 {
    return 6
  }

  // 4. Roundtrip serialization across all 3 output formats
  let out_rss = match feed::to_rss2(atom_feed) {
    Ok(s) => s
    Err(_) => return 7
  }
  let out_atom = match feed::to_atom(rss_feed) {
    Ok(s) => s
    Err(_) => return 8
  }
  let out_jf = match feed::to_json_feed(rss_feed) {
    Ok(s) => s
    Err(_) => return 9
  }
  let rt_rss = match feed::parse(out_rss) {
    Ok(f) => f
    Err(_) => return 10
  }
  let rt_atom = match feed::parse(out_atom) {
    Ok(f) => f
    Err(_) => return 11
  }
  let rt_jf = match feed::parse(out_jf) {
    Ok(f) => f
    Err(_) => return 12
  }

  // 5. Dirty date + DoS limit check
  let ts = match feed::parse_feed_date("Monday, 23 Nov 2026 07:00 EST") {
    Ok(t) => t
    Err(_) => return 13
  }
  let tiny_limits = feed::FeedLimits::{
    max_bytes: 16,
    max_entries: 10,
    max_depth: 16,
    max_links_per_entry: 8,
    max_text_bytes: 1024,
  }
  match feed::parse_with_limits(rss_src, tiny_limits) {
    Err(e) => {
      if !e.kind.eq(feed::FeedErrorKind::LimitExceeded) {
        return 14
      }
    }
    Ok(_) => return 15
  }

  let link_resolved = atom_feed.entries[0].links[0].href
  let xhtml_val = match atom_feed.entries[0].content {
    Some(c) => c.value
    None => ""
  }
  io_println(world, "feed_wasm_smoke=ok")
  io_println(world, "rss=" + rss_feed.format.to_string() + ":" + rss_feed.entries[0].id)
  io_println(world, "atom=" + atom_feed.format.to_string() + ":" + link_resolved + ":" + xhtml_val)
  io_println(world, "jf=" + jf_feed.format.to_string() + ":" + jf_feed.entries[0].id)
  io_println(
    world,
    "roundtrip=" +
    rt_rss.entries.length().to_string() +
    "," +
    rt_atom.entries.length().to_string() +
    "," +
    rt_jf.entries.length().to_string(),
  )
  io_println(world, "date_sec=" + ts.as_second().to_string())
  0
}
