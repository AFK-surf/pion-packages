///| Wasm32 + Native 4-mode smoke entry for `packages/lepton`.

import "lepton"

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

fn hex_to_bytes(s : String) -> Bytes {
  let raw = s.to_bytes()
  let n = raw.length() / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(raw[i * 2].to_int())
    let lo = hex_nibble(raw[i * 2 + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn fnv1a64(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = h ^ b[i].to_int().to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

fn minimal_baseline_jpg() -> Bytes {
  let sb = StringBuilder::with_capacity(444)
  sb.write_string("ffd8ffe000104a46494600010200000100010000fffe00104c61766336322e31312e31303000ffdb0043000804040404")
  sb.write_string("040505050505050606060606060606060606060607070708080807070706060707080808080909090808080809090a0a")
  sb.write_string("0a0c0c0b0b0e0e0e111114ffc4004b000101000000000000000000000000000000070101000000000000000000000000")
  sb.write_string("00000000100100000000000000000000000000000000110100000000000000000000000000000000ffc0001108000100")
  sb.write_string("0103012200021100031100ffda000c03010002110311003f00bf800fffd9")
  hex_to_bytes(sb.to_string())
}

