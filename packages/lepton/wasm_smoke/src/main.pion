fn smoke() -> (Int, Int, Int, UInt64) {
  let mut acc : UInt64 = 0UL

  // 1. Sequential baseline JPEG (minimal.jpg: 222 B -> 151 B -> exact 222 B)
  let base_jpg = minimal_baseline_jpg()
  let base_enc = match lepton::encode(base_jpg) {
    Ok(b) => b
    Err(_) => return (-1, 0, 0, 0UL)
  }
  if base_enc.length() >= base_jpg.length() {
    return (-2, 0, 0, 0UL)
  }
  match lepton::decode(base_enc) {
    Ok(dec) => {
      if !bytes_eq(dec, base_jpg) {
        return (-3, 0, 0, 0UL)
      }
      acc = acc ^ fnv1a64(base_enc) ^ fnv1a64(dec)
    }
    Err(_) => return (-4, 0, 0, 0UL)
  }

  // 2. Progressive SOF2 JPEG (64x64 photo: 1399 B -> compressed -> exact 1399 B)
  let prog_jpg = photo64_progressive_jpg()
  let prog_enc = match lepton::encode(prog_jpg) {
    Ok(b) => b
    Err(_) => return (-5, 0, 0, 0UL)
  }
  if prog_enc.length() >= prog_jpg.length() {
    return (-6, 0, 0, 0UL)
  }
  match lepton::decode(prog_enc) {
    Ok(dec) => {
      if !bytes_eq(dec, prog_jpg) {
        return (-7, 0, 0, 0UL)
      }
      acc = acc ^ fnv1a64(prog_enc) ^ fnv1a64(dec)
    }
    Err(_) => return (-8, 0, 0, 0UL)
  }

  // 3. Reject truncated JPEG missing EOI
  let mut trunc_jpg = Bytes::new(base_jpg.length() - 2)
  let mut i = 0
  while i < trunc_jpg.length() {
    trunc_jpg[i] = base_jpg[i]
    i = i + 1
  }
  match lepton::encode(trunc_jpg) {
    Ok(_) => return (-9, 0, 0, 0UL)
    Err(_) => ()
  }

  // 4. Reject malformed / truncated lepton payloads
  let bad_magic = hex_to_bytes("00000100")
  match lepton::decode(bad_magic) {
    Ok(_) => return (-10, 0, 0, 0UL)
    Err(_) => ()
  }
  let mut trunc_enc = Bytes::new(base_enc.length() / 2)
  i = 0
  while i < trunc_enc.length() {
    trunc_enc[i] = base_enc[i]
    i = i + 1
  }
  match lepton::decode(trunc_enc) {
    Ok(_) => return (-11, 0, 0, 0UL)
    Err(_) => ()
  }

  (4, base_enc.length(), prog_enc.length(), acc)
}

pub fn main(world : World) -> Int {
  let (checks, base_len, prog_len, hash) = smoke()
  if checks > 0 {
    io_println(
      world,
      "lepton_wasm_smoke: OK checks="
      + checks.to_string()
      + " base="
      + base_len.to_string()
      + " prog="
      + prog_len.to_string()
      + " fnv64="
      + hash.to_string(),
    )
    0
  } else {
    io_println(world, "lepton_wasm_smoke: FAIL code=" + checks.to_string())
    1
  }
}
