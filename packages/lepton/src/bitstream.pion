///| Byte and JPEG entropy bitstream readers and writers.

///| Growable chunked byte writer backed by a zero-COW `FixedArray[Byte]` staging buffer.
struct ByteWriter {
  buf : FixedArray[Byte]
  cap : Int
  mut len : Int
  mut total_len : Int
  chunks : Array[Bytes]
}

///| Create a new `ByteWriter` with the given initial capacity.
fn ByteWriter::new(init_cap : Int) -> ByteWriter {
  let cap = if init_cap < 512 { 512 } else if init_cap > 65536 { 65536 } else { init_cap }
  ByteWriter::{
    buf: FixedArray::make(cap, (0).to_byte()),
    cap,
    len: 0,
    total_len: 0,
    chunks: [],
  }
}

///| Copy `src[0..n]` into a fresh `Bytes` using an 8x unrolled loop.
fn copy_fixed_to_bytes(src : FixedArray[Byte], n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  let lim8 = n - 8
  while i <= lim8 {
    out[i] = src[i]
    out[i + 1] = src[i + 1]
    out[i + 2] = src[i + 2]
    out[i + 3] = src[i + 3]
    out[i + 4] = src[i + 4]
    out[i + 5] = src[i + 5]
    out[i + 6] = src[i + 6]
    out[i + 7] = src[i + 7]
    i = i + 8
  }
  while i < n {
    out[i] = src[i]
    i = i + 1
  }
  out
}

///| Flush the active staging buffer into `bw.chunks` and reset `bw.len = 0`.
fn bw_flush_chunk(bw : ByteWriter) -> Unit {
  let n = bw.len
  if n == 0 {
    return
  }
  bw.chunks.push(copy_fixed_to_bytes(bw.buf, n))
  bw.len = 0
}

///| Append a single byte (low 8 bits of `v`).
fn bw_push_byte(bw : ByteWriter, v : Int) -> Unit {
  if bw.len >= bw.cap {
    bw_flush_chunk(bw)
  }
  bw.buf[bw.len] = (v & 0xFF).to_byte()
  bw.len = bw.len + 1
  bw.total_len = bw.total_len + 1
}

///| Append a slice `[start, end)` from `src`.
fn bw_push_slice(bw : ByteWriter, src : Bytes, start : Int, end : Int) -> Unit {
  let count = end - start
  if count <= 0 {
    return
  }
  bw.total_len = bw.total_len + count
  if count >= 256 || bw.len + count > bw.cap {
    if bw.len > 0 {
      bw_flush_chunk(bw)
    }
    bw.chunks.push(src.slice(start, end))
    return
  }
  let buf = bw.buf
  let base = bw.len
  let mut i = 0
  while i < count {
    buf[base + i] = src[start + i]
    i = i + 1
  }
  bw.len = base + count
}

///| Append all bytes of `src`.
fn bw_push_bytes(bw : ByteWriter, src : Bytes) -> Unit {
  bw_push_slice(bw, src, 0, src.length())
}

///| Append an unsigned LEB128 varint (`v >= 0`).
fn bw_push_varint(bw : ByteWriter, v : Int) -> Unit {
  let mut x = v
  while x >= 0x80 {
    bw_push_byte(bw, (x & 0x7F) | 0x80)
    x = x >> 7
  }
  bw_push_byte(bw, x & 0x7F)
}

///| Return the total number of bytes written so far in O(1).
fn bw_total_len(bw : ByteWriter) -> Int {
  bw.total_len
}

///| Concatenate an array of `Bytes` chunks using balanced pairwise `Bytes::concat`.
fn concat_bytes_chunks(chunks : Array[Bytes]) -> Bytes {
  let n = chunks.length()
  if n == 0 {
    return Bytes::new(0)
  }
  if n == 1 {
    return chunks[0]
  }
  let mut cur = chunks
  while cur.length() > 1 {
    let next : Array[Bytes] = []
    let mut i = 0
    let len = cur.length()
    while i + 1 < len {
      next.push(cur[i].concat(cur[i + 1]))
      i = i + 2
    }
    if i < len {
      next.push(cur[i])
    }
    cur = next
  }
  cur[0]
}

///| Materialize all written bytes into a single contiguous `Bytes`.
fn bw_to_bytes(bw : ByteWriter) -> Bytes {
  if bw.chunks.length() == 0 {
    return copy_fixed_to_bytes(bw.buf, bw.len)
  }
  if bw.len > 0 {
    bw_flush_chunk(bw)
  }
  concat_bytes_chunks(bw.chunks)
}

///| Cursor for reading structured binary payloads.
struct ByteReader {
  data : Bytes
  mut pos : Int
}

///| Create a `ByteReader` positioned at offset 0.
fn ByteReader::new(data : Bytes) -> ByteReader {
  ByteReader::{ data, pos: 0 }
}

///| Read one unsigned byte.
fn br_read_byte(br : ByteReader) -> Result[Int, String] {
  if br.pos >= br.data.length() {
    return Err("unexpected end of lepton stream")
  }
  let b = br.data[br.pos].to_int()
  br.pos = br.pos + 1
  Ok(b)
}

///| Read an unsigned LEB128 varint (up to 31-bit non-negative `Int`).
fn br_read_varint(br : ByteReader) -> Result[Int, String] {
  let mut result = 0
  let mut shift = 0
  let data = br.data
  let len = data.length()
  while true {
    if br.pos >= len {
      return Err("truncated varint")
    }
    let b = data[br.pos].to_int()
    br.pos = br.pos + 1
    if shift > 28 {
      return Err("varint overflow")
    }
    if shift == 28 && (b & 0xF8) != 0 {
      return Err("varint overflow")
    }
    result = result | ((b & 0x7F) << shift)
    if (b & 0x80) == 0 {
      return Ok(result)
    }
    shift = shift + 7
  }
  Err("varint overflow")
}

///| Read `len` raw bytes as a slice.
fn br_read_bytes(br : ByteReader, len : Int) -> Result[Bytes, String] {
  if len < 0 || len > br.data.length() - br.pos {
    return Err("truncated byte slice")
  }
  let out = br.data.slice(br.pos, br.pos + len)
  br.pos = br.pos + len
  Ok(out)
}

///| 64-bit MSB-first JPEG entropy-coded bitstream reader with `0xFF 0x00` unstuffing.
struct JpegBitReader {
  data : Bytes
  mut pos : Int
  end : Int
  mut bitbuf : UInt64
  mut bitcnt : Int
  mut hit_marker : Bool
}

///| Create a `JpegBitReader` over `[start, end)`.
fn JpegBitReader::new(data : Bytes, start : Int, end : Int) -> JpegBitReader {
  JpegBitReader::{ data, pos: start, end, bitbuf: 0UL, bitcnt: 0, hit_marker: false }
}

///| Refill the 64-bit bit buffer up to 56 bits.
fn jbr_fill(br : JpegBitReader) -> Unit {
  if br.hit_marker {
    return
  }
  let data = br.data
  let end = br.end
  let mut pos = br.pos
  let mut bitbuf = br.bitbuf
  let mut bitcnt = br.bitcnt
  while bitcnt <= 48 {
    if pos >= end {
      br.hit_marker = true
      break
    }
    let b = data[pos].to_int()
    if b == 0xFF {
      if pos + 1 >= end {
        br.hit_marker = true
        break
      }
      let next = data[pos + 1].to_int()
      if next == 0x00 {
        pos = pos + 2
        bitbuf = (bitbuf << 8) | 0xFFUL
        bitcnt = bitcnt + 8
      } else {
        br.hit_marker = true
        break
      }
    } else {
      pos = pos + 1
      bitbuf = (bitbuf << 8) | b.to_int64().to_uint64()
      bitcnt = bitcnt + 8
    }
  }
  br.pos = pos
  br.bitbuf = bitbuf
  br.bitcnt = bitcnt
}

///| Read `nbits` (0..16) MSB-first unsigned bits; returns `-1` on EOF.
fn jbr_read_bits_fast(br : JpegBitReader, nbits : Int) -> Int {
  if nbits == 0 {
    return 0
  }
  if br.bitcnt < nbits {
    jbr_fill(br)
    if br.bitcnt < nbits {
      return -1
    }
  }
  let new_cnt = br.bitcnt - nbits
  br.bitcnt = new_cnt
  ((br.bitbuf >> new_cnt) & ((1UL << nbits) - 1UL)).to_int()
}

///| Read a single bit (0 or 1); returns `-1` on EOF.
fn jbr_read_bit_fast(br : JpegBitReader) -> Int {
  if br.bitcnt == 0 {
    jbr_fill(br)
    if br.bitcnt == 0 {
      return -1
    }
  }
  let new_cnt = br.bitcnt - 1
  br.bitcnt = new_cnt
  ((br.bitbuf >> new_cnt) & 1UL).to_int()
}

///| Convert an unsigned `nbits`-bit JPEG value to its signed magnitude.
fn jpeg_extend(v : Int, nbits : Int) -> Int {
  if v < (1 << (nbits - 1)) {
    v - ((1 << nbits) - 1)
  } else {
    v
  }
}

///| Rewind any full unread bytes back into `pos` and return `(pad_count, pad_value)`.
fn jbr_finish_interval(br : JpegBitReader) -> (Int, Int) {
  let mut bitbuf = br.bitbuf
  let mut bitcnt = br.bitcnt
  let mut pos = br.pos
  while bitcnt >= 8 {
    let b = (bitbuf & 0xFFUL).to_int()
    bitbuf = bitbuf >> 8
    bitcnt = bitcnt - 8
    pos = pos - (if b == 0xFF { 2 } else { 1 })
  }
  let pad_count = bitcnt
  let pad_val = if pad_count > 0 { (bitbuf & ((1UL << pad_count) - 1UL)).to_int() } else { 0 }
  br.pos = pos
  br.bitbuf = 0UL
  br.bitcnt = 0
  br.hit_marker = false
  (pad_count, pad_val)
}

///| Consume the expected `RSTm` marker (plus any extra `0xFF` fill bytes) and return the extra `0xFF` count.
fn jbr_consume_rst(br : JpegBitReader, expected_rst : Int) -> Result[Int, String] {
  let data = br.data
  let end = br.end
  let mut pos = br.pos
  let mut extra_ff = 0
  while pos + 1 < end && data[pos].to_int() == 0xFF && data[pos + 1].to_int() == 0xFF {
    extra_ff = extra_ff + 1
    pos = pos + 1
  }
  if pos + 1 >= end {
    br.pos = pos
    return Err("missing JPEG restart marker")
  }
  let m0 = data[pos].to_int()
  let m1 = data[pos + 1].to_int()
  if m0 != 0xFF || m1 != (0xD0 + (expected_rst & 7)) {
    br.pos = pos
    return Err("unexpected JPEG restart marker")
  }
  br.pos = pos + 2
  br.bitbuf = 0UL
  br.bitcnt = 0
  br.hit_marker = false
  Ok(extra_ff)
}

///| 64-bit MSB-first JPEG entropy-coded bitstream writer with `0xFF 0x00` byte stuffing.
struct JpegBitWriter {
  out : ByteWriter
  mut bitbuf : UInt64
  mut bitcnt : Int
}

///| Create a `JpegBitWriter` appending into `out`.
fn JpegBitWriter::new(out : ByteWriter) -> JpegBitWriter {
  JpegBitWriter::{ out, bitbuf: 0UL, bitcnt: 0 }
}

///| Drain all complete bytes (`bitcnt >= 8`) from `bw` into `bw.out` with `0xFF 0x00` stuffing.
fn jbw_drain_bytes(bw : JpegBitWriter) -> Unit {
  let out = bw.out
  if out.len + 16 > out.cap {
    bw_flush_chunk(out)
  }
  let buf = out.buf
  let start_len = out.len
  let mut len = start_len
  let mut bitcnt = bw.bitcnt
  let bitbuf = bw.bitbuf
  while bitcnt >= 8 {
    bitcnt = bitcnt - 8
    let b = ((bitbuf >> bitcnt) & 0xFFUL).to_int()
    buf[len] = b.to_byte()
    len = len + 1
    if b == 0xFF {
      buf[len] = (0).to_byte()
      len = len + 1
    }
  }
  out.len = len
  out.total_len = out.total_len + (len - start_len)
  bw.bitcnt = bitcnt
}

///| Write `nbits` (0..32) MSB-first bits, byte-stuffing `0xFF` as `0xFF 0x00`.
fn jbw_write_bits(bw : JpegBitWriter, bits : Int, nbits : Int) -> Unit {
  if nbits == 0 {
    return
  }
  let mask = (1UL << nbits) - 1UL
  bw.bitbuf = (bw.bitbuf << nbits) | (bits.to_int64().to_uint64() & mask)
  let new_cnt = bw.bitcnt + nbits
  bw.bitcnt = new_cnt
  if new_cnt >= 32 {
    jbw_drain_bytes(bw)
  }
}

///| Flush the remaining partial byte using the exact `pad_mode` / `pad_val`.
fn jbw_finish_interval(bw : JpegBitWriter, pad_mode : Int, pad_val : Int) -> Unit {
  if bw.bitcnt >= 8 {
    jbw_drain_bytes(bw)
  }
  if bw.bitcnt > 0 {
    let rem = 8 - bw.bitcnt
    let fill = if pad_mode == 0 {
      (1 << rem) - 1
    } else if pad_mode == 1 {
      0
    } else {
      pad_val
    }
    let mask = (1UL << rem) - 1UL
    bw.bitbuf = (bw.bitbuf << rem) | (fill.to_int64().to_uint64() & mask)
    bw.bitcnt = 8
    jbw_drain_bytes(bw)
  }
  bw.bitbuf = 0UL
  bw.bitcnt = 0
}

///| Emit an `RSTm` marker with `extra_ff` leading `0xFF` fill bytes within `max_out`.
fn jbw_write_rst(
  bw : JpegBitWriter,
  rst_idx : Int,
  extra_ff : Int,
  max_out : Int
) -> Result[Unit, String] {
  if extra_ff < 0 || extra_ff > max_out - bw_total_len(bw.out) - 2 {
    return Err("reconstructed JPEG exceeds output limit")
  }
  let mut k = 0
  while k < extra_ff {
    bw_push_byte(bw.out, 0xFF)
    k = k + 1
  }
  bw_push_byte(bw.out, 0xFF)
  bw_push_byte(bw.out, 0xD0 + (rst_idx & 7))
  Ok(())
}
