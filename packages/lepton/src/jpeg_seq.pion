///| Sequential JPEG (SOF0/SOF1) entropy scan decoder and encoder.

///| Decode one sequential 8x8 block; returns `0` on success, writing `(dc, trailing_zrls)` into `out_pair`,
///| or returns a negative error code (`-1` EOF, `-2` invalid huff, `-3` huff OOB, `-4` DC cat, `-5` AC ZRL, `-6` EOBRUN, `-7` AC cat, `-8` AC run).
fn decode_seq_block_fast(
  br : JpegBitReader,
  dc_tbl : HuffTable,
  ac_tbl : HuffTable,
  block : FixedArray[Int],
  base : Int,
  prev_dc : Int,
  out_pair : FixedArray[Int]
) -> Int {
  let dc_fast = dc_tbl.fast_lut
  let ac_fast = ac_tbl.fast_lut
  let mut bitbuf = br.bitbuf
  let mut bitcnt = br.bitcnt
  if bitcnt < 10 && !br.hit_marker {
    br.bitbuf = bitbuf
    br.bitcnt = bitcnt
    jbr_fill(br)
    bitbuf = br.bitbuf
    bitcnt = br.bitcnt
  }
  let dc_cat = if bitcnt >= 10 {
    let peek = ((bitbuf >> (bitcnt - 10)) & 1023UL).to_int()
    let entry = dc_fast[peek]
    if entry != 0 {
      bitcnt = bitcnt - (entry >> 8)
      entry & 0xFF
    } else {
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
      let s = jbr_decode_huff_slow(br, dc_tbl)
      bitbuf = br.bitbuf
      bitcnt = br.bitcnt
      s
    }
  } else {
    br.bitbuf = bitbuf
    br.bitcnt = bitcnt
    let s = jbr_decode_huff_slow(br, dc_tbl)
    bitbuf = br.bitbuf
    bitcnt = br.bitcnt
    s
  }
  if dc_cat < 0 {
    br.bitbuf = bitbuf
    br.bitcnt = bitcnt
    return dc_cat
  }
  if dc_cat > 11 {
    br.bitbuf = bitbuf
    br.bitcnt = bitcnt
    return -4
  }
  let dc_diff = if dc_cat == 0 {
    0
  } else {
    if bitcnt < dc_cat {
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
      jbr_fill(br)
      bitbuf = br.bitbuf
      bitcnt = br.bitcnt
      if bitcnt < dc_cat {
        return -1
      }
    }
    bitcnt = bitcnt - dc_cat
    let raw = ((bitbuf >> bitcnt) & ((1UL << dc_cat) - 1UL)).to_int()
    if raw < (1 << (dc_cat - 1)) { raw - ((1 << dc_cat) - 1) } else { raw }
  }
  let dc = prev_dc + dc_diff
  block[base] = dc

  let mut trailing_zrls = 0
  let mut k = 1
  while k < 64 {
    if bitcnt < 10 && !br.hit_marker {
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
      jbr_fill(br)
      bitbuf = br.bitbuf
      bitcnt = br.bitcnt
    }
    let rs = if bitcnt >= 10 {
      let peek = ((bitbuf >> (bitcnt - 10)) & 1023UL).to_int()
      let entry = ac_fast[peek]
      if entry != 0 {
        bitcnt = bitcnt - (entry >> 8)
        entry & 0xFF
      } else {
        br.bitbuf = bitbuf
        br.bitcnt = bitcnt
        let s = jbr_decode_huff_slow(br, ac_tbl)
        bitbuf = br.bitbuf
        bitcnt = br.bitcnt
        s
      }
    } else {
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
      let s = jbr_decode_huff_slow(br, ac_tbl)
      bitbuf = br.bitbuf
      bitcnt = br.bitcnt
      s
    }
    if rs < 0 {
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
      return rs
    }
    let run = rs >> 4
    let size = rs & 0x0F
    if size == 0 {
      if run == 15 {
        k = k + 16
        if k > 64 {
          br.bitbuf = bitbuf
          br.bitcnt = bitcnt
          return -5
        }
        trailing_zrls = trailing_zrls + 1
      } else if run == 0 {
        break
      } else {
        br.bitbuf = bitbuf
        br.bitcnt = bitcnt
        return -6
      }
    } else {
      if size > 10 {
        br.bitbuf = bitbuf
        br.bitcnt = bitcnt
        return -7
      }
      k = k + run
      if k >= 64 {
        br.bitbuf = bitbuf
        br.bitcnt = bitcnt
        return -8
      }
      if bitcnt < size {
        br.bitbuf = bitbuf
        br.bitcnt = bitcnt
        jbr_fill(br)
        bitbuf = br.bitbuf
        bitcnt = br.bitcnt
        if bitcnt < size {
          return -1
        }
      }
      bitcnt = bitcnt - size
      let raw = ((bitbuf >> bitcnt) & ((1UL << size) - 1UL)).to_int()
      let coef_val = if raw < (1 << (size - 1)) { raw - ((1 << size) - 1) } else { raw }
      block[base + k] = coef_val
      trailing_zrls = 0
      k = k + 1
    }
  }
  br.bitbuf = bitbuf
  br.bitcnt = bitcnt
  out_pair[0] = dc
  out_pair[1] = trailing_zrls
  0
}

///| Convert a negative `decode_seq_block_fast` code to its exact error message.
fn seq_decode_err(code : Int) -> String {
  if code == -1 || code == -2 || code == -3 {
    huff_decode_err(code)
  } else if code == -4 {
    "invalid DC category"
  } else if code == -5 {
    "AC ZRL overflow"
  } else if code == -6 {
    "invalid AC EOBRUN in sequential scan"
  } else if code == -7 {
    "invalid AC category"
  } else {
    "AC run overflow"
  }
}

///| Encode one sequential 8x8 block into `bw`, preserving `extra_zrls` trailing ZRLs if any.
///| Returns `true` on success, `false` if a Huffman symbol is missing from the DHT table.
fn encode_seq_block_fast(
  bw : JpegBitWriter,
  dc_tbl : HuffTable,
  ac_tbl : HuffTable,
  cat_lut : FixedArray[Int],
  block : FixedArray[Int],
  base : Int,
  prev_dc : Int,
  extra_zrls : Int
) -> Bool {
  let dc_codes = dc_tbl.enc_code
  let dc_lens = dc_tbl.enc_len
  let ac_codes = ac_tbl.enc_code
  let ac_lens = ac_tbl.enc_len

  let dc = block[base]
  let diff = dc - prev_dc
  let adiff = if diff < 0 { -diff } else { diff }
  let dc_cat = if adiff < 256 { cat_lut[adiff] } else { jpeg_category(adiff) }
  let dlen = dc_lens[dc_cat]
  if dlen <= 0 {
    return false
  }
  let mut bitbuf = bw.bitbuf
  let mut bitcnt = bw.bitcnt
  if dc_cat == 0 {
    bitbuf = (bitbuf << dlen) | dc_codes[0].to_int64().to_uint64()
    bitcnt = bitcnt + dlen
  } else {
    let dbits = if diff < 0 { diff + ((1 << dc_cat) - 1) } else { diff }
    let tot = dlen + dc_cat
    bitbuf = (bitbuf << tot)
    | (dc_codes[dc_cat].to_int64().to_uint64() << dc_cat)
    | dbits.to_int64().to_uint64()
    bitcnt = bitcnt + tot
  }
  if bitcnt >= 32 {
    bw.bitbuf = bitbuf
    bw.bitcnt = bitcnt
    jbw_drain_bytes(bw)
    bitbuf = bw.bitbuf
    bitcnt = bw.bitcnt
  }

  let mut run = 0
  let mut k = 1
  while k < 64 {
    let v = block[base + k]
    if v == 0 {
      run = run + 1
    } else {
      while run >= 16 {
        let zlen = ac_lens[0xF0]
        if zlen <= 0 {
          return false
        }
        bitbuf = (bitbuf << zlen) | ac_codes[0xF0].to_int64().to_uint64()
        bitcnt = bitcnt + zlen
        if bitcnt >= 32 {
          bw.bitbuf = bitbuf
          bw.bitcnt = bitcnt
          jbw_drain_bytes(bw)
          bitbuf = bw.bitbuf
          bitcnt = bw.bitcnt
        }
        run = run - 16
      }
      let av = if v < 0 { -v } else { v }
      let size = if av < 256 { cat_lut[av] } else { jpeg_category(av) }
      let rs = (run << 4) | size
      let rlen = ac_lens[rs]
      if rlen <= 0 {
        return false
      }
      let cbits = if v < 0 { v + ((1 << size) - 1) } else { v }
      let tot = rlen + size
      bitbuf = (bitbuf << tot)
      | (ac_codes[rs].to_int64().to_uint64() << size)
      | cbits.to_int64().to_uint64()
      bitcnt = bitcnt + tot
      if bitcnt >= 32 {
        bw.bitbuf = bitbuf
        bw.bitcnt = bitcnt
        jbw_drain_bytes(bw)
        bitbuf = bw.bitbuf
        bitcnt = bw.bitcnt
      }
      run = 0
    }
    k = k + 1
  }
  if extra_zrls > 0 {
    let mut z = 0
    let zlen = ac_lens[0xF0]
    let zcode = ac_codes[0xF0].to_int64().to_uint64()
    while z < extra_zrls && run >= 16 {
      if zlen <= 0 {
        return false
      }
      bitbuf = (bitbuf << zlen) | zcode
      bitcnt = bitcnt + zlen
      if bitcnt >= 32 {
        bw.bitbuf = bitbuf
        bw.bitcnt = bitcnt
        jbw_drain_bytes(bw)
        bitbuf = bw.bitbuf
        bitcnt = bw.bitcnt
      }
      run = run - 16
      z = z + 1
    }
  }
  if run > 0 {
    let elen = ac_lens[0x00]
    if elen <= 0 {
      return false
    }
    bitbuf = (bitbuf << elen) | ac_codes[0x00].to_int64().to_uint64()
    bitcnt = bitcnt + elen
    if bitcnt >= 32 {
      bw.bitbuf = bitbuf
      bw.bitcnt = bitcnt
      jbw_drain_bytes(bw)
      bitbuf = bw.bitbuf
      bitcnt = bw.bitcnt
    }
  }
  bw.bitbuf = bitbuf
  bw.bitcnt = bitcnt
  true
}

///| Decode a sequential scan (`SOF0`/`SOF1`) into `coeffs`.
fn decode_sequential_scan(
  jpeg : Bytes,
  img : JpegImage,
  scan : ScanInfo,
  coeffs : Array[FixedArray[Int]]
) -> Result[ScanMeta, String] {
  let br = JpegBitReader::new(jpeg, scan.ecs_start, scan.ecs_end)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let out_pair = FixedArray::make(2, 0)
  let pad_counts : Array[Int] = []
  let pad_vals : Array[Int] = []
  let extra_ffs : Array[Int] = []
  let seq_trailing_zrls : Array[(Int, Int)] = []

  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let dri = scan.dri
  let mut mcu_idx = 0
  let mut block_seq_idx = 0
  let mut rst_idx = 0
  let mut mcu_in_interval = 0

  if ns == 1 {
    let sc = scan.comps[0]
    let ci = img.components[sc.comp_idx]
    let dc_tbl = scan.dc_tables[sc.dc_tbl]
    let ac_tbl = scan.ac_tables[sc.ac_tbl]
    let blk = coeffs[sc.comp_idx]
    let actual_w = ci.actual_w
    let stride_w = ci.stride_w
    let mut bx = 0
    let mut by = 0
    while mcu_idx < total_mcus {
      let base = (by * stride_w + bx) * 64
      let rc = decode_seq_block_fast(br, dc_tbl, ac_tbl, blk, base, prev_dc[0], out_pair)
      if rc < 0 {
        return Err(seq_decode_err(rc))
      }
      prev_dc[0] = out_pair[0]
      let tz = out_pair[1]
      if tz > 0 {
        seq_trailing_zrls.push((block_seq_idx, tz))
      }
      block_seq_idx = block_seq_idx + 1
      bx = bx + 1
      if bx == actual_w {
        bx = 0
        by = by + 1
      }
      mcu_idx = mcu_idx + 1
      mcu_in_interval = mcu_in_interval + 1
      if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
        let (pc, pv) = jbr_finish_interval(br)
        pad_counts.push(pc)
        pad_vals.push(pv)
        match jbr_consume_rst(br, rst_idx) {
          Ok(eff) => extra_ffs.push(eff)
          Err(e) => return Err(e)
        }
        rst_idx = rst_idx + 1
        mcu_in_interval = 0
        prev_dc[0] = 0
      }
    }
  } else {
    let mcu_w = img.mcu_w
    let mut mx = 0
    let mut my = 0
    while mcu_idx < total_mcus {
      let mut s = 0
      while s < ns {
        let sc = scan.comps[s]
        let ci = img.components[sc.comp_idx]
        let dc_tbl = scan.dc_tables[sc.dc_tbl]
        let ac_tbl = scan.ac_tables[sc.ac_tbl]
        let blk = coeffs[sc.comp_idx]
        let stride_w = ci.stride_w
        let base_bx = mx * ci.h_samp
        let base_by = my * ci.v_samp
        let mut vy = 0
        while vy < ci.v_samp {
          let row_base = (base_by + vy) * stride_w + base_bx
          let mut hx = 0
          while hx < ci.h_samp {
            let base = (row_base + hx) * 64
            let rc = decode_seq_block_fast(br, dc_tbl, ac_tbl, blk, base, prev_dc[s], out_pair)
            if rc < 0 {
              return Err(seq_decode_err(rc))
            }
            prev_dc[s] = out_pair[0]
            let tz = out_pair[1]
            if tz > 0 {
              seq_trailing_zrls.push((block_seq_idx, tz))
            }
            block_seq_idx = block_seq_idx + 1
            hx = hx + 1
          }
          vy = vy + 1
        }
        s = s + 1
      }
      mx = mx + 1
      if mx == mcu_w {
        mx = 0
        my = my + 1
      }
      mcu_idx = mcu_idx + 1
      mcu_in_interval = mcu_in_interval + 1
      if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
        let (pc, pv) = jbr_finish_interval(br)
        pad_counts.push(pc)
        pad_vals.push(pv)
        match jbr_consume_rst(br, rst_idx) {
          Ok(eff) => extra_ffs.push(eff)
          Err(e) => return Err(e)
        }
        rst_idx = rst_idx + 1
        mcu_in_interval = 0
        prev_dc[0] = 0
        prev_dc[1] = 0
        prev_dc[2] = 0
        prev_dc[3] = 0
      }
    }
  }
  let (pc, pv) = jbr_finish_interval(br)
  pad_counts.push(pc)
  pad_vals.push(pv)
  let trailing = if br.pos < scan.ecs_end {
    jpeg.slice(br.pos, scan.ecs_end)
  } else {
    Bytes::new(0)
  }
  let (pad_mode, pad_bits) = classify_pad_bits(pad_counts, pad_vals)
  let (rst_extra_ff_mode, rst_extra_ff) = classify_rst_ff(extra_ffs)
  Ok(ScanMeta::{
    pad_mode,
    pad_bits,
    rst_extra_ff_mode,
    rst_extra_ff,
    seq_trailing_zrls,
    prog_eob_runs: [],
    trailing,
  })
}

///| Encode a sequential scan (`SOF0`/`SOF1`) from `coeffs` into `out`.
fn encode_sequential_scan(
  img : JpegImage,
  scan : ScanInfo,
  meta : ScanMeta,
  coeffs : Array[FixedArray[Int]],
  out : ByteWriter
) -> Result[Unit, String] {
  let bw = JpegBitWriter::new(out)
  let cat_lut = build_cat_lut()
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let dri = scan.dri
  let zrl_len = meta.seq_trailing_zrls.length()
  let mut mcu_idx = 0
  let mut block_seq_idx = 0
  let mut zrl_cursor = 0
  let mut interval_idx = 0
  let mut mcu_in_interval = 0

  if ns == 1 {
    let sc = scan.comps[0]
    let ci = img.components[sc.comp_idx]
    let dc_tbl = scan.dc_tables[sc.dc_tbl]
    let ac_tbl = scan.ac_tables[sc.ac_tbl]
    let blk = coeffs[sc.comp_idx]
    let actual_w = ci.actual_w
    let stride_w = ci.stride_w
    let mut bx = 0
    let mut by = 0
    while mcu_idx < total_mcus {
      if bw_total_len(out) > max_output_bytes {
        return Err("reconstructed JPEG exceeds output limit")
      }
      let base = (by * stride_w + bx) * 64
      let extra_zrls = if zrl_cursor < zrl_len {
        let (bidx, cnt) = meta.seq_trailing_zrls[zrl_cursor]
        if bidx == block_seq_idx {
          zrl_cursor = zrl_cursor + 1
          cnt
        } else {
          0
        }
      } else {
        0
      }
      block_seq_idx = block_seq_idx + 1
      if !encode_seq_block_fast(bw, dc_tbl, ac_tbl, cat_lut, blk, base, prev_dc[0], extra_zrls) {
        return Err("symbol missing from DHT table")
      }
      prev_dc[0] = blk[base]
      bx = bx + 1
      if bx == actual_w {
        bx = 0
        by = by + 1
      }
      mcu_idx = mcu_idx + 1
      mcu_in_interval = mcu_in_interval + 1
      if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
        let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
          meta.pad_bits[interval_idx]
        } else {
          0
        }
        jbw_finish_interval(bw, meta.pad_mode, pv)
        let eff = if meta.rst_extra_ff_mode == 1 && interval_idx < meta.rst_extra_ff.length() {
          meta.rst_extra_ff[interval_idx]
        } else {
          0
        }
        match jbw_write_rst(bw, interval_idx, eff, max_output_bytes) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        interval_idx = interval_idx + 1
        mcu_in_interval = 0
        prev_dc[0] = 0
      }
    }
  } else {
    let mcu_w = img.mcu_w
    let mut mx = 0
    let mut my = 0
    while mcu_idx < total_mcus {
      if bw_total_len(out) > max_output_bytes {
        return Err("reconstructed JPEG exceeds output limit")
      }
      let mut s = 0
      while s < ns {
        let sc = scan.comps[s]
        let ci = img.components[sc.comp_idx]
        let dc_tbl = scan.dc_tables[sc.dc_tbl]
        let ac_tbl = scan.ac_tables[sc.ac_tbl]
        let blk = coeffs[sc.comp_idx]
        let stride_w = ci.stride_w
        let base_bx = mx * ci.h_samp
        let base_by = my * ci.v_samp
        let mut vy = 0
        while vy < ci.v_samp {
          let row_base = (base_by + vy) * stride_w + base_bx
          let mut hx = 0
          while hx < ci.h_samp {
            let base = (row_base + hx) * 64
            let extra_zrls = if zrl_cursor < zrl_len {
              let (bidx, cnt) = meta.seq_trailing_zrls[zrl_cursor]
              if bidx == block_seq_idx {
                zrl_cursor = zrl_cursor + 1
                cnt
              } else {
                0
              }
            } else {
              0
            }
            block_seq_idx = block_seq_idx + 1
            if !encode_seq_block_fast(bw, dc_tbl, ac_tbl, cat_lut, blk, base, prev_dc[s], extra_zrls) {
              return Err("symbol missing from DHT table")
            }
            prev_dc[s] = blk[base]
            hx = hx + 1
          }
          vy = vy + 1
        }
        s = s + 1
      }
      mx = mx + 1
      if mx == mcu_w {
        mx = 0
        my = my + 1
      }
      mcu_idx = mcu_idx + 1
      mcu_in_interval = mcu_in_interval + 1
      if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
        let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
          meta.pad_bits[interval_idx]
        } else {
          0
        }
        jbw_finish_interval(bw, meta.pad_mode, pv)
        let eff = if meta.rst_extra_ff_mode == 1 && interval_idx < meta.rst_extra_ff.length() {
          meta.rst_extra_ff[interval_idx]
        } else {
          0
        }
        match jbw_write_rst(bw, interval_idx, eff, max_output_bytes) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        interval_idx = interval_idx + 1
        mcu_in_interval = 0
        prev_dc[0] = 0
        prev_dc[1] = 0
        prev_dc[2] = 0
        prev_dc[3] = 0
      }
    }
  }
  let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
    meta.pad_bits[interval_idx]
  } else {
    0
  }
  jbw_finish_interval(bw, meta.pad_mode, pv)
  if meta.trailing.length() > max_output_bytes - bw_total_len(out) {
    return Err("reconstructed JPEG exceeds output limit")
  }
  bw_push_bytes(out, meta.trailing)
  Ok(())
}
