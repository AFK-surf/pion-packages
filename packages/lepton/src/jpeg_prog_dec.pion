///| Progressive JPEG (SOF2) entropy scan decoder and scan dispatch.

///| Decode a progressive scan (`SOF2`: DC first/refine, AC first/refine) into `coeffs`.
fn decode_progressive_scan(
  jpeg : Bytes,
  img : JpegImage,
  scan : ScanInfo,
  coeffs : Array[FixedArray[Int]]
) -> Result[ScanMeta, String] {
  let br = JpegBitReader::new(jpeg, scan.ecs_start, scan.ecs_end)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let pad_counts : Array[Int] = []
  let pad_vals : Array[Int] = []
  let extra_ffs : Array[Int] = []
  let seq_trailing_zrls : Array[(Int, Int)] = []
  let prog_eob_runs : Array[Int] = []
  let mut eobrun = 0

  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let dri = scan.dri
  let ss = scan.ss
  let se = scan.se
  let ah = scan.ah
  let al = scan.al
  let mut mcu_idx = 0
  let mut rst_idx = 0
  let mut mcu_in_interval = 0

  if ss == 0 {
    // Progressive DC scan (interleaved or non-interleaved)
    if ns == 1 {
      let sc = scan.comps[0]
      let ci = img.components[sc.comp_idx]
      let dc_tbl = scan.dc_tables[sc.dc_tbl]
      let blk = coeffs[sc.comp_idx]
      let actual_w = ci.actual_w
      let stride_w = ci.stride_w
      let p1 = 1 << al
      let mut bx = 0
      let mut by = 0
      while mcu_idx < total_mcus {
        let base = (by * stride_w + bx) * 64
        if ah == 0 {
          let dc_cat = jbr_decode_huff_fast(br, dc_tbl)
          if dc_cat < 0 {
            return Err(huff_decode_err(dc_cat))
          }
          if dc_cat > 11 {
            return Err("invalid progressive DC category")
          }
          let diff = if dc_cat == 0 {
            0
          } else {
            let raw = jbr_read_bits_fast(br, dc_cat)
            if raw < 0 {
              return Err("unexpected end of JPEG entropy stream")
            }
            jpeg_extend(raw, dc_cat)
          }
          prev_dc[0] = prev_dc[0] + diff
          blk[base] = prev_dc[0] << al
        } else {
          let bit = jbr_read_bit_fast(br)
          if bit < 0 {
            return Err("unexpected end of JPEG entropy stream")
          }
          if bit != 0 {
            blk[base] = blk[base] | p1
          }
        }
        bx = bx + 1
        if bx == actual_w {
          bx = 0
          by = by + 1
        }
        mcu_idx = mcu_idx + 1
        mcu_in_interval = mcu_in_interval + 1
        if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
          let (pc, pv) = jbr_finish_interval(br)
          pad_counts.push(pc)
          pad_vals.push(pv)
          match jbr_consume_rst(br, rst_idx) {
            Ok(eff) => extra_ffs.push(eff)
            Err(e) => return Err(e)
          }
          rst_idx = rst_idx + 1
          mcu_in_interval = 0
          prev_dc[0] = 0
        }
      }
    } else {
      let mcu_w = img.mcu_w
      let p1 = 1 << al
      let mut mx = 0
      let mut my = 0
      while mcu_idx < total_mcus {
        let mut s = 0
        while s < ns {
          let sc = scan.comps[s]
          let ci = img.components[sc.comp_idx]
          let dc_tbl = scan.dc_tables[sc.dc_tbl]
          let blk = coeffs[sc.comp_idx]
          let stride_w = ci.stride_w
          let base_bx = mx * ci.h_samp
          let base_by = my * ci.v_samp
          let mut vy = 0
          while vy < ci.v_samp {
            let row_base = (base_by + vy) * stride_w + base_bx
            let mut hx = 0
            while hx < ci.h_samp {
              let base = (row_base + hx) * 64
              if ah == 0 {
                let dc_cat = jbr_decode_huff_fast(br, dc_tbl)
                if dc_cat < 0 {
                  return Err(huff_decode_err(dc_cat))
                }
                if dc_cat > 11 {
                  return Err("invalid progressive DC category")
                }
                let diff = if dc_cat == 0 {
                  0
                } else {
                  let raw = jbr_read_bits_fast(br, dc_cat)
                  if raw < 0 {
                    return Err("unexpected end of JPEG entropy stream")
                  }
                  jpeg_extend(raw, dc_cat)
                }
                prev_dc[s] = prev_dc[s] + diff
                blk[base] = prev_dc[s] << al
              } else {
                let bit = jbr_read_bit_fast(br)
                if bit < 0 {
                  return Err("unexpected end of JPEG entropy stream")
                }
                if bit != 0 {
                  blk[base] = blk[base] | p1
                }
              }
              hx = hx + 1
            }
            vy = vy + 1
          }
          s = s + 1
        }
        mx = mx + 1
        if mx == mcu_w {
          mx = 0
          my = my + 1
        }
        mcu_idx = mcu_idx + 1
        mcu_in_interval = mcu_in_interval + 1
        if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
          let (pc, pv) = jbr_finish_interval(br)
          pad_counts.push(pc)
          pad_vals.push(pv)
          match jbr_consume_rst(br, rst_idx) {
            Ok(eff) => extra_ffs.push(eff)
            Err(e) => return Err(e)
          }
          rst_idx = rst_idx + 1
          mcu_in_interval = 0
          prev_dc[0] = 0
          prev_dc[1] = 0
          prev_dc[2] = 0
          prev_dc[3] = 0
        }
      }
    }
  } else {
    // Progressive AC scan (always single component)
    let sc = scan.comps[0]
    let ci = img.components[sc.comp_idx]
    let ac_tbl = scan.ac_tables[sc.ac_tbl]
    let ac_fast = ac_tbl.fast_lut
    let blk = coeffs[sc.comp_idx]
    let actual_w = ci.actual_w
    let stride_w = ci.stride_w
    let p1 = 1 << al
    let m1 = -p1
    let mut bx = 0
    let mut by = 0
    if ah == 0 {
      // AC first scan
      let mut bitbuf = br.bitbuf
      let mut bitcnt = br.bitcnt
      while mcu_idx < total_mcus {
        if eobrun > 0 {
          eobrun = eobrun - 1
        } else {
          let base = (by * stride_w + bx) * 64
          let mut trailing_zrls = 0
          let mut k = ss
          while k <= se {
            if bitcnt < 10 && !br.hit_marker {
              br.bitbuf = bitbuf
              br.bitcnt = bitcnt
              jbr_fill(br)
              bitbuf = br.bitbuf
              bitcnt = br.bitcnt
            }
            let rs = if bitcnt >= 10 {
              let peek = ((bitbuf >> (bitcnt - 10)) & 1023UL).to_int()
              let entry = ac_fast[peek]
              if entry != 0 {
                bitcnt = bitcnt - (entry >> 8)
                entry & 0xFF
              } else {
                br.bitbuf = bitbuf
                br.bitcnt = bitcnt
                let s = jbr_decode_huff_slow(br, ac_tbl)
                bitbuf = br.bitbuf
                bitcnt = br.bitcnt
                s
              }
            } else {
              br.bitbuf = bitbuf
              br.bitcnt = bitcnt
              let s = jbr_decode_huff_slow(br, ac_tbl)
              bitbuf = br.bitbuf
              bitcnt = br.bitcnt
              s
            }
            if rs < 0 {
              return Err(huff_decode_err(rs))
            }
            let r = rs >> 4
            let s = rs & 0x0F
            if s == 0 {
              if r == 15 {
                k = k + 16
                if k > se + 1 {
                  return Err("progressive AC first ZRL overflow")
                }
                trailing_zrls = trailing_zrls + 1
              } else {
                let extra = if r == 0 {
                  0
                } else {
                  if bitcnt < r {
                    br.bitbuf = bitbuf
                    br.bitcnt = bitcnt
                    jbr_fill(br)
                    bitbuf = br.bitbuf
                    bitcnt = br.bitcnt
                    if bitcnt < r {
                      return Err("unexpected end of JPEG entropy stream")
                    }
                  }
                  bitcnt = bitcnt - r
                  ((bitbuf >> bitcnt) & ((1UL << r) - 1UL)).to_int()
                }
                let run_len = (1 << r) + extra
                prog_eob_runs.push(run_len)
                eobrun = run_len - 1
                break
              }
            } else {
              k = k + r
              if k > se {
                return Err("progressive AC first run overflow")
              }
              if bitcnt < s {
                br.bitbuf = bitbuf
                br.bitcnt = bitcnt
                jbr_fill(br)
                bitbuf = br.bitbuf
                bitcnt = br.bitcnt
                if bitcnt < s {
                  return Err("unexpected end of JPEG entropy stream")
                }
              }
              bitcnt = bitcnt - s
              let raw = ((bitbuf >> bitcnt) & ((1UL << s) - 1UL)).to_int()
              let coef_val = if raw < (1 << (s - 1)) { raw - ((1 << s) - 1) } else { raw }
              blk[base + k] = coef_val << al
              trailing_zrls = 0
              k = k + 1
            }
          }
          if trailing_zrls > 0 {
            seq_trailing_zrls.push((mcu_idx, trailing_zrls))
          }
        }
        bx = bx + 1
        if bx == actual_w {
          bx = 0
          by = by + 1
        }
        mcu_idx = mcu_idx + 1
        mcu_in_interval = mcu_in_interval + 1
        if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
          br.bitbuf = bitbuf
          br.bitcnt = bitcnt
          let (pc, pv) = jbr_finish_interval(br)
          pad_counts.push(pc)
          pad_vals.push(pv)
          match jbr_consume_rst(br, rst_idx) {
            Ok(eff) => extra_ffs.push(eff)
            Err(e) => return Err(e)
          }
          bitbuf = br.bitbuf
          bitcnt = br.bitcnt
          rst_idx = rst_idx + 1
          mcu_in_interval = 0
          eobrun = 0
        }
      }
      br.bitbuf = bitbuf
      br.bitcnt = bitcnt
    } else {
      // AC refinement scan
      while mcu_idx < total_mcus {
        let base = (by * stride_w + bx) * 64
        let mut trailing_zrls = 0
        let mut k = ss
        if eobrun == 0 {
          while k <= se {
            if br.bitcnt < 10 && !br.hit_marker {
              jbr_fill(br)
            }
            let rs = if br.bitcnt >= 10 {
              let peek = ((br.bitbuf >> (br.bitcnt - 10)) & 1023UL).to_int()
              let entry = ac_fast[peek]
              if entry != 0 {
                br.bitcnt = br.bitcnt - (entry >> 8)
                entry & 0xFF
              } else {
                jbr_decode_huff_slow(br, ac_tbl)
              }
            } else {
              jbr_decode_huff_slow(br, ac_tbl)
            }
            if rs < 0 {
              return Err(huff_decode_err(rs))
            }
            let mut r = rs >> 4
            let s = rs & 0x0F
            let mut new_val = 0
            if s != 0 {
              if s != 1 {
                return Err("invalid AC refinement magnitude")
              }
              let sign_bit = jbr_read_bit_fast(br)
              if sign_bit < 0 {
                return Err("unexpected end of JPEG entropy stream")
              }
              new_val = if sign_bit != 0 { p1 } else { m1 }
            } else if r != 15 {
              let extra = if r == 0 {
                0
              } else {
                let raw = jbr_read_bits_fast(br, r)
                if raw < 0 {
                  return Err("unexpected end of JPEG entropy stream")
                }
                raw
              }
              let run_len = (1 << r) + extra
              prog_eob_runs.push(run_len)
              eobrun = run_len
              break
            }
            while k <= se {
              let cur = blk[base + k]
              if cur != 0 {
                let corr = jbr_read_bit_fast(br)
                if corr < 0 {
                  return Err("unexpected end of JPEG entropy stream")
                }
                if corr != 0 {
                  if (cur & p1) == 0 {
                    blk[base + k] = if cur > 0 { cur + p1 } else { cur + m1 }
                  }
                }
              } else {
                if r == 0 {
                  break
                }
                r = r - 1
              }
              k = k + 1
            }
            if s != 0 {
              if k > se {
                return Err("progressive AC refine run overflow")
              }
              blk[base + k] = new_val
              trailing_zrls = 0
              k = k + 1
            } else {
              trailing_zrls = trailing_zrls + 1
              k = k + 1
            }
          }
          if trailing_zrls > 0 {
            seq_trailing_zrls.push((mcu_idx, trailing_zrls))
          }
        }
        if eobrun > 0 {
          while k <= se {
            let cur = blk[base + k]
            if cur != 0 {
              let corr = jbr_read_bit_fast(br)
              if corr < 0 {
                return Err("unexpected end of JPEG entropy stream")
              }
              if corr != 0 {
                if (cur & p1) == 0 {
                  blk[base + k] = if cur > 0 { cur + p1 } else { cur + m1 }
                }
              }
            }
            k = k + 1
          }
          eobrun = eobrun - 1
        }
        bx = bx + 1
        if bx == actual_w {
          bx = 0
          by = by + 1
        }
        mcu_idx = mcu_idx + 1
        mcu_in_interval = mcu_in_interval + 1
        if dri > 0 && mcu_in_interval == dri && mcu_idx < total_mcus {
          let (pc, pv) = jbr_finish_interval(br)
          pad_counts.push(pc)
          pad_vals.push(pv)
          match jbr_consume_rst(br, rst_idx) {
            Ok(eff) => extra_ffs.push(eff)
            Err(e) => return Err(e)
          }
          rst_idx = rst_idx + 1
          mcu_in_interval = 0
          eobrun = 0
        }
      }
    }
  }
  let (pc, pv) = jbr_finish_interval(br)
  pad_counts.push(pc)
  pad_vals.push(pv)
  let trailing = if br.pos < scan.ecs_end {
    jpeg.slice(br.pos, scan.ecs_end)
  } else {
    Bytes::new(0)
  }
  let (pad_mode, pad_bits) = classify_pad_bits(pad_counts, pad_vals)
  let (rst_extra_ff_mode, rst_extra_ff) = classify_rst_ff(extra_ffs)
  Ok(ScanMeta::{
    pad_mode,
    pad_bits,
    rst_extra_ff_mode,
    rst_extra_ff,
    seq_trailing_zrls,
    prog_eob_runs,
    trailing,
  })
}

///| Decode all scans of `img` into per-component 8x8 DCT coefficient arrays.
fn decode_all_scans(
  jpeg : Bytes,
  img : JpegImage
) -> Result[(Array[FixedArray[Int]], Array[ScanMeta]), String] {
  let mut approx_meta = 0
  let mut ch = 0
  while ch < img.chunks.length() {
    let clen = img.chunks[ch].length()
    if clen > max_meta_bytes - approx_meta {
      return Err("JPEG metadata exceeds limit")
    }
    approx_meta = approx_meta + clen
    ch = ch + 1
  }
  let coeffs : Array[FixedArray[Int]] = []
  let mut c = 0
  while c < img.components.length() {
    let ci = img.components[c]
    coeffs.push(FixedArray::make(ci.stride_w * ci.stride_h * 64, 0))
    c = c + 1
  }
  let metas : Array[ScanMeta] = []
  let mut s = 0
  while s < img.scans.length() {
    let scan = img.scans[s]
    let meta = if img.is_progressive {
      match decode_progressive_scan(jpeg, img, scan, coeffs) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
    } else {
      match decode_sequential_scan(jpeg, img, scan, coeffs) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
    }
    let scan_meta_est = meta.trailing.length()
    + meta.pad_bits.length()
    + meta.rst_extra_ff.length()
    + meta.seq_trailing_zrls.length() * 2
    + meta.prog_eob_runs.length()
    if scan_meta_est > max_meta_bytes - approx_meta {
      return Err("JPEG metadata exceeds limit")
    }
    approx_meta = approx_meta + scan_meta_est
    metas.push(meta)
    s = s + 1
  }
  Ok((coeffs, metas))
}

///| Reconstruct the exact JPEG byte stream from parsed structure, coefficients, and scan metadata.
fn encode_jpeg_from_coeffs(
  img : JpegImage,
  coeffs : Array[FixedArray[Int]],
  metas : Array[ScanMeta]
) -> Result[Bytes, String] {
  let mut est = 0
  let mut ci = 0
  while ci < img.components.length() {
    let comp = img.components[ci]
    est = est + comp.stride_w * comp.stride_h * 12
    ci = ci + 1
  }
  let init_cap = if est < 1024 { 1024 } else if est > 65536 { 65536 } else { est }
  let out = ByteWriter::new(init_cap)
  if img.chunks[0].length() > max_output_bytes {
    return Err("reconstructed JPEG exceeds output limit")
  }
  bw_push_bytes(out, img.chunks[0])
  let mut s = 0
  while s < img.scans.length() {
    let scan = img.scans[s]
    let meta = metas[s]
    let res = if img.is_progressive {
      encode_progressive_scan(img, scan, meta, coeffs, out)
    } else {
      encode_sequential_scan(img, scan, meta, coeffs, out)
    }
    match res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let next_chunk = img.chunks[s + 1]
    if next_chunk.length() > max_output_bytes - bw_total_len(out) {
      return Err("reconstructed JPEG exceeds output limit")
    }
    bw_push_bytes(out, next_chunk)
    s = s + 1
  }
  Ok(bw_to_bytes(out))
}
