///| Context tables, predictors, and symmetric DC/AC symbol coders for 8x8 DCT blocks.

///| Map zig-zag index `1..63` to one of 16 frequency bands for `is_nonzero` contexts.
fn ac_band16(k : Int) -> Int {
  if k <= 8 {
    k - 1
  } else if k <= 14 {
    8 + ((k - 9) >> 1)
  } else if k <= 26 {
    11 + ((k - 15) >> 2)
  } else if k <= 42 {
    14
  } else {
    15
  }
}

///| Map zig-zag index `1..63` to one of 8 frequency bands for magnitude/sign contexts.
fn ac_band8(k : Int) -> Int {
  if k <= 2 {
    0
  } else if k <= 5 {
    1
  } else if k <= 9 {
    2
  } else if k <= 14 {
    3
  } else if k <= 20 {
    4
  } else if k <= 30 {
    5
  } else if k <= 45 {
    6
  } else {
    7
  }
}

///| Bucket remaining non-zero count into 4 states (`0..3`).
fn rem_nz_bucket4(rem : Int) -> Int {
  if rem <= 1 {
    0
  } else if rem <= 3 {
    1
  } else if rem <= 8 {
    2
  } else {
    3
  }
}

///| Bucket neighbor non-zero count average into 8 states (`0..7`).
fn avg_nz_bucket8(avg : Int) -> Int {
  if avg == 0 {
    0
  } else if avg == 1 {
    1
  } else if avg <= 3 {
    2
  } else if avg <= 7 {
    3
  } else if avg <= 14 {
    4
  } else if avg <= 24 {
    5
  } else if avg <= 39 {
    6
  } else {
    7
  }
}

///| Bucket DC residual magnitude into 8 states (`0..7`).
fn dc_mag_bucket8(mag : Int) -> Int {
  if mag <= 1 {
    mag
  } else if mag <= 3 {
    2
  } else if mag <= 7 {
    3
  } else if mag <= 15 {
    4
  } else if mag <= 31 {
    5
  } else if mag <= 63 {
    6
  } else {
    7
  }
}

///| MED (JPEG-LS) gradient-clamped 2D predictor for DC coefficients.
fn med_predict(left : Int, top : Int, top_left : Int) -> Int {
  let min_lt = if left < top { left } else { top }
  let max_lt = if left > top { left } else { top }
  if top_left >= max_lt {
    min_lt
  } else if top_left <= min_lt {
    max_lt
  } else {
    left + top - top_left
  }
}

///| Compute floor(log2(v)) for `v >= 1`.
fn floor_log2(v : Int) -> Int {
  if v < 16 {
    if v < 4 {
      if v < 2 { 0 } else { 1 }
    } else if v < 8 {
      2
    } else {
      3
    }
  } else if v < 256 {
    if v < 64 {
      if v < 32 { 4 } else { 5 }
    } else if v < 128 {
      6
    } else {
      7
    }
  } else {
    let mut e = 8
    let mut x = v >> 9
    while x > 0 {
      e = e + 1
      x = x >> 1
    }
    e
  }
}

///| Adaptive probability tables for DCT coefficient coding.
struct DctModel {
  dc_nz : FixedArray[Int] // 2 * 8 = 16
  dc_sign : FixedArray[Int] // 2 * 8 = 16
  dc_gt1 : FixedArray[Int] // 2 * 8 = 16
  dc_exp : FixedArray[Int] // 2 * 8 * 12 = 192
  dc_mant : FixedArray[Int] // 2 * 12 = 24
  nz_zero : FixedArray[Int] // 2 * 8 = 16
  nz_exp : FixedArray[Int] // 2 * 8 * 6 = 96
  nz_mant : FixedArray[Int] // 2 * 6 * 5 = 60
  ac_nz : FixedArray[Int] // 2 * 16 * 4 * 2 = 256
  ac_sign : FixedArray[Int] // 2 * 8 = 16
  ac_gt1 : FixedArray[Int] // 2 * 8 * 4 = 64
  ac_exp : FixedArray[Int] // 2 * 8 * 11 = 176
  ac_mant : FixedArray[Int] // 2 * 8 * 11 = 176
}

///| Create a fresh `DctModel` with all probabilities initialized to 50%.
fn DctModel::new() -> DctModel {
  DctModel::{
    dc_nz: FixedArray::make(16, prob_init),
    dc_sign: FixedArray::make(16, prob_init),
    dc_gt1: FixedArray::make(16, prob_init),
    dc_exp: FixedArray::make(192, prob_init),
    dc_mant: FixedArray::make(24, prob_init),
    nz_zero: FixedArray::make(16, prob_init),
    nz_exp: FixedArray::make(96, prob_init),
    nz_mant: FixedArray::make(60, prob_init),
    ac_nz: FixedArray::make(256, prob_init),
    ac_sign: FixedArray::make(16, prob_init),
    ac_gt1: FixedArray::make(64, prob_init),
    ac_exp: FixedArray::make(176, prob_init),
    ac_mant: FixedArray::make(176, prob_init),
  }
}

///| Encode block AC non-zero count `nz` (`0..63`) conditioned on neighbor bucket.
fn encode_nz_count(re : RangeEncoder, model : DctModel, chroma : Int, avg_b : Int, nz : Int) -> Unit {
  let ctx = chroma * 8 + avg_b
  let nz_zero = model.nz_zero
  let mut range = re.range
  let mut low = re.low
  let p0 = nz_zero[ctx]
  let b0 = (range >> 12) * p0.to_int64().to_uint64()
  if nz == 0 {
    range = b0
    nz_zero[ctx] = p0 + ((4096 - p0) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    re.range = range
    re.low = low
    return
  }
  low = low + b0
  range = range - b0
  nz_zero[ctx] = p0 - (p0 >> 4)
  while range < 0x01000000UL {
    range = range << 8
    re.low = low
    re_shift_low(re)
    low = re.low
  }
  let exp = floor_log2(nz)
  let nz_exp = model.nz_exp
  let exp_base = ctx * 6
  let mut e = 0
  while e < exp && e < 5 {
    let pe = nz_exp[exp_base + e]
    let be = (range >> 12) * pe.to_int64().to_uint64()
    low = low + be
    range = range - be
    nz_exp[exp_base + e] = pe - (pe >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    e = e + 1
  }
  if exp < 5 {
    let pe = nz_exp[exp_base + exp]
    let be = (range >> 12) * pe.to_int64().to_uint64()
    range = be
    nz_exp[exp_base + exp] = pe + ((4096 - pe) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
  }
  let body = nz - (1 << exp)
  let nz_mant = model.nz_mant
  let mant_base = (chroma * 6 + exp) * 5
  let mut i = exp - 1
  while i >= 0 {
    let pm = nz_mant[mant_base + i]
    let bm = (range >> 12) * pm.to_int64().to_uint64()
    if ((body >> i) & 1) == 0 {
      range = bm
      nz_mant[mant_base + i] = pm + ((4096 - pm) >> 4)
    } else {
      low = low + bm
      range = range - bm
      nz_mant[mant_base + i] = pm - (pm >> 4)
    }
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    i = i - 1
  }
  re.range = range
  re.low = low
}

///| Decode block AC non-zero count (`0..63`).
fn decode_nz_count(rd : RangeDecoder, model : DctModel, chroma : Int, avg_b : Int) -> Int {
  let ctx = chroma * 8 + avg_b
  let nz_zero = model.nz_zero
  let data = rd.data
  let end = rd.end
  let mut pos = rd.pos
  let mut range = rd.range
  let mut code = rd.code
  let mut eof_reads = rd.eof_reads

  let p0 = nz_zero[ctx]
  let b0 = (range >> 12) * p0.to_int64().to_uint64()
  if code < b0 {
    range = b0
    nz_zero[ctx] = p0 + ((4096 - p0) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    rd.pos = pos
    rd.range = range
    rd.code = code
    rd.eof_reads = eof_reads
    return 0
  }
  code = code - b0
  range = range - b0
  nz_zero[ctx] = p0 - (p0 >> 4)
  while range < 0x01000000UL {
    range = range << 8
    let b = if pos < end {
      let bv = data[pos].to_int().to_int64().to_uint64()
      pos = pos + 1
      bv
    } else {
      eof_reads = eof_reads + 1
      0UL
    }
    code = (code << 8) | b
  }

  let nz_exp = model.nz_exp
  let exp_base = ctx * 6
  let mut exp = 0
  while exp < 5 {
    let pe = nz_exp[exp_base + exp]
    let be = (range >> 12) * pe.to_int64().to_uint64()
    if code < be {
      range = be
      nz_exp[exp_base + exp] = pe + ((4096 - pe) >> 4)
      while range < 0x01000000UL {
        range = range << 8
        let b = if pos < end {
          let bv = data[pos].to_int().to_int64().to_uint64()
          pos = pos + 1
          bv
        } else {
          eof_reads = eof_reads + 1
          0UL
        }
        code = (code << 8) | b
      }
      break
    }
    code = code - be
    range = range - be
    nz_exp[exp_base + exp] = pe - (pe >> 4)
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    exp = exp + 1
  }

  let nz_mant = model.nz_mant
  let mant_base = (chroma * 6 + exp) * 5
  let mut body = 0
  let mut i = exp - 1
  while i >= 0 {
    let pm = nz_mant[mant_base + i]
    let bm = (range >> 12) * pm.to_int64().to_uint64()
    if code < bm {
      range = bm
      nz_mant[mant_base + i] = pm + ((4096 - pm) >> 4)
      body = body << 1
    } else {
      code = code - bm
      range = range - bm
      nz_mant[mant_base + i] = pm - (pm >> 4)
      body = (body << 1) | 1
    }
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    i = i - 1
  }
  rd.pos = pos
  rd.range = range
  rd.code = code
  rd.eof_reads = eof_reads
  (1 << exp) + body
}

///| Encode a signed DC residual `diff` symmetrically up to `1073741823`; sets `re.err_code = 1` on range error.
fn encode_dc_diff(
  re : RangeEncoder,
  model : DctModel,
  chroma : Int,
  err_b : Int,
  diff : Int
) -> Unit {
  let base_ctx = chroma * 8 + err_b
  let dc_nz = model.dc_nz
  let mut range = re.range
  let mut low = re.low
  if diff == 0 {
    let p = dc_nz[base_ctx]
    let b = (range >> 12) * p.to_int64().to_uint64()
    range = b
    dc_nz[base_ctx] = p + ((4096 - p) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    re.range = range
    re.low = low
    return
  }
  if diff < -1073741823 || diff > 1073741823 {
    re.err_code = 1
    return
  }
  let p0 = dc_nz[base_ctx]
  let b0 = (range >> 12) * p0.to_int64().to_uint64()
  low = low + b0
  range = range - b0
  dc_nz[base_ctx] = p0 - (p0 >> 4)
  while range < 0x01000000UL {
    range = range << 8
    re.low = low
    re_shift_low(re)
    low = re.low
  }
  let dc_sign = model.dc_sign
  let ps = dc_sign[base_ctx]
  let bs = (range >> 12) * ps.to_int64().to_uint64()
  if diff >= 0 {
    range = bs
    dc_sign[base_ctx] = ps + ((4096 - ps) >> 4)
  } else {
    low = low + bs
    range = range - bs
    dc_sign[base_ctx] = ps - (ps >> 4)
  }
  while range < 0x01000000UL {
    range = range << 8
    re.low = low
    re_shift_low(re)
    low = re.low
  }
  let abs_v = if diff < 0 { -diff } else { diff }
  let dc_gt1 = model.dc_gt1
  let pg = dc_gt1[base_ctx]
  let bg = (range >> 12) * pg.to_int64().to_uint64()
  if abs_v == 1 {
    range = bg
    dc_gt1[base_ctx] = pg + ((4096 - pg) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    re.range = range
    re.low = low
    return
  }
  low = low + bg
  range = range - bg
  dc_gt1[base_ctx] = pg - (pg >> 4)
  while range < 0x01000000UL {
    range = range << 8
    re.low = low
    re_shift_low(re)
    low = re.low
  }
  let rem = abs_v - 2
  let exp = if rem == 0 { 0 } else { floor_log2(rem + 1) }
  let dc_exp = model.dc_exp
  let exp_base = base_ctx * 12
  let mut e = 0
  while e < exp && e < 29 {
    let e_ctx = if e < 11 { e } else { 11 }
    let pe = dc_exp[exp_base + e_ctx]
    let be = (range >> 12) * pe.to_int64().to_uint64()
    low = low + be
    range = range - be
    dc_exp[exp_base + e_ctx] = pe - (pe >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    e = e + 1
  }
  if exp < 29 {
    let e_ctx = if exp < 11 { exp } else { 11 }
    let pe = dc_exp[exp_base + e_ctx]
    let be = (range >> 12) * pe.to_int64().to_uint64()
    range = be
    dc_exp[exp_base + e_ctx] = pe + ((4096 - pe) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
  }
  if exp > 0 {
    let body = (rem + 1) - (1 << exp)
    let top_bit = (body >> (exp - 1)) & 1
    let m_ctx = chroma * 12 + (if exp < 11 { exp } else { 11 })
    let dc_mant = model.dc_mant
    let pm = dc_mant[m_ctx]
    let bm = (range >> 12) * pm.to_int64().to_uint64()
    if top_bit == 0 {
      range = bm
      dc_mant[m_ctx] = pm + ((4096 - pm) >> 4)
    } else {
      low = low + bm
      range = range - bm
      dc_mant[m_ctx] = pm - (pm >> 4)
    }
    while range < 0x01000000UL {
      range = range << 8
      re.low = low
      re_shift_low(re)
      low = re.low
    }
    let mut i = exp - 2
    while i >= 0 {
      let half = range >> 1
      range = half
      if ((body >> i) & 1) != 0 {
        low = low + half
      }
      if range < 0x01000000UL {
        range = range << 8
        re.low = low
        re_shift_low(re)
        low = re.low
      }
      i = i - 1
    }
  }
  re.range = range
  re.low = low
}

///| Decode a signed DC residual; sets `rd.err_code = 1` if magnitude exceeds `1073741823`.
fn decode_dc_diff(rd : RangeDecoder, model : DctModel, chroma : Int, err_b : Int) -> Int {
  let base_ctx = chroma * 8 + err_b
  let data = rd.data
  let end = rd.end
  let mut pos = rd.pos
  let mut range = rd.range
  let mut code = rd.code
  let mut eof_reads = rd.eof_reads

  let dc_nz = model.dc_nz
  let p0 = dc_nz[base_ctx]
  let b0 = (range >> 12) * p0.to_int64().to_uint64()
  if code < b0 {
    range = b0
    dc_nz[base_ctx] = p0 + ((4096 - p0) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    rd.pos = pos
    rd.range = range
    rd.code = code
    rd.eof_reads = eof_reads
    return 0
  }
  code = code - b0
  range = range - b0
  dc_nz[base_ctx] = p0 - (p0 >> 4)
  while range < 0x01000000UL {
    range = range << 8
    let b = if pos < end {
      let bv = data[pos].to_int().to_int64().to_uint64()
      pos = pos + 1
      bv
    } else {
      eof_reads = eof_reads + 1
      0UL
    }
    code = (code << 8) | b
  }

  let dc_sign = model.dc_sign
  let ps = dc_sign[base_ctx]
  let bs = (range >> 12) * ps.to_int64().to_uint64()
  let sign = if code < bs {
    range = bs
    dc_sign[base_ctx] = ps + ((4096 - ps) >> 4)
    0
  } else {
    code = code - bs
    range = range - bs
    dc_sign[base_ctx] = ps - (ps >> 4)
    1
  }
  while range < 0x01000000UL {
    range = range << 8
    let b = if pos < end {
      let bv = data[pos].to_int().to_int64().to_uint64()
      pos = pos + 1
      bv
    } else {
      eof_reads = eof_reads + 1
      0UL
    }
    code = (code << 8) | b
  }

  let dc_gt1 = model.dc_gt1
  let pg = dc_gt1[base_ctx]
  let bg = (range >> 12) * pg.to_int64().to_uint64()
  let abs_v = if code < bg {
    range = bg
    dc_gt1[base_ctx] = pg + ((4096 - pg) >> 4)
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    1
  } else {
    code = code - bg
    range = range - bg
    dc_gt1[base_ctx] = pg - (pg >> 4)
    while range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let bv = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        bv
      } else {
        eof_reads = eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    let dc_exp = model.dc_exp
    let exp_base = base_ctx * 12
    let mut exp = 0
    while exp < 29 {
      let e_ctx = if exp < 11 { exp } else { 11 }
      let pe = dc_exp[exp_base + e_ctx]
      let be = (range >> 12) * pe.to_int64().to_uint64()
      if code < be {
        range = be
        dc_exp[exp_base + e_ctx] = pe + ((4096 - pe) >> 4)
        while range < 0x01000000UL {
          range = range << 8
          let b = if pos < end {
            let bv = data[pos].to_int().to_int64().to_uint64()
            pos = pos + 1
            bv
          } else {
            eof_reads = eof_reads + 1
            0UL
          }
          code = (code << 8) | b
        }
        break
      }
      code = code - be
      range = range - be
      dc_exp[exp_base + e_ctx] = pe - (pe >> 4)
      while range < 0x01000000UL {
        range = range << 8
        let b = if pos < end {
          let bv = data[pos].to_int().to_int64().to_uint64()
          pos = pos + 1
          bv
        } else {
          eof_reads = eof_reads + 1
          0UL
        }
        code = (code << 8) | b
      }
      exp = exp + 1
    }
    let rem = if exp == 0 {
      0
    } else {
      let m_ctx = chroma * 12 + (if exp < 11 { exp } else { 11 })
      let dc_mant = model.dc_mant
      let pm = dc_mant[m_ctx]
      let bm = (range >> 12) * pm.to_int64().to_uint64()
      let top_bit = if code < bm {
        range = bm
        dc_mant[m_ctx] = pm + ((4096 - pm) >> 4)
        0
      } else {
        code = code - bm
        range = range - bm
        dc_mant[m_ctx] = pm - (pm >> 4)
        1
      }
      while range < 0x01000000UL {
        range = range << 8
        let b = if pos < end {
          let bv = data[pos].to_int().to_int64().to_uint64()
          pos = pos + 1
          bv
        } else {
          eof_reads = eof_reads + 1
          0UL
        }
        code = (code << 8) | b
      }
      let mut low_bits = 0
      let mut di = 0
      let dnb = exp - 1
      while di < dnb {
        let half = range >> 1
        range = half
        if code < half {
          low_bits = low_bits << 1
        } else {
          code = code - half
          low_bits = (low_bits << 1) | 1
        }
        if range < 0x01000000UL {
          range = range << 8
          let b = if pos < end {
            let bv = data[pos].to_int().to_int64().to_uint64()
            pos = pos + 1
            bv
          } else {
            eof_reads = eof_reads + 1
            0UL
          }
          code = (code << 8) | b
        }
        di = di + 1
      }
      let body = (top_bit << (exp - 1)) | low_bits
      (1 << exp) + body - 1
    }
    if rem > 1073741821 {
      rd.pos = pos
      rd.range = range
      rd.code = code
      rd.eof_reads = eof_reads
      rd.err_code = 1
      return 0
    }
    rem + 2
  }
  rd.pos = pos
  rd.range = range
  rd.code = code
  rd.eof_reads = eof_reads
  if sign != 0 { -abs_v } else { abs_v }
}
