///| Canonical JPEG Huffman tables, DHT parsing, and symbol coding.

///| Canonical JPEG Huffman table for both decoding and encoding.
///| `fast_lut` packs `(bits << 8) | sym` for all codes with length `1..10` (`0` = slow path).
struct HuffTable {
  valid : Bool
  fast_lut : FixedArray[Int]
  min_code : FixedArray[Int]
  max_code : FixedArray[Int]
  val_ptr : FixedArray[Int]
  vals : FixedArray[Int]
  enc_code : FixedArray[Int]
  enc_len : FixedArray[Int]
}

///| Create an empty (unloaded) Huffman table with zero heap overhead.
fn HuffTable::empty() -> HuffTable {
  let empty = FixedArray::make(0, 0)
  HuffTable::{
    valid: false,
    fast_lut: empty,
    min_code: empty,
    max_code: empty,
    val_ptr: empty,
    vals: empty,
    enc_code: empty,
    enc_len: empty,
  }
}

///| Build a canonical JPEG Huffman table from 16 bit-length counts and symbol values.
///| When `need_decode_lut` is false (encode-only path), skips building the 10-bit `fast_lut`.
fn build_huff_table(
  counts : FixedArray[Int],
  sym_vals : FixedArray[Int],
  total : Int,
  need_decode_lut : Bool
) -> Result[HuffTable, String] {
  if total > 256 {
    return Err("invalid DHT symbol count")
  }
  let fast_lut = if need_decode_lut { FixedArray::make(1024, 0) } else { FixedArray::make(0, 0) }
  let min_code = if need_decode_lut { FixedArray::make(17, 0) } else { FixedArray::make(0, 0) }
  let max_code = if need_decode_lut { FixedArray::make(17, -1) } else { FixedArray::make(0, 0) }
  let val_ptr = if need_decode_lut { FixedArray::make(17, 0) } else { FixedArray::make(0, 0) }
  let vals = if need_decode_lut { FixedArray::make(256, 0) } else { FixedArray::make(0, 0) }
  let enc_code = FixedArray::make(256, 0)
  let enc_len = FixedArray::make(256, 0)

  if need_decode_lut {
    let mut idx = 0
    while idx < total {
      vals[idx] = sym_vals[idx]
      idx = idx + 1
    }
  }

  let mut code = 0
  let mut k = 0
  let mut bits = 1
  while bits <= 16 {
    let cnt = counts[bits]
    if cnt > 0 {
      if need_decode_lut {
        min_code[bits] = code
        val_ptr[bits] = k
      }
      let mut j = 0
      while j < cnt {
        if code >= (1 << bits) {
          return Err("invalid DHT canonical codes")
        }
        let sym = sym_vals[k]
        enc_code[sym] = code
        enc_len[sym] = bits
        if need_decode_lut && bits <= 10 {
          let shift = 10 - bits
          let base = code << shift
          let span = 1 << shift
          let packed = (bits << 8) | sym
          let mut p = 0
          while p < span {
            fast_lut[base + p] = packed
            p = p + 1
          }
        }
        code = code + 1
        k = k + 1
        j = j + 1
      }
      if need_decode_lut {
        max_code[bits] = code - 1
      }
    } else if need_decode_lut {
      max_code[bits] = -1
    }
    code = code << 1
    bits = bits + 1
  }

  Ok(HuffTable::{
    valid: true,
    fast_lut,
    min_code,
    max_code,
    val_ptr,
    vals,
    enc_code,
    enc_len,
  })
}

///| Slow-path Huffman decode for codes > 10 bits or near end-of-stream.
///| Returns `0..255` on success, `-1` on EOF, `-2` on invalid code, `-3` on OOB.
fn jbr_decode_huff_slow(br : JpegBitReader, tbl : HuffTable) -> Int {
  let max_code = tbl.max_code
  let mut code = 0
  let mut len = 1
  while len <= 16 {
    let b = jbr_read_bit_fast(br)
    if b < 0 {
      return -1
    }
    code = (code << 1) | b
    let mc = max_code[len]
    if mc >= 0 && code <= mc {
      let idx = tbl.val_ptr[len] + (code - tbl.min_code[len])
      if idx < 0 || idx >= 256 {
        return -3
      }
      return tbl.vals[idx]
    }
    len = len + 1
  }
  -2
}

///| Decode one Huffman symbol from `br` using `tbl`.
///| Returns `0..255` on success, `-1` on EOF, `-2` on invalid code, `-3` on OOB.
fn jbr_decode_huff_fast(br : JpegBitReader, tbl : HuffTable) -> Int {
  if br.bitcnt < 10 && !br.hit_marker {
    jbr_fill(br)
  }
  if br.bitcnt >= 10 {
    let peek = ((br.bitbuf >> (br.bitcnt - 10)) & 1023UL).to_int()
    let entry = tbl.fast_lut[peek]
    if entry != 0 {
      br.bitcnt = br.bitcnt - (entry >> 8)
      return entry & 0xFF
    }
  }
  jbr_decode_huff_slow(br, tbl)
}

///| Convert a negative `jbr_decode_huff_fast` error code to its exact error message.
fn huff_decode_err(code : Int) -> String {
  if code == -1 {
    "unexpected end of JPEG entropy stream"
  } else if code == -3 {
    "Huffman table index out of bounds"
  } else {
    "invalid Huffman code in JPEG stream"
  }
}

///| Encode one Huffman symbol into `bw` using `tbl`; returns `false` if missing.
fn jbw_write_huff_fast(bw : JpegBitWriter, tbl : HuffTable, sym : Int) -> Bool {
  let len = tbl.enc_len[sym]
  if len <= 0 {
    return false
  }
  jbw_write_bits(bw, tbl.enc_code[sym], len)
  true
}

///| Compute the JPEG category (bit length, 0..15) of a signed coefficient.
fn jpeg_category(v : Int) -> Int {
  let a = if v < 0 { -v } else { v }
  if a < 16 {
    if a < 4 {
      if a < 2 { a } else { 2 }
    } else if a < 8 {
      3
    } else {
      4
    }
  } else if a < 256 {
    if a < 64 {
      if a < 32 { 5 } else { 6 }
    } else if a < 128 {
      7
    } else {
      8
    }
  } else if a < 4096 {
    if a < 1024 {
      if a < 512 { 9 } else { 10 }
    } else if a < 2048 {
      11
    } else {
      12
    }
  } else {
    let mut cat = 12
    let mut x = a >> 12
    while x > 0 {
      cat = cat + 1
      x = x >> 1
    }
    cat
  }
}

///| Build a 256-entry L1-resident JPEG category LUT for magnitudes `0..255`.
fn build_cat_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  let mut i = 1
  while i < 256 {
    lut[i] = jpeg_category(i)
    i = i + 1
  }
  lut
}

///| Write the signed value bits for JPEG category `cat` (`cat > 0`).
fn jbw_write_coeff_bits(bw : JpegBitWriter, v : Int, cat : Int) -> Unit {
  if cat == 0 {
    return
  }
  let bits = if v < 0 { v + ((1 << cat) - 1) } else { v }
  jbw_write_bits(bw, bits, cat)
}

///| Snapshot an array of 4 Huffman tables.
fn clone_huff_tables(src : Array[HuffTable]) -> Array[HuffTable] {
  let out : Array[HuffTable] = []
  let mut i = 0
  while i < src.length() {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Parse a `DHT` marker payload into `dc_tables` and `ac_tables`.
fn parse_dht(
  jpeg : Bytes,
  start : Int,
  end : Int,
  dc_tables : Array[HuffTable],
  ac_tables : Array[HuffTable],
  need_decode_lut : Bool
) -> Result[Unit, String] {
  let mut pos = start
  while pos < end {
    if pos + 17 > end {
      return Err("truncated DHT segment")
    }
    let tc_th = jpeg[pos].to_int()
    pos = pos + 1
    let tc = tc_th >> 4
    let th = tc_th & 0x0F
    if (tc != 0 && tc != 1) || th > 3 {
      return Err("invalid DHT table class or id")
    }
    let counts = FixedArray::make(17, 0)
    let mut total = 0
    let mut i = 1
    while i <= 16 {
      let c = jpeg[pos].to_int()
      counts[i] = c
      total = total + c
      pos = pos + 1
      i = i + 1
    }
    if total > 256 || pos + total > end {
      return Err("truncated DHT symbol list")
    }
    let vals = FixedArray::make(256, 0)
    let mut j = 0
    while j < total {
      vals[j] = jpeg[pos].to_int()
      pos = pos + 1
      j = j + 1
    }
    match build_huff_table(counts, vals, total, need_decode_lut) {
      Ok(tbl) => {
        if tc == 0 {
          dc_tables[th] = tbl
        } else {
          ac_tables[th] = tbl
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(())
}
