///| 32-bit carry-safe binary range coder with 12-bit adaptive probabilities.

let prob_init : Int = 2048

///| Binary arithmetic range encoder (LZMA-style 32-bit range with carry propagation).
struct RangeEncoder {
  out : ByteWriter
  mut low : UInt64
  mut range : UInt64
  mut cache : Int
  mut cache_size : Int
  mut err_code : Int
}

///| Create a new `RangeEncoder` writing to `out`.
fn RangeEncoder::new(out : ByteWriter) -> RangeEncoder {
  RangeEncoder::{
    out,
    low: 0UL,
    range: 0xFFFFFFFFUL,
    cache: 0,
    cache_size: 1,
    err_code: 0,
  }
}

///| Shift out top byte(s) with carry propagation.
fn re_shift_low(re : RangeEncoder) -> Unit {
  let low = re.low
  let low_hi = (low >> 32).to_int()
  if low < 0xFF000000UL || low_hi != 0 {
    let out = re.out
    let cs = re.cache_size
    if out.len + cs > out.cap {
      bw_push_byte(out, (re.cache + low_hi) & 0xFF)
      let mut rem = cs - 1
      let fill = (0xFF + low_hi) & 0xFF
      while rem > 0 {
        bw_push_byte(out, fill)
        rem = rem - 1
      }
    } else {
      let buf = out.buf
      let mut len = out.len
      buf[len] = ((re.cache + low_hi) & 0xFF).to_byte()
      len = len + 1
      let mut rem = cs - 1
      if rem > 0 {
        let fill = ((0xFF + low_hi) & 0xFF).to_byte()
        while rem > 0 {
          buf[len] = fill
          len = len + 1
          rem = rem - 1
        }
      }
      out.len = len
      out.total_len = out.total_len + cs
    }
    re.cache = ((low >> 24) & 0xFFUL).to_int()
    re.cache_size = 1
  } else {
    re.cache_size = re.cache_size + 1
  }
  re.low = (low & 0x00FFFFFFUL) << 8
}

///| Encode one binary decision using adaptive probability `probs[ctx]` and update it.
fn re_encode_bit(re : RangeEncoder, probs : FixedArray[Int], ctx : Int, bit : Int) -> Unit {
  let p = probs[ctx]
  let mut range = re.range
  let bound = (range >> 12) * p.to_int64().to_uint64()
  if bit == 0 {
    range = bound
    probs[ctx] = p + ((4096 - p) >> 4)
  } else {
    re.low = re.low + bound
    range = range - bound
    probs[ctx] = p - (p >> 4)
  }
  while range < 0x01000000UL {
    range = range << 8
    re_shift_low(re)
  }
  re.range = range
}

///| Encode `nbits` equiprobable bits MSB-first.
fn re_encode_direct_bits(re : RangeEncoder, v : Int, nbits : Int) -> Unit {
  let mut range = re.range
  let mut i = nbits - 1
  while i >= 0 {
    let half = range >> 1
    range = half
    if ((v >> i) & 1) != 0 {
      re.low = re.low + half
    }
    if range < 0x01000000UL {
      range = range << 8
      re_shift_low(re)
    }
    i = i - 1
  }
  re.range = range
}

///| Flush the remaining 5 bytes of range encoder state.
fn re_finish(re : RangeEncoder) -> Unit {
  re_shift_low(re)
  re_shift_low(re)
  re_shift_low(re)
  re_shift_low(re)
  re_shift_low(re)
}

///| Binary arithmetic range decoder paired with `RangeEncoder`.
struct RangeDecoder {
  data : Bytes
  mut pos : Int
  end : Int
  mut range : UInt64
  mut code : UInt64
  mut eof_reads : Int
  mut err_code : Int
}

///| Read the next byte from the range-coded stream, tracking any reads past `end`.
fn rd_next_byte(rd : RangeDecoder) -> UInt64 {
  let pos = rd.pos
  if pos < rd.end {
    let b = rd.data[pos].to_int().to_int64().to_uint64()
    rd.pos = pos + 1
    b
  } else {
    rd.eof_reads = rd.eof_reads + 1
    0UL
  }
}

///| Initialize a `RangeDecoder` over `[start, end)`.
fn RangeDecoder::new(data : Bytes, start : Int, end : Int) -> Result[RangeDecoder, String] {
  if end - start < 5 {
    return Err("truncated range-coded payload")
  }
  let rd = RangeDecoder::{
    data,
    pos: start,
    end,
    range: 0xFFFFFFFFUL,
    code: 0UL,
    eof_reads: 0,
    err_code: 0,
  }
  let _ = rd_next_byte(rd)
  let mut i = 0
  while i < 4 {
    rd.code = (rd.code << 8) | rd_next_byte(rd)
    i = i + 1
  }
  Ok(rd)
}

///| Verify the range decoder consumed the exact payload without truncation or trailing bytes.
fn rd_check_eof(rd : RangeDecoder) -> Result[Unit, String] {
  if rd.eof_reads > 0 {
    return Err("truncated range-coded payload")
  }
  if rd.pos != rd.end {
    return Err("trailing bytes in range-coded payload")
  }
  Ok(())
}

///| Decode one binary decision using adaptive probability `probs[ctx]` and update it.
fn rd_decode_bit(rd : RangeDecoder, probs : FixedArray[Int], ctx : Int) -> Int {
  let p = probs[ctx]
  let mut range = rd.range
  let mut code = rd.code
  let bound = (range >> 12) * p.to_int64().to_uint64()
  let bit = if code < bound {
    range = bound
    probs[ctx] = p + ((4096 - p) >> 4)
    0
  } else {
    code = code - bound
    range = range - bound
    probs[ctx] = p - (p >> 4)
    1
  }
  while range < 0x01000000UL {
    range = range << 8
    let pos = rd.pos
    let b = if pos < rd.end {
      rd.pos = pos + 1
      rd.data[pos].to_int().to_int64().to_uint64()
    } else {
      rd.eof_reads = rd.eof_reads + 1
      0UL
    }
    code = (code << 8) | b
  }
  rd.range = range
  rd.code = code
  bit
}

///| Decode `nbits` equiprobable bits MSB-first.
fn rd_decode_direct_bits(rd : RangeDecoder, nbits : Int) -> Int {
  let data = rd.data
  let end = rd.end
  let mut pos = rd.pos
  let mut range = rd.range
  let mut code = rd.code
  let mut v = 0
  let mut i = 0
  while i < nbits {
    let half = range >> 1
    range = half
    if code < half {
      v = v << 1
    } else {
      code = code - half
      v = (v << 1) | 1
    }
    if range < 0x01000000UL {
      range = range << 8
      let b = if pos < end {
        let byte_val = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        byte_val
      } else {
        rd.eof_reads = rd.eof_reads + 1
        0UL
      }
      code = (code << 8) | b
    }
    i = i + 1
  }
  rd.pos = pos
  rd.range = range
  rd.code = code
  v
}
