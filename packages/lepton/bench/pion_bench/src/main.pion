///| Pion Native head-to-head benchmark for `packages/lepton`.
///| Usage:
///|   pion_lepton_bench roundtrip <jpeg_file> <iters> [out_encoded]
///|   pion_lepton_bench decode <encoded_file> <iters>
///| Both modes write the final restored byte-exact JPEG stream to stdout.

import "lepton"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_lepton_bench <roundtrip|decode> <input_file> <iters> [out_encoded]")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  if iters <= 0 {
    io_println(world, "iters must be > 0")
    return 1
  }
  let input = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  if mode == "roundtrip" {
    let mut last_enc = Bytes::new(0)
    let mut last_dec = Bytes::new(0)
    let mut i = 0
    while i < iters {
      let enc = match lepton::encode(input) {
        Ok(b) => b
        Err(e) => {
          io_println(world, "encode error: " + e)
          return 1
        }
      }
      let dec = match lepton::decode(enc) {
        Ok(b) => b
        Err(e) => {
          io_println(world, "decode error: " + e)
          return 1
        }
      }
      last_enc = enc
      last_dec = dec
      i = i + 1
    }
    if args.length() >= 5 {
      match fs_write_bytes(world, args[4], last_enc) {
        Ok(()) => ()
        Err(_) => {
          io_println(world, "failed to write " + args[4])
          return 1
        }
      }
    }
    match fs_write_bytes(world, "/dev/stdout", last_dec) {
      Ok(()) => 0
      Err(_) => {
        io_println(world, "failed to write stdout")
        1
      }
    }
  } else if mode == "decode" {
    let mut last_dec = Bytes::new(0)
    let mut i = 0
    while i < iters {
      match lepton::decode(input) {
        Ok(b) => last_dec = b
        Err(e) => {
          io_println(world, "decode error: " + e)
          return 1
        }
      }
      i = i + 1
    }
    match fs_write_bytes(world, "/dev/stdout", last_dec) {
      Ok(()) => 0
      Err(_) => {
        io_println(world, "failed to write stdout")
        1
      }
    }
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
