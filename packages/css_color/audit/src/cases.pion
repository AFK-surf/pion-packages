///| Red-team and control cases for `packages/css_color` (see ../REPORT.md). Every case returns "" on PASS or a
///| failure reason. `redteam_p<sev>_<n>_*` cases assert what a conforming implementation must do (expected values
///| are the pinned WPT vectors, headless Chrome 159 or the CSS Color 4/5 Editor's Drafts, cited per case) and FAIL
///| while finding P<sev>-<n> is open. `control_*` cases pin attacks and edge cases the package already handles.
///| The same functions run under `pionc test` (control_test.pion / redteam_test.pion) and, one process per case,
///| under `css_color_audit case <name>` in native debug/release and wasm32 debug/release (run_audit.sh).

import "css_color"

///|
fn absd(x : Double) -> Double {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

///|
fn near(a : Double, b : Double, tol : Double) -> Bool {
  absd(a - b) <= tol
}

///|
fn hue_near(a : Double, b : Double, tol : Double) -> Bool {
  let mut d = absd(a - b)
  while d >= 360.0 {
    d = d - 360.0
  }
  d <= tol || 360.0 - d <= tol
}

///|
fn p(s : String) -> Result[css_color::Color, String] {
  match css_color::parse(s) {
    Ok(c) => Ok(c)
    Err(e) => Err(s + " -> Err(" + e.to_string() + ")")
  }
}

///| `parse(s)` converted to `sp` must be within `tol` of (c0, c1, c2) (hue compared modulo 360 when `hue` >= 0).
fn expect_in(s : String, sp : css_color::ColorSpace, c0 : Double, c1 : Double, c2 : Double, tol : Double, hue : Int) -> String {
  match p(s) {
    Err(e) => e
    Ok(c) => {
      let t = c.convert(sp)
      let v = [t.c0, t.c1, t.c2]
      let w = [c0, c1, c2]
      let mut i = 0
      while i < 3 {
        let ok = if i == hue { hue_near(v[i], w[i], tol) } else { near(v[i], w[i], tol) }
        if !ok {
          return s + " -> " + sp.css_name() + " " + t.c0.to_string() + " " + t.c1.to_string() + " " + t.c2.to_string() +
          ", want " +
          c0.to_string() +
          " " +
          c1.to_string() +
          " " +
          c2.to_string()
        }
        i = i + 1
      }
      ""
    }
  }
}

///|
fn expect_ok(s : String) -> String {
  match p(s) {
    Ok(_) => ""
    Err(e) => e + " (valid per WPT / CSS Color 4-5 ED)"
  }
}

///|
fn expect_err(s : String) -> String {
  match css_color::parse(s) {
    Ok(c) => s + " -> Ok(" + c.to_css() + ") (invalid per CSS Values 4 / Chrome 159)"
    Err(_) => ""
  }
}

///|
fn first(rs : Array[String]) -> String {
  let mut i = 0
  while i < rs.length() {
    if rs[i] != "" {
      return rs[i]
    }
    i = i + 1
  }
  ""
}

// ---------------------------------------------------------------------------------------------------------------
// red-team cases (FAIL while the finding is open)

///| P1-1: HSL/HWB of a (near-)white or (near-)black color reached by conversion. CSS Color 4 ED rgbToHsl sets S = 0
///| (hue powerless) when |L| <= 1e-5 or |1 - L| < 1e-5; css_color divides by ~1e-9 and returns S = 849%.
fn redteam_p1_1_hsl_near_white_black() -> String {
  let r1 = match p("lab(100 0 0)") {
    Err(e) => e
    Ok(c) => {
      let h = c.convert(css_color::ColorSpace::Hsl)
      if h.c1 > 0.001 {
        "lab(100 0 0).convert(Hsl) saturation " + h.c1.to_string() + "% (want 0, hue powerless)"
      } else {
        ""
      }
    }
  }
  first([
    r1,
    // WPT color-computed-color-mix-function.html: color(srgb 0.625 0.625 0.875) / color(srgb 0.5 0.5 1)
    expect_in("color-mix(in hsl, lch(100% 0 0), blue)", css_color::ColorSpace::Srgb, 0.625, 0.625, 0.875, 0.01, -1),
    expect_in("color-mix(in hwb, lch(100% 0 0), blue)", css_color::ColorSpace::Srgb, 0.5, 0.5, 1.0, 0.01, -1),
  ])
}

///| P1-2: relative color syntax. A channel keyword whose origin component is missing (or powerless after the
///| conversion) resolves to `none` (CSS Color 5 ED, "component keywords can return none"; WPT color-computed-none
///| and -powerless). css_color resolves it to 0, so e.g. the hue of `oklch(from white l c h)` becomes 0deg (red).
fn redteam_p1_2_relative_keywords_keep_none() -> String {
  let r1 = match p("hsl(from hsl(none 50% 50%) h s l)") {
    Err(e) => e
    Ok(c) => if c.m0 { "" } else { "hsl(from hsl(none 50% 50%) h s l): hue is " + c.c0.to_string() + ", want none" }
  }
  let r2 = match p("oklch(from white l c h)") {
    Err(e) => e
    Ok(c) => if c.m2 { "" } else { "oklch(from white l c h): hue " + c.c2.to_string() + ", want none (Chrome: none)" }
  }
  first([
    r1,
    r2,
    // headless Chrome 159: oklch(0.725987 0.15663 264.051); css_color interpolates the hue from 0deg (312deg)
    expect_in(
      "color-mix(in oklch, oklch(from white l c h), blue)",
      css_color::ColorSpace::Oklch,
      0.725987,
      0.15663,
      264.051,
      0.002,
      2,
    ),
  ])
}

///| P2-1: `to_css()` saturates |component| >= 2^63 / 1e6 to 9223372036854.775807 and writes NaN / Inf as "0".
fn redteam_p2_1_to_css_fidelity() -> String {
  match p("color(srgb 1e13 0 0)") {
    Err(e) => e
    Ok(c) => {
      let css = c.to_css()
      match css_color::parse(css) {
        Ok(back) => if near(back.c0, 1.0e13, 1.0) { "" } else { "color(srgb 1e13 0 0).to_css() = " + css }
        Err(e) => css + " -> Err(" + e.to_string() + ")"
      }
    }
  }
}

///| P2-2: constants that differ from the CSS Color 4 ED: Bradford D65->D50 (~8e-8) and the ProPhoto RGB matrix
///| (~8e-6, the pre-2023 values); expected entries are the ED's (= first-principles derivation, diff/spec_ref.py).
fn redteam_p2_2_ed_matrices() -> String {
  first([
    expect_in(
      "color(xyz-d65 1 0 0)",
      css_color::ColorSpace::XyzD50,
      1.0479297925449969,
      0.02962780877005599,
      -0.009243040646204504,
      1.0e-12,
      -1,
    ),
    expect_in("color(prophoto-rgb 1 0 0)", css_color::ColorSpace::XyzD50, 0.7977666449006423, 0.2880748288194013, 0.0, 1.0e-12, -1),
  ])
}

///| P2-3: `#` hash tokens and `from` are not delimited like CSS tokens: `#fffr` is one (invalid) hash token, while
///| `from#f00` is the ident `from` followed by a hash (valid). Chrome 159 agrees with both expectations.
fn redteam_p2_3_token_boundaries() -> String {
  first([expect_err("rgb(from #fffr g b)"), expect_ok("rgb(from#f00 r g b)")])
}

///| P2-4: calc() accepts what CSS Values 4 rejects: `+`/`-` without surrounding whitespace, unary minus on an
///| identifier, number + percentage / number + angle (type mismatch), and a percentage for a hue.
fn redteam_p2_4_calc_too_lax() -> String {
  first([
    expect_err("rgb(calc(1+2) 0 0)"),
    expect_err("rgb(calc(1 -2) 0 0)"),
    expect_err("rgb(from red calc(-r + 300) g b)"),
    expect_err("rgb(from red calc(r + 10%) g b)"),
    expect_err("hsl(from red calc(h + 30deg) s l)"),
    expect_err("hsl(calc(50%) 100% 50%)"),
  ])
}

///| P2-5: valid CSS rejected: calc() division by zero / NaN / infinity (CSS Values 4 §10.9: NaN -> 0, infinities
///| clamp), calc() percentages where percentages are required, and out-of-range number literals (clamped).
///| (Non-finite results are not asserted against: Chrome 159 itself keeps `oklch(0.5 calc(infinity) 30)` and yields
///| `oklab(calc(NaN) …)` for `color-mix(in oklab, lab(50 1e400 0), blue)`, so CSS leaves them degenerate.)
fn redteam_p2_5_calc_and_numbers_too_strict() -> String {
  first([
    // WPT color-computed-color-function.html: color(srgb calc(0 / 0) 0 0) -> color(srgb 0 0 0)
    expect_ok("color(srgb calc(0 / 0) 0 0)"),
    expect_ok("rgb(from red calc(r / 0) g b)"),
    expect_ok("hsl(120, calc(50%), 50%)"),
    expect_ok("color-mix(in srgb, red calc(50%), blue)"),
    expect_ok("rgb(1e309 0 0)"),
  ])
}

///| P2-6: CSS Color 5 ED color-mix() and CSS Color 4 ED spaces: the interpolation method is optional (Oklab),
///| 1..N colors, percentages summing to 0% give a transparent result (WG resolution, "invalid if sum to zero"
///| removed), and `display-p3-linear`. All are in the pinned WPT vectors; Chrome 159 accepts all but the 1-colour
///| and N > 2 forms (classified ORACLE-chrome-color-mix-arity in the Chrome comparison).
fn redteam_p2_6_css_color_5_ed_syntax() -> String {
  // WPT color-computed-color-mix-function.html: color(srgb 0.3 0.4 0.5 / 0)
  let zero = match p("color-mix(in srgb, color(srgb .1 .2 .3) 0%, color(srgb .5 .6 .7) 0%)") {
    Err(e) => e + " (WPT: color(srgb 0.3 0.4 0.5 / 0))"
    Ok(c) =>
    if near(c.alpha, 0.0, 1.0e-9) && near(c.c0, 0.3, 1.0e-6) && near(c.c2, 0.5, 1.0e-6) {
      ""
    } else {
      "0% + 0% mix = " + c.to_css() + ", want color(srgb 0.3 0.4 0.5 / 0)"
    }
  }
  first([
    zero,
    expect_ok("color-mix(red, blue)"),
    expect_ok("color-mix(in srgb, red)"),
    expect_ok("color-mix(in srgb, red, green, blue)"),
    expect_ok("color(display-p3-linear 0.5 0.5 0.5)"),
  ])
}

///| P2-7: missing-component carry-forward. x, y, z are analogous to r, g, b (CSS Color 4 §12.2 "Reds r,x ..."), and
///| the components left after removing analogous ones form analogous sets (oklab a,b <-> oklch c,h; hwb w,b <-> hsl s,l).
fn redteam_p2_7_analogous_components_and_sets() -> String {
  first([
    // headless Chrome 159: color(xyz-d65 0.180452 0.0360873 0.475203)
    expect_in(
      "color-mix(in xyz, color(srgb none 0 0), blue)",
      css_color::ColorSpace::XyzD65,
      0.180452,
      0.0360873,
      0.475203,
      0.0005,
      -1,
    ),
    // WPT color-computed-color-mix-function.html: oklch(0.2 0.2 90)
    expect_in("color-mix(in oklch, oklab(0.1 none none), oklch(0.3 0.2 90deg))", css_color::ColorSpace::Oklch, 0.2, 0.2, 90.0, 0.01, 2),
  ])
}

///| P2-8: powerless-hue thresholds of the ED tables (hsl S <= 0.001, hwb W + B >= 99.999, lch C <= 0.0015, oklch
///| C <= 4e-6), applied to the origin before conversion; css_color uses 1e-7 / 1e-7 / 1e-4 / 1e-6 and only after.
fn redteam_p2_8_powerless_epsilons() -> String {
  first([
    // WPT color-computed-powerless.html
    expect_in("color-mix(in lch, hsl(180 0.001% 50%), lch(11 33 44))", css_color::ColorSpace::Lch, 32.19448237, 16.5, 44.0, 0.01, 2),
    expect_in(
      "color-mix(in hsl, lch(20 0.0015 180), hsl(11 33 44))",
      css_color::ColorSpace::Srgb,
      0.36661137,
      0.28180299,
      0.26276437,
      0.01,
      -1,
    ),
  ])
}

///| P2-9: hsl() clamps S > 100% and L outside [0, 100] at parse time; CSS Color 4 ED only clamps a negative S.
fn redteam_p2_9_hsl_parse_clamping() -> String {
  match p("hsl(120 550% none)") {
    Err(e) => e
    Ok(c) => if near(c.c1, 550.0, 1.0e-9) { "" } else { "hsl(120 550% none) saturation " + c.c1.to_string() + " (Chrome: 550%)" }
  }
}

///| P2-10: to_gamut(): when the first out-of-gamut candidate is already within epsilon of the JND, the early exit
///| returns the last in-gamut chroma instead of `clipped` (ED §13.2: "return clipped"); css_color also skips step 11
///| (return clip(origin) when deltaEOK(clip(origin), origin) < JND) and uses epsilon 1e-5 instead of 1e-4.
fn redteam_p2_10_gamut_map_early_exit() -> String {
  match p("oklch(0.90244 0.39113 249.065)") {
    Err(e) => e
    Ok(c) => {
      let m = c.to_gamut(css_color::ColorSpace::A98Rgb)
      // spec_ref.gamut_map (ED algorithm, float64): color(a98-rgb 0.7746762 0.8895547 1)
      if near(m.c0, 0.7746762105689327, 0.001) && near(m.c1, 0.8895547333041092, 0.001) && near(m.c2, 1.0, 0.001) {
        ""
      } else {
        "to_gamut(a98-rgb) = " + m.to_css() + ", ED algorithm: color(a98-rgb 0.774676 0.889555 1)"
      }
    }
  }
}

///| P2-11: color-mix() edge rules. A missing hue takes the other hue *before* the hue fix-up (so `longer` with an
///| achromatic side goes the long way round), and when the interpolated alpha is 0 the premultiplied components
///| are 0 (WPT color-computed-color-mix-function.html).
fn redteam_p2_11_mix_missing_hue_and_zero_alpha() -> String {
  first([
    expect_in("color-mix(in hsl longer hue, red, white)", css_color::ColorSpace::Srgb, 0.625, 0.875, 0.875, 0.01, -1),
    expect_in("color-mix(in oklch longer hue, red, white)", css_color::ColorSpace::Oklch, 0.81398, 0.128842, 209.234, 0.01, 2),
    expect_in(
      "color-mix(in srgb, color(srgb -2 -3 -4 / -5), color(srgb -4 -6 -8 / -10))",
      css_color::ColorSpace::Srgb,
      0.0,
      0.0,
      0.0,
      0.01,
      -1,
    ),
  ])
}

///| P2-12: hue normalisation returns 0 for |h| >= 2^52 * 360 (f64_rem_euclid falls back to 0); an exact fmod keeps
///| the value (Chrome: hsl(1e20deg 50% 50%) is rgb(149, 64, 191), hue 280deg).
fn redteam_p2_12_huge_hue_normalisation() -> String {
  expect_in("hsl(1e20deg 50% 50%)", css_color::ColorSpace::Hsl, 280.0, 50.0, 50.0, 0.001, 0)
}

///| P2-14: WCAG helpers ignore alpha: a fully transparent color has contrast 21:1 against white.
fn redteam_p2_14_wcag_ignores_alpha() -> String {
  match (p("rgb(0 0 0 / 0)"), p("white")) {
    (Ok(t), Ok(w)) => {
      let r = t.contrast_ratio(w)
      if r < 20.0 {
        ""
      } else {
        "contrast_ratio(rgb(0 0 0 / 0), white) = " + r.to_string() + " (a transparent color treated as opaque black)"
      }
    }
    _ => "parse failed"
  }
}

// ---------------------------------------------------------------------------------------------------------------
// control cases (must PASS)

///| All 148 named colors + transparent, ASCII case-insensitive, surrounding ASCII whitespace only.
fn control_named_colors_and_whitespace() -> String {
  first([
    expect_in("REBECCAPURPLE", css_color::ColorSpace::Srgb, 0.4, 0.2, 0.6, 1.0e-12, -1),
    expect_in(" \t\n\r\x0C darkSlateGrey \t", css_color::ColorSpace::Srgb, 47.0 / 255.0, 79.0 / 255.0, 79.0 / 255.0, 1.0e-12, -1),
    expect_err("red\xC2\xA0"),
    expect_err("\xE3\x80\x80red"),
    expect_err("\x0Bred"),
    expect_err("\xEF\xBB\xBFred"),
    expect_err("re\0d"),
    expect_err("currentcolor"),
  ])
}

///| Legacy comma vs modern syntax separation (CSS Color 4 §5.1).
fn control_legacy_modern_separation() -> String {
  first([
    expect_err("rgb(255, 0 0)"),
    expect_err("rgb(255, 0, 0 / 0.5)"),
    expect_err("rgb(255 0 0, 0.5)"),
    expect_err("rgb(255, 50%, 0)"),
    expect_ok("rgb(255 50% 0)"),
    expect_err("rgb(none, 0, 0)"),
    expect_err("hsl(120, 100, 50)"),
    expect_ok("hsl(120 100 50)"),
    expect_err("rgb(255 0 0 0)"),
    expect_err("rgb(255 0)"),
    expect_err("rgb(255px 0 0)"),
    expect_err("rgb(255 0 0) x"),
    expect_err("rgb (255 0 0)"),
  ])
}

///| Angles: every unit, negative and large (but < 2^52 turns) values normalise like Chrome.
fn control_angles() -> String {
  first([
    expect_in("hsl(0.5turn 100% 50%)", css_color::ColorSpace::Hsl, 180.0, 100.0, 50.0, 1.0e-9, 0),
    expect_in("hsl(-90deg 100% 50%)", css_color::ColorSpace::Hsl, 270.0, 100.0, 50.0, 1.0e-9, 0),
    expect_in("hsl(400grad 100% 50%)", css_color::ColorSpace::Hsl, 0.0, 100.0, 50.0, 1.0e-9, 0),
    expect_in("oklch(0.6 0.1 3.14159265358979rad)", css_color::ColorSpace::Oklch, 0.6, 0.1, 180.0, 1.0e-9, 2),
    expect_in("lch(50 40 -720.25)", css_color::ColorSpace::Lch, 50.0, 40.0, 359.75, 1.0e-9, 2),
    expect_err("hsl(120px 100% 50%)"),
    expect_err("lch(50 40deg 30)"),
  ])
}

///| color-mix(): the four hue modes across 0/360 and at exactly 180deg apart (WPT), percentage normalisation.
fn control_color_mix_hues_and_percentages() -> String {
  first([
    expect_in("color-mix(in oklch shorter hue, oklch(0.6 0.15 10), oklch(0.6 0.15 350))", css_color::ColorSpace::Oklch, 0.6, 0.15, 0.0, 1.0e-9, 2),
    expect_in("color-mix(in oklch longer hue, oklch(0.6 0.15 10), oklch(0.6 0.15 350))", css_color::ColorSpace::Oklch, 0.6, 0.15, 180.0, 1.0e-9, 2),
    expect_in("color-mix(in oklch increasing hue, oklch(0.6 0.15 350), oklch(0.6 0.15 10))", css_color::ColorSpace::Oklch, 0.6, 0.15, 0.0, 1.0e-9, 2),
    expect_in("color-mix(in oklch decreasing hue, oklch(0.6 0.15 10), oklch(0.6 0.15 350))", css_color::ColorSpace::Oklch, 0.6, 0.15, 0.0, 1.0e-9, 2),
    expect_in("color-mix(in oklch, oklch(0.6 0.15 0), oklch(0.6 0.15 180))", css_color::ColorSpace::Oklch, 0.6, 0.15, 90.0, 1.0e-9, 2),
    expect_in("color-mix(in srgb, red 30%, blue 30%)", css_color::ColorSpace::Srgb, 0.5, 0.0, 0.5, 1.0e-9, -1),
    expect_err("color-mix(in srgb, red -10%, blue)"),
    expect_err("color-mix(in srgb, red 150%, blue)"),
    expect_err("color-mix(in srgb shorter hue, red, blue)"),
    match p("color-mix(in srgb, red 20%, blue 20%)") {
      Ok(c) => if near(c.alpha, 0.4, 1.0e-12) { "" } else { "20%+20% alpha " + c.alpha.to_string() }
      Err(e) => e
    },
  ])
}

///| calc(): precedence, parentheses, unary sign before a parenthesis, relative channel keywords.
fn control_calc_arithmetic() -> String {
  first([
    expect_in("rgb(from red calc(2 + 3 * 4) calc((2 + 3) * 4) calc(64 / 4 / 2))", css_color::ColorSpace::Srgb, 14.0 / 255.0, 20.0 / 255.0, 8.0 / 255.0, 1.0e-12, -1),
    expect_in("rgb(from rebeccapurple calc(r * 2) g b)", css_color::ColorSpace::Srgb, 0.8, 0.2, 0.6, 1.0e-12, -1),
    expect_err("rgb(from red l c h)"),
    expect_err("rgb(calc((1) 0 0)"),
    expect_err("rgb(calc(1)) 0 0)"),
    expect_err("rgb(calc() 0 0)"),
  ])
}

///| Depth and length guards: 32 nested levels are accepted, 33 rejected, 16384 bytes accepted, 16385 rejected.
fn control_dos_guards() -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 33 {
    sb.write_string("color-mix(in srgb, ")
    i = i + 1
  }
  sb.write_string("red")
  i = 0
  while i < 33 {
    sb.write_string(", blue)")
    i = i + 1
  }
  let deep = sb.to_string()
  let pad = StringBuilder::new()
  i = 0
  while i < 16381 {
    pad.write_char(' ')
    i = i + 1
  }
  let s16384 = pad.to_string() + "red"
  first([
    match css_color::parse(deep) {
      Err(css_color::ColorError::MaxDepthExceeded(_)) => ""
      _ => "33 nested color-mix() not rejected with MaxDepthExceeded"
    },
    expect_ok(s16384),
    match css_color::parse(s16384 + " ") {
      Err(css_color::ColorError::InputTooLong(n)) => if n == 16385 { "" } else { "InputTooLong(" + n.to_string() + ")" }
      _ => "16385-byte input not rejected with InputTooLong"
    },
  ])
}

///| Gamut mapping invariants: in-gamut unchanged, L <= 0 black, L >= 1 white, results in gamut.
fn control_gamut_mapping() -> String {
  let in_g = match p("rgb(12 200 99 / 0.5)") {
    Ok(c) => {
      let m = c.to_gamut(css_color::ColorSpace::Srgb)
      if m.c0 == c.c0 && m.c1 == c.c1 && m.c2 == c.c2 && m.alpha == c.alpha { "" } else { "in-gamut color changed" }
    }
    Err(e) => e
  }
  let edge = fn(s : String, want : Double) -> String {
    match p(s) {
      Ok(c) => {
        let m = c.to_gamut(css_color::ColorSpace::DisplayP3)
        if m.c0 == want && m.c1 == want && m.c2 == want { "" } else { s + " -> " + m.to_css() }
      }
      Err(e) => e
    }
  }
  let mapped = fn(s : String, sp : css_color::ColorSpace) -> String {
    match p(s) {
      Ok(c) => if c.to_gamut(sp).in_gamut() { "" } else { s + " not in gamut after to_gamut" }
      Err(e) => e
    }
  }
  first([
    in_g,
    edge("oklch(0 0.3 30)", 0.0),
    edge("oklch(1 0.3 30)", 1.0),
    mapped("oklch(0.7 0.4 150)", css_color::ColorSpace::Srgb),
    mapped("color(rec2020 1 0 0)", css_color::ColorSpace::Srgb),
    mapped("color(display-p3 0 1 0)", css_color::ColorSpace::Srgb),
    mapped("lab(100 104.3 -50.9)", css_color::ColorSpace::Rec2020),
  ])
}

///| Malformed input never panics: NUL, invalid UTF-8, lone surrogate bytes, every prefix of a nested expression.
fn control_malformed_bytes() -> String {
  let bad = StringBuilder::new()
  bad.write_string("rgb(255 ")
  bad.write_byte((0xFF).to_byte())
  bad.write_string(" 0)")
  let sur = StringBuilder::new()
  sur.write_string("red")
  sur.write_byte((0xED).to_byte())
  sur.write_byte((0xA0).to_byte())
  sur.write_byte((0x80).to_byte())
  let full = "oklch(from color-mix(in oklch longer hue, rgb(from #3b82f6 r calc(g * 0.8) b / 0.5) 30%, hsl(120 50% 50%)) calc(l + 0.05) c calc(h + 15) / alpha)"
  let mut i = 0
  let mut ok_prefixes = 0
  while i < full.length() {
    match css_color::parse(full.slice(0, i)) {
      Ok(_) => ok_prefixes = ok_prefixes + 1
      Err(_) => ()
    }
    i = i + 1
  }
  first([
    expect_err(bad.to_string()),
    expect_err(sur.to_string()),
    expect_err("rgb(255\00 0)"),
    expect_ok(full),
    if ok_prefixes == 0 { "" } else { ok_prefixes.to_string() + " proper prefixes parsed as colors" },
  ])
}

///| to_css() round trip for ordinary colors in every space.
fn control_to_css_round_trip() -> String {
  let xs = [
    "rgb(12 200 99 / 0.5)", "hsl(120 50% 40%)", "hwb(200 10% 20%)", "lab(50 20 -30)", "lch(60 40 300)", "oklab(0.6 0.1 -0.1)",
    "oklch(0.7 0.15 30 / none)", "color(display-p3 1 0.5 none)", "color(rec2020 0.2 0.3 0.4)", "color(xyz-d50 0.2 0.3 0.4)",
  ]
  let mut i = 0
  while i < xs.length() {
    match p(xs[i]) {
      Err(e) => return e
      Ok(c) =>
      match css_color::parse(c.to_css()) {
        Err(e) => return c.to_css() + " -> Err(" + e.to_string() + ")"
        Ok(b) =>
        if !near(b.c0, c.c0, 1.0e-6) || !near(b.c1, c.c1, 1.0e-6) || !near(b.c2, c.c2, 1.0e-6) || !near(b.alpha, c.alpha, 1.0e-6) ||
        b.m0 != c.m0 ||
        b.m1 != c.m1 ||
        b.m2 != c.m2 ||
        b.ma != c.ma {
          return xs[i] + " -> " + c.to_css() + " does not round-trip"
        }
      }
    }
    i = i + 1
  }
  ""
}

///| WCAG 2.1 relative luminance / contrast for opaque sRGB.
fn control_wcag() -> String {
  match (p("white"), p("black"), p("#767676")) {
    (Ok(w), Ok(b), Ok(g)) => {
      let r = w.contrast_ratio(b)
      let q = w.contrast_ratio(g)
      if !near(r, 21.0, 1.0e-12) {
        "contrast(white, black) = " + r.to_string()
      } else if !near(q, 4.54, 0.01) {
        "contrast(white, #767676) = " + q.to_string()
      } else {
        ""
      }
    }
    _ => "parse failed"
  }
}

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p1_1_hsl_near_white_black", "redteam_p1_2_relative_keywords_keep_none", "redteam_p2_1_to_css_fidelity",
    "redteam_p2_2_ed_matrices", "redteam_p2_3_token_boundaries", "redteam_p2_4_calc_too_lax", "redteam_p2_5_calc_and_numbers_too_strict",
    "redteam_p2_6_css_color_5_ed_syntax", "redteam_p2_7_analogous_components_and_sets", "redteam_p2_8_powerless_epsilons",
    "redteam_p2_9_hsl_parse_clamping", "redteam_p2_10_gamut_map_early_exit", "redteam_p2_11_mix_missing_hue_and_zero_alpha",
    "redteam_p2_12_huge_hue_normalisation", "redteam_p2_14_wcag_ignores_alpha", "control_named_colors_and_whitespace",
    "control_legacy_modern_separation", "control_angles", "control_color_mix_hues_and_percentages", "control_calc_arithmetic",
    "control_dos_guards", "control_gamut_mapping", "control_malformed_bytes", "control_to_css_round_trip", "control_wcag",
  ]
}

///|
pub fn run_case(name : String) -> String {
  match name {
    "redteam_p1_1_hsl_near_white_black" => redteam_p1_1_hsl_near_white_black()
    "redteam_p1_2_relative_keywords_keep_none" => redteam_p1_2_relative_keywords_keep_none()
    "redteam_p2_1_to_css_fidelity" => redteam_p2_1_to_css_fidelity()
    "redteam_p2_2_ed_matrices" => redteam_p2_2_ed_matrices()
    "redteam_p2_3_token_boundaries" => redteam_p2_3_token_boundaries()
    "redteam_p2_4_calc_too_lax" => redteam_p2_4_calc_too_lax()
    "redteam_p2_5_calc_and_numbers_too_strict" => redteam_p2_5_calc_and_numbers_too_strict()
    "redteam_p2_6_css_color_5_ed_syntax" => redteam_p2_6_css_color_5_ed_syntax()
    "redteam_p2_7_analogous_components_and_sets" => redteam_p2_7_analogous_components_and_sets()
    "redteam_p2_8_powerless_epsilons" => redteam_p2_8_powerless_epsilons()
    "redteam_p2_9_hsl_parse_clamping" => redteam_p2_9_hsl_parse_clamping()
    "redteam_p2_10_gamut_map_early_exit" => redteam_p2_10_gamut_map_early_exit()
    "redteam_p2_11_mix_missing_hue_and_zero_alpha" => redteam_p2_11_mix_missing_hue_and_zero_alpha()
    "redteam_p2_12_huge_hue_normalisation" => redteam_p2_12_huge_hue_normalisation()
    "redteam_p2_14_wcag_ignores_alpha" => redteam_p2_14_wcag_ignores_alpha()
    "control_named_colors_and_whitespace" => control_named_colors_and_whitespace()
    "control_legacy_modern_separation" => control_legacy_modern_separation()
    "control_angles" => control_angles()
    "control_color_mix_hues_and_percentages" => control_color_mix_hues_and_percentages()
    "control_calc_arithmetic" => control_calc_arithmetic()
    "control_dos_guards" => control_dos_guards()
    "control_gamut_mapping" => control_gamut_mapping()
    "control_malformed_bytes" => control_malformed_bytes()
    "control_to_css_round_trip" => control_to_css_round_trip()
