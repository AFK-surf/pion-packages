///| Red-team CLI for `packages/css_color` (native + wasm32, see ../REPORT.md).
///|   run <casefile>          -> one result line per `<target>\t<input>` line (protocol below)
///|   gamut <casefile>        -> `<target>\t<input>` -> to_gamut(target) coordinates, in_gamut, ΔE_OK to the origin
///|   time <casefile> <iters> -> parse every line `iters` times: `<us> <bytes> <OK|ERR variant>` per line
///|   api [dump]              -> extreme-value sweep of the public API (Color::new / convert / to_gamut / mix / format)
///|   list | case <name>      -> red-team / control cases (src/cases.pion)
///| An input that starts with `hex:` is given as hex bytes (NUL, invalid UTF-8, control bytes).
///| `run` output: `ERR <variant>` or
///|   `OK <space> c0 c1 c2 a <mask> T <target> t0 t1 t2 ta <mask> R r,g,b,a C r,g,b,a L <luminance> P <reparse> S <to_css>`
///| where <mask> is the m0 m1 m2 ma `none` flags as 4 digits, R = to_rgba8 (gamut mapped), C = to_rgba8_clamped,
///| P = parse(to_css()) as `<space> c0 c1 c2 a <mask>` or `ERR <variant>`.

import "css_color"

///|
fn parse_uint(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode the `hex:` form of an input; other inputs are returned as they are.
pub fn decode_input(s : String) -> String {
  if s.length() < 4 || s.slice(0, 4) != "hex:" {
    return s
  }
  let sb = StringBuilder::new()
  let mut i = 4
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
pub fn space_of(name : String) -> Option[css_color::ColorSpace] {
  match name {
    "srgb" => Some(css_color::ColorSpace::Srgb)
    "srgb-linear" => Some(css_color::ColorSpace::SrgbLinear)
    "display-p3" => Some(css_color::ColorSpace::DisplayP3)
    "a98-rgb" => Some(css_color::ColorSpace::A98Rgb)
    "prophoto-rgb" => Some(css_color::ColorSpace::ProphotoRgb)
    "rec2020" => Some(css_color::ColorSpace::Rec2020)
    "xyz-d50" => Some(css_color::ColorSpace::XyzD50)
    "xyz-d65" | "xyz" => Some(css_color::ColorSpace::XyzD65)
    "hsl" => Some(css_color::ColorSpace::Hsl)
    "hwb" => Some(css_color::ColorSpace::Hwb)
    "lab" => Some(css_color::ColorSpace::Lab)
    "lch" => Some(css_color::ColorSpace::Lch)
    "oklab" => Some(css_color::ColorSpace::Oklab)
    "oklch" => Some(css_color::ColorSpace::Oklch)
    _ => None
  }
}

///|
pub fn all_spaces() -> Array[css_color::ColorSpace] {
  [
    css_color::ColorSpace::Srgb,
    css_color::ColorSpace::SrgbLinear,
    css_color::ColorSpace::DisplayP3,
    css_color::ColorSpace::A98Rgb,
    css_color::ColorSpace::ProphotoRgb,
    css_color::ColorSpace::Rec2020,
    css_color::ColorSpace::XyzD50,
    css_color::ColorSpace::XyzD65,
    css_color::ColorSpace::Hsl,
    css_color::ColorSpace::Hwb,
    css_color::ColorSpace::Lab,
    css_color::ColorSpace::Lch,
    css_color::ColorSpace::Oklab,
    css_color::ColorSpace::Oklch,
  ]
}

///|
pub fn err_name(e : css_color::ColorError) -> String {
  match e {
    css_color::ColorError::EmptyInput => "EmptyInput"
    css_color::ColorError::InputTooLong(_) => "InputTooLong"
    css_color::ColorError::MaxDepthExceeded(_) => "MaxDepthExceeded"
    css_color::ColorError::InvalidSyntax(_) => "InvalidSyntax"
    css_color::ColorError::UnknownColor(_) => "UnknownColor"
    css_color::ColorError::UnknownColorSpace(_) => "UnknownColorSpace"
    css_color::ColorError::InvalidComponent(_) => "InvalidComponent"
    css_color::ColorError::InvalidAlpha(_) => "InvalidAlpha"
    css_color::ColorError::InvalidPercentage(_) => "InvalidPercentage"
    css_color::ColorError::InvalidCalc(_) => "InvalidCalc"
    css_color::ColorError::NonFiniteValue(_) => "NonFiniteValue"
  }
}

///|
fn b01(b : Bool) -> String {
  if b {
    "1"
  } else {
    "0"
  }
}

///| A Double as `b<IEEE-754 bits as Int64>`: exact, and independent of `Double::to_string`, whose shortest-digit
///| output differs between native and wasm32 on ties (9290347888448.8125 prints ...812 native, ...813 wasm32).
pub fn dbits(x : Double) -> String {
  "b" + x.to_bits().to_string()
}

///| `<space> c0 c1 c2 a <mask>`
pub fn coords(c : css_color::Color) -> String {
  c.space.css_name() + " " + dbits(c.c0) + " " + dbits(c.c1) + " " + dbits(c.c2) + " " + dbits(c.alpha) + " " +
  b01(c.m0) +
  b01(c.m1) +
  b01(c.m2) +
  b01(c.ma)
}

///|
fn quad(q : (Int, Int, Int, Int)) -> String {
  let (r, g, b, a) = q
  r.to_string() + "," + g.to_string() + "," + b.to_string() + "," + a.to_string()
}

///|
pub fn run_line(line : String) -> String {
  let mut tab = -1
  let mut i = 0
  while i < line.length() {
    if line.code_unit_at(i) == 9 {
      tab = i
      break
    }
    i = i + 1
  }
  let target_name = if tab < 0 { "-" } else { line.slice(0, tab) }
  let input = decode_input(if tab < 0 { line } else { line.slice(tab + 1, line.length()) })
  match css_color::parse(input) {
    Err(e) => "ERR " + err_name(e)
    Ok(c) => {
      let t = match space_of(target_name) {
        Some(sp) => c.convert(sp)
        None => c
      }
      let css = c.to_css()
      let rp = match css_color::parse(css) {
        Ok(p) => coords(p)
        Err(e) => "ERR " + err_name(e)
      }
      "OK " + coords(c) + " T " + coords(t) + " R " + quad(c.to_rgba8()) + " C " + quad(c.to_rgba8_clamped()) +
      " L " +
      dbits(c.relative_luminance()) +
      " P " +
      rp +
      " S " +
      css
    }
  }
}

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 10 {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < s.length() {
    out.push(s.slice(start, s.length()))
  }
  out
}

///|
fn gamut_line(line : String) -> String {
  let mut tab = -1
  let mut i = 0
  while i < line.length() {
    if line.code_unit_at(i) == 9 {
      tab = i
      break
    }
    i = i + 1
  }
  if tab < 0 {
    return "ERR NoTarget"
  }
  let sp = match space_of(line.slice(0, tab)) {
    Some(s) => s
    None => return "ERR NoTarget"
  }
  match css_color::parse(decode_input(line.slice(tab + 1, line.length()))) {
    Err(e) => "ERR " + err_name(e)
    Ok(c) => {
      let m = c.to_gamut(sp)
      let o1 = c.convert(css_color::ColorSpace::Oklab)
      let o2 = m.convert(css_color::ColorSpace::Oklab)
      let dl = o1.c0 - o2.c0
      let da = o1.c1 - o2.c1
      let db = o1.c2 - o2.c2
      "OK " + coords(m) + " I " + b01(m.in_gamut()) + " D " + dbits(dl * dl + da * da + db * db)
    }
  }
}

///|
fn api_values() -> Array[Double] {
  [0.0, -0.0, 1.0e-12, -1.0e-12, 5.0e-324, 0.5, 1.0, 100.0, 360.0, -360.0, 1.0e6, -1.0e6, 1.0e300, -1.0e300, 0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0]
}

///| FNV-1a over a string.
fn fnv(h : UInt64, s : String) -> UInt64 {
  fnv_bytes(h, s)
}

///|
fn fnv_bytes(h : UInt64, s : String) -> UInt64 {
  let mut acc = h
  let mut i = 0
  while i < s.length() {
    acc = (acc ^ (s.code_unit_at(i) & 0xFF).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  acc
}

///| In `api dump` mode every hashed value is also printed (to diff native and wasm32 line by line).
fn api_note(world : World, dump : Bool, s : String) -> String {
  if dump {
    io_println(world, s)
  }
  s
}

///|
fn finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

///| Sweep of every public entry point with extreme coordinates: counts must be stable and nothing may trap or hang.
fn run_api(world : World, dump : Bool) -> Int {
  let vals = api_values()
  let spaces = all_spaces()
  let mut h : UInt64 = 14695981039346656037UL
  let mut calls = 0
  let mut nonfinite_from_finite = 0
  let mut nonfinite_from_moderate = 0
  let mut css_nan = 0
  let mut si = 0
  while si < spaces.length() {
    let mut ch = 0
    while ch < 4 {
      let mut vi = 0
      while vi < vals.length() {
        let v = vals[vi]
        let c0 = if ch == 0 { v } else { 0.5 }
        let c1 = if ch == 1 { v } else { 0.25 }
        let c2 = if ch == 2 { v } else { 0.125 }
        let a = if ch == 3 { v } else { 1.0 }
        let c = css_color::Color::new(spaces[si], c0, c1, c2, a)
        let mut ti = 0
        while ti < spaces.length() {
          let t = c.convert(spaces[ti])
          calls = calls + 1
          if finite(v) && (!finite(t.c0) || !finite(t.c1) || !finite(t.c2)) {
            nonfinite_from_finite = nonfinite_from_finite + 1
            if v <= 1.0e6 && v >= -1.0e6 {
              nonfinite_from_moderate = nonfinite_from_moderate + 1
            }
          }
          h = fnv(h, api_note(world, dump, coords(t)))
          ti = ti + 1
        }
        let g1 = c.to_gamut(css_color::ColorSpace::Srgb)
        let g2 = c.to_gamut(css_color::ColorSpace::DisplayP3)
        h = fnv(h, api_note(world, dump, coords(g1)))
        h = fnv(h, api_note(world, dump, coords(g2)))
        h = fnv(h, api_note(world, dump, quad(c.to_rgba8())))
        h = fnv(h, api_note(world, dump, quad(c.to_rgba8_clamped())))
        let css = c.to_css()
        if css.contains("nan") || css.contains("inf") {
          css_nan = css_nan + 1
        }
        h = fnv(h, api_note(world, dump, css))
        h = fnv(h, api_note(world, dump, c.to_hex()))
        h = fnv(h, api_note(world, dump, dbits(c.relative_luminance())))
        h = fnv(h, api_note(world, dump, dbits(c.contrast_ratio(css_color::Color::srgb(1.0, 1.0, 1.0, 1.0)))))
        let mut mi = 0
        while mi < spaces.length() {
          match c.mix(css_color::Color::srgb(0.2, 0.4, 0.6, 1.0), spaces[mi], css_color::HueInterpolation::Longer, 30.0, 70.0) {
            Ok(m) => h = fnv(h, api_note(world, dump, coords(m)))
            Err(e) => h = fnv(h, api_note(world, dump, err_name(e)))
          }
          mi = mi + 1
        }
        calls = calls + 6 + spaces.length()
        vi = vi + 1
      }
      ch = ch + 1
    }
    si = si + 1
  }
  io_println(
    world,
    "api calls=" + calls.to_string() + " nonfinite_convert_from_finite_input=" + nonfinite_from_finite.to_string() +
    " moderate=" +
    nonfinite_from_moderate.to_string() +
    " css_nan_or_inf=" +
    css_nan.to_string() +
    " fnv=" +
    h.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: css_color_audit run|gamut <casefile> | time <casefile> <iters> | api | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "run" || mode == "gamut") && args.length() >= 3 {
    let text = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    let lines = split_lines(text)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < lines.length() {
      sb.write_string(if mode == "run" { run_line(lines[i]) } else { gamut_line(lines[i]) })
      sb.write_char('\n')
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "time" && args.length() >= 4 {
    let text = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 2
    }
    let iters = parse_uint(args[3])
    let lines = split_lines(text)
    let mut i = 0
    while i < lines.length() {
      let input = decode_input(lines[i])
      let t0 = clock_monotonic_us()
      let mut res = ""
      let mut k = 0
      while k < iters {
        res = match css_color::parse(input) {
          Ok(c) => "OK " + quad(c.to_rgba8())
          Err(e) => "ERR " + err_name(e)
        }
        k = k + 1
      }
      let t1 = clock_monotonic_us()
      io_println(world, (t1 - t0).to_string() + " " + input.length().to_string() + " " + res)
      i = i + 1
    }
    return 0
  }
  if mode == "api" {
    return run_api(world, args.length() >= 3 && args[2] == "dump")
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
