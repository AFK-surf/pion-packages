///| Complete W3C CSS Color Module Level 4 & 5 recursive-descent parser.
///| Supports: 148 named colors + `transparent`, hex (#RGB/#RGBA/#RRGGBB/#RRGGBBAA),
///| legacy & modern rgb/rgba/hsl/hsla, hwb, lab, lch, oklab, oklch, color() (all 9 spaces),
///| color-mix() (rectangular + polar with 4 hue modes), relative color syntax (`from`),
///| and `calc()` arithmetic expressions.
///| Zero `extern "C"`, zero `World`, zero mutable globals, bounded nesting depth & input length.

struct Cursor {
  src : String
  len : Int
  mut pos : Int
}

fn Cursor::new(s : String) -> Cursor {
  Cursor::{ src: s, len: s.length(), pos: 0 }
}

fn is_ascii_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_ident_char(c : Int) -> Bool {
  is_ascii_alpha(c) || is_ascii_digit(c) || c == 45 || c == 95
}

fn to_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn Cursor::eof(self : Cursor) -> Bool {
  self.pos >= self.len
}

fn Cursor::peek(self : Cursor) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn Cursor::peek_at(self : Cursor, offset : Int) -> Int {
  let idx = self.pos + offset
  if idx >= 0 && idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Cursor::skip_ws(self : Cursor) -> Unit {
  while self.pos < self.len && is_ascii_ws(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
}

fn ident_lower_char(c : Int) -> Char {
  match to_ascii_lower(c) {
    45 => '-'
    95 => '_'
    48 => '0'
    49 => '1'
    50 => '2'
    51 => '3'
    52 => '4'
    53 => '5'
    54 => '6'
    55 => '7'
    56 => '8'
    57 => '9'
    97 => 'a'
    98 => 'b'
    99 => 'c'
    100 => 'd'
    101 => 'e'
    102 => 'f'
    103 => 'g'
    104 => 'h'
    105 => 'i'
    106 => 'j'
    107 => 'k'
    108 => 'l'
    109 => 'm'
    110 => 'n'
    111 => 'o'
    112 => 'p'
    113 => 'q'
    114 => 'r'
    115 => 's'
    116 => 't'
    117 => 'u'
    118 => 'v'
    119 => 'w'
    120 => 'x'
    121 => 'y'
    _ => 'z'
  }
}

fn Cursor::read_ident_lower(self : Cursor) -> String {
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) {
      sb.write_char(ident_lower_char(c))
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  sb.to_string()
}

fn Cursor::peek_keyword(self : Cursor, kw : String) -> Bool {
  let klen = kw.length()
  if self.pos + klen > self.len {
    return false
  }
  let mut i = 0
  while i < klen {
    if to_ascii_lower(self.src.code_unit_at(self.pos + i)) != kw.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  let next = self.peek_at(klen)
  next == -1 || !is_ident_char(next)
}

fn Cursor::expect_char(self : Cursor, ch : Int, label : String) -> Result[Unit, ColorError] {
  self.skip_ws()
  if self.peek() == ch {
    self.pos = self.pos + 1
    Ok(())
  } else {
    Err(ColorError::InvalidSyntax("expected " + label))
  }
}

// === Number & unit parsing ===

fn parse_css_number(cur : Cursor) -> Result[Double, ColorError] {
  let start = cur.pos
  let mut sign = 1.0
  let c0 = cur.peek()
  if c0 == 43 {
    cur.pos = cur.pos + 1
  } else if c0 == 45 {
    sign = -1.0
    cur.pos = cur.pos + 1
  }
  let mut int_val = 0.0
  let mut has_digits = false
  while !cur.eof() && is_ascii_digit(cur.peek()) {
    has_digits = true
    int_val = int_val * 10.0 + (cur.peek() - 48).to_double()
    cur.pos = cur.pos + 1
  }
  let mut frac_val = 0.0
  let mut frac_scale = 1.0
  if cur.peek() == 46 {
    // Only consume '.' if followed by a digit
    if is_ascii_digit(cur.peek_at(1)) {
      cur.pos = cur.pos + 1
      while !cur.eof() && is_ascii_digit(cur.peek()) {
        has_digits = true
        frac_val = frac_val * 10.0 + (cur.peek() - 48).to_double()
        frac_scale = frac_scale * 10.0
        cur.pos = cur.pos + 1
      }
    }
  }
  if !has_digits {
    cur.pos = start
    return Err(ColorError::InvalidComponent("expected number"))
  }
  let mut res_num = sign * (int_val + frac_val / frac_scale)
  // Optional scientific notation exponent (e/E)
  let ce = cur.peek()
  if ce == 101 || ce == 69 {
    let saved = cur.pos
    cur.pos = cur.pos + 1
    let mut exp_sign = 1
    let cs = cur.peek()
    if cs == 43 {
      cur.pos = cur.pos + 1
    } else if cs == 45 {
      exp_sign = -1
      cur.pos = cur.pos + 1
    }
    let mut exp_val = 0
    let mut has_exp = false
    while !cur.eof() && is_ascii_digit(cur.peek()) {
      has_exp = true
      if exp_val < 10000 {
        exp_val = exp_val * 10 + (cur.peek() - 48)
      }
      cur.pos = cur.pos + 1
    }
    if !has_exp {
      cur.pos = saved
    } else {
      let signed_exp = exp_sign * exp_val
      if signed_exp > 308 {
        return Err(ColorError::NonFiniteValue("exponent overflow"))
      } else if signed_exp < -324 {
        res_num = 0.0
      } else {
        res_num = res_num * f64_pow(10.0, signed_exp.to_double())
      }
    }
  }
  if !f64_is_finite(res_num) {
    return Err(ColorError::NonFiniteValue("number overflow"))
  }
  Ok(res_num)
}

// === Channel environment for CSS Color 5 relative color syntax & calc() ===

val struct CalcEnv {
  active : Bool
  k0 : String
  v0 : Double
  k1 : String
  v1 : Double
  k2 : String
  v2 : Double
  va : Double
}

fn CalcEnv::empty() -> CalcEnv {
  CalcEnv::{ active: false, k0: "", v0: 0.0, k1: "", v1: 0.0, k2: "", v2: 0.0, va: 1.0 }
}

fn CalcEnv::make(
  k0 : String,
  v0 : Double,
  k1 : String,
  v1 : Double,
  k2 : String,
  v2 : Double,
  va : Double,
) -> CalcEnv {
  CalcEnv::{ active: true, k0: k0, v0: v0, k1: k1, v1: v1, k2: k2, v2: v2, va: va }
}

fn CalcEnv::lookup(self : CalcEnv, name : String) -> Option[Double] {
  if !self.active {
    return None
  }
  if name == self.k0 {
    Some(self.v0)
  } else if name == self.k1 {
    Some(self.v1)
  } else if name == self.k2 {
    Some(self.v2)
  } else if name == "alpha" {
    Some(self.va)
  } else {
    None
  }
}

// === Recursive-descent `calc(...)` expression evaluator ===

fn parse_calc_expr(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[Double, ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  let mut left = match parse_calc_term(cur, depth, env, pct_basis, allow_angle) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  while true {
    cur.skip_ws()
    let c = cur.peek()
    if c == 43 || c == 45 {
      cur.pos = cur.pos + 1
      let right = match parse_calc_term(cur, depth, env, pct_basis, allow_angle) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      left = if c == 43 { left + right } else { left - right }
      if !f64_is_finite(left) {
        return Err(ColorError::NonFiniteValue("calc overflow"))
      }
    } else {
      break
    }
  }
  Ok(left)
}

fn parse_calc_term(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[Double, ColorError] {
  let mut left = match parse_calc_factor(cur, depth, env, pct_basis, allow_angle) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  while true {
    cur.skip_ws()
    let c = cur.peek()
    if c == 42 || c == 47 {
      cur.pos = cur.pos + 1
      let right = match parse_calc_factor(cur, depth, env, pct_basis, allow_angle) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if c == 42 {
        left = left * right
      } else {
        if right == 0.0 {
          return Err(ColorError::InvalidCalc("division by zero"))
        }
        left = left / right
      }
      if !f64_is_finite(left) {
        return Err(ColorError::NonFiniteValue("calc overflow"))
      }
    } else {
      break
    }
  }
  Ok(left)
}

fn parse_calc_factor(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[Double, ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  cur.skip_ws()
  let c = cur.peek()
  if c == 40 {
    // '('
    cur.pos = cur.pos + 1
    let v = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
      Ok(calc_v) => calc_v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => Ok(v)
      Err(e) => Err(e)
    }
  } else if c == 43 {
    // unary '+'
    cur.pos = cur.pos + 1
    parse_calc_factor(cur, depth + 1, env, pct_basis, allow_angle)
  } else if c == 45 && !is_ascii_digit(cur.peek_at(1)) && cur.peek_at(1) != 46 {
    // unary '-' before '(' or identifier
    cur.pos = cur.pos + 1
    match parse_calc_factor(cur, depth + 1, env, pct_basis, allow_angle) {
      Ok(v) => Ok(-v)
      Err(e) => Err(e)
    }
  } else if is_ascii_alpha(c) {
    let name = cur.read_ident_lower()
    if name == "calc" && cur.peek() == 40 {
      cur.pos = cur.pos + 1
      let v = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
        Ok(calc_v) => calc_v
        Err(e) => return Err(e)
      }
      match cur.expect_char(41, "')'") {
        Ok(_) => Ok(v)
        Err(e) => Err(e)
      }
    } else if name == "pi" {
      Ok(pi)
    } else if name == "e" {
      Ok(2.71828182845904523536)
    } else {
      match env.lookup(name) {
        Some(v) => Ok(v)
        None => Err(ColorError::InvalidCalc("unknown identifier in calc: " + name))
      }
    }
  } else {
    let num = match parse_css_number(cur) {
      Ok(v) => v
      Err(_) => return Err(ColorError::InvalidCalc("expected operand in calc"))
    }
    if cur.peek() == 37 {
      // '%'
      cur.pos = cur.pos + 1
      Ok(num * pct_basis / 100.0)
    } else if is_ascii_alpha(cur.peek()) {
      let unit = cur.read_ident_lower()
      if allow_angle {
        convert_angle_unit(num, unit)
      } else {
        Err(ColorError::InvalidCalc("unexpected unit in calc: " + unit))
      }
    } else {
      Ok(num)
    }
  }
}

fn convert_angle_unit(ang : Double, unit : String) -> Result[Double, ColorError] {
  match unit {
    "deg" => Ok(ang)
    "grad" => Ok(ang * 0.9)
    "rad" => Ok(rad_to_deg(ang))
    "turn" => Ok(ang * 360.0)
    _ => Err(ColorError::InvalidComponent("unknown angle unit: " + unit))
  }
}

// === Component parsers ===
// Returns (value, is_missing, is_percent)

fn parse_component(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_none : Bool,
  allow_angle : Bool,
  allow_percent : Bool,
) -> Result[(Double, Bool, Bool), ColorError] {
  cur.skip_ws()
  if allow_none && cur.peek_keyword("none") {
    cur.pos = cur.pos + 4
    return Ok((0.0, true, false))
  }
  if cur.peek_keyword("calc") && cur.peek_at(4) == 40 {
    cur.pos = cur.pos + 5
    let v = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
      Ok(calc_v) => calc_v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => return Ok((v, false, false))
      Err(e) => return Err(e)
    }
  }
  if env.active && is_ascii_alpha(cur.peek()) {
    let saved = cur.pos
    let ident = cur.read_ident_lower()
    match env.lookup(ident) {
      Some(v) => return Ok((v, false, false))
      None => {
        cur.pos = saved
        return Err(ColorError::InvalidComponent("unknown channel identifier: " + ident))
      }
    }
  }
  let num = match parse_css_number(cur) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if cur.peek() == 37 {
    if !allow_percent {
      return Err(ColorError::InvalidComponent("percentage not allowed here"))
    }
    cur.pos = cur.pos + 1
    return Ok((num * pct_basis / 100.0, false, true))
  }
  if is_ascii_alpha(cur.peek()) {
    if allow_angle {
      let unit = cur.read_ident_lower()
      match convert_angle_unit(num, unit) {
        Ok(deg) => return Ok((deg, false, false))
        Err(e) => return Err(e)
      }
    } else {
      return Err(ColorError::InvalidComponent("unexpected unit"))
    }
  }
  Ok((num, false, false))
}

fn parse_optional_modern_alpha(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  default_alpha : Double,
  default_ma : Bool,
) -> Result[(Double, Bool), ColorError] {
  cur.skip_ws()
  if cur.peek() == 47 {
    // '/'
    cur.pos = cur.pos + 1
    let (v, missing, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(res) => res
      Err(_) => return Err(ColorError::InvalidAlpha("invalid alpha component"))
    }
    Ok((f64_clamp01(v), missing))
  } else {
    Ok((default_alpha, default_ma))
  }
}

// === Hex color ===

fn parse_hex(cur : Cursor) -> Result[Color, ColorError] {
  // Consume '#'
  cur.pos = cur.pos + 1
  let start = cur.pos
  while !cur.eof() && hex_val(cur.peek()) >= 0 {
    cur.pos = cur.pos + 1
  }
  let n = cur.pos - start
  if n == 3 {
    let r = hex_val(cur.src.code_unit_at(start)) * 17
    let g = hex_val(cur.src.code_unit_at(start + 1)) * 17
    let b = hex_val(cur.src.code_unit_at(start + 2)) * 17
    Ok(Color::rgba8(r, g, b, 255))
  } else if n == 4 {
    let r = hex_val(cur.src.code_unit_at(start)) * 17
    let g = hex_val(cur.src.code_unit_at(start + 1)) * 17
    let b = hex_val(cur.src.code_unit_at(start + 2)) * 17
    let a = hex_val(cur.src.code_unit_at(start + 3)) * 17
    Ok(Color::rgba8(r, g, b, a))
  } else if n == 6 {
    let r = hex_val(cur.src.code_unit_at(start)) * 16 + hex_val(cur.src.code_unit_at(start + 1))
    let g = hex_val(cur.src.code_unit_at(start + 2)) * 16 + hex_val(cur.src.code_unit_at(start + 3))
    let b = hex_val(cur.src.code_unit_at(start + 4)) * 16 + hex_val(cur.src.code_unit_at(start + 5))
    Ok(Color::rgba8(r, g, b, 255))
  } else if n == 8 {
    let r = hex_val(cur.src.code_unit_at(start)) * 16 + hex_val(cur.src.code_unit_at(start + 1))
    let g = hex_val(cur.src.code_unit_at(start + 2)) * 16 + hex_val(cur.src.code_unit_at(start + 3))
    let b = hex_val(cur.src.code_unit_at(start + 4)) * 16 + hex_val(cur.src.code_unit_at(start + 5))
    let a = hex_val(cur.src.code_unit_at(start + 6)) * 16 + hex_val(cur.src.code_unit_at(start + 7))
    Ok(Color::rgba8(r, g, b, a))
  } else {
    Err(ColorError::InvalidSyntax("invalid hex color length"))
  }
}

// === Helper for relative color `from <origin>` ===

fn try_parse_from_origin(cur : Cursor, depth : Int) -> Result[Option[Color], ColorError] {
  cur.skip_ws()
  if cur.peek_keyword("from") && is_ascii_ws(cur.peek_at(4)) {
    cur.pos = cur.pos + 4
    cur.skip_ws()
    match parse_color_expr(cur, depth + 1) {
      Ok(c) => Ok(Some(c))
      Err(e) => Err(e)
    }
  } else {
    Ok(None)
  }
}

// === rgb() / rgba() ===

fn parse_rgb(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match origin_opt {
    Some(orig) => {
      let s = orig.convert(ColorSpace::Srgb)
      let env = CalcEnv::make("r", s.c0 * 255.0, "g", s.c1 * 255.0, "b", s.c2 * 255.0, s.alpha)
      let (r, m0, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (g, m1, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (b, m2, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, s.alpha, s.ma) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match cur.expect_char(41, "')'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return Ok(Color::new_with_missing(ColorSpace::Srgb, r / 255.0, g / 255.0, b / 255.0, a, m0, m1, m2, ma))
    }
    None => ()
  }
  let env = CalcEnv::empty()
  let (r, m0, p0) = match parse_component(cur, depth, env, 255.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  cur.skip_ws()
  let legacy = cur.peek() == 44
  if legacy {
    if m0 {
      return Err(ColorError::InvalidSyntax("'none' is not allowed in legacy comma rgb()"))
    }
    cur.pos = cur.pos + 1
    let (g, m1, p1) = match parse_component(cur, depth, env, 255.0, false, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match cur.expect_char(44, "','") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let (b, m2, p2) = match parse_component(cur, depth, env, 255.0, false, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if p0 != p1 || p1 != p2 {
      return Err(ColorError::InvalidSyntax("legacy rgb() cannot mix numbers and percentages"))
    }
    cur.skip_ws()
    let mut alpha = 1.0
    if cur.peek() == 44 {
      cur.pos = cur.pos + 1
      let (av, _, _) = match parse_component(cur, depth, env, 1.0, false, false, true) {
        Ok(v) => v
        Err(_) => return Err(ColorError::InvalidAlpha("invalid legacy rgb() alpha"))
      }
      alpha = f64_clamp01(av)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Srgb,
        f64_clamp01(r / 255.0),
        f64_clamp01(g / 255.0),
        f64_clamp01(b / 255.0),
        alpha,
        m0,
        m1,
        m2,
        false,
      ),
    )
  } else {
    let (g, m1, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (b, m2, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, 1.0, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Srgb,
        f64_clamp01(r / 255.0),
        f64_clamp01(g / 255.0),
        f64_clamp01(b / 255.0),
        a,
        m0,
        m1,
        m2,
        ma,
      ),
    )
  }
}

// === hsl() / hsla() ===

fn parse_hsl(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match origin_opt {
    Some(orig) => {
      let h_col = orig.convert(ColorSpace::Hsl)
      let env = CalcEnv::make("h", h_col.c0, "s", h_col.c1, "l", h_col.c2, h_col.alpha)
      let (h, m0, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (s, m1, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (l, m2, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, h_col.alpha, h_col.ma) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match cur.expect_char(41, "')'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return Ok(Color::new_with_missing(ColorSpace::Hsl, f64_normalize_hue(h), s, l, a, m0, m1, m2, ma))
    }
    None => ()
  }
  let env = CalcEnv::empty()
  let (h, m0, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  cur.skip_ws()
  let legacy = cur.peek() == 44
  if legacy {
    if m0 {
      return Err(ColorError::InvalidSyntax("'none' is not allowed in legacy comma hsl()"))
    }
    cur.pos = cur.pos + 1
    let (s, _, p1) = match parse_component(cur, depth, env, 100.0, false, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !p1 {
      return Err(ColorError::InvalidSyntax("legacy hsl() saturation must be a percentage"))
    }
    match cur.expect_char(44, "','") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let (l, _, p2) = match parse_component(cur, depth, env, 100.0, false, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !p2 {
      return Err(ColorError::InvalidSyntax("legacy hsl() lightness must be a percentage"))
    }
    cur.skip_ws()
    let mut alpha = 1.0
    if cur.peek() == 44 {
      cur.pos = cur.pos + 1
      let (av, _, _) = match parse_component(cur, depth, env, 1.0, false, false, true) {
        Ok(v) => v
        Err(_) => return Err(ColorError::InvalidAlpha("invalid legacy hsl() alpha"))
      }
      alpha = f64_clamp01(av)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Hsl,
        f64_normalize_hue(h),
        f64_clamp(s, 0.0, 100.0),
        f64_clamp(l, 0.0, 100.0),
        alpha,
        false,
        false,
        false,
        false,
      ),
    )
  } else {
    let (s, m1, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (l, m2, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, 1.0, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Hsl,
        f64_normalize_hue(h),
        f64_clamp(s, 0.0, 100.0),
        f64_clamp(l, 0.0, 100.0),
        a,
        m0,
        m1,
        m2,
        ma,
      ),
    )
  }
}

// === hwb() ===

fn parse_hwb(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(ColorSpace::Hwb)
      (CalcEnv::make("h", c.c0, "w", c.c1, "b", c.c2, c.alpha), c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (h, m0, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (w, m1, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (b, m2, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(Color::new_with_missing(ColorSpace::Hwb, f64_normalize_hue(h), w, b, a, m0, m1, m2, ma))
}

// === lab() / lch() / oklab() / oklch() ===

fn parse_lab(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(ColorSpace::Lab)
      (CalcEnv::make("l", c.c0, "a", c.c1, "b", c.c2, c.alpha), c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (l, m0, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (a, m1, _) = match parse_component(cur, depth, env, 125.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (b, m2, _) = match parse_component(cur, depth, env, 125.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(Color::new_with_missing(ColorSpace::Lab, f64_clamp(l, 0.0, 100.0), a, b, alpha, m0, m1, m2, ma))
}

fn parse_lch(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(ColorSpace::Lch)
      (CalcEnv::make("l", c.c0, "c", c.c1, "h", c.c2, c.alpha), c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (l, m0, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (c, m1, _) = match parse_component(cur, depth, env, 150.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (h, m2, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(
    Color::new_with_missing(
      ColorSpace::Lch,
      f64_clamp(l, 0.0, 100.0),
      f64_max(0.0, c),
      f64_normalize_hue(h),
      alpha,
      m0,
      m1,
      m2,
      ma,
    ),
  )
}

fn parse_oklab(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(ColorSpace::Oklab)
      (CalcEnv::make("l", c.c0, "a", c.c1, "b", c.c2, c.alpha), c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (l, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (a, m1, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (b, m2, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(Color::new_with_missing(ColorSpace::Oklab, f64_clamp01(l), a, b, alpha, m0, m1, m2, ma))
}

fn parse_oklch(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(ColorSpace::Oklch)
      (CalcEnv::make("l", c.c0, "c", c.c1, "h", c.c2, c.alpha), c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (l, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (c, m1, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (h, m2, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(
    Color::new_with_missing(
      ColorSpace::Oklch,
      f64_clamp01(l),
      f64_max(0.0, c),
      f64_normalize_hue(h),
      alpha,
      m0,
      m1,
      m2,
      ma,
    ),
  )
}

// === color() function ===

fn parse_predefined_color_space(name : String) -> Result[ColorSpace, ColorError] {
  match name {
    "srgb" => Ok(ColorSpace::Srgb)
    "srgb-linear" => Ok(ColorSpace::SrgbLinear)
    "display-p3" => Ok(ColorSpace::DisplayP3)
    "a98-rgb" => Ok(ColorSpace::A98Rgb)
    "prophoto-rgb" => Ok(ColorSpace::ProphotoRgb)
    "rec2020" => Ok(ColorSpace::Rec2020)
    "xyz" | "xyz-d65" => Ok(ColorSpace::XyzD65)
    "xyz-d50" => Ok(ColorSpace::XyzD50)
    _ => Err(ColorError::UnknownColorSpace(name))
  }
}

fn parse_color_fn(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  let origin_opt = match try_parse_from_origin(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  cur.skip_ws()
  let space_name = cur.read_ident_lower()
  let space = match parse_predefined_color_space(space_name) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let (env, def_a, def_ma) = match origin_opt {
    Some(orig) => {
      let c = orig.convert(space)
      let e = match space {
        ColorSpace::XyzD50 | ColorSpace::XyzD65 => CalcEnv::make("x", c.c0, "y", c.c1, "z", c.c2, c.alpha)
        _ => CalcEnv::make("r", c.c0, "g", c.c1, "b", c.c2, c.alpha)
      }
      (e, c.alpha, c.ma)
    }
    None => (CalcEnv::empty(), 1.0, false)
  }
  let (c0, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (c1, m1, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (c2, m2, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, def_a, def_ma) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(Color::new_with_missing(space, c0, c1, c2, alpha, m0, m1, m2, ma))
}

// === color-mix() ===

fn parse_interpolation_space(name : String) -> Result[ColorSpace, ColorError] {
  match name {
    "srgb" => Ok(ColorSpace::Srgb)
    "srgb-linear" => Ok(ColorSpace::SrgbLinear)
    "display-p3" => Ok(ColorSpace::DisplayP3)
    "a98-rgb" => Ok(ColorSpace::A98Rgb)
    "prophoto-rgb" => Ok(ColorSpace::ProphotoRgb)
    "rec2020" => Ok(ColorSpace::Rec2020)
    "xyz" | "xyz-d65" => Ok(ColorSpace::XyzD65)
    "xyz-d50" => Ok(ColorSpace::XyzD50)
    "lab" => Ok(ColorSpace::Lab)
    "oklab" => Ok(ColorSpace::Oklab)
    "hsl" => Ok(ColorSpace::Hsl)
    "hwb" => Ok(ColorSpace::Hwb)
    "lch" => Ok(ColorSpace::Lch)
    "oklch" => Ok(ColorSpace::Oklch)
    _ => Err(ColorError::UnknownColorSpace(name))
  }
}

fn parse_mix_percent(cur : Cursor) -> Result[Double, ColorError] {
  cur.skip_ws()
  let v = match parse_css_number(cur) {
    Ok(num) => num
    Err(_) => return Err(ColorError::InvalidPercentage("expected percentage in color-mix"))
  }
  if cur.peek() != 37 {
    return Err(ColorError::InvalidPercentage("missing '%' in color-mix"))
  }
  cur.pos = cur.pos + 1
  Ok(v)
}

fn starts_with_number(cur : Cursor) -> Bool {
  let c = cur.peek()
  is_ascii_digit(c) || c == 46 || ((c == 43 || c == 45) && (is_ascii_digit(cur.peek_at(1)) || cur.peek_at(1) == 46))
}

fn parse_mix_item(cur : Cursor, depth : Int) -> Result[(Color, Option[Double]), ColorError] {
  cur.skip_ws()
  if starts_with_number(cur) {
    let pct = match parse_mix_percent(cur) {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    let col = match parse_color_expr(cur, depth + 1) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    Ok((col, Some(pct)))
  } else {
    let col = match parse_color_expr(cur, depth + 1) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    if starts_with_number(cur) {
      let pct = match parse_mix_percent(cur) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      Ok((col, Some(pct)))
    } else {
      Ok((col, None))
    }
  }
}

fn parse_color_mix(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  cur.skip_ws()
  if !cur.peek_keyword("in") {
    return Err(ColorError::InvalidSyntax("color-mix() must start with 'in <colorspace>'"))
  }
  cur.pos = cur.pos + 2
  cur.skip_ws()
  let space_name = cur.read_ident_lower()
  let space = match parse_interpolation_space(space_name) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  cur.skip_ws()
  let mut hue_mode = HueInterpolation::Shorter
  if cur.peek() != 44 {
    if !space.is_polar() {
      return Err(ColorError::InvalidSyntax("hue interpolation method only allowed for polar color spaces"))
    }
    let kw = cur.read_ident_lower()
    hue_mode = match kw {
      "shorter" => HueInterpolation::Shorter
      "longer" => HueInterpolation::Longer
      "increasing" => HueInterpolation::Increasing
      "decreasing" => HueInterpolation::Decreasing
      _ => return Err(ColorError::InvalidSyntax("unknown hue interpolation method: " + kw))
    }
    cur.skip_ws()
    let hue_kw = cur.read_ident_lower()
    if hue_kw != "hue" {
      return Err(ColorError::InvalidSyntax("expected 'hue' after hue interpolation method"))
    }
  }
  match cur.expect_char(44, "','") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let (c1, p1) = match parse_mix_item(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(44, "','") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let (c2, p2) = match parse_mix_item(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  mix_colors_internal(c1, c2, space, hue_mode, p1, p2)
}

// === Top-level expression dispatcher ===

fn parse_color_expr(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  cur.skip_ws()
  if cur.eof() {
    return Err(ColorError::EmptyInput)
  }
  let c = cur.peek()
  if c == 35 {
    // '#'
    return parse_hex(cur)
  }
  if is_ascii_alpha(c) {
    let ident = cur.read_ident_lower()
    if cur.peek() == 40 {
      // '('
      cur.pos = cur.pos + 1
      match ident {
        "rgb" | "rgba" => parse_rgb(cur, depth)
        "hsl" | "hsla" => parse_hsl(cur, depth)
        "hwb" => parse_hwb(cur, depth)
        "lab" => parse_lab(cur, depth)
        "lch" => parse_lch(cur, depth)
        "oklab" => parse_oklab(cur, depth)
        "oklch" => parse_oklch(cur, depth)
        "color" => parse_color_fn(cur, depth)
        "color-mix" => parse_color_mix(cur, depth)
        _ => Err(ColorError::InvalidSyntax("unknown color function: " + ident))
      }
    } else {
      match lookup_named_color(ident) {
        Some((r, g, b, a)) => Ok(Color::rgba8(r, g, b, a))
        None => Err(ColorError::UnknownColor(ident))
      }
    }
  } else {
    Err(ColorError::InvalidSyntax("unexpected character in color"))
  }
}

///| Parse any W3C CSS Color Module Level 4 & 5 color string.
pub fn parse(input : String) -> Result[Color, ColorError] {
  if input.length() > max_input_length {
    return Err(ColorError::InputTooLong(input.length()))
  }
  let cur = Cursor::new(input)
  cur.skip_ws()
  if cur.eof() {
    return Err(ColorError::EmptyInput)
  }
  let col = match parse_color_expr(cur, 0) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  cur.skip_ws()
  if !cur.eof() {
    return Err(ColorError::InvalidSyntax("unexpected trailing characters"))
  }
  Ok(col)
}
