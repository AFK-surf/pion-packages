///| Complete W3C CSS Color Module Level 4 & 5 recursive-descent parser.
///| Supports: 148 named colors + `transparent`, hex (#RGB/#RGBA/#RRGGBB/#RRGGBBAA),
///| legacy & modern rgb/rgba/hsl/hsla, hwb, lab, lch, oklab, oklch, color() (all 9 spaces),
///| color-mix() (rectangular + polar with 4 hue modes), relative color syntax (`from`),
///| and `calc()` arithmetic expressions.
///| Zero `extern "C"`, zero `World`, zero mutable globals, bounded nesting depth & input length.

struct Cursor {
  src : String
  len : Int
  mut pos : Int
  mut num_val : Double
  mut comp_missing : Bool
  mut comp_pct : Bool
  mut err : ColorError
}

fn Cursor::new(s : String) -> Cursor {
  Cursor::{
    src: s,
    len: s.length(),
    pos: 0,
    num_val: 0.0,
    comp_missing: false,
    comp_pct: false,
    err: ColorError::EmptyInput,
  }
}

fn Cursor::new_at(s : String, pos : Int) -> Cursor {
  Cursor::{
    src: s,
    len: s.length(),
    pos: pos,
    num_val: 0.0,
    comp_missing: false,
    comp_pct: false,
    err: ColorError::EmptyInput,
  }
}

fn is_ascii_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_ident_char(c : Int) -> Bool {
  is_ascii_alpha(c) || is_ascii_digit(c) || c == 45 || c == 95
}

fn to_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn Cursor::eof(self : Cursor) -> Bool {
  self.pos >= self.len
}

fn Cursor::peek(self : Cursor) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn Cursor::peek_at(self : Cursor, offset : Int) -> Int {
  let idx = self.pos + offset
  if idx >= 0 && idx < self.len {
    self.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn Cursor::skip_ws(self : Cursor) -> Unit {
  let s = self.src
  let n = self.len
  let mut p = self.pos
  while p < n {
    let c = s.code_unit_at(p)
    if c == 32 || c == 9 || c == 10 || c == 13 || c == 12 {
      p = p + 1
    } else {
      break
    }
  }
  self.pos = p
}

fn Cursor::scan_ident_end(self : Cursor) -> Int {
  let s = self.src
  let n = self.len
  let mut p = self.pos
  while p < n {
    let c = s.code_unit_at(p)
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 {
      p = p + 1
    } else {
      break
    }
  }
  self.pos = p
  p
}

fn slice_to_lower_string(src : String, start : Int, len : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    sb.write_char(ident_lower_char(src.code_unit_at(start + i)))
    i = i + 1
  }
  sb.to_string()
}

fn ident_lower_char(c : Int) -> Char {
  match to_ascii_lower(c) {
    45 => '-'
    95 => '_'
    48 => '0'
    49 => '1'
    50 => '2'
    51 => '3'
    52 => '4'
    53 => '5'
    54 => '6'
    55 => '7'
    56 => '8'
    57 => '9'
    97 => 'a'
    98 => 'b'
    99 => 'c'
    100 => 'd'
    101 => 'e'
    102 => 'f'
    103 => 'g'
    104 => 'h'
    105 => 'i'
    106 => 'j'
    107 => 'k'
    108 => 'l'
    109 => 'm'
    110 => 'n'
    111 => 'o'
    112 => 'p'
    113 => 'q'
    114 => 'r'
    115 => 's'
    116 => 't'
    117 => 'u'
    118 => 'v'
    119 => 'w'
    120 => 'x'
    121 => 'y'
    _ => 'z'
  }
}

fn Cursor::read_ident_lower(self : Cursor) -> String {
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) {
      sb.write_char(ident_lower_char(c))
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  sb.to_string()
}

fn Cursor::peek_keyword(self : Cursor, kw : String) -> Bool {
  let klen = kw.length()
  if self.pos + klen > self.len {
    return false
  }
  let mut i = 0
  while i < klen {
    if to_ascii_lower(self.src.code_unit_at(self.pos + i)) != kw.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  let next = self.peek_at(klen)
  next == -1 || !is_ident_char(next)
}

fn Cursor::expect_char(self : Cursor, ch : Int, label : String) -> Result[Unit, ColorError] {
  self.skip_ws()
  if self.peek() == ch {
    self.pos = self.pos + 1
    Ok(())
  } else {
    Err(ColorError::InvalidSyntax("expected " + label))
  }
}

// === Number & unit parsing ===

fn pow10_div(n : Int) -> Double {
  match n {
    1 => 10.0
    2 => 100.0
    3 => 1000.0
    4 => 10000.0
    5 => 100000.0
    6 => 1000000.0
    7 => 10000000.0
    8 => 100000000.0
    9 => 1000000000.0
    10 => 10000000000.0
    11 => 100000000000.0
    12 => 1000000000000.0
    13 => 10000000000000.0
    14 => 100000000000000.0
    _ => 1000000000000000.0
  }
}

fn parse_css_number_fast(cur : Cursor) -> Bool {
  let s = cur.src
  let n = cur.len
  let start = cur.pos
  let mut pos = start
  let mut neg = false
  if pos < n {
    let c0 = s.code_unit_at(pos)
    if c0 == 43 {
      pos = pos + 1
    } else if c0 == 45 {
      neg = true
      pos = pos + 1
    }
  }
  let mut int_i64 = 0L
  let mut int_f64 = 0.0
  let mut use_f64 = false
  let mut digits = 0
  while pos < n {
    let c = s.code_unit_at(pos)
    if c >= 48 && c <= 57 {
      let d = c - 48
      if !use_f64 {
        if digits < 15 {
          int_i64 = int_i64 * 10L + d.to_int64()
        } else {
          int_f64 = int_i64.to_double() * 10.0 + d.to_double()
          use_f64 = true
        }
      } else {
        int_f64 = int_f64 * 10.0 + d.to_double()
      }
      digits = digits + 1
      pos = pos + 1
    } else {
      break
    }
  }
  let mut frac_i64 = 0L
  let mut frac_digits = 0
  let mut frac_f64 = 0.0
  let mut frac_scale = 1.0
  let mut frac_use_f64 = false
  if pos + 1 < n && s.code_unit_at(pos) == 46 {
    let c1 = s.code_unit_at(pos + 1)
    if c1 >= 48 && c1 <= 57 {
      pos = pos + 1
      while pos < n {
        let c = s.code_unit_at(pos)
        if c >= 48 && c <= 57 {
          let d = c - 48
          if !frac_use_f64 {
            if frac_digits < 15 {
              frac_i64 = frac_i64 * 10L + d.to_int64()
            } else {
              frac_f64 = frac_i64.to_double() * 10.0 + d.to_double()
              frac_scale = pow10_div(15) * 10.0
              frac_use_f64 = true
            }
          } else {
            frac_f64 = frac_f64 * 10.0 + d.to_double()
            frac_scale = frac_scale * 10.0
          }
          frac_digits = frac_digits + 1
          pos = pos + 1
        } else {
          break
        }
      }
    }
  }
  if digits == 0 && frac_digits == 0 {
    cur.pos = start
    cur.err = ColorError::InvalidComponent("expected number")
    return false
  }
  let mut res_num = if !use_f64 && !frac_use_f64 {
    if frac_digits == 0 {
      int_i64.to_double()
    } else if digits + frac_digits <= 15 {
      let scale = pow10_div(frac_digits)
      (int_i64.to_double() * scale + frac_i64.to_double()) / scale
    } else {
      int_i64.to_double() + frac_i64.to_double() / pow10_div(frac_digits)
    }
  } else {
    let iv = if use_f64 { int_f64 } else { int_i64.to_double() }
    let fv = if frac_use_f64 {
      frac_f64 / frac_scale
    } else if frac_digits > 0 {
      frac_i64.to_double() / pow10_div(frac_digits)
    } else {
      0.0
    }
    iv + fv
  }
  if neg {
    res_num = -res_num
  }
  // Optional scientific notation exponent (e/E)
  if pos < n {
    let ce = s.code_unit_at(pos)
    if ce == 101 || ce == 69 {
      let saved = pos
      pos = pos + 1
      let mut exp_sign = 1
      if pos < n {
        let cs = s.code_unit_at(pos)
        if cs == 43 {
          pos = pos + 1
        } else if cs == 45 {
          exp_sign = -1
          pos = pos + 1
        }
      }
      let mut exp_val = 0
      let mut has_exp = false
      while pos < n {
        let c = s.code_unit_at(pos)
        if c >= 48 && c <= 57 {
          has_exp = true
          if exp_val < 10000 {
            exp_val = exp_val * 10 + (c - 48)
          }
          pos = pos + 1
        } else {
          break
        }
      }
      if !has_exp {
        pos = saved
      } else {
        let signed_exp = exp_sign * exp_val
        if signed_exp > 308 {
          res_num = if res_num == 0.0 { 0.0 } else if neg { -1.0 / 0.0 } else { 1.0 / 0.0 }
        } else if signed_exp < -324 {
          res_num = 0.0
        } else {
          res_num = res_num * f64_pow(10.0, signed_exp.to_double())
        }
      }
    }
  }
  cur.pos = pos
  cur.num_val = res_num
  true
}

fn parse_css_number(cur : Cursor) -> Result[Double, ColorError] {
  if parse_css_number_fast(cur) {
    Ok(cur.num_val)
  } else {
    Err(cur.err)
  }
}

fn resolve_nan_zero(v : Double) -> Double {
  if v != v {
    0.0
  } else {
    v
  }
}

// === Channel environment for CSS Color 5 relative color syntax & calc() ===

val struct CalcEnv {
  active : Bool
  k0 : String
  v0 : Double
  k1 : String
  v1 : Double
  k2 : String
  v2 : Double
  va : Double
  m0 : Bool
  m1 : Bool
  m2 : Bool
  ma : Bool
}

fn CalcEnv::empty() -> CalcEnv {
  CalcEnv::{
    active: false,
    k0: "",
    v0: 0.0,
    k1: "",
    v1: 0.0,
    k2: "",
    v2: 0.0,
    va: 1.0,
    m0: false,
    m1: false,
    m2: false,
    ma: false,
  }
}

fn CalcEnv::make(
  k0 : String,
  v0 : Double,
  k1 : String,
  v1 : Double,
  k2 : String,
  v2 : Double,
  va : Double,
) -> CalcEnv {
  CalcEnv::{
    active: true,
    k0: k0,
    v0: v0,
    k1: k1,
    v1: v1,
    k2: k2,
    v2: v2,
    va: va,
    m0: false,
    m1: false,
    m2: false,
    ma: false,
  }
}

fn CalcEnv::with_missing(self : CalcEnv, m0 : Bool, m1 : Bool, m2 : Bool, ma : Bool) -> CalcEnv {
  CalcEnv::{
    active: self.active,
    k0: self.k0,
    v0: self.v0,
    k1: self.k1,
    v1: self.v1,
    k2: self.k2,
    v2: self.v2,
    va: self.va,
    m0: m0,
    m1: m1,
    m2: m2,
    ma: ma,
  }
}

fn CalcEnv::lookup_missing(self : CalcEnv, name : String) -> Bool {
  if !self.active {
    false
  } else if name == self.k0 {
    self.m0
  } else if name == self.k1 {
    self.m1
  } else if name == self.k2 {
    self.m2
  } else if name == "alpha" {
    self.ma
  } else {
    false
  }
}

fn CalcEnv::lookup(self : CalcEnv, name : String) -> Option[Double] {
  if !self.active {
    return None
  }
  if name == self.k0 {
    Some(self.v0)
  } else if name == self.k1 {
    Some(self.v1)
  } else if name == self.k2 {
    Some(self.v2)
  } else if name == "alpha" {
    Some(self.va)
  } else {
    None
  }
}

// === Recursive-descent typed `calc(...)` expression evaluator (CSS Values 4) ===
// Type tags: 0 = Number, 1 = Percentage, 2 = Angle (degrees)

fn parse_calc_expr(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[(Double, Int), ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  let (left0, left_ty) = match parse_calc_term(cur, depth, env, pct_basis, allow_angle) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut left = left0
  while true {
    cur.skip_ws()
    let c = cur.peek()
    if c == 43 || c == 45 {
      // CSS Values 4 §10.6: '+' and '-' in calc() MUST be surrounded by whitespace.
      let had_ws = cur.pos > 0 && is_ascii_ws(cur.peek_at(-1))
      if !had_ws || !is_ascii_ws(cur.peek_at(1)) {
        return Err(ColorError::InvalidCalc("calc +/- requires surrounding whitespace"))
      }
      cur.pos = cur.pos + 1
      let (right, right_ty) = match parse_calc_term(cur, depth, env, pct_basis, allow_angle) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if left_ty != right_ty {
        return Err(ColorError::InvalidCalc("incompatible types in calc +/-"))
      }
      left = if c == 43 { left + right } else { left - right }
    } else {
      break
    }
  }
  Ok((left, left_ty))
}

fn parse_calc_term(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[(Double, Int), ColorError] {
  let (left0, left_ty0) = match parse_calc_factor(cur, depth, env, pct_basis, allow_angle) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut left = left0
  let mut left_ty = left_ty0
  while true {
    cur.skip_ws()
    let c = cur.peek()
    if c == 42 || c == 47 {
      cur.pos = cur.pos + 1
      let (right, right_ty) = match parse_calc_factor(cur, depth, env, pct_basis, allow_angle) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if c == 42 {
        if left_ty == 0 {
          left_ty = right_ty
        } else if right_ty != 0 {
          return Err(ColorError::InvalidCalc("cannot multiply two typed values in calc"))
        }
        left = left * right
      } else {
        if right_ty != 0 {
          return Err(ColorError::InvalidCalc("divisor in calc must be a number"))
        }
        left = left / right
      }
    } else {
      break
    }
  }
  Ok((left, left_ty))
}

fn parse_calc_factor(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_angle : Bool,
) -> Result[(Double, Int), ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  cur.skip_ws()
  let c = cur.peek()
  if c == 40 {
    // '('
    cur.pos = cur.pos + 1
    let v = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
      Ok(calc_v) => calc_v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => Ok(v)
      Err(e) => Err(e)
    }
  } else if c == 45 && is_ascii_alpha(cur.peek_at(1)) {
    // CSS Values 4: only `-infinity` is a valid leading-dash keyword in calc(); `-r` is invalid.
    let name = cur.read_ident_lower()
    if name == "-infinity" {
      Ok((-1.0 / 0.0, 0))
    } else {
      Err(ColorError::InvalidCalc("unknown identifier in calc: " + name))
    }
  } else if is_ascii_alpha(c) {
    let name = cur.read_ident_lower()
    if name == "calc" && cur.peek() == 40 {
      cur.pos = cur.pos + 1
      let v = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
        Ok(calc_v) => calc_v
        Err(e) => return Err(e)
      }
      match cur.expect_char(41, "')'") {
        Ok(_) => Ok(v)
        Err(e) => Err(e)
      }
    } else if name == "pi" {
      Ok((pi, 0))
    } else if name == "e" {
      Ok((2.71828182845904523536, 0))
    } else if name == "infinity" {
      Ok((1.0 / 0.0, 0))
    } else if name == "nan" {
      Ok((0.0 / 0.0, 0))
    } else {
      match env.lookup(name) {
        Some(v) => Ok((v, 0))
        None => Err(ColorError::InvalidCalc("unknown identifier in calc: " + name))
      }
    }
  } else {
    let num = match parse_css_number(cur) {
      Ok(v) => v
      Err(_) => return Err(ColorError::InvalidCalc("expected operand in calc"))
    }
    if cur.peek() == 37 {
      // '%'
      cur.pos = cur.pos + 1
      Ok((num * pct_basis / 100.0, 1))
    } else if is_ascii_alpha(cur.peek()) {
      let unit = cur.read_ident_lower()
      if allow_angle {
        match convert_angle_unit(num, unit) {
          Ok(deg) => Ok((deg, 2))
          Err(e) => Err(e)
        }
      } else {
        Err(ColorError::InvalidCalc("unexpected unit in calc: " + unit))
      }
    } else {
      Ok((num, 0))
    }
  }
}

fn convert_angle_unit(ang : Double, unit : String) -> Result[Double, ColorError] {
  match unit {
    "deg" => Ok(ang)
    "grad" => Ok(ang * 0.9)
    "rad" => Ok(rad_to_deg(ang))
    "turn" => Ok(ang * 360.0)
    _ => Err(ColorError::InvalidComponent("unknown angle unit: " + unit))
  }
}

fn convert_angle_unit_slice(src : String, start : Int, len : Int, ang : Double, cur : Cursor) -> Bool {
  let c0 = to_ascii_lower(src.code_unit_at(start))
  if len == 3 {
    if c0 == 100 && eq_ascii_lower(src, start, "deg") {
      cur.num_val = ang
      return true
    } else if c0 == 114 && eq_ascii_lower(src, start, "rad") {
      cur.num_val = rad_to_deg(ang)
      return true
    }
  } else if len == 4 {
    if c0 == 103 && eq_ascii_lower(src, start, "grad") {
      cur.num_val = ang * 0.9
      return true
    } else if c0 == 116 && eq_ascii_lower(src, start, "turn") {
      cur.num_val = ang * 360.0
      return true
    }
  }
  cur.err = ColorError::InvalidComponent("unknown angle unit: " + slice_to_lower_string(src, start, len))
  false
}

// === Component parsers ===
// Zero-allocation fast path: stores result in cur.num_val / cur.comp_missing / cur.comp_pct, returns Bool.

fn parse_component_plain(
  cur : Cursor,
  depth : Int,
  pct_basis : Double,
  allow_none : Bool,
  allow_angle : Bool,
  allow_percent : Bool,
) -> Bool {
  cur.skip_ws()
  let c = cur.peek()
  // Ultra-hot fast path: starts with digit, '-', '+', or '.'
  if (c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46 {
    if !parse_css_number_fast(cur) {
      return false
    }
    let next = cur.peek()
    if next == 37 {
      if !allow_percent {
        cur.err = ColorError::InvalidComponent("percentage not allowed here")
        return false
      }
      cur.pos = cur.pos + 1
      cur.num_val = cur.num_val * pct_basis / 100.0
      cur.comp_missing = false
      cur.comp_pct = true
      return true
    }
    if (next >= 97 && next <= 122) || (next >= 65 && next <= 90) {
      if allow_angle {
        let ustart = cur.pos
        let uend = cur.scan_ident_end()
        if !convert_angle_unit_slice(cur.src, ustart, uend - ustart, cur.num_val, cur) {
          return false
        }
        cur.comp_missing = false
        cur.comp_pct = false
        return true
      } else {
        cur.err = ColorError::InvalidComponent("unexpected unit")
        return false
      }
    }
    cur.comp_missing = false
    cur.comp_pct = false
    return true
  }
  if allow_none && (c == 110 || c == 78) && cur.peek_keyword("none") {
    cur.pos = cur.pos + 4
    cur.num_val = 0.0
    cur.comp_missing = true
    cur.comp_pct = false
    return true
  }
  if (c == 99 || c == 67) && cur.peek_keyword("calc") && cur.peek_at(4) == 40 {
    cur.pos = cur.pos + 5
    let (v, ty) = match parse_calc_expr(cur, depth + 1, CalcEnv::empty(), pct_basis, allow_angle) {
      Ok(calc_v) => calc_v
      Err(e) => {
        cur.err = e
        return false
      }
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => {
        cur.err = e
        return false
      }
    }
    if ty == 1 && !allow_percent {
      cur.err = ColorError::InvalidComponent("percentage not allowed here")
      return false
    }
    if ty == 2 && !allow_angle {
      cur.err = ColorError::InvalidComponent("angle not allowed here")
      return false
    }
    cur.num_val = resolve_nan_zero(v)
    cur.comp_missing = false
    cur.comp_pct = ty == 1
    return true
  }
  cur.err = ColorError::InvalidComponent("expected number")
  false
}

fn parse_component(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  pct_basis : Double,
  allow_none : Bool,
  allow_angle : Bool,
  allow_percent : Bool,
) -> Result[(Double, Bool, Bool), ColorError] {
  if !env.active {
    if parse_component_plain(cur, depth, pct_basis, allow_none, allow_angle, allow_percent) {
      return Ok((cur.num_val, cur.comp_missing, cur.comp_pct))
    } else {
      return Err(cur.err)
    }
  }
  cur.skip_ws()
  if allow_none && cur.peek_keyword("none") {
    cur.pos = cur.pos + 4
    return Ok((0.0, true, false))
  }
  if cur.peek_keyword("calc") && cur.peek_at(4) == 40 {
    cur.pos = cur.pos + 5
    let (v, ty) = match parse_calc_expr(cur, depth + 1, env, pct_basis, allow_angle) {
      Ok(calc_v) => calc_v
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if ty == 1 && !allow_percent {
      return Err(ColorError::InvalidComponent("percentage not allowed here"))
    }
    if ty == 2 && !allow_angle {
      return Err(ColorError::InvalidComponent("angle not allowed here"))
    }
    return Ok((resolve_nan_zero(v), false, ty == 1))
  }
  if is_ascii_alpha(cur.peek()) {
    let saved = cur.pos
    let ident = cur.read_ident_lower()
    match env.lookup(ident) {
      Some(v) => return Ok((v, env.lookup_missing(ident), false))
      None => {
        cur.pos = saved
        return Err(ColorError::InvalidComponent("unknown channel identifier: " + ident))
      }
    }
  }
  if !parse_css_number_fast(cur) {
    return Err(cur.err)
  }
  let num = cur.num_val
  if cur.peek() == 37 {
    if !allow_percent {
      return Err(ColorError::InvalidComponent("percentage not allowed here"))
    }
    cur.pos = cur.pos + 1
    return Ok((num * pct_basis / 100.0, false, true))
  }
  if is_ascii_alpha(cur.peek()) {
    if allow_angle {
      let ustart = cur.pos
      let uend = cur.scan_ident_end()
      if convert_angle_unit_slice(cur.src, ustart, uend - ustart, num, cur) {
        return Ok((cur.num_val, false, false))
      } else {
        return Err(cur.err)
      }
    } else {
      return Err(ColorError::InvalidComponent("unexpected unit"))
    }
  }
  Ok((num, false, false))
}

fn parse_optional_modern_alpha_plain(cur : Cursor, depth : Int) -> Bool {
  cur.skip_ws()
  if cur.peek() == 47 {
    cur.pos = cur.pos + 1
    if !parse_component_plain(cur, depth, 1.0, true, false, true) {
      cur.err = ColorError::InvalidAlpha("invalid alpha component")
      return false
    }
    cur.num_val = f64_clamp01(cur.num_val)
    true
  } else {
    cur.num_val = 1.0
    cur.comp_missing = false
    true
  }
}

fn parse_optional_modern_alpha(
  cur : Cursor,
  depth : Int,
  env : CalcEnv,
  default_alpha : Double,
  default_ma : Bool,
) -> Result[(Double, Bool), ColorError] {
  cur.skip_ws()
  if cur.peek() == 47 {
    // '/'
    cur.pos = cur.pos + 1
    let (v, missing, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(res) => res
      Err(_) => return Err(ColorError::InvalidAlpha("invalid alpha component"))
    }
    Ok((f64_clamp01(v), missing))
  } else {
    Ok((default_alpha, default_ma))
  }
}

// === Hex color ===

fn parse_hex_slice(s : String, start_hash : Int, n : Int) -> Result[(Color, Int), ColorError] {
  let start = start_hash + 1
  let mut pos = start
  let mut v = 0L
  while pos < n {
    let hv = hex_val(s.code_unit_at(pos))
    if hv >= 0 {
      if pos - start < 8 {
        v = (v << 4) | hv.to_int64()
      }
      pos = pos + 1
    } else {
      break
    }
  }
  if pos < n && is_ident_char(s.code_unit_at(pos)) {
    return Err(ColorError::InvalidSyntax("invalid character in hex color"))
  }
  let len = pos - start
  if len == 6 {
    let r = ((v >> 16) & 0xFFL).to_int()
    let g = ((v >> 8) & 0xFFL).to_int()
    let b = (v & 0xFFL).to_int()
    Ok((Color::rgba8(r, g, b, 255), pos))
  } else if len == 3 {
    let r = ((v >> 8) & 0xFL).to_int() * 17
    let g = ((v >> 4) & 0xFL).to_int() * 17
    let b = (v & 0xFL).to_int() * 17
    Ok((Color::rgba8(r, g, b, 255), pos))
  } else if len == 8 {
    let r = ((v >> 24) & 0xFFL).to_int()
    let g = ((v >> 16) & 0xFFL).to_int()
    let b = ((v >> 8) & 0xFFL).to_int()
    let a = (v & 0xFFL).to_int()
    Ok((Color::rgba8(r, g, b, a), pos))
  } else if len == 4 {
    let r = ((v >> 12) & 0xFL).to_int() * 17
    let g = ((v >> 8) & 0xFL).to_int() * 17
    let b = ((v >> 4) & 0xFL).to_int() * 17
    let a = (v & 0xFL).to_int() * 17
    Ok((Color::rgba8(r, g, b, a), pos))
  } else {
    Err(ColorError::InvalidSyntax("invalid hex color length"))
  }
}

fn parse_hex(cur : Cursor) -> Result[Color, ColorError] {
  match parse_hex_slice(cur.src, cur.pos, cur.len) {
    Ok((col, end_pos)) => {
      cur.pos = end_pos
      Ok(col)
    }
    Err(e) => Err(e)
  }
}

// === Helper for relative color `from <origin>` ===

fn has_from_keyword(cur : Cursor) -> Bool {
  cur.skip_ws()
  let c = cur.peek()
  (c == 102 || c == 70) && cur.peek_keyword("from")
}

fn parse_from_origin(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  cur.pos = cur.pos + 4
  cur.skip_ws()
  parse_color_expr(cur, depth + 1)
}

fn expect_rparen(cur : Cursor) -> Bool {
  cur.skip_ws()
  if cur.peek() == 41 {
    cur.pos = cur.pos + 1
    true
  } else {
    cur.err = ColorError::InvalidSyntax("expected ')'")
    false
  }
}

fn expect_comma(cur : Cursor) -> Bool {
  cur.skip_ws()
  if cur.peek() == 44 {
    cur.pos = cur.pos + 1
    true
  } else {
    cur.err = ColorError::InvalidSyntax("expected ','")
    false
  }
}

// === rgb() / rgba() ===

fn parse_rgb(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let s = orig.convert(ColorSpace::Srgb)
    let env = CalcEnv::make("r", s.c0 * 255.0, "g", s.c1 * 255.0, "b", s.c2 * 255.0, s.alpha).with_missing(
      s.m0,
      s.m1,
      s.m2,
      s.ma,
    )
    let (r, m0, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (g, m1, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (b, m2, _) = match parse_component(cur, depth, env, 255.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, s.alpha, s.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(ColorSpace::Srgb, r / 255.0, g / 255.0, b / 255.0, a, m0, m1, m2, ma))
  }
  if !parse_component_plain(cur, depth, 255.0, true, false, true) {
    return Err(cur.err)
  }
  let r = cur.num_val
  let m0 = cur.comp_missing
  let p0 = cur.comp_pct
  cur.skip_ws()
  if cur.peek() == 44 {
    if m0 {
      return Err(ColorError::InvalidSyntax("'none' is not allowed in legacy comma rgb()"))
    }
    cur.pos = cur.pos + 1
    if !parse_component_plain(cur, depth, 255.0, false, false, true) {
      return Err(cur.err)
    }
    let g = cur.num_val
    let p1 = cur.comp_pct
    if !expect_comma(cur) {
      return Err(cur.err)
    }
    if !parse_component_plain(cur, depth, 255.0, false, false, true) {
      return Err(cur.err)
    }
    let b = cur.num_val
    let p2 = cur.comp_pct
    if p0 != p1 || p1 != p2 {
      return Err(ColorError::InvalidSyntax("legacy rgb() cannot mix numbers and percentages"))
    }
    cur.skip_ws()
    let mut alpha = 1.0
    if cur.peek() == 44 {
      cur.pos = cur.pos + 1
      if !parse_component_plain(cur, depth, 1.0, false, false, true) {
        return Err(ColorError::InvalidAlpha("invalid legacy rgb() alpha"))
      }
      alpha = f64_clamp01(cur.num_val)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    Ok(
      Color::{
        space: ColorSpace::Srgb,
        c0: f64_clamp01(r / 255.0),
        c1: f64_clamp01(g / 255.0),
        c2: f64_clamp01(b / 255.0),
        alpha: alpha,
        m0: false,
        m1: false,
        m2: false,
        ma: false,
      },
    )
  } else {
    if !parse_component_plain(cur, depth, 255.0, true, false, true) {
      return Err(cur.err)
    }
    let g = cur.num_val
    let m1 = cur.comp_missing
    if !parse_component_plain(cur, depth, 255.0, true, false, true) {
      return Err(cur.err)
    }
    let b = cur.num_val
    let m2 = cur.comp_missing
    if !parse_optional_modern_alpha_plain(cur, depth) {
      return Err(cur.err)
    }
    let a = cur.num_val
    let ma = cur.comp_missing
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Srgb,
        f64_clamp01(r / 255.0),
        f64_clamp01(g / 255.0),
        f64_clamp01(b / 255.0),
        a,
        m0,
        m1,
        m2,
        ma,
      ),
    )
  }
}

// === hsl() / hsla() ===

fn parse_hsl(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let h_col = orig.convert(ColorSpace::Hsl)
    let env = CalcEnv::make("h", h_col.c0, "s", h_col.c1, "l", h_col.c2, h_col.alpha).with_missing(
      h_col.m0,
      h_col.m1,
      h_col.m2,
      h_col.ma,
    )
    let (h, m0, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (s, m1, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (l, m2, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, h_col.alpha, h_col.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(ColorSpace::Hsl, f64_normalize_hue(h), s, l, a, m0, m1, m2, ma))
  }
  if !parse_component_plain(cur, depth, 360.0, true, true, false) {
    return Err(cur.err)
  }
  let h = cur.num_val
  let m0 = cur.comp_missing
  cur.skip_ws()
  if cur.peek() == 44 {
    if m0 {
      return Err(ColorError::InvalidSyntax("'none' is not allowed in legacy comma hsl()"))
    }
    cur.pos = cur.pos + 1
    if !parse_component_plain(cur, depth, 100.0, false, false, true) {
      return Err(cur.err)
    }
    let s = cur.num_val
    if !cur.comp_pct {
      return Err(ColorError::InvalidSyntax("legacy hsl() saturation must be a percentage"))
    }
    if !expect_comma(cur) {
      return Err(cur.err)
    }
    if !parse_component_plain(cur, depth, 100.0, false, false, true) {
      return Err(cur.err)
    }
    let l = cur.num_val
    if !cur.comp_pct {
      return Err(ColorError::InvalidSyntax("legacy hsl() lightness must be a percentage"))
    }
    cur.skip_ws()
    let mut alpha = 1.0
    if cur.peek() == 44 {
      cur.pos = cur.pos + 1
      if !parse_component_plain(cur, depth, 1.0, false, false, true) {
        return Err(ColorError::InvalidAlpha("invalid legacy hsl() alpha"))
      }
      alpha = f64_clamp01(cur.num_val)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    Ok(
      Color::{
        space: ColorSpace::Hsl,
        c0: f64_normalize_hue(h),
        c1: f64_max(0.0, s),
        c2: f64_clamp(l, 0.0, 100.0),
        alpha: alpha,
        m0: false,
        m1: false,
        m2: false,
        ma: false,
      },
    )
  } else {
    if !parse_component_plain(cur, depth, 100.0, true, false, true) {
      return Err(cur.err)
    }
    let s = cur.num_val
    let m1 = cur.comp_missing
    if !parse_component_plain(cur, depth, 100.0, true, false, true) {
      return Err(cur.err)
    }
    let l = cur.num_val
    let m2 = cur.comp_missing
    if !parse_optional_modern_alpha_plain(cur, depth) {
      return Err(cur.err)
    }
    let a = cur.num_val
    let ma = cur.comp_missing
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    Ok(
      Color::new_with_missing(
        ColorSpace::Hsl,
        f64_normalize_hue(h),
        f64_max(0.0, s),
        l,
        a,
        m0,
        m1,
        m2,
        ma,
      ),
    )
  }
}

// === hwb() ===

fn parse_hwb(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let c = orig.convert(ColorSpace::Hwb)
    let env = CalcEnv::make("h", c.c0, "w", c.c1, "b", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    let (h, m0, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (w, m1, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (b, m2, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(ColorSpace::Hwb, f64_normalize_hue(h), w, b, a, m0, m1, m2, ma))
  }
  if !parse_component_plain(cur, depth, 360.0, true, true, false) {
    return Err(cur.err)
  }
  let h = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 100.0, true, false, true) {
    return Err(cur.err)
  }
  let w = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 100.0, true, false, true) {
    return Err(cur.err)
  }
  let b = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let a = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(Color::new_with_missing(ColorSpace::Hwb, f64_normalize_hue(h), w, b, a, m0, m1, m2, ma))
}

// === lab() / lch() / oklab() / oklch() ===

fn parse_lab(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let c = orig.convert(ColorSpace::Lab)
    let env = CalcEnv::make("l", c.c0, "a", c.c1, "b", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    let (l, m0, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, m1, _) = match parse_component(cur, depth, env, 125.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (b, m2, _) = match parse_component(cur, depth, env, 125.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(ColorSpace::Lab, f64_clamp(l, 0.0, 100.0), a, b, alpha, m0, m1, m2, ma))
  }
  if !parse_component_plain(cur, depth, 100.0, true, false, true) {
    return Err(cur.err)
  }
  let l = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 125.0, true, false, true) {
    return Err(cur.err)
  }
  let a = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 125.0, true, false, true) {
    return Err(cur.err)
  }
  let b = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let alpha = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(Color::new_with_missing(ColorSpace::Lab, f64_clamp(l, 0.0, 100.0), a, b, alpha, m0, m1, m2, ma))
}

fn parse_lch(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let c = orig.convert(ColorSpace::Lch)
    let env = CalcEnv::make("l", c.c0, "c", c.c1, "h", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    let (l, m0, _) = match parse_component(cur, depth, env, 100.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (ch, m1, _) = match parse_component(cur, depth, env, 150.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (h, m2, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(
      Color::new_with_missing(ColorSpace::Lch, f64_clamp(l, 0.0, 100.0), f64_max(0.0, ch), f64_normalize_hue(h), alpha, m0, m1, m2, ma),
    )
  }
  if !parse_component_plain(cur, depth, 100.0, true, false, true) {
    return Err(cur.err)
  }
  let l = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 150.0, true, false, true) {
    return Err(cur.err)
  }
  let ch = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 360.0, true, true, false) {
    return Err(cur.err)
  }
  let h = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let alpha = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(
    Color::new_with_missing(
      ColorSpace::Lch,
      f64_clamp(l, 0.0, 100.0),
      f64_max(0.0, ch),
      f64_normalize_hue(h),
      alpha,
      m0,
      m1,
      m2,
      ma,
    ),
  )
}

fn parse_oklab(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let c = orig.convert(ColorSpace::Oklab)
    let env = CalcEnv::make("l", c.c0, "a", c.c1, "b", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    let (l, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (a, m1, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (b, m2, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(ColorSpace::Oklab, f64_clamp01(l), a, b, alpha, m0, m1, m2, ma))
  }
  if !parse_component_plain(cur, depth, 1.0, true, false, true) {
    return Err(cur.err)
  }
  let l = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 0.4, true, false, true) {
    return Err(cur.err)
  }
  let a = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 0.4, true, false, true) {
    return Err(cur.err)
  }
  let b = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let alpha = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(Color::new_with_missing(ColorSpace::Oklab, f64_clamp01(l), a, b, alpha, m0, m1, m2, ma))
}

fn parse_oklch(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let c = orig.convert(ColorSpace::Oklch)
    let env = CalcEnv::make("l", c.c0, "c", c.c1, "h", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    let (l, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (ch, m1, _) = match parse_component(cur, depth, env, 0.4, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (h, m2, _) = match parse_component(cur, depth, env, 360.0, true, true, false) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(
      Color::new_with_missing(
        ColorSpace::Oklch,
        f64_clamp01(l),
        f64_max(0.0, ch),
        f64_normalize_hue(h),
        alpha,
        m0,
        m1,
        m2,
        ma,
      ),
    )
  }
  if !parse_component_plain(cur, depth, 1.0, true, false, true) {
    return Err(cur.err)
  }
  let l = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 0.4, true, false, true) {
    return Err(cur.err)
  }
  let ch = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 360.0, true, true, false) {
    return Err(cur.err)
  }
  let h = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let alpha = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(
    Color::new_with_missing(
      ColorSpace::Oklch,
      f64_clamp01(l),
      f64_max(0.0, ch),
      f64_normalize_hue(h),
      alpha,
      m0,
      m1,
      m2,
      ma,
    ),
  )
}

// === color() function ===

fn parse_predefined_color_space_slice(src : String, start : Int, len : Int) -> Result[ColorSpace, ColorError] {
  if len >= 3 {
    let c0 = to_ascii_lower(src.code_unit_at(start))
    match len {
      3 => if c0 == 120 && eq_ascii_lower(src, start, "xyz") { return Ok(ColorSpace::XyzD65) }
      4 => if c0 == 115 && eq_ascii_lower(src, start, "srgb") { return Ok(ColorSpace::Srgb) }
      7 => {
        if c0 == 97 && eq_ascii_lower(src, start, "a98-rgb") {
          return Ok(ColorSpace::A98Rgb)
        } else if c0 == 114 && eq_ascii_lower(src, start, "rec2020") {
          return Ok(ColorSpace::Rec2020)
        } else if c0 == 120 {
          if eq_ascii_lower(src, start, "xyz-d65") {
            return Ok(ColorSpace::XyzD65)
          } else if eq_ascii_lower(src, start, "xyz-d50") {
            return Ok(ColorSpace::XyzD50)
          }
        }
      }
      10 => if c0 == 100 && eq_ascii_lower(src, start, "display-p3") { return Ok(ColorSpace::DisplayP3) }
      11 => if c0 == 115 && eq_ascii_lower(src, start, "srgb-linear") { return Ok(ColorSpace::SrgbLinear) }
      12 => if c0 == 112 && eq_ascii_lower(src, start, "prophoto-rgb") { return Ok(ColorSpace::ProphotoRgb) }
      17 => if c0 == 100 && eq_ascii_lower(src, start, "display-p3-linear") { return Ok(ColorSpace::DisplayP3Linear) }
      _ => ()
    }
  }
  Err(ColorError::UnknownColorSpace(slice_to_lower_string(src, start, len)))
}

fn parse_color_fn(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if has_from_keyword(cur) {
    let orig = match parse_from_origin(cur, depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    let sstart = cur.pos
    let send = cur.scan_ident_end()
    let space = match parse_predefined_color_space_slice(cur.src, sstart, send - sstart) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let c = orig.convert(space)
    let env = match space {
      ColorSpace::XyzD50 | ColorSpace::XyzD65 =>
      CalcEnv::make("x", c.c0, "y", c.c1, "z", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
      _ => CalcEnv::make("r", c.c0, "g", c.c1, "b", c.c2, c.alpha).with_missing(c.m0, c.m1, c.m2, c.ma)
    }
    let (c0, m0, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (c1, m1, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (c2, m2, _) = match parse_component(cur, depth, env, 1.0, true, false, true) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (alpha, ma) = match parse_optional_modern_alpha(cur, depth, env, c.alpha, c.ma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !expect_rparen(cur) {
      return Err(cur.err)
    }
    return Ok(Color::new_with_missing(space, c0, c1, c2, alpha, m0, m1, m2, ma))
  }
  cur.skip_ws()
  let sstart = cur.pos
  let send = cur.scan_ident_end()
  let space = match parse_predefined_color_space_slice(cur.src, sstart, send - sstart) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !parse_component_plain(cur, depth, 1.0, true, false, true) {
    return Err(cur.err)
  }
  let c0 = cur.num_val
  let m0 = cur.comp_missing
  if !parse_component_plain(cur, depth, 1.0, true, false, true) {
    return Err(cur.err)
  }
  let c1 = cur.num_val
  let m1 = cur.comp_missing
  if !parse_component_plain(cur, depth, 1.0, true, false, true) {
    return Err(cur.err)
  }
  let c2 = cur.num_val
  let m2 = cur.comp_missing
  if !parse_optional_modern_alpha_plain(cur, depth) {
    return Err(cur.err)
  }
  let alpha = cur.num_val
  let ma = cur.comp_missing
  if !expect_rparen(cur) {
    return Err(cur.err)
  }
  Ok(Color::new_with_missing(space, c0, c1, c2, alpha, m0, m1, m2, ma))
}

// === color-mix() ===

fn parse_interpolation_space(name : String) -> Result[ColorSpace, ColorError] {
  match name {
    "srgb" => Ok(ColorSpace::Srgb)
    "srgb-linear" => Ok(ColorSpace::SrgbLinear)
    "display-p3" => Ok(ColorSpace::DisplayP3)
    "display-p3-linear" => Ok(ColorSpace::DisplayP3Linear)
    "a98-rgb" => Ok(ColorSpace::A98Rgb)
    "prophoto-rgb" => Ok(ColorSpace::ProphotoRgb)
    "rec2020" => Ok(ColorSpace::Rec2020)
    "xyz" | "xyz-d65" => Ok(ColorSpace::XyzD65)
    "xyz-d50" => Ok(ColorSpace::XyzD50)
    "lab" => Ok(ColorSpace::Lab)
    "oklab" => Ok(ColorSpace::Oklab)
    "hsl" => Ok(ColorSpace::Hsl)
    "hwb" => Ok(ColorSpace::Hwb)
    "lch" => Ok(ColorSpace::Lch)
    "oklch" => Ok(ColorSpace::Oklch)
    _ => Err(ColorError::UnknownColorSpace(name))
  }
}

fn parse_mix_percent(cur : Cursor, depth : Int) -> Result[Double, ColorError] {
  cur.skip_ws()
  if cur.peek_keyword("calc") && cur.peek_at(4) == 40 {
    cur.pos = cur.pos + 5
    let (v, ty) = match parse_calc_expr(cur, depth + 1, CalcEnv::empty(), 100.0, false) {
      Ok(res) => res
      Err(e) => return Err(e)
    }
    match cur.expect_char(41, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if ty != 1 {
      return Err(ColorError::InvalidPercentage("calc() in color-mix must resolve to percentage"))
    }
    return Ok(f64_clamp(resolve_nan_zero(v), 0.0, 100.0))
  }
  let v = match parse_css_number(cur) {
    Ok(num) => num
    Err(_) => return Err(ColorError::InvalidPercentage("expected percentage in color-mix"))
  }
  if cur.peek() != 37 {
    return Err(ColorError::InvalidPercentage("missing '%' in color-mix"))
  }
  cur.pos = cur.pos + 1
  Ok(v)
}

fn starts_with_mix_percent(cur : Cursor) -> Bool {
  let c = cur.peek()
  is_ascii_digit(c) ||
  c == 46 ||
  ((c == 43 || c == 45) && (is_ascii_digit(cur.peek_at(1)) || cur.peek_at(1) == 46)) ||
  (cur.peek_keyword("calc") && cur.peek_at(4) == 40)
}

fn parse_mix_item(cur : Cursor, depth : Int) -> Result[(Color, Option[Double]), ColorError] {
  cur.skip_ws()
  if starts_with_mix_percent(cur) {
    let pct = match parse_mix_percent(cur, depth) {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    let col = match parse_color_expr(cur, depth + 1) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    Ok((col, Some(pct)))
  } else {
    let col = match parse_color_expr(cur, depth + 1) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    if starts_with_mix_percent(cur) {
      let pct = match parse_mix_percent(cur, depth) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      Ok((col, Some(pct)))
    } else {
      Ok((col, None))
    }
  }
}

fn parse_color_mix(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  cur.skip_ws()
  let mut space = ColorSpace::Oklab
  let mut hue_mode = HueInterpolation::Shorter
  if cur.peek_keyword("in") {
    cur.pos = cur.pos + 2
    cur.skip_ws()
    let space_name = cur.read_ident_lower()
    space = match parse_interpolation_space(space_name) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    cur.skip_ws()
    if cur.peek() != 44 {
      if !space.is_polar() {
        return Err(ColorError::InvalidSyntax("hue interpolation method only allowed for polar color spaces"))
      }
      let kw = cur.read_ident_lower()
      hue_mode = match kw {
        "shorter" => HueInterpolation::Shorter
        "longer" => HueInterpolation::Longer
        "increasing" => HueInterpolation::Increasing
        "decreasing" => HueInterpolation::Decreasing
        _ => return Err(ColorError::InvalidSyntax("unknown hue interpolation method: " + kw))
      }
      cur.skip_ws()
      let hue_kw = cur.read_ident_lower()
      if hue_kw != "hue" {
        return Err(ColorError::InvalidSyntax("expected 'hue' after hue interpolation method"))
      }
    }
    match cur.expect_char(44, "','") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let colors : Array[Color] = []
  let pcts : Array[Option[Double]] = []
  let (c0, p0) = match parse_mix_item(cur, depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  colors.push(c0)
  pcts.push(p0)
  while true {
    cur.skip_ws()
    if cur.peek() == 44 {
      if colors.length() >= 64 {
        return Err(ColorError::InvalidSyntax("too many color-mix items"))
      }
      cur.pos = cur.pos + 1
      let (ci, pi_opt) = match parse_mix_item(cur, depth) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      colors.push(ci)
      pcts.push(pi_opt)
    } else {
      break
    }
  }
  match cur.expect_char(41, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  mix_many_colors_internal(colors, pcts, space, hue_mode)
}

// === Top-level expression dispatcher ===

fn dispatch_color_fn(cur : Cursor, start : Int, len : Int, depth : Int) -> Result[Color, ColorError] {
  let c0 = to_ascii_lower(cur.src.code_unit_at(start))
  match len {
    3 => {
      if c0 == 114 && eq_ascii_lower(cur.src, start, "rgb") {
        return parse_rgb(cur, depth)
      } else if c0 == 104 {
        if eq_ascii_lower(cur.src, start, "hsl") {
          return parse_hsl(cur, depth)
        } else if eq_ascii_lower(cur.src, start, "hwb") {
          return parse_hwb(cur, depth)
        }
      } else if c0 == 108 {
        if eq_ascii_lower(cur.src, start, "lab") {
          return parse_lab(cur, depth)
        } else if eq_ascii_lower(cur.src, start, "lch") {
          return parse_lch(cur, depth)
        }
      }
    }
    4 => {
      if c0 == 114 && eq_ascii_lower(cur.src, start, "rgba") {
        return parse_rgb(cur, depth)
      } else if c0 == 104 && eq_ascii_lower(cur.src, start, "hsla") {
        return parse_hsl(cur, depth)
      }
    }
    5 => {
      if c0 == 99 && eq_ascii_lower(cur.src, start, "color") {
        return parse_color_fn(cur, depth)
      } else if c0 == 111 {
        if eq_ascii_lower(cur.src, start, "oklab") {
          return parse_oklab(cur, depth)
        } else if eq_ascii_lower(cur.src, start, "oklch") {
          return parse_oklch(cur, depth)
        }
      }
    }
    9 => {
      if c0 == 99 && eq_ascii_lower(cur.src, start, "color-mix") {
        return parse_color_mix(cur, depth)
      }
    }
    _ => ()
  }
  Err(ColorError::InvalidSyntax("unknown color function: " + slice_to_lower_string(cur.src, start, len)))
}

fn color_from_packed_rgba8(packed : Int64) -> Color {
  let r = ((packed >> 24) & 0xFFL).to_int()
  let g = ((packed >> 16) & 0xFFL).to_int()
  let b = ((packed >> 8) & 0xFFL).to_int()
  let a = (packed & 0xFFL).to_int()
  Color::rgba8(r, g, b, a)
}

fn parse_color_expr(cur : Cursor, depth : Int) -> Result[Color, ColorError] {
  if depth > max_nesting_depth {
    return Err(ColorError::MaxDepthExceeded(depth))
  }
  cur.skip_ws()
  if cur.eof() {
    return Err(ColorError::EmptyInput)
  }
  let c = cur.peek()
  if c == 35 {
    // '#'
    return parse_hex(cur)
  }
  if is_ascii_alpha(c) {
    let start = cur.pos
    let end = cur.scan_ident_end()
    let len = end - start
    if cur.peek() == 40 {
      // '('
      cur.pos = cur.pos + 1
      dispatch_color_fn(cur, start, len, depth)
    } else {
      let packed = lookup_named_color_packed(cur.src, start, len)
      if packed >= 0L {
        Ok(color_from_packed_rgba8(packed))
      } else {
        Err(ColorError::UnknownColor(slice_to_lower_string(cur.src, start, len)))
      }
    }
  } else {
    Err(ColorError::InvalidSyntax("unexpected character in color"))
  }
}

///| Parse any W3C CSS Color Module Level 4 & 5 color string.
pub fn parse(input : String) -> Result[Color, ColorError] {
  let n = input.length()
  if n > max_input_length {
    return Err(ColorError::InputTooLong(n))
  }
  let mut pos = 0
  while pos < n {
    let ch = input.code_unit_at(pos)
    if ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 12 {
      pos = pos + 1
    } else {
      break
    }
  }
  if pos >= n {
    return Err(ColorError::EmptyInput)
  }
  let c0 = input.code_unit_at(pos)
  // Zero-Cursor fast path for #hex
  if c0 == 35 {
    let (col, end_pos) = match parse_hex_slice(input, pos, n) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let mut p = end_pos
    while p < n {
      let ch = input.code_unit_at(p)
      if ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 12 {
        p = p + 1
      } else {
        return Err(ColorError::InvalidSyntax("unexpected trailing characters"))
      }
    }
    return Ok(col)
  }
  // Zero-Cursor fast path for named colors (and pre-scanned ident for functions)
  if (c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90) {
    let start = pos
    pos = pos + 1
    while pos < n {
      let ch = input.code_unit_at(pos)
      if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 95 {
        pos = pos + 1
      } else {
        break
      }
    }
    let len = pos - start
    if pos < n && input.code_unit_at(pos) == 40 {
      let cur = Cursor::new_at(input, pos + 1)
      let col = match dispatch_color_fn(cur, start, len, 0) {
        Ok(c) => c
        Err(e) => return Err(e)
      }
      cur.skip_ws()
      if !cur.eof() {
        return Err(ColorError::InvalidSyntax("unexpected trailing characters"))
      }
      return Ok(col)
    } else {
      let packed = lookup_named_color_packed(input, start, len)
      if packed < 0L {
        return Err(ColorError::UnknownColor(slice_to_lower_string(input, start, len)))
      }
      while pos < n {
        let ch = input.code_unit_at(pos)
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 12 {
          pos = pos + 1
        } else {
          return Err(ColorError::InvalidSyntax("unexpected trailing characters"))
        }
      }
      return Ok(color_from_packed_rgba8(packed))
    }
  }
  Err(ColorError::InvalidSyntax("unexpected character in color"))
}
