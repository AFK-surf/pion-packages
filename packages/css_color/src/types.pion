///| Public types, errors, color spaces, and top-level API for `packages/css_color`.
///| Pure Pion W3C CSS Color Module Level 4 & 5 color engine.
///| Zero external dependencies, zero `extern "C"`, zero `World`, zero mutable globals.

///| Maximum nesting depth for `color-mix()`, relative color `from`, and `calc()` (DoS guard).
pub let max_nesting_depth : Int = 32

///| Maximum input byte length accepted by `parse()` (DoS guard).
pub let max_input_length : Int = 16384

///| Error returned when parsing or evaluating a CSS color expression.
pub enum ColorError {
  EmptyInput
  InputTooLong(Int)
  MaxDepthExceeded(Int)
  InvalidSyntax(String)
  UnknownColor(String)
  UnknownColorSpace(String)
  InvalidComponent(String)
  InvalidAlpha(String)
  InvalidPercentage(String)
  InvalidCalc(String)
  NonFiniteValue(String)
}

///| Human-readable description of a `ColorError`.
pub fn ColorError::to_string(self : ColorError) -> String {
  match self {
    ColorError::EmptyInput => "empty color input"
    ColorError::InputTooLong(n) => "color input too long: " + n.to_string() + " bytes"
    ColorError::MaxDepthExceeded(d) => "maximum nesting depth exceeded: " + d.to_string()
    ColorError::InvalidSyntax(msg) => "invalid syntax: " + msg
    ColorError::UnknownColor(name) => "unknown named color: " + name
    ColorError::UnknownColorSpace(name) => "unknown color space: " + name
    ColorError::InvalidComponent(msg) => "invalid component: " + msg
    ColorError::InvalidAlpha(msg) => "invalid alpha: " + msg
    ColorError::InvalidPercentage(msg) => "invalid percentage: " + msg
    ColorError::InvalidCalc(msg) => "invalid calc expression: " + msg
    ColorError::NonFiniteValue(msg) => "non-finite numeric value: " + msg
  }
}

///| W3C CSS Color Module Level 4 & 5 color spaces.
pub enum ColorSpace {
  Srgb
  SrgbLinear
  DisplayP3
  A98Rgb
  ProphotoRgb
  Rec2020
  XyzD50
  XyzD65
  Hsl
  Hwb
  Lab
  Lch
  Oklab
  Oklch
}

///| Canonical CSS identifier for a `ColorSpace`.
pub fn ColorSpace::css_name(self : ColorSpace) -> String {
  match self {
    ColorSpace::Srgb => "srgb"
    ColorSpace::SrgbLinear => "srgb-linear"
    ColorSpace::DisplayP3 => "display-p3"
    ColorSpace::A98Rgb => "a98-rgb"
    ColorSpace::ProphotoRgb => "prophoto-rgb"
    ColorSpace::Rec2020 => "rec2020"
    ColorSpace::XyzD50 => "xyz-d50"
    ColorSpace::XyzD65 => "xyz-d65"
    ColorSpace::Hsl => "hsl"
    ColorSpace::Hwb => "hwb"
    ColorSpace::Lab => "lab"
    ColorSpace::Lch => "lch"
    ColorSpace::Oklab => "oklab"
    ColorSpace::Oklch => "oklch"
  }
}

///|
pub fn ColorSpace::to_string(self : ColorSpace) -> String {
  self.css_name()
}

///| Returns true for polar color spaces (`hsl`, `hwb`, `lch`, `oklch`).
pub fn ColorSpace::is_polar(self : ColorSpace) -> Bool {
  match self {
    ColorSpace::Hsl | ColorSpace::Hwb | ColorSpace::Lch | ColorSpace::Oklch => true
    _ => false
  }
}

///| Structural equality on `ColorSpace`.
pub fn ColorSpace::eq(self : ColorSpace, other : ColorSpace) -> Bool {
  self.to_int() == other.to_int()
}

///| Stable integer tag for `ColorSpace`.
pub fn ColorSpace::to_int(self : ColorSpace) -> Int {
  match self {
    ColorSpace::Srgb => 0
    ColorSpace::SrgbLinear => 1
    ColorSpace::DisplayP3 => 2
    ColorSpace::A98Rgb => 3
    ColorSpace::ProphotoRgb => 4
    ColorSpace::Rec2020 => 5
    ColorSpace::XyzD50 => 6
    ColorSpace::XyzD65 => 7
    ColorSpace::Hsl => 8
    ColorSpace::Hwb => 9
    ColorSpace::Lab => 10
    ColorSpace::Lch => 11
    ColorSpace::Oklab => 12
    ColorSpace::Oklch => 13
  }
}

///| Hue interpolation method for polar color spaces in CSS Color 4/5.
pub enum HueInterpolation {
  Shorter
  Longer
  Increasing
  Decreasing
}

///|
pub fn HueInterpolation::to_string(self : HueInterpolation) -> String {
  match self {
    HueInterpolation::Shorter => "shorter"
    HueInterpolation::Longer => "longer"
    HueInterpolation::Increasing => "increasing"
    HueInterpolation::Decreasing => "decreasing"
  }
}

///| Immutable, `Send`-safe CSS Color 4/5 color value.
///| Channel coordinates are stored in their canonical CSS Color 4 units:
///| - RGB spaces (`Srgb`, `SrgbLinear`, `DisplayP3`, `A98Rgb`, `ProphotoRgb`, `Rec2020`): `c0, c1, c2` in `[0.0, 1.0]` (unclamped for wide-gamut / extended range)
///| - `XyzD50`, `XyzD65`: `c0=X, c1=Y, c2=Z`
///| - `Hsl`: `c0=H [0,360), c1=S [0,100], c2=L [0,100]`
///| - `Hwb`: `c0=H [0,360), c1=W [0,100], c2=B [0,100]`
///| - `Lab`: `c0=L [0,100], c1=a, c2=b`
///| - `Lch`: `c0=L [0,100], c1=C >= 0, c2=H [0,360)`
///| - `Oklab`: `c0=L [0,1], c1=a, c2=b`
///| - `Oklch`: `c0=L [0,1], c1=C >= 0, c2=H [0,360)`
///| - `alpha` in `[0.0, 1.0]`.
///| Missing (`none`) flags `m0, m1, m2, ma` track CSS Color 4/5 missing components while keeping numeric fields finite.
pub val struct Color {
  pub space : ColorSpace
  pub c0 : Double
  pub c1 : Double
  pub c2 : Double
  pub alpha : Double
  pub m0 : Bool
  pub m1 : Bool
  pub m2 : Bool
  pub ma : Bool
}

///| Construct a `Color` with all components present.
pub fn Color::new(
  space : ColorSpace,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  alpha : Double,
) -> Color {
  Color::{
    space: space,
    c0: c0,
    c1: c1,
    c2: c2,
    alpha: alpha,
    m0: false,
    m1: false,
    m2: false,
    ma: false,
  }
}

///| Construct a `Color` with explicit missing-component (`none`) flags.
pub fn Color::new_with_missing(
  space : ColorSpace,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  alpha : Double,
  m0 : Bool,
  m1 : Bool,
  m2 : Bool,
  ma : Bool,
) -> Color {
  Color::{
    space: space,
    c0: if m0 { 0.0 } else { c0 },
    c1: if m1 { 0.0 } else { c1 },
    c2: if m2 { 0.0 } else { c2 },
    alpha: if ma { 0.0 } else { alpha },
    m0: m0,
    m1: m1,
    m2: m2,
    ma: ma,
  }
}

///| Convenience constructor for sRGB (`0.0..1.0`).
pub fn Color::srgb(r : Double, g : Double, b : Double, alpha : Double) -> Color {
  Color::new(ColorSpace::Srgb, r, g, b, alpha)
}

///| Convenience constructor for 8-bit sRGB (`0..255`).
pub fn Color::rgba8(r : Int, g : Int, b : Int, a : Int) -> Color {
  Color::new(
    ColorSpace::Srgb,
    r.to_double() / 255.0,
    g.to_double() / 255.0,
    b.to_double() / 255.0,
    a.to_double() / 255.0,
  )
}
