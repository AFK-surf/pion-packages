///| Complete W3C CSS Color Module Level 4 named colors (148 named colors + `transparent`).
///| Zero-allocation `(first_byte, len)` direct-slice lookup — zero mutable globals, 100% `Send` safe.

fn eq_ascii_lower(src : String, start : Int, lit : String) -> Bool {
  let n = lit.length()
  let mut i = 0
  while i < n {
    let c = src.code_unit_at(start + i)
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Returns packed `(r << 24) | (g << 16) | (b << 8) | a` as `Int64`, or `-1L` if not found.
fn lookup_named_color_packed(src : String, start : Int, len : Int) -> Int64 {
  if len < 3 || len > 20 {
    return -1L
