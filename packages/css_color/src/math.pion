///| Pure-Pion IEEE-754 double-precision math helpers for `packages/css_color`.
///| Zero `extern "C"`, zero `World`, zero mutable globals — 100% deterministic across Native & Wasm32.

let pi : Double = 3.14159265358979323846264338327950288
let two_pi : Double = 6.28318530717958647692528676655900577
let half_pi : Double = 1.57079632679489661923132169163975144

fn f64_is_finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn f64_abs(x : Double) -> Double {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

fn f64_min(a : Double, b : Double) -> Double {
  if a < b {
    a
  } else {
    b
  }
}

fn f64_max(a : Double, b : Double) -> Double {
  if a > b {
    a
  } else {
    b
  }
}

fn f64_clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x != x || x <= lo {
    lo
  } else if x >= hi {
    hi
  } else {
    x
  }
}

fn f64_clamp01(x : Double) -> Double {
  f64_clamp(x, 0.0, 1.0)
}

fn f64_floor(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if t > x {
    t - 1.0
  } else {
    t
  }
}

fn f64_trunc(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

fn f64_round_u8(x : Double) -> Int {
  let c = f64_clamp01(x)
  let v = f64_floor(c * 255.0 + 0.5).to_int64().to_int()
  if v < 0 {
    0
  } else if v > 255 {
    255
  } else {
    v
  }
}

fn f64_fmod_exact(a0 : Double, b : Double) -> Double {
  let mut a = a0
  if a < b {
    return a
  }
  let mut t = b
  let half_a = a * 0.5
  while t <= half_a {
    t = t * 2.0
  }
  while t >= b {
    if a >= t {
      a = a - t
    }
    t = t * 0.5
  }
  a
}

fn f64_rem_euclid(x : Double, m : Double) -> Double {
  if !f64_is_finite(x) || m <= 0.0 {
    return 0.0
  }
  let fm = f64_fmod_exact(f64_abs(x), m)
  let r = if x >= 0.0 || fm == 0.0 { fm } else { m - fm }
  if r >= m || r < 0.0 {
    0.0
  } else {
    r
  }
}

fn f64_normalize_hue(h : Double) -> Double {
  f64_rem_euclid(h, 360.0)
}

fn f64_sqrt(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 || x == 1.0 / 0.0 {
    return x
  }
  // Scale x into [0.5, 2.0) by powers of 4 so Newton converges in <= 6 iterations.
  let mut m = x
  let mut exp2 = 0
  while m >= 2.0 {
    m = m * 0.25
    exp2 = exp2 + 1
  }
  while m < 0.5 {
    m = m * 4.0
    exp2 = exp2 - 1
  }
  let mut g = 0.5 * (m + 1.0)
  let mut i = 0
  while i < 7 {
    g = 0.5 * (g + m / g)
    i = i + 1
  }
  if exp2 > 0 {
    let mut rem = exp2
    let mut base = 2.0
    while rem > 0 {
      if (rem & 1) != 0 {
        g = g * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  } else if exp2 < 0 {
    let mut rem = -exp2
    let mut base = 0.5
    while rem > 0 {
      if (rem & 1) != 0 {
        g = g * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  }
  g
}

fn f64_cbrt(x : Double) -> Double {
  if x != x || x == 0.0 || !f64_is_finite(x) {
    return x
  }
  let neg = x < 0.0
  let mut m = if neg { -x } else { x }
  // Scale m into [0.125, 1.0) by powers of 8.
  let mut exp2 = 0
  while m >= 1.0 {
    m = m * 0.125
    exp2 = exp2 + 1
  }
  while m < 0.125 {
    m = m * 8.0
    exp2 = exp2 - 1
  }
  // Good initial polynomial guess on [0.125, 1.0]
  let mut g = 0.45 + 0.55 * m
  let mut i = 0
  while i < 8 {
    g = (2.0 * g + m / (g * g)) / 3.0
    i = i + 1
  }
  if exp2 > 0 {
    let mut rem = exp2
    let mut base = 2.0
    while rem > 0 {
      if (rem & 1) != 0 {
        g = g * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  } else if exp2 < 0 {
    let mut rem = -exp2
    let mut base = 0.5
    while rem > 0 {
      if (rem & 1) != 0 {
        g = g * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  }
  if neg { -g } else { g }
}

fn f64_ln(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return 1.0 / 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let mut m = x
  let mut k = 0
  while m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1
  }
  while m < 0.7071067811865476 {
    m = m * 2.0
    k = k - 1
  }
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let poly = 1.0 +
  t2 * (
    0.3333333333333333 +
    t2 * (
      0.2 +
      t2 * (
        0.14285714285714285 +
        t2 * (
          0.1111111111111111 +
          t2 * (
            0.09090909090909091 +
            t2 * (0.07692307692307693 + t2 * 0.06666666666666667)
          )
        )
      )
    )
  )
  2.0 * t * poly + k.to_double() * ln2
}

fn f64_exp(x : Double) -> Double {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019412 {
    return 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let ln2_hi = 0.693147180369123816490
  let ln2_lo = 1.90821492927058770002e-10
  let kf = f64_floor(x / ln2 + 0.5)
  let k = kf.to_int64().to_int()
  let r = (x - kf * ln2_hi) - kf * ln2_lo
  let mut res = 1.0 +
  r * (
    1.0 +
    r * (
      0.5 +
      r * (
        0.16666666666666666 +
        r * (
          0.041666666666666664 +
          r * (
            0.008333333333333333 +
            r * (
              0.001388888888888889 +
              r * (
                0.0001984126984126984 +
                r * (
                  0.0000248015873015873 +
                  r * (
                    0.0000027557319223985893 +
                    r * (0.0000002755731922398589 + r * 0.00000002505210838544172)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  if k > 0 {
    let mut rem = k
    let mut base = 2.0
    while rem > 0 {
      if (rem & 1) != 0 {
        res = res * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  } else if k < 0 {
    let mut rem = -k
    let mut base = 0.5
    while rem > 0 {
      if (rem & 1) != 0 {
        res = res * base
      }
      rem = rem >> 1
      if rem > 0 {
        base = base * base
      }
    }
  }
  res
}

fn f64_pow(x : Double, y : Double) -> Double {
  if y == 0.0 {
    return 1.0
  }
  if x == 1.0 {
    return 1.0
  }
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if f64_is_finite(y) && y == f64_trunc(y) && y >= -1074.0 && y <= 1074.0 {
    let mut exp_i = y.to_int64().to_int()
    let neg_exp = exp_i < 0
    if neg_exp {
      exp_i = -exp_i
    }
    let mut base = x
    let mut acc = 1.0
    while exp_i > 0 {
      if (exp_i & 1) != 0 {
        acc = acc * base
      }
      exp_i = exp_i >> 1
      if exp_i > 0 {
        base = base * base
      }
    }
    return if neg_exp { 1.0 / acc } else { acc }
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { 0.0 } else { 1.0 / 0.0 }
  }
  f64_exp(y * f64_ln(x))
}

fn f64_sin_poly(r : Double) -> Double {
  let r2 = r * r
  r * (
    1.0 +
    r2 * (
      -0.16666666666666666 +
      r2 * (
        0.008333333333333333 +
        r2 * (
          -0.0001984126984126984 +
          r2 * (
            0.0000027557319223985893 +
            r2 * (-2.505210838544172e-8 + r2 * 1.6059043836821613e-10)
          )
        )
      )
    )
  )
}

fn f64_cos_poly(r : Double) -> Double {
  let r2 = r * r
  1.0 +
  r2 * (
    -0.5 +
    r2 * (
      0.041666666666666664 +
      r2 * (
        -0.001388888888888889 +
        r2 * (
          0.0000248015873015873 +
          r2 * (-2.755731922398589e-7 + r2 * 2.08767569878681e-9)
        )
      )
    )
  )
}

fn f64_sin(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  // Range reduction to [-pi/4, pi/4]
  let k = f64_floor(x / half_pi + 0.5)
  let r = x - k * half_pi
  let q = k.to_int64().to_int() & 3
  if q == 0 {
    f64_sin_poly(r)
  } else if q == 1 {
    f64_cos_poly(r)
  } else if q == 2 {
    -f64_sin_poly(r)
  } else {
    -f64_cos_poly(r)
  }
}

fn f64_cos(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  let k = f64_floor(x / half_pi + 0.5)
  let r = x - k * half_pi
  let q = k.to_int64().to_int() & 3
  if q == 0 {
    f64_cos_poly(r)
  } else if q == 1 {
    -f64_sin_poly(r)
  } else if q == 2 {
    -f64_cos_poly(r)
  } else {
    f64_sin_poly(r)
  }
}

fn f64_atan_unit(x : Double) -> Double {
  // Accurate for |x| <= tan(pi/8) = 0.41421356237309503
  let x2 = x * x
  x * (
    1.0 +
    x2 * (
      -0.3333333333333333 +
      x2 * (
        0.2 +
        x2 * (
          -0.14285714285714285 +
          x2 * (
            0.1111111111111111 +
            x2 * (
              -0.09090909090909091 +
              x2 * (
                0.07692307692307693 +
                x2 * (
                  -0.06666666666666667 +
                  x2 * (0.058823529411764705 + x2 * (-0.05263157894736842 + x2 * 0.047619047619047616))
                )
              )
            )
          )
        )
      )
    )
  )
}

fn f64_atan(x : Double) -> Double {
  if x != x {
    return x
  }
  let neg = x < 0.0
  let ax = if neg { -x } else { x }
  let res = if ax > 2.414213562373095 {
    half_pi - f64_atan_unit(1.0 / ax)
  } else if ax > 0.41421356237309503 {
    0.78539816339744830962 + f64_atan_unit((ax - 1.0) / (ax + 1.0))
  } else {
    f64_atan_unit(ax)
  }
  if neg { -res } else { res }
}

fn f64_atan2(y : Double, x : Double) -> Double {
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if x > 0.0 {
    f64_atan(y / x)
  } else if x < 0.0 {
    if y >= 0.0 {
      f64_atan(y / x) + pi
    } else {
      f64_atan(y / x) - pi
    }
  } else if y > 0.0 {
    half_pi
  } else if y < 0.0 {
    -half_pi
  } else {
    0.0
  }
}

fn deg_to_rad(d : Double) -> Double {
  d * (pi / 180.0)
}

fn rad_to_deg(r : Double) -> Double {
  r * (180.0 / pi)
}

fn mat3_mul(
  m00 : Double,
  m01 : Double,
  m02 : Double,
  m10 : Double,
  m11 : Double,
  m12 : Double,
  m20 : Double,
  m21 : Double,
  m22 : Double,
  x : Double,
  y : Double,
  z : Double,
) -> (Double, Double, Double) {
  (
    m00 * x + m01 * y + m02 * z,
    m10 * x + m11 * y + m12 * z,
    m20 * x + m21 * y + m22 * z,
  )
}
