///| Pure-Pion IEEE-754 double-precision math helpers for `packages/css_color`.
///| Zero `extern "C"`, zero `World`, zero mutable globals — 100% deterministic across Native & Wasm32.

let pi : Double = 3.14159265358979323846264338327950288
let two_pi : Double = 6.28318530717958647692528676655900577
let half_pi : Double = 1.57079632679489661923132169163975144

fn f64_is_finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn f64_abs(x : Double) -> Double {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

fn f64_min(a : Double, b : Double) -> Double {
  if a < b {
    a
  } else {
    b
  }
}

fn f64_max(a : Double, b : Double) -> Double {
  if a > b {
    a
  } else {
    b
  }
}

fn f64_clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x != x || x <= lo {
    lo
  } else if x >= hi {
    hi
  } else {
    x
  }
}

fn f64_clamp01(x : Double) -> Double {
  if x != x || x <= 0.0 {
    0.0
  } else if x >= 1.0 {
    1.0
  } else {
    x
  }
}

fn f64_floor(x : Double) -> Double {
  math_floor(x)
}

fn f64_trunc(x : Double) -> Double {
  math_trunc(x)
}

fn f64_round_u8(x : Double) -> Int {
  if x != x || x <= 0.0 {
    return 0
  }
  if x >= 1.0 {
    return 255
  }
  (x * 255.0 + 0.5).to_int64().to_int()
}

fn f64_fmod_exact(a0 : Double, b : Double) -> Double {
  let mut a = a0
  if a < b {
    return a
  }
  let mut t = b
  let half_a = a * 0.5
  while t <= half_a {
    t = t * 2.0
  }
  while t >= b {
    if a >= t {
      a = a - t
    }
    t = t * 0.5
  }
  a
}

fn f64_rem_euclid(x : Double, m : Double) -> Double {
  if !f64_is_finite(x) || m <= 0.0 {
    return 0.0
  }
  if x >= 0.0 && x < m {
    return x
  }
  let fm = f64_fmod_exact(math_abs(x), m)
  let r = if x >= 0.0 || fm == 0.0 { fm } else { m - fm }
  if r >= m || r < 0.0 {
    0.0
  } else {
    r
  }
}

fn f64_normalize_hue(h : Double) -> Double {
  if h >= 0.0 && h < 360.0 {
    return h
  }
  f64_rem_euclid(h, 360.0)
}

fn f64_sqrt(x : Double) -> Double {
  x.sqrt()
}

fn f64_cbrt(x : Double) -> Double {
  let bits = x.to_bits()
  if bits > 0x000fffffffffffffL && bits < 0x7000000000000000L {
    let hi = (((bits >> 32) * 1431655766L) >> 32) + 0x2a9f7893L
    let mut g = Double::from_bits(hi << 32)
    let t1 = g * g * g
    g = g * (t1 + 2.0 * x) / (2.0 * t1 + x)
    let t2 = g * g * g
    return g * (t2 + 2.0 * x) / (2.0 * t2 + x)
  }
  if x == 0.0 || !f64_is_finite(x) {
    return x
  }
  let neg = x < 0.0
  let mut ax = if neg { -x } else { x }
  let mut scale = 1.0
  if ax < 2.2250738585072014e-308 {
    ax = ax * 18014398509481984.0
    scale = 1.0 / 262144.0
  } else if ax > 1.0e200 {
    ax = ax * (1.0 / 18014398509481984.0)
    scale = 262144.0
  }
  let b = ax.to_bits()
  let hi = (((b >> 32) * 1431655766L) >> 32) + 0x2a9f7893L
  let mut g = Double::from_bits(hi << 32)
  let t1 = g * g * g
  g = g * (t1 + 2.0 * ax) / (2.0 * t1 + ax)
  let t2 = g * g * g
  g = g * (t2 + 2.0 * ax) / (2.0 * t2 + ax)
  let res = g * scale
  if neg { -res } else { res }
}

fn f64_ln(x_in : Double) -> Double {
  if !(x_in > 0.0) {
    return if x_in == 0.0 { -1.0 / 0.0 } else { 0.0 / 0.0 }
  }
  if x_in == 1.0 / 0.0 {
    return x_in
  }
  let mut x = x_in
  let mut extra_k = 0L
  if x < 2.2250738585072014e-308 {
    x = x * 18014398509481984.0
    extra_k = -54L
  }
  let bits = x.to_bits()
  let adj = bits + 0x00095f619980c433L
  let k = (adj >> 52) - 1023L
  let m = Double::from_bits(bits - (k << 52))
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let poly = 1.0 +
  t2 * (
    0.3333333333333333 +
    t2 * (
      0.2 +
      t2 * (
        0.14285714285714285 +
        t2 * (
          0.1111111111111111 +
          t2 * (
            0.09090909090909091 +
            t2 * (0.07692307692307693 + t2 * 0.06666666666666667)
          )
        )
      )
    )
  )
  2.0 * t * poly + (k + extra_k).to_double() * 0.693147180559945309417232121458176568
}

fn f64_exp(x : Double) -> Double {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019412 {
    return 0.0
  }
  let kf = math_floor(x * 1.4426950408889634 + 0.5)
  let k = kf.to_int64()
  let r = (x - kf * 0.693147180369123816490) - kf * 1.90821492927058770002e-10
  let res = 1.0 +
  r * (
    1.0 +
    r * (
      0.5 +
      r * (
        0.16666666666666666 +
        r * (
          0.041666666666666664 +
          r * (
            0.008333333333333333 +
            r * (
              0.001388888888888889 +
              r * (
                0.0001984126984126984 +
                r * (
                  0.0000248015873015873 +
                  r * (
                    0.0000027557319223985893 +
                    r * (0.0000002755731922398589 + r * 0.00000002505210838544172)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  if k >= -1022L && k <= 1023L {
    res * Double::from_bits((k + 1023L) << 52)
  } else if k < -1022L {
    res * Double::from_bits((k + 1535L) << 52) * Double::from_bits(511L << 52)
  } else {
    res * Double::from_bits((k + 511L) << 52) * Double::from_bits(1535L << 52)
  }
}

fn f64_pow_pos(x_in : Double, y : Double) -> Double {
  if x_in == 1.0 / 0.0 {
    return if y > 0.0 { x_in } else { 0.0 }
  }
  if x_in != x_in {
    return Double::from_bits(0x7ff8000000000000L)
  }
  let mut x = x_in
  let mut extra_k = 0L
  if x < 2.2250738585072014e-308 {
    x = x * 18014398509481984.0
    extra_k = -54L
  }
  let bits = x.to_bits()
  let adj = bits + 0x00095f619980c433L
  let k = (adj >> 52) - 1023L
  let m = Double::from_bits(bits - (k << 52))
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let poly_l = 1.0 +
  t2 * (
    0.3333333333333333 +
    t2 * (
      0.2 +
      t2 * (
        0.14285714285714285 +
        t2 * (
          0.1111111111111111 +
          t2 * (0.09090909090909091 + t2 * (0.07692307692307693 + t2 * 0.06666666666666667))
        )
      )
    )
  )
  let z = y * (2.8853900817779268 * t * poly_l + (k + extra_k).to_double())
  if z > 1023.99999 {
    return 1.0 / 0.0
  }
  if z < -1074.0 {
    return 0.0
  }
  let kf = math_floor(z + 0.5)
  let ki = kf.to_int64()
  let r = (z - kf) * 0.693147180559945309417232121458176568
  let res = 1.0 +
  r * (
    1.0 +
    r * (
      0.5 +
      r * (
        0.16666666666666666 +
        r * (
          0.041666666666666664 +
          r * (
            0.008333333333333333 +
            r * (
              0.001388888888888889 +
              r * (
                0.0001984126984126984 +
                r * (
                  0.0000248015873015873 +
                  r * (
                    0.0000027557319223985893 +
                    r * (0.0000002755731922398589 + r * 0.00000002505210838544172)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  if ki >= -1022L && ki <= 1023L {
    res * Double::from_bits((ki + 1023L) << 52)
  } else if ki < -1022L {
    res * Double::from_bits((ki + 1535L) << 52) * Double::from_bits(511L << 52)
  } else {
    res * Double::from_bits((ki + 511L) << 52) * Double::from_bits(1535L << 52)
  }
}

fn f64_pow(x : Double, y : Double) -> Double {
  if y == 0.0 || x == 1.0 {
    return 1.0
  }
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if f64_is_finite(y) && y == math_trunc(y) && y >= -1074.0 && y <= 1074.0 {
    let mut exp_i = y.to_int64().to_int()
    let neg_exp = exp_i < 0
    if neg_exp {
      exp_i = -exp_i
    }
    let mut base = x
    let mut acc = 1.0
    while exp_i > 0 {
      if (exp_i & 1) != 0 {
        acc = acc * base
      }
      exp_i = exp_i >> 1
      if exp_i > 0 {
        base = base * base
      }
    }
    return if neg_exp { 1.0 / acc } else { acc }
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { 0.0 } else { 1.0 / 0.0 }
  }
  f64_exp(y * f64_ln(x))
}

fn f64_sin_poly(r : Double) -> Double {
  let r2 = r * r
  r * (
    1.0 +
    r2 * (
      -0.16666666666666666 +
      r2 * (
        0.008333333333333333 +
        r2 * (
          -0.0001984126984126984 +
          r2 * (
            0.0000027557319223985893 +
            r2 * (-2.505210838544172e-8 + r2 * 1.6059043836821613e-10)
          )
        )
      )
    )
  )
}

fn f64_cos_poly(r : Double) -> Double {
  let r2 = r * r
  1.0 +
  r2 * (
    -0.5 +
    r2 * (
      0.041666666666666664 +
      r2 * (
        -0.001388888888888889 +
        r2 * (
          0.0000248015873015873 +
          r2 * (-2.755731922398589e-7 + r2 * 2.08767569878681e-9)
        )
      )
    )
  )
}

let inv_half_pi : Double = 0.636619772367581343075535053490057448

fn f64_sin(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  let k = math_floor(x * inv_half_pi + 0.5)
  let r = x - k * half_pi
  let q = k.to_int64().to_int() & 3
  if q == 0 {
    f64_sin_poly(r)
  } else if q == 1 {
    f64_cos_poly(r)
  } else if q == 2 {
    -f64_sin_poly(r)
  } else {
    -f64_cos_poly(r)
  }
}

fn f64_cos(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  let k = math_floor(x * inv_half_pi + 0.5)
  let r = x - k * half_pi
  let q = k.to_int64().to_int() & 3
  if q == 0 {
    f64_cos_poly(r)
  } else if q == 1 {
    -f64_sin_poly(r)
  } else if q == 2 {
    -f64_cos_poly(r)
  } else {
    f64_sin_poly(r)
  }
}

fn f64_sincos(x : Double) -> (Double, Double) {
  if !f64_is_finite(x) {
    let nan = 0.0 / 0.0
    return (nan, nan)
  }
  let k = math_floor(x * inv_half_pi + 0.5)
  let r = x - k * half_pi
  let s = f64_sin_poly(r)
  let c = f64_cos_poly(r)
  let q = k.to_int64().to_int() & 3
  if q == 0 {
    (s, c)
  } else if q == 1 {
    (c, -s)
  } else if q == 2 {
    (-s, -c)
  } else {
    (-c, s)
  }
}

fn f64_atan_unit(x : Double) -> Double {
  let u = x * x
  let u2 = u * u
  let u4 = u2 * u2
  let p0 = 0.9999999999783985 + u * -0.3333333209761082
  let p1 = 0.1999988385664219 + u * -0.14281588774111822
  let p2 = 0.11040489240019863 + u * -0.08456192955455091 + u2 * 0.04707348301764882
  x * (p0 + u2 * p1 + u4 * p2)
}

fn f64_atan2(y : Double, x : Double) -> Double {
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { half_pi } else if y < 0.0 { -half_pi } else { 0.0 }
  }
  let q = y / x
  let neg = q < 0.0
  let ax = if neg { -q } else { q }
  let r0 = if ax > 2.414213562373095 {
    half_pi - f64_atan_unit(1.0 / ax)
  } else if ax > 0.41421356237309503 {
    0.78539816339744830962 + f64_atan_unit((ax - 1.0) / (ax + 1.0))
  } else {
    f64_atan_unit(ax)
  }
  let a = if neg { -r0 } else { r0 }
  if x > 0.0 {
    a
  } else if y >= 0.0 {
    a + pi
  } else {
    a - pi
  }
}

fn deg_to_rad(d : Double) -> Double {
  d * (pi / 180.0)
}

fn rad_to_deg(r : Double) -> Double {
  r * (180.0 / pi)
}

fn mat3_mul(
  m00 : Double,
  m01 : Double,
  m02 : Double,
  m10 : Double,
  m11 : Double,
  m12 : Double,
  m20 : Double,
  m21 : Double,
  m22 : Double,
  x : Double,
  y : Double,
  z : Double,
) -> (Double, Double, Double) {
  (
    m00 * x + m01 * y + m02 * z,
    m10 * x + m11 * y + m12 * z,
    m20 * x + m21 * y + m22 * z,
  )
}
