///| W3C CSS Color Module Level 5 `color-mix()` interpolation engine.
///| Implements §2.1-2.4 percentage normalization, alpha multiplier, premultiplied alpha interpolation,
///| all 4 polar hue interpolation modes (`shorter`, `longer`, `increasing`, `decreasing`),
///| and missing-component (`none`) carry-forward rules.

fn interpolate_hue(h1_in : Double, h2_in : Double, t : Double, mode : HueInterpolation) -> Double {
  let mut h1 = f64_normalize_hue(h1_in)
  let mut h2 = f64_normalize_hue(h2_in)
  let diff = h2 - h1
  match mode {
    HueInterpolation::Shorter => {
      if diff > 180.0 {
        h1 = h1 + 360.0
      } else if diff < -180.0 {
        h2 = h2 + 360.0
      }
    }
    HueInterpolation::Longer => {
      if diff > 0.0 && diff < 180.0 {
        h1 = h1 + 360.0
      } else if diff > -180.0 && diff <= 0.0 {
        h2 = h2 + 360.0
      }
    }
    HueInterpolation::Increasing => {
      if h2 < h1 {
        h2 = h2 + 360.0
      }
    }
    HueInterpolation::Decreasing => {
      if h1 < h2 {
        h1 = h1 + 360.0
      }
    }
  }
  f64_normalize_hue(h1 + (h2 - h1) * t)
}

fn is_hue_channel(space : ColorSpace, idx : Int) -> Bool {
  match space {
    ColorSpace::Hsl | ColorSpace::Hwb => idx == 0
    ColorSpace::Lch | ColorSpace::Oklch => idx == 2
    _ => false
  }
}

fn mix_channel(
  v1 : Double,
  m1 : Bool,
  v2 : Double,
  m2 : Bool,
  a1 : Double,
  a2 : Double,
  a_interp : Double,
  w1 : Double,
  w2 : Double,
  is_hue : Bool,
  hue_mode : HueInterpolation,
) -> (Double, Bool) {
  if m1 && m2 {
    return (0.0, true)
  }
  if is_hue && (m1 || m2) {
    let hv = if m1 { v2 } else { v1 }
    return (interpolate_hue(hv, hv, w2, hue_mode), false)
  }
  if m1 {
    return (v2, false)
  }
  if m2 {
    return (v1, false)
  }
  if is_hue {
    return (interpolate_hue(v1, v2, w2, hue_mode), false)
  }
  if a_interp > 0.0 {
    ((w1 * v1 * a1 + w2 * v2 * a2) / a_interp, false)
  } else {
    (0.0, false)
  }
}

///| Normalize CSS Color 5 `color-mix()` percentages `(p1, p2)` where `None` means omitted.
///| Returns `(w1, w2, alpha_multiplier)` with `w1 + w2 == 1.0`.
///| Per CSS Color 5 ED WG resolution, `0% + 0%` yields equal weights `(0.5, 0.5)` with `alpha_multiplier = 0.0`.
fn normalize_mix_percentages(
  p1_opt : Option[Double],
  p2_opt : Option[Double],
) -> Result[(Double, Double, Double), ColorError] {
  let (p1, p2) = match (p1_opt, p2_opt) {
    (None, None) => (50.0, 50.0)
    (Some(v1), None) => {
      if !f64_is_finite(v1) || v1 < 0.0 || v1 > 100.0 {
        return Err(ColorError::InvalidPercentage("p1 out of [0%, 100%]"))
      }
      (v1, 100.0 - v1)
    }
    (None, Some(v2)) => {
      if !f64_is_finite(v2) || v2 < 0.0 || v2 > 100.0 {
        return Err(ColorError::InvalidPercentage("p2 out of [0%, 100%]"))
      }
      (100.0 - v2, v2)
    }
    (Some(v1), Some(v2)) => {
      if !f64_is_finite(v1) || !f64_is_finite(v2) || v1 < 0.0 || v1 > 100.0 || v2 < 0.0 || v2 > 100.0 {
        return Err(ColorError::InvalidPercentage("percentage out of [0%, 100%]"))
      }
      (v1, v2)
    }
    _ => (50.0, 50.0)
  }
  let sum = p1 + p2
  if sum <= 0.0 {
    return Ok((0.5, 0.5, 0.0))
  }
  let alpha_mult = if sum < 100.0 { sum / 100.0 } else { 1.0 }
  let w1 = p1 / sum
  let w2 = p2 / sum
  Ok((w1, w2, alpha_mult))
}

fn mix_two_converted(
  c1 : Color,
  c2 : Color,
  space : ColorSpace,
  hue_mode : HueInterpolation,
  w1 : Double,
  w2 : Double,
  alpha_mult : Double,
) -> Color {
  // Alpha handling (missing alpha takes the other's alpha, both missing stays missing)
  let (a1, a2, a_interp, ma_out) = if c1.ma && c2.ma {
    (1.0, 1.0, 1.0, true)
  } else if c1.ma {
    let a = f64_clamp01(c2.alpha)
    (a, a, a, false)
  } else if c2.ma {
    let a = f64_clamp01(c1.alpha)
    (a, a, a, false)
  } else {
    let a1v = f64_clamp01(c1.alpha)
    let a2v = f64_clamp01(c2.alpha)
    (a1v, a2v, w1 * a1v + w2 * a2v, false)
  }

  let (r0, m0) = mix_channel(
    c1.c0,
    c1.m0,
    c2.c0,
    c2.m0,
    a1,
    a2,
    a_interp,
    w1,
    w2,
    is_hue_channel(space, 0),
    hue_mode,
  )
  let (r1, m1) = mix_channel(
    c1.c1,
    c1.m1,
    c2.c1,
    c2.m1,
    a1,
    a2,
    a_interp,
    w1,
    w2,
    is_hue_channel(space, 1),
    hue_mode,
  )
  let (r2, m2) = mix_channel(
    c1.c2,
    c1.m2,
    c2.c2,
    c2.m2,
    a1,
    a2,
    a_interp,
    w1,
    w2,
    is_hue_channel(space, 2),
    hue_mode,
  )

  let final_alpha = if ma_out { 0.0 } else { f64_clamp01(a_interp * alpha_mult) }
  Color::new_with_missing(space, r0, r1, r2, final_alpha, m0, m1, m2, ma_out)
}

fn mix_colors_internal(
  c1_in : Color,
  c2_in : Color,
  space : ColorSpace,
  hue_mode : HueInterpolation,
  p1_opt : Option[Double],
  p2_opt : Option[Double],
) -> Result[Color, ColorError] {
  let (w1, w2, alpha_mult) = match normalize_mix_percentages(p1_opt, p2_opt) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let c1 = c1_in.convert(space)
  let c2 = c2_in.convert(space)
  Ok(mix_two_converted(c1, c2, space, hue_mode, w1, w2, alpha_mult))
}

fn mix_many_colors_internal(
  colors : Array[Color],
  pcts : Array[Option[Double]],
  space : ColorSpace,
  hue_mode : HueInterpolation,
) -> Result[Color, ColorError] {
  let n = colors.length()
  if n == 0 {
    return Err(ColorError::InvalidSyntax("color-mix() requires at least one color"))
  }
  if n == 2 {
    return mix_colors_internal(colors[0], colors[1], space, hue_mode, pcts[0], pcts[1])
  }
  let mut sum_spec = 0.0
  let mut n_omitted = 0
  let mut i = 0
  while i < n {
    match pcts[i] {
      Some(v) => {
        if !f64_is_finite(v) || v < 0.0 || v > 100.0 {
          return Err(ColorError::InvalidPercentage("percentage out of [0%, 100%]"))
        }
        sum_spec = sum_spec + v
      }
      None => n_omitted = n_omitted + 1
    }
    i = i + 1
  }
  let fill = if n_omitted > 0 && sum_spec < 100.0 {
    (100.0 - sum_spec) / n_omitted.to_double()
  } else {
    0.0
  }
  let eff : Array[Double] = []
  let mut total = 0.0
  i = 0
  while i < n {
    let p = match pcts[i] {
      Some(v) => v
      None => fill
    }
    eff.push(p)
    total = total + p
    i = i + 1
  }
  let alpha_mult = if total < 100.0 { total / 100.0 } else { 1.0 }
  if n == 1 {
    let c0 = colors[0].convert(space)
    let a = if c0.ma { 0.0 } else { f64_clamp01(c0.alpha * alpha_mult) }
    return Ok(Color::new_with_missing(space, c0.c0, c0.c1, c0.c2, a, c0.m0, c0.m1, c0.m2, c0.ma))
  }
  let mut acc = colors[0].convert(space)
  let mut acc_p = eff[0]
  i = 1
  while i < n {
    let ci = colors[i].convert(space)
    let pi_w = eff[i]
    let pair_sum = acc_p + pi_w
    let (w1, w2) = if pair_sum <= 0.0 { (0.5, 0.5) } else { (acc_p / pair_sum, pi_w / pair_sum) }
    acc = mix_two_converted(acc, ci, space, hue_mode, w1, w2, 1.0)
    acc_p = pair_sum
    i = i + 1
  }
  let final_alpha = if acc.ma { 0.0 } else { f64_clamp01(acc.alpha * alpha_mult) }
  Ok(Color::new_with_missing(space, acc.c0, acc.c1, acc.c2, final_alpha, acc.m0, acc.m1, acc.m2, acc.ma))
}

///| Mix two colors using CSS Color 5 `color-mix()` rules.
///| `p1` and `p2` are percentages in `[0.0, 100.0]`.
pub fn Color::mix(
  self : Color,
  other : Color,
  space : ColorSpace,
  hue_mode : HueInterpolation,
  p1 : Double,
  p2 : Double,
) -> Result[Color, ColorError] {
  mix_colors_internal(self, other, space, hue_mode, Some(p1), Some(p2))
}
