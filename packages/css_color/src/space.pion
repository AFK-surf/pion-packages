///| Exact W3C CSS Color Module Level 4 color space conversions and §13.2 Oklch gamut mapping.
///| Exact Bradford D65 <-> D50 adaptation, exact Ottosson/CSS Color 4 Oklab matrices,
///| extended-range transfer functions, and CSS Color 4 §4.4 / §12.2 missing-component carry-forward.

// === Transfer functions (extended-range, sign-preserving) ===

fn srgb_to_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av <= 0.04045 {
    v / 12.92
  } else {
    sign * f64_pow((av + 0.055) / 1.055, 2.4)
  }
}

fn srgb_from_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av > 0.0031308 {
    sign * (1.055 * f64_pow(av, 1.0 / 2.4) - 0.055)
  } else {
    12.92 * v
  }
}

fn a98_to_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  sign * f64_pow(f64_abs(v), 563.0 / 256.0)
}

fn a98_from_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  sign * f64_pow(f64_abs(v), 256.0 / 563.0)
}

fn prophoto_to_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av <= 16.0 / 512.0 {
    v / 16.0
  } else {
    sign * f64_pow(av, 1.8)
  }
}

fn prophoto_from_linear_ch(v : Double) -> Double {
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av >= 1.0 / 512.0 {
    sign * f64_pow(av, 1.0 / 1.8)
  } else {
    16.0 * v
  }
}

fn rec2020_to_linear_ch(v : Double) -> Double {
  let alpha = 1.09929682680944
  let beta = 0.018053968510807
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av < beta * 4.5 {
    v / 4.5
  } else {
    sign * f64_pow((av + alpha - 1.0) / alpha, 1.0 / 0.45)
  }
}

fn rec2020_from_linear_ch(v : Double) -> Double {
  let alpha = 1.09929682680944
  let beta = 0.018053968510807
  let sign = if v < 0.0 { -1.0 } else { 1.0 }
  let av = f64_abs(v)
  if av > beta {
    sign * (alpha * f64_pow(av, 0.45) - (alpha - 1.0))
  } else {
    4.5 * v
  }
}

// === Bradford D65 <-> D50 ===

fn xyz_d65_to_d50(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    1.0479298208405488,
    0.022946793341019088,
    -0.05019222954313557,
    0.029627815688159344,
    0.990434484573249,
    -0.01707382502938514,
    -0.009243058152591178,
    0.015055144896577895,
    0.7518742899580008,
    x,
    y,
    z,
  )
}

fn xyz_d50_to_d65(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.9554734527042182,
    -0.023098536874261423,
    0.0632593086610217,
    -0.028369706963208136,
    1.0099954580058226,
    0.021041398966943008,
    0.012314001688319899,
    -0.020507696433477912,
    1.3303659366080753,
    x,
    y,
    z,
  )
}

// === Linear RGB <-> XYZ ===

fn lin_srgb_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.41239079926595934,
    0.357584339383878,
    0.1804807884018343,
    0.21263900587151027,
    0.715168678767756,
    0.07219231536073371,
    0.01933081871559182,
    0.11919477979462598,
    0.9505321522496607,
    r,
    g,
    b,
  )
}

fn xyz_d65_to_lin_srgb(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    3.2409699419045226,
    -1.537383177570094,
    -0.4986107602930034,
    -0.9692436362808796,
    1.8759675015077202,
    0.04155505740717559,
    0.05563007969699366,
    -0.20397695888897652,
    1.0569715142428786,
    x,
    y,
    z,
  )
}

fn lin_p3_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.4865709486482162,
    0.26566769316909306,
    0.1982172852343625,
    0.2289745640697488,
    0.6917385218365064,
    0.079286914093745,
    0.0,
    0.04511338185890264,
    1.043944368900976,
    r,
    g,
    b,
  )
}

fn xyz_d65_to_lin_p3(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    2.493496911941425,
    -0.9313836179191239,
    -0.40271078445071684,
    -0.8294889695615747,
    1.7626640603183463,
    0.023624685841943577,
    0.03584583024378447,
    -0.07617238926804182,
    0.9568845240076872,
    x,
    y,
    z,
  )
}

fn lin_a98_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.5766690429101305,
    0.1855582379065463,
    0.1882286462349947,
    0.29734497525053605,
    0.6273635662554661,
    0.07529145849399788,
    0.02703136138641234,
    0.07068885253582723,
    0.9913375368376388,
    r,
    g,
    b,
  )
}

fn xyz_d65_to_lin_a98(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    2.0415879038107465,
    -0.5650069742788596,
    -0.34473135077832956,
    -0.9692436362808795,
    1.8759675015077206,
    0.04155505740717557,
    0.013444280632031142,
    -0.11836239223101838,
    1.0151749943912054,
    x,
    y,
    z,
  )
}

fn lin_prophoto_to_xyz_d50(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.7977604896723027,
    0.13518583717574031,
    0.0313493495815248,
    0.2880711282292934,
    0.7118432178101014,
    0.00008565396060525902,
    0.0,
    0.0,
    0.8251046025104601,
    r,
    g,
    b,
  )
}

fn xyz_d50_to_lin_prophoto(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    1.3457989731028281,
    -0.25558010007997534,
    -0.05110628506753401,
    -0.5446224939028347,
    1.5082327413132781,
    0.02053603239147973,
    0.0,
    0.0,
    1.2119675456389454,
    x,
    y,
    z,
  )
}

fn lin_rec2020_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  mat3_mul(
    0.6369580483012914,
    0.14461690358620832,
    0.1688809751641721,
    0.2627002120112671,
    0.6779980715188708,
    0.05930171646986196,
    0.0,
    0.028072693049087428,
    1.060985057710791,
    r,
    g,
    b,
  )
}

fn xyz_d65_to_lin_rec2020(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  mat3_mul(
    1.7166511879712674,
    -0.35567078377639233,
    -0.25336628137365974,
    -0.6666843518324892,
    1.6164812366349395,
    0.01576854581391113,
    0.017639857445310783,
    -0.042770613257808524,
    0.9421031212354738,
    x,
    y,
    z,
  )
}

// === CIE Lab <-> XYZ-D50 ===

let d50_x : Double = 0.3457 / 0.3585
let d50_y : Double = 1.0
let d50_z : Double = (1.0 - 0.3457 - 0.3585) / 0.3585
let lab_kappa : Double = 24389.0 / 27.0
let lab_epsilon : Double = 216.0 / 24389.0

fn xyz_d50_to_lab(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  let xr = x / d50_x
  let yr = y / d50_y
  let zr = z / d50_z
  let fx = if xr > lab_epsilon { f64_cbrt(xr) } else { (lab_kappa * xr + 16.0) / 116.0 }
  let fy = if yr > lab_epsilon { f64_cbrt(yr) } else { (lab_kappa * yr + 16.0) / 116.0 }
  let fz = if zr > lab_epsilon { f64_cbrt(zr) } else { (lab_kappa * zr + 16.0) / 116.0 }
  let l = 116.0 * fy - 16.0
  let a = 500.0 * (fx - fy)
  let b = 200.0 * (fy - fz)
  (l, a, b)
}

fn lab_to_xyz_d50(l : Double, a : Double, b : Double) -> (Double, Double, Double) {
  let fy = (l + 16.0) / 116.0
  let fx = a / 500.0 + fy
  let fz = fy - b / 200.0
  let fx3 = fx * fx * fx
  let fz3 = fz * fz * fz
  let xr = if fx3 > lab_epsilon { fx3 } else { (116.0 * fx - 16.0) / lab_kappa }
  let yr = if l > lab_kappa * lab_epsilon {
    let t = (l + 16.0) / 116.0
    t * t * t
  } else {
    l / lab_kappa
  }
  let zr = if fz3 > lab_epsilon { fz3 } else { (116.0 * fz - 16.0) / lab_kappa }
  (xr * d50_x, yr * d50_y, zr * d50_z)
}

// === Oklab <-> XYZ-D65 (CSS Color 4 §18 exact matrices) ===

fn xyz_d65_to_oklab(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  let (l, m, s) = mat3_mul(
    0.8190224379967030,
    0.3619062600528904,
    -0.1288737815209879,
    0.0329836539323885,
    0.9292868615863434,
    0.0361446663506424,
    0.0481771893596242,
    0.2642395317527308,
    0.6335478284694309,
    x,
    y,
    z,
  )
  let lc = f64_cbrt(l)
  let mc = f64_cbrt(m)
  let sc = f64_cbrt(s)
  mat3_mul(
    0.2104542683093140,
    0.7936177747023054,
    -0.0040720430116193,
    1.9779985324311684,
    -2.4285922420485799,
    0.4505937096174110,
    0.0259040424655478,
    0.7827717124575296,
    -0.8086757549230774,
    lc,
    mc,
    sc,
  )
}

fn oklab_to_xyz_d65(l_ok : Double, a_ok : Double, b_ok : Double) -> (Double, Double, Double) {
  let (lc, mc, sc) = mat3_mul(
    1.0,
    0.3963377773761749,
    0.2158037573099136,
    1.0,
    -0.1055613458156586,
    -0.0638541728258133,
    1.0,
    -0.0894841775298119,
    -1.2914855480194092,
    l_ok,
    a_ok,
    b_ok,
  )
  let l = lc * lc * lc
  let m = mc * mc * mc
  let s = sc * sc * sc
  mat3_mul(
    1.2268798758459243,
    -0.5578149944602171,
    0.2813910456659647,
    -0.0405757452148008,
    1.1122868032803170,
    -0.0717110580655164,
    -0.0763729366746601,
    -0.4214933324022432,
    1.5869240198367816,
    l,
    m,
    s,
  )
}

// === Polar Lab <-> Lch & Oklab <-> Oklch ===

fn rect_to_polar(l : Double, a : Double, b : Double, eps : Double) -> (Double, Double, Double, Bool) {
  let c = f64_sqrt(a * a + b * b)
  if c < eps {
    (l, 0.0, 0.0, true)
  } else {
    let h = f64_normalize_hue(rad_to_deg(f64_atan2(b, a)))
    (l, c, h, false)
  }
}

fn polar_to_rect(l : Double, c : Double, h : Double) -> (Double, Double, Double) {
  let rad = deg_to_rad(h)
  (l, c * f64_cos(rad), c * f64_sin(rad))
}

// === sRGB <-> HSL & HWB (CSS Color 4 §7 & §8) ===

fn hsl_to_srgb(h_in : Double, s_in : Double, l_in : Double) -> (Double, Double, Double) {
  let h = f64_normalize_hue(h_in)
  let s = s_in / 100.0
  let l = l_in / 100.0
  let a = s * f64_min(l, 1.0 - l)
  let f = fn(n : Double) -> Double {
    let k = f64_rem_euclid(n + h / 30.0, 12.0)
    l - a * f64_max(-1.0, f64_min(k - 3.0, f64_min(9.0 - k, 1.0)))
  }
  (f(0.0), f(8.0), f(4.0))
}

fn srgb_to_hsl(r : Double, g : Double, b : Double) -> (Double, Double, Double, Bool) {
  let mx = f64_max(r, f64_max(g, b))
  let mn = f64_min(r, f64_min(g, b))
  let d = mx - mn
  let l = (mx + mn) * 0.5
  let mut h = 0.0
  let mut s = 0.0
  let mut hue_missing = false
  if d == 0.0 {
    hue_missing = true
  } else {
    let denom = 1.0 - f64_abs(2.0 * l - 1.0)
    if denom == 0.0 {
      s = 0.0
      hue_missing = true
    } else {
      s = d / denom
      if mx == r {
        h = (g - b) / d + (if g < b { 6.0 } else { 0.0 })
      } else if mx == g {
        h = (b - r) / d + 2.0
      } else {
        h = (r - g) / d + 4.0
      }
      h = f64_normalize_hue(h * 60.0)
    }
  }
  if s < 0.0 {
    h = f64_normalize_hue(h + 180.0)
    s = -s
  }
  if f64_abs(s) < 1.0e-7 {
    hue_missing = true
  }
  (h, s * 100.0, l * 100.0, hue_missing)
}

fn hwb_to_srgb(h_in : Double, w_in : Double, b_in : Double) -> (Double, Double, Double) {
  let w = w_in / 100.0
  let b = b_in / 100.0
  if w + b >= 1.0 {
    let gray = w / (w + b)
    return (gray, gray, gray)
  }
  let (r0, g0, b0) = hsl_to_srgb(h_in, 100.0, 50.0)
  let scale = 1.0 - w - b
  (r0 * scale + w, g0 * scale + w, b0 * scale + w)
}

fn srgb_to_hwb(r : Double, g : Double, b : Double) -> (Double, Double, Double, Bool) {
  let mx = f64_max(r, f64_max(g, b))
  let mn = f64_min(r, f64_min(g, b))
  let d = mx - mn
  let mut h = 0.0
  let mut hue_missing = false
  if d == 0.0 {
    hue_missing = true
  } else {
    if mx == r {
      h = (g - b) / d + (if g < b { 6.0 } else { 0.0 })
    } else if mx == g {
      h = (b - r) / d + 2.0
    } else {
      h = (r - g) / d + 4.0
    }
    h = f64_normalize_hue(h * 60.0)
  }
  let white = mn * 100.0
  let black = (1.0 - mx) * 100.0
  if white + black >= 100.0 - 1.0e-7 {
    hue_missing = true
  }
  (h, white, black, hue_missing)
}

// === Hub conversions via XYZ-D65 ===

fn color_to_xyz_d65(c : Color) -> (Double, Double, Double) {
  let c0 = if c.m0 { 0.0 } else { c.c0 }
  let c1 = if c.m1 { 0.0 } else { c.c1 }
  let c2 = if c.m2 { 0.0 } else { c.c2 }
  match c.space {
    ColorSpace::Srgb => {
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2))
    }
    ColorSpace::SrgbLinear => lin_srgb_to_xyz_d65(c0, c1, c2)
    ColorSpace::DisplayP3 => {
      lin_p3_to_xyz_d65(srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2))
    }
    ColorSpace::A98Rgb => {
      lin_a98_to_xyz_d65(a98_to_linear_ch(c0), a98_to_linear_ch(c1), a98_to_linear_ch(c2))
    }
    ColorSpace::ProphotoRgb => {
      let (xd, yd, zd) = lin_prophoto_to_xyz_d50(
        prophoto_to_linear_ch(c0),
        prophoto_to_linear_ch(c1),
        prophoto_to_linear_ch(c2),
      )
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Rec2020 => {
      lin_rec2020_to_xyz_d65(
        rec2020_to_linear_ch(c0),
        rec2020_to_linear_ch(c1),
        rec2020_to_linear_ch(c2),
      )
    }
    ColorSpace::XyzD50 => xyz_d50_to_d65(c0, c1, c2)
    ColorSpace::XyzD65 => (c0, c1, c2)
    ColorSpace::Hsl => {
      let (r, g, b) = hsl_to_srgb(c0, c1, c2)
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(r), srgb_to_linear_ch(g), srgb_to_linear_ch(b))
    }
    ColorSpace::Hwb => {
      let (r, g, b) = hwb_to_srgb(c0, c1, c2)
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(r), srgb_to_linear_ch(g), srgb_to_linear_ch(b))
    }
    ColorSpace::Lab => {
      let (xd, yd, zd) = lab_to_xyz_d50(c0, c1, c2)
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Lch => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      let (xd, yd, zd) = lab_to_xyz_d50(l, a, b)
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Oklab => oklab_to_xyz_d65(c0, c1, c2)
    ColorSpace::Oklch => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      oklab_to_xyz_d65(l, a, b)
    }
  }
}

fn xyz_d65_to_space(x : Double, y : Double, z : Double, target : ColorSpace) -> (Double, Double, Double, Bool, Bool, Bool) {
  match target {
    ColorSpace::Srgb => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      (srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::SrgbLinear => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      (lr, lg, lb, false, false, false)
    }
    ColorSpace::DisplayP3 => {
      let (lr, lg, lb) = xyz_d65_to_lin_p3(x, y, z)
      (srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::A98Rgb => {
      let (lr, lg, lb) = xyz_d65_to_lin_a98(x, y, z)
      (a98_from_linear_ch(lr), a98_from_linear_ch(lg), a98_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::ProphotoRgb => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (lr, lg, lb) = xyz_d50_to_lin_prophoto(xd, yd, zd)
      (prophoto_from_linear_ch(lr), prophoto_from_linear_ch(lg), prophoto_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::Rec2020 => {
      let (lr, lg, lb) = xyz_d65_to_lin_rec2020(x, y, z)
      (rec2020_from_linear_ch(lr), rec2020_from_linear_ch(lg), rec2020_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::XyzD50 => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      (xd, yd, zd, false, false, false)
    }
    ColorSpace::XyzD65 => (x, y, z, false, false, false)
    ColorSpace::Hsl => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      let (h, s, l, hm) = srgb_to_hsl(srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb))
      (h, s, l, hm, false, false)
    }
    ColorSpace::Hwb => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      let (h, w, b, hm) = srgb_to_hwb(srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb))
      (h, w, b, hm, false, false)
    }
    ColorSpace::Lab => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (l, a, b) = xyz_d50_to_lab(xd, yd, zd)
      (l, a, b, false, false, false)
    }
    ColorSpace::Lch => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (l, a, b) = xyz_d50_to_lab(xd, yd, zd)
      let (lo, co, ho, hm) = rect_to_polar(l, a, b, 1.0e-4)
      (lo, co, ho, false, false, hm)
    }
    ColorSpace::Oklab => {
      let (l, a, b) = xyz_d65_to_oklab(x, y, z)
      (l, a, b, false, false, false)
    }
    ColorSpace::Oklch => {
      let (l, a, b) = xyz_d65_to_oklab(x, y, z)
      let (lo, co, ho, hm) = rect_to_polar(l, a, b, 1.0e-6)
      (lo, co, ho, false, false, hm)
    }
  }
}

// === CSS Color 4 §12.2 analogous missing-component categories ===
// Category tags: 1=R, 2=G, 3=B, 4=Lightness, 5=Colorfulness(C/S), 6=Hue, 7=OppA, 8=OppB
fn channel_category(space : ColorSpace, idx : Int) -> Int {
  match space {
    ColorSpace::Srgb
    | ColorSpace::SrgbLinear
    | ColorSpace::DisplayP3
    | ColorSpace::A98Rgb
    | ColorSpace::ProphotoRgb
    | ColorSpace::Rec2020 => {
      if idx == 0 { 1 } else if idx == 1 { 2 } else { 3 }
    }
    ColorSpace::Hsl => {
      if idx == 0 { 6 } else if idx == 1 { 5 } else { 4 }
    }
    ColorSpace::Hwb => {
      if idx == 0 { 6 } else { 0 }
    }
    ColorSpace::Lab | ColorSpace::Oklab => {
      if idx == 0 { 4 } else if idx == 1 { 7 } else { 8 }
    }
    ColorSpace::Lch | ColorSpace::Oklch => {
      if idx == 0 { 4 } else if idx == 1 { 5 } else { 6 }
    }
    ColorSpace::XyzD50 | ColorSpace::XyzD65 => 0
  }
}

fn carry_missing(src : Color, target : ColorSpace, dm0 : Bool, dm1 : Bool, dm2 : Bool) -> (Bool, Bool, Bool) {
  let mut m0 = dm0
  let mut m1 = dm1
  let mut m2 = dm2
  let t0 = channel_category(target, 0)
  let t1 = channel_category(target, 1)
  let t2 = channel_category(target, 2)
  if src.m0 {
    let sc = channel_category(src.space, 0)
    if sc != 0 {
      if t0 == sc { m0 = true }
      if t1 == sc { m1 = true }
      if t2 == sc { m2 = true }
    }
  }
  if src.m1 {
    let sc = channel_category(src.space, 1)
    if sc != 0 {
      if t0 == sc { m0 = true }
      if t1 == sc { m1 = true }
      if t2 == sc { m2 = true }
    }
  }
  if src.m2 {
    let sc = channel_category(src.space, 2)
    if sc != 0 {
      if t0 == sc { m0 = true }
      if t1 == sc { m1 = true }
      if t2 == sc { m2 = true }
    }
  }
  (m0, m1, m2)
}

///| Convert a color to `target` color space without gamut clipping.
pub fn Color::convert(self : Color, target : ColorSpace) -> Color {
  if self.space.eq(target) {
    return self
  }
  // Fast direct paths that avoid XYZ round-trip precision loss
  let (r0, r1, r2, dm0, dm1, dm2) = match (self.space, target) {
    (ColorSpace::Srgb, ColorSpace::SrgbLinear) => {
      (srgb_to_linear_ch(self.c0), srgb_to_linear_ch(self.c1), srgb_to_linear_ch(self.c2), false, false, false)
    }
    (ColorSpace::SrgbLinear, ColorSpace::Srgb) => {
      (srgb_from_linear_ch(self.c0), srgb_from_linear_ch(self.c1), srgb_from_linear_ch(self.c2), false, false, false)
    }
    (ColorSpace::Srgb, ColorSpace::Hsl) => {
      let (h, s, l, hm) = srgb_to_hsl(self.c0, self.c1, self.c2)
      (h, s, l, hm, false, false)
    }
    (ColorSpace::Hsl, ColorSpace::Srgb) => {
      let (r, g, b) = hsl_to_srgb(self.c0, self.c1, self.c2)
      (r, g, b, false, false, false)
    }
    (ColorSpace::Srgb, ColorSpace::Hwb) => {
      let (h, w, b, hm) = srgb_to_hwb(self.c0, self.c1, self.c2)
      (h, w, b, hm, false, false)
    }
    (ColorSpace::Hwb, ColorSpace::Srgb) => {
      let (r, g, b) = hwb_to_srgb(self.c0, self.c1, self.c2)
      (r, g, b, false, false, false)
    }
    (ColorSpace::Lab, ColorSpace::Lch) => {
      let (l, c, h, hm) = rect_to_polar(self.c0, self.c1, self.c2, 1.0e-4)
      (l, c, h, false, false, hm)
    }
    (ColorSpace::Lch, ColorSpace::Lab) => {
      let (l, a, b) = polar_to_rect(self.c0, self.c1, self.c2)
      (l, a, b, false, false, false)
    }
    (ColorSpace::Oklab, ColorSpace::Oklch) => {
      let (l, c, h, hm) = rect_to_polar(self.c0, self.c1, self.c2, 1.0e-6)
      (l, c, h, false, false, hm)
    }
    (ColorSpace::Oklch, ColorSpace::Oklab) => {
      let (l, a, b) = polar_to_rect(self.c0, self.c1, self.c2)
      (l, a, b, false, false, false)
    }
    (ColorSpace::Lab, ColorSpace::XyzD50) => {
      let (x, y, z) = lab_to_xyz_d50(self.c0, self.c1, self.c2)
      (x, y, z, false, false, false)
    }
    (ColorSpace::XyzD50, ColorSpace::Lab) => {
      let (l, a, b) = xyz_d50_to_lab(self.c0, self.c1, self.c2)
      (l, a, b, false, false, false)
    }
    _ => {
      let (x, y, z) = color_to_xyz_d65(self)
      xyz_d65_to_space(x, y, z, target)
    }
  }
  let (m0, m1, m2) = carry_missing(self, target, dm0, dm1, dm2)
  Color::new_with_missing(target, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
}

fn is_bounded_rgb_space(space : ColorSpace) -> Bool {
  match space {
    ColorSpace::Srgb
    | ColorSpace::SrgbLinear
    | ColorSpace::DisplayP3
    | ColorSpace::A98Rgb
    | ColorSpace::ProphotoRgb
    | ColorSpace::Rec2020 => true
    _ => false
  }
}

fn in_unit_gamut(c0 : Double, c1 : Double, c2 : Double) -> Bool {
  c0 >= 0.0 && c0 <= 1.0 && c1 >= 0.0 && c1 <= 1.0 && c2 >= 0.0 && c2 <= 1.0
}

///| Returns true if the color is within the `[0, 1]` gamut of its bounded RGB space (always true for unbounded spaces).
pub fn Color::in_gamut(self : Color) -> Bool {
  if is_bounded_rgb_space(self.space) {
    in_unit_gamut(self.c0, self.c1, self.c2)
  } else if self.space.eq(ColorSpace::Hsl) || self.space.eq(ColorSpace::Hwb) {
    let s = self.convert(ColorSpace::Srgb)
    in_unit_gamut(s.c0, s.c1, s.c2)
  } else {
    true
  }
}

fn delta_e_ok(c1 : Color, c2 : Color) -> Double {
  let o1 = c1.convert(ColorSpace::Oklab)
  let o2 = c2.convert(ColorSpace::Oklab)
  let dl = o1.c0 - o2.c0
  let da = o1.c1 - o2.c1
  let db = o1.c2 - o2.c2
  f64_sqrt(dl * dl + da * da + db * db)
}

fn clip_rgb(c : Color) -> Color {
  Color::new_with_missing(
    c.space,
    f64_clamp01(c.c0),
    f64_clamp01(c.c1),
    f64_clamp01(c.c2),
    c.alpha,
    c.m0,
    c.m1,
    c.m2,
    c.ma,
  )
}

///| Map a color into the gamut of `target` using W3C CSS Color 4 §13.2 Oklch binary search.
pub fn Color::to_gamut(self : Color, target : ColorSpace) -> Color {
  if !is_bounded_rgb_space(target) && !target.eq(ColorSpace::Hsl) && !target.eq(ColorSpace::Hwb) {
    return self.convert(target)
  }
  let rgb_target = if target.eq(ColorSpace::Hsl) || target.eq(ColorSpace::Hwb) {
    ColorSpace::Srgb
  } else {
    target
  }
  let direct = self.convert(rgb_target)
  if in_unit_gamut(direct.c0, direct.c1, direct.c2) {
    return if target.eq(rgb_target) { direct } else { direct.convert(target) }
  }
  let ok = self.convert(ColorSpace::Oklch)
  let l = ok.c0
  if l >= 1.0 {
    let w = Color::new_with_missing(rgb_target, 1.0, 1.0, 1.0, self.alpha, false, false, false, self.ma)
    return if target.eq(rgb_target) { w } else { w.convert(target) }
  }
  if l <= 0.0 {
    let k = Color::new_with_missing(rgb_target, 0.0, 0.0, 0.0, self.alpha, false, false, false, self.ma)
    return if target.eq(rgb_target) { k } else { k.convert(target) }
  }
  let jnd = 0.02
  let eps = 0.00001
  let mut lo = 0.0
  let mut hi = ok.c1
  let h = ok.c2
  let mut min_in_gamut = true
  let mut clipped = clip_rgb(direct)
  let mut iter = 0
  while hi - lo > eps && iter < 64 {
    let mid = (lo + hi) * 0.5
    let cand = Color::new_with_missing(ColorSpace::Oklch, l, mid, h, self.alpha, false, false, ok.m2, self.ma)
    let dest = cand.convert(rgb_target)
    if min_in_gamut && in_unit_gamut(dest.c0, dest.c1, dest.c2) {
      lo = mid
    } else {
      clipped = clip_rgb(dest)
      let e = delta_e_ok(clipped, cand)
      if e < jnd {
        if jnd - e < eps {
          break
        }
        min_in_gamut = false
        lo = mid
      } else {
        hi = mid
      }
    }
    iter = iter + 1
  }
  let final_rgb = if min_in_gamut {
    clip_rgb(
      Color::new_with_missing(ColorSpace::Oklch, l, lo, h, self.alpha, false, false, ok.m2, self.ma).convert(
        rgb_target,
      ),
    )
  } else {
    clipped
  }
  if target.eq(rgb_target) {
    final_rgb
  } else {
    final_rgb.convert(target)
  }
}
