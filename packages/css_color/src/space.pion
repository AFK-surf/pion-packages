///| Exact W3C CSS Color Module Level 4 color space conversions and §13.2 Oklch gamut mapping.
///| Exact Bradford D65 <-> D50 adaptation, exact Ottosson/CSS Color 4 Oklab matrices,
///| extended-range transfer functions, and CSS Color 4 §4.4 / §12.2 missing-component carry-forward.

// === Transfer functions (extended-range, sign-preserving) ===

let inv_12_92 : Double = 1.0 / 12.92
let inv_1_055 : Double = 1.0 / 1.055
let inv_2_4 : Double = 1.0 / 2.4

fn srgb_to_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    let av = -v
    if av <= 0.04045 {
      v * inv_12_92
    } else if av < 1.0 {
      let u = (av + 0.055) * inv_1_055
      let r = u.sqrt().sqrt()
      let r2 = r * r
      let r4 = r2 * r2
      let r8 = r4 * r4
      let a0 = -0.004451682013358505 + r * 0.1597296558090814
      let a1 = 1.444130080638496 + r * -1.4670797264393196
      let a2 = 1.987894869765186 + r * -2.22505770740102
      let a3 = 1.8848815754114607 + r * -1.1494309879360696
      let a4 = 0.4742476526126379 + r * -0.11834196726351631 + r2 * 0.013478236817247793
      -(u * u * ((a0 + r2 * a1) + r4 * (a2 + r2 * a3) + r8 * a4))
    } else if av == 1.0 {
      -1.0
    } else {
      -f64_pow_pos((av + 0.055) * inv_1_055, 2.4)
    }
  } else {
    if v <= 0.04045 {
      v * inv_12_92
    } else if v < 1.0 {
      let u = (v + 0.055) * inv_1_055
      let r = u.sqrt().sqrt()
      let r2 = r * r
      let r4 = r2 * r2
      let r8 = r4 * r4
      let a0 = -0.004451682013358505 + r * 0.1597296558090814
      let a1 = 1.444130080638496 + r * -1.4670797264393196
      let a2 = 1.987894869765186 + r * -2.22505770740102
      let a3 = 1.8848815754114607 + r * -1.1494309879360696
      let a4 = 0.4742476526126379 + r * -0.11834196726351631 + r2 * 0.013478236817247793
      u * u * ((a0 + r2 * a1) + r4 * (a2 + r2 * a3) + r8 * a4)
    } else if v == 1.0 {
      1.0
    } else {
      f64_pow_pos((v + 0.055) * inv_1_055, 2.4)
    }
  }
}

fn srgb_from_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    let av = -v
    if av <= 0.0031308 {
      12.92 * v
    } else if av < 1.0 {
      let q = av.sqrt().sqrt()
      let q2 = q * q
      let g0 = (0.3595174749219338 + q * 1.4024867988131118) + q2 * (-1.5364200193691944 + q * 1.1022826924537896 + q2 * -0.328003917294634)
      let t = g0 * g0 * g0
      let g = g0 * (t + 2.0 * q) / (2.0 * t + q)
      -(1.055 * (q * g * g) - 0.055)
    } else if av == 1.0 {
      -1.0
    } else {
      -(1.055 * f64_pow_pos(av, inv_2_4) - 0.055)
    }
  } else {
    if v <= 0.0031308 {
      12.92 * v
    } else if v < 1.0 {
      let q = v.sqrt().sqrt()
      let q2 = q * q
      let g0 = (0.3595174749219338 + q * 1.4024867988131118) + q2 * (-1.5364200193691944 + q * 1.1022826924537896 + q2 * -0.328003917294634)
      let t = g0 * g0 * g0
      let g = g0 * (t + 2.0 * q) / (2.0 * t + q)
      1.055 * (q * g * g) - 0.055
    } else if v == 1.0 {
      1.0
    } else {
      1.055 * f64_pow_pos(v, inv_2_4) - 0.055
    }
  }
}

fn a98_to_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    -f64_pow_pos(-v, 563.0 / 256.0)
  } else if v == 0.0 {
    0.0
  } else {
    f64_pow_pos(v, 563.0 / 256.0)
  }
}

fn a98_from_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    -f64_pow_pos(-v, 256.0 / 563.0)
  } else if v == 0.0 {
    0.0
  } else {
    f64_pow_pos(v, 256.0 / 563.0)
  }
}

fn prophoto_to_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    let av = -v
    if av <= 16.0 / 512.0 {
      v * 0.0625
    } else {
      -f64_pow_pos(av, 1.8)
    }
  } else {
    if v <= 16.0 / 512.0 {
      v * 0.0625
    } else {
      f64_pow_pos(v, 1.8)
    }
  }
}

fn prophoto_from_linear_ch(v : Double) -> Double {
  if v < 0.0 {
    let av = -v
    if av >= 1.0 / 512.0 {
      -f64_pow_pos(av, 1.0 / 1.8)
    } else {
      16.0 * v
    }
  } else {
    if v >= 1.0 / 512.0 {
      f64_pow_pos(v, 1.0 / 1.8)
    } else {
      16.0 * v
    }
  }
}

fn rec2020_to_linear_ch(v : Double) -> Double {
  let alpha = 1.09929682680944
  let beta45 = 0.018053968510807 * 4.5
  if v < 0.0 {
    let av = -v
    if av < beta45 {
      v / 4.5
    } else {
      -f64_pow_pos((av + (alpha - 1.0)) / alpha, 1.0 / 0.45)
    }
  } else {
    if v < beta45 {
      v / 4.5
    } else {
      f64_pow_pos((v + (alpha - 1.0)) / alpha, 1.0 / 0.45)
    }
  }
}

fn rec2020_from_linear_ch(v : Double) -> Double {
  let alpha = 1.09929682680944
  let beta = 0.018053968510807
  if v < 0.0 {
    let av = -v
    if av > beta {
      -(alpha * f64_pow_pos(av, 0.45) - (alpha - 1.0))
    } else {
      4.5 * v
    }
  } else {
    if v > beta {
      alpha * f64_pow_pos(v, 0.45) - (alpha - 1.0)
    } else {
      4.5 * v
    }
  }
}

// === Bradford D65 <-> D50 ===

fn xyz_d65_to_d50(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    1.0479297925449966 * x + 0.022946870601609527 * y + -0.050192266289205194 * z,
    0.029627808770055674 * x + 0.99043442675388 * y + -0.01707379906341879 * z,
    -0.009243040646204521 * x + 0.015055191490298164 * y + 0.751874281428137 * z,
  )
}

fn xyz_d50_to_d65(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    0.9554734214880752 * x + -0.023098454948764523 * y + 0.06325924320057066 * z,
    -0.028369709333863583 * x + 1.0099953980813041 * y + 0.021041441191917306 * z,
    0.012314014864481996 * x + -0.02050764929889898 * y + 1.330365926242124 * z,
  )
}

// === Linear RGB <-> XYZ ===

fn lin_srgb_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  (
    0.41239079926595934 * r + 0.357584339383878 * g + 0.1804807884018343 * b,
    0.21263900587151027 * r + 0.715168678767756 * g + 0.07219231536073371 * b,
    0.01933081871559182 * r + 0.11919477979462598 * g + 0.9505321522496607 * b,
  )
}

fn xyz_d65_to_lin_srgb(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    3.2409699419045226 * x + -1.537383177570094 * y + -0.4986107602930034 * z,
    -0.9692436362808796 * x + 1.8759675015077202 * y + 0.04155505740717559 * z,
    0.05563007969699366 * x + -0.20397695888897652 * y + 1.0569715142428786 * z,
  )
}

fn lin_p3_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  (
    0.4865709486482162 * r + 0.26566769316909306 * g + 0.1982172852343625 * b,
    0.2289745640697488 * r + 0.6917385218365064 * g + 0.079286914093745 * b,
    0.04511338185890264 * g + 1.043944368900976 * b,
  )
}

fn xyz_d65_to_lin_p3(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    2.493496911941425 * x + -0.9313836179191239 * y + -0.40271078445071684 * z,
    -0.8294889695615747 * x + 1.7626640603183463 * y + 0.023624685841943577 * z,
    0.03584583024378447 * x + -0.07617238926804182 * y + 0.9568845240076872 * z,
  )
}

fn lin_a98_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  (
    0.5766690429101305 * r + 0.1855582379065463 * g + 0.1882286462349947 * b,
    0.29734497525053605 * r + 0.6273635662554661 * g + 0.07529145849399788 * b,
    0.02703136138641234 * r + 0.07068885253582723 * g + 0.9913375368376388 * b,
  )
}

fn xyz_d65_to_lin_a98(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    2.0415879038107465 * x + -0.5650069742788596 * y + -0.34473135077832956 * z,
    -0.9692436362808795 * x + 1.8759675015077206 * y + 0.04155505740717557 * z,
    0.013444280632031142 * x + -0.11836239223101838 * y + 1.0151749943912054 * z,
  )
}

fn lin_prophoto_to_xyz_d50(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  (
    0.7977666449006423 * r + 0.13518129740053308 * g + 0.0313477341283922 * b,
    0.2880748288194013 * r + 0.711835234241873 * g + 8.99369387256457e-05 * b,
    0.8251046025104602 * b,
  )
}

fn xyz_d50_to_lin_prophoto(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    1.3457868816471583 * x + -0.25557208737979464 * y + -0.05110186497554526 * z,
    -0.5446307051249019 * x + 1.5082477428451468 * y + 0.020527447436421393 * z,
    1.2119675456389452 * z,
  )
}

fn lin_rec2020_to_xyz_d65(r : Double, g : Double, b : Double) -> (Double, Double, Double) {
  (
    0.6369580483012914 * r + 0.14461690358620832 * g + 0.1688809751641721 * b,
    0.2627002120112671 * r + 0.6779980715188708 * g + 0.05930171646986196 * b,
    0.028072693049087428 * g + 1.060985057710791 * b,
  )
}

fn xyz_d65_to_lin_rec2020(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  (
    1.7166511879712674 * x + -0.35567078377639233 * y + -0.25336628137365974 * z,
    -0.6666843518324892 * x + 1.6164812366349395 * y + 0.01576854581391113 * z,
    0.017639857445310783 * x + -0.042770613257808524 * y + 0.9421031212354738 * z,
  )
}

// === CIE Lab <-> XYZ-D50 ===

let d50_x : Double = 0.3457 / 0.3585
let d50_y : Double = 1.0
let d50_z : Double = (1.0 - 0.3457 - 0.3585) / 0.3585
let inv_d50_x : Double = 0.3585 / 0.3457
let inv_d50_z : Double = 0.3585 / (1.0 - 0.3457 - 0.3585)
let lab_kappa : Double = 24389.0 / 27.0
let inv_lab_kappa : Double = 27.0 / 24389.0
let lab_epsilon : Double = 216.0 / 24389.0
let inv_116 : Double = 1.0 / 116.0

fn xyz_d50_rel_to_lab(xr : Double, yr : Double, zr : Double) -> (Double, Double, Double) {
  let fx = if xr > lab_epsilon { f64_cbrt(xr) } else { (lab_kappa * xr + 16.0) * inv_116 }
  let fy = if yr > lab_epsilon { f64_cbrt(yr) } else { (lab_kappa * yr + 16.0) * inv_116 }
  let fz = if zr > lab_epsilon { f64_cbrt(zr) } else { (lab_kappa * zr + 16.0) * inv_116 }
  (116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz))
}

fn xyz_d50_to_lab(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  xyz_d50_rel_to_lab(x * inv_d50_x, y, z * inv_d50_z)
}

fn lab_to_xyz_d50_rel(l : Double, a : Double, b : Double) -> (Double, Double, Double) {
  let fy = (l + 16.0) * inv_116
  let fx = a * 0.002 + fy
  let fz = fy - b * 0.005
  let fx3 = fx * fx * fx
  let fz3 = fz * fz * fz
  let xr = if fx3 > lab_epsilon { fx3 } else { (116.0 * fx - 16.0) * inv_lab_kappa }
  let yr = if l > 8.0 { fy * fy * fy } else { l * inv_lab_kappa }
  let zr = if fz3 > lab_epsilon { fz3 } else { (116.0 * fz - 16.0) * inv_lab_kappa }
  (xr, yr, zr)
}

fn lab_to_xyz_d50(l : Double, a : Double, b : Double) -> (Double, Double, Double) {
  let (xr, yr, zr) = lab_to_xyz_d50_rel(l, a, b)
  (xr * d50_x, yr, zr * d50_z)
}

// === Oklab <-> XYZ-D65 (CSS Color 4 §18 exact matrices) ===

fn lms_cbrt_to_oklab(l : Double, m : Double, s : Double) -> (Double, Double, Double) {
  let lc = f64_cbrt(l)
  let mc = f64_cbrt(m)
  let sc = f64_cbrt(s)
  (
    0.2104542683093140 * lc + 0.7936177747023054 * mc + -0.0040720430116193 * sc,
    1.9779985324311684 * lc + -2.4285922420485799 * mc + 0.4505937096174110 * sc,
    0.0259040424655478 * lc + 0.7827717124575296 * mc + -0.8086757549230774 * sc,
  )
}

fn xyz_d65_to_oklab(x : Double, y : Double, z : Double) -> (Double, Double, Double) {
  let l = 0.8190224379967030 * x + 0.3619062600528904 * y + -0.1288737815209879 * z
  let m = 0.0329836539323885 * x + 0.9292868615863434 * y + 0.0361446663506424 * z
  let s = 0.0481771893596242 * x + 0.2642395317527308 * y + 0.6335478284694309 * z
  lms_cbrt_to_oklab(l, m, s)
}

fn oklab_to_lms(l_ok : Double, a_ok : Double, b_ok : Double) -> (Double, Double, Double) {
  let lc = l_ok + 0.3963377773761749 * a_ok + 0.2158037573099136 * b_ok
  let mc = l_ok + -0.1055613458156586 * a_ok + -0.0638541728258133 * b_ok
  let sc = l_ok + -0.0894841775298119 * a_ok + -1.2914855480194092 * b_ok
  (lc * lc * lc, mc * mc * mc, sc * sc * sc)
}

fn oklab_to_xyz_d65(l_ok : Double, a_ok : Double, b_ok : Double) -> (Double, Double, Double) {
  let (l, m, s) = oklab_to_lms(l_ok, a_ok, b_ok)
  (
    1.2268798758459243 * l + -0.5578149944602171 * m + 0.2813910456659647 * s,
    -0.0405757452148008 * l + 1.1122868032803170 * m + -0.0717110580655164 * s,
    -0.0763729366746601 * l + -0.4214933324022432 * m + 1.5869240198367816 * s,
  )
}

// === Polar Lab <-> Lch & Oklab <-> Oklch ===

fn rect_to_polar(l : Double, a : Double, b : Double, eps : Double) -> (Double, Double, Double, Bool) {
  let c = f64_sqrt(a * a + b * b)
  if c <= eps {
    (l, 0.0, 0.0, true)
  } else {
    let deg = rad_to_deg(f64_atan2(b, a))
    let h = if deg < 0.0 { deg + 360.0 } else { deg }
    (l, c, if h >= 360.0 || h < 0.0 { 0.0 } else { h }, false)
  }
}

fn polar_to_rect(l : Double, c : Double, h : Double) -> (Double, Double, Double) {
  let (sn, cs) = f64_sincos(deg_to_rad(h))
  (l, c * cs, c * sn)
}

// === sRGB <-> HSL & HWB (CSS Color 4 §7 & §8) ===

fn hsl_to_srgb(h_in : Double, s_in : Double, l_in : Double) -> (Double, Double, Double) {
  let h = f64_normalize_hue(h_in)
  let s = s_in / 100.0
  let l = l_in / 100.0
  let a = s * f64_min(l, 1.0 - l)
  let f = fn(n : Double) -> Double {
    let k = f64_rem_euclid(n + h / 30.0, 12.0)
    l - a * f64_max(-1.0, f64_min(k - 3.0, f64_min(9.0 - k, 1.0)))
  }
  (f(0.0), f(8.0), f(4.0))
}

fn srgb_to_hsl(r : Double, g : Double, b : Double) -> (Double, Double, Double, Bool) {
  let mx = f64_max(r, f64_max(g, b))
  let mn = f64_min(r, f64_min(g, b))
  let d = mx - mn
  let l = (mx + mn) * 0.5
  let mut h = 0.0
  let mut s = 0.0
  let mut hue_missing = false
  if d == 0.0 {
    hue_missing = true
  } else {
    let denom = 1.0 - f64_abs(2.0 * l - 1.0)
    if f64_abs(l) <= 0.00001 || f64_abs(1.0 - l) < 0.00001 || denom == 0.0 {
      s = 0.0
      hue_missing = true
    } else {
      s = d / denom
      if mx == r {
        h = (g - b) / d + (if g < b { 6.0 } else { 0.0 })
      } else if mx == g {
        h = (b - r) / d + 2.0
      } else {
        h = (r - g) / d + 4.0
      }
      h = f64_normalize_hue(h * 60.0)
    }
  }
  if s < 0.0 {
    h = f64_normalize_hue(h + 180.0)
    s = -s
  }
  if s <= 0.00001 {
    hue_missing = true
    s = 0.0
  }
  if s != s {
    s = Double::from_bits(0x7ff8000000000000L)
  }
  (h, s * 100.0, l * 100.0, hue_missing)
}

fn hwb_to_srgb(h_in : Double, w_in : Double, b_in : Double) -> (Double, Double, Double) {
  let w = w_in / 100.0
  let b = b_in / 100.0
  if w + b >= 1.0 {
    let gray = w / (w + b)
    return (gray, gray, gray)
  }
  let (r0, g0, b0) = hsl_to_srgb(h_in, 100.0, 50.0)
  let scale = 1.0 - w - b
  (r0 * scale + w, g0 * scale + w, b0 * scale + w)
}

fn srgb_to_hwb(r : Double, g : Double, b : Double) -> (Double, Double, Double, Bool) {
  let mx = f64_max(r, f64_max(g, b))
  let mn = f64_min(r, f64_min(g, b))
  let d = mx - mn
  let mut h = 0.0
  let mut hue_missing = false
  if d == 0.0 {
    hue_missing = true
  } else {
    if mx == r {
      h = (g - b) / d + (if g < b { 6.0 } else { 0.0 })
    } else if mx == g {
      h = (b - r) / d + 2.0
    } else {
      h = (r - g) / d + 4.0
    }
    h = f64_normalize_hue(h * 60.0)
  }
  let white = mn * 100.0
  let black = (1.0 - mx) * 100.0
  if white + black >= 100.0 - 0.001 {
    hue_missing = true
  }
  (h, white, black, hue_missing)
}

// === Hub conversions via XYZ-D65 ===

fn color_to_xyz_d65(c : Color) -> (Double, Double, Double) {
  let c0 = if c.m0 { 0.0 } else { c.c0 }
  let c1 = if c.m1 { 0.0 } else { c.c1 }
  let c2 = if c.m2 { 0.0 } else { c.c2 }
  match c.space {
    ColorSpace::Srgb => {
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2))
    }
    ColorSpace::SrgbLinear => lin_srgb_to_xyz_d65(c0, c1, c2)
    ColorSpace::DisplayP3 => {
      lin_p3_to_xyz_d65(srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2))
    }
    ColorSpace::DisplayP3Linear => lin_p3_to_xyz_d65(c0, c1, c2)
    ColorSpace::A98Rgb => {
      lin_a98_to_xyz_d65(a98_to_linear_ch(c0), a98_to_linear_ch(c1), a98_to_linear_ch(c2))
    }
    ColorSpace::ProphotoRgb => {
      let (xd, yd, zd) = lin_prophoto_to_xyz_d50(
        prophoto_to_linear_ch(c0),
        prophoto_to_linear_ch(c1),
        prophoto_to_linear_ch(c2),
      )
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Rec2020 => {
      lin_rec2020_to_xyz_d65(
        rec2020_to_linear_ch(c0),
        rec2020_to_linear_ch(c1),
        rec2020_to_linear_ch(c2),
      )
    }
    ColorSpace::XyzD50 => xyz_d50_to_d65(c0, c1, c2)
    ColorSpace::XyzD65 => (c0, c1, c2)
    ColorSpace::Hsl => {
      let (r, g, b) = hsl_to_srgb(c0, c1, c2)
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(r), srgb_to_linear_ch(g), srgb_to_linear_ch(b))
    }
    ColorSpace::Hwb => {
      let (r, g, b) = hwb_to_srgb(c0, c1, c2)
      lin_srgb_to_xyz_d65(srgb_to_linear_ch(r), srgb_to_linear_ch(g), srgb_to_linear_ch(b))
    }
    ColorSpace::Lab => {
      let (xd, yd, zd) = lab_to_xyz_d50(c0, c1, c2)
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Lch => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      let (xd, yd, zd) = lab_to_xyz_d50(l, a, b)
      xyz_d50_to_d65(xd, yd, zd)
    }
    ColorSpace::Oklab => oklab_to_xyz_d65(c0, c1, c2)
    ColorSpace::Oklch => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      oklab_to_xyz_d65(l, a, b)
    }
  }
}

fn xyz_d65_to_space(x : Double, y : Double, z : Double, target : ColorSpace) -> (Double, Double, Double, Bool, Bool, Bool) {
  match target {
    ColorSpace::Srgb => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      (srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::SrgbLinear => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      (lr, lg, lb, false, false, false)
    }
    ColorSpace::DisplayP3 => {
      let (lr, lg, lb) = xyz_d65_to_lin_p3(x, y, z)
      (srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::DisplayP3Linear => {
      let (lr, lg, lb) = xyz_d65_to_lin_p3(x, y, z)
      (lr, lg, lb, false, false, false)
    }
    ColorSpace::A98Rgb => {
      let (lr, lg, lb) = xyz_d65_to_lin_a98(x, y, z)
      (a98_from_linear_ch(lr), a98_from_linear_ch(lg), a98_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::ProphotoRgb => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (lr, lg, lb) = xyz_d50_to_lin_prophoto(xd, yd, zd)
      (prophoto_from_linear_ch(lr), prophoto_from_linear_ch(lg), prophoto_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::Rec2020 => {
      let (lr, lg, lb) = xyz_d65_to_lin_rec2020(x, y, z)
      (rec2020_from_linear_ch(lr), rec2020_from_linear_ch(lg), rec2020_from_linear_ch(lb), false, false, false)
    }
    ColorSpace::XyzD50 => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      (xd, yd, zd, false, false, false)
    }
    ColorSpace::XyzD65 => (x, y, z, false, false, false)
    ColorSpace::Hsl => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      let (h, s, l, hm) = srgb_to_hsl(srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb))
      (h, s, l, hm, false, false)
    }
    ColorSpace::Hwb => {
      let (lr, lg, lb) = xyz_d65_to_lin_srgb(x, y, z)
      let (h, w, b, hm) = srgb_to_hwb(srgb_from_linear_ch(lr), srgb_from_linear_ch(lg), srgb_from_linear_ch(lb))
      (h, w, b, hm, false, false)
    }
    ColorSpace::Lab => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (l, a, b) = xyz_d50_to_lab(xd, yd, zd)
      (l, a, b, false, false, false)
    }
    ColorSpace::Lch => {
      let (xd, yd, zd) = xyz_d65_to_d50(x, y, z)
      let (l, a, b) = xyz_d50_to_lab(xd, yd, zd)
      let (lo, co, ho, hm) = rect_to_polar(l, a, b, 0.0015)
      (lo, co, ho, false, false, hm)
    }
    ColorSpace::Oklab => {
      let (l, a, b) = xyz_d65_to_oklab(x, y, z)
      (l, a, b, false, false, false)
    }
    ColorSpace::Oklch => {
      let (l, a, b) = xyz_d65_to_oklab(x, y, z)
      let (lo, co, ho, hm) = rect_to_polar(l, a, b, 0.000004)
      (lo, co, ho, false, false, hm)
    }
  }
}

// === Direct D50 hub (avoids D50 -> D65 -> D50 Bradford round-trip error) ===

fn is_d50_space(space : ColorSpace) -> Bool {
  match space {
    ColorSpace::XyzD50 | ColorSpace::Lab | ColorSpace::Lch | ColorSpace::ProphotoRgb => true
    _ => false
  }
}

fn color_to_xyz_d50(c : Color) -> (Double, Double, Double) {
  let c0 = if c.m0 { 0.0 } else { c.c0 }
  let c1 = if c.m1 { 0.0 } else { c.c1 }
  let c2 = if c.m2 { 0.0 } else { c.c2 }
  match c.space {
    ColorSpace::XyzD50 => (c0, c1, c2)
    ColorSpace::Lab => lab_to_xyz_d50(c0, c1, c2)
    ColorSpace::Lch => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      lab_to_xyz_d50(l, a, b)
    }
    _ => {
      lin_prophoto_to_xyz_d50(
        prophoto_to_linear_ch(c0),
        prophoto_to_linear_ch(c1),
        prophoto_to_linear_ch(c2),
      )
    }
  }
}

fn xyz_d50_to_space(x : Double, y : Double, z : Double, target : ColorSpace) -> (Double, Double, Double, Bool, Bool, Bool) {
  match target {
    ColorSpace::XyzD50 => (x, y, z, false, false, false)
    ColorSpace::Lab => {
      let (l, a, b) = xyz_d50_to_lab(x, y, z)
      (l, a, b, false, false, false)
    }
    ColorSpace::Lch => {
      let (l, a, b) = xyz_d50_to_lab(x, y, z)
      let (lo, co, ho, hm) = rect_to_polar(l, a, b, 0.0015)
      (lo, co, ho, false, false, hm)
    }
    _ => {
      let (lr, lg, lb) = xyz_d50_to_lin_prophoto(x, y, z)
      (prophoto_from_linear_ch(lr), prophoto_from_linear_ch(lg), prophoto_from_linear_ch(lb), false, false, false)
    }
  }
}

// === CSS Color 4 §12.2 analogous missing-component categories ===
// Category tags: 1=R/X, 2=G/Y, 3=B/Z, 4=Lightness, 5=Colorfulness(C/S), 6=Hue, 7=OppA, 8=OppB
fn channel_category(space : ColorSpace, idx : Int) -> Int {
  match space {
    ColorSpace::Srgb
    | ColorSpace::SrgbLinear
    | ColorSpace::DisplayP3
    | ColorSpace::DisplayP3Linear
    | ColorSpace::A98Rgb
    | ColorSpace::ProphotoRgb
    | ColorSpace::Rec2020
    | ColorSpace::XyzD50
    | ColorSpace::XyzD65 => {
      if idx == 0 { 1 } else if idx == 1 { 2 } else { 3 }
    }
    ColorSpace::Hsl => {
      if idx == 0 { 6 } else if idx == 1 { 5 } else { 4 }
    }
    ColorSpace::Hwb => {
      if idx == 0 { 6 } else { 0 }
    }
    ColorSpace::Lab | ColorSpace::Oklab => {
      if idx == 0 { 4 } else if idx == 1 { 7 } else { 8 }
    }
    ColorSpace::Lch | ColorSpace::Oklch => {
      if idx == 0 { 4 } else if idx == 1 { 5 } else { 6 }
    }
  }
}

fn carry_missing(src : Color, target : ColorSpace, dm0 : Bool, dm1 : Bool, dm2 : Bool) -> (Bool, Bool, Bool) {
  if !src.m0 && !src.m1 && !src.m2 {
    return (dm0, dm1, dm2)
  }
  let mut m0 = dm0
  let mut m1 = dm1
  let mut m2 = dm2
  let t0 = channel_category(target, 0)
  let t1 = channel_category(target, 1)
  let t2 = channel_category(target, 2)
  let s0 = channel_category(src.space, 0)
  let s1 = channel_category(src.space, 1)
  let s2 = channel_category(src.space, 2)
  if src.m0 && s0 != 0 {
    if t0 == s0 { m0 = true }
    if t1 == s0 { m1 = true }
    if t2 == s0 { m2 = true }
  }
  if src.m1 && s1 != 0 {
    if t0 == s1 { m0 = true }
    if t1 == s1 { m1 = true }
    if t2 == s1 { m2 = true }
  }
  if src.m2 && s2 != 0 {
    if t0 == s2 { m0 = true }
    if t1 == s2 { m1 = true }
    if t2 == s2 { m2 = true }
  }
  // Analogous sets (CSS Color 4 §12.2): when every source component without an analog in target is missing,
  // all target components without an analog in source also become missing.
  let mut rest = 0
  let mut rest_missing = 0
  if !(s0 != 0 && (s0 == t0 || s0 == t1 || s0 == t2)) {
    rest = rest + 1
    if src.m0 { rest_missing = rest_missing + 1 }
  }
  if !(s1 != 0 && (s1 == t0 || s1 == t1 || s1 == t2)) {
    rest = rest + 1
    if src.m1 { rest_missing = rest_missing + 1 }
  }
  if !(s2 != 0 && (s2 == t0 || s2 == t1 || s2 == t2)) {
    rest = rest + 1
    if src.m2 { rest_missing = rest_missing + 1 }
  }
  if rest > 0 && rest == rest_missing {
    if !(t0 != 0 && (t0 == s0 || t0 == s1 || t0 == s2)) { m0 = true }
    if !(t1 != 0 && (t1 == s0 || t1 == s1 || t1 == s2)) { m1 = true }
    if !(t2 != 0 && (t2 == s0 || t2 == s1 || t2 == s2)) { m2 = true }
  }
  (m0, m1, m2)
}

fn powerless_normalize(c : Color) -> Color {
  match c.space {
    ColorSpace::Hsl =>
    if !c.m0 && !c.m1 && c.c1 <= 0.001 {
      Color::new_with_missing(c.space, 0.0, f64_min(c.c1, 0.0), c.c2, c.alpha, true, c.m1, c.m2, c.ma)
    } else {
      c
    }
    ColorSpace::Hwb =>
    if !c.m0 && !c.m1 && !c.m2 && c.c1 + c.c2 >= 99.999 {
      Color::new_with_missing(
        c.space,
        0.0,
        c.c1,
        if c.c1 + c.c2 < 100.0 { 100.0 - c.c1 } else { c.c2 },
        c.alpha,
        true,
        false,
        false,
        c.ma,
      )
    } else {
      c
    }
    ColorSpace::Lch =>
    if !c.m2 && !c.m1 && c.c1 <= 0.0015 {
      Color::new_with_missing(c.space, c.c0, f64_min(c.c1, 0.0), 0.0, c.alpha, c.m0, c.m1, true, c.ma)
    } else {
      c
    }
    ColorSpace::Oklch =>
    if !c.m2 && !c.m1 && c.c1 <= 0.000004 {
      Color::new_with_missing(c.space, c.c0, f64_min(c.c1, 0.0), 0.0, c.alpha, c.m0, c.m1, true, c.ma)
    } else {
      c
    }
    _ => c
  }
}

fn convert_srgb_to_oklch(c0 : Double, c1 : Double, c2 : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r = srgb_to_linear_ch(c0)
  let g = srgb_to_linear_ch(c1)
  let b = srgb_to_linear_ch(c2)
  let lc = f64_cbrt(0.4122214694707629 * r + 0.5363325372617349 * g + 0.051445993267502196 * b)
  let mc = f64_cbrt(0.21190349581782517 * r + 0.6806995506452345 * g + 0.10739695353694056 * b)
  let sc = f64_cbrt(0.08830245919005637 * r + 0.2817188391361215 * g + 0.6299787016738223 * b)
  let ol = 0.2104542683093140 * lc + 0.7936177747023054 * mc + -0.0040720430116193 * sc
  let oa = 1.9779985324311684 * lc + -2.4285922420485799 * mc + 0.4505937096174110 * sc
  let ob = 0.0259040424655478 * lc + 0.7827717124575296 * mc + -0.8086757549230774 * sc
  let ch = f64_sqrt(oa * oa + ob * ob)
  let mut ro1 = ch
  let mut ro2 = 0.0
  let mut hm = false
  if ch <= 0.000004 {
    ro1 = 0.0
    hm = true
  } else {
    let deg = rad_to_deg(f64_atan2(ob, oa))
    let h = if deg < 0.0 { deg + 360.0 } else { deg }
    ro2 = if h >= 360.0 || h < 0.0 { 0.0 } else { h }
  }
  if !has_m && !hm {
    Color::{ space: ColorSpace::Oklch, c0: ol, c1: ro1, c2: ro2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Oklch, false, false, hm)
    Color::new_with_missing(ColorSpace::Oklch, ol, ro1, ro2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_srgb_to_oklab(c0 : Double, c1 : Double, c2 : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r = srgb_to_linear_ch(c0)
  let g = srgb_to_linear_ch(c1)
  let b = srgb_to_linear_ch(c2)
  let lc = f64_cbrt(0.4122214694707629 * r + 0.5363325372617349 * g + 0.051445993267502196 * b)
  let mc = f64_cbrt(0.21190349581782517 * r + 0.6806995506452345 * g + 0.10739695353694056 * b)
  let sc = f64_cbrt(0.08830245919005637 * r + 0.2817188391361215 * g + 0.6299787016738223 * b)
  let ol = 0.2104542683093140 * lc + 0.7936177747023054 * mc + -0.0040720430116193 * sc
  let oa = 1.9779985324311684 * lc + -2.4285922420485799 * mc + 0.4505937096174110 * sc
  let ob = 0.0259040424655478 * lc + 0.7827717124575296 * mc + -0.8086757549230774 * sc
  if !has_m {
    Color::{ space: ColorSpace::Oklab, c0: ol, c1: oa, c2: ob, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Oklab, false, false, false)
    Color::new_with_missing(ColorSpace::Oklab, ol, oa, ob, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_oklch_to_p3(l_ok : Double, ch : Double, h : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let rad = deg_to_rad(h)
  let mut sn = 0.0
  let mut cs = 0.0
  if (rad.to_bits() & 0x7ff0000000000000L) == 0x7ff0000000000000L {
    sn = 0.0 / 0.0
    cs = 0.0 / 0.0
  } else {
    let k = math_floor(rad * inv_half_pi + 0.5)
    let r = rad - k * half_pi
    let r2 = r * r
    let sp = r * (
      1.0 +
      r2 * (
        -0.16666666666666666 +
        r2 * (
          0.008333333333333333 +
          r2 * (-0.0001984126984126984 + r2 * (0.0000027557319223985893 + r2 * -2.505210838544172e-8))
        )
      )
    )
    let cp = 1.0 +
    r2 * (
      -0.5 +
      r2 * (
        0.041666666666666664 +
        r2 * (
          -0.001388888888888889 +
          r2 * (0.0000248015873015873 + r2 * (-2.755731922398589e-7 + r2 * 2.08767569878681e-9))
        )
      )
    )
    let q = k.to_int64().to_int() & 3
    if q == 0 {
      sn = sp
      cs = cp
    } else if q == 1 {
      sn = cp
      cs = -sp
    } else if q == 2 {
      sn = -sp
      cs = -cp
    } else {
      sn = -cp
      cs = sp
    }
  }
  let a_ok = ch * cs
  let b_ok = ch * sn
  let lc = l_ok + 0.3963377773761749 * a_ok + 0.2158037573099136 * b_ok
  let mc = l_ok + -0.1055613458156586 * a_ok + -0.0638541728258133 * b_ok
  let sc = l_ok + -0.0894841775298119 * a_ok + -1.2914855480194092 * b_ok
  let l = lc * lc * lc
  let m = mc * mc * mc
  let s = sc * sc * sc
  let r0 = srgb_from_linear_ch(3.127768971361874 * l + -2.257135762591639 * m + 0.1293667912297653 * s)
  let r1 = srgb_from_linear_ch(-1.0910090184377974 * l + 2.4133317103069216 * m + -0.32232269186912466 * s)
  let r2 = srgb_from_linear_ch(-0.026010801938570305 * l + -0.508041331704167 * m + 1.534052133642737 * s)
  if !has_m {
    Color::{ space: ColorSpace::DisplayP3, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::DisplayP3, false, false, false)
    Color::new_with_missing(ColorSpace::DisplayP3, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_oklch_to_srgb(l_ok : Double, ch : Double, h : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let rad = deg_to_rad(h)
  let mut sn = 0.0
  let mut cs = 0.0
  if !f64_is_finite(rad) {
    sn = 0.0 / 0.0
    cs = 0.0 / 0.0
  } else {
    let k = math_floor(rad * inv_half_pi + 0.5)
    let r = rad - k * half_pi
    let sp = f64_sin_poly(r)
    let cp = f64_cos_poly(r)
    let q = k.to_int64().to_int() & 3
    if q == 0 {
      sn = sp
      cs = cp
    } else if q == 1 {
      sn = cp
      cs = -sp
    } else if q == 2 {
      sn = -sp
      cs = -cp
    } else {
      sn = -cp
      cs = sp
    }
  }
  let a_ok = ch * cs
  let b_ok = ch * sn
  let lc = l_ok + 0.3963377773761749 * a_ok + 0.2158037573099136 * b_ok
  let mc = l_ok + -0.1055613458156586 * a_ok + -0.0638541728258133 * b_ok
  let sc = l_ok + -0.0894841775298119 * a_ok + -1.2914855480194092 * b_ok
  let l = lc * lc * lc
  let m = mc * mc * mc
  let s = sc * sc * sc
  let r0 = srgb_from_linear_ch(4.07674163607596 * l + -3.3077115392580634 * m + 0.23096990318210475 * s)
  let r1 = srgb_from_linear_ch(-1.2684379732850317 * l + 2.6097573492876878 * m + -0.3413193760026572 * s)
  let r2 = srgb_from_linear_ch(-0.004196076138675498 * l + -0.7034186179359363 * m + 1.7076146940746117 * s)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_oklab_to_srgb(l_ok : Double, a_ok : Double, b_ok : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let lc = l_ok + 0.3963377773761749 * a_ok + 0.2158037573099136 * b_ok
  let mc = l_ok + -0.1055613458156586 * a_ok + -0.0638541728258133 * b_ok
  let sc = l_ok + -0.0894841775298119 * a_ok + -1.2914855480194092 * b_ok
  let l = lc * lc * lc
  let m = mc * mc * mc
  let s = sc * sc * sc
  let r0 = srgb_from_linear_ch(4.07674163607596 * l + -3.3077115392580634 * m + 0.23096990318210475 * s)
  let r1 = srgb_from_linear_ch(-1.2684379732850317 * l + 2.6097573492876878 * m + -0.3413193760026572 * s)
  let r2 = srgb_from_linear_ch(-0.004196076138675498 * l + -0.7034186179359363 * m + 1.7076146940746117 * s)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_p3_to_lab(c0 : Double, c1 : Double, c2 : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r = srgb_to_linear_ch(c0)
  let g = srgb_to_linear_ch(c1)
  let b = srgb_to_linear_ch(c2)
  let xr = 0.5342204217647368 * r + 0.30282203809630615 * g + 0.162957540138957 * b
  let yr = 0.24120032212525516 * r + 0.692222541131382 * g + 0.06657713674336292 * b
  let zr = -0.0012727345647388123 * r + 0.05075510433665741 * g + 0.9505176302280814 * b
  let fx = if xr > lab_epsilon { f64_cbrt(xr) } else { (lab_kappa * xr + 16.0) * inv_116 }
  let fy = if yr > lab_epsilon { f64_cbrt(yr) } else { (lab_kappa * yr + 16.0) * inv_116 }
  let fz = if zr > lab_epsilon { f64_cbrt(zr) } else { (lab_kappa * zr + 16.0) * inv_116 }
  let r0 = 116.0 * fy - 16.0
  let r1 = 500.0 * (fx - fy)
  let r2 = 200.0 * (fy - fz)
  if !has_m {
    Color::{ space: ColorSpace::Lab, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Lab, false, false, false)
    Color::new_with_missing(ColorSpace::Lab, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_lab_to_srgb(l : Double, a : Double, b : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let fy = (l + 16.0) * inv_116
  let fx = a * 0.002 + fy
  let fz = fy - b * 0.005
  let fx3 = fx * fx * fx
  let fz3 = fz * fz * fz
  let xr = if fx3 > lab_epsilon { fx3 } else { (116.0 * fx - 16.0) * inv_lab_kappa }
  let yr = if l > 8.0 { fy * fy * fy } else { l * inv_lab_kappa }
  let zr = if fz3 > lab_epsilon { fz3 } else { (116.0 * fz - 16.0) * inv_lab_kappa }
  let r0 = srgb_from_linear_ch(3.0222336522944806 * xr + -1.6173859980180425 * yr + -0.404847654276437 * zr)
  let r1 = srgb_from_linear_ch(-0.9438482461515546 * xr + 1.916254377395988 * yr + 0.02759386875556632 * zr)
  let r2 = srgb_from_linear_ch(0.06938627393942097 * xr + -0.22897675981518198 * yr + 1.159590485875761 * zr)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_p3_to_srgb(c0 : Double, c1 : Double, c2 : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r = srgb_to_linear_ch(c0)
  let g = srgb_to_linear_ch(c1)
  let b = srgb_to_linear_ch(c2)
  let r0 = srgb_from_linear_ch(1.2249401762805587 * r + -0.22494017628055885 * g + 0.0 * b)
  let r1 = srgb_from_linear_ch(-0.04205695470968831 * r + 1.0420569547096884 * g + 0.0 * b)
  let r2 = srgb_from_linear_ch(-0.019637554590334433 * r + -0.07863604555063203 * g + 1.0982736001409665 * b)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn hsl_ch(n : Double, h30 : Double, l : Double, a : Double) -> Double {
  let k0 = n + h30
  let k = if k0 >= 12.0 { k0 - 12.0 } else { k0 }
  let res = l - a * f64_max(-1.0, f64_min(k - 3.0, f64_min(9.0 - k, 1.0)))
  if res != res {
    Double::from_bits(0x7ff8000000000000L)
  } else {
    res
  }
}

fn convert_hsl_to_srgb(h_in : Double, s_in : Double, l_in : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let h = f64_normalize_hue(h_in)
  let s = s_in * 0.01
  let l = l_in * 0.01
  let a = s * f64_min(l, 1.0 - l)
  let h30 = h * (1.0 / 30.0)
  let r0 = hsl_ch(0.0, h30, l, a)
  let r1 = hsl_ch(8.0, h30, l, a)
  let r2 = hsl_ch(4.0, h30, l, a)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_hwb_to_srgb(h_in : Double, w_in : Double, b_in : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let w = w_in * 0.01
  let b = b_in * 0.01
  let mut r0 = 0.0
  let mut r1 = 0.0
  let mut r2 = 0.0
  if w + b >= 1.0 {
    let g0 = w / (w + b)
    let gray = if g0 != g0 { Double::from_bits(0x7ff8000000000000L) } else { g0 }
    r0 = gray
    r1 = gray
    r2 = gray
  } else {
    let h = f64_normalize_hue(h_in)
    let h30 = h * (1.0 / 30.0)
    let scale = 1.0 - w - b
    r0 = hsl_ch(0.0, h30, 0.5, 0.5) * scale + w
    r1 = hsl_ch(8.0, h30, 0.5, 0.5) * scale + w
    r2 = hsl_ch(4.0, h30, 0.5, 0.5) * scale + w
    if r0 != r0 { r0 = Double::from_bits(0x7ff8000000000000L) }
    if r1 != r1 { r1 = Double::from_bits(0x7ff8000000000000L) }
    if r2 != r2 { r2 = Double::from_bits(0x7ff8000000000000L) }
  }
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_lch_to_srgb(l : Double, ch : Double, h : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let rad = deg_to_rad(h)
  let mut sn = 0.0
  let mut cs = 0.0
  if (rad.to_bits() & 0x7ff0000000000000L) == 0x7ff0000000000000L {
    sn = 0.0 / 0.0
    cs = 0.0 / 0.0
  } else {
    let k = math_floor(rad * inv_half_pi + 0.5)
    let r = rad - k * half_pi
    let sp = f64_sin_poly(r)
    let cp = f64_cos_poly(r)
    let q = k.to_int64().to_int() & 3
    if q == 0 {
      sn = sp
      cs = cp
    } else if q == 1 {
      sn = cp
      cs = -sp
    } else if q == 2 {
      sn = -sp
      cs = -cp
    } else {
      sn = -cp
      cs = sp
    }
  }
  convert_lab_to_srgb(l, ch * cs, ch * sn, alpha, has_m, self)
}

fn convert_srgb_linear_to_srgb(c0 : Double, c1 : Double, c2 : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r0 = srgb_from_linear_ch(c0)
  let r1 = srgb_from_linear_ch(c1)
  let r2 = srgb_from_linear_ch(c2)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_xyz_d65_to_srgb(x : Double, y : Double, z : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let r0 = srgb_from_linear_ch(3.2409699419045226 * x + -1.537383177570094 * y + -0.4986107602930034 * z)
  let r1 = srgb_from_linear_ch(-0.9692436362808796 * x + 1.8759675015077202 * y + 0.04155505740717559 * z)
  let r2 = srgb_from_linear_ch(0.05563007969699366 * x + -0.20397695888897652 * y + 1.0569715142428786 * z)
  if !has_m {
    Color::{ space: ColorSpace::Srgb, c0: r0, c1: r1, c2: r2, alpha: alpha, m0: false, m1: false, m2: false, ma: false }
  } else {
    let (m0, m1, m2) = carry_missing(self, ColorSpace::Srgb, false, false, false)
    Color::new_with_missing(ColorSpace::Srgb, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
  }
}

fn convert_xyz_d50_to_srgb(x : Double, y : Double, z : Double, alpha : Double, has_m : Bool, self : Color) -> Color {
  let xd = 0.9554734214880752 * x + -0.023098454948764523 * y + 0.06325924320057066 * z
  let yd = -0.028369709333863583 * x + 1.0099953980813041 * y + 0.021041441191917306 * z
  let zd = 0.012314014864481996 * x + -0.02050764929889898 * y + 1.330365926242124 * z
  convert_xyz_d65_to_srgb(xd, yd, zd, alpha, has_m, self)
}

///| Convert a color to `target` color space without gamut clipping.
pub fn Color::convert(self : Color, target : ColorSpace) -> Color {
  let has_m = self.m0 || self.m1 || self.m2 || self.ma
  match self.space {
    ColorSpace::Srgb =>
    match target {
      ColorSpace::Srgb => return self
      ColorSpace::Oklch =>
      return convert_srgb_to_oklch(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      ColorSpace::Oklab =>
      return convert_srgb_to_oklab(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::Oklch =>
    match target {
      ColorSpace::Oklch => return self
      ColorSpace::DisplayP3 => {
        let src = if !self.m2 && !self.m1 && self.c1 <= 0.000004 {
          Color::new_with_missing(self.space, self.c0, f64_min(self.c1, 0.0), 0.0, self.alpha, self.m0, self.m1, true, self.ma)
        } else {
          self
        }
        let sh = src.m0 || src.m1 || src.m2 || src.ma
        return convert_oklch_to_p3(
          if src.m0 { 0.0 } else { src.c0 },
          if src.m1 { 0.0 } else { src.c1 },
          if src.m2 { 0.0 } else { src.c2 },
          src.alpha,
          sh,
          src,
        )
      }
      ColorSpace::Srgb => {
        let src = if !self.m2 && !self.m1 && self.c1 <= 0.000004 {
          Color::new_with_missing(self.space, self.c0, f64_min(self.c1, 0.0), 0.0, self.alpha, self.m0, self.m1, true, self.ma)
        } else {
          self
        }
        let sh = src.m0 || src.m1 || src.m2 || src.ma
        return convert_oklch_to_srgb(
          if src.m0 { 0.0 } else { src.c0 },
          if src.m1 { 0.0 } else { src.c1 },
          if src.m2 { 0.0 } else { src.c2 },
          src.alpha,
          sh,
          src,
        )
      }
      _ => return powerless_normalize(self).convert_impl(target)
    }
    ColorSpace::DisplayP3 =>
    match target {
      ColorSpace::DisplayP3 => return self
      ColorSpace::Lab =>
      return convert_p3_to_lab(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      ColorSpace::Srgb =>
      return convert_p3_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::Lab =>
    match target {
      ColorSpace::Lab => return self
      ColorSpace::Srgb =>
      return convert_lab_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::Oklab =>
    match target {
      ColorSpace::Oklab => return self
      ColorSpace::Srgb =>
      return convert_oklab_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::Hsl =>
    match target {
      ColorSpace::Hsl => return self
      ColorSpace::Srgb => {
        let src = powerless_normalize(self)
        let sh = src.m0 || src.m1 || src.m2 || src.ma
        return convert_hsl_to_srgb(
          if src.m0 { 0.0 } else { src.c0 },
          if src.m1 { 0.0 } else { src.c1 },
          if src.m2 { 0.0 } else { src.c2 },
          src.alpha,
          sh,
          src,
        )
      }
      _ => return powerless_normalize(self).convert_impl(target)
    }
    ColorSpace::Hwb =>
    match target {
      ColorSpace::Hwb => return self
      ColorSpace::Srgb => {
        let src = powerless_normalize(self)
        let sh = src.m0 || src.m1 || src.m2 || src.ma
        return convert_hwb_to_srgb(
          if src.m0 { 0.0 } else { src.c0 },
          if src.m1 { 0.0 } else { src.c1 },
          if src.m2 { 0.0 } else { src.c2 },
          src.alpha,
          sh,
          src,
        )
      }
      _ => return powerless_normalize(self).convert_impl(target)
    }
    ColorSpace::Lch =>
    match target {
      ColorSpace::Lch => return self
      ColorSpace::Srgb => {
        let src = powerless_normalize(self)
        let sh = src.m0 || src.m1 || src.m2 || src.ma
        return convert_lch_to_srgb(
          if src.m0 { 0.0 } else { src.c0 },
          if src.m1 { 0.0 } else { src.c1 },
          if src.m2 { 0.0 } else { src.c2 },
          src.alpha,
          sh,
          src,
        )
      }
      _ => return powerless_normalize(self).convert_impl(target)
    }
    ColorSpace::SrgbLinear =>
    match target {
      ColorSpace::SrgbLinear => return self
      ColorSpace::Srgb =>
      return convert_srgb_linear_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::XyzD65 =>
    match target {
      ColorSpace::XyzD65 => return self
      ColorSpace::Srgb =>
      return convert_xyz_d65_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    ColorSpace::XyzD50 =>
    match target {
      ColorSpace::XyzD50 => return self
      ColorSpace::Srgb =>
      return convert_xyz_d50_to_srgb(
        if self.m0 { 0.0 } else { self.c0 },
        if self.m1 { 0.0 } else { self.c1 },
        if self.m2 { 0.0 } else { self.c2 },
        self.alpha,
        has_m,
        self,
      )
      _ => return self.convert_impl(target)
    }
    _ => ()
  }
  if self.space.eq(target) {
    return self
  }
  let src = match self.space {
    ColorSpace::Hsl | ColorSpace::Hwb | ColorSpace::Lch | ColorSpace::Oklch => powerless_normalize(self)
    _ => self
  }
  src.convert_impl(target)
}

fn Color::convert_impl(self : Color, target : ColorSpace) -> Color {
  let c0 = if self.m0 { 0.0 } else { self.c0 }
  let c1 = if self.m1 { 0.0 } else { self.c1 }
  let c2 = if self.m2 { 0.0 } else { self.c2 }
  // Fast direct paths that avoid XYZ round-trip precision loss
  let (r0, r1, r2, dm0, dm1, dm2) = match (self.space, target) {
    (ColorSpace::Srgb, ColorSpace::SrgbLinear) => {
      (srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2), false, false, false)
    }
    (ColorSpace::SrgbLinear, ColorSpace::Srgb) => {
      (srgb_from_linear_ch(c0), srgb_from_linear_ch(c1), srgb_from_linear_ch(c2), false, false, false)
    }
    (ColorSpace::DisplayP3, ColorSpace::DisplayP3Linear) => {
      (srgb_to_linear_ch(c0), srgb_to_linear_ch(c1), srgb_to_linear_ch(c2), false, false, false)
    }
    (ColorSpace::DisplayP3Linear, ColorSpace::DisplayP3) => {
      (srgb_from_linear_ch(c0), srgb_from_linear_ch(c1), srgb_from_linear_ch(c2), false, false, false)
    }
    (ColorSpace::Srgb, ColorSpace::Hsl) => {
      let (h, s, l, hm) = srgb_to_hsl(c0, c1, c2)
      (h, s, l, hm, false, false)
    }
    (ColorSpace::Hsl, ColorSpace::Srgb) => {
      let (r, g, b) = hsl_to_srgb(c0, c1, c2)
      (r, g, b, false, false, false)
    }
    (ColorSpace::Srgb, ColorSpace::Hwb) => {
      let (h, w, b, hm) = srgb_to_hwb(c0, c1, c2)
      (h, w, b, hm, false, false)
    }
    (ColorSpace::Hwb, ColorSpace::Srgb) => {
      let (r, g, b) = hwb_to_srgb(c0, c1, c2)
      (r, g, b, false, false, false)
    }
    (ColorSpace::Lab, ColorSpace::Lch) => {
      let (l, c, h, hm) = rect_to_polar(c0, c1, c2, 0.0015)
      (l, c, h, false, false, hm)
    }
    (ColorSpace::Lch, ColorSpace::Lab) => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      (l, a, b, false, false, false)
    }
    (ColorSpace::Oklab, ColorSpace::Oklch) => {
      let (l, c, h, hm) = rect_to_polar(c0, c1, c2, 0.000004)
      (l, c, h, false, false, hm)
    }
    (ColorSpace::Oklch, ColorSpace::Oklab) => {
      let (l, a, b) = polar_to_rect(c0, c1, c2)
      (l, a, b, false, false, false)
    }
    _ => {
      if is_d50_space(self.space) && is_d50_space(target) {
        let (x, y, z) = color_to_xyz_d50(self)
        xyz_d50_to_space(x, y, z, target)
      } else {
        let (x, y, z) = color_to_xyz_d65(self)
        xyz_d65_to_space(x, y, z, target)
      }
    }
  }
  if !self.m0 && !self.m1 && !self.m2 && !dm0 && !dm1 && !dm2 && !self.ma {
    return Color::{
      space: target,
      c0: r0,
      c1: r1,
      c2: r2,
      alpha: self.alpha,
      m0: false,
      m1: false,
      m2: false,
      ma: false,
    }
  }
  let (m0, m1, m2) = carry_missing(self, target, dm0, dm1, dm2)
  Color::new_with_missing(target, r0, r1, r2, self.alpha, m0, m1, m2, self.ma)
}

fn is_bounded_rgb_space(space : ColorSpace) -> Bool {
  match space {
    ColorSpace::Srgb
    | ColorSpace::SrgbLinear
    | ColorSpace::DisplayP3
    | ColorSpace::DisplayP3Linear
    | ColorSpace::A98Rgb
    | ColorSpace::ProphotoRgb
    | ColorSpace::Rec2020 => true
    _ => false
  }
}

fn in_unit_gamut(c0 : Double, c1 : Double, c2 : Double) -> Bool {
  c0 >= 0.0 && c0 <= 1.0 && c1 >= 0.0 && c1 <= 1.0 && c2 >= 0.0 && c2 <= 1.0
}

///| Returns true if the color is within the `[0, 1]` gamut of its bounded RGB space (always true for unbounded spaces).
pub fn Color::in_gamut(self : Color) -> Bool {
  if is_bounded_rgb_space(self.space) {
    in_unit_gamut(self.c0, self.c1, self.c2)
  } else if self.space.eq(ColorSpace::Hsl) || self.space.eq(ColorSpace::Hwb) {
    let s = self.convert(ColorSpace::Srgb)
    in_unit_gamut(s.c0, s.c1, s.c2)
  } else {
    true
  }
}

fn delta_e_ok(c1 : Color, c2 : Color) -> Double {
  let o1 = c1.convert(ColorSpace::Oklab)
  let o2 = c2.convert(ColorSpace::Oklab)
  let dl = o1.c0 - o2.c0
  let da = o1.c1 - o2.c1
  let db = o1.c2 - o2.c2
  f64_sqrt(dl * dl + da * da + db * db)
}

fn clip_rgb(c : Color) -> Color {
  Color::new_with_missing(
    c.space,
    f64_clamp01(c.c0),
    f64_clamp01(c.c1),
    f64_clamp01(c.c2),
    c.alpha,
    c.m0,
    c.m1,
    c.m2,
    c.ma,
  )
}

///| Map a color into the gamut of `target` using W3C CSS Color 4 §13.2 Oklch binary search.
pub fn Color::to_gamut(self : Color, target : ColorSpace) -> Color {
  if !is_bounded_rgb_space(target) && !target.eq(ColorSpace::Hsl) && !target.eq(ColorSpace::Hwb) {
    return self.convert(target)
  }
  let rgb_target = if target.eq(ColorSpace::Hsl) || target.eq(ColorSpace::Hwb) {
    ColorSpace::Srgb
  } else {
    target
  }
  let direct = self.convert(rgb_target)
  if in_unit_gamut(direct.c0, direct.c1, direct.c2) {
    return if target.eq(rgb_target) { direct } else { direct.convert(target) }
  }
  let ok = self.convert(ColorSpace::Oklch)
  let l = ok.c0
  if l >= 1.0 {
    let w = Color::new_with_missing(rgb_target, 1.0, 1.0, 1.0, self.alpha, false, false, false, self.ma)
    return if target.eq(rgb_target) { w } else { w.convert(target) }
  }
  if l <= 0.0 {
    let k = Color::new_with_missing(rgb_target, 0.0, 0.0, 0.0, self.alpha, false, false, false, self.ma)
    return if target.eq(rgb_target) { k } else { k.convert(target) }
  }
  let jnd = 0.02
  let eps = 0.0001
  let mut lo = 0.0
  let mut hi = ok.c1
  let h = ok.c2
  let mut min_in_gamut = true
  let mut clipped = clip_rgb(direct)
  // ED §13.2 step 11 shortcut: if clipping origin is already within JND, return clipped.
  if delta_e_ok(clipped, ok) < jnd {
    return if target.eq(rgb_target) { clipped } else { clipped.convert(target) }
  }
  if !f64_is_finite(hi) || hi < 0.0 {
    return if target.eq(rgb_target) { clipped } else { clipped.convert(target) }
  }
  let mut iter = 0
  while hi - lo > eps && iter < 1100 {
    let mid = lo + (hi - lo) * 0.5
    let cand = Color::new_with_missing(ColorSpace::Oklch, l, mid, h, self.alpha, false, false, ok.m2, self.ma)
    let dest = cand.convert(rgb_target)
    if min_in_gamut && in_unit_gamut(dest.c0, dest.c1, dest.c2) {
      lo = mid
    } else {
      clipped = clip_rgb(dest)
      let e = delta_e_ok(clipped, cand)
      if e < jnd {
        if jnd - e < eps {
          return if target.eq(rgb_target) { clipped } else { clipped.convert(target) }
        }
        min_in_gamut = false
        lo = mid
      } else {
        hi = mid
      }
    }
    iter = iter + 1
  }
  if target.eq(rgb_target) {
    clipped
  } else {
    clipped.convert(target)
  }
}
