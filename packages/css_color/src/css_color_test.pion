test "03_rgb_and_rgba_legacy_and_modern" {
  assert_rgba8(must_parse("rgb(255, 128, 0)"), 255, 128, 0, 255, "legacy rgb")
  assert_rgba8(must_parse("rgba(255, 128, 0, 0.5)"), 255, 128, 0, 128, "legacy rgba")
  assert_rgba8(must_parse("rgb(100%, 50%, 0%, 50%)"), 255, 128, 0, 128, "legacy rgb %")
  assert_rgba8(must_parse("rgb(255 128 0 / 50%)"), 255, 128, 0, 128, "modern rgb")
  assert_rgba8(must_parse("rgba(100% 128 0 / 0.25)"), 255, 128, 0, 64, "modern mixed")
  let c_none = must_parse("rgb(none 128 255 / none)")
  assert_eq_bool(c_none.m0, true, "m0 none")
  assert_eq_bool(c_none.ma, true, "ma none")
  assert_rgba8(c_none, 0, 128, 255, 0, "none as 0")
  must_err("rgb(255, 50%, 0)")
  must_err("rgb(255, 0, 0 / 0.5)")
  must_err("rgb(255 0 0, 0.5)")
  must_err("rgb(none, 0, 0)")
}

test "04_rgb_clamping_and_scientific_notation" {
  assert_rgba8(must_parse("rgb(300, -20, 1e2)"), 255, 0, 100, 255, "rgb clamp + sci")
  assert_rgba8(must_parse("rgb(2.55e2 0e0 1.28e2 / 5e-1)"), 255, 0, 128, 128, "sci notation")
  assert_rgba8(must_parse("rgb(.5e2 +100 -5 / 1.5)"), 50, 100, 0, 255, "leading dot + signs")
}

test "05_hsl_hsla_angles_and_modern" {
  assert_rgba8(must_parse("hsl(120, 100%, 50%)"), 0, 255, 0, 255, "hsl green")
  assert_rgba8(must_parse("hsla(240deg, 100%, 50%, 50%)"), 0, 0, 255, 128, "hsla blue")
  assert_rgba8(must_parse("hsl(0.5turn 100% 50%)"), 0, 255, 255, 255, "hsl turn")
  assert_rgba8(must_parse("hsl(200grad 100 50 / 1)"), 0, 255, 255, 255, "hsl grad")
  assert_rgba8(must_parse("hsl(3.141592653589793rad 100% 50%)"), 0, 255, 255, 255, "hsl rad")
  assert_rgba8(must_parse("hsl(-120deg 100% 50%)"), 0, 0, 255, 255, "hsl neg deg")
  assert_rgba8(must_parse("hsl(480deg 100% 50%)"), 0, 255, 0, 255, "hsl wrap >360")
  must_err("hsl(120, 100, 50%)")
  must_err("hsl(120, 100%, 50% / 0.5)")
}

test "06_hwb_parsing_and_conversion" {
  assert_rgba8(must_parse("hwb(0 0% 0%)"), 255, 0, 0, 255, "hwb red")
  assert_rgba8(must_parse("hwb(120deg 0% 0%)"), 0, 255, 0, 255, "hwb green")
  assert_rgba8(must_parse("hwb(0 50% 50%)"), 128, 128, 128, 255, "hwb gray")
  // h=194 -> G = 46/60 = 0.7666666666666666 -> *255 = 195.49999999999997 -> 195
  assert_rgba8(must_parse("hwb(194 0% 0% / 0.5)"), 0, 195, 255, 128, "hwb cyan-blue")
  assert_rgba8(must_parse("hwb(120 60% 60%)"), 128, 128, 128, 255, "hwb overflow")
  assert_rgba8(must_parse("hwb(0.5turn 20% 20%)"), 51, 204, 204, 255, "hwb turn")
  must_err("hwb(0, 0%, 0%)")
}

test "07_lab_and_lch_parsing_and_wpt_vectors" {
  let c1 = must_parse("lab(50% 40 59.5)")
  assert_eq_bool(c1.space.eq(ColorSpace::Lab), true, "lab space")
  assert_near(c1.c0, 50.0, 1.0e-6, "lab L")
  assert_near(c1.c1, 40.0, 1.0e-6, "lab a")
  assert_near(c1.c2, 59.5, 1.0e-6, "lab b")
  let c2 = must_parse("lab(50% 100% -100% / 50%)")
  assert_near(c2.c1, 125.0, 1.0e-6, "lab a 100%")
  assert_near(c2.c2, -125.0, 1.0e-6, "lab b -100%")
  assert_near(c2.alpha, 0.5, 1.0e-6, "lab alpha")
  let c3 = must_parse("lch(52.2345% 72.2 50)")
  assert_eq_bool(c3.space.eq(ColorSpace::Lch), true, "lch space")
  let c4 = must_parse("lch(50% 100% 0.25turn)")
  assert_near(c4.c1, 150.0, 1.0e-6, "lch C 100%")
  assert_near(c4.c2, 90.0, 1.0e-6, "lch H 0.25turn")
  // Exact W3C CSS Color 4 §18 matrix vector: sRGB red -> Lab
  let red_lab = must_parse("red").convert(ColorSpace::Lab)
  assert_near(red_lab.c0, 54.2905429, 1.0e-4, "red Lab L")
  assert_near(red_lab.c1, 80.8049203, 1.0e-2, "red Lab a")
  assert_near(red_lab.c2, 69.8909882, 1.0e-2, "red Lab b")
}

test "08_oklab_and_oklch_parsing_and_vectors" {
  let c1 = must_parse("oklab(59.69% 0.1007 0.1191)")
  assert_eq_bool(c1.space.eq(ColorSpace::Oklab), true, "oklab space")
  assert_near(c1.c0, 0.5969, 1.0e-6, "oklab L")
  let c2 = must_parse("oklab(50% 100% -50%)")
  assert_near(c2.c0, 0.5, 1.0e-6, "oklab L 50%")
  assert_near(c2.c1, 0.4, 1.0e-6, "oklab a 100%")
  assert_near(c2.c2, -0.2, 1.0e-6, "oklab b -50%")
  let c3 = must_parse("oklch(0.627955 0.257683 29.233885)")
  assert_rgba8(c3, 255, 0, 0, 255, "oklch red")
  let c4 = must_parse("oklch(70% 50% 180deg)")
  assert_near(c4.c0, 0.7, 1.0e-6, "oklch L 70%")
  assert_near(c4.c1, 0.2, 1.0e-6, "oklch C 50%")
  assert_near(c4.c2, 180.0, 1.0e-6, "oklch H 180")
  // Negative chroma clamps to 0
  let c5 = must_parse("oklch(0.5 -0.2 100)")
  assert_near(c5.c1, 0.0, 1.0e-6, "oklch negative C clamped to 0")
}

test "09_color_function_all_9_predefined_spaces" {
  let spaces : Array[(String, ColorSpace)] = [
    ("color(srgb 0.5 0.25 0.75)", ColorSpace::Srgb),
    ("color(srgb-linear 0.5 0.25 0.75)", ColorSpace::SrgbLinear),
    ("color(display-p3 1 0 0)", ColorSpace::DisplayP3),
    ("color(a98-rgb 0.4 0.5 0.6)", ColorSpace::A98Rgb),
    ("color(prophoto-rgb 0.4 0.5 0.6)", ColorSpace::ProphotoRgb),
    ("color(rec2020 0.4 0.5 0.6)", ColorSpace::Rec2020),
    ("color(xyz 0.2 0.3 0.4)", ColorSpace::XyzD65),
    ("color(xyz-d65 0.2 0.3 0.4)", ColorSpace::XyzD65),
    ("color(xyz-d50 0.2 0.3 0.4)", ColorSpace::XyzD50),
  ]
  let mut i = 0
  while i < spaces.length() {
    let (expr, expected_space) = spaces[i]
    let c = must_parse(expr)
    assert_eq_bool(c.space.eq(expected_space), true, expr)
    i = i + 1
  }
  let p = must_parse("color(display-p3 50% 25% 100% / 80%)")
  assert_near(p.c0, 0.5, 1.0e-6, "p3 50%")
  assert_near(p.c1, 0.25, 1.0e-6, "p3 25%")
  assert_near(p.c2, 1.0, 1.0e-6, "p3 100%")
  assert_near(p.alpha, 0.8, 1.0e-6, "p3 alpha 80%")
  // Extended-range values allowed in color()
  let ext = must_parse("color(srgb 1.5 -0.2 0.5)")
  assert_near(ext.c0, 1.5, 1.0e-6, "extended >1")
  assert_near(ext.c1, -0.2, 1.0e-6, "extended <0")
  must_err("color(unknown-space 0 0 0)")
  must_err("color(srgb 0, 0, 0)")
}

test "10_all_14_color_spaces_roundtrip" {
  let orig = Color::new(ColorSpace::Srgb, 0.73, 0.31, 0.54, 0.85)
  let spaces : Array[ColorSpace] = [
    ColorSpace::Srgb,
    ColorSpace::SrgbLinear,
    ColorSpace::DisplayP3,
    ColorSpace::A98Rgb,
    ColorSpace::ProphotoRgb,
    ColorSpace::Rec2020,
    ColorSpace::XyzD50,
    ColorSpace::XyzD65,
    ColorSpace::Hsl,
    ColorSpace::Hwb,
    ColorSpace::Lab,
    ColorSpace::Lch,
    ColorSpace::Oklab,
    ColorSpace::Oklch,
  ]
  let mut i = 0
  while i < spaces.length() {
    let sp = spaces[i]
    let mid = orig.convert(sp)
    let back = mid.convert(ColorSpace::Srgb)
    assert_near(back.c0, orig.c0, 1.0e-5, sp.css_name() + " roundtrip R")
    assert_near(back.c1, orig.c1, 1.0e-5, sp.css_name() + " roundtrip G")
    assert_near(back.c2, orig.c2, 1.0e-5, sp.css_name() + " roundtrip B")
    assert_near(back.alpha, orig.alpha, 1.0e-6, sp.css_name() + " roundtrip A")
    i = i + 1
  }
}

test "11_extended_range_negative_rgb_roundtrip" {
  let orig = Color::new(ColorSpace::Srgb, 1.25, -0.15, 0.5, 1.0)
  let p3 = orig.convert(ColorSpace::DisplayP3)
  let back = p3.convert(ColorSpace::Srgb)
  assert_near(back.c0, 1.25, 1.0e-5, "extended R")
  assert_near(back.c1, -0.15, 1.0e-5, "extended G")
  assert_near(back.c2, 0.5, 1.0e-5, "extended B")
  let rec = orig.convert(ColorSpace::Rec2020).convert(ColorSpace::Srgb)
  assert_near(rec.c0, 1.25, 1.0e-5, "rec2020 extended R")
  assert_near(rec.c1, -0.15, 1.0e-5, "rec2020 extended G")
}

test "12_d65_d50_bradford_whitepoint_adaptation" {
  let white_d65 = Color::srgb(1.0, 1.0, 1.0, 1.0).convert(ColorSpace::XyzD65)
  assert_near(white_d65.c0, 0.9504559, 1.0e-4, "D65 X")
  assert_near(white_d65.c1, 1.0, 1.0e-4, "D65 Y")
  assert_near(white_d65.c2, 1.0890577, 1.0e-4, "D65 Z")
  let white_d50 = Color::srgb(1.0, 1.0, 1.0, 1.0).convert(ColorSpace::XyzD50)
  assert_near(white_d50.c0, 0.9642957, 1.0e-4, "D50 X")
  assert_near(white_d50.c1, 1.0, 1.0e-4, "D50 Y")
  assert_near(white_d50.c2, 0.8251046, 1.0e-4, "D50 Z")
}

test "13_achromatic_powerless_hue_missing" {
  let gray_hsl = Color::srgb(0.5, 0.5, 0.5, 1.0).convert(ColorSpace::Hsl)
  assert_eq_bool(gray_hsl.m0, true, "gray hsl hue powerless")
  let gray_lch = Color::srgb(0.5, 0.5, 0.5, 1.0).convert(ColorSpace::Lch)
  assert_eq_bool(gray_lch.m2, true, "gray lch hue powerless")
  let gray_oklch = Color::srgb(0.5, 0.5, 0.5, 1.0).convert(ColorSpace::Oklch)
  assert_eq_bool(gray_oklch.m2, true, "gray oklch hue powerless")
}

test "14_analogous_missing_component_carry_forward" {
  // Missing L in Lab carries to Oklab
  let lab_none = must_parse("lab(none 20 30)")
  let ok = lab_none.convert(ColorSpace::Oklab)
  assert_eq_bool(ok.m0, true, "L none carried Lab->Oklab")
  // Missing R in sRGB carries to Display P3
  let rgb_none = must_parse("color(srgb none 0.5 0.5)")
  let p3 = rgb_none.convert(ColorSpace::DisplayP3)
  assert_eq_bool(p3.m0, true, "R none carried sRGB->P3")
  // Missing hue in HSL carries to Oklch
  let hsl_none = must_parse("hsl(none 80% 50%)")
  let oklch = hsl_none.convert(ColorSpace::Oklch)
  assert_eq_bool(oklch.m2, true, "H none carried HSL->Oklch")
}

test "15_oklch_binary_search_gamut_mapping_srgb" {
  let p3_red = must_parse("color(display-p3 1 0 0)")
  assert_eq_bool(p3_red.convert(ColorSpace::Srgb).in_gamut(), false, "p3 red out of srgb gamut")
  let mapped = p3_red.to_gamut(ColorSpace::Srgb)
  assert_eq_bool(mapped.in_gamut(), true, "mapped p3 red in srgb gamut")
  let vivid = must_parse("oklch(0.7 0.35 145)")
  let mapped_vivid = vivid.to_gamut(ColorSpace::Srgb)
  assert_eq_bool(mapped_vivid.in_gamut(), true, "mapped vivid in srgb gamut")
  let mapped_oklch = mapped_vivid.convert(ColorSpace::Oklch)
  assert_near(mapped_oklch.c2, 145.0, 5.0, "gamut map preserves hue")
  let (mr, mg, mb, ma) = vivid.to_rgba8()
  let (cr, cg, cb, ca) = vivid.to_rgba8_clamped()
  assert_eq_int(ma, 255, "mapped alpha")
  assert_eq_int(ca, 255, "clamped alpha")
  debug_assert(mr != cr || mg != cg || mb != cb, "gamut map differs from naive clamp")
  assert_rgba8(must_parse("oklch(1.2 0.2 120)"), 255, 255, 255, 255, "L>=1 white")
  assert_rgba8(must_parse("oklch(0 0.2 120)"), 0, 0, 0, 255, "L<=0 black")
}

test "16_gamut_mapping_to_display_p3_and_rec2020" {
  let super_vivid = must_parse("oklch(0.75 0.45 260)")
  let p3 = super_vivid.to_gamut(ColorSpace::DisplayP3)
  assert_eq_bool(p3.in_gamut(), true, "mapped to display-p3 in gamut")
  let rec = super_vivid.to_gamut(ColorSpace::Rec2020)
  assert_eq_bool(rec.in_gamut(), true, "mapped to rec2020 in gamut")
  // Already in-gamut color is unchanged
  let srgb_c = must_parse("#3b82f6")
  let mapped_s = srgb_c.to_gamut(ColorSpace::Srgb)
  assert_near(mapped_s.c0, srgb_c.c0, 1.0e-6, "in-gamut R unchanged")
  assert_near(mapped_s.c1, srgb_c.c1, 1.0e-6, "in-gamut G unchanged")
  assert_near(mapped_s.c2, srgb_c.c2, 1.0e-6, "in-gamut B unchanged")
}

test "17_color_mix_rectangular_and_alpha_normalization" {
  assert_rgba8(must_parse("color-mix(in srgb, red, blue)"), 128, 0, 128, 255, "srgb red+blue")
  assert_rgba8(must_parse("color-mix(in srgb, red 20%, blue)"), 51, 0, 204, 255, "srgb 20/80")
  assert_rgba8(must_parse("color-mix(in srgb, 20% red, blue)"), 51, 0, 204, 255, "percent before color")
  assert_rgba8(must_parse("color-mix(in srgb, red, 80% blue)"), 51, 0, 204, 255, "second percent before")
  let m4 = must_parse("color-mix(in srgb, red 20%, blue 20%)")
  assert_near(m4.alpha, 0.4, 1.0e-5, "sum<100 alpha multiplier")
  assert_near(m4.c0, 0.5, 1.0e-5, "sum<100 normalized R")
  assert_near(m4.c2, 0.5, 1.0e-5, "sum<100 normalized B")
  let m5 = must_parse("color-mix(in srgb, red 60%, blue 60%)")
  assert_near(m5.alpha, 1.0, 1.0e-5, "sum>100 alpha")
  assert_near(m5.c0, 0.5, 1.0e-5, "sum>100 R")
  let m6 = must_parse("color-mix(in srgb, rgb(255 0 0 / 0.5), rgb(0 0 255 / 1.0))")
  assert_near(m6.alpha, 0.75, 1.0e-5, "premul alpha")
  assert_near(m6.c0, 1.0 / 3.0, 1.0e-4, "premul R")
  assert_near(m6.c2, 2.0 / 3.0, 1.0e-4, "premul B")
  must_err("color-mix(in srgb, red 0%, blue 0%)")
  must_err("color-mix(in srgb, red -10%, blue 50%)")
  must_err("color-mix(in srgb, red 110%, blue 10%)")
  must_err("color-mix(in srgb shorter hue, red, blue)")
}

test "18_color_mix_all_rectangular_spaces" {
  let spaces : Array[String] = [
    "srgb",
    "srgb-linear",
    "display-p3",
    "a98-rgb",
    "prophoto-rgb",
    "rec2020",
    "lab",
    "oklab",
    "xyz",
    "xyz-d50",
    "xyz-d65",
  ]
  let mut i = 0
  while i < spaces.length() {
    let expr = "color-mix(in " + spaces[i] + ", coral 40%, dodgerblue 60%)"
    let c = must_parse(expr)
    let (_, _, _, a) = c.to_rgba8()
    assert_eq_int(a, 255, expr + " opaque")
    i = i + 1
  }
}

test "19_color_mix_polar_all_4_hue_modes" {
  let c_short = must_parse("color-mix(in hsl shorter hue, hsl(30 100% 50%), hsl(330 100% 50%))")
  assert_near(c_short.c0, 0.0, 1.0e-4, "shorter hue 0")
  let c_long = must_parse("color-mix(in hsl longer hue, hsl(30 100% 50%), hsl(330 100% 50%))")
  assert_near(c_long.c0, 180.0, 1.0e-4, "longer hue 180")
  let c_inc = must_parse("color-mix(in hsl increasing hue, hsl(30 100% 50%), hsl(330 100% 50%))")
  assert_near(c_inc.c0, 180.0, 1.0e-4, "increasing hue 180")
  let c_dec = must_parse("color-mix(in hsl decreasing hue, hsl(30 100% 50%), hsl(330 100% 50%))")
  assert_near(c_dec.c0, 0.0, 1.0e-4, "decreasing hue 0")
  let ok = must_parse("color-mix(in oklch longer hue, oklch(0.7 0.15 40), oklch(0.7 0.15 80))")
  assert_near(ok.c2, 240.0, 1.0e-3, "oklch longer hue 240")
  let lch = must_parse("color-mix(in lch decreasing hue, lch(60 50 40), lch(60 50 80))")
  assert_near(lch.c2, 240.0, 1.0e-3, "lch decreasing hue 240")
  let hwb = must_parse("color-mix(in hwb increasing hue, hwb(350 0% 0%), hwb(10 0% 0%))")
  assert_near(hwb.c0, 0.0, 1.0e-3, "hwb increasing hue 0")
}

test "20_color_mix_none_and_nested" {
  let c = must_parse("color-mix(in oklch, oklch(0.6 0.15 none), oklch(0.8 0.15 120))")
  assert_near(c.c0, 0.7, 1.0e-5, "oklch mix L")
  assert_near(c.c2, 120.0, 1.0e-5, "none hue takes other")
  let both = must_parse("color-mix(in srgb, rgb(none 100 0), rgb(none 200 0))")
  assert_eq_bool(both.m0, true, "both none remains none")
  let nested = must_parse("color-mix(in oklab, color-mix(in srgb, red, yellow), color-mix(in hsl, blue, green))")
  assert_eq_bool(nested.space.eq(ColorSpace::Oklab), true, "nested color-mix space")
}

test "21_color_mix_method_api" {
  let c1 = must_parse("red")
  let c2 = must_parse("blue")
  match c1.mix(c2, ColorSpace::Oklch, HueInterpolation::Shorter, 30.0, 70.0) {
    Ok(m) => {
      assert_eq_bool(m.space.eq(ColorSpace::Oklch), true, "mix api space")
      assert_near(m.alpha, 1.0, 1.0e-5, "mix api alpha")
    }
    Err(e) => debug_assert(false, "mix api failed: " + e.to_string())
  }
}

test "22_relative_color_rgb_and_hsl" {
  let c1 = must_parse("rgb(from #ff8000 r calc(g / 2) b / 0.5)")
  assert_rgba8(c1, 255, 64, 0, 128, "rgb from calc")
  let c2 = must_parse("rgb(from rgb(100 150 200 / 0.4) r g b)")
  assert_near(c2.alpha, 0.4, 1.0e-5, "relative preserves alpha")
  let c3 = must_parse("hsl(from red calc(h + 120) s l)")
  assert_rgba8(c3, 0, 255, 0, 255, "hsl rotate hue +120")
  let c4 = must_parse("hsla(from blue h s calc(l / 2) / 0.5)")
  assert_rgba8(c4, 0, 0, 128, 128, "hsla darken")
}

test "23_relative_color_hwb_lab_lch_oklab_oklch" {
  let c_hwb = must_parse("hwb(from red calc(h + 240) w b)")
  assert_rgba8(c_hwb, 0, 0, 255, 255, "hwb rotate to blue")
  let c_lab = must_parse("lab(from white calc(l - 50) a b)")
  assert_near(c_lab.c0, 50.0, 1.0e-3, "lab relative L")
  let c_lch = must_parse("lch(from coral l calc(c * 0.5) calc(h + 10))")
  assert_eq_bool(c_lch.space.eq(ColorSpace::Lch), true, "lch relative")
  let c_oklab = must_parse("oklab(from #3b82f6 calc(l * 0.9) a b)")
  assert_eq_bool(c_oklab.space.eq(ColorSpace::Oklab), true, "oklab relative")
  let c_oklch = must_parse("oklch(from #3b82f6 calc(l * 0.8) c calc(h + 30) / calc(alpha * 0.5))")
  assert_eq_bool(c_oklch.space.eq(ColorSpace::Oklch), true, "oklch relative")
  assert_near(c_oklch.alpha, 0.5, 1.0e-5, "oklch relative alpha")
}

test "24_relative_color_fn_and_nested" {
  let c1 = must_parse("color(from red display-p3 r g b)")
  assert_eq_bool(c1.space.eq(ColorSpace::DisplayP3), true, "color() relative display-p3")
  let c2 = must_parse("color(from white xyz-d65 x calc(y * 0.5) z)")
  assert_eq_bool(c2.space.eq(ColorSpace::XyzD65), true, "color() relative xyz-d65")
  assert_near(c2.c1, 0.5, 1.0e-4, "xyz y halved")
  let c3 = must_parse("oklch(from color-mix(in oklch, red, blue) calc(l + 0.1) c h)")
  assert_eq_bool(c3.space.eq(ColorSpace::Oklch), true, "nested relative color-mix")
}

test "25_calc_precedence_parens_and_errors" {
  // 10 + 20 * 3 = 70, (10 + 20) * 3 = 90, 200 - 50 / 2 = 175
  let c = must_parse("rgb(calc(10 + 20 * 3) calc((10 + 20) * 3) calc(200 - 50 / 2))")
  assert_rgba8(c, 70, 90, 175, 255, "calc precedence")
  let c_neg = must_parse("hsl(calc(-1 * (60 + 60)) 100% 50%)")
  assert_rgba8(c_neg, 0, 0, 255, 255, "calc unary minus")
  let c_nested = must_parse("rgb(calc(calc(100) + 55) 0 0)")
  assert_rgba8(c_nested, 155, 0, 0, 255, "nested calc")
  must_err("rgb(from red calc(r / 0) g b)")
  must_err("rgb(from red calc(1 + ) g b)")
  must_err("rgb(calc(1 + 2 g b)")
  must_err("rgb(from red calc(unknown_var + 1) g b)")
}

test "26_wcag_relative_luminance_and_contrast_ratio" {
  let black = must_parse("black")
  let white = must_parse("white")
  assert_near(black.relative_luminance(), 0.0, 1.0e-6, "black luminance")
  assert_near(white.relative_luminance(), 1.0, 1.0e-6, "white luminance")
  assert_near(white.contrast_ratio(black), 21.0, 1.0e-5, "white vs black 21:1")
  assert_near(black.contrast_ratio(white), 21.0, 1.0e-5, "symmetry")
  assert_near(white.contrast_ratio(white), 1.0, 1.0e-5, "same color 1:1")
  assert_near(must_parse("red").relative_luminance(), 0.2126, 1.0e-4, "red luminance")
  // WCAG AA threshold: #767676 on white is ~4.54:1
  let aa = must_parse("#767676").contrast_ratio(white)
  debug_assert(aa >= 4.5 && aa <= 4.6, "#767676 contrast ratio ~4.54")
}

test "27_to_css_serialization_all_spaces" {
  let samples : Array[String] = [
    "rgb(255 128 0 / 0.5)",
    "color(srgb-linear 0.2 0.4 0.6)",
    "color(display-p3 0.8 0.2 0.1)",
    "color(a98-rgb 0.3 0.5 0.7)",
    "color(prophoto-rgb 0.4 0.5 0.6)",
    "color(rec2020 0.7 0.2 0.3)",
    "color(xyz-d50 0.2 0.3 0.4)",
    "color(xyz-d65 0.25 0.35 0.45)",
    "hsl(210 80% 50% / 0.9)",
    "hwb(120 10% 20%)",
    "lab(55 30 -20)",
    "lch(60 40 120)",
    "oklab(0.6 0.1 -0.1)",
    "oklch(0.65 0.18 250 / 0.75)",
  ]
  let mut i = 0
  while i < samples.length() {
    let c1 = must_parse(samples[i])
    let css = c1.to_css()
    let c2 = must_parse(css)
    assert_eq_bool(c1.space.eq(c2.space), true, "to_css space " + css)
    assert_near(c1.c0, c2.c0, 1.0e-4, "to_css c0 " + css)
    assert_near(c1.c1, c2.c1, 1.0e-4, "to_css c1 " + css)
    assert_near(c1.c2, c2.c2, 1.0e-4, "to_css c2 " + css)
    assert_near(c1.alpha, c2.alpha, 1.0e-4, "to_css alpha " + css)
    i = i + 1
  }
}

test "28_to_hex_formatting" {
  assert_eq_str(must_parse("black").to_hex(), "#000000", "black hex")
  assert_eq_str(must_parse("white").to_hex(), "#ffffff", "white hex")
  assert_eq_str(must_parse("rebeccapurple").to_hex(), "#663399", "rebeccapurple hex")
  assert_eq_str(must_parse("transparent").to_hex(), "#00000000", "transparent hex")
  assert_eq_str(must_parse("rgb(255 0 128 / 0.5)").to_hex(), "#ff008080", "alpha hex")
}

test "29_color_space_metadata_helpers" {
  assert_eq_bool(ColorSpace::Hsl.is_polar(), true, "hsl polar")
  assert_eq_bool(ColorSpace::Hwb.is_polar(), true, "hwb polar")
  assert_eq_bool(ColorSpace::Lch.is_polar(), true, "lch polar")
  assert_eq_bool(ColorSpace::Oklch.is_polar(), true, "oklch polar")
  assert_eq_bool(ColorSpace::Srgb.is_polar(), false, "srgb rect")
  assert_eq_bool(ColorSpace::Oklab.is_polar(), false, "oklab rect")
  assert_eq_str(ColorSpace::DisplayP3.to_string(), "display-p3", "p3 name")
  assert_eq_str(HueInterpolation::Longer.to_string(), "longer", "longer name")
}

test "30_dos_depth_boundary_32_vs_33" {
  // Depth 16 should succeed
  let sb_ok = StringBuilder::new()
  let mut i = 0
  while i < 16 {
    sb_ok.write_string("color-mix(in srgb, ")
    i = i + 1
  }
  sb_ok.write_string("red")
  i = 0
  while i < 16 {
    sb_ok.write_string(", blue)")
    i = i + 1
  }
  let _ = must_parse(sb_ok.to_string())

  // Depth 33 (> max_nesting_depth = 32) must fail with MaxDepthExceeded
  let sb_bad = StringBuilder::new()
  i = 0
  while i < 33 {
    sb_bad.write_string("color-mix(in srgb, ")
    i = i + 1
  }
  sb_bad.write_string("red")
  i = 0
  while i < 33 {
    sb_bad.write_string(", blue)")
    i = i + 1
  }
  match parse(sb_bad.to_string()) {
    Err(ColorError::MaxDepthExceeded(_)) => ()
    _ => debug_assert(false, "expected MaxDepthExceeded for 33-deep color-mix")
  }
}

test "31_dos_relative_from_and_calc_depth" {
  // Deeply nested relative color `from`
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 35 {
    sb.write_string("rgb(from ")
    i = i + 1
  }
  sb.write_string("red")
  i = 0
  while i < 35 {
    sb.write_string(" r g b)")
    i = i + 1
  }
  match parse(sb.to_string()) {
    Err(ColorError::MaxDepthExceeded(_)) => ()
    _ => debug_assert(false, "expected MaxDepthExceeded for 35-deep relative color")
  }

  // Deeply nested calc parentheses
  let c_sb = StringBuilder::new()
  c_sb.write_string("rgb(calc(")
  i = 0
  while i < 40 {
    c_sb.write_string("(")
    i = i + 1
  }
  c_sb.write_string("1")
  i = 0
  while i < 40 {
    c_sb.write_string(")")
    i = i + 1
  }
  c_sb.write_string(") 0 0)")
  match parse(c_sb.to_string()) {
    Err(ColorError::MaxDepthExceeded(_)) => ()
    _ => debug_assert(false, "expected MaxDepthExceeded for 40-deep calc")
  }
}

test "32_dos_input_length_and_malformed" {
  must_err("")
  must_err("   \t\n\r  ")
  must_err("red blue")
  must_err("#ff0000;")
  must_err("rgb(1, 2, 3))")
  must_err("rgb(1e999 0 0)")
  must_err("rgb(NaN 0 0)")
  must_err("rgb(Infinity 0 0)")
  must_err("rgb(-Infinity 0 0)")
  must_err("color-mix(in oklch, red)")
  must_err("color-mix(in oklch shorter, red, blue)")
  must_err("unknownfn(1 2 3)")
  let big = StringBuilder::new()
  let mut k = 0
  while k < 17000 {
    big.write_string(" ")
    k = k + 1
  }
  big.write_string("red")
  match parse(big.to_string()) {
    Err(ColorError::InputTooLong(_)) => ()
    _ => debug_assert(false, "expected InputTooLong")
  }
}
