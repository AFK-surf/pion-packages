///| Comprehensive unit, W3C CSS Color 4/5 compliance, gamut mapping,
///| WCAG contrast, and adversarial DoS test suite for `packages/css_color` (36 tests).

fn assert_eq_int(a : Int, b : Int, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_str(a : String, b : String, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got '" + a + "', expected '" + b + "'")
}

fn assert_eq_bool(a : Bool, b : Bool, msg : String) -> Unit {
  debug_assert(a == b, msg)
}

fn assert_near(a : Double, b : Double, eps : Double, msg : String) -> Unit {
  let diff = if a >= b { a - b } else { b - a }
  debug_assert(
    diff <= eps,
    msg + ": got " + a.to_string() + ", expected " + b.to_string() + " (eps=" + eps.to_string() + ")",
  )
}

fn assert_rgba8(c : Color, r : Int, g : Int, b : Int, a : Int, msg : String) -> Unit {
  let (gr, gg, gb, ga) = c.to_rgba8()
  assert_eq_int(gr, r, msg + " R")
  assert_eq_int(gg, g, msg + " G")
  assert_eq_int(gb, b, msg + " B")
  assert_eq_int(ga, a, msg + " A")
}

fn must_parse(s : String) -> Color {
  match parse(s) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "expected Ok for '" + s + "', got Err: " + e.to_string())
      Color::rgba8(0, 0, 0, 0)
    }
  }
}

fn must_err(s : String) -> Unit {
  match parse(s) {
    Ok(_) => debug_assert(false, "expected Err for '" + s + "', got Ok")
    Err(_) => ()
  }
}

test "01_hex_formats_and_whitespace" {
  assert_rgba8(must_parse("#f0a"), 255, 0, 170, 255, "#f0a")
  assert_rgba8(must_parse("  #F0A8\t\n"), 255, 0, 170, 136, "#F0A8")
  assert_rgba8(must_parse("#123456"), 0x12, 0x34, 0x56, 255, "#123456")
  assert_rgba8(must_parse("#12345680"), 0x12, 0x34, 0x56, 0x80, "#12345680")
  assert_eq_str(must_parse("#123456").to_hex(), "#123456", "to_hex opaque")
  assert_eq_str(must_parse("#12345680").to_hex(), "#12345680", "to_hex alpha")
  must_err("#")
  must_err("#12")
  must_err("#12345")
  must_err("#1234567")
  must_err("#123456789")
  must_err("#gggggg")
}

