///| Ported WPT `css/css-color/parsing` (pinned commit `6a5adcd6`, 2026-11-24) compliance & regression suite.
///| Covers W3C CSS Color 4 & 5 Editor's Draft parsing, computed-value, powerless/none carry-forward,
///| relative colors, typed `calc()`, multi-color `color-mix()`, `display-p3-linear`, ED matrices,
///| §13.2 gamut mapping, huge-hue normalization, `to_css()` round-trip fidelity, and WCAG alpha compositing.

fn wpt_abs(x : Double) -> Double {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

fn wpt_hue_near(a : Double, b : Double, tol : Double) -> Bool {
  let mut d = wpt_abs(a - b)
  while d >= 360.0 {
    d = d - 360.0
  }
  d <= tol || 360.0 - d <= tol
}

fn wpt_expect_in(
  expr : String,
  sp : ColorSpace,
  e0 : Double,
  e1 : Double,
  e2 : Double,
  tol : Double,
  hue_idx : Int,
) -> Unit {
  let c = must_parse(expr).convert(sp)
  let ok0 = if hue_idx == 0 { wpt_hue_near(c.c0, e0, tol) } else { wpt_abs(c.c0 - e0) <= tol }
  let ok1 = if hue_idx == 1 { wpt_hue_near(c.c1, e1, tol) } else { wpt_abs(c.c1 - e1) <= tol }
  let ok2 = if hue_idx == 2 { wpt_hue_near(c.c2, e2, tol) } else { wpt_abs(c.c2 - e2) <= tol }
  debug_assert(ok0 && ok1 && ok2, "WPT mismatch for: " + expr + " -> " + c.to_css())
}

test "wpt_p1_1_near_white_black_hsl_hwb" {
  // WPT css/css-color/parsing/color-computed-color-mix-function.html
  let hsl_w = must_parse("lab(100 0 0)").convert(ColorSpace::Hsl)
  debug_assert(hsl_w.c1 <= 0.001 && hsl_w.m0, "lab(100 0 0) -> hsl achromatic & hue powerless")
  wpt_expect_in("color-mix(in hsl, lch(100% 0 0), blue)", ColorSpace::Srgb, 0.625, 0.625, 0.875, 0.01, -1)
  wpt_expect_in("color-mix(in hwb, lch(100% 0 0), blue)", ColorSpace::Srgb, 0.5, 0.5, 1.0, 0.01, -1)
  wpt_expect_in("color-mix(in hsl, lab(100 0 0), blue)", ColorSpace::Srgb, 0.625, 0.625, 0.875, 0.01, -1)
}

test "wpt_p1_2_relative_color_none_and_powerless" {
  // WPT css/css-color/parsing/color-computed-none.html & color-computed-powerless.html
  let c1 = must_parse("hsl(from hsl(none 50% 50%) h s l)")
  debug_assert(c1.m0 && !c1.m1 && !c1.m2, "hsl relative keeps none hue")
  let c2 = must_parse("oklch(from white l c h)")
  debug_assert(c2.m2, "oklch(from white l c h) keeps powerless hue as none")
  let c3 = must_parse("oklch(from #808080 l c h)")
  debug_assert(c3.m2, "oklch(from #808080 l c h) keeps powerless hue as none")
  let c4 = must_parse("lch(from hwb(180 100% 25%) l c h)")
  debug_assert(c4.m2, "lch(from hwb achromatic) keeps powerless hue as none")
  wpt_expect_in(
    "color-mix(in oklch, oklch(from white l c h), blue)",
    ColorSpace::Oklch,
    0.725987,
    0.15663,
    264.051,
    0.002,
    2,
  )
  wpt_expect_in(
    "color-mix(in oklch, oklch(from #808080 l c h), oklch(0.7 0.2 140))",
    ColorSpace::Oklch,
    0.64994,
    0.1,
    140.0,
    0.005,
    2,
  )
}

test "wpt_p2_1_to_css_large_and_nonfinite" {
  let c = must_parse("color(srgb 1e13 0 0)")
  let back = must_parse(c.to_css())
  assert_near(back.c0, 1.0e13, 1.0, "to_css round-trips 1e13")
  let inf_c = must_parse("rgb(from red calc(r / 0) g b)")
  let inf_css = inf_c.to_css()
  debug_assert(inf_css.contains("calc(infinity)"), "to_css serializes +Inf as calc(infinity)")
  let _ = must_parse(inf_css)
}

test "wpt_p2_2_ed_bradford_and_prophoto_matrices" {
  // W3C CSS Color 4 ED (2023+) exact rational-derived Bradford D65->D50 and ProPhoto matrices
  wpt_expect_in(
    "color(xyz-d65 1 0 0)",
    ColorSpace::XyzD50,
    1.0479297925449969,
    0.02962780877005599,
    -0.009243040646204504,
    1.0e-12,
    -1,
  )
  wpt_expect_in(
    "color(prophoto-rgb 1 0 0)",
    ColorSpace::XyzD50,
    0.7977666449006423,
    0.2880748288194013,
    0.0,
    1.0e-12,
    -1,
  )
}

test "wpt_p2_3_token_boundaries" {
  must_err("rgb(from #fffr g b)")
  let c = must_parse("rgb(from#f00 r g b)")
  assert_rgba8(c, 255, 0, 0, 255, "from#f00 valid token boundary")
}

test "wpt_p2_4_p2_5_calc_grammar_and_edge_values" {
  // WPT css/css-color/parsing/color-invalid-relative-color.html & color-computed-color-function.html
  must_err("rgb(calc(1+2) 0 0)")
  must_err("rgb(calc(1 -2) 0 0)")
  must_err("rgb(from red calc(-r + 300) g b)")
  must_err("rgb(from red calc(r + 10%) g b)")
  must_err("hsl(from red calc(h + 30deg) s l)")
  must_err("hsl(calc(50%) 100% 50%)")
  must_err("rgb(255, calc(50%), 0)")
  wpt_expect_in("color(srgb calc(0 / 0) 0 0)", ColorSpace::Srgb, 0.0, 0.0, 0.0, 1.0e-9, -1)
  wpt_expect_in("color(srgb calc(NaN) 0 0)", ColorSpace::Srgb, 0.0, 0.0, 0.0, 1.0e-9, -1)
  let _ = must_parse("rgb(from red calc(r / 0) g b)")
  let _ = must_parse("hsl(120, calc(50%), 50%)")
  let _ = must_parse("color-mix(in srgb, red calc(50%), blue)")
  assert_rgba8(must_parse("rgb(1e309 0 0)"), 255, 0, 0, 255, "1e309 clamps")
}

test "wpt_p2_6_css_color_5_ed_color_mix_and_display_p3_linear" {
  // WPT css/css-color/parsing/color-computed-color-mix-function.html & color-computed-color-function.html
  let z = must_parse("color-mix(in srgb, color(srgb .1 .2 .3) 0%, color(srgb .5 .6 .7) 0%)")
  assert_near(z.c0, 0.3, 1.0e-6, "0%+0% r")
  assert_near(z.c1, 0.4, 1.0e-6, "0%+0% g")
  assert_near(z.c2, 0.5, 1.0e-6, "0%+0% b")
  assert_near(z.alpha, 0.0, 1.0e-9, "0%+0% alpha")
  let no_in = must_parse("color-mix(red, blue)")
  assert_eq_bool(no_in.space.eq(ColorSpace::Oklab), true, "default interpolation space oklab")
  let single = must_parse("color-mix(in srgb, red)")
  assert_rgba8(single, 255, 0, 0, 255, "single-color color-mix")
  wpt_expect_in("color-mix(in srgb, red, green, blue)", ColorSpace::Srgb, 0.333333, 0.16732, 0.333333, 0.001, -1)
  wpt_expect_in("color-mix(in srgb, red 0%, green 0%, blue 0%)", ColorSpace::Srgb, 0.25, 0.12549, 0.5, 0.001, -1)
  let p3l = must_parse("color(display-p3-linear 0.5 0.5 0.5)")
  assert_eq_bool(p3l.space.eq(ColorSpace::DisplayP3Linear), true, "display-p3-linear space")
  assert_eq_str(p3l.to_css(), "color(display-p3-linear 0.5 0.5 0.5)", "display-p3-linear to_css")
}

test "wpt_p2_7_p2_8_p2_9_p2_10_p2_11_p2_12_p2_14_regressions" {
  // P2-7: analogous components (x/y/z <-> r/g/b) & analogous sets
  wpt_expect_in(
    "color-mix(in xyz, color(srgb none 0 0), blue)",
    ColorSpace::XyzD65,
    0.180452,
    0.0360873,
    0.475203,
    0.0005,
    -1,
  )
  wpt_expect_in(
    "color-mix(in oklch, oklab(0.1 none none), oklch(0.3 0.2 90deg))",
    ColorSpace::Oklch,
    0.2,
    0.2,
    90.0,
    0.01,
    2,
  )
  // P2-8: ED powerless thresholds
  wpt_expect_in(
    "color-mix(in lch, hsl(180 0.001% 50%), lch(11 33 44))",
    ColorSpace::Lch,
    32.19448237,
    16.5,
    44.0,
    0.01,
    2,
  )
  // P2-9: hsl() does not clamp S > 100%
  let hsl_hi = must_parse("hsl(120 550% none)")
  assert_near(hsl_hi.c1, 550.0, 1.0e-9, "hsl S > 100% preserved")
  // P2-10: to_gamut ED §13.2 early exit returns clipped
  let gm = must_parse("oklch(0.90244 0.39113 249.065)").to_gamut(ColorSpace::A98Rgb)
  assert_near(gm.c0, 0.7746762105689327, 0.001, "gamut a98 r")
  assert_near(gm.c1, 0.8895547333041092, 0.001, "gamut a98 g")
  assert_near(gm.c2, 1.0, 0.001, "gamut a98 b")
  // P2-11: missing hue filled before hue fix-up & zero alpha -> 0 components
  wpt_expect_in("color-mix(in hsl longer hue, red, white)", ColorSpace::Srgb, 0.625, 0.875, 0.875, 0.01, -1)
  wpt_expect_in(
    "color-mix(in srgb, color(srgb -2 -3 -4 / -5), color(srgb -4 -6 -8 / -10))",
    ColorSpace::Srgb,
    0.0,
    0.0,
    0.0,
    0.01,
    -1,
  )
  // P2-12: huge hue exact fmod
  wpt_expect_in("hsl(1e20deg 50% 50%)", ColorSpace::Hsl, 280.0, 50.0, 50.0, 0.001, 0)
  // P2-14: WCAG contrast_ratio alpha-composites foreground over backdrop
  let tr_contrast = must_parse("rgb(0 0 0 / 0)").contrast_ratio(must_parse("white"))
  assert_near(tr_contrast, 1.0, 1.0e-9, "transparent black over white has 1:1 contrast")
}
