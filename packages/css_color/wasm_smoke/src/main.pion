///| Wasm32 + Native 4-mode smoke entry for `packages/css_color`.

import "css_color"

fn fnv1a64_u8(h : UInt64, v : Int) -> UInt64 {
  let x = h ^ (v & 0xFF).to_int64().to_uint64()
  x * 1099511628211UL
}

fn fnv1a64_str(h : UInt64, s : String) -> UInt64 {
  let mut acc = h
  let n = s.length()
  let mut i = 0
  while i < n {
    acc = fnv1a64_u8(acc, s.code_unit_at(i))
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let samples : Array[String] = [
    "#f0a",
    "#12345680",
    "rebeccapurple",
    "transparent",
    "rgb(255, 128, 0)",
    "rgba(100% 50% 0% / 50%)",
    "hsl(0.5turn 100% 50% / 0.75)",
    "hwb(194 10% 20%)",
    "lab(54.29 80.81 69.89)",
    "lch(60% 75 45deg)",
    "oklab(0.65 0.12 -0.08)",
    "oklch(0.7 0.35 145)",
    "color(display-p3 1 0.2 0.1 / 0.9)",
    "color(a98-rgb 0.4 0.7 0.2)",
    "color(prophoto-rgb 0.5 0.5 0.5)",
    "color(rec2020 0.8 0.3 0.1)",
    "color(xyz-d50 0.3 0.4 0.2)",
    "color(xyz-d65 0.3 0.4 0.2)",
    "color-mix(in oklch longer hue, oklch(0.7 0.15 40), oklch(0.7 0.15 80))",
    "color-mix(in srgb, red 20%, blue 20%)",
    "rgb(from #3b82f6 r calc(g * 0.8) b / 0.5)",
    "oklch(from color-mix(in oklch, coral, dodgerblue) calc(l + 0.05) c calc(h + 15))",
  ]
  let mut h : UInt64 = 14695981039346656037UL
  let mut ok_count = 0
  let mut i = 0
  while i < samples.length() {
    match css_color::parse(samples[i]) {
      Ok(c) => {
        ok_count = ok_count + 1
        let (r, g, b, a) = c.to_rgba8()
        let (cr, cg, cb, ca) = c.to_rgba8_clamped()
        h = fnv1a64_u8(h, r)
        h = fnv1a64_u8(h, g)
        h = fnv1a64_u8(h, b)
        h = fnv1a64_u8(h, a)
        h = fnv1a64_u8(h, cr)
        h = fnv1a64_u8(h, cg)
        h = fnv1a64_u8(h, cb)
        h = fnv1a64_u8(h, ca)
        h = fnv1a64_str(h, c.to_hex())
        h = fnv1a64_str(h, c.to_css())
      }
      Err(e) => {
        io_println(world, "css_color_wasm_smoke: FAIL " + samples[i] + " -> " + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  io_println(
    world,
    "css_color_wasm_smoke: OK samples=" + ok_count.to_string() + " fnv64=" + h.to_string(),
  )
  0
}
