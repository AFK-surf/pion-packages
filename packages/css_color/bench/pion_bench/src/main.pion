///| Pion native differential oracle & benchmark driver for `packages/css_color`.

import "css_color"

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    let ch = s.code_unit_at(i)
    if ch == 10 {
      let end = if i > start && s.code_unit_at(i - 1) == 13 { i - 1 } else { i }
      if end > start {
        out.push(s.slice(start, end))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

fn split_pipe(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 124 {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, n))
  out
}

fn parse_int_arg(s : String) -> Int {
  let mut v = 0
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

fn fmt_f6(v : Double) -> String {
  if v != v {
    return "0.000000"
  }
  let neg = v < 0.0
  let av = if neg { -v } else { v }
  let scaled = (av * 1000000.0 + 0.5).to_int64()
  let ip = scaled / 1000000L
  let fp = scaled % 1000000L
  let mut frac_s = fp.to_string()
  while frac_s.length() < 6 {
    frac_s = "0" + frac_s
  }
  let prefix = if neg && scaled != 0L { "-" } else { "" }
  prefix + ip.to_string() + "." + frac_s
}

fn run_diff(world : World, parse_path : String, mix_path : String, gamut_path : String) -> Int {
  let parse_text = match fs_read(world, parse_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR read parse_path")
      return 1
    }
  }
  let mix_text = match fs_read(world, mix_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR read mix_path")
      return 1
    }
  }
  let gamut_text = match fs_read(world, gamut_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR read gamut_path")
      return 1
    }
  }
  let parse_lines = split_lines(parse_text)
  let mut i = 0
  while i < parse_lines.length() {
    match css_color::parse(parse_lines[i]) {
      Ok(c) => {
        let srgb = c.convert(css_color::ColorSpace::Srgb)
        let ok = c.convert(css_color::ColorSpace::Oklab)
        let p3 = c.convert(css_color::ColorSpace::DisplayP3)
        let (r, g, b, a) = c.to_rgba8_clamped()
        io_println(
          world,
          "P|" + i.to_string() + "|" + fmt_f6(srgb.c0) + "|" + fmt_f6(srgb.c1) + "|" + fmt_f6(srgb.c2) + "|" + fmt_f6(srgb.alpha) + "|" + fmt_f6(ok.c0) + "|" + fmt_f6(ok.c1) + "|" + fmt_f6(ok.c2) + "|" + fmt_f6(p3.c0) + "|" + fmt_f6(p3.c1) + "|" + fmt_f6(p3.c2) + "|" + r.to_string() + "|" + g.to_string() + "|" + b.to_string() + "|" + a.to_string(),
        )
      }
      Err(e) => {
        io_println(world, "P_ERR|" + i.to_string() + "|" + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  let mix_lines = split_lines(mix_text)
  i = 0
  while i < mix_lines.length() {
    let parts = split_pipe(mix_lines[i])
    let expr = parts[6]
    match css_color::parse(expr) {
      Ok(c) => {
        let srgb = c.convert(css_color::ColorSpace::Srgb)
        let (r, g, b, a) = c.to_rgba8_clamped()
        io_println(
          world,
          "M|" + i.to_string() + "|" + fmt_f6(srgb.c0) + "|" + fmt_f6(srgb.c1) + "|" + fmt_f6(srgb.c2) + "|" + fmt_f6(srgb.alpha) + "|" + r.to_string() + "|" + g.to_string() + "|" + b.to_string() + "|" + a.to_string(),
        )
      }
      Err(e) => {
        io_println(world, "M_ERR|" + i.to_string() + "|" + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  let gamut_lines = split_lines(gamut_text)
  i = 0
  while i < gamut_lines.length() {
    match css_color::parse(gamut_lines[i]) {
      Ok(c) => {
        let mapped = c.to_gamut(css_color::ColorSpace::Srgb)
        let ok_orig = c.convert(css_color::ColorSpace::Oklch)
        let ok_map = mapped.convert(css_color::ColorSpace::Oklch)
        let in_g = if mapped.in_gamut() { "1" } else { "0" }
        io_println(
          world,
          "G|" + i.to_string() + "|" + in_g + "|" + fmt_f6(ok_orig.c2) + "|" + fmt_f6(ok_map.c2) + "|" + fmt_f6(mapped.c0) + "|" + fmt_f6(mapped.c1) + "|" + fmt_f6(mapped.c2),
        )
      }
      Err(e) => {
        io_println(world, "G_ERR|" + i.to_string() + "|" + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  0
}

fn run_bench_parse(world : World, parse_path : String, iters : Int) -> Int {
  let text = match fs_read(world, parse_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let lines = split_lines(text)
  let n = lines.length()
  let mut ok_count : Int64 = 0L
  let mut acc : Int64 = 0L
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < n {
      match css_color::parse(lines[i]) {
        Ok(c) => {
          ok_count = ok_count + 1L
          let (r, g, b, a) = c.to_rgba8_clamped()
          acc = acc + (r + g + b + a).to_int64()
        }
        Err(_) => return 1
      }
      i = i + 1
    }
    it = it + 1
  }
  io_println(world, "bench_parse ok=" + ok_count.to_string() + " acc=" + acc.to_string())
  0
}

fn run_bench_convert(world : World, parse_path : String, iters : Int) -> Int {
  let text = match fs_read(world, parse_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let lines = split_lines(text)
  let colors : Array[css_color::Color] = []
  let mut i = 0
  while i < lines.length() {
    match css_color::parse(lines[i]) {
      Ok(c) => colors.push(c.convert(css_color::ColorSpace::Srgb))
      Err(_) => return 1
    }
    i = i + 1
  }
  let n = colors.length()
  let mut total : Int64 = 0L
  let mut acc : Int64 = 0L
  let mut it = 0
  while it < iters {
    let mut j = 0
    while j < n {
      let c1 = colors[j].convert(css_color::ColorSpace::Oklch)
      let c2 = c1.convert(css_color::ColorSpace::DisplayP3)
      let c3 = c2.convert(css_color::ColorSpace::Lab)
      let c4 = c3.convert(css_color::ColorSpace::Srgb)
      let (r, g, b, _) = c4.to_rgba8_clamped()
      total = total + 1L
      acc = acc + ((r >> 2) + (g >> 2) + (b >> 2)).to_int64()
      j = j + 1
    }
    it = it + 1
  }
  io_println(world, "bench_convert ops=" + total.to_string() + " acc=" + acc.to_string())
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_css_color <diff|bench_parse|bench_convert> ...")
    return 1
  }
  let cmd = args[1]
  if cmd == "diff" && args.length() >= 5 {
    run_diff(world, args[2], args[3], args[4])
  } else if cmd == "bench_parse" && args.length() >= 4 {
    run_bench_parse(world, args[2], parse_int_arg(args[3]))
  } else if cmd == "bench_convert" && args.length() >= 4 {
    run_bench_convert(world, args[2], parse_int_arg(args[3]))
  } else {
    io_println(world, "unknown command: " + cmd)
    1
  }
}
