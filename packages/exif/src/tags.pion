fn dms_to_degrees(rats : Array[Rational]) -> Option[Double] {
  if rats.length() < 3 {
    return None
  }
  let d = match rats[0].to_double() {
    Some(v) => v
    None => return None
  }
  let m = match rats[1].to_double() {
    Some(v) => v
    None => return None
  }
  let s = match rats[2].to_double() {
    Some(v) => v
    None => return None
  }
  Some(d + m / 60.0 + s / 3600.0)
}

///| Decode GPS `(latitude, longitude)` in signed decimal degrees.
///| Returns `None` if tags are missing, any denominator is 0, ref is invalid, or range is out of bounds.
pub fn Exif::gps_coords(self : Exif) -> Option[(Double, Double)] {
  let lat_ref = match self.get(Ifd::Gps, 0x0001) {
    Some(f) =>
    match f.as_string() {
      Some(s) => s
      None => return None
    }
    None => return None
  }
  let lat_rats = match self.get(Ifd::Gps, 0x0002) {
    Some(f) =>
    match f.value {
      FieldValue::Rational(a) => a
      _ => return None
    }
    None => return None
  }
  let lon_ref = match self.get(Ifd::Gps, 0x0003) {
    Some(f) =>
    match f.as_string() {
      Some(s) => s
      None => return None
    }
    None => return None
  }
  let lon_rats = match self.get(Ifd::Gps, 0x0004) {
    Some(f) =>
    match f.value {
      FieldValue::Rational(a) => a
      _ => return None
    }
    None => return None
  }

  let lat_sign = if lat_ref == "N" || lat_ref == "n" {
    1.0
  } else if lat_ref == "S" || lat_ref == "s" {
    -1.0
  } else {
    return None
  }
  let lon_sign = if lon_ref == "E" || lon_ref == "e" {
    1.0
  } else if lon_ref == "W" || lon_ref == "w" {
    -1.0
  } else {
    return None
  }

  let lat_abs = match dms_to_degrees(lat_rats) {
    Some(v) => v
    None => return None
  }
  let lon_abs = match dms_to_degrees(lon_rats) {
    Some(v) => v
    None => return None
  }
  if lat_abs < 0.0 || lat_abs > 90.0 || lon_abs < 0.0 || lon_abs > 180.0 {
    return None
  }
  Some((lat_abs * lat_sign, lon_abs * lon_sign))
}

///| Decode GPS altitude in meters (negative when `GPSAltitudeRef == 1`).
pub fn Exif::gps_altitude(self : Exif) -> Option[Double] {
  let alt_val = match self.get(Ifd::Gps, 0x0006) {
    Some(f) =>
    match f.as_rational() {
      Some(r) =>
      match r.to_double() {
        Some(v) => v
        None => return None
      }
      None => return None
    }
    None => return None
  }
  let sign = match self.get(Ifd::Gps, 0x0005) {
    Some(f) =>
    match f.as_int() {
      Some(0) => 1.0
      Some(1) => -1.0
      _ => return None
    }
    None => 1.0
  }
  Some(alt_val * sign)
}

fn hex_nibble(n : Int) -> Byte {
  let v = n & 0xF
  if v < 10 { (48 + v).to_byte() } else { (87 + v).to_byte() }
}

fn write_hex4(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte(hex_nibble(v >> 12))
  sb.write_byte(hex_nibble(v >> 8))
  sb.write_byte(hex_nibble(v >> 4))
  sb.write_byte(hex_nibble(v))
}

fn write_hex2(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte(hex_nibble(v >> 4))
  sb.write_byte(hex_nibble(v))
}

fn field_type_label(field_type : Int) -> String {
  match field_type {
    1 => "BYTE"
    2 => "ASCII"
    3 => "SHORT"
    4 | 13 => "LONG"
    5 => "RATIONAL"
    6 => "SBYTE"
    7 => "UNDEFINED"
    8 => "SSHORT"
    9 => "SLONG"
    10 => "SRATIONAL"
    11 => "FLOAT"
    12 => "DOUBLE"
    _ => "UNKNOWN"
  }
}

fn write_field_value_canonical(sb : StringBuilder, fv : FieldValue) -> Unit {
  match fv {
    FieldValue::Byte(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::Ascii(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x7C.to_byte())
        }
        sb.write_string(a[i])
        i = i + 1
      }
    }
    FieldValue::Short(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::Long(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::Rational(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].num.to_string())
        sb.write_byte(0x2F.to_byte())
        sb.write_string(a[i].den.to_string())
        i = i + 1
      }
    }
    FieldValue::SByte(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::Undefined(b) => {
      let mut i = 0
      while i < b.length() {
        write_hex2(sb, b[i].to_int())
        i = i + 1
      }
    }
    FieldValue::SShort(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::SLong(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::SRational(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].num.to_string())
        sb.write_byte(0x2F.to_byte())
        sb.write_string(a[i].den.to_string())
        i = i + 1
      }
    }
    FieldValue::Float(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    FieldValue::Double(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
  }
}

///| Deterministic canonical formatting of all parsed fields (sorted by IFD rank, then tag)
///| for byte-for-byte cross-language SHA-256 verification.
pub fn Exif::format_canonical(self : Exif) -> String {
  let n = self.entries.length()
  let idx = FixedArray::make(n, 0)
  let mut i = 0
  while i < n {
    idx[i] = i
    i = i + 1
  }
  // Insertion sort on indices by (ifd.rank(), tag)
  i = 1
  while i < n {
    let key = idx[i]
    let kf = self.entries[key]
    let kr = kf.ifd.rank()
    let kt = kf.tag
    let mut j = i - 1
    while j >= 0 {
      let jf = self.entries[idx[j]]
      let jr = jf.ifd.rank()
      if jr > kr || (jr == kr && jf.tag > kt) {
        idx[j + 1] = idx[j]
        j = j - 1
      } else {
        break
      }
    }
    idx[j + 1] = key
    i = i + 1
  }

  let sb = StringBuilder::new()
  sb.write_string("BO=")
  sb.write_string(self.byte_order.to_string())
  sb.write_byte(0x0A.to_byte())
  i = 0
  while i < n {
    let f = self.entries[idx[i]]
    sb.write_string(f.ifd.to_string())
    sb.write_string(" 0x")
    write_hex4(sb, f.tag)
    sb.write_byte(0x20.to_byte())
    sb.write_string(field_type_label(f.field_type))
    sb.write_byte(0x20.to_byte())
    write_field_value_canonical(sb, f.value)
    sb.write_byte(0x0A.to_byte())
    i = i + 1
  }
  sb.to_string()
}
