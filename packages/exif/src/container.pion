///| Container extraction (JPEG APP1, WebP EXIF chunk, PNG eXIf chunk) and auto-detection.

fn slice_bytes(data : Bytes, start : Int, len : Int) -> Bytes {
  data.slice(start, start + len)
}

fn match_bytes4(data : Bytes, pos : Int, a : Int, b : Int, c : Int, d : Int) -> Bool {
  data[pos].to_int() == a &&
  data[pos + 1].to_int() == b &&
  data[pos + 2].to_int() == c &&
  data[pos + 3].to_int() == d
}

fn match_exif_prefix(data : Bytes, pos : Int) -> Bool {
  // "Exif\x00\x00"
  data[pos].to_int() == 0x45 &&
  data[pos + 1].to_int() == 0x78 &&
  data[pos + 2].to_int() == 0x69 &&
  data[pos + 3].to_int() == 0x66 &&
  data[pos + 4].to_int() == 0x00 &&
  data[pos + 5].to_int() == 0x00
}

fn is_png_signature(data : Bytes) -> Bool {
  data.length() >= 8 &&
  data[0].to_int() == 0x89 &&
  data[1].to_int() == 0x50 &&
  data[2].to_int() == 0x4E &&
  data[3].to_int() == 0x47 &&
  data[4].to_int() == 0x0D &&
  data[5].to_int() == 0x0A &&
  data[6].to_int() == 0x1A &&
  data[7].to_int() == 0x0A
}

fn is_tiff_header(data : Bytes) -> Bool {
  if data.length() < 4 {
    return false
  }
  let b0 = data[0].to_int()
  let b1 = data[1].to_int()
  let b2 = data[2].to_int()
  let b3 = data[3].to_int()
  (b0 == 0x49 && b1 == 0x49 && b2 == 0x2A && b3 == 0x00) ||
  (b0 == 0x4D && b1 == 0x4D && b2 == 0x00 && b3 == 0x2A)
}

///| Locate `(offset, length)` of raw TIFF bytes inside a JPEG APP1 EXIF segment without copying.
fn find_jpeg_exif_range(data : Bytes) -> Result[(Int, Int), ExifError] {
  let n = data.length()
  if n < 2 {
    return Err(ExifError::UnexpectedEof("JPEG requires at least 2 bytes"))
  }
  if data[0].to_int() != 0xFF || data[1].to_int() != 0xD8 {
    return Err(ExifError::InvalidFormat("missing JPEG SOI marker (0xFFD8)"))
  }
  let mut pos = 2
  while pos < n {
    // Resynchronize across stray non-0xFF bytes between markers before SOS (matching libjpeg next_marker)
    while pos < n && data[pos].to_int() != 0xFF {
      pos = pos + 1
    }
    if pos >= n {
      return Err(ExifError::NotFound("no EXIF APP1 segment in JPEG"))
    }
    // Skip any number of 0xFF fill bytes
    while pos < n && data[pos].to_int() == 0xFF {
      pos = pos + 1
    }
    if pos >= n {
      return Err(ExifError::UnexpectedEof("truncated JPEG marker"))
    }
    let marker = data[pos].to_int()
    pos = pos + 1

    // Stop at SOS (0xDA) or EOI (0xD9)
    if marker == 0xD9 || marker == 0xDA {
      return Err(ExifError::NotFound("no EXIF APP1 segment in JPEG"))
    }
    // Standalone markers without payload length: 0x00, TEM (0x01), RST0..RST7 (0xD0..0xD7), SOI (0xD8)
    if marker == 0x00 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD8) {
      continue
    }
    if n - pos < 2 {
      return Err(ExifError::UnexpectedEof("truncated JPEG segment length"))
    }
    let seg_len = (data[pos].to_int() << 8) | data[pos + 1].to_int()
    if seg_len < 2 {
      return Err(ExifError::InvalidFormat("JPEG segment length < 2"))
    }
    let payload_len = seg_len - 2
    let payload_start = pos + 2
    if payload_len > n - payload_start {
      return Err(ExifError::UnexpectedEof("truncated JPEG segment payload"))
    }
    if marker == 0xE1 && payload_len >= 6 && match_exif_prefix(data, payload_start) {
      return Ok((payload_start + 6, payload_len - 6))
    }
    pos = payload_start + payload_len
  }
  Err(ExifError::NotFound("no EXIF APP1 segment in JPEG"))
}

///| Locate `(offset, length)` of raw TIFF bytes inside a WebP EXIF chunk without copying.
fn find_webp_exif_range(data : Bytes) -> Result[(Int, Int), ExifError] {
  let n = data.length()
  if n < 12 {
    return Err(ExifError::UnexpectedEof("WebP requires at least 12 bytes"))
  }
  if !match_bytes4(data, 0, 0x52, 0x49, 0x46, 0x46) {
    return Err(ExifError::InvalidFormat("missing RIFF magic"))
  }
  if !match_bytes4(data, 8, 0x57, 0x45, 0x42, 0x50) {
    return Err(ExifError::InvalidFormat("missing WEBP form type"))
  }
  let riff_size : Int64 = data[4].to_int().to_int64() |
  (data[5].to_int().to_int64() << 8) |
  (data[6].to_int().to_int64() << 16) |
  (data[7].to_int().to_int64() << 24)
  if riff_size < 4L {
    return Err(ExifError::InvalidFormat("RIFF chunk size < 4"))
  }
  let n64 = n.to_int64()
  let declared_end = 8L + riff_size
  let limit_end = if declared_end < n64 { declared_end } else { n64 }

  let mut pos = 12L
  while pos + 8L <= limit_end {
    let p = pos.to_int()
    let chunk_size : Int64 = data[p + 4].to_int().to_int64() |
    (data[p + 5].to_int().to_int64() << 8) |
    (data[p + 6].to_int().to_int64() << 16) |
    (data[p + 7].to_int().to_int64() << 24)
    let payload_start = pos + 8L
    if chunk_size > limit_end - payload_start {
      return Err(ExifError::UnexpectedEof("truncated WebP chunk"))
    }
    // "EXIF"
    if match_bytes4(data, p, 0x45, 0x58, 0x49, 0x46) {
      let start = payload_start.to_int()
      let len = chunk_size.to_int()
      // Compatible with both raw TIFF and "Exif\x00\x00"-prefixed EXIF chunks
      if len >= 6 && match_exif_prefix(data, start) {
        return Ok((start + 6, len - 6))
      }
      return Ok((start, len))
    }
    let pad = chunk_size & 1L
    pos = payload_start + chunk_size + pad
  }
  Err(ExifError::NotFound("no EXIF chunk in WebP"))
}

///| Locate `(offset, length)` of raw TIFF bytes inside a PNG eXIf chunk without copying.
fn find_png_exif_range(data : Bytes) -> Result[(Int, Int), ExifError] {
  let n = data.length()
  if !is_png_signature(data) {
    return Err(ExifError::InvalidFormat("missing PNG signature"))
  }
  let n64 = n.to_int64()
  let mut pos = 8L
  while pos + 12L <= n64 {
    let p = pos.to_int()
    let chunk_len : Int64 = (data[p].to_int().to_int64() << 24) |
    (data[p + 1].to_int().to_int64() << 16) |
    (data[p + 2].to_int().to_int64() << 8) |
    data[p + 3].to_int().to_int64()
    if chunk_len > 0x7FFFFFFFL {
      return Err(ExifError::InvalidFormat("PNG chunk length exceeds 2^31-1"))
    }
    if chunk_len > n64 - (pos + 12L) {
      return Err(ExifError::UnexpectedEof("truncated PNG chunk"))
    }
    // "eXIf"
    if match_bytes4(data, p + 4, 0x65, 0x58, 0x49, 0x66) {
      return Ok(((pos + 8L).to_int(), chunk_len.to_int()))
    }
    // "IEND"
    if match_bytes4(data, p + 4, 0x49, 0x45, 0x4E, 0x44) {
      return Err(ExifError::NotFound("no eXIf chunk in PNG"))
    }
    pos = pos + 12L + chunk_len
  }
  Err(ExifError::NotFound("no eXIf chunk in PNG"))
}

///| Extract raw TIFF bytes from a JPEG image's EXIF APP1 segment.
pub fn extract_from_jpeg(data : Bytes) -> Result[Bytes, ExifError] {
  match find_jpeg_exif_range(data) {
    Ok((start, len)) => Ok(slice_bytes(data, start, len))
    Err(e) => Err(e)
  }
}

///| Extract raw TIFF bytes from a WebP image's EXIF chunk.
pub fn extract_from_webp(data : Bytes) -> Result[Bytes, ExifError] {
  match find_webp_exif_range(data) {
    Ok((start, len)) => Ok(slice_bytes(data, start, len))
    Err(e) => Err(e)
  }
}

///| Extract raw TIFF bytes from a PNG image's eXIf chunk.
pub fn extract_from_png(data : Bytes) -> Result[Bytes, ExifError] {
  match find_png_exif_range(data) {
    Ok((start, len)) => Ok(slice_bytes(data, start, len))
    Err(e) => Err(e)
  }
}

///| Auto-detect JPEG / WebP / PNG / raw TIFF and parse EXIF metadata with default limits.
pub fn parse(data : Bytes) -> Result[Exif, ExifError] {
  parse_with_limits(data, ExifLimits::default())
}

///| Auto-detect JPEG / WebP / PNG / raw TIFF and parse EXIF metadata with custom limits.
pub fn parse_with_limits(data : Bytes, limits : ExifLimits) -> Result[Exif, ExifError] {
  let n = data.length()
  if n >= 2 && data[0].to_int() == 0xFF && data[1].to_int() == 0xD8 {
    match find_jpeg_exif_range(data) {
      Ok((start, len)) => return parse_tiff_range(data, start, len, limits)
      Err(e) => return Err(e)
    }
  }
  if n >= 12 &&
  match_bytes4(data, 0, 0x52, 0x49, 0x46, 0x46) &&
  match_bytes4(data, 8, 0x57, 0x45, 0x42, 0x50) {
    match find_webp_exif_range(data) {
      Ok((start, len)) => return parse_tiff_range(data, start, len, limits)
      Err(e) => return Err(e)
    }
  }
  if is_png_signature(data) {
    match find_png_exif_range(data) {
      Ok((start, len)) => return parse_tiff_range(data, start, len, limits)
      Err(e) => return Err(e)
    }
  }
  if is_tiff_header(data) {
    return parse_tiff_range(data, 0, n, limits)
  }
  Err(ExifError::InvalidFormat("unrecognized image or TIFF header"))
}
