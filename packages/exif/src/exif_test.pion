///| Comprehensive unit, compliance, container, and red-team security test suite for `packages/exif`.

fn assert_eq_int(a : Int, b : Int, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_i64(a : Int64, b : Int64, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_str(a : String, b : String, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got '" + a + "', expected '" + b + "'")
}

fn assert_eq_bool(a : Bool, b : Bool, msg : String) -> Unit {
  debug_assert(a == b, msg)
}

fn assert_near(a : Double, b : Double, eps : Double, msg : String) -> Unit {
  let diff = if a >= b { a - b } else { b - a }
  debug_assert(diff <= eps, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn buf_push_u8(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
}

fn buf_push_u16(buf : Array[Int], v : Int, be : Bool) -> Unit {
  if be {
    buf.push((v >> 8) & 0xFF)
    buf.push(v & 0xFF)
  } else {
    buf.push(v & 0xFF)
    buf.push((v >> 8) & 0xFF)
  }
}

fn buf_push_u32(buf : Array[Int], v : Int64, be : Bool) -> Unit {
  if be {
    buf.push(((v >> 24) & 0xFFL).to_int())
    buf.push(((v >> 16) & 0xFFL).to_int())
    buf.push(((v >> 8) & 0xFFL).to_int())
    buf.push((v & 0xFFL).to_int())
  } else {
    buf.push((v & 0xFFL).to_int())
    buf.push(((v >> 8) & 0xFFL).to_int())
    buf.push(((v >> 16) & 0xFFL).to_int())
    buf.push(((v >> 24) & 0xFFL).to_int())
  }
}

fn buf_push_u64(buf : Array[Int], v : Int64, be : Bool) -> Unit {
  if be {
    buf.push(((v >> 56) & 0xFFL).to_int())
    buf.push(((v >> 48) & 0xFFL).to_int())
    buf.push(((v >> 40) & 0xFFL).to_int())
    buf.push(((v >> 32) & 0xFFL).to_int())
    buf.push(((v >> 24) & 0xFFL).to_int())
    buf.push(((v >> 16) & 0xFFL).to_int())
    buf.push(((v >> 8) & 0xFFL).to_int())
    buf.push((v & 0xFFL).to_int())
  } else {
    buf.push((v & 0xFFL).to_int())
    buf.push(((v >> 8) & 0xFFL).to_int())
    buf.push(((v >> 16) & 0xFFL).to_int())
    buf.push(((v >> 24) & 0xFFL).to_int())
    buf.push(((v >> 32) & 0xFFL).to_int())
    buf.push(((v >> 40) & 0xFFL).to_int())
    buf.push(((v >> 48) & 0xFFL).to_int())
    buf.push(((v >> 56) & 0xFFL).to_int())
  }
}

fn buf_push_str(buf : Array[Int], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn buf_push_bytes(buf : Array[Int], b : Bytes) -> Unit {
  let n = b.length()
  let mut i = 0
  while i < n {
    buf.push(b[i].to_int())
    i = i + 1
  }
}

fn buf_to_bytes(buf : Array[Int]) -> Bytes {
  let n = buf.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = buf[i].to_byte()
    i = i + 1
  }
  b
}

fn bytes_prefix(data : Bytes, len : Int) -> Bytes {
  let mut out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = data[i]
    i = i + 1
  }
  out
}

///| Build a minimal TIFF containing one IFD0 entry: Orientation = `ori`.
///| Critically verifies BE left-alignment (`00 06 00 00` for BE Short 6).
fn build_orientation_tiff(ori : Int, be : Bool) -> Bytes {
  let buf : Array[Int] = []
  if be {
    buf_push_str(buf, "MM")
  } else {
    buf_push_str(buf, "II")
  }
  buf_push_u16(buf, 42, be)
  buf_push_u32(buf, 8L, be)
  // IFD0 at offset 8: 1 entry
  buf_push_u16(buf, 1, be)
  // Tag 0x0112 (Orientation), Type 3 (Short), Count 1
  buf_push_u16(buf, 0x0112, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  // Inline 4-byte slot: value is left-aligned (bytes 0..1), followed by 2 padding bytes!
  buf_push_u16(buf, ori, be)
  buf_push_u16(buf, 0, be)
  // next_ifd = 0
  buf_push_u32(buf, 0L, be)
  buf_to_bytes(buf)
}

///| Build a rich TIFF with all 12 TIFF/EXIF types in either LE or BE.
fn build_all_12_types_tiff(be : Bool) -> Bytes {
  let buf : Array[Int] = []
  if be {
    buf_push_str(buf, "MM")
  } else {
    buf_push_str(buf, "II")
  }
  buf_push_u16(buf, 42, be)
  buf_push_u32(buf, 8L, be)

  // IFD0 at offset 8: 12 entries -> 2 + 12*12 + 4 = 150 bytes -> data area starts at 158
  let data_base : Int64 = 158L
  let ext : Array[Int] = []

  buf_push_u16(buf, 12, be)

  // 1. Type 1 (Byte), count 2 inline: [0x2A, 0xFE] -> left-aligned [2A, FE, 00, 00]
  buf_push_u16(buf, 0x8001, be)
  buf_push_u16(buf, 1, be)
  buf_push_u32(buf, 2L, be)
  buf_push_u8(buf, 0x2A)
  buf_push_u8(buf, 0xFE)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)

  // 2. Type 2 (Ascii), count 10 external: "PionCamera\0"
  let off_ascii = data_base + ext.length().to_int64()
  buf_push_str(ext, "PionCamera")
  buf_push_u8(ext, 0)
  buf_push_u16(buf, 0x010F, be) // Make
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 11L, be)
  buf_push_u32(buf, off_ascii, be)

  // 3. Type 3 (Short), count 1 inline: 6 (Orientation = Rotate90CW)
  buf_push_u16(buf, 0x0112, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u16(buf, 6, be)
  buf_push_u16(buf, 0, be)

  // 4. Type 4 (Long), count 1 inline: 3000000000 (> i32::MAX, tests u32 in Int64)
  buf_push_u16(buf, 0x8004, be)
  buf_push_u16(buf, 4, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, 3000000000L, be)

  // 5. Type 5 (Rational), count 1 external: 300/1
  let off_rat = data_base + ext.length().to_int64()
  buf_push_u32(ext, 300L, be)
  buf_push_u32(ext, 1L, be)
  buf_push_u16(buf, 0x011A, be) // XResolution
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_rat, be)

  // 6. Type 6 (SByte), count 3 inline: [-128, -1, 127]
  buf_push_u16(buf, 0x8006, be)
  buf_push_u16(buf, 6, be)
  buf_push_u32(buf, 3L, be)
  buf_push_u8(buf, 0x80)
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0x7F)
  buf_push_u8(buf, 0x00)

  // 7. Type 7 (Undefined), count 4 inline: "0232"
  buf_push_u16(buf, 0x8007, be)
  buf_push_u16(buf, 7, be)
  buf_push_u32(buf, 4L, be)
  buf_push_str(buf, "0232")

  // 8. Type 8 (SShort), count 2 inline: [-1000, 1234]
  buf_push_u16(buf, 0x8008, be)
  buf_push_u16(buf, 8, be)
  buf_push_u32(buf, 2L, be)
  buf_push_u16(buf, -1000 & 0xFFFF, be)
  buf_push_u16(buf, 1234, be)

  // 9. Type 9 (SLong), count 1 inline: -123456
  buf_push_u16(buf, 0x8009, be)
  buf_push_u16(buf, 9, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, -123456L & 0xFFFFFFFFL, be)

  // 10. Type 10 (SRational), count 1 external: -5 / 2
  let off_srat = data_base + ext.length().to_int64()
  buf_push_u32(ext, -5L & 0xFFFFFFFFL, be)
  buf_push_u32(ext, 2L, be)
  buf_push_u16(buf, 0x800A, be)
  buf_push_u16(buf, 10, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_srat, be)

  // 11. Type 11 (Float), count 1 inline: -3.5f32 = 0xC0600000
  buf_push_u16(buf, 0x800B, be)
  buf_push_u16(buf, 11, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, 0xC0600000L, be)

  // 12. Type 12 (Double), count 1 external: 3.141592653589793 = 0x400921FB54442D18
  let off_dbl = data_base + ext.length().to_int64()
  buf_push_u64(ext, 0x400921FB54442D18L, be)
  buf_push_u16(buf, 0x800C, be)
  buf_push_u16(buf, 12, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_dbl, be)

  // next_ifd = 0
  buf_push_u32(buf, 0L, be)

  // append ext data
  let mut i = 0
  while i < ext.length() {
    buf.push(ext[i])
    i = i + 1
  }
  buf_to_bytes(buf)
}

///| Build a full camera-like TIFF with IFD0 + ExifIFD + GPSIFD + InteropIFD + IFD1.
fn build_full_camera_tiff(
  lat_ref : String,
  lon_ref : String,
  alt_ref : Int,
  be : Bool,
) -> Bytes {
  let buf : Array[Int] = []
  if be {
    buf_push_str(buf, "MM")
  } else {
    buf_push_str(buf, "II")
  }
  buf_push_u16(buf, 42, be)
  buf_push_u32(buf, 8L, be)

  // Layout plan:
  // IFD0 at 8: 9 entries -> 2 + 9*12 + 4 = 114 bytes -> ends at 122
  // ExifIFD at 122: 9 entries -> 2 + 9*12 + 4 = 114 bytes -> ends at 236
  // GPSIFD at 236: 6 entries -> 2 + 6*12 + 4 = 78 bytes -> ends at 314
  // InteropIFD at 314: 2 entries -> 2 + 2*12 + 4 = 30 bytes -> ends at 344
  // IFD1 at 344: 1 entry -> 2 + 1*12 + 4 = 18 bytes -> ends at 362
  // External data starts at 362.
  let off_exif : Int64 = 122L
  let off_gps : Int64 = 236L
  let off_interop : Int64 = 314L
  let off_ifd1 : Int64 = 344L
  let data_base : Int64 = 362L
  let ext : Array[Int] = []

  // Helper closures via inline push:
  let off_make = data_base + ext.length().to_int64()
  buf_push_str(ext, "Apple")
  buf_push_u8(ext, 0)

  let off_model = data_base + ext.length().to_int64()
  buf_push_str(ext, "iPhone 16 Pro")
  buf_push_u8(ext, 0)

  let off_sw = data_base + ext.length().to_int64()
  buf_push_str(ext, "18.1")
  buf_push_u8(ext, 0)

  let off_dt = data_base + ext.length().to_int64()
  buf_push_str(ext, "2026:11:24 09:30:00")
  buf_push_u8(ext, 0)

  let off_xres = data_base + ext.length().to_int64()
  buf_push_u32(ext, 72L, be)
  buf_push_u32(ext, 1L, be)

  let off_yres = data_base + ext.length().to_int64()
  buf_push_u32(ext, 72L, be)
  buf_push_u32(ext, 1L, be)

  let off_exp = data_base + ext.length().to_int64()
  buf_push_u32(ext, 1L, be)
  buf_push_u32(ext, 125L, be)

  let off_fnum = data_base + ext.length().to_int64()
  buf_push_u32(ext, 178L, be)
  buf_push_u32(ext, 100L, be)

  let off_focal = data_base + ext.length().to_int64()
  buf_push_u32(ext, 6765L, be)
  buf_push_u32(ext, 1000L, be)

  let off_lens = data_base + ext.length().to_int64()
  buf_push_str(ext, "iPhone 16 Pro back triple camera")
  buf_push_u8(ext, 0)

  let off_lat = data_base + ext.length().to_int64()
  // 35 deg 40 min 34.5 sec -> 35.67625
  buf_push_u32(ext, 35L, be)
  buf_push_u32(ext, 1L, be)
  buf_push_u32(ext, 40L, be)
  buf_push_u32(ext, 1L, be)
  buf_push_u32(ext, 3450L, be)
  buf_push_u32(ext, 100L, be)

  let off_lon = data_base + ext.length().to_int64()
  // 139 deg 45 min 0 sec -> 139.75
  buf_push_u32(ext, 139L, be)
  buf_push_u32(ext, 1L, be)
  buf_push_u32(ext, 45L, be)
  buf_push_u32(ext, 1L, be)
  buf_push_u32(ext, 0L, be)
  buf_push_u32(ext, 1L, be)

  let off_alt = data_base + ext.length().to_int64()
  buf_push_u32(ext, 425L, be)
  buf_push_u32(ext, 10L, be)

  // --- IFD0 (9 entries) ---
  buf_push_u16(buf, 9, be)
  // Make (0x010F)
  buf_push_u16(buf, 0x010F, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 6L, be)
  buf_push_u32(buf, off_make, be)
  // Model (0x0110)
  buf_push_u16(buf, 0x0110, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 14L, be)
  buf_push_u32(buf, off_model, be)
  // Orientation (0x0112) = 6
  buf_push_u16(buf, 0x0112, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u16(buf, 6, be)
  buf_push_u16(buf, 0, be)
  // XResolution (0x011A)
  buf_push_u16(buf, 0x011A, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_xres, be)
  // YResolution (0x011B)
  buf_push_u16(buf, 0x011B, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_yres, be)
  // Software (0x0131)
  buf_push_u16(buf, 0x0131, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 5L, be)
  buf_push_u32(buf, off_sw, be)
  // DateTime (0x0132)
  buf_push_u16(buf, 0x0132, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 20L, be)
  buf_push_u32(buf, off_dt, be)
  // ExifIFDPointer (0x8769)
  buf_push_u16(buf, 0x8769, be)
  buf_push_u16(buf, 4, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_exif, be)
  // GPSInfoIFDPointer (0x8825)
  buf_push_u16(buf, 0x8825, be)
  buf_push_u16(buf, 4, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_gps, be)
  // next_ifd -> IFD1
  buf_push_u32(buf, off_ifd1, be)

  // --- ExifIFD (9 entries) ---
  buf_push_u16(buf, 9, be)
  // ExposureTime (0x829A)
  buf_push_u16(buf, 0x829A, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_exp, be)
  // FNumber (0x829D)
  buf_push_u16(buf, 0x829D, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_fnum, be)
  // ISO (0x8827) = 64
  buf_push_u16(buf, 0x8827, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u16(buf, 64, be)
  buf_push_u16(buf, 0, be)
  // DateTimeOriginal (0x9003)
  buf_push_u16(buf, 0x9003, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 20L, be)
  buf_push_u32(buf, off_dt, be)
  // FocalLength (0x920A)
  buf_push_u16(buf, 0x920A, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_focal, be)
  // ColorSpace (0xA001) = 1 (sRGB)
  buf_push_u16(buf, 0xA001, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u16(buf, 1, be)
  buf_push_u16(buf, 0, be)
  // PixelXDimension (0xA002) = 4032
  buf_push_u16(buf, 0xA002, be)
  buf_push_u16(buf, 4, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, 4032L, be)
  // InteropIFDPointer (0xA005)
  buf_push_u16(buf, 0xA005, be)
  buf_push_u16(buf, 4, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_interop, be)
  // LensModel (0xA434)
  buf_push_u16(buf, 0xA434, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 33L, be)
  buf_push_u32(buf, off_lens, be)
  // next_ifd = 0
  buf_push_u32(buf, 0L, be)

  // --- GPSIFD (6 entries) ---
  buf_push_u16(buf, 6, be)
  // GPSLatitudeRef (0x0001)
  buf_push_u16(buf, 0x0001, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 2L, be)
  buf_push_u8(buf, lat_ref.code_unit_at(0))
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  // GPSLatitude (0x0002)
  buf_push_u16(buf, 0x0002, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 3L, be)
  buf_push_u32(buf, off_lat, be)
  // GPSLongitudeRef (0x0003)
  buf_push_u16(buf, 0x0003, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 2L, be)
  buf_push_u8(buf, lon_ref.code_unit_at(0))
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  // GPSLongitude (0x0004)
  buf_push_u16(buf, 0x0004, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 3L, be)
  buf_push_u32(buf, off_lon, be)
  // GPSAltitudeRef (0x0005)
  buf_push_u16(buf, 0x0005, be)
  buf_push_u16(buf, 1, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u8(buf, alt_ref)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  // GPSAltitude (0x0006)
  buf_push_u16(buf, 0x0006, be)
  buf_push_u16(buf, 5, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u32(buf, off_alt, be)
  // next_ifd = 0
  buf_push_u32(buf, 0L, be)

  // --- InteropIFD (2 entries) ---
  buf_push_u16(buf, 2, be)
  // InteroperabilityIndex (0x0001) = "R98\0"
  buf_push_u16(buf, 0x0001, be)
  buf_push_u16(buf, 2, be)
  buf_push_u32(buf, 4L, be)
  buf_push_str(buf, "R98")
  buf_push_u8(buf, 0)
  // InteroperabilityVersion (0x0002) = "0100"
  buf_push_u16(buf, 0x0002, be)
  buf_push_u16(buf, 7, be)
  buf_push_u32(buf, 4L, be)
  buf_push_str(buf, "0100")
  // next_ifd = 0
  buf_push_u32(buf, 0L, be)

  // --- IFD1 (1 entry: Compression = 6 JPEG) ---
  buf_push_u16(buf, 1, be)
  buf_push_u16(buf, 0x0103, be)
  buf_push_u16(buf, 3, be)
  buf_push_u32(buf, 1L, be)
  buf_push_u16(buf, 6, be)
  buf_push_u16(buf, 0, be)
  // next_ifd = 0
  buf_push_u32(buf, 0L, be)

  let mut i = 0
  while i < ext.length() {
    buf.push(ext[i])
    i = i + 1
  }
  buf_to_bytes(buf)
}

fn wrap_jpeg_with_exif(tiff : Bytes) -> Bytes {
  let buf : Array[Int] = []
  // SOI
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xD8)
  // APP0 (JFIF dummy)
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xE0)
  buf_push_u16(buf, 7, true)
  buf_push_str(buf, "JFIF")
  buf_push_u8(buf, 0)
  // Multiple 0xFF fill bytes before XMP APP1
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xE1)
  buf_push_u16(buf, 10, true)
  buf_push_str(buf, "http://x")
  // EXIF APP1
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xE1)
  buf_push_u16(buf, 2 + 6 + tiff.length(), true)
  buf_push_str(buf, "Exif")
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_bytes(buf, tiff)
  // SOS + EOI
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xDA)
  buf_push_u16(buf, 2, true)
  buf_push_u8(buf, 0xFF)
  buf_push_u8(buf, 0xD9)
  buf_to_bytes(buf)
}

fn wrap_webp_with_exif(tiff : Bytes, with_exif_prefix : Bool) -> Bytes {
  let buf : Array[Int] = []
  let exif_payload_len = if with_exif_prefix { 6 + tiff.length() } else { tiff.length() }
  let exif_pad = exif_payload_len & 1
  // Include an odd-sized dummy chunk ("JUNK", 3 bytes -> +1 pad = 12 bytes) before EXIF
  let riff_size : Int64 = (4 + 8 + 3 + 1 + 8 + exif_payload_len + exif_pad).to_int64()
  buf_push_str(buf, "RIFF")
  buf_push_u32(buf, riff_size, false)
  buf_push_str(buf, "WEBP")
  // Odd-sized dummy chunk
  buf_push_str(buf, "JUNK")
  buf_push_u32(buf, 3L, false)
  buf_push_u8(buf, 1)
  buf_push_u8(buf, 2)
  buf_push_u8(buf, 3)
  buf_push_u8(buf, 0) // RIFF even pad
  // EXIF chunk
  buf_push_str(buf, "EXIF")
  buf_push_u32(buf, exif_payload_len.to_int64(), false)
  if with_exif_prefix {
    buf_push_str(buf, "Exif")
    buf_push_u8(buf, 0)
    buf_push_u8(buf, 0)
  }
  buf_push_bytes(buf, tiff)
  if exif_pad == 1 {
    buf_push_u8(buf, 0)
  }
  buf_to_bytes(buf)
}

fn wrap_png_with_exif(tiff : Bytes) -> Bytes {
  let buf : Array[Int] = []
  // PNG signature
  buf_push_u8(buf, 0x89)
  buf_push_u8(buf, 0x50)
  buf_push_u8(buf, 0x4E)
  buf_push_u8(buf, 0x47)
  buf_push_u8(buf, 0x0D)
  buf_push_u8(buf, 0x0A)
  buf_push_u8(buf, 0x1A)
  buf_push_u8(buf, 0x0A)
  // Dummy IHDR chunk (13 bytes)
  buf_push_u32(buf, 13L, true)
  buf_push_str(buf, "IHDR")
  let mut i = 0
  while i < 13 {
    buf_push_u8(buf, 0)
    i = i + 1
  }
  buf_push_u32(buf, 0L, true) // CRC
  // eXIf chunk
  buf_push_u32(buf, tiff.length().to_int64(), true)
  buf_push_str(buf, "eXIf")
  buf_push_bytes(buf, tiff)
  buf_push_u32(buf, 0L, true) // CRC
  // IEND chunk
  buf_push_u32(buf, 0L, true)
  buf_push_str(buf, "IEND")
  buf_push_u32(buf, 0L, true)
  buf_to_bytes(buf)
}

test "orientation_enum_and_properties" {
  let mut k = 1
  while k <= 8 {
    let o = match Orientation::from_int(k) {
      Some(v) => v
      None => {
        debug_assert(false, "Orientation::from_int failed for " + k.to_string())
        Orientation::Normal
      }
    }
    assert_eq_int(o.to_int(), k, "to_int")
    let expected_swap = k >= 5 && k <= 8
    assert_eq_bool(o.swaps_dimensions(), expected_swap, "swaps_dimensions " + k.to_string())
    let expected_flip = k == 2 || k == 4 || k == 5 || k == 7
    assert_eq_bool(o.flip_horizontal(), expected_flip, "flip_horizontal " + k.to_string())
    let expected_deg = if k == 1 || k == 2 {
      0
    } else if k == 3 || k == 4 {
      180
    } else if k == 5 || k == 6 {
      90
    } else {
      270
    }
    assert_eq_int(o.cw_degrees(), expected_deg, "cw_degrees " + k.to_string())
    k = k + 1
  }
  match Orientation::from_int(0) {
    None => ()
    Some(_) => debug_assert(false, "0 must be None")
  }
  match Orientation::from_int(9) {
    None => ()
    Some(_) => debug_assert(false, "9 must be None")
  }
}

test "orientation_le_and_be_left_aligned" {
  let mut ori = 1
  while ori <= 8 {
    let le = build_orientation_tiff(ori, false)
    let be = build_orientation_tiff(ori, true)
    match parse(le) {
      Ok(ex) =>
      match ex.orientation() {
        Some(o) => assert_eq_int(o.to_int(), ori, "LE orientation")
        None => debug_assert(false, "LE orientation missing")
      }
      Err(e) => debug_assert(false, "LE parse failed: " + e.to_string())
    }
    match parse(be) {
      Ok(ex) =>
      match ex.orientation() {
        Some(o) => assert_eq_int(o.to_int(), ori, "BE orientation")
        None => debug_assert(false, "BE orientation missing")
      }
      Err(e) => debug_assert(false, "BE parse failed: " + e.to_string())
    }
    ori = ori + 1
  }
}

test "all_12_tiff_types_le_and_be" {
  let mut pass = 0
  while pass < 2 {
    let be = pass == 1
    let raw = build_all_12_types_tiff(be)
    let ex = match parse_tiff(raw) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "parse_tiff failed (be=" + be.to_string() + "): " + e.to_string())
        Exif::{ byte_order: ByteOrder::LittleEndian, entries: [] }
      }
    }
    assert_eq_int(ex.fields().length(), 12, "field count")
    // 1. Byte
    match ex.get(Ifd::Primary, 0x8001) {
      Some(f) =>
      match f.value {
        FieldValue::Byte(a) => {
          assert_eq_int(a.length(), 2, "byte len")
          assert_eq_int(a[0], 0x2A, "byte[0]")
          assert_eq_int(a[1], 0xFE, "byte[1]")
        }
        _ => debug_assert(false, "expected Byte")
      }
      None => debug_assert(false, "missing Byte")
    }
    // 2. Ascii
    match ex.make() {
      Some(s) => assert_eq_str(s, "PionCamera", "Make")
      None => debug_assert(false, "missing Make")
    }
    // 3. Short
    match ex.orientation() {
      Some(o) => assert_eq_int(o.to_int(), 6, "Orientation")
      None => debug_assert(false, "missing Orientation")
    }
    // 4. Long (u32 > i32::MAX)
    match ex.get(Ifd::Primary, 0x8004) {
      Some(f) =>
      match f.as_uint() {
        Some(v) => assert_eq_i64(v, 3000000000L, "Long u32")
        None => debug_assert(false, "missing Long")
      }
      None => debug_assert(false, "missing Long field")
    }
    // 5. Rational
    match ex.x_resolution() {
      Some(r) => {
        assert_eq_i64(r.num, 300L, "rat num")
        assert_eq_i64(r.den, 1L, "rat den")
      }
      None => debug_assert(false, "missing XResolution")
    }
    // 6. SByte
    match ex.get(Ifd::Primary, 0x8006) {
      Some(f) =>
      match f.value {
        FieldValue::SByte(a) => {
          assert_eq_int(a.length(), 3, "sbyte len")
          assert_eq_int(a[0], -128, "sbyte[0]")
          assert_eq_int(a[1], -1, "sbyte[1]")
          assert_eq_int(a[2], 127, "sbyte[2]")
        }
        _ => debug_assert(false, "expected SByte")
      }
      None => debug_assert(false, "missing SByte")
    }
    // 7. Undefined
    match ex.get(Ifd::Primary, 0x8007) {
      Some(f) =>
      match f.value {
        FieldValue::Undefined(b) => {
          assert_eq_int(b.length(), 4, "undef len")
          assert_eq_int(b[0].to_int(), 0x30, "undef[0]")
          assert_eq_int(b[3].to_int(), 0x32, "undef[3]")
        }
        _ => debug_assert(false, "expected Undefined")
      }
      None => debug_assert(false, "missing Undefined")
    }
    // 8. SShort
    match ex.get(Ifd::Primary, 0x8008) {
      Some(f) =>
      match f.value {
        FieldValue::SShort(a) => {
          assert_eq_int(a.length(), 2, "sshort len")
          assert_eq_int(a[0], -1000, "sshort[0]")
          assert_eq_int(a[1], 1234, "sshort[1]")
        }
        _ => debug_assert(false, "expected SShort")
      }
      None => debug_assert(false, "missing SShort")
    }
    // 9. SLong
    match ex.get(Ifd::Primary, 0x8009) {
      Some(f) =>
      match f.as_int() {
        Some(v) => assert_eq_int(v, -123456, "slong")
        None => debug_assert(false, "missing SLong")
      }
      None => debug_assert(false, "missing SLong field")
    }
    // 10. SRational
    match ex.get(Ifd::Primary, 0x800A) {
      Some(f) =>
      match f.as_srational() {
        Some(r) => {
          assert_eq_int(r.num, -5, "srat num")
          assert_eq_int(r.den, 2, "srat den")
        }
        None => debug_assert(false, "missing SRational")
      }
      None => debug_assert(false, "missing SRational field")
    }
    // 11. Float
    match ex.get(Ifd::Primary, 0x800B) {
      Some(f) =>
      match f.as_double() {
        Some(v) => assert_near(v, -3.5, 1.0e-6, "float -3.5")
        None => debug_assert(false, "missing Float")
      }
      None => debug_assert(false, "missing Float field")
    }
    // 12. Double
    match ex.get(Ifd::Primary, 0x800C) {
      Some(f) =>
      match f.as_double() {
        Some(v) => assert_near(v, 3.141592653589793, 1.0e-12, "double pi")
        None => debug_assert(false, "missing Double")
      }
      None => debug_assert(false, "missing Double field")
    }
    pass = pass + 1
  }
}

test "full_camera_ifds_and_gps_signs" {
  // N/E above sea level (LE)
  let tiff_ne = build_full_camera_tiff("N", "E", 0, false)
  let ex_ne = match parse(tiff_ne) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "full camera LE failed: " + e.to_string())
      Exif::{ byte_order: ByteOrder::LittleEndian, entries: [] }
    }
  }
  assert_eq_str(ex_ne.make().unwrap_or(""), "Apple", "make")
  assert_eq_str(ex_ne.model().unwrap_or(""), "iPhone 16 Pro", "model")
  assert_eq_str(ex_ne.software().unwrap_or(""), "18.1", "software")
  assert_eq_str(ex_ne.date_time().unwrap_or(""), "2026:11:24 09:30:00", "date_time")
  assert_eq_str(ex_ne.date_time_original().unwrap_or(""), "2026:11:24 09:30:00", "dto")
  assert_eq_int(ex_ne.color_space().unwrap_or(-1), 1, "color_space")
  assert_eq_i64(ex_ne.pixel_x_dimension().unwrap_or(-1L), 4032L, "px_x")
  assert_eq_int(ex_ne.iso_speed().unwrap_or(-1), 64, "iso")
  assert_eq_str(
    ex_ne.lens_model().unwrap_or(""),
    "iPhone 16 Pro back triple camera",
    "lens_model",
  )
  match ex_ne.gps_coords() {
    Some((lat, lon)) => {
      assert_near(lat, 35.67625, 1.0e-6, "lat N")
      assert_near(lon, 139.75, 1.0e-6, "lon E")
    }
    None => debug_assert(false, "expected GPS coords N/E")
  }
  match ex_ne.gps_altitude() {
    Some(alt) => assert_near(alt, 42.5, 1.0e-6, "alt above")
    None => debug_assert(false, "expected GPS altitude")
  }
  // InteropIFD & IFD1 present
  match ex_ne.get(Ifd::Interop, 0x0001) {
    Some(_) => ()
    None => debug_assert(false, "InteropIndex")
  }
  match ex_ne.get(Ifd::Thumbnail, 0x0103) {
    Some(_) => ()
    None => debug_assert(false, "IFD1 Compression")
  }
  assert_eq_str(tag_name(Ifd::Primary, 0x0112).unwrap_or(""), "Orientation", "tag_name")

  // S/W below sea level (BE)
  let tiff_sw = build_full_camera_tiff("S", "W", 1, true)
  let ex_sw = match parse(tiff_sw) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "full camera BE failed: " + e.to_string())
      Exif::{ byte_order: ByteOrder::BigEndian, entries: [] }
    }
  }
  match ex_sw.gps_coords() {
    Some((lat, lon)) => {
      assert_near(lat, -35.67625, 1.0e-6, "lat S")
      assert_near(lon, -139.75, 1.0e-6, "lon W")
    }
    None => debug_assert(false, "expected GPS coords S/W")
  }
  match ex_sw.gps_altitude() {
    Some(alt) => assert_near(alt, -42.5, 1.0e-6, "alt below")
    None => debug_assert(false, "expected GPS negative altitude")
  }
}

test "containers_jpeg_webp_png" {
  let tiff = build_orientation_tiff(8, true)

  // JPEG with APP0 + 0xFF fill bytes + XMP APP1 + EXIF APP1
  let jpg = wrap_jpeg_with_exif(tiff)
  match parse(jpg) {
    Ok(ex) => assert_eq_int(ex.orientation().unwrap_or(Orientation::Normal).to_int(), 8, "JPEG ori")
    Err(e) => debug_assert(false, "JPEG parse failed: " + e.to_string())
  }

  // JPEG without EXIF
  let no_exif_jpg = buf_to_bytes([0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x04, 0x00, 0x00, 0xFF, 0xD9])
  match extract_from_jpeg(no_exif_jpg) {
    Err(ExifError::NotFound(_)) => ()
    _ => debug_assert(false, "expected NotFound for JPEG without EXIF")
  }

  // WebP without Exif\0\0 prefix (standard) and with Exif\0\0 prefix (compat)
  let webp1 = wrap_webp_with_exif(tiff, false)
  match parse(webp1) {
    Ok(ex) => assert_eq_int(ex.orientation().unwrap_or(Orientation::Normal).to_int(), 8, "WebP1 ori")
    Err(e) => debug_assert(false, "WebP1 parse failed: " + e.to_string())
  }
  let webp2 = wrap_webp_with_exif(tiff, true)
  match parse(webp2) {
    Ok(ex) => assert_eq_int(ex.orientation().unwrap_or(Orientation::Normal).to_int(), 8, "WebP2 ori")
    Err(e) => debug_assert(false, "WebP2 parse failed: " + e.to_string())
  }

  // PNG eXIf chunk
  let png = wrap_png_with_exif(tiff)
  match parse(png) {
    Ok(ex) => assert_eq_int(ex.orientation().unwrap_or(Orientation::Normal).to_int(), 8, "PNG ori")
    Err(e) => debug_assert(false, "PNG parse failed: " + e.to_string())
  }
}

test "gps_zero_denominator_rejected" {
  // GPSLatitude with denominator 0 -> gps_coords() must return None, never divide by zero
  let buf : Array[Int] = []
  buf_push_str(buf, "II")
  buf_push_u16(buf, 42, false)
  buf_push_u32(buf, 8L, false)
  // IFD0 at 8: 1 entry (GPSInfoIFD -> 26)
  buf_push_u16(buf, 1, false)
  buf_push_u16(buf, 0x8825, false)
  buf_push_u16(buf, 4, false)
  buf_push_u32(buf, 1L, false)
  buf_push_u32(buf, 26L, false)
  buf_push_u32(buf, 0L, false)
  // GPSIFD at 26: 4 entries -> 2 + 48 + 4 = 54 -> data at 80
  buf_push_u16(buf, 4, false)
  buf_push_u16(buf, 0x0001, false)
  buf_push_u16(buf, 2, false)
  buf_push_u32(buf, 2L, false)
  buf_push_u8(buf, 0x4E) // 'N'
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u16(buf, 0x0002, false)
  buf_push_u16(buf, 5, false)
  buf_push_u32(buf, 3L, false)
  buf_push_u32(buf, 80L, false)
  buf_push_u16(buf, 0x0003, false)
  buf_push_u16(buf, 2, false)
  buf_push_u32(buf, 2L, false)
  buf_push_u8(buf, 0x45) // 'E'
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u8(buf, 0)
  buf_push_u16(buf, 0x0004, false)
  buf_push_u16(buf, 5, false)
  buf_push_u32(buf, 3L, false)
  buf_push_u32(buf, 104L, false)
  buf_push_u32(buf, 0L, false)
  // Lat: 35/1, 0/0 (zero den!), 0/1
  buf_push_u32(buf, 35L, false)
  buf_push_u32(buf, 1L, false)
  buf_push_u32(buf, 0L, false)
  buf_push_u32(buf, 0L, false)
  buf_push_u32(buf, 0L, false)
  buf_push_u32(buf, 1L, false)
  // Lon: 139/1, 0/1, 0/1
  buf_push_u32(buf, 139L, false)
  buf_push_u32(buf, 1L, false)
  buf_push_u32(buf, 0L, false)
  buf_push_u32(buf, 1L, false)
  buf_push_u32(buf, 0L, false)
  buf_push_u32(buf, 1L, false)

  match parse_tiff(buf_to_bytes(buf)) {
    Ok(ex) =>
    match ex.gps_coords() {
      None => ()
      Some(_) => debug_assert(false, "zero denominator GPS must return None")
    }
    Err(e) => debug_assert(false, "parse_tiff should succeed: " + e.to_string())
  }
}

test "redteam_cyclic_ifd_and_overflow" {
  // 1. Self-loop IFD0 -> next_ifd = 8
  let self_loop : Array[Int] = []
  buf_push_str(self_loop, "II")
  buf_push_u16(self_loop, 42, false)
  buf_push_u32(self_loop, 8L, false)
  buf_push_u16(self_loop, 0, false)
  buf_push_u32(self_loop, 8L, false) // cycle back to 8!
  match parse_tiff(buf_to_bytes(self_loop)) {
    Err(ExifError::InvalidIfd(_)) => ()
    _ => debug_assert(false, "expected InvalidIfd for IFD0 self-loop")
  }

  // 2. Mutual loop: IFD0 (8) -> ExifIFD (26) -> next_ifd = 8
  let mut_loop : Array[Int] = []
  buf_push_str(mut_loop, "II")
  buf_push_u16(mut_loop, 42, false)
  buf_push_u32(mut_loop, 8L, false)
  buf_push_u16(mut_loop, 1, false)
  buf_push_u16(mut_loop, 0x8769, false)
  buf_push_u16(mut_loop, 4, false)
  buf_push_u32(mut_loop, 1L, false)
  buf_push_u32(mut_loop, 26L, false)
  buf_push_u32(mut_loop, 0L, false)
  // ExifIFD at 26 pointing back to 8 via next_ifd
  buf_push_u16(mut_loop, 0, false)
  buf_push_u32(mut_loop, 8L, false)
  match parse_tiff(buf_to_bytes(mut_loop)) {
    Err(ExifError::InvalidIfd(_)) => ()
    _ => debug_assert(false, "expected InvalidIfd for mutual IFD0<->ExifIFD cycle")
  }

  // 3. Huge count = 0xFFFFFFFF (integer overflow / OOM bomb)
  let bomb : Array[Int] = []
  buf_push_str(bomb, "II")
  buf_push_u16(bomb, 42, false)
  buf_push_u32(bomb, 8L, false)
  buf_push_u16(bomb, 1, false)
  buf_push_u16(bomb, 0x010E, false)
  buf_push_u16(bomb, 12, false) // Double (8 bytes each -> 32 GiB!)
  buf_push_u32(bomb, 0xFFFFFFFFL, false)
  buf_push_u32(bomb, 8L, false)
  buf_push_u32(bomb, 0L, false)
  match parse_tiff(buf_to_bytes(bomb)) {
    Err(ExifError::LimitExceeded(_)) => ()
    Err(ExifError::InvalidValue(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded or InvalidValue for count=0xFFFFFFFF")
  }

  // 4. Out-of-bounds value offset
  let oob : Array[Int] = []
  buf_push_str(oob, "II")
  buf_push_u16(oob, 42, false)
  buf_push_u32(oob, 8L, false)
  buf_push_u16(oob, 1, false)
  buf_push_u16(oob, 0x010F, false)
  buf_push_u16(oob, 2, false)
  buf_push_u32(oob, 16L, false)
  buf_push_u32(oob, 99999L, false)
  buf_push_u32(oob, 0L, false)
  match parse_tiff(buf_to_bytes(oob)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "expected Err for OOB offset")
  }
}

test "redteam_truncation_and_mutation_zero_panic" {
  let tiff = build_full_camera_tiff("N", "E", 0, false)
  let samples = [
    tiff,
    wrap_jpeg_with_exif(tiff),
    wrap_webp_with_exif(tiff, false),
    wrap_png_with_exif(tiff),
  ]
  let mut s = 0
  while s < samples.length() {
    let sample = samples[s]
    let n = sample.length()
    // Exhaustive prefix truncation 0..n (must never panic!)
    let mut cut = 0
    while cut < n {
      let _ = parse(bytes_prefix(sample, cut))
      cut = cut + 1
    }
    // Deterministic byte mutations across header & body (must never panic!)
    let mut pos = 0
    while pos < n {
      let mut mutated = bytes_prefix(sample, n)
      mutated[pos] = (mutated[pos].to_int() ^ 0xFF).to_byte()
      let _ = parse(mutated)
      pos = pos + 7
    }
    s = s + 1
  }
}

test "edge_cases_ascii_float_limits_and_containers" {
  // 1. Multi-string ASCII & missing NUL
  let buf : Array[Int] = []
  buf_push_str(buf, "II")
  buf_push_u16(buf, 42, false)
  buf_push_u32(buf, 8L, false)
  buf_push_u16(buf, 4, false)
  // Entry 1: multi-string ASCII "Hi\0Go\0" (6 bytes at offset 62)
  buf_push_u16(buf, 0x010E, false) // ImageDescription
  buf_push_u16(buf, 2, false)
  buf_push_u32(buf, 6L, false)
  buf_push_u32(buf, 62L, false)
  // Entry 2: Artist without trailing NUL "Ada" (3 bytes inline)
  buf_push_u16(buf, 0x013B, false)
  buf_push_u16(buf, 2, false)
  buf_push_u32(buf, 3L, false)
  buf_push_str(buf, "Ada")
  buf_push_u8(buf, 0)
  // Entry 3: Copyright "2026" (4 bytes inline, no NUL)
  buf_push_u16(buf, 0x8298, false)
  buf_push_u16(buf, 2, false)
  buf_push_u32(buf, 4L, false)
  buf_push_str(buf, "2026")
  // Entry 4: Subnormal Float 0x00000001 (1.401298464324817e-45)
  buf_push_u16(buf, 0x8011, false)
  buf_push_u16(buf, 11, false)
  buf_push_u32(buf, 1L, false)
  buf_push_u32(buf, 1L, false)
  // next_ifd = 0
  buf_push_u32(buf, 0L, false)
  // ext data at offset 62: "Hi\0Go\0"
  buf_push_str(buf, "Hi")
  buf_push_u8(buf, 0)
  buf_push_str(buf, "Go")
  buf_push_u8(buf, 0)

  let ex = match parse_tiff(buf_to_bytes(buf)) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "edge ascii/float failed: " + e.to_string())
      Exif::{ byte_order: ByteOrder::LittleEndian, entries: [] }
    }
  }
  assert_eq_str(ex.image_description().unwrap_or(""), "Hi", "desc[0]")
  match ex.get(Ifd::Primary, 0x010E) {
    Some(f) =>
    match f.value {
      FieldValue::Ascii(a) => {
        assert_eq_int(a.length(), 2, "multi-ascii len")
        assert_eq_str(a[1], "Go", "multi-ascii[1]")
      }
      _ => debug_assert(false, "expected Ascii")
    }
    None => debug_assert(false, "missing desc")
  }
  assert_eq_str(ex.artist().unwrap_or(""), "Ada", "artist")
  assert_eq_str(ex.copyright().unwrap_or(""), "2026", "copyright")
  match ex.get(Ifd::Primary, 0x8011) {
    Some(f) =>
    match f.as_double() {
      Some(v) => debug_assert(v > 0.0 && v < 1.0e-44, "subnormal f32")
      None => debug_assert(false, "missing subnormal float")
    }
    None => debug_assert(false, "missing subnormal field")
  }

  // 2. Custom ExifLimits::new(max_ifds=1) rejects 2-IFD camera TIFF
  let cam = build_full_camera_tiff("N", "E", 0, false)
  match parse_with_limits(cam, ExifLimits::new(1, 4096, 4096, 4194304)) {
    Err(ExifError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded when max_ifds=1")
  }
  match parse_with_limits(cam, ExifLimits::new(32, 2, 4096, 4194304)) {
    Err(ExifError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded when max_entries_per_ifd=2")
  }

  // 3. JPEG with EXIF placed after SOS must return NotFound
  let tiff = build_orientation_tiff(3, false)
  let after_sos : Array[Int] = []
  buf_push_u8(after_sos, 0xFF)
  buf_push_u8(after_sos, 0xD8)
  buf_push_u8(after_sos, 0xFF)
  buf_push_u8(after_sos, 0xDA)
  buf_push_u16(after_sos, 2, true)
  buf_push_u8(after_sos, 0xFF)
  buf_push_u8(after_sos, 0xE1)
  buf_push_u16(after_sos, 2 + 6 + tiff.length(), true)
  buf_push_str(after_sos, "Exif")
  buf_push_u8(after_sos, 0)
  buf_push_u8(after_sos, 0)
  buf_push_bytes(after_sos, tiff)
  match extract_from_jpeg(buf_to_bytes(after_sos)) {
    Err(ExifError::NotFound(_)) => ()
    _ => debug_assert(false, "EXIF after SOS must return NotFound")
  }

  // 4. PNG with chunk length > 0x7FFFFFFF rejected cleanly
  let bad_png : Array[Int] = [
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
    0x80, 0x00, 0x00, 0x00, 0x65, 0x58, 0x49, 0x66,
    0x00, 0x00, 0x00, 0x00,
  ]
  match extract_from_png(buf_to_bytes(bad_png)) {
    Err(ExifError::InvalidFormat(_)) => ()
    _ => debug_assert(false, "PNG chunk length > 2^31-1 must return InvalidFormat")
  }
}

test "canonical_format_deterministic" {
  let le = build_full_camera_tiff("N", "E", 0, false)
  let be = build_full_camera_tiff("N", "E", 0, true)
  let s_le = match parse(le) {
    Ok(ex) => ex.format_canonical()
    Err(e) => {
      debug_assert(false, "le failed: " + e.to_string())
      ""
    }
  }
  let s_be = match parse(be) {
    Ok(ex) => ex.format_canonical()
    Err(e) => {
      debug_assert(false, "be failed: " + e.to_string())
      ""
    }
  }
  // Same length (only BO=II vs BO=MM differs on line 1!)
  assert_eq_int(s_le.length(), s_be.length(), "LE vs BE canonical length")
  debug_assert(s_le.length() > 200, "canonical output non-trivial")
}
