///| TIFF 6.0 / EXIF 2.32 IFD parser (Little-Endian and Big-Endian) with DoS & cycle guards.

fn read_u16(data : Bytes, pos : Int, be : Bool) -> Int {
  if be {
    (data[pos].to_int() << 8) | data[pos + 1].to_int()
  } else {
    data[pos].to_int() | (data[pos + 1].to_int() << 8)
  }
}

fn read_u32_i64(data : Bytes, pos : Int, be : Bool) -> Int64 {
  if be {
    (data[pos].to_int().to_int64() << 24) |
    (data[pos + 1].to_int().to_int64() << 16) |
    (data[pos + 2].to_int().to_int64() << 8) |
    data[pos + 3].to_int().to_int64()
  } else {
    data[pos].to_int().to_int64() |
    (data[pos + 1].to_int().to_int64() << 8) |
    (data[pos + 2].to_int().to_int64() << 16) |
    (data[pos + 3].to_int().to_int64() << 24)
  }
}

fn read_i32(data : Bytes, pos : Int, be : Bool) -> Int {
  let u = read_u32_i64(data, pos, be)
  if u >= 2147483648L {
    (u - 4294967296L).to_int()
  } else {
    u.to_int()
  }
}

fn read_i64_bits(data : Bytes, pos : Int, be : Bool) -> Int64 {
  if be {
    (data[pos].to_int().to_int64() << 56) |
    (data[pos + 1].to_int().to_int64() << 48) |
    (data[pos + 2].to_int().to_int64() << 40) |
    (data[pos + 3].to_int().to_int64() << 32) |
    (data[pos + 4].to_int().to_int64() << 24) |
    (data[pos + 5].to_int().to_int64() << 16) |
    (data[pos + 6].to_int().to_int64() << 8) |
    data[pos + 7].to_int().to_int64()
  } else {
    data[pos].to_int().to_int64() |
    (data[pos + 1].to_int().to_int64() << 8) |
    (data[pos + 2].to_int().to_int64() << 16) |
    (data[pos + 3].to_int().to_int64() << 24) |
    (data[pos + 4].to_int().to_int64() << 32) |
    (data[pos + 5].to_int().to_int64() << 40) |
    (data[pos + 6].to_int().to_int64() << 48) |
    (data[pos + 7].to_int().to_int64() << 56)
  }
}

///| Exact IEEE 754 binary32 -> binary64 widening.
fn f32_bits_to_double(bits : Int64) -> Double {
  let sign = (bits >> 31) & 1L
  let exp = ((bits >> 23) & 0xFFL).to_int()
  let frac = bits & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return Double::from_bits(sign << 63)
    }
    // Subnormal binary32 -> normal binary64
    let mut f = frac
    let mut e = -126
    while (f & 0x800000L) == 0L {
      f = f << 1
      e = e - 1
    }
    let d_exp = (e + 1023).to_int64()
    let d_frac = (f & 0x7FFFFFL) << 29
    return Double::from_bits((sign << 63) | (d_exp << 52) | d_frac)
  }
  if exp == 255 {
    if frac == 0L {
      return Double::from_bits((sign << 63) | (0x7FFL << 52))
    }
    return Double::from_bits((sign << 63) | (0x7FFL << 52) | (frac << 29) | (1L << 51))
  }
  let d_exp = (exp - 127 + 1023).to_int64()
  let d_frac = frac << 29
  Double::from_bits((sign << 63) | (d_exp << 52) | d_frac)
}

fn type_element_size(field_type : Int) -> Int {
  match field_type {
    1 => 1 // Byte
    2 => 1 // Ascii
    3 => 2 // Short
    4 => 4 // Long
    5 => 8 // Rational
    6 => 1 // SByte
    7 => 1 // Undefined
    8 => 2 // SShort
    9 => 4 // SLong
    10 => 8 // SRational
    11 => 4 // Float
    12 => 8 // Double
    13 => 4 // IFD pointer (TIFF Tech Note 1)
    _ => 0
  }
}

fn bytes_to_ascii_string(data : Bytes, start : Int, len : Int) -> String {
  if len <= 0 {
    return ""
  }
  let sb = StringBuilder::with_capacity(len)
  let mut i = 0
  while i < len {
    sb.write_byte(data[start + i])
    i = i + 1
  }
  sb.to_string()
}

fn decode_ascii_list(data : Bytes, start : Int, count : Int) -> Array[String] {
  if count <= 0 {
    return []
  }
  // Fast path: single NUL-terminated or non-terminated ASCII string (99%+ of EXIF tags)
  let mut first_nul = -1
  let mut i = 0
  while i < count {
    if data[start + i].to_int() == 0 {
      first_nul = i
      break
    }
    i = i + 1
  }
  if first_nul < 0 {
    return [bytes_to_ascii_string(data, start, count)]
  }
  if first_nul == count - 1 {
    return [bytes_to_ascii_string(data, start, first_nul)]
  }
  let out : Array[String] = Array::with_capacity(4)
  out.push(bytes_to_ascii_string(data, start, first_nul))
  let mut seg_start = first_nul + 1
  i = seg_start
  while i < count {
    if data[start + i].to_int() == 0 {
      out.push(bytes_to_ascii_string(data, start + seg_start, i - seg_start))
      seg_start = i + 1
    }
    i = i + 1
  }
  if seg_start < count {
    out.push(bytes_to_ascii_string(data, start + seg_start, count - seg_start))
  }
  out
}

fn decode_field_value(
  data : Bytes,
  val_pos : Int,
  field_type : Int,
  count : Int,
  be : Bool,
) -> Result[FieldValue, ExifError] {
  match field_type {
    1 => {
      if count == 1 {
        return Ok(FieldValue::Byte([data[val_pos].to_int()]))
      }
      let arr : Array[Int] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        arr.push(data[val_pos + i].to_int())
        i = i + 1
      }
      Ok(FieldValue::Byte(arr))
    }
    2 => Ok(FieldValue::Ascii(decode_ascii_list(data, val_pos, count)))
    3 => {
      if count == 1 {
        return Ok(FieldValue::Short([read_u16(data, val_pos, be)]))
      }
      let arr : Array[Int] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        arr.push(read_u16(data, val_pos + i * 2, be))
        i = i + 1
      }
      Ok(FieldValue::Short(arr))
    }
    4 | 13 => {
      if count == 1 {
        return Ok(FieldValue::Long([read_u32_i64(data, val_pos, be)]))
      }
      let arr : Array[Int64] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        arr.push(read_u32_i64(data, val_pos + i * 4, be))
        i = i + 1
      }
      Ok(FieldValue::Long(arr))
    }
    5 => {
      if count == 1 {
        return Ok(
          FieldValue::Rational(
            [
              Rational::{
                num: read_u32_i64(data, val_pos, be),
                den: read_u32_i64(data, val_pos + 4, be),
              },
            ],
          ),
        )
      }
      let arr : Array[Rational] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let p = val_pos + i * 8
        let num = read_u32_i64(data, p, be)
        let den = read_u32_i64(data, p + 4, be)
        arr.push(Rational::{ num: num, den: den })
        i = i + 1
      }
      Ok(FieldValue::Rational(arr))
    }
    6 => {
      let arr : Array[Int] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let b = data[val_pos + i].to_int()
        arr.push(if b >= 128 { b - 256 } else { b })
        i = i + 1
      }
      Ok(FieldValue::SByte(arr))
    }
    7 => {
      let mut out = Bytes::new(count)
      let mut i = 0
      while i < count {
        out[i] = data[val_pos + i]
        i = i + 1
      }
      Ok(FieldValue::Undefined(out))
    }
    8 => {
      let arr : Array[Int] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let u = read_u16(data, val_pos + i * 2, be)
        arr.push(if u >= 32768 { u - 65536 } else { u })
        i = i + 1
      }
      Ok(FieldValue::SShort(arr))
    }
    9 => {
      let arr : Array[Int] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        arr.push(read_i32(data, val_pos + i * 4, be))
        i = i + 1
      }
      Ok(FieldValue::SLong(arr))
    }
    10 => {
      let arr : Array[SRational] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let p = val_pos + i * 8
        let num = read_i32(data, p, be)
        let den = read_i32(data, p + 4, be)
        arr.push(SRational::{ num: num, den: den })
        i = i + 1
      }
      Ok(FieldValue::SRational(arr))
    }
    11 => {
      let arr : Array[Double] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let bits = read_u32_i64(data, val_pos + i * 4, be)
        arr.push(f32_bits_to_double(bits))
        i = i + 1
      }
      Ok(FieldValue::Float(arr))
    }
    12 => {
      let arr : Array[Double] = Array::with_capacity(count)
      let mut i = 0
      while i < count {
        let bits = read_i64_bits(data, val_pos + i * 8, be)
        arr.push(Double::from_bits(bits))
        i = i + 1
      }
      Ok(FieldValue::Double(arr))
    }
    _ => Err(ExifError::InvalidValue("unknown TIFF field type " + field_type.to_string()))
  }
}

fn contains_i64(arr : Array[Int64], target : Int64) -> Bool {
  let n = arr.length()
  let mut i = 0
  while i < n {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

struct IfdWorkItem {
  ifd : Ifd
  offset : Int64
}

///| Parse a TIFF/EXIF byte range `[base .. base + tiff_len)` inside `data` without copying.
fn parse_tiff_range(
  data : Bytes,
  base : Int,
  tiff_len : Int,
  limits : ExifLimits,
) -> Result[Exif, ExifError] {
  if tiff_len < 8 || base < 0 || base > data.length() || tiff_len > data.length() - base {
    return Err(ExifError::UnexpectedEof("TIFF header requires at least 8 bytes"))
  }
  let b0 = data[base].to_int()
  let b1 = data[base + 1].to_int()
  let be = if b0 == 0x49 && b1 == 0x49 {
    false
  } else if b0 == 0x4D && b1 == 0x4D {
    true
  } else {
    return Err(ExifError::InvalidFormat("invalid TIFF byte order marker"))
  }
  let magic = read_u16(data, base + 2, be)
  if magic != 42 {
    return Err(ExifError::InvalidFormat("invalid TIFF magic (expected 42)"))
  }
  let ifd0_offset = read_u32_i64(data, base + 4, be)
  let tiff_len64 = tiff_len.to_int64()
  if ifd0_offset < 8L || ifd0_offset >= tiff_len64 {
    return Err(ExifError::InvalidIfd("IFD0 offset out of bounds"))
  }

  let entries : Array[Field] = Array::with_capacity(32)
  let visited : Array[Int64] = Array::with_capacity(8)
  let queue : Array[IfdWorkItem] = Array::with_capacity(8)
  queue.push(IfdWorkItem::{ ifd: Ifd::Primary, offset: ifd0_offset })
  let mut q_idx = 0
  let mut total_entries = 0
  let mut total_payload : Int64 = 0L
  let max_payload64 = limits.max_payload_bytes.to_int64()

  while q_idx < queue.length() {
    let item = queue[q_idx]
    q_idx = q_idx + 1
    let ifd = item.ifd
    let offset = item.offset

    if contains_i64(visited, offset) {
      return Err(ExifError::InvalidIfd("cyclic IFD offset " + offset.to_string()))
    }
    if visited.length() >= limits.max_ifds {
      return Err(ExifError::LimitExceeded("max IFD count exceeded"))
    }
    if offset < 8L || offset + 2L > tiff_len64 {
      return Err(ExifError::UnexpectedEof("IFD offset out of bounds"))
    }
    visited.push(offset)

    let ifd_pos = base + offset.to_int()
    let num_entries = read_u16(data, ifd_pos, be)
    if num_entries > limits.max_entries_per_ifd {
      return Err(ExifError::LimitExceeded("IFD entry count exceeds max_entries_per_ifd"))
    }
    if total_entries + num_entries > limits.max_total_entries {
      return Err(ExifError::LimitExceeded("total IFD entry count exceeds max_total_entries"))
    }
    let dir_bytes : Int64 = 2L + num_entries.to_int64() * 12L + 4L
    if offset + dir_bytes > tiff_len64 {
      return Err(ExifError::UnexpectedEof("truncated IFD directory"))
    }

    let mut exif_sub_off : Int64 = 0L
    let mut gps_sub_off : Int64 = 0L
    let mut interop_sub_off : Int64 = 0L

    let mut i = 0
    while i < num_entries {
      let entry_pos = ifd_pos + 2 + i * 12
      let tag = read_u16(data, entry_pos, be)
      let field_type = read_u16(data, entry_pos + 2, be)
      let count64 = read_u32_i64(data, entry_pos + 4, be)

      let elem_size = type_element_size(field_type)
      if elem_size == 0 {
        return Err(ExifError::InvalidValue("unsupported TIFF type " + field_type.to_string()))
      }
      // 64-bit multiplication: count64 <= 0xFFFFFFFFL, elem_size <= 8 -> never overflows Int64
      let byte_len : Int64 = count64 * elem_size.to_int64()
      if byte_len > max_payload64 - total_payload {
        return Err(ExifError::LimitExceeded("EXIF payload bytes limit exceeded"))
      }
      total_payload = total_payload + byte_len

      // Inline values (<= 4 bytes) sit left-aligned at entry_pos + 8 in both LE and BE!
      let val_pos = if byte_len <= 4L {
        entry_pos + 8
      } else {
        let val_off = read_u32_i64(data, entry_pos + 8, be)
        if val_off < 0L || val_off > tiff_len64 - byte_len {
          return Err(ExifError::InvalidValue("field value offset out of bounds"))
        }
        base + val_off.to_int()
      }

      // Sub-IFD pointer tags (ExifIFD=0x8769, GPSInfoIFD=0x8825, InteropIFD=0xA005)
      // are consumed to traverse child IFDs rather than emitted as user fields (matching kamadak-exif).
      let mut is_sub_ifd_ptr = false
      if tag == 0x8769 && (field_type == 4 || field_type == 13) && count64 == 1L {
        match ifd {
          Ifd::Primary | Ifd::Thumbnail => {
            let ptr = read_u32_i64(data, val_pos, be)
            if ptr != 0L {
              exif_sub_off = ptr
            }
            is_sub_ifd_ptr = true
          }
          _ => ()
        }
      } else if tag == 0x8825 && (field_type == 4 || field_type == 13) && count64 == 1L {
        match ifd {
          Ifd::Primary | Ifd::Thumbnail => {
            let ptr = read_u32_i64(data, val_pos, be)
            if ptr != 0L {
              gps_sub_off = ptr
            }
            is_sub_ifd_ptr = true
          }
          _ => ()
        }
      } else if tag == 0xA005 && (field_type == 4 || field_type == 13) && count64 == 1L {
        match ifd {
          Ifd::Exif | Ifd::Primary => {
            let ptr = read_u32_i64(data, val_pos, be)
            if ptr != 0L {
              interop_sub_off = ptr
            }
            is_sub_ifd_ptr = true
          }
          _ => ()
        }
      }

      if !is_sub_ifd_ptr {
        let count_int = count64.to_int()
        let value = match decode_field_value(data, val_pos, field_type, count_int, be) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        entries.push(
          Field::{
            ifd: ifd,
            tag: tag,
            field_type: field_type,
            count: count_int,
            value: value,
          },
        )
      }
      total_entries = total_entries + 1

      i = i + 1
    }

    // Queue sub-IFDs
    if exif_sub_off != 0L {
      queue.push(IfdWorkItem::{ ifd: Ifd::Exif, offset: exif_sub_off })
    }
    if gps_sub_off != 0L {
      queue.push(IfdWorkItem::{ ifd: Ifd::Gps, offset: gps_sub_off })
    }
    if interop_sub_off != 0L {
      queue.push(IfdWorkItem::{ ifd: Ifd::Interop, offset: interop_sub_off })
    }

    // Check next_ifd pointer
    let next_ifd = read_u32_i64(data, ifd_pos + 2 + num_entries * 12, be)
    if next_ifd != 0L {
      if contains_i64(visited, next_ifd) {
        return Err(ExifError::InvalidIfd("cyclic next_ifd offset " + next_ifd.to_string()))
      }
      match ifd {
        Ifd::Primary => queue.push(IfdWorkItem::{ ifd: Ifd::Thumbnail, offset: next_ifd })
        Ifd::Thumbnail => queue.push(IfdWorkItem::{ ifd: Ifd::Other(2), offset: next_ifd })
        Ifd::Other(k) => queue.push(IfdWorkItem::{ ifd: Ifd::Other(k + 1), offset: next_ifd })
        _ => ()
      }
    }
  }

  let byte_order = if be { ByteOrder::BigEndian } else { ByteOrder::LittleEndian }
  Ok(Exif::{ byte_order: byte_order, entries: entries })
}

///| Parse raw TIFF/EXIF bytes with default security limits.
pub fn parse_tiff(data : Bytes) -> Result[Exif, ExifError] {
  parse_tiff_with_limits(data, ExifLimits::default())
}

///| Parse raw TIFF/EXIF bytes with custom security limits.
pub fn parse_tiff_with_limits(data : Bytes, limits : ExifLimits) -> Result[Exif, ExifError] {
  parse_tiff_range(data, 0, data.length(), limits)
}
