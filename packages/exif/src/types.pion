///| Public types, errors, limits, orientation helpers, and metadata containers for `packages/exif`.
///| Pure Pion TIFF 6.0 / EXIF 2.32 parser with JPEG, WebP, and PNG container extraction.

///| Default maximum number of IFDs parsed per EXIF payload.
pub let default_max_ifds : Int = 32

///| Default maximum number of entries per IFD.
pub let default_max_entries_per_ifd : Int = 4096

///| Default maximum total number of entries across all IFDs.
pub let default_max_total_entries : Int = 4096

///| Default maximum total decoded value payload bytes (4 MiB).
pub let default_max_payload_bytes : Int = 4194304

///| Error returned when extracting or parsing EXIF/TIFF metadata.
pub enum ExifError {
  UnexpectedEof(String)
  NotFound(String)
  InvalidFormat(String)
  InvalidIfd(String)
  InvalidValue(String)
  LimitExceeded(String)
}

///| Human-readable description of an `ExifError`.
pub fn exif_error_message(err : ExifError) -> String {
  match err {
    ExifError::UnexpectedEof(msg) => "unexpected EOF: " + msg
    ExifError::NotFound(msg) => "EXIF not found: " + msg
    ExifError::InvalidFormat(msg) => "invalid format: " + msg
    ExifError::InvalidIfd(msg) => "invalid IFD: " + msg
    ExifError::InvalidValue(msg) => "invalid value: " + msg
    ExifError::LimitExceeded(msg) => "limit exceeded: " + msg
  }
}

///|
pub fn ExifError::to_string(self : ExifError) -> String {
  exif_error_message(self)
}

///| Security limits guarding against malformed or malicious EXIF payloads.
pub val struct ExifLimits {
  pub max_ifds : Int
  pub max_entries_per_ifd : Int
  pub max_total_entries : Int
  pub max_payload_bytes : Int
}

///| Default limits (32 IFDs, 4096 entries/IFD, 4096 total entries, 4 MiB payload).
pub fn ExifLimits::default() -> ExifLimits {
  ExifLimits::{
    max_ifds: default_max_ifds,
    max_entries_per_ifd: default_max_entries_per_ifd,
    max_total_entries: default_max_total_entries,
    max_payload_bytes: default_max_payload_bytes,
  }
}

///| Create custom EXIF parser limits.
pub fn ExifLimits::new(
  max_ifds : Int,
  max_entries_per_ifd : Int,
  max_total_entries : Int,
  max_payload_bytes : Int,
) -> ExifLimits {
  ExifLimits::{
    max_ifds: max_ifds,
    max_entries_per_ifd: max_entries_per_ifd,
    max_total_entries: max_total_entries,
    max_payload_bytes: max_payload_bytes,
  }
}

///| Byte order of the TIFF header (`II` = LittleEndian, `MM` = BigEndian).
pub enum ByteOrder {
  LittleEndian
  BigEndian
}

///|
pub fn ByteOrder::to_string(self : ByteOrder) -> String {
  match self {
    ByteOrder::LittleEndian => "II"
    ByteOrder::BigEndian => "MM"
  }
}

///| Image File Directory (IFD) identifier.
pub enum Ifd {
  Primary
  Thumbnail
  Exif
  Gps
  Interop
  Other(Int)
}

///| Deterministic ordering rank for `Ifd`.
pub fn Ifd::rank(self : Ifd) -> Int {
  match self {
    Ifd::Primary => 0
    Ifd::Exif => 1
    Ifd::Gps => 2
    Ifd::Interop => 3
    Ifd::Thumbnail => 4
    Ifd::Other(n) => 10 + n
  }
}

///| Structural equality for `Ifd`.
pub fn Ifd::equals(self : Ifd, other : Ifd) -> Bool {
  match (self, other) {
    (Ifd::Primary, Ifd::Primary) => true
    (Ifd::Thumbnail, Ifd::Thumbnail) => true
    (Ifd::Exif, Ifd::Exif) => true
    (Ifd::Gps, Ifd::Gps) => true
    (Ifd::Interop, Ifd::Interop) => true
    (Ifd::Other(a), Ifd::Other(b)) => a == b
    _ => false
  }
}

///|
pub fn Ifd::to_string(self : Ifd) -> String {
  match self {
    Ifd::Primary => "IFD0"
    Ifd::Thumbnail => "IFD1"
    Ifd::Exif => "ExifIFD"
    Ifd::Gps => "GPSIFD"
    Ifd::Interop => "InteropIFD"
    Ifd::Other(n) => "IFD" + n.to_string()
  }
}

///| Unsigned 32-bit rational (`num / den`), stored in `Int64` to preserve full u32 range.
pub val struct Rational {
  pub num : Int64
  pub den : Int64
}

///|
pub fn Rational::new(num : Int64, den : Int64) -> Rational {
  Rational::{ num: num, den: den }
}

///| Convert to `Double`, returning `None` if denominator is 0.
pub fn Rational::to_double(self : Rational) -> Option[Double] {
  if self.den == 0L {
    None
  } else {
    Some(self.num.to_double() / self.den.to_double())
  }
}

///|
pub fn Rational::to_string(self : Rational) -> String {
  self.num.to_string() + "/" + self.den.to_string()
}

///| Signed 32-bit rational (`num / den`).
pub val struct SRational {
  pub num : Int
  pub den : Int
}

///|
pub fn SRational::new(num : Int, den : Int) -> SRational {
  SRational::{ num: num, den: den }
}

///| Convert to `Double`, returning `None` if denominator is 0.
pub fn SRational::to_double(self : SRational) -> Option[Double] {
  if self.den == 0 {
    None
  } else {
    Some(self.num.to_double() / self.den.to_double())
  }
}

///|
pub fn SRational::to_string(self : SRational) -> String {
  self.num.to_string() + "/" + self.den.to_string()
}

///| All 12 standard TIFF 6.0 / EXIF 2.32 field value types.
pub enum FieldValue {
  Byte(Array[Int])
  Ascii(Array[String])
  Short(Array[Int])
  Long(Array[Int64])
  Rational(Array[Rational])
  SByte(Array[Int])
  Undefined(Bytes)
  SShort(Array[Int])
  SLong(Array[Int])
  SRational(Array[SRational])
  Float(Array[Double])
  Double(Array[Double])
}

///| A single parsed EXIF/TIFF tag entry.
pub struct Field {
  pub ifd : Ifd
  pub tag : Int
  pub field_type : Int
  pub count : Int
  pub value : FieldValue
}

///| Extract first unsigned integer value if this field is Byte, Short, or Long.
pub fn Field::as_uint(self : Field) -> Option[Int64] {
  match self.value {
    FieldValue::Byte(a) => if a.length() > 0 { Some(a[0].to_int64()) } else { None }
    FieldValue::Short(a) => if a.length() > 0 { Some(a[0].to_int64()) } else { None }
    FieldValue::Long(a) => if a.length() > 0 { Some(a[0]) } else { None }
    _ => None
  }
}

///| Extract first signed/unsigned integer as `Int` (for small tags like Orientation, ColorSpace, ISO).
pub fn Field::as_int(self : Field) -> Option[Int] {
  match self.value {
    FieldValue::Byte(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::Short(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::Long(a) =>
    if a.length() > 0 && a[0] >= -2147483648L && a[0] <= 2147483647L {
      Some(a[0].to_int())
    } else {
      None
    }
    FieldValue::SByte(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::SShort(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::SLong(a) => if a.length() > 0 { Some(a[0]) } else { None }
    _ => None
  }
}

///| Extract first ASCII string value.
pub fn Field::as_string(self : Field) -> Option[String] {
  match self.value {
    FieldValue::Ascii(a) => if a.length() > 0 { Some(a[0]) } else { None }
    _ => None
  }
}

///| Extract first unsigned `Rational` value.
pub fn Field::as_rational(self : Field) -> Option[Rational] {
  match self.value {
    FieldValue::Rational(a) => if a.length() > 0 { Some(a[0]) } else { None }
    _ => None
  }
}

///| Extract first signed `SRational` value.
pub fn Field::as_srational(self : Field) -> Option[SRational] {
  match self.value {
    FieldValue::SRational(a) => if a.length() > 0 { Some(a[0]) } else { None }
    _ => None
  }
}

///| Extract first numeric value as `Double` (Float, Double, Rational, SRational, or integer).
pub fn Field::as_double(self : Field) -> Option[Double] {
  match self.value {
    FieldValue::Double(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::Float(a) => if a.length() > 0 { Some(a[0]) } else { None }
    FieldValue::Rational(a) => if a.length() > 0 { a[0].to_double() } else { None }
    FieldValue::SRational(a) => if a.length() > 0 { a[0].to_double() } else { None }
    FieldValue::Byte(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    FieldValue::Short(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    FieldValue::Long(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    FieldValue::SByte(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    FieldValue::SShort(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    FieldValue::SLong(a) => if a.length() > 0 { Some(a[0].to_double()) } else { None }
    _ => None
  }
}

///| EXIF Orientation tag (0x0112) values 1..8.
///| Transform decomposition: rotate clockwise by `cw_degrees()`, then flip horizontally if `flip_horizontal()`.
pub enum Orientation {
  Normal
  FlipHorizontal
  Rotate180
  FlipVertical
  Transpose
  Rotate90CW
  Transverse
  Rotate270CW
}

///| Parse EXIF orientation integer (1..8).
pub fn Orientation::from_int(n : Int) -> Option[Orientation] {
  match n {
    1 => Some(Orientation::Normal)
    2 => Some(Orientation::FlipHorizontal)
    3 => Some(Orientation::Rotate180)
    4 => Some(Orientation::FlipVertical)
    5 => Some(Orientation::Transpose)
    6 => Some(Orientation::Rotate90CW)
    7 => Some(Orientation::Transverse)
    8 => Some(Orientation::Rotate270CW)
    _ => None
  }
}

///| Convert `Orientation` to its EXIF integer code (1..8).
pub fn Orientation::to_int(self : Orientation) -> Int {
  match self {
    Orientation::Normal => 1
    Orientation::FlipHorizontal => 2
    Orientation::Rotate180 => 3
    Orientation::FlipVertical => 4
    Orientation::Transpose => 5
    Orientation::Rotate90CW => 6
    Orientation::Transverse => 7
    Orientation::Rotate270CW => 8
  }
}

///| Clockwise rotation in degrees (0, 90, 180, or 270) applied before optional horizontal flip.
pub fn Orientation::cw_degrees(self : Orientation) -> Int {
  match self {
    Orientation::Normal => 0
    Orientation::FlipHorizontal => 0
    Orientation::Rotate180 => 180
    Orientation::FlipVertical => 180
    Orientation::Transpose => 90
    Orientation::Rotate90CW => 90
    Orientation::Transverse => 270
    Orientation::Rotate270CW => 270
  }
}

///| Whether a horizontal flip is applied after rotating by `cw_degrees()`.
pub fn Orientation::flip_horizontal(self : Orientation) -> Bool {
  match self {
    Orientation::FlipHorizontal => true
    Orientation::FlipVertical => true
    Orientation::Transpose => true
    Orientation::Transverse => true
    _ => false
  }
}

///| Whether the display orientation swaps image width and height (values 5, 6, 7, 8).
pub fn Orientation::swaps_dimensions(self : Orientation) -> Bool {
  match self {
    Orientation::Transpose => true
    Orientation::Rotate90CW => true
    Orientation::Transverse => true
    Orientation::Rotate270CW => true
    _ => false
  }
}

///|
pub fn Orientation::to_string(self : Orientation) -> String {
  match self {
    Orientation::Normal => "Normal"
    Orientation::FlipHorizontal => "FlipHorizontal"
    Orientation::Rotate180 => "Rotate180"
    Orientation::FlipVertical => "FlipVertical"
    Orientation::Transpose => "Transpose"
    Orientation::Rotate90CW => "Rotate90CW"
    Orientation::Transverse => "Transverse"
    Orientation::Rotate270CW => "Rotate270CW"
  }
}

///| Parsed EXIF metadata container.
pub struct Exif {
  pub byte_order : ByteOrder
  pub entries : Array[Field]
}

///| Return all parsed EXIF fields.
pub fn Exif::fields(self : Exif) -> Array[Field] {
  self.entries
}
