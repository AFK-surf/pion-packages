///| Wasm32 + Native 4-mode smoke entry for `packages/exif`.

import "exif"

fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn fnv1a64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ (s.code_unit_at(i) & 0xFF).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

fn smoke() -> (Int, UInt64) {
  let mut acc : UInt64 = 0UL

  // 1. Big-Endian TIFF with Orientation=6 (BE left-aligned 00 06 00 00)
  let be_tiff = mk_bytes([
    0x4D, 0x4D, 0x00, 0x2A, 0x00, 0x00, 0x00, 0x08,
    0x00, 0x01,
    0x01, 0x12, 0x00, 0x03, 0x00, 0x00, 0x00, 0x01, 0x00, 0x06, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
  ])
  match exif::parse(be_tiff) {
    Ok(ex) => {
      match ex.orientation() {
        Some(o) => {
          if o.to_int() != 6 || o.cw_degrees() != 90 || !o.swaps_dimensions() || o.flip_horizontal() {
            return (-1, 0UL)
          }
        }
        None => return (-2, 0UL)
      }
      acc = acc ^ fnv1a64_str(ex.format_canonical())
    }
    Err(_) => return (-3, 0UL)
  }

  // 2. JPEG container wrapping LE TIFF with Orientation=8
  let jpeg = mk_bytes([
    0xFF, 0xD8,
    0xFF, 0xFF, 0xE1, 0x00, 0x22,
    0x45, 0x78, 0x69, 0x66, 0x00, 0x00,
    0x49, 0x49, 0x2A, 0x00, 0x08, 0x00, 0x00, 0x00,
    0x01, 0x00,
    0x12, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
    0xFF, 0xD9,
  ])
  match exif::parse(jpeg) {
    Ok(ex) => {
      match ex.orientation() {
        Some(o) => if o.to_int() != 8 || o.cw_degrees() != 270 { return (-4, 0UL) }
        None => return (-5, 0UL)
      }
      acc = acc ^ fnv1a64_str(ex.format_canonical())
    }
    Err(_) => return (-6, 0UL)
  }

  // 3. WebP container wrapping LE TIFF with Orientation=3
  let webp = mk_bytes([
    0x52, 0x49, 0x46, 0x46, 0x26, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x45, 0x58, 0x49, 0x46, 0x1A, 0x00, 0x00, 0x00,
    0x49, 0x49, 0x2A, 0x00, 0x08, 0x00, 0x00, 0x00,
    0x01, 0x00,
    0x12, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
  ])
  match exif::parse(webp) {
    Ok(ex) => {
      match ex.orientation() {
        Some(o) => if o.to_int() != 3 || o.cw_degrees() != 180 { return (-7, 0UL) }
        None => return (-8, 0UL)
      }
      acc = acc ^ fnv1a64_str(ex.format_canonical())
    }
    Err(_) => return (-9, 0UL)
  }

  // 4. PNG eXIf container wrapping LE TIFF with Orientation=2
  let png = mk_bytes([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
    0x00, 0x00, 0x00, 0x1A, 0x65, 0x58, 0x49, 0x66,
    0x49, 0x49, 0x2A, 0x00, 0x08, 0x00, 0x00, 0x00,
    0x01, 0x00,
    0x12, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  match exif::parse(png) {
    Ok(ex) => {
      match ex.orientation() {
        Some(o) => if o.to_int() != 2 || !o.flip_horizontal() { return (-10, 0UL) }
        None => return (-11, 0UL)
      }
      acc = acc ^ fnv1a64_str(ex.format_canonical())
    }
    Err(_) => return (-12, 0UL)
  }

  // 5. Cyclic IFD0 self-loop rejected cleanly
  let cycle = mk_bytes([
    0x49, 0x49, 0x2A, 0x00, 0x08, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x08, 0x00, 0x00, 0x00,
  ])
  match exif::parse_tiff(cycle) {
    Err(exif::ExifError::InvalidIfd(_)) => ()
    _ => return (-13, 0UL)
  }

  (5, acc)
}

pub fn main(world : World) -> Int {
  let (checks, hash) = smoke()
  if checks > 0 {
    io_println(
      world,
      "exif_wasm_smoke: OK checks=" + checks.to_string() + " fnv64=" + hash.to_string(),
    )
    0
  } else {
    io_println(world, "exif_wasm_smoke: FAIL code=" + checks.to_string())
    1
  }
}
