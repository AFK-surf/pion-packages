///| Pion Native head-to-head benchmark for `packages/exif`.
///| Usage: pion_exif_bench <corpus_dir> <iters>

import "exif"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_exif_bench <corpus_dir> <iters>")
    return 1
  }
  let dir = args[1]
  let iters = parse_int(args[2])
  let names = ["camera_iphone.jpg", "camera_be.tiff", "photo_webp.webp", "photo_png.png"]
  let blobs : Array[Bytes] = []
  let mut k = 0
  while k < names.length() {
    match fs_read_bytes(world, dir + "/" + names[k]) {
      Ok(b) => blobs.push(b)
      Err(_) => {
        io_println(world, "failed to read " + names[k])
        return 1
      }
    }
    k = k + 1
  }

  let mut checksum : Int64 = 0L
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < blobs.length() {
      match exif::parse(blobs[i]) {
        Ok(ex) => {
          let ori = match ex.orientation() {
            Some(o) => o.to_int()
            None => 0
          }
          let cs = ex.color_space().unwrap_or(0)
          checksum = checksum + ori.to_int64() + cs.to_int64() + ex.fields().length().to_int64()
        }
        Err(e) => {
          io_println(world, "parse error: " + e.to_string())
          return 1
        }
      }
      i = i + 1
    }
    it = it + 1
  }

  let sb = StringBuilder::new()
  sb.write_string("CHECKSUM=")
  sb.write_string(checksum.to_string())
  sb.write_byte(0x0A.to_byte())
  k = 0
  while k < blobs.length() {
    match exif::parse(blobs[k]) {
      Ok(ex) => {
        sb.write_string("=== ")
        sb.write_string(names[k])
        sb.write_string(" ===\n")
        sb.write_string(ex.format_canonical())
      }
      Err(e) => {
        io_println(world, "final parse error: " + e.to_string())
        return 1
      }
    }
    k = k + 1
  }
  io_print(world, sb.to_string())
  0
}
