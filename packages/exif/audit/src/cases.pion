///| Red-team cases for `packages/exif`. Every case returns "" on PASS or a failure reason.
///| `redteam_*` cases assert what a correct parser must do and FAIL while the finding of the same id
///| (REPORT.md) is open. `control_*` cases pin attacks and edge cases the parser already handles.
///| The same functions run under `pionc test` (redteam_test.pion / control_test.pion) and, one process per
///| case, under `exif_audit case <name>` in native debug/release and wasm32 debug/release (run_audit.sh).

import "exif"

// ---------------------------------------------------------------------------------------------
// tiny TIFF writer: header + IFDs laid out back to back from offset 8, then an optional data tail
// ---------------------------------------------------------------------------------------------

///| One IFD entry: tag, type, count and the raw 4-byte value/offset slot (already in file byte order).
pub struct RtEnt {
  tag : Int
  typ : Int
  count : Int64
  slot : Array[Int]
}

///|
fn ent(tag : Int, typ : Int, count : Int64, slot : Array[Int]) -> RtEnt {
  RtEnt::{ tag: tag, typ: typ, count: count, slot: slot }
}

///| SHORT value, left-aligned in the 4-byte slot (TIFF 6.0 §2: also in big-endian files).
fn s16(be : Bool, v : Int) -> Array[Int] {
  if be {
    [(v >> 8) & 0xFF, v & 0xFF, 0, 0]
  } else {
    [v & 0xFF, (v >> 8) & 0xFF, 0, 0]
  }
}

///| LONG value (or an offset) in the 4-byte slot.
fn s32(be : Bool, v : Int64) -> Array[Int] {
  let b0 = ((v >> 24) & 0xFFL).to_int()
  let b1 = ((v >> 16) & 0xFFL).to_int()
  let b2 = ((v >> 8) & 0xFFL).to_int()
  let b3 = (v & 0xFFL).to_int()
  if be {
    [b0, b1, b2, b3]
  } else {
    [b3, b2, b1, b0]
  }
}

///|
fn push16(o : Array[Int], be : Bool, v : Int) -> Unit {
  let s = s16(be, v)
  o.push(s[0])
  o.push(s[1])
}

///|
fn push32(o : Array[Int], be : Bool, v : Int64) -> Unit {
  let s = s32(be, v)
  o.push(s[0])
  o.push(s[1])
  o.push(s[2])
  o.push(s[3])
}

///| Offset of IFD `k` when IFDs with `counts[i]` entries are laid out back to back from offset 8.
fn ifd_off(counts : Array[Int], k : Int) -> Int64 {
  let mut off = 8
  let mut i = 0
  while i < k {
    off = off + 2 + 12 * counts[i] + 4
    i = i + 1
  }
  off.to_int64()
}

///| Bytes of a TIFF: IFDs back to back (next pointers from `nexts`, 0 = none), then `tail`.
fn tiff(be : Bool, ifds : Array[Array[RtEnt]], nexts : Array[Int64], tail : Array[Int]) -> Bytes {
  let o : Array[Int] = []
  if be {
    o.push(0x4D)
    o.push(0x4D)
  } else {
    o.push(0x49)
    o.push(0x49)
  }
  push16(o, be, 42)
  push32(o, be, 8L)
  let mut k = 0
  while k < ifds.length() {
    let es = ifds[k]
    push16(o, be, es.length())
    let mut i = 0
    while i < es.length() {
      push16(o, be, es[i].tag)
      push16(o, be, es[i].typ)
      push32(o, be, es[i].count)
      let mut j = 0
      while j < 4 {
        o.push(es[i].slot[j])
        j = j + 1
      }
      i = i + 1
    }
    push32(o, be, nexts[k])
    k = k + 1
  }
  let mut t = 0
  while t < tail.length() {
    o.push(tail[t])
    t = t + 1
  }
  to_bytes(o)
}

///|
fn to_bytes(a : Array[Int]) -> Bytes {
  let mut b = Bytes::new(a.length())
  let mut i = 0
  while i < a.length() {
    b[i] = (a[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn cat(a : Bytes, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///| JPEG: SOI, `pre` bytes, APP1 "Exif\0\0" + tiff, then SOS + a few scan bytes + EOI.
fn jpeg_with(pre : Array[Int], t : Bytes) -> Bytes {
  let o : Array[Int] = [0xFF, 0xD8]
  let mut i = 0
  while i < pre.length() {
    o.push(pre[i])
    i = i + 1
  }
  let n = t.length() + 8
  o.push(0xFF)
  o.push(0xE1)
  o.push((n >> 8) & 0xFF)
  o.push(n & 0xFF)
  let id = [0x45, 0x78, 0x69, 0x66, 0, 0]
  i = 0
  while i < 6 {
    o.push(id[i])
    i = i + 1
  }
  let tail = to_bytes([0xFF, 0xDA, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x3F, 0x00, 0x12, 0x34, 0xFF, 0xD9])
  cat(cat(to_bytes(o), t), tail)
}

///|
fn kind(r : Result[exif::Exif, exif::ExifError]) -> String {
  match r {
    Ok(ex) => "OK " + ex.fields().length().to_string()
    Err(e) => "ERR " + rt_err_name(e) + " (" + exif::exif_error_message(e) + ")"
  }
}

///|
fn ori_of(r : Result[exif::Exif, exif::ExifError]) -> String {
  match r {
    Ok(ex) =>
    match ex.orientation() {
      Some(o) => o.to_int().to_string()
      None => "none"
    }
    Err(_) => kind(r)
  }
}

///| First `n` bytes of `s`.
fn head(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n && i < s.length() {
    sb.write_byte(s.code_unit_at(i).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn expect(got : String, want : String, what : String) -> String {
  if got == want {
    ""
  } else {
    what + ": got " + got + ", want " + want
  }
}

///| First non-empty failure of `rs`.
fn first_fail(rs : Array[String]) -> String {
  let mut i = 0
  while i < rs.length() {
    if rs[i] != "" {
      return rs[i]
    }
    i = i + 1
  }
  ""
}

// ---------------------------------------------------------------------------------------------
// redteam: P1-1 unknown field types abort the whole parse
// ---------------------------------------------------------------------------------------------

///| TIFF 6.0 §2 (IFD entry "Type"): "Readers should skip over fields containing an unexpected field type."
///| An IFD0 entry with type 0 / 14 / 16 (BigTIFF LONG8) / 0xFFFF must not cost the image its Orientation.
pub fn redteam_p1_1_unknown_type_in_ifd0_skipped() -> String {
  let types = [0, 14, 16, 0xFFFF]
  let out : Array[String] = []
  let mut be_i = 0
  while be_i < 2 {
    let be = be_i == 1
    let mut k = 0
    while k < types.length() {
      let t = tiff(
        be,
        [[ent(0x0112, 3, 1L, s16(be, 6)), ent(0xC000, types[k], 1L, [1, 2, 3, 4])]],
        [0L],
        [],
      )
      out.push(
        expect(
          ori_of(exif::parse(t)),
          "6",
          "type " + types[k].to_string() + (if be { " BE" } else { " LE" }),
        ),
      )
      k = k + 1
    }
    be_i = be_i + 1
  }
  first_fail(out)
}

///| Same defect one level down: a bogus type in ExifIFD (ExifTool's frequent "Bad format (0) for ExifIFD
///| entry" files) wipes out IFD0's Orientation, in JPEG and raw TIFF alike.
pub fn redteam_p1_1_unknown_type_in_exif_ifd_keeps_orientation() -> String {
  let be = false
  let counts = [2, 2]
  let t = tiff(
    be,
    [
      [ent(0x0112, 3, 1L, s16(be, 8)), ent(0x8769, 4, 1L, s32(be, ifd_off(counts, 1)))],
      [ent(0xA001, 3, 1L, s16(be, 1)), ent(0x9999, 0, 1L, [0, 0, 0, 0])],
    ],
    [0L, 0L],
    [],
  )
  first_fail([
    expect(ori_of(exif::parse(t)), "8", "raw TIFF"),
    expect(ori_of(exif::parse(jpeg_with([], t))), "8", "JPEG"),
  ])
}

// ---------------------------------------------------------------------------------------------
// redteam: P2-1 the thumbnail's ExifIFD is reported as the primary image's ExifIFD
// ---------------------------------------------------------------------------------------------

///| IFD1 (thumbnail) may carry its own ExifIFD pointer (kamadak-exif reports it as `In(1)`). Pion files it
///| under `Ifd::Exif`, indistinguishable from the primary ExifIFD, so `color_space()` / `pixel_x_dimension()`
///| of the primary image return the thumbnail's values.
pub fn redteam_p2_1_thumbnail_exif_ifd_not_reported_as_primary() -> String {
  let be = false
  let counts = [1, 2, 2]
  let t = tiff(
    be,
    [
      [ent(0x0112, 3, 1L, s16(be, 1))],
      [ent(0x0103, 3, 1L, s16(be, 6)), ent(0x8769, 4, 1L, s32(be, ifd_off(counts, 2)))],
      [ent(0xA001, 3, 1L, s16(be, 0xFFFF)), ent(0xA002, 4, 1L, s32(be, 160L))],
    ],
    [ifd_off(counts, 1), 0L, 0L],
    [],
  )
  match exif::parse(t) {
    Ok(ex) => {
      let cs = match ex.color_space() {
        Some(v) => v.to_string()
        None => "none"
      }
      let px = match ex.pixel_x_dimension() {
        Some(v) => v.to_string()
        None => "none"
      }
      first_fail([
        expect(cs, "none", "primary color_space() (only the thumbnail has an ExifIFD)"),
        expect(px, "none", "primary pixel_x_dimension()"),
      ])
    }
    Err(e) => "parse failed: " + exif::exif_error_message(e)
  }
}

// ---------------------------------------------------------------------------------------------
// redteam: P2-2 JPEG marker resynchronisation
// ---------------------------------------------------------------------------------------------

///| libjpeg (`next_marker`: "Corrupt JPEG data: N extraneous bytes before marker"), and so libjpeg-turbo based
///| browsers (Chromium, Firefox) skip stray bytes before a marker; kamadak-exif does too. Pion rejects the file, so a
///| JPEG that every viewer shows rotated is shown unrotated by a Pion pipeline.
pub fn redteam_p2_2_jpeg_stray_bytes_before_marker_tolerated() -> String {
  let t = tiff(false, [[ent(0x0112, 3, 1L, s16(false, 6))]], [0L], [])
  let jfif = [
    0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01, 0x02, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
  ]
  let pre : Array[Int] = []
  let mut i = 0
  while i < jfif.length() {
    pre.push(jfif[i])
    i = i + 1
  }
  pre.push(0x00)
  pre.push(0x00)
  expect(ori_of(exif::parse(jpeg_with(pre, t))), "6", "JPEG with 2 stray bytes after APP0")
}

// ---------------------------------------------------------------------------------------------
// redteam: P2-5 one corrupt sub-IFD entry costs the whole parse (and IFD0's Orientation)
// ---------------------------------------------------------------------------------------------

///| A MakerNote whose offset points past the (truncated) APP1, or a dangling GPSInfo pointer, makes
///| `parse` fail as a whole, so `orientation()` is unavailable although IFD0 is intact. Viewers that read
///| IFD0 (or kamadak-exif with `continue_on_error`) still rotate.
pub fn redteam_p2_5_corrupt_subifd_keeps_ifd0_orientation() -> String {
  let be = false
  let counts = [2, 1]
  let t1 = tiff(
    be,
    [
      [ent(0x0112, 3, 1L, s16(be, 6)), ent(0x8769, 4, 1L, s32(be, ifd_off(counts, 1)))],
      [ent(0x927C, 7, 4096L, s32(be, 0x10000L))],
    ],
    [0L, 0L],
    [],
  )
  let t2 = tiff(be, [[ent(0x0112, 3, 1L, s16(be, 6)), ent(0x8825, 4, 1L, s32(be, 0x7FFFFFF0L))]], [0L], [])
  first_fail([
    expect(ori_of(exif::parse(jpeg_with([], t1))), "6", "MakerNote offset past APP1"),
    expect(ori_of(exif::parse(t2)), "6", "dangling GPSInfo pointer"),
  ])
}

// ---------------------------------------------------------------------------------------------
// controls
// ---------------------------------------------------------------------------------------------

///| TIFF 6.0 / EXIF Orientation (0x0112) table: where the stored image's (row 0, col 0) and (row 0, col 1) end up on
///| screen after "rotate clockwise by cw_degrees(), then flip horizontally if flip_horizontal()".
pub fn control_orientation_transform_matches_exif_table() -> String {
  // stored image H=2 rows, W=3 cols; expected display positions (row, col) of s(0,0) and s(0,1)
  // 1 top-left, 2 top-right, 3 bottom-right, 4 bottom-left, 5 left-top, 6 right-top, 7 right-bottom,
  // 8 left-bottom (0th row side - 0th column side)
  let want = [
    [0, 0, 0, 1], [0, 2, 0, 1], [1, 2, 1, 1], [1, 0, 1, 1], [0, 0, 1, 0], [0, 1, 1, 1], [2, 1, 1, 1], [2, 0, 1, 0],
  ]
  let out : Array[String] = []
  let mut v = 1
  while v <= 8 {
    match exif::Orientation::from_int(v) {
      Some(o) => {
        let h = 2
        let w = 3
        let p0 = place(o, h, w, 0, 0)
        let p1 = place(o, h, w, 0, 1)
        let got = p0[0].to_string() +
        "," +
        p0[1].to_string() +
        " " +
        p1[0].to_string() +
        "," +
        p1[1].to_string()
        let wv = want[v - 1]
        let exp = wv[0].to_string() +
        "," +
        wv[1].to_string() +
        " " +
        wv[2].to_string() +
        "," +
        wv[3].to_string()
        out.push(expect(got, exp, "orientation " + v.to_string()))
        let sw = o.swaps_dimensions()
        out.push(expect(sw.to_string(), (v >= 5).to_string(), "swaps_dimensions " + v.to_string()))
        out.push(expect(o.to_int().to_string(), v.to_string(), "to_int"))
      }
      None => out.push("from_int(" + v.to_string() + ") = None")
    }
    v = v + 1
  }
  let bad = [0, 9, -1, 65535, 0x10006]
  let mut i = 0
  while i < bad.length() {
    match exif::Orientation::from_int(bad[i]) {
      Some(_) => out.push("from_int(" + bad[i].to_string() + ") accepted")
      None => ()
    }
    i = i + 1
  }
  first_fail(out)
}

///| Display position of stored pixel (r, c) of an h x w image: rotate cw, then optional horizontal flip.
fn place(o : exif::Orientation, h : Int, w : Int, r : Int, c : Int) -> Array[Int] {
  let mut rr = r
  let mut cc = c
  let mut hh = h
  let mut ww = w
  let mut k = o.cw_degrees() / 90
  while k > 0 {
    // 90 degrees clockwise: (r, c) in hh x ww -> (c, hh - 1 - r) in ww x hh
    let nr = cc
    let nc = hh - 1 - rr
    rr = nr
    cc = nc
    let t = hh
    hh = ww
    ww = t
    k = k - 1
  }
  if o.flip_horizontal() {
    cc = ww - 1 - cc
  }
  [rr, cc]
}

///| Unsigned LONG >= 2^31 stays positive; SLONG/SRATIONAL INT32_MIN; Rational / SRational zero denominators.
pub fn control_numeric_edges() -> String {
  let be = true
  let counts = [5]
  let base = ifd_off(counts, 1).to_int()
  let tail = [
    0x80, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, // SRATIONAL INT32_MIN / -1
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // RATIONAL 0/0

  ]
  let t = tiff(
    be,
    [
      [
        ent(0x0100, 4, 1L, s32(be, 3000000000L)),
        ent(0x0101, 9, 1L, s32(be, 0x80000000L)),
        ent(0x0102, 10, 1L, s32(be, base.to_int64())),
        ent(0x0103, 5, 1L, s32(be, (base + 8).to_int64())),
        ent(0x0104, 11, 1L, s32(be, 1L)),
      ],
    ],
    [0L],
    tail,
  )
  match exif::parse(t) {
    Err(e) => "parse failed: " + exif::exif_error_message(e)
    Ok(ex) => {
      let out : Array[String] = []
      match ex.get(exif::Ifd::Primary, 0x0100) {
        Some(f) =>
        out.push(
          expect(
            match f.as_uint() {
              Some(v) => v.to_string()
              None => "none"
            },
            "3000000000",
            "LONG 3e9 as_uint",
          ),
        )
        None => out.push("0x0100 missing")
      }
      match ex.get(exif::Ifd::Primary, 0x0101) {
        Some(f) =>
        out.push(
          expect(
            match f.as_int() {
              Some(v) => v.to_string()
              None => "none"
            },
            "-2147483648",
            "SLONG INT32_MIN",
          ),
        )
        None => out.push("0x0101 missing")
      }
      match ex.get(exif::Ifd::Primary, 0x0102) {
        Some(f) =>
        out.push(
          expect(
            match f.as_double() {
              Some(v) => v.to_string()
              None => "none"
            },
            (2147483648.0).to_string(),
            "SRATIONAL INT32_MIN/-1",
          ),
        )
        None => out.push("0x0102 missing")
      }
      match ex.get(exif::Ifd::Primary, 0x0103) {
        Some(f) =>
        out.push(
          expect(
            match f.as_double() {
              Some(v) => v.to_string()
              None => "none"
            },
            "none",
            "RATIONAL 0/0",
          ),
        )
        None => out.push("0x0103 missing")
      }
      match ex.get(exif::Ifd::Primary, 0x0104) {
        Some(f) =>
        out.push(
          expect(
            match f.as_double() {
              Some(v) => v.to_bits().to_string()
              None => "none"
            },
            (1.401298464324817e-45).to_bits().to_string(),
            "FLOAT min subnormal (exact)",
          ),
        )
        None => out.push("0x0104 missing")
      }
      first_fail(out)
    }
  }
}

///| ExifLimits at and around their boundaries; nonsensical limits must fail closed without panicking.
pub fn control_limits_boundaries() -> String {
  let be = false
  // 3 entries: SHORT(1), UNDEFINED(100) external, ASCII(4) inline -> payload 2 + 100 + 4 = 106 bytes
  let counts = [3]
  let data_off = ifd_off(counts, 1)
  let tail : Array[Int] = []
  let mut i = 0
  while i < 100 {
    tail.push(i)
    i = i + 1
  }
  let t = tiff(
    be,
    [
      [
        ent(0x0112, 3, 1L, s16(be, 6)),
        ent(0x927C, 7, 100L, s32(be, data_off)),
        ent(0x010F, 2, 4L, [0x41, 0x42, 0x43, 0]),
      ],
    ],
    [0L],
    tail,
  )
  let lim = fn(a : Int, b : Int, c : Int, d : Int) -> String {
    kind(exif::parse_with_limits(t, exif::ExifLimits::new(a, b, c, d)))
  }
  let out : Array[String] = []
  out.push(expect(lim(1, 3, 3, 106), "OK 3", "exact limits"))
  out.push(expect(head(lim(1, 3, 3, 105), 17), "ERR LimitExceeded", "payload - 1"))
  out.push(expect(head(lim(0, 3, 3, 106), 17), "ERR LimitExceeded", "max_ifds 0"))
  out.push(expect(head(lim(1, 2, 3, 106), 17), "ERR LimitExceeded", "entries/IFD - 1"))
  out.push(expect(head(lim(1, 3, 2, 106), 17), "ERR LimitExceeded", "total entries - 1"))
  out.push(expect(head(lim(-1, -1, -1, -1), 3), "ERR", "negative limits"))
  out.push(expect(lim(2147483647, 2147483647, 2147483647, 2147483647), "OK 3", "huge limits"))
  first_fail(out)
}

///| Every prefix and every single-byte XOR 0xFF of a JPEG-wrapped multi-IFD TIFF, under default and extreme
///| custom limits: no panic (a panic aborts the case process and is reported as a crash).
pub fn control_sweep_no_panic_custom_limits() -> String {
  let be = true
  let counts = [3, 2, 1]
  let t = tiff(
    be,
    [
      [
        ent(0x0112, 3, 1L, s16(be, 6)),
        ent(0x8769, 4, 1L, s32(be, ifd_off(counts, 1))),
        ent(0x8825, 4, 1L, s32(be, ifd_off(counts, 2))),
      ],
      [ent(0xA001, 3, 1L, s16(be, 1)), ent(0x9000, 7, 4L, [0x30, 0x32, 0x33, 0x32])],
      [ent(0x0001, 2, 2L, [0x4E, 0, 0, 0])],
    ],
    [0L, 0L, 0L],
    [],
  )
  let j = jpeg_with([], t)
  let limits = [
    exif::ExifLimits::default(),
    exif::ExifLimits::new(2147483647, 2147483647, 2147483647, 2147483647),
    exif::ExifLimits::new(0, 0, 0, 0),
    exif::ExifLimits::new(-2147483648, -1, -1, -2147483648),
  ]
  let mut n = 0
  let mut li = 0
  while li < limits.length() {
    let mut cut = 0
    while cut <= j.length() {
      let _ = exif::parse_with_limits(j.slice(0, cut), limits[li])
      n = n + 1
      cut = cut + 1
    }
    let mut p = 0
    while p < j.length() {
      let mut m = j.slice(0, j.length())
      m[p] = (m[p].to_int() ^ 0xFF).to_byte()
      let _ = exif::parse_with_limits(m, limits[li])
      n = n + 1
      p = p + 1
    }
    li = li + 1
  }
  if n > 0 {
    ""
  } else {
    "no inputs"
  }
}

///| extract_from_{jpeg,webp,png} return exactly the TIFF block parse() decodes in place.
pub fn control_extract_matches_parse() -> String {
  let t = tiff(false, [[ent(0x0112, 3, 1L, s16(false, 3))]], [0L], [])
  let j = jpeg_with([], t)
  let out : Array[String] = []
  match exif::extract_from_jpeg(j) {
    Ok(b) => {
      out.push(expect(b.length().to_string(), t.length().to_string(), "extract_from_jpeg length"))
      out.push(expect(ori_of(exif::parse_tiff(b)), "3", "parse_tiff(extract_from_jpeg)"))
    }
    Err(e) => out.push("extract_from_jpeg: " + exif::exif_error_message(e))
  }
  out.push(expect(ori_of(exif::parse(j)), "3", "parse(jpeg)"))
  first_fail(out)
}

///| A sub-IFD reached twice (ExifIFD and GPSIFD pointers sharing one offset) is rejected like a cycle,
///| the same policy as kamadak-exif ("Already visited IFD"), which bounds work to one visit per IFD.
pub fn control_shared_subifd_rejected() -> String {
  let be = false
  let counts = [3, 1]
  let sub = ifd_off(counts, 1)
  let t = tiff(
    be,
    [
      [ent(0x0112, 3, 1L, s16(be, 6)), ent(0x8769, 4, 1L, s32(be, sub)), ent(0x8825, 4, 1L, s32(be, sub))],
      [ent(0x0001, 2, 2L, [0x4E, 0, 0, 0])],
    ],
    [0L, 0L],
    [],
  )
  expect(head(kind(exif::parse(t)), 14), "ERR InvalidIfd", "diamond")
}

///|
pub fn rt_all_cases() -> Array[String] {
  [
    "redteam_p1_1_unknown_type_in_ifd0_skipped", "redteam_p1_1_unknown_type_in_exif_ifd_keeps_orientation", "redteam_p2_1_thumbnail_exif_ifd_not_reported_as_primary",
    "redteam_p2_2_jpeg_stray_bytes_before_marker_tolerated",
    "redteam_p2_5_corrupt_subifd_keeps_ifd0_orientation", "control_orientation_transform_matches_exif_table", "control_numeric_edges",
    "control_limits_boundaries", "control_sweep_no_panic_custom_limits", "control_extract_matches_parse", "control_shared_subifd_rejected",
  ]
}

///|
pub fn rt_run_case(name : String) -> String {
  if name == "redteam_p1_1_unknown_type_in_ifd0_skipped" {
    return redteam_p1_1_unknown_type_in_ifd0_skipped()
  }
  if name == "redteam_p1_1_unknown_type_in_exif_ifd_keeps_orientation" {
    return redteam_p1_1_unknown_type_in_exif_ifd_keeps_orientation()
  }
  if name == "redteam_p2_1_thumbnail_exif_ifd_not_reported_as_primary" {
    return redteam_p2_1_thumbnail_exif_ifd_not_reported_as_primary()
  }
  if name == "redteam_p2_2_jpeg_stray_bytes_before_marker_tolerated" {
    return redteam_p2_2_jpeg_stray_bytes_before_marker_tolerated()
  }
  if name == "redteam_p2_5_corrupt_subifd_keeps_ifd0_orientation" {
    return redteam_p2_5_corrupt_subifd_keeps_ifd0_orientation()
  }
  if name == "control_orientation_transform_matches_exif_table" {
    return control_orientation_transform_matches_exif_table()
  }
  if name == "control_numeric_edges" {
    return control_numeric_edges()
  }
  if name == "control_limits_boundaries" {
    return control_limits_boundaries()
  }
  if name == "control_sweep_no_panic_custom_limits" {
    return control_sweep_no_panic_custom_limits()
  }
  if name == "control_extract_matches_parse" {
    return control_extract_matches_parse()
  }
  if name == "control_shared_subifd_rejected" {
    return control_shared_subifd_rejected()
  }
  "unknown case " + name
}
