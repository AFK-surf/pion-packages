///| Red-team CLI for `packages/exif` (native + wasm32).
///|   dump <file>...          -> `== <file>` then the rt_dump record of exif::parse(file)
///|   dumplist <listfile>     -> same for every path listed (one per line) in <listfile>
///|   time <file> <iters>     -> parse <iters> times; `<verdict> fields=<n> us=<total>`
///|   canon <file>            -> time Exif::format_canonical() of the parsed file
///|   list | case <name>      -> red-team / control cases (src/cases.pion)

import "exif"

///|
fn parse_uint(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///| Split on '\n', dropping empty lines.
fn split_lines(b : Bytes) -> Array[String] {
  let out : Array[String] = []
  let mut sb = StringBuilder::new()
  let mut any = false
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c == 10 {
      if any {
        out.push(sb.to_string())
      }
      sb = StringBuilder::new()
      any = false
    } else {
      sb.write_byte(b[i])
      any = true
    }
    i = i + 1
  }
  if any {
    out.push(sb.to_string())
  }
  out
}

///|
fn dump_one(world : World, path : String) -> Unit {
  match fs_read_bytes(world, path) {
    Ok(d) => io_print(world, "== " + path + "\n" + rt_dump(exif::parse(d)))
    Err(_) => io_print(world, "== " + path + "\nREADFAIL\n")
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: exif_audit dump <file>... | dumplist <list> | time <file> <iters> | list | case <name>")
    return 2
  }
  let mode = args[1]
  if mode == "dump" {
    let mut i = 2
    while i < args.length() {
      dump_one(world, args[i])
      i = i + 1
    }
    return 0
  }
  if mode == "dumplist" && args.length() >= 3 {
    let lst = match fs_read_bytes(world, args[2]) {
      Ok(b) => split_lines(b)
      Err(_) => return 3
    }
    let mut i = 0
    while i < lst.length() {
      dump_one(world, lst[i])
      i = i + 1
    }
    return 0
  }
  if mode == "time" && args.length() >= 4 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let iters = parse_uint(args[3])
    let mut verdict = ""
    let mut n = 0
    let t0 = clock_monotonic_us()
    let mut k = 0
    while k < iters {
      match exif::parse(d) {
        Ok(ex) => {
          verdict = "OK"
          n = ex.fields().length()
        }
        Err(e) => verdict = "ERR " + rt_err_name(e)
      }
      k = k + 1
    }
    let t1 = clock_monotonic_us()
    io_println(world, verdict + " fields=" + n.to_string() + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "canon" && args.length() >= 3 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    match exif::parse(d) {
      Ok(ex) => {
        let t0 = clock_monotonic_us()
        let s = ex.format_canonical()
        let t1 = clock_monotonic_us()
        io_println(world, "OK fields=" + ex.fields().length().to_string() + " bytes=" + s.length().to_string() + " us=" + (t1 - t0).to_string())
      }
      Err(e) => io_println(world, "ERR " + rt_err_name(e))
    }
    return 0
  }
  if mode == "list" {
    let names = rt_all_cases()
    let mut i = 0
    while i < names.length() {
      io_println(world, names[i])
      i = i + 1
    }
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = rt_run_case(args[2])
    if r == "" {
      io_println(world, "PASS " + args[2])
      return 0
    }
    io_println(world, "FAIL " + args[2] + " :: " + r)
    return 1
  }
  io_println(world, "bad arguments")
  2
}
