///| Exact, oracle-comparable dump of `exif::parse` results (see diff/oracle/src/main.rs for the twin).
///| Line format (one record per input):
///|   `OK <II|MM> <n>` then `F <ifd> <tag> <type> <count> <value>` per field in parse order, then
///|   `A ori=<..> gps=<..> alt=<..>`; or `ERR <Variant>`.
///| IFD names: T<n> (TIFF chain IFDn), E (ExifIFD), G (GPSIFD), I (InteropIFD).
///| Values are printed bit-exactly: ASCII strings and UNDEFINED as hex, FLOAT/DOUBLE as IEEE-754 binary64 bits.

import "exif"

///|
fn hexd(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    87 + v
  }
}

///| Lower-case hex of the low `digits` nibbles of `v`.
pub fn rt_hex64(v : Int64, digits : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = digits - 1
  while i >= 0 {
    sb.write_byte(hexd(((v >> (i * 4)) & 0xFL).to_int()).to_byte())
    i = i - 1
  }
  sb.to_string()
}

///| Hex of every byte of `s` (strings may hold arbitrary non-UTF-8 bytes).
pub fn rt_hex_str(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i) & 0xFF
    sb.write_byte(hexd(c >> 4).to_byte())
    sb.write_byte(hexd(c & 0xF).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn rt_err_name(e : exif::ExifError) -> String {
  match e {
    exif::ExifError::UnexpectedEof(_) => "UnexpectedEof"
    exif::ExifError::NotFound(_) => "NotFound"
    exif::ExifError::InvalidFormat(_) => "InvalidFormat"
    exif::ExifError::InvalidIfd(_) => "InvalidIfd"
    exif::ExifError::InvalidValue(_) => "InvalidValue"
    exif::ExifError::LimitExceeded(_) => "LimitExceeded"
  }
}

///|
pub fn rt_ifd_name(i : exif::Ifd) -> String {
  match i {
    exif::Ifd::Primary => "T0"
    exif::Ifd::Thumbnail => "T1"
    exif::Ifd::Other(n) => "T" + n.to_string()
    exif::Ifd::Exif => "E"
    exif::Ifd::Gps => "G"
    exif::Ifd::Interop => "I"
  }
}

///|
fn join_ints(a : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < a.length() {
    if i > 0 {
      sb.write_byte(0x2C.to_byte())
    }
    sb.write_string(a[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn rt_value(v : exif::FieldValue) -> String {
  let sb = StringBuilder::new()
  match v {
    exif::FieldValue::Byte(a) => sb.write_string(join_ints(a))
    exif::FieldValue::SByte(a) => sb.write_string(join_ints(a))
    exif::FieldValue::Short(a) => sb.write_string(join_ints(a))
    exif::FieldValue::SShort(a) => sb.write_string(join_ints(a))
    exif::FieldValue::SLong(a) => sb.write_string(join_ints(a))
    exif::FieldValue::Long(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].to_string())
        i = i + 1
      }
    }
    exif::FieldValue::Ascii(a) => {
      sb.write_string(a.length().to_string())
      sb.write_byte(0x3A.to_byte())
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(rt_hex_str(a[i]))
        i = i + 1
      }
    }
    exif::FieldValue::Rational(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].num.to_string() + "/" + a[i].den.to_string())
        i = i + 1
      }
    }
    exif::FieldValue::SRational(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(a[i].num.to_string() + "/" + a[i].den.to_string())
        i = i + 1
      }
    }
    exif::FieldValue::Undefined(b) => {
      let mut i = 0
      while i < b.length() {
        sb.write_string(rt_hex64(b[i].to_int().to_int64(), 2))
        i = i + 1
      }
    }
    exif::FieldValue::Float(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(rt_hex64(a[i].to_bits(), 16))
        i = i + 1
      }
    }
    exif::FieldValue::Double(a) => {
      let mut i = 0
      while i < a.length() {
        if i > 0 {
          sb.write_byte(0x2C.to_byte())
        }
        sb.write_string(rt_hex64(a[i].to_bits(), 16))
        i = i + 1
      }
    }
  }
  sb.to_string()
}

///| Accessor line: what an application sees through the typed API.
pub fn rt_accessors(ex : exif::Exif) -> String {
  let ori = match ex.orientation() {
    Some(o) => o.to_int().to_string()
    None => "none"
  }
  let gps = match ex.gps_coords() {
    Some((la, lo)) => rt_hex64(la.to_bits(), 16) + "," + rt_hex64(lo.to_bits(), 16)
    None => "none"
  }
  let alt = match ex.gps_altitude() {
    Some(a) => rt_hex64(a.to_bits(), 16)
    None => "none"
  }
  let cs = match ex.color_space() {
    Some(c) => c.to_string()
    None => "none"
  }
  "A ori=" + ori + " gps=" + gps + " alt=" + alt + " cs=" + cs
}

///| Full dump of one parse result.
pub fn rt_dump(r : Result[exif::Exif, exif::ExifError]) -> String {
  match r {
    Err(e) => "ERR " + rt_err_name(e) + " " + exif::exif_error_message(e) + "\n"
    Ok(ex) => {
      let fs = ex.fields()
      let sb = StringBuilder::new()
      sb.write_string("OK ")
      sb.write_string(ex.byte_order.to_string())
      sb.write_string(" " + fs.length().to_string() + "\n")
      let mut i = 0
      while i < fs.length() {
        let f = fs[i]
        sb.write_string("F " + rt_ifd_name(f.ifd) + " " + rt_hex64(f.tag.to_int64(), 4) + " ")
        sb.write_string(f.field_type.to_string() + " " + f.count.to_string() + " ")
        sb.write_string(rt_value(f.value))
        sb.write_byte(0x0A.to_byte())
        i = i + 1
      }
      sb.write_string(rt_accessors(ex))
      sb.write_byte(0x0A.to_byte())
      sb.to_string()
    }
  }
}
