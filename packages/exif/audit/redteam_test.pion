///| Red-team FINDING tests for `packages/exif` @ 3408202 (`origin/feat/pkg-exif`).
///| Each test asserts what a correct parser must do and FAILS on the audited baseline; the message is the
///| evidence. A fix is complete when the test passes without editing `audit/`. Bodies live in `src/cases.pion`.

///|
test "redteam_p1_1_unknown_type_in_ifd0_skipped" {
  let r = redteam_p1_1_unknown_type_in_ifd0_skipped()
  debug_assert(r == "", r)
}

