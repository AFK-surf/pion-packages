///| Wasm32 & Native smoke entry for `packages/zip`.

import "zip"

///|
pub fn smoke() -> Int {
  let w = zip::ZipWriter::new()
  match w.set_comment("wasm-smoke") {
    Ok(_) => ()
    Err(_) => return -1
  }
  match w.add_file_stored("hello.txt", "Hello from Wasm32 ZIP!\n".to_bytes()) {
    Ok(_) => ()
    Err(_) => return -2
  }
  match w.add_file("dir/中文.txt", "Deflated UTF-8 payload! Deflated UTF-8 payload!".to_bytes()) {
    Ok(_) => ()
    Err(_) => return -3
  }
  match w.add_dir("empty_dir/") {
    Ok(_) => ()
    Err(_) => return -4
  }
  let archive = match w.finish() {
    Ok(b) => b
    Err(_) => return -5
  }
  let r = match zip::ZipReader::open(archive) {
    Ok(zr) => zr
    Err(_) => return -6
  }
  if r.len() != 3 || r.comment() != "wasm-smoke" {
    return -7
  }
  match r.open_by_name("hello.txt") {
    Ok(b) => if b.to_string() != "Hello from Wasm32 ZIP!\n" { return -8 }
    Err(_) => return -9
  }
  match r.open_by_name("dir/中文.txt") {
    Ok(b) => if b.to_string() != "Deflated UTF-8 payload! Deflated UTF-8 payload!" { return -10 }
    Err(_) => return -11
  }
  match zip::clean_extract_path("../etc/passwd") {
    Err(_) => ()
    Ok(_) => return -12
  }
  match zip::clean_extract_path("dir/./ok.txt") {
    Ok(p) => if p != "dir/ok.txt" { return -13 }
    Err(_) => return -14
  }
  archive.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "zip_wasm_smoke: OK archive_bytes=" + r.to_string())
    0
  } else {
    io_println(world, "zip_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
