///| Core ZIP archive data model, APPNOTE 6.3.10 constants, MS-DOS timestamps,
///| security limits, binary helpers, and error types.
///| Pure Pion, zero C dependencies, no `World`, all public data types are `Send`-safe.

import "flate"

// --- Compression methods ---

///| Compression method 0: Store (no compression).
pub fn method_store() -> UInt {
  0U
}

///| Compression method 8: Raw DEFLATE (RFC 1951).
pub fn method_deflate() -> UInt {
  8U
}

// --- ZIP signatures ---

///| Local File Header signature (`PK\x03\x04`).
pub let sig_local_file_header : UInt = 0x04034b50U

///| Optional Data Descriptor signature (`PK\x07\x08`).
pub let sig_data_descriptor : UInt = 0x08074b50U

///| Central Directory File Header signature (`PK\x01\x02`).
pub let sig_central_dir : UInt = 0x02014b50U

///| End of Central Directory Record signature (`PK\x05\x06`).
pub let sig_eocd : UInt = 0x06054b50U

///| ZIP64 End of Central Directory Record signature (`PK\x06\x06`).
pub let sig_zip64_eocd : UInt = 0x06064b50U

///| ZIP64 End of Central Directory Locator signature (`PK\x06\x07`).
pub let sig_zip64_locator : UInt = 0x07064b50U

// --- General purpose bit flags ---

///| Bit 0: file is encrypted.
pub let flag_encrypted : UInt = 0x0001U

///| Bit 3: CRC-32 and sizes are in the trailing Data Descriptor.
pub let flag_data_descriptor : UInt = 0x0008U

///| Bit 11: Language encoding flag (EFS) — filename and comment are UTF-8.
pub let flag_utf8 : UInt = 0x0800U

// --- ZIP64 extra field & sentinels ---

///| Extra field Header ID for ZIP64 Extended Information (`0x0001`).
pub let extra_id_zip64 : UInt = 0x0001U

///| Creator OS: Unix (`3`).
pub let creator_unix : UInt = 3U

///| POSIX file type mask (`S_IFMT`).
pub let s_ifmt : UInt = 0xF000U

///| POSIX directory bit (`S_IFDIR`).
pub let s_ifdir : UInt = 0x4000U

///| POSIX regular file bit (`S_IFREG`).
pub let s_ifreg : UInt = 0x8000U

///| POSIX symbolic link bit (`S_IFLNK`).
pub let s_iflnk : UInt = 0xA000U

// --- Error type ---

///| Error returned by ZIP archive reading, writing, or path sanitization.
pub enum ZipError {
  InvalidArchive(String)
  Truncated(String)
  UnsupportedMethod(UInt)
  UnsupportedFeature(String)
  ChecksumMismatch(UInt, UInt)
  DecompressError(String)
  CompressError(String)
  EntryNotFound(String)
  DuplicateEntry(String)
  OverlappingEntries(String)
  InsecurePath(String)
  LimitExceeded(String)
  InvalidArgument(String)
}

///| Human-readable description of a `ZipError`.
pub fn zip_error_message(err : ZipError) -> String {
  match err {
    InvalidArchive(msg) => "invalid zip archive: " + msg
    Truncated(msg) => "truncated zip archive: " + msg
    UnsupportedMethod(m) => "unsupported compression method: " + m.to_string()
    UnsupportedFeature(msg) => "unsupported zip feature: " + msg
    ChecksumMismatch(exp, got) =>
    "crc32 mismatch: expected " + exp.to_string() + ", got " + got.to_string()
    DecompressError(msg) => "decompress error: " + msg
    CompressError(msg) => "compress error: " + msg
    EntryNotFound(name) => "entry not found: " + name
    DuplicateEntry(name) => "duplicate entry: " + name
    OverlappingEntries(msg) => "overlapping entries: " + msg
    InsecurePath(path) => "insecure extract path: " + path
    LimitExceeded(msg) => "limit exceeded: " + msg
    InvalidArgument(msg) => "invalid argument: " + msg
  }
}

///|
pub fn ZipError::to_string(self : ZipError) -> String {
  zip_error_message(self)
}

// --- MS-DOS Date/Time ---

///| MS-DOS date and time stored in ZIP headers (2-second resolution, years 1980..2107).
pub val struct DosDateTime {
  pub year : Int
  pub month : Int
  pub day : Int
  pub hour : Int
  pub minute : Int
  pub second : Int
}

///| Default MS-DOS timestamp (`1980-01-01 00:00:00`).
pub fn DosDateTime::default() -> DosDateTime {
  DosDateTime::{ year: 1980, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
}

///|
fn clamp_int(v : Int, lo : Int, hi : Int) -> Int {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

///| Return the number of days in `month` (1..12) of `year`.
fn days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0) {
      29
    } else {
      28
    }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

///| Construct a `DosDateTime` clamped to valid MS-DOS ranges (1980-01-01 00:00:00 .. 2107-12-31 23:59:58)
///| with calendar day clamped to the valid days of the given year and month.
pub fn DosDateTime::new(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
) -> DosDateTime {
  if year < 1980 {
    return DosDateTime::{ year: 1980, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
  }
  if year > 2107 {
    return DosDateTime::{ year: 2107, month: 12, day: 31, hour: 23, minute: 59, second: 58 }
  }
  let m = clamp_int(month, 1, 12)
  let max_d = days_in_month(year, m)
  DosDateTime::{
    year: year,
    month: m,
    day: clamp_int(day, 1, max_d),
    hour: clamp_int(hour, 0, 23),
    minute: clamp_int(minute, 0, 59),
    second: clamp_int(second, 0, 58) & 0xFE,
  }
}

///| Decode MS-DOS packed `(dos_date, dos_time)` into `DosDateTime`.
pub fn DosDateTime::from_dos(dos_date : UInt, dos_time : UInt) -> DosDateTime {
  let y = ((dos_date >> 9) & 0x7FU).to_int() + 1980
  let m = clamp_int(((dos_date >> 5) & 0x0FU).to_int(), 1, 12)
  let d = clamp_int((dos_date & 0x1FU).to_int(), 1, days_in_month(y, m))
  let h = clamp_int(((dos_time >> 11) & 0x1FU).to_int(), 0, 23)
  let min = clamp_int(((dos_time >> 5) & 0x3FU).to_int(), 0, 59)
  let s = clamp_int(((dos_time & 0x1FU).to_int()) * 2, 0, 58)
  DosDateTime::{ year: y, month: m, day: d, hour: h, minute: min, second: s }
}

///| Encode `DosDateTime` into MS-DOS packed `(dos_date, dos_time)`.
pub fn DosDateTime::to_dos(self : DosDateTime) -> (UInt, UInt) {
  let dt = DosDateTime::new(
    self.year,
    self.month,
    self.day,
    self.hour,
    self.minute,
    self.second,
  )
  let y = dt.year - 1980
  let s = dt.second >> 1
  let dos_date = ((y << 9) | (dt.month << 5) | dt.day).to_uint()
  let dos_time = ((dt.hour << 11) | (dt.minute << 5) | s).to_uint()
  (dos_date, dos_time)
}

///| Convert days since 1970-01-01 to civil `(year, month, day)` (Howard Hinnant's algorithm).
fn civil_from_days(z_in : Int64) -> (Int, Int, Int) {
  let z = z_in + 719468L
  let era = (if z >= 0L { z } else { z - 146096L }) / 146097L
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let y = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = doy - (153L * mp + 2L) / 5L + 1L
  let m = mp + (if mp < 10L { 3L } else { -9L })
  let year = y + (if m <= 2L { 1L } else { 0L })
  (year.to_int(), m.to_int(), d.to_int())
}

///| Convert civil `(year, month, day)` to days since 1970-01-01 (Howard Hinnant's algorithm).
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = year.to_int64() - (if month <= 2 { 1L } else { 0L })
  let era = (if y >= 0L { y } else { y - 399L }) / 400L
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let doy = (153L * (m + (if m > 2L { -3L } else { 9L })) + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

///| Convert a UTC Unix timestamp (seconds since 1970-01-01) to `DosDateTime`.
pub fn DosDateTime::from_unix(sec : Int64) -> DosDateTime {
  // 1980-01-01 00:00:00 UTC = 315532800
  if sec <= 315532800L {
    return DosDateTime::default()
  }
  // 2107-12-31 23:59:58 UTC = 4354819198
  if sec >= 4354819198L {
    return DosDateTime::{ year: 2107, month: 12, day: 31, hour: 23, minute: 59, second: 58 }
  }
  let days = sec / 86400L
  let rem = (sec % 86400L).to_int()
  let (y, m, d) = civil_from_days(days)
  let h = rem / 3600
  let min = (rem % 3600) / 60
  let s = (rem % 60) & 0xFE
  DosDateTime::new(y, m, d, h, min, s)
}

///| Convert `DosDateTime` to a UTC Unix timestamp (seconds since 1970-01-01).
pub fn DosDateTime::to_unix(self : DosDateTime) -> Int64 {
  let days = days_from_civil(self.year, self.month, self.day)
  days * 86400L +
  self.hour.to_int64() * 3600L +
  self.minute.to_int64() * 60L +
  self.second.to_int64()
}

// --- Security Limits ---

///| Configurable resource and security limits for `ZipReader`.
pub val struct Limits {
  pub max_entries : Int
  pub max_entry_size : Int64
  pub max_total_size : Int64
  pub max_compression_ratio : Int
  pub reject_duplicates : Bool
  pub reject_overlaps : Bool
}

///| Default hardened security limits:
///| - `max_entries`: 100,000
///| - `max_entry_size`: 256 MiB
///| - `max_total_size`: 1 GiB
///| - `max_compression_ratio`: 100
///| - `reject_duplicates`: true
///| - `reject_overlaps`: true
pub fn Limits::default() -> Limits {
  Limits::{
    max_entries: 100000,
    max_entry_size: 268435456L,
    max_total_size: 1073741824L,
    max_compression_ratio: 100,
    reject_duplicates: true,
    reject_overlaps: true,
  }
}

///| Permissive limits for trusted archives (disables duplicate/ratio caps while keeping sanity bounds).
pub fn Limits::permissive() -> Limits {
  Limits::{
    max_entries: 0,
    max_entry_size: 0L,
    max_total_size: 0L,
    max_compression_ratio: 0,
    reject_duplicates: false,
    reject_overlaps: false,
  }
}

// --- Entry metadata ---

///| Immutable metadata of a single ZIP Central Directory entry.
pub struct ZipEntry {
  pub name : String
  pub comment : String
  pub method : UInt
  pub flags : UInt
  pub crc32 : UInt
  pub compressed_size : Int64
  pub uncompressed_size : Int64
  pub modified : DosDateTime
  pub version_made_by : UInt
  pub version_needed : UInt
  pub external_attr : UInt
  pub local_header_offset : Int64
  pub extra : Bytes
  pub is_zip64 : Bool
}

///| Returns POSIX permission + file type mode bits if creator OS is Unix (`3`).
pub fn ZipEntry::unix_mode(self : ZipEntry) -> Option[UInt] {
  if (self.version_made_by >> 8) == creator_unix {
    Option::Some((self.external_attr >> 16) & 0xFFFFU)
  } else {
    Option::None
  }
}

///| Returns true if the entry has Unix symlink mode bits (`S_IFLNK`).
pub fn ZipEntry::is_symlink(self : ZipEntry) -> Bool {
  match self.unix_mode() {
    Some(m) => (m & s_ifmt) == s_iflnk
    None => false
  }
}

///| Returns true if the entry represents a directory.
pub fn ZipEntry::is_dir(self : ZipEntry) -> Bool {
  let n = self.name.length()
  if n > 0 && self.name.code_unit_at(n - 1) == 47 {
    return true
  }
  match self.unix_mode() {
    Some(m) => if (m & s_ifmt) == s_ifdir { return true }
    None => ()
  }
  (self.external_attr & 0x10U) != 0U
}

///| Returns true if the UTF-8 flag (bit 11) is set.
pub fn ZipEntry::is_utf8(self : ZipEntry) -> Bool {
  (self.flags & flag_utf8) != 0U
}

///| Returns true if the Data Descriptor flag (bit 3) is set.
pub fn ZipEntry::has_data_descriptor(self : ZipEntry) -> Bool {
  (self.flags & flag_data_descriptor) != 0U
}

// --- Writer options ---

///| Per-entry write options for `ZipWriter`.
pub val struct WriteOptions {
  pub method : UInt
  pub level : Int
  pub modified : DosDateTime
  pub unix_mode : UInt
  pub comment : String
  pub force_zip64 : Bool
}

///| Default write options: Deflate level 6, regular file mode `0o100644`.
pub fn WriteOptions::default() -> WriteOptions {
  WriteOptions::{
    method: method_deflate(),
    level: 6,
    modified: DosDateTime::default(),
    unix_mode: 0x81A4U,
    comment: "",
    force_zip64: false,
  }
}

///| Stored (uncompressed) write options.
pub fn WriteOptions::stored() -> WriteOptions {
  WriteOptions::{
    ..WriteOptions::default(),
    method: method_store(),
    level: 0,
  }
}

///| Deflate write options with explicit compression level `0..9`.
pub fn WriteOptions::deflated(level : Int) -> WriteOptions {
  WriteOptions::{
    ..WriteOptions::default(),
    method: method_deflate(),
    level: level,
  }
}

// --- Internal little-endian binary & buffer helpers ---

///|
fn read_u16_le(b : Bytes, off : Int) -> UInt {
  b[off].to_int().to_uint() | (b[off + 1].to_int().to_uint() << 8)
}

///|
fn read_u32_le(b : Bytes, off : Int) -> UInt {
  b[off].to_int().to_uint() |
  (b[off + 1].to_int().to_uint() << 8) |
  (b[off + 2].to_int().to_uint() << 16) |
  (b[off + 3].to_int().to_uint() << 24)
}

///|
fn read_i64_le(b : Bytes, off : Int) -> Int64 {
  let lo = read_u32_le(b, off).to_int64() & 0xFFFFFFFFL
  let hi = read_u32_le(b, off + 4).to_int64() & 0xFFFFFFFFL
  lo | (hi << 32)
}

///| Single-pass pre-allocated merge of `Bytes` chunks (zero intermediate copies).
fn concat_bytes_chunks(chunks : Array[Bytes]) -> Bytes {
  let count = chunks.length()
  if count == 0 {
    return Bytes::new(0)
  }
  if count == 1 {
    return chunks[0]
  }
  let mut total = 0
  let mut i = 0
  while i < count {
    total = total + chunks[i].length()
    i = i + 1
  }
  let mut out = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < count {
    let c = chunks[i]
    let clen = c.length()
    let mut j = 0
    while j < clen {
      out[pos + j] = c[j]
      j = j + 1
    }
    pos = pos + clen
    i = i + 1
  }
  out
}

///| Keep `flate` CRC-32 helper accessible across package files.
fn zip_crc32(data : Bytes) -> UInt {
  flate::crc32(data)
}
