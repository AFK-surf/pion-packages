///| Day-1 Security Red-Team Test Suite for `packages/zip`:
///| - Zip-Slip & Windows reserved device name path sanitization (`clean_extract_path`)
///| - Zip Bomb protection (max_entries, max_entry_size, max_total_size, max_compression_ratio, lying header)
///| - Overlapping entries, forged/negative/OOB offsets, malformed EOCD, truncated streams, duplicates

import "flate"

///|
test "security_clean_extract_path_zip_slip_and_windows_devices" {
  // Valid paths
  match clean_extract_path("a/b/c.txt") {
    Ok(p) => debug_assert(p == "a/b/c.txt", "simple path")
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match clean_extract_path("./a//b/./c.txt") {
    Ok(p) => debug_assert(p == "a/b/c.txt", "normalized dots and slashes")
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match clean_extract_path("dir\\sub\\file.txt") {
    Ok(p) => debug_assert(p == "dir/sub/file.txt", "backslash normalized")
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match clean_extract_path("console.txt") {
    Ok(p) => debug_assert(p == "console.txt", "console.txt is not CON")
    Err(e) => debug_assert(false, zip_error_message(e))
  }

  // Malicious paths that MUST be rejected
  let bad_paths = [
    "",
    ".",
    "./",
    "..",
    "../etc/passwd",
    "a/../../etc/passwd",
    "a\\..\\..\\windows\\system32\\cmd.exe",
    "..\\evil.txt",
    "/etc/passwd",
    "\\Windows\\System32",
    "C:evil.txt",
    "C:\\Windows\\win.ini",
    "c:/autoexec.bat",
    "file.txt:hidden_ads",
    "a/b\u{00}c.txt",
    "CON",
    "con.txt",
    "dir/PRN.log",
    "AUX",
    "nul",
    "COM1",
    "com9.bin",
    "LPT1",
    "lpt9.txt",
    "dir/CON .txt",
  ]
  let mut i = 0
  while i < bad_paths.length() {
    match clean_extract_path(bad_paths[i]) {
      Err(ZipError::InsecurePath(_)) => ()
      Err(e) =>
      debug_assert(
        false,
        "expected InsecurePath for " + bad_paths[i] + ", got " + zip_error_message(e),
      )
      Ok(p) =>
      debug_assert(false, "malicious path was accepted: " + bad_paths[i] + " -> " + p)
    }
    i = i + 1
  }
}

///|
test "security_zip_bomb_honest_and_lying_headers" {
  // Create a 2 MiB all-zero payload compressed at L9 (~2 KiB compressed -> ~1000x ratio!)
  let zeros = Bytes::new(2097152)
  let comp = match flate::deflate_compress(zeros, 9) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, flate::flate_error_message(e))
      return
    }
  }
  let crc = flate::crc32(zeros)

  // Build valid ZIP containing the 2 MiB bomb
  let w = ZipWriter::new()
  match w.add_file_with_options("bomb.bin", zeros, WriteOptions::deflated(9)) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let bomb_zip = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }

  // 1. Rejected by default max_compression_ratio (100)
  let r = match ZipReader::open(bomb_zip) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  match r.open_by_name("bomb.bin") {
    Err(ZipError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded for ratio bomb, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "ratio bomb must be rejected")
  }

  // 2. Rejected by max_entry_size (64 KiB) even if ratio limit is disabled
  let lim_size = Limits::{
    ..Limits::permissive(),
    max_entry_size: 65536L,
  }
  match r.read_entry_with_limits(0, lim_size) {
    Err(ZipError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded for max_entry_size, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "oversized entry must be rejected")
  }

  // 3. Lying header bomb: claims uncompressed_size = 0 (tries to bypass flate 0=unlimited!)
  let name = "lie0.bin".to_bytes()
  let lfh_len = 30 + name.length()
  let cd_off = lfh_len + comp.length()
  let cd_len = 46 + name.length()
  let mut lie = Bytes::new(cd_off + cd_len + 22)
  lie = t_put_u32_le(lie, 0, 0x04034b50U)
  lie = t_put_u16_le(lie, 4, 20U)
  lie = t_put_u16_le(lie, 8, 8U) // deflate
  lie = t_put_u32_le(lie, 14, crc)
  lie = t_put_u32_le(lie, 18, comp.length().to_uint())
  lie = t_put_u32_le(lie, 22, 0U) // LIE: claims 0 bytes!
  lie = t_put_u16_le(lie, 26, name.length().to_uint())
  lie = t_copy_into(lie, 30, name)
  lie = t_copy_into(lie, lfh_len, comp)
  // CD
  lie = t_put_u32_le(lie, cd_off, 0x02014b50U)
  lie = t_put_u16_le(lie, cd_off + 4, 20U)
  lie = t_put_u16_le(lie, cd_off + 6, 20U)
  lie = t_put_u16_le(lie, cd_off + 10, 8U)
  lie = t_put_u32_le(lie, cd_off + 16, crc)
  lie = t_put_u32_le(lie, cd_off + 20, comp.length().to_uint())
  lie = t_put_u32_le(lie, cd_off + 24, 0U) // LIE: claims 0 bytes!
  lie = t_put_u16_le(lie, cd_off + 28, name.length().to_uint())
  lie = t_copy_into(lie, cd_off + 46, name)
  // EOCD
  let eocd_off = cd_off + cd_len
  lie = t_put_u32_le(lie, eocd_off, 0x06054b50U)
  lie = t_put_u16_le(lie, eocd_off + 8, 1U)
  lie = t_put_u16_le(lie, eocd_off + 10, 1U)
  lie = t_put_u32_le(lie, eocd_off + 12, cd_len.to_uint())
  lie = t_put_u32_le(lie, eocd_off + 16, cd_off.to_uint())

  let r_lie = match ZipReader::open(lie) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  match r_lie.open_by_name("lie0.bin") {
    Err(_) => () // MUST reject without OOM!
    Ok(_) => debug_assert(false, "lying uncompressed_size=0 bomb must be rejected")
  }
}

///|
test "security_max_entries_and_max_total_size" {
  let w = ZipWriter::new()
  let mut i = 0
  while i < 10 {
    match w.add_file_stored("f" + i.to_string() + ".txt", t_repeat_str("A", 100)) {
      Ok(_) => ()
      Err(e) => debug_assert(false, zip_error_message(e))
    }
    i = i + 1
  }
  let raw = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  // max_entries = 5 must reject at open
  let lim_entries = Limits::{ ..Limits::default(), max_entries: 5 }
  match ZipReader::open_with_limits(raw, lim_entries) {
    Err(ZipError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "max_entries=5 must reject 10 entries")
  }
  // max_total_size = 500 must reject in read_all
  let lim_total = Limits::{ ..Limits::default(), max_total_size: 500L }
  let r = match ZipReader::open_with_limits(raw, lim_total) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  match r.read_all() {
    Err(ZipError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "max_total_size=500 must reject 1000 total bytes")
  }
}

///|
test "security_duplicate_entries_and_overlapping_entries" {
  // 1. Duplicate filenames: rejected by default, allowed when reject_duplicates = false
  let w = ZipWriter::new()
  match w.add_file_stored("dup.txt", "first".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match w.add_file_stored("dup.txt", "second".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let dup_zip = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  match ZipReader::open(dup_zip) {
    Err(ZipError::DuplicateEntry(_)) => ()
    Err(e) => debug_assert(false, "expected DuplicateEntry, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "duplicate entry must be rejected by default")
  }
  match ZipReader::open_with_limits(dup_zip, Limits::permissive()) {
    Ok(zr) => debug_assert(zr.len() == 2, "permissive allows duplicate entries")
    Err(e) => debug_assert(false, zip_error_message(e))
  }

  // 2. Overlapping entries (two CD records pointing to the exact same LFH offset 0)
  let name1 = "a.txt".to_bytes()
  let name2 = "b.txt".to_bytes()
  let payload = "overlap!".to_bytes()
  let crc = flate::crc32(payload)
  let lfh_len = 30 + name1.length()
  let cd_off = lfh_len + payload.length()
  let cd1_len = 46 + name1.length()
  let cd2_len = 46 + name2.length()
  let cd_size = cd1_len + cd2_len
  let mut ov = Bytes::new(cd_off + cd_size + 22)
  // One LFH at offset 0
  ov = t_put_u32_le(ov, 0, 0x04034b50U)
  ov = t_put_u16_le(ov, 4, 20U)
  ov = t_put_u32_le(ov, 14, crc)
  ov = t_put_u32_le(ov, 18, payload.length().to_uint())
  ov = t_put_u32_le(ov, 22, payload.length().to_uint())
  ov = t_put_u16_le(ov, 26, name1.length().to_uint())
  ov = t_copy_into(ov, 30, name1)
  ov = t_copy_into(ov, lfh_len, payload)
  // CD 1 -> offset 0
  ov = t_put_u32_le(ov, cd_off, 0x02014b50U)
  ov = t_put_u16_le(ov, cd_off + 4, 20U)
  ov = t_put_u16_le(ov, cd_off + 6, 20U)
  ov = t_put_u32_le(ov, cd_off + 16, crc)
  ov = t_put_u32_le(ov, cd_off + 20, payload.length().to_uint())
  ov = t_put_u32_le(ov, cd_off + 24, payload.length().to_uint())
  ov = t_put_u16_le(ov, cd_off + 28, name1.length().to_uint())
  ov = t_copy_into(ov, cd_off + 46, name1)
  // CD 2 -> ALSO offset 0 (overlapping!)
  let cd2 = cd_off + cd1_len
  ov = t_put_u32_le(ov, cd2, 0x02014b50U)
  ov = t_put_u16_le(ov, cd2 + 4, 20U)
  ov = t_put_u16_le(ov, cd2 + 6, 20U)
  ov = t_put_u32_le(ov, cd2 + 16, crc)
  ov = t_put_u32_le(ov, cd2 + 20, payload.length().to_uint())
  ov = t_put_u32_le(ov, cd2 + 24, payload.length().to_uint())
  ov = t_put_u16_le(ov, cd2 + 28, name2.length().to_uint())
  ov = t_copy_into(ov, cd2 + 46, name2)
  // EOCD
  let eocd = cd_off + cd_size
  ov = t_put_u32_le(ov, eocd, 0x06054b50U)
  ov = t_put_u16_le(ov, eocd + 8, 2U)
  ov = t_put_u16_le(ov, eocd + 10, 2U)
  ov = t_put_u32_le(ov, eocd + 12, cd_size.to_uint())
  ov = t_put_u32_le(ov, eocd + 16, cd_off.to_uint())

  match ZipReader::open(ov) {
    Err(ZipError::OverlappingEntries(_)) => ()
    Err(e) => debug_assert(false, "expected OverlappingEntries, got: " + zip_error_message(e))
    Ok(_) => debug_assert(false, "overlapping entries must be rejected")
  }
}

///|
test "security_malformed_eocd_forged_offsets_and_truncations" {
  // Empty / tiny inputs
  match ZipReader::open(Bytes::new(0)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "0-byte input must fail")
  }
  match ZipReader::open("not a zip archive at all!".to_bytes()) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "garbage input must fail")
  }

  // Build a real archive and test EVERY prefix truncation (0..len-1) for 0 panics
  let w = ZipWriter::new()
  match w.add_file("hello.txt", "hello world hello world".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let valid = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  let mut cut = 0
  while cut < valid.length() {
    let prefix = valid.slice(0, cut)
    match ZipReader::open(prefix) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "truncated zip at " + cut.to_string() + " must fail")
    }
    cut = cut + 1
  }

  // Forged CD offset pointing past EOCD
  let mut forged = Bytes::new(22)
  forged = t_put_u32_le(forged, 0, 0x06054b50U)
  forged = t_put_u16_le(forged, 8, 1U)
  forged = t_put_u16_le(forged, 10, 1U)
  forged = t_put_u32_le(forged, 12, 100U)
  forged = t_put_u32_le(forged, 16, 999999U)
  match ZipReader::open(forged) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "forged CD offset must fail")
  }
}

///|
test "security_redteam_regressions_dos_time_paths_sfx_trailing_lfh_name" {
  // 1. DosDateTime range clamping and invalid calendar date normalization
  let pre = DosDateTime::new(1979, 6, 15, 12, 30, 40)
  debug_assert(
    pre.year == 1980 && pre.month == 1 && pre.day == 1 && pre.hour == 0 && pre.minute == 0 && pre.second == 0,
    "pre-1980 clamps to 1980-01-01 00:00:00",
  )
  let post = DosDateTime::from_unix(7258118400L) // 2200-01-01
  debug_assert(
    post.year == 2107 && post.month == 12 && post.day == 31 && post.hour == 23 && post.minute == 59 && post.second == 58,
    "post-2107 clamps to 2107-12-31 23:59:58",
  )
  let feb31 = DosDateTime::new(2023, 2, 31, 0, 0, 0)
  debug_assert(feb31.year == 2023 && feb31.month == 2 && feb31.day == 28, "2023-02-31 clamps to 2023-02-28")

  // 2. Hardened Windows path sanitization gaps
  let extra_bad = [
    "COM\u{b9}",
    "COM\u{b2}.txt",
    "COM\u{b3}",
    "LPT\u{b9}",
    "LPT\u{b2}.txt",
    "LPT\u{b3}",
    "CONIN$",
    "conout$.log",
    "foo.",
    "foo ",
    "a/.. /b",
    "a\u{01}b",
    "a\u{1f}b",
    "a\u{7f}b",
  ]
  let mut i = 0
  while i < extra_bad.length() {
    match clean_extract_path(extra_bad[i]) {
      Err(ZipError::InsecurePath(_)) => ()
      _ => debug_assert(false, "expected InsecurePath for " + extra_bad[i])
    }
    i = i + 1
  }

  // 3. Prepended SFX stub (baseOffset) + trailing bytes after EOCD
  let w = ZipWriter::new()
  let _ = w.add_file_stored("hello.txt", "sfx-payload".to_bytes())
  let base_zip = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  let sfx = "#!/bin/sh\necho stub\n".to_bytes().concat(base_zip).concat(Bytes::new(16))
  match ZipReader::open(sfx) {
    Ok(zr) => {
      debug_assert(zr.len() == 1, "sfx + trailing opens with 1 entry")
      match zr.open_by_name("hello.txt") {
        Ok(b) => debug_assert(b.to_string() == "sfx-payload", "sfx payload")
        Err(e) => debug_assert(false, zip_error_message(e))
      }
    }
    Err(e) => debug_assert(false, "sfx + trailing failed: " + zip_error_message(e))
  }

  // 4. LFH vs CD filename mismatch must be rejected on read_entry
  let mut bad_lfh = base_zip.slice(0, base_zip.length())
  // Mutate first char of LFH filename at offset 30 ('h' -> 'x') while CD keeps "hello.txt"
  bad_lfh[30] = 120.to_byte()
  match ZipReader::open(bad_lfh) {
    Ok(zr) =>
    match zr.read_entry(0) {
      Err(ZipError::InvalidArchive(_)) => ()
      _ => debug_assert(false, "LFH/CD filename mismatch must fail")
    }
    Err(_) => ()
  }
}
