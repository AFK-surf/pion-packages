///| APPNOTE 6.3.10 & Go `archive/zip` compliance and real interoperability test suite.

import "flate"

///|
fn t_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn t_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn t_repeat_str(s : String, n : Int) -> Bytes {
  let sb = StringBuilder::with_capacity(s.length() * n)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string().to_bytes()
}

///|
fn t_put_u16_le(b : Bytes, off : Int, v : UInt) -> Bytes {
  let mut out = b
  out[off] = (v & 0xFFU).to_int().to_byte()
  out[off + 1] = ((v >> 8) & 0xFFU).to_int().to_byte()
  out
}

///|
fn t_put_u32_le(b : Bytes, off : Int, v : UInt) -> Bytes {
  let mut out = b
  out[off] = (v & 0xFFU).to_int().to_byte()
  out[off + 1] = ((v >> 8) & 0xFFU).to_int().to_byte()
  out[off + 2] = ((v >> 16) & 0xFFU).to_int().to_byte()
  out[off + 3] = ((v >> 24) & 0xFFU).to_int().to_byte()
  out
}

///|
fn t_put_u64_le(b : Bytes, off : Int, v : Int64) -> Bytes {
  let mut out = b
  let mut i = 0
  while i < 8 {
    out[off + i] = ((v >> (i * 8)) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  out
}

///|
fn t_copy_into(dst : Bytes, off : Int, src : Bytes) -> Bytes {
  let mut out = dst
  let mut i = 0
  while i < src.length() {
    out[off + i] = src[i]
    i = i + 1
  }
  out
}

///|
test "dos_datetime_encode_decode_and_unix_roundtrip" {
  let dt = DosDateTime::new(2025, 11, 23, 14, 30, 12)
  let (d, t) = dt.to_dos()
  // 2025-1980=45 -> (45<<9) | (11<<5) | 23 = 23040 + 352 + 23 = 23415 = 0x5B77
  // 14:30:12 -> (14<<11) | (30<<5) | 6 = 28672 + 960 + 6 = 29638 = 0x73C6
  debug_assert(d == 0x5B77U, "dos date encoding")
  debug_assert(t == 0x73C6U, "dos time encoding")
  let rt = DosDateTime::from_dos(d, t)
  debug_assert(rt.year == 2025 && rt.month == 11 && rt.day == 23, "dos date decode")
  debug_assert(rt.hour == 14 && rt.minute == 30 && rt.second == 12, "dos time decode")

  // Unix roundtrip (even seconds)
  let unix_sec = rt.to_unix()
  let from_u = DosDateTime::from_unix(unix_sec)
  debug_assert(
    from_u.year == 2025 &&
    from_u.month == 11 &&
    from_u.day == 23 &&
    from_u.hour == 14 &&
    from_u.minute == 30 &&
    from_u.second == 12,
    "unix roundtrip",
  )

  // Leap year 2024-02-29 23:59:58
  let leap = DosDateTime::new(2024, 2, 29, 23, 59, 58)
  let leap_rt = DosDateTime::from_unix(leap.to_unix())
  debug_assert(
    leap_rt.year == 2024 &&
    leap_rt.month == 2 &&
    leap_rt.day == 29 &&
    leap_rt.hour == 23 &&
    leap_rt.minute == 59 &&
    leap_rt.second == 58,
    "leap year unix roundtrip",
  )
}

///|
test "empty_archive_roundtrip" {
  let w = ZipWriter::new()
  match w.set_comment("empty archive") {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let raw = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      Bytes::new(0)
    }
  }
  // 22 byte EOCD + 13 byte comment
  debug_assert(raw.length() == 35, "empty archive length")
  let r = match ZipReader::open(raw) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  debug_assert(r.is_empty() && r.len() == 0, "empty reader count")
  debug_assert(r.comment() == "empty archive", "empty reader comment")
}

///|
test "eocd_max_65535_byte_comment_and_fake_sig_in_comment" {
  let w = ZipWriter::new()
  match w.add_file_stored("a.txt", "hello".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  // Build a 65535-byte comment containing a fake PK\x05\x06 signature inside it
  let sb = StringBuilder::with_capacity(65535)
  sb.write_string("PK\u{05}\u{06}fake-eocd-inside-comment")
  while sb.length() < 65535 {
    sb.write_string("x")
  }
  let big_comment = sb.to_string()
  debug_assert(big_comment.to_bytes().length() == 65535, "max comment len")
  match w.set_comment(big_comment) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let raw = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  let r = match ZipReader::open(raw) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  debug_assert(r.len() == 1, "1 entry with 65535B comment")
  debug_assert(r.comment().length() == 65535, "comment length preserved")
  match r.open_by_name("a.txt") {
    Ok(d) => debug_assert(d.to_string() == "hello", "entry content")
    Err(e) => debug_assert(false, zip_error_message(e))
  }
}

///|
test "writer_reader_store_deflate_levels_utf8_dir_symlink_metadata" {
  let w = ZipWriter::new()
  let ts = DosDateTime::new(2026, 5, 1, 10, 20, 30)
  match w.set_comment("测试归档注释") {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match
  w.add_file_with_options(
    "stored.txt",
    "Stored content 12345".to_bytes(),
    WriteOptions::{
      ..WriteOptions::stored(),
      modified: ts,
      comment: "stored comment",
      unix_mode: 0x81A4U,
    },
  )
  {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  let payload = t_repeat_str("The quick brown fox jumps over the lazy dog.\n", 64)
  // Test multiple compression levels 0, 1, 6, 9
  let levels = [0, 1, 6, 9]
  let mut li = 0
  while li < levels.length() {
    let lvl = levels[li]
    match
    w.add_file_with_options(
      "deflate_L" + lvl.to_string() + ".txt",
      payload,
      WriteOptions::{
        ..WriteOptions::deflated(lvl),
        modified: ts,
        unix_mode: 0x81EDU,
      },
    )
    {
      Ok(_) => ()
      Err(e) => debug_assert(false, zip_error_message(e))
    }
    li = li + 1
  }
  match w.add_file("目录/日本語-🚀.txt", "Unicode UTF-8 内容".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match w.add_dir("sub/dir") {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }
  match w.add_symlink("link.txt", "stored.txt") {
    Ok(_) => ()
    Err(e) => debug_assert(false, zip_error_message(e))
  }

  let raw = match w.finish() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  let r = match ZipReader::open(raw) {
    Ok(zr) => zr
    Err(e) => {
      debug_assert(false, zip_error_message(e))
      return
    }
  }
  debug_assert(r.len() == 8, "8 entries")
  debug_assert(r.comment() == "测试归档注释", "utf8 archive comment")

  // Verify stored entry metadata
  match r.entry_at(0) {
    Some(e) => {
      debug_assert(e.name == "stored.txt", "name")
      debug_assert(e.method == method_store(), "method store")
      debug_assert(e.comment == "stored comment", "file comment")
      debug_assert(e.modified.year == 2026 && e.modified.month == 5, "dos time")
      debug_assert(!e.is_dir() && !e.is_symlink(), "regular file")
      match e.unix_mode() {
        Some(m) => debug_assert(m == 0x81A4U, "unix mode 0100644")
        None => debug_assert(false, "expected unix mode")
      }
    }
    None => debug_assert(false, "missing entry 0")
  }

  // Verify deflate levels
  li = 0
  while li < levels.length() {
    let name = "deflate_L" + levels[li].to_string() + ".txt"
    match r.open_by_name(name) {
      Ok(out) => debug_assert(t_bytes_eq(out, payload), "deflate payload mismatch")
      Err(e) => debug_assert(false, zip_error_message(e))
    }
    li = li + 1
  }

  // Verify UTF-8 flag + content
  match r.find_index("目录/日本語-🚀.txt") {
    Some(idx) => {
      match r.entry_at(idx) {
        Some(e) => debug_assert(e.is_utf8(), "utf8 flag must be set")
        None => debug_assert(false, "missing utf8 entry")
      }
      match r.read_entry(idx) {
        Ok(d) => debug_assert(d.to_string() == "Unicode UTF-8 内容", "utf8 content")
        Err(e) => debug_assert(false, zip_error_message(e))
      }
    }
    None => debug_assert(false, "utf8 entry not found")
  }

  // Verify directory
  match r.find_index("sub/dir/") {
    Some(idx) =>
    match r.entry_at(idx) {
      Some(e) => debug_assert(e.is_dir(), "expected dir")
      None => debug_assert(false, "missing dir")
    }
    None => debug_assert(false, "dir not found")
  }

  // Verify symlink
  match r.find_index("link.txt") {
    Some(idx) => {
      match r.entry_at(idx) {
        Some(e) => debug_assert(e.is_symlink(), "expected symlink")
        None => debug_assert(false, "missing symlink")
      }
      match r.read_entry(idx) {
        Ok(d) => debug_assert(d.to_string() == "stored.txt", "symlink target")
        Err(e) => debug_assert(false, zip_error_message(e))
      }
    }
    None => debug_assert(false, "symlink not found")
  }
}

