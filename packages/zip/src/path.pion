///| Safe ZIP extraction path sanitizer (Zip-Slip & Windows device name defense).
///| Rejects `..` traversal, absolute paths (`/` or `\`), control chars (`0x00..0x1F`, `0x7F`),
///| Windows drive letters & NTFS ADS (`:`), trailing `.` or space on any segment,
///| Windows reserved device names (`CON`, `PRN`, `AUX`, `NUL`, `COM1`..`COM9`, `LPT1`..`LPT9`,
///| `COM¹`..`COM³`, `LPT¹`..`LPT³`, `CONIN$`, `CONOUT$`), and empty/`.`.

///| ASCII uppercase transformation (`'a'..'z' → 'A'..'Z'`).
#verify
pub fn ascii_upper(c : Int) -> Int {
  if c >= 97 && c <= 122 {
    c - 32
  } else {
    c
  }
}

///| Whether `c` is a Unix (`/`) or Windows (`\\`) path separator.
pub fn is_zip_path_sep(c : Int) -> Bool {
  c == 47 || c == 92
}

///| Whether `c` is forbidden in any ZIP extraction path (C0 controls, DEL, or `:`).
pub fn is_zip_forbidden_byte(c : Int) -> Bool {
  c < 32 || c == 127 || c == 58
}

///| Whether `c` is a forbidden trailing character on a ZIP path segment (`.` or SP).
pub fn is_zip_forbidden_seg_tail(c : Int) -> Bool {
  c == 46 || c == 32
}

///| Whether 3 ASCII bytes match a Windows 3-char reserved device (`CON`, `PRN`, `AUX`, `NUL`, case-insensitive).
pub fn is_win_reserved_3(b0 : Int, b1 : Int, b2 : Int) -> Bool {
  let c0 = ascii_upper(b0)
  let c1 = ascii_upper(b1)
  let c2 = ascii_upper(b2)
  (c0 == 67 && c1 == 79 && c2 == 78) ||
  (c0 == 80 && c1 == 82 && c2 == 78) ||
  (c0 == 65 && c1 == 85 && c2 == 88) ||
  (c0 == 78 && c1 == 85 && c2 == 76)
}

///| Whether 4 ASCII bytes match a Windows 4-char reserved device (`COM1..COM9`, `LPT1..LPT9`, case-insensitive).
pub fn is_win_reserved_4(b0 : Int, b1 : Int, b2 : Int, b3 : Int) -> Bool {
  let c0 = ascii_upper(b0)
  let c1 = ascii_upper(b1)
  let c2 = ascii_upper(b2)
  b3 >= 49 && b3 <= 57 && ((c0 == 67 && c1 == 79 && c2 == 77) || (c0 == 76 && c1 == 80 && c2 == 84))
}

///| Check whether a path segment is a Windows reserved device name (case-insensitive, with optional extension).
fn is_windows_reserved_name(b : Bytes, start : Int, end : Int) -> Bool {
  // Base name ends at first '.' (if any)
  let mut base_end = start
  while base_end < end && b[base_end].to_int() != 46 {
    base_end = base_end + 1
  }
  // Trim trailing spaces on the base name (Windows ignores trailing spaces)
  while base_end > start && b[base_end - 1].to_int() == 32 {
    base_end = base_end - 1
  }
  let blen = base_end - start
  if blen == 3 {
    if is_win_reserved_3(b[start].to_int(), b[start + 1].to_int(), b[start + 2].to_int()) {
      return true
    }
  } else if blen == 4 {
    if is_win_reserved_4(
      b[start].to_int(),
      b[start + 1].to_int(),
      b[start + 2].to_int(),
      b[start + 3].to_int(),
    ) {
      return true
    }
  } else if blen == 5 {
    // COM¹/COM²/COM³, LPT¹/LPT²/LPT³ (UTF-8: 0xC2 0xB9 / 0xB2 / 0xB3)
    let c0 = ascii_upper(b[start].to_int())
    let c1 = ascii_upper(b[start + 1].to_int())
    let c2 = ascii_upper(b[start + 2].to_int())
    let c3 = b[start + 3].to_int()
    let c4 = b[start + 4].to_int()
    if c3 == 0xC2 && (c4 == 0xB9 || c4 == 0xB2 || c4 == 0xB3) {
      if (c0 == 67 && c1 == 79 && c2 == 77) || (c0 == 76 && c1 == 80 && c2 == 84) {
        return true
      }
    }
  } else if blen == 6 {
    // CONIN$
    if ascii_upper(b[start].to_int()) == 67 &&
    ascii_upper(b[start + 1].to_int()) == 79 &&
    ascii_upper(b[start + 2].to_int()) == 78 &&
    ascii_upper(b[start + 3].to_int()) == 73 &&
    ascii_upper(b[start + 4].to_int()) == 78 &&
    b[start + 5].to_int() == 36 {
      return true
    }
  } else if blen == 7 {
    // CONOUT$
    if ascii_upper(b[start].to_int()) == 67 &&
    ascii_upper(b[start + 1].to_int()) == 79 &&
    ascii_upper(b[start + 2].to_int()) == 78 &&
    ascii_upper(b[start + 3].to_int()) == 79 &&
    ascii_upper(b[start + 4].to_int()) == 85 &&
    ascii_upper(b[start + 5].to_int()) == 84 &&
    b[start + 6].to_int() == 36 {
      return true
    }
  }
  false
}

///| Validate and normalize a ZIP entry path for safe extraction.
pub fn clean_extract_path(name : String) -> Result[String, ZipError] {
  let b = name.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(ZipError::InsecurePath(name))
  }
  // Reject leading '/' or '\'
  let first = b[0].to_int()
  if is_zip_path_sep(first) {
    return Err(ZipError::InsecurePath(name))
  }
  // Reject control characters (0x00..0x1F, 0x7F) and ':' (Windows drive letters & NTFS ADS)
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if is_zip_forbidden_byte(c) {
      return Err(ZipError::InsecurePath(name))
    }
    i = i + 1
  }
  // Split on '/' and '\', reject "..", trailing '.'/' ', and Windows reserved device names; skip "." and empty segments
  let segs : Array[String] = []
  let mut start = 0
  i = 0
  while i <= n {
    let is_sep = i == n || is_zip_path_sep(b[i].to_int())
    if is_sep {
      let seg_len = i - start
      if seg_len == 2 && b[start].to_int() == 46 && b[start + 1].to_int() == 46 {
        return Err(ZipError::InsecurePath(name))
      }
      if seg_len > 0 && !(seg_len == 1 && b[start].to_int() == 46) {
        let last = b[i - 1].to_int()
        if is_zip_forbidden_seg_tail(last) {
          return Err(ZipError::InsecurePath(name))
        }
        if is_windows_reserved_name(b, start, i) {
          return Err(ZipError::InsecurePath(name))
        }
        segs.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if segs.length() == 0 {
    return Err(ZipError::InsecurePath(name))
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < segs.length() {
    if i > 0 {
      sb.write_string("/")
    }
    sb.write_string(segs[i])
    i = i + 1
  }
  Ok(sb.to_string())
}
