///| ZIP archive writer (`ZipWriter`) producing APPNOTE 6.3.10 & ZIP64 compliant archives.
///| Uses a 64 KiB chunked buffer + balanced pairwise `Bytes::concat` for O(N) serialization.

import "flate"

///| Chunked binary builder for fast header & payload assembly.
struct ZipBuf {
  mut buf : Bytes
  mut len : Int
  chunks : Array[Bytes]
}

///|
fn ZipBuf::new() -> ZipBuf {
  ZipBuf::{ buf: Bytes::new(65536), len: 0, chunks: [] }
}

///|
fn zb_ensure(zb : ZipBuf, extra : Int) -> Unit {
  if zb.len + extra <= zb.buf.length() {
    return
  }
  if zb.len > 0 {
    zb.chunks.push(zb.buf.slice(0, zb.len))
    zb.len = 0
  }
  if extra > zb.buf.length() {
    zb.buf = Bytes::new(extra)
  }
}

///|
fn zb_push_u16(zb : ZipBuf, v : UInt) -> Unit {
  zb_ensure(zb, 2)
  zb.buf[zb.len] = (v & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 1] = ((v >> 8) & 0xFFU).to_int().to_byte()
  zb.len = zb.len + 2
}

///|
fn zb_push_u32(zb : ZipBuf, v : UInt) -> Unit {
  zb_ensure(zb, 4)
  zb.buf[zb.len] = (v & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 1] = ((v >> 8) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 2] = ((v >> 16) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 3] = ((v >> 24) & 0xFFU).to_int().to_byte()
  zb.len = zb.len + 4
}

///|
fn zb_push_u64(zb : ZipBuf, v : Int64) -> Unit {
  zb_ensure(zb, 8)
  let lo = (v & 0xFFFFFFFFL).to_int().to_uint()
  let hi = ((v >> 32) & 0xFFFFFFFFL).to_int().to_uint()
  zb.buf[zb.len] = (lo & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 1] = ((lo >> 8) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 2] = ((lo >> 16) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 3] = ((lo >> 24) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 4] = (hi & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 5] = ((hi >> 8) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 6] = ((hi >> 16) & 0xFFU).to_int().to_byte()
  zb.buf[zb.len + 7] = ((hi >> 24) & 0xFFU).to_int().to_byte()
  zb.len = zb.len + 8
}

///|
fn zb_push_bytes(zb : ZipBuf, data : Bytes) -> Unit {
  let n = data.length()
  if n == 0 {
    return
  }
  if n >= 2048 {
    if zb.len > 0 {
      zb.chunks.push(zb.buf.slice(0, zb.len))
      zb.len = 0
    }
    zb.chunks.push(data)
    return
  }
  zb_ensure(zb, n)
  let mut i = 0
  while i < n {
    zb.buf[zb.len + i] = data[i]
    i = i + 1
  }
  zb.len = zb.len + n
}

///|
fn zb_finish(zb : ZipBuf) -> Bytes {
  if zb.chunks.length() == 0 {
    return zb.buf.slice(0, zb.len)
  }
  if zb.len > 0 {
    zb.chunks.push(zb.buf.slice(0, zb.len))
    zb.len = 0
  }
  concat_bytes_chunks(zb.chunks)
}

///| Returns true if `b` contains any non-ASCII byte (>= 0x80).
fn has_non_ascii(b : Bytes) -> Bool {
  let mut i = 0
  while i < b.length() {
    if b[i].to_int() >= 128 {
      return true
    }
    i = i + 1
  }
  false
}

///| Internal Central Directory record tracked while building a ZIP archive.
struct CdRecord {
  name : Bytes
  comment : Bytes
  method : UInt
  flags : UInt
  dos_time : UInt
  dos_date : UInt
  crc32 : UInt
  compressed_size : Int64
  uncompressed_size : Int64
  external_attr : UInt
  local_header_offset : Int64
  force_zip64 : Bool
}

///| In-memory ZIP archive builder.
pub struct ZipWriter {
  zb : ZipBuf
  records : Array[CdRecord]
  mut current_offset : Int64
  mut archive_comment : String
  mut finished : Bool
}

///| Create a new empty `ZipWriter`.
pub fn ZipWriter::new() -> ZipWriter {
  ZipWriter::{
    zb: ZipBuf::new(),
    records: [],
    current_offset: 0L,
    archive_comment: "",
    finished: false,
  }
}

///| Set the archive-level EOCD comment (at most 65535 UTF-8 bytes).
pub fn ZipWriter::set_comment(self : ZipWriter, comment : String) -> Result[Unit, ZipError] {
  if self.finished {
    return Err(ZipError::InvalidArgument("ZipWriter already finished"))
  }
  if comment.to_bytes().length() > 65535 {
    return Err(ZipError::InvalidArgument("archive comment exceeds 65535 bytes"))
  }
  self.archive_comment = comment
  Ok(())
}

///| Add a file using default options (Deflate level 6).
pub fn ZipWriter::add_file(self : ZipWriter, name : String, data : Bytes) -> Result[Unit, ZipError] {
  self.add_file_with_options(name, data, WriteOptions::default())
}

///| Add a file using Store (method 0, uncompressed).
pub fn ZipWriter::add_file_stored(
  self : ZipWriter,
  name : String,
  data : Bytes,
) -> Result[Unit, ZipError] {
  self.add_file_with_options(name, data, WriteOptions::stored())
}

///| Add a file with explicit `WriteOptions`.
pub fn ZipWriter::add_file_with_options(
  self : ZipWriter,
  name : String,
  data : Bytes,
  opts : WriteOptions,
) -> Result[Unit, ZipError] {
  if self.finished {
    return Err(ZipError::InvalidArgument("ZipWriter already finished"))
  }
  let name_bytes = name.to_bytes()
  if name_bytes.length() > 65535 {
    return Err(ZipError::InvalidArgument("entry name exceeds 65535 bytes"))
  }
  let comment_bytes = opts.comment.to_bytes()
  if comment_bytes.length() > 65535 {
    return Err(ZipError::InvalidArgument("entry comment exceeds 65535 bytes"))
  }
  if opts.method != method_store() && opts.method != method_deflate() {
    return Err(ZipError::UnsupportedMethod(opts.method))
  }
  if opts.method == method_deflate() && (opts.level < 0 || opts.level > 9) {
    return Err(ZipError::CompressError("invalid deflate level (expected 0..9)"))
  }

  let crc = flate::crc32(data)
  let compressed = if opts.method == method_store() {
    data
  } else {
    match flate::deflate_compress(data, opts.level) {
      Ok(b) => b
      Err(e) => return Err(ZipError::CompressError(flate::flate_error_message(e)))
    }
  }

  let uncomp_len = data.length().to_int64()
  let comp_len = compressed.length().to_int64()
  let lh_offset = self.current_offset
  let need_z64_sizes = opts.force_zip64 ||
  uncomp_len >= 0xFFFFFFFFL ||
  comp_len >= 0xFFFFFFFFL
  let need_z64_cd = need_z64_sizes || lh_offset >= 0xFFFFFFFFL
  let version_needed = if need_z64_cd {
    45U
  } else if opts.method == method_deflate() {
    20U
  } else {
    20U
  }
  let flags = if has_non_ascii(name_bytes) || has_non_ascii(comment_bytes) {
    flag_utf8
  } else {
    0U
  }
  let (dos_date, dos_time) = opts.modified.to_dos()
  let lfh_extra_len = if need_z64_sizes { 20U } else { 0U }

  // Write 30-byte Local File Header
  zb_push_u32(self.zb, sig_local_file_header)
  zb_push_u16(self.zb, version_needed)
  zb_push_u16(self.zb, flags)
  zb_push_u16(self.zb, opts.method)
  zb_push_u16(self.zb, dos_time)
  zb_push_u16(self.zb, dos_date)
  zb_push_u32(self.zb, crc)
  zb_push_u32(
    self.zb,
    if need_z64_sizes { 0xFFFFFFFFU } else { comp_len.to_int().to_uint() },
  )
  zb_push_u32(
    self.zb,
    if need_z64_sizes { 0xFFFFFFFFU } else { uncomp_len.to_int().to_uint() },
  )
  zb_push_u16(self.zb, name_bytes.length().to_uint())
  zb_push_u16(self.zb, lfh_extra_len)
  zb_push_bytes(self.zb, name_bytes)
  if need_z64_sizes {
    // ZIP64 Extra Field (0x0001): header(4) + uncomp(8) + comp(8) = 20 bytes
    zb_push_u16(self.zb, extra_id_zip64)
    zb_push_u16(self.zb, 16U)
    zb_push_u64(self.zb, uncomp_len)
    zb_push_u64(self.zb, comp_len)
  }
  zb_push_bytes(self.zb, compressed)

  self.current_offset = self.current_offset +
  30L +
  name_bytes.length().to_int64() +
  lfh_extra_len.to_int64() +
  comp_len

  let is_dir_name = name_bytes.length() > 0 &&
  name_bytes[name_bytes.length() - 1].to_int() == 47
  let dos_attr = if is_dir_name || (opts.unix_mode & s_ifmt) == s_ifdir {
    0x10U
  } else {
    0U
  }
  let ext_attr = ((opts.unix_mode & 0xFFFFU) << 16) | dos_attr

  self.records.push(
    CdRecord::{
      name: name_bytes,
      comment: comment_bytes,
      method: opts.method,
      flags: flags,
      dos_time: dos_time,
      dos_date: dos_date,
      crc32: crc,
      compressed_size: comp_len,
      uncompressed_size: uncomp_len,
      external_attr: ext_attr,
      local_header_offset: lh_offset,
      force_zip64: opts.force_zip64,
    },
  )
  Ok(())
}

///| Add a directory entry (automatically appends trailing `'/'` if missing).
pub fn ZipWriter::add_dir(self : ZipWriter, name : String) -> Result[Unit, ZipError] {
  self.add_dir_with_options(
    name,
    WriteOptions::{
      ..WriteOptions::stored(),
      unix_mode: 0x41EDU,
    },
  )
}

///| Add a directory entry with explicit options.
pub fn ZipWriter::add_dir_with_options(
  self : ZipWriter,
  name : String,
  opts : WriteOptions,
) -> Result[Unit, ZipError] {
  let n = name.length()
  let dir_name = if n > 0 && name.code_unit_at(n - 1) == 47 {
    name
  } else {
    name + "/"
  }
  let dir_opts = WriteOptions::{
    ..opts,
    method: method_store(),
    level: 0,
    unix_mode: if (opts.unix_mode & s_ifmt) == 0U {
      s_ifdir | (opts.unix_mode & 0x0FFFU)
    } else {
      opts.unix_mode
    },
  }
  self.add_file_with_options(dir_name, Bytes::new(0), dir_opts)
}

///| Add a POSIX symbolic link entry (`S_IFLNK | 0o777`).
pub fn ZipWriter::add_symlink(
  self : ZipWriter,
  name : String,
  target : String,
) -> Result[Unit, ZipError] {
  self.add_file_with_options(
    name,
    target.to_bytes(),
    WriteOptions::{
      ..WriteOptions::stored(),
      unix_mode: 0xA1FFU,
    },
  )
}

///| Finalize the ZIP archive (writes Central Directory + optional ZIP64 EOCD + EOCD).
pub fn ZipWriter::finish(self : ZipWriter) -> Result[Bytes, ZipError] {
  if self.finished {
    return Err(ZipError::InvalidArgument("ZipWriter already finished"))
  }
  self.finished = true

  let cd_start = self.current_offset
  let mut any_zip64 = false
  let mut i = 0
  while i < self.records.length() {
    let r = self.records[i]
    let need_u = r.force_zip64 || r.uncompressed_size >= 0xFFFFFFFFL
    let need_c = r.force_zip64 || r.compressed_size >= 0xFFFFFFFFL
    let need_o = r.force_zip64 || r.local_header_offset >= 0xFFFFFFFFL
    let has_z64 = need_u || need_c || need_o
    if has_z64 {
      any_zip64 = true
    }
    let mut z64_body_len = 0
    if need_u {
      z64_body_len = z64_body_len + 8
    }
    if need_c {
      z64_body_len = z64_body_len + 8
    }
    if need_o {
      z64_body_len = z64_body_len + 8
    }
    let cd_extra_len = if has_z64 { 4 + z64_body_len } else { 0 }
    let ver_needed = if has_z64 { 45U } else { 20U }
    let ver_made_by = (creator_unix << 8) | ver_needed

    zb_push_u32(self.zb, sig_central_dir)
    zb_push_u16(self.zb, ver_made_by)
    zb_push_u16(self.zb, ver_needed)
    zb_push_u16(self.zb, r.flags)
    zb_push_u16(self.zb, r.method)
    zb_push_u16(self.zb, r.dos_time)
    zb_push_u16(self.zb, r.dos_date)
    zb_push_u32(self.zb, r.crc32)
    zb_push_u32(
      self.zb,
      if need_c { 0xFFFFFFFFU } else { r.compressed_size.to_int().to_uint() },
    )
    zb_push_u32(
      self.zb,
      if need_u { 0xFFFFFFFFU } else { r.uncompressed_size.to_int().to_uint() },
    )
    zb_push_u16(self.zb, r.name.length().to_uint())
    zb_push_u16(self.zb, cd_extra_len.to_uint())
    zb_push_u16(self.zb, r.comment.length().to_uint())
    zb_push_u16(self.zb, 0U) // disk number start
    zb_push_u16(self.zb, 0U) // internal file attributes
    zb_push_u32(self.zb, r.external_attr)
    zb_push_u32(
      self.zb,
      if need_o { 0xFFFFFFFFU } else { r.local_header_offset.to_int().to_uint() },
    )
    zb_push_bytes(self.zb, r.name)
    if has_z64 {
      zb_push_u16(self.zb, extra_id_zip64)
      zb_push_u16(self.zb, z64_body_len.to_uint())
      if need_u {
        zb_push_u64(self.zb, r.uncompressed_size)
      }
      if need_c {
        zb_push_u64(self.zb, r.compressed_size)
      }
      if need_o {
        zb_push_u64(self.zb, r.local_header_offset)
      }
    }
    zb_push_bytes(self.zb, r.comment)
    self.current_offset = self.current_offset +
    46L +
    r.name.length().to_int64() +
    cd_extra_len.to_int64() +
    r.comment.length().to_int64()
    i = i + 1
  }

  let cd_size = self.current_offset - cd_start
  let count64 = self.records.length().to_int64()
  let need_z64_eocd = any_zip64 ||
  count64 >= 0xFFFFL ||
  cd_size >= 0xFFFFFFFFL ||
  cd_start >= 0xFFFFFFFFL

  if need_z64_eocd {
    let z64_eocd_off = self.current_offset
    // ZIP64 EOCD Record (56 bytes)
    zb_push_u32(self.zb, sig_zip64_eocd)
    zb_push_u64(self.zb, 44L)
    zb_push_u16(self.zb, (creator_unix << 8) | 45U)
    zb_push_u16(self.zb, 45U)
    zb_push_u32(self.zb, 0U) // disk number
    zb_push_u32(self.zb, 0U) // cd start disk
    zb_push_u64(self.zb, count64)
    zb_push_u64(self.zb, count64)
    zb_push_u64(self.zb, cd_size)
    zb_push_u64(self.zb, cd_start)
    // ZIP64 EOCD Locator (20 bytes)
    zb_push_u32(self.zb, sig_zip64_locator)
    zb_push_u32(self.zb, 0U) // disk with ZIP64 EOCD
    zb_push_u64(self.zb, z64_eocd_off)
    zb_push_u32(self.zb, 1U) // total disks
  }

  let eocd_count = if count64 >= 0xFFFFL {
    0xFFFFU
  } else {
    count64.to_int().to_uint()
  }
  let eocd_cd_size = if cd_size >= 0xFFFFFFFFL {
    0xFFFFFFFFU
  } else {
    cd_size.to_int().to_uint()
  }
  let eocd_cd_off = if cd_start >= 0xFFFFFFFFL {
    0xFFFFFFFFU
  } else {
    cd_start.to_int().to_uint()
  }
  let cmt_bytes = self.archive_comment.to_bytes()

  // 22-byte EOCD
  zb_push_u32(self.zb, sig_eocd)
  zb_push_u16(self.zb, 0U) // disk number
  zb_push_u16(self.zb, 0U) // cd disk
  zb_push_u16(self.zb, eocd_count)
  zb_push_u16(self.zb, eocd_count)
  zb_push_u32(self.zb, eocd_cd_size)
  zb_push_u32(self.zb, eocd_cd_off)
  zb_push_u16(self.zb, cmt_bytes.length().to_uint())
  zb_push_bytes(self.zb, cmt_bytes)

  Ok(zb_finish(self.zb))
}
