///| ZIP archive writer (`ZipWriter`) producing APPNOTE 6.3.10 & ZIP64 compliant archives.

///| Internal Central Directory record tracked while building a ZIP archive.
struct CdRecord {
  name : Bytes
  comment : Bytes
  method : UInt
  flags : UInt
  dos_time : UInt
  dos_date : UInt
  crc32 : UInt
  compressed_size : Int64
  uncompressed_size : Int64
  external_attr : UInt
  local_header_offset : Int64
  force_zip64 : Bool
}

///| In-memory ZIP archive builder.
pub struct ZipWriter {
  chunks : Array[Bytes]
  records : Array[CdRecord]
  mut current_offset : Int64
  mut archive_comment : String
  mut finished : Bool
}

///| Create a new empty `ZipWriter`.
pub fn ZipWriter::new() -> ZipWriter {
  ZipWriter::{
    chunks: [],
    records: [],
    current_offset: 0L,
    archive_comment: "",
    finished: false,
  }
}

///| Set the archive-level EOCD comment (at most 65535 UTF-8 bytes).
pub fn ZipWriter::set_comment(self : ZipWriter, comment : String) -> Result[Unit, ZipError] {
  let _ = self
  let _ = comment
  Err(ZipError::InvalidArchive("not implemented"))
}

///| Add a file using default options (Deflate level 6).
pub fn ZipWriter::add_file(self : ZipWriter, name : String, data : Bytes) -> Result[Unit, ZipError] {
  self.add_file_with_options(name, data, WriteOptions::default())
}

///| Add a file using Store (method 0, uncompressed).
pub fn ZipWriter::add_file_stored(
  self : ZipWriter,
  name : String,
  data : Bytes,
) -> Result[Unit, ZipError] {
  self.add_file_with_options(name, data, WriteOptions::stored())
}

///| Add a file with explicit `WriteOptions`.
pub fn ZipWriter::add_file_with_options(
  self : ZipWriter,
  name : String,
  data : Bytes,
  opts : WriteOptions,
) -> Result[Unit, ZipError] {
  let _ = self
  let _ = name
  let _ = data
  let _ = opts
  Err(ZipError::InvalidArchive("not implemented"))
}

///| Add a directory entry (automatically appends trailing `'/'` if missing).
pub fn ZipWriter::add_dir(self : ZipWriter, name : String) -> Result[Unit, ZipError] {
  self.add_dir_with_options(
    name,
    WriteOptions::{
      ..WriteOptions::stored(),
      unix_mode: 0x41EDU,
    },
  )
}

///| Add a directory entry with explicit options.
pub fn ZipWriter::add_dir_with_options(
  self : ZipWriter,
  name : String,
  opts : WriteOptions,
) -> Result[Unit, ZipError] {
  let _ = self
  let _ = name
  let _ = opts
  Err(ZipError::InvalidArchive("not implemented"))
}

///| Add a POSIX symbolic link entry (`S_IFLNK | 0o777`).
pub fn ZipWriter::add_symlink(
  self : ZipWriter,
  name : String,
  target : String,
) -> Result[Unit, ZipError] {
  self.add_file_with_options(
    name,
    target.to_bytes(),
    WriteOptions::{
      ..WriteOptions::stored(),
      unix_mode: 0xA1FFU,
    },
  )
}

///| Finalize the ZIP archive (writes Central Directory + optional ZIP64 EOCD + EOCD).
pub fn ZipWriter::finish(self : ZipWriter) -> Result[Bytes, ZipError] {
  let _ = self
  Err(ZipError::InvalidArchive("not implemented"))
}
