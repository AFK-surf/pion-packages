///| Pion Native head-to-head benchmark for `packages/zip`.
///| Modes:
///|   read   <mixed_28mb.zip>    <iters>
///|   write  <mixed_28mb.bundle> <iters>
///|   lookup <index_20k.zip>     <iters>

import "zip"

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn read_u16(b : Bytes, off : Int) -> Int {
  b[off].to_int() | (b[off + 1].to_int() << 8)
}

///|
fn read_u32(b : Bytes, off : Int) -> Int {
  b[off].to_int() |
  (b[off + 1].to_int() << 8) |
  (b[off + 2].to_int() << 16) |
  (b[off + 3].to_int() << 24)
}

///|
fn pad_int(v : Int, width : Int) -> String {
  let s = v.to_string()
  if s.length() >= width {
    return s
  }
  let sb = StringBuilder::with_capacity(width)
  let mut k = s.length()
  while k < width {
    sb.write_string("0")
    k = k + 1
  }
  sb.write_string(s)
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: zip_bench <read|write|lookup> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  if mode == "read" {
    let mut total_files : Int64 = 0L
    let mut total_bytes : Int64 = 0L
    let mut xor_crc : UInt = 0U
    let mut it = 0
    while it < iters {
      let r = match zip::ZipReader::open(data) {
        Ok(zr) => zr
        Err(e) => {
          io_println(world, "open error: " + zip::zip_error_message(e))
          return 1
        }
      }
      let n = r.len()
      let mut i = 0
      while i < n {
        let entry = match r.entry_at(i) {
          Some(e) => e
          None => return 1
        }
        match r.read_entry(i) {
          Ok(out) => {
            total_files = total_files + 1L
            total_bytes = total_bytes + out.length().to_int64()
            xor_crc = xor_crc ^ entry.crc32
          }
          Err(e) => {
            io_println(world, "read error: " + zip::zip_error_message(e))
            return 1
          }
        }
        i = i + 1
      }
      it = it + 1
    }
    io_println(
      world,
      "mode=read files=" +
      total_files.to_string() +
      " total_bytes=" +
      total_bytes.to_string() +
      " xor_crc=" +
      xor_crc.to_int64().to_string(),
    )
    return 0
  }

  if mode == "write" {
    // Parse bundle once before timed iterations
    let count = read_u32(data, 0)
    let names : Array[String] = []
    let payloads : Array[Bytes] = []
    let mut pos = 4
    let mut k = 0
    while k < count {
      let nlen = read_u16(data, pos)
      pos = pos + 2
      names.push(data.slice(pos, pos + nlen).to_string())
      pos = pos + nlen
      let dlen = read_u32(data, pos)
      pos = pos + 4
      payloads.push(data.slice(pos, pos + dlen))
      pos = pos + dlen
      k = k + 1
    }

    let opts = zip::WriteOptions::deflated(6)
    let mut last_zip = Bytes::new(0)
    let mut it = 0
    while it < iters {
      let w = zip::ZipWriter::new()
      let mut i = 0
      while i < count {
        match w.add_file_with_options(names[i], payloads[i], opts) {
          Ok(_) => ()
          Err(e) => {
            io_println(world, "write error: " + zip::zip_error_message(e))
            return 1
          }
        }
        i = i + 1
      }
      last_zip = match w.finish() {
        Ok(b) => b
        Err(e) => {
          io_println(world, "finish error: " + zip::zip_error_message(e))
          return 1
        }
      }
      it = it + 1
    }
    // Verify Central Directory metadata of last written archive
    let r = match zip::ZipReader::open(last_zip) {
      Ok(zr) => zr
      Err(e) => {
        io_println(world, "verify open error: " + zip::zip_error_message(e))
        return 1
      }
    }
    let mut total_uncomp : Int64 = 0L
    let mut xor_crc : UInt = 0U
    let mut i = 0
    while i < r.len() {
      match r.entry_at(i) {
        Some(e) => {
          total_uncomp = total_uncomp + e.uncompressed_size
          xor_crc = xor_crc ^ e.crc32
        }
        None => return 1
      }
      i = i + 1
    }
    io_println(
      world,
      "mode=write files=" +
      r.len().to_string() +
      " total_uncomp=" +
      total_uncomp.to_string() +
      " xor_crc=" +
      xor_crc.to_int64().to_string(),
    )
    return 0
  }

  if mode == "lookup" {
    // Pre-build 20,000 deterministic lookup query names outside the timed loop?
    // Keep identical across Pion/Go/Rust: pre-build the 20,000 query names once.
    let queries : Array[String] = []
    let mut rng : Int64 = 123456789L
    let mut q = 0
    while q < 20000 {
      rng = (rng * 1103515245L + 12345L) & 0x7FFFFFFFL
      let idx = (rng % 20000L).to_int()
      queries.push("dir_" + pad_int(idx % 100, 2) + "/file_" + pad_int(idx, 5) + ".txt")
      q = q + 1
    }
    let mut total_lookups : Int64 = 0L
    let mut total_bytes : Int64 = 0L
    let mut acc : Int64 = 0L
    let mut it = 0
    while it < iters {
      let r = match zip::ZipReader::open(data) {
        Ok(zr) => zr
        Err(e) => {
          io_println(world, "open error: " + zip::zip_error_message(e))
          return 1
        }
      }
      let mut i = 0
      while i < 20000 {
        match r.open_by_name(queries[i]) {
          Ok(b) => {
            total_lookups = total_lookups + 1L
            total_bytes = total_bytes + b.length().to_int64()
            acc = acc + b[6].to_int().to_int64()
          }
          Err(e) => {
            io_println(world, "lookup error: " + zip::zip_error_message(e))
            return 1
          }
        }
        i = i + 1
      }
      it = it + 1
    }
    io_println(
      world,
      "mode=lookup lookups=" +
      total_lookups.to_string() +
      " total_bytes=" +
      total_bytes.to_string() +
      " checksum=" +
      acc.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
