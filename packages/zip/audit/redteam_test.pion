///| Red-team unit tests for `packages/zip` (RT-zip audit, base `feat/pkg-zip` @ 2598d1c).
///| Convention (same as packages/flate/audit): a `redteam_*` test encodes the *expected correct*
///| behaviour, so it FAILS (or panics) while the defect exists and PASSES once fixed.
///| `control_*` tests document behaviour that is already correct and must PASS.
///| Archive vectors are generated by `difftest.py vectors()` (ids in the `v_*` doc comments);
///| cross-implementation evidence (Go 1.27 / Rust zip 2.2.3 / Python zipfile) is in REPORT.md.

import "zip"
import "flate"

///|
fn hexv(c : Int) -> Int {
  if c >= 97 {
    c - 87
  } else {
    c - 48
  }
}

///|
fn hexb(s : String) -> Bytes {
  let n = s.length() / 2
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((hexv(s.code_unit_at(2 * i)) << 4) | hexv(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  b
}

///|
fn opened(data : Bytes, limits : zip::Limits) -> Option[zip::ZipReader] {
  match zip::ZipReader::open_with_limits(data, limits) {
    Ok(r) => Some(r)
    Err(_) => None
  }
}

///|
fn entry_name(r : zip::ZipReader, i : Int) -> String {
  match r.entry_at(i) {
    Some(e) => e.name
    None => ""
  }
}

// ---------------------------------------------------------------------------------------------
// P0: memory-safety / panic on untrusted input (native abort, wasm32 trap)

///| P0-1: ZIP64 locator `eocd64_offset = 0x7FFFFFFFFFFFFFF0`: `z64_eocd_off + 56L` wraps negative,
///| the bounds check passes and `to_int()` yields -16 -> `read_u32_le(data, -16)` panics.
test "redteam_p0_zip64_locator_offset_int64_wrap_must_not_panic" {
  match zip::ZipReader::open(v_z64_locator_off_overflow()) {
    Ok(_) => ()
    Err(_) => ()
  }
  debug_assert(true, "reached only if open() did not panic")
}

///| P0-2: ZIP64 EOCD `cd_offset = 2^62 + x`, `cd_size = 2^62 + y`: `cd_offset + cd_size` wraps negative and
///| passes `> eocd_start`; low 32 bits locate the real CD; every later bound uses the huge `cd_offset`, so a
///| local header offset of 0x10000000 is read out of bounds in `check_no_overlaps`.
test "redteam_p0_zip64_cd_offset_size_wrap_must_not_panic" {
  match zip::ZipReader::open(v_z64_wrap_then_far_lfh()) {
    Ok(r) => {
      let _ = r.read_entry(0)
    }
    Err(_) => ()
  }
  match zip::ZipReader::open_with_limits(v_z64_wrap_then_far_lfh(), zip::Limits::permissive()) {
    Ok(r) => {
      let _ = r.read_entry(0)
    }
    Err(_) => ()
  }
  debug_assert(true, "reached only if no panic")
}

///| P0-3: same wrap + Store entry declaring 0x0FFFFF00 bytes and a forged CRC: `Bytes::slice` clamps at EOF,
///| `read_entry` (DEFAULT hardened limits) returns Ok with 453 bytes that include the archive's own CD/EOCD.
test "redteam_p0_store_entry_must_not_return_clamped_short_slice" {
  match zip::ZipReader::open(v_z64_wrap_store_clamp_forged_crc()) {
    Ok(r) =>
    match (r.read_entry(0), r.entry_at(0)) {
      (Ok(b), Some(e)) =>
      debug_assert(
        b.length().to_int64() == e.uncompressed_size,
        "read_entry returned " + b.length().to_string() + " bytes for an entry declaring " +
        e.uncompressed_size.to_string(),
      )
      _ => ()
    }
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------------------------
// P1: parser differentials / interop

///| P1-1: CPython `zipfile` streaming (non-seekable) with `force_zip64=True` writes an LFH ZIP64 extra and a
///| 24-byte ZIP64 data descriptor while the CD carries plain 32-bit sizes (APPNOTE 4.3.9.2). Go/Rust/Python
///| read it; Pion picks the 12-byte descriptor layout from the *CD* sentinel and reports a mismatch.
test "redteam_p1_cpython_streamed_zip64_data_descriptor_readable" {
  match zip::ZipReader::open(v_py_stream_force_zip64()) {
    Ok(r) =>
    match r.read_entry(0) {
      Ok(b) => debug_assert(b.length() == 240, "content length")
      Err(e) => debug_assert(false, "read_entry: " + zip::zip_error_message(e))
    }
    Err(e) => debug_assert(false, "open: " + zip::zip_error_message(e))
  }
}

///| P1-2: SFX / prepended stub (128 B) without offset adjustment: Go (`baseOffset`), Rust and Python read it.
test "redteam_p1_prepended_data_sfx_readable" {
  match zip::ZipReader::open(v_prefix128_unadjusted()) {
    Ok(r) => debug_assert(r.len() == 2, "2 entries")
    Err(e) => debug_assert(false, "open: " + zip::zip_error_message(e))
  }
}

///| P1-3: EOCD entry count (1) smaller than the CD (2 records): Pion silently exposes only the first entry while
///| Python extracts both and Go rejects. The same mechanism makes a non-ZIP64 archive with 100,000 entries
///| (u16 count = 34,464) lose 65,536 entries (see `difftest.py dos`). Expected: reject or expose all records.
test "redteam_p1_cd_records_beyond_eocd_count_not_silently_hidden" {
  match zip::ZipReader::open(v_cd_count_short()) {
    Ok(r) => debug_assert(r.len() == 2, "Pion exposes " + r.len().to_string() + " of 2 CD records")
    Err(_) => ()
  }
}

///| P1-4: EOCD without any 0xFFFF/0xFFFFFFFF sentinel, but a ZIP64 locator+EOCD pointing to a *different* CD.
///| APPNOTE 4.4.1.4 and Go/Rust only consult ZIP64 values when the 32-bit field is a sentinel; Pion always
///| prefers ZIP64 (same as Python), so Pion sees `eocd64.txt` while Rust sees `eocd32.txt`. Expected: reject the
///| inconsistent archive (or follow the 32-bit EOCD).
test "redteam_p1_zip64_eocd_without_sentinel_must_not_override" {
  match zip::ZipReader::open(v_z64_eocd_disagrees_no_sentinel()) {
    Ok(r) => debug_assert(entry_name(r, 0) != "eocd64.txt", "ZIP64 EOCD overrode a sentinel-free EOCD")
    Err(_) => ()
  }
}

///| P1-5: LFH filename differs from CD filename. Python rejects; Pion (like Go/Rust) silently serves the bytes.
///| A Pion-based scanner and a tool trusting LFH names (streaming extractors) see different files.
test "redteam_p1_lfh_cd_filename_mismatch_rejected" {
  match zip::ZipReader::open(v_lfh_name_differs()) {
    Ok(r) =>
    match r.read_entry(0) {
      Ok(_) => debug_assert(false, "LFH name 'evil.sh' accepted for CD name 'good.txt'")
      Err(_) => ()
    }
    Err(_) => ()
  }
}

///| P1-6: trailing bytes after the EOCD (common after signing / transport padding) are rejected outright;
///| Go/Rust/Python accept.
test "redteam_p1_trailing_bytes_after_eocd_readable" {
  match zip::ZipReader::open(v_trailing_16()) {
    Ok(r) => debug_assert(r.len() == 1, "1 entry")
    Err(e) => debug_assert(false, "open: " + zip::zip_error_message(e))
  }
}

// ---------------------------------------------------------------------------------------------
// P2

///| P2-1: ZIP64 `total_entries = 0x80000001` with permissive limits: `to_int()` truncates to a negative Int and
///| the archive silently opens with 0 entries.
test "redteam_p2_zip64_entry_count_truncation" {
  match zip::ZipReader::open_with_limits(v_z64_entries_neg_as_int(), zip::Limits::permissive()) {
    Ok(r) => debug_assert(r.len() != 0, "0x80000001 declared entries silently became 0")
    Err(_) => ()
  }
}

///| P2-2: MS-DOS timestamp clamping keeps month/day: 1979-06-15 -> 1980-06-15 (Go: 1980-01-01), 2200 -> 2107-01-01
///| (Python strict_timestamps=False: 2107-12-31 23:59:58), 2023-02-31 is written verbatim (Rust: invalid date).
test "redteam_p2_dos_datetime_out_of_range_and_invalid_dates" {
  let a = zip::DosDateTime::new(1979, 6, 15, 12, 0, 0)
  debug_assert(a.year == 1980 && a.month == 1 && a.day == 1 && a.hour == 0, "pre-1980 must clamp to 1980-01-01 00:00")
  let b = zip::DosDateTime::from_unix(7258118400L) // 2200-01-01
  debug_assert(b.year == 2107 && b.month == 12 && b.day == 31, "post-2107 must clamp to 2107-12-31")
  let c = zip::DosDateTime::new(2023, 2, 31, 0, 0, 0)
  debug_assert(!(c.month == 2 && c.day == 31), "Feb 31 must be rejected or normalised")
}

///| P2-3: `clean_extract_path` misses Windows-reserved names that Go's Windows `filepath.IsLocal` rejects
///| (superscript COM¹..³/LPT¹..³, CONIN$, CONOUT$) and Win32 aliasing names (trailing dot / space).
test "redteam_p2_clean_extract_path_windows_gaps" {
  let bad = ["COM\u{b9}", "LPT\u{b2}.txt", "CONIN$", "CONOUT$", "foo.", "foo ", "a/.. /b", "a\u{1}b"]
  let mut i = 0
  while i < bad.length() {
    match zip::clean_extract_path(bad[i]) {
      Ok(p) => debug_assert(false, "accepted Windows-unsafe path: " + p)
      Err(_) => ()
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------------------------
// controls (already correct; Pion is stricter than or equal to Go/Rust/Python here)

///|
test "control_full_overlap_bomb_rejected_by_default" {
  match zip::ZipReader::open(v_bomb_full_overlap_64()) {
    Ok(_) => debug_assert(false, "64 entries sharing one payload accepted")
    Err(zip::ZipError::OverlappingEntries(_)) => ()
    Err(e) => debug_assert(false, zip::zip_error_message(e))
  }
  match zip::ZipReader::open(v_overlap_nested_lfh()) {
    Ok(_) => debug_assert(false, "nested LFH accepted")
    Err(_) => ()
  }
}

///|
test "control_duplicate_names_rejected_by_default" {
  match zip::ZipReader::open(v_name_dup()) {
    Err(zip::ZipError::DuplicateEntry(_)) => ()
    _ => debug_assert(false, "duplicate accepted")
  }
}

///|
test "control_zip64_extra_order_csize_only" {
  match zip::ZipReader::open(v_z64_only_csize()) {
    Ok(r) =>
    match r.read_entry(0) {
      Ok(b) => debug_assert(b.length() == 420, "len")
      Err(e) => debug_assert(false, zip::zip_error_message(e))
    }
    Err(e) => debug_assert(false, zip::zip_error_message(e))
  }
}

///|
test "control_honest_and_lying_bombs_capped" {
  let zeros = Bytes::new(8388608)
  let w = zip::ZipWriter::new()
  let _ = w.add_file("z.bin", zeros)
  let arc = match w.finish() {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  match zip::ZipReader::open(arc) {
    Ok(r) =>
    match r.read_entry(0) {
      Err(zip::ZipError::LimitExceeded(_)) => ()
      _ => debug_assert(false, "8 MiB zeros (ratio ~1000) not rejected by default ratio 100")
    }
    Err(e) => debug_assert(false, zip::zip_error_message(e))
  }
  let _ = flate::crc32(zeros)
}

///|
test "control_writer_rejects_overlong_fields_instead_of_truncating" {
  let w = zip::ZipWriter::new()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 65536 {
    sb.write_string("n")
    i = i + 1
  }
  let long = sb.to_string()
  match w.add_file(long, Bytes::new(1)) {
    Err(zip::ZipError::InvalidArgument(_)) => ()
    _ => debug_assert(false, "65536-byte name accepted")
  }
  match w.set_comment(long) {
    Err(zip::ZipError::InvalidArgument(_)) => ()
    _ => debug_assert(false, "65536-byte comment accepted")
  }
}

///|
test "control_force_zip64_roundtrip" {
  let w = zip::ZipWriter::new()
  let o = zip::WriteOptions::{ ..zip::WriteOptions::default(), force_zip64: true }
  let _ = w.add_file_with_options("a", "hello".to_bytes(), o)
  let _ = w.add_file_with_options("e", Bytes::new(0), o)
  match w.finish() {
    Ok(b) =>
    match zip::ZipReader::open(b) {
      Ok(r) => {
        debug_assert(r.is_zip64() && r.len() == 2, "zip64")
        match r.open_by_name("a") {
          Ok(x) => debug_assert(x.to_string() == "hello", "content")
          Err(e) => debug_assert(false, zip::zip_error_message(e))
        }
      }
      Err(e) => debug_assert(false, zip::zip_error_message(e))
    }
    Err(e) => debug_assert(false, zip::zip_error_message(e))
  }
}

