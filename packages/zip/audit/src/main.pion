///| Red-team differential harness CLI for `packages/zip` (RT-zip).
///| Batch file format: repeated `[u32 LE length][payload]` records.
///| Modes:
///|   batch <cases.bin> <default|permissive>  -> one canonical line per archive (same format as diff/go, diff/rust, Python)
///|   file <archive.zip> <default|permissive> -> one canonical line for one archive (DoS timing)
///|   paths <names.bin>                       -> `OK <hex>` | `ERR` per `clean_extract_path` input
///|   writecases <outdir>                     -> writes Pion `ZipWriter` archives for external readers, prints manifest
///|   prof <mixed.zip> <mixed.bundle> <iters> -> W1/W2 cost breakdown (open / inflate / crc / read_entry / compress / writer)

import "zip"
import "flate"

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn rd_u32(b : Bytes, p : Int) -> Int {
  b[p].to_int() |
  (b[p + 1].to_int() << 8) |
  (b[p + 2].to_int() << 16) |
  (b[p + 3].to_int() << 24)
}

///|
fn rd_u16(b : Bytes, p : Int) -> Int {
  b[p].to_int() | (b[p + 1].to_int() << 8)
}

///|
fn split_records(b : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let n = b.length()
  let mut p = 0
  while p + 4 <= n {
    let len = rd_u32(b, p)
    p = p + 4
    out.push(b.slice(p, p + len))
    p = p + len
  }
  out
}

///|
fn hex(s : String) -> String {
  let b = s.to_bytes()
  let mut o = Bytes::new(b.length() * 2)
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    let hi = v >> 4
    let lo = v & 15
    o[2 * i] = (if hi < 10 { 48 + hi } else { 87 + hi }).to_byte()
    o[2 * i + 1] = (if lo < 10 { 48 + lo } else { 87 + lo }).to_byte()
    i = i + 1
  }
  o.to_string()
}

///|
fn err_name(e : zip::ZipError) -> String {
  match e {
    InvalidArchive(_) => "InvalidArchive"
    Truncated(_) => "Truncated"
    UnsupportedMethod(_) => "UnsupportedMethod"
    UnsupportedFeature(_) => "UnsupportedFeature"
    ChecksumMismatch(_, _) => "ChecksumMismatch"
    DecompressError(_) => "DecompressError"
    CompressError(_) => "CompressError"
    EntryNotFound(_) => "EntryNotFound"
    DuplicateEntry(_) => "DuplicateEntry"
    OverlappingEntries(_) => "OverlappingEntries"
    InsecurePath(_) => "InsecurePath"
    LimitExceeded(_) => "LimitExceeded"
    InvalidArgument(_) => "InvalidArgument"
  }
}

///|
fn limits_for(mode : String) -> zip::Limits {
  if mode == "permissive" {
    zip::Limits::permissive()
  } else {
    zip::Limits::default()
  }
}

///| Canonical line: `OK n=<N>` + ` |<hexname>:OK:<len>:<crc>` / ` |<hexname>:ERR:<Variant>` per entry,
///| or `ERR <Variant>` when the archive does not open.
fn archive_line(data : Bytes, mode : String) -> String {
  match zip::ZipReader::open_with_limits(data, limits_for(mode)) {
    Err(e) => "ERR " + err_name(e)
    Ok(r) => {
      let sb = StringBuilder::new()
      sb.write_string("OK n=" + r.len().to_string())
      let mut i = 0
      while i < r.len() {
        let e = match r.entry_at(i) {
          Some(x) => x
          None => return "ERR internal"
        }
        sb.write_string(" |" + hex(e.name) + ":")
        match r.read_entry(i) {
          Ok(out) =>
          sb.write_string(
            "OK:" +
            out.length().to_string() +
            ":" +
            flate::crc32(out).to_int64().to_string(),
          )
          Err(err) => sb.write_string("ERR:" + err_name(err))
        }
        i = i + 1
      }
      sb.to_string()
    }
  }
}

///|
fn fill(n : Int, seed : Int) -> Bytes {
  let mut b = Bytes::new(n)
  let mut x = seed * 2654435761 + 12345
  let mut i = 0
  while i < n {
    x = x * 1103515245 + 12345
    // half-compressible: printable text with runs
    b[i] = (97 + ((x >> 16) & 7) + (if (i & 64) == 0 { 0 } else { 8 })).to_byte()
    i = i + 1
  }
  b
}

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn finish_to(world : World, w : zip::ZipWriter, path : String) -> String {
  match w.finish() {
    Ok(b) => {
      let _ = fs_write_bytes(world, path, b)
      "OK " + b.length().to_string()
    }
    Err(e) => "ERR " + err_name(e)
  }
}

///|
fn res(r : Result[Unit, zip::ZipError]) -> String {
  match r {
    Ok(_) => "ok"
    Err(e) => "err:" + err_name(e)
  }
}

///| Pion-written archives to be verified by Go / Rust / Python.
fn write_cases(world : World, dir : String) -> Unit {
  let ts = fn(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> zip::WriteOptions {
    zip::WriteOptions::{
      ..zip::WriteOptions::default(),
      modified: zip::DosDateTime::new(y, mo, d, h, mi, s),
    }
  }
  // w01: basic mix
  let w1 = zip::ZipWriter::new()
  let r1 = res(w1.add_file("empty.txt", Bytes::new(0))) +
  "," +
  res(w1.add_file_stored("empty_stored.txt", Bytes::new(0))) +
  "," +
  res(w1.add_file("big_70k_deflate.bin", fill(70000, 1))) +
  "," +
  res(w1.add_file_stored("big_70k_store.bin", fill(70000, 2))) +
  "," +
  res(w1.add_file("dir/中文名-ñ-😀.txt", "utf8 name".to_bytes())) +
  "," +
  res(w1.add_dir("emptydir")) +
  "," +
  res(w1.add_symlink("link", "big_70k_store.bin")) +
  "," +
  res(w1.set_comment("archive comment ✓"))
  io_println(world, "w01_basic.zip " + r1 + " " + finish_to(world, w1, dir + "/w01_basic.zip"))
  // w02: duplicate names (writer accepts; Go/Rust/Python writers also accept with a warning)
  let w2 = zip::ZipWriter::new()
  let r2 = res(w2.add_file("dup.txt", "first".to_bytes())) +
  "," +
  res(w2.add_file("dup.txt", "second".to_bytes()))
  io_println(world, "w02_dup.zip " + r2 + " " + finish_to(world, w2, dir + "/w02_dup.zip"))
  // w03: 65535-byte name + 65535-byte comment (max legal) ; w04: 65536 (must be rejected, not truncated)
  let w3 = zip::ZipWriter::new()
  let r3 = res(w3.add_file(rep("n", 65535), "x".to_bytes())) +
  "," +
  res(w3.set_comment(rep("c", 65535)))
  io_println(world, "w03_maxname.zip " + r3 + " " + finish_to(world, w3, dir + "/w03_maxname.zip"))
  let w4 = zip::ZipWriter::new()
  let r4 = res(w4.add_file(rep("n", 65536), "x".to_bytes())) +
  "," +
  res(w4.set_comment(rep("c", 65536))) +
  "," +
  res(
    w4.add_file_with_options(
      "c.txt",
      "x".to_bytes(),
      zip::WriteOptions::{ ..zip::WriteOptions::default(), comment: rep("e", 65536) },
    ),
  ) +
  "," +
  res(w4.add_dir(rep("d", 65535)))
  io_println(world, "w04_overlong.zip " + r4 + " " + finish_to(world, w4, dir + "/w04_overlong.zip"))
  // w05: force_zip64 on store + deflate + empty
  let z64 = zip::WriteOptions::{ ..zip::WriteOptions::default(), force_zip64: true }
  let w5 = zip::ZipWriter::new()
  let r5 = res(w5.add_file_with_options("z64_deflate.bin", fill(100000, 3), z64)) +
  "," +
  res(
    w5.add_file_with_options(
      "z64_store.bin",
      fill(5000, 4),
      zip::WriteOptions::{ ..z64, method: zip::method_store(), level: 0 },
    ),
  ) +
  "," +
  res(w5.add_file_with_options("z64_empty.bin", Bytes::new(0), z64)) +
  "," +
  res(w5.add_file("plain_after.txt", "plain".to_bytes()))
  io_println(world, "w05_force_zip64.zip " + r5 + " " + finish_to(world, w5, dir + "/w05_force_zip64.zip"))
  // w06: timestamps
  let w6 = zip::ZipWriter::new()
  let r6 = res(w6.add_file_with_options("t_1979_06_15.txt", "a".to_bytes(), ts(1979, 6, 15, 12, 0, 0))) +
  "," +
  res(w6.add_file_with_options("t_2108_03_01.txt", "a".to_bytes(), ts(2108, 3, 1, 12, 0, 0))) +
  "," +
  res(w6.add_file_with_options("t_odd_59s.txt", "a".to_bytes(), ts(2024, 5, 6, 7, 8, 59))) +
  "," +
  res(w6.add_file_with_options("t_leap_2024_02_29.txt", "a".to_bytes(), ts(2024, 2, 29, 23, 59, 58))) +
  "," +
  res(w6.add_file_with_options("t_invalid_2023_02_31.txt", "a".to_bytes(), ts(2023, 2, 31, 0, 0, 0))) +
  "," +
  res(
    w6.add_file_with_options(
      "t_unix_2200.txt",
      "a".to_bytes(),
      zip::WriteOptions::{
        ..zip::WriteOptions::default(),
        modified: zip::DosDateTime::from_unix(7258118400L),
      },
    ),
  ) +
  "," +
  res(
    w6.add_file_with_options(
      "t_unix_1970.txt",
      "a".to_bytes(),
      zip::WriteOptions::{ ..zip::WriteOptions::default(), modified: zip::DosDateTime::from_unix(0L) },
    ),
  )
  io_println(world, "w06_times.zip " + r6 + " " + finish_to(world, w6, dir + "/w06_times.zip"))
  // w07 / w08: 65535 and 70000 entries (ZIP64 EOCD count path)
  let counts = [65535, 70000]
  let mut ci = 0
  while ci < counts.length() {
    let w = zip::ZipWriter::new()
    let mut k = 0
    let mut bad = 0
    while k < counts[ci] {
      match w.add_file_stored("f" + k.to_string(), Bytes::new(0)) {
        Ok(_) => ()
        Err(_) => bad = bad + 1
      }
      k = k + 1
    }
    let nm = "w0" + (7 + ci).to_string() + "_entries_" + counts[ci].to_string() + ".zip"
    io_println(world, nm + " bad=" + bad.to_string() + " " + finish_to(world, w, dir + "/" + nm))
    ci = ci + 1
  }
  // w09: all deflate levels 0..9 on the same payload
  let w9 = zip::ZipWriter::new()
  let mut lv = 0
  let mut r9 = ""
  while lv <= 9 {
    r9 = r9 + res(w9.add_file_with_options("lvl" + lv.to_string(), fill(50000, 9), zip::WriteOptions::deflated(lv))) + ","
    lv = lv + 1
  }
  io_println(world, "w09_levels.zip " + r9 + " " + finish_to(world, w9, dir + "/w09_levels.zip"))
}

///| W1/W2 cost breakdown. Prints `phase ms` lines.
fn prof(world : World, zpath : String, bpath : String, iters : Int) -> Int {
  let data = match fs_read_bytes(world, zpath) {
    Ok(b) => b
    Err(_) => return 3
  }
  let bundle = match fs_read_bytes(world, bpath) {
    Ok(b) => b
    Err(_) => return 3
  }
  let r = match zip::ZipReader::open(data) {
    Ok(x) => x
    Err(_) => return 4
  }
  // precompute compressed slices (as read_entry would see them)
  let slices : Array[Bytes] = []
  let sizes : Array[Int] = []
  let mut i = 0
  while i < r.len() {
    let e = match r.entry_at(i) {
      Some(x) => x
      None => return 4
    }
    let lh = e.local_header_offset.to_int()
    let start = lh + 30 + rd_u16(data, lh + 26) + rd_u16(data, lh + 28)
    slices.push(data.slice(start, start + e.compressed_size.to_int()))
    sizes.push(e.uncompressed_size.to_int())
    i = i + 1
  }
  let mut acc = 0
  let t0 = clock_now_ms(world)
  let mut it = 0
  while it < iters {
    match zip::ZipReader::open(data) {
      Ok(x) => acc = acc + x.len()
      Err(_) => return 4
    }
    it = it + 1
  }
  let t1 = clock_now_ms(world)
  let outs : Array[Bytes] = []
  it = 0
  while it < iters {
    i = 0
    while i < slices.length() {
      match flate::deflate_decompress_with_limit(slices[i], sizes[i] + 1) {
        Ok(o) => {
          acc = acc + o.length()
          if it == 0 {
            outs.push(o)
          }
        }
        Err(_) => return 5
      }
      i = i + 1
    }
    it = it + 1
  }
  let t2 = clock_now_ms(world)
  let mut c : UInt = 0U
  it = 0
  while it < iters {
    i = 0
    while i < outs.length() {
      c = c ^ flate::crc32(outs[i])
      i = i + 1
    }
    it = it + 1
  }
  let t3 = clock_now_ms(world)
  it = 0
  while it < iters {
    i = 0
    while i < r.len() {
      match r.read_entry(i) {
        Ok(o) => acc = acc + o.length()
        Err(_) => return 6
      }
      i = i + 1
    }
    it = it + 1
  }
  let t4 = clock_now_ms(world)
  // writer side
  let count = rd_u32(bundle, 0)
  let names : Array[String] = []
  let payloads : Array[Bytes] = []
  let mut pos = 4
  let mut k = 0
  while k < count {
    let nlen = rd_u16(bundle, pos)
    pos = pos + 2
    names.push(bundle.slice(pos, pos + nlen).to_string())
    pos = pos + nlen
    let dlen = rd_u32(bundle, pos)
    pos = pos + 4
    payloads.push(bundle.slice(pos, pos + dlen))
    pos = pos + dlen
    k = k + 1
  }
  let t5 = clock_now_ms(world)
  let mut l6_bytes = 0
  it = 0
  while it < iters {
    i = 0
    while i < count {
      match flate::deflate_compress(payloads[i], 6) {
        Ok(o) => {
          acc = acc + o.length()
          if it == 0 {
            l6_bytes = l6_bytes + o.length()
          }
        }
        Err(_) => return 7
      }
      i = i + 1
    }
    it = it + 1
  }
  let t6 = clock_now_ms(world)
  it = 0
  while it < iters {
    i = 0
    while i < count {
      c = c ^ flate::crc32(payloads[i])
      i = i + 1
    }
    it = it + 1
  }
  let t7 = clock_now_ms(world)
  it = 0
  while it < iters {
    let w = zip::ZipWriter::new()
    i = 0
    while i < count {
      match w.add_file_with_options(names[i], payloads[i], zip::WriteOptions::deflated(6)) {
        Ok(_) => ()
        Err(_) => return 8
      }
      i = i + 1
    }
    match w.finish() {
      Ok(b) => acc = acc + b.length()
      Err(_) => return 8
    }
    it = it + 1
  }
  let t8 = clock_now_ms(world)
  io_println(world, "read_open_ms " + (t1 - t0).to_string())
  io_println(world, "read_inflate_only_ms " + (t2 - t1).to_string())
  io_println(world, "read_crc32_only_ms " + (t3 - t2).to_string())
  io_println(world, "read_entry_full_ms " + (t4 - t3).to_string())
  io_println(world, "write_deflate_l6_only_ms " + (t6 - t5).to_string())
  io_println(world, "write_crc32_only_ms " + (t7 - t6).to_string())
  io_println(world, "write_zipwriter_full_ms " + (t8 - t7).to_string())
  io_println(world, "write_deflate_l6_bytes " + l6_bytes.to_string())
  io_println(world, "checksum " + acc.to_string() + " " + c.to_int64().to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: zip_audit <batch|file|paths|writecases|prof> ...")
    return 2
  }
  let mode = args[1]
  if mode == "batch" || mode == "file" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let lm = if args.length() >= 4 { args[3] } else { "default" }
    if mode == "file" {
      io_println(world, archive_line(data, lm))
      return 0
    }
    let recs = split_records(data)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      sb.write_string(archive_line(recs[i], lm))
      sb.write_string("\n")
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "paths" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let recs = split_records(data)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      match zip::clean_extract_path(recs[i].to_string()) {
        Ok(p) => sb.write_string("OK " + hex(p) + "\n")
        Err(_) => sb.write_string("ERR\n")
      }
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "writecases" {
    write_cases(world, args[2])
    return 0
  }
  if mode == "prof" && args.length() >= 5 {
    return prof(world, args[2], args[3], parse_int(args[4]))
  }
  2
}
