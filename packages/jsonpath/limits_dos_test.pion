///| Security, DoS resource limits, stack-safety, and Int64 exactness tests.

///|
test "exact_int64_precision_beyond_2_53" {
  let a = match parse_json("9007199254740993") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse int64 a failed: " + e.message)
      return
    }
  }
  let b = match parse_json("9007199254740992") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse int64 b failed: " + e.message)
      return
    }
  }
  debug_assert(!json_value_eq(a, b), "2^53+1 must not equal 2^53")
  debug_assert(to_json_string(a) == "9007199254740993", "exact int64 serialization")
  debug_assert(
    json_value_eq(JsonValue::Int(0L), JsonValue::Float(-0.0)),
    "0L == -0.0",
  )
  debug_assert(
    json_value_eq(JsonValue::Int(42L), JsonValue::Float(42.0)),
    "42L == 42.0",
  )
}

///|
test "limits_deep_nesting_and_descendant_dos" {
  // Build deep nested JSON string (depth 300)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 300 {
    sb.write_char('[')
    i = i + 1
  }
  sb.write_char('1')
  i = 0
  while i < 300 {
    sb.write_char(']')
    i = i + 1
  }
  let deep_str = sb.to_string()

  // Default max_depth=128 rejects depth 300 cleanly without stack overflow
  let rejected = match parse_json(deep_str) {
    Err(e) => {
      match e.kind {
        JsonPathErrorKind::LimitExceeded => true
        _ => false
      }
    }
    Ok(_) => false
  }
  debug_assert(rejected, "depth 300 rejected under default max_depth=128")

  // Higher limit succeeds and descendant query works iteratively
  let high_limits = JsonPathLimits::{
    max_depth: 500,
    max_nodes_visited: 100000,
    max_results: 10000,
    max_patch_ops: 1000,
  }
  let deep_val = match parse_json_with_limits(deep_str, high_limits) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse with max_depth=500 failed: " + e.message)
      return
    }
  }
  let p = match JsonPath::parse("$..*") {
    Ok(q) => q
    Err(_) => return
  }
  let res = match p.query_with_limits(deep_val, high_limits) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "descendant on depth 300 failed: " + e.message)
      return
    }
  }
  debug_assert(res.length() == 300, "descendant found all 300 inner nodes")

  // Exponential descendant DoS: $..*..*..* capped by max_nodes_visited / max_results
  let dos_q = match JsonPath::parse("$..*..*..*") {
    Ok(q) => q
    Err(_) => return
  }
  let tight_limits = JsonPathLimits::{
    max_depth: 500,
    max_nodes_visited: 200,
    max_results: 50,
    max_patch_ops: 10,
  }
  let dos_capped = match dos_q.query_with_limits(deep_val, tight_limits) {
    Err(e) => {
      match e.kind {
        JsonPathErrorKind::LimitExceeded => true
        _ => false
      }
    }
    Ok(_) => false
  }
  debug_assert(dos_capped, "exponential descendant query capped by LimitExceeded")

  // max_patch_ops limit
  let ops : Array[PatchOp] = []
  let mut k = 0
  while k < 20 {
    ops.push(PatchOp::Add("/k" + k.to_string(), JsonValue::Int(k.to_int64())))
    k = k + 1
  }
  let big_patch = JsonPatch::{ ops: ops }
  let patch_capped = match apply_patch_with_limits(JsonValue::Object([]), big_patch, tight_limits) {
    Err(e) => {
      match e.kind {
        JsonPathErrorKind::LimitExceeded => true
        _ => false
      }
    }
    Ok(_) => false
  }
  debug_assert(patch_capped, "patch exceeding max_patch_ops rejected with LimitExceeded")
}

///|
test "redteam_regressions_p0_p1_p2" {
  // P0-1: iterative resolve_mut & apply_patch on deep object (depth 600)
  let sb = StringBuilder::new()
  let pb = StringBuilder::new()
  let mut i = 0
  while i < 600 {
    sb.write_string("{\"a\":")
    pb.write_string("/a")
    i = i + 1
  }
  sb.write_char('1')
  i = 0
  while i < 600 {
    sb.write_char('}')
    i = i + 1
  }
  let deep_lim = JsonPathLimits::{
    max_depth: 700,
    max_nodes_visited: 100000,
    max_results: 10000,
    max_patch_ops: 1000,
  }
  let deep_doc = match parse_json_with_limits(sb.to_string(), deep_lim) {
    Ok(v) => v
    Err(_) => return
  }
  let ptr_s = pb.to_string()
  let ptr = match JsonPointer::parse(ptr_s) {
    Ok(p) => p
    Err(_) => return
  }
  let mut_ok = match ptr.resolve_mut(deep_doc, JsonValue::Int(2L)) {
    Ok(v) => match ptr.resolve(v) {
      Some(JsonValue::Int(x)) => x == 2L
      _ => false
    }
    Err(_) => false
  }
  debug_assert(mut_ok, "P0-1: iterative resolve_mut works at depth 600")
  let rm_default_capped = match apply_patch(deep_doc, JsonPatch::{ ops: [PatchOp::Remove(ptr_s)] }) {
    Err(e) => match e.kind {
      JsonPathErrorKind::LimitExceeded => true
      _ => false
    }
    Ok(_) => false
  }
  debug_assert(rm_default_capped, "P0-1: remove pointer > max_depth returns LimitExceeded")

  // P0-2: copy amplification bomb rejected cleanly with LimitExceeded
  let bomb_ops : Array[PatchOp] = []
  i = 0
  while i < 40 {
    bomb_ops.push(PatchOp::Copy("/a", "/a/-"))
    i = i + 1
  }
  let bomb_doc = JsonValue::Object([("a", JsonValue::Array([JsonValue::Int(1L)]))])
  let bomb_capped = match apply_patch(bomb_doc, JsonPatch::{ ops: bomb_ops }) {
    Err(e) => match e.kind {
      JsonPathErrorKind::LimitExceeded => true
      _ => false
    }
    Ok(_) => false
  }
  debug_assert(bomb_capped, "P0-2: copy amplification bomb rejected with LimitExceeded")

  // P1-1 & P2-4: wide object apply_patch + json_value_eq + diff_patch in linear time
  let add_ops : Array[PatchOp] = []
  i = 0
  while i < 2000 {
    add_ops.push(PatchOp::Add("/k" + i.to_string(), JsonValue::Int(i.to_int64())))
    i = i + 1
  }
  let wide1 = match apply_patch(JsonValue::Object([]), JsonPatch::{ ops: add_ops }) {
    Ok(v) => v
    Err(_) => return
  }
  let wide2 = match apply_patch(wide1, JsonPatch::{ ops: [PatchOp::Replace("/k1999", JsonValue::Int(9999L))] }) {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(json_value_eq(wide1, wide1), "P1-1: wide object self-equality")
  debug_assert(!json_value_eq(wide1, wide2), "P1-1: wide object inequality")
  let wdiff = diff_patch(wide1, wide2)
  debug_assert(wdiff.ops.length() == 1, "P1-1: wide diff produces 1 op")

  // P2-1: iterative merge_patch > 512 depth deletes null leaf instead of returning patch verbatim
  let sb_null = StringBuilder::new()
  i = 0
  while i < 600 {
    sb_null.write_string("{\"a\":")
    i = i + 1
  }
  sb_null.write_string("null")
  i = 0
  while i < 600 {
    sb_null.write_char('}')
    i = i + 1
  }
  let pnull = match parse_json_with_limits(sb_null.to_string(), deep_lim) {
    Ok(v) => v
    Err(_) => return
  }
  let merged = merge_patch(deep_doc, pnull)
  debug_assert(!json_value_eq(merged, pnull), "P2-1: merge_patch >512 depth must not return patch verbatim")
  debug_assert(
    match ptr.resolve(merged) {
      None => true
      Some(_) => false
    },
    "P2-1: merge_patch >512 depth deletes leaf",
  )

  // P2-2: duplicate JSON object keys deduplicated last-wins across parse/query/serialize
  let dup_doc = match parse_json("{\"a\":1,\"a\":2}") {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(to_json_string(dup_doc) == "{\"a\":2}", "P2-2: serialized object has unique keys")
  let dup_w = match query_with_paths("$.*", dup_doc) {
    Ok(ms) => ms
    Err(_) => return
  }
  debug_assert(dup_w.length() == 1 && dup_w[0].path == "$['a']", "P2-2: wildcard yields single last-wins node")

  // P2-3: integers outside Int64 preserved losslessly (u64_max != u64_max - 1)
  let u1 = match parse_json("18446744073709551615") {
    Ok(v) => v
    Err(_) => return
  }
  let u2 = match parse_json("18446744073709551614") {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(to_json_string(u1) == "18446744073709551615", "P2-3: u64_max lossless roundtrip")
  debug_assert(!json_value_eq(u1, u2), "P2-3: u64_max != u64_max - 1")
  let u_float = JsonValue::Float(18446744073709551616.0)
  let u_pow64 = match parse_json("18446744073709551616") {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(json_value_eq(u_pow64, u_float), "P2-3: 2^64 BigInt == 2^64 Double")
  debug_assert(!json_value_eq(u1, u_float), "P2-3: 2^64-1 BigInt != 2^64 Double")
}
