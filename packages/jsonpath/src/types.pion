///| Core types, AST definitions, limits, and error types for `packages/jsonpath`.

import "regex"

///| Category of error returned by `jsonpath` APIs.
pub enum JsonPathErrorKind {
  ParseError
  TypeError
  PointerError
  PatchError
  LimitExceeded
  JsonError
}

///| Structured error returned by parsing, querying, pointer resolution, or patching.
pub struct JsonPathError {
  pub kind : JsonPathErrorKind
  pub offset : Int
  pub message : String
}

///| Construct a `JsonPathError`.
pub fn JsonPathError::new(
  kind : JsonPathErrorKind,
  offset : Int,
  message : String,
) -> JsonPathError {
  JsonPathError::{ kind: kind, offset: offset, message: message }
}

///| Resource and security limits for parsing, querying, and patching.
pub struct JsonPathLimits {
  pub max_depth : Int
  pub max_nodes_visited : Int
  pub max_results : Int
  pub max_patch_ops : Int
}

///| Default resource limits.
pub fn JsonPathLimits::default() -> JsonPathLimits {
  JsonPathLimits::{
    max_depth: 128,
    max_nodes_visited: 1000000,
    max_results: 100000,
    max_patch_ops: 100000,
  }
}

///| Exact JSON DOM value supporting `Int64` and `Double`.
pub enum JsonValue {
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  Array(Array[JsonValue])
  Object(Array[(String, JsonValue)])
}

///| A matched node paired with its RFC 9535 §2.7 Normalized Path.
pub struct NodeMatch {
  pub path : String
  pub value : JsonValue
}

///| RFC 9535 §2.4 expression type system.
pub enum ExprType {
  ValueType
  LogicalType
  NodesType
}

///| Singular query segment (name or index only).
pub enum SingularSeg {
  Name(String)
  Index(Int64)
}

///| Comparison operator in RFC 9535 filter expressions.
pub enum CompOp {
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
}

///| Comparable operand in RFC 9535 comparison expressions.
pub enum Comparable {
  Literal(JsonValue)
  SingularQuery(Bool, Array[SingularSeg]) // Bool: true = relative (@), false = root ($)
  FuncCall(FuncExpr)
}

///| Argument to an RFC 9535 function extension.
pub enum FuncArg {
  Literal(JsonValue)
  FilterQuery(Bool, Array[Segment]) // Bool: true = relative (@), false = root ($)
  LogicalExpr(FilterExpr)
  FuncCall(FuncExpr)
}

///| Function extension invocation with optional pre-compiled I-Regexp.
pub struct FuncExpr {
  pub name : String
  pub ret_type : ExprType
  pub args : Array[FuncArg]
  pub compiled_regex : Option[regex::Regex]
  pub has_const_regex : Bool
}

///| RFC 9535 filter logical expression AST.
pub enum FilterExpr {
  Or(Array[FilterExpr])
  And(Array[FilterExpr])
  Not(FilterExpr)
  Comparison(Comparable, CompOp, Comparable)
  TestQuery(Bool, Array[Segment]) // Bool: true = relative (@), false = root ($)
  TestFunc(FuncExpr)
}

///| RFC 9535 selector AST.
pub enum Selector {
  Name(String)
  Wildcard
  Index(Int64)
  Slice(Option[Int64], Option[Int64], Option[Int64])
  Filter(FilterExpr)
}

///| RFC 9535 segment AST (child or descendant).
pub enum Segment {
  Child(Array[Selector])
  Descendant(Array[Selector])
}

///| Pre-compiled RFC 9535 JSONPath query.
pub struct JsonPath {
  pub source : String
  pub segments : Array[Segment]
}

///| Parsed RFC 6901 JSON Pointer.
pub struct JsonPointer {
  pub tokens : Array[String]
}

///| Single RFC 6902 JSON Patch operation.
pub enum PatchOp {
  Add(String, JsonValue)
  Remove(String)
  Replace(String, JsonValue)
  Move(String, String)
  Copy(String, String)
  Test(String, JsonValue)
}

///| RFC 6902 JSON Patch document.
pub struct JsonPatch {
  pub ops : Array[PatchOp]
}
