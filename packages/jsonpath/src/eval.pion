///| Fast, iterative RFC 9535 JSONPath evaluator with:
///| - Zero-path-allocation hot path for `query()`
///| - Exact RFC 9535 §2.7 Normalized Path formatting for `query_with_paths()`
///| - Iterative pre-order descendant (`..`) traversal
///| - Strict `JsonPathLimits` (`max_depth`, `max_nodes_visited`, `max_results`)
///| - All 5 RFC 9535 built-in functions (`length`, `count`, `value`, `match`, `search`)

enum EvalVal {
  Nothing
  Value(JsonValue)
}

///| Format an object member key as an RFC 9535 §2.7 normalized bracket selector `['...']`.
pub fn format_norm_name(parent : String, key : String) -> String {
  let sb = StringBuilder::new()
  sb.write_string(parent)
  sb.write_string("['")
  let n = key.length()
  let mut i = 0
  while i < n {
    let b = key.code_unit_at(i)
    if b == 8 {
      sb.write_string("\\b")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 39 {
      sb.write_string("\\'")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      sb.write_byte(lower_hex_byte(b >> 4))
      sb.write_byte(lower_hex_byte(b & 0xF))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_string("']")
  sb.to_string()
}

///| Format an array index as an RFC 9535 §2.7 normalized bracket selector `[i]`.
pub fn format_norm_index(parent : String, idx : Int) -> String {
  parent + "[" + idx.to_string() + "]"
}

struct EvalState {
  root : JsonValue
  limits : JsonPathLimits
  mut visited : Int
}

fn EvalState::new(root : JsonValue, limits : JsonPathLimits) -> EvalState {
  EvalState::{ root: root, limits: limits, visited: 0 }
}

fn EvalState::visit(self : EvalState) -> Result[Unit, JsonPathError] {
  self.visited = self.visited + 1
  if self.visited > self.limits.max_nodes_visited {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "query exceeded max_nodes_visited",
      ),
    )
  }
  Ok(())
}

///| Evaluate a compiled `JsonPath` returning only matched `JsonValue`s (fast path: no path string allocations).
pub fn eval_query_values(
  path : JsonPath,
  root : JsonValue,
  limits : JsonPathLimits,
) -> Result[Array[JsonValue], JsonPathError] {
  let st = EvalState::new(root, limits)
  st.eval_segments_values([root], path.segments)
}

///| Shared parent-pointer Normalized Path chain (O(depth) memory during traversal).
enum PathChain {
  Root
  Key(PathChain, String, Int)
  Idx(PathChain, Int, Int)
}

///| Exact escaped byte length of a single key byte in an RFC 9535 §2.7 normalized name segment.
#verify
pub fn norm_name_byte_len(b : Int) -> Int {
  if b == 8 || b == 9 || b == 10 || b == 12 || b == 13 || b == 39 || b == 92 {
    2
  } else if b < 0x20 {
    6
  } else {
    1
  }
}

///| Exact byte length of an RFC 9535 §2.7 escaped single-quoted key segment `['...']`.
fn norm_name_seg_len(key : String) -> Int {
  let n = key.length()
  let mut len = 4 // "['" + "']"
  let mut i = 0
  while i < n {
    let b = key.code_unit_at(i)
    len = len + norm_name_byte_len(b)
    i = i + 1
  }
  len
}

///| Exact byte length of an array index segment `[i]`.
fn norm_index_seg_len(idx : Int) -> Int {
  let mut v = idx
  let mut digits = 1
  while v >= 10 {
    v = v / 10
    digits = digits + 1
  }
  digits + 2 // "[" + digits + "]"
}

fn path_chain_len(p : PathChain) -> Int {
  match p {
    PathChain::Root => 1
    PathChain::Key(_, _, l) => l
    PathChain::Idx(_, _, l) => l
  }
}

fn path_chain_push_key(parent : PathChain, key : String) -> PathChain {
  PathChain::Key(parent, key, path_chain_len(parent) + norm_name_seg_len(key))
}

fn path_chain_push_idx(parent : PathChain, idx : Int) -> PathChain {
  PathChain::Idx(parent, idx, path_chain_len(parent) + norm_index_seg_len(idx))
}

enum PathPart {
  PKey(String)
  PIdx(Int)
}

fn write_norm_name_seg(sb : StringBuilder, key : String) -> Unit {
  sb.write_string("['")
  let n = key.length()
  let mut i = 0
  while i < n {
    let b = key.code_unit_at(i)
    if b == 8 {
      sb.write_string("\\b")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 39 {
      sb.write_string("\\'")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      sb.write_byte(lower_hex_byte(b >> 4))
      sb.write_byte(lower_hex_byte(b & 0xF))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_string("']")
}

///| Materialize a `PathChain` to its RFC 9535 §2.7 Normalized Path string (100% iterative).
fn materialize_path(chain : PathChain) -> String {
  let parts : Array[PathPart] = []
  let mut cur = chain
  while true {
    match cur {
      PathChain::Root => break
      PathChain::Key(p, k, _) => {
        parts.push(PathPart::PKey(k))
        cur = p
      }
      PathChain::Idx(p, idx, _) => {
        parts.push(PathPart::PIdx(idx))
        cur = p
      }
    }
  }
  let sb = StringBuilder::new()
  sb.write_byte((36).to_byte())
  let mut i = parts.length() - 1
  while i >= 0 {
    match parts[i] {
      PathPart::PKey(k) => write_norm_name_seg(sb, k)
      PathPart::PIdx(idx) => {
        sb.write_byte((91).to_byte())
        sb.write_string(idx.to_string())
        sb.write_byte((93).to_byte())
      }
    }
    i = i - 1
  }
  sb.to_string()
}

struct ChainMatch {
  chain : PathChain
  value : JsonValue
}

///| Evaluate a compiled `JsonPath` returning `NodeMatch` with RFC 9535 §2.7 Normalized Paths.
pub fn eval_query_with_paths(
  path : JsonPath,
  root : JsonValue,
  limits : JsonPathLimits,
) -> Result[Array[NodeMatch], JsonPathError] {
  let st = EvalState::new(root, limits)
  let matches = match st.eval_segments_chains([ChainMatch::{ chain: PathChain::Root, value: root }], path.segments) {
    Ok(ms) => ms
    Err(e) => return Err(e)
  }
  // Enforce a 64 MiB materialized path byte budget before allocating output strings
  let max_path_bytes = 64L * 1024L * 1024L
  let mut total_bytes = 0L
  let mut i = 0
  while i < matches.length() {
    total_bytes = total_bytes + path_chain_len(matches[i].chain).to_int64()
    if total_bytes > max_path_bytes {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::LimitExceeded,
          0,
          "query_with_paths exceeded materialized path byte budget",
        ),
      )
    }
    i = i + 1
  }
  let out : Array[NodeMatch] = []
  i = 0
  while i < matches.length() {
    out.push(NodeMatch::{ path: materialize_path(matches[i].chain), value: matches[i].value })
    i = i + 1
  }
  Ok(out)
}

///| RFC 9535 §2.3.4.2.2 Normalize(i, len): negative indices count from the end.
#verify
pub fn rfc9535_normalize_index(idx : Int64, len : Int64) -> Int64 {
  if idx >= 0L {
    idx
  } else {
    len + idx
  }
}

///| RFC 9535 §2.3.4.2.2 default slice start given `len` and `step`.
#verify
pub fn rfc9535_default_slice_start(len : Int64, step : Int64) -> Int64 {
  if step >= 0L {
    0L
  } else {
    len - 1L
  }
}

///| RFC 9535 §2.3.4.2.2 default slice end given `len` and `step`.
#verify
pub fn rfc9535_default_slice_end(len : Int64, step : Int64) -> Int64 {
  if step >= 0L {
    len
  } else {
    -len - 1L
  }
}

///| RFC 9535 §2.3.4.2.2 forward (`step > 0`) slice bound clamping into `[0, len]`.
#verify
pub fn rfc9535_clamp_pos_slice(n : Int64, len : Int64) -> Int64 {
  if n < 0L {
    0L
  } else if n > len {
    len
  } else {
    n
  }
}

///| RFC 9535 §2.3.4.2.2 reverse (`step < 0`) slice bound clamping into `[-1, len - 1]`.
#verify
pub fn rfc9535_clamp_neg_slice(n : Int64, len : Int64) -> Int64 {
  if n < -1L {
    -1L
  } else if n > len - 1L {
    len - 1L
  } else {
    n
  }
}

fn slice_bounds(
  len : Int,
  start_opt : Option[Int64],
  end_opt : Option[Int64],
  step_opt : Option[Int64],
) -> (Int64, Int64, Int64) {
  let step = match step_opt {
    Some(s) => s
    None => 1L
  }
  if step == 0L {
    return (0L, 0L, 0L)
  }
  let len64 = len.to_int64()
  let start = match start_opt {
    Some(s) => s
    None => rfc9535_default_slice_start(len64, step)
  }
  let end = match end_opt {
    Some(e) => e
    None => rfc9535_default_slice_end(len64, step)
  }
  let n_start = rfc9535_normalize_index(start, len64)
  let n_end = rfc9535_normalize_index(end, len64)
  if step > 0L {
    let lower = rfc9535_clamp_pos_slice(n_start, len64)
    let upper = rfc9535_clamp_pos_slice(n_end, len64)
    (lower, upper, step)
  } else {
    let upper = rfc9535_clamp_neg_slice(n_start, len64)
    let lower = rfc9535_clamp_neg_slice(n_end, len64)
    (lower, upper, step)
  }
}

fn EvalState::apply_selector_values(
  self : EvalState,
  node : JsonValue,
  sel : Selector,
  out : Array[JsonValue],
) -> Result[Unit, JsonPathError] {
  match sel {
    Selector::Name(key) => {
      match node {
        JsonValue::Object(entries) => {
          match json_object_get(entries, key) {
            Some(v) => {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(v)
            }
            None => ()
          }
        }
        _ => ()
      }
    }
    Selector::Wildcard => {
      match node {
        JsonValue::Array(items) => {
          let mut i = 0
          let n = items.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            out.push(items[i])
            i = i + 1
          }
        }
        JsonValue::Object(entries) => {
          let mut i = 0
          let n = entries.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            let (_, v) = entries[i]
            out.push(v)
            i = i + 1
          }
        }
        _ => ()
      }
    }
    Selector::Index(idx) => {
      match node {
        JsonValue::Array(items) => {
          let len64 = items.length().to_int64()
          let norm = if idx >= 0L { idx } else { len64 + idx }
          if norm >= 0L && norm < len64 {
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            out.push(items[norm.to_int()])
          }
        }
        _ => ()
      }
    }
    Selector::Slice(s_opt, e_opt, step_opt) => {
      match node {
        JsonValue::Array(items) => {
          let (lower, upper, step) = slice_bounds(items.length(), s_opt, e_opt, step_opt)
          if step > 0L {
            let mut i = lower
            while i < upper {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(items[i.to_int()])
              i = i + step
            }
          } else if step < 0L {
            let mut i = upper
            while i > lower {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(items[i.to_int()])
              i = i + step
            }
          }
        }
        _ => ()
      }
    }
    Selector::Filter(expr) => {
      match node {
        JsonValue::Array(items) => {
          let mut i = 0
          let n = items.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let ok = match self.eval_filter(expr, items[i]) {
              Ok(b) => b
              Err(e) => return Err(e)
            }
            if ok {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(items[i])
            }
            i = i + 1
          }
        }
        JsonValue::Object(entries) => {
          let mut i = 0
          let n = entries.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let (_, v) = entries[i]
            let ok = match self.eval_filter(expr, v) {
              Ok(b) => b
              Err(e) => return Err(e)
            }
            if ok {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(v)
            }
            i = i + 1
          }
        }
        _ => ()
      }
    }
  }
  Ok(())
}

fn EvalState::eval_segments_values(
  self : EvalState,
  initial : Array[JsonValue],
  segments : Array[Segment],
) -> Result[Array[JsonValue], JsonPathError] {
  let mut current = initial
  let mut s_idx = 0
  let n_segs = segments.length()
  while s_idx < n_segs {
    // Zero-allocation fast path for single-node Child([Name]) / Child([Index])
    if current.length() == 1 {
      match segments[s_idx] {
        Segment::Child(sels) => {
          if sels.length() == 1 {
            match sels[0] {
              Selector::Name(key) => {
                match current[0] {
                  JsonValue::Object(entries) => {
                    match json_object_get(entries, key) {
                      Some(v) => {
                        if self.limits.max_results <= 0 {
                          return Err(
                            JsonPathError::new(
                              JsonPathErrorKind::LimitExceeded,
                              0,
                              "query exceeded max_results",
                            ),
                          )
                        }
                        current[0] = v
                        s_idx = s_idx + 1
                        continue
                      }
                      None => return Ok([])
                    }
                  }
                  _ => return Ok([])
                }
              }
              Selector::Index(idx) => {
                match current[0] {
                  JsonValue::Array(items) => {
                    let len64 = items.length().to_int64()
                    let norm = if idx >= 0L { idx } else { len64 + idx }
                    if norm >= 0L && norm < len64 {
                      if self.limits.max_results <= 0 {
                        return Err(
                          JsonPathError::new(
                            JsonPathErrorKind::LimitExceeded,
                            0,
                            "query exceeded max_results",
                          ),
                        )
                      }
                      current[0] = items[norm.to_int()]
                      s_idx = s_idx + 1
                      continue
                    }
                    return Ok([])
                  }
                  _ => return Ok([])
                }
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
    }
    let next : Array[JsonValue] = []
    match segments[s_idx] {
      Segment::Child(sels) => {
        let mut n_idx = 0
        while n_idx < current.length() {
          let node = current[n_idx]
          let mut k = 0
          while k < sels.length() {
            match self.apply_selector_values(node, sels[k], next) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            k = k + 1
          }
          n_idx = n_idx + 1
        }
      }
      Segment::Descendant(sels) => {
        // Iterative pre-order descendant traversal (stack-safe on deep trees!)
        let mut n_idx = 0
        while n_idx < current.length() {
          let stack : Array[(JsonValue, Int)] = [(current[n_idx], 0)]
          while stack.length() > 0 {
            let (cur, depth) = match stack.pop() {
              Some(p) => p
              None => break
            }
            if depth > self.limits.max_depth {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "descendant traversal exceeded max_depth",
                ),
              )
            }
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let mut k = 0
            while k < sels.length() {
              match self.apply_selector_values(cur, sels[k], next) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              k = k + 1
            }
            // Push children in reverse order so pop() visits them left-to-right
            match cur {
              JsonValue::Array(items) => {
                let mut ci = items.length() - 1
                while ci >= 0 {
                  stack.push((items[ci], depth + 1))
                  ci = ci - 1
                }
              }
              JsonValue::Object(entries) => {
                let mut ci = entries.length() - 1
                while ci >= 0 {
                  let (_, ev) = entries[ci]
                  stack.push((ev, depth + 1))
                  ci = ci - 1
                }
              }
              _ => ()
            }
          }
          n_idx = n_idx + 1
        }
      }
    }
    current = next
    if current.length() == 0 {
      break
    }
    s_idx = s_idx + 1
  }
  Ok(current)
}

fn EvalState::apply_selector_chains(
  self : EvalState,
  cm : ChainMatch,
  sel : Selector,
  out : Array[ChainMatch],
) -> Result[Unit, JsonPathError] {
  match sel {
    Selector::Name(key) => {
      match cm.value {
        JsonValue::Object(entries) => {
          match json_object_get(entries, key) {
            Some(v) => {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(ChainMatch::{ chain: path_chain_push_key(cm.chain, key), value: v })
            }
            None => ()
          }
        }
        _ => ()
      }
    }
    Selector::Wildcard => {
      match cm.value {
        JsonValue::Array(items) => {
          let mut i = 0
          let n = items.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            out.push(ChainMatch::{ chain: path_chain_push_idx(cm.chain, i), value: items[i] })
            i = i + 1
          }
        }
        JsonValue::Object(entries) => {
          let mut i = 0
          let n = entries.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            let (k, v) = entries[i]
            out.push(ChainMatch::{ chain: path_chain_push_key(cm.chain, k), value: v })
            i = i + 1
          }
        }
        _ => ()
      }
    }
    Selector::Index(idx) => {
      match cm.value {
        JsonValue::Array(items) => {
          let len64 = items.length().to_int64()
          let norm = if idx >= 0L { idx } else { len64 + idx }
          if norm >= 0L && norm < len64 {
            let ii = norm.to_int()
            if out.length() >= self.limits.max_results {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "query exceeded max_results",
                ),
              )
            }
            out.push(ChainMatch::{ chain: path_chain_push_idx(cm.chain, ii), value: items[ii] })
          }
        }
        _ => ()
      }
    }
    Selector::Slice(s_opt, e_opt, step_opt) => {
      match cm.value {
        JsonValue::Array(items) => {
          let (lower, upper, step) = slice_bounds(items.length(), s_opt, e_opt, step_opt)
          if step > 0L {
            let mut i = lower
            while i < upper {
              let ii = i.to_int()
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(ChainMatch::{ chain: path_chain_push_idx(cm.chain, ii), value: items[ii] })
              i = i + step
            }
          } else if step < 0L {
            let mut i = upper
            while i > lower {
              let ii = i.to_int()
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(ChainMatch::{ chain: path_chain_push_idx(cm.chain, ii), value: items[ii] })
              i = i + step
            }
          }
        }
        _ => ()
      }
    }
    Selector::Filter(expr) => {
      match cm.value {
        JsonValue::Array(items) => {
          let mut i = 0
          let n = items.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let ok = match self.eval_filter(expr, items[i]) {
              Ok(b) => b
              Err(e) => return Err(e)
            }
            if ok {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(ChainMatch::{ chain: path_chain_push_idx(cm.chain, i), value: items[i] })
            }
            i = i + 1
          }
        }
        JsonValue::Object(entries) => {
          let mut i = 0
          let n = entries.length()
          while i < n {
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let (k, v) = entries[i]
            let ok = match self.eval_filter(expr, v) {
              Ok(b) => b
              Err(e) => return Err(e)
            }
            if ok {
              if out.length() >= self.limits.max_results {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "query exceeded max_results",
                  ),
                )
              }
              out.push(ChainMatch::{ chain: path_chain_push_key(cm.chain, k), value: v })
            }
            i = i + 1
          }
        }
        _ => ()
      }
    }
  }
  Ok(())
}

fn EvalState::eval_segments_chains(
  self : EvalState,
  initial : Array[ChainMatch],
  segments : Array[Segment],
) -> Result[Array[ChainMatch], JsonPathError] {
  let mut current = initial
  let mut s_idx = 0
  while s_idx < segments.length() {
    let next : Array[ChainMatch] = []
    match segments[s_idx] {
      Segment::Child(sels) => {
        let mut n_idx = 0
        while n_idx < current.length() {
          let cm = current[n_idx]
          let mut k = 0
          while k < sels.length() {
            match self.apply_selector_chains(cm, sels[k], next) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            k = k + 1
          }
          n_idx = n_idx + 1
        }
      }
      Segment::Descendant(sels) => {
        let mut n_idx = 0
        while n_idx < current.length() {
          let stack : Array[(ChainMatch, Int)] = [(current[n_idx], 0)]
          while stack.length() > 0 {
            let (cur, depth) = match stack.pop() {
              Some(p) => p
              None => break
            }
            if depth > self.limits.max_depth {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::LimitExceeded,
                  0,
                  "descendant traversal exceeded max_depth",
                ),
              )
            }
            match self.visit() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let mut k = 0
            while k < sels.length() {
              match self.apply_selector_chains(cur, sels[k], next) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              k = k + 1
            }
            match cur.value {
              JsonValue::Array(items) => {
                let mut ci = items.length() - 1
                while ci >= 0 {
                  stack.push(
                    (
                      ChainMatch::{ chain: path_chain_push_idx(cur.chain, ci), value: items[ci] },
                      depth + 1,
                    ),
                  )
                  ci = ci - 1
                }
              }
              JsonValue::Object(entries) => {
                let mut ci = entries.length() - 1
                while ci >= 0 {
                  let (ek, ev) = entries[ci]
                  stack.push(
                    (
                      ChainMatch::{ chain: path_chain_push_key(cur.chain, ek), value: ev },
                      depth + 1,
                    ),
                  )
                  ci = ci - 1
                }
              }
              _ => ()
            }
          }
          n_idx = n_idx + 1
        }
      }
    }
    current = next
    if current.length() == 0 {
      break
    }
    s_idx = s_idx + 1
  }
  Ok(current)
}

// ============================================================================
// Filter Expression & Function Evaluation
// ============================================================================

fn eval_singular(
  base : JsonValue,
  segs : Array[SingularSeg],
) -> EvalVal {
  let mut cur = base
  let mut i = 0
  while i < segs.length() {
    match segs[i] {
      SingularSeg::Name(k) => {
        match cur {
          JsonValue::Object(entries) => {
            match json_object_get(entries, k) {
              Some(v) => cur = v
              None => return EvalVal::Nothing
            }
          }
          _ => return EvalVal::Nothing
        }
      }
      SingularSeg::Index(idx) => {
        match cur {
          JsonValue::Array(items) => {
            let len64 = items.length().to_int64()
            let norm = if idx >= 0L { idx } else { len64 + idx }
            if norm >= 0L && norm < len64 {
              cur = items[norm.to_int()]
            } else {
              return EvalVal::Nothing
            }
          }
          _ => return EvalVal::Nothing
        }
      }
    }
    i = i + 1
  }
  EvalVal::Value(cur)
}

fn eval_val_eq(a : EvalVal, b : EvalVal) -> Bool {
  match (a, b) {
    (EvalVal::Nothing, EvalVal::Nothing) => true
    (EvalVal::Value(va), EvalVal::Value(vb)) => json_value_eq_impl(va, vb)
    _ => false
  }
}

fn eval_val_lt(a : EvalVal, b : EvalVal) -> Bool {
  match (a, b) {
    (EvalVal::Value(va), EvalVal::Value(vb)) => json_value_lt(va, vb)
    _ => false
  }
}

fn EvalState::eval_comparable(
  self : EvalState,
  comp : Comparable,
  current : JsonValue,
) -> Result[EvalVal, JsonPathError] {
  match comp {
    Comparable::Literal(v) => Ok(EvalVal::Value(v))
    Comparable::SingularQuery(is_rel, segs) => {
      let base = if is_rel { current } else { self.root }
      Ok(eval_singular(base, segs))
    }
    Comparable::FuncCall(f) => self.eval_func_value(f, current)
  }
}

fn EvalState::eval_arg_as_value(
  self : EvalState,
  arg : FuncArg,
  current : JsonValue,
) -> Result[EvalVal, JsonPathError] {
  match arg {
    FuncArg::Literal(v) => Ok(EvalVal::Value(v))
    FuncArg::FilterQuery(is_rel, segs) => {
      let base = if is_rel { current } else { self.root }
      let nodes = match self.eval_segments_values([base], segs) {
        Ok(ns) => ns
        Err(e) => return Err(e)
      }
      if nodes.length() == 1 {
        Ok(EvalVal::Value(nodes[0]))
      } else {
        Ok(EvalVal::Nothing)
      }
    }
    FuncArg::FuncCall(sub) => self.eval_func_value(sub, current)
    FuncArg::LogicalExpr(_) => Ok(EvalVal::Nothing)
  }
}

fn EvalState::eval_arg_as_nodes(
  self : EvalState,
  arg : FuncArg,
  current : JsonValue,
) -> Result[Array[JsonValue], JsonPathError] {
  match arg {
    FuncArg::FilterQuery(is_rel, segs) => {
      let base = if is_rel { current } else { self.root }
      self.eval_segments_values([base], segs)
    }
    _ => Ok([])
  }
}

fn EvalState::eval_func_value(
  self : EvalState,
  f : FuncExpr,
  current : JsonValue,
) -> Result[EvalVal, JsonPathError] {
  if f.name == "length" {
    let v = match self.eval_arg_as_value(f.args[0], current) {
      Ok(ev) => ev
      Err(e) => return Err(e)
    }
    match v {
      EvalVal::Value(JsonValue::Str(s)) =>
      Ok(EvalVal::Value(JsonValue::Int(utf8_codepoint_count(s).to_int64())))
      EvalVal::Value(JsonValue::Array(items)) =>
      Ok(EvalVal::Value(JsonValue::Int(items.length().to_int64())))
      EvalVal::Value(JsonValue::Object(entries)) =>
      Ok(EvalVal::Value(JsonValue::Int(entries.length().to_int64())))
      _ => Ok(EvalVal::Nothing)
    }
  } else if f.name == "count" {
    let nodes = match self.eval_arg_as_nodes(f.args[0], current) {
      Ok(ns) => ns
      Err(e) => return Err(e)
    }
    Ok(EvalVal::Value(JsonValue::Int(nodes.length().to_int64())))
  } else if f.name == "value" {
    let nodes = match self.eval_arg_as_nodes(f.args[0], current) {
      Ok(ns) => ns
      Err(e) => return Err(e)
    }
    if nodes.length() == 1 {
      Ok(EvalVal::Value(nodes[0]))
    } else {
      Ok(EvalVal::Nothing)
    }
  } else {
    Ok(EvalVal::Nothing)
  }
}

fn EvalState::eval_func_logical(
  self : EvalState,
  f : FuncExpr,
  current : JsonValue,
) -> Result[Bool, JsonPathError] {
  if f.name == "match" || f.name == "search" {
    let v0 = match self.eval_arg_as_value(f.args[0], current) {
      Ok(ev) => ev
      Err(e) => return Err(e)
    }
    let text = match v0 {
      EvalVal::Value(JsonValue::Str(s)) => s
      _ => return Ok(false)
    }
    if f.has_const_regex {
      return match f.compiled_regex {
        Some(re) => Ok(re.is_match(text))
        None => Ok(false)
      }
    }
    let v1 = match self.eval_arg_as_value(f.args[1], current) {
      Ok(ev) => ev
      Err(e) => return Err(e)
    }
    let pat = match v1 {
      EvalVal::Value(JsonValue::Str(s)) => s
      _ => return Ok(false)
    }
    if f.name == "match" {
      Ok(iregexp_match(text, pat))
    } else {
      Ok(iregexp_search(text, pat))
    }
  } else {
    Ok(false)
  }
}

fn EvalState::eval_filter(
  self : EvalState,
  expr : FilterExpr,
  current : JsonValue,
) -> Result[Bool, JsonPathError] {
  match expr {
    FilterExpr::Or(items) => {
      let mut i = 0
      while i < items.length() {
        let b = match self.eval_filter(items[i], current) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if b {
          return Ok(true)
        }
        i = i + 1
      }
      Ok(false)
    }
    FilterExpr::And(items) => {
      let mut i = 0
      while i < items.length() {
        let b = match self.eval_filter(items[i], current) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if !b {
          return Ok(false)
        }
        i = i + 1
      }
      Ok(true)
    }
    FilterExpr::Not(inner) => {
      match self.eval_filter(inner, current) {
        Ok(v) => Ok(!v)
        Err(e) => Err(e)
      }
    }
    FilterExpr::Comparison(lhs_c, op, rhs_c) => {
      let lhs = match self.eval_comparable(lhs_c, current) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rhs = match self.eval_comparable(rhs_c, current) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let res = match op {
        CompOp::Eq => eval_val_eq(lhs, rhs)
        CompOp::Ne => !eval_val_eq(lhs, rhs)
        CompOp::Lt => eval_val_lt(lhs, rhs)
        CompOp::Le => eval_val_lt(lhs, rhs) || eval_val_eq(lhs, rhs)
        CompOp::Gt => eval_val_lt(rhs, lhs)
        CompOp::Ge => eval_val_lt(rhs, lhs) || eval_val_eq(lhs, rhs)
      }
      Ok(res)
    }
    FilterExpr::TestQuery(is_rel, segs) => {
      let base = if is_rel { current } else { self.root }
      let nodes = match self.eval_segments_values([base], segs) {
        Ok(ns) => ns
        Err(e) => return Err(e)
      }
      Ok(nodes.length() > 0)
    }
    FilterExpr::TestFunc(f) => self.eval_func_logical(f, current)
  }
}
