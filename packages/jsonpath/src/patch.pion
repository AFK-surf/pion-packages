                }
              }
              None => ()
            }
            if !found_dirty {
              let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
              match unfrozen {
                WorkVal::Frozen(_) => cur = unfrozen
                _ => {
                  data.dirty = dirty_set(data.dirty, idx, unfrozen)
                  cur = unfrozen
                }
              }
            }
          }
          _ => return 1
        }
        seg_start = i + 1
      } else {
        match cur {
          WorkVal::MutObj(data) => {
            match data.idx_map {
              None => {
                let idx = mut_obj_find_slice(data, path, seg_start, i)
                if idx < 0 {
                  return 1
                }
                let _ = dirty_remove_and_shift(data.dirty, idx)
                let mut j = idx
                let last = data.entries.length() - 1
                while j < last {
                  data.entries[j] = data.entries[j + 1]
                  j = j + 1
                }
                let _ = data.entries.pop()
                let mut k = idx - 1
                while k >= 0 {
                  let (ek, _) = data.entries[k]
                  if str_eq_slice(ek, path, seg_start, i) {
                    let _ = dirty_remove_and_shift(data.dirty, k)
                    let mut m = k
                    let last2 = data.entries.length() - 1
                    while m < last2 {
                      data.entries[m] = data.entries[m + 1]
                      m = m + 1
                    }
                    let _ = data.entries.pop()
                  }
                  k = k - 1
                }
                return 0
              }
              Some(_) => {
                match mut_obj_remove(data, path.slice(seg_start, i)) {
                  Some(_) => return 0
                  None => return 1
                }
              }
            }
          }
          WorkVal::MutArr(data) => {
            let items = data.items
            let idx = parse_pointer_array_index_slice(path, seg_start, i)
            if idx < 0 || idx >= items.length() {
              return 1
            }
            let _ = dirty_remove_and_shift(data.dirty, idx)
            let mut j = idx
            let last = items.length() - 1
            while j < last {
              items[j] = items[j + 1]
              j = j + 1
            }
            let _ = items.pop()
            return 0
          }
          _ => return 1
        }
      }
    }
    i = i + 1
  }
  1
}

///| Apply an RFC 6902 `JsonPatch` atomically with explicit resource limits.
pub fn apply_patch_impl(
  doc : JsonValue,
  patch : JsonPatch,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  let n_ops = patch.ops.length()
  if n_ops > limits.max_patch_ops {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "patch exceeds max_patch_ops",
      ),
    )
  }
  if n_ops == 0 {
    return Ok(doc)
  }
  let mut cur = work_unfreeze_container(WorkVal::Frozen(doc))
  let mut total_nodes = -1
  let tok_buf : Array[String] = []
  let from_buf : Array[String] = []
  let mut i = 0
  while i < n_ops {
    match patch.ops[i] {
      PatchOp::Add(path, v) => {
        if work_add_fast_ptr(cur, path, v, limits.max_depth) != 0 {
          match pointer_parse_into(path, tok_buf, limits.max_depth) {
            Some(e) => return Err(e)
            None => ()
          }
          cur = match work_add(cur, tok_buf, WorkVal::Frozen(v)) {
            Ok(next) => next
            Err(e) => return Err(e)
          }
        }
        total_nodes = -1
      }
      PatchOp::Remove(path) => {
        if work_remove_fast_ptr(cur, path, limits.max_depth) != 0 {
          match pointer_parse_into(path, tok_buf, limits.max_depth) {
            Some(e) => return Err(e)
            None => ()
          }
          let (next, _) = match work_remove(cur, tok_buf) {
            Ok(p) => p
            Err(e) => return Err(e)
          }
          cur = next
        }
        total_nodes = -1
      }
      PatchOp::Replace(path, v) => {
        if work_replace_fast_ptr(cur, path, v, limits.max_depth) != 0 {
          match pointer_parse_into(path, tok_buf, limits.max_depth) {
            Some(e) => return Err(e)
            None => ()
          }
          cur = match work_replace(cur, tok_buf, WorkVal::Frozen(v)) {
            Ok(next) => next
            Err(e) => return Err(e)
          }
        }
        total_nodes = -1
      }
      PatchOp::Move(from, path) => {
        match pointer_parse_into(from, from_buf, limits.max_depth) {
          Some(e) => return Err(e)
          None => ()
        }
        match pointer_parse_into(path, tok_buf, limits.max_depth) {
          Some(e) => return Err(e)
          None => ()
        }
        if is_proper_prefix(from_buf, tok_buf) {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'move' from location cannot be a proper prefix of path",
            ),
          )
        }
        let (after_rm, moved_val) = match work_remove(cur, from_buf) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        cur = match work_add(after_rm, tok_buf, moved_val) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
        total_nodes = -1
      }
      PatchOp::Copy(from, path) => {
        let from_ptr = match pointer_parse_impl(from) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        match check_ptr_depth(from_ptr, limits) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match check_ptr_depth(path_ptr, limits) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        // Freeze working tree before copy so the copied subtree is immutable & isolated
        let snap = work_freeze(cur)
        let copied_val = match pointer_resolve_impl(from_ptr, snap) {
          Some(v) => v
          None =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'copy' from location does not exist: " + from,
            ),
          )
        }
        let budget = limits.max_nodes_visited
        if total_nodes < 0 {
          total_nodes = count_nodes_bounded(snap, budget)
          if total_nodes > budget {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::LimitExceeded,
                0,
                "patch document exceeds max_nodes_visited",
              ),
            )
          }
        }
        let added = if from_ptr.tokens.length() == 0 {
          total_nodes
        } else {
          count_nodes_bounded(copied_val, budget)
        }
        if added > budget {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::LimitExceeded,
              0,
              "copy amplification exceeds max_nodes_visited",
            ),
          )
        }
        let replaced = match resolve_overwritten_object_val(path_ptr, snap) {
          Some(old_v) => count_nodes_bounded(old_v, total_nodes)
          None => 0
        }
        let next_total = total_nodes - replaced + added
        if next_total > budget {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::LimitExceeded,
              0,
              "copy amplification exceeds max_nodes_visited",
            ),
          )
        }
        cur = match work_add(WorkVal::Frozen(snap), path_ptr.tokens, WorkVal::Frozen(copied_val)) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
        total_nodes = next_total
      }
      PatchOp::Test(path, expected) => {
        match pointer_parse_into(path, tok_buf, limits.max_depth) {
          Some(e) => return Err(e)
          None => ()
        }
        let actual_w = match work_resolve(cur, tok_buf) {
          Some(v) => v
          None =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'test' target does not exist: " + path,
            ),
          )
        }
        let actual = work_freeze(actual_w)
        if !json_value_eq_impl(actual, expected) {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'test' operation failed at " + path,
            ),
          )
        }
      }
    }
    i = i + 1
  }
  Ok(work_freeze(cur))
}

// ============================================================================
// RFC 6902 Diff Generator (`diff_patch`)
// ============================================================================

fn small_idx_str(idx : Int) -> String {
  if idx == 0 {
    "0"
  } else if idx == 1 {
    "1"
  } else if idx == 2 {
    "2"
  } else if idx == 3 {
    "3"
  } else if idx == 4 {
    "4"
  } else if idx == 5 {
    "5"
  } else if idx == 6 {
    "6"
  } else if idx == 7 {
    "7"
  } else if idx == 8 {
    "8"
  } else if idx == 9 {
    "9"
  } else {
    idx.to_string()
  }
}

fn diff_join_key(prefix : String, key : String) -> String {
  let esc = escape_token_impl(key)
  if prefix.length() == 0 {
    "/" + esc
  } else {
    prefix + "/" + esc
  }
}

fn diff_join_idx(prefix : String, idx : Int) -> String {
  let s = small_idx_str(idx)
  if prefix.length() == 0 {
    "/" + s
  } else {
    prefix + "/" + s
  }
}

fn diff_recurse(
  prefix : String,
  before : JsonValue,
  after : JsonValue,
  ops : Array[PatchOp],
  depth : Int,
) -> Unit {
  let r0 = json_value_eq_leaf(before, after)
  if r0 == 1 {
    return
  }
  if r0 == 0 {
    ops.push(PatchOp::Replace(prefix, after))
    return
  }
  if depth > 256 {
    if !json_value_eq_impl(before, after) {
      ops.push(PatchOp::Replace(prefix, after))
    }
    return
  }
  match (before, after) {
    (JsonValue::Object(ea), JsonValue::Object(eb)) => {
      let na = ea.length()
      let nb = eb.length()
      if na <= 12 && nb <= 12 {
        // Small object fast path (zero Map, bitmask skips Pass 2 lookups for matched keys!)
        let prefix_slash = if prefix.length() == 0 { "/" } else { prefix + "/" }
        let mut seen_b = 0
        let mut i = 0
        while i < na {
          let (k, va) = ea[i]
          let k_len = k.length()
          let mut found_b = -1
          let mut j = nb - 1
          while j >= 0 {
            let (kb, _) = eb[j]
            if kb.length() == k_len && kb == k {
              found_b = j
              break
            }
            j = j - 1
          }
          if found_b >= 0 {
            seen_b = seen_b | (1 << found_b)
            let (_, vb) = eb[found_b]
            let rl = json_value_eq_leaf(va, vb)
            if rl == 0 {
              ops.push(PatchOp::Replace(prefix_slash + escape_token_impl(k), vb))
            } else if rl == 2 {
              diff_recurse(prefix_slash + escape_token_impl(k), va, vb, ops, depth + 1)
            }
          } else {
            ops.push(PatchOp::Remove(prefix_slash + escape_token_impl(k)))
          }
          i = i + 1
        }
        let mut j = 0
        while j < nb {
          if (seen_b & (1 << j)) == 0 {
            let (k, vb) = eb[j]
            let k_len = k.length()
            let mut found_a = false
            let mut ii = na - 1
            while ii >= 0 {
              let (ka, _) = ea[ii]
              if ka.length() == k_len && ka == k {
                found_a = true
                break
              }
              ii = ii - 1
            }
            if !found_a {
              ops.push(PatchOp::Add(prefix_slash + escape_token_impl(k), vb))
            }
          }
          j = j + 1
        }
      } else {
        // O(na + nb) Map-indexed object diff with LastWins duplicate handling
        let map_a : Map[String, Int] = Map::new()
        let mut i = 0
        while i < na {
          let (k, _) = ea[i]
          map_a.set(k, i)
          i = i + 1
        }
        let map_b : Map[String, Int] = Map::new()
        let mut j = 0
        while j < nb {
          let (k, _) = eb[j]
          map_b.set(k, j)
          j = j + 1
        }
        i = 0
        while i < na {
          let (k, va) = ea[i]
          let is_last = match map_a.get(k) {
            Some(idx) => idx == i
            None => false
          }
          if is_last {
            match map_b.get(k) {
              Some(jb) => {
                let (_, vb) = eb[jb]
                let rl = json_value_eq_leaf(va, vb)
                if rl == 0 {
                  ops.push(PatchOp::Replace(diff_join_key(prefix, k), vb))
                } else if rl == 2 {
                  diff_recurse(diff_join_key(prefix, k), va, vb, ops, depth + 1)
                }
              }
              None => ops.push(PatchOp::Remove(diff_join_key(prefix, k)))
            }
          }
          i = i + 1
        }
        j = 0
        while j < nb {
          let (k, vb) = eb[j]
          let is_last = match map_b.get(k) {
            Some(idx) => idx == j
            None => false
          }
          if is_last {
            match map_a.get(k) {
              Some(_) => ()
              None => ops.push(PatchOp::Add(diff_join_key(prefix, k), vb))
            }
          }
          j = j + 1
        }
      }
    }
    (JsonValue::Array(xa), JsonValue::Array(xb)) => {
      let na = xa.length()
      let nb = xb.length()
      // Trim common prefix
      let mut common_pre = 0
      while common_pre < na &&
      common_pre < nb &&
      json_value_eq_impl(xa[common_pre], xb[common_pre]) {
        common_pre = common_pre + 1
      }
      // Trim common suffix
      let mut common_suf = 0
      while common_suf < na - common_pre &&
      common_suf < nb - common_pre &&
      json_value_eq_impl(xa[na - 1 - common_suf], xb[nb - 1 - common_suf]) {
        common_suf = common_suf + 1
      }
      let mid_a = na - common_pre - common_suf
      let mid_b = nb - common_pre - common_suf
      let overlap = if mid_a < mid_b { mid_a } else { mid_b }
      // Diff overlapping middle elements in-place
      let mut k = 0
      while k < overlap {
        let idx = common_pre + k
        let rl = json_value_eq_leaf(xa[idx], xb[idx])
        if rl == 0 {
          ops.push(PatchOp::Replace(diff_join_idx(prefix, idx), xb[idx]))
        } else if rl == 2 {
          diff_recurse(
            diff_join_idx(prefix, idx),
            xa[idx],
            xb[idx],
            ops,
            depth + 1,
          )
        }
        k = k + 1
      }
      if mid_a > mid_b {
        // Remove extra elements (from highest index down so earlier indices stay valid)
        let mut r = mid_a - 1
        while r >= overlap {
          let idx = common_pre + r
          ops.push(PatchOp::Remove(diff_join_idx(prefix, idx)))
          r = r - 1
        }
      } else if mid_b > mid_a {
        // Insert extra elements
        let mut ins = overlap
        while ins < mid_b {
          let idx = common_pre + ins
          if common_suf == 0 && idx == na + (ins - overlap) {
            ops.push(PatchOp::Add(prefix + "/-", xb[idx]))
          } else {
            ops.push(PatchOp::Add(diff_join_idx(prefix, idx), xb[idx]))
          }
          ins = ins + 1
        }
      }
    }
    _ => ops.push(PatchOp::Replace(prefix, after))
  }
}

///| Compute an RFC 6902 `JsonPatch` transforming `before` into `after`.
pub fn diff_patch_impl(before : JsonValue, after : JsonValue) -> JsonPatch {
  let ops : Array[PatchOp] = Array::with_capacity(8)
  diff_recurse("", before, after, ops, 0)
  JsonPatch::{ ops: ops }
}

// ============================================================================
// Iterative RFC 7396 JSON Merge Patch
// ============================================================================

struct MergeFrame {
  out : Array[(String, Option[JsonValue])]
  mut idx_map : Option[Map[String, Int]]
  p_entries : Array[(String, JsonValue)]
  mut p_idx : Int
  mut pending_key : String
  mut pending_slot : Int
}

fn merge_frame_find(f : MergeFrame, key : String) -> Int {
  match f.idx_map {
    Some(m) => {
      match m.get(key) {
        Some(idx) => idx
        None => -1
      }
    }
    None => {
      let mut i = f.out.length() - 1
      while i >= 0 {
        let (k, v_opt) = f.out[i]
        if k == key {
          match v_opt {
            Some(_) => return i
            None => return -1
          }
        }
        i = i - 1
      }
      -1
    }
  }
}

fn merge_frame_set(f : MergeFrame, key : String, v : JsonValue) -> Unit {
  let idx = merge_frame_find(f, key)
  if idx >= 0 {
    f.out[idx] = (key, Some(v))
    return
  }
  let pos = f.out.length()
  f.out.push((key, Some(v)))
  match f.idx_map {
    Some(m) => m.set(key, pos)
    None => {
      if f.out.length() >= 16 {
        let m : Map[String, Int] = Map::new()
        let mut i = 0
        while i < f.out.length() {
          let (k, v_opt) = f.out[i]
          match v_opt {
            Some(_) => m.set(k, i)
            None => ()
          }
          i = i + 1
        }
        f.idx_map = Some(m)
      }
    }
  }
}

fn merge_frame_delete(f : MergeFrame, key : String) -> Unit {
  let idx = merge_frame_find(f, key)
  if idx >= 0 {
    f.out[idx] = (key, Option::None)
    match f.idx_map {
      Some(m) => m.set(key, -1)
      None => ()
    }
  }
}

fn make_merge_frame(
  target : JsonValue,
  p_entries : Array[(String, JsonValue)],
) -> MergeFrame {
  let f = MergeFrame::{
    out: [],
    idx_map: Option::None,
    p_entries: p_entries,
    p_idx: 0,
    pending_key: "",
    pending_slot: -1,
  }
  match target {
    JsonValue::Object(t_entries) => {
      let mut i = 0
      while i < t_entries.length() {
        let (k, v) = t_entries[i]
        merge_frame_set(f, k, v)
        i = i + 1
      }
    }
    _ => ()
  }
  f
}

fn finish_merge_frame(f : MergeFrame) -> JsonValue {
  let res : Array[(String, JsonValue)] = []
  let mut i = 0
  while i < f.out.length() {
    let (k, v_opt) = f.out[i]
    match v_opt {
      Some(v) => res.push((k, v))
      None => ()
    }
    i = i + 1
  }
  JsonValue::Object(res)
}

///| 100% iterative RFC 7396 JSON Merge Patch.
///| `max_depth < 0` means unlimited depth (stack-safe on arbitrarily deep documents).
fn merge_patch_iter(
  target : JsonValue,
  patch : JsonValue,
  max_depth : Int,
) -> Result[JsonValue, JsonPathError] {
  let root_entries = match patch {
    JsonValue::Object(es) => es
    _ => return Ok(patch)
  }
  let frames : Array[MergeFrame] = [make_merge_frame(target, root_entries)]
  while frames.length() > 0 {
    let top_idx = frames.length() - 1
    let f = frames[top_idx]
    let mut descended = false
    while f.p_idx < f.p_entries.length() {
      let (pk, pv) = f.p_entries[f.p_idx]
      f.p_idx = f.p_idx + 1
      match pv {
        JsonValue::Null => merge_frame_delete(f, pk)
        JsonValue::Object(child_p_entries) => {
          if max_depth >= 0 && frames.length() > max_depth {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::LimitExceeded,
                0,
                "merge_patch exceeded max_depth",
              ),
            )
          }
          let slot = merge_frame_find(f, pk)
          let existing = if slot >= 0 {
            let (_, ev_opt) = f.out[slot]
            match ev_opt {
              Some(ev) => ev
              None => JsonValue::Object([])
            }
          } else {
            JsonValue::Object([])
          }
          f.pending_key = pk
          f.pending_slot = slot
          frames.push(make_merge_frame(existing, child_p_entries))
          descended = true
          break
        }
        _ => merge_frame_set(f, pk, pv)
      }
    }
    if !descended {
      let done_frame = match frames.pop() {
        Some(df) => df
        None => break
      }
      let merged = finish_merge_frame(done_frame)
      if frames.length() == 0 {
        return Ok(merged)
      }
      let parent = frames[frames.length() - 1]
      if parent.pending_slot >= 0 {
        parent.out[parent.pending_slot] = (parent.pending_key, Some(merged))
      } else {
        merge_frame_set(parent, parent.pending_key, merged)
      }
    }
  }
  Ok(patch)
}

///| Direct recursive RFC 7396 fast path for shallow small objects (depth < 64),
///| falling back to `merge_patch_iter` for deep or wide objects.
fn merge_patch_fast(
  target : JsonValue,
  patch : JsonValue,
  depth : Int,
  max_depth : Int,
) -> Result[JsonValue, JsonPathError] {
  let p_entries = match patch {
    JsonValue::Object(es) => es
    _ => return Ok(patch)
  }
  if depth >= 64 || p_entries.length() > 12 {
    return merge_patch_iter(target, patch, if max_depth >= 0 { max_depth - depth + 1 } else { -1 })
  }
  let t_entries : Array[(String, JsonValue)] = match target {
    JsonValue::Object(es) => es
    _ => []
  }
  if t_entries.length() > 12 {
    return merge_patch_iter(target, patch, if max_depth >= 0 { max_depth - depth + 1 } else { -1 })
  }
  let nt = t_entries.length()
  let np = p_entries.length()
  let res : Array[(String, JsonValue)] = Array::with_capacity(nt + np)
  // Pass 1: emit non-shadowed target keys, applying patch overrides/deletions inline
  let mut i = 0
  while i < nt {
    let (tk, tv) = t_entries[i]
    let mut shadowed = false
    let mut s = i + 1
    while s < nt {
      let (tk2, _) = t_entries[s]
      if tk2 == tk {
        shadowed = true
        break
      }
      s = s + 1
    }
    if !shadowed {
      match json_object_get(p_entries, tk) {
        None => res.push((tk, tv))
        Some(JsonValue::Null) => ()
        Some(JsonValue::Object(cp)) => {
          if max_depth >= 0 && depth > max_depth {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::LimitExceeded,
                0,
                "merge_patch exceeded max_depth",
              ),
            )
          }
          let merged = match merge_patch_fast(tv, JsonValue::Object(cp), depth + 1, max_depth) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          res.push((tk, merged))
        }
        Some(pv) => res.push((tk, pv))
      }
    }
    i = i + 1
  }
  // Pass 2: append non-shadowed patch keys absent from target
  let mut j = 0
  while j < np {
    let (pk, pv) = p_entries[j]
    let mut shadowed = false
    let mut s = j + 1
    while s < np {
      let (pk2, _) = p_entries[s]
      if pk2 == pk {
        shadowed = true
        break
      }
      s = s + 1
    }
    if !shadowed {
      match json_object_get(t_entries, pk) {
        Some(_) => ()
        None => {
          match pv {
            JsonValue::Null => ()
            JsonValue::Object(cp) => {
              if max_depth >= 0 && depth > max_depth {
                return Err(
                  JsonPathError::new(
                    JsonPathErrorKind::LimitExceeded,
                    0,
                    "merge_patch exceeded max_depth",
                  ),
                )
              }
              let merged = match merge_patch_fast(JsonValue::Object([]), JsonValue::Object(cp), depth + 1, max_depth) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              res.push((pk, merged))
            }
            _ => res.push((pk, pv))
          }
        }
      }
    }
    j = j + 1
  }
  Ok(JsonValue::Object(res))
}

///| Unbounded fast path for RFC 7396 `merge_patch` (depth < 64, small objects):
///| Zero `Result` boxing, zero `Option` boxing, bitmask skips redundant Pass 2 scans.
fn merge_patch_fast_unbounded(
  target : JsonValue,
  patch : JsonValue,
  depth : Int,
) -> JsonValue {
  let p_entries = match patch {
    JsonValue::Object(es) => es
    _ => return patch
  }
  let np = p_entries.length()
  if depth >= 64 || np > 12 {
    return match merge_patch_iter(target, patch, -1) {
      Ok(v) => v
      Err(_) => patch
    }
  }
  let t_entries : Array[(String, JsonValue)] = match target {
    JsonValue::Object(es) => es
    _ => []
  }
  let nt = t_entries.length()
  if nt > 12 {
    return match merge_patch_iter(target, patch, -1) {
      Ok(v) => v
      Err(_) => patch
    }
  }
  let res : Array[(String, JsonValue)] = Array::with_capacity(nt + np)
  let mut seen_p = 0
  let mut i = 0
  while i < nt {
    let (tk, tv) = t_entries[i]
    let tk_len = tk.length()
    let mut shadowed = false
    let mut s = i + 1
    while s < nt {
      let (tk2, _) = t_entries[s]
      if tk2.length() == tk_len && tk2 == tk {
        shadowed = true
        break
      }
      s = s + 1
    }
    if !shadowed {
      let mut found_p = -1
      let mut j = np - 1
      while j >= 0 {
        let (pk, _) = p_entries[j]
        if pk.length() == tk_len && pk == tk {
          found_p = j
          break
        }
        j = j - 1
      }
      if found_p < 0 {
        res.push((tk, tv))
      } else {
        seen_p = seen_p | (1 << found_p)
        let (_, pv) = p_entries[found_p]
        match pv {
          JsonValue::Null => ()
          JsonValue::Object(_) =>
          res.push((tk, merge_patch_fast_unbounded(tv, pv, depth + 1)))
          _ => res.push((tk, pv))
        }
      }
    }
    i = i + 1
  }
  let mut j = 0
  while j < np {
    if (seen_p & (1 << j)) == 0 {
      let (pk, pv) = p_entries[j]
      let pk_len = pk.length()
      let mut shadowed = false
      let mut s = j + 1
      while s < np {
        let (pk2, _) = p_entries[s]
        if pk2.length() == pk_len && pk2 == pk {
          shadowed = true
          break
        }
        s = s + 1
      }
      if !shadowed {
        let mut found_t = false
        let mut ii = nt - 1
        while ii >= 0 {
          let (tk, _) = t_entries[ii]
          if tk.length() == pk_len && tk == pk {
            found_t = true
            break
          }
          ii = ii - 1
        }
        if !found_t {
          match pv {
            JsonValue::Null => ()
            JsonValue::Object(_) =>
            res.push((pk, merge_patch_fast_unbounded(JsonValue::Object([]), pv, depth + 1)))
            _ => res.push((pk, pv))
          }
        }
      }
    }
    j = j + 1
  }
  JsonValue::Object(res)
}

///| Apply an RFC 7396 JSON Merge Patch (100% iterative fallback, no artificial depth truncation).
pub fn merge_patch_impl(target : JsonValue, patch : JsonValue) -> JsonValue {
  merge_patch_fast_unbounded(target, patch, 1)
}

///| Apply an RFC 7396 JSON Merge Patch with explicit limits.
pub fn merge_patch_with_limits_impl(
  target : JsonValue,
  patch : JsonValue,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  merge_patch_fast(target, patch, 1, limits.max_depth)
}
