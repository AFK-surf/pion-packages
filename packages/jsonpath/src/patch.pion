///| RFC 6902 JSON Patch (atomic apply, decode/encode, minimal `diff_patch`)
///| and RFC 7396 JSON Merge Patch.

///| Parse an RFC 6902 JSON Patch document from JSON text.
pub fn parse_patch_impl(src : String) -> Result[JsonPatch, JsonPathError] {
  match parse_json_impl(src, JsonPathLimits::default()) {
    Ok(v) => patch_from_value_impl(v)
    Err(e) => Err(e)
  }
}

///| Decode an RFC 6902 `JsonPatch` from a `JsonValue::Array`.
pub fn patch_from_value_impl(value : JsonValue) -> Result[JsonPatch, JsonPathError] {
  let items = match value {
    JsonValue::Array(arr) => arr
    _ =>
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "JSON Patch must be a JSON array",
      ),
    )
  }
  let ops : Array[PatchOp] = []
  let mut i = 0
  while i < items.length() {
    let entries = match items[i] {
      JsonValue::Object(es) => es
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation must be an object",
        ),
      )
    }
    let op_name = match json_object_get(entries, "op") {
      Some(JsonValue::Str(s)) => s
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation missing string 'op'",
        ),
      )
    }
    let path = match json_object_get(entries, "path") {
      Some(JsonValue::Str(s)) => s
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation missing string 'path'",
        ),
      )
    }
    if op_name == "add" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'add' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Add(path, v))
    } else if op_name == "remove" {
      ops.push(PatchOp::Remove(path))
    } else if op_name == "replace" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'replace' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Replace(path, v))
    } else if op_name == "move" {
      let from = match json_object_get(entries, "from") {
        Some(JsonValue::Str(s)) => s
        _ =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'move' operation missing string 'from'",
          ),
        )
      }
      ops.push(PatchOp::Move(from, path))
    } else if op_name == "copy" {
      let from = match json_object_get(entries, "from") {
        Some(JsonValue::Str(s)) => s
        _ =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'copy' operation missing string 'from'",
          ),
        )
      }
      ops.push(PatchOp::Copy(from, path))
    } else if op_name == "test" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'test' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Test(path, v))
    } else {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "unknown patch op: " + op_name,
        ),
      )
    }
    i = i + 1
  }
  Ok(JsonPatch::{ ops: ops })
}

///| Encode a `JsonPatch` as a `JsonValue::Array`.
pub fn patch_to_value_impl(patch : JsonPatch) -> JsonValue {
  let out : Array[JsonValue] = []
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("add")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
      PatchOp::Remove(path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("remove")), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Replace(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("replace")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
      PatchOp::Move(from, path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("move")), ("from", JsonValue::Str(from)), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Copy(from, path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("copy")), ("from", JsonValue::Str(from)), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Test(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("test")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
    }
    i = i + 1
  }
  JsonValue::Array(out)
}

fn is_proper_prefix(from : Array[String], path : Array[String]) -> Bool {
  if from.length() >= path.length() {
    return false
  }
  let mut i = 0
  while i < from.length() {
    if from[i] != path[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn check_ptr_depth(
  ptr : JsonPointer,
  limits : JsonPathLimits,
) -> Result[Unit, JsonPathError] {
  if ptr.tokens.length() > limits.max_depth {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "pointer depth exceeds max_depth",
      ),
    )
  }
  Ok(())
}

///| Count logical JSON nodes iteratively, stopping early once count > `limit`.
///| Uses a zero-allocation tail-loop for single-child chains.
fn count_nodes_bounded(root : JsonValue, limit : Int) -> Int {
  let stack : Array[JsonValue] = []
  let mut cur = root
  let mut count = 0
  while true {
    count = count + 1
    if count > limit {
      return count
    }
    match cur {
      JsonValue::Array(items) => {
        let n = items.length()
        if n == 1 {
          cur = items[0]
          continue
        }
        if n > 1 {
          let mut i = n - 1
          while i >= 1 {
            stack.push(items[i])
            i = i - 1
          }
          cur = items[0]
          continue
        }
      }
      JsonValue::Object(entries) => {
        let n = entries.length()
        if n == 1 {
          let (_, v) = entries[0]
          cur = v
          continue
        }
        if n > 1 {
          let mut i = n - 1
          while i >= 1 {
            let (_, v) = entries[i]
            stack.push(v)
            i = i - 1
          }
          let (_, v0) = entries[0]
          cur = v0
          continue
        }
      }
      _ => ()
    }
    match stack.pop() {
      Some(next) => cur = next
      None => break
    }
  }
  count
}

///| Resolve the existing value that an RFC 6902 `add` at `ptr` would overwrite (only for existing Object keys).
fn resolve_overwritten_object_val(
  ptr : JsonPointer,
  doc : JsonValue,
) -> Option[JsonValue] {
  let total = ptr.tokens.length()
  if total == 0 {
    return Some(doc)
  }
  let mut cur = doc
  let mut i = 0
  while i + 1 < total {
    let tok = ptr.tokens[i]
    match cur {
      JsonValue::Object(entries) => {
        match json_object_get(entries, tok) {
          Some(v) => cur = v
          None => return Option::None
        }
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Option::None
        }
        cur = items[idx]
      }
      _ => return Option::None
    }
    i = i + 1
  }
  match cur {
    JsonValue::Object(entries) => json_object_get(entries, ptr.tokens[total - 1])
    _ => Option::None
  }
}

// ============================================================================
// Zero-Copy-Freeze Clone-on-Touch Working Tree for O(N) Atomic `apply_patch`
// ============================================================================

struct MutObjData {
  entries : Array[(String, JsonValue)]
  mut idx_map : Option[Map[String, Int]]
  mut tombstones : Option[Array[Bool]]
  mut dirty : Option[Array[(Int, WorkVal)]]
}

struct MutArrData {
  items : Array[JsonValue]
  mut dirty : Option[Array[(Int, WorkVal)]]
}

enum WorkVal {
  Frozen(JsonValue)
  MutArr(MutArrData)
  MutObj(MutObjData)
}

fn dirty_get(dirty : Option[Array[(Int, WorkVal)]], slot : Int) -> Option[WorkVal] {
  match dirty {
    None => Option::None
    Some(ds) => {
      let mut i = 0
      let n = ds.length()
      while i < n {
        let (idx, wv) = ds[i]
        if idx == slot {
          return Some(wv)
        }
        i = i + 1
      }
      Option::None
    }
  }
}

fn dirty_set(dirty : Option[Array[(Int, WorkVal)]], slot : Int, wv : WorkVal) -> Option[Array[(Int, WorkVal)]] {
  match dirty {
    None => Some([(slot, wv)])
    Some(ds) => {
      let mut i = 0
      let n = ds.length()
      while i < n {
        let (idx, _) = ds[i]
        if idx == slot {
          ds[i] = (slot, wv)
          return Some(ds)
        }
        i = i + 1
      }
      ds.push((slot, wv))
      Some(ds)
    }
  }
}

fn dirty_remove_slot(dirty : Option[Array[(Int, WorkVal)]], slot : Int) -> Option[WorkVal] {
  match dirty {
    None => Option::None
    Some(ds) => {
      let mut i = 0
      let n = ds.length()
      while i < n {
        let (idx, wv) = ds[i]
        if idx == slot {
          let last = n - 1
          if i != last {
            ds[i] = ds[last]
          }
          let _ = ds.pop()
          return Some(wv)
        }
        i = i + 1
      }
      Option::None
    }
  }
}

fn dirty_shift_after_insert(dirty : Option[Array[(Int, WorkVal)]], insert_idx : Int) -> Unit {
  match dirty {
    None => ()
    Some(ds) => {
      let mut i = 0
      let n = ds.length()
      while i < n {
        let (idx, wv) = ds[i]
        if idx >= insert_idx {
          ds[i] = (idx + 1, wv)
        }
        i = i + 1
      }
    }
  }
}

fn dirty_remove_and_shift(dirty : Option[Array[(Int, WorkVal)]], rm_idx : Int) -> Option[WorkVal] {
  match dirty {
    None => Option::None
    Some(ds) => {
      let mut removed : Option[WorkVal] = Option::None
      let mut i = 0
      while i < ds.length() {
        let (idx, wv) = ds[i]
        if idx == rm_idx {
          removed = Some(wv)
          let last = ds.length() - 1
          if i != last {
            ds[i] = ds[last]
          }
          let _ = ds.pop()
        } else {
          if idx > rm_idx {
            ds[i] = (idx - 1, wv)
          }
          i = i + 1
        }
      }
      removed
    }
  }
}

fn mut_obj_is_deleted(data : MutObjData, idx : Int) -> Bool {
  match data.tombstones {
    None => false
    Some(ts) => idx < ts.length() && ts[idx]
  }
}

fn str_eq_slice(s : String, src : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if s.length() != len {
    return false
  }
  let mut i = 0
  while i < len {
    if s.code_unit_at(i) != src.code_unit_at(start + i) {
      return false
    }
    i = i + 1
  }
  true
}

fn parse_pointer_array_index_slice(src : String, start : Int, end : Int) -> Int {
  let n = end - start
  if n == 0 {
    return -1
  }
  let b0 = src.code_unit_at(start)
  if b0 == 48 {
    return if n == 1 { 0 } else { -1 }
  }
  if b0 < 49 || b0 > 57 {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let b = src.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    if acc > 214748364 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn mut_obj_find_slice(data : MutObjData, src : String, start : Int, end : Int) -> Int {
  match data.idx_map {
    Some(m) => {
      match m.get(src.slice(start, end)) {
        Some(idx) => idx
        None => -1
      }
    }
    None => {
      let mut i = data.entries.length() - 1
      while i >= 0 {
        let (k, _) = data.entries[i]
        if str_eq_slice(k, src, start, end) {
          if mut_obj_is_deleted(data, i) {
            return -1
          }
          return i
        }
        i = i - 1
      }
      -1
    }
  }
}

fn mut_obj_find(data : MutObjData, key : String) -> Int {
  match data.idx_map {
    Some(m) => {
      match m.get(key) {
        Some(idx) => idx
        None => -1
      }
    }
    None => {
      let key_len = key.length()
      let mut i = data.entries.length() - 1
      while i >= 0 {
        let (k, _) = data.entries[i]
        if k.length() == key_len && k == key {
          if mut_obj_is_deleted(data, i) {
            return -1
          }
          return i
        }
        i = i - 1
      }
      -1
    }
  }
}

fn mut_obj_ensure_map(data : MutObjData) -> Map[String, Int] {
  match data.idx_map {
    Some(m) => m
    None => {
      let m : Map[String, Int] = Map::new()
      let mut i = 0
      let n = data.entries.length()
      while i < n {
        if !mut_obj_is_deleted(data, i) {
          let (k, _) = data.entries[i]
          m.set(k, i)
        }
        i = i + 1
      }
      data.idx_map = Some(m)
      m
    }
  }
}

fn mut_obj_set(data : MutObjData, key : String, v : WorkVal) -> Unit {
  let idx = mut_obj_find(data, key)
  if idx >= 0 {
    match v {
      WorkVal::Frozen(jv) => {
        data.entries[idx] = (key, jv)
        let _ = dirty_remove_slot(data.dirty, idx)
      }
      _ => {
        data.entries[idx] = (key, JsonValue::Null)
        data.dirty = dirty_set(data.dirty, idx, v)
      }
    }
    return
  }
  let pos = data.entries.length()
  match v {
    WorkVal::Frozen(jv) => data.entries.push((key, jv))
    _ => {
      data.entries.push((key, JsonValue::Null))
      data.dirty = dirty_set(data.dirty, pos, v)
    }
  }
  match data.tombstones {
    Some(ts) => ts.push(false)
    None => ()
  }
  match data.idx_map {
    Some(m) => m.set(key, pos)
    None => {
      if data.entries.length() >= 16 {
        let _ = mut_obj_ensure_map(data)
      }
    }
  }
}

fn mut_obj_remove(data : MutObjData, key : String) -> Option[WorkVal] {
  let idx = mut_obj_find(data, key)
  if idx < 0 {
    return Option::None
  }
  match data.idx_map {
    None => {
      // Small object fast path: shift-left in `entries` so freeze needs zero compaction!
      let removed = match dirty_remove_and_shift(data.dirty, idx) {
        Some(wv) => wv
        None => {
          let (_, jv) = data.entries[idx]
          WorkVal::Frozen(jv)
        }
      }
      let mut j = idx
      let last = data.entries.length() - 1
      while j < last {
        data.entries[j] = data.entries[j + 1]
        j = j + 1
      }
      let _ = data.entries.pop()
      // Also remove any earlier shadowed duplicate occurrences of `key`
      let mut k = idx - 1
      while k >= 0 {
        let (ek, _) = data.entries[k]
        if ek == key {
          let _ = dirty_remove_and_shift(data.dirty, k)
          let mut m = k
          let last2 = data.entries.length() - 1
          while m < last2 {
            data.entries[m] = data.entries[m + 1]
            m = m + 1
          }
          let _ = data.entries.pop()
        }
        k = k - 1
      }
      Some(removed)
    }
    Some(m) => {
      // Wide object O(1) tombstone removal
      let removed = match dirty_remove_slot(data.dirty, idx) {
        Some(wv) => wv
        None => {
          let (_, jv) = data.entries[idx]
          WorkVal::Frozen(jv)
        }
      }
      let ts = match data.tombstones {
        Some(t) => t
        None => {
          let n = data.entries.length()
          let t : Array[Bool] = Array::with_capacity(n)
          let mut i = 0
          while i < n {
            t.push(false)
            i = i + 1
          }
          data.tombstones = Some(t)
          t
        }
      }
      ts[idx] = true
      m.set(key, -1)
      Some(removed)
    }
  }
}

fn work_unfreeze_container(wv : WorkVal) -> WorkVal {
  match wv {
    WorkVal::Frozen(JsonValue::Array(items)) => {
      let n = items.length()
      let arr : Array[JsonValue] = Array::with_capacity(n)
      let mut i = 0
      while i < n {
        arr.push(items[i])
        i = i + 1
      }
      WorkVal::MutArr(MutArrData::{ items: arr, dirty: Option::None })
    }
    WorkVal::Frozen(JsonValue::Object(entries)) => {
      let n = entries.length()
      if n < 16 {
        let out : Array[(String, JsonValue)] = Array::with_capacity(n)
        let mut i = 0
        while i < n {
          out.push(entries[i])
          i = i + 1
        }
        WorkVal::MutObj(MutObjData::{
          entries: out,
          idx_map: Option::None,
          tombstones: Option::None,
          dirty: Option::None,
        })
      } else {
        let out : Array[(String, JsonValue)] = Array::with_capacity(n)
        let m : Map[String, Int] = Map::new()
        let mut i = 0
        while i < n {
          let (k, v) = entries[i]
          match m.get(k) {
            Some(pos) => out[pos] = (k, v)
            None => {
              m.set(k, out.length())
              out.push((k, v))
            }
          }
          i = i + 1
        }
        WorkVal::MutObj(MutObjData::{
          entries: out,
          idx_map: Some(m),
          tombstones: Option::None,
          dirty: Option::None,
        })
      }
    }
    _ => wv
  }
}

enum FreezeTask {
  ArrDone(MutArrData)
  ObjDone(MutObjData)
  ObjChild(MutObjData, Int, WorkVal)
  ArrChild(MutArrData, Int, WorkVal)
}

fn work_freeze_iter(root : WorkVal) -> JsonValue {
  // Iterative post-order freeze for arbitrary depth (> 64)
  let stack : Array[FreezeTask] = []
  let res_stack : Array[JsonValue] = []
  match root {
    WorkVal::Frozen(v) => return v
    WorkVal::MutArr(data) => {
      stack.push(FreezeTask::ArrDone(data))
      match data.dirty {
        Some(ds) => {
          let mut i = 0
          while i < ds.length() {
            let (idx, child) = ds[i]
            stack.push(FreezeTask::ArrChild(data, idx, child))
            i = i + 1
          }
        }
        None => ()
      }
    }
    WorkVal::MutObj(data) => {
      stack.push(FreezeTask::ObjDone(data))
      match data.dirty {
        Some(ds) => {
          let mut i = 0
          while i < ds.length() {
            let (idx, child) = ds[i]
            stack.push(FreezeTask::ObjChild(data, idx, child))
            i = i + 1
          }
        }
        None => ()
      }
    }
  }
  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      FreezeTask::ArrDone(data) => {
        res_stack.push(JsonValue::Array(data.items))
      }
      FreezeTask::ObjDone(data) => {
        match data.tombstones {
          None => res_stack.push(JsonValue::Object(data.entries))
          Some(ts) => {
            let n = data.entries.length()
            let compacted : Array[(String, JsonValue)] = Array::with_capacity(n)
            let mut i = 0
            while i < n {
              if i >= ts.length() || !ts[i] {
                compacted.push(data.entries[i])
              }
              i = i + 1
            }
            res_stack.push(JsonValue::Object(compacted))
          }
        }
      }
      FreezeTask::ArrChild(parent, slot, child) => {
        match child {
          WorkVal::Frozen(v) => parent.items[slot] = v
          WorkVal::MutArr(cd) => {
            match cd.dirty {
              None => parent.items[slot] = JsonValue::Array(cd.items)
              Some(ds) => {
                parent.items[slot] = JsonValue::Array(cd.items)
                let mut i = 0
                while i < ds.length() {
                  let (cidx, cchild) = ds[i]
                  stack.push(FreezeTask::ArrChild(cd, cidx, cchild))
                  i = i + 1
                }
              }
            }
          }
          WorkVal::MutObj(cd) => {
            match cd.tombstones {
              None => {
                parent.items[slot] = JsonValue::Object(cd.entries)
                match cd.dirty {
                  Some(ds) => {
                    let mut i = 0
                    while i < ds.length() {
                      let (cidx, cchild) = ds[i]
                      stack.push(FreezeTask::ObjChild(cd, cidx, cchild))
                      i = i + 1
                    }
                  }
                  None => ()
                }
              }
              Some(_) => {
                // Rare: wide object with tombstones inside deep tree
                parent.items[slot] = work_freeze_iter(child)
              }
            }
          }
        }
      }
      FreezeTask::ObjChild(parent, slot, child) => {
        let (pk, _) = parent.entries[slot]
        match child {
          WorkVal::Frozen(v) => parent.entries[slot] = (pk, v)
          WorkVal::MutArr(cd) => {
            parent.entries[slot] = (pk, JsonValue::Array(cd.items))
            match cd.dirty {
              Some(ds) => {
                let mut i = 0
                while i < ds.length() {
                  let (cidx, cchild) = ds[i]
                  stack.push(FreezeTask::ArrChild(cd, cidx, cchild))
                  i = i + 1
                }
              }
              None => ()
            }
          }
          WorkVal::MutObj(cd) => {
            match cd.tombstones {
              None => {
                parent.entries[slot] = (pk, JsonValue::Object(cd.entries))
                match cd.dirty {
                  Some(ds) => {
                    let mut i = 0
                    while i < ds.length() {
                      let (cidx, cchild) = ds[i]
                      stack.push(FreezeTask::ObjChild(cd, cidx, cchild))
                      i = i + 1
                    }
                  }
                  None => ()
                }
              }
              Some(_) => {
                parent.entries[slot] = (pk, work_freeze_iter(child))
              }
            }
          }
        }
      }
    }
  }
  match res_stack.pop() {
    Some(v) => v
    None => JsonValue::Null
  }
}

fn work_freeze_depth(root : WorkVal, depth : Int) -> JsonValue {
  if depth >= 64 {
    return work_freeze_iter(root)
  }
  match root {
    WorkVal::Frozen(v) => v
    WorkVal::MutArr(data) => {
      match data.dirty {
        Some(ds) => {
          let mut i = 0
          let n = ds.length()
          while i < n {
            let (idx, child) = ds[i]
            data.items[idx] = work_freeze_depth(child, depth + 1)
            i = i + 1
          }
        }
        None => ()
      }
      JsonValue::Array(data.items)
    }
    WorkVal::MutObj(data) => {
      match data.dirty {
        Some(ds) => {
          let mut i = 0
          let n = ds.length()
          while i < n {
            let (idx, child) = ds[i]
            let (k, _) = data.entries[idx]
            data.entries[idx] = (k, work_freeze_depth(child, depth + 1))
            i = i + 1
          }
        }
        None => ()
      }
      match data.tombstones {
        None => JsonValue::Object(data.entries)
        Some(ts) => {
          let n = data.entries.length()
          let compacted : Array[(String, JsonValue)] = Array::with_capacity(n)
          let mut i = 0
          while i < n {
            if i >= ts.length() || !ts[i] {
              compacted.push(data.entries[i])
            }
            i = i + 1
          }
          JsonValue::Object(compacted)
        }
      }
    }
  }
}

fn work_freeze(root : WorkVal) -> JsonValue {
  work_freeze_depth(root, 0)
}

fn work_resolve(root : WorkVal, tokens : Array[String]) -> Option[WorkVal] {
  let mut cur = root
  let mut i = 0
  let total = tokens.length()
  while i < total {
    let tok = tokens[i]
    match cur {
      WorkVal::Frozen(v) => {
        let mut fv = v
        let mut k = i
        while k < total {
          let tk = tokens[k]
          match fv {
            JsonValue::Object(entries) => {
              match json_object_get(entries, tk) {
                Some(nv) => fv = nv
                None => return Option::None
              }
            }
            JsonValue::Array(items) => {
              let idx = parse_pointer_array_index(tk)
              if idx < 0 || idx >= items.length() {
                return Option::None
              }
              fv = items[idx]
            }
            _ => return Option::None
          }
          k = k + 1
        }
        return Some(WorkVal::Frozen(fv))
      }
      WorkVal::MutObj(data) => {
        let idx = mut_obj_find(data, tok)
        if idx < 0 {
          return Option::None
        }
        match dirty_get(data.dirty, idx) {
          Some(wv) => cur = wv
          None => {
            let (_, jv) = data.entries[idx]
            cur = WorkVal::Frozen(jv)
          }
        }
      }
      WorkVal::MutArr(data) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= data.items.length() {
          return Option::None
        }
        match dirty_get(data.dirty, idx) {
          Some(wv) => cur = wv
          None => cur = WorkVal::Frozen(data.items[idx])
        }
      }
    }
    i = i + 1
  }
  Some(cur)
}

fn work_add(
  root_in : WorkVal,
  tokens : Array[String],
  new_v : WorkVal,
) -> Result[WorkVal, JsonPathError] {
  let total = tokens.length()
  if total == 0 {
    return Ok(new_v)
  }
  let root = work_unfreeze_container(root_in)
  let mut cur = root
  let mut depth = 0
  while depth + 1 < total {
    let tok = tokens[depth]
    match cur {
      WorkVal::MutObj(data) => {
        let idx = mut_obj_find(data, tok)
        if idx < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "parent object key not found: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let (_, jv) = data.entries[idx]
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(jv))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      WorkVal::MutArr(data) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= data.items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "invalid parent array index: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "cannot add inside non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  let tok = tokens[total - 1]
  match cur {
    WorkVal::MutObj(data) => {
      mut_obj_set(data, tok, new_v)
      Ok(root)
    }
    WorkVal::MutArr(data) => {
      let items = data.items
      let n = items.length()
      let insert_idx = if tok == "-" {
        n
      } else {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx > n {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "invalid array add index: " + tok,
            ),
          )
        }
        idx
      }
      dirty_shift_after_insert(data.dirty, insert_idx)
      let jv = match new_v {
        WorkVal::Frozen(v) => v
        _ => {
          data.dirty = dirty_set(data.dirty, insert_idx, new_v)
          JsonValue::Null
        }
      }
      items.push(jv)
      let mut j = n
      while j > insert_idx {
        items[j] = items[j - 1]
        j = j - 1
      }
      items[insert_idx] = jv
      Ok(root)
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot add inside non-container at token: " + tok,
      ),
    )
  }
}

fn work_replace(
  root_in : WorkVal,
  tokens : Array[String],
  new_v : WorkVal,
) -> Result[WorkVal, JsonPathError] {
  let total = tokens.length()
  if total == 0 {
    return Ok(new_v)
  }
  let root = work_unfreeze_container(root_in)
  let mut cur = root
  let mut depth = 0
  while depth + 1 < total {
    let tok = tokens[depth]
    match cur {
      WorkVal::MutObj(data) => {
        let idx = mut_obj_find(data, tok)
        if idx < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PointerError,
              0,
              "target key not found: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let (_, jv) = data.entries[idx]
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(jv))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      WorkVal::MutArr(data) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= data.items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PointerError,
              0,
              "invalid or out-of-bounds array index: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PointerError,
          0,
          "cannot traverse non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  let tok = tokens[total - 1]
  match cur {
    WorkVal::MutObj(data) => {
      let idx = mut_obj_find(data, tok)
      if idx < 0 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            0,
            "target key not found: " + tok,
          ),
        )
      }
      match new_v {
        WorkVal::Frozen(jv) => {
          data.entries[idx] = (tok, jv)
          let _ = dirty_remove_slot(data.dirty, idx)
        }
        _ => {
          data.entries[idx] = (tok, JsonValue::Null)
          data.dirty = dirty_set(data.dirty, idx, new_v)
        }
      }
      Ok(root)
    }
    WorkVal::MutArr(data) => {
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= data.items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            0,
            "invalid or out-of-bounds array index: " + tok,
          ),
        )
      }
      match new_v {
        WorkVal::Frozen(jv) => {
          data.items[idx] = jv
          let _ = dirty_remove_slot(data.dirty, idx)
        }
        _ => {
          data.items[idx] = JsonValue::Null
          data.dirty = dirty_set(data.dirty, idx, new_v)
        }
      }
      Ok(root)
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PointerError,
        0,
        "cannot traverse non-container at token: " + tok,
      ),
    )
  }
}

fn work_remove(
  root_in : WorkVal,
  tokens : Array[String],
) -> Result[(WorkVal, WorkVal), JsonPathError] {
  let total = tokens.length()
  if total == 0 {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove root document",
      ),
    )
  }
  let root = work_unfreeze_container(root_in)
  let mut cur = root
  let mut depth = 0
  while depth + 1 < total {
    let tok = tokens[depth]
    match cur {
      WorkVal::MutObj(data) => {
        let idx = mut_obj_find(data, tok)
        if idx < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "remove target key not found: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let (_, jv) = data.entries[idx]
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(jv))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      WorkVal::MutArr(data) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= data.items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "remove target array index out of bounds: " + tok,
            ),
          )
        }
        let child = match dirty_get(data.dirty, idx) {
          Some(wv) => wv
          None => {
            let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
            match unfrozen {
              WorkVal::Frozen(_) => unfrozen
              _ => {
                data.dirty = dirty_set(data.dirty, idx, unfrozen)
                unfrozen
              }
            }
          }
        }
        cur = child
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "cannot remove inside non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  let tok = tokens[total - 1]
  match cur {
    WorkVal::MutObj(data) => {
      match mut_obj_remove(data, tok) {
        Some(removed) => Ok((root, removed))
        None =>
        Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target key not found: " + tok,
          ),
        )
      }
    }
    WorkVal::MutArr(data) => {
      let items = data.items
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target array index out of bounds: " + tok,
          ),
        )
      }
      let removed = match dirty_remove_and_shift(data.dirty, idx) {
        Some(wv) => wv
        None => WorkVal::Frozen(items[idx])
      }
      let mut j = idx
      let last = items.length() - 1
      while j < last {
        items[j] = items[j + 1]
        j = j + 1
      }
      let _ = items.pop()
      Ok((root, removed))
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove inside non-container at token: " + tok,
      ),
    )
  }
}

///| Fast zero-allocation in-place `replace` for a non-empty pointer without `~` escapes.
///| Returns: `0` = applied, `1` = fallback needed (empty pointer or contains `~`), `2` = error (stored in `err_out`).
fn work_replace_fast_ptr(
  root : WorkVal,
  path : String,
  new_val : JsonValue,
  max_depth : Int,
) -> Int {
  let n = path.length()
  if n == 0 || path.code_unit_at(0) != 47 {
    return 1
  }
  // Quick scan for '~' (rare)
  let mut s = 1
  while s < n {
    if path.code_unit_at(s) == 126 {
      return 1
    }
    s = s + 1
  }
  let mut cur = root
  let mut seg_start = 1
  let mut depth = 0
  let mut i = 1
  while i <= n {
    if i == n || path.code_unit_at(i) == 47 {
      depth = depth + 1
      if depth > max_depth {
        return 1
      }
      let is_last = i == n
      if !is_last {
        match cur {
          WorkVal::MutObj(data) => {
            let idx = mut_obj_find_slice(data, path, seg_start, i)
            if idx < 0 {
              return 1
            }
            let mut found_dirty = false
            match data.dirty {
              Some(ds) => {
                let mut di = 0
                let dn = ds.length()
                while di < dn {
                  let (didx, dwv) = ds[di]
                  if didx == idx {
                    cur = dwv
                    found_dirty = true
                    break
                  }
                  di = di + 1
                }
              }
              None => ()
            }
            if !found_dirty {
              let (_, jv) = data.entries[idx]
              let unfrozen = work_unfreeze_container(WorkVal::Frozen(jv))
              match unfrozen {
                WorkVal::Frozen(_) => cur = unfrozen
                _ => {
                  data.dirty = dirty_set(data.dirty, idx, unfrozen)
                  cur = unfrozen
                }
              }
            }
          }
          WorkVal::MutArr(data) => {
            let idx = parse_pointer_array_index_slice(path, seg_start, i)
            if idx < 0 || idx >= data.items.length() {
              return 1
            }
            let mut found_dirty = false
            match data.dirty {
              Some(ds) => {
                let mut di = 0
                let dn = ds.length()
                while di < dn {
                  let (didx, dwv) = ds[di]
                  if didx == idx {
                    cur = dwv
                    found_dirty = true
                    break
                  }
                  di = di + 1
                }
              }
              None => ()
            }
            if !found_dirty {
              let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
              match unfrozen {
                WorkVal::Frozen(_) => cur = unfrozen
                _ => {
                  data.dirty = dirty_set(data.dirty, idx, unfrozen)
                  cur = unfrozen
                }
              }
            }
          }
          _ => return 1
        }
        seg_start = i + 1
      } else {
        match cur {
          WorkVal::MutObj(data) => {
            let idx = mut_obj_find_slice(data, path, seg_start, i)
            if idx < 0 {
              return 1
            }
            let (k, _) = data.entries[idx]
            data.entries[idx] = (k, new_val)
            let _ = dirty_remove_slot(data.dirty, idx)
            return 0
          }
          WorkVal::MutArr(data) => {
            let idx = parse_pointer_array_index_slice(path, seg_start, i)
            if idx < 0 || idx >= data.items.length() {
              return 1
            }
            data.items[idx] = new_val
            let _ = dirty_remove_slot(data.dirty, idx)
            return 0
          }
          _ => return 1
        }
      }
    }
    i = i + 1
  }
  1
}

///| Fast zero-allocation in-place `add` for a non-empty pointer without `~` escapes.
fn work_add_fast_ptr(
  root : WorkVal,
  path : String,
  new_val : JsonValue,
  max_depth : Int,
) -> Int {
  let n = path.length()
  if n == 0 || path.code_unit_at(0) != 47 {
    return 1
  }
  let mut s = 1
  while s < n {
    if path.code_unit_at(s) == 126 {
      return 1
    }
    s = s + 1
  }
  let mut cur = root
  let mut seg_start = 1
  let mut depth = 0
  let mut i = 1
  while i <= n {
    if i == n || path.code_unit_at(i) == 47 {
      depth = depth + 1
      if depth > max_depth {
        return 1
      }
      let is_last = i == n
      if !is_last {
        match cur {
          WorkVal::MutObj(data) => {
            let idx = mut_obj_find_slice(data, path, seg_start, i)
            if idx < 0 {
              return 1
            }
            let mut found_dirty = false
            match data.dirty {
              Some(ds) => {
                let mut di = 0
                let dn = ds.length()
                while di < dn {
                  let (didx, dwv) = ds[di]
                  if didx == idx {
                    cur = dwv
                    found_dirty = true
                    break
                  }
                  di = di + 1
                }
              }
              None => ()
            }
            if !found_dirty {
              let (_, jv) = data.entries[idx]
              let unfrozen = work_unfreeze_container(WorkVal::Frozen(jv))
              match unfrozen {
                WorkVal::Frozen(_) => cur = unfrozen
                _ => {
                  data.dirty = dirty_set(data.dirty, idx, unfrozen)
                  cur = unfrozen
                }
              }
            }
          }
          WorkVal::MutArr(data) => {
            let idx = parse_pointer_array_index_slice(path, seg_start, i)
            if idx < 0 || idx >= data.items.length() {
              return 1
            }
            let mut found_dirty = false
            match data.dirty {
              Some(ds) => {
                let mut di = 0
                let dn = ds.length()
                while di < dn {
                  let (didx, dwv) = ds[di]
                  if didx == idx {
                    cur = dwv
                    found_dirty = true
                    break
                  }
                  di = di + 1
                }
              }
              None => ()
            }
            if !found_dirty {
              let unfrozen = work_unfreeze_container(WorkVal::Frozen(data.items[idx]))
              match unfrozen {
                WorkVal::Frozen(_) => cur = unfrozen
                _ => {
                  data.dirty = dirty_set(data.dirty, idx, unfrozen)
                  cur = unfrozen
                }
              }
            }
          }
          _ => return 1
        }
        seg_start = i + 1
      } else {
        match cur {
          WorkVal::MutObj(data) => {
            let idx = mut_obj_find_slice(data, path, seg_start, i)
            if idx >= 0 {
              let (k, _) = data.entries[idx]
              data.entries[idx] = (k, new_val)
              let _ = dirty_remove_slot(data.dirty, idx)
              return 0
            }
            let key = path.slice(seg_start, i)
            let pos = data.entries.length()
            data.entries.push((key, new_val))
            match data.tombstones {
              Some(ts) => ts.push(false)
              None => ()
            }
            match data.idx_map {
              Some(m) => m.set(key, pos)
              None => {
                if data.entries.length() >= 16 {
                  let _ = mut_obj_ensure_map(data)
                }
              }
            }
            return 0
          }
          WorkVal::MutArr(data) => {
            let items = data.items
            let len = items.length()
            let seg_len = i - seg_start
            let insert_idx = if seg_len == 1 && path.code_unit_at(seg_start) == 45 {
              len
            } else {
              let idx = parse_pointer_array_index_slice(path, seg_start, i)
              if idx < 0 || idx > len {
                return 1
              }
              idx
            }
            dirty_shift_after_insert(data.dirty, insert_idx)
            items.push(new_val)
            let mut j = len
            while j > insert_idx {
              items[j] = items[j - 1]
              j = j - 1
            }
            items[insert_idx] = new_val
            return 0
          }
          _ => return 1
        }
      }
    }
    i = i + 1
  }
  1
}

///| Fast zero-allocation in-place `remove` for a non-empty pointer without `~` escapes.
fn work_remove_fast_ptr(
  root : WorkVal,
  path : String,
  max_depth : Int,
