///| RFC 6902 JSON Patch (atomic apply, decode/encode, minimal `diff_patch`)
///| and RFC 7396 JSON Merge Patch.

///| Parse an RFC 6902 JSON Patch document from JSON text.
pub fn parse_patch_impl(src : String) -> Result[JsonPatch, JsonPathError] {
  match parse_json_impl(src, JsonPathLimits::default()) {
    Ok(v) => patch_from_value_impl(v)
    Err(e) => Err(e)
  }
}

///| Decode an RFC 6902 `JsonPatch` from a `JsonValue::Array`.
pub fn patch_from_value_impl(value : JsonValue) -> Result[JsonPatch, JsonPathError] {
  let items = match value {
    JsonValue::Array(arr) => arr
    _ =>
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "JSON Patch must be a JSON array",
      ),
    )
  }
  let ops : Array[PatchOp] = []
  let mut i = 0
  while i < items.length() {
    let entries = match items[i] {
      JsonValue::Object(es) => es
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation must be an object",
        ),
      )
    }
    let op_name = match json_object_get(entries, "op") {
      Some(JsonValue::Str(s)) => s
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation missing string 'op'",
        ),
      )
    }
    let path = match json_object_get(entries, "path") {
      Some(JsonValue::Str(s)) => s
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "patch operation missing string 'path'",
        ),
      )
    }
    if op_name == "add" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'add' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Add(path, v))
    } else if op_name == "remove" {
      ops.push(PatchOp::Remove(path))
    } else if op_name == "replace" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'replace' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Replace(path, v))
    } else if op_name == "move" {
      let from = match json_object_get(entries, "from") {
        Some(JsonValue::Str(s)) => s
        _ =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'move' operation missing string 'from'",
          ),
        )
      }
      ops.push(PatchOp::Move(from, path))
    } else if op_name == "copy" {
      let from = match json_object_get(entries, "from") {
        Some(JsonValue::Str(s)) => s
        _ =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'copy' operation missing string 'from'",
          ),
        )
      }
      ops.push(PatchOp::Copy(from, path))
    } else if op_name == "test" {
      let v = match json_object_get(entries, "value") {
        Some(x) => x
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "'test' operation missing 'value'",
          ),
        )
      }
      ops.push(PatchOp::Test(path, v))
    } else {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "unknown patch op: " + op_name,
        ),
      )
    }
    i = i + 1
  }
  Ok(JsonPatch::{ ops: ops })
}

///| Encode a `JsonPatch` as a `JsonValue::Array`.
pub fn patch_to_value_impl(patch : JsonPatch) -> JsonValue {
  let out : Array[JsonValue] = []
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("add")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
      PatchOp::Remove(path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("remove")), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Replace(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("replace")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
      PatchOp::Move(from, path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("move")), ("from", JsonValue::Str(from)), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Copy(from, path) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("copy")), ("from", JsonValue::Str(from)), ("path", JsonValue::Str(path))]),
      )
      PatchOp::Test(path, v) =>
      out.push(
        JsonValue::Object([("op", JsonValue::Str("test")), ("path", JsonValue::Str(path)), ("value", v)]),
      )
    }
    i = i + 1
  }
  JsonValue::Array(out)
}

fn is_proper_prefix(from : Array[String], path : Array[String]) -> Bool {
  if from.length() >= path.length() {
    return false
  }
  let mut i = 0
  while i < from.length() {
    if from[i] != path[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Apply an RFC 6902 `JsonPatch` atomically with explicit resource limits.
pub fn apply_patch_impl(
  doc : JsonValue,
  patch : JsonPatch,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  if patch.ops.length() > limits.max_patch_ops {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "patch exceeds max_patch_ops",
      ),
    )
  }
  let mut cur = doc
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path, v) => {
        let ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        if ptr.tokens.length() > limits.max_depth {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::LimitExceeded,
              0,
              "pointer depth exceeds max_depth",
            ),
          )
        }
        cur = match cow_add(cur, ptr.tokens, 0, v) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
      }
      PatchOp::Remove(path) => {
        let ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let (next, _) = match cow_remove(cur, ptr.tokens, 0) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        cur = next
      }
      PatchOp::Replace(path, v) => {
        let ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        cur = match cow_replace(cur, ptr.tokens, 0, v) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
      }
      PatchOp::Move(from, path) => {
        let from_ptr = match pointer_parse_impl(from) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        if is_proper_prefix(from_ptr.tokens, path_ptr.tokens) {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'move' from location cannot be a proper prefix of path",
            ),
          )
        }
        let (after_rm, moved_val) = match cow_remove(cur, from_ptr.tokens, 0) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        cur = match cow_add(after_rm, path_ptr.tokens, 0, moved_val) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
      }
      PatchOp::Copy(from, path) => {
        let from_ptr = match pointer_parse_impl(from) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let copied_val = match pointer_resolve_impl(from_ptr, cur) {
          Some(v) => v
          None =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'copy' from location does not exist: " + from,
            ),
          )
        }
        cur = match cow_add(cur, path_ptr.tokens, 0, copied_val) {
          Ok(next) => next
          Err(e) => return Err(e)
        }
      }
      PatchOp::Test(path, expected) => {
        let ptr = match pointer_parse_impl(path) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let actual = match pointer_resolve_impl(ptr, cur) {
          Some(v) => v
          None =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'test' target does not exist: " + path,
            ),
          )
        }
        if !json_value_eq_impl(actual, expected) {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "'test' operation failed at " + path,
            ),
          )
        }
      }
    }
    i = i + 1
  }
  Ok(cur)
}

// ============================================================================
// RFC 6902 Diff Generator (`diff_patch`)
// ============================================================================

fn diff_recurse(
  prefix : String,
  before : JsonValue,
  after : JsonValue,
  ops : Array[PatchOp],
  depth : Int,
) -> Unit {
  if json_value_eq_impl(before, after) {
    return
  }
  if depth > 256 {
    ops.push(PatchOp::Replace(prefix, after))
    return
  }
  match (before, after) {
    (JsonValue::Object(ea), JsonValue::Object(eb)) => {
      // Remove keys in before that are absent in after
      let mut i = 0
      while i < ea.length() {
        let (k, va) = ea[i]
        let child_path = prefix + "/" + escape_token_impl(k)
        match json_object_get(eb, k) {
          Some(vb) => diff_recurse(child_path, va, vb, ops, depth + 1)
          None => ops.push(PatchOp::Remove(child_path))
        }
        i = i + 1
      }
      // Add keys in after that are absent in before
      let mut j = 0
      while j < eb.length() {
        let (k, vb) = eb[j]
        match json_object_get(ea, k) {
          Some(_) => ()
          None => {
            let child_path = prefix + "/" + escape_token_impl(k)
            ops.push(PatchOp::Add(child_path, vb))
          }
        }
        j = j + 1
      }
    }
    (JsonValue::Array(xa), JsonValue::Array(xb)) => {
      let na = xa.length()
      let nb = xb.length()
      // Trim common prefix
      let mut common_pre = 0
      while common_pre < na &&
      common_pre < nb &&
      json_value_eq_impl(xa[common_pre], xb[common_pre]) {
        common_pre = common_pre + 1
      }
      // Trim common suffix
      let mut common_suf = 0
      while common_suf < na - common_pre &&
      common_suf < nb - common_pre &&
      json_value_eq_impl(xa[na - 1 - common_suf], xb[nb - 1 - common_suf]) {
        common_suf = common_suf + 1
      }
      let mid_a = na - common_pre - common_suf
      let mid_b = nb - common_pre - common_suf
      let overlap = if mid_a < mid_b { mid_a } else { mid_b }
      // Diff overlapping middle elements in-place
      let mut k = 0
      while k < overlap {
        let idx = common_pre + k
        diff_recurse(
          prefix + "/" + idx.to_string(),
          xa[idx],
          xb[idx],
          ops,
          depth + 1,
        )
        k = k + 1
      }
      if mid_a > mid_b {
        // Remove extra elements (from highest index down so earlier indices stay valid)
        let mut r = mid_a - 1
        while r >= overlap {
          let idx = common_pre + r
          ops.push(PatchOp::Remove(prefix + "/" + idx.to_string()))
          r = r - 1
        }
      } else if mid_b > mid_a {
        // Insert extra elements
        let mut ins = overlap
        while ins < mid_b {
          let idx = common_pre + ins
          if common_suf == 0 && idx == na + (ins - overlap) {
            ops.push(PatchOp::Add(prefix + "/-", xb[idx]))
          } else {
            ops.push(PatchOp::Add(prefix + "/" + idx.to_string(), xb[idx]))
          }
          ins = ins + 1
        }
      }
    }
    _ => ops.push(PatchOp::Replace(prefix, after))
  }
}

///| Compute an RFC 6902 `JsonPatch` transforming `before` into `after`.
pub fn diff_patch_impl(before : JsonValue, after : JsonValue) -> JsonPatch {
  let ops : Array[PatchOp] = []
  diff_recurse("", before, after, ops, 0)
  JsonPatch::{ ops: ops }
}

// ============================================================================
// RFC 7396 JSON Merge Patch
// ============================================================================

fn merge_patch_recurse(
  target : JsonValue,
  patch : JsonValue,
  depth : Int,
  max_depth : Int,
) -> Result[JsonValue, JsonPathError] {
  if depth > max_depth {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "merge_patch exceeded max_depth",
      ),
    )
  }
  let p_entries = match patch {
    JsonValue::Object(es) => es
    _ => return Ok(patch)
  }
  // Start with copy of target entries (or empty if target is not an Object)
  let out : Array[(String, JsonValue)] = []
  match target {
    JsonValue::Object(t_entries) => {
      let mut i = 0
      while i < t_entries.length() {
        out.push(t_entries[i])
        i = i + 1
      }
    }
    _ => ()
  }
  let mut pi = 0
  while pi < p_entries.length() {
    let (pk, pv) = p_entries[pi]
    match pv {
      JsonValue::Null => {
        // Remove pk from out if present
        let mut k = 0
        while k < out.length() {
          let (ok_key, _) = out[k]
          if ok_key == pk {
            // Shift left preserving order
            let mut m = k
            while m + 1 < out.length() {
              out[m] = out[m + 1]
              m = m + 1
            }
            let _ = out.pop()
          } else {
            k = k + 1
          }
        }
      }
      _ => {
        let mut found = -1
        let mut k = out.length() - 1
        while k >= 0 {
          let (ok_key, _) = out[k]
          if ok_key == pk {
            found = k
            break
          }
          k = k - 1
        }
        let existing = if found >= 0 {
          let (_, ev) = out[found]
          ev
        } else {
          JsonValue::Object([])
        }
        let merged = match merge_patch_recurse(existing, pv, depth + 1, max_depth) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if found >= 0 {
          out[found] = (pk, merged)
        } else {
          out.push((pk, merged))
        }
      }
    }
    pi = pi + 1
  }
  Ok(JsonValue::Object(out))
}

///| Apply an RFC 7396 JSON Merge Patch.
pub fn merge_patch_impl(target : JsonValue, patch : JsonValue) -> JsonValue {
  match merge_patch_recurse(target, patch, 0, 512) {
    Ok(v) => v
    Err(_) => patch
  }
}

///| Apply an RFC 7396 JSON Merge Patch with explicit limits.
pub fn merge_patch_with_limits_impl(
  target : JsonValue,
  patch : JsonValue,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  merge_patch_recurse(target, patch, 0, limits.max_depth)
}
