///| Exact JSON DOM, iterative RFC 8259 parser, canonical serializer,
///| mathematical numeric equality/ordering, and UTF-8 scalar value utilities.

///| Count Unicode scalar values (codepoints) in a valid UTF-8 `String`.
pub fn utf8_codepoint_count(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    // Count every byte that is NOT a UTF-8 continuation byte (10xxxxxx)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///| Append a Unicode scalar value (`0..0x10FFFF`, excluding surrogates) as UTF-8 to `sb`.
pub fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Parse 4 hex digits at `s[pos..pos+4]`, returning `-1` on invalid hex.
pub fn parse_hex4(s : String, pos : Int) -> Int {
  if pos + 4 > s.length() {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < 4 {
    let b = s.code_unit_at(pos + i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if b >= 65 && b <= 70 {
      b - 55
    } else if b >= 97 && b <= 102 {
      b - 87
    } else {
      return -1
    }
    acc = (acc << 4) | d
    i = i + 1
  }
  acc
}

///| Lowercase hex digit byte for nibble `0..15`.
pub fn lower_hex_byte(nibble : Int) -> Byte {
  let v = nibble & 0xF
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (87 + v).to_byte()
  }
}

///| Exact mathematical equality between `Int64` and `Double`.
fn int64_eq_double(i : Int64, d : Double) -> Bool {
  // Reject NaN and infinities
  if d != d || d == 1.0 / 0.0 || d == -1.0 / 0.0 {
    return false
  }
  // Int64 range in Double: [-2^63, 2^63)
  if d < -9223372036854775808.0 || d >= 9223372036854775808.0 {
    return false
  }
  let di = d.to_int64()
  di.to_double() == d && di == i
}

///| Exact mathematical `<` between `Int64` and `Double` (i < d).
fn int64_lt_double(i : Int64, d : Double) -> Bool {
  if d != d {
    return false
  }
  if d >= 9223372036854775808.0 {
    return true
  }
  if d < -9223372036854775808.0 {
    return false
  }
  let trunc = d.to_int64()
  let trunc_d = trunc.to_double()
  if d > trunc_d {
    // d is strictly between trunc and trunc + 1 (since d > 0)
    i <= trunc
  } else if d < trunc_d {
    // d is strictly between trunc - 1 and trunc (since d < 0)
    i < trunc
  } else {
    i < trunc
  }
}

///| Exact mathematical `<` between `Double` and `Int64` (d < i).
fn double_lt_int64(d : Double, i : Int64) -> Bool {
  if d != d {
    return false
  }
  if d < -9223372036854775808.0 {
    return true
  }
  if d >= 9223372036854775808.0 {
    return false
  }
  let trunc = d.to_int64()
  let trunc_d = trunc.to_double()
  if d < trunc_d {
    // d is strictly less than trunc
    trunc <= i
  } else if d > trunc_d {
    // d is strictly greater than trunc
    trunc < i
  } else {
    trunc < i
  }
}

///| Exact signed comparison of two canonical decimal integer strings (`-1`, `0`, `1`).
fn bigint_cmp(a : String, b : String) -> Int {
  let neg_a = a.length() > 0 && a.code_unit_at(0) == 45
  let neg_b = b.length() > 0 && b.code_unit_at(0) == 45
  if neg_a && !neg_b {
    return -1
  }
  if !neg_a && neg_b {
    return 1
  }
  let la = a.length()
  let lb = b.length()
  let mut mag = 0
  if la != lb {
    mag = if la < lb { -1 } else { 1 }
  } else {
    let mut i = if neg_a { 1 } else { 0 }
    while i < la {
      let ca = a.code_unit_at(i)
      let cb = b.code_unit_at(i)
      if ca != cb {
        mag = if ca < cb { -1 } else { 1 }
        break
      }
      i = i + 1
    }
  }
  if neg_a { -mag } else { mag }
}

///| Convert a finite IEEE 754 `Double` with `|d| >= 2^52` to its exact canonical decimal integer string.
fn large_double_to_int_str(d : Double) -> String {
  let neg = d < 0.0
  let mut x = if neg { -d } else { d }
  let mut e = 0
  while x >= 9007199254740992.0 {
    x = x * 0.5
    e = e + 1
  }
  let m = x.to_int64()
  let base = 1000000000L
  let limbs : Array[Int64] = [m % base]
  let hi = m / base
  if hi > 0L {
    limbs.push(hi)
  }
  while e > 0 {
    let shift = if e >= 30 { 30 } else { e }
    let mul = 1L << shift
    let mut carry = 0L
    let mut i = 0
    while i < limbs.length() {
      let v = limbs[i] * mul + carry
      limbs[i] = v % base
      carry = v / base
      i = i + 1
    }
    while carry > 0L {
      limbs.push(carry % base)
      carry = carry / base
    }
    e = e - shift
  }
  let sb = StringBuilder::new()
  if neg {
    sb.write_byte((45).to_byte())
  }
  let top = limbs.length() - 1
  sb.write_string(limbs[top].to_string())
  let mut idx = top - 1
  while idx >= 0 {
    let part = limbs[idx].to_string()
    let mut pad = 9 - part.length()
    while pad > 0 {
      sb.write_byte((48).to_byte())
      pad = pad - 1
    }
    sb.write_string(part)
    idx = idx - 1
  }
  sb.to_string()
}

///| Compare canonical decimal integer string `s` against finite `Double` `d`:
///| returns `-1` if `s < d`, `0` if `s == d`, `1` if `s > d`.
fn bigint_cmp_double(s : String, d : Double) -> Int {
  if d == 1.0 / 0.0 {
    return -1
  }
  if d == -1.0 / 0.0 {
    return 1
  }
  if d >= 4503599627370496.0 || d <= -4503599627370496.0 {
    return bigint_cmp(s, large_double_to_int_str(d))
  }
  let trunc = d.to_int64()
  let c = bigint_cmp(s, trunc.to_string())
  if c != 0 {
    return c
  }
  let trunc_d = trunc.to_double()
  if trunc_d < d {
    -1
  } else if trunc_d > d {
    1
  } else {
    0
  }
}

fn bigint_eq_double(s : String, d : Double) -> Bool {
  if d != d || d == 1.0 / 0.0 || d == -1.0 / 0.0 {
    return false
  }
  bigint_cmp_double(s, d) == 0
}

fn bigint_lt_double(s : String, d : Double) -> Bool {
  if d != d {
    return false
  }
  bigint_cmp_double(s, d) < 0
}

fn double_lt_bigint(d : Double, s : String) -> Bool {
  if d != d {
    return false
  }
  bigint_cmp_double(s, d) > 0
}

///| Fast leaf-only equality check without stack allocation.
///| Returns: 1 = equal leaf, 0 = unequal or type mismatch, 2 = both Array or both Object.
pub fn json_value_eq_leaf(a : JsonValue, b : JsonValue) -> Int {
  match (a, b) {
    (JsonValue::Null, JsonValue::Null) => 1
    (JsonValue::Bool(x), JsonValue::Bool(y)) => if x == y { 1 } else { 0 }
    (JsonValue::Int(x), JsonValue::Int(y)) => if x == y { 1 } else { 0 }
    (JsonValue::Str(x), JsonValue::Str(y)) => if x == y { 1 } else { 0 }
    (JsonValue::Float(x), JsonValue::Float(y)) => if x == y { 1 } else { 0 }
    (JsonValue::Int(x), JsonValue::Float(y)) => if int64_eq_double(x, y) { 1 } else { 0 }
    (JsonValue::Float(x), JsonValue::Int(y)) => if int64_eq_double(y, x) { 1 } else { 0 }
    (JsonValue::BigInt(x), JsonValue::BigInt(y)) => if x == y { 1 } else { 0 }
    (JsonValue::Int(x), JsonValue::BigInt(y)) => if bigint_cmp(x.to_string(), y) == 0 { 1 } else { 0 }
    (JsonValue::BigInt(x), JsonValue::Int(y)) => if bigint_cmp(x, y.to_string()) == 0 { 1 } else { 0 }
    (JsonValue::BigInt(x), JsonValue::Float(y)) => if bigint_eq_double(x, y) { 1 } else { 0 }
    (JsonValue::Float(x), JsonValue::BigInt(y)) => if bigint_eq_double(y, x) { 1 } else { 0 }
    (JsonValue::Array(_), JsonValue::Array(_)) => 2
    (JsonValue::Object(_), JsonValue::Object(_)) => 2
    _ => 0
  }
}

///| Zero-allocation recursive fast path for structural JSON equality (depth < 32),
///| falling back to iterative stack evaluation for deep trees.
fn json_value_eq_depth(a : JsonValue, b : JsonValue, depth : Int) -> Bool {
  let r0 = json_value_eq_leaf(a, b)
  if r0 != 2 {
    return r0 == 1
  }
  if depth >= 32 {
    return json_value_eq_iter(a, b)
  }
  match (a, b) {
    (JsonValue::Array(xa), JsonValue::Array(xb)) => {
      let n = xa.length()
      if n != xb.length() {
        return false
      }
      let mut i = 0
      while i < n {
        let r = json_value_eq_leaf(xa[i], xb[i])
        if r == 0 {
          return false
        }
        if r == 2 && !json_value_eq_depth(xa[i], xb[i], depth + 1) {
          return false
        }
        i = i + 1
      }
      true
    }
    (JsonValue::Object(ea), JsonValue::Object(eb)) => {
      let na = ea.length()
      let nb = eb.length()
      if na == 0 && nb == 0 {
        return true
      }
      if na <= 12 && nb <= 12 {
        // Fast single-pass in-order path when keys match in order
        if na == nb {
          let mut in_order_ok = true
          let mut i = 0
          while i < na {
            let (ka, sub_a) = ea[i]
            let (kb, sub_b) = eb[i]
            if ka.length() != kb.length() || ka != kb {
              in_order_ok = false
              break
            }
            let r = json_value_eq_leaf(sub_a, sub_b)
            let eq_child = if r == 1 {
              true
            } else if r == 0 {
              false
            } else {
              json_value_eq_depth(sub_a, sub_b, depth + 1)
            }
            if !eq_child {
              // If `ka` is not shadowed later in `ea`, the objects are definitely unequal!
              let mut shadowed = false
              let ka_len = ka.length()
              let mut k = i + 1
              while k < na {
                let (ka2, _) = ea[k]
                if ka2.length() == ka_len && ka2 == ka {
                  shadowed = true
                  break
                }
                k = k + 1
              }
              if !shadowed {
                return false
              }
              in_order_ok = false
              break
            }
            i = i + 1
          }
          if in_order_ok {
            return true
          }
        }
        // Order-independent small object check with LastWins duplicate handling
        let mut unique_a = 0
        let mut i = 0
        while i < na {
          let (ka, sub_a) = ea[i]
          let ka_len = ka.length()
          let mut shadowed = false
          let mut k = i + 1
          while k < na {
            let (ka2, _) = ea[k]
            if ka2.length() == ka_len && ka2 == ka {
              shadowed = true
              break
            }
            k = k + 1
          }
          if !shadowed {
            unique_a = unique_a + 1
            let mut found_b = -1
            let mut j = nb - 1
            while j >= 0 {
              let (kb, _) = eb[j]
              if kb.length() == ka_len && kb == ka {
                found_b = j
                break
              }
              j = j - 1
            }
            if found_b < 0 {
              return false
            }
            let (_, sub_b) = eb[found_b]
            let r = json_value_eq_leaf(sub_a, sub_b)
            if r == 0 {
              return false
            }
            if r == 2 && !json_value_eq_depth(sub_a, sub_b, depth + 1) {
              return false
            }
          }
          i = i + 1
        }
        let mut unique_b = 0
        let mut j = 0
        while j < nb {
          let (kb, _) = eb[j]
          let kb_len = kb.length()
          let mut shadowed = false
          let mut k = j + 1
          while k < nb {
            let (kb2, _) = eb[k]
            if kb2.length() == kb_len && kb2 == kb {
              shadowed = true
              break
            }
            k = k + 1
          }
          if !shadowed {
            unique_b = unique_b + 1
          }
          j = j + 1
        }
        unique_a == unique_b
      } else {
        json_value_eq_iter(a, b)
      }
    }
    _ => false
  }
}

///| Structural JSON equality (100% stack-safe, exact Int64/BigInt/Double numeric equality,
///| order-independent objects with LastWins semantics for duplicate keys, O(n) for wide objects).
pub fn json_value_eq_impl(a : JsonValue, b : JsonValue) -> Bool {
  json_value_eq_depth(a, b, 0)
}

fn json_value_eq_iter(a : JsonValue, b : JsonValue) -> Bool {
  let r0 = json_value_eq_leaf(a, b)
  if r0 != 2 {
    return r0 == 1
  }
  let stack : Array[(JsonValue, JsonValue)] = Array::with_capacity(8)
  stack.push((a, b))
  while stack.length() > 0 {
    let pair = match stack.pop() {
      Some(p) => p
      None => break
    }
    let (va, vb) = pair
    match (va, vb) {
      (JsonValue::Array(xa), JsonValue::Array(xb)) => {
        let n = xa.length()
        if n != xb.length() {
          return false
        }
        let mut i = 0
        while i < n {
          let r = json_value_eq_leaf(xa[i], xb[i])
          if r == 0 {
            return false
          }
          if r == 2 {
            stack.push((xa[i], xb[i]))
          }
          i = i + 1
        }
      }
      (JsonValue::Object(ea), JsonValue::Object(eb)) => {
        let na = ea.length()
        let nb = eb.length()
        if na == 0 && nb == 0 {
          continue
        }
        if na <= 12 && nb <= 12 {
          // Fast in-order path when both objects have identical key order & lengths
          if na == nb {
            let mut in_order_ok = true
            let mut i = 0
            while i < na {
              let (ka, sub_a) = ea[i]
              let (kb, sub_b) = eb[i]
              if ka != kb {
                in_order_ok = false
                break
              }
              let r = json_value_eq_leaf(sub_a, sub_b)
              if r == 0 {
                in_order_ok = false
                break
              }
              i = i + 1
            }
            if in_order_ok {
              let mut j = 0
              while j < na {
                let (_, sub_a) = ea[j]
                let (_, sub_b) = eb[j]
                if json_value_eq_leaf(sub_a, sub_b) == 2 {
                  stack.push((sub_a, sub_b))
                }
                j = j + 1
              }
              continue
            }
          }
          let mut unique_a = 0
          let mut i = 0
          while i < na {
            let (ka, sub_a) = ea[i]
            let mut shadowed = false
            let mut k = i + 1
            while k < na {
              let (ka2, _) = ea[k]
              if ka2 == ka {
                shadowed = true
                break
              }
              k = k + 1
            }
            if !shadowed {
              unique_a = unique_a + 1
              let mut found_b = -1
              let mut j = nb - 1
              while j >= 0 {
                let (kb, _) = eb[j]
                if kb == ka {
                  found_b = j
                  break
                }
                j = j - 1
              }
              if found_b < 0 {
                return false
              }
              let (_, sub_b) = eb[found_b]
              let r = json_value_eq_leaf(sub_a, sub_b)
              if r == 0 {
                return false
              }
              if r == 2 {
                stack.push((sub_a, sub_b))
              }
            }
            i = i + 1
          }
          let mut unique_b = 0
          let mut j = 0
          while j < nb {
            let (kb, _) = eb[j]
            let mut shadowed = false
            let mut k = j + 1
            while k < nb {
              let (kb2, _) = eb[k]
              if kb2 == kb {
                shadowed = true
                break
              }
              k = k + 1
            }
            if !shadowed {
              unique_b = unique_b + 1
            }
            j = j + 1
          }
          if unique_a != unique_b {
            return false
          }
        } else {
          // O(na + nb) Map-indexed object equality with LastWins duplicate handling
          let map_a : Map[String, Int] = Map::new()
          let mut unique_a = 0
          let mut i = 0
          while i < na {
            let (ka, _) = ea[i]
            match map_a.get(ka) {
              None => unique_a = unique_a + 1
              Some(_) => ()
            }
            map_a.set(ka, i)
            i = i + 1
          }
          let map_b : Map[String, Int] = Map::new()
          let mut unique_b = 0
          let mut j = 0
          while j < nb {
            let (kb, _) = eb[j]
            match map_b.get(kb) {
              None => unique_b = unique_b + 1
              Some(_) => ()
            }
            map_b.set(kb, j)
            j = j + 1
          }
          if unique_a != unique_b {
            return false
          }
          i = 0
          while i < na {
            let (ka, sub_a) = ea[i]
            let is_last = match map_a.get(ka) {
              Some(idx) => idx == i
              None => false
            }
            if is_last {
              match map_b.get(ka) {
                Some(jb) => {
                  let (_, sub_b) = eb[jb]
                  let r = json_value_eq_leaf(sub_a, sub_b)
                  if r == 0 {
                    return false
                  }
                  if r == 2 {
                    stack.push((sub_a, sub_b))
                  }
                }
                None => return false
              }
            }
            i = i + 1
          }
        }
      }
      _ => {
        if json_value_eq_leaf(va, vb) != 1 {
          return false
        }
      }
    }
  }
  true
}

///| RFC 9535 §2.3.5.2.2 `<` comparison (only numbers with numbers, strings with strings).
pub fn json_value_lt(a : JsonValue, b : JsonValue) -> Bool {
  match (a, b) {
    (JsonValue::Int(x), JsonValue::Int(y)) => x < y
    (JsonValue::BigInt(x), JsonValue::BigInt(y)) => bigint_cmp(x, y) < 0
    (JsonValue::Int(x), JsonValue::BigInt(y)) => bigint_cmp(x.to_string(), y) < 0
    (JsonValue::BigInt(x), JsonValue::Int(y)) => bigint_cmp(x, y.to_string()) < 0
    (JsonValue::Float(x), JsonValue::Float(y)) => x < y
    (JsonValue::Int(x), JsonValue::Float(y)) => int64_lt_double(x, y)
    (JsonValue::Float(x), JsonValue::Int(y)) => double_lt_int64(x, y)
    (JsonValue::BigInt(x), JsonValue::Float(y)) => bigint_lt_double(x, y)
    (JsonValue::Float(x), JsonValue::BigInt(y)) => double_lt_bigint(x, y)
    (JsonValue::Str(x), JsonValue::Str(y)) => {
      // UTF-8 byte lexicographical order is identical to Unicode scalar value order!
      let nx = x.length()
      let ny = y.length()
      let m = if nx < ny { nx } else { ny }
      let mut i = 0
      while i < m {
        let bx = x.code_unit_at(i)
        let by = y.code_unit_at(i)
        if bx != by {
          return bx < by
        }
        i = i + 1
      }
      nx < ny
    }
    _ => false
  }
}

///| Look up a key in a `JsonValue::Object` (LastWins).
pub fn json_object_get(
  entries : Array[(String, JsonValue)],
  key : String,
) -> Option[JsonValue] {
  let mut i = entries.length() - 1
  while i >= 0 {
    let (k, v) = entries[i]
    if k == key {
      return Some(v)
    }
    i = i - 1
  }
  Option::None
}

// ============================================================================
// Iterative RFC 8259 JSON Parser
// ============================================================================

enum ParseFrame {
  InArray(Array[JsonValue])
  InObject(Array[(String, JsonValue)], Option[Map[String, Int]], String)
}

fn object_insert_last_wins(
  entries : Array[(String, JsonValue)],
  idx_map : Option[Map[String, Int]],
  key : String,
  v : JsonValue,
) -> Option[Map[String, Int]] {
  match idx_map {
    Some(m) => {
      match m.get(key) {
        Some(pos) => entries[pos] = (key, v)
        None => {
          m.set(key, entries.length())
          entries.push((key, v))
        }
      }
      Some(m)
    }
    None => {
      let n = entries.length()
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        if k == key {
          entries[i] = (key, v)
          return Option::None
        }
        i = i + 1
      }
      if n >= 16 {
        let m : Map[String, Int] = Map::new()
        let mut j = 0
        while j < n {
          let (ek, _) = entries[j]
          m.set(ek, j)
          j = j + 1
        }
        m.set(key, n)
        entries.push((key, v))
        Some(m)
      } else {
        entries.push((key, v))
        Option::None
      }
    }
  }
}

fn is_json_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

fn skip_json_ws(src : String, start : Int) -> Int {
  let n = src.length()
  let mut i = start
  while i < n && is_json_ws(src.code_unit_at(i)) {
    i = i + 1
  }
  i
}

fn parse_json_string(
  src : String,
  start : Int,
) -> Result[(String, Int), JsonPathError] {
  let n = src.length()
  let mut i = start + 1 // skip opening '"'
  // Fast scan for simple unescaped ASCII/UTF-8 strings
  let mut fast_end = i
  while fast_end < n {
    let b = src.code_unit_at(fast_end)
    if b == 34 {
      return Ok((src.slice(i, fast_end), fast_end + 1))
    }
    if b == 92 || b < 0x20 {
      break
    }
    fast_end = fast_end + 1
  }
  let sb = StringBuilder::new()
  if fast_end > i {
    sb.write_string(src.slice(i, fast_end))
    i = fast_end
  }
  while i < n {
    let b = src.code_unit_at(i)
    if b == 34 {
      return Ok((sb.to_string(), i + 1))
    }
    if b < 0x20 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::JsonError,
          i,
          "unescaped control character in JSON string",
        ),
      )
    }
    if b == 92 {
      i = i + 1
      if i >= n {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "unterminated escape in JSON string",
          ),
        )
      }
      let esc = src.code_unit_at(i)
      if esc == 34 {
        sb.write_byte((34).to_byte())
        i = i + 1
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
        i = i + 1
      } else if esc == 47 {
        sb.write_byte((47).to_byte())
        i = i + 1
      } else if esc == 98 {
        sb.write_byte((8).to_byte())
        i = i + 1
      } else if esc == 102 {
        sb.write_byte((12).to_byte())
        i = i + 1
      } else if esc == 110 {
        sb.write_byte((10).to_byte())
        i = i + 1
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
        i = i + 1
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
        i = i + 1
      } else if esc == 117 {
        let u1 = parse_hex4(src, i + 1)
        if u1 < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::JsonError,
              i,
              "invalid \\uXXXX escape",
            ),
          )
        }
        i = i + 5
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          // Expect low surrogate
          if i + 6 <= n &&
          src.code_unit_at(i) == 92 &&
          src.code_unit_at(i + 1) == 117 {
            let u2 = parse_hex4(src, i + 2)
            if u2 >= 0xDC00 && u2 <= 0xDFFF {
              let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
              write_utf8_cp(sb, cp)
              i = i + 6
            } else {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::JsonError,
                  i,
                  "invalid low surrogate in \\uXXXX escape",
                ),
              )
            }
          } else {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "unpaired high surrogate in JSON string",
              ),
            )
          }
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::JsonError,
              i - 5,
              "unpaired low surrogate in JSON string",
            ),
          )
        } else {
          write_utf8_cp(sb, u1)
        }
      } else {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "invalid escape character in JSON string",
          ),
        )
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err(
    JsonPathError::new(
      JsonPathErrorKind::JsonError,
      start,
      "unterminated JSON string",
    ),
  )
}

fn parse_json_number(
  src : String,
  start : Int,
) -> Result[(JsonValue, Int), JsonPathError] {
  let n = src.length()
  let mut i = start
  let mut neg = false
  if i < n && src.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  }
  if i >= n {
    return Err(
      JsonPathError::new(JsonPathErrorKind::JsonError, start, "invalid number"),
    )
  }
  let d0 = src.code_unit_at(i)
  if d0 < 48 || d0 > 57 {
    return Err(
      JsonPathError::new(JsonPathErrorKind::JsonError, i, "expected digit"),
    )
  }
  let int_start = i
  if d0 == 48 {
    i = i + 1
    if i < n {
      let next_b = src.code_unit_at(i)
      if next_b >= 48 && next_b <= 57 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "leading zero in JSON number",
          ),
        )
      }
    }
  } else {
    while i < n {
      let b = src.code_unit_at(i)
      if b >= 48 && b <= 57 {
        i = i + 1
      } else {
        break
      }
    }
  }
  let mut is_float = false
  if i < n && src.code_unit_at(i) == 46 {
    is_float = true
    i = i + 1
    if i >= n || src.code_unit_at(i) < 48 || src.code_unit_at(i) > 57 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::JsonError,
          i,
          "expected digit after decimal point",
        ),
      )
    }
    while i < n {
      let b = src.code_unit_at(i)
      if b >= 48 && b <= 57 {
        i = i + 1
      } else {
        break
      }
    }
  }
  if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
    is_float = true
    i = i + 1
    if i < n && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
      i = i + 1
    }
    if i >= n || src.code_unit_at(i) < 48 || src.code_unit_at(i) > 57 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::JsonError,
          i,
          "expected digit in exponent",
        ),
      )
    }
    while i < n {
      let b = src.code_unit_at(i)
      if b >= 48 && b <= 57 {
        i = i + 1
      } else {
        break
      }
    }
  }
  if !is_float {
    // Parse exact Int64 if it fits
    let digit_count = i - int_start
    if digit_count <= 18 {
      let mut acc = 0L
      let mut k = int_start
      while k < i {
        acc = acc * 10L + (src.code_unit_at(k) - 48).to_int64()
        k = k + 1
      }
      if neg {
        if acc == 0L {
          return Ok((JsonValue::Float(-0.0), i))
        }
        return Ok((JsonValue::Int(-acc), i))
      }
      return Ok((JsonValue::Int(acc), i))
    }
    // 19 digits: check Int64 bounds carefully
    if digit_count == 19 {
      let mut acc = 0L
      let mut k = int_start
      let mut overflow = false
      while k < i {
        let d = (src.code_unit_at(k) - 48).to_int64()
        if neg {
          // accumulate negative to allow -9223372036854775808
          if acc < -922337203685477580L ||
          (acc == -922337203685477580L && d > 8L) {
            overflow = true
            break
          }
          acc = acc * 10L - d
        } else {
          if acc > 922337203685477580L || (acc == 922337203685477580L && d > 7L) {
            overflow = true
            break
          }
          acc = acc * 10L + d
        }
        k = k + 1
      }
      if !overflow {
        return Ok((JsonValue::Int(acc), i))
      }
    }
    // Integer outside Int64 range: preserve exact lossless decimal representation
    return Ok((JsonValue::BigInt(src.slice(start, i)), i))
  }
  let raw = src.slice(start, i)
  match raw.to_double() {
    Some(d) => {
      if d == 1.0 / 0.0 || d == -1.0 / 0.0 || d != d {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            start,
            "number overflow",
          ),
        )
      }
      if neg && d == 0.0 {
        return Ok((JsonValue::Float(-0.0), i))
      }
      Ok((JsonValue::Float(d), i))
    }
    None =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::JsonError,
        start,
        "invalid floating-point number",
      ),
    )
  }
}

///| Iterative RFC 8259 JSON parser enforcing `limits.max_depth`.
pub fn parse_json_impl(
  src : String,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  let n = src.length()
  let mut i = skip_json_ws(src, 0)
  if i >= n {
    return Err(
      JsonPathError::new(JsonPathErrorKind::JsonError, i, "empty JSON input"),
    )
  }
  let frames : Array[ParseFrame] = []
  let mut expect_value = true
  let mut completed : Option[JsonValue] = Option::None

  while true {
    if expect_value {
      i = skip_json_ws(src, i)
      if i >= n {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "unexpected end of JSON input",
          ),
        )
      }
      let b = src.code_unit_at(i)
      if b == 91 {
        // '['
        if frames.length() + 1 > limits.max_depth {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::LimitExceeded,
              i,
              "JSON nesting exceeds max_depth",
            ),
          )
        }
        i = skip_json_ws(src, i + 1)
        if i < n && src.code_unit_at(i) == 93 {
          i = i + 1
          completed = Some(JsonValue::Array([]))
          expect_value = false
        } else {
          frames.push(ParseFrame::InArray([]))
          expect_value = true
        }
      } else if b == 123 {
        // '{'
        if frames.length() + 1 > limits.max_depth {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::LimitExceeded,
              i,
              "JSON nesting exceeds max_depth",
            ),
          )
        }
        i = skip_json_ws(src, i + 1)
        if i < n && src.code_unit_at(i) == 125 {
          i = i + 1
          completed = Some(JsonValue::Object([]))
          expect_value = false
        } else {
          if i >= n || src.code_unit_at(i) != 34 {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "expected object key string",
              ),
            )
          }
          let (key, next_i) = match parse_json_string(src, i) {
            Ok(p) => p
            Err(e) => return Err(e)
          }
          i = skip_json_ws(src, next_i)
          if i >= n || src.code_unit_at(i) != 58 {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "expected ':' after object key",
              ),
            )
          }
          i = i + 1
          frames.push(ParseFrame::InObject([], Option::None, key))
          expect_value = true
        }
      } else if b == 34 {
        let (s, next_i) = match parse_json_string(src, i) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        i = next_i
        completed = Some(JsonValue::Str(s))
        expect_value = false
      } else if b == 116 {
        // true
        if i + 4 <= n && src.slice(i, i + 4) == "true" {
          i = i + 4
          completed = Some(JsonValue::Bool(true))
          expect_value = false
        } else {
          return Err(
            JsonPathError::new(JsonPathErrorKind::JsonError, i, "invalid token"),
          )
        }
      } else if b == 102 {
        // false
        if i + 5 <= n && src.slice(i, i + 5) == "false" {
          i = i + 5
          completed = Some(JsonValue::Bool(false))
          expect_value = false
        } else {
          return Err(
            JsonPathError::new(JsonPathErrorKind::JsonError, i, "invalid token"),
          )
        }
      } else if b == 110 {
        // null
        if i + 4 <= n && src.slice(i, i + 4) == "null" {
          i = i + 4
          completed = Some(JsonValue::Null)
          expect_value = false
        } else {
          return Err(
            JsonPathError::new(JsonPathErrorKind::JsonError, i, "invalid token"),
          )
        }
      } else if b == 45 || (b >= 48 && b <= 57) {
        let (num, next_i) = match parse_json_number(src, i) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        i = next_i
        completed = Some(num)
        expect_value = false
      } else {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "unexpected character in JSON",
          ),
        )
      }
    } else {
      let cur_val = match completed {
        Some(v) => v
        None =>
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::JsonError,
            i,
            "internal parser state error",
          ),
        )
      }
      if frames.length() == 0 {
        i = skip_json_ws(src, i)
        if i != n {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::JsonError,
              i,
              "trailing characters after JSON value",
            ),
          )
        }
        return Ok(cur_val)
      }
      let top = match frames.pop() {
        Some(f) => f
        None => break
      }
      match top {
        ParseFrame::InArray(arr) => {
          arr.push(cur_val)
          i = skip_json_ws(src, i)
          if i >= n {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "unterminated JSON array",
              ),
            )
          }
          let sep = src.code_unit_at(i)
          if sep == 44 {
            i = i + 1
            frames.push(ParseFrame::InArray(arr))
            expect_value = true
          } else if sep == 93 {
            i = i + 1
            completed = Some(JsonValue::Array(arr))
            expect_value = false
          } else {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "expected ',' or ']' in array",
              ),
            )
          }
        }
        ParseFrame::InObject(entries, idx_map, key) => {
          let next_map = object_insert_last_wins(entries, idx_map, key, cur_val)
          i = skip_json_ws(src, i)
          if i >= n {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "unterminated JSON object",
              ),
            )
          }
          let sep = src.code_unit_at(i)
          if sep == 44 {
            i = skip_json_ws(src, i + 1)
            if i >= n || src.code_unit_at(i) != 34 {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::JsonError,
                  i,
                  "expected object key after ','",
                ),
              )
            }
            let (next_key, next_i) = match parse_json_string(src, i) {
              Ok(p) => p
              Err(e) => return Err(e)
            }
            i = skip_json_ws(src, next_i)
            if i >= n || src.code_unit_at(i) != 58 {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::JsonError,
                  i,
                  "expected ':' after object key",
                ),
              )
            }
            i = i + 1
            frames.push(ParseFrame::InObject(entries, next_map, next_key))
            expect_value = true
          } else if sep == 125 {
            i = i + 1
            completed = Some(JsonValue::Object(entries))
            expect_value = false
          } else {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::JsonError,
                i,
                "expected ',' or '}' in object",
              ),
            )
          }
        }
      }
    }
  }
  Err(
    JsonPathError::new(JsonPathErrorKind::JsonError, i, "unexpected parser exit"),
  )
}

// ============================================================================
// Iterative Canonical JSON Serializer
// ============================================================================

fn write_json_string_escaped(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      sb.write_byte(lower_hex_byte(b >> 4))
      sb.write_byte(lower_hex_byte(b & 0xF))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

enum SerTask {
  Val(JsonValue)
  Raw(String)
  Key(String)
}

///| Serialize a `JsonValue` to compact RFC 8259 JSON (100% iterative).
pub fn to_json_string_impl(value : JsonValue) -> String {
  let sb = StringBuilder::new()
  let stack : Array[SerTask] = [SerTask::Val(value)]
  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      SerTask::Raw(r) => sb.write_string(r)
      SerTask::Key(k) => {
        write_json_string_escaped(sb, k)
        sb.write_byte((58).to_byte())
      }
      SerTask::Val(v) => {
        match v {
          JsonValue::Null => sb.write_string("null")
          JsonValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          JsonValue::Int(x) => sb.write_string(x.to_string())
          JsonValue::BigInt(s) => sb.write_string(s)
          JsonValue::Float(x) => {
            if x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0 {
              sb.write_string("null")
            } else {
              sb.write_string(x.to_string())
            }
          }
          JsonValue::Str(s) => write_json_string_escaped(sb, s)
          JsonValue::Array(items) => {
            sb.write_byte((91).to_byte())
            stack.push(SerTask::Raw("]"))
            let mut idx = items.length() - 1
            while idx >= 0 {
              stack.push(SerTask::Val(items[idx]))
              if idx > 0 {
                stack.push(SerTask::Raw(","))
              }
              idx = idx - 1
            }
          }
          JsonValue::Object(entries) => {
            sb.write_byte((123).to_byte())
            stack.push(SerTask::Raw("}"))
            let mut idx = entries.length() - 1
            while idx >= 0 {
              let (k, ev) = entries[idx]
              stack.push(SerTask::Val(ev))
              stack.push(SerTask::Key(k))
              if idx > 0 {
                stack.push(SerTask::Raw(","))
              }
              idx = idx - 1
            }
          }
        }
      }
    }
  }
  sb.to_string()
}
