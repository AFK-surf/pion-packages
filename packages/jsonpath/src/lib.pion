///| Public API stubs for `packages/jsonpath` (Red phase).

///| Parse a strict RFC 8259 JSON document.
pub fn parse_json(src : String) -> Result[JsonValue, JsonPathError] {
  parse_json_with_limits(src, JsonPathLimits::default())
}

///| Parse a strict RFC 8259 JSON document with explicit resource limits.
pub fn parse_json_with_limits(
  src : String,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  let _ = src
  let _ = limits
  Err(JsonPathError::new(JsonPathErrorKind::JsonError, 0, "not implemented"))
}

///| Serialize a `JsonValue` to canonical compact RFC 8259 JSON.
pub fn to_json_string(value : JsonValue) -> String {
  let _ = value
  ""
}

///| Structural JSON equality (exact Int64/Double numeric equality, order-independent objects).
pub fn json_value_eq(a : JsonValue, b : JsonValue) -> Bool {
  let _ = a
  let _ = b
  false
}

///| Compile an RFC 9535 JSONPath query string.
pub fn JsonPath::parse(query : String) -> Result[JsonPath, JsonPathError] {
  let _ = query
  Err(JsonPathError::new(JsonPathErrorKind::ParseError, 0, "not implemented"))
}

///| Evaluate a compiled JSONPath query against a JSON document with default limits.
pub fn JsonPath::query(
  self : JsonPath,
  root : JsonValue,
) -> Result[Array[JsonValue], JsonPathError] {
  self.query_with_limits(root, JsonPathLimits::default())
}

///| Evaluate a compiled JSONPath query with explicit limits.
pub fn JsonPath::query_with_limits(
  self : JsonPath,
  root : JsonValue,
  limits : JsonPathLimits,
) -> Result[Array[JsonValue], JsonPathError] {
  let _ = self
  let _ = root
  let _ = limits
  Err(JsonPathError::new(JsonPathErrorKind::ParseError, 0, "not implemented"))
}

///| Evaluate a compiled JSONPath query and return values paired with RFC 9535 Normalized Paths.
pub fn JsonPath::query_with_paths(
  self : JsonPath,
  root : JsonValue,
) -> Result[Array[NodeMatch], JsonPathError] {
  self.query_with_paths_limits(root, JsonPathLimits::default())
}

///| Evaluate a compiled JSONPath query with normalized paths and explicit limits.
pub fn JsonPath::query_with_paths_limits(
  self : JsonPath,
  root : JsonValue,
  limits : JsonPathLimits,
) -> Result[Array[NodeMatch], JsonPathError] {
  let _ = self
  let _ = root
  let _ = limits
  Err(JsonPathError::new(JsonPathErrorKind::ParseError, 0, "not implemented"))
}

///| Convenience function: parse and evaluate a JSONPath query.
pub fn query(
  expr : String,
  root : JsonValue,
) -> Result[Array[JsonValue], JsonPathError] {
  match JsonPath::parse(expr) {
    Ok(p) => p.query(root)
    Err(e) => Err(e)
  }
}

///| Convenience function: parse and evaluate a JSONPath query with normalized paths.
pub fn query_with_paths(
  expr : String,
  root : JsonValue,
) -> Result[Array[NodeMatch], JsonPathError] {
  match JsonPath::parse(expr) {
    Ok(p) => p.query_with_paths(root)
    Err(e) => Err(e)
  }
}

///| Parse an RFC 6901 JSON Pointer string.
pub fn JsonPointer::parse(ptr : String) -> Result[JsonPointer, JsonPathError] {
  let _ = ptr
  Err(JsonPathError::new(JsonPathErrorKind::PointerError, 0, "not implemented"))
}

///| Format an RFC 6901 JSON Pointer back to its escaped string form.
pub fn JsonPointer::to_string(self : JsonPointer) -> String {
  let _ = self
  ""
}

///| Escape a single RFC 6901 reference token (`~` -> `~0`, `/` -> `~1`).
pub fn escape_token(token : String) -> String {
  let _ = token
  ""
}

///| Unescape a single RFC 6901 reference token (`~1` -> `/`, `~0` -> `~`).
pub fn unescape_token(token : String) -> Result[String, JsonPathError] {
  let _ = token
  Err(JsonPathError::new(JsonPathErrorKind::PointerError, 0, "not implemented"))
}

///| Resolve an RFC 6901 JSON Pointer against a JSON document.
pub fn JsonPointer::resolve(
  self : JsonPointer,
  doc : JsonValue,
) -> Option[JsonValue] {
  let _ = self
  let _ = doc
  Option::None
}

///| Replace the value at an RFC 6901 JSON Pointer (Copy-on-Write, returns updated document).
pub fn JsonPointer::resolve_mut(
  self : JsonPointer,
  doc : JsonValue,
  new_val : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  let _ = self
  let _ = doc
  let _ = new_val
  Err(JsonPathError::new(JsonPathErrorKind::PointerError, 0, "not implemented"))
}

///| Parse an RFC 6902 JSON Patch document from JSON text.
pub fn parse_patch(src : String) -> Result[JsonPatch, JsonPathError] {
  let _ = src
  Err(JsonPathError::new(JsonPathErrorKind::PatchError, 0, "not implemented"))
}

///| Decode an RFC 6902 `JsonPatch` from a `JsonValue`.
pub fn patch_from_value(value : JsonValue) -> Result[JsonPatch, JsonPathError] {
  let _ = value
  Err(JsonPathError::new(JsonPathErrorKind::PatchError, 0, "not implemented"))
}

///| Encode a `JsonPatch` as a `JsonValue::Array`.
pub fn patch_to_value(patch : JsonPatch) -> JsonValue {
  let _ = patch
  JsonValue::Array([])
}

///| Apply an RFC 6902 JSON Patch atomically with default limits.
pub fn apply_patch(
  doc : JsonValue,
  patch : JsonPatch,
) -> Result[JsonValue, JsonPathError] {
  apply_patch_with_limits(doc, patch, JsonPathLimits::default())
}

///| Apply an RFC 6902 JSON Patch atomically with explicit limits.
pub fn apply_patch_with_limits(
  doc : JsonValue,
  patch : JsonPatch,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  let _ = doc
  let _ = patch
  let _ = limits
  Err(JsonPathError::new(JsonPathErrorKind::PatchError, 0, "not implemented"))
}

///| Compute an RFC 6902 `JsonPatch` transforming `before` into `after`.
pub fn diff_patch(before : JsonValue, after : JsonValue) -> JsonPatch {
  let _ = before
  let _ = after
  JsonPatch::{ ops: [] }
}

///| Apply an RFC 7396 JSON Merge Patch.
pub fn merge_patch(target : JsonValue, patch : JsonValue) -> JsonValue {
  let _ = target
  let _ = patch
  JsonValue::Null
}

///| Apply an RFC 7396 JSON Merge Patch with explicit depth limits.
pub fn merge_patch_with_limits(
  target : JsonValue,
  patch : JsonValue,
  limits : JsonPathLimits,
) -> Result[JsonValue, JsonPathError] {
  let _ = target
  let _ = patch
  let _ = limits
  Err(JsonPathError::new(JsonPathErrorKind::PatchError, 0, "not implemented"))
}
