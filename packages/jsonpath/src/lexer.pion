///| RFC 9535 lexical helpers: strict whitespace, member-name-shorthand,
///| single/double-quoted string literals with surrogate pairs, exact `int`,
///| and filter number literals.

///| RFC 9535 §2.1 blank space `B = %x20 / %x09 / %x0A / %x0D`.
pub fn is_rfc9535_ws(b : Int) -> Bool {
  b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D
}

///| Skip RFC 9535 whitespace starting at `pos`.
pub fn skip_ws(src : String, pos : Int) -> Int {
  let n = src.length()
  let mut i = pos
  while i < n && is_rfc9535_ws(src.code_unit_at(i)) {
    i = i + 1
  }
  i
}

///| Check whether a Unicode codepoint is `name-first` (RFC 9535 §2.5.1.1).
///| `name-first = ALPHA / "_" / %x80-D7FF / %xE000-10FFFF`
pub fn is_name_first(cp : Int) -> Bool {
  (cp >= 65 && cp <= 90) ||
  (cp >= 97 && cp <= 122) ||
  cp == 95 ||
  (cp >= 0x80 && cp <= 0xD7FF) ||
  (cp >= 0xE000 && cp <= 0x10FFFF)
}

///| Check whether a Unicode codepoint is `name-char` (RFC 9535 §2.5.1.1).
///| `name-char = name-first / DIGIT`
pub fn is_name_char(cp : Int) -> Bool {
  is_name_first(cp) || (cp >= 48 && cp <= 57)
}

///| Decode one UTF-8 scalar value at `s[pos]`, returning `(cp, next_pos)` or `(-1, pos)` on invalid UTF-8.
pub fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  if pos >= n {
    return (-1, pos)
  }
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp >= 0x800 && !(cp >= 0xD800 && cp <= 0xDFFF) {
        return (cp, pos + 3)
      }
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x07) << 18) |
      ((b1 & 0x3F) << 12) |
      ((b2 & 0x3F) << 6) |
      (b3 & 0x3F)
      if cp >= 0x10000 && cp <= 0x10FFFF {
        return (cp, pos + 4)
      }
    }
  }
  (-1, pos)
}

///| Scan a `member-name-shorthand` starting at `pos`.
pub fn scan_member_name(
  src : String,
  pos : Int,
) -> Result[(String, Int), JsonPathError] {
  let (cp0, next0) = decode_utf8_at(src, pos)
  if cp0 < 0 || !is_name_first(cp0) {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::ParseError,
        pos,
        "expected member-name-shorthand",
      ),
    )
  }
  let mut i = next0
  let n = src.length()
  while i < n {
    let (cp, next_i) = decode_utf8_at(src, i)
    if cp >= 0 && is_name_char(cp) {
      i = next_i
    } else {
      break
    }
  }
  Ok((src.slice(pos, i), i))
}

///| Parse an RFC 9535 single-quoted or double-quoted `string-literal` at `pos`.
pub fn scan_string_literal(
  src : String,
  pos : Int,
) -> Result[(String, Int), JsonPathError] {
  let n = src.length()
  if pos >= n {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::ParseError,
        pos,
        "expected string literal",
      ),
    )
  }
  let quote = src.code_unit_at(pos)
  if quote != 34 && quote != 39 {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::ParseError,
        pos,
        "expected '\"' or '\\''",
      ),
    )
  }
  let mut i = pos + 1
  // Fast path: no backslash and no control chars
  let mut fast = i
  while fast < n {
    let b = src.code_unit_at(fast)
    if b == quote {
      return Ok((src.slice(i, fast), fast + 1))
    }
    if b == 92 || b < 0x20 {
      break
    }
    fast = fast + 1
  }
  let sb = StringBuilder::new()
  if fast > i {
    sb.write_string(src.slice(i, fast))
    i = fast
  }
  while i < n {
    let b = src.code_unit_at(i)
    if b == quote {
      return Ok((sb.to_string(), i + 1))
    }
    if b < 0x20 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::ParseError,
          i,
          "unescaped control character in string literal",
        ),
      )
    }
    if b == 92 {
      i = i + 1
      if i >= n {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::ParseError,
            i,
            "unterminated escape sequence",
          ),
        )
      }
      let esc = src.code_unit_at(i)
      if esc == quote {
        sb.write_byte(quote.to_byte())
        i = i + 1
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
        i = i + 1
      } else if esc == 47 {
        sb.write_byte((47).to_byte())
        i = i + 1
      } else if esc == 98 {
        sb.write_byte((8).to_byte())
        i = i + 1
      } else if esc == 102 {
        sb.write_byte((12).to_byte())
        i = i + 1
      } else if esc == 110 {
        sb.write_byte((10).to_byte())
        i = i + 1
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
        i = i + 1
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
        i = i + 1
      } else if esc == 117 {
        let u1 = parse_hex4(src, i + 1)
        if u1 < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::ParseError,
              i,
              "invalid \\uXXXX escape",
            ),
          )
        }
        i = i + 5
        if u1 >= 0xD800 && u1 <= 0xDBFF {
          if i + 6 <= n &&
          src.code_unit_at(i) == 92 &&
          src.code_unit_at(i + 1) == 117 {
            let u2 = parse_hex4(src, i + 2)
            if u2 >= 0xDC00 && u2 <= 0xDFFF {
              let cp = 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00)
              write_utf8_cp(sb, cp)
              i = i + 6
            } else {
              return Err(
                JsonPathError::new(
                  JsonPathErrorKind::ParseError,
                  i,
                  "invalid low surrogate",
                ),
              )
            }
          } else {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::ParseError,
                i,
                "unpaired high surrogate",
              ),
            )
          }
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::ParseError,
              i - 5,
              "unpaired low surrogate",
            ),
          )
        } else {
          write_utf8_cp(sb, u1)
        }
      } else {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::ParseError,
            i,
            "invalid escape sequence in string literal",
          ),
        )
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err(
    JsonPathError::new(
      JsonPathErrorKind::ParseError,
      pos,
      "unterminated string literal",
    ),
  )
}

///| Parse an RFC 9535 `int` (`"0" / (["-"] DIGIT1 *DIGIT)`), rejecting `-0`, leading zeros,
///| and values outside I-JSON exact integer range `[-(2^53)+1, (2^53)-1]`.
pub fn scan_rfc9535_int(
  src : String,
  pos : Int,
) -> Result[(Int64, Int), JsonPathError] {
  let n = src.length()
  let mut i = pos
  if i >= n {
    return Err(
      JsonPathError::new(JsonPathErrorKind::ParseError, pos, "expected integer"),
    )
  }
  let mut neg = false
  if src.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
    if i >= n {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::ParseError,
          i,
          "expected digit after '-'",
        ),
      )
    }
    let d0 = src.code_unit_at(i)
    if d0 == 48 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::ParseError,
          pos,
          "-0 is not a valid RFC 9535 index/slice integer",
        ),
      )
    }
    if d0 < 49 || d0 > 57 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::ParseError,
          i,
          "expected non-zero digit after '-'",
        ),
      )
    }
  } else {
    let d0 = src.code_unit_at(i)
    if d0 == 48 {
      if i + 1 < n {
        let d1 = src.code_unit_at(i + 1)
        if d1 >= 48 && d1 <= 57 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::ParseError,
              pos,
              "leading zeros are forbidden in RFC 9535 integers",
            ),
          )
        }
      }
      return Ok((0L, i + 1))
    }
    if d0 < 49 || d0 > 57 {
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::ParseError,
          i,
          "expected integer",
        ),
      )
    }
  }
  let max_safe = 9007199254740991L // 2^53 - 1
  let mut acc = 0L
  while i < n {
    let b = src.code_unit_at(i)
    if b >= 48 && b <= 57 {
      let d = (b - 48).to_int64()
      if acc > (max_safe - d) / 10L {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::ParseError,
            pos,
            "integer outside RFC 9535 safe range [-(2^53)+1, (2^53)-1]",
          ),
        )
      }
      acc = acc * 10L + d
      i = i + 1
    } else {
      break
    }
  }
  Ok((if neg { -acc } else { acc }, i))
}

///| Parse an RFC 9535 filter `number` literal (`(int / "-0") [ frac ] [ exp ]`).
pub fn scan_filter_number(
  src : String,
  pos : Int,
) -> Result[(JsonValue, Int), JsonPathError] {
  parse_json_number(src, pos)
}
