///| RFC 6901 JSON Pointer implementation with strict array index validation
///| and Copy-on-Write mutation helpers.

///| RFC 6901 reference token escape predicate (`~` = 126 or `/` = 47).
pub fn pointer_needs_escape(b : Int) -> Bool {
  b == 126 || b == 47
}

///| RFC 6901 tilde escape decoder (`'0'` -> `'~'`, `'1'` -> `'/'`, else `-1`).
pub fn pointer_unescape_tilde(next : Int) -> Int {
  if next == 48 {
    126
  } else if next == 49 {
    47
  } else {
    -1
  }
}

///| Escape a single RFC 6901 reference token (`~` -> `~0`, `/` -> `~1`).
pub fn escape_token_impl(token : String) -> String {
  let n = token.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if pointer_needs_escape(b) {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return token
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 {
      sb.write_string("~0")
    } else if b == 47 {
      sb.write_string("~1")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Unescape a single RFC 6901 reference token (`~1` -> `/`, `~0` -> `~`).
///| Rejects any `~` not followed by `0` or `1`.
pub fn unescape_token_impl(token : String) -> Result[String, JsonPathError] {
  let n = token.length()
  let mut has_tilde = false
  let mut i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      has_tilde = true
      break
    }
    i = i + 1
  }
  if !has_tilde {
    return Ok(token)
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 {
      if i + 1 >= n {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            i,
            "trailing '~' in JSON Pointer token",
          ),
        )
      }
      let next = token.code_unit_at(i + 1)
      let decoded = pointer_unescape_tilde(next)
      if decoded >= 0 {
        sb.write_byte(decoded.to_byte())
      } else {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            i,
            "invalid '~' escape in JSON Pointer token",
          ),
        )
      }
      i = i + 2
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Parse an RFC 6901 JSON Pointer string directly into an existing token buffer (reusable, zero Array/JsonPointer allocation).
pub fn pointer_parse_into(
  ptr : String,
  tokens : Array[String],
  max_depth : Int,
) -> Option[JsonPathError] {
  while tokens.length() > 0 {
    let _ = tokens.pop()
  }
  let n = ptr.length()
  if n == 0 {
    return Option::None
  }
  if ptr.code_unit_at(0) != 47 {
    return Some(
      JsonPathError::new(
        JsonPathErrorKind::PointerError,
        0,
        "non-empty JSON Pointer must start with '/'",
      ),
    )
  }
  let mut start = 1
  let mut has_tilde = false
  let mut i = 1
  while i < n {
    let b = ptr.code_unit_at(i)
    if b == 47 {
      if tokens.length() >= max_depth {
        return Some(
          JsonPathError::new(
            JsonPathErrorKind::LimitExceeded,
            0,
            "pointer depth exceeds max_depth",
          ),
        )
      }
      let raw = ptr.slice(start, i)
      if has_tilde {
        match unescape_token_impl(raw) {
          Ok(tok) => tokens.push(tok)
          Err(e) => return Some(e)
        }
        has_tilde = false
      } else {
        tokens.push(raw)
      }
      start = i + 1
    } else if b == 126 {
      has_tilde = true
    }
    i = i + 1
  }
  if tokens.length() >= max_depth {
    return Some(
      JsonPathError::new(
        JsonPathErrorKind::LimitExceeded,
        0,
        "pointer depth exceeds max_depth",
      ),
    )
  }
  let raw_last = ptr.slice(start, n)
  if has_tilde {
    match unescape_token_impl(raw_last) {
      Ok(tok) => tokens.push(tok)
      Err(e) => return Some(e)
    }
  } else {
    tokens.push(raw_last)
  }
  Option::None
}

///| Parse an RFC 6901 JSON Pointer string.
pub fn pointer_parse_impl(ptr : String) -> Result[JsonPointer, JsonPathError] {
  let n = ptr.length()
  if n == 0 {
    return Ok(JsonPointer::{ tokens: [] })
  }
  if ptr.code_unit_at(0) != 47 {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PointerError,
        0,
        "non-empty JSON Pointer must start with '/'",
      ),
    )
  }
  let tokens : Array[String] = Array::with_capacity(4)
  let mut start = 1
  let mut has_tilde = false
  let mut i = 1
  while i < n {
    let b = ptr.code_unit_at(i)
    if b == 47 {
      let raw = ptr.slice(start, i)
      if has_tilde {
        match unescape_token_impl(raw) {
          Ok(tok) => tokens.push(tok)
          Err(e) => return Err(e)
        }
        has_tilde = false
      } else {
        tokens.push(raw)
      }
      start = i + 1
    } else if b == 126 {
      has_tilde = true
    }
    i = i + 1
  }
  let raw_last = ptr.slice(start, n)
  if has_tilde {
    match unescape_token_impl(raw_last) {
      Ok(tok) => tokens.push(tok)
      Err(e) => return Err(e)
    }
  } else {
    tokens.push(raw_last)
  }
  Ok(JsonPointer::{ tokens: tokens })
}

///| Format an RFC 6901 `JsonPointer` back to its escaped string form.
pub fn pointer_to_string_impl(ptr : JsonPointer) -> String {
  if ptr.tokens.length() == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ptr.tokens.length() {
    sb.write_byte((47).to_byte())
    sb.write_string(escape_token_impl(ptr.tokens[i]))
    i = i + 1
  }
  sb.to_string()
}

///| Parse a strict RFC 6901 array index (`"0"` or `[1-9][0-9]*`). Returns `-1` if invalid.
pub fn parse_pointer_array_index(token : String) -> Int {
  let n = token.length()
  if n == 0 {
    return -1
  }
  let b0 = token.code_unit_at(0)
  if b0 == 48 {
    return if n == 1 { 0 } else { -1 }
  }
  if b0 < 49 || b0 > 57 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    if acc > 214748364 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

///| Resolve an RFC 6901 `JsonPointer` against `doc`.
pub fn pointer_resolve_impl(ptr : JsonPointer, doc : JsonValue) -> Option[JsonValue] {
  let mut cur = doc
  let mut i = 0
  while i < ptr.tokens.length() {
    let tok = ptr.tokens[i]
    match cur {
      JsonValue::Object(entries) => {
        match json_object_get(entries, tok) {
          Some(v) => cur = v
          None => return Option::None
        }
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Option::None
        }
        cur = items[idx]
      }
      _ => return Option::None
    }
    i = i + 1
  }
  Some(cur)
}

///| Replace an existing value at `ptr` using Copy-on-Write (returns updated document).
pub fn pointer_resolve_mut_impl(
  ptr : JsonPointer,
  doc : JsonValue,
  new_val : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  cow_replace(doc, ptr.tokens, 0, new_val)
}

enum CowFrame {
  Obj(Array[(String, JsonValue)], Int, String)
  Arr(Array[JsonValue], Int)
}

fn cow_rebuild(frames : Array[CowFrame], leaf : JsonValue) -> JsonValue {
  let mut cur = leaf
  while frames.length() > 0 {
    let frame = match frames.pop() {
      Some(f) => f
      None => break
    }
    match frame {
      CowFrame::Obj(entries, found, tok) => {
        let next : Array[(String, JsonValue)] = []
        let mut j = 0
        while j < entries.length() {
          if j == found {
            next.push((tok, cur))
          } else {
            next.push(entries[j])
          }
          j = j + 1
        }
        cur = JsonValue::Object(next)
      }
      CowFrame::Arr(items, idx) => {
        let next : Array[JsonValue] = []
        let mut j = 0
        while j < items.length() {
          if j == idx {
            next.push(cur)
          } else {
            next.push(items[j])
          }
          j = j + 1
        }
        cur = JsonValue::Array(next)
      }
    }
  }
  cur
}

///| Iterative Copy-on-Write helper: replace an existing target at `tokens[depth..]`.
pub fn cow_replace(
  cur_in : JsonValue,
  tokens : Array[String],
  start_depth : Int,
  new_val : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  let total = tokens.length()
  if start_depth >= total {
    return Ok(new_val)
  }
  let frames : Array[CowFrame] = []
  let mut cur = cur_in
  let mut depth = start_depth
  while depth < total {
    let tok = tokens[depth]
    match cur {
      JsonValue::Object(entries) => {
        let mut found = -1
        let mut i = entries.length() - 1
        while i >= 0 {
          let (k, _) = entries[i]
          if k == tok {
            found = i
            break
          }
          i = i - 1
        }
        if found < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PointerError,
              0,
              "target key not found: " + tok,
            ),
          )
        }
        let (_, child) = entries[found]
        frames.push(CowFrame::Obj(entries, found, tok))
        cur = child
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PointerError,
              0,
              "invalid or out-of-bounds array index: " + tok,
            ),
          )
        }
        frames.push(CowFrame::Arr(items, idx))
        cur = items[idx]
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PointerError,
          0,
          "cannot traverse non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  Ok(cow_rebuild(frames, new_val))
}

///| Iterative Copy-on-Write helper: RFC 6902 `add` at `tokens[depth..]`.
pub fn cow_add(
  cur_in : JsonValue,
  tokens : Array[String],
  start_depth : Int,
  val_to_add : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  let total = tokens.length()
  if start_depth >= total {
    return Ok(val_to_add)
  }
  let frames : Array[CowFrame] = []
  let mut cur = cur_in
  let mut depth = start_depth
  while depth + 1 < total {
    let tok = tokens[depth]
    match cur {
      JsonValue::Object(entries) => {
        let mut found = -1
        let mut i = entries.length() - 1
        while i >= 0 {
          let (k, _) = entries[i]
          if k == tok {
            found = i
            break
          }
          i = i - 1
        }
        if found < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "parent object key not found: " + tok,
            ),
          )
        }
        let (_, child) = entries[found]
        frames.push(CowFrame::Obj(entries, found, tok))
        cur = child
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "invalid parent array index: " + tok,
            ),
          )
        }
        frames.push(CowFrame::Arr(items, idx))
        cur = items[idx]
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "cannot add inside non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  let tok = tokens[total - 1]
  let leaf = match cur {
    JsonValue::Object(entries) => {
      let mut found = -1
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, _) = entries[i]
        if k == tok {
          found = i
          break
        }
        i = i - 1
      }
      let next : Array[(String, JsonValue)] = []
      let mut j = 0
      while j < entries.length() {
        if j == found {
          next.push((tok, val_to_add))
        } else {
          next.push(entries[j])
        }
        j = j + 1
      }
      if found < 0 {
        next.push((tok, val_to_add))
      }
      JsonValue::Object(next)
    }
    JsonValue::Array(items) => {
      let n = items.length()
      let insert_idx = if tok == "-" {
        n
      } else {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx > n {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "invalid array add index: " + tok,
            ),
          )
        }
        idx
      }
      let next : Array[JsonValue] = []
      let mut j = 0
      while j < insert_idx {
        next.push(items[j])
        j = j + 1
      }
      next.push(val_to_add)
      while j < n {
        next.push(items[j])
        j = j + 1
      }
      JsonValue::Array(next)
    }
    _ =>
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot add inside non-container at token: " + tok,
      ),
    )
  }
  Ok(cow_rebuild(frames, leaf))
}

///| Iterative Copy-on-Write helper: RFC 6902 `remove` at `tokens[depth..]`, returning `(new_doc, removed_val)`.
pub fn cow_remove(
  cur_in : JsonValue,
  tokens : Array[String],
  start_depth : Int,
) -> Result[(JsonValue, JsonValue), JsonPathError] {
  let total = tokens.length()
  if start_depth >= total {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove root document",
      ),
    )
  }
  let frames : Array[CowFrame] = []
  let mut cur = cur_in
  let mut depth = start_depth
  while depth + 1 < total {
    let tok = tokens[depth]
    match cur {
      JsonValue::Object(entries) => {
        let mut found = -1
        let mut i = entries.length() - 1
        while i >= 0 {
          let (k, _) = entries[i]
          if k == tok {
            found = i
            break
          }
          i = i - 1
        }
        if found < 0 {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "remove target key not found: " + tok,
            ),
          )
        }
        let (_, child) = entries[found]
        frames.push(CowFrame::Obj(entries, found, tok))
        cur = child
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::PatchError,
              0,
              "remove target array index out of bounds: " + tok,
            ),
          )
        }
        frames.push(CowFrame::Arr(items, idx))
        cur = items[idx]
      }
      _ =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::PatchError,
          0,
          "cannot remove inside non-container at token: " + tok,
        ),
      )
    }
    depth = depth + 1
  }
  let tok = tokens[total - 1]
  let (leaf, removed) = match cur {
    JsonValue::Object(entries) => {
      let mut found = -1
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, _) = entries[i]
        if k == tok {
          found = i
          break
        }
        i = i - 1
      }
      if found < 0 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target key not found: " + tok,
          ),
        )
      }
      let (_, target_val) = entries[found]
      let next : Array[(String, JsonValue)] = []
      let mut j = 0
      while j < entries.length() {
        let (ek, _) = entries[j]
        if ek != tok {
          next.push(entries[j])
        }
        j = j + 1
      }
      (JsonValue::Object(next), target_val)
    }
    JsonValue::Array(items) => {
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target array index out of bounds: " + tok,
          ),
        )
      }
      let removed = items[idx]
      let next : Array[JsonValue] = []
      let mut j = 0
      while j < items.length() {
        if j != idx {
          next.push(items[j])
        }
        j = j + 1
      }
      (JsonValue::Array(next), removed)
    }
    _ =>
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove inside non-container at token: " + tok,
      ),
    )
  }
  Ok((cow_rebuild(frames, leaf), removed))
}
