///| RFC 6901 JSON Pointer implementation with strict array index validation
///| and Copy-on-Write mutation helpers.

///| Escape a single RFC 6901 reference token (`~` -> `~0`, `/` -> `~1`).
pub fn escape_token_impl(token : String) -> String {
  let n = token.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 || b == 47 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return token
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 {
      sb.write_string("~0")
    } else if b == 47 {
      sb.write_string("~1")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Unescape a single RFC 6901 reference token (`~1` -> `/`, `~0` -> `~`).
///| Rejects any `~` not followed by `0` or `1`.
pub fn unescape_token_impl(token : String) -> Result[String, JsonPathError] {
  let n = token.length()
  let mut has_tilde = false
  let mut i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      has_tilde = true
      break
    }
    i = i + 1
  }
  if !has_tilde {
    return Ok(token)
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 {
      if i + 1 >= n {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            i,
            "trailing '~' in JSON Pointer token",
          ),
        )
      }
      let next = token.code_unit_at(i + 1)
      if next == 48 {
        sb.write_byte((126).to_byte())
      } else if next == 49 {
        sb.write_byte((47).to_byte())
      } else {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            i,
            "invalid '~' escape in JSON Pointer token",
          ),
        )
      }
      i = i + 2
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Parse an RFC 6901 JSON Pointer string.
pub fn pointer_parse_impl(ptr : String) -> Result[JsonPointer, JsonPathError] {
  let n = ptr.length()
  if n == 0 {
    return Ok(JsonPointer::{ tokens: [] })
  }
  if ptr.code_unit_at(0) != 47 {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PointerError,
        0,
        "non-empty JSON Pointer must start with '/'",
      ),
    )
  }
  let tokens : Array[String] = []
  let mut start = 1
  let mut i = 1
  while i <= n {
    if i == n || ptr.code_unit_at(i) == 47 {
      let raw = ptr.slice(start, i)
      match unescape_token_impl(raw) {
        Ok(tok) => tokens.push(tok)
        Err(e) => return Err(e)
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(JsonPointer::{ tokens: tokens })
}

///| Format an RFC 6901 `JsonPointer` back to its escaped string form.
pub fn pointer_to_string_impl(ptr : JsonPointer) -> String {
  if ptr.tokens.length() == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ptr.tokens.length() {
    sb.write_byte((47).to_byte())
    sb.write_string(escape_token_impl(ptr.tokens[i]))
    i = i + 1
  }
  sb.to_string()
}

///| Parse a strict RFC 6901 array index (`"0"` or `[1-9][0-9]*`). Returns `-1` if invalid.
pub fn parse_pointer_array_index(token : String) -> Int {
  let n = token.length()
  if n == 0 {
    return -1
  }
  let b0 = token.code_unit_at(0)
  if b0 == 48 {
    return if n == 1 { 0 } else { -1 }
  }
  if b0 < 49 || b0 > 57 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    if acc > 214748364 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

///| Resolve an RFC 6901 `JsonPointer` against `doc`.
pub fn pointer_resolve_impl(ptr : JsonPointer, doc : JsonValue) -> Option[JsonValue] {
  let mut cur = doc
  let mut i = 0
  while i < ptr.tokens.length() {
    let tok = ptr.tokens[i]
    match cur {
      JsonValue::Object(entries) => {
        match json_object_get(entries, tok) {
          Some(v) => cur = v
          None => return Option::None
        }
      }
      JsonValue::Array(items) => {
        let idx = parse_pointer_array_index(tok)
        if idx < 0 || idx >= items.length() {
          return Option::None
        }
        cur = items[idx]
      }
      _ => return Option::None
    }
    i = i + 1
  }
  Some(cur)
}

///| Replace an existing value at `ptr` using Copy-on-Write (returns updated document).
pub fn pointer_resolve_mut_impl(
  ptr : JsonPointer,
  doc : JsonValue,
  new_val : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  cow_replace(doc, ptr.tokens, 0, new_val)
}

///| Copy-on-Write helper: replace an existing target at `tokens[depth..]`.
pub fn cow_replace(
  cur : JsonValue,
  tokens : Array[String],
  depth : Int,
  new_val : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  if depth == tokens.length() {
    return Ok(new_val)
  }
  let tok = tokens[depth]
  match cur {
    JsonValue::Object(entries) => {
      let mut found = -1
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, _) = entries[i]
        if k == tok {
          found = i
          break
        }
        i = i - 1
      }
      if found < 0 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            0,
            "target key not found: " + tok,
          ),
        )
      }
      let (_, old_child) = entries[found]
      let updated_child = match cow_replace(old_child, tokens, depth + 1, new_val) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let next : Array[(String, JsonValue)] = []
      let mut j = 0
      while j < entries.length() {
        if j == found {
          next.push((tok, updated_child))
        } else {
          next.push(entries[j])
        }
        j = j + 1
      }
      Ok(JsonValue::Object(next))
    }
    JsonValue::Array(items) => {
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PointerError,
            0,
            "invalid or out-of-bounds array index: " + tok,
          ),
        )
      }
      let updated_child = match cow_replace(items[idx], tokens, depth + 1, new_val) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let next : Array[JsonValue] = []
      let mut j = 0
      while j < items.length() {
        if j == idx {
          next.push(updated_child)
        } else {
          next.push(items[j])
        }
        j = j + 1
      }
      Ok(JsonValue::Array(next))
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PointerError,
        0,
        "cannot traverse non-container at token: " + tok,
      ),
    )
  }
}

///| Copy-on-Write helper: RFC 6902 `add` at `tokens[depth..]`.
pub fn cow_add(
  cur : JsonValue,
  tokens : Array[String],
  depth : Int,
  val_to_add : JsonValue,
) -> Result[JsonValue, JsonPathError] {
  if depth == tokens.length() {
    return Ok(val_to_add)
  }
  let tok = tokens[depth]
  let is_last = depth + 1 == tokens.length()
  match cur {
    JsonValue::Object(entries) => {
      if is_last {
        let mut found = -1
        let mut i = entries.length() - 1
        while i >= 0 {
          let (k, _) = entries[i]
          if k == tok {
            found = i
            break
          }
          i = i - 1
        }
        let next : Array[(String, JsonValue)] = []
        let mut j = 0
        while j < entries.length() {
          if j == found {
            next.push((tok, val_to_add))
          } else {
            next.push(entries[j])
          }
          j = j + 1
        }
        if found < 0 {
          next.push((tok, val_to_add))
        }
        return Ok(JsonValue::Object(next))
      }
      let mut found = -1
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, _) = entries[i]
        if k == tok {
          found = i
          break
        }
        i = i - 1
      }
      if found < 0 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "parent object key not found: " + tok,
          ),
        )
      }
      let (_, old_child) = entries[found]
      let updated_child = match cow_add(old_child, tokens, depth + 1, val_to_add) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let next : Array[(String, JsonValue)] = []
      let mut j = 0
      while j < entries.length() {
        if j == found {
          next.push((tok, updated_child))
        } else {
          next.push(entries[j])
        }
        j = j + 1
      }
      Ok(JsonValue::Object(next))
    }
    JsonValue::Array(items) => {
      if is_last {
        let n = items.length()
        let insert_idx = if tok == "-" {
          n
        } else {
          let idx = parse_pointer_array_index(tok)
          if idx < 0 || idx > n {
            return Err(
              JsonPathError::new(
                JsonPathErrorKind::PatchError,
                0,
                "invalid array add index: " + tok,
              ),
            )
          }
          idx
        }
        let next : Array[JsonValue] = []
        let mut j = 0
        while j < insert_idx {
          next.push(items[j])
          j = j + 1
        }
        next.push(val_to_add)
        while j < n {
          next.push(items[j])
          j = j + 1
        }
        return Ok(JsonValue::Array(next))
      }
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "invalid parent array index: " + tok,
          ),
        )
      }
      let updated_child = match cow_add(items[idx], tokens, depth + 1, val_to_add) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let next : Array[JsonValue] = []
      let mut j = 0
      while j < items.length() {
        if j == idx {
          next.push(updated_child)
        } else {
          next.push(items[j])
        }
        j = j + 1
      }
      Ok(JsonValue::Array(next))
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot add inside non-container at token: " + tok,
      ),
    )
  }
}

///| Copy-on-Write helper: RFC 6902 `remove` at `tokens[depth..]`, returning `(new_doc, removed_val)`.
pub fn cow_remove(
  cur : JsonValue,
  tokens : Array[String],
  depth : Int,
) -> Result[(JsonValue, JsonValue), JsonPathError] {
  if depth >= tokens.length() {
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove root document",
      ),
    )
  }
  let tok = tokens[depth]
  let is_last = depth + 1 == tokens.length()
  match cur {
    JsonValue::Object(entries) => {
      let mut found = -1
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, _) = entries[i]
        if k == tok {
          found = i
          break
        }
        i = i - 1
      }
      if found < 0 {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target key not found: " + tok,
          ),
        )
      }
      let (_, target_val) = entries[found]
      if is_last {
        let next : Array[(String, JsonValue)] = []
        let mut j = 0
        while j < entries.length() {
          let (ek, _) = entries[j]
          if ek != tok {
            next.push(entries[j])
          }
          j = j + 1
        }
        return Ok((JsonValue::Object(next), target_val))
      }
      let (updated_child, removed) = match cow_remove(target_val, tokens, depth + 1) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      let next : Array[(String, JsonValue)] = []
      let mut j = 0
      while j < entries.length() {
        if j == found {
          next.push((tok, updated_child))
        } else {
          next.push(entries[j])
        }
        j = j + 1
      }
      Ok((JsonValue::Object(next), removed))
    }
    JsonValue::Array(items) => {
      let idx = parse_pointer_array_index(tok)
      if idx < 0 || idx >= items.length() {
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::PatchError,
            0,
            "remove target array index out of bounds: " + tok,
          ),
        )
      }
      if is_last {
        let removed = items[idx]
        let next : Array[JsonValue] = []
        let mut j = 0
        while j < items.length() {
          if j != idx {
            next.push(items[j])
          }
          j = j + 1
        }
        return Ok((JsonValue::Array(next), removed))
      }
      let (updated_child, removed) = match cow_remove(items[idx], tokens, depth + 1) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      let next : Array[JsonValue] = []
      let mut j = 0
      while j < items.length() {
        if j == idx {
          next.push(updated_child)
        } else {
          next.push(items[j])
        }
        j = j + 1
      }
      Ok((JsonValue::Array(next), removed))
    }
    _ =>
    Err(
      JsonPathError::new(
        JsonPathErrorKind::PatchError,
        0,
        "cannot remove inside non-container at token: " + tok,
      ),
    )
  }
}
