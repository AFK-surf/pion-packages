///| RFC 9485 I-Regexp validator and translator backed by `packages/regex`.
///|
///| Key RFC 9485 rules enforced:
///| - `.` matches any Unicode scalar value EXCEPT `\r` (U+000D) and `\n` (U+000A).
///| - `^` and `$` outside character classes are literal characters (escaped to `\^`, `\$`).
///| - No anchors (`\b`, `\B`, `\A`, `\z`), no shorthand classes (`\d`, `\w`, `\s`),
///|   no backreferences (`\1`), no lookaround / flags / non-capturing groups (`(?...)`),
///|   no lazy quantifiers (`*?`, `+?`, `??`, `{m,n}?`).
///| - Supports `\p{...}` / `\P{...}` for all RFC 9485 Unicode General Categories
///|   (excluding `Cs` surrogates).

import "regex"

fn is_valid_iregexp_cat(cat : String) -> Bool {
  cat == "L" ||
  cat == "Lu" ||
  cat == "Ll" ||
  cat == "Lt" ||
  cat == "Lm" ||
  cat == "Lo" ||
  cat == "M" ||
  cat == "Mn" ||
  cat == "Mc" ||
  cat == "Me" ||
  cat == "N" ||
  cat == "Nd" ||
  cat == "Nl" ||
  cat == "No" ||
  cat == "P" ||
  cat == "Pc" ||
  cat == "Pd" ||
  cat == "Ps" ||
  cat == "Pe" ||
  cat == "Pi" ||
  cat == "Pf" ||
  cat == "Po" ||
  cat == "Z" ||
  cat == "Zs" ||
  cat == "Zl" ||
  cat == "Zp" ||
  cat == "S" ||
  cat == "Sm" ||
  cat == "Sc" ||
  cat == "Sk" ||
  cat == "So" ||
  cat == "C" ||
  cat == "Cc" ||
  cat == "Cf" ||
  cat == "Co" ||
  cat == "Cn"
}

fn is_single_char_esc(b : Int) -> Bool {
  // \n \r \t \\ \| \. \- \^ \? \* \+ \{ \} \( \) \[ \]
  b == 110 ||
  b == 114 ||
  b == 116 ||
  b == 92 ||
  b == 124 ||
  b == 46 ||
  b == 45 ||
  b == 94 ||
  b == 63 ||
  b == 42 ||
  b == 43 ||
  b == 123 ||
  b == 125 ||
  b == 40 ||
  b == 41 ||
  b == 91 ||
  b == 93
}

///| Validate an RFC 9485 I-Regexp pattern and translate it to a `packages/regex` pattern.
pub fn iregexp_translate(pattern : String) -> Result[String, String] {
  let n = pattern.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut paren_depth = 0
  // Track whether an atom was just parsed so quantifiers are only allowed after atoms
  let mut has_atom = false

  while i < n {
    let b = pattern.code_unit_at(i)
    if b == 40 {
      // '(' - RFC 9485 only allows plain grouping '(', never '(?...'
      if i + 1 < n && pattern.code_unit_at(i + 1) == 63 {
        return Err("I-Regexp forbids (?...) group extensions")
      }
      paren_depth = paren_depth + 1
      sb.write_string("(?:")
      has_atom = false
      i = i + 1
    } else if b == 41 {
      // ')'
      if paren_depth <= 0 {
        return Err("unmatched ')'")
      }
      paren_depth = paren_depth - 1
      sb.write_byte((41).to_byte())
      has_atom = true
      i = i + 1
    } else if b == 124 {
      // '|'
      sb.write_byte((124).to_byte())
      has_atom = false
      i = i + 1
    } else if b == 46 {
      // '.' -> [^\r\n] per RFC 9485 §5
      sb.write_string("[^\\r\\n]")
      has_atom = true
      i = i + 1
    } else if b == 94 || b == 36 {
      // '^' and '$' are literal NormalChars in RFC 9485!
      sb.write_byte((92).to_byte())
      sb.write_byte(b.to_byte())
      has_atom = true
      i = i + 1
    } else if b == 42 || b == 43 || b == 63 {
      // '*', '+', '?' quantifiers
      if !has_atom {
        return Err("quantifier without preceding atom")
      }
      sb.write_byte(b.to_byte())
      has_atom = false
      i = i + 1
    } else if b == 123 {
      // '{m}', '{m,}', '{m,n}'
      if !has_atom {
        return Err("range quantifier without preceding atom")
      }
      let q_start = i
      i = i + 1
      if i >= n || pattern.code_unit_at(i) < 48 || pattern.code_unit_at(i) > 57 {
        return Err("invalid range quantifier")
      }
      let mut min_val = 0
      while i < n && pattern.code_unit_at(i) >= 48 && pattern.code_unit_at(i) <= 57 {
        min_val = min_val * 10 + (pattern.code_unit_at(i) - 48)
        if min_val > 100000 {
          return Err("quantifier too large")
        }
        i = i + 1
      }
      if i < n && pattern.code_unit_at(i) == 44 {
        i = i + 1
        if i < n && pattern.code_unit_at(i) >= 48 && pattern.code_unit_at(i) <= 57 {
          let mut max_val = 0
          while i < n &&
          pattern.code_unit_at(i) >= 48 &&
          pattern.code_unit_at(i) <= 57 {
            max_val = max_val * 10 + (pattern.code_unit_at(i) - 48)
            if max_val > 100000 {
              return Err("quantifier too large")
            }
            i = i + 1
          }
          if max_val < min_val {
            return Err("quantifier max < min")
          }
        }
      }
      if i >= n || pattern.code_unit_at(i) != 125 {
        return Err("unclosed range quantifier")
      }
      i = i + 1
      sb.write_string(pattern.slice(q_start, i))
      has_atom = false
    } else if b == 125 || b == 93 {
      return Err("unescaped '}' or ']'")
    } else if b == 91 {
      // Character class '[...]'
      sb.write_byte((91).to_byte())
      i = i + 1
      if i < n && pattern.code_unit_at(i) == 94 {
        sb.write_byte((94).to_byte())
        i = i + 1
      }
      let mut closed = false
      let mut first = true
      while i < n {
        let cb = pattern.code_unit_at(i)
        if cb == 93 {
          if first {
            return Err("empty character class")
          }
          sb.write_byte((93).to_byte())
          i = i + 1
          closed = true
          break
        }
        if cb == 91 {
          return Err("unescaped '[' in character class")
        }
        first = false
        if cb == 92 {
          i = i + 1
          if i >= n {
            return Err("dangling backslash in character class")
          }
          let esc = pattern.code_unit_at(i)
          if esc == 112 || esc == 80 {
            // \p{...} or \P{...}
            if i + 1 >= n || pattern.code_unit_at(i + 1) != 123 {
              return Err("expected '{' after \\p or \\P")
            }
            let cat_start = i + 2
            let mut cat_end = cat_start
            while cat_end < n && pattern.code_unit_at(cat_end) != 125 {
              cat_end = cat_end + 1
            }
            if cat_end >= n {
              return Err("unclosed \\p{...}")
            }
            let cat = pattern.slice(cat_start, cat_end)
            if !is_valid_iregexp_cat(cat) {
              return Err("invalid I-Regexp Unicode category: " + cat)
            }
            sb.write_byte((92).to_byte())
            sb.write_byte(esc.to_byte())
            sb.write_byte((123).to_byte())
            sb.write_string(cat)
            sb.write_byte((125).to_byte())
            i = cat_end + 1
          } else if is_single_char_esc(esc) {
            sb.write_byte((92).to_byte())
            sb.write_byte(esc.to_byte())
            i = i + 1
          } else {
            return Err("invalid escape in character class")
          }
        } else {
          sb.write_byte(cb.to_byte())
          i = i + 1
        }
      }
      if !closed {
        return Err("unclosed character class")
      }
      has_atom = true
    } else if b == 92 {
      // Escape outside character class
      i = i + 1
      if i >= n {
        return Err("dangling backslash")
      }
      let esc = pattern.code_unit_at(i)
      if esc == 112 || esc == 80 {
        if i + 1 >= n || pattern.code_unit_at(i + 1) != 123 {
          return Err("expected '{' after \\p or \\P")
        }
        let cat_start = i + 2
        let mut cat_end = cat_start
        while cat_end < n && pattern.code_unit_at(cat_end) != 125 {
          cat_end = cat_end + 1
        }
        if cat_end >= n {
          return Err("unclosed \\p{...}")
        }
        let cat = pattern.slice(cat_start, cat_end)
        if !is_valid_iregexp_cat(cat) {
          return Err("invalid I-Regexp Unicode category: " + cat)
        }
        sb.write_byte((92).to_byte())
        sb.write_byte(esc.to_byte())
        sb.write_byte((123).to_byte())
        sb.write_string(cat)
        sb.write_byte((125).to_byte())
        i = cat_end + 1
      } else if is_single_char_esc(esc) {
        sb.write_byte((92).to_byte())
        sb.write_byte(esc.to_byte())
        i = i + 1
      } else {
        return Err("invalid I-Regexp escape")
      }
      has_atom = true
    } else {
      sb.write_byte(b.to_byte())
      has_atom = true
      i = i + 1
    }
  }

  if paren_depth != 0 {
    return Err("unclosed '('")
  }
  Ok(sb.to_string())
}

///| Compile an RFC 9485 I-Regexp for full-string `match()` (implicitly anchored).
pub fn iregexp_compile_match(pattern : String) -> Option[regex::Regex] {
  match iregexp_translate(pattern) {
    Ok(re_pat) => {
      let anchored = "\\A(?:" + re_pat + ")\\z"
      match regex::compile(anchored) {
        Ok(r) => Some(r)
        Err(_) => Option::None
      }
    }
    Err(_) => Option::None
  }
}

///| Compile an RFC 9485 I-Regexp for substring `search()`.
pub fn iregexp_compile_search(pattern : String) -> Option[regex::Regex] {
  match iregexp_translate(pattern) {
    Ok(re_pat) => {
      match regex::compile(re_pat) {
        Ok(r) => Some(r)
        Err(_) => Option::None
      }
    }
    Err(_) => Option::None
  }
}

///| Evaluate RFC 9535 `match(text, pattern)`. Invalid I-Regexp returns `false`.
pub fn iregexp_match(text : String, pattern : String) -> Bool {
  match iregexp_compile_match(pattern) {
    Some(r) => r.is_match(text)
    None => false
  }
}

///| Evaluate RFC 9535 `search(text, pattern)`. Invalid I-Regexp returns `false`.
pub fn iregexp_search(text : String, pattern : String) -> Bool {
  match iregexp_compile_search(pattern) {
    Some(r) => r.is_match(text)
    None => false
  }
}
