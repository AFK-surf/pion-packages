///| Full RFC 9535 JSONPath parser with strict ABNF compliance,
///| static type checking (§2.4), and compile-time I-Regexp precompilation.

import "regex"

struct Parser {
  src : String
  len : Int
  mut pos : Int
  mut depth : Int
}

fn Parser::new(src : String) -> Parser {
  Parser::{ src: src, len: src.length(), pos: 0, depth: 0 }
}

fn Parser::err(self : Parser, kind : JsonPathErrorKind, msg : String) -> JsonPathError {
  JsonPathError::new(kind, self.pos, msg)
}

fn Parser::peek(self : Parser) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn Parser::skip_ws(self : Parser) -> Unit {
  self.pos = skip_ws(self.src, self.pos)
}

fn Parser::enter(self : Parser) -> Result[Unit, JsonPathError] {
  self.depth = self.depth + 1
  if self.depth > 128 {
    return Err(self.err(JsonPathErrorKind::LimitExceeded, "query nesting too deep"))
  }
  Ok(())
}

fn Parser::leave(self : Parser) -> Unit {
  self.depth = self.depth - 1
}

///| Parse a complete RFC 9535 `jsonpath-query = root-identifier segments`.
pub fn parse_jsonpath_impl(query : String) -> Result[JsonPath, JsonPathError] {
  let p = Parser::new(query)
  if p.peek() != 36 {
    return Err(p.err(JsonPathErrorKind::ParseError, "JSONPath query must start with '$'"))
  }
  p.pos = p.pos + 1
  let segs = match p.parse_segments() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if p.pos != p.len {
    return Err(p.err(JsonPathErrorKind::ParseError, "unexpected trailing input in JSONPath query"))
  }
  Ok(JsonPath::{ source: query, segments: segs })
}

fn Parser::parse_segments(self : Parser) -> Result[Array[Segment], JsonPathError] {
  let segs : Array[Segment] = []
  while true {
    let saved = self.pos
    self.skip_ws()
    let b = self.peek()
    if b == 46 {
      // '.' or '..'
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 46 {
        // Descendant segment: '..' immediately followed by bracketed, '*', or member-name-shorthand (NO whitespace!)
        self.pos = self.pos + 2
        let nb = self.peek()
        if nb == 91 {
          let sels = match self.parse_bracketed_selection() {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          segs.push(Segment::Descendant(sels))
        } else if nb == 42 {
          self.pos = self.pos + 1
          segs.push(Segment::Descendant([Selector::Wildcard]))
        } else {
          let (name, next_i) = match scan_member_name(self.src, self.pos) {
            Ok(pair) => pair
            Err(e) => return Err(e)
          }
          self.pos = next_i
          segs.push(Segment::Descendant([Selector::Name(name)]))
        }
      } else {
        // Child dot segment: '.' immediately followed by '*' or member-name-shorthand (NO whitespace!)
        self.pos = self.pos + 1
        let nb = self.peek()
        if nb == 42 {
          self.pos = self.pos + 1
          segs.push(Segment::Child([Selector::Wildcard]))
        } else {
          let (name, next_i) = match scan_member_name(self.src, self.pos) {
            Ok(pair) => pair
            Err(e) => return Err(e)
          }
          self.pos = next_i
          segs.push(Segment::Child([Selector::Name(name)]))
        }
      }
    } else if b == 91 {
      // Child bracketed selection
      let sels = match self.parse_bracketed_selection() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      segs.push(Segment::Child(sels))
    } else {
      // Restore position before whitespace so trailing whitespace is caught at top level!
      self.pos = saved
      break
    }
  }
  Ok(segs)
}

fn Parser::parse_bracketed_selection(
  self : Parser,
) -> Result[Array[Selector], JsonPathError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.peek() != 91 {
    self.leave()
    return Err(self.err(JsonPathErrorKind::ParseError, "expected '['"))
  }
  self.pos = self.pos + 1
  self.skip_ws()
  if self.peek() == 93 {
    self.leave()
    return Err(self.err(JsonPathErrorKind::ParseError, "empty bracketed selection"))
  }
  let sels : Array[Selector] = []
  while true {
    let sel = match self.parse_selector() {
      Ok(s) => s
      Err(e) => {
        self.leave()
        return Err(e)
      }
    }
    sels.push(sel)
    self.skip_ws()
    let b = self.peek()
    if b == 44 {
      self.pos = self.pos + 1
      self.skip_ws()
    } else if b == 93 {
      self.pos = self.pos + 1
      break
    } else {
      self.leave()
      return Err(self.err(JsonPathErrorKind::ParseError, "expected ',' or ']' in bracketed selection"))
    }
  }
  self.leave()
  Ok(sels)
}

fn Parser::parse_selector(self : Parser) -> Result[Selector, JsonPathError] {
  let b = self.peek()
  if b == 34 || b == 39 {
    let (s, next_i) = match scan_string_literal(self.src, self.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    self.pos = next_i
    Ok(Selector::Name(s))
  } else if b == 42 {
    self.pos = self.pos + 1
    Ok(Selector::Wildcard)
  } else if b == 63 {
    // Filter selector: '?' S logical-expr
    self.pos = self.pos + 1
    self.skip_ws()
    let expr = match self.parse_logical_or() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Ok(Selector::Filter(expr))
  } else if b == 58 {
    // Slice starting with ':'
    self.parse_slice_after_start(Option::None)
  } else if b == 45 || (b >= 48 && b <= 57) {
    // Index or slice starting with int
    let (start_val, next_i) = match scan_rfc9535_int(self.src, self.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    self.pos = next_i
    let after_int = self.pos
    self.skip_ws()
    if self.peek() == 58 {
      self.parse_slice_after_start(Some(start_val))
    } else {
      self.pos = after_int
      Ok(Selector::Index(start_val))
    }
  } else {
    Err(self.err(JsonPathErrorKind::ParseError, "unexpected token in selector"))
  }
}

fn Parser::parse_slice_after_start(
  self : Parser,
  start_opt : Option[Int64],
) -> Result[Selector, JsonPathError] {
  // Expect first ':'
  if self.peek() != 58 {
    return Err(self.err(JsonPathErrorKind::ParseError, "expected ':' in slice"))
  }
  self.pos = self.pos + 1
  self.skip_ws()
  let mut end_opt : Option[Int64] = Option::None
  let b = self.peek()
  if b == 45 || (b >= 48 && b <= 57) {
    let (ev, next_i) = match scan_rfc9535_int(self.src, self.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    end_opt = Some(ev)
    self.pos = next_i
    self.skip_ws()
  }
  let mut step_opt : Option[Int64] = Option::None
  if self.peek() == 58 {
    self.pos = self.pos + 1
    self.skip_ws()
    let sb = self.peek()
    if sb == 45 || (sb >= 48 && sb <= 57) {
      let (sv, next_i) = match scan_rfc9535_int(self.src, self.pos) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      step_opt = Some(sv)
      self.pos = next_i
    }
  }
  Ok(Selector::Slice(start_opt, end_opt, step_opt))
}

// ============================================================================
// Filter Logical Expressions & Static Type Checking (RFC 9535 §2.3.5, §2.4)
// ============================================================================

fn Parser::parse_logical_or(self : Parser) -> Result[FilterExpr, JsonPathError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let first = match self.parse_logical_and() {
    Ok(e) => e
    Err(e) => {
      self.leave()
      return Err(e)
    }
  }
  let mut items : Array[FilterExpr] = []
  while true {
    let saved = self.pos
    self.skip_ws()
    if self.pos + 1 < self.len &&
    self.src.code_unit_at(self.pos) == 124 &&
    self.src.code_unit_at(self.pos + 1) == 124 {
      if items.length() == 0 {
        items.push(first)
      }
      self.pos = self.pos + 2
      self.skip_ws()
      let rhs = match self.parse_logical_and() {
        Ok(e) => e
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
      items.push(rhs)
    } else {
      self.pos = saved
      break
    }
  }
  self.leave()
  if items.length() == 0 {
    Ok(first)
  } else {
    Ok(FilterExpr::Or(items))
  }
}

fn Parser::parse_logical_and(self : Parser) -> Result[FilterExpr, JsonPathError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let first = match self.parse_basic_expr() {
    Ok(e) => e
    Err(e) => {
      self.leave()
      return Err(e)
    }
  }
  let mut items : Array[FilterExpr] = []
  while true {
    let saved = self.pos
    self.skip_ws()
    if self.pos + 1 < self.len &&
    self.src.code_unit_at(self.pos) == 38 &&
    self.src.code_unit_at(self.pos + 1) == 38 {
      if items.length() == 0 {
        items.push(first)
      }
      self.pos = self.pos + 2
      self.skip_ws()
      let rhs = match self.parse_basic_expr() {
        Ok(e) => e
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
      items.push(rhs)
    } else {
      self.pos = saved
      break
    }
  }
  self.leave()
  if items.length() == 0 {
    Ok(first)
  } else {
    Ok(FilterExpr::And(items))
  }
}

fn Parser::peek_comp_op(self : Parser) -> Option[(CompOp, Int)] {
  let i = skip_ws(self.src, self.pos)
  if i >= self.len {
    return Option::None
  }
  let b0 = self.src.code_unit_at(i)
  let b1 = if i + 1 < self.len { self.src.code_unit_at(i + 1) } else { -1 }
  if b0 == 61 && b1 == 61 {
    return Some((CompOp::Eq, i + 2))
  }
  if b0 == 33 && b1 == 61 {
    return Some((CompOp::Ne, i + 2))
  }
  if b0 == 60 && b1 == 61 {
    return Some((CompOp::Le, i + 2))
  }
  if b0 == 62 && b1 == 61 {
    return Some((CompOp::Ge, i + 2))
  }
  if b0 == 60 {
    return Some((CompOp::Lt, i + 1))
  }
  if b0 == 62 {
    return Some((CompOp::Gt, i + 1))
  }
  Option::None
}

fn segments_to_singular(segs : Array[Segment]) -> Option[Array[SingularSeg]] {
  let out : Array[SingularSeg] = []
  let mut i = 0
  while i < segs.length() {
    match segs[i] {
      Segment::Child(sels) => {
        if sels.length() != 1 {
          return Option::None
        }
        match sels[0] {
          Selector::Name(name) => out.push(SingularSeg::Name(name))
          Selector::Index(idx) => out.push(SingularSeg::Index(idx))
          _ => return Option::None
        }
      }
      Segment::Descendant(_) => return Option::None
    }
    i = i + 1
  }
  Some(out)
}

fn Parser::parse_basic_expr(self : Parser) -> Result[FilterExpr, JsonPathError] {
  let b = self.peek()
  // 1. Negated paren-expr or negated test-expr: '!' S ( '(' ... ')' | test-expr )
  // NOTE: RFC 9535 forbids `!a == b`! After `!` only paren-expr or test-expr is allowed.
  if b == 33 {
    self.pos = self.pos + 1
    self.skip_ws()
    if self.peek() == 40 {
      self.pos = self.pos + 1
      self.skip_ws()
      let inner = match self.parse_logical_or() {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      self.skip_ws()
      if self.peek() != 41 {
        return Err(self.err(JsonPathErrorKind::ParseError, "expected ')'"))
      }
      self.pos = self.pos + 1
      return Ok(FilterExpr::Not(inner))
    }
    let inner = match self.parse_test_expr_only() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    // Check that no comparison operator follows `!test-expr` (RFC 9535 forbids `!@.a == 1`)
    match self.peek_comp_op() {
      Some(_) =>
      return Err(
        self.err(
          JsonPathErrorKind::ParseError,
          "comparison operator cannot follow '!' without parentheses",
        ),
      )
      None => ()
    }
    return Ok(FilterExpr::Not(inner))
  }

  // 2. Parenthesized logical-expr: '(' S logical-expr S ')'
  if b == 40 {
    self.pos = self.pos + 1
    self.skip_ws()
    let inner = match self.parse_logical_or() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.peek() != 41 {
      return Err(self.err(JsonPathErrorKind::ParseError, "expected ')'"))
    }
    self.pos = self.pos + 1
    // RFC 9535 forbids `(@.a) == 1`: paren-expr cannot be a comparable
    match self.peek_comp_op() {
      Some(_) =>
      return Err(
        self.err(
          JsonPathErrorKind::ParseError,
          "parenthesized expression cannot be used as a comparison operand",
        ),
      )
      None => ()
    }
    return Ok(inner)
  }

  // 3. Query starting with '@' or '$' -> could be test-expr OR lhs of comparison-expr
  if b == 64 || b == 36 {
    let is_rel = b == 64
    let start_pos = self.pos
    self.pos = self.pos + 1
    let segs = match self.parse_segments() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match self.peek_comp_op() {
      Some((op, next_pos)) => {
        // Must be a singular query!
        let sing = match segments_to_singular(segs) {
          Some(ss) => ss
          None =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              start_pos,
              "non-singular query cannot be used in comparison",
            ),
          )
        }
        self.pos = next_pos
        self.skip_ws()
        let rhs = match self.parse_comparable() {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        return Ok(FilterExpr::Comparison(Comparable::SingularQuery(is_rel, sing), op, rhs))
      }
      None => return Ok(FilterExpr::TestQuery(is_rel, segs))
    }
  }

  // 4. Function call (lowercase ASCII letter followed eventually by '(')
  if self.is_func_call_ahead() {
    let start_pos = self.pos
    let fn_expr = match self.parse_func_expr() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    match self.peek_comp_op() {
      Some((op, next_pos)) => {
        // Function in comparison MUST return ValueType!
        match fn_expr.ret_type {
          ExprType::ValueType => ()
          _ =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              start_pos,
              "function '" + fn_expr.name + "' does not return ValueType and cannot be compared",
            ),
          )
        }
        self.pos = next_pos
        self.skip_ws()
        let rhs = match self.parse_comparable() {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        return Ok(FilterExpr::Comparison(Comparable::FuncCall(fn_expr), op, rhs))
      }
      None => {
        // Function as test-expr MUST return LogicalType or NodesType (NOT ValueType!)
        match fn_expr.ret_type {
          ExprType::LogicalType | ExprType::NodesType => ()
          ExprType::ValueType =>
          return Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              start_pos,
              "function '" + fn_expr.name + "' returns ValueType and cannot be used as a test expression",
            ),
          )
        }
        return Ok(FilterExpr::TestFunc(fn_expr))
      }
    }
  }

  // 5. Literal on LHS of comparison (must be followed by a comparison operator!)
  let lhs = match self.parse_literal() {
    Ok(lit) => Comparable::Literal(lit)
    Err(e) => return Err(e)
  }
  match self.peek_comp_op() {
    Some((op, next_pos)) => {
      self.pos = next_pos
      self.skip_ws()
      let rhs = match self.parse_comparable() {
        Ok(c) => c
        Err(e) => return Err(e)
      }
      Ok(FilterExpr::Comparison(lhs, op, rhs))
    }
    None =>
    Err(
      self.err(
        JsonPathErrorKind::ParseError,
        "literal cannot be used as a test expression without comparison",
      ),
    )
  }
}

fn Parser::parse_test_expr_only(self : Parser) -> Result[FilterExpr, JsonPathError] {
  let b = self.peek()
  if b == 64 || b == 36 {
    let is_rel = b == 64
    self.pos = self.pos + 1
    let segs = match self.parse_segments() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    return Ok(FilterExpr::TestQuery(is_rel, segs))
  }
  if self.is_func_call_ahead() {
    let start_pos = self.pos
    let fn_expr = match self.parse_func_expr() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    match fn_expr.ret_type {
      ExprType::LogicalType | ExprType::NodesType => return Ok(FilterExpr::TestFunc(fn_expr))
      ExprType::ValueType =>
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::TypeError,
          start_pos,
          "function '" + fn_expr.name + "' returns ValueType and cannot be used as a test expression",
        ),
      )
    }
  }
  Err(self.err(JsonPathErrorKind::ParseError, "expected test expression"))
}

fn Parser::parse_comparable(self : Parser) -> Result[Comparable, JsonPathError] {
  let b = self.peek()
  if b == 64 || b == 36 {
    let is_rel = b == 64
    let start_pos = self.pos
    self.pos = self.pos + 1
    let segs = match self.parse_segments() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match segments_to_singular(segs) {
      Some(ss) => Ok(Comparable::SingularQuery(is_rel, ss))
      None =>
      Err(
        JsonPathError::new(
          JsonPathErrorKind::TypeError,
          start_pos,
          "non-singular query cannot be used as a comparison operand",
        ),
      )
    }
  } else if self.is_func_call_ahead() {
    let start_pos = self.pos
    let fn_expr = match self.parse_func_expr() {
      Ok(f) => f
      Err(e) => return Err(e)
    }
    match fn_expr.ret_type {
      ExprType::ValueType => Ok(Comparable::FuncCall(fn_expr))
      _ =>
      Err(
        JsonPathError::new(
          JsonPathErrorKind::TypeError,
          start_pos,
          "function '" + fn_expr.name + "' does not return ValueType",
        ),
      )
    }
  } else {
    match self.parse_literal() {
      Ok(lit) => Ok(Comparable::Literal(lit))
      Err(e) => Err(e)
    }
  }
}

fn Parser::parse_literal(self : Parser) -> Result[JsonValue, JsonPathError] {
  let b = self.peek()
  if b == 34 || b == 39 {
    let (s, next_i) = match scan_string_literal(self.src, self.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    self.pos = next_i
    Ok(JsonValue::Str(s))
  } else if b == 45 || (b >= 48 && b <= 57) {
    let (num, next_i) = match scan_filter_number(self.src, self.pos) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    self.pos = next_i
    Ok(num)
  } else if self.pos + 4 <= self.len &&
  self.src.slice(self.pos, self.pos + 4) == "true" &&
  !self.is_ident_cont_at(self.pos + 4) {
    self.pos = self.pos + 4
    Ok(JsonValue::Bool(true))
  } else if self.pos + 5 <= self.len &&
  self.src.slice(self.pos, self.pos + 5) == "false" &&
  !self.is_ident_cont_at(self.pos + 5) {
    self.pos = self.pos + 5
    Ok(JsonValue::Bool(false))
  } else if self.pos + 4 <= self.len &&
  self.src.slice(self.pos, self.pos + 4) == "null" &&
  !self.is_ident_cont_at(self.pos + 4) {
    self.pos = self.pos + 4
    Ok(JsonValue::Null)
  } else {
    Err(self.err(JsonPathErrorKind::ParseError, "expected literal"))
  }
}

fn Parser::is_ident_cont_at(self : Parser, idx : Int) -> Bool {
  if idx >= self.len {
    return false
  }
  let b = self.src.code_unit_at(idx)
  (b >= 97 && b <= 122) ||
  (b >= 65 && b <= 90) ||
  (b >= 48 && b <= 57) ||
  b == 95
}

fn Parser::is_func_call_ahead(self : Parser) -> Bool {
  let b = self.peek()
  // RFC 9535 §2.4: function-name = function-name-first *function-name-char
  // function-name-first = LCALPHA (a..z)
  if b < 97 || b > 122 {
    return false
  }
  let mut i = self.pos + 1
  while i < self.len {
    let c = self.src.code_unit_at(i)
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      i = i + 1
    } else {
      return c == 40
    }
  }
  false
}

fn func_signature(name : String) -> Option[(Array[ExprType], ExprType)] {
  if name == "length" {
    Some(([ExprType::ValueType], ExprType::ValueType))
  } else if name == "count" {
    Some(([ExprType::NodesType], ExprType::ValueType))
  } else if name == "value" {
    Some(([ExprType::NodesType], ExprType::ValueType))
  } else if name == "match" {
    Some(([ExprType::ValueType, ExprType::ValueType], ExprType::LogicalType))
  } else if name == "search" {
    Some(([ExprType::ValueType, ExprType::ValueType], ExprType::LogicalType))
  } else {
    Option::None
  }
}

fn Parser::parse_func_expr(self : Parser) -> Result[FuncExpr, JsonPathError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name_start = self.pos
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  let name = self.src.slice(name_start, self.pos)
  // RFC 9535 §2.4: NO whitespace between function name and '('!
  if self.peek() != 40 {
    self.leave()
    return Err(self.err(JsonPathErrorKind::ParseError, "expected '(' immediately after function name"))
  }
  self.pos = self.pos + 1
  self.skip_ws()

  let (param_types, ret_type) = match func_signature(name) {
    Some(sig) => sig
    None => {
      self.leave()
      return Err(
        JsonPathError::new(
          JsonPathErrorKind::TypeError,
          name_start,
          "unknown function extension: " + name,
        ),
      )
    }
  }

  let args : Array[FuncArg] = []
  if self.peek() != 41 {
    while true {
      let arg_idx = args.length()
      if arg_idx >= param_types.length() {
        self.leave()
        return Err(
          JsonPathError::new(
            JsonPathErrorKind::TypeError,
            self.pos,
            "too many arguments for function '" + name + "'",
          ),
        )
      }
      let expected_ty = param_types[arg_idx]
      let arg = match self.parse_func_arg(expected_ty, name) {
        Ok(a) => a
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
      args.push(arg)
      self.skip_ws()
      let sep = self.peek()
      if sep == 44 {
        self.pos = self.pos + 1
        self.skip_ws()
      } else if sep == 41 {
        break
      } else {
        self.leave()
        return Err(self.err(JsonPathErrorKind::ParseError, "expected ',' or ')' in function call"))
      }
    }
  }
  if self.peek() != 41 {
    self.leave()
    return Err(self.err(JsonPathErrorKind::ParseError, "expected ')' after function arguments"))
  }
  self.pos = self.pos + 1
  if args.length() != param_types.length() {
    self.leave()
    return Err(
      JsonPathError::new(
        JsonPathErrorKind::TypeError,
        name_start,
        "wrong number of arguments for function '" + name + "'",
      ),
    )
  }
  self.leave()

  // Pre-compile constant I-Regexp pattern for match() / search()!
  let mut compiled_regex : Option[regex::Regex] = Option::None
  let mut has_const_regex = false
  if (name == "match" || name == "search") && args.length() == 2 {
    match args[1] {
      FuncArg::Literal(JsonValue::Str(pat)) => {
        has_const_regex = true
        compiled_regex = if name == "match" {
          iregexp_compile_match(pat)
        } else {
          iregexp_compile_search(pat)
        }
      }
      _ => ()
    }
  }

  Ok(
    FuncExpr::{
      name: name,
      ret_type: ret_type,
      args: args,
      compiled_regex: compiled_regex,
      has_const_regex: has_const_regex,
    },
  )
}

fn Parser::parse_func_arg(
  self : Parser,
  expected_ty : ExprType,
  fn_name : String,
) -> Result[FuncArg, JsonPathError] {
  let arg_pos = self.pos
  match expected_ty {
    ExprType::ValueType => {
      // Accepts: literal, singular-query, or ValueType-returning function
      let b = self.peek()
      if b == 64 || b == 36 {
        let is_rel = b == 64
        self.pos = self.pos + 1
        let segs = match self.parse_segments() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        match segments_to_singular(segs) {
          Some(_) => Ok(FuncArg::FilterQuery(is_rel, segs))
          None =>
          Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              arg_pos,
              "function '" + fn_name + "' expects ValueType (singular query), got non-singular query",
            ),
          )
        }
      } else if self.is_func_call_ahead() {
        let sub = match self.parse_func_expr() {
          Ok(f) => f
          Err(e) => return Err(e)
        }
        match sub.ret_type {
          ExprType::ValueType => Ok(FuncArg::FuncCall(sub))
          _ =>
          Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              arg_pos,
              "function '" + sub.name + "' does not return ValueType",
            ),
          )
        }
      } else {
        match self.parse_literal() {
          Ok(lit) => Ok(FuncArg::Literal(lit))
          Err(e) => Err(e)
        }
      }
    }
    ExprType::NodesType => {
      // Accepts: filter-query (singular or non-singular), or NodesType-returning function
      let b = self.peek()
      if b == 64 || b == 36 {
        let is_rel = b == 64
        self.pos = self.pos + 1
        let segs = match self.parse_segments() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        Ok(FuncArg::FilterQuery(is_rel, segs))
      } else if self.is_func_call_ahead() {
        let sub = match self.parse_func_expr() {
          Ok(f) => f
          Err(e) => return Err(e)
        }
        match sub.ret_type {
          ExprType::NodesType => Ok(FuncArg::FuncCall(sub))
          _ =>
          Err(
            JsonPathError::new(
              JsonPathErrorKind::TypeError,
              arg_pos,
              "function '" + sub.name + "' does not return NodesType",
            ),
          )
        }
      } else {
        Err(
          JsonPathError::new(
            JsonPathErrorKind::TypeError,
            arg_pos,
            "function '" + fn_name + "' expects NodesType query argument",
          ),
        )
      }
    }
    ExprType::LogicalType => {
      let expr = match self.parse_logical_or() {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      Ok(FuncArg::LogicalExpr(expr))
    }
  }
}
