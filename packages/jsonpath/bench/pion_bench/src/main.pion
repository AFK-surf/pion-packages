///| Head-to-head benchmark driver for `packages/jsonpath` (W1, W2, W3).

import "jsonpath"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if src.code_unit_at(i) == 10 {
      if i > start {
        out.push(src.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(src.slice(start, n))
  }
  out
}

fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn fnv1a_int(seed : Int64, v : Int64) -> Int64 {
  ((seed ^ (v & 0xFFFFFFFFL)) * 16777619L) & 0xFFFFFFFFL
}

fn run_w1(world : World, doc_path : String, q_path : String, iters : Int) -> Int {
  let doc_src = match fs_read(world, doc_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let q_src = match fs_read(world, q_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let doc = match jsonpath::parse_json(doc_src) {
    Ok(v) => v
    Err(_) => return 1
  }
  let queries = split_lines(q_src)
  let mut total_matches = 0L
  let mut checksum = 2166136261L
  let mut it = 0
  while it < iters {
    let mut qi = 0
    while qi < queries.length() {
      let jp = match jsonpath::JsonPath::parse(queries[qi]) {
        Ok(p) => p
        Err(_) => return 1
      }
      let ms = match jp.query_with_paths(doc) {
        Ok(r) => r
        Err(_) => return 1
      }
      total_matches = total_matches + ms.length().to_int64()
      let mut mi = 0
      while mi < ms.length() {
        checksum = fnv1a_str(checksum, ms[mi].path)
        mi = mi + 1
      }
      qi = qi + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "w1 matches=" + total_matches.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_w2(world : World, doc_path : String, q_path : String, iters : Int) -> Int {
  let doc_src = match fs_read(world, doc_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let q_src = match fs_read(world, q_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let doc = match jsonpath::parse_json(doc_src) {
    Ok(v) => v
    Err(_) => return 1
  }
  let q_lines = split_lines(q_src)
  let compiled : Array[jsonpath::JsonPath] = []
  let mut qi = 0
  while qi < q_lines.length() {
    match jsonpath::JsonPath::parse(q_lines[qi]) {
      Ok(p) => compiled.push(p)
      Err(_) => return 1
    }
    qi = qi + 1
  }
  let mut total_matches = 0L
  let mut checksum = 2166136261L
  let mut it = 0
  while it < iters {
    let mut k = 0
    while k < compiled.length() {
      let res = match compiled[k].query(doc) {
        Ok(r) => r
        Err(_) => return 1
      }
      let n = res.length().to_int64()
      total_matches = total_matches + n
      checksum = fnv1a_int(checksum, n)
      k = k + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "w2 matches=" + total_matches.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_w3(world : World, pairs_path : String, iters : Int) -> Int {
  let src = match fs_read(world, pairs_path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let lines = split_lines(src)
  let befores : Array[jsonpath::JsonValue] = []
  let afters : Array[jsonpath::JsonValue] = []
  let mpatches : Array[jsonpath::JsonValue] = []
  let mut i = 0
  while i < lines.length() {
    let rec = match jsonpath::parse_json(lines[i]) {
      Ok(v) => v
      Err(_) => return 1
    }
    let b_ptr = match jsonpath::JsonPointer::parse("/before") {
      Ok(p) => p
      Err(_) => return 1
    }
    let a_ptr = match jsonpath::JsonPointer::parse("/after") {
      Ok(p) => p
      Err(_) => return 1
    }
    let m_ptr = match jsonpath::JsonPointer::parse("/mpatch") {
      Ok(p) => p
      Err(_) => return 1
    }
    match (b_ptr.resolve(rec), a_ptr.resolve(rec), m_ptr.resolve(rec)) {
      (Some(b), Some(a), Some(m)) => {
        befores.push(b)
        afters.push(a)
        mpatches.push(m)
      }
      _ => return 1
    }
    i = i + 1
  }

  let p_rev = match jsonpath::JsonPointer::parse("/meta/rev") {
    Ok(p) => p
    Err(_) => return 1
  }
  let p_extra = match jsonpath::JsonPointer::parse("/extra") {
    Ok(p) => p
    Err(_) => return 1
  }
  let p_tag = match jsonpath::JsonPointer::parse("/meta/tag") {
    Ok(p) => p
    Err(_) => return 1
  }

  let mut ok_count = 0L
  let mut checksum = 2166136261L
  let mut it = 0
  while it < iters {
    let mut k = 0
    while k < befores.length() {
      let diff = jsonpath::diff_patch(befores[k], afters[k])
      let patched = match jsonpath::apply_patch(befores[k], diff) {
        Ok(v) => v
        Err(_) => return 1
      }
      if !jsonpath::json_value_eq(patched, afters[k]) {
        return 1
      }
      let merged = jsonpath::merge_patch(patched, mpatches[k])
      let rev = match p_rev.resolve(merged) {
        Some(jsonpath::JsonValue::Int(x)) => x
        _ => -1L
      }
      let extra = match p_extra.resolve(merged) {
        Some(jsonpath::JsonValue::Int(x)) => x
        _ => -1L
      }
      let tag_absent = match p_tag.resolve(merged) {
        None => 1L
        Some(_) => 0L
      }
      ok_count = ok_count + 1L
      checksum = fnv1a_int(checksum, rev)
      checksum = fnv1a_int(checksum, extra)
      checksum = fnv1a_int(checksum, tag_absent)
      k = k + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "w3 ok=" + ok_count.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_jsonpath w1 <doc> <queries> <iters> | w2 <doc> <queries> <iters> | w3 <pairs> <iters>")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    run_w1(world, args[2], args[3], parse_int_arg(args[4], 1))
  } else if mode == "w2" {
    run_w2(world, args[2], args[3], parse_int_arg(args[4], 1))
  } else if mode == "w3" {
    run_w3(world, args[2], parse_int_arg(args[3], 1))
  } else {
    1
  }
}
