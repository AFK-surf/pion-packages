///| Wasm32 + Native 4-mode smoke entry for `packages/jsonpath`.

import "jsonpath"

///|
pub fn smoke() -> Int {
  // 1. RFC 9535 JSONPath: descendant + filter + length() + match() + slice + normalized paths
  let doc_str = "{\"items\":[{\"name\":\"api-gw\",\"replicas\":3,\"tags\":[\"prod\",\"v2\"]},{\"name\":\"worker\",\"replicas\":1,\"tags\":[\"dev\"]},{\"name\":\"auth-svc\",\"replicas\":2,\"tags\":[\"prod\",\"😀\"]}],\"meta\":{\"region\":\"ap-northeast-1\"}}"
  let doc = match jsonpath::parse_json(doc_str) {
    Ok(v) => v
    Err(_) => return -1
  }
  let q = match jsonpath::JsonPath::parse("$.items[?@.replicas >= 2 && match(@.name, \"[a-z]+-[a-z]+\")].tags[0:2]") {
    Ok(p) => p
    Err(_) => return -2
  }
  let matches = match q.query_with_paths(doc) {
    Ok(ms) => ms
    Err(_) => return -3
  }
  if matches.length() != 4 {
    return -4
  }
  if matches[0].path != "$['items'][0]['tags'][0]" || matches[3].path != "$['items'][2]['tags'][1]" {
    return -5
  }
  // Unicode scalar value length check
  let q_len = match jsonpath::JsonPath::parse("$..tags[?length(@) == 1]") {
    Ok(p) => p
    Err(_) => return -6
  }
  let len_res = match q_len.query(doc) {
    Ok(r) => r
    Err(_) => return -7
  }
  if len_res.length() != 1 {
    return -8
  }

  // 2. RFC 6901 Pointer + RFC 6902 diff_patch & apply_patch + RFC 7396 merge_patch
  let ptr = match jsonpath::JsonPointer::parse("/meta/region") {
    Ok(p) => p
    Err(_) => return -9
  }
  let updated = match ptr.resolve_mut(doc, jsonpath::JsonValue::Str("us-west-2")) {
    Ok(v) => v
    Err(_) => return -10
  }
  let diff = jsonpath::diff_patch(doc, updated)
  let patched = match jsonpath::apply_patch(doc, diff) {
    Ok(v) => v
    Err(_) => return -11
  }
  if !jsonpath::json_value_eq(patched, updated) {
    return -12
  }
  let mpatch = match jsonpath::parse_json("{\"meta\":{\"region\":null,\"zone\":\"a\"}}") {
    Ok(v) => v
    Err(_) => return -13
  }
  let merged = jsonpath::merge_patch(patched, mpatch)
  let zone_ptr = match jsonpath::JsonPointer::parse("/meta/zone") {
    Ok(p) => p
    Err(_) => return -14
  }
  match zone_ptr.resolve(merged) {
    Some(jsonpath::JsonValue::Str(z)) => {
      if z != "a" {
        return -15
      }
    }
    _ => return -16
  }

  // 3. Deep nesting stack safety in Wasm32 (depth 2000, iterative, 0 trap)
  let mut deep = jsonpath::JsonValue::Int(7L)
  let mut i = 0
  while i < 2000 {
    deep = jsonpath::JsonValue::Array([deep])
    i = i + 1
  }
  let limits = jsonpath::JsonPathLimits::{
    max_depth: 2500,
    max_nodes_visited: 100000,
    max_results: 5000,
    max_patch_ops: 1000,
  }
  let q_deep = match jsonpath::JsonPath::parse("$..*") {
    Ok(p) => p
    Err(_) => return -17
  }
  let deep_res = match q_deep.query_with_limits(deep, limits) {
    Ok(r) => r
    Err(_) => return -18
  }
  if deep_res.length() != 2000 {
    return -19
  }
  matches.length() + diff.ops.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "jsonpath_wasm_smoke: OK score=" + r.to_string())
    0
  } else {
    io_println(world, "jsonpath_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
