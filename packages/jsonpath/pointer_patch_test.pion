///| RFC 6901 JSON Pointer, RFC 6902 JSON Patch (atomic + diff_patch),
///| and RFC 7396 JSON Merge Patch compliance tests.

fn p_json(s : String) -> JsonValue {
  match parse_json(s) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_json failed: " + e.message)
      JsonValue::Null
    }
  }
}

///|
test "rfc6901_json_pointer_compliance" {
  // RFC 6901 §5 official document
  let doc = p_json("{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}")

  let cases : Array[(String, String)] = [
    ("", "{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}"),
    ("/foo", "[\"bar\",\"baz\"]"),
    ("/foo/0", "\"bar\""),
    ("/", "0"),
    ("/a~1b", "1"),
    ("/c%d", "2"),
    ("/e^f", "3"),
    ("/g|h", "4"),
    ("/i\\j", "5"),
    ("/k\"l", "6"),
    ("/ ", "7"),
    ("/m~0n", "8"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (ptr_str, exp_str) = cases[i]
    let ptr = match JsonPointer::parse(ptr_str) {
      Ok(p) => p
      Err(e) => {
        debug_assert(false, "pointer parse failed for " + ptr_str + ": " + e.message)
        return
      }
    }
    debug_assert(ptr.to_string() == ptr_str, "pointer round-trip mismatch: " + ptr_str)
    let got = match ptr.resolve(doc) {
      Some(v) => v
      None => {
        debug_assert(false, "pointer resolve None for " + ptr_str)
        return
      }
    }
    debug_assert(json_value_eq(got, p_json(exp_str)), "pointer value mismatch for " + ptr_str)
    i = i + 1
  }

  // ~01 unescapes to ~1 (NOT /)
  let tok = match unescape_token("~01") {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(tok == "~1", "~01 must unescape to ~1")
  debug_assert(escape_token("a/b~c") == "a~1b~0c", "escape_token")

  // Invalid pointers & strict array index rules
  debug_assert(
    match JsonPointer::parse("foo") {
      Err(_) => true
      Ok(_) => false
    },
    "missing leading slash rejected",
  )
  debug_assert(
    match JsonPointer::parse("/~2") {
      Err(_) => true
      Ok(_) => false
    },
    "invalid escape ~2 rejected",
  )
  debug_assert(
    match JsonPointer::parse("/~") {
      Err(_) => true
      Ok(_) => false
    },
    "trailing ~ rejected",
  )
  let ptr_lz = match JsonPointer::parse("/foo/01") {
    Ok(p) => p
    Err(_) => return
  }
  debug_assert(
    match ptr_lz.resolve(doc) {
      None => true
      Some(_) => false
    },
    "leading zero array index 01 must not resolve",
  )
  let ptr_dash = match JsonPointer::parse("/foo/-") {
    Ok(p) => p
    Err(_) => return
  }
  debug_assert(
    match ptr_dash.resolve(doc) {
      None => true
      Some(_) => false
    },
    "array '-' must not resolve",
  )

  // resolve_mut
  let ptr_mut = match JsonPointer::parse("/foo/1") {
    Ok(p) => p
    Err(_) => return
  }
  let updated = match ptr_mut.resolve_mut(doc, JsonValue::Str("qux")) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "resolve_mut failed: " + e.message)
      return
    }
  }
  let resolved_new = match ptr_mut.resolve(updated) {
    Some(v) => v
    None => JsonValue::Null
  }
  debug_assert(json_value_eq(resolved_new, JsonValue::Str("qux")), "resolve_mut updated target")
  let resolved_old = match ptr_mut.resolve(doc) {
    Some(v) => v
    None => JsonValue::Null
  }
  debug_assert(json_value_eq(resolved_old, JsonValue::Str("baz")), "resolve_mut left original untouched")
}

///|
test "rfc6902_json_patch_ops_and_atomic_rollback" {
  // add, remove, replace, move, copy, test
  let doc = p_json("{\"a\":\"foo\",\"b\":[1,2],\"c\":{\"d\":true}}")
  let patch = match parse_patch("[{\"op\":\"test\",\"path\":\"/a\",\"value\":\"foo\"},{\"op\":\"add\",\"path\":\"/b/-\",\"value\":3},{\"op\":\"replace\",\"path\":\"/a\",\"value\":\"bar\"},{\"op\":\"copy\",\"from\":\"/c/d\",\"path\":\"/copied\"},{\"op\":\"move\",\"from\":\"/b/0\",\"path\":\"/first\"},{\"op\":\"remove\",\"path\":\"/c\"}]") {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_patch failed: " + e.message)
      return
    }
  }
  let out = match apply_patch(doc, patch) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "apply_patch failed: " + e.message)
      return
    }
  }
  let exp = p_json("{\"a\":\"bar\",\"b\":[2,3],\"copied\":true,\"first\":1}")
  debug_assert(json_value_eq(out, exp), "rfc6902 full op sequence")

  // Atomic rollback: op 0 succeeds, op 1 test fails -> Err, original doc intact
  let fail_patch = match parse_patch("[{\"op\":\"replace\",\"path\":\"/a\",\"value\":\"mutated\"},{\"op\":\"test\",\"path\":\"/a\",\"value\":\"wrong\"}]") {
    Ok(p) => p
    Err(_) => return
  }
  debug_assert(
    match apply_patch(doc, fail_patch) {
      Err(_) => true
      Ok(_) => false
    },
    "failing test op must return Err",
  )
  debug_assert(
    json_value_eq(doc, p_json("{\"a\":\"foo\",\"b\":[1,2],\"c\":{\"d\":true}}")),
    "original doc unchanged on failed patch",
  )

  // Move into proper prefix of itself must fail (RFC 6902 §4.4)
  let self_move = match parse_patch("[{\"op\":\"move\",\"from\":\"/c\",\"path\":\"/c/sub\"}]") {
    Ok(p) => p
    Err(_) => return
  }
  debug_assert(
    match apply_patch(doc, self_move) {
      Err(_) => true
      Ok(_) => false
    },
    "move into proper child prefix must fail",
  )

  // Add to root "" replaces whole doc
  let root_add = match parse_patch("[{\"op\":\"add\",\"path\":\"\",\"value\":99}]") {
    Ok(p) => p
    Err(_) => return
  }
  let root_out = match apply_patch(doc, root_add) {
    Ok(v) => v
    Err(_) => JsonValue::Null
  }
  debug_assert(json_value_eq(root_out, JsonValue::Int(99L)), "add at root replaces doc")
}

///|
test "rfc6902_diff_patch_roundtrip" {
  let pairs : Array[(String, String)] = [
    ("{\"a\":1,\"b\":[1,2,3],\"c\":{\"x\":true}}", "{\"a\":1,\"b\":[1,4,3,5],\"c\":{\"y\":false},\"d\":\"new\"}"),
    ("[1,2,3,4,5]", "[1,2,9,5]"),
    ("[1,2,3]", "[]"),
    ("[]", "[1,2]"),
    ("{\"a/b\":1,\"m~n\":2}", "{\"a/b\":2,\"m~n\":2,\"k/1\":3}"),
    ("{\"same\":1}", "{\"same\":1}"),
    ("null", "{\"x\":1}"),
  ]
  let mut i = 0
  while i < pairs.length() {
    let (before_s, after_s) = pairs[i]
    let before = p_json(before_s)
    let after = p_json(after_s)
    let diff = diff_patch(before, after)
    if before_s == after_s {
      debug_assert(diff.ops.length() == 0, "identical docs produce empty diff")
    }
    let applied = match apply_patch(before, diff) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "diff_patch apply failed on pair " + i.to_string() + ": " + e.message)
        return
      }
    }
    debug_assert(
      json_value_eq(applied, after),
      "diff_patch roundtrip mismatch on pair " + i.to_string(),
    )
    // Also verify patch_to_value -> patch_from_value roundtrip
    let pval = patch_to_value(diff)
    let decoded = match patch_from_value(pval) {
      Ok(p) => p
      Err(e) => {
        debug_assert(false, "patch_from_value failed: " + e.message)
        return
      }
    }
    let applied2 = match apply_patch(before, decoded) {
      Ok(v) => v
      Err(_) => JsonValue::Null
    }
    debug_assert(json_value_eq(applied2, after), "patch value roundtrip")
    i = i + 1
  }
}

///|
test "rfc7396_merge_patch_appendix_a" {
  // All 15 official test cases from RFC 7396 Appendix A
  let cases : Array[(String, String, String)] = [
    ("{\"a\":\"b\"}", "{\"a\":\"c\"}", "{\"a\":\"c\"}"),
    ("{\"a\":\"b\"}", "{\"b\":\"c\"}", "{\"a\":\"b\",\"b\":\"c\"}"),
    ("{\"a\":\"b\"}", "{\"a\":null}", "{}"),
    ("{\"a\":\"b\",\"b\":\"c\"}", "{\"a\":null}", "{\"b\":\"c\"}"),
    ("{\"a\":[\"b\"]}", "{\"a\":\"c\"}", "{\"a\":\"c\"}"),
    ("{\"a\":\"c\"}", "{\"a\":[\"b\"]}", "{\"a\":[\"b\"]}"),
    ("{\"a\":{\"b\":\"c\"}}", "{\"a\":{\"b\":\"d\",\"c\":null}}", "{\"a\":{\"b\":\"d\"}}"),
    ("{\"a\":[{\"b\":\"c\"}]}", "{\"a\":[1]}", "{\"a\":[1]}"),
    ("[\"a\",\"b\"]", "[\"c\",\"d\"]", "[\"c\",\"d\"]"),
    ("{\"a\":\"b\"}", "[\"c\"]", "[\"c\"]"),
    ("{\"a\":\"foo\"}", "null", "null"),
    ("{\"a\":\"foo\"}", "\"bar\"", "\"bar\""),
    ("{\"e\":null}", "{\"a\":1}", "{\"e\":null,\"a\":1}"),
    ("[1,2]", "{\"a\":\"b\",\"c\":null}", "{\"a\":\"b\"}"),
    ("{}", "{\"a\":{\"bb\":{\"ccc\":null}}}", "{\"a\":{\"bb\":{}}}"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (t, p, exp) = cases[i]
    let got = merge_patch(p_json(t), p_json(p))
    debug_assert(
      json_value_eq(got, p_json(exp)),
      "rfc7396 case " + i.to_string() + " mismatch: got=" + to_json_string(got),
    )
    i = i + 1
  }
}
