///| RFC 9535 JSONPath Compliance Test Suite (CTS) core matrix:
///| Selectors (Name, Wildcard, Index, Slice, Filter), Child & Descendant (`..`),
///| Normalized Paths (§2.7), Built-in Functions (`length`, `count`, `match`, `search`, `value`),
///| Static Type Checking (§2.4), I-Regexp (RFC 9485), and strict grammar edge cases.

fn must_json(s : String) -> JsonValue {
  match parse_json(s) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_json failed: " + e.message + " on " + s)
      JsonValue::Null
    }
  }
}

fn assert_query_json(
  expr : String,
  doc_str : String,
  expected_json : String,
  msg : String,
) -> Unit {
  let doc = must_json(doc_str)
  let expected = must_json(expected_json)
  let got = match query(expr, doc) {
    Ok(arr) => JsonValue::Array(arr)
    Err(e) => {
      debug_assert(false, msg + " (query failed: " + e.message + ")")
      return
    }
  }
  debug_assert(
    json_value_eq(got, expected),
    msg + " expected=" + to_json_string(expected) + " got=" + to_json_string(got),
  )
}

fn assert_query_paths(
  expr : String,
  doc_str : String,
  expected_paths : Array[String],
  msg : String,
) -> Unit {
  let doc = must_json(doc_str)
  let got = match query_with_paths(expr, doc) {
    Ok(arr) => arr
    Err(e) => {
      debug_assert(false, msg + " (query_with_paths failed: " + e.message + ")")
      return
    }
  }
  debug_assert(
    got.length() == expected_paths.length(),
    msg +
    " len mismatch: expected " +
    expected_paths.length().to_string() +
    " got " +
    got.length().to_string(),
  )
  let mut i = 0
  while i < expected_paths.length() && i < got.length() {
    debug_assert(
      got[i].path == expected_paths[i],
      msg + " path[" + i.to_string() + "] expected=" + expected_paths[i] + " got=" + got[i].path,
    )
    i = i + 1
  }
}

fn assert_invalid_query(expr : String, msg : String) -> Unit {
  match JsonPath::parse(expr) {
    Ok(_) => debug_assert(false, msg + " (expected parse/type error for: " + expr + ")")
    Err(_) => ()
  }
}

///|
test "cts_basic_root_and_name_selectors" {
  assert_query_json("$", "{\"k\":\"v\"}", "[{\"k\":\"v\"}]", "root object")
  assert_query_json("$", "[1,2]", "[[1,2]]", "root array")
  assert_query_json("$.a", "{\"a\":1,\"b\":2}", "[1]", "dot name")
  assert_query_json("$['a']", "{\"a\":1,\"b\":2}", "[1]", "single-quoted name")
  assert_query_json("$[\"a\"]", "{\"a\":1,\"b\":2}", "[1]", "double-quoted name")
  assert_query_json("$.missing", "{\"a\":1}", "[]", "missing key")
  assert_query_json("$.a", "[1,2]", "[]", "name on array yields empty")
  assert_query_json("$._a1", "{\"_a1\":42}", "[42]", "underscore and digit shorthand")
  assert_query_json("$.true", "{\"true\":9}", "[9]", "keyword as member shorthand")
  assert_query_json("$.中文", "{\"中文\":\"ok\"}", "[\"ok\"]", "non-ascii member shorthand")
  assert_query_json("$['']", "{\"\":7}", "[7]", "empty key")
  assert_query_json("$['a\\'b']", "{\"a'b\":3}", "[3]", "escaped single quote")
  assert_query_json("$[\"a\\\"b\"]", "{\"a\\\"b\":4}", "[4]", "escaped double quote")
  assert_query_json("$['a\\\\b']", "{\"a\\\\b\":5}", "[5]", "escaped backslash")
  assert_query_json("$['a\\/b']", "{\"a/b\":6}", "[6]", "escaped slash")
  assert_query_json("$['\\b\\f\\n\\r\\t']", "{\"\\b\\f\\n\\r\\t\":8}", "[8]", "control escapes")
  assert_query_json("$['\\u0041']", "{\"A\":10}", "[10]", "unicode BMP escape")
  assert_query_json("$['\\uD834\\uDD1E']", "{\"𝄞\":11}", "[11]", "unicode surrogate pair escape")
  assert_query_json("$['a', 'b', 'a']", "{\"a\":1,\"b\":2}", "[1,2,1]", "multi name preserves order and duplicates")
}

///|
test "cts_wildcard_and_index_selectors" {
  assert_query_json("$.*", "[1,2,3]", "[1,2,3]", "dot wildcard on array")
  assert_query_json("$[*]", "[1,2,3]", "[1,2,3]", "bracket wildcard on array")
  assert_query_json("$[*]", "42", "[]", "wildcard on primitive yields empty")
  assert_query_json("$[0]", "[\"a\",\"b\",\"c\"]", "[\"a\"]", "index 0")
  assert_query_json("$[2]", "[\"a\",\"b\",\"c\"]", "[\"c\"]", "index 2")
  assert_query_json("$[3]", "[\"a\",\"b\",\"c\"]", "[]", "index out of bounds")
  assert_query_json("$[-1]", "[\"a\",\"b\",\"c\"]", "[\"c\"]", "negative index -1")
  assert_query_json("$[-3]", "[\"a\",\"b\",\"c\"]", "[\"a\"]", "negative index -3")
  assert_query_json("$[-4]", "[\"a\",\"b\",\"c\"]", "[]", "negative index out of bounds")
  assert_query_json("$[0]", "{\"0\":\"x\"}", "[]", "index on object yields empty")
  assert_query_json("$[9007199254740991]", "[1]", "[]", "max safe int index accepted")
  assert_query_json("$[-9007199254740991]", "[1]", "[]", "min safe int index accepted")
}

///|
test "cts_slice_selectors" {
  let arr = "[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\"]"
  assert_query_json("$[1:3]", arr, "[\"b\",\"c\"]", "basic slice 1:3")
  assert_query_json("$[5:]", arr, "[\"f\",\"g\"]", "slice 5:")
  assert_query_json("$[:2]", arr, "[\"a\",\"b\"]", "slice :2")
  assert_query_json("$[:]", arr, arr, "slice :")
  assert_query_json("$[::2]", arr, "[\"a\",\"c\",\"e\",\"g\"]", "slice ::2")
  assert_query_json("$[1:5:2]", arr, "[\"b\",\"d\"]", "slice 1:5:2")
  assert_query_json("$[5:1:-2]", arr, "[\"f\",\"d\"]", "negative step 5:1:-2")
  assert_query_json("$[::-1]", arr, "[\"g\",\"f\",\"e\",\"d\",\"c\",\"b\",\"a\"]", "reverse slice ::-1")
  assert_query_json("$[-3:-1]", arr, "[\"e\",\"f\"]", "negative bounds -3:-1")
  assert_query_json("$[1:5:0]", arr, "[]", "step 0 yields empty")
  assert_query_json("$[5:1:1]", arr, "[]", "start > end with positive step yields empty")
  assert_query_json("$[1:5:-1]", arr, "[]", "start < end with negative step yields empty")
  assert_query_json("$[-100:100]", "[\"x\",\"y\"]", "[\"x\",\"y\"]", "clamped wide slice")
  assert_query_json("$[1:3]", "{\"a\":1}", "[]", "slice on object yields empty")
}

///|
test "cts_descendant_and_normalized_paths" {
  let doc = "{\"a\":[{\"b\":1},{\"b\":2}],\"c\":{\"b\":3},\"b\":0}"
  assert_query_json("$..b", doc, "[0,1,2,3]", "descendant ..b")
  assert_query_paths(
    "$..b",
    doc,
    ["$['b']", "$['a'][0]['b']", "$['a'][1]['b']", "$['c']['b']"],
    "normalized paths for ..b",
  )
  // Normalized path escaping (§2.7)
  let esc_doc = "{\"a'b\":1,\"c\\\\d\":2,\"e\\\"f\":3,\"g/h\":4,\"\\b\\f\\n\\r\\t\":5,\"\\u0000\\u001f\":6}"
  assert_query_paths("$['a\\'b']", esc_doc, ["$['a\\'b']"], "norm path single quote")
  assert_query_paths("$['c\\\\d']", esc_doc, ["$['c\\\\d']"], "norm path backslash")
  assert_query_paths("$['e\"f']", esc_doc, ["$['e\"f']"], "norm path double quote unescaped")
  assert_query_paths("$['g/h']", esc_doc, ["$['g/h']"], "norm path slash unescaped")
  assert_query_paths("$['\\b\\f\\n\\r\\t']", esc_doc, ["$['\\b\\f\\n\\r\\t']"], "norm path control escapes")
  assert_query_paths("$['\\u0000\\u001f']", esc_doc, ["$['\\u0000\\u001f']"], "norm path lowercase hex control")
}

///|
test "cts_filter_expressions_and_comparisons" {
  let doc = "[{\"a\":1,\"b\":2},{\"a\":2,\"b\":2},{\"a\":3,\"b\":1},{\"a\":null},{\"b\":5}]"
  assert_query_json("$[?@.a == 1]", doc, "[{\"a\":1,\"b\":2}]", "eq int")
  assert_query_json("$[?@.a == 1.0]", doc, "[{\"a\":1,\"b\":2}]", "eq int vs float")
  assert_query_json("$[?@.a != 2]", doc, "[{\"a\":1,\"b\":2},{\"a\":3,\"b\":1},{\"a\":null},{\"b\":5}]", "ne includes Nothing and null")
  assert_query_json("$[?@.a < @.b]", doc, "[{\"a\":1,\"b\":2}]", "lt comparison")
  assert_query_json("$[?@.a <= @.b]", doc, "[{\"a\":1,\"b\":2},{\"a\":2,\"b\":2}]", "le comparison")
  assert_query_json("$[?@.a > 1 && @.b >= 1]", doc, "[{\"a\":2,\"b\":2},{\"a\":3,\"b\":1}]", "logical and")
  assert_query_json("$[?@.a == 1 || @.b == 5]", doc, "[{\"a\":1,\"b\":2},{\"b\":5}]", "logical or")
  assert_query_json("$[?!@.a]", doc, "[{\"b\":5}]", "logical not existence (null exists!)")
  assert_query_json("$[?@.a == null]", doc, "[{\"a\":null}]", "Nothing != null")
  assert_query_json("$[?@.missing1 == @.missing2]", "[1,2]", "[1,2]", "Nothing == Nothing is true")
  assert_query_json("$[?@.missing1 <= @.missing2]", "[1]", "[1]", "Nothing <= Nothing is true")
  assert_query_json("$[?@.missing1 < @.missing2]", "[1]", "[]", "Nothing < Nothing is false")
  assert_query_json("$[?0 == -0]", "[1]", "[1]", "0 == -0 in filter literal")
  assert_query_json("$[?0 == -0.0]", "[1]", "[1]", "0 == -0.0 in filter literal")
  assert_query_json("$[?true < false]", "[1]", "[]", "bool not orderable")
  assert_query_json("$[?true <= true]", "[1]", "[1]", "bool <= equal is true")
  assert_query_json("$[?null <= null]", "[1]", "[1]", "null <= null is true")
  assert_query_json("$[?\"a\" < \"b\"]", "[1]", "[1]", "string lt")
  assert_query_json("$[?\"a\" < 1]", "[1]", "[]", "mixed type lt is false")
  assert_query_json("$[?@.x == $.target]", "{\"target\":2,\"items\":[{\"x\":1},{\"x\":2}]}", "[]", "filter on object")
  assert_query_json("$.items[?@.x == $.target]", "{\"target\":2,\"items\":[{\"x\":1},{\"x\":2}]}", "[{\"x\":2}]", "filter referencing root $")
}

///|
test "cts_builtin_functions_and_iregexp" {
  // length() - Unicode scalar values!
  let str_doc = "[\"a\",\"中文\",\"😀\",\"😀a\",[1,2],{\"k\":1},42,true,null]"
  assert_query_json("$[?length(@) == 1]", str_doc, "[\"a\",\"😀\",{\"k\":1}]", "length() == 1 (emoji=1, obj=1)")
  assert_query_json("$[?length(@) == 2]", str_doc, "[\"中文\",\"😀a\",[1,2]]", "length() == 2 (CJK=2, emoji+a=2, arr=2)")

  // count()
  let cnt_doc = "[[1,2,3],[1],[]]"
  assert_query_json("$[?count(@[*]) >= 2]", cnt_doc, "[[1,2,3]]", "count() >= 2")
  assert_query_json("$[?count(@[*]) == 0]", cnt_doc, "[[]]", "count() == 0")

  // value()
  let val_doc = "[{\"a\":[1]},{\"a\":[1,2]},{\"a\":[]}]"
  assert_query_json("$[?value(@.a[*]) == 1]", val_doc, "[{\"a\":[1]}]", "value() single node")
  assert_query_json("$[?value(@.a[*]) == value(@.missing)]", val_doc, "[{\"a\":[1,2]},{\"a\":[]}]", "value() multi or empty -> Nothing")

  // match() & search() with RFC 9485 I-Regexp
  let re_doc = "[\"abc\",\"xabcy\",\"a\\nb\",\"a\\rb\",\"^abc$\",\"Hello\",\"123\"]"
  assert_query_json("$[?match(@, \"abc\")]", re_doc, "[\"abc\"]", "match is implicitly anchored")
  assert_query_json("$[?search(@, \"abc\")]", re_doc, "[\"abc\",\"xabcy\",\"^abc$\"]", "search is unanchored substring")
  assert_query_json("$[?match(@, \"a.b\")]", re_doc, "[]", "I-Regexp dot does NOT match \\n or \\r")
  assert_query_json("$[?match(@, \"^abc$\")]", re_doc, "[\"abc\"]", "I-Regexp ^ and $ act as start/end anchors per CTS 516/517")
  assert_query_json("$[?match(@, \"^ab.*\")]", "[\"abc\",\"axc\",\"ab\",\"xab\"]", "[\"abc\",\"ab\"]", "CTS 516 explicit caret")
  assert_query_json("$[?match(@, \".*bc$\")]", "[\"abc\",\"axc\",\"ab\",\"abcx\"]", "[\"abc\"]", "CTS 517 explicit dollar")
  assert_query_json("$[?match(@, \"\\\\^abc$\")]", re_doc, "[]", "escaped caret is literal")
  assert_query_json("$[?match(@, \"\\\\p{Lu}\\\\p{Ll}+\")]", re_doc, "[\"Hello\"]", "I-Regexp Unicode category \\p{Lu}\\p{Ll}+")
  assert_query_json("$[?match(@, \"[0-9]{3}\")]", re_doc, "[\"123\"]", "I-Regexp range quantifier")
  // Invalid I-Regexp returns LogicalFalse (not error!)
  assert_query_json("$[?match(@, \"\\\\d+\")]", re_doc, "[]", "invalid I-Regexp \\d returns false")
  assert_query_json("$[?search(@, \"a*?\")]", re_doc, "[]", "invalid I-Regexp lazy quantifier returns false")
  assert_query_json("$[?match(@, \"(?i)abc\")]", re_doc, "[]", "invalid I-Regexp flag group returns false")
  assert_query_json("$[?match(@, \"[unclosed\")]", re_doc, "[]", "invalid I-Regexp unclosed class returns false")
}

///|
test "cts_static_type_checking_and_invalid_syntax" {
  // Whitespace & root rules
  assert_invalid_query("", "empty query")
  assert_invalid_query(" $", "leading space")
  assert_invalid_query("$ ", "trailing space")
  assert_invalid_query("$. a", "space after dot")
  assert_invalid_query("$.. a", "space after ..")
  assert_invalid_query("$.. [0]", "space between .. and [")
  assert_invalid_query("$\u{000B}.a", "vertical tab not valid whitespace")
  assert_invalid_query("@.a", "relative query at top level")

  // Name & escape rules
  assert_invalid_query("$.1", "digit start in member shorthand")
  assert_invalid_query("$.a-b", "hyphen in member shorthand")
  assert_invalid_query("$['\\']", "unterminated single quote")
  assert_invalid_query("$['\\\"']", "escaped double quote in single-quoted string")
  assert_invalid_query("$[\"\\'\"]", "escaped single quote in double-quoted string")
  assert_invalid_query("$['\\uD800']", "lone high surrogate")
  assert_invalid_query("$['\\uDC00']", "lone low surrogate")
  assert_invalid_query("$['a\nb']", "unescaped newline in string")

  // Index & slice rules
  assert_invalid_query("$[-0]", "-0 index rejected")
  assert_invalid_query("$[01]", "leading zero index rejected")
  assert_invalid_query("$[9007199254740992]", "index above 2^53-1 rejected")
  assert_invalid_query("$[-9007199254740992]", "index below -(2^53-1) rejected")
  assert_invalid_query("$[-0:1]", "-0 in slice start rejected")
  assert_invalid_query("$[0:-0]", "-0 in slice end rejected")
  assert_invalid_query("$[0:1:-0]", "-0 in slice step rejected")
  assert_invalid_query("$[01:2]", "leading zero in slice rejected")
  assert_invalid_query("$[]", "empty bracket selector")

  // Filter syntax & RFC 9535 §2.4 static type checking
  assert_invalid_query("$[?length(@.a)]", "ValueType func in test-expr rejected")
  assert_invalid_query("$[?count(@.*)]", "ValueType count() in test-expr rejected")
  assert_invalid_query("$[?value(@.a)]", "ValueType value() in test-expr rejected")
  assert_invalid_query("$[?match(@.a, \"x\") == true]", "LogicalType func in comparison rejected")
  assert_invalid_query("$[?search(@.a, \"x\") == true]", "LogicalType search() in comparison rejected")
  assert_invalid_query("$[?length(@.*) == 1]", "non-singular query in ValueType arg rejected")
  assert_invalid_query("$[?count(1) == 1]", "literal in NodesType arg rejected")
  assert_invalid_query("$[?value(\"x\") == \"x\"]", "literal in value() NodesType arg rejected")
  assert_invalid_query("$[?@.* == 1]", "non-singular query in comparison rejected")
  assert_invalid_query("$[?unknown(@.a)]", "unknown function rejected")
  assert_invalid_query("$[?length(@.a, 1) == 1]", "wrong arity rejected")
  assert_invalid_query("$[?!@.a == 1]", "negated comparison without parens rejected")
  assert_invalid_query("$[?(@.a) == 1]", "parenthesized comparable rejected")
  assert_invalid_query("$[?1]", "literal in test-expr rejected")
}
