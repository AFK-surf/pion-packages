///| Red-team differential driver for `packages/jsonpath`.
///| Reads a JSONL case file (one case object per line) and prints one JSONL
///| result object per case. Output is canonical (all values embedded as
///| serialized strings) so the 4 build modes can be compared byte-for-byte.

import "jsonpath"

fn split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if src.code_unit_at(i) == 10 {
      if i > start {
        out.push(src.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(src.slice(start, n))
  }
  out
}

fn get(obj : jsonpath::JsonValue, key : String) -> Option[jsonpath::JsonValue] {
  match obj {
    jsonpath::JsonValue::Object(entries) => {
      let mut i = entries.length() - 1
      while i >= 0 {
        let (k, v) = entries[i]
        if k == key {
          return Some(v)
        }
        i = i - 1
      }
      Option::None
    }
    _ => Option::None
  }
}

fn get_str(obj : jsonpath::JsonValue, key : String) -> String {
  match get(obj, key) {
    Some(jsonpath::JsonValue::Str(s)) => s
    _ => ""
  }
}

fn get_int(obj : jsonpath::JsonValue, key : String, fallback : Int) -> Int {
  match get(obj, key) {
    Some(jsonpath::JsonValue::Int(x)) => x.to_int()
    _ => fallback
  }
}

fn kind_name(k : jsonpath::JsonPathErrorKind) -> String {
  match k {
    jsonpath::JsonPathErrorKind::ParseError => "ParseError"
    jsonpath::JsonPathErrorKind::TypeError => "TypeError"
    jsonpath::JsonPathErrorKind::PointerError => "PointerError"
    jsonpath::JsonPathErrorKind::PatchError => "PatchError"
    jsonpath::JsonPathErrorKind::LimitExceeded => "LimitExceeded"
    jsonpath::JsonPathErrorKind::JsonError => "JsonError"
  }
}

fn s(v : String) -> jsonpath::JsonValue {
  jsonpath::JsonValue::Str(v)
}

fn b(v : Bool) -> jsonpath::JsonValue {
  jsonpath::JsonValue::Bool(v)
}

fn ser(v : jsonpath::JsonValue) -> jsonpath::JsonValue {
  jsonpath::JsonValue::Str(jsonpath::to_json_string(v))
}

fn err_obj(id : String, e : jsonpath::JsonPathError) -> jsonpath::JsonValue {
  jsonpath::JsonValue::Object(
    [("id", s(id)), ("ok", b(false)), ("kind", s(kind_name(e.kind)))],
  )
}

fn limits_of(c : jsonpath::JsonValue) -> jsonpath::JsonPathLimits {
  let d = jsonpath::JsonPathLimits::default()
  jsonpath::JsonPathLimits::{
    max_depth: get_int(c, "max_depth", d.max_depth),
    max_nodes_visited: get_int(c, "max_nodes_visited", d.max_nodes_visited),
    max_results: get_int(c, "max_results", d.max_results),
    max_patch_ops: get_int(c, "max_patch_ops", d.max_patch_ops),
  }
}

fn run_query(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let sel = get_str(c, "selector")
  let doc = match get(c, "document") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let lim = limits_of(c)
  let jp = match jsonpath::JsonPath::parse(sel) {
    Ok(p) => p
    Err(e) => return err_obj(id, e)
  }
  let vals = match jp.query_with_limits(doc, lim) {
    Ok(v) => v
    Err(e) => return err_obj(id, e)
  }
  let nms = match jp.query_with_paths_limits(doc, lim) {
    Ok(v) => v
    Err(e) => return err_obj(id, e)
  }
  let paths : Array[jsonpath::JsonValue] = []
  let pvals : Array[jsonpath::JsonValue] = []
  let mut i = 0
  while i < nms.length() {
    paths.push(s(nms[i].path))
    pvals.push(nms[i].value)
    i = i + 1
  }
  let vt = jsonpath::to_json_string(jsonpath::JsonValue::Array(vals))
  let pt = jsonpath::to_json_string(jsonpath::JsonValue::Array(pvals))
  jsonpath::JsonValue::Object(
    [
      ("id", s(id)),
      ("ok", b(true)),
      ("values", s(vt)),
      ("paths", jsonpath::JsonValue::Array(paths)),
      ("values_paths_consistent", b(vt == pt)),
    ],
  )
}

fn run_parse(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let text = get_str(c, "text")
  let lim = limits_of(c)
  match jsonpath::parse_json_with_limits(text, lim) {
    Ok(v) => {
      let out = jsonpath::to_json_string(v)
      // Re-parse our own output: must succeed and be structurally equal, and stable.
      let rt = match jsonpath::parse_json_with_limits(out, lim) {
        Ok(v2) => jsonpath::json_value_eq(v, v2) &&
        jsonpath::to_json_string(v2) == out
        Err(_) => false
      }
      jsonpath::JsonValue::Object(
        [("id", s(id)), ("ok", b(true)), ("text", s(out)), ("roundtrip", b(rt))],
      )
    }
    Err(e) => err_obj(id, e)
  }
}

fn run_pointer(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let ptr_s = get_str(c, "pointer")
  let doc = match get(c, "document") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let ptr = match jsonpath::JsonPointer::parse(ptr_s) {
    Ok(p) => p
    Err(e) => return err_obj(id, e)
  }
  let back = ptr.to_string()
  match ptr.resolve(doc) {
    Some(v) =>
    jsonpath::JsonValue::Object(
      [
        ("id", s(id)),
        ("ok", b(true)),
        ("found", b(true)),
        ("value", ser(v)),
        ("to_string", s(back)),
      ],
    )
    None =>
    jsonpath::JsonValue::Object(
      [("id", s(id)), ("ok", b(true)), ("found", b(false)), ("to_string", s(back))],
    )
  }
}

fn run_patch(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let doc = match get(c, "document") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let before = jsonpath::to_json_string(doc)
  let pv = match get(c, "patch") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let patch = match jsonpath::patch_from_value(pv) {
    Ok(p) => p
    Err(e) => return err_obj(id, e)
  }
  let res = jsonpath::apply_patch_with_limits(doc, patch, limits_of(c))
  let unchanged = jsonpath::to_json_string(doc) == before
  match res {
    Ok(v) =>
    jsonpath::JsonValue::Object(
      [("id", s(id)), ("ok", b(true)), ("value", ser(v)), ("doc_unchanged", b(unchanged))],
    )
    Err(e) =>
    jsonpath::JsonValue::Object(
      [
        ("id", s(id)),
        ("ok", b(false)),
        ("kind", s(kind_name(e.kind))),
        ("doc_unchanged", b(unchanged)),
      ],
    )
  }
}

fn run_merge(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let target = match get(c, "target") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let patch = match get(c, "patch") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let v = jsonpath::merge_patch(target, patch)
  jsonpath::JsonValue::Object([("id", s(id)), ("ok", b(true)), ("value", ser(v))])
}

fn run_diff(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let before = match get(c, "before") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let after = match get(c, "after") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let p = jsonpath::diff_patch(before, after)
  let pv = jsonpath::patch_to_value(p)
  match jsonpath::apply_patch(before, p) {
    Ok(v) =>
    jsonpath::JsonValue::Object(
      [
        ("id", s(id)),
        ("ok", b(true)),
        ("patch", ser(pv)),
        ("applied", ser(v)),
        ("roundtrip_eq", b(jsonpath::json_value_eq(v, after))),
      ],
    )
    Err(e) =>
    jsonpath::JsonValue::Object(
      [
        ("id", s(id)),
        ("ok", b(false)),
        ("kind", s(kind_name(e.kind))),
        ("patch", ser(pv)),
      ],
    )
  }
}

fn run_eq(id : String, c : jsonpath::JsonValue) -> jsonpath::JsonValue {
  let a = match get(c, "a") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  let bb = match get(c, "b") {
    Some(v) => v
    None => jsonpath::JsonValue::Null
  }
  jsonpath::JsonValue::Object(
    [("id", s(id)), ("ok", b(true)), ("equal", b(jsonpath::json_value_eq(a, bb)))],
  )
}

fn run_case(line : String) -> jsonpath::JsonValue {
  let c = match jsonpath::parse_json(line) {
    Ok(v) => v
    Err(e) => return err_obj("<driver-input>", e)
  }
  let id = get_str(c, "id")
  let op = get_str(c, "op")
  if op == "query" {
    run_query(id, c)
  } else if op == "parse" {
    run_parse(id, c)
  } else if op == "pointer" {
    run_pointer(id, c)
  } else if op == "patch" {
    run_patch(id, c)
  } else if op == "merge" {
    run_merge(id, c)
  } else if op == "diff" {
    run_diff(id, c)
  } else if op == "eq" {
    run_eq(id, c)
  } else {
    jsonpath::JsonValue::Object([("id", s(id)), ("ok", b(false)), ("kind", s("UnknownOp"))])
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_driver <cases.jsonl>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(t) => t
    Err(_) => {
      io_println(world, "cannot read " + args[1])
      return 2
    }
  }
  let lines = split_lines(src)
  let mut i = 0
  while i < lines.length() {
    io_println(world, jsonpath::to_json_string(run_case(lines[i])))
    i = i + 1
  }
  0
}
