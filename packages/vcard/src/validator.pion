///| RFC 6350 vCard semantic validator.

///| Check whether `sex` is a valid RFC 6350 §6.2.7 GENDER sex component.
fn is_valid_gender_sex(sex : String) -> Bool {
  sex == "" || sex == "M" || sex == "F" || sex == "O" || sex == "N" || sex == "U"
}

///| Check whether `kind` is a valid RFC 6350 §6.1.4 KIND value.
fn is_valid_kind(kind : String) -> Bool {
  if kind == "individual" || kind == "group" || kind == "org" || kind == "location" {
    return true
  }
  kind.length() >= 2 && ascii_lower_byte(kind.code_unit_at(0)) == 120 && kind.code_unit_at(1) == 45
}

///| Validate a `VCard` against RFC 6350 mandatory rules (`VERSION`, `FN`, `PREF` 1..100, `GENDER`, `CLIENTPIDMAP`, `MEMBER`/`KIND`).
pub fn validate(card : VCard) -> Result[Unit, Array[VCardError]] {
  let errs : Array[VCardError] = []

  let mut version_count = 0
  let mut fn_count = 0
  let mut kind_val = "individual"
  let mut has_member = false

  let n = card.properties.length()
  let mut i = 0
  while i < n {
    let p = card.properties[i]
    if p.name == "VERSION" {
      version_count = version_count + 1
      if p.value != "4.0" && p.value != "3.0" && p.value != "2.1" {
        errs.push(VCardError::ValidationError("unsupported VERSION: " + p.value))
      }
    } else if p.name == "FN" {
      fn_count = fn_count + 1
    } else if p.name == "KIND" {
      kind_val = ascii_to_lower(p.value)
      if !is_valid_kind(kind_val) {
        errs.push(VCardError::ValidationError("invalid KIND value: " + p.value))
      }
    } else if p.name == "MEMBER" {
      has_member = true
    } else if p.name == "GENDER" {
      let g = Gender::parse(p.value)
      if !is_valid_gender_sex(g.sex) {
        errs.push(VCardError::ValidationError("invalid GENDER sex code: " + g.sex))
      }
    } else if p.name == "CLIENTPIDMAP" {
      match ClientPidMap::parse(p.value) {
        Ok(_) => ()
        Err(e) => errs.push(e)
      }
    }

    // Validate PREF parameters on every property (RFC 6350 §5.3: integer 1..100)
    let mut j = 0
    while j < p.params.length() {
      let param = p.params[j]
      if ascii_eq_ignore_case(param.name, "PREF") {
        let mut k = 0
        while k < param.values.length() {
          let v = parse_uint_strict(param.values[k])
          if v < 1 || v > 100 {
            errs.push(
              VCardError::ValidationError(
                "PREF parameter on " + p.name + " must be 1..100, got: " + param.values[k],
              ),
            )
          }
          k = k + 1
        }
      }
      j = j + 1
    }

    i = i + 1
  }

  if version_count == 0 {
    errs.push(VCardError::ValidationError("missing required VERSION property"))
  } else if version_count > 1 {
    errs.push(VCardError::ValidationError("duplicate VERSION property"))
  }

  if fn_count == 0 {
    errs.push(VCardError::ValidationError("missing required FN property"))
  }

  if has_member && kind_val != "group" {
    errs.push(VCardError::ValidationError("MEMBER property is only allowed when KIND is 'group'"))
  }

  if errs.length() > 0 {
    Err(errs)
  } else {
    Ok(())
  }
}
