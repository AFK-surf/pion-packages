///| Core types, errors, limits, and data model for `packages/vcard` (RFC 6350 / RFC 2426 / RFC 6868).

///| Structured error type for vCard parsing, validation, and binary decoding.
pub enum VCardError {
  InvalidSyntax(String)
  InvalidProperty(String)
  InvalidParameter(String)
  InvalidValue(String)
  InvalidUtf8(String)
  ValidationError(String)
  LimitExceeded(String)
  Unimplemented(String)
}

///| Format a `VCardError` as a human-readable string.
pub fn vcard_error_to_string(e : VCardError) -> String {
  match e {
    VCardError::InvalidSyntax(m) => "InvalidSyntax: " + m
    VCardError::InvalidProperty(m) => "InvalidProperty: " + m
    VCardError::InvalidParameter(m) => "InvalidParameter: " + m
    VCardError::InvalidValue(m) => "InvalidValue: " + m
    VCardError::InvalidUtf8(m) => "InvalidUtf8: " + m
    VCardError::ValidationError(m) => "ValidationError: " + m
    VCardError::LimitExceeded(m) => "LimitExceeded: " + m
    VCardError::Unimplemented(m) => "Unimplemented: " + m
  }
}

///| Resource limits enforced during vCard parsing to defend against DoS payloads.
pub val struct VCardLimits {
  pub max_bytes : Int
  pub max_cards : Int
  pub max_properties_per_card : Int
  pub max_line_bytes : Int
  pub max_params_per_prop : Int
}

///| Conservative default limits for vCard parsing.
pub fn VCardLimits::default() -> VCardLimits {
  VCardLimits::{
    max_bytes: 67108864,
    max_cards: 50000,
    max_properties_per_card: 2048,
    max_line_bytes: 1048576,
    max_params_per_prop: 128,
  }
}

///| vCard specification version.
pub enum VCardVersion {
  V2_1
  V3_0
  V4_0
  Other(String)
}

///| Format a `VCardVersion` as its wire string.
pub fn vcard_version_to_string(v : VCardVersion) -> String {
  match v {
    VCardVersion::V2_1 => "2.1"
    VCardVersion::V3_0 => "3.0"
    VCardVersion::V4_0 => "4.0"
    VCardVersion::Other(s) => s
  }
}

///| A vCard property parameter (`NAME=val1,val2`).
pub struct VCardParam {
  pub name : String
  pub values : Array[String]
}

///| Construct a `VCardParam` with a single value.
pub fn VCardParam::new(name : String, value : String) -> VCardParam {
  VCardParam::{ name: name, values: [value] }
}

///| Construct a `VCardParam` with multiple values.
pub fn VCardParam::with_values(name : String, values : Array[String]) -> VCardParam {
  VCardParam::{ name: name, values: values }
}

///| A vCard content-line property (`[group.]NAME;PARAM=VAL:VALUE`).
pub struct VCardProperty {
  pub group : Option[String]
  pub name : String
  pub params : Array[VCardParam]
  pub value : String
}

///| Construct a `VCardProperty` without group or parameters.
pub fn VCardProperty::new(name : String, value : String) -> VCardProperty {
  VCardProperty::{ group: None, name: name, params: [], value: value }
}

///| Construct a `VCardProperty` with parameters.
pub fn VCardProperty::with_params(
  name : String,
  params : Array[VCardParam],
  value : String,
) -> VCardProperty {
  VCardProperty::{ group: None, name: name, params: params, value: value }
}

///| Construct a `VCardProperty` with group and parameters.
pub fn VCardProperty::with_group(
  group : Option[String],
  name : String,
  params : Array[VCardParam],
  value : String,
) -> VCardProperty {
  VCardProperty::{ group: group, name: name, params: params, value: value }
}

///| A single vCard object (`BEGIN:VCARD` .. `END:VCARD`).
pub struct VCard {
  pub properties : Array[VCardProperty]
}

///| Construct an empty `VCard`.
pub fn VCard::new() -> VCard {
  VCard::{ properties: [] }
}

///| RFC 6350 §6.2.2 `N` structured name (5 semicolon-separated components, each comma-separated).
pub struct StructuredName {
  pub family : Array[String]
  pub given : Array[String]
  pub additional : Array[String]
  pub prefixes : Array[String]
  pub suffixes : Array[String]
}

///| Construct a `StructuredName` from its 5 component lists.
pub fn StructuredName::new(
  family : Array[String],
  given : Array[String],
  additional : Array[String],
  prefixes : Array[String],
  suffixes : Array[String],
) -> StructuredName {
  StructuredName::{
    family: family,
    given: given,
    additional: additional,
    prefixes: prefixes,
    suffixes: suffixes,
  }
}

///| RFC 6350 §6.3.1 `ADR` structured postal address (7 semicolon-separated components).
pub struct Address {
  pub po_box : Array[String]
  pub extended : Array[String]
  pub street : Array[String]
  pub locality : Array[String]
  pub region : Array[String]
  pub postal_code : Array[String]
  pub country : Array[String]
  pub label : Option[String]
  pub types : Array[String]
  pub pref : Option[Int]
  pub group : Option[String]
}

///| RFC 6350 §6.6.4 `ORG` organizational name and hierarchical units.
pub struct Organization {
  pub units : Array[String]
  pub types : Array[String]
  pub pref : Option[Int]
  pub group : Option[String]
}

///| RFC 6350 §6.2.7 `GENDER` property (`sex[;identity]`).
pub struct Gender {
  pub sex : String
  pub identity : Option[String]
}

///| RFC 6350 §6.7.7 `CLIENTPIDMAP` property (`pid;uri`).
pub struct ClientPidMap {
  pub pid : Int
  pub uri : String
}

///| RFC 6350 §4.3.1-4.3.4 partial or full date / date-time (`BDAY`, `ANNIVERSARY`).
pub struct PartialDate {
  pub year : Option[Int]
  pub month : Option[Int]
  pub day : Option[Int]
  pub hour : Option[Int]
  pub minute : Option[Int]
  pub second : Option[Int]
  pub tz_offset : Option[String]
  pub raw : String
}

///| RFC 6350 §6.5.2 / RFC 2426 §3.4.2 `GEO` geographic coordinates.
pub struct Geo {
  pub latitude : String
  pub longitude : String
}

///| Typed property value with common RFC 6350 metadata parameters (`TYPE`, `PREF`, `ALTID`, `PID`, group).
pub struct TypedValue {
  pub value : String
  pub types : Array[String]
  pub pref : Option[Int]
  pub altid : Option[String]
  pub pid : Array[String]
  pub group : Option[String]
}

///| Decoded binary payload with optional media type (`PHOTO`, `LOGO`, `KEY`).
pub struct BinaryValue {
  pub media_type : Option[String]
  pub data : Bytes
}

///| Media value representing either a URI reference or an inline decoded binary payload.
pub enum MediaValue {
  Uri(String)
  Inline(BinaryValue)
}
