///| RFC 6350 / RFC 2426 content-line and multi-card `.vcf` stream parser.

///| Check whether a bare (valueless) vCard 2.1/3.0 parameter name is an ENCODING token.
fn is_bare_encoding_token(upper : String) -> Bool {
  upper == "QUOTED-PRINTABLE" || upper == "BASE64" || upper == "B" || upper == "8BIT" || upper == "7BIT"
}

///| Check whether `s` contains ASCII substring `needle` (case-insensitive) in `[start, end)`.
fn contains_ascii_ci(s : String, start : Int, end : Int, needle : String) -> Bool {
  let nl = needle.length()
  if nl == 0 || end - start < nl {
    return false
  }
  let limit = end - nl
  let mut i = start
  while i <= limit {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if ascii_upper_byte(s.code_unit_at(i + j)) != ascii_upper_byte(needle.code_unit_at(j)) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

///| Parse a single unfolded vCard content line into a `VCardProperty`.
pub fn parse_property_line(
  line : String,
  max_params : Int,
) -> Result[VCardProperty, VCardError] {
  let n = line.length()
  if n == 0 {
    return Err(VCardError::InvalidSyntax("empty content line"))
  }

  // 1. Optional `[group.]NAME` up to ';' or ':'
  let mut pos = 0
  let mut dot_pos = -1
  while pos < n {
    let c = line.code_unit_at(pos)
    if c == 59 || c == 58 {
      break
    }
    if c == 46 && dot_pos < 0 {
      dot_pos = pos
    }
    pos = pos + 1
  }
  if pos == 0 || pos >= n {
    return Err(VCardError::InvalidSyntax("missing property name or ':' in line"))
  }

  let mut group : Option[String] = None
  let mut name_start = 0
  if dot_pos >= 0 {
    if dot_pos == 0 || dot_pos + 1 >= pos {
      return Err(VCardError::InvalidSyntax("empty group or property name around '.'"))
    }
    let grp = string_slice_bytes(line, 0, dot_pos)
    if !is_valid_vcard_name(grp) {
      return Err(VCardError::InvalidSyntax("invalid group name: " + grp))
    }
    group = Some(grp)
    name_start = dot_pos + 1
  }

  let prop_name = slice_to_upper(line, name_start, pos)
  if !is_valid_vcard_name(prop_name) {
    return Err(VCardError::InvalidSyntax("invalid property name: " + prop_name))
  }

  let params : Array[VCardParam] = []

  // 2. Parse optional `;PARAM=val1,val2` or vCard 2.1/3.0 bare `;TOKEN` segments
  while pos < n && line.code_unit_at(pos) == 59 {
    pos = pos + 1
    if params.length() >= max_params {
      return Err(VCardError::LimitExceeded("parameter count exceeds max_params_per_prop"))
    }
    let pname_start = pos
    while pos < n {
      let c = line.code_unit_at(pos)
      if c == 61 || c == 58 || c == 59 {
        break
      }
      pos = pos + 1
    }
    if pos == pname_start || pos >= n {
      return Err(VCardError::InvalidParameter("empty or unterminated parameter"))
    }
    let delim = line.code_unit_at(pos)
    let pname_upper = slice_to_upper(line, pname_start, pos)
    if !is_valid_vcard_name(pname_upper) {
      return Err(VCardError::InvalidParameter("invalid parameter name: " + pname_upper))
    }

    if delim == 59 || delim == 58 {
      // Bare valueless parameter (vCard 2.1 / 3.0 shorthand)
      if is_bare_encoding_token(pname_upper) {
        params.push(VCardParam::{ name: "ENCODING", values: [pname_upper] })
      } else {
        params.push(VCardParam::{ name: "TYPE", values: [ascii_to_lower(pname_upper)] })
      }
      continue
    }

    // delim == '=' (61)
    pos = pos + 1
    let vals : Array[String] = []
    while true {
      if pos < n && line.code_unit_at(pos) == 34 {
        // Quoted parameter value
        pos = pos + 1
        let qstart = pos
        let mut closed = false
        while pos < n {
          if line.code_unit_at(pos) == 34 {
            closed = true
            break
          }
          pos = pos + 1
        }
        if !closed {
          return Err(VCardError::InvalidParameter("unclosed quoted parameter value"))
        }
        vals.push(unescape_param_value(string_slice_bytes(line, qstart, pos)))
        pos = pos + 1 // skip closing '"'
      } else {
        // Unquoted parameter value up to ',', ';', or ':'
        let vstart = pos
        while pos < n {
          let c = line.code_unit_at(pos)
          if c == 44 || c == 59 || c == 58 {
            break
          }
          if c == 34 {
            return Err(VCardError::InvalidParameter("unexpected quote in unquoted parameter value"))
          }
          pos = pos + 1
        }
        vals.push(unescape_param_value(string_slice_bytes(line, vstart, pos)))
      }
      if pos < n && line.code_unit_at(pos) == 44 {
        pos = pos + 1
        continue
      }
      break
    }
    params.push(VCardParam::{ name: pname_upper, values: vals })
  }

  if pos >= n || line.code_unit_at(pos) != 58 {
    return Err(VCardError::InvalidSyntax("expected ':' before property value"))
  }
  pos = pos + 1 // skip ':'

  let value = string_slice_bytes(line, pos, n)
  Ok(VCardProperty::{ group: group, name: prop_name, params: params, value: value })
}

///| Parse a single vCard from `input` with default limits.
pub fn parse_card(input : String) -> Result[VCard, VCardError] {
  parse_card_with_limits(input, VCardLimits::default())
}

///| Parse a single vCard from `input` enforcing `limits`.
pub fn parse_card_with_limits(
  input : String,
  limits : VCardLimits,
) -> Result[VCard, VCardError] {
  let cards = match parse_stream_with_limits(input, limits) {
    Ok(cs) => cs
    Err(e) => return Err(e)
  }
  if cards.length() == 0 {
    return Err(VCardError::InvalidSyntax("missing VCARD component"))
  }
  if cards.length() > 1 {
    return Err(VCardError::InvalidSyntax("expected a single VCARD, found " + cards.length().to_string()))
  }
  Ok(cards[0])
}

///| Parse a multi-card `.vcf` stream from `input` with default limits.
pub fn parse_stream(input : String) -> Result[Array[VCard], VCardError] {
  parse_stream_with_limits(input, VCardLimits::default())
}

///| Parse a multi-card `.vcf` stream from `input` enforcing `limits`.
pub fn parse_stream_with_limits(
  input : String,
  limits : VCardLimits,
) -> Result[Array[VCard], VCardError] {
  let n = input.length()
  if n > limits.max_bytes {
    return Err(VCardError::LimitExceeded("input exceeds max_bytes"))
  }
  let mut pos = 0
  // Skip UTF-8 BOM if present
  if n >= 3 && input.code_unit_at(0) == 0xEF && input.code_unit_at(1) == 0xBB && input.code_unit_at(2) == 0xBF {
    pos = 3
  }

  let cards : Array[VCard] = []
  let mut in_card = false
  let mut cur_props : Array[VCardProperty] = []

  while pos < n {
    let line_buf = StringBuilder::new()
    let mut line_bytes = 0
    let mut first_colon_offset = -1
    let mut in_quotes = false
    let mut last_byte = -1

    while pos < n {
      let b = input.code_unit_at(pos)
      if b == 13 && pos + 1 < n && input.code_unit_at(pos + 1) == 10 {
        if pos + 2 < n {
          let next = input.code_unit_at(pos + 2)
          if next == 32 || next == 9 {
            pos = pos + 3
            continue
          }
        }
        // Check QP soft line break (`=\r\n` after `:` when header mentions QUOTED-PRINTABLE)
        if last_byte == 61 && first_colon_offset > 0 {
          let so_far = line_buf.to_string()
          if contains_ascii_ci(so_far, 0, first_colon_offset, "QUOTED-PRINTABLE") {
            line_bytes = line_bytes + 1
            if line_bytes > limits.max_line_bytes {
              return Err(VCardError::LimitExceeded("content line exceeds max_line_bytes"))
            }
            line_buf.write_byte((10).to_byte())
            last_byte = 10
            pos = pos + 2
            continue
          }
        }
        pos = pos + 2
        break
      }
      if b == 10 {
        if pos + 1 < n {
          let next = input.code_unit_at(pos + 1)
          if next == 32 || next == 9 {
            pos = pos + 2
            continue
          }
        }
        if last_byte == 61 && first_colon_offset > 0 {
          let so_far = line_buf.to_string()
          if contains_ascii_ci(so_far, 0, first_colon_offset, "QUOTED-PRINTABLE") {
            line_bytes = line_bytes + 1
            if line_bytes > limits.max_line_bytes {
              return Err(VCardError::LimitExceeded("content line exceeds max_line_bytes"))
            }
            line_buf.write_byte((10).to_byte())
            last_byte = 10
            pos = pos + 1
            continue
          }
        }
        pos = pos + 1
        break
      }
      if first_colon_offset < 0 {
        if b == 34 {
          in_quotes = !in_quotes
        } else if b == 58 && !in_quotes {
          first_colon_offset = line_bytes
        }
      }
      line_bytes = line_bytes + 1
      if line_bytes > limits.max_line_bytes {
        return Err(VCardError::LimitExceeded("content line exceeds max_line_bytes"))
      }
      line_buf.write_byte(b.to_byte())
      last_byte = b
      pos = pos + 1
    }

    if line_bytes == 0 {
      continue
    }

    let line = line_buf.to_string()
    let prop = match parse_property_line(line, limits.max_params_per_prop) {
      Ok(p) => p
      Err(e) => return Err(e)
    }

    if prop.name == "BEGIN" {
      let cname = ascii_to_upper(prop.value)
      if cname != "VCARD" {
        return Err(VCardError::InvalidSyntax("expected BEGIN:VCARD, got BEGIN:" + cname))
      }
      if in_card {
        return Err(VCardError::InvalidSyntax("nested BEGIN:VCARD is not allowed"))
      }
      if cards.length() >= limits.max_cards {
        return Err(VCardError::LimitExceeded("card count exceeds max_cards"))
      }
      in_card = true
      cur_props = []
    } else if prop.name == "END" {
      let cname = ascii_to_upper(prop.value)
      if cname != "VCARD" {
        return Err(VCardError::InvalidSyntax("expected END:VCARD, got END:" + cname))
      }
      if !in_card {
        return Err(VCardError::InvalidSyntax("unexpected END:VCARD outside card"))
      }
      cards.push(VCard::{ properties: cur_props })
      cur_props = []
      in_card = false
    } else {
      if !in_card {
        return Err(VCardError::InvalidSyntax("property outside VCARD: " + prop.name))
      }
      if cur_props.length() >= limits.max_properties_per_card {
        return Err(VCardError::LimitExceeded("properties per card exceeds max_properties_per_card"))
      }
      cur_props.push(prop)
    }
  }

  if in_card {
    return Err(VCardError::InvalidSyntax("unclosed VCARD (missing END:VCARD)"))
  }
  Ok(cards)
}

///| Validate UTF-8 on `input` bytes and parse a multi-card `.vcf` stream enforcing `limits`.
pub fn parse_bytes(
  input : Bytes,
  limits : VCardLimits,
) -> Result[Array[VCard], VCardError] {
  if input.length() > limits.max_bytes {
    return Err(VCardError::LimitExceeded("input exceeds max_bytes"))
  }
  if !is_valid_utf8(input) {
    return Err(VCardError::InvalidUtf8("input is not valid UTF-8"))
  }
  parse_stream_with_limits(input.to_string(), limits)
}
