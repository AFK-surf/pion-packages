///| Escaping, folding, unfolding, UTF-8 validation, Quoted-Printable, and `data:` URI helpers.

import "base64"

///| Validate that `bytes` is well-formed UTF-8 per RFC 3629.
pub fn is_valid_utf8(bytes : Bytes) -> Bool {
  let n = bytes.length()
  let mut i = 0
  while i < n {
    let b0 = bytes[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 == 0xE0 {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if b1 < 0xA0 || b1 > 0xBF || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if (b0 >= 0xE1 && b0 <= 0xEC) || b0 == 0xEE || b0 == 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 == 0xED {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if b1 < 0x80 || b1 > 0x9F || (b2 & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if b0 == 0xF0 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if b1 < 0x90 || b1 > 0xBF || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else if b0 >= 0xF1 && b0 <= 0xF3 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else if b0 == 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if b1 < 0x80 || b1 > 0x8F || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Unfold RFC 6350 §3.2 folded content lines (`CRLF`/`LF` followed by single `SP` or `HTAB`).
pub fn unfold_lines(input : String) -> String {
  let n = input.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = input.code_unit_at(i)
    if b == 13 && i + 2 < n && input.code_unit_at(i + 1) == 10 {
      let next = input.code_unit_at(i + 2)
      if next == 32 || next == 9 {
        i = i + 3
        continue
      }
    } else if b == 10 && i + 1 < n {
      let next = input.code_unit_at(i + 1)
      if next == 32 || next == 9 {
        i = i + 2
        continue
      }
    }
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Fold a single content line into `sb` at <= 75 UTF-8 octets per physical line without splitting codepoints.
fn write_folded_line_to(sb : StringBuilder, line : String) -> Unit {
  let n = line.length()
  if n <= 75 {
    sb.write_string(line)
    return
  }
  let mut pos = 0
  let mut first = true
  while pos < n {
    let max_chunk = if first { 75 } else { 74 }
    if !first {
      sb.write_byte((13).to_byte())
      sb.write_byte((10).to_byte())
      sb.write_byte((32).to_byte())
    }
    let mut end = pos + max_chunk
    if end >= n {
      end = n
    } else {
      // Back up if `end` lands on a UTF-8 continuation byte (10xxxxxx)
      while end > pos && (line.code_unit_at(end) & 0xC0) == 0x80 {
        end = end - 1
      }
      if end == pos {
        end = pos + 1
      }
    }
    let mut k = pos
    while k < end {
      sb.write_byte(line.code_unit_at(k).to_byte())
      k = k + 1
    }
    pos = end
    first = false
  }
}

///| Fold a single content line to <= 75 UTF-8 octets per physical line using `\r\n ` without splitting codepoints.
pub fn fold_line(line : String) -> String {
  if line.length() <= 75 {
    return line
  }
  let sb = StringBuilder::new()
  write_folded_line_to(sb, line)
  sb.to_string()
}

///| Escape RFC 6350 §3.4 TEXT value (`\\`, `\,`, `\;`, `\n`).
pub fn escape_text(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 || b == 59 || b == 44 || b == 10 || b == 13 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    let b = s.code_unit_at(k)
    if b == 92 {
      sb.write_byte((92).to_byte())
      sb.write_byte((92).to_byte())
    } else if b == 59 {
      sb.write_byte((92).to_byte())
      sb.write_byte((59).to_byte())
    } else if b == 44 {
      sb.write_byte((92).to_byte())
      sb.write_byte((44).to_byte())
    } else if b == 10 {
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
    } else if b == 13 {
      if k + 1 < n && s.code_unit_at(k + 1) == 10 {
        k = k + 1
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    k = k + 1
  }
  sb.to_string()
}

///| Unescape RFC 6350 §3.4 TEXT value (`\\`, `\,`, `\;`, `\n`, `\N`).
pub fn unescape_text(s : String) -> String {
  let n = s.length()
  let mut has_bs = false
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 92 {
      has_bs = true
      break
    }
    i = i + 1
  }
  if !has_bs {
    return s
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    let b = s.code_unit_at(k)
    if b == 92 && k + 1 < n {
      let next = s.code_unit_at(k + 1)
      if next == 110 || next == 78 {
        sb.write_byte((10).to_byte())
        k = k + 2
        continue
      }
      if next == 44 || next == 59 || next == 92 {
        sb.write_byte(next.to_byte())
        k = k + 2
        continue
      }
    }
    sb.write_byte(b.to_byte())
    k = k + 1
  }
  sb.to_string()
}

///| Escape RFC 6868 parameter value (`^` -> `^^`, `\n` -> `^n`, `"` -> `^'`).
pub fn escape_param_value(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 94 || b == 10 || b == 13 || b == 34 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    let b = s.code_unit_at(k)
    if b == 94 {
      sb.write_byte((94).to_byte())
      sb.write_byte((94).to_byte())
    } else if b == 10 {
      sb.write_byte((94).to_byte())
      sb.write_byte((110).to_byte())
    } else if b == 13 {
      if k + 1 < n && s.code_unit_at(k + 1) == 10 {
        k = k + 1
      }
      sb.write_byte((94).to_byte())
      sb.write_byte((110).to_byte())
    } else if b == 34 {
      sb.write_byte((94).to_byte())
      sb.write_byte((39).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    k = k + 1
  }
  sb.to_string()
}

///| Unescape RFC 6868 parameter value (`^n` -> LF, `^'` -> `"`, `^^` -> `^`; unknown `^x` preserved).
pub fn unescape_param_value(s : String) -> String {
  let n = s.length()
  let mut has_caret = false
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 94 {
      has_caret = true
      break
    }
    i = i + 1
  }
  if !has_caret {
    return s
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    let b = s.code_unit_at(k)
    if b == 94 && k + 1 < n {
      let next = s.code_unit_at(k + 1)
      if next == 110 {
        sb.write_byte((10).to_byte())
        k = k + 2
        continue
      }
      if next == 39 {
        sb.write_byte((34).to_byte())
        k = k + 2
        continue
      }
      if next == 94 {
        sb.write_byte((94).to_byte())
        k = k + 2
        continue
      }
    }
    sb.write_byte(b.to_byte())
    k = k + 1
  }
  sb.to_string()
}

///| Split `s` on unescaped occurrences of ASCII byte `sep` (e.g. `';'` = 59, `','` = 44), preserving escapes in each slice.
pub fn split_escaped(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 && i + 1 < n {
      i = i + 2
      continue
    }
    if b == sep {
      out.push(string_slice_bytes(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(string_slice_bytes(s, start, n))
  out
}

///| Split a comma-separated RFC 6350 text list and unescape each element.
pub fn split_text_list(s : String) -> Array[String] {
  if s.length() == 0 {
    return []
  }
  let parts = split_escaped(s, 44)
  let out : Array[String] = []
  let mut i = 0
  while i < parts.length() {
    out.push(unescape_text(parts[i]))
    i = i + 1
  }
  out
}

///| Join a list of text items with `,`, escaping each element.
pub fn join_text_list(items : Array[String]) -> String {
  let n = items.length()
  if n == 0 {
    return ""
  }
  if n == 1 {
    return escape_text(items[0])
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(escape_text(items[i]))
    i = i + 1
  }
  sb.to_string()
}

///| Parse a single ASCII hex digit into `0..15`, or `-1` if invalid.
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

///| Decode a RFC 2045 Quoted-Printable string into raw `Bytes`.
pub fn decode_quoted_printable_bytes(s : String) -> Result[Bytes, VCardError] {
  let n = s.length()
  let raw : Array[Byte] = []
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 61 {
      // Soft line break: `=\r\n` or `=\n`
      if i + 2 < n && s.code_unit_at(i + 1) == 13 && s.code_unit_at(i + 2) == 10 {
        i = i + 3
        continue
      }
      if i + 1 < n && s.code_unit_at(i + 1) == 10 {
        i = i + 2
        continue
      }
      if i + 2 < n {
        let hi = hex_nibble(s.code_unit_at(i + 1))
        let lo = hex_nibble(s.code_unit_at(i + 2))
        if hi >= 0 && lo >= 0 {
          raw.push(((hi << 4) | lo).to_byte())
          i = i + 3
          continue
        }
      }
      return Err(VCardError::InvalidValue("invalid Quoted-Printable escape sequence"))
    }
    raw.push(b.to_byte())
    i = i + 1
  }
  let out = Bytes::new(raw.length())
  let mut k = 0
  while k < raw.length() {
    out[k] = raw[k]
    k = k + 1
  }
  Ok(out)
}

///| Decode a RFC 2045 Quoted-Printable string into a UTF-8 `String`.
pub fn decode_quoted_printable(s : String) -> Result[String, VCardError] {
  let bytes = match decode_quoted_printable_bytes(s) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if !is_valid_utf8(bytes) {
    return Err(VCardError::InvalidUtf8("Quoted-Printable payload is not valid UTF-8"))
  }
  Ok(bytes.to_string())
}

///| Parse a `data:[<mediatype>][;base64],<data>` URI into a `BinaryValue`.
pub fn parse_data_uri(uri : String) -> Result[BinaryValue, VCardError] {
  let n = uri.length()
  if n < 5 {
    return Err(VCardError::InvalidValue("not a data: URI"))
  }
  if ascii_lower_byte(uri.code_unit_at(0)) != 100 ||
  ascii_lower_byte(uri.code_unit_at(1)) != 97 ||
  ascii_lower_byte(uri.code_unit_at(2)) != 116 ||
  ascii_lower_byte(uri.code_unit_at(3)) != 97 ||
  uri.code_unit_at(4) != 58 {
    return Err(VCardError::InvalidValue("URI does not start with data:"))
  }
  // Find comma separating metadata from payload
  let mut comma = -1
  let mut i = 5
  while i < n {
    if uri.code_unit_at(i) == 44 {
      comma = i
      break
    }
    i = i + 1
  }
  if comma < 0 {
    return Err(VCardError::InvalidValue("missing ',' in data: URI"))
  }
  let meta = string_slice_bytes(uri, 5, comma)
  let payload_str = string_slice_bytes(uri, comma + 1, n)

  // Check for `;base64` suffix in metadata
  let mut is_base64 = false
  let mut media_type : Option[String] = None
  if meta.length() > 0 {
    let parts = split_escaped(meta, 59)
    let np = parts.length()
    if np > 0 && ascii_eq_ignore_case(parts[np - 1], "base64") {
      is_base64 = true
      if np > 1 && parts[0].length() > 0 {
        media_type = Some(parts[0])
      }
    } else if parts[0].length() > 0 {
      media_type = Some(parts[0])
    }
  }

  if is_base64 {
    match base64::decode_loose(payload_str) {
      Ok(data) => Ok(BinaryValue::{ media_type: media_type, data: data })
      Err(e) => Err(VCardError::InvalidValue("invalid base64 in data: URI: " + base64::error_message(e)))
    }
  } else {
    Ok(BinaryValue::{ media_type: media_type, data: payload_str.to_bytes() })
  }
}

///| Format a `data:<media_type>;base64,<encoded>` URI from raw bytes.
pub fn format_data_uri(media_type : String, data : Bytes) -> String {
  let sb = StringBuilder::new()
  sb.write_string("data:")
  sb.write_string(media_type)
  sb.write_string(";base64,")
  sb.write_string(base64::encode(data))
  sb.to_string()
}
