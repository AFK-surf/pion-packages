///| Canonical RFC 6350 serializer with 75-octet UTF-8-safe folding and CRLF injection defense.

///| Check whether an escaped parameter value needs double-quoting per RFC 6350 §3.3.
fn param_needs_quotes(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 58 || c == 59 || c == 44 {
      return true
    }
    i = i + 1
  }
  false
}

///| Neutralize raw CR/LF in property values so serialization can never inject new content lines.
fn sanitize_property_value(s : String) -> String {
  let n = s.length()
  let mut has_ctl = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 10 || b == 13 {
      has_ctl = true
      break
    }
    i = i + 1
  }
  if !has_ctl {
    return s
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    let b = s.code_unit_at(k)
    if b == 13 {
      if k + 1 < n && s.code_unit_at(k + 1) == 10 {
        k = k + 1
      }
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
    } else if b == 10 {
      sb.write_byte((92).to_byte())
      sb.write_byte((110).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    k = k + 1
  }
  sb.to_string()
}

///| Serialize a single `VCardProperty` into `sb` as a 75-octet folded CRLF-terminated line.
fn write_property_to(sb : StringBuilder, prop : VCardProperty) -> Unit {
  let line_sb = StringBuilder::new()
  match prop.group {
    Some(g) => {
      line_sb.write_string(sanitize_vcard_name(g))
      line_sb.write_byte((46).to_byte())
    }
    None => ()
  }
  line_sb.write_string(sanitize_vcard_name(prop.name))
  let np = prop.params.length()
  let mut i = 0
  while i < np {
    let p = prop.params[i]
    line_sb.write_byte((59).to_byte())
    line_sb.write_string(sanitize_vcard_name(p.name))
    line_sb.write_byte((61).to_byte())
    let nv = p.values.length()
    let mut j = 0
    while j < nv {
      if j > 0 {
        line_sb.write_byte((44).to_byte())
      }
      let esc = escape_param_value(p.values[j])
      if param_needs_quotes(esc) {
        line_sb.write_byte((34).to_byte())
        line_sb.write_string(esc)
        line_sb.write_byte((34).to_byte())
      } else {
        line_sb.write_string(esc)
      }
      j = j + 1
    }
    i = i + 1
  }
  line_sb.write_byte((58).to_byte())
  line_sb.write_string(sanitize_property_value(prop.value))
  write_folded_line_to(sb, line_sb.to_string())
  sb.write_byte((13).to_byte())
  sb.write_byte((10).to_byte())
}

///| Write a single `VCard` into `sb` (`BEGIN:VCARD` .. `END:VCARD`).
fn write_card_to(sb : StringBuilder, card : VCard) -> Unit {
  sb.write_string("BEGIN:VCARD\r\n")
  // Emit VERSION first if present (RFC 6350 §6.7.9)
  let n = card.properties.length()
  let mut i = 0
  while i < n {
    if card.properties[i].name == "VERSION" {
      write_property_to(sb, card.properties[i])
    }
    i = i + 1
  }
  i = 0
  while i < n {
    if card.properties[i].name != "VERSION" {
      write_property_to(sb, card.properties[i])
    }
    i = i + 1
  }
  sb.write_string("END:VCARD\r\n")
}

///| Serialize a single `VCard` into canonical RFC 6350 text (`\r\n`, 75-octet UTF-8-safe folded).
pub fn format_card(card : VCard) -> String {
  let sb = StringBuilder::new()
  write_card_to(sb, card)
  sb.to_string()
}

///| Serialize a list of `VCard`s into a canonical multi-card `.vcf` stream.
pub fn format_stream(cards : Array[VCard]) -> String {
  let sb = StringBuilder::new()
  let n = cards.length()
  let mut i = 0
  while i < n {
    write_card_to(sb, cards[i])
    i = i + 1
  }
  sb.to_string()
}
