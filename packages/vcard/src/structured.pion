///| Parse an RFC 6350 `N` property value into a `StructuredName`.
pub fn StructuredName::parse(raw : String) -> StructuredName {
  let _ = raw
  StructuredName::new([], [], [], [], [])
}

///| Serialize a `StructuredName` into an RFC 6350 `N` property value.
pub fn StructuredName::to_value(self : StructuredName) -> String {
  let _ = self
  ""
}

///| Parse an RFC 6350 `ADR` property value into an `Address`.
pub fn Address::parse(raw : String) -> Address {
  let _ = raw
  Address::{
    po_box: [],
    extended: [],
    street: [],
    locality: [],
    region: [],
    postal_code: [],
    country: [],
    label: None,
    types: [],
    pref: None,
    group: None,
  }
}

///| Serialize an `Address` into an RFC 6350 `ADR` property value.
pub fn Address::to_value(self : Address) -> String {
  let _ = self
  ""
}

///| Parse an RFC 6350 `ORG` property value into an `Organization`.
pub fn Organization::parse(raw : String) -> Organization {
  let _ = raw
  Organization::{ units: [], types: [], pref: None, group: None }
}

///| Serialize an `Organization` into an RFC 6350 `ORG` property value.
pub fn Organization::to_value(self : Organization) -> String {
  let _ = self
  ""
}

///| Parse an RFC 6350 `GENDER` property value into a `Gender`.
pub fn Gender::parse(raw : String) -> Gender {
  let _ = raw
  Gender::{ sex: "", identity: None }
}

///| Serialize a `Gender` into an RFC 6350 `GENDER` property value.
pub fn Gender::to_value(self : Gender) -> String {
