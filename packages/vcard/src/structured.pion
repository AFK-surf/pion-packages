///| Structured vCard property parsers, formatters, and typed accessors.

import "base64"

///| Look up all values of parameter `name` (case-insensitive) across all matching params on a property.
pub fn VCardProperty::get_param(self : VCardProperty, name : String) -> Option[Array[String]] {
  let out : Array[String] = []
  let mut found = false
  let mut i = 0
  let n = self.params.length()
  while i < n {
    if ascii_eq_ignore_case(self.params[i].name, name) {
      found = true
      let vals = self.params[i].values
      let mut j = 0
      while j < vals.length() {
        out.push(vals[j])
        j = j + 1
      }
    }
    i = i + 1
  }
  if found {
    Some(out)
  } else {
    None
  }
}

///| Look up the first value of parameter `name` (case-insensitive) on a property.
pub fn VCardProperty::get_param_first(self : VCardProperty, name : String) -> Option[String] {
  let mut i = 0
  let n = self.params.length()
  while i < n {
    if ascii_eq_ignore_case(self.params[i].name, name) {
      if self.params[i].values.length() > 0 {
        return Some(self.params[i].values[0])
      }
    }
    i = i + 1
  }
  None
}

///| Return all `TYPE` parameter values (lowercased) on a property.
pub fn VCardProperty::types(self : VCardProperty) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  let n = self.params.length()
  while i < n {
    if ascii_eq_ignore_case(self.params[i].name, "TYPE") {
      let vals = self.params[i].values
      let mut j = 0
      while j < vals.length() {
        out.push(ascii_to_lower(vals[j]))
        j = j + 1
      }
    }
    i = i + 1
  }
  out
}

///| Return the parsed `PREF` integer parameter if present and valid (`1..100`).
pub fn VCardProperty::pref(self : VCardProperty) -> Option[Int] {
  match self.get_param_first("PREF") {
    Some(s) => {
      let v = parse_uint_strict(s)
      if v >= 1 && v <= 100 {
        Some(v)
      } else {
        None
      }
    }
    None => None
  }
}

///| Return the `ALTID` parameter value if present.
pub fn VCardProperty::altid(self : VCardProperty) -> Option[String] {
  self.get_param_first("ALTID")
}

///| Return all `PID` parameter values.
pub fn VCardProperty::pid(self : VCardProperty) -> Array[String] {
  match self.get_param("PID") {
    Some(vs) => vs
    None => []
  }
}

///| Return the `LANGUAGE` parameter value if present.
pub fn VCardProperty::language(self : VCardProperty) -> Option[String] {
  self.get_param_first("LANGUAGE")
}

///| Return the `VALUE` parameter value if present.
pub fn VCardProperty::value_type(self : VCardProperty) -> Option[String] {
  self.get_param_first("VALUE")
}

///| Return the `MEDIATYPE` parameter value if present.
pub fn VCardProperty::mediatype(self : VCardProperty) -> Option[String] {
  self.get_param_first("MEDIATYPE")
}

///| Decode a property's text value (handling `ENCODING=QUOTED-PRINTABLE` and RFC 6350 text unescaping).
pub fn VCardProperty::decoded_text(self : VCardProperty) -> Result[String, VCardError] {
  match self.get_param_first("ENCODING") {
    Some(enc) => {
      if ascii_eq_ignore_case(enc, "QUOTED-PRINTABLE") {
        return decode_quoted_printable(self.value)
      }
    }
    None => ()
  }
  Ok(unescape_text(self.value))
}

///| Decode a media/binary property (`PHOTO`, `LOGO`, `KEY`) as either a URI or inline binary bytes.
pub fn VCardProperty::decoded_media(self : VCardProperty) -> Result[MediaValue, VCardError] {
  // 1. Check vCard 3.0 / 2.1 `ENCODING=b` or `ENCODING=BASE64`
  match self.get_param_first("ENCODING") {
    Some(enc) => {
      if ascii_eq_ignore_case(enc, "b") || ascii_eq_ignore_case(enc, "BASE64") {
        let data = match base64::decode_loose(self.value) {
          Ok(d) => d
          Err(e) =>
          return Err(
            VCardError::InvalidValue("invalid base64 in " + self.name + ": " + base64::error_message(e)),
          )
        }
        let mt = match self.mediatype() {
          Some(m) => Some(m)
          None => self.get_param_first("TYPE")
        }
        return Ok(MediaValue::Inline(BinaryValue::{ media_type: mt, data: data }))
      }
    }
    None => ()
  }
  // 2. Check RFC 6350 `data:` URI
  let v = self.value
  if v.length() >= 5 &&
  ascii_lower_byte(v.code_unit_at(0)) == 100 &&
  ascii_lower_byte(v.code_unit_at(1)) == 97 &&
  ascii_lower_byte(v.code_unit_at(2)) == 116 &&
  ascii_lower_byte(v.code_unit_at(3)) == 97 &&
  v.code_unit_at(4) == 58 {
    match parse_data_uri(v) {
      Ok(bin) => return Ok(MediaValue::Inline(bin))
      Err(e) => return Err(e)
    }
  }
  // 3. Plain URI reference
  Ok(MediaValue::Uri(v))
}

///| Helper: get component `idx` from semicolon-split array as comma-split text list.
fn split_comp_at(parts : Array[String], idx : Int) -> Array[String] {
  if idx < parts.length() {
    split_text_list(parts[idx])
  } else {
    []
  }
}

///| Parse an RFC 6350 `N` property value into a `StructuredName`.
pub fn StructuredName::parse(raw : String) -> StructuredName {
  let parts = split_escaped(raw, 59)
  StructuredName::{
    family: split_comp_at(parts, 0),
    given: split_comp_at(parts, 1),
    additional: split_comp_at(parts, 2),
    prefixes: split_comp_at(parts, 3),
    suffixes: split_comp_at(parts, 4),
  }
}

///| Serialize a `StructuredName` into an RFC 6350 `N` property value.
pub fn StructuredName::to_value(self : StructuredName) -> String {
  let sb = StringBuilder::new()
  sb.write_string(join_text_list(self.family))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.given))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.additional))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.prefixes))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.suffixes))
  sb.to_string()
}

///| Parse an RFC 6350 `ADR` property value into an `Address`.
pub fn Address::parse(raw : String) -> Address {
  let parts = split_escaped(raw, 59)
  Address::{
    po_box: split_comp_at(parts, 0),
    extended: split_comp_at(parts, 1),
    street: split_comp_at(parts, 2),
    locality: split_comp_at(parts, 3),
    region: split_comp_at(parts, 4),
    postal_code: split_comp_at(parts, 5),
    country: split_comp_at(parts, 6),
    label: None,
    types: [],
    pref: None,
    group: None,
  }
}

///| Serialize an `Address` into an RFC 6350 `ADR` property value.
pub fn Address::to_value(self : Address) -> String {
  let sb = StringBuilder::new()
  sb.write_string(join_text_list(self.po_box))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.extended))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.street))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.locality))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.region))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.postal_code))
  sb.write_byte((59).to_byte())
  sb.write_string(join_text_list(self.country))
  sb.to_string()
}

///| Parse an RFC 6350 `ORG` property value into an `Organization`.
pub fn Organization::parse(raw : String) -> Organization {
  let parts = split_escaped(raw, 59)
  let units : Array[String] = []
  let mut i = 0
  while i < parts.length() {
    units.push(unescape_text(parts[i]))
    i = i + 1
  }
  Organization::{ units: units, types: [], pref: None, group: None }
}

///| Serialize an `Organization` into an RFC 6350 `ORG` property value.
pub fn Organization::to_value(self : Organization) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < self.units.length() {
    if i > 0 {
      sb.write_byte((59).to_byte())
    }
    sb.write_string(escape_text(self.units[i]))
    i = i + 1
  }
  sb.to_string()
}

///| Parse an RFC 6350 `GENDER` property value into a `Gender`.
pub fn Gender::parse(raw : String) -> Gender {
  let parts = split_escaped(raw, 59)
  let sex = if parts.length() > 0 { ascii_to_upper(unescape_text(parts[0])) } else { "" }
  let identity = if parts.length() > 1 && parts[1].length() > 0 {
    Some(unescape_text(parts[1]))
  } else {
    None
  }
  Gender::{ sex: sex, identity: identity }
}

///| Serialize a `Gender` into an RFC 6350 `GENDER` property value.
pub fn Gender::to_value(self : Gender) -> String {
  match self.identity {
    Some(id) => self.sex + ";" + escape_text(id)
    None => self.sex
  }
}

///| Parse an RFC 6350 `CLIENTPIDMAP` property value (`pid;uri`).
pub fn ClientPidMap::parse(raw : String) -> Result[ClientPidMap, VCardError] {
  let parts = split_escaped(raw, 59)
  if parts.length() != 2 {
    return Err(VCardError::InvalidValue("CLIENTPIDMAP must have format 'pid;uri': " + raw))
  }
  let pid = parse_uint_strict(parts[0])
  if pid <= 0 {
    return Err(VCardError::InvalidValue("CLIENTPIDMAP pid must be a positive integer: " + parts[0]))
  }
  if parts[1].length() == 0 {
    return Err(VCardError::InvalidValue("CLIENTPIDMAP uri must not be empty"))
  }
  Ok(ClientPidMap::{ pid: pid, uri: parts[1] })
}

///| Serialize a `ClientPidMap` into an RFC 6350 `CLIENTPIDMAP` property value.
pub fn ClientPidMap::to_value(self : ClientPidMap) -> String {
  self.pid.to_string() + ";" + self.uri
}

///| Parse 2 ASCII digits at `pos`, returning `-1` on failure.
fn parse_2d(s : String, pos : Int) -> Int {
  if pos + 2 > s.length() {
    return -1
  }
  let c0 = s.code_unit_at(pos) - 48
  let c1 = s.code_unit_at(pos + 1) - 48
  if c0 < 0 || c0 > 9 || c1 < 0 || c1 > 9 {
    return -1
  }
  c0 * 10 + c1
}

///| Parse 4 ASCII digits at `pos`, returning `-1` on failure.
fn parse_4d(s : String, pos : Int) -> Int {
  let hi = parse_2d(s, pos)
  let lo = parse_2d(s, pos + 2)
  if hi < 0 || lo < 0 {
    return -1
  }
  hi * 100 + lo
}

///| Parse an RFC 6350 / RFC 2426 `BDAY` or `ANNIVERSARY` date or partial date.
pub fn PartialDate::parse(raw : String) -> Result[PartialDate, VCardError] {
  let n = raw.length()
  if n == 0 {
    return Err(VCardError::InvalidValue("empty date"))
  }

  // Split optional time part at 'T' / 't'
  let mut t_pos = -1
  let mut i = 0
  while i < n {
    let c = raw.code_unit_at(i)
    if c == 84 || c == 116 {
      t_pos = i
      break
    }
    i = i + 1
  }
  let date_str = if t_pos >= 0 { string_slice_bytes(raw, 0, t_pos) } else { raw }
  let time_str = if t_pos >= 0 { string_slice_bytes(raw, t_pos + 1, n) } else { "" }

  let mut year : Option[Int] = None
  let mut month : Option[Int] = None
  let mut day : Option[Int] = None

  let dn = date_str.length()
  if dn == 4 && date_str.code_unit_at(0) == 45 && date_str.code_unit_at(1) == 45 {
    // --MM
    let m = parse_2d(date_str, 2)
    if m < 1 || m > 12 {
      return Err(VCardError::InvalidValue("invalid month: " + raw))
    }
    month = Some(m)
  } else if dn == 4 {
    // YYYY
    let y = parse_4d(date_str, 0)
    if y < 0 {
      return Err(VCardError::InvalidValue("invalid year: " + raw))
    }
    year = Some(y)
  } else if dn == 5 &&
  date_str.code_unit_at(0) == 45 &&
  date_str.code_unit_at(1) == 45 &&
  date_str.code_unit_at(2) == 45 {
    // ---DD
    let d = parse_2d(date_str, 3)
    if d < 1 || d > 31 {
      return Err(VCardError::InvalidValue("invalid day: " + raw))
    }
    day = Some(d)
  } else if dn == 6 && date_str.code_unit_at(0) == 45 && date_str.code_unit_at(1) == 45 {
    // --MMDD
    let m = parse_2d(date_str, 2)
    let d = parse_2d(date_str, 4)
    if m < 1 || m > 12 || d < 1 || d > 31 {
      return Err(VCardError::InvalidValue("invalid --MMDD: " + raw))
    }
    month = Some(m)
    day = Some(d)
  } else if dn == 7 &&
  date_str.code_unit_at(0) == 45 &&
  date_str.code_unit_at(1) == 45 &&
  date_str.code_unit_at(4) == 45 {
    // --MM-DD
    let m = parse_2d(date_str, 2)
    let d = parse_2d(date_str, 5)
    if m < 1 || m > 12 || d < 1 || d > 31 {
      return Err(VCardError::InvalidValue("invalid --MM-DD: " + raw))
    }
    month = Some(m)
    day = Some(d)
  } else if dn == 7 && date_str.code_unit_at(4) == 45 {
    // YYYY-MM
    let y = parse_4d(date_str, 0)
    let m = parse_2d(date_str, 5)
    if y < 0 || m < 1 || m > 12 {
      return Err(VCardError::InvalidValue("invalid YYYY-MM: " + raw))
    }
    year = Some(y)
    month = Some(m)
  } else if dn == 8 {
    // YYYYMMDD
    let y = parse_4d(date_str, 0)
    let m = parse_2d(date_str, 4)
    let d = parse_2d(date_str, 6)
    if y < 0 || m < 1 || m > 12 || d < 1 || d > 31 {
      return Err(VCardError::InvalidValue("invalid YYYYMMDD: " + raw))
    }
    year = Some(y)
    month = Some(m)
    day = Some(d)
  } else if dn == 10 && date_str.code_unit_at(4) == 45 && date_str.code_unit_at(7) == 45 {
    // YYYY-MM-DD
    let y = parse_4d(date_str, 0)
    let m = parse_2d(date_str, 5)
    let d = parse_2d(date_str, 8)
    if y < 0 || m < 1 || m > 12 || d < 1 || d > 31 {
      return Err(VCardError::InvalidValue("invalid YYYY-MM-DD: " + raw))
    }
    year = Some(y)
    month = Some(m)
    day = Some(d)
  } else if dn > 0 {
    return Err(VCardError::InvalidValue("unrecognized date format: " + raw))
  }

  let mut hour : Option[Int] = None
  let mut minute : Option[Int] = None
  let mut second : Option[Int] = None
  let mut tz_offset : Option[String] = None

  if t_pos >= 0 {
    let tn = time_str.length()
    if tn < 2 {
      return Err(VCardError::InvalidValue("invalid time component: " + raw))
    }
    // Find timezone suffix (Z, +, -)
    let mut tz_pos = tn
    let mut k = 0
    while k < tn {
      let c = time_str.code_unit_at(k)
      if c == 90 || c == 122 || c == 43 || c == 45 {
        tz_pos = k
        break
      }
      k = k + 1
    }
    if tz_pos < tn {
      tz_offset = Some(ascii_to_upper(string_slice_bytes(time_str, tz_pos, tn)))
    }
    let core_t = string_slice_bytes(time_str, 0, tz_pos)
    let ctn = core_t.length()
    if ctn == 6 {
      // HHMMSS
      let h = parse_2d(core_t, 0)
      let mi = parse_2d(core_t, 2)
      let sc = parse_2d(core_t, 4)
      if h < 0 || h > 23 || mi < 0 || mi > 59 || sc < 0 || sc > 60 {
        return Err(VCardError::InvalidValue("invalid HHMMSS: " + raw))
      }
      hour = Some(h)
      minute = Some(mi)
      second = Some(sc)
    } else if ctn == 8 && core_t.code_unit_at(2) == 58 && core_t.code_unit_at(5) == 58 {
      // HH:MM:SS
      let h = parse_2d(core_t, 0)
      let mi = parse_2d(core_t, 3)
      let sc = parse_2d(core_t, 6)
      if h < 0 || h > 23 || mi < 0 || mi > 59 || sc < 0 || sc > 60 {
        return Err(VCardError::InvalidValue("invalid HH:MM:SS: " + raw))
      }
      hour = Some(h)
      minute = Some(mi)
      second = Some(sc)
    } else if ctn == 4 {
      let h = parse_2d(core_t, 0)
      let mi = parse_2d(core_t, 2)
      if h < 0 || h > 23 || mi < 0 || mi > 59 {
        return Err(VCardError::InvalidValue("invalid HHMM: " + raw))
      }
      hour = Some(h)
      minute = Some(mi)
    } else {
      return Err(VCardError::InvalidValue("unrecognized time format: " + raw))
    }
  }

  Ok(
    PartialDate::{
      year: year,
      month: month,
      day: day,
      hour: hour,
      minute: minute,
      second: second,
      tz_offset: tz_offset,
      raw: raw,
    },
  )
}

///| Parse an RFC 6350 `geo:lat,lon` or RFC 2426 `lat;lon` `GEO` value.
pub fn Geo::parse(raw : String) -> Result[Geo, VCardError] {
  let n = raw.length()
  if n >= 4 &&
  ascii_lower_byte(raw.code_unit_at(0)) == 103 &&
  ascii_lower_byte(raw.code_unit_at(1)) == 101 &&
  ascii_lower_byte(raw.code_unit_at(2)) == 111 &&
  raw.code_unit_at(3) == 58 {
    // RFC 6350 `geo:lat,lon[;u=...]`
    let body = string_slice_bytes(raw, 4, n)
    let semi_parts = split_escaped(body, 59)
    let coords = split_escaped(semi_parts[0], 44)
    if coords.length() < 2 || coords[0].length() == 0 || coords[1].length() == 0 {
      return Err(VCardError::InvalidValue("invalid geo: URI: " + raw))
    }
    return Ok(Geo::{ latitude: coords[0], longitude: coords[1] })
  }
  // RFC 2426 `lat;lon`
  let parts = split_escaped(raw, 59)
  if parts.length() != 2 || parts[0].length() == 0 || parts[1].length() == 0 {
    return Err(VCardError::InvalidValue("invalid GEO value: " + raw))
  }
  Ok(Geo::{ latitude: parts[0], longitude: parts[1] })
}

///| Return the first property matching `name` (case-insensitive).
pub fn VCard::get_property(self : VCard, name : String) -> Option[VCardProperty] {
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    if ascii_eq_ignore_case(self.properties[i].name, name) {
      return Some(self.properties[i])
    }
    i = i + 1
  }
  None
}

///| Return all properties matching `name` (case-insensitive).
pub fn VCard::get_properties(self : VCard, name : String) -> Array[VCardProperty] {
  let out : Array[VCardProperty] = []
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    if ascii_eq_ignore_case(self.properties[i].name, name) {
      out.push(self.properties[i])
    }
    i = i + 1
  }
  out
}

///| Return all properties belonging to `group` (case-insensitive).
pub fn VCard::get_group_properties(self : VCard, group : String) -> Array[VCardProperty] {
  let out : Array[VCardProperty] = []
  let mut i = 0
  let n = self.properties.length()
  while i < n {
    match self.properties[i].group {
      Some(g) => {
        if ascii_eq_ignore_case(g, group) {
          out.push(self.properties[i])
        }
      }
      None => ()
    }
    i = i + 1
  }
  out
}

///| Return the parsed `VERSION` of this vCard.
pub fn VCard::version(self : VCard) -> Option[VCardVersion] {
  match self.get_property("VERSION") {
    Some(p) => {
      if p.value == "4.0" {
        Some(VCardVersion::V4_0)
      } else if p.value == "3.0" {
        Some(VCardVersion::V3_0)
      } else if p.value == "2.1" {
        Some(VCardVersion::V2_1)
      } else {
        Some(VCardVersion::Other(p.value))
      }
    }
    None => None
  }
}

///| Return the decoded `FN` (formatted name) of this vCard.
pub fn VCard::fn_name(self : VCard) -> Option[String] {
  match self.get_property("FN") {
    Some(p) => {
      match p.decoded_text() {
        Ok(t) => Some(t)
        Err(_) => Some(unescape_text(p.value))
      }
    }
    None => None
  }
}

///| Return the parsed `N` structured name of this vCard.
pub fn VCard::structured_name(self : VCard) -> Option[StructuredName] {
  match self.get_property("N") {
    Some(p) => Some(StructuredName::parse(p.value))
    None => None
  }
}

///| Return all unescaped `NICKNAME` items across all `NICKNAME` properties.
pub fn VCard::nicknames(self : VCard) -> Array[String] {
  let out : Array[String] = []
  let props = self.get_properties("NICKNAME")
  let mut i = 0
  while i < props.length() {
    let items = split_text_list(props[i].value)
    let mut j = 0
    while j < items.length() {
      out.push(items[j])
      j = j + 1
    }
    i = i + 1
  }
  out
}

///| Return all parsed `ADR` addresses.
pub fn VCard::addresses(self : VCard) -> Array[Address] {
  let out : Array[Address] = []
  let props = self.get_properties("ADR")
  let mut i = 0
  while i < props.length() {
    let p = props[i]
    let a = Address::parse(p.value)
    out.push(
      Address::{
        po_box: a.po_box,
        extended: a.extended,
        street: a.street,
        locality: a.locality,
        region: a.region,
        postal_code: a.postal_code,
        country: a.country,
        label: p.get_param_first("LABEL"),
        types: p.types(),
        pref: p.pref(),
        group: p.group,
      },
    )
    i = i + 1
  }
  out
}

///| Return all parsed `ORG` organizations.
pub fn VCard::organizations(self : VCard) -> Array[Organization] {
  let out : Array[Organization] = []
  let props = self.get_properties("ORG")
  let mut i = 0
  while i < props.length() {
    let p = props[i]
    let o = Organization::parse(p.value)
    out.push(
      Organization::{
        units: o.units,
        types: p.types(),
        pref: p.pref(),
        group: p.group,
      },
    )
    i = i + 1
  }
  out
}

///| Helper: extract `TypedValue` list for a property name.
fn vcard_typed_values(card : VCard, name : String) -> Array[TypedValue] {
  let out : Array[TypedValue] = []
  let mut i = 0
  let n = card.properties.length()
  while i < n {
    let p = card.properties[i]
    if ascii_eq_ignore_case(p.name, name) {
      out.push(
        TypedValue::{
          value: p.value,
          types: p.types(),
          pref: p.pref(),
          altid: p.altid(),
          pid: p.pid(),
          group: p.group,
        },
      )
    }
    i = i + 1
  }
  out
}

///| Return all `EMAIL` properties as `TypedValue`.
pub fn VCard::emails(self : VCard) -> Array[TypedValue] {
  vcard_typed_values(self, "EMAIL")
}

///| Return all `TEL` properties as `TypedValue`.
pub fn VCard::phones(self : VCard) -> Array[TypedValue] {
  vcard_typed_values(self, "TEL")
}

///| Return all `IMPP` properties as `TypedValue`.
pub fn VCard::impps(self : VCard) -> Array[TypedValue] {
