}

///| Return the parsed `BDAY` partial date if present.
pub fn VCard::birthday(self : VCard) -> Result[Option[PartialDate], VCardError] {
  match self.get_property("BDAY") {
    Some(p) => {
      match PartialDate::parse(p.value) {
        Ok(d) => Ok(Some(d))
        Err(e) => Err(e)
      }
    }
    None => Ok(None)
  }
}

///| Return the parsed `ANNIVERSARY` partial date if present.
pub fn VCard::anniversary(self : VCard) -> Result[Option[PartialDate], VCardError] {
  match self.get_property("ANNIVERSARY") {
    Some(p) => {
      match PartialDate::parse(p.value) {
        Ok(d) => Ok(Some(d))
        Err(e) => Err(e)
      }
    }
    None => Ok(None)
  }
}

///| Return the parsed `GEO` coordinates if present.
pub fn VCard::geo(self : VCard) -> Result[Option[Geo], VCardError] {
  match self.get_property("GEO") {
    Some(p) => {
      match Geo::parse(p.value) {
        Ok(g) => Ok(Some(g))
        Err(e) => Err(e)
      }
    }
    None => Ok(None)
  }
}

///| Return the `TZ` value if present.
pub fn VCard::tz(self : VCard) -> Option[String] {
  match self.get_property("TZ") {
    Some(p) => Some(unescape_text(p.value))
    None => None
  }
}

///| Return the `UID` value if present.
pub fn VCard::uid(self : VCard) -> Option[String] {
