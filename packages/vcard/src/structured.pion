  }
}

///| Return the `PRODID` value if present.
pub fn VCard::prodid(self : VCard) -> Option[String] {
  match self.get_property("PRODID") {
    Some(p) => Some(unescape_text(p.value))
    None => None
  }
}

///| Return all unescaped `CATEGORIES` items across all `CATEGORIES` properties.
pub fn VCard::categories(self : VCard) -> Array[String] {
  let out : Array[String] = []
  let props = self.get_properties("CATEGORIES")
  let mut i = 0
  while i < props.length() {
    let items = split_text_list(props[i].value)
    let mut j = 0
    while j < items.length() {
      out.push(items[j])
      j = j + 1
    }
    i = i + 1
  }
  out
}

///| Return all decoded `NOTE` values.
pub fn VCard::notes(self : VCard) -> Array[String] {
  let out : Array[String] = []
  let props = self.get_properties("NOTE")
  let mut i = 0
  while i < props.length() {
    match props[i].decoded_text() {
      Ok(t) => out.push(t)
      Err(_) => out.push(unescape_text(props[i].value))
    }
    i = i + 1
  }
  out
}

///| Return the `KIND` value if present.
pub fn VCard::kind(self : VCard) -> Option[String] {
  match self.get_property("KIND") {
    Some(p) => Some(ascii_to_lower(p.value))
    None => None
  }
}

///| Return all `LANG` properties as `TypedValue`.
pub fn VCard::langs(self : VCard) -> Array[TypedValue] {
  vcard_typed_values(self, "LANG")
}

///| Return the parsed `GENDER` if present.
pub fn VCard::gender(self : VCard) -> Option[Gender] {
  match self.get_property("GENDER") {
    Some(p) => Some(Gender::parse(p.value))
    None => None
  }
}

///| Return all `MEMBER` URIs.
pub fn VCard::members(self : VCard) -> Array[String] {
  let out : Array[String] = []
  let props = self.get_properties("MEMBER")
  let mut i = 0
  while i < props.length() {
    out.push(props[i].value)
    i = i + 1
  }
  out
}

///| Return all `RELATED` properties as `TypedValue`.
pub fn VCard::related(self : VCard) -> Array[TypedValue] {
  vcard_typed_values(self, "RELATED")
}

///| Return all parsed `CLIENTPIDMAP` entries.
pub fn VCard::clientpidmaps(self : VCard) -> Result[Array[ClientPidMap], VCardError] {
  let out : Array[ClientPidMap] = []
  let props = self.get_properties("CLIENTPIDMAP")
  let mut i = 0
  while i < props.length() {
    match ClientPidMap::parse(props[i].value) {
      Ok(m) => out.push(m)
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(out)
}

///| Helper: decode all media properties of `name`.
fn vcard_media_values(card : VCard, name : String) -> Result[Array[MediaValue], VCardError] {
  let out : Array[MediaValue] = []
  let props = card.get_properties(name)
  let mut i = 0
  while i < props.length() {
    match props[i].decoded_media() {
      Ok(m) => out.push(m)
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(out)
}

///| Return all decoded `PHOTO` media values.
pub fn VCard::photos(self : VCard) -> Result[Array[MediaValue], VCardError] {
  vcard_media_values(self, "PHOTO")
}

///| Return all decoded `LOGO` media values.
pub fn VCard::logos(self : VCard) -> Result[Array[MediaValue], VCardError] {
  vcard_media_values(self, "LOGO")
}

///| Return all decoded `KEY` media values.
pub fn VCard::keys(self : VCard) -> Result[Array[MediaValue], VCardError] {
  vcard_media_values(self, "KEY")
}
