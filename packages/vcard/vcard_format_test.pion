///| Validation, 75-octet UTF-8-safe folding, CRLF injection defense, and canonical roundtrip tests.

///|
fn assert_eq(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///| Verify every physical line in `folded` is <= 75 bytes and never splits a UTF-8 codepoint.
fn assert_valid_75_octet_fold(folded : String, label : String) -> Unit {
  let n = folded.length()
  let mut seg_start = 0
  let mut i = 0
  while i <= n {
    let is_end = i == n || (folded.code_unit_at(i) == 13 && i + 1 < n && folded.code_unit_at(i + 1) == 10)
    if is_end {
      let seg_len = i - seg_start
      debug_assert(
        seg_len <= 75,
        label + ": physical line exceeds 75 octets: " + seg_len.to_string(),
      )
      if seg_len > 0 {
        let first_b = folded.code_unit_at(seg_start)
        debug_assert(
          (first_b & 0xC0) != 0x80,
          label + ": fold split mid-UTF-8 codepoint at segment start",
        )
        // If continuation line, check byte after leading space too
        if seg_start > 0 && seg_len > 1 {
          debug_assert(first_b == 32, label + ": continuation line must start with SP")
          let second_b = folded.code_unit_at(seg_start + 1)
          debug_assert(
            (second_b & 0xC0) != 0x80,
            label + ": fold split mid-UTF-8 codepoint after SP",
          )
        }
      }
      // Verify the segment itself is valid UTF-8
      let seg = Bytes::new(seg_len)
      let mut k = 0
      while k < seg_len {
        seg[k] = folded.code_unit_at(seg_start + k).to_byte()
        k = k + 1
      }
      debug_assert(is_valid_utf8(seg), label + ": folded segment is not valid UTF-8")
      if i == n {
        break
      }
      i = i + 2
      seg_start = i
    } else {
      i = i + 1
    }
  }
}

///|
test "fold_line_75_octets_ascii_cjk_and_emoji" {
  let short = "FN:Short Name"
  assert_eq(fold_line(short), short, "short line unchanged")

  let long_ascii = "NOTE:0123456789012345678901234567890123456789012345678901234567890123456789ABCDEF"
  let f_ascii = fold_line(long_ascii)
  assert_valid_75_octet_fold(f_ascii, "long ASCII")
  assert_eq(unfold_lines(f_ascii), long_ascii, "ASCII fold/unfold roundtrip")

  // 3-byte CJK characters crossing 75-byte boundary
  let cjk = "NOTE:通讯录联系人备注信息包含大量中文汉字用于严格验证七十五字节折行绝不截断多字节字符序列"
  let f_cjk = fold_line(cjk)
  assert_valid_75_octet_fold(f_cjk, "CJK 3-byte")
  assert_eq(unfold_lines(f_cjk), cjk, "CJK fold/unfold roundtrip")

  // 4-byte emoji characters crossing 75-byte boundary at different offsets
  let emoji = "NOTE:abc🎉🚀🌏🎯🔥💡✨🌟🎉🚀🌏🎯🔥💡✨🌟🎉🚀🌏🎯🔥💡✨🌟🎉🚀🌏🎯🔥💡✨🌟"
  let f_emoji = fold_line(emoji)
  assert_valid_75_octet_fold(f_emoji, "Emoji 4-byte")
  assert_eq(unfold_lines(f_emoji), emoji, "Emoji fold/unfold roundtrip")
}

///|
test "rfc6350_validation_rules" {
  // Valid vCard 4.0
  let valid_raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "FN:Jane Doe\r\n" +
  "EMAIL;PREF=1:jane@example.com\r\n" +
  "EMAIL;PREF=100:jane.alt@example.com\r\n" +
  "GENDER:F\r\n" +
  "END:VCARD\r\n"
  let valid_card = match parse_card(valid_raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match validate(valid_card) {
    Ok(_) => ()
    Err(errs) => debug_assert(false, "expected valid card, got " + errs.length().to_string() + " errors")
  }

  // Missing VERSION and missing FN
  let empty_card = VCard::new()
  match validate(empty_card) {
    Err(errs) => debug_assert(errs.length() >= 2, "missing VERSION and FN should report >=2 errors")
    Ok(_) => debug_assert(false, "empty card must fail validation")
  }

  // PREF out of range (0 and 101)
  let bad_pref_raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "FN:Bad Pref\r\n" +
  "EMAIL;PREF=0:a@example.com\r\n" +
  "EMAIL;PREF=101:b@example.com\r\n" +
  "END:VCARD\r\n"
  let bad_pref = match parse_card(bad_pref_raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match validate(bad_pref) {
    Err(errs) => debug_assert(errs.length() >= 2, "PREF=0 and PREF=101 must fail validation")
    Ok(_) => debug_assert(false, "invalid PREF must fail validation")
  }

  // Invalid GENDER sex code
  let bad_gender_raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "FN:Bad Gender\r\n" +
  "GENDER:X\r\n" +
  "END:VCARD\r\n"
  let bad_gender = match parse_card(bad_gender_raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match validate(bad_gender) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "GENDER:X must fail validation")
  }

  // MEMBER without KIND:group must fail; with KIND:group must pass
  let bad_member_raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "KIND:individual\r\n" +
  "FN:Not A Group\r\n" +
  "MEMBER:urn:uuid:03a0e51f-d1aa-4385-8a53-e29025acd8af\r\n" +
  "END:VCARD\r\n"
  let bad_member = match parse_card(bad_member_raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match validate(bad_member) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "MEMBER on KIND:individual must fail")
  }

  let ok_group_raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "KIND:group\r\n" +
  "FN:Core Team\r\n" +
  "MEMBER:urn:uuid:03a0e51f-d1aa-4385-8a53-e29025acd8af\r\n" +
  "END:VCARD\r\n"
  let ok_group = match parse_card(ok_group_raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match validate(ok_group) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "MEMBER on KIND:group must pass")
  }
}

///|
test "crlf_injection_defense_and_canonical_roundtrip" {
  // Attempt CRLF injection in property value and parameter value
  let card = VCard::{
    properties: [
      VCardProperty::new("VERSION", "4.0"),
      VCardProperty::with_group(
        Some("item1"),
        "FN",
        [VCardParam::new("X-NOTE", "Safe\r\nEMAIL:evil@attacker.test")],
        "Alice\r\nEMAIL:injected@attacker.test",
      ),
      VCardProperty::with_params(
        "EMAIL",
        [VCardParam::with_values("TYPE", ["work", "internet"]), VCardParam::new("PREF", "1")],
        "alice@example.com",
      ),
    ],
  }
  let formatted = format_card(card)
  let reparsed = match parse_card(formatted) {
    Ok(c) => c
    Err(e) => { debug_assert(false, "reparse formatted failed: " + vcard_error_to_string(e)); return }
  }
  // Must have ONLY 1 EMAIL property (the legitimate one), never the injected ones!
  let emails = reparsed.emails()
  debug_assert(emails.length() == 1, "CRLF injection must not create extra EMAIL properties")
  assert_eq(emails[0].value, "alice@example.com", "only legitimate email present")
  match reparsed.fn_name() {
    Some(name) => assert_eq(name, "Alice\nEMAIL:injected@attacker.test", "CRLF neutralized as \\n in FN")
    None => debug_assert(false, "expected FN")
  }

  // Stream roundtrip with 2 cards
  let stream_out = format_stream([card, reparsed])
  let stream_back = match parse_stream(stream_out) {
    Ok(cs) => cs
    Err(e) => { debug_assert(false, "reparse stream failed: " + vcard_error_to_string(e)); return }
  }
  debug_assert(stream_back.length() == 2, "stream roundtrip preserves 2 cards")
}
