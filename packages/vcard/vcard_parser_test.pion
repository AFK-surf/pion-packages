///| RFC 6350 / RFC 2426 / RFC 6868 content-line lexing, unfolding, QP, multi-card stream, and DoS limits tests.

///|
fn assert_eq_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn assert_eq_int(got : Int, expected : Int, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

///|
test "unfold_lines_crlf_lf_and_utf8" {
  let raw = "NOTE:This is a lo\r\n ng note\r\n\twith tabs.\r\nFN:Alice\r\n"
  assert_eq_str(
    unfold_lines(raw),
    "NOTE:This is a long notewith tabs.\r\nFN:Alice\r\n",
    "CRLF + SP/HTAB unfolding",
  )

  let raw_lf = "FN:Hello \n World\n\t!\n"
  assert_eq_str(unfold_lines(raw_lf), "FN:Hello World!\n", "LF + SP/HTAB unfolding")

  // UTF-8 CJK and emoji across fold boundaries
  let utf8_folded = "FN:张三丰\r\n  武当派\r\n\t🎉创始人\r\n"
  assert_eq_str(
    unfold_lines(utf8_folded),
    "FN:张三丰 武当派🎉创始人\r\n",
    "UTF-8 unfolding preserves second space and multibyte sequences",
  )
}

///|
test "utf8_validation_and_parse_bytes" {
  let valid = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:山田太郎 🚀\r\nEND:VCARD\r\n"
  debug_assert(is_valid_utf8(valid.to_bytes()), "valid UTF-8 accepted")
  match parse_bytes(valid.to_bytes(), VCardLimits::default()) {
    Ok(cards) => {
      assert_eq_int(cards.length(), 1, "parse_bytes 1 card")
      match cards[0].fn_name() {
        Some(name) => assert_eq_str(name, "山田太郎 🚀", "UTF-8 FN preserved")
        None => debug_assert(false, "expected FN")
      }
    }
    Err(e) => debug_assert(false, "parse_bytes failed: " + vcard_error_to_string(e))
  }

  // Invalid UTF-8: lone continuation byte 0x80 and truncated 3-byte sequence 0xE4 0xB8
  let bad1 = Bytes::new(4)
  bad1[0] = (0x41).to_byte()
  bad1[1] = (0x80).to_byte()
  bad1[2] = (0x42).to_byte()
  bad1[3] = (0x43).to_byte()
  debug_assert(!is_valid_utf8(bad1), "lone continuation byte rejected")
  match parse_bytes(bad1, VCardLimits::default()) {
    Err(VCardError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "expected InvalidUtf8 error for bad1")
  }

  let bad2 = Bytes::new(2)
  bad2[0] = (0xE4).to_byte()
  bad2[1] = (0xB8).to_byte()
  debug_assert(!is_valid_utf8(bad2), "truncated 3-byte sequence rejected")

  // Overlong 2-byte encoding of '/' (0xC0 0xAF) must be rejected
  let bad3 = Bytes::new(2)
  bad3[0] = (0xC0).to_byte()
  bad3[1] = (0xAF).to_byte()
  debug_assert(!is_valid_utf8(bad3), "overlong UTF-8 rejected")
}

///|
test "content_line_groups_params_and_rfc6868" {
  let line = "item1.email;type=work,internet;pref=1;x-label=\"Room ^'42^'^^North^nFloor 2\":alice@example.com"
  let prop = match parse_property_line(line, 64) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_property_line failed: " + vcard_error_to_string(e))
      return
    }
  }
  match prop.group {
    Some(g) => assert_eq_str(g, "item1", "group preserved")
    None => debug_assert(false, "expected group item1")
  }
  assert_eq_str(prop.name, "EMAIL", "property name uppercased")
  assert_eq_str(prop.value, "alice@example.com", "property value")

  let types = prop.types()
  assert_eq_int(types.length(), 2, "two TYPE values")
  assert_eq_str(types[0], "work", "first type")
  assert_eq_str(types[1], "internet", "second type")

  match prop.pref() {
    Some(p) => assert_eq_int(p, 1, "PREF=1")
    None => debug_assert(false, "expected PREF=1")
  }
  match prop.get_param_first("X-LABEL") {
    Some(lbl) => assert_eq_str(lbl, "Room \"42\"^North\nFloor 2", "RFC 6868 unescape")
    None => debug_assert(false, "expected X-LABEL")
  }

  // Unknown ^x in RFC 6868 preserved verbatim
  assert_eq_str(unescape_param_value("foo^xbar"), "foo^xbar", "unknown ^x preserved")
  assert_eq_str(
    escape_param_value("Alice \"Ace\" ^\nSmith"),
    "Alice ^'Ace^' ^^^nSmith",
    "RFC 6868 escape_param_value",
  )
  assert_eq_str(
    unescape_param_value(escape_param_value("Alice \"Ace\" ^\nSmith")),
    "Alice \"Ace\" ^\nSmith",
    "RFC 6868 roundtrip",
  )

  // Invalid group name rejected
  match parse_property_line("bad group.FN:Alice", 64) {
    Err(VCardError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "expected InvalidSyntax for space in group")
  }
  // Empty group name rejected
  match parse_property_line(".FN:Alice", 64) {
    Err(VCardError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "expected InvalidSyntax for empty group")
  }
}

///|
test "vcard3_and_21_valueless_params_and_quoted_printable" {
  // vCard 2.1 / 3.0 bare parameters (WORK, VOICE, BASE64, QUOTED-PRINTABLE)
  let raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:3.0\r\n" +
  "FN;CHARSET=UTF-8;ENCODING=QUOTED-PRINTABLE:=E5=BC=A0=E4=B8=89=0A=E5=B7=A5=\r\n" +
  "=E7=A8=8B=E5=B8=88\r\n" +
  "TEL;WORK;VOICE;PREF:+1-555-0100\r\n" +
  "NOTE;QUOTED-PRINTABLE:Line1=0ALine2=2C=20with=20comma\r\n" +
  "END:VCARD\r\n"

  let card = match parse_card(raw) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "vCard 3.0 parse failed: " + vcard_error_to_string(e))
      return
    }
  }
  match card.version() {
    Some(VCardVersion::V3_0) => ()
    _ => debug_assert(false, "expected V3_0")
  }
  match card.fn_name() {
    Some(name) => assert_eq_str(name, "张三\n工程师", "QP decoded UTF-8 FN with soft break")
    None => debug_assert(false, "expected FN")
  }
  let phones = card.phones()
  assert_eq_int(phones.length(), 1, "1 phone")
  assert_eq_str(phones[0].value, "+1-555-0100", "phone value")
  assert_eq_int(phones[0].types.length(), 3, "bare WORK;VOICE;PREF collected as types")
  assert_eq_str(phones[0].types[0], "work", "bare type work")
  assert_eq_str(phones[0].types[1], "voice", "bare type voice")
  assert_eq_str(phones[0].types[2], "pref", "bare type pref")

  let notes = card.notes()
  assert_eq_int(notes.length(), 1, "1 note")
  assert_eq_str(notes[0], "Line1\nLine2, with comma", "bare QUOTED-PRINTABLE decoded")

  // Direct QP decode error on invalid hex
  match decode_quoted_printable("bad=ZZhex") {
    Err(VCardError::InvalidValue(_)) => ()
    _ => debug_assert(false, "expected InvalidValue for invalid QP hex")
  }
}

///|
test "multi_card_stream_groups_and_x_extensions" {
  // Include UTF-8 BOM and blank lines between cards
  let bom = "\u{FEFF}"
  let stream =
  bom +
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "FN:Alice Smith\r\n" +
  "item1.EMAIL;TYPE=work:alice@corp.example\r\n" +
  "item1.X-ABLabel:Work Primary\r\n" +
  "X-CUSTOM-ID:EMP-001\r\n" +
  "END:VCARD\r\n" +
  "\r\n" +
  "BEGIN:VCARD\r\n" +
  "VERSION:3.0\r\n" +
  "FN:Bob Jones\r\n" +
  "EMAIL;TYPE=HOME:bob@home.example\r\n" +
  "END:VCARD\r\n"

  let cards = match parse_stream(stream) {
    Ok(cs) => cs
    Err(e) => {
      debug_assert(false, "parse_stream failed: " + vcard_error_to_string(e))
      return
    }
  }
  assert_eq_int(cards.length(), 2, "2 cards in stream")
  match cards[0].fn_name() {
    Some(n) => assert_eq_str(n, "Alice Smith", "card 0 FN")
    None => debug_assert(false, "card 0 missing FN")
  }
  match cards[1].fn_name() {
    Some(n) => assert_eq_str(n, "Bob Jones", "card 1 FN")
    None => debug_assert(false, "card 1 missing FN")
  }

  let grp = cards[0].get_group_properties("ITEM1")
  assert_eq_int(grp.length(), 2, "group ITEM1 has 2 properties (case-insensitive)")
  assert_eq_str(grp[0].name, "EMAIL", "grp[0] EMAIL")
  assert_eq_str(grp[1].name, "X-ABLABEL", "grp[1] X-ABLABEL")

  match cards[0].get_property("x-custom-id") {
    Some(p) => assert_eq_str(p.value, "EMP-001", "X-* extension preserved")
    None => debug_assert(false, "expected X-CUSTOM-ID")
  }

  // parse_card rejects multi-card input
  match parse_card(stream) {
    Err(VCardError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "parse_card should reject multiple cards")
  }

  // Unclosed BEGIN:VCARD rejected
  match parse_stream("BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Unclosed\r\n") {
    Err(VCardError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "expected error for unclosed VCARD")
  }

  // Nested BEGIN:VCARD rejected
  match parse_stream("BEGIN:VCARD\r\nBEGIN:VCARD\r\nEND:VCARD\r\nEND:VCARD\r\n") {
    Err(VCardError::InvalidSyntax(_)) => ()
    _ => debug_assert(false, "expected error for nested VCARD")
  }
}

///|
test "dos_limits_enforced" {
  let card =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "FN:Limit Test\r\n" +
  "EMAIL;TYPE=work;PREF=1;ALTID=1:a@b.c\r\n" +
  "NOTE:012345678901234567890123456789\r\n" +
  "END:VCARD\r\n"

  // max_bytes
  let lim_bytes = VCardLimits::{
    max_bytes: 32,
    max_cards: 10,
    max_properties_per_card: 100,
    max_line_bytes: 1024,
    max_params_per_prop: 16,
  }
  match parse_stream_with_limits(card, lim_bytes) {
    Err(VCardError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_bytes")
  }

  // max_cards
  let two_cards = card + card
  let lim_cards = VCardLimits::{
    max_bytes: 65536,
    max_cards: 1,
    max_properties_per_card: 100,
    max_line_bytes: 1024,
    max_params_per_prop: 16,
  }
  match parse_stream_with_limits(two_cards, lim_cards) {
    Err(VCardError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_cards")
  }

  // max_properties_per_card
  let lim_props = VCardLimits::{
    max_bytes: 65536,
    max_cards: 10,
    max_properties_per_card: 2,
    max_line_bytes: 1024,
    max_params_per_prop: 16,
  }
  match parse_stream_with_limits(card, lim_props) {
    Err(VCardError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_properties_per_card")
  }

  // max_line_bytes
  let lim_line = VCardLimits::{
    max_bytes: 65536,
    max_cards: 10,
    max_properties_per_card: 100,
    max_line_bytes: 20,
    max_params_per_prop: 16,
  }
  match parse_stream_with_limits(card, lim_line) {
    Err(VCardError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_line_bytes")
  }

  // max_params_per_prop
  let lim_params = VCardLimits::{
    max_bytes: 65536,
    max_cards: 10,
    max_properties_per_card: 100,
    max_line_bytes: 1024,
    max_params_per_prop: 2,
  }
  match parse_stream_with_limits(card, lim_params) {
    Err(VCardError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_params_per_prop")
  }
}
