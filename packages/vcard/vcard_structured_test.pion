///| Structured properties (N, ADR, ORG, GENDER, CLIENTPIDMAP, BDAY/ANNIVERSARY, GEO, PHOTO/LOGO/KEY, PREF/ALTID/PID) tests.

import "base64"

///|
fn assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

///|
fn assert_int(got : Int, expected : Int, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

///|
test "structured_escaping_and_splitting" {
  // Must NOT split on escaped \; or \, and must handle escaped \\ before separator!
  let parts = split_escaped("a\\;b;c\\\\;d\\,e", 59)
  assert_int(parts.length(), 3, "split_escaped on ';'")
  assert_str(parts[0], "a\\;b", "part 0 keeps escaped semicolon")
  assert_str(parts[1], "c\\\\", "part 1 keeps escaped backslash before delimiter")
  assert_str(parts[2], "d\\,e", "part 2 keeps escaped comma")

  let items = split_text_list("foo\\,bar,baz\\;qux,line1\\nline2,back\\\\slash")
  assert_int(items.length(), 4, "split_text_list count")
  assert_str(items[0], "foo,bar", "item 0")
  assert_str(items[1], "baz;qux", "item 1")
  assert_str(items[2], "line1\nline2", "item 2")
  assert_str(items[3], "back\\slash", "item 3")

  assert_str(
    join_text_list(items),
    "foo\\,bar,baz\\;qux,line1\\nline2,back\\\\slash",
    "join_text_list roundtrip",
  )
}

///|
test "structured_name_adr_org_gender_clientpidmap" {
  // RFC 6350 §6.2.2 N with multi-value comma lists and escaped comma/semicolon
  let n_raw = "Stevenson,de la Cruz;John,Philip;Paul,Bauer;Dr.,Prof.;Jr.,M.D.,A.C.P."
  let sn = StructuredName::parse(n_raw)
  assert_int(sn.family.length(), 2, "N family count")
  assert_str(sn.family[0], "Stevenson", "N family[0]")
  assert_str(sn.family[1], "de la Cruz", "N family[1]")
  assert_int(sn.given.length(), 2, "N given count")
  assert_str(sn.given[0], "John", "N given[0]")
  assert_str(sn.given[1], "Philip", "N given[1]")
  assert_int(sn.prefixes.length(), 2, "N prefixes count")
  assert_int(sn.suffixes.length(), 3, "N suffixes count")
  assert_str(sn.to_value(), n_raw, "N roundtrip")

  // Escaped semicolon and comma inside N component must not split
  let n_esc = StructuredName::parse("O\\;Connor;Alice\\, Marie;;;")
  assert_int(n_esc.family.length(), 1, "escaped semicolon stays in family")
  assert_str(n_esc.family[0], "O;Connor", "unescaped semicolon in family")
  assert_int(n_esc.given.length(), 1, "escaped comma stays in given")
  assert_str(n_esc.given[0], "Alice, Marie", "unescaped comma in given")
  assert_str(n_esc.to_value(), "O\\;Connor;Alice\\, Marie;;;", "escaped N roundtrip")

  // RFC 6350 §6.3.1 ADR (7 components)
  let adr_raw = "PO Box 12;Suite 200\\; Bldg B;123 Main St\\, North;San Francisco;CA;94105;USA"
  let adr = Address::parse(adr_raw)
  assert_str(adr.po_box[0], "PO Box 12", "ADR po_box")
  assert_str(adr.extended[0], "Suite 200; Bldg B", "ADR extended")
  assert_str(adr.street[0], "123 Main St, North", "ADR street")
  assert_str(adr.locality[0], "San Francisco", "ADR locality")
  assert_str(adr.region[0], "CA", "ADR region")
  assert_str(adr.postal_code[0], "94105", "ADR postal_code")
  assert_str(adr.country[0], "USA", "ADR country")
  assert_str(adr.to_value(), adr_raw, "ADR roundtrip")

  // RFC 6350 §6.6.4 ORG hierarchy with escaped comma & semicolon
  let org_raw = "ABC\\, Inc.;North American Division;R\\;D Labs"
  let org = Organization::parse(org_raw)
  assert_int(org.units.length(), 3, "ORG 3 units")
  assert_str(org.units[0], "ABC, Inc.", "ORG unit 0")
  assert_str(org.units[1], "North American Division", "ORG unit 1")
  assert_str(org.units[2], "R;D Labs", "ORG unit 2")
  assert_str(org.to_value(), org_raw, "ORG roundtrip")

  // RFC 6350 §6.2.7 GENDER
  let g1 = Gender::parse("M")
  assert_str(g1.sex, "M", "gender M")
  debug_assert(match g1.identity { None => true; Some(_) => false }, "no identity")
  assert_str(g1.to_value(), "M", "gender M roundtrip")

  let g2 = Gender::parse("O;non-binary\\; fluid")
  assert_str(g2.sex, "O", "gender O")
  match g2.identity {
    Some(id) => assert_str(id, "non-binary; fluid", "gender identity unescaped")
    None => debug_assert(false, "expected gender identity")
  }
  assert_str(g2.to_value(), "O;non-binary\\; fluid", "gender O roundtrip")

  let g3 = Gender::parse(";fellow traveller")
  assert_str(g3.sex, "", "empty sex")
  match g3.identity {
    Some(id) => assert_str(id, "fellow traveller", "identity only")
    None => debug_assert(false, "expected identity")
  }

  // RFC 6350 §6.7.7 CLIENTPIDMAP
  let cpm = match ClientPidMap::parse("1;urn:uuid:3df403f4-5924-4bb7-b077-3c711d9eb34b") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "ClientPidMap failed: " + vcard_error_to_string(e))
      return
    }
  }
  assert_int(cpm.pid, 1, "CLIENTPIDMAP pid")
  assert_str(cpm.uri, "urn:uuid:3df403f4-5924-4bb7-b077-3c711d9eb34b", "CLIENTPIDMAP uri")
  assert_str(cpm.to_value(), "1;urn:uuid:3df403f4-5924-4bb7-b077-3c711d9eb34b", "CLIENTPIDMAP roundtrip")

  match ClientPidMap::parse("0;urn:uuid:bad") {
    Err(VCardError::InvalidValue(_)) => ()
    _ => debug_assert(false, "pid 0 must be rejected")
  }
}

///|
test "partial_dates_and_geo" {
  // Full basic date YYYYMMDD
  let d1 = match PartialDate::parse("19850415") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d1.year { Some(1985) => true; _ => false }, "year 1985")
  debug_assert(match d1.month { Some(4) => true; _ => false }, "month 4")
  debug_assert(match d1.day { Some(15) => true; _ => false }, "day 15")

  // Extended ISO YYYY-MM-DD
  let d2 = match PartialDate::parse("1985-04-15") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d2.year { Some(1985) => true; _ => false }, "ext year 1985")
  debug_assert(match d2.month { Some(4) => true; _ => false }, "ext month 4")
  debug_assert(match d2.day { Some(15) => true; _ => false }, "ext day 15")

  // Yearless --MMDD and --MM-DD
  let d3 = match PartialDate::parse("--0415") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d3.year { None => true; _ => false }, "yearless has no year")
  debug_assert(match d3.month { Some(4) => true; _ => false }, "yearless month 4")
  debug_assert(match d3.day { Some(15) => true; _ => false }, "yearless day 15")

  let d4 = match PartialDate::parse("--04-15") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d4.year { None => true; _ => false }, "ext yearless has no year")
  debug_assert(match d4.month { Some(4) => true; _ => false }, "ext yearless month 4")
  debug_assert(match d4.day { Some(15) => true; _ => false }, "ext yearless day 15")

  // Truncated day-only ---DD, year-month YYYY-MM, year-only YYYY
  let d5 = match PartialDate::parse("---15") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d5.day { Some(15) => true; _ => false }, "day-only 15")

  let d6 = match PartialDate::parse("1985-04") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d6.year { Some(1985) => true; _ => false }, "ym year")
  debug_assert(match d6.month { Some(4) => true; _ => false }, "ym month")
  debug_assert(match d6.day { None => true; _ => false }, "ym no day")

  let d7 = match PartialDate::parse("1985") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d7.year { Some(1985) => true; _ => false }, "year-only")

  // Full date-time with Z and offset
  let d8 = match PartialDate::parse("19960415T231000Z") {
    Ok(d) => d
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  debug_assert(match d8.hour { Some(23) => true; _ => false }, "dt hour 23")
  debug_assert(match d8.minute { Some(10) => true; _ => false }, "dt min 10")
  debug_assert(match d8.tz_offset { Some("Z") => true; _ => false }, "dt Z")

  // Invalid date rejected
  match PartialDate::parse("19851345") {
    Err(VCardError::InvalidValue(_)) => ()
    _ => debug_assert(false, "invalid month/day must fail")
  }

  // GEO vCard 4.0 and vCard 3.0
  let geo4 = match Geo::parse("geo:37.386013,-122.082932") {
    Ok(g) => g
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  assert_str(geo4.latitude, "37.386013", "geo4 lat")
  assert_str(geo4.longitude, "-122.082932", "geo4 lon")

  let geo3 = match Geo::parse("37.386013;-122.082932") {
    Ok(g) => g
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  assert_str(geo3.latitude, "37.386013", "geo3 lat")
  assert_str(geo3.longitude, "-122.082932", "geo3 lon")
}

///|
test "full_vcard4_accessors_and_binary_media" {
  let payload = "PNG-DATA-12345".to_bytes()
  let data_uri = format_data_uri("image/png", payload)
  assert_str(
    data_uri,
    "data:image/png;base64," + base64::encode(payload),
    "format_data_uri",
  )

  let raw =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "KIND:individual\r\n" +
  "UID:urn:uuid:4fbe8971-0bc3-424c-9c26-36c3e1eff6b1\r\n" +
  "PRODID:-//Pion//vCard Test//EN\r\n" +
  "REV:20261124T010000Z\r\n" +
  "FN:Dr. Alice Smith\r\n" +
  "N:Smith;Alice;Marie;Dr.;Ph.D.\r\n" +
  "NICKNAME:Ace,Ali\\, the Great\r\n" +
  "BDAY:--0415\r\n" +
  "ANNIVERSARY:20150620\r\n" +
  "GENDER:F\r\n" +
  "LANG;TYPE=work;PREF=1:en-US\r\n" +
  "LANG;TYPE=home;PREF=2:ja-JP\r\n" +
  "ORG:Pion Labs;Systems\r\n" +
  "ADR;TYPE=work;PREF=1;LABEL=\"100 Main St^nTokyo\":;;100 Main St;Tokyo;;100-0001;Japan\r\n" +
  "TEL;TYPE=work,voice;PREF=1;PID=1.1,2.1;ALTID=1:tel:+81-3-5555-0100\r\n" +
  "EMAIL;TYPE=work;PREF=1:alice@pion.dev\r\n" +
  "IMPP;PREF=1:xmpp:alice@pion.dev\r\n" +
  "URL:https://pion.dev\r\n" +
  "GEO:geo:35.6762,139.6503\r\n" +
  "TZ:Asia/Tokyo\r\n" +
  "CATEGORIES:Engineering,Systems\\, Core\r\n" +
  "NOTE:Line 1\\nLine 2\r\n" +
  "RELATED;TYPE=colleague:urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6\r\n" +
  "CLIENTPIDMAP:1;urn:uuid:3df403f4-5924-4bb7-b077-3c711d9eb34b\r\n" +
  "PHOTO:" + data_uri + "\r\n" +
  "LOGO:https://pion.dev/logo.png\r\n" +
  "KEY;ENCODING=b;TYPE=PGP:" + base64::encode("PGPKEY".to_bytes()) + "\r\n" +
  "END:VCARD\r\n"

  let card = match parse_card(raw) {
    Ok(c) => c
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  match card.kind() {
    Some(k) => assert_str(k, "individual", "KIND")
    None => debug_assert(false, "expected KIND")
  }
  match card.uid() {
    Some(u) => assert_str(u, "urn:uuid:4fbe8971-0bc3-424c-9c26-36c3e1eff6b1", "UID")
    None => debug_assert(false, "expected UID")
  }
  match card.prodid() {
    Some(p) => assert_str(p, "-//Pion//vCard Test//EN", "PRODID")
    None => debug_assert(false, "expected PRODID")
  }
  match card.rev() {
    Some(r) => assert_str(r, "20261124T010000Z", "REV")
    None => debug_assert(false, "expected REV")
  }
  match card.tz() {
    Some(t) => assert_str(t, "Asia/Tokyo", "TZ")
    None => debug_assert(false, "expected TZ")
  }

  let nicks = card.nicknames()
  assert_int(nicks.length(), 2, "2 nicknames")
  assert_str(nicks[0], "Ace", "nick 0")
  assert_str(nicks[1], "Ali, the Great", "nick 1")

  let cats = card.categories()
  assert_int(cats.length(), 2, "2 categories")
  assert_str(cats[1], "Systems, Core", "cat 1 unescaped")

  let adrs = card.addresses()
  assert_int(adrs.length(), 1, "1 ADR")
  match adrs[0].label {
    Some(l) => assert_str(l, "100 Main St\nTokyo", "ADR LABEL RFC 6868")
    None => debug_assert(false, "expected ADR LABEL")
  }

  let phones = card.phones()
  assert_int(phones.length(), 1, "1 TEL")
  match phones[0].altid {
    Some(a) => assert_str(a, "1", "TEL ALTID")
    None => debug_assert(false, "expected ALTID")
  }
  assert_int(phones[0].pid.length(), 2, "TEL 2 PIDs")
  assert_str(phones[0].pid[0], "1.1", "PID 0")
  assert_str(phones[0].pid[1], "2.1", "PID 1")

  assert_int(card.langs().length(), 2, "2 LANGs")
  assert_int(card.impps().length(), 1, "1 IMPP")
  assert_int(card.urls().length(), 1, "1 URL")
  assert_int(card.related().length(), 1, "1 RELATED")

  // PHOTO (data: URI inline), LOGO (URI), KEY (vCard 3.0 ENCODING=b)
  let photos = match card.photos() {
    Ok(v) => v
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  assert_int(photos.length(), 1, "1 photo")
  match photos[0] {
    MediaValue::Inline(bin) => {
      match bin.media_type {
        Some(mt) => assert_str(mt, "image/png", "photo media_type")
        None => debug_assert(false, "expected photo media_type")
      }
      assert_str(bin.data.to_string(), "PNG-DATA-12345", "photo bytes decoded")
    }
    MediaValue::Uri(_) => debug_assert(false, "expected inline photo")
  }

  let logos = match card.logos() {
    Ok(v) => v
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  assert_int(logos.length(), 1, "1 logo")
  match logos[0] {
    MediaValue::Uri(u) => assert_str(u, "https://pion.dev/logo.png", "logo uri")
    MediaValue::Inline(_) => debug_assert(false, "expected URI logo")
  }

  let keys = match card.keys() {
    Ok(v) => v
    Err(e) => { debug_assert(false, vcard_error_to_string(e)); return }
  }
  assert_int(keys.length(), 1, "1 key")
  match keys[0] {
    MediaValue::Inline(bin) => {
      assert_str(bin.data.to_string(), "PGPKEY", "vCard 3.0 ENCODING=b key decoded")
    }
    MediaValue::Uri(_) => debug_assert(false, "expected inline key")
  }
}
