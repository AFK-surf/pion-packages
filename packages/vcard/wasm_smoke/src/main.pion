///| Native + Wasm32 4-mode smoke entry for `packages/vcard`.

import "vcard"
import "base64"

///|
pub fn main(world : World) -> Int {
  let avatar_bytes = "AVATAR-PNG-SMOKE-0123456789".to_bytes()
  let avatar_uri = vcard::format_data_uri("image/png", avatar_bytes)

  let sample_vcf =
  "BEGIN:VCARD\r\n" +
  "VERSION:4.0\r\n" +
  "KIND:individual\r\n" +
  "UID:urn:uuid:smoke-vcard-001\r\n" +
  "FN:山田太郎 🚀 架构师\r\n" +
  "N:山田,Yamada;太郎;一郎;Dr.;Ph.D.\r\n" +
  "ORG:Pion\\, Inc.;Core Systems;R\\;D\r\n" +
  "item1.ADR;TYPE=work;PREF=1;LABEL=\"Tokyo ^'Tower^'^nFloor 10\":;;100 Main St;Tokyo;;100-0001;Japan\r\n" +
  "item1.EMAIL;TYPE=work,internet;PREF=1:taro@pion.dev\r\n" +
  "TEL;TYPE=cell,voice;PREF=1;PID=1.1;ALTID=1:tel:+81-90-0000-0001\r\n" +
  "BDAY:--0415\r\n" +
  "GEO:geo:35.6762,139.6503\r\n" +
  "GENDER:M\r\n" +
  "CATEGORIES:Engineering,Systems\\, Core\r\n" +
  "CLIENTPIDMAP:1;urn:uuid:3df403f4-5924-4bb7-b077-3c711d9eb34b\r\n" +
  "PHOTO:" + avatar_uri + "\r\n" +
  "NOTE:第一行备注内容用于验证多字节汉字和表情符号🎉🚀在七十五字节折行边界上的完全安全性\\n第二行\r\n" +
  "END:VCARD\r\n" +
  "BEGIN:VCARD\r\n" +
  "VERSION:3.0\r\n" +
  "FN;CHARSET=UTF-8;ENCODING=QUOTED-PRINTABLE:=E5=BC=A0=E4=B8=89\r\n" +
  "TEL;WORK;VOICE:+86-10-5555-0100\r\n" +
  "KEY;ENCODING=b;TYPE=PGP:" + base64::encode("SMOKE-PGP".to_bytes()) + "\r\n" +
  "END:VCARD\r\n"

  // 1. Parse multi-card stream + UTF-8 check
  let cards = match vcard::parse_bytes(sample_vcf.to_bytes(), vcard::VCardLimits::default()) {
    Ok(cs) => cs
    Err(_) => return 1
  }
  if cards.length() != 2 {
    return 2
  }

  // 2. Validate card 0 and roundtrip serialize -> reparse
  match vcard::validate(cards[0]) {
    Ok(_) => ()
    Err(_) => return 3
  }
  let formatted = vcard::format_stream(cards)
  let cards2 = match vcard::parse_stream(formatted) {
    Ok(cs) => cs
    Err(_) => return 4
  }
  if cards2.length() != 2 {
    return 5
  }

  let c0 = cards2[0]
  let c1 = cards2[1]
  let fn0 = match c0.fn_name() { Some(s) => s; None => return 6 }
  let fn1 = match c1.fn_name() { Some(s) => s; None => return 7 }
  let sn0 = match c0.structured_name() { Some(n) => n.to_value(); None => return 8 }
  let adrs0 = c0.addresses()
  if adrs0.length() != 1 { return 9 }
  let lbl0 = match adrs0[0].label { Some(l) => l; None => return 10 }
  let orgs0 = c0.organizations()
  if orgs0.length() != 1 { return 11 }
  let bday0 = match c0.birthday() {
    Ok(Some(d)) => d.raw
    _ => return 12
  }
  let geo0 = match c0.geo() {
    Ok(Some(g)) => g.latitude + "," + g.longitude
    _ => return 13
  }
  let photos0 = match c0.photos() {
    Ok(v) => v
    Err(_) => return 14
  }
  let photo_len = match photos0[0] {
    vcard::MediaValue::Inline(b) => b.data.length()
    vcard::MediaValue::Uri(_) => return 15
  }
  let keys1 = match c1.keys() {
    Ok(v) => v
    Err(_) => return 16
  }
  let key_text = match keys1[0] {
    vcard::MediaValue::Inline(b) => b.data.to_string()
    vcard::MediaValue::Uri(_) => return 17
  }

  io_println(world, "vcard_wasm_smoke=ok")
  io_println(world, "cards=" + cards2.length().to_string())
  io_println(world, "fn0=" + fn0)
  io_println(world, "fn1=" + fn1)
  io_println(world, "n0=" + sn0)
  io_println(world, "adr_label=" + lbl0)
  io_println(world, "org0=" + orgs0[0].to_value())
  io_println(world, "bday0=" + bday0)
  io_println(world, "geo0=" + geo0)
  io_println(world, "photo_len=" + photo_len.to_string())
  io_println(world, "key1=" + key_text)
  0
}
