///| Pion Native head-to-head benchmark for `packages/vcard`.
///| Modes: "w1_parse" | "w2_roundtrip" | "w3_escaped_binary"

import "vcard"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  let m = 1000000007L
  ((h * 131L) + (v % m) + m) % m
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let b = s.to_bytes()
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_bytes(h0 : Int64, b : Bytes) -> Int64 {
  let n = b.length()
  let mut h = mix(h0, n.to_int64())
  let mut i = 0
  while i < n {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_str_array(h0 : Int64, arr : Array[String]) -> Int64 {
  let mut h = mix(h0, arr.length().to_int64())
  let mut i = 0
  while i < arr.length() {
    h = hash_str(h, arr[i])
    i = i + 1
  }
  h
}

///| W1: Multi-card `.vcf` batch parse + field reduction.
fn bench_w1_parse(world : World, raw : String) -> Int {
  let cards = match vcard::parse_stream(raw) {
    Ok(cs) => cs
    Err(_) => return 1
  }
  let mut prop_count = 0
  let mut checksum = 0L
  let mut i = 0
  while i < cards.length() {
    let c = cards[i]
    prop_count = prop_count + c.properties.length()
    match c.fn_name() {
      Some(s) => checksum = hash_str(checksum, s)
      None => ()
    }
    let emails = c.emails()
    let mut e = 0
    while e < emails.length() {
      checksum = hash_str(checksum, emails[e].value)
      e = e + 1
    }
    let phones = c.phones()
    let mut t = 0
    while t < phones.length() {
      checksum = hash_str(checksum, phones[t].value)
      t = t + 1
    }
    let adrs = c.addresses()
    let mut a = 0
    while a < adrs.length() {
      checksum = hash_str_array(checksum, adrs[a].street)
      checksum = hash_str_array(checksum, adrs[a].locality)
      match adrs[a].label {
        Some(lbl) => checksum = hash_str(checksum, lbl)
        None => ()
      }
      a = a + 1
    }
    i = i + 1
  }
  io_println(world, "cards=" + cards.length().to_string())
  io_println(world, "props=" + prop_count.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///| W2: Parse + structured extraction (N/FN/ADR/ORG/EMAIL/TEL) + 75-octet folded roundtrip.
fn bench_w2_roundtrip(world : World, raw : String) -> Int {
  let cards = match vcard::parse_stream(raw) {
    Ok(cs) => cs
    Err(_) => return 1
  }
  let serialized = vcard::format_stream(cards)
  let cards2 = match vcard::parse_stream(serialized) {
    Ok(cs) => cs
    Err(_) => return 2
  }
  let mut checksum = 0L
  let mut i = 0
  while i < cards2.length() {
    let c = cards2[i]
    match c.fn_name() {
      Some(s) => checksum = hash_str(checksum, s)
      None => ()
    }
    match c.structured_name() {
      Some(sn) => {
        checksum = hash_str_array(checksum, sn.family)
        checksum = hash_str_array(checksum, sn.given)
        checksum = hash_str_array(checksum, sn.prefixes)
      }
      None => ()
    }
    let orgs = c.organizations()
    let mut o = 0
    while o < orgs.length() {
      checksum = hash_str_array(checksum, orgs[o].units)
      o = o + 1
    }
    let adrs = c.addresses()
    let mut a = 0
    while a < adrs.length() {
      checksum = hash_str_array(checksum, adrs[a].street)
      checksum = hash_str_array(checksum, adrs[a].locality)
      checksum = hash_str_array(checksum, adrs[a].country)
      a = a + 1
    }
    let emails = c.emails()
    let mut e = 0
    while e < emails.length() {
      checksum = hash_str(checksum, emails[e].value)
      e = e + 1
    }
    let phones = c.phones()
    let mut t = 0
    while t < phones.length() {
      checksum = hash_str(checksum, phones[t].value)
      t = t + 1
    }
    i = i + 1
  }
  io_println(world, "cards=" + cards2.length().to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///| W3: High escape density + Base64 avatar decode + normalized output roundtrip.
fn bench_w3_escaped_binary(world : World, raw : String) -> Int {
  let cards = match vcard::parse_stream(raw) {
    Ok(cs) => cs
    Err(_) => return 1
  }
  let serialized = vcard::format_stream(cards)
  let cards2 = match vcard::parse_stream(serialized) {
    Ok(cs) => cs
    Err(_) => return 2
  }
  let mut total_photo_bytes = 0
  let mut checksum = 0L
  let mut i = 0
  while i < cards2.length() {
    let c = cards2[i]
    match c.fn_name() {
      Some(s) => checksum = hash_str(checksum, s)
      None => ()
    }
    match c.structured_name() {
      Some(sn) => {
        checksum = hash_str_array(checksum, sn.family)
        checksum = hash_str_array(checksum, sn.given)
      }
      None => ()
    }
    let orgs = c.organizations()
    let mut o = 0
    while o < orgs.length() {
      checksum = hash_str_array(checksum, orgs[o].units)
      o = o + 1
    }
    let notes = c.notes()
    let mut k = 0
    while k < notes.length() {
      checksum = hash_str(checksum, notes[k])
      k = k + 1
    }
    let photos = match c.photos() {
      Ok(ps) => ps
      Err(_) => return 3
    }
    let mut p = 0
    while p < photos.length() {
      match photos[p] {
        vcard::MediaValue::Inline(bin) => {
          total_photo_bytes = total_photo_bytes + bin.data.length()
          checksum = hash_bytes(checksum, bin.data)
        }
        vcard::MediaValue::Uri(u) => checksum = hash_str(checksum, u)
      }
      p = p + 1
    }
    i = i + 1
  }
  io_println(world, "cards=" + cards2.length().to_string())
  io_println(world, "photo_bytes=" + total_photo_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_vcard_bench <mode> <corpus_path>")
    return 1
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  if mode == "w1_parse" {
    bench_w1_parse(world, data)
  } else if mode == "w2_roundtrip" {
    bench_w2_roundtrip(world, data)
  } else if mode == "w3_escaped_binary" {
    bench_w3_escaped_binary(world, data)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
