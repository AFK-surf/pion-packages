///| RT-vcard red-team audit of `packages/vcard` @ 4122045.
///|
///| Convention: every `p0_*` / `p1_*` / `p2_*` test asserts the behaviour required by RFC 6350 /
///| RFC 2426 / RFC 6868 / RFC 2045 / RFC 2397 and therefore FAILS against the audited
///| implementation: the failure *is* the evidence. Every `control_*` test is a fairness check that
///| PASSES and documents an attack the implementation already withstands. Assertions are written
///| against outcomes only (never against a specific fix), so a fix branch can rerun this file
///| unchanged. See REPORT.md for triage, root causes and reproduction data.

import "vcard"

// -----------------------------------------------------------------------------
// helpers
// -----------------------------------------------------------------------------

///|
fn reparse(text : String) -> Array[vcard::VCard] {
  match vcard::parse_stream(text) {
    Ok(cs) => cs
    Err(e) => {
      debug_assert(false, "reparse of serializer output failed: " + vcard::vcard_error_to_string(e))
      []
    }
  }
}

///|
fn parse1(text : String) -> vcard::VCard {
  match vcard::parse_card(text) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "parse_card failed: " + vcard::vcard_error_to_string(e))
      vcard::VCard::new()
    }
  }
}

///|
fn base_card(fn_value : String) -> vcard::VCard {
  let c = vcard::VCard::new()
  c.properties.push(vcard::VCardProperty::new("VERSION", "4.0"))
  c.properties.push(vcard::VCardProperty::new("FN", fn_value))
  c
}

///|
fn first_fn(c : vcard::VCard) -> String {
  match c.fn_name() {
    Some(s) => s
    None => "<none>"
  }
}

///|
fn first_value(c : vcard::VCard, name : String) -> String {
  match c.get_property(name) {
    Some(p) => p.value
    None => "<none>"
  }
}

///|
fn is_ok_unit(r : Result[Unit, Array[vcard::VCardError]]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///| Assert every physical line of `s` is <= 75 octets, valid UTF-8, and free of control bytes.
fn check_wire(s : String, label : String) -> Unit {
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 10 {
      let mut end = i
      if i < n {
        debug_assert(end > start && s.code_unit_at(end - 1) == 13, label + ": bare LF in output")
        end = end - 1
      }
      debug_assert(end - start <= 75, label + ": physical line of " + (end - start).to_string() + " octets")
      let seg = Bytes::new(end - start)
      let mut k = start
      while k < end {
        let b = s.code_unit_at(k)
        debug_assert(
          b >= 32 && b != 127 || (b == 32 || b == 9),
          label + ": raw control byte 0x" + b.to_string() + " in serializer output",
        )
        seg[k - start] = b.to_byte()
        k = k + 1
      }
      debug_assert(vcard::is_valid_utf8(seg), label + ": physical line is not valid UTF-8")
      start = i + 1
    }
    i = i + 1
  }
}

///|
fn qp_value_after_roundtrip(src : String) -> Result[String, vcard::VCardError] {
  let cards = reparse(vcard::format_stream(reparse(src)))
  if cards.length() != 1 {
    return Err(vcard::VCardError::InvalidSyntax("card count changed"))
  }
  match cards[0].get_property("NOTE") {
    Some(p) => p.decoded_text()
    None => Err(vcard::VCardError::InvalidSyntax("NOTE lost"))
  }
}

// -----------------------------------------------------------------------------
// P0 — serializer card smuggling through property names
// -----------------------------------------------------------------------------

///| A property *named* `END` (value `VCARD`) is emitted verbatim as `END:VCARD`, closing the card
///| early; a following `BEGIN`-named property opens a second, attacker-authored card.
test "p0_property_named_END_smuggles_second_card" {
  let c = base_card("Alice")
  c.properties.push(vcard::VCardProperty::new("END", "VCARD"))
  c.properties.push(vcard::VCardProperty::new("BEGIN", "VCARD"))
  c.properties.push(vcard::VCardProperty::new("FN", "Mallory"))
  c.properties.push(vcard::VCardProperty::new("EMAIL", "mallory@evil.test"))
  let cards = reparse(vcard::format_card(c))
  debug_assert(
    cards.length() == 1,
    "format_card(one card) reparsed as " + cards.length().to_string() + " cards (card smuggling)",
  )
  if cards.length() > 0 {
    debug_assert(first_fn(cards[0]) == "Alice", "first card FN changed")
  }
}

///| `sanitize_vcard_name` deletes the bytes it does not like, so `"\r\nEND"` / `"E N D"` / `"E\x00ND"`
///| collapse into the reserved name `END`.
test "p0_name_sanitizer_assembles_END_from_control_bytes" {
  let names = ["\r\nEND", "E N D", "E\u{0}ND", "e.nd", "END\r\n"]
  let mut i = 0
  while i < names.length() {
    let c = base_card("Alice")
    c.properties.push(vcard::VCardProperty::new(names[i], "VCARD"))
    c.properties.push(vcard::VCardProperty::new("NOTE", "tail"))
    let out = vcard::format_card(c)
    match vcard::parse_stream(out) {
      Ok(cs) => {
        debug_assert(cs.length() == 1, "name #" + i.to_string() + " split the card")
        if cs.length() == 1 {
          debug_assert(first_value(cs[0], "NOTE") == "tail", "name #" + i.to_string() + " lost NOTE")
        }
      }
      Err(e) =>
      debug_assert(
        false,
        "name #" + i.to_string() + " made the output unparsable: " + vcard::vcard_error_to_string(e),
      )
    }
    i = i + 1
  }
}

///| One card carrying a `BEGIN`-named property poisons a whole exported address book:
///| `format_stream` output no longer parses at all (all other cards are lost on import).
test "p0_property_named_BEGIN_poisons_whole_stream" {
  let evil = base_card("Eve")
  evil.properties.push(vcard::VCardProperty::new("BEGIN", "VCARD"))
  let good = base_card("Bob")
  match vcard::parse_stream(vcard::format_stream([good, evil, good])) {
    Ok(cs) => debug_assert(cs.length() == 3, "expected 3 cards, got " + cs.length().to_string())
    Err(e) => debug_assert(false, "exported stream unparsable: " + vcard::vcard_error_to_string(e))
  }
}

// -----------------------------------------------------------------------------
// P1 — Quoted-Printable roundtrip corruption
// -----------------------------------------------------------------------------

///| The parser stores a QP soft break as a raw LF inside the value; the serializer then
///| rewrites that LF as the TEXT escape `\n`, which is not a QP soft break: the reparsed value
///| no longer decodes (`=\n` -> invalid QP escape) and `fn_name()`/`notes()` silently fall back
///| to the raw `=E4=B8=\n=AD` text.
test "p1_quoted_printable_soft_break_corrupted_by_roundtrip" {
  let src = "BEGIN:VCARD\r\nVERSION:2.1\r\nFN:x\r\nNOTE;ENCODING=QUOTED-PRINTABLE:=E4=B8=\r\n=AD=E6=96=87\r\nEND:VCARD\r\n"
  // control: first parse decodes fine
  match parse1(src).get_property("NOTE") {
    Some(p) =>
    match p.decoded_text() {
      Ok(t) => debug_assert(t == "中文", "first parse decoded to " + t)
      Err(e) => debug_assert(false, "first parse: " + vcard::vcard_error_to_string(e))
    }
    None => debug_assert(false, "NOTE missing")
  }
  match qp_value_after_roundtrip(src) {
    Ok(t) => debug_assert(t == "中文", "after format+reparse: " + t)
    Err(e) => debug_assert(false, "after format+reparse: " + vcard::vcard_error_to_string(e))
  }
}

///| Same with an `=LF` soft break in a bare-`QUOTED-PRINTABLE` (vCard 2.1) property.
test "p1_quoted_printable_lf_soft_break_roundtrip" {
  let src = "BEGIN:VCARD\nVERSION:2.1\nFN:x\nNOTE;QUOTED-PRINTABLE:abc=\ndef\nEND:VCARD\n"
  match qp_value_after_roundtrip(src) {
    Ok(t) => debug_assert(t == "abcdef", "after format+reparse: " + t)
    Err(e) => debug_assert(false, "after format+reparse: " + vcard::vcard_error_to_string(e))
  }
}

// -----------------------------------------------------------------------------
// P2 — parser / validator / serializer spec deviations
// -----------------------------------------------------------------------------

///| QP soft-break unfolding is enabled whenever the *header* contains the substring
///| `QUOTED-PRINTABLE` anywhere (any parameter value), so a plain vCard 4.0 NOTE ending in `=`
///| swallows the next content line (here: a TEL, or `END:VCARD`).
test "p1_qp_soft_break_triggered_by_unrelated_param_value" {
  let src = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:x\r\nNOTE;X-HINT=QUOTED-PRINTABLE:a=\r\nTEL:1\r\nEND:VCARD\r\n"
  let c = parse1(src)
  debug_assert(first_value(c, "NOTE") == "a=", "NOTE swallowed next line: " + first_value(c, "NOTE"))
  debug_assert(first_value(c, "TEL") == "1", "TEL property was swallowed")
  let src2 = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:x\r\nNOTE;LABEL=\"quoted-printable\":1+1=\r\nEND:VCARD\r\n"
  match vcard::parse_stream(src2) {
    Ok(cs) => debug_assert(cs.length() == 1, "card count")
    Err(e) => debug_assert(false, "END:VCARD swallowed: " + vcard::vcard_error_to_string(e))
  }
}

///| Same root cause reached through the serializer: user-controlled text (a parameter value that
///| mentions "quoted-printable" plus a value ending in `=`) makes `format_card` output whose reparse
///| swallows the next property, or `END:VCARD` itself (the whole exported stream then fails).
test "p1_serializer_output_swallows_next_line_via_qp_marker" {
  let c = base_card("x")
  c.properties.push(
    vcard::VCardProperty::with_params(
      "NOTE",
      [vcard::VCardParam::new("X-SOURCE", "Quoted-Printable import")],
      "1+1=",
    ),
  )
  c.properties.push(vcard::VCardProperty::new("EMAIL", "a@example.com"))
  let cs = reparse(vcard::format_card(c))
  if cs.length() == 1 {
    debug_assert(cs[0].emails().length() == 1, "EMAIL swallowed into NOTE")
    debug_assert(first_value(cs[0], "NOTE") == "1+1=", "NOTE = " + first_value(cs[0], "NOTE"))
  }
  let tail = base_card("y")
  tail.properties.push(
    vcard::VCardProperty::with_params("NOTE", [vcard::VCardParam::new("LABEL", "quoted-printable")], "x="),
  )
  match vcard::parse_stream(vcard::format_stream([tail, base_card("z")])) {
    Ok(ss) => debug_assert(ss.length() == 2, "card count " + ss.length().to_string())
    Err(e) => debug_assert(false, "END:VCARD swallowed: " + vcard::vcard_error_to_string(e))
  }
}

///| RFC 6350 §3.2: implementations SHOULD unfold lines so that a multi-octet character split by a
///| (non-conforming) fold is restored. `parse_bytes` validates UTF-8 *before* unfolding and
///| rejects the whole stream.
test "p2_parse_bytes_rejects_fold_inside_utf8_sequence" {
  // FN:<E4 B8> CRLF SP <AD>  ==  FN:中 folded in the middle of the code point
  let head = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:".to_bytes()
  let mid = [0xE4, 0xB8, 13, 10, 32, 0xAD]
  let tail = "\r\nEND:VCARD\r\n".to_bytes()
  let bytes = Bytes::new(head.length() + mid.length() + tail.length())
  let mut i = 0
  while i < head.length() {
    bytes[i] = head[i]
    i = i + 1
  }
  let mut k = 0
  while k < mid.length() {
    bytes[i + k] = mid[k].to_byte()
    k = k + 1
  }
  k = 0
  while k < tail.length() {
    bytes[i + mid.length() + k] = tail[k]
    k = k + 1
  }
  match vcard::parse_bytes(bytes, vcard::VCardLimits::default()) {
    Ok(cs) => debug_assert(cs.length() == 1 && first_fn(cs[0]) == "中", "unfolded FN wrong")
    Err(e) => debug_assert(false, "rejected: " + vcard::vcard_error_to_string(e))
  }
}

///| RFC 2397 §2: without `;base64` the data is URL-encoded (`%2C` -> `,`).
test "p2_data_uri_percent_encoding_not_decoded" {
  match vcard::parse_data_uri("data:text/plain,Hello%2C%20W") {
    Ok(b) => debug_assert(b.data.to_string() == "Hello, W", "decoded to " + b.data.to_string())
    Err(e) => debug_assert(false, vcard::vcard_error_to_string(e))
  }
}

///| RFC 6350 §6.7.9: VERSION "MUST appear immediately after BEGIN:VCARD".
test "p2_validate_accepts_misplaced_VERSION" {
  let c = vcard::VCard::new()
  c.properties.push(vcard::VCardProperty::new("FN", "x"))
  c.properties.push(vcard::VCardProperty::new("VERSION", "4.0"))
  debug_assert(!is_ok_unit(vcard::validate(c)), "VERSION as 2nd property accepted")
}

///| RFC 2426 §5 / §3.1.2: a vCard 3.0 object MUST contain N (and FN).
test "p2_validate_accepts_v3_card_without_N" {
  let c = vcard::VCard::new()
  c.properties.push(vcard::VCardProperty::new("VERSION", "3.0"))
  c.properties.push(vcard::VCardProperty::new("FN", "x"))
  debug_assert(!is_ok_unit(vcard::validate(c)), "vCard 3.0 without N accepted")
}

///| RFC 6350 §4.3.1 (ISO 8601): calendar dates must exist.
test "p2_partial_date_accepts_impossible_dates" {
  let bad = ["20230229", "--0230", "2023-11-31", "--0431", "19000229"]
  let mut i = 0
  while i < bad.length() {
    match vcard::PartialDate::parse(bad[i]) {
      Ok(_) => debug_assert(false, "impossible date accepted: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
  // control: real leap days stay valid
  match vcard::PartialDate::parse("20240229") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "2024-02-29 rejected")
  }
  match vcard::PartialDate::parse("--0229") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "--0229 (yearless leap day) rejected")
  }
}

///| RFC 6350 §4.3.2 / §4.7: zone is `Z` or `(+|-)hh[mm]`; anything else must be rejected.
test "p2_partial_date_zone_suffix_unvalidated" {
  let bad = ["19960415T102200Zjunk", "19960415T102200+", "19960415T102200+2", "19960415T102200-99:99"]
  let mut i = 0
  while i < bad.length() {
    match vcard::PartialDate::parse(bad[i]) {
      Ok(d) =>
      debug_assert(
        false,
        "bad zone accepted: " +
        bad[i] +
        " -> " +
        (match d.tz_offset {
          Some(z) => z
          None => "-"
        }),
      )
      Err(_) => ()
    }
    i = i + 1
  }
}

///| RFC 6350 §6.5.2 / RFC 5870: latitude in [-90, 90], longitude in [-180, 180], numeric.
test "p2_geo_accepts_out_of_range_and_non_numeric" {
  let bad = ["geo:91,0", "geo:0,181", "geo:abc,def", "12.5;east"]
  let mut i = 0
  while i < bad.length() {
    match vcard::Geo::parse(bad[i]) {
      Ok(_) => debug_assert(false, "invalid GEO accepted: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

///| RFC 6350 §6.1.4: KIND = "individual" / "group" / "org" / "location" / iana-token / x-name;
///| RFC 6473 registers `application`. The validator rejects every iana-token.
test "p2_validate_rejects_registered_KIND_application" {
  let c = base_card("x")
  c.properties.push(vcard::VCardProperty::new("KIND", "application"))
  debug_assert(is_ok_unit(vcard::validate(c)), "KIND:application (RFC 6473) rejected")
}

///| RFC 6350 §3.3: VALUE-CHAR / QSAFE-CHAR exclude CTL. Raw NUL/ESC/DEL in values and
///| parameter values are emitted verbatim by `format_card`.
test "p2_serializer_emits_raw_control_bytes" {
  let c = base_card("a\u{0}b\u{1b}[31mc\u{7f}")
  c.properties.push(
    vcard::VCardProperty::with_params("NOTE", [vcard::VCardParam::new("X-P", "p\u{0}q")], "n"),
  )
  check_wire(vcard::format_card(c), "ctl")
}

///| `VCardParam` with an empty value list serializes as `TYPE=` and reparses as `[""]`.
test "p2_empty_param_value_list_not_roundtrip_stable" {
  let c = base_card("x")
  c.properties.push(
    vcard::VCardProperty::with_params("TEL", [vcard::VCardParam::with_values("TYPE", [])], "1"),
  )
  let cs = reparse(vcard::format_card(c))
  if cs.length() == 1 {
    match cs[0].get_property("TEL") {
      Some(p) =>
      match p.get_param("TYPE") {
        Some(vs) => debug_assert(vs.length() == 0, "TYPE=[] became " + vs.length().to_string() + " value(s)")
        None => ()
      }
      None => debug_assert(false, "TEL lost")
    }
  }
}

///| A bare CR inside a value is accepted by the parser but silently rewritten to LF by the
///| serializer: either reject it at parse time or preserve it.
test "p2_bare_cr_value_mutated_by_roundtrip" {
  let src = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:a\rb\r\nEND:VCARD\r\n"
  match vcard::parse_stream(src) {
    Err(_) => ()
    Ok(cs) => {
      let before = first_fn(cs[0])
      let after = first_fn(reparse(vcard::format_stream(cs))[0])
      debug_assert(before == after, "FN changed across roundtrip (CR -> LF)")
    }
  }
}

// -----------------------------------------------------------------------------
// controls — attacks the implementation withstands
// -----------------------------------------------------------------------------

///|
test "control_crlf_injection_in_value_param_group_and_names_is_neutralized" {
  let payload = "x\r\nEND:VCARD\r\nBEGIN:VCARD\r\nVERSION:4.0\r\nFN:evil\r\nEMAIL:e@evil.test\r\n"
  let c = base_card(payload)
  c.properties.push(
    vcard::VCardProperty::with_group(
      Some("g\r\nEMAIL:e@evil.test\r\nX"),
      "NOTE\r\nEMAIL",
      [
        vcard::VCardParam::new("X-P\r\nEMAIL", payload),
        vcard::VCardParam::with_values("TYPE", ["a\"b", "c;d", "e:f", "g,h", "^n", payload]),
      ],
      payload,
    ),
  )
  c.properties.push(vcard::VCardProperty::new("X-URI", "http://e.x/\r\nEND:VCARD"))
  let out = vcard::format_card(c)
  let cs = reparse(out)
  debug_assert(cs.length() == 1, "one card")
  if cs.length() == 1 {
    debug_assert(cs[0].emails().length() == 0, "no injected EMAIL")
    debug_assert(cs[0].properties.length() == c.properties.length(), "property count preserved")
    debug_assert(first_fn(cs[0]) == "x\nEND:VCARD\nBEGIN:VCARD\nVERSION:4.0\nFN:evil\nEMAIL:e@evil.test\n", "FN text")
    let p = cs[0].properties[2]
    match p.get_param("TYPE") {
      Some(vs) => {
        debug_assert(vs.length() == 6, "TYPE values count")
        if vs.length() == 6 {
          debug_assert(vs[0] == "a\"b" && vs[1] == "c;d" && vs[2] == "e:f" && vs[3] == "g,h" && vs[4] == "^n", "TYPE values")
          debug_assert(vs[5] == "x\nEND:VCARD\nBEGIN:VCARD\nVERSION:4.0\nFN:evil\nEMAIL:e@evil.test\n", "CRLF->LF in param")
        }
      }
      None => debug_assert(false, "TYPE lost")
    }
  }
}

///| Exhaustive 75-octet fold check: every prefix length 0..160 × 2/3/4-byte, ZWJ and combining glyphs.
test "control_fold_75_octets_never_splits_utf8" {
  let glyphs = ["é", "中", "😀", "👩‍💻", "é", "🇯🇵"]
  let mut g = 0
  while g < glyphs.length() {
    let mut pad = 0
    while pad < 160 {
      let sb = StringBuilder::new()
      let mut k = 0
      while k < pad {
        sb.write_string("a")
        k = k + 1
      }
      k = 0
      while k < 40 {
        sb.write_string(glyphs[g])
        k = k + 1
      }
      let v = sb.to_string()
      let c = base_card(v)
      let out = vcard::format_card(c)
      check_wire(out, "fold g=" + g.to_string() + " pad=" + pad.to_string())
      let cs = reparse(out)
      debug_assert(cs.length() == 1 && first_fn(cs[0]) == v, "fold roundtrip g=" + g.to_string())
      pad = pad + 1
    }
    g = g + 1
  }
}

///|
test "control_structured_escapes_backslash_before_separator" {
  let n = vcard::StructuredName::parse("a\\\\;b\\;c;d\\,e,f;;;")
  debug_assert(n.family.length() == 1 && n.family[0] == "a\\", "family")
  debug_assert(n.given.length() == 1 && n.given[0] == "b;c", "given")
  debug_assert(n.additional.length() == 2 && n.additional[0] == "d,e" && n.additional[1] == "f", "additional")
  let o = vcard::Organization::parse("A\\;B;C\\\\;D")
  debug_assert(o.units.length() == 3 && o.units[0] == "A;B" && o.units[1] == "C\\" && o.units[2] == "D", "ORG")
  // to_value / parse are inverse on hostile components
  let sn = vcard::StructuredName::new(["x\\", ";", ","], ["\n"], [], ["a\\;b"], ["\\"])
  let back = vcard::StructuredName::parse(sn.to_value())
  debug_assert(back.family.length() == 3 && back.family[0] == "x\\" && back.family[1] == ";" && back.family[2] == ",", "N rt family")
  debug_assert(back.given[0] == "\n" && back.prefixes[0] == "a\\;b" && back.suffixes[0] == "\\", "N rt others")
}

///|
test "control_rfc6868_unknown_caret_preserved" {
  debug_assert(vcard::unescape_param_value("a^xb^") == "a^xb^", "unknown ^x / trailing ^")
  debug_assert(vcard::unescape_param_value("^^n") == "^n", "^^ then n")
  debug_assert(vcard::unescape_param_value("^n^'^^") == "\n\"^", "known escapes")
  debug_assert(vcard::unescape_param_value(vcard::escape_param_value("^\r\n\"^n")) == "^\n\"^n", "escape/unescape inverse (CRLF -> LF)")
}

///| `VCardLimits` with 0 or negative fields fails closed (no bypass).
test "control_zero_and_negative_limits_fail_closed" {
  let card = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN;X-A=1:x\r\nEND:VCARD\r\n"
  let d = vcard::VCardLimits::default()
  let variants = [
    vcard::VCardLimits::{ ..d, max_bytes: 0 },
    vcard::VCardLimits::{ ..d, max_bytes: -1 },
    vcard::VCardLimits::{ ..d, max_cards: 0 },
    vcard::VCardLimits::{ ..d, max_cards: -5 },
    vcard::VCardLimits::{ ..d, max_properties_per_card: 0 },
    vcard::VCardLimits::{ ..d, max_line_bytes: 0 },
    vcard::VCardLimits::{ ..d, max_line_bytes: -1 },
    vcard::VCardLimits::{ ..d, max_params_per_prop: 0 },
    vcard::VCardLimits::{ ..d, max_params_per_prop: -1 },
  ]
  let mut i = 0
  while i < variants.length() {
    match vcard::parse_stream_with_limits(card, variants[i]) {
      Err(vcard::VCardError::LimitExceeded(_)) => ()
      _ => debug_assert(false, "limit variant #" + i.to_string() + " did not fail closed")
    }
    i = i + 1
  }
}

///|
test "control_pref_bounds_and_utf8_rejections" {
  let prefs = ["0", "101", "-1", "abc", "", "99999999999", "1.5"]
  let mut i = 0
  while i < prefs.length() {
    let c = base_card("x")
    c.properties.push(vcard::VCardProperty::with_params("TEL", [vcard::VCardParam::new("PREF", prefs[i])], "1"))
    debug_assert(!is_ok_unit(vcard::validate(c)), "PREF=" + prefs[i] + " accepted")
    i = i + 1
  }
  let bad : Array[Array[Int]] = [[0xC0, 0xAF], [0xED, 0xA0, 0x80], [0xF4, 0x90, 0x80, 0x80], [0xE4, 0xB8], [0x80], [0xF8, 0x88, 0x80, 0x80, 0x80]]
  let mut k = 0
  while k < bad.length() {
    let b = Bytes::new(bad[k].length())
    let mut j = 0
    while j < bad[k].length() {
      b[j] = bad[k][j].to_byte()
      j = j + 1
    }
    debug_assert(!vcard::is_valid_utf8(b), "invalid UTF-8 #" + k.to_string() + " accepted")
    k = k + 1
  }
}
