+///| Days in month `m` (year `y`, or -1 for yearless: February allows 29).
+fn days_in_month(y : Int, m : Int) -> Int {
+  if m == 2 {
+    if y < 0 || (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) {
+      29
+    } else {
+      28
+    }
+  } else if m == 4 || m == 6 || m == 9 || m == 11 {
+    30
+  } else {
+    31
+  }
+}
+
+///| `Z` or `(+|-)hh[[:]mm]`.
+fn is_valid_zone(z : String) -> Bool {
+  let n = z.length()
+  if n == 1 {
+    return z.code_unit_at(0) == 90
+  }
+  if n < 3 {
+    return false
+  }
+  let s0 = z.code_unit_at(0)
+  if s0 != 43 && s0 != 45 {
+    return false
+  }
+  let h = parse_2d(z, 1)
+  if h < 0 || h > 23 {
+    return false
+  }
+  if n == 3 {
+    return true
+  }
+  let mpos = if z.code_unit_at(3) == 58 { 4 } else { 3 }
+  if n != mpos + 2 {
+    return false
+  }
+  let m = parse_2d(z, mpos)
+  m >= 0 && m <= 59
+}
