///| RT-vcard red-team differential / DoS driver for `packages/vcard` (audit only, never shipped).
///| Modes:
///|   dump <cases>   each line `<id> <hex>`: parse_bytes -> `<id> OK <canonical dump>` | `<id> ERR <kind>`
///|   rt <cases>     parse -> format_stream -> reparse; `<id> OK <dump>` plus `FOLD!`/`UTF8!` flags
///|   parse <file>   parse a whole file: `OK cards=<n> props=<m> bytes=<b>` | `ERR <msg>`
///|   fmt <file>     parse a whole file then format_stream: `OK out=<bytes> [FOLD!] [UTF8!]` | `ERR`
///|   media <file>   parse a whole file and decode every PHOTO: `OK photo_bytes=<n>` | `ERR`

import "vcard"

///|
fn split_char(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == sep {
      let sb = StringBuilder::new()
      let mut k = start
      while k < i {
        sb.write_byte(s.code_unit_at(k).to_byte())
        k = k + 1
      }
      out.push(sb.to_string())
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn hexv(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (hexv(s.code_unit_at(2 * i)) * 16 + hexv(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
fn hexd(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    87 + v
  }
}

///| Visible escaping: controls, DEL and dump metacharacters become `\xHH`; other bytes (UTF-8) kept.
fn vis(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 32 ||
    c == 127 ||
    c == 92 ||
    c == 59 ||
    c == 44 ||
    c == 61 ||
    c == 124 ||
    c == 123 ||
    c == 125 ||
    c == 94 ||
    c == 34 ||
    c == 58 ||
    c == 32 {
      sb.write_byte((92).to_byte())
      sb.write_byte((120).to_byte())
      sb.write_byte(hexd(c / 16).to_byte())
      sb.write_byte(hexd(c % 16).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn join_list(items : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(vis(items[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
fn value_view(p : vcard::VCardProperty) -> String {
  if p.name == "N" {
    let sn = vcard::StructuredName::parse(p.value)
    return join_list(sn.family) +
    ";" +
    join_list(sn.given) +
    ";" +
    join_list(sn.additional) +
    ";" +
    join_list(sn.prefixes) +
    ";" +
    join_list(sn.suffixes)
  }
  if p.name == "ADR" {
    let a = vcard::Address::parse(p.value)
    return join_list(a.po_box) +
    ";" +
    join_list(a.extended) +
    ";" +
    join_list(a.street) +
    ";" +
    join_list(a.locality) +
    ";" +
    join_list(a.region) +
    ";" +
    join_list(a.postal_code) +
    ";" +
    join_list(a.country)
  }
  if p.name == "ORG" {
    let o = vcard::Organization::parse(p.value)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < o.units.length() {
      if i > 0 {
        sb.write_byte((59).to_byte())
      }
      sb.write_string(vis(o.units[i]))
      i = i + 1
    }
    return sb.to_string()
  }
  if p.name == "PHOTO" || p.name == "LOGO" || p.name == "KEY" || p.name == "SOUND" {
    return match p.decoded_media() {
      Ok(vcard::MediaValue::Uri(u)) => "uri:" + vis(u)
      Ok(vcard::MediaValue::Inline(b)) => "bin:" + b.data.length().to_string()
      Err(_) => "!ERR"
    }
  }
  match p.decoded_text() {
    Ok(t) => vis(t)
    Err(_) => "!ERR"
  }
}

///|
fn prop_view(p : vcard::VCardProperty) -> String {
  let sb = StringBuilder::new()
  match p.group {
    Some(g) => {
      sb.write_string(vis(g))
      sb.write_byte((46).to_byte())
    }
    None => ()
  }
  sb.write_string(vis(p.name))
  // parameters sorted by name (stable) so map-based oracles can be compared
  let idx : Array[Int] = []
  let mut i = 0
  while i < p.params.length() {
    idx.push(i)
    let mut j = idx.length() - 1
    while j > 0 && p.params[idx[j - 1]].name > p.params[idx[j]].name {
      let t = idx[j - 1]
      idx[j - 1] = idx[j]
      idx[j] = t
      j = j - 1
    }
    i = i + 1
  }
  // repeated parameters (`TYPE=a;TYPE=b`) are merged into one value list (`TYPE=a,b`)
  let mut k = 0
  while k < idx.length() {
    let prm = p.params[idx[k]]
    if k == 0 || p.params[idx[k - 1]].name != prm.name {
      sb.write_byte((59).to_byte())
      sb.write_string(vis(prm.name))
      sb.write_byte((61).to_byte())
    } else {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(join_list(prm.values))
    k = k + 1
  }
  sb.write_byte((124).to_byte())
  sb.write_string(value_view(p))
  sb.to_string()
}

///| Canonical dump: cards as `{p|p|...}`, properties sorted by name (stable).
fn dump_cards(cards : Array[vcard::VCard]) -> String {
  let sb = StringBuilder::new()
  let mut c = 0
  while c < cards.length() {
    let props = cards[c].properties
    let views : Array[String] = []
    let names : Array[String] = []
    let mut i = 0
    while i < props.length() {
      views.push(prop_view(props[i]))
      names.push(props[i].name)
      let mut j = views.length() - 1
      while j > 0 && names[j - 1] > names[j] {
        let tv = views[j - 1]
        views[j - 1] = views[j]
        views[j] = tv
        let tn = names[j - 1]
        names[j - 1] = names[j]
        names[j] = tn
        j = j - 1
      }
      i = i + 1
    }
    sb.write_byte((123).to_byte())
    let mut k = 0
    while k < views.length() {
      if k > 0 {
        sb.write_string(" ")
      }
      sb.write_string(views[k])
      k = k + 1
    }
    sb.write_byte((125).to_byte())
    c = c + 1
  }
  sb.to_string()
}

///|
fn err_kind(e : vcard::VCardError) -> String {
  match e {
    vcard::VCardError::InvalidSyntax(_) => "InvalidSyntax"
    vcard::VCardError::InvalidProperty(_) => "InvalidProperty"
    vcard::VCardError::InvalidParameter(_) => "InvalidParameter"
    vcard::VCardError::InvalidValue(_) => "InvalidValue"
    vcard::VCardError::InvalidUtf8(_) => "InvalidUtf8"
    vcard::VCardError::ValidationError(_) => "ValidationError"
    vcard::VCardError::LimitExceeded(_) => "LimitExceeded"
    vcard::VCardError::Unimplemented(_) => "Unimplemented"
  }
}

///| Check that every physical line of `s` is <= 75 octets and is valid UTF-8 on its own.
fn fold_flags(s : String) -> String {
  let n = s.length()
  let mut out = ""
  let mut start = 0
  let mut i = 0
  let mut bad_len = false
  let mut bad_utf8 = false
  while i <= n {
    if i == n || s.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && s.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      if end - start > 75 {
        bad_len = true
      }
      let seg = Bytes::new(end - start)
      let mut k = start
      while k < end {
        seg[k - start] = s.code_unit_at(k).to_byte()
        k = k + 1
      }
      if !vcard::is_valid_utf8(seg) {
        bad_utf8 = true
      }
      start = i + 1
    }
    i = i + 1
  }
  if bad_len {
    out = out + "FOLD! "
  }
  if bad_utf8 {
    out = out + "UTF8! "
  }
  out
}

///|
fn case_line(mode : String, id : String, hex : String) -> String {
  let cards = match vcard::parse_bytes(unhex(hex), vcard::VCardLimits::default()) {
    Ok(cs) => cs
    Err(e) => return id + " ERR " + err_kind(e)
  }
  if mode == "dump" {
    return id + " OK " + dump_cards(cards)
  }
  let text = vcard::format_stream(cards)
  let flags = fold_flags(text)
  match vcard::parse_bytes(text.to_bytes(), vcard::VCardLimits::default()) {
    Ok(cs2) => id + " OK " + flags + dump_cards(cs2)
    Err(e) => id + " ERR " + flags + "reparse:" + err_kind(e)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: driver dump|rt <cases> | parse|fmt <file>")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read input")
      return 2
    }
  }
  if mode == "dump" || mode == "rt" {
    let lines = split_char(data.to_string(), 10)
    let mut i = 0
    while i < lines.length() {
      let parts = split_char(lines[i], 32)
      if parts.length() == 2 {
        io_println(world, case_line(mode, parts[0], parts[1]))
      }
      i = i + 1
    }
    return 0
  }
  let cards = match vcard::parse_bytes(data, vcard::VCardLimits::default()) {
    Ok(cs) => cs
    Err(e) => {
      io_println(world, "ERR " + vcard::vcard_error_to_string(e))
      return 0
    }
  }
  if mode == "parse" {
    let mut props = 0
    let mut i = 0
    while i < cards.length() {
      props = props + cards[i].properties.length()
      i = i + 1
    }
    io_println(
      world,
      "OK cards=" +
      cards.length().to_string() +
      " props=" +
      props.to_string() +
      " bytes=" +
      data.length().to_string(),
    )
    return 0
  }
  if mode == "fmt" {
    let text = vcard::format_stream(cards)
    io_println(world, "OK out=" + text.length().to_string() + " " + fold_flags(text))
    return 0
  }
  if mode == "media" {
    let mut total = 0
    let mut i = 0
    while i < cards.length() {
      match cards[i].photos() {
        Ok(ms) => {
          let mut k = 0
          while k < ms.length() {
            match ms[k] {
              vcard::MediaValue::Inline(b) => total = total + b.data.length()
              vcard::MediaValue::Uri(_) => ()
            }
            k = k + 1
          }
        }
        Err(e) => {
          io_println(world, "ERR " + vcard::vcard_error_to_string(e))
          return 0
        }
      }
      i = i + 1
    }
    io_println(world, "OK photo_bytes=" + total.to_string())
    return 0
  }
  io_println(world, "unknown mode")
  2
}
