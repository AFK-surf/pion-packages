///| Red-team regression tests for packages/protobuf @ 8df2404 (branch feat/pkg-protobuf).
///
/// Every `redteam_*` test asserts what the reference implementations do
/// (Go google.golang.org/protobuf v1.36.6 dynamicpb/protojson + protocompile, Rust prost 0.13.5,
/// protoc) — a FAILURE here is the evidence. The expected values were produced by
/// go/cmd/oracle (see ../REPORT.md, `run_audit.sh` section 2).
/// `control_*` tests are attacks Pion survived; they must keep passing.
/// Crash / DoS findings (SIGSEGV, quadratic time) cannot live in a unit test that must finish:
/// they are reproduced by ../run_audit.sh (see REPORT.md).

import "protobuf"

///|
fn sch(src : String) -> protobuf::Schema {
  match protobuf::parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "schema must parse: " + protobuf::error_message(e))
      protobuf::Schema::{
        syntax: protobuf::Syntax::Proto3,
        package_name: "",
        imports: [],
        options: [],
        messages: [],
        enums: [],
      }
    }
  }
}

///|
fn parses(src : String) -> Bool {
  match protobuf::parse_schema(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn field_number_of(s : protobuf::Schema, msg : String, field : String) -> Int {
  match protobuf::schema_find_message(s, msg) {
    Some(m) => {
      let mut i = 0
      while i < m.fields.length() {
        if m.fields[i].name == field {
          return m.fields[i].number
        }
        i = i + 1
      }
      -1
    }
    None => -2
  }
}

// ===========================================================================
// F-1 (P0) Type-name resolution is not scoped: an unqualified name falls back to the FIRST
// message/enum with that short name anywhere in the file (depth-first), and enums win over
// messages. protoc/protocompile resolve C++-style from the innermost scope outwards.
// Result: fields silently decode with the WRONG descriptor.
// ===========================================================================

///|
test "redteam_scoped_name_resolution_picks_enclosing_scope" {
  // B.C.item refers to B.Item (enclosing scope). Pion resolves it to A.Item (first in file).
  let s = sch(
    "syntax = \"proto3\";\n" +
    "message A { message Item { int32 x = 1; } Item a = 1; }\n" +
    "message B { message Item { string name = 1; } message C { Item item = 1; } C c = 1; }",
  )
  // B{ c: C{ item: Item{ name: "hi" } } }
  let got = dec_json(s, "B", "0a060a040a026869")
  let want = "{\"c\":{\"item\":{\"name\":\"hi\"}}}" // go protojson
  debug_assert(got == want, "B.C.item must be B.Item\n got:  " + got + "\n want: " + want)
}

///|
test "redteam_message_not_shadowed_by_unrelated_enum_of_same_name" {
  // Holder.status is the nested *message* Holder.Status; Other.Status is an unrelated *enum*.
  // Pion asks "is there an enum called Status anywhere?" first, treats the message as an enum,
  // sees wire type 2 != varint and drops the whole sub-message into unknown fields.
  let s = sch(
    "syntax = \"proto3\";\n" +
    "message Other { enum Status { UNKNOWN = 0; OK = 1; } Status s = 1; }\n" +
    "message Holder { message Status { int32 code = 1; } Status status = 1; }",
  )
  let got = dec_json(s, "Holder", "0a020807")
  let want = "{\"status\":{\"code\":7}}"
  debug_assert(got == want, "Holder.status must decode as message\n got:  " + got + "\n want: " + want)
}

///|
test "redteam_decoded_submessage_reencodes_with_its_own_descriptor" {
  // decode_dynamic stores DynamicMessage.message_name = desc.name (short "Item"), so
  // encode_dynamic / to_proto3_json on a decoded B.Item look up A.Item instead.
  let s = sch(
    "syntax = \"proto3\";\n" +
    "message A { message Item { int32 x = 1; } }\n" +
    "message B { message Item { string name = 1; } }",
  )
  // go: {"name":"hi"} / 0a026869. Pion prints A.Item's field name ("x") and fails to re-encode.
  let js = dec_json(s, "B.Item", "0a026869")
  debug_assert(js == "{\"name\":\"hi\"}", "JSON of decoded B.Item\n got:  " + js + "\n want: {\"name\":\"hi\"}")
  match protobuf::decode_dynamic_default(s, "B.Item", hx("0a026869")) {
    Err(e) => debug_assert(false, "decode B.Item: " + protobuf::error_message(e))
    Ok(m) => {
      match protobuf::encode_dynamic(s, m) {
        Ok(b) => debug_assert(tohex(b) == "0a026869", "re-encode changed bytes: " + tohex(b))
        Err(e) => debug_assert(false, "encode_dynamic(decoded B.Item) failed: " + protobuf::error_message(e))
      }
    }
  }
}

// ===========================================================================
// F-2 (P0) `.proto` integer literals: octal is read as decimal and overflow wraps silently.
// protoc: `017` is octal 15; numbers > 2^29-1 (after full 64-bit parse) are rejected.
// ===========================================================================

///|
test "redteam_octal_field_number_is_octal" {
  let s = sch("syntax = \"proto3\"; message M { int32 a = 017; }")
  let n = field_number_of(s, "M", "a")
  debug_assert(n == 15, "017 is octal 15 (protoc/protocompile), got " + n.to_string())
}

///|
test "redteam_field_number_overflow_rejected" {
  // 4294967297 = 2^32 + 1; Pion truncates to Int and gets field number 1.
  debug_assert(
    !parses("syntax = \"proto3\"; message M { int32 a = 4294967297; }"),
    "field number 4294967297 must be rejected",
  )
}

///|
test "redteam_enum_value_overflow_rejected" {
  // protoc: "Integer out of range." Pion wraps 2^32 to 0.
  debug_assert(
    !parses("syntax = \"proto3\"; enum E { Z = 0; BIG = 4294967296; }"),
    "enum value 4294967296 must be rejected",
  )
}

///|
test "redteam_hex_literal_without_digits_rejected" {
  debug_assert(!parses("syntax = \"proto3\"; enum E { Z = 0x; }"), "`0x` is not a number")
}

// ===========================================================================
// F-5 (P1) Proto3 Canonical JSON drops explicitly-present zero values
// (proto3 `optional` and every proto2 singular field have explicit presence).
// ===========================================================================

///|
test "redteam_json_proto3_optional_zero_is_emitted" {
  let s = sch("syntax = \"proto3\"; message M { optional int32 a = 1; optional string b = 2; }")
  let got = dec_json(s, "M", "08001200")
  let want = "{\"a\":0,\"b\":\"\"}"
  debug_assert(got == want, "proto3 optional zero must be in JSON\n got:  " + got + "\n want: " + want)
}

///|
test "redteam_json_proto2_optional_zero_is_emitted" {
  let s = sch("syntax = \"proto2\"; message M { optional int32 a = 1; optional bool b = 2; }")
  let got = dec_json(s, "M", "08001000")
  let want = "{\"a\":0,\"b\":false}"
  debug_assert(got == want, "proto2 optional zero must be in JSON\n got:  " + got + "\n want: " + want)
}

///|
test "redteam_json_emit_defaults_emits_unpopulated_fields" {
  // protojson EmitUnpopulated: every implicit-presence field is printed with its default.
  let s = sch("syntax = \"proto3\"; message M { int32 a = 1; string b = 2; repeated int32 c = 3; }")
  match protobuf::decode_dynamic_default(s, "M", Bytes::new(0)) {
    Err(e) => debug_assert(false, protobuf::error_message(e))
    Ok(m) => {
      let opts = protobuf::JsonOptions::{ ..protobuf::JsonOptions::default(), emit_defaults: true }
      match protobuf::to_proto3_json_with_options(s, m, opts) {
        Ok(js) => {
          let want = "{\"a\":0,\"b\":\"\",\"c\":[]}"
          debug_assert(js == want, "emit_defaults\n got:  " + js + "\n want: " + want)
        }
        Err(e) => debug_assert(false, protobuf::error_message(e))
      }
    }
  }
}

// ===========================================================================
// F-6 (P1) map<K,V>: duplicate keys on the wire are kept (no last-wins).
// Every Protobuf runtime (Go, C++, Java, prost HashMap) keeps exactly one entry per key.
// ===========================================================================

///|
test "redteam_map_duplicate_key_last_wins_json" {
  let s = sch("syntax = \"proto3\"; message M { map<string, int32> m = 1; }")
  // entries {"k":1} then {"k":2}
  let got = dec_json(s, "M", "0a050a016b10010a050a016b1002")
  let want = "{\"m\":{\"k\":2}}"
  debug_assert(got == want, "duplicate map key\n got:  " + got + "\n want: " + want)
}

///|
test "redteam_map_duplicate_key_last_wins_reencode" {
  let s = sch("syntax = \"proto3\"; message M { map<string, int32> m = 1; }")
  let got = dec_enc(s, "M", "0a050a016b10010a050a016b1002")
  let want = "0a050a016b1002" // go: proto.Marshal(Deterministic) of the decoded message
  debug_assert(got == want, "duplicate map key re-encode\n got:  " + got + "\n want: " + want)
}

// ===========================================================================
// F-7 (P1) proto2 / real-world `.proto` grammar that the parser rejects.
// protocompile (and protoc) accept every schema below.
// ===========================================================================

///|
test "redteam_schema_nested_extend_block" {
  debug_assert(
    parses(
      "syntax = \"proto2\"; message Foo { extensions 100 to max; }\n" +
      "message Bar { extend Foo { optional int32 bar = 100; } optional int32 x = 1; }",
    ),
    "extend inside a message must parse",
  )
}

///|
test "redteam_schema_proto2_group_field" {
  debug_assert(
    parses("syntax = \"proto2\"; message M { optional group Result = 1 { optional string url = 2; } }"),
    "proto2 group fields must parse",
  )
}

///|
test "redteam_schema_aggregate_option_with_brace_in_string" {
  // The `{ ... }` scanner counts braces inside string literals.
  debug_assert(
    parses(
      "syntax = \"proto3\"; import \"google/protobuf/descriptor.proto\";\n" +
      "message Opt { string s = 1; } extend google.protobuf.MessageOptions { Opt my_opt = 50001; }\n" +
      "message M { option (my_opt) = { s: \"}\" }; int32 a = 1; }",
    ),
    "aggregate option value containing \"}\" must parse",
  )
}

///|
test "redteam_schema_editions_2023" {
  debug_assert(
    parses("edition = \"2023\"; message M { int32 a = 1; }"),
    "edition = \"2023\" must parse (protobuf-go v1.36 supports editions)",
  )
}

///|
test "redteam_schema_string_hex_and_octal_escapes" {
  // json_name = "\x41\102" is "AB" in protoc.
  let s = sch("syntax = \"proto3\"; message M { int32 a = 1 [json_name = \"\\x41\\102\"]; }")
  let got = dec_json(s, "M", "0801")
  debug_assert(got == "{\"AB\":1}", "escaped json_name\n got:  " + got + "\n want: {\"AB\":1}")
}

// ===========================================================================
// F-12 (P2) Semantic validation protoc performs that the parser skips (all accepted by Pion).
