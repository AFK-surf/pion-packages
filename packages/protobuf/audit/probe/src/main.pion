///| Red-team differential probe for packages/protobuf (same protocol as ../../go/cmd/oracle).
///
///   probe varint <hexfile>                 OK <u64> <consumed> | ERR <msg>
///   probe tag <hexfile>                    OK <num> <wiretype> | ERR <msg>
///   probe wire <hexfile>                   OK <fields>          | ERR <msg>
///   probe dyn <x.proto> <Msg> <hexfile>    OK\t<json>\t<hex>    | ERR\t<msg>
///   probe dynall <x.proto> <Msg> <hexfile> same, JSON with emit_defaults
///   probe schema <x.proto>                 OK <summary>         | ERR <msg>
///   probe schemahex <hexfile>              one hex-encoded .proto source per line -> OK <summary> | ERR <msg>
///   probe deepdec <n>                      decode an n-deep Node{child} chain (max_depth = n+10)
///   probe deepgroup <n>                    decode + re-encode an n-deep unknown group (max_depth = n+10)
///   probe deepenc <n>                      encode an n-deep DynamicMessage built in memory
///   probe deepjson <n>                     to_proto3_json of an n-deep DynamicMessage (decoded, max_depth n+10)
///   probe bench <mode> <x.proto> <Msg> <file.bin> <iters>   modes: dec | decjson | roundtrip

import "protobuf"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn hex_range(src : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = nib(src[start + 2 * i].to_int())
    let lo = nib(src[start + 2 * i + 1].to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i).to_int() - 48)
    i = i + 1
  }
  v
}

///| Error message on one line (messages may quote source text containing newlines).
fn em(e : protobuf::ProtoError) -> String {
  let m = protobuf::error_message(e)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < m.length() {
    let c = m.code_unit_at(i)
    if c == 10 || c == 13 {
      sb.write_byte((32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn run_varint(input : Bytes) -> String {
  let r = protobuf::WireReader::new(input)
  match r.read_varint64() {
    Ok(v) => "OK " + v.to_string() + " " + r.pos().to_string()
    Err(e) => "ERR " + em(e)
  }
}

///|
fn run_tag(input : Bytes) -> String {
  let r = protobuf::WireReader::new(input)
  match r.read_tag() {
    Ok(t) => "OK " + t.field_number.to_string() + " " + protobuf::wire_type_code(t.wire_type).to_string()
    Err(e) => "ERR " + em(e)
  }
}

///|
fn run_wire(input : Bytes) -> String {
  let r = protobuf::WireReader::new(input)
  let mut n = 0
  while !r.is_eof() {
    let t = match r.read_tag() {
      Ok(t) => t
      Err(e) => return "ERR " + em(e)
    }
    match r.skip_field(t, 10000) {
      Ok(_) => ()
      Err(e) => return "ERR " + em(e)
    }
    n = n + 1
  }
  "OK " + n.to_string()
}

///|
fn run_dyn(schema : protobuf::Schema, msg : String, input : Bytes, emit_all : Bool) -> String {
  match protobuf::decode_dynamic_default(schema, msg, input) {
    Err(e) => "ERR\t" + em(e)
    Ok(m) => {
      let jopts = protobuf::JsonOptions::{ ..protobuf::JsonOptions::default(), emit_defaults: emit_all }
      let js = match protobuf::to_proto3_json_with_options(schema, m, jopts) {
        Ok(s) => s
        Err(e) => "JSONERR " + em(e)
      }
      match protobuf::encode_dynamic(schema, m) {
        Ok(b) => "OK\t" + js + "\t" + tohex(b)
        Err(e) => "OK\t" + js + "\tENCERR " + em(e)
      }
    }
  }
}

///|
fn summarize(s : protobuf::Schema) -> String {
  let parts : Array[String] = []
  summarize_list(s.messages, parts)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      sb.write_string(";")
    }
    sb.write_string(parts[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn sort_strings(xs : Array[String]) -> Unit {
  let n = xs.length()
  let mut i = 1
  while i < n {
    let x = xs[i]
    let mut j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
}

///|
fn summarize_list(ms : Array[protobuf::MessageDescriptor], parts : Array[String]) -> Unit {
  let mut i = 0
  while i < ms.length() {
    let m = ms[i]
    let fs : Array[String] = []
    let mut j = 0
    while j < m.fields.length() {
      fs.push(m.fields[j].name + "=" + m.fields[j].number.to_string())
      j = j + 1
    }
    sort_strings(fs)
    let sb = StringBuilder::new()
    sb.write_string(m.name + "{")
    j = 0
    while j < fs.length() {
      if j > 0 {
        sb.write_string(",")
      }
      sb.write_string(fs[j])
      j = j + 1
    }
    sb.write_string("}")
    parts.push(sb.to_string())
    summarize_list(m.nested_messages, parts)
    i = i + 1
  }
}

///|
fn node_schema() -> protobuf::Schema {
  match protobuf::parse_schema("syntax = \"proto3\"; message Node { Node child = 1; }") {
    Ok(s) => s
    Err(_) => abort("node schema")
  }
}

///| Node{child: Node{...}} n levels deep, built iteratively with one growing buffer.
fn deep_chain(n : Int) -> Bytes {
  let mut payload = Bytes::new(0)
  let mut d = 0
  while d < n {
    let w = protobuf::WireWriter::with_capacity(payload.length() + 12)
    w.write_bytes_field(1, payload)
    payload = w.to_bytes()
    d = d + 1
  }
  payload
}

///|
fn deep_opts(n : Int) -> protobuf::DecodeOptions {
  protobuf::DecodeOptions::{ ..protobuf::DecodeOptions::default(), max_depth: n + 10, max_fields: 100000000 }
}

///|
fn bench(world : World, mode : String, proto_path : String, msg_name : String, data_path : String, iters : Int) -> Int {
  let src = match fs_read_bytes(world, proto_path) {
    Ok(b) => b.to_string()
    Err(_) => return 1
  }
  let schema = match protobuf::parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "ERR " + em(e))
      return 2
    }
  }
  let data = match fs_read_bytes(world, data_path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let recs : Array[Bytes] = []
  let mut p = 0
  while p + 4 <= data.length() {
    let n = data[p].to_int() | (data[p + 1].to_int() << 8) | (data[p + 2].to_int() << 16) | (data[p + 3].to_int() << 24)
    recs.push(data.slice(p + 4, p + 4 + n))
    p = p + 4 + n
  }
  let opts = protobuf::DecodeOptions::{ ..protobuf::DecodeOptions::default(), max_fields: 2000000000 }
  let mut fields = 0L
  let mut out_bytes = 0L
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < recs.length() {
      let m = match protobuf::decode_dynamic(schema, msg_name, recs[i], opts) {
        Ok(m) => m
        Err(e) => {
          io_println(world, "ERR " + em(e))
          return 3
        }
      }
      if mode == "dec" {
        fields = fields + m.fields.length().to_int64()
      } else if mode == "decjson" {
        match protobuf::to_proto3_json(schema, m) {
          Ok(s) => out_bytes = out_bytes + s.length().to_int64()
          Err(e) => {
            io_println(world, "ERR " + em(e))
            return 3
          }
        }
        fields = fields + 1L
      } else {
        match protobuf::encode_dynamic(schema, m) {
          Ok(b) => out_bytes = out_bytes + b.length().to_int64()
          Err(e) => {
            io_println(world, "ERR " + em(e))
            return 3
          }
        }
        fields = fields + 1L
      }
      i = i + 1
    }
    it = it + 1
  }
  let _ = out_bytes
  if mode == "decjson" {
    io_println(world, "records=" + fields.to_string())
    return 0
  }
  io_println(
    world,
    "records=" + (recs.length() * iters).to_string() + " fields=" + fields.to_string() + " bytes=" + out_bytes.to_string(),
  )
  0
}

///|
fn deep(world : World, mode : String, n : Int) -> Int {
  let s = node_schema()
  if mode == "deepdec" || mode == "deepjson" {
    match protobuf::decode_dynamic(s, "Node", deep_chain(n), deep_opts(n)) {
      Err(e) => io_println(world, "ERR " + em(e))
      Ok(m) =>
      if mode == "deepdec" {
        match protobuf::encode_dynamic(s, m) {
          Ok(b) => io_println(world, "OK decoded+reencoded depth=" + n.to_string() + " len=" + b.length().to_string())
          Err(e) => io_println(world, "OK decoded depth=" + n.to_string() + " ENCERR " + em(e))
        }
      } else {
        match protobuf::to_proto3_json(s, m) {
          Ok(j) => io_println(world, "OK json len=" + j.length().to_string())
          Err(e) => io_println(world, "OK decoded depth=" + n.to_string() + " JSONERR " + em(e))
        }
      }
    }
    return 0
  }
  if mode == "deepgroup" {
    // unknown field 2 as n nested groups: (13)^n (14)^n
    let b = Bytes::new(2 * n)
    let mut i = 0
    while i < n {
      b[i] = (0x13).to_byte()
      b[n + i] = (0x14).to_byte()
      i = i + 1
    }
    match protobuf::decode_dynamic(s, "Node", b, deep_opts(n)) {
      Err(e) => io_println(world, "ERR " + em(e))
      Ok(m) =>
      match protobuf::encode_dynamic(s, m) {
        Ok(out) => io_println(world, "OK decoded+reencoded groups=" + n.to_string() + " len=" + out.length().to_string())
        Err(e) => io_println(world, "OK decoded ENCERR " + em(e))
      }
    }
    return 0
  }
  if mode == "deepenc" {
    let mut m = protobuf::DynamicMessage::new("Node")
    let mut i = 0
    while i < n {
      m = protobuf::set_field(protobuf::DynamicMessage::new("Node"), 1, protobuf::ProtoValue::Message(m))
      i = i + 1
    }
    match protobuf::encode_dynamic(s, m) {
      Ok(b) => io_println(world, "OK len=" + b.length().to_string())
      Err(e) => io_println(world, "ERR " + em(e))
    }
    return 0
  }
  1
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: see source header")
    return 2
  }
  let mode = args[1]
  if mode == "bench" && args.length() >= 7 {
    return bench(world, args[2], args[3], args[4], args[5], parse_int(args[6]))
  }
  if mode == "deepdec" || mode == "deepjson" || mode == "deepgroup" || mode == "deepenc" {
    return deep(world, mode, parse_int(args[2]))
  }
  if mode == "schema" {
    match fs_read_bytes(world, args[2]) {
      Err(_) => return 1
      Ok(b) =>
      match protobuf::parse_schema(b.to_string()) {
        Ok(s) => io_println(world, "OK " + summarize(s))
        Err(e) => io_println(world, "ERR " + em(e))
      }
    }
    return 0
  }
  let mut schema : Option[protobuf::Schema] = Option::None
  let mut msg = ""
  let mut path = args[2]
  if mode == "dyn" || mode == "dynall" {
    if args.length() < 5 {
      return 2
    }
    let src = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => return 1
    }
    match protobuf::parse_schema(src) {
      Ok(s) => schema = Option::Some(s)
      Err(e) => {
        io_println(world, "SCHEMAERR " + em(e))
        return 0
      }
    }
    msg = args[3]
    path = args[4]
  }
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read input")
      return 1
    }
  }
  let sb = StringBuilder::new()
  let mut start = 0
  let mut i = 0
  let n = data.length()
  while i <= n {
    if i == n || data[i].to_int() == 10 {
      if i > start {
        let input = hex_range(data, start, i)
        let line = if mode == "varint" {
          run_varint(input)
        } else if mode == "tag" {
          run_tag(input)
        } else if mode == "wire" {
          run_wire(input)
        } else if mode == "schemahex" {
          match protobuf::parse_schema(input.to_string()) {
            Ok(sc) => "OK " + summarize(sc)
            Err(e) => "ERR " + em(e)
          }
        } else {
          match schema {
            Some(s) => run_dyn(s, msg, input, mode == "dynall")
            None => "ERR no schema"
          }
        }
        sb.write_string(line)
        sb.write_string("\n")
      }
      start = i + 1
    }
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}
