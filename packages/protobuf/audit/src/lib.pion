///| Red-team audit helpers for packages/protobuf (no production code; see ../REPORT.md).

import "protobuf"

///|
fn audit_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///| Hex string ("0a03616263") to Bytes.
pub fn hx(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = audit_nibble(s.code_unit_at(2 * i).to_int())
    let lo = audit_nibble(s.code_unit_at(2 * i + 1).to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///| Bytes to lowercase hex.
pub fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///| Parse a schema; on error return an empty proto3 schema and report via the flag.
pub fn schema_of(src : String) -> Option[protobuf::Schema] {
  match protobuf::parse_schema(src) {
    Ok(s) => Option::Some(s)
    Err(_) => Option::None
  }
}

///| Decode + Proto3 JSON in one go; "ERR <msg>" on failure.
pub fn dec_json(schema : protobuf::Schema, msg : String, hex : String) -> String {
  match protobuf::decode_dynamic_default(schema, msg, hx(hex)) {
    Err(e) => "ERR " + protobuf::error_message(e)
    Ok(m) =>
    match protobuf::to_proto3_json(schema, m) {
      Ok(s) => s
      Err(e) => "JSONERR " + protobuf::error_message(e)
    }
  }
}

///| Decode + re-encode; "ERR <msg>" on failure.
pub fn dec_enc(schema : protobuf::Schema, msg : String, hex : String) -> String {
  match protobuf::decode_dynamic_default(schema, msg, hx(hex)) {
    Err(e) => "ERR " + protobuf::error_message(e)
    Ok(m) =>
    match protobuf::encode_dynamic(schema, m) {
      Ok(b) => tohex(b)
      Err(e) => "ENCERR " + protobuf::error_message(e)
    }
  }
}

///| Build `n` copies of `unit` (hex) concatenated.
pub fn repeat_hex(unit : String, n : Int) -> Bytes {
  let one = hx(unit)
  let m = one.length()
  let out = Bytes::new(m * n)
  let mut i = 0
  while i < n {
    let mut j = 0
    while j < m {
      out[i * m + j] = one[j]
      j = j + 1
    }
    i = i + 1
  }
  out
}
