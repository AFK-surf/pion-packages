///| Dynamic reflection message decode/encode, unknown fields roundtrip,
///  packed/unpacked compatibility, map/oneof, and Proto3 Canonical JSON tests.

///|
fn assert_opt_int(opt : Option[Int], want : Int, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v == want, label + ": got " + v.to_string() + ", want " + want.to_string())
    None => debug_assert(false, label + ": expected Some(" + want.to_string() + "), got None")
  }
}

///|
fn assert_opt_i64(opt : Option[Int64], want : Int64, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v == want, label + ": got " + v.to_string() + ", want " + want.to_string())
    None => debug_assert(false, label + ": expected Some(" + want.to_string() + "), got None")
  }
}

///|
fn assert_opt_u64(opt : Option[UInt64], want : UInt64, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v == want, label + ": got " + v.to_string() + ", want " + want.to_string())
    None => debug_assert(false, label + ": expected Some(" + want.to_string() + "), got None")
  }
}

///|
fn assert_opt_double(opt : Option[Double], want : Double, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v.to_bits() == want.to_bits(), label + ": float/double mismatch")
    None => debug_assert(false, label + ": expected Some, got None")
  }
}

///|
fn assert_opt_bool(opt : Option[Bool], want : Bool, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v == want, label + ": bool mismatch")
    None => debug_assert(false, label + ": expected Some, got None")
  }
}

///|
fn assert_opt_str(opt : Option[String], want : String, label : String) -> Unit {
  match opt {
    Some(v) => debug_assert(v == want, label + ": got " + v + ", want " + want)
    None => debug_assert(false, label + ": expected Some(" + want + "), got None")
  }
}

///|
fn sample_proto3_schema() -> Schema {
  let src = "syntax = \"proto3\";\n" +
  "package demo;\n" +
  "enum Status {\n" +
  "  STATUS_UNSPECIFIED = 0;\n" +
  "  STATUS_OK = 1;\n" +
  "  STATUS_FAIL = 2;\n" +
  "}\n" +
  "message Sub {\n" +
  "  int32 a = 1;\n" +
  "  string b = 2;\n" +
  "}\n" +
  "message AllTypes {\n" +
  "  int32 f_int32 = 1;\n" +
  "  int64 f_int64 = 2;\n" +
  "  uint32 f_uint32 = 3;\n" +
  "  uint64 f_uint64 = 4;\n" +
  "  sint32 f_sint32 = 5;\n" +
  "  sint64 f_sint64 = 6;\n" +
  "  fixed32 f_fixed32 = 7;\n" +
  "  fixed64 f_fixed64 = 8;\n" +
  "  sfixed32 f_sfixed32 = 9;\n" +
  "  sfixed64 f_sfixed64 = 10;\n" +
  "  float f_float = 11;\n" +
  "  double f_double = 12;\n" +
  "  bool f_bool = 13;\n" +
  "  string f_string = 14;\n" +
  "  bytes f_bytes = 15;\n" +
  "  Status f_enum = 16;\n" +
  "  Sub f_sub = 17;\n" +
  "  repeated int32 f_rep_int32 = 18;\n" +
  "  map<string, int64> f_map = 19;\n" +
  "  oneof choice {\n" +
  "    string oneof_str = 20;\n" +
  "    int32 oneof_int = 21;\n" +
  "  }\n" +
  "}\n"
  match parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "sample schema failed: " + error_message(e))
      Schema::{
        syntax: Syntax::Proto3,
        package_name: "",
        imports: [],
        options: [],
        messages: [],
        enums: [],
      }
    }
  }
}

///|
test "dynamic: all scalar types, nested message, repeated, map, oneof roundtrip" {
  let schema = sample_proto3_schema()
  let mut sub = DynamicMessage::new("Sub")
  sub = set_field(sub, 1, ProtoValue::Int32(150))
  sub = set_field(sub, 2, ProtoValue::String("nested"))

  let mut msg = DynamicMessage::new("AllTypes")
  msg = set_field(msg, 1, ProtoValue::Int32(-42))
  msg = set_field(msg, 2, ProtoValue::Int64(-9000000000000L))
  msg = set_field(msg, 3, ProtoValue::UInt32(3000000000L))
  msg = set_field(msg, 4, ProtoValue::UInt64(18000000000000000000UL))
  msg = set_field(msg, 5, ProtoValue::Int32(-12345))
  msg = set_field(msg, 6, ProtoValue::Int64(-9876543210123L))
  msg = set_field(msg, 7, ProtoValue::UInt32(0xDEADBEEFL))
  msg = set_field(msg, 8, ProtoValue::UInt64(0x0123456789ABCDEFUL))
  msg = set_field(msg, 9, ProtoValue::Int32(-777))
  msg = set_field(msg, 10, ProtoValue::Int64(-888888888888L))
  msg = set_field(msg, 11, ProtoValue::Float(1.5))
  msg = set_field(msg, 12, ProtoValue::Double(3.141592653589793))
  msg = set_field(msg, 13, ProtoValue::Bool(true))
  msg = set_field(msg, 14, ProtoValue::String("hello 世界"))
  msg = set_field(msg, 15, ProtoValue::Bytes("hello".to_bytes()))
  msg = set_field(msg, 16, ProtoValue::Enum(1))
  msg = set_field(msg, 17, ProtoValue::Message(sub))
  msg = set_field(
    msg,
    18,
    ProtoValue::List([ProtoValue::Int32(3), ProtoValue::Int32(270), ProtoValue::Int32(86942)]),
  )
  msg = set_field(
    msg,
    19,
    ProtoValue::Map([
      (ProtoValue::String("k1"), ProtoValue::Int64(100L)),
      (ProtoValue::String("k2"), ProtoValue::Int64(-200L)),
    ]),
  )
  msg = set_field(msg, 20, ProtoValue::String("chosen"))

  let encoded = match encode_dynamic(schema, msg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode_dynamic failed: " + error_message(e))
      return
    }
  }
  let dec = match decode_dynamic_default(schema, "AllTypes", encoded) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode_dynamic failed: " + error_message(e))
      return
    }
  }

  assert_opt_int(get_int32(dec, 1), -42, "f_int32")
  assert_opt_i64(get_int64(dec, 2), -9000000000000L, "f_int64")
  assert_opt_i64(get_uint32(dec, 3), 3000000000L, "f_uint32")
  assert_opt_u64(get_uint64(dec, 4), 18000000000000000000UL, "f_uint64")
  assert_opt_int(get_int32(dec, 5), -12345, "f_sint32")
  assert_opt_i64(get_int64(dec, 6), -9876543210123L, "f_sint64")
  assert_opt_i64(get_uint32(dec, 7), 0xDEADBEEFL, "f_fixed32")
  assert_opt_u64(get_uint64(dec, 8), 0x0123456789ABCDEFUL, "f_fixed64")
  assert_opt_int(get_int32(dec, 9), -777, "f_sfixed32")
  assert_opt_i64(get_int64(dec, 10), -888888888888L, "f_sfixed64")
  assert_opt_double(get_float(dec, 11), 1.5, "f_float")
  assert_opt_double(get_double(dec, 12), 3.141592653589793, "f_double")
  assert_opt_bool(get_bool(dec, 13), true, "f_bool")
  assert_opt_str(get_string(dec, 14), "hello 世界", "f_string")
  match get_bytes(dec, 15) {
    Some(b) => debug_assert(bytes_equal(b, "hello".to_bytes()), "f_bytes")
    None => debug_assert(false, "f_bytes missing")
  }
  assert_opt_int(get_enum(dec, 16), 1, "f_enum")
  match get_message(dec, 17) {
    Some(s) => {
      assert_opt_int(get_int32(s, 1), 150, "sub.a")
      assert_opt_str(get_string(s, 2), "nested", "sub.b")
    }
    None => debug_assert(false, "f_sub missing")
  }
  match get_list(dec, 18) {
    Some(xs) => {
      debug_assert(xs.length() == 3, "f_rep_int32 len")
      match (xs[0], xs[1], xs[2]) {
        (ProtoValue::Int32(3), ProtoValue::Int32(270), ProtoValue::Int32(86942)) => ()
        _ => debug_assert(false, "f_rep_int32 elements mismatch")
      }
    }
    None => debug_assert(false, "f_rep_int32 missing")
  }
  match get_map(dec, 19) {
    Some(pairs) => debug_assert(pairs.length() == 2, "f_map len")
    None => debug_assert(false, "f_map missing")
  }
  assert_opt_str(get_string(dec, 20), "chosen", "oneof_str")
  debug_assert(!has_field(dec, 21), "oneof_int should not be set")
}

///|
test "dynamic: packed and unpacked repeated dual-compatibility decode" {
  let schema = sample_proto3_schema()
  // Mix unpacked + packed + unpacked for field 18 (repeated int32)
  let w = WireWriter::new()
  w.write_int32_field(18, 10)
  w.write_packed_int32_field(18, [20, 30])
  w.write_int32_field(18, 40)
  let dec = match decode_dynamic_default(schema, "AllTypes", w.to_bytes()) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode mixed repeated failed: " + error_message(e))
      return
    }
  }
  match get_list(dec, 18) {
    Some(xs) => {
      debug_assert(xs.length() == 4, "expected 4 elements, got " + xs.length().to_string())
      match (xs[0], xs[1], xs[2], xs[3]) {
        (ProtoValue::Int32(10), ProtoValue::Int32(20), ProtoValue::Int32(30), ProtoValue::Int32(40)) => ()
        _ => debug_assert(false, "mixed repeated values mismatch")
      }
    }
    None => debug_assert(false, "field 18 missing")
  }
}

///|
test "dynamic: oneof exclusivity on wire and via set_field_by_name" {
  let schema = sample_proto3_schema()
  // Wire has oneof_str (20) then oneof_int (21): field 21 must win and clear field 20.
  let w = WireWriter::new()
  w.write_string_field(20, "first")
  w.write_int32_field(21, 99)
  let dec = match decode_dynamic_default(schema, "AllTypes", w.to_bytes()) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(!has_field(dec, 20), "oneof_str should be cleared by later oneof_int")
  assert_opt_int(get_int32(dec, 21), 99, "oneof_int should be 99")

  // Switch back via set_field_by_name
  let updated = match set_field_by_name(schema, dec, "oneof_str", ProtoValue::String("")) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  debug_assert(has_field(updated, 20), "oneof_str must be set even when empty string")
  debug_assert(!has_field(updated, 21), "oneof_int must be cleared")
  // Re-encode: explicit empty string in oneof must still be emitted on wire!
  let reenc = match encode_dynamic(schema, updated) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  let redec = match decode_dynamic_default(schema, "AllTypes", reenc) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  assert_opt_str(get_string(redec, 20), "", "oneof empty string must survive roundtrip")
}

///|
test "dynamic: nested submessage merge when repeated on wire" {
  let schema = sample_proto3_schema()
  let s1 = WireWriter::new()
  s1.write_int32_field(1, 77)
  let s2 = WireWriter::new()
  s2.write_string_field(2, "merged")

  let w = WireWriter::new()
  w.write_bytes_field(17, s1.to_bytes())
  w.write_bytes_field(17, s2.to_bytes())

  let dec = match decode_dynamic_default(schema, "AllTypes", w.to_bytes()) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  match get_message(dec, 17) {
    Some(sub) => {
      assert_opt_int(get_int32(sub, 1), 77, "merged sub.a")
      assert_opt_str(get_string(sub, 2), "merged", "merged sub.b")
    }
    None => debug_assert(false, "sub missing")
  }
}

///|
test "dynamic: unknown fields lossless preservation roundtrip (varint, fixed32, fixed64, bytes, group)" {
  let schema = sample_proto3_schema()
  let w = WireWriter::new()
  // Known field 1
  w.write_int32_field(1, 123)
  // Unknown field 500 (varint)
  w.write_uint64_field(500, 999999UL)
  // Unknown field 501 (fixed32)
  w.write_fixed32_field(501, 0xCAFEBABEL)
  // Unknown field 502 (fixed64)
  w.write_fixed64_field(502, 0x1122334455667788UL)
  // Unknown field 503 (length-delimited)
  w.write_bytes_field(503, "opaque-payload".to_bytes())
  // Unknown field 504 (group containing field 1 = 42)
  w.write_tag(504, WireType::StartGroup)
  w.write_int32_field(1, 42)
  w.write_tag(504, WireType::EndGroup)

  let original = w.to_bytes()
  let dec1 = match decode_dynamic_default(schema, "AllTypes", original) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "decode with unknowns failed: " + error_message(e))
      return
    }
  }
  assert_opt_int(get_int32(dec1, 1), 123, "known field 1")
  debug_assert(dec1.unknown_fields.length() == 5, "expected 5 unknown fields, got " + dec1.unknown_fields.length().to_string())

  // Re-encode and decode again: all 5 unknown fields must survive intact
  let reenc = match encode_dynamic(schema, dec1) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "re-encode with unknowns failed: " + error_message(e))
      return
    }
  }
  let dec2 = match decode_dynamic_default(schema, "AllTypes", reenc) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "second decode failed: " + error_message(e))
      return
    }
  }
  assert_opt_int(get_int32(dec2, 1), 123, "known field 1 after roundtrip")
  debug_assert(dec2.unknown_fields.length() == 5, "5 unknown fields after roundtrip")
  debug_assert(dec2.unknown_fields[0].field_number == 500, "unk 500")
  debug_assert(dec2.unknown_fields[1].field_number == 501, "unk 501")
  debug_assert(dec2.unknown_fields[2].field_number == 502, "unk 502")
  debug_assert(dec2.unknown_fields[3].field_number == 503, "unk 503")
  debug_assert(dec2.unknown_fields[4].field_number == 504, "unk 504 group")
  match dec2.unknown_fields[4].value {
    UnknownValue::Group(inner) => {
      debug_assert(inner.length() == 1 && inner[0].field_number == 1, "group inner field")
    }
    _ => debug_assert(false, "expected UnknownValue::Group")
  }
}

///|
test "json: Proto3 Canonical JSON mapping (camelCase, 64-bit string, Base64, enum, map, specials)" {
  let schema = sample_proto3_schema()
  let mut msg = DynamicMessage::new("AllTypes")
  msg = set_field(msg, 1, ProtoValue::Int32(42))
  msg = set_field(msg, 2, ProtoValue::Int64(9223372036854775807L))
  msg = set_field(msg, 4, ProtoValue::UInt64(18446744073709551615UL))
  msg = set_field(msg, 13, ProtoValue::Bool(true))
  msg = set_field(msg, 14, ProtoValue::String("a\"b\\c\nd"))
  msg = set_field(msg, 15, ProtoValue::Bytes("hello".to_bytes()))
  msg = set_field(msg, 16, ProtoValue::Enum(1))
  msg = set_field(
    msg,
    18,
    ProtoValue::List([ProtoValue::Int32(1), ProtoValue::Int32(2)]),
  )
  msg = set_field(
    msg,
    19,
    ProtoValue::Map([(ProtoValue::String("req"), ProtoValue::Int64(9007199254740993L))]),
  )

  let js = match to_proto3_json(schema, msg) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "to_proto3_json failed: " + error_message(e))
      return
    }
  }
  let expected = "{\"fInt32\":42,\"fInt64\":\"9223372036854775807\",\"fUint64\":\"18446744073709551615\",\"fBool\":true,\"fString\":\"a\\\"b\\\\c\\nd\",\"fBytes\":\"aGVsbG8=\",\"fEnum\":\"STATUS_OK\",\"fRepInt32\":[1,2],\"fMap\":{\"req\":\"9007199254740993\"}}"
  debug_assert(js == expected, "proto3 json mismatch:\ngot:  " + js + "\nwant: " + expected)
}

///|
test "dynamic: lossless non-minimal varint unknown field byte-exact roundtrip" {
  let s = match parse_schema("syntax = \"proto3\"; message M { int32 a = 1; }") {
    Ok(sc) => sc
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  // Unknown field 2 (tag 0x12 encoded non-minimally as 0x92 0x00) with bytes "b" (0x01 0x62)
  let raw = hex_to_bytes("92000162")
  match decode_dynamic_default(s, "M", raw) {
    Ok(m) =>
    match encode_dynamic(s, m) {
      Ok(out) => debug_assert(bytes_equal(out, raw), "non-minimal varint unknown field must round-trip byte-for-byte")
      Err(e) => debug_assert(false, error_message(e))
    }
    Err(e) => debug_assert(false, error_message(e))
  }
}

///|
test "dynamic: WKT Duration, Wrappers, Struct, Empty JSON mapping" {
  let src = "syntax = \"proto3\";\n" +
  "import \"google/protobuf/duration.proto\";\n" +
  "import \"google/protobuf/wrappers.proto\";\n" +
  "import \"google/protobuf/empty.proto\";\n" +
  "message W {\n" +
  "  google.protobuf.Duration dur = 1;\n" +
  "  google.protobuf.Int64Value i64 = 2;\n" +
  "  google.protobuf.Empty emp = 3;\n" +
  "}"
  let s = match parse_schema(src) {
    Ok(sc) => sc
    Err(e) => {
      debug_assert(false, error_message(e))
      return
    }
  }
  // dur={seconds: 2, nanos: 500000000}, i64={value: 42}, emp={}
  let d = WireWriter::new()
  d.write_int64_field(1, 2L)
  d.write_int32_field(2, 500000000)
  let iw = WireWriter::new()
  iw.write_int64_field(1, 42L)
  let w = WireWriter::new()
  w.write_subwriter_field(1, d)
  w.write_subwriter_field(2, iw)
  w.write_bytes_field(3, Bytes::new(0))
  match decode_dynamic_default(s, "W", w.to_bytes()) {
    Ok(m) =>
    match to_proto3_json(s, m) {
      Ok(js) => debug_assert(js == "{\"dur\":\"2.500s\",\"i64\":\"42\",\"emp\":{}}", "WKT JSON got: " + js)
      Err(e) => debug_assert(false, error_message(e))
    }
    Err(e) => debug_assert(false, error_message(e))
  }
}
