///| `.proto` v2/v3/edition lexer, AST parser, semantic validator, and lexical-scope linker.

///|
struct ProtoParser {
  src : String
  len : Int
  mut pos : Int
}

///|
fn is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

///|
fn is_ident_start(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

///|
fn is_ident_char(c : Int) -> Bool {
  is_ident_start(c) || (c >= 48 && c <= 57)
}

///|
fn is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///|
fn is_hex_digit(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else {
    c - 65 + 10
  }
}

///|
fn to_ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn ProtoParser::skip_ws_and_comments(self : ProtoParser) -> Result[Unit, ProtoError] {
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_space(c) {
      self.pos = self.pos + 1
    } else if c == 47 && self.pos + 1 < self.len {
      let c2 = self.src.code_unit_at(self.pos + 1)
      if c2 == 47 {
        // Line comment //
        self.pos = self.pos + 2
        while self.pos < self.len && self.src.code_unit_at(self.pos) != 10 {
          self.pos = self.pos + 1
        }
      } else if c2 == 42 {
        // Block comment /* ... */
        self.pos = self.pos + 2
        let mut closed = false
        while self.pos + 1 < self.len {
          if self.src.code_unit_at(self.pos) == 42 && self.src.code_unit_at(self.pos + 1) == 47 {
            self.pos = self.pos + 2
            closed = true
            break
          }
          self.pos = self.pos + 1
        }
        if !closed {
          return Err(ProtoError::SchemaError("unterminated block comment"))
        }
      } else {
        break
      }
    } else {
      break
    }
  }
  Ok(())
}

///|
fn ProtoParser::peek_char(self : ProtoParser) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

///|
fn ProtoParser::expect_char(self : ProtoParser, ch : Int) -> Result[Unit, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != ch {
    return Err(ProtoError::SchemaError("expected character at offset " + self.pos.to_string()))
  }
  self.pos = self.pos + 1
  Ok(())
}

///|
fn ProtoParser::try_char(self : ProtoParser, ch : Int) -> Result[Bool, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos < self.len && self.src.code_unit_at(self.pos) == ch {
    self.pos = self.pos + 1
    Ok(true)
  } else {
    Ok(false)
  }
}

///|
fn ProtoParser::read_ident(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  if start >= self.len || !is_ident_start(self.src.code_unit_at(start)) {
    return Err(ProtoError::SchemaError("expected identifier at offset " + start.to_string()))
  }
  self.pos = self.pos + 1
  while self.pos < self.len && is_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  Ok(self.src.slice(start, self.pos))
}

///| Read a possibly dot-qualified type/package name (e.g. `.google.protobuf.Timestamp` or `Span.Status`).
fn ProtoParser::read_qualified_ident(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 46 {
    self.pos = self.pos + 1
  }
  if self.pos >= self.len || !is_ident_start(self.src.code_unit_at(self.pos)) {
    return Err(ProtoError::SchemaError("expected qualified identifier at offset " + start.to_string()))
  }
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) {
      self.pos = self.pos + 1
    } else if c == 46 {
      self.pos = self.pos + 1
      if self.pos >= self.len || !is_ident_start(self.src.code_unit_at(self.pos)) {
        return Err(ProtoError::SchemaError("trailing or invalid dot in qualified identifier"))
      }
    } else {
      break
    }
  }
  Ok(self.src.slice(start, self.pos))
}

///| Encode a Unicode scalar value into UTF-8 bytes in `sb`.
fn write_utf8_scalar(sb : StringBuilder, cp : Int) -> Result[Unit, ProtoError] {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    return Err(ProtoError::SchemaError("invalid unicode escape"))
  }
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  Ok(())
}

///| Read a single or double quoted string literal (supporting adjacent string concatenation and full escapes).
fn ProtoParser::read_string_lit(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  let mut count = 0
  while self.pos < self.len {
    let q = self.src.code_unit_at(self.pos)
    if q != 34 && q != 39 {
      break
    }
    count = count + 1
    self.pos = self.pos + 1
    let mut closed = false
    while self.pos < self.len {
      let c = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if c == q {
        closed = true
        break
      }
      if c == 10 || c == 0 {
        return Err(ProtoError::SchemaError("unterminated string literal"))
      }
      if c == 92 {
        // '\\'
        if self.pos >= self.len {
          return Err(ProtoError::SchemaError("unterminated string escape"))
        }
        let esc = self.src.code_unit_at(self.pos)
        self.pos = self.pos + 1
        if esc == 97 {
          sb.write_byte((7).to_byte()) // \a
        } else if esc == 98 {
          sb.write_byte((8).to_byte()) // \b
        } else if esc == 102 {
          sb.write_byte((12).to_byte()) // \f
        } else if esc == 110 {
          sb.write_byte((10).to_byte()) // \n
        } else if esc == 114 {
          sb.write_byte((13).to_byte()) // \r
        } else if esc == 116 {
          sb.write_byte((9).to_byte()) // \t
        } else if esc == 118 {
          sb.write_byte((11).to_byte()) // \v
        } else if esc == 92 {
          sb.write_byte((92).to_byte()) // \\
        } else if esc == 34 {
          sb.write_byte((34).to_byte()) // \"
        } else if esc == 39 {
          sb.write_byte((39).to_byte()) // \'
        } else if esc == 63 {
          sb.write_byte((63).to_byte()) // \?
        } else if esc == 120 || esc == 88 {
          // \xHH (1 or 2 hex digits)
          if self.pos >= self.len || !is_hex_digit(self.src.code_unit_at(self.pos)) {
            return Err(ProtoError::SchemaError("invalid hex escape in string"))
          }
          let mut bval = hex_val(self.src.code_unit_at(self.pos))
          self.pos = self.pos + 1
          if self.pos < self.len && is_hex_digit(self.src.code_unit_at(self.pos)) {
            bval = bval * 16 + hex_val(self.src.code_unit_at(self.pos))
            self.pos = self.pos + 1
          }
          sb.write_byte(bval.to_byte())
        } else if esc >= 48 && esc <= 55 {
          // \OOO (1 to 3 octal digits)
          let mut bval = esc - 48
          let mut digits = 1
          while digits < 3 && self.pos < self.len {
            let oc = self.src.code_unit_at(self.pos)
            if oc >= 48 && oc <= 55 {
              bval = bval * 8 + (oc - 48)
              self.pos = self.pos + 1
              digits = digits + 1
            } else {
              break
            }
          }
          if bval > 255 {
            return Err(ProtoError::SchemaError("octal escape out of byte range"))
          }
          sb.write_byte(bval.to_byte())
        } else if esc == 117 {
          // \uHHHH
          if self.pos + 4 > self.len {
            return Err(ProtoError::SchemaError("truncated \\u escape"))
          }
          let mut cp = 0
          let mut k = 0
          while k < 4 {
            let hc = self.src.code_unit_at(self.pos + k)
            if !is_hex_digit(hc) {
              return Err(ProtoError::SchemaError("invalid \\u escape"))
            }
            cp = cp * 16 + hex_val(hc)
            k = k + 1
          }
          self.pos = self.pos + 4
          match write_utf8_scalar(sb, cp) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        } else if esc == 85 {
          // \UHHHHHHHH
          if self.pos + 8 > self.len {
            return Err(ProtoError::SchemaError("truncated \\U escape"))
          }
          let mut cp = 0
          let mut k = 0
          while k < 8 {
            let hc = self.src.code_unit_at(self.pos + k)
            if !is_hex_digit(hc) {
              return Err(ProtoError::SchemaError("invalid \\U escape"))
            }
            cp = cp * 16 + hex_val(hc)
            k = k + 1
          }
          self.pos = self.pos + 8
          match write_utf8_scalar(sb, cp) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        } else {
          return Err(ProtoError::SchemaError("invalid escape sequence in string"))
        }
      } else {
        sb.write_byte(c.to_byte())
      }
    }
    if !closed {
      return Err(ProtoError::SchemaError("unterminated string literal"))
    }
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  if count == 0 {
    return Err(ProtoError::SchemaError("expected string literal at offset " + self.pos.to_string()))
  }
  Ok(sb.to_string())
}

///| Parse an integer literal string with sign, base (decimal, octal `0...`, hex `0x...`), and UInt64 overflow check.
///  Returns `(is_negative, magnitude_u64)`.
fn parse_int_literal_str(s : String) -> Result[(Bool, UInt64), ProtoError] {
  let n = s.length()
  if n == 0 {
    return Err(ProtoError::SchemaError("empty integer literal"))
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if s.code_unit_at(i) == 43 {
    i = i + 1
  }
  if i >= n || !is_digit(s.code_unit_at(i)) {
    return Err(ProtoError::SchemaError("invalid integer literal: " + s))
  }
  let mut acc : UInt64 = 0UL
  let max_u64 : UInt64 = 0xFFFFFFFFFFFFFFFFUL
  if s.code_unit_at(i) == 48 && i + 1 < n && (s.code_unit_at(i + 1) == 120 || s.code_unit_at(i + 1) == 88) {
    // Hex 0x...
    i = i + 2
    if i >= n {
      return Err(ProtoError::SchemaError("hex literal without digits: " + s))
    }
    while i < n {
      let c = s.code_unit_at(i)
      if !is_hex_digit(c) {
        return Err(ProtoError::SchemaError("invalid hex digit in: " + s))
      }
      let d = hex_val(c).to_int64().to_uint64()
      if acc > (max_u64 - d) / 16UL {
        return Err(ProtoError::SchemaError("integer literal overflow: " + s))
      }
      acc = acc * 16UL + d
      i = i + 1
    }
  } else if s.code_unit_at(i) == 48 && i + 1 < n {
    // Octal 0...
    i = i + 1
    while i < n {
      let c = s.code_unit_at(i)
      if c < 48 || c > 55 {
        return Err(ProtoError::SchemaError("invalid octal digit in: " + s))
      }
      let d = (c - 48).to_int64().to_uint64()
      if acc > (max_u64 - d) / 8UL {
        return Err(ProtoError::SchemaError("integer literal overflow: " + s))
      }
      acc = acc * 8UL + d
      i = i + 1
    }
  } else {
    // Decimal
    while i < n {
      let c = s.code_unit_at(i)
      if !is_digit(c) {
        return Err(ProtoError::SchemaError("invalid decimal digit in: " + s))
      }
      let d = (c - 48).to_int64().to_uint64()
      if acc > (max_u64 - d) / 10UL {
        return Err(ProtoError::SchemaError("integer literal overflow: " + s))
      }
      acc = acc * 10UL + d
      i = i + 1
    }
  }
  Ok((neg, acc))
}

///| Read a signed/unsigned integer literal token with octal/hex support and full overflow checking.
fn ProtoParser::read_int_u64(self : ProtoParser) -> Result[(Bool, UInt64), ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 45 {
    self.pos = self.pos + 1
    // Allow whitespace between '-' and digits (protoc allows `- 1`)
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let dig_start = self.pos
  if dig_start >= self.len || !is_digit(self.src.code_unit_at(dig_start)) {
    return Err(ProtoError::SchemaError("expected integer at offset " + start.to_string()))
  }
  while self.pos < self.len && is_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  // Reject floating-point literal where integer is required (e.g. `1.5`)
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 46 {
    return Err(ProtoError::SchemaError("unexpected float literal where integer expected"))
  }
  let neg = self.src.code_unit_at(start) == 45
  let raw = self.src.slice(dig_start, self.pos)
  match parse_int_literal_str(raw) {
    Ok((_, mag)) => Ok((neg, mag))
    Err(e) => Err(e)
  }
}

///| Read a signed 32-bit integer (for enum values and enum reserved ranges).
fn ProtoParser::read_int32(self : ProtoParser) -> Result[Int, ProtoError] {
  let (neg, mag) = match self.read_int_u64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if neg {
    if mag > 2147483648UL {
      return Err(ProtoError::SchemaError("int32 literal out of range"))
    }
    if mag == 2147483648UL {
      Ok(-2147483647 - 1)
    } else {
      Ok(-mag.to_int64().to_int())
    }
  } else {
    if mag > 2147483647UL {
      return Err(ProtoError::SchemaError("int32 literal out of range"))
    }
    Ok(mag.to_int64().to_int())
  }
}

///| Read a Protobuf field number (`1..536870911`, rejecting negative, 0, reserved 19000..19999, and overflow).
fn ProtoParser::read_field_number(self : ProtoParser) -> Result[Int, ProtoError] {
  let (neg, mag) = match self.read_int_u64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if neg || mag == 0UL || mag > max_field_number.to_int64().to_uint64() {
    return Err(ProtoError::SchemaError("field number out of range"))
  }
  let num = mag.to_int64().to_int()
  match validate_field_number(num, true) {
    Ok(_) => Ok(num)
    Err(e) => Err(e)
  }
}

///| Read an option value (string, bool, number, identifier, or string-aware `{ ... }` aggregate).
fn ProtoParser::read_option_value(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c = self.peek_char()
  if c == 34 || c == 39 {
    return self.read_string_lit()
  }
  if c == 123 {
    // Aggregate option `{ ... }` (string- and comment-aware!)
    let start = self.pos
    let mut depth = 0
    while self.pos < self.len {
      match self.skip_ws_and_comments() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if self.pos >= self.len {
        return Err(ProtoError::SchemaError("unterminated aggregate option"))
      }
      let ch = self.src.code_unit_at(self.pos)
      if ch == 34 || ch == 39 {
        match self.read_string_lit() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else if ch == 123 {
        depth = depth + 1
        self.pos = self.pos + 1
      } else if ch == 125 {
        depth = depth - 1
        self.pos = self.pos + 1
        if depth == 0 {
          return Ok(self.src.slice(start, self.pos))
        }
      } else {
        self.pos = self.pos + 1
      }
    }
    return Err(ProtoError::SchemaError("unterminated aggregate option"))
  }
  let start = self.pos
  while self.pos < self.len {
    let ch = self.src.code_unit_at(self.pos)
    if ch == 59 || ch == 44 || ch == 93 || is_space(ch) {
      break
    }
    self.pos = self.pos + 1
  }
  if self.pos == start {
    return Err(ProtoError::SchemaError("expected option value at offset " + start.to_string()))
  }
  Ok(self.src.slice(start, self.pos))
}

///| Read an option name (supports `(custom.opt).sub`).
fn ProtoParser::read_option_name(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) || c == 46 || c == 40 || c == 41 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  if self.pos == start {
    return Err(ProtoError::SchemaError("expected option name at offset " + start.to_string()))
  }
  Ok(self.src.slice(start, self.pos))
}

///| Parse `[k = v, k2 = v2]` field/enum-value options.
fn ProtoParser::parse_bracket_options(self : ProtoParser) -> Result[Array[ProtoOption], ProtoError] {
  let opts : Array[ProtoOption] = []
  match self.try_char(91) {
    Ok(true) => ()
    Ok(false) => return Ok(opts)
    Err(e) => return Err(e)
  }
  while true {
    let name = match self.read_option_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_char(61) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let opt_v = match self.read_option_value() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    opts.push(ProtoOption::{ name: name, value: opt_v })
    match self.try_char(44) {
      Ok(true) => continue
      Ok(false) => break
      Err(e) => return Err(e)
    }
  }
  match self.expect_char(93) {
    Ok(_) => Ok(opts)
    Err(e) => Err(e)
  }
}

///| Parse `reserved ...;` into ranges or names.
fn ProtoParser::parse_reserved(
  self : ProtoParser,
  ranges : Array[ReservedRange],
  names : Array[String],
  is_enum : Bool,
) -> Result[Unit, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c = self.peek_char()
  if c == 34 || c == 39 {
    while true {
      let name = match self.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      names.push(name)
      match self.try_char(44) {
        Ok(true) => continue
        Ok(false) => break
        Err(e) => return Err(e)
      }
    }
  } else {
    let max_val = if is_enum { 2147483647 } else { max_field_number }
    while true {
      let start_num = match self.read_int32() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      if !is_enum && (start_num <= 0 || start_num > max_field_number) {
        return Err(ProtoError::SchemaError("reserved field number out of range"))
      }
      match self.skip_ws_and_comments() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let mut end_num = start_num
      if self.pos + 2 <= self.len && self.src.slice(self.pos, self.pos + 2) == "to" && (self.pos + 2 == self.len || !is_ident_char(self.src.code_unit_at(self.pos + 2))) {
        self.pos = self.pos + 2
        match self.skip_ws_and_comments() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if self.pos + 3 <= self.len && self.src.slice(self.pos, self.pos + 3) == "max" && (self.pos + 3 == self.len || !is_ident_char(self.src.code_unit_at(self.pos + 3))) {
          self.pos = self.pos + 3
          end_num = max_val
        } else {
          end_num = match self.read_int32() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
          if !is_enum && (end_num <= 0 || end_num > max_field_number) {
            return Err(ProtoError::SchemaError("reserved field number out of range"))
          }
        }
        if end_num < start_num {
          return Err(ProtoError::SchemaError("reserved range end < start"))
        }
      }
      ranges.push(ReservedRange::{ start: start_num, end: end_num })
      match self.try_char(44) {
        Ok(true) => continue
        Ok(false) => break
        Err(e) => return Err(e)
      }
    }
  }
  self.expect_char(59)
}

///| Map a `.proto` type name string to `FieldType`.
fn parse_scalar_or_named_type(name : String) -> FieldType {
  match name {
    "double" => FieldType::Double
    "float" => FieldType::Float
    "int32" => FieldType::Int32
    "int64" => FieldType::Int64
    "uint32" => FieldType::UInt32
    "uint64" => FieldType::UInt64
    "sint32" => FieldType::SInt32
    "sint64" => FieldType::SInt64
    "fixed32" => FieldType::Fixed32
    "fixed64" => FieldType::Fixed64
    "sfixed32" => FieldType::SFixed32
    "sfixed64" => FieldType::SFixed64
    "bool" => FieldType::Bool
    "string" => FieldType::String
    "bytes" => FieldType::Bytes
    _ => FieldType::Named(name)
  }
}

///| Check whether a FieldType is a legal Protobuf map key type.
fn is_valid_map_key_type(ft : FieldType) -> Bool {
  match ft {
    Int32 | Int64 | UInt32 | UInt64 | SInt32 | SInt64 | Fixed32 | Fixed64 | SFixed32 | SFixed64 | Bool | String =>
    true
    _ => false
  }
}

///| Parse `enum Name { ... }`.
fn ProtoParser::parse_enum(
  self : ProtoParser,
  prefix : String,
  syntax : Syntax,
  is_edition : Bool,
) -> Result[EnumDescriptor, ProtoError] {
  let name = match self.read_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let full_name = if prefix.length() == 0 { name } else { prefix + "." + name }
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let values : Array[EnumValueDescriptor] = []
  let options : Array[ProtoOption] = []
  let reserved_ranges : Array[ReservedRange] = []
  let reserved_names : Array[String] = []
  let mut allow_alias = false
  let seen_names : Map[String, Bool] = Map::new()
  let seen_nums : Map[Int, Bool] = Map::new()
  let mut has_alias = false
  let mut has_zero = false

  while true {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated enum " + name))
    }
    let c = self.peek_char()
    if c == 125 {
      self.pos = self.pos + 1
      break
    }
    if c == 59 {
      self.pos = self.pos + 1
      continue
    }
    let word = match self.read_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if word == "option" {
      let opt_name = match self.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match self.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if opt_name == "allow_alias" && opt_val == "true" {
        allow_alias = true
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if word == "reserved" {
      match self.parse_reserved(reserved_ranges, reserved_names, true) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let num = match self.read_int32() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.parse_bracket_options() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match seen_names.get(word) {
        Some(_) => return Err(ProtoError::SchemaError("duplicate enum value name: " + word))
        None => ()
      }
      seen_names.set(word, true)
      match seen_nums.get(num) {
        Some(_) => has_alias = true
        None => seen_nums.set(num, true)
      }
      if num == 0 {
        has_zero = true
      }
      values.push(EnumValueDescriptor::{ name: word, number: num })
    }
  }
  if values.length() == 0 {
    return Err(ProtoError::SchemaError("enum must have at least one value: " + name))
  }
  if has_alias && !allow_alias {
    return Err(ProtoError::SchemaError("duplicate enum value without allow_alias in " + name))
  }
  let is_proto3 = match syntax {
    Syntax::Proto3 => !is_edition
    Syntax::Proto2 => false
  }
  if is_proto3 && !has_zero {
    return Err(ProtoError::SchemaError("proto3 enum must have a zero value: " + name))
  }
  // Validate enum values against reserved numbers and names
  let mut i = 0
  while i < values.length() {
    let ev = values[i]
    let mut r = 0
    while r < reserved_ranges.length() {
      if ev.number >= reserved_ranges[r].start && ev.number <= reserved_ranges[r].end {
        return Err(ProtoError::SchemaError("enum value uses reserved number: " + ev.number.to_string()))
      }
      r = r + 1
    }
    let mut rn = 0
    while rn < reserved_names.length() {
      if ev.name == reserved_names[rn] {
        return Err(ProtoError::SchemaError("enum value uses reserved name: " + ev.name))
      }
      rn = rn + 1
    }
    i = i + 1
  }
  Ok(EnumDescriptor::{
    name: name,
    full_name: full_name,
    values: values,
    options: options,
    reserved_ranges: reserved_ranges,
    reserved_names: reserved_names,
  })
}

///| Validate a scalar default value string against its field type.
fn validate_scalar_default(ft : FieldType, dv : String) -> Result[Unit, ProtoError] {
  match ft {
    FieldType::Int32 | FieldType::SInt32 | FieldType::SFixed32 => {
      let (neg, mag) = match parse_int_literal_str(dv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if neg {
        if mag > 2147483648UL {
          return Err(ProtoError::SchemaError("default int32 out of range: " + dv))
        }
      } else if mag > 2147483647UL {
        return Err(ProtoError::SchemaError("default int32 out of range: " + dv))
      }
      Ok(())
    }
    FieldType::UInt32 | FieldType::Fixed32 => {
      let (neg, mag) = match parse_int_literal_str(dv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if neg || mag > 4294967295UL {
        return Err(ProtoError::SchemaError("default uint32 out of range: " + dv))
      }
      Ok(())
    }
    FieldType::Int64 | FieldType::SInt64 | FieldType::SFixed64 => {
      let (neg, mag) = match parse_int_literal_str(dv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if neg {
        if mag > 9223372036854775808UL {
          return Err(ProtoError::SchemaError("default int64 out of range: " + dv))
        }
      } else if mag > 9223372036854775807UL {
        return Err(ProtoError::SchemaError("default int64 out of range: " + dv))
      }
      Ok(())
    }
    FieldType::UInt64 | FieldType::Fixed64 => {
      let (neg, _) = match parse_int_literal_str(dv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if neg {
        return Err(ProtoError::SchemaError("default uint64 cannot be negative: " + dv))
      }
      Ok(())
    }
    FieldType::Bool =>
    if dv == "true" || dv == "false" {
      Ok(())
    } else {
      Err(ProtoError::SchemaError("invalid bool default: " + dv))
    }
    _ => Ok(())
  }
}

///| Build a FieldDescriptor from parsed field components and validate tag number, name, and options in O(1).
fn build_field_descriptor(
  name : String,
  number : Int,
  label : FieldLabel,
  field_type : FieldType,
  oneof_index : Int,
  opts : Array[ProtoOption],
  seen_numbers : Map[Int, Bool],
  seen_names : Map[String, Bool],
  seen_json_names : Map[String, Bool],
  syntax : Syntax,
  is_edition : Bool,
  is_group : Bool,
) -> Result[FieldDescriptor, ProtoError] {
  match validate_field_number(number, true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match seen_numbers.get(number) {
    Some(_) => return Err(ProtoError::SchemaError("duplicate field number " + number.to_string()))
    None => ()
  }
  seen_numbers.set(number, true)
  match seen_names.get(name) {
    Some(_) => return Err(ProtoError::SchemaError("duplicate field name " + name))
    None => ()
  }
  seen_names.set(name, true)
  let is_proto3 = match syntax {
    Syntax::Proto3 => !is_edition
    Syntax::Proto2 => false
  }
  if is_proto3 || is_edition {
    match label {
      FieldLabel::Required =>
      return Err(ProtoError::SchemaError("required fields are not allowed in proto3/editions"))
      _ => ()
    }
  }
  let mut json_name = to_lower_camel_case(name)
  let mut packed : Option[Bool] = Option::None
  let mut default_value : Option[String] = Option::None
  let mut effective_label = label
  let mut j = 0
  while j < opts.length() {
    let o = opts[j]
    if o.name == "json_name" {
      json_name = o.value
    } else if o.name == "packed" {
      if o.value == "true" {
        packed = Option::Some(true)
      } else if o.value == "false" {
        packed = Option::Some(false)
      }
    } else if o.name == "default" {
      match validate_scalar_default(field_type, o.value) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      default_value = Option::Some(o.value)
    } else if is_edition && o.name == "features.field_presence" {
      if o.value == "IMPLICIT" {
        effective_label = FieldLabel::Implicit
      } else if o.value == "EXPLICIT" {
        effective_label = FieldLabel::Optional
      }
    }
    j = j + 1
  }
  if is_proto3 || is_edition {
    match seen_json_names.get(json_name) {
      Some(_) => return Err(ProtoError::SchemaError("JSON name conflict: " + json_name))
      None => ()
    }
    seen_json_names.set(json_name, true)
  }
  Ok(FieldDescriptor::{
    name: name,
    number: number,
    label: effective_label,
    field_type: field_type,
    oneof_index: oneof_index,
    json_name: json_name,
    packed: packed,
    default_value: default_value,
    options: opts,
    resolved_kind: 0,
    resolved_path: [],
    is_group: is_group,
  })
}

///| Skip a `{ ... }` block (for `service`, `extend`, etc.).
fn ProtoParser::skip_brace_block(self : ProtoParser) -> Result[Unit, ProtoError] {
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut depth = 1
  while depth > 0 {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated block"))
    }
    let c = self.src.code_unit_at(self.pos)
    if c == 34 || c == 39 {
      match self.read_string_lit() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if c == 123 {
      depth = depth + 1
      self.pos = self.pos + 1
    } else if c == 125 {
      depth = depth - 1
      self.pos = self.pos + 1
    } else {
      self.pos = self.pos + 1
    }
  }
  Ok(())
}

///| Skip an `extensions ...;` statement (string-, comment-, brace- and bracket-aware).
fn ProtoParser::skip_extensions_stmt(self : ProtoParser) -> Result[Unit, ProtoError] {
  let mut brace_depth = 0
  let mut bracket_depth = 0
  while self.pos < self.len {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated extensions statement"))
    }
    let c = self.src.code_unit_at(self.pos)
    if c == 34 || c == 39 {
      match self.read_string_lit() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if c == 123 {
      brace_depth = brace_depth + 1
      self.pos = self.pos + 1
    } else if c == 125 {
      brace_depth = brace_depth - 1
      self.pos = self.pos + 1
    } else if c == 91 {
      bracket_depth = bracket_depth + 1
      self.pos = self.pos + 1
    } else if c == 93 {
      bracket_depth = bracket_depth - 1
      self.pos = self.pos + 1
    } else if c == 59 && brace_depth == 0 && bracket_depth == 0 {
      self.pos = self.pos + 1
      return Ok(())
    } else {
      self.pos = self.pos + 1
    }
  }
  Err(ProtoError::SchemaError("unterminated extensions statement"))
}

///| Parse a `oneof Name { ... }` block inside a message.
fn ProtoParser::parse_oneof_block(
  self : ProtoParser,
  oneofs : Array[OneofDescriptor],
  fields : Array[FieldDescriptor],
  seen_numbers : Map[Int, Bool],
  seen_names : Map[String, Bool],
  seen_json_names : Map[String, Bool],
  syntax : Syntax,
  is_edition : Bool,
) -> Result[Unit, ProtoError] {
  let oneof_name = match self.read_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let oneof_idx = oneofs.length()
  let oneof_nums : Array[Int] = []
  while true {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated oneof " + oneof_name))
    }
    if self.peek_char() == 125 {
      self.pos = self.pos + 1
      break
    }
    if self.peek_char() == 59 {
      self.pos = self.pos + 1
      continue
    }
    let ftype_str = match self.read_qualified_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if ftype_str == "option" {
      let oname = match self.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = match self.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if oname.length() > 0 && oname.code_unit_at(0) != 40 && oname != "features" && !oname.starts_with("features.") {
        return Err(ProtoError::SchemaError("unknown oneof option: " + oname))
      }
      continue
    }
    if ftype_str == "repeated" || ftype_str == "optional" || ftype_str == "required" || ftype_str == "map" {
      return Err(ProtoError::SchemaError("label or map not allowed inside oneof: " + ftype_str))
    }
    let fname = match self.read_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match self.expect_char(61) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let fnum = match self.read_field_number() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let fopts = match self.parse_bracket_options() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    match self.expect_char(59) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let fd = match build_field_descriptor(
      fname,
      fnum,
      FieldLabel::Optional,
      parse_scalar_or_named_type(ftype_str),
      oneof_idx,
      fopts,
      seen_numbers,
      seen_names,
      seen_json_names,
      syntax,
      is_edition,
      false,
    ) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    oneof_nums.push(fnum)
    fields.push(fd)
  }
  oneofs.push(OneofDescriptor::{ name: oneof_name, field_numbers: oneof_nums })
  Ok(())
}

///| Parse a `map<K, V> name = N [opts];` field inside a message.
fn ProtoParser::parse_map_field(
  self : ProtoParser,
  fields : Array[FieldDescriptor],
  seen_numbers : Map[Int, Bool],
  seen_names : Map[String, Bool],
  seen_json_names : Map[String, Bool],
  syntax : Syntax,
  is_edition : Bool,
) -> Result[Unit, ProtoError] {
  match self.expect_char(60) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let kt_str = match self.read_qualified_ident() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let kt = parse_scalar_or_named_type(kt_str)
  if !is_valid_map_key_type(kt) {
    return Err(ProtoError::SchemaError("invalid map key type: " + kt_str))
  }
  match self.expect_char(44) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let vt_str = match self.read_qualified_ident() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let vt = parse_scalar_or_named_type(vt_str)
  match self.expect_char(62) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fname = match self.read_ident() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match self.expect_char(61) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fnum = match self.read_field_number() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let fopts = match self.parse_bracket_options() {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  match self.expect_char(59) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fd = match build_field_descriptor(
    fname,
    fnum,
    FieldLabel::Repeated,
    FieldType::Map(kt, vt),
    -1,
    fopts,
    seen_numbers,
    seen_names,
    seen_json_names,
    syntax,
    is_edition,
    false,
  ) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  fields.push(fd)
  Ok(())
}

///| Parse a regular or proto2 group field inside a message.
fn ProtoParser::parse_regular_or_group_field(
  self : ProtoParser,
  first : String,
  full_name : String,
  depth : Int,
  fields : Array[FieldDescriptor],
  nested_messages : Array[MessageDescriptor],
  seen_numbers : Map[Int, Bool],
  seen_names : Map[String, Bool],
  seen_json_names : Map[String, Bool],
  syntax : Syntax,
  is_edition : Bool,
) -> Result[Unit, ProtoError] {
  let mut label = if is_edition { FieldLabel::Optional } else { FieldLabel::Implicit }
  let mut has_explicit_label = false
  let mut type_str = first
  if first == "optional" {
    label = FieldLabel::Optional
    has_explicit_label = true
    type_str = match self.read_qualified_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  } else if first == "required" {
    label = FieldLabel::Required
    has_explicit_label = true
    type_str = match self.read_qualified_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  } else if first == "repeated" {
    label = FieldLabel::Repeated
    has_explicit_label = true
    type_str = match self.read_qualified_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  }
  if has_explicit_label && type_str == "map" {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.peek_char() == 60 {
      return Err(ProtoError::SchemaError("map fields cannot have a label"))
    }
  }
  if has_explicit_label && type_str == "group" {
    let is_proto2 = match syntax {
      Syntax::Proto2 => true
      Syntax::Proto3 => false
    }
    if !is_proto2 {
      return Err(ProtoError::SchemaError("group fields are only allowed in proto2"))
    }
    if depth >= 31 {
      return Err(ProtoError::MaxDepthExceeded(32))
    }
    let gname = match self.read_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let first_c = gname.code_unit_at(0)
    if first_c < 65 || first_c > 90 {
      return Err(ProtoError::SchemaError("group name must start with an uppercase letter: " + gname))
    }
    match self.expect_char(61) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let fnum = match self.read_field_number() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let fopts = match self.parse_bracket_options() {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    let gfull = if full_name.length() == 0 { gname } else { full_name + "." + gname }
    let gmsg = match self.parse_message_body(gname, gfull, depth + 1, syntax, is_edition) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    nested_messages.push(gmsg)
    let fname = to_ascii_lower(gname)
    let fd = match build_field_descriptor(
      fname,
      fnum,
      label,
      FieldType::Named("." + gfull),
      -1,
      fopts,
      seen_numbers,
      seen_names,
      seen_json_names,
      syntax,
      is_edition,
      true,
    ) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    fields.push(fd)
    return Ok(())
  }
  let fname = match self.read_ident() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match self.expect_char(61) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fnum = match self.read_field_number() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let fopts = match self.parse_bracket_options() {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  match self.expect_char(59) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fd = match build_field_descriptor(
    fname,
    fnum,
    label,
    parse_scalar_or_named_type(type_str),
    -1,
    fopts,
    seen_numbers,
    seen_names,
    seen_json_names,
    syntax,
    is_edition,
    false,
  ) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  fields.push(fd)
  Ok(())
}

///| Parse the body `{ ... }` of a message or proto2 group.
fn ProtoParser::parse_message_body(
  self : ProtoParser,
  name : String,
  full_name : String,
  depth : Int,
  syntax : Syntax,
  is_edition : Bool,
) -> Result[MessageDescriptor, ProtoError] {
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fields : Array[FieldDescriptor] = []
  let oneofs : Array[OneofDescriptor] = []
  let nested_messages : Array[MessageDescriptor] = []
  let nested_enums : Array[EnumDescriptor] = []
  let options : Array[ProtoOption] = []
  let reserved_ranges : Array[ReservedRange] = []
  let reserved_names : Array[String] = []
  let seen_numbers : Map[Int, Bool] = Map::new()
  let seen_names : Map[String, Bool] = Map::new()
  let seen_json_names : Map[String, Bool] = Map::new()

  while true {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated message " + name))
    }
    let c = self.peek_char()
    if c == 125 {
      self.pos = self.pos + 1
      break
    }
    if c == 59 {
      self.pos = self.pos + 1
      continue
    }
    let first = match self.read_qualified_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if first == "message" {
      let nested = match self.parse_message(full_name, depth + 1, syntax, is_edition) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
      nested_messages.push(nested)
    } else if first == "enum" {
      let ne = match self.parse_enum(full_name, syntax, is_edition) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      nested_enums.push(ne)
    } else if first == "extend" {
      match self.read_qualified_ident() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.skip_brace_block() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "option" {
      let opt_name = match self.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match self.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if first == "reserved" {
      match self.parse_reserved(reserved_ranges, reserved_names, false) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "extensions" {
      match self.skip_extensions_stmt() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "oneof" {
      match self.parse_oneof_block(oneofs, fields, seen_numbers, seen_names, seen_json_names, syntax, is_edition) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "map" {
      match self.parse_map_field(fields, seen_numbers, seen_names, seen_json_names, syntax, is_edition) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      match self.parse_regular_or_group_field(
        first,
        full_name,
        depth,
        fields,
        nested_messages,
        seen_numbers,
        seen_names,
        seen_json_names,
        syntax,
        is_edition,
      ) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }
  // Validate fields against reserved ranges and reserved names
  let fbm : Map[Int, Int] = Map::new()
  let mut has_req = false
  let mut fi = 0
  while fi < fields.length() {
    let fd = fields[fi]
    fbm.set(fd.number, fi)
    match fd.label {
      FieldLabel::Required => has_req = true
      _ => ()
    }
    let mut r = 0
    while r < reserved_ranges.length() {
      if fd.number >= reserved_ranges[r].start && fd.number <= reserved_ranges[r].end {
        return Err(ProtoError::SchemaError("field " + fd.name + " uses reserved number " + fd.number.to_string()))
      }
      r = r + 1
    }
    let mut rn = 0
    while rn < reserved_names.length() {
      if fd.name == reserved_names[rn] {
        return Err(ProtoError::SchemaError("field uses reserved name: " + fd.name))
      }
      rn = rn + 1
    }
    fi = fi + 1
  }
  Ok(MessageDescriptor::{
    name: name,
    full_name: full_name,
    fields: fields,
    oneofs: oneofs,
    nested_messages: nested_messages,
    nested_enums: nested_enums,
    options: options,
    reserved_ranges: reserved_ranges,
    reserved_names: reserved_names,
    field_by_num: fbm,
    has_required: has_req,
  })
}

///| Parse `message Name { ... }`.
fn ProtoParser::parse_message(
  self : ProtoParser,
  prefix : String,
  depth : Int,
  syntax : Syntax,
  is_edition : Bool,
) -> Result[MessageDescriptor, ProtoError] {
  if depth >= 31 {
    return Err(ProtoError::MaxDepthExceeded(32))
  }
  let name = match self.read_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let full_name = if prefix.length() == 0 { name } else { prefix + "." + name }
  self.parse_message_body(name, full_name, depth, syntax, is_edition)
}

///| Copy an Int array and append one index.
fn path_push(base : Array[Int], idx : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < base.length() {
    out.push(base[i])
    i = i + 1
  }
  out.push(idx)
  out
}

///| Index all messages and enums in a list into symbol tables for O(1) lexical linking.
fn index_messages_for_link(
  msgs : Array[MessageDescriptor],
  prefix_path : Array[Int],
  sym_kind : Map[String, Int],
  sym_path : Map[String, Array[Int]],
) -> Unit {
  let mut i = 0
  while i < msgs.length() {
    let m = msgs[i]
    let mpath = path_push(prefix_path, i)
    sym_kind.set(m.full_name, 1)
    sym_path.set(m.full_name, mpath)
    let mut e = 0
    while e < m.nested_enums.length() {
      let en = m.nested_enums[e]
      sym_kind.set(en.full_name, 3)
      sym_path.set(en.full_name, path_push(mpath, e))
      e = e + 1
    }
    index_messages_for_link(m.nested_messages, mpath, sym_kind, sym_path)
    i = i + 1
  }
}

///| Find the parent scope of a dot-separated scope name (e.g. `"a.b.C"` -> `"a.b"`, `"C"` -> `""`).
fn parent_scope(cur_scope : String) -> String {
  let mut i = cur_scope.length() - 1
  while i >= 0 {
    if cur_scope.code_unit_at(i) == 46 {
      return cur_scope.slice(0, i)
    }
    i = i - 1
  }
  ""
}

///| First component before '.' (or entire string if no '.').
fn first_component(name : String) -> String {
  let mut i = 0
  while i < name.length() {
    if name.code_unit_at(i) == 46 {
      return name.slice(0, i)
    }
    i = i + 1
  }
  name
}

///| Resolve a raw type name from `cur_scope` using protoc's C++-style lexical scoping rules.
///  Returns `(resolved_full_name, resolved_kind, resolved_path)`.
fn resolve_type_scoped(
  raw : String,
  cur_scope : String,
  imports : Array[String],
  sym_kind : Map[String, Int],
  sym_path : Map[String, Array[Int]],
) -> Result[(String, Int, Array[Int]), ProtoError] {
  if raw.length() > 0 && raw.code_unit_at(0) == 46 {
    // Fully-qualified `.pkg.Outer.Inner`
    let fq = raw.slice(1, raw.length())
    match sym_kind.get(fq) {
      Some(k) => {
        let p = match sym_path.get(fq) {
          Some(v) => v
          None => []
        }
        return Ok((fq, k, p))
      }
      None => ()
    }
    if wkt_import_provides(imports, fq) {
      match wkt_find_message(fq) {
        Some(_) => return Ok((fq, 4, []))
        None => ()
      }
      match wkt_find_enum(fq) {
        Some(_) => return Ok((fq, 5, []))
        None => ()
      }
    }
    return Err(ProtoError::SchemaError("unresolved type: " + raw))
  }
  // Relative name: walk from innermost scope outward to root ""
  let first = first_component(raw)
  let has_dot = first.length() < raw.length()
  let mut cur = cur_scope
  while true {
    let cand = if cur.length() == 0 { raw } else { cur + "." + raw }
    match sym_kind.get(cand) {
      Some(k) => {
        let p = match sym_path.get(cand) {
          Some(v) => v
          None => []
        }
        return Ok((cand, k, p))
      }
      None => ()
    }
    // C++/protoc shadowing rule: if `cur.first` is a type in this scope, do not continue outward
    if has_dot {
      let head = if cur.length() == 0 { first } else { cur + "." + first }
      match sym_kind.get(head) {
        Some(_) => return Err(ProtoError::SchemaError("unresolved type: " + raw))
        None => ()
      }
    }
    if cur.length() == 0 {
      break
    }
    cur = parent_scope(cur)
  }
  // Check imported Well-Known Types
  if wkt_import_provides(imports, raw) {
    match wkt_find_message(raw) {
      Some(_) => return Ok((raw, 4, []))
      None => ()
    }
    match wkt_find_enum(raw) {
      Some(_) => return Ok((raw, 5, []))
      None => ()
    }
  }
  Err(ProtoError::SchemaError("unresolved type: " + raw))
}

///| Link all field types in a list of messages in place.
fn link_messages(
  msgs : Array[MessageDescriptor],
  imports : Array[String],
  sym_kind : Map[String, Int],
  sym_path : Map[String, Array[Int]],
) -> Result[Unit, ProtoError] {
  let mut i = 0
  while i < msgs.length() {
    let m = msgs[i]
    let mut fi = 0
    while fi < m.fields.length() {
      let fd = m.fields[fi]
      match fd.field_type {
        FieldType::Named(raw) => {
          let (fq, rk, rp) = match resolve_type_scoped(raw, m.full_name, imports, sym_kind, sym_path) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          m.fields[fi] = FieldDescriptor::{
            name: fd.name,
            number: fd.number,
            label: fd.label,
            field_type: FieldType::Named(fq),
            oneof_index: fd.oneof_index,
            json_name: fd.json_name,
            packed: fd.packed,
            default_value: fd.default_value,
            options: fd.options,
            resolved_kind: rk,
            resolved_path: rp,
            is_group: fd.is_group,
          }
        }
        FieldType::Map(kt, FieldType::Named(raw)) => {
          let (fq, rk, rp) = match resolve_type_scoped(raw, m.full_name, imports, sym_kind, sym_path) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          m.fields[fi] = FieldDescriptor::{
            name: fd.name,
            number: fd.number,
            label: fd.label,
            field_type: FieldType::Map(kt, FieldType::Named(fq)),
            oneof_index: fd.oneof_index,
            json_name: fd.json_name,
            packed: fd.packed,
            default_value: fd.default_value,
            options: fd.options,
            resolved_kind: rk,
            resolved_path: rp,
            is_group: fd.is_group,
          }
        }
        _ => ()
      }
      fi = fi + 1
    }
    match link_messages(m.nested_messages, imports, sym_kind, sym_path) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(())
}

///| Run the lexical-scope link phase over a parsed `Schema`.
fn link_schema(schema : Schema) -> Result[Schema, ProtoError] {
  let sym_kind : Map[String, Int] = Map::new()
  let sym_path : Map[String, Array[Int]] = Map::new()
  let mut e = 0
  while e < schema.enums.length() {
    let en = schema.enums[e]
    sym_kind.set(en.full_name, 2)
    sym_path.set(en.full_name, [e])
    e = e + 1
  }
  index_messages_for_link(schema.messages, [], sym_kind, sym_path)
  match link_messages(schema.messages, schema.imports, sym_kind, sym_path) {
    Ok(_) => Ok(schema)
    Err(err) => Err(err)
  }
}

///| Parse a single `.proto` file without running the final cross-type link phase.
fn parse_schema_unlinked(source : String) -> Result[Schema, ProtoError] {
  let p = ProtoParser::{ src: source, len: source.length(), pos: 0 }
  let mut syntax = Syntax::Proto2
  let mut is_edition = false
  let mut seen_syntax_or_edition = false
  let mut seen_package = false
  let mut package_name = ""
  let imports : Array[String] = []
  let options : Array[ProtoOption] = []
  let messages : Array[MessageDescriptor] = []
  let enums : Array[EnumDescriptor] = []

  while true {
    match p.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    if p.peek_char() == 59 {
      p.pos = p.pos + 1
      continue
    }
    let kw = match p.read_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if kw == "syntax" {
      if seen_syntax_or_edition {
        return Err(ProtoError::SchemaError("duplicate syntax/edition declaration"))
      }
      seen_syntax_or_edition = true
      match p.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let syn = match p.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if syn == "proto3" {
        syntax = Syntax::Proto3
      } else if syn == "proto2" {
        syntax = Syntax::Proto2
      } else {
        return Err(ProtoError::SchemaError("unsupported syntax: " + syn))
      }
    } else if kw == "edition" {
      if seen_syntax_or_edition {
        return Err(ProtoError::SchemaError("duplicate syntax/edition declaration"))
      }
      seen_syntax_or_edition = true
      match p.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let ed = match p.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if ed == "2023" || ed == "2024" {
        syntax = Syntax::Proto3
        is_edition = true
      } else {
        return Err(ProtoError::SchemaError("unsupported edition: " + ed))
      }
    } else if kw == "package" {
      if seen_package {
        return Err(ProtoError::SchemaError("duplicate package declaration"))
      }
      seen_package = true
      package_name = match p.read_qualified_ident() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if kw == "import" {
      match p.skip_ws_and_comments() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let c = p.peek_char()
      if c != 34 && c != 39 {
        let mod_kw = match p.read_ident() {
          Ok(w) => w
          Err(e) => return Err(e)
        }
        if mod_kw != "public" && mod_kw != "weak" {
          return Err(ProtoError::SchemaError("unexpected import modifier: " + mod_kw))
        }
      }
      let path = match p.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      imports.push(path)
    } else if kw == "option" {
      let opt_name = match p.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match p.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match p.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if kw == "message" {
      let msg = match p.parse_message(package_name, 0, syntax, is_edition) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
      messages.push(msg)
    } else if kw == "enum" {
      let en = match p.parse_enum(package_name, syntax, is_edition) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      enums.push(en)
    } else if kw == "service" || kw == "extend" {
      match p.read_qualified_ident() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match p.skip_brace_block() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      return Err(ProtoError::SchemaError("unexpected top-level keyword: " + kw))
    }
  }
  Ok(Schema::{
    syntax: syntax,
    package_name: package_name,
    imports: imports,
    options: options,
    messages: messages,
    enums: enums,
  })
}

///| Parse and link a `.proto` schema string into a `Schema`.
pub fn parse_schema(source : String) -> Result[Schema, ProtoError] {
  let s = match parse_schema_unlinked(source) {
    Ok(sc) => sc
    Err(e) => return Err(e)
  }
  link_schema(s)
}

///| Parse and link multiple `.proto` schema sources together into one combined `Schema`.
pub fn parse_schemas(sources : Array[String]) -> Result[Schema, ProtoError] {
  if sources.length() == 0 {
    return Ok(Schema::{
      syntax: Syntax::Proto3,
      package_name: "",
      imports: [],
      options: [],
      messages: [],
      enums: [],
    })
  }
  let mut primary_syntax = Syntax::Proto3
  let mut primary_pkg = ""
  let all_imports : Array[String] = []
  let all_options : Array[ProtoOption] = []
  let all_messages : Array[MessageDescriptor] = []
  let all_enums : Array[EnumDescriptor] = []
  let mut i = 0
  while i < sources.length() {
    let sc = match parse_schema_unlinked(sources[i]) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if i == 0 {
      primary_syntax = sc.syntax
      primary_pkg = sc.package_name
    }
    let mut j = 0
    while j < sc.imports.length() {
      all_imports.push(sc.imports[j])
      j = j + 1
    }
    j = 0
    while j < sc.options.length() {
      all_options.push(sc.options[j])
      j = j + 1
    }
    j = 0
    while j < sc.messages.length() {
      all_messages.push(sc.messages[j])
      j = j + 1
    }
    j = 0
    while j < sc.enums.length() {
      all_enums.push(sc.enums[j])
      j = j + 1
    }
    i = i + 1
  }
  link_schema(Schema::{
    syntax: primary_syntax,
    package_name: primary_pkg,
    imports: all_imports,
    options: all_options,
    messages: all_messages,
    enums: all_enums,
  })
}

///| Strip optional leading '.' from a qualified name.
fn strip_leading_dot(name : String) -> String {
  if name.length() > 0 && name.code_unit_at(0) == 46 {
    name.slice(1, name.length())
  } else {
    name
  }
}

///| Exact full_name match first across top-level and nested messages.
fn find_message_exact(list : Array[MessageDescriptor], clean : String, fq : String) -> Option[MessageDescriptor] {
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    if m.full_name == clean || m.full_name == fq {
      return Option::Some(m)
    }
    match find_message_exact(m.nested_messages, clean, fq) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Fallback short-name match across top-level and nested messages.
fn find_message_short(list : Array[MessageDescriptor], clean : String) -> Option[MessageDescriptor] {
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    if m.name == clean {
      return Option::Some(m)
    }
    match find_message_short(m.nested_messages, clean) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Find a top-level or nested message descriptor by full_name, package-relative name, WKT name, or short name.
pub fn schema_find_message(schema : Schema, name : String) -> Option[MessageDescriptor] {
  let clean = strip_leading_dot(name)
  let fq = if schema.package_name.length() > 0 {
    schema.package_name + "." + clean
  } else {
    clean
  }
  match find_message_exact(schema.messages, clean, fq) {
    Some(m) => return Option::Some(m)
    None => ()
  }
  match wkt_find_message(clean) {
    Some(m) => return Option::Some(m)
    None => ()
  }
  find_message_short(schema.messages, clean)
}

///|
fn find_enum_in_messages_exact(list : Array[MessageDescriptor], clean : String, fq : String) -> Option[EnumDescriptor] {
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    let mut j = 0
    while j < m.nested_enums.length() {
      let e = m.nested_enums[j]
      if e.full_name == clean || e.full_name == fq {
        return Option::Some(e)
      }
      j = j + 1
    }
    match find_enum_in_messages_exact(m.nested_messages, clean, fq) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///|
fn find_enum_in_messages_short(list : Array[MessageDescriptor], clean : String) -> Option[EnumDescriptor] {
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    let mut j = 0
    while j < m.nested_enums.length() {
      let e = m.nested_enums[j]
      if e.name == clean {
        return Option::Some(e)
      }
      j = j + 1
    }
    match find_enum_in_messages_short(m.nested_messages, clean) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Find a top-level or nested enum descriptor by full_name, package-relative name, WKT name, or short name.
pub fn schema_find_enum(schema : Schema, name : String) -> Option[EnumDescriptor] {
  let clean = strip_leading_dot(name)
  let fq = if schema.package_name.length() > 0 {
    schema.package_name + "." + clean
  } else {
    clean
  }
  let mut i = 0
  while i < schema.enums.length() {
    let e = schema.enums[i]
    if e.full_name == clean || e.full_name == fq {
      return Option::Some(e)
    }
    i = i + 1
  }
  match find_enum_in_messages_exact(schema.messages, clean, fq) {
    Some(e) => return Option::Some(e)
    None => ()
  }
  match wkt_find_enum(clean) {
    Some(e) => return Option::Some(e)
    None => ()
  }
  i = 0
  while i < schema.enums.length() {
    let e = schema.enums[i]
    if e.name == clean {
      return Option::Some(e)
    }
    i = i + 1
  }
  find_enum_in_messages_short(schema.messages, clean)
}

///| O(1) descriptor lookup by linked `resolved_path` for a message field.
fn resolve_field_message(schema : Schema, fd : FieldDescriptor) -> Option[MessageDescriptor] {
  if fd.resolved_kind == 1 {
    let p = fd.resolved_path
    if p.length() == 0 {
      return Option::None
    }
    let mut cur = schema.messages[p[0]]
    let mut i = 1
    while i < p.length() {
      cur = cur.nested_messages[p[i]]
      i = i + 1
    }
    return Option::Some(cur)
  }
  if fd.resolved_kind == 4 {
    match fd.field_type {
      FieldType::Named(tname) => return wkt_find_message(tname)
      FieldType::Map(_, FieldType::Named(tname)) => return wkt_find_message(tname)
      _ => return Option::None
    }
  }
  Option::None
}

///| O(1) descriptor lookup by linked `resolved_path` for an enum field.
fn resolve_field_enum(schema : Schema, fd : FieldDescriptor) -> Option[EnumDescriptor] {
  if fd.resolved_kind == 2 {
    let p = fd.resolved_path
    if p.length() == 1 {
      return Option::Some(schema.enums[p[0]])
    }
    return Option::None
  }
  if fd.resolved_kind == 3 {
    let p = fd.resolved_path
    if p.length() < 2 {
      return Option::None
    }
    let mut cur = schema.messages[p[0]]
    let mut i = 1
    while i < p.length() - 1 {
      cur = cur.nested_messages[p[i]]
      i = i + 1
    }
    return Option::Some(cur.nested_enums[p[p.length() - 1]])
  }
  if fd.resolved_kind == 5 {
    match fd.field_type {
      FieldType::Named(tname) => return wkt_find_enum(tname)
      FieldType::Map(_, FieldType::Named(tname)) => return wkt_find_enum(tname)
      _ => return Option::None
    }
  }
  Option::None
}
