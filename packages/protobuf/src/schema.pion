///| `.proto` v2/v3 lexer and AST parser.

///|
struct ProtoParser {
  src : String
  len : Int
  mut pos : Int
}

///|
fn is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

///|
fn is_ident_start(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

///|
fn is_ident_char(c : Int) -> Bool {
  is_ident_start(c) || (c >= 48 && c <= 57)
}

///|
fn is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///|
fn ProtoParser::skip_ws_and_comments(self : ProtoParser) -> Result[Unit, ProtoError] {
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_space(c) {
      self.pos = self.pos + 1
    } else if c == 47 && self.pos + 1 < self.len {
      let c2 = self.src.code_unit_at(self.pos + 1)
      if c2 == 47 {
        // Line comment //
        self.pos = self.pos + 2
        while self.pos < self.len && self.src.code_unit_at(self.pos) != 10 {
          self.pos = self.pos + 1
        }
      } else if c2 == 42 {
        // Block comment /* ... */
        self.pos = self.pos + 2
        let mut closed = false
        while self.pos + 1 < self.len {
          if self.src.code_unit_at(self.pos) == 42 && self.src.code_unit_at(self.pos + 1) == 47 {
            self.pos = self.pos + 2
            closed = true
            break
          }
          self.pos = self.pos + 1
        }
        if !closed {
          return Err(ProtoError::SchemaError("unterminated block comment"))
        }
      } else {
        break
      }
    } else {
      break
    }
  }
  Ok(())
}

///|
fn ProtoParser::peek_char(self : ProtoParser) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

///|
fn ProtoParser::expect_char(self : ProtoParser, ch : Int) -> Result[Unit, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != ch {
    return Err(ProtoError::SchemaError("expected character at offset " + self.pos.to_string()))
  }
  self.pos = self.pos + 1
  Ok(())
}

///|
fn ProtoParser::try_char(self : ProtoParser, ch : Int) -> Result[Bool, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos < self.len && self.src.code_unit_at(self.pos) == ch {
    self.pos = self.pos + 1
    Ok(true)
  } else {
    Ok(false)
  }
}

///|
fn ProtoParser::read_ident(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  if start >= self.len || !is_ident_start(self.src.code_unit_at(start)) {
    return Err(ProtoError::SchemaError("expected identifier at offset " + start.to_string()))
  }
  self.pos = self.pos + 1
  while self.pos < self.len && is_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  Ok(self.src.slice(start, self.pos))
}

///| Read a possibly dot-qualified type/package name (e.g. `.google.protobuf.Timestamp` or `Span.Status`).
fn ProtoParser::read_qualified_ident(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 46 {
    self.pos = self.pos + 1
  }
  if self.pos >= self.len || !is_ident_start(self.src.code_unit_at(self.pos)) {
    return Err(ProtoError::SchemaError("expected qualified identifier at offset " + start.to_string()))
  }
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) || c == 46 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  Ok(self.src.slice(start, self.pos))
}

///| Read a single or double quoted string literal (supporting adjacent string concatenation).
fn ProtoParser::read_string_lit(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  let mut count = 0
  while self.pos < self.len {
    let q = self.src.code_unit_at(self.pos)
    if q != 34 && q != 39 {
      break
    }
    count = count + 1
    self.pos = self.pos + 1
    let mut closed = false
    while self.pos < self.len {
      let c = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if c == q {
        closed = true
        break
      }
      if c == 92 {
        // '\\'
        if self.pos >= self.len {
          return Err(ProtoError::SchemaError("unterminated string escape"))
        }
        let esc = self.src.code_unit_at(self.pos)
        self.pos = self.pos + 1
        match esc {
          110 => sb.write_byte((10).to_byte()) // \n
          114 => sb.write_byte((13).to_byte()) // \r
          116 => sb.write_byte((9).to_byte()) // \t
          92 => sb.write_byte((92).to_byte()) // \\
          34 => sb.write_byte((34).to_byte()) // \"
          39 => sb.write_byte((39).to_byte()) // \'
          _ => sb.write_byte(esc.to_byte())
        }
      } else {
        sb.write_byte(c.to_byte())
      }
    }
    if !closed {
      return Err(ProtoError::SchemaError("unterminated string literal"))
    }
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  if count == 0 {
    return Err(ProtoError::SchemaError("expected string literal at offset " + self.pos.to_string()))
  }
  Ok(sb.to_string())
}

///| Read a signed decimal or hex integer.
fn ProtoParser::read_int(self : ProtoParser) -> Result[Int, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  let mut neg = false
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 45 {
    neg = true
    self.pos = self.pos + 1
  }
  if self.pos >= self.len || !is_digit(self.src.code_unit_at(self.pos)) {
    return Err(ProtoError::SchemaError("expected integer at offset " + start.to_string()))
  }
  let mut acc : Int64 = 0L
  if self.src.code_unit_at(self.pos) == 48 && self.pos + 1 < self.len && (self.src.code_unit_at(self.pos + 1) == 120 || self.src.code_unit_at(self.pos + 1) == 88) {
    // Hex 0x...
    self.pos = self.pos + 2
    while self.pos < self.len {
      let c = self.src.code_unit_at(self.pos)
      if c >= 48 && c <= 57 {
        acc = acc * 16L + (c - 48).to_int64()
        self.pos = self.pos + 1
      } else if c >= 97 && c <= 102 {
        acc = acc * 16L + (c - 97 + 10).to_int64()
        self.pos = self.pos + 1
      } else if c >= 65 && c <= 70 {
        acc = acc * 16L + (c - 65 + 10).to_int64()
        self.pos = self.pos + 1
      } else {
        break
      }
    }
  } else {
    while self.pos < self.len && is_digit(self.src.code_unit_at(self.pos)) {
      let d = self.src.code_unit_at(self.pos) - 48
      acc = acc * 10L + d.to_int64()
      self.pos = self.pos + 1
    }
  }
  if neg {
    Ok((-acc).to_int())
  } else {
    Ok(acc.to_int())
  }
}

///| Read an option value (string, bool, number, identifier, or `{ ... }` aggregate).
fn ProtoParser::read_option_value(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c = self.peek_char()
  if c == 34 || c == 39 {
    return self.read_string_lit()
  }
  if c == 123 {
    // Aggregate option `{ ... }`
    let start = self.pos
    let mut depth = 0
    while self.pos < self.len {
      let ch = self.src.code_unit_at(self.pos)
      if ch == 123 {
        depth = depth + 1
      } else if ch == 125 {
        depth = depth - 1
        if depth == 0 {
          self.pos = self.pos + 1
          return Ok(self.src.slice(start, self.pos))
        }
      }
      self.pos = self.pos + 1
    }
    return Err(ProtoError::SchemaError("unterminated aggregate option"))
  }
  let start = self.pos
  while self.pos < self.len {
    let ch = self.src.code_unit_at(self.pos)
    if ch == 59 || ch == 44 || ch == 93 || is_space(ch) {
      break
    }
    self.pos = self.pos + 1
  }
  if self.pos == start {
    return Err(ProtoError::SchemaError("expected option value at offset " + start.to_string()))
  }
  Ok(self.src.slice(start, self.pos))
}

///| Read an option name (supports `(custom.opt).sub`).
fn ProtoParser::read_option_name(self : ProtoParser) -> Result[String, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let start = self.pos
  while self.pos < self.len {
    let c = self.src.code_unit_at(self.pos)
    if is_ident_char(c) || c == 46 || c == 40 || c == 41 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  if self.pos == start {
    return Err(ProtoError::SchemaError("expected option name at offset " + start.to_string()))
  }
  Ok(self.src.slice(start, self.pos))
}

///| Parse `[k = v, k2 = v2]` field/enum-value options.
fn ProtoParser::parse_bracket_options(self : ProtoParser) -> Result[Array[ProtoOption], ProtoError] {
  let opts : Array[ProtoOption] = []
  match self.try_char(91) {
    Ok(true) => ()
    Ok(false) => return Ok(opts)
    Err(e) => return Err(e)
  }
  while true {
    let name = match self.read_option_name() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_char(61) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let opt_v = match self.read_option_value() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    opts.push(ProtoOption::{ name: name, value: opt_v })
    match self.try_char(44) {
      Ok(true) => continue
      Ok(false) => break
      Err(e) => return Err(e)
    }
  }
  match self.expect_char(93) {
    Ok(_) => Ok(opts)
    Err(e) => Err(e)
  }
}

///| Parse `reserved ...;` into ranges or names.
fn ProtoParser::parse_reserved(
  self : ProtoParser,
  ranges : Array[ReservedRange],
  names : Array[String],
) -> Result[Unit, ProtoError] {
  match self.skip_ws_and_comments() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let c = self.peek_char()
  if c == 34 || c == 39 {
    while true {
      let name = match self.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      names.push(name)
      match self.try_char(44) {
        Ok(true) => continue
        Ok(false) => break
        Err(e) => return Err(e)
      }
    }
  } else {
    while true {
      let start_num = match self.read_int() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.skip_ws_and_comments() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let mut end_num = start_num
      if self.pos + 2 <= self.len && self.src.slice(self.pos, self.pos + 2) == "to" && (self.pos + 2 == self.len || !is_ident_char(self.src.code_unit_at(self.pos + 2))) {
        self.pos = self.pos + 2
        match self.skip_ws_and_comments() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if self.pos + 3 <= self.len && self.src.slice(self.pos, self.pos + 3) == "max" && (self.pos + 3 == self.len || !is_ident_char(self.src.code_unit_at(self.pos + 3))) {
          self.pos = self.pos + 3
          end_num = max_field_number
        } else {
          end_num = match self.read_int() {
            Ok(n) => n
            Err(e) => return Err(e)
          }
        }
      }
      ranges.push(ReservedRange::{ start: start_num, end: end_num })
      match self.try_char(44) {
        Ok(true) => continue
        Ok(false) => break
        Err(e) => return Err(e)
      }
    }
  }
  self.expect_char(59)
}

///| Map a `.proto` type name string to `FieldType`.
fn parse_scalar_or_named_type(name : String) -> FieldType {
  match name {
    "double" => FieldType::Double
    "float" => FieldType::Float
    "int32" => FieldType::Int32
    "int64" => FieldType::Int64
    "uint32" => FieldType::UInt32
    "uint64" => FieldType::UInt64
    "sint32" => FieldType::SInt32
    "sint64" => FieldType::SInt64
    "fixed32" => FieldType::Fixed32
    "fixed64" => FieldType::Fixed64
    "sfixed32" => FieldType::SFixed32
    "sfixed64" => FieldType::SFixed64
    "bool" => FieldType::Bool
    "string" => FieldType::String
    "bytes" => FieldType::Bytes
    _ => FieldType::Named(name)
  }
}

///| Check whether a FieldType is a legal Protobuf map key type.
fn is_valid_map_key_type(ft : FieldType) -> Bool {
  match ft {
    Int32 | Int64 | UInt32 | UInt64 | SInt32 | SInt64 | Fixed32 | Fixed64 | SFixed32 | SFixed64 | Bool | String =>
    true
    _ => false
  }
}

///| Parse `enum Name { ... }`.
fn ProtoParser::parse_enum(self : ProtoParser, prefix : String) -> Result[EnumDescriptor, ProtoError] {
  let name = match self.read_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let full_name = if prefix.length() == 0 { name } else { prefix + "." + name }
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let values : Array[EnumValueDescriptor] = []
  let options : Array[ProtoOption] = []
  let reserved_ranges : Array[ReservedRange] = []
  let reserved_names : Array[String] = []
  while true {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated enum " + name))
    }
    let c = self.peek_char()
    if c == 125 {
      self.pos = self.pos + 1
      break
    }
    if c == 59 {
      self.pos = self.pos + 1
      continue
    }
    let word = match self.read_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if word == "option" {
      let opt_name = match self.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match self.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if word == "reserved" {
      match self.parse_reserved(reserved_ranges, reserved_names) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let num = match self.read_int() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.parse_bracket_options() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      values.push(EnumValueDescriptor::{ name: word, number: num })
    }
  }
  Ok(EnumDescriptor::{
    name: name,
    full_name: full_name,
    values: values,
    options: options,
    reserved_ranges: reserved_ranges,
    reserved_names: reserved_names,
  })
}

///| Build a FieldDescriptor from parsed field components and validate tag number.
fn build_field_descriptor(
  name : String,
  number : Int,
  label : FieldLabel,
  field_type : FieldType,
  oneof_index : Int,
  opts : Array[ProtoOption],
  seen_numbers : Array[Int],
) -> Result[FieldDescriptor, ProtoError] {
  match validate_field_number(number, true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut i = 0
  while i < seen_numbers.length() {
    if seen_numbers[i] == number {
      return Err(ProtoError::SchemaError("duplicate field number " + number.to_string()))
    }
    i = i + 1
  }
  seen_numbers.push(number)
  let mut json_name = to_lower_camel_case(name)
  let mut packed : Option[Bool] = Option::None
  let mut default_value : Option[String] = Option::None
  let mut j = 0
  while j < opts.length() {
    let o = opts[j]
    if o.name == "json_name" {
      json_name = o.value
    } else if o.name == "packed" {
      if o.value == "true" {
        packed = Option::Some(true)
      } else if o.value == "false" {
        packed = Option::Some(false)
      }
    } else if o.name == "default" {
      default_value = Option::Some(o.value)
    }
    j = j + 1
  }
  Ok(FieldDescriptor::{
    name: name,
    number: number,
    label: label,
    field_type: field_type,
    oneof_index: oneof_index,
    json_name: json_name,
    packed: packed,
    default_value: default_value,
    options: opts,
  })
}

///| Skip a `{ ... }` block (for `service`, `extend`, etc.).
fn ProtoParser::skip_brace_block(self : ProtoParser) -> Result[Unit, ProtoError] {
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut depth = 1
  while depth > 0 {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated block"))
    }
    let c = self.src.code_unit_at(self.pos)
    if c == 34 || c == 39 {
      match self.read_string_lit() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if c == 123 {
      depth = depth + 1
      self.pos = self.pos + 1
    } else if c == 125 {
      depth = depth - 1
      self.pos = self.pos + 1
    } else {
      self.pos = self.pos + 1
    }
  }
  Ok(())
}

///| Parse `message Name { ... }`.
fn ProtoParser::parse_message(
  self : ProtoParser,
  prefix : String,
  depth : Int,
) -> Result[MessageDescriptor, ProtoError] {
  if depth > 64 {
    return Err(ProtoError::MaxDepthExceeded(64))
  }
  let name = match self.read_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let full_name = if prefix.length() == 0 { name } else { prefix + "." + name }
  match self.expect_char(123) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fields : Array[FieldDescriptor] = []
  let oneofs : Array[OneofDescriptor] = []
  let nested_messages : Array[MessageDescriptor] = []
  let nested_enums : Array[EnumDescriptor] = []
  let options : Array[ProtoOption] = []
  let reserved_ranges : Array[ReservedRange] = []
  let reserved_names : Array[String] = []
  let seen_numbers : Array[Int] = []

  while true {
    match self.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      return Err(ProtoError::SchemaError("unterminated message " + name))
    }
    let c = self.peek_char()
    if c == 125 {
      self.pos = self.pos + 1
      break
    }
    if c == 59 {
      self.pos = self.pos + 1
      continue
    }
    let first = match self.read_qualified_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if first == "message" {
      let nested = match self.parse_message(full_name, depth + 1) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
      nested_messages.push(nested)
    } else if first == "enum" {
      let ne = match self.parse_enum(full_name) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      nested_enums.push(ne)
    } else if first == "option" {
      let opt_name = match self.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match self.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if first == "reserved" {
      match self.parse_reserved(reserved_ranges, reserved_names) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "extensions" {
      // Skip until ';'
      while self.pos < self.len && self.src.code_unit_at(self.pos) != 59 {
        self.pos = self.pos + 1
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if first == "oneof" {
      let oneof_name = match self.read_ident() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match self.expect_char(123) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let oneof_idx = oneofs.length()
      let oneof_nums : Array[Int] = []
      while true {
        match self.skip_ws_and_comments() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if self.pos >= self.len {
          return Err(ProtoError::SchemaError("unterminated oneof " + oneof_name))
        }
        if self.peek_char() == 125 {
          self.pos = self.pos + 1
          break
        }
        if self.peek_char() == 59 {
          self.pos = self.pos + 1
          continue
        }
        let ftype_str = match self.read_qualified_ident() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        if ftype_str == "option" {
          let _ = self.read_option_name()
          let _ = self.expect_char(61)
          let _ = self.read_option_value()
          match self.expect_char(59) {
            Ok(_) => continue
            Err(e) => return Err(e)
          }
        }
        let fname = match self.read_ident() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        match self.expect_char(61) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let fnum = match self.read_int() {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        let fopts = match self.parse_bracket_options() {
          Ok(o) => o
          Err(e) => return Err(e)
        }
        match self.expect_char(59) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let fd = match build_field_descriptor(
          fname,
          fnum,
          FieldLabel::Optional,
          parse_scalar_or_named_type(ftype_str),
          oneof_idx,
          fopts,
          seen_numbers,
        ) {
          Ok(d) => d
          Err(e) => return Err(e)
        }
        oneof_nums.push(fnum)
        fields.push(fd)
      }
      oneofs.push(OneofDescriptor::{ name: oneof_name, field_numbers: oneof_nums })
    } else if first == "map" {
      match self.expect_char(60) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let kt_str = match self.read_qualified_ident() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let kt = parse_scalar_or_named_type(kt_str)
      if !is_valid_map_key_type(kt) {
        return Err(ProtoError::SchemaError("invalid map key type: " + kt_str))
      }
      match self.expect_char(44) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let vt_str = match self.read_qualified_ident() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let vt = parse_scalar_or_named_type(vt_str)
      match self.expect_char(62) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let fname = match self.read_ident() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let fnum = match self.read_int() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      let fopts = match self.parse_bracket_options() {
        Ok(o) => o
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let fd = match build_field_descriptor(
        fname,
        fnum,
        FieldLabel::Repeated,
        FieldType::Map(kt, vt),
        -1,
        fopts,
        seen_numbers,
      ) {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      fields.push(fd)
    } else {
      // Field: [optional|required|repeated] Type name = number [options];
      let mut label = FieldLabel::Implicit
      let mut type_str = first
      if first == "optional" {
        label = FieldLabel::Optional
        type_str = match self.read_qualified_ident() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      } else if first == "required" {
        label = FieldLabel::Required
        type_str = match self.read_qualified_ident() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      } else if first == "repeated" {
        label = FieldLabel::Repeated
        type_str = match self.read_qualified_ident() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      }
      let fname = match self.read_ident() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match self.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let fnum = match self.read_int() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      let fopts = match self.parse_bracket_options() {
        Ok(o) => o
        Err(e) => return Err(e)
      }
      match self.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let fd = match build_field_descriptor(
        fname,
        fnum,
        label,
        parse_scalar_or_named_type(type_str),
        -1,
        fopts,
        seen_numbers,
      ) {
        Ok(d) => d
        Err(e) => return Err(e)
      }
      fields.push(fd)
    }
  }
  Ok(MessageDescriptor::{
    name: name,
    full_name: full_name,
    fields: fields,
    oneofs: oneofs,
    nested_messages: nested_messages,
    nested_enums: nested_enums,
    options: options,
    reserved_ranges: reserved_ranges,
    reserved_names: reserved_names,
  })
}

///| Parse a `.proto` schema string into a `Schema`.
pub fn parse_schema(source : String) -> Result[Schema, ProtoError] {
  let p = ProtoParser::{ src: source, len: source.length(), pos: 0 }
  let mut syntax = Syntax::Proto2
  let mut package_name = ""
  let imports : Array[String] = []
  let options : Array[ProtoOption] = []
  let messages : Array[MessageDescriptor] = []
  let enums : Array[EnumDescriptor] = []

  while true {
    match p.skip_ws_and_comments() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    if p.peek_char() == 59 {
      p.pos = p.pos + 1
      continue
    }
    let kw = match p.read_ident() {
      Ok(w) => w
      Err(e) => return Err(e)
    }
    if kw == "syntax" {
      match p.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let syn = match p.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if syn == "proto3" {
        syntax = Syntax::Proto3
      } else if syn == "proto2" {
        syntax = Syntax::Proto2
      } else {
        return Err(ProtoError::SchemaError("unsupported syntax: " + syn))
      }
    } else if kw == "package" {
      package_name = match p.read_qualified_ident() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if kw == "import" {
      match p.skip_ws_and_comments() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let c = p.peek_char()
      if c != 34 && c != 39 {
        // Optional `public` or `weak`
        let mod_kw = match p.read_ident() {
          Ok(w) => w
          Err(e) => return Err(e)
        }
        if mod_kw != "public" && mod_kw != "weak" {
          return Err(ProtoError::SchemaError("unexpected import modifier: " + mod_kw))
        }
      }
      let path = match p.read_string_lit() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      imports.push(path)
    } else if kw == "option" {
      let opt_name = match p.read_option_name() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      match p.expect_char(61) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let opt_val = match p.read_option_value() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match p.expect_char(59) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      options.push(ProtoOption::{ name: opt_name, value: opt_val })
    } else if kw == "message" {
      let msg = match p.parse_message(package_name, 0) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
      messages.push(msg)
    } else if kw == "enum" {
      let en = match p.parse_enum(package_name) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      enums.push(en)
    } else if kw == "service" || kw == "extend" {
      let _ = p.read_qualified_ident()
      match p.skip_brace_block() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      return Err(ProtoError::SchemaError("unexpected top-level keyword: " + kw))
    }
  }
  Ok(Schema::{
    syntax: syntax,
    package_name: package_name,
    imports: imports,
    options: options,
    messages: messages,
    enums: enums,
  })
}

///| Strip optional leading '.' from a qualified name.
fn strip_leading_dot(name : String) -> String {
  if name.length() > 0 && name.code_unit_at(0) == 46 {
    name.slice(1, name.length())
  } else {
    name
  }
}

///|
fn find_message_in_list(list : Array[MessageDescriptor], target : String, pkg : String) -> Option[MessageDescriptor] {
  let clean = strip_leading_dot(target)
  let fq = if pkg.length() > 0 { pkg + "." + clean } else { clean }
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    if m.name == clean || m.full_name == clean || m.full_name == fq {
      return Option::Some(m)
    }
    match find_message_in_list(m.nested_messages, clean, pkg) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Find a top-level or nested message descriptor by name, relative nested name, or full_name.
pub fn schema_find_message(schema : Schema, name : String) -> Option[MessageDescriptor] {
  find_message_in_list(schema.messages, name, schema.package_name)
}

///|
fn find_enum_in_messages(list : Array[MessageDescriptor], clean : String, fq : String) -> Option[EnumDescriptor] {
  let mut i = 0
  while i < list.length() {
    let m = list[i]
    let mut j = 0
    while j < m.nested_enums.length() {
      let e = m.nested_enums[j]
      if e.name == clean || e.full_name == clean || e.full_name == fq {
        return Option::Some(e)
      }
      j = j + 1
    }
    match find_enum_in_messages(m.nested_messages, clean, fq) {
      Some(found) => return Option::Some(found)
      None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Find a top-level or nested enum descriptor by name or full_name.
pub fn schema_find_enum(schema : Schema, name : String) -> Option[EnumDescriptor] {
  let clean = strip_leading_dot(name)
  let fq = if schema.package_name.length() > 0 {
    schema.package_name + "." + clean
  } else {
    clean
  }
  let mut i = 0
  while i < schema.enums.length() {
    let e = schema.enums[i]
    if e.name == clean || e.full_name == clean || e.full_name == fq {
      return Option::Some(e)
    }
    i = i + 1
  }
  find_enum_in_messages(schema.messages, clean, fq)
}
