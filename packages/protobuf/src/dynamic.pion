///| Dynamic reflection message decode/encode and accessors.

///|
fn find_field_desc_by_num(desc : MessageDescriptor, field_number : Int) -> Option[FieldDescriptor] {
  let mut i = 0
  while i < desc.fields.length() {
    if desc.fields[i].number == field_number {
      return Option::Some(desc.fields[i])
    }
    i = i + 1
  }
  Option::None
}

///|
fn find_field_desc_by_name(desc : MessageDescriptor, name : String) -> Option[FieldDescriptor] {
  let mut i = 0
  while i < desc.fields.length() {
    if desc.fields[i].name == name {
      return Option::Some(desc.fields[i])
    }
    i = i + 1
  }
  Option::None
}

///| Resolve a named type inside a message scope (nested first, then schema-wide).
fn resolve_nested_message(schema : Schema, parent : MessageDescriptor, type_name : String) -> Option[MessageDescriptor] {
  let mut i = 0
  while i < parent.nested_messages.length() {
    let nm = parent.nested_messages[i]
    if nm.name == type_name || nm.full_name == type_name {
      return Option::Some(nm)
    }
    i = i + 1
  }
  schema_find_message(schema, type_name)
}

///|
fn resolve_nested_enum(schema : Schema, parent : MessageDescriptor, type_name : String) -> Option[EnumDescriptor] {
  let mut i = 0
  while i < parent.nested_enums.length() {
    let ne = parent.nested_enums[i]
    if ne.name == type_name || ne.full_name == type_name {
      return Option::Some(ne)
    }
    i = i + 1
  }
  schema_find_enum(schema, type_name)
}

///|
fn is_packable_scalar(schema : Schema, parent : MessageDescriptor, ft : FieldType) -> Bool {
  match ft {
    Double | Float | Int32 | Int64 | UInt32 | UInt64 | SInt32 | SInt64 | Fixed32 | Fixed64 | SFixed32 | SFixed64 | Bool =>
    true
    Named(name) =>
    match resolve_nested_enum(schema, parent, name) {
      Some(_) => true
      None => false
    }
    _ => false
  }
}

///|
fn default_value_for_type(schema : Schema, parent : MessageDescriptor, ft : FieldType) -> ProtoValue {
  match ft {
    Double => ProtoValue::Double(0.0)
    Float => ProtoValue::Float(0.0)
    Int32 | SInt32 | SFixed32 => ProtoValue::Int32(0)
    Int64 | SInt64 | SFixed64 => ProtoValue::Int64(0L)
    UInt32 | Fixed32 => ProtoValue::UInt32(0L)
    UInt64 | Fixed64 => ProtoValue::UInt64(0UL)
    Bool => ProtoValue::Bool(false)
    String => ProtoValue::String("")
    Bytes => ProtoValue::Bytes(Bytes::new(0))
    Named(name) =>
    match resolve_nested_enum(schema, parent, name) {
      Some(_) => ProtoValue::Enum(0)
      None => ProtoValue::Message(DynamicMessage::new(name))
    }
    Map(_, _) => ProtoValue::Map([])
  }
}

///|
fn is_default_proto3_value(v : ProtoValue) -> Bool {
  match v {
    Bool(b) => !b
    Int32(n) => n == 0
    Int64(n) => n == 0L
    UInt32(n) => n == 0L
    UInt64(n) => n == 0UL
    Float(d) => d.to_bits() == 0L
    Double(d) => d.to_bits() == 0L
    String(s) => s.length() == 0
    Bytes(b) => b.length() == 0
    Enum(n) => n == 0
    Message(_) => false
    List(xs) => xs.length() == 0
    Map(pairs) => pairs.length() == 0
  }
}

///| Mutable field-count state shared across a dynamic decode invocation.
struct DecodeState {
  opts : DecodeOptions
  mut field_count : Int
}

///| Read a single unknown field (including nested groups up to `max_depth`).
fn read_unknown_field(
  r : WireReader,
  tag : Tag,
  depth : Int,
  state : DecodeState,
) -> Result[UnknownField, ProtoError] {
  match tag.wire_type {
    Varint =>
    match r.read_varint64() {
      Ok(v) => Ok(UnknownField::{ field_number: tag.field_number, wire_type: WireType::Varint, value: UnknownValue::Varint(v) })
      Err(e) => Err(e)
    }
    Fixed32 =>
    match r.read_fixed32() {
      Ok(v) => Ok(UnknownField::{ field_number: tag.field_number, wire_type: WireType::Fixed32, value: UnknownValue::Fixed32(v) })
      Err(e) => Err(e)
    }
    Fixed64 =>
    match r.read_fixed64() {
      Ok(v) => Ok(UnknownField::{ field_number: tag.field_number, wire_type: WireType::Fixed64, value: UnknownValue::Fixed64(v) })
      Err(e) => Err(e)
    }
    LengthDelimited =>
    match r.read_bytes() {
      Ok(b) => Ok(UnknownField::{ field_number: tag.field_number, wire_type: WireType::LengthDelimited, value: UnknownValue::LengthDelimited(b) })
      Err(e) => Err(e)
    }
    EndGroup => Err(ProtoError::UnmatchedGroup(tag.field_number, r.pos()))
    StartGroup => {
      if depth >= state.opts.max_depth {
        return Err(ProtoError::MaxDepthExceeded(state.opts.max_depth))
      }
      // Iterative group reader using explicit stacks to guarantee zero native stack overflow.
      let num_stack : Array[Int] = [tag.field_number]
      let fields_stack : Array[Array[UnknownField]] = [[]]
      while num_stack.length() > 0 {
        if r.is_eof() {
          return Err(ProtoError::UnexpectedEof(r.pos()))
        }
        let tpos = r.pos()
        let inner = match r.read_tag() {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        state.field_count = state.field_count + 1
        if state.field_count > state.opts.max_fields {
          return Err(ProtoError::MaxFieldsExceeded(state.opts.max_fields))
        }
        match inner.wire_type {
          StartGroup => {
            if depth + num_stack.length() >= state.opts.max_depth {
              return Err(ProtoError::MaxDepthExceeded(state.opts.max_depth))
            }
            num_stack.push(inner.field_number)
            fields_stack.push([])
          }
          EndGroup => {
            let expected_num = match num_stack.pop() {
              Some(n) => n
              None => return Err(ProtoError::UnmatchedGroup(inner.field_number, tpos))
            }
            if expected_num != inner.field_number {
              return Err(ProtoError::UnmatchedGroup(inner.field_number, tpos))
            }
            let finished = match fields_stack.pop() {
              Some(fs) => fs
              None => []
            }
            let uf = UnknownField::{
              field_number: expected_num,
              wire_type: WireType::StartGroup,
              value: UnknownValue::Group(finished),
            }
            if fields_stack.length() == 0 {
              return Ok(uf)
            }
            fields_stack[fields_stack.length() - 1].push(uf)
          }
          Varint =>
          match r.read_varint64() {
            Ok(v) =>
            fields_stack[fields_stack.length() - 1].push(UnknownField::{
              field_number: inner.field_number,
              wire_type: WireType::Varint,
              value: UnknownValue::Varint(v),
            })
            Err(e) => return Err(e)
          }
          Fixed32 =>
          match r.read_fixed32() {
            Ok(v) =>
            fields_stack[fields_stack.length() - 1].push(UnknownField::{
              field_number: inner.field_number,
              wire_type: WireType::Fixed32,
              value: UnknownValue::Fixed32(v),
            })
            Err(e) => return Err(e)
          }
          Fixed64 =>
          match r.read_fixed64() {
            Ok(v) =>
            fields_stack[fields_stack.length() - 1].push(UnknownField::{
              field_number: inner.field_number,
              wire_type: WireType::Fixed64,
              value: UnknownValue::Fixed64(v),
            })
            Err(e) => return Err(e)
          }
          LengthDelimited =>
          match r.read_bytes() {
            Ok(b) =>
            fields_stack[fields_stack.length() - 1].push(UnknownField::{
              field_number: inner.field_number,
              wire_type: WireType::LengthDelimited,
              value: UnknownValue::LengthDelimited(b),
            })
            Err(e) => return Err(e)
          }
        }
      }
      Err(ProtoError::UnexpectedEof(r.pos()))
    }
  }
}

///| Read a single scalar value according to `ft` and wire type.
fn read_scalar_value(
  r : WireReader,
  schema : Schema,
  parent : MessageDescriptor,
  field_num : Int,
  ft : FieldType,
  wt : WireType,
) -> Result[ProtoValue, ProtoError] {
  match ft {
    Double => {
      if !wire_type_eq(wt, WireType::Fixed64) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_double() {
        Ok(v) => Ok(ProtoValue::Double(v))
        Err(e) => Err(e)
      }
    }
    Float => {
      if !wire_type_eq(wt, WireType::Fixed32) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_float() {
        Ok(v) => Ok(ProtoValue::Float(v))
        Err(e) => Err(e)
      }
    }
    Int32 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_int32() {
        Ok(v) => Ok(ProtoValue::Int32(v))
        Err(e) => Err(e)
      }
    }
    Int64 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_int64() {
        Ok(v) => Ok(ProtoValue::Int64(v))
        Err(e) => Err(e)
      }
    }
    UInt32 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_uint32() {
        Ok(v) => Ok(ProtoValue::UInt32(v))
        Err(e) => Err(e)
      }
    }
    UInt64 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_uint64() {
        Ok(v) => Ok(ProtoValue::UInt64(v))
        Err(e) => Err(e)
      }
    }
    SInt32 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_sint32() {
        Ok(v) => Ok(ProtoValue::Int32(v))
        Err(e) => Err(e)
      }
    }
    SInt64 => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_sint64() {
        Ok(v) => Ok(ProtoValue::Int64(v))
        Err(e) => Err(e)
      }
    }
    Fixed32 => {
      if !wire_type_eq(wt, WireType::Fixed32) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_fixed32() {
        Ok(v) => Ok(ProtoValue::UInt32(v))
        Err(e) => Err(e)
      }
    }
    Fixed64 => {
      if !wire_type_eq(wt, WireType::Fixed64) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_fixed64() {
        Ok(v) => Ok(ProtoValue::UInt64(v))
        Err(e) => Err(e)
      }
    }
    SFixed32 => {
      if !wire_type_eq(wt, WireType::Fixed32) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_sfixed32() {
        Ok(v) => Ok(ProtoValue::Int32(v))
        Err(e) => Err(e)
      }
    }
    SFixed64 => {
      if !wire_type_eq(wt, WireType::Fixed64) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_sfixed64() {
        Ok(v) => Ok(ProtoValue::Int64(v))
        Err(e) => Err(e)
      }
    }
    Bool => {
      if !wire_type_eq(wt, WireType::Varint) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_bool() {
        Ok(v) => Ok(ProtoValue::Bool(v))
        Err(e) => Err(e)
      }
    }
    String => {
      if !wire_type_eq(wt, WireType::LengthDelimited) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_string() {
        Ok(v) => Ok(ProtoValue::String(v))
        Err(e) => Err(e)
      }
    }
    Bytes => {
      if !wire_type_eq(wt, WireType::LengthDelimited) {
        return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
      }
      match r.read_bytes() {
        Ok(v) => Ok(ProtoValue::Bytes(v))
        Err(e) => Err(e)
      }
    }
    Named(name) =>
    match resolve_nested_enum(schema, parent, name) {
      Some(_) => {
        if !wire_type_eq(wt, WireType::Varint) {
          return Err(ProtoError::WireTypeMismatch(field_num, wire_type_code(wt)))
        }
        match r.read_int32() {
          Ok(v) => Ok(ProtoValue::Enum(v))
          Err(e) => Err(e)
        }
      }
      None => Err(ProtoError::MessageNotFound(name))
    }
    Map(_, _) => Err(ProtoError::InvalidValue("unexpected map in read_scalar_value"))
  }
}

///| Expected wire type for a packed scalar element.
fn scalar_wire_type(ft : FieldType) -> WireType {
  match ft {
    Double | Fixed64 | SFixed64 => WireType::Fixed64
    Float | Fixed32 | SFixed32 => WireType::Fixed32
    String | Bytes => WireType::LengthDelimited
    _ => WireType::Varint
  }
}

///| Expected wire type for a non-packed scalar or message field.
fn expected_field_wire_type(schema : Schema, parent : MessageDescriptor, ft : FieldType) -> WireType {
  match ft {
    Double | Fixed64 | SFixed64 => WireType::Fixed64
    Float | Fixed32 | SFixed32 => WireType::Fixed32
    String | Bytes | Map(_, _) => WireType::LengthDelimited
    Named(name) =>
    match resolve_nested_enum(schema, parent, name) {
      Some(_) => WireType::Varint
      None => WireType::LengthDelimited
    }
    _ => WireType::Varint
  }
}

///| Replace or insert `(field_number, value)` in a mutable fields array.
fn upsert_field_mut(fields : Array[(Int, ProtoValue)], field_number : Int, value : ProtoValue) -> Unit {
  let mut i = 0
  while i < fields.length() {
    let (num, _) = fields[i]
    if num == field_number {
      fields[i] = (field_number, value)
      return
    }
    i = i + 1
  }
  fields.push((field_number, value))
}

///| Clear all fields belonging to the same oneof group except `keep_num`.
fn clear_oneof_siblings_mut(
  fields : Array[(Int, ProtoValue)],
  desc : MessageDescriptor,
  oneof_idx : Int,
  keep_num : Int,
) -> Array[(Int, ProtoValue)] {
  if oneof_idx < 0 || oneof_idx >= desc.oneofs.length() {
    return fields
  }
  let group = desc.oneofs[oneof_idx].field_numbers
  let out : Array[(Int, ProtoValue)] = []
  let mut i = 0
  while i < fields.length() {
    let (num, v) = fields[i]
    let mut drop = false
    if num != keep_num {
      let mut j = 0
      while j < group.length() {
        if group[j] == num {
          drop = true
          break
        }
        j = j + 1
      }
    }
    if !drop {
      out.push((num, v))
    }
    i = i + 1
  }
  out
}

///| Decode into `target` (merging into existing fields if present), strictly bounded by `opts.max_depth`.
fn decode_message_into(
  schema : Schema,
  desc : MessageDescriptor,
  data : Bytes,
  start : Int,
  end : Int,
  depth : Int,
  state : DecodeState,
  existing : Option[DynamicMessage],
) -> Result[DynamicMessage, ProtoError] {
  if depth > state.opts.max_depth {
    return Err(ProtoError::MaxDepthExceeded(state.opts.max_depth))
  }
  let mut fields : Array[(Int, ProtoValue)] = []
  let unknowns : Array[UnknownField] = []
  match existing {
    Some(prev) => {
      let mut i = 0
      while i < prev.fields.length() {
        fields.push(prev.fields[i])
        i = i + 1
      }
      i = 0
      while i < prev.unknown_fields.length() {
        unknowns.push(prev.unknown_fields[i])
        i = i + 1
      }
    }
    None => ()
  }
  let r = WireReader::{
    data: data,
    data_str: "",
    has_data_str: false,
    pos: start,
    end: end,
    reject_reserved: state.opts.reject_reserved_field_numbers,
    strict_utf8: state.opts.strict_utf8,
  }
  while !r.is_eof() {
    let tpos = r.pos()
    let tag = match r.read_tag() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if wire_type_eq(tag.wire_type, WireType::EndGroup) {
      return Err(ProtoError::UnmatchedGroup(tag.field_number, tpos))
    }
    state.field_count = state.field_count + 1
    if state.field_count > state.opts.max_fields {
      return Err(ProtoError::MaxFieldsExceeded(state.opts.max_fields))
    }
    let fdesc = match find_field_desc_by_num(desc, tag.field_number) {
      Some(fd) => fd
      None => {
        let uf = match read_unknown_field(r, tag, depth, state) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        unknowns.push(uf)
        continue
      }
    }
    // Protobuf spec: a known field number with a mismatched wire type is treated as an unknown field.
    let expected_wt = expected_field_wire_type(schema, desc, fdesc.field_type)
    let is_packed_match = match fdesc.label {
      FieldLabel::Repeated =>
      wire_type_eq(tag.wire_type, WireType::LengthDelimited) && is_packable_scalar(schema, desc, fdesc.field_type)
      _ => false
    }
    if !wire_type_eq(tag.wire_type, expected_wt) && !is_packed_match {
      let uf = match read_unknown_field(r, tag, depth, state) {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      unknowns.push(uf)
      continue
    }
    match fdesc.field_type {
      FieldType::Map(kt, vt) => {
        if !wire_type_eq(tag.wire_type, WireType::LengthDelimited) {
          return Err(ProtoError::WireTypeMismatch(tag.field_number, wire_type_code(tag.wire_type)))
        }
        let (es, ee) = match r.read_bytes_range() {
          Ok(rng) => rng
          Err(e) => return Err(e)
        }
        let entry_r = WireReader::{
          data: data,
          data_str: "",
          has_data_str: false,
          pos: es,
          end: ee,
          reject_reserved: state.opts.reject_reserved_field_numbers,
          strict_utf8: state.opts.strict_utf8,
        }
        let mut key_val = default_value_for_type(schema, desc, kt)
        let mut val_val = default_value_for_type(schema, desc, vt)
        while !entry_r.is_eof() {
          let etag = match entry_r.read_tag() {
            Ok(t) => t
            Err(e) => return Err(e)
          }
          if etag.field_number == 1 {
            key_val = match read_scalar_value(entry_r, schema, desc, 1, kt, etag.wire_type) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          } else if etag.field_number == 2 {
            match vt {
              FieldType::Named(mname) =>
              match resolve_nested_message(schema, desc, mname) {
                Some(sub_desc) => {
                  if !wire_type_eq(etag.wire_type, WireType::LengthDelimited) {
                    return Err(ProtoError::WireTypeMismatch(2, wire_type_code(etag.wire_type)))
                  }
                  let (ms, me) = match entry_r.read_bytes_range() {
                    Ok(rng) => rng
                    Err(e) => return Err(e)
                  }
                  let prev_sub = match val_val {
                    ProtoValue::Message(pm) => Option::Some(pm)
                    _ => Option::None
                  }
                  let sub_msg = match decode_message_into(schema, sub_desc, data, ms, me, depth + 1, state, prev_sub) {
                    Ok(m) => m
                    Err(e) => return Err(e)
                  }
                  val_val = ProtoValue::Message(sub_msg)
                }
                None =>
                val_val = match read_scalar_value(entry_r, schema, desc, 2, vt, etag.wire_type) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
              }
              _ =>
              val_val = match read_scalar_value(entry_r, schema, desc, 2, vt, etag.wire_type) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
            }
          } else {
            match entry_r.skip_field(etag, state.opts.max_depth - depth) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
        }
        // Append or overwrite map entry
        let mut found_map = false
        let mut i = 0
        while i < fields.length() {
          let (num, v) = fields[i]
          if num == fdesc.number {
            match v {
              ProtoValue::Map(pairs) => {
                pairs.push((key_val, val_val))
                found_map = true
                break
              }
              _ => ()
            }
          }
          i = i + 1
        }
        if !found_map {
          fields.push((fdesc.number, ProtoValue::Map([(key_val, val_val)])))
        }
      }
      _ =>
      match fdesc.label {
        FieldLabel::Repeated => {
          // Support both packed (LengthDelimited for packable scalars) and unpacked repeated
          let mut list_ref : Array[ProtoValue] = []
          let mut found_list = false
          let mut idx = 0
          while idx < fields.length() {
            let (num, v) = fields[idx]
            if num == fdesc.number {
              match v {
                ProtoValue::List(xs) => {
                  list_ref = xs
                  found_list = true
                  break
                }
                _ => ()
              }
            }
            idx = idx + 1
          }
          if !found_list {
            fields.push((fdesc.number, ProtoValue::List(list_ref)))
          }
          if wire_type_eq(tag.wire_type, WireType::LengthDelimited) && is_packable_scalar(schema, desc, fdesc.field_type) {
            let (ps, pe) = match r.read_bytes_range() {
              Ok(rng) => rng
              Err(e) => return Err(e)
            }
            let pr = WireReader::{
              data: data,
              data_str: "",
              has_data_str: false,
              pos: ps,
              end: pe,
              reject_reserved: state.opts.reject_reserved_field_numbers,
              strict_utf8: state.opts.strict_utf8,
            }
            let elem_wt = scalar_wire_type(fdesc.field_type)
            while !pr.is_eof() {
              let elem = match read_scalar_value(pr, schema, desc, fdesc.number, fdesc.field_type, elem_wt) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              list_ref.push(elem)
            }
          } else {
            match fdesc.field_type {
              FieldType::Named(mname) =>
              match resolve_nested_message(schema, desc, mname) {
                Some(sub_desc) => {
                  if !wire_type_eq(tag.wire_type, WireType::LengthDelimited) {
                    return Err(ProtoError::WireTypeMismatch(fdesc.number, wire_type_code(tag.wire_type)))
                  }
                  let (ms, me) = match r.read_bytes_range() {
                    Ok(rng) => rng
                    Err(e) => return Err(e)
                  }
                  let sub_msg = match decode_message_into(schema, sub_desc, data, ms, me, depth + 1, state, Option::None) {
                    Ok(m) => m
                    Err(e) => return Err(e)
                  }
                  list_ref.push(ProtoValue::Message(sub_msg))
                }
                None => {
                  let elem = match read_scalar_value(r, schema, desc, fdesc.number, fdesc.field_type, tag.wire_type) {
                    Ok(v) => v
                    Err(e) => return Err(e)
                  }
                  list_ref.push(elem)
                }
              }
              _ => {
                let elem = match read_scalar_value(r, schema, desc, fdesc.number, fdesc.field_type, tag.wire_type) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
                list_ref.push(elem)
              }
            }
          }
        }
        _ => {
          // Singular field (Implicit, Optional, Required, or oneof)
          if fdesc.oneof_index >= 0 {
            fields = clear_oneof_siblings_mut(fields, desc, fdesc.oneof_index, fdesc.number)
          }
          match fdesc.field_type {
            FieldType::Named(mname) =>
            match resolve_nested_message(schema, desc, mname) {
              Some(sub_desc) => {
                if !wire_type_eq(tag.wire_type, WireType::LengthDelimited) {
                  return Err(ProtoError::WireTypeMismatch(fdesc.number, wire_type_code(tag.wire_type)))
                }
                let (ms, me) = match r.read_bytes_range() {
                  Ok(rng) => rng
                  Err(e) => return Err(e)
                }
                // Merge into existing submessage if already present!
                let mut prev_sub : Option[DynamicMessage] = Option::None
                let mut k = 0
                while k < fields.length() {
                  let (num, v) = fields[k]
                  if num == fdesc.number {
                    match v {
                      ProtoValue::Message(pm) => prev_sub = Option::Some(pm)
                      _ => ()
                    }
                    break
                  }
                  k = k + 1
                }
                let sub_msg = match decode_message_into(schema, sub_desc, data, ms, me, depth + 1, state, prev_sub) {
                  Ok(m) => m
                  Err(e) => return Err(e)
                }
                upsert_field_mut(fields, fdesc.number, ProtoValue::Message(sub_msg))
              }
              None => {
                let sv = match read_scalar_value(r, schema, desc, fdesc.number, fdesc.field_type, tag.wire_type) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
                upsert_field_mut(fields, fdesc.number, sv)
              }
            }
            _ => {
              let sv = match read_scalar_value(r, schema, desc, fdesc.number, fdesc.field_type, tag.wire_type) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              upsert_field_mut(fields, fdesc.number, sv)
            }
          }
        }
      }
    }
  }
  Ok(DynamicMessage::{
    message_name: desc.name,
    fields: fields,
    unknown_fields: unknowns,
  })
}

///| Decode a binary Protobuf message dynamically using a parsed `Schema`.
pub fn decode_dynamic(
  schema : Schema,
  msg_name : String,
  data : Bytes,
  opts : DecodeOptions,
) -> Result[DynamicMessage, ProtoError] {
  if data.length() > opts.max_bytes {
    return Err(ProtoError::MaxBytesExceeded(opts.max_bytes))
  }
  let desc = match schema_find_message(schema, msg_name) {
    Some(d) => d
    None => return Err(ProtoError::MessageNotFound(msg_name))
  }
  let state = DecodeState::{ opts: opts, field_count: 0 }
  decode_message_into(schema, desc, data, 0, data.length(), 0, state, Option::None)
}

///| Decode a binary Protobuf message dynamically using default `DecodeOptions`.
pub fn decode_dynamic_default(
  schema : Schema,
  msg_name : String,
  data : Bytes,
) -> Result[DynamicMessage, ProtoError] {
  decode_dynamic(schema, msg_name, data, DecodeOptions::default())
}

///| Write a single scalar value without tag (for packed repeated).
fn write_scalar_untagged(w : WireWriter, ft : FieldType, v : ProtoValue) -> Result[Unit, ProtoError] {
  match (ft, v) {
    (FieldType::Double, ProtoValue::Double(d)) => {
      w.write_fixed64(d.to_bits().to_uint64())
      Ok(())
    }
    (FieldType::Float, ProtoValue::Float(d)) => {
      w.write_fixed32(double_to_float32_bits(d))
      Ok(())
    }
    (FieldType::Int32, ProtoValue::Int32(n)) => {
      w.write_varint64(((n.to_int64() << 32) >> 32).to_uint64())
      Ok(())
    }
    (FieldType::Int64, ProtoValue::Int64(n)) => {
      w.write_varint64(n.to_uint64())
      Ok(())
    }
    (FieldType::UInt32, ProtoValue::UInt32(n)) => {
      w.write_varint64((n & 0xFFFFFFFFL).to_uint64())
      Ok(())
    }
    (FieldType::UInt64, ProtoValue::UInt64(n)) => {
      w.write_varint64(n)
      Ok(())
    }
    (FieldType::SInt32, ProtoValue::Int32(n)) => {
      w.write_varint64(zigzag_encode_i32(n).to_uint64())
      Ok(())
    }
    (FieldType::SInt64, ProtoValue::Int64(n)) => {
      w.write_varint64(zigzag_encode_i64(n))
      Ok(())
    }
    (FieldType::Fixed32, ProtoValue::UInt32(n)) => {
      w.write_fixed32(n)
      Ok(())
    }
    (FieldType::Fixed64, ProtoValue::UInt64(n)) => {
      w.write_fixed64(n)
      Ok(())
    }
    (FieldType::SFixed32, ProtoValue::Int32(n)) => {
      w.write_fixed32(n.to_int64() & 0xFFFFFFFFL)
      Ok(())
    }
    (FieldType::SFixed64, ProtoValue::Int64(n)) => {
      w.write_fixed64(n.to_uint64())
      Ok(())
    }
    (FieldType::Bool, ProtoValue::Bool(b)) => {
      w.write_varint64(if b { 1UL } else { 0UL })
      Ok(())
    }
    (FieldType::Named(_), ProtoValue::Enum(n)) => {
      w.write_varint64(((n.to_int64() << 32) >> 32).to_uint64())
      Ok(())
    }
    _ => Err(ProtoError::InvalidValue("type mismatch in packed scalar encode"))
  }
}

///| Write a single tagged field value.
fn write_scalar_field(w : WireWriter, field_number : Int, ft : FieldType, v : ProtoValue) -> Result[Unit, ProtoError] {
  match (ft, v) {
    (FieldType::Double, ProtoValue::Double(d)) => {
      w.write_double_field(field_number, d)
      Ok(())
    }
    (FieldType::Float, ProtoValue::Float(d)) => {
      w.write_float_field(field_number, d)
      Ok(())
    }
    (FieldType::Int32, ProtoValue::Int32(n)) => {
      w.write_int32_field(field_number, n)
      Ok(())
    }
    (FieldType::Int64, ProtoValue::Int64(n)) => {
      w.write_int64_field(field_number, n)
      Ok(())
    }
    (FieldType::UInt32, ProtoValue::UInt32(n)) => {
      w.write_uint32_field(field_number, n)
      Ok(())
    }
    (FieldType::UInt64, ProtoValue::UInt64(n)) => {
      w.write_uint64_field(field_number, n)
      Ok(())
    }
    (FieldType::SInt32, ProtoValue::Int32(n)) => {
      w.write_sint32_field(field_number, n)
      Ok(())
    }
    (FieldType::SInt64, ProtoValue::Int64(n)) => {
      w.write_sint64_field(field_number, n)
      Ok(())
    }
    (FieldType::Fixed32, ProtoValue::UInt32(n)) => {
      w.write_fixed32_field(field_number, n)
      Ok(())
    }
    (FieldType::Fixed64, ProtoValue::UInt64(n)) => {
      w.write_fixed64_field(field_number, n)
      Ok(())
    }
    (FieldType::SFixed32, ProtoValue::Int32(n)) => {
      w.write_sfixed32_field(field_number, n)
      Ok(())
    }
    (FieldType::SFixed64, ProtoValue::Int64(n)) => {
      w.write_sfixed64_field(field_number, n)
      Ok(())
    }
    (FieldType::Bool, ProtoValue::Bool(b)) => {
      w.write_bool_field(field_number, b)
      Ok(())
    }
    (FieldType::String, ProtoValue::String(s)) => {
      w.write_string_field(field_number, s)
      Ok(())
    }
    (FieldType::Bytes, ProtoValue::Bytes(b)) => {
      w.write_bytes_field(field_number, b)
      Ok(())
    }
    (FieldType::Named(_), ProtoValue::Enum(n)) => {
      w.write_int32_field(field_number, n)
      Ok(())
    }
    _ => Err(ProtoError::InvalidValue("value type mismatch for field " + field_number.to_string()))
  }
}

///| Write an unknown field back to wire format.
fn write_unknown_field(w : WireWriter, uf : UnknownField) -> Unit {
  match uf.value {
    UnknownValue::Varint(v) => {
      w.write_tag(uf.field_number, WireType::Varint)
      w.write_varint64(v)
    }
    UnknownValue::Fixed32(v) => w.write_fixed32_field(uf.field_number, v)
    UnknownValue::Fixed64(v) => w.write_fixed64_field(uf.field_number, v)
    UnknownValue::LengthDelimited(b) => w.write_bytes_field(uf.field_number, b)
    UnknownValue::Group(inner) => {
      w.write_tag(uf.field_number, WireType::StartGroup)
      let mut i = 0
      while i < inner.length() {
        write_unknown_field(w, inner[i])
        i = i + 1
      }
      w.write_tag(uf.field_number, WireType::EndGroup)
    }
  }
}

///|
fn encode_message_with_desc(
  schema : Schema,
  desc : MessageDescriptor,
  msg : DynamicMessage,
  depth : Int,
) -> Result[Bytes, ProtoError] {
  if depth > 256 {
    return Err(ProtoError::MaxDepthExceeded(256))
  }
  let w = WireWriter::new()
  let is_proto3 = match schema.syntax {
    Syntax::Proto3 => true
    Syntax::Proto2 => false
  }
  let mut i = 0
  while i < msg.fields.length() {
    let (fnum, fval) = msg.fields[i]
    let fdesc = match find_field_desc_by_num(desc, fnum) {
      Some(fd) => fd
      None => return Err(ProtoError::FieldNotFound(fnum.to_string()))
    }
    match fdesc.field_type {
      FieldType::Map(kt, vt) =>
      match fval {
        ProtoValue::Map(pairs) => {
          let mut j = 0
          while j < pairs.length() {
            let (k, v) = pairs[j]
            let ew = WireWriter::new()
            match write_scalar_field(ew, 1, kt, k) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            match (vt, v) {
              (FieldType::Named(mname), ProtoValue::Message(sub_msg)) =>
              match resolve_nested_message(schema, desc, mname) {
                Some(sub_desc) => {
                  let sub_bytes = match encode_message_with_desc(schema, sub_desc, sub_msg, depth + 1) {
                    Ok(b) => b
                    Err(e) => return Err(e)
                  }
                  ew.write_bytes_field(2, sub_bytes)
                }
                None => return Err(ProtoError::MessageNotFound(mname))
              }
              _ =>
              match write_scalar_field(ew, 2, vt, v) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            }
            w.write_bytes_field(fnum, ew.to_bytes())
            j = j + 1
          }
        }
        _ => return Err(ProtoError::InvalidValue("expected Map for field " + fdesc.name))
      }
      _ =>
      match fdesc.label {
        FieldLabel::Repeated =>
        match fval {
          ProtoValue::List(items) => {
            if items.length() > 0 {
              let use_packed = match fdesc.packed {
                Some(p) => p && is_packable_scalar(schema, desc, fdesc.field_type)
                None => is_proto3 && is_packable_scalar(schema, desc, fdesc.field_type)
              }
              if use_packed {
                let pw = WireWriter::new()
                let mut j = 0
                while j < items.length() {
                  match write_scalar_untagged(pw, fdesc.field_type, items[j]) {
                    Ok(_) => ()
                    Err(e) => return Err(e)
                  }
                  j = j + 1
                }
                w.write_bytes_field(fnum, pw.to_bytes())
              } else {
                let mut j = 0
                while j < items.length() {
                  match (fdesc.field_type, items[j]) {
                    (FieldType::Named(mname), ProtoValue::Message(sub_msg)) =>
                    match resolve_nested_message(schema, desc, mname) {
                      Some(sub_desc) => {
                        let sub_bytes = match encode_message_with_desc(schema, sub_desc, sub_msg, depth + 1) {
                          Ok(b) => b
                          Err(e) => return Err(e)
                        }
                        w.write_bytes_field(fnum, sub_bytes)
                      }
                      None => return Err(ProtoError::MessageNotFound(mname))
                    }
                    _ =>
                    match write_scalar_field(w, fnum, fdesc.field_type, items[j]) {
                      Ok(_) => ()
                      Err(e) => return Err(e)
                    }
                  }
                  j = j + 1
                }
              }
            }
          }
          _ => return Err(ProtoError::InvalidValue("expected List for repeated field " + fdesc.name))
        }
        _ => {
          // Proto3 implicit singular omits default zero values; oneof and explicit optional always emit.
          let omit_default = is_proto3 && fdesc.oneof_index < 0 && match fdesc.label {
            FieldLabel::Implicit => true
            _ => false
          }
          if omit_default && is_default_proto3_value(fval) {
            i = i + 1
            continue
          }
          match (fdesc.field_type, fval) {
            (FieldType::Named(mname), ProtoValue::Message(sub_msg)) =>
            match resolve_nested_message(schema, desc, mname) {
              Some(sub_desc) => {
                let sub_bytes = match encode_message_with_desc(schema, sub_desc, sub_msg, depth + 1) {
                  Ok(b) => b
                  Err(e) => return Err(e)
                }
                w.write_bytes_field(fnum, sub_bytes)
              }
              None => return Err(ProtoError::MessageNotFound(mname))
            }
            _ =>
            match write_scalar_field(w, fnum, fdesc.field_type, fval) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
        }
      }
    }
    i = i + 1
  }
  // Losslessly re-emit unknown fields
  let mut u = 0
  while u < msg.unknown_fields.length() {
    write_unknown_field(w, msg.unknown_fields[u])
    u = u + 1
  }
  Ok(w.to_bytes())
}

///| Encode a `DynamicMessage` back to binary Protobuf wire format using `Schema`.
pub fn encode_dynamic(schema : Schema, msg : DynamicMessage) -> Result[Bytes, ProtoError] {
  let desc = match schema_find_message(schema, msg.message_name) {
    Some(d) => d
    None => return Err(ProtoError::MessageNotFound(msg.message_name))
  }
  encode_message_with_desc(schema, desc, msg, 0)
}

///| Check if a field number is present in `DynamicMessage`.
pub fn has_field(msg : DynamicMessage, field_number : Int) -> Bool {
  let mut i = 0
  while i < msg.fields.length() {
    let (num, _) = msg.fields[i]
    if num == field_number {
      return true
    }
    i = i + 1
  }
  false
}

///| Get raw `ProtoValue` by field number.
pub fn get_field(msg : DynamicMessage, field_number : Int) -> Option[ProtoValue] {
  let mut i = 0
  while i < msg.fields.length() {
    let (num, v) = msg.fields[i]
    if num == field_number {
      return Option::Some(v)
    }
    i = i + 1
  }
  Option::None
}

///| Get raw `ProtoValue` by field name.
pub fn get_field_by_name(schema : Schema, msg : DynamicMessage, name : String) -> Option[ProtoValue] {
  let desc = match schema_find_message(schema, msg.message_name) {
    Some(d) => d
    None => return Option::None
  }
  match find_field_desc_by_name(desc, name) {
    Some(fd) => get_field(msg, fd.number)
    None => Option::None
  }
}

///| Return a new `DynamicMessage` with `field_number` set to `value`.
pub fn set_field(msg : DynamicMessage, field_number : Int, value : ProtoValue) -> DynamicMessage {
  let next_fields : Array[(Int, ProtoValue)] = []
  let mut replaced = false
  let mut i = 0
  while i < msg.fields.length() {
    let (num, v) = msg.fields[i]
    if num == field_number {
      next_fields.push((field_number, value))
      replaced = true
    } else {
      next_fields.push((num, v))
    }
    i = i + 1
  }
  if !replaced {
    next_fields.push((field_number, value))
  }
  DynamicMessage::{
    message_name: msg.message_name,
    fields: next_fields,
    unknown_fields: msg.unknown_fields,
  }
}

///| Return a new `DynamicMessage` with field named `name` set to `value` (enforcing oneof exclusivity).
pub fn set_field_by_name(
  schema : Schema,
  msg : DynamicMessage,
  name : String,
  value : ProtoValue,
) -> Result[DynamicMessage, ProtoError] {
  let desc = match schema_find_message(schema, msg.message_name) {
    Some(d) => d
    None => return Err(ProtoError::MessageNotFound(msg.message_name))
  }
  let fd = match find_field_desc_by_name(desc, name) {
    Some(f) => f
    None => return Err(ProtoError::FieldNotFound(name))
  }
  let mut next_fields : Array[(Int, ProtoValue)] = []
  let mut i = 0
  while i < msg.fields.length() {
    next_fields.push(msg.fields[i])
    i = i + 1
  }
  if fd.oneof_index >= 0 {
    next_fields = clear_oneof_siblings_mut(next_fields, desc, fd.oneof_index, fd.number)
  }
  upsert_field_mut(next_fields, fd.number, value)
  Ok(DynamicMessage::{
    message_name: msg.message_name,
    fields: next_fields,
    unknown_fields: msg.unknown_fields,
  })
}

///| Return a new `DynamicMessage` with `field_number` cleared.
pub fn clear_field(msg : DynamicMessage, field_number : Int) -> DynamicMessage {
  let next_fields : Array[(Int, ProtoValue)] = []
  let mut i = 0
  while i < msg.fields.length() {
    let (num, v) = msg.fields[i]
    if num != field_number {
      next_fields.push((num, v))
    }
    i = i + 1
  }
  DynamicMessage::{
    message_name: msg.message_name,
    fields: next_fields,
    unknown_fields: msg.unknown_fields,
  }
}

///| Typed getters by field number.
pub fn get_int32(msg : DynamicMessage, field_number : Int) -> Option[Int] {
  match get_field(msg, field_number) {
    Some(ProtoValue::Int32(v)) => Option::Some(v)
    _ => Option::None
  }
}

