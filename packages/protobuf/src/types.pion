///| Core Protocol Buffers v2/v3 wire types, errors, options, Schema AST, and DynamicMessage types.

///| Wire type (3-bit value in tag).
#verify
pub enum WireType {
  Varint // 0: int32, int64, uint32, uint64, sint32, sint64, bool, enum
  Fixed64 // 1: fixed64, sfixed64, double
  LengthDelimited // 2: string, bytes, embedded messages, packed repeated fields
  StartGroup // 3: groups (proto2, deprecated)
  EndGroup // 4: groups (proto2, deprecated)
  Fixed32 // 5: fixed32, sfixed32, float
}

///| Convert WireType to its 3-bit integer code (0..5).
#verify
pub fn wire_type_code(wt : WireType) -> Int {
  match wt {
    Varint => 0
    Fixed64 => 1
    LengthDelimited => 2
    StartGroup => 3
    EndGroup => 4
    Fixed32 => 5
  }
}

///| Convert integer code (0..5) to WireType.
#verify
pub fn wire_type_from_code(code : Int) -> Option[WireType] {
  match code {
    0 => Option::Some(WireType::Varint)
    1 => Option::Some(WireType::Fixed64)
    2 => Option::Some(WireType::LengthDelimited)
    3 => Option::Some(WireType::StartGroup)
    4 => Option::Some(WireType::EndGroup)
    5 => Option::Some(WireType::Fixed32)
    _ => Option::None
  }
}

///| Equality check for WireType.
#verify
pub fn wire_type_eq(a : WireType, b : WireType) -> Bool {
  wire_type_code(a) == wire_type_code(b)
}

///| Decoded field tag (field_number + wire_type).
#verify
pub val struct Tag {
  pub field_number : Int
  pub wire_type : WireType
}

///| Maximum legal Protobuf field number: 2^29 - 1 = 536870911.
pub let max_field_number : Int = 536870911

///| Reserved Protobuf implementation range: 19000..19999.
pub let reserved_range_start : Int = 19000

///|
pub let reserved_range_end : Int = 19999

///| Error types for wire codec, schema parser, dynamic reflection, and JSON mapping.
pub enum ProtoError {
  UnexpectedEof(Int)
  VarintOverflow(Int)
  InvalidWireType(Int, Int)
  InvalidFieldNumber(Int, Int)
  ReservedFieldNumber(Int, Int)
  InvalidUtf8(Int)
  UnmatchedGroup(Int, Int)
  MaxDepthExceeded(Int)
  MaxFieldsExceeded(Int)
  MaxBytesExceeded(Int)
  WireTypeMismatch(Int, Int)
  SchemaError(String)
  MessageNotFound(String)
  FieldNotFound(String)
  InvalidValue(String)
}

///| Human-readable error message.
pub fn error_message(err : ProtoError) -> String {
  match err {
    UnexpectedEof(pos) => "protobuf: unexpected EOF at offset " + pos.to_string()
    VarintOverflow(pos) => "protobuf: varint overflow (>10 bytes or 10th byte > 0x01) at offset " + pos.to_string()
    InvalidWireType(wt, pos) =>
    "protobuf: invalid wire type " + wt.to_string() + " at offset " + pos.to_string()
    InvalidFieldNumber(num, pos) =>
    "protobuf: invalid field number " + num.to_string() + " at offset " + pos.to_string()
    ReservedFieldNumber(num, pos) =>
    "protobuf: reserved field number " + num.to_string() + " at offset " + pos.to_string()
    InvalidUtf8(pos) => "protobuf: invalid UTF-8 string at offset " + pos.to_string()
    UnmatchedGroup(num, pos) =>
    "protobuf: unmatched group tag for field " + num.to_string() + " at offset " + pos.to_string()
    MaxDepthExceeded(limit) => "protobuf: exceeded max recursion depth " + limit.to_string()
    MaxFieldsExceeded(limit) => "protobuf: exceeded max field count " + limit.to_string()
    MaxBytesExceeded(limit) => "protobuf: exceeded max input bytes " + limit.to_string()
    WireTypeMismatch(field_num, wt) =>
    "protobuf: wire type mismatch for field " + field_num.to_string() + " (got wire type " + wt.to_string() + ")"
    SchemaError(msg) => "protobuf: schema error: " + msg
    MessageNotFound(name) => "protobuf: message not found: " + name
    FieldNotFound(name) => "protobuf: field not found: " + name
    InvalidValue(msg) => "protobuf: invalid value: " + msg
  }
}

///| Decode resource limits and validation options.
#verify
pub val struct DecodeOptions {
  pub max_depth : Int
  pub max_fields : Int
  pub max_bytes : Int
  pub strict_utf8 : Bool
  pub reject_reserved_field_numbers : Bool
}

///| Default decode options: max_depth=100, max_fields=100000, max_bytes=64 MiB, strict_utf8=true.
#verify
pub fn DecodeOptions::default() -> DecodeOptions {
  DecodeOptions::{
    max_depth: 100,
    max_fields: 100000,
    max_bytes: 67108864,
    strict_utf8: true,
    reject_reserved_field_numbers: false,
  }
}

///| Options for Proto3 Canonical JSON serialization.
#verify
pub val struct JsonOptions {
  pub emit_defaults : Bool
  pub use_proto_names : Bool
  pub enums_as_ints : Bool
}

///| Default Proto3 Canonical JSON options.
#verify
pub fn JsonOptions::default() -> JsonOptions {
  JsonOptions::{ emit_defaults: false, use_proto_names: false, enums_as_ints: false }
}

///| Protobuf syntax version.
pub enum Syntax {
  Proto2
  Proto3
}

///| Field label / cardinality.
pub enum FieldLabel {
  Implicit // proto3 singular without explicit `optional`
  Optional // proto2 `optional` or proto3 `optional`
  Required // proto2 `required`
  Repeated // `repeated` or `map<K, V>`
}

///| Protobuf field type.
pub enum FieldType {
  Double
  Float
  Int32
  Int64
  UInt32
  UInt64
  SInt32
  SInt64
  Fixed32
  Fixed64
  SFixed32
  SFixed64
  Bool
  String
  Bytes
  Named(String) // message or enum type name (resolved against Schema)
  Map(FieldType, FieldType)
}

///| Option key-value pair on file, message, enum, or field.
pub val struct ProtoOption {
  pub name : String
  pub value : String
}

///| Reserved number range [start, end] inclusive.
pub val struct ReservedRange {
  pub start : Int
  pub end : Int
}

///| Enum value descriptor.
pub val struct EnumValueDescriptor {
  pub name : String
  pub number : Int
}

///| Enum descriptor.
pub struct EnumDescriptor {
  pub name : String
  pub full_name : String
  pub values : Array[EnumValueDescriptor]
  pub options : Array[ProtoOption]
  pub reserved_ranges : Array[ReservedRange]
  pub reserved_names : Array[String]
}

///| Oneof group descriptor.
pub struct OneofDescriptor {
  pub name : String
  pub field_numbers : Array[Int]
}

///| Field descriptor inside a message.
pub struct FieldDescriptor {
  pub name : String
  pub number : Int
  pub label : FieldLabel
  pub field_type : FieldType
  pub oneof_index : Int // -1 if not in a oneof
  pub json_name : String
  pub packed : Option[Bool] // explicit [packed=true/false] option
  pub default_value : Option[String]
  pub options : Array[ProtoOption]
  pub resolved_kind : Int // 0=scalar/unlinked, 1=local msg, 2=top enum, 3=nested enum, 4=wkt msg, 5=wkt enum
  pub resolved_path : Array[Int]
  pub is_group : Bool
}

///| Message descriptor.
pub struct MessageDescriptor {
  pub name : String
  pub full_name : String
  pub fields : Array[FieldDescriptor]
  pub oneofs : Array[OneofDescriptor]
  pub nested_messages : Array[MessageDescriptor]
  pub nested_enums : Array[EnumDescriptor]
  pub options : Array[ProtoOption]
  pub reserved_ranges : Array[ReservedRange]
  pub reserved_names : Array[String]
  pub field_by_num : Map[Int, Int]
  pub has_required : Bool
}

///| Parsed `.proto` file schema.
pub struct Schema {
  pub syntax : Syntax
  pub package_name : String
  pub imports : Array[String]
  pub options : Array[ProtoOption]
  pub messages : Array[MessageDescriptor]
  pub enums : Array[EnumDescriptor]
}

///| Unknown field raw payload for lossless roundtrip.
pub enum UnknownValue {
  Varint(UInt64)
  Fixed32(Int64) // lower 32 bits
  Fixed64(UInt64)
  LengthDelimited(Bytes)
  Group(Array[UnknownField])
}

///| Unknown field preserved during dynamic decode/encode.
pub struct UnknownField {
  pub field_number : Int
  pub wire_type : WireType
  pub value : UnknownValue
  pub raw_bytes : Bytes
}

///| Dynamic value stored in a `DynamicMessage`.
pub enum ProtoValue {
  Bool(Bool)
  Int32(Int)
  Int64(Int64)
  UInt32(Int64) // 0..4294967295
  UInt64(UInt64)
  Float(Double) // IEEE-754 binary32 precision
  Double(Double)
  String(String)
  Bytes(Bytes)
  Enum(Int)
  Message(DynamicMessage)
  List(Array[ProtoValue])
  Map(Array[(ProtoValue, ProtoValue)])
}

///| Dynamic reflection message with lossless unknown field preservation.
pub struct DynamicMessage {
  pub message_name : String
  pub fields : Array[(Int, ProtoValue)]
  pub unknown_fields : Array[UnknownField]
}

///| Construct an empty `DynamicMessage`.
pub fn DynamicMessage::new(message_name : String) -> DynamicMessage {
  DynamicMessage::{ message_name: message_name, fields: [], unknown_fields: [] }
}

///| Byte slice equality helper.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Convert snake_case field name to Proto3 lowerCamelCase JSON name.
pub fn to_lower_camel_case(name : String) -> String {
  let n = name.length()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut cap_next = false
  while i < n {
    let c = name.code_unit_at(i)
    if c == 95 {
      // '_'
      cap_next = true
    } else if cap_next && c >= 97 && c <= 122 {
      sb.write_byte((c - 32).to_byte())
      cap_next = false
    } else {
      sb.write_byte(c.to_byte())
      cap_next = false
    }
    i = i + 1
  }
  sb.to_string()
}
