///| Built-in Google Protobuf Well-Known Types (WKT) descriptors and Proto3 JSON helpers.

///|
fn wkt_field(
  name : String,
  number : Int,
  label : FieldLabel,
  ft : FieldType,
  oneof_index : Int,
  resolved_kind : Int,
) -> FieldDescriptor {
  FieldDescriptor::{
    name: name,
    number: number,
    label: label,
    field_type: ft,
    oneof_index: oneof_index,
    json_name: to_lower_camel_case(name),
    packed: Option::None,
    default_value: Option::None,
    options: [],
    resolved_kind: resolved_kind,
    resolved_path: [],
    is_group: false,
  }
}

///|
fn wkt_msg(
  name : String,
  full_name : String,
  fields : Array[FieldDescriptor],
  oneofs : Array[OneofDescriptor],
) -> MessageDescriptor {
  let fbm : Map[Int, Int] = Map::new()
  let mut i = 0
  while i < fields.length() {
    fbm.set(fields[i].number, i)
    i = i + 1
  }
  MessageDescriptor::{
    name: name,
    full_name: full_name,
    fields: fields,
    oneofs: oneofs,
    nested_messages: [],
    nested_enums: [],
    options: [],
    reserved_ranges: [],
    reserved_names: [],
    field_by_num: fbm,
    has_required: false,
  }
}

///| Look up a built-in Well-Known Type message descriptor by full name.
pub fn wkt_find_message(full_name : String) -> Option[MessageDescriptor] {
  let clean = strip_leading_dot(full_name)
  if clean == "google.protobuf.Timestamp" {
    return Option::Some(
      wkt_msg(
        "Timestamp",
        "google.protobuf.Timestamp",
        [
          wkt_field("seconds", 1, FieldLabel::Implicit, FieldType::Int64, -1, 0),
          wkt_field("nanos", 2, FieldLabel::Implicit, FieldType::Int32, -1, 0),
        ],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Duration" {
    return Option::Some(
      wkt_msg(
        "Duration",
        "google.protobuf.Duration",
        [
          wkt_field("seconds", 1, FieldLabel::Implicit, FieldType::Int64, -1, 0),
          wkt_field("nanos", 2, FieldLabel::Implicit, FieldType::Int32, -1, 0),
        ],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Empty" {
    return Option::Some(wkt_msg("Empty", "google.protobuf.Empty", [], []))
  }
  if clean == "google.protobuf.Any" {
    return Option::Some(
      wkt_msg(
        "Any",
        "google.protobuf.Any",
        [
          wkt_field("type_url", 1, FieldLabel::Implicit, FieldType::String, -1, 0),
          wkt_field("value", 2, FieldLabel::Implicit, FieldType::Bytes, -1, 0),
        ],
        [],
      ),
    )
  }
  if clean == "google.protobuf.FieldMask" {
    return Option::Some(
      wkt_msg(
        "FieldMask",
        "google.protobuf.FieldMask",
        [wkt_field("paths", 1, FieldLabel::Repeated, FieldType::String, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.DoubleValue" {
    return Option::Some(
      wkt_msg(
        "DoubleValue",
        "google.protobuf.DoubleValue",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Double, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.FloatValue" {
    return Option::Some(
      wkt_msg(
        "FloatValue",
        "google.protobuf.FloatValue",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Float, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Int64Value" {
    return Option::Some(
      wkt_msg(
        "Int64Value",
        "google.protobuf.Int64Value",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Int64, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.UInt64Value" {
    return Option::Some(
      wkt_msg(
        "UInt64Value",
        "google.protobuf.UInt64Value",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::UInt64, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Int32Value" {
    return Option::Some(
      wkt_msg(
        "Int32Value",
        "google.protobuf.Int32Value",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Int32, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.UInt32Value" {
    return Option::Some(
      wkt_msg(
        "UInt32Value",
        "google.protobuf.UInt32Value",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::UInt32, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.BoolValue" {
    return Option::Some(
      wkt_msg(
        "BoolValue",
        "google.protobuf.BoolValue",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Bool, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.StringValue" {
    return Option::Some(
      wkt_msg(
        "StringValue",
        "google.protobuf.StringValue",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::String, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.BytesValue" {
    return Option::Some(
      wkt_msg(
        "BytesValue",
        "google.protobuf.BytesValue",
        [wkt_field("value", 1, FieldLabel::Implicit, FieldType::Bytes, -1, 0)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Struct" {
    return Option::Some(
      wkt_msg(
        "Struct",
        "google.protobuf.Struct",
        [
          wkt_field(
            "fields",
            1,
            FieldLabel::Repeated,
            FieldType::Map(FieldType::String, FieldType::Named("google.protobuf.Value")),
            -1,
            4,
          ),
        ],
        [],
      ),
    )
  }
  if clean == "google.protobuf.ListValue" {
    return Option::Some(
      wkt_msg(
        "ListValue",
        "google.protobuf.ListValue",
        [wkt_field("values", 1, FieldLabel::Repeated, FieldType::Named("google.protobuf.Value"), -1, 4)],
        [],
      ),
    )
  }
  if clean == "google.protobuf.Value" {
    return Option::Some(
      wkt_msg(
        "Value",
        "google.protobuf.Value",
        [
          wkt_field("null_value", 1, FieldLabel::Optional, FieldType::Named("google.protobuf.NullValue"), 0, 5),
          wkt_field("number_value", 2, FieldLabel::Optional, FieldType::Double, 0, 0),
          wkt_field("string_value", 3, FieldLabel::Optional, FieldType::String, 0, 0),
          wkt_field("bool_value", 4, FieldLabel::Optional, FieldType::Bool, 0, 0),
          wkt_field("struct_value", 5, FieldLabel::Optional, FieldType::Named("google.protobuf.Struct"), 0, 4),
          wkt_field("list_value", 6, FieldLabel::Optional, FieldType::Named("google.protobuf.ListValue"), 0, 4),
        ],
        [OneofDescriptor::{ name: "kind", field_numbers: [1, 2, 3, 4, 5, 6] }],
      ),
    )
  }
  if clean == "google.protobuf.FileOptions" ||
  clean == "google.protobuf.MessageOptions" ||
  clean == "google.protobuf.FieldOptions" ||
  clean == "google.protobuf.OneofOptions" ||
  clean == "google.protobuf.EnumOptions" ||
  clean == "google.protobuf.EnumValueOptions" ||
  clean == "google.protobuf.ServiceOptions" ||
  clean == "google.protobuf.MethodOptions" {
    return Option::Some(wkt_msg(clean, clean, [], []))
  }
  Option::None
}

///| Look up a built-in Well-Known Type enum descriptor by full name.
pub fn wkt_find_enum(full_name : String) -> Option[EnumDescriptor] {
  let clean = strip_leading_dot(full_name)
  if clean == "google.protobuf.NullValue" {
    return Option::Some(
      EnumDescriptor::{
        name: "NullValue",
        full_name: "google.protobuf.NullValue",
        values: [EnumValueDescriptor::{ name: "NULL_VALUE", number: 0 }],
        options: [],
        reserved_ranges: [],
        reserved_names: [],
      },
    )
  }
  Option::None
}

///| Check whether an import path makes a WKT type name visible.
fn wkt_import_provides(imports : Array[String], full_name : String) -> Bool {
  let needed = if full_name == "google.protobuf.Timestamp" {
    "google/protobuf/timestamp.proto"
  } else if full_name == "google.protobuf.Duration" {
    "google/protobuf/duration.proto"
  } else if full_name == "google.protobuf.Empty" {
    "google/protobuf/empty.proto"
  } else if full_name == "google.protobuf.Any" {
    "google/protobuf/any.proto"
  } else if full_name == "google.protobuf.FieldMask" {
    "google/protobuf/field_mask.proto"
  } else if full_name == "google.protobuf.DoubleValue" ||
  full_name == "google.protobuf.FloatValue" ||
  full_name == "google.protobuf.Int64Value" ||
  full_name == "google.protobuf.UInt64Value" ||
  full_name == "google.protobuf.Int32Value" ||
  full_name == "google.protobuf.UInt32Value" ||
  full_name == "google.protobuf.BoolValue" ||
  full_name == "google.protobuf.StringValue" ||
  full_name == "google.protobuf.BytesValue" {
    "google/protobuf/wrappers.proto"
  } else if full_name == "google.protobuf.Struct" ||
  full_name == "google.protobuf.ListValue" ||
  full_name == "google.protobuf.Value" ||
  full_name == "google.protobuf.NullValue" {
    "google/protobuf/struct.proto"
  } else if full_name == "google.protobuf.FileOptions" ||
  full_name == "google.protobuf.MessageOptions" ||
  full_name == "google.protobuf.FieldOptions" ||
  full_name == "google.protobuf.OneofOptions" ||
  full_name == "google.protobuf.EnumOptions" ||
  full_name == "google.protobuf.EnumValueOptions" ||
  full_name == "google.protobuf.ServiceOptions" ||
  full_name == "google.protobuf.MethodOptions" {
    "google/protobuf/descriptor.proto"
  } else {
    ""
  }
  if needed.length() == 0 {
    return false
  }
  let mut i = 0
  while i < imports.length() {
    if imports[i] == needed {
      return true
    }
    i = i + 1
  }
  false
}

///| Write a zero-padded integer of fixed width `width` into `sb`.
fn write_padded_int(sb : StringBuilder, v : Int64, width : Int) -> Unit {
  let s = v.to_string()
  let mut pad = width - s.length()
  while pad > 0 {
    sb.write_byte((48).to_byte())
    pad = pad - 1
  }
  sb.write_string(s)
}

///| Format `google.protobuf.Timestamp` as RFC 3339 JSON string (with quotes).
fn write_wkt_timestamp_json(sb : StringBuilder, msg : DynamicMessage) -> Result[Unit, ProtoError] {
  let secs = match get_int64(msg, 1) {
    Some(s) => s
    None => 0L
  }
  let nanos = match get_int32(msg, 2) {
    Some(n) => n
    None => 0
  }
  // Valid range: 0001-01-01T00:00:00Z (-62135596800) to 9999-12-31T23:59:59Z (253402300799)
  if secs < -62135596800L || secs > 253402300799L || nanos < 0 || nanos > 999999999 {
    return Err(ProtoError::InvalidValue("google.protobuf.Timestamp out of range"))
  }
  // Euclidean division by 86400
  let mut days = secs / 86400L
  let mut rem = secs % 86400L
  if rem < 0L {
    rem = rem + 86400L
    days = days - 1L
  }
  let hour = rem / 3600L
  let min = (rem % 3600L) / 60L
  let sec = rem % 60L
  // Howard Hinnant's civil_from_days algorithm
  let z = days + 719468L
  let era = if z >= 0L { z / 146097L } else { (z - 146096L) / 146097L }
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let mut y = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = doy - (153L * mp + 2L) / 5L + 1L
  let m = if mp < 10L { mp + 3L } else { mp - 9L }
  if m <= 2L {
    y = y + 1L
  }
  sb.write_byte((34).to_byte())
  write_padded_int(sb, y, 4)
  sb.write_byte((45).to_byte())
  write_padded_int(sb, m, 2)
  sb.write_byte((45).to_byte())
  write_padded_int(sb, d, 2)
  sb.write_byte((84).to_byte())
  write_padded_int(sb, hour, 2)
  sb.write_byte((58).to_byte())
  write_padded_int(sb, min, 2)
  sb.write_byte((58).to_byte())
  write_padded_int(sb, sec, 2)
  if nanos > 0 {
    sb.write_byte((46).to_byte())
    if nanos % 1000000 == 0 {
      write_padded_int(sb, (nanos / 1000000).to_int64(), 3)
    } else if nanos % 1000 == 0 {
      write_padded_int(sb, (nanos / 1000).to_int64(), 6)
    } else {
      write_padded_int(sb, nanos.to_int64(), 9)
    }
  }
  sb.write_string("Z\"")
  Ok(())
}

///| Format `google.protobuf.Duration` as JSON string (e.g. `"1.000000005s"`).
fn write_wkt_duration_json(sb : StringBuilder, msg : DynamicMessage) -> Result[Unit, ProtoError] {
  let secs = match get_int64(msg, 1) {
    Some(s) => s
    None => 0L
  }
  let nanos = match get_int32(msg, 2) {
    Some(n) => n
    None => 0
  }
  if secs < -315576000000L || secs > 315576000000L || nanos < -999999999 || nanos > 999999999 {
    return Err(ProtoError::InvalidValue("google.protobuf.Duration out of range"))
  }
  if (secs > 0L && nanos < 0) || (secs < 0L && nanos > 0) {
    return Err(ProtoError::InvalidValue("google.protobuf.Duration mismatched signs"))
  }
  let neg = secs < 0L || nanos < 0
  let abs_s = if secs < 0L { -secs } else { secs }
  let abs_n = if nanos < 0 { -nanos } else { nanos }
  sb.write_byte((34).to_byte())
  if neg {
    sb.write_byte((45).to_byte())
  }
  sb.write_string(abs_s.to_string())
  if abs_n > 0 {
    sb.write_byte((46).to_byte())
    if abs_n % 1000000 == 0 {
      write_padded_int(sb, (abs_n / 1000000).to_int64(), 3)
    } else if abs_n % 1000 == 0 {
      write_padded_int(sb, (abs_n / 1000).to_int64(), 6)
    } else {
      write_padded_int(sb, abs_n.to_int64(), 9)
    }
  }
  sb.write_string("s\"")
  Ok(())
}
