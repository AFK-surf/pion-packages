///| Growable wire format writer with reusable buffer.
pub struct WireWriter {
  mut buf : Bytes
  mut len : Int
}

///|
pub fn WireWriter::new() -> WireWriter {
  WireWriter::{ buf: Bytes::new(64), len: 0 }
}

///|
pub fn WireWriter::with_capacity(cap : Int) -> WireWriter {
  let c = if cap < 16 { 16 } else { cap }
  WireWriter::{ buf: Bytes::new(c), len: 0 }
}

///|
pub fn WireWriter::clear(self : WireWriter) -> Unit {
  self.len = 0
}

///|
pub fn WireWriter::length(self : WireWriter) -> Int {
  self.len
}

///|
pub fn WireWriter::to_bytes(self : WireWriter) -> Bytes {
  self.buf.slice(0, self.len)
}

///|
pub fn WireWriter::write_varint64(self : WireWriter, v : UInt64) -> Unit {
  let _ = self
  let _ = v
}

///|
