///| Low-level zero-copy Protocol Buffers wire format reader and writer.

///| ZigZag encode signed 32-bit integer to unsigned 32-bit (in lower 32 bits of Int64).
pub fn zigzag_encode_i32(n : Int) -> Int64 {
  let n32 = (n.to_int64() << 32) >> 32
  ((n32 << 1) ^ (n32 >> 63)) & 0xFFFFFFFFL
}

///| ZigZag decode unsigned 32-bit integer (in lower 32 bits of Int64) to signed 32-bit Int.
pub fn zigzag_decode_i32(u : Int64) -> Int {
  let u32 = u & 0xFFFFFFFFL
  let v = (u32 >> 1) ^ -(u32 & 1L)
  ((v << 32) >> 32).to_int()
}

///| ZigZag encode signed 64-bit integer to UInt64.
pub fn zigzag_encode_i64(n : Int64) -> UInt64 {
  ((n << 1) ^ (n >> 63)).to_uint64()
}

///| ZigZag decode UInt64 to signed 64-bit Int64.
pub fn zigzag_decode_i64(u : UInt64) -> Int64 {
  (u >> 1).to_int64() ^ -(u & 1UL).to_int64()
}

///| Encoded byte length of a 64-bit varint.
pub fn varint_len_u64(v : UInt64) -> Int {
  if v < 0x80UL {
    1
  } else if v < 0x4000UL {
    2
  } else if v < 0x200000UL {
    3
  } else if v < 0x10000000UL {
    4
  } else if v < 0x800000000UL {
    5
  } else if v < 0x40000000000UL {
    6
  } else if v < 0x2000000000000UL {
    7
  } else if v < 0x100000000000000UL {
    8
  } else if v < 0x8000000000000000UL {
    9
  } else {
    10
  }
}

///| Encoded byte length of a field tag.
pub fn tag_len(field_number : Int) -> Int {
  varint_len_u64((field_number.to_int64().to_uint64()) << 3)
}

///| Validate a field number (1..536870911, optionally rejecting 19000..19999).
pub fn validate_field_number(field_number : Int, reject_reserved : Bool) -> Result[Unit, ProtoError] {
  if field_number <= 0 || field_number > max_field_number {
    return Err(ProtoError::InvalidFieldNumber(field_number, 0))
  }
  if reject_reserved && field_number >= reserved_range_start && field_number <= reserved_range_end {
    return Err(ProtoError::ReservedFieldNumber(field_number, 0))
  }
  Ok(())
}

///| Strict UTF-8 validation over a byte range `[start, start + len)`.
pub fn is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Convert IEEE-754 binary32 bits (in lower 32 bits of Int64) to Double.
pub fn float32_bits_to_double(bits : Int64) -> Double {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return Double::from_bits(sign << 63)
    }
    let mut f = frac
    let mut e64 = 897
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return Double::from_bits((sign << 63) | (e64.to_int64() << 52) | mant)
  }
  if exp == 255 {
    if frac == 0L {
      return Double::from_bits((sign << 63) | (0x7FFL << 52))
    }
    let mant : Int64 = frac << 29
    return Double::from_bits((sign << 63) | (0x7FFL << 52) | mant)
  }
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  Double::from_bits((sign << 63) | (e64 << 52) | mant)
}

///| Convert Double to IEEE-754 binary32 bits (in lower 32 bits of Int64).
pub fn double_to_float32_bits(value : Double) -> Int64 {
  let bits = value.to_bits()
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac : Int64 = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return (sign << 31) | 0x7F800000L
    }
    let payload = (frac >> 29) & 0x7FFFFFL
    let safe_payload = if payload == 0L { 0x400000L } else { payload }
    return (sign << 31) | 0x7F800000L | safe_payload
  }
  if exp == 0 && frac == 0L {
    return sign << 31
  }
  let e = exp - 1023
  if e > 127 {
    return (sign << 31) | 0x7F800000L
  }
  if e >= -126 {
    let mut mant = (frac >> 29) & 0x7FFFFFL
    let rem = frac & 0x1FFFFFFFL
    let half : Int64 = 0x10000000L
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        mant = 0L
        let ne = e + 1
        if ne > 127 {
          return (sign << 31) | 0x7F800000L
        }
        return (sign << 31) | ((ne + 127).to_int64() << 23)
      }
    }
    return (sign << 31) | ((e + 127).to_int64() << 23) | mant
  }
  if e >= -150 {
    let full_sig : Int64 = (1L << 52) | frac
    let shift = -97 - e
    if shift >= 54 {
      return sign << 31
    }
    let mut mant = full_sig >> shift
    let half : Int64 = 1L << (shift - 1)
    let rem = full_sig & ((1L << shift) - 1L)
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        return (sign << 31) | 0x00800000L
      }
    }
    return (sign << 31) | (mant & 0x7FFFFFL)
  }
  sign << 31
}

///| Zero-copy wire format reader over a slice `[start, end)` of `Bytes`.
pub struct WireReader {
  data : Bytes
  mut pos : Int
  end : Int
  reject_reserved : Bool
  strict_utf8 : Bool
}

///|
pub fn WireReader::new(data : Bytes) -> WireReader {
  WireReader::{
    data: data,
    pos: 0,
    end: data.length(),
    reject_reserved: false,
    strict_utf8: true,
  }
}

///|
pub fn WireReader::with_options(data : Bytes, opts : DecodeOptions) -> WireReader {
  WireReader::{
    data: data,
    pos: 0,
    end: data.length(),
    reject_reserved: opts.reject_reserved_field_numbers,
    strict_utf8: opts.strict_utf8,
  }
}

///|
pub fn WireReader::slice(data : Bytes, start : Int, end : Int) -> WireReader {
  let s = if start < 0 { 0 } else if start > data.length() { data.length() } else { start }
  let e = if end < s { s } else if end > data.length() { data.length() } else { end }
  WireReader::{
    data: data,
    pos: s,
    end: e,
    reject_reserved: false,
    strict_utf8: true,
  }
}

///|
pub fn WireReader::pos(self : WireReader) -> Int {
  self.pos
}

///|
pub fn WireReader::remaining(self : WireReader) -> Int {
  self.end - self.pos
}

///|
pub fn WireReader::is_eof(self : WireReader) -> Bool {
  self.pos >= self.end
}

///| Read a 1..10 byte unsigned varint. Strictly rejects >10 bytes or 10th byte > 0x01.
pub fn WireReader::read_varint64(self : WireReader) -> Result[UInt64, ProtoError] {
  let p = self.pos
  let end = self.end
  if p >= end {
    return Err(ProtoError::UnexpectedEof(p))
  }
  let data = self.data
  let b0 = data[p].to_int()
  if b0 < 0x80 {
    self.pos = p + 1
    return Ok(b0.to_int64().to_uint64())
  }
  let mut result : UInt64 = (b0 & 0x7F).to_int64().to_uint64()
  let mut shift = 7
  let mut i = p + 1
  while i < end {
    let b = data[i].to_int()
    if shift == 63 {
      // 10th byte: only 0x00 or 0x01 is valid (bit 63 of UInt64).
      if b > 1 {
        return Err(ProtoError::VarintOverflow(p))
      }
      result = result | (b.to_int64().to_uint64() << 63)
      self.pos = i + 1
      return Ok(result)
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if b < 0x80 {
      self.pos = i + 1
      return Ok(result)
    }
    shift = shift + 7
    i = i + 1
  }
  Err(ProtoError::UnexpectedEof(p))
}

///| Read and validate a Protobuf field tag.
pub fn WireReader::read_tag(self : WireReader) -> Result[Tag, ProtoError] {
  let start = self.pos
  let raw = match self.read_varint64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if raw > 0xFFFFFFFFUL {
    return Err(ProtoError::InvalidFieldNumber(-1, start))
  }
  let wt_code = (raw & 7UL).to_int()
  let wt = match wire_type_from_code(wt_code) {
    Some(w) => w
    None => return Err(ProtoError::InvalidWireType(wt_code, start))
  }
  let field_num = (raw >> 3).to_int()
  if field_num <= 0 || field_num > max_field_number {
    return Err(ProtoError::InvalidFieldNumber(field_num, start))
  }
  if self.reject_reserved && field_num >= reserved_range_start && field_num <= reserved_range_end {
    return Err(ProtoError::ReservedFieldNumber(field_num, start))
  }
  Ok(Tag::{ field_number: field_num, wire_type: wt })
}

///|
pub fn WireReader::read_int32(self : WireReader) -> Result[Int, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok((((v.to_int64() & 0xFFFFFFFFL) << 32) >> 32).to_int())
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_int64(self : WireReader) -> Result[Int64, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok(v.to_int64())
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_uint32(self : WireReader) -> Result[Int64, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok(v.to_int64() & 0xFFFFFFFFL)
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_uint64(self : WireReader) -> Result[UInt64, ProtoError] {
  self.read_varint64()
}

///|
pub fn WireReader::read_sint32(self : WireReader) -> Result[Int, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok(zigzag_decode_i32(v.to_int64() & 0xFFFFFFFFL))
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_sint64(self : WireReader) -> Result[Int64, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok(zigzag_decode_i64(v))
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_bool(self : WireReader) -> Result[Bool, ProtoError] {
  match self.read_varint64() {
    Ok(v) => Ok(v != 0UL)
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_fixed32(self : WireReader) -> Result[Int64, ProtoError] {
  let p = self.pos
  if self.end - p < 4 {
    return Err(ProtoError::UnexpectedEof(p))
  }
  let d = self.data
  let v = d[p].to_int().to_int64() |
  (d[p + 1].to_int().to_int64() << 8) |
  (d[p + 2].to_int().to_int64() << 16) |
  (d[p + 3].to_int().to_int64() << 24)
  self.pos = p + 4
  Ok(v & 0xFFFFFFFFL)
}

///|
pub fn WireReader::read_sfixed32(self : WireReader) -> Result[Int, ProtoError] {
  match self.read_fixed32() {
    Ok(v) => Ok(((v << 32) >> 32).to_int())
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_float(self : WireReader) -> Result[Double, ProtoError] {
  match self.read_fixed32() {
    Ok(bits) => Ok(float32_bits_to_double(bits))
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_fixed64(self : WireReader) -> Result[UInt64, ProtoError] {
  let p = self.pos
  if self.end - p < 8 {
    return Err(ProtoError::UnexpectedEof(p))
  }
  let d = self.data
  let lo = d[p].to_int().to_int64() |
  (d[p + 1].to_int().to_int64() << 8) |
  (d[p + 2].to_int().to_int64() << 16) |
  (d[p + 3].to_int().to_int64() << 24)
  let hi = d[p + 4].to_int().to_int64() |
  (d[p + 5].to_int().to_int64() << 8) |
  (d[p + 6].to_int().to_int64() << 16) |
  (d[p + 7].to_int().to_int64() << 24)
  let v = (lo & 0xFFFFFFFFL) | ((hi & 0xFFFFFFFFL) << 32)
  self.pos = p + 8
  Ok(v.to_uint64())
}

///|
pub fn WireReader::read_sfixed64(self : WireReader) -> Result[Int64, ProtoError] {
  match self.read_fixed64() {
    Ok(v) => Ok(v.to_int64())
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_double(self : WireReader) -> Result[Double, ProtoError] {
  match self.read_fixed64() {
    Ok(bits) => Ok(Double::from_bits(bits.to_int64()))
    Err(e) => Err(e)
  }
}

///| Zero-copy length-delimited range `(start, end)` with immediate OOM/bounds check.
pub fn WireReader::read_bytes_range(self : WireReader) -> Result[(Int, Int), ProtoError] {
  let len_pos = self.pos
  let len_u64 = match self.read_varint64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let rem = self.end - self.pos
  if len_u64 > rem.to_int64().to_uint64() {
    return Err(ProtoError::UnexpectedEof(len_pos))
  }
  let n = len_u64.to_int64().to_int()
  let start = self.pos
  self.pos = start + n
  Ok((start, start + n))
}

///|
pub fn WireReader::read_bytes(self : WireReader) -> Result[Bytes, ProtoError] {
  match self.read_bytes_range() {
    Ok((start, end)) =>
    if start == end {
      Ok(Bytes::new(0))
    } else {
      Ok(self.data.slice(start, end))
    }
    Err(e) => Err(e)
  }
}

///|
pub fn WireReader::read_string(self : WireReader) -> Result[String, ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let n = end - start
  if n == 0 {
    return Ok("")
  }
  if self.strict_utf8 && !is_valid_utf8_range(self.data, start, n) {
    return Err(ProtoError::InvalidUtf8(start))
  }
  Ok(self.data.slice(start, end).to_string())
}

///| Iteratively skip a field (including arbitrarily nested StartGroup/EndGroup up to `max_depth`).
pub fn WireReader::skip_field(self : WireReader, tag : Tag, max_depth : Int) -> Result[Unit, ProtoError] {
  match tag.wire_type {
    Varint =>
    match self.read_varint64() {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    Fixed64 =>
    if self.end - self.pos < 8 {
      Err(ProtoError::UnexpectedEof(self.pos))
    } else {
      self.pos = self.pos + 8
      Ok(())
    }
    LengthDelimited =>
    match self.read_bytes_range() {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    Fixed32 =>
    if self.end - self.pos < 4 {
      Err(ProtoError::UnexpectedEof(self.pos))
    } else {
      self.pos = self.pos + 4
      Ok(())
    }
    EndGroup => Err(ProtoError::UnmatchedGroup(tag.field_number, self.pos))
    StartGroup => {
      if max_depth <= 0 {
        return Err(ProtoError::MaxDepthExceeded(max_depth))
      }
      let stack : Array[Int] = [tag.field_number]
      while stack.length() > 0 {
        if self.is_eof() {
          return Err(ProtoError::UnexpectedEof(self.pos))
        }
        let inner_pos = self.pos
        let inner = match self.read_tag() {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        match inner.wire_type {
          Varint =>
          match self.read_varint64() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          Fixed64 =>
          if self.end - self.pos < 8 {
            return Err(ProtoError::UnexpectedEof(self.pos))
          } else {
            self.pos = self.pos + 8
          }
          LengthDelimited =>
          match self.read_bytes_range() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          Fixed32 =>
          if self.end - self.pos < 4 {
            return Err(ProtoError::UnexpectedEof(self.pos))
          } else {
            self.pos = self.pos + 4
          }
          StartGroup => {
            if stack.length() >= max_depth {
              return Err(ProtoError::MaxDepthExceeded(max_depth))
            }
            stack.push(inner.field_number)
          }
          EndGroup =>
          match stack.pop() {
            Some(expected_num) =>
            if expected_num != inner.field_number {
              return Err(ProtoError::UnmatchedGroup(inner.field_number, inner_pos))
            }
            None => return Err(ProtoError::UnmatchedGroup(inner.field_number, inner_pos))
          }
        }
      }
      Ok(())
    }
  }
}

///|
pub fn WireReader::read_packed_sint64(self : WireReader) -> Result[Array[Int64], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[Int64] = []
  while !sub.is_eof() {
    match sub.read_sint64() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_double(self : WireReader) -> Result[Array[Double], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let n = end - start
  if n % 8 != 0 {
    return Err(ProtoError::UnexpectedEof(end))
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[Double] = []
  while !sub.is_eof() {
    match sub.read_double() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_int32(self : WireReader) -> Result[Array[Int], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[Int] = []
  while !sub.is_eof() {
    match sub.read_int32() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_uint64(self : WireReader) -> Result[Array[UInt64], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[UInt64] = []
  while !sub.is_eof() {
    match sub.read_uint64() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Growable wire format writer with reusable buffer.
pub struct WireWriter {
  mut buf : Bytes
  mut len : Int
}

///|
pub fn WireWriter::new() -> WireWriter {
  WireWriter::{ buf: Bytes::new(64), len: 0 }
}

///|
pub fn WireWriter::with_capacity(cap : Int) -> WireWriter {
  let c = if cap < 16 { 16 } else { cap }
  WireWriter::{ buf: Bytes::new(c), len: 0 }
}

///|
pub fn WireWriter::clear(self : WireWriter) -> Unit {
  self.len = 0
}

///|
pub fn WireWriter::length(self : WireWriter) -> Int {
  self.len
}

///|
pub fn WireWriter::to_bytes(self : WireWriter) -> Bytes {
  if self.len == 0 {
    return Bytes::new(0)
  }
  self.buf.slice(0, self.len)
}

///|
fn WireWriter::ensure_cap(self : WireWriter, extra : Int) -> Unit {
  let needed = self.len + extra
  let cur_cap = self.buf.length()
  if needed <= cur_cap {
    return
  }
  let mut new_cap = if cur_cap < 16 { 16 } else { cur_cap }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let next = Bytes::new(new_cap)
  let old = self.buf
  let n = self.len
  let mut i = 0
  while i < n {
    next[i] = old[i]
    i = i + 1
  }
  self.buf = next
}

///|
pub fn WireWriter::write_varint64(self : WireWriter, v : UInt64) -> Unit {
  self.ensure_cap(10)
  let b = self.buf
  let mut p = self.len
  if v < 0x80UL {
    b[p] = v.to_int64().to_int().to_byte()
    self.len = p + 1
    return
  }
  let mut x = v
  while x >= 0x80UL {
    b[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  b[p] = x.to_int64().to_int().to_byte()
  self.len = p + 1
}

///|
pub fn WireWriter::write_tag(self : WireWriter, field_number : Int, wire_type : WireType) -> Unit {
  let tag_val = (field_number.to_int64().to_uint64() << 3) | wire_type_code(wire_type).to_int64().to_uint64()
  self.write_varint64(tag_val)
}

///|
pub fn WireWriter::write_int32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  let v64 = ((v.to_int64() << 32) >> 32).to_uint64()
  self.write_varint64(v64)
}

///|
pub fn WireWriter::write_int64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64(v.to_uint64())
}

///|
pub fn WireWriter::write_uint32_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64((v & 0xFFFFFFFFL).to_uint64())
}

///|
pub fn WireWriter::write_uint64_field(self : WireWriter, field_number : Int, v : UInt64) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64(v)
}

///|
pub fn WireWriter::write_sint32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64(zigzag_encode_i32(v).to_uint64())
}

///|
pub fn WireWriter::write_sint64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64(zigzag_encode_i64(v))
}

///|
pub fn WireWriter::write_bool_field(self : WireWriter, field_number : Int, v : Bool) -> Unit {
  self.write_tag(field_number, WireType::Varint)
  self.write_varint64(if v { 1UL } else { 0UL })
}

///|
pub fn WireWriter::write_fixed32(self : WireWriter, v : Int64) -> Unit {
  self.ensure_cap(4)
  let b = self.buf
  let p = self.len
  b[p] = (v & 0xFFL).to_int().to_byte()
  b[p + 1] = ((v >> 8) & 0xFFL).to_int().to_byte()
  b[p + 2] = ((v >> 16) & 0xFFL).to_int().to_byte()
  b[p + 3] = ((v >> 24) & 0xFFL).to_int().to_byte()
  self.len = p + 4
}

///|
pub fn WireWriter::write_fixed32_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(v)
}

///|
pub fn WireWriter::write_sfixed32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(v.to_int64() & 0xFFFFFFFFL)
}

///|
pub fn WireWriter::write_float_field(self : WireWriter, field_number : Int, v : Double) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(double_to_float32_bits(v))
}

///|
pub fn WireWriter::write_fixed64(self : WireWriter, v : UInt64) -> Unit {
  self.ensure_cap(8)
  let b = self.buf
  let p = self.len
  let x = v.to_int64()
  b[p] = (x & 0xFFL).to_int().to_byte()
  b[p + 1] = ((x >> 8) & 0xFFL).to_int().to_byte()
  b[p + 2] = ((x >> 16) & 0xFFL).to_int().to_byte()
  b[p + 3] = ((x >> 24) & 0xFFL).to_int().to_byte()
  b[p + 4] = ((x >> 32) & 0xFFL).to_int().to_byte()
  b[p + 5] = ((x >> 40) & 0xFFL).to_int().to_byte()
  b[p + 6] = ((x >> 48) & 0xFFL).to_int().to_byte()
  b[p + 7] = ((x >> 56) & 0xFFL).to_int().to_byte()
  self.len = p + 8
}

///|
pub fn WireWriter::write_fixed64_field(self : WireWriter, field_number : Int, v : UInt64) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v)
}

///|
pub fn WireWriter::write_sfixed64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v.to_uint64())
}

///|
pub fn WireWriter::write_double_field(self : WireWriter, field_number : Int, v : Double) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v.to_bits().to_uint64())
}

///|
pub fn WireWriter::write_raw_bytes(self : WireWriter, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  self.ensure_cap(n)
  let dst = self.buf
  let base = self.len
  let mut i = 0
  while i < n {
    dst[base + i] = src[i]
    i = i + 1
  }
  self.len = base + n
}

///|
pub fn WireWriter::write_raw_slice(self : WireWriter, src : Bytes, start : Int, end : Int) -> Unit {
  let n = end - start
  if n <= 0 {
    return
  }
  self.ensure_cap(n)
  let dst = self.buf
  let base = self.len
  let mut i = 0
  while i < n {
    dst[base + i] = src[start + i]
    i = i + 1
  }
  self.len = base + n
}

///|
pub fn WireWriter::write_bytes_field(self : WireWriter, field_number : Int, b : Bytes) -> Unit {
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(b.length().to_int64().to_uint64())
  self.write_raw_bytes(b)
}

///|
pub fn WireWriter::write_string_field(self : WireWriter, field_number : Int, s : String) -> Unit {
  let b = s.to_bytes()
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(b.length().to_int64().to_uint64())
  self.write_raw_bytes(b)
}

///|
pub fn WireWriter::write_packed_sint64_field(self : WireWriter, field_number : Int, vals : Array[Int64]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    payload_len = payload_len + varint_len_u64(zigzag_encode_i64(vals[i]))
    i = i + 1
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  i = 0
  while i < n {
    self.write_varint64(zigzag_encode_i64(vals[i]))
    i = i + 1
  }
}

///|
pub fn WireWriter::write_packed_double_field(self : WireWriter, field_number : Int, vals : Array[Double]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let payload_len = n * 8
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  let mut i = 0
  while i < n {
    self.write_fixed64(vals[i].to_bits().to_uint64())
    i = i + 1
  }
}

///|
pub fn WireWriter::write_packed_int32_field(self : WireWriter, field_number : Int, vals : Array[Int]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    let v64 = ((vals[i].to_int64() << 32) >> 32).to_uint64()
    payload_len = payload_len + varint_len_u64(v64)
    i = i + 1
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  i = 0
  while i < n {
    let v64 = ((vals[i].to_int64() << 32) >> 32).to_uint64()
    self.write_varint64(v64)
    i = i + 1
  }
}

///|
pub fn WireWriter::write_packed_uint64_field(self : WireWriter, field_number : Int, vals : Array[UInt64]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    payload_len = payload_len + varint_len_u64(vals[i])
    i = i + 1
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  i = 0
  while i < n {
    self.write_varint64(vals[i])
    i = i + 1
  }
}
