///| Low-level zero-copy Protocol Buffers wire format reader and writer.

///| ZigZag encode signed 32-bit integer to unsigned 32-bit (in lower 32 bits of Int64).
#verify
pub fn zigzag_encode_i32(n : Int) -> Int64 {
  let n32 = (n.to_int64() << 32) >> 32
  ((n32 << 1) ^ (n32 >> 63)) & 0xFFFFFFFFL
}

///| ZigZag decode unsigned 32-bit integer (in lower 32 bits of Int64) to signed 32-bit Int.
#verify
pub fn zigzag_decode_i32(u : Int64) -> Int {
  let u32 = u & 0xFFFFFFFFL
  let v = (u32 >> 1) ^ -(u32 & 1L)
  ((v << 32) >> 32).to_int()
}

///| ZigZag encode signed 64-bit integer to UInt64.
#verify
pub fn zigzag_encode_i64(n : Int64) -> UInt64 {
  ((n << 1) ^ (n >> 63)).to_uint64()
}

///| ZigZag decode UInt64 to signed 64-bit Int64.
#verify
pub fn zigzag_decode_i64(u : UInt64) -> Int64 {
  (u >> 1).to_int64() ^ -(u & 1UL).to_int64()
}

///| Encoded byte length of a 64-bit varint.
#verify
pub fn varint_len_u64(v : UInt64) -> Int {
  if v < 0x80UL {
    1
  } else if v < 0x4000UL {
    2
  } else if v < 0x200000UL {
    3
  } else if v < 0x10000000UL {
    4
  } else if v < 0x800000000UL {
    5
  } else if v < 0x40000000000UL {
    6
  } else if v < 0x2000000000000UL {
    7
  } else if v < 0x100000000000000UL {
    8
  } else if v < 0x8000000000000000UL {
    9
  } else {
    10
  }
}

///| Encode a Protobuf field tag as `(field_number << 3) | wire_type_code`.
#verify
pub fn encode_tag_raw(field_number : Int, wire_type : WireType) -> UInt64 {
  let wt = wire_type_code(wire_type)
  (field_number.to_int64().to_uint64() << 3) | wt.to_int64().to_uint64()
}

///| Extract the 3-bit wire type code from a raw tag varint.
#verify
pub fn decode_tag_wire_type(raw : UInt64) -> Int {
  (raw & 7UL).to_int()
}

///| Extract the field number from a raw tag varint.
#verify
pub fn decode_tag_field_num(raw : UInt64) -> Int {
  (raw >> 3).to_int()
}

///| Encoded byte length of a field tag.
pub fn tag_len(field_number : Int) -> Int {
  varint_len_u64((field_number.to_int64().to_uint64()) << 3)
}

///| Pure field-number validator returning 0=ok, 1=invalid (<=0 or >536870911), 2=reserved (19000..19999).
pub fn field_number_err_code(field_number : Int, reject_reserved : Bool) -> Int {
  if field_number <= 0 || field_number > 536870911 {
    return 1
  }
  if reject_reserved && field_number >= 19000 && field_number <= 19999 {
    return 2
  }
  0
}

///| Validate a field number (1..536870911, optionally rejecting 19000..19999).
pub fn validate_field_number(field_number : Int, reject_reserved : Bool) -> Result[Unit, ProtoError] {
  let code = field_number_err_code(field_number, reject_reserved)
  if code == 1 {
    return Err(ProtoError::InvalidFieldNumber(field_number, 0))
  }
  if code == 2 {
    return Err(ProtoError::ReservedFieldNumber(field_number, 0))
  }
  Ok(())
}

///| Shared empty Bytes singleton to avoid zero-length heap allocations.
let empty_bytes : Bytes = Bytes::new(0)

///| Strict UTF-8 validation over a byte range `[start, start + len)`.
pub fn is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i + 4 <= end {
        let c0 = data[i].to_int()
        let c1 = data[i + 1].to_int()
        let c2 = data[i + 2].to_int()
        let c3 = data[i + 3].to_int()
        if (c0 | c1 | c2 | c3) < 0x80 {
          i = i + 4
        } else {
          break
        }
      }
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Convert IEEE-754 binary32 bits (in lower 32 bits of Int64) to Double.
pub fn float32_bits_to_double(bits : Int64) -> Double {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return Double::from_bits(sign << 63)
    }
    let mut f = frac
    let mut e64 = 897
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return Double::from_bits((sign << 63) | (e64.to_int64() << 52) | mant)
  }
  if exp == 255 {
    if frac == 0L {
      return Double::from_bits((sign << 63) | (0x7FFL << 52))
    }
    let mant : Int64 = frac << 29
    return Double::from_bits((sign << 63) | (0x7FFL << 52) | mant)
  }
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  Double::from_bits((sign << 63) | (e64 << 52) | mant)
}

///| Convert Double to IEEE-754 binary32 bits (in lower 32 bits of Int64).
pub fn double_to_float32_bits(value : Double) -> Int64 {
  let bits = value.to_bits()
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac : Int64 = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return (sign << 31) | 0x7F800000L
    }
    let payload = (frac >> 29) & 0x7FFFFFL
    let safe_payload = if payload == 0L { 0x400000L } else { payload }
    return (sign << 31) | 0x7F800000L | safe_payload
  }
  if exp == 0 && frac == 0L {
    return sign << 31
  }
  let e = exp - 1023
  if e > 127 {
    return (sign << 31) | 0x7F800000L
  }
  if e >= -126 {
    let mut mant = (frac >> 29) & 0x7FFFFFL
    let rem = frac & 0x1FFFFFFFL
    let half : Int64 = 0x10000000L
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        mant = 0L
        let ne = e + 1
        if ne > 127 {
          return (sign << 31) | 0x7F800000L
        }
        return (sign << 31) | ((ne + 127).to_int64() << 23)
      }
    }
    return (sign << 31) | ((e + 127).to_int64() << 23) | mant
  }
  if e >= -150 {
    let full_sig : Int64 = (1L << 52) | frac
    let shift = -97 - e
    if shift >= 54 {
      return sign << 31
    }
    let mut mant = full_sig >> shift
    let half : Int64 = 1L << (shift - 1)
    let rem = full_sig & ((1L << shift) - 1L)
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        return (sign << 31) | 0x00800000L
      }
    }
    return (sign << 31) | (mant & 0x7FFFFFL)
  }
  sign << 31
}

///| Zero-copy wire format reader over a slice `[start, end)` of `Bytes`.
pub struct WireReader {
  data : Bytes
  data_str : String
  has_data_str : Bool
  mut pos : Int
  mut end : Int
  reject_reserved : Bool
  strict_utf8 : Bool
  mut err_code : Int
  mut err_arg1 : Int
  mut err_arg2 : Int
}

///|
pub fn WireReader::new(data : Bytes) -> WireReader {
  WireReader::{
    data: data,
    data_str: "",
    has_data_str: false,
    pos: 0,
    end: data.length(),
    reject_reserved: false,
    strict_utf8: true,
    err_code: 0,
    err_arg1: 0,
    err_arg2: 0,
  }
}

///|
pub fn WireReader::with_options(data : Bytes, opts : DecodeOptions) -> WireReader {
  WireReader::{
    data: data,
    data_str: "",
    has_data_str: false,
    pos: 0,
    end: data.length(),
    reject_reserved: opts.reject_reserved_field_numbers,
    strict_utf8: opts.strict_utf8,
    err_code: 0,
    err_arg1: 0,
    err_arg2: 0,
  }
}

///|
pub fn WireReader::slice(data : Bytes, start : Int, end : Int) -> WireReader {
  let s = if start < 0 { 0 } else if start > data.length() { data.length() } else { start }
  let e = if end < s { s } else if end > data.length() { data.length() } else { end }
  WireReader::{
    data: data,
    data_str: "",
    has_data_str: false,
    pos: s,
    end: e,
    reject_reserved: false,
    strict_utf8: true,
    err_code: 0,
    err_arg1: 0,
    err_arg2: 0,
  }
}

///| Zero-copy slice reader with a pre-converted `String` view for fast string field slicing.
pub fn WireReader::slice_with_str(data : Bytes, data_str : String, start : Int, end : Int) -> WireReader {
  let s = if start < 0 { 0 } else if start > data.length() { data.length() } else { start }
  let e = if end < s { s } else if end > data.length() { data.length() } else { end }
  WireReader::{
    data: data,
    data_str: data_str,
    has_data_str: true,
    pos: s,
    end: e,
    reject_reserved: false,
    strict_utf8: true,
    err_code: 0,
    err_arg1: 0,
    err_arg2: 0,
  }
}

///|
pub fn WireReader::pos(self : WireReader) -> Int {
  self.pos
}

///|
pub fn WireReader::limit(self : WireReader) -> Int {
  self.end
}

///|
pub fn WireReader::set_limit(self : WireReader, new_end : Int) -> Unit {
  self.end = new_end
}

///| Reset reader window to `[start, end)` on the same backing `Bytes`, clearing any recorded error.
pub fn WireReader::reset_slice(self : WireReader, start : Int, end : Int) -> Unit {
  let dl = self.data.length()
  let s = if start < 0 { 0 } else if start > dl { dl } else { start }
  let e = if end < s { s } else if end > dl { dl } else { end }
  self.pos = s
  self.end = e
  self.err_code = 0
}

///|
pub fn WireReader::remaining(self : WireReader) -> Int {
  self.end - self.pos
}

///|
pub fn WireReader::is_eof(self : WireReader) -> Bool {
  self.pos >= self.end
}

///| Check whether the last `*_raw` operation recorded an error.
pub fn WireReader::has_err(self : WireReader) -> Bool {
  self.err_code != 0
}

///| Clear any recorded `*_raw` error state.
pub fn WireReader::clear_err(self : WireReader) -> Unit {
  self.err_code = 0
}

///| Materialize the recorded `*_raw` error as a `ProtoError` (allocates only on error).
pub fn WireReader::take_err(self : WireReader) -> Option[ProtoError] {
  let code = self.err_code
  if code == 0 {
    return Option::None
  }
  self.err_code = 0
  let a1 = self.err_arg1
  let a2 = self.err_arg2
  match code {
    1 => Option::Some(ProtoError::UnexpectedEof(a1))
    2 => Option::Some(ProtoError::VarintOverflow(a1))
    3 => Option::Some(ProtoError::InvalidWireType(a1, a2))
    4 => Option::Some(ProtoError::InvalidFieldNumber(a1, a2))
    5 => Option::Some(ProtoError::ReservedFieldNumber(a1, a2))
    6 => Option::Some(ProtoError::InvalidUtf8(a1))
    7 => Option::Some(ProtoError::UnmatchedGroup(a1, a2))
    8 => Option::Some(ProtoError::MaxDepthExceeded(a1))
    _ => Option::Some(ProtoError::UnexpectedEof(a1))
  }
}

///| Internal error materializer when `err_code != 0`.
fn WireReader::err_value(self : WireReader) -> ProtoError {
  let code = self.err_code
  self.err_code = 0
  let a1 = self.err_arg1
  let a2 = self.err_arg2
  match code {
    1 => ProtoError::UnexpectedEof(a1)
    2 => ProtoError::VarintOverflow(a1)
    3 => ProtoError::InvalidWireType(a1, a2)
    4 => ProtoError::InvalidFieldNumber(a1, a2)
    5 => ProtoError::ReservedFieldNumber(a1, a2)
    6 => ProtoError::InvalidUtf8(a1)
    7 => ProtoError::UnmatchedGroup(a1, a2)
    8 => ProtoError::MaxDepthExceeded(a1)
    _ => ProtoError::UnexpectedEof(a1)
  }
}

///| Unboxed varint64 decode. On error sets `self.err_code != 0` and returns `0UL`.
pub fn WireReader::read_varint64_raw(self : WireReader) -> UInt64 {
  let p = self.pos
  let end = self.end
  if p >= end {
    self.err_code = 1
    self.err_arg1 = p
    return 0UL
  }
  let data = self.data
  let b0 = data[p].to_int()
  if b0 < 0x80 {
    self.pos = p + 1
    return b0.to_int64().to_uint64()
  }
  if p + 1 < end {
    let b1 = data[p + 1].to_int()
    if b1 < 0x80 {
      self.pos = p + 2
      return ((b0 & 0x7F) | (b1 << 7)).to_int64().to_uint64()
    }
    if p + 9 <= end {
      let b2 = data[p + 2].to_int()
      let mut res : UInt64 = ((b0 & 0x7F) | ((b1 & 0x7F) << 7) | ((b2 & 0x7F) << 14)).to_int64().to_uint64()
      if b2 < 0x80 {
        self.pos = p + 3
        return res
      }
      let b3 = data[p + 3].to_int()
      res = res | ((b3 & 0x7F).to_int64().to_uint64() << 21)
      if b3 < 0x80 {
        self.pos = p + 4
        return res
      }
      let b4 = data[p + 4].to_int()
      res = res | ((b4 & 0x7F).to_int64().to_uint64() << 28)
      if b4 < 0x80 {
        self.pos = p + 5
        return res
      }
      let b5 = data[p + 5].to_int()
      res = res | ((b5 & 0x7F).to_int64().to_uint64() << 35)
      if b5 < 0x80 {
        self.pos = p + 6
        return res
      }
      let b6 = data[p + 6].to_int()
      res = res | ((b6 & 0x7F).to_int64().to_uint64() << 42)
      if b6 < 0x80 {
        self.pos = p + 7
        return res
      }
      let b7 = data[p + 7].to_int()
      res = res | ((b7 & 0x7F).to_int64().to_uint64() << 49)
      if b7 < 0x80 {
        self.pos = p + 8
        return res
      }
      let b8 = data[p + 8].to_int()
      res = res | ((b8 & 0x7F).to_int64().to_uint64() << 56)
      if b8 < 0x80 {
        self.pos = p + 9
        return res
      }
      if p + 10 <= end {
        let b9 = data[p + 9].to_int()
        if b9 > 1 {
          self.err_code = 2
          self.err_arg1 = p
          return 0UL
        }
        self.pos = p + 10
        return res | (b9.to_int64().to_uint64() << 63)
      }
      self.err_code = 1
      self.err_arg1 = p
      return 0UL
    }
  }
  let mut result : UInt64 = (b0 & 0x7F).to_int64().to_uint64()
  let mut shift = 7
  let mut i = p + 1
  while i < end {
    let b = data[i].to_int()
    if shift == 63 {
      if b > 1 {
        self.err_code = 2
        self.err_arg1 = p
        return 0UL
      }
      result = result | (b.to_int64().to_uint64() << 63)
      self.pos = i + 1
      return result
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if b < 0x80 {
      self.pos = i + 1
      return result
    }
    shift = shift + 7
    i = i + 1
  }
  self.err_code = 1
  self.err_arg1 = p
  0UL
}

///| Read a 1..10 byte unsigned varint. Strictly rejects >10 bytes or 10th byte > 0x01.
pub fn WireReader::read_varint64(self : WireReader) -> Result[UInt64, ProtoError] {
  self.err_code = 0
  let v = self.read_varint64_raw()
  if self.err_code != 0 {
    return Err(self.err_value())
  }
  Ok(v)
}

///| Unboxed tag decode: returns `(field_number << 3) | wire_type_code` (>= 0), or `-1L` on error.
pub fn WireReader::read_tag_raw(self : WireReader) -> Int64 {
  let start = self.pos
  if start >= self.end {
    self.err_code = 1
    self.err_arg1 = start
    return -1L
  }
  let b0 = self.data[start].to_int()
  if b0 < 0x80 {
    self.pos = start + 1
    let wt_code = b0 & 7
    if wt_code > 5 {
      self.err_code = 3
      self.err_arg1 = wt_code
      self.err_arg2 = start
      return -1L
    }
    let field_num = b0 >> 3
    if field_num <= 0 {
      self.err_code = 4
      self.err_arg1 = field_num
      self.err_arg2 = start
      return -1L
    }
    return b0.to_int64()
  }
  self.err_code = 0
  let raw = self.read_varint64_raw()
  if self.err_code != 0 {
    return -1L
  }
  if raw > 0xFFFFFFFFUL {
    self.err_code = 4
    self.err_arg1 = -1
    self.err_arg2 = start
    return -1L
  }
  let wt_code = (raw & 7UL).to_int()
  if wt_code > 5 {
    self.err_code = 3
    self.err_arg1 = wt_code
    self.err_arg2 = start
    return -1L
  }
  let field_num = (raw >> 3).to_int()
  if field_num <= 0 || field_num > max_field_number {
    self.err_code = 4
    self.err_arg1 = field_num
    self.err_arg2 = start
    return -1L
  }
  if self.reject_reserved && field_num >= reserved_range_start && field_num <= reserved_range_end {
    self.err_code = 5
    self.err_arg1 = field_num
    self.err_arg2 = start
    return -1L
  }
  raw.to_int64()
}

///| Read and validate a Protobuf field tag.
pub fn WireReader::read_tag(self : WireReader) -> Result[Tag, ProtoError] {
  let raw = self.read_tag_raw()
  if raw < 0L {
    return Err(self.err_value())
  }
  let wt_code = (raw & 7L).to_int()
  let wt = match wt_code {
    0 => WireType::Varint
    1 => WireType::Fixed64
    2 => WireType::LengthDelimited
    3 => WireType::StartGroup
    4 => WireType::EndGroup
    _ => WireType::Fixed32
  }
  Ok(Tag::{ field_number: (raw >> 3).to_int(), wire_type: wt })
}

///| Unboxed int32 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_int32_raw(self : WireReader) -> Int {
  let p = self.pos
  if p < self.end {
    let b0 = self.data[p].to_int()
    if b0 < 0x80 {
      self.pos = p + 1
      return b0
    }
  }
  let v = self.read_varint64_raw()
  (((v.to_int64() & 0xFFFFFFFFL) << 32) >> 32).to_int()
}

///| Unboxed int64 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_int64_raw(self : WireReader) -> Int64 {
  let p = self.pos
  if p < self.end {
    let b0 = self.data[p].to_int()
    if b0 < 0x80 {
      self.pos = p + 1
      return b0.to_int64()
    }
  }
  self.read_varint64_raw().to_int64()
}

///| Unboxed uint32 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_uint32_raw(self : WireReader) -> Int64 {
  self.read_varint64_raw().to_int64() & 0xFFFFFFFFL
}

///| Unboxed uint64 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_uint64_raw(self : WireReader) -> UInt64 {
  self.read_varint64_raw()
}

///| Unboxed sint32 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_sint32_raw(self : WireReader) -> Int {
  zigzag_decode_i32(self.read_varint64_raw().to_int64() & 0xFFFFFFFFL)
}

///| Unboxed sint64 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_sint64_raw(self : WireReader) -> Int64 {
  zigzag_decode_i64(self.read_varint64_raw())
}

///| Unboxed bool decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_bool_raw(self : WireReader) -> Bool {
  self.read_varint64_raw() != 0UL
}

///| Unboxed fixed32 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_fixed32_raw(self : WireReader) -> Int64 {
  let p = self.pos
  if self.end - p < 4 {
    self.err_code = 1
    self.err_arg1 = p
    return 0L
  }
  let d = self.data
  let v = d[p].to_int().to_int64() |
  (d[p + 1].to_int().to_int64() << 8) |
  (d[p + 2].to_int().to_int64() << 16) |
  (d[p + 3].to_int().to_int64() << 24)
  self.pos = p + 4
  v & 0xFFFFFFFFL
}

///| Unboxed fixed64 decode. Sets `self.err_code != 0` on error.
pub fn WireReader::read_fixed64_raw(self : WireReader) -> UInt64 {
  let p = self.pos
  if self.end - p < 8 {
    self.err_code = 1
    self.err_arg1 = p
    return 0UL
  }
  let d = self.data
  let lo = d[p].to_int().to_int64() |
  (d[p + 1].to_int().to_int64() << 8) |
  (d[p + 2].to_int().to_int64() << 16) |
  (d[p + 3].to_int().to_int64() << 24)
  let hi = d[p + 4].to_int().to_int64() |
  (d[p + 5].to_int().to_int64() << 8) |
  (d[p + 6].to_int().to_int64() << 16) |
  (d[p + 7].to_int().to_int64() << 24)
  self.pos = p + 8
  ((lo & 0xFFFFFFFFL) | ((hi & 0xFFFFFFFFL) << 32)).to_uint64()
}

///| Read length prefix for a length-delimited field, checking bounds.
///| Leaves `self.pos` at the start of the payload and returns payload length `>= 0`, or `-1` on error.
pub fn WireReader::read_len_raw(self : WireReader) -> Int {
  let len_pos = self.pos
  if len_pos >= self.end {
    self.err_code = 1
    self.err_arg1 = len_pos
    return -1
  }
  let b0 = self.data[len_pos].to_int()
  if b0 < 0x80 {
    let start = len_pos + 1
    if b0 > self.end - start {
      self.err_code = 1
      self.err_arg1 = len_pos
      return -1
    }
    self.pos = start
    return b0
  }
  self.err_code = 0
  let len_u64 = self.read_varint64_raw()
  if self.err_code != 0 {
    return -1
  }
  let rem = self.end - self.pos
  if len_u64 > rem.to_int64().to_uint64() {
    self.err_code = 1
    self.err_arg1 = len_pos
    return -1
  }
  len_u64.to_int64().to_int()
}

///| Unboxed bytes field decode. Returns empty bytes and sets `self.err_code != 0` on error.
pub fn WireReader::read_bytes_raw(self : WireReader) -> Bytes {
  let len_pos = self.pos
  if len_pos >= self.end {
    self.err_code = 1
    self.err_arg1 = len_pos
    return empty_bytes
  }
  let b0 = self.data[len_pos].to_int()
  if b0 < 0x80 {
    let start = len_pos + 1
    if b0 > self.end - start {
      self.err_code = 1
      self.err_arg1 = len_pos
      return empty_bytes
    }
    self.pos = start + b0
    if b0 == 0 {
      return empty_bytes
    }
    return self.data.slice(start, start + b0)
  }
  let n = self.read_len_raw()
  if n <= 0 {
    return empty_bytes
  }
  let start = self.pos
  self.pos = start + n
  self.data.slice(start, start + n)
}

///| Unboxed UTF-8 string field decode. Returns `""` and sets `self.err_code != 0` on error.
pub fn WireReader::read_string_raw(self : WireReader) -> String {
  let len_pos = self.pos
  if len_pos >= self.end {
    self.err_code = 1
    self.err_arg1 = len_pos
    return ""
  }
  let data = self.data
  let b0 = data[len_pos].to_int()
  let mut start = 0
  let mut n = 0
  if b0 < 0x80 {
    start = len_pos + 1
    if b0 > self.end - start {
      self.err_code = 1
      self.err_arg1 = len_pos
      return ""
    }
    n = b0
    self.pos = start + n
  } else {
    n = self.read_len_raw()
    if n < 0 {
      return ""
    }
    start = self.pos
    self.pos = start + n
  }
  if n == 0 {
    return ""
  }
  let end = start + n
  if self.strict_utf8 {
    let mut i = start
    let mut ascii_ok = true
    while i + 4 <= end {
      let c0 = data[i].to_int()
      let c1 = data[i + 1].to_int()
      let c2 = data[i + 2].to_int()
      let c3 = data[i + 3].to_int()
      if (c0 | c1 | c2 | c3) < 0x80 {
        i = i + 4
      } else {
        ascii_ok = false
        break
      }
    }
    if ascii_ok {
      while i < end {
        if data[i].to_int() >= 0x80 {
          ascii_ok = false
          break
        }
        i = i + 1
      }
    }
    if !ascii_ok && !is_valid_utf8_range(data, i, end - i) {
      self.err_code = 6
      self.err_arg1 = start
      return ""
    }
  }
  if self.has_data_str {
    self.data_str.slice(start, end)
  } else {
    data.slice(start, end).to_string()
  }
}

///| Unboxed field skip using `raw_tag = (field_number << 3) | wire_type_code`.
///| Returns `true` on success, `false` on error (with `self.err_code != 0`).
pub fn WireReader::skip_field_raw(self : WireReader, raw_tag : Int64, max_depth : Int) -> Bool {
  let wt = (raw_tag & 7L).to_int()
  if wt == 0 {
    let _ = self.read_varint64_raw()
    return self.err_code == 0
  }
  if wt == 1 {
    if self.end - self.pos < 8 {
      self.err_code = 1
      self.err_arg1 = self.pos
      return false
    }
    self.pos = self.pos + 8
    return true
  }
  if wt == 2 {
    let n = self.read_len_raw()
    if n < 0 {
      return false
    }
    self.pos = self.pos + n
    return true
  }
  if wt == 5 {
    if self.end - self.pos < 4 {
      self.err_code = 1
      self.err_arg1 = self.pos
      return false
    }
    self.pos = self.pos + 4
    return true
  }
  let fnum = (raw_tag >> 3).to_int()
  if wt == 4 {
    self.err_code = 7
    self.err_arg1 = fnum
    self.err_arg2 = self.pos
    return false
  }
  // StartGroup (wt == 3)
  if max_depth <= 0 {
    self.err_code = 8
    self.err_arg1 = max_depth
    return false
  }
  let stack : Array[Int] = [fnum]
  while stack.length() > 0 {
    if self.pos >= self.end {
      self.err_code = 1
      self.err_arg1 = self.pos
      return false
    }
    let inner_pos = self.pos
    let inner = self.read_tag_raw()
    if inner < 0L {
      return false
    }
    let iwt = (inner & 7L).to_int()
    if iwt == 0 {
      let _ = self.read_varint64_raw()
      if self.err_code != 0 {
        return false
      }
    } else if iwt == 1 {
      if self.end - self.pos < 8 {
        self.err_code = 1
        self.err_arg1 = self.pos
        return false
      }
      self.pos = self.pos + 8
    } else if iwt == 2 {
      let n = self.read_len_raw()
      if n < 0 {
        return false
      }
      self.pos = self.pos + n
    } else if iwt == 5 {
      if self.end - self.pos < 4 {
        self.err_code = 1
        self.err_arg1 = self.pos
        return false
      }
      self.pos = self.pos + 4
    } else if iwt == 3 {
      if stack.length() >= max_depth {
        self.err_code = 8
        self.err_arg1 = max_depth
        return false
      }
      stack.push((inner >> 3).to_int())
    } else {
      let ifnum = (inner >> 3).to_int()
      match stack.pop() {
        Some(expected_num) =>
        if expected_num != ifnum {
          self.err_code = 7
          self.err_arg1 = ifnum
          self.err_arg2 = inner_pos
          return false
        }
        None => {
          self.err_code = 7
          self.err_arg1 = ifnum
          self.err_arg2 = inner_pos
          return false
        }
      }
    }
  }
  true
}

///|
pub fn WireReader::read_int32(self : WireReader) -> Result[Int, ProtoError] {
  self.err_code = 0
  let v = self.read_int32_raw()
  if self.err_code != 0 {
    return Err(self.err_value())
  }
  Ok(v)
}

///|
pub fn WireReader::read_int64(self : WireReader) -> Result[Int64, ProtoError] {
