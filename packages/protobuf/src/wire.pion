///| Zero-copy length-delimited range `(start, end)` with immediate OOM/bounds check.
pub fn WireReader::read_bytes_range(self : WireReader) -> Result[(Int, Int), ProtoError] {
  let n = self.read_len_raw()
  if n < 0 {
    return Err(self.err_value())
  }
  let start = self.pos
  self.pos = start + n
  Ok((start, start + n))
}

///|
pub fn WireReader::read_bytes(self : WireReader) -> Result[Bytes, ProtoError] {
  self.err_code = 0
  let b = self.read_bytes_raw()
  if self.err_code != 0 {
    return Err(self.err_value())
  }
  Ok(b)
}

///|
pub fn WireReader::read_string(self : WireReader) -> Result[String, ProtoError] {
  self.err_code = 0
  let s = self.read_string_raw()
  if self.err_code != 0 {
    return Err(self.err_value())
  }
  Ok(s)
}

///| Iteratively skip a field (including arbitrarily nested StartGroup/EndGroup up to `max_depth`).
pub fn WireReader::skip_field(self : WireReader, tag : Tag, max_depth : Int) -> Result[Unit, ProtoError] {
  let raw_tag = (tag.field_number.to_int64() << 3) | wire_type_code(tag.wire_type).to_int64()
  self.err_code = 0
  if !self.skip_field_raw(raw_tag, max_depth) {
    return Err(self.err_value())
  }
  Ok(())
}

///|
pub fn WireReader::read_packed_sint64(self : WireReader) -> Result[Array[Int64], ProtoError] {
  let n = self.read_len_raw()
  if n < 0 {
    return Err(self.err_value())
  }
  let start = self.pos
  let end = start + n
  self.pos = end
  let d = self.data
  let init_cap = if n > 16 { n / 3 } else { n }
  let out : Array[Int64] = Array::with_capacity(init_cap)
  let mut p = start
  while p < end {
    let b0 = d[p].to_int()
    if b0 < 0x80 {
      p = p + 1
      let u = b0.to_int64().to_uint64()
      out.push((u >> 1).to_int64() ^ -(u & 1UL).to_int64())
      continue
    }
    if p + 3 < end {
      let b1 = d[p + 1].to_int()
      if b1 < 0x80 {
        p = p + 2
        let u = ((b0 & 0x7F) | (b1 << 7)).to_int64().to_uint64()
        out.push((u >> 1).to_int64() ^ -(u & 1UL).to_int64())
        continue
      }
      let b2 = d[p + 2].to_int()
      if b2 < 0x80 {
        p = p + 3
        let u = ((b0 & 0x7F) | ((b1 & 0x7F) << 7) | (b2 << 14)).to_int64().to_uint64()
        out.push((u >> 1).to_int64() ^ -(u & 1UL).to_int64())
        continue
      }
      let b3 = d[p + 3].to_int()
      if b3 < 0x80 {
        p = p + 4
        let u = ((b0 & 0x7F) | ((b1 & 0x7F) << 7) | ((b2 & 0x7F) << 14) | (b3 << 21)).to_int64().to_uint64()
        out.push((u >> 1).to_int64() ^ -(u & 1UL).to_int64())
        continue
      }
    }
    let start_p = p
    let mut res : UInt64 = (b0 & 0x7F).to_int64().to_uint64()
    let mut shift = 7
    p = p + 1
    let mut done = false
    while p < end {
      let b = d[p].to_int()
      p = p + 1
      if shift == 63 {
        if b > 1 {
          return Err(ProtoError::VarintOverflow(start_p))
        }
        res = res | (b.to_int64().to_uint64() << 63)
        done = true
        break
      }
      res = res | ((b & 0x7F).to_int64().to_uint64() << shift)
      if b < 0x80 {
        done = true
        break
      }
      shift = shift + 7
    }
    if !done {
      return Err(ProtoError::UnexpectedEof(start_p))
    }
    out.push((res >> 1).to_int64() ^ -(res & 1UL).to_int64())
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_double(self : WireReader) -> Result[Array[Double], ProtoError] {
  let n = self.read_len_raw()
  if n < 0 {
    return Err(self.err_value())
  }
  let start = self.pos
  let end = start + n
  self.pos = end
  if n % 8 != 0 {
    return Err(ProtoError::UnexpectedEof(end))
  }
  let d = self.data
  let out : Array[Double] = Array::with_capacity(n / 8)
  let mut p = start
  while p < end {
    let lo = d[p].to_int().to_int64() |
    (d[p + 1].to_int().to_int64() << 8) |
    (d[p + 2].to_int().to_int64() << 16) |
    (d[p + 3].to_int().to_int64() << 24)
    let hi = d[p + 4].to_int().to_int64() |
    (d[p + 5].to_int().to_int64() << 8) |
    (d[p + 6].to_int().to_int64() << 16) |
    (d[p + 7].to_int().to_int64() << 24)
    out.push(Double::from_bits((lo & 0xFFFFFFFFL) | ((hi & 0xFFFFFFFFL) << 32)))
    p = p + 8
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_int32(self : WireReader) -> Result[Array[Int], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[Int] = []
  while !sub.is_eof() {
    match sub.read_int32() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///|
pub fn WireReader::read_packed_uint64(self : WireReader) -> Result[Array[UInt64], ProtoError] {
  let (start, end) = match self.read_bytes_range() {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let sub = WireReader::slice(self.data, start, end)
  let out : Array[UInt64] = []
  while !sub.is_eof() {
    match sub.read_uint64() {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
  }
  Ok(out)
}

///| Growable wire format writer with reusable `Bytes` buffer (native `memcpy` in `to_bytes`).
pub struct WireWriter {
  mut buf : Bytes
  mut len : Int
  mut cap : Int
}

///|
pub fn WireWriter::new() -> WireWriter {
  WireWriter::{ buf: Bytes::new(64), len: 0, cap: 64 }
}

///|
pub fn WireWriter::with_capacity(cap : Int) -> WireWriter {
  let c = if cap < 16 { 16 } else { cap }
  WireWriter::{ buf: Bytes::new(c), len: 0, cap: c }
}

///|
pub fn WireWriter::clear(self : WireWriter) -> Unit {
  self.len = 0
}

///|
pub fn WireWriter::length(self : WireWriter) -> Int {
  self.len
}

///|
pub fn WireWriter::capacity(self : WireWriter) -> Int {
  self.cap
}

///|
pub fn WireWriter::to_bytes(self : WireWriter) -> Bytes {
  let n = self.len
  if n == 0 {
    return empty_bytes
  }
  self.buf.slice(0, n)
}

///|
fn WireWriter::ensure_cap(self : WireWriter, extra : Int) -> Unit {
  let needed = self.len + extra
  let cur_cap = self.cap
  if needed <= cur_cap {
    return
  }
  let mut new_cap = if cur_cap < 16 { 16 } else { cur_cap }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let next = Bytes::new(new_cap)
  let old = self.buf
  let n = self.len
  let mut i = 0
  while i + 8 <= n {
    next[i] = old[i]
    next[i + 1] = old[i + 1]
    next[i + 2] = old[i + 2]
    next[i + 3] = old[i + 3]
    next[i + 4] = old[i + 4]
    next[i + 5] = old[i + 5]
    next[i + 6] = old[i + 6]
    next[i + 7] = old[i + 7]
    i = i + 8
  }
  while i < n {
    next[i] = old[i]
    i = i + 1
  }
  self.buf = next
  self.cap = new_cap
}

///| Ensure capacity for at least `extra` additional bytes beyond `self.length()`.
pub fn WireWriter::reserve(self : WireWriter, extra : Int) -> Unit {
  if self.len + extra > self.cap {
    self.ensure_cap(extra)
  }
}

///| Access the underlying writable `Bytes` buffer for pre-reserved `put_*` writes.
pub fn WireWriter::raw_buf(self : WireWriter) -> Bytes {
  self.buf
}

///| Update the written byte length after pre-reserved `put_*` writes (`0 <= new_len <= capacity`).
pub fn WireWriter::set_length(self : WireWriter, new_len : Int) -> Unit {
  if new_len >= 0 && new_len <= self.cap {
    self.len = new_len
  }
}

///| Write a length-delimited field header `(field_number, len)` into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_ld_header(buf : Bytes, pos : Int, field_number : Int, len : Int) -> Int {
  if field_number < 16 && len >= 0 && len < 128 {
    buf[pos] = ((field_number << 3) | 2).to_byte()
    buf[pos + 1] = len.to_byte()
    return pos + 2
  }
  let mut p = pos
  let mut t = (field_number.to_int64().to_uint64() << 3) | 2UL
  while t >= 0x80UL {
    buf[p] = ((t & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    t = t >> 7
  }
  buf[p] = t.to_int64().to_int().to_byte()
  p = p + 1
  let mut x = len.to_int64().to_uint64()
  while x >= 0x80UL {
    buf[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  buf[p] = x.to_int64().to_int().to_byte()
  p + 1
}

///| Write an int32 field into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_int32_field(buf : Bytes, pos : Int, field_number : Int, v : Int) -> Int {
  let mut p = pos
  if field_number < 16 {
    buf[p] = (field_number << 3).to_byte()
    p = p + 1
    if v >= 0 && v < 128 {
      buf[p] = v.to_byte()
      return p + 1
    }
  } else {
    let mut t = field_number.to_int64().to_uint64() << 3
    while t >= 0x80UL {
      buf[p] = ((t & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
      p = p + 1
      t = t >> 7
    }
    buf[p] = t.to_int64().to_int().to_byte()
    p = p + 1
  }
  let mut x = ((v.to_int64() << 32) >> 32).to_uint64()
  while x >= 0x80UL {
    buf[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  buf[p] = x.to_int64().to_int().to_byte()
  p + 1
}

///| Write an int64 field into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_int64_field(buf : Bytes, pos : Int, field_number : Int, v : Int64) -> Int {
  let mut p = pos
  if field_number < 16 {
    buf[p] = (field_number << 3).to_byte()
    p = p + 1
  } else {
    let mut t = field_number.to_int64().to_uint64() << 3
    while t >= 0x80UL {
      buf[p] = ((t & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
      p = p + 1
      t = t >> 7
    }
    buf[p] = t.to_int64().to_int().to_byte()
    p = p + 1
  }
  let mut x = v.to_uint64()
  if x < 0x80UL {
    buf[p] = x.to_int64().to_int().to_byte()
    return p + 1
  }
  if x < 0x4000UL {
    let xi = x.to_int64().to_int()
    buf[p] = ((xi & 0x7F) | 0x80).to_byte()
    buf[p + 1] = (xi >> 7).to_byte()
    return p + 2
  }
  while x >= 0x80UL {
    buf[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  buf[p] = x.to_int64().to_int().to_byte()
  p + 1
}

///| Write a uint64 field into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_uint64_field(buf : Bytes, pos : Int, field_number : Int, v : UInt64) -> Int {
  let mut p = pos
  if field_number < 16 {
    buf[p] = (field_number << 3).to_byte()
    p = p + 1
  } else {
    let mut t = field_number.to_int64().to_uint64() << 3
    while t >= 0x80UL {
      buf[p] = ((t & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
      p = p + 1
      t = t >> 7
    }
    buf[p] = t.to_int64().to_int().to_byte()
    p = p + 1
  }
  if v < 0x80UL {
    buf[p] = v.to_int64().to_int().to_byte()
    return p + 1
  }
  if v < 0x4000UL {
    let vi = v.to_int64().to_int()
    buf[p] = ((vi & 0x7F) | 0x80).to_byte()
    buf[p + 1] = (vi >> 7).to_byte()
    return p + 2
  }
  if v >= 0x100000000000000UL && v < 0x8000000000000000UL {
    let x = v.to_int64()
    buf[p] = ((x & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 1] = (((x >> 7) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 2] = (((x >> 14) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 3] = (((x >> 21) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 4] = (((x >> 28) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 5] = (((x >> 35) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 6] = (((x >> 42) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 7] = (((x >> 49) & 0x7FL).to_int() | 0x80).to_byte()
    buf[p + 8] = ((x >> 56) & 0x7FL).to_int().to_byte()
    return p + 9
  }
  let mut x = v
  while x >= 0x80UL {
    buf[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  buf[p] = x.to_int64().to_int().to_byte()
  p + 1
}

///| Write a bytes field into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_bytes_field(buf : Bytes, pos : Int, field_number : Int, b : Bytes) -> Int {
  let n = b.length()
  let mut p = if field_number < 16 && n < 128 {
    buf[pos] = ((field_number << 3) | 2).to_byte()
    buf[pos + 1] = n.to_byte()
    pos + 2
  } else {
    put_ld_header(buf, pos, field_number, n)
  }
  let mut i = 0
  while i + 8 <= n {
    buf[p] = b[i]
    buf[p + 1] = b[i + 1]
    buf[p + 2] = b[i + 2]
    buf[p + 3] = b[i + 3]
    buf[p + 4] = b[i + 4]
    buf[p + 5] = b[i + 5]
    buf[p + 6] = b[i + 6]
    buf[p + 7] = b[i + 7]
    p = p + 8
    i = i + 8
  }
  while i < n {
    buf[p] = b[i]
    p = p + 1
    i = i + 1
  }
  p
}

///| Write a string field into pre-reserved `buf` at `pos`, returning new `pos`.
pub fn put_string_field(buf : Bytes, pos : Int, field_number : Int, s : String) -> Int {
  let n = s.length()
  let mut p = if field_number < 16 && n < 128 {
    buf[pos] = ((field_number << 3) | 2).to_byte()
    buf[pos + 1] = n.to_byte()
    pos + 2
  } else {
    put_ld_header(buf, pos, field_number, n)
  }
  let mut i = 0
  while i + 8 <= n {
    buf[p] = s.code_unit_at(i).to_byte()
    buf[p + 1] = s.code_unit_at(i + 1).to_byte()
    buf[p + 2] = s.code_unit_at(i + 2).to_byte()
    buf[p + 3] = s.code_unit_at(i + 3).to_byte()
    buf[p + 4] = s.code_unit_at(i + 4).to_byte()
    buf[p + 5] = s.code_unit_at(i + 5).to_byte()
    buf[p + 6] = s.code_unit_at(i + 6).to_byte()
    buf[p + 7] = s.code_unit_at(i + 7).to_byte()
    p = p + 8
    i = i + 8
  }
  while i < n {
    buf[p] = s.code_unit_at(i).to_byte()
    p = p + 1
    i = i + 1
  }
  p
}

///|
fn WireWriter::write_varint64_bytes(self : WireWriter, v : UInt64) -> Unit {
  self.write_varint64(v)
}

///|
pub fn WireWriter::write_varint64(self : WireWriter, v : UInt64) -> Unit {
  let mut p = self.len
  if p + 10 > self.cap {
    self.ensure_cap(10)
  }
  let b = self.buf
  if v < 0x80UL {
    b[p] = v.to_int64().to_int().to_byte()
    self.len = p + 1
    return
  }
  if v < 0x4000UL {
    let vi = v.to_int64().to_int()
    b[p] = ((vi & 0x7F) | 0x80).to_byte()
    b[p + 1] = (vi >> 7).to_byte()
    self.len = p + 2
    return
  }
  let mut x = v
  while x >= 0x80UL {
    b[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
    p = p + 1
    x = x >> 7
  }
  b[p] = x.to_int64().to_int().to_byte()
  self.len = p + 1
}

///|
pub fn WireWriter::write_tag(self : WireWriter, field_number : Int, wire_type : WireType) -> Unit {
  let wt = wire_type_code(wire_type)
  if field_number < 16 {
    let p = self.len
    if p + 1 > self.cap {
      self.ensure_cap(1)
    }
    let b = self.buf
    b[p] = ((field_number << 3) | wt).to_byte()
    self.len = p + 1
    return
  }
  self.write_varint64(encode_tag_raw(field_number, wire_type))
}

///| Write length-delimited field tag + length prefix in a single capacity check.
pub fn WireWriter::write_ld_header(self : WireWriter, field_number : Int, len : Int) -> Unit {
  let p = self.len
  if field_number < 16 && len >= 0 && len < 128 && p + 2 <= self.cap {
    let b = self.buf
    b[p] = ((field_number << 3) | 2).to_byte()
    b[p + 1] = len.to_byte()
    self.len = p + 2
    return
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(len.to_int64().to_uint64())
}

///|
pub fn WireWriter::write_int32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  if self.len + 15 > self.cap {
    self.ensure_cap(15)
  }
  self.len = put_int32_field(self.buf, self.len, field_number, v)
}

///|
pub fn WireWriter::write_int64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  if self.len + 15 > self.cap {
    self.ensure_cap(15)
  }
  self.len = put_int64_field(self.buf, self.len, field_number, v)
}

///|
pub fn WireWriter::write_uint32_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  if self.len + 15 > self.cap {
    self.ensure_cap(15)
  }
  self.len = put_uint64_field(self.buf, self.len, field_number, (v & 0xFFFFFFFFL).to_uint64())
}

///|
pub fn WireWriter::write_uint64_field(self : WireWriter, field_number : Int, v : UInt64) -> Unit {
  if self.len + 15 > self.cap {
    self.ensure_cap(15)
  }
  self.len = put_uint64_field(self.buf, self.len, field_number, v)
}

///|
pub fn WireWriter::write_sint32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  self.write_uint64_field(field_number, zigzag_encode_i32(v).to_uint64())
}

///|
pub fn WireWriter::write_sint64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_uint64_field(field_number, zigzag_encode_i64(v))
}

///|
pub fn WireWriter::write_bool_field(self : WireWriter, field_number : Int, v : Bool) -> Unit {
  self.write_uint64_field(field_number, if v { 1UL } else { 0UL })
}

///|
pub fn WireWriter::write_fixed32(self : WireWriter, v : Int64) -> Unit {
  let p = self.len
  if p + 4 > self.cap {
    self.ensure_cap(4)
  }
  let b = self.buf
  b[p] = (v & 0xFFL).to_int().to_byte()
  b[p + 1] = ((v >> 8) & 0xFFL).to_int().to_byte()
  b[p + 2] = ((v >> 16) & 0xFFL).to_int().to_byte()
  b[p + 3] = ((v >> 24) & 0xFFL).to_int().to_byte()
  self.len = p + 4
}

///|
pub fn WireWriter::write_fixed32_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(v)
}

///|
pub fn WireWriter::write_sfixed32_field(self : WireWriter, field_number : Int, v : Int) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(v.to_int64() & 0xFFFFFFFFL)
}

///|
pub fn WireWriter::write_float_field(self : WireWriter, field_number : Int, v : Double) -> Unit {
  self.write_tag(field_number, WireType::Fixed32)
  self.write_fixed32(double_to_float32_bits(v))
}

///|
pub fn WireWriter::write_fixed64(self : WireWriter, v : UInt64) -> Unit {
  let p = self.len
  if p + 8 > self.cap {
    self.ensure_cap(8)
  }
  let b = self.buf
  let x = v.to_int64()
  b[p] = (x & 0xFFL).to_int().to_byte()
  b[p + 1] = ((x >> 8) & 0xFFL).to_int().to_byte()
  b[p + 2] = ((x >> 16) & 0xFFL).to_int().to_byte()
  b[p + 3] = ((x >> 24) & 0xFFL).to_int().to_byte()
  b[p + 4] = ((x >> 32) & 0xFFL).to_int().to_byte()
  b[p + 5] = ((x >> 40) & 0xFFL).to_int().to_byte()
  b[p + 6] = ((x >> 48) & 0xFFL).to_int().to_byte()
  b[p + 7] = ((x >> 56) & 0xFFL).to_int().to_byte()
  self.len = p + 8
}

///|
pub fn WireWriter::write_fixed64_field(self : WireWriter, field_number : Int, v : UInt64) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v)
}

///|
pub fn WireWriter::write_sfixed64_field(self : WireWriter, field_number : Int, v : Int64) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v.to_uint64())
}

///|
pub fn WireWriter::write_double_field(self : WireWriter, field_number : Int, v : Double) -> Unit {
  self.write_tag(field_number, WireType::Fixed64)
  self.write_fixed64(v.to_bits().to_uint64())
}

///|
pub fn WireWriter::write_raw_bytes(self : WireWriter, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return
  }
  if self.len + n > self.cap {
    self.ensure_cap(n)
  }
  let dst = self.buf
  let mut p = self.len
  let mut i = 0
  while i + 8 <= n {
    dst[p] = src[i]
    dst[p + 1] = src[i + 1]
    dst[p + 2] = src[i + 2]
    dst[p + 3] = src[i + 3]
    dst[p + 4] = src[i + 4]
    dst[p + 5] = src[i + 5]
    dst[p + 6] = src[i + 6]
    dst[p + 7] = src[i + 7]
    p = p + 8
    i = i + 8
  }
  while i < n {
    dst[p] = src[i]
    p = p + 1
    i = i + 1
  }
  self.len = p
}

///|
pub fn WireWriter::write_raw_slice(self : WireWriter, src : Bytes, start : Int, end : Int) -> Unit {
  let n = end - start
  if n <= 0 {
    return
  }
  if self.len + n > self.cap {
    self.ensure_cap(n)
  }
  let dst = self.buf
  let mut p = self.len
  let mut i = 0
  while i + 8 <= n {
    dst[p] = src[start + i]
    dst[p + 1] = src[start + i + 1]
    dst[p + 2] = src[start + i + 2]
    dst[p + 3] = src[start + i + 3]
    dst[p + 4] = src[start + i + 4]
    dst[p + 5] = src[start + i + 5]
    dst[p + 6] = src[start + i + 6]
    dst[p + 7] = src[start + i + 7]
    p = p + 8
    i = i + 8
  }
  while i < n {
    dst[p] = src[start + i]
    p = p + 1
    i = i + 1
  }
  self.len = p
}

///| Write raw bytes of a sub-`WireWriter` directly without length prefix (used for proto2 groups).
pub fn WireWriter::write_subwriter_raw(self : WireWriter, sub : WireWriter) -> Unit {
  self.write_raw_slice(sub.buf, 0, sub.len)
}

///|
pub fn WireWriter::write_bytes_field(self : WireWriter, field_number : Int, b : Bytes) -> Unit {
  let n = b.length()
  if self.len + n + 16 > self.cap {
    self.ensure_cap(n + 16)
  }
  self.len = put_bytes_field(self.buf, self.len, field_number, b)
}

///|
pub fn WireWriter::write_string_field(self : WireWriter, field_number : Int, s : String) -> Unit {
  let n = s.length()
  if self.len + n + 16 > self.cap {
    self.ensure_cap(n + 16)
  }
  self.len = put_string_field(self.buf, self.len, field_number, s)
}

///| Write the current contents of a sub-`WireWriter` as a length-delimited field with zero intermediate allocation.
pub fn WireWriter::write_subwriter_field(self : WireWriter, field_number : Int, sub : WireWriter) -> Unit {
  let n = sub.len
  if self.len + n + 16 > self.cap {
    self.ensure_cap(n + 16)
  }
  let mut p = put_ld_header(self.buf, self.len, field_number, n)
  if n == 0 {
    self.len = p
    return
  }
  let dst = self.buf
  let src = sub.buf
  let mut i = 0
  while i + 8 <= n {
    dst[p] = src[i]
    dst[p + 1] = src[i + 1]
    dst[p + 2] = src[i + 2]
    dst[p + 3] = src[i + 3]
    dst[p + 4] = src[i + 4]
    dst[p + 5] = src[i + 5]
    dst[p + 6] = src[i + 6]
    dst[p + 7] = src[i + 7]
    p = p + 8
    i = i + 8
  }
  while i < n {
    dst[p] = src[i]
    p = p + 1
    i = i + 1
  }
  self.len = p
}

///| Access byte at index `i` in the writer buffer (`0 <= i < self.length()`).
pub fn WireWriter::byte_at(self : WireWriter, i : Int) -> Byte {
  self.buf[i]
}

///|
pub fn WireWriter::write_packed_sint64_field(self : WireWriter, field_number : Int, vals : Array[Int64]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    let v = vals[i]
    let x = ((v << 1) ^ (v >> 63)).to_uint64()
    if x < 0x80UL {
      payload_len = payload_len + 1
    } else if x < 0x4000UL {
      payload_len = payload_len + 2
    } else if x < 0x200000UL {
      payload_len = payload_len + 3
    } else if x < 0x10000000UL {
      payload_len = payload_len + 4
    } else {
      payload_len = payload_len + varint_len_u64(x)
    }
    i = i + 1
  }
  self.ensure_cap(payload_len + 16)
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64_bytes(payload_len.to_int64().to_uint64())
  let b = self.buf
  let mut p = self.len
  i = 0
  while i < n {
    let v = vals[i]
    let mut x = ((v << 1) ^ (v >> 63)).to_uint64()
    if x < 0x80UL {
      b[p] = x.to_int64().to_int().to_byte()
      p = p + 1
    } else if x < 0x4000UL {
      let xi = x.to_int64().to_int()
      b[p] = ((xi & 0x7F) | 0x80).to_byte()
      b[p + 1] = (xi >> 7).to_byte()
      p = p + 2
    } else if x < 0x200000UL {
      let xi = x.to_int64().to_int()
      b[p] = ((xi & 0x7F) | 0x80).to_byte()
      b[p + 1] = (((xi >> 7) & 0x7F) | 0x80).to_byte()
      b[p + 2] = (xi >> 14).to_byte()
      p = p + 3
    } else if x < 0x10000000UL {
      let xi = x.to_int64().to_int()
      b[p] = ((xi & 0x7F) | 0x80).to_byte()
      b[p + 1] = (((xi >> 7) & 0x7F) | 0x80).to_byte()
      b[p + 2] = (((xi >> 14) & 0x7F) | 0x80).to_byte()
      b[p + 3] = (xi >> 21).to_byte()
      p = p + 4
    } else {
      while x >= 0x80UL {
        b[p] = ((x & 0x7FUL).to_int64().to_int() | 0x80).to_byte()
        p = p + 1
        x = x >> 7
      }
      b[p] = x.to_int64().to_int().to_byte()
      p = p + 1
    }
    i = i + 1
  }
  self.len = p
}

///|
pub fn WireWriter::write_packed_double_field(self : WireWriter, field_number : Int, vals : Array[Double]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let payload_len = n * 8
  self.ensure_cap(payload_len + 16)
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64_bytes(payload_len.to_int64().to_uint64())
  let b = self.buf
  let mut p = self.len
  let mut i = 0
  while i < n {
    let x = vals[i].to_bits()
    b[p] = (x & 0xFFL).to_int().to_byte()
    b[p + 1] = ((x >> 8) & 0xFFL).to_int().to_byte()
    b[p + 2] = ((x >> 16) & 0xFFL).to_int().to_byte()
    b[p + 3] = ((x >> 24) & 0xFFL).to_int().to_byte()
    b[p + 4] = ((x >> 32) & 0xFFL).to_int().to_byte()
    b[p + 5] = ((x >> 40) & 0xFFL).to_int().to_byte()
    b[p + 6] = ((x >> 48) & 0xFFL).to_int().to_byte()
    b[p + 7] = ((x >> 56) & 0xFFL).to_int().to_byte()
    p = p + 8
    i = i + 1
  }
  self.len = p
}

///|
pub fn WireWriter::write_packed_int32_field(self : WireWriter, field_number : Int, vals : Array[Int]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    let v64 = ((vals[i].to_int64() << 32) >> 32).to_uint64()
    payload_len = payload_len + varint_len_u64(v64)
    i = i + 1
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  i = 0
  while i < n {
    let v64 = ((vals[i].to_int64() << 32) >> 32).to_uint64()
    self.write_varint64(v64)
    i = i + 1
  }
}

///|
pub fn WireWriter::write_packed_uint64_field(self : WireWriter, field_number : Int, vals : Array[UInt64]) -> Unit {
  let n = vals.length()
  if n == 0 {
    return
  }
  let mut payload_len = 0
  let mut i = 0
  while i < n {
    payload_len = payload_len + varint_len_u64(vals[i])
    i = i + 1
  }
  self.write_tag(field_number, WireType::LengthDelimited)
  self.write_varint64(payload_len.to_int64().to_uint64())
  self.ensure_cap(payload_len)
  i = 0
  while i < n {
    self.write_varint64(vals[i])
    i = i + 1
  }
}
