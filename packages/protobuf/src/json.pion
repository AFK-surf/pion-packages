///| Proto3 Canonical JSON serialization.

///|
fn write_hex_digit(sb : StringBuilder, n : Int) -> Unit {
  if n < 10 {
    sb.write_byte((48 + n).to_byte())
  } else {
    sb.write_byte((97 + n - 10).to_byte())
  }
}

///| Write a JSON-escaped string with surrounding quotes.
fn write_json_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 8 {
      sb.write_string("\\b")
    } else if c == 12 {
      sb.write_string("\\f")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c < 32 {
      sb.write_string("\\u00")
      write_hex_digit(sb, (c >> 4) & 15)
      write_hex_digit(sb, c & 15)
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///| Standard Base64 encoding for Proto3 `bytes` JSON mapping.
fn write_base64(sb : StringBuilder, b : Bytes) -> Unit {
  let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let n = b.length()
  let mut i = 0
  while i + 2 < n {
    let v = (b[i].to_int() << 16) | (b[i + 1].to_int() << 8) | b[i + 2].to_int()
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 6) & 63).to_byte())
    sb.write_byte(table.code_unit_at(v & 63).to_byte())
    i = i + 3
  }
  let rem = n - i
  if rem == 1 {
    let v = b[i].to_int() << 16
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_string("==")
  } else if rem == 2 {
    let v = (b[i].to_int() << 16) | (b[i + 1].to_int() << 8)
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 6) & 63).to_byte())
    sb.write_byte((61).to_byte())
  }
}

///|
fn write_json_float(sb : StringBuilder, d : Double) -> Unit {
  let bits = d.to_bits()
  let exp_mask : Int64 = 0x7FF0000000000000L
  let frac_mask : Int64 = 0x000FFFFFFFFFFFFFL
  if (bits & exp_mask) == exp_mask {
    if (bits & frac_mask) != 0L {
      sb.write_string("\"NaN\"")
    } else if bits < 0L {
      sb.write_string("\"-Infinity\"")
    } else {
      sb.write_string("\"Infinity\"")
    }
    return
  }
  sb.write_string(d.to_string())
}

///|
fn map_key_to_string(k : ProtoValue) -> String {
  match k {
    ProtoValue::String(s) => s
    ProtoValue::Int32(n) => n.to_string()
    ProtoValue::Int64(n) => n.to_string()
    ProtoValue::UInt32(n) => n.to_string()
    ProtoValue::UInt64(n) => n.to_string()
    ProtoValue::Bool(b) => if b { "true" } else { "false" }
    _ => ""
  }
}

///|
fn enum_value_name(schema : Schema, parent : MessageDescriptor, type_name : String, num : Int) -> Option[String] {
  match resolve_nested_enum(schema, parent, type_name) {
    Some(ed) => {
      let mut i = 0
      while i < ed.values.length() {
        if ed.values[i].number == num {
          return Option::Some(ed.values[i].name)
        }
        i = i + 1
      }
      Option::None
    }
    None => Option::None
  }
}

///|
fn write_json_value(
  sb : StringBuilder,
  schema : Schema,
  parent : MessageDescriptor,
  ft : FieldType,
  v : ProtoValue,
  opts : JsonOptions,
  depth : Int,
) -> Result[Unit, ProtoError] {
  match v {
    ProtoValue::Bool(b) => {
      sb.write_string(if b { "true" } else { "false" })
      Ok(())
    }
    ProtoValue::Int32(n) => {
      sb.write_string(n.to_string())
      Ok(())
    }
    ProtoValue::UInt32(n) => {
      sb.write_string(n.to_string())
      Ok(())
    }
    ProtoValue::Int64(n) => {
      // Proto3 Canonical JSON: 64-bit integers are quoted strings
      sb.write_byte((34).to_byte())
      sb.write_string(n.to_string())
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::UInt64(n) => {
      sb.write_byte((34).to_byte())
      sb.write_string(n.to_string())
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::Float(d) => {
      write_json_float(sb, d)
      Ok(())
    }
    ProtoValue::Double(d) => {
      write_json_float(sb, d)
      Ok(())
    }
    ProtoValue::String(s) => {
      write_json_string(sb, s)
      Ok(())
    }
    ProtoValue::Bytes(b) => {
      sb.write_byte((34).to_byte())
      write_base64(sb, b)
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::Enum(n) => {
      if !opts.enums_as_ints {
        match ft {
          FieldType::Named(tname) =>
          match enum_value_name(schema, parent, tname, n) {
            Some(ename) => {
              write_json_string(sb, ename)
              return Ok(())
            }
            None => ()
          }
          _ => ()
        }
      }
      sb.write_string(n.to_string())
      Ok(())
    }
    ProtoValue::Message(sub) => {
      let sub_desc = match ft {
        FieldType::Named(tname) =>
        match resolve_nested_message(schema, parent, tname) {
          Some(d) => d
          None => return Err(ProtoError::MessageNotFound(tname))
        }
        _ =>
        match schema_find_message(schema, sub.message_name) {
          Some(d) => d
          None => return Err(ProtoError::MessageNotFound(sub.message_name))
        }
      }
      write_json_message(sb, schema, sub_desc, sub, opts, depth + 1)
    }
    ProtoValue::List(items) => {
      sb.write_byte((91).to_byte())
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        match write_json_value(sb, schema, parent, ft, items[i], opts, depth) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((93).to_byte())
      Ok(())
    }
    ProtoValue::Map(pairs) => {
      let vt = match ft {
        FieldType::Map(_, vtype) => vtype
        _ => FieldType::String
      }
      sb.write_byte((123).to_byte())
      let mut i = 0
      while i < pairs.length() {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        let (k, mv) = pairs[i]
        write_json_string(sb, map_key_to_string(k))
        sb.write_byte((58).to_byte())
        match write_json_value(sb, schema, parent, vt, mv, opts, depth) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      sb.write_byte((125).to_byte())
      Ok(())
    }
  }
}

///|
fn write_json_message(
  sb : StringBuilder,
  schema : Schema,
  desc : MessageDescriptor,
  msg : DynamicMessage,
  opts : JsonOptions,
  depth : Int,
) -> Result[Unit, ProtoError] {
  if depth > 256 {
    return Err(ProtoError::MaxDepthExceeded(256))
  }
  sb.write_byte((123).to_byte())
  let mut emitted = 0
  let mut i = 0
  while i < msg.fields.length() {
    let (fnum, fval) = msg.fields[i]
    let fdesc = match find_field_desc_by_num(desc, fnum) {
      Some(fd) => fd
      None => return Err(ProtoError::FieldNotFound(fnum.to_string()))
    }
    let omit = !opts.emit_defaults && fdesc.oneof_index < 0 && is_default_proto3_value(fval)
    if omit {
      i = i + 1
      continue
    }
    if emitted > 0 {
      sb.write_byte((44).to_byte())
    }
    let key_name = if opts.use_proto_names { fdesc.name } else { fdesc.json_name }
    write_json_string(sb, key_name)
    sb.write_byte((58).to_byte())
    match write_json_value(sb, schema, desc, fdesc.field_type, fval, opts, depth) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    emitted = emitted + 1
    i = i + 1
  }
  sb.write_byte((125).to_byte())
  Ok(())
}

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with default options.
pub fn to_proto3_json(schema : Schema, msg : DynamicMessage) -> Result[String, ProtoError] {
  to_proto3_json_with_options(schema, msg, JsonOptions::default())
}

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with custom options.
pub fn to_proto3_json_with_options(
  schema : Schema,
  msg : DynamicMessage,
  opts : JsonOptions,
) -> Result[String, ProtoError] {
  let desc = match schema_find_message(schema, msg.message_name) {
    Some(d) => d
    None => return Err(ProtoError::MessageNotFound(msg.message_name))
  }
  let sb = StringBuilder::new()
  match write_json_message(sb, schema, desc, msg, opts, 0) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}
