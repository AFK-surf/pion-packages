///| Proto3 Canonical JSON serialization (100% iterative, WKT-aware, explicit-presence & shortest float32).

///|
fn write_hex_digit(sb : StringBuilder, n : Int) -> Unit {
  if n < 10 {
    sb.write_byte((48 + n).to_byte())
  } else {
    sb.write_byte((97 + n - 10).to_byte())
  }
}

///| Write a JSON-escaped string with surrounding quotes, rejecting invalid UTF-8 (matches Go protojson).
fn write_json_string(sb : StringBuilder, s : String) -> Result[Unit, ProtoError] {
  let b = s.to_bytes()
  let n = b.length()
  if n > 0 && !is_valid_utf8_range(b, 0, n) {
    return Err(ProtoError::InvalidUtf8(0))
  }
  sb.write_byte((34).to_byte())
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 8 {
      sb.write_string("\\b")
    } else if c == 12 {
      sb.write_string("\\f")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c < 32 {
      sb.write_string("\\u00")
      write_hex_digit(sb, (c >> 4) & 15)
      write_hex_digit(sb, c & 15)
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
  Ok(())
}

///| Standard Base64 encoding for Proto3 `bytes` JSON mapping.
fn write_base64(sb : StringBuilder, b : Bytes) -> Unit {
  let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let n = b.length()
  let mut i = 0
  while i + 2 < n {
    let v = (b[i].to_int() << 16) | (b[i + 1].to_int() << 8) | b[i + 2].to_int()
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 6) & 63).to_byte())
    sb.write_byte(table.code_unit_at(v & 63).to_byte())
    i = i + 3
  }
  let rem = n - i
  if rem == 1 {
    let v = b[i].to_int() << 16
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_string("==")
  } else if rem == 2 {
    let v = (b[i].to_int() << 16) | (b[i + 1].to_int() << 8)
    sb.write_byte(table.code_unit_at((v >> 18) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 12) & 63).to_byte())
    sb.write_byte(table.code_unit_at((v >> 6) & 63).to_byte())
    sb.write_byte((61).to_byte())
  }
}

///| Format a decimal significand `digs` (leading non-zero, no trailing zeros) with base-10 exponent `exp10`
///  (value = digs[0].digs[1..] * 10^exp10) matching Go `strconv.FormatFloat(v, 'g', -1, 32)` / JSON style.
fn format_sig_exp(neg : Bool, digs : String, exp10 : Int) -> String {
  let sb = StringBuilder::new()
  if neg {
    sb.write_byte((45).to_byte())
  }
  let nd = digs.length()
  if exp10 >= -4 && exp10 < 6 {
    if exp10 < 0 {
      sb.write_string("0.")
      let mut z = -exp10 - 1
      while z > 0 {
        sb.write_byte((48).to_byte())
        z = z - 1
      }
      sb.write_string(digs)
    } else if exp10 + 1 >= nd {
      sb.write_string(digs)
      let mut z = exp10 + 1 - nd
      while z > 0 {
        sb.write_byte((48).to_byte())
        z = z - 1
      }
    } else {
      sb.write_string(digs.slice(0, exp10 + 1))
      sb.write_byte((46).to_byte())
      sb.write_string(digs.slice(exp10 + 1, nd))
    }
  } else {
    sb.write_byte(digs.code_unit_at(0).to_byte())
    if nd > 1 {
      sb.write_byte((46).to_byte())
      sb.write_string(digs.slice(1, nd))
    }
    sb.write_byte((101).to_byte())
    if exp10 >= 0 {
      sb.write_byte((43).to_byte())
      if exp10 < 10 {
        sb.write_byte((48).to_byte())
      }
      sb.write_string(exp10.to_string())
    } else {
      sb.write_byte((45).to_byte())
      let ae = -exp10
      if ae < 10 {
        sb.write_byte((48).to_byte())
      }
      sb.write_string(ae.to_string())
    }
  }
  sb.to_string()
}

///| Strip trailing zeros from a decimal digit string (keeping at least 1 digit).
fn strip_trailing_zeros(s : String) -> String {
  let mut end = s.length()
  while end > 1 && s.code_unit_at(end - 1) == 48 {
    end = end - 1
  }
  s.slice(0, end)
}

///| Add 1 to a decimal digit string (returns `(new_digits, carried_out)`).
fn inc_decimal_digits(s : String) -> (String, Bool) {
  let n = s.length()
  let out = Bytes::new(n)
  let mut carry = 1
  let mut i = n - 1
  while i >= 0 {
    let d = s.code_unit_at(i) - 48 + carry
    if d >= 10 {
      out[i] = (48).to_byte()
      carry = 1
    } else {
      out[i] = (48 + d).to_byte()
      carry = 0
    }
    i = i - 1
  }
  if carry == 1 {
    let res = Bytes::new(n + 1)
    res[0] = (49).to_byte()
    let mut k = 0
    while k < n {
      res[k + 1] = out[k]
      k = k + 1
    }
    (res.to_string(), true)
  } else {
    (out.to_string(), false)
  }
}

///| Parse a positive `Double::to_string()` into `(sig_digits, exp10)` where value = sig[0].sig[1..] * 10^exp10.
fn parse_double_to_sig_exp(s : String) -> (String, Int) {
  let n = s.length()
  let mut i = 0
  let mut exp_part = 0
  let mut e_idx = n
  while i < n {
    let c = s.code_unit_at(i)
    if c == 101 || c == 69 {
      e_idx = i
      break
    }
    i = i + 1
  }
  if e_idx < n {
    let mut j = e_idx + 1
    let mut eneg = false
    if j < n && s.code_unit_at(j) == 45 {
      eneg = true
      j = j + 1
    } else if j < n && s.code_unit_at(j) == 43 {
      j = j + 1
    }
    let mut ev = 0
    while j < n {
      ev = ev * 10 + (s.code_unit_at(j) - 48)
      j = j + 1
    }
    exp_part = if eneg { -ev } else { ev }
  }
  let sb = StringBuilder::new()
  let mut dot_pos = -1
  let mut first_nz = -1
  let mut digit_count = 0
  i = 0
  while i < e_idx {
    let c = s.code_unit_at(i)
    if c == 46 {
      dot_pos = digit_count
    } else if c >= 48 && c <= 57 {
      if first_nz < 0 && c != 48 {
        first_nz = digit_count
      }
      if first_nz >= 0 {
        sb.write_byte(c.to_byte())
      }
      digit_count = digit_count + 1
    }
    i = i + 1
  }
  if first_nz < 0 {
    return ("0", 0)
  }
  let int_digits = if dot_pos < 0 { digit_count } else { dot_pos }
  let exp10 = exp_part + int_digits - first_nz - 1
  (strip_trailing_zeros(sb.to_string()), exp10)
}

///| Write IEEE-754 binary32 float in exact shortest round-trip decimal representation (matches Go protojson).
fn write_json_float32(sb : StringBuilder, d : Double) -> Unit {
  let bits = double_to_float32_bits(d)
  let exp = ((bits >> 23) & 0xFFL).to_int()
  let frac = bits & 0x7FFFFFL
  let neg = ((bits >> 31) & 1L) != 0L
  if exp == 255 {
    if frac != 0L {
      sb.write_string("\"NaN\"")
    } else if neg {
      sb.write_string("\"-Infinity\"")
    } else {
      sb.write_string("\"Infinity\"")
    }
    return
  }
  if exp == 0 && frac == 0L {
    if neg {
      sb.write_string("-0")
    } else {
      sb.write_string("0")
    }
    return
  }
  let abs_d = if neg { -d } else { d }
  let full_s = abs_d.to_string()
  let (all_digs, base_exp) = parse_double_to_sig_exp(full_s)
  let mut p = 1
  while p <= 9 {
    let prefix = if p < all_digs.length() { all_digs.slice(0, p) } else { all_digs }
    let round_up = p < all_digs.length() && all_digs.code_unit_at(p) >= 53
    // Try rounded candidate first, then the other neighbor if needed
    let (cand1_d, cand1_e) = if round_up {
      let (inc_d, carried) = inc_decimal_digits(prefix)
      if carried {
        (strip_trailing_zeros(inc_d.slice(0, p)), base_exp + 1)
      } else {
        (strip_trailing_zeros(inc_d), base_exp)
      }
    } else {
      (strip_trailing_zeros(prefix), base_exp)
    }
    let s1 = format_sig_exp(neg, cand1_d, cand1_e)
    match s1.to_double() {
      Some(v) =>
      if double_to_float32_bits(v) == bits {
        sb.write_string(s1)
        return
      }
      None => ()
    }
    // Also try the alternate rounding direction at precision `p`
    let (cand2_d, cand2_e) = if !round_up {
      let (inc_d, carried) = inc_decimal_digits(prefix)
      if carried {
        (strip_trailing_zeros(inc_d.slice(0, p)), base_exp + 1)
      } else {
        (strip_trailing_zeros(inc_d), base_exp)
      }
    } else {
      (strip_trailing_zeros(prefix), base_exp)
    }
    let s2 = format_sig_exp(neg, cand2_d, cand2_e)
    match s2.to_double() {
      Some(v) =>
      if double_to_float32_bits(v) == bits {
        sb.write_string(s2)
        return
      }
      None => ()
    }
    p = p + 1
  }
  sb.write_string(d.to_string())
}

///| Write IEEE-754 binary64 double for Proto3 JSON.
fn write_json_double(sb : StringBuilder, d : Double) -> Unit {
  let bits = d.to_bits()
  let exp_mask : Int64 = 0x7FF0000000000000L
  let frac_mask : Int64 = 0x000FFFFFFFFFFFFFL
  if (bits & exp_mask) == exp_mask {
    if (bits & frac_mask) != 0L {
      sb.write_string("\"NaN\"")
    } else if bits < 0L {
      sb.write_string("\"-Infinity\"")
    } else {
      sb.write_string("\"Infinity\"")
    }
    return
  }
  sb.write_string(d.to_string())
}

///| Check if a double is NaN or Infinity.
fn is_non_finite_double(d : Double) -> Bool {
  let bits = d.to_bits()
  let exp_mask : Int64 = 0x7FF0000000000000L
  (bits & exp_mask) == exp_mask
}

///|
fn map_key_to_string(k : ProtoValue) -> String {
  match k {
    ProtoValue::String(s) => s
    ProtoValue::Int32(n) => n.to_string()
    ProtoValue::Int64(n) => n.to_string()
    ProtoValue::UInt32(n) => n.to_string()
    ProtoValue::UInt64(n) => n.to_string()
    ProtoValue::Bool(b) => if b { "true" } else { "false" }
    _ => ""
  }
}

///| O(1) enum value name lookup using linked `FieldDescriptor`.
fn enum_value_name_fd(schema : Schema, fd : FieldDescriptor, num : Int) -> Option[String] {
  match resolve_field_enum(schema, fd) {
    Some(ed) => {
      let mut i = 0
      while i < ed.values.length() {
        if ed.values[i].number == num {
          return Option::Some(ed.values[i].name)
        }
        i = i + 1
      }
      Option::None
    }
    None => Option::None
  }
}

///| Write a scalar / enum `ProtoValue` (non-container, non-message) to `sb`.
fn write_json_scalar(
  sb : StringBuilder,
  schema : Schema,
  fd : FieldDescriptor,
  v : ProtoValue,
  opts : JsonOptions,
) -> Result[Unit, ProtoError] {
  match v {
    ProtoValue::Bool(b) => {
      sb.write_string(if b { "true" } else { "false" })
      Ok(())
    }
    ProtoValue::Int32(n) => {
      sb.write_string(n.to_string())
      Ok(())
    }
    ProtoValue::UInt32(n) => {
      sb.write_string(n.to_string())
      Ok(())
    }
    ProtoValue::Int64(n) => {
      sb.write_byte((34).to_byte())
      sb.write_string(n.to_string())
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::UInt64(n) => {
      sb.write_byte((34).to_byte())
      sb.write_string(n.to_string())
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::Float(d) => {
      write_json_float32(sb, d)
      Ok(())
    }
    ProtoValue::Double(d) => {
      write_json_double(sb, d)
      Ok(())
    }
    ProtoValue::String(s) => write_json_string(sb, s)
    ProtoValue::Bytes(b) => {
      sb.write_byte((34).to_byte())
      write_base64(sb, b)
      sb.write_byte((34).to_byte())
      Ok(())
    }
    ProtoValue::Enum(n) => {
      // google.protobuf.NullValue always serializes as JSON `null`
      if fd.resolved_kind == 5 {
        match fd.field_type {
          FieldType::Named(tname) =>
          if tname == "google.protobuf.NullValue" {
            sb.write_string("null")
            return Ok(())
          }
          _ => ()
        }
      }
      if !opts.enums_as_ints {
        match enum_value_name_fd(schema, fd, n) {
          Some(ename) => return write_json_string(sb, ename)
          None => ()
        }
      }
      sb.write_string(n.to_string())
      Ok(())
    }
    _ => Err(ProtoError::InvalidValue("expected scalar in write_json_scalar"))
  }
}

///| Look up a field's value in `msg.fields` (using `fmap` if populated, else linear scan).
fn lookup_msg_field(
  msg : DynamicMessage,
  fmap : Map[Int, Int],
  use_map : Bool,
  field_number : Int,
) -> Option[ProtoValue] {
  if use_map {
    match fmap.get(field_number) {
      Some(idx) => {
        let (_, v) = msg.fields[idx]
        return Option::Some(v)
      }
      None => return Option::None
    }
  }
  get_field(msg, field_number)
}

///| Explicit stack frame for 100% iterative `to_proto3_json_with_options`.
struct JsonFrame {
  // kind: 0 = Message object, 1 = List array, 2 = Map object
  kind : Int
  desc : MessageDescriptor
  msg : DynamicMessage
  fmap : Map[Int, Int]
  use_map : Bool
  list_fd : FieldDescriptor
  list_items : Array[ProtoValue]
  map_pairs : Array[(ProtoValue, ProtoValue)]
  mut idx : Int
  mut emitted : Int
}

///| Build a `JsonFrame` for a regular message object `{ ... }`.
fn make_msg_json_frame(desc : MessageDescriptor, msg : DynamicMessage, dummy_fd : FieldDescriptor) -> JsonFrame {
  let use_map = msg.fields.length() > 16
  let fmap : Map[Int, Int] = Map::new()
  if use_map {
    let mut i = 0
    while i < msg.fields.length() {
      let (num, _) = msg.fields[i]
      fmap.set(num, i)
      i = i + 1
    }
  }
  JsonFrame::{
    kind: 0,
    desc: desc,
    msg: msg,
    fmap: fmap,
    use_map: use_map,
    list_fd: dummy_fd,
    list_items: [],
    map_pairs: [],
    idx: 0,
    emitted: 0,
  }
}

///| Deduplicate map entries last-wins (for manually constructed `ProtoValue::Map`).
fn dedup_map_pairs(pairs : Array[(ProtoValue, ProtoValue)]) -> Array[(ProtoValue, ProtoValue)] {
  if pairs.length() <= 1 {
    return pairs
  }
  let out : Array[(ProtoValue, ProtoValue)] = []
  let idx_map : Map[String, Int] = Map::new()
  let mut i = 0
  while i < pairs.length() {
    let (k, v) = pairs[i]
    let ks = map_key_to_string(k)
    match idx_map.get(ks) {
      Some(pidx) => out[pidx] = (k, v)
      None => {
        idx_map.set(ks, out.length())
        out.push((k, v))
      }
    }
    i = i + 1
  }
  out
}

///| Push a message frame (`kind = 3`) onto the iterative JSON stack.
fn push_msg_frame(
  frames : Array[JsonFrame],
  desc : MessageDescriptor,
  msg : DynamicMessage,
  dummy_fd : FieldDescriptor,
) -> Unit {
  frames.push(JsonFrame::{
    kind: 3,
    desc: desc,
    msg: msg,
    fmap: Map::new(),
    use_map: false,
    list_fd: dummy_fd,
    list_items: [],
    map_pairs: [],
    idx: 0,
    emitted: 0,
  })
}

///| Handle emitting a `DynamicMessage` (either WKT special JSON or pushing a `JsonFrame`).
fn emit_message_or_wkt(
  sb : StringBuilder,
  frames : Array[JsonFrame],
  schema : Schema,
  desc : MessageDescriptor,
  msg : DynamicMessage,
  opts : JsonOptions,
  dummy_fd : FieldDescriptor,
) -> Result[Unit, ProtoError] {
  let fn_name = desc.full_name
  if fn_name == "google.protobuf.Timestamp" {
    return write_wkt_timestamp_json(sb, msg)
  }
  if fn_name == "google.protobuf.Duration" {
    return write_wkt_duration_json(sb, msg)
  }
  if fn_name == "google.protobuf.Empty" {
    sb.write_string("{}")
    return Ok(())
  }
  if fn_name == "google.protobuf.DoubleValue" ||
  fn_name == "google.protobuf.FloatValue" ||
  fn_name == "google.protobuf.Int64Value" ||
  fn_name == "google.protobuf.UInt64Value" ||
  fn_name == "google.protobuf.Int32Value" ||
  fn_name == "google.protobuf.UInt32Value" ||
  fn_name == "google.protobuf.BoolValue" ||
  fn_name == "google.protobuf.StringValue" ||
  fn_name == "google.protobuf.BytesValue" {
    let f1 = desc.fields[0]
    let v = match get_field(msg, 1) {
      Some(fv) => fv
      None => default_value_for_field_type(f1.field_type, false)
    }
    return write_json_scalar(sb, schema, f1, v, opts)
  }
  if fn_name == "google.protobuf.Struct" {
    let f1 = desc.fields[0]
    let pairs = match get_map(msg, 1) {
      Some(ps) => dedup_map_pairs(ps)
      None => []
    }
    sb.write_byte((123).to_byte())
    frames.push(JsonFrame::{
      kind: 2,
      desc: desc,
      msg: msg,
      fmap: Map::new(),
      use_map: false,
      list_fd: f1,
      list_items: [],
      map_pairs: pairs,
      idx: 0,
      emitted: 0,
    })
    return Ok(())
  }
  if fn_name == "google.protobuf.ListValue" {
    let f1 = desc.fields[0]
    let items = match get_list(msg, 1) {
      Some(xs) => xs
      None => []
    }
    sb.write_byte((91).to_byte())
    frames.push(JsonFrame::{
      kind: 1,
      desc: desc,
      msg: msg,
      fmap: Map::new(),
      use_map: false,
      list_fd: f1,
      list_items: items,
      map_pairs: [],
      idx: 0,
      emitted: 0,
    })
    return Ok(())
  }
  if fn_name == "google.protobuf.Value" {
    if msg.fields.length() == 0 {
      return Err(ProtoError::InvalidValue("google.protobuf.Value has no kind set"))
    }
    let (knum, kval) = msg.fields[0]
    if knum == 1 {
      sb.write_string("null")
      return Ok(())
    } else if knum == 2 {
      match kval {
        ProtoValue::Double(d) => {
          if is_non_finite_double(d) {
            return Err(ProtoError::InvalidValue("google.protobuf.Value cannot encode NaN/Infinity"))
          }
          write_json_double(sb, d)
          return Ok(())
        }
        _ => return Err(ProtoError::InvalidValue("invalid number_value"))
      }
    } else if knum == 3 {
      match kval {
        ProtoValue::String(s) => return write_json_string(sb, s)
        _ => return Err(ProtoError::InvalidValue("invalid string_value"))
      }
    } else if knum == 4 {
      match kval {
        ProtoValue::Bool(b) => {
          sb.write_string(if b { "true" } else { "false" })
          return Ok(())
        }
        _ => return Err(ProtoError::InvalidValue("invalid bool_value"))
      }
    } else if knum == 5 {
      match kval {
        ProtoValue::Message(sub) => {
          let st_desc = match wkt_find_message("google.protobuf.Struct") {
            Some(d) => d
            None => return Err(ProtoError::MessageNotFound("google.protobuf.Struct"))
          }
          push_msg_frame(frames, st_desc, sub, dummy_fd)
          return Ok(())
        }
        _ => return Err(ProtoError::InvalidValue("invalid struct_value"))
      }
    } else if knum == 6 {
      match kval {
        ProtoValue::Message(sub) => {
          let lv_desc = match wkt_find_message("google.protobuf.ListValue") {
            Some(d) => d
            None => return Err(ProtoError::MessageNotFound("google.protobuf.ListValue"))
          }
          push_msg_frame(frames, lv_desc, sub, dummy_fd)
          return Ok(())
        }
        _ => return Err(ProtoError::InvalidValue("invalid list_value"))
      }
    }
    return Err(ProtoError::InvalidValue("invalid google.protobuf.Value kind"))
  }
  if fn_name == "google.protobuf.FieldMask" {
    let paths = match get_list(msg, 1) {
      Some(xs) => xs
      None => []
    }
    let psb = StringBuilder::new()
    let mut i = 0
    while i < paths.length() {
      if i > 0 {
        psb.write_byte((44).to_byte())
      }
      match paths[i] {
        ProtoValue::String(s) => psb.write_string(to_lower_camel_case(s))
        _ => ()
      }
      i = i + 1
    }
    return write_json_string(sb, psb.to_string())
  }
  // Normal message object
  sb.write_byte((123).to_byte())
  frames.push(make_msg_json_frame(desc, msg, dummy_fd))
  Ok(())
}

///| Emit one field step of a message `JsonFrame`.
fn json_step_message(
  sb : StringBuilder,
  frames : Array[JsonFrame],
  frame : JsonFrame,
  schema : Schema,
  opts : JsonOptions,
  is_proto2 : Bool,
  dummy_fd : FieldDescriptor,
) -> Result[Unit, ProtoError] {
  if frame.idx >= frame.desc.fields.length() {
    sb.write_byte((125).to_byte())
    let _ = frames.pop()
    return Ok(())
  }
  let fdesc = frame.desc.fields[frame.idx]
  frame.idx = frame.idx + 1
  let is_map = match fdesc.field_type {
    FieldType::Map(_, _) => true
    _ => false
  }
  let is_rep = match fdesc.label {
    FieldLabel::Repeated => !is_map
    _ => false
  }
  let is_msg = !is_map && is_field_message(fdesc)
  let has_presence = !is_map && !is_rep && (
    fdesc.oneof_index >= 0 || is_proto2 || is_msg || match fdesc.label {
      FieldLabel::Optional | FieldLabel::Required => true
      _ => false
    }
  )
  match lookup_msg_field(frame.msg, frame.fmap, frame.use_map, fdesc.number) {
    Some(fval) => {
      let omit = !has_presence && !opts.emit_defaults && is_default_proto3_value(fval)
      if omit {
        return Ok(())
      }
      if frame.emitted > 0 {
        sb.write_byte((44).to_byte())
      }
      frame.emitted = frame.emitted + 1
      let key_name = if opts.use_proto_names { fdesc.name } else { fdesc.json_name }
      match write_json_string(sb, key_name) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_byte((58).to_byte())
      match fval {
        ProtoValue::Message(sub) => {
          let sub_desc = match resolve_field_message(schema, fdesc) {
            Some(d) => d
            None =>
            match schema_find_message(schema, sub.message_name) {
              Some(d) => d
              None => return Err(ProtoError::MessageNotFound(sub.message_name))
            }
          }
          push_msg_frame(frames, sub_desc, sub, dummy_fd)
          Ok(())
        }
        ProtoValue::List(items) => {
          sb.write_byte((91).to_byte())
          frames.push(JsonFrame::{
            kind: 1,
            desc: frame.desc,
            msg: frame.msg,
            fmap: Map::new(),
            use_map: false,
            list_fd: fdesc,
            list_items: items,
            map_pairs: [],
            idx: 0,
            emitted: 0,
          })
          Ok(())
        }
        ProtoValue::Map(pairs) => {
          let deduped = dedup_map_pairs(pairs)
          sb.write_byte((123).to_byte())
          frames.push(JsonFrame::{
            kind: 2,
            desc: frame.desc,
            msg: frame.msg,
            fmap: Map::new(),
            use_map: false,
            list_fd: fdesc,
            list_items: [],
            map_pairs: deduped,
            idx: 0,
            emitted: 0,
          })
          Ok(())
        }
        _ => write_json_scalar(sb, schema, fdesc, fval, opts)
      }
    }
    None => {
      // Go protojson EmitUnpopulated omits unset oneofs and unset proto3 optional (synthetic oneof) fields.
      let is_proto3_opt = !is_proto2 && match fdesc.label {
        FieldLabel::Optional => true
        _ => false
      }
      if !opts.emit_defaults || fdesc.oneof_index >= 0 || is_proto3_opt {
        return Ok(())
      }
      if frame.emitted > 0 {
        sb.write_byte((44).to_byte())
      }
      frame.emitted = frame.emitted + 1
      let key_name = if opts.use_proto_names { fdesc.name } else { fdesc.json_name }
      match write_json_string(sb, key_name) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_byte((58).to_byte())
      if is_map {
        sb.write_string("{}")
        Ok(())
      } else if is_rep {
        sb.write_string("[]")
        Ok(())
      } else if has_presence {
        sb.write_string("null")
        Ok(())
      } else {
        let def_v = default_value_for_field_type(fdesc.field_type, is_field_enum(fdesc))
        write_json_scalar(sb, schema, fdesc, def_v, opts)
      }
    }
  }
}

///| Emit one item step of a list `JsonFrame`.
fn json_step_list(
  sb : StringBuilder,
  frames : Array[JsonFrame],
  frame : JsonFrame,
  schema : Schema,
  opts : JsonOptions,
  dummy_fd : FieldDescriptor,
) -> Result[Unit, ProtoError] {
  if frame.idx >= frame.list_items.length() {
    sb.write_byte((93).to_byte())
    let _ = frames.pop()
    return Ok(())
  }
  let item = frame.list_items[frame.idx]
  if frame.idx > 0 {
    sb.write_byte((44).to_byte())
  }
  frame.idx = frame.idx + 1
  match item {
    ProtoValue::Message(sub) => {
      let sub_desc = match resolve_field_message(schema, frame.list_fd) {
        Some(d) => d
        None =>
        match schema_find_message(schema, sub.message_name) {
          Some(d) => d
          None => return Err(ProtoError::MessageNotFound(sub.message_name))
        }
      }
      push_msg_frame(frames, sub_desc, sub, dummy_fd)
      Ok(())
    }
    _ => write_json_scalar(sb, schema, frame.list_fd, item, opts)
  }
}

///| Emit one entry step of a map `JsonFrame`.
fn json_step_map(
  sb : StringBuilder,
  frames : Array[JsonFrame],
  frame : JsonFrame,
  schema : Schema,
  opts : JsonOptions,
  dummy_fd : FieldDescriptor,
) -> Result[Unit, ProtoError] {
  if frame.idx >= frame.map_pairs.length() {
    sb.write_byte((125).to_byte())
    let _ = frames.pop()
    return Ok(())
  }
  let (k, mv) = frame.map_pairs[frame.idx]
  if frame.idx > 0 {
    sb.write_byte((44).to_byte())
  }
  frame.idx = frame.idx + 1
  match write_json_string(sb, map_key_to_string(k)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_byte((58).to_byte())
  match mv {
    ProtoValue::Message(sub) => {
      let sub_desc = match resolve_field_message(schema, frame.list_fd) {
        Some(d) => d
        None =>
        match schema_find_message(schema, sub.message_name) {
          Some(d) => d
          None => return Err(ProtoError::MessageNotFound(sub.message_name))
        }
      }
      push_msg_frame(frames, sub_desc, sub, dummy_fd)
      Ok(())
    }
    _ => write_json_scalar(sb, schema, frame.list_fd, mv, opts)
  }
}

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with default options.
pub fn to_proto3_json(schema : Schema, msg : DynamicMessage) -> Result[String, ProtoError] {
  to_proto3_json_with_options(schema, msg, JsonOptions::default())
}

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with custom options (100% iterative).
pub fn to_proto3_json_with_options(
  schema : Schema,
  msg : DynamicMessage,
  opts : JsonOptions,
) -> Result[String, ProtoError] {
  let root_desc = match schema_find_message(schema, msg.message_name) {
    Some(d) => d
    None => return Err(ProtoError::MessageNotFound(msg.message_name))
  }
  let is_proto2 = match schema.syntax {
    Syntax::Proto2 => true
    Syntax::Proto3 => false
  }
  let dummy_fd = FieldDescriptor::{
    name: "",
    number: 0,
    label: FieldLabel::Implicit,
    field_type: FieldType::Int32,
    oneof_index: -1,
    json_name: "",
    packed: Option::None,
    default_value: Option::None,
    options: [],
    resolved_kind: 0,
    resolved_path: [],
    is_group: false,
  }
  let sb = StringBuilder::new()
  let frames : Array[JsonFrame] = []
  push_msg_frame(frames, root_desc, msg, dummy_fd)

  while frames.length() > 0 {
    let frame = frames[frames.length() - 1]
    let step_res = if frame.kind == 3 {
      let _ = frames.pop()
      emit_message_or_wkt(sb, frames, schema, frame.desc, frame.msg, opts, dummy_fd)
    } else if frame.kind == 0 {
      json_step_message(sb, frames, frame, schema, opts, is_proto2, dummy_fd)
    } else if frame.kind == 1 {
      json_step_list(sb, frames, frame, schema, opts, dummy_fd)
    } else {
      json_step_map(sb, frames, frame, schema, opts, dummy_fd)
    }
    match step_res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  Ok(sb.to_string())
}
