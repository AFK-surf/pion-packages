///| Proto3 Canonical JSON serialization (stub for Red phase).

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with default options.
pub fn to_proto3_json(schema : Schema, msg : DynamicMessage) -> Result[String, ProtoError] {
  to_proto3_json_with_options(schema, msg, JsonOptions::default())
}

///| Serialize a `DynamicMessage` to Proto3 Canonical JSON with custom options.
pub fn to_proto3_json_with_options(
  schema : Schema,
  msg : DynamicMessage,
  opts : JsonOptions,
) -> Result[String, ProtoError] {
  let _ = schema
  let _ = msg
  let _ = opts
  Err(ProtoError::InvalidValue("not implemented"))
}
