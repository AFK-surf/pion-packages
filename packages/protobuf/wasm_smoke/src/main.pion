///| Wasm32 + Native smoke entry for the `protobuf` package.

import "protobuf"

///|
pub fn smoke() -> Int {
  let src = "syntax = \"proto3\"; package smoke; enum State { UNKNOWN = 0; ACTIVE = 1; } message Item { int64 id = 1; string name = 2; State state = 3; repeated sint64 vals = 4; map<string, int64> meta = 5; }"
  let schema = match protobuf::parse_schema(src) {
    Ok(s) => s
    Err(_) => return 1
  }
  let mut msg = protobuf::DynamicMessage::new("Item")
  msg = protobuf::set_field(msg, 1, protobuf::ProtoValue::Int64(9007199254740993L))
  msg = protobuf::set_field(msg, 2, protobuf::ProtoValue::String("pion-proto"))
  msg = protobuf::set_field(msg, 3, protobuf::ProtoValue::Enum(1))
  msg = protobuf::set_field(
    msg,
    4,
    protobuf::ProtoValue::List([protobuf::ProtoValue::Int64(-10L), protobuf::ProtoValue::Int64(20L)]),
  )
  msg = protobuf::set_field(
    msg,
    5,
    protobuf::ProtoValue::Map([(protobuf::ProtoValue::String("k"), protobuf::ProtoValue::Int64(7L))]),
  )
  let raw = match protobuf::encode_dynamic(schema, msg) {
    Ok(b) => b
    Err(_) => return 2
  }
  let dec = match protobuf::decode_dynamic_default(schema, "Item", raw) {
    Ok(m) => m
    Err(_) => return 3
  }
  match protobuf::get_string(dec, 2) {
    Some(s) => if s != "pion-proto" { return 4 }
    None => return 4
  }
  let js = match protobuf::to_proto3_json(schema, dec) {
    Ok(s) => s
    Err(_) => return 5
  }
  if js.length() == 0 {
    return 6
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
