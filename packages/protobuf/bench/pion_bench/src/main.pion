///| Head-to-head benchmark for `packages/protobuf` (Pion Native):
///  1. decode_spans <corpus.pb>   : 100k OTel/RPC nested Span decode (50 x 2,000)
///  2. encode_spans               : 100k OTel/RPC nested Span encode (50 x 2,000)
///  3. packed_numeric             : 8 rounds x (200k sint64 + 200k double) encode + decode

import "protobuf"

///|
struct KeyValue {
  mut key : String
  mut str_value : String
  mut int_value : Int64
}

///|
struct SpanEvent {
  mut time_unix_nano : UInt64
  mut name : String
  mut dropped_attributes : Int
}

///|
struct Span {
  mut trace_id : Bytes
  mut span_id : Bytes
  mut name : String
  mut kind : Int
  mut start_time_unix_nano : UInt64
  mut end_time_unix_nano : UInt64
  attributes : Array[KeyValue]
  events : Array[SpanEvent]
  mut status_code : Int
  mut status_message : String
}

let empty_bytes : Bytes = Bytes::new(0)

///|
fn decode_kv_from(r : protobuf::WireReader) -> KeyValue {
  let kv = KeyValue::{ key: "", str_value: "", int_value: 0L }
  while !r.is_eof() {
    let raw_tag = r.read_tag_raw()
    if raw_tag < 0L {
      return kv
    }
    let fnum = (raw_tag >> 3).to_int()
    if fnum == 1 {
      kv.key = r.read_string_raw()
      if r.has_err() {
        return kv
      }
    } else if fnum == 2 {
      kv.str_value = r.read_string_raw()
      if r.has_err() {
        return kv
      }
    } else if fnum == 3 {
      kv.int_value = r.read_int64_raw()
      if r.has_err() {
        return kv
      }
    } else {
      if !r.skip_field_raw(raw_tag, 100) {
        return kv
      }
    }
  }
  kv
}

///|
fn decode_event_from(r : protobuf::WireReader) -> SpanEvent {
  let ev = SpanEvent::{ time_unix_nano: 0UL, name: "", dropped_attributes: 0 }
  while !r.is_eof() {
    let raw_tag = r.read_tag_raw()
    if raw_tag < 0L {
      return ev
    }
    let fnum = (raw_tag >> 3).to_int()
    if fnum == 1 {
      ev.time_unix_nano = r.read_varint64_raw()
      if r.has_err() {
        return ev
      }
    } else if fnum == 2 {
      ev.name = r.read_string_raw()
      if r.has_err() {
        return ev
      }
    } else if fnum == 3 {
      ev.dropped_attributes = r.read_int32_raw()
      if r.has_err() {
        return ev
      }
    } else {
      if !r.skip_field_raw(raw_tag, 100) {
        return ev
      }
    }
  }
  ev
}

///|
fn decode_span_from(r : protobuf::WireReader) -> Span {
  let sp = Span::{
    trace_id: empty_bytes,
    span_id: empty_bytes,
    name: "",
    kind: 0,
    start_time_unix_nano: 0UL,
    end_time_unix_nano: 0UL,
    attributes: [],
    events: [],
    status_code: 0,
    status_message: "",
  }
  while !r.is_eof() {
    let raw_tag = r.read_tag_raw()
    if raw_tag < 0L {
      return sp
    }
    let fnum = (raw_tag >> 3).to_int()
    match fnum {
      1 => {
        sp.trace_id = r.read_bytes_raw()
        if r.has_err() {
          return sp
        }
      }
      2 => {
        sp.span_id = r.read_bytes_raw()
        if r.has_err() {
          return sp
        }
      }
      3 => {
        sp.name = r.read_string_raw()
        if r.has_err() {
          return sp
        }
      }
      4 => {
        sp.kind = r.read_int32_raw()
        if r.has_err() {
          return sp
        }
      }
      5 => {
        sp.start_time_unix_nano = r.read_varint64_raw()
        if r.has_err() {
          return sp
        }
      }
      6 => {
        sp.end_time_unix_nano = r.read_varint64_raw()
        if r.has_err() {
          return sp
        }
      }
      7 => {
        let n = r.read_len_raw()
        if n < 0 {
          return sp
        }
        let saved_end = r.limit()
        r.set_limit(r.pos() + n)
        let kv = decode_kv_from(r)
        if r.has_err() {
          return sp
        }
        r.set_limit(saved_end)
        sp.attributes.push(kv)
      }
      8 => {
        let n = r.read_len_raw()
        if n < 0 {
          return sp
        }
        let saved_end = r.limit()
        r.set_limit(r.pos() + n)
        let ev = decode_event_from(r)
        if r.has_err() {
          return sp
        }
        r.set_limit(saved_end)
        sp.events.push(ev)
      }
      9 => {
        sp.status_code = r.read_int32_raw()
        if r.has_err() {
          return sp
        }
      }
      10 => {
        sp.status_message = r.read_string_raw()
        if r.has_err() {
          return sp
        }
      }
      _ =>
      if !r.skip_field_raw(raw_tag, 100) {
        return sp
      }
    }
  }
  sp
}

///|
fn checksum_span(sp : Span) -> UInt64 {
  let mut h : UInt64 = 0UL
  if sp.trace_id.length() > 0 {
    h = h + sp.trace_id[0].to_int().to_int64().to_uint64() + sp.trace_id[sp.trace_id.length() - 1].to_int().to_int64().to_uint64()
  }
  if sp.span_id.length() > 0 {
    h = h + sp.span_id[0].to_int().to_int64().to_uint64() * 3UL
  }
  h = h + sp.name.length().to_int64().to_uint64() * 7UL
  h = h + sp.kind.to_int64().to_uint64() * 11UL
  h = h + (sp.end_time_unix_nano - sp.start_time_unix_nano)
  let mut i = 0
  while i < sp.attributes.length() {
    let kv = sp.attributes[i]
    h = h + kv.key.length().to_int64().to_uint64() * 13UL
    h = h + kv.str_value.length().to_int64().to_uint64() * 17UL
    h = h + kv.int_value.to_uint64() * 19UL
    i = i + 1
  }
  let mut j = 0
  while j < sp.events.length() {
    let ev = sp.events[j]
    h = h + ev.name.length().to_int64().to_uint64() * 23UL
    h = h + ev.dropped_attributes.to_int64().to_uint64() * 29UL
    j = j + 1
  }
  h = h + sp.status_code.to_int64().to_uint64() * 31UL
  h = h + sp.status_message.length().to_int64().to_uint64() * 37UL
  h
}

///|
fn encode_span_into(w : protobuf::WireWriter, sp : Span) -> Unit {
  let tid = sp.trace_id
  let sid = sp.span_id
  let sname = sp.name
  let smsg = sp.status_message
  let mut p = w.length()
  let mut cap = w.capacity()
  let top_need = 64 + tid.length() + sid.length() + sname.length() + smsg.length()
  if p + top_need > cap {
    w.reserve(top_need)
    cap = w.capacity()
  }
  let mut buf = w.raw_buf()
  if tid.length() > 0 {
    p = protobuf::put_bytes_field(buf, p, 1, tid)
  }
  if sid.length() > 0 {
    p = protobuf::put_bytes_field(buf, p, 2, sid)
  }
  if sname.length() > 0 {
    p = protobuf::put_string_field(buf, p, 3, sname)
  }
  if sp.kind != 0 {
    p = protobuf::put_int32_field(buf, p, 4, sp.kind)
  }
  if sp.start_time_unix_nano != 0UL {
    p = protobuf::put_uint64_field(buf, p, 5, sp.start_time_unix_nano)
  }
  if sp.end_time_unix_nano != 0UL {
    p = protobuf::put_uint64_field(buf, p, 6, sp.end_time_unix_nano)
  }
  let attrs = sp.attributes
  let alen = attrs.length()
  let mut i = 0
  while i < alen {
    let kv = attrs[i]
    let kk = kv.key
    let sv = kv.str_value
    let iv = kv.int_value
    let kl = kk.length()
    let sl = sv.length()
    let mut kv_len = 0
    if kl > 0 {
      kv_len = kv_len + (if kl < 128 { 2 + kl } else { 1 + protobuf::varint_len_u64(kl.to_int64().to_uint64()) + kl })
    }
    if sl > 0 {
      kv_len = kv_len + (if sl < 128 { 2 + sl } else { 1 + protobuf::varint_len_u64(sl.to_int64().to_uint64()) + sl })
    }
    if iv != 0L {
      let iu = iv.to_uint64()
      kv_len = kv_len + (if iu < 0x80UL { 2 } else if iu < 0x4000UL { 3 } else { 1 + protobuf::varint_len_u64(iu) })
    }
    if p + kv_len + 12 > cap {
      w.set_length(p)
      w.reserve(kv_len + 12)
      buf = w.raw_buf()
      cap = w.capacity()
    }
    p = protobuf::put_ld_header(buf, p, 7, kv_len)
    if kl > 0 {
      p = protobuf::put_string_field(buf, p, 1, kk)
    }
    if sl > 0 {
      p = protobuf::put_string_field(buf, p, 2, sv)
    }
    if iv != 0L {
      p = protobuf::put_int64_field(buf, p, 3, iv)
    }
    i = i + 1
  }
  let evs = sp.events
  let elen = evs.length()
  let mut j = 0
  while j < elen {
    let ev = evs[j]
    let t = ev.time_unix_nano
    let ename = ev.name
    let da = ev.dropped_attributes
    let nl = ename.length()
    let mut ev_len = 0
    if t != 0UL {
      ev_len = ev_len + 1 + (if t >= 0x100000000000000UL && t < 0x8000000000000000UL { 9 } else { protobuf::varint_len_u64(t) })
    }
    if nl > 0 {
      ev_len = ev_len + (if nl < 128 { 2 + nl } else { 1 + protobuf::varint_len_u64(nl.to_int64().to_uint64()) + nl })
    }
    if da != 0 {
      ev_len = ev_len + (if da > 0 && da < 128 { 2 } else { 1 + protobuf::varint_len_u64(((da.to_int64() << 32) >> 32).to_uint64()) })
    }
    if p + ev_len + 12 > cap {
      w.set_length(p)
      w.reserve(ev_len + 12)
      buf = w.raw_buf()
      cap = w.capacity()
    }
    p = protobuf::put_ld_header(buf, p, 8, ev_len)
    if t != 0UL {
      p = protobuf::put_uint64_field(buf, p, 1, t)
    }
    if nl > 0 {
      p = protobuf::put_string_field(buf, p, 2, ename)
    }
    if da != 0 {
      p = protobuf::put_int32_field(buf, p, 3, da)
    }
    j = j + 1
  }
  if p + smsg.length() + 24 > cap {
    w.set_length(p)
    w.reserve(smsg.length() + 24)
    buf = w.raw_buf()
  }
  if sp.status_code != 0 {
    p = protobuf::put_int32_field(buf, p, 9, sp.status_code)
  }
  if smsg.length() > 0 {
    p = protobuf::put_string_field(buf, p, 10, smsg)
  }
  w.set_length(p)
}

///|
fn build_sample_spans(count : Int) -> Array[Span] {
  let names = [
    "grpc.order.CreateOrder",
    "grpc.payment.Authorize",
    "http.GET /api/v1/inventory",
    "db.postgres.SELECT orders",
    "redis.HGET session:meta",
    "kafka.produce order-events",
    "auth.VerifyJwtToken",
    "cache.LookupUserProfile",
  ]
  let services = ["checkout-svc", "payment-svc", "inventory-svc", "gateway-edge"]
  let regions = ["ap-northeast-1", "us-west-2", "eu-central-1", "ap-southeast-1"]
  let spans : Array[Span] = []
  let mut idx = 0
  while idx < count {
    let tid = Bytes::new(16)
    let mut k = 0
    while k < 16 {
      tid[k] = ((idx * 31 + k * 17) & 0xFF).to_byte()
      k = k + 1
    }
    let sid = Bytes::new(8)
    k = 0
    while k < 8 {
      sid[k] = ((idx * 13 + k * 29 + 7) & 0xFF).to_byte()
      k = k + 1
    }
    let start_ns : UInt64 = 1700000000000000000UL + (idx.to_int64() * 125000L).to_uint64()
    let end_ns : UInt64 = start_ns + (45000L + ((idx % 997).to_int64() * 100L)).to_uint64()
    let status_code = if (idx % 17) != 0 { 1 } else { 2 }
    let status_msg = if status_code == 1 { "" } else { "upstream deadline exceeded" }
    spans.push(Span::{
      trace_id: tid,
      span_id: sid,
      name: names[idx % names.length()],
      kind: (idx % 5) + 1,
      start_time_unix_nano: start_ns,
      end_time_unix_nano: end_ns,
      attributes: [
        KeyValue::{ key: "service.name", str_value: services[idx % services.length()], int_value: 0L },
        KeyValue::{ key: "cloud.region", str_value: regions[idx % regions.length()], int_value: 0L },
        KeyValue::{ key: "http.status_code", str_value: "", int_value: if (idx % 17) != 0 { 200L } else { 503L } },
        KeyValue::{ key: "rpc.retry_count", str_value: "", int_value: (idx % 4).to_int64() },
      ],
      events: [
        SpanEvent::{ time_unix_nano: start_ns + 5000UL, name: "request.received", dropped_attributes: 0 },
        SpanEvent::{ time_unix_nano: end_ns - 2000UL, name: "response.flushed", dropped_attributes: idx % 3 },
      ],
      status_code: status_code,
      status_message: status_msg,
    })
    idx = idx + 1
  }
  spans
}

///|
fn fnv1a_update(h_in : UInt64, b : Bytes) -> UInt64 {
  let mut h = h_in
  let mut i = 0
  while i < b.length() {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn run_decode_spans(world : World, path : String) -> Int {
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let starts : Array[Int] = []
  let ends : Array[Int] = []
  let mut off = 0
  let total_len = data.length()
  while off + 4 <= total_len {
    let mlen = data[off].to_int() |
    (data[off + 1].to_int() << 8) |
    (data[off + 2].to_int() << 16) |
    (data[off + 3].to_int() << 24)
    off = off + 4
    starts.push(off)
    ends.push(off + mlen)
    off = off + mlen
  }
  let data_str = data.to_string()
  let rd = protobuf::WireReader::slice_with_str(data, data_str, 0, 0)
  let rounds = 50
  let mut total_spans : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut total_checksum : UInt64 = 0UL
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < starts.length() {
      rd.reset_slice(starts[i], ends[i])
      let sp = decode_span_from(rd)
      if rd.has_err() {
        return 2
      }
      total_spans = total_spans + 1L
      total_bytes = total_bytes + (ends[i] - starts[i]).to_int64()
      total_checksum = total_checksum + checksum_span(sp)
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "spans=" + total_spans.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "checksum=" + total_checksum.to_string())
  0
}

///|
fn run_encode_spans(world : World) -> Int {
  let spans = build_sample_spans(2000)
  let rounds = 50
  let w = protobuf::WireWriter::with_capacity(512)
  let mut total_spans : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : UInt64 = 14695981039346656037UL
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < spans.length() {
      w.clear()
      encode_span_into(w, spans[i])
      let elen = w.length()
      total_spans = total_spans + 1L
      total_bytes = total_bytes + elen.to_int64()
      if r == 0 {
        let mut k = 0
        while k < elen {
          hash = (hash ^ w.byte_at(k).to_int().to_int64().to_uint64()) * 1099511628211UL
          k = k + 1
        }
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "spans=" + total_spans.to_string())
  io_println(world, "encoded_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn run_packed_numeric(world : World) -> Int {
  let n = 200000
  let svals : Array[Int64] = []
  let dvals : Array[Double] = []
  let mut i = 0
  while i < n {
    let sign : Int64 = if (i & 1) == 0 { 1L } else { -1L }
    let mag : Int64 = ((i % 1000).to_int64() * 37L) + ((i / 1000).to_int64() * 100003L)
    svals.push(sign * mag)
    dvals.push((i.to_double() * 0.125) - 10000.0)
    i = i + 1
  }
  let rounds = 8
  let w = protobuf::WireWriter::with_capacity(3000000)
  let mut total_encoded : Int64 = 0L
  let mut sint64_sum : Int64 = 0L
  let mut double_xor : UInt64 = 0UL
  let mut r = 0
  while r < rounds {
    w.clear()
    w.write_packed_sint64_field(1, svals)
    w.write_packed_double_field(2, dvals)
    let raw = w.to_bytes()
    total_encoded = total_encoded + raw.length().to_int64()

    let rd = protobuf::WireReader::new(raw)
    while !rd.is_eof() {
      let tag = match rd.read_tag() {
        Ok(t) => t
        Err(_) => return 2
      }
      if tag.field_number == 1 {
        let dec_s = match rd.read_packed_sint64() {
          Ok(xs) => xs
          Err(_) => return 3
        }
        let mut j = 0
        while j < dec_s.length() {
          sint64_sum = sint64_sum + dec_s[j]
          j = j + 1
        }
      } else if tag.field_number == 2 {
        let dec_d = match rd.read_packed_double() {
          Ok(xs) => xs
          Err(_) => return 4
        }
        let mut j = 0
        while j < dec_d.length() {
          double_xor = double_xor ^ dec_d[j].to_bits().to_uint64()
          j = j + 1
        }
      } else {
        match rd.skip_field(tag, 100) {
          Ok(_) => ()
          Err(_) => return 5
        }
      }
    }
    r = r + 1
  }
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "encoded_bytes=" + total_encoded.to_string())
  io_println(world, "sint64_sum=" + sint64_sum.to_string())
  io_println(world, "double_bits_xor=" + double_xor.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_bench <decode_spans|encode_spans|packed_numeric> [corpus]")
    return 1
  }
  let cmd = args[1]
  if cmd == "decode_spans" {
    if args.length() < 3 {
      io_println(world, "missing corpus path")
      return 1
    }
    run_decode_spans(world, args[2])
  } else if cmd == "encode_spans" {
    run_encode_spans(world)
  } else if cmd == "packed_numeric" {
    run_packed_numeric(world)
  } else {
    io_println(world, "unknown cmd: " + cmd)
    1
  }
}
