///| `.proto` v2/v3 schema lexer and AST parser test suite.

///|
test "schema: full proto3 with package, imports, options, nested messages, enum, oneof, map, reserved, comments" {
  let src = "// File header comment\n" +
  "syntax = \"proto3\";\n" +
  "package acme.telemetry.v1;\n" +
  "import \"google/protobuf/timestamp.proto\";\n" +
  "import public \"common/types.proto\";\n" +
  "option go_package = \"acme/telemetry/v1;telemetryv1\";\n" +
  "/* Block comment\n" +
  "   spanning multiple lines */\n" +
  "enum SpanKind {\n" +
  "  option allow_alias = true;\n" +
  "  SPAN_KIND_UNSPECIFIED = 0;\n" +
  "  SPAN_KIND_INTERNAL = 1;\n" +
  "  SPAN_KIND_SERVER = 2;\n" +
  "  SPAN_KIND_SERVER_ALIAS = 2;\n" +
  "  reserved 99, 100 to 105;\n" +
  "  reserved \"OLD_KIND\";\n" +
  "}\n" +
  "message Span {\n" +
  "  message Attribute {\n" +
  "    string key = 1;\n" +
  "    oneof val {\n" +
  "      string str_val = 2;\n" +
  "      int64 int_val = 3;\n" +
  "      bool bool_val = 4;\n" +
  "    }\n" +
  "  }\n" +
  "  enum Status {\n" +
  "    STATUS_UNSET = 0;\n" +
  "    STATUS_OK = 1;\n" +
  "    STATUS_ERROR = 2;\n" +
  "  }\n" +
  "  bytes trace_id = 1;\n" +
  "  string span_name = 2 [json_name = \"customSpanName\"];\n" +
  "  SpanKind kind = 3;\n" +
  "  Status status = 4;\n" +
  "  repeated Attribute attributes = 5;\n" +
  "  map<string, int64> metrics = 6;\n" +
  "  optional int32 sample_rate = 7;\n" +
  "  repeated sint64 timings = 8 [packed = true];\n" +
  "  reserved 10, 12 to 15, 20 to max;\n" +
  "  reserved \"legacy_field\", \"deprecated_id\";\n" +
  "}\n"

  let schema = match parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "parse_schema failed: " + error_message(e))
      return
    }
  }
  match schema.syntax {
    Syntax::Proto3 => ()
    Syntax::Proto2 => debug_assert(false, "expected proto3")
  }
  debug_assert(schema.package_name == "acme.telemetry.v1", "package_name mismatch")
  debug_assert(schema.imports.length() == 2, "imports count")
  debug_assert(schema.imports[0] == "google/protobuf/timestamp.proto", "import 0")
  debug_assert(schema.imports[1] == "common/types.proto", "import 1")
  debug_assert(schema.options.length() == 1, "file options count")
  debug_assert(schema.options[0].name == "go_package", "go_package option")

  let span = match schema_find_message(schema, "Span") {
    Some(m) => m
    None => {
      debug_assert(false, "Span message not found")
      return
    }
  }
  debug_assert(span.full_name == "acme.telemetry.v1.Span", "full_name: " + span.full_name)
  debug_assert(span.fields.length() == 8, "Span field count: " + span.fields.length().to_string())
  debug_assert(span.nested_messages.length() == 1, "nested message count")
  debug_assert(span.nested_enums.length() == 1, "nested enum count")
  debug_assert(span.reserved_ranges.length() == 3, "reserved ranges count")
  debug_assert(span.reserved_names.length() == 2, "reserved names count")
  debug_assert(span.fields[1].json_name == "customSpanName", "custom json_name")
  debug_assert(span.fields[0].json_name == "traceId", "default camelCase json_name: " + span.fields[0].json_name)
  match span.fields[5].field_type {
    FieldType::Map(FieldType::String, FieldType::Int64) => ()
    _ => debug_assert(false, "expected map<string, int64>")
  }

  let attr = match schema_find_message(schema, "Span.Attribute") {
    Some(m) => m
    None => {
      debug_assert(false, "nested Span.Attribute not found")
      return
    }
  }
  debug_assert(attr.oneofs.length() == 1, "oneof count")
  debug_assert(attr.oneofs[0].name == "val", "oneof name")
  debug_assert(attr.oneofs[0].field_numbers.length() == 3, "oneof field count")

  let kind_enum = match schema_find_enum(schema, "SpanKind") {
    Some(e) => e
    None => {
      debug_assert(false, "SpanKind enum not found")
      return
    }
  }
  debug_assert(kind_enum.values.length() == 4, "SpanKind values")
}

///|
test "schema: proto2 syntax with required, optional, repeated, default, negative enum" {
  let src = "syntax = \"proto2\";\n" +
  "enum LegacyCode {\n" +
  "  ERR_UNKNOWN = -1;\n" +
  "  OK = 0;\n" +
  "}\n" +
  "message Record {\n" +
  "  required int64 id = 1;\n" +
  "  optional string label = 2 [default = \"none\"];\n" +
  "  repeated int32 scores = 3 [packed = false];\n" +
  "}\n"
  let schema = match parse_schema(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "proto2 parse failed: " + error_message(e))
      return
    }
  }
  match schema.syntax {
    Syntax::Proto2 => ()
    Syntax::Proto3 => debug_assert(false, "expected proto2")
  }
  let rec = match schema_find_message(schema, "Record") {
    Some(m) => m
    None => {
      debug_assert(false, "Record not found")
      return
    }
  }
  match rec.fields[0].label {
    FieldLabel::Required => ()
    _ => debug_assert(false, "expected required")
  }
  match rec.fields[1].default_value {
    Some(d) => debug_assert(d == "none", "default value mismatch: " + d)
    None => debug_assert(false, "expected default value")
  }
  match rec.fields[2].packed {
    Some(p) => debug_assert(!p, "expected packed=false")
    None => debug_assert(false, "expected explicit packed option")
  }
  let code_enum = match schema_find_enum(schema, "LegacyCode") {
    Some(e) => e
    None => {
      debug_assert(false, "LegacyCode not found")
      return
    }
  }
  debug_assert(code_enum.values[0].number == -1, "negative enum value")
}

///|
test "schema: reject invalid field numbers, reserved 19000..19999, duplicate tags, invalid map keys" {
  let bad_cases : Array[String] = [
    "syntax = \"proto3\"; message A { int32 x = 0; }",
    "syntax = \"proto3\"; message A { int32 x = 536870912; }",
    "syntax = \"proto3\"; message A { int32 x = 19000; }",
    "syntax = \"proto3\"; message A { int32 x = 19999; }",
    "syntax = \"proto3\"; message A { int32 x = 1; string y = 1; }",
    "syntax = \"proto3\"; message A { map<double, string> m = 1; }",
    "syntax = \"proto3\"; message A { map<bytes, string> m = 1; }",
    "syntax = \"proto3\"; message A { map<float, int32> m = 1; }",
    "syntax = \"proto3\"; message Unclosed { int32 x = 1;",
  ]
  let mut i = 0
  while i < bad_cases.length() {
    match parse_schema(bad_cases[i]) {
      Ok(_) => debug_assert(false, "expected schema error for case " + i.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "schema: multi-file parse_schemas cross-file linking" {
  let file1 = "syntax = \"proto3\"; package shared.v1; message SharedId { string id = 1; }"
  let file2 = "syntax = \"proto3\"; package app.v1; message Order { shared.v1.SharedId order_id = 1; }"
  let s = match parse_schemas([file1, file2]) {
    Ok(sc) => sc
    Err(e) => {
      debug_assert(false, "parse_schemas failed: " + error_message(e))
      return
    }
  }
  let w = WireWriter::new()
  let sub = WireWriter::new()
  sub.write_string_field(1, "ord-42")
  w.write_subwriter_field(1, sub)
  match decode_dynamic_default(s, "app.v1.Order", w.to_bytes()) {
    Ok(m) =>
    match to_proto3_json(s, m) {
      Ok(js) => debug_assert(js == "{\"orderId\":{\"id\":\"ord-42\"}}", "got: " + js)
      Err(e) => debug_assert(false, error_message(e))
    }
    Err(e) => debug_assert(false, error_message(e))
  }
}
