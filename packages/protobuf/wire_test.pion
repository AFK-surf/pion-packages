///| Protocol Buffers v2/v3 wire format compliance test suite.

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    debug_assert(false, "invalid hex char")
    0
  }
}

///|
fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length()
  debug_assert(n % 2 == 0, "hex string must have even length")
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn nibble_to_hex(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (97 + n - 10).to_byte()
  }
}

///|
fn bytes_to_hex(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_byte(nibble_to_hex((v >> 4) & 15))
    sb.write_byte(nibble_to_hex(v & 15))
    i = i + 1
  }
  sb.to_string()
}

///|
test "wire: varint official vectors 1..10 bytes" {
  let cases : Array[(UInt64, String)] = [
    (0UL, "00"),
    (1UL, "01"),
    (127UL, "7f"),
    (128UL, "8001"),
    (150UL, "9601"),
    (300UL, "ac02"),
    (16383UL, "ff7f"),
    (16384UL, "808001"),
    (2147483647UL, "ffffffff07"),
    (4294967295UL, "ffffffff0f"),
    (9223372036854775807UL, "ffffffffffffffff7f"),
    (18446744073709551615UL, "ffffffffffffffffff01"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (v, expected_hex) = cases[i]
    let w = WireWriter::new()
    w.write_varint64(v)
    let encoded = w.to_bytes()
    debug_assert(
      bytes_to_hex(encoded) == expected_hex,
      "varint encode mismatch for " + v.to_string() + ": got " + bytes_to_hex(encoded) + ", want " + expected_hex,
    )
    debug_assert(
      varint_len_u64(v) == encoded.length(),
      "varint_len_u64 mismatch for " + v.to_string(),
    )
    let r = WireReader::new(encoded)
    match r.read_varint64() {
      Ok(got) => {
        debug_assert(got == v, "varint decode mismatch")
        debug_assert(r.is_eof(), "reader should be at EOF")
      }
      Err(e) => debug_assert(false, "varint decode failed: " + error_message(e))
    }
    i = i + 1
  }
}

///|
test "wire: int32 negative 10-byte sign-extended encoding" {
  let w = WireWriter::new()
  w.write_int32_field(1, -1)
  w.write_int32_field(2, -2)
  w.write_int32_field(3, -2147483648)
  let raw = w.to_bytes()
  debug_assert(
    bytes_to_hex(raw) == "08ffffffffffffffffff0110feffffffffffffffff011880808080f8ffffffff01",
    "negative int32 encoding mismatch: " + bytes_to_hex(raw),
  )
  let r = WireReader::new(raw)
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 1 && wire_type_eq(t.wire_type, WireType::Varint), "tag 1")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_int32() {
    Ok(v) => debug_assert(v == -1, "want -1")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 2, "tag 2")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_int32() {
    Ok(v) => debug_assert(v == -2, "want -2")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 3, "tag 3")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_int32() {
    Ok(v) => debug_assert(v == -2147483648, "want INT32_MIN")
    Err(e) => debug_assert(false, error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

///|
test "wire: zigzag sint32 and sint64 official vectors" {
  let z32 : Array[(Int, Int64)] = [
    (0, 0L),
    (-1, 1L),
    (1, 2L),
    (-2, 3L),
    (2, 4L),
    (2147483647, 4294967294L),
    (-2147483648, 4294967295L),
  ]
  let mut i = 0
  while i < z32.length() {
    let (s, u) = z32[i]
    debug_assert(zigzag_encode_i32(s) == u, "zigzag32 encode mismatch")
    debug_assert(zigzag_decode_i32(u) == s, "zigzag32 decode mismatch")
    i = i + 1
  }
  let z64 : Array[(Int64, UInt64)] = [
    (0L, 0UL),
    (-1L, 1UL),
    (1L, 2UL),
    (-2L, 3UL),
    (2L, 4UL),
    (9223372036854775807L, 18446744073709551614UL),
    (-9223372036854775808L, 18446744073709551615UL),
  ]
  let mut j = 0
  while j < z64.length() {
    let (s, u) = z64[j]
    debug_assert(zigzag_encode_i64(s) == u, "zigzag64 encode mismatch")
    debug_assert(zigzag_decode_i64(u) == s, "zigzag64 decode mismatch")
    j = j + 1
  }
}

///|
test "wire: official Protobuf encoding guide Test1/Test2/Test3/Test4" {
  // Test1: a = 150 -> 08 96 01
  let w1 = WireWriter::new()
  w1.write_int32_field(1, 150)
  debug_assert(bytes_to_hex(w1.to_bytes()) == "089601", "Test1 mismatch")

  // Test2: b = "testing" -> 12 07 74 65 73 74 69 6e 67
  let w2 = WireWriter::new()
  w2.write_string_field(2, "testing")
  debug_assert(bytes_to_hex(w2.to_bytes()) == "120774657374696e67", "Test2 mismatch")

  // Test3: c = Test1{a=150} -> 1a 03 08 96 01
  let w3 = WireWriter::new()
  w3.write_bytes_field(3, w1.to_bytes())
  debug_assert(bytes_to_hex(w3.to_bytes()) == "1a03089601", "Test3 mismatch")

  // Test4: packed repeated int32 d = [3, 270, 86942] -> 22 06 03 8e 02 9e a7 05
  let w4 = WireWriter::new()
  w4.write_packed_int32_field(4, [3, 270, 86942])
  debug_assert(bytes_to_hex(w4.to_bytes()) == "2206038e029ea705", "Test4 mismatch: " + bytes_to_hex(w4.to_bytes()))

  let r4 = WireReader::new(w4.to_bytes())
  match r4.read_tag() {
    Ok(t) => debug_assert(t.field_number == 4 && wire_type_eq(t.wire_type, WireType::LengthDelimited), "Test4 tag")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r4.read_packed_int32() {
    Ok(arr) => {
      debug_assert(arr.length() == 3, "Test4 len")
      debug_assert(arr[0] == 3 && arr[1] == 270 && arr[2] == 86942, "Test4 values")
    }
    Err(e) => debug_assert(false, error_message(e))
  }
}

///|
test "wire: fixed32, sfixed32, float, fixed64, sfixed64, double little-endian" {
  let w = WireWriter::new()
  w.write_fixed32_field(1, 0x12345678L)
  w.write_sfixed32_field(2, -123456)
  w.write_float_field(3, 1.5)
  w.write_float_field(4, -2.25)
  w.write_fixed64_field(5, 0x0102030405060708UL)
  w.write_sfixed64_field(6, -9876543210123L)
  w.write_double_field(7, 1.5)
  w.write_double_field(8, -3.141592653589793)

  let raw = w.to_bytes()
  // Verify exact LE bytes for field 1 (fixed32: tag=0d, val=78563412)
  debug_assert(bytes_to_hex(raw.slice(0, 5)) == "0d78563412", "fixed32 LE bytes")

  let r = WireReader::new(raw)
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 1 && wire_type_eq(t.wire_type, WireType::Fixed32), "f1")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_fixed32() {
    Ok(v) => debug_assert(v == 0x12345678L, "f1 val")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 2 && wire_type_eq(t.wire_type, WireType::Fixed32), "f2")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_sfixed32() {
    Ok(v) => debug_assert(v == -123456, "f2 val")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 3 && wire_type_eq(t.wire_type, WireType::Fixed32), "f3")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_float() {
    Ok(v) => debug_assert(v == 1.5, "f3 float 1.5")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 4 && wire_type_eq(t.wire_type, WireType::Fixed32), "f4")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_float() {
    Ok(v) => debug_assert(v == -2.25, "f4 float -2.25")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 5 && wire_type_eq(t.wire_type, WireType::Fixed64), "f5")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_fixed64() {
    Ok(v) => debug_assert(v == 0x0102030405060708UL, "f5 val")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 6 && wire_type_eq(t.wire_type, WireType::Fixed64), "f6")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_sfixed64() {
    Ok(v) => debug_assert(v == -9876543210123L, "f6 val")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 7 && wire_type_eq(t.wire_type, WireType::Fixed64), "f7")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_double() {
    Ok(v) => debug_assert(v == 1.5, "f7 double 1.5")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 8 && wire_type_eq(t.wire_type, WireType::Fixed64), "f8")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_double() {
    Ok(v) => debug_assert(v.to_bits() == (-3.141592653589793).to_bits(), "f8 double pi")
    Err(e) => debug_assert(false, error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

///|
test "wire: tag boundary values 1..536870911 and reserved range validation" {
  let w = WireWriter::new()
  w.write_tag(1, WireType::Varint)
  w.write_tag(15, WireType::LengthDelimited)
  w.write_tag(16, WireType::Varint)
  w.write_tag(536870911, WireType::Fixed32)
  let raw = w.to_bytes()
  debug_assert(bytes_to_hex(raw) == "087a8001fdffffff0f", "tag bytes: " + bytes_to_hex(raw))

  let r = WireReader::new(raw)
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 1 && wire_type_eq(t.wire_type, WireType::Varint), "t1")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 15 && wire_type_eq(t.wire_type, WireType::LengthDelimited), "t15")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 16 && wire_type_eq(t.wire_type, WireType::Varint), "t16")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 536870911 && wire_type_eq(t.wire_type, WireType::Fixed32), "tMax")
    Err(e) => debug_assert(false, error_message(e))
  }

  match validate_field_number(0, false) {
    Err(ProtoError::InvalidFieldNumber(_, _)) => ()
    _ => debug_assert(false, "field 0 must fail")
  }
  match validate_field_number(536870912, false) {
    Err(ProtoError::InvalidFieldNumber(_, _)) => ()
    _ => debug_assert(false, "field > max must fail")
  }
  match validate_field_number(19000, true) {
    Err(ProtoError::ReservedFieldNumber(19000, _)) => ()
    _ => debug_assert(false, "reserved 19000 must fail when reject_reserved=true")
  }
  match validate_field_number(19999, true) {
    Err(ProtoError::ReservedFieldNumber(19999, _)) => ()
    _ => debug_assert(false, "reserved 19999 must fail when reject_reserved=true")
  }
  match validate_field_number(18999, true) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "18999 should be valid: " + error_message(e))
  }
  match validate_field_number(20000, true) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "20000 should be valid: " + error_message(e))
  }
}

///|
test "wire: start/end group skip and nested group pairing" {
  // field 1 StartGroup (0b), inner field 2 varint 42 (10 2a),
  // inner field 3 StartGroup (1b), inner field 4 fixed32 1 (25 01000000),
  // inner field 3 EndGroup (1c), field 1 EndGroup (0c), trailing field 5 varint 7 (28 07)
  let raw = hex_to_bytes("0b102a1b25010000001c0c2807")
  let r = WireReader::new(raw)
  let t1 = match r.read_tag() {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, error_message(e))
      Tag::{ field_number: 0, wire_type: WireType::Varint }
    }
  }
  debug_assert(t1.field_number == 1 && wire_type_eq(t1.wire_type, WireType::StartGroup), "start group 1")
  match r.skip_field(t1, 100) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "skip nested group failed: " + error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 5 && wire_type_eq(t.wire_type, WireType::Varint), "trailing tag 5")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_uint64() {
    Ok(v) => debug_assert(v == 7UL, "trailing val 7")
    Err(e) => debug_assert(false, error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

///|
test "wire: packed sint64 and packed double roundtrip" {
  let w = WireWriter::new()
  let svals : Array[Int64] = [0L, -1L, 1L, -1000000L, 9223372036854775807L, -9223372036854775808L]
  let dvals : Array[Double] = [0.0, -0.0, 1.5, -2.75, 1e100, -1e-100]
  w.write_packed_sint64_field(1, svals)
  w.write_packed_double_field(2, dvals)
  let raw = w.to_bytes()
  let r = WireReader::new(raw)
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 1 && wire_type_eq(t.wire_type, WireType::LengthDelimited), "packed sint64 tag")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_packed_sint64() {
    Ok(got) => {
      debug_assert(got.length() == svals.length(), "sint64 len")
      let mut i = 0
      while i < svals.length() {
        debug_assert(got[i] == svals[i], "sint64 elem " + i.to_string())
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 2 && wire_type_eq(t.wire_type, WireType::LengthDelimited), "packed double tag")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_packed_double() {
    Ok(got) => {
      debug_assert(got.length() == dvals.length(), "double len")
      let mut i = 0
      while i < dvals.length() {
        debug_assert(got[i].to_bits() == dvals[i].to_bits(), "double elem " + i.to_string())
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

///|
test "wire: valid UTF-8 multibyte strings (CJK and 4-byte emoji)" {
  let w = WireWriter::new()
  let sample = "Hello, 世界! 🚀✨"
  w.write_string_field(1, sample)
  let r = WireReader::new(w.to_bytes())
  match r.read_tag() {
    Ok(t) => debug_assert(t.field_number == 1, "tag 1")
    Err(e) => debug_assert(false, error_message(e))
  }
  match r.read_string() {
    Ok(s) => debug_assert(s == sample, "utf8 roundtrip mismatch")
    Err(e) => debug_assert(false, error_message(e))
  }
}
