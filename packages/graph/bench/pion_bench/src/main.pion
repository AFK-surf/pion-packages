///| Head-to-head benchmark harness for `packages/graph`
///| Workloads:
///|   w1_dijkstra   / w1_dijkstra_csr  : 50k nodes, 250k edges weighted Dijkstra (3 rounds)
///|   w2_scc_topo   / w2_scc_topo_csr  : 100k nodes, 400k edges Tarjan SCC + 100k/400k DAG Toposort
///|   w3_kruskal                       : 50k nodes, 200k edges undirected Kruskal MST
///|   w4_dominators / w4_dominators_csr: 20k nodes, 60k edges CFG Dominators (5 rounds)

import "graph"

///| Deterministic LCG matching the Rust harness bit-for-bit.
fn next_u64(state : UInt64) -> UInt64 {
  state * 6364136223846793005UL + 1442695040888963407UL
}

///|
fn u64_mod_int(x : UInt64, m : Int) -> Int {
  (x % m.to_int64().to_uint64()).to_int()
}

///|
fn bench_dijkstra(world : World, use_csr : Bool) -> Int {
  let n = 50000
  let m = 250000
  let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::with_capacity(n, m)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut state : UInt64 = 0x123456789abcdef0UL
  let mut j = 0
  while j < n - 1 {
    state = next_u64(state)
    let w = ((state >> 32) % 1000UL + 1UL).to_int64()
    let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new(j + 1), w)
    j = j + 1
  }
  let rem = m - (n - 1)
  let mut k = 0
  while k < rem {
    state = next_u64(state)
    let u = u64_mod_int(state >> 32, n)
    state = next_u64(state)
    let v = u64_mod_int(state >> 32, n)
    state = next_u64(state)
    let w = ((state >> 32) % 1000UL + 1UL).to_int64()
    let _ = g.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), w)
    k = k + 1
  }

  let csr_opt = if use_csr { Some(graph::CsrGraph::from_digraph(g)) } else { None }
  let rounds = 3
  let mut r = 0
  let mut sum_dist : Int64 = 0L
  let mut xor_dist : Int64 = 0L
  let mut reach_cnt = 0
  while r < rounds {
    let sp = match csr_opt {
      Some(csr) =>
      match graph::csr_dijkstra(csr, graph::NodeId::new(0), None) {
        Ok(res) => res
        Err(_) => return 1
      }
      None =>
      match graph::dijkstra_i64(g, graph::NodeId::new(0), None) {
        Ok(res) => res
        Err(_) => return 1
      }
    }
    if r == rounds - 1 {
      let mut v = 0
      while v < n {
        if sp.reachable[v] {
          reach_cnt = reach_cnt + 1
          let d = sp.distances[v]
          sum_dist = sum_dist + d
          xor_dist = xor_dist ^ d
        }
        v = v + 1
      }
    }
    r = r + 1
  }
  io_println(world, "mode=dijkstra")
  io_println(world, "nodes=" + n.to_string())
  io_println(world, "edges=" + m.to_string())
  io_println(world, "reachable=" + reach_cnt.to_string())
  io_println(world, "sum_dist=" + sum_dist.to_string())
  io_println(world, "xor_dist=" + xor_dist.to_string())
  0
}

///|
fn bench_scc_topo(world : World, use_csr : Bool) -> Int {
  let n = 100000
  let m = 400000
  let g_scc : graph::DiGraph[Unit, Unit] = graph::DiGraph::with_capacity(n, m)
  let mut i = 0
  while i < n {
    let _ = g_scc.add_node(())
    i = i + 1
  }
  let mut state : UInt64 = 0xfeedfacecafebeefUL
  let mut e = 0
  while e < m {
    state = next_u64(state)
    let u = u64_mod_int(state >> 32, n)
    state = next_u64(state)
    let offset = ((state >> 32) % 32UL).to_int() - 16
    let v = (u + offset + n) % n
    let _ = g_scc.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), ())
    e = e + 1
  }

  let g_dag : graph::DiGraph[Unit, Unit] = graph::DiGraph::with_capacity(n, m)
  let mut i2 = 0
  while i2 < n {
    let _ = g_dag.add_node(())
    i2 = i2 + 1
  }
  let mut state2 : UInt64 = 0xabcdef0123456789UL
  let mut e2 = 0
  while e2 < m {
    state2 = next_u64(state2)
    let u = u64_mod_int(state2 >> 32, n - 1)
    state2 = next_u64(state2)
    let max_span = n - 1 - u
    let span_lim = if max_span < 64 { max_span } else { 64 }
    let delta = u64_mod_int(state2 >> 32, span_lim) + 1
    let v = u + delta
    let _ = g_dag.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), ())
    e2 = e2 + 1
  }

  let sccs = if use_csr {
    let csr_scc = graph::CsrGraph::from_digraph(g_scc)
    graph::csr_tarjan_scc(csr_scc)
  } else {
    graph::tarjan_scc(g_scc)
  }

  let order = if use_csr {
    let csr_dag = graph::CsrGraph::from_digraph(g_dag)
    match graph::csr_toposort(csr_dag) {
      Ok(o) => o
      Err(_) => return 1
    }
  } else {
    match graph::toposort(g_dag) {
      Ok(o) => o
      Err(_) => return 1
    }
  }

  let mut max_scc = 0
  let mut sum_sq : Int64 = 0L
  let comp : FixedArray[Int] = FixedArray::make(n, -1)
  let mut ci = 0
  while ci < sccs.length() {
    let sz = sccs[ci].length()
    if sz > max_scc {
      max_scc = sz
    }
    let sz64 = sz.to_int64()
    sum_sq = sum_sq + sz64 * sz64
    let mut j = 0
    while j < sz {
      comp[sccs[ci][j].index] = ci
      j = j + 1
    }
    ci = ci + 1
  }

  let mut rev_topo_ok = 1
  let mut ei = 0
  while ei < m {
    if comp[g_scc.edge_src[ei]] < comp[g_scc.edge_dst[ei]] {
      rev_topo_ok = 0
      break
    }
    ei = ei + 1
  }

  let pos : FixedArray[Int] = FixedArray::make(n, -1)
  let mut pi = 0
  while pi < order.length() {
    pos[order[pi].index] = pi
    pi = pi + 1
  }
  let mut topo_ok = 1
  let mut ej = 0
  while ej < m {
    if pos[g_dag.edge_src[ej]] >= pos[g_dag.edge_dst[ej]] {
      topo_ok = 0
      break
    }
    ej = ej + 1
  }

  io_println(world, "mode=scc_topo")
  io_println(world, "nodes=" + n.to_string())
  io_println(world, "edges=" + m.to_string())
  io_println(world, "scc_count=" + sccs.length().to_string())
  io_println(world, "max_scc=" + max_scc.to_string())
  io_println(world, "sum_sq_scc=" + sum_sq.to_string())
  io_println(world, "rev_topo_ok=" + rev_topo_ok.to_string())
  io_println(world, "topo_len=" + order.length().to_string())
  io_println(world, "topo_ok=" + topo_ok.to_string())
  0
}

///|
fn bench_kruskal(world : World) -> Int {
  let n = 50000
  let m = 200000
  let g : graph::UnGraph[Unit, Int64] = graph::UnGraph::with_capacity(n, m)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut state : UInt64 = 0x0123456789abcdefUL
  let mut j = 0
  while j < n - 1 {
    state = next_u64(state)
    let w = ((state >> 32) % 1000000UL + 1UL).to_int64()
    let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new(j + 1), w)
    j = j + 1
  }
  let rem = m - (n - 1)
  let mut k = 0
  while k < rem {
    state = next_u64(state)
    let u = u64_mod_int(state >> 32, n)
    state = next_u64(state)
    let v = u64_mod_int(state >> 32, n)
    state = next_u64(state)
    let w = ((state >> 32) % 1000000UL + 1UL).to_int64()
    let _ = g.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), w)
    k = k + 1
  }

  let res = match graph::kruskal_mst_i64(g) {
    Ok(r) => r
    Err(_) => return 1
  }
  io_println(world, "mode=kruskal")
  io_println(world, "nodes=" + n.to_string())
  io_println(world, "edges=" + m.to_string())
  io_println(world, "mst_edges=" + res.edges.length().to_string())
  io_println(world, "total_weight=" + res.total_weight.to_string())
  0
}

///|
fn bench_dominators(world : World, use_csr : Bool) -> Int {
  let n = 20000
  let m = 60000
  let g : graph::DiGraph[Unit, Unit] = graph::DiGraph::with_capacity(n, m)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut j = 0
  while j < n - 1 {
    let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new(j + 1), ())
    j = j + 1
  }
  let mut state : UInt64 = 0xdeadbeef1337c0deUL
  let rem = m - (n - 1)
  let mut k = 0
  while k < rem {
    state = next_u64(state)
    let u = u64_mod_int(state >> 32, n - 2) + 1
    state = next_u64(state)
    let r = (state >> 32) % 10UL
    let v = if r < 7UL {
      let step = ((state >> 16) % 16UL).to_int() + 1
      let cand = u + step
      if cand < n {
        cand
      } else {
        n - 1
      }
    } else {
      let step = ((state >> 16) % 8UL).to_int() + 1
      let cand = u - step
      if cand > 0 {
        cand
      } else {
        1
      }
    }
    let _ = g.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), ())
    k = k + 1
  }

  let csr_opt = if use_csr { Some(graph::CsrGraph::from_digraph(g)) } else { None }
  let rounds = 5
  let mut r = 0
  let mut dom_cnt = 0
  let mut sum_idom : Int64 = 0L
  let mut xor_idom : Int64 = 0L
  while r < rounds {
    let dom = match csr_opt {
      Some(csr) =>
      match graph::csr_dominators(csr, graph::NodeId::new(0)) {
        Ok(d) => d
        Err(_) => return 1
      }
      None =>
      match graph::dominators(g, graph::NodeId::new(0)) {
        Ok(d) => d
        Err(_) => return 1
      }
    }
    if r == rounds - 1 {
      let mut v = 1
      while v < n {
        match dom.immediate_dominator(graph::NodeId::new(v)) {
          Some(p) => {
            dom_cnt = dom_cnt + 1
            let pi = p.index.to_int64()
            sum_idom = sum_idom + pi
            xor_idom = xor_idom ^ (v.to_int64() * 31L + pi)
          }
          None => ()
        }
        v = v + 1
      }
    }
    r = r + 1
  }
  io_println(world, "mode=dominators")
  io_println(world, "nodes=" + n.to_string())
  io_println(world, "edges=" + m.to_string())
  io_println(world, "dominated_count=" + dom_cnt.to_string())
  io_println(world, "sum_idom=" + sum_idom.to_string())
  io_println(world, "xor_idom=" + xor_idom.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(
      world,
      "usage: graph_bench_pion <w1_dijkstra|w1_dijkstra_csr|w2_scc_topo|w2_scc_topo_csr|w3_kruskal|w4_dominators|w4_dominators_csr>",
    )
    return 1
  }
  let mode = args[1]
  if mode == "w1_dijkstra" {
    bench_dijkstra(world, false)
  } else if mode == "w1_dijkstra_csr" {
    bench_dijkstra(world, true)
  } else if mode == "w2_scc_topo" {
    bench_scc_topo(world, false)
  } else if mode == "w2_scc_topo_csr" {
    bench_scc_topo(world, true)
  } else if mode == "w3_kruskal" {
    bench_kruskal(world)
  } else if mode == "w4_dominators" {
    bench_dominators(world, false)
  } else if mode == "w4_dominators_csr" {
    bench_dominators(world, true)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
