///| Day-1 red-team adversarial test suite for `packages/graph`.
///| Covers 100k-node deep chains (zero stack overflow), invalid IDs, empty/isolated graphs,
///| self-loops, parallel edges, negative weights in Dijkstra/A*, Int64 weight overflow,
///| and Dinic worst-case Ford-Fulkerson graphs.

///|
test "redteam_100k_chain_zero_stack_overflow" {
  let n = 100000
  let g : DiGraph[Unit, Int64] = DiGraph::with_capacity(n, n - 1)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut j = 0
  while j < n - 1 {
    match g.add_edge(NodeId::new(j), NodeId::new(j + 1), 1L) {
      Ok(_) => ()
      Err(_) => debug_assert(false, "chain add_edge failed")
    }
    j = j + 1
  }

  // 1. Iterative BFS
  match bfs(g, NodeId::new(0)) {
    Ok(order) => {
      debug_assert(order.length() == n, "100k bfs length")
      debug_assert(order[0].index == 0 && order[n - 1].index == n - 1, "100k bfs endpoints")
    }
    Err(e) => debug_assert(false, "100k bfs failed: " + graph_error_to_string(e))
  }

  // 2. Iterative DFS preorder, postorder, dfs_full
  match dfs_preorder(g, NodeId::new(0)) {
    Ok(order) => {
      debug_assert(order.length() == n, "100k dfs_preorder length")
      debug_assert(order[0].index == 0 && order[n - 1].index == n - 1, "100k dfs_preorder endpoints")
    }
    Err(e) => debug_assert(false, "100k dfs_preorder failed: " + graph_error_to_string(e))
  }
  match dfs_postorder(g, NodeId::new(0)) {
    Ok(order) => {
      debug_assert(order.length() == n, "100k dfs_postorder length")
      debug_assert(order[0].index == n - 1 && order[n - 1].index == 0, "100k dfs_postorder reversed")
    }
    Err(e) => debug_assert(false, "100k dfs_postorder failed: " + graph_error_to_string(e))
  }
  let times = dfs_full(g)
  debug_assert(times.preorder.length() == n && times.postorder.length() == n, "100k dfs_full")

  // 3. Iterative Tarjan SCC & Kosaraju SCC
  let t_sccs = tarjan_scc(g)
  debug_assert(t_sccs.length() == n, "100k tarjan_scc count")
  debug_assert(t_sccs[0][0].index == n - 1, "100k tarjan_scc sink first")
  debug_assert(t_sccs[n - 1][0].index == 0, "100k tarjan_scc source last")

  let k_sccs = kosaraju_scc(g)
  debug_assert(k_sccs.length() == n, "100k kosaraju_scc count")
  debug_assert(k_sccs[0][0].index == n - 1, "100k kosaraju_scc sink first")

  // 4. Iterative Kahn toposort & find_cycle
  match toposort(g) {
    Ok(order) => {
      debug_assert(order.length() == n, "100k toposort length")
      debug_assert(order[0].index == 0 && order[n - 1].index == n - 1, "100k toposort order")
    }
    Err(e) => debug_assert(false, "100k toposort failed: " + graph_error_to_string(e))
  }
  match find_cycle(g) {
    None => ()
    Some(_) => debug_assert(false, "100k chain acyclic")
  }

  // 5. Iterative Dominators
  match dominators(g, NodeId::new(0)) {
    Ok(dom) => {
      match dom.immediate_dominator(NodeId::new(0)) {
        None => ()
        Some(_) => debug_assert(false, "100k dom root")
      }
      match dom.immediate_dominator(NodeId::new(1)) {
        Some(id) => debug_assert(id.index == 0, "100k idom 1")
        None => debug_assert(false, "100k idom 1 missing")
      }
      match dom.immediate_dominator(NodeId::new(n - 1)) {
        Some(id) => debug_assert(id.index == n - 2, "100k idom n-1")
        None => debug_assert(false, "100k idom n-1 missing")
      }
    }
    Err(e) => debug_assert(false, "100k dominators failed: " + graph_error_to_string(e))
  }

  // 6. Close the 100k chain into a 100k cycle -> single SCC + 100k cycle
  match g.add_edge(NodeId::new(n - 1), NodeId::new(0), 1L) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "close 100k cycle failed")
  }
  let cyc_sccs = tarjan_scc(g)
  debug_assert(cyc_sccs.length() == 1 && cyc_sccs[0].length() == n, "100k cycle single SCC")
  match find_cycle(g) {
    Some(cyc) => debug_assert(cyc.length() == n, "100k find_cycle len 100000")
    None => debug_assert(false, "100k cycle not found")
  }
}

///|
test "redteam_100k_undirected_chain_bridges_and_articulation" {
  let n = 100000
  let g : UnGraph[Unit, Unit] = UnGraph::with_capacity(n, n - 1)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut j = 0
  while j < n - 1 {
    match g.add_edge(NodeId::new(j), NodeId::new(j + 1), ()) {
      Ok(_) => ()
      Err(_) => debug_assert(false, "ungraph chain add_edge failed")
    }
    j = j + 1
  }
  let br = bridges(g)
  debug_assert(br.length() == n - 1, "100k chain has 99999 bridges")
  let aps = articulation_points(g)
  debug_assert(aps.length() == n - 2, "100k chain has 99998 articulation points")
  let bip = is_bipartite(g)
  debug_assert(bip.is_bipartite, "100k chain is bipartite")
}

///|
test "redteam_invalid_ids_and_empty_graphs" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let bad_neg = NodeId::new(-1)
  let bad_oob = NodeId::new(999)

  match g.add_edge(bad_neg, bad_oob, 1L) {
    Err(InvalidNode(idx)) => debug_assert(idx == -1, "add_edge invalid -1")
    _ => debug_assert(false, "add_edge invalid")
  }
  match g.node_weight(bad_neg) {
    None => ()
    Some(_) => debug_assert(false, "node_weight invalid")
  }
  match g.edge_weight(EdgeId::new(-1)) {
    None => ()
    Some(_) => debug_assert(false, "edge_weight invalid")
  }
  match g.remove_node(bad_oob) {
    None => ()
    Some(_) => debug_assert(false, "remove_node invalid")
  }
  match g.remove_edge(EdgeId::new(0)) {
    None => ()
    Some(_) => debug_assert(false, "remove_edge invalid")
  }
  match bfs(g, bad_neg) {
    Err(InvalidNode(idx)) => debug_assert(idx == -1, "bfs invalid")
    _ => debug_assert(false, "bfs invalid")
  }
  match dfs_preorder(g, bad_oob) {
    Err(InvalidNode(idx)) => debug_assert(idx == 999, "dfs invalid")
    _ => debug_assert(false, "dfs invalid")
  }
  match dfs_postorder(g, bad_oob) {
    Err(InvalidNode(idx)) => debug_assert(idx == 999, "dfs_post invalid")
    _ => debug_assert(false, "dfs_post invalid")
  }
  match dominators(g, bad_neg) {
    Err(InvalidNode(idx)) => debug_assert(idx == -1, "dominators invalid")
    _ => debug_assert(false, "dominators invalid")
  }
  match dijkstra(g, bad_oob, None, fn(w) { w }) {
    Err(InvalidNode(idx)) => debug_assert(idx == 999, "dijkstra invalid")
    _ => debug_assert(false, "dijkstra invalid")
  }
  match astar(g, bad_neg, fn(_) { true }, fn(w) { w }, fn(_) { 0L }) {
    Err(InvalidNode(idx)) => debug_assert(idx == -1, "astar invalid")
    _ => debug_assert(false, "astar invalid")
  }
  match bellman_ford(g, bad_oob, fn(w) { w }) {
    Err(InvalidNode(idx)) => debug_assert(idx == 999, "bellman_ford invalid")
    _ => debug_assert(false, "bellman_ford invalid")
  }
  match dinic_max_flow(g, bad_neg, bad_oob, fn(c) { c }) {
    Err(InvalidNode(idx)) => debug_assert(idx == -1, "dinic invalid")
    _ => debug_assert(false, "dinic invalid")
  }

  // Empty graph results
  debug_assert(tarjan_scc(g).length() == 0, "empty tarjan_scc")
  debug_assert(kosaraju_scc(g).length() == 0, "empty kosaraju_scc")
  match toposort(g) {
    Ok(ord) => debug_assert(ord.length() == 0, "empty toposort")
    Err(_) => debug_assert(false, "empty toposort should succeed")
  }
  match find_cycle(g) {
    None => ()
    Some(_) => debug_assert(false, "empty find_cycle")
  }
  match floyd_warshall(g, fn(w) { w }) {
    Ok(apsp) => debug_assert(apsp.node_count == 0, "empty floyd_warshall")
    Err(_) => debug_assert(false, "empty floyd_warshall should succeed")
  }
  let ug : UnGraph[Unit, Int64] = UnGraph::new()
  debug_assert(connected_component_count(ug) == 0, "empty ungraph comps")
  debug_assert(is_bipartite(ug).is_bipartite, "empty ungraph is bipartite")
  match kruskal_mst(ug, fn(w) { w }) {
    Ok(m) => debug_assert(m.edges.length() == 0 && m.total_weight == 0L, "empty kruskal")
    Err(_) => debug_assert(false, "empty kruskal should succeed")
  }
  match prim_mst(ug, fn(w) { w }) {
    Ok(m) => debug_assert(m.edges.length() == 0 && m.total_weight == 0L, "empty prim")
    Err(_) => debug_assert(false, "empty prim should succeed")
  }
}

///|
test "redteam_self_loops_and_parallel_edges" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let _ = g.add_edge(n0, n0, 5L)
  let _ = g.add_edge(n0, n1, 100L)
  let _ = g.add_edge(n0, n1, 3L) // cheaper parallel edge
  debug_assert(is_cyclic(g), "self-loop is cyclic")
  match find_cycle(g) {
    Some(cyc) => debug_assert(cyc.length() == 1 && cyc[0].index == 0, "self-loop cycle [0]")
    None => debug_assert(false, "self-loop cycle must be found")
  }
  match dijkstra(g, n0, None, fn(w) { w }) {
    Ok(sp) =>
    match sp.distance(n1) {
      Some(d) => debug_assert(d == 3L, "dijkstra picks min parallel edge")
      None => debug_assert(false, "dijkstra distance missing")
    }
    Err(e) => debug_assert(false, "dijkstra parallel failed: " + graph_error_to_string(e))
  }

  let ug : UnGraph[Unit, Int64] = UnGraph::new()
  let u0 = ug.add_node(())
  let u1 = ug.add_node(())
  let _ = ug.add_edge(u0, u0, 1L)
  let _ = ug.add_edge(u0, u1, 50L)
  let _ = ug.add_edge(u0, u1, 2L)
  debug_assert(!is_bipartite(ug).is_bipartite, "self-loop is not bipartite")
  match kruskal_mst(ug, fn(w) { w }) {
    Ok(m) => debug_assert(m.edges.length() == 1 && m.total_weight == 2L, "kruskal ignores self-loop and picks min parallel")
    Err(e) => debug_assert(false, "kruskal failed: " + graph_error_to_string(e))
  }
  match prim_mst(ug, fn(w) { w }) {
    Ok(m) => debug_assert(m.edges.length() == 1 && m.total_weight == 2L, "prim ignores self-loop and picks min parallel")
    Err(e) => debug_assert(false, "prim failed: " + graph_error_to_string(e))
  }
}

///|
test "redteam_negative_weights_and_int64_overflow" {
  // 1. Negative edge weight passed to Dijkstra and A*
  let g_neg : DiGraph[Unit, Int64] = DiGraph::new()
  let a = g_neg.add_node(())
  let b = g_neg.add_node(())
  let _ = g_neg.add_edge(a, b, -1L)
  match dijkstra(g_neg, a, None, fn(w) { w }) {
    Err(NegativeWeight(w)) => debug_assert(w == -1L, "dijkstra negative weight -1")
    _ => debug_assert(false, "dijkstra must reject negative edge weight")
  }
  match astar(g_neg, a, fn(n) { n.index == 1 }, fn(w) { w }, fn(_) { 0L }) {
    Err(NegativeWeight(w)) => debug_assert(w == -1L, "astar negative weight -1")
    _ => debug_assert(false, "astar must reject negative edge weight")
  }

  // 2. Int64 weight addition overflow in Dijkstra, A*, Bellman-Ford, Floyd-Warshall
  let g_ovf : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g_ovf.add_node(())
  let n1 = g_ovf.add_node(())
  let n2 = g_ovf.add_node(())
  let _ = g_ovf.add_edge(n0, n1, MAX_I64 - 5L)
  let _ = g_ovf.add_edge(n1, n2, 10L)
  match dijkstra(g_ovf, n0, None, fn(w) { w }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "dijkstra must reject Int64 overflow")
  }
  match astar(g_ovf, n0, fn(n) { n.index == 2 }, fn(w) { w }, fn(_) { 0L }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "astar must reject Int64 overflow")
  }
  match bellman_ford(g_ovf, n0, fn(w) { w }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "bellman_ford must reject Int64 overflow")
  }
  match floyd_warshall(g_ovf, fn(w) { w }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "floyd_warshall must reject Int64 overflow")
  }

  // 3. Int64 overflow in Kruskal & Prim MST
  let ug_ovf : UnGraph[Unit, Int64] = UnGraph::new()
  let u0 = ug_ovf.add_node(())
  let u1 = ug_ovf.add_node(())
  let u2 = ug_ovf.add_node(())
  let _ = ug_ovf.add_edge(u0, u1, MAX_I64 - 5L)
  let _ = ug_ovf.add_edge(u1, u2, 10L)
  match kruskal_mst(ug_ovf, fn(w) { w }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "kruskal must reject Int64 total_weight overflow")
  }
  match prim_mst(ug_ovf, fn(w) { w }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "prim must reject Int64 total_weight overflow")
  }
}

///|
test "redteam_dinic_degenerate_diamond_and_negative_capacity" {
  // Classic Ford-Fulkerson exponential trap:
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let s = g.add_node(())
  let a = g.add_node(())
  let b = g.add_node(())
  let t = g.add_node(())
  let big : Int64 = 1000000000L
  let _ = g.add_edge(s, a, big)
  let _ = g.add_edge(s, b, big)
  let _ = g.add_edge(a, b, 1L)
  let _ = g.add_edge(a, t, big)
  let _ = g.add_edge(b, t, big)
  match dinic_max_flow(g, s, t, fn(c) { c }) {
    Ok(res) => debug_assert(res.max_flow == 2000000000L, "dinic degenerate diamond == 2e9")
    Err(e) => debug_assert(false, "dinic diamond failed: " + graph_error_to_string(e))
  }

  // Negative capacity rejected
  let g_neg : DiGraph[Unit, Int64] = DiGraph::new()
  let x = g_neg.add_node(())
  let y = g_neg.add_node(())
  let _ = g_neg.add_edge(x, y, -5L)
  match dinic_max_flow(g_neg, x, y, fn(c) { c }) {
    Err(NegativeCapacity(c)) => debug_assert(c == -5L, "dinic negative capacity -5")
    _ => debug_assert(false, "dinic must reject negative capacity")
  }

  // Flow total overflow rejected (two parallel edges of MAX_I64 - 1)
  let g_ovf : DiGraph[Unit, Int64] = DiGraph::new()
  let p = g_ovf.add_node(())
  let q = g_ovf.add_node(())
  let _ = g_ovf.add_edge(p, q, MAX_I64 - 1L)
  let _ = g_ovf.add_edge(p, q, MAX_I64 - 1L)
  match dinic_max_flow(g_ovf, p, q, fn(c) { c }) {
    Err(WeightOverflow) => ()
    _ => debug_assert(false, "dinic must reject Int64 max_flow overflow")
  }
}
