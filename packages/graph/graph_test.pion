///| Upstream `petgraph` compliance & textbook graph-theory test suite (Red -> Green).

///|
fn assert_node_ids(got : Array[NodeId], expected : Array[Int], label : String) -> Unit {
  debug_assert(
    got.length() == expected.length(),
    label + ": length mismatch, expected " + expected.length().to_string() + ", got " + got.length().to_string(),
  )
  let mut i = 0
  while i < expected.length() {
    debug_assert(
      got[i].index == expected[i],
      label + ": at index " + i.to_string() + ", expected " + expected[i].to_string() + ", got " + got[i].index.to_string(),
    )
    i = i + 1
  }
}

///|
fn assert_opt_i64(got : Option[Int64], expected : Int64, label : String) -> Unit {
  match got {
    Some(v) =>
    debug_assert(v == expected, label + ": expected " + expected.to_string() + ", got " + v.to_string())
    None => debug_assert(false, label + ": expected Some(" + expected.to_string() + "), got None")
  }
}

///|
fn assert_opt_none[T](got : Option[T], label : String) -> Unit {
  match got {
    None => ()
    Some(_) => debug_assert(false, label + ": expected None, got Some")
  }
}

///|
fn assert_opt_str(got : Option[String], expected : String, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected " + expected + ", got " + v)
    None => debug_assert(false, label + ": expected Some(" + expected + "), got None")
  }
}

///|
fn assert_opt_int(got : Option[Int], expected : Int, label : String) -> Unit {
  match got {
    Some(v) =>
    debug_assert(v == expected, label + ": expected " + expected.to_string() + ", got " + v.to_string())
    None => debug_assert(false, label + ": expected Some(" + expected.to_string() + "), got None")
  }
}

///|
fn assert_opt_node(got : Option[NodeId], expected : Int, label : String) -> Unit {
  match got {
    Some(n) =>
    debug_assert(
      n.index == expected,
      label + ": expected NodeId(" + expected.to_string() + "), got " + n.index.to_string(),
    )
    None => debug_assert(false, label + ": expected Some(NodeId(" + expected.to_string() + ")), got None")
  }
}

///|
fn assert_opt_edge(got : Option[EdgeId], expected : Int, label : String) -> Unit {
  match got {
    Some(e) =>
    debug_assert(
      e.index == expected,
      label + ": expected EdgeId(" + expected.to_string() + "), got " + e.index.to_string(),
    )
    None => debug_assert(false, label + ": expected Some(EdgeId(" + expected.to_string() + ")), got None")
  }
}

///|
fn assert_ok_bool(got : Result[Bool, GraphError], expected : Bool, label : String) -> Unit {
  match got {
    Ok(b) => debug_assert(b == expected, label)
    Err(e) => debug_assert(false, label + ": unexpected err " + graph_error_to_string(e))
  }
}

///|
fn must_add_di_edge[N, E](g : DiGraph[N, E], u : NodeId, v : NodeId, w : E) -> EdgeId {
  match g.add_edge(u, v, w) {
    Ok(e) => e
    Err(err) => {
      debug_assert(false, "unexpected add_edge error: " + graph_error_to_string(err))
      EdgeId::new(-1)
    }
  }
}

///|
fn must_add_un_edge[N, E](g : UnGraph[N, E], u : NodeId, v : NodeId, w : E) -> EdgeId {
  match g.add_edge(u, v, w) {
    Ok(e) => e
    Err(err) => {
      debug_assert(false, "unexpected ungraph add_edge error: " + graph_error_to_string(err))
      EdgeId::new(-1)
    }
  }
}

///|
fn contains_node_id(arr : Array[NodeId], target : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i].index == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn contains_edge_id(arr : Array[EdgeId], target : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i].index == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "digraph_core_mutations_multiedges_and_self_loops" {
  let g : DiGraph[String, Int64] = DiGraph::new()
  debug_assert(g.node_count() == 0, "empty node_count")
  debug_assert(g.edge_count() == 0, "empty edge_count")

  let a = g.add_node("A")
  let b = g.add_node("B")
  let c = g.add_node("C")
  let d = g.add_node("D")
  debug_assert(g.node_count() == 4, "4 nodes")
  debug_assert(g.has_node(a) && g.has_node(d), "valid nodes")
  debug_assert(!g.has_node(NodeId::new(-1)) && !g.has_node(NodeId::new(4)), "invalid nodes")

  // Parallel edges + self-loop
  let e0 = must_add_di_edge(g, a, b, 10L)
  let e1 = must_add_di_edge(g, a, b, 20L)
  let e2 = must_add_di_edge(g, b, c, 30L)
  let e3 = must_add_di_edge(g, c, d, 40L)
  let e4 = must_add_di_edge(g, a, a, 5L)
  debug_assert(g.edge_count() == 5, "5 edges")
  debug_assert(g.out_degree(a) == 3, "a out_degree == 3")
  debug_assert(g.in_degree(a) == 1, "a in_degree == 1 (self-loop)")
  debug_assert(g.in_degree(b) == 2, "b in_degree == 2 (parallel edges)")
  debug_assert(g.contains_edge(a, b), "a->b exists")
  debug_assert(!g.contains_edge(b, a), "b->a absent")
  assert_opt_edge(g.find_edge(a, a), e4.index, "self-loop found")

  // Weight get/set
  assert_opt_str(g.node_weight(b), "B", "node weight B")
  assert_opt_i64(g.edge_weight(e1), 20L, "edge weight e1")
  match g.set_node_weight(b, "B2") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "set_node_weight failed")
  }
  assert_opt_str(g.node_weight(b), "B2", "updated node weight B2")
  match g.set_edge_weight(e0, 15L) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "set_edge_weight failed")
  }
  assert_opt_i64(g.edge_weight(e0), 15L, "updated edge weight e0")

  // Remove edge e0 (swap-remove last edge e4 into slot 0)
  assert_opt_i64(g.remove_edge(e0), 15L, "removed e0 weight 15")
  debug_assert(g.edge_count() == 4, "4 edges after remove_edge")
  debug_assert(g.out_degree(a) == 2, "a out_degree == 2")
  debug_assert(g.in_degree(b) == 1, "b in_degree == 1")
  debug_assert(g.contains_edge(a, a), "self-loop still present after swap-remove")

  // Remove node b (swap-remove last node d into slot 1)
  assert_opt_str(g.remove_node(b), "B2", "removed node b")
  debug_assert(g.node_count() == 3, "3 nodes after remove_node")
  // Edges incident to b (e1: a->b, e2: b->c) removed; remaining: a->a and c->(d now at index 1)
  debug_assert(g.edge_count() == 2, "2 edges after remove_node")
  let moved_d = NodeId::new(1)
  assert_opt_str(g.node_weight(moved_d), "D", "d moved into index 1")
  debug_assert(g.contains_edge(c, moved_d), "edge c->d preserved with reindexed endpoint")
  debug_assert(g.in_degree(moved_d) == 1, "moved d in_degree == 1")
  debug_assert(g.out_degree(c) == 1, "c out_degree == 1")
  let _ = e2
  let _ = e3
}

///|
test "ungraph_core_mutations_multiedges_and_self_loops" {
  let g : UnGraph[String, Int64] = UnGraph::new()
  let a = g.add_node("A")
  let b = g.add_node("B")
  let c = g.add_node("C")
  let e0 = must_add_un_edge(g, a, b, 3L)
  let e1 = must_add_un_edge(g, a, b, 7L)
  let e2 = must_add_un_edge(g, b, c, 5L)
  let e3 = must_add_un_edge(g, c, c, 1L)
  debug_assert(g.node_count() == 3, "ungraph 3 nodes")
  debug_assert(g.edge_count() == 4, "ungraph 4 edges")
  debug_assert(g.contains_edge(a, b) && g.contains_edge(b, a), "undirected symmetry")
  debug_assert(g.degree(a) == 2, "a degree == 2")
  debug_assert(g.degree(b) == 3, "b degree == 3")
  debug_assert(g.degree(c) == 2, "c degree == 2 (b-c and self-loop c-c)")
  assert_opt_i64(g.remove_edge(e0), 3L, "remove e0")
  debug_assert(g.edge_count() == 3, "3 edges left")
  debug_assert(g.contains_edge(b, a), "parallel edge e1 still connects a-b")
  assert_opt_str(g.remove_node(b), "B", "remove node b")
  debug_assert(g.node_count() == 2, "2 nodes left")
  debug_assert(g.edge_count() == 1, "only self-loop left")
  let moved_c = NodeId::new(1)
  assert_opt_str(g.node_weight(moved_c), "C", "c moved to index 1")
  debug_assert(g.contains_edge(moved_c, moved_c), "self-loop preserved")
  let _ = e1
  let _ = e2
  let _ = e3
}

///|
test "csr_graph_construction_and_queries" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let n3 = g.add_node(())
  let _ = must_add_di_edge(g, n0, n1, 4L)
  let _ = must_add_di_edge(g, n0, n2, 1L)
  let _ = must_add_di_edge(g, n2, n1, 2L)
  let _ = must_add_di_edge(g, n1, n3, 1L)
  let _ = must_add_di_edge(g, n2, n3, 5L)

  let csr = CsrGraph::from_digraph(g)
  debug_assert(csr.node_count() == 4, "csr node_count")
  debug_assert(csr.edge_count() == 5, "csr edge_count")
  debug_assert(csr.out_degree(n0) == 2, "csr n0 out_degree")
  debug_assert(csr.out_degree(n3) == 0, "csr n3 out_degree")

  match csr_dijkstra(csr, n0, None) {
    Ok(sp) => {
      assert_opt_i64(sp.distance(n0), 0L, "csr dist 0")
      assert_opt_i64(sp.distance(n1), 3L, "csr dist 1 == 3")
      assert_opt_i64(sp.distance(n2), 1L, "csr dist 2 == 1")
      assert_opt_i64(sp.distance(n3), 4L, "csr dist 3 == 4")
    }
    Err(e) => debug_assert(false, "csr_dijkstra failed: " + graph_error_to_string(e))
  }

  let sccs = csr_tarjan_scc(csr)
  debug_assert(sccs.length() == 4, "csr_tarjan_scc 4 singletons")
  match csr_toposort(csr) {
    Ok(order) => assert_node_ids(order, [0, 2, 1, 3], "csr_toposort")
    Err(e) => debug_assert(false, "csr_toposort failed: " + graph_error_to_string(e))
  }
  match csr_dominators(csr, n0) {
    Ok(dom) => {
      assert_opt_none(dom.immediate_dominator(n0), "csr dom root")
      assert_opt_node(dom.immediate_dominator(n1), 0, "csr idom(1) == 0")
      assert_opt_node(dom.immediate_dominator(n2), 0, "csr idom(2) == 0")
      assert_opt_node(dom.immediate_dominator(n3), 0, "csr idom(3) == 0")
    }
    Err(e) => debug_assert(false, "csr_dominators failed: " + graph_error_to_string(e))
  }
}

///|
test "union_find_petgraph_vectors" {
  // Ported from petgraph/tests/unionfind.rs: uf_test & uf_test_with_equiv
  let u = UnionFind::new(8)
  debug_assert(u.len() == 8, "uf len 8")
  debug_assert(u.component_count() == 8, "uf 8 components")
  let mut i = 0
  while i < 8 {
    assert_opt_int(u.find(i), i, "uf initial root")
    assert_ok_bool(u.union(i, i), false, "uf self union false")
    assert_ok_bool(u.equiv(i, i), true, "uf self equiv true")
    i = i + 1
  }
  assert_ok_bool(u.union(0, 1), true, "union 0,1")
  assert_ok_bool(u.equiv(0, 1), true, "equiv 0,1")
  assert_ok_bool(u.union(1, 3), true, "union 1,3")
  assert_ok_bool(u.union(1, 4), true, "union 1,4")
  assert_ok_bool(u.union(4, 7), true, "union 4,7")
  assert_ok_bool(u.equiv(0, 3), true, "equiv 0,3")
  assert_ok_bool(u.equiv(0, 7), true, "equiv 0,7")
  assert_ok_bool(u.equiv(0, 2), false, "not equiv 0,2")
  assert_ok_bool(u.union(5, 6), true, "union 5,6")
  assert_ok_bool(u.equiv(6, 5), true, "equiv 6,5")
  assert_ok_bool(u.equiv(6, 7), false, "not equiv 6,7")
  debug_assert(u.component_count() == 3, "3 disjoint sets remain")
  assert_opt_none(u.find(-1), "out of bounds find -1")
  assert_opt_none(u.find(8), "out of bounds find 8")
}

///|
test "bfs_and_dfs_traversals" {
  let g : DiGraph[Unit, Unit] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let n3 = g.add_node(())
  let n4 = g.add_node(())
  let _ = must_add_di_edge(g, n0, n1, ())
  let _ = must_add_di_edge(g, n0, n2, ())
  let _ = must_add_di_edge(g, n1, n3, ())
  let _ = must_add_di_edge(g, n2, n3, ())
  let _ = must_add_di_edge(g, n3, n4, ())

  match bfs(g, n0) {
    Ok(order) => assert_node_ids(order, [0, 1, 2, 3, 4], "bfs order")
    Err(e) => debug_assert(false, "bfs failed: " + graph_error_to_string(e))
  }
  match dfs_preorder(g, n0) {
    Ok(order) => assert_node_ids(order, [0, 1, 3, 4, 2], "dfs preorder")
    Err(e) => debug_assert(false, "dfs_preorder failed: " + graph_error_to_string(e))
  }
  match dfs_postorder(g, n0) {
    Ok(order) => assert_node_ids(order, [4, 3, 1, 2, 0], "dfs postorder")
    Err(e) => debug_assert(false, "dfs_postorder failed: " + graph_error_to_string(e))
  }
  let times = dfs_full(g)
  debug_assert(times.preorder.length() == 5, "dfs_full preorder len")
  debug_assert(times.postorder.length() == 5, "dfs_full postorder len")
  debug_assert(times.discovery[0] < times.discovery[1], "d[0] < d[1]")
  debug_assert(times.finish[4] < times.finish[3], "f[4] < f[3]")
  debug_assert(times.finish[3] < times.finish[0], "f[3] < f[0]")
}

///|
test "tarjan_and_kosaraju_scc_reverse_topological_order" {
  // Classic CLRS SCC graph (8 nodes, 4 SCCs)
  let g : DiGraph[Unit, Unit] = DiGraph::new()
  let mut i = 0
  while i < 8 {
    let _ = g.add_node(())
    i = i + 1
  }
  // SCC A: {0, 1, 4}
  let _ = must_add_di_edge(g, NodeId::new(0), NodeId::new(1), ())
  let _ = must_add_di_edge(g, NodeId::new(1), NodeId::new(4), ())
  let _ = must_add_di_edge(g, NodeId::new(4), NodeId::new(0), ())
  // SCC B: {2, 3}
  let _ = must_add_di_edge(g, NodeId::new(2), NodeId::new(3), ())
  let _ = must_add_di_edge(g, NodeId::new(3), NodeId::new(2), ())
  // SCC C: {5, 6}
  let _ = must_add_di_edge(g, NodeId::new(5), NodeId::new(6), ())
  let _ = must_add_di_edge(g, NodeId::new(6), NodeId::new(5), ())
  // SCC D: {7} (sink with self-loop)
  let _ = must_add_di_edge(g, NodeId::new(7), NodeId::new(7), ())
  // Cross-SCC edges: A -> B, A -> C, B -> C, B -> D, C -> D
  let _ = must_add_di_edge(g, NodeId::new(1), NodeId::new(2), ())
  let _ = must_add_di_edge(g, NodeId::new(1), NodeId::new(5), ())
  let _ = must_add_di_edge(g, NodeId::new(4), NodeId::new(5), ())
  let _ = must_add_di_edge(g, NodeId::new(2), NodeId::new(6), ())
  let _ = must_add_di_edge(g, NodeId::new(3), NodeId::new(7), ())
  let _ = must_add_di_edge(g, NodeId::new(6), NodeId::new(7), ())

  let t_sccs = tarjan_scc(g)
  let k_sccs = kosaraju_scc(g)
  debug_assert(t_sccs.length() == 4, "tarjan 4 SCCs")
  debug_assert(k_sccs.length() == 4, "kosaraju 4 SCCs")

  let check_rev_topo = fn(sccs : Array[Array[NodeId]], name : String) -> Unit {
    let comp : FixedArray[Int] = FixedArray::make(8, -1)
    let mut ci = 0
    while ci < sccs.length() {
      let mut j = 0
      while j < sccs[ci].length() {
        comp[sccs[ci][j].index] = ci
        j = j + 1
      }
      ci = ci + 1
    }
    let mut u = 0
    while u < 8 {
      debug_assert(comp[u] >= 0, name + ": every node assigned")
      let nbrs = g.neighbors_out(NodeId::new(u))
      let mut k = 0
      while k < nbrs.length() {
        let v = nbrs[k].index
        debug_assert(comp[u] >= comp[v], name + ": reverse topological order violated")
        k = k + 1
      }
      u = u + 1
    }
    debug_assert(comp[7] == 0, name + ": sink SCC {7} must be index 0")
    debug_assert(comp[0] == comp[1] && comp[1] == comp[4], name + ": {0,1,4} same SCC")
    debug_assert(comp[2] == comp[3], name + ": {2,3} same SCC")
    debug_assert(comp[5] == comp[6], name + ": {5,6} same SCC")
    debug_assert(comp[0] == 3, name + ": source SCC {0,1,4} must be last")
  }
  check_rev_topo(t_sccs, "tarjan")
  check_rev_topo(k_sccs, "kosaraju")
}

///|
test "bridges_petgraph_vectors_and_parallel_edges" {
  // Ported from petgraph/src/algo/bridges.rs
  let g : UnGraph[Int, Int] = UnGraph::new()
  debug_assert(bridges(g).length() == 0, "empty graph 0 bridges")
  let n0 = g.add_node(0)
  let n1 = g.add_node(1)
  let n2 = g.add_node(2)
  let n3 = g.add_node(3)
  let n4 = g.add_node(4)
  let n5 = g.add_node(5)
  let e0 = must_add_un_edge(g, n0, n1, 0)
  let e1 = must_add_un_edge(g, n1, n2, 1)
  let _ = must_add_un_edge(g, n2, n3, 2)
  let _ = must_add_un_edge(g, n3, n4, 3)
  let _ = must_add_un_edge(g, n2, n4, 4)
  let e5 = must_add_un_edge(g, n5, n2, 5)

  let br = bridges(g)
  debug_assert(br.length() == 3, "3 bridges expected")
  debug_assert(contains_edge_id(br, e0.index), "e0 is bridge")
  debug_assert(contains_edge_id(br, e1.index), "e1 is bridge")
  debug_assert(contains_edge_id(br, e5.index), "e5 is bridge")

  // Adding a parallel edge between n0 and n1 removes e0 from bridges!
  let _ = must_add_un_edge(g, n0, n1, 6)
  let br2 = bridges(g)
  debug_assert(br2.length() == 2, "parallel edge eliminates n0-n1 bridge")
  debug_assert(!contains_edge_id(br2, e0.index), "e0 no longer bridge")
  debug_assert(contains_edge_id(br2, e1.index), "e1 still bridge")
  debug_assert(contains_edge_id(br2, e5.index), "e5 still bridge")
}

///|
test "articulation_points_petgraph_vectors" {
  // Ported from petgraph/tests/articulation_points.rs
  let g1 : UnGraph[Unit, Unit] = UnGraph::new()
  let a = g1.add_node(())
  let b = g1.add_node(())
  let c = g1.add_node(())
  let d = g1.add_node(())
  let e = g1.add_node(())
  let f = g1.add_node(())
  let _ = must_add_un_edge(g1, a, b, ())
  let _ = must_add_un_edge(g1, b, c, ())
  let _ = must_add_un_edge(g1, d, e, ())
  let _ = must_add_un_edge(g1, e, f, ())
  assert_node_ids(articulation_points(g1), [1, 4], "art two components")

  let g2 : UnGraph[Unit, Unit] = UnGraph::new()
  let center = g2.add_node(())
  let s1 = g2.add_node(())
  let s2 = g2.add_node(())
  let s3 = g2.add_node(())
  let _ = must_add_un_edge(g2, center, s1, ())
  let _ = must_add_un_edge(g2, center, s2, ())
  let _ = must_add_un_edge(g2, center, s3, ())
  assert_node_ids(articulation_points(g2), [0], "art star")

  let g3 : UnGraph[Unit, Unit] = UnGraph::new()
  let mut i = 0
  while i < 9 {
    let _ = g3.add_node(())
    i = i + 1
  }
  let _ = must_add_un_edge(g3, NodeId::new(0), NodeId::new(1), ())
  let _ = must_add_un_edge(g3, NodeId::new(1), NodeId::new(2), ())
  let _ = must_add_un_edge(g3, NodeId::new(0), NodeId::new(3), ())
  let _ = must_add_un_edge(g3, NodeId::new(1), NodeId::new(4), ())
  let _ = must_add_un_edge(g3, NodeId::new(2), NodeId::new(5), ())
  let _ = must_add_un_edge(g3, NodeId::new(3), NodeId::new(4), ())
  let _ = must_add_un_edge(g3, NodeId::new(4), NodeId::new(5), ())
  let _ = must_add_un_edge(g3, NodeId::new(3), NodeId::new(6), ())
  let _ = must_add_un_edge(g3, NodeId::new(4), NodeId::new(7), ())
  let _ = must_add_un_edge(g3, NodeId::new(5), NodeId::new(8), ())
  let _ = must_add_un_edge(g3, NodeId::new(6), NodeId::new(7), ())
  let _ = must_add_un_edge(g3, NodeId::new(7), NodeId::new(8), ())
  debug_assert(articulation_points(g3).length() == 0, "3x3 grid has no articulation points")
  debug_assert(connected_component_count(g1) == 2, "g1 has 2 connected components")
  debug_assert(connected_components(g1).length() == 2, "g1 connected_components len 2")
}

///|
test "bipartite_2_coloring" {
  let g1 : UnGraph[Unit, Unit] = UnGraph::new()
  let n0 = g1.add_node(())
  let n1 = g1.add_node(())
  let n2 = g1.add_node(())
  let n3 = g1.add_node(())
  let _ = g1.add_node(())
  let _ = must_add_un_edge(g1, n0, n1, ())
  let _ = must_add_un_edge(g1, n1, n2, ())
  let _ = must_add_un_edge(g1, n2, n3, ())
  let _ = must_add_un_edge(g1, n3, n0, ())
  let r1 = is_bipartite(g1)
  debug_assert(r1.is_bipartite, "C4 is bipartite")
  debug_assert(r1.colors[0] != r1.colors[1], "adjacent different colors")
  debug_assert(r1.colors[1] != r1.colors[2], "adjacent different colors")
  debug_assert(r1.colors[2] != r1.colors[3], "adjacent different colors")
  debug_assert(r1.colors[3] != r1.colors[0], "adjacent different colors")

  let g2 : UnGraph[Unit, Unit] = UnGraph::new()
  let a = g2.add_node(())
  let b = g2.add_node(())
  let c = g2.add_node(())
  let _ = must_add_un_edge(g2, a, b, ())
  let _ = must_add_un_edge(g2, b, c, ())
  let _ = must_add_un_edge(g2, c, a, ())
  debug_assert(!is_bipartite(g2).is_bipartite, "C3 is not bipartite")
}

///|
test "toposort_lexicographical_and_find_cycle" {
  let dag : DiGraph[Unit, Unit] = DiGraph::new()
  let n0 = dag.add_node(())
  let n1 = dag.add_node(())
  let n2 = dag.add_node(())
  let n3 = dag.add_node(())
  let _ = must_add_di_edge(dag, n2, n0, ())
  let _ = must_add_di_edge(dag, n1, n0, ())
  let _ = must_add_di_edge(dag, n3, n1, ())

  match toposort(dag) {
    Ok(order) => assert_node_ids(order, [2, 3, 1, 0], "lex smallest toposort")
    Err(e) => debug_assert(false, "toposort failed: " + graph_error_to_string(e))
  }
  debug_assert(!is_cyclic(dag), "dag is not cyclic")
  assert_opt_none(find_cycle(dag), "dag has no cycle")

  // Add back-edge 0 -> 3 creating cycle 3 -> 1 -> 0 -> 3
  let _ = must_add_di_edge(dag, n0, n3, ())
  debug_assert(is_cyclic(dag), "graph now cyclic")
  match toposort(dag) {
    Err(HasCycle(_)) => ()
    _ => debug_assert(false, "toposort must fail with HasCycle")
  }
  match find_cycle(dag) {
    Some(cyc) => {
      debug_assert(cyc.length() == 3, "cycle length 3")
      let mut i = 0
      while i < cyc.length() {
        let u = cyc[i]
        let v = cyc[(i + 1) % cyc.length()]
        debug_assert(dag.contains_edge(u, v), "cycle edge exists")
        i = i + 1
      }
    }
    None => debug_assert(false, "find_cycle must find cycle")
  }
}

///|
test "dominators_and_dominance_frontiers_ssa_cfg" {
  let g : DiGraph[Unit, Unit] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let n3 = g.add_node(())
  let n4 = g.add_node(())
  let n5 = g.add_node(())
  let n6 = g.add_node(())
  let _ = must_add_di_edge(g, n0, n1, ())
  let _ = must_add_di_edge(g, n1, n2, ())
  let _ = must_add_di_edge(g, n1, n3, ())
  let _ = must_add_di_edge(g, n2, n4, ())
  let _ = must_add_di_edge(g, n3, n4, ())
  let _ = must_add_di_edge(g, n4, n1, ())
  let _ = must_add_di_edge(g, n4, n5, ())

  let dom = match dominators(g, n0) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "dominators failed: " + graph_error_to_string(e))
      return
    }
  }
  assert_opt_none(dom.immediate_dominator(n0), "idom(root) == None")
  assert_opt_node(dom.immediate_dominator(n1), 0, "idom(1) == 0")
  assert_opt_node(dom.immediate_dominator(n2), 1, "idom(2) == 1")
  assert_opt_node(dom.immediate_dominator(n3), 1, "idom(3) == 1")
  assert_opt_node(dom.immediate_dominator(n4), 1, "idom(4) == 1")
  assert_opt_node(dom.immediate_dominator(n5), 4, "idom(5) == 4")
  assert_opt_none(dom.immediate_dominator(n6), "idom(unreachable) == None")

  debug_assert(dom.dominates(n0, n5), "0 dom 5")
  debug_assert(dom.dominates(n1, n4), "1 dom 4")
  debug_assert(dom.dominates(n4, n4), "4 dom 4")
  debug_assert(!dom.dominates(n2, n4), "2 !dom 4")
  debug_assert(!dom.dominates(n0, n6), "0 !dom unreachable 6")
  debug_assert(!dom.dominates(n6, n6), "unreachable 6 !dom 6")

  match dom.all_dominators(n5) {
    Some(ds) => assert_node_ids(ds, [5, 4, 1, 0], "all_dominators(5)")
    None => debug_assert(false, "all_dominators(5) must be Some")
  }
  match dom.strict_dominators(n5) {
    Some(ds) => assert_node_ids(ds, [4, 1, 0], "strict_dominators(5)")
    None => debug_assert(false, "strict_dominators(5) must be Some")
  }
  assert_opt_none(dom.all_dominators(n6), "unreachable all_dominators == None")

  let df = dom.dominance_frontiers(g)
  debug_assert(df.length() == 7, "df length == 7")
  assert_node_ids(df[0], [], "DF(0)")
  assert_node_ids(df[1], [1], "DF(1)")
  assert_node_ids(df[2], [4], "DF(2)")
  assert_node_ids(df[3], [4], "DF(3)")
  assert_node_ids(df[4], [1], "DF(4)")
  assert_node_ids(df[5], [], "DF(5)")
  assert_node_ids(df[6], [], "DF(6)")
}

///|
test "transitive_closure_and_reduction_petgraph_vectors" {
  let g : DiGraph[Unit, Unit] = DiGraph::new()
  let a = g.add_node(())
  let b = g.add_node(())
  let c = g.add_node(())
  let d = g.add_node(())
  let _ = must_add_di_edge(g, a, b, ())
  let _ = must_add_di_edge(g, a, c, ())
  let _ = must_add_di_edge(g, b, c, ())
  let _ = must_add_di_edge(g, c, d, ())
  let _ = must_add_di_edge(g, a, d, ())

  let tred = match transitive_reduction(g) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "tred failed: " + graph_error_to_string(e))
      return
    }
  }
  debug_assert(tred.node_count() == 4, "tred 4 nodes")
  debug_assert(tred.edge_count() == 3, "tred 3 edges: a->b, b->c, c->d")
  debug_assert(tred.contains_edge(a, b), "tred a->b")
  debug_assert(tred.contains_edge(b, c), "tred b->c")
  debug_assert(tred.contains_edge(c, d), "tred c->d")
  debug_assert(!tred.contains_edge(a, c), "tred drops a->c")
  debug_assert(!tred.contains_edge(a, d), "tred drops a->d")

  let tclos = match transitive_closure(g) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "tclos failed: " + graph_error_to_string(e))
      return
    }
  }
  debug_assert(tclos.edge_count() == 6, "tclos 6 edges")
  debug_assert(tclos.contains_edge(b, d), "tclos adds b->d")
  debug_assert(tclos.contains_edge(a, d), "tclos has a->d")
}

///|
test "dijkstra_and_astar_shortest_paths" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let a = g.add_node(())
  let b = g.add_node(())
  let c = g.add_node(())
  let d = g.add_node(())
  let e = g.add_node(())
  let f = g.add_node(())
  let _ = must_add_di_edge(g, a, b, 2L)
  let _ = must_add_di_edge(g, a, d, 4L)
  let _ = must_add_di_edge(g, b, c, 1L)
  let _ = must_add_di_edge(g, b, f, 7L)
  let _ = must_add_di_edge(g, c, e, 5L)
  let _ = must_add_di_edge(g, d, e, 1L)
  let _ = must_add_di_edge(g, e, f, 1L)

  let sp = match dijkstra(g, a, None, fn(w) { w }) {
    Ok(r) => r
    Err(err) => {
      debug_assert(false, "dijkstra failed: " + graph_error_to_string(err))
      return
    }
  }
  assert_opt_i64(sp.distance(a), 0L, "dist a == 0")
  assert_opt_i64(sp.distance(b), 2L, "dist b == 2")
  assert_opt_i64(sp.distance(c), 3L, "dist c == 3")
  assert_opt_i64(sp.distance(d), 4L, "dist d == 4")
  assert_opt_i64(sp.distance(e), 5L, "dist e == 5")
  assert_opt_i64(sp.distance(f), 6L, "dist f == 6")
  match sp.path_to(f) {
    Some(path) => assert_node_ids(path, [0, 3, 4, 5], "dijkstra path a->d->e->f")
    None => debug_assert(false, "path_to(f) must be Some")
  }

  let h = fn(n : NodeId) -> Int64 {
    if n.index == 5 {
      0L
    } else {
      1L
    }
  }
  match astar(g, a, fn(n) { n.index == 5 }, fn(w) { w }, h) {
    Ok(Some(res)) => {
      debug_assert(res.cost == 6L, "astar cost == 6")
      assert_node_ids(res.path, [0, 3, 4, 5], "astar path")
    }
    _ => debug_assert(false, "astar must find path")
  }
}

///|
test "bellman_ford_and_negative_cycle_petgraph_vectors" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let n3 = g.add_node(())
  let _ = must_add_di_edge(g, n0, n1, 4L)
  let _ = must_add_di_edge(g, n0, n2, 5L)
  let _ = must_add_di_edge(g, n2, n1, -3L)
  let _ = must_add_di_edge(g, n1, n3, 2L)

  match bellman_ford(g, n0, fn(w) { w }) {
    Ok(sp) => {
      assert_opt_i64(sp.distance(n0), 0L, "bf dist 0")
      assert_opt_i64(sp.distance(n1), 2L, "bf dist 1 == 2 via 0->2->1")
      assert_opt_i64(sp.distance(n2), 5L, "bf dist 2 == 5")
      assert_opt_i64(sp.distance(n3), 4L, "bf dist 3 == 4")
    }
    Err(err) => debug_assert(false, "bellman_ford failed: " + graph_error_to_string(err))
  }

  // Negative cycle ported from petgraph/src/algo/bellman_ford.rs
  let ng : DiGraph[Unit, Int64] = DiGraph::new()
  let a = ng.add_node(())
  let b = ng.add_node(())
  let c = ng.add_node(())
  let d = ng.add_node(())
  let _ = must_add_di_edge(ng, a, b, 1L)
  let _ = must_add_di_edge(ng, a, c, 1L)
  let _ = must_add_di_edge(ng, a, d, 1L)
  let _ = must_add_di_edge(ng, b, d, 1L)
  let _ = must_add_di_edge(ng, c, b, 1L)
  let _ = must_add_di_edge(ng, d, c, -3L)

  match bellman_ford(ng, a, fn(w) { w }) {
    Err(NegativeCycle) => ()
    _ => debug_assert(false, "bellman_ford must detect NegativeCycle")
  }
  match find_negative_cycle(ng, a, fn(w) { w }) {
    Ok(Some(cyc)) => {
      debug_assert(cyc.length() == 3, "negative cycle length 3")
      debug_assert(
        contains_node_id(cyc, 1) && contains_node_id(cyc, 2) && contains_node_id(cyc, 3),
        "negative cycle contains {1,2,3}",
      )
    }
    _ => debug_assert(false, "find_negative_cycle must return Some")
  }
}

///|
test "floyd_warshall_petgraph_vectors" {
  // Ported from petgraph/tests/floyd_warshall.rs: floyd_warshall_uniform_weight
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let a = g.add_node(())
  let b = g.add_node(())
  let c = g.add_node(())
  let d = g.add_node(())
  let e = g.add_node(())
  let f = g.add_node(())
  let gg = g.add_node(())
  let h = g.add_node(())
  let _ = must_add_di_edge(g, a, b, 1L)
  let _ = must_add_di_edge(g, b, c, 1L)
  let _ = must_add_di_edge(g, c, d, 1L)
  let _ = must_add_di_edge(g, d, a, 1L)
  let _ = must_add_di_edge(g, e, f, 1L)
  let _ = must_add_di_edge(g, b, e, 1L)
  let _ = must_add_di_edge(g, f, gg, 1L)
  let _ = must_add_di_edge(g, gg, h, 1L)
  let _ = must_add_di_edge(g, h, e, 1L)

  let apsp = match floyd_warshall(g, fn(w) { w }) {
    Ok(r) => r
    Err(err) => {
      debug_assert(false, "floyd_warshall failed: " + graph_error_to_string(err))
      return
    }
  }
  assert_opt_i64(apsp.distance(a, a), 0L, "fw a->a == 0")
  assert_opt_i64(apsp.distance(a, h), 5L, "fw a->h == 5")
  assert_opt_i64(apsp.distance(c, h), 7L, "fw c->h == 7")
  assert_opt_none(apsp.distance(e, a), "fw e->a unreachable")
  assert_opt_i64(apsp.distance(f, e), 3L, "fw f->e == 3")
  assert_opt_i64(apsp.distance(h, e), 1L, "fw h->e == 1")

  let ng : DiGraph[Unit, Int64] = DiGraph::new()
  let x = ng.add_node(())
  let y = ng.add_node(())
  let _ = must_add_di_edge(ng, x, y, 2L)
  let _ = must_add_di_edge(ng, y, x, -5L)
  match floyd_warshall(ng, fn(w) { w }) {
    Err(NegativeCycle) => ()
    _ => debug_assert(false, "floyd_warshall must detect NegativeCycle")
  }
}

///|
test "kruskal_and_prim_mst_petgraph_vectors" {
  // Ported from petgraph/tests/min_spanning_tree.rs: mst_kruskal (10 nodes, 2 components)
  let g : UnGraph[String, Int64] = UnGraph::new()
  let a = g.add_node("A")
  let b = g.add_node("B")
  let c = g.add_node("C")
  let d = g.add_node("D")
  let e = g.add_node("E")
  let f = g.add_node("F")
  let gg = g.add_node("G")
  let _ = must_add_un_edge(g, a, b, 7L)
  let _ = must_add_un_edge(g, a, d, 5L)
  let _ = must_add_un_edge(g, d, b, 9L)
  let _ = must_add_un_edge(g, b, c, 8L)
  let _ = must_add_un_edge(g, b, e, 7L)
  let _ = must_add_un_edge(g, c, e, 5L)
  let _ = must_add_un_edge(g, d, e, 15L)
  let _ = must_add_un_edge(g, d, f, 6L)
  let _ = must_add_un_edge(g, f, e, 8L)
  let _ = must_add_un_edge(g, f, gg, 11L)
  let _ = must_add_un_edge(g, e, gg, 9L)

  let h = g.add_node("H")
  let ii = g.add_node("I")
  let j = g.add_node("J")
  let _ = must_add_un_edge(g, h, ii, 1L)
  let _ = must_add_un_edge(g, h, j, 3L)
  let _ = must_add_un_edge(g, ii, j, 1L)

  let k_res = match kruskal_mst(g, fn(w) { w }) {
    Ok(r) => r
    Err(err) => {
      debug_assert(false, "kruskal failed: " + graph_error_to_string(err))
      return
    }
  }
  debug_assert(k_res.edges.length() == 8, "kruskal 8 edges (10 nodes - 2 comps)")
  debug_assert(k_res.total_weight == 41L, "kruskal total weight == 41")

  let p_res = match prim_mst(g, fn(w) { w }) {
    Ok(r) => r
    Err(err) => {
      debug_assert(false, "prim failed: " + graph_error_to_string(err))
      return
    }
  }
  debug_assert(p_res.edges.length() == 8, "prim 8 edges")
  debug_assert(p_res.total_weight == 41L, "prim total weight == 41")
}

///|
test "dinic_max_flow_and_min_cut_petgraph_vectors" {
  // Ported from petgraph/tests/dinics.rs: test_dinics_a, c, e, f, g
  let run_case = fn(n : Int, edges : Array[(Int, Int, Int64)], expected : Int64, label : String) -> Unit {
    let g : DiGraph[Unit, Int64] = DiGraph::new()
    let mut i = 0
    while i < n {
      let _ = g.add_node(())
      i = i + 1
    }
    let mut j = 0
    while j < edges.length() {
      let (u, v, cap) = edges[j]
      let _ = must_add_di_edge(g, NodeId::new(u), NodeId::new(v), cap)
      j = j + 1
    }
    match dinic_max_flow(g, NodeId::new(0), NodeId::new(n - 1), fn(c) { c }) {
      Ok(res) => {
        debug_assert(
          res.max_flow == expected,
          label + ": expected " + expected.to_string() + ", got " + res.max_flow.to_string(),
        )
        debug_assert(res.source_side[0], label + ": source on S side")
        debug_assert(!res.source_side[n - 1], label + ": sink on T side")
        let mut cut_cap : Int64 = 0L
        let mut k = 0
        while k < edges.length() {
          let (u, v, cap) = edges[k]
          if res.source_side[u] && !res.source_side[v] {
            cut_cap = cut_cap + cap
          }
          k = k + 1
        }
        debug_assert(cut_cap == expected, label + ": min-cut capacity must equal max-flow")
      }
      Err(err) => debug_assert(false, label + " failed: " + graph_error_to_string(err))
    }
  }

  run_case(4, [(0, 1, 3L), (0, 2, 2L), (1, 2, 5L), (1, 3, 2L), (2, 3, 3L)], 5L, "dinics_a")
  run_case(
    6,
    [(0, 1, 7L), (0, 2, 4L), (1, 3, 5L), (1, 4, 3L), (2, 1, 3L), (2, 4, 2L), (3, 5, 8L), (4, 3, 3L), (4, 5, 5L)],
    10L,
    "dinics_c",
  )
  run_case(
    6,
    [
      (0, 1, 16L), (0, 2, 13L), (1, 2, 10L), (1, 3, 12L), (2, 1, 4L),
      (2, 4, 14L), (3, 2, 9L), (3, 5, 20L), (4, 3, 7L), (4, 5, 4L),
    ],
    23L,
    "dinics_e",
  )
  run_case(
    6,
    [
      (0, 1, 10L), (0, 2, 10L), (1, 2, 2L), (1, 3, 4L), (1, 4, 8L),
      (2, 4, 9L), (3, 5, 10L), (4, 3, 6L), (4, 5, 10L),
    ],
    19L,
    "dinics_f",
  )
  run_case(
    6,
    [(0, 1, 2L), (0, 2, 2L), (1, 3, 1L), (1, 4, 2L), (2, 3, 2L), (3, 5, 2L), (4, 5, 2L)],
    4L,
    "dinics_g",
  )
}

///|
test "dot_export_escaping" {
  let g : DiGraph[String, String] = DiGraph::new()
  let a = g.add_node("node \"A\"\nline2\\end")
  let b = g.add_node("node\tB")
  let _ = must_add_di_edge(g, a, b, "e\"1\\x")
  let dot = digraph_to_dot(g, fn(_id, w) { w }, fn(_id, w) { w })
  debug_assert(dot.contains("digraph {"), "dot digraph header")
  debug_assert(dot.contains("0 -> 1"), "dot directed edge")
  debug_assert(dot.contains("\\\"A\\\""), "dot escaped quotes")
  debug_assert(dot.contains("\\nline2\\\\end"), "dot escaped newline and backslash")
  debug_assert(dot.contains("\\tB"), "dot escaped tab")

  let ug : UnGraph[String, String] = UnGraph::new()
  let u0 = ug.add_node("U0")
  let u1 = ug.add_node("U1")
  let _ = must_add_un_edge(ug, u0, u1, "w")
  let udot = ungraph_to_dot(ug, fn(_id, w) { w }, fn(_id, w) { w })
  debug_assert(udot.contains("graph {"), "ungraph dot header")
  debug_assert(udot.contains("0 -- 1"), "ungraph dot edge")
}
