///| Shortest-path algorithms: Dijkstra, A*, Bellman-Ford, and Floyd-Warshall.
///| All algorithms check `Int64` overflow and invalid node IDs.

///| Query shortest distance to `target`, or `None` if unreachable or invalid.
pub fn ShortestPaths::distance(self : ShortestPaths, target : NodeId) -> Option[Int64] {
  let idx = target.index
  if idx < 0 || idx >= self.distances.length() || !self.reachable[idx] {
    return None
  }
  Some(self.distances[idx])
}

///| Reconstruct shortest path from `source` to `target`, or `None` if unreachable.
pub fn ShortestPaths::path_to(self : ShortestPaths, target : NodeId) -> Option[Array[NodeId]] {
  let n = self.distances.length()
  let t = target.index
  if t < 0 || t >= n || !self.reachable[t] {
    return None
  }
  let rev : Array[NodeId] = Array::new()
  let mut cur = t
  let mut steps = 0
  while cur != -1 && steps <= n {
    rev.push(NodeId::{ index: cur })
    if cur == self.source.index {
      break
    }
    cur = self.predecessors[cur]
    steps = steps + 1
  }
  if rev.length() == 0 || rev[rev.length() - 1].index != self.source.index {
    return None
  }
  let out : Array[NodeId] = Array::with_capacity(rev.length())
  let mut i = rev.length() - 1
  while i >= 0 {
    out.push(rev[i])
    i = i - 1
  }
  Some(out)
}

///| Query all-pairs shortest distance from `u` to `v`.
pub fn AllPairsShortestPaths::distance(
  self : AllPairsShortestPaths,
  u : NodeId,
  v : NodeId,
) -> Option[Int64] {
  let n = self.node_count
  let ui = u.index
  let vi = v.index
  if ui < 0 || ui >= n || vi < 0 || vi >= n {
    return None
  }
  let idx = ui * n + vi
  if !self.reachable[idx] {
    return None
  }
  Some(self.distances[idx])
}

///| Check whether signed 128-bit `(hi, lo)` fits in signed `Int64`.
#verify
pub fn fits_i64(hi : Int64, lo : UInt64) -> Bool {
  (hi == 0L && lo <= 9223372036854775807UL) || (hi == -1L && lo >= 9223372036854775808UL)
}

///| Sign-extension high word for a signed `Int64` widened to 128-bit `(hi, lo)`.
#verify
pub fn i64_sign_hi(w : Int64) -> Int64 {
  if w < 0L {
    -1L
  } else {
    0L
  }
}

///| Unsigned 64-bit addition carry (`0L` or `1L`) for 128-bit accumulation.
#verify
pub fn i128_add_carry(u_lo : UInt64, w_lo : UInt64) -> Int64 {
  if u_lo + w_lo < u_lo {
    1L
  } else {
    0L
  }
}

///| Strict lexicographic `<` comparison on signed 128-bit `(hi, lo)` pairs.
#verify
pub fn i128_lt(a_hi : Int64, a_lo : UInt64, b_hi : Int64, b_lo : UInt64) -> Bool {
  a_hi < b_hi || (a_hi == b_hi && a_lo < b_lo)
}

///| Single-source shortest paths using Dijkstra's algorithm with a binary min-heap.
///| Rejects negative edge weights (`Err(NegativeWeight)`) and true shortest-path `Int64` overflow (`Err(WeightOverflow)`).
pub fn dijkstra[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  goal : Option[NodeId],
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let goal_idx = match goal {
    Some(gid) => {
      if gid.index < 0 || gid.index >= n {
        return Err(InvalidNode(gid.index))
      }
      gid.index
    }
    None => -1
  }
  // All Dijkstra distances are >= 0, so -1L is an exact unreachable sentinel.
  let distances : FixedArray[Int64] = FixedArray::make(n, -1L)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  let heap_keys : FixedArray[Int64] = FixedArray::make(n, 0L)
  let heap_vals : FixedArray[Int] = FixedArray::make(n, 0)
  let heap_pos : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  heap_keys[0] = 0L
  heap_vals[0] = src
  heap_pos[src] = 0
  let mut hlen = 1

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst
  let edge_weights = g.edge_weights
  let overflow_nodes : Array[Int] = Array::new()

  while hlen > 0 {
    let d = heap_keys[0]
    let u = heap_vals[0]
    heap_pos[u] = -1
    hlen = hlen - 1
    if hlen > 0 {
      let last_k = heap_keys[hlen]
      let last_v = heap_vals[hlen]
      let mut idx = 0
      while true {
        let c0 = (idx << 2) + 1
        if c0 >= hlen {
          break
        }
        let mut best = c0
        let mut best_k = heap_keys[c0]
        let c3 = c0 + 3
        if c3 < hlen {
          let k1 = heap_keys[c0 + 1]
          if k1 < best_k {
            best = c0 + 1
            best_k = k1
          }
          let k2 = heap_keys[c0 + 2]
          if k2 < best_k {
            best = c0 + 2
            best_k = k2
          }
          let k3 = heap_keys[c3]
          if k3 < best_k {
            best = c3
            best_k = k3
          }
        } else {
          let c1 = c0 + 1
          if c1 < hlen {
            let k1 = heap_keys[c1]
            if k1 < best_k {
              best = c1
              best_k = k1
            }
            let c2 = c0 + 2
            if c2 < hlen {
              let k2 = heap_keys[c2]
              if k2 < best_k {
                best = c2
                best_k = k2
              }
            }
          }
        }
        if best_k < last_k {
          let bv = heap_vals[best]
          heap_keys[idx] = best_k
          heap_vals[idx] = bv
          heap_pos[bv] = idx
          idx = best
        } else {
          break
        }
      }
      heap_keys[idx] = last_k
      heap_vals[idx] = last_v
      heap_pos[last_v] = idx
    }
    if u == goal_idx {
      break
    }
    let max_w = MAX_I64 - d
    let mut e = first_out[u]
    while e != -1 {
      let w = edge_cost(edge_weights[e])
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let v = edge_dst[e]
      if w > max_w {
        if distances[v] < 0L {
          overflow_nodes.push(v)
        }
      } else {
        let nd = d + w
        let dv = distances[v]
        if nd.to_uint64() < dv.to_uint64() {
          distances[v] = nd
          predecessors[v] = u
          let mut p_idx = heap_pos[v]
          if p_idx < 0 {
            p_idx = hlen
            hlen = hlen + 1
          }
          while p_idx > 0 {
            let parent = (p_idx - 1) >> 2
            let pk = heap_keys[parent]
            if nd < pk {
              let pv = heap_vals[parent]
              heap_keys[p_idx] = pk
              heap_vals[p_idx] = pv
              heap_pos[pv] = p_idx
              p_idx = parent
            } else {
              break
            }
          }
          heap_keys[p_idx] = nd
          heap_vals[p_idx] = v
          heap_pos[v] = p_idx
        }
      }
      e = next_out[e]
    }
  }

  if overflow_nodes.length() > 0 && (goal_idx < 0 || distances[goal_idx] < 0L) {
    let mut oi = 0
    while oi < overflow_nodes.length() {
      if distances[overflow_nodes[oi]] < 0L {
        return Err(WeightOverflow)
      }
      oi = oi + 1
    }
  }

  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let mut i = 0
  while i < n {
    if distances[i] >= 0L {
      reachable[i] = true
    } else {
      distances[i] = MAX_I64
    }
    i = i + 1
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Specialized zero-closure Dijkstra for `DiGraph[N, Int64]`.
pub fn dijkstra_i64[N](
  g : DiGraph[N, Int64],
  source : NodeId,
  goal : Option[NodeId],
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let goal_idx = match goal {
    Some(gid) => {
      if gid.index < 0 || gid.index >= n {
        return Err(InvalidNode(gid.index))
      }
      gid.index
    }
    None => -1
  }
  let distances : FixedArray[Int64] = FixedArray::make(n, -1L)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  let heap_keys : FixedArray[Int64] = FixedArray::make(n, 0L)
  let heap_vals : FixedArray[Int] = FixedArray::make(n, 0)
  let heap_pos : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  heap_keys[0] = 0L
  heap_vals[0] = src
  heap_pos[src] = 0
  let mut hlen = 1

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst
  let edge_weights = g.edge_weights
  let overflow_nodes : Array[Int] = Array::new()

  while hlen > 0 {
    let d = heap_keys[0]
    let u = heap_vals[0]
    heap_pos[u] = -1
    hlen = hlen - 1
    if hlen > 0 {
      let last_k = heap_keys[hlen]
      let last_v = heap_vals[hlen]
      let mut idx = 0
      while true {
        let c0 = (idx << 2) + 1
        if c0 >= hlen {
          break
        }
        let mut best = c0
        let mut best_k = heap_keys[c0]
        let c3 = c0 + 3
        if c3 < hlen {
          let k1 = heap_keys[c0 + 1]
          if k1 < best_k {
            best = c0 + 1
            best_k = k1
          }
          let k2 = heap_keys[c0 + 2]
          if k2 < best_k {
            best = c0 + 2
            best_k = k2
          }
          let k3 = heap_keys[c3]
          if k3 < best_k {
            best = c3
            best_k = k3
          }
        } else {
          let c1 = c0 + 1
          if c1 < hlen {
            let k1 = heap_keys[c1]
            if k1 < best_k {
              best = c1
              best_k = k1
            }
            let c2 = c0 + 2
            if c2 < hlen {
              let k2 = heap_keys[c2]
              if k2 < best_k {
                best = c2
                best_k = k2
              }
            }
          }
        }
        if best_k < last_k {
          let bv = heap_vals[best]
          heap_keys[idx] = best_k
          heap_vals[idx] = bv
          heap_pos[bv] = idx
          idx = best
        } else {
          break
        }
      }
      heap_keys[idx] = last_k
      heap_vals[idx] = last_v
      heap_pos[last_v] = idx
    }
    if u == goal_idx {
      break
    }
    let max_w = MAX_I64 - d
    let mut e = first_out[u]
    while e != -1 {
      let w = edge_weights[e]
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let v = edge_dst[e]
      if w > max_w {
        if distances[v] < 0L {
          overflow_nodes.push(v)
        }
      } else {
        let nd = d + w
        let dv = distances[v]
        if nd.to_uint64() < dv.to_uint64() {
          distances[v] = nd
          predecessors[v] = u
          let mut p_idx = heap_pos[v]
          if p_idx < 0 {
            p_idx = hlen
            hlen = hlen + 1
          }
          while p_idx > 0 {
            let parent = (p_idx - 1) >> 2
            let pk = heap_keys[parent]
            if nd < pk {
              let pv = heap_vals[parent]
              heap_keys[p_idx] = pk
              heap_vals[p_idx] = pv
              heap_pos[pv] = p_idx
              p_idx = parent
            } else {
              break
            }
          }
          heap_keys[p_idx] = nd
          heap_vals[p_idx] = v
          heap_pos[v] = p_idx
        }
      }
      e = next_out[e]
    }
  }

  if overflow_nodes.length() > 0 && (goal_idx < 0 || distances[goal_idx] < 0L) {
    let mut oi = 0
    while oi < overflow_nodes.length() {
      if distances[overflow_nodes[oi]] < 0L {
        return Err(WeightOverflow)
      }
      oi = oi + 1
    }
  }

  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let mut i = 0
  while i < n {
    if distances[i] >= 0L {
      reachable[i] = true
    } else {
      distances[i] = MAX_I64
    }
    i = i + 1
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| A* heuristic shortest-path search (supports admissible non-consistent heuristics via re-opening).
pub fn astar[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  is_goal : (NodeId) -> Bool,
  edge_cost : (E) -> Int64,
  estimate_cost : (NodeId) -> Int64,
) -> Result[Option[AStarResult], GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let h0 = estimate_cost(source)
  if h0 < 0L {
    return Err(NegativeWeight(h0))
  }

  let g_score : FixedArray[Int64] = FixedArray::make(n, -1L)
  let best_f : FixedArray[Int64] = FixedArray::make(n, -1L)
  let closed : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  g_score[src] = 0L
  best_f[src] = h0

  let heap = MinHeapI64::with_capacity(n)
  heap.push(h0, src)

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst
  let edge_weights = g.edge_weights
  let mut overflow_seen = false

  while !heap.is_empty() {
    heap.pop_min_raw()
    let f_pop = heap.popped_key
    let u = heap.popped_val
    if closed[u] || f_pop != best_f[u] {
      continue
    }
    closed[u] = true
    let u_id = NodeId::{ index: u }
    if is_goal(u_id) {
      let rev : Array[NodeId] = Array::new()
      let mut cur = u
      while cur != -1 {
        rev.push(NodeId::{ index: cur })
        if cur == src {
          break
        }
        cur = predecessors[cur]
      }
      let path : Array[NodeId] = Array::with_capacity(rev.length())
      let mut i = rev.length() - 1
      while i >= 0 {
        path.push(rev[i])
        i = i - 1
      }
      return Ok(Some(AStarResult::{ cost: g_score[u], path }))
    }

    let gu = g_score[u]
    let mut e = first_out[u]
    while e != -1 {
      let w = edge_cost(edge_weights[e])
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let v = edge_dst[e]
      if w > MAX_I64 - gu {
        if g_score[v] < 0L {
          overflow_seen = true
        }
      } else {
        let ng = gu + w
        let gv = g_score[v]
        if gv < 0L || ng < gv {
          let hv = estimate_cost(NodeId::{ index: v })
          if hv < 0L {
            return Err(NegativeWeight(hv))
          }
          if hv > MAX_I64 - ng {
            if gv < 0L {
              overflow_seen = true
            }
          } else {
            let f_score = ng + hv
            g_score[v] = ng
            best_f[v] = f_score
            predecessors[v] = u
            closed[v] = false
            heap.push(f_score, v)
          }
        }
      }
      e = next_out[e]
    }
  }
  if overflow_seen {
    return Err(WeightOverflow)
  }
  Ok(None)
}

///| Internal: exact 128-bit signed Bellman-Ford fallback when `Int64` arithmetic overflows/underflows.
fn bellman_ford_i128[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  costs : FixedArray[Int64],
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let src = source.index
  let d_hi : FixedArray[Int64] = FixedArray::make(n, 0L)
  let d_lo : FixedArray[UInt64] = FixedArray::make(n, 0UL)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut iter = 0
  while iter < n - 1 {
    let mut changed = false
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let v = edge_dst[e]
        let w = costs[e]
        let w_lo = w.to_uint64()
        let w_hi = i64_sign_hi(w)
        let u_lo = d_lo[u]
        let n_lo = u_lo + w_lo
        let carry = i128_add_carry(u_lo, w_lo)
        let n_hi = d_hi[u] + w_hi + carry
        if !reachable[v] || i128_lt(n_hi, n_lo, d_hi[v], d_lo[v]) {
          d_hi[v] = n_hi
          d_lo[v] = n_lo
          reachable[v] = true
          predecessors[v] = u
          changed = true
        }
      }
      e = e + 1
    }
    if !changed {
      break
    }
    iter = iter + 1
  }

  // Negative cycle check pass (always checked before Int64 range overflow)
  let mut e2 = 0
  while e2 < m {
    let u = edge_src[e2]
    if reachable[u] {
      let v = edge_dst[e2]
      let w = costs[e2]
      let w_lo = w.to_uint64()
      let w_hi = i64_sign_hi(w)
      let u_lo = d_lo[u]
      let n_lo = u_lo + w_lo
      let carry = i128_add_carry(u_lo, w_lo)
      let n_hi = d_hi[u] + w_hi + carry
      if !reachable[v] || i128_lt(n_hi, n_lo, d_hi[v], d_lo[v]) {
        return Err(NegativeCycle)
      }
    }
    e2 = e2 + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let mut i = 0
  while i < n {
    if reachable[i] {
      if !fits_i64(d_hi[i], d_lo[i]) {
        return Err(WeightOverflow)
      }
      distances[i] = d_lo[i].to_int64()
    }
    i = i + 1
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Bellman-Ford single-source shortest paths supporting negative edge weights and negative-cycle detection.
pub fn bellman_ford[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let costs : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut ei = 0
  while ei < m {
    costs[ei] = edge_cost(ew[ei])
    ei = ei + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut iter = 0
  while iter < n - 1 {
    let mut changed = false
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let du = distances[u]
        let w = costs[e]
        if (w > 0L && du > MAX_I64 - w) || (w < 0L && du < MIN_I64 - w) {
          return bellman_ford_i128(g, source, costs)
        }
        let nd = du + w
        let v = edge_dst[e]
        if !reachable[v] || nd < distances[v] {
          distances[v] = nd
          reachable[v] = true
          predecessors[v] = u
          changed = true
        }
      }
      e = e + 1
    }
    if !changed {
      break
    }
    iter = iter + 1
  }

  // Negative cycle check pass
  let mut e2 = 0
  while e2 < m {
    let u = edge_src[e2]
    if reachable[u] {
      let du = distances[u]
      let w = costs[e2]
      if (w > 0L && du > MAX_I64 - w) || (w < 0L && du < MIN_I64 - w) {
        return bellman_ford_i128(g, source, costs)
      }
      let nd = du + w
      let v = edge_dst[e2]
      if !reachable[v] || nd < distances[v] {
        return Err(NegativeCycle)
      }
    }
    e2 = e2 + 1
  }

  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Internal: exact 128-bit signed negative-cycle finder fallback.
fn find_negative_cycle_i128[N, E](
  g : DiGraph[N, E],
  src : Int,
  costs : FixedArray[Int64],
) -> Result[Option[Array[NodeId]], GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let d_hi : FixedArray[Int64] = FixedArray::make(n, 0L)
  let d_lo : FixedArray[UInt64] = FixedArray::make(n, 0UL)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut last_updated = -1
  let mut iter = 0
  while iter < n {
    last_updated = -1
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let v = edge_dst[e]
        let w = costs[e]
        let w_lo = w.to_uint64()
        let w_hi = i64_sign_hi(w)
        let u_lo = d_lo[u]
        let n_lo = u_lo + w_lo
        let carry = i128_add_carry(u_lo, w_lo)
        let n_hi = d_hi[u] + w_hi + carry
        if !reachable[v] || i128_lt(n_hi, n_lo, d_hi[v], d_lo[v]) {
          d_hi[v] = n_hi
          d_lo[v] = n_lo
          reachable[v] = true
          predecessors[v] = u
          last_updated = v
        }
      }
      e = e + 1
    }
    if last_updated == -1 {
      return Ok(None)
    }
    iter = iter + 1
  }

  let mut cur = last_updated
  let mut step = 0
  while step < n {
    let p = predecessors[cur]
    if p == -1 {
      break
    }
    cur = p
    step = step + 1
  }
  let start = cur
  let rev : Array[NodeId] = Array::new()
  while true {
    rev.push(NodeId::{ index: cur })
    cur = predecessors[cur]
    if cur == start || cur == -1 || rev.length() > n {
      break
    }
  }
  let cycle : Array[NodeId] = Array::with_capacity(rev.length())
  let mut k = rev.length() - 1
  while k >= 0 {
    cycle.push(rev[k])
    k = k - 1
  }
  Ok(Some(cycle))
}

///| Find a negative-weight cycle reachable from `source`, if one exists.
pub fn find_negative_cycle[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[Option[Array[NodeId]], GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let costs : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut ei = 0
  while ei < m {
    costs[ei] = edge_cost(ew[ei])
    ei = ei + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut last_updated = -1
  let mut iter = 0
  while iter < n {
    last_updated = -1
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let du = distances[u]
        let w = costs[e]
        if (w > 0L && du > MAX_I64 - w) || (w < 0L && du < MIN_I64 - w) {
          return find_negative_cycle_i128(g, src, costs)
        }
        let nd = du + w
        let v = edge_dst[e]
        if !reachable[v] || nd < distances[v] {
          distances[v] = nd
          reachable[v] = true
          predecessors[v] = u
          last_updated = v
        }
      }
      e = e + 1
    }
    if last_updated == -1 {
      return Ok(None)
    }
    iter = iter + 1
  }

  // Walk `n` steps backwards along predecessors to guarantee entering the negative cycle
  let mut cur = last_updated
  let mut step = 0
  while step < n {
    let p = predecessors[cur]
    if p == -1 {
      break
    }
    cur = p
    step = step + 1
  }
  let start = cur
  let rev : Array[NodeId] = Array::new()
  while true {
    rev.push(NodeId::{ index: cur })
    cur = predecessors[cur]
    if cur == start || cur == -1 || rev.length() > n {
      break
    }
  }
  let cycle : Array[NodeId] = Array::with_capacity(rev.length())
  let mut k = rev.length() - 1
  while k >= 0 {
    cycle.push(rev[k])
    k = k - 1
  }
  Ok(Some(cycle))
}

///| Floyd-Warshall all-pairs shortest paths supporting negative edge weights and negative-cycle detection.
///| Uses a fast single-array `Int64` kernel for bounded non-negative weights and an exact 128-bit signed
///| kernel for negative or huge weights so non-improving overflow candidates never cause false errors.
pub fn floyd_warshall[N, E](
  g : DiGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[AllPairsShortestPaths, GraphError] {
  let n = g.node_count()
  if n > 16384 {
    return Err(InvalidArgument("floyd_warshall node_count exceeds maximum (16384)"))
  }
  let total = n * n
  if n == 0 {
    return Ok(AllPairsShortestPaths::{
      node_count: 0,
      distances: FixedArray::make(0, MAX_I64),
      reachable: FixedArray::make(0, false),
    })
  }

  let m = g.edge_count()
  let edge_src = g.edge_src
  let edge_dst = g.edge_dst
  let ew = g.edge_weights

  let costs : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut min_w = 0L
  let mut max_w = 0L
  let mut ei = 0
  while ei < m {
    let w = edge_cost(ew[ei])
    costs[ei] = w
    if w < min_w {
      min_w = w
    }
    if w > max_w {
      max_w = w
    }
    ei = ei + 1
  }

  // Fast path: all edge weights >= 0 and max possible simple path weight < MAX_I64 / 2
  let fast_ok = min_w >= 0L && (n <= 1 || max_w <= (MAX_I64 / 2L - 1L) / (n - 1).to_int64())
  if fast_ok {
    let inf : Int64 = MAX_I64 / 2L + 1L
    let distances : FixedArray[Int64] = FixedArray::make(total, inf)
    let mut i = 0
    while i < n {
      distances[i * n + i] = 0L
      i = i + 1
    }
    let mut e = 0
    while e < m {
      let idx = edge_src[e] * n + edge_dst[e]
      let w = costs[e]
      if w < distances[idx] {
        distances[idx] = w
      }
      e = e + 1
    }

    let mut k = 0
    while k < n {
      let k_row = k * n
      let mut row = 0
      while row < n {
        let i_row = row * n
        let dik = distances[i_row + k]
        if dik < inf {
          let mut col = 0
          while col < n {
            let cand = dik + distances[k_row + col]
            let ij = i_row + col
            if cand < distances[ij] {
              distances[ij] = cand
            }
            col = col + 1
          }
        }
        row = row + 1
      }
      k = k + 1
    }

    let reachable : FixedArray[Bool] = FixedArray::make(total, false)
    let mut idx = 0
    while idx < total {
      if distances[idx] < inf {
        reachable[idx] = true
      } else {
        distances[idx] = MAX_I64
      }
      idx = idx + 1
    }
    return Ok(AllPairsShortestPaths::{ node_count: n, distances, reachable })
  }

  // General exact 128-bit signed path (handles negative edges, large negative cycles, and huge weights)
  let d_hi : FixedArray[Int64] = FixedArray::make(total, 0L)
  let d_lo : FixedArray[UInt64] = FixedArray::make(total, 0UL)
  let reachable : FixedArray[Bool] = FixedArray::make(total, false)
  let mut i = 0
  while i < n {
    reachable[i * n + i] = true
    i = i + 1
  }
  let mut e = 0
  while e < m {
    let idx = edge_src[e] * n + edge_dst[e]
    let w = costs[e]
    let w_lo = w.to_uint64()
    let w_hi = if w < 0L { -1L } else { 0L }
    if !reachable[idx] || w_hi < d_hi[idx] || (w_hi == d_hi[idx] && w_lo < d_lo[idx]) {
      d_hi[idx] = w_hi
      d_lo[idx] = w_lo
      reachable[idx] = true
    }
    e = e + 1
  }

  // Check initial negative self-loops before relaxing
  let mut d0 = 0
  while d0 < n {
    if d_hi[d0 * n + d0] < 0L {
      return Err(NegativeCycle)
    }
    d0 = d0 + 1
  }

  let mut k = 0
  while k < n {
    let k_row = k * n
    let mut row = 0
    while row < n {
      let i_row = row * n
      let ik = i_row + k
      if reachable[ik] {
        let dik_hi = d_hi[ik]
        let dik_lo = d_lo[ik]
        let mut col = 0
        while col < n {
          let kj = k_row + col
          if reachable[kj] {
            let dkj_lo = d_lo[kj]
            let c_lo = dik_lo + dkj_lo
            let carry = if c_lo < dik_lo { 1L } else { 0L }
            let c_hi = dik_hi + d_hi[kj] + carry
            let ij = i_row + col
            if !reachable[ij] || c_hi < d_hi[ij] || (c_hi == d_hi[ij] && c_lo < d_lo[ij]) {
              d_hi[ij] = c_hi
              d_lo[ij] = c_lo
              reachable[ij] = true
            }
          }
          col = col + 1
        }
      }
      row = row + 1
    }
    // Check for negative cycle after each k-phase so distances never double past 128 bits
    let mut d = 0
    while d < n {
      if d_hi[d * n + d] < 0L {
        return Err(NegativeCycle)
      }
      d = d + 1
    }
    k = k + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(total, MAX_I64)
  let mut idx = 0
  while idx < total {
    if reachable[idx] {
      if !fits_i64(d_hi[idx], d_lo[idx]) {
        return Err(WeightOverflow)
      }
      distances[idx] = d_lo[idx].to_int64()
    }
    idx = idx + 1
  }
  Ok(AllPairsShortestPaths::{ node_count: n, distances, reachable })
}
