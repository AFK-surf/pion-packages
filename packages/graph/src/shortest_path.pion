///| Shortest-path algorithms: Dijkstra, A*, Bellman-Ford, and Floyd-Warshall.

///| Query shortest distance to `target`, or `None` if unreachable or invalid.
pub fn ShortestPaths::distance(self : ShortestPaths, target : NodeId) -> Option[Int64] {
  let _ = self
  let _ = target
  None
}

///| Reconstruct shortest path from `source` to `target`, or `None` if unreachable.
pub fn ShortestPaths::path_to(self : ShortestPaths, target : NodeId) -> Option[Array[NodeId]] {
  let _ = self
  let _ = target
  None
}

///| Query all-pairs shortest distance from `u` to `v`.
pub fn AllPairsShortestPaths::distance(
  self : AllPairsShortestPaths,
  u : NodeId,
  v : NodeId,
) -> Option[Int64] {
  let _ = self
  let _ = u
  let _ = v
  None
}

///| Single-source shortest paths using Dijkstra's algorithm with a binary min-heap.
///| Rejects negative edge weights (`Err(NegativeWeight)`) and `Int64` overflow (`Err(WeightOverflow)`).
pub fn dijkstra[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  goal : Option[NodeId],
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let _ = g
  let _ = source
  let _ = goal
  let _ = edge_cost
  Err(InvalidArgument("unimplemented"))
}

///| Specialized zero-closure Dijkstra for `DiGraph[N, Int64]`.
pub fn dijkstra_i64[N](
  g : DiGraph[N, Int64],
  source : NodeId,
  goal : Option[NodeId],
) -> Result[ShortestPaths, GraphError] {
  let _ = g
  let _ = source
  let _ = goal
  Err(InvalidArgument("unimplemented"))
}

///| A* heuristic shortest-path search.
pub fn astar[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  is_goal : (NodeId) -> Bool,
  edge_cost : (E) -> Int64,
  estimate_cost : (NodeId) -> Int64,
) -> Result[Option[AStarResult], GraphError] {
  let _ = g
  let _ = source
  let _ = is_goal
  let _ = edge_cost
  let _ = estimate_cost
  Err(InvalidArgument("unimplemented"))
}

///| Bellman-Ford single-source shortest paths supporting negative edge weights and negative-cycle detection.
pub fn bellman_ford[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let _ = g
  let _ = source
  let _ = edge_cost
  Err(InvalidArgument("unimplemented"))
}

///| Find a negative-weight cycle reachable from `source`, if one exists.
pub fn find_negative_cycle[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[Option[Array[NodeId]], GraphError] {
  let _ = g
  let _ = source
  let _ = edge_cost
  Err(InvalidArgument("unimplemented"))
}

///| Floyd-Warshall all-pairs shortest paths supporting negative edge weights and negative-cycle detection.
pub fn floyd_warshall[N, E](
  g : DiGraph[N, E],
  edge_cost : (E) -> Int64,
