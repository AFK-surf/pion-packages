///| Shortest-path algorithms: Dijkstra, A*, Bellman-Ford, and Floyd-Warshall.
///| All algorithms check `Int64` overflow and invalid node IDs.

///| Query shortest distance to `target`, or `None` if unreachable or invalid.
pub fn ShortestPaths::distance(self : ShortestPaths, target : NodeId) -> Option[Int64] {
  let idx = target.index
  if idx < 0 || idx >= self.distances.length() || !self.reachable[idx] {
    return None
  }
  Some(self.distances[idx])
}

///| Reconstruct shortest path from `source` to `target`, or `None` if unreachable.
pub fn ShortestPaths::path_to(self : ShortestPaths, target : NodeId) -> Option[Array[NodeId]] {
  let n = self.distances.length()
  let t = target.index
  if t < 0 || t >= n || !self.reachable[t] {
    return None
  }
  let rev : Array[NodeId] = Array::new()
  let mut cur = t
  let mut steps = 0
  while cur != -1 && steps <= n {
    rev.push(NodeId::{ index: cur })
    if cur == self.source.index {
      break
    }
    cur = self.predecessors[cur]
    steps = steps + 1
  }
  if rev.length() == 0 || rev[rev.length() - 1].index != self.source.index {
    return None
  }
  let out : Array[NodeId] = Array::with_capacity(rev.length())
  let mut i = rev.length() - 1
  while i >= 0 {
    out.push(rev[i])
    i = i - 1
  }
  Some(out)
}

///| Query all-pairs shortest distance from `u` to `v`.
pub fn AllPairsShortestPaths::distance(
  self : AllPairsShortestPaths,
  u : NodeId,
  v : NodeId,
) -> Option[Int64] {
  let n = self.node_count
  let ui = u.index
  let vi = v.index
  if ui < 0 || ui >= n || vi < 0 || vi >= n {
    return None
  }
  let idx = ui * n + vi
  if !self.reachable[idx] {
    return None
  }
  Some(self.distances[idx])
}

///| Single-source shortest paths using Dijkstra's algorithm with a binary min-heap.
///| Rejects negative edge weights (`Err(NegativeWeight)`) and `Int64` overflow (`Err(WeightOverflow)`).
pub fn dijkstra[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  goal : Option[NodeId],
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let goal_idx = match goal {
    Some(gid) => {
      if gid.index < 0 || gid.index >= n {
        return Err(InvalidNode(gid.index))
      }
      gid.index
    }
    None => -1
  }
  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let heap = MinHeapI64::with_capacity(n)
  heap.push(0L, src)

  while !heap.is_empty() {
    let (d, u) = heap.pop_min()
    if d != distances[u] {
      continue
    }
    if u == goal_idx {
      break
    }
    let mut e = g.first_out[u]
    while e != -1 {
      let w = edge_cost(g.edge_weights[e])
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let nd = if w > MAX_I64 - d {
        return Err(WeightOverflow)
      } else {
        d + w
      }
      let v = g.edge_dst[e]
      if !reachable[v] || nd < distances[v] {
        distances[v] = nd
        reachable[v] = true
        predecessors[v] = u
        heap.push(nd, v)
      }
      e = g.next_out[e]
    }
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Specialized zero-closure Dijkstra for `DiGraph[N, Int64]`.
pub fn dijkstra_i64[N](
  g : DiGraph[N, Int64],
  source : NodeId,
  goal : Option[NodeId],
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let goal_idx = match goal {
    Some(gid) => {
      if gid.index < 0 || gid.index >= n {
        return Err(InvalidNode(gid.index))
      }
      gid.index
    }
    None => -1
  }
  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let heap = MinHeapI64::with_capacity(n)
  heap.push(0L, src)

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst
  let edge_weights = g.edge_weights

  while !heap.is_empty() {
    let (d, u) = heap.pop_min()
    if d != distances[u] {
      continue
    }
    if u == goal_idx {
      break
    }
    let mut e = first_out[u]
    while e != -1 {
      let w = edge_weights[e]
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let nd = if w > MAX_I64 - d {
        return Err(WeightOverflow)
      } else {
        d + w
      }
      let v = edge_dst[e]
      if !reachable[v] || nd < distances[v] {
        distances[v] = nd
        reachable[v] = true
        predecessors[v] = u
        heap.push(nd, v)
      }
      e = next_out[e]
    }
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| A* heuristic shortest-path search.
pub fn astar[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  is_goal : (NodeId) -> Bool,
  edge_cost : (E) -> Int64,
  estimate_cost : (NodeId) -> Int64,
) -> Result[Option[AStarResult], GraphError] {
  let n = g.node_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let h0 = estimate_cost(source)
  if h0 < 0L {
    return Err(NegativeWeight(h0))
  }

  let g_score : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let closed : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  g_score[src] = 0L
  visited[src] = true

  let heap = MinHeapI64::with_capacity(n)
  heap.push(h0, src)

  while !heap.is_empty() {
    let (_, u) = heap.pop_min()
    if closed[u] {
      continue
    }
    closed[u] = true
    let u_id = NodeId::{ index: u }
    if is_goal(u_id) {
      let rev : Array[NodeId] = Array::new()
      let mut cur = u
      while cur != -1 {
        rev.push(NodeId::{ index: cur })
        if cur == src {
          break
        }
        cur = predecessors[cur]
      }
      let path : Array[NodeId] = Array::with_capacity(rev.length())
      let mut i = rev.length() - 1
      while i >= 0 {
        path.push(rev[i])
        i = i - 1
      }
      return Ok(Some(AStarResult::{ cost: g_score[u], path }))
    }

    let gu = g_score[u]
    let mut e = g.first_out[u]
    while e != -1 {
      let w = edge_cost(g.edge_weights[e])
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let ng = if w > MAX_I64 - gu {
        return Err(WeightOverflow)
      } else {
        gu + w
      }
      let v = g.edge_dst[e]
      if !visited[v] || ng < g_score[v] {
        let hv = estimate_cost(NodeId::{ index: v })
        if hv < 0L {
          return Err(NegativeWeight(hv))
        }
        let f_score = if hv > MAX_I64 - ng {
          return Err(WeightOverflow)
        } else {
          ng + hv
        }
        g_score[v] = ng
        visited[v] = true
        predecessors[v] = u
        heap.push(f_score, v)
      }
      e = g.next_out[e]
    }
  }
  Ok(None)
}

///| Bellman-Ford single-source shortest paths supporting negative edge weights and negative-cycle detection.
pub fn bellman_ford[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let costs : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut ei = 0
  while ei < m {
    costs[ei] = edge_cost(g.edge_weights[ei])
    ei = ei + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut iter = 0
  while iter < n - 1 {
    let mut changed = false
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let v = edge_dst[e]
        let nd = match checked_add_i64(distances[u], costs[e]) {
          Some(x) => x
          None => return Err(WeightOverflow)
        }
        if !reachable[v] || nd < distances[v] {
          distances[v] = nd
          reachable[v] = true
          predecessors[v] = u
          changed = true
        }
      }
      e = e + 1
    }
    if !changed {
      break
    }
    iter = iter + 1
  }

  // Negative cycle check pass
  let mut e2 = 0
  while e2 < m {
    let u = edge_src[e2]
    if reachable[u] {
      let v = edge_dst[e2]
      let nd = match checked_add_i64(distances[u], costs[e2]) {
        Some(x) => x
        None => return Err(WeightOverflow)
      }
      if !reachable[v] || nd < distances[v] {
        return Err(NegativeCycle)
      }
    }
    e2 = e2 + 1
  }

  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Find a negative-weight cycle reachable from `source`, if one exists.
pub fn find_negative_cycle[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  edge_cost : (E) -> Int64,
) -> Result[Option[Array[NodeId]], GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let costs : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut ei = 0
  while ei < m {
    costs[ei] = edge_cost(g.edge_weights[ei])
    ei = ei + 1
  }

  let distances : FixedArray[Int64] = FixedArray::make(n, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  reachable[src] = true

  let edge_src = g.edge_src
  let edge_dst = g.edge_dst

  let mut last_updated = -1
  let mut iter = 0
  while iter < n {
    last_updated = -1
    let mut e = 0
    while e < m {
      let u = edge_src[e]
      if reachable[u] {
        let v = edge_dst[e]
        let nd = match checked_add_i64(distances[u], costs[e]) {
          Some(x) => x
          None => return Err(WeightOverflow)
        }
        if !reachable[v] || nd < distances[v] {
          distances[v] = nd
          reachable[v] = true
          predecessors[v] = u
          last_updated = v
        }
      }
      e = e + 1
    }
    if last_updated == -1 {
      return Ok(None)
    }
    iter = iter + 1
  }

  // Walk `n` steps backwards along predecessors to guarantee entering the negative cycle
  let mut cur = last_updated
  let mut step = 0
  while step < n {
    let p = predecessors[cur]
    if p == -1 {
      break
    }
    cur = p
    step = step + 1
  }
  let start = cur
  let rev : Array[NodeId] = Array::new()
  while true {
    rev.push(NodeId::{ index: cur })
    cur = predecessors[cur]
    if cur == start || cur == -1 || rev.length() > n {
      break
    }
  }
  let cycle : Array[NodeId] = Array::with_capacity(rev.length())
  let mut k = rev.length() - 1
  while k >= 0 {
    cycle.push(rev[k])
    k = k - 1
  }
  Ok(Some(cycle))
}

///| Floyd-Warshall all-pairs shortest paths supporting negative edge weights and negative-cycle detection.
pub fn floyd_warshall[N, E](
  g : DiGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[AllPairsShortestPaths, GraphError] {
  let n = g.node_count()
  let total = n * n
  let distances : FixedArray[Int64] = FixedArray::make(total, MAX_I64)
  let reachable : FixedArray[Bool] = FixedArray::make(total, false)
  let mut i = 0
  while i < n {
    let diag = i * n + i
    distances[diag] = 0L
    reachable[diag] = true
    i = i + 1
  }

  let m = g.edge_count()
  let mut e = 0
  while e < m {
    let u = g.edge_src[e]
    let v = g.edge_dst[e]
    let w = edge_cost(g.edge_weights[e])
    let idx = u * n + v
    if !reachable[idx] || w < distances[idx] {
      distances[idx] = w
      reachable[idx] = true
    }
    e = e + 1
  }

  let mut k = 0
  while k < n {
    let k_row = k * n
    let mut row = 0
    while row < n {
      let ik = row * n + k
      if reachable[ik] {
        let dik = distances[ik]
        let i_row = row * n
        let mut col = 0
        while col < n {
          let kj = k_row + col
          if reachable[kj] {
            let cand = match checked_add_i64(dik, distances[kj]) {
              Some(x) => x
              None => return Err(WeightOverflow)
            }
            let ij = i_row + col
            if !reachable[ij] || cand < distances[ij] {
              distances[ij] = cand
              reachable[ij] = true
            }
          }
          col = col + 1
        }
      }
      row = row + 1
    }
    k = k + 1
  }

  let mut d = 0
  while d < n {
    if distances[d * n + d] < 0L {
      return Err(NegativeCycle)
    }
    d = d + 1
  }
  Ok(AllPairsShortestPaths::{ node_count: n, distances, reachable })
}
