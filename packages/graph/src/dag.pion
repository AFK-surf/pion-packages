///| DAG algorithms: Kahn topological sort, cycle extraction, dominators, transitive closure/reduction.
///| All algorithms are 100% iterative (zero recursion).

///| Internal: given residual indegrees after Kahn's algorithm fails (`order.length() < n`),
///| walk backwards along incoming edges whose source has `indeg > 0` until a node repeats.
///| Guaranteed to return a node that actually lies on a directed cycle in O(V + E).
fn find_cycle_node_from_residual[N, E](g : DiGraph[N, E], indeg : FixedArray[Int]) -> NodeId {
  let n = g.node_count()
  let mut cur = 0
  while cur < n && indeg[cur] <= 0 {
    cur = cur + 1
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let first_in = g.first_in
  let next_in = g.next_in
  let edge_src = g.edge_src
  while !visited[cur] {
    visited[cur] = true
    let mut e = first_in[cur]
    while e != -1 {
      let p = edge_src[e]
      if indeg[p] > 0 {
        cur = p
        break
      }
      e = next_in[e]
    }
  }
  NodeId::{ index: cur }
}

///| Kahn topological sort returning the deterministic lexicographically smallest topological order.
///| On cycles, returns `Err(HasCycle(node))` where `node` is guaranteed to lie on a directed cycle.
pub fn toposort[N, E](g : DiGraph[N, E]) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let indeg : FixedArray[Int] = FixedArray::make(n, 0)
  let m = g.edge_count()
  let edge_dst = g.edge_dst
  let mut i = 0
  while i < m {
    let v = edge_dst[i]
    indeg[v] = indeg[v] + 1
    i = i + 1
  }
  // Inlined 4-ary min-heap on FixedArray[Int]; ascending u scan is already heap-ordered.
  let heap : FixedArray[Int] = FixedArray::make(n, 0)
  let mut hlen = 0
  let mut u = 0
  while u < n {
    if indeg[u] == 0 {
      heap[hlen] = u
      hlen = hlen + 1
    }
    u = u + 1
  }
  let order : Array[NodeId] = Array::with_capacity(n)
  let first_out = g.first_out
  let next_out = g.next_out
  while hlen > 0 {
    let cur = heap[0]
    order.push(NodeId::{ index: cur })
    let mut has_hole = true
    let mut e = first_out[cur]
    while e != -1 {
      let v = edge_dst[e]
      let nd = indeg[v] - 1
      indeg[v] = nd
      if nd == 0 {
        if has_hole {
          has_hole = false
          let mut idx = 0
          while true {
            let c0 = (idx << 2) + 1
            if c0 >= hlen {
              break
            }
            let mut best = c0
            let mut best_v = heap[c0]
            let c3 = c0 + 3
            if c3 < hlen {
              let v1 = heap[c0 + 1]
              if v1 < best_v {
                best = c0 + 1
                best_v = v1
              }
              let v2 = heap[c0 + 2]
              if v2 < best_v {
                best = c0 + 2
                best_v = v2
              }
              let v3 = heap[c3]
              if v3 < best_v {
                best = c3
                best_v = v3
              }
            } else {
              let c1 = c0 + 1
              if c1 < hlen {
                let v1 = heap[c1]
                if v1 < best_v {
                  best = c1
                  best_v = v1
                }
                let c2 = c0 + 2
                if c2 < hlen {
                  let v2 = heap[c2]
                  if v2 < best_v {
                    best = c2
                    best_v = v2
                  }
                }
              }
            }
            if best_v < v {
              heap[idx] = best_v
              idx = best
            } else {
              break
            }
          }
          heap[idx] = v
        } else {
          let mut p_idx = hlen
          hlen = hlen + 1
          while p_idx > 0 {
            let parent = (p_idx - 1) >> 2
            let pv = heap[parent]
            if v < pv {
              heap[p_idx] = pv
              p_idx = parent
            } else {
              break
            }
          }
          heap[p_idx] = v
        }
      }
      e = next_out[e]
    }
    if has_hole {
      hlen = hlen - 1
      if hlen > 0 {
        let last = heap[hlen]
        let mut idx = 0
        while true {
          let c0 = (idx << 2) + 1
          if c0 >= hlen {
            break
          }
          let mut best = c0
          let mut best_v = heap[c0]
          let c3 = c0 + 3
          if c3 < hlen {
            let v1 = heap[c0 + 1]
            if v1 < best_v {
              best = c0 + 1
              best_v = v1
            }
            let v2 = heap[c0 + 2]
            if v2 < best_v {
              best = c0 + 2
              best_v = v2
            }
            let v3 = heap[c3]
            if v3 < best_v {
              best = c3
              best_v = v3
            }
          } else {
            let c1 = c0 + 1
            if c1 < hlen {
              let v1 = heap[c1]
              if v1 < best_v {
                best = c1
                best_v = v1
              }
              let c2 = c0 + 2
              if c2 < hlen {
                let v2 = heap[c2]
                if v2 < best_v {
                  best = c2
                  best_v = v2
                }
              }
            }
          }
          if best_v < last {
            heap[idx] = best_v
            idx = best
          } else {
            break
          }
        }
        heap[idx] = last
      }
    }
  }
  if order.length() != n {
    return Err(HasCycle(find_cycle_node_from_residual(g, indeg)))
  }
  Ok(order)
}

///| O(V + E) Kahn topological sort returning any valid topological order (FIFO queue, no heap).
///| On cycles, returns `Err(HasCycle(node))` where `node` is guaranteed to lie on a directed cycle.
pub fn toposort_any[N, E](g : DiGraph[N, E]) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let indeg : FixedArray[Int] = FixedArray::make(n, 0)
  let m = g.edge_count()
  let edge_dst = g.edge_dst
  let mut i = 0
  while i < m {
    let v = edge_dst[i]
    indeg[v] = indeg[v] + 1
    i = i + 1
  }
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let mut head = 0
  let mut tail = 0
  let mut u = 0
  while u < n {
    if indeg[u] == 0 {
      queue[tail] = u
      tail = tail + 1
    }
    u = u + 1
  }
  let order : Array[NodeId] = Array::with_capacity(n)
  let first_out = g.first_out
  let next_out = g.next_out
  while head < tail {
    let cur = queue[head]
    head = head + 1
    order.push(NodeId::{ index: cur })
    let mut e = first_out[cur]
    while e != -1 {
      let v = edge_dst[e]
      let nd = indeg[v] - 1
      indeg[v] = nd
      if nd == 0 {
        queue[tail] = v
        tail = tail + 1
      }
      e = next_out[e]
    }
  }
  if order.length() != n {
    return Err(HasCycle(find_cycle_node_from_residual(g, indeg)))
  }
  Ok(order)
}

///| Iterative 3-color DFS cycle detection returning an exact directed cycle path if one exists.
pub fn find_cycle[N, E](g : DiGraph[N, E]) -> Option[Array[NodeId]] {
  let n = g.node_count()
  if n == 0 {
    return None
  }
  // color: 0 = unvisited, 1 = on current DFS stack, 2 = finished
  let color : FixedArray[Int] = FixedArray::make(n, 0)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let stack_pos : FixedArray[Int] = FixedArray::make(n, -1)

  let mut start = 0
  while start < n {
    if color[start] != 0 {
      start = start + 1
      continue
    }
    color[start] = 1
    s_node[0] = start
    s_edge[0] = g.first_out[start]
    stack_pos[start] = 0
    let mut top = 1

    while top > 0 {
      let ti = top - 1
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_out[e]
        let v = g.edge_dst[e]
        let cv = color[v]
        if cv == 1 {
          // Cycle found from stack_pos[v] .. ti
          let sp = stack_pos[v]
          let cyc : Array[NodeId] = Array::with_capacity(ti - sp + 1)
          let mut k = sp
          while k <= ti {
            cyc.push(NodeId::{ index: s_node[k] })
            k = k + 1
          }
          return Some(cyc)
        } else if cv == 0 {
          color[v] = 1
          s_node[top] = v
          s_edge[top] = g.first_out[v]
          stack_pos[v] = top
          top = top + 1
        }
      } else {
        let u = s_node[ti]
        color[u] = 2
        stack_pos[u] = -1
        top = top - 1
      }
    }
    start = start + 1
  }
  None
}

///| Return `true` iff the directed graph contains at least one directed cycle.
pub fn is_cyclic[N, E](g : DiGraph[N, E]) -> Bool {
  match find_cycle(g) {
    Some(_) => true
    None => false
  }
}

///| Cooper-Harvey-Kennedy iterative dominator tree rooted at `root` (zero HashMap/HashSet).
pub fn dominators[N, E](g : DiGraph[N, E], root : NodeId) -> Result[Dominators, GraphError] {
  let n = g.node_count()
  let r = root.index
  if r < 0 || r >= n {
    return Err(InvalidNode(r))
  }
  // 1. Iterative postorder DFS from root
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let post_order : FixedArray[Int] = FixedArray::make(n, 0)
  let post_idx : FixedArray[Int] = FixedArray::make(n, -1)
  let mut post_len = 0

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst

  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  visited[r] = true
  s_node[0] = r
  s_edge[0] = first_out[r]
  let mut top = 1

  while top > 0 {
    let ti = top - 1
    let mut e = s_edge[ti]
    let mut descended = false
    while e != -1 {
      let nxt = next_out[e]
      let v = edge_dst[e]
      if !visited[v] {
        s_edge[ti] = nxt
        visited[v] = true
        s_node[top] = v
        s_edge[top] = first_out[v]
        top = top + 1
        descended = true
        break
      }
      e = nxt
    }
    if !descended {
      let u = s_node[ti]
      post_idx[u] = post_len
      post_order[post_len] = u
      post_len = post_len + 1
      top = ti
    }
  }

  // 2. Cooper-Harvey-Kennedy iterative dataflow using `first_in` / `next_in` directly!
  let doms : FixedArray[Int] = FixedArray::make(post_len, -1)
  let root_pi = post_len - 1
  doms[root_pi] = root_pi

  let first_in = g.first_in
  let next_in = g.next_in
  let edge_src = g.edge_src

  let mut changed = true
  while changed {
    changed = false
    let mut idx = post_len - 2
    while idx >= 0 {
      let u = post_order[idx]
      let mut new_idom = -1
      let mut e = first_in[u]
      while e != -1 {
        let pred_pi = post_idx[edge_src[e]]
        if pred_pi >= 0 && doms[pred_pi] != -1 {
          if new_idom == -1 {
            new_idom = pred_pi
          } else {
            let mut f1 = new_idom
            let mut f2 = pred_pi
            while f1 != f2 {
              while f1 < f2 {
                f1 = doms[f1]
              }
              while f2 < f1 {
                f2 = doms[f2]
              }
            }
            new_idom = f1
          }
        }
        e = next_in[e]
      }
      if new_idom != doms[idx] {
        doms[idx] = new_idom
        changed = true
      }
      idx = idx - 1
    }
  }

  let idom : FixedArray[Int] = FixedArray::make(n, -1)
  let mut m = 0
  while m < post_len {
    idom[post_order[m]] = post_order[doms[m]]
    m = m + 1
  }
  Ok(Dominators::{ root, node_count: n, idom })
}

///| Return the immediate dominator of `node`, or `None` if `node` is the root or unreachable.
pub fn Dominators::immediate_dominator(self : Dominators, node : NodeId) -> Option[NodeId] {
  let u = node.index
  if u < 0 || u >= self.node_count || u == self.root.index {
    return None
  }
  let p = self.idom[u]
  if p < 0 {
    None
  } else {
    Some(NodeId::{ index: p })
  }
}

///| Return `true` iff `a` dominates `b` (every reachable node dominates itself).
pub fn Dominators::dominates(self : Dominators, a : NodeId, b : NodeId) -> Bool {
  let ai = a.index
  let bi = b.index
  if ai < 0 || ai >= self.node_count || bi < 0 || bi >= self.node_count {
    return false
  }
  if self.idom[bi] < 0 {
    return false
  }
  let mut cur = bi
  while true {
    if cur == ai {
      return true
    }
    if cur == self.root.index {
      return false
    }
    let next = self.idom[cur]
    if next < 0 || next == cur {
      return false
    }
    cur = next
  }
  false
}

///| Return all strict dominators of `node` (from immediate dominator up to root), or `None` if unreachable.
pub fn Dominators::strict_dominators(self : Dominators, node : NodeId) -> Option[Array[NodeId]] {
  let u = node.index
  if u < 0 || u >= self.node_count || self.idom[u] < 0 {
    return None
  }
  let out : Array[NodeId] = Array::new()
  let mut cur = u
  while cur != self.root.index {
    let p = self.idom[cur]
    if p < 0 || p == cur {
      break
    }
    out.push(NodeId::{ index: p })
    cur = p
  }
  Some(out)
}

///| Return all dominators of `node` (starting with `node` up to root), or `None` if unreachable.
pub fn Dominators::all_dominators(self : Dominators, node : NodeId) -> Option[Array[NodeId]] {
  let u = node.index
  if u < 0 || u >= self.node_count || self.idom[u] < 0 {
    return None
  }
  let out : Array[NodeId] = Array::new()
  let mut cur = u
  while true {
    out.push(NodeId::{ index: cur })
    if cur == self.root.index {
      break
    }
    let p = self.idom[cur]
    if p < 0 || p == cur {
      break
    }
    cur = p
  }
  Some(out)
}

///| Return all nodes whose immediate dominator is `node`.
pub fn Dominators::immediately_dominated_by(self : Dominators, node : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  let u = node.index
  if u < 0 || u >= self.node_count {
    return out
  }
  let mut i = 0
  while i < self.node_count {
    if i != self.root.index && self.idom[i] == u {
      out.push(NodeId::{ index: i })
    }
    i = i + 1
  }
  out
}

///| Internal: simple insertion sort for small dominance frontier arrays.
fn sort_node_ids(arr : Array[NodeId]) -> Unit {
  let len = arr.length()
  let mut i = 1
  while i < len {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j].index > key.index {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| Compute dominance frontiers for every node `0 ..< node_count` (Cooper-Harvey-Kennedy Fig. 5,
///| extended to handle back-edges and self-loops targeting the entry `root` per Cytron et al.).
pub fn Dominators::dominance_frontiers[N, E](
  self : Dominators,
  g : DiGraph[N, E],
) -> Array[Array[NodeId]] {
  let n = self.node_count
  let frontiers : Array[Array[NodeId]] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    frontiers.push(Array::new())
    i = i + 1
  }
  if n == 0 || g.node_count() != n {
    return frontiers
  }
  let root_idx = self.root.index
  // Stamp array for O(1) deduplication: last_added[runner] == b means `b` already in DF[runner].
  let last_added : FixedArray[Int] = FixedArray::make(n, -1)
  let mut b = 0
  while b < n {
    let idom_b = self.idom[b]
    if idom_b < 0 {
      b = b + 1
      continue
    }
    if b == root_idx {
      // Entry node has a virtual entry edge: every reachable predecessor (including a self-loop)
      // puts `root` in the dominance frontier of every node from `p` up to and including `root`.
      let mut e = g.first_in[b]
      while e != -1 {
        let mut runner = g.edge_src[e]
        if self.idom[runner] >= 0 {
          while true {
            if last_added[runner] != b {
              last_added[runner] = b
              frontiers[runner].push(NodeId::{ index: b })
            }
            if runner == root_idx {
              break
            }
            runner = self.idom[runner]
          }
        }
        e = g.next_in[e]
      }
    } else {
      // Count reachable predecessors of b
      let mut reach_preds = 0
      let mut e = g.first_in[b]
      while e != -1 {
        let p = g.edge_src[e]
        if self.idom[p] >= 0 {
          reach_preds = reach_preds + 1
        }
        e = g.next_in[e]
      }
      if reach_preds >= 2 {
        let mut e2 = g.first_in[b]
        while e2 != -1 {
          let mut runner = g.edge_src[e2]
          if self.idom[runner] >= 0 {
            while runner != idom_b {
              if last_added[runner] != b {
                last_added[runner] = b
                frontiers[runner].push(NodeId::{ index: b })
              }
              if runner == root_idx {
                break
              }
              runner = self.idom[runner]
            }
          }
          e2 = g.next_in[e2]
        }
      }
    }
    b = b + 1
  }
  let mut k = 0
  while k < n {
    if frontiers[k].length() > 1 {
      sort_node_ids(frontiers[k])
    }
    k = k + 1
  }
  frontiers
}

///| Compute the transitive closure of a DAG using bitset DP in reverse topological order.
pub fn transitive_closure[N, E](g : DiGraph[N, E]) -> Result[DiGraph[Unit, Unit], GraphError] {
  let order = match toposort_any(g) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let n = g.node_count()
  if n == 0 {
    return Ok(DiGraph::new())
  }
  let words = (n + 63) / 64
  let total_words64 = n.to_int64() * words.to_int64()
  if total_words64 > 268435456L {
    return Err(InvalidArgument("transitive_closure graph too large for bitset"))
  }
  let out : DiGraph[Unit, Unit] = DiGraph::with_capacity(n, n)
  let mut i = 0
  while i < n {
    let _ = out.add_node(())
    i = i + 1
  }
  let reach : FixedArray[UInt64] = FixedArray::make(total_words64.to_int(), 0UL)

  let mut idx = n - 1
  while idx >= 0 {
    let u = order[idx].index
    let u_base = u * words
    let mut e = g.first_out[u]
    while e != -1 {
      let v = g.edge_dst[e]
      let v_word = v >> 6
      let v_bit = 1UL << (v & 63)
      reach[u_base + v_word] = reach[u_base + v_word] | v_bit
      let v_base = v * words
      let mut w = 0
      while w < words {
        reach[u_base + w] = reach[u_base + w] | reach[v_base + w]
        w = w + 1
      }
      e = g.next_out[e]
    }
    idx = idx - 1
  }

  let mut u = 0
  while u < n {
    let u_base = u * words
    let mut v = 0
    while v < n {
      if (reach[u_base + (v >> 6)] & (1UL << (v & 63))) != 0UL {
        let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: v }, ())
      }
      v = v + 1
    }
    u = u + 1
  }
  Ok(out)
}

///| Compute the transitive reduction of a DAG in O(V + E) memory.
///| Uses O(1) fast-skips for nodes with <= 1 distinct out-neighbor or all-sink neighbors,
///| and epoch-stamped iterative DFS with topological-order pruning for general nodes.
pub fn transitive_reduction[N, E](g : DiGraph[N, E]) -> Result[DiGraph[Unit, Unit], GraphError] {
  let order = match toposort_any(g) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let n = g.node_count()
  let out : DiGraph[Unit, Unit] = DiGraph::with_capacity(n, g.edge_count())
  let mut i = 0
  while i < n {
    let _ = out.add_node(())
    i = i + 1
  }
  if n == 0 {
    return Ok(out)
  }

  let topo_pos : FixedArray[Int] = FixedArray::make(n, 0)
  let mut ti = 0
  while ti < n {
    topo_pos[order[ti].index] = ti
    ti = ti + 1
  }

  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst

  // Stamp arrays for O(1) per-node reset without allocating V*V/64 bitsets
  let direct_stamp : FixedArray[Int] = FixedArray::make(n, -1)
  let indirect_stamp : FixedArray[Int] = FixedArray::make(n, -1)
  let stack : FixedArray[Int] = FixedArray::make(n, 0)
  let nbrs : Array[Int] = Array::new()

  let mut u = 0
  while u < n {
    let e0 = first_out[u]
    if e0 == -1 {
      u = u + 1
      continue
    }
    let e1 = next_out[e0]
    if e1 == -1 {
      // Out-degree 1: single edge can never be transitive
      let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: edge_dst[e0] }, ())
      u = u + 1
      continue
    }

    // Collect deduplicated direct out-neighbors of u
    let mut distinct = 0
    let mut non_sink_count = 0
    let mut max_tp = -1
    let mut e = e0
    while e != -1 {
      let v = edge_dst[e]
      if direct_stamp[v] != u {
        direct_stamp[v] = u
        if distinct < nbrs.length() {
          nbrs[distinct] = v
        } else {
          nbrs.push(v)
        }
        distinct = distinct + 1
        if first_out[v] != -1 {
          non_sink_count = non_sink_count + 1
        }
        let tp = topo_pos[v]
        if tp > max_tp {
          max_tp = tp
        }
      }
      e = next_out[e]
    }

    if distinct == 1 || non_sink_count == 0 {
      // Either only 1 distinct neighbor (parallel edges), or every neighbor is a sink
      // (so no neighbor can reach any other neighbor — e.g. out-stars).
      let mut k = 0
      while k < distinct {
        let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: nbrs[k] }, ())
        k = k + 1
      }
      u = u + 1
      continue
    }

    // Run iterative DFS from the out-neighbors of every direct neighbor w of u,
    // pruning any node with topo_pos > max_tp (cannot reach any direct neighbor of u).
    let mut top = 0
    let mut k = 0
    while k < distinct {
      let w = nbrs[k]
      let mut ew = first_out[w]
      while ew != -1 {
        let nxt = edge_dst[ew]
        if topo_pos[nxt] <= max_tp && indirect_stamp[nxt] != u {
          indirect_stamp[nxt] = u
          stack[top] = nxt
          top = top + 1
        }
        ew = next_out[ew]
      }
      k = k + 1
    }

    while top > 0 {
      top = top - 1
      let x = stack[top]
      let mut ex = first_out[x]
      while ex != -1 {
        let y = edge_dst[ex]
        if topo_pos[y] <= max_tp && indirect_stamp[y] != u {
          indirect_stamp[y] = u
          stack[top] = y
          top = top + 1
        }
        ex = next_out[ex]
      }
    }

    // Keep u -> v iff v was not reached indirectly
    let mut k2 = 0
    while k2 < distinct {
      let v = nbrs[k2]
      if indirect_stamp[v] != u {
        let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: v }, ())
      }
      k2 = k2 + 1
    }
    u = u + 1
  }
  Ok(out)
}
