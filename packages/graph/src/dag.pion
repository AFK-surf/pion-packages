///| DAG algorithms: Kahn topological sort, cycle extraction, dominators, transitive closure/reduction.
///| All algorithms are 100% iterative (zero recursion).

///| Kahn topological sort returning the deterministic lexicographically smallest topological order.
pub fn toposort[N, E](g : DiGraph[N, E]) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let indeg : FixedArray[Int] = FixedArray::make(n, 0)
  let m = g.edge_count()
  let edge_dst = g.edge_dst
  let mut i = 0
  while i < m {
    let v = edge_dst[i]
    indeg[v] = indeg[v] + 1
    i = i + 1
  }
  let heap = MinHeapInt::with_capacity(n)
  let mut u = 0
  while u < n {
    if indeg[u] == 0 {
      heap.push(u)
    }
    u = u + 1
  }
  let order : Array[NodeId] = Array::with_capacity(n)
  let first_out = g.first_out
  let next_out = g.next_out
  while !heap.is_empty() {
    let cur = heap.pop_min()
    order.push(NodeId::{ index: cur })
    let mut e = first_out[cur]
    while e != -1 {
      let v = edge_dst[e]
      let nd = indeg[v] - 1
      indeg[v] = nd
      if nd == 0 {
        heap.push(v)
      }
      e = next_out[e]
    }
  }
  if order.length() != n {
    let mut k = 0
    while k < n {
      if indeg[k] > 0 {
        return Err(HasCycle(NodeId::{ index: k }))
      }
      k = k + 1
    }
  }
  Ok(order)
}

///| Iterative 3-color DFS cycle detection returning an exact directed cycle path if one exists.
pub fn find_cycle[N, E](g : DiGraph[N, E]) -> Option[Array[NodeId]] {
  let n = g.node_count()
  if n == 0 {
    return None
  }
  // color: 0 = unvisited, 1 = on current DFS stack, 2 = finished
  let color : FixedArray[Int] = FixedArray::make(n, 0)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let stack_pos : FixedArray[Int] = FixedArray::make(n, -1)

  let mut start = 0
  while start < n {
    if color[start] != 0 {
      start = start + 1
      continue
    }
    color[start] = 1
    s_node[0] = start
    s_edge[0] = g.first_out[start]
    stack_pos[start] = 0
    let mut top = 1

    while top > 0 {
      let ti = top - 1
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_out[e]
        let v = g.edge_dst[e]
        let cv = color[v]
        if cv == 1 {
          // Cycle found from stack_pos[v] .. ti
          let sp = stack_pos[v]
          let cyc : Array[NodeId] = Array::with_capacity(ti - sp + 1)
          let mut k = sp
          while k <= ti {
            cyc.push(NodeId::{ index: s_node[k] })
            k = k + 1
          }
          return Some(cyc)
        } else if cv == 0 {
          color[v] = 1
          s_node[top] = v
          s_edge[top] = g.first_out[v]
          stack_pos[v] = top
          top = top + 1
        }
      } else {
        let u = s_node[ti]
        color[u] = 2
        stack_pos[u] = -1
        top = top - 1
      }
    }
    start = start + 1
  }
  None
}

///| Return `true` iff the directed graph contains at least one directed cycle.
pub fn is_cyclic[N, E](g : DiGraph[N, E]) -> Bool {
  match find_cycle(g) {
    Some(_) => true
    None => false
  }
}

///| Cooper-Harvey-Kennedy iterative dominator tree rooted at `root` (zero HashMap/HashSet).
pub fn dominators[N, E](g : DiGraph[N, E], root : NodeId) -> Result[Dominators, GraphError] {
  let n = g.node_count()
  let r = root.index
  if r < 0 || r >= n {
    return Err(InvalidNode(r))
  }
  // 1. Iterative postorder DFS from root
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let post_order : FixedArray[Int] = FixedArray::make(n, 0)
  let post_idx : FixedArray[Int] = FixedArray::make(n, -1)
  let mut post_len = 0

  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  visited[r] = true
  s_node[0] = r
  s_edge[0] = g.first_out[r]
  let mut top = 1

  while top > 0 {
    let ti = top - 1
    let e = s_edge[ti]
    if e != -1 {
      s_edge[ti] = g.next_out[e]
      let v = g.edge_dst[e]
      if !visited[v] {
        visited[v] = true
        s_node[top] = v
        s_edge[top] = g.first_out[v]
        top = top + 1
      }
    } else {
      let u = s_node[ti]
      post_idx[u] = post_len
      post_order[post_len] = u
      post_len = post_len + 1
      top = top - 1
    }
  }

  // 2. Cooper-Harvey-Kennedy iterative dataflow using `first_in` / `next_in` directly!
  let doms : FixedArray[Int] = FixedArray::make(post_len, -1)
  let root_pi = post_len - 1
  doms[root_pi] = root_pi

  let first_in = g.first_in
  let next_in = g.next_in
  let edge_src = g.edge_src

  let mut changed = true
  while changed {
    changed = false
    let mut idx = post_len - 2
    while idx >= 0 {
      let u = post_order[idx]
      let mut new_idom = -1
      let mut e = first_in[u]
      while e != -1 {
        let pred_pi = post_idx[edge_src[e]]
        if pred_pi >= 0 && doms[pred_pi] != -1 {
          if new_idom == -1 {
            new_idom = pred_pi
          } else {
            let mut f1 = new_idom
            let mut f2 = pred_pi
            while f1 != f2 {
              while f1 < f2 {
                f1 = doms[f1]
              }
              while f2 < f1 {
                f2 = doms[f2]
              }
            }
            new_idom = f1
          }
        }
        e = next_in[e]
      }
      if new_idom != doms[idx] {
        doms[idx] = new_idom
        changed = true
      }
      idx = idx - 1
    }
  }

  let idom : FixedArray[Int] = FixedArray::make(n, -1)
  let mut m = 0
  while m < post_len {
    idom[post_order[m]] = post_order[doms[m]]
    m = m + 1
  }
  Ok(Dominators::{ root, node_count: n, idom })
}

///| Return the immediate dominator of `node`, or `None` if `node` is the root or unreachable.
pub fn Dominators::immediate_dominator(self : Dominators, node : NodeId) -> Option[NodeId] {
  let u = node.index
  if u < 0 || u >= self.node_count || u == self.root.index {
    return None
  }
  let p = self.idom[u]
  if p < 0 {
    None
  } else {
    Some(NodeId::{ index: p })
  }
}

///| Return `true` iff `a` dominates `b` (every reachable node dominates itself).
pub fn Dominators::dominates(self : Dominators, a : NodeId, b : NodeId) -> Bool {
  let ai = a.index
  let bi = b.index
  if ai < 0 || ai >= self.node_count || bi < 0 || bi >= self.node_count {
    return false
  }
  if self.idom[bi] < 0 {
    return false
  }
  let mut cur = bi
  while true {
    if cur == ai {
      return true
    }
    if cur == self.root.index {
      return false
    }
    let next = self.idom[cur]
    if next < 0 || next == cur {
      return false
    }
    cur = next
  }
  false
}

///| Return all strict dominators of `node` (from immediate dominator up to root), or `None` if unreachable.
pub fn Dominators::strict_dominators(self : Dominators, node : NodeId) -> Option[Array[NodeId]] {
  let u = node.index
  if u < 0 || u >= self.node_count || self.idom[u] < 0 {
    return None
  }
  let out : Array[NodeId] = Array::new()
  let mut cur = u
  while cur != self.root.index {
    let p = self.idom[cur]
    if p < 0 || p == cur {
      break
    }
    out.push(NodeId::{ index: p })
    cur = p
  }
  Some(out)
}

///| Return all dominators of `node` (starting with `node` up to root), or `None` if unreachable.
pub fn Dominators::all_dominators(self : Dominators, node : NodeId) -> Option[Array[NodeId]] {
  let u = node.index
  if u < 0 || u >= self.node_count || self.idom[u] < 0 {
    return None
  }
  let out : Array[NodeId] = Array::new()
  let mut cur = u
  while true {
    out.push(NodeId::{ index: cur })
    if cur == self.root.index {
      break
    }
    let p = self.idom[cur]
    if p < 0 || p == cur {
      break
    }
    cur = p
  }
  Some(out)
}

///| Return all nodes whose immediate dominator is `node`.
pub fn Dominators::immediately_dominated_by(self : Dominators, node : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  let u = node.index
  if u < 0 || u >= self.node_count {
    return out
  }
  let mut i = 0
  while i < self.node_count {
    if i != self.root.index && self.idom[i] == u {
      out.push(NodeId::{ index: i })
    }
    i = i + 1
  }
  out
}

///| Internal: simple insertion sort for small dominance frontier arrays.
fn sort_node_ids(arr : Array[NodeId]) -> Unit {
  let len = arr.length()
  let mut i = 1
  while i < len {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j].index > key.index {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| Compute dominance frontiers for every node `0 ..< node_count` (Cooper-Harvey-Kennedy Fig. 5).
pub fn Dominators::dominance_frontiers[N, E](
  self : Dominators,
  g : DiGraph[N, E],
) -> Array[Array[NodeId]] {
  let n = self.node_count
  let frontiers : Array[Array[NodeId]] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    frontiers.push(Array::new())
    i = i + 1
  }
  if n == 0 || g.node_count() != n {
    return frontiers
  }
  // Stamp array for O(1) deduplication: last_added[runner] == b means `b` already in DF[runner].
  let last_added : FixedArray[Int] = FixedArray::make(n, -1)
  let mut b = 0
  while b < n {
    let idom_b = self.idom[b]
    if idom_b < 0 {
      b = b + 1
      continue
    }
    // Count reachable predecessors of b
    let mut reach_preds = 0
    let mut e = g.first_in[b]
    while e != -1 {
      let p = g.edge_src[e]
      if self.idom[p] >= 0 {
        reach_preds = reach_preds + 1
      }
      e = g.next_in[e]
    }
    if reach_preds >= 2 {
      let mut e2 = g.first_in[b]
      while e2 != -1 {
        let mut runner = g.edge_src[e2]
        if self.idom[runner] >= 0 {
          while runner != idom_b {
            if last_added[runner] != b {
              last_added[runner] = b
              frontiers[runner].push(NodeId::{ index: b })
            }
            if runner == self.root.index {
              break
            }
            runner = self.idom[runner]
          }
        }
        e2 = g.next_in[e2]
      }
    }
    b = b + 1
  }
  let mut k = 0
  while k < n {
    if frontiers[k].length() > 1 {
      sort_node_ids(frontiers[k])
    }
    k = k + 1
  }
  frontiers
}

///| Compute the transitive closure of a DAG using bitset DP in reverse topological order.
pub fn transitive_closure[N, E](g : DiGraph[N, E]) -> Result[DiGraph[Unit, Unit], GraphError] {
  let order = match toposort(g) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let n = g.node_count()
  let out : DiGraph[Unit, Unit] = DiGraph::with_capacity(n, n)
  let mut i = 0
  while i < n {
    let _ = out.add_node(())
    i = i + 1
  }
  if n == 0 {
    return Ok(out)
  }
  let words = (n + 63) / 64
  let reach : FixedArray[UInt64] = FixedArray::make(n * words, 0UL)

  let mut idx = n - 1
  while idx >= 0 {
    let u = order[idx].index
    let u_base = u * words
    let mut e = g.first_out[u]
    while e != -1 {
      let v = g.edge_dst[e]
      let v_word = v >> 6
      let v_bit = 1UL << (v & 63)
      reach[u_base + v_word] = reach[u_base + v_word] | v_bit
      let v_base = v * words
      let mut w = 0
      while w < words {
        reach[u_base + w] = reach[u_base + w] | reach[v_base + w]
        w = w + 1
      }
      e = g.next_out[e]
    }
    idx = idx - 1
  }

  let mut u = 0
  while u < n {
    let u_base = u * words
    let mut v = 0
    while v < n {
      if (reach[u_base + (v >> 6)] & (1UL << (v & 63))) != 0UL {
        let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: v }, ())
      }
      v = v + 1
    }
    u = u + 1
  }
  Ok(out)
}

///| Compute the transitive reduction of a DAG.
pub fn transitive_reduction[N, E](g : DiGraph[N, E]) -> Result[DiGraph[Unit, Unit], GraphError] {
  let order = match toposort(g) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let n = g.node_count()
  let out : DiGraph[Unit, Unit] = DiGraph::with_capacity(n, g.edge_count())
  let mut i = 0
  while i < n {
    let _ = out.add_node(())
    i = i + 1
  }
  if n == 0 {
    return Ok(out)
  }
  let words = (n + 63) / 64
  // reach[u] = all nodes strictly reachable from u
  let reach : FixedArray[UInt64] = FixedArray::make(n * words, 0UL)
  let indirect : FixedArray[UInt64] = FixedArray::make(words, 0UL)

  let mut idx = n - 1
  while idx >= 0 {
    let u = order[idx].index
    let u_base = u * words
    // Zero out indirect buffer
    let mut w0 = 0
    while w0 < words {
      indirect[w0] = 0UL
      w0 = w0 + 1
    }
    // Union of reach[v] for all direct out-neighbors v of u
    let mut e = g.first_out[u]
    while e != -1 {
      let v = g.edge_dst[e]
      let v_base = v * words
      let mut w = 0
      while w < words {
        let rv = reach[v_base + w]
        indirect[w] = indirect[w] | rv
        reach[u_base + w] = reach[u_base + w] | rv
        w = w + 1
      }
      reach[u_base + (v >> 6)] = reach[u_base + (v >> 6)] | (1UL << (v & 63))
      e = g.next_out[e]
    }
    // Keep edge u -> v iff v is NOT in indirect (and deduplicate parallel edges via seen bit)
    let mut e2 = g.first_out[u]
    while e2 != -1 {
      let v = g.edge_dst[e2]
      let vw = v >> 6
      let vb = 1UL << (v & 63)
      if (indirect[vw] & vb) == 0UL {
        indirect[vw] = indirect[vw] | vb
        let _ = out.add_edge(NodeId::{ index: u }, NodeId::{ index: v }, ())
      }
      e2 = g.next_out[e2]
    }
    idx = idx - 1
  }
  Ok(out)
}
