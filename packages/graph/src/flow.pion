///| Maximum flow and minimum S-T cut using Dinic's algorithm with current-arc optimization.
///| 100% iterative (zero recursion).

///| Compute maximum flow and minimum S-T cut from `source` to `sink` using Dinic's algorithm.
pub fn dinic_max_flow[N, E](
  g : DiGraph[N, E],
  source : NodeId,
  sink : NodeId,
  capacity : (E) -> Int64,
) -> Result[MaxFlowResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let s = source.index
  let t = sink.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  if t < 0 || t >= n {
    return Err(InvalidNode(t))
  }

  // Build residual graph with 2*m half-edges (forward = 2*i, reverse = 2*i + 1)
  let head : FixedArray[Int] = FixedArray::make(n, -1)
  let res_to : FixedArray[Int] = FixedArray::make(m * 2, 0)
  let res_cap : FixedArray[Int64] = FixedArray::make(m * 2, 0L)
  let res_next : FixedArray[Int] = FixedArray::make(m * 2, -1)

  let mut i = 0
  while i < m {
    let cap = capacity(g.edge_weights[i])
    if cap < 0L {
      return Err(NegativeCapacity(cap))
    }
    let u = g.edge_src[i]
    let v = g.edge_dst[i]
    let fwd = i << 1
    let rev = fwd + 1
    res_to[fwd] = v
    res_cap[fwd] = cap
    res_next[fwd] = head[u]
    head[u] = fwd

    res_to[rev] = u
    res_cap[rev] = 0L
    res_next[rev] = head[v]
    head[v] = rev
    i = i + 1
  }

  if s == t {
    let edge_flows : FixedArray[Int64] = FixedArray::make(m, 0L)
    let source_side : FixedArray[Bool] = FixedArray::make(n, false)
    source_side[s] = true
    return Ok(MaxFlowResult::{ max_flow: 0L, edge_flows, source_side })
  }

  let level : FixedArray[Int] = FixedArray::make(n, -1)
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let cur_arc : FixedArray[Int] = FixedArray::make(n, -1)
  let path_node : FixedArray[Int] = FixedArray::make(n, 0)
  let path_edge : FixedArray[Int] = FixedArray::make(n, -1)

  let mut total_flow : Int64 = 0L

  while true {
    // 1. BFS to build level graph
    let mut k = 0
    while k < n {
      level[k] = -1
      k = k + 1
    }
    level[s] = 0
    queue[0] = s
    let mut q_head = 0
    let mut q_tail = 1
    while q_head < q_tail {
      let u = queue[q_head]
      q_head = q_head + 1
      let next_lvl = level[u] + 1
      let mut e = head[u]
      while e != -1 {
        let v = res_to[e]
        if res_cap[e] > 0L && level[v] == -1 {
          level[v] = next_lvl
          queue[q_tail] = v
          q_tail = q_tail + 1
        }
        e = res_next[e]
      }
    }
    if level[t] == -1 {
      break
    }

    // 2. Copy current-arc pointers
    let mut c = 0
    while c < n {
      cur_arc[c] = head[c]
      c = c + 1
    }

    // 3. Iterative DFS with current-arc optimization & dead-node pruning
    path_node[0] = s
    path_edge[0] = -1
    let mut depth = 0

    while depth >= 0 {
      let u = path_node[depth]
      if u == t {
        // Compute bottleneck along path_edge[1 ..= depth]
        let mut bottle = MAX_I64
        let mut p = 1
        while p <= depth {
          let cap_p = res_cap[path_edge[p]]
          if cap_p < bottle {
            bottle = cap_p
          }
          p = p + 1
        }
        // Augment and find shallowest saturated edge
        let mut first_sat = -1
        let mut p2 = 1
        while p2 <= depth {
          let e = path_edge[p2]
          let rem = res_cap[e] - bottle
          res_cap[e] = rem
          res_cap[e ^ 1] = res_cap[e ^ 1] + bottle
          if rem == 0L && first_sat == -1 {
            first_sat = p2
          }
          p2 = p2 + 1
        }
        total_flow = match checked_add_i64(total_flow, bottle) {
          Some(x) => x
          None => return Err(WeightOverflow)
        }
        // Backtrack to node before first saturated edge and advance its current arc
        depth = first_sat - 1
        let back_u = path_node[depth]
        let ca = cur_arc[back_u]
        if ca != -1 {
          cur_arc[back_u] = res_next[ca]
        }
      } else {
        let mut e = cur_arc[u]
        let want_lvl = level[u] + 1
        while e != -1 {
          let v = res_to[e]
          if res_cap[e] > 0L && level[v] == want_lvl {
            break
          }
          e = res_next[e]
        }
        cur_arc[u] = e
        if e != -1 {
          depth = depth + 1
          path_node[depth] = res_to[e]
          path_edge[depth] = e
        } else {
          // Prune dead node from this phase
          level[u] = -1
          depth = depth - 1
          if depth >= 0 {
            let parent = path_node[depth]
            let ca = cur_arc[parent]
            if ca != -1 {
              cur_arc[parent] = res_next[ca]
            }
          }
        }
      }
    }
  }

  let edge_flows : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut j = 0
  while j < m {
    edge_flows[j] = res_cap[(j << 1) + 1]
    j = j + 1
  }
  let source_side : FixedArray[Bool] = FixedArray::make(n, false)
  let mut v = 0
  while v < n {
    source_side[v] = level[v] != -1
    v = v + 1
  }
  Ok(MaxFlowResult::{ max_flow: total_flow, edge_flows, source_side })
}
