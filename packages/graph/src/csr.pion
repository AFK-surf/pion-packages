///| Immutable Compressed Sparse Row (CSR) directed graph `CsrGraph[E]` and fast CSR kernels.

///| Compact read-only CSR graph with contiguous outgoing adjacency slices.
pub struct CsrGraph[E] {
  node_count : Int
  row_offsets : FixedArray[Int]
  targets : FixedArray[Int]
  weights : Array[E]
}

///| Build a `CsrGraph[E]` from a `DiGraph[N, E]` in O(V + E).
pub fn CsrGraph::from_digraph[N, E](g : DiGraph[N, E]) -> CsrGraph[E] {
  let n = g.node_count()
  let m = g.edge_count()
  let row_offsets : FixedArray[Int] = FixedArray::make(n + 1, 0)
  let targets : FixedArray[Int] = FixedArray::make(m, 0)
  let weights : Array[E] = Array::with_capacity(m)
  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst
  let edge_weights = g.edge_weights
  let mut pos = 0
  let mut u = 0
  while u < n {
    row_offsets[u] = pos
    let mut e = first_out[u]
    while e != -1 {
      targets[pos] = edge_dst[e]
      weights.push(edge_weights[e])
      pos = pos + 1
      e = next_out[e]
    }
    u = u + 1
  }
  row_offsets[n] = pos
  CsrGraph::{ node_count: n, row_offsets, targets, weights }
}

///| Validate `CsrGraph` node count against supported upper bound `[0, 67108864]`.
pub fn is_valid_node_count(node_count : Int) -> Bool {
  node_count >= 0 && node_count <= 67108864
}

///| Validate a node index `idx` against graph node count `n`.
pub fn is_valid_node_idx(idx : Int, n : Int) -> Bool {
  idx >= 0 && idx < n
}

///| Build a `CsrGraph[E]` directly from `(node_count, edges)` in O(V + E).
pub fn CsrGraph::from_edges[E](
  node_count : Int,
  edges : Array[(Int, Int, E)],
) -> Result[CsrGraph[E], GraphError] {
  if !is_valid_node_count(node_count) {
    return Err(InvalidArgument("node_count out of supported range [0, 67108864]"))
  }
  let m = edges.length()
  let counts : FixedArray[Int] = FixedArray::make(node_count, 0)
  let mut i = 0
  while i < m {
    let (u, v, _) = edges[i]
    if !is_valid_node_idx(u, node_count) {
      return Err(InvalidNode(u))
    }
    if !is_valid_node_idx(v, node_count) {
      return Err(InvalidNode(v))
    }
    counts[u] = counts[u] + 1
    i = i + 1
  }
  let row_offsets : FixedArray[Int] = FixedArray::make(node_count + 1, 0)
  let cursor : FixedArray[Int] = FixedArray::make(node_count, 0)
  let mut sum = 0
  let mut u = 0
  while u < node_count {
    row_offsets[u] = sum
    cursor[u] = sum
    sum = sum + counts[u]
    u = u + 1
  }
  row_offsets[node_count] = sum

  let targets : FixedArray[Int] = FixedArray::make(m, 0)
  let order : FixedArray[Int] = FixedArray::make(m, 0)
  let mut j = 0
  while j < m {
    let (src, dst, _) = edges[j]
    let p = cursor[src]
    cursor[src] = p + 1
    targets[p] = dst
    order[p] = j
    j = j + 1
  }
  let weights : Array[E] = Array::with_capacity(m)
  let mut k = 0
  while k < m {
    let (_, _, w) = edges[order[k]]
    weights.push(w)
    k = k + 1
  }
  Ok(CsrGraph::{ node_count, row_offsets, targets, weights })
}

///| Number of nodes.
pub fn CsrGraph::node_count[E](self : CsrGraph[E]) -> Int {
  self.node_count
}

///| Number of edges.
pub fn CsrGraph::edge_count[E](self : CsrGraph[E]) -> Int {
  self.targets.length()
}

///| Out-degree of node `u`.
pub fn CsrGraph::out_degree[E](self : CsrGraph[E], u : NodeId) -> Int {
  if u.index < 0 || u.index >= self.node_count {
    return 0
  }
  self.row_offsets[u.index + 1] - self.row_offsets[u.index]
}

///| Outgoing neighbors of node `u`.
pub fn CsrGraph::neighbors[E](self : CsrGraph[E], u : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  if u.index < 0 || u.index >= self.node_count {
    return out
  }
  let start = self.row_offsets[u.index]
  let end = self.row_offsets[u.index + 1]
  let mut i = start
  while i < end {
    out.push(NodeId::{ index: self.targets[i] })
    i = i + 1
  }
  out
}

///| Fast Dijkstra directly on `CsrGraph[Int64]` with zero closure overhead.
pub fn csr_dijkstra(
  g : CsrGraph[Int64],
  source : NodeId,
  goal : Option[NodeId],
) -> Result[ShortestPaths, GraphError] {
  let n = g.node_count
  let src = source.index
  if src < 0 || src >= n {
    return Err(InvalidNode(src))
  }
  let goal_idx = match goal {
    Some(gid) => {
      if gid.index < 0 || gid.index >= n {
        return Err(InvalidNode(gid.index))
      }
      gid.index
    }
    None => -1
  }
  let distances : FixedArray[Int64] = FixedArray::make(n, -1L)
  let predecessors : FixedArray[Int] = FixedArray::make(n, -1)
  let heap_keys : FixedArray[Int64] = FixedArray::make(n, 0L)
  let heap_vals : FixedArray[Int] = FixedArray::make(n, 0)
  let heap_pos : FixedArray[Int] = FixedArray::make(n, -1)
  distances[src] = 0L
  heap_keys[0] = 0L
  heap_vals[0] = src
  heap_pos[src] = 0
  let mut hlen = 1

  let offsets = g.row_offsets
  let targets = g.targets
  let weights = g.weights
  let overflow_nodes : Array[Int] = Array::new()

  while hlen > 0 {
    let d = heap_keys[0]
    let u = heap_vals[0]
    heap_pos[u] = -1
    hlen = hlen - 1
    if hlen > 0 {
      let last_k = heap_keys[hlen]
      let last_v = heap_vals[hlen]
      let mut idx = 0
      while true {
        let c0 = (idx << 2) + 1
        if c0 >= hlen {
          break
        }
        let mut best = c0
        let mut best_k = heap_keys[c0]
        let c3 = c0 + 3
        if c3 < hlen {
          let k1 = heap_keys[c0 + 1]
          if k1 < best_k {
            best = c0 + 1
            best_k = k1
          }
          let k2 = heap_keys[c0 + 2]
          if k2 < best_k {
            best = c0 + 2
            best_k = k2
          }
          let k3 = heap_keys[c3]
          if k3 < best_k {
            best = c3
            best_k = k3
          }
        } else {
          let c1 = c0 + 1
          if c1 < hlen {
            let k1 = heap_keys[c1]
            if k1 < best_k {
              best = c1
              best_k = k1
            }
            let c2 = c0 + 2
            if c2 < hlen {
              let k2 = heap_keys[c2]
              if k2 < best_k {
                best = c2
                best_k = k2
              }
            }
          }
        }
        if best_k < last_k {
          let bv = heap_vals[best]
          heap_keys[idx] = best_k
          heap_vals[idx] = bv
          heap_pos[bv] = idx
          idx = best
        } else {
          break
        }
      }
      heap_keys[idx] = last_k
      heap_vals[idx] = last_v
      heap_pos[last_v] = idx
    }
    if u == goal_idx {
      break
    }
    let max_w = MAX_I64 - d
    let mut ei = offsets[u]
    let end = offsets[u + 1]
    while ei < end {
      let w = weights[ei]
      if w < 0L {
        return Err(NegativeWeight(w))
      }
      let v = targets[ei]
      if w > max_w {
        if distances[v] < 0L {
          overflow_nodes.push(v)
        }
      } else {
        let nd = d + w
        let dv = distances[v]
        if nd.to_uint64() < dv.to_uint64() {
          distances[v] = nd
          predecessors[v] = u
          let mut p_idx = heap_pos[v]
          if p_idx < 0 {
            p_idx = hlen
            hlen = hlen + 1
          }
          while p_idx > 0 {
            let parent = (p_idx - 1) >> 2
            let pk = heap_keys[parent]
            if nd < pk {
              let pv = heap_vals[parent]
              heap_keys[p_idx] = pk
              heap_vals[p_idx] = pv
              heap_pos[pv] = p_idx
              p_idx = parent
            } else {
              break
            }
          }
          heap_keys[p_idx] = nd
          heap_vals[p_idx] = v
          heap_pos[v] = p_idx
        }
      }
      ei = ei + 1
    }
  }

  if overflow_nodes.length() > 0 && (goal_idx < 0 || distances[goal_idx] < 0L) {
    let mut oi = 0
    while oi < overflow_nodes.length() {
      if distances[overflow_nodes[oi]] < 0L {
        return Err(WeightOverflow)
      }
      oi = oi + 1
    }
  }

  let reachable : FixedArray[Bool] = FixedArray::make(n, false)
  let mut i = 0
  while i < n {
    if distances[i] >= 0L {
      reachable[i] = true
    } else {
      distances[i] = MAX_I64
    }
    i = i + 1
  }
  Ok(ShortestPaths::{ source, distances, reachable, predecessors })
}

///| Fast iterative Tarjan SCC directly on `CsrGraph[E]` in reverse topological order.
pub fn csr_tarjan_scc[E](g : CsrGraph[E]) -> Array[Array[NodeId]] {
  let n = g.node_count
  let sccs : Array[Array[NodeId]] = Array::new()
  if n == 0 {
    return sccs
  }
  let offsets = g.row_offsets
  let targets = g.targets

  // disc[v]: -1 = unvisited, 0..n-1 = on t_stack, n = assigned to a completed SCC
  let disc : FixedArray[Int] = FixedArray::make(n, -1)
  let low : FixedArray[Int] = FixedArray::make(n, 0)
  let t_stack : FixedArray[Int] = FixedArray::make(n, 0)
  let mut t_top = 0

  let call_node : FixedArray[Int] = FixedArray::make(n, 0)
  let call_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let mut c_top = 0
  let mut timer = 0

  let mut start = 0
  while start < n {
    if disc[start] != -1 {
      start = start + 1
      continue
    }
    disc[start] = timer
    low[start] = timer
    timer = timer + 1
    t_stack[t_top] = start
    t_top = t_top + 1
    call_node[0] = start
    call_edge[0] = offsets[start]
    c_top = 1

    while c_top > 0 {
      let top_idx = c_top - 1
      let u = call_node[top_idx]
      let mut ei = call_edge[top_idx]
      let end = offsets[u + 1]
      let mut low_u = low[u]
      let mut descended = false
      while ei < end {
        let v = targets[ei]
        ei = ei + 1
        let dv = disc[v]
        if dv == -1 {
          call_edge[top_idx] = ei
          low[u] = low_u
          disc[v] = timer
          low[v] = timer
          timer = timer + 1
          t_stack[t_top] = v
          t_top = t_top + 1
          call_node[c_top] = v
          call_edge[c_top] = offsets[v]
          c_top = c_top + 1
          descended = true
          break
        } else if dv < low_u {
          low_u = dv
        }
      }
      if !descended {
        c_top = top_idx
        if low_u == disc[u] {
          if t_stack[t_top - 1] == u {
            t_top = t_top - 1
            disc[u] = n
            let comp : Array[NodeId] = Array::with_capacity(1)
            comp.push(NodeId::{ index: u })
            sccs.push(comp)
          } else {
            let mut k = t_top - 1
            while t_stack[k] != u {
              k = k - 1
            }
            let sz = t_top - k
            let comp : Array[NodeId] = Array::with_capacity(sz)
            let mut j = t_top - 1
            while j >= k {
              let w = t_stack[j]
              disc[w] = n
              comp.push(NodeId::{ index: w })
              j = j - 1
            }
            t_top = k
            sccs.push(comp)
          }
        }
        if c_top > 0 {
          let p = call_node[c_top - 1]
          if low_u < low[p] {
            low[p] = low_u
          }
        }
      }
    }
    start = start + 1
  }
  sccs
}

///| Internal: find a node guaranteed to lie on a directed cycle among residual nodes (`indeg > 0`) in a CSR graph.
fn csr_find_cycle_node[E](g : CsrGraph[E], indeg : FixedArray[Int]) -> NodeId {
  let n = g.node_count
  let offsets = g.row_offsets
  let targets = g.targets
  let color : FixedArray[Int] = FixedArray::make(n, 0)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let mut start = 0
  while start < n {
    if indeg[start] <= 0 || color[start] != 0 {
      start = start + 1
      continue
    }
    color[start] = 1
    s_node[0] = start
    s_edge[0] = offsets[start]
    let mut top = 1
    while top > 0 {
      let ti = top - 1
      let u = s_node[ti]
      let ei = s_edge[ti]
      let end = offsets[u + 1]
      if ei < end {
        s_edge[ti] = ei + 1
        let v = targets[ei]
        if indeg[v] <= 0 {
          continue
        }
        let cv = color[v]
        if cv == 1 {
          return NodeId::{ index: v }
        } else if cv == 0 {
          color[v] = 1
          s_node[top] = v
          s_edge[top] = offsets[v]
          top = top + 1
        }
      } else {
        color[u] = 2
        top = top - 1
      }
    }
    start = start + 1
  }
  let mut k = 0
  while k < n && indeg[k] <= 0 {
    k = k + 1
  }
  NodeId::{ index: k }
}

///| Fast Kahn topological sort directly on `CsrGraph[E]` (lexicographically smallest).
pub fn csr_toposort[E](g : CsrGraph[E]) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count
  let m = g.targets.length()
  let indeg : FixedArray[Int] = FixedArray::make(n, 0)
  let targets = g.targets
  let mut i = 0
  while i < m {
    let v = targets[i]
    indeg[v] = indeg[v] + 1
    i = i + 1
  }
  // Inlined 4-ary min-heap on FixedArray[Int]; ascending u scan is already heap-ordered.
  let heap : FixedArray[Int] = FixedArray::make(n, 0)
  let mut hlen = 0
  let mut u = 0
  while u < n {
    if indeg[u] == 0 {
      heap[hlen] = u
      hlen = hlen + 1
    }
    u = u + 1
  }
  let order : Array[NodeId] = Array::with_capacity(n)
  let offsets = g.row_offsets
  while hlen > 0 {
    let cur = heap[0]
    order.push(NodeId::{ index: cur })
    let mut has_hole = true
    let mut ei = offsets[cur]
    let end = offsets[cur + 1]
    while ei < end {
      let v = targets[ei]
      let nd = indeg[v] - 1
      indeg[v] = nd
      if nd == 0 {
        if has_hole {
          has_hole = false
          let mut idx = 0
          while true {
            let c0 = (idx << 2) + 1
            if c0 >= hlen {
              break
            }
            let mut best = c0
            let mut best_v = heap[c0]
            let c3 = c0 + 3
            if c3 < hlen {
              let v1 = heap[c0 + 1]
              if v1 < best_v {
                best = c0 + 1
                best_v = v1
              }
              let v2 = heap[c0 + 2]
              if v2 < best_v {
                best = c0 + 2
                best_v = v2
              }
              let v3 = heap[c3]
              if v3 < best_v {
                best = c3
                best_v = v3
              }
            } else {
              let c1 = c0 + 1
              if c1 < hlen {
                let v1 = heap[c1]
                if v1 < best_v {
                  best = c1
                  best_v = v1
                }
                let c2 = c0 + 2
                if c2 < hlen {
                  let v2 = heap[c2]
                  if v2 < best_v {
                    best = c2
                    best_v = v2
                  }
                }
              }
            }
            if best_v < v {
              heap[idx] = best_v
              idx = best
            } else {
              break
            }
          }
          heap[idx] = v
        } else {
          let mut p_idx = hlen
          hlen = hlen + 1
          while p_idx > 0 {
            let parent = (p_idx - 1) >> 2
            let pv = heap[parent]
            if v < pv {
              heap[p_idx] = pv
              p_idx = parent
            } else {
              break
            }
          }
          heap[p_idx] = v
        }
      }
      ei = ei + 1
    }
    if has_hole {
      hlen = hlen - 1
      if hlen > 0 {
        let last = heap[hlen]
        let mut idx = 0
        while true {
          let c0 = (idx << 2) + 1
          if c0 >= hlen {
            break
          }
          let mut best = c0
          let mut best_v = heap[c0]
          let c3 = c0 + 3
          if c3 < hlen {
            let v1 = heap[c0 + 1]
            if v1 < best_v {
              best = c0 + 1
              best_v = v1
            }
            let v2 = heap[c0 + 2]
            if v2 < best_v {
              best = c0 + 2
              best_v = v2
            }
            let v3 = heap[c3]
            if v3 < best_v {
              best = c3
              best_v = v3
            }
          } else {
            let c1 = c0 + 1
            if c1 < hlen {
              let v1 = heap[c1]
              if v1 < best_v {
                best = c1
                best_v = v1
              }
              let c2 = c0 + 2
              if c2 < hlen {
                let v2 = heap[c2]
                if v2 < best_v {
                  best = c2
                  best_v = v2
                }
              }
            }
          }
          if best_v < last {
            heap[idx] = best_v
            idx = best
          } else {
            break
          }
        }
        heap[idx] = last
      }
    }
  }
  if order.length() != n {
    return Err(HasCycle(csr_find_cycle_node(g, indeg)))
  }
  Ok(order)
}

///| O(V + E) Kahn topological sort directly on `CsrGraph[E]` returning any valid topological order.
pub fn csr_toposort_any[E](g : CsrGraph[E]) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count
  let m = g.targets.length()
  let indeg : FixedArray[Int] = FixedArray::make(n, 0)
  let targets = g.targets
  let mut i = 0
  while i < m {
    let v = targets[i]
    indeg[v] = indeg[v] + 1
    i = i + 1
  }
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let mut head = 0
  let mut tail = 0
  let mut u = 0
  while u < n {
    if indeg[u] == 0 {
      queue[tail] = u
      tail = tail + 1
    }
    u = u + 1
  }
  let order : Array[NodeId] = Array::with_capacity(n)
  let offsets = g.row_offsets
  while head < tail {
    let cur = queue[head]
    head = head + 1
    order.push(NodeId::{ index: cur })
    let mut ei = offsets[cur]
    let end = offsets[cur + 1]
    while ei < end {
      let v = targets[ei]
      let nd = indeg[v] - 1
      indeg[v] = nd
      if nd == 0 {
        queue[tail] = v
        tail = tail + 1
      }
      ei = ei + 1
    }
  }
  if order.length() != n {
    return Err(HasCycle(csr_find_cycle_node(g, indeg)))
  }
  Ok(order)
}

///| Fast Cooper-Harvey-Kennedy dominators directly on `CsrGraph[E]` (zero HashMap/HashSet).
pub fn csr_dominators[E](g : CsrGraph[E], root : NodeId) -> Result[Dominators, GraphError] {
  let n = g.node_count
  let r = root.index
  if r < 0 || r >= n {
    return Err(InvalidNode(r))
  }
  let offsets = g.row_offsets
  let targets = g.targets

  // 1. Iterative postorder DFS from root
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let post_order : FixedArray[Int] = FixedArray::make(n, 0)
  let post_idx : FixedArray[Int] = FixedArray::make(n, -1)
  let mut post_len = 0

  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let mut top = 1
  visited[r] = true
  s_node[0] = r
  s_edge[0] = offsets[r]

  while top > 0 {
    let ti = top - 1
    let u = s_node[ti]
    let mut ei = s_edge[ti]
    let end = offsets[u + 1]
    let mut descended = false
    while ei < end {
      let v = targets[ei]
      ei = ei + 1
      if !visited[v] {
        s_edge[ti] = ei
        visited[v] = true
        s_node[top] = v
        s_edge[top] = offsets[v]
        top = top + 1
        descended = true
        break
      }
    }
    if !descended {
      top = ti
      post_idx[u] = post_len
      post_order[post_len] = u
      post_len = post_len + 1
    }
  }

  // 2. Build compact CSR predecessor lists over reachable postorder indices
  let pred_counts : FixedArray[Int] = FixedArray::make(post_len, 0)
  let mut pi = 0
  while pi < post_len {
    let u = post_order[pi]
    let mut ei = offsets[u]
    let end = offsets[u + 1]
    while ei < end {
      let v_pi = post_idx[targets[ei]]
      if v_pi >= 0 {
        pred_counts[v_pi] = pred_counts[v_pi] + 1
      }
      ei = ei + 1
    }
    pi = pi + 1
  }
  let pred_offsets : FixedArray[Int] = FixedArray::make(post_len + 1, 0)
  let pred_cur : FixedArray[Int] = FixedArray::make(post_len, 0)
  let mut total_preds = 0
  let mut k = 0
  while k < post_len {
    pred_offsets[k] = total_preds
    pred_cur[k] = total_preds
    total_preds = total_preds + pred_counts[k]
    k = k + 1
  }
  pred_offsets[post_len] = total_preds
  let pred_nodes : FixedArray[Int] = FixedArray::make(total_preds, 0)
  let mut pi2 = 0
  while pi2 < post_len {
    let u = post_order[pi2]
    let mut ei = offsets[u]
    let end = offsets[u + 1]
    while ei < end {
      let v_pi = post_idx[targets[ei]]
      if v_pi >= 0 {
        let pos = pred_cur[v_pi]
        pred_cur[v_pi] = pos + 1
        pred_nodes[pos] = pi2
      }
      ei = ei + 1
    }
    pi2 = pi2 + 1
  }

  // 3. Cooper-Harvey-Kennedy iterative dataflow in reverse postorder
  let doms : FixedArray[Int] = FixedArray::make(post_len, -1)
  let root_pi = post_len - 1
  doms[root_pi] = root_pi

  let mut changed = true
  while changed {
    changed = false
    let mut idx = post_len - 2
    while idx >= 0 {
      let p_start = pred_offsets[idx]
      let p_end = pred_offsets[idx + 1]
      let mut new_idom = -1
      let mut p = p_start
      while p < p_end {
        let pred_pi = pred_nodes[p]
        if doms[pred_pi] != -1 {
          if new_idom == -1 {
            new_idom = pred_pi
          } else {
            let mut f1 = new_idom
            let mut f2 = pred_pi
            while f1 != f2 {
              while f1 < f2 {
                f1 = doms[f1]
              }
              while f2 < f1 {
                f2 = doms[f2]
              }
            }
            new_idom = f1
          }
        }
        p = p + 1
      }
      if new_idom != doms[idx] {
        doms[idx] = new_idom
        changed = true
      }
      idx = idx - 1
    }
  }

  let idom : FixedArray[Int] = FixedArray::make(n, -1)
  let mut m = 0
  while m < post_len {
    idom[post_order[m]] = post_order[doms[m]]
    m = m + 1
  }
  Ok(Dominators::{ root, node_count: n, idom })
}
