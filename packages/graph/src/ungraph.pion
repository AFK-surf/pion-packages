///| Mutable flat-index undirected adjacency-list graph `UnGraph[N, E]`.

///| Undirected graph with flat-array intrusive adjacency lists.
///| For self-loops (`edge_u[e] == edge_v[e]`), the edge is linked once into `first_edge[u]` via `next_u[e]`.
pub struct UnGraph[N, E] {
  node_weights : Array[N]
  first_edge : Array[Int]
  edge_weights : Array[E]
  edge_u : Array[Int]
  edge_v : Array[Int]
  next_u : Array[Int]
  next_v : Array[Int]
}

///| Create an empty undirected graph.
pub fn UnGraph::new[N, E]() -> UnGraph[N, E] {
  UnGraph::{
    node_weights: Array::new(),
    first_edge: Array::new(),
    edge_weights: Array::new(),
    edge_u: Array::new(),
    edge_v: Array::new(),
    next_u: Array::new(),
    next_v: Array::new(),
  }
}

///| Create an empty undirected graph with pre-allocated capacities.
pub fn UnGraph::with_capacity[N, E](nodes : Int, edges : Int) -> UnGraph[N, E] {
  let nc = if nodes > 0 { nodes } else { 0 }
  let ec = if edges > 0 { edges } else { 0 }
  UnGraph::{
    node_weights: Array::with_capacity(nc),
    first_edge: Array::with_capacity(nc),
    edge_weights: Array::with_capacity(ec),
    edge_u: Array::with_capacity(ec),
    edge_v: Array::with_capacity(ec),
    next_u: Array::with_capacity(ec),
    next_v: Array::with_capacity(ec),
  }
}

///| Return the number of nodes in the graph.
pub fn UnGraph::node_count[N, E](self : UnGraph[N, E]) -> Int {
  self.node_weights.length()
}

///| Return the number of edges in the graph.
pub fn UnGraph::edge_count[N, E](self : UnGraph[N, E]) -> Int {
  self.edge_weights.length()
}

///| Check whether `id` is a valid node.
pub fn UnGraph::has_node[N, E](self : UnGraph[N, E], id : NodeId) -> Bool {
  id.index >= 0 && id.index < self.node_weights.length()
}

///| Check whether `id` is a valid edge.
pub fn UnGraph::has_edge[N, E](self : UnGraph[N, E], id : EdgeId) -> Bool {
  id.index >= 0 && id.index < self.edge_weights.length()
}

///| Internal: next incident edge after `e` in `node`'s adjacency list.
fn UnGraph::next_incident[N, E](self : UnGraph[N, E], node : Int, e : Int) -> Int {
  if self.edge_u[e] == node {
    self.next_u[e]
  } else {
    self.next_v[e]
  }
}

///| Internal: set next incident edge after `e` in `node`'s adjacency list.
fn UnGraph::set_next_incident[N, E](self : UnGraph[N, E], node : Int, e : Int, nxt : Int) -> Unit {
  if self.edge_u[e] == node {
    self.next_u[e] = nxt
  } else {
    self.next_v[e] = nxt
  }
}

///| Internal: return the other endpoint of edge `e` relative to `node`.
fn UnGraph::other_endpoint[N, E](self : UnGraph[N, E], node : Int, e : Int) -> Int {
  let u = self.edge_u[e]
  if u == node {
    self.edge_v[e]
  } else {
    u
  }
}

///| Add a node with `weight` and return its `NodeId`.
pub fn UnGraph::add_node[N, E](self : UnGraph[N, E], weight : N) -> NodeId {
  let idx = self.node_weights.length()
  self.node_weights.push(weight)
  self.first_edge.push(-1)
  NodeId::{ index: idx }
}

///| Add an undirected edge between `u` and `v` with `weight`.
pub fn UnGraph::add_edge[N, E](
  self : UnGraph[N, E],
  u_id : NodeId,
  v_id : NodeId,
  weight : E,
) -> Result[EdgeId, GraphError] {
  let n = self.node_weights.length()
  let u = u_id.index
  let v = v_id.index
  if u < 0 || u >= n {
    return Err(InvalidNode(u))
  }
  if v < 0 || v >= n {
    return Err(InvalidNode(v))
  }
  let e = self.edge_weights.length()
  self.edge_weights.push(weight)
  self.edge_u.push(u)
  self.edge_v.push(v)
  self.next_u.push(self.first_edge[u])
  self.first_edge[u] = e
  if u == v {
    self.next_v.push(-1)
  } else {
    self.next_v.push(self.first_edge[v])
    self.first_edge[v] = e
  }
  Ok(EdgeId::{ index: e })
}

///| Get node weight.
pub fn UnGraph::node_weight[N, E](self : UnGraph[N, E], id : NodeId) -> Option[N] {
  if !self.has_node(id) {
    return None
  }
  Some(self.node_weights[id.index])
}

///| Get edge weight.
pub fn UnGraph::edge_weight[N, E](self : UnGraph[N, E], id : EdgeId) -> Option[E] {
  if !self.has_edge(id) {
    return None
  }
  Some(self.edge_weights[id.index])
}

///| Get endpoints `(u, v)` of edge `id`.
pub fn UnGraph::edge_endpoints[N, E](self : UnGraph[N, E], id : EdgeId) -> Option[(NodeId, NodeId)] {
  if !self.has_edge(id) {
    return None
  }
  Some((NodeId::{ index: self.edge_u[id.index] }, NodeId::{ index: self.edge_v[id.index] }))
}

///| Internal: unlink `target` from `node`'s adjacency list.
fn UnGraph::unlink_from[N, E](self : UnGraph[N, E], node : Int, target : Int) -> Unit {
  let mut prev = -1
  let mut cur = self.first_edge[node]
  while cur != -1 {
    let nxt = self.next_incident(node, cur)
    if cur == target {
      if prev == -1 {
        self.first_edge[node] = nxt
      } else {
        self.set_next_incident(node, prev, nxt)
      }
      return
    }
    prev = cur
    cur = nxt
  }
}

///| Internal: replace reference `old_e -> new_e` in `node`'s adjacency list.
fn UnGraph::relink_in[N, E](self : UnGraph[N, E], node : Int, old_e : Int, new_e : Int) -> Unit {
  if self.first_edge[node] == old_e {
    self.first_edge[node] = new_e
    return
  }
  let mut cur = self.first_edge[node]
  while cur != -1 {
    let nxt = self.next_incident(node, cur)
    if nxt == old_e {
      self.set_next_incident(node, cur, new_e)
      return
    }
    cur = nxt
  }
}

///| Remove edge `id` and return its weight.
pub fn UnGraph::remove_edge[N, E](self : UnGraph[N, E], id : EdgeId) -> Option[E] {
  let m = self.edge_weights.length()
  let e = id.index
  if e < 0 || e >= m {
    return None
  }
  let removed = self.edge_weights[e]
  let u = self.edge_u[e]
  let v = self.edge_v[e]
  self.unlink_from(u, e)
  if u != v {
    self.unlink_from(v, e)
  }

  let last = m - 1
  if e != last {
    let lu = self.edge_u[last]
    let lv = self.edge_v[last]
    self.edge_weights[e] = self.edge_weights[last]
    self.edge_u[e] = lu
    self.edge_v[e] = lv
    self.next_u[e] = self.next_u[last]
    self.next_v[e] = self.next_v[last]
    self.relink_in(lu, last, e)
    if lu != lv {
      self.relink_in(lv, last, e)
    }
  }

  let _ = self.edge_weights.pop()
  let _ = self.edge_u.pop()
  let _ = self.edge_v.pop()
  let _ = self.next_u.pop()
  let _ = self.next_v.pop()
  Some(removed)
}

///| Remove node `id` and all incident edges.
pub fn UnGraph::remove_node[N, E](self : UnGraph[N, E], id : NodeId) -> Option[N] {
  let n = self.node_weights.length()
  let u = id.index
  if u < 0 || u >= n {
    return None
  }
  while self.first_edge[u] != -1 {
    let _ = self.remove_edge(EdgeId::{ index: self.first_edge[u] })
  }

  let removed = self.node_weights[u]
  let last = n - 1
  if u != last {
    self.node_weights[u] = self.node_weights[last]
    self.first_edge[u] = self.first_edge[last]
    let mut e = self.first_edge[u]
    while e != -1 {
      let nxt = self.next_incident(last, e)
      if self.edge_u[e] == last {
        self.edge_u[e] = u
      }
      if self.edge_v[e] == last {
        self.edge_v[e] = u
      }
      e = nxt
    }
  }

  let _ = self.node_weights.pop()
  let _ = self.first_edge.pop()
  Some(removed)
}

///| Return all incident neighbors of `u`.
pub fn UnGraph::neighbors[N, E](self : UnGraph[N, E], u : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let ui = u.index
  let mut e = self.first_edge[ui]
  while e != -1 {
    out.push(NodeId::{ index: self.other_endpoint(ui, e) })
    e = self.next_incident(ui, e)
  }
  out
}

///| Return all incident `EdgeId`s of `u`.
pub fn UnGraph::edges[N, E](self : UnGraph[N, E], u : NodeId) -> Array[EdgeId] {
  let out : Array[EdgeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let ui = u.index
  let mut e = self.first_edge[ui]
  while e != -1 {
    out.push(EdgeId::{ index: e })
    e = self.next_incident(ui, e)
  }
  out
}

///| Return degree of `u`.
pub fn UnGraph::degree[N, E](self : UnGraph[N, E], u : NodeId) -> Int {
  if !self.has_node(u) {
    return 0
  }
  let ui = u.index
  let mut deg = 0
  let mut e = self.first_edge[ui]
  while e != -1 {
    deg = deg + 1
    e = self.next_incident(ui, e)
  }
  deg
}

///| Find an undirected edge between `u` and `v`.
pub fn UnGraph::find_edge[N, E](self : UnGraph[N, E], u : NodeId, v : NodeId) -> Option[EdgeId] {
  if !self.has_node(u) || !self.has_node(v) {
    return None
  }
  let ui = u.index
  let vi = v.index
  let mut e = self.first_edge[ui]
  while e != -1 {
    if self.other_endpoint(ui, e) == vi {
      return Some(EdgeId::{ index: e })
    }
    e = self.next_incident(ui, e)
  }
  None
}

///| Check whether an undirected edge between `u` and `v` exists.
pub fn UnGraph::contains_edge[N, E](self : UnGraph[N, E], u : NodeId, v : NodeId) -> Bool {
  match self.find_edge(u, v) {
    Some(_) => true
    None => false
  }
}
