///| Internal zero-boxing binary min-heaps for Dijkstra, A*, Prim, and Kahn toposort.

///| Binary min-heap keyed by `Int64` with `Int` payload (parallel arrays, zero tuple boxing).
struct MinHeapI64 {
  keys : Array[Int64]
  vals : Array[Int]
}

///|
fn MinHeapI64::with_capacity(cap : Int) -> MinHeapI64 {
  let c = if cap > 0 { cap } else { 0 }
  MinHeapI64::{ keys: Array::with_capacity(c), vals: Array::with_capacity(c) }
}

///|
fn MinHeapI64::is_empty(self : MinHeapI64) -> Bool {
  self.keys.length() == 0
}

///|
fn MinHeapI64::push(self : MinHeapI64, key : Int64, payload : Int) -> Unit {
  let mut idx = self.keys.length()
  self.keys.push(key)
  self.vals.push(payload)
  while idx > 0 {
    let parent = (idx - 1) >> 1
    let pk = self.keys[parent]
    let pv = self.vals[parent]
    if key < pk || (key == pk && payload < pv) {
      self.keys[idx] = pk
      self.vals[idx] = pv
      idx = parent
    } else {
      break
    }
  }
  self.keys[idx] = key
  self.vals[idx] = payload
}

///| Pop minimum `(key, val)`. Caller must ensure `!self.is_empty()`.
fn MinHeapI64::pop_min(self : MinHeapI64) -> (Int64, Int) {
  let top_k = self.keys[0]
  let top_v = self.vals[0]
  let last_k = match self.keys.pop() {
    Some(k) => k
    None => top_k
  }
  let last_v = match self.vals.pop() {
    Some(v) => v
    None => top_v
  }
  let n = self.keys.length()
  if n > 0 {
    let mut idx = 0
    while true {
      let left = (idx << 1) + 1
      if left >= n {
        break
      }
      let right = left + 1
      let mut best = left
      let mut best_k = self.keys[left]
      let mut best_v = self.vals[left]
      if right < n {
        let rk = self.keys[right]
        let rv = self.vals[right]
        if rk < best_k || (rk == best_k && rv < best_v) {
          best = right
          best_k = rk
          best_v = rv
        }
      }
      if best_k < last_k || (best_k == last_k && best_v < last_v) {
        self.keys[idx] = best_k
        self.vals[idx] = best_v
        idx = best
      } else {
        break
      }
    }
    self.keys[idx] = last_k
    self.vals[idx] = last_v
  }
  (top_k, top_v)
}

///| Binary min-heap of `Int` values (used for lexicographically smallest Kahn toposort).
struct MinHeapInt {
  data : Array[Int]
}

///|
fn MinHeapInt::with_capacity(cap : Int) -> MinHeapInt {
  let c = if cap > 0 { cap } else { 0 }
  MinHeapInt::{ data: Array::with_capacity(c) }
}

///|
fn MinHeapInt::is_empty(self : MinHeapInt) -> Bool {
  self.data.length() == 0
}

///|
fn MinHeapInt::push(self : MinHeapInt, x : Int) -> Unit {
  let mut idx = self.data.length()
  self.data.push(x)
  while idx > 0 {
    let parent = (idx - 1) >> 1
    let pv = self.data[parent]
    if x < pv {
      self.data[idx] = pv
      idx = parent
    } else {
      break
    }
  }
  self.data[idx] = x
}

///|
fn MinHeapInt::pop_min(self : MinHeapInt) -> Int {
  let top = self.data[0]
  let last = match self.data.pop() {
    Some(v) => v
    None => top
  }
  let n = self.data.length()
  if n > 0 {
    let mut idx = 0
    while true {
      let left = (idx << 1) + 1
      if left >= n {
        break
      }
      let right = left + 1
      let mut best = left
      let mut best_v = self.data[left]
      if right < n {
        let rv = self.data[right]
        if rv < best_v {
          best = right
          best_v = rv
        }
      }
      if best_v < last {
        self.data[idx] = best_v
        idx = best
      } else {
        break
      }
    }
    self.data[idx] = last
  }
  top
}
