///| Internal zero-boxing binary min-heaps for Dijkstra, A*, Prim, and Kahn toposort.

///| Parent index `(idx - 1) >> 1` of a 0-indexed binary heap node (`idx > 0`).
#verify
pub fn heap_parent(idx : Int) -> Int {
  (idx - 1) >> 1
}

///| Left child index `(idx << 1) + 1` of a 0-indexed binary heap node.
#verify
pub fn heap_left_child(idx : Int) -> Int {
  (idx << 1) + 1
}

///| 4-ary min-heap keyed by `Int64` with `Int` payload (parallel arrays, zero tuple/Option boxing).
struct MinHeapI64 {
  keys : Array[Int64]
  vals : Array[Int]
  mut len : Int
  mut popped_key : Int64
  mut popped_val : Int
}

///|
fn MinHeapI64::with_capacity(cap : Int) -> MinHeapI64 {
  let c = if cap > 0 { cap } else { 0 }
  MinHeapI64::{
    keys: Array::with_capacity(c),
    vals: Array::with_capacity(c),
    len: 0,
    popped_key: 0L,
    popped_val: 0,
  }
}

///|
fn MinHeapI64::is_empty(self : MinHeapI64) -> Bool {
  self.len == 0
}

///|
fn MinHeapI64::push(self : MinHeapI64, key : Int64, payload : Int) -> Unit {
  let keys = self.keys
  let vals = self.vals
  let mut idx = self.len
  if idx < keys.length() {
    keys[idx] = key
    vals[idx] = payload
  } else {
    keys.push(key)
    vals.push(payload)
  }
  self.len = idx + 1
  while idx > 0 {
    let parent = (idx - 1) >> 2
    let pk = keys[parent]
    if key < pk {
      keys[idx] = pk
      vals[idx] = vals[parent]
      idx = parent
    } else {
      break
    }
  }
  keys[idx] = key
  vals[idx] = payload
}

///| Pop minimum into `self.popped_key` and `self.popped_val` (zero allocation).
///| Caller must ensure `!self.is_empty()`.
fn MinHeapI64::pop_min_raw(self : MinHeapI64) -> Unit {
  let keys = self.keys
  let vals = self.vals
  self.popped_key = keys[0]
  self.popped_val = vals[0]
  let n = self.len - 1
  self.len = n
  if n > 0 {
    let last_k = keys[n]
    let last_v = vals[n]
    let mut idx = 0
    while true {
      let c0 = (idx << 2) + 1
      if c0 >= n {
        break
      }
      let mut best = c0
      let mut best_k = keys[c0]
      let c3 = c0 + 3
      if c3 < n {
        let k1 = keys[c0 + 1]
        if k1 < best_k {
          best = c0 + 1
          best_k = k1
        }
        let k2 = keys[c0 + 2]
        if k2 < best_k {
          best = c0 + 2
          best_k = k2
        }
        let k3 = keys[c3]
        if k3 < best_k {
          best = c3
          best_k = k3
        }
      } else {
        let c1 = c0 + 1
        if c1 < n {
          let k1 = keys[c1]
          if k1 < best_k {
            best = c1
            best_k = k1
          }
          let c2 = c0 + 2
          if c2 < n {
            let k2 = keys[c2]
            if k2 < best_k {
              best = c2
              best_k = k2
            }
          }
        }
      }
      if best_k < last_k {
        keys[idx] = best_k
        vals[idx] = vals[best]
        idx = best
      } else {
        break
      }
    }
    keys[idx] = last_k
    vals[idx] = last_v
  }
}

///| 4-ary min-heap of `Int` values (used for lexicographically smallest Kahn toposort, zero Option boxing).
struct MinHeapInt {
  data : Array[Int]
  mut len : Int
}

///|
fn MinHeapInt::with_capacity(cap : Int) -> MinHeapInt {
  let c = if cap > 0 { cap } else { 0 }
  MinHeapInt::{ data: Array::with_capacity(c), len: 0 }
}

///|
fn MinHeapInt::is_empty(self : MinHeapInt) -> Bool {
  self.len == 0
}

///|
fn MinHeapInt::push(self : MinHeapInt, x : Int) -> Unit {
  let data = self.data
  let mut idx = self.len
  if idx < data.length() {
    data[idx] = x
  } else {
    data.push(x)
  }
  self.len = idx + 1
  while idx > 0 {
    let parent = (idx - 1) >> 2
    let pv = data[parent]
    if x < pv {
      data[idx] = pv
      idx = parent
    } else {
      break
    }
  }
  data[idx] = x
}

///|
fn MinHeapInt::pop_min(self : MinHeapInt) -> Int {
  let data = self.data
  let top = data[0]
  let n = self.len - 1
  self.len = n
  if n > 0 {
    let last = data[n]
    let mut idx = 0
    while true {
      let c0 = (idx << 2) + 1
      if c0 >= n {
        break
      }
      let mut best = c0
      let mut best_v = data[c0]
      let c3 = c0 + 3
      if c3 < n {
        let v1 = data[c0 + 1]
        if v1 < best_v {
          best = c0 + 1
          best_v = v1
        }
        let v2 = data[c0 + 2]
        if v2 < best_v {
          best = c0 + 2
          best_v = v2
        }
        let v3 = data[c3]
        if v3 < best_v {
          best = c3
          best_v = v3
        }
      } else {
        let c1 = c0 + 1
        if c1 < n {
          let v1 = data[c1]
          if v1 < best_v {
            best = c1
            best_v = v1
          }
          let c2 = c0 + 2
          if c2 < n {
            let v2 = data[c2]
            if v2 < best_v {
              best = c2
              best_v = v2
            }
          }
        }
      }
      if best_v < last {
        data[idx] = best_v
        idx = best
      } else {
        break
      }
    }
    data[idx] = last
  }
  top
}
