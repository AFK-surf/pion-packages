///| Minimum Spanning Tree / Forest algorithms: Kruskal (Union-Find) and Prim.
///| Zero recursion (uses iterative bottom-up merge sort and binary min-heap).

///| Internal: iterative bottom-up merge sort of edge indices `0 ..< m` by `weights[idx]`.
fn sort_edge_indices_by_weight(weights : FixedArray[Int64], m : Int) -> FixedArray[Int] {
  let src : FixedArray[Int] = FixedArray::make(m, 0)
  let tmp : FixedArray[Int] = FixedArray::make(m, 0)
  let mut i = 0
  while i < m {
    src[i] = i
    i = i + 1
  }
  let mut width = 1
  let mut from_src = true
  while width < m {
    let mut left = 0
    while left < m {
      let mid = if left + width < m { left + width } else { m }
      let right = if left + width + width < m { left + width + width } else { m }
      let mut p = left
      let mut q = mid
      let mut out = left
      if from_src {
        while p < mid && q < right {
          let ip = src[p]
          let iq = src[q]
          if weights[ip] <= weights[iq] {
            tmp[out] = ip
            p = p + 1
          } else {
            tmp[out] = iq
            q = q + 1
          }
          out = out + 1
        }
        while p < mid {
          tmp[out] = src[p]
          p = p + 1
          out = out + 1
        }
        while q < right {
          tmp[out] = src[q]
          q = q + 1
          out = out + 1
        }
      } else {
        while p < mid && q < right {
          let ip = tmp[p]
          let iq = tmp[q]
          if weights[ip] <= weights[iq] {
            src[out] = ip
            p = p + 1
          } else {
            src[out] = iq
            q = q + 1
          }
          out = out + 1
        }
        while p < mid {
          src[out] = tmp[p]
          p = p + 1
          out = out + 1
        }
        while q < right {
          src[out] = tmp[q]
          q = q + 1
          out = out + 1
        }
      }
      left = right
    }
    from_src = !from_src
    width = width << 1
  }
  if from_src {
    src
  } else {
    tmp
  }
}

///| Internal shared Kruskal runner given pre-extracted edge weights.
fn kruskal_core[N, E](
  g : UnGraph[N, E],
  weights : FixedArray[Int64],
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  let order = sort_edge_indices_by_weight(weights, m)
  let uf = UnionFind::new(n)
  let edge_u = g.edge_u
  let edge_v = g.edge_v
  let mut total : Int64 = 0L
  let mut i = 0
  while i < m && chosen.length() < n - 1 {
    let e = order[i]
    let u = edge_u[e]
    let v = edge_v[e]
    if u != v && uf.union_raw(u, v) {
      let next_total = match checked_add_i64(total, weights[e]) {
        Some(x) => x
        None => return Err(WeightOverflow)
      }
      total = next_total
      chosen.push(EdgeId::{ index: e })
    }
    i = i + 1
  }
  Ok(MstResult::{ edges: chosen, total_weight: total })
}

///| Kruskal's MST/MSF algorithm using `UnionFind`.
pub fn kruskal_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut i = 0
  while i < m {
    weights[i] = edge_cost(g.edge_weights[i])
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Specialized zero-closure Kruskal MST for `UnGraph[N, Int64]`.
pub fn kruskal_mst_i64[N](g : UnGraph[N, Int64]) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut i = 0
  while i < m {
    weights[i] = ew[i]
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Prim's MST/MSF algorithm using a binary min-heap (handles disconnected components).
pub fn prim_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  let in_mst : FixedArray[Bool] = FixedArray::make(n, false)
  let heap = MinHeapI64::with_capacity(m)
  let mut total : Int64 = 0L

  let mut start = 0
  while start < n {
    if in_mst[start] {
      start = start + 1
      continue
    }
    in_mst[start] = true
    let mut e0 = g.first_edge[start]
    while e0 != -1 {
      let nb = g.other_endpoint(start, e0)
      if !in_mst[nb] {
        heap.push(edge_cost(g.edge_weights[e0]), e0)
      }
      e0 = g.next_incident(start, e0)
    }

    while !heap.is_empty() {
      let (w, eid) = heap.pop_min()
      let u = g.edge_u[eid]
      let v = g.edge_v[eid]
      let next_node = if !in_mst[u] {
        u
      } else if !in_mst[v] {
        v
      } else {
        -1
      }
      if next_node == -1 {
        continue
      }
      let next_total = match checked_add_i64(total, w) {
        Some(x) => x
        None => return Err(WeightOverflow)
      }
      total = next_total
      in_mst[next_node] = true
      chosen.push(EdgeId::{ index: eid })

      let mut e = g.first_edge[next_node]
      while e != -1 {
        let nb = g.other_endpoint(next_node, e)
        if !in_mst[nb] {
          heap.push(edge_cost(g.edge_weights[e]), e)
        }
        e = g.next_incident(next_node, e)
      }
    }
    start = start + 1
  }

  Ok(MstResult::{ edges: chosen, total_weight: total })
}
