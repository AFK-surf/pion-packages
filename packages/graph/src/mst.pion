///| Minimum Spanning Tree / Forest algorithms: Kruskal (Union-Find + adaptive LSD Radix Sort) and Prim.
///| Zero recursion.

///| Internal shared Kruskal runner given pre-extracted edge weights.
///| Uses insertion sort for tiny graphs (`m <= 64`) and adaptive 11-bit LSD Radix Sort
///| (skipping zero-variance digits) + inlined Union-Find path halving for larger graphs.
fn kruskal_core[N, E](
  g : UnGraph[N, E],
  weights : FixedArray[Int64],
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  let target_edges = n - 1
  if target_edges == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }

  let edge_u = g.edge_u
  let edge_v = g.edge_v

  // Build ordered edge indices sorted by ascending Int64 weight
  let order : FixedArray[Int] = FixedArray::make(m, 0)
  if m <= 64 {
    let mut i = 0
    while i < m {
      order[i] = i
      i = i + 1
    }
    let mut a = 1
    while a < m {
      let idx = order[a]
      let key = weights[idx]
      let mut j = a - 1
      while j >= 0 && weights[order[j]] > key {
        order[j + 1] = order[j]
        j = j - 1
      }
      order[j + 1] = idx
      a = a + 1
    }
  } else {
    // Convert signed Int64 to order-preserving UInt64 keys (`w ^ 0x8000000000000000UL`)
    // and compute XOR-diff mask so we only run radix passes on digits that actually vary!
    let sign_bit : UInt64 = 9223372036854775808UL
    let keys_a : FixedArray[UInt64] = FixedArray::make(m, 0UL)
    let first_k = weights[0].to_uint64() ^ sign_bit
    let mut diff_mask : UInt64 = 0UL
    let mut i = 0
    while i < m {
      let k = weights[i].to_uint64() ^ sign_bit
      keys_a[i] = k
      order[i] = i
      diff_mask = diff_mask | (k ^ first_k)
      i = i + 1
    }

    if diff_mask != 0UL {
      let keys_b : FixedArray[UInt64] = FixedArray::make(m, 0UL)
      let ord_b : FixedArray[Int] = FixedArray::make(m, 0)
      let counts : FixedArray[Int] = FixedArray::make(2048, 0)
      let mask : UInt64 = 2047UL

      let mut src_k = keys_a
      let mut dst_k = keys_b
      let mut src_o = order
      let mut dst_o = ord_b
      let mut shift = 0
      let mut swapped = false

      while shift < 64 {
        if ((diff_mask >> shift) & mask) != 0UL {
          let mut b = 0
          while b < 2048 {
            counts[b] = 0
            b = b + 1
          }
          let mut j = 0
          while j < m {
            let bucket = ((src_k[j] >> shift) & mask).to_int()
            counts[bucket] = counts[bucket] + 1
            j = j + 1
          }
          let mut sum = 0
          let mut b2 = 0
          while b2 < 2048 {
            let c = counts[b2]
            counts[b2] = sum
            sum = sum + c
            b2 = b2 + 1
          }
          let mut j2 = 0
          while j2 < m {
            let k = src_k[j2]
            let bucket = ((k >> shift) & mask).to_int()
            let pos = counts[bucket]
            counts[bucket] = pos + 1
            dst_k[pos] = k
            dst_o[pos] = src_o[j2]
            j2 = j2 + 1
          }
          let tmp_k = src_k
          src_k = dst_k
          dst_k = tmp_k
          let tmp_o = src_o
          src_o = dst_o
          dst_o = tmp_o
          swapped = !swapped
        }
        shift = shift + 11
      }
      if swapped {
        let mut c = 0
        while c < m {
          order[c] = src_o[c]
          c = c + 1
        }
      }
    }
  }

  // Inline Union-Find with path halving + union by rank for zero call overhead
  let parent : FixedArray[Int] = FixedArray::make(n, 0)
  let rank : FixedArray[Int] = FixedArray::make(n, 0)
  let mut p = 0
  while p < n {
    parent[p] = p
    p = p + 1
  }

  let mut total : Int64 = 0L
  let mut k = 0
  while k < m && chosen.length() < target_edges {
    let e = order[k]
    let u = edge_u[e]
    let v = edge_v[e]
    if u != v {
      let mut ru = u
      while parent[ru] != ru {
        let gp = parent[parent[ru]]
        parent[ru] = gp
        ru = gp
      }
      let mut rv = v
      while parent[rv] != rv {
        let gp = parent[parent[rv]]
        parent[rv] = gp
        rv = gp
      }
      if ru != rv {
        let rku = rank[ru]
        let rkv = rank[rv]
        if rku < rkv {
          parent[ru] = rv
        } else if rku > rkv {
          parent[rv] = ru
        } else {
          parent[rv] = ru
          rank[ru] = rku + 1
        }
        let w = weights[e]
        if (w > 0L && total > MAX_I64 - w) || (w < 0L && total < MIN_I64 - w) {
          return Err(WeightOverflow)
        }
        total = total + w
        chosen.push(EdgeId::{ index: e })
      }
    }
    k = k + 1
  }
  Ok(MstResult::{ edges: chosen, total_weight: total })
}

///| Kruskal's MST/MSF algorithm using `UnionFind`.
pub fn kruskal_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut i = 0
  while i < m {
    weights[i] = edge_cost(ew[i])
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Specialized zero-closure Kruskal MST for `UnGraph[N, Int64]`.
pub fn kruskal_mst_i64[N](g : UnGraph[N, Int64]) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut i = 0
  while i < m {
    weights[i] = ew[i]
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Prim's MST/MSF algorithm using a binary min-heap (handles disconnected components).
pub fn prim_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  let in_mst : FixedArray[Bool] = FixedArray::make(n, false)
  let heap = MinHeapI64::with_capacity(m)
  let mut total : Int64 = 0L

  let first_edge = g.first_edge
  let edge_u = g.edge_u
  let edge_v = g.edge_v
  let next_u = g.next_u
  let next_v = g.next_v
  let edge_weights = g.edge_weights

  let mut start = 0
  while start < n {
    if in_mst[start] {
      start = start + 1
      continue
    }
    in_mst[start] = true
    let mut e0 = first_edge[start]
    while e0 != -1 {
      let eu = edge_u[e0]
      let nb = if eu == start { edge_v[e0] } else { eu }
      if !in_mst[nb] {
        heap.push(edge_cost(edge_weights[e0]), e0)
      }
      e0 = if eu == start { next_u[e0] } else { next_v[e0] }
    }

    while !heap.is_empty() {
      heap.pop_min_raw()
      let w = heap.popped_key
      let eid = heap.popped_val
      let u = edge_u[eid]
      let v = edge_v[eid]
      let next_node = if !in_mst[u] {
        u
      } else if !in_mst[v] {
        v
      } else {
        -1
      }
      if next_node == -1 {
        continue
      }
      if (w > 0L && total > MAX_I64 - w) || (w < 0L && total < MIN_I64 - w) {
        return Err(WeightOverflow)
      }
      total = total + w
      in_mst[next_node] = true
      chosen.push(EdgeId::{ index: eid })

      let mut e = first_edge[next_node]
      while e != -1 {
        let eu = edge_u[e]
        let nb = if eu == next_node { edge_v[e] } else { eu }
        if !in_mst[nb] {
          heap.push(edge_cost(edge_weights[e]), e)
        }
        e = if eu == next_node { next_u[e] } else { next_v[e] }
      }
    }
    start = start + 1
  }

  Ok(MstResult::{ edges: chosen, total_weight: total })
}
