///| Minimum Spanning Tree / Forest algorithms: Kruskal (Union-Find) and Prim.
///| Zero recursion (uses iterative bottom-up merge sort and binary min-heap).

///| Internal shared Kruskal runner given pre-extracted edge weights.
///| Uses O(M) Floyd bottom-up binary min-heapify + early exit once `n - 1` tree edges are chosen.
fn kruskal_core[N, E](
  g : UnGraph[N, E],
  weights : FixedArray[Int64],
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  // Build parallel min-heap arrays (h_keys = weight, h_vals = edge_id)
  let h_keys : FixedArray[Int64] = FixedArray::make(m, 0L)
  let h_vals : FixedArray[Int] = FixedArray::make(m, 0)
  let mut i = 0
  while i < m {
    h_keys[i] = weights[i]
    h_vals[i] = i
    i = i + 1
  }
  // Floyd's O(M) bottom-up heapify
  let mut start = (m >> 1) - 1
  while start >= 0 {
    let mut idx = start
    let k = h_keys[idx]
    let v = h_vals[idx]
    while true {
      let left = (idx << 1) + 1
      if left >= m {
        break
      }
      let right = left + 1
      let mut best = left
      let mut best_k = h_keys[left]
      if right < m && h_keys[right] < best_k {
        best = right
        best_k = h_keys[right]
      }
      if best_k < k {
        h_keys[idx] = best_k
        h_vals[idx] = h_vals[best]
        idx = best
      } else {
        break
      }
    }
    h_keys[idx] = k
    h_vals[idx] = v
    start = start - 1
  }

  let uf = UnionFind::new(n)
  let edge_u = g.edge_u
  let edge_v = g.edge_v
  let mut heap_len = m
  let mut total : Int64 = 0L
  let target_edges = n - 1

  while heap_len > 0 && chosen.length() < target_edges {
    let w = h_keys[0]
    let e = h_vals[0]
    heap_len = heap_len - 1
    if heap_len > 0 {
      let last_k = h_keys[heap_len]
      let last_v = h_vals[heap_len]
      let mut idx = 0
      while true {
        let left = (idx << 1) + 1
        if left >= heap_len {
          break
        }
        let right = left + 1
        let mut best = left
        let mut best_k = h_keys[left]
        if right < heap_len && h_keys[right] < best_k {
          best = right
          best_k = h_keys[right]
        }
        if best_k < last_k {
          h_keys[idx] = best_k
          h_vals[idx] = h_vals[best]
          idx = best
        } else {
          break
        }
      }
      h_keys[idx] = last_k
      h_vals[idx] = last_v
    }

    let u = edge_u[e]
    let v = edge_v[e]
    if u != v && uf.union_raw(u, v) {
      let next_total = match checked_add_i64(total, w) {
        Some(x) => x
        None => return Err(WeightOverflow)
      }
      total = next_total
      chosen.push(EdgeId::{ index: e })
    }
  }
  Ok(MstResult::{ edges: chosen, total_weight: total })
}

///| Kruskal's MST/MSF algorithm using `UnionFind`.
pub fn kruskal_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let mut i = 0
  while i < m {
    weights[i] = edge_cost(g.edge_weights[i])
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Specialized zero-closure Kruskal MST for `UnGraph[N, Int64]`.
pub fn kruskal_mst_i64[N](g : UnGraph[N, Int64]) -> Result[MstResult, GraphError] {
  let m = g.edge_count()
  let weights : FixedArray[Int64] = FixedArray::make(m, 0L)
  let ew = g.edge_weights
  let mut i = 0
  while i < m {
    weights[i] = ew[i]
    i = i + 1
  }
  kruskal_core(g, weights)
}

///| Prim's MST/MSF algorithm using a binary min-heap (handles disconnected components).
pub fn prim_mst[N, E](
  g : UnGraph[N, E],
  edge_cost : (E) -> Int64,
) -> Result[MstResult, GraphError] {
  let n = g.node_count()
  let m = g.edge_count()
  let chosen : Array[EdgeId] = Array::new()
  if n == 0 || m == 0 {
    return Ok(MstResult::{ edges: chosen, total_weight: 0L })
  }
  let in_mst : FixedArray[Bool] = FixedArray::make(n, false)
  let heap = MinHeapI64::with_capacity(m)
  let mut total : Int64 = 0L

  let mut start = 0
  while start < n {
    if in_mst[start] {
      start = start + 1
      continue
    }
    in_mst[start] = true
    let mut e0 = g.first_edge[start]
    while e0 != -1 {
      let nb = g.other_endpoint(start, e0)
      if !in_mst[nb] {
        heap.push(edge_cost(g.edge_weights[e0]), e0)
      }
      e0 = g.next_incident(start, e0)
    }

    while !heap.is_empty() {
      let (w, eid) = heap.pop_min()
      let u = g.edge_u[eid]
      let v = g.edge_v[eid]
      let next_node = if !in_mst[u] {
        u
      } else if !in_mst[v] {
        v
      } else {
        -1
      }
      if next_node == -1 {
        continue
      }
      let next_total = match checked_add_i64(total, w) {
        Some(x) => x
        None => return Err(WeightOverflow)
      }
      total = next_total
      in_mst[next_node] = true
      chosen.push(EdgeId::{ index: eid })

      let mut e = g.first_edge[next_node]
      while e != -1 {
        let nb = g.other_endpoint(next_node, e)
        if !in_mst[nb] {
          heap.push(edge_cost(g.edge_weights[e]), e)
        }
        e = g.next_incident(next_node, e)
      }
    }
    start = start + 1
  }

  Ok(MstResult::{ edges: chosen, total_weight: total })
}
