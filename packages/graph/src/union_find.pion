///| Disjoint-set (Union-Find) data structure with path halving and union by rank.

///| Disjoint-set forest over elements `0 ..< n`.
pub struct UnionFind {
  parent : FixedArray[Int]
  rank : FixedArray[Int]
  mut components : Int
}

///| Create a `UnionFind` with `n` singleton sets.
pub fn UnionFind::new(n : Int) -> UnionFind {
  let sz = if n > 0 { n } else { 0 }
  let parent : FixedArray[Int] = FixedArray::make(sz, 0)
  let rank : FixedArray[Int] = FixedArray::make(sz, 0)
  let mut i = 0
  while i < sz {
    parent[i] = i
    i = i + 1
  }
  UnionFind::{ parent, rank, components: sz }
}

///| Number of elements in the disjoint-set structure.
pub fn UnionFind::len(self : UnionFind) -> Int {
  self.parent.length()
}

///| Current number of disjoint components.
pub fn UnionFind::component_count(self : UnionFind) -> Int {
  self.components
}

///| Fast unchecked find with iterative path halving.
fn UnionFind::find_raw(self : UnionFind, x_in : Int) -> Int {
  let parent = self.parent
  let mut x = x_in
  while parent[x] != x {
    let p = parent[x]
    let gp = parent[p]
    parent[x] = gp
    x = gp
  }
  x
}

///| Fast unchecked union by rank. Returns `true` if `x` and `y` were in different sets.
fn UnionFind::union_raw(self : UnionFind, x : Int, y : Int) -> Bool {
  let rx = self.find_raw(x)
  let ry = self.find_raw(y)
  if rx == ry {
    return false
  }
  let rank_x = self.rank[rx]
  let rank_y = self.rank[ry]
  if rank_x < rank_y {
    self.parent[rx] = ry
  } else if rank_x > rank_y {
    self.parent[ry] = rx
  } else {
    self.parent[ry] = rx
    self.rank[rx] = rank_x + 1
  }
  self.components = self.components - 1
  true
}

///| Find the representative root of element `x` with path compression.
pub fn UnionFind::find(self : UnionFind, x : Int) -> Option[Int] {
  if x < 0 || x >= self.parent.length() {
    return None
  }
  Some(self.find_raw(x))
}

///| Unite the sets containing `x` and `y`. Returns `Ok(true)` if they were disjoint.
pub fn UnionFind::union(self : UnionFind, x : Int, y : Int) -> Result[Bool, GraphError] {
  let n = self.parent.length()
  if x < 0 || x >= n {
    return Err(InvalidNode(x))
  }
  if y < 0 || y >= n {
    return Err(InvalidNode(y))
  }
  Ok(self.union_raw(x, y))
}

///| Check whether `x` and `y` belong to the same set.
pub fn UnionFind::equiv(self : UnionFind, x : Int, y : Int) -> Result[Bool, GraphError] {
  let n = self.parent.length()
  if x < 0 || x >= n {
    return Err(InvalidNode(x))
  }
  if y < 0 || y >= n {
    return Err(InvalidNode(y))
  }
  Ok(self.find_raw(x) == self.find_raw(y))
}
