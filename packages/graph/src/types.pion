///| Core value types, handles, result structs, and errors for `graph`.

///| Maximum signed 64-bit integer, used for overflow bounds and sentinel distances.
pub let MAX_I64 : Int64 = 9223372036854775807L

///| Minimum signed 64-bit integer.
pub let MIN_I64 : Int64 = -9223372036854775807L - 1L

///| Lightweight `Send`-safe node handle.
pub val struct NodeId {
  index : Int
}

///| Construct a `NodeId` from a raw index.
#verify
pub fn NodeId::new(index : Int) -> NodeId {
  NodeId::{ index }
}

///| Return the raw integer index of this `NodeId`.
#verify
pub fn NodeId::to_int(self : NodeId) -> Int {
  self.index
}

///| Equality check for `NodeId`.
#verify
pub fn NodeId::eq(self : NodeId, other : NodeId) -> Bool {
  self.index == other.index
}

///| Lightweight `Send`-safe edge handle.
pub val struct EdgeId {
  index : Int
}

///| Construct an `EdgeId` from a raw index.
#verify
pub fn EdgeId::new(index : Int) -> EdgeId {
  EdgeId::{ index }
}

///| Return the raw integer index of this `EdgeId`.
#verify
pub fn EdgeId::to_int(self : EdgeId) -> Int {
  self.index
}

///| Equality check for `EdgeId`.
#verify
pub fn EdgeId::eq(self : EdgeId, other : EdgeId) -> Bool {
  self.index == other.index
}

///| Error returned by fallible graph operations and algorithms.
pub enum GraphError {
  InvalidNode(Int)
  InvalidEdge(Int)
  NegativeWeight(Int64)
  NegativeCycle
  HasCycle(NodeId)
  WeightOverflow
  NegativeCapacity(Int64)
  InvalidArgument(String)
}

///| Human-readable description of a `GraphError`.
pub fn graph_error_to_string(err : GraphError) -> String {
  match err {
    InvalidNode(idx) => "invalid node id: " + idx.to_string()
    InvalidEdge(idx) => "invalid edge id: " + idx.to_string()
    NegativeWeight(w) => "negative edge weight: " + w.to_string()
    NegativeCycle => "graph contains a negative-weight cycle"
    HasCycle(n) => "graph contains a cycle involving node " + n.index.to_string()
    WeightOverflow => "Int64 weight addition overflow"
    NegativeCapacity(c) => "negative edge capacity: " + c.to_string()
    InvalidArgument(msg) => "invalid argument: " + msg
  }
}

///| Checked `Int64` addition returning `None` on signed 64-bit overflow or underflow.
#verify
pub fn checked_add_i64(a : Int64, b : Int64) -> Option[Int64] {
  if b > 0L && a > 9223372036854775807L - b {
    return None
  }
  if b < 0L && a < (-9223372036854775807L - 1L) - b {
    return None
  }
  Some(a + b)
}

///| Full-forest DFS traversal result with discovery and finish timestamps.
pub struct DfsTimes {
  preorder : Array[NodeId]
  postorder : Array[NodeId]
  discovery : FixedArray[Int]
  finish : FixedArray[Int]
}

///| Result of a bipartiteness check and 2-coloring (`colors[v]` is `0` or `1` when bipartite).
pub struct BipartiteResult {
  is_bipartite : Bool
  colors : FixedArray[Int]
}

///| Dominator tree rooted at `root`.
///| `idom[v]` is `-1` for unreachable nodes, `root.index` for `root`, and the immediate dominator index otherwise.
pub struct Dominators {
  root : NodeId
  node_count : Int
  idom : FixedArray[Int]
}

///| Single-source shortest paths result.
pub struct ShortestPaths {
  source : NodeId
  distances : FixedArray[Int64]
  reachable : FixedArray[Bool]
  predecessors : FixedArray[Int]
}

///| A* shortest path result.
pub struct AStarResult {
  cost : Int64
  path : Array[NodeId]
}

///| All-pairs shortest paths result (row-major `node_count * node_count`).
pub struct AllPairsShortestPaths {
  node_count : Int
  distances : FixedArray[Int64]
  reachable : FixedArray[Bool]
}

///| Minimum spanning tree / forest result.
pub struct MstResult {
  edges : Array[EdgeId]
  total_weight : Int64
}

///| Dinic maximum flow and minimum S-T cut result.
pub struct MaxFlowResult {
  max_flow : Int64
  edge_flows : FixedArray[Int64]
  source_side : FixedArray[Bool]
}
