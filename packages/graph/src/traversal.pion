///| Iterative BFS and DFS graph traversals (zero recursion).

///| Iterative breadth-first search starting from `start` on a directed graph.
pub fn bfs[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let _ = g
  let _ = start
  Err(InvalidNode(start.index))
}

///| Iterative breadth-first search starting from `start` on an undirected graph.
pub fn ungraph_bfs[N, E](g : UnGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let _ = g
  let _ = start
  Err(InvalidNode(start.index))
}

///| Iterative depth-first search (preorder) starting from `start`.
pub fn dfs_preorder[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let _ = g
  let _ = start
  Err(InvalidNode(start.index))
}

///| Iterative depth-first search (postorder) starting from `start`.
pub fn dfs_postorder[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let _ = g
  let _ = start
  Err(InvalidNode(start.index))
}

///| Iterative full-forest DFS computing preorder, postorder, discovery and finish times.
pub fn dfs_full[N, E](g : DiGraph[N, E]) -> DfsTimes {
  let _ = g
  DfsTimes::{
    preorder: Array::new(),
    postorder: Array::new(),
    discovery: FixedArray::make(0, -1),
    finish: FixedArray::make(0, -1),
  }
}

///| Iterative depth-first search (preorder) starting from `start` on an undirected graph.
pub fn ungraph_dfs_preorder[N, E](
  g : UnGraph[N, E],
  start : NodeId,
) -> Result[Array[NodeId], GraphError] {
  let _ = g
  let _ = start
  Err(InvalidNode(start.index))
}
