///| Iterative BFS and DFS graph traversals (100% zero recursion).

///| Iterative breadth-first search starting from `start` on a directed graph.
pub fn bfs[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let s = start.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let out : Array[NodeId] = Array::new()
  visited[s] = true
  queue[0] = s
  let mut head = 0
  let mut tail = 1
  while head < tail {
    let u = queue[head]
    head = head + 1
    out.push(NodeId::{ index: u })
    let mut e = g.first_out[u]
    while e != -1 {
      let v = g.edge_dst[e]
      if !visited[v] {
        visited[v] = true
        queue[tail] = v
        tail = tail + 1
      }
      e = g.next_out[e]
    }
  }
  Ok(out)
}

///| Iterative breadth-first search starting from `start` on an undirected graph.
pub fn ungraph_bfs[N, E](g : UnGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let s = start.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let out : Array[NodeId] = Array::new()
  visited[s] = true
  queue[0] = s
  let mut head = 0
  let mut tail = 1
  while head < tail {
    let u = queue[head]
    head = head + 1
    out.push(NodeId::{ index: u })
    let mut e = g.first_edge[u]
    while e != -1 {
      let v = g.other_endpoint(u, e)
      if !visited[v] {
        visited[v] = true
        queue[tail] = v
        tail = tail + 1
      }
      e = g.next_incident(u, e)
    }
  }
  Ok(out)
}

///| Iterative depth-first search (preorder) starting from `start`.
pub fn dfs_preorder[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let s = start.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let out : Array[NodeId] = Array::new()

  visited[s] = true
  out.push(NodeId::{ index: s })
  s_node[0] = s
  s_edge[0] = g.first_out[s]
  let mut top = 1

  while top > 0 {
    let ti = top - 1
    let e = s_edge[ti]
    if e != -1 {
      s_edge[ti] = g.next_out[e]
      let v = g.edge_dst[e]
      if !visited[v] {
        visited[v] = true
        out.push(NodeId::{ index: v })
        s_node[top] = v
        s_edge[top] = g.first_out[v]
        top = top + 1
      }
    } else {
      top = top - 1
    }
  }
  Ok(out)
}

///| Iterative depth-first search (postorder) starting from `start`.
pub fn dfs_postorder[N, E](g : DiGraph[N, E], start : NodeId) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let s = start.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let out : Array[NodeId] = Array::new()

  visited[s] = true
  s_node[0] = s
  s_edge[0] = g.first_out[s]
  let mut top = 1

  while top > 0 {
    let ti = top - 1
    let e = s_edge[ti]
    if e != -1 {
      s_edge[ti] = g.next_out[e]
      let v = g.edge_dst[e]
      if !visited[v] {
        visited[v] = true
        s_node[top] = v
        s_edge[top] = g.first_out[v]
        top = top + 1
      }
    } else {
      out.push(NodeId::{ index: s_node[ti] })
      top = top - 1
    }
  }
  Ok(out)
}

///| Iterative full-forest DFS computing preorder, postorder, discovery and finish times.
pub fn dfs_full[N, E](g : DiGraph[N, E]) -> DfsTimes {
  let n = g.node_count()
  let preorder : Array[NodeId] = Array::with_capacity(n)
  let postorder : Array[NodeId] = Array::with_capacity(n)
  let discovery : FixedArray[Int] = FixedArray::make(n, -1)
  let finish : FixedArray[Int] = FixedArray::make(n, -1)
  if n == 0 {
    return DfsTimes::{ preorder, postorder, discovery, finish }
  }
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let mut clock = 0
  let mut root = 0
  while root < n {
    if discovery[root] != -1 {
      root = root + 1
      continue
    }
    discovery[root] = clock
    clock = clock + 1
    preorder.push(NodeId::{ index: root })
    s_node[0] = root
    s_edge[0] = g.first_out[root]
    let mut top = 1

    while top > 0 {
      let ti = top - 1
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_out[e]
        let v = g.edge_dst[e]
        if discovery[v] == -1 {
          discovery[v] = clock
          clock = clock + 1
          preorder.push(NodeId::{ index: v })
          s_node[top] = v
          s_edge[top] = g.first_out[v]
          top = top + 1
        }
      } else {
        let u = s_node[ti]
        finish[u] = clock
        clock = clock + 1
        postorder.push(NodeId::{ index: u })
        top = top - 1
      }
    }
    root = root + 1
  }
  DfsTimes::{ preorder, postorder, discovery, finish }
}

///| Iterative depth-first search (preorder) starting from `start` on an undirected graph.
pub fn ungraph_dfs_preorder[N, E](
  g : UnGraph[N, E],
  start : NodeId,
) -> Result[Array[NodeId], GraphError] {
  let n = g.node_count()
  let s = start.index
  if s < 0 || s >= n {
    return Err(InvalidNode(s))
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let out : Array[NodeId] = Array::new()

  visited[s] = true
  out.push(NodeId::{ index: s })
  s_node[0] = s
  s_edge[0] = g.first_edge[s]
  let mut top = 1

  while top > 0 {
    let ti = top - 1
    let u = s_node[ti]
    let e = s_edge[ti]
    if e != -1 {
      s_edge[ti] = g.next_incident(u, e)
      let v = g.other_endpoint(u, e)
      if !visited[v] {
        visited[v] = true
        out.push(NodeId::{ index: v })
        s_node[top] = v
        s_edge[top] = g.first_edge[v]
        top = top + 1
      }
    } else {
      top = top - 1
    }
  }
  Ok(out)
}
