///| Mutable flat-index directed adjacency-list graph `DiGraph[N, E]`.

///| Directed graph with flat-array intrusive out/in edge lists (insertion-order iteration).
pub struct DiGraph[N, E] {
  node_weights : Array[N]
  first_out : Array[Int]
  last_out : Array[Int]
  first_in : Array[Int]
  last_in : Array[Int]
  edge_weights : Array[E]
  edge_src : Array[Int]
  edge_dst : Array[Int]
  next_out : Array[Int]
  next_in : Array[Int]
}

///| Create an empty directed graph.
pub fn DiGraph::new[N, E]() -> DiGraph[N, E] {
  DiGraph::{
    node_weights: Array::new(),
    first_out: Array::new(),
    last_out: Array::new(),
    first_in: Array::new(),
    last_in: Array::new(),
    edge_weights: Array::new(),
    edge_src: Array::new(),
    edge_dst: Array::new(),
    next_out: Array::new(),
    next_in: Array::new(),
  }
}

///| Create an empty directed graph with pre-allocated capacities.
pub fn DiGraph::with_capacity[N, E](nodes : Int, edges : Int) -> DiGraph[N, E] {
  let nc = if nodes > 0 { nodes } else { 0 }
  let ec = if edges > 0 { edges } else { 0 }
  DiGraph::{
    node_weights: Array::with_capacity(nc),
    first_out: Array::with_capacity(nc),
    last_out: Array::with_capacity(nc),
    first_in: Array::with_capacity(nc),
    last_in: Array::with_capacity(nc),
    edge_weights: Array::with_capacity(ec),
    edge_src: Array::with_capacity(ec),
    edge_dst: Array::with_capacity(ec),
    next_out: Array::with_capacity(ec),
    next_in: Array::with_capacity(ec),
  }
}

///| Return the number of nodes in the graph.
pub fn DiGraph::node_count[N, E](self : DiGraph[N, E]) -> Int {
  self.node_weights.length()
}

///| Return the number of edges in the graph.
pub fn DiGraph::edge_count[N, E](self : DiGraph[N, E]) -> Int {
  self.edge_weights.length()
}

///| Check whether `id` is a valid node in this graph.
pub fn DiGraph::has_node[N, E](self : DiGraph[N, E], id : NodeId) -> Bool {
  id.index >= 0 && id.index < self.node_weights.length()
}

///| Check whether `id` is a valid edge in this graph.
pub fn DiGraph::has_edge[N, E](self : DiGraph[N, E], id : EdgeId) -> Bool {
  id.index >= 0 && id.index < self.edge_weights.length()
}

///| Add a node with `weight` and return its `NodeId`.
pub fn DiGraph::add_node[N, E](self : DiGraph[N, E], weight : N) -> NodeId {
  let idx = self.node_weights.length()
  self.node_weights.push(weight)
  self.first_out.push(-1)
  self.last_out.push(-1)
  self.first_in.push(-1)
  self.last_in.push(-1)
  NodeId::{ index: idx }
}

///| Add a directed edge `from -> to` with `weight`.
pub fn DiGraph::add_edge[N, E](
  self : DiGraph[N, E],
  from : NodeId,
  to : NodeId,
  weight : E,
) -> Result[EdgeId, GraphError] {
  let n = self.node_weights.length()
  let u = from.index
  let v = to.index
  if u < 0 || u >= n {
    return Err(InvalidNode(u))
  }
  if v < 0 || v >= n {
    return Err(InvalidNode(v))
  }
  let e = self.edge_weights.length()
  self.edge_weights.push(weight)
  self.edge_src.push(u)
  self.edge_dst.push(v)
  self.next_out.push(-1)
  self.next_in.push(-1)

  // Append to out-list of u (preserving insertion order)
  let tail_out = self.last_out[u]
  if tail_out == -1 {
    self.first_out[u] = e
  } else {
    self.next_out[tail_out] = e
  }
  self.last_out[u] = e

  // Append to in-list of v (preserving insertion order)
  let tail_in = self.last_in[v]
  if tail_in == -1 {
    self.first_in[v] = e
  } else {
    self.next_in[tail_in] = e
  }
  self.last_in[v] = e

  Ok(EdgeId::{ index: e })
}

///| Get the weight of node `id`.
pub fn DiGraph::node_weight[N, E](self : DiGraph[N, E], id : NodeId) -> Option[N] {
  if !self.has_node(id) {
    return None
  }
  Some(self.node_weights[id.index])
}

///| Set the weight of node `id`.
pub fn DiGraph::set_node_weight[N, E](
  self : DiGraph[N, E],
  id : NodeId,
  weight : N,
) -> Result[Unit, GraphError] {
  if !self.has_node(id) {
    return Err(InvalidNode(id.index))
  }
  self.node_weights[id.index] = weight
  Ok(())
}

///| Get the weight of edge `id`.
pub fn DiGraph::edge_weight[N, E](self : DiGraph[N, E], id : EdgeId) -> Option[E] {
  if !self.has_edge(id) {
    return None
  }
  Some(self.edge_weights[id.index])
}

///| Set the weight of edge `id`.
pub fn DiGraph::set_edge_weight[N, E](
  self : DiGraph[N, E],
  id : EdgeId,
  weight : E,
) -> Result[Unit, GraphError] {
  if !self.has_edge(id) {
    return Err(InvalidEdge(id.index))
  }
  self.edge_weights[id.index] = weight
  Ok(())
}

///| Return `(source, target)` endpoints of edge `id`.
pub fn DiGraph::edge_endpoints[N, E](self : DiGraph[N, E], id : EdgeId) -> Option[(NodeId, NodeId)] {
  if !self.has_edge(id) {
    return None
  }
  Some((NodeId::{ index: self.edge_src[id.index] }, NodeId::{ index: self.edge_dst[id.index] }))
}

///| Internal: unlink edge `target` from out-list of `u`.
fn DiGraph::unlink_out[N, E](self : DiGraph[N, E], u : Int, target : Int) -> Unit {
  let mut prev = -1
  let mut cur = self.first_out[u]
  while cur != -1 {
    let nxt = self.next_out[cur]
    if cur == target {
      if prev == -1 {
        self.first_out[u] = nxt
      } else {
        self.next_out[prev] = nxt
      }
      if self.last_out[u] == target {
        self.last_out[u] = prev
      }
      return
    }
    prev = cur
    cur = nxt
  }
}

///| Internal: unlink edge `target` from in-list of `v`.
fn DiGraph::unlink_in[N, E](self : DiGraph[N, E], v : Int, target : Int) -> Unit {
  let mut prev = -1
  let mut cur = self.first_in[v]
  while cur != -1 {
    let nxt = self.next_in[cur]
    if cur == target {
      if prev == -1 {
        self.first_in[v] = nxt
      } else {
        self.next_in[prev] = nxt
      }
      if self.last_in[v] == target {
        self.last_in[v] = prev
      }
      return
    }
    prev = cur
    cur = nxt
  }
}

///| Internal: rewrite edge reference `old_e -> new_e` in out-list of `u`.
fn DiGraph::relink_out[N, E](self : DiGraph[N, E], u : Int, old_e : Int, new_e : Int) -> Unit {
  if self.first_out[u] == old_e {
    self.first_out[u] = new_e
  } else {
    let mut cur = self.first_out[u]
    while cur != -1 {
      let nxt = self.next_out[cur]
      if nxt == old_e {
        self.next_out[cur] = new_e
        break
      }
      cur = nxt
    }
  }
  if self.last_out[u] == old_e {
    self.last_out[u] = new_e
  }
}

///| Internal: rewrite edge reference `old_e -> new_e` in in-list of `v`.
fn DiGraph::relink_in[N, E](self : DiGraph[N, E], v : Int, old_e : Int, new_e : Int) -> Unit {
  if self.first_in[v] == old_e {
    self.first_in[v] = new_e
  } else {
    let mut cur = self.first_in[v]
    while cur != -1 {
      let nxt = self.next_in[cur]
      if nxt == old_e {
        self.next_in[cur] = new_e
        break
      }
      cur = nxt
    }
  }
  if self.last_in[v] == old_e {
    self.last_in[v] = new_e
  }
}

///| Remove edge `id` (swap-removing the last edge into its slot) and return its weight.
pub fn DiGraph::remove_edge[N, E](self : DiGraph[N, E], id : EdgeId) -> Option[E] {
  let m = self.edge_weights.length()
  let e = id.index
  if e < 0 || e >= m {
    return None
  }
  let removed = self.edge_weights[e]
  let u = self.edge_src[e]
  let v = self.edge_dst[e]
  self.unlink_out(u, e)
  self.unlink_in(v, e)

  let last = m - 1
  if e != last {
    let lu = self.edge_src[last]
    let lv = self.edge_dst[last]
    self.edge_weights[e] = self.edge_weights[last]
    self.edge_src[e] = lu
    self.edge_dst[e] = lv
    self.next_out[e] = self.next_out[last]
    self.next_in[e] = self.next_in[last]
    self.relink_out(lu, last, e)
    self.relink_in(lv, last, e)
  }

  let _ = self.edge_weights.pop()
  let _ = self.edge_src.pop()
  let _ = self.edge_dst.pop()
  let _ = self.next_out.pop()
  let _ = self.next_in.pop()
  Some(removed)
}

///| Remove node `id` and all incident edges (swap-removing the last node into its slot).
pub fn DiGraph::remove_node[N, E](self : DiGraph[N, E], id : NodeId) -> Option[N] {
  let n = self.node_weights.length()
  let u = id.index
  if u < 0 || u >= n {
    return None
  }
  // Remove all outgoing edges of u (including self-loops)
  while self.first_out[u] != -1 {
    let _ = self.remove_edge(EdgeId::{ index: self.first_out[u] })
  }
  // Remove all remaining incoming edges of u
  while self.first_in[u] != -1 {
    let _ = self.remove_edge(EdgeId::{ index: self.first_in[u] })
  }

  let removed = self.node_weights[u]
  let last = n - 1
  if u != last {
    self.node_weights[u] = self.node_weights[last]
    self.first_out[u] = self.first_out[last]
    self.last_out[u] = self.last_out[last]
    self.first_in[u] = self.first_in[last]
    self.last_in[u] = self.last_in[last]

    // Re-point outgoing edges of `last` to `u`
    let mut eo = self.first_out[u]
    while eo != -1 {
      self.edge_src[eo] = u
      eo = self.next_out[eo]
    }
    // Re-point incoming edges of `last` to `u`
    let mut ei = self.first_in[u]
    while ei != -1 {
      self.edge_dst[ei] = u
      ei = self.next_in[ei]
    }
  }

  let _ = self.node_weights.pop()
  let _ = self.first_out.pop()
  let _ = self.last_out.pop()
  let _ = self.first_in.pop()
  let _ = self.last_in.pop()
  Some(removed)
}

///| Return all outgoing neighbors of `u` in insertion order.
pub fn DiGraph::neighbors_out[N, E](self : DiGraph[N, E], u : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let mut e = self.first_out[u.index]
  while e != -1 {
    out.push(NodeId::{ index: self.edge_dst[e] })
    e = self.next_out[e]
  }
  out
}

///| Return all incoming neighbors of `u` in insertion order.
pub fn DiGraph::neighbors_in[N, E](self : DiGraph[N, E], u : NodeId) -> Array[NodeId] {
  let out : Array[NodeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let mut e = self.first_in[u.index]
  while e != -1 {
    out.push(NodeId::{ index: self.edge_src[e] })
    e = self.next_in[e]
  }
  out
}

///| Return all outgoing `EdgeId`s of `u`.
pub fn DiGraph::out_edges[N, E](self : DiGraph[N, E], u : NodeId) -> Array[EdgeId] {
  let out : Array[EdgeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let mut e = self.first_out[u.index]
  while e != -1 {
    out.push(EdgeId::{ index: e })
    e = self.next_out[e]
  }
  out
}

///| Return all incoming `EdgeId`s of `u`.
pub fn DiGraph::in_edges[N, E](self : DiGraph[N, E], u : NodeId) -> Array[EdgeId] {
  let out : Array[EdgeId] = Array::new()
  if !self.has_node(u) {
    return out
  }
  let mut e = self.first_in[u.index]
  while e != -1 {
    out.push(EdgeId::{ index: e })
    e = self.next_in[e]
  }
  out
}

///| Return out-degree of `u` (or 0 if invalid).
pub fn DiGraph::out_degree[N, E](self : DiGraph[N, E], u : NodeId) -> Int {
  if !self.has_node(u) {
    return 0
  }
  let mut deg = 0
  let mut e = self.first_out[u.index]
  while e != -1 {
    deg = deg + 1
    e = self.next_out[e]
  }
  deg
}

///| Return in-degree of `u` (or 0 if invalid).
pub fn DiGraph::in_degree[N, E](self : DiGraph[N, E], u : NodeId) -> Int {
  if !self.has_node(u) {
    return 0
  }
  let mut deg = 0
  let mut e = self.first_in[u.index]
  while e != -1 {
    deg = deg + 1
    e = self.next_in[e]
  }
  deg
}

///| Find the first directed edge `from -> to`.
pub fn DiGraph::find_edge[N, E](self : DiGraph[N, E], from : NodeId, to : NodeId) -> Option[EdgeId] {
  if !self.has_node(from) || !self.has_node(to) {
    return None
  }
  let target = to.index
  let mut e = self.first_out[from.index]
  while e != -1 {
    if self.edge_dst[e] == target {
      return Some(EdgeId::{ index: e })
    }
    e = self.next_out[e]
  }
  None
}

///| Check whether a directed edge `from -> to` exists.
pub fn DiGraph::contains_edge[N, E](self : DiGraph[N, E], from : NodeId, to : NodeId) -> Bool {
  match self.find_edge(from, to) {
    Some(_) => true
    None => false
  }
}
