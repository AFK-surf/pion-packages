///| Graphviz DOT format exporter with proper quote and control-character escaping.

///| Export a `DiGraph[N, E]` to Graphviz DOT format.
pub fn digraph_to_dot[N, E](
  g : DiGraph[N, E],
  node_label : (NodeId, N) -> String,
  edge_label : (EdgeId, E) -> String,
) -> String {
  let _ = g
  let _ = node_label
  let _ = edge_label
  ""
}

///| Export an `UnGraph[N, E]` to Graphviz DOT format.
pub fn ungraph_to_dot[N, E](
  g : UnGraph[N, E],
  node_label : (NodeId, N) -> String,
  edge_label : (EdgeId, E) -> String,
) -> String {
  let _ = g
  let _ = node_label
  let _ = edge_label
  ""
}
