///| Connectivity, SCC (Tarjan & Kosaraju), bridges, articulation points, and bipartiteness.

///| Iterative Tarjan strongly connected components in deterministic reverse topological order.
pub fn tarjan_scc[N, E](g : DiGraph[N, E]) -> Array[Array[NodeId]] {
  let _ = g
  Array::new()
}

///| Iterative Kosaraju strongly connected components in deterministic reverse topological order.
pub fn kosaraju_scc[N, E](g : DiGraph[N, E]) -> Array[Array[NodeId]] {
  let _ = g
  Array::new()
}

///| Connected components of an undirected graph.
pub fn connected_components[N, E](g : UnGraph[N, E]) -> Array[Array[NodeId]] {
  let _ = g
  Array::new()
}

///| Number of connected components in an undirected graph.
pub fn connected_component_count[N, E](g : UnGraph[N, E]) -> Int {
  let _ = g
  -1
}

///| Iterative Tarjan bridge-finding on an undirected graph (handles parallel edges & self-loops).
pub fn bridges[N, E](g : UnGraph[N, E]) -> Array[EdgeId] {
  let _ = g
  Array::new()
}

///| Iterative Tarjan articulation points (cut vertices) of an undirected graph.
pub fn articulation_points[N, E](g : UnGraph[N, E]) -> Array[NodeId] {
  let _ = g
  Array::new()
}

///| Check whether an undirected graph is bipartite and compute a valid 2-coloring.
pub fn is_bipartite[N, E](g : UnGraph[N, E]) -> BipartiteResult {
  let _ = g
  BipartiteResult::{ is_bipartite: false, colors: FixedArray::make(0, -1) }
}
