///| Connectivity, SCC (Tarjan & Kosaraju), bridges, articulation points, and bipartiteness.
///| All algorithms are 100% iterative (zero recursion).

///| Iterative Tarjan strongly connected components in deterministic reverse topological order.
pub fn tarjan_scc[N, E](g : DiGraph[N, E]) -> Array[Array[NodeId]] {
  let n = g.node_count()
  let sccs : Array[Array[NodeId]] = Array::new()
  if n == 0 {
    return sccs
  }
  let first_out = g.first_out
  let next_out = g.next_out
  let edge_dst = g.edge_dst

  let disc : FixedArray[Int] = FixedArray::make(n, -1)
  let low : FixedArray[Int] = FixedArray::make(n, 0)
  let on_stack : FixedArray[Bool] = FixedArray::make(n, false)
  let t_stack : FixedArray[Int] = FixedArray::make(n, 0)
  let mut t_top = 0

  let call_node : FixedArray[Int] = FixedArray::make(n, 0)
  let call_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let mut c_top = 0
  let mut timer = 0

  let mut start = 0
  while start < n {
    if disc[start] != -1 {
      start = start + 1
      continue
    }
    disc[start] = timer
    low[start] = timer
    timer = timer + 1
    t_stack[t_top] = start
    t_top = t_top + 1
    on_stack[start] = true
    call_node[0] = start
    call_edge[0] = first_out[start]
    c_top = 1

    while c_top > 0 {
      let ti = c_top - 1
      let u = call_node[ti]
      let e = call_edge[ti]
      if e != -1 {
        call_edge[ti] = next_out[e]
        let v = edge_dst[e]
        let dv = disc[v]
        if dv == -1 {
          disc[v] = timer
          low[v] = timer
          timer = timer + 1
          t_stack[t_top] = v
          t_top = t_top + 1
          on_stack[v] = true
          call_node[c_top] = v
          call_edge[c_top] = first_out[v]
          c_top = c_top + 1
        } else if on_stack[v] {
          if dv < low[u] {
            low[u] = dv
          }
        }
      } else {
        c_top = c_top - 1
        if low[u] == disc[u] {
          let comp : Array[NodeId] = Array::new()
          while true {
            t_top = t_top - 1
            let w = t_stack[t_top]
            on_stack[w] = false
            comp.push(NodeId::{ index: w })
            if w == u {
              break
            }
          }
          sccs.push(comp)
        }
        if c_top > 0 {
          let p = call_node[c_top - 1]
          if low[u] < low[p] {
            low[p] = low[u]
          }
        }
      }
    }
    start = start + 1
  }
  sccs
}

///| Iterative Kosaraju strongly connected components in deterministic reverse topological order.
pub fn kosaraju_scc[N, E](g : DiGraph[N, E]) -> Array[Array[NodeId]] {
  let n = g.node_count()
  let sccs : Array[Array[NodeId]] = Array::new()
  if n == 0 {
    return sccs
  }
  // Pass 1: iterative postorder on forward graph
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let order : FixedArray[Int] = FixedArray::make(n, 0)
  let mut ord_len = 0
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)

  let mut start = 0
  while start < n {
    if visited[start] {
      start = start + 1
      continue
    }
    visited[start] = true
    s_node[0] = start
    s_edge[0] = g.first_out[start]
    let mut top = 1
    while top > 0 {
      let ti = top - 1
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_out[e]
        let v = g.edge_dst[e]
        if !visited[v] {
          visited[v] = true
          s_node[top] = v
          s_edge[top] = g.first_out[v]
          top = top + 1
        }
      } else {
        order[ord_len] = s_node[ti]
        ord_len = ord_len + 1
        top = top - 1
      }
    }
    start = start + 1
  }

  // Pass 2: iterative DFS on transposed graph (`first_in` / `next_in`) in reverse finish order.
  // This emits SCCs in topological order (sources first), so we reverse at the end to match Tarjan.
  let assigned : FixedArray[Bool] = FixedArray::make(n, false)
  let topo_sccs : Array[Array[NodeId]] = Array::new()
  let mut idx = ord_len - 1
  while idx >= 0 {
    let seed = order[idx]
    idx = idx - 1
    if assigned[seed] {
      continue
    }
    let comp : Array[NodeId] = Array::new()
    assigned[seed] = true
    s_node[0] = seed
    s_edge[0] = g.first_in[seed]
    let mut top = 1
    while top > 0 {
      let ti = top - 1
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_in[e]
        let prev_u = g.edge_src[e]
        if !assigned[prev_u] {
          assigned[prev_u] = true
          s_node[top] = prev_u
          s_edge[top] = g.first_in[prev_u]
          top = top + 1
        }
      } else {
        comp.push(NodeId::{ index: s_node[ti] })
        top = top - 1
      }
    }
    topo_sccs.push(comp)
  }

  // Reverse so sink SCCs come first (reverse topological order)
  let mut k = topo_sccs.length() - 1
  while k >= 0 {
    sccs.push(topo_sccs[k])
    k = k - 1
  }
  sccs
}

///| Connected components of an undirected graph.
pub fn connected_components[N, E](g : UnGraph[N, E]) -> Array[Array[NodeId]] {
  let n = g.node_count()
  let comps : Array[Array[NodeId]] = Array::new()
  if n == 0 {
    return comps
  }
  let visited : FixedArray[Bool] = FixedArray::make(n, false)
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let mut start = 0
  while start < n {
    if visited[start] {
      start = start + 1
      continue
    }
    let comp : Array[NodeId] = Array::new()
    visited[start] = true
    queue[0] = start
    let mut head = 0
    let mut tail = 1
    while head < tail {
      let u = queue[head]
      head = head + 1
      comp.push(NodeId::{ index: u })
      let mut e = g.first_edge[u]
      while e != -1 {
        let v = g.other_endpoint(u, e)
        if !visited[v] {
          visited[v] = true
          queue[tail] = v
          tail = tail + 1
        }
        e = g.next_incident(u, e)
      }
    }
    comps.push(comp)
    start = start + 1
  }
  comps
}

///| Number of connected components in an undirected graph.
pub fn connected_component_count[N, E](g : UnGraph[N, E]) -> Int {
  let n = g.node_count()
  if n == 0 {
    return 0
  }
  let uf = UnionFind::new(n)
  let m = g.edge_count()
  let mut e = 0
  while e < m {
    let _ = uf.union_raw(g.edge_u[e], g.edge_v[e])
    e = e + 1
  }
  uf.component_count()
}

///| Iterative Tarjan bridge-finding on an undirected graph (handles parallel edges & self-loops).
pub fn bridges[N, E](g : UnGraph[N, E]) -> Array[EdgeId] {
  let n = g.node_count()
  let out : Array[EdgeId] = Array::new()
  if n == 0 || g.edge_count() == 0 {
    return out
  }
  let disc : FixedArray[Int] = FixedArray::make(n, -1)
  let low : FixedArray[Int] = FixedArray::make(n, 0)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let s_parent_edge : FixedArray[Int] = FixedArray::make(n, -1)
  let mut timer = 0

  let mut start = 0
  while start < n {
    if disc[start] != -1 {
      start = start + 1
      continue
    }
    disc[start] = timer
    low[start] = timer
    timer = timer + 1
    s_node[0] = start
    s_edge[0] = g.first_edge[start]
    s_parent_edge[0] = -1
    let mut top = 1

    while top > 0 {
      let ti = top - 1
      let u = s_node[ti]
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_incident(u, e)
        if e == s_parent_edge[ti] {
          continue
        }
        let v = g.other_endpoint(u, e)
        if v == u {
          // Self-loop cannot be a bridge
          continue
        }
        let dv = disc[v]
        if dv == -1 {
          disc[v] = timer
          low[v] = timer
          timer = timer + 1
          s_node[top] = v
          s_edge[top] = g.first_edge[v]
          s_parent_edge[top] = e
          top = top + 1
        } else if dv < low[u] {
          low[u] = dv
        }
      } else {
        let pe = s_parent_edge[ti]
        top = top - 1
        if top > 0 {
          let p = s_node[top - 1]
          if low[u] < low[p] {
            low[p] = low[u]
          }
          if low[u] > disc[p] {
            out.push(EdgeId::{ index: pe })
          }
        }
      }
    }
    start = start + 1
  }
  out
}

///| Iterative Tarjan articulation points (cut vertices) of an undirected graph (sorted by index).
pub fn articulation_points[N, E](g : UnGraph[N, E]) -> Array[NodeId] {
  let n = g.node_count()
  let out : Array[NodeId] = Array::new()
  if n == 0 || g.edge_count() == 0 {
    return out
  }
  let disc : FixedArray[Int] = FixedArray::make(n, -1)
  let low : FixedArray[Int] = FixedArray::make(n, 0)
  let is_art : FixedArray[Bool] = FixedArray::make(n, false)
  let s_node : FixedArray[Int] = FixedArray::make(n, 0)
  let s_edge : FixedArray[Int] = FixedArray::make(n, 0)
  let s_parent_edge : FixedArray[Int] = FixedArray::make(n, -1)
  let s_children : FixedArray[Int] = FixedArray::make(n, 0)
  let mut timer = 0

  let mut start = 0
  while start < n {
    if disc[start] != -1 {
      start = start + 1
      continue
    }
    disc[start] = timer
    low[start] = timer
    timer = timer + 1
    s_node[0] = start
    s_edge[0] = g.first_edge[start]
    s_parent_edge[0] = -1
    s_children[0] = 0
    let mut top = 1

    while top > 0 {
      let ti = top - 1
      let u = s_node[ti]
      let e = s_edge[ti]
      if e != -1 {
        s_edge[ti] = g.next_incident(u, e)
        if e == s_parent_edge[ti] {
          continue
        }
        let v = g.other_endpoint(u, e)
        if v == u {
          continue
        }
        let dv = disc[v]
        if dv == -1 {
          s_children[ti] = s_children[ti] + 1
          disc[v] = timer
          low[v] = timer
          timer = timer + 1
          s_node[top] = v
          s_edge[top] = g.first_edge[v]
          s_parent_edge[top] = e
          s_children[top] = 0
          top = top + 1
        } else if dv < low[u] {
          low[u] = dv
        }
      } else {
        let is_root = top == 1
        let ch = s_children[ti]
        top = top - 1
        if is_root {
          if ch >= 2 {
            is_art[u] = true
          }
        } else {
          let p = s_node[top - 1]
          if low[u] < low[p] {
            low[p] = low[u]
          }
          if top - 1 > 0 && low[u] >= disc[p] {
            is_art[p] = true
          }
        }
      }
    }
    start = start + 1
  }

  let mut i = 0
  while i < n {
    if is_art[i] {
      out.push(NodeId::{ index: i })
    }
    i = i + 1
  }
  out
}

///| Check whether an undirected graph is bipartite and compute a valid 2-coloring.
pub fn is_bipartite[N, E](g : UnGraph[N, E]) -> BipartiteResult {
  let n = g.node_count()
  let colors : FixedArray[Int] = FixedArray::make(n, -1)
  if n == 0 {
    return BipartiteResult::{ is_bipartite: true, colors }
  }
  let queue : FixedArray[Int] = FixedArray::make(n, 0)
  let mut start = 0
  while start < n {
    if colors[start] != -1 {
      start = start + 1
      continue
    }
    colors[start] = 0
    queue[0] = start
    let mut head = 0
    let mut tail = 1
    while head < tail {
      let u = queue[head]
      head = head + 1
      let cu = colors[u]
      let next_c = 1 - cu
      let mut e = g.first_edge[u]
      while e != -1 {
        let v = g.other_endpoint(u, e)
        if v == u {
          return BipartiteResult::{ is_bipartite: false, colors }
        }
        let cv = colors[v]
        if cv == -1 {
          colors[v] = next_c
          queue[tail] = v
          tail = tail + 1
        } else if cv == cu {
          return BipartiteResult::{ is_bipartite: false, colors }
        }
        e = g.next_incident(u, e)
      }
    }
    start = start + 1
  }
  BipartiteResult::{ is_bipartite: true, colors }
}
