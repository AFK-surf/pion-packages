///| Native + Wasm32 smoke entry for `packages/graph` (including 100k chain zero-stack-overflow check).

import "graph"

///|
pub fn smoke() -> Int {
  // 1. Small weighted DiGraph + CSR + Dijkstra + Dominators + Dinic
  let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let n3 = g.add_node(())
  let _ = g.add_edge(n0, n1, 3L)
  let _ = g.add_edge(n0, n2, 2L)
  let _ = g.add_edge(n1, n2, 5L)
  let _ = g.add_edge(n1, n3, 2L)
  let _ = g.add_edge(n2, n3, 3L)

  let csr = graph::CsrGraph::from_digraph(g)
  match graph::csr_dijkstra(csr, n0, None) {
    Ok(sp) =>
    match sp.distance(n3) {
      Some(d) => if d != 5L { return -1 }
      None => return -2
    }
    Err(_) => return -3
  }
  match graph::dinic_max_flow(g, n0, n3, fn(c) { c }) {
    Ok(mf) => if mf.max_flow != 5L { return -4 }
    Err(_) => return -5
  }

  // 2. UnGraph Kruskal + Prim + Bridges + Bipartite
  let ug : graph::UnGraph[Unit, Int64] = graph::UnGraph::new()
  let u0 = ug.add_node(())
  let u1 = ug.add_node(())
  let u2 = ug.add_node(())
  let _ = ug.add_edge(u0, u1, 4L)
  let _ = ug.add_edge(u1, u2, 5L)
  let _ = ug.add_edge(u0, u2, 10L)
  match graph::kruskal_mst_i64(ug) {
    Ok(m) => if m.total_weight != 9L { return -6 }
    Err(_) => return -7
  }
  if graph::is_bipartite(ug).is_bipartite {
    return -8
  }

  // 3. 100k chain on Wasm32 + Native (0 stack overflow!)
  let n = 100000
  let chain : graph::DiGraph[Unit, Int64] = graph::DiGraph::with_capacity(n, n - 1)
  let mut i = 0
  while i < n {
    let _ = chain.add_node(())
    i = i + 1
  }
  let mut j = 0
  while j < n - 1 {
    let _ = chain.add_edge(graph::NodeId::new(j), graph::NodeId::new(j + 1), 1L)
    j = j + 1
  }
  let sccs = graph::tarjan_scc(chain)
  if sccs.length() != n {
    return -9
  }
  match graph::toposort(chain) {
    Ok(ord) => if ord.length() != n { return -10 }
    Err(_) => return -11
  }
  match graph::dominators(chain, graph::NodeId::new(0)) {
    Ok(dom) =>
    match dom.immediate_dominator(graph::NodeId::new(n - 1)) {
      Some(p) => if p.index != n - 2 { return -12 }
      None => return -13
    }
    Err(_) => return -14
  }
  1
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
