///| Large-scale stress / adversarial-benchmark workloads and single-shot robustness probes.
///|
///| `stress <family> <n> <algo>` prints `family=.. n=.. algo=.. <checksum>`; the checksum lines are
///| byte-identical to `graph_oracle stress` (petgraph =0.8.3) for every algorithm both libraries have,
///| so `scripts/bench_compare.py` can SHA-check them.

///|
fn fam_edges(family : String, n : Int) -> (Array[Int], Array[Int], Array[Int64]) {
  let eu : Array[Int] = Array::new()
  let ev : Array[Int] = Array::new()
  let ew : Array[Int64] = Array::new()
  if family == "chain" || family == "cycle" {
    let mut i = 0
    while i + 1 < n {
      eu.push(i)
      ev.push(i + 1)
      ew.push((i * 7 % 10 + 1).to_int64())
      i = i + 1
    }
    if family == "cycle" && n > 1 {
      eu.push(n - 1)
      ev.push(0)
      ew.push(1L)
    }
  } else if family == "star" {
    let mut i = 1
    while i < n {
      eu.push(0)
      ev.push(i)
      ew.push((i % 10 + 1).to_int64())
      i = i + 1
    }
  } else if family == "rand" {
    let r = Rng::{ s: 0x5eed5eed5eed5eedUL }
    let mut i = 0
    while i + 1 < n {
      // spanning backbone keeps everything reachable from 0
      eu.push(i)
      ev.push(i + 1)
      ew.push((r.below(1000) + 1).to_int64())
      i = i + 1
    }
    let mut k = 0
    while k < 3 * n {
      let u = r.below(n)
      let v = r.below(n)
      eu.push(u)
      ev.push(v)
      ew.push((r.below(1000) + 1).to_int64())
      k = k + 1
    }
  } else if family == "dense" {
    let mut u = 0
    while u < n {
      let mut v = 0
      while v < n {
        if u != v && (u * 31 + v) % 3 == 0 {
          eu.push(u)
          ev.push(v)
          ew.push(((u * 7 + v * 13) % 100 + 1).to_int64())
        }
        v = v + 1
      }
      u = u + 1
    }
  } else if family == "layers" {
    // Dinic stress: source 0 -> L layers of width 10 (complete bipartite between layers) -> sink
    let r = Rng::{ s: 0x0d1c0d1c0d1c0d1cUL }
    let width = 10
    let layers = (n - 2) / width
    let mut j = 0
    while j < width {
      eu.push(0)
      ev.push(1 + j)
      ew.push((r.below(1000000000) + 1).to_int64())
      j = j + 1
    }
    let mut l = 0
    while l + 1 < layers {
      let mut a = 0
      while a < width {
        let mut b = 0
        while b < width {
          eu.push(1 + l * width + a)
          ev.push(1 + (l + 1) * width + b)
          ew.push((r.below(1000000000) + 1).to_int64())
          b = b + 1
        }
        a = a + 1
      }
      l = l + 1
    }
    let sink = 1 + layers * width
    let mut z = 0
    while z < width {
      eu.push(1 + (layers - 1) * width + z)
      ev.push(sink)
      ew.push((r.below(1000000000) + 1).to_int64())
      z = z + 1
    }
  }
  (eu, ev, ew)
}

///|
fn fam_nodes(family : String, n : Int) -> Int {
  if family == "layers" {
    (n - 2) / 10 * 10 + 2
  } else {
    n
  }
}

///|
fn stress(world : World, family : String, n_in : Int) -> Int {
  let args = world_args(world)
  let algo = if args.length() >= 5 { args[4] } else { "all" }
  let n = fam_nodes(family, n_in)
  let (eu, ev, ew) = fam_edges(family, n_in)
  let d : graph::DiGraph[Unit, Int64] = graph::DiGraph::with_capacity(n, eu.length())
  let u : graph::UnGraph[Unit, Int64] = graph::UnGraph::with_capacity(n, eu.length())
  let mut i = 0
  while i < n {
    let _ = d.add_node(())
    let _ = u.add_node(())
    i = i + 1
  }
  let mut e = 0
  while e < eu.length() {
    let _ = d.add_edge(graph::NodeId::new(eu[e]), graph::NodeId::new(ev[e]), ew[e])
    let _ = u.add_edge(graph::NodeId::new(eu[e]), graph::NodeId::new(ev[e]), ew[e])
    e = e + 1
  }
  let head = "family=" + family + " n=" + n.to_string() + " m=" + eu.length().to_string()
  let all = algo == "all"
  let src = graph::NodeId::new(0)
  let last = graph::NodeId::new(n - 1)
  if all || algo == "dij" {
    match graph::dijkstra_i64(d, src, None) {
      Ok(sp) => {
        let mut s = 0L
        let mut c = 0
        let mut v = 0
        while v < n {
          if sp.reachable[v] {
            s = s + sp.distances[v]
            c = c + 1
          }
          v = v + 1
        }
        io_println(world, head + " algo=dij reach=" + c.to_string() + " sum=" + s.to_string())
      }
      Err(er) => io_println(world, head + " algo=dij " + err_name(er))
    }
  }
  if all || algo == "csr_dij" {
    let csr = graph::CsrGraph::from_digraph(d)
    match graph::csr_dijkstra(csr, src, None) {
      Ok(sp) => {
        let mut s = 0L
        let mut c = 0
        let mut v = 0
        while v < n {
          if sp.reachable[v] {
            s = s + sp.distances[v]
            c = c + 1
          }
          v = v + 1
        }
        io_println(world, head + " algo=dij reach=" + c.to_string() + " sum=" + s.to_string())
      }
      Err(er) => io_println(world, head + " algo=dij " + err_name(er))
    }
  }
  if all || algo == "bf" {
    match graph::bellman_ford(d, src, fn(w) { w }) {
      Ok(sp) => {
        let mut s = 0L
        let mut c = 0
        let mut v = 0
        while v < n {
          if sp.reachable[v] {
            s = s + sp.distances[v]
            c = c + 1
          }
          v = v + 1
        }
        io_println(world, head + " algo=bf reach=" + c.to_string() + " sum=" + s.to_string())
      }
      Err(er) => io_println(world, head + " algo=bf " + err_name(er))
    }
  }
  if all || algo == "astar" {
    let goal = n - 1
    match graph::astar(d, src, fn(x) { x.index == goal }, fn(w) { w }, fn(_x) { 0L }) {
      Ok(Some(ar)) => io_println(world, head + " algo=astar cost=" + ar.cost.to_string() + " len=" + ar.path.length().to_string())
      Ok(None) => io_println(world, head + " algo=astar none")
      Err(er) => io_println(world, head + " algo=astar " + err_name(er))
    }
  }
  if all || algo == "tarjan" || algo == "kosaraju" || algo == "csr_tarjan" {
    let sccs = if algo == "kosaraju" {
      graph::kosaraju_scc(d)
    } else if algo == "csr_tarjan" {
      graph::csr_tarjan_scc(graph::CsrGraph::from_digraph(d))
    } else {
      graph::tarjan_scc(d)
    }
    let mut big = 0
    let mut k = 0
    while k < sccs.length() {
      if sccs[k].length() > big {
        big = sccs[k].length()
      }
      k = k + 1
    }
    io_println(world, head + " algo=scc count=" + sccs.length().to_string() + " largest=" + big.to_string())
  }
  if all || algo == "topo" {
    match graph::toposort(d) {
      Ok(o) => io_println(world, head + " algo=topo len=" + o.length().to_string())
      Err(_) => io_println(world, head + " algo=topo cycle")
    }
  }
  if all || algo == "cycle" {
    io_println(world, head + " algo=cycle cyclic=" + graph::is_cyclic(d).to_string())
  }
  if all || algo == "bfs" || algo == "dfs" {
    let o1 = match graph::bfs(d, src) {
      Ok(o) => o.length()
      Err(_) => -1
    }
    let o2 = match graph::dfs_preorder(d, src) {
      Ok(o) => o.length()
      Err(_) => -1
    }
    let o3 = match graph::dfs_postorder(d, src) {
      Ok(o) => o.length()
      Err(_) => -1
    }
    let full = graph::dfs_full(d)
    io_println(
      world,
      head + " algo=traverse bfs=" + o1.to_string() + " pre=" + o2.to_string() + " post=" +
      o3.to_string() + " full=" + full.postorder.length().to_string(),
    )
  }
  if all || algo == "dom" || algo == "df" {
    match graph::dominators(d, src) {
      Ok(dm) => {
        let mut s = 0L
        let mut c = 0
        let mut v = 0
        while v < n {
          if dm.idom[v] >= 0 {
            s = s + dm.idom[v].to_int64()
            c = c + 1
          }
          v = v + 1
        }
        io_println(world, head + " algo=dom reach=" + c.to_string() + " sum_idom=" + s.to_string())
        if algo == "df" {
          let df = dm.dominance_frontiers(d)
          let mut t = 0
          let mut x = 0
          while x < n {
            t = t + df[x].length()
            x = x + 1
          }
          io_println(world, head + " algo=df total=" + t.to_string())
        }
      }
      Err(er) => io_println(world, head + " algo=dom " + err_name(er))
    }
  }
  if all || algo == "dinic" {
    match graph::dinic_max_flow(d, src, last, fn(w) { w }) {
      Ok(mf) => io_println(world, head + " algo=dinic flow=" + mf.max_flow.to_string())
      Err(er) => io_println(world, head + " algo=dinic " + err_name(er))
    }
  }
  if algo == "floyd" {
    match graph::floyd_warshall(d, fn(w) { w }) {
      Ok(ap) => {
        let mut s = 0L
        let mut c = 0
        let mut k = 0
        while k < n * n {
          if ap.reachable[k] {
            s = s + ap.distances[k]
            c = c + 1
          }
          k = k + 1
        }
        io_println(world, head + " algo=floyd reach=" + c.to_string() + " sum=" + s.to_string())
      }
      Err(er) => io_println(world, head + " algo=floyd " + err_name(er))
    }
  }
  if all || algo == "kruskal" {
    match graph::kruskal_mst_i64(u) {
      Ok(mr) => io_println(world, head + " algo=mst total=" + mr.total_weight.to_string() + " edges=" + mr.edges.length().to_string())
      Err(er) => io_println(world, head + " algo=mst " + err_name(er))
    }
  }
  if all || algo == "prim" {
    match graph::prim_mst(u, fn(w) { w }) {
      Ok(mr) => io_println(world, head + " algo=mst total=" + mr.total_weight.to_string() + " edges=" + mr.edges.length().to_string())
      Err(er) => io_println(world, head + " algo=mst " + err_name(er))
    }
  }
  if all || algo == "bridges" {
    io_println(world, head + " algo=bridges count=" + graph::bridges(u).length().to_string())
  }
  if all || algo == "ap" {
    io_println(world, head + " algo=ap count=" + graph::articulation_points(u).length().to_string())
  }
  if all || algo == "cc" {
    io_println(
      world,
      head + " algo=cc count=" + graph::connected_component_count(u).to_string() + " bip=" +
      graph::is_bipartite(u).is_bipartite.to_string(),
    )
  }
  if algo == "tred" {
    match graph::transitive_reduction(d) {
      Ok(r) => io_println(world, head + " algo=tred edges=" + r.edge_count().to_string())
      Err(_) => io_println(world, head + " algo=tred cycle")
    }
  }
  if algo == "none" {
    io_println(world, head + " algo=none")
  }
  if algo == "removenodes" {
    // delete half of the nodes in a fixed pseudo-random order (swap-remove semantics)
    let target = n / 2
    let mut k = 0
    while k < target {
      let cnt = d.node_count()
      let _ = d.remove_node(graph::NodeId::new(k * 7919 % cnt))
      k = k + 1
    }
    let mut h = 0L
    let mut x = 0
    while x < d.edge_count() {
      h = h + (d.edge_src[x] * 31 + d.edge_dst[x]).to_int64()
      x = x + 1
    }
    io_println(
      world,
      head + " algo=removenodes nodes=" + d.node_count().to_string() + " edges=" +
      d.edge_count().to_string() + " h=" + h.to_string(),
    )
  }
  0
}

///| Single robustness probes. Each prints what happened; an abort / trap is itself the evidence.
fn probe(world : World, name : String) -> Int {
  if name == "int_width" {
    let big = 2147483647
    let wrapped = big + 1
    io_println(world, "Int max+1 = " + wrapped.to_string())
    return 0
  }
  if name == "csr_from_edges_intmax" {
    let edges : Array[(Int, Int, Int64)] = Array::new()
    match graph::CsrGraph::from_edges(2147483647, edges) {
      Ok(g) => io_println(world, "Ok node_count=" + g.node_count().to_string())
      Err(e) => io_println(world, "Err " + graph::graph_error_to_string(e))
    }
    return 0
  }
  if name == "csr_from_edges_1e9" {
    let edges : Array[(Int, Int, Int64)] = Array::new()
    match graph::CsrGraph::from_edges(1000000000, edges) {
      Ok(g) => io_println(world, "Ok node_count=" + g.node_count().to_string())
      Err(e) => io_println(world, "Err " + graph::graph_error_to_string(e))
    }
    return 0
  }
  if name == "floyd_46341" {
    // n*n = 2_147_488_281 > Int32::MAX
    let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
    let mut i = 0
    while i < 46341 {
      let _ = g.add_node(())
      i = i + 1
    }
    match graph::floyd_warshall(g, fn(w) { w }) {
      Ok(ap) => io_println(world, "Ok distances.len=" + ap.distances.length().to_string())
      Err(e) => io_println(world, "Err " + graph::graph_error_to_string(e))
    }
    return 0
  }
  if name == "tred_chain_100k" || name == "tred_chain_20k" {
    let n = if name == "tred_chain_100k" { 100000 } else { 20000 }
    let g : graph::DiGraph[Unit, Unit] = graph::DiGraph::with_capacity(n, n)
    let mut i = 0
    while i < n {
      let _ = g.add_node(())
      i = i + 1
    }
    let mut j = 0
    while j + 1 < n {
      let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new(j + 1), ())
      j = j + 1
    }
    match graph::transitive_reduction(g) {
      Ok(r) => io_println(world, "tred edges=" + r.edge_count().to_string())
      Err(e) => io_println(world, "Err " + graph::graph_error_to_string(e))
    }
    return 0
  }
  if name == "tred_star_370800" {
    // n * ceil(n / 64) = 2_148_413_400 > Int32::MAX for the reachability bitset
    let n = 370800
    let g : graph::DiGraph[Unit, Unit] = graph::DiGraph::with_capacity(n, n)
    let mut i = 0
    while i < n {
      let _ = g.add_node(())
      i = i + 1
    }
    let mut j = 1
    while j < n {
      let _ = g.add_edge(graph::NodeId::new(0), graph::NodeId::new(j), ())
      j = j + 1
    }
    match graph::transitive_reduction(g) {
      Ok(r) => io_println(world, "tred edges=" + r.edge_count().to_string())
      Err(e) => io_println(world, "Err " + graph::graph_error_to_string(e))
    }
    return 0
  }
  if name == "star_remove_hub" {
    let n = 20000
    let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
    let mut i = 0
    while i < n {
      let _ = g.add_node(())
      i = i + 1
    }
    let mut j = 1
    while j < n {
      let _ = g.add_edge(graph::NodeId::new(0), graph::NodeId::new(j), 1L)
      let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new(0), 1L)
      j = j + 1
    }
    let _ = g.remove_node(graph::NodeId::new(0))
    io_println(world, "after hub removal nodes=" + g.node_count().to_string() + " edges=" + g.edge_count().to_string())
    return 0
  }
  io_println(world, "unknown probe")
  2
}
