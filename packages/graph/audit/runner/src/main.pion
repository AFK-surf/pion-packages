///| Red-team differential runner for `packages/graph`.
///|
///|   graph_audit_runner fuzz <seed> <cases>   canonical lines, diffed against audit/rust_oracle
///|   graph_audit_runner stress <mode> <n>     100k-scale crash / stack / complexity probes
///|   graph_audit_runner probe <name>          single robustness probe (may abort: that is evidence)
///|
///| The generator mirrors `rust_oracle/src/main.rs` draw-for-draw.

import "graph"

///|
let HALF : Int64 = 4611686018427387903L

///|
struct Rng {
  mut s : UInt64
}

///|
fn Rng::next(self : Rng) -> UInt64 {
  self.s = self.s * 6364136223846793005UL + 1442695040888963407UL
  self.s >> 33
}

///|
fn Rng::below(self : Rng, m : Int) -> Int {
  (self.next() % m.to_int64().to_uint64()).to_int()
}

///|
struct Gen {
  n : Int
  wkind : Int
  eu : Array[Int]
  ev : Array[Int]
  ew : Array[Int64]
}

///|
fn weight(r : Rng, k : Int) -> Int64 {
  if k == 0 {
    r.below(10).to_int64()
  } else if k == 1 {
    r.below(13).to_int64() - 3L
  } else if k == 2 {
    if r.below(2) == 0 {
      HALF - r.below(3).to_int64()
    } else {
      r.below(10).to_int64()
    }
  } else if k == 3 {
    r.below(2).to_int64()
  } else {
    r.below(1000).to_int64()
  }
}

///|
fn gen(r : Rng) -> Gen {
  let n = if r.below(8) == 0 { 20 + r.below(21) } else { 1 + r.below(10) }
  let m = r.below(3 * n + 1)
  let wkind = r.below(5)
  let eu : Array[Int] = Array::new()
  let ev : Array[Int] = Array::new()
  let ew : Array[Int64] = Array::new()
  let mut pu = 0
  let mut pv = 0
  let mut i = 0
  while i < m {
    if i > 0 && r.below(4) == 0 {
      ()
    } else {
      pu = r.below(n)
      pv = r.below(n)
    }
    let w = weight(r, wkind)
    eu.push(pu)
    ev.push(pv)
    ew.push(w)
    i = i + 1
  }
  Gen::{ n, wkind, eu, ev, ew }
}

///|
fn digraph(g : Gen) -> graph::DiGraph[Unit, Int64] {
  let d : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
  let mut i = 0
  while i < g.n {
    let _ = d.add_node(())
    i = i + 1
  }
  let mut e = 0
  while e < g.eu.length() {
    let _ = d.add_edge(graph::NodeId::new(g.eu[e]), graph::NodeId::new(g.ev[e]), g.ew[e])
    e = e + 1
  }
  d
}

///|
fn ungraph(g : Gen) -> graph::UnGraph[Unit, Int64] {
  let d : graph::UnGraph[Unit, Int64] = graph::UnGraph::new()
  let mut i = 0
  while i < g.n {
    let _ = d.add_node(())
    i = i + 1
  }
  let mut e = 0
  while e < g.eu.length() {
    let _ = d.add_edge(graph::NodeId::new(g.eu[e]), graph::NodeId::new(g.ev[e]), g.ew[e])
    e = e + 1
  }
  d
}

///|
fn sort_i64(a : Array[Int64]) -> Unit {
  let n = a.length()
  let mut i = 1
  while i < n {
    let k = a[i]
    let mut j = i - 1
    while j >= 0 && a[j] > k {
      a[j + 1] = a[j]
      j = j - 1
    }
    a[j + 1] = k
    i = i + 1
  }
}

///|
fn sort_int(a : Array[Int]) -> Unit {
  let n = a.length()
  let mut i = 1
  while i < n {
    let k = a[i]
    let mut j = i - 1
    while j >= 0 && a[j] > k {
      a[j + 1] = a[j]
      j = j - 1
    }
    a[j + 1] = k
    i = i + 1
  }
}

///|
fn join_int(a : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < a.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(a[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn ids(a : Array[graph::NodeId]) -> Array[Int] {
  let out : Array[Int] = Array::new()
  let mut i = 0
  while i < a.length() {
    out.push(a[i].index)
    i = i + 1
  }
  out
}

///|
fn sorted_ids(a : Array[graph::NodeId]) -> String {
  let v = ids(a)
  sort_int(v)
  join_int(v)
}

///| Canonical SCC string (each component sorted, components sorted by smallest member).
fn canon_sccs(s : Array[Array[graph::NodeId]], g : Gen) -> String {
  let comps : Array[Array[Int]] = Array::new()
  let mut i = 0
  while i < s.length() {
    let v = ids(s[i])
    sort_int(v)
    comps.push(v)
    i = i + 1
  }
  // insertion sort by first element
  let mut a = 1
  while a < comps.length() {
    let k = comps[a]
    let mut j = a - 1
    while j >= 0 && comps[j][0] > k[0] {
      comps[j + 1] = comps[j]
      j = j - 1
    }
    comps[j + 1] = k
    a = a + 1
  }
  let sb = StringBuilder::new()
  let mut c = 0
  while c < comps.length() {
    if c > 0 {
      sb.write_string("|")
    }
    sb.write_string(join_int(comps[c]))
    c = c + 1
  }
  // reverse-topological invariant on the raw output order
  let pos : FixedArray[Int] = FixedArray::make(g.n, -1)
  let mut k = 0
  while k < s.length() {
    let mut x = 0
    while x < s[k].length() {
      pos[s[k][x].index] = k
      x = x + 1
    }
    k = k + 1
  }
  let mut inv = true
  let mut e = 0
  while e < g.eu.length() {
    if pos[g.eu[e]] < pos[g.ev[e]] {
      inv = false
    }
    e = e + 1
  }
  sb.write_string(" inv=" + inv.to_string())
  sb.to_string()
}

///|
fn min_w(g : Gen, u : Int, v : Int) -> Option[Int64] {
  let mut best : Option[Int64] = None
  let mut e = 0
  while e < g.eu.length() {
    if g.eu[e] == u && g.ev[e] == v {
      best = match best {
        Some(b) => if g.ew[e] < b { Some(g.ew[e]) } else { Some(b) }
        None => Some(g.ew[e])
      }
    }
    e = e + 1
  }
  best
}

///| Sum of minimum parallel-edge weights along a node path; None if a hop has no edge.
fn path_weight(g : Gen, path : Array[graph::NodeId], closed : Bool) -> Option[Int64] {
  let len = path.length()
  if len == 0 {
    return None
  }
  let hops = if closed { len } else { len - 1 }
  let mut sum = 0L
  let mut i = 0
  while i < hops {
    let a = path[i].index
    let b = path[(i + 1) % len].index
    match min_w(g, a, b) {
      Some(w) => sum = sum + w
      None => return None
    }
    i = i + 1
  }
  Some(sum)
}

///|
fn components(n : Int, eu : Array[Int], ev : Array[Int], skip_edge : Int, skip_node : Int) -> Int {
  let uf = graph::UnionFind::new(n)
  let mut c = if skip_node >= 0 { n - 1 } else { n }
  let mut e = 0
  while e < eu.length() {
    if e != skip_edge && eu[e] != skip_node && ev[e] != skip_node {
      match uf.union(eu[e], ev[e]) {
        Ok(true) => c = c - 1
        _ => ()
      }
    }
    e = e + 1
  }
  c
}

///|
fn dist_list(sp : graph::ShortestPaths, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(",")
    }
    if sp.reachable[i] {
      sb.write_string(sp.distances[i].to_string())
    } else {
      sb.write_string("-")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn err_name(e : graph::GraphError) -> String {
  match e {
    graph::GraphError::NegativeCycle => "negcycle"
    graph::GraphError::WeightOverflow => "overflow"
    _ => "err:" + graph::graph_error_to_string(e)
  }
}

///|
fn edge_list(d : graph::DiGraph[Unit, Unit]) -> String {
  let keys : Array[Int64] = Array::new()
  let mut e = 0
  while e < d.edge_count() {
    match d.edge_endpoints(graph::EdgeId::new(e)) {
      Some((a, b)) => keys.push(a.index.to_int64() * 100000L + b.index.to_int64())
      None => ()
    }
    e = e + 1
  }
  sort_i64(keys)
  let sb = StringBuilder::new()
  let mut i = 0
  let mut first = true
  while i < keys.length() {
    if i == 0 || keys[i] != keys[i - 1] {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string((keys[i] / 100000L).to_string() + ">" + (keys[i] % 100000L).to_string())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Internal-consistency check of DiGraph intrusive lists (bounded walks: a corrupted cycle is reported, not hung on).
fn di_integrity(dg : graph::DiGraph[Unit, Int64]) -> Bool {
  let n = dg.node_count()
  let m = dg.edge_count()
  let seen_out : FixedArray[Int] = FixedArray::make(m, 0)
  let seen_in : FixedArray[Int] = FixedArray::make(m, 0)
  let mut u = 0
  while u < n {
    let mut e = dg.first_out[u]
    let mut steps = 0
    let mut last = -1
    while e != -1 {
      if e < 0 || e >= m || steps > m || dg.edge_src[e] != u {
        return false
      }
      seen_out[e] = seen_out[e] + 1
      last = e
      e = dg.next_out[e]
      steps = steps + 1
    }
    if dg.last_out[u] != last {
      return false
    }
    e = dg.first_in[u]
    steps = 0
    last = -1
    while e != -1 {
      if e < 0 || e >= m || steps > m || dg.edge_dst[e] != u {
        return false
      }
      seen_in[e] = seen_in[e] + 1
      last = e
      e = dg.next_in[e]
      steps = steps + 1
    }
    if dg.last_in[u] != last {
      return false
    }
    u = u + 1
  }
  let mut k = 0
  while k < m {
    if seen_out[k] != 1 || seen_in[k] != 1 {
      return false
    }
    k = k + 1
  }
  true
}

///|
fn un_integrity(ug : graph::UnGraph[Unit, Int64]) -> Bool {
  let n = ug.node_count()
  let m = ug.edge_count()
  let seen : FixedArray[Int] = FixedArray::make(m, 0)
  let mut u = 0
  while u < n {
    let es = ug.edges(graph::NodeId::new(u))
    if es.length() > 2 * m + 1 {
      return false
    }
    let mut i = 0
    while i < es.length() {
      let e = es[i].index
      if e < 0 || e >= m {
        return false
      }
      if ug.edge_u[e] != u && ug.edge_v[e] != u {
        return false
      }
      seen[e] = seen[e] + 1
      i = i + 1
    }
    u = u + 1
  }
  let mut k = 0
  while k < m {
    let want = if ug.edge_u[k] == ug.edge_v[k] { 1 } else { 2 }
    if seen[k] != want {
      return false
    }
    k = k + 1
  }
  true
}

///|
fn find_w(ws : Array[Int64], w : Int64) -> Int {
  let mut i = 0
  while i < ws.length() {
    if ws[i] == w {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn line(world : World, c : Int, sec : String, s : String) -> Unit {
  io_println(world, "c" + c.to_string() + " " + sec + " " + s)
}

///|
fn run_ops(world : World, r : Rng, c : Int) -> Unit {
  let dg : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
  let ug : graph::UnGraph[Unit, Int64] = graph::UnGraph::new()
  let ms : Array[String] = Array::new()
  let lay : Array[String] = Array::new()
  let ord : Array[String] = Array::new()
  let ums : Array[String] = Array::new()
  let ulay : Array[String] = Array::new()
  let mut di_ok = true
  let mut un_ok = true
  let mut step = 0
  while step < 40 {
    let op = r.below(10)
    let nc = dg.node_count()
    let ec = dg.edge_count()
    if op <= 2 {
      let _ = dg.add_node(())
      let _ = ug.add_node(())
    } else if op <= 6 {
      if nc > 0 {
        let u = graph::NodeId::new(r.below(nc))
        let v = graph::NodeId::new(r.below(nc))
        let _ = dg.add_edge(u, v, step.to_int64())
        let _ = ug.add_edge(u, v, step.to_int64())
      }
    } else if op <= 8 {
      if ec > 0 {
        // k-th edge by (unique) weight: same logical edge on both sides regardless of layout
        let k = r.below(ec)
        let ws : Array[Int64] = Array::new()
        let mut q = 0
        while q < ec {
          ws.push(dg.edge_weights[q])
          q = q + 1
        }
        sort_i64(ws)
        let w = ws[k]
        let _ = dg.remove_edge(graph::EdgeId::new(find_w(dg.edge_weights, w)))
        let _ = ug.remove_edge(graph::EdgeId::new(find_w(ug.edge_weights, w)))
      }
    } else if nc > 0 {
      let v = graph::NodeId::new(r.below(nc))
      let _ = dg.remove_node(v)
      let _ = ug.remove_node(v)
    }
    if !di_integrity(dg) {
      di_ok = false
    }
    if !un_integrity(ug) {
      un_ok = false
    }
    // multiset view
    let keys : Array[Int64] = Array::new()
    let m = dg.edge_count()
    let mut e = 0
    while e < m {
      keys.push(
        dg.edge_src[e].to_int64() * 100000000L +
        dg.edge_dst[e].to_int64() * 10000L +
        dg.edge_weights[e],
      )
      e = e + 1
    }
    sort_i64(keys)
    let sb = StringBuilder::new()
    sb.write_string(dg.node_count().to_string() + ":" + m.to_string() + ":")
    let mut i = 0
    while i < keys.length() {
      if i > 0 {
        sb.write_string(",")
      }
      let k = keys[i]
      sb.write_string(
        (k / 100000000L).to_string() + ">" + (k / 10000L % 10000L).to_string() + "=" +
        (k % 10000L).to_string(),
      )
      i = i + 1
    }
    let mut v = 0
    while v < dg.node_count() {
      let id = graph::NodeId::new(v)
      sb.write_string(";" + sorted_ids(dg.neighbors_out(id)) + "<" + sorted_ids(dg.neighbors_in(id)))
      v = v + 1
    }
    ms.push(sb.to_string())
    let lb = StringBuilder::new()
    let mut e2 = 0
    while e2 < m {
      if e2 > 0 {
        lb.write_string(",")
      }
      lb.write_string(
        dg.edge_src[e2].to_string() + ">" + dg.edge_dst[e2].to_string() + "=" +
        dg.edge_weights[e2].to_string(),
      )
      e2 = e2 + 1
    }
    lay.push(lb.to_string())
    let ob = StringBuilder::new()
    let mut v2 = 0
    while v2 < dg.node_count() {
      if v2 > 0 {
        ob.write_string(";")
      }
      ob.write_string(join_int(ids(dg.neighbors_out(graph::NodeId::new(v2)))))
      v2 = v2 + 1
    }
    ord.push(ob.to_string())
    // undirected
    let uk : Array[Int64] = Array::new()
    let um = ug.edge_count()
    let mut f = 0
    while f < um {
      let a = ug.edge_u[f]
      let b = ug.edge_v[f]
      let lo = if a < b { a } else { b }
      let hi = if a < b { b } else { a }
      uk.push(lo.to_int64() * 100000000L + hi.to_int64() * 10000L + ug.edge_weights[f])
      f = f + 1
    }
    sort_i64(uk)
    let ub = StringBuilder::new()
    ub.write_string(ug.node_count().to_string() + ":" + um.to_string() + ":")
    let mut j = 0
    while j < uk.length() {
      if j > 0 {
        ub.write_string(",")
      }
      let k = uk[j]
      ub.write_string(
        (k / 100000000L).to_string() + "-" + (k / 10000L % 10000L).to_string() + "=" +
        (k % 10000L).to_string(),
      )
      j = j + 1
    }
    let mut w = 0
    while w < ug.node_count() {
      ub.write_string(";" + sorted_ids(ug.neighbors(graph::NodeId::new(w))))
      w = w + 1
    }
    ums.push(ub.to_string())
    let ulb = StringBuilder::new()
    let mut f2 = 0
    while f2 < um {
      if f2 > 0 {
        ulb.write_string(",")
      }
      ulb.write_string(
        ug.edge_u[f2].to_string() + "-" + ug.edge_v[f2].to_string() + "=" +
        ug.edge_weights[f2].to_string(),
      )
      f2 = f2 + 1
    }
    ulay.push(ulb.to_string())
    step = step + 1
  }
  line(world, c, "ops_ms", ms.join("/"))
  line(world, c, "ops_lay", lay.join("/"))
  line(world, c, "ops_ord", ord.join("/"))
  line(world, c, "uops_ms", ums.join("/"))
  line(world, c, "uops_lay", ulay.join("/"))
  if !di_ok {
    line(world, c, "ops_integrity", "BROKEN")
  }
  if !un_ok {
    line(world, c, "uops_integrity", "BROKEN")
  }
}

///|
fn run_case(world : World, seed : UInt64, c : Int) -> Unit {
  let r = Rng::{ s: seed ^ ((c + 1).to_int64().to_uint64() * 0x9E3779B97F4A7C15UL) }
  let _ = r.next()
  let _ = r.next()
  let g = gen(r)
  let ugen = gen(r)
  let dag_src = gen(r)
  let n = g.n
  let d = digraph(g)

  run_ops(world, r, c)

  // SCC
  line(world, c, "scc", canon_sccs(graph::tarjan_scc(d), g))
  line(world, c, "kscc", canon_sccs(graph::kosaraju_scc(d), g))

  // toposort / cycles
  let on_cycle : FixedArray[Bool] = FixedArray::make(n, false)
  let tsccs = graph::tarjan_scc(d)
  let mut si = 0
  while si < tsccs.length() {
    if tsccs[si].length() > 1 {
      let mut x = 0
      while x < tsccs[si].length() {
        on_cycle[tsccs[si][x].index] = true
        x = x + 1
      }
    }
    si = si + 1
  }
  let mut le = 0
  while le < g.eu.length() {
    if g.eu[le] == g.ev[le] {
      on_cycle[g.eu[le]] = true
    }
    le = le + 1
  }
  let topo = match graph::toposort(d) {
    Ok(o) => {
      let pos : FixedArray[Int] = FixedArray::make(n, 0)
      let mut i = 0
      while i < o.length() {
        pos[o[i].index] = i
        i = i + 1
      }
      let mut valid = o.length() == n
      let mut e = 0
      while e < g.eu.length() {
        if pos[g.eu[e]] >= pos[g.ev[e]] {
          valid = false
        }
        e = e + 1
      }
      "ok valid=" + valid.to_string()
    }
    Err(graph::GraphError::HasCycle(node)) =>
    "cycle node_on_cycle=" + on_cycle[node.index].to_string()
    Err(e) => err_name(e)
  }
  line(world, c, "topo", "cyclic=" + graph::is_cyclic(d).to_string() + " " + topo)

  // dominators + library dominance frontiers
  match graph::dominators(d, graph::NodeId::new(0)) {
    Ok(dm) => {
      let idom : Array[Int] = Array::new()
      let mut v = 0
      while v < n {
        idom.push(dm.idom[v])
        v = v + 1
      }
      line(world, c, "dom", join_int(idom))
      let df = dm.dominance_frontiers(d)
      let parts : Array[String] = Array::new()
      let mut x = 0
      while x < n {
        parts.push(sorted_ids(df[x]))
        x = x + 1
      }
      line(world, c, "df", parts.join("|"))
    }
    Err(e) => line(world, c, "dom", err_name(e))
  }

  let small_nonneg = g.wkind == 0 || g.wkind == 3 || g.wkind == 4
  if small_nonneg {
    let s = match graph::dijkstra_i64(d, graph::NodeId::new(0), None) {
      Ok(sp) => dist_list(sp, n)
      Err(e) => err_name(e)
    }
    line(world, c, "dij", s)
  }
  if g.wkind != 2 {
    let s = match graph::bellman_ford(d, graph::NodeId::new(0), fn(w) { w }) {
      Ok(sp) => dist_list(sp, n)
      Err(e) => err_name(e)
    }
    line(world, c, "bf", s)
    let nc = match graph::find_negative_cycle(d, graph::NodeId::new(0), fn(w) { w }) {
      Ok(Some(cyc)) => {
        let valid = match path_weight(g, cyc, true) {
          Some(w) => w < 0L
          None => false
        }
        if valid {
          "some valid=true"
        } else {
          "some valid=false cyc=" + join_int(ids(cyc))
        }
      }
      Ok(None) => "none"
      Err(e) => err_name(e)
    }
    line(world, c, "negcyc", nc)
  }
  // Floyd-Warshall (all weight kinds, including Int64::MAX / 2)
  let fw = match graph::floyd_warshall(d, fn(w) { w }) {
    Ok(ap) => {
      let sb = StringBuilder::new()
      let mut i = 0
      while i < n * n {
        if i > 0 {
          sb.write_string(",")
        }
        if ap.reachable[i] {
          sb.write_string(ap.distances[i].to_string())
        } else {
          sb.write_string("-")
        }
        i = i + 1
      }
      sb.to_string()
    }
    Err(e) => err_name(e)
  }
  line(world, c, "fw", fw)

  // A* with admissible but inconsistent heuristic h(v) = floor(dist(v, goal) * r / 4)
  let goal = n - 1
  let h : FixedArray[Int64] = FixedArray::make(n, 0L)
  let rr : FixedArray[Int] = FixedArray::make(n, 0)
  let mut hv = 0
  while hv < n {
    rr[hv] = r.below(5)
    hv = hv + 1
  }
  if small_nonneg {
    // exact distances to goal by naive Bellman-Ford on the reverse graph (no library code)
    let td : FixedArray[Int64] = FixedArray::make(n, -1L)
    td[goal] = 0L
    let mut changed = true
    while changed {
      changed = false
      let mut e = 0
      while e < g.eu.length() {
        let a = g.eu[e]
        let b = g.ev[e]
        if td[b] >= 0L {
          let cand = td[b] + g.ew[e]
          if td[a] < 0L || cand < td[a] {
            td[a] = cand
            changed = true
          }
        }
        e = e + 1
      }
    }
    let mut v = 0
    while v < n {
      if td[v] >= 0L {
        h[v] = td[v] * rr[v].to_int64() / 4L
      }
      v = v + 1
    }
    let res = graph::astar(
      d,
      graph::NodeId::new(0),
      fn(x) { x.index == goal },
      fn(w) { w },
      fn(x) { h[x.index] },
    )
    let s = match res {
      Ok(Some(ar)) => {
        let ok = match path_weight(g, ar.path, false) {
          Some(w) => w == ar.cost && ar.path[0].index == 0 && ar.path[ar.path.length() - 1].index == goal
          None => ar.path.length() == 1 && goal == 0 && ar.cost == 0L
        }
        "cost=" + ar.cost.to_string() + " path_ok=" + ok.to_string()
      }
      Ok(None) => "none"
      Err(e) => err_name(e)
    }
    line(world, c, "astar", s)
  }

  // MST
  let u = ungraph(ugen)
  let ks = match graph::kruskal_mst_i64(u) {
    Ok(mr) => mr.total_weight.to_string() + "/" + mr.edges.length().to_string()
    Err(e) => err_name(e)
  }
  line(world, c, "mst", ks)
  let ps = match graph::prim_mst(u, fn(w) { w }) {
    Ok(mr) => mr.total_weight.to_string() + "/" + mr.edges.length().to_string()
    Err(e) => err_name(e)
  }
  line(world, c, "mst_prim", ps)

  // Max flow with certificate (capacity, conservation, cut == flow, no residual s->t path)
  if n >= 2 {
    let t = n - 1
    let fl = match graph::dinic_max_flow(d, graph::NodeId::new(0), graph::NodeId::new(t), fn(w) {
      if w < 0L {
        0L
      } else {
        w
      }
    }) {
      Ok(mf) => {
        let mut cert = mf.source_side[0] && !mf.source_side[t]
        let bal : FixedArray[Int64] = FixedArray::make(n, 0L)
        let mut cut = 0L
        let mut e = 0
        while e < g.eu.length() {
          let cap = if g.ew[e] < 0L { 0L } else { g.ew[e] }
          let f = mf.edge_flows[e]
          if f < 0L || f > cap {
            cert = false
          }
          bal[g.eu[e]] = bal[g.eu[e]] - f
          bal[g.ev[e]] = bal[g.ev[e]] + f
          let su = mf.source_side[g.eu[e]]
          let sv = mf.source_side[g.ev[e]]
          if su && !sv {
            if f != cap {
              cert = false
            }
            cut = cut + cap
          }
          if !su && sv && f != 0L {
            cert = false
          }
          e = e + 1
        }
        let mut v = 0
        while v < n {
          if v != 0 && v != t && bal[v] != 0L {
            cert = false
          }
          v = v + 1
        }
        if bal[t] != mf.max_flow || cut != mf.max_flow {
          cert = false
        }
        mf.max_flow.to_string() + " cert=" + cert.to_string()
      }
      Err(e) => err_name(e)
    }
    line(world, c, "flow", fl)
  }

  // Bridges / articulation points
  let brs = graph::bridges(u)
  let bi : Array[Int] = Array::new()
  let mut b = 0
  while b < brs.length() {
    bi.push(brs[b].index)
    b = b + 1
  }
  sort_int(bi)
  line(world, c, "br", join_int(bi))
  line(world, c, "ap", sorted_ids(graph::articulation_points(u)))

  // Transitive reduction / closure on a DAG
  let dd : graph::DiGraph[Unit, Unit] = graph::DiGraph::new()
  let mut k = 0
  while k < dag_src.n {
    let _ = dd.add_node(())
    k = k + 1
  }
  let mut de = 0
  while de < dag_src.eu.length() {
    let a = dag_src.eu[de]
    let bb = dag_src.ev[de]
    if a != bb {
      let lo = if a < bb { a } else { bb }
      let hi = if a < bb { bb } else { a }
      let _ = dd.add_edge(graph::NodeId::new(lo), graph::NodeId::new(hi), ())
    }
    de = de + 1
  }
  match graph::transitive_reduction(dd) {
    Ok(red) => line(world, c, "tred", edge_list(red))
    Err(e) => line(world, c, "tred", err_name(e))
  }
  match graph::transitive_closure(dd) {
    Ok(clo) => line(world, c, "tclo", edge_list(clo))
    Err(e) => line(world, c, "tclo", err_name(e))
  }
  let _ = components(0, Array::new(), Array::new(), -1, -1)
}

///|
fn parse_i64(s : String) -> Int64 {
  let mut i = 0
  let mut neg = false
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut acc = 0L
  while i < s.length() {
    acc = acc * 10L + (s.code_unit_at(i) - 48).to_int64()
    i = i + 1
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 4 && args[1] == "fuzz" {
    let seed = parse_i64(args[2]).to_uint64()
    let cases = parse_i64(args[3]).to_int()
    let mut c = 0
    while c < cases {
      run_case(world, seed, c)
      c = c + 1
    }
    return 0
  }
  if args.length() >= 4 && args[1] == "stress" {
    return stress(world, args[2], parse_i64(args[3]).to_int())
  }
  if args.length() >= 3 && args[1] == "probe" {
    return probe(world, args[2])
  }
  io_println(world, "usage: graph_audit_runner fuzz <seed> <cases> | stress <mode> <n> | probe <name>")
  2
}
