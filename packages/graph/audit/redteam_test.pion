///| Red-team regression tests for packages/graph @ a38f2c2 (branch feat/pkg-graph).
///
/// `p1_*` / `p2_*` tests assert the behaviour of the upstream reference (Rust petgraph =0.8.3, or the
/// textbook definition where petgraph has no such API) -- a FAILURE here is the evidence (REPORT.md, F-ids).
/// Every expected value was produced by petgraph 0.8.3 or by a brute-force oracle (see
/// rust_oracle/ and fuzz.py; the petgraph outputs are reproduced in REPORT.md).
/// `ctl_*` tests are attacks Pion survives (several of them break petgraph itself); they must keep passing.
/// Crash / memory probes that cannot live in a unit test are run by ./run_audit.sh.
///
/// Run: pionc test --json packages/graph/audit

import "graph"

///|
let HALF : Int64 = 4611686018427387903L

///|
fn di(n : Int, edges : Array[(Int, Int, Int64)]) -> graph::DiGraph[Unit, Int64] {
  let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::new()
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut e = 0
  while e < edges.length() {
    let (u, v, w) = edges[e]
    let _ = g.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), w)
    e = e + 1
  }
  g
}

///|
fn un(n : Int, edges : Array[(Int, Int, Int64)]) -> graph::UnGraph[Unit, Int64] {
  let g : graph::UnGraph[Unit, Int64] = graph::UnGraph::new()
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut e = 0
  while e < edges.length() {
    let (u, v, w) = edges[e]
    let _ = g.add_edge(graph::NodeId::new(u), graph::NodeId::new(v), w)
    e = e + 1
  }
  g
}

///|
fn ids(a : Array[graph::NodeId]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < a.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(a[i].index.to_string())
    i = i + 1
  }
  sb.to_string()
}

///| Option[Int64] -> Int64 (None = -1 sentinel is never a valid expected value below).
fn oi(o : Option[Int64]) -> Int64 {
  match o {
    Some(x) => x
    None => -1L
  }
}

///| Option[NodeId] -> raw index (-1 for None).
fn on(o : Option[graph::NodeId]) -> Int {
  match o {
    Some(x) => x.index
    None => -1
  }
}

///|
fn err_str(e : graph::GraphError) -> String {
  graph::graph_error_to_string(e)
}

// ---------------------------------------------------------------------------------------------
// P1 -- wrong answers on valid input where petgraph / the definition is right
// ---------------------------------------------------------------------------------------------

///| F1. A* never re-opens a closed node. With an admissible but inconsistent heuristic it returns a
///| suboptimal cost, and the reported cost does not even match the returned path (cost 15, path weight 12).
///| petgraph 0.8.3 `astar` on the same input: Some((12, [0, 2, 3, 4])).
test "p1_astar_admissible_inconsistent_heuristic_is_optimal" {
  // 0->1 (1), 1->3 (4), 0->2 (1), 2->3 (1), 3->4 (10); h = [0, 0, 10, 0, 0]  (h(2)=10 <= dist(2,4)=11)
  let g = di(5, [(0, 1, 1L), (1, 3, 4L), (0, 2, 1L), (2, 3, 1L), (3, 4, 10L)])
  let h : FixedArray[Int64] = [0L, 0L, 10L, 0L, 0L]
  match graph::astar(g, graph::NodeId::new(0), fn(x) { x.index == 4 }, fn(w) { w }, fn(x) { h[x.index] }) {
    Ok(Some(r)) => {
      debug_assert(r.cost == 12L, "A* cost: petgraph 12, pion " + r.cost.to_string())
      debug_assert(ids(r.path) == "0,2,3,4", "A* path: petgraph 0,2,3,4, pion " + ids(r.path))
    }
    Ok(None) => debug_assert(false, "A*: goal reachable, got None")
    Err(e) => debug_assert(false, "A*: " + err_str(e))
  }
}

///| F2. dominance_frontiers drops every frontier entry whose target is the entry node: the CHK
///| "join point needs >= 2 preds" shortcut assumes the entry has no predecessors. A loop back to the
///| entry (`0 -> 1 -> 0`) must give DF(1) = {0} and DF(0) = {0} (Cytron et al. definition: x dominates a
///| predecessor of y and does not strictly dominate y). Found in 1211 / 3000 random graphs by fuzz.py.
test "p1_dominance_frontier_back_edge_to_entry" {
  let g = di(2, [(0, 1, 0L), (1, 0, 0L)])
  match graph::dominators(g, graph::NodeId::new(0)) {
    Ok(d) => {
      let df = d.dominance_frontiers(g)
      debug_assert(ids(df[0]) == "0", "DF(0) want {0}, got {" + ids(df[0]) + "}")
      debug_assert(ids(df[1]) == "0", "DF(1) want {0}, got {" + ids(df[1]) + "}")
    }
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| F2b. Same defect with a self-loop on the entry (DF(0) = {0}).
test "p1_dominance_frontier_entry_self_loop" {
  let g = di(2, [(0, 0, 0L), (0, 1, 0L)])
  match graph::dominators(g, graph::NodeId::new(0)) {
    Ok(d) => {
      let df = d.dominance_frontiers(g)
      debug_assert(ids(df[0]) == "0", "DF(0) want {0}, got {" + ids(df[0]) + "}")
    }
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| F3. floyd_warshall aborts the whole computation with WeightOverflow as soon as any *candidate*
///| `d[i][k] + d[k][j]` overflows, even when every true shortest distance fits in Int64.
///| petgraph 0.8.3 skips overflowing candidates and returns d02=5, d01=MAX-10, d12=100.
test "p1_floyd_warshall_overflowing_candidate_is_not_an_error" {
  let g = di(3, [(0, 1, 9223372036854775797L), (1, 2, 100L), (0, 2, 5L)])
  match graph::floyd_warshall(g, fn(w) { w }) {
    Ok(ap) => {
      let d02 = ap.distance(graph::NodeId::new(0), graph::NodeId::new(2))
      debug_assert(oi(d02) == 5L, "d(0,2) want 5")
    }
    Err(e) => debug_assert(false, "petgraph returns Ok(d02=5); pion: " + err_str(e))
  }
}

// ---------------------------------------------------------------------------------------------
// P2 -- wrong error classification / misleading diagnostics / layout incompatibility
// ---------------------------------------------------------------------------------------------

///| F4. toposort's HasCycle(node) names the lowest-index node with indegree > 0, which may merely be
///| *downstream* of a cycle (node 0 here; the cycle is 1 <-> 2). petgraph's Cycle(node) is always on a
///| cycle. 1430 / 10000 random cyclic graphs hit this in fuzz.py.
test "p2_toposort_cycle_node_is_on_a_cycle" {
  let g = di(3, [(1, 0, 0L), (1, 2, 0L), (2, 1, 0L)])
  match graph::toposort(g) {
    Err(graph::GraphError::HasCycle(n)) =>
    debug_assert(n.index == 1 || n.index == 2, "HasCycle names node " + n.index.to_string() + ", not on the 1<->2 cycle")
    _ => debug_assert(false, "expected HasCycle")
  }
}

///| F5. Bellman-Ford with a reachable negative cycle of large weights reports WeightOverflow instead of
///| NegativeCycle (the overflow check fires while the cycle is being relaxed).
test "p2_bellman_ford_large_negative_cycle_is_negative_cycle" {
  let g = di(2, [(0, 1, 0L - HALF), (1, 0, 0L - HALF)])
  match graph::bellman_ford(g, graph::NodeId::new(0), fn(w) { w }) {
    Err(graph::GraphError::NegativeCycle) => ()
    Err(e) => debug_assert(false, "want NegativeCycle, got " + err_str(e))
    Ok(_) => debug_assert(false, "want NegativeCycle, got Ok")
  }
  match graph::find_negative_cycle(g, graph::NodeId::new(0), fn(w) { w }) {
    Ok(Some(c)) => debug_assert(c.length() == 2, "cycle " + ids(c))
    Ok(None) => debug_assert(false, "find_negative_cycle: missed the cycle")
    Err(e) => debug_assert(false, "find_negative_cycle: want the 0<->1 cycle, got " + err_str(e))
  }
}

///| F5b. Same for floyd_warshall: a large negative cycle is reported as WeightOverflow.
test "p2_floyd_warshall_large_negative_cycle_is_negative_cycle" {
  let g = di(2, [(0, 1, 0L - HALF), (1, 0, 0L - HALF)])
  match graph::floyd_warshall(g, fn(w) { w }) {
    Err(graph::GraphError::NegativeCycle) => ()
    Err(e) => debug_assert(false, "want NegativeCycle, got " + err_str(e))
    Ok(_) => debug_assert(false, "want NegativeCycle, got Ok")
  }
}

///| F6. Dijkstra returns Err(WeightOverflow) when a *non-improving* relaxation overflows, although the
///| exact answer (d2 = 5) is representable. petgraph 0.8.3 (release) returns d2 = 5 here (it skips the
///| already-settled node); in debug it panics -- so this is a robustness gap, not a regression vs debug.
test "p2_dijkstra_non_improving_overflow_is_not_an_error" {
  let g = di(3, [(0, 1, 9223372036854775797L), (1, 2, 100L), (0, 2, 5L)])
  match graph::dijkstra_i64(g, graph::NodeId::new(0), None) {
    Ok(sp) => debug_assert(oi(sp.distance(graph::NodeId::new(2))) == 5L, "d2 want 5")
    Err(e) => debug_assert(false, "want d2=5, got " + err_str(e))
  }
}

///| F7. remove_node unlinks incident edges oldest-first, petgraph newest-first, so EdgeIds diverge from
///| petgraph's after the swap-removes (README promises "petgraph::Graph-style swap-remove reindexing").
///| petgraph 0.8.3 after remove_node(0): [e0 = 0->0 (w2), e1 = 0->1 (w3)].
test "p2_remove_node_edge_index_layout_matches_petgraph" {
  let g = di(3, [(1, 0, 0L), (1, 0, 1L), (2, 2, 2L), (2, 1, 3L)])
  let _ = g.remove_node(graph::NodeId::new(0))
  debug_assert(g.edge_count() == 2, "edge_count")
  debug_assert(oi(g.edge_weight(graph::EdgeId::new(0))) == 2L, "EdgeId(0) should be the old 2->2 self-loop (w=2)")
  debug_assert(oi(g.edge_weight(graph::EdgeId::new(1))) == 3L, "EdgeId(1) should be the old 2->1 edge (w=3)")
}

///| F8. Neighbour iteration order is the reverse of petgraph's (petgraph yields newest edge first:
///| neighbors(0) = [2, 1]); every traversal order (BFS/DFS/SCC member order) differs accordingly.
///| Documented in README ("insertion order"), listed here as a compatibility gap.
test "p2_neighbor_order_matches_petgraph" {
  let g = di(3, [(0, 1, 0L), (0, 2, 0L)])
  debug_assert(ids(g.neighbors_out(graph::NodeId::new(0))) == "2,1", "petgraph order 2,1; pion " + ids(g.neighbors_out(graph::NodeId::new(0))))
}

// ---------------------------------------------------------------------------------------------
// Controls -- attacks Pion survives (several break petgraph 0.8.3)
// ---------------------------------------------------------------------------------------------

///| petgraph `bridges` reports both parallel edges 0=1 as bridges ([0, 1]); correct answer: none.
test "ctl_bridges_parallel_edges_beats_petgraph" {
  let g = un(2, [(0, 1, 0L), (0, 1, 0L)])
  debug_assert(graph::bridges(g).length() == 0, "parallel edges are never bridges")
  let g2 = un(3, [(0, 1, 0L), (1, 2, 0L), (1, 2, 0L), (2, 2, 0L)])
  let b = graph::bridges(g2)
  debug_assert(b.length() == 1 && b[0].index == 0, "only 0-1 is a bridge")
}

///| petgraph `floyd_warshall` overwrites d[i][i] with 0 after loading edges and misses a negative self-loop.
test "ctl_floyd_negative_self_loop_beats_petgraph" {
  let g = di(1, [(0, 0, -1L)])
  match graph::floyd_warshall(g, fn(w) { w }) {
    Err(graph::GraphError::NegativeCycle) => ()
    _ => debug_assert(false, "negative self-loop must be a NegativeCycle")
  }
}

///| petgraph `floyd_warshall` turns "unreachable" (i64::MAX) + negative edge into a finite MAX-3.
test "ctl_floyd_unreachable_stays_unreachable_with_negative_edges" {
  let g = di(3, [(0, 1, -3L)])
  match graph::floyd_warshall(g, fn(w) { w }) {
    Ok(ap) => {
      debug_assert(oi(ap.distance(graph::NodeId::new(2), graph::NodeId::new(1))) == -1L, "2 cannot reach 1")
      debug_assert(oi(ap.distance(graph::NodeId::new(0), graph::NodeId::new(1))) == -3L, "d01")
    }
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| petgraph `min_spanning_tree_prim` only spans the component of the first node (1 edge here).
test "ctl_prim_spans_whole_forest_beats_petgraph" {
  let g = un(4, [(0, 1, 1L), (2, 3, 2L)])
  match graph::prim_mst(g, fn(w) { w }) {
    Ok(r) => debug_assert(r.edges.length() == 2 && r.total_weight == 3L, "forest of 2 edges, weight 3")
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| petgraph `find_negative_cycle` returns [0] (no 0->0 edge exists) on this graph; the real cycle is 3->3.
test "ctl_find_negative_cycle_is_a_real_cycle_beats_petgraph" {
  let g = di(4, [(2, 0, 4L), (1, 0, 6L), (3, 3, -2L), (2, 3, 1L), (3, 2, -1L), (0, 3, 0L)])
  match graph::find_negative_cycle(g, graph::NodeId::new(0), fn(w) { w }) {
    Ok(Some(c)) => {
      // every hop must be an edge and the sum negative
      let mut sum = 0L
      let mut i = 0
      while i < c.length() {
        let a = c[i]
        let b = c[(i + 1) % c.length()]
        match g.find_edge(a, b) {
          Some(e) =>
          match g.edge_weight(e) {
            Some(w) => sum = sum + w
            None => debug_assert(false, "edge weight")
          }
          None => debug_assert(false, "hop " + a.index.to_string() + "->" + b.index.to_string() + " is not an edge")
        }
        i = i + 1
      }
      debug_assert(sum < 0L, "cycle weight must be negative")
    }
    _ => debug_assert(false, "negative cycle exists")
  }
}

///| petgraph `dinics` on u64 silently wraps: 4 parallel ~2^62 edges give max flow 7 in release.
test "ctl_dinic_huge_capacity_reports_overflow_not_wrapped_value" {
  let g = di(2, [(0, 1, HALF), (0, 1, HALF), (0, 1, HALF), (0, 1, HALF)])
  match graph::dinic_max_flow(g, graph::NodeId::new(0), graph::NodeId::new(1), fn(w) { w }) {
    Err(graph::GraphError::WeightOverflow) => ()
    Ok(r) => debug_assert(false, "flow would need 2^64; got " + r.max_flow.to_string())
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| Dinic on antiparallel + parallel + zero-capacity + self-loop edges; negative capacity rejected; s == t.
test "ctl_dinic_pathological_edges" {
  let g = di(4, [(0, 1, 5L), (1, 0, 5L), (0, 1, 0L), (1, 1, 9L), (1, 3, 3L), (0, 2, 4L), (2, 3, 4L), (2, 1, 2L)])
  match graph::dinic_max_flow(g, graph::NodeId::new(0), graph::NodeId::new(3), fn(w) { w }) {
    Ok(r) => debug_assert(r.max_flow == 7L, "max flow 7, got " + r.max_flow.to_string())
    Err(e) => debug_assert(false, err_str(e))
  }
  let bad = di(2, [(0, 1, -1L)])
  match graph::dinic_max_flow(bad, graph::NodeId::new(0), graph::NodeId::new(1), fn(w) { w }) {
    Err(graph::GraphError::NegativeCapacity(_)) => ()
    _ => debug_assert(false, "negative capacity must be rejected")
  }
  match graph::dinic_max_flow(g, graph::NodeId::new(2), graph::NodeId::new(2), fn(w) { w }) {
    Ok(r) => debug_assert(r.max_flow == 0L, "s == t")
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| Swap-remove churn: remove the node that carries a self-loop and parallel edges to/from the last node.
test "ctl_remove_node_self_loop_and_parallel_last_node" {
  let g = di(4, [(3, 3, 0L), (3, 1, 1L), (1, 3, 2L), (1, 3, 3L), (0, 3, 4L), (3, 0, 5L), (2, 2, 6L)])
  let _ = g.remove_node(graph::NodeId::new(1))
  // node 3 moved into slot 1
  debug_assert(g.node_count() == 3 && g.edge_count() == 4, "counts")
  debug_assert(ids(g.neighbors_out(graph::NodeId::new(1))) == "1,0", "moved node keeps self-loop and 1->0")
  debug_assert(ids(g.neighbors_in(graph::NodeId::new(1))) == "1,0", "in: self-loop, 0->1")
  let _ = g.remove_node(graph::NodeId::new(2))
  let _ = g.remove_node(graph::NodeId::new(1))
  debug_assert(g.node_count() == 1 && g.edge_count() == 0, "only node 0, no edges")
  let u = un(3, [(2, 2, 0L), (2, 0, 1L), (0, 2, 2L), (1, 2, 3L)])
  let _ = u.remove_node(graph::NodeId::new(0))
  debug_assert(u.node_count() == 2 && u.edge_count() == 2, "undirected counts")
  debug_assert(u.degree(graph::NodeId::new(0)) == 2, "moved node 0: self-loop + edge to 1")
}

///| Dominators on an irreducible CFG (two entries into the 1<->2 loop) with an unreachable node.
test "ctl_dominators_irreducible_and_unreachable" {
  let g = di(5, [(0, 1, 0L), (0, 2, 0L), (1, 2, 0L), (2, 1, 0L), (1, 3, 0L), (2, 3, 0L), (4, 3, 0L)])
  match graph::dominators(g, graph::NodeId::new(0)) {
    Ok(d) => {
      debug_assert(on(d.immediate_dominator(graph::NodeId::new(1))) == 0, "idom 1")
      debug_assert(on(d.immediate_dominator(graph::NodeId::new(2))) == 0, "idom 2")
      debug_assert(on(d.immediate_dominator(graph::NodeId::new(3))) == 0, "idom 3")
      debug_assert(on(d.immediate_dominator(graph::NodeId::new(4))) == -1, "4 unreachable")
      let df = d.dominance_frontiers(g)
      debug_assert(ids(df[1]) == "2,3" && ids(df[2]) == "1,3", "DF of the irreducible loop")
    }
    Err(e) => debug_assert(false, err_str(e))
  }
}

///| DOT export escapes quotes / backslashes / CR / LF / NUL and keeps astral-plane characters intact.
test "ctl_dot_escaping" {
  let g : graph::DiGraph[String, String] = graph::DiGraph::new()
  let a = g.add_node("a\"b\\c\nd\re\u{0}f</script>")
  let b = g.add_node("😀 é")
  let _ = g.add_edge(a, b, "x\"y")
  let dot = graph::digraph_to_dot(g, fn(_i, s) { s }, fn(_i, s) { s })
  debug_assert(dot.contains("a\\\"b\\\\c\\nd\\re\\x00f</script>"), "escaped label: " + dot)
  debug_assert(dot.contains("😀 é"), "astral chars preserved")
  debug_assert(dot.contains("x\\\"y"), "edge label escaped")
  // no raw control characters at all inside the document body
  let mut i = 0
  let mut raw = 0
  while i < dot.length() {
    let cu = dot.code_unit_at(i)
    if cu < 32 && cu != 10 {
      raw = raw + 1
    }
    i = i + 1
  }
  debug_assert(raw == 0, "raw control characters in DOT")
}

///| 100k-node cycle: one giant SCC, deep Tarjan/Kosaraju/dominator stacks, Dinic on a ring -- no recursion.
test "ctl_100k_cycle_no_stack_overflow" {
  let n = 100000
  let g : graph::DiGraph[Unit, Int64] = graph::DiGraph::with_capacity(n, n)
  let mut i = 0
  while i < n {
    let _ = g.add_node(())
    i = i + 1
  }
  let mut j = 0
  while j < n {
    let _ = g.add_edge(graph::NodeId::new(j), graph::NodeId::new((j + 1) % n), 1L)
    j = j + 1
  }
  debug_assert(graph::tarjan_scc(g).length() == 1, "tarjan one SCC")
  debug_assert(graph::kosaraju_scc(g).length() == 1, "kosaraju one SCC")
  match graph::dominators(g, graph::NodeId::new(0)) {
    Ok(d) => {
      debug_assert(on(d.immediate_dominator(graph::NodeId::new(n - 1))) == n - 2, "idom chain")
    }
    Err(e) => debug_assert(false, err_str(e))
  }
  match graph::dinic_max_flow(g, graph::NodeId::new(0), graph::NodeId::new(n / 2), fn(w) { w }) {
    Ok(r) => debug_assert(r.max_flow == 1L, "ring flow 1")
    Err(e) => debug_assert(false, err_str(e))
  }
  match graph::find_cycle(g) {
    Some(c) => debug_assert(c.length() == n, "whole ring is the cycle")
    None => debug_assert(false, "cycle")
  }
}
