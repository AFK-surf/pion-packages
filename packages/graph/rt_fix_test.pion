///| Wave 8 red-team fix regression tests (F1-F10, toposort_any, size guards, O(V+E) transitive_reduction).

///|
test "rt_fix_f1_astar_reopens_closed_nodes_for_inconsistent_heuristic" {
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let mut i = 0
  while i < 5 {
    let _ = g.add_node(())
    i = i + 1
  }
  let _ = g.add_edge(NodeId::new(0), NodeId::new(1), 1L)
  let _ = g.add_edge(NodeId::new(1), NodeId::new(3), 4L)
  let _ = g.add_edge(NodeId::new(0), NodeId::new(2), 1L)
  let _ = g.add_edge(NodeId::new(2), NodeId::new(3), 1L)
  let _ = g.add_edge(NodeId::new(3), NodeId::new(4), 10L)
  let h : FixedArray[Int64] = [0L, 0L, 10L, 0L, 0L]
  match astar(g, NodeId::new(0), fn(x) { x.index == 4 }, fn(w) { w }, fn(x) { h[x.index] }) {
    Ok(Some(r)) => {
      debug_assert(r.cost == 12L, "F1: optimal cost 12")
      debug_assert(
        r.path.length() == 4 &&
        r.path[0].index == 0 &&
        r.path[1].index == 2 &&
        r.path[2].index == 3 &&
        r.path[3].index == 4,
        "F1: optimal path 0->2->3->4",
      )
    }
    _ => debug_assert(false, "F1: expected Some(12)")
  }
}

///|
test "rt_fix_f2_dominance_frontiers_entry_back_edge_and_self_loop" {
  let g1 : DiGraph[Unit, Unit] = DiGraph::new()
  let a = g1.add_node(())
  let b = g1.add_node(())
  let _ = g1.add_edge(a, b, ())
  let _ = g1.add_edge(b, a, ())
  match dominators(g1, a) {
    Ok(d) => {
      let df = d.dominance_frontiers(g1)
      debug_assert(df[0].length() == 1 && df[0][0].index == 0, "F2: DF(0) == {0}")
      debug_assert(df[1].length() == 1 && df[1][0].index == 0, "F2: DF(1) == {0}")
    }
    Err(_) => debug_assert(false, "F2: dominators failed")
  }

  let g2 : DiGraph[Unit, Unit] = DiGraph::new()
  let r = g2.add_node(())
  let s = g2.add_node(())
  let _ = g2.add_edge(r, r, ())
  let _ = g2.add_edge(r, s, ())
  match dominators(g2, r) {
    Ok(d) => {
      let df = d.dominance_frontiers(g2)
      debug_assert(df[0].length() == 1 && df[0][0].index == 0, "F2b: DF(0) == {0}")
      debug_assert(df[1].length() == 0, "F2b: DF(1) == {}")
    }
    Err(_) => debug_assert(false, "F2b: dominators failed")
  }
}

///|
test "rt_fix_f3_f7_f8_overflow_and_large_negative_cycles" {
  // Non-improving overflow in Floyd-Warshall & Dijkstra
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let _ = g.add_edge(n0, n1, MAX_I64 - 10L)
  let _ = g.add_edge(n1, n2, 100L)
  let _ = g.add_edge(n0, n2, 5L)

  match floyd_warshall(g, fn(w) { w }) {
    Ok(ap) =>
    match ap.distance(n0, n2) {
      Some(d) => debug_assert(d == 5L, "F3: floyd d(0,2) == 5")
      None => debug_assert(false, "F3: floyd d(0,2) missing")
    }
    Err(_) => debug_assert(false, "F3: floyd must ignore non-improving overflow")
  }
  match dijkstra_i64(g, n0, None) {
    Ok(sp) =>
    match sp.distance(n2) {
      Some(d) => debug_assert(d == 5L, "F8: dijkstra d(0,2) == 5")
      None => debug_assert(false, "F8: dijkstra d(0,2) missing")
    }
    Err(_) => debug_assert(false, "F8: dijkstra must ignore non-improving overflow")
  }
  let csr = CsrGraph::from_digraph(g)
  match csr_dijkstra(csr, n0, None) {
    Ok(sp) =>
    match sp.distance(n2) {
      Some(d) => debug_assert(d == 5L, "F8: csr_dijkstra d(0,2) == 5")
      None => debug_assert(false, "F8: csr_dijkstra d(0,2) missing")
    }
    Err(_) => debug_assert(false, "F8: csr_dijkstra must ignore non-improving overflow")
  }

  // F7: Large negative cycle must report NegativeCycle, not WeightOverflow
  let half : Int64 = 4611686018427387903L
  let g_neg : DiGraph[Unit, Int64] = DiGraph::new()
  let a = g_neg.add_node(())
  let b = g_neg.add_node(())
  let _ = g_neg.add_edge(a, b, 0L - half)
  let _ = g_neg.add_edge(b, a, 0L - half)
  match bellman_ford(g_neg, a, fn(w) { w }) {
    Err(NegativeCycle) => ()
    _ => debug_assert(false, "F7: bellman_ford large neg cycle")
  }
  match find_negative_cycle(g_neg, a, fn(w) { w }) {
    Ok(Some(c)) => debug_assert(c.length() == 2, "F7: find_negative_cycle len 2")
    _ => debug_assert(false, "F7: find_negative_cycle missed large neg cycle")
  }
  match floyd_warshall(g_neg, fn(w) { w }) {
    Err(NegativeCycle) => ()
    _ => debug_assert(false, "F7: floyd_warshall large neg cycle")
  }
}

///|
test "rt_fix_f6_toposort_and_toposort_any_cycle_node" {
  // Cycle is 1 <-> 2; node 0 is downstream of 1 and NOT on any cycle.
  let g : DiGraph[Unit, Unit] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let _ = g.add_edge(n1, n0, ())
  let _ = g.add_edge(n1, n2, ())
  let _ = g.add_edge(n2, n1, ())

  match toposort(g) {
    Err(HasCycle(n)) => debug_assert(n.index == 1 || n.index == 2, "F6: toposort cycle node on cycle")
    _ => debug_assert(false, "F6: expected HasCycle")
  }
  match toposort_any(g) {
    Err(HasCycle(n)) => debug_assert(n.index == 1 || n.index == 2, "F6: toposort_any cycle node on cycle")
    _ => debug_assert(false, "F6: expected HasCycle from toposort_any")
  }
  let csr = CsrGraph::from_digraph(g)
  match csr_toposort(csr) {
    Err(HasCycle(n)) => debug_assert(n.index == 1 || n.index == 2, "F6: csr_toposort cycle node on cycle")
    _ => debug_assert(false, "F6: expected HasCycle from csr_toposort")
  }
  match csr_toposort_any(csr) {
    Err(HasCycle(n)) => debug_assert(n.index == 1 || n.index == 2, "F6: csr_toposort_any cycle node on cycle")
    _ => debug_assert(false, "F6: expected HasCycle from csr_toposort_any")
  }

  // Acyclic DAG check for toposort_any / csr_toposort_any
  let dag : DiGraph[Unit, Unit] = DiGraph::new()
  let d0 = dag.add_node(())
  let d1 = dag.add_node(())
  let d2 = dag.add_node(())
  let _ = dag.add_edge(d2, d1, ())
  let _ = dag.add_edge(d1, d0, ())
  match toposort_any(dag) {
    Ok(ord) =>
    debug_assert(
      ord.length() == 3 && ord[0].index == 2 && ord[1].index == 1 && ord[2].index == 0,
      "toposort_any valid order",
    )
    Err(_) => debug_assert(false, "toposort_any acyclic failed")
  }
  match csr_toposort_any(CsrGraph::from_digraph(dag)) {
    Ok(ord) =>
    debug_assert(
      ord.length() == 3 && ord[0].index == 2 && ord[1].index == 1 && ord[2].index == 0,
      "csr_toposort_any valid order",
    )
    Err(_) => debug_assert(false, "csr_toposort_any acyclic failed")
  }
}

///|
test "rt_fix_f4_f9_f10_size_guards_sparse_tred_and_remove_node_layout" {
  // F9: CsrGraph::from_edges size guards
  let empty_edges : Array[(Int, Int, Int64)] = Array::new()
  match CsrGraph::from_edges(2147483647, empty_edges) {
    Err(InvalidArgument(_)) => ()
    _ => debug_assert(false, "F9: from_edges Int::MAX must return InvalidArgument")
  }
  match CsrGraph::from_edges(1000000000, empty_edges) {
    Err(InvalidArgument(_)) => ()
    _ => debug_assert(false, "F9: from_edges 1e9 must return InvalidArgument")
  }

  // F4: Sparse 20k out-star transitive reduction uses O(V+E) memory
  let star : DiGraph[Unit, Unit] = DiGraph::with_capacity(20000, 19999)
  let mut i = 0
  while i < 20000 {
    let _ = star.add_node(())
    i = i + 1
  }
  let mut j = 1
  while j < 20000 {
    let _ = star.add_edge(NodeId::new(0), NodeId::new(j), ())
    j = j + 1
  }
  match transitive_reduction(star) {
    Ok(r) => debug_assert(r.edge_count() == 19999, "F4: 20k star tred edges")
    Err(_) => debug_assert(false, "F4: 20k star tred failed")
  }

  // F10: remove_node newest-first EdgeId layout matches petgraph
  let g : DiGraph[Unit, Int64] = DiGraph::new()
  let n0 = g.add_node(())
  let n1 = g.add_node(())
  let n2 = g.add_node(())
  let _ = g.add_edge(n1, n0, 0L)
  let _ = g.add_edge(n1, n0, 1L)
  let _ = g.add_edge(n2, n2, 2L)
  let _ = g.add_edge(n2, n1, 3L)
  let _ = g.remove_node(n0)
  debug_assert(g.edge_count() == 2, "F10: 2 edges left")
  match g.edge_weight(EdgeId::new(0)) {
    Some(w) => debug_assert(w == 2L, "F10: EdgeId(0) weight == 2")
    None => debug_assert(false, "F10: EdgeId(0) missing")
  }
  match g.edge_weight(EdgeId::new(1)) {
    Some(w) => debug_assert(w == 3L, "F10: EdgeId(1) weight == 3")
    None => debug_assert(false, "F10: EdgeId(1) missing")
  }
}
