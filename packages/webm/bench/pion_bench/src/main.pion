///| Pion Native head-to-head benchmark for `packages/webm`.
///| Usage:
///|   webm_bench_pion full <webm_file> <iters>
///|   webm_bench_pion mse <init_file> <media_file> <iters>

import "webm"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn fnv1a_slice(h0 : UInt64, data : Bytes, start : Int, len : Int) -> UInt64 {
  let mut h = h0
  let mut i = start
  let end = start + len
  while i < end {
    h = (h ^ data[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

fn emit_tracks(world : World, tracks : Array[webm::TrackEntry]) -> Unit {
  let mut i = 0
  while i < tracks.length() {
    let t = tracks[i]
    let extra = match t.video {
      Some(v) =>
      " video=" + v.pixel_width.to_string() + "x" + v.pixel_height.to_string()
      None =>
      match t.audio {
        Some(a) =>
        " audio=" + a.sampling_frequency.to_int64().to_string() + "Hz/" +
        a.channels.to_string() + "ch"
        None => ""
      }
    }
    io_println(
      world,
      "track num=" + t.track_number.to_string() +
      " type=" + t.track_type.to_string() +
      " codec=" + t.codec_id +
      " cp=" + t.codec_private.length().to_string() +
      extra,
    )
    i = i + 1
  }
}

fn emit_frames(world : World, data : Bytes, frames : Array[webm::Frame]) -> Unit {
  let sb = StringBuilder::new()
  let mut payload_hash : UInt64 = 14695981039346656037UL
  let mut i = 0
  let n = frames.length()
  while i < n {
    let fr = frames[i]
    let fhash = fnv1a_slice(14695981039346656037UL, data, fr.offset.to_int(), fr.size)
    payload_hash = fnv1a_slice(payload_hash, data, fr.offset.to_int(), fr.size)
    sb.write_string("f ")
    sb.write_string(fr.track_number.to_string())
    sb.write_string(" ")
    sb.write_string(fr.size.to_string())
    sb.write_string(" ")
    sb.write_string(fr.pts_ns.to_string())
    sb.write_string(" ")
    sb.write_string(fr.pts_ms.to_string())
    sb.write_string(" ")
    sb.write_string(if fr.is_keyframe { "1" } else { "0" })
    sb.write_string(" ")
    sb.write_string(hex_u64(fhash))
    sb.write_string("\n")
    i = i + 1
  }
  io_println(
    world,
    "frames=" + n.to_string() + " payload_fnv64=" + hex_u64(payload_hash),
  )
  io_print(world, sb.to_string())
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: webm_bench_pion full <file> <iters> | mse <init> <media> <iters>")
    return 1
  }
  let mode = args[1]
  if mode == "full" {
    let path = args[2]
    let iters = parse_int(args[3])
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut i = 0
    let mut last_opt : Option[webm::WebmFile] = None
    while i < iters {
      match webm::parse_webm(data) {
        Ok(f) => last_opt = Some(f)
        Err(e) => {
          io_println(world, "parse error: " + webm::webm_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    match last_opt {
      Some(f) => {
        io_println(
          world,
          "mode=full iters=" + iters.to_string() +
          " doc=" + f.header.doc_type +
          " scale=" + f.info.timestamp_scale.to_string() +
          " tracks=" + f.tracks.length().to_string(),
        )
        emit_tracks(world, f.tracks)
        emit_frames(world, data, f.frames)
      }
      None => return 1
    }
    return 0
  }

  if mode == "mse" {
    if args.length() < 5 {
      io_println(world, "usage: webm_bench_pion mse <init> <media> <iters>")
      return 1
    }
    let init_path = args[2]
    let media_path = args[3]
    let iters = parse_int(args[4])
    let init_data = match fs_read_bytes(world, init_path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + init_path)
        return 1
      }
    }
    let media_data = match fs_read_bytes(world, media_path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + media_path)
        return 1
      }
    }
    let mut i = 0
    let mut last_init : Option[webm::WebmInitSegment] = None
    let mut last_media : Option[webm::WebmMediaSegment] = None
    let limits = webm::DecodeLimits::default()
    while i < iters {
      let init = match webm::parse_init_segment(init_data, limits) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "init error: " + webm::webm_error_message(e))
          return 1
        }
      }
      let media = match webm::parse_media_segment(init, media_data, limits) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "media error: " + webm::webm_error_message(e))
          return 1
        }
      }
      last_init = Some(init)
      last_media = Some(media)
      i = i + 1
    }
    match (last_init, last_media) {
      (Some(init), Some(media)) => {
        io_println(
          world,
          "mode=mse iters=" + iters.to_string() +
          " doc=" + init.header.doc_type +
          " scale=" + init.info.timestamp_scale.to_string() +
          " tracks=" + init.tracks.length().to_string(),
        )
        emit_tracks(world, init.tracks)
        emit_frames(world, media_data, media.frames)
      }
      _ => return 1
    }
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
