///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/webm`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "webm"

fn push_u8(w : Array[Int], v : Int) -> Unit {
  w.push(v & 255)
}

fn push_u16_be(w : Array[Int], v : Int) -> Unit {
  w.push((v >> 8) & 255)
  w.push(v & 255)
}

fn push_u32_be(w : Array[Int], v : Int64) -> Unit {
  w.push(((v >> 24) & 255L).to_int())
  w.push(((v >> 16) & 255L).to_int())
  w.push(((v >> 8) & 255L).to_int())
  w.push((v & 255L).to_int())
}

fn push_u64_be(w : Array[Int], v : Int64) -> Unit {
  push_u32_be(w, (v >> 32) & 0xFFFFFFFFL)
  push_u32_be(w, v & 0xFFFFFFFFL)
}

fn push_str(w : Array[Int], s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    w.push(s.code_unit_at(i) & 255)
    i = i + 1
  }
}

fn append_arr(dst : Array[Int], src : Array[Int]) -> Unit {
  let mut i = 0
  while i < src.length() {
    dst.push(src[i])
    i = i + 1
  }
}

fn to_bytes(a : Array[Int]) -> Bytes {
  let b = Bytes::new(a.length())
  let mut i = 0
  while i < a.length() {
    b[i] = (a[i] & 255).to_byte()
    i = i + 1
  }
  b
}

fn push_ebml_id(w : Array[Int], id : Int64) -> Unit {
  if id <= 0xFFL {
    w.push(id.to_int())
  } else if id <= 0xFFFFL {
    w.push(((id >> 8) & 0xFFL).to_int())
    w.push((id & 0xFFL).to_int())
  } else if id <= 0xFFFFFFL {
    w.push(((id >> 16) & 0xFFL).to_int())
    w.push(((id >> 8) & 0xFFL).to_int())
    w.push((id & 0xFFL).to_int())
  } else {
    w.push(((id >> 24) & 0xFFL).to_int())
    w.push(((id >> 16) & 0xFFL).to_int())
    w.push(((id >> 8) & 0xFFL).to_int())
    w.push((id & 0xFFL).to_int())
  }
}

fn push_vint_size(w : Array[Int], sz : Int) -> Unit {
  if sz < 0x7F {
    w.push(0x80 | sz)
  } else if sz < 0x3FFF {
    w.push(0x40 | ((sz >> 8) & 0x3F))
    w.push(sz & 0xFF)
  } else {
    w.push(0x20 | ((sz >> 16) & 0x1F))
    w.push((sz >> 8) & 0xFF)
    w.push(sz & 0xFF)
  }
}

fn make_elem(id : Int64, payload : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  push_ebml_id(out, id)
  push_vint_size(out, payload.length())
  append_arr(out, payload)
  out
}

fn make_uint_elem(id : Int64, v : Int64) -> Array[Int] {
  let p : Array[Int] = []
  if v == 0L {
    p.push(0)
  } else if v <= 0xFFL {
    p.push(v.to_int())
  } else if v <= 0xFFFFL {
    p.push(((v >> 8) & 0xFFL).to_int())
    p.push((v & 0xFFL).to_int())
  } else if v <= 0xFFFFFFL {
    p.push(((v >> 16) & 0xFFL).to_int())
    p.push(((v >> 8) & 0xFFL).to_int())
    p.push((v & 0xFFL).to_int())
  } else {
    push_u32_be(p, v)
  }
  make_elem(id, p)
}

fn make_str_elem(id : Int64, s : String) -> Array[Int] {
  let p : Array[Int] = []
  push_str(p, s)
  make_elem(id, p)
}

fn make_f64_elem(id : Int64, d : Double) -> Array[Int] {
  let p : Array[Int] = []
  push_u64_be(p, d.to_bits())
  make_elem(id, p)
}

fn make_simple_block(
  track : Int,
  rel_ts : Int,
  flags : Int,
  payload : Array[Int],
) -> Array[Int] {
  let b : Array[Int] = []
  push_vint_size(b, track)
  push_u16_be(b, rel_ts & 0xFFFF)
  push_u8(b, flags)
  append_arr(b, payload)
  make_elem(0xA3L, b)
}

fn build_smoke_init() -> Array[Int] {
  let hdr : Array[Int] = []
  append_arr(hdr, make_str_elem(0x4282L, "webm"))
  append_arr(hdr, make_uint_elem(0x4287L, 4L))
  append_arr(hdr, make_uint_elem(0x4285L, 2L))

  let info : Array[Int] = []
  append_arr(info, make_uint_elem(0x2AD7B1L, 1000000L))
  append_arr(info, make_f64_elem(0x4489L, 3000.0))

  let vid : Array[Int] = []
  append_arr(vid, make_uint_elem(0xB0L, 1920L))
  append_arr(vid, make_uint_elem(0xBAL, 1080L))

  let t1 : Array[Int] = []
  append_arr(t1, make_uint_elem(0xD7L, 1L))
  append_arr(t1, make_uint_elem(0x83L, 1L))
  append_arr(t1, make_str_elem(0x86L, "V_VP9"))
  append_arr(t1, make_elem(0xE0L, vid))

  let aud : Array[Int] = []
  append_arr(aud, make_f64_elem(0xB5L, 48000.0))
  append_arr(aud, make_uint_elem(0x9FL, 2L))

  let t2 : Array[Int] = []
  append_arr(t2, make_uint_elem(0xD7L, 2L))
  append_arr(t2, make_uint_elem(0x83L, 2L))
  append_arr(t2, make_str_elem(0x86L, "A_OPUS"))
  append_arr(t2, make_elem(0xE1L, aud))

  let tracks : Array[Int] = []
  append_arr(tracks, make_elem(0xAEL, t1))
  append_arr(tracks, make_elem(0xAEL, t2))

  let out : Array[Int] = []
  append_arr(out, make_elem(0x1A45DFA3L, hdr))
  push_ebml_id(out, 0x18538067L)
  // Unknown-size streaming Segment
  out.push(0x01)
  out.push(0xFF)
  out.push(0xFF)
  out.push(0xFF)
  out.push(0xFF)
  out.push(0xFF)
  out.push(0xFF)
  out.push(0xFF)
  append_arr(out, make_elem(0x1549A966L, info))
  append_arr(out, make_elem(0x1654AE6BL, tracks))
  out
}

fn build_smoke_clusters() -> Array[Int] {
  let c1 : Array[Int] = []
  append_arr(c1, make_uint_elem(0xE7L, 0L))
  append_arr(c1, make_simple_block(1, 0, 0x80, [0x11, 0x22, 0x33, 0x44]))
  append_arr(c1, make_simple_block(2, 0, 0x80, [0x55, 0x66]))
  // EBML laced 2-frame audio block: sizes 3 and 2 (delta -1 => 63-1=62 => 0xBE)
  append_arr(
    c1,
    make_simple_block(2, 20, 0x86, [1, 0x83, 0xBE, 0xA1, 0xA2, 0xA3, 0xB1, 0xB2]),
  )

  let c2 : Array[Int] = []
  append_arr(c2, make_uint_elem(0xE7L, 1000L))
  append_arr(c2, make_simple_block(1, 0, 0x80, [0x77, 0x88, 0x99]))

  let out : Array[Int] = []
  append_arr(out, make_elem(0x1F43B675L, c1))
  append_arr(out, make_elem(0x1F43B675L, c2))
  out
}

pub fn main(world : World) -> Int {
  let init_arr = build_smoke_init()
  let clusters_arr = build_smoke_clusters()
  let full_arr : Array[Int] = []
  append_arr(full_arr, init_arr)
  append_arr(full_arr, clusters_arr)

  let full_bytes = to_bytes(full_arr)
  let init_bytes = to_bytes(init_arr)
  let media_bytes = to_bytes(clusters_arr)

  let parsed = match webm::parse_webm(full_bytes) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR parse_webm: " + webm::webm_error_message(e))
      return 1
    }
  }

  let init = match webm::parse_init_segment(init_bytes, webm::DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR parse_init: " + webm::webm_error_message(e))
      return 2
    }
  }

  let media = match webm::parse_media_segment(init, media_bytes, webm::DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR parse_media: " + webm::webm_error_message(e))
      return 3
    }
  }

  let kf = match webm::find_keyframe_at(parsed.frames, 1L, 1500L) {
    Some(idx) => idx
    None => -1
  }

  // Verify strict negative & zero limits
  let neg_ok = match
  webm::parse_webm_with_limits(
    full_bytes,
    webm::DecodeLimits::new(-1, 10, 10, 10, 10, 1024, 1024, 1000, 16),
  ) {
    Err(webm::WebmError::InvalidLimits(_)) => true
    _ => false
  }
  let zero_ok = match
  webm::parse_webm_with_limits(
    full_bytes,
    webm::DecodeLimits::new(0, 10, 10, 10, 10, 1024, 1024, 1000, 16),
  ) {
    Err(webm::WebmError::LimitExceeded(_)) => true
    _ => false
  }
  if !neg_ok || !zero_ok {
    io_println(world, "ERR limits check failed")
    return 4
  }

  io_println(world, "webm_wasm_smoke:ok")
  io_println(
    world,
    "doc=" + parsed.header.doc_type +
    " dur_ms=" + parsed.info.duration_ms.to_string() +
    " tracks=" + parsed.tracks.length().to_string() +
    " codecs=" + webm::probe_codec_string(parsed.tracks[0]) + "," +
    webm::probe_codec_string(parsed.tracks[1]),
  )
  io_println(
    world,
    "full_clusters=" + parsed.clusters.length().to_string() +
    " full_frames=" + parsed.frames.length().to_string() +
    " kf_1500=" + kf.to_string(),
  )
  io_println(
    world,
    "mse_clusters=" + media.clusters.length().to_string() +
    " mse_frames=" + media.frames.length().to_string() +
    " range=" + media.start_pts_ms.to_string() + ".." + media.end_pts_ms.to_string(),
  )
  0
}
