///| Matroska / WebM container demuxer and W3C MSE WebM Byte Stream parser.

// EBML & Matroska Element IDs
let id_ebml : Int64 = 0x1A45DFA3L
let id_ebml_version : Int64 = 0x4286L
let id_ebml_read_version : Int64 = 0x42F7L
let id_ebml_max_id_length : Int64 = 0x42F2L
let id_ebml_max_size_length : Int64 = 0x42F3L
let id_doc_type : Int64 = 0x4282L
let id_doc_type_version : Int64 = 0x4287L
let id_doc_type_read_version : Int64 = 0x4285L

let id_void : Int64 = 0xECL
let id_crc32 : Int64 = 0xBFL

let id_segment : Int64 = 0x18538067L
let id_seek_head : Int64 = 0x114D9B74L
let id_info : Int64 = 0x1549A966L
let id_tracks : Int64 = 0x1654AE6BL
let id_cues : Int64 = 0x1C53BB6BL
let id_cluster : Int64 = 0x1F43B675L
let id_attachments : Int64 = 0x1941A469L
let id_chapters : Int64 = 0x1043A770L
let id_tags : Int64 = 0x1254C367L

// Info children
let id_timestamp_scale : Int64 = 0x2AD7B1L
let id_duration : Int64 = 0x4489L
let id_muxing_app : Int64 = 0x4D80L
let id_writing_app : Int64 = 0x5741L

// Tracks children
let id_track_entry : Int64 = 0xAEL
let id_track_number : Int64 = 0xD7L
let id_track_uid : Int64 = 0x73C5L
let id_track_type : Int64 = 0x83L
let id_flag_default : Int64 = 0x88L
let id_flag_lacing : Int64 = 0x9CL
let id_default_duration : Int64 = 0x23E383L
let id_language : Int64 = 0x22B59CL
let id_language_bcp47 : Int64 = 0x22B59DL
let id_codec_id : Int64 = 0x86L
let id_codec_private : Int64 = 0x63A2L
let id_codec_delay : Int64 = 0x56AAL
let id_seek_pre_roll : Int64 = 0x56BBL
let id_video : Int64 = 0xE0L
let id_audio : Int64 = 0xE1L

// Video children
let id_pixel_width : Int64 = 0xB0L
let id_pixel_height : Int64 = 0xBAL
let id_display_width : Int64 = 0x54B0L
let id_display_height : Int64 = 0x54BAL
let id_alpha_mode : Int64 = 0x53C0L

// Audio children
let id_sampling_frequency : Int64 = 0xB5L
let id_output_sampling_frequency : Int64 = 0x78B5L
let id_channels : Int64 = 0x9FL
let id_bit_depth : Int64 = 0x6264L

// Cues children
let id_cue_point : Int64 = 0xBBL
let id_cue_time : Int64 = 0xB3L
let id_cue_track_positions : Int64 = 0xB7L
let id_cue_track : Int64 = 0xF7L
let id_cue_cluster_position : Int64 = 0xF1L
let id_cue_relative_position : Int64 = 0xF0L

// Cluster children
let id_timestamp : Int64 = 0xE7L
let id_simple_block : Int64 = 0xA3L
let id_block_group : Int64 = 0xA0L
let id_block : Int64 = 0xA1L
let id_block_duration : Int64 = 0x9BL
let id_reference_block : Int64 = 0xFBL
let id_discard_padding : Int64 = 0x75A2L

let i64_max : Int64 = 9223372036854775807L
let i64_min : Int64 = -9223372036854775807L - 1L
let safe_1e6_ticks : Int64 = 9223372036854L

struct ParseState {
  limits : DecodeLimits
  mut elements_visited : Int
  mut total_cue_positions : Int
}

val struct DeferredCluster {
  elem_offset : Int
  payload_start : Int
  payload_end : Int
}

struct TrackLookup {
  // Fast O(1) lookup for track numbers 1..15
  fast_valid : Array[Bool]
  fast_dur : Array[Int64]
  tracks : Array[TrackEntry]
}

fn build_track_lookup(tracks : Array[TrackEntry]) -> TrackLookup {
  let fv : Array[Bool] = []
  let fd : Array[Int64] = []
  let mut k = 0
  while k < 16 {
    fv.push(false)
    fd.push(0L)
    k = k + 1
  }
  let mut i = 0
  let n = tracks.length()
  while i < n {
    let tn = tracks[i].track_number
    if tn > 0L && tn < 16L {
      let idx = tn.to_int()
      fv[idx] = true
      fd[idx] = tracks[i].default_duration
    }
    i = i + 1
  }
  TrackLookup::{ fast_valid: fv, fast_dur: fd, tracks: tracks }
}

fn lookup_track_exists(tl : TrackLookup, tn : Int64) -> Bool {
  if tn <= 0L {
    return false
  }
  if tn < 16L {
    return tl.fast_valid[tn.to_int()]
  }
  let mut i = 0
  let n = tl.tracks.length()
  while i < n {
    if tl.tracks[i].track_number == tn {
      return true
    }
    i = i + 1
  }
  false
}

fn lookup_track_default_duration(tl : TrackLookup, tn : Int64) -> Int64 {
  if tn > 0L && tn < 16L {
    return tl.fast_dur[tn.to_int()]
  }
  let mut i = 0
  let n = tl.tracks.length()
  while i < n {
    if tl.tracks[i].track_number == tn {
      return tl.tracks[i].default_duration
    }
    i = i + 1
  }
  0L
}

fn checked_add_i64(a : Int64, b : Int64) -> Result[Int64, WebmError] {
  if b > 0L && a > i64_max - b {
    return Err(
      WebmError::InvalidElementData("Int64 timestamp addition overflow"),
    )
  }
  if b < 0L && a < i64_min - b {
    return Err(
      WebmError::InvalidElementData("Int64 timestamp addition underflow"),
    )
  }
  Ok(a + b)
}

fn checked_mul_i64(a : Int64, b : Int64) -> Result[Int64, WebmError] {
  if a == 0L || b == 0L {
    return Ok(0L)
  }
  if a > 0L && b > 0L {
    if a > i64_max / b {
      return Err(
        WebmError::InvalidElementData("Int64 timestamp multiplication overflow"),
      )
    }
  } else if a < 0L && b > 0L {
    if a < i64_min / b {
      return Err(
        WebmError::InvalidElementData(
          "Int64 timestamp multiplication underflow",
        ),
      )
    }
  } else if a > 0L && b < 0L {
    if b < i64_min / a {
      return Err(
        WebmError::InvalidElementData(
          "Int64 timestamp multiplication underflow",
        ),
      )
    }
  } else {
    if a == i64_min || b == i64_min || -a > i64_max / -b {
      return Err(
        WebmError::InvalidElementData("Int64 timestamp multiplication overflow"),
      )
    }
  }
  Ok(a * b)
}

fn ns_to_ms_floor(ns : Int64) -> Int64 {
  if ns >= 0L {
    ns / 1000000L
  } else {
    let q = ns / 1000000L
    let r = ns % 1000000L
    if r < 0L { q - 1L } else { q }
  }
}

fn read_nonneg_u64(
  data : Bytes,
  offset : Int,
  size : Int,
  field_name : String,
) -> Result[Int64, WebmError] {
  let v = match read_be_uint(data, offset, size) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  if v < 0L {
    return Err(
      WebmError::InvalidElementData(field_name + " exceeds Int64 range"),
    )
  }
  Ok(v)
}

fn validate_limits(limits : DecodeLimits) -> Result[Unit, WebmError] {
  if limits.max_tracks < 0 ||
  limits.max_clusters < 0 ||
  limits.max_frames < 0 ||
  limits.max_cues < 0 ||
  limits.max_laced_frames < 0 ||
  limits.max_codec_private_bytes < 0 ||
  limits.max_string_bytes < 0 ||
  limits.max_elements < 0 ||
  limits.max_depth < 0 {
    return Err(WebmError::InvalidLimits("decode limits must be non-negative"))
  }
  Ok(())
}

fn count_element(st : ParseState) -> Result[Unit, WebmError] {
  st.elements_visited = st.elements_visited + 1
  if st.elements_visited > st.limits.max_elements {
    return Err(WebmError::LimitExceeded("max_elements exceeded"))
  }
  Ok(())
}

fn check_depth(st : ParseState, depth : Int) -> Result[Unit, WebmError] {
  if depth > st.limits.max_depth {
    return Err(WebmError::LimitExceeded("max_depth exceeded"))
  }
  Ok(())
}

fn slice_bytes(data : Bytes, start : Int, len : Int) -> Bytes {
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = data[start + i]
    i = i + 1
  }
  out
}

fn read_ebml_string(
  data : Bytes,
  start : Int,
  len : Int,
  max_len : Int,
) -> Result[String, WebmError] {
  if len > max_len {
    return Err(WebmError::LimitExceeded("max_string_bytes exceeded"))
  }
  let mut trimmed = len
  while trimmed > 0 && data[start + trimmed - 1].to_int() == 0 {
    trimmed = trimmed - 1
  }
  if trimmed == 0 {
    return Ok("")
  }
  Ok(slice_bytes(data, start, trimmed).to_string())
}

fn resolve_definite_end(
  payload_start : Int,
  vsize : VintSize,
  container_end : Int,
) -> Result[Int, WebmError] {
  if vsize.is_unknown {
    return Err(
      WebmError::InvalidElementData("unknown size not allowed on this element"),
    )
  }
  let rem : Int64 = (container_end - payload_start).to_int64()
  if vsize.size < 0L || vsize.size > rem {
    return Err(
      WebmError::TruncatedData("element payload exceeds enclosing bounds"),
    )
  }
  Ok(payload_start + vsize.size.to_int())
}

fn is_segment_boundary_id(id : Int64) -> Bool {
  id == id_ebml || id == id_segment
}

fn is_cluster_boundary_id(id : Int64) -> Bool {
  id == id_ebml ||
  id == id_segment ||
  id == id_seek_head ||
  id == id_info ||
  id == id_tracks ||
  id == id_cues ||
  id == id_cluster ||
  id == id_attachments ||
  id == id_chapters ||
  id == id_tags
}

fn default_ebml_header() -> EbmlHeader {
  EbmlHeader::{
    ebml_version: 1L,
    ebml_read_version: 1L,
    ebml_max_id_length: 4L,
    ebml_max_size_length: 8L,
    doc_type: "",
    doc_type_version: 1L,
    doc_type_read_version: 1L,
  }
}

fn default_segment_info() -> SegmentInfo {
  SegmentInfo::{
    timestamp_scale: 1000000L,
    duration: 0.0,
    has_duration: false,
    duration_ms: 0L,
    muxing_app: "",
    writing_app: "",
  }
}

fn parse_ebml_header_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[EbmlHeader, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut ebml_version = 1L
  let mut ebml_read_version = 1L
  let mut ebml_max_id_length = 4L
  let mut ebml_max_size_length = 8L
  let mut doc_type = ""
  let mut doc_type_version = 1L
  let mut doc_type_read_version = 1L

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_ebml_version {
      ebml_version = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_ebml_read_version {
      ebml_read_version = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_ebml_max_id_length {
      ebml_max_id_length = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_ebml_max_size_length {
      ebml_max_size_length = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_doc_type {
      doc_type = match
      read_ebml_string(data, pstart, plen, st.limits.max_string_bytes) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_doc_type_version {
      doc_type_version = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_doc_type_read_version {
      doc_type_read_version = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  if ebml_read_version <= 0L || ebml_read_version > 1L {
    return Err(
      WebmError::InvalidHeader(
        "unsupported EBMLReadVersion: " + ebml_read_version.to_string(),
      ),
    )
  }
  if ebml_max_id_length <= 0L || ebml_max_id_length > 4L {
    return Err(
      WebmError::InvalidHeader(
        "unsupported EBMLMaxIDLength: " + ebml_max_id_length.to_string(),
      ),
    )
  }
  if ebml_max_size_length <= 0L || ebml_max_size_length > 8L {
    return Err(
      WebmError::InvalidHeader(
        "unsupported EBMLMaxSizeLength: " + ebml_max_size_length.to_string(),
      ),
    )
  }
  if doc_type != "webm" && doc_type != "matroska" {
    return Err(
      WebmError::InvalidHeader("unsupported EBML DocType: '" + doc_type + "'"),
    )
  }
  if doc_type_read_version <= 0L || doc_type_read_version > 4L {
    return Err(
      WebmError::InvalidHeader(
        "unsupported DocTypeReadVersion: " + doc_type_read_version.to_string(),
      ),
    )
  }

  Ok(EbmlHeader::{
    ebml_version: ebml_version,
    ebml_read_version: ebml_read_version,
    ebml_max_id_length: ebml_max_id_length,
    ebml_max_size_length: ebml_max_size_length,
    doc_type: doc_type,
    doc_type_version: doc_type_version,
    doc_type_read_version: doc_type_read_version,
  })
}

fn parse_info_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[SegmentInfo, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut timestamp_scale = 1000000L
  let mut duration = 0.0
  let mut has_duration = false
  let mut muxing_app = ""
  let mut writing_app = ""

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_timestamp_scale {
      timestamp_scale = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if timestamp_scale <= 0L {
        return Err(
          WebmError::InvalidElementData("TimestampScale must be positive"),
        )
      }
    } else if vid.id == id_duration {
      duration = match read_be_float(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_duration = true
    } else if vid.id == id_muxing_app {
      muxing_app = match
      read_ebml_string(data, pstart, plen, st.limits.max_string_bytes) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_writing_app {
      writing_app = match
      read_ebml_string(data, pstart, plen, st.limits.max_string_bytes) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  // P0-1: NaN-safe, Wasm32-trap-free finite range check before Double::to_int64
  let duration_ms : Int64 = if has_duration && duration >= 0.0 && duration < 1.0e300 {
    let d_ms = duration * timestamp_scale.to_double() / 1000000.0
    if d_ms >= 0.0 && d_ms < 9.2e18 {
      d_ms.to_int64()
    } else {
      0L
    }
  } else {
    0L
  }

  Ok(SegmentInfo::{
    timestamp_scale: timestamp_scale,
    duration: duration,
    has_duration: has_duration,
    duration_ms: duration_ms,
    muxing_app: muxing_app,
    writing_app: writing_app,
  })
}

fn parse_video_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[VideoTrackInfo, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut pixel_width = 0L
  let mut pixel_height = 0L
  let mut display_width = 0L
  let mut display_height = 0L
  let mut alpha_mode = 0L

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_pixel_width {
      pixel_width = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_pixel_height {
      pixel_height = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_display_width {
      display_width = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_display_height {
      display_height = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_alpha_mode {
      alpha_mode = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  Ok(VideoTrackInfo::{
    pixel_width: pixel_width,
    pixel_height: pixel_height,
    display_width: if display_width > 0L { display_width } else { pixel_width },
    display_height: if display_height > 0L {
      display_height
    } else {
      pixel_height
    },
    alpha_mode: alpha_mode,
  })
}

fn parse_audio_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[AudioTrackInfo, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut sampling_frequency = 8000.0
  let mut output_sampling_frequency = 0.0
  let mut channels = 1L
  let mut bit_depth = 0L

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_sampling_frequency {
      sampling_frequency = match read_be_float(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_output_sampling_frequency {
      output_sampling_frequency = match read_be_float(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_channels {
      channels = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_bit_depth {
      bit_depth = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  Ok(AudioTrackInfo::{
    sampling_frequency: sampling_frequency,
    output_sampling_frequency: output_sampling_frequency,
    channels: channels,
    bit_depth: bit_depth,
  })
}

fn parse_track_entry_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[TrackEntry, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut track_number = 0L
  let mut track_uid = 0L
  let mut track_type = 0
  let mut flag_default = true
  let mut flag_lacing = true
  let mut default_duration = 0L
  let mut language = "eng"
  let mut codec_id = ""
  let mut codec_private = Bytes::new(0)
  let mut codec_delay = 0L
  let mut seek_pre_roll = 0L
  let mut video : Option[VideoTrackInfo] = None
  let mut audio : Option[AudioTrackInfo] = None

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_track_number {
      track_number = match read_nonneg_u64(data, pstart, plen, "TrackNumber") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_track_uid {
      track_uid = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_track_type {
      let tt = match read_be_uint(data, pstart, plen) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tt < 0L || tt > 255L {
        return Err(WebmError::InvalidElementData("TrackType out of range"))
      }
      track_type = tt.to_int()
    } else if vid.id == id_flag_default {
      let v = match read_be_uint(data, pstart, plen) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      flag_default = v != 0L
    } else if vid.id == id_flag_lacing {
      let v = match read_be_uint(data, pstart, plen) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      flag_lacing = v != 0L
    } else if vid.id == id_default_duration {
      default_duration = match
      read_nonneg_u64(data, pstart, plen, "DefaultDuration") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_language || vid.id == id_language_bcp47 {
      language = match
      read_ebml_string(data, pstart, plen, st.limits.max_string_bytes) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_codec_id {
      codec_id = match
      read_ebml_string(data, pstart, plen, st.limits.max_string_bytes) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_codec_private {
      if plen > st.limits.max_codec_private_bytes {
        return Err(
          WebmError::LimitExceeded("max_codec_private_bytes exceeded"),
        )
      }
      codec_private = slice_bytes(data, pstart, plen)
    } else if vid.id == id_codec_delay {
      codec_delay = match read_nonneg_u64(data, pstart, plen, "CodecDelay") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_seek_pre_roll {
      seek_pre_roll = match read_nonneg_u64(data, pstart, plen, "SeekPreRoll") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_video {
      let vinfo = match parse_video_body(data, pstart, pend, st, depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      video = Some(vinfo)
    } else if vid.id == id_audio {
      let ainfo = match parse_audio_body(data, pstart, pend, st, depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      audio = Some(ainfo)
    }
    pos = pend
  }

  if track_number <= 0L {
    return Err(WebmError::InvalidElementData("TrackNumber must be positive"))
  }

  Ok(TrackEntry::{
    track_number: track_number,
    track_uid: track_uid,
    track_type: track_type,
    flag_default: flag_default,
    flag_lacing: flag_lacing,
    default_duration: default_duration,
    language: language,
    codec_id: codec_id,
    codec_private: codec_private,
    codec_delay: codec_delay,
    seek_pre_roll: seek_pre_roll,
    video: video,
    audio: audio,
  })
}

fn parse_tracks_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
  tracks : Array[TrackEntry],
) -> Result[Unit, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if vid.id == id_track_entry {
      if tracks.length() >= st.limits.max_tracks {
        return Err(WebmError::LimitExceeded("max_tracks exceeded"))
      }
      let tr = match parse_track_entry_body(data, pstart, pend, st, depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      // Reject duplicate track numbers
      let mut di = 0
      while di < tracks.length() {
        if tracks[di].track_number == tr.track_number {
          return Err(WebmError::InvalidElementData("duplicate TrackNumber"))
        }
        di = di + 1
      }
      tracks.push(tr)
    }
    pos = pend
  }
  Ok(())
}

fn parse_cue_track_positions_body(
  data : Bytes,
  start : Int,
  end : Int,
  st : ParseState,
  depth : Int,
) -> Result[CueTrackPosition, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut track = 0L
  let mut cluster_position = 0L
  let mut relative_position = -1L
  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let plen = pend - pstart
    if vid.id == id_cue_track {
      track = match read_nonneg_u64(data, pstart, plen, "CueTrack") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_cue_cluster_position {
      cluster_position = match
      read_nonneg_u64(data, pstart, plen, "CueClusterPosition") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    } else if vid.id == id_cue_relative_position {
      relative_position = match
      read_nonneg_u64(data, pstart, plen, "CueRelativePosition") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }
  Ok(CueTrackPosition::{
    track: track,
    cluster_position: cluster_position,
    relative_position: relative_position,
  })
}

fn parse_cue_point_body(
  data : Bytes,
  start : Int,
  end : Int,
  timestamp_scale : Int64,
  scale_ready : Bool,
  st : ParseState,
  depth : Int,
) -> Result[CuePoint, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut has_cue_time = false
  let mut cue_time = 0L
  let positions : Array[CueTrackPosition] = []
  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if vid.id == id_cue_time {
      cue_time = match read_nonneg_u64(data, pstart, pend - pstart, "CueTime") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_cue_time = true
    } else if vid.id == id_cue_track_positions {
      if st.total_cue_positions >= st.limits.max_cues {
        return Err(WebmError::LimitExceeded("max_cues exceeded"))
      }
      st.total_cue_positions = st.total_cue_positions + 1
      let tp = match
      parse_cue_track_positions_body(data, pstart, pend, st, depth + 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      positions.push(tp)
    }
    pos = pend
  }
  if !has_cue_time || positions.length() == 0 {
    return Err(
      WebmError::InvalidElementData(
        "CuePoint missing mandatory CueTime or CueTrackPositions",
      ),
    )
  }
  let time_ms = if scale_ready {
    let time_ns = match checked_mul_i64(cue_time, timestamp_scale) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    ns_to_ms_floor(time_ns)
  } else {
    0L
  }
  Ok(CuePoint::{ time: cue_time, time_ms: time_ms, positions: positions })
}

fn parse_cues_body(
  data : Bytes,
  start : Int,
  end : Int,
  timestamp_scale : Int64,
  scale_ready : Bool,
  st : ParseState,
  depth : Int,
  cues : Array[CuePoint],
) -> Result[Unit, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if vid.id == id_cue_point {
      if cues.length() >= st.limits.max_cues {
        return Err(WebmError::LimitExceeded("max_cues exceeded"))
      }
      let cp = match
      parse_cue_point_body(
        data,
        pstart,
        pend,
        timestamp_scale,
        scale_ready,
        st,
        depth + 1,
      ) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      cues.push(cp)
    }
    pos = pend
  }
  Ok(())
}

fn parse_block_payload(
  data : Bytes,
  block_start : Int,
  block_end : Int,
  cluster_ts : Int64,
  timestamp_scale : Int64,
  track_lookup : TrackLookup,
  is_simple_block : Bool,
  block_group_is_keyframe : Bool,
  has_block_duration : Bool,
  block_duration_ns : Int64,
  st : ParseState,
  frames : Array[Frame],
) -> Result[Unit, WebmError] {
  let tr_vint = match read_vint_size(data, block_start, block_end) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if tr_vint.is_unknown || tr_vint.size <= 0L {
    return Err(WebmError::InvalidBlock("invalid block track number"))
  }
  let track_number = tr_vint.size
  if !lookup_track_exists(track_lookup, track_number) {
    return Err(WebmError::InvalidBlock("block references undeclared track"))
  }
  let mut pos = tr_vint.next_offset
  if pos + 3 > block_end {
    return Err(WebmError::TruncatedData("truncated block header"))
  }
  let raw_rel = (data[pos].to_int() << 8) | data[pos + 1].to_int()
  let rel_ts : Int64 = if raw_rel >= 32768 {
    (raw_rel - 65536).to_int64()
  } else {
    raw_rel.to_int64()
  }
  let flags = data[pos + 2].to_int()
  pos = pos + 3

  let is_keyframe = if is_simple_block {
    (flags & 0x80) != 0
  } else {
    block_group_is_keyframe
  }
  let invisible = (flags & 0x08) != 0
  let lacing = (flags >> 1) & 0x03

  let abs_ticks = match checked_add_i64(cluster_ts, rel_ts) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pts_ns = match checked_mul_i64(abs_ticks, timestamp_scale) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pts_ms = ns_to_ms_floor(pts_ns)
  let track_dd = lookup_track_default_duration(track_lookup, track_number)
  let dur_ns = if has_block_duration { block_duration_ns } else { track_dd }

  if lacing == 0 {
    let fsz = block_end - pos
    if fsz <= 0 {
      return Err(WebmError::InvalidBlock("empty frame payload"))
    }
    if frames.length() + 1 > st.limits.max_frames {
      return Err(WebmError::LimitExceeded("max_frames exceeded"))
    }
    frames.push(Frame::{
      track_number: track_number,
      offset: pos.to_int64(),
      size: fsz,
      pts_ns: pts_ns,
      pts_ms: pts_ms,
      duration_ns: dur_ns,
      is_keyframe: is_keyframe,
      invisible: invisible,
    })
    return Ok(())
  }

  // Laced block (lacing == 1 Xiph, 2 Fixed-size, 3 EBML)
  if pos >= block_end {
    return Err(WebmError::TruncatedData("missing lacing frame count"))
  }
  let num_frames = data[pos].to_int() + 1
  pos = pos + 1
  if num_frames > st.limits.max_laced_frames {
    return Err(WebmError::LimitExceeded("max_laced_frames exceeded"))
  }
  if frames.length() + num_frames > st.limits.max_frames {
    return Err(WebmError::LimitExceeded("max_frames exceeded"))
  }

  let sizes : Array[Int] = []
  if lacing == 1 {
    // Xiph lacing
    let mut sum_sizes = 0
    let mut fi = 0
    while fi < num_frames - 1 {
      let mut fsz = 0
      while true {
        if pos >= block_end {
          return Err(WebmError::TruncatedData("truncated Xiph lacing header"))
        }
        let b = data[pos].to_int()
        pos = pos + 1
        fsz = fsz + b
        if sum_sizes + fsz > block_end - pos {
          return Err(
            WebmError::InvalidBlock(
              "Xiph lacing frame sizes exceed block payload",
            ),
          )
        }
        if b < 255 {
          break
        }
      }
      if fsz <= 0 {
        return Err(
          WebmError::InvalidBlock("zero-byte frame in Xiph lacing"),
        )
      }
      sizes.push(fsz)
      sum_sizes = sum_sizes + fsz
      fi = fi + 1
    }
    let rem = block_end - pos
    let last_sz = rem - sum_sizes
    if last_sz <= 0 {
      return Err(
        WebmError::InvalidBlock("invalid or empty last frame in Xiph lacing"),
      )
    }
    sizes.push(last_sz)
  } else if lacing == 2 {
    // Fixed-size lacing
    let rem = block_end - pos
    if rem <= 0 || rem % num_frames != 0 {
      return Err(
        WebmError::InvalidBlock(
          "fixed-size lacing payload empty or not divisible by frame count",
        ),
      )
    }
    let each = rem / num_frames
    let mut fi = 0
    while fi < num_frames {
      sizes.push(each)
      fi = fi + 1
    }
  } else {
    // EBML lacing
    if num_frames == 1 {
      let rem = block_end - pos
      if rem <= 0 {
        return Err(
          WebmError::InvalidBlock("empty frame payload in EBML lacing"),
        )
      }
      sizes.push(rem)
    } else {
      let first_v = match read_vint_size(data, pos, block_end) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if first_v.is_unknown {
        return Err(WebmError::InvalidBlock("unknown-size VINT in EBML lacing"))
      }
      pos = first_v.next_offset
      if first_v.size <= 0L || first_v.size > (block_end - pos).to_int64() {
        return Err(
          WebmError::InvalidBlock(
            "EBML lacing first frame size invalid or exceeds block",
          ),
        )
      }
      let mut prev_sz : Int64 = first_v.size
      let mut sum_sizes : Int64 = prev_sz
      sizes.push(prev_sz.to_int())

      let mut fi = 1
      while fi < num_frames - 1 {
        let sv = match read_signed_vint(data, pos, block_end) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        pos = sv.next_offset
        let cur_sz = prev_sz + sv.value
        if cur_sz <= 0L {
          return Err(
            WebmError::InvalidBlock(
              "non-positive frame size in EBML lacing",
            ),
          )
        }
        sum_sizes = sum_sizes + cur_sz
        if sum_sizes > (block_end - pos).to_int64() {
          return Err(
            WebmError::InvalidBlock(
              "EBML lacing frame sizes exceed block payload",
            ),
          )
        }
        sizes.push(cur_sz.to_int())
        prev_sz = cur_sz
        fi = fi + 1
      }
      let rem : Int64 = (block_end - pos).to_int64()
      let last_sz = rem - sum_sizes
      if last_sz <= 0L {
        return Err(
          WebmError::InvalidBlock("invalid or empty last frame in EBML lacing"),
        )
      }
      sizes.push(last_sz.to_int())
    }
  }

  let per_frame_dur : Int64 = if has_block_duration {
    block_duration_ns / num_frames.to_int64()
  } else {
    track_dd
  }

  let mut frame_off = pos
  let mut fi = 0
  while fi < num_frames {
    let fsz = sizes[fi]
    if fsz <= 0 || frame_off + fsz > block_end {
      return Err(WebmError::BoundsExceeded("laced frame exceeds block end"))
    }
    let delta_ns = match checked_mul_i64(fi.to_int64(), per_frame_dur) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let f_pts_ns = match checked_add_i64(pts_ns, delta_ns) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    frames.push(Frame::{
      track_number: track_number,
      offset: frame_off.to_int64(),
      size: fsz,
      pts_ns: f_pts_ns,
      pts_ms: ns_to_ms_floor(f_pts_ns),
      duration_ns: per_frame_dur,
      is_keyframe: is_keyframe,
      invisible: invisible,
    })
    frame_off = frame_off + fsz
    fi = fi + 1
  }
  if frame_off != block_end {
    return Err(
      WebmError::InvalidBlock("laced frames do not cover block payload"),
    )
  }
  Ok(())
}

fn parse_block_group_body(
  data : Bytes,
  start : Int,
  end : Int,
  cluster_ts : Int64,
  timestamp_scale : Int64,
  track_lookup : TrackLookup,
  st : ParseState,
  depth : Int,
  frames : Array[Frame],
) -> Result[Unit, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut has_block = false
  let mut block_start = 0
  let mut block_end = 0
  let mut has_ref = false
  let mut has_block_duration = false
  let mut block_duration_ns = 0L

  let mut pos = start
  while pos < end {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if vid.id == id_block {
      has_block = true
      block_start = pstart
      block_end = pend
    } else if vid.id == id_block_duration {
      let dur_ticks = match
      read_nonneg_u64(data, pstart, pend - pstart, "BlockDuration") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      block_duration_ns = match checked_mul_i64(dur_ticks, timestamp_scale) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_block_duration = true
    } else if vid.id == id_reference_block {
      let _ = match read_be_sint(data, pstart, pend - pstart) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_ref = true
    } else if vid.id == id_discard_padding {
      let _ = match read_be_sint(data, pstart, pend - pstart) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  if has_block {
    return parse_block_payload(
      data,
      block_start,
      block_end,
      cluster_ts,
      timestamp_scale,
      track_lookup,
      false,
      !has_ref,
      has_block_duration,
      block_duration_ns,
      st,
      frames,
    )
  }
  Ok(())
}

///| Parse a single Cluster body; returns the next byte offset after this Cluster.
///| If `allow_eof_truncation` is true and a trailing element runs past `total_len` after at least
///| one frame has been parsed, stops cleanly at `end` (progressive download / partial MSE chunk).
fn parse_cluster_body(
  data : Bytes,
  cluster_elem_offset : Int,
  start : Int,
  end : Int,
  total_len : Int,
  is_unknown : Bool,
  allow_eof_truncation : Bool,
  timestamp_scale : Int64,
  track_lookup : TrackLookup,
  st : ParseState,
  depth : Int,
  clusters : Array[ClusterInfo],
  frames : Array[Frame],
) -> Result[Int, WebmError] {
  match check_depth(st, depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if clusters.length() >= st.limits.max_clusters {
    return Err(WebmError::LimitExceeded("max_clusters exceeded"))
  }
  let first_frame_idx = frames.length()
  let mut has_timestamp = false
  let mut cluster_ts = 0L
  let mut pos = start

  let max_elems = st.limits.max_elements
  let max_frames = st.limits.max_frames
  let scale_is_1ms = timestamp_scale == 1000000L
  let fv = track_lookup.fast_valid
  let fd = track_lookup.fast_dur

  while pos < end {
    // P2-10: Zero-Result inline fast path for 1-byte SimpleBlock (0xA3) with 1..2 byte size,
    // 1-byte track number (1..15), and no lacing.
    let b0 = data[pos].to_int()
    if b0 == 0xA3 && pos + 2 <= end {
      let sb0 = data[pos + 1].to_int()
      let mut fast_sz = -1
      let mut fast_pstart = 0
      if (sb0 & 0x80) != 0 && sb0 != 0xFF {
        fast_sz = sb0 & 0x7F
        fast_pstart = pos + 2
      } else if (sb0 & 0x40) != 0 && pos + 3 <= end {
        let s2 = ((sb0 & 0x3F) << 8) | data[pos + 2].to_int()
        if s2 != 0x3FFF {
          fast_sz = s2
          fast_pstart = pos + 3
        }
      }
      if fast_sz >= 5 {
        let fast_pend = fast_pstart + fast_sz
        if fast_pend <= end {
          let tb0 = data[fast_pstart].to_int()
          if (tb0 & 0x80) != 0 && tb0 != 0xFF {
            let tn_i = tb0 & 0x7F
            if tn_i > 0 && tn_i < 16 && fv[tn_i] {
              let flags = data[fast_pstart + 3].to_int()
              if (flags & 0x06) == 0 {
                // Fast path hit!
                st.elements_visited = st.elements_visited + 1
                if st.elements_visited > max_elems {
                  return Err(WebmError::LimitExceeded("max_elements exceeded"))
                }
                if frames.length() >= max_frames {
                  return Err(WebmError::LimitExceeded("max_frames exceeded"))
                }
                let raw_rel = (data[fast_pstart + 1].to_int() << 8) |
                data[fast_pstart + 2].to_int()
                let rel_ts : Int64 = if raw_rel >= 32768 {
                  (raw_rel - 65536).to_int64()
                } else {
                  raw_rel.to_int64()
                }
                if scale_is_1ms &&
                cluster_ts >= -safe_1e6_ticks &&
                cluster_ts <= safe_1e6_ticks - 65536L {
                  let abs_ticks = cluster_ts + rel_ts
                  let pts_ns = abs_ticks * 1000000L
                  frames.push(Frame::{
                    track_number: tn_i.to_int64(),
                    offset: (fast_pstart + 4).to_int64(),
                    size: fast_sz - 4,
                    pts_ns: pts_ns,
                    pts_ms: abs_ticks,
                    duration_ns: fd[tn_i],
                    is_keyframe: (flags & 0x80) != 0,
                    invisible: (flags & 0x08) != 0,
                  })
                  pos = fast_pend
                  continue
                } else {
                  let abs_ticks = match checked_add_i64(cluster_ts, rel_ts) {
                    Ok(v) => v
                    Err(e) => return Err(e)
                  }
                  let pts_ns = match
                  checked_mul_i64(abs_ticks, timestamp_scale) {
                    Ok(v) => v
                    Err(e) => return Err(e)
                  }
                  frames.push(Frame::{
                    track_number: tn_i.to_int64(),
                    offset: (fast_pstart + 4).to_int64(),
                    size: fast_sz - 4,
                    pts_ns: pts_ns,
                    pts_ms: ns_to_ms_floor(pts_ns),
                    duration_ns: fd[tn_i],
                    is_keyframe: (flags & 0x80) != 0,
                    invisible: (flags & 0x08) != 0,
                  })
                  pos = fast_pend
                  continue
                }
              }
            }
          }
        }
      }
    }

    let vid = match read_vint_id(data, pos, end) {
      Ok(v) => v
      Err(e) => {
        if allow_eof_truncation && frames.length() > 0 && end == total_len {
          pos = end
          break
        }
        return Err(e)
      }
    }
    if is_unknown && is_cluster_boundary_id(vid.id) {
      break
    }
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, end) {
      Ok(v) => v
      Err(e) => {
        if allow_eof_truncation && frames.length() > 0 && end == total_len {
          pos = end
          break
        }
        return Err(e)
      }
    }
    let pstart = vsz.next_offset
    let pend = match resolve_definite_end(pstart, vsz, end) {
      Ok(v) => v
      Err(e) => {
        if allow_eof_truncation &&
        !vsz.is_unknown &&
        frames.length() > 0 &&
        end == total_len {
          pos = end
          break
        }
        return Err(e)
      }
    }
    if vid.id == id_timestamp {
      cluster_ts = match
      read_nonneg_u64(data, pstart, pend - pstart, "Cluster.Timestamp") {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_timestamp = true
    } else if vid.id == id_simple_block {
      match
      parse_block_payload(
        data,
        pstart,
        pend,
        cluster_ts,
        timestamp_scale,
        track_lookup,
        true,
        false,
        false,
        0L,
        st,
        frames,
      ) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if vid.id == id_block_group {
      match
      parse_block_group_body(
        data,
        pstart,
        pend,
        cluster_ts,
        timestamp_scale,
        track_lookup,
        st,
        depth + 1,
        frames,
      ) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    pos = pend
  }

  // P2-7: Reject completely empty Cluster (missing mandatory Timestamp and 0 frames)
  if !has_timestamp && frames.length() == first_frame_idx {
    return Err(
      WebmError::InvalidElementData("Cluster missing mandatory Timestamp"),
    )
  }

  let ts_ns = match checked_mul_i64(cluster_ts, timestamp_scale) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let ts_ms = ns_to_ms_floor(ts_ns)
  clusters.push(ClusterInfo::{
    offset: cluster_elem_offset.to_int64(),
    size: (pos - start).to_int64(),
    is_unknown_size: is_unknown,
    timestamp: cluster_ts,
    timestamp_ms: ts_ms,
    first_frame_index: first_frame_idx,
    frame_count: frames.length() - first_frame_idx,
  })
  Ok(pos)
}

fn parse_container(
  data : Bytes,
  limits : DecodeLimits,
  init_only : Bool,
) -> Result[WebmFile, WebmError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let st = ParseState::{
    limits: limits,
    elements_visited: 0,
    total_cue_positions: 0,
  }
  let total_len = data.length()
  let mut pos = 0

  let mut has_header = false
  let mut header = default_ebml_header()
  let mut has_segment = false
  let mut seg_data_offset = 0L
  let mut seg_unknown = false
  let mut seg_eof_truncated = false
  let mut has_info = false
  let mut info = default_segment_info()
  let tracks : Array[TrackEntry] = []
  let mut track_lookup_built = false
  let mut track_lookup = build_track_lookup(tracks)
  let cues : Array[CuePoint] = []
  let mut cues_need_rescale = false
  let clusters : Array[ClusterInfo] = []
  let deferred_clusters : Array[DeferredCluster] = []
  let frames : Array[Frame] = []

  // Top-level loop: find EBML header and Segment
  while pos < total_len {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, total_len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, total_len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    if vid.id == id_ebml {
      let pend = match resolve_definite_end(pstart, vsz, total_len) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      header = match parse_ebml_header_body(data, pstart, pend, st, 1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      has_header = true
      pos = pend
    } else if vid.id == id_segment {
      if !has_header {
        return Err(
          WebmError::MissingRequiredElement(
            "Segment encountered before EBML Header",
          ),
        )
      }
      has_segment = true
      seg_data_offset = pstart.to_int64()
      seg_unknown = vsz.is_unknown
      let seg_end = if vsz.is_unknown {
        total_len
      } else {
        let rem : Int64 = (total_len - pstart).to_int64()
        if vsz.size < 0L {
          return Err(
            WebmError::TruncatedData("negative Segment size"),
          )
        } else if vsz.size > rem {
          // P2-8: Partial download — Segment extends past EOF; allow reading complete children
          if pstart >= total_len {
            return Err(
              WebmError::TruncatedData("Segment payload exceeds file length"),
            )
          }
          seg_eof_truncated = true
          total_len
        } else {
          pstart + vsz.size.to_int()
        }
      }
      let mut spos = pstart
      while spos < seg_end {
        let cvid = match read_vint_id(data, spos, seg_end) {
          Ok(v) => v
          Err(e) => {
            if seg_eof_truncated && frames.length() > 0 {
              break
            }
            return Err(e)
          }
        }
        if seg_unknown && is_segment_boundary_id(cvid.id) {
          break
        }
        if init_only && cvid.id == id_cluster {
          break
        }
        match count_element(st) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let cvsz = match read_vint_size(data, cvid.next_offset, seg_end) {
          Ok(v) => v
          Err(e) => {
            if seg_eof_truncated && frames.length() > 0 {
              break
            }
            return Err(e)
          }
        }
        let cpstart = cvsz.next_offset
        if cvid.id == id_info {
          let cpend = match resolve_definite_end(cpstart, cvsz, seg_end) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          info = match parse_info_body(data, cpstart, cpend, st, 2) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          has_info = true
          spos = cpend
        } else if cvid.id == id_tracks {
          let cpend = match resolve_definite_end(cpstart, cvsz, seg_end) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match parse_tracks_body(data, cpstart, cpend, st, 2, tracks) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          track_lookup = build_track_lookup(tracks)
          track_lookup_built = true
          spos = cpend
        } else if cvid.id == id_cues {
          let cpend = match resolve_definite_end(cpstart, cvsz, seg_end) {
            Ok(v) => v
            Err(e) => {
              if seg_eof_truncated && !cvsz.is_unknown && frames.length() > 0 {
                break
              }
              return Err(e)
            }
          }
          if !has_info {
            cues_need_rescale = true
          }
          match
          parse_cues_body(
            data,
            cpstart,
            cpend,
            info.timestamp_scale,
            has_info,
            st,
            2,
            cues,
          ) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          spos = cpend
        } else if cvid.id == id_cluster {
          let mut cluster_eof_trunc = false
          let c_end = if cvsz.is_unknown {
            seg_end
          } else {
            let crem : Int64 = (seg_end - cpstart).to_int64()
            if cvsz.size < 0L {
              return Err(WebmError::TruncatedData("negative Cluster size"))
            } else if cvsz.size > crem {
              if seg_eof_truncated && seg_end == total_len && frames.length() > 0 {
                cluster_eof_trunc = true
                seg_end
              } else {
                return Err(
                  WebmError::TruncatedData(
                    "Cluster payload exceeds enclosing bounds",
                  ),
                )
              }
            } else {
              cpstart + cvsz.size.to_int()
            }
          }
          // P2-6: If Info or Tracks haven't appeared yet and this Cluster has definite size,
          // defer parsing its body until Info and Tracks are loaded.
          if (!has_info || !track_lookup_built) && !cvsz.is_unknown && !cluster_eof_trunc {
            deferred_clusters.push(DeferredCluster::{
              elem_offset: spos,
              payload_start: cpstart,
              payload_end: c_end,
            })
            spos = c_end
          } else {
            if !track_lookup_built {
              track_lookup = build_track_lookup(tracks)
              track_lookup_built = true
            }
            spos = match
            parse_cluster_body(
              data,
              spos,
              cpstart,
              c_end,
              total_len,
              cvsz.is_unknown,
              seg_eof_truncated || cluster_eof_trunc,
              info.timestamp_scale,
              track_lookup,
              st,
              2,
              clusters,
              frames,
            ) {
              Ok(next_pos) => next_pos
              Err(e) => {
                if (seg_eof_truncated || cluster_eof_trunc) && frames.length() > 0 {
                  break
                }
                return Err(e)
              }
            }
          }
        } else {
          let cpend = match resolve_definite_end(cpstart, cvsz, seg_end) {
            Ok(v) => v
            Err(e) => {
              if seg_eof_truncated && !cvsz.is_unknown && frames.length() > 0 {
                break
              }
              return Err(e)
            }
          }
          spos = cpend
        }
      }
      pos = if seg_unknown || seg_eof_truncated { spos } else { seg_end }
      break
    } else if vid.id == id_void || vid.id == id_crc32 {
      let pend = match resolve_definite_end(pstart, vsz, total_len) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      pos = pend
    } else {
      return Err(
        WebmError::InvalidHeader(
          "unexpected top-level EBML element ID before Segment",
        ),
      )
    }
  }

  if !has_header {
    return Err(WebmError::MissingRequiredElement("missing EBML Header"))
  }
  if !has_segment {
    return Err(WebmError::MissingRequiredElement("missing Segment element"))
  }
  if init_only && !has_info {
    return Err(
      WebmError::MissingRequiredElement(
        "missing Info element in MSE init segment",
      ),
    )
  }

  // P2-6: Rescale Cues parsed before Info once Info's TimestampScale is known
  if cues_need_rescale {
    let mut ci = 0
    while ci < cues.length() {
      let cp = cues[ci]
      let time_ns = match checked_mul_i64(cp.time, info.timestamp_scale) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      cues[ci] = CuePoint::{
        time: cp.time,
        time_ms: ns_to_ms_floor(time_ns),
        positions: cp.positions,
      }
      ci = ci + 1
    }
  }

  // P2-6: Parse any Clusters that appeared before Info / Tracks
  if deferred_clusters.length() > 0 {
    if !track_lookup_built {
      track_lookup = build_track_lookup(tracks)
      track_lookup_built = true
    }
    let mut di = 0
    while di < deferred_clusters.length() {
      let dc = deferred_clusters[di]
      let _ = match
      parse_cluster_body(
        data,
        dc.elem_offset,
        dc.payload_start,
        dc.payload_end,
        total_len,
        false,
        seg_eof_truncated,
        info.timestamp_scale,
        track_lookup,
        st,
        2,
        clusters,
        frames,
      ) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      di = di + 1
    }
  }

  // If Segment was truncated and produced no frames and no tracks, treat as TruncatedData
  if seg_eof_truncated && frames.length() == 0 && (!init_only || tracks.length() == 0) {
    return Err(
      WebmError::TruncatedData("Segment truncated before any complete frames"),
    )
  }

  Ok(WebmFile::{
    header: header,
    segment_data_offset: seg_data_offset,
    segment_is_unknown_size: seg_unknown,
    info: info,
    tracks: tracks,
    cues: cues,
    clusters: clusters,
    frames: frames,
  })
}

///| Parse a complete WebM/Matroska file with default resource limits.
pub fn parse_webm(data : Bytes) -> Result[WebmFile, WebmError] {
  parse_webm_with_limits(data, DecodeLimits::default())
}

///| Parse a complete WebM/Matroska file with explicit resource limits.
pub fn parse_webm_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[WebmFile, WebmError] {
  parse_container(data, limits, false)
}

///| Parse a W3C MSE WebM Initialization Segment (EBML Header + Segment + Info + Tracks).
pub fn parse_init_segment(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[WebmInitSegment, WebmError] {
  let f = match parse_container(data, limits, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if f.tracks.length() == 0 {
    return Err(
      WebmError::MissingRequiredElement(
        "missing Tracks in MSE initialization segment",
      ),
    )
  }
  Ok(WebmInitSegment::{
    header: f.header,
    segment_data_offset: f.segment_data_offset,
    segment_is_unknown_size: f.segment_is_unknown_size,
    info: f.info,
    tracks: f.tracks,
    cues: f.cues,
  })
}

///| Parse a W3C MSE WebM Media Segment (one or more standalone Cluster elements).
pub fn parse_media_segment(
  init : WebmInitSegment,
  data : Bytes,
  limits : DecodeLimits,
) -> Result[WebmMediaSegment, WebmError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let st = ParseState::{
    limits: limits,
    elements_visited: 0,
    total_cue_positions: 0,
  }
  let total_len = data.length()
  let mut pos = 0
  let clusters : Array[ClusterInfo] = []
  let frames : Array[Frame] = []
  let track_lookup = build_track_lookup(init.tracks)

  while pos < total_len {
    match count_element(st) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let vid = match read_vint_id(data, pos, total_len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let vsz = match read_vint_size(data, vid.next_offset, total_len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let pstart = vsz.next_offset
    if vid.id == id_cluster {
      let c_end = if vsz.is_unknown {
        total_len
      } else {
        match resolve_definite_end(pstart, vsz, total_len) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
      }
      // P2-11: Use depth 2 consistently with parse_webm (Segment child level)
      pos = match
      parse_cluster_body(
        data,
        pos,
        pstart,
        c_end,
        total_len,
        vsz.is_unknown,
        false,
        init.info.timestamp_scale,
        track_lookup,
        st,
        2,
        clusters,
        frames,
      ) {
        Ok(next_pos) => next_pos
        Err(e) => return Err(e)
      }
    } else if vid.id == id_void || vid.id == id_crc32 || vid.id == id_cues {
      let pend = match resolve_definite_end(pstart, vsz, total_len) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      pos = pend
    } else {
      return Err(
        WebmError::InvalidElementData(
          "unexpected element in MSE media segment (expected Cluster)",
        ),
      )
    }
  }

  if clusters.length() == 0 {
    return Err(
      WebmError::MissingRequiredElement(
        "expected at least one Cluster in MSE media segment",
      ),
    )
  }

  let has_frames = frames.length() > 0
  let mut start_pts_ms = 0L
  let mut end_pts_ms = 0L
  if has_frames {
    start_pts_ms = frames[0].pts_ms
    let first_end_ns = match
    checked_add_i64(frames[0].pts_ns, frames[0].duration_ns) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    end_pts_ms = ns_to_ms_floor(first_end_ns)
    let mut i = 1
    let n = frames.length()
    while i < n {
      let fr = frames[i]
      if fr.pts_ms < start_pts_ms {
        start_pts_ms = fr.pts_ms
      }
      let f_end_ns = match checked_add_i64(fr.pts_ns, fr.duration_ns) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let f_end_ms = ns_to_ms_floor(f_end_ns)
      if f_end_ms > end_pts_ms {
        end_pts_ms = f_end_ms
      }
      i = i + 1
    }
  }

  Ok(WebmMediaSegment::{
    clusters: clusters,
    frames: frames,
    has_frames: has_frames,
    start_pts_ms: start_pts_ms,
    end_pts_ms: end_pts_ms,
  })
}

///| Map a Matroska/WebM TrackEntry's CodecID to a standard MSE codec string.
pub fn probe_codec_string(track : TrackEntry) -> String {
  let c = track.codec_id
  if c == "V_VP8" {
    "vp8"
  } else if c == "V_VP9" {
    "vp9"
  } else if c == "V_AV1" {
    "av01"
  } else if c == "V_MPEG4/ISO/AVC" {
    "avc1"
  } else if c == "V_MPEGH/ISO/HEVC" {
    "hev1"
  } else if c == "A_OPUS" {
    "opus"
  } else if c == "A_VORBIS" {
    "vorbis"
  } else if c == "A_AAC" || c == "A_AAC/MPEG4/LC" || c == "A_AAC/MPEG2/LC" {
    "mp4a.40.2"
  } else if c == "A_FLAC" {
    "flac"
  } else {
    c
  }
}

///| Build a sorted per-track keyframe index once for O(log k) repeated seek queries.
pub fn build_keyframe_index(
  frames : Array[Frame],
  track_number : Int64,
) -> KeyframeIndex {
  let pts : Array[Int64] = []
  let idxs : Array[Int] = []
  let n = frames.length()
  let mut i = 0
  let mut sorted = true
  let mut prev_pts = i64_min
  while i < n {
    let fr = frames[i]
    if fr.track_number == track_number && fr.is_keyframe {
      if pts.length() > 0 && fr.pts_ms < prev_pts {
        sorted = false
      }
      prev_pts = fr.pts_ms
      pts.push(fr.pts_ms)
      idxs.push(i)
    }
    i = i + 1
  }
  // Stable insertion sort only when keyframes are out of pts order (e.g. reordered GOPs)
  if !sorted {
    let k = pts.length()
    let mut a = 1
    while a < k {
      let key_p = pts[a]
      let key_i = idxs[a]
      let mut b = a - 1
      while b >= 0 && pts[b] > key_p {
        pts[b + 1] = pts[b]
        idxs[b + 1] = idxs[b]
        b = b - 1
      }
      pts[b + 1] = key_p
      idxs[b + 1] = key_i
      a = a + 1
    }
  }
  KeyframeIndex::{
    track_number: track_number,
    pts_ms: pts,
    frame_indices: idxs,
  }
}

///| Binary-search a prebuilt `KeyframeIndex` in O(log k) time.
pub fn KeyframeIndex::find_at(
  self : KeyframeIndex,
  target_pts_ms : Int64,
) -> Option[Int] {
  let k = self.pts_ms.length()
  if k == 0 {
    return None
  }
  let mut lo = 0
  let mut hi = k
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if self.pts_ms[mid] <= target_pts_ms {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo == 0 {
    None
  } else {
    Some(self.frame_indices[lo - 1])
  }
}

///| Find the keyframe index of `track_number` with the largest `pts_ms <= target_pts_ms`
///| (ties broken by last frame in file order). Handles interleaved tracks and B-frame reordering.
pub fn find_keyframe_at(
  frames : Array[Frame],
  track_number : Int64,
  target_pts_ms : Int64,
) -> Option[Int] {
  let n = frames.length()
  if n == 0 {
    return None
  }
  let mut best = -1
  let mut best_pts = i64_min
  let mut i = 0
  while i < n {
    let fr = frames[i]
    if fr.is_keyframe && fr.track_number == track_number && fr.pts_ms <= target_pts_ms {
      if best < 0 || fr.pts_ms >= best_pts {
        best = i
        best_pts = fr.pts_ms
      }
    }
    i = i + 1
  }
  if best < 0 {
    None
  } else {
    Some(best)
  }
}
