///| RFC 8794 EBML low-level variable-length integer and primitive value readers.

///| Exact IEEE-754 binary32 (float32) to binary64 (Double) bit-level conversion.
fn float32_to_double(bits : Int64) -> Double {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return Double::from_bits(sign << 63)
    }
    let mut f = frac
    let mut e64 = 897 // 1023 - 126
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return Double::from_bits((sign << 63) | (e64.to_int64() << 52) | mant)
  }
  if exp == 255 {
    if frac == 0L {
      return Double::from_bits((sign << 63) | (0x7FFL << 52))
    }
    let mant : Int64 = frac << 29
    return Double::from_bits((sign << 63) | (0x7FFL << 52) | mant)
  }
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  Double::from_bits((sign << 63) | (e64 << 52) | mant)
}

///| Read an EBML Element ID (1..4 bytes, marker bit preserved).
///| Rejects 0x00, >4-byte IDs, and RFC 8794 forbidden all-0 / all-1 VINT_DATA.
pub fn read_vint_id(
  data : Bytes,
  offset : Int,
  end : Int,
) -> Result[VintId, WebmError] {
  if offset < 0 || end < offset || end > data.length() {
    return Err(WebmError::BoundsExceeded("read_vint_id slice out of bounds"))
  }
  if offset >= end {
    return Err(WebmError::TruncatedData("unexpected EOF while reading Element ID"))
  }
  let b0 = data[offset].to_int()
  if b0 == 0 {
    return Err(WebmError::InvalidVint("zero leading byte in Element ID"))
  }
  let len = if (b0 & 0x80) != 0 {
    1
  } else if (b0 & 0x40) != 0 {
    2
  } else if (b0 & 0x20) != 0 {
    3
  } else if (b0 & 0x10) != 0 {
    4
  } else {
    return Err(WebmError::InvalidVint("Element ID length exceeds 4 bytes"))
  }
  if offset + len > end {
    return Err(WebmError::TruncatedData("truncated Element ID"))
  }
  let mut id : Int64 = b0.to_int64()
  let mut i = 1
  while i < len {
    id = (id << 8) | data[offset + i].to_int().to_int64()
    i = i + 1
  }
  let data_mask : Int64 = (1L << (7 * len)) - 1L
  let vint_data = id & data_mask
  if vint_data == 0L || vint_data == data_mask {
    return Err(
      WebmError::InvalidVint("reserved all-zero or all-one Element ID"),
    )
  }
  Ok(VintId::{ id: id, next_offset: offset + len, length: len })
}

///| Read an EBML unsigned VINT size (1..8 bytes, detecting all-ones unknown-size).
pub fn read_vint_size(
  data : Bytes,
  offset : Int,
  end : Int,
) -> Result[VintSize, WebmError] {
  if offset < 0 || end < offset || end > data.length() {
    return Err(WebmError::BoundsExceeded("read_vint_size slice out of bounds"))
  }
  if offset >= end {
    return Err(WebmError::TruncatedData("unexpected EOF while reading VINT size"))
  }
  let b0 = data[offset].to_int()
  if b0 == 0 {
    return Err(WebmError::InvalidVint("zero leading byte in VINT size"))
  }
  let len = if (b0 & 0x80) != 0 {
    1
  } else if (b0 & 0x40) != 0 {
    2
  } else if (b0 & 0x20) != 0 {
    3
  } else if (b0 & 0x10) != 0 {
    4
  } else if (b0 & 0x08) != 0 {
    5
  } else if (b0 & 0x04) != 0 {
    6
  } else if (b0 & 0x02) != 0 {
    7
  } else {
    8
  }
  if offset + len > end {
    return Err(WebmError::TruncatedData("truncated VINT size"))
  }
  let first_mask = (1 << (8 - len)) - 1
  let mut acc : Int64 = (b0 & first_mask).to_int64()
  let mut i = 1
  while i < len {
    acc = (acc << 8) | data[offset + i].to_int().to_int64()
    i = i + 1
  }
  let all_ones : Int64 = (1L << (7 * len)) - 1L
  if acc == all_ones {
    return Ok(VintSize::{
      size: -1L,
      is_unknown: true,
      next_offset: offset + len,
      length: len,
    })
  }
  Ok(VintSize::{
    size: acc,
    is_unknown: false,
    next_offset: offset + len,
    length: len,
  })
}

///| Read an EBML signed VINT (1..8 bytes, used for EBML lacing deltas).
pub fn read_signed_vint(
  data : Bytes,
  offset : Int,
  end : Int,
) -> Result[SignedVint, WebmError] {
  if offset < 0 || end < offset || end > data.length() {
    return Err(
      WebmError::BoundsExceeded("read_signed_vint slice out of bounds"),
    )
  }
  if offset >= end {
    return Err(
      WebmError::TruncatedData("unexpected EOF while reading signed VINT"),
    )
  }
  let b0 = data[offset].to_int()
  if b0 == 0 {
    return Err(WebmError::InvalidVint("zero leading byte in signed VINT"))
  }
  let len = if (b0 & 0x80) != 0 {
    1
  } else if (b0 & 0x40) != 0 {
    2
  } else if (b0 & 0x20) != 0 {
    3
  } else if (b0 & 0x10) != 0 {
    4
  } else if (b0 & 0x08) != 0 {
    5
  } else if (b0 & 0x04) != 0 {
    6
  } else if (b0 & 0x02) != 0 {
    7
  } else {
    8
  }
  if offset + len > end {
    return Err(WebmError::TruncatedData("truncated signed VINT"))
  }
  let first_mask = (1 << (8 - len)) - 1
  let mut raw : Int64 = (b0 & first_mask).to_int64()
  let mut i = 1
  while i < len {
    raw = (raw << 8) | data[offset + i].to_int().to_int64()
    i = i + 1
  }
  let bias : Int64 = (1L << (7 * len - 1)) - 1L
  Ok(SignedVint::{
    value: raw - bias,
    next_offset: offset + len,
    length: len,
  })
}

///| Read a big-endian unsigned integer of 0..8 bytes.
pub fn read_be_uint(
  data : Bytes,
  offset : Int,
  size : Int,
) -> Result[Int64, WebmError] {
  if size < 0 || size > 8 {
    return Err(
      WebmError::InvalidElementData("unsigned integer length must be 0..8"),
    )
  }
  if offset < 0 || offset + size > data.length() {
    return Err(WebmError::BoundsExceeded("read_be_uint out of bounds"))
  }
  let mut acc : Int64 = 0L
  let mut i = 0
  while i < size {
    acc = (acc << 8) | data[offset + i].to_int().to_int64()
    i = i + 1
  }
  Ok(acc)
}

///| Read a big-endian signed integer of 0..8 bytes.
pub fn read_be_sint(
  data : Bytes,
  offset : Int,
  size : Int,
) -> Result[Int64, WebmError] {
  if size < 0 || size > 8 {
    return Err(
      WebmError::InvalidElementData("signed integer length must be 0..8"),
    )
  }
  if offset < 0 || offset + size > data.length() {
    return Err(WebmError::BoundsExceeded("read_be_sint out of bounds"))
  }
  if size == 0 {
    return Ok(0L)
  }
  let first = data[offset].to_int()
  let mut acc : Int64 = if (first & 0x80) != 0 { -1L } else { 0L }
  let mut i = 0
  while i < size {
    acc = (acc << 8) | data[offset + i].to_int().to_int64()
    i = i + 1
  }
  Ok(acc)
}

///| Read a big-endian IEEE 754 float (0, 4, or 8 bytes).
pub fn read_be_float(
  data : Bytes,
  offset : Int,
  size : Int,
) -> Result[Double, WebmError] {
  if offset < 0 || size < 0 || offset + size > data.length() {
    return Err(WebmError::BoundsExceeded("read_be_float out of bounds"))
  }
  if size == 0 {
    return Ok(0.0)
  }
  if size == 4 {
    let bits : Int64 = (data[offset].to_int().to_int64() << 24) |
    (data[offset + 1].to_int().to_int64() << 16) |
    (data[offset + 2].to_int().to_int64() << 8) |
    data[offset + 3].to_int().to_int64()
    return Ok(float32_to_double(bits))
  }
  if size == 8 {
    let bits : Int64 = (data[offset].to_int().to_int64() << 56) |
    (data[offset + 1].to_int().to_int64() << 48) |
    (data[offset + 2].to_int().to_int64() << 40) |
    (data[offset + 3].to_int().to_int64() << 32) |
    (data[offset + 4].to_int().to_int64() << 24) |
    (data[offset + 5].to_int().to_int64() << 16) |
    (data[offset + 6].to_int().to_int64() << 8) |
    data[offset + 7].to_int().to_int64()
    return Ok(Double::from_bits(bits))
  }
  Err(WebmError::InvalidElementData("float element must be 0, 4, or 8 bytes"))
}
