///| Public types, errors, and resource limits for `packages/webm`.
///| Pure Pion implementation of RFC 8794 EBML, Matroska/WebM demuxing, and W3C MSE WebM Byte Stream parsing.

///| Default maximum number of tracks allowed in a WebM/Matroska container.
pub let default_max_tracks : Int = 128

///| Default maximum number of clusters allowed in a single parse.
pub let default_max_clusters : Int = 1048576

///| Default maximum number of frames allowed in a single parse.
pub let default_max_frames : Int = 1048576

///| Default maximum number of cue points allowed in a single parse.
pub let default_max_cues : Int = 1048576

///| Default maximum number of laced frames allowed in a single Block/SimpleBlock.
pub let default_max_laced_frames : Int = 256

///| Default maximum CodecPrivate payload size in bytes (4 MiB).
pub let default_max_codec_private_bytes : Int = 4194304

///| Default maximum string element size in bytes (64 KiB).
pub let default_max_string_bytes : Int = 65536

///| Default maximum total EBML elements visited in a single parse.
pub let default_max_elements : Int = 4194304

///| Default maximum EBML nesting depth.
pub let default_max_depth : Int = 32

///| TrackType constants (Matroska specification).
pub let track_type_video : Int = 1
pub let track_type_audio : Int = 2
pub let track_type_complex : Int = 3
pub let track_type_logo : Int = 16
pub let track_type_subtitle : Int = 17
pub let track_type_buttons : Int = 18
pub let track_type_control : Int = 32

///| Resource limits enforced during EBML/WebM parsing.
///| Any negative field is immediately rejected with `WebmError::InvalidLimits`.
///| A value of `0` strictly means 0 items/bytes allowed.
pub val struct DecodeLimits {
  pub max_tracks : Int
  pub max_clusters : Int
  pub max_frames : Int
  pub max_cues : Int
  pub max_laced_frames : Int
  pub max_codec_private_bytes : Int
  pub max_string_bytes : Int
  pub max_elements : Int
  pub max_depth : Int
}

///| Default resource limits for WebM/Matroska parsing.
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_tracks: default_max_tracks,
    max_clusters: default_max_clusters,
    max_frames: default_max_frames,
    max_cues: default_max_cues,
    max_laced_frames: default_max_laced_frames,
    max_codec_private_bytes: default_max_codec_private_bytes,
    max_string_bytes: default_max_string_bytes,
    max_elements: default_max_elements,
    max_depth: default_max_depth,
  }
}

///| Construct custom resource limits.
pub fn DecodeLimits::new(
  max_tracks : Int,
  max_clusters : Int,
  max_frames : Int,
  max_cues : Int,
  max_laced_frames : Int,
  max_codec_private_bytes : Int,
  max_string_bytes : Int,
  max_elements : Int,
  max_depth : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_tracks: max_tracks,
    max_clusters: max_clusters,
    max_frames: max_frames,
    max_cues: max_cues,
    max_laced_frames: max_laced_frames,
    max_codec_private_bytes: max_codec_private_bytes,
    max_string_bytes: max_string_bytes,
    max_elements: max_elements,
    max_depth: max_depth,
  }
}

///| Error returned by EBML/WebM parsing operations.
pub enum WebmError {
  InvalidLimits(String)
  InvalidVint(String)
  TruncatedData(String)
  BoundsExceeded(String)
  InvalidHeader(String)
  InvalidElementData(String)
  InvalidBlock(String)
  MissingRequiredElement(String)
  LimitExceeded(String)
}

///| Human-readable description of a `WebmError`.
pub fn webm_error_message(err : WebmError) -> String {
  match err {
    InvalidLimits(msg) => "invalid decode limits: " + msg
    InvalidVint(msg) => "invalid EBML VINT: " + msg
    TruncatedData(msg) => "truncated data: " + msg
    BoundsExceeded(msg) => "bounds exceeded: " + msg
    InvalidHeader(msg) => "invalid EBML/WebM header: " + msg
    InvalidElementData(msg) => "invalid EBML element data: " + msg
    InvalidBlock(msg) => "invalid Matroska block: " + msg
    MissingRequiredElement(msg) => "missing required element: " + msg
    LimitExceeded(msg) => "decode limit exceeded: " + msg
  }
}

///|
pub fn WebmError::to_string(self : WebmError) -> String {
  webm_error_message(self)
}

///| Decoded EBML Element ID (RFC 8794, 1..4 bytes with marker bit preserved).
pub val struct VintId {
  pub id : Int64
  pub next_offset : Int
  pub length : Int
}

///| Decoded EBML unsigned VINT size (RFC 8794, 1..8 bytes with unknown-size detection).
pub val struct VintSize {
  pub size : Int64
  pub is_unknown : Bool
  pub next_offset : Int
  pub length : Int
}

///| Decoded EBML signed VINT (used in EBML lacing deltas).
pub val struct SignedVint {
  pub value : Int64
  pub next_offset : Int
  pub length : Int
}

///| Parsed EBML Header (`0x1A45DFA3`).
pub val struct EbmlHeader {
  pub ebml_version : Int64
  pub ebml_read_version : Int64
  pub ebml_max_id_length : Int64
  pub ebml_max_size_length : Int64
  pub doc_type : String
  pub doc_type_version : Int64
  pub doc_type_read_version : Int64
}

///| Parsed Segment Info (`0x1549A966`).
pub val struct SegmentInfo {
  pub timestamp_scale : Int64
  pub duration : Double
  pub has_duration : Bool
  pub duration_ms : Int64
  pub muxing_app : String
  pub writing_app : String
}

///| Video track metadata (`0xE0`).
pub val struct VideoTrackInfo {
  pub pixel_width : Int64
  pub pixel_height : Int64
  pub display_width : Int64
  pub display_height : Int64
  pub alpha_mode : Int64
}

///| Audio track metadata (`0xE1`).
pub val struct AudioTrackInfo {
  pub sampling_frequency : Double
  pub output_sampling_frequency : Double
  pub channels : Int64
  pub bit_depth : Int64
}

///| Parsed TrackEntry (`0xAE`).
pub struct TrackEntry {
  pub track_number : Int64
  pub track_uid : Int64
  pub track_type : Int
  pub flag_default : Bool
  pub flag_lacing : Bool
  pub default_duration : Int64
  pub language : String
  pub codec_id : String
  pub codec_private : Bytes
  pub codec_delay : Int64
  pub seek_pre_roll : Int64
  pub video : Option[VideoTrackInfo]
  pub audio : Option[AudioTrackInfo]
}

///| Parsed CueTrackPositions (`0xB7`).
pub val struct CueTrackPosition {
  pub track : Int64
  pub cluster_position : Int64
  pub relative_position : Int64
}

///| Parsed CuePoint (`0xBB`).
pub struct CuePoint {
  pub time : Int64
  pub time_ms : Int64
  pub positions : Array[CueTrackPosition]
}

///| Zero-copy frame index produced from SimpleBlock / BlockGroup.
pub val struct Frame {
  pub track_number : Int64
  pub offset : Int64
  pub size : Int
  pub pts_ns : Int64
  pub pts_ms : Int64
  pub duration_ns : Int64
  pub is_keyframe : Bool
  pub invisible : Bool
}

///| Cluster summary metadata (`0x1F43B675`).
pub val struct ClusterInfo {
  pub offset : Int64
  pub size : Int64
  pub is_unknown_size : Bool
  pub timestamp : Int64
  pub timestamp_ms : Int64
  pub first_frame_index : Int
  pub frame_count : Int
}

///| Complete parsed WebM/Matroska file.
pub struct WebmFile {
  pub header : EbmlHeader
  pub segment_data_offset : Int64
  pub segment_is_unknown_size : Bool
  pub info : SegmentInfo
  pub tracks : Array[TrackEntry]
  pub cues : Array[CuePoint]
  pub clusters : Array[ClusterInfo]
  pub frames : Array[Frame]
}

///| Parsed W3C MSE WebM Initialization Segment (EBML Header + Segment + Info + Tracks).
pub struct WebmInitSegment {
  pub header : EbmlHeader
  pub segment_data_offset : Int64
  pub segment_is_unknown_size : Bool
  pub info : SegmentInfo
  pub tracks : Array[TrackEntry]
  pub cues : Array[CuePoint]
}

///| Parsed W3C MSE WebM Media Segment (one or more Clusters).
pub struct WebmMediaSegment {
  pub clusters : Array[ClusterInfo]
  pub frames : Array[Frame]
  pub has_frames : Bool
  pub start_pts_ms : Int64
  pub end_pts_ms : Int64
}

///| Sorted per-track keyframe index for O(log k) repeated seek queries.
pub struct KeyframeIndex {
  pub track_number : Int64
  pub pts_ms : Array[Int64]
  pub frame_indices : Array[Int]
}
