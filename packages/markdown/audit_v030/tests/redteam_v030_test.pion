///| RED-TEAM evidence for `packages/markdown` v0.3.0 (`5e9cca5`): `Document` AST + `plain_text`.
///| A FAILING test is evidence of a defect. Prefixes:
///|   p0_ / p1_ / p2_ : defects (gating: run_audit.sh exits 1 while any of them fails);
///|   gap_            : advertised capability with no implementation (reported, not gating);
///|   pre_            : pre-existing defect outside the v0.3.0 diff (reported, not gating);
///|   ok_             : guard rails that pass today (gating: a failure is a regression).
///| Expectations state the property a fix must have, not one particular output, so a fix branch
///| reruns this file unchanged.  Run: pionc test -p markdown_redteam_v030 packages/markdown/audit_v030/tests

import "markdown"

///|
fn find(s : String, sub : String) -> Int {
  let n = s.length()
  let m = sub.length()
  if m == 0 {
    return 0
  }
  let mut i = 0
  while i + m <= n {
    let mut j = 0
    while j < m && s.code_unit_at(i + j) == sub.code_unit_at(j) {
      j = j + 1
    }
    if j == m {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn has(s : String, sub : String) -> Bool {
  find(s, sub) >= 0
}

///|
fn ends_with(s : String, suf : String) -> Bool {
  let n = s.length()
  let m = suf.length()
  if m > n {
    return false
  }
  let mut j = 0
  while j < m {
    if s.code_unit_at(n - m + j) != suf.code_unit_at(j) {
      return false
    }
    j = j + 1
  }
  true
}

///|
fn cps(s : String) -> Int {
  let mut c = 0
  let mut i = 0
  while i < s.length() {
    if (s.code_unit_at(i) & 0xC0) != 0x80 {
      c = c + 1
    }
    i = i + 1
  }
  c
}

///|
fn opts(collapse : Bool, max_chars : Int) -> markdown::PlainTextOptions {
  markdown::PlainTextOptions::{
    image_placeholder: "[图片]",
    link_placeholder: "[链接]",
    code_block_placeholder: "[代码]",
    math_placeholder: "[公式]",
    collapse_whitespace: collapse,
    max_chars,
  }
}

///|
fn pt(src : String) -> String {
  markdown::to_plain_text(src, markdown::Options::gfm(), markdown::PlainTextOptions::default())
}

///|
fn pt_with(src : String, o : markdown::PlainTextOptions) -> String {
  markdown::to_plain_text(src, markdown::Options::gfm(), o)
}

// ───────────────────────────── P1 ─────────────────────────────

///| [P1-1] `<script>` body of an HTML block leaks into the plain-text preview (plain_text.pion:182-237)
test "p1_html_block_script_body_leaks" {
  let got = pt("<script>\nalert(document.cookie)\n</script>\n\nafter\n")
  debug_assert(!has(got, "alert") && !has(got, "cookie"), "script body leaked: [" + got + "]")
  debug_assert(has(got, "after"), "text after the script block lost: [" + got + "]")
}

///| [P1-1] `<style>` body of an HTML block leaks (CSS shows up as preview text)
test "p1_html_block_style_body_leaks" {
  let got = pt("<style>\nbody{color:red}\n</style>\n\nvisible\n")
  debug_assert(!has(got, "color") && !has(got, "{"), "style body leaked: [" + got + "]")
  debug_assert(has(got, "visible"), "text after style block lost: [" + got + "]")
}

///| [P1-1] inline `<script>`: HtmlInline("<script>") + Text + HtmlInline("</script>"); the Text is emitted
test "p1_inline_script_body_leaks" {
  let got = pt("hi <script>alert(1)</script> there\n")
  debug_assert(!has(got, "alert"), "inline script body leaked: [" + got + "]")
  debug_assert(has(got, "hi") && has(got, "there"), "surrounding text lost: [" + got + "]")
}

///| [P1-1] inline `<style>` the same way
test "p1_inline_style_body_leaks" {
  let got = pt("a <style>p{x:y}</style> b\n")
  debug_assert(!has(got, "p{x:y}"), "inline style body leaked: [" + got + "]")
}

///| [P1-2] a real `<` inside an HTML block is taken as a tag start and swallows text up to the next `>`
test "p1_html_block_less_than_swallows_text" {
  let got = pt("<div>\n1 < 2 && 3 > 2\n</div>\n")
  debug_assert(has(got, "1 < 2 && 3 > 2"), "comparison swallowed: [" + got + "]")
}

///| [P1-2] `<` followed by a space is not a tag (HTML tokenizer: tag name must start with ASCII alpha)
test "p1_html_block_less_than_drops_tail" {
  let got = pt("<div>\nprice < 100 yuan\n</div>\n")
  debug_assert(has(got, "100 yuan"), "text after '<' lost: [" + got + "]")
}

///| [P1-2] an unterminated `<` drops the whole rest of the HTML block
test "p1_html_block_unterminated_lt_drops_rest" {
  let got = pt("<div>\na <3 b and more text\n")
  debug_assert(has(got, "more text"), "rest of block lost after unterminated '<': [" + got + "]")
}

// ───────────────────────────── P2 ─────────────────────────────

///| [P2-1] a tail of <= 2 bytes (incl. the block's final "\n") after a closing `-->` is dropped:
///| `if j + 2 >= n` cannot tell "found near the end" from "not found"
test "p2_html_comment_tail_dropped" {
  let got = pt("<!-- footnote -->1\n")
  debug_assert(has(got, "1"), "text after comment dropped: [" + got + "]")
}

///| [P2-1] `<!-->` / `<!--->` are complete (empty) comments in HTML; the stripper scans to EOF instead
test "p2_html_empty_comment_swallows_rest" {
  let got = pt("<!-->visible text\n")
  debug_assert(has(got, "visible text"), "text after <!--> dropped: [" + got + "]")
}

///| [P2-2] block-level tags other than p/div/br give no word boundary: cells and items glue together
test "p2_html_block_tags_glue_words" {
  let t = pt("<table><tr><td>alpha</td><td>beta</td></tr></table>\n")
  debug_assert(!has(t, "alphabeta"), "table cells glued: [" + t + "]")
  let l = pt("<ul><li>one</li><li>two</li></ul>\n")
  debug_assert(!has(l, "onetwo"), "list items glued: [" + l + "]")
  let h = pt("<h1>Title</h1><section>Body</section>\n")
  debug_assert(!has(h, "TitleBody"), "heading/section glued: [" + h + "]")
}

///| [P2-3] character references inside raw HTML are emitted undecoded (`&amp;` stays `&amp;`)
test "p2_html_entities_not_decoded" {
  let got = pt("<div>Tom &amp; Jerry &lt;3 &#x4F60;</div>\n")
  debug_assert(has(got, "Tom & Jerry"), "entity not decoded: [" + got + "]")
  debug_assert(has(got, "你"), "numeric reference not decoded: [" + got + "]")
}

///| [P2-4] the truncated preview ends with the block/word separator, which also eats one char of budget
test "p2_truncation_ends_with_separator" {
  let a = pt_with("hello world\n", opts(true, 6))
  debug_assert(!ends_with(a, " "), "collapse preview ends with space: [" + a + "]")
  let b = pt_with("para one\n\npara two\n", opts(false, 9))
  debug_assert(!ends_with(b, "\n") && !ends_with(b, " "), "multiline preview ends with separator: [" + b + "]")
}

///| [P2-5] multiline mode copies raw newlines of an HTML block: leading "\n" and trailing "\n\n"
test "p2_multiline_html_block_raw_newlines" {
  let got = pt_with("<div>\nx\n</div>\n\ny\n", opts(false, 0))
  debug_assert(got.length() > 0 && got.code_unit_at(0) != 10, "output starts with newline: [" + got + "]")
  debug_assert(!has(got, "\n\n\n"), "runs of raw newlines: [" + got + "]")
}

///| [P2-6] max_chars cuts inside a grapheme: ZWJ sequence left dangling / base split from combining mark
test "p2_truncation_splits_grapheme" {
  let fam = pt_with("👨\u{200D}👩\u{200D}👧 family\n", opts(true, 2))
  debug_assert(!ends_with(fam, "\u{200D}"), "preview ends with dangling ZWJ: [" + fam + "]")
  let e = pt_with("e\u{0301}tude\n", opts(true, 1))
  debug_assert(e != "e", "combining acute separated from its base: [" + e + "]")
}

// ─────────────────────── gap (not gating) ───────────────────────

///| [GAP-1] `Inline::Math` and `PlainTextOptions.math_placeholder` exist (README shows "[公式]"), but no
///| parser path ever produces `Inline::Math`: `$x^2$` stays `Inline::Text`, so the placeholder never fires.
test "gap_math_never_produced_by_parser" {
  let got = pt_with("Energy $E=mc^2$ and\n\n$$\n\\int x\n$$\n", opts(true, 0))
  debug_assert(has(got, "[公式]"), "math placeholder unreachable from parse_document: [" + got + "]")
}

// ─────────────────────── pre-existing (not gating) ───────────────────────

///| [PRE-1] parse_extended (event path) turns `[^1]` inside a fenced code block into a footnote
///| reference; parse_document_extended (AST) correctly keeps it literal, so the two APIs disagree.
test "pre_extended_events_footnote_ref_inside_code_block" {
  let src = "```\n[^1]\n```\n\n[^1]: note\n"
  let html = markdown::render_html_pulldown(markdown::parse_extended(src, markdown::ExtendedOptions::full()))
  debug_assert(has(html, "<pre><code>[^1]\n</code></pre>"), "code block content rewritten: " + html)
}

// ───────────────────────────── ok_ guard rails ─────────────────────────────

///|
test "ok_utf8_truncation_never_splits_code_points" {
  let src = "a é 你好无世界 🚀🎉 Ω\n"
  let mut mx = 1
  while mx <= 20 {
    let got = pt_with(src, opts(true, mx))
    debug_assert(cps(got) <= mx, "too many code points at max=" + mx.to_string())
    let full = pt(src)
    debug_assert(find(full, got) == 0, "truncation is not a prefix at max=" + mx.to_string() + ": " + got)
    mx = mx + 1
  }
  debug_assert(pt_with("你好世界", opts(true, 2)) == "你好", "cjk 2")
  debug_assert(pt_with("🚀🎉🔥", opts(true, 1)) == "🚀", "emoji 1")
}

///|
test "ok_max_chars_zero_and_negative_are_unlimited" {
  let src = "你好 **世界** 🚀\n"
  let full = pt(src)
  debug_assert(pt_with(src, opts(true, 0)) == full, "0 = unlimited")
  debug_assert(pt_with(src, opts(true, -1)) == full, "-1 = unlimited")
  debug_assert(pt_with(src, opts(true, -2147483648)) == full, "INT_MIN = unlimited")
}

///|
test "ok_real_less_than_in_paragraph_kept" {
  debug_assert(pt("1 < 2 && 3 > 2\n") == "1 < 2 && 3 > 2", "paragraph comparison")
}

///|
test "ok_html_attribute_with_gt_and_comment" {
  debug_assert(pt("<div title=\"a>b\">text</div>\n") == "text", "quoted > in attribute")
  debug_assert(pt("a <span title='x>y'>b</span> c\n") == "a b c", "inline quoted >")
  debug_assert(pt("x <!-- hidden --> y\n") == "x y", "inline comment hidden")
}

///|
test "ok_placeholders" {
  let got = pt_with("![](u) ![cat](u) ![*cat*](u) [](u) [click](u) [![](i)](l) [![alt](i)](l)\n", opts(true, 0))
  debug_assert(got == "[图片] cat cat [链接] click [图片] alt", "placeholders: [" + got + "]")
  let code = pt_with("```js\nlet x\n```\n\n`inline`\n", opts(true, 0))
  debug_assert(code == "[代码] inline", "code placeholder: [" + code + "]")
}

///|
test "ok_collapse_whitespace" {
  debug_assert(pt("a\tb\r\nc   d\n\n\n\ne\n") == "a b c d e", "collapse")
  let ml = pt_with("a\\\nb\n\nc\n", opts(false, 0))
  debug_assert(ml == "a\nb\nc", "multiline: [" + ml + "]")
}

///|
test "ok_ast_containers" {
  let doc = markdown::parse_document("> - a\n>\n>   ```\n>   code\n>   ```\n> - b\n\n7. x\n8. y\n", markdown::Options::gfm())
  debug_assert(doc.blocks.length() == 2, "2 top-level blocks")
  match doc.blocks[0] {
    markdown::Block::BlockQuote(ch) => match ch[0] {
      markdown::Block::List(None, tight, items) => {
        debug_assert(!tight, "loose list (blank line inside item)")
        debug_assert(items.length() == 2, "2 items")
        debug_assert(items[0].blocks.length() == 2, "para + code in item 1")
        debug_assert(items[0].blocks[1] is markdown::Block::CodeBlock(_, _, _), "code block in item")
      }
      _ => debug_assert(false, "expected bullet list in quote")
    }
    _ => debug_assert(false, "expected quote")
  }
  match doc.blocks[1] {
    markdown::Block::List(Some(s), tight, _) => {
      debug_assert(s == 7L, "start 7")
      debug_assert(tight, "tight")
    }
    _ => debug_assert(false, "expected ordered list")
  }
}

///|
test "ok_ast_tasks_and_table" {
  let doc = markdown::parse_document("- [x] a\n- [ ] b\n- [X] c\n- [y] d\n\n|a|b|c|\n|:-|:-:|-:|\n|1|\n|1|2|3|4|\n", markdown::Options::gfm())
  match doc.blocks[0] {
    markdown::Block::List(_, _, items) => {
      debug_assert(items[0].checked is Some(true), "x")
      debug_assert(items[1].checked is Some(false), "space")
      debug_assert(items[2].checked is Some(true), "X")
      debug_assert(items[3].checked is None, "[y] is not a task")
    }
    _ => debug_assert(false, "expected list")
  }
  match doc.blocks[1] {
    markdown::Block::Table(al, hd, rows) => {
      debug_assert(al.length() == 3 && hd.length() == 3, "3 columns")
      debug_assert(rows.length() == 2 && rows[0].length() == 3 && rows[1].length() == 3, "rows padded/cut to 3")
    }
    _ => debug_assert(false, "expected table")
  }
}

///|
test "ok_ast_frontmatter_and_footnotes" {
  let y = markdown::parse_document_extended("---\nt: 1\n---\n# h\n", markdown::ExtendedOptions::full())
  debug_assert(y.front_matter is Some(_), "yaml")
  let t = markdown::parse_document_extended("+++\nt = 1\n+++\n# h\n", markdown::ExtendedOptions::full())
  debug_assert(t.front_matter is Some(_), "toml")
  debug_assert(!has(markdown::to_plain_text_extended("---\nsecret: 1\n---\nbody\n", markdown::ExtendedOptions::full(), markdown::PlainTextOptions::default()), "secret"), "frontmatter hidden")
  let f = markdown::parse_document_extended("x[^n]\n\n[^n]: para\n\n    > quote\n", markdown::ExtendedOptions::full())
  match f.blocks[f.blocks.length() - 1] {
    markdown::Block::FootnoteDefinition(l, b) => {
      debug_assert(l == "n", "label")
      debug_assert(b.length() == 2, "para + nested quote in footnote")
    }
    _ => debug_assert(false, "expected footnote definition")
  }
}

///|
test "ok_deep_nesting_no_overflow" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 50000 {
    sb.write_string("> ")
    i = i + 1
  }
  sb.write_string("bq\n")
  debug_assert(pt(sb.to_string()) == "bq", "50k quotes")
  let sl = StringBuilder::new()
  i = 0
  while i < 20000 {
    sl.write_string("*a ")
    i = i + 1
  }
  sl.write_string("z")
  i = 0
  while i < 20000 {
    sl.write_string(" a*")
    i = i + 1
  }
  debug_assert(pt_with(sl.to_string(), opts(true, 5)) == "a a a", "20k nested emphasis")
}
