///| HTML renderer and escaping utilities (CommonMark 0.31.2 + GFM).

///| Write raw byte span `s[start..end]` to `sb`.
///| Uses zero-alloc byte loop for tiny spans (<= 16 B) and NEON memcpy via slice for longer spans.
pub fn write_raw_span(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  let len = end - start
  if len <= 0 {
    return ()
  }
  if len > 48 {
    if start == 0 && end == s.length() {
      sb.write_string(s)
    } else {
      sb.write_string(s.slice(start, end))
    }
    return ()
  }
  let mut i = start
  while i < end {
    sb.write_byte(s.code_unit_at(i).to_byte())
    i = i + 1
  }
}

///| Write HTML-escaped span `s[start..end]` to `sb` using chunked bulk writes.
///| When `escape_quote` is false, escapes `&`, `<`, `>` only (matching `pulldown-cmark-escape`).
///| When `escape_quote` is true, also escapes `"`.
pub fn write_html_escaped_span(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  escape_quote : Bool,
) -> Unit {
  if start >= end {
    return ()
  }
  let mut mark = start
  let mut i = start
  if escape_quote {
    while i < end {
      let b = s.code_unit_at(i)
      if b <= 62 && (b == 38 || b == 60 || b == 62 || b == 34) {
        if mark < i {
          write_raw_span(sb, s, mark, i)
        }
        if b == 38 {
          sb.write_string("&amp;")
        } else if b == 60 {
          sb.write_string("&lt;")
        } else if b == 62 {
          sb.write_string("&gt;")
        } else {
          sb.write_string("&quot;")
        }
        mark = i + 1
      }
      i = i + 1
    }
  } else {
    while i < end {
      let b = s.code_unit_at(i)
      if b <= 62 && (b == 38 || b == 60 || b == 62) {
        if mark < i {
          write_raw_span(sb, s, mark, i)
        }
        if b == 38 {
          sb.write_string("&amp;")
        } else if b == 60 {
          sb.write_string("&lt;")
        } else {
          sb.write_string("&gt;")
        }
        mark = i + 1
      }
      i = i + 1
    }
  }
  if mark < end {
    write_raw_span(sb, s, mark, end)
  }
}

///| Write HTML-escaped body text to `sb` (`&`, `<`, `>` only, matching `pulldown-cmark-escape`).
pub fn escape_html_body(sb : StringBuilder, s : String) -> Unit {
  write_html_escaped_span(sb, s, 0, s.length(), false)
}

///| Write HTML-escaped text to `sb` (`&`, `<`, `>`, `"`). Zero allocation.
pub fn escape_html(sb : StringBuilder, s : String) -> Unit {
  write_html_escaped_span(sb, s, 0, s.length(), true)
}

///| Write an uppercase hex nibble (0..15) to `sb`.
fn write_hex_nibble(sb : StringBuilder, nib : Int) -> Unit {
  if nib < 10 {
    sb.write_byte((48 + nib).to_byte())
  } else {
    sb.write_byte((55 + nib).to_byte())
  }
}

///| Returns true if byte `b` (< 128) is safe unencoded in an `href`/`src` attribute.
fn is_href_safe(b : Int) -> Bool {
  if b >= 97 && b <= 122 {
    return true
  }
  if b >= 65 && b <= 90 {
    return true
  }
  if b >= 48 && b <= 57 {
    return true
  }
  match b {
    33 | 35 | 36 | 37 | 39 | 40 | 41 | 42 | 43 | 44 | 45 | 46 | 47 | 58 | 59 | 61 | 63 | 64 | 95 | 126 => true
    _ => false
  }
}

///| Build a 128-byte LUT for `is_href_safe` (1 = safe, 0 = needs encoding).
pub fn make_href_safe_table() -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(128)
  let zero = (0).to_byte()
  let one = (1).to_byte()
  let mut i = 0
  while i < 128 {
    tbl.push(if is_href_safe(i) { one } else { zero })
    i = i + 1
  }
  tbl
}

///| Write a percent-encoded + HTML-escaped URL span `s[start..end]` to `sb` using prebuilt 128-byte LUT.
pub fn escape_href_span_lut(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  href_tbl : Array[Byte],
) -> Unit {
  let zero = (0).to_byte()
  let mut mark = start
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b >= 128 || href_tbl[b] == zero {
      if mark < i {
        write_raw_span(sb, s, mark, i)
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else {
        sb.write_byte((37).to_byte())
        write_hex_nibble(sb, (b >> 4) & 15)
        write_hex_nibble(sb, b & 15)
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < end {
    write_raw_span(sb, s, mark, end)
  }
}

///| Write a percent-encoded + HTML-escaped URL span `s[start..end]` to `sb` with zero allocation.
pub fn escape_href_span(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b < 128 && is_href_safe(b) {
      sb.write_byte(b.to_byte())
    } else if b == 38 {
      sb.write_string("&amp;")
    } else {
      sb.write_byte((37).to_byte())
      write_hex_nibble(sb, (b >> 4) & 15)
      write_hex_nibble(sb, b & 15)
    }
    i = i + 1
  }
}

///| Write a percent-encoded + HTML-escaped URL to `sb`.
pub fn escape_href(sb : StringBuilder, s : String) -> Unit {
  escape_href_span(sb, s, 0, s.length())
}

fn ends_with_newline(s : String) -> Bool {
  let n = s.length()
  n > 0 && s.code_unit_at(n - 1) == 10
}

fn write_tracked(sb : StringBuilder, s : String, end_nl : Bool) -> Bool {
  sb.write_string(s)
  if s.length() > 0 {
    ends_with_newline(s)
  } else {
    end_nl
  }
}

///| Write the first whitespace-delimited word from a fenced code info string (HTML-escaped) to `sb`.
pub fn write_first_info_word_escaped(sb : StringBuilder, info : String) -> Unit {
  let n = info.length()
  let mut i = 0
  while i < n {
    let b = info.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      break
    }
    i = i + 1
  }
  write_html_escaped_span(sb, info, 0, i, true)
}

///| Extract the first whitespace-delimited word from a fenced code info string.
fn first_info_word(info : String) -> String {
  let n = info.length()
  let mut i = 0
  while i < n {
    let b = info.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      return info.slice(0, i)
    }
    i = i + 1
  }
  info
}

///| Render a flat event stream into CommonMark/GFM-compliant HTML.
pub fn render_html_events(events : Array[Event]) -> String {
  render_html_impl(events, false)
}

///| Render a flat event stream with `pulldown-cmark::html::push_html` byte-for-byte formatting compatibility.
pub fn render_html_pulldown_events(events : Array[Event]) -> String {
  render_html_impl(events, true)
}

fn render_html_impl(events : Array[Event], pulldown_compat : Bool) -> String {
  let sb = StringBuilder::new()
  let n = events.length()
  let mut i = 0
  let mut end_nl = true
  let mut in_table_head = false
  let mut table_has_tbody = false
  let mut table_alignments : Array[Alignment] = Array::new()
  let mut table_cell_idx = 0

  while i < n {
    let ev = events[i]
    match ev {
      Event::Start(tag) => match tag {
        Tag::HtmlBlock => {
          if !end_nl {
            sb.write_byte((10).to_byte())
            end_nl = true
          }
        }
        Tag::Paragraph => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<p>")
          end_nl = false
        }
        Tag::Heading(level) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<h")
          sb.write_string(level.to_string())
          sb.write_byte((62).to_byte())
          end_nl = false
        }
        Tag::BlockQuote => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<blockquote>\n")
          end_nl = true
        }
        Tag::CodeBlock(kind) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          match kind {
            CodeBlockKind::Indented => sb.write_string("<pre><code>")
            CodeBlockKind::Fenced(info) => {
              let lang = first_info_word(info)
              if lang.length() == 0 {
                sb.write_string("<pre><code>")
              } else {
                sb.write_string("<pre><code class=\"language-")
                escape_html(sb, lang)
                sb.write_string("\">")
              }
            }
          }
          end_nl = false
        }
        Tag::List(start_opt) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          match start_opt {
            None => sb.write_string("<ul>\n")
            Some(start) => if start == 1 {
              sb.write_string("<ol>\n")
            } else {
              sb.write_string("<ol start=\"")
              sb.write_string(start.to_string())
              sb.write_string("\">\n")
            }
          }
          end_nl = true
        }
        Tag::Item => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<li>")
          end_nl = false
        }
        Tag::Table(aligns) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          table_alignments = aligns
          table_has_tbody = false
          if pulldown_compat {
            sb.write_string("<table>")
            end_nl = false
          } else {
            sb.write_string("<table>\n")
            end_nl = true
          }
        }
        Tag::TableHead => {
          in_table_head = true
          table_cell_idx = 0
          if pulldown_compat {
            sb.write_string("<thead><tr>")
            end_nl = false
          } else {
            sb.write_string("<thead>\n<tr>\n")
            end_nl = true
          }
        }
        Tag::TableRow => {
          if !pulldown_compat && !table_has_tbody {
            sb.write_string("<tbody>\n")
            table_has_tbody = true
          }
          table_cell_idx = 0
          if pulldown_compat {
            sb.write_string("<tr>")
            end_nl = false
          } else {
            sb.write_string("<tr>\n")
            end_nl = true
          }
        }
        Tag::TableCell => {
          if in_table_head {
            sb.write_string("<th")
          } else {
            sb.write_string("<td")
          }
          if table_cell_idx < table_alignments.length() {
            match table_alignments[table_cell_idx] {
              Alignment::Left => sb.write_string(" style=\"text-align: left\">")
              Alignment::Center => sb.write_string(" style=\"text-align: center\">")
              Alignment::Right => sb.write_string(" style=\"text-align: right\">")
              Alignment::None => sb.write_byte((62).to_byte())
            }
          } else {
            sb.write_byte((62).to_byte())
          }
          end_nl = false
        }
        Tag::Emphasis => {
          sb.write_string("<em>")
          end_nl = false
        }
        Tag::Strong => {
          sb.write_string("<strong>")
          end_nl = false
        }
        Tag::Strikethrough => {
          sb.write_string("<del>")
          end_nl = false
        }
        Tag::Link(link_type, dest, title, _id) => {
          match link_type {
            LinkType::Email => {
              sb.write_string("<a href=\"mailto:")
              escape_href(sb, dest)
            }
            _ => {
              sb.write_string("<a href=\"")
              escape_href(sb, dest)
            }
          }
          if title.length() > 0 {
            sb.write_string("\" title=\"")
            escape_html(sb, title)
          }
          sb.write_string("\">")
          end_nl = false
        }
        Tag::Image(_link_type, dest, title, _id) => {
          sb.write_string("<img src=\"")
          escape_href(sb, dest)
          sb.write_string("\" alt=\"")
          // Collect raw alt text until matching End(Image)
          let mut nest = 0
          i = i + 1
          while i < n {
            match events[i] {
              Event::Start(_) => nest = nest + 1
              Event::End(_) => {
                if nest == 0 {
                  break
                }
                nest = nest - 1
              }
              Event::Text(t) => escape_html(sb, t)
              Event::Code(t) => escape_html(sb, t)
              Event::InlineHtml(t) => escape_html(sb, t)
              Event::SoftBreak => sb.write_byte((10).to_byte())
              Event::HardBreak => sb.write_byte((10).to_byte())
              _ => ()
            }
            i = i + 1
          }
          if title.length() > 0 {
            sb.write_string("\" title=\"")
            escape_html(sb, title)
          }
          sb.write_string("\" />")
          end_nl = false
        }
      }
      Event::End(tag_end) => match tag_end {
        TagEnd::HtmlBlock => ()
        TagEnd::Paragraph => {
          sb.write_string("</p>\n")
          end_nl = true
        }
        TagEnd::Heading(level) => {
          sb.write_string("</h")
          sb.write_string(level.to_string())
          sb.write_string(">\n")
          end_nl = true
        }
        TagEnd::BlockQuote => {
          sb.write_string("</blockquote>\n")
          end_nl = true
        }
        TagEnd::CodeBlock => {
          sb.write_string("</code></pre>\n")
          end_nl = true
        }
        TagEnd::List(ordered) => {
          if ordered {
            sb.write_string("</ol>\n")
          } else {
            sb.write_string("</ul>\n")
          }
          end_nl = true
        }
        TagEnd::Item => {
          sb.write_string("</li>\n")
          end_nl = true
        }
        TagEnd::Table => {
          if pulldown_compat {
            sb.write_string("</tbody></table>\n")
          } else if table_has_tbody {
            sb.write_string("</tbody>\n</table>\n")
          } else {
            sb.write_string("<tbody></tbody>\n</table>\n")
          }
          end_nl = true
        }
        TagEnd::TableHead => {
          if pulldown_compat {
            sb.write_string("</tr></thead><tbody>\n")
          } else {
            sb.write_string("</tr>\n</thead>\n")
          }
          in_table_head = false
          end_nl = true
        }
        TagEnd::TableRow => {
          sb.write_string("</tr>\n")
          end_nl = true
        }
        TagEnd::TableCell => {
          if pulldown_compat {
            if in_table_head {
              sb.write_string("</th>")
            } else {
              sb.write_string("</td>")
            }
            end_nl = false
          } else {
            if in_table_head {
              sb.write_string("</th>\n")
            } else {
              sb.write_string("</td>\n")
            }
            end_nl = true
          }
          table_cell_idx = table_cell_idx + 1
        }
        TagEnd::Emphasis => {
          sb.write_string("</em>")
          end_nl = false
        }
        TagEnd::Strong => {
          sb.write_string("</strong>")
          end_nl = false
        }
        TagEnd::Strikethrough => {
          sb.write_string("</del>")
          end_nl = false
        }
        TagEnd::Link => {
          sb.write_string("</a>")
          end_nl = false
        }
        TagEnd::Image => ()
      }
      Event::Text(text) => {
        if pulldown_compat {
          escape_html_body(sb, text)
        } else {
          escape_html(sb, text)
        }
        if text.length() > 0 {
          end_nl = ends_with_newline(text)
        }
      }
      Event::Code(code) => {
        sb.write_string("<code>")
        if pulldown_compat {
          escape_html_body(sb, code)
        } else {
          escape_html(sb, code)
        }
        sb.write_string("</code>")
        end_nl = false
      }
      Event::Html(html) => {
        end_nl = write_tracked(sb, html, end_nl)
      }
      Event::InlineHtml(html) => {
        end_nl = write_tracked(sb, html, end_nl)
      }
      Event::SoftBreak => {
        sb.write_byte((10).to_byte())
        end_nl = true
      }
      Event::HardBreak => {
        sb.write_string("<br />\n")
        end_nl = true
      }
      Event::Rule => {
        if !end_nl {
          sb.write_byte((10).to_byte())
        }
        sb.write_string("<hr />\n")
        end_nl = true
      }
      Event::TaskListMarker(checked) => {
        if checked {
          sb.write_string("<input disabled=\"\" type=\"checkbox\" checked=\"\"/>\n")
        } else {
          sb.write_string("<input disabled=\"\" type=\"checkbox\"/>\n")
        }
        end_nl = true
      }
    }
    i = i + 1
  }
  sb.to_string()
}
