///| HTML renderer and escaping utilities (CommonMark 0.31.2 + GFM).

///| Write raw byte span `s[start..end]` to `sb` using zero-alloc `write_substring`.
pub fn write_raw_span(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  if start < end {
    sb.write_substring(s, start, end)
  }
}

///| Build a 256-byte LUT for HTML escaping:
///| 0 = normal, 1 = `&`, 2 = `<`, 3 = `>`, 4 = `"` (when `escape_quote` is true).
pub fn make_html_escape_table(escape_quote : Bool) -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(256)
  let zero = (0).to_byte()
  let mut i = 0
  while i < 256 {
    tbl.push(zero)
    i = i + 1
  }
  tbl[38] = (1).to_byte() // '&'
  tbl[60] = (2).to_byte() // '<'
  tbl[62] = (3).to_byte() // '>'
  if escape_quote {
    tbl[34] = (4).to_byte() // '"'
  }
  tbl
}

///| Write HTML-escaped span `s[start..end]` to `sb` using a prebuilt 256-byte LUT (4x unrolled) and `write_substring`.
pub fn write_html_escaped_span_lut(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  esc_tbl : Array[Byte],
) -> Unit {
  if start >= end {
    return ()
  }
  let zero = (0).to_byte()
  let one = (1).to_byte()
  let two = (2).to_byte()
  let three = (3).to_byte()
  let mut mark = start
  let mut i = start
  let end4 = end - 3
  while i < end {
    while i < end4 {
      let m = esc_tbl[s.code_unit_at(i)].to_int() |
      esc_tbl[s.code_unit_at(i + 1)].to_int() |
      esc_tbl[s.code_unit_at(i + 2)].to_int() |
      esc_tbl[s.code_unit_at(i + 3)].to_int()
      if m != 0 {
        break
      }
      i = i + 4
    }
    while i < end {
      let code = esc_tbl[s.code_unit_at(i)]
      if code != zero {
        if mark < i {
          sb.write_substring(s, mark, i)
        }
        if code == one {
          sb.write_string("&amp;")
        } else if code == two {
          sb.write_string("&lt;")
        } else if code == three {
          sb.write_string("&gt;")
        } else {
          sb.write_string("&quot;")
        }
        mark = i + 1
        i = i + 1
        break
      }
      i = i + 1
    }
  }
  if mark < end {
    sb.write_substring(s, mark, end)
  }
}

///| Write HTML-escaped span `s[start..end]` to `sb` using chunked bulk writes.
///| When `escape_quote` is false, escapes `&`, `<`, `>` only (matching `pulldown-cmark-escape`).
///| When `escape_quote` is true, also escapes `"`.
pub fn write_html_escaped_span(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  escape_quote : Bool,
) -> Unit {
  if start >= end {
    return ()
  }
  let mut mark = start
  let mut i = start
  if escape_quote {
    while i < end {
      let b = s.code_unit_at(i)
      if b <= 62 && (b == 38 || b == 60 || b == 62 || b == 34) {
        if mark < i {
          sb.write_substring(s, mark, i)
        }
        if b == 38 {
          sb.write_string("&amp;")
        } else if b == 60 {
          sb.write_string("&lt;")
        } else if b == 62 {
          sb.write_string("&gt;")
        } else {
          sb.write_string("&quot;")
        }
        mark = i + 1
      }
      i = i + 1
    }
  } else {
    while i < end {
      let b = s.code_unit_at(i)
      if b <= 62 && (b == 38 || b == 60 || b == 62) {
        if mark < i {
          sb.write_substring(s, mark, i)
        }
        if b == 38 {
          sb.write_string("&amp;")
        } else if b == 60 {
          sb.write_string("&lt;")
        } else {
          sb.write_string("&gt;")
        }
        mark = i + 1
      }
      i = i + 1
    }
  }
  if mark < end {
    sb.write_substring(s, mark, end)
  }
}

///| Write HTML-escaped body text to `sb` (`&`, `<`, `>` only, matching `pulldown-cmark-escape`).
pub fn escape_html_body(sb : StringBuilder, s : String) -> Unit {
  write_html_escaped_span(sb, s, 0, s.length(), false)
}

///| Write HTML-escaped text to `sb` (`&`, `<`, `>`, `"`). Zero allocation.
pub fn escape_html(sb : StringBuilder, s : String) -> Unit {
  write_html_escaped_span(sb, s, 0, s.length(), true)
}

///| Write an uppercase hex nibble (0..15) to `sb`.
fn write_hex_nibble(sb : StringBuilder, nib : Int) -> Unit {
  if nib < 10 {
    sb.write_byte((48 + nib).to_byte())
  } else {
    sb.write_byte((55 + nib).to_byte())
  }
}

///| Returns true if byte `b` (< 128) is safe unencoded in an `href`/`src` attribute.
fn is_href_safe(b : Int) -> Bool {
  if b >= 97 && b <= 122 {
    return true
  }
  if b >= 65 && b <= 90 {
    return true
  }
  if b >= 48 && b <= 57 {
    return true
  }
  match b {
    33 | 35 | 36 | 37 | 39 | 40 | 41 | 42 | 43 | 44 | 45 | 46 | 47 | 58 | 59 | 61 | 63 | 64 | 95 | 126 => true
    _ => false
  }
}

///| Build a 256-byte LUT for `is_href_safe` (1 = safe, 0 = needs encoding; triggers [0, 255] BCE).
pub fn make_href_safe_table() -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(256)
  let zero = (0).to_byte()
  let one = (1).to_byte()
  let mut i = 0
  while i < 128 {
    tbl.push(if is_href_safe(i) { one } else { zero })
    i = i + 1
  }
  while i < 256 {
    tbl.push(zero)
    i = i + 1
  }
  tbl
}

///| Write a percent-encoded + HTML-escaped URL span `s[start..end]` to `sb` using prebuilt 256-byte LUT.
pub fn escape_href_span_lut(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  href_tbl : Array[Byte],
) -> Unit {
  let zero = (0).to_byte()
  let mut mark = start
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if href_tbl[b] == zero {
      if mark < i {
        sb.write_substring(s, mark, i)
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else {
        sb.write_byte((37).to_byte())
        write_hex_nibble(sb, (b >> 4) & 15)
        write_hex_nibble(sb, b & 15)
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < end {
    sb.write_substring(s, mark, end)
  }
}

///| Write a percent-encoded + HTML-escaped URL span `s[start..end]` to `sb` with zero allocation.
pub fn escape_href_span(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  let mut mark = start
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if !(b < 128 && is_href_safe(b)) {
      if mark < i {
        sb.write_substring(s, mark, i)
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else {
        sb.write_byte((37).to_byte())
        write_hex_nibble(sb, (b >> 4) & 15)
        write_hex_nibble(sb, b & 15)
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < end {
    sb.write_substring(s, mark, end)
  }
}

///| Write a percent-encoded + HTML-escaped URL to `sb`.
pub fn escape_href(sb : StringBuilder, s : String) -> Unit {
  escape_href_span(sb, s, 0, s.length())
}

fn ends_with_newline(s : String) -> Bool {
  let n = s.length()
  n > 0 && s.code_unit_at(n - 1) == 10
}

fn write_tracked(sb : StringBuilder, s : String, end_nl : Bool) -> Bool {
  sb.write_string(s)
  if s.length() > 0 {
    ends_with_newline(s)
  } else {
    end_nl
  }
}

///| Write the first whitespace-delimited word from a fenced code info string (HTML-escaped) to `sb`.
pub fn write_first_info_word_escaped(sb : StringBuilder, info : String) -> Unit {
  let n = info.length()
  let mut i = 0
  while i < n {
    let b = info.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      break
    }
    i = i + 1
  }
  write_html_escaped_span(sb, info, 0, i, true)
}

///| Extract the first whitespace-delimited word from a fenced code info string.
fn first_info_word(info : String) -> String {
  let n = info.length()
  let mut i = 0
  while i < n {
    let b = info.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      return info.slice(0, i)
    }
    i = i + 1
  }
  info
}

///| Render a flat event stream into CommonMark/GFM-compliant HTML.
pub fn render_html_events(events : Array[Event]) -> String {
  render_html_impl(events, false)
}

///| Render a flat event stream with `pulldown-cmark::html::push_html` byte-for-byte formatting compatibility.
pub fn render_html_pulldown_events(events : Array[Event]) -> String {
  render_html_impl(events, true)
}

fn render_html_impl(events : Array[Event], pulldown_compat : Bool) -> String {
  let n = events.length()
  let sb = StringBuilder::with_capacity(n * 24 + 64)
  let esc_tbl = make_html_escape_table(!pulldown_compat)
  let esc_attr_tbl = make_html_escape_table(true)
  let href_tbl = make_href_safe_table()
  let mut i = 0
  let mut end_nl = true
  let mut in_table_head = false
  let mut table_has_tbody = false
  let mut table_alignments : Array[Alignment] = Array::new()
  let mut table_cell_idx = 0
  let mut in_metadata = false
  let fn_numbers : Map[String, Int] = Map::new()
  let mut fn_next_num = 1

  while i < n {
    let ev = events[i]
    if in_metadata {
      match ev {
        Event::End(TagEnd::MetadataBlock(_)) => in_metadata = false
        _ => ()
      }
      i = i + 1
      continue
    }
    match ev {
      Event::Start(tag) => match tag {
        Tag::HtmlBlock => {
          if !pulldown_compat && !end_nl {
            sb.write_byte((10).to_byte())
            end_nl = true
          }
        }
        Tag::Paragraph => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<p>")
          end_nl = false
        }
        Tag::Heading(level) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          if level >= 1 && level <= 6 {
            sb.write_string("<h")
            sb.write_byte((48 + level).to_byte())
            sb.write_byte((62).to_byte())
          } else {
            sb.write_string("<h")
            sb.write_string(level.to_string())
            sb.write_byte((62).to_byte())
          }
          end_nl = false
        }
        Tag::BlockQuote => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<blockquote>\n")
          end_nl = true
        }
        Tag::CodeBlock(kind) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          match kind {
            CodeBlockKind::Indented => sb.write_string("<pre><code>")
            CodeBlockKind::Fenced(info) => {
              let ilen = info.length()
              let mut iw = 0
              while iw < ilen {
                let b = info.code_unit_at(iw)
                if b == 32 || b == 9 || b == 10 || b == 13 {
                  break
                }
                iw = iw + 1
              }
              if iw == 0 {
                sb.write_string("<pre><code>")
              } else {
                sb.write_string("<pre><code class=\"language-")
                write_html_escaped_span_lut(sb, info, 0, iw, esc_attr_tbl)
                sb.write_string("\">")
              }
            }
          }
          end_nl = false
        }
        Tag::List(start_opt) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          match start_opt {
            None => sb.write_string("<ul>\n")
            Some(start) => if start == 1 {
              sb.write_string("<ol>\n")
            } else {
              sb.write_string("<ol start=\"")
              sb.write_string(start.to_string())
              sb.write_string("\">\n")
            }
          }
          end_nl = true
        }
        Tag::Item => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          sb.write_string("<li>")
          end_nl = false
        }
        Tag::Table(aligns) => {
          table_alignments = aligns
          table_has_tbody = false
          if pulldown_compat {
            sb.write_string("<table>")
            end_nl = false
          } else {
            if !end_nl {
              sb.write_byte((10).to_byte())
            }
            sb.write_string("<table>\n")
            end_nl = true
          }
        }
        Tag::TableHead => {
          in_table_head = true
          table_cell_idx = 0
          if pulldown_compat {
            sb.write_string("<thead><tr>")
            end_nl = false
          } else {
            sb.write_string("<thead>\n<tr>\n")
            end_nl = true
          }
        }
        Tag::TableRow => {
          if !pulldown_compat && !table_has_tbody {
            sb.write_string("<tbody>\n")
            table_has_tbody = true
          }
          table_cell_idx = 0
          if pulldown_compat {
            sb.write_string("<tr>")
            end_nl = false
          } else {
            sb.write_string("<tr>\n")
            end_nl = true
          }
        }
        Tag::TableCell => {
          if in_table_head {
            sb.write_string("<th")
          } else {
            sb.write_string("<td")
          }
          if table_cell_idx < table_alignments.length() {
            match table_alignments[table_cell_idx] {
              Alignment::Left => sb.write_string(" style=\"text-align: left\">")
              Alignment::Center => sb.write_string(" style=\"text-align: center\">")
              Alignment::Right => sb.write_string(" style=\"text-align: right\">")
              Alignment::None => sb.write_byte((62).to_byte())
            }
          } else {
            sb.write_byte((62).to_byte())
          }
          end_nl = false
        }
        Tag::Emphasis => {
          sb.write_string("<em>")
          end_nl = false
        }
        Tag::Strong => {
          sb.write_string("<strong>")
          end_nl = false
        }
        Tag::Strikethrough => {
          sb.write_string("<del>")
          end_nl = false
        }
        Tag::Link(link_type, dest, title, _id) => {
          match link_type {
            LinkType::Email => {
              sb.write_string("<a href=\"mailto:")
              escape_href_span_lut(sb, dest, 0, dest.length(), href_tbl)
            }
            _ => {
              sb.write_string("<a href=\"")
              escape_href_span_lut(sb, dest, 0, dest.length(), href_tbl)
            }
          }
          if title.length() > 0 {
            sb.write_string("\" title=\"")
            write_html_escaped_span_lut(sb, title, 0, title.length(), esc_attr_tbl)
          }
          sb.write_string("\">")
          end_nl = false
        }
        Tag::Image(_link_type, dest, title, _id) => {
          sb.write_string("<img src=\"")
          escape_href_span_lut(sb, dest, 0, dest.length(), href_tbl)
          sb.write_string("\" alt=\"")
          // Collect raw alt text until matching End(Image)
          let mut nest = 0
          i = i + 1
          while i < n {
            match events[i] {
              Event::Start(_) => nest = nest + 1
              Event::End(_) => {
                if nest == 0 {
                  break
                }
                nest = nest - 1
              }
              Event::Text(t) => write_html_escaped_span_lut(sb, t, 0, t.length(), esc_attr_tbl)
              Event::Code(t) => write_html_escaped_span_lut(sb, t, 0, t.length(), esc_attr_tbl)
              Event::InlineHtml(t) => write_html_escaped_span_lut(sb, t, 0, t.length(), esc_attr_tbl)
              Event::SoftBreak => sb.write_byte((10).to_byte())
              Event::HardBreak => sb.write_byte((10).to_byte())
              _ => ()
            }
            i = i + 1
          }
          if title.length() > 0 {
            sb.write_string("\" title=\"")
            write_html_escaped_span_lut(sb, title, 0, title.length(), esc_attr_tbl)
          }
          sb.write_string("\" />")
          end_nl = false
        }
        Tag::FootnoteDefinition(name) => {
          if !end_nl {
            sb.write_byte((10).to_byte())
          }
          let num = match fn_numbers.get(name) {
            Some(v) => v
            None => {
              let v = fn_next_num
              fn_next_num = fn_next_num + 1
              fn_numbers.set(name, v)
              v
            }
          }
          sb.write_string("<div class=\"footnote-definition\" id=\"")
          escape_html(sb, name)
          sb.write_string("\"><sup class=\"footnote-definition-label\">")
          sb.write_string(num.to_string())
          sb.write_string("</sup>\n")
          end_nl = true
        }
        Tag::MetadataBlock(_) => in_metadata = true
      }
      Event::End(tag_end) => match tag_end {
        TagEnd::HtmlBlock => ()
        TagEnd::Paragraph => {
          sb.write_string("</p>\n")
          end_nl = true
        }
        TagEnd::Heading(level) => {
          if level >= 1 && level <= 6 {
            sb.write_string("</h")
            sb.write_byte((48 + level).to_byte())
            sb.write_string(">\n")
          } else {
            sb.write_string("</h")
            sb.write_string(level.to_string())
            sb.write_string(">\n")
          }
          end_nl = true
        }
        TagEnd::BlockQuote => {
          sb.write_string("</blockquote>\n")
          end_nl = true
        }
        TagEnd::CodeBlock => {
          sb.write_string("</code></pre>\n")
          end_nl = true
        }
        TagEnd::List(ordered) => {
          if ordered {
            sb.write_string("</ol>\n")
          } else {
            sb.write_string("</ul>\n")
          }
          end_nl = true
        }
        TagEnd::Item => {
          sb.write_string("</li>\n")
          end_nl = true
        }
        TagEnd::Table => {
          if pulldown_compat {
            sb.write_string("</tbody></table>\n")
          } else if table_has_tbody {
            sb.write_string("</tbody>\n</table>\n")
          } else {
            sb.write_string("<tbody></tbody>\n</table>\n")
          }
          end_nl = true
        }
        TagEnd::TableHead => {
          if pulldown_compat {
            sb.write_string("</tr></thead><tbody>\n")
          } else {
            sb.write_string("</tr>\n</thead>\n")
          }
          in_table_head = false
          end_nl = true
        }
        TagEnd::TableRow => {
          sb.write_string("</tr>\n")
          end_nl = true
        }
        TagEnd::TableCell => {
          if pulldown_compat {
            if in_table_head {
              sb.write_string("</th>")
            } else {
              sb.write_string("</td>")
            }
            end_nl = false
          } else {
            if in_table_head {
              sb.write_string("</th>\n")
            } else {
              sb.write_string("</td>\n")
            }
            end_nl = true
          }
          table_cell_idx = table_cell_idx + 1
        }
        TagEnd::Emphasis => {
          sb.write_string("</em>")
          end_nl = false
        }
        TagEnd::Strong => {
          sb.write_string("</strong>")
          end_nl = false
        }
        TagEnd::Strikethrough => {
          sb.write_string("</del>")
          end_nl = false
        }
        TagEnd::Link => {
          sb.write_string("</a>")
          end_nl = false
        }
        TagEnd::Image => ()
        TagEnd::FootnoteDefinition => {
          sb.write_string("</div>\n")
          end_nl = true
        }
        TagEnd::MetadataBlock(_) => in_metadata = false
      }
      Event::Text(text) => {
        write_html_escaped_span_lut(sb, text, 0, text.length(), esc_tbl)
        if text.length() > 0 {
          end_nl = ends_with_newline(text)
        }
      }
      Event::Code(code) => {
        sb.write_string("<code>")
        write_html_escaped_span_lut(sb, code, 0, code.length(), esc_tbl)
        sb.write_string("</code>")
        end_nl = false
      }
      Event::Html(html) => {
        end_nl = write_tracked(sb, html, end_nl)
      }
      Event::InlineHtml(html) => {
        end_nl = write_tracked(sb, html, end_nl)
      }
      Event::SoftBreak => {
        sb.write_byte((10).to_byte())
        end_nl = true
      }
      Event::HardBreak => {
        sb.write_string("<br />\n")
        end_nl = true
      }
      Event::Rule => {
        if !end_nl {
          sb.write_byte((10).to_byte())
        }
        sb.write_string("<hr />\n")
        end_nl = true
      }
      Event::TaskListMarker(checked) => {
        if checked {
          sb.write_string("<input disabled=\"\" type=\"checkbox\" checked=\"\"/>\n")
        } else {
          sb.write_string("<input disabled=\"\" type=\"checkbox\"/>\n")
        }
        end_nl = true
      }
      Event::FootnoteReference(name) => {
        let num = match fn_numbers.get(name) {
          Some(v) => v
          None => {
            let v = fn_next_num
            fn_next_num = fn_next_num + 1
            fn_numbers.set(name, v)
            v
          }
        }
        sb.write_string("<sup class=\"footnote-reference\"><a href=\"#")
        escape_html(sb, name)
        sb.write_string("\">")
        sb.write_string(num.to_string())
        sb.write_string("</a></sup>")
        end_nl = false
      }
    }
    i = i + 1
  }
  sb.to_string()
}
