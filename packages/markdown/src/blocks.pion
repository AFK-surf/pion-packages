///| CommonMark 0.31.2 + GFM Phase 1 Block Structure Parser.

///| Link reference definition (destination URL + optional title).
pub val struct LinkDef {
  pub dest : String
  pub title : String
}

///| Internal block node kinds for Phase 1 block tree.
pub enum BlockKind {
  Document
  BlockQuote
  List(Bool, Int, Int) // (ordered, delim, start_num)
  Item(Int) // content_col
  Paragraph
  Heading(Int)
  IndentedCode
  FencedCode(Int, Int, Int, String) // (fence_char, fence_len, fence_indent, info)
  HtmlBlock(Int) // kind 1..7
  ThematicBreak
  Table(Array[Alignment], Array[String], Array[Array[String]]) // (aligns, header, rows)
  Empty // Removed paragraph (e.g. pure link reference definitions)
}

///| Mutable block node stored in a flat arena.
pub struct BlockNode {
  pub mut kind : BlockKind
  pub children : Array[Int]
  pub lines : Array[String]
  pub mut open : Bool
  pub mut tight : Bool
  pub mut last_line_blank : Bool
  pub mut ends_with_blank : Bool
  pub mut task_checked : Option[Bool]
}

fn new_block(kind : BlockKind) -> BlockNode {
  BlockNode::{
    kind,
    children: Array::new(),
    lines: Array::new(),
    open: true,
    tight: true,
    last_line_blank: false,
    ends_with_blank: false,
    task_checked: None,
  }
}

///| Result of Phase 1 block parsing.
pub struct BlockDoc {
  pub nodes : Array[BlockNode]
  pub ref_defs : Map[String, LinkDef]
}

///| Normalize `\r\n` / `\r` -> `\n` and `\0` -> U+FFFD (zero-alloc fast path if clean).
fn normalize_input(src : String) -> String {
  let n = src.length()
  let mut i = 0
  let mut clean = true
  while i < n {
    let b = src.code_unit_at(i)
    if b == 13 || b == 0 {
      clean = false
      break
    }
    i = i + 1
  }
  if clean {
    return src
  }
  let sb = StringBuilder::new()
  let mut mark = 0
  i = 0
  while i < n {
    let b = src.code_unit_at(i)
    if b == 13 {
      if mark < i {
        sb.write_string(src.slice(mark, i))
      }
      sb.write_byte((10).to_byte())
      if i + 1 < n && src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      mark = i
    } else if b == 0 {
      if mark < i {
        sb.write_string(src.slice(mark, i))
      }
      write_utf8(sb, 0xFFFD)
      i = i + 1
      mark = i
    } else {
      i = i + 1
    }
  }
  if mark < n {
    sb.write_string(src.slice(mark, n))
  }
  sb.to_string()
}

///| Cursor over a single line with 4-space tab-stop tracking.
struct LineCursor {
  src : String
  end : Int
  mut pos : Int
  mut col : Int
  mut partial : Int // remaining spaces from a partially consumed tab
}

fn cursor_is_blank(cur : LineCursor) -> Bool {
  let mut i = cur.pos
  while i < cur.end {
    let b = cur.src.code_unit_at(i)
    if b != 32 && b != 9 {
      return false
    }
    i = i + 1
  }
  true
}

///| Peek visual indentation (in columns) to the next non-space/tab byte.
///| Returns `(indent_cols, non_ws_pos, non_ws_col)`.
fn cursor_peek_indent(cur : LineCursor) -> (Int, Int, Int) {
  let mut c = cur.col + cur.partial
  let mut i = cur.pos
  while i < cur.end {
    let b = cur.src.code_unit_at(i)
    if b == 32 {
      c = c + 1
      i = i + 1
    } else if b == 9 {
      c = c + (4 - (c % 4))
      i = i + 1
    } else {
      break
    }
  }
  (c - cur.col, i, c)
}

///| Advance cursor to the next non-space/tab byte.
fn cursor_skip_ws(cur : LineCursor) -> Unit {
  let (_, next_pos, next_col) = cursor_peek_indent(cur)
  cur.pos = next_pos
  cur.col = next_col
  cur.partial = 0
}

///| Advance cursor by up to `count` visual columns (consuming spaces and tabs partially if needed).
fn cursor_advance_cols(cur : LineCursor, count : Int) -> Unit {
  let mut rem = count
  if cur.partial > 0 {
    if cur.partial >= rem {
      cur.partial = cur.partial - rem
      cur.col = cur.col + rem
      return ()
    } else {
      cur.col = cur.col + cur.partial
      rem = rem - cur.partial
      cur.partial = 0
    }
  }
  while rem > 0 && cur.pos < cur.end {
    let b = cur.src.code_unit_at(cur.pos)
    if b == 32 {
      cur.pos = cur.pos + 1
      cur.col = cur.col + 1
      rem = rem - 1
    } else if b == 9 {
      let tab_w = 4 - (cur.col % 4)
      cur.pos = cur.pos + 1
      if tab_w > rem {
        cur.col = cur.col + rem
        cur.partial = tab_w - rem
        rem = 0
      } else {
        cur.col = cur.col + tab_w
        rem = rem - tab_w
      }
    } else {
      break
    }
  }
}

///| Advance cursor past a single non-tab ASCII byte (e.g. `>`).
fn cursor_advance_byte(cur : LineCursor) -> Unit {
  cur.pos = cur.pos + 1
  cur.col = cur.col + 1
  cur.partial = 0
}

///| Extract the remaining text of the line, prepending `cur.partial` spaces if any.
fn cursor_rest(cur : LineCursor) -> String {
  if cur.partial == 0 {
    cur.src.slice(cur.pos, cur.end)
  } else {
    let sb = StringBuilder::new()
    let mut k = 0
    while k < cur.partial {
      sb.write_byte((32).to_byte())
      k = k + 1
    }
    sb.write_string(cur.src.slice(cur.pos, cur.end))
    sb.to_string()
  }
}

fn is_container_kind(k : BlockKind) -> Bool {
  match k {
    BlockKind::Document | BlockKind::BlockQuote | BlockKind::List(_, _, _) | BlockKind::Item(_) => true
    _ => false
  }
}

///| Join paragraph lines with `\n` and extract leading link reference definitions.
///| Returns `true` if any paragraph text remains.
fn extract_ref_defs_from_para(
  node : BlockNode,
  ref_defs : Map[String, LinkDef],
) -> Bool {
  if node.lines.length() == 0 {
    return false
  }
  // Quick check: first non-space char of first line must be '['
  let first = node.lines[0]
  let mut f = 0
  while f < first.length() && first.code_unit_at(f) == 32 {
    f = f + 1
  }
  if f >= first.length() || first.code_unit_at(f) != 91 {
    return true
  }
  // Join lines with '\n'
  let sb = StringBuilder::new()
  let mut li = 0
  while li < node.lines.length() {
    if li > 0 {
      sb.write_byte((10).to_byte())
    }
    sb.write_string(node.lines[li])
    li = li + 1
  }
  let full = sb.to_string()
  let n = full.length()
  let mut pos = 0
  let mut extracted = false
  while pos < n {
    match scan_link_ref_def(full, pos, n) {
      Some((norm_label, dest, title, next_pos)) => {
        if !ref_defs.contains(norm_label) {
          ref_defs.set(norm_label, LinkDef::{ dest, title })
        }
        pos = next_pos
        extracted = true
      }
      None => break
    }
  }
  if !extracted {
    return true
  }
  node.lines.clear()
  if pos >= n {
    node.kind = BlockKind::Empty
    return false
  }
  // Split remaining text back into lines
  let mut ls = pos
  let mut i = pos
  while i <= n {
    if i == n || full.code_unit_at(i) == 10 {
      node.lines.push(full.slice(ls, i))
      ls = i + 1
    }
    i = i + 1
  }
  true
}

///| Close a block node (finalizing paragraphs, indented code trailing blanks, list tightness).
fn close_block(
  nodes : Array[BlockNode],
  idx : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
) -> Unit {
  let node = nodes[idx]
  if !node.open {
    return ()
  }
  node.open = false
  match node.kind {
    BlockKind::Paragraph => {
      let _ = extract_ref_defs_from_para(node, ref_defs)
    }
    BlockKind::IndentedCode => {
      // Strip trailing blank lines
      while node.lines.length() > 0 {
        let last = node.lines[node.lines.length() - 1]
        let mut blank = true
        let mut i = 0
        while i < last.length() {
          let b = last.code_unit_at(i)
          if b != 32 && b != 9 {
            blank = false
            break
          }
          i = i + 1
        }
        if blank {
          let _ = node.lines.pop()
        } else {
          break
        }
      }
    }
    BlockKind::List(_, _, _) => {
      // Compute list tightness: loose if any non-last item ends with blank,
      // or any item has a direct child (not last) that ends with blank.
      let mut tight = true
      let mut ci = 0
      let nc = node.children.length()
      while ci < nc && tight {
        let item_idx = node.children[ci]
        let item = nodes[item_idx]
        if ci + 1 < nc && item.ends_with_blank {
          tight = false
          break
        }
        let mut sub = 0
        let nsub = item.children.length()
        while sub < nsub {
          let sub_node = nodes[item.children[sub]]
          match sub_node.kind {
            BlockKind::Empty => ()
            _ => {
              if sub + 1 < nsub && sub_node.ends_with_blank {
                tight = false
                break
              }
            }
          }
          sub = sub + 1
        }
        ci = ci + 1
      }
      node.tight = tight
    }
    BlockKind::Item(_) => {
      // Check GFM task list marker on first Paragraph child
      if opts.tasklists && node.children.length() > 0 {
        let first_child = nodes[node.children[0]]
        match first_child.kind {
          BlockKind::Paragraph => {
            if first_child.lines.length() > 0 {
              let l0 = first_child.lines[0]
              match scan_tasklist_marker(l0, 0, l0.length()) {
                Some((checked, next_pos)) => {
                  node.task_checked = Some(checked)
                  first_child.lines[0] = l0.slice(next_pos, l0.length())
                }
                None => ()
              }
            }
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
}

///| Check if a block node (or its last non-empty descendant) ended with a blank line.
fn mark_ends_with_blank(nodes : Array[BlockNode], idx : Int) -> Unit {
  let node = nodes[idx]
  node.ends_with_blank = true
  let nc = node.children.length()
  if nc > 0 {
    let mut k = nc - 1
    while k >= 0 {
      let c = nodes[node.children[k]]
      match c.kind {
        BlockKind::Empty => k = k - 1
        _ => {
          c.ends_with_blank = true
          break
        }
      }
    }
  }
}

///| Parse `src` into a Phase 1 `BlockDoc` (arena of `BlockNode` + `ref_defs`).
pub fn parse_blocks(src : String, opts : Options) -> BlockDoc {
  let text = normalize_input(src)
  let n = text.length()
  let nodes : Array[BlockNode] = Array::new()
  let ref_defs : Map[String, LinkDef] = Map::new()
  nodes.push(new_block(BlockKind::Document))
  let open_stack : Array[Int] = Array::new()
  open_stack.push(0)

  let mut line_start = 0
  while line_start < n {
    let mut line_end = line_start
    while line_end < n && text.code_unit_at(line_end) != 10 {
      line_end = line_end + 1
    }
    let next_line_start = if line_end < n { line_end + 1 } else { n }

    let cur = LineCursor::{
      src: text,
      end: line_end,
      pos: line_start,
      col: 0,
      partial: 0,
    }

    // Step 1: Match existing open blocks from root downward
    let mut matched = 1 // root (index 0) always matches
    let mut consumed = false
    let stack_len = open_stack.length()

    while matched < stack_len {
      let bidx = open_stack[matched]
      let b = nodes[bidx]
      let (indent, non_ws, _) = cursor_peek_indent(cur)
      let blank = non_ws == cur.end

      match b.kind {
        BlockKind::BlockQuote => {
          if !blank && indent <= 3 && cur.src.code_unit_at(non_ws) == 62 {
            cursor_skip_ws(cur)
            cursor_advance_byte(cur) // consume '>'
            // Consume optional single space or 1 column of a tab
            if cur.pos < cur.end {
              let nb = cur.src.code_unit_at(cur.pos)
              if nb == 32 || nb == 9 {
                cursor_advance_cols(cur, 1)
              }
            }
            matched = matched + 1
          } else {
            break
          }
        }
        BlockKind::List(_, _, _) => {
          matched = matched + 1
        }
        BlockKind::Item(indent_width) => {
          if blank {
            // An empty list item cannot contain more than one blank line
            if b.children.length() == 0 {
              break
            }
            cursor_advance_cols(cur, indent_width)
            matched = matched + 1
          } else if indent >= indent_width {
            cursor_advance_cols(cur, indent_width)
            matched = matched + 1
          } else {
            break
          }
        }
        BlockKind::IndentedCode => {
          if indent >= 4 {
            cursor_advance_cols(cur, 4)
            matched = matched + 1
          } else if blank {
            cursor_advance_cols(cur, indent)
            matched = matched + 1
          } else {
            break
          }
        }
        BlockKind::FencedCode(fchar, flen, findent, _) => {
          if !blank && indent <= 3 && scan_code_fence_close(cur.src, non_ws, cur.end, fchar, flen) {
            close_block(nodes, bidx, ref_defs, opts)
            let _ = open_stack.pop()
            consumed = true
            break
          }
          // Strip up to `findent` columns
          if findent > 0 {
            cursor_advance_cols(cur, findent)
          }
          b.lines.push(cursor_rest(cur))
          consumed = true
          break
        }
        BlockKind::HtmlBlock(hkind) => {
          if blank && (hkind == 6 || hkind == 7) {
            break
          }
          b.lines.push(cursor_rest(cur))
          if hkind <= 5 && scan_html_block_end(cur.src, cur.pos, cur.end, hkind) {
            close_block(nodes, bidx, ref_defs, opts)
            let _ = open_stack.pop()
          }
          consumed = true
          break
        }
        BlockKind::Table(aligns, _header, rows) => {
          if blank {
            break
          }
          // Check if a block-level interrupt terminates the table
          if indent <= 3 {
            let first_b = cur.src.code_unit_at(non_ws)
            let is_atx = match scan_atx_heading(cur.src, non_ws, cur.end) {
              Some(_) => true
              None => false
            }
            let is_fence = match scan_code_fence_open(cur.src, non_ws, cur.end) {
              Some(_) => true
              None => false
            }
            let is_list = match scan_list_marker(cur.src, non_ws, cur.end, cur.col + indent, true) {
              Some(_) => true
              None => false
            }
            let interrupts = first_b == 62 ||
            is_atx ||
            is_fence ||
            scan_thematic_break(cur.src, non_ws, cur.end) ||
            scan_html_block_start(cur.src, non_ws, cur.end, true) != 0 ||
            is_list
            if interrupts {
              break
            }
          }
          let row_cells = split_table_row(cur.src, cur.pos, cur.end)
          // Normalize cell count to match aligns.length()
          let ncols = aligns.length()
          let norm_row : Array[String] = Array::new()
          let mut ci = 0
          while ci < ncols {
            if ci < row_cells.length() {
              norm_row.push(row_cells[ci])
            } else {
              norm_row.push("")
            }
            ci = ci + 1
          }
          rows.push(norm_row)
          consumed = true
          break
        }
        BlockKind::Paragraph => {
          if blank {
            break
          }
          matched = matched + 1
        }
        _ => break
      }
    }

    if consumed {
      line_start = next_line_start
      continue
    }

    // Helper: close all unmatched blocks above `matched`
    let all_matched = matched == open_stack.length()
    let tip_idx = open_stack[open_stack.length() - 1]
    let tip_is_para = match nodes[tip_idx].kind {
      BlockKind::Paragraph => true
      _ => false
    }
    let last_matched_idx = open_stack[matched - 1]

    // Step 2: Check for new block starts (unless last matched is IndentedCode)
    let mut container_idx = last_matched_idx
    let mut unmatched_closed = all_matched

    let close_unmatched = fn() -> Unit {
      if !unmatched_closed {
        while open_stack.length() > matched {
          let pop_idx = open_stack[open_stack.length() - 1]
          close_block(nodes, pop_idx, ref_defs, opts)
          let _ = open_stack.pop()
        }
        unmatched_closed = true
      }
    }

    let close_list_if_needed = fn() -> Unit {
      while open_stack.length() > 1 {
        let top_idx = open_stack[open_stack.length() - 1]
        match nodes[top_idx].kind {
          BlockKind::List(_, _, _) | BlockKind::Paragraph => {
            close_block(nodes, top_idx, ref_defs, opts)
            let _ = open_stack.pop()
          }
          _ => break
        }
      }
      container_idx = open_stack[open_stack.length() - 1]
    }

    let add_child = fn(parent_idx : Int, child : BlockNode) -> Int {
      let cidx = nodes.length()
      nodes.push(child)
      nodes[parent_idx].children.push(cidx)
      open_stack.push(cidx)
      cidx
    }

    // Can we start new blocks here?
    let mut try_starts = true
    match nodes[container_idx].kind {
      BlockKind::IndentedCode => try_starts = false
      _ => ()
    }

    while try_starts {
      let (indent, non_ws, non_ws_col) = cursor_peek_indent(cur)
      let blank = non_ws == cur.end
      if blank {
        break
      }

      let cur_tip = open_stack[open_stack.length() - 1]
      let in_para = match nodes[cur_tip].kind {
        BlockKind::Paragraph => true
        _ => false
      }

      // 1. Indented code block (only if not in paragraph)
      if indent >= 4 && !in_para && !cursor_is_blank(cur) {
        close_unmatched()
        close_list_if_needed()
        cursor_advance_cols(cur, 4)
        let cb = new_block(BlockKind::IndentedCode)
        cb.lines.push(cursor_rest(cur))
        let _ = add_child(container_idx, cb)
        consumed = true
        break
      }

      if indent <= 3 {
        let fb = cur.src.code_unit_at(non_ws)

        // 2. BlockQuote `>`
        if fb == 62 {
          close_unmatched()
          close_list_if_needed()
          cursor_skip_ws(cur)
          cursor_advance_byte(cur)
          if cur.pos < cur.end {
            let nb = cur.src.code_unit_at(cur.pos)
            if nb == 32 || nb == 9 {
              cursor_advance_cols(cur, 1)
            }
          }
          container_idx = add_child(container_idx, new_block(BlockKind::BlockQuote))
          continue
        }

        // 3. ATX Heading `#`
        if fb == 35 {
          match scan_atx_heading(cur.src, non_ws, cur.end) {
            Some((level, cs, ce)) => {
              close_unmatched()
              close_list_if_needed()
              let h = new_block(BlockKind::Heading(level))
              h.open = false
              if cs < ce {
                h.lines.push(cur.src.slice(cs, ce))
              }
              let cidx = nodes.length()
              nodes.push(h)
              nodes[container_idx].children.push(cidx)
              consumed = true
              break
            }
            None => ()
          }
        }

        // 4. Fenced Code Block
        if fb == 96 || fb == 126 {
          match scan_code_fence_open(cur.src, non_ws, cur.end) {
            Some((fchar, flen, info)) => {
              close_unmatched()
              close_list_if_needed()
              let fc = new_block(BlockKind::FencedCode(fchar, flen, indent, info))
              let _ = add_child(container_idx, fc)
              consumed = true
              break
            }
            None => ()
          }
        }

        // 5. HTML Block
        if fb == 60 {
          let hkind = scan_html_block_start(cur.src, non_ws, cur.end, in_para)
          if hkind > 0 {
            close_unmatched()
            close_list_if_needed()
            let hb = new_block(BlockKind::HtmlBlock(hkind))
            hb.lines.push(cursor_rest(cur))
            let hidx = add_child(container_idx, hb)
            if hkind <= 5 && scan_html_block_end(cur.src, cur.pos, cur.end, hkind) {
              close_block(nodes, hidx, ref_defs, opts)
              let _ = open_stack.pop()
            }
            consumed = true
            break
          }
        }

        // 6. Setext Heading underline (only if tip is Paragraph & all containers matched)
        if in_para && unmatched_closed && (fb == 61 || fb == 45) {
          match scan_setext_underline(cur.src, non_ws, cur.end) {
            Some(level) => {
              let para = nodes[cur_tip]
              if extract_ref_defs_from_para(para, ref_defs) {
                para.kind = BlockKind::Heading(level)
                para.open = false
                let _ = open_stack.pop()
                consumed = true
                break
              } else {
                // Entire paragraph was link reference definitions; close & pop it so `===` becomes a new paragraph
                para.open = false
                let _ = open_stack.pop()
                container_idx = open_stack[open_stack.length() - 1]
              }
            }
            None => ()
          }
        }

        // 7. GFM Table delimiter row (only if opts.tables & tip is Paragraph & all containers matched)
        if opts.tables && in_para && unmatched_closed && (fb == 124 || fb == 45 || fb == 58) {
          match scan_table_delimiter_row(cur.src, non_ws, cur.end) {
            Some(aligns) => {
              let para = nodes[cur_tip]
              if para.lines.length() >= 1 {
                let last_line = para.lines[para.lines.length() - 1]
                let header_cells = split_table_row(last_line, 0, last_line.length())
                if header_cells.length() == aligns.length() {
                  if para.lines.length() == 1 {
                    para.kind = BlockKind::Table(aligns, header_cells, Array::new())
                    para.lines.clear()
                  } else {
                    // Pop last line as table header, keep earlier lines in Paragraph
                    let _ = para.lines.pop()
                    close_block(nodes, cur_tip, ref_defs, opts)
                    let _ = open_stack.pop()
                    let parent_idx = open_stack[open_stack.length() - 1]
                    let tbl = new_block(BlockKind::Table(aligns, header_cells, Array::new()))
                    let _ = add_child(parent_idx, tbl)
                  }
                  consumed = true
                  break
                }
              }
            }
            None => ()
          }
        }

        // 8. Thematic Break (must be checked BEFORE list marker so `- - -` is HR!)
        if (fb == 42 || fb == 45 || fb == 95) && scan_thematic_break(cur.src, non_ws, cur.end) {
          close_unmatched()
          close_list_if_needed()
          let hr = new_block(BlockKind::ThematicBreak)
          hr.open = false
          let cidx = nodes.length()
          nodes.push(hr)
          nodes[container_idx].children.push(cidx)
          consumed = true
          break
        }

        // 9. List Item
        let list_in_para = match nodes[container_idx].kind {
          BlockKind::List(_, _, _) => false
          _ => in_para
        }
        match scan_list_marker(cur.src, non_ws, cur.end, non_ws_col, list_in_para) {
          Some(lm) => {
            close_unmatched()
            let t = open_stack[open_stack.length() - 1]
            match nodes[t].kind {
              BlockKind::Paragraph => {
                close_block(nodes, t, ref_defs, opts)
                let _ = open_stack.pop()
                container_idx = open_stack[open_stack.length() - 1]
              }
              _ => ()
            }
            // Check if container_idx is a matching List
            let needs_new_list = match nodes[container_idx].kind {
              BlockKind::List(o, d, _) => !(o == lm.ordered && d == lm.delim)
              _ => true
            }
            if needs_new_list {
              match nodes[container_idx].kind {
                BlockKind::List(_, _, _) => {
                  close_block(nodes, container_idx, ref_defs, opts)
                  let _ = open_stack.pop()
                  container_idx = open_stack[open_stack.length() - 1]
                }
                _ => ()
              }
              container_idx = add_child(
                container_idx,
                new_block(BlockKind::List(lm.ordered, lm.delim, lm.start_num)),
              )
            }
            let base_col = cur.col
            let item_indent_width = lm.content_col - base_col
            // Advance cursor to item content column
            cursor_skip_ws(cur)
            let marker_len = lm.marker_end - cur.pos
            cur.pos = lm.marker_end
            cur.col = cur.col + marker_len
            cur.partial = 0
            if !lm.is_empty_line {
              let delta = lm.content_col - cur.col
              if delta > 0 {
                cursor_advance_cols(cur, delta)
              }
              container_idx = add_child(container_idx, new_block(BlockKind::Item(item_indent_width)))
              continue
            } else {
              cur.pos = cur.end
              container_idx = add_child(container_idx, new_block(BlockKind::Item(item_indent_width)))
              consumed = true
              break
            }
          }
          None => ()
        }
      }

      // No new block matched
      break
    }

    if consumed {
      line_start = next_line_start
      continue
    }

    // Helper: clear ends_with_blank on all open containers when non-blank content is added
    let clear_open_blanks = fn() -> Unit {
      let mut si = 1
      while si < open_stack.length() {
        nodes[open_stack[si]].ends_with_blank = false
        si = si + 1
      }
    }

    // Step 3: Remaining line content
    let blank_rem = cursor_is_blank(cur)
    if blank_rem {
      close_unmatched()
      let t = open_stack[open_stack.length() - 1]
      match nodes[t].kind {
        BlockKind::IndentedCode => {
          nodes[t].lines.push(cursor_rest(cur))
        }
        BlockKind::Paragraph => {
          close_block(nodes, t, ref_defs, opts)
          let _ = open_stack.pop()
          // Mark open containers up to nearest BlockQuote as ending with blank
          let mut si = open_stack.length() - 1
          while si >= 1 {
            match nodes[open_stack[si]].kind {
              BlockKind::BlockQuote => break
              _ => {
                mark_ends_with_blank(nodes, open_stack[si])
                si = si - 1
              }
            }
          }
        }
        _ => {
          let mut si = open_stack.length() - 1
          while si >= 1 {
            match nodes[open_stack[si]].kind {
              BlockKind::BlockQuote => break
              _ => {
                mark_ends_with_blank(nodes, open_stack[si])
                si = si - 1
              }
            }
          }
        }
      }
    } else if !unmatched_closed && tip_is_para {
      // Lazy paragraph continuation!
      clear_open_blanks()
      cursor_skip_ws(cur)
      nodes[tip_idx].lines.push(cursor_rest(cur))
    } else {
      close_unmatched()
      let t = open_stack[open_stack.length() - 1]
      match nodes[t].kind {
        BlockKind::IndentedCode => {
          clear_open_blanks()
          nodes[t].lines.push(cursor_rest(cur))
        }
        BlockKind::Paragraph => {
          clear_open_blanks()
          cursor_skip_ws(cur)
          nodes[t].lines.push(cursor_rest(cur))
        }
        _ => {
          close_list_if_needed()
          clear_open_blanks()
          cursor_skip_ws(cur)
          let p = new_block(BlockKind::Paragraph)
          p.lines.push(cursor_rest(cur))
          let _ = add_child(container_idx, p)
        }
      }
    }

    line_start = next_line_start
  }

  // Close all remaining open blocks bottom-up
  while open_stack.length() > 0 {
    let idx = open_stack[open_stack.length() - 1]
    close_block(nodes, idx, ref_defs, opts)
    let _ = open_stack.pop()
  }

  BlockDoc::{ nodes, ref_defs }
}
