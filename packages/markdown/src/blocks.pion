///| CommonMark 0.31.2 + GFM Phase 1 Block Structure Parser (flat POD BlockMeta/BlockTree + LineSpan arena).

///| Link reference definition (destination URL + optional title).
pub val struct LinkDef {
  pub dest : String
  pub title : String
}

///| Flat 24-byte POD line span stored inline in `Array[LineSpan]` (zero heap allocation).
///| When `pad >= 0`: `pad` leading spaces followed by `doc.src[start..end]`.
///| When `pad == -1`: owned string at `doc.extra_strs[start]`.
pub val struct LineSpan {
  pub start : Int
  pub end : Int
  pub pad : Int
}

// Block kind tags (stored in low 4 bits of BlockMeta.kf):
// 0 = Document
// 1 = BlockQuote
// 2 = List         (bit 9: ordered, bits 10..17: delim, extra: start_num)
// 3 = Item         (extra: content_col)
// 4 = Paragraph
// 5 = Heading      (bits 10..17: level)
// 6 = IndentedCode
// 7 = FencedCode   (bits 10..17: fchar, bits 18..29: flen, extra: info_str_idx (-1 if empty), extra2: fence_indent)
// 8 = HtmlBlock    (bits 10..17: hkind)
// 9 = ThematicBreak
// 10 = Table       (line_start: ncols, line_len: num_body_rows, extra: cells_start, extra2: aligns_idx)
// 11 = Empty
//
// Flags in BlockMeta.kf:
// bit 4 (16): open
// bit 5 (32): tight
// bit 6 (64): ends_with_blank
// bits 7..8 (128/256): task_state (0 = None, 1 = Some(false), 2 = Some(true))

///| Flat 32-byte POD block metadata stored inline in `Array[BlockMeta]`.
pub val struct BlockMeta {
  pub kf : Int
  pub line_start : Int
  pub line_len : Int
  pub extra : Int
}

///| Flat 32-byte POD block tree links stored inline in `Array[BlockTree]`.
pub val struct BlockTree {
  pub first_child : Int
  pub last_child : Int
  pub next_sibling : Int
  pub extra2 : Int
}

///| Result of Phase 1 block parsing.
pub struct BlockDoc {
  pub src : String
  pub meta : Array[BlockMeta]
  pub tree : Array[BlockTree]
  pub all_lines : Array[LineSpan]
  pub table_cells : Array[LineSpan]
  pub table_aligns : Array[Array[Alignment]]
  pub extra_strs : Array[String]
  pub ref_defs : Map[String, LinkDef]
}

///| Reusable mutable line cursor state (allocated ONCE per parse_blocks call, zero per-line tuple allocs).
struct LineState {
  mut pos : Int
  mut col : Int
  mut partial : Int
  mut indent : Int
  mut non_ws : Int
  mut non_ws_col : Int
}

fn make_kf(kind : Int, open : Bool, sub : Int) -> Int {
  kind | (if open { 16 } else { 0 }) | 32 | sub
}

fn push_block(
  meta : Array[BlockMeta],
  tree : Array[BlockTree],
  kf : Int,
  line_start : Int,
  line_len : Int,
  extra : Int,
  extra2 : Int,
) -> Int {
  let idx = meta.length()
  meta.push(BlockMeta::{ kf, line_start, line_len, extra })
  tree.push(BlockTree::{ first_child: -1, last_child: -1, next_sibling: -1, extra2 })
  idx
}

fn add_block_child(tree : Array[BlockTree], parent_idx : Int, cidx : Int) -> Unit {
  let pt = tree[parent_idx]
  if pt.first_child < 0 {
    tree[parent_idx] = BlockTree::{
      first_child: cidx,
      last_child: cidx,
      next_sibling: pt.next_sibling,
      extra2: pt.extra2,
    }
  } else {
    let lc = pt.last_child
    let lt = tree[lc]
    tree[lc] = BlockTree::{
      first_child: lt.first_child,
      last_child: lt.last_child,
      next_sibling: cidx,
      extra2: lt.extra2,
    }
    tree[parent_idx] = BlockTree::{
      first_child: pt.first_child,
      last_child: cidx,
      next_sibling: pt.next_sibling,
      extra2: pt.extra2,
    }
  }
}

fn push_child_open(
  meta : Array[BlockMeta],
  tree : Array[BlockTree],
  open_stack : Array[Int],
  parent_idx : Int,
  kf : Int,
  line_start : Int,
  line_len : Int,
  extra : Int,
  extra2 : Int,
) -> Int {
  let cidx = push_block(meta, tree, kf, line_start, line_len, extra, extra2)
  add_block_child(tree, parent_idx, cidx)
  open_stack.push(cidx)
  cidx
}

///| Check if UTF-8 sequence starting at `pos` (where `src[pos] >= 0x80`) is valid; returns byte length (2..4) or 0 if invalid.
fn valid_utf8_len(src : String, pos : Int, n : Int) -> Int {
  let b0 = src.code_unit_at(pos)
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    if (src.code_unit_at(pos + 1) & 0xC0) == 0x80 {
      return 2
    }
    return 0
  }
  if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = src.code_unit_at(pos + 1)
    let b2 = src.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp >= 0x800 && !(cp >= 0xD800 && cp <= 0xDFFF) {
        return 3
      }
    }
    return 0
  }
  if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = src.code_unit_at(pos + 1)
    let b2 = src.code_unit_at(pos + 2)
    let b3 = src.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      if cp >= 0x10000 && cp <= 0x10FFFF {
        return 4
      }
    }
    return 0
  }
  0
}

///| Normalize `\r\n` / `\r` -> `\n`, `\0` -> U+FFFD, and invalid UTF-8 bytes -> U+FFFD
///| (only called when `\r`, `\0`, or an invalid UTF-8 byte is encountered).
fn normalize_input(src : String) -> String {
  let n = src.length()
  let sb = StringBuilder::new()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = src.code_unit_at(i)
    if b == 13 {
      if mark < i {
        write_raw_span(sb, src, mark, i)
      }
      sb.write_byte((10).to_byte())
      if i + 1 < n && src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      mark = i
    } else if b == 0 {
      if mark < i {
        write_raw_span(sb, src, mark, i)
      }
      write_utf8(sb, 0xFFFD)
      i = i + 1
      mark = i
    } else if b >= 0x80 {
      let clen = valid_utf8_len(src, i, n)
      if clen > 0 {
        i = i + clen
      } else {
        if mark < i {
          write_raw_span(sb, src, mark, i)
        }
        write_utf8(sb, 0xFFFD)
        i = i + 1
        mark = i
      }
    } else {
      i = i + 1
    }
  }
  if mark < n {
    write_raw_span(sb, src, mark, n)
  }
  sb.to_string()
}

fn line_is_blank(src : String, pos : Int, end : Int) -> Bool {
  let mut i = pos
  while i < end {
    let b = src.code_unit_at(i)
    if b != 32 && b != 9 {
      return false
    }
    i = i + 1
  }
  true
}

///| Compute visual indentation to next non-space/tab byte into `ls.indent`, `ls.non_ws`, `ls.non_ws_col`.
fn peek_indent_ls(ls : LineState, src : String, end : Int) -> Unit {
  let mut i = ls.pos
  if ls.partial == 0 && i < end && src.code_unit_at(i) > 32 {
    ls.indent = 0
    ls.non_ws = i
    ls.non_ws_col = ls.col
    return ()
  }
  let mut c = ls.col + ls.partial
  while i < end {
    let b = src.code_unit_at(i)
    if b == 32 {
      c = c + 1
      i = i + 1
    } else if b == 9 {
      c = c + (4 - (c % 4))
      i = i + 1
    } else {
      break
    }
  }
  ls.indent = c - ls.col
  ls.non_ws = i
  ls.non_ws_col = c
}

///| Advance `ls` by up to `count` visual columns in-place (zero tuple allocation).
fn advance_cols_ls(ls : LineState, src : String, end : Int, count : Int) -> Unit {
  let mut p = ls.pos
  let mut c = ls.col
  let mut part = ls.partial
  let mut rem = count
  if part > 0 {
    if part >= rem {
      ls.col = c + rem
      ls.partial = part - rem
      return ()
    } else {
      c = c + part
      rem = rem - part
      part = 0
    }
  }
  while rem > 0 && p < end {
    let b = src.code_unit_at(p)
    if b == 32 {
      p = p + 1
      c = c + 1
      rem = rem - 1
    } else if b == 9 {
      let tab_w = 4 - (c % 4)
      p = p + 1
      if tab_w > rem {
        c = c + rem
        part = tab_w - rem
        rem = 0
      } else {
        c = c + tab_w
        rem = rem - tab_w
      }
    } else {
      break
    }
  }
  ls.pos = p
  ls.col = c
  ls.partial = part
}

fn span_is_blank(src : String, extra_strs : Array[String], sp : LineSpan) -> Bool {
  if sp.pad < 0 {
    let s = extra_strs[sp.start]
    line_is_blank(s, 0, s.length())
  } else {
    line_is_blank(src, sp.start, sp.end)
  }
}

///| Extract leading link reference definitions from paragraph node `idx`.
///| Returns `true` if any paragraph text remains.
fn extract_ref_defs_from_para(
  src : String,
  meta : Array[BlockMeta],
  idx : Int,
  all_lines : Array[LineSpan],
  extra_strs : Array[String],
  ref_defs : Map[String, LinkDef],
) -> Bool {
  let m = meta[idx]
  if m.line_len == 0 {
    return false
  }
  let sp0 = all_lines[m.line_start]
  let first_is_bracket = if sp0.pad < 0 {
    let first = extra_strs[sp0.start]
    let mut f = 0
    while f < first.length() && first.code_unit_at(f) == 32 {
      f = f + 1
    }
    f < first.length() && first.code_unit_at(f) == 91
  } else {
    let mut f = sp0.start
    while f < sp0.end && src.code_unit_at(f) == 32 {
      f = f + 1
    }
    f < sp0.end && src.code_unit_at(f) == 91
  }
  if !first_is_bracket {
    return true
  }
  // Single-line zero-copy fast path (avoids StringBuilder allocation for 99% of link ref defs!)
  if m.line_len == 1 && sp0.pad == 0 {
    let mut pos = sp0.start
    let mut extracted = false
    while pos < sp0.end {
      match scan_link_ref_def(src, pos, sp0.end) {
        Some((norm_label, dest, title, next_pos)) => {
          if !ref_defs.contains(norm_label) {
            ref_defs.set(norm_label, LinkDef::{ dest, title })
          }
          pos = next_pos
          extracted = true
        }
        None => break
      }
    }
    if !extracted {
      return true
    }
    if pos >= sp0.end {
      let new_kf = (m.kf - (m.kf & 15)) | 11
      meta[idx] = BlockMeta::{ kf: new_kf, line_start: m.line_start, line_len: 0, extra: m.extra }
      return false
    }
    all_lines[m.line_start] = LineSpan::{ start: pos, end: sp0.end, pad: 0 }
    return true
  }
  let sb = StringBuilder::new()
  let mut li = 0
  while li < m.line_len {
    if li > 0 {
      sb.write_byte((10).to_byte())
    }
    let sp = all_lines[m.line_start + li]
    if sp.pad < 0 {
      sb.write_string(extra_strs[sp.start])
    } else {
      let mut k = 0
      while k < sp.pad {
        sb.write_byte((32).to_byte())
        k = k + 1
      }
      write_raw_span(sb, src, sp.start, sp.end)
    }
    li = li + 1
  }
  let full = sb.to_string()
  let n = full.length()
  let mut pos = 0
  let mut extracted = false
  while pos < n {
    match scan_link_ref_def(full, pos, n) {
      Some((norm_label, dest, title, next_pos)) => {
        if !ref_defs.contains(norm_label) {
          ref_defs.set(norm_label, LinkDef::{ dest, title })
        }
        pos = next_pos
        extracted = true
      }
      None => break
    }
  }
  if !extracted {
    return true
  }
  if pos >= n {
    // Convert to Empty (kind = 11)
    let new_kf = (m.kf - (m.kf & 15)) | 11
    meta[idx] = BlockMeta::{ kf: new_kf, line_start: m.line_start, line_len: 0, extra: m.extra }
    return false
  }
  let new_start = all_lines.length()
  let mut lstart = pos
  let mut i = pos
  let mut cnt = 0
  while i <= n {
    if i == n || full.code_unit_at(i) == 10 {
      let sidx = extra_strs.length()
      extra_strs.push(full.slice(lstart, i))
      all_lines.push(LineSpan::{ start: sidx, end: 0, pad: -1 })
      cnt = cnt + 1
      lstart = i + 1
    }
    i = i + 1
  }
  meta[idx] = BlockMeta::{ kf: m.kf, line_start: new_start, line_len: cnt, extra: m.extra }
  true
}

///| Close a block node (finalizing paragraphs, indented code trailing blanks, list tightness, tasklists).
fn close_block(
  src : String,
  meta : Array[BlockMeta],
  tree : Array[BlockTree],
  all_lines : Array[LineSpan],
  extra_strs : Array[String],
  idx : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
) -> Unit {
  let m = meta[idx]
  if (m.kf & 16) == 0 {
    return ()
  }
  let closed_kf = m.kf ^ 16
  meta[idx] = BlockMeta::{ kf: closed_kf, line_start: m.line_start, line_len: m.line_len, extra: m.extra }
  let kind = closed_kf & 15
  if kind == 4 {
    let _ = extract_ref_defs_from_para(src, meta, idx, all_lines, extra_strs, ref_defs)
  } else if kind == 6 {
    let mut llen = m.line_len
    while llen > 0 {
      let last = all_lines[m.line_start + llen - 1]
      if span_is_blank(src, extra_strs, last) {
        llen = llen - 1
      } else {
        break
      }
    }
    if llen != m.line_len {
      // Stripped trailing blank lines mean this indented code block ends with a blank line (CommonMark).
      meta[idx] = BlockMeta::{ kf: closed_kf | 64, line_start: m.line_start, line_len: llen, extra: m.extra }
    }
  } else if kind == 2 {
    // List tightness
    let mut tight = true
    let mut ci = tree[idx].first_child
    while ci >= 0 && tight {
      let item_t = tree[ci]
      let next_ci = item_t.next_sibling
      if next_ci >= 0 && (meta[ci].kf & 64) != 0 {
        tight = false
        break
      }
      let mut sub = item_t.first_child
      while sub >= 0 {
        let sub_m = meta[sub]
        let next_sub = tree[sub].next_sibling
        if (sub_m.kf & 15) != 11 && next_sub >= 0 && (sub_m.kf & 64) != 0 {
          tight = false
          break
        }
        sub = next_sub
      }
      ci = next_ci
    }
    if !tight {
      meta[idx] = BlockMeta::{ kf: closed_kf ^ 32, line_start: m.line_start, line_len: m.line_len, extra: m.extra }
    }
  } else if kind == 3 {
    // Item: propagate ends_with_blank if last non-empty direct child is an IndentedCode that stripped trailing blanks
    let mut cur_kf = closed_kf
    let mut last_ne = -1
    let mut sc_i = tree[idx].first_child
    while sc_i >= 0 {
      if (meta[sc_i].kf & 15) != 11 {
        last_ne = sc_i
      }
      sc_i = tree[sc_i].next_sibling
    }
    if last_ne >= 0 {
      let lnm = meta[last_ne]
      if (lnm.kf & 15) == 6 && (lnm.kf & 64) != 0 {
        cur_kf = cur_kf | 64
        meta[idx] = BlockMeta::{ kf: cur_kf, line_start: m.line_start, line_len: m.line_len, extra: m.extra }
      }
    }
    // Item: check GFM task list marker on first Paragraph child
    if opts.tasklists {
      let fc = tree[idx].first_child
      if fc >= 0 {
        let fm = meta[fc]
        if (fm.kf & 15) == 4 && fm.line_len > 0 {
          let sp0 = all_lines[fm.line_start]
          if sp0.pad == 0 {
            let tm = scan_tasklist_marker_fast(src, sp0.start, sp0.end)
            if tm >= 0 {
              let tbits = if tm == 1 { 256 } else { 128 }
              meta[idx] = BlockMeta::{
                kf: cur_kf | tbits,
                line_start: m.line_start,
                line_len: m.line_len,
                extra: m.extra,
              }
              let after_m = if sp0.start + 3 == sp0.end { sp0.end } else { sp0.start + 4 }
              if line_is_blank(src, after_m, sp0.end) {
                if fm.line_len == 1 {
                  let empty_kf = (fm.kf - (fm.kf & 15)) | 11
                  meta[fc] = BlockMeta::{ kf: empty_kf, line_start: fm.line_start, line_len: 0, extra: fm.extra }
                } else {
                  meta[fc] = BlockMeta::{
                    kf: fm.kf,
                    line_start: fm.line_start + 1,
                    line_len: fm.line_len - 1,
                    extra: fm.extra,
                  }
                }
              } else {
                all_lines[fm.line_start] = LineSpan::{
                  start: after_m,
                  end: sp0.end,
                  pad: 0,
                }
              }
            }
          } else if sp0.pad < 0 {
            let l0 = extra_strs[sp0.start]
            let tm = scan_tasklist_marker_fast(l0, 0, l0.length())
            if tm >= 0 {
              let tbits = if tm == 1 { 256 } else { 128 }
              meta[idx] = BlockMeta::{
                kf: cur_kf | tbits,
                line_start: m.line_start,
                line_len: m.line_len,
                extra: m.extra,
              }
              let after_m = if l0.length() == 3 { 3 } else { 4 }
              if line_is_blank(l0, after_m, l0.length()) {
                if fm.line_len == 1 {
                  let empty_kf = (fm.kf - (fm.kf & 15)) | 11
                  meta[fc] = BlockMeta::{ kf: empty_kf, line_start: fm.line_start, line_len: 0, extra: fm.extra }
                } else {
                  meta[fc] = BlockMeta::{
                    kf: fm.kf,
                    line_start: fm.line_start + 1,
                    line_len: fm.line_len - 1,
                    extra: fm.extra,
                  }
                }
              } else {
                extra_strs[sp0.start] = l0.slice(after_m, l0.length())
              }
            }
          }
        }
      }
    }
  }
}

fn mark_ends_with_blank(meta : Array[BlockMeta], tree : Array[BlockTree], idx : Int) -> Unit {
  let m = meta[idx]
  meta[idx] = BlockMeta::{ kf: m.kf | 64, line_start: m.line_start, line_len: m.line_len, extra: m.extra }
  let last = tree[idx].last_child
  if last >= 0 {
    let lm = meta[last]
    if (lm.kf & 15) != 11 {
      meta[last] = BlockMeta::{ kf: lm.kf | 64, line_start: lm.line_start, line_len: lm.line_len, extra: lm.extra }
    } else {
      let mut last_ne = -1
      let mut c = tree[idx].first_child
      while c >= 0 {
        if (meta[c].kf & 15) != 11 {
          last_ne = c
        }
        c = tree[c].next_sibling
      }
      if last_ne >= 0 {
        let nem = meta[last_ne]
        meta[last_ne] = BlockMeta::{
          kf: nem.kf | 64,
          line_start: nem.line_start,
          line_len: nem.line_len,
          extra: nem.extra,
        }
      }
    }
  }
}

fn close_unmatched_blocks(
  src : String,
  meta : Array[BlockMeta],
  tree : Array[BlockTree],
  all_lines : Array[LineSpan],
  extra_strs : Array[String],
  open_stack : Array[Int],
  matched : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
) -> Unit {
  while open_stack.length() > matched {
    let pop_idx = open_stack[open_stack.length() - 1]
    close_block(src, meta, tree, all_lines, extra_strs, pop_idx, ref_defs, opts)
    let _ = open_stack.pop()
  }
}

fn close_list_and_para(
  src : String,
  meta : Array[BlockMeta],
  tree : Array[BlockTree],
  all_lines : Array[LineSpan],
  extra_strs : Array[String],
  open_stack : Array[Int],
  ref_defs : Map[String, LinkDef],
  opts : Options,
) -> Int {
  while open_stack.length() > 1 {
    let top_idx = open_stack[open_stack.length() - 1]
    let k = meta[top_idx].kf & 15
    if k == 2 || k == 4 {
      close_block(src, meta, tree, all_lines, extra_strs, top_idx, ref_defs, opts)
      let _ = open_stack.pop()
    } else {
      break
    }
  }
  open_stack[open_stack.length() - 1]
}

fn clear_open_blanks(meta : Array[BlockMeta], open_stack : Array[Int]) -> Unit {
  let mut si = 1
  let slen = open_stack.length()
  while si < slen {
    let bidx = open_stack[si]
    let m = meta[bidx]
    if (m.kf & 64) != 0 {
      meta[bidx] = BlockMeta::{ kf: m.kf ^ 64, line_start: m.line_start, line_len: m.line_len, extra: m.extra }
    }
    si = si + 1
  }
}

fn append_block_line(
  meta : Array[BlockMeta],
  all_lines : Array[LineSpan],
  bidx : Int,
  span : LineSpan,
) -> Unit {
  let m = meta[bidx]
  let ls = if m.line_len == 0 { all_lines.length() } else { m.line_start }
  all_lines.push(span)
  meta[bidx] = BlockMeta::{ kf: m.kf, line_start: ls, line_len: m.line_len + 1, extra: m.extra }
}

fn make_block_start_table() -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(256)
  let zero = (0).to_byte()
  let mut i = 0
  while i < 256 {
    tbl.push(zero)
    i = i + 1
  }
  let one = (1).to_byte()
  tbl[62] = one // '>'
  tbl[35] = one // '#'
  tbl[96] = one // '`'
  tbl[126] = one // '~'
  tbl[60] = one // '<'
  tbl[61] = one // '='
  tbl[45] = one // '-'
  tbl[124] = one // '|'
  tbl[58] = one // ':'
  tbl[42] = one // '*'
  tbl[95] = one // '_'
  tbl[43] = one // '+'
  i = 48
  while i <= 57 {
    tbl[i] = one // '0'..'9'
    i = i + 1
  }
  tbl
}

///| Parse `src` into a Phase 1 `BlockDoc`.
pub fn parse_blocks(src : String, opts : Options) -> BlockDoc {
  parse_blocks_inner(src, opts, false)
}

fn parse_blocks_inner(text : String, opts : Options, normalized : Bool) -> BlockDoc {
  let n = text.length()
  let est_nodes = n / 64 + 16
  let est_lines = n / 32 + 16
  let meta : Array[BlockMeta] = Array::with_capacity(est_nodes)
  let tree : Array[BlockTree] = Array::with_capacity(est_nodes)
  let all_lines : Array[LineSpan] = Array::with_capacity(est_lines)
  let table_cells : Array[LineSpan] = Array::new()
  let table_aligns : Array[Array[Alignment]] = Array::new()
  let extra_strs : Array[String] = Array::new()
  let ref_defs : Map[String, LinkDef] = Map::new()
  let _ = push_block(meta, tree, make_kf(0, true, 0), 0, 0, 0, 0)
  let open_stack : Array[Int] = Array::with_capacity(16)
  open_stack.push(0)
  let ls = LineState::{ pos: 0, col: 0, partial: 0, indent: 0, non_ws: 0, non_ws_col: 0 }
  let sc = new_scan_out()
  let bstart_tbl = make_block_start_table()
  let zero_b = (0).to_byte()

  let mut line_start = 0
  while line_start < n {
    let mut line_end = line_start
    if !normalized {
      while line_end < n {
        let b = text.code_unit_at(line_end)
        if b <= 13 {
          if b == 10 {
            break
          }
          if b == 13 || b == 0 {
            return parse_blocks_inner(normalize_input(text), opts, true)
          }
        } else if b >= 0x80 {
          let clen = valid_utf8_len(text, line_end, n)
          if clen == 0 {
            return parse_blocks_inner(normalize_input(text), opts, true)
          }
          line_end = line_end + clen
          continue
        }
        line_end = line_end + 1
      }
    } else {
      while line_end < n && text.code_unit_at(line_end) != 10 {
        line_end = line_end + 1
      }
    }
    let next_line_start = if line_end < n { line_end + 1 } else { n }

    ls.pos = line_start
    ls.col = 0
    ls.partial = 0
    let mut indent_valid = false

    // Step 1: Match existing open blocks from root downward
    let mut matched = 1
    let mut consumed = false
    let stack_len = open_stack.length()

    while matched < stack_len {
      let bidx = open_stack[matched]
      let bm = meta[bidx]
      let kind = bm.kf & 15

      // List always matches without peeking indent!
      if kind == 2 {
        matched = matched + 1
        continue
      }

      if !indent_valid {
        peek_indent_ls(ls, text, line_end)
        indent_valid = true
      }
      let indent = ls.indent
      let non_ws = ls.non_ws
      let blank = non_ws == line_end

      if kind == 4 {
        // Paragraph
        if blank {
          break
        }
        matched = matched + 1
      } else if kind == 3 {
        // Item(content_col = bm.extra)
        let indent_width = bm.extra
        if blank {
          if tree[bidx].first_child < 0 {
            break
          }
          advance_cols_ls(ls, text, line_end, indent_width)
          indent_valid = false
          matched = matched + 1
        } else if indent >= indent_width {
          advance_cols_ls(ls, text, line_end, indent_width)
          indent_valid = false
          matched = matched + 1
        } else {
          break
        }
      } else if kind == 1 {
        // BlockQuote
        if !blank && indent <= 3 && text.code_unit_at(non_ws) == 62 {
          ls.pos = non_ws + 1
          ls.col = ls.non_ws_col + 1
          ls.partial = 0
          if ls.pos < line_end {
            let nb = text.code_unit_at(ls.pos)
            if nb == 32 || nb == 9 {
              advance_cols_ls(ls, text, line_end, 1)
            }
          }
          indent_valid = false
          matched = matched + 1
        } else {
          break
        }
      } else if kind == 7 {
        // FencedCode
        let fchar = (bm.kf >> 10) & 255
        let flen = (bm.kf >> 18) & 4095
        if !blank && indent <= 3 && text.code_unit_at(non_ws) == fchar &&
        scan_code_fence_close(text, non_ws, line_end, fchar, flen) {
          close_block(text, meta, tree, all_lines, extra_strs, bidx, ref_defs, opts)
          let _ = open_stack.pop()
          consumed = true
          break
        }
        let findent = tree[bidx].extra2
        if findent > 0 {
          advance_cols_ls(ls, text, line_end, findent)
        }
        append_block_line(meta, all_lines, bidx, LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
        consumed = true
        break
      } else if kind == 10 {
        // Table
        if blank {
          break
        }
        if indent <= 3 {
          let first_b = text.code_unit_at(non_ws)
          if bstart_tbl[first_b] != zero_b {
            let mut interrupts = false
            if first_b == 62 {
              interrupts = true
            } else if first_b == 35 {
              if scan_atx_heading_into(text, non_ws, line_end, sc) {
                interrupts = true
              }
            } else if first_b == 96 || first_b == 126 {
              match scan_code_fence_open(text, non_ws, line_end) {
                Some(_) => interrupts = true
                None => ()
              }
            } else if first_b == 60 {
              if scan_html_block_start(text, non_ws, line_end, true) != 0 {
                interrupts = true
              }
            } else if first_b == 42 || first_b == 45 || first_b == 95 || first_b == 43 ||
            (first_b >= 48 && first_b <= 57) {
              if (first_b == 42 || first_b == 45 || first_b == 95) &&
              scan_thematic_break(text, non_ws, line_end) {
                interrupts = true
              } else if scan_list_marker_into(text, non_ws, line_end, ls.col + indent, false, sc) {
                interrupts = true
              }
            }
            if interrupts {
              break
            }
          }
        }
        // A lone `|` line (only whitespace around a single `|`) terminates the table instead of adding an empty row.
        if text.code_unit_at(non_ws) == 124 && line_is_blank(text, non_ws + 1, line_end) {
          break
        }
        let ncols = bm.line_start
        let _ = split_table_row_spans(text, ls.pos, line_end, table_cells, extra_strs, ncols)
        meta[bidx] = BlockMeta::{ kf: bm.kf, line_start: ncols, line_len: bm.line_len + 1, extra: bm.extra }
        consumed = true
        break
      } else if kind == 6 {
        // IndentedCode
        if indent >= 4 {
          advance_cols_ls(ls, text, line_end, 4)
          indent_valid = false
          matched = matched + 1
        } else if blank {
          advance_cols_ls(ls, text, line_end, indent)
          indent_valid = false
          matched = matched + 1
        } else {
          break
        }
      } else if kind == 8 {
        // HtmlBlock
        let hkind = (bm.kf >> 10) & 255
        if blank && (hkind == 6 || hkind == 7) {
          break
        }
        append_block_line(meta, all_lines, bidx, LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
        if hkind <= 5 && scan_html_block_end(text, ls.pos, line_end, hkind) {
          close_block(text, meta, tree, all_lines, extra_strs, bidx, ref_defs, opts)
          let _ = open_stack.pop()
        }
        consumed = true
        break
      } else {
        break
      }
    }

    if consumed {
      line_start = next_line_start
      continue
    }

    let all_matched = matched == open_stack.length()
    let tip_idx = open_stack[open_stack.length() - 1]
    let tip_is_para = (meta[tip_idx].kf & 15) == 4
    let last_matched_idx = open_stack[matched - 1]

    // Step 2: Check for new block starts (unless last matched is IndentedCode)
    let mut container_idx = last_matched_idx
    let mut unmatched_closed = all_matched
    let try_starts = (meta[container_idx].kf & 15) != 6

    while try_starts {
      if !indent_valid {
        peek_indent_ls(ls, text, line_end)
        indent_valid = true
      }
      let indent = ls.indent
      let non_ws = ls.non_ws
      let non_ws_col = ls.non_ws_col
      if non_ws == line_end {
        break
      }

      let cur_tip = open_stack[open_stack.length() - 1]
      let in_para = (meta[cur_tip].kf & 15) == 4

      // 1. Indented code block (only if not in paragraph)
      if indent >= 4 && !in_para {
        if !unmatched_closed {
          close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
          unmatched_closed = true
        }
        container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
        advance_cols_ls(ls, text, line_end, 4)
        let lstart = all_lines.length()
        all_lines.push(LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
        let _ = push_child_open(meta, tree, open_stack, container_idx, make_kf(6, true, 0), lstart, 1, 0, 0)
        consumed = true
        break
      }

      if indent <= 3 {
        let fb = text.code_unit_at(non_ws)
        if bstart_tbl[fb] == zero_b {
          break
        }

        // 2. BlockQuote `>`
        if fb == 62 {
          if !unmatched_closed {
            close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
            unmatched_closed = true
          }
          container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
          ls.pos = non_ws + 1
          ls.col = non_ws_col + 1
          ls.partial = 0
          if ls.pos < line_end {
            let nb = text.code_unit_at(ls.pos)
            if nb == 32 || nb == 9 {
              advance_cols_ls(ls, text, line_end, 1)
            }
          }
          indent_valid = false
          container_idx = push_child_open(meta, tree, open_stack, container_idx, make_kf(1, true, 0), 0, 0, 0, 0)
          continue
        }

        // 3. ATX Heading `#`
        if fb == 35 && scan_atx_heading_into(text, non_ws, line_end, sc) {
          if !unmatched_closed {
            close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
            unmatched_closed = true
          }
          container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
          let lstart = all_lines.length()
          let llen = if sc.b < sc.c {
            all_lines.push(LineSpan::{ start: sc.b, end: sc.c, pad: 0 })
            1
          } else {
            0
          }
          let cidx = push_block(meta, tree, make_kf(5, false, sc.a << 10), lstart, llen, 0, 0)
          add_block_child(tree, container_idx, cidx)
          consumed = true
          break
        }

        // 4. Fenced Code Block
        if fb == 96 || fb == 126 {
          match scan_code_fence_open(text, non_ws, line_end) {
            Some((fchar, flen, info)) => {
              if !unmatched_closed {
                close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
                unmatched_closed = true
              }
              container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
              let info_idx = if info.length() > 0 {
                let idx = extra_strs.length()
                extra_strs.push(info)
                idx
              } else {
                -1
              }
              let clen = if flen > 4095 { 4095 } else { flen }
              let kf = make_kf(7, true, (fchar << 10) | (clen << 18))
              let _ = push_child_open(meta, tree, open_stack, container_idx, kf, all_lines.length(), 0, info_idx, indent)
              consumed = true
              break
            }
            None => ()
          }
        }

        // 5. HTML Block
        if fb == 60 {
          let hkind = scan_html_block_start(text, non_ws, line_end, in_para)
          if hkind > 0 {
            if !unmatched_closed {
              close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
              unmatched_closed = true
            }
            container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
            let lstart = all_lines.length()
            all_lines.push(LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
            let hidx = push_child_open(meta, tree, open_stack, container_idx, make_kf(8, true, hkind << 10), lstart, 1, 0, 0)
            if hkind <= 5 && scan_html_block_end(text, ls.pos, line_end, hkind) {
              close_block(text, meta, tree, all_lines, extra_strs, hidx, ref_defs, opts)
              let _ = open_stack.pop()
            }
            consumed = true
            break
          }
        }

        // 6. Setext Heading underline
        if in_para && unmatched_closed && (fb == 61 || fb == 45) {
          match scan_setext_underline(text, non_ws, line_end) {
            Some(level) => {
              if extract_ref_defs_from_para(text, meta, cur_tip, all_lines, extra_strs, ref_defs) {
                let pm = meta[cur_tip]
                meta[cur_tip] = BlockMeta::{
                  kf: make_kf(5, false, level << 10),
                  line_start: pm.line_start,
                  line_len: pm.line_len,
                  extra: 0,
                }
                let _ = open_stack.pop()
                consumed = true
                break
              } else {
                let pm = meta[cur_tip]
                meta[cur_tip] = BlockMeta::{
                  kf: pm.kf - (pm.kf & 16),
                  line_start: pm.line_start,
                  line_len: pm.line_len,
                  extra: pm.extra,
                }
                let _ = open_stack.pop()
                container_idx = open_stack[open_stack.length() - 1]
              }
            }
            None => ()
          }
        }

        // 7. GFM Table delimiter row
        if opts.tables && in_para && unmatched_closed && (fb == 124 || fb == 45 || fb == 58) {
          match scan_table_delimiter_row(text, non_ws, line_end) {
            Some(aligns) => {
              let pm = meta[cur_tip]
              if pm.line_len >= 1 {
                let last_sp = all_lines[pm.line_start + pm.line_len - 1]
                let allow_table = if pm.line_len == 1 {
                  true
                } else if last_sp.pad < 0 {
                  let s = extra_strs[last_sp.start]
                  let mut f = 0
                  while f < s.length() && (s.code_unit_at(f) == 32 || s.code_unit_at(f) == 9) {
                    f = f + 1
                  }
                  f < s.length() && s.code_unit_at(f) == 124
                } else {
                  let mut f = last_sp.start
                  while f < last_sp.end && (text.code_unit_at(f) == 32 || text.code_unit_at(f) == 9) {
                    f = f + 1
                  }
                  f < last_sp.end && text.code_unit_at(f) == 124
                }
                let ncols = aligns.length()
                let header_cnt = if !allow_table {
                  -1
                } else if last_sp.pad < 0 {
                  let s = extra_strs[last_sp.start]
                  count_table_row_cells(s, 0, s.length())
                } else {
                  count_table_row_cells(text, last_sp.start, last_sp.end)
                }
                if header_cnt == ncols {
                  let cells_start = table_cells.length()
                  if last_sp.pad < 0 {
                    let s = extra_strs[last_sp.start]
                    let hdr_cells = split_table_row(s, 0, s.length())
                    let mut hi = 0
                    while hi < ncols {
                      let sidx = extra_strs.length()
                      extra_strs.push(if hi < hdr_cells.length() { hdr_cells[hi] } else { "" })
                      table_cells.push(LineSpan::{ start: sidx, end: 0, pad: -1 })
                      hi = hi + 1
                    }
                  } else {
                    let _ = split_table_row_spans(
                      text,
                      last_sp.start,
                      last_sp.end,
                      table_cells,
                      extra_strs,
                      ncols,
                    )
                  }
                  let aligns_idx = table_aligns.length()
                  table_aligns.push(aligns)
                  if pm.line_len == 1 {
                    meta[cur_tip] = BlockMeta::{
                      kf: make_kf(10, true, 0),
                      line_start: ncols,
                      line_len: 0,
                      extra: cells_start,
                    }
                    let pt = tree[cur_tip]
                    tree[cur_tip] = BlockTree::{
                      first_child: pt.first_child,
                      last_child: pt.last_child,
                      next_sibling: pt.next_sibling,
                      extra2: aligns_idx,
                    }
                  } else {
                    meta[cur_tip] = BlockMeta::{
                      kf: pm.kf,
                      line_start: pm.line_start,
                      line_len: pm.line_len - 1,
                      extra: pm.extra,
                    }
                    close_block(text, meta, tree, all_lines, extra_strs, cur_tip, ref_defs, opts)
                    let _ = open_stack.pop()
                    let parent_idx = open_stack[open_stack.length() - 1]
                    let _ = push_child_open(
                      meta,
                      tree,
                      open_stack,
                      parent_idx,
                      make_kf(10, true, 0),
                      ncols,
                      0,
                      cells_start,
                      aligns_idx,
                    )
                  }
                  consumed = true
                  break
                }
              }
            }
            None => ()
          }
        }

        // 8. Thematic Break (checked BEFORE list marker so `- - -` is HR!)
        if (fb == 42 || fb == 45 || fb == 95) && scan_thematic_break(text, non_ws, line_end) {
          if !unmatched_closed {
            close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
            unmatched_closed = true
          }
          container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
          let cidx = push_block(meta, tree, make_kf(9, false, 0), 0, 0, 0, 0)
          add_block_child(tree, container_idx, cidx)
          consumed = true
          break
        }

        // 9. List Item (zero-alloc scan_list_marker_into!)
        if fb == 45 || fb == 43 || fb == 42 || (fb >= 48 && fb <= 57) {
          let list_in_para = if (meta[container_idx].kf & 15) == 2 { false } else { in_para }
          if scan_list_marker_into(text, non_ws, line_end, non_ws_col, list_in_para, sc) {
            if !unmatched_closed {
              close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
              unmatched_closed = true
            }
            let t = open_stack[open_stack.length() - 1]
            if (meta[t].kf & 15) == 4 {
              close_block(text, meta, tree, all_lines, extra_strs, t, ref_defs, opts)
              let _ = open_stack.pop()
              container_idx = open_stack[open_stack.length() - 1]
            }
            let lm_ordered = sc.a != 0
            let lm_delim = sc.b
            let lm_start_num = sc.c
            let lm_marker_end = sc.d
            let lm_content_col = sc.e
            let lm_is_empty = sc.flag
            let cm = meta[container_idx]
            let needs_new_list = if (cm.kf & 15) == 2 {
              let o = (cm.kf & 512) != 0
              let d = (cm.kf >> 10) & 255
              !(o == lm_ordered && d == lm_delim)
            } else {
              true
            }
            if needs_new_list {
              if (meta[container_idx].kf & 15) == 2 {
                close_block(text, meta, tree, all_lines, extra_strs, container_idx, ref_defs, opts)
                let _ = open_stack.pop()
                container_idx = open_stack[open_stack.length() - 1]
              }
              let lkf = make_kf(2, true, (if lm_ordered { 512 } else { 0 }) | (lm_delim << 10))
              container_idx = push_child_open(meta, tree, open_stack, container_idx, lkf, 0, 0, lm_start_num, 0)
            }
            let base_col = ls.col
            let item_indent_width = lm_content_col - base_col
            let marker_len = lm_marker_end - non_ws
            ls.pos = lm_marker_end
            ls.col = non_ws_col + marker_len
            ls.partial = 0
            if !lm_is_empty {
              let delta = lm_content_col - ls.col
              if delta > 0 {
                advance_cols_ls(ls, text, line_end, delta)
              }
              // Check for bare task list marker (`- [x]` or `- [x]   `) with no content on the first line:
              // set task_state directly on the Item and consume the line without opening a Paragraph,
              // so a non-indented following line cannot lazily continue it.
              if opts.tasklists && ls.partial == 0 {
                let tm = scan_tasklist_marker_fast(text, ls.pos, line_end)
                if tm >= 0 {
                  let after_m = if ls.pos + 3 == line_end { line_end } else { ls.pos + 4 }
                  if line_is_blank(text, after_m, line_end) {
                    let tbits = if tm == 1 { 256 } else { 128 }
                    ls.pos = line_end
                    container_idx = push_child_open(
                      meta,
                      tree,
                      open_stack,
                      container_idx,
                      make_kf(3, true, tbits),
                      0,
                      0,
                      item_indent_width,
                      0,
                    )
                    consumed = true
                    break
                  }
                }
              }
              indent_valid = false
              container_idx = push_child_open(
                meta,
                tree,
                open_stack,
                container_idx,
                make_kf(3, true, 0),
                0,
                0,
                item_indent_width,
                0,
              )
              continue
            } else {
              ls.pos = line_end
              container_idx = push_child_open(
                meta,
                tree,
                open_stack,
                container_idx,
                make_kf(3, true, 0),
                0,
                0,
                item_indent_width,
                0,
              )
              consumed = true
              break
            }
          }
        }
      }

      break
    }

    if consumed {
      line_start = next_line_start
      continue
    }

    // Step 3: Remaining line content (reuse indent_valid!)
    if !indent_valid {
      peek_indent_ls(ls, text, line_end)
      indent_valid = true
    }
    let blank_rem = ls.non_ws == line_end
    if blank_rem {
      if !unmatched_closed {
        close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
        unmatched_closed = true
      }
      let t = open_stack[open_stack.length() - 1]
      let tk = meta[t].kf & 15
      if tk == 6 {
        append_block_line(meta, all_lines, t, LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
      } else {
        if tk == 4 {
          close_block(text, meta, tree, all_lines, extra_strs, t, ref_defs, opts)
          let _ = open_stack.pop()
        }
        let mut si = open_stack.length() - 1
        while si >= 1 {
          if (meta[open_stack[si]].kf & 15) == 1 {
            break
          }
          mark_ends_with_blank(meta, tree, open_stack[si])
          si = si - 1
        }
      }
    } else if !unmatched_closed && tip_is_para {
      clear_open_blanks(meta, open_stack)
      append_block_line(meta, all_lines, tip_idx, LineSpan::{ start: ls.non_ws, end: line_end, pad: 0 })
    } else {
      if !unmatched_closed {
        close_unmatched_blocks(text, meta, tree, all_lines, extra_strs, open_stack, matched, ref_defs, opts)
        unmatched_closed = true
      }
      let t = open_stack[open_stack.length() - 1]
      let tk = meta[t].kf & 15
      if tk == 6 {
        clear_open_blanks(meta, open_stack)
        append_block_line(meta, all_lines, t, LineSpan::{ start: ls.pos, end: line_end, pad: ls.partial })
      } else if tk == 4 {
        clear_open_blanks(meta, open_stack)
        append_block_line(meta, all_lines, t, LineSpan::{ start: ls.non_ws, end: line_end, pad: 0 })
      } else {
        container_idx = close_list_and_para(text, meta, tree, all_lines, extra_strs, open_stack, ref_defs, opts)
        clear_open_blanks(meta, open_stack)
        let lstart = all_lines.length()
        all_lines.push(LineSpan::{ start: ls.non_ws, end: line_end, pad: 0 })
        let _ = push_child_open(meta, tree, open_stack, container_idx, make_kf(4, true, 0), lstart, 1, 0, 0)
      }
    }

    line_start = next_line_start
  }

  while open_stack.length() > 0 {
    let idx = open_stack[open_stack.length() - 1]
    close_block(text, meta, tree, all_lines, extra_strs, idx, ref_defs, opts)
    let _ = open_stack.pop()
  }

  BlockDoc::{ src: text, meta, tree, all_lines, table_cells, table_aligns, extra_strs, ref_defs }
}
