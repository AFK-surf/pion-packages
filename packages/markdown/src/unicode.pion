///| Unicode punctuation, whitespace, UTF-8 decoding/encoding, CJK classification, and link label case folding.

///| Returns true if `b` is an ASCII punctuation byte (CommonMark §2.1).
pub fn is_ascii_punct(b : Int) -> Bool {
  (b >= 33 && b <= 47) ||
  (b >= 58 && b <= 64) ||
  (b >= 91 && b <= 96) ||
  (b >= 123 && b <= 126)
}

///| Returns true if `b` is ASCII whitespace (space, tab, LF, FF, CR).
pub fn is_ascii_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 12 || b == 13
}

///| Returns true if `b` is an ASCII letter.
pub fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///| Returns true if `b` is an ASCII digit.
pub fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///| Returns true if `b` is ASCII alphanumeric.
pub fn is_ascii_alnum(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

///| Returns true if `cp` is CommonMark Unicode whitespace (Zs + tab/LF/FF/CR).
pub fn is_unicode_ws(cp : Int) -> Bool {
  if cp <= 32 {
    cp == 32 || cp == 9 || cp == 10 || cp == 12 || cp == 13
  } else if cp < 0xA0 {
    false
  } else {
    cp == 0xA0 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200A) ||
    cp == 0x202F || cp == 0x205F || cp == 0x3000
  }
}

