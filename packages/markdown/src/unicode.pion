///| Returns true if `cp` is a CommonMark Unicode punctuation character (ASCII punct + Unicode Pc/Pd/Pe/Pf/Pi/Po/Ps + S*).
pub fn is_unicode_punct(cp : Int) -> Bool {
  if cp < 128 {
    return is_ascii_punct(cp)
  }
  if cp > 0x1FBCA {
    return false
  }
  let mask = punct_mask_for_high(cp >> 4)
  (mask & (1 << (cp & 15))) != 0
}

///| Decode one UTF-8 codepoint starting at byte `pos` in `s`. Returns `(codepoint, byte_len)`.
///| Strictly validates continuation bytes, overlong encodings, and surrogate/range limits;
///| returns `(0xFFFD, 1)` on any invalid or truncated UTF-8 sequence.
pub fn utf8_decode(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  if pos >= n {
    return (0, 0)
  }
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
    }
    return (0xFFFD, 1)
  }
  if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp >= 0x800 && !(cp >= 0xD800 && cp <= 0xDFFF) {
        return (cp, 3)
      }
    }
    return (0xFFFD, 1)
  }
  if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      if cp >= 0x10000 && cp <= 0x10FFFF {
        return (cp, 4)
      }
    }
    return (0xFFFD, 1)
  }
  (0xFFFD, 1)
}

///| Decode the UTF-8 codepoint immediately before `pos` in `s`. Returns `(cp, start_pos)`.
pub fn utf8_decode_prev(s : String, pos : Int) -> (Int, Int) {
  if pos <= 0 {
    return (0, 0)
  }
  let mut i = pos - 1
  let min_i = if pos >= 4 { pos - 4 } else { 0 }
  while i > min_i && (s.code_unit_at(i) & 0xC0) == 0x80 {
    i = i - 1
  }
  let (cp, clen) = utf8_decode(s, i)
  if i + clen == pos {
    (cp, i)
  } else {
    (0xFFFD, pos - 1)
  }
}

///| Encode a Unicode scalar value as UTF-8 bytes into `sb`.
pub fn write_utf8(sb : StringBuilder, cp : Int) -> Unit {
  let c = if cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else {
    cp
  }
  if c < 0x80 {
    sb.write_byte(c.to_byte())
  } else if c < 0x800 {
    sb.write_byte((0xC0 | (c >> 6)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  } else if c < 0x10000 {
    sb.write_byte((0xE0 | (c >> 12)).to_byte())
    sb.write_byte((0x80 | ((c >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (c >> 18)).to_byte())
    sb.write_byte((0x80 | ((c >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((c >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  }
}

///| Returns true if `cp` is a CJK character per CommonMark CJK-friendly emphasis spec (Unicode 17).
pub fn is_cjk_char(cp : Int) -> Bool {
  if cp < 0x1100 {
    return false
  }
  (cp >= 0x1100 && cp <= 0x11FF) ||
  cp == 0x20A9 ||
  (cp >= 0x2329 && cp <= 0x232A) ||
  (cp >= 0x2630 && cp <= 0x2637) ||
  (cp >= 0x268A && cp <= 0x268F) ||
  (cp >= 0x2E80 && cp <= 0x2E99) ||
  (cp >= 0x2E9B && cp <= 0x2EF3) ||
  (cp >= 0x2F00 && cp <= 0x2FD5) ||
  (cp >= 0x2FF0 && cp <= 0x303E) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x3099 && cp <= 0x30FF) ||
  (cp >= 0x3105 && cp <= 0x312F) ||
  (cp >= 0x3131 && cp <= 0x318E) ||
  (cp >= 0x3190 && cp <= 0x31E5) ||
  (cp >= 0x31EF && cp <= 0x321E) ||
  (cp >= 0x3220 && cp <= 0x3247) ||
  (cp >= 0x3250 && cp <= 0xA48C) ||
  (cp >= 0xA490 && cp <= 0xA4C6) ||
  (cp >= 0xA960 && cp <= 0xA97C) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0xD7B0 && cp <= 0xD7C6) ||
  (cp >= 0xD7CB && cp <= 0xD7FB) ||
  (cp >= 0xF900 && cp <= 0xFAFF) ||
  (cp >= 0xFE10 && cp <= 0xFE19) ||
  (cp >= 0xFE30 && cp <= 0xFE52) ||
  (cp >= 0xFE54 && cp <= 0xFE66) ||
  (cp >= 0xFE68 && cp <= 0xFE6B) ||
  (cp >= 0xFF01 && cp <= 0xFFBE) ||
  (cp >= 0xFFC2 && cp <= 0xFFC7) ||
  (cp >= 0xFFCA && cp <= 0xFFCF) ||
  (cp >= 0xFFD2 && cp <= 0xFFD7) ||
  (cp >= 0xFFDA && cp <= 0xFFDC) ||
  (cp >= 0xFFE0 && cp <= 0xFFE6) ||
  (cp >= 0xFFE8 && cp <= 0xFFEE) ||
  (cp >= 0x16FE0 && cp <= 0x16FE4) ||
  (cp >= 0x16FF0 && cp <= 0x16FF6) ||
  (cp >= 0x17000 && cp <= 0x18CD5) ||
  (cp >= 0x18CFF && cp <= 0x18D1E) ||
  (cp >= 0x18D80 && cp <= 0x18DF2) ||
  (cp >= 0x1AFF0 && cp <= 0x1AFF3) ||
  (cp >= 0x1AFF5 && cp <= 0x1AFFB) ||
  (cp >= 0x1AFFD && cp <= 0x1AFFE) ||
  (cp >= 0x1B000 && cp <= 0x1B122) ||
  cp == 0x1B132 ||
  (cp >= 0x1B150 && cp <= 0x1B152) ||
  cp == 0x1B155 ||
  (cp >= 0x1B164 && cp <= 0x1B167) ||
  (cp >= 0x1B170 && cp <= 0x1B2FB) ||
  (cp >= 0x1D300 && cp <= 0x1D356) ||
  (cp >= 0x1D360 && cp <= 0x1D376) ||
  cp == 0x1F200 ||
  cp == 0x1F202 ||
  (cp >= 0x1F210 && cp <= 0x1F219) ||
  (cp >= 0x1F21B && cp <= 0x1F22E) ||
  (cp >= 0x1F230 && cp <= 0x1F231) ||
  cp == 0x1F237 ||
  cp == 0x1F23B ||
  (cp >= 0x1F240 && cp <= 0x1F248) ||
  (cp >= 0x1F260 && cp <= 0x1F265) ||
  (cp >= 0x20000 && cp <= 0x3FFFD)
}

pub fn is_non_emoji_general_vs(cp : Int) -> Bool {
  cp >= 0xFE00 && cp <= 0xFE0E
}

pub fn is_ideographic_vs(cp : Int) -> Bool {
  cp >= 0xE0100 && cp <= 0xE01EF
}

pub fn is_cjk_ambiguous_punct_seq(cp : Int, vs : Int) -> Bool {
  vs == 0xFE01 && (cp == 0x2018 || cp == 0x2019 || cp == 0x201C || cp == 0x201D)
}

///| Unicode case folding + whitespace collapse for CommonMark link reference labels.
pub fn normalize_link_label(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return ""
  }
  // Zero-alloc fast path: already trimmed, lowercase ASCII with no tabs/newlines/double-spaces
  if s.code_unit_at(0) > 32 && s.code_unit_at(n - 1) > 32 {
    let mut clean = true
    let mut prev_sp = false
    let mut k = 0
    while k < n {
      let b = s.code_unit_at(k)
      if b >= 0x80 || (b >= 65 && b <= 90) || b < 32 {
        clean = false
        break
      }
      if b == 32 {
        if prev_sp {
          clean = false
          break
        }
        prev_sp = true
      } else {
        prev_sp = false
      }
      k = k + 1
    }
    if clean {
      return s
    }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  // skip leading whitespace
  while i < n && is_ascii_ws(s.code_unit_at(i)) {
    i = i + 1
  }
  let mut in_ws = false
  while i < n {
    let b = s.code_unit_at(i)
    if is_ascii_ws(b) {
      in_ws = true
      i = i + 1
    } else {
      if in_ws {
        sb.write_byte((32).to_byte())
        in_ws = false
      }
      if b < 0x80 {
        if b >= 65 && b <= 90 {
          sb.write_byte((b + 32).to_byte())
        } else {
          sb.write_byte(b.to_byte())
        }
        i = i + 1
      } else {
        let (cp, clen) = utf8_decode(s, i)
        // Unicode full case folding for common scripts (Latin, Greek, Cyrillic, ß/ẞ)
        if cp == 0x00DF || cp == 0x1E9E {
          sb.write_string("ss")
        } else if (cp >= 0x00C0 && cp <= 0x00D6) || (cp >= 0x00D8 && cp <= 0x00DE) {
          write_utf8(sb, cp + 32)
        } else if cp >= 0x0391 && cp <= 0x03A1 {
          write_utf8(sb, cp + 32)
        } else if cp >= 0x03A3 && cp <= 0x03AB {
          write_utf8(sb, cp + 32)
        } else if cp == 0x03C2 {
          write_utf8(sb, 0x03C3)
        } else if cp >= 0x0410 && cp <= 0x042F {
          write_utf8(sb, cp + 32)
        } else if cp >= 0x0400 && cp <= 0x040F {
          write_utf8(sb, cp + 0x50)
        } else {
          write_utf8(sb, cp)
        }
        i = i + clen
      }
    }
  }
  sb.to_string()
}
