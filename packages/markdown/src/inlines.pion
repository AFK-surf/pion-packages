///| CommonMark 0.31.2 + GFM + Smart Punctuation + CJK-Friendly Phase 2 Inline Parser & Direct HTML Renderer.

// InlineNode tags (stored in flat 32-byte POD val struct)
// 0 = Span(a=start, b=end)
// 1 = OwnedText(a=str_pool_idx)
// 2 = CodeSpan(a=start, b=end)
// 3 = OwnedCode(a=str_pool_idx)
// 4 = InlineHtmlSpan(a=start, b=end)
// 5 = SoftBreak
// 6 = HardBreak
// 7 = StartEm
// 8 = EndEm
// 9 = StartStrong
// 10 = EndStrong
// 11 = StartDel
// 12 = EndDel
// 13 = StartLink(a=link_pool_idx)
// 14 = EndLink
// 15 = StartImage(a=link_pool_idx)
// 16 = EndImage
// 17 = DelimText(a=delim_byte, b=count)
// 18 = BracketText(a=1 for "![", 0 for "[")
// 19 = Removed

val struct InlineNode {
  tag : Int
  a : Int
  b : Int
  next : Int
}

val struct DelimEntry {
  node_idx : Int
  meta : Int // delim | (orig_len << 8)
  len : Int
  flags : Int // bit 0: can_open, bit 1: can_close, bit 2: active
}

val struct BracketEntry {
  node_idx : Int
  delim_idx : Int
  text_start : Int
  flags : Int // bit 0: is_image, bit 1: active
}

val struct LinkInfo {
  link_type : LinkType
  dest : String
  title : String
  ref_id : String
  dest_start : Int // >= 0 means zero-copy slice of `s[dest_start..dest_end]`
  dest_end : Int
  title_start : Int // >= 0 means zero-copy slice of `s[title_start..title_end]`
  title_end : Int
}

fn link_dest_str(s : String, info : LinkInfo) -> String {
  if info.dest_start >= 0 { s.slice(info.dest_start, info.dest_end) } else { info.dest }
}

fn link_title_str(s : String, info : LinkInfo) -> String {
  if info.title_start >= 0 { s.slice(info.title_start, info.title_end) } else { info.title }
}

///| Reusable per-document inline parsing context (avoids per-paragraph allocations).
struct InlineCtx {
  table : Array[Byte] // 256-byte O(1) inline trigger LUT
  ascii_cls : Array[Byte] // 256-byte ASCII LUT: bit 0 = ws, bit 1 = punct (128..255 = 0)
  href_tbl : Array[Byte] // 256-byte LUT: 1 = safe href byte
  esc_tbl : Array[Byte] // 256-byte LUT for body HTML escaping
  esc_attr_tbl : Array[Byte] // 256-byte LUT for attribute HTML escaping (always escapes `"`)
  nodes : Array[InlineNode]
  prevs : Array[Int]
  delims : Array[DelimEntry]
  delim_prev : Array[Int]
  delim_next : Array[Int]
  brackets : Array[BracketEntry]
  str_pool : Array[String]
  link_pool : Array[LinkInfo]
  bottoms : Array[Int] // 30 slots
  bt_failed : Array[Int] // 65 slots
  bt_failed_big : Map[Int, Int] // for backtick runs >= 65
  html_fail : Array[Int] // 4 slots: comment, pi, cdata, decl
  para_sb : StringBuilder
  code_sb : StringBuilder
  sc : ScanOut
  mut head : Int
  mut tail : Int
  mut delim_tail : Int
  mut bt_init : Bool
  mut html_fail_init : Bool
  mut has_quotes : Bool
}

fn make_ascii_cls_table() -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(256)
  let zero = (0).to_byte()
  let mut i = 0
  while i < 128 {
    let mut v = 0
    if is_ascii_ws(i) {
      v = v | 1
    }
    if is_ascii_punct(i) {
      v = v | 2
    }
    tbl.push(v.to_byte())
    i = i + 1
  }
  while i < 256 {
    tbl.push(zero)
    i = i + 1
  }
  tbl
}

fn make_inline_table(opts : Options, escape_quote : Bool) -> Array[Byte] {
  let tbl : Array[Byte] = Array::with_capacity(256)
  let zero = (0).to_byte()
  let mut i = 0
  while i < 256 {
    tbl.push(zero)
    i = i + 1
  }
  // 2 = HTML-escape-only byte (not an inline trigger, unless overridden to 1 below)
  let two = (2).to_byte()
  tbl[62] = two // '>'
  if escape_quote {
    tbl[34] = two // '"'
  }
  // 1 = inline trigger byte
  let one = (1).to_byte()
  tbl[92] = one // '\'
  tbl[10] = one // '\n'
  tbl[96] = one // '`'
  tbl[38] = one // '&'
  tbl[60] = one // '<'
  tbl[42] = one // '*'
  tbl[95] = one // '_'
  tbl[91] = one // '['
  tbl[93] = one // ']'
  tbl[33] = one // '!'
  if opts.strikethrough {
    tbl[126] = one // '~'
  }
  if opts.smart_punctuation {
    tbl[34] = one // '"'
    tbl[39] = one // '\''
    tbl[45] = one // '-'
    tbl[46] = one // '.'
  }
  tbl
}

fn new_inline_ctx(opts : Options, escape_quote : Bool) -> InlineCtx {
  let bottoms : Array[Int] = Array::with_capacity(30)
  let mut i = 0
  while i < 30 {
    bottoms.push(0)
    i = i + 1
  }
  let bt_failed : Array[Int] = Array::with_capacity(65)
  i = 0
  while i < 65 {
    bt_failed.push(-1)
    i = i + 1
  }
  let html_fail : Array[Int] = Array::with_capacity(4)
  i = 0
  while i < 4 {
    html_fail.push(-1)
    i = i + 1
  }
  InlineCtx::{
    table: make_inline_table(opts, escape_quote),
    ascii_cls: make_ascii_cls_table(),
    href_tbl: make_href_safe_table(),
    esc_tbl: make_html_escape_table(escape_quote),
    esc_attr_tbl: make_html_escape_table(true),
    nodes: Array::with_capacity(64),
    prevs: Array::with_capacity(64),
    delims: Array::with_capacity(16),
    delim_prev: Array::with_capacity(16),
    delim_next: Array::with_capacity(16),
    brackets: Array::with_capacity(8),
    str_pool: Array::new(),
    link_pool: Array::new(),
    bottoms,
    bt_failed,
    bt_failed_big: Map::new(),
    html_fail,
    para_sb: StringBuilder::new(),
    code_sb: StringBuilder::new(),
    sc: new_scan_out(),
    head: -1,
    tail: -1,
    delim_tail: -1,
    bt_init: false,
    html_fail_init: false,
    has_quotes: false,
  }
}

fn il_push_fast(
  nodes : Array[InlineNode],
  prevs : Array[Int],
  tail : Int,
  tag : Int,
  a : Int,
  b : Int,
) -> Int {
  let idx = nodes.length()
  nodes.push(InlineNode::{ tag, a, b, next: -1 })
  prevs.push(tail)
  if tail >= 0 {
    let pn = nodes[tail]
    nodes[tail] = InlineNode::{ tag: pn.tag, a: pn.a, b: pn.b, next: idx }
  }
  idx
}

fn il_push(ctx : InlineCtx, tag : Int, a : Int, b : Int) -> Int {
  let nodes = ctx.nodes
  let idx = nodes.length()
  let prev = ctx.tail
  nodes.push(InlineNode::{ tag, a, b, next: -1 })
  ctx.prevs.push(prev)
  if prev >= 0 {
    let pn = nodes[prev]
    nodes[prev] = InlineNode::{ tag: pn.tag, a: pn.a, b: pn.b, next: idx }
  } else {
    ctx.head = idx
  }
  ctx.tail = idx
  idx
}

fn il_insert_after(ctx : InlineCtx, after_idx : Int, tag : Int, a : Int, b : Int) -> Int {
  let nodes = ctx.nodes
  let idx = nodes.length()
  let an = nodes[after_idx]
  let nxt = an.next
  nodes.push(InlineNode::{ tag, a, b, next: nxt })
  ctx.prevs.push(after_idx)
  nodes[after_idx] = InlineNode::{ tag: an.tag, a: an.a, b: an.b, next: idx }
  if nxt >= 0 {
    ctx.prevs[nxt] = idx
  } else {
    ctx.tail = idx
  }
  idx
}

fn il_insert_before(ctx : InlineCtx, before_idx : Int, tag : Int, a : Int, b : Int) -> Int {
  let nodes = ctx.nodes
  let prevs = ctx.prevs
  let idx = nodes.length()
  let prv = prevs[before_idx]
  nodes.push(InlineNode::{ tag, a, b, next: before_idx })
  prevs.push(prv)
  prevs[before_idx] = idx
  if prv >= 0 {
    let pn = nodes[prv]
    nodes[prv] = InlineNode::{ tag: pn.tag, a: pn.a, b: pn.b, next: idx }
  } else {
    ctx.head = idx
  }
  idx
}

fn il_set_node(ctx : InlineCtx, idx : Int, tag : Int, a : Int, b : Int) -> Unit {
  let cur = ctx.nodes[idx]
  ctx.nodes[idx] = InlineNode::{ tag, a, b, next: cur.next }
}

fn il_push_str(ctx : InlineCtx, s : String) -> Int {
  let idx = ctx.str_pool.length()
  ctx.str_pool.push(s)
  idx
}

fn delim_slot(d : Int) -> Int {
  if d == 42 {
    0
  } else if d == 95 {
    1
  } else if d == 126 {
    2
  } else if d == 34 {
    3
  } else {
    4
  }
}

///| Compute CommonMark (or CJK-friendly) flanking flags as a bitmask (bit 0 = can_open, bit 1 = can_close).
///| Zero tuple allocations and zero RC on ASCII fast path!
fn compute_flanking_mask(
  ascii_cls : Array[Byte],
  s : String,
  seg_start : Int,
  seg_end : Int,
  run_start : Int,
  run_end : Int,
  delim : Int,
  opts : Options,
) -> Int {
  let mut prev_cp = 10
  let mut prev_start = seg_start
  if run_start > seg_start {
    let pb = s.code_unit_at(run_start - 1)
    if pb < 128 {
      prev_cp = pb
      prev_start = run_start - 1
    } else {
      let (cp, ps) = utf8_decode_prev(s, run_start)
      prev_cp = cp
      prev_start = ps
    }
  }
  let mut next_cp = 10
  if run_end < seg_end {
    let nb = s.code_unit_at(run_end)
    if nb < 128 {
      next_cp = nb
    } else {
      let (cp, _) = utf8_decode(s, run_end)
      next_cp = cp
    }
  }

  let run_len = run_end - run_start

  if opts.cjk_friendly && (delim == 42 || delim == 95 || (delim == 126 && (run_len == 1 || run_len == 2))) {
    if delim == 126 && run_len == 2 {
      let before_ws = is_unicode_ws(prev_cp)
      let after_ws = is_unicode_ws(next_cp)
      return (if !after_ws { 1 } else { 0 }) | (if !before_ws { 2 } else { 0 })
    }
    let prev_is_vs = is_non_emoji_general_vs(prev_cp)
    let mut prev_is_cjk = false
    let mut prev_is_ivs = false
    let mut prev_is_punct = false
    if prev_is_vs {
      if prev_start > seg_start {
        let (pp_cp, _) = utf8_decode_prev(s, prev_start)
        prev_is_cjk = is_cjk_char(pp_cp) || is_cjk_ambiguous_punct_seq(pp_cp, prev_cp)
        prev_is_punct = is_unicode_punct(pp_cp)
      }
    } else {
      prev_is_cjk = is_cjk_char(prev_cp)
      prev_is_ivs = is_ideographic_vs(prev_cp)
      prev_is_punct = is_unicode_punct(prev_cp)
    }

    let before_ws = is_unicode_ws(prev_cp)
    let after_ws = is_unicode_ws(next_cp)
    let after_punct = is_unicode_punct(next_cp)
    let before_ws_or_punct = before_ws || prev_is_punct
    let after_ws_or_punct = after_ws || after_punct

    if delim == 95 || delim == 126 {
      let open = !after_ws && (!after_punct || before_ws_or_punct || next_cp == 42 || next_cp == 95)
      let close = !before_ws && (!prev_is_punct || after_ws_or_punct || prev_cp == 42 || prev_cp == 95)
      let co = open && (before_ws_or_punct || !close)
      let cc = close && (after_ws_or_punct || !open)
      return (if co { 1 } else { 0 }) | (if cc { 2 } else { 0 })
    }

    let before_cjk_or_ivs = prev_is_cjk || prev_is_ivs
    let after_cjk = is_cjk_char(next_cp)
    let co = !after_ws &&
    (!after_punct || before_ws_or_punct || before_cjk_or_ivs || after_cjk || next_cp == 42 || next_cp == 95)
    let cc = !before_ws &&
    (!prev_is_punct || after_ws_or_punct || prev_is_cjk || after_cjk || prev_cp == 42 || prev_cp == 95)
    return (if co { 1 } else { 0 }) | (if cc { 2 } else { 0 })
  }

  let before_ws = if prev_cp < 128 { (ascii_cls[prev_cp].to_int() & 1) != 0 } else { is_unicode_ws(prev_cp) }
  let before_punct = if prev_cp < 128 { (ascii_cls[prev_cp].to_int() & 2) != 0 } else { is_unicode_punct(prev_cp) }
  let after_ws = if next_cp < 128 { (ascii_cls[next_cp].to_int() & 1) != 0 } else { is_unicode_ws(next_cp) }
  let after_punct = if next_cp < 128 { (ascii_cls[next_cp].to_int() & 2) != 0 } else { is_unicode_punct(next_cp) }

  let left_flanking = !after_ws && (!after_punct || before_ws || before_punct)
  let right_flanking = !before_ws && (!before_punct || after_ws || after_punct)

  if delim == 95 {
    let co = left_flanking && (!right_flanking || before_punct)
    let cc = right_flanking && (!left_flanking || after_punct)
    (if co { 1 } else { 0 }) | (if cc { 2 } else { 0 })
  } else if delim == 126 {
    if run_len == 2 {
      (if left_flanking { 1 } else { 0 }) | (if right_flanking { 2 } else { 0 })
    } else if run_len == 1 {
      let co = left_flanking && (!right_flanking || before_punct)
      let cc = right_flanking && (!left_flanking || after_punct)
      (if co { 1 } else { 0 }) | (if cc { 2 } else { 0 })
    } else {
      0
    }
  } else if delim == 34 || delim == 39 {
    let prev_blocks_sq = delim == 39 && (prev_cp == 93 || prev_cp == 41)
    let co = !prev_blocks_sq && left_flanking && (!right_flanking || before_punct)
    (if co { 1 } else { 0 }) | (if right_flanking { 2 } else { 0 })
  } else {
    (if left_flanking { 1 } else { 0 }) | (if right_flanking { 2 } else { 0 })
  }
}

fn delim_push(ctx : InlineCtx, entry : DelimEntry) -> Unit {
  let didx = ctx.delims.length()
  let prev = ctx.delim_tail
  ctx.delims.push(entry)
  ctx.delim_prev.push(prev)
  ctx.delim_next.push(-1)
  if prev >= 0 {
    ctx.delim_next[prev] = didx
  }
  ctx.delim_tail = didx
}

fn delim_unlink(ctx : InlineCtx, idx : Int) -> Unit {
  let dp = ctx.delim_prev
  let dn = ctx.delim_next
  let p = dp[idx]
  let nx = dn[idx]
  if p >= 0 {
    dn[p] = nx
  }
  if nx >= 0 {
    dp[nx] = p
  } else {
    ctx.delim_tail = p
  }
  dp[idx] = -1
  dn[idx] = -1
}

///| Resolve smart quotes (`'` and `"`, InlineNode tag 22) in O(N) linear pass starting from `start_node`,
///| matching `pulldown-cmark 0.13.1` single-pass quote direction rules.
fn resolve_smart_quotes(ctx : InlineCtx, start_node : Int) -> Unit {
  if !ctx.has_quotes || start_node < 0 {
    return ()
  }
  let mut single_quote_open = -1
  let mut double_quote_open = false
  let mut cur = start_node
  while cur >= 0 {
    let nd = ctx.nodes[cur]
    if nd.tag == 22 {
      let c = nd.a
      let fmask = nd.b
      let can_open = (fmask & 1) != 0
      let can_close = (fmask & 2) != 0
      if c == 39 {
        if single_quote_open >= 0 && can_close {
          il_set_node(ctx, single_quote_open, 1, il_push_str(ctx, "‘"), 0)
          single_quote_open = -1
        } else if can_open {
          single_quote_open = cur
        }
        il_set_node(ctx, cur, 1, il_push_str(ctx, "’"), 0)
      } else {
        if can_close && double_quote_open {
          double_quote_open = false
          il_set_node(ctx, cur, 1, il_push_str(ctx, "”"), 0)
        } else {
          if can_open && !double_quote_open {
            double_quote_open = true
          }
          il_set_node(ctx, cur, 1, il_push_str(ctx, "“"), 0)
        }
      }
    }
    cur = nd.next
  }
}

///| Process emphasis, strong, and strikethrough in `ctx.delims[stack_bottom..]` in O(N) time
///| using an explicit doubly-linked list (`delim_prev`/`delim_next`) with O(1) unlink and `bottoms`.
fn process_emphasis(ctx : InlineCtx, stack_bottom : Int) -> Unit {
  let delims = ctx.delims
  let dlen = delims.length()
  if dlen <= stack_bottom {
    return ()
  }
  let delim_prev = ctx.delim_prev
  let delim_next = ctx.delim_next
  let bottoms = ctx.bottoms
  let nodes = ctx.nodes
  let before_bottom = delim_prev[stack_bottom]
  let use_bottoms = dlen - stack_bottom > 12
  if use_bottoms {
    let mut bi = 0
    while bi < 18 {
      bottoms[bi] = stack_bottom
      bi = bi + 1
    }
  } else {
    bottoms[12] = stack_bottom
  }

  let mut closer_idx = stack_bottom
  while closer_idx >= 0 {
    let closer = delims[closer_idx]
    let c_flags = closer.flags
    let next_after = delim_next[closer_idx]
    if (c_flags & 2) == 0 || closer.len == 0 {
      closer_idx = next_after
      continue
    }
    let c_delim = closer.meta & 0xFF
    let c_orig_len = closer.meta >> 8
    let c_can_open = (c_flags & 1) != 0
    let slot = if c_delim == 126 {
      12
    } else if use_bottoms {
      delim_slot(c_delim) * 6 + (c_orig_len % 3) * 2 + (if c_can_open { 1 } else { 0 })
    } else {
      0
    }
    let min_opener = if use_bottoms || c_delim == 126 { bottoms[slot] } else { stack_bottom }

    let mut opener_idx = delim_prev[closer_idx]
    let mut found_opener = -1
    while opener_idx >= min_opener {
      let op = delims[opener_idx]
      if (op.flags & 1) != 0 && op.len > 0 && (op.meta & 0xFF) == c_delim {
        let o_orig_len = op.meta >> 8
        if c_delim == 126 {
          if o_orig_len == c_orig_len {
            found_opener = opener_idx
            break
          }
        } else {
          let o_can_close = (op.flags & 2) != 0
          let odd_match = (o_can_close || c_can_open) &&
          ((o_orig_len + c_orig_len) % 3 == 0) &&
          !((o_orig_len % 3 == 0) && (c_orig_len % 3 == 0))
          if !odd_match {
            found_opener = opener_idx
            break
          }
        }
      }
      opener_idx = delim_prev[opener_idx]
    }

    if found_opener >= 0 {
      let op = delims[found_opener]
      let use_delims = if c_delim == 126 {
        closer.len
      } else if op.len >= 2 && closer.len >= 2 {
        2
      } else {
        1
      }

      let new_op_len = op.len - use_delims
      let new_cl_len = closer.len - use_delims

      let st_tag = if c_delim == 126 { 11 } else if use_delims == 2 { 9 } else { 7 }
      let et_tag = st_tag + 1

      // O(1) unlink all delimiters strictly between found_opener and closer_idx!
      delim_next[found_opener] = closer_idx
      delim_prev[closer_idx] = found_opener

      if new_op_len == 0 {
        let on = nodes[op.node_idx]
        nodes[op.node_idx] = InlineNode::{ tag: st_tag, a: 0, b: 0, next: on.next }
        delims[found_opener] = DelimEntry::{
          node_idx: op.node_idx,
          meta: op.meta,
          len: 0,
          flags: op.flags & 3,
        }
        let p = delim_prev[found_opener]
        let nx = delim_next[found_opener]
        if p >= 0 { delim_next[p] = nx }
        if nx >= 0 { delim_prev[nx] = p } else { ctx.delim_tail = p }
        delim_prev[found_opener] = -1
        delim_next[found_opener] = -1
      } else {
        let on = nodes[op.node_idx]
        nodes[op.node_idx] = InlineNode::{ tag: 17, a: c_delim, b: new_op_len, next: on.next }
        delims[found_opener] = DelimEntry::{
          node_idx: op.node_idx,
          meta: op.meta,
          len: new_op_len,
          flags: op.flags,
        }
        let _ = il_insert_after(ctx, op.node_idx, st_tag, 0, 0)
      }

      if new_cl_len == 0 {
        let cn = nodes[closer.node_idx]
        nodes[closer.node_idx] = InlineNode::{ tag: et_tag, a: 0, b: 0, next: cn.next }
        delims[closer_idx] = DelimEntry::{
          node_idx: closer.node_idx,
          meta: closer.meta,
          len: 0,
          flags: c_flags & 3,
        }
        let p = delim_prev[closer_idx]
        let nx = delim_next[closer_idx]
        if p >= 0 { delim_next[p] = nx }
        if nx >= 0 { delim_prev[nx] = p } else { ctx.delim_tail = p }
        delim_prev[closer_idx] = -1
        delim_next[closer_idx] = -1
        closer_idx = next_after
      } else {
        let cn = nodes[closer.node_idx]
        nodes[closer.node_idx] = InlineNode::{ tag: 17, a: c_delim, b: new_cl_len, next: cn.next }
        delims[closer_idx] = DelimEntry::{
          node_idx: closer.node_idx,
          meta: closer.meta,
          len: new_cl_len,
          flags: c_flags,
        }
        let _ = il_insert_before(ctx, closer.node_idx, et_tag, 0, 0)
      }
    } else {
      if use_bottoms || c_delim == 126 {
        bottoms[slot] = closer_idx
      }
      if !c_can_open {
        let p = delim_prev[closer_idx]
        let nx = delim_next[closer_idx]
        if p >= 0 { delim_next[p] = nx }
        if nx >= 0 { delim_prev[nx] = p } else { ctx.delim_tail = p }
        delim_prev[closer_idx] = -1
        delim_next[closer_idx] = -1
      }
      closer_idx = next_after
    }
  }

  // Truncate delimiter stack back to stack_bottom
  if before_bottom >= 0 {
    delim_next[before_bottom] = -1
  }
  ctx.delim_tail = before_bottom
  while delims.length() > stack_bottom {
    let _ = delims.pop()
    let _ = delim_prev.pop()
    let _ = delim_next.pop()
  }
}

///| Write `n` copies of byte `ch` as a String.
fn repeat_byte(ch : Int, count : Int) -> String {
  if count == 1 {
    if ch == 42 { return "*" }
    if ch == 95 { return "_" }
    if ch == 126 { return "~" }
    if ch == 34 { return "\"" }
    if ch == 39 { return "'" }
  }
  if count == 2 {
    if ch == 42 { return "**" }
    if ch == 95 { return "__" }
    if ch == 126 { return "~~" }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < count {
    sb.write_byte(ch.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Expand smart punctuation hyphen runs (`--`, `---`, etc.) per pulldown-cmark / CommonMark rules.
fn smart_dashes(count : Int) -> String {
  let sb = StringBuilder::new()
  let mut em = 0
  let mut en = 0
  if count % 3 == 0 {
    em = count / 3
  } else if count % 2 == 0 {
    en = count / 2
  } else if count % 3 == 2 {
    em = (count - 2) / 3
    en = 1
  } else {
    em = (count - 4) / 3
    en = 2
  }
  let mut i = 0
  while i < em {
    sb.write_string("—")
    i = i + 1
  }
  i = 0
  while i < en {
    sb.write_string("–")
    i = i + 1
  }
  sb.to_string()
}

///| Tiny loop-versionable leaf scanner: returns the first index in `s[start..end]` with `tbl[b] != 0`, or `end`.
fn skip_plain_inline(tbl : Array[Byte], s : String, start : Int, end : Int) -> Int {
  let zero = (0).to_byte()
  let mut i = start
  let end4 = end - 3
  while i < end4 {
    let m = tbl[s.code_unit_at(i)].to_int() |
    tbl[s.code_unit_at(i + 1)].to_int() |
    tbl[s.code_unit_at(i + 2)].to_int() |
    tbl[s.code_unit_at(i + 3)].to_int()
    if m != 0 {
      break
    }
    i = i + 4
  }
  while i < end && tbl[s.code_unit_at(i)] == zero {
    i = i + 1
  }
  i
}

///| Tiny leaf function to find the first inline trigger byte in `s[seg_start..seg_end]`.
///| Returns:
///|   -1 = plain text, 100% HTML-raw-safe (no inline triggers, no HTML-escape bytes)
///|   -2 = plain text, needs HTML escaping (`>` or `"`)
///|   >= 0 = index of first inline trigger byte (sets `ctx.sc.flag = true` if an HTML-escape byte preceded it)
fn find_first_inline_special(
  tbl : Array[Byte],
  s : String,
  seg_start : Int,
  seg_end : Int,
  sc : ScanOut,
) -> Int {
  let one = (1).to_byte()
  let mut saw_esc = false
  let mut i = seg_start
  while i < seg_end {
    i = skip_plain_inline(tbl, s, i, seg_end)
    if i >= seg_end {
      break
    }
    let b = s.code_unit_at(i)
    let v = tbl[b]
    if v == one {
      // Fast skip literal '&' that cannot start an entity (e.g. "A & B")
      if b == 38 {
        if i + 2 >= seg_end {
          saw_esc = true
          i = i + 1
          continue
        }
        let b1 = s.code_unit_at(i + 1)
        if b1 != 35 && !((b1 >= 65 && b1 <= 90) || (b1 >= 97 && b1 <= 122)) {
          saw_esc = true
          i = i + 1
          continue
        }
      }
      sc.flag = saw_esc
      return i
    }
    saw_esc = true
    i = i + 1
  }
  if saw_esc { -2 } else { -1 }
}

///| Scan inline content `s[seg_start..seg_end]` starting at `first_special` into `ctx`.
///| Emits tag 0 (RawSafeSpan) when a text span needs no HTML escaping, tag 20 (EscSpan) otherwise;
///| tag 2 (RawSafeCodeSpan) when a code span needs no HTML escaping, tag 21 (EscCodeSpan) otherwise.
fn scan_inlines_to_ctx(
  ctx : InlineCtx,
  s : String,
  seg_start : Int,
  seg_end : Int,
  first_special : Int,
  had_esc_before : Bool,
  ref_defs : Map[String, LinkDef],
  opts : Options,
) -> Unit {
  let tbl = ctx.table
  let ascii_cls = ctx.ascii_cls
  let nodes = ctx.nodes
  let prevs = ctx.prevs
  let delims = ctx.delims
  let delim_prev = ctx.delim_prev
  let delim_next = ctx.delim_next
  let brackets = ctx.brackets
  let sc = ctx.sc
  let zero = (0).to_byte()
  let two = (2).to_byte()
  let mut i = first_special

  nodes.clear()
  prevs.clear()
  if delims.length() > 0 {
    delims.clear()
    delim_prev.clear()
    delim_next.clear()
  }
  if brackets.length() > 0 {
    brackets.clear()
  }
  if ctx.str_pool.length() > 0 {
    ctx.str_pool.clear()
  }
  if ctx.link_pool.length() > 0 {
    ctx.link_pool.clear()
  }
  if ctx.bt_failed_big.length() > 0 {
    ctx.bt_failed_big.clear()
  }
  let mut head = -1
  let mut tail = -1
  let mut delim_tail = -1
  ctx.bt_init = false
  ctx.html_fail_init = false
  ctx.has_quotes = false

  let has_ref_defs = ref_defs.length() > 0
  let mut text_start = seg_start
  let mut span_esc = had_esc_before

  while i < seg_end {
    let b = s.code_unit_at(i)
    let tv = tbl[b]
    if tv == zero {
      i = skip_plain_inline(tbl, s, i + 1, seg_end)
      continue
    }
    if tv == two {
      span_esc = true
      i = i + 1
      continue
    }

    // 1. Backslash escape or hard line break
    if b == 92 {
      if i + 1 < seg_end {
        let nb = s.code_unit_at(i + 1)
        if nb == 10 {
          if text_start < i {
            tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
            if head < 0 { head = tail }
          }
          tail = il_push_fast(nodes, prevs, tail, 6, 0, 0)
          if head < 0 { head = tail }
          i = i + 2
          while i < seg_end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
            i = i + 1
          }
          text_start = i
          span_esc = false
          continue
        } else if is_ascii_punct(nb) {
          if text_start < i {
            tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
            if head < 0 { head = tail }
          }
          let nb_esc = nb == 38 || nb == 60 || nb == 62 || nb == 34
          tail = il_push_fast(nodes, prevs, tail, if nb_esc { 20 } else { 0 }, i + 1, i + 2)
          if head < 0 { head = tail }
          i = i + 2
          text_start = i
          span_esc = false
          continue
        }
      }
      i = i + 1
      continue
    }

    // 2. Newline: SoftBreak or HardBreak (2+ trailing spaces; strip trailing spaces/tabs before SoftBreak)
    if b == 10 {
      let mut sp_start = i
      while sp_start > text_start && s.code_unit_at(sp_start - 1) == 32 {
        sp_start = sp_start - 1
      }
      let trailing_spaces = i - sp_start
      if trailing_spaces < 2 {
        while sp_start > text_start && (s.code_unit_at(sp_start - 1) == 32 || s.code_unit_at(sp_start - 1) == 9) {
          sp_start = sp_start - 1
        }
      }
      if text_start < sp_start {
        tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, sp_start)
        if head < 0 { head = tail }
      }
      tail = il_push_fast(nodes, prevs, tail, if trailing_spaces >= 2 { 6 } else { 5 }, 0, 0)
      if head < 0 { head = tail }
      i = i + 1
      while i < seg_end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
        i = i + 1
      }
      text_start = i
      span_esc = false
      continue
    }

    // 3. Code span (backtick run)
    if b == 96 {
      let run_start = i
      while i < seg_end && s.code_unit_at(i) == 96 {
        i = i + 1
      }
      let ticks = i - run_start
      let can_search = if ticks < 65 {
        if ctx.bt_init { ctx.bt_failed[ticks] < run_start } else { true }
      } else {
        match ctx.bt_failed_big.get(ticks) {
          Some(fp) => fp < run_start
          None => true
        }
      }
      let mut match_pos = -1
      if can_search {
        let mut j = i
        while j < seg_end {
          if s.code_unit_at(j) == 96 {
            let cs = j
            while j < seg_end && s.code_unit_at(j) == 96 {
              j = j + 1
            }
            if j - cs == ticks {
              match_pos = cs
              break
            }
          } else {
            j = j + 1
          }
        }
        if match_pos < 0 {
          if ticks < 65 {
            if !ctx.bt_init {
              let mut bti = 0
              while bti < 65 {
                ctx.bt_failed[bti] = -1
                bti = bti + 1
              }
              ctx.bt_init = true
            }
            ctx.bt_failed[ticks] = seg_end
          } else {
            ctx.bt_failed_big.set(ticks, seg_end)
          }
        }
      }
      if match_pos >= 0 {
        if text_start < run_start {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, run_start)
          if head < 0 { head = tail }
        }
        // Check if code span contains '\n', HTML-escape bytes, or is all spaces
        let mut has_nl = false
        let mut all_spaces = true
        let mut code_esc = false
        let mut k = i
        while k < match_pos {
          let cb = s.code_unit_at(k)
          if cb <= 62 {
            if cb == 10 {
              has_nl = true
              break
            }
            if cb == 38 || cb == 60 || cb == 62 || cb == 34 {
              code_esc = true
            }
            if cb != 32 {
              all_spaces = false
            }
          } else {
            all_spaces = false
          }
          k = k + 1
        }
        if !has_nl {
          let ctag = if code_esc { 21 } else { 2 }
          let rlen = match_pos - i
          if rlen >= 2 && !all_spaces && s.code_unit_at(i) == 32 && s.code_unit_at(match_pos - 1) == 32 {
            tail = il_push_fast(nodes, prevs, tail, ctag, i + 1, match_pos - 1)
          } else {
            tail = il_push_fast(nodes, prevs, tail, ctag, i, match_pos)
          }
          if head < 0 { head = tail }
        } else {
          ctx.code_sb.reset()
          let mut all_sp2 = true
          k = i
          while k < match_pos {
            let cb = s.code_unit_at(k)
            if cb == 10 {
              ctx.code_sb.write_byte((32).to_byte())
            } else {
              if cb != 32 {
                all_sp2 = false
              }
              ctx.code_sb.write_byte(cb.to_byte())
            }
            k = k + 1
          }
          let raw_code = ctx.code_sb.to_string()
          let rlen = raw_code.length()
          let final_code = if rlen >= 2 && !all_sp2 && raw_code.code_unit_at(0) == 32 &&
          raw_code.code_unit_at(rlen - 1) == 32 {
            raw_code.slice(1, rlen - 1)
          } else {
            raw_code
          }
          tail = il_push_fast(nodes, prevs, tail, 3, il_push_str(ctx, final_code), 0)
          if head < 0 { head = tail }
        }
        i = match_pos + ticks
        text_start = i
        span_esc = false
        continue
      }
      continue
    }

    // 4. HTML entity / numeric character reference (fast pre-check before call)
    if b == 38 {
      if i + 2 < seg_end {
        let b1 = s.code_unit_at(i + 1)
        if b1 == 35 || (b1 >= 65 && b1 <= 90) || (b1 >= 97 && b1 <= 122) {
          match scan_entity(s, i, seg_end) {
            Some((decoded, next_i)) => {
              if text_start < i {
                tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
                if head < 0 { head = tail }
              }
              tail = il_push_fast(nodes, prevs, tail, 1, il_push_str(ctx, decoded), 0)
              if head < 0 { head = tail }
              i = next_i
              text_start = i
              span_esc = false
              continue
            }
            None => ()
          }
        }
      }
      span_esc = true
      i = i + 1
      continue
    }

    // 5. Autolink `<...>` or Inline HTML `<...>`
    if b == 60 {
      match scan_autolink(s, i, seg_end) {
        Some((is_email, inner, next_i)) => {
          if text_start < i {
            tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
            if head < 0 { head = tail }
          }
          let lt = if is_email { LinkType::Email } else { LinkType::Autolink }
          let lidx = ctx.link_pool.length()
          ctx.link_pool.push(LinkInfo::{
            link_type: lt,
            dest: inner,
            title: "",
            ref_id: "",
            dest_start: -1,
            dest_end: 0,
            title_start: -1,
            title_end: 0,
          })
          tail = il_push_fast(nodes, prevs, tail, 13, lidx, 0)
          if head < 0 { head = tail }
          tail = il_push_fast(nodes, prevs, tail, 1, il_push_str(ctx, inner), 0)
          tail = il_push_fast(nodes, prevs, tail, 14, 0, 0)
          i = next_i
          text_start = i
          span_esc = false
          continue
        }
        None => ()
      }
      if !ctx.html_fail_init {
        ctx.html_fail[0] = -1
        ctx.html_fail[1] = -1
        ctx.html_fail[2] = -1
        ctx.html_fail[3] = -1
        ctx.html_fail_init = true
      }
      let html_end = scan_inline_html_cached(s, i, seg_end, ctx.html_fail)
      if html_end > 0 {
        if text_start < i {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
          if head < 0 { head = tail }
        }
        tail = il_push_fast(nodes, prevs, tail, 4, i, html_end)
        if head < 0 { head = tail }
        i = html_end
        text_start = i
        span_esc = false
        continue
      }
      span_esc = true
      i = i + 1
      continue
    }

    // 6. Emphasis / Strong / Strikethrough delimiters: `*`, `_`, `~`
    if b == 42 || b == 95 || (b == 126 && opts.strikethrough) {
      let run_start = i
      while i < seg_end && s.code_unit_at(i) == b {
        i = i + 1
      }
      let run_len = i - run_start
      let fmask = compute_flanking_mask(ascii_cls, s, seg_start, seg_end, run_start, i, b, opts)
      if fmask != 0 {
        if text_start < run_start {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, run_start)
          if head < 0 { head = tail }
        }
        let nidx = il_push_fast(nodes, prevs, tail, 17, b, run_len)
        tail = nidx
        if head < 0 { head = tail }
        let didx = delims.length()
        delims.push(DelimEntry::{
          node_idx: nidx,
          meta: b | (run_len << 8),
          len: run_len,
          flags: fmask | 4,
        })
        delim_prev.push(delim_tail)
        delim_next.push(-1)
        if delim_tail >= 0 {
          delim_next[delim_tail] = didx
        }
        delim_tail = didx
        text_start = i
        span_esc = false
      }
      continue
    }

    // 7. Smart punctuation: `"`, `'`, `--`, `---`, `...`
    if opts.smart_punctuation {
      if b == 34 || b == 39 {
        let fmask = compute_flanking_mask(ascii_cls, s, seg_start, seg_end, i, i + 1, b, opts)
        if text_start < i {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
          if head < 0 { head = tail }
        }
        tail = il_push_fast(nodes, prevs, tail, 22, b, fmask)
        if head < 0 { head = tail }
        ctx.has_quotes = true
        i = i + 1
        text_start = i
        span_esc = false
        continue
      }
      if b == 45 && i + 1 < seg_end && s.code_unit_at(i + 1) == 45 {
        let run_start = i
        while i < seg_end && s.code_unit_at(i) == 45 {
          i = i + 1
        }
        if text_start < run_start {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, run_start)
          if head < 0 { head = tail }
        }
        tail = il_push_fast(nodes, prevs, tail, 1, il_push_str(ctx, smart_dashes(i - run_start)), 0)
        if head < 0 { head = tail }
        text_start = i
        span_esc = false
        continue
      }
      if b == 46 && i + 2 < seg_end && s.code_unit_at(i + 1) == 46 && s.code_unit_at(i + 2) == 46 {
        if text_start < i {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
          if head < 0 { head = tail }
        }
        tail = il_push_fast(nodes, prevs, tail, 1, il_push_str(ctx, "…"), 0)
        if head < 0 { head = tail }
        i = i + 3
        text_start = i
        span_esc = false
        continue
      }
    }

    // 8. Link / Image openers: `[` and `![`
    if b == 91 || (b == 33 && i + 1 < seg_end && s.code_unit_at(i + 1) == 91) {
      let is_img = b == 33
      if text_start < i {
        tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
        if head < 0 { head = tail }
      }
      let nidx = il_push_fast(nodes, prevs, tail, 18, if is_img { 1 } else { 0 }, 0)
      tail = nidx
      if head < 0 { head = tail }
      let after = if is_img { i + 2 } else { i + 1 }
      brackets.push(BracketEntry::{
        node_idx: nidx,
        delim_idx: delims.length(),
        text_start: after,
        flags: (if is_img { 1 } else { 0 }) | 2,
      })
      i = after
      text_start = i
      span_esc = false
      continue
    }

    // 9. Link / Image closer: `]`
    if b == 93 && brackets.length() > 0 {
      let br = brackets[brackets.length() - 1]
      let _ = brackets.pop()
      if (br.flags & 2) == 0 {
        i = i + 1
        continue
      }

      let mut matched = false
      let mut dest = ""
      let mut title = ""
      let mut ref_id = ""
      let mut dest_s = -1
      let mut dest_e = 0
      let mut title_s = -1
      let mut title_e = 0
      let mut link_type = LinkType::Inline
      let mut after_close = i + 1

      // Case A: Inline link `(...)` (zero-slice fast path when dest/title have no decodable escapes!)
      if i + 1 < seg_end && s.code_unit_at(i + 1) == 40 {
        let mut p = i + 2
        while p < seg_end && is_ascii_ws(s.code_unit_at(p)) {
          p = p + 1
        }
        if p < seg_end && s.code_unit_at(p) == 41 {
          matched = true
          after_close = p + 1
        } else if scan_link_dest_span(s, p, seg_end, sc) {
          let after_d = sc.a
          let ds = sc.b
          let de = sc.c
          let d_unesc = sc.flag
          let mut q = after_d
          while q < seg_end && is_ascii_ws(s.code_unit_at(q)) {
            q = q + 1
          }
          if q < seg_end && s.code_unit_at(q) == 41 {
            matched = true
            if d_unesc && span_needs_unescape(s, ds, de) {
              dest = unescape_span(s, ds, de)
            } else {
              dest_s = ds
              dest_e = de
            }
            after_close = q + 1
          } else if q > after_d && scan_link_title_span(s, q, seg_end, sc) {
            let after_t = sc.a
            let ts = sc.b
            let te = sc.c
            let t_unesc = sc.flag
            let mut r = after_t
            while r < seg_end && is_ascii_ws(s.code_unit_at(r)) {
              r = r + 1
            }
            if r < seg_end && s.code_unit_at(r) == 41 {
              matched = true
              if d_unesc && span_needs_unescape(s, ds, de) {
                dest = unescape_span(s, ds, de)
              } else {
                dest_s = ds
                dest_e = de
              }
              if t_unesc && span_needs_unescape(s, ts, te) {
                title = unescape_span(s, ts, te)
              } else {
                title_s = ts
                title_e = te
              }
              after_close = r + 1
            }
          }
        }
      }

      // Case B & C: Reference links (skip entirely if ref_defs is empty!)
      if !matched && has_ref_defs {
        // Case B: Full reference `[label]` or Collapsed reference `[]`
        if i + 1 < seg_end && s.code_unit_at(i + 1) == 91 {
          if i + 2 < seg_end && s.code_unit_at(i + 2) == 93 {
            let raw_lbl = s.slice(br.text_start, i)
            let norm = normalize_link_label(raw_lbl)
            match ref_defs.get(norm) {
              Some(def) => {
                matched = true
                dest = def.dest
                title = def.title
                ref_id = raw_lbl
                link_type = LinkType::Collapsed
                after_close = i + 3
              }
              None => ()
            }
          } else if scan_link_label_into(s, i + 1, seg_end, sc) {
            let raw_lbl = s.slice(sc.a, sc.b)
            let after_lbl = sc.c
            let norm = normalize_link_label(raw_lbl)
            match ref_defs.get(norm) {
              Some(def) => {
                matched = true
                dest = def.dest
                title = def.title
                ref_id = raw_lbl
                link_type = LinkType::Reference
                after_close = after_lbl
              }
              None => ()
            }
          }
        }

        // Case C: Shortcut reference (not followed by `[`)
        if !matched {
          let has_next_label = if i + 1 < seg_end && s.code_unit_at(i + 1) == 91 {
            if scan_link_label_into(s, i + 1, seg_end, sc) {
              true
            } else {
              i + 2 < seg_end && s.code_unit_at(i + 2) == 93
            }
          } else {
            false
          }
          if !has_next_label {
            let lbl_len = i - br.text_start
            let mut valid_shortcut = lbl_len <= 999
            let mut k = br.text_start
            while valid_shortcut && k < i {
              let c = s.code_unit_at(k)
              if c == 92 && k + 1 < i {
                k = k + 2
              } else if c == 91 || c == 93 {
                valid_shortcut = false
              } else {
                k = k + 1
              }
            }
            if valid_shortcut {
              let raw_lbl = s.slice(br.text_start, i)
              let norm = normalize_link_label(raw_lbl)
              match ref_defs.get(norm) {
                Some(def) => {
                  matched = true
                  dest = def.dest
                  title = def.title
                  ref_id = raw_lbl
                  link_type = LinkType::Shortcut
                  after_close = i + 1
                }
                None => ()
              }
            }
          }
        }
      }

      if matched {
        if text_start < i {
          tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, i)
          if head < 0 { head = tail }
        }
        if delims.length() > br.delim_idx {
          ctx.head = head
          ctx.tail = tail
          ctx.delim_tail = delim_tail
          process_emphasis(ctx, br.delim_idx)
          head = ctx.head
          tail = ctx.tail
          delim_tail = ctx.delim_tail
        }
        if ctx.has_quotes {
          resolve_smart_quotes(ctx, nodes[br.node_idx].next)
        }
        let lidx = ctx.link_pool.length()
        ctx.link_pool.push(LinkInfo::{
          link_type,
          dest,
          title,
          ref_id,
          dest_start: dest_s,
          dest_end: dest_e,
          title_start: title_s,
          title_end: title_e,
        })
        let bn = nodes[br.node_idx]
        if (br.flags & 1) != 0 {
          nodes[br.node_idx] = InlineNode::{ tag: 15, a: lidx, b: 0, next: bn.next }
          tail = il_push_fast(nodes, prevs, tail, 16, 0, 0)
        } else {
          nodes[br.node_idx] = InlineNode::{ tag: 13, a: lidx, b: 0, next: bn.next }
          tail = il_push_fast(nodes, prevs, tail, 14, 0, 0)
          let mut bi = 0
          let blen = brackets.length()
          while bi < blen {
            let b_ent = brackets[bi]
            if (b_ent.flags & 1) == 0 {
              brackets[bi] = BracketEntry::{
                node_idx: b_ent.node_idx,
                delim_idx: b_ent.delim_idx,
                text_start: b_ent.text_start,
                flags: b_ent.flags & 1,
              }
            }
            bi = bi + 1
          }
        }
        i = after_close
        text_start = i
        span_esc = false
        continue
      }

      i = i + 1
      continue
    }

    i = i + 1
  }

  if text_start < seg_end {
    tail = il_push_fast(nodes, prevs, tail, if span_esc { 20 } else { 0 }, text_start, seg_end)
    if head < 0 { head = tail }
  }
  ctx.head = head
  ctx.tail = tail
  ctx.delim_tail = delim_tail
  if delims.length() > 0 {
    process_emphasis(ctx, 0)
  }
  if ctx.has_quotes {
    resolve_smart_quotes(ctx, ctx.head)
  }
}

///| Trim trailing punctuation, unmatched `)`, and trailing HTML entity references (`&...;`)
///| from a GFM extended URL autolink candidate `s[i..uend]`.
fn trim_autolink_url_end(s : String, i : Int, uend : Int) -> Int {
  let mut trim_end = uend
  let mut changed = true
  while changed && trim_end > i {
    changed = false
    let last = s.code_unit_at(trim_end - 1)
    if last == 63 || last == 33 || last == 46 || last == 44 || last == 58 || last == 42 || last == 95 || last == 126 {
      trim_end = trim_end - 1
      changed = true
    } else if last == 41 {
      let mut opens = 0
      let mut closes = 0
      let mut k = i
      while k < trim_end {
        let ch = s.code_unit_at(k)
        if ch == 40 { opens = opens + 1 }
        if ch == 41 { closes = closes + 1 }
        k = k + 1
      }
      if closes > opens {
        trim_end = trim_end - 1
        changed = true
      }
    } else if last == 59 {
      // GFM spec: if an autolink ends in a semicolon, check for trailing entity reference `&[A-Za-z0-9]+;`
      let mut k = trim_end - 2
      while k >= i && is_ascii_alnum(s.code_unit_at(k)) {
        k = k - 1
      }
      if k >= i && k < trim_end - 2 && s.code_unit_at(k) == 38 {
        trim_end = k
        changed = true
      }
    }
  }
  trim_end
}

///| Scan GFM extended `mailto:` or `xmpp:` protocol autolink starting at `i` (after protocol prefix `pstart`).
///| Returns end offset of matched link, or -1 if invalid.
fn scan_gfm_proto_email(s : String, pstart : Int, end : Int, is_xmpp : Bool) -> Int {
  let mut k = pstart
  let mut at_pos = -1
  while k < end {
    let c = s.code_unit_at(k)
    if c == 64 {
      at_pos = k
      break
    }
    if is_ascii_alnum(c) || c == 46 || c == 95 || c == 43 || c == 45 {
      k = k + 1
    } else {
      return -1
    }
  }
  if at_pos <= pstart {
    return -1
  }
  let mut dend = at_pos + 1
  let mut dots = 0
  while dend < end {
    let c = s.code_unit_at(dend)
    if is_ascii_alnum(c) || c == 45 || c == 95 {
      dend = dend + 1
    } else if c == 46 {
      dots = dots + 1
      dend = dend + 1
    } else {
      break
    }
  }
  while dend > at_pos + 1 && s.code_unit_at(dend - 1) == 46 {
    dend = dend - 1
    dots = dots - 1
  }
  if dend <= at_pos + 1 || dots < 1 {
    return -1
  }
  let last_c = s.code_unit_at(dend - 1)
  if last_c == 45 || last_c == 95 {
    return -1
  }
  if is_xmpp && dend < end && s.code_unit_at(dend) == 47 {
    let mut r = dend + 1
    while r < end {
      let c = s.code_unit_at(r)
      if is_ascii_alnum(c) || c == 64 || c == 46 {
        r = r + 1
      } else {
        break
      }
    }
    while r > dend + 1 && s.code_unit_at(r - 1) == 46 {
      r = r - 1
    }
    if r > dend + 1 {
      return r
    }
  }
  dend
}

///| Write text span `s[start..end]` to HTML `sb` with optional GFM autolink literal detection.
fn write_text_html_span(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  opts : Options,
  in_link : Int,
  esc_tbl : Array[Byte],
  href_tbl : Array[Byte],
) -> Bool {
  if start >= end {
    return false
  }
  if !opts.autolinks || in_link > 0 || end - start < 5 {
    write_html_escaped_span_lut(sb, s, start, end, esc_tbl)
    return s.code_unit_at(end - 1) == 10
  }
  let mut mark = start
  let mut i = start
  let mut end_nl = false
  while i < end {
    let b = s.code_unit_at(i)
    let boundary_ok = i == start || {
      let pb = s.code_unit_at(i - 1)
      is_ascii_ws(pb) || pb == 40 || pb == 42 || pb == 95 || pb == 126 || pb == 91
    }

    if boundary_ok && (b == 119 || b == 104 || b == 102) {
      let is_www = starts_with_lit(s, i, end, "www.")
      let is_http = !is_www && (starts_with_lit(s, i, end, "http://") || starts_with_lit(s, i, end, "https://"))
      let is_ftp = !is_www && !is_http && starts_with_lit(s, i, end, "ftp://")
      if is_www || is_http || is_ftp {
        let mut uend = i
        while uend < end {
          let c = s.code_unit_at(uend)
          if c <= 32 || c == 60 {
            break
          }
          uend = uend + 1
        }
        let trim_end = trim_autolink_url_end(s, i, uend)
        let prefix_len = if is_www {
          4
        } else if is_ftp {
          6
        } else if starts_with_lit(s, i, end, "https://") {
          8
        } else {
          7
        }
        if trim_end > i + prefix_len {
          let mut has_dot = false
          let mut k = i + prefix_len
          while k < trim_end && s.code_unit_at(k) != 47 {
            if s.code_unit_at(k) == 46 {
              has_dot = true
            }
            k = k + 1
          }
          if has_dot {
            if mark < i {
              write_html_escaped_span_lut(sb, s, mark, i, esc_tbl)
            }
            sb.write_string("<a href=\"")
            if is_www {
              sb.write_string("http://")
            }
            escape_href_span_lut(sb, s, i, trim_end, href_tbl)
            sb.write_string("\">")
            write_html_escaped_span_lut(sb, s, i, trim_end, esc_tbl)
            sb.write_string("</a>")
            end_nl = false
            i = trim_end
            mark = trim_end
            continue
          }
        }
      }
    }

    if boundary_ok && (b == 109 || b == 120) {
      let is_mailto = b == 109 && starts_with_lit(s, i, end, "mailto:")
      let is_xmpp = b == 120 && starts_with_lit(s, i, end, "xmpp:")
      if is_mailto || is_xmpp {
        let plen = if is_mailto { 7 } else { 5 }
        let mend = scan_gfm_proto_email(s, i + plen, end, is_xmpp)
        if mend > i + plen {
          if mark < i {
            write_html_escaped_span_lut(sb, s, mark, i, esc_tbl)
          }
          sb.write_string("<a href=\"")
          escape_href_span_lut(sb, s, i, mend, href_tbl)
          sb.write_string("\">")
          write_html_escaped_span_lut(sb, s, i, mend, esc_tbl)
          sb.write_string("</a>")
          end_nl = false
          i = mend
          mark = mend
          continue
        }
      }
    }

    if b == 64 && i > mark {
      let mut lstart = i
      while lstart > mark {
        let c = s.code_unit_at(lstart - 1)
        if is_ascii_alnum(c) || c == 46 || c == 95 || c == 43 || c == 45 {
          lstart = lstart - 1
        } else {
          break
        }
      }
      let mut dend = i + 1
      let mut dots = 0
      let mut valid_domain = true
      while dend < end {
        let c = s.code_unit_at(dend)
        if is_ascii_alnum(c) || c == 45 || c == 95 {
          dend = dend + 1
        } else if c == 46 {
          dots = dots + 1
          dend = dend + 1
        } else {
          break
        }
      }
      while dend > i + 1 && s.code_unit_at(dend - 1) == 46 {
        dend = dend - 1
        dots = dots - 1
      }
      if dend <= i + 1 || dots < 1 {
        valid_domain = false
      } else {
        let last_c = s.code_unit_at(dend - 1)
        if last_c == 45 || last_c == 95 {
          valid_domain = false
        }
        if dend < end && s.code_unit_at(dend) == 43 {
          valid_domain = false
        }
      }
      if lstart < i && valid_domain {
        if mark < lstart {
          write_html_escaped_span_lut(sb, s, mark, lstart, esc_tbl)
        }
        sb.write_string("<a href=\"mailto:")
        escape_href_span_lut(sb, s, lstart, dend, href_tbl)
        sb.write_string("\">")
        write_html_escaped_span_lut(sb, s, lstart, dend, esc_tbl)
        sb.write_string("</a>")
        end_nl = false
        i = dend
        mark = dend
        continue
      }
    }

    i = i + 1
  }
  if mark < end {
    write_html_escaped_span_lut(sb, s, mark, end, esc_tbl)
    end_nl = s.code_unit_at(end - 1) == 10
  }
  end_nl
}

///| Direct-to-HTML inline parser & renderer for `s[seg_start..seg_end]`.
///| Returns updated `end_nl`.
fn render_inlines_html(
  ctx : InlineCtx,
  s : String,
  seg_start : Int,
  seg_end : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
  sb : StringBuilder,
  pulldown_compat : Bool,
  init_end_nl : Bool,
) -> Bool {
  if seg_start >= seg_end {
    return init_end_nl
  }
  let first_sp = find_first_inline_special(ctx.table, s, seg_start, seg_end, ctx.sc)
  if first_sp < 0 {
    if first_sp == -1 && !opts.autolinks {
      sb.write_substring(s, seg_start, seg_end)
      return false
    }
    return write_text_html_span(sb, s, seg_start, seg_end, opts, 0, ctx.esc_tbl, ctx.href_tbl)
  }
  // Fast path: single-backtick code span covering up to seg_end (e.g. table cells like `arm64_apple`, `wasm32`)
  if !opts.autolinks && first_sp + 2 < seg_end && s.code_unit_at(first_sp) == 96 &&
  s.code_unit_at(first_sp + 1) != 96 && s.code_unit_at(seg_end - 1) == 96 &&
  s.code_unit_at(seg_end - 2) != 96 {
    let mut k = first_sp + 1
    let mut ok = true
    let mut all_sp = true
    let mut code_esc = false
    let cend = seg_end - 1
    while k < cend {
      let cb = s.code_unit_at(k)
      if cb == 96 || cb == 10 {
        ok = false
        break
      }
      if cb <= 62 {
        if cb == 38 || cb == 60 || cb == 62 || cb == 34 {
          code_esc = true
        }
        if cb != 32 {
          all_sp = false
        }
      } else {
        all_sp = false
      }
      k = k + 1
    }
    if ok {
      if seg_start < first_sp {
        if ctx.sc.flag {
          write_html_escaped_span_lut(sb, s, seg_start, first_sp, ctx.esc_tbl)
        } else {
          sb.write_substring(s, seg_start, first_sp)
        }
      }
      sb.write_string("<code>")
      let mut cs = first_sp + 1
      let mut ce = cend
      if ce - cs >= 2 && !all_sp && s.code_unit_at(cs) == 32 && s.code_unit_at(ce - 1) == 32 {
        cs = cs + 1
        ce = ce - 1
      }
      if cs < ce {
        if code_esc {
          write_html_escaped_span_lut(sb, s, cs, ce, ctx.esc_tbl)
        } else {
          sb.write_substring(s, cs, ce)
        }
      }
      sb.write_string("</code>")
      return false
    }
  }
  // Fast path: simple symmetric `*em*`, `**strong**`, or `~~del~~` starting at seg_start with plain inner & tail
  // (e.g. `**Pass**`, `~~Beta~~ Stable` in GFM tables, simple emphasis headings/cells)
  if !opts.autolinks && !opts.cjk_friendly && first_sp == seg_start {
    let db = s.code_unit_at(seg_start)
    if db == 42 || (db == 126 && opts.strikethrough) {
      let mut rlen = 1
      if seg_start + 1 < seg_end && s.code_unit_at(seg_start + 1) == db {
        rlen = 2
      }
      let valid_delim = (db == 42) || (rlen == 2)
      let inner_s = seg_start + rlen
      if valid_delim && inner_s + rlen < seg_end {
        let first_in = s.code_unit_at(inner_s)
        let zero = (0).to_byte()
        if first_in != db && first_in < 128 && ctx.ascii_cls[first_in] == zero {
          let k = skip_plain_inline(ctx.table, s, inner_s, seg_end)
          if k > inner_s && k + rlen <= seg_end && s.code_unit_at(k) == db &&
          (rlen == 1 || s.code_unit_at(k + 1) == db) &&
          (k + rlen == seg_end || s.code_unit_at(k + rlen) != db) {
            let last_in = s.code_unit_at(k - 1)
            if last_in < 128 && ctx.ascii_cls[last_in] == zero {
              let tail_s = k + rlen
              if tail_s == seg_end || skip_plain_inline(ctx.table, s, tail_s, seg_end) == seg_end {
                if db == 126 {
                  sb.write_string("<del>")
                  sb.write_substring(s, inner_s, k)
                  sb.write_string("</del>")
                } else if rlen == 2 {
                  sb.write_string("<strong>")
                  sb.write_substring(s, inner_s, k)
                  sb.write_string("</strong>")
                } else {
                  sb.write_string("<em>")
                  sb.write_substring(s, inner_s, k)
                  sb.write_string("</em>")
                }
                if tail_s < seg_end {
                  sb.write_substring(s, tail_s, seg_end)
                }
                return false
              }
            }
          }
        }
      }
    }
  }
  scan_inlines_to_ctx(ctx, s, seg_start, seg_end, first_sp, ctx.sc.flag, ref_defs, opts)

  let esc_q = !pulldown_compat
  let no_auto = !opts.autolinks
  let nodes = ctx.nodes
  let esc_tbl = ctx.esc_tbl
  let esc_attr_tbl = ctx.esc_attr_tbl
  let href_tbl = ctx.href_tbl
  let mut cur = ctx.head
  let mut in_link = 0
  let mut end_nl = init_end_nl

  while cur >= 0 {
    let node = nodes[cur]
    let tag = node.tag
    // When GFM autolinks are enabled outside links, coalesce adjacent text/unmatched-delim nodes
    // so e.g. `a.b-c_d@a.b_` is seen intact rather than split at `_`.
    if !no_auto && in_link == 0 && (tag == 0 || tag == 20 || tag == 1 || tag == 17) {
      let nxt = node.next
      let next_is_text = nxt >= 0 && {
        let nt = nodes[nxt].tag
        nt == 0 || nt == 20 || nt == 1 || nt == 17
      }
      if next_is_text {
        ctx.code_sb.reset()
        let mut p = cur
        while p >= 0 {
          let pn = nodes[p]
          let pt = pn.tag
          if pt == 0 || pt == 20 {
            if pn.a < pn.b {
              ctx.code_sb.write_substring(s, pn.a, pn.b)
            }
          } else if pt == 1 {
            ctx.code_sb.write_string(ctx.str_pool[pn.a])
          } else if pt == 17 {
            let mut k = 0
            while k < pn.b {
              ctx.code_sb.write_byte(pn.a.to_byte())
              k = k + 1
            }
          } else {
            break
          }
          p = pn.next
        }
        let merged = ctx.code_sb.to_string()
        if merged.length() > 0 {
          end_nl = write_text_html_span(sb, merged, 0, merged.length(), opts, in_link, esc_tbl, href_tbl)
        }
        cur = p
        continue
      }
    }
    if tag == 0 {
      if node.a < node.b {
        if no_auto || in_link > 0 {
          sb.write_substring(s, node.a, node.b)
          end_nl = false
        } else {
          end_nl = write_text_html_span(sb, s, node.a, node.b, opts, in_link, esc_tbl, href_tbl)
        }
      }
    } else if tag == 20 {
      if node.a < node.b {
        end_nl = write_text_html_span(sb, s, node.a, node.b, opts, in_link, esc_tbl, href_tbl)
      }
    } else if tag == 1 {
      let t = ctx.str_pool[node.a]
      if t.length() > 0 {
        end_nl = write_text_html_span(sb, t, 0, t.length(), opts, in_link, esc_tbl, href_tbl)
      }
    } else if tag == 2 {
      sb.write_string("<code>")
      if node.a < node.b {
        sb.write_substring(s, node.a, node.b)
      }
      sb.write_string("</code>")
      end_nl = false
    } else if tag == 21 {
      sb.write_string("<code>")
      write_html_escaped_span_lut(sb, s, node.a, node.b, esc_tbl)
      sb.write_string("</code>")
      end_nl = false
    } else if tag == 3 {
      let c = ctx.str_pool[node.a]
      sb.write_string("<code>")
      write_html_escaped_span_lut(sb, c, 0, c.length(), esc_tbl)
      sb.write_string("</code>")
      end_nl = false
    } else if tag == 4 {
      if node.a < node.b {
        sb.write_substring(s, node.a, node.b)
        end_nl = s.code_unit_at(node.b - 1) == 10
      }
    } else if tag == 5 {
      sb.write_byte((10).to_byte())
      end_nl = true
    } else if tag == 6 {
      sb.write_string("<br />\n")
      end_nl = true
    } else if tag == 7 {
      sb.write_string("<em>")
      end_nl = false
    } else if tag == 8 {
      sb.write_string("</em>")
      end_nl = false
    } else if tag == 9 {
      sb.write_string("<strong>")
      end_nl = false
    } else if tag == 10 {
      sb.write_string("</strong>")
      end_nl = false
    } else if tag == 11 {
      sb.write_string("<del>")
      end_nl = false
    } else if tag == 12 {
      sb.write_string("</del>")
      end_nl = false
    } else if tag == 13 {
      in_link = in_link + 1
      let info = ctx.link_pool[node.a]
      match info.link_type {
        LinkType::Email => {
          sb.write_string("<a href=\"mailto:")
          if info.dest_start >= 0 {
            escape_href_span_lut(sb, s, info.dest_start, info.dest_end, href_tbl)
          } else {
            escape_href_span_lut(sb, info.dest, 0, info.dest.length(), href_tbl)
          }
        }
        _ => {
          sb.write_string("<a href=\"")
          if info.dest_start >= 0 {
            escape_href_span_lut(sb, s, info.dest_start, info.dest_end, href_tbl)
          } else {
            escape_href_span_lut(sb, info.dest, 0, info.dest.length(), href_tbl)
          }
        }
      }
      if info.title_start >= 0 {
        if info.title_start < info.title_end {
          sb.write_string("\" title=\"")
          write_html_escaped_span_lut(sb, s, info.title_start, info.title_end, esc_attr_tbl)
        }
      } else if info.title.length() > 0 {
        sb.write_string("\" title=\"")
        write_html_escaped_span_lut(sb, info.title, 0, info.title.length(), esc_attr_tbl)
      }
      sb.write_string("\">")
      end_nl = false
    } else if tag == 14 {
      if in_link > 0 {
        in_link = in_link - 1
      }
      sb.write_string("</a>")
      end_nl = false
    } else if tag == 15 {
      let info = ctx.link_pool[node.a]
      sb.write_string("<img src=\"")
      if info.dest_start >= 0 {
        escape_href_span_lut(sb, s, info.dest_start, info.dest_end, href_tbl)
      } else {
        escape_href_span_lut(sb, info.dest, 0, info.dest.length(), href_tbl)
      }
      sb.write_string("\" alt=\"")
      // Walk until matching EndImage (tag == 16), writing alt text escaped (with quote escaping)
      let mut nest = 0
      cur = node.next
      while cur >= 0 {
        let an = nodes[cur]
        let at = an.tag
        if at == 15 || at == 13 || at == 7 || at == 9 || at == 11 {
          nest = nest + 1
        } else if at == 16 || at == 14 || at == 8 || at == 10 || at == 12 {
          if nest == 0 {
            break
          }
          nest = nest - 1
        } else if at == 0 || at == 20 || at == 2 || at == 21 || at == 4 {
          write_html_escaped_span_lut(sb, s, an.a, an.b, esc_attr_tbl)
        } else if at == 1 || at == 3 {
          let ts = ctx.str_pool[an.a]
          write_html_escaped_span_lut(sb, ts, 0, ts.length(), esc_attr_tbl)
        } else if at == 5 || at == 6 {
          sb.write_byte((10).to_byte())
        } else if at == 17 {
          let ch = an.a
          let cnt = an.b
          if ch == 34 {
            let mut k = 0
            while k < cnt {
              sb.write_string("&quot;")
              k = k + 1
            }
          } else {
            let mut k = 0
            while k < cnt {
              sb.write_byte(ch.to_byte())
              k = k + 1
            }
          }
        } else if at == 18 {
          if an.a != 0 {
            sb.write_string("![")
          } else {
            sb.write_byte((91).to_byte())
          }
        }
        cur = an.next
      }
      if info.title_start >= 0 {
        if info.title_start < info.title_end {
          sb.write_string("\" title=\"")
          write_html_escaped_span_lut(sb, s, info.title_start, info.title_end, esc_attr_tbl)
        }
      } else if info.title.length() > 0 {
        sb.write_string("\" title=\"")
        write_html_escaped_span_lut(sb, info.title, 0, info.title.length(), esc_attr_tbl)
      }
      sb.write_string("\" />")
      end_nl = false
      if cur < 0 {
        break
      }
      cur = ctx.nodes[cur].next
      continue
    } else if tag == 17 {
      let ch = node.a
      let cnt = node.b
      if cnt > 0 {
        if ch == 34 && esc_q {
          let mut k = 0
          while k < cnt {
            sb.write_string("&quot;")
            k = k + 1
          }
        } else {
          let mut k = 0
          while k < cnt {
            sb.write_byte(ch.to_byte())
            k = k + 1
          }
        }
        end_nl = false
      }
    } else if tag == 18 {
      if node.a != 0 {
        sb.write_string("![")
      } else {
        sb.write_byte((91).to_byte())
      }
      end_nl = false
    }
    cur = node.next
  }
  end_nl
}

///| Render paragraph/heading lines of `m` directly into `sb` without intermediate String when 1 line.
fn render_para_lines_html(
  doc : BlockDoc,
  m : BlockMeta,
  ctx : InlineCtx,
  opts : Options,
  sb : StringBuilder,
  pulldown_compat : Bool,
  init_end_nl : Bool,
) -> Bool {
  let n = m.line_len
  if n == 0 {
    return init_end_nl
  }
  if n == 1 {
    let sp = doc.all_lines[m.line_start]
    if sp.pad == 0 {
      let mut e = sp.end
      while e > sp.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      return render_inlines_html(ctx, doc.src, sp.start, e, doc.ref_defs, opts, sb, pulldown_compat, init_end_nl)
    } else if sp.pad < 0 {
      let ls = doc.extra_strs[sp.start]
      let mut e = ls.length()
      while e > 0 && (ls.code_unit_at(e - 1) == 32 || ls.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      return render_inlines_html(ctx, ls, 0, e, doc.ref_defs, opts, sb, pulldown_compat, init_end_nl)
    }
  }
  // Contiguous multi-line paragraph zero-copy fast path!
  let sp0 = doc.all_lines[m.line_start]
  if sp0.pad == 0 {
    let mut contig = true
    let mut prev_end = sp0.end
    let mut ci = 1
    while ci < n {
      let spc = doc.all_lines[m.line_start + ci]
      if spc.pad != 0 || spc.start != prev_end + 1 {
        contig = false
        break
      }
      prev_end = spc.end
      ci = ci + 1
    }
    if contig {
      let mut e = prev_end
      while e > sp0.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      return render_inlines_html(ctx, doc.src, sp0.start, e, doc.ref_defs, opts, sb, pulldown_compat, init_end_nl)
    }
  }
  // Multi-line paragraph: reuse ctx.para_sb
  ctx.para_sb.reset()
  let mut i = 0
  while i < n {
    let sp = doc.all_lines[m.line_start + i]
    if i > 0 {
      ctx.para_sb.write_byte((10).to_byte())
    }
    let is_last = i + 1 == n
    if sp.pad < 0 {
      let ls = doc.extra_strs[sp.start]
      if is_last {
        let mut e = ls.length()
        while e > 0 && (ls.code_unit_at(e - 1) == 32 || ls.code_unit_at(e - 1) == 9) {
          e = e - 1
        }
        write_raw_span(ctx.para_sb, ls, 0, e)
      } else {
        ctx.para_sb.write_string(ls)
      }
    } else {
      let mut k = 0
      while k < sp.pad {
        ctx.para_sb.write_byte((32).to_byte())
        k = k + 1
      }
      let mut e = sp.end
      if is_last {
        while e > sp.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
          e = e - 1
        }
      }
      write_raw_span(ctx.para_sb, doc.src, sp.start, e)
    }
    i = i + 1
  }
  let pstr = ctx.para_sb.to_string()
  render_inlines_html(ctx, pstr, 0, pstr.length(), doc.ref_defs, opts, sb, pulldown_compat, init_end_nl)
}

///| Write a code block's lines directly to `sb` (HTML-escaped) with contiguous bulk fast path.
fn write_code_block_lines_html(
  doc : BlockDoc,
  m : BlockMeta,
  sb : StringBuilder,
  esc_tbl : Array[Byte],
) -> Unit {
  let n = m.line_len
  if n == 0 {
    return ()
  }
  // Contiguous multi-line code block fast path!
  let sp0 = doc.all_lines[m.line_start]
  if sp0.pad == 0 {
    let mut contig = true
    let mut prev_end = sp0.end
    let mut ci = 1
    while ci < n {
      let spc = doc.all_lines[m.line_start + ci]
      if spc.pad != 0 || spc.start != prev_end + 1 {
        contig = false
        break
      }
      prev_end = spc.end
      ci = ci + 1
    }
    if contig {
      write_html_escaped_span_lut(sb, doc.src, sp0.start, prev_end, esc_tbl)
      sb.write_byte((10).to_byte())
      return ()
    }
  }
  let mut i = 0
  while i < n {
    let sp = doc.all_lines[m.line_start + i]
    if sp.pad < 0 {
      let ls = doc.extra_strs[sp.start]
      write_html_escaped_span_lut(sb, ls, 0, ls.length(), esc_tbl)
    } else {
      let mut k = 0
      while k < sp.pad {
        sb.write_byte((32).to_byte())
        k = k + 1
      }
      write_html_escaped_span_lut(sb, doc.src, sp.start, sp.end, esc_tbl)
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
}

///| Write an HTML block's lines directly to `sb` (raw) with contiguous bulk fast path.
fn write_html_block_lines_raw(doc : BlockDoc, m : BlockMeta, sb : StringBuilder) -> Unit {
  let n = m.line_len
  if n == 0 {
    return ()
  }
  let sp0 = doc.all_lines[m.line_start]
  if sp0.pad == 0 {
    let mut contig = true
    let mut prev_end = sp0.end
    let mut ci = 1
    while ci < n {
      let spc = doc.all_lines[m.line_start + ci]
      if spc.pad != 0 || spc.start != prev_end + 1 {
        contig = false
        break
      }
      prev_end = spc.end
      ci = ci + 1
    }
    if contig {
      write_raw_span(sb, doc.src, sp0.start, prev_end)
      sb.write_byte((10).to_byte())
      return ()
    }
  }
  let mut i = 0
  while i < n {
    let sp = doc.all_lines[m.line_start + i]
    if sp.pad < 0 {
      sb.write_string(doc.extra_strs[sp.start])
    } else {
      let mut k = 0
      while k < sp.pad {
        sb.write_byte((32).to_byte())
        k = k + 1
      }
      write_raw_span(sb, doc.src, sp.start, sp.end)
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
}

fn write_table_cell_open(sb : StringBuilder, in_head : Bool, aligns : Array[Alignment], col_idx : Int) -> Unit {
  if col_idx < aligns.length() {
    if in_head {
      match aligns[col_idx] {
        Alignment::Left => sb.write_string("<th style=\"text-align: left\">")
        Alignment::Center => sb.write_string("<th style=\"text-align: center\">")
        Alignment::Right => sb.write_string("<th style=\"text-align: right\">")
        Alignment::None => sb.write_string("<th>")
      }
    } else {
      match aligns[col_idx] {
        Alignment::Left => sb.write_string("<td style=\"text-align: left\">")
        Alignment::Center => sb.write_string("<td style=\"text-align: center\">")
        Alignment::Right => sb.write_string("<td style=\"text-align: right\">")
        Alignment::None => sb.write_string("<td>")
      }
    }
  } else if in_head {
    sb.write_string("<th>")
  } else {
    sb.write_string("<td>")
  }
}

fn render_table_cell_span(
  doc : BlockDoc,
  sp : LineSpan,
  ctx : InlineCtx,
  opts : Options,
  sb : StringBuilder,
  pulldown_compat : Bool,
) -> Unit {
  if sp.pad < 0 {
    let cs = doc.extra_strs[sp.start]
    let _ = render_inlines_html(ctx, cs, 0, cs.length(), doc.ref_defs, opts, sb, pulldown_compat, false)
  } else if sp.start < sp.end {
    let _ = render_inlines_html(ctx, doc.src, sp.start, sp.end, doc.ref_defs, opts, sb, pulldown_compat, false)
  }
}

///| Explicit stack frame for iterative block rendering (zero native stack recursion).
///| `flags`: bit 0 = in_tight_list, bit 1 = opened (container children traversal started).
val struct RenderFrame {
  idx : Int
  next_child : Int
  flags : Int
}

///| Iteratively render block tree rooted at `root_idx` directly into `sb` (zero recursion, zero Event allocation).
fn render_block_direct(
  doc : BlockDoc,
  root_idx : Int,
  ctx : InlineCtx,
  opts : Options,
  init_tight : Bool,
  sb : StringBuilder,
  pulldown_compat : Bool,
  init_end_nl : Bool,
) -> Bool {
  let stack : Array[RenderFrame] = Array::with_capacity(16)
  stack.push(RenderFrame::{ idx: root_idx, next_child: -1, flags: if init_tight { 1 } else { 0 } })
  let mut end_nl = init_end_nl

  while stack.length() > 0 {
    let sp_idx = stack.length() - 1
    let frame = stack[sp_idx]
    let idx = frame.idx
    let in_tight_list = (frame.flags & 1) != 0
    let opened = (frame.flags & 2) != 0
    let m = doc.meta[idx]
    let t = doc.tree[idx]
    let kind = m.kf & 15

    if opened {
      let c = frame.next_child
      if c >= 0 {
        let next_sib = doc.tree[c].next_sibling
        stack[sp_idx] = RenderFrame::{ idx, next_child: next_sib, flags: frame.flags }
        let child_tight = if kind == 2 {
          (m.kf & 32) != 0
        } else if kind == 3 {
          in_tight_list
        } else {
          false
        }
        // Fast path: render Paragraph leaf directly without RenderFrame push/pop!
        let cm = doc.meta[c]
        if (cm.kf & 15) == 4 {
          if child_tight {
            end_nl = render_para_lines_html(doc, cm, ctx, opts, sb, pulldown_compat, end_nl)
          } else {
            if !end_nl {
              sb.write_byte((10).to_byte())
            }
            sb.write_string("<p>")
            let _ = render_para_lines_html(doc, cm, ctx, opts, sb, pulldown_compat, false)
            sb.write_string("</p>\n")
            end_nl = true
          }
          continue
        }
        stack.push(RenderFrame::{ idx: c, next_child: -1, flags: if child_tight { 1 } else { 0 } })
        continue
      }
      // Close container
      let _ = stack.pop()
      if kind == 3 {
        sb.write_string("</li>\n")
        end_nl = true
      } else if kind == 2 {
        if (m.kf & 512) != 0 {
          sb.write_string("</ol>\n")
        } else {
          sb.write_string("</ul>\n")
        }
        end_nl = true
      } else if kind == 1 {
        sb.write_string("</blockquote>\n")
        end_nl = true
      }
      continue
    }

    if kind == 4 {
      // Paragraph (most frequent!)
      let _ = stack.pop()
      if in_tight_list {
        end_nl = render_para_lines_html(doc, m, ctx, opts, sb, pulldown_compat, end_nl)
      } else {
        if !end_nl {
          sb.write_byte((10).to_byte())
        }
        sb.write_string("<p>")
        let _ = render_para_lines_html(doc, m, ctx, opts, sb, pulldown_compat, false)
        sb.write_string("</p>\n")
        end_nl = true
      }
    } else if kind == 3 {
      // Item
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      sb.write_string("<li>")
      end_nl = false
      let mut start_child = t.first_child
      let task_state = (m.kf >> 7) & 3
      if task_state != 0 {
        let cb_html = if task_state == 2 {
          "<input disabled=\"\" type=\"checkbox\" checked=\"\"/>\n"
        } else {
          "<input disabled=\"\" type=\"checkbox\"/>\n"
        }
        if !in_tight_list && start_child >= 0 {
          let fm = doc.meta[start_child]
          if (fm.kf & 15) == 4 {
            if !end_nl {
              sb.write_byte((10).to_byte())
            }
            sb.write_string("<p>")
            sb.write_string(cb_html)
            let _ = render_para_lines_html(doc, fm, ctx, opts, sb, pulldown_compat, true)
            sb.write_string("</p>\n")
            end_nl = true
            start_child = doc.tree[start_child].next_sibling
          } else {
            sb.write_string(cb_html)
            end_nl = true
          }
        } else {
          sb.write_string(cb_html)
          end_nl = true
        }
      }
      // Fast path: single-child Paragraph inside Item (avoids 2 RenderFrame loop iterations!)
      if start_child >= 0 && doc.tree[start_child].next_sibling < 0 {
        let cm = doc.meta[start_child]
        if (cm.kf & 15) == 4 {
          let _ = stack.pop()
          if in_tight_list {
            let _ = render_para_lines_html(doc, cm, ctx, opts, sb, pulldown_compat, end_nl)
          } else {
            if !end_nl {
              sb.write_byte((10).to_byte())
            }
            sb.write_string("<p>")
            let _ = render_para_lines_html(doc, cm, ctx, opts, sb, pulldown_compat, false)
            sb.write_string("</p>\n")
          }
          sb.write_string("</li>\n")
          end_nl = true
          continue
        }
      } else if start_child < 0 {
        let _ = stack.pop()
        sb.write_string("</li>\n")
        end_nl = true
        continue
      }
      stack[sp_idx] = RenderFrame::{ idx, next_child: start_child, flags: frame.flags | 2 }
    } else if kind == 5 {
      // Heading
      let _ = stack.pop()
      let level = (m.kf >> 10) & 255
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      if level == 1 {
        sb.write_string("<h1>")
      } else if level == 2 {
        sb.write_string("<h2>")
      } else if level == 3 {
        sb.write_string("<h3>")
      } else if level == 4 {
        sb.write_string("<h4>")
      } else if level == 5 {
        sb.write_string("<h5>")
      } else {
        sb.write_string("<h6>")
      }
      let _ = render_para_lines_html(doc, m, ctx, opts, sb, pulldown_compat, false)
      if level == 1 {
        sb.write_string("</h1>\n")
      } else if level == 2 {
        sb.write_string("</h2>\n")
      } else if level == 3 {
        sb.write_string("</h3>\n")
      } else if level == 4 {
        sb.write_string("</h4>\n")
      } else if level == 5 {
        sb.write_string("</h5>\n")
      } else {
        sb.write_string("</h6>\n")
      }
      end_nl = true
    } else if kind == 2 {
      // List
      let ordered = (m.kf & 512) != 0
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      if !ordered {
        sb.write_string("<ul>\n")
      } else if m.extra == 1 {
        sb.write_string("<ol>\n")
      } else {
        sb.write_string("<ol start=\"")
        sb.write_string(m.extra.to_string())
        sb.write_string("\">\n")
      }
      end_nl = true
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 10 {
      // Table
      let _ = stack.pop()
      let aligns = doc.table_aligns[t.extra2]
      let cells_start = m.extra
      let ncols = m.line_start
      let num_rows = m.line_len
      if pulldown_compat {
        sb.write_string("<table><thead><tr>")
        let mut hi = 0
        while hi < ncols {
          write_table_cell_open(sb, true, aligns, hi)
          let hsp = doc.table_cells[cells_start + hi]
          if hsp.pad < 0 {
            let cs = doc.extra_strs[hsp.start]
            let _ = render_inlines_html(ctx, cs, 0, cs.length(), doc.ref_defs, opts, sb, true, false)
          } else if hsp.start < hsp.end {
            let _ = render_inlines_html(ctx, doc.src, hsp.start, hsp.end, doc.ref_defs, opts, sb, true, false)
          }
          sb.write_string("</th>")
          hi = hi + 1
        }
        sb.write_string("</tr></thead><tbody>\n")
        let mut ri = 0
        while ri < num_rows {
          sb.write_string("<tr>")
          let row_base = cells_start + (ri + 1) * ncols
          let mut ci = 0
          while ci < ncols {
            write_table_cell_open(sb, false, aligns, ci)
            let csp = doc.table_cells[row_base + ci]
            if csp.pad < 0 {
              let cs = doc.extra_strs[csp.start]
              let _ = render_inlines_html(ctx, cs, 0, cs.length(), doc.ref_defs, opts, sb, true, false)
            } else if csp.start < csp.end {
              let _ = render_inlines_html(ctx, doc.src, csp.start, csp.end, doc.ref_defs, opts, sb, true, false)
            }
            sb.write_string("</td>")
            ci = ci + 1
          }
          sb.write_string("</tr>\n")
          ri = ri + 1
        }
        sb.write_string("</tbody></table>\n")
      } else {
        if !end_nl {
          sb.write_byte((10).to_byte())
        }
        sb.write_string("<table>\n<thead>\n<tr>\n")
        let mut hi = 0
        while hi < ncols {
          write_table_cell_open(sb, true, aligns, hi)
          render_table_cell_span(doc, doc.table_cells[cells_start + hi], ctx, opts, sb, false)
          sb.write_string("</th>\n")
          hi = hi + 1
        }
        sb.write_string("</tr>\n</thead>\n")
        if num_rows > 0 {
          sb.write_string("<tbody>\n")
          let mut ri = 0
          while ri < num_rows {
            sb.write_string("<tr>\n")
            let row_base = cells_start + (ri + 1) * ncols
            let mut ci = 0
            while ci < ncols {
              write_table_cell_open(sb, false, aligns, ci)
              render_table_cell_span(doc, doc.table_cells[row_base + ci], ctx, opts, sb, false)
              sb.write_string("</td>\n")
              ci = ci + 1
            }
            sb.write_string("</tr>\n")
            ri = ri + 1
          }
          sb.write_string("</tbody>\n</table>\n")
        } else {
          sb.write_string("<tbody></tbody>\n</table>\n")
        }
      }
      end_nl = true
    } else if kind == 7 {
      // FencedCode
      let _ = stack.pop()
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      if m.extra < 0 {
        sb.write_string("<pre><code>")
      } else {
        sb.write_string("<pre><code class=\"language-")
        write_first_info_word_escaped(sb, doc.extra_strs[m.extra])
        sb.write_string("\">")
      }
      write_code_block_lines_html(doc, m, sb, ctx.esc_tbl)
      sb.write_string("</code></pre>\n")
      end_nl = true
    } else if kind == 1 {
      // BlockQuote
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      sb.write_string("<blockquote>\n")
      end_nl = true
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 6 {
      // IndentedCode
      let _ = stack.pop()
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      sb.write_string("<pre><code>")
      write_code_block_lines_html(doc, m, sb, ctx.esc_tbl)
      sb.write_string("</code></pre>\n")
      end_nl = true
    } else if kind == 8 {
      // HtmlBlock
      let _ = stack.pop()
      if !pulldown_compat && !end_nl {
        sb.write_byte((10).to_byte())
      }
      write_html_block_lines_raw(doc, m, sb)
      end_nl = true
    } else if kind == 9 {
      // ThematicBreak
      let _ = stack.pop()
      if !end_nl {
        sb.write_byte((10).to_byte())
      }
      sb.write_string("<hr />\n")
      end_nl = true
    } else if kind == 0 {
      // Document
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else {
      let _ = stack.pop()
    }
  }
  end_nl
}

///| Top-level direct streaming Markdown -> HTML renderer (zero Event array materialization).
pub fn render_markdown_direct(src : String, opts : Options, pulldown_compat : Bool) -> String {
  let doc = parse_blocks(src, opts)
  let cap = if opts.tables { src.length() * 2 + 64 } else { src.length() + src.length() / 2 + 64 }
  let sb = StringBuilder::with_capacity(cap)
  let ctx = new_inline_ctx(opts, !pulldown_compat)
  let _ = render_block_direct(doc, 0, ctx, opts, false, sb, pulldown_compat, true)
  sb.to_string()
}

// ============================================================================
// Public Event-Stream API (`parse` / `parse_inlines`) — full compatibility
// ============================================================================

///| Emit text with optional GFM autolink literal detection (only when `in_link == 0`).
fn emit_text_with_autolinks(
  events : Array[Event],
  s : String,
  opts : Options,
  in_link : Int,
) -> Unit {
  if !opts.autolinks || in_link > 0 || s.length() < 5 {
    events.push(Event::Text(s))
    return ()
  }
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let boundary_ok = i == 0 || {
      let pb = s.code_unit_at(i - 1)
      is_ascii_ws(pb) || pb == 40 || pb == 42 || pb == 95 || pb == 126 || pb == 91
    }

    if boundary_ok && (b == 119 || b == 104 || b == 102) {
      let is_www = starts_with_lit(s, i, n, "www.")
      let is_http = !is_www && (starts_with_lit(s, i, n, "http://") || starts_with_lit(s, i, n, "https://"))
      let is_ftp = !is_www && !is_http && starts_with_lit(s, i, n, "ftp://")
      if is_www || is_http || is_ftp {
        let mut end = i
        while end < n {
          let c = s.code_unit_at(end)
          if c <= 32 || c == 60 {
            break
          }
          end = end + 1
        }
        let trim_end = trim_autolink_url_end(s, i, end)
        let prefix_len = if is_www {
          4
        } else if is_ftp {
          6
        } else if starts_with_lit(s, i, n, "https://") {
          8
        } else {
          7
        }
        if trim_end > i + prefix_len {
          let mut has_dot = false
          let mut k = i + prefix_len
          while k < trim_end && s.code_unit_at(k) != 47 {
            if s.code_unit_at(k) == 46 {
              has_dot = true
            }
            k = k + 1
          }
          if has_dot {
            if mark < i {
              events.push(Event::Text(s.slice(mark, i)))
            }
            let raw_url = s.slice(i, trim_end)
            let dest = if is_www { "http://" + raw_url } else { raw_url }
            events.push(Event::Start(Tag::Link(LinkType::Autolink, dest, "", "")))
            events.push(Event::Text(raw_url))
            events.push(Event::End(TagEnd::Link))
            i = trim_end
            mark = trim_end
            continue
          }
        }
      }
    }

    if boundary_ok && (b == 109 || b == 120) {
      let is_mailto = b == 109 && starts_with_lit(s, i, n, "mailto:")
      let is_xmpp = b == 120 && starts_with_lit(s, i, n, "xmpp:")
      if is_mailto || is_xmpp {
        let plen = if is_mailto { 7 } else { 5 }
        let mend = scan_gfm_proto_email(s, i + plen, n, is_xmpp)
        if mend > i + plen {
          if mark < i {
            events.push(Event::Text(s.slice(mark, i)))
          }
          let raw_u = s.slice(i, mend)
          events.push(Event::Start(Tag::Link(LinkType::Autolink, raw_u, "", "")))
          events.push(Event::Text(raw_u))
          events.push(Event::End(TagEnd::Link))
          i = mend
          mark = mend
          continue
        }
      }
    }

    if b == 64 && i > mark {
      let mut lstart = i
      while lstart > mark {
        let c = s.code_unit_at(lstart - 1)
        if is_ascii_alnum(c) || c == 46 || c == 95 || c == 43 || c == 45 {
          lstart = lstart - 1
        } else {
          break
        }
      }
      let mut dend = i + 1
      let mut dots = 0
      let mut valid_domain = true
      while dend < n {
        let c = s.code_unit_at(dend)
        if is_ascii_alnum(c) || c == 45 || c == 95 {
          dend = dend + 1
        } else if c == 46 {
          dots = dots + 1
          dend = dend + 1
        } else {
          break
        }
      }
      while dend > i + 1 && s.code_unit_at(dend - 1) == 46 {
        dend = dend - 1
        dots = dots - 1
      }
      if dend <= i + 1 || dots < 1 {
        valid_domain = false
      } else {
        let last_c = s.code_unit_at(dend - 1)
        if last_c == 45 || last_c == 95 {
          valid_domain = false
        }
        if dend < n && s.code_unit_at(dend) == 43 {
          valid_domain = false
        }
      }
      if lstart < i && valid_domain {
        if mark < lstart {
          events.push(Event::Text(s.slice(mark, lstart)))
        }
        let email = s.slice(lstart, dend)
        events.push(Event::Start(Tag::Link(LinkType::Email, email, "", "")))
        events.push(Event::Text(email))
        events.push(Event::End(TagEnd::Link))
        i = dend
        mark = dend
        continue
      }
    }

    i = i + 1
  }
  if mark == 0 {
    events.push(Event::Text(s))
  } else if mark < n {
    events.push(Event::Text(s.slice(mark, n)))
  }
}

fn parse_inlines_with_ctx(
  ctx : InlineCtx,
  s : String,
  seg_start : Int,
  seg_end : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
  events : Array[Event],
) -> Unit {
  if seg_start >= seg_end {
    return ()
  }
  let first_sp = find_first_inline_special(ctx.table, s, seg_start, seg_end, ctx.sc)
  if first_sp < 0 {
    let txt = if seg_start == 0 && seg_end == s.length() { s } else { s.slice(seg_start, seg_end) }
    emit_text_with_autolinks(events, txt, opts, 0)
    return ()
  }
  scan_inlines_to_ctx(ctx, s, seg_start, seg_end, first_sp, ctx.sc.flag, ref_defs, opts)
  let mut cur = ctx.head
  let mut in_link = 0
  while cur >= 0 {
    let node = ctx.nodes[cur]
    let tag = node.tag
    if opts.autolinks && in_link == 0 && (tag == 0 || tag == 20 || tag == 1 || tag == 17) {
      let nxt = node.next
      let next_is_text = nxt >= 0 && {
        let nt = ctx.nodes[nxt].tag
        nt == 0 || nt == 20 || nt == 1 || nt == 17
      }
      if next_is_text {
        ctx.code_sb.reset()
        let mut p = cur
        while p >= 0 {
          let pn = ctx.nodes[p]
          let pt = pn.tag
          if pt == 0 || pt == 20 {
            if pn.a < pn.b {
              write_raw_span(ctx.code_sb, s, pn.a, pn.b)
            }
          } else if pt == 1 {
            ctx.code_sb.write_string(ctx.str_pool[pn.a])
          } else if pt == 17 {
            let mut k = 0
            while k < pn.b {
              ctx.code_sb.write_byte(pn.a.to_byte())
              k = k + 1
            }
          } else {
            break
          }
          p = pn.next
        }
        let merged = ctx.code_sb.to_string()
        if merged.length() > 0 {
          emit_text_with_autolinks(events, merged, opts, in_link)
        }
        cur = p
        continue
      }
    }
    if tag == 0 || tag == 20 {
      emit_text_with_autolinks(events, s.slice(node.a, node.b), opts, in_link)
    } else if tag == 1 {
      emit_text_with_autolinks(events, ctx.str_pool[node.a], opts, in_link)
    } else if tag == 2 || tag == 21 {
      events.push(Event::Code(s.slice(node.a, node.b)))
    } else if tag == 3 {
      events.push(Event::Code(ctx.str_pool[node.a]))
    } else if tag == 4 {
      events.push(Event::InlineHtml(s.slice(node.a, node.b)))
    } else if tag == 5 {
      events.push(Event::SoftBreak)
    } else if tag == 6 {
      events.push(Event::HardBreak)
    } else if tag == 7 {
      events.push(Event::Start(Tag::Emphasis))
    } else if tag == 8 {
      events.push(Event::End(TagEnd::Emphasis))
    } else if tag == 9 {
      events.push(Event::Start(Tag::Strong))
    } else if tag == 10 {
      events.push(Event::End(TagEnd::Strong))
    } else if tag == 11 {
      events.push(Event::Start(Tag::Strikethrough))
    } else if tag == 12 {
      events.push(Event::End(TagEnd::Strikethrough))
    } else if tag == 13 {
      in_link = in_link + 1
      let info = ctx.link_pool[node.a]
      events.push(Event::Start(Tag::Link(info.link_type, link_dest_str(s, info), link_title_str(s, info), info.ref_id)))
    } else if tag == 14 {
      if in_link > 0 {
        in_link = in_link - 1
      }
      events.push(Event::End(TagEnd::Link))
    } else if tag == 15 {
      let info = ctx.link_pool[node.a]
      events.push(Event::Start(Tag::Image(info.link_type, link_dest_str(s, info), link_title_str(s, info), info.ref_id)))
    } else if tag == 16 {
      events.push(Event::End(TagEnd::Image))
    } else if tag == 17 {
      if node.b > 0 {
        events.push(Event::Text(repeat_byte(node.a, node.b)))
      }
    } else if tag == 18 {
      events.push(Event::Text(if node.a != 0 { "![" } else { "[" }))
    }
    cur = node.next
  }
}

///| Parse inline content `s` and append resulting `Event`s to `events`.
pub fn parse_inlines(
  s : String,
  ref_defs : Map[String, LinkDef],
  opts : Options,
  events : Array[Event],
) -> Unit {
  let ctx = new_inline_ctx(opts, true)
  parse_inlines_with_ctx(ctx, s, 0, s.length(), ref_defs, opts, events)
}

fn join_para_spans(doc : BlockDoc, m : BlockMeta, ctx : InlineCtx) -> String {
  let n = m.line_len
  if n == 0 {
    return ""
  }
  ctx.para_sb.reset()
  let mut i = 0
  while i < n {
    let sp = doc.all_lines[m.line_start + i]
    if i > 0 {
      ctx.para_sb.write_byte((10).to_byte())
    }
    let is_last = i + 1 == n
    if sp.pad < 0 {
      let ls = doc.extra_strs[sp.start]
      if is_last {
        let mut e = ls.length()
        while e > 0 && (ls.code_unit_at(e - 1) == 32 || ls.code_unit_at(e - 1) == 9) {
          e = e - 1
        }
        write_raw_span(ctx.para_sb, ls, 0, e)
      } else {
        ctx.para_sb.write_string(ls)
      }
    } else {
      let mut k = 0
      while k < sp.pad {
        ctx.para_sb.write_byte((32).to_byte())
        k = k + 1
      }
      let mut e = sp.end
      if is_last {
        while e > sp.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
          e = e - 1
        }
      }
      write_raw_span(ctx.para_sb, doc.src, sp.start, e)
    }
    i = i + 1
  }
  ctx.para_sb.to_string()
}

fn emit_para_lines_events(
  doc : BlockDoc,
  m : BlockMeta,
  ctx : InlineCtx,
  opts : Options,
  events : Array[Event],
) -> Unit {
  let n = m.line_len
  if n == 0 {
    return ()
  }
  if n == 1 {
    let sp = doc.all_lines[m.line_start]
    if sp.pad == 0 {
      let mut e = sp.end
      while e > sp.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      parse_inlines_with_ctx(ctx, doc.src, sp.start, e, doc.ref_defs, opts, events)
      return ()
    } else if sp.pad < 0 {
      let ls = doc.extra_strs[sp.start]
      let mut e = ls.length()
      while e > 0 && (ls.code_unit_at(e - 1) == 32 || ls.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      parse_inlines_with_ctx(ctx, ls, 0, e, doc.ref_defs, opts, events)
      return ()
    }
  }
  let sp0 = doc.all_lines[m.line_start]
  if sp0.pad == 0 {
    let mut contig = true
    let mut prev_end = sp0.end
    let mut ci = 1
    while ci < n {
      let spc = doc.all_lines[m.line_start + ci]
      if spc.pad != 0 || spc.start != prev_end + 1 {
        contig = false
        break
      }
      prev_end = spc.end
      ci = ci + 1
    }
    if contig {
      let mut e = prev_end
      while e > sp0.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      parse_inlines_with_ctx(ctx, doc.src, sp0.start, e, doc.ref_defs, opts, events)
      return ()
    }
  }
  let text = join_para_spans(doc, m, ctx)
  parse_inlines_with_ctx(ctx, text, 0, text.length(), doc.ref_defs, opts, events)
}

fn join_block_spans_nl(doc : BlockDoc, m : BlockMeta, ctx : InlineCtx) -> String {
  let n = m.line_len
  if n == 0 {
    return ""
  }
  let sp0 = doc.all_lines[m.line_start]
  if sp0.pad == 0 {
    let mut contig = true
    let mut prev_end = sp0.end
    let mut ci = 1
    while ci < n {
      let spc = doc.all_lines[m.line_start + ci]
      if spc.pad != 0 || spc.start != prev_end + 1 {
        contig = false
        break
      }
      prev_end = spc.end
      ci = ci + 1
    }
    if contig && prev_end < doc.src.length() && doc.src.code_unit_at(prev_end) == 10 {
      return doc.src.slice(sp0.start, prev_end + 1)
    }
  }
  ctx.para_sb.reset()
  let mut i = 0
  while i < n {
    let sp = doc.all_lines[m.line_start + i]
    if sp.pad < 0 {
      ctx.para_sb.write_string(doc.extra_strs[sp.start])
    } else {
      let mut k = 0
      while k < sp.pad {
        ctx.para_sb.write_byte((32).to_byte())
        k = k + 1
      }
      if sp.start < sp.end {
        ctx.para_sb.write_substring(doc.src, sp.start, sp.end)
      }
    }
    ctx.para_sb.write_byte((10).to_byte())
    i = i + 1
  }
  ctx.para_sb.to_string()
}

///| Iteratively emit block events rooted at `root_idx` into `events` (zero native stack recursion).
fn emit_block_events(
  doc : BlockDoc,
  root_idx : Int,
  ctx : InlineCtx,
  opts : Options,
  init_tight : Bool,
  events : Array[Event],
) -> Unit {
  let stack : Array[RenderFrame] = Array::with_capacity(16)
  stack.push(RenderFrame::{ idx: root_idx, next_child: -1, flags: if init_tight { 1 } else { 0 } })

  while stack.length() > 0 {
    let sp_idx = stack.length() - 1
    let frame = stack[sp_idx]
    let idx = frame.idx
    let in_tight_list = (frame.flags & 1) != 0
    let opened = (frame.flags & 2) != 0
    let m = doc.meta[idx]
    let t = doc.tree[idx]
    let kind = m.kf & 15

    if opened {
      let c = frame.next_child
      if c >= 0 {
        let next_sib = doc.tree[c].next_sibling
        stack[sp_idx] = RenderFrame::{ idx, next_child: next_sib, flags: frame.flags }
        let child_tight = if kind == 2 {
          (m.kf & 32) != 0
        } else if kind == 3 {
          in_tight_list
        } else {
          false
        }
        // Fast path: emit Paragraph leaf directly without RenderFrame push/pop!
        let cm = doc.meta[c]
        if (cm.kf & 15) == 4 {
          if child_tight {
            emit_para_lines_events(doc, cm, ctx, opts, events)
          } else {
            events.push(Event::Start(Tag::Paragraph))
            emit_para_lines_events(doc, cm, ctx, opts, events)
            events.push(Event::End(TagEnd::Paragraph))
          }
          continue
        }
        stack.push(RenderFrame::{ idx: c, next_child: -1, flags: if child_tight { 1 } else { 0 } })
        continue
      }
      let _ = stack.pop()
      if kind == 1 {
        events.push(Event::End(TagEnd::BlockQuote))
      } else if kind == 2 {
        events.push(Event::End(TagEnd::List((m.kf & 512) != 0)))
      } else if kind == 3 {
        events.push(Event::End(TagEnd::Item))
      }
      continue
    }

    if kind == 0 {
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 1 {
      events.push(Event::Start(Tag::BlockQuote))
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 2 {
      let ordered = (m.kf & 512) != 0
      let list_tag = if ordered { Tag::List(Some(m.extra)) } else { Tag::List(None) }
      events.push(Event::Start(list_tag))
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 3 {
      events.push(Event::Start(Tag::Item))
      let mut start_child = t.first_child
      let task_state = (m.kf >> 7) & 3
      if task_state != 0 {
        let checked = task_state == 2
        if !in_tight_list && start_child >= 0 {
          let fm = doc.meta[start_child]
          if (fm.kf & 15) == 4 {
            events.push(Event::Start(Tag::Paragraph))
            events.push(Event::TaskListMarker(checked))
            emit_para_lines_events(doc, fm, ctx, opts, events)
            events.push(Event::End(TagEnd::Paragraph))
            start_child = doc.tree[start_child].next_sibling
          } else {
            events.push(Event::TaskListMarker(checked))
          }
        } else {
          events.push(Event::TaskListMarker(checked))
        }
      }
      stack[sp_idx] = RenderFrame::{ idx, next_child: start_child, flags: frame.flags | 2 }
    } else if kind == 4 {
      let _ = stack.pop()
      if in_tight_list {
        emit_para_lines_events(doc, m, ctx, opts, events)
      } else {
        events.push(Event::Start(Tag::Paragraph))
        emit_para_lines_events(doc, m, ctx, opts, events)
        events.push(Event::End(TagEnd::Paragraph))
      }
    } else if kind == 5 {
      let _ = stack.pop()
      let level = (m.kf >> 10) & 255
      events.push(Event::Start(Tag::Heading(level)))
      emit_para_lines_events(doc, m, ctx, opts, events)
      events.push(Event::End(TagEnd::Heading(level)))
    } else if kind == 6 {
      let _ = stack.pop()
      events.push(Event::Start(Tag::CodeBlock(CodeBlockKind::Indented)))
      let code = join_block_spans_nl(doc, m, ctx)
      if code.length() > 0 {
        events.push(Event::Text(code))
      }
      events.push(Event::End(TagEnd::CodeBlock))
    } else if kind == 7 {
      let _ = stack.pop()
      let info = if m.extra < 0 { "" } else { doc.extra_strs[m.extra] }
      events.push(Event::Start(Tag::CodeBlock(CodeBlockKind::Fenced(info))))
      let code = join_block_spans_nl(doc, m, ctx)
      if code.length() > 0 {
        events.push(Event::Text(code))
      }
      events.push(Event::End(TagEnd::CodeBlock))
    } else if kind == 8 {
      let _ = stack.pop()
      events.push(Event::Start(Tag::HtmlBlock))
      let html = join_block_spans_nl(doc, m, ctx)
      if html.length() > 0 {
        events.push(Event::Html(html))
      }
      events.push(Event::End(TagEnd::HtmlBlock))
    } else if kind == 9 {
      let _ = stack.pop()
      events.push(Event::Rule)
    } else if kind == 10 {
      let _ = stack.pop()
      let aligns = doc.table_aligns[t.extra2]
      let cells_start = m.extra
      let ncols = m.line_start
      let num_rows = m.line_len
      events.push(Event::Start(Tag::Table(aligns)))
      events.push(Event::Start(Tag::TableHead))
      let mut hi = 0
      while hi < ncols {
        events.push(Event::Start(Tag::TableCell))
        let sp = doc.table_cells[cells_start + hi]
        if sp.pad < 0 {
          let cs = doc.extra_strs[sp.start]
          parse_inlines_with_ctx(ctx, cs, 0, cs.length(), doc.ref_defs, opts, events)
        } else if sp.start < sp.end {
          parse_inlines_with_ctx(ctx, doc.src, sp.start, sp.end, doc.ref_defs, opts, events)
        }
        events.push(Event::End(TagEnd::TableCell))
        hi = hi + 1
      }
      events.push(Event::End(TagEnd::TableHead))
      let mut ri = 0
      while ri < num_rows {
        events.push(Event::Start(Tag::TableRow))
        let row_base = cells_start + (ri + 1) * ncols
        let mut ci = 0
        while ci < ncols {
          events.push(Event::Start(Tag::TableCell))
          let sp = doc.table_cells[row_base + ci]
          if sp.pad < 0 {
            let cs = doc.extra_strs[sp.start]
            parse_inlines_with_ctx(ctx, cs, 0, cs.length(), doc.ref_defs, opts, events)
          } else if sp.start < sp.end {
            parse_inlines_with_ctx(ctx, doc.src, sp.start, sp.end, doc.ref_defs, opts, events)
          }
          events.push(Event::End(TagEnd::TableCell))
          ci = ci + 1
        }
        events.push(Event::End(TagEnd::TableRow))
        ri = ri + 1
      }
      events.push(Event::End(TagEnd::Table))
    } else {
      let _ = stack.pop()
    }
  }
}

///| Top-level entry point: parse Markdown string into flat `Array[Event]`.
pub fn parse_events(src : String, opts : Options) -> Array[Event] {
  let doc = parse_blocks(src, opts)
  let ctx = new_inline_ctx(opts, true)
  let events : Array[Event] = Array::with_capacity(doc.meta.length() * 3 + 16)
  emit_block_events(doc, 0, ctx, opts, false, events)
  events
}
