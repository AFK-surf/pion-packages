///| CommonMark 0.31.2 + GFM + Smart Punctuation + CJK-Friendly Phase 2 Inline Parser & Event Emitter.

///| Internal inline AST node stored in a flat intrusive doubly-linked list for O(1) wrapping.
enum InlineKind {
  Text(String)
  Code(String)
  InlineHtml(String)
  SoftBreak
  HardBreak
  StartTag(Tag)
  EndTag(TagEnd)
  DelimText(Int, Int) // (byte_char, count)
  BracketText(Bool) // is_image: true = "![", false = "["
  Removed
}

struct InlineNode {
  mut kind : InlineKind
  mut prev : Int
  mut next : Int
}

struct DelimEntry {
  node_idx : Int
  delim : Int // 42='*', 95='_', 126='~', 34='"', 39='\''
  orig_len : Int
  mut len : Int
  can_open : Bool
  can_close : Bool
  mut active : Bool
}

struct BracketEntry {
  node_idx : Int
  delim_idx : Int // index into delims array at time of '['
  text_start : Int // byte offset in inline string right after '[' or '!['
  is_image : Bool
  mut active : Bool
}

///| Intrusive doubly-linked list of InlineNodes.
struct InlineList {
  nodes : Array[InlineNode]
  mut head : Int
  mut tail : Int
}

fn new_inline_list() -> InlineList {
  InlineList::{ nodes: Array::new(), head: -1, tail: -1 }
}

fn il_push(il : InlineList, kind : InlineKind) -> Int {
  let idx = il.nodes.length()
  let prev = il.tail
  il.nodes.push(InlineNode::{ kind, prev, next: -1 })
  if prev >= 0 {
    il.nodes[prev].next = idx
  } else {
    il.head = idx
  }
  il.tail = idx
  idx
}

fn il_insert_after(il : InlineList, after_idx : Int, kind : InlineKind) -> Int {
  let idx = il.nodes.length()
  let nxt = il.nodes[after_idx].next
  il.nodes.push(InlineNode::{ kind, prev: after_idx, next: nxt })
  il.nodes[after_idx].next = idx
  if nxt >= 0 {
    il.nodes[nxt].prev = idx
  } else {
    il.tail = idx
  }
  idx
}

fn il_insert_before(il : InlineList, before_idx : Int, kind : InlineKind) -> Int {
  let idx = il.nodes.length()
  let prv = il.nodes[before_idx].prev
  il.nodes.push(InlineNode::{ kind, prev: prv, next: before_idx })
  il.nodes[before_idx].prev = idx
  if prv >= 0 {
    il.nodes[prv].next = idx
  } else {
    il.head = idx
  }
  idx
}

///| Compute CommonMark (or CJK-friendly) flanking flags `(can_open, can_close)` for a delimiter run.
fn compute_flanking(
  s : String,
  run_start : Int,
  run_end : Int,
  delim : Int,
  opts : Options,
) -> (Bool, Bool) {
  let n = s.length()
  let (prev_cp, prev_start) = if run_start > 0 {
    utf8_decode_prev(s, run_start)
  } else {
    (10, 0) // beginning of line counts as whitespace
  }
  let (next_cp, _) = if run_end < n {
    utf8_decode(s, run_end)
  } else {
    (10, 0) // end of line counts as whitespace
  }

  let run_len = run_end - run_start

  if opts.cjk_friendly && (delim == 42 || delim == 95 || (delim == 126 && run_len == 1)) {
    let prev_is_vs = is_non_emoji_general_vs(prev_cp)
    let (prev_is_cjk, prev_is_ivs, prev_is_punct) = if prev_is_vs {
      if prev_start > 0 {
        let (pp_cp, _) = utf8_decode_prev(s, prev_start)
        (
          is_cjk_char(pp_cp) || is_cjk_ambiguous_punct_seq(pp_cp, prev_cp),
          false,
          is_unicode_punct(pp_cp),
        )
      } else {
        (false, false, false)
      }
    } else {
      (is_cjk_char(prev_cp), is_ideographic_vs(prev_cp), is_unicode_punct(prev_cp))
    }

    let before_ws = is_unicode_ws(prev_cp)
    let after_ws = is_unicode_ws(next_cp)
    let after_punct = is_unicode_punct(next_cp)
    let before_ws_or_punct = before_ws || prev_is_punct
    let after_ws_or_punct = after_ws || after_punct

    if delim == 95 || delim == 126 {
      let open = !after_ws && (!after_punct || before_ws_or_punct || next_cp == 42 || next_cp == 95)
      let close = !before_ws && (!prev_is_punct || after_ws_or_punct || prev_cp == 42 || prev_cp == 95)
      return (open && (before_ws_or_punct || !close), close && (after_ws_or_punct || !open))
    }

    // delim == '*'
    let before_cjk_or_ivs = prev_is_cjk || prev_is_ivs
    let after_cjk = is_cjk_char(next_cp)
    let can_open = !after_ws &&
    (!after_punct || before_ws_or_punct || before_cjk_or_ivs || after_cjk || next_cp == 42 || next_cp == 95)
    let can_close = !before_ws &&
    (!prev_is_punct || after_ws_or_punct || prev_is_cjk || after_cjk || prev_cp == 42 || prev_cp == 95)
    return (can_open, can_close)
  }

  let before_ws = is_unicode_ws(prev_cp)
  let after_ws = is_unicode_ws(next_cp)
  let before_punct = is_unicode_punct(prev_cp)
  let after_punct = is_unicode_punct(next_cp)

  let left_flanking = !after_ws && (!after_punct || before_ws || before_punct)
  let right_flanking = !before_ws && (!before_punct || after_ws || after_punct)

  if delim == 95 {
    // '_' intraword rule
    (left_flanking && (!right_flanking || before_punct), right_flanking && (!left_flanking || after_punct))
  } else if delim == 126 {
    // GFM strikethrough: 2 tildes always open/close (pulldown-cmark); 1 tilde uses flanking
    if run_len == 2 {
      (true, true)
    } else if run_len == 1 {
      (left_flanking, right_flanking)
    } else {
      (false, false)
    }
  } else if delim == 34 || delim == 39 {
    // Smart quotes: `'` after `]` or `)` closes (apostrophe, e.g. `[a]'s`)
    if delim == 39 && (prev_cp == 93 || prev_cp == 41) {
      (false, true)
    } else {
      (left_flanking && !right_flanking, right_flanking)
    }
  } else {
    // '*'
    (left_flanking, right_flanking)
  }
}

///| Process emphasis, strong, strikethrough, and smart quotes in `delims[stack_bottom..]`.
fn process_emphasis(
  il : InlineList,
  delims : Array[DelimEntry],
  stack_bottom : Int,
) -> Unit {
  if delims.length() <= stack_bottom {
    return ()
  }
  // openers_bottom cache: 5 delim types * 3 (len % 3) * 2 (can_open) = 30 slots
  let bottoms : Array[Int] = Array::new()
  let mut bi = 0
  while bi < 30 {
    bottoms.push(stack_bottom)
    bi = bi + 1
  }

  let delim_slot = fn(d : Int) -> Int {
    if d == 42 {
      0
    } else if d == 95 {
      1
    } else if d == 126 {
      2
    } else if d == 34 {
      3
    } else {
      4
    }
  }

  let mut closer_idx = stack_bottom
  while closer_idx < delims.length() {
    let closer = delims[closer_idx]
    if !closer.active || !closer.can_close || closer.len == 0 {
      closer_idx = closer_idx + 1
      continue
    }

    // Quotes: match single `'` or `"` opener
    if closer.delim == 34 || closer.delim == 39 {
      let mut j = closer_idx - 1
      let mut found = -1
      while j >= stack_bottom {
        let opener = delims[j]
        if opener.active && opener.can_open && opener.delim == closer.delim && opener.len > 0 {
          found = j
          break
        }
        j = j - 1
      }
      if found >= 0 {
        let opener = delims[found]
        if closer.delim == 34 {
          il.nodes[opener.node_idx].kind = InlineKind::Text("“")
          il.nodes[closer.node_idx].kind = InlineKind::Text("”")
        } else {
          il.nodes[opener.node_idx].kind = InlineKind::Text("‘")
          il.nodes[closer.node_idx].kind = InlineKind::Text("’")
        }
        opener.len = 0
        opener.active = false
        closer.len = 0
        closer.active = false
        // Deactivate delimiters between opener and closer
        let mut k = found + 1
        while k < closer_idx {
          delims[k].active = false
          k = k + 1
        }
      } else {
        // Unmatched closing quote: single quote becomes apostrophe ’
        if closer.delim == 39 {
          il.nodes[closer.node_idx].kind = InlineKind::Text("’")
          closer.len = 0
          closer.active = false
        }
      }
      closer_idx = closer_idx + 1
      continue
    }

    let slot = delim_slot(closer.delim) * 6 + (closer.orig_len % 3) * 2 + (if closer.can_open { 1 } else { 0 })
    let min_opener = bottoms[slot]

    let mut opener_idx = closer_idx - 1
    let mut found_opener = -1
    while opener_idx >= min_opener {
      let opener = delims[opener_idx]
      if opener.active && opener.can_open && opener.len > 0 && opener.delim == closer.delim {
        if closer.delim == 126 {
          // Strikethrough: exact length match (1==1 or 2==2)
          if opener.orig_len == closer.orig_len {
            found_opener = opener_idx
            break
          }
        } else {
          // CommonMark rule of 3
          let odd_match = (opener.can_close || closer.can_open) &&
          ((opener.orig_len + closer.orig_len) % 3 == 0) &&
          !((opener.orig_len % 3 == 0) && (closer.orig_len % 3 == 0))
          if !odd_match {
            found_opener = opener_idx
            break
          }
        }
      }
      opener_idx = opener_idx - 1
    }

    if found_opener >= 0 {
      let opener = delims[found_opener]
      let use_delims = if closer.delim == 126 {
        closer.len
      } else if opener.len >= 2 && closer.len >= 2 {
        2
      } else {
        1
      }

      opener.len = opener.len - use_delims
      closer.len = closer.len - use_delims

      if opener.len == 0 {
        il.nodes[opener.node_idx].kind = InlineKind::Removed
        opener.active = false
      } else {
        il.nodes[opener.node_idx].kind = InlineKind::DelimText(opener.delim, opener.len)
      }

      if closer.len == 0 {
        il.nodes[closer.node_idx].kind = InlineKind::Removed
        closer.active = false
      } else {
        il.nodes[closer.node_idx].kind = InlineKind::DelimText(closer.delim, closer.len)
      }

      let (st, et) = if closer.delim == 126 {
        (Tag::Strikethrough, TagEnd::Strikethrough)
      } else if use_delims == 2 {
        (Tag::Strong, TagEnd::Strong)
      } else {
        (Tag::Emphasis, TagEnd::Emphasis)
      }

      let _ = il_insert_after(il, opener.node_idx, InlineKind::StartTag(st))
      let _ = il_insert_before(il, closer.node_idx, InlineKind::EndTag(et))

      // Deactivate all delimiters strictly between opener and closer
      let mut k = found_opener + 1
      while k < closer_idx {
        delims[k].active = false
        k = k + 1
      }

      if closer.len == 0 {
        closer_idx = closer_idx + 1
      }
    } else {
      bottoms[slot] = closer_idx
      if !closer.can_open {
        closer.active = false
      }
      closer_idx = closer_idx + 1
    }
  }

  // Convert any remaining active unmatched quotes
  let mut k = stack_bottom
  while k < delims.length() {
    let d = delims[k]
    if d.active && d.len > 0 {
      if d.delim == 34 {
        il.nodes[d.node_idx].kind = InlineKind::Text(if d.can_open { "“" } else { "”" })
      } else if d.delim == 39 {
        // Unmatched single quote is always right single quote (apostrophe ’)
        il.nodes[d.node_idx].kind = InlineKind::Text("’")
      }
    }
    d.active = false
    k = k + 1
  }
}

///| Write `n` copies of byte `ch` as a String.
fn repeat_byte(ch : Int, count : Int) -> String {
  if count == 1 {
    if ch == 42 { return "*" }
    if ch == 95 { return "_" }
    if ch == 126 { return "~" }
    if ch == 34 { return "\"" }
    if ch == 39 { return "'" }
  }
  if count == 2 {
    if ch == 42 { return "**" }
    if ch == 95 { return "__" }
    if ch == 126 { return "~~" }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < count {
    sb.write_byte(ch.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Expand smart punctuation hyphen runs (`--`, `---`, etc.) per pulldown-cmark / CommonMark rules.
fn smart_dashes(count : Int) -> String {
  let sb = StringBuilder::new()
  let mut em = 0
  let mut en = 0
  if count % 3 == 0 {
    em = count / 3
  } else if count % 2 == 0 {
    en = count / 2
  } else if count % 3 == 2 {
    em = (count - 2) / 3
    en = 1
  } else {
    em = (count - 4) / 3
    en = 2
  }
  let mut i = 0
  while i < em {
    sb.write_string("—")
    i = i + 1
  }
  i = 0
  while i < en {
    sb.write_string("–")
    i = i + 1
  }
  sb.to_string()
}

///| Emit text with optional GFM autolink literal detection (only when `in_link == 0`).
fn emit_text_with_autolinks(
  events : Array[Event],
  s : String,
  opts : Options,
  in_link : Int,
) -> Unit {
  if !opts.autolinks || in_link > 0 || s.length() < 5 {
    events.push(Event::Text(s))
    return ()
  }
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let boundary_ok = i == 0 || {
      let pb = s.code_unit_at(i - 1)
      is_ascii_ws(pb) || pb == 40 || pb == 42 || pb == 95 || pb == 126 || pb == 91
    }

    // 1. Check `www.` or `http://` or `https://`
    if boundary_ok && (b == 119 || b == 104) {
      let is_www = starts_with_lit(s, i, n, "www.")
      let is_http = !is_www && (starts_with_lit(s, i, n, "http://") || starts_with_lit(s, i, n, "https://"))
      if is_www || is_http {
        let mut end = i
        while end < n {
          let c = s.code_unit_at(end)
          if c <= 32 || c == 60 {
            break
          }
          end = end + 1
        }
        // Trim trailing GFM punctuation and unmatched ')'
        let mut trim_end = end
        let mut changed = true
        while changed && trim_end > i {
          changed = false
          let last = s.code_unit_at(trim_end - 1)
          if last == 63 || last == 33 || last == 46 || last == 44 || last == 58 || last == 42 || last == 95 || last == 126 {
            trim_end = trim_end - 1
            changed = true
          } else if last == 41 {
            // Count '(' vs ')' in s[i..trim_end]
            let mut opens = 0
            let mut closes = 0
            let mut k = i
            while k < trim_end {
              let ch = s.code_unit_at(k)
              if ch == 40 { opens = opens + 1 }
              if ch == 41 { closes = closes + 1 }
              k = k + 1
            }
            if closes > opens {
              trim_end = trim_end - 1
              changed = true
            }
          }
        }
        // Validate domain has at least one '.' after prefix
        let prefix_len = if is_www { 4 } else if starts_with_lit(s, i, n, "https://") { 8 } else { 7 }
        if trim_end > i + prefix_len {
          let mut has_dot = false
          let mut k = i + prefix_len
          while k < trim_end && s.code_unit_at(k) != 47 {
            if s.code_unit_at(k) == 46 {
              has_dot = true
            }
            k = k + 1
          }
          if has_dot {
            if mark < i {
              events.push(Event::Text(s.slice(mark, i)))
            }
            let raw_url = s.slice(i, trim_end)
            let dest = if is_www { "http://" + raw_url } else { raw_url }
            events.push(Event::Start(Tag::Link(LinkType::Autolink, dest, "", "")))
            events.push(Event::Text(raw_url))
            events.push(Event::End(TagEnd::Link))
            i = trim_end
            mark = trim_end
            continue
          }
        }
      }
    }

    // 2. Check GFM email autolink literal: look for '@'
    if b == 64 && i > mark {
      // Scan backwards for local part: [a-zA-Z0-9._+-]
      let mut lstart = i
      while lstart > mark {
        let c = s.code_unit_at(lstart - 1)
        if is_ascii_alnum(c) || c == 46 || c == 95 || c == 43 || c == 45 {
          lstart = lstart - 1
        } else {
          break
        }
      }
      // Scan forwards for domain part: [a-zA-Z0-9._-]
      let mut dend = i + 1
      let mut dots = 0
      let mut valid_domain = true
      while dend < n {
        let c = s.code_unit_at(dend)
        if is_ascii_alnum(c) || c == 45 || c == 95 {
          dend = dend + 1
        } else if c == 46 {
          dots = dots + 1
          dend = dend + 1
        } else {
          break
        }
      }
      // Strip trailing '.' from domain
      while dend > i + 1 && s.code_unit_at(dend - 1) == 46 {
        dend = dend - 1
        dots = dots - 1
      }
      // Domain cannot end with '-' or '_', and cannot contain '+' or '_' in last segment, and must have >= 1 dot
      if dend <= i + 1 || dots < 1 {
        valid_domain = false
      } else {
        let last_c = s.code_unit_at(dend - 1)
        if last_c == 45 || last_c == 95 {
          valid_domain = false
        }
        // Check that domain doesn't immediately precede '+' or invalid email domain char like '+'
        if dend < n && s.code_unit_at(dend) == 43 {
          valid_domain = false
        }
      }
      if lstart < i && valid_domain {
        if mark < lstart {
          events.push(Event::Text(s.slice(mark, lstart)))
        }
        let email = s.slice(lstart, dend)
        events.push(Event::Start(Tag::Link(LinkType::Email, email, "", "")))
        events.push(Event::Text(email))
        events.push(Event::End(TagEnd::Link))
        i = dend
        mark = dend
        continue
      }
    }

    i = i + 1
  }
  if mark == 0 {
    events.push(Event::Text(s))
  } else if mark < n {
    events.push(Event::Text(s.slice(mark, n)))
  }
}

///| Parse inline content `s` and append resulting `Event`s to `events`.
pub fn parse_inlines(
  s : String,
  ref_defs : Map[String, LinkDef],
  opts : Options,
  events : Array[Event],
) -> Unit {
  let n = s.length()
  if n == 0 {
    return ()
  }
  // Fast path: scan for any inline trigger byte; if none, emit plain text with zero allocations
  let mut has_special = false
  let mut si = 0
  while si < n {
    let sb = s.code_unit_at(si)
    if sb == 92 || sb == 10 || sb == 96 || sb == 38 || sb == 60 || sb == 42 || sb == 95 || sb == 91 || sb == 93 || sb == 33 ||
    (opts.strikethrough && sb == 126) ||
    (opts.smart_punctuation && (sb == 34 || sb == 39 || sb == 45 || sb == 46)) {
      has_special = true
      break
    }
    si = si + 1
  }
  if !has_special {
    emit_text_with_autolinks(events, s, opts, 0)
    return ()
  }

  let il = new_inline_list()
  let delims : Array[DelimEntry] = Array::new()
  let brackets : Array[BracketEntry] = Array::new()
  // Lazily initialized cache of farthest failed backtick closing search per length (1..64)
  let bt_failed : Array[Int] = Array::new()

  let mut text_start = 0
  let mut i = 0

  let flush_text = fn(up_to : Int) -> Unit {
    if text_start < up_to {
      let _ = il_push(il, InlineKind::Text(s.slice(text_start, up_to)))
    }
  }

  while i < n {
    let b = s.code_unit_at(i)

    // 1. Backslash escape or hard line break
    if b == 92 {
      if i + 1 < n {
        let nb = s.code_unit_at(i + 1)
        if nb == 10 {
          flush_text(i)
          let _ = il_push(il, InlineKind::HardBreak)
          i = i + 2
          while i < n && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
            i = i + 1
          }
          text_start = i
          continue
        } else if is_ascii_punct(nb) {
          flush_text(i)
          let _ = il_push(il, InlineKind::Text(s.slice(i + 1, i + 2)))
          i = i + 2
          text_start = i
          continue
        }
      }
      i = i + 1
      continue
    }

    // 2. Newline: SoftBreak or HardBreak (2+ trailing spaces)
    if b == 10 {
      // Count trailing spaces before '\n'
      let mut sp_start = i
      while sp_start > text_start && s.code_unit_at(sp_start - 1) == 32 {
        sp_start = sp_start - 1
      }
      let trailing_spaces = i - sp_start
      if trailing_spaces >= 2 {
        flush_text(sp_start)
        let _ = il_push(il, InlineKind::HardBreak)
      } else {
        // Also strip single trailing space (or tabs? CommonMark strips trailing spaces only, not tabs)
        flush_text(sp_start)
        let _ = il_push(il, InlineKind::SoftBreak)
      }
      i = i + 1
      while i < n && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
        i = i + 1
      }
      text_start = i
      continue
    }

    // 3. Code span (backtick run)
    if b == 96 {
      let run_start = i
      while i < n && s.code_unit_at(i) == 96 {
        i = i + 1
      }
      let ticks = i - run_start
      if bt_failed.length() == 0 && ticks < 65 {
        let mut bti = 0
        while bti < 65 {
          bt_failed.push(-1)
          bti = bti + 1
        }
      }
      let can_search = if ticks < 65 { bt_failed[ticks] < run_start } else { true }
      let mut match_pos = -1
      if can_search {
        let mut j = i
        while j < n {
          if s.code_unit_at(j) == 96 {
            let cs = j
            while j < n && s.code_unit_at(j) == 96 {
              j = j + 1
            }
            if j - cs == ticks {
              match_pos = cs
              break
            }
          } else {
            j = j + 1
          }
        }
        if match_pos < 0 && ticks < 65 {
          bt_failed[ticks] = n
        }
      }
      if match_pos >= 0 {
        flush_text(run_start)
        // Normalize code span content: newlines -> spaces, strip 1 leading & 1 trailing space if both present and not all spaces
        let csb = StringBuilder::new()
        let mut all_spaces = true
        let mut k = i
        while k < match_pos {
          let cb = s.code_unit_at(k)
          if cb == 10 {
            csb.write_byte((32).to_byte())
          } else {
            if cb != 32 {
              all_spaces = false
            }
            csb.write_byte(cb.to_byte())
          }
          k = k + 1
        }
        let raw_code = csb.to_string()
        let rlen = raw_code.length()
        let final_code = if rlen >= 2 && !all_spaces && raw_code.code_unit_at(0) == 32 && raw_code.code_unit_at(rlen - 1) == 32 {
          raw_code.slice(1, rlen - 1)
        } else {
          raw_code
        }
        let _ = il_push(il, InlineKind::Code(final_code))
        i = match_pos + ticks
        text_start = i
        continue
      }
      // Unmatched backtick run: keep as literal text
      continue
    }

    // 4. HTML entity / numeric character reference
    if b == 38 {
      match scan_entity(s, i, n) {
        Some((decoded, next_i)) => {
          flush_text(i)
          let _ = il_push(il, InlineKind::Text(decoded))
          i = next_i
          text_start = i
          continue
        }
        None => {
          i = i + 1
          continue
        }
      }
    }

    // 5. Autolink `<...>` or Inline HTML `<...>`
    if b == 60 {
      match scan_autolink(s, i, n) {
        Some((is_email, inner, next_i)) => {
          flush_text(i)
          let lt = if is_email { LinkType::Email } else { LinkType::Autolink }
          let _ = il_push(il, InlineKind::StartTag(Tag::Link(lt, inner, "", "")))
          let _ = il_push(il, InlineKind::Text(inner))
          let _ = il_push(il, InlineKind::EndTag(TagEnd::Link))
          i = next_i
          text_start = i
          continue
        }
        None => ()
      }
      let html_end = scan_inline_html(s, i, n)
      if html_end > 0 {
        flush_text(i)
        let _ = il_push(il, InlineKind::InlineHtml(s.slice(i, html_end)))
        i = html_end
        text_start = i
        continue
      }
      i = i + 1
      continue
    }

    // 6. Emphasis / Strong / Strikethrough delimiters: `*`, `_`, `~`
    if b == 42 || b == 95 || (b == 126 && opts.strikethrough) {
      let run_start = i
      while i < n && s.code_unit_at(i) == b {
        i = i + 1
      }
      let run_len = i - run_start
      let (can_open, can_close) = compute_flanking(s, run_start, i, b, opts)
      if can_open || can_close {
        flush_text(run_start)
        let nidx = il_push(il, InlineKind::DelimText(b, run_len))
        delims.push(DelimEntry::{
          node_idx: nidx,
          delim: b,
          orig_len: run_len,
          len: run_len,
          can_open,
          can_close,
          active: true,
        })
        text_start = i
      }
      continue
    }

    // 7. Smart punctuation: `"`, `'`, `--`, `---`, `...`
    if opts.smart_punctuation {
      if b == 34 || b == 39 {
        let (can_open, can_close) = compute_flanking(s, i, i + 1, b, opts)
        flush_text(i)
        if can_open || can_close {
          let nidx = il_push(il, InlineKind::DelimText(b, 1))
          delims.push(DelimEntry::{
            node_idx: nidx,
            delim: b,
            orig_len: 1,
            len: 1,
            can_open,
            can_close,
            active: true,
          })
        } else if b == 39 {
          let _ = il_push(il, InlineKind::Text("’"))
        } else {
          let _ = il_push(il, InlineKind::Text("“"))
        }
        i = i + 1
        text_start = i
        continue
      }
      if b == 45 && i + 1 < n && s.code_unit_at(i + 1) == 45 {
        let run_start = i
        while i < n && s.code_unit_at(i) == 45 {
          i = i + 1
        }
        flush_text(run_start)
        let _ = il_push(il, InlineKind::Text(smart_dashes(i - run_start)))
        text_start = i
        continue
      }
      if b == 46 && i + 2 < n && s.code_unit_at(i + 1) == 46 && s.code_unit_at(i + 2) == 46 {
        flush_text(i)
        let _ = il_push(il, InlineKind::Text("…"))
        i = i + 3
        text_start = i
        continue
      }
    }

    // 8. Link / Image openers: `[` and `![`
    if b == 91 || (b == 33 && i + 1 < n && s.code_unit_at(i + 1) == 91) {
      let is_img = b == 33
      flush_text(i)
      let nidx = il_push(il, InlineKind::BracketText(is_img))
      let after = if is_img { i + 2 } else { i + 1 }
      brackets.push(BracketEntry::{
        node_idx: nidx,
        delim_idx: delims.length(),
        text_start: after,
        is_image: is_img,
        active: true,
      })
      i = after
      text_start = i
      continue
    }

    // 9. Link / Image closer: `]`
    if b == 93 && brackets.length() > 0 {
      let br = brackets[brackets.length() - 1]
      let _ = brackets.pop()
      if !br.active {
        i = i + 1
        continue
      }

      // Try to match inline link `(dest "title")`, full ref `[label]`, collapsed ref `[]`, or shortcut ref
      let mut matched = false
      let mut dest = ""
      let mut title = ""
      let mut ref_id = ""
      let mut link_type = LinkType::Inline
      let mut after_close = i + 1

      // Case A: Inline link `(...)`
      if i + 1 < n && s.code_unit_at(i + 1) == 40 {
        let mut p = i + 2
        while p < n && is_ascii_ws(s.code_unit_at(p)) {
          p = p + 1
        }
        if p < n && s.code_unit_at(p) == 41 {
          matched = true
          after_close = p + 1
        } else {
          match scan_link_dest(s, p, n) {
            Some((d, after_d)) => {
              let mut q = after_d
              while q < n && is_ascii_ws(s.code_unit_at(q)) {
                q = q + 1
              }
              if q < n && s.code_unit_at(q) == 41 {
                matched = true
                dest = d
                after_close = q + 1
              } else if q > after_d {
                match scan_link_title(s, q, n) {
                  Some((t, after_t)) => {
                    let mut r = after_t
                    while r < n && is_ascii_ws(s.code_unit_at(r)) {
                      r = r + 1
                    }
                    if r < n && s.code_unit_at(r) == 41 {
                      matched = true
                      dest = d
                      title = t
                      after_close = r + 1
                    }
                  }
                  None => ()
                }
              }
            }
            None => ()
          }
        }
      }

      // Case B: Full reference `[label]` or Collapsed reference `[]`
      if !matched && i + 1 < n && s.code_unit_at(i + 1) == 91 {
        if i + 2 < n && s.code_unit_at(i + 2) == 93 {
          // Collapsed reference: look up bracket inner text
          let raw_lbl = s.slice(br.text_start, i)
          let norm = normalize_link_label(raw_lbl)
          match ref_defs.get(norm) {
            Some(def) => {
              matched = true
              dest = def.dest
              title = def.title
              ref_id = raw_lbl
              link_type = LinkType::Collapsed
              after_close = i + 3
            }
            None => ()
          }
        } else {
          match scan_link_label(s, i + 1, n) {
            Some((raw_lbl, after_lbl)) => {
              let norm = normalize_link_label(raw_lbl)
              match ref_defs.get(norm) {
                Some(def) => {
                  matched = true
                  dest = def.dest
                  title = def.title
                  ref_id = raw_lbl
                  link_type = LinkType::Reference
                  after_close = after_lbl
                }
                None => ()
              }
            }
            None => ()
          }
        }
      }

      // Case C: Shortcut reference (not followed by `[`)
      if !matched {
        let has_next_label = if i + 1 < n && s.code_unit_at(i + 1) == 91 {
          match scan_link_label(s, i + 1, n) {
            Some(_) => true
            None => i + 2 < n && s.code_unit_at(i + 2) == 93
          }
        } else {
          false
        }
        if !has_next_label {
          let raw_lbl = s.slice(br.text_start, i)
          // Shortcut label cannot contain unescaped '[' or ']'
          let mut valid_shortcut = raw_lbl.length() <= 999
          let mut k = 0
          while valid_shortcut && k < raw_lbl.length() {
            let c = raw_lbl.code_unit_at(k)
            if c == 92 && k + 1 < raw_lbl.length() {
              k = k + 2
            } else if c == 91 || c == 93 {
              valid_shortcut = false
            } else {
              k = k + 1
            }
          }
          if valid_shortcut {
            let norm = normalize_link_label(raw_lbl)
            match ref_defs.get(norm) {
              Some(def) => {
                matched = true
                dest = def.dest
                title = def.title
                ref_id = raw_lbl
                link_type = LinkType::Shortcut
                after_close = i + 1
              }
              None => ()
            }
          }
        }
      }

      if matched {
        flush_text(i)
        process_emphasis(il, delims, br.delim_idx)
        if br.is_image {
          il.nodes[br.node_idx].kind = InlineKind::StartTag(Tag::Image(link_type, dest, title, ref_id))
          let _ = il_push(il, InlineKind::EndTag(TagEnd::Image))
        } else {
          il.nodes[br.node_idx].kind = InlineKind::StartTag(Tag::Link(link_type, dest, title, ref_id))
          let _ = il_push(il, InlineKind::EndTag(TagEnd::Link))
          // Deactivate all earlier non-image `[` brackets (links cannot contain links)
          let mut bi = 0
          while bi < brackets.length() {
            if !brackets[bi].is_image {
              brackets[bi].active = false
            }
            bi = bi + 1
          }
        }
        i = after_close
        text_start = i
        continue
      }

      i = i + 1
      continue
    }

    i = i + 1
  }

  flush_text(n)
  process_emphasis(il, delims, 0)

  // Walk the linked list once and emit flat Events
  let mut cur = il.head
  let mut in_link = 0
  while cur >= 0 {
    let node = il.nodes[cur]
    match node.kind {
      InlineKind::Text(t) => emit_text_with_autolinks(events, t, opts, in_link)
      InlineKind::Code(c) => events.push(Event::Code(c))
      InlineKind::InlineHtml(h) => events.push(Event::InlineHtml(h))
      InlineKind::SoftBreak => events.push(Event::SoftBreak)
      InlineKind::HardBreak => events.push(Event::HardBreak)
      InlineKind::StartTag(tag) => {
        match tag {
          Tag::Link(_, _, _, _) => in_link = in_link + 1
          _ => ()
        }
        events.push(Event::Start(tag))
      }
      InlineKind::EndTag(te) => {
        match te {
          TagEnd::Link => if in_link > 0 { in_link = in_link - 1 }
          _ => ()
        }
        events.push(Event::End(te))
      }
      InlineKind::DelimText(ch, cnt) => {
        if cnt > 0 {
          events.push(Event::Text(repeat_byte(ch, cnt)))
        }
      }
      InlineKind::BracketText(is_img) => {
        events.push(Event::Text(if is_img { "![" } else { "[" }))
      }
      InlineKind::Removed => ()
    }
    cur = node.next
  }
}

///| Join paragraph/heading lines with `\n`, trimming trailing spaces/tabs on the final line.
fn join_para_lines(lines : Array[String]) -> String {
  let n = lines.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let line = lines[i]
    if i > 0 {
      sb.write_byte((10).to_byte())
    }
    if i + 1 == n {
      let mut e = line.length()
      while e > 0 && (line.code_unit_at(e - 1) == 32 || line.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
      sb.write_string(line.slice(0, e))
    } else {
      sb.write_string(line)
    }
    i = i + 1
  }
  sb.to_string()
}

///| Join code/HTML lines, each terminated with `\n`.
fn join_block_lines_nl(lines : Array[String]) -> String {
  let n = lines.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(lines[i])
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Recursively emit `Event`s for block node `idx` into `events`.
fn emit_block_events(
  doc : BlockDoc,
  idx : Int,
  opts : Options,
  in_tight_list : Bool,
  events : Array[Event],
) -> Unit {
  let node = doc.nodes[idx]
  match node.kind {
    BlockKind::Document => {
      let mut i = 0
      while i < node.children.length() {
        emit_block_events(doc, node.children[i], opts, false, events)
        i = i + 1
      }
    }
    BlockKind::Empty => ()
    BlockKind::BlockQuote => {
      events.push(Event::Start(Tag::BlockQuote))
      let mut i = 0
      while i < node.children.length() {
        emit_block_events(doc, node.children[i], opts, false, events)
        i = i + 1
      }
      events.push(Event::End(TagEnd::BlockQuote))
    }
    BlockKind::List(ordered, _delim, start_num) => {
      let list_tag = if ordered { Tag::List(Some(start_num)) } else { Tag::List(None) }
      events.push(Event::Start(list_tag))
      let mut i = 0
      while i < node.children.length() {
        emit_block_events(doc, node.children[i], opts, node.tight, events)
        i = i + 1
      }
      events.push(Event::End(TagEnd::List(ordered)))
    }
    BlockKind::Item(_) => {
      events.push(Event::Start(Tag::Item))
      match node.task_checked {
        Some(checked) => {
          if !in_tight_list && node.children.length() > 0 {
            match doc.nodes[node.children[0]].kind {
              BlockKind::Paragraph => {
                // In loose list, checkbox goes inside <p>
                let p = doc.nodes[node.children[0]]
                events.push(Event::Start(Tag::Paragraph))
                events.push(Event::TaskListMarker(checked))
                let text = join_para_lines(p.lines)
                parse_inlines(text, doc.ref_defs, opts, events)
                events.push(Event::End(TagEnd::Paragraph))
                let mut i = 1
                while i < node.children.length() {
                  emit_block_events(doc, node.children[i], opts, in_tight_list, events)
                  i = i + 1
                }
                events.push(Event::End(TagEnd::Item))
                return ()
              }
              _ => events.push(Event::TaskListMarker(checked))
            }
          } else {
            events.push(Event::TaskListMarker(checked))
          }
        }
        None => ()
      }
      let mut i = 0
      while i < node.children.length() {
        emit_block_events(doc, node.children[i], opts, in_tight_list, events)
        i = i + 1
      }
      events.push(Event::End(TagEnd::Item))
    }
    BlockKind::Paragraph => {
      let text = join_para_lines(node.lines)
      if in_tight_list {
        parse_inlines(text, doc.ref_defs, opts, events)
      } else {
        events.push(Event::Start(Tag::Paragraph))
        parse_inlines(text, doc.ref_defs, opts, events)
        events.push(Event::End(TagEnd::Paragraph))
      }
    }
    BlockKind::Heading(level) => {
      events.push(Event::Start(Tag::Heading(level)))
      let text = join_para_lines(node.lines)
      parse_inlines(text, doc.ref_defs, opts, events)
      events.push(Event::End(TagEnd::Heading(level)))
    }
    BlockKind::IndentedCode => {
      events.push(Event::Start(Tag::CodeBlock(CodeBlockKind::Indented)))
      let code = join_block_lines_nl(node.lines)
      if code.length() > 0 {
        events.push(Event::Text(code))
      }
      events.push(Event::End(TagEnd::CodeBlock))
    }
    BlockKind::FencedCode(_, _, _, info) => {
      events.push(Event::Start(Tag::CodeBlock(CodeBlockKind::Fenced(info))))
      let code = join_block_lines_nl(node.lines)
      if code.length() > 0 {
        events.push(Event::Text(code))
      }
      events.push(Event::End(TagEnd::CodeBlock))
    }
    BlockKind::HtmlBlock(_) => {
      events.push(Event::Start(Tag::HtmlBlock))
      let html = join_block_lines_nl(node.lines)
      if html.length() > 0 {
        events.push(Event::Html(html))
      }
      events.push(Event::End(TagEnd::HtmlBlock))
    }
    BlockKind::ThematicBreak => {
      events.push(Event::Rule)
    }
    BlockKind::Table(aligns, header, rows) => {
      events.push(Event::Start(Tag::Table(aligns)))
      events.push(Event::Start(Tag::TableHead))
      let mut hi = 0
      while hi < header.length() {
        events.push(Event::Start(Tag::TableCell))
        parse_inlines(header[hi], doc.ref_defs, opts, events)
        events.push(Event::End(TagEnd::TableCell))
        hi = hi + 1
      }
      events.push(Event::End(TagEnd::TableHead))
      let mut ri = 0
      while ri < rows.length() {
        let row = rows[ri]
        events.push(Event::Start(Tag::TableRow))
        let mut ci = 0
        while ci < row.length() {
          events.push(Event::Start(Tag::TableCell))
          parse_inlines(row[ci], doc.ref_defs, opts, events)
          events.push(Event::End(TagEnd::TableCell))
          ci = ci + 1
        }
        events.push(Event::End(TagEnd::TableRow))
        ri = ri + 1
      }
      events.push(Event::End(TagEnd::Table))
    }
  }
}

///| Top-level entry point: parse Markdown string into flat `Array[Event]`.
pub fn parse_events(src : String, opts : Options) -> Array[Event] {
  let doc = parse_blocks(src, opts)
  let events : Array[Event] = Array::new()
  emit_block_events(doc, 0, opts, false, events)
  events
}
