///| Pure Pion CommonMark 0.31.2 + GFM + CJK-friendly Markdown parser and HTML renderer.
///| Idiomatic port of Rust `pulldown-cmark`.

///|
pub val struct Options {
  pub tables : Bool
  pub strikethrough : Bool
  pub tasklists : Bool
  pub autolinks : Bool
  pub smart_punctuation : Bool
  pub cjk_friendly : Bool
}

///|
pub fn Options::commonmark() -> Options {
  Options::{
    tables: false,
    strikethrough: false,
    tasklists: false,
    autolinks: false,
    smart_punctuation: false,
    cjk_friendly: false,
  }
}

///|
pub fn Options::gfm() -> Options {
  Options::{
    tables: true,
    strikethrough: true,
    tasklists: true,
    autolinks: true,
    smart_punctuation: false,
    cjk_friendly: false,
  }
}

///|
pub enum Alignment {
  None
  Left
  Center
  Right
}

///|
pub enum CodeBlockKind {
  Indented
  Fenced(String)
}

///|
pub enum LinkType {
  Inline
  Reference
  ReferenceUnknown
  Collapsed
  CollapsedUnknown
  Shortcut
  ShortcutUnknown
  Autolink
  Email
}

///|
pub enum Tag {
  Paragraph
  Heading(Int)
  BlockQuote
  CodeBlock(CodeBlockKind)
  HtmlBlock
  List(Option[Int])
  Item
  Table(Array[Alignment])
  TableHead
  TableRow
  TableCell
  Emphasis
  Strong
  Strikethrough
  Link(LinkType, String, String, String)
  Image(LinkType, String, String, String)
}

///|
pub enum TagEnd {
  Paragraph
  Heading(Int)
  BlockQuote
  CodeBlock
  HtmlBlock
  List(Bool)
  Item
  Table
  TableHead
  TableRow
  TableCell
  Emphasis
  Strong
  Strikethrough
  Link
  Image
}

///|
pub enum Event {
  Start(Tag)
  End(TagEnd)
  Text(String)
  Code(String)
  Html(String)
  InlineHtml(String)
  SoftBreak
  HardBreak
  Rule
  TaskListMarker(Bool)
}

///|
pub fn parse(src : String, opts : Options) -> Array[Event] {
  let _ = src
  let _ = opts
  Array::new()
}

///|
pub fn render_html(events : Array[Event]) -> String {
  let _ = events
  ""
}

///|
pub fn to_html(src : String, opts : Options) -> String {
  render_html(parse(src, opts))
}
