///| Pure Pion CommonMark 0.31.2 + GFM + CJK-friendly Markdown parser and HTML renderer.
///| Idiomatic port of Rust `pulldown-cmark`.

///|
pub val struct Options {
  pub tables : Bool
  pub strikethrough : Bool
  pub tasklists : Bool
  pub autolinks : Bool
  pub smart_punctuation : Bool
  pub cjk_friendly : Bool
}

///|
pub fn Options::commonmark() -> Options {
  Options::{
    tables: false,
    strikethrough: false,
    tasklists: false,
    autolinks: false,
    smart_punctuation: false,
    cjk_friendly: false,
  }
}

///|
pub fn Options::gfm() -> Options {
  Options::{
    tables: true,
    strikethrough: true,
    tasklists: true,
    autolinks: true,
    smart_punctuation: false,
    cjk_friendly: false,
  }
}

///| Extended parsing options (additive over `Options`, keeping `Options` fields unchanged).
pub val struct ExtendedOptions {
  pub base : Options
  pub footnotes : Bool
  pub yaml_frontmatter : Bool
  pub pluses_frontmatter : Bool
}

///|
pub fn ExtendedOptions::from_options(base : Options) -> ExtendedOptions {
  ExtendedOptions::{
    base,
    footnotes: false,
    yaml_frontmatter: false,
    pluses_frontmatter: false,
  }
}

///|
pub fn ExtendedOptions::full() -> ExtendedOptions {
  ExtendedOptions::{
    base: Options::gfm(),
    footnotes: true,
    yaml_frontmatter: true,
    pluses_frontmatter: true,
  }
}

///|
pub enum MetadataBlockKind {
  YamlStyle
  PlusesStyle
}

///|
pub enum Alignment {
  None
  Left
  Center
  Right
}

///|
pub enum CodeBlockKind {
  Indented
  Fenced(String)
}

///|
pub enum LinkType {
  Inline
  Reference
  ReferenceUnknown
  Collapsed
  CollapsedUnknown
  Shortcut
  ShortcutUnknown
  Autolink
  Email
}

///|
pub enum Tag {
  Paragraph
  Heading(Int)
  BlockQuote
  CodeBlock(CodeBlockKind)
  HtmlBlock
  List(Option[Int])
  Item
  Table(Array[Alignment])
  TableHead
  TableRow
  TableCell
  Emphasis
  Strong
  Strikethrough
  Link(LinkType, String, String, String)
  Image(LinkType, String, String, String)
  FootnoteDefinition(String)
  MetadataBlock(MetadataBlockKind)
}

///|
pub enum TagEnd {
  Paragraph
  Heading(Int)
  BlockQuote
  CodeBlock
  HtmlBlock
  List(Bool)
  Item
  Table
  TableHead
  TableRow
  TableCell
  Emphasis
  Strong
  Strikethrough
  Link
  Image
  FootnoteDefinition
  MetadataBlock(MetadataBlockKind)
}

///|
pub enum Event {
  Start(Tag)
  End(TagEnd)
  Text(String)
  Code(String)
  Html(String)
  InlineHtml(String)
  SoftBreak
  HardBreak
  Rule
  TaskListMarker(Bool)
  FootnoteReference(String)
}

///| An `Event` paired with its byte range `[start, end)` in the source Markdown string.
pub struct OffsetEvent {
  pub event : Event
  pub start : Int
  pub end : Int
}

///|
pub fn parse(src : String, opts : Options) -> Array[Event] {
  parse_events(src, opts)
}

///| Parse Markdown into events with source byte offsets `[start, end)`.
pub fn parse_with_offsets(src : String, opts : Options) -> Array[OffsetEvent] {
  parse_events_with_offsets(src, opts)
}

///| Parse Markdown with extended features (footnotes, YAML/TOML frontmatter).
pub fn parse_extended(src : String, opts : ExtendedOptions) -> Array[Event] {
  parse_events_extended(src, opts)
}

///|
pub fn render_html(events : Array[Event]) -> String {
  render_html_events(events)
}

///|
pub fn render_html_pulldown(events : Array[Event]) -> String {
  render_html_pulldown_events(events)
}

///|
pub fn to_html(src : String, opts : Options) -> String {
  render_markdown_direct(src, opts, false)
}

///|
pub fn to_html_pulldown(src : String, opts : Options) -> String {
  render_markdown_direct(src, opts, true)
}

///| Render Markdown to HTML with extended features (footnotes, YAML/TOML frontmatter).
pub fn to_html_extended(src : String, opts : ExtendedOptions) -> String {
  render_html_events(parse_events_extended(src, opts))
}

///| Render Markdown to pulldown-compatible HTML with extended features (footnotes, YAML/TOML frontmatter).
pub fn to_html_pulldown_extended(src : String, opts : ExtendedOptions) -> String {
  render_html_pulldown_events(parse_events_extended(src, opts))
}
