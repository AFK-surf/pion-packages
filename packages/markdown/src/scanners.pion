///| Reusable mutable scratch buffer for zero-alloc scanner results.
pub struct ScanOut {
  pub mut a : Int
  pub mut b : Int
  pub mut c : Int
  pub mut d : Int
  pub mut e : Int
  pub mut flag : Bool
  pub mut s1 : String
}

///|
pub fn new_scan_out() -> ScanOut {
  ScanOut::{ a: 0, b: 0, c: 0, d: 0, e: 0, flag: false, s1: "" }
}

///| Zero-alloc ATX heading scanner writing `(level, content_start, content_end)` into `out.(a, b, c)`.
pub fn scan_atx_heading_into(s : String, start : Int, end : Int, out : ScanOut) -> Bool {
  let mut i = start
  while i < end && s.code_unit_at(i) == 35 && i - start < 7 {
    i = i + 1
  }
  let level = i - start
  if level == 0 || level > 6 {
    return false
  }
  if i < end && s.code_unit_at(i) != 32 && s.code_unit_at(i) != 9 {
    return false
  }
  while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
    i = i + 1
  }
  let mut e = end
  while e > i && (s.code_unit_at(e - 1) == 32 || s.code_unit_at(e - 1) == 9) {
    e = e - 1
  }
  let mut hash_end = e
  while hash_end > i && s.code_unit_at(hash_end - 1) == 35 {
    hash_end = hash_end - 1
  }
  if hash_end < e {
    if hash_end == i || s.code_unit_at(hash_end - 1) == 32 || s.code_unit_at(hash_end - 1) == 9 {
      e = hash_end
      while e > i && (s.code_unit_at(e - 1) == 32 || s.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
    }
  }
  out.a = level
  out.b = i
  out.c = e
  true
}

///| Zero-alloc list marker scanner writing into `out`:
///| `out.a` = ordered (0/1), `out.b` = delim, `out.c` = start_num,
///| `out.d` = marker_end, `out.e` = content_col, `out.flag` = is_empty_line.
pub fn scan_list_marker_into(
  s : String,
  start : Int,
  end : Int,
  col : Int,
  in_paragraph : Bool,
  out : ScanOut,
) -> Bool {
  if start >= end {
    return false
  }
  let b = s.code_unit_at(start)
  let mut ordered = 0
  let mut delim = 0
  let mut start_num = 0
  let mut after_marker = start

  if b == 45 || b == 43 || b == 42 {
    delim = b
    after_marker = start + 1
  } else if b >= 48 && b <= 57 {
    let mut i = start
    let mut num = 0
    while i < end && i - start < 9 {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        num = num * 10 + (c - 48)
        i = i + 1
      } else {
        break
      }
    }
    if i >= end {
      return false
    }
    let d = s.code_unit_at(i)
    if d != 46 && d != 41 {
      return false
    }
    if in_paragraph && num != 1 {
      return false
    }
    ordered = 1
    delim = d
    start_num = num
    after_marker = i + 1
  } else {
    return false
  }

  let col_after_marker = col + (after_marker - start)
  if after_marker == end {
    if in_paragraph {
      return false
    }
    out.a = ordered
    out.b = delim
    out.c = start_num
    out.d = after_marker
    out.e = col_after_marker + 1
    out.flag = true
    return true
  }
  let next_b = s.code_unit_at(after_marker)
  if next_b != 32 && next_b != 9 {
    return false
  }

  let mut i = after_marker
  let mut c = col_after_marker
  while i < end {
    let ch = s.code_unit_at(i)
    if ch == 32 {
      c = c + 1
      i = i + 1
    } else if ch == 9 {
      c = c + (4 - (c % 4))
      i = i + 1
    } else {
      break
    }
  }

  let is_empty = i == end
  if is_empty && in_paragraph {
    return false
  }
  let spaces = c - col_after_marker
  out.a = ordered
  out.b = delim
  out.c = start_num
  out.d = after_marker
  out.e = if is_empty || spaces >= 5 { col_after_marker + 1 } else { c }
  out.flag = is_empty
  true
}

///| Zero-alloc link label scanner: writes `(label_start, label_end, next_pos)` into `out.(a, b, c)`.
pub fn scan_link_label_into(s : String, start : Int, end : Int, out : ScanOut) -> Bool {
  if start >= end || s.code_unit_at(start) != 91 {
    return false
  }
  let mut i = start + 1
  let mut has_non_ws = false
  let mut chars = 0
  while i < end {
    let b = s.code_unit_at(i)
    if b == 93 {
      if has_non_ws {
        out.a = start + 1
        out.b = i
        out.c = i + 1
        return true
      }
      return false
    }
    if b == 91 {
      return false
    }
    if b == 92 && i + 1 < end {
      has_non_ws = true
      i = i + 2
      chars = chars + 2
    } else {
      if b != 32 && b != 9 && b != 10 && b != 12 && b != 13 {
        has_non_ws = true
      }
      i = i + 1
      chars = chars + 1
    }
    if chars > 999 {
      return false
    }
  }
  false
}

///| Zero-alloc link destination scanner: writes `out.s1 = unescaped_dest`, `out.a = next_pos`.
pub fn scan_link_dest_into(s : String, start : Int, end : Int, out : ScanOut) -> Bool {
  if start >= end {
    return false
  }
  if s.code_unit_at(start) == 60 {
    let mut i = start + 1
    let mut needs_unesc = false
    while i < end {
      let b = s.code_unit_at(i)
      if b == 62 {
        let raw = s.slice(start + 1, i)
        out.s1 = if needs_unesc { unescape_str(raw) } else { raw }
        out.a = i + 1
        return true
      }
      if b == 10 || b == 60 {
        return false
      }
      if b == 38 {
        needs_unesc = true
        i = i + 1
      } else if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
        needs_unesc = true
        i = i + 2
      } else {
        i = i + 1
      }
    }
    return false
  }
  let mut i = start
  let mut parens = 0
  let mut needs_unesc = false
  while i < end {
    let b = s.code_unit_at(i)
    if b <= 32 || b == 127 {
      break
    }
    if b == 38 {
      needs_unesc = true
      i = i + 1
    } else if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
      needs_unesc = true
      i = i + 2
    } else if b == 40 {
      parens = parens + 1
      if parens > 32 {
        return false
      }
      i = i + 1
    } else if b == 41 {
      if parens == 0 {
        break
      }
      parens = parens - 1
      i = i + 1
    } else {
      i = i + 1
    }
  }
  if parens != 0 || i == start {
    return false
  }
  let raw = s.slice(start, i)
  out.s1 = if needs_unesc { unescape_str(raw) } else { raw }
  out.a = i
  true
}

///| Zero-alloc link title scanner: writes `out.s1 = unescaped_title`, `out.a = next_pos`.
pub fn scan_link_title_into(s : String, start : Int, end : Int, out : ScanOut) -> Bool {
  if start >= end {
    return false
  }
  let open = s.code_unit_at(start)
  let close = if open == 34 {
    34
  } else if open == 39 {
    39
  } else if open == 40 {
    41
  } else {
    return false
  }
  let mut i = start + 1
  let mut prev_nl = false
  let mut needs_unesc = false
  while i < end {
    let b = s.code_unit_at(i)
    if b == close {
      let raw = s.slice(start + 1, i)
      out.s1 = if needs_unesc { unescape_str(raw) } else { raw }
      out.a = i + 1
      return true
    }
    if open == 40 && b == 40 {
      return false
    }
    if b == 38 {
      needs_unesc = true
      prev_nl = false
      i = i + 1
    } else if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
      needs_unesc = true
      prev_nl = false
      i = i + 2
    } else if b == 10 {
      if prev_nl {
        return false
      }
      prev_nl = true
      i = i + 1
      let mut k = i
      while k < end && (s.code_unit_at(k) == 32 || s.code_unit_at(k) == 9) {
        k = k + 1
      }
      if k < end && s.code_unit_at(k) == 10 {
        return false
      }
    } else {
      if b != 32 && b != 9 {
        prev_nl = false
      }
      i = i + 1
    }
  }
  false
}

///| Low-level byte-indexed Markdown scanners (CommonMark 0.31.2 + GFM).

///| Scan an HTML entity or numeric character reference starting at `&` (`s.code_unit_at(start) == 38`).
///| Returns `Some((decoded_string, next_pos))` or `None`.
pub fn scan_entity(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  if start + 2 >= end || s.code_unit_at(start) != 38 {
    return None
  }
  let b1 = s.code_unit_at(start + 1)
  if b1 == 35 {
    // Numeric character reference: &#...; or &#x...; / &#X...;
    if start + 3 >= end {
      return None
    }
    let b2 = s.code_unit_at(start + 2)
    if b2 == 120 || b2 == 88 {
      // Hex: 1..6 hex digits followed by ';'
      let mut i = start + 3
      let mut cp = 0
      let mut digits = 0
      while i < end && digits < 6 {
        let c = s.code_unit_at(i)
        if c >= 48 && c <= 57 {
          cp = (cp << 4) | (c - 48)
        } else if c >= 65 && c <= 70 {
          cp = (cp << 4) | (c - 55)
        } else if c >= 97 && c <= 102 {
          cp = (cp << 4) | (c - 87)
        } else {
          break
        }
        digits = digits + 1
        i = i + 1
      }
      if digits >= 1 && i < end && s.code_unit_at(i) == 59 {
        let sb = StringBuilder::new()
        write_utf8(sb, cp)
        return Some((sb.to_string(), i + 1))
      }
      return None
    } else {
      // Decimal: 1..7 digits followed by ';'
      let mut i = start + 2
      let mut cp = 0
      let mut digits = 0
      while i < end && digits < 7 {
        let c = s.code_unit_at(i)
        if c >= 48 && c <= 57 {
          cp = cp * 10 + (c - 48)
        } else {
          break
        }
        digits = digits + 1
        i = i + 1
      }
      if digits >= 1 && i < end && s.code_unit_at(i) == 59 {
        let sb = StringBuilder::new()
        write_utf8(sb, cp)
        return Some((sb.to_string(), i + 1))
      }
      return None
    }
  } else if is_ascii_alpha(b1) {
    // Named entity: ASCII letter followed by 1..31 ASCII alnum followed by ';'
    let mut i = start + 2
    let limit = if start + 33 < end { start + 33 } else { end }
    while i < limit && is_ascii_alnum(s.code_unit_at(i)) {
      i = i + 1
    }
    if i < end && s.code_unit_at(i) == 59 {
      let name = s.slice(start + 1, i)
      match lookup_entity(name) {
        Some(v) => return Some((v, i + 1))
        None => return None
      }
    }
    return None
  }
  None
}

///| Unescape CommonMark backslash ASCII punctuation escapes and HTML character references.
///| Zero-allocation fast path when `s` contains neither `\` nor `&`.
pub fn unescape_str(s : String) -> String {
  let n = s.length()
  let mut i = 0
  let mut needs = false
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 || b == 38 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  let mut mark = 0
  i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 && i + 1 < n && is_ascii_punct(s.code_unit_at(i + 1)) {
      if mark < i {
        sb.write_string(s.slice(mark, i))
      }
      sb.write_byte(s.code_unit_at(i + 1).to_byte())
      i = i + 2
      mark = i
    } else if b == 38 {
      match scan_entity(s, i, n) {
        Some((decoded, next_i)) => {
          if mark < i {
            sb.write_string(s.slice(mark, i))
          }
          sb.write_string(decoded)
          i = next_i
          mark = i
        }
        None => i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  if mark < n {
    sb.write_string(s.slice(mark, n))
  }
  sb.to_string()
}

///| Check if `s[start..end]` is a CommonMark thematic break (`***`, `---`, `___`).
pub fn scan_thematic_break(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let ch = s.code_unit_at(start)
  if ch != 42 && ch != 45 && ch != 95 {
    return false
  }
  let mut count = 0
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == ch {
      count = count + 1
    } else if b != 32 && b != 9 {
      return false
    }
    i = i + 1
  }
  count >= 3
}

///| Scan an ATX heading in `s[start..end]`. Returns `Some((level, content_start, content_end))`.
pub fn scan_atx_heading(s : String, start : Int, end : Int) -> Option[(Int, Int, Int)] {
  let mut i = start
  while i < end && s.code_unit_at(i) == 35 && i - start < 7 {
    i = i + 1
  }
  let level = i - start
  if level == 0 || level > 6 {
    return None
  }
  if i < end && s.code_unit_at(i) != 32 && s.code_unit_at(i) != 9 {
    return None
  }
  // Skip leading spaces/tabs after `#`
  while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
    i = i + 1
  }
  // Trim trailing spaces/tabs
  let mut e = end
  while e > i && (s.code_unit_at(e - 1) == 32 || s.code_unit_at(e - 1) == 9) {
    e = e - 1
  }
  // Optional closing sequence of `#` preceded by space/tab (or at start of content)
  let mut hash_end = e
  while hash_end > i && s.code_unit_at(hash_end - 1) == 35 {
    hash_end = hash_end - 1
  }
  if hash_end < e {
    if hash_end == i || s.code_unit_at(hash_end - 1) == 32 || s.code_unit_at(hash_end - 1) == 9 {
      e = hash_end
      while e > i && (s.code_unit_at(e - 1) == 32 || s.code_unit_at(e - 1) == 9) {
        e = e - 1
      }
    }
  }
  Some((level, i, e))
}

///| Scan a Setext heading underline in `s[start..end]`. Returns `Some(1)` for `=`, `Some(2)` for `-`.
pub fn scan_setext_underline(s : String, start : Int, end : Int) -> Option[Int] {
  if start >= end {
    return None
  }
  let ch = s.code_unit_at(start)
  if ch != 61 && ch != 45 {
    return None
  }
  let mut i = start
  while i < end && s.code_unit_at(i) == ch {
    i = i + 1
  }
  while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
    i = i + 1
  }
  if i == end {
    if ch == 61 { Some(1) } else { Some(2) }
  } else {
    None
  }
}

///| Scan an opening code fence in `s[start..end]`. Returns `Some((fence_char, fence_len, info))`.
pub fn scan_code_fence_open(s : String, start : Int, end : Int) -> Option[(Int, Int, String)] {
  if start >= end {
    return None
  }
  let ch = s.code_unit_at(start)
  if ch != 96 && ch != 126 {
    return None
  }
  let mut i = start
  while i < end && s.code_unit_at(i) == ch {
    i = i + 1
  }
  let flen = i - start
  if flen < 3 {
    return None
  }
  // For backtick fences, info string cannot contain backticks
  if ch == 96 {
    let mut j = i
    while j < end {
      if s.code_unit_at(j) == 96 {
        return None
      }
      j = j + 1
    }
  }
  // Trim leading and trailing spaces/tabs from info string
  let mut a = i
  while a < end && (s.code_unit_at(a) == 32 || s.code_unit_at(a) == 9) {
    a = a + 1
  }
  let mut b = end
  while b > a && (s.code_unit_at(b - 1) == 32 || s.code_unit_at(b - 1) == 9) {
    b = b - 1
  }
  let info = if a < b { unescape_str(s.slice(a, b)) } else { "" }
  Some((ch, flen, info))
}

///| Scan a closing code fence in `s[start..end]`.
pub fn scan_code_fence_close(
  s : String,
  start : Int,
  end : Int,
  fence_char : Int,
  fence_len : Int,
) -> Bool {
  let mut i = start
  while i < end && s.code_unit_at(i) == fence_char {
    i = i + 1
  }
  if i - start < fence_len {
    return false
  }
  while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
    i = i + 1
  }
  i == end
}

///| Case-insensitive ASCII prefix match of `s[pos..end]` against lowercase `lit`.
fn starts_with_ci(s : String, pos : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if pos + n > end {
    return false
  }
  let mut i = 0
  while i < n {
    let mut b = s.code_unit_at(pos + i)
    if b >= 65 && b <= 90 {
      b = b + 32
    }
    if b != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Exact ASCII prefix match of `s[pos..end]` against `lit`.
pub fn starts_with_lit(s : String, pos : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if pos + n > end {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(pos + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Case-insensitive ASCII substring search in `s[start..end]` for lowercase `needle`.
fn contains_ci(s : String, start : Int, end : Int, needle : String) -> Bool {
  let n = needle.length()
  if n == 0 || end - start < n {
    return false
  }
  let mut i = start
  while i + n <= end {
    if starts_with_ci(s, i, end, needle) {
      return true
    }
    i = i + 1
  }
  false
}

///| Exact ASCII substring search in `s[start..end]` for `needle`.
fn contains_lit(s : String, start : Int, end : Int, needle : String) -> Bool {
  let n = needle.length()
  if n == 0 || end - start < n {
    return false
  }
  let mut i = start
  while i + n <= end {
    if starts_with_lit(s, i, end, needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn to_ascii_lower_str(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Check if lowercase tag name is a CommonMark HTML Block Type 6 tag.
fn is_html_block_type6_tag(tag : String) -> Bool {
  match tag {
    "address" | "article" | "aside" | "base" | "basefont" | "blockquote" | "body" | "caption" | "center" | "col" | "colgroup" | "dd" | "details" | "dialog" | "dir" | "div" | "dl" | "dt" | "fieldset" | "figcaption" | "figure" | "footer" | "form" | "frame" | "frameset" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "head" | "header" | "hr" | "html" | "iframe" | "legend" | "li" | "link" | "main" | "menu" | "menuitem" | "nav" | "noframes" | "ol" | "optgroup" | "option" | "p" | "param" | "search" | "section" | "summary" | "table" | "tbody" | "td" | "tfoot" | "th" | "thead" | "title" | "tr" | "track" | "ul" => true
    _ => false
  }
}

///| Scan an HTML open tag starting at `<` (`s[start] == '<'`). Returns end offset or 0.
pub fn scan_html_open_tag(s : String, start : Int, end : Int) -> Int {
  if start + 2 >= end || s.code_unit_at(start) != 60 {
    return 0
  }
  let mut i = start + 1
  if !is_ascii_alpha(s.code_unit_at(i)) {
    return 0
  }
  i = i + 1
  while i < end {
    let b = s.code_unit_at(i)
    if is_ascii_alnum(b) || b == 45 {
      i = i + 1
    } else {
      break
    }
  }
  // Attributes
  while i < end {
    let ws_start = i
    while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 10) {
      i = i + 1
    }
    if i >= end {
      return 0
    }
    let b = s.code_unit_at(i)
    if b == 62 {
      return i + 1
    }
    if b == 47 {
      if i + 1 < end && s.code_unit_at(i + 1) == 62 {
        return i + 2
      }
      return 0
    }
    if i == ws_start {
      return 0
    }
    // Attribute name: [A-Za-z_:] [A-Za-z0-9_.:-]*
    if !(is_ascii_alpha(b) || b == 95 || b == 58) {
      return 0
    }
    i = i + 1
    while i < end {
      let c = s.code_unit_at(i)
      if is_ascii_alnum(c) || c == 95 || c == 46 || c == 58 || c == 45 {
        i = i + 1
      } else {
        break
      }
    }
    // Optional attribute value specification
    let after_name = i
    while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 10) {
      i = i + 1
    }
    if i < end && s.code_unit_at(i) == 61 {
      i = i + 1
      while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 10) {
        i = i + 1
      }
      if i >= end {
        return 0
      }
      let q = s.code_unit_at(i)
      if q == 34 || q == 39 {
        i = i + 1
        while i < end && s.code_unit_at(i) != q {
          i = i + 1
        }
        if i >= end {
          return 0
        }
        i = i + 1
      } else {
        // Unquoted attribute value: 1+ chars not ws, ", ', =, <, >, `
        let vstart = i
        while i < end {
          let c = s.code_unit_at(i)
          if c == 32 || c == 9 || c == 10 || c == 34 || c == 39 || c == 61 || c == 60 || c == 62 || c == 96 {
            break
          }
          i = i + 1
        }
        if i == vstart {
          return 0
        }
      }
    } else {
      i = after_name
    }
  }
  0
}

///| Scan an HTML closing tag starting at `</`. Returns end offset or 0.
pub fn scan_html_close_tag(s : String, start : Int, end : Int) -> Int {
  if start + 3 >= end || s.code_unit_at(start) != 60 || s.code_unit_at(start + 1) != 47 {
    return 0
  }
  let mut i = start + 2
  if !is_ascii_alpha(s.code_unit_at(i)) {
    return 0
  }
  i = i + 1
  while i < end {
    let b = s.code_unit_at(i)
    if is_ascii_alnum(b) || b == 45 {
      i = i + 1
    } else {
      break
    }
  }
  while i < end && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 10) {
    i = i + 1
  }
  if i < end && s.code_unit_at(i) == 62 {
    i + 1
  } else {
    0
  }
}

///| Detect CommonMark HTML block start (types 1..7) on `s[start..end]`. Returns 0 if none.
pub fn scan_html_block_start(s : String, start : Int, end : Int, in_paragraph : Bool) -> Int {
  if start + 1 >= end || s.code_unit_at(start) != 60 {
    return 0
  }
  // Type 2: <!--
  if starts_with_lit(s, start, end, "<!--") {
    return 2
  }
  // Type 3: <?
  if starts_with_lit(s, start, end, "<?") {
    return 3
  }
  // Type 5: <![CDATA[
  if starts_with_lit(s, start, end, "<![CDATA[") {
    return 5
  }
  // Type 4: <! followed by ASCII letter
  if start + 2 < end && s.code_unit_at(start + 1) == 33 && is_ascii_alpha(s.code_unit_at(start + 2)) {
    return 4
  }
  // Type 1: <pre, <script, <style, <textarea followed by ws, >, or EOL
  let b1 = s.code_unit_at(start + 1)
  if is_ascii_alpha(b1) {
    let mut i = start + 1
    while i < end && is_ascii_alpha(s.code_unit_at(i)) {
      i = i + 1
    }
    let tag_lower = to_ascii_lower_str(s.slice(start + 1, i))
    if tag_lower == "pre" || tag_lower == "script" || tag_lower == "style" || tag_lower == "textarea" {
      if i == end || s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 62 {
        return 1
      }
    }
  }
  // Type 6: < or </ followed by type 6 tag name, followed by ws, EOL, >, or />
  let mut j = start + 1
  if j < end && s.code_unit_at(j) == 47 {
    j = j + 1
  }
  let name_start = j
  while j < end && is_ascii_alnum(s.code_unit_at(j)) {
    j = j + 1
  }
  if j > name_start {
    let tag_lower = to_ascii_lower_str(s.slice(name_start, j))
    if is_html_block_type6_tag(tag_lower) {
      if j == end || s.code_unit_at(j) == 32 || s.code_unit_at(j) == 9 || s.code_unit_at(j) == 62 ||
      (j + 1 < end && s.code_unit_at(j) == 47 && s.code_unit_at(j + 1) == 62) {
        return 6
      }
    }
  }
  // Type 7: complete open or close tag on a single line followed only by spaces/tabs (cannot interrupt paragraph)
  if !in_paragraph {
    let open_end = scan_html_open_tag(s, start, end)
    let close_end = if open_end > 0 { 0 } else { scan_html_close_tag(s, start, end) }
    let tag_end = if open_end > 0 { open_end } else { close_end }
    if tag_end > 0 {
      let mut k = tag_end
      while k < end && (s.code_unit_at(k) == 32 || s.code_unit_at(k) == 9) {
        k = k + 1
      }
      if k == end {
        return 7
      }
    }
  }
  0
}

///| Check if `s[start..end]` contains the closing condition for HTML block types 1..5.
pub fn scan_html_block_end(s : String, start : Int, end : Int, kind : Int) -> Bool {
  match kind {
    1 => contains_ci(s, start, end, "</pre>") ||
    contains_ci(s, start, end, "</script>") ||
    contains_ci(s, start, end, "</style>") ||
    contains_ci(s, start, end, "</textarea>")
    2 => contains_lit(s, start, end, "-->")
    3 => contains_lit(s, start, end, "?>")
    4 => contains_lit(s, start, end, ">")
    5 => contains_lit(s, start, end, "]]>")
    _ => false
  }
}

///| Parsed list item marker info.
pub val struct ListMarker {
  pub ordered : Bool
  pub delim : Int
  pub start_num : Int
  pub marker_end : Int
  pub content_col : Int
  pub is_empty_line : Bool
}

///| Scan a list marker at `s[start..end]` starting at visual column `col`.
pub fn scan_list_marker(
  s : String,
  start : Int,
  end : Int,
  col : Int,
  in_paragraph : Bool,
) -> Option[ListMarker] {
  if start >= end {
    return None
  }
  let b = s.code_unit_at(start)
  let mut ordered = false
  let mut delim = 0
  let mut start_num = 0
  let mut after_marker = start

  if b == 45 || b == 43 || b == 42 {
    // Unordered: -, +, *
    delim = b
    after_marker = start + 1
  } else if is_ascii_digit(b) {
    // Ordered: 1..9 digits followed by '.' or ')'
    let mut i = start
    let mut num = 0
    while i < end && is_ascii_digit(s.code_unit_at(i)) && i - start < 9 {
      num = num * 10 + (s.code_unit_at(i) - 48)
      i = i + 1
    }
    if i >= end {
      return None
    }
    let d = s.code_unit_at(i)
    if d != 46 && d != 41 {
      return None
    }
    if in_paragraph && num != 1 {
      return None
    }
    ordered = true
    delim = d
    start_num = num
    after_marker = i + 1
  } else {
    return None
  }

  let marker_width = after_marker - start
  let col_after_marker = col + marker_width

  // Must be followed by EOL or space/tab
  if after_marker == end {
    if in_paragraph {
      return None
    }
    return Some(ListMarker::{
      ordered,
      delim,
      start_num,
      marker_end: after_marker,
      content_col: col_after_marker + 1,
      is_empty_line: true,
    })
  }
  let next_b = s.code_unit_at(after_marker)
  if next_b != 32 && next_b != 9 {
    return None
  }

  // Count spaces/tabs after marker (with tab stops of 4)
  let mut i = after_marker
  let mut c = col_after_marker
  while i < end {
    let ch = s.code_unit_at(i)
    if ch == 32 {
      c = c + 1
      i = i + 1
    } else if ch == 9 {
      c = c + (4 - (c % 4))
      i = i + 1
    } else {
      break
    }
  }

  let is_empty = i == end
  if is_empty && in_paragraph {
    return None
  }

  let spaces = c - col_after_marker
  let content_col = if is_empty || spaces >= 5 {
    col_after_marker + 1
  } else {
    c
  }

  Some(ListMarker::{
    ordered,
    delim,
    start_num,
    marker_end: after_marker,
    content_col,
    is_empty_line: is_empty,
  })
}

///| Scan an inline HTML construct starting at `<`, caching failed scans to EOF in `fail_pos` (4 slots:
///| 0 = `<!--`, 1 = `<?`, 2 = `<![CDATA[`, 3 = `<!A`) to guarantee O(N) on unclosed constructs.
pub fn scan_inline_html_cached(s : String, start : Int, end : Int, fail_pos : Array[Int]) -> Int {
  if start + 2 >= end || s.code_unit_at(start) != 60 {
    return 0
  }
  let b1 = s.code_unit_at(start + 1)
  if is_ascii_alpha(b1) {
    return scan_html_open_tag(s, start, end)
  }
  if b1 == 47 {
    return scan_html_close_tag(s, start, end)
  }
  if b1 == 63 {
    if fail_pos[1] >= end {
      return 0
    }
    let mut i = start + 2
    while i + 1 < end {
      if s.code_unit_at(i) == 63 && s.code_unit_at(i + 1) == 62 {
        return i + 2
      }
      i = i + 1
    }
    fail_pos[1] = end
    return 0
  }
  if b1 == 33 {
    if starts_with_lit(s, start, end, "<!--") {
      if starts_with_lit(s, start, end, "<!-->") {
        return start + 5
      }
      if starts_with_lit(s, start, end, "<!--->") {
        return start + 6
      }
      if fail_pos[0] >= end {
        return 0
      }
      let mut i = start + 4
      while i + 2 < end {
        if s.code_unit_at(i) == 45 && s.code_unit_at(i + 1) == 45 && s.code_unit_at(i + 2) == 62 {
          return i + 3
        }
        i = i + 1
      }
      fail_pos[0] = end
      return 0
    }
    if starts_with_lit(s, start, end, "<![CDATA[") {
      if fail_pos[2] >= end {
        return 0
      }
      let mut i = start + 9
      while i + 2 < end {
        if s.code_unit_at(i) == 93 && s.code_unit_at(i + 1) == 93 && s.code_unit_at(i + 2) == 62 {
          return i + 3
        }
        i = i + 1
      }
      fail_pos[2] = end
      return 0
    }
    if start + 2 < end && is_ascii_alpha(s.code_unit_at(start + 2)) {
      if fail_pos[3] >= end {
        return 0
      }
      let mut i = start + 3
      while i < end && s.code_unit_at(i) != 62 {
        i = i + 1
      }
      if i < end && s.code_unit_at(i) == 62 {
        return i + 1
      }
      fail_pos[3] = end
    }
  }
  0
}

///| Scan an inline HTML construct starting at `<`. Returns end offset or 0.
pub fn scan_inline_html(s : String, start : Int, end : Int) -> Int {
  if start + 2 >= end || s.code_unit_at(start) != 60 {
    return 0
  }
  let b1 = s.code_unit_at(start + 1)
  if is_ascii_alpha(b1) {
    return scan_html_open_tag(s, start, end)
  }
  if b1 == 47 {
    return scan_html_close_tag(s, start, end)
  }
  if b1 == 63 {
    // Processing instruction: <? ... ?>
    let mut i = start + 2
    while i + 1 < end {
      if s.code_unit_at(i) == 63 && s.code_unit_at(i + 1) == 62 {
        return i + 2
      }
      i = i + 1
    }
    return 0
  }
  if b1 == 33 {
    // Comment: <!-- ... --> (CommonMark 0.31.2 rules)
    if starts_with_lit(s, start, end, "<!--") {
      if starts_with_lit(s, start, end, "<!-->") {
        return start + 5
      }
      if starts_with_lit(s, start, end, "<!--->") {
        return start + 6
      }
      let mut i = start + 4
      while i + 2 < end {
        if s.code_unit_at(i) == 45 && s.code_unit_at(i + 1) == 45 && s.code_unit_at(i + 2) == 62 {
          return i + 3
        }
        i = i + 1
      }
      return 0
    }
    // CDATA: <![CDATA[ ... ]]>
    if starts_with_lit(s, start, end, "<![CDATA[") {
      let mut i = start + 9
      while i + 2 < end {
        if s.code_unit_at(i) == 93 && s.code_unit_at(i + 1) == 93 && s.code_unit_at(i + 2) == 62 {
          return i + 3
        }
        i = i + 1
      }
      return 0
    }
    // Declaration: <! followed by ASCII letter, then non-> chars, then >
    if start + 2 < end && is_ascii_alpha(s.code_unit_at(start + 2)) {
      let mut i = start + 3
      while i < end && s.code_unit_at(i) != 62 {
        i = i + 1
      }
      if i < end && s.code_unit_at(i) == 62 {
        return i + 1
      }
    }
  }
  0
}

///| Scan a CommonMark autolink `<uri>` or `<email>` starting at `<`.
///| Returns `Some((is_email, inner_str, next_pos))`.
pub fn scan_autolink(s : String, start : Int, end : Int) -> Option[(Bool, String, Int)] {
  if start + 3 >= end || s.code_unit_at(start) != 60 {
    return None
  }
  // Find closing '>' without spaces, newlines, or '<'
  let mut i = start + 1
  while i < end {
    let b = s.code_unit_at(i)
    if b == 62 {
      break
    }
    if b <= 32 || b == 60 {
      return None
    }
    i = i + 1
  }
  if i >= end || s.code_unit_at(i) != 62 {
    return None
  }
  let inner_start = start + 1
  let inner_end = i
  // Check URI autolink: scheme (2..32 chars: alpha + [alnum + . -]) followed by ':'
  if is_ascii_alpha(s.code_unit_at(inner_start)) {
    let mut j = inner_start + 1
    while j < inner_end {
      let c = s.code_unit_at(j)
      if is_ascii_alnum(c) || c == 43 || c == 45 || c == 46 {
        j = j + 1
      } else {
        break
      }
    }
    let slen = j - inner_start
    if slen >= 2 && slen <= 32 && j < inner_end && s.code_unit_at(j) == 58 {
      return Some((false, s.slice(inner_start, inner_end), inner_end + 1))
    }
  }
  // Check email autolink: local@domain
  let mut at_pos = -1
  let mut j = inner_start
  while j < inner_end {
    let c = s.code_unit_at(j)
    if c == 64 {
      if at_pos >= 0 {
        return None
      }
      at_pos = j
    }
    j = j + 1
  }
  if at_pos <= inner_start || at_pos + 1 >= inner_end {
    return None
  }
  // Validate local part: [a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+
  j = inner_start
  while j < at_pos {
    let c = s.code_unit_at(j)
    let ok = is_ascii_alnum(c) || c == 46 || c == 33 || c == 35 || c == 36 ||
    c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 47 ||
    c == 61 || c == 63 || c == 94 || c == 95 || c == 96 || c == 123 ||
    c == 124 || c == 125 || c == 126 || c == 45
    if !ok {
      return None
    }
    j = j + 1
  }
  // Validate domain part: labels of 1..63 [a-zA-Z0-9-], not starting/ending with '-'
  j = at_pos + 1
  while j < inner_end {
    let lstart = j
    if !is_ascii_alnum(s.code_unit_at(j)) {
      return None
    }
    while j < inner_end && s.code_unit_at(j) != 46 {
      let c = s.code_unit_at(j)
      if !(is_ascii_alnum(c) || c == 45) {
        return None
      }
      j = j + 1
    }
    let llen = j - lstart
    if llen == 0 || llen > 63 || s.code_unit_at(j - 1) == 45 {
      return None
    }
    if j < inner_end && s.code_unit_at(j) == 46 {
      j = j + 1
      if j == inner_end {
        return None
      }
    }
  }
  Some((true, s.slice(inner_start, inner_end), inner_end + 1))
}

///| Scan a link label `[label]` starting at `[`. Returns `Some((raw_label, next_pos))`.
pub fn scan_link_label(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  if start >= end || s.code_unit_at(start) != 91 {
    return None
  }
  let mut i = start + 1
  let mut has_non_ws = false
  let mut chars = 0
  while i < end {
    let b = s.code_unit_at(i)
    if b == 93 {
      if has_non_ws {
        return Some((s.slice(start + 1, i), i + 1))
      }
      return None
    }
    if b == 91 {
      return None
    }
    if b == 92 && i + 1 < end {
      has_non_ws = true
      i = i + 2
      chars = chars + 2
    } else {
      if !is_ascii_ws(b) {
        has_non_ws = true
      }
      i = i + 1
      chars = chars + 1
    }
    if chars > 999 {
      return None
    }
  }
  None
}

///| Scan a link destination (either `<...>` or balanced-parens bare URL).
///| Returns `Some((unescaped_dest, next_pos))`.
pub fn scan_link_dest(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  if start >= end {
    return None
  }
  if s.code_unit_at(start) == 60 {
    // Pointy-bracket destination: no unescaped <, >, or newline
    let mut i = start + 1
    while i < end {
      let b = s.code_unit_at(i)
      if b == 62 {
        return Some((unescape_str(s.slice(start + 1, i)), i + 1))
      }
      if b == 10 || b == 60 {
        return None
      }
      if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
        i = i + 2
      } else {
        i = i + 1
      }
    }
    return None
  }
  // Bare destination: no ASCII control chars or spaces, balanced unescaped parens (depth <= 32)
  let mut i = start
  let mut parens = 0
  while i < end {
    let b = s.code_unit_at(i)
    if b <= 32 || b == 127 {
      break
    }
    if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
      i = i + 2
    } else if b == 40 {
      parens = parens + 1
      if parens > 32 {
        return None
      }
      i = i + 1
    } else if b == 41 {
      if parens == 0 {
        break
      }
      parens = parens - 1
      i = i + 1
    } else {
      i = i + 1
    }
  }
  if parens != 0 || i == start {
    return None
  }
  Some((unescape_str(s.slice(start, i)), i))
}

///| Scan a link title (`"..."`, `'...'`, or `(...)`), rejecting blank lines inside.
///| Returns `Some((unescaped_title, next_pos))`.
pub fn scan_link_title(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  if start >= end {
    return None
  }
  let open = s.code_unit_at(start)
  let close = if open == 34 {
    34
  } else if open == 39 {
    39
  } else if open == 40 {
    41
  } else {
    return None
  }
  let mut i = start + 1
  let mut prev_nl = false
  while i < end {
    let b = s.code_unit_at(i)
    if b == close {
      return Some((unescape_str(s.slice(start + 1, i)), i + 1))
    }
    if open == 40 && b == 40 {
      return None
    }
    if b == 92 && i + 1 < end && is_ascii_punct(s.code_unit_at(i + 1)) {
      prev_nl = false
      i = i + 2
    } else if b == 10 {
      if prev_nl {
        return None
      }
      prev_nl = true
      i = i + 1
      // Skip spaces/tabs on new line to detect blank line
      let mut k = i
      while k < end && (s.code_unit_at(k) == 32 || s.code_unit_at(k) == 9) {
        k = k + 1
      }
      if k < end && s.code_unit_at(k) == 10 {
        return None
      }
    } else {
      if b != 32 && b != 9 {
        prev_nl = false
      }
      i = i + 1
    }
  }
  None
}

///| Skip spaces/tabs and at most one newline. Returns `(new_pos, saw_newline)`.
fn skip_ws_one_nl(s : String, start : Int, end : Int) -> (Int, Bool) {
  let mut i = start
  let mut saw_nl = false
  while i < end {
    let b = s.code_unit_at(i)
    if b == 32 || b == 9 {
      i = i + 1
    } else if b == 10 && !saw_nl {
      saw_nl = true
      i = i + 1
    } else {
      break
    }
  }
  (i, saw_nl)
}

///| Scan a link reference definition at the beginning of paragraph buffer `s[start..end]`.
///| Returns `Some((norm_label, dest, title, next_pos))`.
pub fn scan_link_ref_def(
  s : String,
  start : Int,
  end : Int,
) -> Option[(String, String, String, Int)] {
  let mut i = start
  // Up to 3 leading spaces
  let mut sp = 0
  while i < end && s.code_unit_at(i) == 32 && sp < 3 {
    i = i + 1
    sp = sp + 1
  }
  let (raw_label, after_label) = match scan_link_label(s, i, end) {
    Some(x) => x
    None => return None
  }
  let norm_label = normalize_link_label(raw_label)
  if norm_label.length() == 0 {
    return None
  }
  i = after_label
  if i >= end || s.code_unit_at(i) != 58 {
    return None
  }
  i = i + 1
  let (after_colon_ws, _) = skip_ws_one_nl(s, i, end)
  i = after_colon_ws
  let (dest, after_dest) = match scan_link_dest(s, i, end) {
    Some(x) => x
    None => return None
  }
  i = after_dest
  // Check trailing spaces/tabs to EOL (fallback if title fails)
  let mut eol_no_title = i
  while eol_no_title < end && (s.code_unit_at(eol_no_title) == 32 || s.code_unit_at(eol_no_title) == 9) {
    eol_no_title = eol_no_title + 1
  }
  let can_end_without_title = eol_no_title == end || s.code_unit_at(eol_no_title) == 10
  let next_no_title = if eol_no_title < end && s.code_unit_at(eol_no_title) == 10 {
    eol_no_title + 1
  } else {
    eol_no_title
  }

  // Try optional title if separated by at least one ws/nl
  let (before_title, saw_nl_before_title) = skip_ws_one_nl(s, i, end)
  if before_title > i && before_title < end {
    match scan_link_title(s, before_title, end) {
      Some((title, after_title)) => {
        let mut j = after_title
        while j < end && (s.code_unit_at(j) == 32 || s.code_unit_at(j) == 9) {
          j = j + 1
        }
        if j == end || s.code_unit_at(j) == 10 {
          let next_with_title = if j < end && s.code_unit_at(j) == 10 { j + 1 } else { j }
          return Some((norm_label, dest, title, next_with_title))
        }
        // Title had trailing non-ws: only valid if title started on a new line, in which case we ignore title
        if saw_nl_before_title && can_end_without_title {
          return Some((norm_label, dest, "", next_no_title))
        }
        return None
      }
      None => ()
    }
  }
  if can_end_without_title {
    Some((norm_label, dest, "", next_no_title))
  } else {
    None
  }
}

///| Split a GFM table row into `LineSpan`s appended to `out` (handling escaped `\|` via `extra_strs`).
///| If `expected_cols > 0`, truncates or pads with empty spans to `expected_cols`.
///| Returns the number of cells parsed (before truncation/padding).
pub fn split_table_row_spans(
  s : String,
  start : Int,
  end : Int,
  out : Array[LineSpan],
  extra_strs : Array[String],
  expected_cols : Int,
) -> Int {
  let mut a = start
  let mut b = end
  while a < b && (s.code_unit_at(a) == 32 || s.code_unit_at(a) == 9) {
    a = a + 1
  }
  while b > a && (s.code_unit_at(b - 1) == 32 || s.code_unit_at(b - 1) == 9) {
    b = b - 1
  }
  if a >= b || (a + 1 == b && s.code_unit_at(a) == 124) {
    return 0
  }
  if a < b && s.code_unit_at(a) == 124 {
    a = a + 1
  }
  if b > a && s.code_unit_at(b - 1) == 124 && !(b - 2 >= a && s.code_unit_at(b - 2) == 92) {
    b = b - 1
  }
  let mut count = 0
  let mut cell_start = a
  let mut has_esc_pipe = false
  let mut i = a
  while i <= b {
    if i == b || s.code_unit_at(i) == 124 {
      if expected_cols <= 0 || count < expected_cols {
        let mut cs = cell_start
        let mut ce = i
        while cs < ce && (s.code_unit_at(cs) == 32 || s.code_unit_at(cs) == 9) {
          cs = cs + 1
        }
        while ce > cs && (s.code_unit_at(ce - 1) == 32 || s.code_unit_at(ce - 1) == 9) {
          ce = ce - 1
        }
        if !has_esc_pipe {
          out.push(LineSpan::{ start: cs, end: ce, pad: 0 })
        } else {
          let sb = StringBuilder::new()
          let mut j = cs
          while j < ce {
            if s.code_unit_at(j) == 92 && j + 1 < ce && s.code_unit_at(j + 1) == 124 {
              sb.write_byte((124).to_byte())
              j = j + 2
            } else {
              sb.write_byte(s.code_unit_at(j).to_byte())
              j = j + 1
            }
          }
          let sidx = extra_strs.length()
          extra_strs.push(sb.to_string())
          out.push(LineSpan::{ start: sidx, end: 0, pad: -1 })
        }
      }
      count = count + 1
      cell_start = i + 1
      has_esc_pipe = false
      i = i + 1
    } else if s.code_unit_at(i) == 92 && i + 1 < b && s.code_unit_at(i + 1) == 124 {
      has_esc_pipe = true
      i = i + 2
    } else {
      i = i + 1
    }
  }
  if expected_cols > 0 {
    let mut c = count
    while c < expected_cols {
      out.push(LineSpan::{ start: 0, end: 0, pad: 0 })
      c = c + 1
    }
  }
  count
}

///| Count cells in a GFM table row without allocating.
pub fn count_table_row_cells(s : String, start : Int, end : Int) -> Int {
  let mut a = start
  let mut b = end
  while a < b && (s.code_unit_at(a) == 32 || s.code_unit_at(a) == 9) {
    a = a + 1
  }
  while b > a && (s.code_unit_at(b - 1) == 32 || s.code_unit_at(b - 1) == 9) {
    b = b - 1
  }
  if a >= b || (a + 1 == b && s.code_unit_at(a) == 124) {
    return 0
  }
  if a < b && s.code_unit_at(a) == 124 {
    a = a + 1
  }
  if b > a && s.code_unit_at(b - 1) == 124 && !(b - 2 >= a && s.code_unit_at(b - 2) == 92) {
    b = b - 1
  }
  let mut count = 0
  let mut i = a
  while i <= b {
    if i == b || s.code_unit_at(i) == 124 {
      count = count + 1
      i = i + 1
    } else if s.code_unit_at(i) == 92 && i + 1 < b && s.code_unit_at(i + 1) == 124 {
      i = i + 2
    } else {
      i = i + 1
    }
  }
  count
}

///| Split a GFM table row into trimmed cell strings (handling escaped `\|` inside cells).
pub fn split_table_row(s : String, start : Int, end : Int) -> Array[String] {
  let cells : Array[String] = Array::new()
  let mut a = start
  let mut b = end
  while a < b && (s.code_unit_at(a) == 32 || s.code_unit_at(a) == 9) {
    a = a + 1
  }
  while b > a && (s.code_unit_at(b - 1) == 32 || s.code_unit_at(b - 1) == 9) {
    b = b - 1
  }
  if a >= b || (a + 1 == b && s.code_unit_at(a) == 124) {
    return cells
  }
  // Strip optional leading pipe
  if a < b && s.code_unit_at(a) == 124 {
    a = a + 1
  }
  // Strip optional unescaped trailing pipe
  if b > a && s.code_unit_at(b - 1) == 124 && !(b - 2 >= a && s.code_unit_at(b - 2) == 92) {
    b = b - 1
  }
  let mut cell_start = a
  let mut i = a
  while i <= b {
    if i == b || s.code_unit_at(i) == 124 {
      // Trim spaces/tabs and unescape \| -> |
      let mut cs = cell_start
      let mut ce = i
      while cs < ce && (s.code_unit_at(cs) == 32 || s.code_unit_at(cs) == 9) {
        cs = cs + 1
      }
      while ce > cs && (s.code_unit_at(ce - 1) == 32 || s.code_unit_at(ce - 1) == 9) {
        ce = ce - 1
      }
      let mut has_esc_pipe = false
      let mut j = cs
      while j + 1 < ce {
        if s.code_unit_at(j) == 92 && s.code_unit_at(j + 1) == 124 {
          has_esc_pipe = true
          break
        }
        j = j + 1
      }
      if !has_esc_pipe {
        cells.push(s.slice(cs, ce))
      } else {
        let sb = StringBuilder::new()
        j = cs
        while j < ce {
          if s.code_unit_at(j) == 92 && j + 1 < ce && s.code_unit_at(j + 1) == 124 {
            sb.write_byte((124).to_byte())
            j = j + 2
          } else {
            sb.write_byte(s.code_unit_at(j).to_byte())
            j = j + 1
          }
        }
        cells.push(sb.to_string())
      }
      cell_start = i + 1
      i = i + 1
    } else if s.code_unit_at(i) == 92 && i + 1 < b && s.code_unit_at(i + 1) == 124 {
      i = i + 2
    } else {
      i = i + 1
    }
  }
  cells
}

///| Scan a GFM table delimiter row (`| --- | :---: | ---: |`). Returns `Some(alignments)` or `None`.
pub fn scan_table_delimiter_row(s : String, start : Int, end : Int) -> Option[Array[Alignment]] {
  let mut has_pipe = false
  let mut has_dash = false
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b == 124 {
      has_pipe = true
    } else if b == 45 {
      has_dash = true
    } else if b != 58 && b != 32 && b != 9 {
      return None
    }
    i = i + 1
  }
  if !has_dash {
    return None
  }
  let mut a = start
  let mut b = end
  while a < b && (s.code_unit_at(a) == 32 || s.code_unit_at(a) == 9) {
    a = a + 1
  }
  while b > a && (s.code_unit_at(b - 1) == 32 || s.code_unit_at(b - 1) == 9) {
    b = b - 1
  }
  if a < b && s.code_unit_at(a) == 124 {
    a = a + 1
  }
  if b > a && s.code_unit_at(b - 1) == 124 {
    b = b - 1
  }
  let aligns : Array[Alignment] = Array::with_capacity(8)
  let mut cell_start = a
  i = a
  while i <= b {
    if i == b || s.code_unit_at(i) == 124 {
      let mut cs = cell_start
      let mut ce = i
      while cs < ce && (s.code_unit_at(cs) == 32 || s.code_unit_at(cs) == 9) {
        cs = cs + 1
      }
      while ce > cs && (s.code_unit_at(ce - 1) == 32 || s.code_unit_at(ce - 1) == 9) {
        ce = ce - 1
      }
      if cs >= ce {
        return None
      }
      let left_colon = s.code_unit_at(cs) == 58
      let right_colon = s.code_unit_at(ce - 1) == 58
      let d_start = if left_colon { cs + 1 } else { cs }
      let d_end = if right_colon { ce - 1 } else { ce }
      if d_end <= d_start {
        return None
      }
      let mut k = d_start
      while k < d_end {
        if s.code_unit_at(k) != 45 {
          return None
        }
        k = k + 1
      }
      if left_colon && right_colon {
        aligns.push(Alignment::Center)
      } else if left_colon {
        aligns.push(Alignment::Left)
      } else if right_colon {
        aligns.push(Alignment::Right)
      } else {
        aligns.push(Alignment::None)
      }
      cell_start = i + 1
    }
    i = i + 1
  }
  if aligns.length() == 0 || (aligns.length() == 1 && !has_pipe) {
    return None
  }
  Some(aligns)
}

///| Fast non-allocating task list marker check at `s[start..end]`.
///| Returns -1 if not a marker, 0 if unchecked `[ ]`, 1 if checked `[x]`/`[X]`.
///| Accepts marker followed by space/tab OR directly at EOL (`start + 3 == end`).
pub fn scan_tasklist_marker_fast(s : String, start : Int, end : Int) -> Int {
  if start + 3 > end {
    return -1
  }
  if s.code_unit_at(start) != 91 || s.code_unit_at(start + 2) != 93 {
    return -1
  }
  if start + 3 < end {
    let sp = s.code_unit_at(start + 3)
    if sp != 32 && sp != 9 {
      return -1
    }
  }
  let mid = s.code_unit_at(start + 1)
  if mid == 120 || mid == 88 {
    1
  } else if mid == 32 {
    0
  } else {
    -1
  }
}

///| Scan a GFM task list marker (`[ ]`, `[x]`, `[X]`) at `s[start..end]`.
///| Returns `Some((checked, next_pos))`.
pub fn scan_tasklist_marker(s : String, start : Int, end : Int) -> Option[(Bool, Int)] {
  if start + 3 > end {
    return None
  }
  if s.code_unit_at(start) != 91 || s.code_unit_at(start + 2) != 93 {
    return None
  }
  let mid = s.code_unit_at(start + 1)
  let checked = if mid == 120 || mid == 88 {
    true
  } else if mid == 32 {
    false
  } else {
    return None
  }
  if start + 3 == end {
    return Some((checked, start + 3))
  }
  let sp = s.code_unit_at(start + 3)
  if sp == 32 || sp == 9 {
    Some((checked, start + 4))
  } else {
    None
  }
}
