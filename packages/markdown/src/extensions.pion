///| Source byte offset event stream (`parse_with_offsets`) and extended Markdown features
///| (YAML / Pluses metadata frontmatter, Footnotes).

///| Compute source byte span `(start, end)` for a block node using its lines or descendants (iteratively).
fn compute_block_ranges(doc : BlockDoc) -> (Array[Int], Array[Int]) {
  let n = doc.meta.length()
  let starts : Array[Int] = Array::with_capacity(n)
  let ends : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let m = doc.meta[i]
    let kind = m.kf & 15
    if (kind == 4 || kind == 5 || kind == 6 || kind == 7 || kind == 8) && m.line_len > 0 {
      let sp0 = doc.all_lines[m.line_start]
      let sp1 = doc.all_lines[m.line_start + m.line_len - 1]
      let s0 = if sp0.pad >= 0 { sp0.start } else { 0 }
      let e1 = if sp1.pad >= 0 { sp1.end } else { s0 }
      starts.push(s0)
      ends.push(e1)
    } else if kind == 10 {
      let cells_start = m.extra
      let total_cells = (m.line_len + 1) * m.line_start
      let mut s0 = -1
      let mut e1 = -1
      let mut ci = 0
      while ci < total_cells {
        let sp = doc.table_cells[cells_start + ci]
        if sp.pad >= 0 && sp.end > sp.start {
          if s0 < 0 || sp.start < s0 {
            s0 = sp.start
          }
          if sp.end > e1 {
            e1 = sp.end
          }
        }
        ci = ci + 1
      }
      if s0 < 0 {
        s0 = 0
        e1 = 0
      }
      starts.push(s0)
      ends.push(e1)
    } else {
      starts.push(-1)
      ends.push(-1)
    }
    i = i + 1
  }
  // Propagate child ranges upward in reverse topological order (parents always have smaller indices than children).
  let mut idx = n - 1
  while idx >= 0 {
    if starts[idx] < 0 {
      let mut s0 = -1
      let mut e1 = -1
      let mut c = doc.tree[idx].first_child
      while c >= 0 {
        let cs = starts[c]
        let ce = ends[c]
        if cs >= 0 {
          if s0 < 0 || cs < s0 {
            s0 = cs
          }
          if ce > e1 {
            e1 = ce
          }
        }
        c = doc.tree[c].next_sibling
      }
      if s0 >= 0 {
        starts[idx] = s0
        ends[idx] = e1
      } else {
        starts[idx] = 0
        ends[idx] = 0
      }
    }
    idx = idx - 1
  }
  (starts, ends)
}

fn push_inlines_with_offsets(
  ctx : InlineCtx,
  s : String,
  seg_start : Int,
  seg_end : Int,
  base_offset : Int,
  ref_defs : Map[String, LinkDef],
  opts : Options,
  out : Array[OffsetEvent],
) -> Unit {
  if seg_start >= seg_end {
    return ()
  }
  let first_sp = find_first_inline_special(ctx.table, s, seg_start, seg_end, ctx.sc)
  if first_sp < 0 {
    let txt = if seg_start == 0 && seg_end == s.length() { s } else { s.slice(seg_start, seg_end) }
    let tmp : Array[Event] = Array::new()
    emit_text_with_autolinks(tmp, txt, opts, 0)
    let mut k = 0
    while k < tmp.length() {
      out.push(OffsetEvent::{ event: tmp[k], start: base_offset + seg_start, end: base_offset + seg_end })
      k = k + 1
    }
    return ()
  }
  scan_inlines_to_ctx(ctx, s, seg_start, seg_end, first_sp, ctx.sc.flag, ref_defs, opts)
  let mut cur = ctx.head
  let mut in_link = 0
  let mut last_pos = base_offset + seg_start
  while cur >= 0 {
    let node = ctx.nodes[cur]
    let tag = node.tag
    if tag == 0 || tag == 20 {
      let ev_s = base_offset + node.a
      let ev_e = base_offset + node.b
      let tmp : Array[Event] = Array::new()
      emit_text_with_autolinks(tmp, s.slice(node.a, node.b), opts, in_link)
      let mut k = 0
      while k < tmp.length() {
        out.push(OffsetEvent::{ event: tmp[k], start: ev_s, end: ev_e })
        k = k + 1
      }
      last_pos = ev_e
    } else if tag == 1 {
      let t = ctx.str_pool[node.a]
      let tmp : Array[Event] = Array::new()
      emit_text_with_autolinks(tmp, t, opts, in_link)
      let mut k = 0
      while k < tmp.length() {
        out.push(OffsetEvent::{ event: tmp[k], start: last_pos, end: last_pos + t.length() })
        k = k + 1
      }
    } else if tag == 2 || tag == 21 {
      let ev_s = base_offset + node.a
      let ev_e = base_offset + node.b
      out.push(OffsetEvent::{ event: Event::Code(s.slice(node.a, node.b)), start: ev_s, end: ev_e })
      last_pos = ev_e
    } else if tag == 3 {
      let c = ctx.str_pool[node.a]
      out.push(OffsetEvent::{ event: Event::Code(c), start: last_pos, end: last_pos + c.length() })
    } else if tag == 4 {
      let ev_s = base_offset + node.a
      let ev_e = base_offset + node.b
      out.push(OffsetEvent::{ event: Event::InlineHtml(s.slice(node.a, node.b)), start: ev_s, end: ev_e })
      last_pos = ev_e
    } else if tag == 5 {
      out.push(OffsetEvent::{ event: Event::SoftBreak, start: last_pos, end: last_pos + 1 })
      last_pos = last_pos + 1
    } else if tag == 6 {
      out.push(OffsetEvent::{ event: Event::HardBreak, start: last_pos, end: last_pos + 1 })
      last_pos = last_pos + 1
    } else if tag == 7 {
      out.push(OffsetEvent::{ event: Event::Start(Tag::Emphasis), start: last_pos, end: last_pos })
    } else if tag == 8 {
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Emphasis), start: last_pos, end: last_pos })
    } else if tag == 9 {
      out.push(OffsetEvent::{ event: Event::Start(Tag::Strong), start: last_pos, end: last_pos })
    } else if tag == 10 {
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Strong), start: last_pos, end: last_pos })
    } else if tag == 11 {
      out.push(OffsetEvent::{ event: Event::Start(Tag::Strikethrough), start: last_pos, end: last_pos })
    } else if tag == 12 {
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Strikethrough), start: last_pos, end: last_pos })
    } else if tag == 13 {
      in_link = in_link + 1
      let info = ctx.link_pool[node.a]
      out.push(OffsetEvent::{
        event: Event::Start(Tag::Link(info.link_type, info.dest, info.title, info.ref_id)),
        start: last_pos,
        end: last_pos,
      })
    } else if tag == 14 {
      if in_link > 0 {
        in_link = in_link - 1
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Link), start: last_pos, end: last_pos })
    } else if tag == 15 {
      let info = ctx.link_pool[node.a]
      out.push(OffsetEvent::{
        event: Event::Start(Tag::Image(info.link_type, info.dest, info.title, info.ref_id)),
        start: last_pos,
        end: last_pos,
      })
    } else if tag == 16 {
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Image), start: last_pos, end: last_pos })
    } else if tag == 17 {
      if node.b > 0 {
        out.push(OffsetEvent::{ event: Event::Text(repeat_byte(node.a, node.b)), start: last_pos, end: last_pos + node.b })
        last_pos = last_pos + node.b
      }
    } else if tag == 18 {
      let txt = if node.a != 0 { "![" } else { "[" }
      out.push(OffsetEvent::{ event: Event::Text(txt), start: last_pos, end: last_pos + txt.length() })
      last_pos = last_pos + txt.length()
    }
    cur = node.next
  }
}

///| Parse Markdown into `Array[OffsetEvent]` iteratively (zero native recursion).
pub fn parse_events_with_offsets(src : String, opts : Options) -> Array[OffsetEvent] {
  let doc = parse_blocks(src, opts)
  let (b_starts, b_ends) = compute_block_ranges(doc)
  let ctx = new_inline_ctx(opts, true)
  let out : Array[OffsetEvent] = Array::new()
  let stack : Array[RenderFrame] = Array::with_capacity(16)
  stack.push(RenderFrame::{ idx: 0, next_child: -1, flags: 0 })

  while stack.length() > 0 {
    let sp_idx = stack.length() - 1
    let frame = stack[sp_idx]
    let idx = frame.idx
    let in_tight_list = (frame.flags & 1) != 0
    let opened = (frame.flags & 2) != 0
    let m = doc.meta[idx]
    let t = doc.tree[idx]
    let kind = m.kf & 15
    let bs = b_starts[idx]
    let be = b_ends[idx]

    if opened {
      let c = frame.next_child
      if c >= 0 {
        let next_sib = doc.tree[c].next_sibling
        stack[sp_idx] = RenderFrame::{ idx, next_child: next_sib, flags: frame.flags }
        let child_tight = if kind == 2 {
          (m.kf & 32) != 0
        } else if kind == 3 {
          in_tight_list
        } else {
          false
        }
        stack.push(RenderFrame::{ idx: c, next_child: -1, flags: if child_tight { 1 } else { 0 } })
        continue
      }
      let _ = stack.pop()
      if kind == 1 {
        out.push(OffsetEvent::{ event: Event::End(TagEnd::BlockQuote), start: bs, end: be })
      } else if kind == 2 {
        out.push(OffsetEvent::{ event: Event::End(TagEnd::List((m.kf & 512) != 0)), start: bs, end: be })
      } else if kind == 3 {
        out.push(OffsetEvent::{ event: Event::End(TagEnd::Item), start: bs, end: be })
      }
      continue
    }

    if kind == 0 {
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 1 {
      out.push(OffsetEvent::{ event: Event::Start(Tag::BlockQuote), start: bs, end: be })
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 2 {
      let ordered = (m.kf & 512) != 0
      let list_tag = if ordered { Tag::List(Some(m.extra)) } else { Tag::List(None) }
      out.push(OffsetEvent::{ event: Event::Start(list_tag), start: bs, end: be })
      stack[sp_idx] = RenderFrame::{ idx, next_child: t.first_child, flags: frame.flags | 2 }
    } else if kind == 3 {
      out.push(OffsetEvent::{ event: Event::Start(Tag::Item), start: bs, end: be })
      let mut start_child = t.first_child
      let task_state = (m.kf >> 7) & 3
      if task_state != 0 {
        let checked = task_state == 2
        if !in_tight_list && start_child >= 0 {
          let fm = doc.meta[start_child]
          if (fm.kf & 15) == 4 {
            let fbs = b_starts[start_child]
            let fbe = b_ends[start_child]
            out.push(OffsetEvent::{ event: Event::Start(Tag::Paragraph), start: fbs, end: fbe })
            out.push(OffsetEvent::{ event: Event::TaskListMarker(checked), start: fbs, end: fbs })
            let text = join_para_spans(doc, fm, ctx)
            push_inlines_with_offsets(ctx, text, 0, text.length(), fbs, doc.ref_defs, opts, out)
            out.push(OffsetEvent::{ event: Event::End(TagEnd::Paragraph), start: fbs, end: fbe })
            start_child = doc.tree[start_child].next_sibling
          } else {
            out.push(OffsetEvent::{ event: Event::TaskListMarker(checked), start: bs, end: bs })
          }
        } else {
          out.push(OffsetEvent::{ event: Event::TaskListMarker(checked), start: bs, end: bs })
        }
      }
      stack[sp_idx] = RenderFrame::{ idx, next_child: start_child, flags: frame.flags | 2 }
    } else if kind == 4 {
      let _ = stack.pop()
      let sp0 = if m.line_len == 1 { doc.all_lines[m.line_start] } else { LineSpan::{ start: 0, end: 0, pad: -1 } }
      if !in_tight_list {
        out.push(OffsetEvent::{ event: Event::Start(Tag::Paragraph), start: bs, end: be })
      }
      if m.line_len == 1 && sp0.pad == 0 {
        let mut e = sp0.end
        while e > sp0.start && (doc.src.code_unit_at(e - 1) == 32 || doc.src.code_unit_at(e - 1) == 9) {
          e = e - 1
        }
        push_inlines_with_offsets(ctx, doc.src, sp0.start, e, 0, doc.ref_defs, opts, out)
      } else {
        let text = join_para_spans(doc, m, ctx)
        push_inlines_with_offsets(ctx, text, 0, text.length(), bs, doc.ref_defs, opts, out)
      }
      if !in_tight_list {
        out.push(OffsetEvent::{ event: Event::End(TagEnd::Paragraph), start: bs, end: be })
      }
    } else if kind == 5 {
      let _ = stack.pop()
      let level = (m.kf >> 10) & 255
      out.push(OffsetEvent::{ event: Event::Start(Tag::Heading(level)), start: bs, end: be })
      let text = join_para_spans(doc, m, ctx)
      push_inlines_with_offsets(ctx, text, 0, text.length(), bs, doc.ref_defs, opts, out)
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Heading(level)), start: bs, end: be })
    } else if kind == 6 {
      let _ = stack.pop()
      out.push(OffsetEvent::{ event: Event::Start(Tag::CodeBlock(CodeBlockKind::Indented)), start: bs, end: be })
      let code = join_block_spans_nl(doc, m, ctx)
      if code.length() > 0 {
        out.push(OffsetEvent::{ event: Event::Text(code), start: bs, end: be })
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::CodeBlock), start: bs, end: be })
    } else if kind == 7 {
      let _ = stack.pop()
      let info = if m.extra < 0 { "" } else { doc.extra_strs[m.extra] }
      out.push(OffsetEvent::{ event: Event::Start(Tag::CodeBlock(CodeBlockKind::Fenced(info))), start: bs, end: be })
      let code = join_block_spans_nl(doc, m, ctx)
      if code.length() > 0 {
        out.push(OffsetEvent::{ event: Event::Text(code), start: bs, end: be })
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::CodeBlock), start: bs, end: be })
    } else if kind == 8 {
      let _ = stack.pop()
      out.push(OffsetEvent::{ event: Event::Start(Tag::HtmlBlock), start: bs, end: be })
      let html = join_block_spans_nl(doc, m, ctx)
      if html.length() > 0 {
        out.push(OffsetEvent::{ event: Event::Html(html), start: bs, end: be })
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::HtmlBlock), start: bs, end: be })
    } else if kind == 9 {
      let _ = stack.pop()
      out.push(OffsetEvent::{ event: Event::Rule, start: bs, end: be })
    } else if kind == 10 {
      let _ = stack.pop()
      let aligns = doc.table_aligns[t.extra2]
      let cells_start = m.extra
      let ncols = m.line_start
      let num_rows = m.line_len
      out.push(OffsetEvent::{ event: Event::Start(Tag::Table(aligns)), start: bs, end: be })
      out.push(OffsetEvent::{ event: Event::Start(Tag::TableHead), start: bs, end: be })
      let mut hi = 0
      while hi < ncols {
        let sp = doc.table_cells[cells_start + hi]
        let cs = if sp.pad >= 0 { sp.start } else { bs }
        let ce = if sp.pad >= 0 { sp.end } else { bs }
        out.push(OffsetEvent::{ event: Event::Start(Tag::TableCell), start: cs, end: ce })
        if sp.pad < 0 {
          let txt = doc.extra_strs[sp.start]
          push_inlines_with_offsets(ctx, txt, 0, txt.length(), bs, doc.ref_defs, opts, out)
        } else if sp.start < sp.end {
          push_inlines_with_offsets(ctx, doc.src, sp.start, sp.end, 0, doc.ref_defs, opts, out)
        }
        out.push(OffsetEvent::{ event: Event::End(TagEnd::TableCell), start: cs, end: ce })
        hi = hi + 1
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::TableHead), start: bs, end: be })
      let mut ri = 0
      while ri < num_rows {
        out.push(OffsetEvent::{ event: Event::Start(Tag::TableRow), start: bs, end: be })
        let row_base = cells_start + (ri + 1) * ncols
        let mut ci = 0
        while ci < ncols {
          let sp = doc.table_cells[row_base + ci]
          let cs = if sp.pad >= 0 { sp.start } else { bs }
          let ce = if sp.pad >= 0 { sp.end } else { bs }
          out.push(OffsetEvent::{ event: Event::Start(Tag::TableCell), start: cs, end: ce })
          if sp.pad < 0 {
            let txt = doc.extra_strs[sp.start]
            push_inlines_with_offsets(ctx, txt, 0, txt.length(), bs, doc.ref_defs, opts, out)
          } else if sp.start < sp.end {
            push_inlines_with_offsets(ctx, doc.src, sp.start, sp.end, 0, doc.ref_defs, opts, out)
          }
          out.push(OffsetEvent::{ event: Event::End(TagEnd::TableCell), start: cs, end: ce })
          ci = ci + 1
        }
        out.push(OffsetEvent::{ event: Event::End(TagEnd::TableRow), start: bs, end: be })
        ri = ri + 1
      }
      out.push(OffsetEvent::{ event: Event::End(TagEnd::Table), start: bs, end: be })
    } else {
      let _ = stack.pop()
    }
  }
  out
}

///| Strip optional leading YAML (`---`..`---`/`...`) or Pluses (`+++`..`+++`) frontmatter.
///| Returns `Some((kind, content, body_start_offset))` or `None`.
fn scan_frontmatter(
  src : String,
  yaml : Bool,
  pluses : Bool,
) -> Option[(MetadataBlockKind, String, Int)] {
  let n = src.length()
  if n < 4 {
    return None
  }
  let mut line_end = 0
  while line_end < n && src.code_unit_at(line_end) != 10 {
    line_end = line_end + 1
  }
  let mut trim_end = line_end
  while trim_end > 0 && (src.code_unit_at(trim_end - 1) == 32 || src.code_unit_at(trim_end - 1) == 9 || src.code_unit_at(trim_end - 1) == 13) {
    trim_end = trim_end - 1
  }
  let (kind, delim_b) = if yaml && trim_end == 3 && starts_with_lit(src, 0, 3, "---") {
    (MetadataBlockKind::YamlStyle, 45)
  } else if pluses && trim_end == 3 && starts_with_lit(src, 0, 3, "+++") {
    (MetadataBlockKind::PlusesStyle, 43)
  } else {
    return None
  }
  let content_start = if line_end < n { line_end + 1 } else { n }
  let mut pos = content_start
  while pos < n {
    let mut le = pos
    while le < n && src.code_unit_at(le) != 10 {
      le = le + 1
    }
    let mut te = le
    while te > pos && (src.code_unit_at(te - 1) == 32 || src.code_unit_at(te - 1) == 9 || src.code_unit_at(te - 1) == 13) {
      te = te - 1
    }
    let is_close = if te - pos == 3 {
      let b0 = src.code_unit_at(pos)
      let b1 = src.code_unit_at(pos + 1)
      let b2 = src.code_unit_at(pos + 2)
      (b0 == delim_b && b1 == delim_b && b2 == delim_b) ||
      (delim_b == 45 && b0 == 46 && b1 == 46 && b2 == 46)
    } else {
      false
    }
    if is_close {
      let after = if le < n { le + 1 } else { n }
      return Some((kind, src.slice(content_start, pos), after))
    }
    pos = if le < n { le + 1 } else { n }
  }
  None
}

///| Check if `s[start..end]` begins a footnote definition `[^label]: ...`.
///| Returns `Some((label, body_start))` or `None`.
fn scan_footnote_def_header(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  let mut i = start
  let mut sp = 0
  while i < end && s.code_unit_at(i) == 32 && sp < 3 {
    i = i + 1
    sp = sp + 1
  }
  if i + 4 >= end || s.code_unit_at(i) != 91 || s.code_unit_at(i + 1) != 94 {
    return None
  }
  let lstart = i + 2
  let mut j = lstart
  while j < end {
    let b = s.code_unit_at(j)
    if b == 93 {
      break
    }
    if b <= 32 || b == 91 {
      return None
    }
    j = j + 1
  }
  if j <= lstart || j + 1 >= end || s.code_unit_at(j) != 93 || s.code_unit_at(j + 1) != 58 {
    return None
  }
  let mut body_start = j + 2
  if body_start < end && (s.code_unit_at(body_start) == 32 || s.code_unit_at(body_start) == 9) {
    body_start = body_start + 1
  }
  Some((s.slice(lstart, j), body_start))
}

///| Extract top-level footnote definitions `[^label]: ...` (with optional 4-space indented continuation lines).
///| Returns `(cleaned_body, def_order, def_bodies)`.
fn extract_footnote_defs(src : String) -> (String, Array[String], Map[String, String]) {
  let n = src.length()
  let body_sb = StringBuilder::new()
  let def_order : Array[String] = Array::new()
  let def_bodies : Map[String, String] = Map::new()
  let mut pos = 0
  let mut in_fence = false
  let mut fence_ch = 0
  let mut fence_len = 0

  while pos < n {
    let mut le = pos
    while le < n && src.code_unit_at(le) != 10 {
      le = le + 1
    }
    let next_pos = if le < n { le + 1 } else { n }
    // Track fenced code blocks so `[^a]:` inside code fences is not stripped
    let mut ns = pos
    while ns < le && src.code_unit_at(ns) == 32 && ns - pos < 4 {
      ns = ns + 1
    }
    if ns - pos <= 3 && ns < le {
      let fb = src.code_unit_at(ns)
      if !in_fence && (fb == 96 || fb == 126) {
        match scan_code_fence_open(src, ns, le) {
          Some((fc, fl, _)) => {
            in_fence = true
            fence_ch = fc
            fence_len = fl
          }
          None => ()
        }
      } else if in_fence && fb == fence_ch && scan_code_fence_close(src, ns, le, fence_ch, fence_len) {
        in_fence = false
      }
    }
    if !in_fence {
      match scan_footnote_def_header(src, pos, le) {
        Some((label, bstart)) => {
          let def_sb = StringBuilder::new()
          if bstart < le {
            write_raw_span(def_sb, src, bstart, le)
          }
          def_sb.write_byte((10).to_byte())
          pos = next_pos
          // Consume indented continuation lines (4 spaces or 1 tab, plus blank lines followed by indented lines)
          while pos < n {
            let mut cle = pos
            while cle < n && src.code_unit_at(cle) != 10 {
              cle = cle + 1
            }
            let cnext = if cle < n { cle + 1 } else { n }
            if line_is_blank(src, pos, cle) {
              // Look ahead for indented continuation after blank line(s)
              let mut look = cnext
              while look < n {
                let mut lle = look
                while lle < n && src.code_unit_at(lle) != 10 {
                  lle = lle + 1
                }
                if !line_is_blank(src, look, lle) {
                  break
                }
                look = if lle < n { lle + 1 } else { n }
              }
              let indented_after = look < n && (
                src.code_unit_at(look) == 9 ||
                (look + 3 < n && starts_with_lit(src, look, n, "    "))
              )
              if indented_after {
                def_sb.write_byte((10).to_byte())
                pos = cnext
                continue
              } else {
                break
              }
            }
            if src.code_unit_at(pos) == 9 {
              write_raw_span(def_sb, src, pos + 1, cle)
              def_sb.write_byte((10).to_byte())
              pos = cnext
            } else if pos + 4 <= cle && starts_with_lit(src, pos, cle, "    ") {
              write_raw_span(def_sb, src, pos + 4, cle)
              def_sb.write_byte((10).to_byte())
              pos = cnext
            } else {
              break
            }
          }
          if !def_bodies.contains(label) {
            def_order.push(label)
            def_bodies.set(label, def_sb.to_string())
          }
          continue
        }
        None => ()
      }
    }
    write_raw_span(body_sb, src, pos, next_pos)
    pos = next_pos
  }
  (body_sb.to_string(), def_order, def_bodies)
}

///| Rewrite `[^label]` (and `![^label]` -> `!` + `[^label]`) inside `Event::Text` events into `Event::FootnoteReference`
///| when `label` exists in `def_bodies`.
fn rewrite_footnote_refs(events : Array[Event], def_bodies : Map[String, String]) -> Array[Event] {
  let out : Array[Event] = Array::with_capacity(events.length())
  let n = events.length()
  let mut i = 0
  while i < n {
    let ev = events[i]
    match ev {
      Event::Text(t) => {
        // Coalesce consecutive Text events (since `[` and `![` are emitted as separate Text events)
        let sb = StringBuilder::new()
        sb.write_string(t)
        let mut j = i + 1
        while j < n {
          match events[j] {
            Event::Text(t2) => {
              sb.write_string(t2)
              j = j + 1
            }
            _ => break
          }
        }
        let s = sb.to_string()
        let slen = s.length()
        let mut mark = 0
        let mut k = 0
        while k + 3 < slen {
          if s.code_unit_at(k) == 91 && s.code_unit_at(k + 1) == 94 {
            let mut r = k + 2
            while r < slen && s.code_unit_at(r) != 93 && s.code_unit_at(r) > 32 && s.code_unit_at(r) != 91 {
              r = r + 1
            }
            if r > k + 2 && r < slen && s.code_unit_at(r) == 93 {
              let lbl = s.slice(k + 2, r)
              if def_bodies.contains(lbl) {
                if mark < k {
                  out.push(Event::Text(s.slice(mark, k)))
                }
                out.push(Event::FootnoteReference(lbl))
                k = r + 1
                mark = k
                continue
              }
            }
          }
          k = k + 1
        }
        if mark == 0 {
          out.push(Event::Text(s))
        } else if mark < slen {
          out.push(Event::Text(s.slice(mark, slen)))
        }
        i = j
      }
      _ => {
        out.push(ev)
        i = i + 1
      }
    }
  }
  out
}

///| Parse Markdown with extended options (YAML/Pluses frontmatter, Footnotes).
pub fn parse_events_extended(src : String, opts : ExtendedOptions) -> Array[Event] {
  let events : Array[Event] = Array::new()
  let mut body = src
  if opts.yaml_frontmatter || opts.pluses_frontmatter {
    match scan_frontmatter(src, opts.yaml_frontmatter, opts.pluses_frontmatter) {
      Some((kind, content, after)) => {
        events.push(Event::Start(Tag::MetadataBlock(kind)))
        if content.length() > 0 {
          events.push(Event::Text(content))
        }
        events.push(Event::End(TagEnd::MetadataBlock(kind)))
        body = src.slice(after, src.length())
      }
      None => ()
    }
  }
  if !opts.footnotes {
    let main_evs = parse_events(body, opts.base)
    let mut i = 0
    while i < main_evs.length() {
      events.push(main_evs[i])
      i = i + 1
    }
    return events
  }
  let (cleaned, def_order, def_bodies) = extract_footnote_defs(body)
  let raw_evs = parse_events(cleaned, opts.base)
  let rewritten = if def_order.length() > 0 {
    rewrite_footnote_refs(raw_evs, def_bodies)
  } else {
    raw_evs
  }
  let mut i = 0
  while i < rewritten.length() {
    events.push(rewritten[i])
    i = i + 1
  }
  let mut di = 0
  while di < def_order.length() {
    let lbl = def_order[di]
    match def_bodies.get(lbl) {
      Some(def_src) => {
        events.push(Event::Start(Tag::FootnoteDefinition(lbl)))
        let def_evs = parse_events(def_src, opts.base)
        let mut k = 0
        while k < def_evs.length() {
          events.push(def_evs[k])
          k = k + 1
        }
        events.push(Event::End(TagEnd::FootnoteDefinition))
      }
      None => ()
    }
    di = di + 1
  }
  events
}
