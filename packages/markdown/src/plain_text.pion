///| Configurable plain-text preview and summary extraction from Markdown / `Document` AST.
///| Fully iterative traversal (zero native recursion) with UTF-8 code-point safe truncation.

///| Configuration for extracting plain-text summaries/previews from Markdown.
pub val struct PlainTextOptions {
  pub image_placeholder : String
  pub link_placeholder : String
  pub code_block_placeholder : String
  pub math_placeholder : String
  pub collapse_whitespace : Bool
  pub max_chars : Int
}

///| Default plain-text options: collapse whitespace, unlimited length, empty placeholders.
pub fn PlainTextOptions::default() -> PlainTextOptions {
  PlainTextOptions::{
    image_placeholder: "",
    link_placeholder: "",
    code_block_placeholder: "",
    math_placeholder: "",
    collapse_whitespace: true,
    max_chars: 0,
  }
}

///| Mutable accumulator enforcing whitespace policy and UTF-8 code-point truncation.
struct PlainTextWriter {
  sb : StringBuilder
  collapse : Bool
  max_chars : Int
  mut emitted_chars : Int
  mut has_output : Bool
  mut pending_sep : Int // 0 = none, 1 = space, 2 = newline
  mut last_was_space : Bool
}

///|
fn pt_is_full(w : PlainTextWriter) -> Bool {
  w.max_chars > 0 && w.emitted_chars >= w.max_chars
}

///|
fn pt_utf8_char_len(b0 : Int) -> Int {
  if b0 < 0x80 {
    1
  } else if (b0 & 0xE0) == 0xC0 {
    2
  } else if (b0 & 0xF0) == 0xE0 {
    3
  } else if (b0 & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

///|
fn pt_mark_sep(w : PlainTextWriter, level : Int) -> Unit {
  if w.has_output && level > w.pending_sep {
    w.pending_sep = level
  }
}

///| Flush pending separator before writing visible text; returns false if `max_chars` reached.
fn pt_flush_sep(w : PlainTextWriter) -> Bool {
  if pt_is_full(w) {
    return false
  }
  if w.has_output && w.pending_sep > 0 {
    if w.collapse {
      if !w.last_was_space {
        w.sb.write_byte((32).to_byte())
        w.emitted_chars = w.emitted_chars + 1
        w.last_was_space = true
      }
      w.pending_sep = 0
    } else {
      if w.pending_sep >= 2 {
        w.sb.write_byte((10).to_byte())
        w.last_was_space = false
      } else {
        w.sb.write_byte((32).to_byte())
        w.last_was_space = true
      }
      w.emitted_chars = w.emitted_chars + 1
      w.pending_sep = 0
    }
  }
  !pt_is_full(w)
}

///| Write a string span `s[start..end]` respecting `collapse_whitespace` and UTF-8 `max_chars`.
fn pt_write_span(w : PlainTextWriter, s : String, start : Int, end : Int) -> Unit {
  if start >= end || pt_is_full(w) {
    return ()
  }
  if w.collapse {
    let mut i = start
    while i < end {
      let b0 = s.code_unit_at(i)
      if b0 == 32 || b0 == 9 || b0 == 10 || b0 == 13 {
        pt_mark_sep(w, 1)
        i = i + 1
        continue
      }
      if !pt_flush_sep(w) {
        return ()
      }
      let clen = pt_utf8_char_len(b0)
      let next_i = if i + clen <= end { i + clen } else { end }
      if clen == 1 {
        w.sb.write_byte(b0.to_byte())
      } else {
        w.sb.write_substring(s, i, next_i)
      }
      w.emitted_chars = w.emitted_chars + 1
      w.has_output = true
      w.last_was_space = false
      i = next_i
      if pt_is_full(w) {
        return ()
      }
    }
  } else {
    if !pt_flush_sep(w) {
      return ()
    }
    let mut i = start
    while i < end {
      if pt_is_full(w) {
        return ()
      }
      let b0 = s.code_unit_at(i)
      let clen = pt_utf8_char_len(b0)
      let next_i = if i + clen <= end { i + clen } else { end }
      if clen == 1 {
        w.sb.write_byte(b0.to_byte())
        w.last_was_space = b0 == 32
      } else {
        w.sb.write_substring(s, i, next_i)
        w.last_was_space = false
      }
      w.emitted_chars = w.emitted_chars + 1
      w.has_output = true
      i = next_i
    }
  }
}

///| Write a string respecting `collapse_whitespace` and UTF-8 `max_chars`.
fn pt_write_str(w : PlainTextWriter, s : String) -> Unit {
  pt_write_span(w, s, 0, s.length())
}

///| Check if an HTML tag starting at `s[lt..gt]` is a break/block boundary tag.
fn pt_is_break_html_tag(s : String, lt : Int, gt : Int) -> Bool {
  let mut p = lt + 1
  if p < gt && s.code_unit_at(p) == 47 {
    p = p + 1
  }
  if p >= gt {
    return false
  }
  let c0 = s.code_unit_at(p) | 32
  if c0 == 98 && p + 1 < gt && (s.code_unit_at(p + 1) | 32) == 114 {
    // br
    return p + 2 == gt || s.code_unit_at(p + 2) == 32 || s.code_unit_at(p + 2) == 47
  }
  if c0 == 112 && (p + 1 == gt || s.code_unit_at(p + 1) == 32) {
    // p
    return true
  }
  if c0 == 100 && p + 2 < gt && (s.code_unit_at(p + 1) | 32) == 105 && (s.code_unit_at(p + 2) | 32) == 118 {
    // div
    return true
  }
  false
}

///| Strip HTML tags and comments from `raw`, emitting visible inner text.
fn pt_write_html_stripped(w : PlainTextWriter, raw : String) -> Unit {
  let n = raw.length()
  let mut i = 0
  let mut text_start = 0
  while i < n && !pt_is_full(w) {
    if raw.code_unit_at(i) == 60 {
      // '<'
      if text_start < i {
        pt_write_span(w, raw, text_start, i)
      }
      if i + 3 < n &&
      raw.code_unit_at(i + 1) == 33 &&
      raw.code_unit_at(i + 2) == 45 &&
      raw.code_unit_at(i + 3) == 45 {
        // HTML comment <!-- ... -->
        let mut j = i + 4
        while j + 2 < n {
          if raw.code_unit_at(j) == 45 && raw.code_unit_at(j + 1) == 45 && raw.code_unit_at(j + 2) == 62 {
            j = j + 3
            break
          }
          j = j + 1
        }
        if j + 2 >= n {
          i = n
        } else {
          i = j
        }
        text_start = i
        continue
      }
      let mut j = i + 1
      let mut quote = 0
      while j < n {
        let b = raw.code_unit_at(j)
        if quote != 0 {
          if b == quote {
            quote = 0
          }
        } else if b == 34 || b == 39 {
          quote = b
        } else if b == 62 {
          break
        }
        j = j + 1
      }
      if j < n && raw.code_unit_at(j) == 62 {
        if pt_is_break_html_tag(raw, i, j) {
          pt_mark_sep(w, 1)
        }
        i = j + 1
        text_start = i
      } else {
        i = n
        text_start = n
      }
    } else {
      i = i + 1
    }
  }
  if text_start < n && !pt_is_full(w) {
    pt_write_span(w, raw, text_start, n)
  }
}

///| Explicit stack work item for iterative inline traversal.
enum PtInlineWork {
  Visit(Inline)
  CheckPlaceholder(Int, String)
}

///| Iteratively emit plain text for `inlines` into `w`.
fn pt_emit_inlines(w : PlainTextWriter, inlines : Array[Inline], pt_opts : PlainTextOptions) -> Unit {
  if inlines.length() == 0 || pt_is_full(w) {
    return ()
  }
  let stack : Array[PtInlineWork] = Array::with_capacity(inlines.length() + 4)
  let mut k = inlines.length() - 1
  while k >= 0 {
    stack.push(PtInlineWork::Visit(inlines[k]))
    k = k - 1
  }

  while stack.length() > 0 && !pt_is_full(w) {
    match stack.pop() {
      Some(work) => match work {
        PtInlineWork::CheckPlaceholder(chars_before, ph) => {
          if w.emitted_chars == chars_before && ph.length() > 0 {
            pt_write_str(w, ph)
          }
        }
        PtInlineWork::Visit(inl) => match inl {
          Inline::Text(s) => pt_write_str(w, s)
          Inline::Code(s) => pt_write_str(w, s)
          Inline::SoftBreak => if w.collapse {
            pt_mark_sep(w, 1)
          } else {
            pt_mark_sep(w, 2)
          }
          Inline::HardBreak => if w.collapse {
            pt_mark_sep(w, 1)
          } else {
            pt_mark_sep(w, 2)
          }
          Inline::Emphasis(ch) | Inline::Strong(ch) | Inline::Strikethrough(ch) => {
            let mut j = ch.length() - 1
            while j >= 0 {
              stack.push(PtInlineWork::Visit(ch[j]))
              j = j - 1
            }
          }
          Inline::Link(_url, _title, ch) => {
            stack.push(PtInlineWork::CheckPlaceholder(w.emitted_chars, pt_opts.link_placeholder))
            let mut j = ch.length() - 1
            while j >= 0 {
              stack.push(PtInlineWork::Visit(ch[j]))
              j = j - 1
            }
          }
          Inline::Image(_url, _title, ch) => {
            stack.push(PtInlineWork::CheckPlaceholder(w.emitted_chars, pt_opts.image_placeholder))
            let mut j = ch.length() - 1
            while j >= 0 {
              stack.push(PtInlineWork::Visit(ch[j]))
              j = j - 1
            }
          }
          Inline::HtmlInline(raw) => pt_write_html_stripped(w, raw)
          Inline::FootnoteReference(_lbl) => ()
          Inline::Math(_display, tex) => {
            if pt_opts.math_placeholder.length() > 0 {
              pt_write_str(w, pt_opts.math_placeholder)
            } else {
              pt_write_str(w, tex)
            }
          }
        }
      }
      None => ()
    }
  }
}

///| Explicit stack work item for iterative block traversal.
enum PtBlockWork {
  Visit(Block)
  Sep(Int)
}

///| Extract plain text from a parsed `Document` AST (fully iterative, zero recursion).
pub fn Document::plain_text(self : Document, pt_opts : PlainTextOptions) -> String {
  let w = PlainTextWriter::{
    sb: StringBuilder::with_capacity(256),
    collapse: pt_opts.collapse_whitespace,
    max_chars: pt_opts.max_chars,
    emitted_chars: 0,
    has_output: false,
    pending_sep: 0,
    last_was_space: false,
  }
  let stack : Array[PtBlockWork] = Array::with_capacity(self.blocks.length() + 8)
  let mut i = self.blocks.length() - 1
  while i >= 0 {
    stack.push(PtBlockWork::Visit(self.blocks[i]))
    i = i - 1
  }

  while stack.length() > 0 && !pt_is_full(w) {
    match stack.pop() {
      Some(work) => match work {
        PtBlockWork::Sep(level) => pt_mark_sep(w, level)
        PtBlockWork::Visit(blk) => match blk {
          Block::Paragraph(inlines) | Block::Heading(_, inlines) => {
            pt_emit_inlines(w, inlines, pt_opts)
            pt_mark_sep(w, 2)
          }
          Block::BlockQuote(ch) | Block::FootnoteDefinition(_, ch) => {
            stack.push(PtBlockWork::Sep(2))
            let mut k = ch.length() - 1
            while k >= 0 {
              stack.push(PtBlockWork::Visit(ch[k]))
              k = k - 1
            }
          }
          Block::CodeBlock(_kind, _info, code) => {
            if pt_opts.code_block_placeholder.length() > 0 {
              pt_write_str(w, pt_opts.code_block_placeholder)
            } else {
              let mut end = code.length()
              if !w.collapse && end > 0 && code.code_unit_at(end - 1) == 10 {
                end = end - 1
              }
              pt_write_span(w, code, 0, end)
            }
            pt_mark_sep(w, 2)
          }
          Block::List(_start, _tight, items) => {
            stack.push(PtBlockWork::Sep(2))
            let mut k = items.length() - 1
            while k >= 0 {
              let ib = items[k].blocks
              stack.push(PtBlockWork::Sep(2))
              let mut j = ib.length() - 1
              while j >= 0 {
                stack.push(PtBlockWork::Visit(ib[j]))
                j = j - 1
              }
              k = k - 1
            }
          }
          Block::Table(_aligns, headers, rows) => {
            let mut hi = 0
            while hi < headers.length() && !pt_is_full(w) {
              if hi > 0 {
                pt_mark_sep(w, 1)
              }
              pt_emit_inlines(w, headers[hi].inlines, pt_opts)
              hi = hi + 1
            }
            pt_mark_sep(w, 2)
            let mut ri = 0
            while ri < rows.length() && !pt_is_full(w) {
              let row = rows[ri]
              let mut ci = 0
              while ci < row.length() && !pt_is_full(w) {
                if ci > 0 {
                  pt_mark_sep(w, 1)
                }
                pt_emit_inlines(w, row[ci].inlines, pt_opts)
                ci = ci + 1
              }
              pt_mark_sep(w, 2)
              ri = ri + 1
            }
          }
          Block::ThematicBreak => pt_mark_sep(w, 2)
          Block::HtmlBlock(raw) => {
            pt_write_html_stripped(w, raw)
            pt_mark_sep(w, 2)
          }
        }
      }
      None => ()
    }
  }
  w.sb.to_string()
}

///| Parse Markdown and extract plain text directly.
pub fn to_plain_text(src : String, opts : Options, pt_opts : PlainTextOptions) -> String {
  parse_document(src, opts).plain_text(pt_opts)
}

///| Parse extended Markdown (frontmatter stripped, footnotes handled) and extract plain text.
pub fn to_plain_text_extended(
  src : String,
  opts : ExtendedOptions,
  pt_opts : PlainTextOptions,
) -> String {
  parse_document_extended(src, opts).plain_text(pt_opts)
}
