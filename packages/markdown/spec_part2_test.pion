///| CommonMark 0.31.2 official spec tests (examples 164..326).

///|
test "cm_164" {

  let actual = to_html("<i class=\"foo\">\n*bar*\n</i>\n", Options::commonmark())

  let expected = "<i class=\"foo\">\n*bar*\n</i>\n"

  debug_assert(actual == expected, "cm_164")

}

///|
test "cm_165" {

  let actual = to_html("</ins>\n*bar*\n", Options::commonmark())

  let expected = "</ins>\n*bar*\n"

  debug_assert(actual == expected, "cm_165")

}

///|
test "cm_166" {

  let actual = to_html("<del>\n*foo*\n</del>\n", Options::commonmark())

  let expected = "<del>\n*foo*\n</del>\n"

  debug_assert(actual == expected, "cm_166")

}

///|
test "cm_167" {

  let actual = to_html("<del>\n\n*foo*\n\n</del>\n", Options::commonmark())

  let expected = "<del>\n<p><em>foo</em></p>\n</del>\n"

  debug_assert(actual == expected, "cm_167")

}

///|
test "cm_168" {

  let actual = to_html("<del>*foo*</del>\n", Options::commonmark())

  let expected = "<p><del><em>foo</em></del></p>\n"

  debug_assert(actual == expected, "cm_168")

}

///|
test "cm_169" {

  let actual = to_html("<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print $ parseTags tags\n</code></pre>\nokay\n", Options::commonmark())

  let expected = "<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print $ parseTags tags\n</code></pre>\n<p>okay</p>\n"

  debug_assert(actual == expected, "cm_169")

}

///|
test "cm_170" {

  let actual = to_html("<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\nokay\n", Options::commonmark())

  let expected = "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\n<p>okay</p>\n"

  debug_assert(actual == expected, "cm_170")

}

