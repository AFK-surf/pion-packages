///|
test "cm_321" {

  let actual = to_html("- a\n  > b\n  ```\n  c\n  ```\n- d\n", Options::commonmark())

  let expected = "<ul>\n<li>a\n<blockquote>\n<p>b</p>\n</blockquote>\n<pre><code>c\n</code></pre>\n</li>\n<li>d</li>\n</ul>\n"

  debug_assert(actual == expected, "cm_321")

}

///|
test "cm_322" {

  let actual = to_html("- a\n", Options::commonmark())

  let expected = "<ul>\n<li>a</li>\n</ul>\n"

  debug_assert(actual == expected, "cm_322")

}

///|
test "cm_323" {

  let actual = to_html("- a\n  - b\n", Options::commonmark())

  let expected = "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"

  debug_assert(actual == expected, "cm_323")

}

///|
test "cm_324" {

  let actual = to_html("1. ```\n   foo\n   ```\n\n   bar\n", Options::commonmark())

  let expected = "<ol>\n<li>\n<pre><code>foo\n</code></pre>\n<p>bar</p>\n</li>\n</ol>\n"

  debug_assert(actual == expected, "cm_324")

}

///|
test "cm_325" {

  let actual = to_html("* foo\n  * bar\n\n  baz\n", Options::commonmark())

  let expected = "<ul>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n<p>baz</p>\n</li>\n</ul>\n"

  debug_assert(actual == expected, "cm_325")

}

///|
test "cm_326" {

  let actual = to_html("- a\n  - b\n  - c\n\n- d\n  - e\n  - f\n", Options::commonmark())

  let expected = "<ul>\n<li>\n<p>a</p>\n<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n</li>\n<li>\n<p>d</p>\n<ul>\n<li>e</li>\n<li>f</li>\n</ul>\n</li>\n</ul>\n"

  debug_assert(actual == expected, "cm_326")

}
