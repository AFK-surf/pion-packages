///| Wasm32 & Native 4-mode smoke test entry point for `markdown` v0.3.0.
///| Exercises HTML rendering, structured `Document` AST, `plain_text`, UTF-8 truncation,
///| and deep nesting stack safety (50,000 blockquotes + 32,000 lists).

import "markdown"

///|
pub fn main(world : World) -> Int {
  let md = "# Hello **Wasm**\n\n- [x] `pion` ~~old~~ **中文（测试）**文本\n- [ ] ![](pic.png) [点击](https://pion.dev)\n\n| A | B |\n| :--- | ---: |\n| 1 | 2 |\n"
  let opts = markdown::Options::{
    tables: true,
    strikethrough: true,
    tasklists: true,
    autolinks: true,
    smart_punctuation: false,
    cjk_friendly: true,
  }
  let html = markdown::to_html(md, opts)
  io_print(world, html)

  let doc = markdown::parse_document(md, opts)
  io_println(world, "blocks=" + doc.blocks.length().to_string())

  let pt_default = doc.plain_text(markdown::PlainTextOptions::default())
  io_println(world, "pt=" + pt_default)

  let pt_ph = markdown::to_plain_text(
    md,
    opts,
    markdown::PlainTextOptions::{
      image_placeholder: "[图]",
      link_placeholder: "[链]",
      code_block_placeholder: "[码]",
      math_placeholder: "[式]",
      collapse_whitespace: true,
      max_chars: 24,
    },
  )
  io_println(world, "pt24=" + pt_ph)

  // Deep nesting stack safety on both Native and Wasm32 (50k blockquotes + 32k lists)
  let sb_bq = StringBuilder::with_capacity(100010)
  let mut i = 0
  while i < 50000 {
    sb_bq.write_string("> ")
    i = i + 1
  }
  sb_bq.write_string("ok_bq\n")
  let bq_pt = markdown::to_plain_text(
    sb_bq.to_string(),
    markdown::Options::commonmark(),
    markdown::PlainTextOptions::default(),
  )

  let sb_li = StringBuilder::with_capacity(64010)
  i = 0
  while i < 32000 {
    sb_li.write_string("- ")
    i = i + 1
  }
  sb_li.write_string("ok_li\n")
  let li_pt = markdown::to_plain_text(
    sb_li.to_string(),
    markdown::Options::commonmark(),
    markdown::PlainTextOptions::default(),
  )
  io_println(world, "deep=" + bq_pt + "," + li_pt)
  0
}
