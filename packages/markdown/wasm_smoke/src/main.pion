///| Wasm32 smoke test entry point for `markdown`.

import "markdown"

///|
pub fn main(world : World) -> Int {
  let md = "# Hello **Wasm**\n\n- [x] `pion` ~~old~~ **中文（测试）**文本\n"
  let opts = markdown::Options::{
    tables: true,
    strikethrough: true,
    tasklists: true,
    autolinks: true,
    smart_punctuation: false,
    cjk_friendly: true,
  }
  let html = markdown::to_html(md, opts)
  io_print(world, html)
  0
}
