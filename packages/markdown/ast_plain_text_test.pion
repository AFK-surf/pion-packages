///| Unit tests for `markdown` v0.3.0: structured tree `Document` AST (`parse_document`,
///| `parse_document_extended`) and configurable plain-text extraction (`Document::plain_text`,
///| `to_plain_text`, `to_plain_text_extended`).

///|
fn count_utf8_codepoints(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///|
fn is_valid_utf8(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 {
      if i + 1 >= n || (s.code_unit_at(i + 1) & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 {
      if i + 2 >= n ||
      (s.code_unit_at(i + 1) & 0xC0) != 0x80 ||
      (s.code_unit_at(i + 2) & 0xC0) != 0x80 {
        return false
      }
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 {
      if i + 3 >= n ||
      (s.code_unit_at(i + 1) & 0xC0) != 0x80 ||
      (s.code_unit_at(i + 2) & 0xC0) != 0x80 ||
      (s.code_unit_at(i + 3) & 0xC0) != 0x80 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
test "ast_blocks_basic" {
  let src = "# Heading 1\n\n## Heading 2\n\nHello *world*!\n\n---\n\n> Quoted line\n\n```rust\nfn main() {}\n```\n\n    indented()\n\n<div>raw html</div>\n"
  let doc = parse_document(src, Options::commonmark())
  debug_assert(doc.front_matter is None, "no frontmatter in commonmark")
  debug_assert(doc.blocks.length() == 8, "expected 8 top-level blocks, got " + doc.blocks.length().to_string())

  match doc.blocks[0] {
    Block::Heading(level, inlines) => {
      debug_assert(level == 1, "h1 level")
      debug_assert(inlines.length() == 1, "h1 single text inline")
      match inlines[0] {
        Inline::Text(t) => debug_assert(t == "Heading 1", "h1 text: " + t)
        _ => debug_assert(false, "expected Inline::Text in h1")
      }
    }
    _ => debug_assert(false, "expected Block::Heading at 0")
  }

  match doc.blocks[1] {
    Block::Heading(level, _) => debug_assert(level == 2, "h2 level")
    _ => debug_assert(false, "expected Block::Heading at 1")
  }

  match doc.blocks[2] {
    Block::Paragraph(inlines) => {
      debug_assert(inlines.length() == 3, "paragraph has 3 inlines")
      match inlines[0] {
        Inline::Text(t) => debug_assert(t == "Hello ", "p[0]: " + t)
        _ => debug_assert(false, "expected Text")
      }
      match inlines[1] {
        Inline::Emphasis(children) => {
          debug_assert(children.length() == 1, "em child")
          match children[0] {
            Inline::Text(t) => debug_assert(t == "world", "em text: " + t)
            _ => debug_assert(false, "expected Text in em")
          }
        }
        _ => debug_assert(false, "expected Emphasis")
      }
      match inlines[2] {
        Inline::Text(t) => debug_assert(t == "!", "p[2]: " + t)
        _ => debug_assert(false, "expected Text")
      }
    }
    _ => debug_assert(false, "expected Block::Paragraph at 2")
  }

  match doc.blocks[3] {
    Block::ThematicBreak => ()
    _ => debug_assert(false, "expected Block::ThematicBreak at 3")
  }

  match doc.blocks[4] {
    Block::BlockQuote(children) => {
      debug_assert(children.length() == 1, "blockquote has 1 child")
      match children[0] {
        Block::Paragraph(inlines) => {
          debug_assert(inlines.length() == 1, "bq para inline")
          match inlines[0] {
            Inline::Text(t) => debug_assert(t == "Quoted line", "bq text: " + t)
            _ => debug_assert(false, "expected Text in bq")
          }
        }
        _ => debug_assert(false, "expected Paragraph in blockquote")
      }
    }
    _ => debug_assert(false, "expected Block::BlockQuote at 4")
  }

  match doc.blocks[5] {
    Block::CodeBlock(kind, info, code) => {
      match kind {
        CodeBlockKind::Fenced(finfo) => debug_assert(finfo == "rust", "fenced info: " + finfo)
        _ => debug_assert(false, "expected Fenced code block")
      }
      debug_assert(info == "rust", "code info: " + info)
      debug_assert(code == "fn main() {}\n", "code body: " + code)
    }
    _ => debug_assert(false, "expected Block::CodeBlock at 5")
  }

  match doc.blocks[6] {
    Block::CodeBlock(kind, info, code) => {
      match kind {
        CodeBlockKind::Indented => ()
        _ => debug_assert(false, "expected Indented code block")
      }
      debug_assert(info == "", "indented info empty")
      debug_assert(code == "indented()\n", "indented body: " + code)
    }
    _ => debug_assert(false, "expected Indented Block::CodeBlock at 6")
  }

  match doc.blocks[7] {
    Block::HtmlBlock(raw) => debug_assert(raw == "<div>raw html</div>\n", "html block: " + raw)
    _ => debug_assert(false, "expected Block::HtmlBlock at 7")
  }
}

///|
test "ast_lists_tight_loose_ordered_tasklist" {
  let tight_src = "- [x] Done\n- [ ] Todo\n- Normal\n"
  let doc1 = parse_document(tight_src, Options::gfm())
  debug_assert(doc1.blocks.length() == 1, "single list block")
  match doc1.blocks[0] {
    Block::List(start, tight, items) => {
      debug_assert(start is None, "bullet list start is None")
      debug_assert(tight == true, "tight list")
      debug_assert(items.length() == 3, "3 items")
      match items[0].checked {
        Some(v) => debug_assert(v == true, "item 0 checked")
        None => debug_assert(false, "item 0 expected Some(true)")
      }
      match items[1].checked {
        Some(v) => debug_assert(v == false, "item 1 unchecked")
        None => debug_assert(false, "item 1 expected Some(false)")
      }
      debug_assert(items[2].checked is None, "item 2 not task")
      debug_assert(items[0].blocks.length() == 1, "item 0 has 1 paragraph block")
    }
    _ => debug_assert(false, "expected Block::List")
  }

  let loose_ordered = "5. First\n\n6. Second\n"
  let doc2 = parse_document(loose_ordered, Options::gfm())
  debug_assert(doc2.blocks.length() == 1, "single ordered list")
  match doc2.blocks[0] {
    Block::List(start, tight, items) => {
      match start {
        Some(n) => debug_assert(n == 5L, "ordered start 5")
        None => debug_assert(false, "expected Some(5L)")
      }
      debug_assert(tight == false, "loose list")
      debug_assert(items.length() == 2, "2 items")
    }
    _ => debug_assert(false, "expected Block::List")
  }
}

///|
test "ast_gfm_table" {
  let src = "| Left | Center | Right | None |\n| :--- | :---: | ---: | --- |\n| **a** | `b` | ~~c~~ | d |\n| 1 | 2 | 3 | 4 |\n"
  let doc = parse_document(src, Options::gfm())
  debug_assert(doc.blocks.length() == 1, "1 table block")
  match doc.blocks[0] {
    Block::Table(aligns, headers, rows) => {
      debug_assert(aligns.length() == 4, "4 alignments")
      match aligns[0] {
        Alignment::Left => ()
        _ => debug_assert(false, "col 0 Left")
      }
      match aligns[1] {
        Alignment::Center => ()
        _ => debug_assert(false, "col 1 Center")
      }
      match aligns[2] {
        Alignment::Right => ()
        _ => debug_assert(false, "col 2 Right")
      }
      match aligns[3] {
        Alignment::None => ()
        _ => debug_assert(false, "col 3 None")
      }
      debug_assert(headers.length() == 4, "4 header cells")
      debug_assert(rows.length() == 2, "2 body rows")
      debug_assert(rows[0].length() == 4, "row 0 has 4 cells")
      match rows[0][0].inlines[0] {
        Inline::Strong(_) => ()
        _ => debug_assert(false, "expected Strong in row 0 col 0")
      }
      match rows[0][1].inlines[0] {
        Inline::Code(c) => debug_assert(c == "b", "expected Code b")
        _ => debug_assert(false, "expected Code in row 0 col 1")
      }
      match rows[0][2].inlines[0] {
        Inline::Strikethrough(_) => ()
        _ => debug_assert(false, "expected Strikethrough in row 0 col 2")
      }
    }
    _ => debug_assert(false, "expected Block::Table")
  }
}

///|
test "ast_inlines_comprehensive" {
  let src = "a `code` *em* **strong** ~~del~~ [link](https://example.com \"Title\") ![alt *text*](img.png \"Img\") <span>hi</span> line1\nline2  \nline3 https://pion.dev test@example.com\n"
  let doc = parse_document(src, Options::gfm())
  debug_assert(doc.blocks.length() == 1, "single paragraph")
  match doc.blocks[0] {
    Block::Paragraph(inlines) => {
      let mut has_code = false
      let mut has_em = false
      let mut has_strong = false
      let mut has_del = false
      let mut has_link = false
      let mut has_img = false
      let mut has_html = false
      let mut has_soft = false
      let mut has_hard = false
      let mut has_autolink = false
      let mut has_email = false
      let mut i = 0
      while i < inlines.length() {
        match inlines[i] {
          Inline::Code(c) => if c == "code" { has_code = true }
          Inline::Emphasis(_) => has_em = true
          Inline::Strong(_) => has_strong = true
          Inline::Strikethrough(_) => has_del = true
          Inline::Link(url, title, _) => {
            if url == "https://example.com" && title == "Title" {
              has_link = true
            } else if url == "https://pion.dev" {
              has_autolink = true
            } else if url == "mailto:test@example.com" {
              has_email = true
            }
          }
          Inline::Image(url, title, alt) => {
            if url == "img.png" && title == "Img" && alt.length() == 2 {
              has_img = true
            }
          }
          Inline::HtmlInline(_) => has_html = true
          Inline::SoftBreak => has_soft = true
          Inline::HardBreak => has_hard = true
          _ => ()
        }
        i = i + 1
      }
      debug_assert(has_code, "has_code")
      debug_assert(has_em, "has_em")
      debug_assert(has_strong, "has_strong")
      debug_assert(has_del, "has_del")
      debug_assert(has_link, "has_link")
      debug_assert(has_img, "has_img")
      debug_assert(has_html, "has_html")
      debug_assert(has_soft, "has_soft")
      debug_assert(has_hard, "has_hard")
      debug_assert(has_autolink, "has_autolink")
      debug_assert(has_email, "has_email")
    }
    _ => debug_assert(false, "expected Paragraph")
  }
}

///|
test "ast_extended_frontmatter_and_footnotes" {
  let yaml_src = "---\ntitle: Hello\nauthor: Pion\n---\nBody with footnote[^n1].\n\n[^n1]: Footnote *body*.\n"
  let doc = parse_document_extended(yaml_src, ExtendedOptions::full())
  match doc.front_matter {
    Some(fm) => {
      match fm.kind {
        MetadataBlockKind::YamlStyle => ()
        _ => debug_assert(false, "expected YamlStyle")
      }
      debug_assert(fm.content == "title: Hello\nauthor: Pion\n", "yaml content: " + fm.content)
    }
    None => debug_assert(false, "expected Some(front_matter)")
  }
  debug_assert(doc.blocks.length() == 2, "paragraph + footnote def")
  match doc.blocks[0] {
    Block::Paragraph(inlines) => {
      let mut saw_ref = false
      let mut i = 0
      while i < inlines.length() {
        match inlines[i] {
          Inline::FootnoteReference(lbl) => if lbl == "n1" { saw_ref = true }
          _ => ()
        }
        i = i + 1
      }
      debug_assert(saw_ref, "saw FootnoteReference(n1)")
    }
    _ => debug_assert(false, "expected Paragraph")
  }
  match doc.blocks[1] {
    Block::FootnoteDefinition(lbl, fblocks) => {
      debug_assert(lbl == "n1", "footnote def label")
      debug_assert(fblocks.length() == 1, "footnote def has 1 block")
    }
    _ => debug_assert(false, "expected FootnoteDefinition")
  }

  let plus_src = "+++\ntitle = 'Toml'\n+++\nHello\n"
  let doc_p = parse_document_extended(plus_src, ExtendedOptions::full())
  match doc_p.front_matter {
    Some(fm) => match fm.kind {
      MetadataBlockKind::PlusesStyle => debug_assert(fm.content == "title = 'Toml'\n", "pluses content")
      _ => debug_assert(false, "expected PlusesStyle")
    }
    None => debug_assert(false, "expected Some(pluses)")
  }
}

///|
test "plain_text_basic_and_placeholders" {
  let src = "# Title\n\nHello **bold** *italic* ~~old~~ `code` [click here](https://a.com) [](https://empty.com) ![logo](a.png) ![](b.png)\n\n```py\nprint(1)\n```\n\n<span>tag</span><!-- hidden --> text\n"
  let pt_default = to_plain_text(src, Options::gfm(), PlainTextOptions::default())
  debug_assert(
    pt_default == "Title Hello bold italic old code click here logo print(1) tag text",
    "default plain_text: [" + pt_default + "]",
  )

  let pt_custom = to_plain_text(
    src,
    Options::gfm(),
    PlainTextOptions::{
      image_placeholder: "[图片]",
      link_placeholder: "[链接]",
      code_block_placeholder: "[代码块]",
      math_placeholder: "[公式]",
      collapse_whitespace: true,
      max_chars: 0,
    },
  )
  debug_assert(
    pt_custom == "Title Hello bold italic old code click here [链接] logo [图片] [代码块] tag text",
    "custom placeholders: [" + pt_custom + "]",
  )
}

///|
test "plain_text_math_and_multiline_mode" {
  let blocks : Array[Block] = Array::new()
  let p1 : Array[Inline] = Array::new()
  p1.push(Inline::Text("Formula: "))
  p1.push(Inline::Math(false, "E=mc^2"))
  blocks.push(Block::Paragraph(p1))
  let p2 : Array[Inline] = Array::new()
  p2.push(Inline::Text("Second line"))
  blocks.push(Block::Paragraph(p2))
  let doc = Document::{ blocks, front_matter: None }

  let raw_math = doc.plain_text(PlainTextOptions::default())
  debug_assert(raw_math == "Formula: E=mc^2 Second line", "raw math: " + raw_math)

  let ph_math = doc.plain_text(PlainTextOptions::{
    image_placeholder: "",
    link_placeholder: "",
    code_block_placeholder: "",
    math_placeholder: "[数学公式]",
    collapse_whitespace: false,
    max_chars: 0,
  })
  debug_assert(ph_math == "Formula: [数学公式]\nSecond line", "multiline + math placeholder: [" + ph_math + "]")
}

///|
test "plain_text_table_tasklist_blockquote_frontmatter" {
  let src = "---\ntitle: Hidden\n---\n> Quote text\n\n- [x] Ship v0.3.0\n- [ ] Write docs\n\n| Name | Score |\n| --- | --- |\n| Alice | 98 |\n"
  let got = to_plain_text_extended(src, ExtendedOptions::full(), PlainTextOptions::default())
  debug_assert(
    got == "Quote text Ship v0.3.0 Write docs Name Score Alice 98",
    "extended plain_text: [" + got + "]",
  )
}

///|
test "plain_text_utf8_max_chars_cjk_and_emoji" {
  let cjk = "你好世界，欢迎使用 **Pion** 语言！"
  let s4 = to_plain_text(cjk, Options::gfm(), PlainTextOptions::{
    image_placeholder: "",
    link_placeholder: "",
    code_block_placeholder: "",
    math_placeholder: "",
    collapse_whitespace: true,
    max_chars: 4,
  })
  debug_assert(s4 == "你好世界", "cjk 4 chars: [" + s4 + "]")
  debug_assert(is_valid_utf8(s4), "cjk 4 chars valid utf8")
  debug_assert(count_utf8_codepoints(s4) == 4, "cjk 4 codepoints")

  let emoji = "🚀🎉🔥Hello世界"
  let e3 = to_plain_text(emoji, Options::gfm(), PlainTextOptions::{
    image_placeholder: "",
    link_placeholder: "",
    code_block_placeholder: "",
    math_placeholder: "",
    collapse_whitespace: true,
    max_chars: 3,
  })
  debug_assert(e3 == "🚀🎉🔥", "emoji 3 chars: [" + e3 + "]")
  debug_assert(is_valid_utf8(e3), "emoji 3 chars valid utf8")
  debug_assert(count_utf8_codepoints(e3) == 3, "emoji 3 codepoints")

  let e10 = to_plain_text(emoji, Options::gfm(), PlainTextOptions::{
    image_placeholder: "",
    link_placeholder: "",
    code_block_placeholder: "",
    math_placeholder: "",
    collapse_whitespace: true,
    max_chars: 10,
  })
  debug_assert(e10 == "🚀🎉🔥Hello世界", "emoji full 10 chars: [" + e10 + "]")
  debug_assert(is_valid_utf8(e10), "emoji 10 chars valid utf8")
}

///|
test "ast_and_plain_text_deep_nesting_stack_safety" {
  // 50,000 nested blockquotes must parse into Document AST and extract plain_text with 0 SIGSEGV.
  let sb_bq = StringBuilder::with_capacity(100010)
  let mut i = 0
  while i < 50000 {
    sb_bq.write_string("> ")
    i = i + 1
  }
  sb_bq.write_string("deep_bq\n")
  let doc_bq = parse_document(sb_bq.to_string(), Options::commonmark())
  debug_assert(doc_bq.blocks.length() == 1, "deep bq root has 1 block")
  let pt_bq = doc_bq.plain_text(PlainTextOptions::default())
  debug_assert(pt_bq == "deep_bq", "deep bq plain_text: [" + pt_bq + "]")

  // 32,000 nested lists must parse into Document AST and extract plain_text with 0 SIGSEGV.
  let sb_li = StringBuilder::with_capacity(64010)
  i = 0
  while i < 32000 {
    sb_li.write_string("- ")
    i = i + 1
  }
  sb_li.write_string("deep_li\n")
  let doc_li = parse_document(sb_li.to_string(), Options::commonmark())
  debug_assert(doc_li.blocks.length() == 1, "deep list root has 1 block")
  let pt_li = doc_li.plain_text(PlainTextOptions::default())
  debug_assert(pt_li == "deep_li", "deep list plain_text: [" + pt_li + "]")
}

///|
test "ast_roundtrip_consistency_with_event_stream" {
  let src = "# Title\n\nPara with **bold**, *em*, `code`, ~~del~~, [link](https://a.b \"T\"), ![pic](p.png).\n\n> Nested\n>\n> - [x] Item 1\n> - [ ] Item 2\n\n| A | B |\n| :--- | ---: |\n| 1 | 2 |\n\n```go\nfmt.Println()\n```\n"
  let opts = Options::gfm()
  let doc = parse_document(src, opts)
  let events = parse(src, opts)

  // Verify total text+code tokens extracted from AST match event stream tokens (excluding HTML/tags).
  let ev_sb = StringBuilder::new()
  let mut i = 0
  while i < events.length() {
    match events[i] {
      Event::Text(t) => ev_sb.write_string(t)
      Event::Code(c) => ev_sb.write_string(c)
      _ => ()
    }
    i = i + 1
  }

  let ast_sb = StringBuilder::new()
  let bstack : Array[Block] = Array::new()
  let mut bi = doc.blocks.length() - 1
  while bi >= 0 {
    bstack.push(doc.blocks[bi])
    bi = bi - 1
  }
  let istack : Array[Inline] = Array::new()
  while bstack.length() > 0 {
    match bstack.pop() {
      Some(blk) => match blk {
        Block::Paragraph(inlines) | Block::Heading(_, inlines) => {
          let mut k = inlines.length() - 1
          while k >= 0 {
            istack.push(inlines[k])
            k = k - 1
          }
          while istack.length() > 0 {
            match istack.pop() {
              Some(inl) => match inl {
                Inline::Text(t) => ast_sb.write_string(t)
                Inline::Code(c) => ast_sb.write_string(c)
                Inline::Emphasis(ch) | Inline::Strong(ch) | Inline::Strikethrough(ch) | Inline::Link(_, _, ch) | Inline::Image(_, _, ch) => {
                  let mut j = ch.length() - 1
                  while j >= 0 {
                    istack.push(ch[j])
                    j = j - 1
                  }
                }
                _ => ()
              }
              None => ()
            }
          }
        }
        Block::BlockQuote(ch) | Block::FootnoteDefinition(_, ch) => {
          let mut k = ch.length() - 1
          while k >= 0 {
            bstack.push(ch[k])
            k = k - 1
          }
        }
        Block::CodeBlock(_, _, code) => ast_sb.write_string(code)
        Block::List(_, _, items) => {
          let mut k = items.length() - 1
          while k >= 0 {
            let ib = items[k].blocks
            let mut j = ib.length() - 1
            while j >= 0 {
              bstack.push(ib[j])
              j = j - 1
            }
            k = k - 1
          }
        }
        Block::Table(_, headers, rows) => {
          let mut r = rows.length() - 1
          while r >= 0 {
            let row = rows[r]
            let mut c = row.length() - 1
            while c >= 0 {
              bstack.push(Block::Paragraph(row[c].inlines))
              c = c - 1
            }
            r = r - 1
          }
          let mut h = headers.length() - 1
          while h >= 0 {
            bstack.push(Block::Paragraph(headers[h].inlines))
            h = h - 1
          }
        }
        Block::ThematicBreak | Block::HtmlBlock(_) => ()
      }
      None => ()
    }
  }
  debug_assert(
    ast_sb.to_string() == ev_sb.to_string(),
    "AST vs Event stream text mismatch:\nAST=" + ast_sb.to_string() + "\nEV =" + ev_sb.to_string(),
  )
}
