///| RED-TEAM evidence for `packages/markdown` (d082835) vs Rust pulldown-cmark 0.13.1.
///| GENERATED by audit/scripts/gen_tests.py -- do not edit by hand.
///| Expected bytes come from the real pulldown-cmark 0.13.1 oracle (audit/rust_ref) unless the
///| case is a GFM-spec example.  A FAILING test is evidence.  Prefixes: p0_/p1_/gap_/p2_ = severity
///| (p2_ = pion matches cmark/the spec but not pulldown), ok_ = guard rails that currently pass.
///| Run: pionc test -p markdown_redteam packages/markdown/audit

import "markdown"

///| [P0] to_html_pulldown drops the newline after <li> that render_html_pulldown(parse()) and Rust emit
test "p0_paths_loose_tasklist_direct_vs_parse" {
  let src = "- [ ] a\n\n- [x] b\n"
  let expected = "<ul>\n<li>\n<p><input disabled=\"\" type=\"checkbox\"/>\na</p>\n</li>\n<li>\n<p><input disabled=\"\" type=\"checkbox\" checked=\"\"/>\nb</p>\n</li>\n</ul>\n"
  let direct = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  let events = markdown::render_html_pulldown(markdown::parse(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false }))
  debug_assert(events == expected, "p0_paths_loose_tasklist_direct_vs_parse: events path=" + events)
  debug_assert(direct == events, "p0_paths_loose_tasklist_direct_vs_parse: direct path diverges from parse() path: " + direct)
}

///| [P0] pulldown-cmark regression #70
test "p0_paths_loose_tasklist_direct_vs_rust" {
  let src = "* [ ] foo\n\n* [ ] bar\n\nbaz\n"
  let expected = "<ul>\n<li>\n<p><input disabled=\"\" type=\"checkbox\"/>\nfoo</p>\n</li>\n<li>\n<p><input disabled=\"\" type=\"checkbox\"/>\nbar</p>\n</li>\n</ul>\n<p>baz</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p0_paths_loose_tasklist_direct_vs_rust: to_html_pulldown=" + got)
}

///| [P0] to_html vs render_html(parse()) disagree the same way
test "p0_paths_loose_tasklist_cm_direct_vs_parse" {
  let src = "- [ ] a\n\n- [x] b\n"
  let expected = "<ul>\n<li>\n<p><input disabled=\"\" type=\"checkbox\"/>\na</p>\n</li>\n<li>\n<p><input disabled=\"\" type=\"checkbox\" checked=\"\"/>\nb</p>\n</li>\n</ul>\n"
  let direct = markdown::to_html(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  let events = markdown::render_html(markdown::parse(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false }))
  let _ = expected
  debug_assert(direct == events, "p0_paths_loose_tasklist_cm_direct_vs_parse: to_html=" + direct + " render_html(parse)=" + events)
}

///| [P0] CommonMark: blank line between two children makes the list loose (cmark/commonmark.js agree); pion renders tight
test "p0_list_indented_code_then_para_is_loose" {
  let src = "-     test\n\n  test2\n"
  let expected = "<ul>\n<li>\n<pre><code>test\n</code></pre>\n<p>test2</p>\n</li>\n</ul>\n"
  let got = markdown::to_html(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p0_list_indented_code_then_para_is_loose: to_html=" + got)
  let ev = markdown::render_html(markdown::parse(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false }))
  debug_assert(ev == expected, "p0_list_indented_code_then_para_is_loose: render_html(parse)=" + ev)
}

///| [P0] blank line between items -> loose list
test "p0_list_indented_code_then_item_is_loose" {
  let src = "-     test\n\n- test2\n"
  let expected = "<ul>\n<li>\n<pre><code>test\n</code></pre>\n</li>\n<li>\n<p>test2</p>\n</li>\n</ul>\n"
  let got = markdown::to_html(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p0_list_indented_code_then_item_is_loose: to_html=" + got)
  let ev = markdown::render_html(markdown::parse(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false }))
  debug_assert(ev == expected, "p0_list_indented_code_then_item_is_loose: render_html(parse)=" + ev)
}

