///| [P2] pulldown escapes ' as &#39; in attributes
test "p2_parity_title_apostrophe_escape" {
  let src = "[link]: test '\\''\n\n[link]\n"
  let expected = "<p><a href=\"test\" title=\"&#39;\">link</a></p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p2_parity_title_apostrophe_escape: to_html_pulldown=" + got)
}

