  let expected = "<ul>\n<li>  <div>\n  <div>\n</li>\n</ul>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_pulldown_fmt_li_empty_first_line_html: to_html_pulldown=" + got)
}

///| [P1]
test "p1_pulldown_fmt_li_table" {
  let src = "- |a|b|\n  |-|-|\n  |1|2|\n"
  let expected = "<ul>\n<li><table><thead><tr><th>a</th><th>b</th></tr></thead><tbody>\n<tr><td>1</td><td>2</td></tr>\n</tbody></table>\n</li>\n</ul>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_pulldown_fmt_li_table: to_html_pulldown=" + got)
}

///| [P1] trailing tab before a soft break leaks into the HTML
test "p1_softbreak_trailing_tab_kept" {
  let src = "b\t\nc\n"
  let expected = "<p>b\nc</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_softbreak_trailing_tab_kept: to_html_pulldown=" + got)
}

///| [P1]
test "p1_softbreak_trailing_tab_blockquote" {
  let src = "> [!CAUTION]\t\n> Line 1.\n"
  let expected = "<blockquote>\n<p>[!CAUTION]\nLine 1.</p>\n</blockquote>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_softbreak_trailing_tab_blockquote: to_html_pulldown=" + got)
}

///| [P1] GFM spec: trailing entity reference is excluded from the autolink
test "p1_gfm_autolink_entity_suffix_excluded" {
  let src = "www.google.com/search?q=commonmark&hl;\n"
  let expected = "<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: true, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_gfm_autolink_entity_suffix_excluded: to_html_pulldown=" + got)
}

///| [P1] GFM spec extended url autolink accepts ftp://
test "p1_gfm_autolink_ftp" {
  let src = "Anonymous FTP is available at ftp://foo.bar.baz.\n"
  let expected = "<p>Anonymous FTP is available at <a href=\"ftp://foo.bar.baz\">ftp://foo.bar.baz</a>.</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: true, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_gfm_autolink_ftp: to_html_pulldown=" + got)
}

///| [P1] GFM spec: only `.` may end an email address; `_`/`-` at the end -> no autolink
test "p1_gfm_autolink_email_trailing_underscore" {
  let src = "a.b-c_d@a.b_\n"
  let expected = "<p>a.b-c_d@a.b_</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: true, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_gfm_autolink_email_trailing_underscore: to_html_pulldown=" + got)
}

///| [OK]
test "ok_gfm_autolink_email_trailing_dash" {
  let src = "a.b-c_d@a.b-\n"
  let expected = "<p>a.b-c_d@a.b-</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: true, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "ok_gfm_autolink_email_trailing_dash: to_html_pulldown=" + got)
}

///| [P1] GFM 0.29 extended protocol autolink
