///| [P1] ENABLE_FOOTNOTES: pion silently turns the footnote into a link to href="Cool."
test "gap_footnotes" {
  let src = "Lorem ipsum.[^a]\n\n[^a]: Cool.\n"
  let expected = "<p>Lorem ipsum.<sup class=\"footnote-reference\"><a href=\"#a\">1</a></sup></p>\n<div class=\"footnote-definition\" id=\"a\"><sup class=\"footnote-definition-label\">1</sup>\n<p>Cool.</p>\n</div>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "gap_footnotes: to_html_pulldown=" + got)
}

///| [P1]
test "gap_footnote_image_bang" {
  let src = "![^1]\n\n[^1]: foo\n"
  let expected = "<p>!<sup class=\"footnote-reference\"><a href=\"#1\">1</a></sup></p>\n<div class=\"footnote-definition\" id=\"1\"><sup class=\"footnote-definition-label\">1</sup>\n<p>foo</p>\n</div>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "gap_footnote_image_bang: to_html_pulldown=" + got)
}

///| [P1]
test "gap_heading_attributes" {
  let src = "# Heading {#id .class key=val}\n"
  let expected = "<h1 id=\"id\" class=\"class\" key=\"val\">Heading</h1>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "gap_heading_attributes: to_html_pulldown=" + got)
}

///| [P1] ENABLE_MATH: pion parses emphasis inside math
test "gap_math_inline_display" {
  let src = "$a*b*c$ and $$x_1_2$$\n"
  let expected = "<p><span class=\"math math-inline\">a*b*c</span> and <span class=\"math math-display\">x_1_2</span></p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "gap_math_inline_display: to_html_pulldown=" + got)
}

///| [P1] ENABLE_YAML_STYLE_METADATA_BLOCKS: front matter rendered as <hr>+<h2>
test "gap_yaml_metadata_block" {
  let src = "---\ntitle: x\nlist:\n    - a\n---\nThings\n"
  let expected = "<p>Things</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "gap_yaml_metadata_block: to_html_pulldown=" + got)
}

///| [P1]
test "gap_pluses_metadata_block" {
  let src = "+++\ntitle = 'x'\n+++\nThings\n"
  let expected = "<p>Things</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
