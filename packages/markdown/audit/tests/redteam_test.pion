///| [P1] a list item starts a new block (GFM: table ends at another block-level structure); pion swallows `*` as a cell
test "p1_table_terminated_by_list_item" {
  let src = "moo | moo\n----|----\nmoo | moo\n*\n"
  let expected = "<table><thead><tr><th>moo</th><th>moo</th></tr></thead><tbody>\n<tr><td>moo</td><td>moo</td></tr>\n</tbody></table>\n<ul>\n<li></li>\n</ul>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p1_table_terminated_by_list_item: to_html_pulldown=" + got)
}

