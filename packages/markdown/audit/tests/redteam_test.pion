///| [P2] pion==cmark (adds \n); pulldown omits it
test "p2_parity_eof_no_newline_code" {
  let src = "\tcode"
  let expected = "<pre><code>code</code></pre>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p2_parity_eof_no_newline_code: to_html_pulldown=" + got)
}

