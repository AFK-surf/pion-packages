  let expected = "<p>a\nb</p>\n<table><thead><tr><th>a</th><th>b</th></tr></thead><tbody>\n<tr><td>1</td><td>2</td></tr>\n</tbody></table>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "ok_crlf_paragraph: to_html_pulldown=" + got)
}

