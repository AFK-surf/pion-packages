///| [P2] pion (like commonmark.js) closes; pulldown opens an unmatched double quote
test "p2_parity_smart_unmatched_double_quote" {
  let src = "a\"\n"
  let expected = "<p>a“</p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: false, smart_punctuation: true, cjk_friendly: false })
  debug_assert(got == expected, "p2_parity_smart_unmatched_double_quote: to_html_pulldown=" + got)
}

///| [P2] pion==cmark (empty item cannot interrupt a paragraph)
test "p2_parity_lazy_empty_item" {
  let src = ">x\n+\n"
  let expected = "<blockquote>\n<p>x</p>\n</blockquote>\n<ul>\n<li></li>\n</ul>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p2_parity_lazy_empty_item: to_html_pulldown=" + got)
}

///| [P2] CommonMark caps labels at 999 chars; pion is right, pulldown links it
test "p2_parity_label_1000_chars" {
  let src = "[]: /u\n\n[]\n"
  let expected = "<p><a href=\"/u\"></a></p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p2_parity_label_1000_chars: to_html_pulldown=" + got)
}

///| [P2] GFM disallowed raw HTML (tagfilter): neither pion nor pulldown implement it
test "p2_gfm_tagfilter_missing" {
  let src = "<title> <style> <xmp>\n"
  let expected = "<p>&lt;title> &lt;style> &lt;xmp></p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: true, strikethrough: true, tasklists: true, autolinks: true, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "p2_gfm_tagfilter_missing: to_html_pulldown=" + got)
}

///| [OK] CommonMark 2.3: U+0000 must become U+FFFD. pion is right here; pulldown-cmark 0.13.1 emits a raw NUL
test "ok_nul_replacement_direct" {
  let src = "a\u{0}b *x*\n"
  let expected = "<p>a�b <em>x</em></p>\n"
  let got = markdown::to_html_pulldown(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })
  debug_assert(got == expected, "ok_nul_replacement_direct: to_html_pulldown=" + got)
}

///| [OK]
test "ok_nul_replacement_events" {
  let src = "a\u{0}b *x*\n"
  let expected = "<p>a�b <em>x</em></p>\n"
  let got = markdown::render_html_pulldown(markdown::parse(src, markdown::Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false }))
  debug_assert(got == expected, "ok_nul_replacement_events: render_html_pulldown(parse)=" + got)
}

///| [OK]
test "ok_crlf_paragraph" {
