///| Red-team audit harness for `packages/markdown`.
///|
///| batch <in>            : records `<mask>\t<len>\n<bytes>`; per record prints 4 renderings
///|                         (`<len>\n<html>` each): to_html_pulldown, render_html_pulldown(parse),
///|                         to_html, render_html(parse)
///| direct <in> <mask>    : to_html_pulldown(src)
///| events <in> <mask>    : render_html_pulldown(parse(src))   (the Event-API path)

import "markdown"

///|
fn mask_opts(mask : Int) -> markdown::Options {
  markdown::Options::{
    tables: (mask & 1) != 0,
    strikethrough: (mask & 2) != 0,
    tasklists: (mask & 4) != 0,
    autolinks: (mask & 8) != 0,
    smart_punctuation: (mask & 16) != 0,
    cjk_friendly: (mask & 32) != 0,
  }
}

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: harness batch|direct|events <in> [mask]")
    return 2
  }
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  let mode = args[1]
  if mode == "batch" {
    let out = StringBuilder::new()
    let n = src.length()
    let mut i = 0
    while i < n {
      let mut tab = i
      while src.code_unit_at(tab) != 9 {
        tab = tab + 1
      }
      let mut nl = tab
      while src.code_unit_at(nl) != 10 {
        nl = nl + 1
      }
      let mask = parse_dec(src, i, tab)
      let len = parse_dec(src, tab + 1, nl)
      let body = src.slice(nl + 1, nl + 1 + len)
      let o = mask_opts(mask)
      emit(out, markdown::to_html_pulldown(body, o))
      emit(out, markdown::render_html_pulldown(markdown::parse(body, o)))
      emit(out, markdown::to_html(body, o))
      emit(out, markdown::render_html(markdown::parse(body, o)))
      i = nl + 1 + len
    }
    io_print(world, out.to_string())
    return 0
  }
  let mask = if args.length() >= 4 { parse_dec(args[3], 0, args[3].length()) } else { 0 }
  let o = mask_opts(mask)
  if mode == "direct" {
    io_print(world, markdown::to_html_pulldown(src, o))
  } else {
    io_print(world, markdown::render_html_pulldown(markdown::parse(src, o)))
  }
  0
}
