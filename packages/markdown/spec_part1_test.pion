///|
test "cm_001" {

  let actual = to_html("\tfoo\tbaz\t\tbim\n", Options::commonmark())

  let expected = "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"

  debug_assert(actual == expected, "cm_001")

}

///|
test "cm_002" {

  let actual = to_html("  \tfoo\tbaz\t\tbim\n", Options::commonmark())

  let expected = "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n"

  debug_assert(actual == expected, "cm_002")

}

///|
