///| CommonMark 0.31.2 official spec tests (examples 490..652).

///|
test "cm_490" {

  let actual = to_html("[link](foo\nbar)\n", Options::commonmark())

  let expected = "<p>[link](foo\nbar)</p>\n"

  debug_assert(actual == expected, "cm_490")

}

///|
test "cm_491" {

  let actual = to_html("[link](<foo\nbar>)\n", Options::commonmark())

  let expected = "<p>[link](<foo\nbar>)</p>\n"

  debug_assert(actual == expected, "cm_491")

}

