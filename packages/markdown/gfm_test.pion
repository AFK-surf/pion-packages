///| GFM (tables, strikethrough, tasklists, autolinks) and smart punctuation tests.

///|
test "gfm_table_test_0001_l24" {

  let actual = to_html("| foo | bar |\n| --- | --- |\n| baz | bim |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0001_l24")

}

///|
test "gfm_table_test_0002_l48" {

  let actual = to_html("| abc | defghi |\n:-: | -----------:\nbar | baz\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th style=\"text-align: center\">abc</th>\n<th style=\"text-align: right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: center\">bar</td>\n<td style=\"text-align: right\">baz</td>\n</tr>\n</tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0002_l48")

}

///|
test "gfm_table_test_0003_l72" {

  let actual = to_html("| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0003_l72")

}

///|
test "gfm_table_test_0004_l98" {

  let actual = to_html("| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"

  debug_assert(actual == expected, "gfm_table_test_0004_l98")

}

///|
test "gfm_table_test_0005_l123" {

  let actual = to_html("| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n"

  debug_assert(actual == expected, "gfm_table_test_0005_l123")

}

///|
test "gfm_table_test_0006_l155" {

  let actual = to_html("| abc | def |\n| --- |\n| bar |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<p>| abc | def |\n| --- |\n| bar |</p>\n"

  debug_assert(actual == expected, "gfm_table_test_0006_l155")

}

///|
test "gfm_table_test_0007_l169" {

  let actual = to_html("| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0007_l169")

}

///|
test "gfm_table_test_0008_l197" {

  let actual = to_html("| abc | def |\n| --- | --- |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody></tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0008_l197")

}

///|
test "gfm_table_test_0009_l214" {

  let actual = to_html("Hello World\n| abc | def |\n| --- | --- |\n| bar | baz |\n", Options::{ tables: true, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<p>Hello World</p>\n<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"

  debug_assert(actual == expected, "gfm_table_test_0009_l214")

}

///|
test "gfm_strikethrough_test_0001_l11" {

  let actual = to_html("~~Hi~~ Hello, ~there~ world!\n", Options::{ tables: false, strikethrough: true, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<p><del>Hi</del> Hello, <del>there</del> world!</p>\n"

  debug_assert(actual == expected, "gfm_strikethrough_test_0001_l11")

}

///|
test "gfm_strikethrough_test_0002_l20" {

  let actual = to_html("This ~~has a\n\nnew paragraph~~.\n", Options::{ tables: false, strikethrough: true, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<p>This ~~has a</p>\n<p>new paragraph~~.</p>\n"

  debug_assert(actual == expected, "gfm_strikethrough_test_0002_l20")

}

///|
test "gfm_strikethrough_test_0003_l31" {

  let actual = to_html("This will ~~~not~~~ strike.\n", Options::{ tables: false, strikethrough: true, tasklists: false, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<p>This will ~~~not~~~ strike.</p>\n"

  debug_assert(actual == expected, "gfm_strikethrough_test_0003_l31")

}

///|
test "gfm_tasklist_test_0001_l28" {

  let actual = to_html("- [ ] foo\n- [x] bar\n", Options::{ tables: false, strikethrough: false, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<ul>\n<li><input disabled=\"\" type=\"checkbox\"/>\nfoo</li>\n<li><input disabled=\"\" type=\"checkbox\" checked=\"\"/>\nbar</li>\n</ul>\n"

  debug_assert(actual == expected, "gfm_tasklist_test_0001_l28")

}

///|
test "gfm_tasklist_test_0002_l42" {

  let actual = to_html("- [x] foo\n  - [ ] bar\n  - [x] baz\n- [ ] bim\n", Options::{ tables: false, strikethrough: false, tasklists: true, autolinks: false, smart_punctuation: false, cjk_friendly: false })

  let expected = "<ul>\n<li><input disabled=\"\" type=\"checkbox\" checked=\"\"/>\nfoo\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"/>\nbar</li>\n<li><input disabled=\"\" type=\"checkbox\" checked=\"\"/>\nbaz</li>\n</ul>\n</li>\n<li><input disabled=\"\" type=\"checkbox\"/>\nbim</li>\n</ul>\n"

  debug_assert(actual == expected, "gfm_tasklist_test_0002_l42")

}

///|
test "smart_punct_test_0001_l7" {

  let actual = to_html("\"Hello,\" said the spider.\n\"'Shelob' is my name.\"\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>“Hello,” said the spider.\n“‘Shelob’ is my name.”</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0001_l7")

}

///|
test "smart_punct_test_0002_l15" {

  let actual = to_html("'A', 'B', and 'C' are letters.\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>‘A’, ‘B’, and ‘C’ are letters.</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0002_l15")

}

///|
test "smart_punct_test_0003_l21" {

  let actual = to_html("'Oak,' 'elm,' and 'beech' are names of trees.\nSo is 'pine.'\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>‘Oak,’ ‘elm,’ and ‘beech’ are names of trees.\nSo is ‘pine.’</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0003_l21")

}

///|
test "smart_punct_test_0004_l29" {

  let actual = to_html("'He said, \"I want to go.\"'\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>‘He said, “I want to go.”’</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0004_l29")

}

///|
test "smart_punct_test_0005_l39" {

  let actual = to_html("Were you alive in the 70's?\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>Were you alive in the 70’s?</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0005_l39")

}

///|
test "smart_punct_test_0006_l45" {

  let actual = to_html("Here is some quoted '`code`' and a \"[quoted link](url)\".\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>Here is some quoted ‘<code>code</code>’ and a “<a href=\"url\">quoted link</a>”.</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0006_l45")

}

///|
test "smart_punct_test_0007_l55" {

  let actual = to_html("'tis the season to be 'jolly'\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>’tis the season to be ‘jolly’</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0007_l55")

}

///|
test "smart_punct_test_0008_l63" {

  let actual = to_html("'We'll use Jane's boat and John's truck,' Jenna said.\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>‘We’ll use Jane’s boat and John’s truck,’ Jenna said.</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0008_l63")

}

///|
test "smart_punct_test_0009_l72" {

  let actual = to_html("\"A paragraph with no closing quote.\n\n\"Second paragraph by same speaker, in fiction.\"\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>“A paragraph with no closing quote.</p>\n<p>“Second paragraph by same speaker, in fiction.”</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0009_l72")

}

///|
test "smart_punct_test_0010_l84" {

  let actual = to_html("[a]'s b'\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>[a]’s b’</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0010_l84")

}

///|
test "smart_punct_test_0011_l93" {

  let actual = to_html("\\\"This is not smart.\\\"\nThis isn\\'t either.\n5\\'8\\\"\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>\"This is not smart.\"\nThis isn't either.\n5'8\"</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0011_l93")

}

///|
test "smart_punct_test_0012_l105" {

  let actual = to_html("Some dashes:  em---em\nen--en\nem --- em\nen -- en\n2--3\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>Some dashes:  em—em\nen–en\nem — em\nen – en\n2–3</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0012_l105")

}

///|
test "smart_punct_test_0013_l130" {

  let actual = to_html("one-\ntwo--\nthree---\nfour----\nfive-----\nsix------\nseven-------\neight--------\nnine---------\nthirteen-------------.\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>one-\ntwo–\nthree—\nfour––\nfive—–\nsix——\nseven—––\neight––––\nnine———\nthirteen———––.</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0013_l130")

}

///|
test "smart_punct_test_0014_l156" {

  let actual = to_html("Escaped hyphens: \\-- \\-\\-\\-.\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>Escaped hyphens: -- ---.</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0014_l156")

}

///|
test "smart_punct_test_0015_l164" {

  let actual = to_html("Ellipses...and...and....\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>Ellipses…and…and….</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0015_l164")

}

///|
test "smart_punct_test_0016_l173" {

  let actual = to_html("No ellipses\\.\\.\\.\n", Options::{ tables: false, strikethrough: false, tasklists: false, autolinks: false, smart_punctuation: true, cjk_friendly: false })

  let expected = "<p>No ellipses...</p>\n"

  debug_assert(actual == expected, "smart_punct_test_0016_l173")

}

///|
test "gfm_autolink_www_basic" {

  let actual = to_html("www.commonmark.org\n", Options::gfm())

  let expected = "<p><a href=\"http://www.commonmark.org\">www.commonmark.org</a></p>\n"

  debug_assert(actual == expected, "gfm_autolink_www_basic")

}

///|
test "gfm_autolink_www_path" {

  let actual = to_html("Visit www.commonmark.org/help for more information.\n", Options::gfm())

  let expected = "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n"

  debug_assert(actual == expected, "gfm_autolink_www_path")

}

///|
test "gfm_autolink_www_trailing_dot" {

  let actual = to_html("Visit www.commonmark.org.\n\nVisit www.commonmark.org/a.b.\n", Options::gfm())

  let expected = "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>Visit <a href=\"http://www.commonmark.org/a.b\">www.commonmark.org/a.b</a>.</p>\n"

  debug_assert(actual == expected, "gfm_autolink_www_trailing_dot")

}

///|
test "gfm_autolink_www_parens" {

  let actual = to_html("www.google.com/search?q=Markup+(business)\n\nwww.google.com/search?q=Markup+(business)))\n\n(www.google.com/search?q=Markup+(business))\n\n(www.google.com/search?q=Markup+(business)\n", Options::gfm())

  let expected = "<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>)</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n"

  debug_assert(actual == expected, "gfm_autolink_www_parens")

}

///|
test "gfm_autolink_http_https" {

  let actual = to_html("http://example.com\n\nhttps://example.com/foo/bar?a=1&b=2\n", Options::gfm())

  let expected = "<p><a href=\"http://example.com\">http://example.com</a></p>\n<p><a href=\"https://example.com/foo/bar?a=1&amp;b=2\">https://example.com/foo/bar?a=1&amp;b=2</a></p>\n"

  debug_assert(actual == expected, "gfm_autolink_http_https")

}

///|
test "gfm_autolink_email_basic" {

  let actual = to_html("foo@bar.baz\n", Options::gfm())

  let expected = "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n"

  debug_assert(actual == expected, "gfm_autolink_email_basic")

}

///|
test "gfm_autolink_email_punct" {

  let actual = to_html("hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n", Options::gfm())

  let expected = "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n"

  debug_assert(actual == expected, "gfm_autolink_email_punct")

}

///|
test "gfm_autolink_email_trailing_dot" {

  let actual = to_html("a.b-c_d@a.b.\n", Options::gfm())

  let expected = "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n"

  debug_assert(actual == expected, "gfm_autolink_email_trailing_dot")

}
