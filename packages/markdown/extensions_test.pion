///| Unit tests for P0/P1 red-team fixes, `parse_with_offsets`, footnotes, and frontmatter.

///|
test "ext_deep_nesting_no_stackoverflow" {
  // 5000 nested blockquotes & 3000 nested lists must render iteratively without stack overflow.
  let sb_bq = StringBuilder::new()
  let mut i = 0
  while i < 5000 {
    sb_bq.write_string("> ")
    i = i + 1
  }
  sb_bq.write_string("hi\n")
  let html_bq = to_html_pulldown(sb_bq.to_string(), Options::commonmark())
  debug_assert(html_bq.length() > 100000, "deep blockquote rendered")

  let sb_li = StringBuilder::new()
  i = 0
  while i < 3000 {
    sb_li.write_string("- ")
    i = i + 1
  }
  sb_li.write_string("ok\n")
  let html_li = to_html_pulldown(sb_li.to_string(), Options::commonmark())
  debug_assert(html_li.length() > 40000, "deep list rendered")
}

///|
test "ext_linear_pathological_inline" {
  // Nested emphasis, smart quotes, and unclosed comments must complete in linear time.
  let sb1 = StringBuilder::new()
  let mut i = 0
  while i < 2000 {
    sb1.write_string("*a **a ")
    i = i + 1
  }
  sb1.write_string("b")
  i = 0
  while i < 2000 {
    sb1.write_string(" a** a*")
    i = i + 1
  }
  let h1 = to_html_pulldown(sb1.to_string(), Options::commonmark())
  debug_assert(h1.length() > 20000, "nested emphasis ok")

  let sb2 = StringBuilder::new()
  sb2.write_string("</")
  i = 0
  while i < 4000 {
    sb2.write_string("<!--")
    i = i + 1
  }
  let h2 = to_html_pulldown(sb2.to_string(), Options::commonmark())
  debug_assert(h2.length() > 16000, "unclosed comments ok")
}

///|
test "ext_parse_with_offsets_basic" {
  let src = "# Title\n\nHello *world*!\n"
  let evs = parse_with_offsets(src, Options::commonmark())
  debug_assert(evs.length() > 5, "expected multiple offset events")
  // Verify heading text offset points to "Title"
  let mut saw_title = false
  let mut saw_world = false
  let mut i = 0
  while i < evs.length() {
    let oe = evs[i]
    debug_assert(oe.start >= 0 && oe.end >= oe.start && oe.end <= src.length(), "valid byte range")
    match oe.event {
      Event::Text(t) => {
        if t == "Title" {
          debug_assert(src.slice(oe.start, oe.end) == "Title", "Title offset slice matches")
          saw_title = true
        } else if t == "world" {
          debug_assert(src.slice(oe.start, oe.end) == "world", "world offset slice matches")
          saw_world = true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  debug_assert(saw_title, "saw Title")
  debug_assert(saw_world, "saw world")
}

///|
test "ext_footnotes_basic" {
  let src = "Lorem ipsum.[^a]\n\n[^a]: Cool.\n"
  let opts = ExtendedOptions::{
    base: Options::gfm(),
    footnotes: true,
    yaml_frontmatter: false,
    pluses_frontmatter: false,
  }
  let got = to_html_pulldown_extended(src, opts)
  let expected = "<p>Lorem ipsum.<sup class=\"footnote-reference\"><a href=\"#a\">1</a></sup></p>\n<div class=\"footnote-definition\" id=\"a\"><sup class=\"footnote-definition-label\">1</sup>\n<p>Cool.</p>\n</div>\n"
  debug_assert(got == expected, "ext_footnotes_basic: got=" + got)
}

///|
test "ext_footnotes_bang" {
  let src = "![^1]\n\n[^1]: foo\n"
  let opts = ExtendedOptions::{
    base: Options::gfm(),
    footnotes: true,
    yaml_frontmatter: false,
    pluses_frontmatter: false,
  }
  let got = to_html_pulldown_extended(src, opts)
  let expected = "<p>!<sup class=\"footnote-reference\"><a href=\"#1\">1</a></sup></p>\n<div class=\"footnote-definition\" id=\"1\"><sup class=\"footnote-definition-label\">1</sup>\n<p>foo</p>\n</div>\n"
  debug_assert(got == expected, "ext_footnotes_bang: got=" + got)
}

///|
test "ext_yaml_and_pluses_frontmatter" {
  let yaml_src = "---\ntitle: x\nlist:\n    - a\n---\nThings\n"
  let got_y = to_html_pulldown_extended(yaml_src, ExtendedOptions::full())
  debug_assert(got_y == "<p>Things</p>\n", "yaml frontmatter: got=" + got_y)

  let plus_src = "+++\ntitle = 'x'\n+++\nThings\n"
  let got_p = to_html_pulldown_extended(plus_src, ExtendedOptions::full())
  debug_assert(got_p == "<p>Things</p>\n", "pluses frontmatter: got=" + got_p)
}
