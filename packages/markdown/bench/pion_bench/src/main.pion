///| Pion Native head-to-head benchmark binary for `packages/markdown`.

import "markdown"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: markdown_bench <input.md> [commonmark|gfm|ast|plain_text|plain_text_120]")
    return 2
  }
  let path = args[1]
  let mode = if args.length() >= 3 { args[2] } else { "commonmark" }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "error: failed to read input file")
      return 1
    }
  }
  let gfm_opts = markdown::Options::{
    tables: true,
    strikethrough: true,
    tasklists: true,
    autolinks: false,
    smart_punctuation: false,
    cjk_friendly: false,
  }
  if mode == "ast" {
    let doc = markdown::parse_document(src, gfm_opts)
    io_println(world, "blocks=" + doc.blocks.length().to_string())
    return 0
  }
  if mode == "plain_text" {
    let pt = markdown::to_plain_text(src, gfm_opts, markdown::PlainTextOptions::default())
    io_println(world, "len=" + pt.length().to_string())
    return 0
  }
  if mode == "plain_text_120" {
    let pt = markdown::to_plain_text(
      src,
      gfm_opts,
      markdown::PlainTextOptions::{
        image_placeholder: "[img]",
        link_placeholder: "[link]",
        code_block_placeholder: "[code]",
        math_placeholder: "[math]",
        collapse_whitespace: true,
        max_chars: 120,
      },
    )
    io_println(world, pt)
    return 0
  }
  let opts = if mode == "gfm" { gfm_opts } else { markdown::Options::commonmark() }
  let html = markdown::to_html_pulldown(src, opts)
  io_print(world, html)
  0
}
