///| Pion Native head-to-head benchmark binary for `packages/markdown`.

import "markdown"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: markdown_bench <input.md> [commonmark|gfm]")
    return 2
  }
  let path = args[1]
  let mode = if args.length() >= 3 { args[2] } else { "commonmark" }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "error: failed to read input file")
      return 1
    }
  }
  let opts = if mode == "gfm" {
    markdown::Options::{
      tables: true,
      strikethrough: true,
      tasklists: true,
      autolinks: false,
      smart_punctuation: false,
      cjk_friendly: false,
    }
  } else {
    markdown::Options::commonmark()
  }
  let html = markdown::to_html_pulldown(src, opts)
  io_print(world, html)
  0
}
