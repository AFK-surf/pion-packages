///| JSON-Schema-Test-Suite (Draft 2020-12 & Draft-07) array & object compliance tests.

import "json5"

///|
test "compliance_array_prefix_items_and_items_2020_12" {
  // prefixItems alone allows extra items
  let s1 = "{\"prefixItems\":[{\"type\":\"integer\"},{\"type\":\"string\"}]}"
  check_valid(s1, "[1, \"foo\"]", true, "prefixItems exact match")
  check_valid(s1, "[1, \"foo\", true, null]", true, "prefixItems allows extra items")
  check_valid(s1, "[1]", true, "prefixItems allows fewer items")
  check_valid(s1, "[\"foo\", 1]", false, "prefixItems wrong types")

  // prefixItems + items: false forbids extra items
  let s2 = "{\"prefixItems\":[{\"type\":\"integer\"},{\"type\":\"string\"}],\"items\":false}"
  check_valid(s2, "[1, \"foo\"]", true, "prefixItems+items:false exact")
  check_valid(s2, "[1]", true, "prefixItems+items:false shorter")
  check_valid(s2, "[1, \"foo\", 2]", false, "prefixItems+items:false rejects extra")

  // prefixItems + items schema applies only to indices >= prefixItems.length()
  let s3 = "{\"prefixItems\":[{\"type\":\"integer\"}],\"items\":{\"type\":\"string\"}}"
  check_valid(s3, "[1, \"a\", \"b\"]", true, "items applies after prefixItems")
  check_valid(s3, "[1, \"a\", 2]", false, "items rejects wrong tail element")

  // items alone applies to all elements
  let s4 = "{\"items\":{\"type\":\"integer\"}}"
  check_valid(s4, "[1, 2, 3]", true, "items all valid")
  check_valid(s4, "[]", true, "empty array valid")
  check_valid(s4, "[1, \"x\"]", false, "items rejects wrong element")
}

///|
test "compliance_array_draft7_tuple_items_and_additional_items" {
  // Draft-07 array-tuple items + additionalItems: false
  let s1 = "{\"items\":[{\"type\":\"integer\"},{\"type\":\"string\"}],\"additionalItems\":false}"
  check_valid_draft7(s1, "[1, \"foo\"]", true, "draft7 tuple exact")
  check_valid_draft7(s1, "[1]", true, "draft7 tuple shorter")
  check_valid_draft7(s1, "[1, \"foo\", true]", false, "draft7 additionalItems:false rejects extra")

  // Draft-07 array-tuple items + additionalItems schema
  let s2 = "{\"items\":[{\"type\":\"integer\"}],\"additionalItems\":{\"type\":\"boolean\"}}"
  check_valid_draft7(s2, "[1, true, false]", true, "draft7 additionalItems schema valid")
  check_valid_draft7(s2, "[1, true, \"no\"]", false, "draft7 additionalItems schema rejects")

  // Draft-07 additionalItems ignored when items is single schema or absent
  let s3 = "{\"items\":{\"type\":\"integer\"},\"additionalItems\":false}"
  check_valid_draft7(s3, "[1, 2, 3]", true, "draft7 additionalItems ignored with single items")
  let s4 = "{\"additionalItems\":false}"
  check_valid_draft7(s4, "[1, 2, 3]", true, "draft7 additionalItems ignored without items")
}

///|
test "compliance_array_contains_min_max_contains" {
  // basic contains (default minContains = 1)
  check_valid("{\"contains\":{\"minimum\":5}}", "[3, 4, 5]", true, "contains matches 5")
  check_valid("{\"contains\":{\"minimum\":5}}", "[1, 2, 3]", false, "contains no match")
  check_valid("{\"contains\":{\"minimum\":5}}", "[]", false, "contains empty array fails")

  // minContains = 0 allows 0 matches
  check_valid("{\"contains\":{\"type\":\"string\"},\"minContains\":0}", "[1, 2, 3]", true, "minContains 0 allows none")
  check_valid("{\"contains\":{\"type\":\"string\"},\"minContains\":2}", "[\"a\", 1]", false, "minContains 2 fails with 1")
  check_valid("{\"contains\":{\"type\":\"string\"},\"minContains\":2}", "[\"a\", \"b\", 1]", true, "minContains 2 passes with 2")

  // maxContains
  check_valid("{\"contains\":{\"type\":\"integer\"},\"maxContains\":2}", "[1, 2, \"a\"]", true, "maxContains 2 passes with 2")
  check_valid("{\"contains\":{\"type\":\"integer\"},\"maxContains\":2}", "[1, 2, 3]", false, "maxContains 2 fails with 3")
  check_valid("{\"contains\":{\"type\":\"integer\"},\"minContains\":0,\"maxContains\":1}", "[\"a\", \"b\"]", true, "min 0 max 1 passes with 0")

  // minItems / maxItems
  check_valid("{\"minItems\":2,\"maxItems\":3}", "[1, 2]", true, "minItems 2 ok")
  check_valid("{\"minItems\":2,\"maxItems\":3}", "[1]", false, "minItems 2 fails")
  check_valid("{\"minItems\":2,\"maxItems\":3}", "[1, 2, 3, 4]", false, "maxItems 3 fails")
}

///|
test "compliance_array_unique_items" {
  check_valid("{\"uniqueItems\":true}", "[1, 2, 3]", true, "unique ints")
  check_valid("{\"uniqueItems\":true}", "[1, 1.0]", false, "1 and 1.0 are equal duplicates")
  check_valid("{\"uniqueItems\":true}", "[1, true]", true, "1 and true are distinct")
  check_valid("{\"uniqueItems\":true}", "[0, false]", true, "0 and false are distinct")
  check_valid("{\"uniqueItems\":true}", "[{\"a\":1,\"b\":2}, {\"b\":2,\"a\":1}]", false, "objects with same keys different order are duplicates")
  check_valid("{\"uniqueItems\":true}", "[[1,2], [2,1]]", true, "arrays with different order are distinct")
  check_valid("{\"uniqueItems\":true}", "[[1,2], [1,2]]", false, "identical arrays are duplicates")
  check_valid("{\"uniqueItems\":false}", "[1, 1, 1]", true, "uniqueItems false allows duplicates")
}

///|
test "compliance_object_properties_pattern_additional_property_names" {
  let s1 = "{\"properties\":{\"foo\":{\"type\":\"integer\"},\"bar\":{\"type\":\"string\"}},\"patternProperties\":{\"^S_\":{\"type\":\"string\"},\"^I_\":{\"type\":\"integer\"}},\"additionalProperties\":{\"type\":\"boolean\"}}"
  check_valid(s1, "{\"foo\":1,\"bar\":\"hi\",\"S_a\":\"ok\",\"I_1\":42,\"extra\":true}", true, "all object property categories valid")
  check_valid(s1, "{\"foo\":\"bad\"}", false, "properties rejects wrong type")
  check_valid(s1, "{\"S_a\":123}", false, "patternProperties rejects wrong type")
  check_valid(s1, "{\"extra\":123}", false, "additionalProperties rejects wrong type")

  // property matching both properties and patternProperties must satisfy BOTH
  let s2 = "{\"properties\":{\"S_x\":{\"minLength\":3}},\"patternProperties\":{\"^S_\":{\"pattern\":\"^[A-Z]+$\"}},\"additionalProperties\":false}"
  check_valid(s2, "{\"S_x\":\"ABC\"}", true, "matches both properties and patternProperties")
  check_valid(s2, "{\"S_x\":\"AB\"}", false, "fails properties minLength")
  check_valid(s2, "{\"S_x\":\"abc\"}", false, "fails patternProperties pattern")
  check_valid(s2, "{\"other\":1}", false, "additionalProperties:false rejects unmatched key")

  // propertyNames
  let s3 = "{\"propertyNames\":{\"maxLength\":3,\"pattern\":\"^[a-z]+$\"}}"
  check_valid(s3, "{\"a\":1,\"foo\":2}", true, "propertyNames valid")
  check_valid(s3, "{\"toolong\":1}", false, "propertyNames rejects long key")
  check_valid(s3, "{\"A1\":1}", false, "propertyNames rejects pattern mismatch")
  check_valid(s3, "{}", true, "propertyNames empty object valid")
}

///|
test "compliance_object_required_min_max_and_dependencies" {
  check_valid("{\"required\":[\"foo\",\"bar\"]}", "{\"foo\":1,\"bar\":2,\"baz\":3}", true, "required satisfied")
  check_valid("{\"required\":[\"foo\",\"bar\"]}", "{\"foo\":1}", false, "required missing bar")
  check_valid("{\"required\":[\"foo\"]}", "123", true, "required ignores non-object")

  check_valid("{\"minProperties\":1,\"maxProperties\":2}", "{\"a\":1}", true, "minProperties 1 ok")
  check_valid("{\"minProperties\":1,\"maxProperties\":2}", "{}", false, "minProperties 1 fails")
  check_valid("{\"minProperties\":1,\"maxProperties\":2}", "{\"a\":1,\"b\":2,\"c\":3}", false, "maxProperties 2 fails")

  // dependentRequired (Draft 2020-12)
  let dr = "{\"dependentRequired\":{\"credit_card\":[\"billing_address\"]}}"
  check_valid(dr, "{\"name\":\"Alice\"}", true, "dependentRequired trigger absent")
  check_valid(dr, "{\"credit_card\":\"1234\",\"billing_address\":\"1 Main\"}", true, "dependentRequired satisfied")
  check_valid(dr, "{\"credit_card\":\"1234\"}", false, "dependentRequired missing target")

  // dependentSchemas (Draft 2020-12)
  let ds = "{\"dependentSchemas\":{\"foo\":{\"properties\":{\"bar\":{\"type\":\"integer\"}},\"required\":[\"bar\"]}}}"
  check_valid(ds, "{}", true, "dependentSchemas trigger absent")
  check_valid(ds, "{\"foo\":1,\"bar\":2}", true, "dependentSchemas satisfied")
  check_valid(ds, "{\"foo\":1,\"bar\":\"no\"}", false, "dependentSchemas fails type")
  check_valid(ds, "{\"foo\":1}", false, "dependentSchemas fails required")

  // dependencies (Draft-07: both array form and schema form)
  let dep = "{\"dependencies\":{\"a\":[\"b\",\"c\"],\"x\":{\"properties\":{\"y\":{\"type\":\"number\"}},\"required\":[\"y\"]}}}"
  check_valid_draft7(dep, "{}", true, "dependencies none triggered")
  check_valid_draft7(dep, "{\"a\":1,\"b\":2,\"c\":3}", true, "dependencies array satisfied")
  check_valid_draft7(dep, "{\"a\":1,\"b\":2}", false, "dependencies array missing c")
  check_valid_draft7(dep, "{\"x\":1,\"y\":3.14}", true, "dependencies schema satisfied")
  check_valid_draft7(dep, "{\"x\":1,\"y\":\"bad\"}", false, "dependencies schema fails")
}
