///| Wasm32 + Native smoke entry for `packages/jsonschema`.

import "jsonschema"
import "json5"

///|
pub fn smoke() -> Int {
  // 1. Draft 2020-12 with $defs, $ref, pattern, uniqueItems, unevaluatedProperties, format
  let schema_str = "{\"$defs\":{\"tag\":{\"type\":\"string\",\"minLength\":1,\"pattern\":\"^[a-z0-9-]+$\"}},\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"format\":\"uuid\"},\"email\":{\"type\":\"string\",\"format\":\"email\"},\"tags\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/tag\"},\"uniqueItems\":true}},\"required\":[\"id\",\"email\"],\"unevaluatedProperties\":false}"
  let compiled = match jsonschema::compile_str(schema_str) {
    Ok(c) => c
    Err(_) => return -1
  }
  let good_inst = match json5::parse_with_options("{\"id\":\"2eb8aa08-aa98-11ea-b4aa-73b441d16380\",\"email\":\"dev@example.com\",\"tags\":[\"pion\",\"wasm-32\"]}", json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(_) => return -2
  }
  let opts = jsonschema::ValidateOptions::with_formats(true)
  if !compiled.is_valid_with(good_inst, opts) {
    return -3
  }
  let bad_inst = match json5::parse_with_options("{\"id\":\"not-a-uuid\",\"email\":\"bad\",\"tags\":[\"a\",\"a\"],\"extra\":1}", json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(_) => return -4
  }
  let errs = compiled.validate_with(bad_inst, opts)
  if errs.length() < 3 {
    return -5
  }

  // 2. Unicode codepoint length check ("😀" == 1, "中文" == 2)
  let uni = match jsonschema::compile_str("{\"minLength\":2,\"maxLength\":2}") {
    Ok(c) => c
    Err(_) => return -6
  }
  if !uni.is_valid(json5::Json5Value::Str("中文")) {
    return -7
  }
  if uni.is_valid(json5::Json5Value::Str("😀")) {
    return -8
  }

  // 3. Direct $ref cycle + 50,000-level deep nesting in Wasm32 (0 trap)
  let cyc = match jsonschema::compile_str("{\"$ref\":\"#\"}") {
    Ok(c) => c
    Err(_) => return -9
  }
  if cyc.is_valid(json5::Json5Value::Null) {
    return -10
  }
  let mut deep = json5::Json5Value::Number(1.0)
  let mut i = 0
  while i < 50000 {
    deep = json5::Json5Value::Array([deep])
    i = i + 1
  }
  let rec = match jsonschema::compile_str("{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"array\",\"items\":{\"$ref\":\"#\"}}]}") {
    Ok(c) => c
    Err(_) => return -11
  }
  let ok_deep = !rec.is_valid(deep)
  while true {
    match deep {
      json5::Json5Value::Array(arr) => {
        if arr.length() == 1 {
          deep = arr[0]
        } else {
          break
        }
      }
      _ => break
    }
  }
  if !ok_deep {
    return -12
  }
  errs.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "jsonschema_wasm_smoke: OK bad_errs=" + r.to_string())
    0
  } else {
    io_println(world, "jsonschema_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
