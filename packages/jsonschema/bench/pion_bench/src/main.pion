///| Head-to-head benchmark driver for `packages/jsonschema`.

import "jsonschema"
import "json5"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if src.code_unit_at(i) == 10 {
      if i > start {
        out.push(src.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(src.slice(start, n))
  }
  out
}

fn fnv1a_step(h : Int64, b : Int64) -> Int64 {
  ((h ^ b) * 16777619L) & 0xFFFFFFFFL
}

fn run_batch(
  world : World,
  schema_path : String,
  jsonl_path : String,
  iters : Int,
) -> Int {
  let schema_src = match fs_read(world, schema_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read schema")
      return 1
    }
  }
  let jsonl_src = match fs_read(world, jsonl_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read instances")
      return 1
    }
  }
  let compiled = match jsonschema::compile_str(schema_src) {
    Ok(c) => c
    Err(e) => {
      io_println(world, "error: compile failed: " + e.message)
      return 1
    }
  }
  let lines = split_lines(jsonl_src)
  let instances : Array[json5::Json5Value] = []
  let mut i = 0
  while i < lines.length() {
    match json5::parse_with_options(lines[i], json5::ParseOptions::strict_json()) {
      Ok(v) => instances.push(v)
      Err(e) => {
        io_println(world, "error: parse instance failed: " + e.message)
        return 1
      }
    }
    i = i + 1
  }

  let mut valid = 0
  let mut invalid = 0
  let mut checksum : Int64 = 2166136261L
  let n = instances.length()
  let mut it = 0
  while it < iters {
    let mut j = 0
    while j < n {
      let ok = compiled.is_valid(instances[j])
      if ok {
        valid = valid + 1
        checksum = fnv1a_step(checksum, 1L)
      } else {
        invalid = invalid + 1
        checksum = fnv1a_step(checksum, 0L)
      }
      j = j + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "valid=" + valid.to_string() + " invalid=" + invalid.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

fn run_e2e(world : World, pairs_path : String, iters : Int) -> Int {
  let src = match fs_read(world, pairs_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read pairs")
      return 1
    }
  }
  let lines = split_lines(src)
  let schemas : Array[json5::Json5Value] = []
  let instances : Array[json5::Json5Value] = []
  let mut i = 0
  while i < lines.length() {
    let obj = match json5::parse_with_options(lines[i], json5::ParseOptions::strict_json()) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "error: parse pair failed: " + e.message)
        return 1
      }
    }
    match (json5::get(obj, "schema"), json5::get(obj, "instance")) {
      (Some(s), Some(inst)) => {
        schemas.push(s)
        instances.push(inst)
      }
      _ => {
        io_println(world, "error: malformed pair")
        return 1
      }
    }
    i = i + 1
  }

  let mut compiled_cnt = 0
  let mut valid = 0
  let mut invalid = 0
  let mut checksum : Int64 = 2166136261L
  let n = schemas.length()
  let mut it = 0
  while it < iters {
    let mut j = 0
    while j < n {
      match jsonschema::compile(schemas[j]) {
        Ok(c) => {
          compiled_cnt = compiled_cnt + 1
          if c.is_valid(instances[j]) {
            valid = valid + 1
            checksum = fnv1a_step(checksum, 1L)
          } else {
            invalid = invalid + 1
            checksum = fnv1a_step(checksum, 0L)
          }
        }
        Err(e) => {
          io_println(world, "error: compile pair failed: " + e.message)
          return 1
        }
      }
      j = j + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "compiled=" + compiled_cnt.to_string() + " valid=" + valid.to_string() + " invalid=" + invalid.to_string() + " checksum=" + checksum.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_jsonschema batch <schema> <jsonl> <iters> | e2e <pairs> <iters>")
    return 1
  }
  let mode = args[1]
  if mode == "batch" {
    if args.length() < 5 {
      io_println(world, "usage: pion_jsonschema batch <schema> <jsonl> <iters>")
      return 1
    }
    run_batch(world, args[2], args[3], parse_int_arg(args[4], 1))
  } else if mode == "e2e" {
    run_e2e(world, args[2], parse_int_arg(args[3], 1))
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
