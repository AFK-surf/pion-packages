///| JSON-Schema-Test-Suite (Draft 2020-12 & Draft-07) core compliance tests:
///| boolean schemas, type, enum, const, numeric constraints, string constraints.

import "json5"

fn check_valid(schema_json : String, instance_json : String, expected : Bool, msg : String) -> Unit {
  let compiled = match compile_str(schema_json) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, msg + " (compile failed: " + e.message + ")")
      return
    }
  }
  let inst = match json5::parse_with_options(instance_json, json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, msg + " (instance parse failed: " + e.message + ")")
      return
    }
  }
  let got_fast = compiled.is_valid(inst)
  debug_assert(got_fast == expected, msg + " (is_valid mismatch)")
  let errs = compiled.validate(inst)
  debug_assert((errs.length() == 0) == expected, msg + " (validate mismatch)")
}

fn check_valid_draft7(schema_json : String, instance_json : String, expected : Bool, msg : String) -> Unit {
  let compiled = match compile_str_with(schema_json, CompileOptions::draft7()) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, msg + " (draft7 compile failed: " + e.message + ")")
      return
    }
  }
  let inst = match json5::parse_with_options(instance_json, json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, msg + " (instance parse failed: " + e.message + ")")
      return
    }
  }
  let got_fast = compiled.is_valid(inst)
  debug_assert(got_fast == expected, msg + " (draft7 is_valid mismatch)")
  let errs = compiled.validate(inst)
  debug_assert((errs.length() == 0) == expected, msg + " (draft7 validate mismatch)")
}

///|
test "compliance_boolean_schemas" {
  check_valid("true", "null", true, "true accepts null")
  check_valid("true", "42", true, "true accepts number")
  check_valid("true", "\"hello\"", true, "true accepts string")
  check_valid("true", "[1,2]", true, "true accepts array")
  check_valid("true", "{\"a\":1}", true, "true accepts object")
  check_valid("false", "null", false, "false rejects null")
  check_valid("false", "42", false, "false rejects number")
  check_valid("false", "\"hello\"", false, "false rejects string")
  check_valid("false", "[]", false, "false rejects array")
  check_valid("false", "{}", false, "false rejects object")
}

///|
test "compliance_type_all_primitives_and_integer_exactness" {
  // integer
  check_valid("{\"type\":\"integer\"}", "1", true, "1 is integer")
  check_valid("{\"type\":\"integer\"}", "1.0", true, "1.0 is integer in JSON Schema")
  check_valid("{\"type\":\"integer\"}", "-0.0", true, "-0.0 is integer")
  check_valid("{\"type\":\"integer\"}", "1e20", true, "1e20 is integer")
  check_valid("{\"type\":\"integer\"}", "1.5", false, "1.5 is not integer")
  check_valid("{\"type\":\"integer\"}", "\"1\"", false, "string is not integer")
  check_valid("{\"type\":\"integer\"}", "true", false, "boolean is not integer")
  check_valid("{\"type\":\"integer\"}", "null", false, "null is not integer")

  // number
  check_valid("{\"type\":\"number\"}", "1", true, "1 is number")
  check_valid("{\"type\":\"number\"}", "1.5", true, "1.5 is number")
  check_valid("{\"type\":\"number\"}", "-3.14e-2", true, "scientific float is number")
  check_valid("{\"type\":\"number\"}", "\"1.5\"", false, "string is not number")
  check_valid("{\"type\":\"number\"}", "false", false, "bool is not number")

  // string, boolean, null, array, object
  check_valid("{\"type\":\"string\"}", "\"abc\"", true, "string matches string")
  check_valid("{\"type\":\"string\"}", "123", false, "number not string")
  check_valid("{\"type\":\"boolean\"}", "true", true, "true is boolean")
  check_valid("{\"type\":\"boolean\"}", "false", true, "false is boolean")
  check_valid("{\"type\":\"boolean\"}", "0", false, "0 is not boolean")
  check_valid("{\"type\":\"null\"}", "null", true, "null is null")
  check_valid("{\"type\":\"null\"}", "false", false, "false is not null")
  check_valid("{\"type\":\"array\"}", "[1,2,3]", true, "array is array")
  check_valid("{\"type\":\"array\"}", "{}", false, "object is not array")
  check_valid("{\"type\":\"object\"}", "{\"a\":1}", true, "object is object")
  check_valid("{\"type\":\"object\"}", "[]", false, "array is not object")

  // type array
  check_valid("{\"type\":[\"string\",\"null\"]}", "\"ok\"", true, "type array matches string")
  check_valid("{\"type\":[\"string\",\"null\"]}", "null", true, "type array matches null")
  check_valid("{\"type\":[\"string\",\"null\"]}", "42", false, "type array rejects int")
  check_valid("{\"type\":[\"integer\",\"boolean\"]}", "2.0", true, "type array matches 2.0 as integer")
  check_valid("{\"type\":[\"integer\",\"boolean\"]}", "2.5", false, "type array rejects 2.5")
}

///|
test "compliance_enum_and_const_deep_equality" {
  // enum with heterogeneous values
  let enum_schema = "{\"enum\":[1, \"foo\", true, null, {\"a\":1,\"b\":2}, [1,2]]}"
  check_valid(enum_schema, "1", true, "enum matches 1")
  check_valid(enum_schema, "1.0", true, "enum matches 1.0 == 1")
  check_valid(enum_schema, "true", true, "enum matches true")
  check_valid(enum_schema, "false", false, "enum rejects false")
  check_valid(enum_schema, "null", true, "enum matches null")
  check_valid(enum_schema, "{\"b\":2,\"a\":1}", true, "enum object equality is key-order independent")
  check_valid(enum_schema, "{\"a\":1,\"b\":2,\"c\":3}", false, "enum rejects extra object key")
  check_valid(enum_schema, "[1,2]", true, "enum matches array")
  check_valid(enum_schema, "[2,1]", false, "enum array equality is order dependent")

  // boolean vs number distinction
  check_valid("{\"enum\":[0, false]}", "0", true, "0 matches 0")
  check_valid("{\"enum\":[0]}", "false", false, "false != 0")
  check_valid("{\"enum\":[1]}", "true", false, "true != 1")
  check_valid("{\"const\":1}", "1.0", true, "const 1 == 1.0")
  check_valid("{\"const\":1}", "true", false, "const 1 != true")
  check_valid("{\"const\":{\"x\":[1,{\"k\":\"v\"}],\"y\":null}}", "{\"y\":null,\"x\":[1,{\"k\":\"v\"}]}", true, "const deep nested object order independent")
  check_valid("{\"const\":{\"x\":[1,{\"k\":\"v\"}],\"y\":null}}", "{\"y\":null,\"x\":[{\"k\":\"v\"},1]}", false, "const deep array order dependent")
}

///|
test "compliance_numeric_bounds_and_multiple_of" {
  check_valid("{\"minimum\":1.1}", "1.1", true, "minimum boundary inclusive")
  check_valid("{\"minimum\":1.1}", "2.6", true, "above minimum")
  check_valid("{\"minimum\":1.1}", "0.6", false, "below minimum")
  check_valid("{\"minimum\":1.1}", "\"x\"", true, "minimum ignores non-number")

  check_valid("{\"maximum\":3.0}", "3.0", true, "maximum boundary inclusive")
  check_valid("{\"maximum\":3.0}", "3.5", false, "above maximum")
  check_valid("{\"maximum\":3.0}", "2.5", true, "below maximum")

  check_valid("{\"exclusiveMinimum\":1.1}", "1.1", false, "exclusiveMinimum boundary exclusive")
  check_valid("{\"exclusiveMinimum\":1.1}", "2.2", true, "above exclusiveMinimum")
  check_valid("{\"exclusiveMaximum\":3.0}", "3.0", false, "exclusiveMaximum boundary exclusive")
  check_valid("{\"exclusiveMaximum\":3.0}", "2.2", true, "below exclusiveMaximum")

  // multipleOf integer & float precision & overflow safety
  check_valid("{\"multipleOf\":2}", "0", true, "0 multipleOf 2")
  check_valid("{\"multipleOf\":2}", "4", true, "4 multipleOf 2")
  check_valid("{\"multipleOf\":2}", "7", false, "7 not multipleOf 2")
  check_valid("{\"multipleOf\":2}", "4.5", false, "4.5 not multipleOf 2")
  check_valid("{\"multipleOf\":1.5}", "0", true, "0 multipleOf 1.5")
  check_valid("{\"multipleOf\":1.5}", "4.5", true, "4.5 multipleOf 1.5")
  check_valid("{\"multipleOf\":1.5}", "35", false, "35 not multipleOf 1.5")
  check_valid("{\"multipleOf\":0.01}", "1.15", true, "1.15 multipleOf 0.01 (float precision)")
  check_valid("{\"multipleOf\":0.01}", "1.151", false, "1.151 not multipleOf 0.01")
  check_valid("{\"multipleOf\":0.0001}", "0.0075", true, "0.0075 multipleOf 0.0001")
  check_valid("{\"multipleOf\":0.0001}", "0.00751", false, "0.00751 not multipleOf 0.0001")
  check_valid("{\"multipleOf\":0.123456789}", "1e308", false, "float division = inf rejected safely")
  check_valid("{\"multipleOf\":2}", "\"foo\"", true, "multipleOf ignores non-number")
}

///|
test "compliance_string_unicode_codepoint_length_and_pattern" {
  // ASCII length
  check_valid("{\"minLength\":2,\"maxLength\":4}", "\"ab\"", true, "len 2 valid")
  check_valid("{\"minLength\":2,\"maxLength\":4}", "\"abcd\"", true, "len 4 valid")
  check_valid("{\"minLength\":2,\"maxLength\":4}", "\"a\"", false, "len 1 too short")
  check_valid("{\"minLength\":2,\"maxLength\":4}", "\"abcde\"", false, "len 5 too long")
  check_valid("{\"minLength\":2}", "123", true, "minLength ignores non-string")

  // Unicode codepoint length (NOT UTF-8 byte count!)
  // "😀" is 4 UTF-8 bytes, 1 Unicode codepoint
  check_valid("{\"minLength\":1,\"maxLength\":1}", "\"😀\"", true, "emoji is 1 codepoint")
  check_valid("{\"minLength\":2}", "\"😀\"", false, "emoji is not 2 codepoints")
  // "中文" is 6 UTF-8 bytes, 2 Unicode codepoints
  check_valid("{\"minLength\":2,\"maxLength\":2}", "\"中文\"", true, "CJK 2 chars is 2 codepoints")
  check_valid("{\"maxLength\":1}", "\"中文\"", false, "CJK 2 chars exceeds maxLength 1")
  // "💩💩" is 8 UTF-8 bytes, 2 codepoints
  check_valid("{\"minLength\":2,\"maxLength\":2}", "\"💩💩\"", true, "two emojis = 2 codepoints")

  // pattern (substring match, not implicitly anchored)
  check_valid("{\"pattern\":\"^a*$\"}", "\"aaa\"", true, "anchored pattern matches")
  check_valid("{\"pattern\":\"^a*$\"}", "\"abc\"", false, "anchored pattern rejects")
  check_valid("{\"pattern\":\"foo\"}", "\"xxfooyy\"", true, "unanchored pattern is substring match")
  check_valid("{\"pattern\":\"foo\"}", "\"bar\"", false, "unanchored pattern rejects non-match")
  check_valid("{\"pattern\":\"^[a-z]+-[0-9]+$\"}", "\"item-42\"", true, "slug pattern matches")
  check_valid("{\"pattern\":\"^[a-z]+-[0-9]+$\"}", "123", true, "pattern ignores non-string")
}
