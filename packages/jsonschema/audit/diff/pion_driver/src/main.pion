///| Differential driver for `packages/jsonschema` (red-team audit).
///| Usage: jsonschema_audit_driver <cases.jsonl>
///| Each input line: {"id": str, "draft": "2020-12"|"7", "fmt": bool, "schema": any, "instance": any}
///| Each output line: id \t IS \t VAL \t ms \t nerr
///|   IS  = V (is_valid true) | I (is_valid false) | E:<kind> (compile error)
///|   VAL = V (validate() returned 0 errors) | I (>0 errors) | - (not compiled)
///|   ms  = compile/is_valid/validate milliseconds

import "jsonschema"
import "json5"

fn split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if src.code_unit_at(i) == 10 {
      if i > start {
        out.push(src.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(src.slice(start, n))
  }
  out
}

fn kind_name(k : jsonschema::SchemaErrorKind) -> String {
  match k {
    jsonschema::SchemaErrorKind::ParseError => "ParseError"
    jsonschema::SchemaErrorKind::InvalidSchema => "InvalidSchema"
    jsonschema::SchemaErrorKind::UnresolvedRef => "UnresolvedRef"
    jsonschema::SchemaErrorKind::InvalidRegex => "InvalidRegex"
    jsonschema::SchemaErrorKind::InvalidPointer => "InvalidPointer"
    jsonschema::SchemaErrorKind::LimitExceeded => "LimitExceeded"
  }
}

fn line_opts() -> json5::ParseOptions {
  json5::ParseOptions::{
    max_depth: 200000,
    max_nodes: 100000000,
    duplicate_keys: json5::DuplicateKeyPolicy::LastWins,
    allow_json5: false,
    allow_comments: false,
    allow_trailing_commas: false,
    reject_overflow: true,
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: jsonschema_audit_driver <cases.jsonl>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read cases")
      return 2
    }
  }
  let lines = split_lines(src)
  let mut li = 0
  while li < lines.length() {
    let case = match json5::parse_with_options(lines[li], line_opts()) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "line" + li.to_string() + "\tX:" + e.message + "\t-\t0\t0")
        li = li + 1
        continue
      }
    }
    let id = match json5::get(case, "id") {
      Some(json5::Json5Value::Str(s)) => s
      _ => "line" + li.to_string()
    }
    let draft = match json5::get(case, "draft") {
      Some(json5::Json5Value::Str(s)) =>
      if s == "7" {
        jsonschema::Draft::Draft7
      } else if s == "auto" {
        jsonschema::Draft::Auto
      } else {
        jsonschema::Draft::Draft202012
      }
      _ => jsonschema::Draft::Draft202012
    }
    let fmt = match json5::get(case, "fmt") {
      Some(json5::Json5Value::Bool(b)) => b
      _ => false
    }
    let schema = match json5::get(case, "schema") {
      Some(v) => v
      None => json5::Json5Value::Bool(true)
    }
    let instance = match json5::get(case, "instance") {
      Some(v) => v
      None => json5::Json5Value::Null
    }
    let opts = jsonschema::CompileOptions::{
      draft: draft,
      max_depth: 128,
      validate_formats: fmt,
    }
    let t0 = clock_now_ms(world)
    match jsonschema::compile_with(schema, opts) {
      Ok(c) => {
        let t1 = clock_now_ms(world)
        let ok = c.is_valid(instance)
        let t2 = clock_now_ms(world)
        let errs = c.validate(instance)
        let t3 = clock_now_ms(world)
        io_println(
          world,
          id + "\t" + (if ok { "V" } else { "I" }) + "\t" + (if errs.length() == 0 { "V" } else { "I" }) + "\t" + (t1 - t0).to_string() + "/" + (t2 - t1).to_string() + "/" + (t3 - t2).to_string() + "\t" + errs.length().to_string(),
        )
      }
      Err(e) => {
        let t1 = clock_now_ms(world)
        io_println(world, id + "\tE:" + kind_name(e.kind) + "\t-\t" + (t1 - t0).to_string() + "\t0")
      }
    }
    li = li + 1
  }
  0
}
