///| Stack-safety probe for packages/jsonschema through its PUBLIC API (native + wasm32).
///| usage: jsonschema_audit_deep <mode> <depth> [max_depth]
///|   build_only     : only build the in-memory depth-N array (baseline: no jsonschema call)
///|   instance_mem   : in-memory depth-N array vs {"items":{"$ref":"#"}} (no parser involved)
///|   instance_str   : is_valid_str with a depth-N array string (parser limit 128)
///|   schema_str     : compile_str of a depth-N {"not":...} schema with default options
///|   schema_str_opt : compile_str_with(max_depth = argv[3]) of the same schema
///|   uniq_mem       : uniqueItems over 2 in-memory arrays nested depth N that differ at the leaf
///|   const_mem      : const equality of two in-memory depth-N arrays
///| Prints one line: mode depth result

import "jsonschema"
import "json5"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

fn deep_arr(depth : Int, leaf : Double) -> json5::Json5Value {
  let mut v = json5::Json5Value::Number(leaf)
  let mut i = 0
  while i < depth {
    v = json5::Json5Value::Array([v])
    i = i + 1
  }
  v
}

fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

fn show(r : Result[jsonschema::CompiledSchema, jsonschema::SchemaError]) -> String {
  match r {
    Ok(_) => "compiled"
    Err(e) => "Err(" + e.message + ")"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: jsonschema_audit_deep <mode> <depth> [max_depth]")
    return 2
  }
  let mode = args[1]
  let depth = parse_int(args[2])
  let res = if mode == "build_only" {
    match deep_arr(depth, 1.0) {
      json5::Json5Value::Array(a) => "built len=" + a.length().to_string()
      _ => "?"
    }
  } else if mode == "instance_mem" {
    match jsonschema::compile_str("{\"items\":{\"$ref\":\"#\"}}") {
      Ok(c) =>
      "is_valid=" + c.is_valid(deep_arr(depth, 1.0)).to_string() + " validate_errs=" + c.validate(deep_arr(depth, 1.0)).length().to_string()
      Err(e) => "Err(" + e.message + ")"
    }
  } else if mode == "instance_str" {
    match jsonschema::compile_str("{\"items\":{\"$ref\":\"#\"}}") {
      Ok(c) =>
      match c.is_valid_str(repeat("[", depth) + "1" + repeat("]", depth)) {
        Ok(b) => "is_valid=" + b.to_string()
        Err(e) => "Err(" + e.message + ")"
      }
      Err(e) => "Err(" + e.message + ")"
    }
  } else if mode == "schema_str" {
    show(jsonschema::compile_str(repeat("{\"not\":", depth) + "{}" + repeat("}", depth)))
  } else if mode == "schema_str_opt" {
    let md = if args.length() > 3 { parse_int(args[3]) } else { 128 }
    let opts = jsonschema::CompileOptions::{
      draft: jsonschema::Draft::Draft202012,
      max_depth: md,
      validate_formats: false,
    }
    show(jsonschema::compile_str_with(repeat("{\"not\":", depth) + "{}" + repeat("}", depth), opts))
  } else if mode == "uniq_mem" {
    match jsonschema::compile_str("{\"uniqueItems\":true}") {
      Ok(c) => {
        let items : Array[json5::Json5Value] = []
        let mut i = 0
        while i < 9 {
          items.push(deep_arr(depth, i.to_double()))
          i = i + 1
        }
        "is_valid=" + c.is_valid(json5::Json5Value::Array(items)).to_string()
      }
      Err(e) => "Err(" + e.message + ")"
    }
  } else if mode == "const_mem" {
    let s = jsonschema::compile(
      json5::Json5Value::Object([("const", deep_arr(depth, 1.0))]),
    )
    match s {
      Ok(c) => "is_valid=" + c.is_valid(deep_arr(depth, 1.0)).to_string()
      Err(e) => "Err(" + e.message + ")"
    }
  } else {
    "unknown mode"
  }
  io_println(world, mode + " " + depth.to_string() + " " + res)
  0
}
