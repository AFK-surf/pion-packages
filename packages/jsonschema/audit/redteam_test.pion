///| Red-team evidence for `packages/jsonschema` (W10 RT-jsonschema) vs Rust `jsonschema =0.29.1`,
///| Node `ajv@8.17.1` and the official JSON-Schema-Test-Suite (@83e866b).
///| Every `redteam_*` test asserts the CORRECT (spec / Rust-compatible) verdict: it FAILS while the
///| defect exists and PASSES once fixed. Names carry the finding id from REDTEAM_REPORT.md.
///| `control_*` tests document behaviour that is already correct (several where Pion beats Rust/ajv);
///| they must PASS.
///| Expected verdicts were cross-checked with `diff/run_diff.py` (Rust + ajv transcripts).

import "jsonschema"
import "json5"

///| "V" / "I" / "E:<kind>" for a schema + instance, through the public string API.
fn verdict_with(schema : String, inst : String, opts : jsonschema::CompileOptions) -> String {
  match jsonschema::compile_str_with(schema, opts) {
    Ok(c) =>
    match c.is_valid_str(inst) {
      Ok(true) => "V"
      Ok(false) => "I"
      Err(e) => "E:instance-parse:" + e.message
    }
    Err(e) => "E:" + e.message
  }
}

fn v2020(schema : String, inst : String) -> String {
  verdict_with(schema, inst, jsonschema::CompileOptions::draft202012())
}

fn v7(schema : String, inst : String) -> String {
  verdict_with(schema, inst, jsonschema::CompileOptions::draft7())
}

fn vauto(schema : String, inst : String) -> String {
  verdict_with(schema, inst, jsonschema::CompileOptions::default())
}

fn vfmt(fmt : String, inst : String) -> String {
  let opts = jsonschema::CompileOptions::{
    draft: jsonschema::Draft::Draft202012,
    max_depth: 128,
    validate_formats: true,
  }
  verdict_with("{\"format\":\"" + fmt + "\"}", inst, opts)
}

///| validate() must agree with is_valid().
fn agree(schema : String, inst : String) -> Bool {
  match jsonschema::compile_str(schema) {
    Ok(c) =>
    match (c.is_valid_str(inst), c.validate_str(inst)) {
      (Ok(a), Ok(errs)) => a == (errs.length() == 0)
      _ => false
    }
    Err(_) => true
  }
}

fn expect(what : String, got : String, want : String) -> Unit {
  debug_assert(got == want, what + ": got [" + got + "], want [" + want + "] (Rust jsonschema 0.29.1 / spec)")
}

fn nest_arr(depth : Int, leaf : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("[")
    i = i + 1
  }
  sb.write_string(leaf)
  i = 0
  while i < depth {
    sb.write_string("]")
    i = i + 1
  }
  sb.to_string()
}

fn nest_obj(depth : Int, key : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("{\"" + key + "\":")
    i = i + 1
  }
  sb.write_string("{}")
  i = 0
  while i < depth {
    sb.write_string("}")
    i = i + 1
  }
  sb.to_string()
}

let deny_nested_arrays : String = "{\"$defs\":{\"t\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/t\"}}},\"not\":{\"$ref\":\"#/$defs/t\"}}"

// ============================================================================ P0

///| P0-1: the validation depth cut-off returns `false`, and `not` inverts it -> attacker-controlled
///| instance depth turns a rejection into ACCEPTANCE. 70 levels parse fine through `is_valid_str`
///| (parser limit 128) but every level costs 2 validation hops (`items` + `$ref`) against the 128 budget.
test "redteam_P0_1_depth_cutoff_under_not_fails_open" {
  expect("not(nested-array grammar) on depth 30 (control)", v2020(deny_nested_arrays, nest_arr(30, "")), "I")
  expect("not(nested-array grammar) on depth 70", v2020(deny_nested_arrays, nest_arr(70, "")), "I")
  expect("not(nested-array grammar) on depth 100", v2020(deny_nested_arrays, nest_arr(100, "")), "I")
}

///| P0-1b: same bypass through `if` (cut-off makes `if` false, `then: false` is skipped).
test "redteam_P0_1b_depth_cutoff_under_if_fails_open" {
  let s = "{\"$defs\":{\"t\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/t\"}}},\"if\":{\"$ref\":\"#/$defs/t\"},\"then\":false}"
  expect("if(grammar) then false, depth 70", v2020(s, nest_arr(70, "")), "I")
}

// ============================================================================ P1

///| P1-1: `multipleOf` float path uses a tolerance relative to |x| (validate.pion:59), so large
///| non-multiples are accepted. `multipleOf: 1` is the common "must be an integer" idiom.
test "redteam_P1_1_multipleof_relative_tolerance_false_accept" {
  expect("multipleOf 1, 1000000000.0005", v2020("{\"multipleOf\":1}", "1000000000.0005"), "I")
  expect("multipleOf 0.01, 10000000000.005", v2020("{\"multipleOf\":0.01}", "10000000000.005"), "I")
}

///| P1-2: legitimate recursive data deeper than ~64 levels is reported INVALID (false negative),
///| with no option-free way to tell a depth cut-off from a real failure.
test "redteam_P1_2_depth_cutoff_false_negative" {
  let tree = "{\"type\":\"object\",\"properties\":{\"c\":{\"$ref\":\"#\"}}}"
  expect("recursive tree depth 40 (control)", v2020(tree, nest_obj(40, "c")), "V")
  expect("recursive tree depth 70", v2020(tree, nest_obj(70, "c")), "V")
  expect("recursive tree depth 120", v2020(tree, nest_obj(120, "c")), "V")
}

///| P1-3: `pattern` / `patternProperties` use Unicode-aware `\w` `\d` `\s` (packages/regex) instead of
///| ECMA-262 ASCII classes -> identifier/number patterns accept non-ASCII look-alikes.
test "redteam_P1_3_regex_shorthand_classes_not_ecma262" {
  expect("^\\w+$ vs café", v2020("{\"pattern\":\"^\\\\w+$\"}", "\"café\""), "I")
  expect("^\\d+$ vs Arabic-Indic digits", v2020("{\"pattern\":\"^\\\\d+$\"}", "\"\u{661}\u{662}\""), "I")
  expect(
    "patternProperties ^\\w+$ + additionalProperties:false vs {café:1}",
    v2020("{\"patternProperties\":{\"^\\\\w+$\":{}},\"additionalProperties\":false}", "{\"café\":1}"),
    "I",
  )
}

///| P1-4: ECMA-262 lookaround / backreferences / `\cX` are rejected at compile time (InvalidRegex), so
///| real-world schemas (password policies, "not reserved word") cannot be compiled at all.
test "redteam_P1_4_ecma262_regex_features_rejected" {
  expect("negative lookahead", v2020("{\"pattern\":\"^(?!admin$).*$\"}", "\"user\""), "V")
  expect("positive lookaheads", v2020("{\"pattern\":\"^(?=.*[0-9])(?=.*[a-z]).{8,}$\"}", "\"password1\""), "V")
  expect("lookbehind", v2020("{\"pattern\":\"(?<=\\\\$)\\\\d+\"}", "\"$42\""), "V")
  expect("backreference", v2020("{\"pattern\":\"^(a+)-\\\\1$\"}", "\"aa-aa\""), "V")
  expect("\\cJ control escape", v2020("{\"pattern\":\"^\\\\cJ$\"}", "\"\\n\""), "V")
}

///| P1-5: `$anchor` registered under the OUTER scope when it precedes `$id` in the same object
///| (compiler.pion:317-331 reads `next_scope` before the `$id` entry is seen).
test "redteam_P1_5_anchor_before_id_order_dependent" {
  let s = "{\"$id\":\"http://e.com/root\",\"$defs\":{\"A\":{\"$anchor\":\"a\",\"$id\":\"http://e.com/inner\",\"type\":\"integer\"}},\"$ref\":\"http://e.com/inner#a\"}"
  expect("$anchor before $id, valid", v2020(s, "1"), "V")
  expect("$anchor before $id, invalid", v2020(s, "\"x\""), "I")
  // Same schema with the keys swapped works (control):
  let t = "{\"$id\":\"http://e.com/root\",\"$defs\":{\"A\":{\"$id\":\"http://e.com/inner\",\"$anchor\":\"a\",\"type\":\"integer\"}},\"$ref\":\"http://e.com/inner#a\"}"
  expect("$id before $anchor (control)", v2020(t, "\"x\""), "I")
}

///| P1-6: a JSON-Pointer `$ref` that walks INTO an embedded resource compiles the target with the
///| outer base URI (compiler.pion:451), so nested relative `$ref`s resolve against the wrong base.
test "redteam_P1_6_pointer_into_embedded_resource_wrong_base" {
  let s = "{\"$id\":\"http://e.com/root.json\",\"$defs\":{\"inner\":{\"$id\":\"http://e.com/sub/inner.json\",\"$defs\":{\"x\":{\"$ref\":\"y.json\"}}},\"y\":{\"$id\":\"http://e.com/sub/y.json\",\"type\":\"integer\"},\"y2\":{\"$id\":\"http://e.com/y.json\",\"type\":\"string\"}},\"$ref\":\"#/$defs/inner/$defs/x\"}"
  expect("y.json must resolve to http://e.com/sub/y.json (integer)", v2020(s, "1"), "V")
}

///| P1-7: Draft-07 `$ref` must make sibling `$id` inert, but compile_into applies `$id` before `$ref`
///| (compiler.pion:973-995). Official suite draft7/ref.json group 6 fails.
test "redteam_P1_7_draft7_ref_sibling_id_changes_base" {
  // Verbatim schema of the official suite tests/draft7/ref.json group 6.
  let s = "{\"$id\":\"http://localhost:1234/sibling_id/base/\",\"definitions\":{\"foo\":{\"$id\":\"http://localhost:1234/sibling_id/foo.json\",\"type\":\"string\"},\"base_foo\":{\"$id\":\"foo.json\",\"type\":\"number\"}},\"allOf\":[{\"$id\":\"http://localhost:1234/sibling_id/\",\"$ref\":\"foo.json\"}]}"
  expect("suite draft7/ref.json#6.0 ('a' must be invalid)", v7(s, "\"a\""), "I")
  expect("suite draft7/ref.json#6.1 (1 must be valid)", v7(s, "1"), "V")
}

// ============================================================================ P2

///| P2-1: `$dynamicRef` / `$dynamicAnchor` / `$recursiveRef` are silently ignored: the keyword becomes a
///| no-op and the schema ACCEPTS everything it should constrain (fail-open rather than a compile error).
test "redteam_P2_1_dynamic_ref_silently_ignored_fail_open" {
  let s = "{\"$defs\":{\"s\":{\"$dynamicAnchor\":\"s\",\"type\":\"string\"}},\"$dynamicRef\":\"#s\"}"
  expect("$dynamicRef to a string schema vs 1", v2020(s, "1"), "I")
  let r = "{\"$schema\":\"https://json-schema.org/draft/2019-09/schema\",\"$recursiveAnchor\":true,\"type\":\"object\",\"properties\":{\"c\":{\"$recursiveRef\":\"#\"}}}"
  expect("2019-09 $recursiveRef vs {c:{c:1}}", vauto(r, "{\"c\":{\"c\":1}}"), "I")
}

///| P2-2: `$id` inside an unknown keyword is registered as a real resource (collect_resources walks
///| every key). Official suite optional/unknownKeyword.json.
test "redteam_P2_2_id_inside_unknown_keyword_is_registered" {
  // Verbatim schema of the official suite tests/draft2020-12/optional/unknownKeyword.json group 0.
  let s = "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$defs\":{\"id_in_unknown0\":{\"not\":{\"array_of_schemas\":[{\"$id\":\"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json\",\"type\":\"null\"}]}},\"real_id_in_schema\":{\"$id\":\"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json\",\"type\":\"string\"},\"id_in_unknown1\":{\"not\":{\"object_of_schemas\":{\"foo\":{\"$id\":\"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json\",\"type\":\"integer\"}}}}},\"anyOf\":[{\"$ref\":\"#/$defs/id_in_unknown0\"},{\"$ref\":\"#/$defs/id_in_unknown1\"},{\"$ref\":\"https://localhost:1234/draft2020-12/unknownKeyword/my_identifier.json\"}]}"
  expect("type matches second anyOf, which has a real schema in it", v2020(s, "\"a string\""), "V")
  expect("type matches non-schema in first anyOf", v2020(s, "null"), "I")
  expect("type matches non-schema in third anyOf", v2020(s, "1"), "I")
}

///| P2-3: Draft-07 mode still enforces 2019+/2020-12-only keywords (compile_keyword is draft-agnostic).
test "redteam_P2_3_draft7_enforces_2020_only_keywords" {
  expect("draft7 prefixItems", v7("{\"prefixItems\":[{\"type\":\"string\"}]}", "[1]"), "V")
  expect("draft7 minContains:0", v7("{\"contains\":{\"const\":1},\"minContains\":0}", "[]"), "I")
  expect("draft7 dependentRequired", v7("{\"dependentRequired\":{\"a\":[\"b\"]}}", "{\"a\":1}"), "V")
  expect("draft7 unevaluatedProperties", v7("{\"unevaluatedProperties\":false}", "{\"a\":1}"), "V")
}

///| P2-4: `multipleOf` returns false when x/m overflows (validate.pion:51) although README claims
///| overflow-safe handling; suite optional/float-overflow.json fails (Rust passes).
test "redteam_P2_4_multipleof_quotient_overflow" {
  expect("integer 1e308 multipleOf 0.5", v2020("{\"type\":\"integer\",\"multipleOf\":0.5}", "1e308"), "V")
  expect("2^30 multipleOf 2^-1000", v2020("{\"multipleOf\":9.332636185032189e-302}", "1073741824"), "V")
}

///| P2-5: compile depth budget is shared by `$ref` hops and JSON nesting: a 200-hop non-recursive `$ref`
///| chain and a 70-level `properties` schema are rejected with LimitExceeded (Rust/ajv compile them).
test "redteam_P2_5_compile_depth_budget_rejects_valid_schemas" {
  let sb = StringBuilder::new()
  sb.write_string("{\"$defs\":{")
  let mut i = 0
  while i < 200 {
    sb.write_string("\"d" + i.to_string() + "\":{\"$ref\":\"#/$defs/d" + (i + 1).to_string() + "\"},")
    i = i + 1
  }
  sb.write_string("\"d200\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/d0\"}")
  expect("200-hop $ref chain", v2020(sb.to_string(), "1"), "V")
  let p = StringBuilder::new()
  i = 0
  while i < 70 {
    p.write_string("{\"properties\":{\"a\":")
    i = i + 1
  }
  p.write_string("{\"type\":\"integer\"}")
  i = 0
  while i < 70 {
    p.write_string("}}")
    i = i + 1
  }
  expect("70-level nested properties", v2020(p.to_string(), "{}"), "V")
}

///| P2-6: `$schema` auto-detection maps draft-04/06-era and 2019-09 URIs to 2020-12 semantics; a valid
///| draft-04 schema (boolean exclusiveMinimum) fails to compile. Rust auto-detects draft-04.
test "redteam_P2_6_draft4_schema_autodetect" {
  let s = "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"minimum\":0,\"exclusiveMinimum\":true}"
  expect("draft-04 exclusiveMinimum:true, 0", vauto(s, "0"), "I")
  expect("draft-04 exclusiveMinimum:true, 1", vauto(s, "1"), "V")
}

///| P2-7: no bundled meta-schemas: `$ref` to the draft meta-schema is UnresolvedRef (suite defs.json,
///| definitions.json, ref.json "remote ref, containing refs itself").
test "redteam_P2_7_metaschema_ref_unresolved" {
  let s = "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$ref\":\"https://json-schema.org/draft/2020-12/schema\"}"
  expect("metaschema accepts {$defs:{foo:{type:integer}}}", v2020(s, "{\"$defs\":{\"foo\":{\"type\":\"integer\"}}}"), "V")
}

///| P2-8: format strictness gaps vs Rust (RFC 3986 / RFC 5321 / ECMA-262).
test "redteam_P2_8_format_strictness_gaps" {
  expect("uri non-numeric port", vfmt("uri", "\"http://example.com:abc/\""), "I")
  expect("uri unclosed IP-literal", vfmt("uri", "\"http://[::1/\""), "I")
  expect("uri second '#'", vfmt("uri", "\"http://a/b?c#d#e\""), "I")
  expect("email IPv6 address literal", vfmt("email", "\"a@[IPv6:::1]\""), "V")
  expect("regex format: lookahead is valid ECMA-262", vfmt("regex", "\"^(?!a)\""), "V")
  expect("regex format: \\a is not ECMA-262", vfmt("regex", "\"\\\\a\""), "I")
}

///| P2-9: formats the README lists as unsupported silently pass even with `validate_formats: true`
///| (duration, uri-reference, relative-json-pointer, idn-*, iri*, uri-template) -> 62 suite failures.
test "redteam_P2_9_unimplemented_formats_silently_pass" {
  expect("duration PT", vfmt("duration", "\"PT\""), "I")
  expect("relative-json-pointer /a", vfmt("relative-json-pointer", "\"/a\""), "I")
  expect("uri-template unclosed", vfmt("uri-template", "\"http://e.com/{\""), "I")
}

// ============================================================================ controls (must PASS)

///| Numbers & deep equality. Pion matches the spec on every item.
test "control_numbers_and_equality" {
  expect("1.0 integer", v2020("{\"type\":\"integer\"}", "1.0"), "V")
  expect("1e20 integer", v2020("{\"type\":\"integer\"}", "1e20"), "V")
  expect("-0.0 integer", v2020("{\"type\":\"integer\"}", "-0.0"), "V")
  expect("1.5 not integer", v2020("{\"type\":\"integer\"}", "1.5"), "I")
  expect("enum 1 == 1.0", v2020("{\"enum\":[1]}", "1.0"), "V")
  expect("const 0 == -0.0", v2020("{\"const\":0}", "-0.0"), "V")
  expect("true != 1", v2020("{\"const\":true}", "1"), "I")
  expect("false != 0", v2020("{\"const\":false}", "0"), "I")
  expect("null != false", v2020("{\"const\":null}", "false"), "I")
  expect("key order", v2020("{\"const\":{\"a\":1,\"b\":[{\"y\":2,\"z\":3}]}}", "{\"b\":[{\"z\":3,\"y\":2}],\"a\":1}"), "V")
  expect("unique [1,1.0]", v2020("{\"uniqueItems\":true}", "[1,1.0]"), "I")
  expect("unique [0,-0.0]", v2020("{\"uniqueItems\":true}", "[0,-0.0]"), "I")
  expect("unique hash path", v2020("{\"uniqueItems\":true}", "[1,2,3,4,5,6,7,8,9.0,1.0]"), "I")
  expect("unique [true,1]", v2020("{\"uniqueItems\":true}", "[true,1]"), "V")
  expect("dup key maxProperties (last wins)", v2020("{\"maxProperties\":1}", "{\"a\":1,\"a\":2}"), "V")
  expect("dup key properties (last wins)", v2020("{\"properties\":{\"a\":{\"type\":\"integer\"}}}", "{\"a\":\"x\",\"a\":1}"), "V")
  expect("exclusiveMinimum 0 vs -0.0", v2020("{\"exclusiveMinimum\":0}", "-0.0"), "I")
}

///| Decimal `multipleOf` where Pion is CORRECT and Rust 0.29.1 + ajv 8.17.1 are WRONG (binary FP traps).
test "control_multipleof_decimal_beats_rust_and_ajv" {
  expect("0.3 multipleOf 0.1", v2020("{\"multipleOf\":0.1}", "0.3"), "V")
  expect("19.99 multipleOf 0.01", v2020("{\"multipleOf\":0.01}", "19.99"), "V")
  expect("0.0075 multipleOf 0.0001", v2020("{\"multipleOf\":0.0001}", "0.0075"), "V")
  expect("0.00751 multipleOf 0.0001", v2020("{\"multipleOf\":0.0001}", "0.00751"), "I")
}

///| Annotation semantics for unevaluated*; the failed-anyOf-branch case is one Rust 0.29.1 gets WRONG.
test "control_unevaluated_annotation_semantics" {
  expect(
    "failed anyOf branch does not leak (Rust 0.29.1 says V)",
    v2020("{\"anyOf\":[{\"properties\":{\"a\":{\"type\":\"integer\"}}},{\"properties\":{\"b\":{\"type\":\"integer\"}},\"required\":[\"c\"]}],\"unevaluatedProperties\":false}", "{\"a\":1,\"b\":2}"),
    "I",
  )
  expect(
    "items in anyOf behind recursive $ref annotates (Rust 0.29.1 says I)",
    v2020("{\"$defs\":{\"n\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/n\"}},{\"type\":\"integer\"}]}},\"$ref\":\"#/$defs/n\",\"unevaluatedItems\":false}", "[1]"),
    "V",
  )
  expect("failed if does not leak", v2020("{\"if\":{\"properties\":{\"a\":{\"const\":1}},\"required\":[\"a\",\"z\"]},\"else\":{\"properties\":{\"b\":{}}},\"unevaluatedProperties\":false}", "{\"a\":1,\"b\":1}"), "I")
  expect("if+then merge", v2020("{\"if\":{\"properties\":{\"a\":{\"const\":1}}},\"then\":{\"properties\":{\"b\":{}}},\"unevaluatedProperties\":false}", "{\"a\":1,\"b\":1}"), "V")
  expect("not never annotates", v2020("{\"not\":{\"not\":{\"properties\":{\"a\":{}}}},\"unevaluatedProperties\":false}", "{\"a\":1}"), "I")
  expect("contains annotates", v2020("{\"contains\":{\"type\":\"string\"},\"unevaluatedItems\":false}", "[\"a\",\"b\"]"), "V")
  expect("contains miss is unevaluated", v2020("{\"contains\":{\"type\":\"string\"},\"unevaluatedItems\":false}", "[\"a\",1]"), "I")
  expect("nested uP:true", v2020("{\"allOf\":[{\"properties\":{\"a\":{}},\"unevaluatedProperties\":true}],\"unevaluatedProperties\":false}", "{\"a\":1,\"b\":1}"), "V")
  expect("dependentSchemas absent trigger", v2020("{\"dependentSchemas\":{\"x\":{\"properties\":{\"a\":{}}}},\"unevaluatedProperties\":false}", "{\"a\":1}"), "I")
  expect("prefixItems in allOf", v2020("{\"allOf\":[{\"prefixItems\":[{}]}],\"unevaluatedItems\":false}", "[1,2]"), "I")
}

///| `$ref` pointer escaping, siblings and scopes.
test "control_ref_pointer_and_scopes" {
  expect("2020 siblings apply", v2020("{\"$defs\":{\"a\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/a\",\"minimum\":5}", "3"), "I")
  expect("draft7 siblings ignored", v7("{\"definitions\":{\"a\":{\"type\":\"integer\"}},\"$ref\":\"#/definitions/a\",\"minimum\":5}", "3"), "V")
  expect("~01 -> '~1'", v2020("{\"$defs\":{\"~1\":{\"type\":\"integer\"},\"/\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/~01\"}", "\"s\""), "I")
  expect("%25", v2020("{\"$defs\":{\"a%b\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/a%25b\"}", "\"x\""), "I")
  expect("array index", v2020("{\"allOf\":[{\"type\":\"integer\"}],\"properties\":{\"a\":{\"$ref\":\"#/allOf/0\"}}}", "{\"a\":\"x\"}"), "I")
  expect("ref false", v2020("{\"$defs\":{\"f\":false},\"$ref\":\"#/$defs/f\"}", "1"), "I")
  expect("nested resource local ptr", v2020("{\"$id\":\"http://e.com/r\",\"$defs\":{\"a\":{\"type\":\"integer\"},\"n\":{\"$id\":\"http://e.com/n\",\"$defs\":{\"a\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/a\"}},\"$ref\":\"#/$defs/n\"}", "\"x\""), "V")
  expect("anchor local scope", v2020("{\"$id\":\"http://e.com/root\",\"$defs\":{\"A\":{\"$id\":\"inner\",\"$defs\":{\"B\":{\"$anchor\":\"foo\",\"type\":\"string\"}},\"$ref\":\"#foo\"},\"foo\":{\"$anchor\":\"foo\",\"type\":\"integer\"}},\"$ref\":\"#/$defs/A\"}", "\"x\""), "V")
  expect("missing pointer is a compile error", v2020("{\"$ref\":\"#/$defs/nope\"}", "1").slice(0, 2), "E:")
}

///| Arrays / objects edge semantics.
test "control_array_object_edges" {
  expect("minContains 0 empty", v2020("{\"contains\":{\"const\":1},\"minContains\":0}", "[]"), "V")
  expect("maxContains with minContains 0", v2020("{\"contains\":{\"const\":1},\"minContains\":0,\"maxContains\":1}", "[1,1]"), "I")
  expect("d7 tuple additionalItems", v7("{\"items\":[{\"type\":\"integer\"}],\"additionalItems\":false}", "[1,\"x\"]"), "I")
  expect("d7 additionalItems alone ignored", v7("{\"additionalItems\":false}", "[1,2]"), "V")
  expect("pprops suppresses addl", v2020("{\"patternProperties\":{\"^x\":{}},\"additionalProperties\":false}", "{\"xa\":1}"), "V")
  expect("propertyNames on {}", v2020("{\"propertyNames\":{\"maxLength\":2}}", "{}"), "V")
  expect("d7 empty dependency array", v7("{\"dependencies\":{\"a\":[]}}", "{\"a\":1}"), "V")
  expect("maxLength counts code points (emoji)", v2020("{\"maxLength\":1}", "\"\u{1F600}\""), "V")
  expect("combining mark is a code point", v2020("{\"maxLength\":1}", "\"e\u{301}\""), "I")
  expect("ECMA $ before \\n", v2020("{\"pattern\":\"^abc$\"}", "\"abc\\n\""), "I")
}

///| Core format checks that are already strict and correct.
test "control_formats_core" {
  expect("2024-02-29", vfmt("date", "\"2024-02-29\""), "V")
  expect("2100-02-29", vfmt("date", "\"2100-02-29\""), "I")
  expect("leap second UTC", vfmt("date-time", "\"1998-12-31T23:59:60Z\""), "V")
  expect("leap second wrong offset", vfmt("date-time", "\"1998-12-31T23:59:60+01:00\""), "I")
  expect("tz +24:00", vfmt("date-time", "\"2024-01-01T00:00:00+24:00\""), "I")
  expect("lowercase t/z", vfmt("date-time", "\"2024-01-01t00:00:00z\""), "V")
  expect("time needs offset", vfmt("time", "\"12:00:00\""), "I")
  expect("ipv4 leading zero", vfmt("ipv4", "\"01.2.3.4\""), "I")
  expect("ipv6 zone id", vfmt("ipv6", "\"fe80::1%eth0\""), "I")
  expect("ipv6 ::ffff:1.2.3.4", vfmt("ipv6", "\"::ffff:1.2.3.4\""), "V")
  expect("hostname 64-char label", vfmt("hostname", "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com\""), "I")
  expect("hostname trailing -", vfmt("hostname", "\"a-.com\""), "I")
  expect("json-pointer ~2", vfmt("json-pointer", "\"/a~2\""), "I")
  expect("uuid braces", vfmt("uuid", "\"{00000000-0000-0000-0000-000000000000}\""), "I")
}

///| is_valid() (fast or annotation path) and validate() agree on a mixed sample.
test "control_is_valid_agrees_with_validate" {
  let cases : Array[(String, String)] = [
    ("{\"anyOf\":[{\"properties\":{\"a\":{}}},{\"required\":[\"zz\"]}],\"unevaluatedProperties\":false}", "{\"a\":1,\"b\":2}"),
    ("{\"oneOf\":[{\"type\":\"integer\"},{\"minimum\":0}]}", "5"),
    ("{\"contains\":{\"type\":\"string\"},\"maxContains\":1,\"unevaluatedItems\":false}", "[\"a\",\"b\"]"),
    (deny_nested_arrays, nest_arr(70, "")),
    ("{\"type\":\"object\",\"properties\":{\"c\":{\"$ref\":\"#\"}}}", nest_obj(70, "c")),
    ("{\"if\":{\"minimum\":10},\"then\":{\"multipleOf\":2},\"else\":{\"maximum\":3}}", "11"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (s, inst) = cases[i]
    debug_assert(agree(s, inst), "is_valid != validate for case " + i.to_string())
    i = i + 1
  }
}
