///| JSON-Schema-Test-Suite (Draft 2020-12 & Draft-07) combinators, conditionals,
///| references ($defs/definitions/$ref/$anchor/$id), unevaluated annotations,
///| and structured ValidationError diagnostics.

import "json5"

///|
test "compliance_combinators_all_any_one_not" {
  // allOf
  let s_all = "{\"allOf\":[{\"type\":\"integer\"},{\"minimum\":2},{\"maximum\":5}]}"
  check_valid(s_all, "3", true, "allOf passes")
  check_valid(s_all, "1", false, "allOf fails minimum")
  check_valid(s_all, "3.5", false, "allOf fails integer")

  // anyOf
  let s_any = "{\"anyOf\":[{\"type\":\"integer\"},{\"minimum\":2}]}"
  check_valid(s_any, "1", true, "anyOf first matches")
  check_valid(s_any, "2.5", true, "anyOf second matches")
  check_valid(s_any, "1.5", false, "anyOf neither matches")

  // oneOf
  let s_one = "{\"oneOf\":[{\"type\":\"integer\"},{\"minimum\":2}]}"
  check_valid(s_one, "1", true, "oneOf only first matches")
  check_valid(s_one, "2.5", true, "oneOf only second matches")
  check_valid(s_one, "3", false, "oneOf both match -> invalid")
  check_valid(s_one, "1.5", false, "oneOf neither matches -> invalid")

  // not
  check_valid("{\"not\":{\"type\":\"integer\"}}", "\"ok\"", true, "not passes")
  check_valid("{\"not\":{\"type\":\"integer\"}}", "1", false, "not fails")
}

///|
test "compliance_conditionals_if_then_else" {
  let s_ite = "{\"if\":{\"exclusiveMaximum\":0},\"then\":{\"minimum\":-10},\"else\":{\"multipleOf\":2}}"
  check_valid(s_ite, "-1", true, "if true, then valid")
  check_valid(s_ite, "-100", false, "if true, then invalid")
  check_valid(s_ite, "4", true, "if false, else valid")
  check_valid(s_ite, "3", false, "if false, else invalid")

  // then/else ignored without if
  check_valid("{\"then\":false,\"else\":false}", "42", true, "then/else ignored without if")

  // if without then/else always valid
  check_valid("{\"if\":{\"type\":\"string\"}}", "123", true, "if alone does not fail")
}

///|
test "compliance_refs_pointer_escaping_anchor_id_and_draft_siblings" {
  // $defs + JSON Pointer $ref
  let s_defs = "{\"$defs\":{\"posInt\":{\"type\":\"integer\",\"minimum\":1}},\"type\":\"object\",\"properties\":{\"count\":{\"$ref\":\"#/$defs/posInt\"}}}"
  check_valid(s_defs, "{\"count\":5}", true, "$defs $ref valid")
  check_valid(s_defs, "{\"count\":0}", false, "$defs $ref invalid")

  // RFC 6901 ~0 / ~1 escaping and URI percent-decoding (%25 -> %, %20 -> space)
  let s_esc = "{\"$defs\":{\"a/b\":{\"type\":\"integer\"},\"c~d\":{\"type\":\"string\"},\"e%f g\":{\"type\":\"boolean\"}},\"properties\":{\"p1\":{\"$ref\":\"#/$defs/a~1b\"},\"p2\":{\"$ref\":\"#/$defs/c~0d\"},\"p3\":{\"$ref\":\"#/$defs/e%25f%20g\"}}}"
  check_valid(s_esc, "{\"p1\":1,\"p2\":\"ok\",\"p3\":true}", true, "escaped pointer refs valid")
  check_valid(s_esc, "{\"p1\":\"no\"}", false, "~1 ref rejects string")
  check_valid(s_esc, "{\"p2\":1}", false, "~0 ref rejects int")
  check_valid(s_esc, "{\"p3\":1}", false, "percent-decoded ref rejects int")

  // $anchor (Draft 2020-12)
  let s_anchor = "{\"$defs\":{\"A\":{\"$anchor\":\"my_int\",\"type\":\"integer\",\"minimum\":10}},\"$ref\":\"#my_int\"}"
  check_valid(s_anchor, "15", true, "$anchor ref valid")
  check_valid(s_anchor, "5", false, "$anchor ref invalid")

  // $id local scope resolution
  let s_id = "{\"$id\":\"https://example.com/root.json\",\"$defs\":{\"sub\":{\"$id\":\"https://example.com/nested/sub.json\",\"$defs\":{\"leaf\":{\"type\":\"string\",\"minLength\":2}},\"$ref\":\"#/$defs/leaf\"}},\"properties\":{\"x\":{\"$ref\":\"https://example.com/nested/sub.json\"},\"y\":{\"$ref\":\"nested/sub.json#/$defs/leaf\"}}}"
  check_valid(s_id, "{\"x\":\"hi\",\"y\":\"ok\"}", true, "$id local scope refs valid")
  check_valid(s_id, "{\"x\":\"a\"}", false, "$id full uri ref rejects")
  check_valid(s_id, "{\"y\":\"a\"}", false, "$id relative uri+fragment ref rejects")

  // Draft 2020-12 evaluates siblings alongside $ref; Draft-07 ignores siblings alongside $ref
  let s_sib = "{\"$defs\":{\"str\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/str\",\"maxLength\":3}"
  check_valid(s_sib, "\"abcd\"", false, "Draft 2020-12 evaluates maxLength sibling with $ref")
  check_valid_draft7(s_sib, "\"abcd\"", true, "Draft-07 ignores maxLength sibling with $ref")

  // Recursive linked list schema via $ref
  let s_list = "{\"$defs\":{\"node\":{\"type\":\"object\",\"properties\":{\"val\":{\"type\":\"integer\"},\"next\":{\"anyOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/node\"}]}},\"required\":[\"val\"]}},\"$ref\":\"#/$defs/node\"}"
  check_valid(s_list, "{\"val\":1,\"next\":{\"val\":2,\"next\":null}}", true, "recursive linked list valid")
  check_valid(s_list, "{\"val\":1,\"next\":{\"val\":\"bad\"}}", false, "recursive linked list catches deep error")
}

///|
test "compliance_unevaluated_properties_annotations" {
  // allOf + $ref + unevaluatedProperties: false
  let s1 = "{\"$defs\":{\"base\":{\"properties\":{\"a\":{\"type\":\"integer\"}}}},\"allOf\":[{\"$ref\":\"#/$defs/base\"},{\"properties\":{\"b\":{\"type\":\"string\"}}}],\"unevaluatedProperties\":false}"
  check_valid(s1, "{\"a\":1,\"b\":\"ok\"}", true, "unevaluatedProperties sees properties from allOf and $ref")
  check_valid(s1, "{\"a\":1,\"b\":\"ok\",\"c\":true}", false, "unevaluatedProperties rejects extra c")

  // anyOf: annotations from matching branches only
  let s2 = "{\"anyOf\":[{\"properties\":{\"foo\":{\"type\":\"string\"}},\"required\":[\"foo\"]},{\"properties\":{\"bar\":{\"type\":\"integer\"}},\"required\":[\"bar\"]}],\"unevaluatedProperties\":false}"
  check_valid(s2, "{\"foo\":\"hi\"}", true, "anyOf branch 1 evaluates foo")
  check_valid(s2, "{\"bar\":1}", true, "anyOf branch 2 evaluates bar")
  check_valid(s2, "{\"foo\":\"hi\",\"bar\":1}", true, "anyOf both branches match and evaluate both")
  check_valid(s2, "{\"foo\":\"hi\",\"baz\":1}", false, "anyOf rejects unevaluated baz")

  // if/then/else: if-branch annotations kept only when if succeeds
  let s3 = "{\"if\":{\"properties\":{\"kind\":{\"const\":\"a\"}},\"required\":[\"kind\"]},\"then\":{\"properties\":{\"val_a\":{\"type\":\"integer\"}}},\"else\":{\"properties\":{\"val_b\":{\"type\":\"string\"}}},\"unevaluatedProperties\":false}"
  check_valid(s3, "{\"kind\":\"a\",\"val_a\":1}", true, "if+then evaluates kind and val_a")
  check_valid(s3, "{\"kind\":\"a\",\"val_b\":\"x\"}", false, "if+then does not evaluate val_b")
  check_valid(s3, "{\"val_b\":\"x\"}", true, "else evaluates val_b")
  check_valid(s3, "{\"kind\":\"b\",\"val_b\":\"x\"}", false, "when if fails, kind is NOT evaluated by if")

  // not does NOT produce annotations
  let s4 = "{\"not\":{\"properties\":{\"foo\":{\"type\":\"integer\"}}},\"unevaluatedProperties\":false}"
  check_valid(s4, "{\"foo\":\"str\"}", false, "not does not evaluate foo")
}

///|
test "compliance_unevaluated_items_annotations" {
  // prefixItems + unevaluatedItems: false
  let s1 = "{\"allOf\":[{\"prefixItems\":[{\"type\":\"integer\"},{\"type\":\"string\"}]}],\"unevaluatedItems\":false}"
  check_valid(s1, "[1, \"a\"]", true, "unevaluatedItems sees prefixItems through allOf")
  check_valid(s1, "[1, \"a\", true]", false, "unevaluatedItems rejects index 2")

  // contains marks matched indices as evaluated in Draft 2020-12
  let s2 = "{\"prefixItems\":[{\"type\":\"string\"}],\"contains\":{\"type\":\"integer\"},\"unevaluatedItems\":false}"
  check_valid(s2, "[\"a\", 1, 2]", true, "contains evaluates matched integer indices")
  check_valid(s2, "[\"a\", 1, true]", false, "unevaluatedItems rejects unmatched boolean at index 2")

  // unevaluatedItems with schema (not just false)
  let s3 = "{\"allOf\":[{\"prefixItems\":[{\"type\":\"string\"}]}],\"unevaluatedItems\":{\"type\":\"integer\"}}"
  check_valid(s3, "[\"a\", 1, 2]", true, "unevaluatedItems schema validates remaining items")
  check_valid(s3, "[\"a\", 1, \"bad\"]", false, "unevaluatedItems schema rejects string at index 2")
}

///|
test "compliance_structured_validation_errors" {
  let schema_str = "{\"type\":\"object\",\"properties\":{\"age\":{\"type\":\"integer\",\"minimum\":0},\"name\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"age\",\"name\"]}"
  let compiled = match compile_str(schema_str) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "compile failed: " + e.message)
      return
    }
  }
  let inst = match json5::parse_with_options("{\"age\":-5,\"name\":\"a\"}", json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  debug_assert(!compiled.is_valid(inst), "should be invalid")
  let errs = compiled.validate(inst)
  // Must collect BOTH errors (age minimum AND name minLength)
  debug_assert(errs.length() == 2, "should collect both validation errors")
  let mut saw_age = false
  let mut saw_name = false
  let mut i = 0
  while i < errs.length() {
    let e = errs[i]
    if e.instance_path == "/age" && e.keyword == "minimum" && e.message.length() > 0 {
      saw_age = true
    }
    if e.instance_path == "/name" && e.keyword == "minLength" && e.message.length() > 0 {
      saw_name = true
    }
    i = i + 1
  }
  debug_assert(saw_age, "missing /age minimum error")
  debug_assert(saw_name, "missing /name minLength error")
}
