///| Day-1 Security Red-Team defenses for `packages/jsonschema`:
///| 1. Direct & indirect `$ref` cycles (compile + validate without stack overflow)
///| 2. 50,000-level deep nesting JSON/Schema -> clean LimitExceeded/false, 0 SIGSEGV / 0 trap
///| 3. `uniqueItems` on 20,000-element array -> O(N) linear time
///| 4. ReDoS pattern `(a+)+$` -> linear-time `packages/regex` engine
///| 5. Malformed schemas -> compile-time `Err(SchemaError)`

import "json5"

///|
test "redteam_ref_cycles_direct_and_indirect_no_stack_overflow" {
  // Direct self-cycle: {"$ref": "#"}
  let direct = match compile_str("{\"$ref\":\"#\"}") {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "direct $ref cycle should compile cleanly: " + e.message)
      return
    }
  }
  let v = json5::Json5Value::Number(1.0)
  // Validating against infinite non-consuming cycle must hit max_depth cleanly (not stack overflow)
  debug_assert(!direct.is_valid(v), "infinite direct $ref cycle must terminate false")
  let errs = direct.validate(v)
  debug_assert(errs.length() > 0, "infinite direct $ref cycle must produce error")

  // Indirect cycle: A -> B -> A
  let indirect_str = "{\"$defs\":{\"A\":{\"$ref\":\"#/$defs/B\"},\"B\":{\"$ref\":\"#/$defs/A\"}},\"$ref\":\"#/$defs/A\"}"
  let indirect = match compile_str(indirect_str) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "indirect $ref cycle should compile cleanly: " + e.message)
      return
    }
  }
  debug_assert(!indirect.is_valid(v), "indirect $ref cycle must terminate false")
}

///|
test "redteam_deep_nesting_50k_schema_and_instance_no_sigsegv" {
  // Build 50,000-level nested JSON array string -> compile_str must reject cleanly (LimitExceeded/ParseError), 0 SIGSEGV
  let depth = 50000
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("{\"items\":")
    i = i + 1
  }
  sb.write_string("true")
  i = 0
  while i < depth {
    sb.write_string("}")
    i = i + 1
  }
  match compile_str(sb.to_string()) {
    Ok(_) => debug_assert(false, "50k nested schema must be rejected by max_depth")
    Err(_) => ()
  }

  // Build 50,000-level nested Json5Value::Array in memory (bypassing parser) and validate against recursive schema
  let mut deep_val = json5::Json5Value::Number(1.0)
  i = 0
  while i < depth {
    deep_val = json5::Json5Value::Array([deep_val])
    i = i + 1
  }
  let rec_schema = match compile_str("{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"array\",\"items\":{\"$ref\":\"#\"}}]}") {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "recursive array schema should compile: " + e.message)
      return
    }
  }
  // Must hit max_depth cleanly, 0 SIGSEGV
  debug_assert(!rec_schema.is_valid(deep_val), "50k nested instance must hit max_depth cleanly")
}

///|
test "redteam_unique_items_20k_linear_time" {
  let compiled = match compile_str("{\"type\":\"array\",\"uniqueItems\":true}") {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "compile uniqueItems failed: " + e.message)
      return
    }
  }
  // 20,000 unique objects
  let items : Array[json5::Json5Value] = Array::new()
  let mut i = 0
  while i < 20000 {
    items.push(json5::Json5Value::Object([
      ("id", json5::Json5Value::Number(i.to_double())),
      ("tag", json5::Json5Value::Str("item")),
    ]))
    i = i + 1
  }
  debug_assert(compiled.is_valid(json5::Json5Value::Array(items)), "20k unique items must be valid")

  // Add a duplicate at the very end (key order swapped)
  items.push(json5::Json5Value::Object([
    ("tag", json5::Json5Value::Str("item")),
    ("id", json5::Json5Value::Number(0.0)),
  ]))
  debug_assert(!compiled.is_valid(json5::Json5Value::Array(items)), "20k items with duplicate at end must fail")
}

///|
test "redteam_regex_redos_linear_time" {
  let compiled = match compile_str("{\"type\":\"string\",\"pattern\":\"^(a+)+$\"}") {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "compile pattern failed: " + e.message)
      return
    }
  }
  // 100 'a's followed by '!' would hang backtracking engines for centuries
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 100 {
    sb.write_byte(97.to_byte())
    i = i + 1
  }
  sb.write_byte(33.to_byte())
  let evil = json5::Json5Value::Str(sb.to_string())
  debug_assert(!compiled.is_valid(evil), "ReDoS input must be rejected fast")
}

///|
test "redteam_invalid_schemas_rejected_at_compile_time" {
  // minLength: -1
  match compile_str("{\"minLength\":-1}") {
    Ok(_) => debug_assert(false, "minLength: -1 must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "minLength:-1 kind")
  }
  // required: 123
  match compile_str("{\"required\":123}") {
    Ok(_) => debug_assert(false, "required: 123 must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "required:123 kind")
  }
  // multipleOf: 0 and negative
  match compile_str("{\"multipleOf\":0}") {
    Ok(_) => debug_assert(false, "multipleOf: 0 must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "multipleOf:0 kind")
  }
  match compile_str("{\"multipleOf\":-2}") {
    Ok(_) => debug_assert(false, "multipleOf: -2 must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "multipleOf:-2 kind")
  }
  // invalid type name
  match compile_str("{\"type\":\"float\"}") {
    Ok(_) => debug_assert(false, "type: float must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "type:float kind")
  }
  // invalid regex pattern
  match compile_str("{\"pattern\":\"[unclosed\"}") {
    Ok(_) => debug_assert(false, "invalid regex must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidRegex), "invalid regex kind")
  }
  // unresolved $ref
  match compile_str("{\"$ref\":\"#/$defs/DoesNotExist\"}") {
    Ok(_) => debug_assert(false, "unresolved $ref must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::UnresolvedRef), "unresolved $ref kind")
  }
  // non-object/non-bool root schema
  match compile_str("123") {
    Ok(_) => debug_assert(false, "numeric root schema must fail compile")
    Err(e) => debug_assert(schema_error_kind_eq(e.kind, SchemaErrorKind::InvalidSchema), "numeric schema kind")
  }
}
