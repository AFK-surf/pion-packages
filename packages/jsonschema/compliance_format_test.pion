///| JSON Schema optional Format validation compliance tests:
///| email, uri, uuid, date, time, date-time, ipv4, ipv6, hostname, json-pointer, regex.

import "json5"

fn check_fmt_schema(fmt : String, inst_json : String, expected_when_on : Bool, msg : String) -> Unit {
  let schema_json = "{\"format\":\"" + fmt + "\"}"
  let compiled = match compile_str(schema_json) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, msg + " (compile failed: " + e.message + ")")
      return
    }
  }
  let inst = match json5::parse_with_options(inst_json, json5::ParseOptions::strict_json()) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, msg + " (instance parse failed)")
      return
    }
  }
  // Default (validate_formats: false): annotation-only -> always valid
  debug_assert(compiled.is_valid(inst), msg + " (format should be annotation-only by default)")
  // With validate_formats: true
  let opts = ValidateOptions::with_formats(true)
  debug_assert(compiled.is_valid_with(inst, opts) == expected_when_on, msg + " (is_valid_with mismatch)")
  let errs = compiled.validate_with(inst, opts)
  debug_assert((errs.length() == 0) == expected_when_on, msg + " (validate_with mismatch)")
}

///|
test "compliance_format_email_and_hostname" {
  check_fmt_schema("email", "\"joe.bloggs@example.com\"", true, "valid email")
  check_fmt_schema("email", "\"user+tag@sub.domain.org\"", true, "valid email with plus")
  check_fmt_schema("email", "\"2962\"", false, "invalid email no @")
  check_fmt_schema("email", "\"@example.com\"", false, "invalid email empty local")
  check_fmt_schema("email", "\"user@\"", false, "invalid email empty domain")
  check_fmt_schema("email", "\"a..b@example.com\"", false, "invalid email double dot")
  check_fmt_schema("email", "123", true, "email format ignores non-string")

  check_fmt_schema("hostname", "\"www.example.com\"", true, "valid hostname")
  check_fmt_schema("hostname", "\"localhost\"", true, "single label hostname")
  check_fmt_schema("hostname", "\"-bad.example.com\"", false, "leading hyphen hostname")
  check_fmt_schema("hostname", "\"bad-.example.com\"", false, "trailing hyphen hostname")
  check_fmt_schema("hostname", "\"not_a_valid_host\"", false, "underscore not valid hostname")
  check_fmt_schema("hostname", "\"\"", false, "empty hostname invalid")
}

///|
test "compliance_format_uri_and_uuid" {
  check_fmt_schema("uri", "\"https://example.com/path?a=1#frag\"", true, "valid https uri")
  check_fmt_schema("uri", "\"urn:isbn:0451450523\"", true, "valid urn uri")
  check_fmt_schema("uri", "\"mailto:user@example.com\"", true, "valid mailto uri")
  check_fmt_schema("uri", "\"//example.com/foo\"", false, "scheme-relative not full uri")
  check_fmt_schema("uri", "\"not a uri\"", false, "spaces in uri invalid")
  check_fmt_schema("uri", "\"1http://example.com\"", false, "scheme cannot start with digit")

  check_fmt_schema("uuid", "\"2eb8aa08-aa98-11ea-b4aa-73b441d16380\"", true, "valid lowercase uuid")
  check_fmt_schema("uuid", "\"2EB8AA08-AA98-11EA-B4AA-73B441D16380\"", true, "valid uppercase uuid")
  check_fmt_schema("uuid", "\"2eb8aa08-aa98-11ea-b4aa-73b441d1638\"", false, "short uuid")
  check_fmt_schema("uuid", "\"2eb8aa08-aa98-11ea-b4aa-73b441d1638g\"", false, "non-hex uuid")
  check_fmt_schema("uuid", "\"2eb8aa08aa9811eab4aa73b441d16380\"", false, "uuid missing hyphens")
}

///|
test "compliance_format_date_time_datetime" {
  // date
  check_fmt_schema("date", "\"2020-02-29\"", true, "leap year Feb 29 valid")
  check_fmt_schema("date", "\"2000-02-29\"", true, "400-year leap Feb 29 valid")
  check_fmt_schema("date", "\"1900-02-29\"", false, "100-year non-leap Feb 29 invalid")
  check_fmt_schema("date", "\"2021-02-29\"", false, "non-leap Feb 29 invalid")
  check_fmt_schema("date", "\"2021-04-31\"", false, "April 31 invalid")
  check_fmt_schema("date", "\"2021-13-01\"", false, "month 13 invalid")
  check_fmt_schema("date", "\"2021-1-1\"", false, "non-padded date invalid")

  // time
  check_fmt_schema("time", "\"08:30:06.283185Z\"", true, "valid UTC time with frac")
  check_fmt_schema("time", "\"08:30:06+09:00\"", true, "valid time with offset")
  check_fmt_schema("time", "\"23:59:60Z\"", true, "valid UTC leap second")
  check_fmt_schema("time", "\"24:00:00Z\"", false, "hour 24 invalid")
  check_fmt_schema("time", "\"08:30:06\"", false, "missing timezone offset invalid in RFC 3339")

  // date-time
  check_fmt_schema("date-time", "\"2026-11-23T07:41:08.589Z\"", true, "valid date-time")
  check_fmt_schema("date-time", "\"2026-11-23t07:41:08-05:00\"", true, "valid lowercase t date-time")
  check_fmt_schema("date-time", "\"2026-02-29T07:41:08Z\"", false, "invalid leap date in date-time")
  check_fmt_schema("date-time", "\"2026-11-23 07:41:08Z\"", false, "space separator rejected")
}

///|
test "compliance_format_ip_pointer_regex_and_unknown" {
  // ipv4
  check_fmt_schema("ipv4", "\"192.168.0.1\"", true, "valid ipv4")
  check_fmt_schema("ipv4", "\"0.0.0.0\"", true, "zero ipv4")
  check_fmt_schema("ipv4", "\"255.255.255.255\"", true, "max ipv4")
  check_fmt_schema("ipv4", "\"256.0.0.1\"", false, "octet > 255")
  check_fmt_schema("ipv4", "\"01.2.3.4\"", false, "leading zero in ipv4 octet")
  check_fmt_schema("ipv4", "\"1.2.3\"", false, "only 3 octets")

  // ipv6
  check_fmt_schema("ipv6", "\"::1\"", true, "loopback ipv6")
  check_fmt_schema("ipv6", "\"2001:0db8:85a3:0000:0000:8a2e:0370:7334\"", true, "full ipv6")
  check_fmt_schema("ipv6", "\"::ffff:192.0.2.128\"", true, "ipv4-mapped ipv6")
  check_fmt_schema("ipv6", "\"1::2::3\"", false, "two double colons invalid")
  check_fmt_schema("ipv6", "\"1:2:3:4:5:6:7:8:9\"", false, "9 groups invalid")
  check_fmt_schema("ipv6", "\"gggg::1\"", false, "non-hex ipv6")

  // json-pointer
  check_fmt_schema("json-pointer", "\"\"", true, "empty json-pointer valid")
  check_fmt_schema("json-pointer", "\"/foo/bar/0/a~1b/c~0d\"", true, "valid json-pointer")
  check_fmt_schema("json-pointer", "\"foo/bar\"", false, "missing leading slash")
  check_fmt_schema("json-pointer", "\"/a~2b\"", false, "invalid ~2 escape")

  // regex
  check_fmt_schema("regex", "\"^([a-z]+)-[0-9]{2,4}$\"", true, "valid regex")
  check_fmt_schema("regex", "\"[unclosed\"", false, "invalid regex")

  // unknown format is ignored (valid)
  check_fmt_schema("x-custom-unknown-format", "\"anything goes\"", true, "unknown format accepted")
}
