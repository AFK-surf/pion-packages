///| JSON Schema optional Format validators (zero-allocation byte-level & Unicode checks):
///| email, idn-email, uri, uri-reference, iri, iri-reference, uri-template, uuid,
///| date, time, date-time, duration, ipv4, ipv6, hostname, idn-hostname,
///| json-pointer, relative-json-pointer, regex.

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_ascii_alnum(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn parse_digits(s : String, start : Int, count : Int) -> Int {
  if start + count > s.length() {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(start + i)
    if !is_ascii_digit(b) {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn is_leap_year(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_in_month(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year(y) {
      29
    } else {
      28
    }
  } else {
    0
  }
}

///| RFC 3339 full-date: `YYYY-MM-DD`
fn check_date_slice(s : String, start : Int, len : Int) -> Bool {
  if len != 10 {
    return false
  }
  if s.code_unit_at(start + 4) != 45 || s.code_unit_at(start + 7) != 45 {
    return false
  }
  let y = parse_digits(s, start, 4)
  let m = parse_digits(s, start + 5, 2)
  let d = parse_digits(s, start + 8, 2)
  if y < 0 || m < 1 || m > 12 {
    return false
  }
  let max_d = days_in_month(y, m)
  d >= 1 && d <= max_d
}

///| RFC 3339 full-time: `HH:MM:SS[.frac](Z|z|+HH:MM|-HH:MM)`
fn check_time_slice(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 9 {
    return false
  }
  if s.code_unit_at(start + 2) != 58 || s.code_unit_at(start + 5) != 58 {
    return false
  }
  let hour = parse_digits(s, start, 2)
  let min = parse_digits(s, start + 3, 2)
  let sec = parse_digits(s, start + 6, 2)
  if hour < 0 || hour > 23 || min < 0 || min > 59 || sec < 0 || sec > 60 {
    return false
  }
  let mut pos = start + 8
  if pos < end && s.code_unit_at(pos) == 46 {
    pos = pos + 1
    let frac_start = pos
    while pos < end && is_ascii_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
    if pos == frac_start {
      return false
    }
  }
  if pos >= end {
    return false
  }
  let tz = s.code_unit_at(pos)
  let mut tz_offset_min = 0
  if tz == 90 || tz == 122 {
    if pos + 1 != end {
      return false
    }
  } else if tz == 43 || tz == 45 {
    if pos + 6 != end || s.code_unit_at(pos + 3) != 58 {
      return false
    }
    let tzh = parse_digits(s, pos + 1, 2)
    let tzm = parse_digits(s, pos + 4, 2)
    if tzh < 0 || tzh > 23 || tzm < 0 || tzm > 59 {
      return false
    }
    let mag = tzh * 60 + tzm
    tz_offset_min = if tz == 43 { mag } else { -mag }
  } else {
    return false
  }
  if sec == 60 {
    let mut utc_min = hour * 60 + min - tz_offset_min
    while utc_min < 0 {
      utc_min = utc_min + 1440
    }
    while utc_min >= 1440 {
      utc_min = utc_min - 1440
    }
    if utc_min != 23 * 60 + 59 {
      return false
    }
  }
  true
}

///| RFC 3339 date-time: `YYYY-MM-DD(T|t)HH:MM:SS[.frac](Z|+HH:MM|-HH:MM)`
fn check_date_time(s : String) -> Bool {
  let n = s.length()
  if n < 20 {
    return false
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 {
    return false
  }
  check_date_slice(s, 0, 10) && check_time_slice(s, 11, n)
}

///| RFC 3339 Appendix A duration: `P(nW | (nY)?(nM)?(nD)?(T(nH)?(nM)?(nS)?)?)`
fn check_duration(s : String) -> Bool {
  let n = s.length()
  if n < 3 || s.code_unit_at(0) != 80 {
    // Must start with 'P'
    return false
  }
  let mut pos = 1
  let mut in_time = false
  let mut has_any = false
  let mut has_time_part = false
  let mut date_stage = 0 // 1=Y, 2=M, 3=D
  let mut time_stage = 0 // 1=H, 2=M, 3=S
  while pos < n {
    let b = s.code_unit_at(pos)
    if b == 84 {
      // 'T'
      if in_time {
        return false
      }
      in_time = true
      pos = pos + 1
      if pos >= n {
        return false
      }
      continue
    }
    let dstart = pos
    while pos < n && is_ascii_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
    if pos == dstart || pos >= n {
      return false
    }
    let unit = s.code_unit_at(pos)
    pos = pos + 1
    if !in_time {
      if unit == 87 {
        // 'W' cannot be combined with any other element
        if has_any || pos != n {
          return false
        }
        return true
      } else if unit == 89 {
        if date_stage >= 1 { return false }
        date_stage = 1
      } else if unit == 77 {
        if date_stage >= 2 { return false }
        date_stage = 2
      } else if unit == 68 {
        if date_stage >= 3 { return false }
        date_stage = 3
      } else {
        return false
      }
      has_any = true
    } else {
      if unit == 72 {
        if time_stage >= 1 { return false }
        time_stage = 1
      } else if unit == 77 {
        if time_stage >= 2 { return false }
        time_stage = 2
      } else if unit == 83 {
        if time_stage >= 3 { return false }
        time_stage = 3
      } else {
        return false
      }
      has_any = true
      has_time_part = true
    }
  }
  has_any && (!in_time || has_time_part)
}

///| RFC 4122 UUID: `8-4-4-4-12` hex digits
fn check_uuid(s : String) -> Bool {
  if s.length() != 36 {
    return false
  }
  let mut i = 0
  while i < 36 {
    let b = s.code_unit_at(i)
    if i == 8 || i == 13 || i == 18 || i == 23 {
      if b != 45 {
        return false
      }
    } else if !is_hex_digit(b) {
      return false
    }
    i = i + 1
  }
  true
}

///| IPv4 dotted-quad: 4 decimal octets 0..255 with no leading zeros.
fn check_ipv4_slice(s : String, start : Int, end : Int) -> Bool {
  let mut pos = start
  let mut part = 0
  while part < 4 {
    if pos >= end {
      return false
    }
    let first = s.code_unit_at(pos)
    if !is_ascii_digit(first) {
      return false
    }
    let mut jval = first - 48
    pos = pos + 1
    let mut digits = 1
    while pos < end && is_ascii_digit(s.code_unit_at(pos)) {
      if first == 48 {
        return false
      }
      jval = jval * 10 + (s.code_unit_at(pos) - 48)
      pos = pos + 1
      digits = digits + 1
      if digits > 3 || jval > 255 {
        return false
      }
    }
    if part < 3 {
      if pos >= end || s.code_unit_at(pos) != 46 {
        return false
      }
      pos = pos + 1
    }
    part = part + 1
  }
  pos == end
}

///| RFC 4291 IPv6 address (with optional `::` compression and embedded IPv4).
fn check_ipv6_slice(s : String, start : Int, end : Int) -> Bool {
  let n = end - start
  if n < 2 || n > 45 {
    return false
  }
  let mut pos = start
  let mut groups = 0
  let mut has_double_colon = false
  if s.code_unit_at(pos) == 58 {
    if n < 2 || s.code_unit_at(pos + 1) != 58 {
      return false
    }
    has_double_colon = true
    pos = pos + 2
    if pos == end {
      return true
    }
  }
  while pos < end {
    let mut has_dot = false
    let mut k = pos
    while k < end {
      let c = s.code_unit_at(k)
      if c == 46 {
        has_dot = true
        break
      }
      if c == 58 {
        break
      }
      k = k + 1
    }
    if has_dot {
      if !check_ipv4_slice(s, pos, end) {
        return false
      }
      groups = groups + 2
      pos = end
      break
    }
    let g_start = pos
    while pos < end && is_hex_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
    let g_len = pos - g_start
    if g_len < 1 || g_len > 4 {
      return false
    }
    groups = groups + 1
    if groups > 8 {
      return false
    }
    if pos == end {
      break
    }
    if s.code_unit_at(pos) != 58 {
      return false
    }
    pos = pos + 1
    if pos == end {
      return false
    }
    if s.code_unit_at(pos) == 58 {
      if has_double_colon {
        return false
      }
      has_double_colon = true
      pos = pos + 1
    }
  }
  if has_double_colon {
    groups <= 7
  } else {
    groups == 8
  }
}

fn check_ipv6(s : String) -> Bool {
  check_ipv6_slice(s, 0, s.length())
}

///| RFC 1123 hostname: labels 1..63 chars `[A-Za-z0-9-]`, no leading/trailing `-`, total <= 253.
fn check_hostname_slice(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 0 || len > 253 {
    return false
  }
  let mut pos = start
  while pos < end {
    let label_start = pos
    while pos < end && s.code_unit_at(pos) != 46 {
      let b = s.code_unit_at(pos)
      if !is_ascii_alnum(b) && b != 45 {
        return false
      }
      pos = pos + 1
    }
    let label_len = pos - label_start
    if label_len == 0 || label_len > 63 {
      return false
    }
    if s.code_unit_at(label_start) == 45 || s.code_unit_at(pos - 1) == 45 {
      return false
    }
    if pos < end {
      pos = pos + 1
      if pos == end {
        return false
      }
    }
  }
  true
}

// ============================================================================
// IDN Hostname (RFC 5890 / 5891 / 5892 / 3492 Punycode)
// ============================================================================

fn is_idn_dot(cp : Int) -> Bool {
  cp == 0x002E || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61
}

fn is_idn_combining_mark(cp : Int) -> Bool {
  (cp >= 0x0300 && cp <= 0x036F) ||
  (cp >= 0x0483 && cp <= 0x0489) ||
  (cp >= 0x0591 && cp <= 0x05BD) ||
  (cp >= 0x064B && cp <= 0x065F) ||
  (cp >= 0x0901 && cp <= 0x0903) ||
  (cp >= 0x093E && cp <= 0x094F) ||
  (cp >= 0x1AB0 && cp <= 0x1AFF) ||
  (cp >= 0x1DC0 && cp <= 0x1DFF) ||
  (cp >= 0x20D0 && cp <= 0x20FF) ||
  (cp >= 0x302A && cp <= 0x302F) ||
  (cp >= 0xFE20 && cp <= 0xFE2F)
}

fn is_idn_disallowed(cp : Int) -> Bool {
  if cp < 0x80 {
    return !is_ascii_alnum(cp) && cp != 45
  }
  // RFC 5892 §2.6 DISALLOWED exceptions + control/surrogate/private/nonchar
  if (cp >= 0x0080 && cp <= 0x009F) || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF {
    return true
  }
  cp == 0x0640 || cp == 0x07FA || cp == 0x302E || cp == 0x302F ||
  (cp >= 0x3031 && cp <= 0x3035) || cp == 0x303B
}

fn is_greek_cp(cp : Int) -> Bool {
  (cp >= 0x0370 && cp <= 0x03FF) || (cp >= 0x1F00 && cp <= 0x1FFF)
}

fn is_hebrew_cp(cp : Int) -> Bool {
  cp >= 0x0590 && cp <= 0x05FF
}

fn is_hiragana_katakana_han(cp : Int) -> Bool {
  if cp == 0x30FB {
    return false
  }
  (cp >= 0x3040 && cp <= 0x309F) ||
  (cp >= 0x30A0 && cp <= 0x30FF) ||
  (cp >= 0x31F0 && cp <= 0x31FF) ||
  (cp >= 0x3400 && cp <= 0x4DBF) ||
  (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xF900 && cp <= 0xFAFF) ||
  (cp >= 0x20000 && cp <= 0x2FA1F)
}

fn is_virama_cp(cp : Int) -> Bool {
  cp == 0x094D || cp == 0x09CD || cp == 0x0A4D || cp == 0x0ACD ||
  cp == 0x0B4D || cp == 0x0BCD || cp == 0x0C4D || cp == 0x0CCD ||
  cp == 0x0D4D || cp == 0x0DCA || cp == 0x0E3A || cp == 0x0F84 ||
  cp == 0x1039 || cp == 0x103A || cp == 0x1714 || cp == 0x1734 ||
  cp == 0x17D2 || cp == 0x1A60 || cp == 0x1B44 || cp == 0x1BAA ||
  cp == 0xA806 || cp == 0xA8C4 || cp == 0xA953 || cp == 0xA9C0
}

fn is_arabic_dual_or_right_joining(cp : Int) -> Bool {
  (cp >= 0x0620 && cp <= 0x064A) || (cp >= 0x066E && cp <= 0x06D5)
}

fn punycode_digit(b : Int) -> Int {
  if b >= 97 && b <= 122 {
    b - 97
  } else if b >= 65 && b <= 90 {
    b - 65
  } else if b >= 48 && b <= 57 {
    b - 48 + 26
  } else {
    -1
  }
}

fn punycode_adapt(delta_in : Int, num_points : Int, first_time : Bool) -> Int {
  let mut delta = if first_time { delta_in / 700 } else { delta_in / 2 }
  delta = delta + delta / num_points
  let mut k = 0
  while delta > 455 {
    delta = delta / 35
    k = k + 36
  }
  k + (36 * delta) / (delta + 38)
}

///| RFC 3492 Punycode decoder for `xn--...` A-labels.
fn punycode_decode(encoded : String) -> Option[Array[Int]] {
  let len = encoded.length()
  if len == 0 {
    return None
  }
  let output : Array[Int] = []
  let mut last_dash = -1
  let mut i = 0
  while i < len {
    let b = encoded.code_unit_at(i)
    if b >= 128 {
      return None
    }
    if b == 45 {
      last_dash = i
    }
    i = i + 1
  }
  let mut pos = 0
  if last_dash >= 0 {
    i = 0
    while i < last_dash {
      output.push(encoded.code_unit_at(i))
      i = i + 1
    }
    pos = last_dash + 1
  }
  let mut n = 128
  let mut idx = 0
  let mut bias = 72
  while pos < len {
    let old_idx = idx
    let mut w = 1
    let mut k = 36
    while true {
      if pos >= len {
        return None
      }
      let d = punycode_digit(encoded.code_unit_at(pos))
      pos = pos + 1
      if d < 0 {
        return None
      }
      if d > (2147483647 - idx) / w {
        return None
      }
      idx = idx + d * w
      let t = if k <= bias {
        1
      } else if k >= bias + 26 {
        26
      } else {
        k - bias
      }
      if d < t {
        break
      }
      if w > 2147483647 / (36 - t) {
        return None
      }
      w = w * (36 - t)
      k = k + 36
    }
    let out_len = output.length() + 1
    bias = punycode_adapt(idx - old_idx, out_len, old_idx == 0)
    if idx / out_len > 2147483647 - n {
      return None
    }
    n = n + idx / out_len
    if n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF) {
      return None
    }
    idx = idx % out_len
    // Insert n at position idx
    output.push(0)
    let mut j = output.length() - 1
    while j > idx {
      output[j] = output[j - 1]
      j = j - 1
    }
    output[idx] = n
    idx = idx + 1
  }
  Some(output)
}

fn check_idn_label_cps(cps : Array[Int], check_xn_prefix : Bool) -> Bool {
  let n = cps.length()
  if n == 0 || n > 63 {
    return false
  }
  // Cannot start or end with '-'
  if cps[0] == 45 || cps[n - 1] == 45 {
    return false
  }
  // Cannot start with combining mark (RFC 5891 §4.2.3.2)
  if is_idn_combining_mark(cps[0]) {
    return false
  }
  // Check for `--` in 3rd & 4th positions (RFC 5891 §4.2.3.1)
  if n >= 4 && cps[2] == 45 && cps[3] == 45 {
    if !check_xn_prefix {
      return false
    }
    let c0 = cps[0]
    let c1 = cps[1]
    let is_xn = (c0 == 120 || c0 == 88) && (c1 == 110 || c1 == 78)
    if !is_xn {
      return false
    }
    // All chars must be ASCII LDH, and punycode must decode to a valid U-label
    let sb = StringBuilder::new()
    let mut i = 4
    while i < n {
      let c = cps[i]
      if c >= 128 || (!is_ascii_alnum(c) && c != 45) {
        return false
      }
      sb.write_byte(c.to_byte())
      i = i + 1
    }
    match punycode_decode(sb.to_string()) {
      Some(decoded) => return check_idn_label_cps(decoded, false)
      None => return false
    }
  }
  let mut has_arabic_indic = false
  let mut has_ext_arabic_indic = false
  let mut has_jp_or_han = false
  let mut has_katakana_dot = false
  let mut i = 0
  while i < n {
    let cp = cps[i]
    if is_idn_disallowed(cp) {
      return false
    }
    if cp >= 0x0660 && cp <= 0x0669 {
      has_arabic_indic = true
    } else if cp >= 0x06F0 && cp <= 0x06F9 {
      has_ext_arabic_indic = true
    }
    if is_hiragana_katakana_han(cp) {
      has_jp_or_han = true
    }
    if cp == 0x30FB {
      has_katakana_dot = true
    }
    // Appendix A.3: MIDDLE DOT U+00B7 must be surrounded by 'l'
    if cp == 0x00B7 {
      if i == 0 || i + 1 >= n || cps[i - 1] != 108 || cps[i + 1] != 108 {
        return false
      }
    }
    // Appendix A.4: GREEK LOWER NUMERAL SIGN (KERAIA) U+0375 must be followed by Greek
    if cp == 0x0375 {
      if i + 1 >= n || !is_greek_cp(cps[i + 1]) {
        return false
      }
    }
    // Appendix A.5 & A.6: HEBREW GERESH U+05F3 / GERSHAYIM U+05F4 must be preceded by Hebrew
    if cp == 0x05F3 || cp == 0x05F4 {
      if i == 0 || !is_hebrew_cp(cps[i - 1]) {
        return false
      }
    }
    // Appendix A.2: ZERO WIDTH JOINER U+200D must be preceded by Virama
    if cp == 0x200D {
      if i == 0 || !is_virama_cp(cps[i - 1]) {
        return false
      }
    }
    // Appendix A.1: ZERO WIDTH NON-JOINER U+200C must be preceded by Virama or Arabic joining context
    if cp == 0x200C {
      let ok_virama = i > 0 && is_virama_cp(cps[i - 1])
      let ok_joining = i > 0 && i + 1 < n && is_arabic_dual_or_right_joining(cps[i - 1]) && is_arabic_dual_or_right_joining(cps[i + 1])
      if !ok_virama && !ok_joining {
        return false
      }
    }
    i = i + 1
  }
  if has_arabic_indic && has_ext_arabic_indic {
    return false
  }
  if has_katakana_dot && !has_jp_or_han {
    return false
  }
  true
}

fn check_idn_hostname_slice(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let mut pos = start
  let mut total_cps = 0
  let mut labels = 0
  let cur_label : Array[Int] = []
  while pos < end {
    let (cp, nxt) = decode_utf8_cp(s, pos)
    pos = nxt
    total_cps = total_cps + 1
    if total_cps > 253 {
      return false
    }
    if is_idn_dot(cp) {
      if cur_label.length() == 0 {
        return false
      }
      if !check_idn_label_cps(cur_label, true) {
        return false
      }
      labels = labels + 1
      while cur_label.length() > 0 {
        let _ = cur_label.pop()
      }
      if pos >= end {
        // Trailing dot rejected
        return false
      }
    } else {
      cur_label.push(cp)
    }
  }
  if cur_label.length() == 0 {
    return false
  }
  if !check_idn_label_cps(cur_label, true) {
    return false
  }
  let _ = labels
  true
}

// ============================================================================
// Email (RFC 5321/5322) & IDN-Email (RFC 6531)
// ============================================================================

fn is_email_atext(b : Int) -> Bool {
  is_ascii_alnum(b) ||
  b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 ||
  b == 42 || b == 43 || b == 45 || b == 47 || b == 61 || b == 63 ||
  b == 94 || b == 95 || b == 96 || b == 123 || b == 124 || b == 125 || b == 126
}

fn check_email_domain(s : String, start : Int, end : Int, allow_idn : Bool) -> Bool {
  if start >= end {
    return false
  }
  if s.code_unit_at(start) == 91 && s.code_unit_at(end - 1) == 93 {
    let inner_start = start + 1
    let inner_end = end - 1
    if inner_end <= inner_start {
      return false
    }
    // Check `[IPv6:...]` (case-insensitive prefix "IPv6:")
    if inner_end - inner_start > 5 {
      let c0 = s.code_unit_at(inner_start)
      let c1 = s.code_unit_at(inner_start + 1)
      let c2 = s.code_unit_at(inner_start + 2)
      let c3 = s.code_unit_at(inner_start + 3)
      let c4 = s.code_unit_at(inner_start + 4)
      if (c0 == 73 || c0 == 105) && (c1 == 80 || c1 == 112) &&
      (c2 == 86 || c2 == 118) && c3 == 54 && c4 == 58 {
        return check_ipv6_slice(s, inner_start + 5, inner_end)
      }
    }
    return check_ipv4_slice(s, inner_start, inner_end)
  }
  if allow_idn {
    check_idn_hostname_slice(s, start, end)
  } else {
    check_hostname_slice(s, start, end)
  }
}

fn check_email_impl(s : String, allow_idn : Bool) -> Bool {
  let n = s.length()
  if n < 3 || n > 254 {
    return false
  }
  let mut at = -1
  let mut i = n - 1
  while i >= 0 {
    if s.code_unit_at(i) == 64 {
      at = i
      break
    }
    i = i - 1
  }
  if at <= 0 || at > 64 || at >= n - 1 {
    return false
  }
  if s.code_unit_at(0) == 34 {
    if at < 2 || s.code_unit_at(at - 1) != 34 {
      return false
    }
    let mut j = 1
    while j < at - 1 {
      let b = s.code_unit_at(j)
      if b == 92 {
        j = j + 2
        if j > at - 1 {
          return false
        }
      } else if b == 34 || b < 32 || b == 127 || (!allow_idn && b >= 128) {
        return false
      } else {
        j = j + 1
      }
    }
  } else {
    if s.code_unit_at(0) == 46 || s.code_unit_at(at - 1) == 46 {
      return false
    }
    let mut prev_dot = false
    let mut j = 0
    while j < at {
      let b = s.code_unit_at(j)
      if b == 46 {
        if prev_dot {
          return false
        }
        prev_dot = true
        j = j + 1
      } else if is_email_atext(b) {
        prev_dot = false
        j = j + 1
      } else if allow_idn && b >= 128 {
        let (cp, nxt) = decode_utf8_cp(s, j)
        if cp < 0x80 || (cp >= 0x80 && cp <= 0x9F) {
          return false
        }
        prev_dot = false
        j = nxt
      } else {
        return false
      }
    }
  }
  check_email_domain(s, at + 1, n, allow_idn)
}

// ============================================================================
// RFC 3986 URI & URI-Reference / RFC 3987 IRI & IRI-Reference
// ============================================================================

fn is_uri_unreserved(b : Int) -> Bool {
  is_ascii_alnum(b) || b == 45 || b == 46 || b == 95 || b == 126
}

fn is_uri_sub_delim(b : Int) -> Bool {
  b == 33 || b == 36 || b == 38 || b == 39 || b == 40 || b == 41 ||
  b == 42 || b == 43 || b == 44 || b == 59 || b == 61
}

fn is_iri_ucschar(cp : Int) -> Bool {
  (cp >= 0xA0 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF) ||
  (cp >= 0xFDF0 && cp <= 0xFFEF) || (cp >= 0x10000 && cp <= 0xEFFFD)
}

fn is_iri_iprivate(cp : Int) -> Bool {
  (cp >= 0xE000 && cp <= 0xF8FF) || (cp >= 0xF0000 && cp <= 0xFFFFD) ||
  (cp >= 0x100000 && cp <= 0x10FFFD)
}

fn check_uri_pchar_seq(s : String, start : Int, end : Int, allow_slash : Bool, allow_qmark : Bool, allow_iri : Bool, allow_iprivate : Bool) -> Bool {
  let mut pos = start
  while pos < end {
    let b = s.code_unit_at(pos)
    if b == 37 {
      if pos + 2 >= end || !is_hex_digit(s.code_unit_at(pos + 1)) || !is_hex_digit(s.code_unit_at(pos + 2)) {
        return false
      }
      pos = pos + 3
    } else if is_uri_unreserved(b) || is_uri_sub_delim(b) || b == 58 || b == 64 {
      pos = pos + 1
    } else if allow_slash && b == 47 {
      pos = pos + 1
    } else if allow_qmark && b == 63 {
      pos = pos + 1
    } else if allow_iri && b >= 128 {
      let (cp, nxt) = decode_utf8_cp(s, pos)
      if is_iri_ucschar(cp) || (allow_iprivate && is_iri_iprivate(cp)) {
        pos = nxt
      } else {
        return false
      }
    } else {
      return false
    }
  }
  true
}

fn check_uri_authority(s : String, start : Int, end : Int, allow_iri : Bool) -> Bool {
  // [ userinfo "@" ] host [ ":" port ]
  let mut host_start = start
  let mut at = -1
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 64 {
      at = i
      break
    }
    i = i + 1
  }
  if at >= 0 {
    // Validate userinfo: *( unreserved / pct-encoded / sub-delims / ":" )
    if !check_uri_pchar_seq(s, start, at, false, false, allow_iri, false) {
      return false
    }
    host_start = at + 1
  }
  if host_start >= end {
    // Empty host is valid in RFC 3986 (e.g. file:///path)
    return true
  }
  let mut port_start = end
  if s.code_unit_at(host_start) == 91 {
    // IP-literal: "[" ( IPv6address / IPvFuture ) "]"
    let mut close_br = -1
    i = host_start + 1
    while i < end {
      if s.code_unit_at(i) == 93 {
        close_br = i
        break
      }
      i = i + 1
    }
    if close_br < 0 {
      return false
    }
    let lit_start = host_start + 1
    let lit_end = close_br
    if lit_end <= lit_start {
      return false
    }
    let first = s.code_unit_at(lit_start)
    if first == 118 || first == 86 {
      // IPvFuture: "v" 1*HEXDIG "." 1*( unreserved / sub-delims / ":" )
      let mut p = lit_start + 1
      let hex_start = p
      while p < lit_end && is_hex_digit(s.code_unit_at(p)) {
        p = p + 1
      }
      if p == hex_start || p >= lit_end || s.code_unit_at(p) != 46 {
        return false
      }
      p = p + 1
      if p >= lit_end {
        return false
      }
      while p < lit_end {
        let cb = s.code_unit_at(p)
        if !is_uri_unreserved(cb) && !is_uri_sub_delim(cb) && cb != 58 {
          return false
        }
        p = p + 1
      }
    } else if !check_ipv6_slice(s, lit_start, lit_end) {
      return false
    }
    if close_br + 1 < end {
      if s.code_unit_at(close_br + 1) != 58 {
        return false
      }
      port_start = close_br + 2
    }
  } else {
    // reg-name [ ":" port ] — colon is ONLY allowed as port separator!
    let mut colon = -1
    i = host_start
    while i < end {
      if s.code_unit_at(i) == 58 {
        colon = i
        break
      }
      i = i + 1
    }
    let host_end = if colon >= 0 {
      port_start = colon + 1
      colon
    } else {
      end
    }
    // Validate reg-name: *( unreserved / pct-encoded / sub-delims / ucschar )
    let mut p = host_start
    while p < host_end {
      let b = s.code_unit_at(p)
      if b == 37 {
        if p + 2 >= host_end || !is_hex_digit(s.code_unit_at(p + 1)) || !is_hex_digit(s.code_unit_at(p + 2)) {
          return false
        }
        p = p + 3
      } else if is_uri_unreserved(b) || is_uri_sub_delim(b) {
        p = p + 1
      } else if allow_iri && b >= 128 {
        let (cp, nxt) = decode_utf8_cp(s, p)
        if !is_iri_ucschar(cp) {
          return false
        }
        p = nxt
      } else {
        return false
      }
    }
  }
  // Validate port: *DIGIT
  let mut p = port_start
  while p < end {
    if !is_ascii_digit(s.code_unit_at(p)) {
      return false
    }
    p = p + 1
  }
  true
}

fn check_uri_impl(s : String, require_scheme : Bool, allow_iri : Bool) -> Bool {
  let n = s.length()
  if require_scheme && n < 3 {
    return false
  }
  let mut pos = 0
  let mut has_scheme = false
  // Check for scheme: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"
  if pos < n && is_ascii_alpha(s.code_unit_at(pos)) {
    let mut k = pos + 1
    while k < n {
      let b = s.code_unit_at(k)
      if b == 58 {
        has_scheme = true
        pos = k + 1
        break
      }
      if !is_ascii_alnum(b) && b != 43 && b != 45 && b != 46 {
        break
      }
      k = k + 1
    }
  }
  if require_scheme && !has_scheme {
    return false
  }

  // Split off optional `#fragment` (at most ONE `#`!)
  let mut frag_start = -1
  let mut i = pos
  while i < n {
    if s.code_unit_at(i) == 35 {
      frag_start = i
      break
    }
    i = i + 1
  }
  let before_frag = if frag_start >= 0 { frag_start } else { n }
  if frag_start >= 0 {
    // Fragment: *( pchar / "/" / "?" ) — no second '#' allowed!
    if !check_uri_pchar_seq(s, frag_start + 1, n, true, true, allow_iri, false) {
      return false
    }
  }

  // Split off optional `?query`
  let mut query_start = -1
  i = pos
  while i < before_frag {
    if s.code_unit_at(i) == 63 {
      query_start = i
      break
    }
    i = i + 1
  }
  let hier_end = if query_start >= 0 { query_start } else { before_frag }
  if query_start >= 0 {
    if !check_uri_pchar_seq(s, query_start + 1, before_frag, true, true, allow_iri, true) {
      return false
    }
  }

  // Validate hier-part / relative-part: [ "//" authority ] path
  if pos + 1 < hier_end && s.code_unit_at(pos) == 47 && s.code_unit_at(pos + 1) == 47 {
    let auth_start = pos + 2
    let mut auth_end = auth_start
    while auth_end < hier_end && s.code_unit_at(auth_end) != 47 {
      auth_end = auth_end + 1
    }
    if !check_uri_authority(s, auth_start, auth_end, allow_iri) {
      return false
    }
    pos = auth_end
  }

  // Validate path: *( pchar / "/" )
  check_uri_pchar_seq(s, pos, hier_end, true, false, allow_iri, false)
}

///| RFC 6901 JSON Pointer format check.
fn check_json_pointer(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return true
  }
  if s.code_unit_at(0) != 47 {
    return false
  }
  let mut i = 1
  while i < n {
    if s.code_unit_at(i) == 126 {
      if i + 1 >= n {
        return false
      }
      let next = s.code_unit_at(i + 1)
      if next != 48 && next != 49 {
        return false
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  true
}

///| Relative JSON Pointer: non-negative integer (no leading zeros) + (`#` | json-pointer).
fn check_relative_json_pointer(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let first = s.code_unit_at(0)
  if !is_ascii_digit(first) {
    return false
  }
  let mut pos = 1
  if first == 48 {
    // Leading '0' must NOT be followed by another digit
    if pos < n && is_ascii_digit(s.code_unit_at(pos)) {
      return false
    }
  } else {
    while pos < n && is_ascii_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
  }
  if pos == n {
    return true
  }
  let b = s.code_unit_at(pos)
  if b == 35 {
    return pos + 1 == n
  }
  if b == 47 {
    return check_json_pointer(s.slice(pos, n))
  }
  false
}

///| RFC 6570 URI Template format check.
fn check_uri_template(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 123 {
      // '{' expression '}'
      i = i + 1
      if i >= n {
        return false
      }
      // Optional operator: + # . / ; ? &
      let op = s.code_unit_at(i)
      if op == 43 || op == 35 || op == 46 || op == 47 || op == 59 || op == 63 || op == 38 {
        i = i + 1
      }
      // varlist = varspec *( "," varspec )
      let mut need_var = true
      while i < n {
        if !need_var {
          let sep = s.code_unit_at(i)
          if sep == 125 {
            break
          }
          if sep == 44 {
            i = i + 1
            need_var = true
            continue
          }
          return false
        }
        // varname = varchar *( ["."] varchar )
        let vstart = i
        let mut prev_dot = false
        while i < n {
          let vc = s.code_unit_at(i)
          if is_ascii_alnum(vc) || vc == 95 {
            prev_dot = false
            i = i + 1
          } else if vc == 37 {
            if i + 2 >= n || !is_hex_digit(s.code_unit_at(i + 1)) || !is_hex_digit(s.code_unit_at(i + 2)) {
              return false
            }
            prev_dot = false
            i = i + 3
          } else if vc == 46 {
            if i == vstart || prev_dot {
              return false
            }
            prev_dot = true
            i = i + 1
          } else {
            break
          }
        }
        if i == vstart || prev_dot {
          return false
        }
        // Optional modifier: '*' or ':' max-length (1..9999)
        if i < n {
          let mc = s.code_unit_at(i)
          if mc == 42 {
            i = i + 1
          } else if mc == 58 {
            i = i + 1
            if i >= n || s.code_unit_at(i) < 49 || s.code_unit_at(i) > 57 {
              return false
            }
            let mut digits = 0
            while i < n && is_ascii_digit(s.code_unit_at(i)) {
              digits = digits + 1
              if digits > 4 {
                return false
              }
              i = i + 1
            }
          }
        }
        need_var = false
      }
      if need_var || i >= n || s.code_unit_at(i) != 125 {
        return false
      }
      i = i + 1
    } else if b == 125 {
      // Unmatched '}'
      return false
    } else if b == 37 {
      if i + 2 >= n || !is_hex_digit(s.code_unit_at(i + 1)) || !is_hex_digit(s.code_unit_at(i + 2)) {
        return false
      }
      i = i + 3
    } else if b <= 32 || b == 34 || b == 39 || b == 60 || b == 62 || b == 92 || b == 94 || b == 96 || b == 124 || b == 127 {
      return false
    } else {
      i = i + 1
    }
  }
  true
}

///| Validate a single string against a named JSON Schema format.
///| Unknown format names return `true` per JSON Schema specification.
pub fn check_format(format : String, value : String) -> Bool {
  if format == "email" {
    check_email_impl(value, false)
  } else if format == "idn-email" {
    check_email_impl(value, true)
  } else if format == "uri" {
    check_uri_impl(value, true, false)
  } else if format == "uri-reference" {
    check_uri_impl(value, false, false)
  } else if format == "iri" {
    check_uri_impl(value, true, true)
  } else if format == "iri-reference" {
    check_uri_impl(value, false, true)
  } else if format == "uri-template" {
    check_uri_template(value)
  } else if format == "uuid" {
    check_uuid(value)
  } else if format == "date" {
    check_date_slice(value, 0, value.length())
  } else if format == "time" {
    check_time_slice(value, 0, value.length())
  } else if format == "date-time" {
    check_date_time(value)
  } else if format == "duration" {
    check_duration(value)
  } else if format == "ipv4" {
    check_ipv4_slice(value, 0, value.length())
  } else if format == "ipv6" {
    check_ipv6(value)
  } else if format == "hostname" {
    check_hostname_slice(value, 0, value.length())
  } else if format == "idn-hostname" {
    check_idn_hostname_slice(value, 0, value.length())
  } else if format == "json-pointer" {
    check_json_pointer(value)
  } else if format == "relative-json-pointer" {
    check_relative_json_pointer(value)
  } else if format == "regex" {
    is_valid_ecma_regex(value)
  } else {
    true
  }
}
