///| JSON Schema optional Format validators (zero-allocation byte-level checks):
///| email, uri, uuid, date, time, date-time, ipv4, ipv6, hostname, json-pointer, regex.

import "regex"

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn is_ascii_alnum(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn parse_digits(s : String, start : Int, count : Int) -> Int {
  if start + count > s.length() {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(start + i)
    if !is_ascii_digit(b) {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn is_leap_year(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_in_month(y : Int, m : Int) -> Int {
  if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
    31
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else if m == 2 {
    if is_leap_year(y) {
      29
    } else {
      28
    }
  } else {
    0
  }
}

///| RFC 3339 full-date: `YYYY-MM-DD`
fn check_date_slice(s : String, start : Int, len : Int) -> Bool {
  if len != 10 {
    return false
  }
  if s.code_unit_at(start + 4) != 45 || s.code_unit_at(start + 7) != 45 {
    return false
  }
  let y = parse_digits(s, start, 4)
  let m = parse_digits(s, start + 5, 2)
  let d = parse_digits(s, start + 8, 2)
  if y < 0 || m < 1 || m > 12 {
    return false
  }
  let max_d = days_in_month(y, m)
  d >= 1 && d <= max_d
}

///| RFC 3339 full-time: `HH:MM:SS[.frac](Z|z|+HH:MM|-HH:MM)`
fn check_time_slice(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 9 {
    return false
  }
  if s.code_unit_at(start + 2) != 58 || s.code_unit_at(start + 5) != 58 {
    return false
  }
  let hour = parse_digits(s, start, 2)
  let min = parse_digits(s, start + 3, 2)
  let sec = parse_digits(s, start + 6, 2)
  if hour < 0 || hour > 23 || min < 0 || min > 59 || sec < 0 || sec > 60 {
    return false
  }
  let mut pos = start + 8
  // Optional fractional seconds
  if pos < end && s.code_unit_at(pos) == 46 {
    pos = pos + 1
    let frac_start = pos
    while pos < end && is_ascii_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
    if pos == frac_start {
      return false
    }
  }
  if pos >= end {
    return false
  }
  let tz = s.code_unit_at(pos)
  let mut tz_offset_min = 0
  if tz == 90 || tz == 122 {
    // 'Z' or 'z'
    if pos + 1 != end {
      return false
    }
  } else if tz == 43 || tz == 45 {
    // '+' or '-' followed by HH:MM
    if pos + 6 != end || s.code_unit_at(pos + 3) != 58 {
      return false
    }
    let tzh = parse_digits(s, pos + 1, 2)
    let tzm = parse_digits(s, pos + 4, 2)
    if tzh < 0 || tzh > 23 || tzm < 0 || tzm > 59 {
      return false
    }
    let mag = tzh * 60 + tzm
    tz_offset_min = if tz == 43 { mag } else { -mag }
  } else {
    return false
  }
  // Leap second validation: UTC time must be 23:59:60
  if sec == 60 {
    let mut utc_min = hour * 60 + min - tz_offset_min
    while utc_min < 0 {
      utc_min = utc_min + 1440
    }
    while utc_min >= 1440 {
      utc_min = utc_min - 1440
    }
    if utc_min != 23 * 60 + 59 {
      return false
    }
  }
  true
}

///| RFC 3339 date-time: `YYYY-MM-DD(T|t)HH:MM:SS[.frac](Z|+HH:MM|-HH:MM)`
fn check_date_time(s : String) -> Bool {
  let n = s.length()
  if n < 20 {
    return false
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 {
    return false
  }
  check_date_slice(s, 0, 10) && check_time_slice(s, 11, n)
}

///| RFC 4122 UUID: `8-4-4-4-12` hex digits
fn check_uuid(s : String) -> Bool {
  if s.length() != 36 {
    return false
  }
  let mut i = 0
  while i < 36 {
    let b = s.code_unit_at(i)
    if i == 8 || i == 13 || i == 18 || i == 23 {
      if b != 45 {
        return false
      }
    } else if !is_hex_digit(b) {
      return false
    }
    i = i + 1
  }
  true
}

///| IPv4 dotted-quad: 4 decimal octets 0..255 with no leading zeros.
fn check_ipv4_slice(s : String, start : Int, end : Int) -> Bool {
  let mut pos = start
  let mut part = 0
  while part < 4 {
    if pos >= end {
      return false
    }
    let first = s.code_unit_at(pos)
    if !is_ascii_digit(first) {
      return false
    }
    let mut jval = first - 48
    pos = pos + 1
    let mut digits = 1
    while pos < end && is_ascii_digit(s.code_unit_at(pos)) {
      if first == 48 {
        // Leading zero forbidden
        return false
      }
      jval = jval * 10 + (s.code_unit_at(pos) - 48)
      pos = pos + 1
      digits = digits + 1
      if digits > 3 || jval > 255 {
        return false
      }
    }
    if part < 3 {
      if pos >= end || s.code_unit_at(pos) != 46 {
        return false
      }
      pos = pos + 1
    }
    part = part + 1
  }
  pos == end
}

///| RFC 4291 IPv6 address (with optional `::` compression and embedded IPv4).
fn check_ipv6(s : String) -> Bool {
  let n = s.length()
  if n < 2 || n > 45 {
    return false
  }
  let mut pos = 0
  let mut groups = 0
  let mut has_double_colon = false
  if s.code_unit_at(0) == 58 {
    if n < 2 || s.code_unit_at(1) != 58 {
      return false
    }
    has_double_colon = true
    pos = 2
    if pos == n {
      return true
    }
  }
  while pos < n {
    // Check if the remainder is an embedded IPv4 address
    let mut has_dot = false
    let mut k = pos
    while k < n {
      let c = s.code_unit_at(k)
      if c == 46 {
        has_dot = true
        break
      }
      if c == 58 {
        break
      }
      k = k + 1
    }
    if has_dot {
      if !check_ipv4_slice(s, pos, n) {
        return false
      }
      groups = groups + 2
      pos = n
      break
    }
    // Parse 1..4 hex digits
    let g_start = pos
    while pos < n && is_hex_digit(s.code_unit_at(pos)) {
      pos = pos + 1
    }
    let g_len = pos - g_start
    if g_len < 1 || g_len > 4 {
      return false
    }
    groups = groups + 1
    if groups > 8 {
      return false
    }
    if pos == n {
      break
    }
    if s.code_unit_at(pos) != 58 {
      return false
    }
    pos = pos + 1
    if pos == n {
      // Trailing single ':' is invalid
      return false
    }
    if s.code_unit_at(pos) == 58 {
      if has_double_colon {
        return false
      }
      has_double_colon = true
      pos = pos + 1
    }
  }
  if has_double_colon {
    groups <= 7
  } else {
    groups == 8
  }
}

///| RFC 1123 hostname: labels 1..63 chars `[A-Za-z0-9-]`, no leading/trailing `-`, total <= 253.
fn check_hostname_slice(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 0 || len > 253 {
    return false
  }
  let mut pos = start
  while pos < end {
    let label_start = pos
    while pos < end && s.code_unit_at(pos) != 46 {
      let b = s.code_unit_at(pos)
      if !is_ascii_alnum(b) && b != 45 {
        return false
      }
      pos = pos + 1
    }
    let label_len = pos - label_start
    if label_len == 0 || label_len > 63 {
      return false
    }
    if s.code_unit_at(label_start) == 45 || s.code_unit_at(pos - 1) == 45 {
      return false
    }
    if pos < end {
      // skip '.'
      pos = pos + 1
      if pos == end {
        // trailing dot not allowed in strict hostname
        return false
      }
    }
  }
  true
}

fn is_email_atext(b : Int) -> Bool {
  is_ascii_alnum(b) ||
  b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 ||
  b == 42 || b == 43 || b == 45 || b == 47 || b == 61 || b == 63 ||
  b == 94 || b == 95 || b == 96 || b == 123 || b == 124 || b == 125 || b == 126
}

///| Practical RFC 5321/5322 email validation.
fn check_email(s : String) -> Bool {
  let n = s.length()
  if n < 3 || n > 254 {
    return false
  }
  // Find last '@'
  let mut at = -1
  let mut i = n - 1
  while i >= 0 {
    if s.code_unit_at(i) == 64 {
      at = i
      break
    }
    i = i - 1
  }
  if at <= 0 || at > 64 || at >= n - 1 {
    return false
  }
  // Validate local part (quoted or dot-atom)
  if s.code_unit_at(0) == 34 {
    if at < 2 || s.code_unit_at(at - 1) != 34 {
      return false
    }
    let mut j = 1
    while j < at - 1 {
      let b = s.code_unit_at(j)
      if b == 92 {
        j = j + 2
        if j > at - 1 {
          return false
        }
      } else if b == 34 || b < 32 || b == 127 {
        return false
      } else {
        j = j + 1
      }
    }
  } else {
    if s.code_unit_at(0) == 46 || s.code_unit_at(at - 1) == 46 {
      return false
    }
    let mut prev_dot = false
    let mut j = 0
    while j < at {
      let b = s.code_unit_at(j)
      if b == 46 {
        if prev_dot {
          return false
        }
        prev_dot = true
      } else if is_email_atext(b) {
        prev_dot = false
      } else {
        return false
      }
      j = j + 1
    }
  }
  // Domain part: hostname or bracketed IP literal
  if s.code_unit_at(at + 1) == 91 && s.code_unit_at(n - 1) == 93 {
    let inner_start = at + 2
    let inner_end = n - 1
    if inner_end <= inner_start {
      return false
    }
    check_ipv4_slice(s, inner_start, inner_end)
  } else {
    check_hostname_slice(s, at + 1, n)
  }
}

///| RFC 3986 URI check: `scheme ":" hier-part [ "?" query ] [ "#" fragment ]`.
fn check_uri(s : String) -> Bool {
  let n = s.length()
  if n < 3 {
    return false
  }
  // Scheme: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )
  if !is_ascii_alpha(s.code_unit_at(0)) {
    return false
  }
  let mut pos = 1
  while pos < n {
    let b = s.code_unit_at(pos)
    if b == 58 {
      break
    }
    if !is_ascii_alnum(b) && b != 43 && b != 45 && b != 46 {
      return false
    }
    pos = pos + 1
  }
  if pos >= n || s.code_unit_at(pos) != 58 {
    return false
  }
  pos = pos + 1
  // Validate remaining URI characters and percent-encoding
  while pos < n {
    let b = s.code_unit_at(pos)
    if b == 37 {
      // '%' must be followed by two hex digits
      if pos + 2 >= n || !is_hex_digit(s.code_unit_at(pos + 1)) || !is_hex_digit(s.code_unit_at(pos + 2)) {
        return false
      }
      pos = pos + 3
    } else if b <= 32 || b >= 127 || b == 34 || b == 60 || b == 62 || b == 92 || b == 94 || b == 96 || b == 123 || b == 124 || b == 125 {
      return false
    } else {
      pos = pos + 1
    }
  }
  true
}

///| RFC 6901 JSON Pointer format check.
fn check_json_pointer(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return true
  }
  if s.code_unit_at(0) != 47 {
    return false
  }
  let mut i = 1
  while i < n {
    if s.code_unit_at(i) == 126 {
      // '~' must be followed by '0' or '1'
      if i + 1 >= n {
        return false
      }
      let next = s.code_unit_at(i + 1)
      if next != 48 && next != 49 {
        return false
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  true
}

///| Validate a single string against a named JSON Schema format.
///| Unknown format names return `true` per JSON Schema specification.
pub fn check_format(format : String, value : String) -> Bool {
  if format == "email" {
    check_email(value)
  } else if format == "uri" {
    check_uri(value)
  } else if format == "uuid" {
    check_uuid(value)
  } else if format == "date" {
    check_date_slice(value, 0, value.length())
  } else if format == "time" {
    check_time_slice(value, 0, value.length())
  } else if format == "date-time" {
    check_date_time(value)
  } else if format == "ipv4" {
    check_ipv4_slice(value, 0, value.length())
  } else if format == "ipv6" {
    check_ipv6(value)
  } else if format == "hostname" {
    check_hostname_slice(value, 0, value.length())
  } else if format == "json-pointer" {
    check_json_pointer(value)
  } else if format == "regex" {
    match regex::compile(value) {
      Ok(_) => true
      Err(_) => false
    }
  } else {
    true
  }
}
