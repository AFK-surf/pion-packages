///| Core public types, options, error types, and compiled flat IR for `packages/jsonschema`.

import "json5"
import "regex"

///| JSON Schema specification draft.
pub enum Draft {
  ///| JSON Schema Draft 2020-12.
  Draft202012
  ///| JSON Schema Draft-07.
  Draft7
  ///| Automatically detect from `$schema`, defaulting to Draft 2020-12.
  Auto
}

///| Internal resolved draft (preserves public `Draft` enum compatibility).
enum ResolvedDraft {
  Draft4
  Draft6
  Draft7
  Draft201909
  Draft202012
}

fn resolved_is_draft4(d : ResolvedDraft) -> Bool {
  match d {
    ResolvedDraft::Draft4 => true
    _ => false
  }
}

fn resolved_is_draft7_or_earlier(d : ResolvedDraft) -> Bool {
  match d {
    ResolvedDraft::Draft4 => true
    ResolvedDraft::Draft6 => true
    ResolvedDraft::Draft7 => true
    _ => false
  }
}

fn resolved_is_201909(d : ResolvedDraft) -> Bool {
  match d {
    ResolvedDraft::Draft201909 => true
    _ => false
  }
}

fn resolved_is_202012(d : ResolvedDraft) -> Bool {
  match d {
    ResolvedDraft::Draft202012 => true
    _ => false
  }
}

///| Compare two `Draft` values for equality.
pub fn draft_eq(a : Draft, b : Draft) -> Bool {
  match (a, b) {
    (Draft::Draft202012, Draft::Draft202012) => true
    (Draft::Draft7, Draft::Draft7) => true
    (Draft::Auto, Draft::Auto) => true
    _ => false
  }
}

///| Options controlling schema compilation.
pub struct CompileOptions {
  pub draft : Draft
  pub max_depth : Int
  pub validate_formats : Bool
}

///| Default compile options (`Auto` draft, `max_depth: 128`, `validate_formats: false`).
pub fn CompileOptions::default() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Auto,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Draft 2020-12 compile options.
pub fn CompileOptions::draft202012() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Draft202012,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Draft-07 compile options.
pub fn CompileOptions::draft7() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Draft7,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Options controlling instance validation.
pub struct ValidateOptions {
  pub validate_formats : Bool
  pub max_depth : Int
}

///| Default validation options (`validate_formats: false`, `max_depth: 128`).
pub fn ValidateOptions::default() -> ValidateOptions {
  ValidateOptions::{ validate_formats: false, max_depth: 128 }
}

///| Validation options with explicit format validation toggle.
pub fn ValidateOptions::with_formats(validate_formats : Bool) -> ValidateOptions {
  ValidateOptions::{ validate_formats: validate_formats, max_depth: 128 }
}

///| Category of a schema compilation or input parsing error.
pub enum SchemaErrorKind {
  ParseError
  InvalidSchema
  UnresolvedRef
  InvalidRegex
  InvalidPointer
  LimitExceeded
}

///| Compare two `SchemaErrorKind` values for equality.
pub fn schema_error_kind_eq(a : SchemaErrorKind, b : SchemaErrorKind) -> Bool {
  match (a, b) {
    (SchemaErrorKind::ParseError, SchemaErrorKind::ParseError) => true
    (SchemaErrorKind::InvalidSchema, SchemaErrorKind::InvalidSchema) => true
    (SchemaErrorKind::UnresolvedRef, SchemaErrorKind::UnresolvedRef) => true
    (SchemaErrorKind::InvalidRegex, SchemaErrorKind::InvalidRegex) => true
    (SchemaErrorKind::InvalidPointer, SchemaErrorKind::InvalidPointer) => true
    (SchemaErrorKind::LimitExceeded, SchemaErrorKind::LimitExceeded) => true
    _ => false
  }
}

///| Error returned when parsing or compiling a JSON Schema fails.
pub struct SchemaError {
  pub kind : SchemaErrorKind
  pub schema_path : String
  pub message : String
}

///| Construct a `SchemaError`.
pub fn SchemaError::new(
  kind : SchemaErrorKind,
  schema_path : String,
  message : String,
) -> SchemaError {
  SchemaError::{ kind: kind, schema_path: schema_path, message: message }
}

///| Structured diagnostic for a single JSON Schema validation failure.
pub struct ValidationError {
  pub instance_path : String
  pub schema_path : String
  pub keyword : String
  pub message : String
}

///| Construct a `ValidationError`.
pub fn ValidationError::new(
  instance_path : String,
  schema_path : String,
  keyword : String,
  message : String,
) -> ValidationError {
  ValidationError::{
    instance_path: instance_path,
    schema_path: schema_path,
    keyword: keyword,
    message: message,
  }
}

// Type bitmask constants
let type_null : Int = 1
let type_bool : Int = 2
let type_int : Int = 4
let type_num : Int = 8
let type_str : Int = 16
let type_arr : Int = 32
let type_obj : Int = 64

// Keyword presence bitmask constants for fast dispatch (fits in 31 bits, wasm32-safe)
let kw_type : Int = 1
let kw_const : Int = 2
let kw_enum : Int = 4
let kw_min : Int = 8
let kw_max : Int = 16
let kw_excl_min : Int = 32
let kw_excl_max : Int = 64
let kw_multiple_of : Int = 128
let kw_min_len : Int = 256
let kw_max_len : Int = 512
let kw_pattern : Int = 1024
let kw_format : Int = 2048
let kw_min_items : Int = 4096
let kw_max_items : Int = 8192
let kw_unique_items : Int = 16384
let kw_prefix_items : Int = 32768
let kw_items : Int = 65536
let kw_contains : Int = 131072
let kw_min_props : Int = 262144
let kw_max_props : Int = 524288
let kw_required : Int = 1048576
let kw_properties : Int = 2097152
let kw_pattern_props : Int = 4194304
let kw_additional_props : Int = 8388608
let kw_property_names : Int = 16777216
let kw_dep_required : Int = 33554432
let kw_dep_schemas : Int = 67108864
let kw_combinators : Int = 134217728
let kw_conditional : Int = 268435456
let kw_ref : Int = 536870912
let kw_unevaluated : Int = 1073741824

///| Open-addressing string-to-index map for O(1) property lookup.
struct StrIndexMap {
  keys : Array[String]
  vals : Array[Int]
  buckets : FixedArray[Int]
  mask : Int
}

///| Growable open-addressing String -> Int hash map (for compiler tables & runtime lookup).
struct StrHashMap {
  keys : Array[String]
  vals : Array[Int]
  mut buckets : FixedArray[Int]
  mut mask : Int
}

///| Hybrid small-array + open-addressing String set (for O(1) EvalAnn & required checks).
struct StrSet {
  items : Array[String]
  mut buckets : FixedArray[Int]
  mut mask : Int
  mut hashed : Bool
}

///| Hybrid small-array + open-addressing Int set (for O(1) EvalAnn item indices).
struct IntSet {
  items : Array[Int]
  mut buckets : FixedArray[Int]
  mut mask : Int
  mut hashed : Bool
}

///| Single ASCII byte-class atom for deterministic `^...$` fast regex matching.
struct AsciiAtom {
  lo : UInt64
  hi : UInt64
  min_rep : Int
  max_rep : Int
}

///| Compiled ECMA-262 regex: fast ASCII sequence/prefix for common anchored patterns,
///| linear-time `packages/regex` for normal patterns, and fuel-bounded backtracking
///| engine for lookaround / backreference patterns.
enum CompiledRegex {
  AsciiSeq(Array[AsciiAtom])
  AsciiPrefix(String)
  Linear(regex::Regex)
  Backtrack(EcmaBtRegex)
}

///| Compiled property entry (also holds required-only sentinel slots with `node_id == -1`).
struct CompiledProp {
  name : String
  mut node_id : Int
  mut req_bit : UInt64
  mut fast_type_mask : Int
  mut is_leaf : Bool
}

///| Compiled patternProperty entry.
struct CompiledPatternProp {
  pattern : String
  compiled : CompiledRegex
  node_id : Int
}

///| Compiled dependentRequired entry.
struct CompiledDepReq {
  key : String
  required : Array[String]
}

///| Compiled dependentSchema entry.
struct CompiledDepSchema {
  key : String
  node_id : Int
}

///| Dynamic anchor table for one resource scope.
struct DynamicScopeTable {
  anchors : Array[(String, Int)]
}

///| Flat compiled schema node stored in `CompiledSchema.nodes`.
struct SchemaNode {
  schema_path : String
  ///| 0 = normal object schema, 1 = boolean true, -1 = boolean false
  mut bool_kind : Int
  ///| Bitmask of active keywords (`kw_*`)
  mut kw_mask : Int
  ///| Allowed JSON types bitmask (`type_*`)
  mut type_mask : Int
  ///| `const` value
  mut const_val : Option[json5::Json5Value]
  mut const_is_str : Bool
  mut const_str : String
  ///| `enum` values
  mut enum_vals : Array[json5::Json5Value]
  mut enum_strs : Array[String]
  ///| Numeric constraints
  mut minimum : Double
  mut maximum : Double
  mut exclusive_minimum : Double
  mut exclusive_maximum : Double
  mut multiple_of : Double
  ///| String constraints
  mut min_length : Int
  mut max_length : Int
  mut pattern_str : String
  mut pattern_re : Option[CompiledRegex]
  mut format_name : String
  ///| Array constraints
  mut min_items : Int
  mut max_items : Int
  mut unique_items : Bool
  prefix_items : Array[Int]
  ///| Node ID for `items` (or Draft-07 `additionalItems` when tuple), -1 if absent
  mut items_node : Int
  ///| `contains` node ID (-1 if absent) + bounds
  mut contains_node : Int
  mut min_contains : Int
  ///| -1 if absent
  mut max_contains : Int
  ///| Object constraints
  mut min_properties : Int
  mut max_properties : Int
  required : Array[String]
  mut req_mask : UInt64
  mut req_count : Int
  properties : Array[CompiledProp]
  mut prop_map : Option[StrIndexMap]
  pattern_properties : Array[CompiledPatternProp]
  ///| Node ID for `additionalProperties`, -1 if absent
  mut additional_properties : Int
  ///| Precomputed `bool_kind` of `additional_properties` (1 = absent/true, -1 = false, 0 = schema)
  mut addl_bool_kind : Int
  ///| True when node only has primitive leaf keywords (no Array/Object/Ref/Combinator/Conditional/Unevaluated)
  mut is_leaf : Bool
  ///| Node ID for `propertyNames`, -1 if absent
  mut property_names : Int
  dep_required : Array[CompiledDepReq]
  dep_schemas : Array[CompiledDepSchema]
  ///| Combinators & conditionals
  all_of : Array[Int]
  any_of : Array[Int]
  one_of : Array[Int]
  ///| Node ID for `not`, -1 if absent
  mut not_node : Int
  ///| Node IDs for `if` / `then` / `else`, -1 if absent
  mut if_node : Int
  mut then_node : Int
  mut else_node : Int
  ///| `$ref` target node ID, -1 if absent
  mut ref_node : Int
  ///| `$dynamicRef` / `$recursiveRef` anchor name (empty if static) and fallback target node ID (-1 if absent)
  mut dynamic_ref_anchor : String
  mut dynamic_ref_fallback : Int
  ///| Resource scope index for dynamic scope tracking (-1 if none)
  mut scope_id : Int
  ///| `unevaluatedProperties` / `unevaluatedItems` node IDs, -1 if absent
  mut unevaluated_properties : Int
  mut unevaluated_items : Int
}

///| Compiled, reusable JSON Schema validator.
pub struct CompiledSchema {
  draft : Draft
  default_validate_formats : Bool
  default_max_depth : Int
  root : Int
  has_unevaluated : Bool
  has_dynamic_ref : Bool
  dynamic_scopes : Array[DynamicScopeTable]
  nodes : Array[SchemaNode]
}

fn SchemaNode::empty(schema_path : String, bool_kind : Int) -> SchemaNode {
  SchemaNode::{
    schema_path: schema_path,
    bool_kind: bool_kind,
    kw_mask: 0,
    type_mask: 0,
    const_val: None,
    const_is_str: false,
    const_str: "",
    enum_vals: [],
    enum_strs: [],
    minimum: 0.0,
    maximum: 0.0,
    exclusive_minimum: 0.0,
    exclusive_maximum: 0.0,
    multiple_of: 0.0,
    min_length: 0,
    max_length: 0,
    pattern_str: "",
    pattern_re: None,
    format_name: "",
    min_items: 0,
    max_items: 0,
    unique_items: false,
    prefix_items: [],
    items_node: -1,
    contains_node: -1,
    min_contains: 1,
    max_contains: -1,
    min_properties: 0,
    max_properties: 0,
    required: [],
    req_mask: 0UL,
    req_count: 0,
    properties: [],
    prop_map: None,
    pattern_properties: [],
    additional_properties: -1,
    addl_bool_kind: 1,
    is_leaf: false,
    property_names: -1,
    dep_required: [],
    dep_schemas: [],
    all_of: [],
    any_of: [],
    one_of: [],
    not_node: -1,
    if_node: -1,
    then_node: -1,
    else_node: -1,
    ref_node: -1,
    dynamic_ref_anchor: "",
    dynamic_ref_fallback: -1,
    scope_id: -1,
    unevaluated_properties: -1,
    unevaluated_items: -1,
  }
}
