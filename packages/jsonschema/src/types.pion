///| Core public types, options, and error types for `packages/jsonschema`.

import "json5"

///| JSON Schema specification draft.
pub enum Draft {
  ///| JSON Schema Draft 2020-12.
  Draft202012
  ///| JSON Schema Draft-07.
  Draft7
  ///| Automatically detect from `$schema`, defaulting to Draft 2020-12.
  Auto
}

///| Compare two `Draft` values for equality.
pub fn draft_eq(a : Draft, b : Draft) -> Bool {
  match (a, b) {
    (Draft::Draft202012, Draft::Draft202012) => true
    (Draft::Draft7, Draft::Draft7) => true
    (Draft::Auto, Draft::Auto) => true
    _ => false
  }
}

///| Options controlling schema compilation.
pub struct CompileOptions {
  pub draft : Draft
  pub max_depth : Int
  pub validate_formats : Bool
}

///| Default compile options (`Auto` draft, `max_depth: 128`, `validate_formats: false`).
pub fn CompileOptions::default() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Auto,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Draft 2020-12 compile options.
pub fn CompileOptions::draft202012() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Draft202012,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Draft-07 compile options.
pub fn CompileOptions::draft7() -> CompileOptions {
  CompileOptions::{
    draft: Draft::Draft7,
    max_depth: 128,
    validate_formats: false,
  }
}

///| Options controlling instance validation.
pub struct ValidateOptions {
  pub validate_formats : Bool
  pub max_depth : Int
}

///| Default validation options (`validate_formats: false`, `max_depth: 128`).
pub fn ValidateOptions::default() -> ValidateOptions {
  ValidateOptions::{ validate_formats: false, max_depth: 128 }
}

///| Validation options with explicit format validation toggle.
pub fn ValidateOptions::with_formats(validate_formats : Bool) -> ValidateOptions {
  ValidateOptions::{ validate_formats: validate_formats, max_depth: 128 }
}

///| Category of a schema compilation or input parsing error.
pub enum SchemaErrorKind {
  ParseError
  InvalidSchema
  UnresolvedRef
  InvalidRegex
  InvalidPointer
  LimitExceeded
}

///| Compare two `SchemaErrorKind` values for equality.
pub fn schema_error_kind_eq(a : SchemaErrorKind, b : SchemaErrorKind) -> Bool {
  match (a, b) {
    (SchemaErrorKind::ParseError, SchemaErrorKind::ParseError) => true
    (SchemaErrorKind::InvalidSchema, SchemaErrorKind::InvalidSchema) => true
    (SchemaErrorKind::UnresolvedRef, SchemaErrorKind::UnresolvedRef) => true
    (SchemaErrorKind::InvalidRegex, SchemaErrorKind::InvalidRegex) => true
    (SchemaErrorKind::InvalidPointer, SchemaErrorKind::InvalidPointer) => true
    (SchemaErrorKind::LimitExceeded, SchemaErrorKind::LimitExceeded) => true
    _ => false
  }
}

///| Error returned when parsing or compiling a JSON Schema fails.
pub struct SchemaError {
  pub kind : SchemaErrorKind
  pub schema_path : String
  pub message : String
}

///| Construct a `SchemaError`.
pub fn SchemaError::new(
  kind : SchemaErrorKind,
  schema_path : String,
  message : String,
) -> SchemaError {
  SchemaError::{ kind: kind, schema_path: schema_path, message: message }
}

///| Structured diagnostic for a single JSON Schema validation failure.
pub struct ValidationError {
  pub instance_path : String
  pub schema_path : String
  pub keyword : String
  pub message : String
}

///| Construct a `ValidationError`.
pub fn ValidationError::new(
  instance_path : String,
  schema_path : String,
  keyword : String,
  message : String,
) -> ValidationError {
  ValidationError::{
    instance_path: instance_path,
    schema_path: schema_path,
    keyword: keyword,
    message: message,
  }
}

///| Compiled, reusable JSON Schema validator.
pub struct CompiledSchema {
  draft : Draft
  default_validate_formats : Bool
  default_max_depth : Int
}
