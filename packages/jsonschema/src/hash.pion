///| Structural JSON value hashing, O(N) `uniqueItems` deduplication,
///| and fast open-addressing `StrIndexMap`.

import "json5"

///| FNV-1a 64-bit hash over UTF-8 bytes of a `String`.
fn hash_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///| Mix a 64-bit hash value (SplitMix64 finalizer).
fn mix64(x : UInt64) -> UInt64 {
  let mut z = x
  z = (z ^ (z >> 30UL)) * 13787848793156543929UL
  z = (z ^ (z >> 27UL)) * 10723151780598845931UL
  z ^ (z >> 31UL)
}

///| Structural, order-independent (for objects), canonical-number JSON value hash.
///| Bounded recursion depth (switches to type tag beyond depth 64 so deeply nested
///| structures never stack overflow; collisions are resolved by iterative `value_eq`).
fn hash_json_value(v : json5::Json5Value, depth : Int) -> UInt64 {
  if depth > 64 {
    return 0xDEADBEEFUL
  }
  match v {
    json5::Json5Value::Null => 0x1111111111111111UL
    json5::Json5Value::Bool(b) =>
    if b {
      0x2222222222222222UL
    } else {
      0x3333333333333333UL
    }
    json5::Json5Value::Number(x) => {
      // Canonicalize -0.0 to +0.0 so equal JSON numbers always hash identically
      let nx = if x == 0.0 { 0.0 } else { x }
      mix64(nx.reinterpret_as_uint64() ^ 0x4444444444444444UL)
    }
    json5::Json5Value::Str(s) => mix64(hash_str(s) ^ 0x5555555555555555UL)
    json5::Json5Value::Array(items) => {
      let mut h : UInt64 = 0x6666666666666666UL ^ items.length().to_int64().reinterpret_as_uint64()
      let n = items.length()
      let mut i = 0
      while i < n {
        let eh = hash_json_value(items[i], depth + 1)
        h = mix64(h ^ (eh + 0x9E3779B97F4A7C15UL))
        i = i + 1
      }
      h
    }
    json5::Json5Value::Object(entries) => {
      // Order-independent hash via commutative wrapping addition of per-entry hashes.
      let n = entries.length()
      let mut sum : UInt64 = 0UL
      let mut i = 0
      while i < n {
        let (k, jval) = entries[i]
        let kh = hash_str(k)
        let vh = hash_json_value(jval, depth + 1)
        sum = sum + mix64(kh ^ (vh * 0x9E3779B97F4A7C15UL))
        i = i + 1
      }
      mix64(sum ^ 0x7777777777777777UL)
    }
  }
}

///| O(N) structural uniqueness check for `uniqueItems: true`.
fn check_unique_items(items : Array[json5::Json5Value]) -> Bool {
  let n = items.length()
  if n <= 1 {
    return true
  }
  if n == 2 {
    return !json5::value_eq(items[0], items[1])
  }
  if n <= 8 {
    let mut i = 0
    while i < n {
      let mut j = i + 1
      while j < n {
        if json5::value_eq(items[i], items[j]) {
          return false
        }
        j = j + 1
      }
      i = i + 1
    }
    return true
  }
  // Open-addressing hash table: capacity = next power of 2 >= 2 * n
  let mut cap = 16
  let target = n * 2
  while cap < target {
    cap = cap * 2
  }
  let mask = cap - 1
  let buckets = FixedArray::make(cap, -1)
  let hashes = FixedArray::make(n, 0UL)
  let mut i = 0
  while i < n {
    let h = hash_json_value(items[i], 0)
    hashes[i] = h
    let mut slot = h.to_int() & mask
    while true {
      let existing = buckets[slot]
      if existing < 0 {
        buckets[slot] = i
        break
      }
      if hashes[existing] == h && json5::value_eq(items[existing], items[i]) {
        return false
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  true
}

///| Build an open-addressing `StrIndexMap` from parallel `(key, jval)` arrays.
fn StrIndexMap::from_pairs(pairs : Array[(String, Int)]) -> StrIndexMap {
  let n = pairs.length()
  let mut cap = 8
  let target = n * 2
  while cap < target {
    cap = cap * 2
  }
  let mask = cap - 1
  let buckets = FixedArray::make(cap, -1)
  let keys : Array[String] = Array::new()
  let vals : Array[Int] = Array::new()
  let mut i = 0
  while i < n {
    let (k, v) = pairs[i]
    let h = hash_str(k)
    let mut slot = h.to_int() & mask
    let mut found = false
    while true {
      let idx = buckets[slot]
      if idx < 0 {
        let new_idx = keys.length()
        keys.push(k)
        vals.push(v)
        buckets[slot] = new_idx
        found = true
        break
      }
      if keys[idx] == k {
        vals[idx] = v
        found = true
        break
      }
      slot = (slot + 1) & mask
    }
    let _ = found
    i = i + 1
  }
  StrIndexMap::{ keys: keys, vals: vals, buckets: buckets, mask: mask }
}

///| Build a `StrIndexMap` from `Array[CompiledProp]` mapping prop name -> index in `properties`.
fn StrIndexMap::from_props(props : Array[CompiledProp]) -> StrIndexMap {
  let pairs : Array[(String, Int)] = Array::new()
  let mut i = 0
  let n = props.length()
  while i < n {
    pairs.push((props[i].name, i))
    i = i + 1
  }
  StrIndexMap::from_pairs(pairs)
}

///| O(1) lookup in `StrIndexMap`. Returns -1 if not found.
fn StrIndexMap::get(self : StrIndexMap, key : String) -> Int {
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return -1
    }
    if self.keys[idx] == key {
      return self.vals[idx]
    }
    slot = (slot + 1) & self.mask
  }
  -1
}
