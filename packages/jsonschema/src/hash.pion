///| Structural JSON value hashing (100% iterative, no depth-64 saturation),
///| O(N) `uniqueItems` deduplication, `StrIndexMap`, `StrHashMap`, `StrSet`, and `IntSet`.

import "json5"

///| FNV-1a 64-bit hash over UTF-8 bytes of a `String`.
fn hash_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///| Mix a 64-bit hash value (SplitMix64 finalizer).
fn mix64(x : UInt64) -> UInt64 {
  let mut z = x
  z = (z ^ (z >> 30UL)) * 13787848793156543929UL
  z = (z ^ (z >> 27UL)) * 10723151780598845931UL
  z ^ (z >> 31UL)
}

///| Frame for iterative structural JSON value hashing.
///| kind: 0 = Array, 1 = Object
struct HashFrame {
  kind : Int
  arr : Array[json5::Json5Value]
  obj : Array[(String, json5::Json5Value)]
  mut idx : Int
  mut acc : UInt64
  mut cur_key_hash : UInt64
}

///| Zero-allocation fast structural equality for primitives; delegates Array/Object to `json5::value_eq`.
fn fast_value_eq(a : json5::Json5Value, b : json5::Json5Value) -> Bool {
  match (a, b) {
    (json5::Json5Value::Null, json5::Json5Value::Null) => true
    (json5::Json5Value::Bool(x), json5::Json5Value::Bool(y)) => x == y
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) => x == y
    (json5::Json5Value::Str(x), json5::Json5Value::Str(y)) => x == y
    (json5::Json5Value::Array(_), json5::Json5Value::Array(_)) => json5::value_eq(a, b)
    (json5::Json5Value::Object(_), json5::Json5Value::Object(_)) => json5::value_eq(a, b)
    _ => false
  }
}

///| Bounded zero-allocation recursive structural hash for shallow JSON values (depth <= 8).
fn hash_json_value_shallow(v : json5::Json5Value, depth : Int) -> UInt64 {
  match v {
    json5::Json5Value::Null => 0x1111111111111111UL
    json5::Json5Value::Bool(b) => if b { 0x2222222222222222UL } else { 0x3333333333333333UL }
    json5::Json5Value::Number(x) => {
      let nx = if x == 0.0 { 0.0 } else { x }
      mix64(nx.reinterpret_as_uint64() ^ 0x4444444444444444UL)
    }
    json5::Json5Value::Str(s) => mix64(hash_str(s) ^ 0x5555555555555555UL)
    json5::Json5Value::Array(items) => {
      let n = items.length()
      if n == 0 {
        return 0x6666666666666666UL
      }
      if depth >= 8 {
        return hash_json_value_iter(v)
      }
      let mut acc = 0x6666666666666666UL ^ n.to_int64().reinterpret_as_uint64()
      let mut i = 0
      while i < n {
        let ch = hash_json_value_shallow(items[i], depth + 1)
        acc = mix64(acc ^ (ch + 0x9E3779B97F4A7C15UL))
        i = i + 1
      }
      acc
    }
    json5::Json5Value::Object(entries) => {
      let n = entries.length()
      if n == 0 {
        return mix64(0x7777777777777777UL)
      }
      if depth >= 8 {
        return hash_json_value_iter(v)
      }
      let mut acc : UInt64 = 0UL
      let mut i = 0
      while i < n {
        let (k, ev) = entries[i]
        let kh = hash_str(k)
        let vh = hash_json_value_shallow(ev, depth + 1)
        acc = acc + mix64(kh ^ (vh * 0x9E3779B97F4A7C15UL))
        i = i + 1
      }
      mix64(acc ^ 0x7777777777777777UL)
    }
  }
}

///| 100% iterative structural, order-independent (for objects), canonical-number JSON value hash.
///| Never truncates on nesting depth (fixes P1-9 deep-array O(N^2) hash collision DoS) and
///| uses O(1) call stack frames (0 SIGSEGV / 0 Wasm32 trap).
fn hash_json_value(root : json5::Json5Value) -> UInt64 {
  hash_json_value_shallow(root, 0)
}

fn hash_json_value_iter(root : json5::Json5Value) -> UInt64 {
  // Fast path for primitives (no stack allocation at all)
  match root {
    json5::Json5Value::Null => return 0x1111111111111111UL
    json5::Json5Value::Bool(b) =>
    return if b { 0x2222222222222222UL } else { 0x3333333333333333UL }
    json5::Json5Value::Number(x) => {
      let nx = if x == 0.0 { 0.0 } else { x }
      return mix64(nx.reinterpret_as_uint64() ^ 0x4444444444444444UL)
    }
    json5::Json5Value::Str(s) => return mix64(hash_str(s) ^ 0x5555555555555555UL)
    _ => ()
  }
  let frames : Array[HashFrame] = []
  let mut cur = root
  let mut has_cur = true
  let mut child_hash : UInt64 = 0UL
  let mut work = 0
  let max_work = 65536
  while true {
    if has_cur {
      work = work + 1
      if work > max_work {
        child_hash = 0x9E3779B97F4A7C15UL
        has_cur = false
      } else {
        match cur {
          json5::Json5Value::Null => {
            child_hash = 0x1111111111111111UL
            has_cur = false
          }
          json5::Json5Value::Bool(b) => {
            child_hash = if b { 0x2222222222222222UL } else { 0x3333333333333333UL }
            has_cur = false
          }
          json5::Json5Value::Number(x) => {
            let nx = if x == 0.0 { 0.0 } else { x }
            child_hash = mix64(nx.reinterpret_as_uint64() ^ 0x4444444444444444UL)
            has_cur = false
          }
          json5::Json5Value::Str(s) => {
            child_hash = mix64(hash_str(s) ^ 0x5555555555555555UL)
            has_cur = false
          }
          json5::Json5Value::Array(items) => {
            let n = items.length()
            if n == 0 {
              child_hash = 0x6666666666666666UL
              has_cur = false
            } else {
              frames.push(HashFrame::{
                kind: 0,
                arr: items,
                obj: [],
                idx: 0,
                acc: 0x6666666666666666UL ^ n.to_int64().reinterpret_as_uint64(),
                cur_key_hash: 0UL,
              })
              cur = items[0]
              has_cur = true
            }
          }
          json5::Json5Value::Object(entries) => {
            let n = entries.length()
            if n == 0 {
              child_hash = mix64(0x7777777777777777UL)
              has_cur = false
            } else {
              let (k0, v0) = entries[0]
              frames.push(HashFrame::{
                kind: 1,
                arr: [],
                obj: entries,
                idx: 0,
                acc: 0UL,
                cur_key_hash: hash_str(k0),
              })
              cur = v0
              has_cur = true
            }
          }
        }
      }
    } else {
      let flen = frames.length()
      if flen == 0 {
        return child_hash
      }
      let top = frames[flen - 1]
      if top.kind == 0 {
        top.acc = mix64(top.acc ^ (child_hash + 0x9E3779B97F4A7C15UL))
        top.idx = top.idx + 1
        if top.idx < top.arr.length() && work <= max_work {
          cur = top.arr[top.idx]
          has_cur = true
        } else {
          child_hash = top.acc
          let _ = frames.pop()
          has_cur = false
        }
      } else {
        top.acc = top.acc + mix64(top.cur_key_hash ^ (child_hash * 0x9E3779B97F4A7C15UL))
        top.idx = top.idx + 1
        if top.idx < top.obj.length() && work <= max_work {
          let (kn, vn) = top.obj[top.idx]
          top.cur_key_hash = hash_str(kn)
          cur = vn
          has_cur = true
        } else {
          child_hash = mix64(top.acc ^ 0x7777777777777777UL)
          let _ = frames.pop()
          has_cur = false
        }
      }
    }
  }
  0UL
}

///| O(N) structural uniqueness check for `uniqueItems: true`.
fn check_unique_items(items : Array[json5::Json5Value]) -> Bool {
  let n = items.length()
  if n <= 1 {
    return true
  }
  if n == 2 {
    return !fast_value_eq(items[0], items[1])
  }
  if n <= 8 {
    let mut i = 0
    while i < n {
      let mut j = i + 1
      while j < n {
        if fast_value_eq(items[i], items[j]) {
          return false
        }
        j = j + 1
      }
      i = i + 1
    }
    return true
  }
  // Open-addressing hash table: capacity = next power of 2 >= 2 * n
  let mut cap = 16
  let target = n * 2
  while cap < target {
    cap = cap * 2
  }
  let mask = cap - 1
  let buckets = FixedArray::make(cap, -1)
  let hashes = FixedArray::make(n, 0UL)
  let mut i = 0
  while i < n {
    let h = hash_json_value(items[i])
    hashes[i] = h
    let mut slot = h.to_int() & mask
    while true {
      let existing = buckets[slot]
      if existing < 0 {
        buckets[slot] = i
        break
      }
      if hashes[existing] == h && fast_value_eq(items[existing], items[i]) {
        return false
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  true
}

///| Build an open-addressing `StrIndexMap` from parallel `(key, jval)` arrays.
fn StrIndexMap::from_pairs(pairs : Array[(String, Int)]) -> StrIndexMap {
  let n = pairs.length()
  let mut cap = 8
  let target = n * 2
  while cap < target {
    cap = cap * 2
  }
  let mask = cap - 1
  let buckets = FixedArray::make(cap, -1)
  let keys : Array[String] = Array::new()
  let vals : Array[Int] = Array::new()
  let mut i = 0
  while i < n {
    let (k, v) = pairs[i]
    let h = hash_str(k)
    let mut slot = h.to_int() & mask
    while true {
      let idx = buckets[slot]
      if idx < 0 {
        let new_idx = keys.length()
        keys.push(k)
        vals.push(v)
        buckets[slot] = new_idx
        break
      }
      if keys[idx] == k {
        vals[idx] = v
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrIndexMap::{ keys: keys, vals: vals, buckets: buckets, mask: mask }
}

///| Build a `StrIndexMap` from `Array[CompiledProp]` mapping prop name -> index in `properties`.
fn StrIndexMap::from_props(props : Array[CompiledProp]) -> StrIndexMap {
  let pairs : Array[(String, Int)] = Array::new()
  let mut i = 0
  let n = props.length()
  while i < n {
    pairs.push((props[i].name, i))
    i = i + 1
  }
  StrIndexMap::from_pairs(pairs)
}

///| O(1) lookup in `StrIndexMap`. Returns -1 if not found.
fn StrIndexMap::get(self : StrIndexMap, key : String) -> Int {
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return -1
    }
    if self.keys[idx] == key {
      return self.vals[idx]
    }
    slot = (slot + 1) & self.mask
  }
  -1
}

///| Create an empty growable `StrHashMap` (lazy bucket allocation on first insert).
fn StrHashMap::new() -> StrHashMap {
  StrHashMap::{
    keys: [],
    vals: [],
    buckets: FixedArray::make(0, -1),
    mask: -1,
  }
}

fn StrHashMap::grow(self : StrHashMap) -> Unit {
  let new_cap = if self.mask < 0 { 16 } else { (self.mask + 1) * 2 }
  let new_mask = new_cap - 1
  let new_buckets = FixedArray::make(new_cap, -1)
  let mut i = 0
  let n = self.keys.length()
  while i < n {
    let h = hash_str(self.keys[i])
    let mut slot = h.to_int() & new_mask
    while new_buckets[slot] >= 0 {
      slot = (slot + 1) & new_mask
    }
    new_buckets[slot] = i
    i = i + 1
  }
  self.buckets = new_buckets
  self.mask = new_mask
}

///| O(1) lookup in `StrHashMap`. Returns -1 if absent.
fn StrHashMap::get(self : StrHashMap, key : String) -> Int {
  if self.keys.length() == 0 {
    return -1
  }
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return -1
    }
    if self.keys[idx] == key {
      return self.vals[idx]
    }
    slot = (slot + 1) & self.mask
  }
  -1
}

///| Insert or update `key -> v` in `StrHashMap`.
fn StrHashMap::set(self : StrHashMap, key : String, v : Int) -> Unit {
  if (self.keys.length() + 1) * 2 > self.mask + 1 {
    self.grow()
  }
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      let new_idx = self.keys.length()
      self.keys.push(key)
      self.vals.push(v)
      self.buckets[slot] = new_idx
      return
    }
    if self.keys[idx] == key {
      self.vals[idx] = v
      return
    }
    slot = (slot + 1) & self.mask
  }
}

///| Insert `key -> v` only if `key` is not already present (first-wins).
fn StrHashMap::set_if_absent(self : StrHashMap, key : String, v : Int) -> Unit {
  if (self.keys.length() + 1) * 2 > self.mask + 1 {
    self.grow()
  }
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      let new_idx = self.keys.length()
      self.keys.push(key)
      self.vals.push(v)
      self.buckets[slot] = new_idx
      return
    }
    if self.keys[idx] == key {
      return
    }
    slot = (slot + 1) & self.mask
  }
}

///| Create an empty hybrid `StrSet` (zero hash-table allocation while <= 8 items).
fn StrSet::new() -> StrSet {
  StrSet::{
    items: [],
    buckets: FixedArray::make(0, -1),
    mask: 0,
    hashed: false,
  }
}

fn StrSet::rehash(self : StrSet, new_cap : Int) -> Unit {
  let new_mask = new_cap - 1
  let new_buckets = FixedArray::make(new_cap, -1)
  let n = self.items.length()
  let mut i = 0
  while i < n {
    let h = hash_str(self.items[i])
    let mut slot = h.to_int() & new_mask
    while new_buckets[slot] >= 0 {
      slot = (slot + 1) & new_mask
    }
    new_buckets[slot] = i
    i = i + 1
  }
  self.buckets = new_buckets
  self.mask = new_mask
  self.hashed = true
}

fn StrSet::contains(self : StrSet, key : String) -> Bool {
  if !self.hashed {
    let n = self.items.length()
    let mut i = 0
    while i < n {
      if self.items[i] == key {
        return true
      }
      i = i + 1
    }
    return false
  }
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return false
    }
    if self.items[idx] == key {
      return true
    }
    slot = (slot + 1) & self.mask
  }
  false
}

fn StrSet::insert(self : StrSet, key : String) -> Unit {
  if !self.hashed {
    let n = self.items.length()
    let mut i = 0
    while i < n {
      if self.items[i] == key {
        return
      }
      i = i + 1
    }
    self.items.push(key)
    if self.items.length() > 8 {
      self.rehash(32)
    }
    return
  }
  if (self.items.length() + 1) * 2 > self.mask + 1 {
    self.rehash((self.mask + 1) * 2)
  }
  let h = hash_str(key)
  let mut slot = h.to_int() & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      let new_idx = self.items.length()
      self.items.push(key)
      self.buckets[slot] = new_idx
      return
    }
    if self.items[idx] == key {
      return
    }
    slot = (slot + 1) & self.mask
  }
}

///| Build a `StrSet` from object entries' keys in O(N) time.
fn StrSet::from_object_entries(entries : Array[(String, json5::Json5Value)]) -> StrSet {
  let n = entries.length()
  let mut cap = 16
  let target = n * 2
  while cap < target {
    cap = cap * 2
  }
  let mask = cap - 1
  let buckets = FixedArray::make(cap, -1)
  let items : Array[String] = Array::new()
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    let h = hash_str(k)
    let mut slot = h.to_int() & mask
    while true {
      let idx = buckets[slot]
      if idx < 0 {
        let new_idx = items.length()
        items.push(k)
        buckets[slot] = new_idx
        break
      }
      if items[idx] == k {
        break
      }
      slot = (slot + 1) & mask
    }
    i = i + 1
  }
  StrSet::{ items: items, buckets: buckets, mask: mask, hashed: true }
}

///| Create an empty hybrid `IntSet` (zero hash-table allocation while <= 8 items).
fn IntSet::new() -> IntSet {
  IntSet::{
    items: [],
    buckets: FixedArray::make(0, -1),
    mask: 0,
    hashed: false,
  }
}

fn hash_int_val(v : Int) -> Int {
  let x = (v ^ (v >> 16)) * 0x45d9f3b
  x ^ (x >> 16)
}

fn IntSet::rehash(self : IntSet, new_cap : Int) -> Unit {
  let new_mask = new_cap - 1
  let new_buckets = FixedArray::make(new_cap, -1)
  let n = self.items.length()
  let mut i = 0
  while i < n {
    let mut slot = hash_int_val(self.items[i]) & new_mask
    while new_buckets[slot] >= 0 {
      slot = (slot + 1) & new_mask
    }
    new_buckets[slot] = i
    i = i + 1
  }
  self.buckets = new_buckets
  self.mask = new_mask
  self.hashed = true
}

fn IntSet::contains(self : IntSet, v : Int) -> Bool {
  if !self.hashed {
    let n = self.items.length()
    let mut i = 0
    while i < n {
      if self.items[i] == v {
        return true
      }
      i = i + 1
    }
    return false
  }
  let mut slot = hash_int_val(v) & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return false
    }
    if self.items[idx] == v {
      return true
    }
    slot = (slot + 1) & self.mask
  }
  false
}

fn IntSet::insert(self : IntSet, v : Int) -> Unit {
  if !self.hashed {
    let n = self.items.length()
    let mut i = 0
    while i < n {
      if self.items[i] == v {
        return
      }
      i = i + 1
    }
    self.items.push(v)
    if self.items.length() > 8 {
      self.rehash(32)
    }
    return
  }
  if (self.items.length() + 1) * 2 > self.mask + 1 {
    self.rehash((self.mask + 1) * 2)
  }
  let mut slot = hash_int_val(v) & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      let new_idx = self.items.length()
      self.items.push(v)
      self.buckets[slot] = new_idx
      return
    }
    if self.items[idx] == v {
      return
    }
    slot = (slot + 1) & self.mask
  }
}
