///| Pure Pion JSON Schema (Draft 2020-12 & Draft-07) compiler and validator.
///| Stub implementation for Red-phase test-first verification.

import "json5"
import "regex"

///| Compile a JSON Schema value with default options.
pub fn compile(schema : json5::Json5Value) -> Result[CompiledSchema, SchemaError] {
  compile_with(schema, CompileOptions::default())
}

///| Compile a JSON Schema value with explicit options.
pub fn compile_with(
  schema : json5::Json5Value,
  opts : CompileOptions,
) -> Result[CompiledSchema, SchemaError] {
  let _ = schema
  let _ = opts
  Err(SchemaError::new(SchemaErrorKind::InvalidSchema, "#", "not implemented"))
}

///| Parse and compile a JSON Schema from a JSON string with default options.
pub fn compile_str(schema_json : String) -> Result[CompiledSchema, SchemaError] {
  compile_str_with(schema_json, CompileOptions::default())
}

///| Parse and compile a JSON Schema from a JSON string with explicit options.
pub fn compile_str_with(
  schema_json : String,
  opts : CompileOptions,
) -> Result[CompiledSchema, SchemaError] {
  let _ = schema_json
  let _ = opts
  Err(SchemaError::new(SchemaErrorKind::InvalidSchema, "#", "not implemented"))
}

///| Fast boolean short-circuit validation using the schema's default options.
pub fn CompiledSchema::is_valid(
  self : CompiledSchema,
  instance : json5::Json5Value,
) -> Bool {
  let _ = self
  let _ = instance
  false
}

///| Fast boolean short-circuit validation with explicit options.
pub fn CompiledSchema::is_valid_with(
  self : CompiledSchema,
  instance : json5::Json5Value,
  opts : ValidateOptions,
) -> Bool {
  let _ = self
  let _ = instance
  let _ = opts
  false
}

///| Parse a JSON instance string and check validity.
pub fn CompiledSchema::is_valid_str(
  self : CompiledSchema,
  instance_json : String,
) -> Result[Bool, SchemaError] {
  let _ = self
  let _ = instance_json
  Err(SchemaError::new(SchemaErrorKind::InvalidSchema, "#", "not implemented"))
}

///| Collect all validation errors for `instance` using the schema's default options.
pub fn CompiledSchema::validate(
  self : CompiledSchema,
  instance : json5::Json5Value,
) -> Array[ValidationError] {
  let _ = self
  let _ = instance
  []
}

///| Collect all validation errors for `instance` with explicit options.
pub fn CompiledSchema::validate_with(
  self : CompiledSchema,
  instance : json5::Json5Value,
  opts : ValidateOptions,
) -> Array[ValidationError] {
  let _ = self
  let _ = instance
  let _ = opts
  []
}

///| Parse a JSON instance string and collect all validation errors.
pub fn CompiledSchema::validate_str(
  self : CompiledSchema,
  instance_json : String,
) -> Result[Array[ValidationError], SchemaError] {
  let _ = self
  let _ = instance_json
  Err(SchemaError::new(SchemaErrorKind::InvalidSchema, "#", "not implemented"))
}

///| One-shot validity check for a schema and instance value.
pub fn is_valid(
  schema : json5::Json5Value,
  instance : json5::Json5Value,
) -> Result[Bool, SchemaError] {
  match compile(schema) {
    Ok(compiled) => Ok(compiled.is_valid(instance))
    Err(e) => Err(e)
  }
}

///| One-shot validation returning all errors for a schema and instance value.
pub fn validate(
  schema : json5::Json5Value,
  instance : json5::Json5Value,
) -> Result[Array[ValidationError], SchemaError] {
  match compile(schema) {
    Ok(compiled) => Ok(compiled.validate(instance))
    Err(e) => Err(e)
  }
}

///| Validate a single string against a named JSON Schema format.
pub fn check_format(format : String, value : String) -> Bool {
  let _ = format
  let _ = value
  let _ = regex::compile("")
  false
}
