///| Head-to-head benchmark Workload 1: 20,000 sequential + random text edits + v1 encode.

import "crdt"

struct Rng {
  mut s : UInt64
}

fn Rng::next(self : Rng) -> Int {
  // 32-bit LCG identical in JS (Math.imul) and Pion (UInt64 masked to 32 bits)
  self.s = (self.s * 1664525UL + 1013904223UL) & 0xffffffffUL
  (self.s >> 1).to_int()
}

fn run_once(ops : Int) -> (String, Int, String) {
  let rng = Rng::{ s: 123456789UL }
  let doc = crdt::Doc::new(1UL)
  let t = doc.get_text("text")
  let words : Array[String] = Array::new()
  words.push("a")
  words.push("the ")
  words.push("pion ")
  words.push("crdt ")
  words.push("x")
  words.push("yjs ")
  words.push("fast ")
  words.push("sync ")

  let mut cursor = 0
  let mut i = 0
  while i < ops {
    let r = rng.next()
    let cur_len = t.len(doc)
    // 60% sequential typing, 25% random insert, 15% random delete
    let mode = r % 20
    if mode < 12 || cur_len == 0 {
      if cursor > cur_len {
        cursor = cur_len
      }
      let w = words[(r >> 4) % 8]
      t.insert(doc, cursor, w)
      cursor = cursor + w.length()
    } else if mode < 17 {
      let pos = (r >> 5) % (cur_len + 1)
      let w = words[(r >> 12) % 8]
      t.insert(doc, pos, w)
      cursor = pos + w.length()
    } else {
      let pos = (r >> 5) % cur_len
      let max_d = cur_len - pos
      let dlen = 1 + ((r >> 12) % 4)
      let actual_d = if dlen > max_d { max_d } else { dlen }
      t.delete(doc, pos, actual_d)
      cursor = pos
    }
    i = i + 1
  }
  let upd = doc.encode_state_as_update()
  let final_txt = t.to_string(doc)
  // Verify roundtrip decode on a fresh doc
  let dst = crdt::Doc::new(2UL)
  let _ = dst.apply_update(upd)
  let decoded_txt = dst.get_text("text").to_string(dst)
  (final_txt, upd.length(), decoded_txt)
}

pub fn main(world : World) -> Int {
  let ops = 20000
  let iters = 10
  let mut last_txt = ""
  let mut last_dec = ""
  let mut last_upd_len = 0
  let mut k = 0
  while k < iters {
    let (ft, ul, dt) = run_once(ops)
    last_txt = ft
    last_upd_len = ul
    last_dec = dt
    k = k + 1
  }
  let match_ok = if last_txt == last_dec { "ok" } else { "mismatch" }
  io_println(
    world,
    "iters=" +
    iters.to_string() +
    " ops=" +
    ops.to_string() +
    " text_len=" +
    last_txt.length().to_string() +
    " roundtrip=" +
    match_ok +
    " upd_ge=" +
    (if last_upd_len > 0 { "1" } else { "0" }),
  )
  io_println(world, last_txt)
  0
}
