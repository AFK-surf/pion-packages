///| Head-to-head benchmark Workload 2: Two-client 5,000 concurrent mixed ops + v1 sync merge.

import "crdt"

struct Rng {
  mut s : UInt64
}

fn Rng::next(self : Rng) -> Int {
  self.s = (self.s * 1664525UL + 1013904223UL) & 0xffffffffUL
  (self.s >> 1).to_int()
}

fn apply_client_batch(
  doc : crdt::Doc,
  rng : Rng,
  tag : String,
  cid : Int,
  count : Int,
) -> Unit {
  let t = doc.get_text("doc")
  let a = doc.get_array("arr")
  let m = doc.get_map("meta")
  let mut i = 0
  while i < count {
    let r = rng.next()
    let kind = r % 10
    if kind < 6 {
      // YText op
      let cur_len = t.len(doc)
      if (r >> 4) % 4 != 0 || cur_len == 0 {
        let pos = (r >> 7) % (cur_len + 1)
        t.insert(doc, pos, tag)
      } else {
        let pos = (r >> 7) % cur_len
        let dlen = 1 + ((r >> 13) % 3)
        let max_d = cur_len - pos
        t.delete(doc, pos, if dlen > max_d { max_d } else { dlen })
      }
    } else if kind < 8 {
      // YArray op
      let cur_len = a.len(doc)
      if (r >> 4) % 4 != 0 || cur_len == 0 {
        let pos = (r >> 7) % (cur_len + 1)
        a.insert(doc, pos, crdt::Any::Int((cid * 10000 + i).to_int64()))
      } else {
        let pos = (r >> 7) % cur_len
        a.delete(doc, pos, 1)
      }
    } else {
      // YMap op
      let k = "k" + ((r >> 4) % 32).to_string()
      if (r >> 10) % 5 != 0 {
        m.set(doc, k, crdt::Any::Int((cid * 10000 + i).to_int64()))
      } else {
        m.delete(doc, k)
      }
    }
    i = i + 1
  }
}

fn run_once(ops_per_client : Int) -> String {
  let d1 = crdt::Doc::new(100UL)
  let d2 = crdt::Doc::new(200UL)
  let rng1 = Rng::{ s: 111111UL }
  let rng2 = Rng::{ s: 222222UL }

  let rounds = 5
  let batch = ops_per_client / rounds
  let mut r = 0
  while r < rounds {
    apply_client_batch(d1, rng1, "A", 1, batch)
    apply_client_batch(d2, rng2, "B", 2, batch)
    let sv1 = d1.encode_state_vector()
    let sv2 = d2.encode_state_vector()
    let u1 = match d1.encode_state_as_update_from(sv2) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    let u2 = match d2.encode_state_as_update_from(sv1) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    let _ = d1.apply_update(u2)
    let _ = d2.apply_update(u1)
    r = r + 1
  }

  let s1 = d1.get_text("doc").to_string(d1)
  let s2 = d2.get_text("doc").to_string(d2)
  let a1 = d1.get_array("arr").to_array(d1)
  let m1 = d1.get_map("meta")
  let ks = m1.keys(d1)

  let sb = StringBuilder::new()
  sb.write_string("eq=")
  sb.write_string(if s1 == s2 { "1" } else { "0" })
  sb.write_string(" text_len=")
  sb.write_string(s1.length().to_string())
  sb.write_string(" arr_len=")
  sb.write_string(a1.length().to_string())
  sb.write_string(" map_len=")
  sb.write_string(ks.length().to_string())
  sb.write_string("\n")
  sb.write_string(s1)
  sb.write_string("\nARR:")
  let mut i = 0
  while i < a1.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(crdt::any_to_canonical_string(a1[i]))
    i = i + 1
  }
  sb.write_string("\nMAP:")
  i = 0
  while i < ks.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(ks[i])
    sb.write_string("=")
    match m1.get(d1, ks[i]) {
      Some(v) => sb.write_string(crdt::any_to_canonical_string(v))
      None => ()
    }
    i = i + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let ops = 5000
  let iters = 10
  let mut out = ""
  let mut k = 0
  while k < iters {
    out = run_once(ops)
    k = k + 1
  }
  io_println(world, out)
  0
}
