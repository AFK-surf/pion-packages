///| Red-team differential harness: a tiny script interpreter over `crdt::Doc`.
///| The identical interpreter lives in `audit/node/interp.mjs` (official `yjs`) and
///| `audit/rust/src/bin/yrs_interp.rs` (Rust `yrs`). Same script => same stdout is required.
///|
///| Script lines (space separated, strings are lowercase UTF-8 hex):
///|   doc I CLIENT | ti I PATH IDX HEX | td I PATH IDX LEN | tf I PATH IDX LEN KEY VALJSONHEX
///|   ai I PATH IDX VAL | ait I PATH IDX KIND | ad I PATH IDX LEN
///|   ms I PATH KEY VAL | mst I PATH KEY KIND | md I PATH KEY
///|   apply I HEX | sync A B | full A B | dump I | upd I | sv I | pending I
///|   merge HEX HEX.. | diff HEX SVHEX
///| VAL = i:<int> | s:<hex> | n | t | f ; KIND = text | array | map ; PATH = t|a|m[/seg]*

import "crdt"

fn split_ws(line : String) -> Array[String] {
  let out : Array[String] = Array::new()
  let n = line.length()
  let mut i = 0
  while i < n {
    while i < n && (line.code_unit_at(i) == 32 || line.code_unit_at(i) == 13) {
      i = i + 1
    }
    let s = i
    while i < n && line.code_unit_at(i) != 32 && line.code_unit_at(i) != 13 {
      i = i + 1
    }
    if i > s {
      out.push(line.slice(s, i))
    }
  }
  out
}

fn parse_int(s : String) -> Int {
  let mut i = 0
  let mut neg = false
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut v = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  if neg {
    0 - v
  } else {
    v
  }
}

fn parse_u64(s : String) -> UInt64 {
  let mut v = 0UL
  let mut i = 0
  while i < s.length() {
    v = v * 10UL + crdt::int_to_u64(s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

fn hex_str(h : String) -> String {
  match crdt::hex_to_bytes(h) {
    Ok(b) => b.to_string()
    Err(_) => ""
  }
}

fn hex_bytes(h : String) -> Bytes {
  match crdt::hex_to_bytes(h) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

fn parse_val(s : String) -> crdt::Any {
  if s == "n" {
    crdt::Any::Null
  } else if s == "t" {
    crdt::Any::Bool(true)
  } else if s == "f" {
    crdt::Any::Bool(false)
  } else if s.starts_with("i:") {
    crdt::Any::Int(parse_int(s.slice(2, s.length())).to_int64())
  } else if s.starts_with("s:") {
    crdt::Any::Str(hex_str(s.slice(2, s.length())))
  } else {
    crdt::Any::Undefined
  }
}

fn json_escape(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("\"")
  let n = s.length()
  let mut i = 0
  let mut run = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 34 || c == 92 || c < 32 {
      if i > run {
        sb.write_string(s.slice(run, i))
      }
      if c == 34 {
        sb.write_string("\\\"")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else if c == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        let hx = "0123456789abcdef"
        sb.write_string(hx.slice(c >> 4, (c >> 4) + 1))
        sb.write_string(hx.slice(c & 15, (c & 15) + 1))
      }
      run = i + 1
    }
    i = i + 1
  }
  if n > run {
    sb.write_string(s.slice(run, n))
  }
  sb.write_string("\"")
}

fn dump_any(sb : StringBuilder, a : crdt::Any) -> Unit {
  match a {
    crdt::Any::Undefined => sb.write_string("null")
    crdt::Any::Null => sb.write_string("null")
    crdt::Any::Bool(v) => sb.write_string(if v { "true" } else { "false" })
    crdt::Any::Int(v) => sb.write_string(v.to_string())
    crdt::Any::Float(v) => sb.write_string(v.to_string())
    crdt::Any::BigInt(v) => sb.write_string(v.to_string())
    crdt::Any::Str(s) => json_escape(sb, s)
    crdt::Any::Binary(b) => {
      sb.write_string("{\"$bin\":\"")
      sb.write_string(crdt::bytes_to_hex(b))
      sb.write_string("\"}")
    }
    crdt::Any::Arr(xs) => {
      sb.write_string("[")
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        dump_any(sb, xs[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    crdt::Any::Obj(m) => {
      let ks = m.keys()
      crdt::sort_strings(ks)
      sb.write_string("{")
      let mut i = 0
      while i < ks.length() {
        if i > 0 {
          sb.write_string(",")
        }
        json_escape(sb, ks[i])
        sb.write_string(":")
        match m.get(ks[i]) {
          Some(v) => dump_any(sb, v)
          None => sb.write_string("null")
        }
        i = i + 1
      }
      sb.write_string("}")
    }
  }
}

fn dump_content_value(
  sb : StringBuilder,
  doc : crdt::Doc,
  c : crdt::Content,
  off : Int,
) -> Unit {
  match c {
    crdt::Content::AnyList(arr) => dump_any(sb, arr[off])
    crdt::Content::Json(arr) => sb.write_string(arr[off])
    crdt::Content::Binary(b) => dump_any(sb, crdt::Any::Binary(b))
    crdt::Content::Type(tid) => dump_type(sb, doc, tid)
    crdt::Content::Embed(s) => sb.write_string(s)
    crdt::Content::Str(s) => json_escape(sb, s)
    _ => sb.write_string("null")
  }
}

fn dump_type(sb : StringBuilder, doc : crdt::Doc, tid : Int) -> Unit {
  let node = doc.types[tid]
  match node.type_ref {
    crdt::TypeRef::YTextRef => {
      json_escape(sb, crdt::YText::{ type_id: tid }.to_string(doc))
    }
    crdt::TypeRef::YArrayRef => {
      sb.write_string("[")
      let mut first = true
      let mut cur = node.start
      while cur >= 0 {
        let item = doc.store.items[cur]
        if !item.deleted && item.countable {
          let mut k = 0
          while k < item.len {
            if !first {
              sb.write_string(",")
            }
            first = false
            dump_content_value(sb, doc, item.content, k)
            k = k + 1
          }
        }
        cur = item.right
      }
      sb.write_string("]")
    }
    crdt::TypeRef::YMapRef => {
      let ks = node.map.keys()
      crdt::sort_strings(ks)
      sb.write_string("{")
      let mut first = true
      let mut i = 0
      while i < ks.length() {
        match node.map.get(ks[i]) {
          Some(idx) => {
            let item = doc.store.items[idx]
            if !item.deleted {
              if !first {
                sb.write_string(",")
              }
              first = false
              json_escape(sb, ks[i])
              sb.write_string(":")
              dump_content_value(sb, doc, item.content, item.len - 1)
            }
          }
          None => ()
        }
        i = i + 1
      }
      sb.write_string("}")
    }
  }
}

fn dump_doc(doc : crdt::Doc) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"a\":")
  dump_type(sb, doc, doc.get_array("a").type_id)
  sb.write_string(",\"m\":")
  dump_type(sb, doc, doc.get_map("m").type_id)
  sb.write_string(",\"t\":")
  dump_type(sb, doc, doc.get_text("t").type_id)
  sb.write_string("}")
  sb.to_string()
}

///| Resolve a path to a type id (or -1).
fn resolve(doc : crdt::Doc, path : String) -> Int {
  // split by '/'
  let segs : Array[String] = Array::new()
  let mut s = 0
  let mut i = 0
  while i <= path.length() {
    if i == path.length() || path.code_unit_at(i) == 47 {
      segs.push(path.slice(s, i))
      s = i + 1
    }
    i = i + 1
  }
  let root = segs[0]
  let mut tid = if root == "t" {
    doc.get_text("t").type_id
  } else if root == "a" {
    doc.get_array("a").type_id
  } else if root == "m" {
    doc.get_map("m").type_id
  } else {
    -1
  }
  let mut k = 1
  while k < segs.length() && tid >= 0 {
    let node = doc.types[tid]
    let next = match node.type_ref {
      crdt::TypeRef::YArrayRef => {
        let idx = parse_int(segs[k])
        let mut found = -1
        let mut pos = 0
        let mut cur = node.start
        while cur >= 0 && found < 0 {
          let item = doc.store.items[cur]
          if !item.deleted && item.countable {
            if idx < pos + item.len {
              found = match item.content {
                crdt::Content::Type(t2) => t2
                _ => -2
              }
            }
            pos = pos + item.len
          }
          cur = item.right
        }
        if found < 0 {
          -1
        } else {
          found
        }
      }
      crdt::TypeRef::YMapRef =>
      match node.map.get(segs[k]) {
        Some(idx) => {
          let item = doc.store.items[idx]
          if item.deleted {
            -1
          } else {
            match item.content {
              crdt::Content::Type(t2) => t2
              _ => -1
            }
          }
        }
        None => -1
      }
      _ => -1
    }
    tid = next
    k = k + 1
  }
  tid
}

fn new_doc(client : UInt64) -> crdt::Doc {
  let d = crdt::Doc::new(client)
  let _ = d.get_text("t")
  let _ = d.get_array("a")
  let _ = d.get_map("m")
  d
}

fn err_line(world : World, e : crdt::CrdtError) -> Unit {
  io_println(world, "E " + e.code)
}

fn run_line(
  world : World,
  docs : Map[Int, crdt::Doc],
  no_markers : Array[Int],
  toks : Array[String],
) -> Unit {
  let cmd = toks[0]
  if cmd == "opt" {
    if toks[1] == "nomarkers" {
      no_markers.push(1)
    }
    return
  }
  if cmd == "doc" {
    docs.set(parse_int(toks[1]), new_doc(parse_u64(toks[2])))
    return
  }
  if cmd == "merge" {
    let ups : Array[Bytes] = Array::new()
    let mut i = 1
    while i < toks.length() {
      ups.push(hex_bytes(toks[i]))
      i = i + 1
    }
    match crdt::merge_updates(ups) {
      Ok(b) => io_println(world, "M " + crdt::bytes_to_hex(b))
      Err(e) => err_line(world, e)
    }
    return
  }
  if cmd == "diff" {
    match crdt::diff_update(hex_bytes(toks[1]), hex_bytes(toks[2])) {
      Ok(b) => io_println(world, "F " + crdt::bytes_to_hex(b))
      Err(e) => err_line(world, e)
    }
    return
  }
  let doc = match docs.get(parse_int(toks[1])) {
    Some(d) => d
    None => {
      io_println(world, "X nodoc")
      return
    }
  }
  if cmd == "apply" {
    let bytes = if toks.length() > 2 { hex_bytes(toks[2]) } else { Bytes::new(0) }
    match doc.apply_update(bytes) {
      Ok(_) => ()
      Err(e) => err_line(world, e)
    }
    return
  }
  if cmd == "sync" || cmd == "full" {
    match docs.get(parse_int(toks[2])) {
      Some(dst) => {
        let u = if cmd == "full" {
          doc.encode_state_as_update()
        } else {
          match doc.encode_state_as_update_from(dst.encode_state_vector()) {
            Ok(b) => b
            Err(_) => Bytes::new(0)
          }
        }
        match dst.apply_update(u) {
          Ok(_) => ()
          Err(e) => err_line(world, e)
        }
      }
      None => io_println(world, "X nodoc")
    }
    return
  }
  if cmd == "dump" {
    io_println(world, "D " + toks[1] + " " + dump_doc(doc))
    return
  }
  if cmd == "upd" {
    io_println(world, "U " + toks[1] + " " + crdt::bytes_to_hex(doc.encode_state_as_update()))
    return
  }
  if cmd == "sv" {
    io_println(world, "S " + toks[1] + " " + crdt::bytes_to_hex(doc.encode_state_vector()))
    return
  }
  if cmd == "pending" {
    io_println(
      world,
      "P " + toks[1] + " " + doc.store.pending_updates.length().to_string(),
    )
    return
  }
  let tid = resolve(doc, toks[2])
  if no_markers.length() > 0 {
    // `opt nomarkers`: drop every search marker before each local op, to isolate
    // bugs that are NOT caused by stale search markers (finding P0-1).
    let mut ti = 0
    while ti < doc.types.length() {
      doc.types[ti].markers.clear()
      ti = ti + 1
    }
  }
  if tid < 0 {
    io_println(world, "X badpath")
    return
  }
  if cmd == "ti" {
    crdt::YText::{ type_id: tid }.insert(doc, parse_int(toks[3]), hex_str(toks[4]))
  } else if cmd == "td" {
    crdt::YText::{ type_id: tid }.delete(doc, parse_int(toks[3]), parse_int(toks[4]))
  } else if cmd == "tf" {
    crdt::YText::{ type_id: tid }.format(
      doc,
      parse_int(toks[3]),
      parse_int(toks[4]),
      toks[5],
      hex_str(toks[6]),
    )
  } else if cmd == "ai" {
    crdt::YArray::{ type_id: tid }.insert(doc, parse_int(toks[3]), parse_val(toks[4]))
  } else if cmd == "ait" {
    let a = crdt::YArray::{ type_id: tid }
    let idx = parse_int(toks[3])
    if toks[4] == "text" {
      let _ = a.insert_text(doc, idx)
    } else if toks[4] == "array" {
      let _ = a.insert_array(doc, idx)
    } else {
      let _ = a.insert_map(doc, idx)
    }
  } else if cmd == "ad" {
    crdt::YArray::{ type_id: tid }.delete(doc, parse_int(toks[3]), parse_int(toks[4]))
  } else if cmd == "ms" {
    crdt::YMap::{ type_id: tid }.set(doc, toks[3], parse_val(toks[4]))
  } else if cmd == "mst" {
    let m = crdt::YMap::{ type_id: tid }
    if toks[4] == "text" {
      let _ = m.set_text(doc, toks[3])
    } else if toks[4] == "array" {
      let _ = m.set_array(doc, toks[3])
    } else {
      let _ = m.set_map(doc, toks[3])
    }
  } else if cmd == "md" {
    crdt::YMap::{ type_id: tid }.delete(doc, toks[3])
  } else {
    io_println(world, "X badcmd")
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: harness <script>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "cannot read script")
      return 1
    }
  }
  let docs : Map[Int, crdt::Doc] = Map::new()
  let no_markers : Array[Int] = Array::new()
  let n = src.length()
  let mut s = 0
  let mut i = 0
  while i <= n {
    if i == n || src.code_unit_at(i) == 10 {
      if i > s {
        let toks = split_ws(src.slice(s, i))
        if toks.length() > 0 && !toks[0].starts_with("#") {
          run_line(world, docs, no_markers, toks)
        }
      }
      s = i + 1
    }
    i = i + 1
  }
  0
}
