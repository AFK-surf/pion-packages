///| Red-team head-to-head workloads (identical logic in bench/node_bench.mjs and rust/src/bin/yrs_bench.rs).
///| usage: crdt_audit_bench <mode> <n> <iters> [trace-file]
///|   text      : W1 of the package bench (60% typing / 25% random insert / 15% delete)
///|   append    : n single-character appends (pure typing at end of document)
///|   tombstone : n appends, delete every other char, then n/5 random single-char inserts
///|   trace     : replay a real editing trace (josephg/editing-traces automerge-paper)
///|   remote    : decode+apply an official-yjs v1 update of the finished trace into `iters` fresh docs

import "crdt"

struct Rng {
  mut s : UInt64
}

fn Rng::next(self : Rng) -> Int {
  self.s = (self.s * 1664525UL + 1013904223UL) & 0xffffffffUL
  (self.s >> 1).to_int()
}

fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

struct Op {
  pos : Int
  del : Int
  ins : String
}

fn load_trace(src : String) -> Array[Op] {
  let ops : Array[Op] = Array::new()
  let n = src.length()
  let mut i = 0
  while i < n {
    let mut j = i
    while j < n && src.code_unit_at(j) != 10 {
      j = j + 1
    }
    if j > i {
      let line = src.slice(i, j)
      let a = line.index_of(" ")
      let rest = line.slice(a + 1, line.length())
      let b = rest.index_of(" ")
      let hx = rest.slice(b + 1, rest.length())
      let ins = match crdt::hex_to_bytes(hx) {
        Ok(bs) => bs.to_string()
        Err(_) => ""
      }
      ops.push(Op::{
        pos: parse_int(line.slice(0, a)),
        del: parse_int(rest.slice(0, b)),
        ins: ins,
      })
    }
    i = j + 1
  }
  ops
}

fn replay(ops : Array[Op]) -> crdt::Doc {
  let doc = crdt::Doc::new(1UL)
  let t = doc.get_text("text")
  let mut k = 0
  while k < ops.length() {
    let op = ops[k]
    if op.del > 0 {
      t.delete(doc, op.pos, op.del)
    }
    if op.ins.length() > 0 {
      t.insert(doc, op.pos, op.ins)
    }
    k = k + 1
  }
  doc
}

fn w_text(ops : Int) -> String {
  let rng = Rng::{ s: 123456789UL }
  let doc = crdt::Doc::new(1UL)
  let t = doc.get_text("text")
  let words = ["a", "the ", "pion ", "crdt ", "x", "yjs ", "fast ", "sync "]
  let mut cursor = 0
  let mut i = 0
  while i < ops {
    let r = rng.next()
    let cur_len = t.len(doc)
    let mode = r % 20
    if mode < 12 || cur_len == 0 {
      if cursor > cur_len {
        cursor = cur_len
      }
      let w = words[(r >> 4) % 8]
      t.insert(doc, cursor, w)
      cursor = cursor + w.length()
    } else if mode < 17 {
      let pos = (r >> 5) % (cur_len + 1)
      let w = words[(r >> 12) % 8]
      t.insert(doc, pos, w)
      cursor = pos + w.length()
    } else {
      let pos = (r >> 5) % cur_len
      let max_d = cur_len - pos
      let dlen = 1 + ((r >> 12) % 4)
      let actual_d = if dlen > max_d { max_d } else { dlen }
      t.delete(doc, pos, actual_d)
      cursor = pos
    }
    i = i + 1
  }
  t.to_string(doc)
}

fn w_append(n : Int) -> String {
  let doc = crdt::Doc::new(1UL)
  let t = doc.get_text("text")
  let letters = "abcdefghijklmnopqrstuvwxyz"
  let mut i = 0
  while i < n {
    t.insert(doc, i, letters.slice(i % 26, i % 26 + 1))
    i = i + 1
  }
  t.to_string(doc)
}

fn w_tombstone(n : Int) -> String {
  let rng = Rng::{ s: 987654321UL }
  let doc = crdt::Doc::new(1UL)
  let t = doc.get_text("text")
  let letters = "abcdefghijklmnopqrstuvwxyz"
  let mut i = 0
  while i < n {
    t.insert(doc, i, letters.slice(i % 26, i % 26 + 1))
    i = i + 1
  }
  let mut p = n - 1
  while p >= 0 {
    if p % 2 == 1 {
      t.delete(doc, p, 1)
    }
    p = p - 1
  }
  let mut k = 0
  while k < n / 5 {
    let pos = rng.next() % (t.len(doc) + 1)
    t.insert(doc, pos, "X")
    k = k + 1
  }
  t.to_string(doc)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_eprintln(world, "usage: crdt_audit_bench <mode> <n> <iters> [trace]")
    return 2
  }
  let mode = args[1]
  let n = parse_int(args[2])
  let iters = parse_int(args[3])
  let mut out = ""
  if mode == "trace" || mode == "remote" {
    let src = match fs_read(world, args[4]) {
      Ok(s) => s
      Err(_) => {
        io_eprintln(world, "cannot read trace")
        return 1
      }
    }
    if mode == "remote" {
      // args[4] holds the hex of an official-yjs v1 update (bench/make_update.mjs)
      let upd = match crdt::hex_to_bytes(src.trim()) {
        Ok(b) => b
        Err(_) => Bytes::new(0)
      }
      let mut k = 0
      while k < iters {
        let r = crdt::Doc::new(2UL)
        let _ = r.apply_update(upd)
        out = r.get_text("text").to_string(r)
        k = k + 1
      }
      io_println(world, mode + " len=" + out.length().to_string())
      io_println(world, out)
      return 0
    }
    let ops = load_trace(src)
    if mode == "trace" {
      let mut k = 0
      while k < iters {
        let d = replay(ops)
        out = d.get_text("text").to_string(d)
        k = k + 1
      }
    } else {
      let d = replay(ops)
      let upd = d.encode_state_as_update()
      let mut k = 0
      while k < iters {
        let r = crdt::Doc::new(2UL)
        let _ = r.apply_update(upd)
        out = r.get_text("text").to_string(r)
        k = k + 1
      }
    }
  } else {
    let mut k = 0
    while k < iters {
      out = if mode == "text" {
        w_text(n)
      } else if mode == "append" {
        w_append(n)
      } else {
        w_tombstone(n)
      }
      k = k + 1
    }
  }
  io_println(world, mode + " len=" + out.length().to_string())
  io_println(world, out)
  0
}
