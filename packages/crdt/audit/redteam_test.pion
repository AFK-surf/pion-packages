///| Red-team evidence for `packages/crdt` (see REPORT.md).
///|
///| Every test asserts the behaviour of the official Node.js `yjs@13.6.33` and/or Rust `yrs 0.28.2`
///| (expected values were produced by `node/gen_fixtures.mjs` and cross-checked with
///| `rust/src/bin/yrs_interp.rs`). A FAILING test is evidence that Pion's `crdt` diverges.
///| Hex fixtures are byte-exact `Y.encodeStateAsUpdate` output of official `yjs`.
///|
///| Crash-class findings (process abort / SIGSEGV) are NOT here, because they would kill the
///| test runner: they are reproduced by `run_audit.sh` (node/fuzz_malformed.mjs).

import "crdt"

///|
fn hx(h : String) -> Bytes {
  match crdt::hex_to_bytes(h) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
fn hs(h : String) -> String {
  hx(h).to_string()
}

///|
fn sync_full(src : crdt::Doc, dst : crdt::Doc) -> Unit {
  match dst.apply_update(src.encode_state_as_update()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "sync failed: " + e.code)
  }
}

///|
fn apply_ok(d : crdt::Doc, h : String) -> Bool {
  match d.apply_update(hx(h)) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn bytes_contains(hay : Bytes, needle : String) -> Bool {
  let n = crdt::bytes_to_hex(hay)
  let m = crdt::bytes_to_hex(needle.to_bytes())
  n.index_of(m) >= 0
}

///| Minimal Quill-style delta of a root `YText`, computed exactly like `Y.Text#toDelta`
///| (ContentFormat items open/close attributes, null closes). Rendered as
///| `text|k=v,k=v;text|...` with sorted keys.
fn delta_string(doc : crdt::Doc, name : String) -> String {
  let attrs : Map[String, String] = Map::new()
  let segs : Array[String] = Array::new()
  let keys_of : Array[String] = Array::new()
  let mut cur_text = StringBuilder::new()
  let mut cur_key = ""
  let mut has = false
  let mut cur = doc.types[doc.get_text(name).type_id].start
  while cur >= 0 {
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        crdt::Content::Format(k, v) =>
        if v == "null" {
          attrs.remove(k)
        } else {
          attrs.set(k, v)
        }
        crdt::Content::Str(s) => {
          let ks = attrs.keys()
          crdt::sort_strings(ks)
          let kb = StringBuilder::new()
          let mut i = 0
          while i < ks.length() {
            if i > 0 {
              kb.write_string(",")
            }
            kb.write_string(ks[i])
            kb.write_string("=")
            match attrs.get(ks[i]) {
              Some(v) => kb.write_string(v)
              None => ()
            }
            i = i + 1
          }
          let key = kb.to_string()
          if has && key == cur_key {
            cur_text.write_string(s)
          } else {
            if has {
              segs.push(cur_text.to_string() + "|" + cur_key)
            }
            cur_text = StringBuilder::new()
            cur_text.write_string(s)
            cur_key = key
            has = true
          }
        }
        _ => ()
      }
    }
    cur = item.right
  }
  if has {
    segs.push(cur_text.to_string() + "|" + cur_key)
  }
  let _ = keys_of
  let out = StringBuilder::new()
  let mut i = 0
  while i < segs.length() {
    if i > 0 {
      out.write_string(";")
    }
    out.write_string(segs[i])
    i = i + 1
  }
  out.to_string()
}

// ============================================================================================
// Controls — these PASS, proving the fixtures and the delta helper are sound
// ============================================================================================

///| Control: plain ASCII concurrent edits converge and match yjs (P0-2 with "E" instead of "😀"; yjs = yrs = EzabQ).
test "control_ascii_concurrent_edits_converge_like_yjs" {
  let a = crdt::Doc::new(1UL)
  let b = crdt::Doc::new(2UL)
  a.get_text("t").insert(a, 0, "Eab")
  sync_full(a, b)
  a.get_text("t").insert(a, 1, "z")
  b.get_text("t").insert(b, 3, "Q")
  sync_full(a, b)
  sync_full(b, a)
  debug_assert(a.get_text("t").to_string(a) == "EzabQ", "yjs/yrs => EzabQ")
  debug_assert(b.get_text("t").to_string(b) == "EzabQ", "yjs/yrs => EzabQ")
}

///| Control: a non-overlapping format is rendered exactly like yjs toDelta.
test "control_simple_format_delta_matches_yjs" {
  let d = crdt::Doc::new(9UL)
  let t = d.get_text("t")
  t.insert(d, 0, "abcdef")
  t.format(d, 0, 3, "bold", "true")
  debug_assert(delta_string(d, "t") == "abc|bold=true;def|", delta_string(d, "t"))
}

///| Control: the rich-text update of official yjs (format + embed) decodes to the same plain text.
test "control_yjs_richtext_update_plain_text" {
  let d = crdt::Doc::new(3UL)
  debug_assert(
    apply_ok(
      d,
      "01040c000601017404626f6c640474727565840c00026869860c0204626f6c64046e756c6c850c03117b22696d616765223a22782e706e67227d00",
    ),
    "apply",
  )
  debug_assert(delta_string(d, "t") == "hi|bold=true", delta_string(d, "t"))
}

// ============================================================================================
// P0 — data corruption / non-convergence / wire incompatibility
// ============================================================================================

///| P0-1: after a REMOTE delete (delete-set only update) the local search markers are stale,
///| so the next LOCAL edit hits the wrong character. yjs & yrs: "0123456789cXZ".
test "p0_1_stale_search_marker_after_remote_delete_edits_wrong_char" {
  let a = crdt::Doc::new(1UL)
  let b = crdt::Doc::new(2UL)
  a.get_text("t").insert(a, 0, "0123456789abc")
  sync_full(a, b)
  b.get_text("t").insert(b, 13, "XYZ")
  sync_full(b, a)
  a.get_text("t").delete(a, 10, 2)
  sync_full(a, b)
  debug_assert(b.get_text("t").to_string(b) == "0123456789cXYZ", "precondition")
  b.get_text("t").delete(b, 12, 1) // delete "Y"
  let got = b.get_text("t").to_string(b)
  debug_assert(
    got == "0123456789cXZ",
    "yjs/yrs => 0123456789cXZ, pion => " + got,
  )
}

///| P0-2: two Pion replicas DO NOT CONVERGE when one of them inserts inside an emoji
///| (UTF-16 index 1 of "😀", legal in the yjs API). yjs & yrs: both "�z�aQb".
test "p0_2_concurrent_edit_next_to_split_surrogate_never_converges" {
  let a = crdt::Doc::new(1UL)
  let b = crdt::Doc::new(2UL)
  a.get_text("t").insert(a, 0, hs("f09f98806162")) // "😀ab"
  sync_full(a, b)
  a.get_text("t").insert(a, 1, "z")
  b.get_text("t").insert(b, 3, "Q")
  sync_full(a, b)
  sync_full(b, a)
  let ta = a.get_text("t").to_string(a)
  let tb = b.get_text("t").to_string(b)
  debug_assert(ta == tb, "replicas diverged: A=" + ta + " B=" + tb)
  debug_assert(ta == hs("efbfbd7aefbfbd615162"), "yjs/yrs => \\uFFFDz\\uFFFDaQb, pion => " + ta)
}

///| P0-3: an official yjs peer inserts "x" at UTF-16 index 1 of "😀" (splitting the surrogate
///| pair). yjs & yrs both decode to "�x�"; Pion keeps a corrupt 4-byte item of length 1.
test "p0_3_remote_insert_inside_surrogate_pair_from_yjs" {
  let d = crdt::Doc::new(3UL)
  debug_assert(apply_ok(d, "010101000401017404f09f988000"), "base")
  debug_assert(apply_ok(d, "01010200c401000101017800"), "insert")
  let got = d.get_text("t").to_string(d)
  debug_assert(got == hs("efbfbd78efbfbd"), "yjs/yrs => \\uFFFDx\\uFFFD, pion => " + got)
}

///| P0-4: a y-prosemirror / Tiptap document (Y.XmlFragment + Y.XmlElement + Y.XmlText) is
///| rejected outright with INVALID_CONTENT_REF (ContentType ref 3 carries a nodeName string).
///| yjs & yrs accept it.
test "p0_4_xml_fragment_update_from_yjs_is_rejected" {
  let d = crdt::Doc::new(3UL)
  let r = d.apply_update(
    hx(
      "010405000701017403097061726167726170680700050006040005010568656c6c6f2800050005616c69676e0177046c65667400",
    ),
  )
  let msg = match r {
    Ok(_) => "ok"
    Err(e) => e.code
  }
  debug_assert(msg == "ok", "yjs/yrs accept <paragraph align=left>hello</paragraph>, pion => " + msg)
  // and the doc must not silently be empty
  debug_assert(d.store.items.length() >= 4, "4 structs expected, pion has " + d.store.items.length().to_string())
}

// ============================================================================================
// P1 — silent data loss / privacy / semantic divergence
// ============================================================================================

///| P1-1: a nested Y.XmlText (ContentType ref 6) is rewritten as Y.Text (ref 2) when Pion
///| re-encodes the document (e.g. a Pion relay/persistence server) — type corruption for every
///| downstream yjs client. yjs/yrs re-encode byte-identically.
test "p1_1_xmltext_type_ref_rewritten_to_ytext_on_reencode" {
  let src = "010206002701016d016b060400060002686900"
  let d = crdt::Doc::new(3UL)
  debug_assert(apply_ok(d, src), "apply")
  let out = crdt::bytes_to_hex(d.encode_state_as_update())
  debug_assert(out == src, "yjs/yrs re-encode " + src + ", pion => " + out)
}

///| P1-2: subdocuments (ContentDoc, ref 9) — any doc containing a subdoc is rejected entirely.
test "p1_2_subdoc_update_from_yjs_is_rejected" {
  let d = crdt::Doc::new(3UL)
  let r = d.apply_update(hx("010107002901016d03737562087375622d67756964760000"))
  let msg = match r {
    Ok(_) => "ok"
    Err(e) => e.code
  }
  debug_assert(msg == "ok", "yjs/yrs accept a Y.Map holding a subdoc, pion => " + msg)
}

///| P1-3: deleted text is never garbage-collected: `encode_state_as_update` ships every deleted
///| character in clear text to every peer (yjs gc=true ships ContentDeleted: 25 bytes, no secret).
test "p1_3_deleted_secret_still_shipped_in_update" {
  let d = crdt::Doc::new(8UL)
  let t = d.get_text("t")
  t.insert(d, 0, "public ")
  t.insert(d, 7, "SECRET-PASSWORD-123")
  t.delete(d, 7, 19)
  let u = d.encode_state_as_update()
  debug_assert(!bytes_contains(u, "SECRET-PASSWORD-123"), "deleted secret leaked in update")
  debug_assert(u.length() <= 25, "yjs => 25 bytes, pion => " + u.length().to_string())
}

///| P1-4: formatting a sub-range that is already bold writes `bold:null` at its end, so the tail
///| loses bold. yjs toDelta: [{"insert":"abcdef","attributes":{"bold":true}}].
test "p1_4_format_overlap_drops_attribute_on_tail" {
  let d = crdt::Doc::new(9UL)
  let t = d.get_text("t")
  t.insert(d, 0, "abcdef")
  t.format(d, 0, 6, "bold", "true")
  t.format(d, 2, 2, "bold", "true")
  let got = delta_string(d, "t")
  debug_assert(got == "abcdef|bold=true", "yjs => abcdef|bold=true, pion => " + got)
}

///| P1-5: nested formatting does not restore the outer value; yjs:
///| ab{color:red} cd{color:blue} ef{color:red}.
test "p1_5_nested_format_does_not_restore_outer_value" {
  let d = crdt::Doc::new(11UL)
  let t = d.get_text("t")
  t.insert(d, 0, "abcdef")
  t.format(d, 0, 6, "color", "\"red\"")
  t.format(d, 2, 2, "color", "\"blue\"")
  let got = delta_string(d, "t")
  debug_assert(
    got == "ab|color=\"red\";cd|color=\"blue\";ef|color=\"red\"",
    "yjs => ab red / cd blue / ef red, pion => " + got,
  )
}

// ============================================================================================
// P2 — robustness / fidelity
// ============================================================================================

///| P2-1: lib0 objects are re-encoded with keys sorted (Map order), so a Pion relay changes the
///| bytes and the JS key order (zeta,alpha,mid -> alpha,mid,zeta). yjs preserves the order
///| (note: yrs 0.28 also reorders — it stores objects in a HashMap — so this is "worse than yjs" only).
test "p2_1_any_object_key_order_not_preserved_on_reencode" {
  let src = "01010d0008010161017603047a6574617d0105616c7068617d02036d69647d0300"
  let d = crdt::Doc::new(3UL)
  debug_assert(apply_ok(d, src), "apply")
  let out = crdt::bytes_to_hex(d.encode_state_as_update())
  debug_assert(out == src, "yjs re-encodes identically, pion => " + out)
}

///| P2-2: the pending queue stores one copy per re-delivery of the same not-yet-applicable
///| update (yjs keeps ONE merged pending update). Unbounded memory under retransmission.
test "p2_2_pending_queue_grows_per_duplicate_delivery" {
  let d = crdt::Doc::new(77UL)
  let mut i = 0
  while i < 200 {
    let _ = d.apply_update(hx("0101090504010174017800"))
    i = i + 1
  }
  let n = d.store.pending_updates.length()
  debug_assert(n <= 1, "yjs keeps 1 pending update, pion keeps " + n.to_string())
}

///| P2-3: invalid UTF-8 inside a ContentString is accepted (yjs: "The encoded data was not valid
///| for encoding utf-8"; yrs: "invalid UTF-8 sequence"), its UTF-16 length is mis-computed (1
///| instead of 2) and the following struct is silently turned into a GC block.
test "p2_3_invalid_utf8_string_accepted_and_next_struct_lost" {
  let d = crdt::Doc::new(3UL)
  let ok = apply_ok(d, "010201000401017402c341840101015a00")
  debug_assert(!ok, "yjs and yrs reject invalid UTF-8; pion accepted it")
}

///| P2-4: a GC struct of length 2^53-1 (largest clock yjs can represent) is truncated to a
///| 32-bit Int (-1) and the client clock wraps to 2^64-1; the following insert "x" is lost.
///| yjs: state vector {5: 2^53}, text "x".
test "p2_4_huge_gc_length_wraps_clock_and_drops_next_struct" {
  let d = crdt::Doc::new(3UL)
  debug_assert(apply_ok(d, "0102050000ffffffffffffff0f04010174017800"), "apply")
  let clock = d.state_vector().get(5UL)
  debug_assert(clock == 9007199254740992UL, "yjs clock 2^53, pion => " + clock.to_string())
  let got = d.get_text("t").to_string(d)
  debug_assert(got == "x", "yjs => x, pion => " + got)
}
