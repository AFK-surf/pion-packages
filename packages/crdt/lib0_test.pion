///| Comprehensive lib0 binary encoding/decoding test suite (38 tests).
///| Verifies byte-exact compatibility with official `lib0/encoding` and `lib0/decoding`.

///|
fn unwrap_bytes(r : Result[Bytes, CrdtError]) -> Bytes {
  match r {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "expected Ok(Bytes), got Err: " + e.message)
      Bytes::new(0)
    }
  }
}

///|
fn unwrap_u64(r : Result[UInt64, CrdtError]) -> UInt64 {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(UInt64), got Err: " + e.message)
      0UL
    }
  }
}

///|
fn unwrap_i64(r : Result[Int64, CrdtError]) -> Int64 {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Int64), got Err: " + e.message)
      0L
    }
  }
}

///|
fn unwrap_int(r : Result[Int, CrdtError]) -> Int {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Int), got Err: " + e.message)
      0
    }
  }
}

///|
fn unwrap_str(r : Result[String, CrdtError]) -> String {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(String), got Err: " + e.message)
      ""
    }
  }
}

///|
fn unwrap_f64(r : Result[Double, CrdtError]) -> Double {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Double), got Err: " + e.message)
      0.0
    }
  }
}

///|
fn unwrap_any(r : Result[Any, CrdtError]) -> Any {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Any), got Err: " + e.message)
      Any::Undefined
    }
  }
}

///|
fn is_err_u64(r : Result[UInt64, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_i64(r : Result[Int64, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_str(r : Result[String, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_bytes(r : Result[Bytes, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_f64(r : Result[Double, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_any(r : Result[Any, CrdtError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "lib0_varuint_zero_golden" {
  let enc = Encoder::new()
  enc.write_var_uint(0UL)
  let b = enc.to_bytes()
  debug_assert(bytes_to_hex(b) == "00", "varuint(0) hex")
  let dec = Decoder::new(b)
  debug_assert(unwrap_u64(dec.read_var_uint()) == 0UL, "varuint(0) decode")
  debug_assert(!dec.has_content(), "eof")
}

///|
test "lib0_varuint_127_golden" {
  let enc = Encoder::new()
  enc.write_var_uint(127UL)
  let b = enc.to_bytes()
  debug_assert(bytes_to_hex(b) == "7f", "varuint(127) hex")
  let dec = Decoder::new(b)
  debug_assert(unwrap_u64(dec.read_var_uint()) == 127UL, "varuint(127) decode")
}

