  debug_assert(bytes_to_hex(b) == "0e48656c6c6f2c20e4b896e7958c21", "varstring CJK hex")
  let dec = Decoder::new(b)
  debug_assert(unwrap_str(dec.read_var_string()) == "Hello, 世界!", "varstring CJK decode")
}

///|
test "lib0_varstring_emoji_roundtrip" {
  let s = "🚀 Pion CRDT 🎉"
  let enc = Encoder::new()
  enc.write_var_string(s)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_str(dec.read_var_string()) == s, "emoji roundtrip")
}

///|
test "lib0_varbytes_roundtrip" {
  let payload = unwrap_bytes(hex_to_bytes("000102fffe80"))
  let enc = Encoder::new()
  enc.write_var_bytes(payload)
  let dec = Decoder::new(enc.to_bytes())
  let out = unwrap_bytes(dec.read_var_bytes())
  debug_assert(bytes_to_hex(out) == "000102fffe80", "varbytes roundtrip")
}

///|
test "lib0_float64_pi_golden" {
  let enc = Encoder::new()
  enc.write_float64(3.141592653589793)
  let b = enc.to_bytes()
  debug_assert(bytes_to_hex(b) == "400921fb54442d18", "f64 pi hex")
  let dec = Decoder::new(b)
  let v = unwrap_f64(dec.read_float64())
  debug_assert(v == 3.141592653589793, "f64 pi decode")
}

///|
test "lib0_float64_neg_half_golden" {
  let enc = Encoder::new()
  enc.write_float64(-0.5)
  let b = enc.to_bytes()
  debug_assert(bytes_to_hex(b) == "bfe0000000000000", "f64 -0.5 hex")
  let dec = Decoder::new(b)
  debug_assert(unwrap_f64(dec.read_float64()) == -0.5, "f64 -0.5 decode")
}

///|
test "lib0_float64_zero_and_large" {
  let enc = Encoder::new()
  enc.write_float64(0.0)
  enc.write_float64(1.0)
  enc.write_float64(-123456.789)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_f64(dec.read_float64()) == 0.0, "0.0")
  debug_assert(unwrap_f64(dec.read_float64()) == 1.0, "1.0")
  let v = unwrap_f64(dec.read_float64())
  debug_assert(v < -123456.788 && v > -123456.790, "-123456.789")
}

///|
test "lib0_float32_roundtrip" {
  let enc = Encoder::new()
  enc.write_float32(3.5)
  enc.write_float32(-0.25)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_f64(dec.read_float32()) == 3.5, "f32 3.5")
  debug_assert(unwrap_f64(dec.read_float32()) == -0.25, "f32 -0.25")
}

///|
test "lib0_bigint64_roundtrip" {
  let enc = Encoder::new()
  enc.write_bigint64(0L)
  enc.write_bigint64(9223372036854775807L)
  enc.write_bigint64(-1L)
  enc.write_bigint64(-9000000000000000000L)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_i64(dec.read_bigint64()) == 0L, "0L")
  debug_assert(unwrap_i64(dec.read_bigint64()) == 9223372036854775807L, "i64 max")
  debug_assert(unwrap_i64(dec.read_bigint64()) == -1L, "-1L")
  debug_assert(unwrap_i64(dec.read_bigint64()) == -9000000000000000000L, "-9e18")
}

///|
test "lib0_any_primitives_roundtrip" {
  let enc = Encoder::new()
  enc.write_any(Any::Undefined)
  enc.write_any(Any::Null)
  enc.write_any(Any::Bool(true))
  enc.write_any(Any::Bool(false))
  enc.write_any(Any::Int(42L))
  enc.write_any(Any::Int(-999L))
  enc.write_any(Any::Float(3.141592653589793))
  enc.write_any(Any::Str("hello"))
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Undefined), "undef")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Null), "null")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Bool(true)), "true")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Bool(false)), "false")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Int(42L)), "42")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Int(-999L)), "-999")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Float(3.141592653589793)), "pi")
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Str("hello")), "hello")
}

///|
test "lib0_any_binary_roundtrip" {
  let raw = unwrap_bytes(hex_to_bytes("cafebabe"))
  let enc = Encoder::new()
  enc.write_any(Any::Binary(raw))
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(any_eq(unwrap_any(dec.read_any()), Any::Binary(raw)), "binary any")
}

///|
test "lib0_any_array_and_object_roundtrip" {
  let arr : Array[Any] = Array::new()
  arr.push(Any::Int(1L))
  arr.push(Any::Str("two"))
  arr.push(Any::Bool(true))
  let obj : Map[String, Any] = Map::new()
  obj.set("k1", Any::Int(10L))
  obj.set("k2", Any::Arr(arr))
  let enc = Encoder::new()
  enc.write_any(Any::Obj(obj))
  let dec = Decoder::new(enc.to_bytes())
  let decoded = unwrap_any(dec.read_any())
  debug_assert(any_eq(decoded, Any::Obj(obj)), "nested obj/arr roundtrip")
}

///|
test "lib0_any_complex_golden_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("760701617d2a01627d4701637801647901657e016677026869016775027d017c40600000"),
  )
  let dec = Decoder::new(b)
  let v = unwrap_any(dec.read_any())
  match v {
    Any::Obj(m) => {
      debug_assert(m.length() == 7, "7 keys")
      match m.get("a") {
        Some(x) => debug_assert(any_eq(x, Any::Int(42L)), "a == 42")
        None => debug_assert(false, "missing a")
      }
      match m.get("b") {
        Some(x) => debug_assert(any_eq(x, Any::Int(-7L)), "b == -7")
        None => debug_assert(false, "missing b")
      }
      match m.get("c") {
        Some(x) => debug_assert(any_eq(x, Any::Bool(true)), "c == true")
        None => debug_assert(false, "missing c")
      }
      match m.get("d") {
        Some(x) => debug_assert(any_eq(x, Any::Bool(false)), "d == false")
        None => debug_assert(false, "missing d")
      }
      match m.get("e") {
        Some(x) => debug_assert(any_eq(x, Any::Null), "e == null")
        None => debug_assert(false, "missing e")
      }
      match m.get("f") {
        Some(x) => debug_assert(any_eq(x, Any::Str("hi")), "f == hi")
        None => debug_assert(false, "missing f")
      }
      match m.get("g") {
        Some(Any::Arr(ga)) => {
          debug_assert(ga.length() == 2, "g len 2")
          debug_assert(any_eq(ga[0], Any::Int(1L)), "g[0] == 1")
          debug_assert(any_eq(ga[1], Any::Float(3.5)), "g[1] == 3.5")
        }
        _ => debug_assert(false, "missing g")
      }
    }
    _ => debug_assert(false, "expected Obj")
  }
}

///|
test "lib0_decoder_eof_varuint_err" {
  let dec = Decoder::new(Bytes::new(0))
  debug_assert(is_err_u64(dec.read_var_uint()), "empty varuint errs")
}

///|
test "lib0_decoder_truncated_varuint_err" {
  let b = unwrap_bytes(hex_to_bytes("8080"))
  let dec = Decoder::new(b)
  debug_assert(is_err_u64(dec.read_var_uint()), "unterminated varuint errs")
}

///|
test "lib0_decoder_truncated_varint_err" {
  let b = unwrap_bytes(hex_to_bytes("80"))
  let dec = Decoder::new(b)
  debug_assert(is_err_i64(dec.read_var_int()), "unterminated varint errs")
}

///|
test "lib0_decoder_truncated_varstring_err" {
  let b = unwrap_bytes(hex_to_bytes("056162"))
  let dec = Decoder::new(b)
  debug_assert(is_err_str(dec.read_var_string()), "truncated varstring errs")
}

///|
test "lib0_decoder_truncated_varbytes_err" {
  let b = unwrap_bytes(hex_to_bytes("04aabb"))
  let dec = Decoder::new(b)
  debug_assert(is_err_bytes(dec.read_var_bytes()), "truncated varbytes errs")
}

///|
test "lib0_decoder_truncated_float64_err" {
  let b = unwrap_bytes(hex_to_bytes("400921"))
  let dec = Decoder::new(b)
  debug_assert(is_err_f64(dec.read_float64()), "truncated float64 errs")
}

///|
test "lib0_decoder_invalid_any_tag_err" {
  let b = unwrap_bytes(hex_to_bytes("01"))
  let dec = Decoder::new(b)
  debug_assert(is_err_any(dec.read_any()), "invalid any tag errs")
}
