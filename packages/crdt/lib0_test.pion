///|
test "lib0_varint_extremes_roundtrip" {
  let enc = Encoder::new()
  enc.write_var_int(2147483647L)
  enc.write_var_int(-2147483647L)
  enc.write_var_int(100000000000L)
  enc.write_var_int(-100000000000L)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_i64(dec.read_var_int()) == 2147483647L, "i32 max")
  debug_assert(unwrap_i64(dec.read_var_int()) == -2147483647L, "-i32 max")
  debug_assert(unwrap_i64(dec.read_var_int()) == 100000000000L, "1e11")
  debug_assert(unwrap_i64(dec.read_var_int()) == -100000000000L, "-1e11")
}

///|
test "lib0_uint8_roundtrip" {
  let enc = Encoder::new()
  enc.write_uint8(0)
  enc.write_uint8(127)
  enc.write_uint8(255)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_int(dec.read_uint8()) == 0, "0")
  debug_assert(unwrap_int(dec.read_uint8()) == 127, "127")
  debug_assert(unwrap_int(dec.read_uint8()) == 255, "255")
}

