///|
test "lib0_varuint_u64_max_53bit" {
  let v : UInt64 = 9007199254740991UL
  let enc = Encoder::new()
  enc.write_var_uint(v)
  let dec = Decoder::new(enc.to_bytes())
  debug_assert(unwrap_u64(dec.read_var_uint()) == v, "2^53-1 roundtrip")
}

