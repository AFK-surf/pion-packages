  enc.write_var_string("")
  let b = enc.to_bytes()
  debug_assert(bytes_to_hex(b) == "00", "empty varstring")
  let dec = Decoder::new(b)
  debug_assert(unwrap_str(dec.read_var_string()) == "", "empty decode")
}

///|
test "lib0_varstring_utf8_cjk_golden" {
  let enc = Encoder::new()
  enc.write_var_string("Hello, 世界!")
