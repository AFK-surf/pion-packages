///| Core YText, YArray, YMap, and YATA conflict resolution tests (45 tests).

///|
fn sync_pair(a : Doc, b : Doc) -> Unit {
  let ua = a.encode_state_as_update()
  let ub = b.encode_state_as_update()
  match a.apply_update(ub) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "sync_pair a<-b failed: " + e.message)
  }
  match b.apply_update(ua) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "sync_pair b<-a failed: " + e.message)
  }
}

// --- YText tests (18) ---

///|
test "ytext_empty_initial" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  debug_assert(t.len(doc) == 0, "empty len")
  debug_assert(t.to_string(doc) == "", "empty str")
}

///|
test "ytext_insert_basic" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "Hello")
  debug_assert(t.to_string(doc) == "Hello", "Hello")
  debug_assert(t.len(doc) == 5, "len 5")
}

///|
test "ytext_insert_prepend_middle_append" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "world")
  t.insert(doc, 0, "Hello ")
  t.insert(doc, 6, "Pion ")
  t.push(doc, "!")
  debug_assert(t.to_string(doc) == "Hello Pion world!", "composed")
  debug_assert(t.len(doc) == 17, "len 17")
}

///|
test "ytext_delete_prefix" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "abcdef")
  t.delete(doc, 0, 2)
  debug_assert(t.to_string(doc) == "cdef", "cdef")
  debug_assert(t.len(doc) == 4, "len 4")
}

///|
test "ytext_delete_middle" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "abcdef")
  t.delete(doc, 2, 2)
  debug_assert(t.to_string(doc) == "abef", "abef")
}

///|
test "ytext_delete_suffix" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "abcdef")
  t.delete(doc, 4, 2)
  debug_assert(t.to_string(doc) == "abcd", "abcd")
}

///|
test "ytext_delete_across_multiple_items" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "aaa")
  t.insert(doc, 0, "bbb")
  t.insert(doc, 0, "ccc")
  // "cccbbbaaa"
  t.delete(doc, 2, 5)
  debug_assert(t.to_string(doc) == "ccaa", "delete spanning 3 items")
}

///|
test "ytext_delete_entire_text" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "delete me")
  t.delete(doc, 0, 9)
  debug_assert(t.to_string(doc) == "", "empty after full delete")
  debug_assert(t.len(doc) == 0, "len 0")
}

///|
test "ytext_delete_zero_noop" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "abc")
  t.delete(doc, 1, 0)
  debug_assert(t.to_string(doc) == "abc", "zero delete noop")
}

///|
test "ytext_insert_empty_noop" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "abc")
  t.insert(doc, 1, "")
  debug_assert(t.to_string(doc) == "abc", "empty insert noop")
}

///|
test "ytext_utf8_cjk_indexing" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "你好世界")
  debug_assert(t.len(doc) == 4, "4 CJK BMP chars = 4 UTF-16 units")
  t.insert(doc, 2, "Pion")
  debug_assert(t.to_string(doc) == "你好Pion世界", "CJK middle insert")
  t.delete(doc, 1, 5)
  debug_assert(t.to_string(doc) == "你世界", "CJK delete")
}

///|
test "ytext_utf16_emoji_surrogate_length" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "a😀b")
  // 'a' (1) + '😀' (2 UTF-16 code units) + 'b' (1) = 4
  debug_assert(t.len(doc) == 4, "emoji is 2 UTF-16 code units")
  t.insert(doc, 3, "!")
  debug_assert(t.to_string(doc) == "a😀!b", "insert after emoji")
  t.delete(doc, 1, 2)
  debug_assert(t.to_string(doc) == "a!b", "delete emoji")
}

///|
test "ytext_format_preserves_text" {
  let doc = Doc::new(1UL)
  let t = doc.get_text("t")
  t.insert(doc, 0, "Hello world")
  t.format(doc, 0, 5, "bold", "true")
  debug_assert(t.to_string(doc) == "Hello world", "text unchanged by format")
  debug_assert(t.len(doc) == 11, "len unchanged by non-countable format")
}

///|
test "ytext_concurrent_insert_same_pos_tiebreak" {
  let d1 = Doc::new(10UL)
  let d2 = Doc::new(20UL)
  d1.get_text("t").insert(d1, 0, "AAA")
  d2.get_text("t").insert(d2, 0, "BBB")
  sync_pair(d1, d2)
  debug_assert(d1.get_text("t").to_string(d1) == "AAABBB", "lower client_id first")
  debug_assert(d2.get_text("t").to_string(d2) == "AAABBB", "symmetric convergence")
}

///|
test "ytext_concurrent_insert_after_shared_origin" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "ab")
  sync_pair(d1, d2)
  d1.get_text("t").insert(d1, 1, "X")
  d2.get_text("t").insert(d2, 1, "Y")
  sync_pair(d1, d2)
  debug_assert(d1.get_text("t").to_string(d1) == "aXYb", "client 1 before client 2")
  debug_assert(d2.get_text("t").to_string(d2) == "aXYb", "converged")
}

///|
test "ytext_concurrent_interleaved_typing" {
  let d1 = Doc::new(100UL)
  let d2 = Doc::new(200UL)
  let t1 = d1.get_text("t")
  let t2 = d2.get_text("t")
  t1.insert(d1, 0, "0")
  sync_pair(d1, d2)
  t1.insert(d1, 1, "a")
  t1.insert(d1, 2, "b")
  t1.insert(d1, 3, "c")
  t2.insert(d2, 1, "1")
  t2.insert(d2, 2, "2")
  t2.insert(d2, 3, "3")
  sync_pair(d1, d2)
  debug_assert(t1.to_string(d1) == "0abc123", "no interleaving of runs")
  debug_assert(t2.to_string(d2) == "0abc123", "converged")
}

///|
test "ytext_concurrent_delete_idempotent" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "hello world")
  sync_pair(d1, d2)
  d1.get_text("t").delete(d1, 0, 6)
  d2.get_text("t").delete(d2, 0, 6)
  sync_pair(d1, d2)
  debug_assert(d1.get_text("t").to_string(d1) == "world", "idempotent delete 1")
  debug_assert(d2.get_text("t").to_string(d2) == "world", "idempotent delete 2")
}

///|
test "ytext_concurrent_overlapping_delete" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "0123456789")
  sync_pair(d1, d2)
  d1.get_text("t").delete(d1, 2, 4) // deletes 2345
  d2.get_text("t").delete(d2, 4, 4) // deletes 4567
  sync_pair(d1, d2)
  debug_assert(d1.get_text("t").to_string(d1) == "0189", "overlap delete 1")
  debug_assert(d2.get_text("t").to_string(d2) == "0189", "overlap delete 2")
}

// --- YArray tests (14) ---

///|
test "yarray_empty" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  debug_assert(a.len(doc) == 0, "empty len")
  debug_assert(a.to_array(doc).length() == 0, "empty to_array")
}

///|
test "yarray_push_and_get" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  a.push(doc, Any::Int(10L))
  a.push(doc, Any::Str("hi"))
  a.push(doc, Any::Bool(true))
  debug_assert(a.len(doc) == 3, "len 3")
  match a.get(doc, 0) {
    Some(v) => debug_assert(any_eq(v, Any::Int(10L)), "idx 0")
    None => debug_assert(false, "missing 0")
  }
  match a.get(doc, 1) {
    Some(v) => debug_assert(any_eq(v, Any::Str("hi")), "idx 1")
    None => debug_assert(false, "missing 1")
  }
  match a.get(doc, 2) {
    Some(v) => debug_assert(any_eq(v, Any::Bool(true)), "idx 2")
    None => debug_assert(false, "missing 2")
  }
}

///|
test "yarray_insert_range_and_middle_insert" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  let vals : Array[Any] = Array::new()
  vals.push(Any::Int(1L))
  vals.push(Any::Int(2L))
  vals.push(Any::Int(5L))
  a.insert_range(doc, 0, vals)
  a.insert(doc, 2, Any::Int(3L))
  a.insert(doc, 3, Any::Int(4L))
  let out = a.to_array(doc)
  debug_assert(out.length() == 5, "len 5")
  debug_assert(any_eq(out[0], Any::Int(1L)), "1")
  debug_assert(any_eq(out[2], Any::Int(3L)), "3")
  debug_assert(any_eq(out[4], Any::Int(5L)), "5")
}

///|
test "yarray_delete_middle_and_edges" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  let mut i = 0
  while i < 6 {
    a.push(doc, Any::Int(i.to_int64()))
    i = i + 1
  }
  a.delete(doc, 1, 2) // [0, 3, 4, 5]
  a.delete(doc, 0, 1) // [3, 4, 5]
  a.delete(doc, 2, 1) // [3, 4]
  let out = a.to_array(doc)
  debug_assert(out.length() == 2, "len 2")
  debug_assert(any_eq(out[0], Any::Int(3L)), "3")
  debug_assert(any_eq(out[1], Any::Int(4L)), "4")
}

///|
test "yarray_get_oob_none" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  a.push(doc, Any::Int(1L))
  match a.get(doc, 5) {
    None => ()
    Some(_) => debug_assert(false, "oob should be None")
  }
}

///|
test "yarray_nested_text" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  let t = a.insert_text(doc, 0)
  t.insert(doc, 0, "inside array")
  match a.get_text(doc, 0) {
    Some(t2) => debug_assert(t2.to_string(doc) == "inside array", "nested text")
    None => debug_assert(false, "expected nested YText")
  }
}

///|
test "yarray_nested_array" {
  let doc = Doc::new(1UL)
  let outer = doc.get_array("outer")
  let inner = outer.insert_array(doc, 0)
  inner.push(doc, Any::Int(99L))
  match outer.get_array(doc, 0) {
    Some(inner2) => {
      debug_assert(inner2.len(doc) == 1, "inner len 1")
      match inner2.get(doc, 0) {
        Some(v) => debug_assert(any_eq(v, Any::Int(99L)), "inner[0] == 99")
        None => debug_assert(false, "missing inner[0]")
      }
    }
    None => debug_assert(false, "expected nested YArray")
  }
}

///|
test "yarray_nested_map" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  let m = a.insert_map(doc, 0)
  m.set(doc, "name", Any::Str("pion"))
  match a.get_map(doc, 0) {
    Some(m2) => match m2.get(doc, "name") {
      Some(v) => debug_assert(any_eq(v, Any::Str("pion")), "nested map val")
      None => debug_assert(false, "missing key")
    }
    None => debug_assert(false, "expected nested YMap")
  }
}

///|
test "yarray_nested_sync_across_docs" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let a1 = d1.get_array("a")
  let t1 = a1.insert_text(d1, 0)
  t1.insert(d1, 0, "hello")
  sync_pair(d1, d2)
  match d2.get_array("a").get_text(d2, 0) {
    Some(t2) => {
      debug_assert(t2.to_string(d2) == "hello", "synced nested text")
      t2.push(d2, " world")
    }
    None => debug_assert(false, "missing nested text on d2")
  }
  sync_pair(d1, d2)
  debug_assert(t1.to_string(d1) == "hello world", "nested text edited back")
}

///|
test "yarray_concurrent_insert_same_index" {
  let d1 = Doc::new(5UL)
  let d2 = Doc::new(15UL)
  d1.get_array("a").push(d1, Any::Str("left"))
  d2.get_array("a").push(d2, Any::Str("right"))
  sync_pair(d1, d2)
  let o1 = d1.get_array("a").to_array(d1)
  let o2 = d2.get_array("a").to_array(d2)
  debug_assert(o1.length() == 2 && o2.length() == 2, "both len 2")
  debug_assert(any_eq(o1[0], Any::Str("left")) && any_eq(o1[1], Any::Str("right")), "client 5 before 15")
  debug_assert(any_eq(o2[0], Any::Str("left")) && any_eq(o2[1], Any::Str("right")), "converged")
}

///|
test "yarray_concurrent_insert_and_delete" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let vals : Array[Any] = Array::new()
  vals.push(Any::Int(1L))
  vals.push(Any::Int(2L))
  vals.push(Any::Int(3L))
  d1.get_array("a").insert_range(d1, 0, vals)
  sync_pair(d1, d2)
  d1.get_array("a").delete(d1, 1, 1) // delete 2
  d2.get_array("a").insert(d2, 2, Any::Int(99L)) // insert 99 after 2
  sync_pair(d1, d2)
  let o1 = d1.get_array("a").to_array(d1)
  let o2 = d2.get_array("a").to_array(d2)
  debug_assert(o1.length() == 3 && o2.length() == 3, "len 3")
  debug_assert(any_eq(o1[0], Any::Int(1L)) && any_eq(o1[1], Any::Int(99L)) && any_eq(o1[2], Any::Int(3L)), "order")
  debug_assert(any_eq(o2[0], Any::Int(1L)) && any_eq(o2[1], Any::Int(99L)) && any_eq(o2[2], Any::Int(3L)), "converged")
}

///|
test "yarray_delete_all_then_reinsert" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  a.push(doc, Any::Int(1L))
  a.push(doc, Any::Int(2L))
  a.delete(doc, 0, 2)
  debug_assert(a.len(doc) == 0, "empty")
  a.push(doc, Any::Int(42L))
  debug_assert(a.len(doc) == 1, "len 1")
  match a.get(doc, 0) {
    Some(v) => debug_assert(any_eq(v, Any::Int(42L)), "42")
    None => debug_assert(false, "missing 42")
  }
}

///|
test "yarray_mixed_any_values" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  a.push(doc, Any::Null)
  a.push(doc, Any::Bool(false))
  a.push(doc, Any::Float(2.5))
  a.push(doc, Any::Str("ok"))
  let out = a.to_array(doc)
  debug_assert(out.length() == 4, "len 4")
  debug_assert(any_eq(out[0], Any::Null), "null")
  debug_assert(any_eq(out[1], Any::Bool(false)), "false")
  debug_assert(any_eq(out[2], Any::Float(2.5)), "2.5")
  debug_assert(any_eq(out[3], Any::Str("ok")), "ok")
}

///|
test "yarray_split_multi_element_item_on_delete" {
  let doc = Doc::new(1UL)
  let a = doc.get_array("a")
  let vals : Array[Any] = Array::new()
  vals.push(Any::Int(10L))
  vals.push(Any::Int(20L))
  vals.push(Any::Int(30L))
  vals.push(Any::Int(40L))
  a.insert_range(doc, 0, vals)
  a.delete(doc, 1, 2) // delete 20, 30 from middle of ContentAny
  let out = a.to_array(doc)
  debug_assert(out.length() == 2, "len 2")
  debug_assert(any_eq(out[0], Any::Int(10L)) && any_eq(out[1], Any::Int(40L)), "10, 40")
}

// --- YMap tests (13) ---

///|
test "ymap_empty" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  debug_assert(m.len(doc) == 0, "empty")
  debug_assert(!m.contains_key(doc, "a"), "no key a")
}

///|
test "ymap_set_and_get" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.set(doc, "k1", Any::Int(100L))
  m.set(doc, "k2", Any::Str("val"))
  debug_assert(m.len(doc) == 2, "len 2")
  debug_assert(m.contains_key(doc, "k1"), "has k1")
  match m.get(doc, "k1") {
    Some(v) => debug_assert(any_eq(v, Any::Int(100L)), "k1 == 100")
    None => debug_assert(false, "missing k1")
  }
}

///|
test "ymap_overwrite_key" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.set(doc, "x", Any::Int(1L))
  m.set(doc, "x", Any::Int(2L))
  m.set(doc, "x", Any::Int(3L))
  debug_assert(m.len(doc) == 1, "still len 1")
  match m.get(doc, "x") {
    Some(v) => debug_assert(any_eq(v, Any::Int(3L)), "x == 3")
    None => debug_assert(false, "missing x")
  }
}

///|
test "ymap_delete_key" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.set(doc, "a", Any::Int(1L))
  m.set(doc, "b", Any::Int(2L))
  m.delete(doc, "a")
  debug_assert(!m.contains_key(doc, "a"), "a deleted")
  debug_assert(m.contains_key(doc, "b"), "b present")
  debug_assert(m.len(doc) == 1, "len 1")
}

///|
test "ymap_delete_then_set_again" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.set(doc, "a", Any::Int(1L))
  m.delete(doc, "a")
  m.set(doc, "a", Any::Int(2L))
  debug_assert(m.contains_key(doc, "a"), "a restored")
  match m.get(doc, "a") {
    Some(v) => debug_assert(any_eq(v, Any::Int(2L)), "a == 2")
    None => debug_assert(false, "missing a")
  }
}

///|
test "ymap_delete_missing_key_noop" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.delete(doc, "nonexistent")
  debug_assert(m.len(doc) == 0, "still empty")
}

///|
test "ymap_keys_sorted" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  m.set(doc, "charlie", Any::Int(3L))
  m.set(doc, "alpha", Any::Int(1L))
  m.set(doc, "bravo", Any::Int(2L))
  let ks = m.keys(doc)
  debug_assert(ks.length() == 3, "3 keys")
  debug_assert(ks[0] == "alpha" && ks[1] == "bravo" && ks[2] == "charlie", "sorted keys")
}

///|
test "ymap_nested_text" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  let t = m.set_text(doc, "notes")
  t.insert(doc, 0, "hello map")
  match m.get_text(doc, "notes") {
    Some(t2) => debug_assert(t2.to_string(doc) == "hello map", "nested text")
    None => debug_assert(false, "missing nested text")
  }
}

///|
test "ymap_nested_array" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("m")
  let a = m.set_array(doc, "items")
  a.push(doc, Any::Str("one"))
  match m.get_array(doc, "items") {
    Some(a2) => debug_assert(a2.len(doc) == 1, "nested array len 1")
    None => debug_assert(false, "missing nested array")
  }
}

///|
test "ymap_nested_map" {
  let doc = Doc::new(1UL)
  let m = doc.get_map("root")
  let sub = m.set_map(doc, "child")
  sub.set(doc, "deep", Any::Bool(true))
  match m.get_map(doc, "child") {
    Some(sub2) => match sub2.get(doc, "deep") {
      Some(v) => debug_assert(any_eq(v, Any::Bool(true)), "deep true")
      None => debug_assert(false, "missing deep")
    }
    None => debug_assert(false, "missing child map")
  }
}

///|
test "ymap_concurrent_same_key_higher_client_wins" {
  let d1 = Doc::new(10UL)
  let d2 = Doc::new(20UL)
  d1.get_map("m").set(d1, "k", Any::Str("from10"))
  d2.get_map("m").set(d2, "k", Any::Str("from20"))
  sync_pair(d1, d2)
  match d1.get_map("m").get(d1, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("from20")), "d1: client 20 wins")
    None => debug_assert(false, "d1 missing k")
  }
  match d2.get_map("m").get(d2, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("from20")), "d2: client 20 wins")
    None => debug_assert(false, "d2 missing k")
  }
}

///|
test "ymap_concurrent_update_vs_delete" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_map("m").set(d1, "k", Any::Str("init"))
  sync_pair(d1, d2)
  d1.get_map("m").delete(d1, "k")
  d2.get_map("m").set(d2, "k", Any::Str("updated"))
  sync_pair(d1, d2)
  match d1.get_map("m").get(d1, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("updated")), "concurrent set survives delete of old")
    None => debug_assert(false, "d1 missing updated")
  }
  match d2.get_map("m").get(d2, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("updated")), "d2 has updated")
    None => debug_assert(false, "d2 missing updated")
  }
}

///|
test "ymap_nested_sync_across_docs" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let sub1 = d1.get_map("m").set_map(d1, "sub")
  sub1.set(d1, "a", Any::Int(1L))
  sync_pair(d1, d2)
  match d2.get_map("m").get_map(d2, "sub") {
    Some(sub2) => sub2.set(d2, "b", Any::Int(2L))
    None => debug_assert(false, "missing sub on d2")
  }
  sync_pair(d1, d2)
  debug_assert(sub1.len(d1) == 2, "sub1 has both keys")
  match sub1.get(d1, "b") {
    Some(v) => debug_assert(any_eq(v, Any::Int(2L)), "b == 2")
    None => debug_assert(false, "missing b")
  }
}
