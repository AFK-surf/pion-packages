///| Wasm32 smoke entry for the `crdt` package.

import "crdt"

///|
pub fn smoke() -> Int {
  let d1 = crdt::Doc::new(1UL)
  let d2 = crdt::Doc::new(2UL)
  let t1 = d1.get_text("doc")
  t1.insert(d1, 0, "Hello, ")
  let m1 = d1.get_map("meta")
  m1.set(d1, "ver", crdt::Any::Int(1L))
  let a1 = d1.get_array("items")
  a1.push(d1, crdt::Any::Str("wasm"))

  let t2 = d2.get_text("doc")
  t2.insert(d2, 0, "Pion!")

  let u1 = d1.encode_state_as_update()
  let u2 = d2.encode_state_as_update()
  match d1.apply_update(u2) {
    Ok(_) => ()
    Err(_) => return 1
  }
  match d2.apply_update(u1) {
    Ok(_) => ()
    Err(_) => return 2
  }
  let s1 = t1.to_string(d1)
  let s2 = t2.to_string(d2)
  if s1 == s2 && s1 == "Hello, Pion!" {
    s1.length() + u1.length()
  } else {
    0
  }
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
