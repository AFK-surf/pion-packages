///| Core identifier and error types for the `crdt` package.

///| Unique operation identifier `(client, clock)` following Yjs / YATA.
pub val struct Id {
  pub client : UInt64
  pub clock : UInt64
}

///| Construct a new `Id`.
#verify
pub fn Id::new(client : UInt64, clock : UInt64) -> Id {
  Id::{ client: client, clock: clock }
}

///| Equality comparison for `Id`.
#verify
pub fn Id::eq(self : Id, other : Id) -> Bool {
  self.client == other.client && self.clock == other.clock
}

///| Lexicographic comparison for `Id` (client first, then clock).
#verify
pub fn Id::cmp(self : Id, other : Id) -> Int {
  if self.client < other.client {
    -1
  } else if self.client > other.client {
    1
  } else if self.clock < other.clock {
    -1
  } else if self.clock > other.clock {
    1
  } else {
    0
  }
}

///| Error returned by binary decoding, update application, or protocol operations.
pub struct CrdtError {
  pub code : String
  pub message : String
}

///| Construct a new `CrdtError`.
pub fn CrdtError::new(code : String, message : String) -> CrdtError {
  CrdtError::{ code: code, message: message }
}

///| Convert a non-negative `Int` to `UInt64`.
#verify
pub fn int_to_u64(n : Int) -> UInt64 {
  n.to_int64().to_uint64()
}

///| Placeholder error for stubbed functions.
pub fn stub_err() -> CrdtError {
  CrdtError::{ code: "UNIMPLEMENTED", message: "not implemented yet" }
}
