///| lib0-compatible binary encoder, decoder, and `Any` value codec.

///| JSON-like dynamic value supported by lib0 and Yjs (`ContentAny`).
pub enum Any {
  Undefined
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  BigInt(Int64)
  Str(String)
  Binary(Bytes)
  Arr(Array[Any])
  Obj(Map[String, Any])
}

///| Compare two `Bytes` buffers for byte-for-byte equality.
pub fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Structural equality for `Any`.
pub fn any_eq(a : Any, b : Any) -> Bool {
  match (a, b) {
    (Any::Undefined, Any::Undefined) => true
    (Any::Null, Any::Null) => true
    (Any::Bool(x), Any::Bool(y)) => x == y
    (Any::Int(x), Any::Int(y)) => x == y
    (Any::Float(x), Any::Float(y)) => x == y
    (Any::BigInt(x), Any::BigInt(y)) => x == y
    (Any::Str(x), Any::Str(y)) => x == y
    (Any::Binary(x), Any::Binary(y)) => bytes_eq(x, y)
    (Any::Arr(xs), Any::Arr(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !any_eq(xs[i], ys[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (Any::Obj(xm), Any::Obj(ym)) => {
      if xm.length() != ym.length() {
        return false
      }
      let ks = xm.keys()
      let mut i = 0
      while i < ks.length() {
        let k = ks[i]
        match (xm.get(k), ym.get(k)) {
          (Some(xv), Some(yv)) => {
            if !any_eq(xv, yv) {
              return false
            }
          }
          _ => return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///| Deterministic canonical string representation for `Any` (useful for hashing/testing).
pub fn any_to_canonical_string(a : Any) -> String {
  match a {
    Any::Undefined => "undefined"
    Any::Null => "null"
    Any::Bool(v) => if v { "true" } else { "false" }
    Any::Int(v) => v.to_string()
    Any::Float(v) => v.to_string()
    Any::BigInt(v) => v.to_string() + "n"
    Any::Str(s) => "\"" + s + "\""
    Any::Binary(b) => "bin:" + bytes_to_hex(b)
    Any::Arr(xs) => {
      let sb = StringBuilder::new()
      sb.write_string("[")
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(any_to_canonical_string(xs[i]))
        i = i + 1
      }
      sb.write_string("]")
      sb.to_string()
    }
    Any::Obj(m) => {
      let ks = m.keys()
      sort_strings(ks)
      let sb = StringBuilder::new()
      sb.write_string("{")
      let mut i = 0
      while i < ks.length() {
        if i > 0 {
          sb.write_string(",")
        }
        let k = ks[i]
        sb.write_string(k)
        sb.write_string(":")
        match m.get(k) {
          Some(v) => sb.write_string(any_to_canonical_string(v))
          None => sb.write_string("undefined")
        }
        i = i + 1
      }
      sb.write_string("}")
      sb.to_string()
    }
  }
}

///| In-place lexicographic sort for `Array[String]`.
pub fn sort_strings(arr : Array[String]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

// --- Pure IEEE 754 float64 / float32 bit codecs (Native + Wasm32 portable) ---

///| Convert `Double` to IEEE 754 binary64 bit pattern (`UInt64`).
fn f64_to_bits(v : Double) -> UInt64 {
  // Check NaN
  if v != v {
    return 0x7ff8000000000000UL
  }
  // Handle zero (distinguish +0.0 vs -0.0 via 1.0 / v < 0.0)
  if v == 0.0 {
    if 1.0 / v < 0.0 {
      return 0x8000000000000000UL
    } else {
      return 0UL
    }
  }
  let mut sign : UInt64 = 0UL
  let mut x = v
  if x < 0.0 {
    sign = 1UL << 63
    x = -x
  }
  // Check +Inf
  if x > 1.7976931348623157e308 {
    return sign | 0x7ff0000000000000UL
  }
  // Normalize x into [1.0, 2.0)
  let mut exp = 0
  // Fast coarse scaling
  while x >= 4294967296.0 {
    x = x / 4294967296.0
    exp = exp + 32
  }
  while x >= 256.0 {
    x = x / 256.0
    exp = exp + 8
  }
  while x >= 2.0 {
    x = x / 2.0
    exp = exp + 1
  }
  while x < 2.3283064365386963e-10 && exp > -1022 {
    x = x * 4294967296.0
    exp = exp - 32
  }
  while x < 0.00390625 && exp > -1022 {
    x = x * 256.0
    exp = exp - 8
  }
  while x < 1.0 && exp > -1022 {
    x = x * 2.0
    exp = exp - 1
  }
  if exp <= -1022 && x < 1.0 {
    // Subnormal
    let scaled = x * 4503599627370496.0 // 2^52
    let mant = scaled.to_int64().to_uint64()
    return sign | (mant & 0x000fffffffffffffUL)
  }
  let biased_exp = int_to_u64(exp + 1023)
  // Extract 52-bit mantissa from (x - 1.0) * 2^52
  let frac = (x - 1.0) * 4503599627370496.0
  let mant = frac.to_int64().to_uint64()
  sign | ((biased_exp & 0x7ffUL) << 52) | (mant & 0x000fffffffffffffUL)
}

///| Convert IEEE 754 binary64 bit pattern (`UInt64`) to `Double`.
fn bits_to_f64(bits : UInt64) -> Double {
  let sign_bit = (bits >> 63) & 1UL
  let exp_bits = ((bits >> 52) & 0x7ffUL).to_int()
  let mant_bits = bits & 0x000fffffffffffffUL
  if exp_bits == 0x7ff {
    if mant_bits != 0UL {
      return 0.0 / 0.0 // NaN
    }
    let inf = 1.0 / 0.0
    return if sign_bit == 1UL { -inf } else { inf }
  }
  if exp_bits == 0 && mant_bits == 0UL {
    return if sign_bit == 1UL { -0.0 } else { 0.0 }
  }
  let mut acc = 0.0
  let mut exp = 0
  if exp_bits == 0 {
    // Subnormal
    acc = mant_bits.to_int64().to_double() / 4503599627370496.0
    exp = -1022
  } else {
    acc = 1.0 + mant_bits.to_int64().to_double() / 4503599627370496.0
    exp = exp_bits - 1023
  }
  // Scale acc by 2^exp
  while exp >= 32 {
    acc = acc * 4294967296.0
    exp = exp - 32
  }
  while exp >= 8 {
    acc = acc * 256.0
    exp = exp - 8
  }
  while exp > 0 {
    acc = acc * 2.0
    exp = exp - 1
  }
  while exp <= -32 {
    acc = acc / 4294967296.0
    exp = exp + 32
  }
  while exp <= -8 {
    acc = acc / 256.0
    exp = exp + 8
  }
  while exp < 0 {
    acc = acc / 2.0
    exp = exp + 1
  }
  if sign_bit == 1UL {
    -acc
  } else {
    acc
  }
}

///| Convert `Double` to IEEE 754 binary32 bit pattern (lower 32 bits of `UInt64`).
fn f32_to_bits(v : Double) -> UInt64 {
  let b64 = f64_to_bits(v)
  let sign = (b64 >> 63) & 1UL
  let exp64 = ((b64 >> 52) & 0x7ffUL).to_int()
  let mant64 = b64 & 0x000fffffffffffffUL
  if exp64 == 0x7ff {
    if mant64 != 0UL {
      return (sign << 31) | 0x7fc00000UL
    }
    return (sign << 31) | 0x7f800000UL
  }
  if exp64 == 0 && mant64 == 0UL {
    return sign << 31
  }
  let exp = exp64 - 1023
  if exp > 127 {
    return (sign << 31) | 0x7f800000UL
  }
  if exp < -149 {
    return sign << 31
  }
  if exp < -126 {
    // Subnormal f32
    let shift = -126 - exp
    let full_mant = mant64 | 0x0010000000000000UL
    let total_shift = 29 + shift
    let mant32 = full_mant >> total_shift
    return (sign << 31) | (mant32 & 0x7fffffUL)
  }
  let biased32 = int_to_u64(exp + 127)
  // Round-to-nearest-even from 52 bits to 23 bits (drop 29 bits)
  let half = 1UL << 28
  let rem = mant64 & ((1UL << 29) - 1UL)
  let mut mant32 = mant64 >> 29
  if rem > half || (rem == half && (mant32 & 1UL) == 1UL) {
    mant32 = mant32 + 1UL
    if mant32 == 0x800000UL {
      mant32 = 0UL
      let next_exp = biased32 + 1UL
      if next_exp >= 255UL {
        return (sign << 31) | 0x7f800000UL
      }
      return (sign << 31) | (next_exp << 23)
    }
  }
  (sign << 31) | ((biased32 & 0xffUL) << 23) | (mant32 & 0x7fffffUL)
}

///| Convert IEEE 754 binary32 bit pattern to `Double`.
fn bits_to_f32(bits : UInt64) -> Double {
  let sign = (bits >> 31) & 1UL
  let exp32 = ((bits >> 23) & 0xffUL).to_int()
  let mant32 = bits & 0x7fffffUL
  if exp32 == 0xff {
    if mant32 != 0UL {
      return 0.0 / 0.0
    }
    let inf = 1.0 / 0.0
    return if sign == 1UL { -inf } else { inf }
  }
  if exp32 == 0 && mant32 == 0UL {
    return if sign == 1UL { -0.0 } else { 0.0 }
  }
  if exp32 == 0 {
    // Subnormal
    let base = mant32.to_int64().to_double() / 8388608.0
    let mut r = base
    let mut e = -126
    while e <= -32 {
      r = r / 4294967296.0
      e = e + 32
    }
    while e < 0 {
      r = r / 2.0
      e = e + 1
    }
    return if sign == 1UL { -r } else { r }
  }
  let exp64 = int_to_u64(exp32 - 127 + 1023)
  let bits64 = (sign << 63) | (exp64 << 52) | (mant32 << 29)
  bits_to_f64(bits64)
}

///| Check whether `v` can be represented losslessly as IEEE 754 float32.
fn is_exact_f32(v : Double) -> Bool {
  if v != v {
    return false
  }
  bits_to_f32(f32_to_bits(v)) == v
}

// --- Encoder ---

///| Growable binary encoder compatible with `lib0/encoding`.
pub struct Encoder {
  pub buf : Array[Int]
}

///| Create an empty `Encoder`.
pub fn Encoder::new() -> Encoder {
  Encoder::{ buf: Array::new() }
}

///| Return current byte length.
pub fn Encoder::len(self : Encoder) -> Int {
  self.buf.length()
}

///| Finalize encoded bytes into an immutable `Bytes` buffer.
pub fn Encoder::to_bytes(self : Encoder) -> Bytes {
  let n = self.buf.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = self.buf[i].to_byte()
    i = i + 1
  }
  out
}

///| Write an unsigned 8-bit integer.
pub fn Encoder::write_uint8(self : Encoder, v : Int) -> Unit {
  self.buf.push(v & 0xff)
}

///| Write a little-endian unsigned 16-bit integer.
pub fn Encoder::write_uint16(self : Encoder, v : Int) -> Unit {
  self.buf.push(v & 0xff)
  self.buf.push((v >> 8) & 0xff)
}

///| Write a little-endian unsigned 32-bit integer.
pub fn Encoder::write_uint32(self : Encoder, v : UInt64) -> Unit {
  self.buf.push((v & 0xffUL).to_int())
  self.buf.push(((v >> 8) & 0xffUL).to_int())
  self.buf.push(((v >> 16) & 0xffUL).to_int())
  self.buf.push(((v >> 24) & 0xffUL).to_int())
}

///| Write a big-endian unsigned 32-bit integer.
pub fn Encoder::write_uint32_be(self : Encoder, v : UInt64) -> Unit {
  self.buf.push(((v >> 24) & 0xffUL).to_int())
  self.buf.push(((v >> 16) & 0xffUL).to_int())
  self.buf.push(((v >> 8) & 0xffUL).to_int())
  self.buf.push((v & 0xffUL).to_int())
}

///| Write an unsigned variable-length integer (LEB128 7-bit).
pub fn Encoder::write_var_uint(self : Encoder, v : UInt64) -> Unit {
  let mut n = v
  while n > 0x7fUL {
    self.buf.push((0x80UL | (n & 0x7fUL)).to_int())
    n = n >> 7
  }
  self.buf.push((n & 0x7fUL).to_int())
}

///| Write a signed variable-length integer (lib0 format: bit 6 = sign, bit 7 = cont).
pub fn Encoder::write_var_int(self : Encoder, v : Int64) -> Unit {
  let is_neg = v < 0L
  let mut mag : UInt64 = if is_neg {
    (0L - v).to_uint64()
  } else {
    v.to_uint64()
  }
  let mut first = (mag & 0x3fUL).to_int()
  if is_neg {
    first = first | 0x40
  }
  mag = mag >> 6
  if mag > 0UL {
    first = first | 0x80
  }
  self.buf.push(first)
  while mag > 0UL {
    let mut b = (mag & 0x7fUL).to_int()
    mag = mag >> 7
    if mag > 0UL {
      b = b | 0x80
    }
    self.buf.push(b)
  }
}

///| Write raw bytes without a length prefix.
pub fn Encoder::write_bytes(self : Encoder, data : Bytes) -> Unit {
  let n = data.length()
  let mut i = 0
  while i < n {
    self.buf.push(data[i].to_int())
    i = i + 1
  }
}

///| Write length-prefixed raw bytes (`varuint` length + payload).
pub fn Encoder::write_var_bytes(self : Encoder, data : Bytes) -> Unit {
  self.write_var_uint(int_to_u64(data.length()))
  self.write_bytes(data)
}

///| Write length-prefixed UTF-8 string (`varuint` byte length + UTF-8 bytes).
pub fn Encoder::write_var_string(self : Encoder, s : String) -> Unit {
  let n = s.length()
  self.write_var_uint(int_to_u64(n))
  let mut i = 0
  while i < n {
    self.buf.push(s.code_unit_at(i))
    i = i + 1
  }
}

///| Write an IEEE 754 big-endian 32-bit float (encoded from `Double`).
pub fn Encoder::write_float32(self : Encoder, v : Double) -> Unit {
  let bits = f32_to_bits(v)
  self.write_uint32_be(bits)
}

///| Write an IEEE 754 big-endian 64-bit float.
pub fn Encoder::write_float64(self : Encoder, v : Double) -> Unit {
  let bits = f64_to_bits(v)
  self.buf.push(((bits >> 56) & 0xffUL).to_int())
  self.buf.push(((bits >> 48) & 0xffUL).to_int())
  self.buf.push(((bits >> 40) & 0xffUL).to_int())
  self.buf.push(((bits >> 32) & 0xffUL).to_int())
  self.buf.push(((bits >> 24) & 0xffUL).to_int())
  self.buf.push(((bits >> 16) & 0xffUL).to_int())
  self.buf.push(((bits >> 8) & 0xffUL).to_int())
  self.buf.push((bits & 0xffUL).to_int())
}

///| Write a big-endian signed 64-bit integer.
pub fn Encoder::write_bigint64(self : Encoder, v : Int64) -> Unit {
  let bits = v.to_uint64()
  self.buf.push(((bits >> 56) & 0xffUL).to_int())
  self.buf.push(((bits >> 48) & 0xffUL).to_int())
  self.buf.push(((bits >> 40) & 0xffUL).to_int())
  self.buf.push(((bits >> 32) & 0xffUL).to_int())
  self.buf.push(((bits >> 24) & 0xffUL).to_int())
  self.buf.push(((bits >> 16) & 0xffUL).to_int())
  self.buf.push(((bits >> 8) & 0xffUL).to_int())
  self.buf.push((bits & 0xffUL).to_int())
}

///| Write a lib0 `Any` value.
pub fn Encoder::write_any(self : Encoder, value : Any) -> Unit {
  match value {
    Any::Undefined => self.write_uint8(127)
    Any::Null => self.write_uint8(126)
    Any::Int(n) => {
      if n >= -2147483647L && n <= 2147483647L {
        self.write_uint8(125)
        self.write_var_int(n)
      } else {
        self.write_uint8(123)
        self.write_float64(n.to_double())
      }
    }
    Any::Float(f) => {
      if is_exact_f32(f) {
        self.write_uint8(124)
        self.write_float32(f)
      } else {
        self.write_uint8(123)
        self.write_float64(f)
      }
    }
    Any::BigInt(n) => {
      self.write_uint8(122)
      self.write_bigint64(n)
    }
    Any::Bool(b) => self.write_uint8(if b { 120 } else { 121 })
    Any::Str(s) => {
      self.write_uint8(119)
      self.write_var_string(s)
    }
    Any::Obj(m) => {
      self.write_uint8(118)
      let ks = m.keys()
      self.write_var_uint(int_to_u64(ks.length()))
      let mut i = 0
      while i < ks.length() {
        let k = ks[i]
        self.write_var_string(k)
        match m.get(k) {
          Some(v) => self.write_any(v)
          None => self.write_uint8(127)
        }
        i = i + 1
      }
    }
    Any::Arr(xs) => {
      self.write_uint8(117)
      self.write_var_uint(int_to_u64(xs.length()))
      let mut i = 0
      while i < xs.length() {
        self.write_any(xs[i])
        i = i + 1
      }
    }
    Any::Binary(b) => {
      self.write_uint8(116)
      self.write_var_bytes(b)
    }
  }
}

// --- Decoder ---

///| Binary decoder compatible with `lib0/decoding`.
pub struct Decoder {
  pub data : Bytes
  pub mut pos : Int
}

///| Create a `Decoder` over `Bytes`.
pub fn Decoder::new(data : Bytes) -> Decoder {
  Decoder::{ data: data, pos: 0 }
}

///| Return true if unread bytes remain.
pub fn Decoder::has_content(self : Decoder) -> Bool {
  self.pos < self.data.length()
}

///| Return remaining unread byte count.
pub fn Decoder::remaining(self : Decoder) -> Int {
  self.data.length() - self.pos
}

///| Read an unsigned 8-bit integer.
pub fn Decoder::read_uint8(self : Decoder) -> Result[Int, CrdtError] {
  if self.pos >= self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading uint8"))
  }
  let b = self.data[self.pos].to_int()
  self.pos = self.pos + 1
  Ok(b)
}

///| Read a little-endian unsigned 16-bit integer.
pub fn Decoder::read_uint16(self : Decoder) -> Result[Int, CrdtError] {
  if self.pos + 2 > self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading uint16"))
  }
  let b0 = self.data[self.pos].to_int()
  let b1 = self.data[self.pos + 1].to_int()
  self.pos = self.pos + 2
  Ok(b0 | (b1 << 8))
}

///| Read a little-endian unsigned 32-bit integer.
pub fn Decoder::read_uint32(self : Decoder) -> Result[UInt64, CrdtError] {
  if self.pos + 4 > self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading uint32"))
  }
  let b0 = int_to_u64(self.data[self.pos].to_int())
  let b1 = int_to_u64(self.data[self.pos + 1].to_int())
  let b2 = int_to_u64(self.data[self.pos + 2].to_int())
  let b3 = int_to_u64(self.data[self.pos + 3].to_int())
  self.pos = self.pos + 4
  Ok(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
}

///| Read a big-endian unsigned 32-bit integer.
pub fn Decoder::read_uint32_be(self : Decoder) -> Result[UInt64, CrdtError] {
  if self.pos + 4 > self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading uint32_be"))
  }
  let b0 = int_to_u64(self.data[self.pos].to_int())
  let b1 = int_to_u64(self.data[self.pos + 1].to_int())
  let b2 = int_to_u64(self.data[self.pos + 2].to_int())
  let b3 = int_to_u64(self.data[self.pos + 3].to_int())
  self.pos = self.pos + 4
  Ok((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

///| Read an unsigned variable-length integer.
pub fn Decoder::read_var_uint(self : Decoder) -> Result[UInt64, CrdtError] {
  let len = self.data.length()
  let mut num : UInt64 = 0UL
  let mut shift = 0
  while self.pos < len {
    let r = self.data[self.pos].to_int()
    self.pos = self.pos + 1
    if shift >= 64 {
      return Err(CrdtError::new("OVERFLOW", "varuint overflow"))
    }
    num = num | (int_to_u64(r & 0x7f) << shift)
    if (r & 0x80) == 0 {
      return Ok(num)
    }
    shift = shift + 7
  }
  Err(CrdtError::new("EOF", "unexpected end of buffer reading varuint"))
}

///| Read a signed variable-length integer (lib0 format).
pub fn Decoder::read_var_int(self : Decoder) -> Result[Int64, CrdtError] {
  let len = self.data.length()
  if self.pos >= len {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading varint"))
  }
  let first = self.data[self.pos].to_int()
  self.pos = self.pos + 1
  let is_neg = (first & 0x40) != 0
  let mut mag : UInt64 = int_to_u64(first & 0x3f)
  if (first & 0x80) == 0 {
    let signed = mag.to_int64()
    return Ok(if is_neg { 0L - signed } else { signed })
  }
  let mut shift = 6
  while self.pos < len {
    let r = self.data[self.pos].to_int()
    self.pos = self.pos + 1
    if shift >= 64 {
      return Err(CrdtError::new("OVERFLOW", "varint overflow"))
    }
    mag = mag | (int_to_u64(r & 0x7f) << shift)
    if (r & 0x80) == 0 {
      let signed = mag.to_int64()
      return Ok(if is_neg { 0L - signed } else { signed })
    }
    shift = shift + 7
  }
  Err(CrdtError::new("EOF", "unexpected end of buffer reading varint"))
}

///| Validate that `b[start..end)` is strictly valid UTF-8 (RFC 3629; rejects surrogates and overlong encodings).
pub fn is_valid_utf8_range(b : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let c0 = b[i].to_int()
    if c0 < 0x80 {
      i = i + 1
    } else if c0 >= 0xc2 && c0 <= 0xdf {
      if i + 1 >= end {
        return false
      }
      let c1 = b[i + 1].to_int()
      if (c1 & 0xc0) != 0x80 {
        return false
      }
      i = i + 2
    } else if c0 >= 0xe0 && c0 <= 0xef {
      if i + 2 >= end {
        return false
      }
      let c1 = b[i + 1].to_int()
      let c2 = b[i + 2].to_int()
      if (c1 & 0xc0) != 0x80 || (c2 & 0xc0) != 0x80 {
        return false
      }
      if c0 == 0xe0 && c1 < 0xa0 {
        return false
      }
      if c0 == 0xed && c1 >= 0xa0 {
        return false
      }
      i = i + 3
    } else if c0 >= 0xf0 && c0 <= 0xf4 {
      if i + 3 >= end {
        return false
      }
      let c1 = b[i + 1].to_int()
      let c2 = b[i + 2].to_int()
      let c3 = b[i + 3].to_int()
      if (c1 & 0xc0) != 0x80 || (c2 & 0xc0) != 0x80 || (c3 & 0xc0) != 0x80 {
        return false
      }
      if c0 == 0xf0 && c1 < 0x90 {
        return false
      }
      if c0 == 0xf4 && c1 > 0x8f {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Validate that `b` is strictly valid UTF-8 (RFC 3629; rejects surrogates and overlong encodings).
pub fn is_valid_utf8(b : Bytes) -> Bool {
  is_valid_utf8_range(b, 0, b.length())
}

///| Read `len` raw bytes.
pub fn Decoder::read_bytes(self : Decoder, len : Int) -> Result[Bytes, CrdtError] {
  if len < 0 || self.pos.to_int64() + len.to_int64() > self.data.length().to_int64() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading bytes"))
  }
  let slice = self.data.slice(self.pos, self.pos + len)
  self.pos = self.pos + len
  Ok(slice)
}

///| Read length-prefixed raw bytes.
pub fn Decoder::read_var_bytes(self : Decoder) -> Result[Bytes, CrdtError] {
  let len_u = match self.read_var_uint() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let rem = (self.data.length() - self.pos).to_int64().to_uint64()
  if len_u > rem {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading var bytes"))
  }
  let len = len_u.to_int()
  self.read_bytes(len)
}

///| Read length-prefixed UTF-8 string.
pub fn Decoder::read_var_string(self : Decoder) -> Result[String, CrdtError] {
  let len_u = match self.read_var_uint() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let rem = (self.data.length() - self.pos).to_int64().to_uint64()
  if len_u > rem {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading var string"))
  }
  let len = len_u.to_int()
  if len == 0 {
    return Ok("")
  }
  let start = self.pos
  let end = start + len
  if !is_valid_utf8_range(self.data, start, end) {
    return Err(CrdtError::new("INVALID_UTF8", "invalid UTF-8 sequence"))
  }
  self.pos = end
  Ok(self.data.slice(start, end).to_string())
}

///| Read an IEEE 754 big-endian 32-bit float as `Double`.
pub fn Decoder::read_float32(self : Decoder) -> Result[Double, CrdtError] {
  let bits = match self.read_uint32_be() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(bits_to_f32(bits))
}

///| Read an IEEE 754 big-endian 64-bit float.
pub fn Decoder::read_float64(self : Decoder) -> Result[Double, CrdtError] {
  if self.pos + 8 > self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading float64"))
  }
  let mut bits : UInt64 = 0UL
  let mut i = 0
  while i < 8 {
    bits = (bits << 8) | int_to_u64(self.data[self.pos + i].to_int())
    i = i + 1
  }
  self.pos = self.pos + 8
  Ok(bits_to_f64(bits))
}

///| Read a big-endian signed 64-bit integer.
pub fn Decoder::read_bigint64(self : Decoder) -> Result[Int64, CrdtError] {
  if self.pos + 8 > self.data.length() {
    return Err(CrdtError::new("EOF", "unexpected end of buffer reading bigint64"))
  }
  let mut bits : UInt64 = 0UL
  let mut i = 0
  while i < 8 {
    bits = (bits << 8) | int_to_u64(self.data[self.pos + i].to_int())
    i = i + 1
  }
  self.pos = self.pos + 8
  Ok(bits.to_int64())
}

///| Read a lib0 `Any` value with an explicit recursion depth bound.
fn Decoder::read_any_depth(self : Decoder, depth : Int) -> Result[Any, CrdtError] {
  if depth > 128 {
    return Err(CrdtError::new("DEPTH_LIMIT", "lib0 Any nesting depth exceeded"))
  }
  let tag = match self.read_uint8() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match tag {
    127 => Ok(Any::Undefined)
    126 => Ok(Any::Null)
    125 => match self.read_var_int() {
      Ok(v) => Ok(Any::Int(v))
      Err(e) => Err(e)
    }
    124 => match self.read_float32() {
      Ok(v) => Ok(Any::Float(v))
      Err(e) => Err(e)
    }
    123 => match self.read_float64() {
      Ok(v) => Ok(Any::Float(v))
      Err(e) => Err(e)
    }
    122 => match self.read_bigint64() {
      Ok(v) => Ok(Any::BigInt(v))
      Err(e) => Err(e)
    }
    121 => Ok(Any::Bool(false))
    120 => Ok(Any::Bool(true))
    119 => match self.read_var_string() {
      Ok(s) => Ok(Any::Str(s))
      Err(e) => Err(e)
    }
    118 => {
      let count_u = match self.read_var_uint() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rem = (self.data.length() - self.pos).to_int64().to_uint64()
      if count_u > rem {
        return Err(CrdtError::new("EOF", "object key count exceeds remaining buffer"))
      }
      let count = count_u.to_int()
      let m : Map[String, Any] = Map::new()
      let mut i = 0
      while i < count {
        let k = match self.read_var_string() {
          Ok(s) => s
          Err(e) => return Err(e)
        }
        let v = match self.read_any_depth(depth + 1) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        m.set(k, v)
        i = i + 1
      }
      Ok(Any::Obj(m))
    }
    117 => {
      let count_u = match self.read_var_uint() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rem = (self.data.length() - self.pos).to_int64().to_uint64()
      if count_u > rem {
        return Err(CrdtError::new("EOF", "array element count exceeds remaining buffer"))
      }
      let count = count_u.to_int()
      let arr : Array[Any] = Array::new()
      let mut i = 0
      while i < count {
        let v = match self.read_any_depth(depth + 1) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        arr.push(v)
        i = i + 1
      }
      Ok(Any::Arr(arr))
    }
    116 => match self.read_var_bytes() {
      Ok(b) => Ok(Any::Binary(b))
      Err(e) => Err(e)
    }
    _ => Err(CrdtError::new("INVALID_ANY_TAG", "unknown lib0 Any tag"))
  }
}

///| Read a lib0 `Any` value.
pub fn Decoder::read_any(self : Decoder) -> Result[Any, CrdtError] {
  self.read_any_depth(0)
}

// --- Hex helpers ---

///| Encode a 4-bit nibble `0..=15` as lowercase ASCII hex byte.
#verify
pub fn hex_nibble_char(n : Int) -> Int {
  if n < 10 {
    48 + n
  } else {
    87 + n
  }
}

///| Parse an ASCII hex byte (`0-9`, `a-f`, `A-F`) into `0..=15`, or `-1` if invalid.
#verify
pub fn parse_hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///| Encode `Bytes` as lowercase hexadecimal string (useful for diagnostics & tests).
pub fn bytes_to_hex(b : Bytes) -> String {
  let n = b.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let byte = b[i].to_int()
    sb.write_byte(hex_nibble_char((byte >> 4) & 0xf).to_byte())
    sb.write_byte(hex_nibble_char(byte & 0xf).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Decode a hexadecimal string into `Bytes`.
pub fn hex_to_bytes(hex : String) -> Result[Bytes, CrdtError] {
  let n = hex.length()
  if n % 2 != 0 {
    return Err(CrdtError::new("INVALID_HEX", "odd hex string length"))
  }
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n {
    let hi = parse_hex_nibble(hex.code_unit_at(i))
    let lo = parse_hex_nibble(hex.code_unit_at(i + 1))
    if hi < 0 || lo < 0 {
      return Err(CrdtError::new("INVALID_HEX", "invalid hex character"))
    }
    out[i / 2] = ((hi << 4) | lo).to_byte()
    i = i + 2
  }
  Ok(out)
}
