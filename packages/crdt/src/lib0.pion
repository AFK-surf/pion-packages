///| lib0-compatible binary encoder, decoder, and `Any` value codec.

///| JSON-like dynamic value supported by lib0 and Yjs (`ContentAny`).
pub enum Any {
  Undefined
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  BigInt(Int64)
  Str(String)
  Binary(Bytes)
  Arr(Array[Any])
  Obj(Map[String, Any])
}

///| Structural equality for `Any`.
pub fn any_eq(a : Any, b : Any) -> Bool {
  let _ = a
  let _ = b
  false
}

///| Deterministic canonical string representation for `Any` (useful for hashing/testing).
pub fn any_to_canonical_string(a : Any) -> String {
  let _ = a
  ""
}

///| Growable binary encoder compatible with `lib0/encoding`.
pub struct Encoder {
  pub buf : Array[Int]
}

///| Create an empty `Encoder`.
pub fn Encoder::new() -> Encoder {
  Encoder::{ buf: Array::new() }
}

///| Return current byte length.
pub fn Encoder::len(self : Encoder) -> Int {
  self.buf.length()
}

///| Finalize encoded bytes into an immutable `Bytes` buffer.
pub fn Encoder::to_bytes(self : Encoder) -> Bytes {
  let _ = self
  Bytes::new(0)
}

///| Write an unsigned 8-bit integer.
pub fn Encoder::write_uint8(self : Encoder, v : Int) -> Unit {
  let _ = self
  let _ = v
}

///| Write a little-endian unsigned 16-bit integer.
pub fn Encoder::write_uint16(self : Encoder, v : Int) -> Unit {
  let _ = self
  let _ = v
}

///| Write a little-endian unsigned 32-bit integer.
pub fn Encoder::write_uint32(self : Encoder, v : UInt64) -> Unit {
  let _ = self
  let _ = v
}

///| Write a big-endian unsigned 32-bit integer.
pub fn Encoder::write_uint32_be(self : Encoder, v : UInt64) -> Unit {
  let _ = self
  let _ = v
}

///| Write an unsigned variable-length integer (LEB128 7-bit).
pub fn Encoder::write_var_uint(self : Encoder, v : UInt64) -> Unit {
  let _ = self
  let _ = v
}

///| Write a signed variable-length integer (lib0 format: bit 6 = sign, bit 7 = cont).
pub fn Encoder::write_var_int(self : Encoder, v : Int64) -> Unit {
  let _ = self
  let _ = v
}

///| Write raw bytes without a length prefix.
pub fn Encoder::write_bytes(self : Encoder, data : Bytes) -> Unit {
  let _ = self
  let _ = data
}

///| Write length-prefixed raw bytes (`varuint` length + payload).
pub fn Encoder::write_var_bytes(self : Encoder, data : Bytes) -> Unit {
  let _ = self
  let _ = data
}

///| Write length-prefixed UTF-8 string (`varuint` byte length + UTF-8 bytes).
pub fn Encoder::write_var_string(self : Encoder, s : String) -> Unit {
  let _ = self
  let _ = s
}

///| Write an IEEE 754 big-endian 32-bit float (encoded from `Double`).
pub fn Encoder::write_float32(self : Encoder, v : Double) -> Unit {
  let _ = self
  let _ = v
}

///| Write an IEEE 754 big-endian 64-bit float.
pub fn Encoder::write_float64(self : Encoder, v : Double) -> Unit {
  let _ = self
  let _ = v
}

///| Write a big-endian signed 64-bit integer.
pub fn Encoder::write_bigint64(self : Encoder, v : Int64) -> Unit {
  let _ = self
  let _ = v
}

///| Write a lib0 `Any` value.
pub fn Encoder::write_any(self : Encoder, value : Any) -> Unit {
  let _ = self
  let _ = value
}

///| Binary decoder compatible with `lib0/decoding`.
pub struct Decoder {
  pub data : Bytes
  pub mut pos : Int
}

///| Create a `Decoder` over `Bytes`.
pub fn Decoder::new(data : Bytes) -> Decoder {
  Decoder::{ data: data, pos: 0 }
}

///| Return true if unread bytes remain.
pub fn Decoder::has_content(self : Decoder) -> Bool {
  self.pos < self.data.length()
}

///| Return remaining unread byte count.
pub fn Decoder::remaining(self : Decoder) -> Int {
  self.data.length() - self.pos
}

///| Read an unsigned 8-bit integer.
pub fn Decoder::read_uint8(self : Decoder) -> Result[Int, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a little-endian unsigned 16-bit integer.
pub fn Decoder::read_uint16(self : Decoder) -> Result[Int, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a little-endian unsigned 32-bit integer.
pub fn Decoder::read_uint32(self : Decoder) -> Result[UInt64, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a big-endian unsigned 32-bit integer.
pub fn Decoder::read_uint32_be(self : Decoder) -> Result[UInt64, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read an unsigned variable-length integer.
pub fn Decoder::read_var_uint(self : Decoder) -> Result[UInt64, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a signed variable-length integer (lib0 format).
pub fn Decoder::read_var_int(self : Decoder) -> Result[Int64, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read `len` raw bytes.
pub fn Decoder::read_bytes(self : Decoder, len : Int) -> Result[Bytes, CrdtError] {
  let _ = self
  let _ = len
  Err(stub_err())
}

///| Read length-prefixed raw bytes.
pub fn Decoder::read_var_bytes(self : Decoder) -> Result[Bytes, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read length-prefixed UTF-8 string.
pub fn Decoder::read_var_string(self : Decoder) -> Result[String, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read an IEEE 754 big-endian 32-bit float as `Double`.
pub fn Decoder::read_float32(self : Decoder) -> Result[Double, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read an IEEE 754 big-endian 64-bit float.
pub fn Decoder::read_float64(self : Decoder) -> Result[Double, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a big-endian signed 64-bit integer.
pub fn Decoder::read_bigint64(self : Decoder) -> Result[Int64, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Read a lib0 `Any` value.
pub fn Decoder::read_any(self : Decoder) -> Result[Any, CrdtError] {
  let _ = self
  Err(stub_err())
}

///| Encode `Bytes` as lowercase hexadecimal string (useful for diagnostics & tests).
pub fn bytes_to_hex(b : Bytes) -> String {
  let _ = b
  ""
}

///| Decode a hexadecimal string into `Bytes`.
pub fn hex_to_bytes(hex : String) -> Result[Bytes, CrdtError] {
  let _ = hex
  Err(stub_err())
}
