///| Collaborative `Doc`, YATA integration, search markers, and shared types (`YText`, `YArray`, `YMap`).

///| Value handle to a `YText` inside a `Doc`.
pub val struct YText {
  pub type_id : Int
}

///| Value handle to a `YArray` inside a `Doc`.
pub val struct YArray {
  pub type_id : Int
}

///| Value handle to a `YMap` inside a `Doc`.
pub val struct YMap {
  pub type_id : Int
}

///| Collaborative CRDT document compatible with Yjs v1 wire protocol.
pub struct Doc {
  pub client_id : UInt64
  pub store : BlockStore
  pub types : Array[YTypeNode]
  pub share : Map[String, Int]
  mut last_root_name : String
  mut last_root_tid : Int
}

///| Create a new `Doc` with the given `client_id`.
pub fn Doc::new(client_id : UInt64) -> Doc {
  Doc::{
    client_id: client_id,
    store: BlockStore::new(),
    types: Array::new(),
    share: Map::new(),
    last_root_name: "",
    last_root_tid: -1,
  }
}

///| Return this document's client ID.
pub fn Doc::client_id(self : Doc) -> UInt64 {
  self.client_id
}

///| Ensure a root shared type exists in `doc.share` and return its `type_id`.
pub fn Doc::ensure_root_type(self : Doc, name : String, tr : TypeRef) -> Int {
  if self.last_root_tid >= 0 && self.last_root_name == name {
    return self.last_root_tid
  }
  match self.share.get(name) {
    Some(tid) => {
      self.last_root_name = name
      self.last_root_tid = tid
      tid
    }
    None => {
      let tid = self.types.length()
      self.types.push(YTypeNode::new(tr, Some(name)))
      self.share.set(name, tid)
      self.last_root_name = name
      self.last_root_tid = tid
      tid
    }
  }
}

///| Allocate a new nested `YTypeNode` (not in `doc.share`) and return its `type_id`.
pub fn Doc::alloc_nested_type(self : Doc, tr : TypeRef) -> Int {
  let tid = self.types.length()
  self.types.push(YTypeNode::new(tr, None))
  tid
}

///| Allocate a new nested `YTypeNode` preserving raw Yjs type ref (0..6) and optional XML nodeName.
pub fn Doc::alloc_nested_type_raw(
  self : Doc,
  raw_ref : Int,
  node_name : Option[String],
) -> Int {
  let tid = self.types.length()
  let node = YTypeNode::new(int_to_type_ref(raw_ref), None)
  node.raw_type_ref = raw_ref
  node.node_name = node_name
  self.types.push(node)
  tid
}

///| Get or create a root-level `YText` by name.
pub fn Doc::get_text(self : Doc, name : String) -> YText {
  YText::{ type_id: self.ensure_root_type(name, TypeRef::YTextRef) }
}

///| Get or create a root-level `YArray` by name.
pub fn Doc::get_array(self : Doc, name : String) -> YArray {
  YArray::{ type_id: self.ensure_root_type(name, TypeRef::YArrayRef) }
}

///| Get or create a root-level `YMap` by name.
pub fn Doc::get_map(self : Doc, name : String) -> YMap {
  YMap::{ type_id: self.ensure_root_type(name, TypeRef::YMapRef) }
}

///| Return the current `StateVector` of this document.
pub fn Doc::state_vector(self : Doc) -> StateVector {
  let sv = StateVector::new()
  let cids = self.store.client_ids
  let clist = self.store.client_list
  let n_clients = cids.length()
  if n_clients == 0 {
    return sv
  }
  let i_clocks = self.store.item_clock
  let i_lens = self.store.item_len_u64
  let mut i = 0
  while i < n_clients {
    let clk = clist[i].get_clock(i_clocks, i_lens)
    if clk > 0UL {
      sv.set(cids[i], clk)
    }
    i = i + 1
  }
  sv
}

///| Encode this document's state vector in Yjs v1 format.
pub fn Doc::encode_state_vector(self : Doc) -> Bytes {
  encode_state_vector(self)
}

///| Encode the entire document state as a Yjs v1 binary update.
pub fn Doc::encode_state_as_update(self : Doc) -> Bytes {
  match encode_state_as_update(self, None) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Encode only operations missing from binary `target_sv` as a Yjs v1 binary update.
pub fn Doc::encode_state_as_update_from(
  self : Doc,
  target_sv : Bytes,
) -> Result[Bytes, CrdtError] {
  encode_state_as_update(self, Some(target_sv))
}

///| Encode only operations missing from in-memory `target_sv` as a Yjs v1 binary update (avoids SV binary encode/decode).
pub fn Doc::encode_state_as_update_from_sv(
  self : Doc,
  target_sv : StateVector,
) -> Result[Bytes, CrdtError] {
  encode_state_as_update_sv(self, target_sv)
}

///| Apply a Yjs v1 binary update to this document.
///| Wire framing, UTF-8, overflow, and duplicate-client errors fail atomically before mutating `self` on multi-client updates;
///| doc-state semantic rejections (e.g., cross-container origins or hostile overlap splices) return `Err` and may leave earlier ready items applied.
pub fn Doc::apply_update(self : Doc, update : Bytes) -> Result[Unit, CrdtError] {
  apply_update(self, update)
}

// --- Internal YATA / Store Operations ---

///| Compare two `Option[Id]` values for equality.
#verify
pub fn opt_id_eq(a : Option[Id], b : Option[Id]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.eq(y)
    _ => false
  }
}

///| YATA same-origin conflict tie-breaker: lower client ID is ordered before higher client ID.
pub fn yata_same_origin_before(lhs_client : UInt64, rhs_client : UInt64) -> Bool {
  lhs_client < rhs_client
}

///| Split item `item_idx` at `diff` clocks (`0 < diff < item.len_u64`), returning the new right item index.
pub fn Doc::split_item_u64(self : Doc, item_idx : Int, diff : UInt64) -> Int {
  let item = self.store.items[item_idx]
  let right_c = content_split_in_place_u64(item, diff)
  let right_len_u64 = item.len_u64 - diff
  let right_len = if right_len_u64 > 2147483647UL {
    2147483647
  } else {
    right_len_u64.to_int()
  }
  let left_len = if diff > 2147483647UL { 2147483647 } else { diff.to_int() }
  let right_id = Id::{ client: item.id.client, clock: item.id.clock + diff }
  let mut left_raw_any : Option[Array[Bytes]] = None
  let mut right_raw_any : Option[Array[Bytes]] = None
  match item.raw_any_bytes {
    Some(raws) => {
      let off_i = diff.to_int()
      let lr : Array[Bytes] = Array::new()
      let rr : Array[Bytes] = Array::new()
      let mut ri = 0
      while ri < raws.length() {
        if ri < off_i {
          lr.push(raws[ri])
        } else {
          rr.push(raws[ri])
        }
        ri = ri + 1
      }
      left_raw_any = Some(lr)
      right_raw_any = Some(rr)
    }
    None => ()
  }
  let old_right = item.right
  let right_item = Item::{
    id: right_id,
    len: right_len,
    len_u64: right_len_u64,
    left: item_idx,
    right: old_right,
    has_origin: true,
    origin_client: item.id.client,
    origin_clock: item.id.clock + diff - 1UL,
    has_right_origin: item.has_right_origin,
    right_origin_client: item.right_origin_client,
    right_origin_clock: item.right_origin_clock,
    parent_id: item.parent_id,
    parent_key: item.parent_key,
    has_parent_item_id: item.has_parent_item_id,
    parent_item_client: item.parent_item_client,
    parent_item_clock: item.parent_item_clock,
    parent_sub: item.parent_sub,
    deleted: item.deleted,
    countable: item.countable,
    is_gc: item.is_gc,
    content: right_c,
    raw_any_bytes: right_raw_any,
  }
  let right_idx = self.store.push_item(right_item)
  item.len = left_len
  item.len_u64 = diff
  item.raw_any_bytes = left_raw_any
  item.right = right_idx
  self.store.item_right[item_idx] = right_idx
  self.store.item_len_u64[item_idx] = diff
  if !item.deleted && item.countable {
    self.store.item_live_len[item_idx] = left_len
  }
  if old_right >= 0 {
    self.store.items[old_right].left = right_idx
    self.store.item_left[old_right] = right_idx
  }
  // Insert right_idx into client's chunked block store right after item_idx
  let cs = self.store.get_or_create_client(item.id.client)
  cs.insert_after_clock(
    self.store.item_clock,
    self.store.item_len_u64,
    item.id.clock,
    right_idx,
  )
  // Update parent._map if this was the active map entry
  if right_item.parent_id >= 0 && right_item.right < 0 {
    match right_item.parent_sub {
      Some(sub) => self.types[right_item.parent_id].map.set(sub, right_idx)
      None => ()
    }
  }
  right_idx
}

///| Split item `item_idx` at `diff` clocks (`0 < diff < item.len`), returning the new right item index.
pub fn Doc::split_item(self : Doc, item_idx : Int, diff : Int) -> Int {
  self.split_item_u64(item_idx, int_to_u64(diff))
}

///| Return the arena index of the item whose clock starts exactly at `(client, clock)` (splitting if needed).
fn Doc::get_item_clean_start_cc(
  self : Doc,
  client : UInt64,
  clock : UInt64,
) -> Int {
  let idx = self.store.get_item_idx_cc(client, clock)
  if idx < 0 {
    return -1
  }
  let iclk = self.store.item_clock[idx]
  if iclk < clock {
    self.split_item_u64(idx, clock - iclk)
  } else {
    idx
  }
}

///| Return the arena index of the item whose clock starts exactly at `id.clock` (splitting if needed).
pub fn Doc::get_item_clean_start(self : Doc, id : Id) -> Int {
  self.get_item_clean_start_cc(id.client, id.clock)
}

///| Return the arena index of the item whose last clock equals `(client, clock)` (splitting if needed).
fn Doc::get_item_clean_end_cc(
  self : Doc,
  client : UInt64,
  clock : UInt64,
) -> Int {
  let idx = self.store.get_item_idx_cc(client, clock)
  if idx < 0 {
    return -1
  }
  let iclk = self.store.item_clock[idx]
  let ilen = self.store.item_len_u64[idx]
  let last_clock = if ilen <= 1UL {
    iclk
  } else {
    u64_sat_add(iclk, ilen - 1UL)
  }
  if last_clock > clock {
    let diff = clock - iclk + 1UL
    let _ = self.split_item_u64(idx, diff)
    idx
  } else {
    idx
  }
}

///| Return the arena index of the item whose last clock equals `id.clock` (splitting if needed).
pub fn Doc::get_item_clean_end(self : Doc, id : Id) -> Int {
  self.get_item_clean_end_cc(id.client, id.clock)
}

///| Mark an item as deleted, updating parent length, DeleteSet, GC content, and nested children.
pub fn Doc::delete_item(self : Doc, item_idx : Int) -> Unit {
  let item = self.store.items[item_idx]
  if item.deleted {
    return
  }
  item.deleted = true
  self.store.item_live_len[item_idx] = 0
  if item.parent_id >= 0 && item.countable {
    match item.parent_sub {
      None => {
        let p = self.types[item.parent_id]
        p.length = p.length - item.len
      }
      Some(_) => ()
    }
  }
  self.store.delete_set.add(item.id.client, item.id.clock, item.len_u64)
  // Recursively delete children if this item holds a nested YType
  match item.content {
    Content::Type(tid) => {
      let child_node = self.types[tid]
      clear_markers(child_node)
      let mut cur = child_node.start
      while cur >= 0 {
        let next = self.store.item_right[cur]
        if !self.store.items[cur].deleted {
          self.delete_item(cur)
        }
        cur = next
      }
      let ks = child_node.map.keys()
      let mut i = 0
      while i < ks.length() {
        match child_node.map.get(ks[i]) {
          Some(m_idx) => {
            if !self.store.items[m_idx].deleted {
              self.delete_item(m_idx)
            }
          }
          None => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  // Yjs standard GC: replace deleted item's payload with ContentDeleted (preserving links & YATA origins)
  if !item.is_gc {
    item.content = Content::Deleted(item.len_u64)
    item.raw_any_bytes = None
  }
}

///| Try to merge `item_idx` into its immediate left neighbor (same client, contiguous clocks, same rightOrigin).
///| Returns true if merged (in which case `item_idx` is removed from `clients[client]`).
pub fn Doc::try_merge_with_left(self : Doc, item_idx : Int) -> Bool {
  let right = self.store.items[item_idx]
  let left_idx = right.left
  if left_idx < 0 || right.is_gc {
    return false
  }
  let left = self.store.items[left_idx]
  if left.is_gc || left.deleted != right.deleted {
    return false
  }
  if left.id.client != right.id.client {
    return false
  }
  if right.id.clock < left.id.clock || right.id.clock - left.id.clock != left.len_u64 {
    return false
  }
  if left.right != item_idx {
    return false
  }
  if !item_origin_eq_last_id(right, left) {
    return false
  }
  if !item_same_right_origin(left, right) {
    return false
  }
  if left.parent_id != right.parent_id {
    return false
  }
  match (left.parent_sub, right.parent_sub) {
    (None, None) => ()
    _ => return false
  }
  let merged_ok = match (left.content, right.content) {
    (Content::Str(ls), Content::Str(rs)) => {
      if ls.length() + rs.length() > 64 {
        false
      } else {
        left.content = Content::Str(ls + rs)
        true
      }
    }
    (Content::AnyList(la), Content::AnyList(ra)) => {
      if la.length() + ra.length() > 128 {
        false
      } else {
        let mut i = 0
        while i < ra.length() {
          la.push(ra[i])
          i = i + 1
        }
        true
      }
    }
    (Content::Deleted(ln), Content::Deleted(rn)) => {
      left.content = Content::Deleted(ln + rn)
      true
    }
    _ => false
  }
  if !merged_ok {
    return false
  }
  // Update search markers pointing to item_idx -> left_idx (and compact duplicate slot if left_idx is already marked)
  if left.parent_id >= 0 {
    let p = self.types[left.parent_id]
    let shift = if !left.deleted && left.countable { left.len } else { 0 }
    if p.last_marker_item == item_idx {
      p.last_marker_item = left_idx
      p.last_marker_idx = p.last_marker_idx - shift
    }
    let m_items = p.m_item
    let m_indices = p.m_index
    let m_ts = p.m_ts
    let mn = m_items.length()
    let mut write_i = 0
    let mut mi = 0
    while mi < mn {
      let mut it = m_items[mi]
      let mut idx = m_indices[mi]
      let ts = m_ts[mi]
      if it == item_idx {
        it = left_idx
        idx = idx - shift
      }
      if write_i > 0 && m_items[write_i - 1] == it && m_indices[write_i - 1] == idx {
        if ts > m_ts[write_i - 1] {
          m_ts[write_i - 1] = ts
        }
      } else {
        m_items[write_i] = it
        m_indices[write_i] = idx
        m_ts[write_i] = ts
        write_i = write_i + 1
      }
      mi = mi + 1
    }
    while m_items.length() > write_i {
      let _ = m_items.pop()
      let _ = m_indices.pop()
      let _ = m_ts.pop()
    }
  }
  let new_right = right.right
  left.right = new_right
  self.store.item_right[left_idx] = new_right
  if new_right >= 0 {
    self.store.items[new_right].left = left_idx
    self.store.item_left[new_right] = left_idx
  }
  left.len = left.len + right.len
  left.len_u64 = left.len_u64 + right.len_u64
  self.store.item_len_u64[left_idx] = left.len_u64
  if !left.deleted && left.countable {
    self.store.item_live_len[left_idx] = left.len
  }
  // Remove item_idx from client's block store (it is always the last element when newly appended)
  let cs = self.store.get_or_create_client(left.id.client)
  cs.pop_last(item_idx)
  if self.store.last_item_idx == item_idx {
    self.store.last_item_idx = left_idx
  }
  true
}

///| Integrate an unintegrated item `item_idx` into the document using the YATA algorithm.
///| `is_local` skips clearing search markers when the caller updates them explicitly.
pub fn Doc::integrate_item(self : Doc, item_idx : Int, is_local : Bool) -> Unit {
  self.integrate_item_resolved(item_idx, is_local, is_local)
}

///| Internal integration entry point allowing callers that already resolved & validated `(left, right)` to skip redundant lookups.
fn Doc::integrate_item_resolved(
  self : Doc,
  item_idx : Int,
  is_local : Bool,
  resolved_lr : Bool,
) -> Unit {
  let item = self.store.items[item_idx]
  if item.is_gc {
    self.store.add_item_to_client(item_idx)
    return
  }
  // Resolve left and right pointers from origin / right_origin if not already set (remote items)
  if !resolved_lr {
    if item.has_origin {
      let l = self.get_item_clean_end_cc(item.origin_client, item.origin_clock)
      item.left = l
      self.store.item_left[item_idx] = l
    } else {
      item.left = -1
      self.store.item_left[item_idx] = -1
    }
    if item.has_right_origin {
      let r = self.get_item_clean_start_cc(
        item.right_origin_client,
        item.right_origin_clock,
      )
      item.right = r
      self.store.item_right[item_idx] = r
    } else {
      item.right = -1
      self.store.item_right[item_idx] = -1
    }
  }
  // Resolve parent_id and parent_sub
  if item.parent_id < 0 {
    if item.left >= 0 {
      let l = self.store.items[item.left]
      item.parent_id = l.parent_id
      item.parent_sub = l.parent_sub
    } else if item.right >= 0 {
      let r = self.store.items[item.right]
      item.parent_id = r.parent_id
      item.parent_sub = r.parent_sub
    } else {
      match item.parent_key {
        Some(key) => {
          let tr = match item.parent_sub {
            Some(_) => TypeRef::YMapRef
            None => TypeRef::YTextRef
          }
          item.parent_id = self.ensure_root_type(key, tr)
        }
        None => {
          if item.has_parent_item_id {
            let pidx = self.store.get_item_idx_cc(
              item.parent_item_client,
              item.parent_item_clock,
            )
            if pidx >= 0 {
              match self.store.items[pidx].content {
                Content::Type(tid) => item.parent_id = tid
                _ => ()
              }
            }
          }
        }
      }
    }
  }

  let parent_id = item.parent_id
  if parent_id < 0 {
    // Parent not found (GC'd parent): turn into GC block
    item.is_gc = true
    item.deleted = true
    item.content = Content::Gc(item.len_u64)
    self.store.item_live_len[item_idx] = 0
    self.store.add_item_to_client(item_idx)
    return
  }

  let parent = self.types[parent_id]
  if !is_local && (parent.markers.length() > 0 || parent.m_item.length() > 0) {
    clear_markers(parent)
  }

  let i_lefts = self.store.item_left
  let i_rights = self.store.item_right

  // YATA conflict resolution (exact match with yjs/src/structs/Item.js; zero-alloc fast path)
  let has_conflict = (
    item.left < 0 && (item.right < 0 || i_lefts[item.right] >= 0)
  ) || (item.left >= 0 && i_rights[item.left] != item.right)

  if has_conflict {
    let mut left = item.left
    let mut o = if left >= 0 {
      i_rights[left]
    } else {
      match item.parent_sub {
        Some(sub) => {
          let mut cur = match parent.map.get(sub) {
            Some(v) => v
            None => -1
          }
          while cur >= 0 && i_lefts[cur] >= 0 {
            cur = i_lefts[cur]
          }
          cur
        }
        None => parent.start
      }
    }

    if o >= 0 && o != item.right {
      let visited = self.store.conflict_visited
      visited.clear()
      let mut conflict_start = 0
      let mut used_maps = false
      let mut before_map : Option[Map[Int, Bool]] = None
      let mut curr_map : Option[Map[Int, Bool]] = None

      while o >= 0 && o != item.right {
        visited.push(o)
        if used_maps {
          match (before_map, curr_map) {
            (Some(bm), Some(cm)) => {
              bm.set(o, true)
              cm.set(o, true)
            }
            _ => ()
          }
        }
        let o_item = self.store.items[o]
        if item_same_origin(item, o_item) {
          // Case 1: same origin -> lower client_id comes first
          if o_item.id.client < item.id.client {
            left = o
            conflict_start = visited.length()
            if used_maps {
              match curr_map {
                Some(cm) => cm.clear()
                None => ()
              }
            }
          } else if item_same_right_origin(item, o_item) {
            break
          }
        } else if o_item.has_origin {
          let o_orig_idx = self.store.get_item_idx_cc(
            o_item.origin_client,
            o_item.origin_clock,
          )
          if o_orig_idx >= 0 {
            let vlen = visited.length()
            let mut in_before = false
            let mut in_conflict = false
            if !used_maps && vlen > 32 {
              used_maps = true
              let bm = match self.store.conflict_before_map {
                Some(m) => {
                  m.clear()
                  m
                }
                None => {
                  let m : Map[Int, Bool] = Map::new()
                  self.store.conflict_before_map = Some(m)
                  m
                }
              }
              let cm = match self.store.conflict_curr_map {
                Some(m) => {
                  m.clear()
                  m
                }
                None => {
                  let m : Map[Int, Bool] = Map::new()
                  self.store.conflict_curr_map = Some(m)
                  m
                }
              }
              before_map = Some(bm)
              curr_map = Some(cm)
              let mut vi = 0
              while vi < vlen {
                let v = visited[vi]
                bm.set(v, true)
                if vi >= conflict_start {
                  cm.set(v, true)
                }
                vi = vi + 1
              }
            }
            if used_maps {
              match (before_map, curr_map) {
                (Some(bm), Some(cm)) => {
                  in_before = match bm.get(o_orig_idx) {
                    Some(_) => true
                    None => false
                  }
                  if in_before {
                    in_conflict = match cm.get(o_orig_idx) {
                      Some(_) => true
                      None => false
                    }
                  }
                }
                _ => ()
              }
            } else {
              let mut vi = 0
              while vi < vlen {
                if visited[vi] == o_orig_idx {
                  in_before = true
                  if vi >= conflict_start {
                    in_conflict = true
                  }
                  break
                }
                vi = vi + 1
              }
            }
            if in_before {
              // Case 2: o's origin is already in items_before_origin
              if !in_conflict {
                left = o
                conflict_start = vlen
                if used_maps {
                  match curr_map {
                    Some(cm) => cm.clear()
                    None => ()
                  }
                }
              }
            } else {
              break
            }
          } else {
            break
          }
        } else {
          break
        }
        o = i_rights[o]
      }
      if used_maps {
        match (before_map, curr_map) {
          (Some(bm), Some(cm)) => {
            bm.clear()
            cm.clear()
          }
          _ => ()
        }
      }
    }
    item.left = left
    i_lefts[item_idx] = left
  }

  // Reconnect left / right links and update parent.start or parent.map
  if item.left >= 0 {
    let r = i_rights[item.left]
    item.right = r
    i_rights[item_idx] = r
    self.store.items[item.left].right = item_idx
    i_rights[item.left] = item_idx
  } else {
    let r = match item.parent_sub {
      Some(sub) => {
        let mut cur = match parent.map.get(sub) {
          Some(v) => v
          None => -1
        }
        while cur >= 0 && i_lefts[cur] >= 0 {
          cur = i_lefts[cur]
        }
        cur
      }
      None => {
        let old_start = parent.start
        parent.start = item_idx
        old_start
      }
    }
    item.right = r
    i_rights[item_idx] = r
  }

  if item.right >= 0 {
    self.store.items[item.right].left = item_idx
    i_lefts[item.right] = item_idx
  } else {
    match item.parent_sub {
      Some(sub) => {
        parent.map.set(sub, item_idx)
        if item.left >= 0 {
          // New winning map value: delete the previous entry
          self.delete_item(item.left)
        }
      }
      None => ()
    }
  }

  // Adjust parent length
  match item.parent_sub {
    None => {
      if item.countable && !item.deleted {
        parent.length = parent.length + item.len
      }
    }
    Some(_) => ()
  }

  // Register in BlockStore
  self.store.add_item_to_client(item_idx)

  // Content-specific integration
  match item.content {
    Content::Type(tid) => {
      self.types[tid].item_idx = item_idx
    }
    Content::Format(_, _) => {
      parent.has_format = true
    }
    Content::Deleted(n) => {
      item.deleted = true
      self.store.item_live_len[item_idx] = 0
      self.store.delete_set.add(item.id.client, item.id.clock, n)
    }
    _ => ()
  }

  // Delete if parent item is already deleted, or if this map entry lost to a right sibling
  let parent_deleted = parent.item_idx >= 0 &&
  self.store.items[parent.item_idx].deleted
  let map_lost = match item.parent_sub {
    Some(_) => item.right >= 0
    None => false
  }
  if parent_deleted || map_lost {
    self.delete_item(item_idx)
  }
}

///| Clear all search markers (both sentinel array and flat parallel arrays).
fn clear_markers(parent : YTypeNode) -> Unit {
  if parent.markers.length() > 0 {
    parent.markers.clear()
  }
  if parent.m_item.length() > 0 {
    parent.m_item.clear()
    parent.m_index.clear()
    parent.m_ts.clear()
  }
  parent.last_marker = -1
  parent.last_marker_item = -1
  parent.last_marker_idx = 0
}

///| Update flat parallel search markers on `parent` after a local insert (`delta > 0`) or delete (`delta < 0`) at `index`.
fn update_markers(parent : YTypeNode, index : Int, delta : Int) -> Unit {
  if parent.markers.length() == 0 {
    if parent.m_item.length() > 0 || parent.last_marker_item >= 0 {
      clear_markers(parent)
    }
    return
  }
  let m_idx = parent.m_index
  let n = m_idx.length()
  if delta > 0 {
    if parent.last_marker_item >= 0 && parent.last_marker_idx >= index {
      parent.last_marker_idx = parent.last_marker_idx + delta
    }
    if n == 0 || m_idx[n - 1] < index {
      return
    }
    let mut lo = 0
    let mut hi = n - 1
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if m_idx[mid] < index {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let mut i = lo
    while i < n {
      m_idx[i] = m_idx[i] + delta
      i = i + 1
    }
  } else if delta < 0 {
    let del_end = index - delta
    if parent.last_marker_item >= 0 {
      if parent.last_marker_idx >= del_end {
        parent.last_marker_idx = parent.last_marker_idx + delta
      } else if parent.last_marker_idx >= index {
        parent.last_marker_item = -1
      }
    }
    if n == 0 || m_idx[n - 1] < index {
      return
    }
    let mut lo = 0
    let mut hi = n - 1
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if m_idx[mid] < index {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let m_it = parent.m_item
    let m_ts = parent.m_ts
    let mut write_i = lo
    let mut read_i = lo
    while read_i < n {
      let cur_i = m_idx[read_i]
      if cur_i >= del_end {
        m_it[write_i] = m_it[read_i]
        m_idx[write_i] = cur_i + delta
        m_ts[write_i] = m_ts[read_i]
        write_i = write_i + 1
      }
      read_i = read_i + 1
    }
    while m_it.length() > write_i {
      let _ = m_it.pop()
      let _ = m_idx.pop()
      let _ = m_ts.pop()
    }
  }
}

///| Record or refresh a search marker `(item_idx, index)` with uniform spatial spacing + LRU eviction (up to 192 markers).
fn record_marker(parent : YTypeNode, item_idx : Int, index : Int) -> Unit {
  if item_idx < 0 {
    return
  }
  if parent.markers.length() == 0 {
    if parent.m_item.length() > 0 {
      parent.m_item.clear()
      parent.m_index.clear()
      parent.m_ts.clear()
    }
    parent.markers.push(SearchMarker::{ item_idx: item_idx, index: index, timestamp: 0 })
  }
  parent.last_marker_item = item_idx
  parent.last_marker_idx = index
  if index <= 0 {
    return
  }
  let m_it = parent.m_item
  let m_idx = parent.m_index
  let m_ts = parent.m_ts
  parent.marker_clock = parent.marker_clock + 1
  let ts = parent.marker_clock
  let n = m_idx.length()
  if n == 0 {
    m_it.push(item_idx)
    m_idx.push(index)
    m_ts.push(ts)
    return
  }
  // Binary search for first pos with m_idx[pos] >= index
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if m_idx[mid] < index {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < n && m_idx[lo] == index {
    m_it[lo] = item_idx
    m_ts[lo] = ts
    return
  }
  // Enforce uniform spatial spacing without dragging existing anchors away from their region
  let mut min_gap = parent.length / 192
  if min_gap < 16 {
    min_gap = 16
  }
  if lo < n && m_idx[lo] - index < min_gap {
    m_ts[lo] = ts
    return
  }
  if lo > 0 && index - m_idx[lo - 1] < min_gap {
    m_ts[lo - 1] = ts
    return
  }
  if n < 192 {
    m_it.push(0)
    m_idx.push(0)
    m_ts.push(0)
    let mut k = n
    while k > lo {
      m_it[k] = m_it[k - 1]
      m_idx[k] = m_idx[k - 1]
      m_ts[k] = m_ts[k - 1]
      k = k - 1
    }
    m_it[lo] = item_idx
    m_idx[lo] = index
    m_ts[lo] = ts
    return
  }
  // LRU eviction: evict the oldest marker and shift into sorted position `lo`
  let mut old_pos = 0
  let mut old_ts = m_ts[0]
  let mut i = 1
  while i < n {
    let t = m_ts[i]
    if t < old_ts {
      old_ts = t
      old_pos = i
    }
    i = i + 1
  }
  if old_pos < lo {
    let dst = lo - 1
    let mut k = old_pos
    while k < dst {
      m_it[k] = m_it[k + 1]
      m_idx[k] = m_idx[k + 1]
      m_ts[k] = m_ts[k + 1]
      k = k + 1
    }
    m_it[dst] = item_idx
    m_idx[dst] = index
    m_ts[dst] = ts
  } else {
    let mut k = old_pos
    while k > lo {
      m_it[k] = m_it[k - 1]
      m_idx[k] = m_idx[k - 1]
      m_ts[k] = m_ts[k - 1]
      k = k - 1
    }
    m_it[lo] = item_idx
    m_idx[lo] = index
    m_ts[lo] = ts
  }
}

///| Unboxed `(left, right)` item index pair for `find_insert_pos` / `find_array_elem`.
val struct ItemPair {
  left : Int
  right : Int
}

///| Unboxed delete position `(cur_item, offset_in_item, cur_start_index)` without eager splitting.
val struct DeletePos {
  cur : Int
  off : Int
  cur_idx : Int
  left : Int
}

///| Find `(left_idx, right_idx)` at container `index`, splitting an item if `index` falls inside it.
fn Doc::find_insert_pos(self : Doc, type_id : Int, target : Int) -> ItemPair {
  let parent = self.types[type_id]
  let idx = if target < 0 {
    0
  } else if target > parent.length {
    parent.length
  } else {
    target
  }
  if idx == 0 {
    return ItemPair::{ left: -1, right: parent.start }
  }
  let i_lefts = self.store.item_left
  let i_rights = self.store.item_right
  let i_live = self.store.item_live_len

  let mut best_item = parent.start
  let mut best_idx = 0
  let mut best_dist = idx

  if parent.markers.length() == 0 {
    if parent.m_item.length() > 0 || parent.last_marker_item >= 0 {
      clear_markers(parent)
    }
  } else {
    let lm = parent.last_marker_item
    if lm >= 0 {
      let lm_ll = i_live[lm]
      if lm_ll > 0 {
        let lm_idx = parent.last_marker_idx
        let lm_end = lm_idx + lm_ll
        if idx == lm_end {
          return ItemPair::{ left: lm, right: i_rights[lm] }
        }
        if idx > lm_idx && idx < lm_end {
          let right_idx = self.split_item(lm, idx - lm_idx)
          record_marker(parent, right_idx, idx)
          return ItemPair::{ left: lm, right: right_idx }
        }
        if idx == lm_idx {
          let prev = i_lefts[lm]
          if prev >= 0 && i_live[prev] > 0 {
            return ItemPair::{ left: prev, right: lm }
          }
        }
        let d = if lm_idx > idx { lm_idx - idx } else { idx - lm_idx }
        if d < best_dist {
          best_dist = d
          best_item = lm
          best_idx = lm_idx
        }
      }
    }
    let m_idx = parent.m_index
    let n = m_idx.length()
    if n > 0 && best_dist > 32 {
      let m_it = parent.m_item
      let mut lo = 0
      let mut hi = n
      while lo < hi {
        let mid = lo + (hi - lo) / 2
        if m_idx[mid] < idx {
          lo = mid + 1
        } else {
          hi = mid
        }
      }
      if lo < n {
        let mi = m_idx[lo]
        let d = mi - idx
        if d < best_dist {
          best_dist = d
          best_item = m_it[lo]
          best_idx = mi
        }
      }
      if lo > 0 {
        let mi = m_idx[lo - 1]
        let d = idx - mi
        if d < best_dist {
          best_dist = d
          best_item = m_it[lo - 1]
          best_idx = mi
        }
      }
    }
  }

  let mut cur = best_item
  let mut cur_idx = best_idx
  let mut hops = 0

  // Walk backwards if marker is at or ahead of target (SoA arrays: zero Item RC ops)
  while cur >= 0 && cur_idx >= idx {
    let prev = i_lefts[cur]
    if prev < 0 {
      cur = parent.start
      cur_idx = 0
      break
    }
    cur = prev
    let ll = i_live[cur]
    if ll > 0 {
      cur_idx = cur_idx - ll
      hops = hops + 1
      if hops >= 128 {
        record_marker(parent, cur, cur_idx)
        hops = 0
      }
    }
  }

  // Walk forwards until reaching idx (SoA arrays: zero Item RC ops)
  let mut left = if cur >= 0 { i_lefts[cur] } else { -1 }
  hops = 0
  while cur >= 0 {
    let ll = i_live[cur]
    if ll > 0 {
      let next_idx = cur_idx + ll
      if next_idx > idx {
        if cur_idx < idx {
          let diff = idx - cur_idx
          let right_idx = self.split_item(cur, diff)
          record_marker(parent, right_idx, idx)
          return ItemPair::{ left: cur, right: right_idx }
        }
        record_marker(parent, cur, cur_idx)
        return ItemPair::{ left: left, right: cur }
      }
      hops = hops + 1
      if hops >= 128 {
        record_marker(parent, cur, cur_idx)
        hops = 0
      }
      cur_idx = next_idx
      if cur_idx == idx {
        record_marker(parent, cur, cur_idx - ll)
        return ItemPair::{ left: cur, right: i_rights[cur] }
      }
    } else {
      hops = hops + 1
    }
    left = cur
    cur = i_rights[cur]
  }
  ItemPair::{ left: left, right: -1 }
}

///| Locate `(cur, offset_in_cur, cur_start_idx, left_of_cur)` for deletion at `idx` without eagerly splitting or recording doomed markers.
fn Doc::find_delete_pos(self : Doc, type_id : Int, idx : Int) -> DeletePos {
  let parent = self.types[type_id]
  let i_lefts = self.store.item_left
  let i_rights = self.store.item_right
  let i_live = self.store.item_live_len

  if idx == 0 {
    let mut cur = parent.start
    let mut left = -1
    while cur >= 0 && i_live[cur] == 0 {
      left = cur
      cur = i_rights[cur]
    }
    return DeletePos::{ cur: cur, off: 0, cur_idx: 0, left: left }
  }

  let mut best_item = parent.start
  let mut best_idx = 0
  let mut best_dist = idx

  if parent.markers.length() == 0 {
    if parent.m_item.length() > 0 || parent.last_marker_item >= 0 {
      clear_markers(parent)
    }
  } else {
    let lm = parent.last_marker_item
    if lm >= 0 {
      let lm_ll = i_live[lm]
      if lm_ll > 0 {
        let lm_idx = parent.last_marker_idx
        let lm_end = lm_idx + lm_ll
        if idx >= lm_idx && idx < lm_end {
          return DeletePos::{
            cur: lm,
            off: idx - lm_idx,
            cur_idx: lm_idx,
            left: i_lefts[lm],
          }
        }
        let d = if lm_idx > idx { lm_idx - idx } else { idx - lm_idx }
        if d < best_dist {
          best_dist = d
          best_item = lm
          best_idx = lm_idx
        }
      }
    }
    let m_idx = parent.m_index
    let n = m_idx.length()
    if n > 0 && best_dist > 32 {
      let m_it = parent.m_item
      let mut lo = 0
      let mut hi = n
      while lo < hi {
        let mid = lo + (hi - lo) / 2
        if m_idx[mid] < idx {
          lo = mid + 1
        } else {
          hi = mid
        }
      }
      if lo < n {
        let mi = m_idx[lo]
        let d = mi - idx
        if d < best_dist {
          best_dist = d
          best_item = m_it[lo]
          best_idx = mi
        }
      }
      if lo > 0 {
        let mi = m_idx[lo - 1]
        let d = idx - mi
        if d < best_dist {
          best_dist = d
          best_item = m_it[lo - 1]
          best_idx = mi
        }
      }
    }
  }

  let mut cur = best_item
  let mut cur_idx = best_idx
  let mut hops = 0

  while cur >= 0 && cur_idx > idx {
    let prev = i_lefts[cur]
    if prev < 0 {
      cur = parent.start
      cur_idx = 0
      break
    }
    cur = prev
    let ll = i_live[cur]
    if ll > 0 {
      cur_idx = cur_idx - ll
      hops = hops + 1
      if hops >= 128 {
        record_marker(parent, cur, cur_idx)
        hops = 0
      }
    }
  }

  let mut left = if cur >= 0 { i_lefts[cur] } else { -1 }
  hops = 0
  while cur >= 0 {
    let ll = i_live[cur]
    if ll > 0 {
      let next_idx = cur_idx + ll
      if next_idx > idx {
        return DeletePos::{
          cur: cur,
          off: idx - cur_idx,
          cur_idx: cur_idx,
          left: left,
        }
      }
      hops = hops + 1
      if hops >= 128 {
        record_marker(parent, cur, cur_idx)
        hops = 0
      }
      cur_idx = next_idx
    } else {
      hops = hops + 1
    }
    left = cur
    cur = i_rights[cur]
  }
  DeletePos::{ cur: -1, off: 0, cur_idx: cur_idx, left: left }
}

///| Fast path for plain-text `YText::insert` (in-place merge <= 64B, automatic chunking > 128B, zero Option[Id] boxing).
fn Doc::insert_text_at(self : Doc, type_id : Int, index : Int, chunk : String) -> Int {
  let len = utf16_len(chunk)
  if len <= 0 {
    return -1
  }
  let pos = self.find_insert_pos(type_id, index)
  let mut left_idx = pos.left
  let mut right_idx = pos.right
  let i_rights = self.store.item_right
  while right_idx >= 0 && self.store.items[right_idx].deleted {
    left_idx = right_idx
    right_idx = i_rights[right_idx]
  }
  // Fast in-place merge for sequential typing (O(n) total, zero dead arena items, zero Content/Option[Id] boxing)
  if left_idx >= 0 && chunk.length() <= 64 {
    let left = self.store.items[left_idx]
    if !left.is_gc &&
    !left.deleted &&
    left.id.client == self.client_id &&
    left.right == right_idx &&
    left.parent_id == type_id &&
    item_right_origin_eq_idx(left, self.store.items, right_idx) {
      match (left.parent_sub, left.content) {
        (None, Content::Str(ls)) => {
          if ls.length() + chunk.length() <= 64 &&
          left.id.clock + left.len_u64 == self.store.get_clock(self.client_id) {
            let parent = self.types[type_id]
            let old_len = parent.length
            left.content = Content::Str(ls + chunk)
            left.len = left.len + len
            left.len_u64 = left.len_u64 + int_to_u64(len)
            self.store.item_live_len[left_idx] = left.len
            self.store.item_len_u64[left_idx] = left.len_u64
            parent.length = old_len + len
            if index < old_len {
              update_markers(parent, index, len)
            }
            return left_idx
          }
        }
        _ => ()
      }
    }
  }
  // Chunk large plain-text inserts (> 128B) into <= 128B UTF-8-safe contiguous items so later splits/backspaces stay O(1)
  // Skip chunking when parent container's carrier item is already deleted so the single-item path marks it deleted cleanly.
  let parent0 = self.types[type_id]
  let parent_deleted = parent0.item_idx >= 0 && self.store.items[parent0.item_idx].deleted
  let cbytes = chunk.length()
  if cbytes > 128 && !parent_deleted {
    let parent = parent0
    if index < parent.length {
      update_markers(parent, index, len)
    }
    let has_rorig = right_idx >= 0
    let rorig_c = if has_rorig { self.store.items[right_idx].id.client } else { 0UL }
    let rorig_k = if has_rorig { self.store.items[right_idx].id.clock } else { 0UL }
    let is_ascii = cbytes == len
    let mut cur_left = left_idx
    let mut cur_index = index
    let mut bpos = 0
    let mut last_idx = -1
    let mut clock = self.store.get_clock(self.client_id)
    let cs = self.store.get_or_create_client(self.client_id)
    let i_lefts = self.store.item_left
    while bpos < cbytes {
      let mut bend = bpos + 128
      if bend >= cbytes {
        bend = cbytes
      } else if !is_ascii {
        while bend > bpos && (chunk.code_unit_at(bend) & 0xc0) == 0x80 {
          bend = bend - 1
        }
        if bend == bpos {
          bend = bpos + 1
          while bend < cbytes && (chunk.code_unit_at(bend) & 0xc0) == 0x80 {
            bend = bend + 1
          }
        }
      }
      let seg = chunk.slice(bpos, bend)
      let seg_len = if is_ascii { bend - bpos } else { utf16_len(seg) }
      let seg_u64 = int_to_u64(seg_len)
      let has_orig = cur_left >= 0
      let mut orig_c = 0UL
      let mut orig_k = 0UL
      if has_orig {
        let li = self.store.items[cur_left]
        orig_c = li.id.client
        orig_k = if li.len_u64 <= 1UL {
          li.id.clock
        } else {
          u64_sat_add(li.id.clock, li.len_u64 - 1UL)
        }
      }
      let item = Item::{
        id: Id::{ client: self.client_id, clock: clock },
        len: seg_len,
        len_u64: seg_u64,
        left: cur_left,
        right: right_idx,
        has_origin: has_orig,
        origin_client: orig_c,
        origin_clock: orig_k,
        has_right_origin: has_rorig,
        right_origin_client: rorig_c,
        right_origin_clock: rorig_k,
        parent_id: type_id,
        parent_key: None,
        has_parent_item_id: false,
        parent_item_client: 0UL,
        parent_item_clock: 0UL,
        parent_sub: None,
        deleted: false,
        countable: true,
        is_gc: false,
        content: Content::Str(seg),
        raw_any_bytes: None,
      }
      let item_idx = self.store.push_item(item)
      if cur_left >= 0 {
        self.store.items[cur_left].right = item_idx
        i_rights[cur_left] = item_idx
      } else {
        parent.start = item_idx
      }
      cs.add_item(self.store.item_clock, item_idx)
      self.store.last_item_idx = item_idx
      cur_left = item_idx
      last_idx = item_idx
      cur_index = cur_index + seg_len
      clock = clock + seg_u64
      bpos = bend
    }
    if right_idx >= 0 && last_idx >= 0 {
      self.store.items[right_idx].left = last_idx
      i_lefts[right_idx] = last_idx
    }
    parent.length = parent.length + len
    if last_idx >= 0 {
      record_marker(parent, last_idx, cur_index - self.store.items[last_idx].len)
    }
    return last_idx
  }
  let has_orig = left_idx >= 0
  let mut orig_c = 0UL
  let mut orig_k = 0UL
  if has_orig {
    let li = self.store.items[left_idx]
    orig_c = li.id.client
    orig_k = if li.len_u64 <= 1UL {
      li.id.clock
    } else {
      u64_sat_add(li.id.clock, li.len_u64 - 1UL)
    }
  }
  let has_rorig = right_idx >= 0
  let rorig_c = if has_rorig { self.store.items[right_idx].id.client } else { 0UL }
  let rorig_k = if has_rorig { self.store.items[right_idx].id.clock } else { 0UL }
  let clock = self.store.get_clock(self.client_id)
  let item = Item::{
    id: Id::{ client: self.client_id, clock: clock },
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    has_origin: has_orig,
    origin_client: orig_c,
    origin_clock: orig_k,
    has_right_origin: has_rorig,
    right_origin_client: rorig_c,
    right_origin_clock: rorig_k,
    parent_id: type_id,
    parent_key: None,
    has_parent_item_id: false,
    parent_item_client: 0UL,
    parent_item_clock: 0UL,
    parent_sub: None,
    deleted: false,
    countable: true,
    is_gc: false,
    content: Content::Str(chunk),
    raw_any_bytes: None,
  }
  let item_idx = self.store.push_item(item)
  let parent = self.types[type_id]
  if index < parent.length {
    update_markers(parent, index, len)
  }
  // Local plain-text insert has exact adjacent (left_idx, right_idx) with no YATA conflict
  if left_idx >= 0 {
    self.store.items[left_idx].right = item_idx
    self.store.item_right[left_idx] = item_idx
  } else {
    parent.start = item_idx
  }
  if right_idx >= 0 {
    self.store.items[right_idx].left = item_idx
    self.store.item_left[right_idx] = item_idx
  }
  parent.length = parent.length + len
  self.store.add_item_to_client(item_idx)
  if parent.item_idx >= 0 && self.store.items[parent.item_idx].deleted {
    self.delete_item(item_idx)
  } else {
    record_marker(parent, item_idx, index)
  }
  item_idx
}

///| Insert a local `Content` item into sequence container `type_id` at `index`.
///| When `skip_deleted` is true (Yjs YText `minimizeAttributeChanges`), advances past tombstones.
fn Doc::insert_content_at(
  self : Doc,
  type_id : Int,
  index : Int,
  content : Content,
  skip_deleted : Bool,
) -> Int {
  let len = content_len(content)
  if len <= 0 {
    return -1
  }
  let pos = self.find_insert_pos(type_id, index)
  let mut left_idx = pos.left
  let mut right_idx = pos.right
  if skip_deleted {
    let i_rights = self.store.item_right
    while right_idx >= 0 && self.store.items[right_idx].deleted {
      left_idx = right_idx
      right_idx = i_rights[right_idx]
    }
  }
  // Fast in-place merge for sequential Content::Str typing (O(n) total, zero dead arena items)
  if left_idx >= 0 {
    match content {
      Content::Str(rs) => {
        let left = self.store.items[left_idx]
        if !left.is_gc &&
        !left.deleted &&
        left.id.client == self.client_id &&
        left.right == right_idx &&
        left.parent_id == type_id &&
        item_right_origin_eq_idx(left, self.store.items, right_idx) {
          match (left.parent_sub, left.content) {
            (None, Content::Str(ls)) => {
              if ls.length() + rs.length() <= 64 &&
              left.id.clock + left.len_u64 == self.store.get_clock(self.client_id) {
                let parent = self.types[type_id]
                let old_len = parent.length
                left.content = Content::Str(ls + rs)
                left.len = left.len + len
                left.len_u64 = left.len_u64 + int_to_u64(len)
                self.store.item_live_len[left_idx] = left.len
                self.store.item_len_u64[left_idx] = left.len_u64
                parent.length = old_len + len
                if index < old_len {
                  update_markers(parent, index, len)
                }
                return left_idx
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  let has_orig = left_idx >= 0
  let mut orig_c = 0UL
  let mut orig_k = 0UL
  if has_orig {
    let li = self.store.items[left_idx]
    orig_c = li.id.client
    orig_k = if li.len_u64 <= 1UL {
      li.id.clock
    } else {
      u64_sat_add(li.id.clock, li.len_u64 - 1UL)
    }
  }
  let has_rorig = right_idx >= 0
  let rorig_c = if has_rorig { self.store.items[right_idx].id.client } else { 0UL }
  let rorig_k = if has_rorig { self.store.items[right_idx].id.clock } else { 0UL }
  let clock = self.store.get_clock(self.client_id)
  let countable = content_is_countable(content)
  let item = Item::{
    id: Id::{ client: self.client_id, clock: clock },
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    has_origin: has_orig,
    origin_client: orig_c,
    origin_clock: orig_k,
    has_right_origin: has_rorig,
    right_origin_client: rorig_c,
    right_origin_clock: rorig_k,
    parent_id: type_id,
    parent_key: None,
    has_parent_item_id: false,
    parent_item_client: 0UL,
    parent_item_clock: 0UL,
    parent_sub: None,
    deleted: false,
    countable: countable,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  let item_idx = self.store.push_item(item)
  let parent = self.types[type_id]
  if countable && index < parent.length {
    update_markers(parent, index, len)
  }
  self.integrate_item(item_idx, true)
  if countable {
    record_marker(parent, item_idx, index)
  }
  let _ = self.try_merge_with_left(item_idx)
  item_idx
}

///| Merge `right_idx` into `left_idx` when both are contiguous `Content::Deleted` tombstones from the same client.
///| Returns true if merged (`right_idx` is unlinked and removed from `ClientStore`).
fn Doc::try_merge_deleted_pair(self : Doc, left_idx : Int, right_idx : Int) -> Bool {
  if left_idx < 0 || right_idx < 0 {
    return false
  }
  let left = self.store.items[left_idx]
  let right = self.store.items[right_idx]
  if left.is_gc || right.is_gc || !left.deleted || !right.deleted {
    return false
  }
  if left.id.client != right.id.client {
    return false
  }
  if right.id.clock < left.id.clock || right.id.clock - left.id.clock != left.len_u64 {
    return false
  }
  if left.right != right_idx || left.parent_id != right.parent_id {
    return false
  }
  if !item_origin_eq_last_id(right, left) {
    return false
  }
  if !item_same_right_origin(left, right) {
    return false
  }
  match (left.parent_sub, right.parent_sub) {
    (None, None) => ()
    _ => return false
  }
  match (left.content, right.content) {
    (Content::Deleted(ln), Content::Deleted(rn)) => {
      let cs = self.store.get_or_create_client(left.id.client)
      cs.remove_clock(
        self.store.item_clock,
        self.store.item_len_u64,
        right.id.clock,
        right_idx,
      )
      left.content = Content::Deleted(ln + rn)
      left.len = left.len + right.len
      left.len_u64 = left.len_u64 + right.len_u64
      self.store.item_len_u64[left_idx] = left.len_u64
      let nr = right.right
      left.right = nr
      self.store.item_right[left_idx] = nr
      if nr >= 0 {
        self.store.items[nr].left = left_idx
        self.store.item_left[nr] = left_idx
      }
      if self.store.last_item_idx == right_idx {
        self.store.last_item_idx = left_idx
      }
      true
    }
    _ => false
  }
}

///| Delete `del_len` countable elements starting at `index` in sequence container `type_id`.
fn Doc::delete_range_at(
  self : Doc,
  type_id : Int,
  index : Int,
  del_len : Int,
) -> Unit {
  if del_len <= 0 {
    return
  }
  let parent = self.types[type_id]
  if index < 0 || index >= parent.length {
    return
  }
  let actual_len = if index + del_len > parent.length {
    parent.length - index
  } else {
    del_len
  }
  let dp = self.find_delete_pos(type_id, index)
  if dp.cur < 0 {
    return
  }
  // Fast in-place tail-trim into adjacent right tombstone, or direct 3-part interior delete without allocating doomed middle String
  if dp.off > 0 {
    let cur_item = self.store.items[dp.cur]
    if !cur_item.is_gc {
      if dp.off + actual_len < cur_item.len {
        match (cur_item.parent_sub, cur_item.content) {
          (None, Content::Str(s)) => {
            let orig_len = cur_item.len
            let left_len = dp.off
            let right_len = orig_len - left_len - actual_len
            let left_u64 = int_to_u64(left_len)
            let del_u64 = int_to_u64(actual_len)
            let right_u64 = int_to_u64(right_len)
            let mut left_s = ""
            let mut right_s = ""
            if s.length() == orig_len {
              left_s = s.slice(0, left_len)
              right_s = s.slice(left_len + actual_len, orig_len)
            } else {
              let sp1 = utf16_split_with_len(s, orig_len, left_len)
              left_s = sp1.left
              right_s = utf16_tail_with_len(sp1.right, orig_len - left_len, actual_len)
            }
            let mid_clock = cur_item.id.clock + left_u64
            let right_clock = mid_clock + del_u64
            let old_right = cur_item.right
            let mid_item = Item::{
              id: Id::{ client: cur_item.id.client, clock: mid_clock },
              len: actual_len,
              len_u64: del_u64,
              left: dp.cur,
              right: -1,
              has_origin: true,
              origin_client: cur_item.id.client,
              origin_clock: mid_clock - 1UL,
              has_right_origin: cur_item.has_right_origin,
              right_origin_client: cur_item.right_origin_client,
              right_origin_clock: cur_item.right_origin_clock,
              parent_id: cur_item.parent_id,
              parent_key: cur_item.parent_key,
              has_parent_item_id: cur_item.has_parent_item_id,
              parent_item_client: cur_item.parent_item_client,
              parent_item_clock: cur_item.parent_item_clock,
              parent_sub: None,
              deleted: true,
              countable: true,
              is_gc: false,
              content: Content::Deleted(del_u64),
              raw_any_bytes: None,
            }
            let mid_idx = self.store.push_item(mid_item)
            let right_item = Item::{
              id: Id::{ client: cur_item.id.client, clock: right_clock },
              len: right_len,
              len_u64: right_u64,
              left: mid_idx,
              right: old_right,
              has_origin: true,
              origin_client: cur_item.id.client,
              origin_clock: right_clock - 1UL,
              has_right_origin: cur_item.has_right_origin,
              right_origin_client: cur_item.right_origin_client,
              right_origin_clock: cur_item.right_origin_clock,
              parent_id: cur_item.parent_id,
              parent_key: cur_item.parent_key,
              has_parent_item_id: cur_item.has_parent_item_id,
              parent_item_client: cur_item.parent_item_client,
              parent_item_clock: cur_item.parent_item_clock,
              parent_sub: None,
              deleted: false,
              countable: true,
              is_gc: false,
              content: Content::Str(right_s),
              raw_any_bytes: None,
            }
            let right_idx = self.store.push_item(right_item)
            cur_item.content = Content::Str(left_s)
            cur_item.len = left_len
            cur_item.len_u64 = left_u64
            cur_item.right = mid_idx
            self.store.item_right[dp.cur] = mid_idx
            self.store.item_live_len[dp.cur] = left_len
            self.store.item_len_u64[dp.cur] = left_u64
            self.store.items[mid_idx].right = right_idx
            self.store.item_right[mid_idx] = right_idx
            if old_right >= 0 {
              self.store.items[old_right].left = right_idx
              self.store.item_left[old_right] = right_idx
            }
            let cs = self.store.get_or_create_client(cur_item.id.client)
            cs.insert_two_after_clock(
              self.store.item_clock,
              self.store.item_len_u64,
              cur_item.id.clock,
              mid_idx,
              right_idx,
            )
            parent.length = parent.length - actual_len
            self.store.delete_set.add(cur_item.id.client, mid_clock, del_u64)
            update_markers(parent, index, 0 - actual_len)
            record_marker(parent, dp.cur, dp.cur_idx)
            return
          }
          _ => ()
        }
      } else if dp.off + actual_len == cur_item.len {
        let r_idx = self.store.item_right[dp.cur]
        if r_idx >= 0 {
          let r_item = self.store.items[r_idx]
          if r_item.deleted &&
          !r_item.is_gc &&
          r_item.id.client == cur_item.id.client &&
          r_item.id.clock == cur_item.id.clock + cur_item.len_u64 &&
          r_item.parent_id == cur_item.parent_id &&
          item_origin_eq_last_id(r_item, cur_item) &&
          item_same_right_origin(cur_item, r_item) {
            match (cur_item.parent_sub, r_item.parent_sub, cur_item.content, r_item.content) {
              (None, None, Content::Str(s), Content::Deleted(rn)) => {
                let sp = utf16_split_with_len(s, cur_item.len, dp.off)
                let keep_len = dp.off
                let keep_u64 = int_to_u64(keep_len)
                let del_u64 = int_to_u64(actual_len)
                let old_r_clock = r_item.id.clock
                let new_r_clock = old_r_clock - del_u64
                let cs = self.store.get_or_create_client(cur_item.id.client)
                cs.update_clock_if_head(old_r_clock, new_r_clock, r_idx)
                cur_item.content = Content::Str(sp.left)
                cur_item.len = keep_len
                cur_item.len_u64 = keep_u64
                self.store.item_live_len[dp.cur] = keep_len
                self.store.item_len_u64[dp.cur] = keep_u64
                let new_r_len = r_item.len + actual_len
                let new_r_len_u64 = r_item.len_u64 + del_u64
                self.store.items[r_idx] = Item::{
                  id: Id::{ client: r_item.id.client, clock: new_r_clock },
                  len: new_r_len,
                  len_u64: new_r_len_u64,
                  left: r_item.left,
                  right: r_item.right,
                  has_origin: r_item.has_origin,
                  origin_client: r_item.origin_client,
                  origin_clock: new_r_clock - 1UL,
                  has_right_origin: r_item.has_right_origin,
                  right_origin_client: r_item.right_origin_client,
                  right_origin_clock: r_item.right_origin_clock,
                  parent_id: r_item.parent_id,
                  parent_key: r_item.parent_key,
                  has_parent_item_id: r_item.has_parent_item_id,
                  parent_item_client: r_item.parent_item_client,
                  parent_item_clock: r_item.parent_item_clock,
                  parent_sub: r_item.parent_sub,
                  deleted: true,
                  countable: r_item.countable,
                  is_gc: false,
                  content: Content::Deleted(rn + del_u64),
                  raw_any_bytes: None,
                }
                self.store.item_clock[r_idx] = new_r_clock
                self.store.item_len_u64[r_idx] = new_r_len_u64
                parent.length = parent.length - actual_len
                self.store.delete_set.add(cur_item.id.client, new_r_clock, del_u64)
                update_markers(parent, index, 0 - actual_len)
                if parent.markers.length() == 0 {
                  record_marker(parent, dp.cur, dp.cur_idx)
                } else {
                  parent.last_marker_item = dp.cur
                  parent.last_marker_idx = dp.cur_idx
                }
                return
              }
              _ => ()
            }
          }
        }
      }
    }
  }
  let mut start_left = dp.left
  let mut cur = dp.cur
  if dp.off > 0 {
    start_left = dp.cur
    cur = self.split_item(dp.cur, dp.off)
  }
  update_markers(parent, index, 0 - actual_len)
  let mut rem = actual_len
  let i_lefts = self.store.item_left
  let i_rights = self.store.item_right
  let i_live = self.store.item_live_len
  while cur >= 0 && rem > 0 {
    let ll = i_live[cur]
    if ll > 0 {
      if ll > rem {
        let _ = self.split_item(cur, rem)
      }
      let step = i_live[cur]
      self.delete_item(cur)
      rem = rem - step
      // Coalesce adjacent contiguous tombstones (both left and right) to prevent tombstone fragmentation
      let mut surviving = cur
      let right_cand = i_rights[surviving]
      if right_cand >= 0 && self.store.items[right_cand].deleted {
        let _ = self.try_merge_deleted_pair(surviving, right_cand)
      }
      let left_cand = i_lefts[surviving]
      if left_cand >= 0 && self.store.items[left_cand].deleted {
        if self.try_merge_deleted_pair(left_cand, surviving) {
          surviving = left_cand
        }
      }
      cur = i_rights[surviving]
    } else {
      cur = i_rights[cur]
    }
  }
  // Preserve a surviving marker adjacent to the deletion point so backward/sequential deletes stay O(1)
  if start_left >= 0 {
    let lll = i_live[start_left]
    if lll > 0 && index >= lll {
      record_marker(parent, start_left, index - lll)
      return
    }
  }
  if cur >= 0 && i_live[cur] > 0 {
    record_marker(parent, cur, index)
  }
}

// --- Rich-text cursor helpers (exact match with yjs/src/types/YText.js) ---

struct TextPos {
  mut left : Int
  mut right : Int
  mut index : Int
  current_attrs : Map[String, String]
}

fn update_current_attrs(attrs : Map[String, String], key : String, val_json : String) -> Unit {
  if val_json == "null" {
    attrs.remove(key)
  } else {
    attrs.set(key, val_json)
  }
}

fn get_attr_or_null(attrs : Map[String, String], key : String) -> String {
  match attrs.get(key) {
    Some(v) => v
    None => "null"
  }
}

fn text_pos_forward(doc : Doc, pos : TextPos) -> Unit {
  if pos.right < 0 {
    return
  }
  let item = doc.store.items[pos.right]
  if !item.deleted {
    match item.content {
      Content::Format(k, v) => update_current_attrs(pos.current_attrs, k, v)
      _ => {
        if item.countable {
          pos.index = pos.index + item.len
        }
      }
    }
  }
  pos.left = pos.right
  pos.right = item.right
}

fn find_text_pos(doc : Doc, type_id : Int, target : Int) -> TextPos {
  let parent = doc.types[type_id]
  let idx = if target < 0 {
    0
  } else if target > parent.length {
    parent.length
  } else {
    target
  }
  let pos = TextPos::{
    left: -1,
    right: parent.start,
    index: 0,
    current_attrs: Map::new(),
  }
  let mut rem = idx
  while pos.right >= 0 && rem > 0 {
    let item = doc.store.items[pos.right]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => update_current_attrs(pos.current_attrs, k, v)
        _ => {
          if item.countable {
            if rem < item.len {
              let _ = doc.split_item(pos.right, rem)
            }
            let step = doc.store.items[pos.right].len
            pos.index = pos.index + step
            rem = rem - step
          }
        }
      }
    }
    pos.left = pos.right
    pos.right = doc.store.items[pos.right].right
  }
  pos
}

fn Doc::insert_item_between(
  self : Doc,
  type_id : Int,
  left_idx : Int,
  right_idx : Int,
  content : Content,
) -> Int {
  let len = content_len(content)
  if len <= 0 {
    return -1
  }
  let has_orig = left_idx >= 0
  let mut orig_c = 0UL
  let mut orig_k = 0UL
  if has_orig {
    let li = self.store.items[left_idx]
    orig_c = li.id.client
    orig_k = if li.len_u64 <= 1UL {
      li.id.clock
    } else {
      u64_sat_add(li.id.clock, li.len_u64 - 1UL)
    }
  }
  let has_rorig = right_idx >= 0
  let rorig_c = if has_rorig { self.store.items[right_idx].id.client } else { 0UL }
  let rorig_k = if has_rorig { self.store.items[right_idx].id.clock } else { 0UL }
  let clock = self.store.get_clock(self.client_id)
  let countable = content_is_countable(content)
  let item = Item::{
    id: Id::new(self.client_id, clock),
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    has_origin: has_orig,
    origin_client: orig_c,
    origin_clock: orig_k,
    has_right_origin: has_rorig,
    right_origin_client: rorig_c,
    right_origin_clock: rorig_k,
    parent_id: type_id,
    parent_key: None,
    has_parent_item_id: false,
    parent_item_client: 0UL,
    parent_item_clock: 0UL,
    parent_sub: None,
    deleted: false,
    countable: countable,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  let item_idx = self.store.push_item(item)
  self.integrate_item(item_idx, true)
  item_idx
}

// --- YText API ---

///| Insert `chunk` at UTF-16 character `index` in this `YText`.
pub fn YText::insert(self : YText, doc : Doc, index : Int, chunk : String) -> Unit {
  if chunk.length() == 0 {
    return
  }
  let parent = doc.types[self.type_id]
  if !parent.has_format {
    let _ = doc.insert_text_at(self.type_id, index, chunk)
    return
  }
  // Rich-text path matching yjs YText.prototype.insert + minimizeAttributeChanges
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  // Default attributes = copy of current_attrs at pos
  let target_attrs : Map[String, String] = Map::new()
  let ks = pos.current_attrs.keys()
  let mut ki = 0
  while ki < ks.length() {
    match pos.current_attrs.get(ks[ki]) {
      Some(v) => target_attrs.set(ks[ki], v)
      None => ()
    }
    ki = ki + 1
  }
  // minimizeAttributeChanges: advance past deleted items and matching Content::Format items
  let mut keep = true
  while keep && pos.right >= 0 {
    let ritem = doc.store.items[pos.right]
    if ritem.deleted {
      text_pos_forward(doc, pos)
    } else {
      match ritem.content {
        Content::Format(k, v) => {
          if get_attr_or_null(target_attrs, k) == v {
            text_pos_forward(doc, pos)
          } else {
            keep = false
          }
        }
        _ => keep = false
      }
    }
  }
  let item_idx = doc.insert_item_between(
    self.type_id,
    pos.left,
    pos.right,
    Content::Str(chunk),
  )
  let _ = doc.try_merge_with_left(item_idx)
}

///| Append `chunk` to the end of this `YText`.
pub fn YText::push(self : YText, doc : Doc, chunk : String) -> Unit {
  let end_idx = doc.types[self.type_id].length
  self.insert(doc, end_idx, chunk)
}

fn copy_attrs_map(src : Map[String, String]) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  let ks = src.keys()
  let mut i = 0
  while i < ks.length() {
    match src.get(ks[i]) {
      Some(v) => out.set(ks[i], v)
      None => ()
    }
    i = i + 1
  }
  out
}

///| Clean up redundant formatting markers between `start_idx` and the next live countable item.
///| Exact match with yjs `cleanupFormattingGap`.
fn cleanup_formatting_gap(
  doc : Doc,
  start_idx : Int,
  curr_idx : Int,
  start_attrs : Map[String, String],
  curr_attrs : Map[String, String],
) -> Unit {
  if start_idx < 0 {
    return
  }
  let mut end_idx = start_idx
  let end_formats : Map[String, Int] = Map::new()
  while end_idx >= 0 {
    let eitem = doc.store.items[end_idx]
    if !eitem.deleted && eitem.countable {
      break
    }
    if !eitem.deleted {
      match eitem.content {
        Content::Format(k, _) => end_formats.set(k, end_idx)
        _ => ()
      }
    }
    end_idx = eitem.right
  }
  let mut cur = start_idx
  let mut reached_curr = false
  while cur >= 0 && cur != end_idx {
    if cur == curr_idx {
      reached_curr = true
    }
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => {
          let start_val = get_attr_or_null(start_attrs, k)
          let is_last_for_key = match end_formats.get(k) {
            Some(eid) => eid == cur
            None => false
          }
          if !is_last_for_key || start_val == v {
            doc.delete_item(cur)
            if !reached_curr && get_attr_or_null(curr_attrs, k) == v && start_val != v {
              update_current_attrs(curr_attrs, k, start_val)
            }
          }
          if !reached_curr && !doc.store.items[cur].deleted {
            update_current_attrs(curr_attrs, k, v)
          }
        }
        _ => ()
      }
    }
    cur = doc.store.items[cur].right
  }
}

///| Delete `len` UTF-16 code units starting at `index` in this `YText`.
pub fn YText::delete(self : YText, doc : Doc, index : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  let parent = doc.types[self.type_id]
  if !parent.has_format {
    doc.delete_range_at(self.type_id, index, len)
    return
  }
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  let start_attrs = copy_attrs_map(pos.current_attrs)
  let start_idx = pos.right
  let mut rem = len
  while rem > 0 && pos.right >= 0 {
    let r_idx = pos.right
    let item = doc.store.items[r_idx]
    if !item.deleted && item.countable {
      if rem < item.len {
        let _ = doc.split_item(r_idx, rem)
      }
      let step = doc.store.items[r_idx].len
      rem = rem - step
      doc.delete_item(r_idx)
    }
    text_pos_forward(doc, pos)
  }
  if start_idx >= 0 {
    cleanup_formatting_gap(doc, start_idx, pos.right, start_attrs, pos.current_attrs)
  }
}

///| Apply a formatting attribute `(key, val_json)` over `[index, index + len)`.
///| Matches yjs `formatText` / `insertAttributes` / `insertNegatedAttributes` semantics.
pub fn YText::format(
  self : YText,
  doc : Doc,
  index : Int,
  len : Int,
  key : String,
  val_json : String,
) -> Unit {
  if len <= 0 {
    return
  }
  let parent = doc.types[self.type_id]
  parent.has_format = true
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  // minimizeAttributeChanges for single attribute { key: val_json }
  let mut keep = true
  while keep && pos.right >= 0 {
    let ritem = doc.store.items[pos.right]
    if ritem.deleted {
      text_pos_forward(doc, pos)
    } else {
      match ritem.content {
        Content::Format(k, v) => {
          if k == key && v == val_json {
            text_pos_forward(doc, pos)
          } else {
            keep = false
          }
        }
        _ => keep = false
      }
    }
  }
  // insertAttributes: only insert opening Format if current value differs
  let cur_val = get_attr_or_null(pos.current_attrs, key)
  let mut negated : Option[String] = None
  if cur_val != val_json {
    negated = Some(cur_val)
    let fmt_idx = doc.insert_item_between(
      self.type_id,
      pos.left,
      pos.right,
      Content::Format(key, val_json),
    )
    pos.left = fmt_idx
    update_current_attrs(pos.current_attrs, key, val_json)
  }
  // Iterate over `len` countable units, deleting overridden/redundant Format items of `key`
  let mut rem = len
  while pos.right >= 0 && rem > 0 {
    let r_idx = pos.right
    let item = doc.store.items[r_idx]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => {
          if k == key {
            if v == val_json {
              negated = None
            } else {
              negated = Some(v)
            }
            doc.delete_item(r_idx)
            pos.left = r_idx
            pos.right = doc.store.items[r_idx].right
          } else {
            text_pos_forward(doc, pos)
          }
        }
        _ => {
          if item.countable {
            if rem < item.len {
              let _ = doc.split_item(r_idx, rem)
            }
            let step = doc.store.items[r_idx].len
            rem = rem - step
          }
          text_pos_forward(doc, pos)
        }
      }
    } else {
      text_pos_forward(doc, pos)
    }
  }
  // insertNegatedAttributes: restore outer attribute value at end of range
  match negated {
    Some(restore_val) => {
      let mut need_insert = true
      let mut cont = true
      while cont && pos.right >= 0 {
        let ritem = doc.store.items[pos.right]
        if ritem.deleted {
          text_pos_forward(doc, pos)
        } else {
          match ritem.content {
            Content::Format(k, v) => {
              if k == key && v == restore_val {
                need_insert = false
                text_pos_forward(doc, pos)
                cont = false
              } else {
                cont = false
              }
            }
            _ => cont = false
          }
        }
      }
      if need_insert {
        let _ = doc.insert_item_between(
          self.type_id,
          pos.left,
          pos.right,
          Content::Format(key, restore_val),
        )
      }
    }
    None => ()
  }
}

///| Return current UTF-16 length of this `YText`.
pub fn YText::len(self : YText, doc : Doc) -> Int {
  doc.types[self.type_id].length
}

///| Materialize this `YText` as a `String`.
pub fn YText::to_string(self : YText, doc : Doc) -> String {
  let parent = doc.types[self.type_id]
  let cap = if parent.length > 32 { parent.length } else { 32 }
  let sb = StringBuilder::with_capacity(cap)
  let i_live = doc.store.item_live_len
  let i_rights = doc.store.item_right
  let mut cur = parent.start
  while cur >= 0 {
    if i_live[cur] > 0 {
      match doc.store.items[cur].content {
        Content::Str(s) => sb.write_string(s)
        _ => ()
      }
    }
    cur = i_rights[cur]
  }
  sb.to_string()
}

// --- YArray API ---

///| Insert a single `Any` element at `index`.
pub fn YArray::insert(self : YArray, doc : Doc, index : Int, value : Any) -> Unit {
  let arr : Array[Any] = Array::new()
  arr.push(value)
  let _ = doc.insert_content_at(self.type_id, index, Content::AnyList(arr), false)
}

///| Insert multiple `Any` elements starting at `index`.
pub fn YArray::insert_range(
  self : YArray,
  doc : Doc,
  index : Int,
  values : Array[Any],
) -> Unit {
  if values.length() == 0 {
    return
  }
  let copy : Array[Any] = Array::new()
  let mut i = 0
  while i < values.length() {
    copy.push(values[i])
    i = i + 1
  }
  let _ = doc.insert_content_at(self.type_id, index, Content::AnyList(copy), false)
}

///| Append a single `Any` element to the physical end of this `YArray` (skipping trailing tombstones, matching Yjs `typeListPushGenerics`).
pub fn YArray::push(self : YArray, doc : Doc, value : Any) -> Unit {
  let end_idx = doc.types[self.type_id].length
  let arr : Array[Any] = Array::new()
  arr.push(value)
  let _ = doc.insert_content_at(self.type_id, end_idx, Content::AnyList(arr), true)
}

///| Insert a new nested `YText` at `index` and return its handle.
pub fn YArray::insert_text(self : YArray, doc : Doc, index : Int) -> YText {
  let tid = doc.alloc_nested_type(TypeRef::YTextRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YText::{ type_id: tid }
}

///| Insert a new nested `YArray` at `index` and return its handle.
pub fn YArray::insert_array(self : YArray, doc : Doc, index : Int) -> YArray {
  let tid = doc.alloc_nested_type(TypeRef::YArrayRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YArray::{ type_id: tid }
}

///| Insert a new nested `YMap` at `index` and return its handle.
pub fn YArray::insert_map(self : YArray, doc : Doc, index : Int) -> YMap {
  let tid = doc.alloc_nested_type(TypeRef::YMapRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YMap::{ type_id: tid }
}

///| Delete `len` elements starting at `index`.
pub fn YArray::delete(self : YArray, doc : Doc, index : Int, len : Int) -> Unit {
  doc.delete_range_at(self.type_id, index, len)
}

///| Locate `(item_idx, offset_in_item)` for live element `index` in a `YArray`.
fn find_array_elem(doc : Doc, type_id : Int, index : Int) -> ItemPair {
  if index < 0 || index >= doc.types[type_id].length {
    return ItemPair::{ left: -1, right: 0 }
  }
  let i_live = doc.store.item_live_len
  let i_rights = doc.store.item_right
  let mut cur = doc.types[type_id].start
  let mut pos = 0
  while cur >= 0 {
    let ll = i_live[cur]
    if ll > 0 {
      if pos + ll > index {
        return ItemPair::{ left: cur, right: index - pos }
      }
      pos = pos + ll
    }
    cur = i_rights[cur]
  }
  ItemPair::{ left: -1, right: 0 }
}

///| Read the `Any` element at `index`, if present and an `Any` value.
pub fn YArray::get(self : YArray, doc : Doc, index : Int) -> Option[Any] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::AnyList(arr) => Some(arr[p.right])
    Content::Binary(b) => Some(Any::Binary(b))
    _ => None
  }
}

///| Read a nested `YText` at `index`.
pub fn YArray::get_text(self : YArray, doc : Doc, index : Int) -> Option[YText] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YText::{ type_id: tid })
    _ => None
  }
}

///| Read a nested `YArray` at `index`.
pub fn YArray::get_array(self : YArray, doc : Doc, index : Int) -> Option[YArray] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YArray::{ type_id: tid })
    _ => None
  }
}

///| Read a nested `YMap` at `index`.
pub fn YArray::get_map(self : YArray, doc : Doc, index : Int) -> Option[YMap] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YMap::{ type_id: tid })
    _ => None
  }
}

///| Return current element count of this `YArray`.
pub fn YArray::len(self : YArray, doc : Doc) -> Int {
  doc.types[self.type_id].length
}

///| Materialize all `Any` elements in this `YArray`.
pub fn YArray::to_array(self : YArray, doc : Doc) -> Array[Any] {
  let out : Array[Any] = Array::new()
  let mut cur = doc.types[self.type_id].start
  while cur >= 0 {
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        Content::AnyList(arr) => {
          let mut i = 0
          while i < arr.length() {
            out.push(arr[i])
            i = i + 1
          }
        }
        Content::Binary(b) => out.push(Any::Binary(b))
        _ => ()
      }
    }
    cur = item.right
  }
  out
}

// --- YMap API ---

///| Internal helper: set `key` in `YMap` `type_id` to `content`.
fn Doc::map_set_content(
  self : Doc,
  type_id : Int,
  key : String,
  content : Content,
) -> Int {
  let parent = self.types[type_id]
  let left_idx = match parent.map.get(key) {
    Some(idx) => idx
    None => -1
  }
  let has_orig = left_idx >= 0
  let mut orig_c = 0UL
  let mut orig_k = 0UL
  if has_orig {
    let li = self.store.items[left_idx]
    orig_c = li.id.client
    orig_k = if li.len_u64 <= 1UL {
      li.id.clock
    } else {
      u64_sat_add(li.id.clock, li.len_u64 - 1UL)
    }
  }
  let clock = self.store.get_clock(self.client_id)
  let item = Item::{
    id: Id::new(self.client_id, clock),
    len: content_len(content),
    len_u64: content_len_u64(content),
    left: left_idx,
    right: -1,
    has_origin: has_orig,
    origin_client: orig_c,
    origin_clock: orig_k,
    has_right_origin: false,
    right_origin_client: 0UL,
    right_origin_clock: 0UL,
    parent_id: type_id,
    parent_key: None,
    has_parent_item_id: false,
    parent_item_client: 0UL,
    parent_item_clock: 0UL,
    parent_sub: Some(key),
    deleted: false,
    countable: true,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  let item_idx = self.store.push_item(item)
  self.integrate_item(item_idx, true)
  item_idx
}

///| Set `key` to an `Any` value in this `YMap`.
pub fn YMap::set(self : YMap, doc : Doc, key : String, value : Any) -> Unit {
  let arr : Array[Any] = Array::new()
  arr.push(value)
  let _ = doc.map_set_content(self.type_id, key, Content::AnyList(arr))
}

///| Set `key` to a new nested `YText` and return its handle.
pub fn YMap::set_text(self : YMap, doc : Doc, key : String) -> YText {
  let tid = doc.alloc_nested_type(TypeRef::YTextRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YText::{ type_id: tid }
}

///| Set `key` to a new nested `YArray` and return its handle.
pub fn YMap::set_array(self : YMap, doc : Doc, key : String) -> YArray {
  let tid = doc.alloc_nested_type(TypeRef::YArrayRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YArray::{ type_id: tid }
}

///| Set `key` to a new nested `YMap` and return its handle.
pub fn YMap::set_map(self : YMap, doc : Doc, key : String) -> YMap {
  let tid = doc.alloc_nested_type(TypeRef::YMapRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YMap::{ type_id: tid }
}

///| Get the `Any` value stored at `key`.
pub fn YMap::get(self : YMap, doc : Doc, key : String) -> Option[Any] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::AnyList(arr) => {
          if arr.length() > 0 {
            Some(arr[arr.length() - 1])
          } else {
            None
          }
        }
        Content::Binary(b) => Some(Any::Binary(b))
        Content::Format(_, _) => Some(Any::Undefined)
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YText` stored at `key`.
pub fn YMap::get_text(self : YMap, doc : Doc, key : String) -> Option[YText] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YText::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YArray` stored at `key`.
pub fn YMap::get_array(self : YMap, doc : Doc, key : String) -> Option[YArray] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YArray::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YMap` stored at `key`.
pub fn YMap::get_map(self : YMap, doc : Doc, key : String) -> Option[YMap] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YMap::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Delete `key` from this `YMap`.
pub fn YMap::delete(self : YMap, doc : Doc, key : String) -> Unit {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      if !doc.store.items[idx].deleted {
        doc.delete_item(idx)
      }
    }
    None => ()
  }
}

///| Return true if `key` is currently present (not deleted).
pub fn YMap::contains_key(self : YMap, doc : Doc, key : String) -> Bool {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => !doc.store.items[idx].deleted
    None => false
  }
}

///| Return number of live keys in this `YMap`.
pub fn YMap::len(self : YMap, doc : Doc) -> Int {
  let parent = doc.types[self.type_id]
  let ks = parent.map.keys()
  let mut count = 0
  let mut i = 0
  while i < ks.length() {
    match parent.map.get(ks[i]) {
      Some(idx) => {
        if !doc.store.items[idx].deleted {
          count = count + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
  count
}

///| Return sorted live keys of this `YMap`.
pub fn YMap::keys(self : YMap, doc : Doc) -> Array[String] {
  let parent = doc.types[self.type_id]
  let ks = parent.map.keys()
  let out : Array[String] = Array::new()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match parent.map.get(k) {
      Some(idx) => {
        if !doc.store.items[idx].deleted {
          out.push(k)
        }
      }
      None => ()
    }
    i = i + 1
  }
  sort_strings(out)
  out
}

///| Materialize live `Any` entries of this `YMap`.
pub fn YMap::to_map(self : YMap, doc : Doc) -> Map[String, Any] {
  let out : Map[String, Any] = Map::new()
  let ks = self.keys(doc)
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match self.get(doc, k) {
      Some(v) => out.set(k, v)
      None => ()
    }
    i = i + 1
  }
  out
}
