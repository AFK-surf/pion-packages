///| Collaborative `Doc`, YATA integration, search markers, and shared types (`YText`, `YArray`, `YMap`).

///| Value handle to a `YText` inside a `Doc`.
pub val struct YText {
  pub type_id : Int
}

///| Value handle to a `YArray` inside a `Doc`.
pub val struct YArray {
  pub type_id : Int
}

///| Value handle to a `YMap` inside a `Doc`.
pub val struct YMap {
  pub type_id : Int
}

///| Collaborative CRDT document compatible with Yjs v1 wire protocol.
pub struct Doc {
  pub client_id : UInt64
  pub store : BlockStore
  pub types : Array[YTypeNode]
  pub share : Map[String, Int]
}

///| Create a new `Doc` with the given `client_id`.
pub fn Doc::new(client_id : UInt64) -> Doc {
  Doc::{
    client_id: client_id,
    store: BlockStore::new(),
    types: Array::new(),
    share: Map::new(),
  }
}

///| Return this document's client ID.
pub fn Doc::client_id(self : Doc) -> UInt64 {
  self.client_id
}

///| Ensure a root shared type exists in `doc.share` and return its `type_id`.
pub fn Doc::ensure_root_type(self : Doc, name : String, tr : TypeRef) -> Int {
  match self.share.get(name) {
    Some(tid) => tid
    None => {
      let tid = self.types.length()
      self.types.push(YTypeNode::new(tr, Some(name)))
      self.share.set(name, tid)
      tid
    }
  }
}

///| Allocate a new nested `YTypeNode` (not in `doc.share`) and return its `type_id`.
pub fn Doc::alloc_nested_type(self : Doc, tr : TypeRef) -> Int {
  let tid = self.types.length()
  self.types.push(YTypeNode::new(tr, None))
  tid
}

///| Allocate a new nested `YTypeNode` preserving raw Yjs type ref (0..6) and optional XML nodeName.
pub fn Doc::alloc_nested_type_raw(
  self : Doc,
  raw_ref : Int,
  node_name : Option[String],
) -> Int {
  let tid = self.types.length()
  let node = YTypeNode::new(int_to_type_ref(raw_ref), None)
  node.raw_type_ref = raw_ref
  node.node_name = node_name
  self.types.push(node)
  tid
}

///| Get or create a root-level `YText` by name.
pub fn Doc::get_text(self : Doc, name : String) -> YText {
  YText::{ type_id: self.ensure_root_type(name, TypeRef::YTextRef) }
}

///| Get or create a root-level `YArray` by name.
pub fn Doc::get_array(self : Doc, name : String) -> YArray {
  YArray::{ type_id: self.ensure_root_type(name, TypeRef::YArrayRef) }
}

///| Get or create a root-level `YMap` by name.
pub fn Doc::get_map(self : Doc, name : String) -> YMap {
  YMap::{ type_id: self.ensure_root_type(name, TypeRef::YMapRef) }
}

///| Return the current `StateVector` of this document.
pub fn Doc::state_vector(self : Doc) -> StateVector {
  let sv = StateVector::new()
  let ks = self.store.client_stores.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    let c = k.to_uint64()
    let clock = self.store.get_clock(c)
    if clock > 0UL {
      sv.set(c, clock)
    }
    i = i + 1
  }
  sv
}

///| Encode this document's state vector in Yjs v1 format.
pub fn Doc::encode_state_vector(self : Doc) -> Bytes {
  encode_state_vector(self)
}

///| Encode the entire document state as a Yjs v1 binary update.
pub fn Doc::encode_state_as_update(self : Doc) -> Bytes {
  match encode_state_as_update(self, None) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///| Encode only operations missing from `target_sv` as a Yjs v1 binary update.
pub fn Doc::encode_state_as_update_from(
  self : Doc,
  target_sv : Bytes,
) -> Result[Bytes, CrdtError] {
  encode_state_as_update(self, Some(target_sv))
}

///| Apply a Yjs v1 binary update to this document.
pub fn Doc::apply_update(self : Doc, update : Bytes) -> Result[Unit, CrdtError] {
  apply_update(self, update)
}

// --- Internal YATA / Store Operations ---

///| Compare two `Option[Id]` values for equality.
#verify
pub fn opt_id_eq(a : Option[Id], b : Option[Id]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.eq(y)
    _ => false
  }
}

///| YATA same-origin conflict tie-breaker: lower client ID is ordered before higher client ID.
pub fn yata_same_origin_before(lhs_client : UInt64, rhs_client : UInt64) -> Bool {
  lhs_client < rhs_client
}

///| Split item `item_idx` at `diff` clocks (`0 < diff < item.len_u64`), returning the new right item index.
pub fn Doc::split_item_u64(self : Doc, item_idx : Int, diff : UInt64) -> Int {
  let item = self.store.items[item_idx]
  let right_c = content_split_in_place_u64(item, diff)
  let right_len_u64 = item.len_u64 - diff
  let right_len = if right_len_u64 > 2147483647UL {
    2147483647
  } else {
    right_len_u64.to_int()
  }
  let left_len = if diff > 2147483647UL { 2147483647 } else { diff.to_int() }
  let right_id = Id::{ client: item.id.client, clock: item.id.clock + diff }
  let right_origin = Some(
    Id::{ client: item.id.client, clock: item.id.clock + diff - 1UL },
  )
  let right_idx = self.store.items.length()
  let mut left_raw_any : Option[Array[Bytes]] = None
  let mut right_raw_any : Option[Array[Bytes]] = None
  match item.raw_any_bytes {
    Some(raws) => {
      let off_i = diff.to_int()
      let lr : Array[Bytes] = Array::new()
      let rr : Array[Bytes] = Array::new()
      let mut ri = 0
      while ri < raws.length() {
        if ri < off_i {
          lr.push(raws[ri])
        } else {
          rr.push(raws[ri])
        }
        ri = ri + 1
      }
      left_raw_any = Some(lr)
      right_raw_any = Some(rr)
    }
    None => ()
  }
  let right_item = Item::{
    id: right_id,
    len: right_len,
    len_u64: right_len_u64,
    left: item_idx,
    right: item.right,
    origin: right_origin,
    right_origin: item.right_origin,
    parent_id: item.parent_id,
    parent_key: item.parent_key,
    parent_item_id: item.parent_item_id,
    parent_sub: item.parent_sub,
    deleted: item.deleted,
    countable: item.countable,
    is_gc: item.is_gc,
    content: right_c,
    raw_any_bytes: right_raw_any,
  }
  self.store.items.push(right_item)
  let old_right = item.right
  item.len = left_len
  item.len_u64 = diff
  item.raw_any_bytes = left_raw_any
  item.right = right_idx
  if old_right >= 0 {
    self.store.items[old_right].left = right_idx
  }
  // Insert right_idx into client's chunked block store right after item_idx
  let cs = self.store.get_or_create_client(item.id.client)
  cs.insert_after_clock(self.store.items, item.id.clock, right_idx)
  // Update parent._map if this was the active map entry
  if right_item.parent_id >= 0 && right_item.right < 0 {
    match right_item.parent_sub {
      Some(sub) => self.types[right_item.parent_id].map.set(sub, right_idx)
      None => ()
    }
  }
  right_idx
}

///| Split item `item_idx` at `diff` clocks (`0 < diff < item.len`), returning the new right item index.
pub fn Doc::split_item(self : Doc, item_idx : Int, diff : Int) -> Int {
  self.split_item_u64(item_idx, int_to_u64(diff))
}

///| Return the arena index of the item whose clock starts exactly at `id.clock` (splitting if needed).
pub fn Doc::get_item_clean_start(self : Doc, id : Id) -> Int {
  let idx = self.store.get_item_idx(id)
  if idx < 0 {
    return -1
  }
  let item = self.store.items[idx]
  if item.id.clock < id.clock {
    let diff = id.clock - item.id.clock
    self.split_item_u64(idx, diff)
  } else {
    idx
  }
}

///| Return the arena index of the item whose last clock equals `id.clock` (splitting if needed).
pub fn Doc::get_item_clean_end(self : Doc, id : Id) -> Int {
  let idx = self.store.get_item_idx(id)
  if idx < 0 {
    return -1
  }
  let item = self.store.items[idx]
  let last_clock = if item.len_u64 <= 1UL {
    item.id.clock
  } else {
    u64_sat_add(item.id.clock, item.len_u64 - 1UL)
  }
  if last_clock > id.clock {
    let diff = id.clock - item.id.clock + 1UL
    let _ = self.split_item_u64(idx, diff)
    idx
  } else {
    idx
  }
}

///| Mark an item as deleted, updating parent length, DeleteSet, GC content, and nested children.
pub fn Doc::delete_item(self : Doc, item_idx : Int) -> Unit {
  let item = self.store.items[item_idx]
  if item.deleted {
    return
  }
  item.deleted = true
  if item.parent_id >= 0 && item.countable {
    match item.parent_sub {
      None => {
        let p = self.types[item.parent_id]
        p.length = p.length - item.len
      }
      Some(_) => ()
    }
  }
  self.store.delete_set.add(item.id.client, item.id.clock, item.len_u64)
  // Recursively delete children if this item holds a nested YType
  match item.content {
    Content::Type(tid) => {
      let child_node = self.types[tid]
      clear_markers(child_node)
      let mut cur = child_node.start
      while cur >= 0 {
        let next = self.store.items[cur].right
        if !self.store.items[cur].deleted {
          self.delete_item(cur)
        }
        cur = next
      }
      let ks = child_node.map.keys()
      let mut i = 0
      while i < ks.length() {
        match child_node.map.get(ks[i]) {
          Some(m_idx) => {
            if !self.store.items[m_idx].deleted {
              self.delete_item(m_idx)
            }
          }
          None => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  // Yjs standard GC: replace deleted item's payload with ContentDeleted (preserving links & YATA origins)
  if !item.is_gc {
    item.content = Content::Deleted(item.len_u64)
    item.raw_any_bytes = None
  }
}

///| Try to merge `item_idx` into its immediate left neighbor (same client, contiguous clocks, same rightOrigin).
///| Returns true if merged (in which case `item_idx` is removed from `clients[client]`).
pub fn Doc::try_merge_with_left(self : Doc, item_idx : Int) -> Bool {
  let right = self.store.items[item_idx]
  let left_idx = right.left
  if left_idx < 0 || right.is_gc {
    return false
  }
  let left = self.store.items[left_idx]
  if left.is_gc || left.deleted != right.deleted {
    return false
  }
  if left.id.client != right.id.client {
    return false
  }
  if right.id.clock < left.id.clock || right.id.clock - left.id.clock != left.len_u64 {
    return false
  }
  if left.right != item_idx {
    return false
  }
  if !opt_id_eq(right.origin, Some(left.last_id())) {
    return false
  }
  if !opt_id_eq(left.right_origin, right.right_origin) {
    return false
  }
  if left.parent_id != right.parent_id {
    return false
  }
  match (left.parent_sub, right.parent_sub) {
    (None, None) => ()
    _ => return false
  }
  let merged_ok = match (left.content, right.content) {
    (Content::Str(ls), Content::Str(rs)) => {
      if ls.length() + rs.length() > 64 {
        false
      } else {
        left.content = Content::Str(ls + rs)
        true
      }
    }
    (Content::AnyList(la), Content::AnyList(ra)) => {
      if la.length() + ra.length() > 128 {
        false
      } else {
        let mut i = 0
        while i < ra.length() {
          la.push(ra[i])
          i = i + 1
        }
        true
      }
    }
    (Content::Deleted(ln), Content::Deleted(rn)) => {
      left.content = Content::Deleted(ln + rn)
      true
    }
    _ => false
  }
  if !merged_ok {
    return false
  }
  // Update search markers pointing to right_idx -> left_idx
  if left.parent_id >= 0 {
    let p = self.types[left.parent_id]
    let shift = if !left.deleted && left.countable { left.len } else { 0 }
    if p.last_marker_item == item_idx {
      p.last_marker_item = left_idx
      p.last_marker_idx = p.last_marker_idx - shift
    }
    let mut ci = 0
    while ci < p.marker_chunks.length() {
      let ch = p.marker_chunks[ci]
      let mut mi = 0
      while mi < ch.items.length() {
        let m = ch.items[mi]
        if m.item_idx == item_idx {
          ch.items[mi] = SearchMarker::{
            item_idx: left_idx,
            index: m.index - shift,
            timestamp: m.timestamp,
          }
        }
        mi = mi + 1
      }
      ci = ci + 1
    }
  }
  left.right = right.right
  if left.right >= 0 {
    self.store.items[left.right].left = left_idx
  }
  left.len = left.len + right.len
  left.len_u64 = left.len_u64 + right.len_u64
  // Remove item_idx from client's block store (it is always the last element when newly appended)
  let cs = self.store.get_or_create_client(left.id.client)
  cs.pop_last(item_idx)
  if self.store.last_item_idx == item_idx {
    self.store.last_item_idx = left_idx
  }
  true
}

///| Integrate an unintegrated item `item_idx` into the document using the YATA algorithm.
///| `is_local` skips clearing search markers when the caller updates them explicitly.
pub fn Doc::integrate_item(self : Doc, item_idx : Int, is_local : Bool) -> Unit {
  let item = self.store.items[item_idx]
  if item.is_gc {
    self.store.add_item_to_client(item_idx)
    return
  }
  // Resolve left and right pointers from origin / right_origin if not already set (remote items)
  if !is_local {
    match item.origin {
      Some(oid) => item.left = self.get_item_clean_end(oid)
      None => item.left = -1
    }
    match item.right_origin {
      Some(roid) => item.right = self.get_item_clean_start(roid)
      None => item.right = -1
    }
  }
  // Resolve parent_id and parent_sub
  if item.parent_id < 0 {
    if item.left >= 0 {
      let l = self.store.items[item.left]
      item.parent_id = l.parent_id
      item.parent_sub = l.parent_sub
    } else if item.right >= 0 {
      let r = self.store.items[item.right]
      item.parent_id = r.parent_id
      item.parent_sub = r.parent_sub
    } else {
      match item.parent_key {
        Some(key) => {
          let tr = match item.parent_sub {
            Some(_) => TypeRef::YMapRef
            None => TypeRef::YTextRef
          }
          item.parent_id = self.ensure_root_type(key, tr)
        }
        None => match item.parent_item_id {
          Some(pid) => {
            let pidx = self.store.get_item_idx(pid)
            if pidx >= 0 {
              match self.store.items[pidx].content {
                Content::Type(tid) => item.parent_id = tid
                _ => ()
              }
            }
          }
          None => ()
        }
      }
    }
  }

  let parent_id = item.parent_id
  if parent_id < 0 {
    // Parent not found (GC'd parent): turn into GC block
    item.is_gc = true
    item.content = Content::Gc(item.len_u64)
    self.store.add_item_to_client(item_idx)
    return
  }

  let parent = self.types[parent_id]
  if !is_local && (parent.markers.length() > 0 || parent.marker_chunks.length() > 0) {
    clear_markers(parent)
  }

  // YATA conflict resolution (exact match with yjs/src/structs/Item.js)
  let has_conflict = (
    item.left < 0 && (item.right < 0 || self.store.items[item.right].left >= 0)
  ) || (item.left >= 0 && self.store.items[item.left].right != item.right)

  if has_conflict {
    let mut left = item.left
    let mut o = if left >= 0 {
      self.store.items[left].right
    } else {
      match item.parent_sub {
        Some(sub) => {
          let mut cur = match parent.map.get(sub) {
            Some(v) => v
            None => -1
          }
          while cur >= 0 && self.store.items[cur].left >= 0 {
            cur = self.store.items[cur].left
          }
          cur
        }
        None => parent.start
      }
    }

    if o >= 0 && o != item.right {
      let conflicting_items : Map[Int, Bool] = Map::new()
      let items_before_origin : Map[Int, Bool] = Map::new()

      while o >= 0 && o != item.right {
        items_before_origin.set(o, true)
        conflicting_items.set(o, true)
        let o_item = self.store.items[o]
        if opt_id_eq(item.origin, o_item.origin) {
          // Case 1: same origin -> lower client_id comes first
          if yata_same_origin_before(o_item.id.client, item.id.client) {
            left = o
            conflicting_items.clear()
          } else if opt_id_eq(item.right_origin, o_item.right_origin) {
            break
          }
        } else {
          match o_item.origin {
            Some(o_orig) => {
              let o_orig_idx = self.store.get_item_idx(o_orig)
              let in_before = match items_before_origin.get(o_orig_idx) {
                Some(_) => true
                None => false
              }
              if o_orig_idx >= 0 && in_before {
                // Case 2: o's origin is already in items_before_origin
                let in_conflict = match conflicting_items.get(o_orig_idx) {
                  Some(_) => true
                  None => false
                }
                if !in_conflict {
                  left = o
                  conflicting_items.clear()
                }
              } else {
                break
              }
            }
            None => break
          }
        }
        o = o_item.right
      }
    }
    item.left = left
  }

  // Reconnect left / right links and update parent.start or parent.map
  if item.left >= 0 {
    let r = self.store.items[item.left].right
    item.right = r
    self.store.items[item.left].right = item_idx
  } else {
    let r = match item.parent_sub {
      Some(sub) => {
        let mut cur = match parent.map.get(sub) {
          Some(v) => v
          None => -1
        }
        while cur >= 0 && self.store.items[cur].left >= 0 {
          cur = self.store.items[cur].left
        }
        cur
      }
      None => {
        let old_start = parent.start
        parent.start = item_idx
        old_start
      }
    }
    item.right = r
  }

  if item.right >= 0 {
    self.store.items[item.right].left = item_idx
  } else {
    match item.parent_sub {
      Some(sub) => {
        parent.map.set(sub, item_idx)
        if item.left >= 0 {
          // New winning map value: delete the previous entry
          self.delete_item(item.left)
        }
      }
      None => ()
    }
  }

  // Adjust parent length
  match item.parent_sub {
    None => {
      if item.countable && !item.deleted {
        parent.length = parent.length + item.len
      }
    }
    Some(_) => ()
  }

  // Register in BlockStore
  self.store.add_item_to_client(item_idx)

  // Content-specific integration
  match item.content {
    Content::Type(tid) => {
      self.types[tid].item_idx = item_idx
    }
    Content::Format(_, _) => {
      parent.has_format = true
    }
    Content::Deleted(n) => {
      item.deleted = true
      self.store.delete_set.add(item.id.client, item.id.clock, n)
    }
    _ => ()
  }

  // Delete if parent item is already deleted, or if this map entry lost to a right sibling
  let parent_deleted = parent.item_idx >= 0 &&
  self.store.items[parent.item_idx].deleted
  let map_lost = match item.parent_sub {
    Some(_) => item.right >= 0
    None => false
  }
  if parent_deleted || map_lost {
    self.delete_item(item_idx)
  }
}

///| Clear all search markers (both legacy array and 2-level chunk index).
fn clear_markers(parent : YTypeNode) -> Unit {
  if parent.markers.length() > 0 {
    parent.markers.clear()
  }
  if parent.marker_chunks.length() > 0 {
    parent.marker_chunks.clear()
  }
  parent.last_marker = -1
  parent.last_marker_item = -1
  parent.last_marker_idx = 0
}

fn array_insert_marker(
  arr : Array[SearchMarker],
  pos : Int,
  value : SearchMarker,
) -> Unit {
  arr.push(value)
  let mut i = arr.length() - 1
  while i > pos {
    arr[i] = arr[i - 1]
    i = i - 1
  }
  arr[pos] = value
}

fn array_insert_marker_chunk(
  arr : Array[MarkerChunk],
  pos : Int,
  value : MarkerChunk,
) -> Unit {
  arr.push(value)
  let mut i = arr.length() - 1
  while i > pos {
    arr[i] = arr[i - 1]
    i = i - 1
  }
  arr[pos] = value
}

fn array_remove_marker_chunk(arr : Array[MarkerChunk], pos : Int) -> Unit {
  let n = arr.length()
  let mut i = pos
  while i + 1 < n {
    arr[i] = arr[i + 1]
    i = i + 1
  }
  let _ = arr.pop()
}

///| Update 2-level search markers on `parent` after a local insert (`delta > 0`) or delete (`delta < 0`) at `index`.
fn update_markers(parent : YTypeNode, index : Int, delta : Int) -> Unit {
  if parent.markers.length() == 0 {
    if parent.marker_chunks.length() > 0 || parent.last_marker_item >= 0 {
      clear_markers(parent)
    }
    return
  }
  let chunks = parent.marker_chunks
  let nc = chunks.length()
  if delta > 0 {
    if parent.last_marker_item >= 0 && parent.last_marker_idx >= index {
      parent.last_marker_idx = parent.last_marker_idx + delta
    }
    if nc == 0 {
      return
    }
    // Binary search for first chunk whose max_index >= index
    let last_ch = chunks[nc - 1]
    let last_max = last_ch.items[last_ch.items.length() - 1].index + last_ch.offset
    if last_max < index {
      return
    }
    let mut lo = 0
    let mut hi = nc - 1
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let ch = chunks[mid]
      let max_i = ch.items[ch.items.length() - 1].index + ch.offset
      if max_i < index {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let ch = chunks[lo]
    let off = ch.offset
    let items = ch.items
    let mut i = 0
    while i < items.length() {
      let m = items[i]
      if m.index + off >= index {
        items[i] = SearchMarker::{
          item_idx: m.item_idx,
          index: m.index + delta,
          timestamp: m.timestamp,
        }
      }
      i = i + 1
    }
    let mut c = lo + 1
    while c < nc {
      chunks[c].offset = chunks[c].offset + delta
      c = c + 1
    }
  } else if delta < 0 {
    let del_end = index - delta
    if parent.last_marker_item >= 0 {
      if parent.last_marker_idx >= del_end {
        parent.last_marker_idx = parent.last_marker_idx + delta
      } else if parent.last_marker_idx >= index {
        parent.last_marker_item = -1
      }
    }
    if nc == 0 {
      return
    }
    let last_ch = chunks[nc - 1]
    let last_max = last_ch.items[last_ch.items.length() - 1].index + last_ch.offset
    if last_max < index {
      return
    }
    let mut lo = 0
    let mut hi = nc - 1
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let ch = chunks[mid]
      let max_i = ch.items[ch.items.length() - 1].index + ch.offset
      if max_i < index {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let mut c = lo
    while c < chunks.length() {
      let ch = chunks[c]
      let off = ch.offset
      let items = ch.items
      if items[0].index + off >= del_end {
        let mut k = c
        while k < chunks.length() {
          chunks[k].offset = chunks[k].offset + delta
          k = k + 1
        }
        return
      }
      let mut write_i = 0
      let mut read_i = 0
      let len = items.length()
      while read_i < len {
        let m = items[read_i]
        let abs_i = m.index + off
        if abs_i < index {
          if write_i != read_i {
            items[write_i] = m
          }
          write_i = write_i + 1
        } else if abs_i >= del_end {
          items[write_i] = SearchMarker::{
            item_idx: m.item_idx,
            index: m.index + delta,
            timestamp: m.timestamp,
          }
          write_i = write_i + 1
        }
        read_i = read_i + 1
      }
      while items.length() > write_i {
        let _ = items.pop()
      }
      if write_i == 0 {
        array_remove_marker_chunk(chunks, c)
      } else {
        c = c + 1
      }
    }
  }
}

///| Record or refresh a search marker `(item_idx, index)` in the 2-level sorted chunk index (up to 2,048 markers).
fn record_marker(parent : YTypeNode, item_idx : Int, index : Int) -> Unit {
  if item_idx < 0 {
    return
  }
  if parent.markers.length() == 0 {
    if parent.marker_chunks.length() > 0 {
      parent.marker_chunks.clear()
    }
    parent.markers.push(SearchMarker::{ item_idx: item_idx, index: index, timestamp: 0 })
  }
  parent.last_marker_item = item_idx
  parent.last_marker_idx = index
  let chunks = parent.marker_chunks
  let nc = chunks.length()
  if nc == 0 {
    let arr : Array[SearchMarker] = Array::with_capacity(32)
    arr.push(SearchMarker::{ item_idx: item_idx, index: index, timestamp: 0 })
    chunks.push(MarkerChunk::{ offset: 0, items: arr })
    return
  }
  // Find largest chunk c whose min_index <= index (or 0 if index < chunks[0].min)
  let mut lo = 0
  let mut hi = nc - 1
  if index >= chunks[0].items[0].index + chunks[0].offset {
    while lo < hi {
      let mid = lo + (hi - lo + 1) / 2
      let ch = chunks[mid]
      if ch.items[0].index + ch.offset <= index {
        lo = mid
      } else {
        hi = mid - 1
      }
    }
  }
  let ch = chunks[lo]
  let rel = index - ch.offset
  let items = ch.items
  let n = items.length()
  // Binary search in ch.items for first pos with items[pos].index >= rel
  let mut ilo = 0
  let mut ihi = n
  while ilo < ihi {
    let imid = ilo + (ihi - ilo) / 2
    if items[imid].index < rel {
      ilo = imid + 1
    } else {
      ihi = imid
    }
  }
  if ilo < n && items[ilo].index == rel {
    items[ilo] = SearchMarker::{ item_idx: item_idx, index: rel, timestamp: 0 }
    return
  }
  if n < 32 {
    array_insert_marker(
      items,
      ilo,
      SearchMarker::{ item_idx: item_idx, index: rel, timestamp: 0 },
    )
    return
  }
  if nc < 64 {
    let half = n / 2
    let right_arr : Array[SearchMarker] = Array::with_capacity(32)
    let mut k = half
    while k < n {
      right_arr.push(items[k])
      k = k + 1
    }
    while items.length() > half {
      let _ = items.pop()
    }
    array_insert_marker_chunk(
      chunks,
      lo + 1,
      MarkerChunk::{ offset: ch.offset, items: right_arr },
    )
    if ilo <= half {
      array_insert_marker(
        items,
        ilo,
        SearchMarker::{ item_idx: item_idx, index: rel, timestamp: 0 },
      )
    } else {
      array_insert_marker(
        right_arr,
        ilo - half,
        SearchMarker::{ item_idx: item_idx, index: rel, timestamp: 0 },
      )
    }
  } else {
    // Spatial eviction: overwrite nearest slot in chunk while strictly preserving sorted order
    let slot = if ilo < n { ilo } else { n - 1 }
    items[slot] = SearchMarker::{ item_idx: item_idx, index: rel, timestamp: 0 }
  }
}

///| Unboxed `(left, right)` item index pair for `find_insert_pos` / `find_array_elem`.
val struct ItemPair {
  left : Int
  right : Int
}

///| Compare `Option[Id]` against a known item's `id` (or `None` if `right_idx < 0`) without allocating `Some(Id)`.
fn opt_id_eq_item(opt : Option[Id], items : Array[Item], right_idx : Int) -> Bool {
  if right_idx < 0 {
    match opt {
      None => true
      Some(_) => false
    }
  } else {
    match opt {
      Some(id) => {
        let rid = items[right_idx].id
        id.client == rid.client && id.clock == rid.clock
      }
      None => false
    }
  }
}

///| Find `(left_idx, right_idx)` at container `index`, splitting an item if `index` falls inside it.
fn Doc::find_insert_pos(self : Doc, type_id : Int, target : Int) -> ItemPair {
  let parent = self.types[type_id]
  let idx = if target < 0 {
    0
  } else if target > parent.length {
    parent.length
  } else {
    target
  }
  if idx == 0 {
    return ItemPair::{ left: -1, right: parent.start }
  }
  if parent.markers.length() == 0 {
    if parent.marker_chunks.length() > 0 || parent.last_marker_item >= 0 {
      clear_markers(parent)
    }
  } else if parent.last_marker_item >= 0 {
    // O(1) fast path for sequential typing/appending via last_marker_item
    let litem = self.store.items[parent.last_marker_item]
    if !litem.deleted && litem.countable && parent.last_marker_idx + litem.len == idx {
      return ItemPair::{ left: parent.last_marker_item, right: litem.right }
    }
  }
  // Pick closest valid search marker via O(log M) binary search on 2-level marker_chunks
  let mut best_item = parent.start
  let mut best_idx = 0
  let mut best_dist = idx
  let chunks = parent.marker_chunks
  let nc = chunks.length()
  if nc > 0 {
    let mut clo = 0
    let mut chi = nc - 1
    if idx >= chunks[0].items[0].index + chunks[0].offset {
      while clo < chi {
        let cmid = clo + (chi - clo + 1) / 2
        let ch = chunks[cmid]
        if ch.items[0].index + ch.offset <= idx {
          clo = cmid
        } else {
          chi = cmid - 1
        }
      }
    }
    let ch = chunks[clo]
    let off = ch.offset
    let items = ch.items
    let n = items.length()
    let rel = idx - off
    let mut ilo = 0
    let mut ihi = n
    while ilo < ihi {
      let imid = ilo + (ihi - ilo) / 2
      if items[imid].index < rel {
        ilo = imid + 1
      } else {
        ihi = imid
      }
    }
    if ilo < n {
      let m = items[ilo]
      let mi = m.index + off
      let d = if mi > idx { mi - idx } else { idx - mi }
      if d < best_dist {
        best_dist = d
        best_item = m.item_idx
        best_idx = mi
      }
    }
    if ilo > 0 {
      let m = items[ilo - 1]
      let mi = m.index + off
      let d = if mi > idx { mi - idx } else { idx - mi }
      if d < best_dist {
        best_dist = d
        best_item = m.item_idx
        best_idx = mi
      }
    }
    if ilo == n && clo + 1 < nc {
      let nch = chunks[clo + 1]
      let m = nch.items[0]
      let mi = m.index + nch.offset
      let d = if mi > idx { mi - idx } else { idx - mi }
      if d < best_dist {
        best_dist = d
        best_item = m.item_idx
        best_idx = mi
      }
    }
  }

  let mut cur = best_item
  let mut cur_idx = best_idx

  // Walk backwards if marker is at or ahead of target (so we land on the non-deleted item ending at idx)
  while cur >= 0 && cur_idx >= idx {
    let prev = self.store.items[cur].left
    if prev < 0 {
      cur = parent.start
      cur_idx = 0
      break
    }
    cur = prev
    let pitem = self.store.items[cur]
    if !pitem.deleted && pitem.countable {
      cur_idx = cur_idx - pitem.len
    }
  }

  // Walk forwards until reaching idx
  let mut left = if cur >= 0 { self.store.items[cur].left } else { -1 }
  while cur >= 0 {
    let item = self.store.items[cur]
    if !item.deleted && item.countable {
      let next_idx = cur_idx + item.len
      if next_idx > idx {
        // Target falls inside this item! Split it if cur_idx < idx
        if cur_idx < idx {
          let diff = idx - cur_idx
          let right_idx = self.split_item(cur, diff)
          record_marker(parent, right_idx, idx)
          return ItemPair::{ left: cur, right: right_idx }
        }
        record_marker(parent, cur, cur_idx)
        return ItemPair::{ left: left, right: cur }
      }
      cur_idx = next_idx
      if cur_idx == idx {
        record_marker(parent, cur, cur_idx - item.len)
        return ItemPair::{ left: cur, right: item.right }
      }
    }
    left = cur
    cur = item.right
  }
  ItemPair::{ left: left, right: -1 }
}

///| Fast path for plain-text `YText::insert` (avoids `Content::Str` and `Option[Id]` boxing on in-place merge).
fn Doc::insert_text_at(self : Doc, type_id : Int, index : Int, chunk : String) -> Int {
  let len = utf16_len(chunk)
  if len <= 0 {
    return -1
  }
  let pos = self.find_insert_pos(type_id, index)
  let mut left_idx = pos.left
  let mut right_idx = pos.right
  while right_idx >= 0 && self.store.items[right_idx].deleted {
    left_idx = right_idx
    right_idx = self.store.items[right_idx].right
  }
  // Fast in-place merge for sequential typing (O(n) total, zero dead arena items, zero Content/Option[Id] boxing)
  if left_idx >= 0 {
    let left = self.store.items[left_idx]
    if !left.is_gc &&
    !left.deleted &&
    left.id.client == self.client_id &&
    left.right == right_idx &&
    left.parent_id == type_id &&
    opt_id_eq_item(left.right_origin, self.store.items, right_idx) {
      match (left.parent_sub, left.content) {
        (None, Content::Str(ls)) => {
          if ls.length() + chunk.length() <= 64 &&
          left.id.clock + left.len_u64 == self.store.get_clock(self.client_id) {
            let parent = self.types[type_id]
            let old_len = parent.length
            left.content = Content::Str(ls + chunk)
            left.len = left.len + len
            left.len_u64 = left.len_u64 + int_to_u64(len)
            parent.length = old_len + len
            if index < old_len {
              update_markers(parent, index, len)
            }
            return left_idx
          }
        }
        _ => ()
      }
    }
  }
  let origin = if left_idx >= 0 {
    Some(self.store.items[left_idx].last_id())
  } else {
    None
  }
  let right_origin = if right_idx >= 0 {
    Some(self.store.items[right_idx].id)
  } else {
    None
  }
  let clock = self.store.get_clock(self.client_id)
  let item_idx = self.store.items.length()
  let item = Item::{
    id: Id::{ client: self.client_id, clock: clock },
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    origin: origin,
    right_origin: right_origin,
    parent_id: type_id,
    parent_key: None,
    parent_item_id: None,
    parent_sub: None,
    deleted: false,
    countable: true,
    is_gc: false,
    content: Content::Str(chunk),
    raw_any_bytes: None,
  }
  self.store.items.push(item)
  let parent = self.types[type_id]
  if index < parent.length {
    update_markers(parent, index, len)
  }
  self.integrate_item(item_idx, true)
  record_marker(parent, item_idx, index)
  let _ = self.try_merge_with_left(item_idx)
  item_idx
}

///| Insert a local `Content` item into sequence container `type_id` at `index`.
///| When `skip_deleted` is true (Yjs YText `minimizeAttributeChanges`), advances past tombstones.
fn Doc::insert_content_at(
  self : Doc,
  type_id : Int,
  index : Int,
  content : Content,
  skip_deleted : Bool,
) -> Int {
  let len = content_len(content)
  if len <= 0 {
    return -1
  }
  let pos = self.find_insert_pos(type_id, index)
  let mut left_idx = pos.left
  let mut right_idx = pos.right
  if skip_deleted {
    while right_idx >= 0 && self.store.items[right_idx].deleted {
      left_idx = right_idx
      right_idx = self.store.items[right_idx].right
    }
  }
  // Fast in-place merge for sequential Content::Str typing (O(n) total, zero dead arena items)
  if left_idx >= 0 {
    match content {
      Content::Str(rs) => {
        let left = self.store.items[left_idx]
        if !left.is_gc &&
        !left.deleted &&
        left.id.client == self.client_id &&
        left.right == right_idx &&
        left.parent_id == type_id &&
        opt_id_eq_item(left.right_origin, self.store.items, right_idx) {
          match (left.parent_sub, left.content) {
            (None, Content::Str(ls)) => {
              if ls.length() + rs.length() <= 64 &&
              left.id.clock + left.len_u64 == self.store.get_clock(self.client_id) {
                let parent = self.types[type_id]
                let old_len = parent.length
                left.content = Content::Str(ls + rs)
                left.len = left.len + len
                left.len_u64 = left.len_u64 + int_to_u64(len)
                parent.length = old_len + len
                if index < old_len {
                  update_markers(parent, index, len)
                }
                return left_idx
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  let origin = if left_idx >= 0 {
    Some(self.store.items[left_idx].last_id())
  } else {
    None
  }
  let right_origin = if right_idx >= 0 {
    Some(self.store.items[right_idx].id)
  } else {
    None
  }
  let clock = self.store.get_clock(self.client_id)
  let item_idx = self.store.items.length()
  let countable = content_is_countable(content)
  let item = Item::{
    id: Id::{ client: self.client_id, clock: clock },
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    origin: origin,
    right_origin: right_origin,
    parent_id: type_id,
    parent_key: None,
    parent_item_id: None,
    parent_sub: None,
    deleted: false,
    countable: countable,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  self.store.items.push(item)
  let parent = self.types[type_id]
  if countable && index < parent.length {
    update_markers(parent, index, len)
  }
  self.integrate_item(item_idx, true)
  if countable {
    record_marker(parent, item_idx, index)
  }
  let _ = self.try_merge_with_left(item_idx)
  item_idx
}

///| Merge `right_idx` into `left_idx` when both are contiguous `Content::Deleted` tombstones from the same client.
///| Returns true if merged (`right_idx` is unlinked and removed from `ClientStore`).
fn Doc::try_merge_deleted_pair(self : Doc, left_idx : Int, right_idx : Int) -> Bool {
  if left_idx < 0 || right_idx < 0 {
    return false
  }
  let left = self.store.items[left_idx]
  let right = self.store.items[right_idx]
  if left.is_gc || right.is_gc || !left.deleted || !right.deleted {
    return false
  }
  if left.id.client != right.id.client {
    return false
  }
  if right.id.clock < left.id.clock || right.id.clock - left.id.clock != left.len_u64 {
    return false
  }
  if left.right != right_idx || left.parent_id != right.parent_id {
    return false
  }
  if !opt_id_eq(right.origin, Some(left.last_id())) {
    return false
  }
  if !opt_id_eq(left.right_origin, right.right_origin) {
    return false
  }
  match (left.parent_sub, right.parent_sub) {
    (None, None) => ()
    _ => return false
  }
  match (left.content, right.content) {
    (Content::Deleted(ln), Content::Deleted(rn)) => {
      let cs = self.store.get_or_create_client(left.id.client)
      cs.remove_clock(self.store.items, right.id.clock, right_idx)
      left.content = Content::Deleted(ln + rn)
      left.len = left.len + right.len
      left.len_u64 = left.len_u64 + right.len_u64
      left.right = right.right
      if left.right >= 0 {
        self.store.items[left.right].left = left_idx
      }
      if self.store.last_item_idx == right_idx {
        self.store.last_item_idx = left_idx
      }
      true
    }
    _ => false
  }
}

///| Delete `del_len` countable elements starting at `index` in sequence container `type_id`.
fn Doc::delete_range_at(
  self : Doc,
  type_id : Int,
  index : Int,
  del_len : Int,
) -> Unit {
  if del_len <= 0 {
    return
  }
  let parent = self.types[type_id]
  if index < 0 || index >= parent.length {
    return
  }
  let actual_len = if index + del_len > parent.length {
    parent.length - index
  } else {
    del_len
  }
  let pos = self.find_insert_pos(type_id, index)
  let start_left = pos.left
  let start_right = pos.right
  update_markers(parent, index, 0 - actual_len)
  let mut rem = actual_len
  let mut cur = start_right
  while cur >= 0 && rem > 0 {
    let item = self.store.items[cur]
    if !item.deleted && item.countable {
      if item.len > rem {
        let _ = self.split_item(cur, rem)
      }
      let step = self.store.items[cur].len
      self.delete_item(cur)
      rem = rem - step
      // Coalesce adjacent contiguous tombstones (both left and right) to prevent tombstone fragmentation
      let mut surviving = cur
      let right_cand = self.store.items[surviving].right
      if right_cand >= 0 && self.store.items[right_cand].deleted {
        let _ = self.try_merge_deleted_pair(surviving, right_cand)
      }
      let left_cand = self.store.items[surviving].left
      if left_cand >= 0 && self.store.items[left_cand].deleted {
        if self.try_merge_deleted_pair(left_cand, surviving) {
          surviving = left_cand
        }
      }
      cur = self.store.items[surviving].right
    } else {
      cur = item.right
    }
  }
  // Preserve a surviving marker adjacent to the deletion point so backward/sequential deletes stay O(1)
  if start_left >= 0 {
    let litem = self.store.items[start_left]
    if !litem.deleted && litem.countable && index >= litem.len {
      record_marker(parent, start_left, index - litem.len)
      return
    }
  }
  if cur >= 0 {
    let citem = self.store.items[cur]
    if !citem.deleted && citem.countable {
      record_marker(parent, cur, index)
    }
  }
}

// --- Rich-text cursor helpers (exact match with yjs/src/types/YText.js) ---

struct TextPos {
  mut left : Int
  mut right : Int
  mut index : Int
  current_attrs : Map[String, String]
}

fn update_current_attrs(attrs : Map[String, String], key : String, val_json : String) -> Unit {
  if val_json == "null" {
    attrs.remove(key)
  } else {
    attrs.set(key, val_json)
  }
}

fn get_attr_or_null(attrs : Map[String, String], key : String) -> String {
  match attrs.get(key) {
    Some(v) => v
    None => "null"
  }
}

fn text_pos_forward(doc : Doc, pos : TextPos) -> Unit {
  if pos.right < 0 {
    return
  }
  let item = doc.store.items[pos.right]
  if !item.deleted {
    match item.content {
      Content::Format(k, v) => update_current_attrs(pos.current_attrs, k, v)
      _ => {
        if item.countable {
          pos.index = pos.index + item.len
        }
      }
    }
  }
  pos.left = pos.right
  pos.right = item.right
}

fn find_text_pos(doc : Doc, type_id : Int, target : Int) -> TextPos {
  let parent = doc.types[type_id]
  let idx = if target < 0 {
    0
  } else if target > parent.length {
    parent.length
  } else {
    target
  }
  let pos = TextPos::{
    left: -1,
    right: parent.start,
    index: 0,
    current_attrs: Map::new(),
  }
  let mut rem = idx
  while pos.right >= 0 && rem > 0 {
    let item = doc.store.items[pos.right]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => update_current_attrs(pos.current_attrs, k, v)
        _ => {
          if item.countable {
            if rem < item.len {
              let _ = doc.split_item(pos.right, rem)
            }
            let step = doc.store.items[pos.right].len
            pos.index = pos.index + step
            rem = rem - step
          }
        }
      }
    }
    pos.left = pos.right
    pos.right = doc.store.items[pos.right].right
  }
  pos
}

fn Doc::insert_item_between(
  self : Doc,
  type_id : Int,
  left_idx : Int,
  right_idx : Int,
  content : Content,
) -> Int {
  let len = content_len(content)
  if len <= 0 {
    return -1
  }
  let origin = if left_idx >= 0 {
    Some(self.store.items[left_idx].last_id())
  } else {
    None
  }
  let right_origin = if right_idx >= 0 {
    Some(self.store.items[right_idx].id)
  } else {
    None
  }
  let clock = self.store.get_clock(self.client_id)
  let item_idx = self.store.items.length()
  let countable = content_is_countable(content)
  let item = Item::{
    id: Id::new(self.client_id, clock),
    len: len,
    len_u64: int_to_u64(len),
    left: left_idx,
    right: right_idx,
    origin: origin,
    right_origin: right_origin,
    parent_id: type_id,
    parent_key: None,
    parent_item_id: None,
    parent_sub: None,
    deleted: false,
    countable: countable,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  self.store.items.push(item)
  self.integrate_item(item_idx, true)
  item_idx
}

// --- YText API ---

///| Insert `chunk` at UTF-16 character `index` in this `YText`.
pub fn YText::insert(self : YText, doc : Doc, index : Int, chunk : String) -> Unit {
  if chunk.length() == 0 {
    return
  }
  let parent = doc.types[self.type_id]
  if !parent.has_format {
    let _ = doc.insert_text_at(self.type_id, index, chunk)
    return
  }
  // Rich-text path matching yjs YText.prototype.insert + minimizeAttributeChanges
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  // Default attributes = copy of current_attrs at pos
  let target_attrs : Map[String, String] = Map::new()
  let ks = pos.current_attrs.keys()
  let mut ki = 0
  while ki < ks.length() {
    match pos.current_attrs.get(ks[ki]) {
      Some(v) => target_attrs.set(ks[ki], v)
      None => ()
    }
    ki = ki + 1
  }
  // minimizeAttributeChanges: advance past deleted items and matching Content::Format items
  let mut keep = true
  while keep && pos.right >= 0 {
    let ritem = doc.store.items[pos.right]
    if ritem.deleted {
      text_pos_forward(doc, pos)
    } else {
      match ritem.content {
        Content::Format(k, v) => {
          if get_attr_or_null(target_attrs, k) == v {
            text_pos_forward(doc, pos)
          } else {
            keep = false
          }
        }
        _ => keep = false
      }
    }
  }
  let item_idx = doc.insert_item_between(
    self.type_id,
    pos.left,
    pos.right,
    Content::Str(chunk),
  )
  let _ = doc.try_merge_with_left(item_idx)
}

///| Append `chunk` to the end of this `YText`.
pub fn YText::push(self : YText, doc : Doc, chunk : String) -> Unit {
  let end_idx = doc.types[self.type_id].length
  self.insert(doc, end_idx, chunk)
}

fn copy_attrs_map(src : Map[String, String]) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  let ks = src.keys()
  let mut i = 0
  while i < ks.length() {
    match src.get(ks[i]) {
      Some(v) => out.set(ks[i], v)
      None => ()
    }
    i = i + 1
  }
  out
}

///| Clean up redundant formatting markers between `start_idx` and the next live countable item.
///| Exact match with yjs `cleanupFormattingGap`.
fn cleanup_formatting_gap(
  doc : Doc,
  start_idx : Int,
  curr_idx : Int,
  start_attrs : Map[String, String],
  curr_attrs : Map[String, String],
) -> Unit {
  if start_idx < 0 {
    return
  }
  let mut end_idx = start_idx
  let end_formats : Map[String, Int] = Map::new()
  while end_idx >= 0 {
    let eitem = doc.store.items[end_idx]
    if !eitem.deleted && eitem.countable {
      break
    }
    if !eitem.deleted {
      match eitem.content {
        Content::Format(k, _) => end_formats.set(k, end_idx)
        _ => ()
      }
    }
    end_idx = eitem.right
  }
  let mut cur = start_idx
  let mut reached_curr = false
  while cur >= 0 && cur != end_idx {
    if cur == curr_idx {
      reached_curr = true
    }
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => {
          let start_val = get_attr_or_null(start_attrs, k)
          let is_last_for_key = match end_formats.get(k) {
            Some(eid) => eid == cur
            None => false
          }
          if !is_last_for_key || start_val == v {
            doc.delete_item(cur)
            if !reached_curr && get_attr_or_null(curr_attrs, k) == v && start_val != v {
              update_current_attrs(curr_attrs, k, start_val)
            }
          }
          if !reached_curr && !doc.store.items[cur].deleted {
            update_current_attrs(curr_attrs, k, v)
          }
        }
        _ => ()
      }
    }
    cur = doc.store.items[cur].right
  }
}

///| Delete `len` UTF-16 code units starting at `index` in this `YText`.
pub fn YText::delete(self : YText, doc : Doc, index : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  let parent = doc.types[self.type_id]
  if !parent.has_format {
    doc.delete_range_at(self.type_id, index, len)
    return
  }
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  let start_attrs = copy_attrs_map(pos.current_attrs)
  let start_idx = pos.right
  let mut rem = len
  while rem > 0 && pos.right >= 0 {
    let r_idx = pos.right
    let item = doc.store.items[r_idx]
    if !item.deleted && item.countable {
      if rem < item.len {
        let _ = doc.split_item(r_idx, rem)
      }
      let step = doc.store.items[r_idx].len
      rem = rem - step
      doc.delete_item(r_idx)
    }
    text_pos_forward(doc, pos)
  }
  if start_idx >= 0 {
    cleanup_formatting_gap(doc, start_idx, pos.right, start_attrs, pos.current_attrs)
  }
}

///| Apply a formatting attribute `(key, val_json)` over `[index, index + len)`.
///| Matches yjs `formatText` / `insertAttributes` / `insertNegatedAttributes` semantics.
pub fn YText::format(
  self : YText,
  doc : Doc,
  index : Int,
  len : Int,
  key : String,
  val_json : String,
) -> Unit {
  if len <= 0 {
    return
  }
  let parent = doc.types[self.type_id]
  parent.has_format = true
  clear_markers(parent)
  let pos = find_text_pos(doc, self.type_id, index)
  // minimizeAttributeChanges for single attribute { key: val_json }
  let mut keep = true
  while keep && pos.right >= 0 {
    let ritem = doc.store.items[pos.right]
    if ritem.deleted {
      text_pos_forward(doc, pos)
    } else {
      match ritem.content {
        Content::Format(k, v) => {
          if k == key && v == val_json {
            text_pos_forward(doc, pos)
          } else {
            keep = false
          }
        }
        _ => keep = false
      }
    }
  }
  // insertAttributes: only insert opening Format if current value differs
  let cur_val = get_attr_or_null(pos.current_attrs, key)
  let mut negated : Option[String] = None
  if cur_val != val_json {
    negated = Some(cur_val)
    let fmt_idx = doc.insert_item_between(
      self.type_id,
      pos.left,
      pos.right,
      Content::Format(key, val_json),
    )
    pos.left = fmt_idx
    update_current_attrs(pos.current_attrs, key, val_json)
  }
  // Iterate over `len` countable units, deleting overridden/redundant Format items of `key`
  let mut rem = len
  while pos.right >= 0 && rem > 0 {
    let r_idx = pos.right
    let item = doc.store.items[r_idx]
    if !item.deleted {
      match item.content {
        Content::Format(k, v) => {
          if k == key {
            if v == val_json {
              negated = None
            } else {
              negated = Some(v)
            }
            doc.delete_item(r_idx)
            pos.left = r_idx
            pos.right = doc.store.items[r_idx].right
          } else {
            text_pos_forward(doc, pos)
          }
        }
        _ => {
          if item.countable {
            if rem < item.len {
              let _ = doc.split_item(r_idx, rem)
            }
            let step = doc.store.items[r_idx].len
            rem = rem - step
          }
          text_pos_forward(doc, pos)
        }
      }
    } else {
      text_pos_forward(doc, pos)
    }
  }
  // insertNegatedAttributes: restore outer attribute value at end of range
  match negated {
    Some(restore_val) => {
      let mut need_insert = true
      let mut cont = true
      while cont && pos.right >= 0 {
        let ritem = doc.store.items[pos.right]
        if ritem.deleted {
          text_pos_forward(doc, pos)
        } else {
          match ritem.content {
            Content::Format(k, v) => {
              if k == key && v == restore_val {
                need_insert = false
                text_pos_forward(doc, pos)
                cont = false
              } else {
                cont = false
              }
            }
            _ => cont = false
          }
        }
      }
      if need_insert {
        let _ = doc.insert_item_between(
          self.type_id,
          pos.left,
          pos.right,
          Content::Format(key, restore_val),
        )
      }
    }
    None => ()
  }
}

///| Return current UTF-16 length of this `YText`.
pub fn YText::len(self : YText, doc : Doc) -> Int {
  doc.types[self.type_id].length
}

///| Materialize this `YText` as a `String`.
pub fn YText::to_string(self : YText, doc : Doc) -> String {
  let sb = StringBuilder::new()
  let mut cur = doc.types[self.type_id].start
  while cur >= 0 {
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        Content::Str(s) => sb.write_string(s)
        _ => ()
      }
    }
    cur = item.right
  }
  sb.to_string()
}

// --- YArray API ---

///| Insert a single `Any` element at `index`.
pub fn YArray::insert(self : YArray, doc : Doc, index : Int, value : Any) -> Unit {
  let arr : Array[Any] = Array::new()
  arr.push(value)
  let _ = doc.insert_content_at(self.type_id, index, Content::AnyList(arr), false)
}

///| Insert multiple `Any` elements starting at `index`.
pub fn YArray::insert_range(
  self : YArray,
  doc : Doc,
  index : Int,
  values : Array[Any],
) -> Unit {
  if values.length() == 0 {
    return
  }
  let copy : Array[Any] = Array::new()
  let mut i = 0
  while i < values.length() {
    copy.push(values[i])
    i = i + 1
  }
  let _ = doc.insert_content_at(self.type_id, index, Content::AnyList(copy), false)
}

///| Append a single `Any` element to the end of this `YArray`.
pub fn YArray::push(self : YArray, doc : Doc, value : Any) -> Unit {
  let end_idx = doc.types[self.type_id].length
  self.insert(doc, end_idx, value)
}

///| Insert a new nested `YText` at `index` and return its handle.
pub fn YArray::insert_text(self : YArray, doc : Doc, index : Int) -> YText {
  let tid = doc.alloc_nested_type(TypeRef::YTextRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YText::{ type_id: tid }
}

///| Insert a new nested `YArray` at `index` and return its handle.
pub fn YArray::insert_array(self : YArray, doc : Doc, index : Int) -> YArray {
  let tid = doc.alloc_nested_type(TypeRef::YArrayRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YArray::{ type_id: tid }
}

///| Insert a new nested `YMap` at `index` and return its handle.
pub fn YArray::insert_map(self : YArray, doc : Doc, index : Int) -> YMap {
  let tid = doc.alloc_nested_type(TypeRef::YMapRef)
  let _ = doc.insert_content_at(self.type_id, index, Content::Type(tid), false)
  YMap::{ type_id: tid }
}

///| Delete `len` elements starting at `index`.
pub fn YArray::delete(self : YArray, doc : Doc, index : Int, len : Int) -> Unit {
  doc.delete_range_at(self.type_id, index, len)
}

///| Locate `(item_idx, offset_in_item)` for live element `index` in a `YArray`.
fn find_array_elem(doc : Doc, type_id : Int, index : Int) -> ItemPair {
  if index < 0 || index >= doc.types[type_id].length {
    return ItemPair::{ left: -1, right: 0 }
  }
  let mut cur = doc.types[type_id].start
  let mut pos = 0
  while cur >= 0 {
    let item = doc.store.items[cur]
    if !item.deleted && item.countable {
      if pos + item.len > index {
        return ItemPair::{ left: cur, right: index - pos }
      }
      pos = pos + item.len
    }
    cur = item.right
  }
  ItemPair::{ left: -1, right: 0 }
}

///| Read the `Any` element at `index`, if present and an `Any` value.
pub fn YArray::get(self : YArray, doc : Doc, index : Int) -> Option[Any] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::AnyList(arr) => Some(arr[p.right])
    Content::Binary(b) => Some(Any::Binary(b))
    _ => None
  }
}

///| Read a nested `YText` at `index`.
pub fn YArray::get_text(self : YArray, doc : Doc, index : Int) -> Option[YText] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YText::{ type_id: tid })
    _ => None
  }
}

///| Read a nested `YArray` at `index`.
pub fn YArray::get_array(self : YArray, doc : Doc, index : Int) -> Option[YArray] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YArray::{ type_id: tid })
    _ => None
  }
}

///| Read a nested `YMap` at `index`.
pub fn YArray::get_map(self : YArray, doc : Doc, index : Int) -> Option[YMap] {
  let p = find_array_elem(doc, self.type_id, index)
  if p.left < 0 {
    return None
  }
  match doc.store.items[p.left].content {
    Content::Type(tid) => Some(YMap::{ type_id: tid })
    _ => None
  }
}

///| Return current element count of this `YArray`.
pub fn YArray::len(self : YArray, doc : Doc) -> Int {
  doc.types[self.type_id].length
}

///| Materialize all `Any` elements in this `YArray`.
pub fn YArray::to_array(self : YArray, doc : Doc) -> Array[Any] {
  let out : Array[Any] = Array::new()
  let mut cur = doc.types[self.type_id].start
  while cur >= 0 {
    let item = doc.store.items[cur]
    if !item.deleted {
      match item.content {
        Content::AnyList(arr) => {
          let mut i = 0
          while i < arr.length() {
            out.push(arr[i])
            i = i + 1
          }
        }
        Content::Binary(b) => out.push(Any::Binary(b))
        _ => ()
      }
    }
    cur = item.right
  }
  out
}

// --- YMap API ---

///| Internal helper: set `key` in `YMap` `type_id` to `content`.
fn Doc::map_set_content(
  self : Doc,
  type_id : Int,
  key : String,
  content : Content,
) -> Int {
  let parent = self.types[type_id]
  let left_idx = match parent.map.get(key) {
    Some(idx) => idx
    None => -1
  }
  let origin = if left_idx >= 0 {
    Some(self.store.items[left_idx].last_id())
  } else {
    None
  }
  let clock = self.store.get_clock(self.client_id)
  let item_idx = self.store.items.length()
  let item = Item::{
    id: Id::new(self.client_id, clock),
    len: content_len(content),
    len_u64: content_len_u64(content),
    left: left_idx,
    right: -1,
    origin: origin,
    right_origin: None,
    parent_id: type_id,
    parent_key: None,
    parent_item_id: None,
    parent_sub: Some(key),
    deleted: false,
    countable: true,
    is_gc: false,
    content: content,
    raw_any_bytes: None,
  }
  self.store.items.push(item)
  self.integrate_item(item_idx, true)
  item_idx
}

///| Set `key` to an `Any` value in this `YMap`.
pub fn YMap::set(self : YMap, doc : Doc, key : String, value : Any) -> Unit {
  let arr : Array[Any] = Array::new()
  arr.push(value)
  let _ = doc.map_set_content(self.type_id, key, Content::AnyList(arr))
}

///| Set `key` to a new nested `YText` and return its handle.
pub fn YMap::set_text(self : YMap, doc : Doc, key : String) -> YText {
  let tid = doc.alloc_nested_type(TypeRef::YTextRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YText::{ type_id: tid }
}

///| Set `key` to a new nested `YArray` and return its handle.
pub fn YMap::set_array(self : YMap, doc : Doc, key : String) -> YArray {
  let tid = doc.alloc_nested_type(TypeRef::YArrayRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YArray::{ type_id: tid }
}

///| Set `key` to a new nested `YMap` and return its handle.
pub fn YMap::set_map(self : YMap, doc : Doc, key : String) -> YMap {
  let tid = doc.alloc_nested_type(TypeRef::YMapRef)
  let _ = doc.map_set_content(self.type_id, key, Content::Type(tid))
  YMap::{ type_id: tid }
}

///| Get the `Any` value stored at `key`.
pub fn YMap::get(self : YMap, doc : Doc, key : String) -> Option[Any] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::AnyList(arr) => {
          if arr.length() > 0 {
            Some(arr[arr.length() - 1])
          } else {
            None
          }
        }
        Content::Binary(b) => Some(Any::Binary(b))
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YText` stored at `key`.
pub fn YMap::get_text(self : YMap, doc : Doc, key : String) -> Option[YText] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YText::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YArray` stored at `key`.
pub fn YMap::get_array(self : YMap, doc : Doc, key : String) -> Option[YArray] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YArray::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Get a nested `YMap` stored at `key`.
pub fn YMap::get_map(self : YMap, doc : Doc, key : String) -> Option[YMap] {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      let item = doc.store.items[idx]
      if item.deleted {
        return None
      }
      match item.content {
        Content::Type(tid) => Some(YMap::{ type_id: tid })
        _ => None
      }
    }
    None => None
  }
}

///| Delete `key` from this `YMap`.
pub fn YMap::delete(self : YMap, doc : Doc, key : String) -> Unit {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => {
      if !doc.store.items[idx].deleted {
        doc.delete_item(idx)
      }
    }
    None => ()
  }
}

///| Return true if `key` is currently present (not deleted).
pub fn YMap::contains_key(self : YMap, doc : Doc, key : String) -> Bool {
  match doc.types[self.type_id].map.get(key) {
    Some(idx) => !doc.store.items[idx].deleted
    None => false
  }
}

///| Return number of live keys in this `YMap`.
pub fn YMap::len(self : YMap, doc : Doc) -> Int {
  let parent = doc.types[self.type_id]
  let ks = parent.map.keys()
  let mut count = 0
  let mut i = 0
  while i < ks.length() {
    match parent.map.get(ks[i]) {
      Some(idx) => {
        if !doc.store.items[idx].deleted {
          count = count + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
  count
}

///| Return sorted live keys of this `YMap`.
pub fn YMap::keys(self : YMap, doc : Doc) -> Array[String] {
  let parent = doc.types[self.type_id]
  let ks = parent.map.keys()
  let out : Array[String] = Array::new()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match parent.map.get(k) {
      Some(idx) => {
        if !doc.store.items[idx].deleted {
          out.push(k)
        }
      }
      None => ()
    }
    i = i + 1
  }
  sort_strings(out)
  out
}

///| Materialize live `Any` entries of this `YMap`.
pub fn YMap::to_map(self : YMap, doc : Doc) -> Map[String, Any] {
  let out : Map[String, Any] = Map::new()
  let ks = self.keys(doc)
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match self.get(doc, k) {
      Some(v) => out.set(k, v)
      None => ()
    }
    i = i + 1
  }
  out
}
