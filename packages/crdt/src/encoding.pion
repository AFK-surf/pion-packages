///| Yjs v1 binary wire protocol encoding, decoding, diffing, and merging.

///| Encode a document's state vector in Yjs v1 format.
pub fn encode_state_vector(doc : Doc) -> Bytes {
  let _ = doc
  Bytes::new(0)
}

///| Decode a Yjs v1 binary state vector.
pub fn decode_state_vector(data : Bytes) -> Result[StateVector, CrdtError] {
  let _ = data
  Err(stub_err())
}

///| Encode document state (optionally relative to `target_sv`) as a Yjs v1 binary update.
pub fn encode_state_as_update(
  doc : Doc,
  target_sv : Option[Bytes],
) -> Result[Bytes, CrdtError] {
  let _ = doc
  let _ = target_sv
  Err(stub_err())
}

///| Decode and apply a Yjs v1 binary update to `doc`.
pub fn apply_update(doc : Doc, update : Bytes) -> Result[Unit, CrdtError] {
  let _ = doc
  let _ = update
  Err(stub_err())
}

///| Merge multiple Yjs v1 binary updates into a single deduplicated v1 update.
pub fn merge_updates(updates : Array[Bytes]) -> Result[Bytes, CrdtError] {
  let _ = updates
  Err(stub_err())
}

///| Filter a Yjs v1 binary update to only operations missing from `target_sv`.
pub fn diff_update(update : Bytes, target_sv : Bytes) -> Result[Bytes, CrdtError] {
  let _ = update
  let _ = target_sv
  Err(stub_err())
}
