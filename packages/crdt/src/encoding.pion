///| Yjs v1 binary wire protocol encoding, decoding, diffing, and merging.

// --- Yjs v1 Item Info Byte Codec ---

///| Pack a Yjs v1 wire item info byte from content ref ID (`0..=31`) and origin/parent-sub flags.
#verify
pub fn encode_item_info(
  ref_id : Int,
  has_orig : Bool,
  has_rorig : Bool,
  has_psub : Bool,
) -> Int {
  let b_orig = if has_orig { 0x80 } else { 0 }
  let b_rorig = if has_rorig { 0x40 } else { 0 }
  let b_psub = if has_psub { 0x20 } else { 0 }
  (ref_id & 0x1f) | b_orig | b_rorig | b_psub
}

///| Extract the 5-bit content ref ID (`0..=31`) from a Yjs v1 wire info byte.
#verify
pub fn info_ref_id(info : Int) -> Int {
  info & 0x1f
}

///| Check whether a Yjs v1 wire info byte indicates an explicit left `origin` (bit 7).
pub fn info_has_origin(info : Int) -> Bool {
  (info & 0x80) != 0
}

///| Check whether a Yjs v1 wire info byte indicates an explicit `right_origin` (bit 6).
pub fn info_has_right_origin(info : Int) -> Bool {
  (info & 0x40) != 0
}

///| Check whether a Yjs v1 wire info byte indicates a `parent_sub` key (bit 5).
pub fn info_has_parent_sub(info : Int) -> Bool {
  (info & 0x20) != 0
}

///| Check whether a Yjs v1 wire item must carry an explicit parent (neither origin nor right_origin set).
pub fn info_cant_copy_parent(info : Int) -> Bool {
  !info_has_origin(info) && !info_has_right_origin(info)
}

// --- StateVector v1 codec ---

///| Encode a document's state vector in Yjs v1 format (zero `.keys()` or hash lookup per client, O(C log C) sort for C >= 3).
pub fn encode_state_vector(doc : Doc) -> Bytes {
  let cids = doc.store.client_ids
  let clist = doc.store.client_list
  let n_clients = cids.length()
  if n_clients == 0 {
    let sb = StringBuilder::with_capacity(16)
    sb.write_byte((0).to_byte())
    return sb.take_bytes()
  }
  let i_clocks = doc.store.item_clock
  let i_lens = doc.store.item_len_u64
  if n_clients == 1 {
    let clk = clist[0].get_clock(i_clocks, i_lens)
    let sb = StringBuilder::with_capacity(32)
    if clk > 0UL {
      sb.write_byte((1).to_byte())
      put_var_uint_sb(sb, cids[0])
      put_var_uint_sb(sb, clk)
    } else {
      sb.write_byte((0).to_byte())
    }
    return sb.take_bytes()
  }
  if n_clients == 2 {
    let c0 = cids[0]
    let k0 = clist[0].get_clock(i_clocks, i_lens)
    let c1 = cids[1]
    let k1 = clist[1].get_clock(i_clocks, i_lens)
    let sb = StringBuilder::with_capacity(40)
    if k0 > 0UL && k1 > 0UL {
      sb.write_byte((2).to_byte())
      if c0 >= c1 {
        put_var_uint_sb(sb, c0)
        put_var_uint_sb(sb, k0)
        put_var_uint_sb(sb, c1)
        put_var_uint_sb(sb, k1)
      } else {
        put_var_uint_sb(sb, c1)
        put_var_uint_sb(sb, k1)
        put_var_uint_sb(sb, c0)
        put_var_uint_sb(sb, k0)
      }
    } else if k0 > 0UL {
      sb.write_byte((1).to_byte())
      put_var_uint_sb(sb, c0)
      put_var_uint_sb(sb, k0)
    } else if k1 > 0UL {
      sb.write_byte((1).to_byte())
      put_var_uint_sb(sb, c1)
      put_var_uint_sb(sb, k1)
    } else {
      sb.write_byte((0).to_byte())
    }
    return sb.take_bytes()
  }
  let clients : Array[UInt64] = Array::with_capacity(n_clients)
  let clocks : Array[UInt64] = Array::with_capacity(n_clients)
  let mut i = 0
  while i < n_clients {
    let clk = clist[i].get_clock(i_clocks, i_lens)
    if clk > 0UL {
      clients.push(cids[i])
      clocks.push(clk)
    }
    i = i + 1
  }
  let cn = clients.length()
  if cn > 1 {
    sort_u64_pairs_desc(clients, clocks)
  }
  let sb = StringBuilder::with_capacity(16 + cn * 12)
  put_var_uint_sb(sb, int_to_u64(cn))
  i = 0
  while i < cn {
    put_var_uint_sb(sb, clients[i])
    put_var_uint_sb(sb, clocks[i])
    i = i + 1
  }
  sb.take_bytes()
}

///| Decode a Yjs v1 binary state vector (zero Result boxing in hot loop).
pub fn decode_state_vector(data : Bytes) -> Result[StateVector, CrdtError] {
  let dec = Decoder::new(data)
  let count_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  let rem = dec.remaining().to_int64().to_uint64()
  if count_u > rem {
    return Err(CrdtError::new("EOF", "state vector client count exceeds buffer"))
  }
  let count = count_u.to_int()
  let sv = StateVector::new()
  let mut i = 0
  while i < count {
    let client = dec.read_var_uint_raw()
    let clock = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    sv.set(client, clock)
    i = i + 1
  }
  Ok(sv)
}

// --- DeleteSet v1 codec ---

///| Write a `DeleteSet` directly to `sb` in Yjs v1 wire format.
fn write_delete_set_sb(sb : StringBuilder, ds : DeleteSet) -> Unit {
  let n_clients = ds.clients.length()
  if n_clients == 0 {
    sb.write_byte((0).to_byte())
    return
  }
  ds.ensure_sorted()
  if n_clients == 1 && ds.has_cached {
    let ranges = ds.cached_arr
    let rn = ranges.length()
    if rn == 0 {
      sb.write_byte((0).to_byte())
      return
    }
    sb.write_byte((1).to_byte())
    write_var_uint_sb(sb, ds.cached_client.to_uint64())
    write_var_uint_sb(sb, int_to_u64(rn))
    let mut j = 0
    while j < rn {
      let r = ranges[j]
      write_var_uint_sb(sb, r.clock)
      write_var_uint_sb(sb, r.len)
      j = j + 1
    }
    return
  }
  let ks = ds.clients.keys()
  let clients : Array[UInt64] = Array::with_capacity(ks.length())
  let mut i = 0
  while i < ks.length() {
    match ds.clients.get(ks[i]) {
      Some(arr) => {
        if arr.length() > 0 {
          clients.push(ks[i].to_uint64())
        }
      }
      None => ()
    }
    i = i + 1
  }
  if clients.length() > 1 {
    sort_u64_desc(clients)
  }
  write_var_uint_sb(sb, int_to_u64(clients.length()))
  i = 0
  while i < clients.length() {
    let c = clients[i]
    match ds.clients.get(c.to_int64()) {
      Some(ranges) => {
        let rn = ranges.length()
        write_var_uint_sb(sb, c)
        write_var_uint_sb(sb, int_to_u64(rn))
        let mut j = 0
        while j < rn {
          let r = ranges[j]
          write_var_uint_sb(sb, r.clock)
          write_var_uint_sb(sb, r.len)
          j = j + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
}

///| Write a `DeleteSet` in Yjs v1 wire format.
fn write_delete_set(enc : Encoder, ds : DeleteSet) -> Unit {
  write_delete_set_sb(enc.sb, ds)
}

///| Read a `DeleteSet` in Yjs v1 wire format (zero Result boxing in hot loop).
fn read_delete_set(dec : Decoder) -> Result[DeleteSet, CrdtError] {
  let ds = DeleteSet::new()
  let num_clients_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  if num_clients_u > dec.remaining().to_int64().to_uint64() {
    return Err(CrdtError::new("EOF", "delete set client count exceeds buffer"))
  }
  let num_clients = num_clients_u.to_int()
  let mut i = 0
  while i < num_clients {
    let client = dec.read_var_uint_raw()
    let num_dels_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_dels_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "delete set range count exceeds buffer"))
    }
    let num_dels = num_dels_u.to_int()
    let mut j = 0
    while j < num_dels {
      let clock = dec.read_var_uint_raw()
      let len = dec.read_var_uint_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      if len > 18446744073709551615UL - clock {
        return Err(CrdtError::new("OVERFLOW", "delete item clock + len overflow"))
      }
      ds.add(client, clock, len)
      j = j + 1
    }
    i = i + 1
  }
  Ok(ds)
}

// --- Raw wire block representation (for lossless decode, merge_updates, diff_update) ---

///| Decoded wire content before binding to a `Doc`'s type arena.
enum RawContent {
  RawGc(UInt64)
  RawSkip(UInt64)
  RawDeleted(UInt64)
  RawJson(Array[String])
  RawBinary(Bytes)
  RawStr(String)
  RawEmbed(String)
  RawFormat(String, String)
  RawType(Int, Option[String])
  RawAnyList(Array[Any])
  RawDoc(String, Any)
}

///| Decoded wire block (item, GC, or Skip) from a Yjs v1 update (unboxed Id fields, zero Option[Id] heap boxing).
struct RawBlock {
  id : Id
  len : UInt64
  has_origin : Bool
  origin : Id
  has_right_origin : Bool
  right_origin : Id
  parent_is_key : Bool
  parent_key : Option[String]
  has_parent_id : Bool
  parent_id : Id
  parent_sub : Option[String]
  has_parent_sub_bit : Bool
  content : RawContent
  raw_any_bytes : Option[Array[Bytes]]
}

fn empty_id() -> Id {
  Id::{ client: 0UL, clock: 0UL }
}

fn raw_content_ref_id(c : RawContent) -> Int {
  match c {
    RawContent::RawGc(_) => 0
    RawContent::RawDeleted(_) => 1
    RawContent::RawJson(_) => 2
    RawContent::RawBinary(_) => 3
    RawContent::RawStr(_) => 4
    RawContent::RawEmbed(_) => 5
    RawContent::RawFormat(_, _) => 6
    RawContent::RawType(_, _) => 7
    RawContent::RawAnyList(_) => 8
    RawContent::RawDoc(_, _) => 9
    RawContent::RawSkip(_) => 10
  }
}

fn raw_content_len(c : RawContent) -> UInt64 {
  match c {
    RawContent::RawGc(n) => n
    RawContent::RawSkip(n) => n
    RawContent::RawDeleted(n) => n
    RawContent::RawJson(arr) => int_to_u64(arr.length())
    RawContent::RawBinary(_) => 1UL
    RawContent::RawStr(s) => int_to_u64(utf16_len(s))
    RawContent::RawEmbed(_) => 1UL
    RawContent::RawFormat(_, _) => 1UL
    RawContent::RawType(_, _) => 1UL
    RawContent::RawAnyList(arr) => int_to_u64(arr.length())
    RawContent::RawDoc(_, _) => 1UL
  }
}

fn slice_raw_content(c : RawContent, offset : UInt64, new_len : UInt64) -> RawContent {
  match c {
    RawContent::RawGc(_) => RawContent::RawGc(new_len)
    RawContent::RawSkip(_) => RawContent::RawSkip(new_len)
    RawContent::RawDeleted(_) => RawContent::RawDeleted(new_len)
    RawContent::RawStr(s) => {
      let off = offset.to_int()
      let nl = new_len.to_int()
      RawContent::RawStr(utf16_slice(s, off, off + nl))
    }
    RawContent::RawAnyList(arr) => {
      let off = offset.to_int()
      let nl = new_len.to_int()
      let out : Array[Any] = Array::new()
      let mut i = off
      while i < off + nl && i < arr.length() {
        out.push(arr[i])
        i = i + 1
      }
      RawContent::RawAnyList(out)
    }
    RawContent::RawJson(arr) => {
      let off = offset.to_int()
      let nl = new_len.to_int()
      let out : Array[String] = Array::new()
      let mut i = off
      while i < off + nl && i < arr.length() {
        out.push(arr[i])
        i = i + 1
      }
      RawContent::RawJson(out)
    }
    _ => c
  }
}

fn slice_raw_block(b : RawBlock, offset : UInt64, new_len : UInt64) -> RawBlock {
  if offset == 0UL && new_len == b.len {
    return b
  }
  let new_has_origin = if offset > 0UL { true } else { b.has_origin }
  let new_origin = if offset > 0UL {
    Id::{ client: b.id.client, clock: b.id.clock + offset - 1UL }
  } else {
    b.origin
  }
  let new_has_right_origin = if offset + new_len < b.len {
    false
  } else {
    b.has_right_origin
  }
  let new_right_origin = if offset + new_len < b.len {
    empty_id()
  } else {
    b.right_origin
  }
  let sliced_raw_any : Option[Array[Bytes]] = match b.raw_any_bytes {
    Some(raws) => {
      let off = offset.to_int()
      let nl = new_len.to_int()
      let out : Array[Bytes] = Array::with_capacity(nl)
      let mut i = off
      while i < off + nl && i < raws.length() {
        out.push(raws[i])
        i = i + 1
      }
      Some(out)
    }
    None => None
  }
  RawBlock::{
    id: Id::{ client: b.id.client, clock: b.id.clock + offset },
    len: new_len,
    has_origin: new_has_origin,
    origin: new_origin,
    has_right_origin: new_has_right_origin,
    right_origin: new_right_origin,
    parent_is_key: b.parent_is_key,
    parent_key: b.parent_key,
    has_parent_id: b.has_parent_id,
    parent_id: b.parent_id,
    parent_sub: b.parent_sub,
    has_parent_sub_bit: b.has_parent_sub_bit,
    content: slice_raw_content(b.content, offset, new_len),
    raw_any_bytes: sliced_raw_any,
  }
}

fn write_raw_block(enc : Encoder, b : RawBlock) -> Unit {
  match b.content {
    RawContent::RawGc(n) => {
      enc.write_uint8(0)
      enc.write_var_uint(n)
      return
    }
    RawContent::RawSkip(n) => {
      enc.write_uint8(10)
      enc.write_var_uint(n)
      return
    }
    _ => ()
  }
  let ref_id = raw_content_ref_id(b.content)
  let has_orig = b.has_origin
  let has_rorig = b.has_right_origin
  let has_psub = if b.has_parent_sub_bit {
    true
  } else {
    match b.parent_sub {
      Some(_) => true
      None => false
    }
  }
  enc.write_uint8(encode_item_info(ref_id, has_orig, has_rorig, has_psub))
  if has_orig {
    enc.write_var_uint(b.origin.client)
    enc.write_var_uint(b.origin.clock)
  }
  if has_rorig {
    enc.write_var_uint(b.right_origin.client)
    enc.write_var_uint(b.right_origin.clock)
  }
  if !has_orig && !has_rorig {
    if b.parent_is_key {
      enc.write_var_uint(1UL)
      match b.parent_key {
        Some(k) => enc.write_var_string(k)
        None => enc.write_var_string("")
      }
    } else {
      enc.write_var_uint(0UL)
      if b.has_parent_id {
        enc.write_var_uint(b.parent_id.client)
        enc.write_var_uint(b.parent_id.clock)
      } else {
        enc.write_var_uint(0UL)
        enc.write_var_uint(0UL)
      }
    }
    match b.parent_sub {
      Some(sub) => enc.write_var_string(sub)
      None => ()
    }
  }
  match b.content {
    RawContent::RawDeleted(n) => enc.write_var_uint(n)
    RawContent::RawJson(arr) => {
      enc.write_var_uint(int_to_u64(arr.length()))
      let mut i = 0
      while i < arr.length() {
        enc.write_var_string(arr[i])
        i = i + 1
      }
    }
    RawContent::RawBinary(buf) => enc.write_var_bytes(buf)
    RawContent::RawStr(s) => enc.write_var_string(s)
    RawContent::RawEmbed(s) => enc.write_var_string(s)
    RawContent::RawFormat(k, v) => {
      enc.write_var_string(k)
      enc.write_var_string(v)
    }
    RawContent::RawType(tr, node_name) => {
      enc.write_var_uint(int_to_u64(tr))
      if tr == 3 || tr == 5 {
        match node_name {
          Some(name) => enc.write_var_string(name)
          None => enc.write_var_string("")
        }
      }
    }
    RawContent::RawAnyList(arr) => {
      enc.write_var_uint(int_to_u64(arr.length()))
      let mut i = 0
      while i < arr.length() {
        let mut wrote_raw = false
        match b.raw_any_bytes {
          Some(raws) => {
            if i < raws.length() && raws[i].length() > 0 {
              enc.write_bytes(raws[i])
              wrote_raw = true
            }
          }
          None => ()
        }
        if !wrote_raw {
          enc.write_any(arr[i])
        }
        i = i + 1
      }
    }
    RawContent::RawDoc(guid, opts) => {
      enc.write_var_string(guid)
      enc.write_any(opts)
    }
    _ => ()
  }
}

///| Reusable scratch slot to avoid per-block `(RawContent, Option[Array[Bytes]])` tuple boxing.
struct RawContentOut {
  mut raw_any : Option[Array[Bytes]]
  mut len_u : UInt64
}

fn read_raw_content_raw(
  dec : Decoder,
  ref_id : Int,
  out : RawContentOut,
) -> RawContent {
  out.raw_any = None
  match ref_id {
    1 => {
      let n = dec.read_var_uint_raw()
      out.len_u = n
      RawContent::RawDeleted(n)
    }
    2 => {
      let n_u = dec.read_var_uint_raw()
      if dec.has_err {
        return RawContent::RawDeleted(0UL)
      }
      if n_u > dec.remaining().to_int64().to_uint64() {
        dec.set_err("EOF", "json array length exceeds buffer")
        return RawContent::RawDeleted(0UL)
      }
      let n = n_u.to_int()
      let arr : Array[String] = Array::with_capacity(n)
      let mut i = 0
      while i < n {
        let s = dec.read_var_string_raw()
        if dec.has_err {
          return RawContent::RawDeleted(0UL)
        }
        arr.push(s)
        i = i + 1
      }
      out.len_u = n_u
      RawContent::RawJson(arr)
    }
    3 => {
      let b = dec.read_var_bytes_raw()
      out.len_u = 1UL
      RawContent::RawBinary(b)
    }
    4 => {
      let s = dec.read_var_string_raw()
      out.len_u = int_to_u64(dec.last_utf16_len)
      RawContent::RawStr(s)
    }
    5 => {
      let s = dec.read_var_string_raw()
      out.len_u = 1UL
      RawContent::RawEmbed(s)
    }
    6 => {
      let k = dec.read_var_string_raw()
      if dec.has_err {
        return RawContent::RawDeleted(0UL)
      }
      let v = dec.read_var_string_raw()
      out.len_u = 1UL
      RawContent::RawFormat(k, v)
    }
    7 => {
      let tr_u = dec.read_var_uint_raw()
      if dec.has_err {
        return RawContent::RawDeleted(0UL)
      }
      let tr = tr_u.to_int()
      out.len_u = 1UL
      if tr == 3 || tr == 5 {
        let name = dec.read_var_string_raw()
        RawContent::RawType(tr, Some(name))
      } else {
        RawContent::RawType(tr, None)
      }
    }
    8 => {
      let n_u = dec.read_var_uint_raw()
      if dec.has_err {
        return RawContent::RawDeleted(0UL)
      }
      if n_u > dec.remaining().to_int64().to_uint64() {
        dec.set_err("EOF", "any list length exceeds buffer")
        return RawContent::RawDeleted(0UL)
      }
      let n = n_u.to_int()
      let arr : Array[Any] = Array::with_capacity(n)
      let mut raws : Option[Array[Bytes]] = None
      let mut i = 0
      while i < n {
        let start_pos = dec.pos
        let tag_peek = if start_pos < dec.data.length() {
          dec.data[start_pos].to_int()
        } else {
          0
        }
        match dec.read_any() {
          Ok(v) => {
            arr.push(v)
            if tag_peek == 118 || tag_peek == 117 {
              let raw_slice = dec.data.slice(start_pos, dec.pos)
              match raws {
                Some(r) => r.push(raw_slice)
                None => {
                  let r : Array[Bytes] = Array::with_capacity(n)
                  let mut k = 0
                  while k < i {
                    r.push(Bytes::new(0))
                    k = k + 1
                  }
                  r.push(raw_slice)
                  raws = Some(r)
                }
              }
            } else {
              match raws {
                Some(r) => r.push(Bytes::new(0))
                None => ()
              }
            }
          }
          Err(e) => {
            dec.set_err(e.code, e.message)
            return RawContent::RawDeleted(0UL)
          }
        }
        i = i + 1
      }
      out.raw_any = raws
      out.len_u = n_u
      RawContent::RawAnyList(arr)
    }
    9 => {
      let guid = dec.read_var_string_raw()
      if dec.has_err {
        return RawContent::RawDeleted(0UL)
      }
      let opts = match dec.read_any() {
        Ok(v) => v
        Err(e) => {
          dec.set_err(e.code, e.message)
          return RawContent::RawDeleted(0UL)
        }
      }
      out.len_u = 1UL
      RawContent::RawDoc(guid, opts)
    }
    _ => {
      dec.set_err("INVALID_CONTENT_REF", "unknown Yjs content ref id")
      RawContent::RawDeleted(0UL)
    }
  }
}

///| Decode a full Yjs v1 update into per-client `RawBlock` lists and a `DeleteSet`.
fn decode_raw_update(
  update : Bytes,
) -> Result[(Map[Int64, Array[RawBlock]], DeleteSet), CrdtError] {
  let dec = Decoder::new(update)
  let clients_map : Map[Int64, Array[RawBlock]] = Map::new()
  let num_clients_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  if num_clients_u > dec.remaining().to_int64().to_uint64() {
    return Err(CrdtError::new("EOF", "client count exceeds remaining buffer"))
  }
  let num_clients = num_clients_u.to_int()
  let cout = RawContentOut::{ raw_any: None, len_u: 0UL }
  let zero_id = empty_id()
  let mut ci = 0
  while ci < num_clients {
    let num_structs_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_structs_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "struct count exceeds remaining buffer"))
    }
    let num_structs = num_structs_u.to_int()
    let client = dec.read_var_uint_raw()
    let mut clock = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    match clients_map.get(client.to_int64()) {
      Some(_) => return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
      None => ()
    }
    let blocks : Array[RawBlock] = Array::with_capacity(num_structs)
    let mut si = 0
    while si < num_structs {
      let info = dec.read_uint8_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      let ref_id = info_ref_id(info)
      if ref_id == 0 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "GC clock overflow"))
        }
        let next_clock = clock + len_u
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: false,
            origin: zero_id,
            has_right_origin: false,
            right_origin: zero_id,
            parent_is_key: false,
            parent_key: None,
            has_parent_id: false,
            parent_id: zero_id,
            parent_sub: None,
            has_parent_sub_bit: false,
            content: RawContent::RawGc(len_u),
            raw_any_bytes: None,
          },
        )
        clock = next_clock
      } else if ref_id == 10 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "Skip clock overflow"))
        }
        let next_clock = clock + len_u
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: false,
            origin: zero_id,
            has_right_origin: false,
            right_origin: zero_id,
            parent_is_key: false,
            parent_key: None,
            has_parent_id: false,
            parent_id: zero_id,
            parent_sub: None,
            has_parent_sub_bit: false,
            content: RawContent::RawSkip(len_u),
            raw_any_bytes: None,
          },
        )
        clock = next_clock
      } else {
        let has_orig = (info & 0x80) != 0
        let has_rorig = (info & 0x40) != 0
        let has_psub = (info & 0x20) != 0
        let origin = if has_orig {
          let oc = dec.read_var_uint_raw()
          let ok = dec.read_var_uint_raw()
          Id::{ client: oc, clock: ok }
        } else {
          zero_id
        }
        let right_origin = if has_rorig {
          let rc = dec.read_var_uint_raw()
          let rk = dec.read_var_uint_raw()
          Id::{ client: rc, clock: rk }
        } else {
          zero_id
        }
        if dec.has_err {
          return Err(dec.take_err())
        }
        if has_orig && origin.client == client && origin.clock >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client origin must precede item"))
        }
        if has_rorig && right_origin.client == client && right_origin.clock >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client right origin must precede item"))
        }
        let mut parent_is_key = false
        let mut parent_key : Option[String] = None
        let mut has_parent_id = false
        let mut parent_id = zero_id
        let mut parent_sub : Option[String] = None
        if !has_orig && !has_rorig {
          let pinfo = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if pinfo == 1UL {
            parent_is_key = true
            let pk = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_key = Some(pk)
          } else {
            let pc = dec.read_var_uint_raw()
            let pk = dec.read_var_uint_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            has_parent_id = true
            parent_id = Id::{ client: pc, clock: pk }
          }
          if has_psub {
            let ps = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_sub = Some(ps)
          }
        }
        let content = read_raw_content_raw(dec, ref_id, cout)
        if dec.has_err {
          return Err(dec.take_err())
        }
        let len_u = cout.len_u
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "item clock overflow"))
        }
        let next_clock = clock + len_u
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: has_orig,
            origin: origin,
            has_right_origin: has_rorig,
            right_origin: right_origin,
            parent_is_key: parent_is_key,
            parent_key: parent_key,
            has_parent_id: has_parent_id,
            parent_id: parent_id,
            parent_sub: parent_sub,
            has_parent_sub_bit: has_psub,
            content: content,
            raw_any_bytes: cout.raw_any,
          },
        )
        clock = next_clock
      }
      si = si + 1
    }
    clients_map.set(client.to_int64(), blocks)
    ci = ci + 1
  }
  let ds = match read_delete_set(dec) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  Ok((clients_map, ds))
}

///| Encode a `Map[Int64, Array[RawBlock]]` + `DeleteSet` into a Yjs v1 binary update.
fn encode_raw_update(
  clients_map : Map[Int64, Array[RawBlock]],
  ds : DeleteSet,
) -> Bytes {
  let enc = Encoder::new()
  let ks = clients_map.keys()
  let clients : Array[UInt64] = Array::new()
  let mut i = 0
  while i < ks.length() {
    match clients_map.get(ks[i]) {
      Some(arr) => {
        if arr.length() > 0 {
          clients.push(ks[i].to_uint64())
        }
      }
      None => ()
    }
    i = i + 1
  }
  sort_u64_desc(clients)
  enc.write_var_uint(int_to_u64(clients.length()))
  i = 0
  while i < clients.length() {
    let c = clients[i]
    match clients_map.get(c.to_int64()) {
      Some(blocks) => {
        enc.write_var_uint(int_to_u64(blocks.length()))
        enc.write_var_uint(c)
        enc.write_var_uint(blocks[0].id.clock)
        let mut j = 0
        while j < blocks.length() {
          write_raw_block(enc, blocks[j])
          j = j + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
  write_delete_set(enc, ds)
  enc.take_bytes()
}

// --- Doc -> Yjs v1 Update Encoding ---

///| Return true if `right_idx` can be wire-merged onto `left_idx` during update encoding (zero allocation).
fn can_wire_merge(doc : Doc, left_idx : Int, right_idx : Int) -> Bool {
  let left = doc.store.items[left_idx]
  let right = doc.store.items[right_idx]
  if left.id.client != right.id.client {
    return false
  }
  if left.id.clock + left.len_u64 != right.id.clock {
    return false
  }
  if left.is_gc && right.is_gc {
    return true
  }
  if left.is_gc || right.is_gc {
    return false
  }
  if left.deleted != right.deleted {
    return false
  }
  if left.right != right_idx {
    return false
  }
  if !item_origin_eq_last_id(right, left) {
    return false
  }
  if !item_same_right_origin(left, right) {
    return false
  }
  if left.parent_id != right.parent_id {
    return false
  }
  match (left.parent_sub, right.parent_sub) {
    (None, None) => ()
    _ => return false
  }
  match (left.content, right.content) {
    (Content::Deleted(_), Content::Deleted(_)) => true
    (Content::Str(_), Content::Str(_)) => true
    _ => false
  }
}

///| 1-byte varuint fast path delegating multi-byte values to `write_var_uint_sb`.
fn put_var_uint_sb(sb : StringBuilder, v : UInt64) -> Unit {
  if v < 0x80UL {
    sb.write_byte(v.to_int().to_byte())
  } else {
    write_var_uint_sb(sb, v)
  }
}

///| 1-byte varstring fast path delegating other lengths to `write_var_string_sb`.
fn put_var_string_sb(sb : StringBuilder, s : String) -> Unit {
  if s.length() == 1 {
    sb.write_byte((1).to_byte())
    sb.write_byte(s.code_unit_at(0).to_byte())
  } else {
    write_var_string_sb(sb, s)
  }
}

///| Write a single `Doc` `Item` header directly into `sb` (zero `Encoder` indirection or `Option[Id]` boxing).
fn write_doc_item_header_sb(
  sb : StringBuilder,
  doc : Doc,
  item : Item,
  offset : UInt64,
  ref_id : Int,
) -> Unit {
  let has_orig = offset > 0UL || item.has_origin
  let has_rorig = item.has_right_origin
  let has_psub = match item.parent_sub {
    Some(_) => true
    None => false
  }
  let mut info = ref_id & 0x1f
  if has_orig {
    info = info | 0x80
  }
  if has_rorig {
    info = info | 0x40
  }
  if has_psub {
    info = info | 0x20
  }
  sb.write_byte(info.to_byte())
  if offset > 0UL {
    put_var_uint_sb(sb, item.id.client)
    put_var_uint_sb(sb, item.id.clock + offset - 1UL)
  } else if item.has_origin {
    put_var_uint_sb(sb, item.origin_client)
    put_var_uint_sb(sb, item.origin_clock)
  }
  if has_rorig {
    put_var_uint_sb(sb, item.right_origin_client)
    put_var_uint_sb(sb, item.right_origin_clock)
  }
  if !has_orig && !has_rorig {
    let parent = doc.types[item.parent_id]
    match parent.root_name {
      Some(rname) => {
        sb.write_byte((1).to_byte())
        put_var_string_sb(sb, rname)
      }
      None => {
        sb.write_byte((0).to_byte())
        let pid = doc.store.items[parent.item_idx].id
        put_var_uint_sb(sb, pid.client)
        put_var_uint_sb(sb, pid.clock)
      }
    }
    match item.parent_sub {
      Some(sub) => put_var_string_sb(sb, sub)
      None => ()
    }
  }
}

///| Write a single non-merged `Doc` `Item` directly to `sb` (single match on `item.content`).
fn write_doc_item_single_sb(
  sb : StringBuilder,
  doc : Doc,
  item : Item,
  offset : UInt64,
) -> Unit {
  if item.is_gc {
    sb.write_byte((0).to_byte())
    put_var_uint_sb(sb, item.len_u64 - offset)
    return
  }
  match item.content {
    Content::Str(s) => {
      write_doc_item_header_sb(sb, doc, item, offset, 4)
      if offset == 0UL {
        put_var_string_sb(sb, s)
      } else {
        put_var_string_sb(sb, utf16_tail_with_len(s, item.len, offset.to_int()))
      }
    }
    Content::Deleted(n) => {
      write_doc_item_header_sb(sb, doc, item, offset, 1)
      put_var_uint_sb(sb, n - offset)
    }
    Content::AnyList(arr) => {
      write_doc_item_header_sb(sb, doc, item, offset, 8)
      let off = offset.to_int()
      put_var_uint_sb(sb, int_to_u64(arr.length() - off))
      let mut i = off
      while i < arr.length() {
        let mut wrote_raw = false
        match item.raw_any_bytes {
          Some(raws) => {
            if i < raws.length() && raws[i].length() > 0 {
              sb.write_bytes(raws[i])
              wrote_raw = true
            }
          }
          None => ()
        }
        if !wrote_raw {
          write_any_sb(sb, arr[i])
        }
        i = i + 1
      }
    }
    Content::Type(tid) => {
      write_doc_item_header_sb(sb, doc, item, offset, 7)
      let node = doc.types[tid]
      write_var_uint_sb(sb, int_to_u64(node.raw_type_ref))
      if node.raw_type_ref == 3 || node.raw_type_ref == 5 {
        match node.node_name {
          Some(name) => write_var_string_sb(sb, name)
          None => sb.write_byte((0).to_byte())
        }
      }
    }
    Content::Format(k, v) => {
      write_doc_item_header_sb(sb, doc, item, offset, 6)
      write_var_string_sb(sb, k)
      write_var_string_sb(sb, v)
    }
    Content::Binary(buf) => {
      write_doc_item_header_sb(sb, doc, item, offset, 3)
      write_var_uint_sb(sb, int_to_u64(buf.length()))
      sb.write_bytes(buf)
    }
    Content::Embed(s) => {
      write_doc_item_header_sb(sb, doc, item, offset, 5)
      write_var_string_sb(sb, s)
    }
    Content::Json(arr) => {
      write_doc_item_header_sb(sb, doc, item, offset, 2)
      let off = offset.to_int()
      write_var_uint_sb(sb, int_to_u64(arr.length() - off))
      let mut i = off
      while i < arr.length() {
        write_var_string_sb(sb, arr[i])
        i = i + 1
      }
    }
    Content::Doc(guid, opts) => {
      write_doc_item_header_sb(sb, doc, item, offset, 9)
      write_var_string_sb(sb, guid)
      write_any_sb(sb, opts)
    }
    Content::Gc(n) => {
      sb.write_byte((0).to_byte())
      write_var_uint_sb(sb, n - offset)
    }
  }
}

///| Encode all structs for one client starting at `(start_chunk, start_pos)` into `bsb` and append its wire block to `sb`.
fn encode_client_blocks_sb(
  sb : StringBuilder,
  bsb : StringBuilder,
  str_buf : StringBuilder,
  doc : Doc,
  c : UInt64,
  target_clock : UInt64,
  cs : ClientStore,
  start_chunk : Int,
  start_pos : Int,
  items : Array[Item],
  i_rights : Array[Int],
  i_lens : Array[UInt64],
) -> Unit {
  let chunks = cs.chunks
  let n_chunks = chunks.length()
  let mut run_count = 0
  let mut ci_c = start_chunk
  let mut pi_c = start_pos
  let mut is_first = true
  while ci_c < n_chunks {
    let chunk = chunks[ci_c]
    let clen = chunk.length()
    if pi_c >= clen {
      ci_c = ci_c + 1
      pi_c = 0
      continue
    }
    let first_idx = chunk[pi_c]
    let first_item = items[first_idx]
    let off = if is_first {
      is_first = false
      target_clock - first_item.id.clock
    } else {
      0UL
    }
    let mut prev_idx = first_idx
    pi_c = pi_c + 1
    if pi_c >= clen {
      ci_c = ci_c + 1
      pi_c = 0
    }
    while ci_c < n_chunks && pi_c >= chunks[ci_c].length() {
      ci_c = ci_c + 1
      pi_c = 0
    }
    let mut has_next = ci_c < n_chunks
    let can_first_merge = if !has_next {
      false
    } else {
      let nxt0 = chunks[ci_c][pi_c]
      if !first_item.is_gc && i_rights[prev_idx] != nxt0 {
        false
      } else {
        can_wire_merge(doc, prev_idx, nxt0)
      }
    }
    if !can_first_merge {
      write_doc_item_single_sb(bsb, doc, first_item, off)
    } else if first_item.is_gc {
      let mut total = first_item.len_u64 - off
      while has_next {
        let nxt_idx = chunks[ci_c][pi_c]
        if !can_wire_merge(doc, prev_idx, nxt_idx) {
          break
        }
        total = total + i_lens[nxt_idx]
        prev_idx = nxt_idx
        pi_c = pi_c + 1
        while ci_c < n_chunks && pi_c >= chunks[ci_c].length() {
          ci_c = ci_c + 1
          pi_c = 0
        }
        has_next = ci_c < n_chunks
      }
      bsb.write_byte((0).to_byte())
      put_var_uint_sb(bsb, total)
    } else {
      match first_item.content {
        Content::Deleted(n) => {
          let mut total = n - off
          while has_next {
            let nxt_idx = chunks[ci_c][pi_c]
            if i_rights[prev_idx] != nxt_idx || !can_wire_merge(doc, prev_idx, nxt_idx) {
              break
            }
            total = total + i_lens[nxt_idx]
            prev_idx = nxt_idx
            pi_c = pi_c + 1
            while ci_c < n_chunks && pi_c >= chunks[ci_c].length() {
              ci_c = ci_c + 1
              pi_c = 0
            }
            has_next = ci_c < n_chunks
          }
          write_doc_item_header_sb(bsb, doc, first_item, off, 1)
          put_var_uint_sb(bsb, total)
        }
        Content::Str(s0) => {
          str_buf.reset()
          if off == 0UL {
            str_buf.write_string(s0)
          } else {
            str_buf.write_string(utf16_tail_with_len(s0, first_item.len, off.to_int()))
          }
          while has_next {
            let nxt_idx = chunks[ci_c][pi_c]
            if i_rights[prev_idx] != nxt_idx || !can_wire_merge(doc, prev_idx, nxt_idx) {
              break
            }
            match items[nxt_idx].content {
              Content::Str(sn) => str_buf.write_string(sn)
              _ => ()
            }
            prev_idx = nxt_idx
            pi_c = pi_c + 1
            while ci_c < n_chunks && pi_c >= chunks[ci_c].length() {
              ci_c = ci_c + 1
              pi_c = 0
            }
            has_next = ci_c < n_chunks
          }
          write_doc_item_header_sb(bsb, doc, first_item, off, 4)
          put_var_uint_sb(bsb, int_to_u64(str_buf.length()))
          bsb.write_builder(str_buf)
        }
        _ => write_doc_item_single_sb(bsb, doc, first_item, off)
      }
    }
    run_count = run_count + 1
  }
  put_var_uint_sb(sb, int_to_u64(run_count))
  put_var_uint_sb(sb, c)
  put_var_uint_sb(sb, target_clock)
  sb.write_builder(bsb)
}

///| Internal Yjs v1 update encoder taking an optional in-memory `StateVector`.
fn encode_state_as_update_impl(
  doc : Doc,
  target_sv : Option[StateVector],
) -> Result[Bytes, CrdtError] {
  let has_sv = match target_sv {
    Some(_) => true
    None => false
  }
  let cids = doc.store.client_ids
  let clist = doc.store.client_list
  let items = doc.store.items
  let i_rights = doc.store.item_right
  let i_clocks = doc.store.item_clock
  let i_lens = doc.store.item_len_u64
  let n_clients = cids.length()
  let mut n_write = 0
  let mut first_slot = 0
  let mut first_c = 0UL
  let mut first_tgt = 0UL
  let write_cids : Array[UInt64] = Array::new()
  let write_slots : Array[UInt64] = Array::new()
  let mut i = 0
  while i < n_clients {
    let c = cids[i]
    let tgt = match target_sv {
      Some(sv) => sv.get(c)
      None => 0UL
    }
    if clist[i].get_clock(i_clocks, i_lens) > tgt {
      if n_write == 0 {
        first_slot = i
        first_c = c
        first_tgt = tgt
      } else {
        if n_write == 1 {
          write_cids.push(first_c)
          write_slots.push(int_to_u64(first_slot))
        }
        write_cids.push(c)
        write_slots.push(int_to_u64(i))
      }
      n_write = n_write + 1
    }
    i = i + 1
  }
  if n_write > 1 {
    sort_u64_pairs_desc(write_cids, write_slots)
  }
  let est_cap = if !has_sv {
    let n_items = items.length()
    if n_items > 64 { n_items * 6 } else { 128 }
  } else if n_write == 0 {
    32
  } else {
    256
  }
  let sb = StringBuilder::with_capacity(est_cap)
  put_var_uint_sb(sb, int_to_u64(n_write))
  if n_write > 0 {
    let mut shared_str_buf : Option[StringBuilder] = None
    let mut shared_body : Option[StringBuilder] = None
    i = 0
    while i < n_write {
      let c = if n_write == 1 { first_c } else { write_cids[i] }
      let slot = if n_write == 1 {
        first_slot
      } else {
        write_slots[i].to_int()
      }
      let target_clock = if n_write == 1 {
        first_tgt
      } else {
        match target_sv {
          Some(sv) => sv.get(c)
          None => 0UL
        }
      }
      let cs = clist[slot]
      let start_cp = cs.find_pos(i_clocks, i_lens, target_clock)
      if start_cp.chunk >= 0 {
        let n_chunks = cs.chunks.length()
        let last_chunk_idx = n_chunks - 1
        // Fast path: single struct to encode for this client -> write directly into `sb`
        if start_cp.chunk == last_chunk_idx &&
        start_cp.pos + 1 == cs.chunks[last_chunk_idx].length() {
          let only_idx = cs.chunks[last_chunk_idx][start_cp.pos]
          let only_item = items[only_idx]
          let off = target_clock - only_item.id.clock
          sb.write_byte((1).to_byte())
          put_var_uint_sb(sb, c)
          put_var_uint_sb(sb, target_clock)
          write_doc_item_single_sb(sb, doc, only_item, off)
          i = i + 1
          continue
        }
        // Single-pass encode into reusable `shared_body` + `shared_str_buf`
        let bsb = match shared_body {
          Some(b) => {
            b.reset()
            b
          }
          None => {
            let body_cap = if !has_sv {
              if cs.total_len > 32 { cs.total_len * 6 } else { 128 }
            } else {
              256
            }
            let b = StringBuilder::with_capacity(body_cap)
            shared_body = Some(b)
            b
          }
        }
        let str_buf = match shared_str_buf {
          Some(b) => b
          None => {
            let b = StringBuilder::with_capacity(64)
            shared_str_buf = Some(b)
            b
          }
        }
        encode_client_blocks_sb(
          sb,
          bsb,
          str_buf,
          doc,
          c,
          target_clock,
          cs,
          start_cp.chunk,
          start_cp.pos,
          items,
          i_rights,
          i_lens,
        )
      }
      i = i + 1
    }
  }
  write_delete_set_sb(sb, doc.store.delete_set)
  let base_bytes = sb.take_bytes()
  if doc.store.pending_updates.length() == 0 {
    return Ok(base_bytes)
  }
  let all_parts : Array[Bytes] = Array::new()
  all_parts.push(base_bytes)
  let mut p_idx = 0
  while p_idx < doc.store.pending_updates.length() {
    match target_sv {
      Some(sv) => match diff_update_sv(doc.store.pending_updates[p_idx], sv) {
        Ok(d) => all_parts.push(d)
        Err(e) => return Err(e)
      }
      None => all_parts.push(doc.store.pending_updates[p_idx])
    }
    p_idx = p_idx + 1
  }
  merge_updates(all_parts)
}

///| Encode document state relative to an in-memory `StateVector` as a Yjs v1 binary update (zero SV binary decode).
pub fn encode_state_as_update_sv(
  doc : Doc,
  target_sv : StateVector,
) -> Result[Bytes, CrdtError] {
  encode_state_as_update_impl(doc, Some(target_sv))
}

///| Encode document state (optionally relative to binary `target_sv`) as a Yjs v1 binary update.
pub fn encode_state_as_update(
  doc : Doc,
  target_sv : Option[Bytes],
) -> Result[Bytes, CrdtError] {
  let sv_opt = match target_sv {
    Some(b) => match decode_state_vector(b) {
      Ok(v) => Some(v)
      Err(e) => return Err(e)
    }
    None => None
  }
  encode_state_as_update_impl(doc, sv_opt)
}

// --- Applying Updates (Causal Integration + Pending Queue) ---

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///| Validate that when both left and right origins exist and are live/deleted items (not GC), they belong to the same container and map subkey.
fn validate_remote_origins(
  doc : Doc,
  has_orig : Bool,
  orig_c : UInt64,
  orig_k : UInt64,
  has_rorig : Bool,
  rorig_c : UInt64,
  rorig_k : UInt64,
) -> Result[Unit, CrdtError] {
  if !has_orig || !has_rorig {
    return Ok(())
  }
  let l_idx = doc.store.get_item_idx_cc(orig_c, orig_k)
  if l_idx < 0 {
    return Ok(())
  }
  let r_idx = doc.store.get_item_idx_cc(rorig_c, rorig_k)
  if r_idx < 0 {
    return Ok(())
  }
  let li = doc.store.items[l_idx]
  let ri = doc.store.items[r_idx]
  if !li.is_gc && !ri.is_gc {
    if li.parent_id != ri.parent_id || !opt_str_eq(li.parent_sub, ri.parent_sub) {
      return Err(
        CrdtError::new("INVALID_PARENT", "origins belong to different containers"),
      )
    }
  }
  Ok(())
}

///| Validate that an overlapping incoming item's declared container matches the existing integrated prefix item `(client, clock + off - 1)`.
///| Returns `Ok(true)` if the item's same-client parent is at or after its own clock (must be kept as GC), `Ok(false)` if valid to integrate normally, or `Err` if hostile container splice.
fn validate_overlap_prefix(
  doc : Doc,
  client : UInt64,
  clock : UInt64,
  off : UInt64,
  has_orig : Bool,
  has_rorig : Bool,
  rorig_c : UInt64,
  rorig_k : UInt64,
  parent_key : Option[String],
  has_pid : Bool,
  pid_c : UInt64,
  pid_k : UInt64,
  parent_sub : Option[String],
) -> Result[Bool, CrdtError] {
  if has_pid && pid_c == client && pid_k >= clock {
    return Ok(true)
  }
  let pref_idx = doc.store.get_item_idx_cc(client, clock + off - 1UL)
  if pref_idx < 0 {
    return Ok(false)
  }
  let pref = doc.store.items[pref_idx]
  if pref.is_gc {
    return Ok(false)
  }
  if !has_orig && !has_rorig {
    match parent_key {
      Some(pk) => {
        if pref.parent_id < 0 || !opt_str_eq(doc.types[pref.parent_id].root_name, Some(pk)) || !opt_str_eq(pref.parent_sub, parent_sub) {
          return Err(
            CrdtError::new("INVALID_PARENT", "overlapping item root container mismatch"),
          )
        }
      }
      None => {
        if has_pid {
          let pidx = doc.store.get_item_idx_cc(pid_c, pid_k)
          if pidx < 0 {
            return Ok(true)
          }
          let p_item = doc.store.items[pidx]
          match p_item.content {
            Content::Type(ptid) => {
              if pref.parent_id != ptid || !opt_str_eq(pref.parent_sub, parent_sub) {
                return Err(
                  CrdtError::new("INVALID_PARENT", "overlapping item parent container mismatch"),
                )
              }
            }
            _ => {
              return Err(
                CrdtError::new("INVALID_PARENT", "overlapping item parent is not a type"),
              )
            }
          }
        }
      }
    }
  }
  if has_rorig {
    let r_idx = doc.store.get_item_idx_cc(rorig_c, rorig_k)
    if r_idx >= 0 {
      let ri = doc.store.items[r_idx]
      if !ri.is_gc && (pref.parent_id != ri.parent_id || !opt_str_eq(pref.parent_sub, ri.parent_sub)) {
        return Err(
          CrdtError::new("INVALID_PARENT", "overlapping item right origin container mismatch"),
        )
      }
    }
  }
  Ok(false)
}

///| Return true if `b` has a missing causal dependency in `doc`.
fn has_missing_dep(doc : Doc, b : RawBlock, local_clock : UInt64) -> Bool {
  if b.id.clock > local_clock {
    return true
  }
  if b.has_origin &&
  b.origin.client != b.id.client &&
  b.origin.clock >= doc.store.get_clock(b.origin.client) {
    return true
  }
  if b.has_right_origin &&
  b.right_origin.client != b.id.client &&
  b.right_origin.clock >= doc.store.get_clock(b.right_origin.client) {
    return true
  }
  if b.has_parent_id &&
  b.parent_id.client != b.id.client &&
  b.parent_id.clock >= doc.store.get_clock(b.parent_id.client) {
    return true
  }
  false
}

///| Materialize a `RawBlock` (already causally ready and trimmed to `offset`) into `doc` and integrate it.
fn integrate_raw_block(doc : Doc, b : RawBlock, offset : UInt64) -> Result[Unit, CrdtError] {
  if offset > 0UL {
    match validate_overlap_prefix(
      doc,
      b.id.client,
      b.id.clock,
      offset,
      b.has_origin,
      b.has_right_origin,
      b.right_origin.client,
      b.right_origin.clock,
      b.parent_key,
      b.has_parent_id,
      b.parent_id.client,
      b.parent_id.clock,
      b.parent_sub,
    ) {
      Ok(true) => {
        let rem_len = b.len - offset
        let len_i = if rem_len > 2147483647UL { 2147483647 } else { rem_len.to_int() }
        let idx = doc.store.push_item(
          Item::{
            id: Id::{ client: b.id.client, clock: b.id.clock + offset },
            len: len_i,
            len_u64: rem_len,
            left: -1,
            right: -1,
            has_origin: false,
            origin_client: 0UL,
            origin_clock: 0UL,
            has_right_origin: false,
            right_origin_client: 0UL,
            right_origin_clock: 0UL,
            parent_id: -1,
            parent_key: None,
            has_parent_item_id: false,
            parent_item_client: 0UL,
            parent_item_clock: 0UL,
            parent_sub: None,
            deleted: true,
            countable: false,
            is_gc: true,
            content: Content::Gc(rem_len),
            raw_any_bytes: None,
          },
        )
        doc.integrate_item(idx, false)
        return Ok(())
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
  }
  let block = if offset > 0UL {
    slice_raw_block(b, offset, b.len - offset)
  } else {
    b
  }
  let len_i = if block.len > 2147483647UL { 2147483647 } else { block.len.to_int() }
  match block.content {
    RawContent::RawSkip(_) => return Ok(())
    RawContent::RawGc(n) => {
      let idx = doc.store.push_item(
        Item::{
          id: block.id,
          len: len_i,
          len_u64: n,
          left: -1,
          right: -1,
          has_origin: false,
          origin_client: 0UL,
          origin_clock: 0UL,
          has_right_origin: false,
          right_origin_client: 0UL,
          right_origin_clock: 0UL,
          parent_id: -1,
          parent_key: None,
          has_parent_item_id: false,
          parent_item_client: 0UL,
          parent_item_clock: 0UL,
          parent_sub: None,
          deleted: true,
          countable: false,
          is_gc: true,
          content: Content::Gc(n),
          raw_any_bytes: None,
        },
      )
      doc.integrate_item(idx, false)
      return Ok(())
    }
    _ => ()
  }
  match validate_remote_origins(
    doc,
    block.has_origin,
    block.origin.client,
    block.origin.clock,
    block.has_right_origin,
    block.right_origin.client,
    block.right_origin.clock,
  ) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let content = match block.content {
    RawContent::RawDeleted(n) => Content::Deleted(n)
    RawContent::RawJson(arr) => Content::Json(arr)
    RawContent::RawBinary(buf) => Content::Binary(buf)
    RawContent::RawStr(s) => Content::Str(s)
    RawContent::RawEmbed(s) => Content::Embed(s)
    RawContent::RawFormat(k, v) => Content::Format(k, v)
    RawContent::RawType(tr, node_name) => {
      let tid = doc.alloc_nested_type_raw(tr, node_name)
      Content::Type(tid)
    }
    RawContent::RawAnyList(arr) => Content::AnyList(arr)
    RawContent::RawDoc(guid, opts) => Content::Doc(guid, opts)
    _ => Content::Deleted(block.len)
  }
  let idx = doc.store.push_item(
    Item::{
      id: block.id,
      len: len_i,
      len_u64: block.len,
      left: -1,
      right: -1,
      has_origin: block.has_origin,
      origin_client: block.origin.client,
      origin_clock: block.origin.clock,
      has_right_origin: block.has_right_origin,
      right_origin_client: block.right_origin.client,
      right_origin_clock: block.right_origin.clock,
      parent_id: -1,
      parent_key: block.parent_key,
      has_parent_item_id: block.has_parent_id,
      parent_item_client: block.parent_id.client,
      parent_item_clock: block.parent_id.clock,
      parent_sub: block.parent_sub,
      deleted: false,
      countable: content_is_countable(content),
      is_gc: false,
      content: content,
      raw_any_bytes: block.raw_any_bytes,
    },
  )
  doc.integrate_item(idx, false)
  Ok(())
}

///| Apply a single `[del_start, apply_end)` range to `cs`, skipping already-deleted/GC items without splitting.
fn apply_delete_subrange(
  doc : Doc,
  cs : ClientStore,
  del_start : UInt64,
  apply_end : UInt64,
  cursor_state : Array[Int],
) -> Unit {
  let mut cur_chunk = cursor_state[0]
  let mut cur_pos = cursor_state[1]
  let i_clk = doc.store.item_clock
  let i_len = doc.store.item_len_u64
  let mut cur_clock = del_start
  while cur_clock < apply_end {
    let mut idx = -1
    let n_chunks = cs.chunks.length()
    if cur_chunk < n_chunks {
      let ch = cs.chunks[cur_chunk]
      let ch_len = ch.length()
      if cur_pos < ch_len {
        let cand_idx = ch[cur_pos]
        let cclk = i_clk[cand_idx]
        if cur_clock >= cclk && cur_clock - cclk < i_len[cand_idx] {
          idx = cand_idx
        } else if cur_pos + 1 < ch_len {
          let nxt_idx = ch[cur_pos + 1]
          let nclk = i_clk[nxt_idx]
          if cur_clock >= nclk && cur_clock - nclk < i_len[nxt_idx] {
            cur_pos = cur_pos + 1
            idx = nxt_idx
          }
        } else if cur_chunk + 1 < n_chunks {
          let nch = cs.chunks[cur_chunk + 1]
          if nch.length() > 0 {
            let nxt_idx = nch[0]
            let nclk = i_clk[nxt_idx]
            if cur_clock >= nclk && cur_clock - nclk < i_len[nxt_idx] {
              cur_chunk = cur_chunk + 1
              cur_pos = 0
              idx = nxt_idx
            }
          }
        }
      }
    }
    if idx < 0 {
      let cp = cs.find_pos(i_clk, i_len, cur_clock)
      if cp.chunk < 0 {
        break
      }
      cur_chunk = cp.chunk
      cur_pos = cp.pos
      idx = cs.chunks[cur_chunk][cur_pos]
    }
    let item0 = doc.store.items[idx]
    // CRITICAL: never split already-deleted or GC items! Jump straight past them.
    if item0.deleted || item0.is_gc {
      let step = item0.len_u64
      if step == 0UL {
        break
      }
      cur_clock = u64_sat_add(item0.id.clock, step)
      cur_pos = cur_pos + 1
      if cur_chunk < cs.chunks.length() && cur_pos >= cs.chunks[cur_chunk].length() {
        cur_chunk = cur_chunk + 1
        cur_pos = 0
      }
      continue
    }
    if item0.id.clock < cur_clock {
      let diff = cur_clock - item0.id.clock
      idx = doc.split_item_u64(idx, diff)
      cur_pos = cur_pos + 1
      if cur_chunk < cs.chunks.length() && cur_pos >= cs.chunks[cur_chunk].length() {
        cur_chunk = cur_chunk + 1
        cur_pos = 0
      }
    }
    let item = doc.store.items[idx]
    let item_end = item.id.clock + item.len_u64
    if item_end > apply_end {
      let split_at = apply_end - item.id.clock
      let _ = doc.split_item_u64(idx, split_at)
    }
    let cur_item = doc.store.items[idx]
    let step = cur_item.len_u64
    if !cur_item.deleted {
      if cur_item.parent_id >= 0 {
        let p = doc.types[cur_item.parent_id]
        if p.markers.length() > 0 || p.m_item.length() > 0 {
          clear_markers(p)
        }
      }
      doc.delete_item(idx)
    }
    if step == 0UL {
      break
    }
    cur_clock = cur_clock + step
    cur_pos = cur_pos + 1
    if cur_chunk < cs.chunks.length() && cur_pos >= cs.chunks[cur_chunk].length() {
      cur_chunk = cur_chunk + 1
      cur_pos = 0
    }
  }
  cursor_state[0] = cur_chunk
  cursor_state[1] = cur_pos
}

///| Apply a `DeleteSet` to `doc`, skipping ranges already covered by `doc.store.delete_set` via two-pointer merge scan.
fn apply_delete_set_to_doc(doc : Doc, ds : DeleteSet) -> DeleteSet {
  ds.ensure_sorted()
  let unapplied = DeleteSet::new()
  let ks = ds.clients.keys()
  let cursor_state : Array[Int] = [0, 0]
  let mut ci = 0
  while ci < ks.length() {
    let k = ks[ci]
    let client = k.to_uint64()
    match ds.clients.get(k) {
      Some(ranges) => {
        let local_clock = doc.store.get_clock(client)
        let mut has_cs = false
        let mut cs = ClientStore::new()
        match doc.store.client_stores.get(k) {
          Some(found) => {
            cs = found
            has_cs = true
          }
          None => ()
        }
        if doc.store.delete_set.dirty {
          doc.store.delete_set.sort_and_merge_one(k)
        }
        let existing_opt = doc.store.delete_set.clients.get(k)
        let mut edi = 0
        cursor_state[0] = 0
        cursor_state[1] = 0
        let mut ri = 0
        while ri < ranges.length() {
          let r = ranges[ri]
          let del_start = r.clock
          if del_start >= local_clock || !has_cs {
            unapplied.add(client, del_start, r.len)
          } else {
            let max_avail = local_clock - del_start
            let apply_len = if r.len > max_avail { max_avail } else { r.len }
            let apply_end = del_start + apply_len
            if r.len > max_avail {
              unapplied.add(client, local_clock, r.len - max_avail)
            }
            match existing_opt {
              Some(ex_arr) => {
                let ex_len = ex_arr.length()
                let mut seg_start = del_start
                while seg_start < apply_end {
                  while edi < ex_len &&
                  u64_sat_add(ex_arr[edi].clock, ex_arr[edi].len) <= seg_start {
                    edi = edi + 1
                  }
                  if edi < ex_len && ex_arr[edi].clock <= seg_start {
                    let cov_end = u64_sat_add(ex_arr[edi].clock, ex_arr[edi].len)
                    if cov_end >= apply_end {
                      seg_start = apply_end
                    } else {
                      seg_start = cov_end
                    }
                  } else {
                    let seg_end = if edi < ex_len && ex_arr[edi].clock < apply_end {
                      ex_arr[edi].clock
                    } else {
                      apply_end
                    }
                    apply_delete_subrange(doc, cs, seg_start, seg_end, cursor_state)
                    seg_start = seg_end
                  }
                }
              }
              None => apply_delete_subrange(doc, cs, del_start, apply_end, cursor_state)
            }
          }
          ri = ri + 1
        }
      }
      None => ()
    }
    ci = ci + 1
  }
  unapplied
}

///| Stream and apply a wire DeleteSet directly from `dec`, skipping ranges already covered by `doc.store.delete_set`.
fn apply_wire_delete_set_streaming(
  doc : Doc,
  dec : Decoder,
) -> Result[Option[DeleteSet], CrdtError] {
  let ds_clients_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  if ds_clients_u == 0UL {
    return Ok(None)
  }
  if ds_clients_u > dec.remaining().to_int64().to_uint64() {
    return Err(CrdtError::new("EOF", "delete set client count exceeds buffer"))
  }
  let ds_clients = ds_clients_u.to_int()
  let mut unapplied_ds : Option[DeleteSet] = None
  let cursor_state : Array[Int] = [0, 0]
  let mut dci = 0
  while dci < ds_clients {
    let ds_client = dec.read_var_uint_raw()
    let num_dels_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_dels_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "delete set range count exceeds buffer"))
    }
    let num_dels = num_dels_u.to_int()
    let ds_key = ds_client.to_int64()
    let ds_local_clock = doc.store.get_clock(ds_client)
    let mut has_cs = false
    let mut cs = ClientStore::new()
    match doc.store.client_stores.get(ds_key) {
      Some(found) => {
        cs = found
        has_cs = true
      }
      None => ()
    }
    if doc.store.delete_set.dirty {
      doc.store.delete_set.sort_and_merge_one(ds_key)
    }
    let existing_opt = doc.store.delete_set.clients.get(ds_key)
    let mut edi = 0
    let mut prev_del_start = 0UL
    let mut has_prev_del = false
    cursor_state[0] = 0
    cursor_state[1] = 0
    let mut dj = 0
    while dj < num_dels {
      let del_start = dec.read_var_uint_raw()
      let del_len = dec.read_var_uint_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      if del_len > 18446744073709551615UL - del_start {
        return Err(CrdtError::new("OVERFLOW", "delete item clock + len overflow"))
      }
      if del_len > 0UL {
        if has_prev_del && del_start < prev_del_start {
          // Out-of-order wire delete range: reset existing-DS pointer so two-pointer skip stays exact
          edi = 0
        }
        prev_del_start = del_start
        has_prev_del = true
        if del_start >= ds_local_clock || !has_cs {
          let uds = match unapplied_ds {
            Some(u) => u
            None => {
              let u = DeleteSet::new()
              unapplied_ds = Some(u)
              u
            }
          }
          uds.add(ds_client, del_start, del_len)
        } else {
          let max_avail = ds_local_clock - del_start
          let apply_len = if del_len > max_avail { max_avail } else { del_len }
          let apply_end = del_start + apply_len
          if del_len > max_avail {
            let uds = match unapplied_ds {
              Some(u) => u
              None => {
                let u = DeleteSet::new()
                unapplied_ds = Some(u)
                u
              }
            }
            uds.add(ds_client, ds_local_clock, del_len - max_avail)
          }
          match existing_opt {
            Some(ex_arr) => {
              let ex_len = ex_arr.length()
              let mut seg_start = del_start
              while seg_start < apply_end {
                while edi < ex_len &&
                u64_sat_add(ex_arr[edi].clock, ex_arr[edi].len) <= seg_start {
                  edi = edi + 1
                }
                if edi < ex_len && ex_arr[edi].clock <= seg_start {
                  let cov_end = u64_sat_add(ex_arr[edi].clock, ex_arr[edi].len)
                  if cov_end >= apply_end {
                    seg_start = apply_end
                  } else {
                    seg_start = cov_end
                  }
                } else {
                  let seg_end = if edi < ex_len && ex_arr[edi].clock < apply_end {
                    ex_arr[edi].clock
                  } else {
                    apply_end
                  }
                  apply_delete_subrange(doc, cs, seg_start, seg_end, cursor_state)
                  seg_start = seg_end
                }
              }
            }
            None => apply_delete_subrange(doc, cs, del_start, apply_end, cursor_state)
          }
        }
      }
      dj = dj + 1
    }
    dci = dci + 1
  }
  Ok(unapplied_ds)
}

///| Zero-allocation wire framing, duplicate-client, clock-overflow, and DeleteSet pre-validation for multi-client updates.
///| Ensures multi-client streaming apply is atomic with respect to malformed, truncated, or duplicate-client inputs.
fn prevalidate_multi_client_update(
  update : Bytes,
  start_pos : Int,
  num_clients : Int,
) -> Result[Unit, CrdtError] {
  let dec = Decoder::new(update)
  dec.pos = start_pos
  let mut prev_client = 0UL
  let mut has_seen_map = false
  let mut seen_clients : Option[Map[Int64, Bool]] = None
  let seen_list : Array[UInt64] = Array::with_capacity(num_clients)
  let mut ci = 0
  while ci < num_clients {
    let num_structs_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_structs_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "struct count exceeds remaining buffer"))
    }
    let num_structs = num_structs_u.to_int()
    let client = dec.read_var_uint_raw()
    let mut clock = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if ci == 0 {
      prev_client = client
    } else if !has_seen_map && client < prev_client {
      prev_client = client
    } else {
      if client == prev_client {
        return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
      }
      let sm = match seen_clients {
        Some(m) => m
        None => {
          let m : Map[Int64, Bool] = Map::new()
          let mut si_c = 0
          while si_c < seen_list.length() {
            m.set(seen_list[si_c].to_int64(), true)
            si_c = si_c + 1
          }
          seen_clients = Some(m)
          has_seen_map = true
          m
        }
      }
      let ck = client.to_int64()
      match sm.get(ck) {
        Some(_) => return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
        None => sm.set(ck, true)
      }
    }
    if !has_seen_map {
      seen_list.push(client)
    }
    let mut si = 0
    while si < num_structs {
      let info = dec.read_uint8_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      let ref_id = info & 0x1f
      if ref_id == 0 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "GC clock overflow"))
        }
        clock = clock + len_u
      } else if ref_id == 10 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "Skip clock overflow"))
        }
        clock = clock + len_u
      } else {
        let has_orig = (info & 0x80) != 0
        let has_rorig = (info & 0x40) != 0
        let has_psub = (info & 0x20) != 0
        let mut orig_c = 0UL
        let mut orig_k = 0UL
        if has_orig {
          orig_c = dec.read_var_uint_raw()
          orig_k = dec.read_var_uint_raw()
        }
        let mut rorig_c = 0UL
        let mut rorig_k = 0UL
        if has_rorig {
          rorig_c = dec.read_var_uint_raw()
          rorig_k = dec.read_var_uint_raw()
        }
        if dec.has_err {
          return Err(dec.take_err())
        }
        if has_orig && orig_c == client && orig_k >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client origin must precede item"))
        }
        if has_rorig && rorig_c == client && rorig_k >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client right origin must precede item"))
        }
        if !has_orig && !has_rorig {
          let pinfo = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if pinfo == 1UL {
            let _ = dec.skip_var_string_raw()
          } else {
            let _ = dec.read_var_uint_raw()
            let _ = dec.read_var_uint_raw()
          }
          if dec.has_err {
            return Err(dec.take_err())
          }
          if has_psub {
            let _ = dec.skip_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
          }
        }
        let mut len_u = 0UL
        if ref_id == 4 {
          len_u = int_to_u64(dec.skip_var_string_raw())
        } else if ref_id == 1 {
          len_u = dec.read_var_uint_raw()
        } else if ref_id == 2 {
          let n_u = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if n_u > dec.remaining().to_int64().to_uint64() {
            return Err(CrdtError::new("EOF", "json array length exceeds buffer"))
          }
          let n = n_u.to_int()
          let mut ji = 0
          while ji < n {
            let _ = dec.skip_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            ji = ji + 1
          }
          len_u = n_u
        } else if ref_id == 3 {
          dec.skip_var_bytes_raw()
          len_u = 1UL
        } else if ref_id == 5 {
          let _ = dec.skip_var_string_raw()
          len_u = 1UL
        } else if ref_id == 6 {
          let _ = dec.skip_var_string_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          let _ = dec.skip_var_string_raw()
          len_u = 1UL
        } else if ref_id == 7 {
          let tr_u = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if tr_u == 3UL || tr_u == 5UL {
            let _ = dec.skip_var_string_raw()
          }
          len_u = 1UL
        } else if ref_id == 8 {
          let n_u = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if n_u > dec.remaining().to_int64().to_uint64() {
            return Err(CrdtError::new("EOF", "any list length exceeds buffer"))
          }
          let n = n_u.to_int()
          let mut ai = 0
          while ai < n {
            dec.skip_any_depth_raw(0)
            if dec.has_err {
              return Err(dec.take_err())
            }
            ai = ai + 1
          }
          len_u = n_u
        } else if ref_id == 9 {
          let _ = dec.skip_var_string_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          dec.skip_any_depth_raw(0)
          len_u = 1UL
        } else {
          return Err(CrdtError::new("INVALID_CONTENT_REF", "unknown Yjs content ref id"))
        }
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "item clock overflow"))
        }
        clock = clock + len_u
      }
      si = si + 1
    }
    ci = ci + 1
  }
  let ds_clients_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  if ds_clients_u > dec.remaining().to_int64().to_uint64() {
    return Err(CrdtError::new("EOF", "delete set client count exceeds buffer"))
  }
  let ds_clients = ds_clients_u.to_int()
  let mut dci = 0
  while dci < ds_clients {
    let _ = dec.read_var_uint_raw()
    let num_dels_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_dels_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "delete set range count exceeds buffer"))
    }
    let num_dels = num_dels_u.to_int()
    let mut dj = 0
    while dj < num_dels {
      let del_start = dec.read_var_uint_raw()
      let del_len = dec.read_var_uint_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      if del_len > 18446744073709551615UL - del_start {
        return Err(CrdtError::new("OVERFLOW", "delete item clock + len overflow"))
      }
      dj = dj + 1
    }
    dci = dci + 1
  }
  Ok(())
}

///| Decode remaining structs of the current client plus all remaining clients from `dec` into `clients_map`.
fn decode_remaining_clients_from(
  dec : Decoder,
  cur_client : UInt64,
  cur_clock : UInt64,
  cur_rem_structs : Int,
  rem_other_clients : Int,
  prev_seen_list : Array[UInt64],
  prev_seen_map : Option[Map[Int64, Bool]],
) -> Result[(Map[Int64, Array[RawBlock]], DeleteSet), CrdtError] {
  let clients_map : Map[Int64, Array[RawBlock]] = Map::new()
  let seen : Map[Int64, Bool] = match prev_seen_map {
    Some(m) => m
    None => {
      let m : Map[Int64, Bool] = Map::new()
      let mut pi = 0
      while pi < prev_seen_list.length() {
        m.set(prev_seen_list[pi].to_int64(), true)
        pi = pi + 1
      }
      m
    }
  }
  seen.set(cur_client.to_int64(), true)
  let cout = RawContentOut::{ raw_any: None, len_u: 0UL }
  let zero_id = empty_id()
  let mut ci = 0
  let total_c = 1 + rem_other_clients
  while ci < total_c {
    let mut num_structs = cur_rem_structs
    let mut client = cur_client
    let mut clock = cur_clock
    if ci > 0 {
      let num_structs_u = dec.read_var_uint_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      if num_structs_u > dec.remaining().to_int64().to_uint64() {
        return Err(CrdtError::new("EOF", "struct count exceeds remaining buffer"))
      }
      num_structs = num_structs_u.to_int()
      client = dec.read_var_uint_raw()
      clock = dec.read_var_uint_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      let ck = client.to_int64()
      match seen.get(ck) {
        Some(_) => return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
        None => seen.set(ck, true)
      }
    }
    let blocks : Array[RawBlock] = Array::with_capacity(num_structs)
    let mut si = 0
    while si < num_structs {
      let info = dec.read_uint8_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      let ref_id = info & 0x1f
      if ref_id == 0 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "GC clock overflow"))
        }
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: false,
            origin: zero_id,
            has_right_origin: false,
            right_origin: zero_id,
            parent_is_key: false,
            parent_key: None,
            has_parent_id: false,
            parent_id: zero_id,
            parent_sub: None,
            has_parent_sub_bit: false,
            content: RawContent::RawGc(len_u),
            raw_any_bytes: None,
          },
        )
        clock = clock + len_u
      } else if ref_id == 10 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "Skip clock overflow"))
        }
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: false,
            origin: zero_id,
            has_right_origin: false,
            right_origin: zero_id,
            parent_is_key: false,
            parent_key: None,
            has_parent_id: false,
            parent_id: zero_id,
            parent_sub: None,
            has_parent_sub_bit: false,
            content: RawContent::RawSkip(len_u),
            raw_any_bytes: None,
          },
        )
        clock = clock + len_u
      } else {
        let has_orig = (info & 0x80) != 0
        let has_rorig = (info & 0x40) != 0
        let has_psub = (info & 0x20) != 0
        let origin = if has_orig {
          let oc = dec.read_var_uint_raw()
          let ok = dec.read_var_uint_raw()
          Id::{ client: oc, clock: ok }
        } else {
          zero_id
        }
        let right_origin = if has_rorig {
          let rc = dec.read_var_uint_raw()
          let rk = dec.read_var_uint_raw()
          Id::{ client: rc, clock: rk }
        } else {
          zero_id
        }
        if dec.has_err {
          return Err(dec.take_err())
        }
        if has_orig && origin.client == client && origin.clock >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client origin must precede item"))
        }
        if has_rorig && right_origin.client == client && right_origin.clock >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client right origin must precede item"))
        }
        let mut parent_is_key = false
        let mut parent_key : Option[String] = None
        let mut has_parent_id = false
        let mut parent_id = zero_id
        let mut parent_sub : Option[String] = None
        if !has_orig && !has_rorig {
          let pinfo = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if pinfo == 1UL {
            parent_is_key = true
            let pk = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_key = Some(pk)
          } else {
            let pc = dec.read_var_uint_raw()
            let pk = dec.read_var_uint_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            has_parent_id = true
            parent_id = Id::{ client: pc, clock: pk }
          }
          if has_psub {
            let ps = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_sub = Some(ps)
          }
        }
        let content = read_raw_content_raw(dec, ref_id, cout)
        if dec.has_err {
          return Err(dec.take_err())
        }
        let len_u = cout.len_u
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "item clock overflow"))
        }
        blocks.push(
          RawBlock::{
            id: Id::{ client: client, clock: clock },
            len: len_u,
            has_origin: has_orig,
            origin: origin,
            has_right_origin: has_rorig,
            right_origin: right_origin,
            parent_is_key: parent_is_key,
            parent_key: parent_key,
            has_parent_id: has_parent_id,
            parent_id: parent_id,
            parent_sub: parent_sub,
            has_parent_sub_bit: has_psub,
            content: content,
            raw_any_bytes: cout.raw_any,
          },
        )
        clock = clock + len_u
      }
      si = si + 1
    }
    if blocks.length() > 0 {
      clients_map.set(client.to_int64(), blocks)
    }
    ci = ci + 1
  }
  let ds = match read_delete_set(dec) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  Ok((clients_map, ds))
}

///| Run multi-pass causal integration on a decoded `(clients_map, ds)` and enqueue any unresolvable tail into `pending_updates`.
fn apply_decoded_map(
  doc : Doc,
  clients_map : Map[Int64, Array[RawBlock]],
  ds : DeleteSet,
  init_progressed : Bool,
) -> Result[Bool, CrdtError] {
  let mut progressed = init_progressed
  let ks = clients_map.keys()
  let client_ids : Array[UInt64] = Array::with_capacity(ks.length())
  let mut i = 0
  while i < ks.length() {
    client_ids.push(ks[i].to_uint64())
    i = i + 1
  }
  if client_ids.length() > 1 {
    sort_u64_desc(client_ids)
  }
  let cursors : Map[Int64, Int] = Map::new()
  i = 0
  while i < client_ids.length() {
    cursors.set(client_ids[i].to_int64(), 0)
    i = i + 1
  }
  let mut keep_going = true
  while keep_going {
    keep_going = false
    i = 0
    while i < client_ids.length() {
      let c = client_ids[i]
      let ck = c.to_int64()
      match clients_map.get(ck) {
        Some(blocks) => {
          let mut pos = match cursors.get(ck) {
            Some(p) => p
            None => 0
          }
          let mut local_clock = doc.store.get_clock(c)
          while pos < blocks.length() {
            let b = blocks[pos]
            match b.content {
              RawContent::RawSkip(_) => {
                pos = pos + 1
                continue
              }
              _ => ()
            }
            let b_end = b.id.clock + b.len
            if b_end <= local_clock {
              pos = pos + 1
              continue
            }
            let offset = if local_clock > b.id.clock {
              local_clock - b.id.clock
            } else {
              0UL
            }
            let ready_block = if offset > 0UL {
              slice_raw_block(b, offset, b.len - offset)
            } else {
              b
            }
            if !has_missing_dep(doc, ready_block, local_clock) {
              match integrate_raw_block(doc, b, offset) {
                Ok(()) => ()
                Err(e) => return Err(e)
              }
              local_clock = ready_block.id.clock + ready_block.len
              progressed = true
              keep_going = true
              pos = pos + 1
            } else {
              break
            }
          }
          cursors.set(ck, pos)
        }
        None => ()
      }
      i = i + 1
    }
  }
  let rest_map : Map[Int64, Array[RawBlock]] = Map::new()
  let mut has_rest = false
  i = 0
  while i < client_ids.length() {
    let c = client_ids[i]
    let ck = c.to_int64()
    match clients_map.get(ck) {
      Some(blocks) => {
        let pos = match cursors.get(ck) {
          Some(p) => p
          None => 0
        }
        if pos < blocks.length() {
          let rem : Array[RawBlock] = Array::new()
          let mut j = pos
          while j < blocks.length() {
            rem.push(blocks[j])
            j = j + 1
          }
          rest_map.set(ck, rem)
          has_rest = true
        }
      }
      None => ()
    }
    i = i + 1
  }
  let unapplied_ds = apply_delete_set_to_doc(doc, ds)
  let has_unapplied_ds = unapplied_ds.clients.length() > 0
  if has_rest || has_unapplied_ds {
    let pending_bytes = encode_raw_update(rest_map, unapplied_ds)
    if doc.store.pending_updates.length() == 0 {
      doc.store.pending_updates.push(pending_bytes)
    } else if !bytes_eq(doc.store.pending_updates[0], pending_bytes) {
      let pair : Array[Bytes] = Array::new()
      pair.push(doc.store.pending_updates[0])
      pair.push(pending_bytes)
      match merge_updates(pair) {
        Ok(merged) => doc.store.pending_updates[0] = merged
        Err(_) => ()
      }
    }
  }
  Ok(progressed)
}

///| Single-pass streaming apply for arbitrary single- or multi-client updates (zero RawBlock/RawContent/Map overhead on causally ready updates).
///| Returns `Ok(1)` if handled and progressed, `Ok(0)` if handled with no progress, `Ok(-1)` if fallback to general path is needed.
fn try_apply_streaming_fast(doc : Doc, update : Bytes) -> Result[Int, CrdtError] {
  let dec = Decoder::with_ascii_cache(update, doc.store.ascii_cache)
  let num_clients_u = dec.read_var_uint_raw()
  if dec.has_err {
    return Err(dec.take_err())
  }
  if num_clients_u > dec.remaining().to_int64().to_uint64() {
    return Err(CrdtError::new("EOF", "client count exceeds remaining buffer"))
  }
  let num_clients = num_clients_u.to_int()
  if num_clients > 1 {
    match prevalidate_multi_client_update(update, dec.pos, num_clients) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
  }
  let cout = RawContentOut::{ raw_any: None, len_u: 0UL }
  let mut progressed = false
  let mut prev_client = 0UL
  let mut has_seen_map = false
  let mut seen_clients : Option[Map[Int64, Bool]] = None
  let seen_list : Array[UInt64] = Array::new()
  let mut ci = 0
  while ci < num_clients {
    let num_structs_u = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    if num_structs_u > dec.remaining().to_int64().to_uint64() {
      return Err(CrdtError::new("EOF", "struct count exceeds remaining buffer"))
    }
    let num_structs = num_structs_u.to_int()
    let client = dec.read_var_uint_raw()
    let mut clock = dec.read_var_uint_raw()
    if dec.has_err {
      return Err(dec.take_err())
    }
    // Reject duplicate client blocks in a single wire update (O(1) zero-alloc when sorted descending)
    if ci == 0 {
      prev_client = client
    } else if !has_seen_map && client < prev_client {
      prev_client = client
    } else {
      if client == prev_client {
        return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
      }
      let sm = match seen_clients {
        Some(m) => m
        None => {
          let m : Map[Int64, Bool] = Map::new()
          let mut si_c = 0
          while si_c < seen_list.length() {
            m.set(seen_list[si_c].to_int64(), true)
            si_c = si_c + 1
          }
          seen_clients = Some(m)
          has_seen_map = true
          m
        }
      }
      let ck = client.to_int64()
      match sm.get(ck) {
        Some(_) => return Err(CrdtError::new("INVALID_UPDATE", "duplicate client block in update"))
        None => sm.set(ck, true)
      }
    }
    if num_clients > 1 && !has_seen_map {
      seen_list.push(client)
    }
    let mut local_clock = doc.store.get_clock(client)
    if clock > local_clock {
      if !progressed {
        return Ok(-1)
      }
      let (rest_map, ds) = match decode_remaining_clients_from(
        dec,
        client,
        clock,
        num_structs,
        num_clients - ci - 1,
        seen_list,
        seen_clients,
      ) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match apply_decoded_map(doc, rest_map, ds, progressed) {
        Ok(p) => return Ok(if p { 1 } else { 0 })
        Err(e) => return Err(e)
      }
    }
    let mut si = 0
    while si < num_structs {
      let struct_start_pos = dec.pos
      let info = dec.read_uint8_raw()
      if dec.has_err {
        return Err(dec.take_err())
      }
      let ref_id = info & 0x1f
      if ref_id == 0 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "GC clock overflow"))
        }
        let next_clock = clock + len_u
        if next_clock > local_clock {
          let off = if local_clock > clock { local_clock - clock } else { 0UL }
          let rem_len = len_u - off
          let len_i = if rem_len > 2147483647UL { 2147483647 } else { rem_len.to_int() }
          let idx = doc.store.push_item(
            Item::{
              id: Id::{ client: client, clock: clock + off },
              len: len_i,
              len_u64: rem_len,
              left: -1,
              right: -1,
              has_origin: false,
              origin_client: 0UL,
              origin_clock: 0UL,
              has_right_origin: false,
              right_origin_client: 0UL,
              right_origin_clock: 0UL,
              parent_id: -1,
              parent_key: None,
              has_parent_item_id: false,
              parent_item_client: 0UL,
              parent_item_clock: 0UL,
              parent_sub: None,
              deleted: true,
              countable: false,
              is_gc: true,
              content: Content::Gc(rem_len),
              raw_any_bytes: None,
            },
          )
          doc.integrate_item(idx, false)
          local_clock = next_clock
          progressed = true
        }
        clock = next_clock
      } else if ref_id == 10 {
        let len_u = dec.read_var_uint_raw()
        if dec.has_err {
          return Err(dec.take_err())
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "Skip clock overflow"))
        }
        let next_clock = clock + len_u
        if next_clock > local_clock {
          if !progressed {
            return Ok(-1)
          }
          dec.pos = struct_start_pos
          let (rest_map, ds) = match decode_remaining_clients_from(
            dec,
            client,
            clock,
            num_structs - si,
            num_clients - ci - 1,
            seen_list,
            seen_clients,
          ) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match apply_decoded_map(doc, rest_map, ds, progressed) {
            Ok(p) => return Ok(if p { 1 } else { 0 })
            Err(e) => return Err(e)
          }
        }
        clock = next_clock
      } else {
        let has_orig = (info & 0x80) != 0
        let has_rorig = (info & 0x40) != 0
        let has_psub = (info & 0x20) != 0
        let mut orig_c = 0UL
        let mut orig_k = 0UL
        if has_orig {
          orig_c = dec.read_var_uint_raw()
          orig_k = dec.read_var_uint_raw()
        }
        let mut rorig_c = 0UL
        let mut rorig_k = 0UL
        if has_rorig {
          rorig_c = dec.read_var_uint_raw()
          rorig_k = dec.read_var_uint_raw()
        }
        if dec.has_err {
          return Err(dec.take_err())
        }
        if has_orig && orig_c == client && orig_k >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client origin must precede item"))
        }
        if has_rorig && rorig_c == client && rorig_k >= clock {
          return Err(CrdtError::new("INVALID_PARENT", "same-client right origin must precede item"))
        }
        let mut parent_key : Option[String] = None
        let mut has_pid = false
        let mut pid_c = 0UL
        let mut pid_k = 0UL
        let mut parent_sub : Option[String] = None
        if !has_orig && !has_rorig {
          let pinfo = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          if pinfo == 1UL {
            let pk = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_key = Some(pk)
          } else {
            pid_c = dec.read_var_uint_raw()
            pid_k = dec.read_var_uint_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            has_pid = true
          }
          if has_psub {
            let ps = dec.read_var_string_raw()
            if dec.has_err {
              return Err(dec.take_err())
            }
            parent_sub = Some(ps)
          }
        }
        let mut len_u = 0UL
        let mut content = Content::Deleted(0UL)
        let mut raw_any : Option[Array[Bytes]] = None
        let mut countable = true
        let mut is_nested_type = false
        let mut nested_tr = 0
        let mut nested_name : Option[String] = None
        if ref_id == 4 {
          let s = dec.read_var_string_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          len_u = int_to_u64(dec.last_utf16_len)
          content = Content::Str(s)
        } else if ref_id == 1 {
          len_u = dec.read_var_uint_raw()
          if dec.has_err {
            return Err(dec.take_err())
          }
          content = Content::Deleted(len_u)
          countable = false
        } else {
          let rc = read_raw_content_raw(dec, ref_id, cout)
          if dec.has_err {
            return Err(dec.take_err())
          }
          len_u = cout.len_u
          raw_any = cout.raw_any
          content = match rc {
            RawContent::RawDeleted(n) => {
              countable = false
              Content::Deleted(n)
            }
            RawContent::RawJson(arr) => Content::Json(arr)
            RawContent::RawBinary(buf) => Content::Binary(buf)
            RawContent::RawStr(s) => Content::Str(s)
            RawContent::RawEmbed(s) => Content::Embed(s)
            RawContent::RawFormat(k, v) => {
              countable = false
              Content::Format(k, v)
            }
            RawContent::RawType(tr, node_name) => {
              is_nested_type = true
              nested_tr = tr
              nested_name = node_name
              Content::Type(-1)
            }
            RawContent::RawAnyList(arr) => Content::AnyList(arr)
            RawContent::RawDoc(guid, opts) => Content::Doc(guid, opts)
            _ => {
              countable = false
              Content::Deleted(len_u)
            }
          }
        }
        if len_u > 18446744073709551615UL - clock {
          return Err(CrdtError::new("OVERFLOW", "item clock overflow"))
        }
        let next_clock = clock + len_u
        if next_clock > local_clock {
          let missing = (
            has_orig && orig_c != client && orig_k >= doc.store.get_clock(orig_c)
          ) || (
            has_rorig && rorig_c != client && rorig_k >= doc.store.get_clock(rorig_c)
          ) || (
            has_pid && pid_c != client && pid_k >= doc.store.get_clock(pid_c)
          )
          if missing {
            if !progressed {
              return Ok(-1)
            }
            dec.pos = struct_start_pos
            let (rest_map, ds) = match decode_remaining_clients_from(
              dec,
              client,
              clock,
              num_structs - si,
              num_clients - ci - 1,
              seen_list,
              seen_clients,
            ) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            match apply_decoded_map(doc, rest_map, ds, progressed) {
              Ok(p) => return Ok(if p { 1 } else { 0 })
              Err(e) => return Err(e)
            }
          }
          let off = if local_clock > clock { local_clock - clock } else { 0UL }
          if off > 0UL {
            let rem_len = len_u - off
            let len_i = if rem_len > 2147483647UL { 2147483647 } else { rem_len.to_int() }
            match validate_overlap_prefix(
              doc,
              client,
              clock,
              off,
              has_orig,
              has_rorig,
              rorig_c,
              rorig_k,
              parent_key,
              has_pid,
              pid_c,
              pid_k,
              parent_sub,
            ) {
              Ok(true) => {
                let idx = doc.store.push_item(
                  Item::{
                    id: Id::{ client: client, clock: clock + off },
                    len: len_i,
                    len_u64: rem_len,
                    left: -1,
                    right: -1,
                    has_origin: false,
                    origin_client: 0UL,
                    origin_clock: 0UL,
                    has_right_origin: false,
                    right_origin_client: 0UL,
                    right_origin_clock: 0UL,
                    parent_id: -1,
                    parent_key: None,
                    has_parent_item_id: false,
                    parent_item_client: 0UL,
                    parent_item_clock: 0UL,
                    parent_sub: None,
                    deleted: true,
                    countable: false,
                    is_gc: true,
                    content: Content::Gc(rem_len),
                    raw_any_bytes: None,
                  },
                )
                doc.integrate_item(idx, false)
              }
              Ok(false) => {
                let (_, sliced_c) = content_split_u64(content, off)
                let sliced_raw : Option[Array[Bytes]] = match raw_any {
                  Some(raws) => {
                    let oi = off.to_int()
                    let nl = rem_len.to_int()
                    let out_r : Array[Bytes] = Array::with_capacity(nl)
                    let mut ri = oi
                    while ri < oi + nl && ri < raws.length() {
                      out_r.push(raws[ri])
                      ri = ri + 1
                    }
                    Some(out_r)
                  }
                  None => None
                }
                let idx = doc.store.push_item(
                  Item::{
                    id: Id::{ client: client, clock: clock + off },
                    len: len_i,
                    len_u64: rem_len,
                    left: -1,
                    right: -1,
                    has_origin: true,
                    origin_client: client,
                    origin_clock: clock + off - 1UL,
                    has_right_origin: has_rorig,
                    right_origin_client: rorig_c,
                    right_origin_clock: rorig_k,
                    parent_id: -1,
                    parent_key: parent_key,
                    has_parent_item_id: has_pid,
                    parent_item_client: pid_c,
                    parent_item_clock: pid_k,
                    parent_sub: parent_sub,
                    deleted: false,
                    countable: countable,
                    is_gc: false,
                    content: sliced_c,
                    raw_any_bytes: sliced_raw,
                  },
                )
                doc.integrate_item(idx, false)
              }
              Err(e) => return Err(e)
            }
          } else {
            let mut pre_left = -1
            let mut pre_right = -1
            let mut pre_resolved = false
            if has_orig && has_rorig {
              let l_raw = doc.store.get_item_idx_cc(orig_c, orig_k)
              let r_raw = doc.store.get_item_idx_cc(rorig_c, rorig_k)
              if l_raw >= 0 && r_raw >= 0 {
                let li = doc.store.items[l_raw]
                let ri = doc.store.items[r_raw]
                if !li.is_gc && !ri.is_gc {
                  if li.parent_id != ri.parent_id || !opt_str_eq(li.parent_sub, ri.parent_sub) {
                    return Err(
                      CrdtError::new("INVALID_PARENT", "origins belong to different containers"),
                    )
                  }
                }
              }
              if l_raw >= 0 {
                let lclk = doc.store.item_clock[l_raw]
                let llen = doc.store.item_len_u64[l_raw]
                let llast = if llen <= 1UL { lclk } else { u64_sat_add(lclk, llen - 1UL) }
                if llast > orig_k {
                  let _ = doc.split_item_u64(l_raw, orig_k - lclk + 1UL)
                }
                pre_left = l_raw
              }
              if r_raw >= 0 {
                if r_raw == l_raw {
                  pre_right = doc.get_item_clean_start_cc(rorig_c, rorig_k)
                } else {
                  let rclk = doc.store.item_clock[r_raw]
                  if rclk < rorig_k {
                    pre_right = doc.split_item_u64(r_raw, rorig_k - rclk)
                  } else {
                    pre_right = r_raw
                  }
                }
              }
              pre_resolved = true
            }
            if is_nested_type {
              content = Content::Type(doc.alloc_nested_type_raw(nested_tr, nested_name))
            }
            let len_i = if len_u > 2147483647UL { 2147483647 } else { len_u.to_int() }
            let idx = doc.store.push_item(
              Item::{
                id: Id::{ client: client, clock: clock },
                len: len_i,
                len_u64: len_u,
                left: pre_left,
                right: pre_right,
                has_origin: has_orig,
                origin_client: orig_c,
                origin_clock: orig_k,
                has_right_origin: has_rorig,
                right_origin_client: rorig_c,
                right_origin_clock: rorig_k,
                parent_id: -1,
                parent_key: parent_key,
                has_parent_item_id: has_pid,
                parent_item_client: pid_c,
                parent_item_clock: pid_k,
                parent_sub: parent_sub,
                deleted: false,
                countable: countable,
                is_gc: false,
                content: content,
                raw_any_bytes: raw_any,
              },
            )
            doc.integrate_item_resolved(idx, false, pre_resolved)
          }
          local_clock = next_clock
          progressed = true
        }
        clock = next_clock
      }
      si = si + 1
    }
    ci = ci + 1
  }
  let unapplied_ds_opt = match apply_wire_delete_set_streaming(doc, dec) {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  match unapplied_ds_opt {
    Some(unapplied_ds) => {
      if unapplied_ds.clients.length() > 0 {
        let empty_map : Map[Int64, Array[RawBlock]] = Map::new()
        let pending_bytes = encode_raw_update(empty_map, unapplied_ds)
        if doc.store.pending_updates.length() == 0 {
          doc.store.pending_updates.push(pending_bytes)
        } else if !bytes_eq(doc.store.pending_updates[0], pending_bytes) {
          let pair : Array[Bytes] = Array::new()
          pair.push(doc.store.pending_updates[0])
          pair.push(pending_bytes)
          match merge_updates(pair) {
            Ok(merged) => doc.store.pending_updates[0] = merged
            Err(_) => ()
          }
        }
      }
    }
    None => ()
  }
  Ok(if progressed { 1 } else { 0 })
}

///| Single pass of applying an update; returns `true` if any new struct or delete made progress.
fn apply_update_once(doc : Doc, update : Bytes) -> Result[Bool, CrdtError] {
  match try_apply_streaming_fast(doc, update) {
    Ok(1) => return Ok(true)
    Ok(0) => return Ok(false)
    Err(e) => return Err(e)
    _ => ()
  }
  let (clients_map, ds) = match decode_raw_update(update) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  apply_decoded_map(doc, clients_map, ds, false)
}

///| Decode and apply a Yjs v1 binary update to `doc`, resolving any buffered out-of-order updates.
///| Wire framing, UTF-8, overflow, and duplicate-client errors fail atomically before mutating `doc` on multi-client updates;
///| doc-state semantic rejections (e.g., cross-container origins or hostile overlap splices) return `Err` and may leave earlier ready items applied.
pub fn apply_update(doc : Doc, update : Bytes) -> Result[Unit, CrdtError] {
  let progressed = match apply_update_once(doc, update) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if progressed && doc.store.pending_updates.length() > 0 {
    let mut retry = true
    while retry && doc.store.pending_updates.length() > 0 {
      retry = false
      let batch : Array[Bytes] = Array::new()
      let mut i = 0
      while i < doc.store.pending_updates.length() {
        batch.push(doc.store.pending_updates[i])
        i = i + 1
      }
      doc.store.pending_updates.clear()
      i = 0
      while i < batch.length() {
        match apply_update_once(doc, batch[i]) {
          Ok(p) => {
            if p {
              retry = true
            }
          }
          Err(e) => return Err(e)
        }
        i = i + 1
      }
    }
  }
  Ok(())
}

// --- merge_updates & diff_update ---

///| Sort an array of `RawBlock`s by `id.clock` ascending.
fn sort_raw_blocks(arr : Array[RawBlock]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j].id.clock > key.id.clock {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| Deduplicate and normalize a single client's sorted `RawBlock` array, inserting `Skip` blocks for gaps.
fn normalize_client_blocks(client : UInt64, blocks : Array[RawBlock]) -> Array[RawBlock] {
  // Filter out Skip blocks first, then sort by clock
  let non_skips : Array[RawBlock] = Array::new()
  let mut i = 0
  while i < blocks.length() {
    match blocks[i].content {
      RawContent::RawSkip(_) => ()
      _ => non_skips.push(blocks[i])
    }
    i = i + 1
  }
  if non_skips.length() == 0 {
    return non_skips
  }
  sort_raw_blocks(non_skips)
  let out : Array[RawBlock] = Array::new()
  let mut cursor = non_skips[0].id.clock
  i = 0
  while i < non_skips.length() {
    let b = non_skips[i]
    let b_end = b.id.clock + b.len
    if b_end <= cursor {
      i = i + 1
      continue
    }
    if b.id.clock > cursor {
      let gap = b.id.clock - cursor
      out.push(
        RawBlock::{
          id: Id::{ client: client, clock: cursor },
          len: gap,
          has_origin: false,
          origin: empty_id(),
          has_right_origin: false,
          right_origin: empty_id(),
          parent_is_key: false,
          parent_key: None,
          has_parent_id: false,
          parent_id: empty_id(),
          parent_sub: None,
          has_parent_sub_bit: false,
          content: RawContent::RawSkip(gap),
          raw_any_bytes: None,
        },
      )
      cursor = b.id.clock
    }
    let off = cursor - b.id.clock
    let trimmed = if off > 0UL {
      slice_raw_block(b, off, b.len - off)
    } else {
      b
    }
    out.push(trimmed)
    cursor = trimmed.id.clock + trimmed.len
    i = i + 1
  }
  out
}

///| Merge multiple Yjs v1 binary updates into a single deduplicated v1 update.
pub fn merge_updates(updates : Array[Bytes]) -> Result[Bytes, CrdtError] {
  if updates.length() == 0 {
    let sb = StringBuilder::with_capacity(4)
    sb.write_byte((0).to_byte())
    sb.write_byte((0).to_byte())
    return Ok(sb.take_bytes())
  }
  if updates.length() == 1 {
    return Ok(updates[0])
  }
  let merged_clients : Map[Int64, Array[RawBlock]] = Map::new()
  let merged_ds = DeleteSet::new()
  let mut ui = 0
  while ui < updates.length() {
    let (cmap, ds) = match decode_raw_update(updates[ui]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let ks = cmap.keys()
    let mut ci = 0
    while ci < ks.length() {
      let ck = ks[ci]
      match cmap.get(ck) {
        Some(blocks) => match merged_clients.get(ck) {
          Some(existing) => {
            let mut j = 0
            while j < blocks.length() {
              existing.push(blocks[j])
              j = j + 1
            }
          }
          None => merged_clients.set(ck, blocks)
        }
        None => ()
      }
      ci = ci + 1
    }
    merged_ds.merge_from(ds)
    ui = ui + 1
  }
  let norm_clients : Map[Int64, Array[RawBlock]] = Map::new()
  let ks = merged_clients.keys()
  let mut ci = 0
  while ci < ks.length() {
    let ck = ks[ci]
    match merged_clients.get(ck) {
      Some(blocks) => {
        let norm = normalize_client_blocks(ck.to_uint64(), blocks)
        if norm.length() > 0 {
          norm_clients.set(ck, norm)
        }
      }
      None => ()
    }
    ci = ci + 1
  }
  Ok(encode_raw_update(norm_clients, merged_ds))
}

///| Filter a Yjs v1 binary update to only operations missing from in-memory `sv`.
pub fn diff_update_sv(update : Bytes, sv : StateVector) -> Result[Bytes, CrdtError] {
  let (cmap, ds) = match decode_raw_update(update) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let filtered : Map[Int64, Array[RawBlock]] = Map::new()
  let ks = cmap.keys()
  let mut ci = 0
  while ci < ks.length() {
    let ck = ks[ci]
    let c = ck.to_uint64()
    let target_clock = sv.get(c)
    match cmap.get(ck) {
      Some(blocks) => {
        let out : Array[RawBlock] = Array::new()
        let mut j = 0
        while j < blocks.length() {
          let b = blocks[j]
          let b_end = b.id.clock + b.len
          if b_end > target_clock {
            match b.content {
              RawContent::RawSkip(_) => {
                if out.length() > 0 {
                  out.push(b)
                }
              }
              _ => {
                if b.id.clock < target_clock {
                  let off = target_clock - b.id.clock
                  out.push(slice_raw_block(b, off, b.len - off))
                } else {
                  out.push(b)
                }
              }
            }
          }
          j = j + 1
        }
        if out.length() > 0 {
          filtered.set(ck, out)
        }
      }
      None => ()
    }
    ci = ci + 1
  }
  Ok(encode_raw_update(filtered, ds))
}

///| Filter a Yjs v1 binary update to only operations missing from binary `target_sv`.
pub fn diff_update(update : Bytes, target_sv : Bytes) -> Result[Bytes, CrdtError] {
  let sv = match decode_state_vector(target_sv) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  diff_update_sv(update, sv)
}
