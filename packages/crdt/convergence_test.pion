///| Strong Eventual Consistency (SEC) property tests & Official Node.js Yjs Golden Wire Vectors (20 tests).

///| Simple deterministic LCG PRNG for reproducible SEC fuzzing.
struct Prng {
  mut state : UInt64
}

///|
fn Prng::new(seed : UInt64) -> Prng {
  Prng::{ state: seed }
}

///|
fn Prng::next(self : Prng) -> UInt64 {
  self.state = self.state * 6364136223846793005UL + 1442695040888963407UL
  (self.state >> 16) & 0x7fffffffUL
}

///|
fn Prng::range(self : Prng, n : Int) -> Int {
  if n <= 0 {
    0
  } else {
    (self.next() % int_to_u64(n)).to_int()
  }
}

///|
fn apply_random_text_op(doc : Doc, rng : Prng, client_tag : String) -> Unit {
  let t = doc.get_text("shared")
  let cur_len = t.len(doc)
  let op = rng.range(10)
  if op < 7 || cur_len == 0 {
    let pos = rng.range(cur_len + 1)
    let r = rng.range(4)
    let chunk = if r == 0 {
      client_tag
    } else if r == 1 {
      client_tag + "x"
    } else if r == 2 {
      " "
    } else {
      "ab"
    }
    t.insert(doc, pos, chunk)
  } else {
    let pos = rng.range(cur_len)
    let max_del = cur_len - pos
    let del_len = 1 + rng.range(if max_del > 4 { 4 } else { max_del })
    t.delete(doc, pos, del_len)
  }
}

///|
fn apply_random_array_op(doc : Doc, rng : Prng, client_id : Int) -> Unit {
  let a = doc.get_array("arr")
  let cur_len = a.len(doc)
  let op = rng.range(10)
  if op < 7 || cur_len == 0 {
    let pos = rng.range(cur_len + 1)
    let v = (client_id * 1000 + rng.range(500)).to_int64()
    a.insert(doc, pos, Any::Int(v))
  } else {
    let pos = rng.range(cur_len)
    let max_del = cur_len - pos
    let del_len = 1 + rng.range(if max_del > 3 { 3 } else { max_del })
    a.delete(doc, pos, del_len)
  }
}

///|
fn apply_random_map_op(doc : Doc, rng : Prng, client_id : Int) -> Unit {
  let m = doc.get_map("map")
  let key_idx = rng.range(8)
  let key = "k" + key_idx.to_string()
  let op = rng.range(10)
  if op < 7 {
    m.set(doc, key, Any::Int((client_id * 100 + rng.range(100)).to_int64()))
  } else {
    m.delete(doc, key)
  }
}

///|
fn shuffle_updates(updates : Array[Bytes], rng : Prng) -> Array[Bytes] {
  let out : Array[Bytes] = Array::new()
  let mut i = 0
  while i < updates.length() {
    out.push(updates[i])
    i = i + 1
  }
  let mut j = out.length() - 1
  while j > 0 {
    let k = rng.range(j + 1)
    let tmp = out[j]
    out[j] = out[k]
    out[k] = tmp
    j = j - 1
  }
  out
}

///|
fn doc_canonical_snapshot(doc : Doc) -> String {
  let sb = StringBuilder::new()
  sb.write_string("T:")
  sb.write_string(doc.get_text("shared").to_string(doc))
  sb.write_string("|A:[")
  let arr = doc.get_array("arr").to_array(doc)
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(any_to_canonical_string(arr[i]))
    i = i + 1
  }
  sb.write_string("]|M:{")
  let m = doc.get_map("map")
  let ks = m.keys(doc)
  i = 0
  while i < ks.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(ks[i])
    sb.write_string("=")
    match m.get(doc, ks[i]) {
      Some(v) => sb.write_string(any_to_canonical_string(v))
      None => sb.write_string("NONE")
    }
    i = i + 1
  }
  sb.write_string("}")
  sb.to_string()
}

// --- Official Node.js Yjs Golden Wire Vector Tests (10) ---

///|
test "golden_yjs_g1_simple_ytext_decode" {
  let b = unwrap_bytes(hex_to_bytes("01010100040104746578740b48656c6c6f2c20596a732100"))
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g1")
  debug_assert(doc.get_text("text").to_string(doc) == "Hello, Yjs!", "g1 text")
}

///|
test "golden_yjs_g1_simple_ytext_encode_matches_wire" {
  let doc = Doc::new(1UL)
  doc.get_text("text").insert(doc, 0, "Hello, Yjs!")
  let encoded = doc.encode_state_as_update()
  debug_assert(
    bytes_to_hex(encoded) == "01010100040104746578740b48656c6c6f2c20596a732100",
    "g1 exact wire bytes",
  )
}

///|
test "golden_yjs_g2_cjk_insert_delete_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("01032a000101017406842a0507e4b896e7958c21c42a052a060550696f6e20012a010006"),
  )
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g2")
  debug_assert(doc.get_text("t").to_string(doc) == "Pion 世界!", "g2 text")
}

///|
test "golden_yjs_g3_two_client_concurrent_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("02011400040103646f6303424242010a00040103646f630341414100"),
  )
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g3")
  debug_assert(doc.get_text("doc").to_string(doc) == "AAABBB", "g3 text")
}

///|
test "golden_yjs_g3_two_client_concurrent_encode_exact" {
  let d3a = Doc::new(10UL)
  let d3b = Doc::new(20UL)
  d3a.get_text("doc").insert(d3a, 0, "AAA")
  d3b.get_text("doc").insert(d3b, 0, "BBB")
  must_ok_unit(d3a.apply_update(d3b.encode_state_as_update()), "sync")
  debug_assert(
    bytes_to_hex(d3a.encode_state_as_update()) == "02011400040103646f6303424242010a00040103646f630341414100",
    "g3 exact wire bytes",
  )
}

///|
test "golden_yjs_g4_yarray_mixed_any_delete_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("01030700080103617272027d0a7d4581070102880703037e770470696f6e7b400921fb54442d180107010202"),
  )
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g4")
  let out = doc.get_array("arr").to_array(doc)
  debug_assert(out.length() == 5, "g4 len 5")
  debug_assert(any_eq(out[0], Any::Int(10L)), "10")
  debug_assert(any_eq(out[1], Any::Int(-5L)), "-5")
  debug_assert(any_eq(out[2], Any::Null), "null")
  debug_assert(any_eq(out[3], Any::Str("pion")), "pion")
  debug_assert(any_eq(out[4], Any::Float(3.141592653589793)), "pi")
}

///|
test "golden_yjs_g5_ymap_nested_types_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("010863002801046d657461057469746c65017704435244542101046d6574610776657273696f6e01a86301017d022101046d6574610474656d70012701046d65746104626f647902040063040b6e657374656420746578742701046d657461047461677300080063100277017877017901630201010301"),
  )
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g5")
  let m = doc.get_map("meta")
  match m.get(doc, "title") {
    Some(v) => debug_assert(any_eq(v, Any::Str("CRDT")), "title")
    None => debug_assert(false, "missing title")
  }
  match m.get(doc, "version") {
    Some(v) => debug_assert(any_eq(v, Any::Int(2L)), "version == 2")
    None => debug_assert(false, "missing version")
  }
  debug_assert(!m.contains_key(doc, "temp"), "temp deleted")
  match m.get_text(doc, "body") {
    Some(bt) => debug_assert(bt.to_string(doc) == "nested text", "nested body")
    None => debug_assert(false, "missing body")
  }
  match m.get_array(doc, "tags") {
    Some(ta) => {
      let arr = ta.to_array(doc)
      debug_assert(arr.length() == 2 && any_eq(arr[0], Any::Str("x")) && any_eq(arr[1], Any::Str("y")), "tags")
    }
    None => debug_assert(false, "missing tags")
  }
}

///|
test "golden_yjs_g6_three_client_full_decode" {
  let b = unwrap_bytes(
    hex_to_bytes("0302ac0200446400045b305d202801016d016b017702763302c801008464050374776f2101016d016b0101640004010173097374617274206f6e6501c801010301"),
  )
  let doc = Doc::new(999UL)
  must_ok_unit(doc.apply_update(b), "apply g6_full")
  debug_assert(doc.get_text("s").to_string(doc) == "[0] start onetwo", "g6 text")
  match doc.get_map("m").get(doc, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("v3")), "g6 m[k] == v3")
    None => debug_assert(false, "missing m[k]")
  }
}

///|
test "golden_yjs_g6_incremental_out_of_order_decode" {
  let u1 = unwrap_bytes(hex_to_bytes("01016400040101730673746172742000"))
  let inc = unwrap_bytes(
    hex_to_bytes("0302ac0200446400045b305d202801016d016b017702763302c801008464050374776f2801016d016b0177027632016406846405036f6e6500"),
  )
  let doc = Doc::new(999UL)
  // Apply incremental BEFORE initial u1!
  must_ok_unit(doc.apply_update(inc), "apply inc first")
  must_ok_unit(doc.apply_update(u1), "apply u1 second")
  debug_assert(doc.get_text("s").to_string(doc) == "[0] start onetwo", "g6 ooo text")
  match doc.get_map("m").get(doc, "k") {
    Some(v) => debug_assert(any_eq(v, Any::Str("v3")), "g6 ooo m[k]")
    None => debug_assert(false, "missing m[k]")
  }
}

///|
test "golden_yjs_roundtrip_reencode_idempotent" {
  let g5 = unwrap_bytes(
    hex_to_bytes("010863002801046d657461057469746c65017704435244542101046d6574610776657273696f6e01a86301017d022101046d6574610474656d70012701046d65746104626f647902040063040b6e657374656420746578742701046d657461047461677300080063100277017877017901630201010301"),
  )
  let d1 = Doc::new(1UL)
  must_ok_unit(d1.apply_update(g5), "d1 apply g5")
  let reencoded = d1.encode_state_as_update()
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(reencoded), "d2 apply reencoded")
  match d2.get_map("meta").get_text(d2, "body") {
    Some(bt) => debug_assert(bt.to_string(d2) == "nested text", "roundtrip body")
    None => debug_assert(false, "missing body")
  }
  match d2.get_map("meta").get(d2, "version") {
    Some(v) => debug_assert(any_eq(v, Any::Int(2L)), "roundtrip version")
    None => debug_assert(false, "missing version")
  }
}

// --- Strong Eventual Consistency (SEC) Property Tests (10) ---

///|
test "sec_3_clients_text_forward_reverse_shuffle" {
  let rng = Prng::new(1001UL)
  let c1 = Doc::new(1UL)
  let c2 = Doc::new(2UL)
  let c3 = Doc::new(3UL)
  let mut i = 0
  while i < 60 {
    apply_random_text_op(c1, rng, "1")
    apply_random_text_op(c2, rng, "2")
    apply_random_text_op(c3, rng, "3")
    i = i + 1
  }
  let updates : Array[Bytes] = Array::new()
  updates.push(c1.encode_state_as_update())
  updates.push(c2.encode_state_as_update())
  updates.push(c3.encode_state_as_update())

  let fwd = Doc::new(10UL)
  let rev = Doc::new(11UL)
  let shuf = Doc::new(12UL)
  i = 0
  while i < 3 {
    must_ok_unit(fwd.apply_update(updates[i]), "fwd")
    must_ok_unit(rev.apply_update(updates[2 - i]), "rev")
    i = i + 1
  }
  let s_updates = shuffle_updates(updates, rng)
  i = 0
  while i < 3 {
    must_ok_unit(shuf.apply_update(s_updates[i]), "shuf")
    i = i + 1
  }
  let t_fwd = fwd.get_text("shared").to_string(fwd)
  let t_rev = rev.get_text("shared").to_string(rev)
  let t_shuf = shuf.get_text("shared").to_string(shuf)
  debug_assert(t_fwd == t_rev, "fwd == rev")
  debug_assert(t_fwd == t_shuf, "fwd == shuf")
}

///|
test "sec_5_clients_text_multi_round_partial_sync" {
  let rng = Prng::new(2002UL)
  let docs : Array[Doc] = Array::new()
  let mut c = 0
  while c < 5 {
    docs.push(Doc::new(int_to_u64(c + 1) * 17UL))
    c = c + 1
  }
  let mut round = 0
  while round < 5 {
    c = 0
    while c < 5 {
      let mut k = 0
      while k < 20 {
        apply_random_text_op(docs[c], rng, c.to_string())
        k = k + 1
      }
      c = c + 1
    }
    // Partial random gossip between pairs
    let mut g = 0
    while g < 6 {
      let a = rng.range(5)
      let b = rng.range(5)
      if a != b {
        let u = docs[a].encode_state_as_update()
        must_ok_unit(docs[b].apply_update(u), "gossip")
      }
      g = g + 1
    }
    round = round + 1
  }
  // Final full sync in different orders
  let all_u : Array[Bytes] = Array::new()
  c = 0
  while c < 5 {
    all_u.push(docs[c].encode_state_as_update())
    c = c + 1
  }
  c = 0
  while c < 5 {
    let perm = shuffle_updates(all_u, rng)
    let mut j = 0
    while j < perm.length() {
      must_ok_unit(docs[c].apply_update(perm[j]), "final sync")
      j = j + 1
    }
    c = c + 1
  }
  let expected = docs[0].get_text("shared").to_string(docs[0])
  c = 1
  while c < 5 {
    debug_assert(docs[c].get_text("shared").to_string(docs[c]) == expected, "5-client SEC text")
    c = c + 1
  }
}

///|
test "sec_4_clients_array_random_edits" {
  let rng = Prng::new(3003UL)
  let docs : Array[Doc] = Array::new()
  let mut c = 0
  while c < 4 {
    docs.push(Doc::new(int_to_u64(c + 1) * 10UL))
    c = c + 1
  }
  let mut step = 0
  while step < 50 {
    let who = rng.range(4)
    apply_random_array_op(docs[who], rng, who + 1)
    if step % 10 == 0 {
      let dst = (who + 1) % 4
      must_ok_unit(docs[dst].apply_update(docs[who].encode_state_as_update()), "ring sync")
    }
    step = step + 1
  }
  let all_u : Array[Bytes] = Array::new()
  c = 0
  while c < 4 {
    all_u.push(docs[c].encode_state_as_update())
    c = c + 1
  }
  c = 0
  while c < 4 {
    let perm = shuffle_updates(all_u, rng)
    let mut j = 0
    while j < perm.length() {
      must_ok_unit(docs[c].apply_update(perm[j]), "final")
      j = j + 1
    }
    c = c + 1
  }
  let snap0 = doc_canonical_snapshot(docs[0])
  c = 1
  while c < 4 {
    debug_assert(doc_canonical_snapshot(docs[c]) == snap0, "4-client array SEC")
    c = c + 1
  }
}

