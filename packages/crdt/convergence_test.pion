}

///|
test "sec_5_clients_mixed_text_array_map_with_duplicates" {
  let rng = Prng::new(5005UL)
  let docs : Array[Doc] = Array::new()
  let mut c = 0
  while c < 5 {
    docs.push(Doc::new(int_to_u64(c + 1) * 101UL))
    c = c + 1
  }
  let mut step = 0
  while step < 150 {
    let who = rng.range(5)
    let kind = rng.range(3)
    if kind == 0 {
      apply_random_text_op(docs[who], rng, who.to_string())
    } else if kind == 1 {
      apply_random_array_op(docs[who], rng, who + 1)
    } else {
      apply_random_map_op(docs[who], rng, who + 1)
    }
    if step % 15 == 0 {
      let other = rng.range(5)
      if other != who {
        must_ok_unit(docs[other].apply_update(docs[who].encode_state_as_update()), "gossip")
      }
    }
    step = step + 1
  }
  // Collect updates with duplicates
  let bag : Array[Bytes] = Array::new()
  c = 0
  while c < 5 {
    let u = docs[c].encode_state_as_update()
    bag.push(u)
    bag.push(u) // duplicate delivery!
    c = c + 1
  }
  c = 0
  while c < 5 {
    let perm = shuffle_updates(bag, rng)
    let mut j = 0
    while j < perm.length() {
      must_ok_unit(docs[c].apply_update(perm[j]), "dup shuffled sync")
      j = j + 1
    }
    c = c + 1
  }
  let snap0 = doc_canonical_snapshot(docs[0])
  c = 1
  while c < 5 {
    debug_assert(doc_canonical_snapshot(docs[c]) == snap0, "5-client mixed SEC")
    c = c + 1
  }
}

///|
test "sec_3_clients_fragmented_incremental_shuffled" {
  let rng = Prng::new(6006UL)
  let c1 = Doc::new(1UL)
  let c2 = Doc::new(2UL)
  let c3 = Doc::new(3UL)
  let frags : Array[Bytes] = Array::new()
  let mut round = 0
  while round < 10 {
    let sv1 = c1.encode_state_vector()
    apply_random_text_op(c1, rng, "a")
    apply_random_text_op(c1, rng, "a")
    frags.push(must_ok_bytes(c1.encode_state_as_update_from(sv1), "f1"))

    let sv2 = c2.encode_state_vector()
    apply_random_text_op(c2, rng, "b")
    apply_random_text_op(c2, rng, "b")
    frags.push(must_ok_bytes(c2.encode_state_as_update_from(sv2), "f2"))

    let sv3 = c3.encode_state_vector()
    apply_random_text_op(c3, rng, "c")
    apply_random_text_op(c3, rng, "c")
    frags.push(must_ok_bytes(c3.encode_state_as_update_from(sv3), "f3"))
    round = round + 1
  }

  let r1 = Doc::new(50UL)
  let r2 = Doc::new(51UL)
  let r3 = Doc::new(52UL)
  let mut i = 0
  while i < frags.length() {
    must_ok_unit(r1.apply_update(frags[i]), "r1 fwd")
    must_ok_unit(r2.apply_update(frags[frags.length() - 1 - i]), "r2 rev")
    i = i + 1
  }
  let perm = shuffle_updates(frags, rng)
  i = 0
  while i < perm.length() {
    must_ok_unit(r3.apply_update(perm[i]), "r3 shuf")
    i = i + 1
  }
  let s1 = r1.get_text("shared").to_string(r1)
  debug_assert(s1 == r2.get_text("shared").to_string(r2), "fwd == rev frags")
  debug_assert(s1 == r3.get_text("shared").to_string(r3), "fwd == shuf frags")
}

///|
test "sec_merge_updates_matches_sequential_apply" {
  let rng = Prng::new(7007UL)
  let docs : Array[Doc] = Array::new()
  let mut c = 0
  while c < 4 {
    docs.push(Doc::new(int_to_u64(c + 1) * 7UL))
    let mut k = 0
    while k < 25 {
      apply_random_text_op(docs[c], rng, c.to_string())
      apply_random_map_op(docs[c], rng, c + 1)
      k = k + 1
    }
    c = c + 1
  }
  let updates : Array[Bytes] = Array::new()
  c = 0
  while c < 4 {
    updates.push(docs[c].encode_state_as_update())
    c = c + 1
  }
  let seq_doc = Doc::new(90UL)
  c = 0
  while c < 4 {
    must_ok_unit(seq_doc.apply_update(updates[c]), "seq")
    c = c + 1
  }
  let merged = must_ok_bytes(merge_updates(updates), "merge")
  let merged_doc = Doc::new(91UL)
  must_ok_unit(merged_doc.apply_update(merged), "merged")
  debug_assert(
    doc_canonical_snapshot(seq_doc) == doc_canonical_snapshot(merged_doc),
    "merged == sequential",
  )
}

///|
test "sec_yata_deep_conflict_chain" {
  // Classic YATA anomaly test: 3 clients inserting at same origin with different rightOrigins
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let d3 = Doc::new(3UL)
  d1.get_text("t").insert(d1, 0, "ab")
  let base = d1.encode_state_as_update()
  must_ok_unit(d2.apply_update(base), "d2 base")
  must_ok_unit(d3.apply_update(base), "d3 base")

  // d2 inserts "2" between a and b, syncs to d1, then d1 inserts "1" between a and 2
  d2.get_text("t").insert(d2, 1, "2")
  must_ok_unit(d1.apply_update(d2.encode_state_as_update()), "d1 gets 2")
  d1.get_text("t").insert(d1, 1, "1")
  // Concurrently, d3 inserts "3" between a and b
  d3.get_text("t").insert(d3, 1, "3")

  let u1 = d1.encode_state_as_update()
  let u2 = d2.encode_state_as_update()
  let u3 = d3.encode_state_as_update()

  let a = Doc::new(10UL)
  let b = Doc::new(11UL)
  let c = Doc::new(12UL)
  must_ok_unit(a.apply_update(u1), "a1")
  must_ok_unit(a.apply_update(u2), "a2")
  must_ok_unit(a.apply_update(u3), "a3")

  must_ok_unit(b.apply_update(u3), "b3")
  must_ok_unit(b.apply_update(u1), "b1")
  must_ok_unit(b.apply_update(u2), "b2")

  must_ok_unit(c.apply_update(u2), "c2")
  must_ok_unit(c.apply_update(u3), "c3")
  must_ok_unit(c.apply_update(u1), "c1")

  let sa = a.get_text("t").to_string(a)
  let sb = b.get_text("t").to_string(b)
  let sc = c.get_text("t").to_string(c)
  debug_assert(sa == sb && sb == sc, "deep YATA conflict converged")
  debug_assert(sa == "a123b", "exact YATA order a123b")
}

///|
test "sec_high_client_id_u64_tiebreak" {
  let d1 = Doc::new(1000000000UL)
  let d2 = Doc::new(2000000000UL)
  let d3 = Doc::new(3000000000UL)
  d1.get_text("t").insert(d1, 0, "1")
  d2.get_text("t").insert(d2, 0, "2")
  d3.get_text("t").insert(d3, 0, "3")
  let u1 = d1.encode_state_as_update()
  let u2 = d2.encode_state_as_update()
  let u3 = d3.encode_state_as_update()
  must_ok_unit(d1.apply_update(u3), "d1<-3")
  must_ok_unit(d1.apply_update(u2), "d1<-2")
  must_ok_unit(d3.apply_update(u1), "d3<-1")
  must_ok_unit(d3.apply_update(u2), "d3<-2")
  debug_assert(d1.get_text("t").to_string(d1) == "123", "large client ids order")
  debug_assert(d3.get_text("t").to_string(d3) == "123", "large client ids converged")
}

///|
test "sec_nested_structures_concurrent_convergence" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let t1 = d1.get_map("root").set_text(d1, "doc")
  t1.insert(d1, 0, "hello")
  let base = d1.encode_state_as_update()
  must_ok_unit(d2.apply_update(base), "d2 init")
  t1.insert(d1, 5, " from1")
  match d2.get_map("root").get_text(d2, "doc") {
    Some(t2) => t2.insert(d2, 5, " from2")
    None => debug_assert(false, "missing doc on d2")
  }
  must_ok_unit(d1.apply_update(d2.encode_state_as_update()), "d1<-d2")
  must_ok_unit(d2.apply_update(d1.encode_state_as_update()), "d2<-d1")
  let s1 = t1.to_string(d1)
  match d2.get_map("root").get_text(d2, "doc") {
    Some(t2) => {
      debug_assert(s1 == "hello from1 from2", "nested concurrent text")
      debug_assert(t2.to_string(d2) == s1, "nested converged")
    }
    None => debug_assert(false, "missing doc on d2")
  }
}
