///| Regression tests for red-team P0/P1/P2 fixes:
///| - SearchMarker invalidation on remote delete
///| - UTF-16 surrogate pair splitting (U+FFFD alignment with yjs/yrs)
///| - XML types & Subdoc lossless roundtrip
///| - Bounds checking, depth limit, invalid UTF-8 rejection, 64-bit GC clocks, pending dedup
///| - GC compaction and YText::format overlap/nesting semantics

test "regression_decoder_bounds_and_depth_limit" {
  // 15-byte crafted payload with string length 2^31-1 must return Err, not panic
  let bad_len = match hex_to_bytes("0101050004010174ffffffff074100") {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let d = Doc::new(1UL)
  match d.apply_update(bad_len) {
    Ok(_) => debug_assert(false, "expected EOF error on huge string length")
    Err(_) => ()
  }

  // Deeply nested lib0 Any array (>128 levels) must return DEPTH_LIMIT error
  let enc = Encoder::new()
  let mut i = 0
  while i < 200 {
    enc.write_uint8(117)
    enc.write_var_uint(1UL)
    i = i + 1
  }
  enc.write_uint8(126)
  let dec = Decoder::new(enc.to_bytes())
  match dec.read_any() {
    Ok(_) => debug_assert(false, "expected DEPTH_LIMIT error")
    Err(e) => debug_assert(e.code == "DEPTH_LIMIT", "expected DEPTH_LIMIT, got " + e.code)
  }
}

test "regression_utf16_split_surrogate_pair" {
  // "😀ab" = F0 9F 98 80 61 62
  let emoji_ab = match hex_to_bytes("f09f98806162") {
    Ok(b) => b.to_string()
    Err(_) => ""
  }
  let (l, r) = utf16_split(emoji_ab, 1)
  debug_assert(utf16_len(l) == 1, "left half is 1 UTF-16 unit")
  debug_assert(utf16_len(r) == 3, "right half is 3 UTF-16 units")
  let expected_l = match hex_to_bytes("efbfbd") {
    Ok(b) => b.to_string()
    Err(_) => ""
  }
  let expected_r = match hex_to_bytes("efbfbd6162") {
    Ok(b) => b.to_string()
    Err(_) => ""
  }
  debug_assert(l == expected_l, "left half should be U+FFFD")
  debug_assert(r == expected_r, "right half should be U+FFFD + ab")
}

test "regression_gc_compaction_and_pending_dedup" {
  let d = Doc::new(10UL)
  let t = d.get_text("t")
  t.insert(d, 0, "hello ")
  t.insert(d, 6, "TOP-SECRET-TOKEN")
  t.delete(d, 6, 16)
  let u = d.encode_state_as_update()
  let hex = bytes_to_hex(u)
  let secret_hex = bytes_to_hex("TOP-SECRET-TOKEN".to_bytes())
  debug_assert(hex.index_of(secret_hex) < 0, "deleted text must not appear in update")

  // Pending deduplication: 50 duplicate deliveries keep 1 pending update
  let d2 = Doc::new(11UL)
  let future_u = match hex_to_bytes("0101090504010174017800") {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let mut k = 0
  while k < 50 {
    let _ = d2.apply_update(future_u)
    k = k + 1
  }
  debug_assert(d2.store.pending_updates.length() == 1, "pending updates must be deduplicated")
}

test "regression_linear_append_chunking" {
  let d = Doc::new(1UL)
  let t = d.get_text("t")
  let mut i = 0
  while i < 1000 {
    t.insert(d, i, "a")
    i = i + 1
  }
  debug_assert(t.len(d) == 1000, "len 1000")
  debug_assert(t.to_string(d).length() == 1000, "str len 1000")
  // Verify update roundtrip merges contiguous chunks cleanly
  let u = d.encode_state_as_update()
  let d2 = Doc::new(2UL)
  match d2.apply_update(u) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "apply failed: " + e.code)
  }
  debug_assert(d2.get_text("t").to_string(d2) == t.to_string(d), "roundtrip match")
}

///| Regression tests for C5 64-bit unsigned clock + len wraparound in DeleteItem / DeleteSet / wire decoder.
test "regression_delete_item_u64_wraparound" {
  // 1. DeleteItem::{clock = 2^64 - 2, len = 4} must cover 2^64 - 2 and 2^64 - 1 without wrapping
  let it = DeleteItem::{ clock: 18446744073709551614UL, len: 4UL }
  debug_assert(
    delete_item_contains(it, 18446744073709551614UL),
    "contains 2^64-2",
  )
  debug_assert(
    delete_item_contains(it, 18446744073709551615UL),
    "contains 2^64-1",
  )
  debug_assert(!delete_item_contains(it, 0UL), "must not wrap to 0")
  debug_assert(
    !delete_item_contains(it, 18446744073709551613UL),
    "must not contain 2^64-3",
  )
  debug_assert(
    delete_item_can_merge(
      it,
      DeleteItem::{ clock: 18446744073709551615UL, len: 1UL },
    ),
    "can_merge near u64 max",
  )

  // 2. merge({10, 5}, {12, 2^64 - 6}) must not drop b's range [12, 2^64)
  let a = DeleteItem::{ clock: 10UL, len: 5UL }
  let b = DeleteItem::{ clock: 12UL, len: 18446744073709551610UL }
  debug_assert(delete_item_can_merge(a, b), "a and b overlap")
  let m = delete_item_merge(a, b)
  debug_assert(m.clock == 10UL, "merged clock == 10")
  debug_assert(
    m.len == 18446744073709551612UL,
    "merged len covers full span without wrap",
  )
  debug_assert(delete_item_contains(m, 10UL), "merged contains 10")
  debug_assert(delete_item_contains(m, 1000UL), "merged contains 1000")
  debug_assert(
    delete_item_contains(m, 18446744073709551615UL),
    "merged contains 2^64-1",
  )
  debug_assert(!delete_item_contains(m, 9UL), "merged excludes 9")

  // 3. DeleteSet.is_deleted near u64 max
  let ds = DeleteSet::new()
  ds.add(1UL, 18446744073709551614UL, 4UL)
  debug_assert(
    ds.is_deleted(1UL, 18446744073709551614UL),
    "ds is_deleted 2^64-2",
  )
  debug_assert(
    ds.is_deleted(1UL, 18446744073709551615UL),
    "ds is_deleted 2^64-1",
  )
  debug_assert(!ds.is_deleted(1UL, 0UL), "ds not deleted 0")

  // 4. item_last_id saturates instead of wrapping around
  let lid = item_last_id(Id::new(1UL, 18446744073709551614UL), 4UL)
  debug_assert(
    lid.clock == 18446744073709551615UL,
    "item_last_id saturates at u64 max",
  )

  // 5. Malicious binary update with wrapping DeleteSet (clock=2^64-2, len=4) must be rejected by apply_update
  let enc1 = Encoder::new()
  enc1.write_var_uint(0UL) // 0 struct clients
  enc1.write_var_uint(1UL) // 1 delete-set client
  enc1.write_var_uint(1UL) // client id = 1
  enc1.write_var_uint(1UL) // 1 delete range
  enc1.write_var_uint(18446744073709551614UL) // clock = 2^64 - 2
  enc1.write_var_uint(4UL) // len = 4 (wraps!)
  let d1 = Doc::new(99UL)
  match d1.apply_update(enc1.to_bytes()) {
    Ok(_) => debug_assert(false, "expected OVERFLOW rejection for wrapping DeleteSet (2^64-2, 4)")
    Err(e) => debug_assert(e.code == "OVERFLOW", "expected OVERFLOW, got " + e.code)
  }

  // 6. Malicious binary update with wrapping DeleteSet (clock=12, len=2^64-6) must be rejected by apply_update
  let enc2 = Encoder::new()
  enc2.write_var_uint(0UL) // 0 struct clients
  enc2.write_var_uint(1UL) // 1 delete-set client
  enc2.write_var_uint(1UL) // client id = 1
  enc2.write_var_uint(1UL) // 1 delete range
  enc2.write_var_uint(12UL) // clock = 12
  enc2.write_var_uint(18446744073709551610UL) // len = 2^64 - 6 (wraps!)
  let d2 = Doc::new(99UL)
  match d2.apply_update(enc2.to_bytes()) {
    Ok(_) => debug_assert(false, "expected OVERFLOW rejection for wrapping DeleteSet (12, 2^64-6)")
    Err(e) => debug_assert(e.code == "OVERFLOW", "expected OVERFLOW, got " + e.code)
  }

  // 7. Non-wrapping boundary DeleteSet (clock=2^64-6, len=5, sum=2^64-1) is accepted
  let enc3 = Encoder::new()
  enc3.write_var_uint(0UL)
  enc3.write_var_uint(1UL)
  enc3.write_var_uint(1UL)
  enc3.write_var_uint(1UL)
  enc3.write_var_uint(18446744073709551610UL)
  enc3.write_var_uint(5UL)
  let d3 = Doc::new(99UL)
  match d3.apply_update(enc3.to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "unexpected error on valid boundary DeleteSet: " + e.code)
  }
}
