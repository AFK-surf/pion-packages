///| StateVector, incremental sync, merge_updates, diff_update, and out-of-order delivery tests (25 tests).

///|
fn must_ok_unit(r : Result[Unit, CrdtError], ctx : String) -> Unit {
  match r {
    Ok(_) => ()
    Err(e) => debug_assert(false, ctx + ": " + e.message)
  }
}

///|
fn must_ok_bytes(r : Result[Bytes, CrdtError], ctx : String) -> Bytes {
  match r {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, ctx + ": " + e.message)
      Bytes::new(0)
    }
  }
}

///|
fn must_ok_sv(r : Result[StateVector, CrdtError], ctx : String) -> StateVector {
  match r {
    Ok(sv) => sv
    Err(e) => {
      debug_assert(false, ctx + ": " + e.message)
      StateVector::new()
    }
  }
}

///|
test "sv_empty_doc" {
  let doc = Doc::new(1UL)
  let sv_bytes = doc.encode_state_vector()
  debug_assert(bytes_to_hex(sv_bytes) == "00", "empty sv is 0x00")
  let sv = must_ok_sv(decode_state_vector(sv_bytes), "decode empty sv")
  debug_assert(sv.len() == 0, "0 clients")
}

///|
test "sv_single_client_golden" {
  let doc = Doc::new(1UL)
  doc.get_text("text").insert(doc, 0, "Hello, Yjs!")
  let sv_bytes = doc.encode_state_vector()
  debug_assert(bytes_to_hex(sv_bytes) == "01010b", "matches yjs encodeStateVector")
  let sv = must_ok_sv(decode_state_vector(sv_bytes), "decode sv")
  debug_assert(sv.get(1UL) == 11UL, "clock == 11")
  debug_assert(sv.get(2UL) == 0UL, "unseen client == 0")
}

///|
test "sv_multi_client_roundtrip" {
  let d1 = Doc::new(10UL)
  let d2 = Doc::new(20UL)
  d1.get_text("t").insert(d1, 0, "abc")
  d2.get_text("t").insert(d2, 0, "defgh")
  must_ok_unit(d1.apply_update(d2.encode_state_as_update()), "apply")
  let sv = must_ok_sv(decode_state_vector(d1.encode_state_vector()), "decode")
  debug_assert(sv.len() == 2, "2 clients")
  debug_assert(sv.get(10UL) == 3UL, "c10 == 3")
  debug_assert(sv.get(20UL) == 5UL, "c20 == 5")
}

///|
test "sync_incremental_update_only_sends_delta" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "first part ")
  must_ok_unit(d2.apply_update(d1.encode_state_as_update()), "initial sync")
  let sv2 = d2.encode_state_vector()
  d1.get_text("t").push(d1, "second")
  let full = d1.encode_state_as_update()
  let delta = must_ok_bytes(d1.encode_state_as_update_from(sv2), "delta")
  debug_assert(delta.length() < full.length(), "delta smaller than full")
  must_ok_unit(d2.apply_update(delta), "apply delta")
  debug_assert(d2.get_text("t").to_string(d2) == "first part second", "synced")
}

///|
test "sync_incremental_up_to_date_empty" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "hello")
  let sv = d1.encode_state_vector()
  let delta = must_ok_bytes(d1.encode_state_as_update_from(sv), "delta")
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(d1.encode_state_as_update()), "init")
  must_ok_unit(d2.apply_update(delta), "apply empty delta")
  debug_assert(d2.get_text("t").to_string(d2) == "hello", "unchanged")
}

///|
test "sync_apply_update_idempotent_duplicate" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "hello world")
  d1.get_text("t").delete(d1, 5, 6)
  let u = d1.encode_state_as_update()
  must_ok_unit(d2.apply_update(u), "apply 1")
  must_ok_unit(d2.apply_update(u), "apply 2")
  must_ok_unit(d2.apply_update(u), "apply 3")
  debug_assert(d2.get_text("t").to_string(d2) == "hello", "idempotent")
}

///|
test "sync_apply_empty_update" {
  let d1 = Doc::new(1UL)
  let empty = d1.encode_state_as_update()
  let d2 = Doc::new(2UL)
  d2.get_text("t").insert(d2, 0, "keep")
  must_ok_unit(d2.apply_update(empty), "apply empty")
  debug_assert(d2.get_text("t").to_string(d2) == "keep", "kept")
}

///|
test "sync_out_of_order_same_client_fragments" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "AAA")
  let u1 = d1.encode_state_as_update()
  let sv1 = d1.encode_state_vector()
  d1.get_text("t").insert(d1, 3, "BBB")
  let u2 = must_ok_bytes(d1.encode_state_as_update_from(sv1), "u2")
  let sv2 = d1.encode_state_vector()
  d1.get_text("t").insert(d1, 6, "CCC")
  let u3 = must_ok_bytes(d1.encode_state_as_update_from(sv2), "u3")

  let d2 = Doc::new(2UL)
  // Deliver in reverse order: u3, u2, u1!
  must_ok_unit(d2.apply_update(u3), "u3")
  must_ok_unit(d2.apply_update(u2), "u2")
  must_ok_unit(d2.apply_update(u1), "u1")
  debug_assert(d2.get_text("t").to_string(d2) == "AAABBBCCC", "out-of-order resolved")
}

///|
test "sync_out_of_order_cross_client_causal_dep" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "base")
  let u1 = d1.encode_state_as_update()
  must_ok_unit(d2.apply_update(u1), "d2 gets u1")
  let sv = d2.encode_state_vector()
  d2.get_text("t").insert(d2, 4, "_ext")
  let u2 = must_ok_bytes(d2.encode_state_as_update_from(sv), "u2 depends on u1")

  let d3 = Doc::new(3UL)
  // Deliver u2 BEFORE u1!
  must_ok_unit(d3.apply_update(u2), "u2 first")
  must_ok_unit(d3.apply_update(u1), "u1 second")
  debug_assert(d3.get_text("t").to_string(d3) == "base_ext", "causal dep resolved")
}

///|
test "sync_out_of_order_delete_before_insert" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  d1.get_text("t").insert(d1, 0, "hello world")
  let u_ins = d1.encode_state_as_update()
  must_ok_unit(d2.apply_update(u_ins), "d2 init")
  let sv = d2.encode_state_vector()
  d2.get_text("t").delete(d2, 0, 6)
  let u_del = must_ok_bytes(d2.encode_state_as_update_from(sv), "delete only update")

  let d3 = Doc::new(3UL)
  must_ok_unit(d3.apply_update(u_del), "delete arrives first")
  must_ok_unit(d3.apply_update(u_ins), "insert arrives second")
  debug_assert(d3.get_text("t").to_string(d3) == "world", "pending delete applied")
}

///|
test "sync_out_of_order_nested_type_child_before_parent" {
  let d1 = Doc::new(1UL)
  let m1 = d1.get_map("m")
  let t1 = m1.set_text(d1, "doc")
  let u_parent = d1.encode_state_as_update()
  let sv1 = d1.encode_state_vector()
  t1.insert(d1, 0, "nested content")
  let u_child = must_ok_bytes(d1.encode_state_as_update_from(sv1), "child")

  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(u_child), "child first")
  must_ok_unit(d2.apply_update(u_parent), "parent second")
  match d2.get_map("m").get_text(d2, "doc") {
    Some(t2) => debug_assert(t2.to_string(d2) == "nested content", "nested resolved")
    None => debug_assert(false, "missing nested text")
  }
}

///|
test "sync_merge_updates_empty_list" {
  let updates : Array[Bytes] = Array::new()
  let m = must_ok_bytes(merge_updates(updates), "merge empty")
  let d = Doc::new(1UL)
  must_ok_unit(d.apply_update(m), "apply empty merge")
}

///|
test "sync_merge_updates_single" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "solo")
  let u = d1.encode_state_as_update()
  let updates : Array[Bytes] = Array::new()
  updates.push(u)
  let m = must_ok_bytes(merge_updates(updates), "merge 1")
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(m), "apply")
  debug_assert(d2.get_text("t").to_string(d2) == "solo", "solo")
}

///|
test "sync_merge_updates_multiple_clients" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let d3 = Doc::new(3UL)
  d1.get_text("t").insert(d1, 0, "A")
  d2.get_text("t").insert(d2, 0, "B")
  d3.get_text("t").insert(d3, 0, "C")
  let updates : Array[Bytes] = Array::new()
  updates.push(d3.encode_state_as_update())
  updates.push(d1.encode_state_as_update())
  updates.push(d2.encode_state_as_update())
  let merged = must_ok_bytes(merge_updates(updates), "merge 3")
  let dst = Doc::new(99UL)
  must_ok_unit(dst.apply_update(merged), "apply merged")
  debug_assert(dst.get_text("t").to_string(dst) == "ABC", "ABC")
}

///|
test "sync_merge_updates_deduplicates_overlaps" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "hello")
  let u1 = d1.encode_state_as_update()
  d1.get_text("t").push(d1, " world")
  let u2 = d1.encode_state_as_update()
  let updates : Array[Bytes] = Array::new()
  updates.push(u1)
  updates.push(u2)
  updates.push(u1)
  let merged = must_ok_bytes(merge_updates(updates), "merge overlapping")
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(merged), "apply")
  debug_assert(d2.get_text("t").to_string(d2) == "hello world", "deduped")
}

///|
test "sync_merge_updates_with_deletes" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "abcdef")
  let u1 = d1.encode_state_as_update()
  let sv1 = d1.encode_state_vector()
  d1.get_text("t").delete(d1, 1, 4)
  let u2 = must_ok_bytes(d1.encode_state_as_update_from(sv1), "del")
  let updates : Array[Bytes] = Array::new()
  updates.push(u1)
  updates.push(u2)
  let merged = must_ok_bytes(merge_updates(updates), "merge ins+del")
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(merged), "apply")
  debug_assert(d2.get_text("t").to_string(d2) == "af", "af")
}

///|
test "sync_diff_update_filters_known_ops" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "hello ")
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(d1.encode_state_as_update()), "init")
  let sv2 = d2.encode_state_vector()
  d1.get_text("t").push(d1, "world")
  let full = d1.encode_state_as_update()
  let diff = must_ok_bytes(diff_update(full, sv2), "diff_update")
  debug_assert(diff.length() < full.length(), "diff smaller")
  must_ok_unit(d2.apply_update(diff), "apply diff")
  debug_assert(d2.get_text("t").to_string(d2) == "hello world", "applied diff")
}

///|
test "sync_deleteset_rle_adjacent_merge" {
  let ds = DeleteSet::new()
  ds.add(1UL, 0UL, 3UL)
  ds.add(1UL, 3UL, 4UL)
  ds.add(1UL, 7UL, 2UL)
  ds.sort_and_merge()
  match ds.clients.get(1L) {
    Some(ranges) => {
      debug_assert(ranges.length() == 1, "merged to 1 range")
      debug_assert(ranges[0].clock == 0UL && ranges[0].len == 9UL, "[0, 9)")
    }
    None => debug_assert(false, "missing client 1")
  }
}

///|
test "sync_deleteset_rle_overlapping_merge" {
  let ds = DeleteSet::new()
  ds.add(1UL, 5UL, 5UL)
  ds.add(1UL, 0UL, 7UL)
  ds.add(1UL, 12UL, 3UL)
  ds.sort_and_merge()
  match ds.clients.get(1L) {
    Some(ranges) => {
      debug_assert(ranges.length() == 2, "2 disjoint ranges")
      debug_assert(ranges[0].clock == 0UL && ranges[0].len == 10UL, "[0, 10)")
      debug_assert(ranges[1].clock == 12UL && ranges[1].len == 3UL, "[12, 15)")
    }
    None => debug_assert(false, "missing client 1")
  }
}

///|
test "sync_deleteset_is_deleted_lookup" {
  let ds = DeleteSet::new()
  ds.add(7UL, 10UL, 5UL)
  ds.add(7UL, 20UL, 3UL)
  ds.sort_and_merge()
  debug_assert(!ds.is_deleted(7UL, 9UL), "9 not deleted")
  debug_assert(ds.is_deleted(7UL, 10UL), "10 deleted")
  debug_assert(ds.is_deleted(7UL, 14UL), "14 deleted")
  debug_assert(!ds.is_deleted(7UL, 15UL), "15 not deleted")
  debug_assert(ds.is_deleted(7UL, 22UL), "22 deleted")
  debug_assert(!ds.is_deleted(8UL, 10UL), "other client not deleted")
}

///|
test "sync_partial_item_split_on_incremental_sv" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "abcdefghij")
  let sv = StateVector::new()
  sv.set(1UL, 4UL)
  let enc = Encoder::new()
  enc.write_var_uint(1UL)
  enc.write_var_uint(1UL)
  enc.write_var_uint(4UL)
  let delta = must_ok_bytes(d1.encode_state_as_update_from(enc.to_bytes()), "partial split delta")
  let d2 = Doc::new(2UL)
  // First give d2 only "abcd" (clocks 0..4)
  let d1_part = Doc::new(1UL)
  d1_part.get_text("t").insert(d1_part, 0, "abcd")
  must_ok_unit(d2.apply_update(d1_part.encode_state_as_update()), "first 4")
  must_ok_unit(d2.apply_update(delta), "rest 6")
  debug_assert(d2.get_text("t").to_string(d2) == "abcdefghij", "full text")
}

///|
test "sync_multiple_root_types_in_one_doc" {
  let d1 = Doc::new(1UL)
  d1.get_text("t").insert(d1, 0, "text")
  d1.get_array("a").push(d1, Any::Int(1L))
  d1.get_map("m").set(d1, "k", Any::Bool(true))
  let d2 = Doc::new(2UL)
  must_ok_unit(d2.apply_update(d1.encode_state_as_update()), "sync all")
  debug_assert(d2.get_text("t").to_string(d2) == "text", "text")
  debug_assert(d2.get_array("a").len(d2) == 1, "array")
  debug_assert(d2.get_map("m").contains_key(d2, "k"), "map")
}

///|
test "sync_truncated_update_returns_err" {
  let d = Doc::new(1UL)
  let bad = unwrap_bytes(hex_to_bytes("010101"))
  match d.apply_update(bad) {
    Ok(_) => debug_assert(false, "truncated update should error")
    Err(_) => ()
  }
}

///|
test "sync_truncated_sv_returns_err" {
  let bad = unwrap_bytes(hex_to_bytes("0201"))
  match decode_state_vector(bad) {
    Ok(_) => debug_assert(false, "truncated sv should error")
    Err(_) => ()
  }
}

///|
test "sync_bidirectional_multi_round_incremental" {
  let d1 = Doc::new(1UL)
  let d2 = Doc::new(2UL)
  let mut round = 0
  while round < 10 {
    d1.get_text("t").push(d1, "a")
    d2.get_text("t").push(d2, "b")
    let u1 = must_ok_bytes(d1.encode_state_as_update_from(d2.encode_state_vector()), "u1")
    let u2 = must_ok_bytes(d2.encode_state_as_update_from(d1.encode_state_vector()), "u2")
    must_ok_unit(d2.apply_update(u1), "d2<-u1")
    must_ok_unit(d1.apply_update(u2), "d1<-u2")
    round = round + 1
  }
  let s1 = d1.get_text("t").to_string(d1)
  let s2 = d2.get_text("t").to_string(d2)
  debug_assert(s1 == s2, "converged across 10 rounds")
  debug_assert(s1.length() == 20, "20 chars")
}
