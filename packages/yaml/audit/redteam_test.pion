///| Red-team prosecution tests for `packages/yaml` @ 00b956c (feat/opt-yaml).
///|
///| Every test asserts what YAML 1.2.2 requires and/or what the reference
///| implementations (Rust `yaml-rust2 0.10.4`, Go `gopkg.in/yaml.v3 v3.0.1`) actually do
///| on the very same input (see `harness/` + `run_audit.sh` for the live differential).
///| A FAILING test here is evidence against Pion, not a broken test.
///|
///| Naming: `p0_*` silent data corruption / false rejection of valid real-world input,
///|         `p1_*` spec violations or emitter bugs that lose or change data,
///|         `p2_*` divergences / capability gaps.

import "yaml"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///| Build a `String` from raw bytes (lets us feed invalid UTF-8 / BOM bytes).
fn bytes_str(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn err_text(e : yaml::YamlError) -> String {
  e.line.to_string() + ":" + e.col.to_string() + " " + e.message
}

///| Parse a single document or fail the test with the parser error.
fn must_parse(src : String, ctx : String) -> yaml::YamlValue {
  match yaml::parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, ctx + ": unexpected parse error " + err_text(e))
      yaml::YamlValue::Null
    }
  }
}

///| Look up the FIRST entry whose key is `Str(k)` (how a naive consumer reads a Map).
fn first_lookup(v : yaml::YamlValue, k : String) -> Option[yaml::YamlValue] {
  match v {
    yaml::YamlValue::Map(es) => {
      let mut i = 0
      while i < es.length() {
        let (kk, vv) = es[i]
        match kk {
          yaml::YamlValue::Str(s) => if s == k { return Some(vv) }
          _ => ()
        }
        i = i + 1
      }
      None
    }
    _ => None
  }
}

///|
fn describe(v : yaml::YamlValue) -> String {
  match v {
    yaml::YamlValue::Null => "Null"
    yaml::YamlValue::Bool(b) => "Bool(" + b.to_string() + ")"
    yaml::YamlValue::Int(n) => "Int(" + n.to_string() + ")"
    yaml::YamlValue::Float(f) => "Float(" + f.to_string() + ")"
    yaml::YamlValue::Str(s) => "Str(" + yaml::to_canonical_json(v) + ")"
    yaml::YamlValue::Seq(_) => "Seq" + yaml::to_canonical_json(v)
    yaml::YamlValue::Map(_) => "Map" + yaml::to_canonical_json(v)
  }
}

///| `stringify` then `parse` must give back a value of the same type and content.
fn assert_roundtrip(v : yaml::YamlValue, ctx : String) -> Unit {
  let emitted = yaml::stringify(v)
  match yaml::parse_all(emitted) {
    Ok(docs) => {
      if docs.length() != 1 {
        debug_assert(false, ctx + ": stringify output re-parses as " + docs.length().to_string() + " documents; emitted=" + emitted)
        return
      }
      let a = describe(v)
      let b = describe(docs[0])
      debug_assert(a == b, ctx + ": round trip changed value: before=" + a + " after=" + b + " emitted=" + emitted)
    }
    Err(e) => debug_assert(false, ctx + ": stringify output is not valid YAML for Pion itself: " + err_text(e) + " emitted=" + emitted)
  }
}

///|
fn get_float(v : yaml::YamlValue, k : String) -> Double {
  match first_lookup(v, k) {
    Some(yaml::YamlValue::Float(f)) => f
    _ => {
      debug_assert(false, "expected Float at key " + k + " in " + describe(v))
      0.0
    }
  }
}

// ---------------------------------------------------------------------------
// P0 — silent numeric corruption in BOTH output paths (canonical JSON + stringify)
// ---------------------------------------------------------------------------

///| yaml-rust2 / yaml.v3 both print `{"a":0.30000000000000004}`; Pion prints 15 significant
///| digits (`0.3`), so `to_canonical_json` is lossy and its SHA "verification" only holds for
///| short decimals like the 0.995 / 0.25 found in the benchmark corpus.
test "p0_canonical_json_truncates_doubles_to_15_digits" {
  let v = must_parse("a: 0.30000000000000004\nb: 3.141592653589793\n", "p0 float json")
  let j = yaml::to_canonical_json(v)
  debug_assert(j == "{\"a\":0.30000000000000004,\"b\":3.141592653589793}", "to_canonical_json lost precision: " + j)
}

///| DBL_MAX survives in Rust/Go; Pion's emitter writes `1.79769313486232e+308`, which re-parses as +inf.
test "p0_stringify_turns_dbl_max_into_infinity" {
  let v = must_parse("x: 1.7976931348623157e308\n", "p0 dbl max")
  let again = must_parse(yaml::stringify(v), "p0 dbl max reparse")
  let f = get_float(again, "x")
  debug_assert(f == 1.7976931348623157e308, "stringify round trip changed DBL_MAX into " + f.to_string() + " (emitted " + yaml::stringify(v) + ")")
}

///| Any double needing 16-17 digits is silently altered by `stringify` -> `parse`.
test "p0_stringify_loses_double_precision" {
  let v = must_parse("pi: 3.141592653589793\nx: 0.30000000000000004\nbig: 9007199254740993.0\n", "p0 precision")
  let again = must_parse(yaml::stringify(v), "p0 precision reparse")
  debug_assert(get_float(again, "pi") == get_float(v, "pi"), "pi changed: " + yaml::stringify(v))
  debug_assert(get_float(again, "x") == get_float(v, "x"), "0.30000000000000004 changed: " + yaml::stringify(v))
}

// ---------------------------------------------------------------------------
// P0 — duplicate keys: accepted silently, and two different readers disagree
// ---------------------------------------------------------------------------

///| YAML 1.2.2 §3.2.1.1: mapping keys are unique. yaml-rust2: `duplicated key in mapping`;
///| yaml.v3: `mapping key "admin" already defined`. Pion: Ok.
test "p0_duplicate_mapping_key_is_accepted" {
  match yaml::parse("admin: false\nadmin: true\n") {
    Ok(v) => debug_assert(false, "duplicate key accepted; got " + describe(v))
    Err(_) => ()
  }
}

///| Worse: the returned `Map` keeps BOTH entries. A consumer that does a first-match
///| lookup sees `admin: false`, while `to_canonical_json` (and anything that re-serializes)
///| sees `admin: true` -> classic parser-differential / config-smuggling primitive.
test "p0_duplicate_key_two_readers_disagree" {
  match yaml::parse("admin: false\nadmin: true\n") {
    Ok(v) => {
      let first = match first_lookup(v, "admin") {
        Some(x) => describe(x)
        None => "<none>"
      }
      let json = yaml::to_canonical_json(v)
      debug_assert(first == "Bool(true)" || json == "{\"admin\":false}", "first-match lookup says " + first + " but to_canonical_json says " + json)
    }
    Err(_) => ()
  }
}

///| Duplicate `<<` merge keys: both yaml-rust2 and yaml.v3 reject; Pion silently merges.
test "p2_duplicate_merge_key_is_accepted" {
  match yaml::parse("a: &a {x: 1}\nd:\n  <<: *a\n  <<: {x: 2, z: 3}\n") {
    Ok(v) => debug_assert(false, "duplicate '<<' accepted; got " + describe(v))
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P0 — alias "Billion Laughs" budget rejects valid real-world input
// ---------------------------------------------------------------------------

///| The 100k expanded-node budget is a Loader field never reset between documents.
///| 1500 independent documents (480 KB), each merging its own 20-key defaults twice,
///| are rejected at document ~1220. yaml-rust2 and yaml.v3 load all 1500.
test "p0_alias_budget_is_shared_across_documents" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1500 {
    if i > 0 {
      sb.write_string("---\n")
    }
    sb.write_string("defaults: &d\n")
    let mut j = 0
    while j < 20 {
      sb.write_string("  opt" + j.to_string() + ": v" + j.to_string() + "\n")
      j = j + 1
    }
    sb.write_string("svc" + i.to_string() + "a:\n  <<: *d\n  name: a\nsvc" + i.to_string() + "b:\n  <<: *d\n  name: b\n")
    i = i + 1
  }
  match yaml::parse_all(sb.to_string()) {
    Ok(docs) => debug_assert(docs.length() == 1500, "expected 1500 docs, got " + docs.length().to_string())
    Err(e) => debug_assert(false, "valid 1500-document stream rejected: " + err_text(e))
  }
}

///| Aliases to a *scalar* cannot amplify anything, yet each costs 1 budget node:
///| a CI file with 120,000 `image: *img` references (4.2 MB) is rejected. Rust/Go load it.
test "p0_scalar_aliases_count_against_billion_laughs_budget" {
  let sb = StringBuilder::new()
  sb.write_string("common: &img registry.example.com/app:1.2.3\njobs:\n")
  let mut i = 0
  while i < 120000 {
    sb.write_string("  - name: job" + i.to_string() + "\n    image: *img\n")
    i = i + 1
  }
  match yaml::parse(sb.to_string()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "120k scalar aliases rejected: " + err_text(e))
  }
}

// ---------------------------------------------------------------------------
// P1 — recursive aliases silently become null
// ---------------------------------------------------------------------------

///| `*a` inside the node anchored `&a` is a recursive alias. yaml.v3: `anchor 'a' value
///| contains itself`. Pion returns `[1, null]` without any error (anchor slot pre-filled with
///| Null because a later anchor `&b` grew the anchor table).
test "p1_recursive_alias_in_seq_silently_null" {
  match yaml::parse("&a [&b 1, *a]\n") {
    Ok(v) => debug_assert(false, "recursive alias accepted silently as " + describe(v))
    Err(_) => ()
  }
}

///|
test "p1_recursive_alias_in_map_silently_null" {
  match yaml::parse("&a {x: &b 1, y: *a}\n") {
    Ok(v) => debug_assert(false, "recursive alias accepted silently as " + describe(v))
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P1 — invalid UTF-8 accepted and propagated into "canonical JSON"
// ---------------------------------------------------------------------------

///| YAML streams must be valid Unicode (§5.2). yaml.v3: `invalid leading UTF-8 octet`;
///| yaml-rust2 only accepts `&str`. Pion: Ok, and `to_canonical_json` emits invalid UTF-8 JSON.
test "p1_invalid_utf8_is_accepted" {
  match yaml::parse(bytes_str([97, 58, 32, 255, 254, 10])) {
    Ok(v) => debug_assert(false, "invalid UTF-8 (FF FE) accepted as " + describe(v))
    Err(_) => ()
  }
}

///| Overlong encoding C0 81 (classic filter-bypass vector for '/'-style checks).
test "p1_overlong_utf8_is_accepted" {
  match yaml::parse(bytes_str([97, 58, 32, 192, 129, 10])) {
    Ok(v) => debug_assert(false, "overlong UTF-8 (C0 81) accepted as " + describe(v))
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P1 — stringify is not round-trip safe (README claims "round-trip-safe")
// ---------------------------------------------------------------------------

///| `Float(2.0)` is emitted as `2` and comes back as `Int(2)` (yaml-rust2 keeps `2.0`,
///| yaml.v3 round-trips float64). Hits spec example 2.27 (UGM3) `price: 450.00`.
test "p1_stringify_float_comes_back_as_int" {
  assert_roundtrip(yaml::YamlValue::Float(2.0), "Float(2.0)")
  assert_roundtrip(must_parse("price: 450.00\n", "UGM3 price"), "UGM3 price 450.00")
}

///| Top-level string "..." is emitted bare -> a document-end marker -> zero documents.
test "p1_stringify_doc_end_marker_string_vanishes" {
  assert_roundtrip(yaml::YamlValue::Str("..."), "Str(\"...\")")
}

///| A *quoted* `"<<"` key is a plain string key; stringify emits it bare, which then
///| triggers merge-key semantics and rewrites the mapping.
test "p1_stringify_quoted_merge_key_becomes_merge" {
  let v = must_parse("\"<<\": {a: 1}\nb: 2\n", "quoted <<")
  assert_roundtrip(v, "quoted << key")
}

///| A string starting with U+FEFF is emitted unquoted; Pion then rejects its own output
///| (`a byte order mark must not appear inside a document`).
test "p1_stringify_leading_bom_string_unparseable" {
  let s = bytes_str([239, 187, 191, 98, 111, 109])
  let m : Array[(yaml::YamlValue, yaml::YamlValue)] = [(yaml::YamlValue::Str("k"), yaml::YamlValue::Str(s))]
  assert_roundtrip(yaml::YamlValue::Map(m), "BOM-prefixed string value")
}

///| Keys longer than 1024 chars must use the explicit `? ` form (YAML 1.2 implicit-key limit).
///| yaml.v3 does; Pion emits an implicit key that Pion itself rejects.
test "p1_stringify_long_key_unparseable" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1100 {
    sb.write_string("k")
    i = i + 1
  }
  let m : Array[(yaml::YamlValue, yaml::YamlValue)] = [(yaml::YamlValue::Str(sb.to_string()), yaml::YamlValue::Str("v"))]
  assert_roundtrip(yaml::YamlValue::Map(m), "1100-char key")
}

///| Indentation grows with depth, and alias chains raise depth past the 256 limit for free:
///| a 6 KB input with 12 alias layers stringifies to 40.7 MB (O(depth^2)). The 28-layer variant
///| in run_audit.sh: 14 KB -> 482 MB / 0.97 GiB RSS in Pion vs 0.15 s in yaml.v3 Marshal.
test "p1_stringify_output_quadratic_in_alias_depth" {
  let sb = StringBuilder::new()
  sb.write_string("l0: &l0 x\n")
  let mut k = 1
  while k <= 12 {
    sb.write_string("l" + k.to_string() + ": &l" + k.to_string() + " ")
    let mut d = 0
    while d < 250 {
      sb.write_string("[")
      d = d + 1
    }
    sb.write_string("*l" + (k - 1).to_string())
    d = 0
    while d < 250 {
      sb.write_string("]")
      d = d + 1
    }
    sb.write_string("\n")
    k = k + 1
  }
  let src = sb.to_string()
  let v = must_parse(src, "alias depth chain")
  let out = yaml::stringify(v)
  debug_assert(out.length() < 64 * src.length(), "stringify amplification: input " + src.length().to_string() + " B -> output " + out.length().to_string() + " B")
}

// ---------------------------------------------------------------------------
// P1 — Core Schema integers silently change type
// ---------------------------------------------------------------------------

///| `9223372036854775808` matches the Core Schema int regex. yaml.v3 -> uint64,
///| yaml-rust2 -> number; Pion -> `Str("9223372036854775808")` (silent type change).
test "p1_out_of_range_int_becomes_string" {
  let v = must_parse("a: 9223372036854775808\n", "bigint")
  match first_lookup(v, "a") {
    Some(yaml::YamlValue::Str(s)) => debug_assert(false, "Core-Schema integer silently became a string: " + s)
    _ => ()
  }
}

///| `0xFFFFFFFFFFFFFFFF` (common for masks / u64 ids): yaml.v3 -> uint64; Pion -> string.
test "p2_u64_hex_becomes_string" {
  let v = must_parse("mask: 0xFFFFFFFFFFFFFFFF\n", "hex u64")
  match first_lookup(v, "mask") {
    Some(yaml::YamlValue::Str(s)) => debug_assert(false, "hex integer silently became a string: " + s)
    _ => ()
  }
}

// ---------------------------------------------------------------------------
// P2 — divergences / gaps against yaml-rust2 and yaml.v3
// ---------------------------------------------------------------------------

///| Raw C0 control characters are not `c-printable` (§5.1). yaml.v3: `control characters are not allowed`.
test "p2_c0_control_characters_accepted" {
  match yaml::parse(bytes_str([97, 58, 32, 120, 1, 121, 10])) {
    Ok(v) => debug_assert(false, "raw U+0001 accepted as " + describe(v))
    Err(_) => ()
  }
}

///| A local/custom tag is not a Core Schema tag; yaml-rust2 and yaml.v3 both give `"12"`.
///| Pion re-resolves the plain scalar and returns `Int(12)`, dropping the tag.
test "p2_custom_tag_resolved_as_core_int" {
  let v = must_parse("a: !foo 12\n", "custom tag")
  let j = yaml::to_canonical_json(v)
  debug_assert(j == "{\"a\":\"12\"}", "custom-tagged scalar resolved as " + j)
}

///| `%TAG !! tag:example.com,2000:app/` re-binds `!!`, so `!!int` is NOT the Core int tag any more
///| (cf. spec example 6.19). yaml-rust2 and yaml.v3 both give `"13"`; Pion gives `13`.
test "p2_redefined_secondary_handle_still_resolves_core_int" {
  match yaml::parse_all("%TAG !! tag:example.com,2000:app/\n---\n!!int 13\n") {
    Ok(docs) => {
      let j = if docs.length() == 1 { yaml::to_canonical_json(docs[0]) } else { "<docs>" }
      debug_assert(j == "\"13\"", "!!int under a re-bound !! handle resolved as " + j)
    }
    Err(e) => debug_assert(false, "valid stream rejected: " + err_text(e))
  }
}

///| `<<: 5` — yaml.v3: `map merge requires map or sequence of maps as the value`. Pion: Ok.
test "p2_merge_with_scalar_value_accepted" {
  match yaml::parse("d:\n  <<: 5\n") {
    Ok(v) => debug_assert(false, "invalid merge accepted as " + describe(v))
    Err(_) => ()
  }
}

///| 300 nested block mappings: yaml.v3 (limit 10000) and yaml-rust2 load it; Pion's hard
///| depth limit 256 rejects it.
test "p2_nesting_limit_256_rejects_valid_input" {
  let sb = StringBuilder::new()
  let mut d = 0
  while d < 300 {
    let mut s = 0
    while s < d {
      sb.write_string(" ")
      s = s + 1
    }
    sb.write_string("k" + d.to_string() + ":\n")
    d = d + 1
  }
  let mut s = 0
  while s < 300 {
    sb.write_string(" ")
    s = s + 1
  }
  sb.write_string("leaf\n")
  match yaml::parse(sb.to_string()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "300-level document rejected: " + err_text(e))
  }
}

///| Tab used as indentation on line 2: yaml.v3 reports `line 2`; Pion reports 1:4.
test "p2_tab_indentation_error_points_to_wrong_line" {
  match yaml::parse("a: 1\n\tb: 2\n") {
    Ok(v) => debug_assert(false, "tab indentation accepted as " + describe(v))
    Err(e) => debug_assert(e.line == 2, "error reported at " + err_text(e) + ", offending tab is on line 2")
  }
}
