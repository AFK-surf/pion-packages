///| Red-team differential driver for Pion `packages/yaml`.
///| Modes:
///|   json <file>  : one canonical-JSON line per document, or `ERR <line>:<col> <msg>` (exit 2)
///|   emit <file>  : `stringify` every document, separated by `---\n`
///|   typed <file> : type-tagged dump (Int vs Float, ordered keys incl. duplicates)
///|   rtjson <file>: stringify -> parse -> canonical JSON per doc (emit benchmark)
///|   rt <file>    : parse -> stringify -> parse; prints `RT_OK`, or `RT_DIFF`/`RT_ERR` with details (exit 3)

import "yaml"

///|
fn docs_json(docs : Array[yaml::YamlValue]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < docs.length() {
    yaml::write_canonical_json_to(sb, docs[i])
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Type-tagged JSON dump (distinguishes Int vs Float, keeps key order and duplicates):
///| null | true | false | {"i":"<int>"} | {"f":"<double>"} | "<str>" | ["seq", ...] | ["map", [k, v], ...]
fn typed(sb : StringBuilder, v : yaml::YamlValue) -> Unit {
  match v {
    yaml::YamlValue::Null => sb.write_string("null")
    yaml::YamlValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    yaml::YamlValue::Int(n) => sb.write_string("{\"i\":\"" + n.to_string() + "\"}")
    yaml::YamlValue::Float(f) => sb.write_string("{\"f\":\"" + f.to_string() + "\"}")
    yaml::YamlValue::Str(s) => yaml::write_canonical_json_to(sb, yaml::YamlValue::Str(s))
    yaml::YamlValue::Seq(items) => {
      sb.write_string("[\"seq\"")
      let mut i = 0
      while i < items.length() {
        sb.write_string(",")
        typed(sb, items[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    yaml::YamlValue::Map(es) => {
      sb.write_string("[\"map\"")
      let mut i = 0
      while i < es.length() {
        let (k, x) = es[i]
        sb.write_string(",[")
        typed(sb, k)
        sb.write_string(",")
        typed(sb, x)
        sb.write_string("]")
        i = i + 1
      }
      sb.write_string("]")
    }
  }
}

///|
fn typed_str(v : yaml::YamlValue) -> String {
  let sb = StringBuilder::new()
  typed(sb, v)
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_driver json|emit|rt <file>")
    return 1
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR 0:0 cannot read input")
      return 1
    }
  }
  let docs = match yaml::parse_all(src) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "ERR " + e.line.to_string() + ":" + e.col.to_string() + " " + e.message)
      return 2
    }
  }
  if mode == "json" {
    io_print(world, docs_json(docs))
    return 0
  }
  if mode == "typed" {
    let mut i = 0
    while i < docs.length() {
      io_println(world, typed_str(docs[i]))
      i = i + 1
    }
    return 0
  }
  if mode == "rtjson" {
    // Emit benchmark with verifiable output: stringify every doc, re-parse, print canonical JSON.
    let sb = StringBuilder::new()
    let mut i = 0
    while i < docs.length() {
      match yaml::parse(yaml::stringify(docs[i])) {
        Ok(v) => yaml::write_canonical_json_to(sb, v)
        Err(e) => sb.write_string("RT_ERR " + e.message)
      }
      sb.write_byte(10.to_byte())
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "emit" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < docs.length() {
      if i > 0 {
        sb.write_string("---\n")
      }
      sb.write_string(yaml::stringify(docs[i]))
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  // rt
  let mut i = 0
  let mut bad = 0
  while i < docs.length() {
    let a = typed_str(docs[i])
    let emitted = yaml::stringify(docs[i])
    match yaml::parse_all(emitted) {
      Ok(again) => {
        let b = if again.length() == 1 { typed_str(again[0]) } else { "<" + again.length().to_string() + " docs>" }
        if b != a {
          io_println(world, "RT_DIFF doc=" + i.to_string())
          io_println(world, "  orig : " + a)
          io_println(world, "  again: " + b)
          io_print(world, "  emitted:\n" + emitted)
          bad = bad + 1
        }
      }
      Err(e) => {
        io_println(world, "RT_ERR doc=" + i.to_string() + " " + e.line.to_string() + ":" + e.col.to_string() + " " + e.message)
        io_print(world, "  emitted:\n" + emitted)
        bad = bad + 1
      }
    }
    i = i + 1
  }
  if bad == 0 {
    io_println(world, "RT_OK")
    return 0
  }
  3
}
