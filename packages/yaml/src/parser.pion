///| YAML 1.2 Event-Driven State Machine Parser.
///| Consumes `val struct Token`s from `Scanner`, enforces full YAML 1.2 structural grammar,
///| resolves `%TAG` handles and anchor IDs, and emits `val struct Event`s for `Loader`
///| with zero intermediate heap allocations on the hot path.

///|
struct YamlTag {
  handle : String
  suffix : String
}

///|
fn YamlTag::new(handle : String, suffix : String) -> YamlTag {
  YamlTag::{ handle: handle, suffix: suffix }
}

///|
fn YamlTag::is_core_schema(self : YamlTag) -> Bool {
  self.handle == "tag:yaml.org,2002:"
}

///| Event kind constants.
fn ev_err() -> Int {
  -1
}

///|
fn ev_stream_start() -> Int {
  0
}

///|
fn ev_stream_end() -> Int {
  1
}

///|
fn ev_doc_start() -> Int {
  2
}

///|
fn ev_doc_end() -> Int {
  3
}

///|
fn ev_alias() -> Int {
  4
}

///|
fn ev_scalar_slice() -> Int {
  5
}

///|
fn ev_scalar_owned() -> Int {
  6
}

///|
fn ev_seq_start() -> Int {
  7
}

///|
fn ev_seq_end() -> Int {
  8
}

///|
fn ev_map_start() -> Int {
  9
}

///|
fn ev_map_end() -> Int {
  10
}

///| Reusable mutable event written in-place by `Parser` (zero per-event heap allocation).
struct Event {
  mut kind : Int
  mut style : Int
  mut val_start : Int
  mut val_end : Int
  mut anchor_id : Int
  mut tag_id : Int
  mut line : Int
  mut col : Int
}

///|
fn Event::simple(kind : Int, line : Int, col : Int) -> Event {
  Event::{ kind: kind, style: 0, val_start: 0, val_end: 0, anchor_id: 0, tag_id: -1, line: line, col: col }
}

///| Parser state constants (flat Ints for zero-alloc state stack).
fn ps_stream_start() -> Int {
  0
}

///|
fn ps_implicit_doc_start() -> Int {
  1
}

///|
fn ps_doc_start() -> Int {
  2
}

///|
fn ps_doc_content() -> Int {
  3
}

///|
fn ps_doc_end() -> Int {
  4
}

///|
fn ps_block_node() -> Int {
  5
}

///|
fn ps_block_seq_first() -> Int {
  6
}

///|
fn ps_block_seq_entry() -> Int {
  7
}

///|
fn ps_indentless_seq_entry() -> Int {
  8
}

///|
fn ps_block_map_first() -> Int {
  9
}

///|
fn ps_block_map_key() -> Int {
  10
}

///|
fn ps_block_map_val() -> Int {
  11
}

///|
fn ps_flow_seq_first() -> Int {
  12
}

///|
fn ps_flow_seq_entry() -> Int {
  13
}

///|
fn ps_flow_seq_map_key() -> Int {
  14
}

///|
fn ps_flow_seq_map_val() -> Int {
  15
}

///|
fn ps_flow_seq_map_end() -> Int {
  16
}

///|
fn ps_flow_map_first() -> Int {
  17
}

///|
fn ps_flow_map_key() -> Int {
  18
}

///|
fn ps_flow_map_val() -> Int {
  19
}

///|
fn ps_flow_map_empty_val() -> Int {
  20
}

///|
fn ps_end() -> Int {
  21
}

///|
struct Parser {
  scanner : Scanner
  states : Array[Int]
  mut states_len : Int
  mut state : Int
  mut has_token : Bool
  mut token : Token
  ev : Event
  anchors : Map[String, Int]
  mut has_anchors : Bool
  mut anchor_id_count : Int
  tags : Map[String, String]
  mut has_tags : Bool
  resolved_tags : Array[YamlTag]
  mut flow_map_end_line : Int
  mut flow_map_end_col : Int
  mut has_error : Bool
  mut error : YamlError
}

///|
fn Parser::new(src : String) -> Parser {
  Parser::{
    scanner: Scanner::new(src),
    states: Array::with_capacity(16),
    states_len: 0,
    state: ps_stream_start(),
    has_token: false,
    token: Token::empty(tk_stream_start(), 1, 0),
    ev: Event::simple(ev_stream_start(), 1, 0),
    anchors: Map::new(),
    has_anchors: false,
    anchor_id_count: 1,
    tags: Map::new(),
    has_tags: false,
    resolved_tags: [],
    flow_map_end_line: 1,
    flow_map_end_col: 0,
    has_error: false,
    error: YamlError::new(1, 1, ""),
  }
}

///|
fn Parser::set_ev(
  self : Parser,
  kind : Int,
  style : Int,
  val_start : Int,
  val_end : Int,
  anchor_id : Int,
  tag_id : Int,
  line : Int,
  col : Int,
) -> Event {
  let e = self.ev
  e.kind = kind
  e.style = style
  e.val_start = val_start
  e.val_end = val_end
  e.anchor_id = anchor_id
  e.tag_id = tag_id
  e.line = line
  e.col = col
  e
}

///|
fn Parser::set_ev_simple(self : Parser, kind : Int, line : Int, col : Int) -> Event {
  self.set_ev(kind, 0, 0, 0, 0, -1, line, col)
}

///|
fn Parser::set_ev_empty(self : Parser, anchor_id : Int, tag_id : Int, line : Int, col : Int) -> Event {
  self.set_ev(ev_scalar_slice(), style_plain(), 0, 0, anchor_id, tag_id, line, col)
}

///|
fn Parser::fail(self : Parser, line : Int, col : Int, msg : String) -> Event {
  self.has_error = true
  self.error = err_lc(line, col, msg)
  self.set_ev_simple(ev_err(), line, col)
}

///|
fn Parser::fail_from_scanner(self : Parser) -> Event {
  self.has_error = true
  self.error = self.scanner.error
  self.set_ev_simple(ev_err(), self.scanner.line, self.scanner.col)
}

///|
fn Parser::peek_token(self : Parser) -> Token {
  if !self.has_token {
    self.scanner.next_token_into(self.token)
    let k = self.token.kind
    if k == tk_err() {
      let _ = self.fail_from_scanner()
      return self.token
    }
    if k == tk_eof() {
      let _ = self.fail(self.scanner.line, self.scanner.col, "unexpected end of stream")
      self.token.kind = tk_err()
      self.token.line = self.scanner.line
      self.token.col = self.scanner.col
      return self.token
    }
    self.has_token = true
  }
  self.token
}

///|
fn Parser::skip_token(self : Parser) -> Unit {
  self.has_token = false
}

///|
fn Parser::push_state(self : Parser, st : Int) -> Unit {
  let n = self.states_len
  if n < self.states.length() {
    self.states[n] = st
  } else {
    self.states.push(st)
  }
  self.states_len = n + 1
}

///|
fn Parser::pop_state(self : Parser) -> Unit {
  let n = self.states_len
  if n > 0 {
    self.states_len = n - 1
    self.state = self.states[n - 1]
  } else {
    self.state = ps_end()
  }
}

///|
fn Parser::register_anchor(self : Parser, name : String) -> Int {
  let id = self.anchor_id_count
  self.anchor_id_count = self.anchor_id_count + 1
  self.anchors.set(name, id)
  self.has_anchors = true
  id
}

///|
fn Parser::next_event(self : Parser) -> Event {
  let st = self.state
  if st == ps_block_map_key() {
    return self.parse_block_mapping_key(false)
  }
  if st == ps_block_map_val() {
    return self.parse_block_mapping_value()
  }
  if st == ps_block_map_first() {
    return self.parse_block_mapping_key(true)
  }
  if st == ps_block_seq_entry() {
    return self.parse_block_sequence_entry(false)
  }
  if st == ps_block_seq_first() {
    return self.parse_block_sequence_entry(true)
  }
  if st == ps_block_node() {
    return self.parse_node(true, false)
  }
  if st == ps_flow_seq_entry() {
    return self.parse_flow_sequence_entry(false)
  }
  if st == ps_flow_seq_first() {
    return self.parse_flow_sequence_entry(true)
  }
  if st == ps_indentless_seq_entry() {
    return self.parse_indentless_sequence_entry()
  }
  if st == ps_doc_start() {
    return self.parse_document_start(false)
  }
  if st == ps_doc_content() {
    return self.parse_document_content()
  }
  if st == ps_doc_end() {
    return self.parse_document_end()
  }
  if st == ps_stream_start() {
    return self.parse_stream_start()
  }
  if st == ps_implicit_doc_start() {
    return self.parse_document_start(true)
  }
  if st == ps_flow_map_first() {
    return self.parse_flow_mapping_key(true)
  }
  if st == ps_flow_map_key() {
    return self.parse_flow_mapping_key(false)
  }
  if st == ps_flow_map_val() {
    return self.parse_flow_mapping_value(false)
  }
  if st == ps_flow_map_empty_val() {
    return self.parse_flow_mapping_value(true)
  }
  if st == ps_flow_seq_map_key() {
    return self.parse_flow_seq_entry_map_key()
  }
  if st == ps_flow_seq_map_val() {
    return self.parse_flow_seq_entry_map_value()
  }
  if st == ps_flow_seq_map_end() {
    self.state = ps_flow_seq_entry()
    return self.set_ev_simple(ev_map_end(), self.flow_map_end_line, self.flow_map_end_col)
  }
  self.set_ev_simple(ev_stream_end(), self.scanner.line, self.scanner.col)
}

///|
fn Parser::parse_stream_start(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_stream_start() {
    self.state = ps_implicit_doc_start()
    self.skip_token()
    self.set_ev_simple(ev_stream_start(), tok.line, tok.col)
  } else {
    self.fail(tok.line, tok.col, "did not find expected <stream-start>")
  }
}

///|
fn Parser::parse_document_start(self : Parser, implicit : Bool) -> Event {
  while true {
    let tok = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), tok.line, tok.col)
    }
    if tok.kind == tk_document_end() || tok.kind == tk_bom() {
      self.skip_token()
    } else {
      break
    }
  }

  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_stream_end() {
    self.state = ps_end()
    self.skip_token()
    self.set_ev_simple(ev_stream_end(), tok.line, tok.col)
  } else if k == tk_version_directive() || k == tk_tag_directive() || k == tk_reserved_directive() || k == tk_document_start() {
    self.parse_explicit_document_start()
  } else if implicit {
    if !self.process_directives() {
      return self.set_ev_simple(ev_err(), tok.line, tok.col)
    }
    self.push_state(ps_doc_end())
    self.state = ps_block_node()
    self.set_ev_simple(ev_doc_start(), tok.line, tok.col)
  } else {
    self.parse_explicit_document_start()
  }
}

///|
fn Parser::process_directives(self : Parser) -> Bool {
  let first = self.peek_token()
  if self.has_error {
    return false
  }
  let fk = first.kind
  if fk != tk_version_directive() && fk != tk_tag_directive() && fk != tk_reserved_directive() {
    return true
  }
  let mut version_seen = false
  let doc_tags : Map[String, String] = Map::new()
  while true {
    let tok = self.peek_token()
    if self.has_error {
      return false
    }
    let k = tok.kind
    if k == tk_version_directive() {
      if version_seen {
        let _ = self.fail(tok.line, tok.col, "duplicate %YAML version directive")
        return false
      }
      version_seen = true
      self.skip_token()
    } else if k == tk_tag_directive() {
      let handle = self.scanner.str_pool[tok.val_start]
      let prefix = self.scanner.str_pool[tok.val_end]
      if doc_tags.contains(handle) {
        let _ = self.fail(tok.line, tok.col, "duplicate %TAG directive for handle")
        return false
      }
      doc_tags.set(handle, prefix)
      self.tags.set(handle, prefix)
      self.has_tags = true
      self.skip_token()
    } else if k == tk_reserved_directive() {
      self.skip_token()
    } else {
      break
    }
  }
  true
}

///|
fn Parser::parse_explicit_document_start(self : Parser) -> Event {
  if !self.process_directives() {
    return self.set_ev_simple(ev_err(), self.scanner.line, self.scanner.col)
  }
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_document_start() {
    self.push_state(ps_doc_end())
    self.state = ps_doc_content()
    self.skip_token()
    self.set_ev(ev_doc_start(), 1, 0, 0, 0, -1, tok.line, tok.col)
  } else if tok.kind == tk_bom() {
    self.fail(tok.line, tok.col, "a byte order mark must not appear inside a document")
  } else {
    self.fail(tok.line, tok.col, "did not find expected <document-start>")
  }
}

///|
fn Parser::parse_document_content(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_version_directive() || k == tk_tag_directive() || k == tk_reserved_directive() ||
  k == tk_document_start() || k == tk_document_end() || k == tk_bom() || k == tk_stream_end() {
    self.pop_state()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  } else {
    self.parse_node(true, false)
  }
}

///|
fn Parser::parse_document_end(self : Parser) -> Event {
  let first = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), first.line, first.col)
  }
  if first.kind == tk_bom() {
    let bom_line = first.line
    let bom_col = first.col
    while true {
      let t = self.peek_token()
      if self.has_error {
        return self.set_ev_simple(ev_err(), t.line, t.col)
      }
      if t.kind == tk_bom() {
        self.skip_token()
      } else {
        break
      }
    }
    let after = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), after.line, after.col)
    }
    let ak = after.kind
    if ak != tk_document_start() && ak != tk_document_end() && ak != tk_stream_end() {
      return self.fail(bom_line, bom_col, "a byte order mark must not appear inside a document")
    }
  }

  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let mut explicit_end = false
  let end_line = tok.line
  let end_col = tok.col
  if tok.kind == tk_document_end() {
    explicit_end = true
    self.skip_token()
  }

  if self.has_tags {
    self.tags.clear()
    self.has_tags = false
  }
  if explicit_end {
    self.state = ps_implicit_doc_start()
  } else {
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_version_directive() || nk == tk_tag_directive() || nk == tk_reserved_directive() {
      return self.fail(nxt.line, nxt.col, "missing explicit document end marker before directive")
    } else if nk != tk_document_start() && nk != tk_stream_end() {
      return self.fail(nxt.line, nxt.col, "did not find expected <document-start>")
    }
    self.state = ps_doc_start()
  }
  self.set_ev_simple(ev_doc_end(), end_line, end_col)
}

///|
fn Parser::resolve_tag(self : Parser, line : Int, col : Int, handle : String, suffix : String) -> Int {
  let tag = if handle == "!!" {
    let resolved_handle = if self.has_tags {
      match self.tags.get("!!") {
        Some(p) => p
        None => "tag:yaml.org,2002:"
      }
    } else {
      "tag:yaml.org,2002:"
    }
    YamlTag::new(resolved_handle, suffix)
  } else if handle.length() == 0 && suffix == "!" {
    if self.has_tags {
      match self.tags.get("") {
        Some(p) => YamlTag::new(p, suffix)
        None => YamlTag::new("", suffix)
      }
    } else {
      YamlTag::new("", suffix)
    }
  } else {
    let found = if self.has_tags { self.tags.get(handle) } else { None }
    match found {
      Some(p) => YamlTag::new(p, suffix)
      None => {
        let hlen = handle.length()
        if hlen >= 2 && handle.code_unit_at(0) == 33 && handle.code_unit_at(hlen - 1) == 33 {
          let _ = self.fail(line, col, "undeclared tag handle")
          return -1
        }
        YamlTag::new(handle, suffix)
      }
    }
  }
  let id = self.resolved_tags.length()
  self.resolved_tags.push(tag)
  id
}

///|
fn Parser::parse_node(self : Parser, block : Bool, indentless_seq : Bool) -> Event {
  let first_tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), first_tok.line, first_tok.col)
  }
  let fk = first_tok.kind
  let start_line = first_tok.line
  let start_col = first_tok.col

  // Fast path: no anchor, no alias, no tag (99.9% of all nodes!)
  if fk == tk_scalar_slice() {
    self.pop_state()
    self.skip_token()
    return self.set_ev(ev_scalar_slice(), first_tok.style, first_tok.val_start, first_tok.val_end, 0, -1, start_line, start_col)
  }
  if fk == tk_scalar_owned() {
    self.pop_state()
    self.skip_token()
    return self.set_ev(ev_scalar_owned(), first_tok.style, first_tok.val_start, first_tok.val_end, 0, -1, start_line, start_col)
  }
  if fk == tk_block_map_start() && block {
    self.state = ps_block_map_first()
    return self.set_ev_simple(ev_map_start(), start_line, start_col)
  }
  if fk == tk_block_seq_start() && block {
    self.state = ps_block_seq_first()
    return self.set_ev_simple(ev_seq_start(), start_line, start_col)
  }
  if fk == tk_flow_seq_start() {
    self.state = ps_flow_seq_first()
    return self.set_ev_simple(ev_seq_start(), start_line, start_col)
  }
  if fk == tk_flow_map_start() {
    self.state = ps_flow_map_first()
    return self.set_ev_simple(ev_map_start(), start_line, start_col)
  }
  if fk == tk_block_entry() && indentless_seq {
    self.state = ps_indentless_seq_entry()
    return self.set_ev_simple(ev_seq_start(), start_line, start_col)
  }

  let mut anchor_id = 0
  let mut tag_id = -1

  if fk == tk_alias() {
    self.pop_state()
    self.skip_token()
    let name = self.scanner.src.slice(first_tok.val_start, first_tok.val_end)
    match self.anchors.get(name) {
      None => return self.fail(start_line, start_col, "while parsing node, found unknown anchor")
      Some(id) => return self.set_ev(ev_alias(), 0, id, 0, 0, -1, start_line, start_col)
    }
  } else if fk == tk_anchor() {
    self.skip_token()
    let name = self.scanner.src.slice(first_tok.val_start, first_tok.val_end)
    anchor_id = self.register_anchor(name)
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    if nxt.kind == tk_tag() {
      self.skip_token()
      let h = self.scanner.str_pool[nxt.val_start]
      let s = self.scanner.str_pool[nxt.val_end]
      tag_id = self.resolve_tag(nxt.line, nxt.col, h, s)
      if self.has_error {
        return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
      }
    }
  } else if fk == tk_tag() {
    self.skip_token()
    let h = self.scanner.str_pool[first_tok.val_start]
    let s = self.scanner.str_pool[first_tok.val_end]
    tag_id = self.resolve_tag(start_line, start_col, h, s)
    if self.has_error {
      return self.set_ev_simple(ev_err(), start_line, start_col)
    }
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    if nxt.kind == tk_anchor() {
      self.skip_token()
      let name = self.scanner.src.slice(nxt.val_start, nxt.val_end)
      anchor_id = self.register_anchor(name)
    }
  }

  let cur = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), cur.line, cur.col)
  }
  let ck = cur.kind
  if ck == tk_block_entry() {
    if indentless_seq {
      self.state = ps_indentless_seq_entry()
      self.set_ev(ev_seq_start(), 0, 0, 0, anchor_id, tag_id, start_line, start_col)
    } else if tag_id >= 0 || anchor_id > 0 {
      self.pop_state()
      self.set_ev_empty(anchor_id, tag_id, start_line, start_col)
    } else {
      self.fail(cur.line, cur.col, "while parsing a node, did not find expected node content")
    }
  } else if ck == tk_scalar_slice() {
    self.pop_state()
    self.skip_token()
    self.set_ev(ev_scalar_slice(), cur.style, cur.val_start, cur.val_end, anchor_id, tag_id, start_line, start_col)
  } else if ck == tk_scalar_owned() {
    self.pop_state()
    self.skip_token()
    self.set_ev(ev_scalar_owned(), cur.style, cur.val_start, cur.val_end, anchor_id, tag_id, start_line, start_col)
  } else if ck == tk_flow_seq_start() {
    self.state = ps_flow_seq_first()
    self.set_ev(ev_seq_start(), 0, 0, 0, anchor_id, tag_id, start_line, start_col)
  } else if ck == tk_flow_map_start() {
    self.state = ps_flow_map_first()
    self.set_ev(ev_map_start(), 0, 0, 0, anchor_id, tag_id, start_line, start_col)
  } else if ck == tk_block_seq_start() {
    if block {
      self.state = ps_block_seq_first()
      self.set_ev(ev_seq_start(), 0, 0, 0, anchor_id, tag_id, start_line, start_col)
    } else if tag_id >= 0 || anchor_id > 0 {
      self.pop_state()
      self.set_ev_empty(anchor_id, tag_id, start_line, start_col)
    } else {
      self.fail(cur.line, cur.col, "while parsing a node, did not find expected node content")
    }
  } else if ck == tk_block_map_start() {
    if block {
      self.state = ps_block_map_first()
      self.set_ev(ev_map_start(), 0, 0, 0, anchor_id, tag_id, start_line, start_col)
    } else if tag_id >= 0 || anchor_id > 0 {
      self.pop_state()
      self.set_ev_empty(anchor_id, tag_id, start_line, start_col)
    } else {
      self.fail(cur.line, cur.col, "while parsing a node, did not find expected node content")
    }
  } else if tag_id >= 0 || anchor_id > 0 {
    self.pop_state()
    self.set_ev_empty(anchor_id, tag_id, start_line, start_col)
  } else {
    self.fail(cur.line, cur.col, "while parsing a node, did not find expected node content")
  }
}

///|
fn Parser::parse_block_mapping_key(self : Parser, first : Bool) -> Event {
  if first {
    let t = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), t.line, t.col)
    }
    self.skip_token()
  }
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_key() {
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_scalar_slice() {
      self.state = ps_block_map_val()
      self.skip_token()
      return self.set_ev(ev_scalar_slice(), nxt.style, nxt.val_start, nxt.val_end, 0, -1, nxt.line, nxt.col)
    }
    if nk == tk_key() || nk == tk_value() || nk == tk_block_end() {
      self.state = ps_block_map_val()
      self.set_ev_empty(0, -1, nxt.line, nxt.col)
    } else {
      self.push_state(ps_block_map_val())
      self.parse_node(true, true)
    }
  } else if k == tk_block_end() {
    self.pop_state()
    self.skip_token()
    self.set_ev_simple(ev_map_end(), tok.line, tok.col)
  } else if k == tk_value() {
    self.state = ps_block_map_val()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  } else {
    self.fail(tok.line, tok.col, "while parsing a block mapping, did not find expected key")
  }
}

///|
fn Parser::parse_block_mapping_value(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_value() {
    let tok_line = tok.line
    let tok_col = tok.col
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_scalar_slice() {
      self.state = ps_block_map_key()
      self.skip_token()
      return self.set_ev(ev_scalar_slice(), nxt.style, nxt.val_start, nxt.val_end, 0, -1, nxt.line, nxt.col)
    }
    if nk == tk_key() || nk == tk_value() || nk == tk_block_end() {
      self.state = ps_block_map_key()
      self.set_ev_empty(0, -1, tok_line, tok_col)
    } else {
      self.push_state(ps_block_map_key())
      self.parse_node(true, true)
    }
  } else {
    self.state = ps_block_map_key()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  }
}

///|
fn Parser::parse_block_sequence_entry(self : Parser, first : Bool) -> Event {
  if first {
    let t = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), t.line, t.col)
    }
    self.skip_token()
  }
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_block_end() {
    self.pop_state()
    self.skip_token()
    self.set_ev_simple(ev_seq_end(), tok.line, tok.col)
  } else if k == tk_block_entry() {
    let tok_line = tok.line
    let tok_col = tok.col
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_block_entry() || nk == tk_block_end() {
      self.state = ps_block_seq_entry()
      self.set_ev_empty(0, -1, tok_line, tok_col)
    } else {
      self.push_state(ps_block_seq_entry())
      self.parse_node(true, false)
    }
  } else {
    self.fail(tok.line, tok.col, "while parsing a block sequence, expected '-'")
  }
}

///|
fn Parser::parse_indentless_sequence_entry(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_block_entry() {
    let tok_line = tok.line
    let tok_col = tok.col
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_block_entry() || nk == tk_key() || nk == tk_value() || nk == tk_block_end() {
      self.state = ps_indentless_seq_entry()
      self.set_ev_empty(0, -1, tok_line, tok_col)
    } else {
      self.push_state(ps_indentless_seq_entry())
      self.parse_node(true, false)
    }
  } else {
    self.pop_state()
    self.set_ev_simple(ev_seq_end(), tok.line, tok.col)
  }
}

///|
fn Parser::parse_flow_sequence_entry(self : Parser, first : Bool) -> Event {
  if first {
    let t = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), t.line, t.col)
    }
    self.skip_token()
  }
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_flow_seq_end() {
    self.pop_state()
    self.skip_token()
    return self.set_ev_simple(ev_seq_end(), tok.line, tok.col)
  } else if k == tk_flow_entry() {
    if !first {
      self.skip_token()
    }
  } else if !first {
    return self.fail(tok.line, tok.col, "while parsing a flow sequence, expected ',' or ']'")
  }

  let nxt = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
  }
  let nk = nxt.kind
  if nk == tk_flow_seq_end() {
    self.pop_state()
    self.skip_token()
    self.set_ev_simple(ev_seq_end(), nxt.line, nxt.col)
  } else if nk == tk_key() {
    self.state = ps_flow_seq_map_key()
    self.skip_token()
    self.set_ev_simple(ev_map_start(), nxt.line, nxt.col)
  } else {
    self.push_state(ps_flow_seq_entry())
    self.parse_node(false, false)
  }
}

///|
fn Parser::parse_flow_seq_entry_map_key(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  let k = tok.kind
  if k == tk_value() || k == tk_flow_entry() || k == tk_flow_seq_end() {
    self.skip_token()
    self.state = ps_flow_seq_map_val()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  } else {
    self.push_state(ps_flow_seq_map_val())
    self.parse_node(false, false)
  }
}

///|
fn Parser::parse_flow_seq_entry_map_value(self : Parser) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_value() {
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    self.flow_map_end_line = nxt.line
    self.flow_map_end_col = nxt.col
    if nk == tk_flow_entry() || nk == tk_flow_seq_end() {
      self.state = ps_flow_seq_map_end()
      self.set_ev_empty(0, -1, nxt.line, nxt.col)
    } else {
      self.push_state(ps_flow_seq_map_end())
      self.parse_node(false, false)
    }
  } else {
    self.flow_map_end_line = tok.line
    self.flow_map_end_col = tok.col
    self.state = ps_flow_seq_map_end()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  }
}

///|
fn Parser::parse_flow_mapping_key(self : Parser, first : Bool) -> Event {
  if first {
    let t = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), t.line, t.col)
    }
    self.skip_token()
  }
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if tok.kind == tk_flow_map_end() {
    self.pop_state()
    self.skip_token()
    return self.set_ev_simple(ev_map_end(), tok.line, tok.col)
  } else if !first {
    if tok.kind == tk_flow_entry() {
      self.skip_token()
    } else {
      return self.fail(tok.line, tok.col, "while parsing a flow mapping, expected ',' or '}'")
    }
  }

  let nxt = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
  }
  let nk = nxt.kind
  if nk == tk_key() {
    self.skip_token()
    let after = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), after.line, after.col)
    }
    let ak = after.kind
    if ak == tk_value() || ak == tk_flow_entry() || ak == tk_flow_map_end() {
      self.state = ps_flow_map_val()
      self.set_ev_empty(0, -1, after.line, after.col)
    } else {
      self.push_state(ps_flow_map_val())
      self.parse_node(false, false)
    }
  } else if nk == tk_value() {
    self.state = ps_flow_map_val()
    self.set_ev_empty(0, -1, nxt.line, nxt.col)
  } else if nk == tk_flow_map_end() {
    self.pop_state()
    self.skip_token()
    self.set_ev_simple(ev_map_end(), nxt.line, nxt.col)
  } else {
    self.push_state(ps_flow_map_empty_val())
    self.parse_node(false, false)
  }
}

///|
fn Parser::parse_flow_mapping_value(self : Parser, empty : Bool) -> Event {
  let tok = self.peek_token()
  if self.has_error {
    return self.set_ev_simple(ev_err(), tok.line, tok.col)
  }
  if empty {
    self.state = ps_flow_map_key()
    return self.set_ev_empty(0, -1, tok.line, tok.col)
  }
  if tok.kind == tk_value() {
    let tok_line = tok.line
    let tok_col = tok.col
    self.skip_token()
    let nxt = self.peek_token()
    if self.has_error {
      return self.set_ev_simple(ev_err(), nxt.line, nxt.col)
    }
    let nk = nxt.kind
    if nk == tk_flow_entry() || nk == tk_flow_map_end() {
      self.state = ps_flow_map_key()
      self.set_ev_empty(0, -1, tok_line, tok_col)
    } else {
      self.push_state(ps_flow_map_key())
      self.parse_node(false, false)
    }
  } else {
    self.state = ps_flow_map_key()
    self.set_ev_empty(0, -1, tok.line, tok.col)
  }
}
