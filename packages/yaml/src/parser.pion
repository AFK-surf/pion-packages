///| YAML 1.2 Event-Driven State Machine Parser.
///| Consumes tokens from `Scanner`, enforces full YAML 1.2 structural grammar,
///| resolves `%TAG` handles and anchor IDs, and emits `Event`s for `Loader`.

///|
struct YamlTag {
  handle : String
  suffix : String
}

///|
fn YamlTag::new(handle : String, suffix : String) -> YamlTag {
  YamlTag::{ handle: handle, suffix: suffix }
}

///|
fn YamlTag::is_core_schema(self : YamlTag) -> Bool {
  self.handle == "tag:yaml.org,2002:"
}

///|
enum Event {
  StreamStart
  StreamEnd
  DocumentStart(Bool)
  DocumentEnd
  Alias(Int)
  Scalar(String, ScalarStyle, Int, Option[YamlTag])
  SequenceStart(Int, Option[YamlTag])
  SequenceEnd
  MappingStart(Int, Option[YamlTag])
  MappingEnd
}

///|
fn empty_scalar_event() -> Event {
  Event::Scalar("", ScalarStyle::Plain, 0, None)
}

///|
fn empty_scalar_with_props(anchor_id : Int, tag : Option[YamlTag]) -> Event {
  Event::Scalar("", ScalarStyle::Plain, anchor_id, tag)
}

///|
enum ParserState {
  StreamStart
  ImplicitDocumentStart
  DocumentStart
  DocumentContent
  DocumentEnd
  BlockNode
  BlockSequenceFirstEntry
  BlockSequenceEntry
  IndentlessSequenceEntry
  BlockMappingFirstKey
  BlockMappingKey
  BlockMappingValue
  FlowSequenceFirstEntry
  FlowSequenceEntry
  FlowSequenceEntryMappingKey
  FlowSequenceEntryMappingValue
  FlowSequenceEntryMappingEnd(Marker)
  FlowMappingFirstKey
  FlowMappingKey
  FlowMappingValue
  FlowMappingEmptyValue
  End
}

///|
struct Parser {
  scanner : Scanner
  states : Array[ParserState]
  mut state : ParserState
  mut has_token : Bool
  mut token : Token
  anchors : Map[String, Int]
  mut anchor_id_count : Int
  tags : Map[String, String]
}

///|
fn Parser::new(src : String) -> Parser {
  Parser::{
    scanner: Scanner::new(src),
    states: [],
    state: ParserState::StreamStart,
    has_token: false,
    token: Token::empty(Marker::new(0, 1, 0), TokenKind::StreamStart),
    anchors: Map::new(),
    anchor_id_count: 1,
    tags: Map::new(),
  }
}

///|
fn Parser::peek_token(self : Parser) -> Result[Token, YamlError] {
  if !self.has_token {
    match self.scanner.next_token() {
      Ok(Some(t)) => {
        self.token = t
        self.has_token = true
      }
      Ok(None) => return Err(self.scanner.err("unexpected end of stream"))
      Err(e) => return Err(e)
    }
  }
  Ok(self.token)
}

///|
fn Parser::fetch_token(self : Parser) -> Result[Token, YamlError] {
  let t = match self.peek_token() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  self.has_token = false
  Ok(t)
}

///|
fn Parser::skip_token(self : Parser) -> Unit {
  self.has_token = false
}

///|
fn Parser::push_state(self : Parser, st : ParserState) -> Unit {
  self.states.push(st)
}

///|
fn Parser::pop_state(self : Parser) -> Unit {
  match self.states.pop() {
    Some(st) => self.state = st
    None => self.state = ParserState::End
  }
}

///|
fn Parser::register_anchor(self : Parser, name : String) -> Int {
  let id = self.anchor_id_count
  self.anchor_id_count = self.anchor_id_count + 1
  self.anchors.set(name, id)
  id
}

///|
fn Parser::next_event(self : Parser) -> Result[(Event, Marker), YamlError] {
  match self.state {
    ParserState::StreamStart => self.parse_stream_start()
    ParserState::ImplicitDocumentStart => self.parse_document_start(true)
    ParserState::DocumentStart => self.parse_document_start(false)
    ParserState::DocumentContent => self.parse_document_content()
    ParserState::DocumentEnd => self.parse_document_end()
    ParserState::BlockNode => self.parse_node(true, false)
    ParserState::BlockMappingFirstKey => self.parse_block_mapping_key(true)
    ParserState::BlockMappingKey => self.parse_block_mapping_key(false)
    ParserState::BlockMappingValue => self.parse_block_mapping_value()
    ParserState::BlockSequenceFirstEntry => self.parse_block_sequence_entry(true)
    ParserState::BlockSequenceEntry => self.parse_block_sequence_entry(false)
    ParserState::IndentlessSequenceEntry => self.parse_indentless_sequence_entry()
    ParserState::FlowSequenceFirstEntry => self.parse_flow_sequence_entry(true)
    ParserState::FlowSequenceEntry => self.parse_flow_sequence_entry(false)
    ParserState::FlowSequenceEntryMappingKey => self.parse_flow_seq_entry_map_key()
    ParserState::FlowSequenceEntryMappingValue => self.parse_flow_seq_entry_map_value()
    ParserState::FlowSequenceEntryMappingEnd(m) => {
      self.state = ParserState::FlowSequenceEntry
      Ok((Event::MappingEnd, m))
    }
    ParserState::FlowMappingFirstKey => self.parse_flow_mapping_key(true)
    ParserState::FlowMappingKey => self.parse_flow_mapping_key(false)
    ParserState::FlowMappingValue => self.parse_flow_mapping_value(false)
    ParserState::FlowMappingEmptyValue => self.parse_flow_mapping_value(true)
    ParserState::End => Ok((Event::StreamEnd, self.scanner.mark()))
  }
}

///|
fn Parser::parse_stream_start(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::StreamStart => {
      self.state = ParserState::ImplicitDocumentStart
      self.skip_token()
      Ok((Event::StreamStart, tok.start))
    }
    _ => Err(err_at(tok.start, "did not find expected <stream-start>"))
  }
}

///|
fn Parser::parse_document_start(self : Parser, implicit : Bool) -> Result[(Event, Marker), YamlError] {
  while true {
    let tok = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    match tok.kind {
      TokenKind::DocumentEnd => self.skip_token()
      TokenKind::ByteOrderMark => self.skip_token()
      _ => break
    }
  }

  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::StreamEnd => {
      self.state = ParserState::End
      self.skip_token()
      Ok((Event::StreamEnd, tok.start))
    }
    TokenKind::VersionDirective(_, _) => self.parse_explicit_document_start()
    TokenKind::TagDirective(_, _) => self.parse_explicit_document_start()
    TokenKind::ReservedDirective(_) => self.parse_explicit_document_start()
    TokenKind::DocumentStart => self.parse_explicit_document_start()
    _ => {
      if implicit {
        match self.process_directives() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        self.push_state(ParserState::DocumentEnd)
        self.state = ParserState::BlockNode
        Ok((Event::DocumentStart(false), tok.start))
      } else {
        self.parse_explicit_document_start()
      }
    }
  }
}

///|
fn Parser::process_directives(self : Parser) -> Result[Unit, YamlError] {
  let mut version_seen = false
  let doc_tags : Map[String, String] = Map::new()
  while true {
    let tok = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    match tok.kind {
      TokenKind::VersionDirective(_, _) => {
        if version_seen {
          return Err(err_at(tok.start, "duplicate %YAML version directive"))
        }
        version_seen = true
        self.skip_token()
      }
      TokenKind::TagDirective(handle, prefix) => {
        if doc_tags.contains(handle) {
          return Err(err_at(tok.start, "duplicate %TAG directive for handle"))
        }
        doc_tags.set(handle, prefix)
        self.tags.set(handle, prefix)
        self.skip_token()
      }
      TokenKind::ReservedDirective(_) => {
        self.skip_token()
      }
      _ => break
    }
  }
  Ok(())
}

///|
fn Parser::parse_explicit_document_start(self : Parser) -> Result[(Event, Marker), YamlError] {
  match self.process_directives() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::DocumentStart => {
      self.push_state(ParserState::DocumentEnd)
      self.state = ParserState::DocumentContent
      self.skip_token()
      Ok((Event::DocumentStart(true), tok.start))
    }
    TokenKind::ByteOrderMark => Err(err_at(tok.start, "a byte order mark must not appear inside a document"))
    _ => Err(err_at(tok.start, "did not find expected <document-start>"))
  }
}

///|
fn Parser::parse_document_content(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let is_empty_doc = match tok.kind {
    TokenKind::VersionDirective(_, _) => true
    TokenKind::TagDirective(_, _) => true
    TokenKind::ReservedDirective(_) => true
    TokenKind::DocumentStart => true
    TokenKind::DocumentEnd => true
    TokenKind::ByteOrderMark => true
    TokenKind::StreamEnd => true
    _ => false
  }
  if is_empty_doc {
    self.pop_state()
    Ok((empty_scalar_event(), tok.start))
  } else {
    self.parse_node(true, false)
  }
}

///|
fn Parser::parse_document_end(self : Parser) -> Result[(Event, Marker), YamlError] {
  let first = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match first.kind {
    TokenKind::ByteOrderMark => {
      let bom_mark = first.start
      while true {
        let t = match self.peek_token() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match t.kind {
          TokenKind::ByteOrderMark => self.skip_token()
          _ => break
        }
      }
      let after = match self.peek_token() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ok_after = match after.kind {
        TokenKind::DocumentStart => true
        TokenKind::DocumentEnd => true
        TokenKind::StreamEnd => true
        _ => false
      }
      if !ok_after {
        return Err(err_at(bom_mark, "a byte order mark must not appear inside a document"))
      }
    }
    _ => ()
  }

  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let mut explicit_end = false
  let end_mark = tok.start
  match tok.kind {
    TokenKind::DocumentEnd => {
      explicit_end = true
      self.skip_token()
    }
    _ => ()
  }

  self.tags.clear()
  if explicit_end {
    self.state = ParserState::ImplicitDocumentStart
  } else {
    let nxt = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    match nxt.kind {
      TokenKind::VersionDirective(_, _) => {
        return Err(err_at(nxt.start, "missing explicit document end marker before directive"))
      }
      TokenKind::TagDirective(_, _) => {
        return Err(err_at(nxt.start, "missing explicit document end marker before directive"))
      }
      TokenKind::ReservedDirective(_) => {
        return Err(err_at(nxt.start, "missing explicit document end marker before directive"))
      }
      TokenKind::DocumentStart => ()
      TokenKind::StreamEnd => ()
      _ => return Err(err_at(nxt.start, "did not find expected <document-start>"))
    }
    self.state = ParserState::DocumentStart
  }
  Ok((Event::DocumentEnd, end_mark))
}

///|
fn Parser::resolve_tag(self : Parser, mark : Marker, handle : String, suffix : String) -> Result[YamlTag, YamlError] {
  if handle == "!!" {
    let resolved_handle = match self.tags.get("!!") {
      Some(p) => p
      None => "tag:yaml.org,2002:"
    }
    Ok(YamlTag::new(resolved_handle, suffix))
  } else if handle.length() == 0 && suffix == "!" {
    match self.tags.get("") {
      Some(p) => Ok(YamlTag::new(p, suffix))
      None => Ok(YamlTag::new("", suffix))
    }
  } else {
    match self.tags.get(handle) {
      Some(p) => Ok(YamlTag::new(p, suffix))
      None => {
        let hlen = handle.length()
        if hlen >= 2 && handle.code_unit_at(0) == 33 && handle.code_unit_at(hlen - 1) == 33 {
          return Err(err_at(mark, "undeclared tag handle"))
        }
        Ok(YamlTag::new(handle, suffix))
      }
    }
  }
}

///|
fn Parser::parse_node(self : Parser, block : Bool, indentless_seq : Bool) -> Result[(Event, Marker), YamlError] {
  let mut anchor_id = 0
  let mut tag : Option[YamlTag] = None
  let first_tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let start_mark = first_tok.start

  match first_tok.kind {
    TokenKind::Alias(name) => {
      self.pop_state()
      let _ = self.fetch_token()
      match self.anchors.get(name) {
        None => return Err(err_at(start_mark, "while parsing node, found unknown anchor"))
        Some(id) => return Ok((Event::Alias(id), start_mark))
      }
    }
    TokenKind::Anchor(name) => {
      let _ = self.fetch_token()
      anchor_id = self.register_anchor(name)
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      match nxt.kind {
        TokenKind::Tag(h, s) => {
          let _ = self.fetch_token()
          let rt = match self.resolve_tag(nxt.start, h, s) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          tag = Some(rt)
        }
        _ => ()
      }
    }
    TokenKind::Tag(h, s) => {
      let _ = self.fetch_token()
      let rt = match self.resolve_tag(first_tok.start, h, s) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      tag = Some(rt)
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      match nxt.kind {
        TokenKind::Anchor(name) => {
          let _ = self.fetch_token()
          anchor_id = self.register_anchor(name)
        }
        _ => ()
      }
    }
    _ => ()
  }

  let cur = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match cur.kind {
    TokenKind::BlockEntry => {
      if indentless_seq {
        self.state = ParserState::IndentlessSequenceEntry
        Ok((Event::SequenceStart(anchor_id, tag), start_mark))
      } else if tag_is_some(tag) || anchor_id > 0 {
        self.pop_state()
        Ok((empty_scalar_with_props(anchor_id, tag), start_mark))
      } else {
        Err(err_at(cur.start, "while parsing a node, did not find expected node content"))
      }
    }
    TokenKind::Scalar(style, text) => {
      self.pop_state()
      let _ = self.fetch_token()
      Ok((Event::Scalar(text, style, anchor_id, tag), start_mark))
    }
    TokenKind::FlowSequenceStart => {
      self.state = ParserState::FlowSequenceFirstEntry
      Ok((Event::SequenceStart(anchor_id, tag), start_mark))
    }
    TokenKind::FlowMappingStart => {
      self.state = ParserState::FlowMappingFirstKey
      Ok((Event::MappingStart(anchor_id, tag), start_mark))
    }
    TokenKind::BlockSequenceStart => {
      if block {
        self.state = ParserState::BlockSequenceFirstEntry
        Ok((Event::SequenceStart(anchor_id, tag), start_mark))
      } else if tag_is_some(tag) || anchor_id > 0 {
        self.pop_state()
        Ok((empty_scalar_with_props(anchor_id, tag), start_mark))
      } else {
        Err(err_at(cur.start, "while parsing a node, did not find expected node content"))
      }
    }
    TokenKind::BlockMappingStart => {
      if block {
        self.state = ParserState::BlockMappingFirstKey
        Ok((Event::MappingStart(anchor_id, tag), start_mark))
      } else if tag_is_some(tag) || anchor_id > 0 {
        self.pop_state()
        Ok((empty_scalar_with_props(anchor_id, tag), start_mark))
      } else {
        Err(err_at(cur.start, "while parsing a node, did not find expected node content"))
      }
    }
    _ => {
      if tag_is_some(tag) || anchor_id > 0 {
        self.pop_state()
        Ok((empty_scalar_with_props(anchor_id, tag), start_mark))
      } else {
        Err(err_at(cur.start, "while parsing a node, did not find expected node content"))
      }
    }
  }
}

///|
fn tag_is_some(t : Option[YamlTag]) -> Bool {
  match t {
    Some(_) => true
    None => false
  }
}

///|
fn Parser::parse_block_mapping_key(self : Parser, first : Bool) -> Result[(Event, Marker), YamlError] {
  if first {
    let _ = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    self.skip_token()
  }
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::Key => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::Key => true
        TokenKind::Value => true
        TokenKind::BlockEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::BlockMappingValue
        Ok((empty_scalar_event(), nxt.start))
      } else {
        self.push_state(ParserState::BlockMappingValue)
        self.parse_node(true, true)
      }
    }
    TokenKind::Value => {
      self.state = ParserState::BlockMappingValue
      Ok((empty_scalar_event(), tok.start))
    }
    TokenKind::BlockEnd => {
      self.pop_state()
      self.skip_token()
      Ok((Event::MappingEnd, tok.start))
    }
    _ => Err(err_at(tok.start, "while parsing a block mapping, did not find expected key"))
  }
}

///|
fn Parser::parse_block_mapping_value(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::Value => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::Key => true
        TokenKind::Value => true
        TokenKind::BlockEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::BlockMappingKey
        Ok((empty_scalar_event(), tok.start))
      } else {
        self.push_state(ParserState::BlockMappingKey)
        self.parse_node(true, true)
      }
    }
    _ => {
      self.state = ParserState::BlockMappingKey
      Ok((empty_scalar_event(), tok.start))
    }
  }
}

///|
fn Parser::parse_block_sequence_entry(self : Parser, first : Bool) -> Result[(Event, Marker), YamlError] {
  if first {
    let _ = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    self.skip_token()
  }
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::BlockEnd => {
      self.pop_state()
      self.skip_token()
      Ok((Event::SequenceEnd, tok.start))
    }
    TokenKind::BlockEntry => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::BlockEntry => true
        TokenKind::BlockEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::BlockSequenceEntry
        Ok((empty_scalar_event(), tok.start))
      } else {
        self.push_state(ParserState::BlockSequenceEntry)
        self.parse_node(true, false)
      }
    }
    _ => Err(err_at(tok.start, "while parsing a block sequence, expected '-'"))
  }
}

///|
fn Parser::parse_indentless_sequence_entry(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::BlockEntry => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::BlockEntry => true
        TokenKind::Key => true
        TokenKind::Value => true
        TokenKind::BlockEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::IndentlessSequenceEntry
        Ok((empty_scalar_event(), tok.start))
      } else {
        self.push_state(ParserState::IndentlessSequenceEntry)
        self.parse_node(true, false)
      }
    }
    _ => {
      self.pop_state()
      Ok((Event::SequenceEnd, tok.start))
    }
  }
}

///|
fn Parser::parse_flow_sequence_entry(self : Parser, first : Bool) -> Result[(Event, Marker), YamlError] {
  if first {
    let _ = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    self.skip_token()
  }
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::FlowSequenceEnd => {
      self.pop_state()
      self.skip_token()
      return Ok((Event::SequenceEnd, tok.start))
    }
    TokenKind::FlowEntry => {
      if !first {
        self.skip_token()
      }
    }
    _ => {
      if !first {
        return Err(err_at(tok.start, "while parsing a flow sequence, expected ',' or ']'"))
      }
    }
  }

  let nxt = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match nxt.kind {
    TokenKind::FlowSequenceEnd => {
      self.pop_state()
      self.skip_token()
      Ok((Event::SequenceEnd, nxt.start))
    }
    TokenKind::Key => {
      self.state = ParserState::FlowSequenceEntryMappingKey
      self.skip_token()
      Ok((Event::MappingStart(0, None), nxt.start))
    }
    _ => {
      self.push_state(ParserState::FlowSequenceEntry)
      self.parse_node(false, false)
    }
  }
}

///|
fn Parser::parse_flow_seq_entry_map_key(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let is_empty = match tok.kind {
    TokenKind::Value => true
    TokenKind::FlowEntry => true
    TokenKind::FlowSequenceEnd => true
    _ => false
  }
  if is_empty {
    self.skip_token()
    self.state = ParserState::FlowSequenceEntryMappingValue
    Ok((empty_scalar_event(), tok.start))
  } else {
    self.push_state(ParserState::FlowSequenceEntryMappingValue)
    self.parse_node(false, false)
  }
}

///|
fn Parser::parse_flow_seq_entry_map_value(self : Parser) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::Value => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::FlowEntry => true
        TokenKind::FlowSequenceEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::FlowSequenceEntryMappingEnd(nxt.end)
        Ok((empty_scalar_event(), nxt.start))
      } else {
        self.push_state(ParserState::FlowSequenceEntryMappingEnd(nxt.end))
        self.parse_node(false, false)
      }
    }
    _ => {
      self.state = ParserState::FlowSequenceEntryMappingEnd(tok.end)
      Ok((empty_scalar_event(), tok.start))
    }
  }
}

///|
fn Parser::parse_flow_mapping_key(self : Parser, first : Bool) -> Result[(Event, Marker), YamlError] {
  if first {
    let _ = match self.peek_token() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    self.skip_token()
  }
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match tok.kind {
    TokenKind::FlowMappingEnd => {
      self.pop_state()
      self.skip_token()
      return Ok((Event::MappingEnd, tok.start))
    }
    _ => {
      if !first {
        match tok.kind {
          TokenKind::FlowEntry => self.skip_token()
          _ => return Err(err_at(tok.start, "while parsing a flow mapping, expected ',' or '}'"))
        }
      }
    }
  }

  let nxt = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match nxt.kind {
    TokenKind::Key => {
      self.skip_token()
      let after = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match after.kind {
        TokenKind::Value => true
        TokenKind::FlowEntry => true
        TokenKind::FlowMappingEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::FlowMappingValue
        Ok((empty_scalar_event(), after.start))
      } else {
        self.push_state(ParserState::FlowMappingValue)
        self.parse_node(false, false)
      }
    }
    TokenKind::Value => {
      self.state = ParserState::FlowMappingValue
      Ok((empty_scalar_event(), nxt.start))
    }
    TokenKind::FlowMappingEnd => {
      self.pop_state()
      self.skip_token()
      Ok((Event::MappingEnd, nxt.start))
    }
    _ => {
      self.push_state(ParserState::FlowMappingEmptyValue)
      self.parse_node(false, false)
    }
  }
}

///|
fn Parser::parse_flow_mapping_value(self : Parser, empty : Bool) -> Result[(Event, Marker), YamlError] {
  let tok = match self.peek_token() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if empty {
    self.state = ParserState::FlowMappingKey
    return Ok((empty_scalar_event(), tok.start))
  }
  match tok.kind {
    TokenKind::Value => {
      self.skip_token()
      let nxt = match self.peek_token() {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let is_empty = match nxt.kind {
        TokenKind::FlowEntry => true
        TokenKind::FlowMappingEnd => true
        _ => false
      }
      if is_empty {
        self.state = ParserState::FlowMappingKey
        Ok((empty_scalar_event(), tok.start))
      } else {
        self.push_state(ParserState::FlowMappingKey)
        self.parse_node(false, false)
      }
    }
    _ => {
      self.state = ParserState::FlowMappingKey
      Ok((empty_scalar_event(), tok.start))
    }
  }
}
