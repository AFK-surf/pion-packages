///| YAML 1.2 Loader: Core Schema scalar resolution, anchors/aliases with
///| Billion Laughs DoS protection, merge key (`<<`), and multi-document loading.

///|
fn max_alias_nodes() -> Int {
  100000
}

///|
fn max_nesting_depth() -> Int {
  256
}

///|
struct Loader {
  parser : Parser
  anchor_vals : Array[YamlValue]
  mut expanded_nodes : Int
}

///|
fn Loader::new(src : String) -> Loader {
  Loader::{
    parser: Parser::new(src),
    anchor_vals: [YamlValue::Null],
    expanded_nodes: 0,
  }
}

///|
fn Loader::store_anchor(self : Loader, id : Int, v : YamlValue) -> Unit {
  if id <= 0 {
    return
  }
  while self.anchor_vals.length() <= id {
    self.anchor_vals.push(YamlValue::Null)
  }
  self.anchor_vals[id] = v
}

///| Count nodes in `v` up to `limit` to guard against Billion Laughs alias bombs.
fn count_nodes_bounded(v : YamlValue, limit : Int) -> Int {
  match v {
    YamlValue::Seq(arr) => {
      let mut total = 1
      let mut i = 0
      let n = arr.length()
      while i < n {
        total = total + count_nodes_bounded(arr[i], limit - total)
        if total > limit {
          return total
        }
        i = i + 1
      }
      total
    }
    YamlValue::Map(entries) => {
      let mut total = 1
      let mut i = 0
      let n = entries.length()
      while i < n {
        let (k, val_node) = entries[i]
        total = total + count_nodes_bounded(k, limit - total)
        if total > limit {
          return total
        }
        total = total + count_nodes_bounded(val_node, limit - total)
        if total > limit {
          return total
        }
        i = i + 1
      }
      total
    }
    _ => 1
  }
}

///| Parse decimal Int64 strictly (`[-+]?[0-9]+`). Returns `None` on invalid syntax or overflow.
fn parse_dec_i64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let b0 = s.code_unit_at(0)
  if b0 == 45 {
    neg = true
    i = 1
  } else if b0 == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  // Accumulate as negative to support Int64::MIN (-9223372036854775808) cleanly
  let min_div10 : Int64 = -922337203685477580L
  let mut acc : Int64 = 0L
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = (b - 48).to_int64()
    if acc < min_div10 {
      return None
    }
    acc = acc * 10L
    if neg {
      if acc < -9223372036854775807L - 1L + d {
        return None
      }
      acc = acc - d
    } else {
      if acc < -9223372036854775807L + d {
        return None
      }
      acc = acc - d
    }
    i = i + 1
  }
  if neg {
    Some(acc)
  } else {
    Some(0L - acc)
  }
}

///| Parse hex (`0x[0-9a-fA-F]+`) or octal (`0o[0-7]+`) Int64.
fn parse_radix_i64(s : String, start : Int, radix : Int64) -> Option[Int64] {
  let n = s.length()
  if start >= n {
    return None
  }
  let max_val : Int64 = 9223372036854775807L
  let limit = max_val / radix
  let mut acc : Int64 = 0L
  let mut i = start
  while i < n {
    let b = s.code_unit_at(i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if radix == 16L && b >= 65 && b <= 70 {
      b - 55
    } else if radix == 16L && b >= 97 && b <= 102 {
      b - 87
    } else {
      return None
    }
    if d.to_int64() >= radix {
      return None
    }
    if acc > limit {
      return None
    }
    let next = acc * radix
    if next > max_val - d.to_int64() {
      return None
    }
    acc = next + d.to_int64()
    i = i + 1
  }
  Some(acc)
}

///| Parse YAML 1.2 Core Schema integer (decimal, `0x` hex, `0o` octal).
fn parse_core_int(s : String) -> Option[Int64] {
  let n = s.length()
  if n >= 3 && s.code_unit_at(0) == 48 {
    let b1 = s.code_unit_at(1)
    if b1 == 120 {
      return parse_radix_i64(s, 2, 16L)
    } else if b1 == 111 {
      return parse_radix_i64(s, 2, 8L)
    }
  }
  parse_dec_i64(s)
}

///| Check if `s` matches YAML 1.2 Core Schema float syntax and parse to `Double`.
fn parse_core_float(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  if s == ".inf" || s == ".Inf" || s == ".INF" || s == "+.inf" || s == "+.Inf" || s == "+.INF" {
    return Some(1.0 / 0.0)
  }
  if s == "-.inf" || s == "-.Inf" || s == "-.INF" {
    return Some(-1.0 / 0.0)
  }
  if s == ".nan" || s == ".NaN" || s == ".NAN" {
    return Some(0.0 / 0.0)
  }

  let mut i = 0
  let b0 = s.code_unit_at(0)
  if b0 == 43 || b0 == 45 {
    i = 1
  }
  if i >= n {
    return None
  }

  let mut int_digits = 0
  while i < n && is_digit(s.code_unit_at(i)) {
    int_digits = int_digits + 1
    i = i + 1
  }
  let mut has_dot = false
  let mut frac_digits = 0
  if i < n && s.code_unit_at(i) == 46 {
    has_dot = true
    i = i + 1
    while i < n && is_digit(s.code_unit_at(i)) {
      frac_digits = frac_digits + 1
      i = i + 1
    }
  }
  if int_digits == 0 && frac_digits == 0 {
    return None
  }
  let mut has_exp = false
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    has_exp = true
    i = i + 1
    if i < n && (s.code_unit_at(i) == 43 || s.code_unit_at(i) == 45) {
      i = i + 1
    }
    let mut exp_digits = 0
    while i < n && is_digit(s.code_unit_at(i)) {
      exp_digits = exp_digits + 1
      i = i + 1
    }
    if exp_digits == 0 {
      return None
    }
  }
  if i != n {
    return None
  }
  if !has_dot && !has_exp {
    return None
  }
  // Parse via String::to_double (or fallback)
  let clean = if b0 == 43 { s.slice(1, n) } else { s }
  match clean.to_double() {
    Some(d) => Some(d)
    None => None
  }
}

///| Resolve a plain scalar using YAML 1.2 Core Schema.
fn resolve_plain_scalar(s : String) -> YamlValue {
  let n = s.length()
  if n == 0 {
    return YamlValue::Null
  }
  if n == 1 && s.code_unit_at(0) == 126 {
    return YamlValue::Null
  }
  if n == 4 {
    if s == "null" || s == "Null" || s == "NULL" {
      return YamlValue::Null
    }
    if s == "true" || s == "True" || s == "TRUE" {
      return YamlValue::Bool(true)
    }
  } else if n == 5 {
    if s == "false" || s == "False" || s == "FALSE" {
      return YamlValue::Bool(false)
    }
  }
  let b0 = s.code_unit_at(0)
  if is_digit(b0) || b0 == 45 || b0 == 43 || b0 == 46 {
    match parse_core_int(s) {
      Some(i) => return YamlValue::Int(i)
      None => ()
    }
    match parse_core_float(s) {
      Some(f) => return YamlValue::Float(f)
      None => ()
    }
  }
  YamlValue::Str(s)
}

///| Resolve a scalar with its style and optional tag.
fn resolve_scalar(text : String, style : ScalarStyle, tag : Option[YamlTag], mark : Marker) -> Result[YamlValue, YamlError] {
  match tag {
    Some(t) => {
      // Non-specific `!` tag forces scalar resolution to `!!str` (YAML 1.2 §6.9.1).
      if t.handle.length() == 0 && t.suffix == "!" {
        return Ok(YamlValue::Str(text))
      }
      if t.is_core_schema() {
        if t.suffix == "str" {
          return Ok(YamlValue::Str(text))
        } else if t.suffix == "null" {
          if text.length() == 0 || text == "~" || text == "null" || text == "Null" || text == "NULL" {
            return Ok(YamlValue::Null)
          }
          return Err(err_at(mark, "invalid !!null scalar"))
        } else if t.suffix == "bool" {
          if text == "true" || text == "True" || text == "TRUE" {
            return Ok(YamlValue::Bool(true))
          } else if text == "false" || text == "False" || text == "FALSE" {
            return Ok(YamlValue::Bool(false))
          }
          return Err(err_at(mark, "invalid !!bool scalar"))
        } else if t.suffix == "int" {
          match parse_core_int(text) {
            Some(i) => return Ok(YamlValue::Int(i))
            None => return Err(err_at(mark, "invalid !!int scalar"))
          }
        } else if t.suffix == "float" {
          match parse_core_float(text) {
            Some(f) => return Ok(YamlValue::Float(f))
            None => {
              match parse_core_int(text) {
                Some(i) => return Ok(YamlValue::Float(i.to_double()))
                None => return Err(err_at(mark, "invalid !!float scalar"))
              }
            }
          }
        }
      }
      // Non-core tag or custom tag: fall through to style-based resolution
      match style {
        ScalarStyle::Plain => Ok(resolve_plain_scalar(text))
        _ => Ok(YamlValue::Str(text))
      }
    }
    None => {
      match style {
        ScalarStyle::Plain => Ok(resolve_plain_scalar(text))
        _ => Ok(YamlValue::Str(text))
      }
    }
  }
}

///| Structural equality on `YamlValue` (used for merge-key overriding).
fn yaml_value_eq(a : YamlValue, b : YamlValue) -> Bool {
  match a {
    YamlValue::Null => {
      match b {
        YamlValue::Null => true
        _ => false
      }
    }
    YamlValue::Bool(x) => {
      match b {
        YamlValue::Bool(y) => x == y
        _ => false
      }
    }
    YamlValue::Int(x) => {
      match b {
        YamlValue::Int(y) => x == y
        _ => false
      }
    }
    YamlValue::Float(x) => {
      match b {
        YamlValue::Float(y) => x == y
        _ => false
      }
    }
    YamlValue::Str(x) => {
      match b {
        YamlValue::Str(y) => x == y
        _ => false
      }
    }
    YamlValue::Seq(xs) => {
      match b {
        YamlValue::Seq(ys) => {
          if xs.length() != ys.length() {
            return false
          }
          let mut i = 0
          let n = xs.length()
          while i < n {
            if !yaml_value_eq(xs[i], ys[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    }
    YamlValue::Map(xs) => {
      match b {
        YamlValue::Map(ys) => {
          if xs.length() != ys.length() {
            return false
          }
          let mut i = 0
          let n = xs.length()
          while i < n {
            let (xk, xv) = xs[i]
            let (yk, yv) = ys[i]
            if !yaml_value_eq(xk, yk) || !yaml_value_eq(xv, yv) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    }
  }
}

///| Check whether `entries` already contains `key`.
fn map_entries_has(entries : Array[(YamlValue, YamlValue)], key : YamlValue) -> Bool {
  let mut i = 0
  let n = entries.length()
  while i < n {
    let (k, _) = entries[i]
    if yaml_value_eq(k, key) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn Loader::load_all(self : Loader) -> Result[Array[YamlValue], YamlError] {
  let (ev0, mark0) = match self.parser.next_event() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match ev0 {
    Event::StreamStart => ()
    _ => return Err(err_at(mark0, "did not find expected <stream-start>"))
  }

  let docs : Array[YamlValue] = []
  while true {
    let (ev, mark) = match self.parser.next_event() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match ev {
      Event::StreamEnd => break
      Event::DocumentStart(_) => {
        self.parser.anchors.clear()
        self.anchor_vals.clear()
        self.anchor_vals.push(YamlValue::Null)
        let (node_ev, node_mark) = match self.parser.next_event() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let doc = match self.load_node(node_ev, node_mark, 0) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let (end_ev, end_mark) = match self.parser.next_event() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match end_ev {
          Event::DocumentEnd => ()
          _ => return Err(err_at(end_mark, "did not find expected <document-end>"))
        }
        docs.push(doc)
      }
      _ => return Err(err_at(mark, "did not find expected <document-start>"))
    }
  }
  Ok(docs)
}

///|
fn Loader::load_node(self : Loader, ev : Event, mark : Marker, depth : Int) -> Result[YamlValue, YamlError] {
  if depth > max_nesting_depth() {
    return Err(err_at(mark, "maximum YAML nesting depth exceeded"))
  }
  match ev {
    Event::Alias(id) => {
      if id <= 0 || id >= self.anchor_vals.length() {
        return Err(err_at(mark, "unresolved alias reference"))
      }
      let target = self.anchor_vals[id]
      let budget = max_alias_nodes() - self.expanded_nodes
      let cnt = count_nodes_bounded(target, budget)
      if cnt > budget {
        return Err(err_at(mark, "alias expansion limit exceeded (possible Billion Laughs attack)"))
      }
      self.expanded_nodes = self.expanded_nodes + cnt
      Ok(target)
    }
    Event::Scalar(text, style, anchor_id, tag) => {
      let v = match resolve_scalar(text, style, tag, mark) {
        Ok(val_node) => val_node
        Err(e) => return Err(e)
      }
      self.store_anchor(anchor_id, v)
      Ok(v)
    }
    Event::SequenceStart(anchor_id, _) => {
      let items : Array[YamlValue] = []
      while true {
        let (next_ev, next_mark) = match self.parser.next_event() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match next_ev {
          Event::SequenceEnd => break
          _ => {
            let item = match self.load_node(next_ev, next_mark, depth + 1) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            items.push(item)
          }
        }
      }
      let seq = YamlValue::Seq(items)
      self.store_anchor(anchor_id, seq)
      Ok(seq)
    }
    Event::MappingStart(anchor_id, _) => {
      let explicit : Array[(YamlValue, YamlValue)] = []
      let merged : Array[(YamlValue, YamlValue)] = []
      while true {
        let (key_ev, key_mark) = match self.parser.next_event() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match key_ev {
          Event::MappingEnd => break
          _ => {
            let is_merge_key = match key_ev {
              Event::Scalar(t, ScalarStyle::Plain, _, None) => t == "<<"
              _ => false
            }
            let k = match self.load_node(key_ev, key_mark, depth + 1) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let (val_ev, val_mark) = match self.parser.next_event() {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let v = match self.load_node(val_ev, val_mark, depth + 1) {
              Ok(val_node) => val_node
              Err(e) => return Err(e)
            }
            if is_merge_key {
              match v {
                YamlValue::Map(m_entries) => {
                  let mut mi = 0
                  let mn = m_entries.length()
                  while mi < mn {
                    let (mk, mv) = m_entries[mi]
                    if !map_entries_has(merged, mk) {
                      merged.push((mk, mv))
                    }
                    mi = mi + 1
                  }
                }
                YamlValue::Seq(m_seq) => {
                  let mut all_maps = true
                  let mut si = 0
                  let sn = m_seq.length()
                  while si < sn {
                    match m_seq[si] {
                      YamlValue::Map(_) => ()
                      _ => {
                        all_maps = false
                        break
                      }
                    }
                    si = si + 1
                  }
                  if all_maps {
                    let mut si2 = 0
                    while si2 < sn {
                      match m_seq[si2] {
                        YamlValue::Map(m_entries) => {
                          let mut mi = 0
                          let mn = m_entries.length()
                          while mi < mn {
                            let (mk, mv) = m_entries[mi]
                            if !map_entries_has(merged, mk) {
                              merged.push((mk, mv))
                            }
                            mi = mi + 1
                          }
                        }
                        _ => ()
                      }
                      si2 = si2 + 1
                    }
                  } else {
                    explicit.push((k, v))
                  }
                }
                _ => explicit.push((k, v))
              }
            } else {
              explicit.push((k, v))
            }
          }
        }
      }
      if merged.length() > 0 {
        let mut mi = 0
        let mn = merged.length()
        while mi < mn {
          let (mk, mv) = merged[mi]
          if !map_entries_has(explicit, mk) {
            explicit.push((mk, mv))
          }
          mi = mi + 1
        }
      }
      let m = YamlValue::Map(explicit)
      self.store_anchor(anchor_id, m)
      Ok(m)
    }
    _ => Err(err_at(mark, "unexpected parser event while loading node"))
  }
}

///|
fn load_all_docs(src : String) -> Result[Array[YamlValue], YamlError] {
  let loader = Loader::new(src)
  loader.load_all()
}

///|
fn load_single_doc(src : String) -> Result[YamlValue, YamlError] {
  match load_all_docs(src) {
    Ok(docs) => {
      if docs.length() == 0 {
        Ok(YamlValue::Null)
      } else {
        Ok(docs[0])
      }
    }
    Err(e) => Err(e)
  }
}
