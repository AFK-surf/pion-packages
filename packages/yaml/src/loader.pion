///| YAML 1.2 Loader: Core Schema scalar resolution, anchors/aliases with
///| Billion Laughs DoS protection, merge key (`<<`), and multi-document loading.
///| Zero-copy slice resolution for plain scalars (integers, booleans, nulls, floats)
///| and zero-Result-wrapper hot path.

///|
fn max_alias_nodes() -> Int {
  100000
}

///|
fn max_alias_bytes() -> Int64 {
  67108864L
}

///|
fn max_nesting_depth() -> Int {
  1024
}

///|
struct Loader {
  parser : Parser
  anchor_vals : Array[YamlValue]
  anchor_ready : Array[Bool]
  anchor_nodes : Array[Int]
  anchor_bytes : Array[Int64]
  mut expanded_nodes : Int
  mut expanded_bytes : Int64
  mut has_error : Bool
  mut error : YamlError
}

///|
fn Loader::new(src : String) -> Loader {
  Loader::{
    parser: Parser::new(src),
    anchor_vals: [YamlValue::Null],
    anchor_ready: [false],
    anchor_nodes: [0],
    anchor_bytes: [0L],
    expanded_nodes: 0,
    expanded_bytes: 0L,
    has_error: false,
    error: YamlError::new(1, 1, ""),
  }
}

///|
fn Loader::fail(self : Loader, line : Int, col : Int, msg : String) -> YamlValue {
  self.has_error = true
  self.error = err_lc(line, col, msg)
  YamlValue::Null
}

///|
fn Loader::fail_from_parser(self : Loader) -> YamlValue {
  self.has_error = true
  self.error = self.parser.error
  YamlValue::Null
}

///| Count container nodes and estimated output bytes in `v` up to limits.
fn count_nodes_bytes_bounded(v : YamlValue, max_n : Int, max_b : Int64) -> (Int, Int64) {
  match v {
    YamlValue::Seq(arr) => {
      let mut total_n = 1
      let mut total_b : Int64 = 8L
      let mut i = 0
      let n = arr.length()
      while i < n {
        let (cn, cb) = count_nodes_bytes_bounded(arr[i], max_n - total_n, max_b - total_b)
        total_n = total_n + cn
        total_b = total_b + cb
        if total_n > max_n || total_b > max_b {
          return (total_n, total_b)
        }
        i = i + 1
      }
      (total_n, total_b)
    }
    YamlValue::Map(entries) => {
      let mut total_n = 1
      let mut total_b : Int64 = 8L
      let mut i = 0
      let n = entries.length()
      while i < n {
        let (k, val_node) = entries[i]
        let (kn, kb) = count_nodes_bytes_bounded(k, max_n - total_n, max_b - total_b)
        total_n = total_n + kn
        total_b = total_b + kb
        if total_n > max_n || total_b > max_b {
          return (total_n, total_b)
        }
        let (vn, vb) = count_nodes_bytes_bounded(val_node, max_n - total_n, max_b - total_b)
        total_n = total_n + vn
        total_b = total_b + vb
        if total_n > max_n || total_b > max_b {
          return (total_n, total_b)
        }
        i = i + 1
      }
      (total_n, total_b)
    }
    YamlValue::Str(s) => (1, s.length().to_int64() + 8L)
    _ => (1, 8L)
  }
}

///|
fn Loader::store_anchor(self : Loader, id : Int, v : YamlValue) -> Unit {
  if id <= 0 {
    return
  }
  while self.anchor_vals.length() <= id {
    self.anchor_vals.push(YamlValue::Null)
    self.anchor_ready.push(false)
    self.anchor_nodes.push(0)
    self.anchor_bytes.push(0L)
  }
  self.anchor_vals[id] = v
  self.anchor_ready[id] = true
  // Scalar aliases cannot amplify node count exponentially (node cost = 0),
  // but still track byte size to defeat large-string byte amplification bombs.
  match v {
    YamlValue::Str(s) => {
      self.anchor_nodes[id] = 0
      self.anchor_bytes[id] = s.length().to_int64()
    }
    YamlValue::Seq(_) => {
      let (cn, cb) = count_nodes_bytes_bounded(v, max_alias_nodes() + 1, max_alias_bytes() + 1L)
      self.anchor_nodes[id] = cn
      self.anchor_bytes[id] = cb
    }
    YamlValue::Map(_) => {
      let (cn, cb) = count_nodes_bytes_bounded(v, max_alias_nodes() + 1, max_alias_bytes() + 1L)
      self.anchor_nodes[id] = cn
      self.anchor_bytes[id] = cb
    }
    _ => {
      self.anchor_nodes[id] = 0
      self.anchor_bytes[id] = 8L
    }
  }
}

///| Parse decimal Int64 strictly from slice `src[start..end]`.
fn parse_dec_i64_slice(src : String, start : Int, end : Int) -> Option[Int64] {
  if start >= end {
    return None
  }
  let mut i = start
  let mut neg = false
  let b0 = src.code_unit_at(start)
  if b0 == 45 {
    neg = true
    i = start + 1
  } else if b0 == 43 {
    i = start + 1
  }
  if i >= end {
    return None
  }
  let len = end - i
  // Fast path: <= 18 digits never overflows Int64!
  if len <= 18 {
    let mut acc : Int64 = 0L
    while i < end {
      let b = src.code_unit_at(i)
      if b < 48 || b > 57 {
        return None
      }
      acc = acc * 10L + (b - 48).to_int64()
      i = i + 1
    }
    if neg {
      return Some(0L - acc)
    }
    return Some(acc)
  }
  // Accumulate as negative to support Int64::MIN (-9223372036854775808) cleanly
  let min_div10 : Int64 = -922337203685477580L
  let mut acc : Int64 = 0L
  while i < end {
    let b = src.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = (b - 48).to_int64()
    if acc < min_div10 {
      return None
    }
    acc = acc * 10L
    if neg {
      if acc < -9223372036854775807L - 1L + d {
        return None
      }
      acc = acc - d
    } else {
      if acc < -9223372036854775807L + d {
        return None
      }
      acc = acc - d
    }
    i = i + 1
  }
  if neg {
    Some(acc)
  } else {
    Some(0L - acc)
  }
}

///| Parse hex (`0x[0-9a-fA-F]+`) or octal (`0o[0-7]+`) Int64 from slice.
fn parse_radix_i64_slice(src : String, start : Int, end : Int, radix : Int64) -> Option[Int64] {
  if start >= end {
    return None
  }
  let max_val : Int64 = 9223372036854775807L
  let limit = max_val / radix
  let mut acc : Int64 = 0L
  let mut i = start
  while i < end {
    let b = src.code_unit_at(i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if radix == 16L && b >= 65 && b <= 70 {
      b - 55
    } else if radix == 16L && b >= 97 && b <= 102 {
      b - 87
    } else {
      return None
    }
    if d.to_int64() >= radix {
      return None
    }
    if acc > limit {
      return None
    }
    let next = acc * radix
    if next > max_val - d.to_int64() {
      return None
    }
    acc = next + d.to_int64()
    i = i + 1
  }
  Some(acc)
}

///| Parse YAML 1.2 Core Schema integer from slice `src[start..end]`.
fn parse_core_int_slice(src : String, start : Int, end : Int) -> Option[Int64] {
  let n = end - start
  if n >= 3 && src.code_unit_at(start) == 48 {
    let b1 = src.code_unit_at(start + 1)
    if b1 == 120 {
      return parse_radix_i64_slice(src, start + 2, end, 16L)
    } else if b1 == 111 {
      return parse_radix_i64_slice(src, start + 2, end, 8L)
    }
  }
  parse_dec_i64_slice(src, start, end)
}

///| Check if slice `src[start..end]` matches YAML 1.2 Core Schema float syntax and parse to `Double`.
fn parse_core_float_slice(src : String, start : Int, end : Int) -> Option[Double] {
  let n = end - start
  if n == 0 {
    return None
  }
  let b0 = src.code_unit_at(start)
  if b0 == 46 && n == 4 {
    let b1 = src.code_unit_at(start + 1)
    let b2 = src.code_unit_at(start + 2)
    let b3 = src.code_unit_at(start + 3)
    if (b1 == 105 && b2 == 110 && b3 == 102) || (b1 == 73 && b2 == 110 && b3 == 102) || (b1 == 73 && b2 == 78 && b3 == 70) {
      return Some(1.0 / 0.0)
    }
    if (b1 == 110 && b2 == 97 && b3 == 110) || (b1 == 78 && b2 == 97 && b3 == 78) || (b1 == 78 && b2 == 65 && b3 == 78) {
      return Some(0.0 / 0.0)
    }
  } else if (b0 == 43 || b0 == 45) && n == 5 && src.code_unit_at(start + 1) == 46 {
    let b2 = src.code_unit_at(start + 2)
    let b3 = src.code_unit_at(start + 3)
    let b4 = src.code_unit_at(start + 4)
    if (b2 == 105 && b3 == 110 && b4 == 102) || (b2 == 73 && b3 == 110 && b4 == 102) || (b2 == 73 && b3 == 78 && b4 == 70) {
      return Some(if b0 == 45 { -1.0 / 0.0 } else { 1.0 / 0.0 })
    }
  }

  let mut i = start
  if b0 == 43 || b0 == 45 {
    i = start + 1
  }
  if i >= end {
    return None
  }

  let mut int_digits = 0
  while i < end && is_digit(src.code_unit_at(i)) {
    int_digits = int_digits + 1
    i = i + 1
  }
  let mut has_dot = false
  let mut frac_digits = 0
  if i < end && src.code_unit_at(i) == 46 {
    has_dot = true
    i = i + 1
    while i < end && is_digit(src.code_unit_at(i)) {
      frac_digits = frac_digits + 1
      i = i + 1
    }
  }
  if int_digits == 0 && frac_digits == 0 {
    return None
  }
  let mut has_exp = false
  if i < end && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
    has_exp = true
    i = i + 1
    if i < end && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
      i = i + 1
    }
    let mut exp_digits = 0
    while i < end && is_digit(src.code_unit_at(i)) {
      exp_digits = exp_digits + 1
      i = i + 1
    }
    if exp_digits == 0 {
      return None
    }
  }
  if i != end {
    return None
  }
  if !has_dot && !has_exp {
    return None
  }
  let clean = if b0 == 43 { src.slice(start + 1, end) } else { src.slice(start, end) }
  clean.to_double()
}

///| Parse out-of-range Core Schema integer (decimal / 0x hex / 0o octal) as `Double`.
fn parse_core_bigint_as_float_slice(src : String, start : Int, end : Int) -> Option[Double] {
  let n = end - start
  if n == 0 {
    return None
  }
  let b0 = src.code_unit_at(start)
  if n >= 3 && b0 == 48 {
    let b1 = src.code_unit_at(start + 1)
    if b1 == 120 {
      let mut i = start + 2
      let mut acc = 0.0
      while i < end {
        let b = src.code_unit_at(i)
        let d = if b >= 48 && b <= 57 {
          b - 48
        } else if b >= 65 && b <= 70 {
          b - 55
        } else if b >= 97 && b <= 102 {
          b - 87
        } else {
          return None
        }
        acc = acc * 16.0 + d.to_double()
        i = i + 1
      }
      return Some(acc)
    } else if b1 == 111 {
      let mut i = start + 2
      let mut acc = 0.0
      while i < end {
        let b = src.code_unit_at(i)
        if b < 48 || b > 55 {
          return None
        }
        acc = acc * 8.0 + (b - 48).to_double()
        i = i + 1
      }
      return Some(acc)
    }
  }
  let mut i = start
  if b0 == 43 || b0 == 45 {
    i = start + 1
  }
  if i >= end {
    return None
  }
  while i < end {
    let b = src.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    i = i + 1
  }
  let clean = if b0 == 43 { src.slice(start + 1, end) } else { src.slice(start, end) }
  clean.to_double()
}

///| Resolve a plain scalar directly from `src[start..end]` with first-byte fast path.
///| Zero `String` allocation for Null, Bool, Int, and Float!
fn resolve_plain_scalar_slice(src : String, start : Int, end : Int) -> YamlValue {
  let n = end - start
  if n == 0 {
    return YamlValue::Null
  }
  let b0 = src.code_unit_at(start)
  // Numeric / sign / dot start: '-', '+', '.', '0'..'9'
  if (b0 >= 48 && b0 <= 57) || b0 == 45 || b0 == 43 || b0 == 46 {
    match parse_core_int_slice(src, start, end) {
      Some(i) => return YamlValue::Int(i)
      None => ()
    }
    match parse_core_float_slice(src, start, end) {
      Some(f) => return YamlValue::Float(f)
      None => ()
    }
    match parse_core_bigint_as_float_slice(src, start, end) {
      Some(f) => return YamlValue::Float(f)
      None => ()
    }
    return YamlValue::Str(src.slice(start, end))
  }
  // Length-gated keyword checks (true / false / null / ~)
  if n == 4 {
    if b0 == 116 || b0 == 84 {
      let b1 = src.code_unit_at(start + 1)
      let b2 = src.code_unit_at(start + 2)
      let b3 = src.code_unit_at(start + 3)
      if (b1 == 114 && b2 == 117 && b3 == 101) || (b0 == 84 && b1 == 82 && b2 == 85 && b3 == 69) {
        return YamlValue::Bool(true)
      }
    } else if b0 == 110 || b0 == 78 {
      let b1 = src.code_unit_at(start + 1)
      let b2 = src.code_unit_at(start + 2)
      let b3 = src.code_unit_at(start + 3)
      if (b1 == 117 && b2 == 108 && b3 == 108) || (b0 == 78 && b1 == 85 && b2 == 76 && b3 == 76) {
        return YamlValue::Null
      }
    }
  } else if n == 5 {
    if b0 == 102 || b0 == 70 {
      let b1 = src.code_unit_at(start + 1)
      let b2 = src.code_unit_at(start + 2)
      let b3 = src.code_unit_at(start + 3)
      let b4 = src.code_unit_at(start + 4)
      if (b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101) || (b0 == 70 && b1 == 65 && b2 == 76 && b3 == 83 && b4 == 69) {
        return YamlValue::Bool(false)
      }
    }
  } else if n == 1 && b0 == 126 {
    return YamlValue::Null
  }
  YamlValue::Str(src.slice(start, end))
}

///| Resolve a plain scalar from an owned `String` (used by `emitter.pion` and slow paths).
fn resolve_plain_scalar(s : String) -> YamlValue {
  let n = s.length()
  if n == 0 {
    return YamlValue::Null
  }
  let b0 = s.code_unit_at(0)
  if (b0 >= 48 && b0 <= 57) || b0 == 45 || b0 == 43 || b0 == 46 {
    match parse_core_int_slice(s, 0, n) {
      Some(i) => return YamlValue::Int(i)
      None => ()
    }
    match parse_core_float_slice(s, 0, n) {
      Some(f) => return YamlValue::Float(f)
      None => ()
    }
    match parse_core_bigint_as_float_slice(s, 0, n) {
      Some(f) => return YamlValue::Float(f)
      None => ()
    }
    return YamlValue::Str(s)
  }
  if n == 4 {
    if s == "true" || s == "True" || s == "TRUE" {
      return YamlValue::Bool(true)
    }
    if s == "null" || s == "Null" || s == "NULL" {
      return YamlValue::Null
    }
  } else if n == 5 {
    if s == "false" || s == "False" || s == "FALSE" {
      return YamlValue::Bool(false)
    }
  } else if n == 1 && b0 == 126 {
    return YamlValue::Null
  }
  YamlValue::Str(s)
}

///| Resolve a tagged scalar.
fn Loader::resolve_tagged_scalar(self : Loader, text : String, style : Int, tag_id : Int, line : Int, col : Int) -> YamlValue {
  let t = self.parser.resolved_tags[tag_id]
  // Non-specific `!` tag forces scalar resolution to `!!str` (YAML 1.2 §6.9.1).
  if t.handle.length() == 0 && t.suffix == "!" {
    return YamlValue::Str(text)
  }
  if t.is_core_schema() {
    if t.suffix == "str" {
      return YamlValue::Str(text)
    } else if t.suffix == "null" {
      if text.length() == 0 || text == "~" || text == "null" || text == "Null" || text == "NULL" {
        return YamlValue::Null
      }
      return self.fail(line, col, "invalid !!null scalar")
    } else if t.suffix == "bool" {
      if text == "true" || text == "True" || text == "TRUE" {
        return YamlValue::Bool(true)
      } else if text == "false" || text == "False" || text == "FALSE" {
        return YamlValue::Bool(false)
      }
      return self.fail(line, col, "invalid !!bool scalar")
    } else if t.suffix == "int" {
      match parse_core_int_slice(text, 0, text.length()) {
        Some(i) => return YamlValue::Int(i)
        None => {
          match parse_core_bigint_as_float_slice(text, 0, text.length()) {
            Some(f) => return YamlValue::Float(f)
            None => return self.fail(line, col, "invalid !!int scalar")
          }
        }
      }
    } else if t.suffix == "float" {
      match parse_core_float_slice(text, 0, text.length()) {
        Some(f) => return YamlValue::Float(f)
        None => {
          match parse_core_int_slice(text, 0, text.length()) {
            Some(i) => return YamlValue::Float(i.to_double())
            None => return self.fail(line, col, "invalid !!float scalar")
          }
        }
      }
    }
  }
  // Non-core tag or custom tag: preserve raw string representation (matches yaml-rust2 & yaml.v3)
  let _ = style
  YamlValue::Str(text)
}

///| Structural equality on `YamlValue` (used for merge-key overriding).
fn yaml_value_eq(a : YamlValue, b : YamlValue) -> Bool {
  match a {
    YamlValue::Null => {
      match b {
        YamlValue::Null => true
        _ => false
      }
    }
    YamlValue::Bool(x) => {
      match b {
        YamlValue::Bool(y) => x == y
        _ => false
      }
    }
    YamlValue::Int(x) => {
      match b {
        YamlValue::Int(y) => x == y
        _ => false
      }
    }
    YamlValue::Float(x) => {
      match b {
        YamlValue::Float(y) => x == y || (x != x && y != y)
        _ => false
      }
    }
    YamlValue::Str(x) => {
      match b {
        YamlValue::Str(y) => x == y
        _ => false
      }
    }
    YamlValue::Seq(xs) => {
      match b {
        YamlValue::Seq(ys) => {
          if xs.length() != ys.length() {
            return false
          }
          let mut i = 0
          let n = xs.length()
          while i < n {
            if !yaml_value_eq(xs[i], ys[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    }
    YamlValue::Map(xs) => {
      match b {
        YamlValue::Map(ys) => {
          if xs.length() != ys.length() {
            return false
          }
          let mut i = 0
          let n = xs.length()
          while i < n {
            let (xk, xv) = xs[i]
            let (yk, yv) = ys[i]
            if !yaml_value_eq(xk, yk) || !yaml_value_eq(xv, yv) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    }
  }
}

///| Fast structural hash for non-string `YamlValue` mapping keys.
fn yaml_value_hash(v : YamlValue) -> Int64 {
  match v {
    YamlValue::Null => 1L
    YamlValue::Bool(b) => if b { 2L } else { 3L }
    YamlValue::Int(n) => (n ^ 0x9E3779B97F4A7C15L) * 0xBF58476D1CE4E5B9L
    YamlValue::Float(f) => {
      let bits = if f != f {
        0x7FF8000000000000L
      } else if f == 0.0 {
        0L
      } else {
        f.to_bits()
      }
      (bits ^ 0x517CC1B727220A95L) * 0x94D049BB133111EBL
    }
    YamlValue::Str(s) => {
      let mut h : Int64 = -3750763034362895579L
      let n = s.length()
      let mut i = 0
      while i < n {
        h = (h ^ s.code_unit_at(i).to_int64()) * 1099511628211L
        i = i + 1
      }
      h
    }
    YamlValue::Seq(xs) => {
      let mut h : Int64 = 17L
      let n = xs.length()
      let mut i = 0
      while i < n {
        h = h * 31L + yaml_value_hash(xs[i])
        i = i + 1
      }
      h
    }
    YamlValue::Map(xs) => {
      let mut h : Int64 = 29L
      let n = xs.length()
      let mut i = 0
      while i < n {
        let (k, val_node) = xs[i]
        h = h * 31L + yaml_value_hash(k) * 131L + yaml_value_hash(val_node)
        i = i + 1
      }
      h
    }
  }
}

///| Check whether `entries` already contains `key` (linear scan for small maps <= 8).
fn map_entries_has(entries : Array[(YamlValue, YamlValue)], key : YamlValue) -> Bool {
  let n = entries.length()
  match key {
    YamlValue::Str(ks) => {
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        match k {
          YamlValue::Str(ek) => if ek == ks { return true }
          _ => ()
        }
        i = i + 1
      }
      false
    }
    _ => {
      let mut i = 0
      while i < n {
        let (k, _) = entries[i]
        if yaml_value_eq(k, key) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///| Insert a non-string key into `other_map`; returns `false` if duplicate.
fn other_map_insert(om : Map[Int64, Array[YamlValue]], key : YamlValue) -> Bool {
  let h = yaml_value_hash(key)
  match om.get(h) {
    Some(bucket) => {
      let mut i = 0
      let n = bucket.length()
      while i < n {
        if yaml_value_eq(bucket[i], key) {
          return false
        }
        i = i + 1
      }
      bucket.push(key)
      true
    }
    None => {
      om.set(h, [key])
      true
    }
  }
}

///| Check whether `other_map` contains a non-string key.
fn other_map_contains(om : Map[Int64, Array[YamlValue]], key : YamlValue) -> Bool {
  let h = yaml_value_hash(key)
  match om.get(h) {
    Some(bucket) => {
      let mut i = 0
      let n = bucket.length()
      while i < n {
        if yaml_value_eq(bucket[i], key) {
          return true
        }
        i = i + 1
      }
      false
    }
    None => false
  }
}

///| Populate hash sets from existing `entries`.
fn build_key_sets(entries : Array[(YamlValue, YamlValue)]) -> (Map[String, Bool], Option[Map[Int64, Array[YamlValue]]]) {
  let sm : Map[String, Bool] = Map::new()
  let mut om_opt : Option[Map[Int64, Array[YamlValue]]] = None
  let n = entries.length()
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    match k {
      YamlValue::Str(ks) => sm.set(ks, true)
      _ => {
        let om = match om_opt {
          Some(m) => m
          None => {
            let m : Map[Int64, Array[YamlValue]] = Map::new()
            om_opt = Some(m)
            m
          }
        }
        let _ = other_map_insert(om, k)
      }
    }
    i = i + 1
  }
  (sm, om_opt)
}

///|
fn Loader::load_all(self : Loader) -> Result[Array[YamlValue], YamlError] {
  let ev0 = self.parser.next_event()
  if self.parser.has_error {
    return Err(self.parser.error)
  }
  if ev0.kind != ev_stream_start() {
    return Err(err_lc(ev0.line, ev0.col, "did not find expected <stream-start>"))
  }

  let docs : Array[YamlValue] = []
  while true {
    let ev = self.parser.next_event()
    if self.parser.has_error {
      return Err(self.parser.error)
    }
    if ev.kind == ev_stream_end() {
      break
    }
    if ev.kind == ev_doc_start() {
      // Reset per-document alias expansion budgets (nodes & bytes).
      self.expanded_nodes = 0
      self.expanded_bytes = 0L
      if self.parser.has_anchors {
        self.parser.anchors.clear()
        self.parser.has_anchors = false
        self.anchor_vals.clear()
        self.anchor_vals.push(YamlValue::Null)
        self.anchor_ready.clear()
        self.anchor_ready.push(false)
        self.anchor_nodes.clear()
        self.anchor_nodes.push(0)
        self.anchor_bytes.clear()
        self.anchor_bytes.push(0L)
      }
      let node_ev = self.parser.next_event()
      if self.parser.has_error {
        return Err(self.parser.error)
      }
      let doc = self.load_node(node_ev, 0)
      if self.has_error {
        return Err(self.error)
      }
      let end_ev = self.parser.next_event()
      if self.parser.has_error {
        return Err(self.parser.error)
      }
      if end_ev.kind != ev_doc_end() {
        return Err(err_lc(end_ev.line, end_ev.col, "did not find expected <document-end>"))
      }
      docs.push(doc)
    } else {
      return Err(err_lc(ev.line, ev.col, "did not find expected <document-start>"))
    }
  }
  Ok(docs)
}

///|
fn Loader::load_node(self : Loader, ev : Event, depth : Int) -> YamlValue {
  if depth > max_nesting_depth() {
    return self.fail(ev.line, ev.col, "maximum YAML nesting depth exceeded")
  }
  let k = ev.kind
  if k == ev_scalar_slice() {
    let src = self.parser.scanner.src
    let v = if ev.tag_id < 0 {
      if ev.style == style_plain() {
        resolve_plain_scalar_slice(src, ev.val_start, ev.val_end)
      } else {
        YamlValue::Str(src.slice(ev.val_start, ev.val_end))
      }
    } else {
      let text = src.slice(ev.val_start, ev.val_end)
      let res = self.resolve_tagged_scalar(text, ev.style, ev.tag_id, ev.line, ev.col)
      if self.has_error {
        return YamlValue::Null
      }
      res
    }
    if ev.anchor_id > 0 {
      self.store_anchor(ev.anchor_id, v)
    }
    return v
  }
  if k == ev_map_start() {
    let map_anchor_id = ev.anchor_id
    let explicit : Array[(YamlValue, YamlValue)] = Array::with_capacity(4)
    let mut str_seen_opt : Option[Map[String, Bool]] = None
    let mut other_seen_opt : Option[Map[Int64, Array[YamlValue]]] = None
    let mut merged_opt : Option[Array[(YamlValue, YamlValue)]] = None
    let mut merged_str_opt : Option[Map[String, Bool]] = None
    let mut merged_other_opt : Option[Map[Int64, Array[YamlValue]]] = None
    let mut seen_merge = false
    let src = self.parser.scanner.src
    while true {
      let key_ev = self.parser.next_event()
      if self.parser.has_error {
        return self.fail_from_parser()
      }
      if key_ev.kind == ev_map_end() {
        break
      }
      let key_line = key_ev.line
      let key_col = key_ev.col
      // Ultra-fast path for ordinary untagged/unanchored scalar keys (99.9% of all map entries)
      if key_ev.kind == ev_scalar_slice() && key_ev.tag_id < 0 && key_ev.anchor_id == 0 {
        let is_merge = key_ev.style == style_plain() &&
        key_ev.val_end - key_ev.val_start == 2 &&
        src.code_unit_at(key_ev.val_start) == 60 &&
        src.code_unit_at(key_ev.val_start + 1) == 60
        if !is_merge {
          let key_node = if key_ev.style == style_plain() {
            resolve_plain_scalar_slice(src, key_ev.val_start, key_ev.val_end)
          } else {
            YamlValue::Str(src.slice(key_ev.val_start, key_ev.val_end))
          }
          // Duplicate key check: linear scan for <= 8 entries (zero alloc), O(1) hash table above.
          match str_seen_opt {
            Some(sm) => {
              match key_node {
                YamlValue::Str(ks) => {
                  if sm.contains(ks) {
                    return self.fail(key_line, key_col, "duplicate mapping key")
                  }
                  sm.set(ks, true)
                }
                _ => {
                  let om = match other_seen_opt {
                    Some(m) => m
                    None => {
                      let m : Map[Int64, Array[YamlValue]] = Map::new()
                      other_seen_opt = Some(m)
                      m
                    }
                  }
                  if !other_map_insert(om, key_node) {
                    return self.fail(key_line, key_col, "duplicate mapping key")
                  }
                }
              }
            }
            None => {
              if explicit.length() < 8 {
                if map_entries_has(explicit, key_node) {
                  return self.fail(key_line, key_col, "duplicate mapping key")
                }
              } else {
                let (sm, om_opt) = build_key_sets(explicit)
                str_seen_opt = Some(sm)
                other_seen_opt = om_opt
                match key_node {
                  YamlValue::Str(ks) => {
                    if sm.contains(ks) {
                      return self.fail(key_line, key_col, "duplicate mapping key")
                    }
                    sm.set(ks, true)
                  }
                  _ => {
                    let om = match other_seen_opt {
                      Some(m) => m
                      None => {
                        let m : Map[Int64, Array[YamlValue]] = Map::new()
                        other_seen_opt = Some(m)
                        m
                      }
                    }
                    if !other_map_insert(om, key_node) {
                      return self.fail(key_line, key_col, "duplicate mapping key")
                    }
                  }
                }
              }
            }
          }
          let val_ev = self.parser.next_event()
          if self.parser.has_error {
            return self.fail_from_parser()
          }
          let val_node = if val_ev.kind == ev_scalar_slice() && val_ev.tag_id < 0 && val_ev.anchor_id == 0 {
            if val_ev.style == style_plain() {
              resolve_plain_scalar_slice(src, val_ev.val_start, val_ev.val_end)
            } else {
              YamlValue::Str(src.slice(val_ev.val_start, val_ev.val_end))
            }
          } else {
            let vn = self.load_node(val_ev, depth + 1)
            if self.has_error {
              return YamlValue::Null
            }
            vn
          }
          explicit.push((key_node, val_node))
          continue
        }
      }
      let is_merge_key = if key_ev.kind == ev_scalar_slice() && key_ev.style == style_plain() && key_ev.tag_id < 0 && key_ev.val_end - key_ev.val_start == 2 {
        src.code_unit_at(key_ev.val_start) == 60 && src.code_unit_at(key_ev.val_start + 1) == 60
      } else if key_ev.kind == ev_scalar_owned() && key_ev.style == style_plain() && key_ev.tag_id < 0 {
        self.parser.scanner.str_pool[key_ev.val_start] == "<<"
      } else {
        false
      }
      let key_node = self.load_node(key_ev, depth + 1)
      if self.has_error {
        return YamlValue::Null
      }
      let val_ev = self.parser.next_event()
      if self.parser.has_error {
        return self.fail_from_parser()
      }
      let val_line = val_ev.line
      let val_col = val_ev.col
      let val_node = self.load_node(val_ev, depth + 1)
      if self.has_error {
        return YamlValue::Null
      }
      if !is_merge_key {
        match str_seen_opt {
          Some(sm) => {
            match key_node {
              YamlValue::Str(ks) => {
                if sm.contains(ks) {
                  return self.fail(key_line, key_col, "duplicate mapping key")
                }
                sm.set(ks, true)
              }
              _ => {
                let om = match other_seen_opt {
                  Some(m) => m
                  None => {
                    let m : Map[Int64, Array[YamlValue]] = Map::new()
                    other_seen_opt = Some(m)
                    m
                  }
                }
                if !other_map_insert(om, key_node) {
                  return self.fail(key_line, key_col, "duplicate mapping key")
                }
              }
            }
          }
          None => {
            if explicit.length() < 8 {
              if map_entries_has(explicit, key_node) {
                return self.fail(key_line, key_col, "duplicate mapping key")
              }
            } else {
              let (sm, om_opt) = build_key_sets(explicit)
              str_seen_opt = Some(sm)
              other_seen_opt = om_opt
              match key_node {
                YamlValue::Str(ks) => {
                  if sm.contains(ks) {
                    return self.fail(key_line, key_col, "duplicate mapping key")
                  }
                  sm.set(ks, true)
                }
                _ => {
                  let om = match other_seen_opt {
                    Some(m) => m
                    None => {
                      let m : Map[Int64, Array[YamlValue]] = Map::new()
                      other_seen_opt = Some(m)
                      m
                    }
                  }
                  if !other_map_insert(om, key_node) {
                    return self.fail(key_line, key_col, "duplicate mapping key")
                  }
                }
              }
            }
          }
        }
        explicit.push((key_node, val_node))
      } else {
        if seen_merge {
          return self.fail(key_line, key_col, "duplicate merge key '<<' in mapping")
        }
        seen_merge = true
        let merged = match merged_opt {
          Some(m) => m
          None => {
            let m : Array[(YamlValue, YamlValue)] = []
            merged_opt = Some(m)
            m
          }
        }
        match val_node {
          YamlValue::Map(m_entries) => {
            let mn = m_entries.length()
            if merged.length() == 0 {
              let mut mi = 0
              while mi < mn {
                merged.push(m_entries[mi])
                mi = mi + 1
              }
            } else {
              let sm = match merged_str_opt {
                Some(s) => s
                None => {
                  let (s, o) = build_key_sets(merged)
                  merged_str_opt = Some(s)
                  merged_other_opt = o
                  s
                }
              }
              let mut mi = 0
              while mi < mn {
                let (mk, mv) = m_entries[mi]
                match mk {
                  YamlValue::Str(ks) => {
                    if !sm.contains(ks) {
                      sm.set(ks, true)
                      merged.push((mk, mv))
                    }
                  }
                  _ => {
                    let om = match merged_other_opt {
                      Some(o) => o
                      None => {
                        let o : Map[Int64, Array[YamlValue]] = Map::new()
                        merged_other_opt = Some(o)
                        o
                      }
                    }
                    if other_map_insert(om, mk) {
                      merged.push((mk, mv))
                    }
                  }
                }
                mi = mi + 1
              }
            }
          }
          YamlValue::Seq(m_seq) => {
            let sn = m_seq.length()
            let mut si = 0
            while si < sn {
              match m_seq[si] {
                YamlValue::Map(_) => ()
                _ => return self.fail(val_line, val_col, "merge key '<<' requires a mapping or sequence of mappings")
              }
              si = si + 1
            }
            let mut si2 = 0
            while si2 < sn {
              match m_seq[si2] {
                YamlValue::Map(m_entries) => {
                  let mn = m_entries.length()
                  if merged.length() == 0 {
                    let mut mi = 0
                    while mi < mn {
                      merged.push(m_entries[mi])
                      mi = mi + 1
                    }
                  } else {
                    let sm = match merged_str_opt {
                      Some(s) => s
                      None => {
                        let (s, o) = build_key_sets(merged)
                        merged_str_opt = Some(s)
                        merged_other_opt = o
                        s
                      }
                    }
                    let mut mi = 0
                    while mi < mn {
                      let (mk, mv) = m_entries[mi]
                      match mk {
                        YamlValue::Str(ks) => {
                          if !sm.contains(ks) {
                            sm.set(ks, true)
                            merged.push((mk, mv))
                          }
                        }
                        _ => {
                          let om = match merged_other_opt {
                            Some(o) => o
                            None => {
                              let o : Map[Int64, Array[YamlValue]] = Map::new()
                              merged_other_opt = Some(o)
                              o
                            }
                          }
                          if other_map_insert(om, mk) {
                            merged.push((mk, mv))
                          }
                        }
                      }
                      mi = mi + 1
                    }
                  }
                }
                _ => ()
              }
              si2 = si2 + 1
            }
          }
          _ => return self.fail(val_line, val_col, "merge key '<<' requires a mapping or sequence of mappings")
        }
      }
    }
    match merged_opt {
      Some(merged) => {
        let mn = merged.length()
        if mn > 0 {
          if explicit.length() == 0 {
            let mut mi = 0
            while mi < mn {
              explicit.push(merged[mi])
              mi = mi + 1
            }
          } else if explicit.length() + mn <= 16 {
            let mut mi = 0
            while mi < mn {
              let (mk, mv) = merged[mi]
              if !map_entries_has(explicit, mk) {
                explicit.push((mk, mv))
              }
              mi = mi + 1
            }
          } else {
            let sm = match str_seen_opt {
              Some(s) => s
              None => {
                let (s, o) = build_key_sets(explicit)
                str_seen_opt = Some(s)
                other_seen_opt = o
                s
              }
            }
            let mut mi = 0
            while mi < mn {
              let (mk, mv) = merged[mi]
              match mk {
                YamlValue::Str(ks) => {
                  if !sm.contains(ks) {
                    sm.set(ks, true)
                    explicit.push((mk, mv))
                  }
                }
                _ => {
                  let dup = match other_seen_opt {
                    Some(om) => other_map_contains(om, mk)
                    None => false
                  }
                  if !dup {
                    let om = match other_seen_opt {
                      Some(o) => o
                      None => {
                        let o : Map[Int64, Array[YamlValue]] = Map::new()
                        other_seen_opt = Some(o)
                        o
                      }
                    }
                    let _ = other_map_insert(om, mk)
                    explicit.push((mk, mv))
                  }
                }
              }
              mi = mi + 1
            }
          }
        }
      }
      None => ()
    }
    let m = YamlValue::Map(explicit)
    if map_anchor_id > 0 {
      self.store_anchor(map_anchor_id, m)
    }
    return m
  }
  if k == ev_seq_start() {
    let seq_anchor_id = ev.anchor_id
    let items : Array[YamlValue] = Array::with_capacity(4)
    let src = self.parser.scanner.src
    while true {
      let next_ev = self.parser.next_event()
      if self.parser.has_error {
        return self.fail_from_parser()
      }
      if next_ev.kind == ev_seq_end() {
        break
      }
      let item = if next_ev.kind == ev_scalar_slice() && next_ev.tag_id < 0 && next_ev.anchor_id == 0 {
        if next_ev.style == style_plain() {
          resolve_plain_scalar_slice(src, next_ev.val_start, next_ev.val_end)
        } else {
          YamlValue::Str(src.slice(next_ev.val_start, next_ev.val_end))
        }
      } else {
        let it = self.load_node(next_ev, depth + 1)
        if self.has_error {
          return YamlValue::Null
        }
        it
      }
      items.push(item)
    }
    let seq = YamlValue::Seq(items)
    if seq_anchor_id > 0 {
      self.store_anchor(seq_anchor_id, seq)
    }
    return seq
  }
  if k == ev_scalar_owned() {
    let text = self.parser.scanner.str_pool[ev.val_start]
    let v = if ev.tag_id < 0 {
      if ev.style == style_plain() {
        resolve_plain_scalar(text)
      } else {
        YamlValue::Str(text)
      }
    } else {
      let res = self.resolve_tagged_scalar(text, ev.style, ev.tag_id, ev.line, ev.col)
      if self.has_error {
        return YamlValue::Null
      }
      res
    }
    if ev.anchor_id > 0 {
      self.store_anchor(ev.anchor_id, v)
    }
    return v
  }
  if k == ev_alias() {
    let id = ev.val_start
    if id <= 0 || id >= self.anchor_ready.length() || !self.anchor_ready[id] {
      return self.fail(ev.line, ev.col, "recursive or unresolved alias reference")
    }
    let nc = self.anchor_nodes[id]
    let bc = self.anchor_bytes[id]
    if self.expanded_nodes + nc > max_alias_nodes() || self.expanded_bytes + bc > max_alias_bytes() {
      return self.fail(ev.line, ev.col, "alias expansion limit exceeded (possible Billion Laughs attack)")
    }
    self.expanded_nodes = self.expanded_nodes + nc
    self.expanded_bytes = self.expanded_bytes + bc
    return self.anchor_vals[id]
  }
  self.fail(ev.line, ev.col, "unexpected parser event while loading node")
}

///|
fn load_all_docs(src : String) -> Result[Array[YamlValue], YamlError] {
  let loader = Loader::new(src)
  loader.load_all()
}

///|
fn load_single_doc(src : String) -> Result[YamlValue, YamlError] {
  match load_all_docs(src) {
    Ok(docs) => {
      if docs.length() == 0 {
        Ok(YamlValue::Null)
      } else {
        Ok(docs[0])
      }
    }
    Err(e) => Err(e)
  }
}
