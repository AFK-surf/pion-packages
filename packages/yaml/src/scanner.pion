///| Direct UTF-8 byte-indexed YAML 1.2 Scanner.
///| Implements the full YAML 1.2 token grammar (SimpleKey lookahead, indentation stack,
///| block/flow collections, block/flow/plain scalars, directives, tags, anchors, BOM, tab rules).

///|
enum ScalarStyle {
  Plain
  SingleQuoted
  DoubleQuoted
  Literal
  Folded
}

///|
val struct Marker {
  index : Int
  line : Int
  col : Int
}

///|
fn Marker::new(index : Int, line : Int, col : Int) -> Marker {
  Marker::{ index: index, line: line, col: col }
}

///|
enum TokenKind {
  StreamStart
  StreamEnd
  VersionDirective(Int, Int)
  TagDirective(String, String)
  ReservedDirective(String)
  DocumentStart
  DocumentEnd
  ByteOrderMark
  BlockSequenceStart
  BlockMappingStart
  BlockEnd
  FlowSequenceStart
  FlowSequenceEnd
  FlowMappingStart
  FlowMappingEnd
  BlockEntry
  FlowEntry
  Key
  Value
  Alias(String)
  Anchor(String)
  Tag(String, String)
  Scalar(ScalarStyle, String)
}

///|
struct Token {
  start : Marker
  end : Marker
  kind : TokenKind
}

///|
fn Token::new(start : Marker, end : Marker, kind : TokenKind) -> Token {
  Token::{ start: start, end: end, kind: kind }
}

///|
fn Token::empty(m : Marker, kind : TokenKind) -> Token {
  Token::{ start: m, end: m, kind: kind }
}

///|
struct SimpleKey {
  mut possible : Bool
  mut required : Bool
  mut token_number : Int
  mut mark : Marker
}

///|
fn SimpleKey::new(mark : Marker) -> SimpleKey {
  SimpleKey::{ possible: false, required: false, token_number: 0, mark: mark }
}

///|
struct IndentEntry {
  indent : Int
  needs_block_end : Bool
}

///| Implicit mapping state inside a flow sequence:
///| 0 = None (flow mapping), 1 = Possible (flow seq), 2 = Inside (flow seq implicit map)
fn implicit_none() -> Int {
  0
}

///|
fn implicit_possible() -> Int {
  1
}

///|
fn implicit_inside() -> Int {
  2
}

///| Chomping mode for block scalars: 0 = Clip, 1 = Strip, 2 = Keep
fn chomp_clip() -> Int {
  0
}

///|
fn chomp_strip() -> Int {
  1
}

///|
fn chomp_keep() -> Int {
  2
}

///| Character classification helpers (operating on byte values, -1 = EOF).
fn is_eof(b : Int) -> Bool {
  b < 0
}

///|
fn is_break(b : Int) -> Bool {
  b == 10 || b == 13
}

///|
fn is_breakz(b : Int) -> Bool {
  b < 0 || b == 0 || b == 10 || b == 13
}

///|
fn is_blank(b : Int) -> Bool {
  b == 32 || b == 9
}

///|
fn is_blank_or_break(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_blank_or_breakz(b : Int) -> Bool {
  b <= 0 || b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
fn is_alpha_yaml(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45
}

///|
fn is_word_char(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45
}

///|
fn is_hex(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

///|
fn as_hex(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    b - 87
  }
}

///|
fn is_flow(b : Int) -> Bool {
  b == 44 || b == 91 || b == 93 || b == 123 || b == 125
}

///|
fn is_uri_char(b : Int) -> Bool {
  if is_word_char(b) {
    return true
  }
  b == 35 || b == 59 || b == 47 || b == 63 || b == 58 || b == 64 ||
  b == 38 || b == 61 || b == 43 || b == 36 || b == 44 || b == 95 ||
  b == 46 || b == 33 || b == 126 || b == 42 || b == 39 || b == 40 ||
  b == 41 || b == 91 || b == 93 || b == 37
}

///|
fn is_tag_char(b : Int) -> Bool {
  is_uri_char(b) && !is_flow(b) && b != 33
}

///| UTF-8 sequence byte length from leading byte.
fn utf8_char_len(b : Int) -> Int {
  if b < 0x80 {
    1
  } else if (b & 0xE0) == 0xC0 {
    2
  } else if (b & 0xF0) == 0xE0 {
    3
  } else if (b & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

///| Encode a Unicode scalar value to UTF-8 bytes in `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///|
struct Scanner {
  src : String
  len : Int
  mut pos : Int
  mut index : Int
  mut line : Int
  mut col : Int

  tokens : Array[Token]
  mut token_head : Int
  mut stream_start_produced : Bool
  mut stream_end_produced : Bool
  mut adjacent_value_allowed_at : Int
  mut simple_key_allowed : Bool
  simple_keys : Array[SimpleKey]
  mut indent : Int
  indents : Array[IndentEntry]
  mut flow_level : Int
  mut tokens_parsed : Int
  mut token_available : Bool
  mut leading_whitespace : Bool
  flow_mapping_started : Array[Bool]
  implicit_flow_mapping_states : Array[Int]
  mut has_interrupted_plain : Bool
  mut interrupted_plain_mark : Marker
}

///|
fn Scanner::new(src : String) -> Scanner {
  Scanner::{
    src: src,
    len: src.length(),
    pos: 0,
    index: 0,
    line: 1,
    col: 0,
    tokens: [],
    token_head: 0,
    stream_start_produced: false,
    stream_end_produced: false,
    adjacent_value_allowed_at: -1,
    simple_key_allowed: true,
    simple_keys: [],
    indent: -1,
    indents: [],
    flow_level: 0,
    tokens_parsed: 0,
    token_available: false,
    leading_whitespace: true,
    flow_mapping_started: [],
    implicit_flow_mapping_states: [],
    has_interrupted_plain: false,
    interrupted_plain_mark: Marker::new(0, 1, 0),
  }
}

///|
fn Scanner::mark(self : Scanner) -> Marker {
  Marker::new(self.index, self.line, self.col)
}

///|
fn Scanner::err(self : Scanner, msg : String) -> YamlError {
  YamlError::new(self.line, self.col + 1, msg)
}

///|
fn err_at(m : Marker, msg : String) -> YamlError {
  YamlError::new(m.line, m.col + 1, msg)
}

///|
fn Scanner::peek_b(self : Scanner) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

///|
fn Scanner::peek_b_at(self : Scanner, off : Int) -> Int {
  let p = self.pos + off
  if p < self.len {
    self.src.code_unit_at(p)
  } else {
    -1
  }
}

///|
fn Scanner::is_bom_at(self : Scanner, p : Int) -> Bool {
  p + 2 < self.len &&
  self.src.code_unit_at(p) == 0xEF &&
  self.src.code_unit_at(p + 1) == 0xBB &&
  self.src.code_unit_at(p + 2) == 0xBF
}

///|
fn Scanner::next_is_bom(self : Scanner) -> Bool {
  self.is_bom_at(self.pos)
}

///|
fn Scanner::next_is_yaml_non_break(self : Scanner) -> Bool {
  let b = self.peek_b()
  !is_breakz(b) && !self.next_is_bom()
}

///|
fn Scanner::next_is_yaml_non_space(self : Scanner) -> Bool {
  let b = self.peek_b()
  !is_blank_or_breakz(b) && !self.next_is_bom()
}

///|
fn Scanner::next_is_doc_start(self : Scanner) -> Bool {
  self.pos + 2 < self.len &&
  self.src.code_unit_at(self.pos) == 45 &&
  self.src.code_unit_at(self.pos + 1) == 45 &&
  self.src.code_unit_at(self.pos + 2) == 45 &&
  is_blank_or_breakz(self.peek_b_at(3))
}

///|
fn Scanner::next_is_doc_end(self : Scanner) -> Bool {
  self.pos + 2 < self.len &&
  self.src.code_unit_at(self.pos) == 46 &&
  self.src.code_unit_at(self.pos + 1) == 46 &&
  self.src.code_unit_at(self.pos + 2) == 46 &&
  is_blank_or_breakz(self.peek_b_at(3))
}

///|
fn Scanner::next_is_doc_indicator(self : Scanner) -> Bool {
  self.next_is_doc_start() || self.next_is_doc_end()
}

///|
fn Scanner::next_can_be_plain_scalar(self : Scanner, in_flow : Bool) -> Bool {
  let b = self.peek_b()
  if b == 58 {
    let nb = self.peek_b_at(1)
    if is_blank_or_breakz(nb) || (in_flow && is_flow(nb)) {
      return false
    }
    return true
  }
  if b == 0xEF && self.next_is_bom() {
    return false
  }
  if in_flow && is_flow(b) {
    return false
  }
  true
}

///|
fn Scanner::skip_blank(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = self.col + 1
}

///|
fn Scanner::skip_ascii_non_blank(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = self.col + 1
  self.leading_whitespace = false
}

///|
fn Scanner::skip_n_ascii_non_blank(self : Scanner, n : Int) -> Unit {
  self.pos = self.pos + n
  self.index = self.index + n
  self.col = self.col + n
  self.leading_whitespace = false
}

///|
fn Scanner::skip_char_non_blank(self : Scanner) -> Unit {
  let b = self.peek_b()
  if b < 0 {
    return
  }
  let clen = utf8_char_len(b)
  let adv = if self.pos + clen <= self.len { clen } else { self.len - self.pos }
  self.pos = self.pos + adv
  self.index = self.index + 1
  self.col = self.col + 1
  self.leading_whitespace = false
}

///|
fn Scanner::skip_nl(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = 0
  self.line = self.line + 1
  self.leading_whitespace = true
}

///|
fn Scanner::skip_linebreak(self : Scanner) -> Unit {
  let b = self.peek_b()
  if b == 13 && self.peek_b_at(1) == 10 {
    self.skip_blank()
    self.skip_nl()
  } else if b == 10 || b == 13 {
    self.skip_nl()
  }
}

///|
fn Scanner::read_break(self : Scanner, sb : StringBuilder) -> Unit {
  self.skip_linebreak()
  sb.write_byte(10.to_byte())
}

///|
fn Scanner::tokens_len(self : Scanner) -> Int {
  self.tokens.length() - self.token_head
}

///|
fn Scanner::push_token(self : Scanner, tok : Token) -> Unit {
  self.tokens.push(tok)
}

///|
fn Scanner::pop_token(self : Scanner) -> Option[Token] {
  if self.token_head >= self.tokens.length() {
    return None
  }
  let tok = self.tokens[self.token_head]
  self.token_head = self.token_head + 1
  if self.token_head >= self.tokens.length() {
    self.tokens.clear()
    self.token_head = 0
  }
  Some(tok)
}

///|
fn Scanner::insert_token(self : Scanner, rel_pos : Int, tok : Token) -> Unit {
  let abs_pos = self.token_head + rel_pos
  let n = self.tokens.length()
  self.tokens.push(tok)
  let mut i = n
  while i > abs_pos {
    self.tokens[i] = self.tokens[i - 1]
    i = i - 1
  }
  self.tokens[abs_pos] = tok
}

///|
fn Scanner::last_token(self : Scanner) -> Option[Token] {
  if self.tokens.length() > self.token_head {
    Some(self.tokens[self.tokens.length() - 1])
  } else {
    None
  }
}

///| Returns `(found_tabs, has_yaml_ws)` or `Err`.
fn Scanner::skip_ws_to_eol(self : Scanner, skip_tabs : Bool) -> Result[(Bool, Bool), YamlError] {
  let mut encountered_tab = false
  let mut has_yaml_ws = false
  while true {
    let b = self.peek_b()
    if b == 32 {
      has_yaml_ws = true
      self.skip_blank()
    } else if b == 9 && skip_tabs {
      encountered_tab = true
      self.skip_blank()
    } else if b == 35 {
      if !encountered_tab && !has_yaml_ws {
        return Err(self.err("comments must be separated from other tokens by whitespace"))
      }
      self.skip_blank()
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if self.col > 0 && self.next_is_bom() {
    return Err(self.err("a byte order mark must not appear inside a document"))
  }
  Ok((encountered_tab, has_yaml_ws))
}

///|
fn Scanner::skip_yaml_whitespace(self : Scanner) -> Result[Unit, YamlError] {
  let mut need_ws = true
  while true {
    let b = self.peek_b()
    if b == 32 {
      self.skip_blank()
      need_ws = false
    } else if b == 10 || b == 13 {
      self.skip_linebreak()
      if self.flow_level == 0 {
        self.simple_key_allowed = true
      }
      need_ws = false
    } else if b == 35 {
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if need_ws {
    Err(self.err("expected whitespace"))
  } else {
    Ok(())
  }
}

///|
fn Scanner::next_token(self : Scanner) -> Result[Option[Token], YamlError] {
  if self.stream_end_produced {
    return Ok(None)
  }
  if !self.token_available {
    match self.fetch_more_tokens() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  match self.pop_token() {
    None => Err(self.err("did not find expected next token"))
    Some(t) => {
      self.token_available = false
      self.tokens_parsed = self.tokens_parsed + 1
      match t.kind {
        TokenKind::StreamEnd => self.stream_end_produced = true
        _ => ()
      }
      Ok(Some(t))
    }
  }
}

///|
fn Scanner::fetch_more_tokens(self : Scanner) -> Result[Unit, YamlError] {
  while true {
    let mut need_more = false
    if self.tokens_len() == 0 {
      need_more = true
    } else {
      match self.stale_simple_keys() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let mut i = 0
      let n = self.simple_keys.length()
      while i < n {
        let sk = self.simple_keys[i]
        if sk.possible && sk.token_number == self.tokens_parsed {
          need_more = true
          break
        }
        i = i + 1
      }
    }
    if !need_more {
      break
    }
    match self.fetch_next_token() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  self.token_available = true
  Ok(())
}

///|
fn Scanner::stale_simple_keys(self : Scanner) -> Result[Unit, YamlError] {
  let mut i = 0
  let n = self.simple_keys.length()
  while i < n {
    let sk = self.simple_keys[i]
    if sk.possible && self.flow_level == 0 && (sk.mark.line < self.line || sk.mark.index + 1024 < self.index) {
      if sk.required {
        return Err(self.err("simple key expects ':'"))
      }
      sk.possible = false
    }
    i = i + 1
  }
  Ok(())
}

///|
fn Scanner::skip_to_next_token(self : Scanner) -> Result[Unit, YamlError] {
  while true {
    let b = self.peek_b()
    if b == 9 && self.indents.length() > 0 && self.leading_whitespace && self.col < self.indent {
      match self.skip_ws_to_eol(true) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if !is_breakz(self.peek_b()) {
        return Err(self.err("tabs disallowed within block indentation"))
      }
    } else if b == 9 || b == 32 {
      self.skip_blank()
    } else if b == 10 || b == 13 {
      self.skip_linebreak()
      if self.flow_level == 0 {
        self.simple_key_allowed = true
      }
    } else if b == 35 {
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if self.has_interrupted_plain {
    self.has_interrupted_plain = false
    let err_mark = self.interrupted_plain_mark
    let is_immediate_next_line = self.line == err_mark.line + 1
    if self.flow_level == 0 &&
    is_immediate_next_line &&
    self.col > self.indent &&
    !is_eof(self.peek_b()) &&
    self.peek_b() != 0 &&
    !self.next_is_doc_indicator() &&
    self.next_can_be_plain_scalar(false) {
      return Err(err_at(err_mark, "comment intercepting multiline plain scalar"))
    }
  }
  Ok(())
}

///|
fn Scanner::fetch_next_token(self : Scanner) -> Result[Unit, YamlError] {
  if !self.stream_start_produced {
    let m = self.mark()
    self.indent = -1
    self.stream_start_produced = true
    self.simple_key_allowed = true
    self.push_token(Token::empty(m, TokenKind::StreamStart))
    self.simple_keys.push(SimpleKey::new(Marker::new(0, 0, 0)))
    return Ok(())
  }

  match self.skip_to_next_token() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.stale_simple_keys() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.unroll_indent(self.col)

  let b = self.peek_b()
  if b <= 0 {
    if b == 0 {
      return Err(self.err("found unprintable NUL character"))
    }
    return self.fetch_stream_end()
  }

  if b == 0xEF && self.next_is_bom() {
    if self.col == 0 && self.flow_level == 0 {
      return self.fetch_bom()
    }
    return Err(self.err("a byte order mark must not appear inside a document"))
  }

  if self.col == 0 {
    if b == 37 {
      return self.fetch_directive()
    } else if self.next_is_doc_start() {
      return self.fetch_document_indicator(TokenKind::DocumentStart)
    } else if self.next_is_doc_end() {
      match self.fetch_document_indicator(TokenKind::DocumentEnd) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.skip_ws_to_eol(true) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if !is_breakz(self.peek_b()) {
        return Err(self.err("invalid content after document end marker"))
      }
      return Ok(())
    }
  }

  if self.col < self.indent {
    return Err(self.err("invalid indentation"))
  }

  let nb = self.peek_b_at(1)
  if b == 91 {
    self.fetch_flow_collection_start(TokenKind::FlowSequenceStart, false)
  } else if b == 123 {
    self.fetch_flow_collection_start(TokenKind::FlowMappingStart, true)
  } else if b == 93 {
    self.fetch_flow_collection_end(TokenKind::FlowSequenceEnd, true)
  } else if b == 125 {
    self.fetch_flow_collection_end(TokenKind::FlowMappingEnd, false)
  } else if b == 44 {
    self.fetch_flow_entry()
  } else if b == 45 && is_blank_or_breakz(nb) {
    self.fetch_block_entry()
  } else if b == 63 && is_blank_or_breakz(nb) {
    self.fetch_key()
  } else if b == 58 && is_blank_or_breakz(nb) {
    self.fetch_value()
  } else if b == 58 && self.flow_level > 0 && (is_flow(nb) || self.index == self.adjacent_value_allowed_at) {
    self.fetch_flow_value()
  } else if b == 42 {
    self.fetch_anchor(true)
  } else if b == 38 {
    self.fetch_anchor(false)
  } else if b == 33 {
    self.fetch_tag()
  } else if b == 124 && self.flow_level == 0 {
    self.fetch_block_scalar(true)
  } else if b == 62 && self.flow_level == 0 {
    self.fetch_block_scalar(false)
  } else if b == 39 {
    self.fetch_flow_scalar(true)
  } else if b == 34 {
    self.fetch_flow_scalar(false)
  } else if b == 45 && !is_blank_or_breakz(nb) {
    self.fetch_plain_scalar()
  } else if (b == 58 || b == 63) && !is_blank_or_breakz(nb) && self.flow_level == 0 {
    self.fetch_plain_scalar()
  } else if b == 37 || b == 64 || b == 96 {
    Err(self.err("unexpected reserved indicator character"))
  } else {
    self.fetch_plain_scalar()
  }
}

///|
fn Scanner::fetch_stream_end(self : Scanner) -> Result[Unit, YamlError] {
  if self.col != 0 {
    self.col = 0
    self.line = self.line + 1
  }
  let mut i = 0
  let n = self.simple_keys.length()
  while i < n {
    let sk = self.simple_keys[i]
    if sk.required && sk.possible {
      return Err(self.err("simple key expected"))
    }
    sk.possible = false
    i = i + 1
  }
  self.unroll_indent(-1)
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = false
  self.push_token(Token::empty(self.mark(), TokenKind::StreamEnd))
  Ok(())
}

///|
fn Scanner::fetch_bom(self : Scanner) -> Result[Unit, YamlError] {
  self.unroll_indent(-1)
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let m = self.mark()
  self.pos = self.pos + 3
  self.index = self.index + 1
  self.simple_key_allowed = true
  self.push_token(Token::new(m, self.mark(), TokenKind::ByteOrderMark))
  Ok(())
}

///|
fn Scanner::fetch_document_indicator(self : Scanner, kind : TokenKind) -> Result[Unit, YamlError] {
  self.unroll_indent(-1)
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = false
  let m = self.mark()
  self.skip_n_ascii_non_blank(3)
  self.push_token(Token::new(m, self.mark(), kind))
  Ok(())
}

///|
fn Scanner::fetch_directive(self : Scanner) -> Result[Unit, YamlError] {
  self.unroll_indent(-1)
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = false
  match self.scan_directive() {
    Ok(tok) => {
      self.push_token(tok)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///|
fn Scanner::scan_directive(self : Scanner) -> Result[Token, YamlError] {
  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  let name_start = self.pos
  while self.next_is_yaml_non_space() {
    self.skip_char_non_blank()
  }
  let name = self.src.slice(name_start, self.pos)
  if name.length() == 0 {
    return Err(err_at(start_mark, "while scanning a directive, could not find expected directive name"))
  }
  if !is_blank_or_breakz(self.peek_b()) {
    return Err(err_at(start_mark, "while scanning a directive, found unexpected character"))
  }

  let tok = if name == "YAML" {
    match self.scan_version_directive_value(start_mark) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
  } else if name == "TAG" {
    match self.scan_tag_directive_value(start_mark) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
  } else {
    while is_blank(self.peek_b()) {
      while is_blank(self.peek_b()) {
        self.skip_blank()
      }
      if !is_blank_or_breakz(self.peek_b()) {
        while self.next_is_yaml_non_space() {
          self.skip_char_non_blank()
        }
      }
    }
    Token::new(start_mark, self.mark(), TokenKind::ReservedDirective(name))
  }

  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if is_breakz(self.peek_b()) {
    self.skip_linebreak()
    Ok(tok)
  } else {
    Err(err_at(start_mark, "while scanning a directive, did not find expected comment or line break"))
  }
}

///|
fn Scanner::scan_version_directive_number(self : Scanner, mark : Marker) -> Result[Int, YamlError] {
  let mut v = 0
  let mut count = 0
  while is_digit(self.peek_b()) {
    if count + 1 > 9 {
      return Err(err_at(mark, "while scanning a YAML directive, found extremely long version number"))
    }
    v = v * 10 + (self.peek_b() - 48)
    count = count + 1
    self.skip_ascii_non_blank()
  }
  if count == 0 {
    return Err(err_at(mark, "while scanning a YAML directive, did not find expected version number"))
  }
  Ok(v)
}

///|
fn Scanner::scan_version_directive_value(self : Scanner, mark : Marker) -> Result[Token, YamlError] {
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let major = match self.scan_version_directive_number(mark) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if self.peek_b() != 46 {
    return Err(err_at(mark, "while scanning a YAML directive, expected '.'"))
  }
  self.skip_ascii_non_blank()
  let minor = match self.scan_version_directive_number(mark) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(Token::new(mark, self.mark(), TokenKind::VersionDirective(major, minor)))
}

///|
fn Scanner::scan_tag_directive_value(self : Scanner, mark : Marker) -> Result[Token, YamlError] {
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let handle = match self.scan_tag_handle(true, mark) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let prefix = match self.scan_tag_prefix(mark) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if is_blank_or_breakz(self.peek_b()) {
    Ok(Token::new(mark, self.mark(), TokenKind::TagDirective(handle, prefix)))
  } else {
    Err(err_at(mark, "while scanning TAG directive, expected whitespace or line break"))
  }
}

///|
fn Scanner::fetch_tag(self : Scanner) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.simple_key_allowed = false
  match self.scan_tag() {
    Ok(tok) => {
      self.push_token(tok)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///|
fn Scanner::scan_tag(self : Scanner) -> Result[Token, YamlError] {
  let start_mark = self.mark()
  let mut handle = ""
  let mut suffix = ""

  if self.peek_b_at(1) == 60 {
    suffix = match self.scan_verbatim_tag(start_mark) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  } else {
    handle = match self.scan_tag_handle(false, start_mark) {
      Ok(h) => h
      Err(e) => return Err(e)
    }
    let hlen = handle.length()
    if hlen >= 2 && handle.code_unit_at(0) == 33 && handle.code_unit_at(hlen - 1) == 33 {
      suffix = match self.scan_tag_shorthand_suffix("", start_mark) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
    } else {
      suffix = match self.scan_tag_shorthand_suffix(handle, start_mark) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      handle = "!"
      if suffix.length() == 0 {
        handle = ""
        suffix = "!"
      }
    }
  }

  let b = self.peek_b()
  if is_blank_or_breakz(b) || (self.flow_level > 0 && is_flow(b)) {
    Ok(Token::new(start_mark, self.mark(), TokenKind::Tag(handle, suffix)))
  } else {
    Err(err_at(start_mark, "while scanning a tag, did not find expected whitespace or line break"))
  }
}

///|
fn Scanner::scan_tag_handle(self : Scanner, directive : Bool, mark : Marker) -> Result[String, YamlError] {
  if self.peek_b() != 33 {
    return Err(err_at(mark, "while scanning a tag, expected '!'"))
  }
  let start_pos = self.pos
  self.skip_ascii_non_blank()
  while is_word_char(self.peek_b()) {
    self.skip_ascii_non_blank()
  }
  if self.peek_b() == 33 {
    self.skip_ascii_non_blank()
  } else if directive && self.pos - start_pos != 1 {
    return Err(err_at(mark, "while parsing a tag directive, expected '!'"))
  }
  Ok(self.src.slice(start_pos, self.pos))
}

///|
fn Scanner::scan_tag_prefix(self : Scanner, start_mark : Marker) -> Result[String, YamlError] {
  let sb = StringBuilder::new()
  let b = self.peek_b()
  if b == 33 {
    sb.write_byte(33.to_byte())
    self.skip_ascii_non_blank()
  } else if !is_tag_char(b) {
    return Err(err_at(start_mark, "invalid global tag character"))
  } else if b == 37 {
    match self.scan_uri_escapes(sb, start_mark) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  } else {
    sb.write_byte(b.to_byte())
    self.skip_ascii_non_blank()
  }

  while is_uri_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      match self.scan_uri_escapes(sb, start_mark) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
  }
  Ok(sb.to_string())
}

///|
fn Scanner::scan_verbatim_tag(self : Scanner, start_mark : Marker) -> Result[String, YamlError] {
  self.skip_n_ascii_non_blank(2)
  let sb = StringBuilder::new()
  while is_uri_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      match self.scan_uri_escapes(sb, start_mark) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
  }
  if self.peek_b() != 62 {
    return Err(err_at(start_mark, "while scanning a verbatim tag, expected '>'"))
  }
  self.skip_ascii_non_blank()
  Ok(sb.to_string())
}

///|
fn Scanner::scan_tag_shorthand_suffix(self : Scanner, head : String, mark : Marker) -> Result[String, YamlError] {
  let mut length = head.length()
  let sb = StringBuilder::new()
  if length > 1 {
    sb.write_string(head.slice(1, length))
  }
  while is_tag_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      match self.scan_uri_escapes(sb, mark) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
    length = length + 1
  }
  if length == 0 {
    return Err(err_at(mark, "while parsing a tag, did not find expected tag URI"))
  }
  Ok(sb.to_string())
}

///|
fn Scanner::scan_uri_escapes(self : Scanner, sb : StringBuilder, mark : Marker) -> Result[Unit, YamlError] {
  let mut width = 0
  let bytes : Array[Int] = []
  while true {
    let b0 = self.peek_b()
    let b1 = self.peek_b_at(1)
    let b2 = self.peek_b_at(2)
    if !(b0 == 37 && is_hex(b1) && is_hex(b2)) {
      return Err(err_at(mark, "while parsing a tag, found an invalid escape sequence"))
    }
    let byte = (as_hex(b1) << 4) | as_hex(b2)
    if width == 0 {
      if (byte & 0x80) == 0x00 {
        width = 1
      } else if (byte & 0xE0) == 0xC0 {
        width = 2
      } else if (byte & 0xF0) == 0xE0 {
        width = 3
      } else if (byte & 0xF8) == 0xF0 {
        width = 4
      } else {
        return Err(err_at(mark, "while parsing a tag, invalid leading UTF-8 byte"))
      }
    } else if (byte & 0xC0) != 0x80 {
      return Err(err_at(mark, "while parsing a tag, invalid trailing UTF-8 byte"))
    }
    bytes.push(byte)
    self.skip_n_ascii_non_blank(3)
    width = width - 1
    if width == 0 {
      break
    }
  }
  let mut i = 0
  let n = bytes.length()
  while i < n {
    sb.write_byte(bytes[i].to_byte())
    i = i + 1
  }
  Ok(())
}

///|
fn Scanner::fetch_anchor(self : Scanner, alias : Bool) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.simple_key_allowed = false
  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  let name_start = self.pos
  while self.next_is_yaml_non_space() && !is_flow(self.peek_b()) {
    self.skip_char_non_blank()
  }
  if self.pos == name_start {
    return Err(err_at(start_mark, "while scanning an anchor or alias, expected name"))
  }
  let name = self.src.slice(name_start, self.pos)
  let kind = if alias { TokenKind::Alias(name) } else { TokenKind::Anchor(name) }
  self.push_token(Token::new(start_mark, self.mark(), kind))
  Ok(())
}

///|
fn Scanner::fetch_flow_collection_start(self : Scanner, kind : TokenKind, is_mapping : Bool) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.roll_one_col_indent()
  match self.increase_flow_level() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = true

  let start_mark = self.mark()
  self.skip_ascii_non_blank()

  self.flow_mapping_started.push(is_mapping)
  self.implicit_flow_mapping_states.push(if is_mapping { implicit_none() } else { implicit_possible() })

  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.push_token(Token::new(start_mark, self.mark(), kind))
  Ok(())
}

///|
fn Scanner::fetch_flow_collection_end(self : Scanner, kind : TokenKind, is_seq_end : Bool) -> Result[Unit, YamlError] {
  if self.flow_level == 0 {
    return Err(self.err("misplaced closing bracket"))
  }
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.decrease_flow_level()
  self.simple_key_allowed = false

  if is_seq_end {
    self.end_implicit_mapping(self.mark())
  }
  let _ = self.implicit_flow_mapping_states.pop()
  let _ = self.flow_mapping_started.pop()

  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.flow_level > 0 {
    self.adjacent_value_allowed_at = self.index
  }
  self.push_token(Token::new(start_mark, self.mark(), kind))
  Ok(())
}

///|
fn Scanner::fetch_flow_entry(self : Scanner) -> Result[Unit, YamlError] {
  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = true
  self.end_implicit_mapping(self.mark())

  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.push_token(Token::new(start_mark, self.mark(), TokenKind::FlowEntry))
  Ok(())
}

///|
fn Scanner::increase_flow_level(self : Scanner) -> Result[Unit, YamlError] {
  if self.flow_level >= 255 {
    return Err(self.err("flow nesting limit exceeded"))
  }
  self.simple_keys.push(SimpleKey::new(Marker::new(0, 0, 0)))
  self.flow_level = self.flow_level + 1
  Ok(())
}

///|
fn Scanner::decrease_flow_level(self : Scanner) -> Unit {
  if self.flow_level > 0 {
    self.flow_level = self.flow_level - 1
    let _ = self.simple_keys.pop()
  }
}

///|
fn Scanner::fetch_block_entry(self : Scanner) -> Result[Unit, YamlError] {
  if self.flow_level > 0 {
    return Err(self.err("'-' is only valid inside a block"))
  }
  if !self.simple_key_allowed {
    return Err(self.err("block sequence entries are not allowed in this context"))
  }
  match self.last_token() {
    Some(tok) => {
      let is_prop = match tok.kind {
        TokenKind::Anchor(_) => true
        TokenKind::Tag(_, _) => true
        _ => false
      }
      if is_prop && self.col == 0 && tok.start.col == 0 && self.indent > -1 {
        return Err(err_at(tok.start, "invalid indentation for anchor or tag"))
      }
    }
    None => ()
  }

  let mark = self.mark()
  self.skip_ascii_non_blank()

  self.roll_indent(mark.col, -1, TokenKind::BlockSequenceStart, mark)
  let found_tabs = match self.skip_ws_to_eol(true) {
    Ok((ft, _)) => ft
    Err(e) => return Err(e)
  }
  if found_tabs && self.peek_b() == 45 && is_blank_or_breakz(self.peek_b_at(1)) {
    return Err(self.err("'-' must be followed by valid YAML whitespace"))
  }
  match self.skip_ws_to_eol(false) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let nb = self.peek_b()
  if is_break(nb) || is_flow(nb) {
    self.roll_one_col_indent()
  }

  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = true
  self.push_token(Token::empty(self.mark(), TokenKind::BlockEntry))
  Ok(())
}

///|
fn Scanner::fetch_block_scalar(self : Scanner, literal : Bool) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.simple_key_allowed = true
  match self.scan_block_scalar(literal) {
    Ok(tok) => {
      self.push_token(tok)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///|
fn Scanner::scan_block_scalar(self : Scanner, literal : Bool) -> Result[Token, YamlError] {
  let start_mark = self.mark()
  let mut chomping = chomp_clip()
  let mut increment = 0
  let mut block_indent = 0
  let mut leading_blank = false
  let style = if literal { ScalarStyle::Literal } else { ScalarStyle::Folded }

  let sb = StringBuilder::new()
  let mut leading_break = StringBuilder::new()
  let mut has_leading_break = false
  let mut trailing_breaks = StringBuilder::new()
  let mut has_trailing_breaks = false

  self.skip_ascii_non_blank()
  self.unroll_non_block_indents()

  let b0 = self.peek_b()
  if b0 == 43 || b0 == 45 {
    chomping = if b0 == 43 { chomp_keep() } else { chomp_strip() }
    self.skip_ascii_non_blank()
    if is_digit(self.peek_b()) {
      if self.peek_b() == 48 {
        return Err(err_at(start_mark, "block scalar indentation indicator cannot be 0"))
      }
      increment = self.peek_b() - 48
      self.skip_ascii_non_blank()
    }
  } else if is_digit(b0) {
    if b0 == 48 {
      return Err(err_at(start_mark, "block scalar indentation indicator cannot be 0"))
    }
    increment = b0 - 48
    self.skip_ascii_non_blank()
    let b1 = self.peek_b()
    if b1 == 43 || b1 == 45 {
      chomping = if b1 == 43 { chomp_keep() } else { chomp_strip() }
      self.skip_ascii_non_blank()
    }
  }

  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if !is_breakz(self.peek_b()) {
    return Err(err_at(start_mark, "while scanning a block scalar, expected comment or line break"))
  }
  if is_break(self.peek_b()) {
    self.skip_linebreak()
  }
  if self.peek_b() == 9 {
    return Err(err_at(start_mark, "a block scalar content cannot start with a tab"))
  }

  if increment > 0 {
    block_indent = if self.indent >= 0 { self.indent + increment } else { increment }
  }

  if block_indent == 0 {
    let (ind, has_tb) = self.skip_block_scalar_first_line_indent(trailing_breaks)
    block_indent = ind
    has_trailing_breaks = has_tb
  } else {
    has_trailing_breaks = self.skip_block_scalar_indent(block_indent, trailing_breaks)
  }

  if is_eof(self.peek_b()) || self.peek_b() == 0 {
    let contents = if chomping == chomp_keep() {
      if !has_trailing_breaks && self.line > start_mark.line && self.col > 0 {
        "\n"
      } else {
        trailing_breaks.to_string()
      }
    } else {
      ""
    }
    return Ok(Token::new(start_mark, self.mark(), TokenKind::Scalar(style, contents)))
  }

  if self.col < block_indent && self.col > self.indent {
    return Err(self.err("wrongly indented line in block scalar"))
  }

  while self.col == block_indent && self.next_is_yaml_non_break() {
    if block_indent == 0 && self.next_is_doc_indicator() {
      break
    }

    let trailing_blank = is_blank(self.peek_b())
    if !literal && has_leading_break && !leading_blank && !trailing_blank {
      if has_trailing_breaks {
        sb.write_string(trailing_breaks.to_string())
      } else {
        sb.write_byte(32.to_byte())
      }
    } else {
      if has_leading_break {
        sb.write_string(leading_break.to_string())
      }
      if has_trailing_breaks {
        sb.write_string(trailing_breaks.to_string())
      }
    }
    leading_break = StringBuilder::new()
    has_leading_break = false
    trailing_breaks = StringBuilder::new()
    has_trailing_breaks = false

    leading_blank = is_blank(self.peek_b())

    let line_start = self.pos
    while self.next_is_yaml_non_break() {
      self.skip_char_non_blank()
    }
    if self.pos > line_start {
      sb.write_string(self.src.slice(line_start, self.pos))
    }

    if !is_break(self.peek_b()) {
      break
    }
    self.read_break(leading_break)
    has_leading_break = true

    has_trailing_breaks = self.skip_block_scalar_indent(block_indent, trailing_breaks)
  }

  if chomping != chomp_strip() {
    if has_leading_break {
      sb.write_string(leading_break.to_string())
    }
    let min_col = if block_indent > 1 { block_indent } else { 1 }
    if (is_eof(self.peek_b()) || self.peek_b() == 0) && self.col >= min_col {
      sb.write_byte(10.to_byte())
    }
  }
  if chomping == chomp_keep() && has_trailing_breaks {
    sb.write_string(trailing_breaks.to_string())
  }

  Ok(Token::new(start_mark, self.mark(), TokenKind::Scalar(style, sb.to_string())))
}

///|
fn Scanner::skip_block_scalar_indent(self : Scanner, block_indent : Int, breaks : StringBuilder) -> Bool {
  let mut has_breaks = false
  while true {
    while self.col < block_indent && self.peek_b() == 32 {
      self.skip_blank()
    }
    if is_break(self.peek_b()) {
      self.read_break(breaks)
      has_breaks = true
    } else {
      break
    }
  }
  has_breaks
}

///|
fn Scanner::skip_block_scalar_first_line_indent(self : Scanner, breaks : StringBuilder) -> (Int, Bool) {
  let mut max_indent = 0
  let mut has_breaks = false
  while true {
    while self.peek_b() == 32 {
      self.skip_blank()
    }
    if self.col > max_indent {
      max_indent = self.col
    }
    if is_break(self.peek_b()) {
      self.read_break(breaks)
      has_breaks = true
    } else {
      break
    }
  }
  let min_ind = self.indent + 1
  let mut ind = if max_indent > min_ind { max_indent } else { min_ind }
  if self.indent > 0 && ind < 1 {
    ind = 1
  }
  (ind, has_breaks)
}

///|
fn Scanner::fetch_flow_scalar(self : Scanner, single : Bool) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.simple_key_allowed = false
  let tok = match self.scan_flow_scalar(single) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match self.skip_to_next_token() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.adjacent_value_allowed_at = self.index
  self.push_token(tok)
  Ok(())
}

///|
fn Scanner::scan_flow_scalar(self : Scanner, single : Bool) -> Result[Token, YamlError] {
  let start_mark = self.mark()
  let style = if single { ScalarStyle::SingleQuoted } else { ScalarStyle::DoubleQuoted }

  // Eat opening quote
  self.skip_ascii_non_blank()

  // Fast path: single-line quoted scalar with no escapes / no doubled single-quotes
  let fast_start = self.pos
  let fast_index = self.index
  let fast_col = self.col
  let quote_b = if single { 39 } else { 34 }
  let mut fast_ok = true
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == quote_b {
      if single && self.peek_b_at(1) == 39 {
        fast_ok = false
        break
      }
      let content = self.src.slice(fast_start, self.pos)
      self.skip_ascii_non_blank()
      match self.check_trailing_after_quoted(start_mark) {
        Ok(_) => return Ok(Token::new(start_mark, self.mark(), TokenKind::Scalar(style, content)))
        Err(e) => return Err(e)
      }
    } else if b == 10 || b == 13 || b == 0 || (!single && b == 92) {
      fast_ok = false
      break
    } else if b < 0x80 {
      self.pos = self.pos + 1
      self.index = self.index + 1
      self.col = self.col + 1
    } else {
      self.skip_char_non_blank()
    }
  }
  // Restore to after opening quote if fast path didn't finish
  let _ = fast_ok
  self.pos = fast_start
  self.index = fast_index
  self.col = fast_col

  let sb = StringBuilder::new()
  let mut leading_break = StringBuilder::new()
  let mut has_leading_break = false
  let mut trailing_breaks = StringBuilder::new()
  let mut has_trailing_breaks = false
  let mut whitespaces = StringBuilder::new()
  let mut has_whitespaces = false

  while true {
    if self.col == 0 && self.next_is_doc_indicator() {
      return Err(err_at(start_mark, "while scanning a quoted scalar, found unexpected document indicator"))
    }
    if is_eof(self.peek_b()) || self.peek_b() == 0 {
      return Err(err_at(start_mark, "while scanning a quoted scalar, found unexpected end of stream"))
    }
    if self.col < self.indent {
      return Err(err_at(start_mark, "invalid indentation in quoted scalar"))
    }

    let mut leading_blanks = false
    while !is_blank_or_breakz(self.peek_b()) {
      let b = self.peek_b()
      if single && b == 39 && self.peek_b_at(1) == 39 {
        sb.write_byte(39.to_byte())
        self.skip_n_ascii_non_blank(2)
      } else if (single && b == 39) || (!single && b == 34) {
        break
      } else if !single && b == 92 && is_break(self.peek_b_at(1)) {
        self.skip_ascii_non_blank()
        self.skip_linebreak()
        leading_blanks = true
        break
      } else if !single && b == 92 {
        match self.resolve_escape_sequence(sb, start_mark) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else {
        let cs = self.pos
        self.skip_char_non_blank()
        sb.write_string(self.src.slice(cs, self.pos))
      }
    }

    let cb = self.peek_b()
    if (single && cb == 39) || (!single && cb == 34) {
      break
    }

    while is_blank_or_break(self.peek_b()) {
      let wb = self.peek_b()
      if is_blank(wb) {
        if leading_blanks {
          if wb == 9 && self.col < self.indent {
            return Err(self.err("tab cannot be used as indentation"))
          }
          self.skip_blank()
        } else {
          whitespaces.write_byte(wb.to_byte())
          has_whitespaces = true
          self.skip_blank()
        }
      } else {
        if leading_blanks {
          self.read_break(trailing_breaks)
          has_trailing_breaks = true
        } else {
          whitespaces = StringBuilder::new()
          has_whitespaces = false
          self.read_break(leading_break)
          has_leading_break = true
          leading_blanks = true
        }
      }
    }

    if leading_blanks {
      if !has_leading_break {
        if has_trailing_breaks {
          sb.write_string(trailing_breaks.to_string())
          trailing_breaks = StringBuilder::new()
          has_trailing_breaks = false
        }
      } else {
        if !has_trailing_breaks {
          sb.write_byte(32.to_byte())
        } else {
          sb.write_string(trailing_breaks.to_string())
          trailing_breaks = StringBuilder::new()
          has_trailing_breaks = false
        }
        leading_break = StringBuilder::new()
        has_leading_break = false
      }
    } else if has_whitespaces {
      sb.write_string(whitespaces.to_string())
      whitespaces = StringBuilder::new()
      has_whitespaces = false
    }
  }

  // Eat closing quote
  self.skip_ascii_non_blank()
  match self.check_trailing_after_quoted(start_mark) {
    Ok(_) => Ok(Token::new(start_mark, self.mark(), TokenKind::Scalar(style, sb.to_string())))
    Err(e) => Err(e)
  }
}

///|
fn Scanner::check_trailing_after_quoted(self : Scanner, start_mark : Marker) -> Result[Unit, YamlError] {
  match self.skip_ws_to_eol(true) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let b = self.peek_b()
  if self.flow_level > 0 && (b == 44 || b == 125 || b == 93) {
    Ok(())
  } else if is_breakz(b) {
    Ok(())
  } else if b == 58 && self.flow_level == 0 && start_mark.line == self.line {
    Ok(())
  } else if b == 58 && self.flow_level > 0 {
    Ok(())
  } else {
    Err(self.err("invalid trailing content after quoted scalar"))
  }
}

///|
fn Scanner::resolve_escape_sequence(self : Scanner, sb : StringBuilder, start_mark : Marker) -> Result[Unit, YamlError] {
  let esc = self.peek_b_at(1)
  let mut code_len = 0
  if esc == 48 {
    sb.write_byte(0.to_byte())
  } else if esc == 97 {
    sb.write_byte(7.to_byte())
  } else if esc == 98 {
    sb.write_byte(8.to_byte())
  } else if esc == 116 || esc == 9 {
    sb.write_byte(9.to_byte())
  } else if esc == 110 {
    sb.write_byte(10.to_byte())
  } else if esc == 118 {
    sb.write_byte(11.to_byte())
  } else if esc == 102 {
    sb.write_byte(12.to_byte())
  } else if esc == 114 {
    sb.write_byte(13.to_byte())
  } else if esc == 101 {
    sb.write_byte(27.to_byte())
  } else if esc == 32 {
    sb.write_byte(32.to_byte())
  } else if esc == 34 {
    sb.write_byte(34.to_byte())
  } else if esc == 47 {
    sb.write_byte(47.to_byte())
  } else if esc == 92 {
    sb.write_byte(92.to_byte())
  } else if esc == 78 {
    write_utf8_cp(sb, 0x85)
  } else if esc == 95 {
    write_utf8_cp(sb, 0xA0)
  } else if esc == 76 {
    write_utf8_cp(sb, 0x2028)
  } else if esc == 80 {
    write_utf8_cp(sb, 0x2029)
  } else if esc == 120 {
    code_len = 2
  } else if esc == 117 {
    code_len = 4
  } else if esc == 85 {
    code_len = 8
  } else {
    return Err(err_at(start_mark, "while parsing a quoted scalar, found unknown escape character"))
  }
  self.skip_n_ascii_non_blank(2)

  if code_len > 0 {
    let mut cp = 0
    let mut i = 0
    while i < code_len {
      let hb = self.peek_b_at(i)
      if !is_hex(hb) {
        return Err(err_at(start_mark, "while parsing a quoted scalar, expected hex digit in escape"))
      }
      cp = (cp << 4) | as_hex(hb)
      i = i + 1
    }
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(err_at(start_mark, "while parsing a quoted scalar, invalid Unicode scalar value"))
    }
    write_utf8_cp(sb, cp)
    self.skip_n_ascii_non_blank(code_len)
  }
  Ok(())
}

///|
fn Scanner::fetch_plain_scalar(self : Scanner) -> Result[Unit, YamlError] {
  self.save_simple_key()
  self.simple_key_allowed = false
  match self.scan_plain_scalar() {
    Ok(tok) => {
      self.push_token(tok)
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///|
fn Scanner::scan_plain_scalar(self : Scanner) -> Result[Token, YamlError] {
  self.unroll_non_block_indents()
  let plain_indent = self.indent + 1
  let start_mark = self.mark()

  if self.flow_level > 0 && start_mark.col < plain_indent {
    return Err(err_at(start_mark, "invalid indentation in flow construct"))
  }

  let in_flow = self.flow_level > 0

  // Zero-allocation fast path for single-word single-line plain scalars (handles ~90% of keys/values).
  let b0 = self.peek_b()
  if b0 >= 33 && b0 < 0x80 && b0 != 35 && !(in_flow && b0 == 45 && is_flow(self.peek_b_at(1))) &&
  !(self.col == 0 && self.next_is_doc_indicator()) && self.next_can_be_plain_scalar(in_flow) {
    let fast_start = self.pos
    let mut p = self.pos
    let len = self.len
    while p < len {
      let b = self.src.code_unit_at(p)
      if b <= 32 || b >= 0x80 {
        break
      }
      if b == 58 {
        let nb = if p + 1 < len { self.src.code_unit_at(p + 1) } else { -1 }
        if is_blank_or_breakz(nb) || (in_flow && is_flow(nb)) {
          break
        }
      } else if in_flow && is_flow(b) {
        break
      }
      p = p + 1
    }
    if p > fast_start {
      let nb = if p < len { self.src.code_unit_at(p) } else { -1 }
      // If terminated immediately by ':', flow indicator, EOF, or newline followed by dedent/EOF:
      let term_ok = if nb == 58 {
        let nnb = if p + 1 < len { self.src.code_unit_at(p + 1) } else { -1 }
        is_blank_or_breakz(nnb) || (in_flow && is_flow(nnb))
      } else if in_flow && is_flow(nb) {
        true
      } else if nb == 10 && !in_flow {
        // Check if next line has col < plain_indent (so plain scalar definitely ends at this '\n')
        let mut q = p + 1
        let mut next_col = 0
        while q < len && self.src.code_unit_at(q) == 32 {
          q = q + 1
          next_col = next_col + 1
        }
        let qb = if q < len { self.src.code_unit_at(q) } else { -1 }
        if next_col < plain_indent && qb != 10 && qb != 13 && qb != 9 {
          let adv = p - fast_start
          let val_str = self.src.slice(fast_start, p)
          self.pos = q
          self.index = self.index + adv + 1 + next_col
          self.line = self.line + 1
          self.col = next_col
          self.leading_whitespace = true
          self.simple_key_allowed = true
          let end_mark = Marker::new(start_mark.index + adv, start_mark.line, start_mark.col + adv)
          return Ok(Token::new(start_mark, end_mark, TokenKind::Scalar(ScalarStyle::Plain, val_str)))
        }
        false
      } else if nb < 0 {
        true
      } else {
        false
      }
      if term_ok {
        let adv = p - fast_start
        self.pos = p
        self.index = self.index + adv
        self.col = self.col + adv
        self.leading_whitespace = false
        let end_mark = self.mark()
        return Ok(Token::new(start_mark, end_mark, TokenKind::Scalar(ScalarStyle::Plain, self.src.slice(fast_start, p))))
      }
    }
  }

  let sb = StringBuilder::new()
  let mut has_content = false
  let mut single_slice_start = -1
  let mut single_slice_end = -1
  let mut use_sb = false

  let mut whitespaces = StringBuilder::new()
  let mut has_whitespaces = false
  let mut leading_break = StringBuilder::new()
  let mut has_leading_break = false
  let mut trailing_breaks = StringBuilder::new()
  let mut has_trailing_breaks = false
  let mut end_mark = self.mark()

  while true {
    if (self.col == 0 && self.next_is_doc_indicator()) || self.peek_b() == 35 {
      if self.peek_b() == 35 && has_content && has_whitespaces && !in_flow {
        self.has_interrupted_plain = true
        self.interrupted_plain_mark = self.mark()
      }
      break
    }

    if in_flow && self.peek_b() == 45 && is_flow(self.peek_b_at(1)) {
      return Err(self.err("plain scalar cannot start with '-' followed by flow indicator"))
    }

    if !is_blank_or_breakz(self.peek_b()) && self.next_can_be_plain_scalar(in_flow) {
      if self.leading_whitespace {
        if !use_sb && has_content {
          sb.write_string(self.src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        if !has_leading_break {
          if has_trailing_breaks {
            sb.write_string(trailing_breaks.to_string())
            trailing_breaks = StringBuilder::new()
            has_trailing_breaks = false
          }
        } else {
          if !has_trailing_breaks {
            sb.write_byte(32.to_byte())
          } else {
            sb.write_string(trailing_breaks.to_string())
            trailing_breaks = StringBuilder::new()
            has_trailing_breaks = false
          }
          leading_break = StringBuilder::new()
          has_leading_break = false
        }
        self.leading_whitespace = false
      } else if has_whitespaces {
        if !use_sb && has_content {
          sb.write_string(self.src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        sb.write_string(whitespaces.to_string())
        whitespaces = StringBuilder::new()
        has_whitespaces = false
      }

      let seg_start = self.pos
      while !is_blank_or_breakz(self.peek_b()) && self.next_can_be_plain_scalar(in_flow) {
        let b = self.peek_b()
        if b < 0x80 {
          self.pos = self.pos + 1
          self.index = self.index + 1
          self.col = self.col + 1
          self.leading_whitespace = false
        } else {
          self.skip_char_non_blank()
        }
      }
      if !has_content {
        single_slice_start = seg_start
        single_slice_end = self.pos
        has_content = true
      } else {
        if !use_sb {
          sb.write_string(self.src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        sb.write_string(self.src.slice(seg_start, self.pos))
      }
      end_mark = self.mark()
    }

    if !is_blank_or_break(self.peek_b()) {
      break
    }

    while is_blank_or_break(self.peek_b()) {
      let wb = self.peek_b()
      if is_blank(wb) {
        if !self.leading_whitespace {
          whitespaces.write_byte(wb.to_byte())
          has_whitespaces = true
          self.skip_blank()
        } else if self.col < plain_indent && wb == 9 {
          match self.skip_ws_to_eol(true) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          if !is_breakz(self.peek_b()) {
            return Err(err_at(start_mark, "while scanning a plain scalar, found a tab in indentation"))
          }
        } else {
          self.skip_blank()
        }
      } else {
        if self.leading_whitespace {
          self.read_break(trailing_breaks)
          has_trailing_breaks = true
        } else {
          whitespaces = StringBuilder::new()
          has_whitespaces = false
          self.read_break(leading_break)
          has_leading_break = true
          self.leading_whitespace = true
        }
      }
    }

    if !in_flow && self.col < plain_indent {
      break
    }
  }

  if self.leading_whitespace {
    self.simple_key_allowed = true
  }

  if !has_content {
    Err(err_at(start_mark, "unexpected end of plain scalar"))
  } else {
    let text = if use_sb { sb.to_string() } else { self.src.slice(single_slice_start, single_slice_end) }
    Ok(Token::new(start_mark, end_mark, TokenKind::Scalar(ScalarStyle::Plain, text)))
  }
}

///|
fn Scanner::fetch_key(self : Scanner) -> Result[Unit, YamlError] {
  let start_mark = self.mark()
  if self.flow_level == 0 {
    if !self.simple_key_allowed {
      return Err(self.err("mapping keys are not allowed in this context"))
    }
    self.roll_indent(start_mark.col, -1, TokenKind::BlockMappingStart, start_mark)
  } else if self.flow_mapping_started.length() > 0 {
    self.flow_mapping_started[self.flow_mapping_started.length() - 1] = true
  }

  match self.remove_simple_key() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.simple_key_allowed = self.flow_level == 0

  self.skip_ascii_non_blank()
  match self.skip_yaml_whitespace() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.peek_b() == 9 {
    return Err(self.err("tabs disallowed in this context"))
  }
  self.push_token(Token::new(start_mark, self.mark(), TokenKind::Key))
  Ok(())
}

///|
fn Scanner::fetch_flow_value(self : Scanner) -> Result[Unit, YamlError] {
  let nb = self.peek_b_at(1)
  if self.index != self.adjacent_value_allowed_at && (nb == 91 || nb == 123) {
    return Err(self.err("':' may not precede '[' or '{' without space in flow mapping"))
  }
  self.fetch_value()
}

///|
fn Scanner::fetch_value(self : Scanner) -> Result[Unit, YamlError] {
  if self.simple_keys.length() == 0 {
    return Err(self.err("simple key expected"))
  }
  let sk_idx = self.simple_keys.length() - 1
  let sk = self.simple_keys[sk_idx]
  let start_mark = self.mark()

  let mut is_implicit_flow_mapping = false
  let flen = self.flow_mapping_started.length()
  if flen > 0 && !self.flow_mapping_started[flen - 1] && self.implicit_flow_mapping_states[flen - 1] != implicit_none() {
    self.implicit_flow_mapping_states[flen - 1] = implicit_inside()
    is_implicit_flow_mapping = true
  }

  // Skip ':'
  self.skip_ascii_non_blank()
  if self.peek_b() == 9 {
    let has_ws = match self.skip_ws_to_eol(true) {
      Ok((_, hws)) => hws
      Err(e) => return Err(e)
    }
    let nb = self.peek_b()
    if !has_ws && (nb == 45 || is_alpha_yaml(nb)) {
      return Err(self.err("':' must be followed by valid YAML whitespace"))
    }
  }

  if sk.possible {
    let rel = sk.token_number - self.tokens_parsed
    self.insert_token(rel, Token::empty(sk.mark, TokenKind::Key))
    if is_implicit_flow_mapping {
      if sk.mark.line < start_mark.line {
        return Err(err_at(start_mark, "illegal placement of ':' indicator"))
      }
      self.insert_token(rel, Token::empty(sk.mark, TokenKind::FlowMappingStart))
    }

    self.roll_indent(sk.mark.col, sk.token_number, TokenKind::BlockMappingStart, sk.mark)
    self.roll_one_col_indent()

    self.simple_keys[self.simple_keys.length() - 1].possible = false
    self.simple_key_allowed = false
  } else {
    if is_implicit_flow_mapping {
      self.push_token(Token::empty(start_mark, TokenKind::FlowMappingStart))
    }
    if self.flow_level == 0 {
      if !self.simple_key_allowed {
        return Err(err_at(start_mark, "mapping values are not allowed in this context"))
      }
      self.roll_indent(start_mark.col, -1, TokenKind::BlockMappingStart, start_mark)
    }
    self.roll_one_col_indent()
    self.simple_key_allowed = self.flow_level == 0
  }

  self.push_token(Token::empty(start_mark, TokenKind::Value))
  Ok(())
}

///|
fn Scanner::roll_indent(self : Scanner, col : Int, number : Int, kind : TokenKind, mark : Marker) -> Unit {
  if self.flow_level > 0 {
    return
  }
  if self.indent <= col && self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if !last.needs_block_end {
      self.indent = last.indent
      let _ = self.indents.pop()
    }
  }
  if self.indent < col {
    self.indents.push(IndentEntry::{ indent: self.indent, needs_block_end: true })
    self.indent = col
    let tok = Token::empty(mark, kind)
    if number >= 0 {
      self.insert_token(number - self.tokens_parsed, tok)
    } else {
      self.push_token(tok)
    }
  }
}

///|
fn Scanner::unroll_indent(self : Scanner, col : Int) -> Unit {
  if self.flow_level > 0 {
    return
  }
  while self.indent > col && self.indents.length() > 0 {
    let entry = self.indents[self.indents.length() - 1]
    let _ = self.indents.pop()
    self.indent = entry.indent
    if entry.needs_block_end {
      self.push_token(Token::empty(self.mark(), TokenKind::BlockEnd))
    }
  }
}

///|
fn Scanner::roll_one_col_indent(self : Scanner) -> Unit {
  if self.flow_level == 0 && self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if last.needs_block_end {
      self.indents.push(IndentEntry::{ indent: self.indent, needs_block_end: false })
      self.indent = self.indent + 1
    }
  }
}

///|
fn Scanner::unroll_non_block_indents(self : Scanner) -> Unit {
  while self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if last.needs_block_end {
      break
    }
    self.indent = last.indent
    let _ = self.indents.pop()
  }
}

///|
fn Scanner::save_simple_key(self : Scanner) -> Unit {
  if self.simple_key_allowed {
    let required = self.flow_level == 0 &&
    self.indent == self.col &&
    self.indents.length() > 0 &&
    self.indents[self.indents.length() - 1].needs_block_end
    let sk = SimpleKey::{
      possible: true,
      required: required,
      token_number: self.tokens_parsed + self.tokens_len(),
      mark: self.mark(),
    }
    if self.simple_keys.length() > 0 {
      self.simple_keys[self.simple_keys.length() - 1] = sk
    } else {
      self.simple_keys.push(sk)
    }
  }
}

///|
fn Scanner::remove_simple_key(self : Scanner) -> Result[Unit, YamlError] {
  if self.simple_keys.length() == 0 {
    return Err(self.err("simple key expected"))
  }
  let sk = self.simple_keys[self.simple_keys.length() - 1]
  if sk.possible && sk.required {
    return Err(self.err("simple key expected"))
  }
  sk.possible = false
  Ok(())
}

///|
fn Scanner::end_implicit_mapping(self : Scanner, mark : Marker) -> Unit {
  let n = self.implicit_flow_mapping_states.length()
  if n > 0 && self.implicit_flow_mapping_states[n - 1] == implicit_inside() {
    self.flow_mapping_started[n - 1] = false
    self.implicit_flow_mapping_states[n - 1] = implicit_possible()
    self.push_token(Token::empty(mark, TokenKind::FlowMappingEnd))
  }
}
