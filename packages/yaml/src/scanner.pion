///| Direct UTF-8 byte-indexed YAML 1.2 Scanner.
///| Implements the full YAML 1.2 token grammar (SimpleKey lookahead, indentation stack,
///| block/flow collections, block/flow/plain scalars, directives, tags, anchors, BOM, tab rules).
///| Zero-allocation `val struct` tokens and zero-copy byte-slice scalars on the hot path.

///| Token kind constants.
fn tk_err() -> Int {
  -1
}

///|
fn tk_eof() -> Int {
  -2
}

///|
fn tk_stream_start() -> Int {
  0
}

///|
fn tk_stream_end() -> Int {
  1
}

///|
fn tk_version_directive() -> Int {
  2
}

///|
fn tk_tag_directive() -> Int {
  3
}

///|
fn tk_reserved_directive() -> Int {
  4
}

///|
fn tk_document_start() -> Int {
  5
}

///|
fn tk_document_end() -> Int {
  6
}

///|
fn tk_bom() -> Int {
  7
}

///|
fn tk_block_seq_start() -> Int {
  8
}

///|
fn tk_block_map_start() -> Int {
  9
}

///|
fn tk_block_end() -> Int {
  10
}

///|
fn tk_flow_seq_start() -> Int {
  11
}

///|
fn tk_flow_seq_end() -> Int {
  12
}

///|
fn tk_flow_map_start() -> Int {
  13
}

///|
fn tk_flow_map_end() -> Int {
  14
}

///|
fn tk_block_entry() -> Int {
  15
}

///|
fn tk_flow_entry() -> Int {
  16
}

///|
fn tk_key() -> Int {
  17
}

///|
fn tk_value() -> Int {
  18
}

///|
fn tk_alias() -> Int {
  19
}

///|
fn tk_anchor() -> Int {
  20
}

///|
fn tk_tag() -> Int {
  21
}

///|
fn tk_scalar_slice() -> Int {
  22
}

///|
fn tk_scalar_owned() -> Int {
  23
}

///| Scalar style constants.
fn style_plain() -> Int {
  0
}

///|
fn style_single() -> Int {
  1
}

///|
fn style_double() -> Int {
  2
}

///|
fn style_literal() -> Int {
  3
}

///|
fn style_folded() -> Int {
  4
}

///|
val struct Marker {
  index : Int
  line : Int
  col : Int
}

///|
fn Marker::new(index : Int, line : Int, col : Int) -> Marker {
  Marker::{ index: index, line: line, col: col }
}

///| Flat value-type token (zero heap allocation, zero RC traffic).
val struct Token {
  kind : Int
  style : Int
  val_start : Int
  val_end : Int
  line : Int
  col : Int
}

///|
fn Token::empty(kind : Int, line : Int, col : Int) -> Token {
  Token::{ kind: kind, style: 0, val_start: 0, val_end: 0, line: line, col: col }
}

///|
fn Token::with_span(kind : Int, style : Int, val_start : Int, val_end : Int, line : Int, col : Int) -> Token {
  Token::{ kind: kind, style: style, val_start: val_start, val_end: val_end, line: line, col: col }
}

///|
val struct SimpleKey {
  possible : Bool
  required : Bool
  token_number : Int
  mark : Marker
}

///|
fn SimpleKey::empty() -> SimpleKey {
  SimpleKey::{ possible: false, required: false, token_number: 0, mark: Marker::new(0, 0, 0) }
}

///|
val struct IndentEntry {
  indent : Int
  needs_block_end : Bool
}

///| Implicit mapping state inside a flow sequence:
///| 0 = None (flow mapping), 1 = Possible (flow seq), 2 = Inside (flow seq implicit map)
fn implicit_none() -> Int {
  0
}

///|
fn implicit_possible() -> Int {
  1
}

///|
fn implicit_inside() -> Int {
  2
}

///| Chomping mode for block scalars: 0 = Clip, 1 = Strip, 2 = Keep
fn chomp_clip() -> Int {
  0
}

///|
fn chomp_strip() -> Int {
  1
}

///|
fn chomp_keep() -> Int {
  2
}

///| Character classification helpers (operating on byte values, -1 = EOF).
fn is_eof(b : Int) -> Bool {
  b < 0
}

///|
fn is_break(b : Int) -> Bool {
  b == 10 || b == 13
}

///|
fn is_breakz(b : Int) -> Bool {
  b <= 0 || b == 10 || b == 13
}

///|
fn is_blank(b : Int) -> Bool {
  b == 32 || b == 9
}

///|
fn is_blank_or_break(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_blank_or_breakz(b : Int) -> Bool {
  b <= 0 || b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
fn is_alpha_yaml(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45
}

///|
fn is_word_char(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45
}

///|
fn is_hex(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

///|
fn as_hex(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    b - 87
  }
}

///|
fn is_flow(b : Int) -> Bool {
  b == 44 || b == 91 || b == 93 || b == 123 || b == 125
}

///|
fn is_uri_char(b : Int) -> Bool {
  if is_word_char(b) {
    return true
  }
  b == 35 || b == 59 || b == 47 || b == 63 || b == 58 || b == 64 ||
  b == 38 || b == 61 || b == 43 || b == 36 || b == 44 || b == 95 ||
  b == 46 || b == 33 || b == 126 || b == 42 || b == 39 || b == 40 ||
  b == 41 || b == 91 || b == 93 || b == 37
}

///|
fn is_tag_char(b : Int) -> Bool {
  is_uri_char(b) && !is_flow(b) && b != 33
}

///| UTF-8 sequence byte length from leading byte.
fn utf8_char_len(b : Int) -> Int {
  if b < 0x80 {
    1
  } else if (b & 0xE0) == 0xC0 {
    2
  } else if (b & 0xF0) == 0xE0 {
    3
  } else if (b & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

///| Encode a Unicode scalar value to UTF-8 bytes in `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///|
struct Scanner {
  src : String
  len : Int
  mut pos : Int
  mut index : Int
  mut line : Int
  mut col : Int

  tokens : Array[Token]
  mut token_head : Int
  str_pool : Array[String]
  mut stream_start_produced : Bool
  mut stream_end_produced : Bool
  mut adjacent_value_allowed_at : Int
  mut simple_key_allowed : Bool
  simple_keys : Array[SimpleKey]
  mut indent : Int
  indents : Array[IndentEntry]
  mut flow_level : Int
  mut tokens_parsed : Int
  mut token_available : Bool
  mut leading_whitespace : Bool
  flow_mapping_started : Array[Bool]
  implicit_flow_mapping_states : Array[Int]
  mut has_interrupted_plain : Bool
  mut interrupted_plain_mark : Marker
  mut has_error : Bool
  mut error : YamlError
}

///|
fn Scanner::new(src : String) -> Scanner {
  Scanner::{
    src: src,
    len: src.length(),
    pos: 0,
    index: 0,
    line: 1,
    col: 0,
    tokens: [],
    token_head: 0,
    str_pool: [],
    stream_start_produced: false,
    stream_end_produced: false,
    adjacent_value_allowed_at: -1,
    simple_key_allowed: true,
    simple_keys: [],
    indent: -1,
    indents: [],
    flow_level: 0,
    tokens_parsed: 0,
    token_available: false,
    leading_whitespace: true,
    flow_mapping_started: [],
    implicit_flow_mapping_states: [],
    has_interrupted_plain: false,
    interrupted_plain_mark: Marker::new(0, 1, 0),
    has_error: false,
    error: YamlError::new(1, 1, ""),
  }
}

///|
fn Scanner::intern_str(self : Scanner, s : String) -> Int {
  let id = self.str_pool.length()
  self.str_pool.push(s)
  id
}

///|
fn Scanner::mark(self : Scanner) -> Marker {
  Marker::new(self.index, self.line, self.col)
}

///|
fn Scanner::err(self : Scanner, msg : String) -> YamlError {
  YamlError::new(self.line, self.col + 1, msg)
}

///|
fn err_at(m : Marker, msg : String) -> YamlError {
  YamlError::new(m.line, m.col + 1, msg)
}

///|
fn err_lc(line : Int, col : Int, msg : String) -> YamlError {
  YamlError::new(line, col + 1, msg)
}

///|
fn Scanner::fail(self : Scanner, msg : String) -> Bool {
  self.has_error = true
  self.error = YamlError::new(self.line, self.col + 1, msg)
  false
}

///|
fn Scanner::fail_at(self : Scanner, m : Marker, msg : String) -> Bool {
  self.has_error = true
  self.error = YamlError::new(m.line, m.col + 1, msg)
  false
}

///|
fn Scanner::fail_lc(self : Scanner, line : Int, col : Int, msg : String) -> Bool {
  self.has_error = true
  self.error = YamlError::new(line, col + 1, msg)
  false
}

///|
fn Scanner::peek_b(self : Scanner) -> Int {
  if self.pos < self.len {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

///|
fn Scanner::peek_b_at(self : Scanner, off : Int) -> Int {
  let p = self.pos + off
  if p < self.len {
    self.src.code_unit_at(p)
  } else {
    -1
  }
}

///|
fn Scanner::is_bom_at(self : Scanner, p : Int) -> Bool {
  p + 2 < self.len &&
  self.src.code_unit_at(p) == 0xEF &&
  self.src.code_unit_at(p + 1) == 0xBB &&
  self.src.code_unit_at(p + 2) == 0xBF
}

///|
fn Scanner::next_is_bom(self : Scanner) -> Bool {
  self.is_bom_at(self.pos)
}

///|
fn Scanner::next_is_yaml_non_break(self : Scanner) -> Bool {
  let b = self.peek_b()
  !is_breakz(b) && !(b == 0xEF && self.next_is_bom())
}

///|
fn Scanner::next_is_yaml_non_space(self : Scanner) -> Bool {
  let b = self.peek_b()
  !is_blank_or_breakz(b) && !(b == 0xEF && self.next_is_bom())
}

///|
fn Scanner::next_is_doc_start(self : Scanner) -> Bool {
  self.pos + 2 < self.len &&
  self.src.code_unit_at(self.pos) == 45 &&
  self.src.code_unit_at(self.pos + 1) == 45 &&
  self.src.code_unit_at(self.pos + 2) == 45 &&
  is_blank_or_breakz(self.peek_b_at(3))
}

///|
fn Scanner::next_is_doc_end(self : Scanner) -> Bool {
  self.pos + 2 < self.len &&
  self.src.code_unit_at(self.pos) == 46 &&
  self.src.code_unit_at(self.pos + 1) == 46 &&
  self.src.code_unit_at(self.pos + 2) == 46 &&
  is_blank_or_breakz(self.peek_b_at(3))
}

///|
fn Scanner::next_is_doc_indicator(self : Scanner) -> Bool {
  self.next_is_doc_start() || self.next_is_doc_end()
}

///|
fn Scanner::next_can_be_plain_scalar(self : Scanner, in_flow : Bool) -> Bool {
  let b = self.peek_b()
  if b == 58 {
    let nb = self.peek_b_at(1)
    if is_blank_or_breakz(nb) || (in_flow && is_flow(nb)) {
      return false
    }
    return true
  }
  if b == 0xEF && self.next_is_bom() {
    return false
  }
  if in_flow && is_flow(b) {
    return false
  }
  true
}

///|
fn Scanner::skip_blank(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = self.col + 1
}

///|
fn Scanner::skip_ascii_non_blank(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = self.col + 1
  self.leading_whitespace = false
}

///|
fn Scanner::skip_n_ascii_non_blank(self : Scanner, n : Int) -> Unit {
  self.pos = self.pos + n
  self.index = self.index + n
  self.col = self.col + n
  self.leading_whitespace = false
}

///|
fn Scanner::skip_char_non_blank(self : Scanner) -> Unit {
  let b = self.peek_b()
  if b < 0 {
    return
  }
  let clen = utf8_char_len(b)
  let adv = if self.pos + clen <= self.len { clen } else { self.len - self.pos }
  self.pos = self.pos + adv
  self.index = self.index + 1
  self.col = self.col + 1
  self.leading_whitespace = false
}

///|
fn Scanner::skip_nl(self : Scanner) -> Unit {
  self.pos = self.pos + 1
  self.index = self.index + 1
  self.col = 0
  self.line = self.line + 1
  self.leading_whitespace = true
}

///|
fn Scanner::skip_linebreak(self : Scanner) -> Unit {
  let b = self.peek_b()
  if b == 13 && self.peek_b_at(1) == 10 {
    self.skip_blank()
    self.skip_nl()
  } else if b == 10 || b == 13 {
    self.skip_nl()
  }
}

///|
fn Scanner::read_break(self : Scanner, sb : StringBuilder) -> Unit {
  self.skip_linebreak()
  sb.write_byte(10.to_byte())
}

///|
fn Scanner::tokens_len(self : Scanner) -> Int {
  self.tokens.length() - self.token_head
}

///|
fn Scanner::push_token(self : Scanner, tok : Token) -> Unit {
  self.tokens.push(tok)
}

///|
fn Scanner::pop_token(self : Scanner) -> Token {
  if self.token_head >= self.tokens.length() {
    return Token::empty(tk_eof(), self.line, self.col)
  }
  let tok = self.tokens[self.token_head]
  self.token_head = self.token_head + 1
  if self.token_head >= self.tokens.length() {
    self.tokens.clear()
    self.token_head = 0
  }
  tok
}

///|
fn Scanner::insert_token(self : Scanner, rel_pos : Int, tok : Token) -> Unit {
  let abs_pos = self.token_head + rel_pos
  let n = self.tokens.length()
  self.tokens.push(tok)
  let mut i = n
  while i > abs_pos {
    self.tokens[i] = self.tokens[i - 1]
    i = i - 1
  }
  self.tokens[abs_pos] = tok
}

///| Returns `(ok, found_tabs, has_yaml_ws)`.
///| Encoded as Int: -1 = error, 0..3 = bitmask (bit 0 = found_tabs, bit 1 = has_yaml_ws).
fn Scanner::skip_ws_to_eol(self : Scanner, skip_tabs : Bool) -> Int {
  let mut encountered_tab = false
  let mut has_yaml_ws = false
  let src = self.src
  let len = self.len
  while self.pos < len {
    let b = src.code_unit_at(self.pos)
    if b == 32 {
      has_yaml_ws = true
      let start = self.pos
      let mut p = start + 1
      while p < len && src.code_unit_at(p) == 32 {
        p = p + 1
      }
      let d = p - start
      self.pos = p
      self.index = self.index + d
      self.col = self.col + d
    } else if b == 9 && skip_tabs {
      encountered_tab = true
      self.skip_blank()
    } else if b == 35 {
      if !encountered_tab && !has_yaml_ws {
        let _ = self.fail("comments must be separated from other tokens by whitespace")
        return -1
      }
      self.skip_blank()
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if self.col > 0 && self.pos + 2 < len && src.code_unit_at(self.pos) == 0xEF && self.next_is_bom() {
    let _ = self.fail("a byte order mark must not appear inside a document")
    return -1
  }
  (if encountered_tab { 1 } else { 0 }) | (if has_yaml_ws { 2 } else { 0 })
}

///|
fn Scanner::skip_yaml_whitespace(self : Scanner) -> Bool {
  let mut need_ws = true
  while true {
    let b = self.peek_b()
    if b == 32 {
      self.skip_blank()
      need_ws = false
    } else if b == 10 || b == 13 {
      self.skip_linebreak()
      if self.flow_level == 0 {
        self.simple_key_allowed = true
      }
      need_ws = false
    } else if b == 35 {
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if need_ws {
    self.fail("expected whitespace")
  } else {
    true
  }
}

///|
fn Scanner::next_token(self : Scanner) -> Token {
  if self.stream_end_produced {
    return Token::empty(tk_eof(), self.line, self.col)
  }
  // Fast path: tokens already buffered and no pending simple key in block mode.
  if self.token_head < self.tokens.length() && self.flow_level == 0 && self.simple_keys.length() == 1 && !self.simple_keys[0].possible {
    let t = self.tokens[self.token_head]
    self.token_head = self.token_head + 1
    if self.token_head >= self.tokens.length() {
      self.tokens.clear()
      self.token_head = 0
    }
    self.tokens_parsed = self.tokens_parsed + 1
    if t.kind == tk_stream_end() {
      self.stream_end_produced = true
    }
    return t
  }
  if !self.token_available {
    if !self.fetch_more_tokens() {
      return Token::empty(tk_err(), self.line, self.col)
    }
  }
  if self.token_head >= self.tokens.length() {
    let _ = self.fail("did not find expected next token")
    return Token::empty(tk_err(), self.line, self.col)
  }
  let t = self.pop_token()
  self.token_available = false
  self.tokens_parsed = self.tokens_parsed + 1
  if t.kind == tk_stream_end() {
    self.stream_end_produced = true
  }
  t
}

///|
fn Scanner::fetch_more_tokens(self : Scanner) -> Bool {
  while true {
    let mut need_more = false
    if self.token_head >= self.tokens.length() {
      need_more = true
    } else {
      if !self.stale_simple_keys() {
        return false
      }
      if self.flow_level == 0 {
        if self.simple_keys.length() > 0 {
          let sk = self.simple_keys[0]
          if sk.possible && sk.token_number == self.tokens_parsed {
            need_more = true
          }
        }
      } else {
        let mut i = 0
        let n = self.simple_keys.length()
        while i < n {
          let sk = self.simple_keys[i]
          if sk.possible && sk.token_number == self.tokens_parsed {
            need_more = true
            break
          }
          i = i + 1
        }
      }
    }
    if !need_more {
      break
    }
    if !self.fetch_next_token() {
      return false
    }
  }
  self.token_available = true
  true
}

///|
fn Scanner::stale_simple_keys(self : Scanner) -> Bool {
  if self.flow_level > 0 {
    return true
  }
  let n = self.simple_keys.length()
  if n == 1 {
    let sk = self.simple_keys[0]
    if sk.possible && (sk.mark.line < self.line || sk.mark.index + 1024 < self.index) {
      if sk.required {
        return self.fail("simple key expects ':'")
      }
      self.simple_keys[0] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
    }
    return true
  }
  let mut i = 0
  while i < n {
    let sk = self.simple_keys[i]
    if sk.possible && (sk.mark.line < self.line || sk.mark.index + 1024 < self.index) {
      if sk.required {
        return self.fail("simple key expects ':'")
      }
      self.simple_keys[i] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
    }
    i = i + 1
  }
  true
}

///|
fn Scanner::skip_to_next_token(self : Scanner) -> Bool {
  let src = self.src
  let len = self.len
  while self.pos < len {
    let b = src.code_unit_at(self.pos)
    if b == 32 {
      let start = self.pos
      let mut p = start + 1
      while p < len && src.code_unit_at(p) == 32 {
        p = p + 1
      }
      let d = p - start
      self.pos = p
      self.index = self.index + d
      self.col = self.col + d
    } else if b == 10 {
      self.pos = self.pos + 1
      self.index = self.index + 1
      self.col = 0
      self.line = self.line + 1
      self.leading_whitespace = true
      if self.flow_level == 0 {
        self.simple_key_allowed = true
      }
    } else if b == 13 {
      self.skip_linebreak()
      if self.flow_level == 0 {
        self.simple_key_allowed = true
      }
    } else if b == 9 {
      if self.indents.length() > 0 && self.leading_whitespace && self.col < self.indent {
        if self.skip_ws_to_eol(true) < 0 {
          return false
        }
        if !is_breakz(self.peek_b()) {
          return self.fail("tabs disallowed within block indentation")
        }
      } else {
        self.skip_blank()
      }
    } else if b == 35 {
      while self.next_is_yaml_non_break() {
        self.skip_char_non_blank()
      }
    } else {
      break
    }
  }
  if self.has_interrupted_plain {
    self.has_interrupted_plain = false
    let err_mark = self.interrupted_plain_mark
    let is_immediate_next_line = self.line == err_mark.line + 1
    if self.flow_level == 0 &&
    is_immediate_next_line &&
    self.col > self.indent &&
    !is_eof(self.peek_b()) &&
    self.peek_b() != 0 &&
    !self.next_is_doc_indicator() &&
    self.next_can_be_plain_scalar(false) {
      return self.fail_at(err_mark, "comment intercepting multiline plain scalar")
    }
  }
  true
}

///| Compute 1-based `(line, col)` at byte offset `target` in `src` (error-path only).
fn compute_line_col(src : String, target : Int) -> (Int, Int) {
  let mut line = 1
  let mut col = 1
  let mut i = 0
  while i < target {
    let b = src.code_unit_at(i)
    if b == 10 {
      line = line + 1
      col = 1
      i = i + 1
    } else if b == 13 {
      line = line + 1
      col = 1
      if i + 1 < target && src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else if b < 0x80 {
      col = col + 1
      i = i + 1
    } else {
      col = col + 1
      i = i + utf8_char_len(b)
    }
  }
  (line, col)
}

///| Validate strict UTF-8 (RFC 3629) and YAML 1.2 §5.1 c-printable (reject raw C0 controls & DEL).
fn Scanner::validate_input(self : Scanner) -> Bool {
  let src = self.src
  let len = self.len
  let mut i = 0
  while i < len {
    let b = src.code_unit_at(i)
    if (b >= 32 && b < 127) || b == 10 || b == 9 || b == 13 {
      i = i + 1
    } else if b >= 0x80 {
      if b >= 0xC2 && b <= 0xDF {
        if i + 1 >= len {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "truncated 2-byte UTF-8 sequence")
        }
        let b1 = src.code_unit_at(i + 1)
        if (b1 & 0xC0) != 0x80 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "invalid UTF-8 continuation byte")
        }
        i = i + 2
      } else if b >= 0xE0 && b <= 0xEF {
        if i + 2 >= len {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "truncated 3-byte UTF-8 sequence")
        }
        let b1 = src.code_unit_at(i + 1)
        let b2 = src.code_unit_at(i + 2)
        if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "invalid UTF-8 continuation byte")
        }
        if b == 0xE0 && b1 < 0xA0 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "overlong 3-byte UTF-8 sequence")
        }
        if b == 0xED && b1 >= 0xA0 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "invalid UTF-8 surrogate code point")
        }
        i = i + 3
      } else if b >= 0xF0 && b <= 0xF4 {
        if i + 3 >= len {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "truncated 4-byte UTF-8 sequence")
        }
        let b1 = src.code_unit_at(i + 1)
        let b2 = src.code_unit_at(i + 2)
        let b3 = src.code_unit_at(i + 3)
        if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "invalid UTF-8 continuation byte")
        }
        if b == 0xF0 && b1 < 0x90 {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "overlong 4-byte UTF-8 sequence")
        }
        if b == 0xF4 && b1 > 0x8F {
          let (ln, cl) = compute_line_col(src, i)
          return self.fail_lc(ln, cl, "UTF-8 code point out of Unicode range")
        }
        i = i + 4
      } else {
        let (ln, cl) = compute_line_col(src, i)
        return self.fail_lc(ln, cl, "invalid leading UTF-8 octet")
      }
    } else {
      let (ln, cl) = compute_line_col(src, i)
      return self.fail_lc(ln, cl, "control characters are not allowed in YAML stream")
    }
  }
  true
}

///|
fn Scanner::fetch_next_token(self : Scanner) -> Bool {
  if !self.stream_start_produced {
    if !self.validate_input() {
      return false
    }
    let line = self.line
    let col = self.col
    self.indent = -1
    self.stream_start_produced = true
    self.simple_key_allowed = true
    self.push_token(Token::empty(tk_stream_start(), line, col))
    self.simple_keys.push(SimpleKey::empty())
    return true
  }

  if !self.skip_to_next_token() {
    return false
  }
  if !self.stale_simple_keys() {
    return false
  }
  self.unroll_indent(self.col)

  let b = self.peek_b()
  if b <= 0 {
    if b == 0 {
      return self.fail("found unprintable NUL character")
    }
    return self.fetch_stream_end()
  }

  if self.col == 0 {
    if b == 37 {
      return self.fetch_directive()
    } else if b == 45 && self.next_is_doc_start() {
      return self.fetch_document_indicator(tk_document_start())
    } else if b == 46 && self.next_is_doc_end() {
      if !self.fetch_document_indicator(tk_document_end()) {
        return false
      }
      if self.skip_ws_to_eol(true) < 0 {
        return false
      }
      if !is_breakz(self.peek_b()) {
        return self.fail("invalid content after document end marker")
      }
      return true
    } else if b == 0xEF && self.next_is_bom() {
      if self.flow_level == 0 {
        return self.fetch_bom()
      }
      return self.fail("a byte order mark must not appear inside a document")
    }
  } else if b == 0xEF && self.next_is_bom() {
    return self.fail("a byte order mark must not appear inside a document")
  }

  if self.col < self.indent {
    return self.fail("invalid indentation")
  }

  // Hot dispatch: alphanumeric / '/' / '_' immediately go to plain scalar!
  if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 47 || b == 95 {
    return self.fetch_plain_scalar()
  }

  if b == 58 {
    let nb = self.peek_b_at(1)
    if is_blank_or_breakz(nb) {
      return self.fetch_value()
    } else if self.flow_level > 0 && (is_flow(nb) || self.index == self.adjacent_value_allowed_at) {
      return self.fetch_flow_value()
    } else if self.flow_level == 0 {
      return self.fetch_plain_scalar()
    }
    return self.fetch_plain_scalar()
  }
  if b == 34 {
    return self.fetch_flow_scalar(false)
  }
  if b == 45 {
    let nb = self.peek_b_at(1)
    if is_blank_or_breakz(nb) {
      return self.fetch_block_entry()
    }
    return self.fetch_plain_scalar()
  }
  if b == 39 {
    return self.fetch_flow_scalar(true)
  }
  if b == 91 {
    return self.fetch_flow_collection_start(tk_flow_seq_start(), false)
  }
  if b == 93 {
    return self.fetch_flow_collection_end(tk_flow_seq_end(), true)
  }
  if b == 44 {
    return self.fetch_flow_entry()
  }
  if b == 123 {
    return self.fetch_flow_collection_start(tk_flow_map_start(), true)
  }
  if b == 125 {
    return self.fetch_flow_collection_end(tk_flow_map_end(), false)
  }
  if b == 124 && self.flow_level == 0 {
    return self.fetch_block_scalar(true)
  }
  if b == 62 && self.flow_level == 0 {
    return self.fetch_block_scalar(false)
  }
  if b == 63 {
    let nb = self.peek_b_at(1)
    if is_blank_or_breakz(nb) {
      return self.fetch_key()
    }
    return self.fetch_plain_scalar()
  }
  if b == 42 {
    return self.fetch_anchor(true)
  }
  if b == 38 {
    return self.fetch_anchor(false)
  }
  if b == 33 {
    return self.fetch_tag()
  }
  if b == 37 || b == 64 || b == 96 {
    return self.fail("unexpected reserved indicator character")
  }
  self.fetch_plain_scalar()
}

///|
fn Scanner::fetch_stream_end(self : Scanner) -> Bool {
  if self.col != 0 {
    self.col = 0
    self.line = self.line + 1
  }
  let mut i = 0
  let n = self.simple_keys.length()
  while i < n {
    let sk = self.simple_keys[i]
    if sk.required && sk.possible {
      return self.fail("simple key expected")
    }
    self.simple_keys[i] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
    i = i + 1
  }
  self.unroll_indent(-1)
  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = false
  self.push_token(Token::empty(tk_stream_end(), self.line, self.col))
  true
}

///|
fn Scanner::fetch_bom(self : Scanner) -> Bool {
  self.unroll_indent(-1)
  if !self.remove_simple_key() {
    return false
  }
  let line = self.line
  let col = self.col
  self.pos = self.pos + 3
  self.index = self.index + 1
  self.simple_key_allowed = true
  self.push_token(Token::empty(tk_bom(), line, col))
  true
}

///|
fn Scanner::fetch_document_indicator(self : Scanner, kind : Int) -> Bool {
  self.unroll_indent(-1)
  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = false
  let line = self.line
  let col = self.col
  self.skip_n_ascii_non_blank(3)
  self.push_token(Token::empty(kind, line, col))
  true
}

///|
fn Scanner::fetch_directive(self : Scanner) -> Bool {
  self.unroll_indent(-1)
  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = false
  self.scan_directive()
}

///|
fn Scanner::scan_directive(self : Scanner) -> Bool {
  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  let name_start = self.pos
  while self.next_is_yaml_non_space() {
    self.skip_char_non_blank()
  }
  let name = self.src.slice(name_start, self.pos)
  if name.length() == 0 {
    return self.fail_at(start_mark, "while scanning a directive, could not find expected directive name")
  }
  if !is_blank_or_breakz(self.peek_b()) {
    return self.fail_at(start_mark, "while scanning a directive, found unexpected character")
  }

  let tok = if name == "YAML" {
    let t = self.scan_version_directive_value(start_mark)
    if self.has_error {
      return false
    }
    t
  } else if name == "TAG" {
    let t = self.scan_tag_directive_value(start_mark)
    if self.has_error {
      return false
    }
    t
  } else {
    while is_blank(self.peek_b()) {
      while is_blank(self.peek_b()) {
        self.skip_blank()
      }
      if !is_blank_or_breakz(self.peek_b()) {
        while self.next_is_yaml_non_space() {
          self.skip_char_non_blank()
        }
      }
    }
    let id = self.intern_str(name)
    Token::with_span(tk_reserved_directive(), 0, id, 0, start_mark.line, start_mark.col)
  }

  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  if is_breakz(self.peek_b()) {
    self.skip_linebreak()
    self.push_token(tok)
    true
  } else {
    self.fail_at(start_mark, "while scanning a directive, did not find expected comment or line break")
  }
}

///|
fn Scanner::scan_version_directive_number(self : Scanner, mark : Marker) -> Int {
  let mut v = 0
  let mut count = 0
  while is_digit(self.peek_b()) {
    if count + 1 > 9 {
      let _ = self.fail_at(mark, "while scanning a YAML directive, found extremely long version number")
      return -1
    }
    v = v * 10 + (self.peek_b() - 48)
    count = count + 1
    self.skip_ascii_non_blank()
  }
  if count == 0 {
    let _ = self.fail_at(mark, "while scanning a YAML directive, did not find expected version number")
    return -1
  }
  v
}

///|
fn Scanner::scan_version_directive_value(self : Scanner, mark : Marker) -> Token {
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let major = self.scan_version_directive_number(mark)
  if self.has_error {
    return Token::empty(tk_err(), mark.line, mark.col)
  }
  if self.peek_b() != 46 {
    let _ = self.fail_at(mark, "while scanning a YAML directive, expected '.'")
    return Token::empty(tk_err(), mark.line, mark.col)
  }
  self.skip_ascii_non_blank()
  let minor = self.scan_version_directive_number(mark)
  if self.has_error {
    return Token::empty(tk_err(), mark.line, mark.col)
  }
  Token::with_span(tk_version_directive(), 0, major, minor, mark.line, mark.col)
}

///|
fn Scanner::scan_tag_directive_value(self : Scanner, mark : Marker) -> Token {
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let handle = self.scan_tag_handle(true, mark)
  if self.has_error {
    return Token::empty(tk_err(), mark.line, mark.col)
  }
  while is_blank(self.peek_b()) {
    self.skip_blank()
  }
  let prefix = self.scan_tag_prefix(mark)
  if self.has_error {
    return Token::empty(tk_err(), mark.line, mark.col)
  }
  if is_blank_or_breakz(self.peek_b()) {
    let hid = self.intern_str(handle)
    let pid = self.intern_str(prefix)
    Token::with_span(tk_tag_directive(), 0, hid, pid, mark.line, mark.col)
  } else {
    let _ = self.fail_at(mark, "while scanning TAG directive, expected whitespace or line break")
    Token::empty(tk_err(), mark.line, mark.col)
  }
}

///|
fn Scanner::fetch_tag(self : Scanner) -> Bool {
  self.save_simple_key()
  self.simple_key_allowed = false
  self.scan_tag()
}

///|
fn Scanner::scan_tag(self : Scanner) -> Bool {
  let start_mark = self.mark()
  let mut handle = ""
  let mut suffix = ""

  if self.peek_b_at(1) == 60 {
    suffix = self.scan_verbatim_tag(start_mark)
    if self.has_error {
      return false
    }
  } else {
    handle = self.scan_tag_handle(false, start_mark)
    if self.has_error {
      return false
    }
    let hlen = handle.length()
    if hlen >= 2 && handle.code_unit_at(0) == 33 && handle.code_unit_at(hlen - 1) == 33 {
      suffix = self.scan_tag_shorthand_suffix("", start_mark)
      if self.has_error {
        return false
      }
    } else {
      suffix = self.scan_tag_shorthand_suffix(handle, start_mark)
      if self.has_error {
        return false
      }
      handle = "!"
      if suffix.length() == 0 {
        handle = ""
        suffix = "!"
      }
    }
  }

  let b = self.peek_b()
  if is_blank_or_breakz(b) || (self.flow_level > 0 && is_flow(b)) {
    let hid = self.intern_str(handle)
    let sid = self.intern_str(suffix)
    self.push_token(Token::with_span(tk_tag(), 0, hid, sid, start_mark.line, start_mark.col))
    true
  } else {
    self.fail_at(start_mark, "while scanning a tag, did not find expected whitespace or line break")
  }
}

///|
fn Scanner::scan_tag_handle(self : Scanner, directive : Bool, mark : Marker) -> String {
  if self.peek_b() != 33 {
    let _ = self.fail_at(mark, "while scanning a tag, expected '!'")
    return ""
  }
  let start_pos = self.pos
  self.skip_ascii_non_blank()
  while is_word_char(self.peek_b()) {
    self.skip_ascii_non_blank()
  }
  if self.peek_b() == 33 {
    self.skip_ascii_non_blank()
  } else if directive && self.pos - start_pos != 1 {
    let _ = self.fail_at(mark, "while parsing a tag directive, expected '!'")
    return ""
  }
  self.src.slice(start_pos, self.pos)
}

///|
fn Scanner::scan_tag_prefix(self : Scanner, start_mark : Marker) -> String {
  let sb = StringBuilder::new()
  let b = self.peek_b()
  if b == 33 {
    sb.write_byte(33.to_byte())
    self.skip_ascii_non_blank()
  } else if !is_tag_char(b) {
    let _ = self.fail_at(start_mark, "invalid global tag character")
    return ""
  } else if b == 37 {
    if !self.scan_uri_escapes(sb, start_mark) {
      return ""
    }
  } else {
    sb.write_byte(b.to_byte())
    self.skip_ascii_non_blank()
  }

  while is_uri_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      if !self.scan_uri_escapes(sb, start_mark) {
        return ""
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
  }
  sb.to_string()
}

///|
fn Scanner::scan_verbatim_tag(self : Scanner, start_mark : Marker) -> String {
  self.skip_n_ascii_non_blank(2)
  let sb = StringBuilder::new()
  while is_uri_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      if !self.scan_uri_escapes(sb, start_mark) {
        return ""
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
  }
  if self.peek_b() != 62 {
    let _ = self.fail_at(start_mark, "while scanning a verbatim tag, expected '>'")
    return ""
  }
  self.skip_ascii_non_blank()
  sb.to_string()
}

///|
fn Scanner::scan_tag_shorthand_suffix(self : Scanner, head : String, mark : Marker) -> String {
  let mut length = head.length()
  let sb = StringBuilder::new()
  if length > 1 {
    sb.write_string(head.slice(1, length))
  }
  while is_tag_char(self.peek_b()) {
    let ch = self.peek_b()
    if ch == 37 {
      if !self.scan_uri_escapes(sb, mark) {
        return ""
      }
    } else {
      sb.write_byte(ch.to_byte())
      self.skip_ascii_non_blank()
    }
    length = length + 1
  }
  if length == 0 {
    let _ = self.fail_at(mark, "while parsing a tag, did not find expected tag URI")
    return ""
  }
  sb.to_string()
}

///|
fn Scanner::scan_uri_escapes(self : Scanner, sb : StringBuilder, mark : Marker) -> Bool {
  let mut width = 0
  let bytes : Array[Int] = []
  while true {
    let b0 = self.peek_b()
    let b1 = self.peek_b_at(1)
    let b2 = self.peek_b_at(2)
    if !(b0 == 37 && is_hex(b1) && is_hex(b2)) {
      return self.fail_at(mark, "while parsing a tag, found an invalid escape sequence")
    }
    let byte = (as_hex(b1) << 4) | as_hex(b2)
    if width == 0 {
      if (byte & 0x80) == 0x00 {
        width = 1
      } else if (byte & 0xE0) == 0xC0 {
        width = 2
      } else if (byte & 0xF0) == 0xE0 {
        width = 3
      } else if (byte & 0xF8) == 0xF0 {
        width = 4
      } else {
        return self.fail_at(mark, "while parsing a tag, invalid leading UTF-8 byte")
      }
    } else if (byte & 0xC0) != 0x80 {
      return self.fail_at(mark, "while parsing a tag, invalid trailing UTF-8 byte")
    }
    bytes.push(byte)
    self.skip_n_ascii_non_blank(3)
    width = width - 1
    if width == 0 {
      break
    }
  }
  let mut i = 0
  let n = bytes.length()
  while i < n {
    sb.write_byte(bytes[i].to_byte())
    i = i + 1
  }
  true
}

///|
fn Scanner::fetch_anchor(self : Scanner, alias : Bool) -> Bool {
  self.save_simple_key()
  self.simple_key_allowed = false
  let start_mark = self.mark()
  self.skip_ascii_non_blank()
  let name_start = self.pos
  while self.next_is_yaml_non_space() && !is_flow(self.peek_b()) {
    self.skip_char_non_blank()
  }
  if self.pos == name_start {
    return self.fail_at(start_mark, "while scanning an anchor or alias, expected name")
  }
  let kind = if alias { tk_alias() } else { tk_anchor() }
  self.push_token(Token::with_span(kind, 0, name_start, self.pos, start_mark.line, start_mark.col))
  true
}

///|
fn Scanner::fetch_flow_collection_start(self : Scanner, kind : Int, is_mapping : Bool) -> Bool {
  self.save_simple_key()
  self.roll_one_col_indent()
  if !self.increase_flow_level() {
    return false
  }
  self.simple_key_allowed = true

  let line = self.line
  let col = self.col
  self.skip_ascii_non_blank()

  self.flow_mapping_started.push(is_mapping)
  self.implicit_flow_mapping_states.push(if is_mapping { implicit_none() } else { implicit_possible() })

  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  self.push_token(Token::empty(kind, line, col))
  true
}

///|
fn Scanner::fetch_flow_collection_end(self : Scanner, kind : Int, is_seq_end : Bool) -> Bool {
  if self.flow_level == 0 {
    return self.fail("misplaced closing bracket")
  }
  if !self.remove_simple_key() {
    return false
  }
  self.decrease_flow_level()
  self.simple_key_allowed = false

  if is_seq_end {
    self.end_implicit_mapping(self.line, self.col)
  }
  let _ = self.implicit_flow_mapping_states.pop()
  let _ = self.flow_mapping_started.pop()

  let line = self.line
  let col = self.col
  self.skip_ascii_non_blank()
  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  if self.flow_level > 0 {
    self.adjacent_value_allowed_at = self.index
  }
  self.push_token(Token::empty(kind, line, col))
  true
}

///|
fn Scanner::fetch_flow_entry(self : Scanner) -> Bool {
  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = true
  self.end_implicit_mapping(self.line, self.col)

  let line = self.line
  let col = self.col
  self.skip_ascii_non_blank()
  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  self.push_token(Token::empty(tk_flow_entry(), line, col))
  true
}

///|
fn Scanner::increase_flow_level(self : Scanner) -> Bool {
  if self.flow_level >= 1023 {
    return self.fail("flow nesting limit exceeded")
  }
  self.simple_keys.push(SimpleKey::empty())
  self.flow_level = self.flow_level + 1
  true
}

///|
fn Scanner::decrease_flow_level(self : Scanner) -> Unit {
  if self.flow_level > 0 {
    self.flow_level = self.flow_level - 1
    let _ = self.simple_keys.pop()
  }
}

///|
fn Scanner::fetch_block_entry(self : Scanner) -> Bool {
  if self.flow_level > 0 {
    return self.fail("'-' is only valid inside a block")
  }
  if !self.simple_key_allowed {
    return self.fail("block sequence entries are not allowed in this context")
  }
  if self.tokens.length() > self.token_head {
    let tok = self.tokens[self.tokens.length() - 1]
    if (tok.kind == tk_anchor() || tok.kind == tk_tag()) && self.col == 0 && tok.col == 0 && self.indent > -1 {
      return self.fail_lc(tok.line, tok.col, "invalid indentation for anchor or tag")
    }
  }

  let line = self.line
  let col = self.col
  self.skip_ascii_non_blank()

  self.roll_indent(col, -1, tk_block_seq_start(), line, col)
  let ws_flags = self.skip_ws_to_eol(true)
  if ws_flags < 0 {
    return false
  }
  if (ws_flags & 1) != 0 && self.peek_b() == 45 && is_blank_or_breakz(self.peek_b_at(1)) {
    return self.fail("'-' must be followed by valid YAML whitespace")
  }
  if self.skip_ws_to_eol(false) < 0 {
    return false
  }
  let nb = self.peek_b()
  if is_break(nb) || is_flow(nb) {
    self.roll_one_col_indent()
  }

  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = true
  self.push_token(Token::empty(tk_block_entry(), self.line, self.col))
  true
}

///|
fn Scanner::fetch_block_scalar(self : Scanner, literal : Bool) -> Bool {
  self.save_simple_key()
  self.simple_key_allowed = true
  self.scan_block_scalar(literal)
}

///| Write `n` newline bytes to `sb`.
fn write_n_newlines(sb : StringBuilder, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    sb.write_byte(10.to_byte())
    i = i + 1
  }
}

///|
fn Scanner::scan_block_scalar(self : Scanner, literal : Bool) -> Bool {
  let start_mark = self.mark()
  let mut chomping = chomp_clip()
  let mut increment = 0
  let mut block_indent = 0
  let mut leading_blank = false
  let style = if literal { style_literal() } else { style_folded() }

  let sb = StringBuilder::new()
  let mut leading_breaks = 0
  let mut trailing_breaks = 0

  self.skip_ascii_non_blank()
  self.unroll_non_block_indents()

  let b0 = self.peek_b()
  if b0 == 43 || b0 == 45 {
    chomping = if b0 == 43 { chomp_keep() } else { chomp_strip() }
    self.skip_ascii_non_blank()
    if is_digit(self.peek_b()) {
      if self.peek_b() == 48 {
        return self.fail_at(start_mark, "block scalar indentation indicator cannot be 0")
      }
      increment = self.peek_b() - 48
      self.skip_ascii_non_blank()
    }
  } else if is_digit(b0) {
    if b0 == 48 {
      return self.fail_at(start_mark, "block scalar indentation indicator cannot be 0")
    }
    increment = b0 - 48
    self.skip_ascii_non_blank()
    let b1 = self.peek_b()
    if b1 == 43 || b1 == 45 {
      chomping = if b1 == 43 { chomp_keep() } else { chomp_strip() }
      self.skip_ascii_non_blank()
    }
  }

  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  if !is_breakz(self.peek_b()) {
    return self.fail_at(start_mark, "while scanning a block scalar, expected comment or line break")
  }
  if is_break(self.peek_b()) {
    self.skip_linebreak()
  }
  if self.peek_b() == 9 {
    return self.fail_at(start_mark, "a block scalar content cannot start with a tab")
  }

  if increment > 0 {
    block_indent = if self.indent >= 0 { self.indent + increment } else { increment }
  }

  if block_indent == 0 {
    let (ind, tb) = self.skip_block_scalar_first_line_indent()
    block_indent = ind
    trailing_breaks = tb
  } else {
    trailing_breaks = self.skip_block_scalar_indent(block_indent)
  }

  if is_eof(self.peek_b()) || self.peek_b() == 0 {
    let contents = if chomping == chomp_keep() {
      if trailing_breaks == 0 && self.line > start_mark.line && self.col > 0 {
        "\n"
      } else {
        let tb_sb = StringBuilder::new()
        write_n_newlines(tb_sb, trailing_breaks)
        tb_sb.to_string()
      }
    } else {
      ""
    }
    let sid = self.intern_str(contents)
    self.push_token(Token::with_span(tk_scalar_owned(), style, sid, 0, start_mark.line, start_mark.col))
    return true
  }

  if self.col < block_indent && self.col > self.indent {
    return self.fail("wrongly indented line in block scalar")
  }

  let src = self.src
  let len = self.len
  while self.col == block_indent && self.next_is_yaml_non_break() {
    if block_indent == 0 && self.next_is_doc_indicator() {
      break
    }

    let trailing_blank = is_blank(self.peek_b())
    if !literal && leading_breaks > 0 && !leading_blank && !trailing_blank {
      if trailing_breaks > 0 {
        write_n_newlines(sb, trailing_breaks)
      } else {
        sb.write_byte(32.to_byte())
      }
    } else {
      if leading_breaks > 0 {
        write_n_newlines(sb, leading_breaks)
      }
      if trailing_breaks > 0 {
        write_n_newlines(sb, trailing_breaks)
      }
    }
    leading_breaks = 0
    trailing_breaks = 0

    leading_blank = is_blank(self.peek_b())

    let line_start = self.pos
    let mut p = line_start
    while p < len {
      let ch = src.code_unit_at(p)
      if ch == 10 || ch == 13 || ch == 0 {
        break
      }
      if ch < 0x80 {
        p = p + 1
      } else if ch == 0xEF && self.is_bom_at(p) {
        break
      } else {
        // Sync and use UTF-8 step
        let adv = p - self.pos
        self.pos = p
        self.index = self.index + adv
        self.col = self.col + adv
        self.leading_whitespace = false
        self.skip_char_non_blank()
        p = self.pos
      }
    }
    if p > self.pos {
      let adv = p - self.pos
      self.pos = p
      self.index = self.index + adv
      self.col = self.col + adv
      self.leading_whitespace = false
    }
    if self.pos > line_start {
      sb.write_string(src.slice(line_start, self.pos))
    }

    if !is_break(self.peek_b()) {
      break
    }
    self.skip_linebreak()
    leading_breaks = 1

    trailing_breaks = self.skip_block_scalar_indent(block_indent)
  }

  if chomping != chomp_strip() {
    if leading_breaks > 0 {
      write_n_newlines(sb, leading_breaks)
    }
    let min_col = if block_indent > 1 { block_indent } else { 1 }
    if (is_eof(self.peek_b()) || self.peek_b() == 0) && self.col >= min_col {
      sb.write_byte(10.to_byte())
    }
  }
  if chomping == chomp_keep() && trailing_breaks > 0 {
    write_n_newlines(sb, trailing_breaks)
  }

  let sid = self.intern_str(sb.to_string())
  self.push_token(Token::with_span(tk_scalar_owned(), style, sid, 0, start_mark.line, start_mark.col))
  true
}

///|
fn Scanner::skip_block_scalar_indent(self : Scanner, block_indent : Int) -> Int {
  let mut breaks = 0
  let src = self.src
  let len = self.len
  while true {
    let start = self.pos
    let mut p = start
    let mut col = self.col
    while col < block_indent && p < len && src.code_unit_at(p) == 32 {
      p = p + 1
      col = col + 1
    }
    if p > start {
      let d = p - start
      self.pos = p
      self.index = self.index + d
      self.col = col
    }
    if is_break(self.peek_b()) {
      self.skip_linebreak()
      breaks = breaks + 1
    } else {
      break
    }
  }
  breaks
}

///|
fn Scanner::skip_block_scalar_first_line_indent(self : Scanner) -> (Int, Int) {
  let mut max_indent = 0
  let mut breaks = 0
  let src = self.src
  let len = self.len
  while true {
    let start = self.pos
    let mut p = start
    while p < len && src.code_unit_at(p) == 32 {
      p = p + 1
    }
    if p > start {
      let d = p - start
      self.pos = p
      self.index = self.index + d
      self.col = self.col + d
    }
    if self.col > max_indent {
      max_indent = self.col
    }
    if is_break(self.peek_b()) {
      self.skip_linebreak()
      breaks = breaks + 1
    } else {
      break
    }
  }
  let min_ind = self.indent + 1
  let mut ind = if max_indent > min_ind { max_indent } else { min_ind }
  if self.indent > 0 && ind < 1 {
    ind = 1
  }
  (ind, breaks)
}

///|
fn Scanner::fetch_flow_scalar(self : Scanner, single : Bool) -> Bool {
  self.save_simple_key()
  self.simple_key_allowed = false
  let tok = self.scan_flow_scalar(single)
  if self.has_error {
    return false
  }
  if !self.skip_to_next_token() {
    return false
  }
  self.adjacent_value_allowed_at = self.index
  self.push_token(tok)
  true
}

///|
fn Scanner::scan_flow_scalar(self : Scanner, single : Bool) -> Token {
  let start_mark = self.mark()
  let style = if single { style_single() } else { style_double() }

  // Eat opening quote
  self.skip_ascii_non_blank()

  // Zero-copy fast path: single-line quoted scalar with no escapes / no doubled single-quotes
  let fast_start = self.pos
  let fast_index = self.index
  let fast_col = self.col
  let quote_b = if single { 39 } else { 34 }
  let src = self.src
  let len = self.len
  let mut p = fast_start
  let mut non_ascii = false
  while p < len {
    let b = src.code_unit_at(p)
    if b == quote_b {
      if single && p + 1 < len && src.code_unit_at(p + 1) == 39 {
        break
      }
      if !non_ascii {
        let adv = p - fast_start
        self.pos = p + 1
        self.index = fast_index + adv + 1
        self.col = fast_col + adv + 1
        self.leading_whitespace = false
      } else {
        self.pos = p
        self.skip_ascii_non_blank()
      }
      if !self.check_trailing_after_quoted(start_mark) {
        return Token::empty(tk_err(), start_mark.line, start_mark.col)
      }
      return Token::with_span(tk_scalar_slice(), style, fast_start, p, start_mark.line, start_mark.col)
    } else if b == 10 || b == 13 || b == 0 {
      break
    } else if !single && b == 92 {
      // Single-line double-quoted escape fast path: avoids re-scanning prefix, avoids breaking
      // contiguous runs on spaces, and avoids per-char Scanner field mutations!
      let sb_fast = StringBuilder::new()
      if p > fast_start {
        sb_fast.write_string(src.slice(fast_start, p))
      }
      let mut ep = p
      let mut run_start = p
      let mut fast_done = false
      let mut fast_err = false
      let mut fast_non_ascii = non_ascii
      let mut fast_chars = if non_ascii { self.index - fast_index } else { p - fast_start }
      while ep < len {
        let eb = src.code_unit_at(ep)
        if eb == 34 {
          if ep > run_start {
            sb_fast.write_string(src.slice(run_start, ep))
          }
          self.pos = ep + 1
          self.index = fast_index + fast_chars + 1
          self.col = fast_col + fast_chars + 1
          self.leading_whitespace = false
          fast_done = true
          break
        } else if eb == 92 {
          if ep > run_start {
            sb_fast.write_string(src.slice(run_start, ep))
          }
          if ep + 1 >= len {
            fast_err = true
            let _ = self.fail_at(start_mark, "while parsing a quoted scalar, found unknown escape character")
            break
          }
          let esc = src.code_unit_at(ep + 1)
          if esc == 10 || esc == 13 {
            // Escaped line break -> fall back to full multiline slow path
            break
          }
          let mut code_len = 0
          if esc == 110 {
            sb_fast.write_byte(10.to_byte())
          } else if esc == 34 {
            sb_fast.write_byte(34.to_byte())
          } else if esc == 92 {
            sb_fast.write_byte(92.to_byte())
          } else if esc == 116 || esc == 9 {
            sb_fast.write_byte(9.to_byte())
          } else if esc == 114 {
            sb_fast.write_byte(13.to_byte())
          } else if esc == 48 {
            sb_fast.write_byte(0.to_byte())
          } else if esc == 97 {
            sb_fast.write_byte(7.to_byte())
          } else if esc == 98 {
            sb_fast.write_byte(8.to_byte())
          } else if esc == 118 {
            sb_fast.write_byte(11.to_byte())
          } else if esc == 102 {
            sb_fast.write_byte(12.to_byte())
          } else if esc == 101 {
            sb_fast.write_byte(27.to_byte())
          } else if esc == 32 {
            sb_fast.write_byte(32.to_byte())
          } else if esc == 47 {
            sb_fast.write_byte(47.to_byte())
          } else if esc == 78 {
            write_utf8_cp(sb_fast, 0x85)
          } else if esc == 95 {
            write_utf8_cp(sb_fast, 0xA0)
          } else if esc == 76 {
            write_utf8_cp(sb_fast, 0x2028)
          } else if esc == 80 {
            write_utf8_cp(sb_fast, 0x2029)
          } else if esc == 120 {
            code_len = 2
          } else if esc == 117 {
            code_len = 4
          } else if esc == 85 {
            code_len = 8
          } else {
            fast_err = true
            let _ = self.fail_at(start_mark, "while parsing a quoted scalar, found unknown escape character")
            break
          }
          ep = ep + 2
          fast_chars = fast_chars + 2
          if code_len > 0 {
            if ep + code_len > len {
              fast_err = true
              let _ = self.fail_at(start_mark, "while parsing a quoted scalar, expected hex digit in escape")
              break
            }
            let mut cp = 0
            let mut hi = 0
            let mut hex_ok = true
            while hi < code_len {
              let hb = src.code_unit_at(ep + hi)
              if !is_hex(hb) {
                hex_ok = false
                break
              }
              cp = (cp << 4) | as_hex(hb)
              hi = hi + 1
            }
            if !hex_ok {
              fast_err = true
              let _ = self.fail_at(start_mark, "while parsing a quoted scalar, expected hex digit in escape")
              break
            }
            if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
              fast_err = true
              let _ = self.fail_at(start_mark, "while parsing a quoted scalar, invalid Unicode scalar value")
              break
            }
            write_utf8_cp(sb_fast, cp)
            ep = ep + code_len
            fast_chars = fast_chars + code_len
          }
          run_start = ep
        } else if eb == 10 || eb == 13 || eb == 0 {
          // Real newline inside double-quoted scalar -> fall back to full multiline slow path
          break
        } else if eb < 0x80 {
          ep = ep + 1
          fast_chars = fast_chars + 1
        } else {
          fast_non_ascii = true
          let clen = utf8_char_len(eb)
          ep = ep + (if ep + clen <= len { clen } else { len - ep })
          fast_chars = fast_chars + 1
        }
      }
      let _ = fast_non_ascii
      if fast_err {
        return Token::empty(tk_err(), start_mark.line, start_mark.col)
      }
      if fast_done {
        if !self.check_trailing_after_quoted(start_mark) {
          return Token::empty(tk_err(), start_mark.line, start_mark.col)
        }
        let sid = self.intern_str(sb_fast.to_string())
        return Token::with_span(tk_scalar_owned(), style, sid, 0, start_mark.line, start_mark.col)
      }
      break
    } else if b < 0x80 {
      p = p + 1
    } else {
      non_ascii = true
      let clen = utf8_char_len(b)
      let adv = if p + clen <= len { clen } else { len - p }
      p = p + adv
      self.index = self.index + 1
      self.col = self.col + 1
    }
  }
  // Restore to after opening quote if fast path didn't finish
  self.pos = fast_start
  self.index = fast_index
  self.col = fast_col

  let sb = StringBuilder::new()
  let mut leading_breaks = 0
  let mut trailing_breaks = 0
  let mut ws_start = 0
  let mut ws_end = 0

  while true {
    if self.col == 0 && self.next_is_doc_indicator() {
      let _ = self.fail_at(start_mark, "while scanning a quoted scalar, found unexpected document indicator")
      return Token::empty(tk_err(), start_mark.line, start_mark.col)
    }
    if is_eof(self.peek_b()) || self.peek_b() == 0 {
      let _ = self.fail_at(start_mark, "while scanning a quoted scalar, found unexpected end of stream")
      return Token::empty(tk_err(), start_mark.line, start_mark.col)
    }
    if self.col < self.indent {
      let _ = self.fail_at(start_mark, "invalid indentation in quoted scalar")
      return Token::empty(tk_err(), start_mark.line, start_mark.col)
    }

    let mut leading_blanks = false
    while self.pos < len {
      let b = src.code_unit_at(self.pos)
      if b == 32 || b == 9 || b == 10 || b == 13 || b == 0 {
        break
      }
      if single && b == 39 && self.peek_b_at(1) == 39 {
        sb.write_byte(39.to_byte())
        self.skip_n_ascii_non_blank(2)
      } else if b == quote_b {
        break
      } else if !single && b == 92 && is_break(self.peek_b_at(1)) {
        self.skip_ascii_non_blank()
        self.skip_linebreak()
        leading_blanks = true
        break
      } else if !single && b == 92 {
        if !self.resolve_escape_sequence(sb, start_mark) {
          return Token::empty(tk_err(), start_mark.line, start_mark.col)
        }
      } else {
        // Bulk-scan contiguous safe bytes (no quote, no backslash in dq, no blank/break)
        let run_start = self.pos
        let mut rp = run_start
        let mut chars = 0
        while rp < len {
          let rb = src.code_unit_at(rp)
          if rb == quote_b || rb == 32 || rb == 9 || rb == 10 || rb == 13 || rb == 0 || (!single && rb == 92) {
            break
          }
          if rb < 0x80 {
            rp = rp + 1
            chars = chars + 1
          } else {
            let clen = utf8_char_len(rb)
            rp = rp + (if rp + clen <= len { clen } else { len - rp })
            chars = chars + 1
          }
        }
        self.pos = rp
        self.index = self.index + chars
        self.col = self.col + chars
        self.leading_whitespace = false
        sb.write_string(src.slice(run_start, rp))
      }
    }

    let cb = self.peek_b()
    if cb == quote_b {
      break
    }

    ws_start = self.pos
    ws_end = self.pos
    while self.pos < len {
      let wb = src.code_unit_at(self.pos)
      if wb == 32 || wb == 9 {
        if leading_blanks {
          if wb == 9 && self.col < self.indent {
            let _ = self.fail("tab cannot be used as indentation")
            return Token::empty(tk_err(), start_mark.line, start_mark.col)
          }
          self.skip_blank()
        } else {
          let w0 = self.pos
          let mut wp = w0 + 1
          while wp < len && (src.code_unit_at(wp) == 32 || src.code_unit_at(wp) == 9) {
            wp = wp + 1
          }
          let d = wp - w0
          self.pos = wp
          self.index = self.index + d
          self.col = self.col + d
          ws_start = w0
          ws_end = wp
        }
      } else if wb == 10 || wb == 13 {
        if leading_blanks {
          self.skip_linebreak()
          trailing_breaks = trailing_breaks + 1
        } else {
          ws_start = 0
          ws_end = 0
          self.skip_linebreak()
          leading_breaks = 1
          leading_blanks = true
        }
      } else {
        break
      }
    }

    if leading_blanks {
      if leading_breaks == 0 {
        if trailing_breaks > 0 {
          write_n_newlines(sb, trailing_breaks)
          trailing_breaks = 0
        }
      } else {
        if trailing_breaks == 0 {
          sb.write_byte(32.to_byte())
        } else {
          write_n_newlines(sb, trailing_breaks)
          trailing_breaks = 0
        }
        leading_breaks = 0
      }
    } else if ws_end > ws_start {
      sb.write_string(src.slice(ws_start, ws_end))
      ws_start = 0
      ws_end = 0
    }
  }

  // Eat closing quote
  self.skip_ascii_non_blank()
  if !self.check_trailing_after_quoted(start_mark) {
    return Token::empty(tk_err(), start_mark.line, start_mark.col)
  }
  let sid = self.intern_str(sb.to_string())
  Token::with_span(tk_scalar_owned(), style, sid, 0, start_mark.line, start_mark.col)
}

///|
fn Scanner::check_trailing_after_quoted(self : Scanner, start_mark : Marker) -> Bool {
  if self.skip_ws_to_eol(true) < 0 {
    return false
  }
  let b = self.peek_b()
  if self.flow_level > 0 && (b == 44 || b == 125 || b == 93) {
    true
  } else if is_breakz(b) {
    true
  } else if b == 58 && self.flow_level == 0 && start_mark.line == self.line {
    true
  } else if b == 58 && self.flow_level > 0 {
    true
  } else {
    self.fail("invalid trailing content after quoted scalar")
  }
}

///|
fn Scanner::resolve_escape_sequence(self : Scanner, sb : StringBuilder, start_mark : Marker) -> Bool {
  let esc = self.peek_b_at(1)
  let mut code_len = 0
  if esc == 48 {
    sb.write_byte(0.to_byte())
  } else if esc == 97 {
    sb.write_byte(7.to_byte())
  } else if esc == 98 {
    sb.write_byte(8.to_byte())
  } else if esc == 116 || esc == 9 {
    sb.write_byte(9.to_byte())
  } else if esc == 110 {
    sb.write_byte(10.to_byte())
  } else if esc == 118 {
    sb.write_byte(11.to_byte())
  } else if esc == 102 {
    sb.write_byte(12.to_byte())
  } else if esc == 114 {
    sb.write_byte(13.to_byte())
  } else if esc == 101 {
    sb.write_byte(27.to_byte())
  } else if esc == 32 {
    sb.write_byte(32.to_byte())
  } else if esc == 34 {
    sb.write_byte(34.to_byte())
  } else if esc == 47 {
    sb.write_byte(47.to_byte())
  } else if esc == 92 {
    sb.write_byte(92.to_byte())
  } else if esc == 78 {
    write_utf8_cp(sb, 0x85)
  } else if esc == 95 {
    write_utf8_cp(sb, 0xA0)
  } else if esc == 76 {
    write_utf8_cp(sb, 0x2028)
  } else if esc == 80 {
    write_utf8_cp(sb, 0x2029)
  } else if esc == 120 {
    code_len = 2
  } else if esc == 117 {
    code_len = 4
  } else if esc == 85 {
    code_len = 8
  } else {
    return self.fail_at(start_mark, "while parsing a quoted scalar, found unknown escape character")
  }
  self.skip_n_ascii_non_blank(2)

  if code_len > 0 {
    let mut cp = 0
    let mut i = 0
    while i < code_len {
      let hb = self.peek_b_at(i)
      if !is_hex(hb) {
        return self.fail_at(start_mark, "while parsing a quoted scalar, expected hex digit in escape")
      }
      cp = (cp << 4) | as_hex(hb)
      i = i + 1
    }
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return self.fail_at(start_mark, "while parsing a quoted scalar, invalid Unicode scalar value")
    }
    write_utf8_cp(sb, cp)
    self.skip_n_ascii_non_blank(code_len)
  }
  true
}

///|
fn Scanner::fetch_plain_scalar(self : Scanner) -> Bool {
  // Fused block simple-key + ':' fast path: avoids SimpleKey save/check,
  // second fetch_next_token call, and insert_token array shifts for ~95% of mapping keys!
  if self.flow_level == 0 && self.simple_key_allowed {
    let b0 = self.peek_b()
    if b0 >= 33 && b0 < 0x80 && b0 != 35 && !(self.col == 0 && self.next_is_doc_indicator()) && self.next_can_be_plain_scalar(false) {
      let src = self.src
      let len = self.len
      let fast_start = self.pos
      let mut p = fast_start
      let mut non_blank_end = fast_start
      let mut hit_colon = false
      while p < len {
        let b = src.code_unit_at(p)
        if b == 58 {
          let nnb = if p + 1 < len { src.code_unit_at(p + 1) } else { -1 }
          if nnb == 32 || nnb == 10 || nnb == 13 || nnb < 0 {
            hit_colon = true
            break
          }
          p = p + 1
          non_blank_end = p
        } else if b == 32 {
          let mut q = p + 1
          while q < len && src.code_unit_at(q) == 32 {
            q = q + 1
          }
          let nb = if q < len { src.code_unit_at(q) } else { -1 }
          if nb == 58 {
            let nnb = if q + 1 < len { src.code_unit_at(q + 1) } else { -1 }
            if nnb == 32 || nnb == 10 || nnb == 13 || nnb < 0 {
              p = q
              hit_colon = true
              break
            }
            p = q
          } else if nb == 35 || nb < 32 || nb >= 0x80 {
            break
          } else {
            p = q
          }
        } else if b < 32 || b >= 0x80 {
          break
        } else {
          p = p + 1
          non_blank_end = p
        }
      }
      if hit_colon && non_blank_end > fast_start && p - fast_start <= 1024 {
        let start_line = self.line
        let start_col = self.col
        let adv = p - fast_start
        self.unroll_non_block_indents()
        self.roll_indent(start_col, -1, tk_block_map_start(), start_line, start_col)
        self.push_token(Token::empty(tk_key(), start_line, start_col))
        self.push_token(Token::with_span(tk_scalar_slice(), style_plain(), fast_start, non_blank_end, start_line, start_col))
        self.pos = p + 1
        self.index = self.index + adv + 1
        self.col = start_col + adv + 1
        self.leading_whitespace = false
        self.simple_key_allowed = false
        if self.simple_keys.length() > 0 {
          let sk = self.simple_keys[self.simple_keys.length() - 1]
          if sk.possible {
            self.simple_keys[self.simple_keys.length() - 1] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
          }
        }
        self.roll_one_col_indent()
        self.push_token(Token::empty(tk_value(), start_line, start_col + adv))
        return true
      }
    }
  }
  self.save_simple_key()
  self.simple_key_allowed = false
  self.scan_plain_scalar()
}

///|
fn Scanner::scan_plain_scalar(self : Scanner) -> Bool {
  self.unroll_non_block_indents()
  let plain_indent = self.indent + 1
  let start_mark = self.mark()

  if self.flow_level > 0 && start_mark.col < plain_indent {
    return self.fail_at(start_mark, "invalid indentation in flow construct")
  }

  let in_flow = self.flow_level > 0

  // Zero-allocation fast path for single-line ASCII plain scalars (including internal spaces!).
  // Handles >98% of keys and values in K8s/CI/OpenAPI YAML without touching a StringBuilder or slicing.
  let b0 = self.peek_b()
  if b0 >= 33 && b0 < 0x80 && b0 != 35 && !(in_flow && b0 == 45 && is_flow(self.peek_b_at(1))) &&
  !(self.col == 0 && self.next_is_doc_indicator()) && self.next_can_be_plain_scalar(in_flow) {
    let src = self.src
    let len = self.len
    let fast_start = self.pos
    let mut p = fast_start
    let mut non_blank_end = fast_start
    let mut fast_ok = true
    while p < len {
      let b = src.code_unit_at(p)
      if b == 32 {
        let mut q = p + 1
        while q < len && src.code_unit_at(q) == 32 {
          q = q + 1
        }
        let nb = if q < len { src.code_unit_at(q) } else { -1 }
        if nb == 10 {
          p = q
          break
        } else if nb < 0 {
          p = q
          break
        } else if nb == 58 {
          let nnb = if q + 1 < len { src.code_unit_at(q + 1) } else { -1 }
          if is_blank_or_breakz(nnb) || (in_flow && is_flow(nnb)) {
            p = q
            break
          }
          p = q
        } else if in_flow && is_flow(nb) {
          p = q
          break
        } else if nb == 35 || nb < 32 || nb >= 0x80 || (in_flow && nb == 45) {
          fast_ok = false
          break
        } else {
          p = q
        }
      } else if b == 10 {
        break
      } else if b < 32 || b >= 0x80 {
        fast_ok = false
        break
      } else if b == 58 {
        let nb = if p + 1 < len { src.code_unit_at(p + 1) } else { -1 }
        if is_blank_or_breakz(nb) || (in_flow && is_flow(nb)) {
          break
        }
        p = p + 1
        non_blank_end = p
      } else if in_flow && is_flow(b) {
        break
      } else {
        p = p + 1
        non_blank_end = p
      }
    }
    if fast_ok && non_blank_end > fast_start {
      let nb = if p < len { src.code_unit_at(p) } else { -1 }
      if nb == 10 && !in_flow {
        // Check if next line has col < plain_indent (plain scalar definitely ends at this '\n')
        let mut q = p + 1
        let mut next_col = 0
        while q < len && src.code_unit_at(q) == 32 {
          q = q + 1
          next_col = next_col + 1
        }
        let qb = if q < len { src.code_unit_at(q) } else { -1 }
        if next_col < plain_indent && qb != 10 && qb != 13 && qb != 9 {
          let adv = p - fast_start
          self.pos = q
          self.index = self.index + adv + 1 + next_col
          self.line = self.line + 1
          self.col = next_col
          self.leading_whitespace = true
          self.simple_key_allowed = true
          self.push_token(Token::with_span(tk_scalar_slice(), style_plain(), fast_start, non_blank_end, start_mark.line, start_mark.col))
          return true
        }
      } else if (nb == 58 && {
        let nnb = if p + 1 < len { src.code_unit_at(p + 1) } else { -1 }
        is_blank_or_breakz(nnb) || (in_flow && is_flow(nnb))
      }) || (in_flow && is_flow(nb)) || nb < 0 {
        let adv = p - fast_start
        self.pos = p
        self.index = self.index + adv
        self.col = self.col + adv
        self.leading_whitespace = false
        self.push_token(Token::with_span(tk_scalar_slice(), style_plain(), fast_start, non_blank_end, start_mark.line, start_mark.col))
        return true
      }
    }
  }

  let sb = StringBuilder::new()
  let mut has_content = false
  let mut single_slice_start = -1
  let mut single_slice_end = -1
  let mut use_sb = false

  let mut ws_start = 0
  let mut ws_end = 0
  let mut leading_breaks = 0
  let mut trailing_breaks = 0
  let src = self.src
  let len = self.len

  while true {
    if (self.col == 0 && self.next_is_doc_indicator()) || self.peek_b() == 35 {
      if self.peek_b() == 35 && has_content && ws_end > ws_start && !in_flow {
        self.has_interrupted_plain = true
        self.interrupted_plain_mark = self.mark()
      }
      break
    }

    if in_flow && self.peek_b() == 45 && is_flow(self.peek_b_at(1)) {
      return self.fail("plain scalar cannot start with '-' followed by flow indicator")
    }

    if !is_blank_or_breakz(self.peek_b()) && self.next_can_be_plain_scalar(in_flow) {
      if self.leading_whitespace {
        if !use_sb && has_content {
          sb.write_string(src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        if leading_breaks == 0 {
          if trailing_breaks > 0 {
            write_n_newlines(sb, trailing_breaks)
            trailing_breaks = 0
          }
        } else {
          if trailing_breaks == 0 {
            sb.write_byte(32.to_byte())
          } else {
            write_n_newlines(sb, trailing_breaks)
            trailing_breaks = 0
          }
          leading_breaks = 0
        }
        self.leading_whitespace = false
      } else if ws_end > ws_start {
        if !use_sb && has_content {
          sb.write_string(src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        sb.write_string(src.slice(ws_start, ws_end))
        ws_start = 0
        ws_end = 0
      }

      let seg_start = self.pos
      while !is_blank_or_breakz(self.peek_b()) && self.next_can_be_plain_scalar(in_flow) {
        let b = self.peek_b()
        if b < 0x80 {
          self.pos = self.pos + 1
          self.index = self.index + 1
          self.col = self.col + 1
          self.leading_whitespace = false
        } else {
          self.skip_char_non_blank()
        }
      }
      if !has_content {
        single_slice_start = seg_start
        single_slice_end = self.pos
        has_content = true
      } else {
        if !use_sb {
          sb.write_string(src.slice(single_slice_start, single_slice_end))
          use_sb = true
        }
        sb.write_string(src.slice(seg_start, self.pos))
      }
    }

    if !is_blank_or_break(self.peek_b()) {
      break
    }

    ws_start = 0
    ws_end = 0
    while is_blank_or_break(self.peek_b()) {
      let wb = self.peek_b()
      if is_blank(wb) {
        if !self.leading_whitespace {
          let w0 = self.pos
          let mut wp = w0 + 1
          while wp < len && (src.code_unit_at(wp) == 32 || src.code_unit_at(wp) == 9) {
            wp = wp + 1
          }
          let d = wp - w0
          self.pos = wp
          self.index = self.index + d
          self.col = self.col + d
          ws_start = w0
          ws_end = wp
        } else if self.col < plain_indent && wb == 9 {
          if self.skip_ws_to_eol(true) < 0 {
            return false
          }
          if !is_breakz(self.peek_b()) {
            return self.fail("while scanning a plain scalar, found a tab in indentation")
          }
        } else {
          self.skip_blank()
        }
      } else {
        if self.leading_whitespace {
          self.skip_linebreak()
          trailing_breaks = trailing_breaks + 1
        } else {
          ws_start = 0
          ws_end = 0
          self.skip_linebreak()
          leading_breaks = 1
          self.leading_whitespace = true
        }
      }
    }

    if !in_flow && self.col < plain_indent {
      break
    }
  }

  if self.leading_whitespace {
    self.simple_key_allowed = true
  }

  if !has_content {
    self.fail_at(start_mark, "unexpected end of plain scalar")
  } else if use_sb {
    let sid = self.intern_str(sb.to_string())
    self.push_token(Token::with_span(tk_scalar_owned(), style_plain(), sid, 0, start_mark.line, start_mark.col))
    true
  } else {
    self.push_token(Token::with_span(tk_scalar_slice(), style_plain(), single_slice_start, single_slice_end, start_mark.line, start_mark.col))
    true
  }
}

///|
fn Scanner::fetch_key(self : Scanner) -> Bool {
  let line = self.line
  let col = self.col
  if self.flow_level == 0 {
    if !self.simple_key_allowed {
      return self.fail("mapping keys are not allowed in this context")
    }
    self.roll_indent(col, -1, tk_block_map_start(), line, col)
  } else if self.flow_mapping_started.length() > 0 {
    self.flow_mapping_started[self.flow_mapping_started.length() - 1] = true
  }

  if !self.remove_simple_key() {
    return false
  }
  self.simple_key_allowed = self.flow_level == 0

  self.skip_ascii_non_blank()
  if !self.skip_yaml_whitespace() {
    return false
  }
  if self.peek_b() == 9 {
    return self.fail("tabs disallowed in this context")
  }
  self.push_token(Token::empty(tk_key(), line, col))
  true
}

///|
fn Scanner::fetch_flow_value(self : Scanner) -> Bool {
  let nb = self.peek_b_at(1)
  if self.index != self.adjacent_value_allowed_at && (nb == 91 || nb == 123) {
    return self.fail("':' may not precede '[' or '{' without space in flow mapping")
  }
  self.fetch_value()
}

///|
fn Scanner::fetch_value(self : Scanner) -> Bool {
  let sk_len = self.simple_keys.length()
  if sk_len == 0 {
    return self.fail("simple key expected")
  }
  let sk_idx = sk_len - 1
  let sk = self.simple_keys[sk_idx]
  let start_line = self.line
  let start_col = self.col

  let mut is_implicit_flow_mapping = false
  let flen = self.flow_mapping_started.length()
  if flen > 0 && !self.flow_mapping_started[flen - 1] && self.implicit_flow_mapping_states[flen - 1] != implicit_none() {
    self.implicit_flow_mapping_states[flen - 1] = implicit_inside()
    is_implicit_flow_mapping = true
  }

  // Skip ':'
  self.skip_ascii_non_blank()
  if self.peek_b() == 9 {
    let ws_flags = self.skip_ws_to_eol(true)
    if ws_flags < 0 {
      return false
    }
    let has_ws = (ws_flags & 2) != 0
    let nb = self.peek_b()
    if !has_ws && (nb == 45 || is_alpha_yaml(nb)) {
      return self.fail("':' must be followed by valid YAML whitespace")
    }
  }

  if sk.possible {
    let rel = sk.token_number - self.tokens_parsed
    self.insert_token(rel, Token::empty(tk_key(), sk.mark.line, sk.mark.col))
    if is_implicit_flow_mapping {
      if sk.mark.line < start_line {
        return self.fail_lc(start_line, start_col, "illegal placement of ':' indicator")
      }
      self.insert_token(rel, Token::empty(tk_flow_map_start(), sk.mark.line, sk.mark.col))
    }

    self.roll_indent(sk.mark.col, sk.token_number, tk_block_map_start(), sk.mark.line, sk.mark.col)
    self.roll_one_col_indent()

    self.simple_keys[sk_idx] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
    self.simple_key_allowed = false
  } else {
    if is_implicit_flow_mapping {
      self.push_token(Token::empty(tk_flow_map_start(), start_line, start_col))
    }
    if self.flow_level == 0 {
      if !self.simple_key_allowed {
        return self.fail_lc(start_line, start_col, "mapping values are not allowed in this context")
      }
      self.roll_indent(start_col, -1, tk_block_map_start(), start_line, start_col)
    }
    self.roll_one_col_indent()
    self.simple_key_allowed = self.flow_level == 0
  }

  self.push_token(Token::empty(tk_value(), start_line, start_col))
  true
}

///|
fn Scanner::roll_indent(self : Scanner, col : Int, number : Int, kind : Int, line : Int, mcol : Int) -> Unit {
  if self.flow_level > 0 {
    return
  }
  if self.indent <= col && self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if !last.needs_block_end {
      self.indent = last.indent
      let _ = self.indents.pop()
    }
  }
  if self.indent < col {
    self.indents.push(IndentEntry::{ indent: self.indent, needs_block_end: true })
    self.indent = col
    let tok = Token::empty(kind, line, mcol)
    if number >= 0 {
      self.insert_token(number - self.tokens_parsed, tok)
    } else {
      self.push_token(tok)
    }
  }
}

///|
fn Scanner::unroll_indent(self : Scanner, col : Int) -> Unit {
  if self.flow_level > 0 {
    return
  }
  while self.indent > col && self.indents.length() > 0 {
    let entry = self.indents[self.indents.length() - 1]
    let _ = self.indents.pop()
    self.indent = entry.indent
    if entry.needs_block_end {
      self.push_token(Token::empty(tk_block_end(), self.line, self.col))
    }
  }
}

///|
fn Scanner::roll_one_col_indent(self : Scanner) -> Unit {
  if self.flow_level == 0 && self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if last.needs_block_end {
      self.indents.push(IndentEntry::{ indent: self.indent, needs_block_end: false })
      self.indent = self.indent + 1
    }
  }
}

///|
fn Scanner::unroll_non_block_indents(self : Scanner) -> Unit {
  while self.indents.length() > 0 {
    let last = self.indents[self.indents.length() - 1]
    if last.needs_block_end {
      break
    }
    self.indent = last.indent
    let _ = self.indents.pop()
  }
}

///|
fn Scanner::save_simple_key(self : Scanner) -> Unit {
  if self.simple_key_allowed {
    let required = self.flow_level == 0 &&
    self.indent == self.col &&
    self.indents.length() > 0 &&
    self.indents[self.indents.length() - 1].needs_block_end
    let sk = SimpleKey::{
      possible: true,
      required: required,
      token_number: self.tokens_parsed + (self.tokens.length() - self.token_head),
      mark: Marker::new(self.index, self.line, self.col),
    }
    let n = self.simple_keys.length()
    if n > 0 {
      self.simple_keys[n - 1] = sk
    } else {
      self.simple_keys.push(sk)
    }
  }
}

///|
fn Scanner::remove_simple_key(self : Scanner) -> Bool {
  let n = self.simple_keys.length()
  if n == 0 {
    return self.fail("simple key expected")
  }
  let sk = self.simple_keys[n - 1]
  if sk.possible && sk.required {
    return self.fail("simple key expected")
  }
  self.simple_keys[n - 1] = SimpleKey::{ possible: false, required: sk.required, token_number: sk.token_number, mark: sk.mark }
  true
}

///|
fn Scanner::end_implicit_mapping(self : Scanner, line : Int, col : Int) -> Unit {
  let n = self.implicit_flow_mapping_states.length()
  if n > 0 && self.implicit_flow_mapping_states[n - 1] == implicit_inside() {
    self.flow_mapping_started[n - 1] = false
    self.implicit_flow_mapping_states[n - 1] = implicit_possible()
    self.push_token(Token::empty(tk_flow_map_end(), line, col))
  }
}
