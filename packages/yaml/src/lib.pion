///| Pure Pion YAML 1.2 parser, emitter, and canonical JSON serializer.

///| Parse a single YAML 1.2 document from `src`.
///| Returns `Ok(YamlValue::Null)` for an empty or comment-only stream.
pub fn parse(src : String) -> Result[YamlValue, YamlError] {
  let _ = src
  Err(YamlError::new(1, 1, "not implemented"))
}

///| Parse all YAML 1.2 documents from `src`.
///| Returns `Ok([])` for an empty or comment-only stream.
pub fn parse_all(src : String) -> Result[Array[YamlValue], YamlError] {
  let _ = src
  Err(YamlError::new(1, 1, "not implemented"))
}

///| Serialize a `YamlValue` into a valid YAML 1.2 string.
pub fn stringify(v : YamlValue) -> String {
  let _ = v
  ""
}

///| Serialize a `YamlValue` into deterministic canonical JSON (UTF-8 sorted object keys, compact).
pub fn to_canonical_json(v : YamlValue) -> String {
  let _ = v
  ""
