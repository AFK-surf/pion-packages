///| Pure Pion IEEE-754 binary64 shortest round-trip decimal formatter (Dragon4).
///| Guarantees bit-exact round-trip for every finite `Double` (normals, subnormals,
///| DBL_MAX, DBL_MIN, 0.30000000000000004, etc.) with zero external dependencies.

///| Base 2^30 = 1073741824 (fits comfortably in signed Int64 without overflow during * 5^12).
fn big_base() -> Int64 {
  1073741824L
}

///|
fn big_mask() -> Int64 {
  1073741823L
}

///|
fn big_trim(a : Array[Int64]) -> Unit {
  while a.length() > 1 && a[a.length() - 1] == 0L {
    let _ = a.pop()
  }
}

///|
fn big_from_i64(v : Int64) -> Array[Int64] {
  let out : Array[Int64] = []
  let mut x = v
  if x == 0L {
    out.push(0L)
    return out
  }
  while x > 0L {
    out.push(x & big_mask())
    x = x >> 30
  }
  out
}

///|
fn big_mul_small(a : Array[Int64], m : Int64) -> Unit {
  let mut carry : Int64 = 0L
  let n = a.length()
  let mut i = 0
  while i < n {
    let prod = a[i] * m + carry
    a[i] = prod & big_mask()
    carry = prod >> 30
    i = i + 1
  }
  while carry > 0L {
    a.push(carry & big_mask())
    carry = carry >> 30
  }
}

///|
fn big_shift_left(a : Array[Int64], bits : Int) -> Unit {
  if bits <= 0 || (a.length() == 1 && a[0] == 0L) {
    return
  }
  let word_shift = bits / 30
  let bit_shift = bits % 30
  if bit_shift > 0 {
    let rshift = 30 - bit_shift
    let mut carry : Int64 = 0L
    let n = a.length()
    let mut i = 0
    while i < n {
      let cur = a[i]
      a[i] = ((cur << bit_shift) | carry) & big_mask()
      carry = cur >> rshift
      i = i + 1
    }
    if carry > 0L {
      a.push(carry)
    }
  }
  if word_shift > 0 {
    let old_n = a.length()
    let mut k = 0
    while k < word_shift {
      a.push(0L)
      k = k + 1
    }
    let mut i = old_n - 1
    while i >= 0 {
      a[i + word_shift] = a[i]
      if i == 0 {
        break
      }
      i = i - 1
    }
    let mut j = 0
    while j < word_shift {
      a[j] = 0L
      j = j + 1
    }
  }
}

///|
fn big_mul_pow5(a : Array[Int64], exp5 : Int) -> Unit {
  let mut p = exp5
  // 5^12 = 244140625 (< 2^28), so limb * 5^12 < 2^58 < 2^63 (no overflow).
  while p >= 12 {
    big_mul_small(a, 244140625L)
    p = p - 12
  }
  if p > 0 {
    let mut m : Int64 = 1L
    let mut i = 0
    while i < p {
      m = m * 5L
      i = i + 1
    }
    big_mul_small(a, m)
  }
}

///|
fn big_mul_pow10(a : Array[Int64], exp10 : Int) -> Unit {
  if exp10 <= 0 {
    return
  }
  big_mul_pow5(a, exp10)
  big_shift_left(a, exp10)
}

///|
fn big_cmp(a : Array[Int64], b : Array[Int64]) -> Int {
  let na = a.length()
  let nb = b.length()
  if na != nb {
    return if na < nb { -1 } else { 1 }
  }
  let mut i = na - 1
  while i >= 0 {
    let va = a[i]
    let vb = b[i]
    if va != vb {
      return if va < vb { -1 } else { 1 }
    }
    if i == 0 {
      break
    }
    i = i - 1
  }
  0
}

///|
fn big_add(a : Array[Int64], b : Array[Int64]) -> Array[Int64] {
  let na = a.length()
  let nb = b.length()
  let max_n = if na > nb { na } else { nb }
  let out : Array[Int64] = []
  let mut carry : Int64 = 0L
  let mut i = 0
  while i < max_n {
    let va = if i < na { a[i] } else { 0L }
    let vb = if i < nb { b[i] } else { 0L }
    let sum = va + vb + carry
    out.push(sum & big_mask())
    carry = sum >> 30
    i = i + 1
  }
  if carry > 0L {
    out.push(carry)
  }
  out
}

///| Subtract `b` from `a` in place (requires `a >= b`).
fn big_sub_inplace(a : Array[Int64], b : Array[Int64]) -> Unit {
  let na = a.length()
  let nb = b.length()
  let mut borrow : Int64 = 0L
  let mut i = 0
  while i < na {
    let vb = if i < nb { b[i] } else { 0L }
    let mut diff = a[i] - vb - borrow
    if diff < 0L {
      diff = diff + big_base()
      borrow = 1L
    } else {
      borrow = 0L
    }
    a[i] = diff
    i = i + 1
  }
  big_trim(a)
}

///| Compute `q = floor(r / s)` (where `0 <= q <= 9`) and replace `r` with `r - q * s`.
fn big_divmod_digit(r : Array[Int64], s : Array[Int64]) -> Int {
  let mut q = 0
  while big_cmp(r, s) >= 0 {
    big_sub_inplace(r, s)
    q = q + 1
  }
  q
}

///| Bit length of a positive Int64 (1..63).
fn i64_bit_len(v : Int64) -> Int {
  let mut x = v
  let mut n = 0
  while x > 0L {
    x = x >> 1
    n = n + 1
  }
  n
}

///| Write a finite IEEE-754 `Double` into `sb` using shortest round-trip decimal digits.
///| When `ensure_float` is true, guarantees `.` or `e` is present (e.g. `2.0`, `-0.0`)
///| so YAML 1.2 Core Schema parses it back as `Float` rather than `Int`.
fn write_finite_double(sb : StringBuilder, f : Double, ensure_float : Bool) -> Unit {
  let bits = f.to_bits()
  let neg = ((bits >> 63) & 1L) != 0L
  let raw_exp = ((bits >> 52) & 0x7FFL).to_int()
  let raw_frac = bits & 0x000FFFFFFFFFFFFFL

  if raw_exp == 0 && raw_frac == 0L {
    if neg {
      sb.write_byte(45.to_byte())
    }
    if ensure_float {
      sb.write_string("0.0")
    } else {
      sb.write_byte(48.to_byte())
    }
    return
  }

  if neg {
    sb.write_byte(45.to_byte())
  }

  let mantissa : Int64 = if raw_exp != 0 { (1L << 52) | raw_frac } else { raw_frac }
  let exp2 : Int = if raw_exp != 0 { raw_exp - 1075 } else { -1074 }
  let low_margin_smaller = raw_frac == 0L && raw_exp > 1
  let accept_bounds = (mantissa & 1L) == 0L

  // Set up exact Dragon4 rational state (r / s) with margins (m_minus / s, m_plus / s).
  let r = big_from_i64(mantissa)
  let s = big_from_i64(1L)
  let m_plus = big_from_i64(1L)
  let m_minus = big_from_i64(1L)

  if exp2 >= 0 {
    if low_margin_smaller {
      big_shift_left(r, exp2 + 2)
      big_shift_left(s, 2)
      big_shift_left(m_plus, exp2 + 1)
      big_shift_left(m_minus, exp2)
    } else {
      big_shift_left(r, exp2 + 1)
      big_shift_left(s, 1)
      big_shift_left(m_plus, exp2)
      big_shift_left(m_minus, exp2)
    }
  } else {
    if low_margin_smaller {
      big_shift_left(r, 2)
      big_shift_left(s, 2 - exp2)
      big_shift_left(m_plus, 1)
    } else {
      big_shift_left(r, 1)
      big_shift_left(s, 1 - exp2)
    }
  }

  // Estimate k = ceil(log10(v)) using log10(2) ≈ 78913 / 262144.
  let log2_v = i64_bit_len(mantissa) - 1 + exp2
  let prod_k = log2_v * 78913
  let mut k = if prod_k >= 0 { prod_k / 262144 } else { (prod_k - 262143) / 262144 } + 1

  if k > 0 {
    big_mul_pow10(s, k)
  } else if k < 0 {
    let p = 0 - k
    big_mul_pow10(r, p)
    big_mul_pow10(m_plus, p)
    big_mul_pow10(m_minus, p)
  }

  // Adjust k so that (r + m_plus) / s is in [0.1, 1.0) (or <= 1.0 when accept_bounds).
  while true {
    let r_plus = big_add(r, m_plus)
    let cmp_hi = big_cmp(r_plus, s)
    let too_high = if accept_bounds { cmp_hi >= 0 } else { cmp_hi > 0 }
    if too_high {
      k = k + 1
      big_mul_small(s, 10L)
    } else {
      break
    }
  }
  while true {
    let r_plus = big_add(r, m_plus)
    big_mul_small(r_plus, 10L)
    let cmp_lo = big_cmp(r_plus, s)
    let too_low = if accept_bounds { cmp_lo < 0 } else { cmp_lo <= 0 }
    if too_low {
      k = k - 1
      big_mul_small(r, 10L)
      big_mul_small(m_plus, 10L)
      big_mul_small(m_minus, 10L)
    } else {
      break
    }
  }

  let exp10 = k - 1
  let digits : Array[Int] = []

  while true {
    big_mul_small(r, 10L)
    big_mul_small(m_plus, 10L)
    big_mul_small(m_minus, 10L)
    let q = big_divmod_digit(r, s)
    let cmp_lo = big_cmp(r, m_minus)
    let low = if accept_bounds { cmp_lo <= 0 } else { cmp_lo < 0 }
    let r_plus = big_add(r, m_plus)
    let cmp_hi = big_cmp(r_plus, s)
    let high = if accept_bounds { cmp_hi >= 0 } else { cmp_hi > 0 }

    if !low && !high {
      digits.push(q)
    } else if low && !high {
      digits.push(q)
      break
    } else if !low && high {
      digits.push(q + 1)
      break
    } else {
      let two_r = big_add(r, r)
      let cmp_mid = big_cmp(two_r, s)
      if cmp_mid < 0 || (cmp_mid == 0 && (q & 1) == 0) {
        digits.push(q)
      } else {
        digits.push(q + 1)
      }
      break
    }
  }

  let nd = digits.length()
  if exp10 >= 0 && exp10 < 16 {
    if nd <= exp10 + 1 {
      let mut i = 0
      while i < nd {
        sb.write_byte((48 + digits[i]).to_byte())
        i = i + 1
      }
      let mut z = nd
      while z < exp10 + 1 {
        sb.write_byte(48.to_byte())
        z = z + 1
      }
      if ensure_float {
        sb.write_string(".0")
      }
    } else {
      let int_len = exp10 + 1
      let mut i = 0
      while i < int_len {
        sb.write_byte((48 + digits[i]).to_byte())
        i = i + 1
      }
      sb.write_byte(46.to_byte())
      while i < nd {
        sb.write_byte((48 + digits[i]).to_byte())
        i = i + 1
      }
    }
  } else if exp10 >= -4 && exp10 < 0 {
    sb.write_string("0.")
    let zeros = 0 - exp10 - 1
    let mut z = 0
    while z < zeros {
      sb.write_byte(48.to_byte())
      z = z + 1
    }
    let mut i = 0
    while i < nd {
      sb.write_byte((48 + digits[i]).to_byte())
      i = i + 1
    }
  } else {
    sb.write_byte((48 + digits[0]).to_byte())
    if nd > 1 {
      sb.write_byte(46.to_byte())
      let mut i = 1
      while i < nd {
        sb.write_byte((48 + digits[i]).to_byte())
        i = i + 1
      }
    }
    sb.write_byte(101.to_byte())
    if exp10 >= 0 {
      sb.write_byte(43.to_byte())
      write_i64(sb, exp10.to_int64())
    } else {
      sb.write_byte(45.to_byte())
      write_i64(sb, (0 - exp10).to_int64())
    }
  }
}

///| Format a finite `Double` to its shortest round-trip decimal `String`.
fn format_finite_double(f : Double, ensure_float : Bool) -> String {
  let sb = StringBuilder::new()
  write_finite_double(sb, f, ensure_float)
  sb.to_string()
}
