///| Core YAML 1.2 value tree and error types for the `yaml` package.

///| Immutable YAML 1.2 value tree (`Send`-safe, zero `World` dependency).
pub enum YamlValue {
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  Seq(Array[YamlValue])
  Map(Array[(YamlValue, YamlValue)])
}

///| Structured YAML parse error with 1-based line and column numbers.
pub struct YamlError {
  pub line : Int
  pub col : Int
  pub message : String
}

///| Construct a `YamlError`.
pub fn YamlError::new(line : Int, col : Int, message : String) -> YamlError {
  YamlError::{ line: line, col: col, message: message }
}
