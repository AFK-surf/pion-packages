///| YAML 1.2 Emitter (`stringify`) and Canonical JSON Serializer (`to_canonical_json`).

///| Hex digit byte for 0..15.
fn hex_digit_lower(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

///| Write an `Int64` directly into `sb` without allocating a temporary `String`.
fn write_i64(sb : StringBuilder, n : Int64) -> Unit {
  if n == 0L {
    sb.write_byte(48.to_byte())
    return
  }
  if n == -9223372036854775807L - 1L {
    sb.write_string("-9223372036854775808")
    return
  }
  let mut v = n
  if v < 0L {
    sb.write_byte(45.to_byte())
    v = 0L - v
  }
  if v < 10L {
    sb.write_byte((48 + v.to_int()).to_byte())
    return
  }
  if v < 100L {
    let q = (v / 10L).to_int()
    let r = (v - q.to_int64() * 10L).to_int()
    sb.write_byte((48 + q).to_byte())
    sb.write_byte((48 + r).to_byte())
    return
  }
  if v < 1000L {
    let d0 = (v / 100L).to_int()
    let rem = (v - d0.to_int64() * 100L).to_int()
    sb.write_byte((48 + d0).to_byte())
    sb.write_byte((48 + rem / 10).to_byte())
    sb.write_byte((48 + rem % 10).to_byte())
    return
  }
  if v < 10000L {
    let d0 = (v / 1000L).to_int()
    let rem = (v - d0.to_int64() * 1000L).to_int()
    sb.write_byte((48 + d0).to_byte())
    sb.write_byte((48 + rem / 100).to_byte())
    sb.write_byte((48 + (rem / 10) % 10).to_byte())
    sb.write_byte((48 + rem % 10).to_byte())
    return
  }
  let buf : FixedArray[Byte] = FixedArray::make(20, 0.to_byte())
  let mut idx = 20
  while v > 0L {
    idx = idx - 1
    let q = v / 10L
    let r = (v - q * 10L).to_int()
    buf[idx] = (48 + r).to_byte()
    v = q
  }
  while idx < 20 {
    sb.write_byte(buf[idx])
    idx = idx + 1
  }
}

///| Write a JSON-escaped string (with surrounding double quotes) to `sb`.
fn write_json_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 || b < 32 {
      if mark < i {
        sb.write_string(s.slice(mark, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_digit_lower((b >> 4) & 0xF))
        sb.write_byte(hex_digit_lower(b & 0xF))
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark == 0 {
    sb.write_string(s)
  } else if mark < n {
    sb.write_string(s.slice(mark, n))
  }
  sb.write_byte(34.to_byte())
}

///| Convert any `YamlValue` key into a string for JSON object keys.
fn key_to_json_string(k : YamlValue) -> String {
  match k {
    YamlValue::Str(s) => s
    YamlValue::Null => "null"
    YamlValue::Bool(b) => if b { "true" } else { "false" }
    YamlValue::Int(n) => n.to_string()
    YamlValue::Float(f) => format_json_float(f)
    _ => to_canonical_json_impl(k)
  }
}

///| Format a `Double` for canonical JSON (`null` for NaN/Inf).
fn format_json_float(f : Double) -> String {
  if f != f || f == 1.0 / 0.0 || f == -1.0 / 0.0 {
    return "null"
  }
  f.to_string()
}

///| Lexicographical UTF-8 byte comparison of two strings.
fn str_lt(a : String, b : String) -> Bool {
  let na = a.length()
  let nb = b.length()
  let min_n = if na < nb { na } else { nb }
  let mut i = 0
  while i < min_n {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  na < nb
}

///| Sort `(String, YamlValue)` pairs by key in ascending UTF-8 order.
///| Insertion sort for `n <= 24` is stable (preserves last-key-wins order).
fn sort_kv_pairs(arr : Array[(String, YamlValue)]) -> Unit {
  let n = arr.length()
  if n <= 1 {
    return
  }
  if n <= 24 {
    let mut i = 1
    while i < n {
      let cur = arr[i]
      let (cur_k, _) = cur
      let mut j = i
      while j > 0 {
        let (prev_k, _) = arr[j - 1]
        if str_lt(cur_k, prev_k) {
          arr[j] = arr[j - 1]
          j = j - 1
        } else {
          break
        }
      }
      arr[j] = cur
      i = i + 1
    }
    return
  }
  // Heapsort (O(n log n) worst-case, zero recursion, zero extra allocations)
  let mut start = (n - 2) / 2
  while start >= 0 {
    sift_down_kv(arr, start, n - 1)
    if start == 0 {
      break
    }
    start = start - 1
  }
  let mut end = n - 1
  while end > 0 {
    let tmp = arr[end]
    arr[end] = arr[0]
    arr[0] = tmp
    end = end - 1
    sift_down_kv(arr, 0, end)
  }
}

///|
fn sift_down_kv(arr : Array[(String, YamlValue)], start : Int, end : Int) -> Unit {
  let mut root = start
  while root * 2 + 1 <= end {
    let child = root * 2 + 1
    let mut swap_idx = root
    let (rk, _) = arr[swap_idx]
    let (ck, _) = arr[child]
    if str_lt(rk, ck) {
      swap_idx = child
    }
    if child + 1 <= end {
      let (sk, _) = arr[swap_idx]
      let (ck2, _) = arr[child + 1]
      if str_lt(sk, ck2) {
        swap_idx = child + 1
      }
    }
    if swap_idx == root {
      return
    }
    let tmp = arr[root]
    arr[root] = arr[swap_idx]
    arr[swap_idx] = tmp
    root = swap_idx
  }
}

///| Write canonical JSON of `v` into `sb`.
fn write_canonical_json(sb : StringBuilder, v : YamlValue) -> Unit {
  match v {
    YamlValue::Null => sb.write_string("null")
    YamlValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    YamlValue::Int(n) => write_i64(sb, n)
    YamlValue::Float(f) => sb.write_string(format_json_float(f))
    YamlValue::Str(s) => write_json_string(sb, s)
    YamlValue::Seq(items) => {
      sb.write_byte(91.to_byte())
      let mut i = 0
      let n = items.length()
      while i < n {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        write_canonical_json(sb, items[i])
        i = i + 1
      }
      sb.write_byte(93.to_byte())
    }
    YamlValue::Map(entries) => {
      let n = entries.length()
      if n == 0 {
        sb.write_string("{}")
        return
      }
      if n == 1 {
        let (k0, v0) = entries[0]
        sb.write_byte(123.to_byte())
        write_json_string(sb, key_to_json_string(k0))
        sb.write_byte(58.to_byte())
        write_canonical_json(sb, v0)
        sb.write_byte(125.to_byte())
        return
      }
      if n == 2 {
        let (k0, v0) = entries[0]
        let (k1, v1) = entries[1]
        let ks0 = key_to_json_string(k0)
        let ks1 = key_to_json_string(k1)
        sb.write_byte(123.to_byte())
        if ks0 == ks1 {
          write_json_string(sb, ks1)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, v1)
        } else if str_lt(ks0, ks1) {
          write_json_string(sb, ks0)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, v0)
          sb.write_byte(44.to_byte())
          write_json_string(sb, ks1)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, v1)
        } else {
          write_json_string(sb, ks1)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, v1)
          sb.write_byte(44.to_byte())
          write_json_string(sb, ks0)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, v0)
        }
        sb.write_byte(125.to_byte())
        return
      }
      // For n <= 24: stable insertion sort then emit skipping superseded duplicate keys.
      if n <= 24 {
        let pairs : Array[(String, YamlValue)] = []
        let mut i = 0
        while i < n {
          let (k, val_node) = entries[i]
          pairs.push((key_to_json_string(k), val_node))
          i = i + 1
        }
        sort_kv_pairs(pairs)
        sb.write_byte(123.to_byte())
        let mut first_out = true
        let mut j = 0
        while j < n {
          let (ks, val_node) = pairs[j]
          if j + 1 < n {
            let (next_ks, _) = pairs[j + 1]
            if ks == next_ks {
              j = j + 1
              continue
            }
          }
          if !first_out {
            sb.write_byte(44.to_byte())
          }
          first_out = false
          write_json_string(sb, ks)
          sb.write_byte(58.to_byte())
          write_canonical_json(sb, val_node)
          j = j + 1
        }
        sb.write_byte(125.to_byte())
        return
      }
      // Large maps: deduplicate with Map (last key wins) + heapsort.
      let pairs : Array[(String, YamlValue)] = []
      let idx_map : Map[String, Int] = Map::new()
      let mut i = 0
      while i < n {
        let (k, val_node) = entries[i]
        let ks = key_to_json_string(k)
        match idx_map.get(ks) {
          Some(existing_idx) => pairs[existing_idx] = (ks, val_node)
          None => {
            idx_map.set(ks, pairs.length())
            pairs.push((ks, val_node))
          }
        }
        i = i + 1
      }
      sort_kv_pairs(pairs)
      sb.write_byte(123.to_byte())
      let mut j = 0
      let m = pairs.length()
      while j < m {
        if j > 0 {
          sb.write_byte(44.to_byte())
        }
        let (ks, val_node) = pairs[j]
        write_json_string(sb, ks)
        sb.write_byte(58.to_byte())
        write_canonical_json(sb, val_node)
        j = j + 1
      }
      sb.write_byte(125.to_byte())
    }
  }
}

///|
fn to_canonical_json_impl(v : YamlValue) -> String {
  let sb = StringBuilder::new()
  write_canonical_json(sb, v)
  sb.to_string()
}

///| Decide whether a string needs double-quoting in YAML 1.2 block context.
fn needs_yaml_quotes(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return true
  }
  let b0 = s.code_unit_at(0)
  let blast = s.code_unit_at(n - 1)
  if b0 == 32 || b0 == 9 || blast == 32 || blast == 9 {
    return true
  }
  // Indicator characters at start
  if b0 == 45 || b0 == 63 || b0 == 58 || b0 == 44 || b0 == 91 || b0 == 93 ||
  b0 == 123 || b0 == 125 || b0 == 35 || b0 == 38 || b0 == 42 || b0 == 33 ||
  b0 == 124 || b0 == 62 || b0 == 39 || b0 == 34 || b0 == 37 || b0 == 64 ||
  b0 == 96 || b0 == 126 {
    return true
  }
  // Check if plain scalar resolution would not produce Str
  match resolve_plain_scalar(s) {
    YamlValue::Str(_) => ()
    _ => return true
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 32 || b == 127 || b == 34 || b == 92 {
      return true
    }
    if b == 58 && (i + 1 == n || s.code_unit_at(i + 1) == 32 || s.code_unit_at(i + 1) == 9) {
      return true
    }
    if b == 35 && (i == 0 || s.code_unit_at(i - 1) == 32 || s.code_unit_at(i - 1) == 9) {
      return true
    }
    if is_flow(b) {
      return true
    }
    i = i + 1
  }
  false
}

///| Write `n` spaces to `sb`.
fn write_indent(sb : StringBuilder, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    sb.write_byte(32.to_byte())
    i = i + 1
  }
}

///| Write a YAML 1.2 scalar string (plain if safe, else double-quoted).
fn write_yaml_string(sb : StringBuilder, s : String) -> Unit {
  if !needs_yaml_quotes(s) {
    sb.write_string(s)
  } else {
    write_json_string(sb, s)
  }
}

///| Emit `YamlValue` as idiomatic YAML 1.2.
fn write_yaml_node(sb : StringBuilder, v : YamlValue, indent : Int, inline_start : Bool) -> Unit {
  match v {
    YamlValue::Null => sb.write_string("null")
    YamlValue::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    YamlValue::Int(n) => write_i64(sb, n)
    YamlValue::Float(f) => {
      if f != f {
        sb.write_string(".nan")
      } else if f == 1.0 / 0.0 {
        sb.write_string(".inf")
      } else if f == -1.0 / 0.0 {
        sb.write_string("-.inf")
      } else {
        let s = f.to_string()
        sb.write_string(s)
      }
    }
    YamlValue::Str(s) => write_yaml_string(sb, s)
    YamlValue::Seq(items) => {
      let n = items.length()
      if n == 0 {
        sb.write_string("[]")
        return
      }
      let mut i = 0
      while i < n {
        if i > 0 || !inline_start {
          if i > 0 {
            sb.write_byte(10.to_byte())
          }
          write_indent(sb, indent)
        }
        let item = items[i]
        match item {
          YamlValue::Seq(sub) => {
            if sub.length() == 0 {
              sb.write_string("- []")
            } else {
              sb.write_string("-\n")
              write_yaml_node(sb, item, indent + 2, false)
            }
          }
          YamlValue::Map(sub) => {
            if sub.length() == 0 {
              sb.write_string("- {}")
            } else {
              sb.write_string("-\n")
              write_yaml_node(sb, item, indent + 2, false)
            }
          }
          _ => {
            sb.write_string("- ")
            write_yaml_node(sb, item, indent + 2, true)
          }
        }
        i = i + 1
      }
    }
    YamlValue::Map(entries) => {
      let n = entries.length()
      if n == 0 {
        sb.write_string("{}")
        return
      }
      let mut i = 0
      while i < n {
        if i > 0 || !inline_start {
          if i > 0 {
            sb.write_byte(10.to_byte())
          }
          write_indent(sb, indent)
        }
        let (k, val_node) = entries[i]
        match k {
          YamlValue::Seq(_) => {
            sb.write_string("? ")
            write_yaml_node(sb, k, indent + 2, true)
            sb.write_byte(10.to_byte())
            write_indent(sb, indent)
            sb.write_string(":")
          }
          YamlValue::Map(_) => {
            sb.write_string("? ")
            write_yaml_node(sb, k, indent + 2, true)
            sb.write_byte(10.to_byte())
            write_indent(sb, indent)
            sb.write_string(":")
          }
          _ => {
            write_yaml_node(sb, k, indent, true)
            sb.write_string(":")
          }
        }
        match val_node {
          YamlValue::Seq(sub) => {
            if sub.length() == 0 {
              sb.write_string(" []")
            } else {
              sb.write_byte(10.to_byte())
              write_yaml_node(sb, val_node, indent + 2, false)
            }
          }
          YamlValue::Map(sub) => {
            if sub.length() == 0 {
              sb.write_string(" {}")
            } else {
              sb.write_byte(10.to_byte())
              write_yaml_node(sb, val_node, indent + 2, false)
            }
          }
          _ => {
            sb.write_byte(32.to_byte())
            write_yaml_node(sb, val_node, indent + 2, true)
          }
        }
        i = i + 1
      }
    }
  }
}

///|
fn stringify_impl(v : YamlValue) -> String {
  let sb = StringBuilder::new()
  write_yaml_node(sb, v, 0, true)
  sb.write_byte(10.to_byte())
  sb.to_string()
}
