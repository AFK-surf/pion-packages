///| Unit tests for IEEE-754 shortest round-trip float formatting, duplicate-key
///| detection, alias budgets, strict UTF-8/C0 validation, and stringify round-trip safety.

///|
fn assert_double_roundtrip(f : Double, ctx : String) -> Unit {
  let s = format_finite_double(f, true)
  match s.to_double() {
    Some(back) => debug_assert(back.to_bits() == f.to_bits(), ctx + ": bit mismatch: formatted=" + s)
    None => debug_assert(false, ctx + ": to_double failed on " + s)
  }
}

///|
test "unit_float_fmt_bit_exact_roundtrip" {
  assert_double_roundtrip(0.0, "zero")
  assert_double_roundtrip(Double::from_bits(-9223372036854775808L), "neg_zero")
  assert_double_roundtrip(Double::from_bits(1L), "min_subnormal")
  assert_double_roundtrip(Double::from_bits(0x000FFFFFFFFFFFFFL), "max_subnormal")
  assert_double_roundtrip(Double::from_bits(0x0010000000000000L), "min_normal")
  assert_double_roundtrip(Double::from_bits(0x7FEFFFFFFFFFFFFFL), "dbl_max")
  assert_double_roundtrip(Double::from_bits(-4503599627370497L), "neg_dbl_max")
  assert_double_roundtrip(0.30000000000000004, "0.1+0.2")
  assert_double_roundtrip(3.141592653589793, "pi")
  assert_double_roundtrip(2.0, "2.0")
  assert_double_roundtrip(450.0, "450.0")
  assert_double_roundtrip(0.995, "0.995")
  assert_double_roundtrip(0.25, "0.25")
  assert_double_roundtrip(9007199254740992.0, "2^53")
  assert_double_roundtrip(1.0e20, "1e20")
  assert_double_roundtrip(1.0e-5, "1e-5")
  assert_double_roundtrip(1.0e-4, "1e-4")

  // Deterministic pseudo-random IEEE-754 double bit patterns
  let mut state : Int64 = 0x123456789ABCDEF1L
  let mut i = 0
  while i < 200 {
    state = state * 6364136223846793005L + 1442695040888963407L
    let exp = ((state >> 52) & 0x7FFL).to_int()
    if exp != 0x7FF {
      let d = Double::from_bits(state)
      assert_double_roundtrip(d, "rand_" + i.to_string())
    }
    i = i + 1
  }
}

///|
test "unit_duplicate_keys_small_and_large_maps" {
  // Small map (<= 8 entries, linear scan path)
  match parse("a: 1\nb: 2\na: 3\n") {
    Ok(_) => debug_assert(false, "expected duplicate key error in small map")
    Err(_) => ()
  }
  // Large map (> 8 entries, hash-table path)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 20 {
    sb.write_string("k" + i.to_string() + ": " + i.to_string() + "\n")
    i = i + 1
  }
  sb.write_string("k5: 999\n")
  match parse(sb.to_string()) {
    Ok(_) => debug_assert(false, "expected duplicate key error in large map")
    Err(_) => ()
  }
  // Non-string duplicate key (Int)
  match parse("1: a\n1: b\n") {
    Ok(_) => debug_assert(false, "expected duplicate integer key error")
    Err(_) => ()
  }
  // Distinct types: Int(1) vs Str("1") are allowed
  match parse("1: a\n\"1\": b\n") {
    Ok(YamlValue::Map(es)) => debug_assert(es.length() == 2, "expected 2 distinct keys")
    _ => debug_assert(false, "expected Ok(Map) for Int(1) vs Str(\"1\")")
  }
}

///|
test "unit_byte_amplification_bomb_rejected" {
  let big = StringBuilder::new()
  big.write_string("s: &s \"")
  let mut i = 0
  while i < 262144 {
    big.write_byte(120.to_byte())
    i = i + 1
  }
  big.write_string("\"\nl: [")
  let mut j = 0
  while j < 512 {
    if j > 0 {
      big.write_byte(44.to_byte())
    }
    big.write_string("*s")
    j = j + 1
  }
  big.write_string("]\n")
  match parse(big.to_string()) {
    Ok(_) => debug_assert(false, "expected byte-amplification bomb to be rejected")
    Err(_) => ()
  }
}
