///| Official YAML 1.2 Test Suite helpers.

///| Decode a lowercase hex string into a UTF-8 `String` (for control-byte test vectors).
fn hex_str(hx : String) -> String {
  let n = hx.length()
  let mut i = 0
  let sb = StringBuilder::new()
  while i + 1 < n {
    let hi = hex_nibble(hx.code_unit_at(i))
    let lo = hex_nibble(hx.code_unit_at(i + 1))
    sb.write_byte(((hi << 4) | lo).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hex_nibble(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

///| Assert that `parse_all(src)` succeeds and matches `expected_json`.
fn assert_suite_ok(id : String, src : String, expected_json : String) -> Unit {
  match parse_all(src) {
    Ok(docs) => {
      let actual = docs_to_json(docs)
      debug_assert(actual == expected_json, "yaml-test-suite " + id + " mismatch: actual=" + actual + " expected=" + expected_json)
    }
    Err(e) => {
      debug_assert(false, "yaml-test-suite " + id + " failed with error at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message)
    }
  }
}

///| Assert that `parse_all(src)` returns `Err`.
fn assert_suite_err(id : String, src : String) -> Unit {
  match parse_all(src) {
    Ok(docs) => {
      debug_assert(false, "yaml-test-suite " + id + " expected Err, got Ok(" + docs_to_json(docs) + ")")
    }
    Err(_) => ()
  }
}

///| yaml-test-suite 229Q: Spec Example 2.4. Sequence of Mappings
test "yts_229Q" {
  assert_suite_ok("229Q", "-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n", "[[{\"avg\":0.278,\"hr\":65,\"name\":\"Mark McGwire\"},{\"avg\":0.288,\"hr\":63,\"name\":\"Sammy Sosa\"}]]")
}

///| yaml-test-suite 26DV: Whitespace around colon in mappings
test "yts_26DV" {
  assert_suite_ok("26DV", "\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n", "[{\"top1\":{\"key1\":\"scalar1\"},\"top2\":{\"key2\":\"scalar2\"},\"top3\":{\"scalar1\":\"scalar3\"},\"top4\":{\"scalar2\":\"scalar4\"},\"top5\":\"scalar5\",\"top6\":{\"key6\":\"scalar6\"}}]")
}

