test "yts_DE56_01" {
  assert_suite_ok("DE56_01", "\"2 trailing\\t  \n    tab\"\n", "[\"2 trailing\\t tab\"]")
}

///| yaml-test-suite DE56_02: Trailing tabs in double quoted
test "yts_DE56_02" {
  assert_suite_ok("DE56_02", "\"3 trailing\\\t\n    tab\"\n", "[\"3 trailing\\t tab\"]")
}

///| yaml-test-suite DE56_03: Trailing tabs in double quoted
test "yts_DE56_03" {
  assert_suite_ok("DE56_03", "\"4 trailing\\\t  \n    tab\"\n", "[\"4 trailing\\t tab\"]")
}

///| yaml-test-suite DE56_04: Trailing tabs in double quoted
test "yts_DE56_04" {
  assert_suite_ok("DE56_04", "\"5 trailing\t\n    tab\"\n", "[\"5 trailing tab\"]")
}

///| yaml-test-suite DE56_05: Trailing tabs in double quoted
test "yts_DE56_05" {
  assert_suite_ok("DE56_05", "\"6 trailing\t  \n    tab\"\n", "[\"6 trailing tab\"]")
}

///| yaml-test-suite DHP8: Flow Sequence
test "yts_DHP8" {
  assert_suite_ok("DHP8", "[foo, bar, 42]\n", "[[\"foo\",\"bar\",42]]")
}

///| yaml-test-suite DK3J: Zero indented block scalar with line that looks like a comment
test "yts_DK3J" {
  assert_suite_ok("DK3J", "--- >\nline1\n# no comment\nline3\n", "[\"line1 # no comment line3\\n\"]")
}

///| yaml-test-suite DK95_00: Tabs that look like indentation
test "yts_DK95_00" {
  assert_suite_ok("DK95_00", "foo:\n \tbar\n", "[{\"foo\":\"bar\"}]")
}

///| yaml-test-suite DK95_02: Tabs that look like indentation
test "yts_DK95_02" {
  assert_suite_ok("DK95_02", "foo: \"bar\n  \tbaz\"\n", "[{\"foo\":\"bar baz\"}]")
}
