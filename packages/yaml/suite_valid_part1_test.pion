///| yaml-test-suite 7BMT: Node and Mapping Key Anchors [1.3]
test "yts_7BMT" {
  assert_suite_ok("7BMT", "---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4: &node4\n  &k4 key4: four\ntop5: &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n", "[{\"top1\":{\"key1\":\"one\"},\"top2\":{\"key2\":\"two\"},\"top3\":{\"key3\":\"three\"},\"top4\":{\"key4\":\"four\"},\"top5\":{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}]")
}

///| yaml-test-suite 7BUB: Spec Example 2.10. Node for “Sammy Sosa” appears twice in this document
test "yts_7BUB" {
  assert_suite_ok("7BUB", "---\nhr:\n  - Mark McGwire\n  # Following node labeled SS\n  - &SS Sammy Sosa\nrbi:\n  - *SS # Subsequent occurrence\n  - Ken Griffey\n", "[{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}]")
}

///| yaml-test-suite 7FWL: Spec Example 6.24. Verbatim Tags
test "yts_7FWL" {
  assert_suite_ok("7FWL", "!<tag:yaml.org,2002:str> foo :\n  !<!bar> baz\n", "[{\"foo\":\"baz\"}]")
}

///| yaml-test-suite 7T8X: Spec Example 8.10. Folded Lines - 8.13. Final Empty Lines
test "yts_7T8X" {
  assert_suite_ok("7T8X", ">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n", "[\"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\"]")
}

///| yaml-test-suite 7TMG: Comment in flow sequence before comma
test "yts_7TMG" {
  assert_suite_ok("7TMG", "---\n[ word1\n# comment\n, word2]\n", "[[\"word1\",\"word2\"]]")
}

///| yaml-test-suite 7W2P: Block Mapping with Missing Values
test "yts_7W2P" {
  assert_suite_ok("7W2P", "? a\n? b\nc:\n", "[{\"a\":null,\"b\":null,\"c\":null}]")
}

///| yaml-test-suite 7Z25: Bare document after document end marker
test "yts_7Z25" {
  assert_suite_ok("7Z25", "---\nscalar1\n...\nkey: value\n", "[\"scalar1\",{\"key\":\"value\"}]")
}

///| yaml-test-suite 7ZZ5: Empty flow collections
test "yts_7ZZ5" {
  assert_suite_ok("7ZZ5", "---\nnested sequences:\n- - - []\n- - - {}\nkey1: []\nkey2: {}\n", "[{\"key1\":[],\"key2\":{},\"nested sequences\":[[[[]]],[[{}]]]}]")
}

///| yaml-test-suite 82AN: Three dashes and content without space
test "yts_82AN" {
  assert_suite_ok("82AN", "---word1\nword2\n", "[\"---word1 word2\"]")
}

///| yaml-test-suite 87E4: Spec Example 7.8. Single Quoted Implicit Keys
test "yts_87E4" {
  assert_suite_ok("87E4", "'implicit block key' : [\n  'implicit flow key' : value,\n ]\n", "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
}

///| yaml-test-suite 8CWC: Plain mapping key ending with colon
test "yts_8CWC" {
  assert_suite_ok("8CWC", "---\nkey ends with two colons::: value\n", "[{\"key ends with two colons::\":\"value\"}]")
}

///| yaml-test-suite 8G76: Spec Example 6.10. Comment Lines
test "yts_8G76" {
  assert_suite_ok("8G76", "  # Comment\n   \n\n\n", "[]")
}

///| yaml-test-suite 8KB6: Multiline plain flow mapping key without value
test "yts_8KB6" {
  assert_suite_ok("8KB6", "---\n- { single line, a: b}\n- { multi\n  line, a: b}\n", "[[{\"a\":\"b\",\"single line\":null},{\"a\":\"b\",\"multi line\":null}]]")
}

///| yaml-test-suite 8MK2: Explicit Non-Specific Tag
test "yts_8MK2" {
  assert_suite_ok("8MK2", "! a\n", "[\"a\"]")
}

///| yaml-test-suite 8QBE: Block Sequence in Block Mapping
test "yts_8QBE" {
  assert_suite_ok("8QBE", "key:\n - item1\n - item2\n", "[{\"key\":[\"item1\",\"item2\"]}]")
}

///| yaml-test-suite 8UDB: Spec Example 7.14. Flow Sequence Entries
test "yts_8UDB" {
  assert_suite_ok("8UDB", "[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]\n", "[[\"double quoted\",\"single quoted\",\"plain text\",[\"nested\"],{\"single\":\"pair\"}]]")
}

///| yaml-test-suite 8XYN: Anchor with unicode character
test "yts_8XYN" {
  assert_suite_ok("8XYN", "---\n- &😁 unicode anchor\n", "[[\"unicode anchor\"]]")
}

///| yaml-test-suite 93JH: Block Mappings in Block Sequence
test "yts_93JH" {
  assert_suite_ok("93JH", " - key: value\n   key2: value2\n -\n   key3: value3\n", "[[{\"key\":\"value\",\"key2\":\"value2\"},{\"key3\":\"value3\"}]]")
}

///| yaml-test-suite 93WF: Spec Example 6.6. Line Folding [1.3]
test "yts_93WF" {
  assert_suite_ok("93WF", "--- >-\n  trimmed\n  \n \n\n  as\n  space\n", "[\"trimmed\\n\\n\\nas space\"]")
}

///| yaml-test-suite 96L6: Spec Example 2.14. In the folded scalars, newlines become spaces
test "yts_96L6" {
  assert_suite_ok("96L6", "--- >\n  Mark McGwire's\n  year was crippled\n  by a knee injury.\n", "[\"Mark McGwire's year was crippled by a knee injury.\\n\"]")
}

///| yaml-test-suite 96NN_00: Leading tab content in literals
test "yts_96NN_00" {
  assert_suite_ok("96NN_00", "foo: |-\n \tbar\n", "[{\"foo\":\"\\tbar\"}]")
}

///| yaml-test-suite 96NN_01: Leading tab content in literals
test "yts_96NN_01" {
  assert_suite_ok("96NN_01", "foo: |-\n \tbar", "[{\"foo\":\"\\tbar\"}]")
}

///| yaml-test-suite 98YD: Spec Example 5.5. Comment Indicator
test "yts_98YD" {
  assert_suite_ok("98YD", "# Comment only.\n", "[]")
}

///| yaml-test-suite 9BXH: Multiline doublequoted flow mapping key without value
test "yts_9BXH" {
  assert_suite_ok("9BXH", "---\n- { \"single line\", a: b}\n- { \"multi\n  line\", a: b}\n", "[[{\"a\":\"b\",\"single line\":null},{\"a\":\"b\",\"multi line\":null}]]")
}

///| yaml-test-suite 9DXL: Spec Example 9.6. Stream [1.3]
test "yts_9DXL" {
  assert_suite_ok("9DXL", "Mapping: Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", "[{\"Mapping\":\"Document\"},null,{\"matches %\":20}]")
}

///| yaml-test-suite 9FMG: Multi-level Mapping Indent
test "yts_9FMG" {
  assert_suite_ok("9FMG", "a:\n  b:\n    c: d\n  e:\n    f: g\nh: i\n", "[{\"a\":{\"b\":{\"c\":\"d\"},\"e\":{\"f\":\"g\"}},\"h\":\"i\"}]")
}

///| yaml-test-suite 9J7A: Simple Mapping Indent
test "yts_9J7A" {
  assert_suite_ok("9J7A", "foo:\n  bar: baz\n", "[{\"foo\":{\"bar\":\"baz\"}}]")
}

///| yaml-test-suite 9KAX: Various combinations of tags and anchors
test "yts_9KAX" {
  assert_suite_ok("9KAX", "---\n&a1\n!!str\nscalar1\n---\n!!str\n&a2\nscalar2\n---\n&a3\n!!str scalar3\n---\n&a4 !!map\n&a5 !!str key5: value4\n---\na6: 1\n&anchor6 b6: 2\n---\n!!map\n&a8 !!str key8: value7\n---\n!!map\n!!str &a10 key10: value9\n---\n!!str &a11\nvalue11\n", "[\"scalar1\",\"scalar2\",\"scalar3\",{\"key5\":\"value4\"},{\"a6\":1,\"b6\":2},{\"key8\":\"value7\"},{\"key10\":\"value9\"},\"value11\"]")
}

///| yaml-test-suite 9MQT_00: Scalar doc with '...' in content
test "yts_9MQT_00" {
  assert_suite_ok("9MQT_00", "--- \"a\n...x\nb\"\n", "[\"a ...x b\"]")
}

///| yaml-test-suite 9SA2: Multiline double quoted flow mapping key
test "yts_9SA2" {
  assert_suite_ok("9SA2", "---\n- { \"single line\": value}\n- { \"multi\n  line\": value}\n", "[[{\"single line\":\"value\"},{\"multi line\":\"value\"}]]")
}

///| yaml-test-suite 9SHH: Spec Example 5.8. Quoted Scalar Indicators
test "yts_9SHH" {
  assert_suite_ok("9SHH", "single: 'text'\ndouble: \"text\"\n", "[{\"double\":\"text\",\"single\":\"text\"}]")
}

///| yaml-test-suite 9TFX: Spec Example 7.6. Double Quoted Lines [1.3]
test "yts_9TFX" {
  assert_suite_ok("9TFX", "---\n\" 1st non-empty\n\n 2nd non-empty \n 3rd non-empty \"\n", "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
}

///| yaml-test-suite 9U5K: Spec Example 2.12. Compact Nested Mapping
test "yts_9U5K" {
  assert_suite_ok("9U5K", "---\n# Products purchased\n- item    : Super Hoop\n  quantity: 1\n- item    : Basketball\n  quantity: 4\n- item    : Big Shoes\n  quantity: 1\n", "[[{\"item\":\"Super Hoop\",\"quantity\":1},{\"item\":\"Basketball\",\"quantity\":4},{\"item\":\"Big Shoes\",\"quantity\":1}]]")
}

///| yaml-test-suite 9WXW: Spec Example 6.18. Primary Tag Handle
test "yts_9WXW" {
  assert_suite_ok("9WXW", "# Private\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n", "[\"bar\",\"bar\"]")
}

///| yaml-test-suite 9YRD: Multiline Scalar at Top Level
test "yts_9YRD" {
  assert_suite_ok("9YRD", "a\nb  \n  c\nd\n\ne\n", "[\"a b c d\\ne\"]")
}

///| yaml-test-suite A2M4: Spec Example 6.2. Indentation Indicators
test "yts_A2M4" {
  assert_suite_ok("A2M4", "? a\n: -\tb\n  -  -\tc\n     - d\n", "[{\"a\":[\"b\",[\"c\",\"d\"]]}]")
}

///| yaml-test-suite A6F9: Spec Example 8.4. Chomping Final Line Break
test "yts_A6F9" {
  assert_suite_ok("A6F9", "strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n", "[{\"clip\":\"text\\n\",\"keep\":\"text\\n\",\"strip\":\"text\"}]")
}

///| yaml-test-suite A984: Multiline Scalar in Mapping
test "yts_A984" {
  assert_suite_ok("A984", "a: b\n c\nd:\n e\n  f\n", "[{\"a\":\"b c\",\"d\":\"e f\"}]")
}

///| yaml-test-suite AB8U: Sequence entry that looks like two with wrong indentation
test "yts_AB8U" {
  assert_suite_ok("AB8U", "- single multiline\n - sequence entry\n", "[[\"single multiline - sequence entry\"]]")
}

///| yaml-test-suite AVM7: Empty Stream
test "yts_AVM7" {
  assert_suite_ok("AVM7", "", "[]")
}

///| yaml-test-suite AZ63: Sequence With Same Indentation as Parent Mapping
test "yts_AZ63" {
  assert_suite_ok("AZ63", "one:\n- 2\n- 3\nfour: 5\n", "[{\"four\":5,\"one\":[2,3]}]")
}

///| yaml-test-suite AZW3: Lookahead test cases
test "yts_AZW3" {
  assert_suite_ok("AZW3", "- bla\"keks: foo\n- bla]keks: foo\n", "[[{\"bla\\\"keks\":\"foo\"},{\"bla]keks\":\"foo\"}]]")
}

///| yaml-test-suite B3HG: Spec Example 8.9. Folded Scalar [1.3]
test "yts_B3HG" {
  assert_suite_ok("B3HG", "--- >\n folded\n text\n\n\n", "[\"folded text\\n\"]")
}

///| yaml-test-suite BEC7: Spec Example 6.14. “YAML” directive
test "yts_BEC7" {
  assert_suite_ok("BEC7", "%YAML 1.3 # Attempt parsing\n          # with a warning\n---\n\"foo\"\n", "[\"foo\"]")
}

///| yaml-test-suite BU8L: Node Anchor and Tag on Seperate Lines
test "yts_BU8L" {
  assert_suite_ok("BU8L", "key: &anchor\n !!map\n  a: b\n", "[{\"key\":{\"a\":\"b\"}}]")
}

///| yaml-test-suite C2DT: Spec Example 7.18. Flow Mapping Adjacent Values
test "yts_C2DT" {
  assert_suite_ok("C2DT", "{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n", "[{\"adjacent\":\"value\",\"empty\":null,\"readable\":\"value\"}]")
}

///| yaml-test-suite C4HZ: Spec Example 2.24. Global Tags
test "yts_C4HZ" {
  assert_suite_ok("C4HZ", "%TAG ! tag:clarkevans.com,2002:\n--- !shape\n  # Use the ! handle for presenting\n  # tag:clarkevans.com,2002:circle\n- !circle\n  center: &ORIGIN {x: 73, y: 129}\n  radius: 7\n- !line\n  start: *ORIGIN\n  finish: { x: 89, y: 102 }\n- !label\n  start: *ORIGIN\n  color: 0xFFEEBB\n  text: Pretty vector drawing.\n", "[[{\"center\":{\"x\":73,\"y\":129},\"radius\":7},{\"finish\":{\"x\":89,\"y\":102},\"start\":{\"x\":73,\"y\":129}},{\"color\":16772795,\"start\":{\"x\":73,\"y\":129},\"text\":\"Pretty vector drawing.\"}]]")
}

///| yaml-test-suite CC74: Spec Example 6.20. Tag Handles
test "yts_CC74" {
  assert_suite_ok("CC74", "%TAG !e! tag:example.com,2000:app/\n---\n!e!foo \"bar\"\n", "[\"bar\"]")
}

///| yaml-test-suite CN3R: Various location of anchors in flow sequence
test "yts_CN3R" {
  assert_suite_ok("CN3R", "&flowseq [\n a: b,\n &c c: d,\n { &e e: f },\n &g { g: h }\n]\n", "[[{\"a\":\"b\"},{\"c\":\"d\"},{\"e\":\"f\"},{\"g\":\"h\"}]]")
}

///| yaml-test-suite CPZ3: Doublequoted scalar starting with a tab
test "yts_CPZ3" {
  assert_suite_ok("CPZ3", "---\ntab: \"\\tstring\"\n", "[{\"tab\":\"\\tstring\"}]")
}

///| yaml-test-suite CT4Q: Spec Example 7.20. Single Pair Explicit Entry
test "yts_CT4Q" {
  assert_suite_ok("CT4Q", "[\n? foo\n bar : baz\n]\n", "[[{\"foo bar\":\"baz\"}]]")
}

///| yaml-test-suite CUP7: Spec Example 5.6. Node Property Indicators
test "yts_CUP7" {
  assert_suite_ok("CUP7", "anchored: !local &anchor value\nalias: *anchor\n", "[{\"alias\":\"value\",\"anchored\":\"value\"}]")
}

///| yaml-test-suite D83L: Block scalar indicator order
test "yts_D83L" {
  assert_suite_ok("D83L", "- |2-\n  explicit indent and chomp\n- |-2\n  chomp and explicit indent\n", "[[\"explicit indent and chomp\",\"chomp and explicit indent\"]]")
}

///| yaml-test-suite D88J: Flow Sequence in Block Mapping
test "yts_D88J" {
  assert_suite_ok("D88J", "a: [b, c]\n", "[{\"a\":[\"b\",\"c\"]}]")
}

///| yaml-test-suite D9TU: Single Pair Block Mapping
test "yts_D9TU" {
  assert_suite_ok("D9TU", "foo: bar\n", "[{\"foo\":\"bar\"}]")
}

///| yaml-test-suite DBG4: Spec Example 7.10. Plain Characters
test "yts_DBG4" {
  assert_suite_ok("DBG4", "# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n", "[[\"::vector\",\": - ()\",\"Up, up, and away!\",-123,\"http://example.com/foo#bar\",[\"::vector\",\": - ()\",\"Up, up and away!\",-123,\"http://example.com/foo#bar\"]]]")
}

///| yaml-test-suite DC7X: Various trailing tabs
test "yts_DC7X" {
  assert_suite_ok("DC7X", "a: b\t\nseq:\t\n - a\t\nc: d\t#X\n", "[{\"a\":\"b\",\"c\":\"d\",\"seq\":[\"a\"]}]")
}

