///| Head-to-head YAML 1.2 benchmark: Pion Native (`packages/yaml`).
///| Parses a multi-document Kubernetes + GitHub Actions + OpenAPI YAML corpus
///| and emits canonical sorted-key JSON for mandatory SHA-256 verification.

import "yaml"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: bench_pion <corpus.yaml>")
    return 1
  }
  let path = args[1]
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let docs = match yaml::parse_all(src) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "parse error at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message)
      return 1
    }
  }
  let sb = StringBuilder::new()
  let mut i = 0
  let n = docs.length()
  while i < n {
    yaml::write_canonical_json_to(sb, docs[i])
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}
