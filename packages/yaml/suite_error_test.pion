///| Official YAML 1.2 Test Suite (invalid YAML rejection cases).

///| yaml-test-suite error 236B: Invalid value after mapping
test "yts_err_236B" {
  assert_suite_err("236B", "foo:\n  bar\ninvalid\n")
}

///| yaml-test-suite error 2CMS: Invalid mapping in plain multiline
test "yts_err_2CMS" {
  assert_suite_err("2CMS", "this\n is\n  invalid: x\n")
}

///| yaml-test-suite error 2G84_00: Literal modifers
test "yts_err_2G84_00" {
  assert_suite_err("2G84_00", "--- |0\n")
}

///| yaml-test-suite error 2G84_01: Literal modifers
test "yts_err_2G84_01" {
  assert_suite_err("2G84_01", "--- |10\n")
}

///| yaml-test-suite error 3HFZ: Invalid content after document end marker
test "yts_err_3HFZ" {
  assert_suite_err("3HFZ", "---\nkey: value\n... invalid\n")
}

///| yaml-test-suite error 4EJS: Invalid tabs as indendation in a mapping
test "yts_err_4EJS" {
  assert_suite_err("4EJS", "---\na:\n\tb:\n\t\tc: value\n")
}

///| yaml-test-suite error 4H7K: Flow sequence with invalid extra closing bracket
test "yts_err_4H7K" {
  assert_suite_err("4H7K", "---\n[ a, b, c ] ]\n")
}

///| yaml-test-suite error 4HVU: Wrong indendation in Sequence
test "yts_err_4HVU" {
  assert_suite_err("4HVU", "key:\n   - ok\n   - also ok\n  - wrong\n")
}

///| yaml-test-suite error 4JVG: Scalar value with two anchors
test "yts_err_4JVG" {
  assert_suite_err("4JVG", "top1: &node1\n  &k1 key1: val1\ntop2: &node2\n  &v2 val2\n")
}

///| yaml-test-suite error 55WF: Invalid escape in double quoted string
test "yts_err_55WF" {
  assert_suite_err("55WF", "---\n\"\\.\"\n")
}

///| yaml-test-suite error 5LLU: Block scalar with wrong indented line after spaces only
test "yts_err_5LLU" {
  assert_suite_err("5LLU", "block scalar: >\n \n  \n   \n invalid\n")
}

///| yaml-test-suite error 5TRB: Invalid document-start marker in doublequoted tring
test "yts_err_5TRB" {
  assert_suite_err("5TRB", "---\n\"\n---\n\"\n")
}

///| yaml-test-suite error 5U3A: Sequence on same Line as Mapping Key
test "yts_err_5U3A" {
  assert_suite_err("5U3A", "key: - a\n     - b\n")
}

///| yaml-test-suite error 62EZ: Invalid block mapping key on same line as previous key
test "yts_err_62EZ" {
  assert_suite_err("62EZ", "---\nx: { y: z }in: valid\n")
}

///| yaml-test-suite error 6JTT: Flow sequence without closing bracket
test "yts_err_6JTT" {
  assert_suite_err("6JTT", "---\n[ [ a, b, c ]\n")
}

///| yaml-test-suite error 6S55: Invalid scalar at the end of sequence
test "yts_err_6S55" {
  assert_suite_err("6S55", "key:\n - bar\n - baz\n invalid\n")
}

///| yaml-test-suite error 7LBH: Multiline double quoted implicit keys
test "yts_err_7LBH" {
  assert_suite_err("7LBH", "\"a\\nb\": 1\n\"c\n d\": 1\n")
}

///| yaml-test-suite error 7MNF: Missing colon
test "yts_err_7MNF" {
  assert_suite_err("7MNF", "top1:\n  key1: val1\ntop2\n")
}

///| yaml-test-suite error 8XDJ: Comment in plain multiline value
test "yts_err_8XDJ" {
  assert_suite_err("8XDJ", "key: word1\n#  xxx\n  word2\n")
}

///| yaml-test-suite error 9C9N: Wrong indented flow sequence
test "yts_err_9C9N" {
  assert_suite_err("9C9N", "---\nflow: [a,\nb,\nc]\n")
}

///| yaml-test-suite error 9CWY: Invalid scalar at the end of mapping
test "yts_err_9CWY" {
  assert_suite_err("9CWY", "key:\n - item1\n - item2\ninvalid\n")
}

///| yaml-test-suite error 9HCY: Need document footer before directives
test "yts_err_9HCY" {
  assert_suite_err("9HCY", "!foo \"bar\"\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n")
}

///| yaml-test-suite error 9JBA: Invalid comment after end of flow sequence
test "yts_err_9JBA" {
  assert_suite_err("9JBA", "---\n[ a, b, c, ]#invalid\n")
}

///| yaml-test-suite error 9KBC: Mapping starting at --- line
test "yts_err_9KBC" {
  assert_suite_err("9KBC", "--- key1: value1\n    key2: value2\n")
}

///| yaml-test-suite error 9MAG: Flow sequence with invalid comma at the beginning
test "yts_err_9MAG" {
  assert_suite_err("9MAG", "---\n[ , a, b, c ]\n")
}

///| yaml-test-suite error 9MMA: Directive by itself with no document
test "yts_err_9MMA" {
  assert_suite_err("9MMA", "%YAML 1.2\n")
}

///| yaml-test-suite error 9MQT_01: Scalar doc with '...' in content
test "yts_err_9MQT_01" {
  assert_suite_err("9MQT_01", "--- \"a\n... x\nb\"\n")
}

///| yaml-test-suite error B63P: Directive without document
test "yts_err_B63P" {
  assert_suite_err("B63P", "%YAML 1.2\n...\n")
}

///| yaml-test-suite error BD7L: Invalid mapping after sequence
test "yts_err_BD7L" {
  assert_suite_err("BD7L", "- item1\n- item2\ninvalid: x\n")
}

///| yaml-test-suite error BF9H: Trailing comment in multiline plain scalar
test "yts_err_BF9H" {
  assert_suite_err("BF9H", "---\nplain: a\n       b # end of scalar\n       c\n")
}

///| yaml-test-suite error BS4K: Comment between plain scalar lines
test "yts_err_BS4K" {
  assert_suite_err("BS4K", "word1  # comment\nword2\n")
}

///| yaml-test-suite error C2SP: Flow Mapping Key on two lines
test "yts_err_C2SP" {
  assert_suite_err("C2SP", "[23\n]: 42\n")
}

///| yaml-test-suite error CML9: Missing comma in flow
test "yts_err_CML9" {
  assert_suite_err("CML9", "key: [ word1\n#  xxx\n  word2 ]\n")
}

///| yaml-test-suite error CQ3W: Double quoted string without closing quote
test "yts_err_CQ3W" {
  assert_suite_err("CQ3W", "---\nkey: \"missing closing quote\n")
}

///| yaml-test-suite error CTN5: Flow sequence with invalid extra comma
test "yts_err_CTN5" {
  assert_suite_err("CTN5", "---\n[ a, b, c, , ]\n")
}

///| yaml-test-suite error CVW2: Invalid comment after comma
test "yts_err_CVW2" {
  assert_suite_err("CVW2", "---\n[ a, b, c,#invalid\n]\n")
}

///| yaml-test-suite error CXX2: Mapping with anchor on document start line
test "yts_err_CXX2" {
  assert_suite_err("CXX2", "--- &anchor a: b\n")
}

///| yaml-test-suite error D49Q: Multiline single quoted implicit keys
test "yts_err_D49Q" {
  assert_suite_err("D49Q", "'a\\nb': 1\n'c\n d': 1\n")
}

///| yaml-test-suite error DK4H: Implicit key followed by newline
test "yts_err_DK4H" {
  assert_suite_err("DK4H", "---\n[ key\n  : value ]\n")
}

///| yaml-test-suite error DK95_01: Tabs that look like indentation
test "yts_err_DK95_01" {
  assert_suite_err("DK95_01", "foo: \"bar\n\tbaz\"\n")
}

///| yaml-test-suite error DK95_06: Tabs that look like indentation
test "yts_err_DK95_06" {
  assert_suite_err("DK95_06", "foo:\n  a: 1\n  \tb: 2\n")
}

///| yaml-test-suite error DMG6: Wrong indendation in Map
test "yts_err_DMG6" {
  assert_suite_err("DMG6", "key:\n  ok: 1\n wrong: 2\n")
}

///| yaml-test-suite error EB22: Missing document-end marker before directive
test "yts_err_EB22" {
  assert_suite_err("EB22", "---\nscalar1 # comment\n%YAML 1.2\n---\nscalar2\n")
}

///| yaml-test-suite error EW3V: Wrong indendation in mapping
test "yts_err_EW3V" {
  assert_suite_err("EW3V", "k1: v1\n k2: v2\n")
}

///| yaml-test-suite error G5U8: Plain dashes in flow sequence
test "yts_err_G5U8" {
  assert_suite_err("G5U8", "---\n- [-, -]\n")
}

///| yaml-test-suite error G7JE: Multiline implicit keys
test "yts_err_G7JE" {
  assert_suite_err("G7JE", "a\\nb: 1\nc\n d: 1\n")
}

///| yaml-test-suite error G9HC: Invalid anchor in zero indented sequence
test "yts_err_G9HC" {
  assert_suite_err("G9HC", "---\nseq:\n&anchor\n- a\n- b\n")
}

///| yaml-test-suite error GDY7: Comment that looks like a mapping key
test "yts_err_GDY7" {
  assert_suite_err("GDY7", "key: value\nthis is #not a: key\n")
}

///| yaml-test-suite error GT5M: Node anchor in sequence
test "yts_err_GT5M" {
  assert_suite_err("GT5M", "- item1\n&node\n- item2\n")
}

///| yaml-test-suite error H7J7: Node anchor not indented
test "yts_err_H7J7" {
  assert_suite_err("H7J7", "key: &x\n!!map\n  a: b\n")
}

///| yaml-test-suite error H7TQ: Extra words on %YAML directive
test "yts_err_H7TQ" {
  assert_suite_err("H7TQ", "%YAML 1.2 foo\n---\n")
}

///| yaml-test-suite error HRE5: Double quoted scalar with escaped single quote
test "yts_err_HRE5" {
  assert_suite_err("HRE5", "---\ndouble: \"quoted \\' scalar\"\n")
}

///| yaml-test-suite error HU3P: Invalid Mapping in plain scalar
test "yts_err_HU3P" {
  assert_suite_err("HU3P", "key:\n  word1 word2\n  no: key\n")
}

///| yaml-test-suite error JKF3: Multiline unidented double quoted block key
test "yts_err_JKF3" {
  assert_suite_err("JKF3", "- - \"bar\nbar\": x\n")
}

///| yaml-test-suite error JY7Z: Trailing content that looks like a mapping
test "yts_err_JY7Z" {
  assert_suite_err("JY7Z", "key1: \"quoted1\"\nkey2: \"quoted2\" no key: nor value\nkey3: \"quoted3\"\n")
}

///| yaml-test-suite error KS4U: Invalid item after end of flow sequence
test "yts_err_KS4U" {
  assert_suite_err("KS4U", "---\n[\nsequence item\n]\ninvalid item\n")
}

///| yaml-test-suite error LHL4: Invalid tag
test "yts_err_LHL4" {
  assert_suite_err("LHL4", "---\n!invalid{}tag scalar\n")
}

///| yaml-test-suite error MUS6_00: Directive variants
test "yts_err_MUS6_00" {
  assert_suite_err("MUS6_00", "%YAML 1.1#...\n---\n")
}

///| yaml-test-suite error MUS6_01: Directive variants
test "yts_err_MUS6_01" {
  assert_suite_err("MUS6_01", "%YAML 1.2\n---\n%YAML 1.2\n---\n")
}

///| yaml-test-suite error N4JP: Bad indentation in mapping
test "yts_err_N4JP" {
  assert_suite_err("N4JP", "map:\n  key1: \"quoted1\"\n key2: \"bad indentation\"\n")
}

///| yaml-test-suite error N782: Invalid document markers in flow style
test "yts_err_N782" {
  assert_suite_err("N782", "[\n--- ,\n...\n]\n")
}

///| yaml-test-suite error P2EQ: Invalid sequene item on same line as previous item
test "yts_err_P2EQ" {
  assert_suite_err("P2EQ", "---\n- { y: z }- invalid\n")
}

///| yaml-test-suite error Q4CL: Trailing content after quoted value
test "yts_err_Q4CL" {
  assert_suite_err("Q4CL", "key1: \"quoted1\"\nkey2: \"quoted2\" trailing content\nkey3: \"quoted3\"\n")
}

///| yaml-test-suite error QB6E: Wrong indented multiline quoted scalar
test "yts_err_QB6E" {
  assert_suite_err("QB6E", "---\nquoted: \"a\nb\nc\"\n")
}

///| yaml-test-suite error QLJ7: Tag shorthand used in documents but only defined in the first
test "yts_err_QLJ7" {
  assert_suite_err("QLJ7", "%TAG !prefix! tag:example.com,2011:\n--- !prefix!A\na: b\n--- !prefix!B\nc: d\n--- !prefix!C\ne: f\n")
}

///| yaml-test-suite error RHX7: YAML directive without document end marker
test "yts_err_RHX7" {
  assert_suite_err("RHX7", "---\nkey: value\n%YAML 1.2\n---\n")
}

///| yaml-test-suite error RXY3: Invalid document-end marker in single quoted string
test "yts_err_RXY3" {
  assert_suite_err("RXY3", "---\n'\n...\n'\n")
}

///| yaml-test-suite error S4GJ: Invalid text after block scalar indicator
test "yts_err_S4GJ" {
  assert_suite_err("S4GJ", "---\nfolded: > first line\n  second line\n")
}

///| yaml-test-suite error S98Z: Block scalar with more spaces than first content line
test "yts_err_S98Z" {
  assert_suite_err("S98Z", "empty block scalar: >\n \n  \n   \n # comment\n")
}

///| yaml-test-suite error SF5V: Duplicate YAML directive
test "yts_err_SF5V" {
  assert_suite_err("SF5V", "%YAML 1.2\n%YAML 1.2\n---\n")
}

///| yaml-test-suite error SR86: Anchor plus Alias
test "yts_err_SR86" {
  assert_suite_err("SR86", "key1: &a value\nkey2: &b *a\n")
}

///| yaml-test-suite error SU5Z: Comment without whitespace after doublequoted scalar
test "yts_err_SU5Z" {
  assert_suite_err("SU5Z", "key: \"value\"# invalid comment\n")
}

///| yaml-test-suite error SU74: Anchor and alias as mapping key
test "yts_err_SU74" {
  assert_suite_err("SU74", "key1: &alias value1\n&b *alias : value2\n")
}

///| yaml-test-suite error SY6V: Anchor before sequence entry on same line
test "yts_err_SY6V" {
  assert_suite_err("SY6V", "&anchor - sequence entry\n")
}

///| yaml-test-suite error T833: Flow mapping missing a separating comma
test "yts_err_T833" {
  assert_suite_err("T833", "---\n{\n foo: 1\n bar: 2 }\n")
}

///| yaml-test-suite error TD5N: Invalid scalar after sequence
test "yts_err_TD5N" {
  assert_suite_err("TD5N", "- item1\n- item2\ninvalid\n")
}

///| yaml-test-suite error U44R: Bad indentation in mapping (2)
test "yts_err_U44R" {
  assert_suite_err("U44R", "map:\n  key1: \"quoted1\"\n   key2: \"bad indentation\"\n")
}

///| yaml-test-suite error U99R: Invalid comma in tag
test "yts_err_U99R" {
  assert_suite_err("U99R", "- !!str, xxx\n")
}

///| yaml-test-suite error VJP3_00: Flow collections over many lines
test "yts_err_VJP3_00" {
  assert_suite_err("VJP3_00", "k: {\nk\n:\nv\n}\n")
}

///| yaml-test-suite error W9L4: Literal block scalar with more spaces in first line
test "yts_err_W9L4" {
  assert_suite_err("W9L4", "---\nblock scalar: |\n     \n  more spaces at the beginning\n  are invalid\n")
}

///| yaml-test-suite error X4QW: Comment without whitespace after block scalar indicator
test "yts_err_X4QW" {
  assert_suite_err("X4QW", "block: ># comment\n  scalar\n")
}

///| yaml-test-suite error Y79Y_000: Tabs in various contexts
test "yts_err_Y79Y_000" {
  assert_suite_err("Y79Y_000", "foo: |\n\t\nbar: 1\n")
}

///| yaml-test-suite error Y79Y_003: Tabs in various contexts
test "yts_err_Y79Y_003" {
  assert_suite_err("Y79Y_003", "- [\n\tfoo,\n foo\n ]\n")
}

///| yaml-test-suite error Y79Y_004: Tabs in various contexts
test "yts_err_Y79Y_004" {
  assert_suite_err("Y79Y_004", "-\t-\n")
}

///| yaml-test-suite error Y79Y_005: Tabs in various contexts
test "yts_err_Y79Y_005" {
  assert_suite_err("Y79Y_005", "- \t-\n")
}

///| yaml-test-suite error Y79Y_006: Tabs in various contexts
test "yts_err_Y79Y_006" {
  assert_suite_err("Y79Y_006", "?\t-\n")
}

///| yaml-test-suite error Y79Y_007: Tabs in various contexts
test "yts_err_Y79Y_007" {
  assert_suite_err("Y79Y_007", "? -\n:\t-\n")
}

///| yaml-test-suite error Y79Y_008: Tabs in various contexts
test "yts_err_Y79Y_008" {
  assert_suite_err("Y79Y_008", "?\tkey:\n")
}

///| yaml-test-suite error Y79Y_009: Tabs in various contexts
test "yts_err_Y79Y_009" {
  assert_suite_err("Y79Y_009", "? key:\n:\tkey:\n")
}

///| yaml-test-suite error YJV2: Dash in flow sequence
test "yts_err_YJV2" {
  assert_suite_err("YJV2", "[-]\n")
}

///| yaml-test-suite error ZCZ6: Invalid mapping in plain single line value
test "yts_err_ZCZ6" {
  assert_suite_err("ZCZ6", "a: b: c: d\n")
}

///| yaml-test-suite error ZL4Z: Invalid nested mapping
test "yts_err_ZL4Z" {
  assert_suite_err("ZL4Z", "---\na: 'b': c\n")
}

///| yaml-test-suite error ZVH3: Wrong indented sequence item
test "yts_err_ZVH3" {
  assert_suite_err("ZVH3", "- key: value\n - item1\n")
}

///| yaml-test-suite error ZXT5: Implicit key followed by newline and adjacent value
test "yts_err_ZXT5" {
  assert_suite_err("ZXT5", "[ \"key\"\n  :value ]\n")
}
