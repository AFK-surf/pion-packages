///| Real-world YAML 1.2 integration tests:
///| Kubernetes Deployment, GitHub Actions CI workflow, Markdown frontmatter,
///| merge keys (`<<`), explicit tags, Billion Laughs DoS defense, and round-trip `stringify`.

///|
fn unwrap_yaml(r : Result[YamlValue, YamlError], ctx : String) -> YamlValue {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, ctx + ": unexpected error at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message)
      YamlValue::Null
    }
  }
}

///|
fn unwrap_yaml_all(r : Result[Array[YamlValue], YamlError], ctx : String) -> Array[YamlValue] {
  match r {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, ctx + ": unexpected error at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message)
      []
    }
  }
}

///|
fn docs_to_json(docs : Array[YamlValue]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  let n = docs.length()
  while i < n {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(to_canonical_json(docs[i]))
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
test "realworld_k8s_deployment" {
  let src =
  "apiVersion: apps/v1\n" +
  "kind: Deployment\n" +
  "metadata:\n" +
  "  name: web-gateway\n" +
  "  namespace: prod\n" +
  "  labels:\n" +
  "    app: web-gateway\n" +
  "    tier: frontend\n" +
  "spec:\n" +
  "  replicas: 3\n" +
  "  paused: false\n" +
  "  selector:\n" +
  "    matchLabels:\n" +
  "      app: web-gateway\n" +
  "  template:\n" +
  "    metadata:\n" +
  "      labels:\n" +
  "        app: web-gateway\n" +
  "    spec:\n" +
  "      containers:\n" +
  "        - name: nginx\n" +
  "          image: nginx:1.27.2\n" +
  "          ports:\n" +
  "            - containerPort: 8080\n" +
  "              protocol: TCP\n" +
  "          env:\n" +
  "            - name: LOG_LEVEL\n" +
  "              value: \"info\"\n" +
  "            - name: MAX_CONNS\n" +
  "              value: \"4096\"\n" +
  "          resources:\n" +
  "            limits:\n" +
  "              cpu: \"500m\"\n" +
  "              memory: \"256Mi\"\n"
  let v = unwrap_yaml(parse(src), "k8s_deployment")
  let expected = "{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"metadata\":{\"labels\":{\"app\":\"web-gateway\",\"tier\":\"frontend\"},\"name\":\"web-gateway\",\"namespace\":\"prod\"},\"spec\":{\"paused\":false,\"replicas\":3,\"selector\":{\"matchLabels\":{\"app\":\"web-gateway\"}},\"template\":{\"metadata\":{\"labels\":{\"app\":\"web-gateway\"}},\"spec\":{\"containers\":[{\"env\":[{\"name\":\"LOG_LEVEL\",\"value\":\"info\"},{\"name\":\"MAX_CONNS\",\"value\":\"4096\"}],\"image\":\"nginx:1.27.2\",\"name\":\"nginx\",\"ports\":[{\"containerPort\":8080,\"protocol\":\"TCP\"}],\"resources\":{\"limits\":{\"cpu\":\"500m\",\"memory\":\"256Mi\"}}}]}}}}"
  debug_assert(to_canonical_json(v) == expected, "k8s_deployment json mismatch")
  // Round-trip through stringify
  let rt_str = stringify(v)
  let v2 = unwrap_yaml(parse(rt_str), "k8s_deployment_rt")
  debug_assert(to_canonical_json(v2) == expected, "k8s_deployment roundtrip mismatch")
}

///|
test "realworld_github_actions_ci" {
  let src =
  "name: CI\n" +
  "on:\n" +
  "  push:\n" +
  "    branches: [main, release/*]\n" +
  "  pull_request:\n" +
  "    branches: [main]\n" +
  "permissions:\n" +
  "  contents: read\n" +
  "jobs:\n" +
  "  test:\n" +
  "    runs-on: ubuntu-latest\n" +
  "    strategy:\n" +
  "      fail-fast: false\n" +
  "      matrix:\n" +
  "        target: [native, wasm32]\n" +
  "    steps:\n" +
  "      - uses: actions/checkout@v4\n" +
  "      - name: Run verification\n" +
  "        run: |\n" +
  "          pionc fmt --check\n" +
  "          pionc test --json\n"
  let v = unwrap_yaml(parse(src), "github_actions")
  let expected = "{\"jobs\":{\"test\":{\"runs-on\":\"ubuntu-latest\",\"steps\":[{\"uses\":\"actions/checkout@v4\"},{\"name\":\"Run verification\",\"run\":\"pionc fmt --check\\npionc test --json\\n\"}],\"strategy\":{\"fail-fast\":false,\"matrix\":{\"target\":[\"native\",\"wasm32\"]}}}},\"name\":\"CI\",\"on\":{\"pull_request\":{\"branches\":[\"main\"]},\"push\":{\"branches\":[\"main\",\"release/*\"]}},\"permissions\":{\"contents\":\"read\"}}"
  debug_assert(to_canonical_json(v) == expected, "github_actions json mismatch")
  let v2 = unwrap_yaml(parse(stringify(v)), "github_actions_rt")
  debug_assert(to_canonical_json(v2) == expected, "github_actions roundtrip mismatch")
}

///|
test "realworld_markdown_frontmatter" {
  let src =
  "---\n" +
  "title: \"Building a YAML 1.2 Parser in Pion\"\n" +
  "date: \"2026-11-22\"\n" +
  "draft: false\n" +
  "tags:\n" +
  "  - pion\n" +
  "  - yaml\n" +
  "  - compilers\n" +
  "summary: >-\n" +
  "  A zero-C-glue pure Pion YAML 1.2 parser\n" +
  "  with full yaml-test-suite compliance.\n" +
  "...\n"
  let docs = unwrap_yaml_all(parse_all(src), "frontmatter")
  debug_assert(docs.length() == 1, "frontmatter doc count")
  let expected = "{\"date\":\"2026-11-22\",\"draft\":false,\"summary\":\"A zero-C-glue pure Pion YAML 1.2 parser with full yaml-test-suite compliance.\",\"tags\":[\"pion\",\"yaml\",\"compilers\"],\"title\":\"Building a YAML 1.2 Parser in Pion\"}"
  debug_assert(to_canonical_json(docs[0]) == expected, "frontmatter json mismatch")
}

///|
test "realworld_merge_keys" {
  let src =
  "defaults: &def\n" +
  "  adapter: postgres\n" +
  "  host: localhost\n" +
  "  port: 5432\n" +
  "extra: &ext\n" +
  "  host: replica.internal\n" +
  "  pool: 16\n" +
  "development:\n" +
  "  <<: *def\n" +
  "  database: dev_db\n" +
  "production:\n" +
  "  <<: [*def, *ext]\n" +
  "  port: 6432\n" +
  "  database: prod_db\n"
  let v = unwrap_yaml(parse(src), "merge_keys")
  let expected = "{\"defaults\":{\"adapter\":\"postgres\",\"host\":\"localhost\",\"port\":5432},\"development\":{\"adapter\":\"postgres\",\"database\":\"dev_db\",\"host\":\"localhost\",\"port\":5432},\"extra\":{\"host\":\"replica.internal\",\"pool\":16},\"production\":{\"adapter\":\"postgres\",\"database\":\"prod_db\",\"host\":\"localhost\",\"pool\":16,\"port\":6432}}"
  debug_assert(to_canonical_json(v) == expected, "merge_keys json mismatch")
}

///|
test "realworld_core_schema_and_explicit_tags" {
  let src =
  "null1: null\n" +
  "null2: ~\n" +
  "null3: NULL\n" +
  "null4:\n" +
  "bool_t: true\n" +
  "bool_f: False\n" +
  "int_dec: -42\n" +
  "int_pos: +100\n" +
  "int_hex: 0x1A\n" +
  "int_oct: 0o755\n" +
  "flt_std: 3.14\n" +
  "flt_neg: -0.5\n" +
  "tag_str: !!str 123\n" +
  "tag_int: !!int \"456\"\n" +
  "tag_bool: !!bool \"true\"\n" +
  "tag_null: !!null \"\"\n" +
  "yaml11_yes_is_str: yes\n" +
  "yaml11_no_is_str: no\n" +
  "yaml11_on_is_str: on\n" +
  "yaml11_off_is_str: off\n"
  let v = unwrap_yaml(parse(src), "core_schema")
  let expected = "{\"bool_f\":false,\"bool_t\":true,\"flt_neg\":-0.5,\"flt_std\":3.14,\"int_dec\":-42,\"int_hex\":26,\"int_oct\":493,\"int_pos\":100,\"null1\":null,\"null2\":null,\"null3\":null,\"null4\":null,\"tag_bool\":true,\"tag_int\":456,\"tag_null\":null,\"tag_str\":\"123\",\"yaml11_no_is_str\":\"no\",\"yaml11_off_is_str\":\"off\",\"yaml11_on_is_str\":\"on\",\"yaml11_yes_is_str\":\"yes\"}"
  debug_assert(to_canonical_json(v) == expected, "core_schema json mismatch")
}

///|
test "realworld_billion_laughs_protection" {
  let src =
  "a: &a [\"lol\", \"lol\", \"lol\", \"lol\", \"lol\", \"lol\", \"lol\", \"lol\", \"lol\"]\n" +
  "b: &b [*a, *a, *a, *a, *a, *a, *a, *a, *a]\n" +
  "c: &c [*b, *b, *b, *b, *b, *b, *b, *b, *b]\n" +
  "d: &d [*c, *c, *c, *c, *c, *c, *c, *c, *c]\n" +
  "e: &e [*d, *d, *d, *d, *d, *d, *d, *d, *d]\n" +
  "f: &f [*e, *e, *e, *e, *e, *e, *e, *e, *e]\n" +
  "g: &g [*f, *f, *f, *f, *f, *f, *f, *f, *f]\n"
  match parse(src) {
    Ok(_) => debug_assert(false, "expected Err for billion laughs alias bomb")
    Err(e) => debug_assert(e.message.length() > 0, "error message non-empty")
  }
}

///|
test "realworld_stringify_roundtrip_edge_cases" {
  let src =
  "empty_str: \"\"\n" +
  "looks_like_bool: \"true\"\n" +
  "looks_like_null: \"null\"\n" +
  "looks_like_int: \"42\"\n" +
  "looks_like_float: \"3.14\"\n" +
  "colon_space: \"a: b\"\n" +
  "hash_comment: \"foo # bar\"\n" +
  "leading_space: \"  hello\"\n" +
  "trailing_space: \"hello  \"\n" +
  "multiline: \"line1\\nline2\\nline3\"\n" +
  "quotes_and_slash: \"he said \\\"hi\\\" \\\\ ok\"\n" +
  "empty_seq: []\n" +
  "empty_map: {}\n" +
  "nested:\n" +
  "  - [1, 2, 3]\n" +
  "  - {a: true, b: null}\n"
  let v1 = unwrap_yaml(parse(src), "rt_edge_1")
  let j1 = to_canonical_json(v1)
  let emitted = stringify(v1)
  let v2 = unwrap_yaml(parse(emitted), "rt_edge_2")
  let j2 = to_canonical_json(v2)
  debug_assert(j1 == j2, "roundtrip edge cases mismatch")
}

///|
test "realworld_multi_doc_k8s_bundle" {
  let src =
  "apiVersion: v1\n" +
  "kind: Namespace\n" +
  "metadata:\n" +
  "  name: demo\n" +
  "---\n" +
  "apiVersion: v1\n" +
  "kind: ConfigMap\n" +
  "metadata:\n" +
  "  name: app-cfg\n" +
  "  namespace: demo\n" +
  "data:\n" +
  "  PORT: \"8080\"\n" +
  "  DEBUG: \"false\"\n" +
  "...\n"
  let docs = unwrap_yaml_all(parse_all(src), "multi_doc_k8s")
  debug_assert(docs.length() == 2, "expected 2 k8s docs")
  let expected = "[{\"apiVersion\":\"v1\",\"kind\":\"Namespace\",\"metadata\":{\"name\":\"demo\"}},{\"apiVersion\":\"v1\",\"data\":{\"DEBUG\":\"false\",\"PORT\":\"8080\"},\"kind\":\"ConfigMap\",\"metadata\":{\"name\":\"app-cfg\",\"namespace\":\"demo\"}}]"
  debug_assert(docs_to_json(docs) == expected, "multi_doc_k8s json mismatch")
}
