///| Official YAML 1.2 Test Suite (valid cases, part 2).

///| yaml-test-suite DK95_03: Tabs that look like indentation
test "yts_DK95_03" {
  assert_suite_ok("DK95_03", " \t\nfoo: 1\n", "[{\"foo\":1}]")
}

///| yaml-test-suite DK95_04: Tabs that look like indentation
test "yts_DK95_04" {
  assert_suite_ok("DK95_04", "foo: 1\n\t\nbar: 2\n", "[{\"bar\":2,\"foo\":1}]")
}

///| yaml-test-suite DK95_05: Tabs that look like indentation
test "yts_DK95_05" {
  assert_suite_ok("DK95_05", "foo: 1\n \t\nbar: 2\n", "[{\"bar\":2,\"foo\":1}]")
}

///| yaml-test-suite DK95_07: Tabs that look like indentation
test "yts_DK95_07" {
  assert_suite_ok("DK95_07", "%YAML 1.2\n\t\n---\n", "[null]")
}

///| yaml-test-suite DK95_08: Tabs that look like indentation
test "yts_DK95_08" {
  assert_suite_ok("DK95_08", "foo: \"bar\n \t \t baz \t \t \"\n", "[{\"foo\":\"bar baz \\t \\t \"}]")
}

///| yaml-test-suite DWX9: Spec Example 8.8. Literal Content
test "yts_DWX9" {
  assert_suite_ok("DWX9", "|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "[\"\\n\\nliteral\\n \\n\\ntext\\n\"]")
}

///| yaml-test-suite E76Z: Aliases in Implicit Block Mapping
test "yts_E76Z" {
  assert_suite_ok("E76Z", "&a a: &b b\n*b : *a\n", "[{\"a\":\"b\",\"b\":\"a\"}]")
}

///| yaml-test-suite EHF6: Tags for Flow Objects
test "yts_EHF6" {
  assert_suite_ok("EHF6", "!!map {\n  k: !!seq\n  [ a, !!str b]\n}\n", "[{\"k\":[\"a\",\"b\"]}]")
}

///| yaml-test-suite EX5H: Multiline Scalar at Top Level [1.3]
test "yts_EX5H" {
  assert_suite_ok("EX5H", "---\na\nb  \n  c\nd\n\ne\n", "[\"a b c d\\ne\"]")
}

///| yaml-test-suite EXG3: Three dashes and content without space [1.3]
test "yts_EXG3" {
  assert_suite_ok("EXG3", "---\n---word1\nword2\n", "[\"---word1 word2\"]")
}

///| yaml-test-suite F2C7: Anchors and Tags
test "yts_F2C7" {
  assert_suite_ok("F2C7", " - &a !!str a\n - !!int 2\n - !!int &c 4\n - &d d\n", "[[\"a\",2,4,\"d\"]]")
}

///| yaml-test-suite F3CP: Nested flow collections on one line
test "yts_F3CP" {
  assert_suite_ok("F3CP", "---\n{ a: [b, c, { d: [e, f] } ] }\n", "[{\"a\":[\"b\",\"c\",{\"d\":[\"e\",\"f\"]}]}]")
}

///| yaml-test-suite F6MC: More indented lines at the beginning of folded block scalars
test "yts_F6MC" {
  assert_suite_ok("F6MC", "---\na: >2\n   more indented\n  regular\nb: >2\n\n\n   more indented\n  regular\n", "[{\"a\":\" more indented\\nregular\\n\",\"b\":\"\\n\\n more indented\\nregular\\n\"}]")
}

///| yaml-test-suite F8F9: Spec Example 8.5. Chomping Trailing Lines
test "yts_F8F9" {
  assert_suite_ok("F8F9", " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n", "[{\"clip\":\"# text\\n\",\"keep\":\"# text\\n\\n\",\"strip\":\"# text\"}]")
}

///| yaml-test-suite FBC9: Allowed characters in plain scalars
test "yts_FBC9" {
  assert_suite_ok("FBC9", "safe: a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\n     !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\nsafe question mark: ?foo\nsafe colon: :foo\nsafe dash: -foo\n", "[{\"safe\":\"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~ !\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~\",\"safe colon\":\":foo\",\"safe dash\":\"-foo\",\"safe question mark\":\"?foo\"}]")
}

///| yaml-test-suite FP8R: Zero indented block scalar
test "yts_FP8R" {
  assert_suite_ok("FP8R", "--- >\nline1\nline2\nline3\n", "[\"line1 line2 line3\\n\"]")
}

///| yaml-test-suite FQ7F: Spec Example 2.1. Sequence of Scalars
test "yts_FQ7F" {
  assert_suite_ok("FQ7F", "- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n", "[[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"]]")
}

///| yaml-test-suite FTA2: Single block sequence with anchor and explicit document start
test "yts_FTA2" {
  assert_suite_ok("FTA2", "--- &sequence\n- a\n", "[[\"a\"]]")
}

///| yaml-test-suite FUP4: Flow Sequence in Flow Sequence
test "yts_FUP4" {
  assert_suite_ok("FUP4", "[a, [b, c]]\n", "[[\"a\",[\"b\",\"c\"]]]")
}

///| yaml-test-suite G4RS: Spec Example 2.17. Quoted Scalars
test "yts_G4RS" {
  assert_suite_ok("G4RS", "unicode: \"Sosa did fine.\\u263A\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\x0d\\x0a is \\r\\n\"\n\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n", "[{\"control\":\"\\b1998\\t1999\\t2000\\n\",\"hex esc\":\"\\r\\n is \\r\\n\",\"quoted\":\" # Not a 'comment'.\",\"single\":\"\\\"Howdy!\\\" he cried.\",\"tie-fighter\":\"|\\\\-*-/|\",\"unicode\":\"Sosa did fine.☺\"}]")
}

///| yaml-test-suite G992: Spec Example 8.9. Folded Scalar
test "yts_G992" {
  assert_suite_ok("G992", ">\n folded\n text\n\n\n", "[\"folded text\\n\"]")
}

///| yaml-test-suite GH63: Mixed Block Mapping (explicit to implicit)
test "yts_GH63" {
  assert_suite_ok("GH63", "? a\n: 1.3\nfifteen: d\n", "[{\"a\":1.3,\"fifteen\":\"d\"}]")
}

///| yaml-test-suite H2RW: Blank lines
test "yts_H2RW" {
  assert_suite_ok("H2RW", "foo: 1\n\nbar: 2\n    \ntext: |\n  a\n    \n  b\n\n  c\n \n  d\n", "[{\"bar\":2,\"foo\":1,\"text\":\"a\\n  \\nb\\n\\nc\\n\\nd\\n\"}]")
}

///| yaml-test-suite H3Z8: Literal unicode
test "yts_H3Z8" {
  assert_suite_ok("H3Z8", "---\nwanted: love ♥ and peace ☮\n", "[{\"wanted\":\"love ♥ and peace ☮\"}]")
}

///| yaml-test-suite HM87_00: Scalars in flow start with syntax char
test "yts_HM87_00" {
  assert_suite_ok("HM87_00", "[:x]\n", "[[\":x\"]]")
}

///| yaml-test-suite HM87_01: Scalars in flow start with syntax char
test "yts_HM87_01" {
  assert_suite_ok("HM87_01", "[?x]\n", "[[\"?x\"]]")
}

///| yaml-test-suite HMK4: Spec Example 2.16. Indentation determines scope
test "yts_HMK4" {
  assert_suite_ok("HMK4", "name: Mark McGwire\naccomplishment: >\n  Mark set a major league\n  home run record in 1998.\nstats: |\n  65 Home Runs\n  0.278 Batting Average\n", "[{\"accomplishment\":\"Mark set a major league home run record in 1998.\\n\",\"name\":\"Mark McGwire\",\"stats\":\"65 Home Runs\\n0.278 Batting Average\\n\"}]")
}

///| yaml-test-suite HMQ5: Spec Example 6.23. Node Properties
test "yts_HMQ5" {
  assert_suite_ok("HMQ5", "!!str &a1 \"foo\":\n  !!str bar\n&a2 baz : *a1\n", "[{\"baz\":\"foo\",\"foo\":\"bar\"}]")
}

///| yaml-test-suite HS5T: Spec Example 7.12. Plain Lines
test "yts_HS5T" {
  assert_suite_ok("HS5T", "1st non-empty\n\n 2nd non-empty \n\t3rd non-empty\n", "[\"1st non-empty\\n2nd non-empty 3rd non-empty\"]")
}

///| yaml-test-suite HWV9: Document-end marker
test "yts_HWV9" {
  assert_suite_ok("HWV9", "...\n", "[]")
}

///| yaml-test-suite J3BT: Spec Example 5.12. Tabs and Spaces
test "yts_J3BT" {
  assert_suite_ok("J3BT", "# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() {\n  \tprintf(\"Hello, world!\\n\");\n  }\n", "[{\"block\":\"void main() {\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n}\\n\",\"quoted\":\"Quoted \\t\"}]")
}

///| yaml-test-suite J5UC: Multiple Pair Block Mapping
test "yts_J5UC" {
  assert_suite_ok("J5UC", "foo: blue\nbar: arrr\nbaz: jazz\n", "[{\"bar\":\"arrr\",\"baz\":\"jazz\",\"foo\":\"blue\"}]")
}

///| yaml-test-suite J7PZ: Spec Example 2.26. Ordered Mappings
test "yts_J7PZ" {
  assert_suite_ok("J7PZ", "# The !!omap tag is one of the optional types\n# introduced for YAML 1.1. In 1.2, it is not\n# part of the standard tags and should not be\n# enabled by default.\n# Ordered maps are represented as\n# A sequence of mappings, with\n# each mapping having one key\n--- !!omap\n- Mark McGwire: 65\n- Sammy Sosa: 63\n- Ken Griffy: 58\n", "[[{\"Mark McGwire\":65},{\"Sammy Sosa\":63},{\"Ken Griffy\":58}]]")
}

///| yaml-test-suite J7VC: Empty Lines Between Mapping Elements
test "yts_J7VC" {
  assert_suite_ok("J7VC", "one: 2\n\n\nthree: 4\n", "[{\"one\":2,\"three\":4}]")
}

///| yaml-test-suite J9HZ: Spec Example 2.9. Single Document with Two Comments
test "yts_J9HZ" {
  assert_suite_ok("J9HZ", "---\nhr: # 1998 hr ranking\n  - Mark McGwire\n  - Sammy Sosa\nrbi:\n  # 1998 rbi ranking\n  - Sammy Sosa\n  - Ken Griffey\n", "[{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}]")
}

///| yaml-test-suite JEF9_00: Trailing whitespace in streams
test "yts_JEF9_00" {
  assert_suite_ok("JEF9_00", "- |+\n\n\n", "[[\"\\n\\n\"]]")
}

///| yaml-test-suite JEF9_01: Trailing whitespace in streams
test "yts_JEF9_01" {
  assert_suite_ok("JEF9_01", "- |+\n   \n", "[[\"\\n\"]]")
}

///| yaml-test-suite JEF9_02: Trailing whitespace in streams
test "yts_JEF9_02" {
  assert_suite_ok("JEF9_02", "- |+\n   ", "[[\"\\n\"]]")
}

///| yaml-test-suite JHB9: Spec Example 2.7. Two Documents in a Stream
test "yts_JHB9" {
  assert_suite_ok("JHB9", "# Ranking of 1998 home runs\n---\n- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n\n# Team ranking\n---\n- Chicago Cubs\n- St Louis Cardinals\n", "[[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"],[\"Chicago Cubs\",\"St Louis Cardinals\"]]")
}

///| yaml-test-suite JQ4R: Spec Example 8.14. Block Sequence
test "yts_JQ4R" {
  assert_suite_ok("JQ4R", "block sequence:\n  - one\n  - two : three\n", "[{\"block sequence\":[\"one\",{\"two\":\"three\"}]}]")
}

///| yaml-test-suite JR7V: Question marks in scalars
test "yts_JR7V" {
  assert_suite_ok("JR7V", "- a?string\n- another ? string\n- key: value?\n- [a?string]\n- [another ? string]\n- {key: value? }\n- {key: value?}\n- {key?: value }\n", "[[\"a?string\",\"another ? string\",{\"key\":\"value?\"},[\"a?string\"],[\"another ? string\"],{\"key\":\"value?\"},{\"key\":\"value?\"},{\"key?\":\"value\"}]]")
}

///| yaml-test-suite JS2J: Spec Example 6.29. Node Anchors
test "yts_JS2J" {
  assert_suite_ok("JS2J", "First occurrence: &anchor Value\nSecond occurrence: *anchor\n", "[{\"First occurrence\":\"Value\",\"Second occurrence\":\"Value\"}]")
}

///| yaml-test-suite JTV5: Block Mapping with Multiline Scalars
test "yts_JTV5" {
  assert_suite_ok("JTV5", "? a\n  true\n: null\n  d\n? e\n  42\n", "[{\"a true\":\"null d\",\"e 42\":null}]")
}

///| yaml-test-suite K3WX: Colon and adjacent value after comment on next line
test "yts_K3WX" {
  assert_suite_ok("K3WX", "---\n{ \"foo\" # comment\n  :bar }\n", "[{\"foo\":\"bar\"}]")
}

///| yaml-test-suite K4SU: Multiple Entry Block Sequence
test "yts_K4SU" {
  assert_suite_ok("K4SU", "- foo\n- bar\n- 42\n", "[[\"foo\",\"bar\",42]]")
}

///| yaml-test-suite K527: Spec Example 6.6. Line Folding
test "yts_K527" {
  assert_suite_ok("K527", ">-\n  trimmed\n  \n \n\n  as\n  space\n", "[\"trimmed\\n\\n\\nas space\"]")
}

///| yaml-test-suite K54U: Tab after document header
test "yts_K54U" {
  assert_suite_ok("K54U", "---\tscalar\n", "[\"scalar\"]")
}

///| yaml-test-suite K858: Spec Example 8.6. Empty Scalar Chomping
test "yts_K858" {
  assert_suite_ok("K858", "strip: >-\n\nclip: >\n\nkeep: |+\n\n", "[{\"clip\":\"\",\"keep\":\"\\n\",\"strip\":\"\"}]")
}

///| yaml-test-suite KH5V_00: Inline tabs in double quoted
test "yts_KH5V_00" {
  assert_suite_ok("KH5V_00", "\"1 inline\\ttab\"\n", "[\"1 inline\\ttab\"]")
}

///| yaml-test-suite KH5V_01: Inline tabs in double quoted
test "yts_KH5V_01" {
  assert_suite_ok("KH5V_01", "\"2 inline\\\ttab\"\n", "[\"2 inline\\ttab\"]")
}

///| yaml-test-suite KH5V_02: Inline tabs in double quoted
test "yts_KH5V_02" {
  assert_suite_ok("KH5V_02", "\"3 inline\ttab\"\n", "[\"3 inline\\ttab\"]")
}

///| yaml-test-suite KMK3: Block Submapping
test "yts_KMK3" {
  assert_suite_ok("KMK3", "foo:\n  bar: 1\nbaz: 2\n", "[{\"baz\":2,\"foo\":{\"bar\":1}}]")
}

///| yaml-test-suite KSS4: Scalars on --- line
test "yts_KSS4" {
  assert_suite_ok("KSS4", "--- \"quoted\nstring\"\n--- &node foo\n", "[\"quoted string\",\"foo\"]")
}

///| yaml-test-suite L24T_00: Trailing line of spaces
test "yts_L24T_00" {
  assert_suite_ok("L24T_00", "foo: |\n  x\n   \n", "[{\"foo\":\"x\\n \\n\"}]")
}

///| yaml-test-suite L24T_01: Trailing line of spaces
test "yts_L24T_01" {
  assert_suite_ok("L24T_01", "foo: |\n  x\n   ", "[{\"foo\":\"x\\n \\n\"}]")
}

///| yaml-test-suite L383: Two scalar docs with trailing comments
test "yts_L383" {
  assert_suite_ok("L383", "--- foo  # comment\n--- foo  # comment\n", "[\"foo\",\"foo\"]")
}

///| yaml-test-suite L94M: Tags in Explicit Mapping
test "yts_L94M" {
  assert_suite_ok("L94M", "? !!str a\n: !!int 47\n? c\n: !!str d\n", "[{\"a\":47,\"c\":\"d\"}]")
}

///| yaml-test-suite L9U5: Spec Example 7.11. Plain Implicit Keys
test "yts_L9U5" {
  assert_suite_ok("L9U5", "implicit block key : [\n  implicit flow key : value,\n ]\n", "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
}

///| yaml-test-suite LE5A: Spec Example 7.24. Flow Nodes
test "yts_LE5A" {
  assert_suite_ok("LE5A", "- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n", "[[\"a\",\"b\",\"c\",\"c\",\"\"]]")
}

///| yaml-test-suite LP6E: Whitespace After Scalars in Flow
test "yts_LP6E" {
  assert_suite_ok("LP6E", "- [a, b , c ]\n- { \"a\"  : b\n   , c : 'd' ,\n   e   : \"f\"\n  }\n- [      ]\n", "[[[\"a\",\"b\",\"c\"],{\"a\":\"b\",\"c\":\"d\",\"e\":\"f\"},[]]]")
}

///| yaml-test-suite LQZ7: Spec Example 7.4. Double Quoted Implicit Keys
test "yts_LQZ7" {
  assert_suite_ok("LQZ7", "\"implicit block key\" : [\n  \"implicit flow key\" : value,\n ]\n", "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
}

///| yaml-test-suite M29M: Literal Block Scalar
test "yts_M29M" {
  assert_suite_ok("M29M", "a: |\n ab\n \n cd\n ef\n \n\n...\n", "[{\"a\":\"ab\\n\\ncd\\nef\\n\"}]")
}

///| yaml-test-suite M5C3: Spec Example 8.21. Block Scalar Nodes
test "yts_M5C3" {
  assert_suite_ok("M5C3", "literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n", "[{\"folded\":\"value\\n\",\"literal\":\"value\\n\"}]")
}

///| yaml-test-suite M6YH: Block sequence indentation
test "yts_M6YH" {
  assert_suite_ok("M6YH", "- |\n x\n-\n foo: bar\n-\n - 42\n", "[[\"x\\n\",{\"foo\":\"bar\"},[42]]]")
}

///| yaml-test-suite M7A3: Spec Example 9.3. Bare Documents
test "yts_M7A3" {
  assert_suite_ok("M7A3", "Bare\ndocument\n...\n# No document\n...\n|\n%!PS-Adobe-2.0 # Not the first line\n", "[\"Bare document\",\"%!PS-Adobe-2.0 # Not the first line\\n\"]")
}

///| yaml-test-suite M7NX: Nested flow collections
test "yts_M7NX" {
  assert_suite_ok("M7NX", "---\n{\n a: [\n  b, c, {\n   d: [e, f]\n  }\n ]\n}\n", "[{\"a\":[\"b\",\"c\",{\"d\":[\"e\",\"f\"]}]}]")
}

///| yaml-test-suite M9B4: Spec Example 8.7. Literal Scalar
test "yts_M9B4" {
  assert_suite_ok("M9B4", "|\n literal\n \ttext\n\n\n", "[\"literal\\n\\ttext\\n\"]")
}

///| yaml-test-suite MJS9: Spec Example 6.7. Block Folding
test "yts_MJS9" {
  assert_suite_ok("MJS9", ">\n  foo \n \n  \t bar\n\n  baz\n", "[\"foo \\n\\n\\t bar\\n\\nbaz\\n\"]")
}

///| yaml-test-suite MUS6_02: Directive variants
test "yts_MUS6_02" {
  assert_suite_ok("MUS6_02", "%YAML  1.1\n---\n", "[null]")
}

///| yaml-test-suite MUS6_03: Directive variants
test "yts_MUS6_03" {
  assert_suite_ok("MUS6_03", "%YAML \t 1.1\n---\n", "[null]")
}

///| yaml-test-suite MUS6_04: Directive variants
test "yts_MUS6_04" {
  assert_suite_ok("MUS6_04", "%YAML 1.1  # comment\n---\n", "[null]")
}

///| yaml-test-suite MUS6_05: Directive variants
test "yts_MUS6_05" {
  assert_suite_ok("MUS6_05", "%YAM 1.1\n---\n", "[null]")
}

///| yaml-test-suite MUS6_06: Directive variants
test "yts_MUS6_06" {
  assert_suite_ok("MUS6_06", "%YAMLL 1.1\n---\n", "[null]")
}

///| yaml-test-suite MXS3: Flow Mapping in Block Sequence
test "yts_MXS3" {
  assert_suite_ok("MXS3", "- {a: b}\n", "[[{\"a\":\"b\"}]]")
}

///| yaml-test-suite MYW6: Block Scalar Strip
test "yts_MYW6" {
  assert_suite_ok("MYW6", "|-\n ab\n \n \n...\n", "[\"ab\"]")
}

///| yaml-test-suite MZX3: Non-Specific Tags on Scalars
test "yts_MZX3" {
  assert_suite_ok("MZX3", "- plain\n- \"double quoted\"\n- 'single quoted'\n- >\n  block\n- plain again\n", "[[\"plain\",\"double quoted\",\"single quoted\",\"block\\n\",\"plain again\"]]")
}

///| yaml-test-suite NAT4: Various empty or newline only quoted strings
test "yts_NAT4" {
  assert_suite_ok("NAT4", "---\na: '\n  '\nb: '  \n  '\nc: \"\n  \"\nd: \"  \n  \"\ne: '\n\n  '\nf: \"\n\n  \"\ng: '\n\n\n  '\nh: \"\n\n\n  \"\n", "[{\"a\":\" \",\"b\":\" \",\"c\":\" \",\"d\":\" \",\"e\":\"\\n\",\"f\":\"\\n\",\"g\":\"\\n\\n\",\"h\":\"\\n\\n\"}]")
}

///| yaml-test-suite NB6Z: Multiline plain value with tabs on empty lines
test "yts_NB6Z" {
  assert_suite_ok("NB6Z", "key:\n  value\n  with\n  \t\n  tabs\n", "[{\"key\":\"value with\\ntabs\"}]")
}

///| yaml-test-suite NJ66: Multiline plain flow mapping key
test "yts_NJ66" {
  assert_suite_ok("NJ66", "---\n- { single line: value}\n- { multi\n  line: value}\n", "[[{\"single line\":\"value\"},{\"multi line\":\"value\"}]]")
}

///| yaml-test-suite NP9H: Spec Example 7.5. Double Quoted Line Breaks
test "yts_NP9H" {
  assert_suite_ok("NP9H", "\"folded \nto a space,\t\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "[\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"]")
}

///| yaml-test-suite P2AD: Spec Example 8.1. Block Scalar Header
test "yts_P2AD" {
  assert_suite_ok("P2AD", "- | # Empty header↓\n literal\n- >1 # Indentation indicator↓\n  folded\n- |+ # Chomping indicator↓\n keep\n\n- >1- # Both indicators↓\n  strip\n", "[[\"literal\\n\",\" folded\\n\",\"keep\\n\\n\",\" strip\"]]")
}

///| yaml-test-suite P76L: Spec Example 6.19. Secondary Tag Handle
test "yts_P76L" {
  assert_suite_ok("P76L", "%TAG !! tag:example.com,2000:app/\n---\n!!int 1 - 3 # Interval, not integer\n", "[\"1 - 3\"]")
}

///| yaml-test-suite P94K: Spec Example 6.11. Multi-Line Comments
test "yts_P94K" {
  assert_suite_ok("P94K", "key:    # Comment\n        # lines\n  value\n\n\n", "[{\"key\":\"value\"}]")
}

///| yaml-test-suite PBJ2: Spec Example 2.3. Mapping Scalars to Sequences
test "yts_PBJ2" {
  assert_suite_ok("PBJ2", "american:\n  - Boston Red Sox\n  - Detroit Tigers\n  - New York Yankees\nnational:\n  - New York Mets\n  - Chicago Cubs\n  - Atlanta Braves\n", "[{\"american\":[\"Boston Red Sox\",\"Detroit Tigers\",\"New York Yankees\"],\"national\":[\"New York Mets\",\"Chicago Cubs\",\"Atlanta Braves\"]}]")
}

///| yaml-test-suite PRH3: Spec Example 7.9. Single Quoted Lines
test "yts_PRH3" {
  assert_suite_ok("PRH3", "' 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty '\n", "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
}

///| yaml-test-suite PUW8: Document start on last line
test "yts_PUW8" {
  assert_suite_ok("PUW8", "---\na: b\n---\n", "[{\"a\":\"b\"},null]")
}

///| yaml-test-suite Q5MG: Tab at beginning of line followed by a flow mapping
test "yts_Q5MG" {
  assert_suite_ok("Q5MG", "\t{}\n", "[{}]")
}

///| yaml-test-suite Q88A: Spec Example 7.23. Flow Content
test "yts_Q88A" {
  assert_suite_ok("Q88A", "- [ a, b ]\n- { a: b }\n- \"a\"\n- 'b'\n- c\n", "[[[\"a\",\"b\"],{\"a\":\"b\"},\"a\",\"b\",\"c\"]]")
}

///| yaml-test-suite Q8AD: Spec Example 7.5. Double Quoted Line Breaks [1.3]
test "yts_Q8AD" {
  assert_suite_ok("Q8AD", "---\n\"folded \nto a space,\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "[\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"]")
}

///| yaml-test-suite QF4Y: Spec Example 7.19. Single Pair Flow Mappings
test "yts_QF4Y" {
  assert_suite_ok("QF4Y", "[\nfoo: bar\n]\n", "[[{\"foo\":\"bar\"}]]")
}

///| yaml-test-suite QT73: Comment and document-end marker
test "yts_QT73" {
  assert_suite_ok("QT73", "# comment\n...\n", "[]")
}

///| yaml-test-suite R4YG: Spec Example 8.2. Block Indentation Indicator
test "yts_R4YG" {
  assert_suite_ok("R4YG", "- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n", "[[\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"\\t\\ndetected\\n\"]]")
}

///| yaml-test-suite R52L: Nested flow mapping sequence and mappings
test "yts_R52L" {
  assert_suite_ok("R52L", "---\n{ top1: [item1, {key2: value2}, item3], top2: value2 }\n", "[{\"top1\":[\"item1\",{\"key2\":\"value2\"},\"item3\"],\"top2\":\"value2\"}]")
}

///| yaml-test-suite RLU9: Sequence Indent
test "yts_RLU9" {
  assert_suite_ok("RLU9", "foo:\n- 42\nbar:\n  - 44\n", "[{\"bar\":[44],\"foo\":[42]}]")
}

///| yaml-test-suite RR7F: Mixed Block Mapping (implicit to explicit)
test "yts_RR7F" {
  assert_suite_ok("RR7F", "a: 4.2\n? d\n: 23\n", "[{\"a\":4.2,\"d\":23}]")
}

///| yaml-test-suite RTP8: Spec Example 9.2. Document Markers
test "yts_RTP8" {
  assert_suite_ok("RTP8", "%YAML 1.2\n---\nDocument\n... # Suffix\n", "[\"Document\"]")
}

///| yaml-test-suite RZT7: Spec Example 2.28. Log File
test "yts_RZT7" {
  assert_suite_ok("RZT7", "---\nTime: 2001-11-23 15:01:42 -5\nUser: ed\nWarning:\n  This is an error message\n  for the log file\n---\nTime: 2001-11-23 15:02:31 -5\nUser: ed\nWarning:\n  A slightly different error\n  message.\n---\nDate: 2001-11-23 15:03:17 -5\nUser: ed\nFatal:\n  Unknown variable \"bar\"\nStack:\n  - file: TopClass.py\n    line: 23\n    code: |\n      x = MoreObject(\"345\\n\")\n  - file: MoreClass.py\n    line: 58\n    code: |-\n      foo = bar\n", "[{\"Time\":\"2001-11-23 15:01:42 -5\",\"User\":\"ed\",\"Warning\":\"This is an error message for the log file\"},{\"Time\":\"2001-11-23 15:02:31 -5\",\"User\":\"ed\",\"Warning\":\"A slightly different error message.\"},{\"Date\":\"2001-11-23 15:03:17 -5\",\"Fatal\":\"Unknown variable \\\"bar\\\"\",\"Stack\":[{\"code\":\"x = MoreObject(\\\"345\\\\n\\\")\\n\",\"file\":\"TopClass.py\",\"line\":23},{\"code\":\"foo = bar\",\"file\":\"MoreClass.py\",\"line\":58}],\"User\":\"ed\"}]")
}

///| yaml-test-suite S4JQ: Spec Example 6.28. Non-Specific Tags
test "yts_S4JQ" {
  assert_suite_ok("S4JQ", "# Assuming conventional resolution:\n- \"12\"\n- 12\n- ! 12\n", "[[\"12\",12,\"12\"]]")
}

///| yaml-test-suite S4T7: Document with footer
test "yts_S4T7" {
  assert_suite_ok("S4T7", "aaa: bbb\n...\n", "[{\"aaa\":\"bbb\"}]")
}

///| yaml-test-suite S7BG: Colon followed by comma
test "yts_S7BG" {
  assert_suite_ok("S7BG", "---\n- :,\n", "[[\":,\"]]")
}

///| yaml-test-suite S9E8: Spec Example 5.3. Block Structure Indicators
test "yts_S9E8" {
  assert_suite_ok("S9E8", "sequence:\n- one\n- two\nmapping:\n  ? sky\n  : blue\n  sea : green\n", "[{\"mapping\":{\"sea\":\"green\",\"sky\":\"blue\"},\"sequence\":[\"one\",\"two\"]}]")
}

///| yaml-test-suite SKE5: Anchor before zero indented sequence
test "yts_SKE5" {
  assert_suite_ok("SKE5", "---\nseq:\n &anchor\n- a\n- b\n", "[{\"seq\":[\"a\",\"b\"]}]")
}

///| yaml-test-suite SM9W_00: Single character streams
test "yts_SM9W_00" {
  assert_suite_ok("SM9W_00", "-", "[[null]]")
}

///| yaml-test-suite SSW6: Spec Example 7.7. Single Quoted Characters [1.3]
test "yts_SSW6" {
  assert_suite_ok("SSW6", "---\n'here''s to \"quotes\"'\n", "[\"here's to \\\"quotes\\\"\"]")
}

///| yaml-test-suite SYW4: Spec Example 2.2. Mapping Scalars to Scalars
test "yts_SYW4" {
  assert_suite_ok("SYW4", "hr:  65    # Home runs\navg: 0.278 # Batting average\nrbi: 147   # Runs Batted In\n", "[{\"avg\":0.278,\"hr\":65,\"rbi\":147}]")
}

///| yaml-test-suite T26H: Spec Example 8.8. Literal Content [1.3]
test "yts_T26H" {
  assert_suite_ok("T26H", "--- |\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "[\"\\n\\nliteral\\n \\n\\ntext\\n\"]")
}

///| yaml-test-suite T4YY: Spec Example 7.9. Single Quoted Lines [1.3]
test "yts_T4YY" {
  assert_suite_ok("T4YY", "---\n' 1st non-empty\n\n 2nd non-empty \n 3rd non-empty '\n", "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
}

///| yaml-test-suite T5N4: Spec Example 8.7. Literal Scalar [1.3]
test "yts_T5N4" {
  assert_suite_ok("T5N4", "--- |\n literal\n \ttext\n\n\n", "[\"literal\\n\\ttext\\n\"]")
}

///| yaml-test-suite TE2A: Spec Example 8.16. Block Mappings
test "yts_TE2A" {
  assert_suite_ok("TE2A", "block mapping:\n key: value\n", "[{\"block mapping\":{\"key\":\"value\"}}]")
}

///| yaml-test-suite TL85: Spec Example 6.8. Flow Folding
test "yts_TL85" {
  assert_suite_ok("TL85", "\"\n  foo \n \n  \t bar\n\n  baz\n\"\n", "[\" foo\\nbar\\nbaz \"]")
}

///| yaml-test-suite TS54: Folded Block Scalar
test "yts_TS54" {
  assert_suite_ok("TS54", ">\n ab\n cd\n \n ef\n\n\n gh\n", "[\"ab cd\\nef\\n\\ngh\\n\"]")
}

///| yaml-test-suite U3C3: Spec Example 6.16. “TAG” directive
test "yts_U3C3" {
  assert_suite_ok("U3C3", "%TAG !yaml! tag:yaml.org,2002:\n---\n!yaml!str \"foo\"\n", "[\"foo\"]")
}

///| yaml-test-suite U3XV: Node and Mapping Key Anchors
test "yts_U3XV" {
  assert_suite_ok("U3XV", "---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4:\n  &node4\n  &k4 key4: four\ntop5:\n  &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n", "[{\"top1\":{\"key1\":\"one\"},\"top2\":{\"key2\":\"two\"},\"top3\":{\"key3\":\"three\"},\"top4\":{\"key4\":\"four\"},\"top5\":{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}]")
}

///| yaml-test-suite U9NS: Spec Example 2.8. Play by Play Feed from a Game
test "yts_U9NS" {
  assert_suite_ok("U9NS", "---\ntime: 20:03:20\nplayer: Sammy Sosa\naction: strike (miss)\n...\n---\ntime: 20:03:47\nplayer: Sammy Sosa\naction: grand slam\n...\n", "[{\"action\":\"strike (miss)\",\"player\":\"Sammy Sosa\",\"time\":\"20:03:20\"},{\"action\":\"grand slam\",\"player\":\"Sammy Sosa\",\"time\":\"20:03:47\"}]")
}

///| yaml-test-suite UDM2: Plain URL in flow mapping
test "yts_UDM2" {
  assert_suite_ok("UDM2", "- { url: http://example.org }\n", "[[{\"url\":\"http://example.org\"}]]")
}

///| yaml-test-suite UDR7: Spec Example 5.4. Flow Collection Indicators
test "yts_UDR7" {
  assert_suite_ok("UDR7", "sequence: [ one, two, ]\nmapping: { sky: blue, sea: green }\n", "[{\"mapping\":{\"sea\":\"green\",\"sky\":\"blue\"},\"sequence\":[\"one\",\"two\"]}]")
}

///| yaml-test-suite UGM3: Spec Example 2.27. Invoice
test "yts_UGM3" {
  assert_suite_ok("UGM3", "--- !<tag:clarkevans.com,2002:invoice>\ninvoice: 34843\ndate   : 2001-01-23\nbill-to: &id001\n    given  : Chris\n    family : Dumars\n    address:\n        lines: |\n            458 Walkman Dr.\n            Suite #292\n        city    : Royal Oak\n        state   : MI\n        postal  : 48046\nship-to: *id001\nproduct:\n    - sku         : BL394D\n      quantity    : 4\n      description : Basketball\n      price       : 450.00\n    - sku         : BL4438H\n      quantity    : 1\n      description : Super Hoop\n      price       : 2392.00\ntax  : 251.42\ntotal: 4443.52\ncomments:\n    Late afternoon is best.\n    Backup contact is Nancy\n    Billsmer @ 338-4338.\n", "[{\"bill-to\":{\"address\":{\"city\":\"Royal Oak\",\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"postal\":48046,\"state\":\"MI\"},\"family\":\"Dumars\",\"given\":\"Chris\"},\"comments\":\"Late afternoon is best. Backup contact is Nancy Billsmer @ 338-4338.\",\"date\":\"2001-01-23\",\"invoice\":34843,\"product\":[{\"description\":\"Basketball\",\"price\":450,\"quantity\":4,\"sku\":\"BL394D\"},{\"description\":\"Super Hoop\",\"price\":2392,\"quantity\":1,\"sku\":\"BL4438H\"}],\"ship-to\":{\"address\":{\"city\":\"Royal Oak\",\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"postal\":48046,\"state\":\"MI\"},\"family\":\"Dumars\",\"given\":\"Chris\"},\"tax\":251.42,\"total\":4443.52}]")
}

///| yaml-test-suite UKK6_01: Syntax character edge cases
test "yts_UKK6_01" {
  assert_suite_ok("UKK6_01", "::\n", "[{\":\":null}]")
}

///| yaml-test-suite UT92: Spec Example 9.4. Explicit Documents
test "yts_UT92" {
  assert_suite_ok("UT92", "---\n{ matches\n% : 20 }\n...\n---\n# Empty\n...\n", "[{\"matches %\":20},null]")
}

///| yaml-test-suite UV7Q: Legal tab after indentation
test "yts_UV7Q" {
  assert_suite_ok("UV7Q", "x:\n - x\n  \tx\n", "[{\"x\":[\"x x\"]}]")
}

///| yaml-test-suite V55R: Aliases in Block Sequence
test "yts_V55R" {
  assert_suite_ok("V55R", "- &a a\n- &b b\n- *a\n- *b\n", "[[\"a\",\"b\",\"a\",\"b\"]]")
}

///| yaml-test-suite VJP3_01: Flow collections over many lines
test "yts_VJP3_01" {
  assert_suite_ok("VJP3_01", "k: {\n k\n :\n v\n }\n", "[{\"k\":{\"k\":\"v\"}}]")
}

///| yaml-test-suite W42U: Spec Example 8.15. Block Sequence Entry Types
test "yts_W42U" {
  assert_suite_ok("W42U", "- # Empty\n- |\n block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n", "[[null,\"block node\\n\",[\"one\",\"two\"],{\"one\":\"two\"}]]")
}

///| yaml-test-suite W4TN: Spec Example 9.5. Directives Documents
test "yts_W4TN" {
  assert_suite_ok("W4TN", "%YAML 1.2\n--- |\n%!PS-Adobe-2.0\n...\n%YAML 1.2\n---\n# Empty\n...\n", "[\"%!PS-Adobe-2.0\\n\",null]")
}

///| yaml-test-suite W5VH: Allowed characters in alias
test "yts_W5VH" {
  assert_suite_ok("W5VH", "a: &:@*!$\"<foo>: scalar a\nb: *:@*!$\"<foo>:\n", "[{\"a\":\"scalar a\",\"b\":\"scalar a\"}]")
}

///| yaml-test-suite WZ62: Spec Example 7.2. Empty Content
test "yts_WZ62" {
  assert_suite_ok("WZ62", "{\n  foo : !!str,\n  !!str : bar,\n}\n", "[{\"\":\"bar\",\"foo\":\"\"}]")
}

///| yaml-test-suite X8DW: Explicit key and value seperated by comment
test "yts_X8DW" {
  assert_suite_ok("X8DW", "---\n? key\n# comment\n: value\n", "[{\"key\":\"value\"}]")
}

///| yaml-test-suite XLQ9: Multiline scalar that looks like a YAML directive
test "yts_XLQ9" {
  assert_suite_ok("XLQ9", "---\nscalar\n%YAML 1.2\n", "[\"scalar %YAML 1.2\"]")
}

///| yaml-test-suite XV9V: Spec Example 6.5. Empty Lines [1.3]
test "yts_XV9V" {
  assert_suite_ok("XV9V", "Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n", "[{\"Chomping\":\"Clipped empty lines\\n\",\"Folding\":\"Empty line\\nas a line feed\"}]")
}

///| yaml-test-suite Y2GN: Anchor with colon in the middle
test "yts_Y2GN" {
  assert_suite_ok("Y2GN", "---\nkey: &an:chor value\n", "[{\"key\":\"value\"}]")
}

///| yaml-test-suite Y79Y_001: Tabs in various contexts
test "yts_Y79Y_001" {
  assert_suite_ok("Y79Y_001", "foo: |\n \t\nbar: 1\n", "[{\"bar\":1,\"foo\":\"\\t\\n\"}]")
}

///| yaml-test-suite Y79Y_002: Tabs in various contexts
test "yts_Y79Y_002" {
  assert_suite_ok("Y79Y_002", "- [\n\t\n foo\n ]\n", "[[[\"foo\"]]]")
}

///| yaml-test-suite Y79Y_010: Tabs in various contexts
test "yts_Y79Y_010" {
  assert_suite_ok("Y79Y_010", "-\t-1\n", "[[-1]]")
}

///| yaml-test-suite YD5X: Spec Example 2.5. Sequence of Sequences
test "yts_YD5X" {
  assert_suite_ok("YD5X", "- [name        , hr, avg  ]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa  , 63, 0.288]\n", "[[[\"name\",\"hr\",\"avg\"],[\"Mark McGwire\",65,0.278],[\"Sammy Sosa\",63,0.288]]]")
}

///| yaml-test-suite Z67P: Spec Example 8.21. Block Scalar Nodes [1.3]
test "yts_Z67P" {
  assert_suite_ok("Z67P", "literal: |2\n  value\nfolded: !foo >1\n value\n", "[{\"folded\":\"value\\n\",\"literal\":\"value\\n\"}]")
}

///| yaml-test-suite Z9M4: Spec Example 6.22. Global Tag Prefix
test "yts_Z9M4" {
  assert_suite_ok("Z9M4", "%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\"\n", "[[\"bar\"]]")
}

///| yaml-test-suite ZF4X: Spec Example 2.6. Mapping of Mappings
test "yts_ZF4X" {
  assert_suite_ok("ZF4X", "Mark McGwire: {hr: 65, avg: 0.278}\nSammy Sosa: {\n    hr: 63,\n    avg: 0.288\n  }\n", "[{\"Mark McGwire\":{\"avg\":0.278,\"hr\":65},\"Sammy Sosa\":{\"avg\":0.288,\"hr\":63}}]")
}

///| yaml-test-suite ZH7C: Anchors in Mapping
test "yts_ZH7C" {
  assert_suite_ok("ZH7C", "&a a: b\nc: &d d\n", "[{\"a\":\"b\",\"c\":\"d\"}]")
}

///| yaml-test-suite ZK9H: Nested top level flow mapping
test "yts_ZK9H" {
  assert_suite_ok("ZK9H", "{ key: [[[\n  value\n ]]]\n}\n", "[{\"key\":[[[\"value\"]]]}]")
}

///| yaml-test-suite ZWK4: Key with anchor after missing explicit mapping value
test "yts_ZWK4" {
  assert_suite_ok("ZWK4", "---\na: 1\n? b\n&anchor c: 3\n", "[{\"a\":1,\"b\":null,\"c\":3}]")
}
