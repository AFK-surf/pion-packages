///| Wasm32 smoke entry for the `yaml` package.

import "yaml"

///|
pub fn smoke() -> Int {
  let src =
  "apiVersion: apps/v1\n" +
  "kind: Deployment\n" +
  "spec:\n" +
  "  replicas: 3\n" +
  "  tags: [prod, edge]\n"
  let v = match yaml::parse(src) {
    Ok(d) => d
    Err(_) => return 1
  }
  let j = yaml::to_canonical_json(v)
  let s = yaml::stringify(v)
  let docs = match yaml::parse_all(s) {
    Ok(ds) => ds
    Err(_) => return 2
  }
  j.length() + s.length() + docs.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
