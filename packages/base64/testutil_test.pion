///| Shared helpers for the `base64` package tests. Independent of the code under test.

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///| 0 = Ok, 1 = InvalidLength, 2 = InvalidByte, 3 = InvalidPadding, 4 = NonCanonical.
fn kind_of(r : Result[Bytes, Base64Error]) -> Int {
  match r {
    Ok(_) => 0
    Err(Base64Error::InvalidLength(_)) => 1
    Err(Base64Error::InvalidByte(_, _)) => 2
    Err(Base64Error::InvalidPadding(_)) => 3
    Err(Base64Error::NonCanonical(_)) => 4
  }
}

///|
fn expect_ok(r : Result[Bytes, Base64Error], expected : Bytes, msg : String) -> Unit {
  match r {
    Ok(b) => debug_assert(bytes_eq(b, expected), msg + ": wrong bytes")
    Err(e) => debug_assert(false, msg + ": unexpected error: " + error_message(e))
  }
}

///|
fn expect_ok_str(r : Result[Bytes, Base64Error], expected : String, msg : String) -> Unit {
  expect_ok(r, expected.to_bytes(), msg)
}

///| `k` is the expected kind as in `kind_of`.
fn expect_err(r : Result[Bytes, Base64Error], k : Int, msg : String) -> Unit {
  let got = kind_of(r)
  debug_assert(
    got == k,
    msg + ": expected kind " + k.to_string() + ", got " + got.to_string(),
  )
}

///|
fn expect_invalid_byte(
  r : Result[Bytes, Base64Error],
  off : Int,
  byte : Int,
  msg : String,
) -> Unit {
  match r {
    Err(Base64Error::InvalidByte(o, b)) =>
    debug_assert(o == off && b == byte, msg + ": wrong offset/byte")
    _ => debug_assert(false, msg + ": expected InvalidByte")
  }
}

///| Bytes from a list of ints.
fn bs(xs : Array[Int]) -> Bytes {
  let out = Bytes::new(xs.length())
  let mut i = 0
  while i < xs.length() {
    out[i] = xs[i].to_byte()
    i = i + 1
  }
  out
}

///| Deterministic xorshift32 byte pattern.
fn pattern(n : Int, seed : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut x = seed | 1
  let mut i = 0
  while i < n {
    x = x ^ (x << 13)
    x = x ^ ((x >> 17) & 0x7FFF)
    x = x ^ (x << 5)
    out[i] = (x & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///| All 256 byte values in order.
fn all_bytes() -> Bytes {
  let out = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    out[i] = i.to_byte()
    i = i + 1
  }
  out
}
