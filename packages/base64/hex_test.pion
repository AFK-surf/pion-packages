///| RFC 4648 §8/§10 Base16 vectors, case handling, strictness and large round trips.

///|
fn ref_hex(data : Bytes, digits : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < data.length() {
    let b = data[i].to_int()
    sb.write_string(digits.slice(b >> 4, (b >> 4) + 1))
    sb.write_string(digits.slice(b & 15, (b & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
test "rfc4648_section10_base16_vectors" {
  let plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  let upper = ["", "66", "666F", "666F6F", "666F6F62", "666F6F6261", "666F6F626172"]
  let lower = ["", "66", "666f", "666f6f", "666f6f62", "666f6f6261", "666f6f626172"]
  let mut i = 0
  while i < plain.length() {
    let p = plain[i]
    let tag = "vector '" + p + "'"
    debug_assert(hex_encode_upper(p.to_bytes()) == upper[i], tag + " upper")
    debug_assert(hex_encode(p.to_bytes()) == lower[i], tag + " lower")
    expect_ok_str(hex_decode(upper[i]), p, tag + " decode upper")
    expect_ok_str(hex_decode(lower[i]), p, tag + " decode lower")
    expect_ok_str(hex_decode_bytes(upper[i].to_bytes()), p, tag + " decode_bytes")
    i = i + 1
  }
}

///|
test "hex_all_byte_values_and_mixed_case" {
  let all = all_bytes()
  let lo = hex_encode(all)
  let up = hex_encode_upper(all)
  debug_assert(lo == ref_hex(all, "0123456789abcdef"), "lower table")
  debug_assert(up == ref_hex(all, "0123456789ABCDEF"), "upper table")
  expect_ok(hex_decode(lo), all, "decode lower")
  expect_ok(hex_decode(up), all, "decode upper")
  expect_ok(hex_decode("aBcD0f"), bs([0xAB, 0xCD, 0x0F]), "mixed case")
  expect_ok(hex_decode("DEADbeef"), bs([0xDE, 0xAD, 0xBE, 0xEF]), "deadbeef")
}

///|
test "hex_strict_rejections" {
  expect_err(hex_decode("0"), 1, "odd length 1")
  expect_err(hex_decode("abc"), 1, "odd length 3")
  match hex_decode("abc") {
    Err(Base64Error::InvalidLength(n)) => debug_assert(n == 3, "length reported")
    _ => debug_assert(false, "expected InvalidLength")
  }
  expect_invalid_byte(hex_decode("0g"), 1, 103, "g")
  expect_invalid_byte(hex_decode("zz"), 0, 122, "z")
  expect_invalid_byte(hex_decode(" 00 "), 0, 32, "space")
  expect_invalid_byte(hex_decode("00\r\n"), 2, 13, "CRLF")
  expect_invalid_byte(hex_decode("0x00"), 1, 120, "0x prefix")
  expect_invalid_byte(hex_decode("é"), 0, 0xC3, "non-ASCII")
  expect_invalid_byte(hex_decode_bytes(bs([0x30, 0x30, 0x30, 0x00])), 3, 0, "NUL")
  expect_invalid_byte(hex_decode_bytes(bs([0x30, 0xFF])), 1, 255, "0xFF")
  expect_invalid_byte(hex_decode("AG"), 1, 71, "G")
  expect_invalid_byte(hex_decode("@0"), 0, 64, "@ (before A)")
  expect_invalid_byte(hex_decode("`0"), 0, 96, "backtick (before a)")
  expect_invalid_byte(hex_decode("/0"), 0, 47, "/ (before 0)")
  expect_invalid_byte(hex_decode(":0"), 0, 58, ": (after 9)")
}

///|
test "hex_large_round_trip" {
  let mut sizes = [65536, 65537, 1048576]
  let mut i = 0
  while i < sizes.length() {
    let n = sizes[i]
    let p = pattern(n, 0xA4093822 + n)
    let tag = "large " + n.to_string()
    let e = hex_encode(p)
    debug_assert(e.length() == n * 2, tag + " length")
    expect_ok(hex_decode(e), p, tag + " lower")
    expect_ok(hex_decode(hex_encode_upper(p)), p, tag + " upper")
    i = i + 1
  }
  sizes = []
}
