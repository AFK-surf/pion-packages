///| Exhaustive canonicality property: a strict decoder accepts a tail
///| exactly when re-encoding its output reproduces the input byte for byte.

///|
let canon_b64 : String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

///|
let canon_b32 : String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

///|
fn sym(alpha : String, i : Int) -> String {
  alpha.slice(i, i + 1)
}

///|
fn check_b64(s : String) -> Bool {
  match decode(s) {
    Ok(b) => encode(b) == s
    Err(Base64Error::NonCanonical(_)) => encode(decode_loose(s).unwrap_or(Bytes::new(0))) != s
    Err(_) => false
  }
}

///|
test "base64_every_two_and_three_symbol_tail" {
  let mut accepted2 = 0
  let mut a = 0
  while a < 64 {
    let mut b = 0
    while b < 64 {
      let s = "Zm9v" + sym(canon_b64, a) + sym(canon_b64, b) + "=="
      debug_assert(check_b64(s), "2-symbol tail " + s)
      if kind_of(decode(s)) == 0 {
        accepted2 = accepted2 + 1
      }
      b = b + 1
    }
    a = a + 1
  }
  // 64 first symbols x 4 second symbols with zero low nibble.
  debug_assert(accepted2 == 256, "accepted 2-symbol tails")
  let mut accepted3 = 0
  a = 0
  while a < 64 {
    let mut b = 0
    while b < 64 {
      let mut c = 0
      while c < 64 {
        let s = sym(canon_b64, a) + sym(canon_b64, b) + sym(canon_b64, c) + "="
        debug_assert(check_b64(s), "3-symbol tail " + s)
        if kind_of(decode(s)) == 0 {
          accepted3 = accepted3 + 1
        }
        c = c + 1
      }
      b = b + 1
    }
    a = a + 1
  }
  debug_assert(accepted3 == 65536, "accepted 3-symbol tails")
}

///|
test "base32_every_last_symbol_of_each_tail_length" {
  let tails = [2, 4, 5, 7]
  let spare = [3, 15, 1, 7]
  let mut t = 0
  while t < tails.length() {
    let k = tails[t]
    let mut p = 0
    while p < 64 {
      let prefix = pattern(k - 1, 0x5151 + p * 7 + k)
      let sb = StringBuilder::new()
      let mut i = 0
      while i < k - 1 {
        sb.write_string(sym(canon_b32, prefix[i].to_int() & 31))
        i = i + 1
      }
      let head = sb.to_string()
      let mut last = 0
      while last < 32 {
        let raw = head + sym(canon_b32, last)
        let r = base32_decode_no_pad(raw)
        let canonical = (last & spare[t]) == 0
        match r {
          Ok(b) => {
            debug_assert(canonical, "accepted non-canonical " + raw)
            debug_assert(base32_encode_no_pad(b) == raw, "re-encode " + raw)
          }
          Err(Base64Error::NonCanonical(off)) => {
            debug_assert(!canonical, "rejected canonical " + raw)
            debug_assert(off == k - 1, "offset " + raw)
          }
          Err(_) => debug_assert(false, "unexpected error " + raw)
        }
        last = last + 1
      }
      p = p + 1
    }
    t = t + 1
  }
}
