///| Cross-target smoke entry for the `base64` package: prints RFC 4648
///| vectors, strict-decoder verdicts and large round-trip digests. Its
///| stdout must be byte-identical on Native and wasm32, debug and release.

import "base64"

///|
fn gen(n : Int, seed : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut x = seed
  let mut i = 0
  while i < n {
    x = x ^ (x << 13)
    x = x ^ ((x >> 17) & 0x7FFF)
    x = x ^ (x << 5)
    out[i] = (x & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn fnv1a(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn verdict(r : Result[Bytes, base64::Base64Error]) -> String {
  match r {
    Ok(b) => "ok:" + base64::hex_encode(b)
    Err(e) => "err:" + base64::error_message(e)
  }
}

///|
fn same(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn round_trip_ok(r : Result[Bytes, base64::Base64Error], want : Bytes) -> Bool {
  match r {
    Ok(b) => same(b, want)
    Err(_) => false
  }
}

///|
pub fn main(world : World) -> Int {
  let plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  let mut i = 0
  while i < plain.length() {
    let p = plain[i].to_bytes()
    io_println(
      world,
      "'" + plain[i] + "' b64=" + base64::encode(p) + " url=" + base64::url_encode_no_pad(p) +
      " b32=" + base64::base32_encode(p) + " b32hex=" + base64::base32_hex_encode(p) +
      " hex=" + base64::hex_encode_upper(p),
    )
    i = i + 1
  }
  let probes = ["AA==", "AB==", "AAA=", "AAB=", "A", "A===", "AA=A", "ab-c", "Zm9v YmF", "Zé="]
  i = 0
  while i < probes.length() {
    io_println(world, "decode " + probes[i] + " -> " + verdict(base64::decode(probes[i])))
    i = i + 1
  }
  let b32_probes = ["MY======", "MZ======", "MZXR====", "MZXW7===", "MZXW6YR=", "MZXW6Y==", "my======"]
  i = 0
  while i < b32_probes.length() {
    io_println(
      world,
      "base32_decode " + b32_probes[i] + " -> " + verdict(base64::base32_decode(b32_probes[i])),
    )
    i = i + 1
  }
  io_println(world, "decode_loose ' Zm9v\\r\\nYmE=' -> " + verdict(base64::decode_loose(" Zm9v\r\nYmE=")))
  io_println(world, "hex_decode 0g -> " + verdict(base64::hex_decode("0g")))
  let sizes = [65536, 1048576 + 1]
  i = 0
  let mut failures = 0
  while i < sizes.length() {
    let data = gen(sizes[i], 0x9E3779B9 + i)
    let e = base64::encode(data)
    let u = base64::url_encode_no_pad(data)
    let t = base64::base32_encode(data)
    let h = base64::hex_encode(data)
    let ok = round_trip_ok(base64::decode(e), data) &&
    round_trip_ok(base64::url_decode_no_pad(u), data) &&
    round_trip_ok(base64::decode_loose(u), data) &&
    round_trip_ok(base64::base32_decode(t), data) &&
    round_trip_ok(base64::hex_decode(h), data)
    if !ok {
      failures = failures + 1
    }
    io_println(
      world,
      "size=" + sizes[i].to_string() + " roundtrip=" + (if ok { "ok" } else { "FAIL" }) +
      " b64=" + fnv1a(e.to_bytes()).to_string() + " url=" + fnv1a(u.to_bytes()).to_string() +
      " b32=" + fnv1a(t.to_bytes()).to_string() + " hex=" + fnv1a(h.to_bytes()).to_string(),
    )
    i = i + 1
  }
  failures
}
