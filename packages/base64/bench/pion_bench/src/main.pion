///| Head-to-head benchmark for packages/base64 (Pion Native).
///| usage: base64_bench <mode> [size_bytes] [rounds]
///| modes: b64_encode b64_decode url_encode url_decode b32_encode b32_decode
///|        hex_encode hex_decode
///| The input is `size` xorshift32 bytes (seed 0x9E3779B9). Encode modes
///| encode it `rounds` times; decode modes encode it once, then decode
///| `rounds` times. Output (byte-identical across implementations): the
///| mode, sizes, a per-round sample checksum and FNV-1a 64 of the last result.

import "base64"

///|
fn gen(n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut x = 0x9E3779B9
  let mut i = 0
  while i < n {
    x = x ^ (x << 13)
    x = x ^ ((x >> 17) & 0x7FFF)
    x = x ^ (x << 5)
    out[i] = (x & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn fnv1a(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn encode_mode(mode : String, data : Bytes) -> String {
  if mode == "b64_encode" || mode == "b64_decode" {
    base64::encode(data)
  } else if mode == "url_encode" || mode == "url_decode" {
    base64::url_encode_no_pad(data)
  } else if mode == "b32_encode" || mode == "b32_decode" {
    base64::base32_encode(data)
  } else {
    base64::hex_encode(data)
  }
}

///|
fn decode_mode(mode : String, s : String) -> Result[Bytes, base64::Base64Error] {
  if mode == "b64_decode" {
    base64::decode(s)
  } else if mode == "url_decode" {
    base64::url_decode_no_pad(s)
  } else if mode == "b32_decode" {
    base64::base32_decode(s)
  } else {
    base64::hex_decode(s)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: base64_bench <mode> [size_bytes] [rounds]")
    return 2
  }
  let mode = args[1]
  let size = if args.length() > 2 { args[2].to_int().unwrap_or(4194304) } else { 4194304 }
  let rounds = if args.length() > 3 { args[3].to_int().unwrap_or(16) } else { 16 }
  let data = gen(size)
  let is_encode = mode == "b64_encode" || mode == "url_encode" ||
  mode == "b32_encode" || mode == "hex_encode"
  let mut sample = 0
  let mut last = Bytes::new(0)
  let mut out_len = 0
  if is_encode {
    let mut r = 0
    while r < rounds {
      let s = encode_mode(mode, data)
      out_len = s.length()
      sample = sample + s.code_unit_at(r * 7919 % out_len)
      if r == rounds - 1 {
        last = s.to_bytes()
      }
      r = r + 1
    }
  } else {
    let text = encode_mode(mode, data)
    let mut r = 0
    while r < rounds {
      match decode_mode(mode, text) {
        Ok(b) => {
          out_len = b.length()
          sample = sample + b[r * 7919 % out_len].to_int()
          if r == rounds - 1 {
            last = b
          }
        }
        Err(e) => {
          io_println(world, "decode error: " + base64::error_message(e))
          return 1
        }
      }
      r = r + 1
    }
  }
  io_println(world, "mode=" + mode)
  io_println(world, "input_bytes=" + size.to_string())
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "output_bytes=" + out_len.to_string())
  io_println(world, "sample=" + sample.to_string())
  io_println(world, "fnv1a64=" + fnv1a(last).to_string())
  0
}
