///| RFC 4648 §4/§5/§10 Base64 and Base64URL vectors, Go `encoding/base64`
///| pairs and corruption cases, strictness (non-canonical trailing bits,
///| padding, alphabet) and large round trips.

///|
test "rfc4648_section10_base64_vectors" {
  let plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  let padded = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]
  let raw = ["", "Zg", "Zm8", "Zm9v", "Zm9vYg", "Zm9vYmE", "Zm9vYmFy"]
  let mut i = 0
  while i < plain.length() {
    let p = plain[i]
    let tag = "vector '" + p + "'"
    debug_assert(encode(p.to_bytes()) == padded[i], tag + " encode")
    debug_assert(encode_no_pad(p.to_bytes()) == raw[i], tag + " encode_no_pad")
    debug_assert(url_encode(p.to_bytes()) == padded[i], tag + " url_encode")
    debug_assert(url_encode_no_pad(p.to_bytes()) == raw[i], tag + " url_encode_no_pad")
    expect_ok_str(decode(padded[i]), p, tag + " decode")
    expect_ok_str(decode_bytes(padded[i].to_bytes()), p, tag + " decode_bytes")
    expect_ok_str(decode_no_pad(raw[i]), p, tag + " decode_no_pad")
    expect_ok_str(url_decode(padded[i]), p, tag + " url_decode")
    expect_ok_str(url_decode_bytes(padded[i].to_bytes()), p, tag + " url_decode_bytes")
    expect_ok_str(url_decode_no_pad(raw[i]), p, tag + " url_decode_no_pad")
    expect_ok_str(decode_loose(padded[i]), p, tag + " decode_loose padded")
    expect_ok_str(decode_loose(raw[i]), p, tag + " decode_loose raw")
    i = i + 1
  }
}

///|
test "go_encoding_base64_pairs" {
  // RFC 3548 examples (Go encoding/base64 `pairs`).
  let a = bs([0x14, 0xfb, 0x9c, 0x03, 0xd9, 0x7e])
  let b = bs([0x14, 0xfb, 0x9c, 0x03, 0xd9])
  let c = bs([0x14, 0xfb, 0x9c, 0x03])
  debug_assert(encode(a) == "FPucA9l+", "rfc3548 a std")
  debug_assert(url_encode(a) == "FPucA9l-", "rfc3548 a url")
  debug_assert(encode(b) == "FPucA9k=", "rfc3548 b")
  debug_assert(encode(c) == "FPucAw==", "rfc3548 c")
  debug_assert(encode_no_pad(c) == "FPucAw", "rfc3548 c raw")
  expect_ok(decode("FPucA9l+"), a, "rfc3548 a decode")
  expect_ok(url_decode("FPucA9l-"), a, "rfc3548 a url decode")
  expect_ok(decode("FPucA9k="), b, "rfc3548 b decode")
  expect_ok(decode("FPucAw=="), c, "rfc3548 c decode")
  expect_ok(url_decode_no_pad("FPucAw"), c, "rfc3548 c url raw decode")

  // Wikipedia examples.
  let plain = ["sure.", "sure", "sur", "su", "leasure.", "easure.", "asure."]
  let enc = ["c3VyZS4=", "c3VyZQ==", "c3Vy", "c3U=", "bGVhc3VyZS4=", "ZWFzdXJlLg==", "YXN1cmUu"]
  let mut i = 0
  while i < plain.length() {
    debug_assert(encode(plain[i].to_bytes()) == enc[i], "wiki encode " + plain[i])
    expect_ok_str(decode(enc[i]), plain[i], "wiki decode " + plain[i])
    i = i + 1
  }
  debug_assert(
    encode("Twas brillig, and the slithy toves".to_bytes()) ==
    "VHdhcyBicmlsbGlnLCBhbmQgdGhlIHNsaXRoeSB0b3Zlcw==",
    "bigtest",
  )
}

///|
test "alphabets_and_all_byte_values" {
  let special = bs([0xFB, 0xFF, 0xBF])
  debug_assert(encode(special) == "+/+/", "std alphabet")
  debug_assert(url_encode(special) == "-_-_", "url alphabet")
  let zeros = bs([0, 0, 0])
  debug_assert(encode(zeros) == "AAAA", "zeros")
  let all = all_bytes()
  let e = encode(all)
  debug_assert(e.length() == 344, "256 bytes -> 344 chars")
  debug_assert(
    e.slice(0, 24) == "AAECAwQFBgcICQoLDA0ODxAR",
    "all bytes prefix",
  )
  debug_assert(e.slice(320, 344) == "8PHy8/T19vf4+fr7/P3+/w==", "all bytes suffix")
  expect_ok(decode(e), all, "all bytes std")
  expect_ok(decode_no_pad(encode_no_pad(all)), all, "all bytes std raw")
  expect_ok(url_decode(url_encode(all)), all, "all bytes url")
  expect_ok(url_decode_no_pad(url_encode_no_pad(all)), all, "all bytes url raw")
  expect_ok(decode_loose(e), all, "all bytes loose std")
  expect_ok(decode_loose(url_encode_no_pad(all)), all, "all bytes loose url")
  // Every length 0..64 round-trips in all modes.
  let mut n = 0
  while n <= 64 {
    let p = pattern(n, 0x1234 + n)
    let tag = "len " + n.to_string()
    expect_ok(decode(encode(p)), p, tag + " std")
    expect_ok(decode_no_pad(encode_no_pad(p)), p, tag + " std raw")
    expect_ok(url_decode(url_encode(p)), p, tag + " url")
    expect_ok(url_decode_no_pad(url_encode_no_pad(p)), p, tag + " url raw")
    debug_assert(encode(p).length() == (n + 2) / 3 * 4, tag + " padded length")
    debug_assert(encode_no_pad(p).length() == (n * 4 + 2) / 3, tag + " raw length")
    n = n + 1
  }
}

///|
test "strict_rejects_non_canonical_trailing_bits" {
  // 2-symbol tail: low 4 bits of the 2nd symbol must be zero.
  expect_ok(decode("AA=="), bs([0]), "AA== ok")
  expect_err(decode("AB=="), 4, "AB== std")
  expect_err(decode("AP=="), 4, "AP== std")
  expect_ok_str(decode("Zg=="), "f", "Zg== ok")
  expect_err(decode("Zh=="), 4, "Zh== std")
  expect_err(decode_no_pad("AB"), 4, "AB raw")
  expect_err(url_decode("AB=="), 4, "AB== url")
  expect_err(url_decode_no_pad("AB"), 4, "AB url raw")
  // 3-symbol tail: low 2 bits of the 3rd symbol must be zero.
  expect_ok(decode("AAA="), bs([0, 0]), "AAA= ok")
  expect_err(decode("AAB="), 4, "AAB= std")
  expect_err(decode("AAD="), 4, "AAD= std")
  expect_ok_str(decode("Zm8="), "fo", "Zm8= ok")
  expect_err(decode("Zm9="), 4, "Zm9= std")
  expect_err(decode_no_pad("AAB"), 4, "AAB raw")
  expect_err(url_decode("AAB="), 4, "AAB= url")
  expect_err(url_decode_no_pad("Zm9"), 4, "Zm9 url raw")
  // Tail after full blocks.
  expect_err(decode("Zm9vZh=="), 4, "full block + Zh==")
  match decode("Zm9vZh==") {
    Err(Base64Error::NonCanonical(off)) => debug_assert(off == 5, "offset of Zh== tail")
    _ => debug_assert(false, "expected NonCanonical")
  }
  // The loose decoder accepts them, discarding the bits.
  expect_ok(decode_loose("AB=="), bs([0]), "loose AB==")
  expect_ok(decode_loose("AAB"), bs([0, 0]), "loose AAB")
}

///|
test "strict_rejects_bad_length_and_padding" {
  // Go encoding/base64 TestDecodeCorrupt-style inputs.
  expect_err(decode("A"), 1, "A")
  expect_err(decode("AAA"), 1, "AAA (padding required)")
  expect_err(decode("Zg"), 1, "Zg (padding required)")
  expect_err(decode("Zg="), 1, "Zg=")
  expect_err(decode("AAAAA"), 1, "AAAAA")
  expect_err(decode("AAAAAA"), 1, "AAAAAA")
  expect_err(decode_no_pad("A"), 1, "raw A")
  expect_err(decode_no_pad("AAAAA"), 1, "raw AAAAA")
  expect_err(url_decode_no_pad("AAAAAAAAA"), 1, "url raw len 9")
  expect_err(decode("===="), 3, "====")
  expect_err(decode("A==="), 3, "A===")
  expect_err(decode("=AAA"), 3, "=AAA")
  expect_err(decode("A=AA"), 3, "A=AA")
  expect_err(decode("AA=A"), 3, "AA=A")
  expect_err(decode("AA==A==="), 3, "AA==A===")
  expect_err(decode("AAA=AAAA"), 3, "AAA=AAAA")
  expect_err(decode("Zg==Zg=="), 3, "Zg==Zg==")
  expect_err(decode_no_pad("Zg=="), 3, "raw with padding")
  expect_err(decode_no_pad("Zm8="), 3, "raw with single pad")
  expect_err(url_decode_no_pad("Zg=="), 3, "url raw with padding")
  match decode("AA=A") {
    Err(Base64Error::InvalidPadding(off)) => debug_assert(off == 2, "AA=A offset")
    _ => debug_assert(false, "AA=A kind")
  }
}

///|
test "strict_rejects_foreign_alphabet_whitespace_and_non_ascii" {
  expect_invalid_byte(decode("ab-c"), 2, 45, "std rejects -")
  expect_invalid_byte(decode("ab_c"), 2, 95, "std rejects _")
  expect_invalid_byte(url_decode("ab+c"), 2, 43, "url rejects +")
  expect_invalid_byte(url_decode("ab/c"), 2, 47, "url rejects /")
  expect_invalid_byte(decode("Zm9v!mFy"), 4, 33, "!")
  expect_invalid_byte(decode("Zm9v YmF"), 4, 32, "inner space")
  expect_invalid_byte(decode(" Zm9vYmF"), 0, 32, "leading space")
  expect_invalid_byte(decode("Zm9vYmFy\r\n\r\n"), 8, 13, "trailing CRLF")
  expect_invalid_byte(decode("Zm9v\tm8="), 4, 9, "tab")
  expect_invalid_byte(decode("Zé="), 1, 0xC3, "non-ASCII UTF-8")
  expect_invalid_byte(decode_bytes(bs([0x5A, 0x67, 0x00, 0x3D])), 2, 0, "NUL byte")
  expect_invalid_byte(decode_bytes(bs([0xFF, 0x67, 0x3D, 0x3D])), 0, 255, "0xFF")
  expect_invalid_byte(url_decode_bytes(bs([0x5A, 0x80, 0x3D, 0x3D])), 1, 128, "0x80")
  expect_invalid_byte(decode_no_pad("Zm9vYm\n"), 6, 10, "raw newline")
}

///|
test "loose_decoder" {
  expect_ok_str(decode_loose("Zm9v\r\nYmFy"), "foobar", "CRLF")
  expect_ok_str(decode_loose(" Zm 9v\tYm\nE = "), "fooba", "scattered whitespace")
  expect_ok_str(decode_loose("Zg= ="), "f", "whitespace between pads")
  expect_ok_str(decode_loose("\u{0B}\u{0C}Zg"), "f", "VT and FF")
  expect_ok(decode_loose("+/+/"), bs([0xFB, 0xFF, 0xBF]), "std alphabet")
  expect_ok(decode_loose("-_-_"), bs([0xFB, 0xFF, 0xBF]), "url alphabet")
  expect_ok(decode_loose("-/+_"), bs([0xFB, 0xFF, 0xBF]), "mixed alphabets")
  expect_ok_str(decode_loose("Zg"), "f", "missing padding")
  expect_ok_str(decode_loose("Zm8"), "fo", "missing single pad")
  expect_ok_str(decode_loose(""), "", "empty")
  expect_ok_str(decode_loose(" \n\t"), "", "only whitespace")
  expect_err(decode_loose("Z"), 1, "one symbol")
  expect_err(decode_loose("Zm9vY"), 1, "len % 4 == 1")
  expect_err(decode_loose("Zg="), 3, "one pad where two are needed")
  expect_err(decode_loose("Zg==="), 3, "three pads")
  expect_err(decode_loose("Zm8=="), 3, "two pads where one is needed")
  expect_err(decode_loose("AAAA="), 3, "pad after full block")
  expect_err(decode_loose("Zg==Zg"), 3, "data after padding")
  expect_err(decode_loose("="), 3, "pad only")
  expect_invalid_byte(decode_loose("Zm9v!"), 4, 33, "loose rejects !")
  expect_invalid_byte(decode_loose("Zé=="), 1, 0xC3, "loose rejects non-ASCII")
}

///|
fn wrap76(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let end = if i + 76 < n { i + 76 } else { n }
    sb.write_string(s.slice(i, end))
    sb.write_string("\r\n")
    i = end
  }
  sb.to_string()
}

///|
fn large_round_trip(n : Int, seed : Int) -> Unit {
  let p = pattern(n, seed)
  let tag = "large " + n.to_string()
  let e = encode(p)
  debug_assert(e.length() == (n + 2) / 3 * 4, tag + " length")
  expect_ok(decode(e), p, tag + " std")
  expect_ok(decode_no_pad(encode_no_pad(p)), p, tag + " std raw")
  let u = url_encode(p)
  expect_ok(url_decode(u), p, tag + " url")
  expect_ok(url_decode_no_pad(url_encode_no_pad(p)), p, tag + " url raw")
  expect_ok(decode_loose(u), p, tag + " loose url")
  expect_ok(decode_loose(wrap76(e)), p, tag + " loose MIME-wrapped")
}

///|
test "large_round_trip_64k" {
  large_round_trip(65536, 0x9E3779B9)
  large_round_trip(65537, 0x7F4A7C15)
  large_round_trip(65538, 0x2545F491)
}

///|
test "large_round_trip_1m" {
  large_round_trip(1048576, 0x6A09E667)
}

///|
test "error_messages" {
  debug_assert(error_message(Base64Error::InvalidLength(5)) == "invalid input length 5", "len")
  debug_assert(
    error_message(Base64Error::InvalidByte(3, 33)) == "invalid byte 33 at offset 3",
    "byte",
  )
  debug_assert(
    error_message(Base64Error::InvalidPadding(2)) == "invalid padding at offset 2",
    "pad",
  )
  debug_assert(
    error_message(Base64Error::NonCanonical(1)) == "non-canonical trailing bits at offset 1",
    "noncanon",
  )
}
