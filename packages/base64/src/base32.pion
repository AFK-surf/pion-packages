///| RFC 4648 §6 Base32 and §7 Base32hex (stubs).

///|
pub fn base32_encode(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn base32_encode_no_pad(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn base32_hex_encode(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn base32_hex_encode_no_pad(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn base32_decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn base32_decode(s : String) -> Result[Bytes, Base64Error] {
  base32_decode_bytes(s.to_bytes())
}

///|
pub fn base32_decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  let _ = s
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn base32_hex_decode(s : String) -> Result[Bytes, Base64Error] {
  let _ = s
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn base32_hex_decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  let _ = s
  Err(Base64Error::InvalidLength(-1))
}
