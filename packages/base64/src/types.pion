///| Error type shared by every decoder in the `base64` package
///| (Base64, Base64URL, Base32, Base32hex and Hex).

///| Why a decode was refused. Offsets are byte offsets into the input.
pub enum Base64Error {
  ///| The input length can never be produced by the encoder
  ///| (for example `len % 4 == 1` for Base64, or an odd length for Hex).
  InvalidLength(Int)
  ///| `InvalidByte(offset, byte)`: a byte outside the alphabet
  ///| (wrong alphabet, whitespace in strict mode, or a non-ASCII byte).
  InvalidByte(Int, Int)
  ///| Padding (`=`) that is missing, superfluous, or not at the end.
  InvalidPadding(Int)
  ///| The last symbol at this offset carries non-zero trailing bits,
  ///| so the input is not the canonical encoding of any byte string.
  NonCanonical(Int)
}

///| A short, stable English description of the error.
pub fn error_message(e : Base64Error) -> String {
  match e {
    Base64Error::InvalidLength(n) => "invalid input length " + n.to_string()
    Base64Error::InvalidByte(off, b) =>
    "invalid byte " + b.to_string() + " at offset " + off.to_string()
    Base64Error::InvalidPadding(off) =>
    "invalid padding at offset " + off.to_string()
    Base64Error::NonCanonical(off) =>
    "non-canonical trailing bits at offset " + off.to_string()
  }
}
