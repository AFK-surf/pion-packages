///| RFC 4648 §8 Base16 (hex). Encoding is lowercase (`hex_encode`) or
///| uppercase (`hex_encode_upper`); decoding accepts either case, even
///| mixed, and nothing else.

///| Lowercase hex digits.
let hex_lower_enc : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
]

///| Uppercase hex digits.
let hex_upper_enc : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'A', b'B', b'C', b'D', b'E', b'F',
]

///| Compact 256-byte nibble table (`0..=15`, `0xFF` elsewhere).
let hex_dec_u8 : FixedArray[Byte] = [
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\x00', b'\x01', b'\x02', b'\x03', b'\x04', b'\x05', b'\x06', b'\x07',
  b'\x08', b'\x09', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\x0a', b'\x0b', b'\x0c', b'\x0d', b'\x0e', b'\x0f', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\x0a', b'\x0b', b'\x0c', b'\x0d', b'\x0e', b'\x0f', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
  b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff', b'\xff',
]

///| Encoded hex string length for `n` input bytes.
///| Returns `0` for `n <= 0` and saturates at `Int::MAX` (`2147483647`) if the
///| exact length exceeds `Int::MAX`.
#verify
pub fn hex_encoded_len(n : Int) -> Int {
  if n <= 0 {
    0
  } else {
    let res = n.to_int64() * 2L
    if res > 2147483647L {
      2147483647
    } else {
      res.to_int()
    }
  }
}

///| Compute exact hex encoded length, returning `None` on negative input
///| or if the result exceeds `Int::MAX` (`2147483647`).
pub fn checked_hex_encoded_len(n : Int) -> Option[Int] {
  if n < 0 {
    return None
  }
  let res = n.to_int64() * 2L
  if res > 2147483647L {
    None
  } else {
    Some(res.to_int())
  }
}

///| Decoded byte length for `n` hex characters (`-1` if `< 0` or odd).
#verify
pub fn hex_decoded_len(n : Int) -> Int {
  if n < 0 {
    -1
  } else if (n & 1) != 0 {
    -1
  } else {
    n >> 1
  }
}

///| Pack two 4-bit hex nibbles into one byte (negative if either nibble is `< 0`).
#verify
pub fn hex_pack_byte(hi : Int, lo : Int) -> Int {
  (hi << 4) | lo
}

///|
fn hex_encode_with(data : Bytes, lut : FixedArray[Byte]) -> String {
  let n = data.length()
  let out_len = match checked_hex_encoded_len(n) {
    Some(l) => l
    None => panic("hex: encoded length exceeds Int::MAX")
  }
  let out = Bytes::new(out_len)
  let mut i = 0
  while i < n {
    let b = data[i].to_int()
    let j = i << 1
    out[j] = lut[b >> 4]
    out[j + 1] = lut[b & 15]
    i = i + 1
  }
  out.to_string()
}

///| Lowercase hex.
pub fn hex_encode(data : Bytes) -> String {
  hex_encode_with(data, hex_lower_enc)
}

///| Uppercase hex.
pub fn hex_encode_upper(data : Bytes) -> String {
  hex_encode_with(data, hex_upper_enc)
}

///| Strict hex over bytes: even length, `0-9a-fA-F` only.
pub fn hex_decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let n = input.length()
  let half = hex_decoded_len(n)
  if half < 0 {
    return Err(Base64Error::InvalidLength(n))
  }
  let lut = hex_dec_u8
  let out = Bytes::new(half)
  let mut i = 0
  let mut err_at = -1
  while i < half {
    let si = i << 1
    let hi = lut[input[si].to_int()].to_int()
    let lo = lut[input[si + 1].to_int()].to_int()
    if ((hi | lo) & 16) != 0 {
      err_at = si
      break
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  if err_at >= 0 {
    let c0 = input[err_at].to_int()
    if lut[c0].to_int() > 15 {
      return Err(Base64Error::InvalidByte(err_at, c0))
    }
    return Err(Base64Error::InvalidByte(err_at + 1, input[err_at + 1].to_int()))
  }
  Ok(out)
}

///| `hex_decode_bytes` over a `String` (zero-copy direct read).
pub fn hex_decode(s : String) -> Result[Bytes, Base64Error] {
  let n = s.length()
  let half = hex_decoded_len(n)
  if half < 0 {
    return Err(Base64Error::InvalidLength(n))
  }
  let lut = hex_dec_u8
  let out = Bytes::new(half)
  let mut i = 0
  let mut err_at = -1
  while i < half {
    let si = i << 1
    let hi = lut[s.code_unit_at(si)].to_int()
    let lo = lut[s.code_unit_at(si + 1)].to_int()
    if ((hi | lo) & 16) != 0 {
      err_at = si
      break
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  if err_at >= 0 {
    let c0 = s.code_unit_at(err_at)
    if lut[c0].to_int() > 15 {
      return Err(Base64Error::InvalidByte(err_at, c0))
    }
    return Err(Base64Error::InvalidByte(err_at + 1, s.code_unit_at(err_at + 1)))
  }
  Ok(out)
}
