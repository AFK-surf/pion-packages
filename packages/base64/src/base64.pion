///| Compute Base64 encoded length for `n` input bytes (padded or unpadded).
///| Returns `0` for `n <= 0` and saturates at `Int::MAX` (`2147483647`) if the
///| exact length exceeds `Int::MAX`.
#verify
pub fn encoded_len(n : Int, pad : Bool) -> Int {
  if n <= 0 {
    0
  } else {
    let n64 = n.to_int64()
    let res = if pad {
      (n64 + 2L) / 3L * 4L
    } else {
      (n64 * 4L + 2L) / 3L
    }
    if res > 2147483647L {
      2147483647
    } else {
      res.to_int()
    }
  }
}

///| Compute exact Base64 encoded length, returning `None` on negative input
///| or if the result exceeds `Int::MAX` (`2147483647`).
pub fn checked_encoded_len(n : Int, pad : Bool) -> Option[Int] {
  if n < 0 {
    return None
  }
  let n64 = n.to_int64()
  let res = if pad {
    (n64 + 2L) / 3L * 4L
  } else {
    (n64 * 4L + 2L) / 3L
  }
  if res > 2147483647L {
    None
  } else {
    Some(res.to_int())
  }
}

///| Compute decoded byte length from unpadded Base64 symbol count (`-1` if `< 0` or `len % 4 == 1`).
#verify
pub fn b64_decoded_len(unpadded_len : Int) -> Int {
  if unpadded_len < 0 {
    -1
  } else {
    let rem = unpadded_len & 3
    if rem == 1 {
      -1
    } else {
      (unpadded_len >> 2) * 3 + (if rem == 0 { 0 } else { rem - 1 })
    }
  }
}

///| Pack 3 raw bytes into a 24-bit Base64 group.
#verify
pub fn b64_pack3(b0 : Int, b1 : Int, b2 : Int) -> Int {
  (b0 << 16) | (b1 << 8) | b2
}

///| Pack 4 Base64 sextets (`0..=63`) into a 24-bit group (negative if any sextet is `< 0`).
#verify
pub fn b64_pack4_sextets(s0 : Int, s1 : Int, s2 : Int, s3 : Int) -> Int {
  (s0 << 18) | (s1 << 12) | (s2 << 6) | s3
}

///| Canonical trailing-bit mask for an unpadded Base64 tail (`rem == 2 -> 15`, `rem == 3 -> 3`).
#verify
pub fn b64_tail_canonical_mask(rem : Int) -> Int {
  if rem == 2 {
    15
  } else if rem == 3 {
    3
  } else {
    0
  }
}

///| Expected number of `=` pad bytes for `rest = digits & 3`.
#verify
pub fn b64_expected_pad(rest : Int) -> Int {
  if rest == 0 {
    0
  } else {
    4 - rest
  }
}

///|
fn encode_with(data : Bytes, lut : FixedArray[Byte], pad : Bool) -> String {
  let n = data.length()
  let out_len = match checked_encoded_len(n, pad) {
    Some(l) => l
    None => panic("base64: encoded length exceeds Int::MAX")
  }
  let out = Bytes::new(out_len)
  let limit = n / 3 * 3
  let mut si = 0
  let mut di = 0
  while si < limit {
    let v = b64_pack3(data[si].to_int(), data[si + 1].to_int(), data[si + 2].to_int())
    out[di] = lut[v >> 18]
    out[di + 1] = lut[(v >> 12) & 63]
    out[di + 2] = lut[(v >> 6) & 63]
    out[di + 3] = lut[v & 63]
    si = si + 3
    di = di + 4
  }
  let rem = n - limit
  if rem == 1 {
    let v = data[si].to_int()
    out[di] = lut[v >> 2]
    out[di + 1] = lut[(v & 3) << 4]
    if pad {
      out[di + 2] = b'='
      out[di + 3] = b'='
    }
  } else if rem == 2 {
    let v = (data[si].to_int() << 8) | data[si + 1].to_int()
    out[di] = lut[v >> 10]
    out[di + 1] = lut[(v >> 4) & 63]
    out[di + 2] = lut[(v & 15) << 2]
    if pad {
      out[di + 3] = b'='
    }
  }
  out.to_string()
}

///| Standard Base64 with `=` padding (RFC 4648 §4).
pub fn encode(data : Bytes) -> String {
  encode_with(data, b64_std_enc, true)
}

///| Standard Base64 without padding.
pub fn encode_no_pad(data : Bytes) -> String {
  encode_with(data, b64_std_enc, false)
}

///| Base64URL with `=` padding (RFC 4648 §5).
pub fn url_encode(data : Bytes) -> String {
  encode_with(data, b64_url_enc, true)
}

///| Base64URL without padding (the JWT / JOSE form).
pub fn url_encode_no_pad(data : Bytes) -> String {
  encode_with(data, b64_url_enc, false)
}

///| Names the first byte in `input[start, start + count)` that `lut` rejects.
fn bad_symbol(
  input : Bytes,
  start : Int,
  count : Int,
  lut : FixedArray[Int],
) -> Base64Error {
  let mut i = start
  let end = start + count
  while i < end {
    let c = input[i].to_int()
    if lut[c] < 0 {
      return if c == 61 {
        Base64Error::InvalidPadding(i)
      } else {
        Base64Error::InvalidByte(i, c)
      }
    }
    i = i + 1
  }
  Base64Error::InvalidByte(start, input[start].to_int())
}

///| A length error is reported only when every byte is in the alphabet
///| (or `=`); otherwise the first foreign byte is the more useful diagnosis.
fn length_error(input : Bytes, lut : FixedArray[Int]) -> Base64Error {
  let n = input.length()
  let mut i = 0
  while i < n {
    let c = input[i].to_int()
    if lut[c] < 0 && c != 61 {
      return Base64Error::InvalidByte(i, c)
    }
    i = i + 1
  }
  Base64Error::InvalidLength(n)
}

///|
fn decode_strict(
  input : Bytes,
  lut : FixedArray[Int],
  padded : Bool,
) -> Result[Bytes, Base64Error] {
  let n = input.length()
  let mut len = n
  if padded {
    if (n & 3) != 0 {
      return Err(length_error(input, lut))
    }
    if n > 0 && input[n - 1].to_int() == 61 {
      len = if input[n - 2].to_int() == 61 { n - 2 } else { n - 1 }
    }
  }
  let rem = len & 3
  let out_len = b64_decoded_len(len)
  if out_len < 0 {
    return Err(length_error(input, lut))
  }
  let full = len >> 2
  let out = Bytes::new(out_len)
  let limit = full << 2
  let mut si = 0
  let mut di = 0
  while si < limit {
    let v = b64_pack4_sextets(
      lut[input[si].to_int()],
      lut[input[si + 1].to_int()],
      lut[input[si + 2].to_int()],
      lut[input[si + 3].to_int()],
    )
    if v < 0 {
      return Err(bad_symbol(input, si, 4, lut))
    }
    out[di] = (v >> 16).to_byte()
    out[di + 1] = (v >> 8).to_byte()
    out[di + 2] = v.to_byte()
    si = si + 4
    di = di + 3
  }
  if rem == 2 {
    let v0 = lut[input[si].to_int()]
    let v1 = lut[input[si + 1].to_int()]
    if (v0 | v1) < 0 {
      return Err(bad_symbol(input, si, 2, lut))
    }
    if (v1 & b64_tail_canonical_mask(2)) != 0 {
      return Err(Base64Error::NonCanonical(si + 1))
    }
    out[di] = ((v0 << 2) | (v1 >> 4)).to_byte()
  } else if rem == 3 {
    let v0 = lut[input[si].to_int()]
    let v1 = lut[input[si + 1].to_int()]
    let v2 = lut[input[si + 2].to_int()]
    if (v0 | v1 | v2) < 0 {
      return Err(bad_symbol(input, si, 3, lut))
    }
    if (v2 & b64_tail_canonical_mask(3)) != 0 {
      return Err(Base64Error::NonCanonical(si + 2))
    }
    let v = (v0 << 12) | (v1 << 6) | v2
    out[di] = (v >> 10).to_byte()
    out[di + 1] = (v >> 2).to_byte()
  }
  Ok(out)
}

///| Strict standard Base64: `=` padding required, §4 alphabet only, no
///| whitespace, canonical trailing bits.
pub fn decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  decode_strict(input, b64_std_dec, true)
}

///| `decode_bytes` over a `String`.
pub fn decode(s : String) -> Result[Bytes, Base64Error] {
  decode_strict(s.to_bytes(), b64_std_dec, true)
}

///| Strict standard Base64 that refuses any `=`.
pub fn decode_no_pad_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  decode_strict(input, b64_std_dec, false)
}

///| `decode_no_pad_bytes` over a `String`.
pub fn decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  decode_strict(s.to_bytes(), b64_std_dec, false)
}

///| Strict Base64URL: `=` padding required, §5 alphabet only.
pub fn url_decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  decode_strict(input, b64_url_dec, true)
}

///| `url_decode_bytes` over a `String`.
pub fn url_decode(s : String) -> Result[Bytes, Base64Error] {
  decode_strict(s.to_bytes(), b64_url_dec, true)
}

///| Strict Base64URL that refuses any `=` (the JWT / JOSE form).
pub fn url_decode_no_pad_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  decode_strict(input, b64_url_dec, false)
}

///| `url_decode_no_pad_bytes` over a `String`.
pub fn url_decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  decode_strict(s.to_bytes(), b64_url_dec, false)
}

///| Lenient Base64 for human- or MIME-produced text: skips ASCII whitespace
///| (space, TAB, LF, VT, FF, CR) anywhere, accepts both the §4 and §5
///| alphabets (even mixed), makes padding optional (but if present it must
///| be exactly the right amount and only at the end), and discards
///| non-zero trailing bits. Still refuses other bytes and `len % 4 == 1`.
pub fn decode_loose_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let lut = b64_loose_dec
  let n = input.length()
  let mut digits = 0
  let mut pads = 0
  let mut first_pad = -1
  let mut i = 0
  while i < n {
    let c = input[i].to_int()
    let v = lut[c]
    if v >= 0 {
      if pads > 0 {
        return Err(Base64Error::InvalidPadding(first_pad))
      }
      digits = digits + 1
    } else if v == -3 {
      if pads == 0 {
        first_pad = i
      }
      pads = pads + 1
    } else if v == -1 {
      return Err(Base64Error::InvalidByte(i, c))
    }
    i = i + 1
  }
  let rest = digits & 3
  let out_len = b64_decoded_len(digits)
  if out_len < 0 {
    return Err(Base64Error::InvalidLength(digits))
  }
  if pads != 0 && pads != b64_expected_pad(rest) {
    return Err(Base64Error::InvalidPadding(first_pad))
  }
  let out = Bytes::new(out_len)
  let mut acc = 0
  let mut cnt = 0
  let mut di = 0
  i = 0
  while i < n {
    let v = lut[input[i].to_int()]
    if v >= 0 {
      acc = (acc << 6) | v
      cnt = cnt + 1
      if cnt == 4 {
        out[di] = (acc >> 16).to_byte()
        out[di + 1] = (acc >> 8).to_byte()
        out[di + 2] = acc.to_byte()
        di = di + 3
        acc = 0
        cnt = 0
      }
    }
    i = i + 1
  }
  if cnt == 2 {
    out[di] = (acc >> 4).to_byte()
  } else if cnt == 3 {
    out[di] = (acc >> 10).to_byte()
    out[di + 1] = (acc >> 2).to_byte()
  }
  Ok(out)
}

///| `decode_loose_bytes` over a `String`.
pub fn decode_loose(s : String) -> Result[Bytes, Base64Error] {
  decode_loose_bytes(s.to_bytes())
}
