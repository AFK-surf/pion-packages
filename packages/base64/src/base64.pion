///| RFC 4648 §4 Base64 and §5 Base64URL (stubs).

///|
pub fn encode(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn encode_no_pad(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn url_encode(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn url_encode_no_pad(data : Bytes) -> String {
  let _ = data
  ""
}

///|
pub fn decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn decode(s : String) -> Result[Bytes, Base64Error] {
  decode_bytes(s.to_bytes())
}

///|
pub fn decode_no_pad_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  decode_no_pad_bytes(s.to_bytes())
}

///|
pub fn url_decode_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn url_decode(s : String) -> Result[Bytes, Base64Error] {
  url_decode_bytes(s.to_bytes())
}

///|
pub fn url_decode_no_pad_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn url_decode_no_pad(s : String) -> Result[Bytes, Base64Error] {
  url_decode_no_pad_bytes(s.to_bytes())
}

///|
pub fn decode_loose_bytes(input : Bytes) -> Result[Bytes, Base64Error] {
  let _ = input
  Err(Base64Error::InvalidLength(-1))
}

///|
pub fn decode_loose(s : String) -> Result[Bytes, Base64Error] {
  decode_loose_bytes(s.to_bytes())
}
