///| RFC 4648 §6/§7/§10 Base32 and Base32hex vectors, Go `encoding/base32`
///| pairs, strictness (non-canonical trailing bits, padding, alphabet)
///| and large round trips.

///|
test "rfc4648_section10_base32_vectors" {
  let plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  let std = ["", "MY======", "MZXQ====", "MZXW6===", "MZXW6YQ=", "MZXW6YTB", "MZXW6YTBOI======"]
  let std_raw = ["", "MY", "MZXQ", "MZXW6", "MZXW6YQ", "MZXW6YTB", "MZXW6YTBOI"]
  let hex = ["", "CO======", "CPNG====", "CPNMU===", "CPNMUOG=", "CPNMUOJ1", "CPNMUOJ1E8======"]
  let hex_raw = ["", "CO", "CPNG", "CPNMU", "CPNMUOG", "CPNMUOJ1", "CPNMUOJ1E8"]
  let mut i = 0
  while i < plain.length() {
    let p = plain[i]
    let tag = "vector '" + p + "'"
    debug_assert(base32_encode(p.to_bytes()) == std[i], tag + " base32_encode")
    debug_assert(base32_encode_no_pad(p.to_bytes()) == std_raw[i], tag + " base32_encode_no_pad")
    debug_assert(base32_hex_encode(p.to_bytes()) == hex[i], tag + " base32_hex_encode")
    debug_assert(
      base32_hex_encode_no_pad(p.to_bytes()) == hex_raw[i],
      tag + " base32_hex_encode_no_pad",
    )
    expect_ok_str(base32_decode(std[i]), p, tag + " base32_decode")
    expect_ok_str(base32_decode_bytes(std[i].to_bytes()), p, tag + " base32_decode_bytes")
    expect_ok_str(base32_decode_no_pad(std_raw[i]), p, tag + " base32_decode_no_pad")
    expect_ok_str(base32_hex_decode(hex[i]), p, tag + " base32_hex_decode")
    expect_ok_str(base32_hex_decode_no_pad(hex_raw[i]), p, tag + " base32_hex_decode_no_pad")
    i = i + 1
  }
}

///|
test "go_encoding_base32_pairs" {
  let plain = ["sure.", "sure", "sur", "su", "leasure.", "easure.", "asure."]
  let enc = ["ON2XEZJO", "ON2XEZI=", "ON2XE===", "ON2Q====", "NRSWC43VOJSS4===", "MVQXG5LSMUXA====", "MFZXK4TFFY======"]
  let mut i = 0
  while i < plain.length() {
    debug_assert(base32_encode(plain[i].to_bytes()) == enc[i], "wiki encode " + plain[i])
    expect_ok_str(base32_decode(enc[i]), plain[i], "wiki decode " + plain[i])
    i = i + 1
  }
  debug_assert(
    base32_encode("Twas brillig, and the slithy toves".to_bytes()) ==
    "KR3WC4ZAMJZGS3DMNFTSYIDBNZSCA5DIMUQHG3DJORUHSIDUN53GK4Y=",
    "bigtest",
  )
}

///|
test "base32_alphabets_and_all_byte_values" {
  let ones = bs([0xFF, 0xFF, 0xFF, 0xFF, 0xFF])
  debug_assert(base32_encode(ones) == "77777777", "std max symbol")
  debug_assert(base32_hex_encode(ones) == "VVVVVVVV", "hex max symbol")
  let all = all_bytes()
  let e = base32_encode(all)
  let h = base32_hex_encode(all)
  debug_assert(e.length() == 416, "256 bytes -> 416 chars")
  debug_assert(e.slice(0, 16) == "AAAQEAYEAUDAOCAJ", "std prefix")
  debug_assert(e.slice(400, 416) == "7L57Z7P674======", "std suffix")
  debug_assert(h.slice(0, 16) == "000G40O40K30E209", "hex prefix")
  debug_assert(h.slice(400, 416) == "VBTVPVFUVS======", "hex suffix")
  expect_ok(base32_decode(e), all, "all bytes std")
  expect_ok(base32_hex_decode(h), all, "all bytes hex")
  expect_ok(base32_decode_no_pad(base32_encode_no_pad(all)), all, "all bytes std raw")
  expect_ok(base32_hex_decode_no_pad(base32_hex_encode_no_pad(all)), all, "all bytes hex raw")
  let mut n = 0
  while n <= 64 {
    let p = pattern(n, 0x4321 + n)
    let tag = "len " + n.to_string()
    expect_ok(base32_decode(base32_encode(p)), p, tag + " std")
    expect_ok(base32_decode_no_pad(base32_encode_no_pad(p)), p, tag + " std raw")
    expect_ok(base32_hex_decode(base32_hex_encode(p)), p, tag + " hex")
    expect_ok(base32_hex_decode_no_pad(base32_hex_encode_no_pad(p)), p, tag + " hex raw")
    debug_assert(base32_encode(p).length() == (n + 4) / 5 * 8, tag + " padded length")
    debug_assert(base32_encode_no_pad(p).length() == (n * 8 + 4) / 5, tag + " raw length")
    n = n + 1
  }
}

///|
test "base32_strict_rejects_non_canonical_trailing_bits" {
  // 2-symbol tail: 10 bits carry 8, low 2 must be zero.
  expect_ok_str(base32_decode("MY======"), "f", "MY ok")
  expect_err(base32_decode("MZ======"), 4, "MZ")
  expect_err(base32_decode("M7======"), 4, "M7")
  expect_err(base32_decode_no_pad("MZ"), 4, "MZ raw")
  expect_err(base32_hex_decode("CP======"), 4, "hex CP")
  // 4-symbol tail: 20 bits carry 16, low 4 must be zero.
  expect_ok_str(base32_decode("MZXQ===="), "fo", "MZXQ ok")
  expect_err(base32_decode("MZXR===="), 4, "MZXR")
  expect_err(base32_decode_no_pad("MZXR"), 4, "MZXR raw")
  // 5-symbol tail: 25 bits carry 24, low 1 must be zero.
  expect_ok_str(base32_decode("MZXW6==="), "foo", "MZXW6 ok")
  expect_err(base32_decode("MZXW7==="), 4, "MZXW7")
  expect_err(base32_hex_decode("CPNMV==="), 4, "hex CPNMV")
  // 7-symbol tail: 35 bits carry 32, low 3 must be zero.
  expect_ok_str(base32_decode("MZXW6YQ="), "foob", "MZXW6YQ ok")
  expect_err(base32_decode("MZXW6YR="), 4, "MZXW6YR")
  expect_err(base32_decode("MZXW6Y7="), 4, "MZXW6Y7")
  expect_err(base32_decode_no_pad("MZXW6YR"), 4, "MZXW6YR raw")
  match base32_decode("MZXW6YTBMZ======") {
    Err(Base64Error::NonCanonical(off)) => debug_assert(off == 9, "offset after full block")
    _ => debug_assert(false, "expected NonCanonical")
  }
}

///|
test "base32_strict_rejects_bad_length_padding_and_alphabet" {
  // Tails of 1, 3 or 6 symbols can never be produced.
  expect_err(base32_decode("M======="), 3, "1-symbol tail padded")
  expect_err(base32_decode("MZX====="), 3, "3-symbol tail padded")
  expect_err(base32_decode("MZXW6Y=="), 3, "6-symbol tail padded")
  expect_err(base32_decode_no_pad("M"), 1, "1-symbol raw")
  expect_err(base32_decode_no_pad("MZX"), 1, "3-symbol raw")
  expect_err(base32_decode_no_pad("MZXW6Y"), 1, "6-symbol raw")
  expect_err(base32_decode_no_pad("MZXW6YTBM"), 1, "9-symbol raw")
  // Padded decoding needs whole 8-symbol groups.
  expect_err(base32_decode("MY"), 1, "padded missing pads")
  expect_err(base32_decode("MY====="), 1, "padded short by one")
  expect_err(base32_decode("MY======="), 1, "padded long by one")
  expect_err(base32_decode("========"), 3, "only padding")
  expect_err(base32_decode("MY======MY======"), 3, "padding in the middle")
  expect_err(base32_decode("M=Y====="), 3, "pad inside tail")
  expect_err(base32_decode_no_pad("MY======"), 3, "raw with padding")
  // Alphabet.
  expect_invalid_byte(base32_decode("my======"), 0, 109, "lowercase rejected")
  expect_invalid_byte(base32_decode("M0======"), 1, 48, "std rejects 0")
  expect_invalid_byte(base32_decode("M1======"), 1, 49, "std rejects 1")
  expect_invalid_byte(base32_decode("MZXW6YT8"), 7, 56, "std rejects 8")
  expect_invalid_byte(base32_hex_decode("CW======"), 1, 87, "hex rejects W")
  expect_invalid_byte(base32_hex_decode("co======"), 0, 99, "hex rejects lowercase")
  expect_invalid_byte(base32_decode("MZXW 6==="), 4, 32, "inner space")
  expect_invalid_byte(base32_decode("MZXW6YTB\n"), 8, 10, "trailing newline")
  expect_invalid_byte(base32_decode("Mé====="), 1, 0xC3, "non-ASCII")
}

///|
fn base32_large_round_trip(n : Int, seed : Int) -> Unit {
  let p = pattern(n, seed)
  let tag = "large " + n.to_string()
  let e = base32_encode(p)
  debug_assert(e.length() == (n + 4) / 5 * 8, tag + " length")
  expect_ok(base32_decode(e), p, tag + " std")
  expect_ok(base32_decode_no_pad(base32_encode_no_pad(p)), p, tag + " std raw")
  expect_ok(base32_hex_decode(base32_hex_encode(p)), p, tag + " hex")
}

///|
test "base32_large_round_trip_64k" {
  base32_large_round_trip(65536, 0x13198A2E)
  base32_large_round_trip(65539, 0x03707344)
}

///|
test "base32_large_round_trip_1m" {
  base32_large_round_trip(1048576, 0x243F6A88)
}
