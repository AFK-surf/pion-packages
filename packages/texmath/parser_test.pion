///| Parser tests ported from KaTeX `test/katex-spec.ts` and `test/screenshotter/ss_data.yaml`.

///|
fn assert_parse_ok(tex : String, display : Bool, label : String) -> Array[MathNode] {
  let opts = if display { ParseOptions::display() } else { ParseOptions::default() }
  match parse(tex, opts) {
    Ok(nodes) => nodes
    Err(e) => {
      debug_assert(false, label + " failed: " + e.to_string())
      Array::new()
    }
  }
}

///| 1. Empty & whitespace
test "parser: empty string" {
  let nodes = assert_parse_ok("", false, "empty")
  debug_assert(nodes.length() == 0, "empty length 0")
}

///| 2. Whitespace only
test "parser: whitespace only" {
  let nodes = assert_parse_ok("   \t\n  ", false, "ws")
  debug_assert(nodes.length() == 0, "ws length 0")
}

///| 3. Comments stripped
test "parser: comment stripping" {
  let nodes = assert_parse_ok("a % comment here\n+ b", false, "comment")
  debug_assert(nodes.length() == 3, "a + b has 3 nodes")
}

///| 4. Single variable atom
test "parser: single mathord" {
  let nodes = assert_parse_ok("x", false, "x")
  debug_assert(nodes.length() == 1, "len 1")
  match nodes[0] {
    Ord(t, _) => debug_assert(t == "x", "ord x")
    _ => debug_assert(false, "expected Ord")
  }
}

///| 5. Digits and arithmetic
test "parser: arithmetic expression" {
  let nodes = assert_parse_ok("1 + 2 - 3 = 0", false, "arith")
  debug_assert(nodes.length() == 7, "7 tokens")
  match nodes[1] {
    Bin(t) => debug_assert(t == "+", "bin +")
    _ => debug_assert(false, "expected Bin")
  }
  match nodes[5] {
    Rel(t) => debug_assert(t == "=", "rel =")
    _ => debug_assert(false, "expected Rel")
  }
}

///| 6. Lowercase Greek letters
test "parser: lowercase greek letters" {
  let nodes = assert_parse_ok("\\alpha\\beta\\gamma\\delta\\epsilon\\varepsilon\\zeta\\eta\\theta\\vartheta\\iota\\kappa\\lambda\\mu\\nu\\xi\\pi\\varpi\\rho\\varrho\\sigma\\varsigma\\tau\\upsilon\\phi\\varphi\\chi\\psi\\omega", false, "greek lower")
  debug_assert(nodes.length() == 29, "29 lowercase greek")
}

///| 7. Uppercase Greek letters
test "parser: uppercase greek letters" {
  let nodes = assert_parse_ok("\\Gamma\\Delta\\Theta\\Lambda\\Xi\\Pi\\Sigma\\Upsilon\\Phi\\Psi\\Omega", false, "greek upper")
  debug_assert(nodes.length() == 11, "11 uppercase greek")
}

///| 8. Binary operators
test "parser: binary operators" {
  let nodes = assert_parse_ok("a \\pm b \\mp c \\times d \\div e \\cdot f \\ast g \\star h \\circ i \\bullet j \\cup k \\cap l \\vee m \\wedge n \\oplus o \\otimes p", false, "binops")
  debug_assert(nodes.length() == 31, "31 nodes")
}

///| 9. Relations
test "parser: relation symbols" {
  let nodes = assert_parse_ok("a < b > c \\le d \\ge e \\leq f \\geq g \\neq h \\approx i \\equiv j \\sim k \\simeq l \\cong m \\propto n \\in o \\notin p \\subset q \\subseteq r \\supset s \\supseteq t \\perp u \\parallel v \\mid w", false, "rels")
  debug_assert(nodes.length() == 45, "45 nodes")
}

///| 10. Arrows
test "parser: arrow symbols" {
  let nodes = assert_parse_ok("\\leftarrow \\rightarrow \\leftrightarrow \\Leftarrow \\Rightarrow \\Leftrightarrow \\mapsto \\to \\gets \\iff \\implies \\impliedby \\uparrow \\downarrow \\updownarrow \\nearrow \\searrow \\swarrow \\nwarrow", false, "arrows")
  debug_assert(nodes.length() >= 19, "arrows parsed")
}

///| 11. Delimiter atoms & punctuation
test "parser: open close punct" {
  let nodes = assert_parse_ok("(a, b; c) [d] \\{e\\}", false, "delims")
  match nodes[0] {
    Open(t) => debug_assert(t == "(", "open (")
    _ => debug_assert(false, "expected Open")
  }
  match nodes[2] {
    Punct(t) => debug_assert(t == ",", "punct ,")
    _ => debug_assert(false, "expected Punct")
  }
}

///| 12. Braced groups
test "parser: braced groups" {
  let nodes = assert_parse_ok("{a + b} {c}", false, "groups")
  debug_assert(nodes.length() == 2, "2 groups")
  match nodes[0] {
    Group(body, is_ord) => {
      debug_assert(is_ord, "is_ordgroup")
      debug_assert(body.length() == 3, "a + b")
    }
    _ => debug_assert(false, "expected Group")
  }
}

///| 13. Nested groups
test "parser: nested groups" {
  let nodes = assert_parse_ok("{{{x}}}", false, "nested")
  debug_assert(nodes.length() == 1, "single outer group")
}

///| 14. Superscript
test "parser: superscript" {
  let nodes = assert_parse_ok("x^2", false, "sup")
  debug_assert(nodes.length() == 1, "1 supsub")
  match nodes[0] {
    SupSub(Some(_), None, Some(_)) => ()
    _ => debug_assert(false, "expected SupSub with sup")
  }
}

///| 15. Subscript
test "parser: subscript" {
  let nodes = assert_parse_ok("x_i", false, "sub")
  debug_assert(nodes.length() == 1, "1 supsub")
  match nodes[0] {
    SupSub(Some(_), Some(_), None) => ()
    _ => debug_assert(false, "expected SupSub with sub")
  }
}

///| 16. Both sub and sup in either order
test "parser: sub and sup both orders" {
  let n1 = assert_parse_ok("x_i^n", false, "sub_sup")
  let n2 = assert_parse_ok("x^n_i", false, "sup_sub")
  match n1[0] {
    SupSub(Some(_), Some(_), Some(_)) => ()
    _ => debug_assert(false, "expected sub+sup 1")
  }
  match n2[0] {
    SupSub(Some(_), Some(_), Some(_)) => ()
    _ => debug_assert(false, "expected sub+sup 2")
  }
}

///| 17. Nested exponents (ss_data Exponents)
test "parser: nested exponents" {
  let nodes = assert_parse_ok("a^{a^a_a}_{a^a_a}", false, "nested exp")
  debug_assert(nodes.length() == 1, "1 root supsub")
}

///| 18. Primes and double primes
test "parser: primes" {
  let n1 = assert_parse_ok("f'(x)", false, "prime")
  let n2 = assert_parse_ok("f''(x) + f'''_0", false, "multi prime")
  debug_assert(n1.length() == 4, "f' ( x )")
  debug_assert(n2.length() == 6, "multi prime len")
}

///| 19. Empty base supsub
test "parser: empty base scripts" {
  let nodes = assert_parse_ok("^2 + _i + ^a_b", false, "empty base")
  debug_assert(nodes.length() == 3, "3 atoms (^2, +_i, +^a_b)")
  let nodes2 = assert_parse_ok("{^2} + {_i} + {^a_b}", false, "braced empty base")
  debug_assert(nodes2.length() == 5, "5 nodes")
}

///| 20. \frac basic and shorthand digits
test "parser: frac and shorthand" {
  let n1 = assert_parse_ok("\\frac{a}{b}", false, "frac")
  let n2 = assert_parse_ok("\\frac12", false, "frac12")
  match n1[0] {
    Frac(_, _, has_bar, _, _, _, _, _) => debug_assert(has_bar, "has bar")
    _ => debug_assert(false, "expected Frac")
  }
  match n2[0] {
    Frac(_, _, has_bar, _, _, _, _, _) => debug_assert(has_bar, "frac12 has bar")
    _ => debug_assert(false, "expected Frac 12")
  }
}

///| 21. \dfrac, \tfrac, \cfrac
test "parser: dfrac tfrac cfrac" {
  let _ = assert_parse_ok("\\dfrac{a}{b} + \\tfrac{c}{d} + \\cfrac{1}{1+\\cfrac{1}{x}}", false, "dfrac tfrac cfrac")
}

///| 22. \binom, \dbinom, \tbinom
test "parser: binom variants" {
  let n = assert_parse_ok("\\binom{n}{k}", false, "binom")
  match n[0] {
    Frac(_, _, has_bar, ld, rd, _, _, _) => {
      debug_assert(!has_bar, "binom no bar")
      debug_assert(ld == "(", "binom left (")
      debug_assert(rd == ")", "binom right )")
    }
    _ => debug_assert(false, "expected binom Frac")
  }
  let _ = assert_parse_ok("\\dbinom{a}{b} + \\tbinom{a}{b}", false, "dbinom tbinom")
}

///| 23. Infix \over, \choose, \atop, \brace, \brack
test "parser: infix fractions" {
  let _ = assert_parse_ok("{a + 1 \\over b + 2}", false, "over")
  let _ = assert_parse_ok("{n \\choose k}", false, "choose")
  let _ = assert_parse_ok("{a \\atop b}", false, "atop")
  let _ = assert_parse_ok("{a \\brace b}", false, "brace")
  let _ = assert_parse_ok("{a \\brack b}", false, "brack")
}

///| 24. \genfrac
test "parser: genfrac" {
  let n = assert_parse_ok("\\genfrac{[}{]}{0.8pt}{0}{a}{b}", false, "genfrac")
  debug_assert(n.length() == 1, "genfrac 1 node")
}

///| 25. \sqrt and \sqrt[n]
test "parser: sqrt and nth root" {
  let n1 = assert_parse_ok("\\sqrt{x}", false, "sqrt")
  match n1[0] {
    Sqrt(_, None) => ()
    _ => debug_assert(false, "expected Sqrt without index")
  }
  let n2 = assert_parse_ok("\\sqrt[3]{x^2 + 1}", false, "cbrt")
  match n2[0] {
    Sqrt(_, Some(_)) => ()
    _ => debug_assert(false, "expected Sqrt with index")
  }
  let _ = assert_parse_ok("\\sqrt2 + \\sqrt{\\sqrt{x}}", false, "nested sqrt")
}

///| 26. Big symbol operators
test "parser: big operators" {
  let _ = assert_parse_ok("\\sum_{i=1}^n a_i + \\prod_{k=1}^m b_k + \\coprod_{j} c_j + \\bigcup_i A_i + \\bigcap_i B_i + \\bigoplus_k V_k + \\bigotimes_k W_k", true, "big ops")
}

///| 27. Integrals
test "parser: integrals" {
  let _ = assert_parse_ok("\\int_0^1 f(x)\\,dx + \\iint_D dA + \\iiint_V dV + \\oint_C F\\cdot dr", true, "integrals")
}

///| 28. Named operators & trig/log
test "parser: named operators" {
  let _ = assert_parse_ok("\\sin x + \\cos y + \\tan z + \\ln x + \\log_2 n + \\exp(x) + \\det A + \\gcd(a,b) + \\lim_{x\\to 0} f(x) + \\limsup_n a_n + \\liminf_n b_n + \\sup_x g(x) + \\inf_x h(x) + \\max_i x_i + \\min_i y_i", false, "named ops")
}

///| 29. \limits and \nolimits
test "parser: limits and nolimits" {
  let _ = assert_parse_ok("\\int\\limits_a^b f(x)\\,dx + \\sum\\nolimits_{i=1}^n i", true, "limits controls")
}

///| 30. \operatorname and \operatorname*
test "parser: operatorname" {
  let _ = assert_parse_ok("\\operatorname{Tr}(A) + \\operatorname*{arg\\,max}_{x} f(x)", true, "operatorname")
}

///| 31. \left ... \right
test "parser: left right delimiters" {
  let n = assert_parse_ok("\\left( \\frac{a}{b} \\right)", false, "leftright")
  debug_assert(n.length() == 1, "1 delim")
  match n[0] {
    Delim(kind, left, _, _, right) => {
      debug_assert(kind == "leftright", "kind leftright")
      debug_assert(left == "(", "left (")
      debug_assert(right == ")", "right )")
    }
    _ => debug_assert(false, "expected Delim")
  }
}

///| 32. \left. and \right. empty delimiters and \middle
test "parser: left right dot and middle" {
  let _ = assert_parse_ok("\\left\\{ x \\middle| x < \\frac{1}{2} \\right.", false, "lr middle")
  let _ = assert_parse_ok("\\left. \\frac{df}{dx} \\right|_{x=0}", false, "lr dot")
}

///| 33. \big, \Big, \bigg, \Bigg variants
test "parser: sized delimiters" {
  let _ = assert_parse_ok("\\bigl( \\Bigl[ \\biggl\\{ \\Biggl\\langle x \\Biggr\\rangle \\biggr\\} \\Bigr] \\bigr)", false, "sized delims")
  let _ = assert_parse_ok("\\big| \\Big\\| \\bigg/ \\Bigg\\backslash", false, "bigm delims")
}

///| 34. Non-stretchy math accents
test "parser: math accents" {
  let _ = assert_parse_ok("\\hat{x} + \\check{x} + \\tilde{x} + \\acute{x} + \\grave{x} + \\dot{x} + \\ddot{x} + \\breve{x} + \\bar{x} + \\vec{x} + \\mathring{x}", false, "accents")
}

///| 35. Stretchy accents
test "parser: stretchy accents" {
  let _ = assert_parse_ok("\\widehat{abc} + \\widetilde{xyz} + \\overrightarrow{AB} + \\overleftarrow{CD} + \\overleftrightarrow{EF}", false, "stretchy accents")
}

///| 36. \overline and \underline
test "parser: overline and underline" {
  let n = assert_parse_ok("\\overline{x+y} + \\underline{a+b}", false, "over underline")
  debug_assert(n.length() == 3, "3 nodes")
}

///| 37. \overbrace, \underbrace, \overset, \underset
test "parser: overbrace underbrace overset underset" {
  let _ = assert_parse_ok("\\overbrace{a+b+c}^{3} + \\underbrace{x+y}_{2} + \\overset{?}{=} + \\underset{n\\to\\infty}{\\lim}", false, "over under")
}

///| 38. matrix environment
test "parser: matrix" {
  let n = assert_parse_ok("\\begin{matrix} 1 & 2 \\\\ 3 & 4 \\end{matrix}", false, "matrix")
  debug_assert(n.length() == 1, "1 matrix")
  match n[0] {
    Matrix(env, rows, _, _, _, _) => {
      debug_assert(env == "matrix", "env matrix")
      debug_assert(rows.length() == 2, "2 rows")
      debug_assert(rows[0].length() == 2, "2 cols")
    }
    _ => debug_assert(false, "expected Matrix")
  }
}

///| 39. pmatrix, bmatrix, Bmatrix, vmatrix, Vmatrix, smallmatrix
test "parser: matrix variants" {
  let _ = assert_parse_ok("\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}", false, "pmatrix")
  let _ = assert_parse_ok("\\begin{bmatrix} 1 & 0 \\\\ 0 & 1 \\end{bmatrix}", false, "bmatrix")
  let _ = assert_parse_ok("\\begin{Bmatrix} x \\\\ y \\end{Bmatrix}", false, "Bmatrix")
  let _ = assert_parse_ok("\\begin{vmatrix} a & b \\\\ c & d \\end{vmatrix}", false, "vmatrix")
  let _ = assert_parse_ok("\\begin{Vmatrix} u \\\\ v \\end{Vmatrix}", false, "Vmatrix")
  let _ = assert_parse_ok("\\begin{smallmatrix} a & b \\\\ c & d \\end{smallmatrix}", false, "smallmatrix")
}

///| 40. cases and rcases
test "parser: cases and rcases" {
  let _ = assert_parse_ok("f(x) = \\begin{cases} x^2 & \\text{if } x \\ge 0 \\\\ -x^2 & \\text{otherwise} \\end{cases}", false, "cases")
  let _ = assert_parse_ok("\\begin{rcases} a & b \\\\ c & d \\end{rcases}", false, "rcases")
}

///| 41. aligned, align, align*, gathered, gather, split
test "parser: alignment environments" {
  let _ = assert_parse_ok("\\begin{aligned} a &= 1 \\\\ b &= 2 \\end{aligned}", false, "aligned")
  let _ = assert_parse_ok("\\begin{align} x &= y + z \\\\ u &= v \\end{align}", true, "align")
  let _ = assert_parse_ok("\\begin{align*} x &= 1 \\\\ y &= 2 \\end{align*}", true, "align*")
  let _ = assert_parse_ok("\\begin{gathered} a = 1 \\\\ b = 2 \\end{gathered}", false, "gathered")
  let _ = assert_parse_ok("\\begin{gather} a = 1 \\\\ b = 2 \\end{gather}", true, "gather")
  let _ = assert_parse_ok("\\begin{split} a &= b + c \\\\ &= d \\end{split}", true, "split")
}

///| 42. array environment with column specs and hline
test "parser: array environment" {
  let _ = assert_parse_ok("\\begin{array}{|l|c|r|} \\hline 1 & 2 & 3 \\\\ \\hline 4 & 5 & 6 \\\\ \\hline \\end{array}", false, "array")
}

///| 43. Matrix trailing empty row removal (ss_data ArrayRemoveEmptyLine)
test "parser: matrix trailing newline removed" {
  let n = assert_parse_ok("\\begin{pmatrix} 1 \\\\ 2 \\\\ \\end{pmatrix}", false, "trailing cr")
  match n[0] {
    Matrix(_, rows, _, _, _, _) => debug_assert(rows.length() == 2, "trailing empty row stripped")
    _ => debug_assert(false, "expected Matrix")
  }
}

///| 44. Math fonts
test "parser: math fonts" {
  let _ = assert_parse_ok("\\mathrm{d}x + \\mathbf{v} + \\mathit{f} + \\mathbb{R} + \\mathcal{L} + \\mathfrak{g} + \\mathscr{F} + \\mathsf{T} + \\mathtt{x} + \\boldsymbol{\\alpha} + \\bm{\\beta}", false, "math fonts")
}

///| 45. Legacy font switches
test "parser: legacy font switches" {
  let _ = assert_parse_ok("{\\rm abc} + {\\bf def} + {\\it ghi} + {\\sf jkl} + {\\tt mno} + {\\cal PQR}", false, "legacy fonts")
}

///| 46. Text mode commands
test "parser: text mode" {
  let _ = assert_parse_ok("\\text{hello world} + \\textrm{rm} + \\textbf{bf} + \\textit{it} + \\textsf{sf} + \\texttt{tt}", false, "text mode")
}

///| 47. Nested math inside text mode
test "parser: math inside text" {
  let _ = assert_parse_ok("\\text{for all $x > 0$ we have $x^2 > 0$}", false, "math in text")
}

///| 48. Colors
test "parser: color and textcolor" {
  let _ = assert_parse_ok("\\textcolor{red}{x+1} + \\textcolor{#00ff00}{y} + {\\color{blue} z + 2}", false, "colors")
}

///| 49. Spacing commands
test "parser: spacing commands" {
  let _ = assert_parse_ok("a\\,b\\:c\\;d\\!e\\ f~g\\quad h\\qquad i\\enspace j\\thinspace k\\medspace l\\thickspace m", false, "spacing")
}

///| 50. \kern, \mkern, \hspace
test "parser: kern mkern hspace" {
  let _ = assert_parse_ok("a\\kern1em b\\kern{0.5em}c\\mkern3mu d\\hspace{10pt}e", false, "kern")
}

///| 51. \phantom, \hphantom, \vphantom
test "parser: phantom variants" {
  let _ = assert_parse_ok("\\phantom{x+y} + \\hphantom{abc} + \\vphantom{\\frac{1}{2}}", false, "phantom")
}

///| 52. \rule
test "parser: rule" {
  let _ = assert_parse_ok("\\rule{1em}{2em} + \\rule[-0.5em]{2em}{0.4pt}", false, "rule")
}

///| 53. Style switches
test "parser: style switches" {
  let _ = assert_parse_ok("{\\displaystyle \\sum_i x_i} + {\\textstyle \\frac{1}{2}} + {\\scriptstyle a} + {\\scriptscriptstyle b}", false, "styles")
}

///| 54. Sizing commands
test "parser: sizing commands" {
  let _ = assert_parse_ok("{\\tiny a}{\\scriptsize b}{\\footnotesize c}{\\small d}{\\normalsize e}{\\large f}{\\Large g}{\\LARGE h}{\\huge i}{\\Huge j}", false, "sizing")
}

///| 55. Math class overrides
test "parser: math class overrides" {
  let _ = assert_parse_ok("\\mathord{+} \\mathbin{x} \\mathrel{y} \\mathopen{z} \\mathclose{w} \\mathpunct{a} \\mathinner{b} \\mathop{c}", false, "mclass")
}

///| 56. \def macro expansion (0 args, 1 arg, 2 args)
test "parser: def macro expansion" {
  let _ = assert_parse_ok("\\def\\foo{x^2} \\foo + \\foo", false, "def 0")
  let _ = assert_parse_ok("\\def\\sq#1{#1^2} \\sq{a+b}", false, "def 1")
  let _ = assert_parse_ok("\\def\\myfrac#1#2{\\frac{#1}{#2}} \\myfrac{x}{y}", false, "def 2")
}

///| 57. \newcommand and \renewcommand
test "parser: newcommand" {
  let _ = assert_parse_ok("\\newcommand{\\R}{\\mathbb{R}} x \\in \\R", false, "newcommand 0")
  let _ = assert_parse_ok("\\newcommand{\\abs}[1]{\\left|#1\\right|} \\abs{x-y}", false, "newcommand 1")
}

///| 58. Macro scoping inside groups
test "parser: macro scoping" {
  let _ = assert_parse_ok("\\def\\x{1} {\\def\\x{2} \\x} + \\x", false, "macro scope")
}

///| 59. Built-in macros (\bmod, \pmod, \dots, \ldots, \cdots, \vdots, \ddots)
test "parser: builtin macros" {
  let _ = assert_parse_ok("a \\equiv b \\pmod{n} + c \\bmod d + 1, \\ldots, n + 1 + \\cdots + n", false, "builtin macros")
}

///| 60. \not negation
test "parser: not negation" {
  let _ = assert_parse_ok("a \\not= b + c \\not\\in S", false, "not")
}

///| 61. Quadratic formula
test "parser: quadratic formula" {
  let _ = assert_parse_ok("x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}", true, "quadratic")
}

///| 62. Maxwell equations
test "parser: maxwell equations" {
  let _ = assert_parse_ok("\\nabla \\cdot \\mathbf{E} = \\frac{\\rho}{\\varepsilon_0}, \\quad \\nabla \\times \\mathbf{B} = \\mu_0 \\mathbf{J} + \\mu_0 \\varepsilon_0 \\frac{\\partial \\mathbf{E}}{\\partial t}", true, "maxwell")
}

///| 63. Gaussian integral
test "parser: gaussian integral" {
  let _ = assert_parse_ok("\\int_{-\\infty}^{\\infty} e^{-x^2}\\,dx = \\sqrt{\\pi}", true, "gaussian")
}

///| 64. Schrodinger equation
test "parser: schrodinger equation" {
  let _ = assert_parse_ok("i\\hbar \\frac{\\partial}{\\partial t} \\Psi(\\mathbf{r}, t) = \\left[ -\\frac{\\hbar^2}{2m} \\nabla^2 + V(\\mathbf{r}, t) \\right] \\Psi(\\mathbf{r}, t)", true, "schrodinger")
}

///| 65. Attention mechanism formula
test "parser: transformer attention" {
  let _ = assert_parse_ok("\\operatorname{Attention}(Q, K, V) = \\operatorname{softmax}\\left(\\frac{QK^T}{\\sqrt{d_k}}\\right)V", true, "attention")
}
