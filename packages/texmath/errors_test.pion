///| Strict error-rejection tests ported from KaTeX `test/errors-spec.ts` and `test/katex-spec.ts`.

///|
fn assert_parse_err(tex : String, display : Bool, expected_substr : String, label : String) -> Unit {
  let opts = if display { ParseOptions::display() } else { ParseOptions::default() }
  match parse(tex, opts) {
    Ok(_) => debug_assert(false, label + ": expected Err containing '" + expected_substr + "', got Ok")
    Err(e) =>
    debug_assert(
      e.message.contains(expected_substr),
      label + ": expected '" + expected_substr + "' in '" + e.message + "'",
    )
  }
}

///| 1. Repeated infix \over
test "errors: repeated infix over" {
  assert_parse_err("1\\over 2\\over 3", false, "infix", "repeated over")
}

///| 2. Conflicting infix \over and \choose
test "errors: conflicting infix over choose" {
  assert_parse_err("1\\over 2\\choose 3", false, "infix", "conflicting infix")
}

///| 3. ^ at end of group
test "errors: caret at end of group" {
  assert_parse_err("{1^}", false, "Expected group", "caret end group")
}

///| 4. _ at end of input
test "errors: underscore at end of input" {
  assert_parse_err("1_", false, "Expected group", "underscore eof")
}

///| 5. \limits without operator
test "errors: limits without operator" {
  assert_parse_err("\\alpha\\limits\\omega", false, "Limit controls", "limits no op")
}

///| 6. \limits at start of input
test "errors: limits at start" {
  assert_parse_err("\\limits\\omega", false, "Limit controls", "limits start")
}

///| 7. Double superscript
test "errors: double superscript" {
  assert_parse_err("1^2^3", false, "Double superscript", "double sup 1")
  assert_parse_err("1^{2+3}_4^5", false, "Double superscript", "double sup 2")
}

///| 8. Double superscript with primes
test "errors: double superscript with primes" {
  assert_parse_err("1'_2^3", false, "Double superscript", "prime sup 1")
  assert_parse_err("1^2'", false, "Double superscript", "prime sup 2")
  assert_parse_err("1^2_3'", false, "Double superscript", "prime sup 3")
  assert_parse_err("1'_2'", false, "Double superscript", "prime sup 4")
}

///| 9. Double subscript
test "errors: double subscript" {
  assert_parse_err("1_2_3", false, "Double subscript", "double sub 1")
  assert_parse_err("1_{2+3}^4_5", false, "Double subscript", "double sub 2")
}

///| 10. Unknown environment
test "errors: unknown environment" {
  assert_parse_err("\\begin{foo}bar\\end{foo}", false, "No such environment", "unknown env")
}

///| 11. Mismatched environment
test "errors: mismatched environment" {
  assert_parse_err("\\begin{pmatrix}1&2\\\\3&4\\end{bmatrix}+5", false, "Mismatch", "mismatch env")
}

///| 12. Math-only function in text mode
test "errors: sqrt in text mode" {
  assert_parse_err("\\text{\\sqrt2 is irrational}", false, "text mode", "sqrt in text")
}

///| 13. Missing argument to \sqrt at EOF
test "errors: missing arg sqrt eof" {
  assert_parse_err("2\\sqrt", false, "Expected group", "sqrt eof")
}

///| 14. Missing argument to \sqrt at end of group
test "errors: missing arg sqrt end group" {
  assert_parse_err("1^{2\\sqrt}", false, "Expected group", "sqrt end group")
}

///| 15. Missing second argument to \frac
test "errors: missing second arg frac" {
  assert_parse_err("\\frac{1}", false, "Expected group", "frac 1 arg")
}

///| 16. Undefined control sequence
test "errors: undefined control sequence" {
  assert_parse_err("\\xyz", false, "Undefined control sequence", "undef cs")
}

///| 17. Extra closing brace }
test "errors: extra closing brace" {
  assert_parse_err("{1+2}}", false, "Expected 'EOF'", "extra }")
}

///| 18. Unclosed opening brace {
test "errors: unclosed brace" {
  assert_parse_err("\\sqrt{2", false, "Expected '}'", "unclosed {")
}

///| 19. Extra \end
test "errors: extra end" {
  assert_parse_err("x\\end{matrix}", false, "Expected 'EOF'", "extra end")
}

///| 20. Top-level &
test "errors: top level ampersand" {
  assert_parse_err("1&2", false, "Expected 'EOF'", "top level &")
}

///| 21. Missing \right
test "errors: missing right" {
  assert_parse_err("\\left(1+2)", false, "Expected '\\right'", "missing right")
}

///| 22. Incorrectly scoped \right
test "errors: misscoped right" {
  assert_parse_err("{\\left(1+2}\\right)", false, "Expected '\\right'", "misscoped right")
}

///| 23. Unmatched \right without \left
test "errors: stray right" {
  assert_parse_err("1+2\\right)", false, "Expected 'EOF'", "stray right")
}

///| 24. \middle outside \left...\right
test "errors: middle outside leftright" {
  assert_parse_err("a \\middle| b", false, "\\middle", "stray middle")
}

///| 25. Missing ] in optional argument
test "errors: unclosed optional arg" {
  assert_parse_err("\\sqrt[3", false, "]", "sqrt[3")
}

///| 26. Missing \end in matrix
test "errors: missing end in matrix" {
  assert_parse_err("\\begin{matrix}1", false, "\\end", "missing end")
}

///| 27. Unknown column alignment in array
test "errors: unknown array column alignment" {
  assert_parse_err("\\begin{array}{cba}\\end{array}", false, "column alignment", "bad col align")
}

///| 28. Invalid opening delimiter after \bigl
test "errors: invalid delimiter after bigl" {
  assert_parse_err("\\bigl 1 + 2 \\bigr)", false, "Invalid delimiter", "bad bigl")
}

///| 29. Invalid closing delimiter after \bigr
test "errors: invalid delimiter after bigr" {
  assert_parse_err("\\bigl(1+2\\bigr=3", false, "Invalid delimiter", "bad bigr")
}

///| 30. Invalid delimiter after \left
test "errors: invalid delimiter after left" {
  assert_parse_err("\\left x \\right)", false, "Invalid delimiter", "bad left")
}

///| 31. Lone backslash at EOF
test "errors: lone backslash" {
  assert_parse_err("\\", false, "Unexpected", "lone backslash")
}

///| 32. Invalid color
test "errors: invalid color" {
  assert_parse_err("\\textcolor{1a2}{foo}", false, "Invalid color", "bad color")
}

///| 33. Invalid size without unit
test "errors: invalid size no unit" {
  assert_parse_err("\\rule{0}{2em}", false, "Invalid size", "size no unit")
}

///| 34. Invalid size bogus unit
test "errors: invalid size bogus unit" {
  assert_parse_err("\\rule{1au}{2em}", false, "Invalid unit", "size bogus unit")
}

///| 35. Infinite macro expansion guard (max_expand)
test "errors: max_expand infinite loop" {
  let opts = ParseOptions::{ display_mode: false, throw_on_error: true, max_expand: 50 }
  match parse("\\def\\a{\\a}\\a", opts) {
    Ok(_) => debug_assert(false, "expected max_expand error")
    Err(e) => debug_assert(e.message.contains("expansion"), "expected expansion error: " + e.message)
  }
}
