///| Regression tests for red-team security hardening (DoS, macro scoping, strict rejection) and layout/MathML fidelity.

///|
fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| P0-1: deep nesting returns Err instead of crashing with SIGSEGV.
test "security: deep nesting depth guard" {
  let frac_deep = repeat_str("\\frac{", 2000) + "x" + repeat_str("}{x}", 2000)
  debug_assert(to_mathml(frac_deep, false).is_err(), "deep frac must return Err")
  let sqrt_deep = repeat_str("\\sqrt{", 2000) + "x" + repeat_str("}", 2000)
  debug_assert(render_layout(sqrt_deep, false).is_err(), "deep sqrt layout must return Err")
  let color_flat = repeat_str("\\color{red}{x}", 2000)
  debug_assert(to_mathml(color_flat, false).is_err(), "flat color switches must return Err")
  let braces_deep = repeat_str("{", 2000) + "x" + repeat_str("}", 2000)
  debug_assert(to_mathml(braces_deep, false).is_err(), "deep braces must return Err")
}

///| P0-2: 25-byte exponential argument-doubling macro bomb is stopped by token-stack limit.
test "security: exponential macro arg growth bomb" {
  match to_mathml("\\def\\a#1{\\a{#1#1}}\\a{x}", false) {
    Ok(_) => debug_assert(false, "expected Err on exponential macro bomb")
    Err(e) => debug_assert(e.message.contains("expansion"), "expected expansion error: " + e.message)
  }
}

///| P0-3: lexical macro scoping in groups and matrix cells; \gdef / \global\def escape scope.
test "security: macro lexical scoping" {
  debug_assert(to_mathml("{\\def\\a{x}}\\a", false).is_err(), "group \\def must not leak")
  debug_assert(to_mathml("{\\newcommand{\\a}{x}}\\a", false).is_err(), "group \\newcommand must not leak")
  debug_assert(to_mathml("\\begin{matrix}\\def\\a{x} & \\a\\end{matrix}", false).is_err(), "matrix cell \\def must not leak")
  debug_assert(to_mathml("{\\gdef\\a{x}}\\a", false).is_ok(), "\\gdef must persist globally")
  debug_assert(to_mathml("{\\global\\def\\a{x}}\\a", false).is_ok(), "\\global\\def must persist globally")
}

///| P0-4: strict rejection of invalid macro definitions, \strut, and bare #.
test "security: strict rejection and builtin protection" {
  debug_assert(to_mathml("\\renewcommand{\\a}{x}", false).is_err(), "\\renewcommand undefined must fail")
  debug_assert(to_mathml("\\newcommand{\\alpha}{x}", false).is_err(), "\\newcommand builtin must fail")
  debug_assert(to_mathml("\\newcommand{\\a}[2][y]{#1+#2}\\a[z]{x}", false).is_err(), "optional default arg must fail")
  debug_assert(to_mathml("\\strut x", false).is_err(), "\\strut must be undefined")
  debug_assert(to_mathml("#", false).is_err(), "bare # must fail")
  match to_mathml("\\providecommand{\\alpha}{x}\\alpha", false) {
    Ok(mml) => debug_assert(mml.contains("<mi>α</mi>"), "\\providecommand must not override \\alpha")
    Err(e) => debug_assert(false, e.message)
  }
}

///| P1 & P2: throw_on_error=false, large em overflow, non-negative box depth.
test "security: api options and numeric bounds" {
  let opts = ParseOptions::{ display_mode: false, throw_on_error: false, max_expand: 1000 }
  debug_assert(parse("\\unknowncmd x", opts).is_ok(), "throw_on_error=false must recover")
  match to_mathml("\\kern300000em x", false) {
    Ok(mml) => debug_assert(mml.contains("width=\"300000em\""), "large em must not overflow 32-bit int")
    Err(e) => debug_assert(false, e.message)
  }
  match render_layout("\\overset{!}{=}", true) {
    Ok(b) => {
      let m = box_metrics(b)
      debug_assert(m.depth >= 0.0, "box depth must be non-negative")
    }
    Err(e) => debug_assert(false, e.message)
  }
}
