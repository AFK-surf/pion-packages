///| TeX Box Metrics Layout IR invariant tests (verifying CM/KaTeX font metrics & TeXbook rules).

///|
fn assert_layout_ok(tex : String, display : Bool, label : String) -> LayoutBox {
  match render_layout(tex, display) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, label + " layout failed: " + e.to_string())
      LayoutBox::HBox(Array::new(), BoxGeom::zero())
    }
  }
}

///| 1. Single glyph 'x' has real KaTeX Math-Italic metrics (width > 0.5, height > 0.4, depth == 0)
test "layout: single glyph x metrics" {
  let b = assert_layout_ok("x", false, "x")
  let m = box_metrics(b)
  debug_assert(m.width > 0.5 && m.width < 0.7, "x width in (0.5, 0.7)")
  debug_assert(m.height > 0.4 && m.height < 0.5, "x height in (0.4, 0.5)")
  debug_assert(m.depth >= 0.0 && m.depth < 0.05, "x depth near 0")
}

///| 2. Descender glyph 'y' or 'g' has positive depth
test "layout: descender glyph depth" {
  let b = assert_layout_ok("y", false, "y")
  let m = box_metrics(b)
  debug_assert(m.depth > 0.15, "y has descender depth > 0.15em")
}

///| 3. Capital 'A' taller than lowercase 'a'
test "layout: capital taller than lowercase" {
  let ba = assert_layout_ok("a", false, "a")
  let bA = assert_layout_ok("A", false, "A")
  debug_assert(box_metrics(bA).height > box_metrics(ba).height + 0.2, "A taller than a")
}

///| 4. Horizontal concatenation sums width monotonically
test "layout: hbox width increases with terms" {
  let b1 = assert_layout_ok("x", false, "x")
  let b2 = assert_layout_ok("x+y", false, "x+y")
  let b3 = assert_layout_ok("x+y+z", false, "x+y+z")
  debug_assert(box_metrics(b2).width > box_metrics(b1).width, "x+y wider than x")
  debug_assert(box_metrics(b3).width > box_metrics(b2).width, "x+y+z wider than x+y")
}

///| 5. Binary operator spacing adds medmuskip around '+'
test "layout: binary operator spacing" {
  let b_ord = assert_layout_ok("xy", false, "xy")
  let b_bin = assert_layout_ok("x+y", false, "x+y")
  debug_assert(box_metrics(b_bin).width > box_metrics(b_ord).width + 0.7, "x+y wider than xy + plus")
}

///| 6. Relation spacing adds thickmuskip around '='
test "layout: relation spacing" {
  let b_plus = assert_layout_ok("a+b", false, "a+b")
  let b_eq = assert_layout_ok("a=b", false, "a=b")
  debug_assert(box_metrics(b_eq).width > box_metrics(b_plus).width, "a=b has wider spacing than a+b")
}

///| 7. Fraction height > numerator height and depth > denominator depth
test "layout: fraction vertical extent" {
  let bf = assert_layout_ok("\\frac{a}{b}", true, "frac display")
  let ba = assert_layout_ok("a", true, "a")
  let m = box_metrics(bf)
  debug_assert(m.height > box_metrics(ba).height + 0.3, "frac taller than a")
  debug_assert(m.depth > 0.4, "frac has positive depth > 0.4em")
  debug_assert(m.width > 0.5, "frac positive width")
}

///| 8. Display frac is taller than inline frac
test "layout: display frac taller than inline frac" {
  let bd = assert_layout_ok("\\frac{a}{b}", true, "frac d")
  let bi = assert_layout_ok("\\frac{a}{b}", false, "frac i")
  debug_assert(
    box_metrics(bd).height + box_metrics(bd).depth > box_metrics(bi).height + box_metrics(bi).depth,
    "display frac total height > inline frac total height",
  )
}

///| 9. \dfrac inside inline equals display height
test "layout: dfrac taller than tfrac" {
  let bd = assert_layout_ok("\\dfrac{a}{b}", false, "dfrac")
  let bt = assert_layout_ok("\\tfrac{a}{b}", true, "tfrac")
  debug_assert(
    box_metrics(bd).height + box_metrics(bd).depth > box_metrics(bt).height + box_metrics(bt).depth,
    "dfrac > tfrac",
  )
}

///| 10. Superscript raises height above base
test "layout: superscript raises height" {
  let b_base = assert_layout_ok("x", false, "x")
  let b_sup = assert_layout_ok("x^2", false, "x^2")
  debug_assert(box_metrics(b_sup).height > box_metrics(b_base).height + 0.2, "x^2 taller than x")
  debug_assert(box_metrics(b_sup).width > box_metrics(b_base).width + 0.2, "x^2 wider than x")
}

///| 11. Subscript increases depth below base
test "layout: subscript increases depth" {
  let b_base = assert_layout_ok("x", false, "x")
  let b_sub = assert_layout_ok("x_i", false, "x_i")
  debug_assert(box_metrics(b_sub).depth > box_metrics(b_base).depth + 0.1, "x_i deeper than x")
}

///| 12. Combined sub and sup preserves width < sum of separate sub + sup widths
test "layout: sub and sup stacked vertically" {
  let b_both = assert_layout_ok("x_i^2", false, "x_i^2")
  let b_sup = assert_layout_ok("x^2", false, "x^2")
  let b_sub = assert_layout_ok("x_i", false, "x_i")
  debug_assert(box_metrics(b_both).height >= box_metrics(b_sup).height - 0.01, "height >= sup")
  debug_assert(box_metrics(b_both).depth >= box_metrics(b_sub).depth - 0.01, "depth >= sub")
  debug_assert(box_metrics(b_both).width < box_metrics(b_sup).width + box_metrics(b_sub).width, "stacked not side-by-side")
}

///| 13. Square root height > radicand height and width > radicand width
test "layout: sqrt bounds exceed radicand" {
  let bx = assert_layout_ok("x", false, "x")
  let bs = assert_layout_ok("\\sqrt{x}", false, "sqrt x")
  debug_assert(box_metrics(bs).height > box_metrics(bx).height + 0.1, "sqrt taller than x")
  debug_assert(box_metrics(bs).width > box_metrics(bx).width + 0.5, "sqrt wider than x")
}

///| 14. Nth root wider than plain sqrt
test "layout: nth root wider than sqrt" {
  let b1 = assert_layout_ok("\\sqrt{x}", false, "sqrt")
  let b2 = assert_layout_ok("\\sqrt[3]{x}", false, "cbrt")
  debug_assert(box_metrics(b2).width >= box_metrics(b1).width, "cbrt at least as wide as sqrt")
}

///| 15. Display \sum with limits stacks vertically (taller and deeper than inline \sum)
test "layout: sum display limits vs inline" {
  let bd = assert_layout_ok("\\sum_{i=1}^{n} i", true, "sum display")
  let bi = assert_layout_ok("\\sum_{i=1}^{n} i", false, "sum inline")
  debug_assert(
    box_metrics(bd).height + box_metrics(bd).depth > box_metrics(bi).height + box_metrics(bi).depth + 0.5,
    "display sum with limits much taller than inline sum",
  )
}

///| 16. \left( \frac{a}{b} \right) delimiters scale to cover inner fraction
test "layout: leftright scales with tall content" {
  let b_small = assert_layout_ok("\\left( x \\right)", true, "lr x")
  let b_tall = assert_layout_ok("\\left( \\frac{a}{b} \\right)", true, "lr frac")
  debug_assert(
    box_metrics(b_tall).height + box_metrics(b_tall).depth > box_metrics(b_small).height + box_metrics(b_small).depth + 0.5,
    "tall leftright scales vertically",
  )
}

///| 17. \big < \Big < \bigg < \Bigg delimiter heights strictly increase
test "layout: sized delimiter monotonic heights" {
  let b1 = assert_layout_ok("\\big(", false, "big")
  let b2 = assert_layout_ok("\\Big(", false, "Big")
  let b3 = assert_layout_ok("\\bigg(", false, "bigg")
  let b4 = assert_layout_ok("\\Bigg(", false, "Bigg")
  let h1 = box_metrics(b1).height + box_metrics(b1).depth
  let h2 = box_metrics(b2).height + box_metrics(b2).depth
  let h3 = box_metrics(b3).height + box_metrics(b3).depth
  let h4 = box_metrics(b4).height + box_metrics(b4).depth
  debug_assert(h2 > h1, "Big > big")
  debug_assert(h3 > h2, "bigg > Big")
  debug_assert(h4 > h3, "Bigg > bigg")
}

///| 18. Matrix 2x2 is taller and wider than 1x1
test "layout: matrix dimensions scale with rows and cols" {
  let m1 = box_metrics(assert_layout_ok("\\begin{pmatrix} a \\end{pmatrix}", false, "1x1"))
  let m2 = box_metrics(assert_layout_ok("\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}", false, "2x2"))
  debug_assert(m2.width > m1.width + 0.5, "2x2 wider than 1x1")
  debug_assert(m2.height + m2.depth > m1.height + m1.depth + 0.5, "2x2 taller than 1x1")
}

///| 19. Accent raises height above base
test "layout: accent raises height" {
  let bx = box_metrics(assert_layout_ok("x", false, "x"))
  let bh = box_metrics(assert_layout_ok("\\hat{x}", false, "hat x"))
  debug_assert(bh.height > bx.height + 0.1, "hat x taller than x")
}

///| 20. \overline increases height, \underline increases depth
test "layout: overline and underline" {
  let bx = box_metrics(assert_layout_ok("x", false, "x"))
  let bo = box_metrics(assert_layout_ok("\\overline{x}", false, "overline"))
  let bu = box_metrics(assert_layout_ok("\\underline{x}", false, "underline"))
  debug_assert(bo.height > bx.height + 0.1, "overline taller")
  debug_assert(bu.depth > bx.depth + 0.1, "underline deeper")
}

///| 21. \phantom preserves width, height, depth
test "layout: phantom preserves dimensions" {
  let bf = box_metrics(assert_layout_ok("\\frac{a}{b}", true, "frac"))
  let bp = box_metrics(assert_layout_ok("\\phantom{\\frac{a}{b}}", true, "phantom frac"))
  debug_assert(math_abs(bf.width - bp.width) < 0.01, "phantom width matches")
  debug_assert(math_abs(bf.height - bp.height) < 0.01, "phantom height matches")
  debug_assert(math_abs(bf.depth - bp.depth) < 0.01, "phantom depth matches")
}

///| 22. \hphantom zeroes vertical dims, \vphantom zeroes width
test "layout: hphantom and vphantom" {
  let bh = box_metrics(assert_layout_ok("\\hphantom{abc}", false, "hphantom"))
  let bv = box_metrics(assert_layout_ok("\\vphantom{\\frac{a}{b}}", true, "vphantom"))
  debug_assert(bh.width > 1.0 && bh.height == 0.0 && bh.depth == 0.0, "hphantom")
  debug_assert(bv.width == 0.0 && bv.height > 0.5, "vphantom")
}

///| 23. \kern adds exact horizontal width
test "layout: kern exact width" {
  let b0 = box_metrics(assert_layout_ok("aa", false, "aa"))
  let b1 = box_metrics(assert_layout_ok("a\\kern{2em}a", false, "a kern 2em a"))
  debug_assert(math_abs((b1.width - b0.width) - 2.0) < 0.02, "kern 2em adds 2.0em")
}

///| 24. \rule produces exact box dimensions
test "layout: rule exact dimensions" {
  let b = box_metrics(assert_layout_ok("\\rule{2em}{1.5em}", false, "rule"))
  debug_assert(math_abs(b.width - 2.0) < 0.01, "rule width 2em")
  debug_assert(math_abs(b.height - 1.5) < 0.01, "rule height 1.5em")
}

///| 25. ColorBox wraps inner box preserving geometry
test "layout: color preserves geometry" {
  let b1 = box_metrics(assert_layout_ok("x+y", false, "x+y"))
  let b2 = box_metrics(assert_layout_ok("\\textcolor{red}{x+y}", false, "red x+y"))
  debug_assert(math_abs(b1.width - b2.width) < 0.01, "color preserves width")
  debug_assert(math_abs(b1.height - b2.height) < 0.01, "color preserves height")
}
