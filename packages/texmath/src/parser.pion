///| Recursive-descent TeX math parser ported from KaTeX `src/Parser.ts`, `src/functions/*`, and `src/environments/array.ts`.

///|
pub struct Parser {
  gullet : MacroExpander
  mut mode : String
  display_mode : Bool
  throw_on_error : Bool
  mut leftright_depth : Int
  mut depth : Int
  max_depth : Int
  mut next_tok : Option[Token]
}

///|
pub fn Parser::new(input : String, opts : ParseOptions) -> Parser {
  Parser::{
    gullet: MacroExpander::new(input, opts.max_expand),
    mode: "math",
    display_mode: opts.display_mode,
    throw_on_error: opts.throw_on_error,
    leftright_depth: 0,
    depth: 0,
    max_depth: 1200,
    next_tok: None,
  }
}

///|
fn parser_fetch(p : Parser) -> Result[Token, TexError] {
  match p.next_tok {
    Some(t) => Ok(t)
    None =>
    match expander_next_token(p.gullet) {
      Ok(t) => {
        p.next_tok = Some(t)
        Ok(t)
      }
      Err(e) => Err(e)
    }
  }
}

///|
fn parser_consume(p : Parser) -> Unit {
  p.next_tok = None
}

///|
fn parser_consume_spaces(p : Parser) -> Result[Unit, TexError] {
  while true {
    match parser_fetch(p) {
      Ok(tok) => {
        if tok.text == " " {
          parser_consume(p)
        } else {
          return Ok(())
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(())
}

///|
fn parser_expect(p : Parser, expected : String, consume : Bool) -> Result[Unit, TexError] {
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tok.text != expected {
    return Err(TexError::{
      message: "Expected '" + expected + "', got '" + tok.text + "'",
      position: tok.start + 1,
    })
  }
  if consume {
    parser_consume(p)
  }
  Ok(())
}

///|
fn is_end_of_expr(t : String) -> Bool {
  let n = t.length()
  if n == 1 {
    let b = t[0]
    return b == 125 || b == 38
  }
  if n == 3 {
    return t == "EOF"
  }
  if n >= 4 && t[0] == 92 {
    return t == "\\end" || t == "\\right" || t == "\\endgroup"
  }
  false
}

///|
fn is_infix_cmd(t : String) -> Bool {
  if t.length() < 5 || t[0] != 92 {
    return false
  }
  t == "\\over" || t == "\\choose" || t == "\\atop" || t == "\\brace" || t == "\\brack" || t == "\\above"
}

///|
fn is_valid_delimiter(d : String) -> Bool {
  match d {
    "(" | "\\lparen" | ")" | "\\rparen" | "[" | "\\lbrack" | "]" | "\\rbrack" |
    "\\{" | "\\lbrace" | "\\}" | "\\rbrace" | "\\lfloor" | "\\rfloor" | "\\lceil" |
    "\\rceil" | "<" | ">" | "\\langle" | "\\rangle" | "\\lt" | "\\gt" |
    "\\lvert" | "\\rvert" | "\\lVert" | "\\rVert" | "\\lgroup" | "\\rgroup" |
    "\\lmoustache" | "\\rmoustache" | "/" | "\\backslash" | "|" | "\\vert" |
    "\\|" | "\\Vert" | "\\uparrow" | "\\Uparrow" | "\\downarrow" | "\\Downarrow" |
    "\\updownarrow" | "\\Updownarrow" | "." => true
    _ => false
  }
}

///|
fn is_big_symbol_op(name : String) -> Option[Bool] {
  // Returns Some(default_limits)
  match name {
    "\\sum" | "\\prod" | "\\coprod" | "\\bigcup" | "\\bigcap" | "\\bigvee" |
    "\\bigwedge" | "\\biguplus" | "\\bigodot" | "\\bigoplus" | "\\bigotimes" |
    "\\bigsqcup" | "\\intop" | "\\smallint" => Some(true)
    "\\int" | "\\iint" | "\\iiint" | "\\oint" | "\\oiint" | "\\oiiint" => Some(false)
    _ => None
  }
}

///|
fn is_named_op(name : String) -> Option[Bool] {
  // Returns Some(default_limits)
  match name {
    "\\lim" | "\\limsup" | "\\liminf" | "\\sup" | "\\inf" | "\\max" | "\\min" |
    "\\det" | "\\gcd" | "\\Pr" | "\\injlim" | "\\projlim" |
    "\\varliminf" | "\\varlimsup" | "\\varinjlim" | "\\varprojlim" => Some(true)
    "\\sin" | "\\cos" | "\\tan" | "\\cot" | "\\sec" | "\\csc" | "\\arcsin" |
    "\\arccos" | "\\arctan" | "\\sinh" | "\\cosh" | "\\tanh" | "\\coth" |
    "\\ln" | "\\log" | "\\exp" | "\\arg" | "\\deg" | "\\dim" | "\\hom" |
    "\\ker" | "\\lg" => Some(false)
    _ => None
  }
}

///|
fn is_non_stretchy_accent(name : String) -> Bool {
  match name {
    "\\acute" | "\\grave" | "\\ddot" | "\\tilde" | "\\bar" | "\\breve" |
    "\\check" | "\\hat" | "\\vec" | "\\dot" | "\\mathring" => true
    _ => false
  }
}

///|
fn is_stretchy_accent(name : String) -> Bool {
  match name {
    "\\widehat" | "\\widetilde" | "\\widecheck" | "\\overrightarrow" |
    "\\overleftarrow" | "\\overleftrightarrow" | "\\Overrightarrow" | "\\overgroup" |
    "\\overlinesegment" | "\\overleftharpoon" | "\\overrightharpoon" |
    "\\underleftarrow" | "\\underrightarrow" | "\\underleftrightarrow" |
    "\\undergroup" | "\\underlinesegment" | "\\utilde" => true
    _ => false
  }
}

///|
fn is_xarrow_cmd(name : String) -> Bool {
  match name {
    "\\xrightarrow" | "\\xleftarrow" | "\\xRightarrow" | "\\xLeftarrow" |
    "\\xleftrightarrow" | "\\xLeftrightarrow" | "\\xmapsto" |
    "\\xhookleftarrow" | "\\xhookrightarrow" |
    "\\xleftharpoonup" | "\\xleftharpoondown" |
    "\\xrightharpoonup" | "\\xrightharpoondown" |
    "\\xrightleftharpoons" | "\\xleftrightharpoons" |
    "\\xrightequilibrium" | "\\xleftequilibrium" |
    "\\xrightleftarrows" | "\\xtofrom" |
    "\\xtwoheadleftarrow" | "\\xtwoheadrightarrow" | "\\xlongequal" => true
    _ => false
  }
}

///|
fn sized_delim_info(name : String) -> Option[(Int, String)] {
  match name {
    "\\bigl" => Some((1, "mopen"))
    "\\Bigl" => Some((2, "mopen"))
    "\\biggl" => Some((3, "mopen"))
    "\\Biggl" => Some((4, "mopen"))
    "\\bigr" => Some((1, "mclose"))
    "\\Bigr" => Some((2, "mclose"))
    "\\biggr" => Some((3, "mclose"))
    "\\Biggr" => Some((4, "mclose"))
    "\\bigm" => Some((1, "mrel"))
    "\\Bigm" => Some((2, "mrel"))
    "\\biggm" => Some((3, "mrel"))
    "\\Biggm" => Some((4, "mrel"))
    "\\big" => Some((1, "mord"))
    "\\Big" => Some((2, "mord"))
    "\\bigg" => Some((3, "mord"))
    "\\Bigg" => Some((4, "mord"))
    _ => None
  }
}

///|
fn math_font_name(cmd : String) -> Option[String] {
  match cmd {
    "\\mathrm" => Some("mathrm")
    "\\mathit" => Some("mathit")
    "\\mathbf" | "\\bold" => Some("mathbf")
    "\\mathnormal" => Some("mathnormal")
    "\\mathsfit" => Some("mathsfit")
    "\\mathbb" | "\\Bbb" => Some("mathbb")
    "\\mathcal" => Some("mathcal")
    "\\mathfrak" | "\\frak" => Some("mathfrak")
    "\\mathscr" => Some("mathscr")
    "\\mathsf" => Some("mathsf")
    "\\mathtt" => Some("mathtt")
    "\\boldsymbol" | "\\bm" => Some("boldsymbol")
    _ => None
  }
}

///|
fn legacy_font_name(cmd : String) -> Option[String] {
  match cmd {
    "\\rm" => Some("mathrm")
    "\\bf" => Some("mathbf")
    "\\it" => Some("mathit")
    "\\sf" => Some("mathsf")
    "\\tt" => Some("mathtt")
    "\\cal" => Some("mathcal")
    _ => None
  }
}

///|
fn spacing_cmd_em(cmd : String) -> Option[Double] {
  match cmd {
    "\\," | "\\thinspace" => Some(3.0 / 18.0)
    "\\:" | "\\>" | "\\medspace" => Some(4.0 / 18.0)
    "\\;" | "\\thickspace" => Some(5.0 / 18.0)
    "\\!" | "\\negthinspace" => Some(-3.0 / 18.0)
    "\\negmedspace" => Some(-4.0 / 18.0)
    "\\negthickspace" => Some(-5.0 / 18.0)
    "\\ " | "~" | "\\nobreakspace" => Some(0.25)
    "\\enspace" => Some(0.5)
    "\\quad" => Some(1.0)
    "\\qquad" => Some(2.0)
    _ => None
  }
}

///|
fn style_switch_name(cmd : String) -> Option[String] {
  match cmd {
    "\\displaystyle" => Some("display")
    "\\textstyle" => Some("text")
    "\\scriptstyle" => Some("script")
    "\\scriptscriptstyle" => Some("scriptscript")
    _ => None
  }
}

///|
fn sizing_switch_name(cmd : String) -> Option[String] {
  match cmd {
    "\\tiny" | "\\scriptsize" | "\\footnotesize" | "\\small" | "\\normalsize" |
    "\\large" | "\\Large" | "\\LARGE" | "\\huge" | "\\Huge" => Some(cmd.slice(1, cmd.length()))
    _ => None
  }
}

///|
fn mclass_cmd_name(cmd : String) -> Option[String] {
  match cmd {
    "\\mathord" => Some("mord")
    "\\mathbin" => Some("mbin")
    "\\mathrel" => Some("mrel")
    "\\mathopen" => Some("mopen")
    "\\mathclose" => Some("mclose")
    "\\mathpunct" => Some("mpunct")
    "\\mathinner" => Some("minner")
    _ => None
  }
}

///|
fn is_valid_unit(u : String) -> Bool {
  match u {
    "pt" | "pc" | "in" | "bp" | "cm" | "mm" | "dd" | "cc" | "nd" | "nc" |
    "sp" | "px" | "ex" | "em" | "mu" => true
    _ => false
  }
}

///|
fn unit_to_em(v : Double, unit : String) -> Double {
  match unit {
    "em" => v
    "ex" => v * 0.431
    "mu" => v / 18.0
    "pt" => v / 10.0
    "pc" => v * 1.2
    "px" => v * 0.075
    "in" => v * 7.227
    "cm" => v * 2.845
    "mm" => v * 0.2845
    "bp" => v * 0.100375
    _ => v / 10.0
  }
}

///|
fn parse_double_str(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s[0] == 45 {
    neg = true
    i = 1
  } else if s[0] == 43 {
    i = 1
  }
  let mut int_part = 0.0
  let mut has_digit = false
  while i < n && s[i] >= 48 && s[i] <= 57 {
    int_part = int_part * 10.0 + (s[i] - 48).to_double()
    has_digit = true
    i = i + 1
  }
  let mut frac_part = 0.0
  let mut frac_div = 1.0
  if i < n && s[i] == 46 {
    i = i + 1
    while i < n && s[i] >= 48 && s[i] <= 57 {
      frac_part = frac_part * 10.0 + (s[i] - 48).to_double()
      frac_div = frac_div * 10.0
      has_digit = true
      i = i + 1
    }
  }
  if !has_digit || i != n {
    return None
  }
  let v = int_part + frac_part / frac_div
  Some(if neg { -v } else { v })
}

///| Parse a TeX size string like `1.5em`, `-0.25ex`, `10pt`. Returns em value.
fn parse_size_str(raw : String, pos : Int) -> Result[Double, TexError] {
  let s = raw.trim()
  let n = s.length()
  if n < 2 {
    return Err(TexError::{ message: "Invalid size: '" + s + "'", position: pos })
  }
  // Find where unit letters start
  let mut i = 0
  if s[0] == 45 || s[0] == 43 {
    i = 1
  }
  let mut has_num = false
  while i < n && ((s[i] >= 48 && s[i] <= 57) || s[i] == 46) {
    if s[i] >= 48 && s[i] <= 57 {
      has_num = true
    }
    i = i + 1
  }
  if !has_num {
    return Err(TexError::{ message: "Invalid size: '" + s + "'", position: pos })
  }
  let num_str = s.slice(0, i)
  let unit_str = s.slice(i, n).trim()
  if unit_str.length() == 0 {
    return Err(TexError::{ message: "Invalid size: '" + s + "'", position: pos })
  }
  if !is_valid_unit(unit_str) {
    return Err(TexError::{ message: "Invalid unit: '" + unit_str + "'", position: pos })
  }
  match parse_double_str(num_str) {
    Some(v) => Ok(unit_to_em(v, unit_str))
    None => Err(TexError::{ message: "Invalid size: '" + s + "'", position: pos })
  }
}

///|
fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

///|
fn is_valid_color(c : String) -> Bool {
  let s = c.trim()
  let n = s.length()
  if n == 0 {
    return false
  }
  if s[0] == 35 {
    // #RGB or #RRGGBB
    if n != 4 && n != 7 {
      return false
    }
    let mut i = 1
    while i < n {
      if !is_hex_digit(s[i]) {
        return false
      }
      i = i + 1
    }
    return true
  }
  // Named CSS colors: purely ASCII letters
  let mut i = 0
  while i < n {
    let b = s[i]
    if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Encode a Unicode codepoint into a UTF-8 String.
fn codepoint_to_utf8(cp : Int) -> String {
  let sb = StringBuilder::new()
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  sb.to_string()
}

///| Read either `{delim}` or a single bare delimiter token (used by `\genfrac`).
fn parser_read_delim_or_group(p : Parser) -> Result[String, TexError] {
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tok.text == "{" {
    match parser_read_raw_group(p) {
      Ok((s, _)) => Ok(s)
      Err(e) => Err(e)
    }
  } else if tok.text == "EOF" {
    Err(TexError::{ message: "Expected delimiter", position: tok.start })
  } else {
    parser_consume(p)
    Ok(tok.text)
  }
}

///| Read a raw brace-delimited string `{...}` (used for color, size, env name, array col spec).
fn parser_read_raw_group(p : Parser) -> Result[(String, Int), TexError] {
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let first = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if first.text != "{" {
    return Err(TexError::{
      message: "Expected '{', got '" + first.text + "'",
      position: first.start + 1,
    })
  }
  let pos = first.start + 1
  parser_consume(p)
  let sb = StringBuilder::new()
  let mut depth = 1
  while depth > 0 {
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if tok.text == "EOF" {
      return Err(TexError::{
        message: "Unexpected end of input in a macro argument, expected '}'",
        position: tok.start,
      })
    }
    parser_consume(p)
    if tok.text == "{" {
      depth = depth + 1
      if depth > p.max_depth {
        return Err(TexError::{
          message: "Maximum nesting depth exceeded",
          position: tok.start + 1,
        })
      }
      sb.write_string("{")
    } else if tok.text == "}" {
      depth = depth - 1
      if depth > 0 {
        sb.write_string("}")
      }
    } else {
      sb.write_string(tok.text)
    }
  }
  Ok((sb.to_string(), pos))
}

///| Read an optional bracket-delimited raw string `[...]`.
fn parser_read_raw_opt(p : Parser) -> Result[Option[(String, Int)], TexError] {
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let first = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if first.text != "[" {
    return Ok(None)
  }
  let pos = first.start + 1
  parser_consume(p)
  let sb = StringBuilder::new()
  let mut depth = 0
  while true {
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if tok.text == "EOF" {
      return Err(TexError::{
        message: "Unexpected end of input in a macro argument, expected ']'",
        position: tok.start,
      })
    }
    parser_consume(p)
    if tok.text == "{" {
      depth = depth + 1
      if depth > p.max_depth {
        return Err(TexError::{
          message: "Maximum nesting depth exceeded",
          position: tok.start + 1,
        })
      }
      sb.write_string("{")
    } else if tok.text == "}" {
      depth = depth - 1
      sb.write_string("}")
    } else if tok.text == "]" && depth == 0 {
      break
    } else {
      sb.write_string(tok.text)
    }
  }
  Ok(Some((sb.to_string(), pos)))
}

///| Read a TeX size argument (either `{1em}` or bare `1em` as in `\kern1em`).
fn parser_parse_size_arg(p : Parser, is_optional : Bool) -> Result[Option[Double], TexError] {
  if is_optional {
    match parser_read_raw_opt(p) {
      Ok(Some((s, pos))) =>
      match parse_size_str(s, pos) {
        Ok(v) => Ok(Some(v))
        Err(e) => Err(e)
      }
      Ok(None) => Ok(None)
      Err(e) => Err(e)
    }
  } else {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if tok.text == "{" {
      match parser_read_raw_group(p) {
        Ok((s, pos)) =>
        match parse_size_str(s, pos) {
          Ok(v) => Ok(Some(v))
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
    } else {
      // Bare size like \kern1em or \kern-0.5em or \mkern3mu
      let pos = tok.start + 1
      let sb = StringBuilder::new()
      // Read optional sign + digits/dots
      let mut t = tok
      if t.text == "-" || t.text == "+" {
        sb.write_string(t.text)
        parser_consume(p)
        t = match parser_fetch(p) {
          Ok(nt) => nt
          Err(e) => return Err(e)
        }
      }
      let mut has_num = false
      while t.text.length() == 1 && ((t.text[0] >= 48 && t.text[0] <= 57) || t.text[0] == 46) {
        if t.text[0] >= 48 && t.text[0] <= 57 {
          has_num = true
        }
        sb.write_string(t.text)
        parser_consume(p)
        t = match parser_fetch(p) {
          Ok(nt) => nt
          Err(e) => return Err(e)
        }
      }
      if !has_num {
        return Err(TexError::{
          message: "Invalid size: '" + t.text + "'",
          position: pos,
        })
      }
      // Read 2-letter unit
      let mut ulen = 0
      while ulen < 2 && t.text.length() == 1 && ((t.text[0] >= 65 && t.text[0] <= 90) || (t.text[0] >= 97 && t.text[0] <= 122)) {
        sb.write_string(t.text)
        parser_consume(p)
        ulen = ulen + 1
        t = match parser_fetch(p) {
          Ok(nt) => nt
          Err(e) => return Err(e)
        }
      }
      match parse_size_str(sb.to_string(), pos) {
        Ok(v) => Ok(Some(v))
        Err(e) => Err(e)
      }
    }
  }
}

///| Parse a color argument `{red}` or `{#ff0000}`.
fn parser_parse_color_arg(p : Parser) -> Result[String, TexError] {
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tok.text != "{" {
    return Err(TexError::{
      message: "Invalid color: '" + tok.text + "'",
      position: tok.start + 1,
    })
  }
  let (raw, pos) = match parser_read_raw_group(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if !is_valid_color(raw) {
    return Err(TexError::{
      message: "Invalid color: '" + raw + "'",
      position: pos,
    })
  }
  Ok(raw.trim())
}

///| Parse a delimiter token (after \left, \right, \middle, \big, etc.).
fn parser_parse_delim(p : Parser, cmd_name : String) -> Result[String, TexError] {
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tok.text == "{" {
    return Err(TexError::{
      message: "Invalid delimiter type 'ordgroup'",
      position: tok.start + 1,
    })
  }
  if tok.text == "EOF" {
    return Err(TexError::{
      message: "Expected delimiter after '" + cmd_name + "'",
      position: tok.start,
    })
  }
  if !is_valid_delimiter(tok.text) {
    return Err(TexError::{
      message: "Invalid delimiter '" + tok.text + "' after '" + cmd_name + "'",
      position: tok.start + 1,
    })
  }
  parser_consume(p)
  Ok(tok.text)
}

///| Parse a required argument group for a function (like `\frac` or `\sqrt`).
fn parser_parse_arg(p : Parser, func_name : String) -> Result[MathNode, TexError] {
  if p.mode == "math" {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if is_end_of_expr(tok.text) {
    return Err(TexError::{
      message: "Expected group as argument to '" + func_name + "'",
      position: tok.start + 1,
    })
  }
  if is_infix_cmd(tok.text) {
    return Err(TexError::{
      message: "Got function '" + tok.text + "' with no arguments as argument to '" + func_name + "'",
      position: tok.start + 1,
    })
  }
  match parser_parse_group(p, func_name, "") {
    Ok(Some(node)) => Ok(node)
    Ok(None) =>
    Err(TexError::{
      message: "Expected group as argument to '" + func_name + "'",
      position: tok.start + 1,
    })
    Err(e) => Err(e)
  }
}

///| Parse an optional `[...]` argument as a MathNode (used by `\sqrt[n]{x}`).
fn parser_parse_opt_arg(p : Parser) -> Result[Option[MathNode], TexError] {
  if p.mode == "math" {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if tok.text != "[" {
    return Ok(None)
  }
  parser_consume(p)
  let body = match parser_parse_expression(p, false, "]") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let end_tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if end_tok.text != "]" {
    return Err(TexError::{
      message: "Unexpected end of input in a macro argument, expected ']'",
      position: end_tok.start + 1,
    })
  }
  parser_consume(p)
  Ok(Some(MathNode::Group(body, true)))
}

///| Unwrap a single-element ordgroup or return as-is.
fn normalize_arg(n : MathNode) -> MathNode {
  match n {
    Group(body, _) => if body.length() == 1 { body[0] } else { n }
    _ => n
  }
}

///| Extract children of an argument node as an array.
fn arg_to_array(n : MathNode) -> Array[MathNode] {
  match n {
    Group(body, _) => body
    _ => {
      let arr : Array[MathNode] = Array::new()
      arr.push(n)
      arr
    }
  }
}

///| Check if a control sequence is a known built-in command or symbol.
fn is_builtin_command(name : String) -> Bool {
  if lookup_math_symbol(name) is Some(_) || lookup_text_symbol(name) is Some(_) {
    return true
  }
  if is_big_symbol_op(name) is Some(_) || is_named_op(name) is Some(_) {
    return true
  }
  if is_non_stretchy_accent(name) || is_stretchy_accent(name) || is_infix_cmd(name) {
    return true
  }
  if sized_delim_info(name) is Some(_) || math_font_name(name) is Some(_) ||
  legacy_font_name(name) is Some(_) || spacing_cmd_em(name) is Some(_) ||
  style_switch_name(name) is Some(_) || sizing_switch_name(name) is Some(_) ||
  mclass_cmd_name(name) is Some(_) {
    return true
  }
  match name {
    "\\frac" | "\\dfrac" | "\\tfrac" | "\\cfrac" | "\\binom" | "\\dbinom" | "\\tbinom" |
    "\\genfrac" | "\\sqrt" | "\\left" | "\\right" | "\\middle" | "\\begin" | "\\end" |
    "\\text" | "\\textrm" | "\\textbf" | "\\textit" | "\\textsf" | "\\texttt" |
    "\\color" | "\\textcolor" | "\\kern" | "\\mkern" | "\\hspace" | "\\mskip" |
    "\\phantom" | "\\hphantom" | "\\vphantom" | "\\rule" | "\\overline" | "\\underline" |
    "\\overbrace" | "\\underbrace" | "\\overbracket" | "\\underbracket" |
    "\\overset" | "\\underset" | "\\def" | "\\gdef" | "\\edef" | "\\xdef" | "\\global" |
    "\\let" | "\\newcommand" | "\\renewcommand" | "\\providecommand" |
    "\\relax" | "\\allowbreak" | "\\nobreak" | "\\limits" | "\\nolimits" |
    "\\mathop" | "\\operatorname" | "\\not" | "\\neq" | "\\notin" |
    "\\begingroup" | "\\endgroup" | "\\\\" | "\\newline" | "\\cr" => true
    _ => false
  }
}

///| Handle `\def` / `\gdef` / `\edef` / `\xdef`.
fn parser_handle_def(p : Parser, is_global : Bool) -> Result[Unit, TexError] {
  // Read macro name without expanding
  if p.next_tok is Some(t) {
    expander_push(p.gullet, t)
    p.next_tok = None
  }
  match expander_consume_spaces(p.gullet) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name_tok = match expander_pop(p.gullet) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  // Read parameter spec (#1#2...) until '{'
  let mut num_args = 0
  while true {
    let t = match expander_future(p.gullet) {
      Ok(ft) => ft
      Err(e) => return Err(e)
    }
    if t.text == "{" {
      break
    }
    if t.text == "EOF" {
      return Err(TexError::{ message: "Expected '{' in \\def", position: t.start })
    }
    let _ = expander_pop(p.gullet)
    if t.text == "#" {
      let d = match expander_pop(p.gullet) {
        Ok(dt) => dt
        Err(e) => return Err(e)
      }
      if d.text.length() == 1 && d.text[0] >= 49 && d.text[0] <= 57 {
        num_args = num_args + 1
      }
    }
  }
  let body_toks = match expander_consume_arg(p.gullet) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let def = MacroDef::{ tokens: body_toks, num_args }
  if is_global {
    expander_define_global(p.gullet, name_tok.text, def)
  } else {
    expander_define(p.gullet, name_tok.text, def)
  }
  Ok(())
}

///| Handle `\let\a=\b` or `\let\a\b`.
fn parser_handle_let(p : Parser, is_global : Bool) -> Result[Unit, TexError] {
  if p.next_tok is Some(t) {
    expander_push(p.gullet, t)
    p.next_tok = None
  }
  match expander_consume_spaces(p.gullet) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name_tok = match expander_pop(p.gullet) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if name_tok.text == "EOF" {
    return Err(TexError::{ message: "Unexpected end of input in \\let", position: name_tok.start })
  }
  match expander_consume_spaces(p.gullet) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let eq_tok = match expander_future(p.gullet) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if eq_tok.text == "=" {
    let _ = expander_pop(p.gullet)
    match expander_consume_spaces(p.gullet) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let rhs_tok = match expander_pop(p.gullet) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if rhs_tok.text == "EOF" {
    return Err(TexError::{ message: "Unexpected end of input in \\let", position: rhs_tok.start })
  }
  let def = match lookup_user_macro(p.gullet, rhs_tok.text) {
    Some(existing) => existing
    None => {
      let arr : Array[Token] = Array::new()
      arr.push(Token::{ text: rhs_tok.text, start: rhs_tok.start, end: rhs_tok.end, noexpand: true })
      MacroDef::{ tokens: arr, num_args: 0 }
    }
  }
  if is_global {
    expander_define_global(p.gullet, name_tok.text, def)
  } else {
    expander_define(p.gullet, name_tok.text, def)
  }
  Ok(())
}

///| Handle `\newcommand{\name}[n]{body}` / `\renewcommand` / `\providecommand`.
fn parser_handle_newcommand(p : Parser, cmd : String) -> Result[Unit, TexError] {
  if p.next_tok is Some(t) {
    expander_push(p.gullet, t)
    p.next_tok = None
  }
  let name_toks = match expander_consume_arg(p.gullet) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  if name_toks.length() == 0 {
    return Err(TexError::{ message: "Expected macro name in " + cmd, position: 0 })
  }
  let macro_name = name_toks[name_toks.length() - 1].text
  let pos = name_toks[name_toks.length() - 1].start + 1
  // Optional [num_args]
  let mut num_args = 0
  match expander_consume_spaces(p.gullet) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let nxt = match expander_future(p.gullet) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if nxt.text == "[" {
    let _ = expander_pop(p.gullet)
    let sb = StringBuilder::new()
    while true {
      let t = match expander_pop(p.gullet) {
        Ok(tt) => tt
        Err(e) => return Err(e)
      }
      if t.text == "]" {
        break
      }
      if t.text == "EOF" {
        return Err(TexError::{ message: "Expected ']' in " + cmd, position: t.start })
      }
      sb.write_string(t.text)
    }
    let ns = sb.to_string().trim()
    if ns.length() == 1 && ns[0] >= 48 && ns[0] <= 57 {
      num_args = ns[0] - 48
    } else {
      return Err(TexError::{ message: "Invalid number of arguments in " + cmd, position: pos })
    }
    // KaTeX does not support optional default argument `[default]` after `[n]`
    match expander_consume_spaces(p.gullet) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let after_n = match expander_future(p.gullet) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if after_n.text == "[" {
      return Err(TexError::{
        message: "Expected '{', got '['",
        position: after_n.start + 1,
      })
    }
  }
  let body_toks = match expander_consume_arg(p.gullet) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let already_defined = expander_is_defined(p.gullet, macro_name) || is_builtin_command(macro_name)
  if cmd == "\\newcommand" {
    if already_defined {
      return Err(TexError::{
        message: "\\newcommand{" + macro_name + "} attempting to redefine " + macro_name + "; use \\renewcommand",
        position: pos,
      })
    }
  } else if cmd == "\\renewcommand" {
    if !already_defined {
      return Err(TexError::{
        message: "\\renewcommand{" + macro_name + "} when command " + macro_name + " does not yet exist; use \\newcommand",
        position: pos,
      })
    }
  } else if cmd == "\\providecommand" {
    if already_defined {
      return Ok(())
    }
  }
  expander_define(p.gullet, macro_name, MacroDef::{ tokens: body_toks, num_args })
  Ok(())
}

///| Parse `\begin{CD} ... \end{CD}` commutative diagram.
fn parser_parse_cd_env(p : Parser) -> Result[MathNode, TexError] {
  expander_begin_group(p.gullet)
  let rows : Array[Array[Array[MathNode]]] = Array::new()
  let mut cur_row : Array[Array[MathNode]] = Array::new()
  let mut cur_cell : Array[MathNode] = Array::new()
  while true {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    if tok.text == "\\end" {
      if cur_cell.length() > 0 || cur_row.length() > 0 {
        cur_row.push(cur_cell)
        rows.push(cur_row)
      }
      parser_consume(p)
      let (end_name, end_pos) = match parser_read_raw_group(p) {
        Ok(r) => r
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      expander_end_group(p.gullet)
      if end_name != "CD" {
        return Err(TexError::{
          message: "Mismatch: \\begin{CD} matched by \\end{" + end_name + "}",
          position: end_pos,
        })
      }
      let aligns : Array[String] = Array::new()
      return Ok(MathNode::Matrix("CD", rows, aligns, "", "", true))
    }
    if tok.text == "EOF" {
      expander_end_group(p.gullet)
      return Err(TexError::{ message: "Expected \\end{CD}", position: tok.start })
    }
    if tok.text == "\\\\" || tok.text == "\\cr" {
      parser_consume(p)
      if cur_cell.length() > 0 || cur_row.length() == 0 {
        cur_row.push(cur_cell)
      }
      rows.push(cur_row)
      cur_row = Array::new()
      cur_cell = Array::new()
      continue
    }
    if tok.text == "@" {
      parser_consume(p)
      let dir_tok = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      let dir = dir_tok.text
      parser_consume(p)
      if dir == ">" || dir == "<" {
        // Flush preceding node cell if non-empty
        if cur_cell.length() > 0 {
          cur_row.push(cur_cell)
          cur_cell = Array::new()
        }
        let above = match parser_parse_expression(p, false, dir) {
          Ok(b) => b
          Err(e) => {
            expander_end_group(p.gullet)
            return Err(e)
          }
        }
        let _ = parser_expect(p, dir, true)
        let below = match parser_parse_expression(p, false, dir) {
          Ok(b) => b
          Err(e) => {
            expander_end_group(p.gullet)
            return Err(e)
          }
        }
        let _ = parser_expect(p, dir, true)
        let cmd = if dir == ">" { "\\xrightarrow" } else { "\\xleftarrow" }
        let arrow_cell : Array[MathNode] = Array::new()
        arrow_cell.push(MathNode::Styled("xarrow:" + cmd, [MathNode::Group(above, true), MathNode::Group(below, true)]))
        cur_row.push(arrow_cell)
      } else if dir == "V" || dir == "A" {
        if cur_cell.length() > 0 {
          cur_row.push(cur_cell)
          cur_cell = Array::new()
        }
        let left_lbl = match parser_parse_expression(p, false, dir) {
          Ok(b) => b
          Err(e) => {
            expander_end_group(p.gullet)
            return Err(e)
          }
        }
        let _ = parser_expect(p, dir, true)
        let right_lbl = match parser_parse_expression(p, false, dir) {
          Ok(b) => b
          Err(e) => {
            expander_end_group(p.gullet)
            return Err(e)
          }
        }
        let _ = parser_expect(p, dir, true)
        // Between vertical arrows in CD, there is an empty spacer column
        if cur_row.length() > 0 {
          cur_row.push(Array::new())
        }
        let arrow_cell : Array[MathNode] = Array::new()
        arrow_cell.push(MathNode::Styled("cd_vert:" + dir, [MathNode::Group(left_lbl, true), MathNode::Group(right_lbl, true)]))
        cur_row.push(arrow_cell)
      } else if dir == "=" {
        if cur_cell.length() > 0 {
          cur_row.push(cur_cell)
          cur_cell = Array::new()
        }
        let arrow_cell : Array[MathNode] = Array::new()
        arrow_cell.push(MathNode::Styled("xarrow:\\xlongequal", [MathNode::Group(Array::new(), true), MathNode::Group(Array::new(), true)]))
        cur_row.push(arrow_cell)
      } else if dir == "|" {
        if cur_cell.length() > 0 {
          cur_row.push(cur_cell)
          cur_cell = Array::new()
        }
        if cur_row.length() > 0 {
          cur_row.push(Array::new())
        }
        let arrow_cell : Array[MathNode] = Array::new()
        arrow_cell.push(MathNode::Styled("cd_vert:|", [MathNode::Group(Array::new(), true), MathNode::Group(Array::new(), true)]))
        cur_row.push(arrow_cell)
      } else if dir == "." {
        if cur_cell.length() > 0 {
          cur_row.push(cur_cell)
          cur_cell = Array::new()
        }
        cur_row.push(Array::new())
      }
      continue
    }
    match parser_parse_atom(p, "@") {
      Ok(Some(atom)) => cur_cell.push(atom)
      Ok(None) => break
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
  }
  expander_end_group(p.gullet)
  Ok(MathNode::Matrix("CD", rows, Array::new(), "", "", true))
}

///| Parse environment `\begin{env} ... \end{env}`.
fn parser_parse_environment(p : Parser) -> Result[MathNode, TexError] {
  let (env_name, env_pos) = match parser_read_raw_group(p) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  // Check supported environments
  if env_name == "CD" {
    return parser_parse_cd_env(p)
  }
  let (left_delim, right_delim, default_align, is_disp, needs_col_spec, needs_alignat_arg, is_starred_matrix) = match env_name {
    "matrix" => ("", "", "c", false, false, false, false)
    "pmatrix" => ("(", ")", "c", false, false, false, false)
    "bmatrix" => ("[", "]", "c", false, false, false, false)
    "Bmatrix" => ("\\{", "\\}", "c", false, false, false, false)
    "vmatrix" => ("|", "|", "c", false, false, false, false)
    "Vmatrix" => ("\\|", "\\|", "c", false, false, false, false)
    "matrix*" => ("", "", "c", false, false, false, true)
    "pmatrix*" => ("(", ")", "c", false, false, false, true)
    "bmatrix*" => ("[", "]", "c", false, false, false, true)
    "Bmatrix*" => ("\\{", "\\}", "c", false, false, false, true)
    "vmatrix*" => ("|", "|", "c", false, false, false, true)
    "Vmatrix*" => ("\\|", "\\|", "c", false, false, false, true)
    "smallmatrix" => ("", "", "c", false, false, false, false)
    "cases" => ("\\{", ".", "l", false, false, false, false)
    "rcases" => (".", "\\}", "l", false, false, false, false)
    "dcases" => ("\\{", ".", "l", true, false, false, false)
    "drcases" => (".", "\\}", "l", true, false, false, false)
    "aligned" => ("", "", "rl", true, false, false, false)
    "align" | "align*" => ("", "", "rl", true, false, false, false)
    "alignedat" | "alignat" | "alignat*" => ("", "", "rl", true, false, true, false)
    "gathered" => ("", "", "c", true, false, false, false)
    "gather" | "gather*" => ("", "", "c", true, false, false, false)
    "split" => ("", "", "rl", true, false, false, false)
    "equation" | "equation*" => ("", "", "c", true, false, false, false)
    "array" => ("", "", "c", false, true, false, false)
    "darray" => ("", "", "c", true, true, false, false)
    "subarray" => ("", "", "c", false, true, false, false)
    _ =>
    return Err(TexError::{
      message: "No such environment: " + env_name,
      position: env_pos,
    })
  }
  let col_aligns : Array[String] = Array::new()
  if needs_alignat_arg {
    let _ = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
  }
  if is_starred_matrix {
    match parser_read_raw_opt(p) {
      Ok(Some((al_s, _))) => {
        let al = match al_s.trim() {
          "l" => "left"
          "r" => "right"
          _ => "center"
        }
        col_aligns.push("all:" + al)
      }
      Ok(None) => ()
      Err(e) => return Err(e)
    }
  }
  if needs_col_spec {
    let (spec_str, spec_pos) = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let mut si = 0
    while si < spec_str.length() {
      let ch = spec_str[si]
      if ch == 108 {
        col_aligns.push("left")
      } else if ch == 99 {
        col_aligns.push("center")
      } else if ch == 114 {
        col_aligns.push("right")
      } else if ch == 124 || ch == 58 || ch == 32 {
        // |, :, space separators
        ()
      } else {
        return Err(TexError::{
          message: "Unknown column alignment: " + spec_str.slice(si, si + 1),
          position: spec_pos + si,
        })
      }
      si = si + 1
    }
  } else if default_align == "rl" {
    col_aligns.push("right")
    col_aligns.push("left")
  } else if default_align == "l" {
    col_aligns.push("left")
    col_aligns.push("left")
  }
  expander_begin_group(p.gullet)
  let rows : Array[Array[Array[MathNode]]] = Array::new()
  let mut cur_row : Array[Array[MathNode]] = Array::new()
  // Skip leading \hline / \hdashline
  let _ = parser_skip_hlines(p)
  while true {
    expander_begin_group(p.gullet)
    let cell = match parser_parse_expression(p, false, "\\\\") {
      Ok(c) => c
      Err(e) => {
        expander_end_group(p.gullet)
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    expander_end_group(p.gullet)
    cur_row.push(cell)
    let nxt = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    if nxt.text == "&" {
      parser_consume(p)
    } else if nxt.text == "\\\\" || nxt.text == "\\cr" {
      parser_consume(p)
      // Optional row gap [1ex]
      let _ = match parser_parse_size_arg(p, true) {
        Ok(_) => ()
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      rows.push(cur_row)
      cur_row = Array::new()
      let _ = parser_skip_hlines(p)
    } else if nxt.text == "\\end" {
      rows.push(cur_row)
      // Strip trailing empty row if there are > 1 rows
      if rows.length() > 1 {
        let last = rows[rows.length() - 1]
        if last.length() == 1 && last[0].length() == 0 {
          let _ = rows.pop()
        }
      }
      parser_consume(p)
      let (end_name, end_pos) = match parser_read_raw_group(p) {
        Ok(r) => r
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      expander_end_group(p.gullet)
      if end_name != env_name {
        return Err(TexError::{
          message: "Mismatch: \\begin{" + env_name + "} matched by \\end{" + end_name + "}",
          position: end_pos,
        })
      }
      return Ok(MathNode::Matrix(env_name, rows, col_aligns, left_delim, right_delim, is_disp))
    } else {
      expander_end_group(p.gullet)
      return Err(TexError::{
        message: "Expected & or \\\\ or \\cr or \\end",
        position: nxt.start + 1,
      })
    }
  }
  expander_end_group(p.gullet)
  Ok(MathNode::Matrix(env_name, rows, col_aligns, left_delim, right_delim, is_disp))
}

///|
fn parser_skip_hlines(p : Parser) -> Result[Unit, TexError] {
  while true {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if tok.text == "\\hline" || tok.text == "\\hdashline" {
      parser_consume(p)
    } else {
      break
    }
  }
  Ok(())
}

///| Parse a single group, function, or symbol. Returns Ok(None) for internal/ignored nodes like \def or \relax.
fn parser_parse_group(p : Parser, _name : String, break_on_token : String) -> Result[Option[MathNode], TexError] {
  if p.depth >= p.max_depth {
    return Err(TexError::{
      message: "Maximum nesting depth exceeded",
      position: 0,
    })
  }
  p.depth = p.depth + 1
  let res = parser_parse_group_inner(p, _name, break_on_token)
  p.depth = p.depth - 1
  res
}

///| Text-mode group parsing (split out of hot `parser_parse_group_inner` for Wasm JIT size).
fn parser_parse_text_group(p : Parser, tok : Token, break_on_token : String) -> Result[Option[MathNode], TexError] {
  let text = tok.text
  if text == "$" {
    parser_consume(p)
    p.mode = "math"
    let body = match parser_parse_expression(p, false, "$") {
      Ok(b) => b
      Err(e) => {
        p.mode = "text"
        return Err(e)
      }
    }
    match parser_expect(p, "$", true) {
      Ok(_) => ()
      Err(e) => {
        p.mode = "text"
        return Err(e)
      }
    }
    p.mode = "text"
    return Ok(Some(MathNode::Styled("math", body)))
  }
  // Text-mode font commands
  if text == "\\text" || text == "\\textrm" || text == "\\textbf" ||
  text == "\\textit" || text == "\\textsf" || text == "\\texttt" ||
  text == "\\textnormal" || text == "\\textup" || text == "\\textmd" || text == "\\emph" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let style = if text == "\\text" { "" } else { text.slice(1, text.length()) }
    return Ok(Some(MathNode::Text(style, arg_to_array(arg))))
  }
  // Text-mode legacy font switches (\rm, \bf, \it, \sf, \tt)
  match legacy_font_name(text) {
    Some(fname) => {
      parser_consume(p)
      let body = match parser_parse_expression(p, true, break_on_token) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let tstyle = match fname {
        "mathrm" => "textrm"
        "mathbf" => "textbf"
        "mathit" => "textit"
        "mathsf" => "textsf"
        "mathtt" => "texttt"
        _ => ""
      }
      return Ok(Some(MathNode::Text(tstyle, body)))
    }
    None => ()
  }
  // Text-mode sizing switches
  match sizing_switch_name(text) {
    Some(sz) => {
      parser_consume(p)
      let body = match parser_parse_expression(p, true, break_on_token) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled("size:" + sz, body)))
    }
    None => ()
  }
  // Text-mode logos, underline, sout, copyright
  if text == "\\KaTeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("KaTeX", "textord")))
  }
  if text == "\\TeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("TeX", "textord")))
  }
  if text == "\\LaTeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("LaTeX", "textord")))
  }
  if text == "\\copyright" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("\u{00a9}", "textord")))
  }
  if text == "\\underline" || text == "\\underbar" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::OverUnder("underline", MathNode::Text("", arg_to_array(arg)), None, false)))
  }
  if text == "\\sout" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("enclose:sout", [MathNode::Text("", arg_to_array(arg))])))
  }
  if text == "\\phantom" || text == "\\hphantom" || text == "\\vphantom" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Phantom([MathNode::Text("", arg_to_array(arg))], text == "\\hphantom", text == "\\vphantom")))
  }
  if text == "\\reflectbox" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Text("", arg_to_array(arg))))
  }
  // Text-mode accents: \', \`, \^, \", \~, \=, \., \u, \v, \H, \r
  if text == "\\'" || text == "\\`" || text == "\\^" || text == "\\\"" ||
  text == "\\~" || text == "\\=" || text == "\\." || text == "\\u" ||
  text == "\\v" || text == "\\H" || text == "\\r" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => normalize_arg(a)
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Accent("text:" + text, arg, false, false)))
  }
  if text == "~" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord(" ", "textord")))
  }
  if text == "\\sqrt" || text == "\\frac" || text == "\\sum" || text == "\\int" {
    return Err(TexError::{
      message: "Can't use function '" + text + "' in text mode",
      position: tok.start + 1,
    })
  }
  if text == " " {
    parser_consume(p)
    return Ok(Some(MathNode::Ord(" ", "textord")))
  }
  // Regular text character or text symbol
  parser_consume(p)
  match lookup_text_symbol(text) {
    Some(_) => return Ok(Some(MathNode::Ord(text, "textord")))
    None => {
      if text.length() > 0 && text[0] == 92 {
        return Err(TexError::{
          message: "Undefined control sequence: " + text,
          position: tok.start + 1,
        })
      }
      return Ok(Some(MathNode::Ord(text, "textord")))
    }
  }
}

///| Cold path for uncommon backslash commands (split out of hot `parser_parse_group_inner`).
fn parser_parse_cold_cmd(p : Parser, tok : Token, break_on_token : String) -> Result[Option[MathNode], TexError] {
  let text = tok.text
  // \begingroup ... \endgroup
  if text == "\\begingroup" {
    parser_consume(p)
    expander_begin_group(p.gullet)
    let body = match parser_parse_expression(p, false, "\\endgroup") {
      Ok(b) => b
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    match parser_expect(p, "\\endgroup", true) {
      Ok(_) => ()
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    expander_end_group(p.gullet)
    return Ok(Some(MathNode::Group(body, true)))
  }
  // Internal commands: \relax, \def, \newcommand
  if text == "\\relax" || text == "\\allowbreak" || text == "\\nobreak" {
    parser_consume(p)
    return Ok(None)
  }
  if text == "\\def" || text == "\\edef" {
    parser_consume(p)
    match parser_handle_def(p, false) {
      Ok(_) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  if text == "\\gdef" || text == "\\xdef" {
    parser_consume(p)
    match parser_handle_def(p, true) {
      Ok(_) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  if text == "\\let" {
    parser_consume(p)
    match parser_handle_let(p, false) {
      Ok(_) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  if text == "\\global" {
    parser_consume(p)
    if p.next_tok is Some(t) {
      expander_push(p.gullet, t)
      p.next_tok = None
    }
    match expander_consume_spaces(p.gullet) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let sub = match expander_pop(p.gullet) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if sub.text == "\\def" || sub.text == "\\gdef" || sub.text == "\\edef" || sub.text == "\\xdef" {
      match parser_handle_def(p, true) {
        Ok(_) => return Ok(None)
        Err(e) => return Err(e)
      }
    } else if sub.text == "\\let" {
      match parser_handle_let(p, true) {
        Ok(_) => return Ok(None)
        Err(e) => return Err(e)
      }
    } else {
      return Err(TexError::{
        message: "Invalid command after \\global: " + sub.text,
        position: sub.start + 1,
      })
    }
  }
  if text == "\\newcommand" || text == "\\renewcommand" || text == "\\providecommand" {
    parser_consume(p)
    match parser_handle_newcommand(p, text) {
      Ok(_) => return Ok(None)
      Err(e) => return Err(e)
    }
  }
  // Infix fraction markers
  if is_infix_cmd(text) {
    parser_consume(p)
    if text == "\\above" {
      let sz = match parser_parse_size_arg(p, false) {
        Ok(Some(v)) => v
        Ok(None) => return Err(TexError::{ message: "Expected size after \\above", position: tok.start + 1 })
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Ord("\\above:" + format_em(sz), "__infix__")))
    }
    return Ok(Some(MathNode::Ord(text, "__infix__")))
  }
  // Top-level line breaks: \\, \newline, \cr
  if text == "\\\\" || text == "\\newline" || text == "\\cr" {
    parser_consume(p)
    let mut opt_h = 0.0
    if text == "\\\\" {
      match parser_parse_size_arg(p, true) {
        Ok(Some(v)) => opt_h = v
        _ => ()
      }
    }
    return Ok(Some(MathNode::Space("\\\\", opt_h)))
  }
  // \vdots
  if text == "\\vdots" {
    parser_consume(p)
    let items : Array[MathNode] = Array::new()
    items.push(MathNode::Ord("\u{22ee}", "textord"))
    items.push(MathNode::Rule(0.0, 0.0, 1.5))
    return Ok(Some(MathNode::Group(items, false)))
  }
  // \degree, \imath, \jmath, \mapsfrom, \llbracket, \rrbracket, \lBrace, \rBrace, \copyright, \KaTeX, \TeX, \LaTeX
  if text == "\\degree" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("\u{00b0}", "textord")))
  }
  if text == "\\imath" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("\u{0131}", "textord")))
  }
  if text == "\\jmath" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("\u{0237}", "textord")))
  }
  if text == "\\mapsfrom" || text == "\u{21a4}" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("op_normal:\u{21a4}", Array::new())))
  }
  if text == "\\llbracket" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("op_normal_nospace:\u{27e6}", Array::new())))
  }
  if text == "\\rrbracket" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("op_normal_nospace:\u{27e7}", Array::new())))
  }
  if text == "\\lBrace" {
    parser_consume(p)
    return Ok(Some(MathNode::Open("\u{2983}")))
  }
  if text == "\\rBrace" {
    parser_consume(p)
    return Ok(Some(MathNode::Close("\u{2984}")))
  }
  if text == "\\copyright" {
    parser_consume(p)
    return Ok(Some(MathNode::Text("", [MathNode::Ord("\u{00a9}", "textord")])))
  }
  if text == "\\KaTeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Text("", [MathNode::Ord("KaTeX", "textord")])))
  }
  if text == "\\TeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Text("", [MathNode::Ord("TeX", "textord")])))
  }
  if text == "\\LaTeX" {
    parser_consume(p)
    return Ok(Some(MathNode::Text("", [MathNode::Ord("LaTeX", "textord")])))
  }
  // \smash, \smash[t], \smash[b]
  if text == "\\smash" {
    parser_consume(p)
    let opt = match parser_read_raw_opt(p) {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    let arg = match parser_parse_arg(p, "\\smash") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let mode_tag = match opt {
      Some((s, _)) =>
      if s.trim() == "t" {
        "smash:t"
      } else if s.trim() == "b" {
        "smash:b"
      } else {
        "smash:tb"
      }
      None => "smash:tb"
    }
    return Ok(Some(MathNode::Styled(mode_tag, arg_to_array(arg))))
  }
  // \rlap, \llap, \clap (text-mode arg), \mathrlap, \mathllap, \mathclap (math-mode arg)
  if text == "\\rlap" || text == "\\llap" || text == "\\clap" ||
  text == "\\mathrlap" || text == "\\mathllap" || text == "\\mathclap" {
    parser_consume(p)
    let is_text_lap = text == "\\rlap" || text == "\\llap" || text == "\\clap"
    let prev_mode = p.mode
    if is_text_lap {
      p.mode = "text"
    }
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    let inner = if is_text_lap { [MathNode::Text("", arg_to_array(arg))] } else { arg_to_array(arg) }
    let tag = if text == "\\rlap" || text == "\\mathrlap" {
      "lap:r"
    } else if text == "\\llap" || text == "\\mathllap" {
      "lap:l"
    } else {
      "lap:c"
    }
    return Ok(Some(MathNode::Styled(tag, inner)))
  }
  // \xrightarrow, \xleftarrow, etc.
  if is_xarrow_cmd(text) {
    parser_consume(p)
    let below_opt = match parser_parse_opt_arg(p) {
      Ok(o) => o
      Err(e) => return Err(e)
    }
    let above = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let args : Array[MathNode] = Array::new()
    args.push(above)
    match below_opt {
      Some(b) => args.push(b)
      None => ()
    }
    return Ok(Some(MathNode::Styled("xarrow:" + text, args)))
  }
  // \colorbox{bg}{text}, \fcolorbox{border}{bg}{text}, \boxed{math}
  if text == "\\colorbox" {
    parser_consume(p)
    let bg = match parser_parse_color_arg(p) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let _ = parser_consume_spaces(p)
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, "\\colorbox") {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    return Ok(Some(MathNode::Styled("colorbox:" + bg, [MathNode::Text("", arg_to_array(arg))])))
  }
  if text == "\\fcolorbox" {
    parser_consume(p)
    let border = match parser_parse_color_arg(p) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let bg = match parser_parse_color_arg(p) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let _ = parser_consume_spaces(p)
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, "\\fcolorbox") {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    return Ok(Some(MathNode::Styled("fcolorbox:" + border + ":" + bg, [MathNode::Text("", arg_to_array(arg))])))
  }
  if text == "\\boxed" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, "\\boxed") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("boxed", arg_to_array(arg))))
  }
  // \cancel, \bcancel, \xcancel, \sout, \phase, \angl
  if text == "\\cancel" || text == "\\bcancel" || text == "\\xcancel" ||
  text == "\\sout" || text == "\\phase" || text == "\\angl" {
    parser_consume(p)
    let prev_mode = p.mode
    if text == "\\angl" {
      p.mode = "text"
    }
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    let inner = if text == "\\angl" { [MathNode::Text("", arg_to_array(arg))] } else { arg_to_array(arg) }
    return Ok(Some(MathNode::Styled("enclose:" + text.slice(1, text.length()), inner)))
  }
  // \pmb{body}
  if text == "\\pmb" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, "\\pmb") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("pmb", arg_to_array(arg))))
  }
  // \dddot{x}
  if text == "\\dddot" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, "\\dddot") {
      Ok(a) => normalize_arg(a)
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("dddot", [arg])))
  }
  // \underbar{text}
  if text == "\\underbar" {
    parser_consume(p)
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, "\\underbar") {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    return Ok(Some(MathNode::OverUnder("underline", MathNode::Text("", arg_to_array(arg)), None, false)))
  }
  // \raisebox{shift}{text}
  if text == "\\raisebox" {
    parser_consume(p)
    let sh = match parser_parse_size_arg(p, false) {
      Ok(Some(v)) => v
      Ok(None) => return Err(TexError::{ message: "Expected size in \\raisebox", position: tok.start + 1 })
      Err(e) => return Err(e)
    }
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, "\\raisebox") {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    return Ok(Some(MathNode::Styled("raisebox:" + format_em(sh), [MathNode::Text("", arg_to_array(arg))])))
  }
  // \mathchoice{D}{T}{S}{SS}
  if text == "\\mathchoice" {
    parser_consume(p)
    let d_arg = match parser_parse_arg(p, "\\mathchoice") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let t_arg = match parser_parse_arg(p, "\\mathchoice") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let s_arg = match parser_parse_arg(p, "\\mathchoice") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let ss_arg = match parser_parse_arg(p, "\\mathchoice") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("mathchoice", [d_arg, t_arg, s_arg, ss_arg])))
  }
  // \verb|...| or \verb ...
  if text == "\\verb" {
    parser_consume(p)
    if p.next_tok is Some(t) {
      expander_push(p.gullet, t)
      p.next_tok = None
    }
    let mut delim_ch = ""
    if tok.end > tok.start + 5 {
      // Lexer consumed trailing space(s) after \verb -> space is the delimiter
      delim_ch = " "
    } else {
      let mut delim_tok = match expander_pop(p.gullet) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if delim_tok.text == "*" {
        delim_tok = match expander_pop(p.gullet) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      delim_ch = delim_tok.text
      if delim_ch == "EOF" {
        return Err(TexError::{ message: "\\verb ended by end of line", position: delim_tok.start })
      }
    }
    let sb = StringBuilder::new()
    while true {
      let ct = match expander_pop(p.gullet) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if ct.text == "EOF" {
        return Err(TexError::{ message: "\\verb ended by end of line", position: ct.start })
      }
      if ct.text == delim_ch {
        break
      }
      sb.write_string(ct.text)
      if delim_ch == " " && ct.end > ct.start + ct.text.length() {
        break
      }
    }
    return Ok(Some(MathNode::Text("texttt", [MathNode::Ord(sb.to_string(), "textord")])))
  }
  // \char"41 / \char'101 / \char65
  if text == "\\char" {
    parser_consume(p)
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let first = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let mut base = 10
    if first.text == "\"" {
      base = 16
      parser_consume(p)
    } else if first.text == "'" {
      base = 8
      parser_consume(p)
    } else if first.text == "`" {
      parser_consume(p)
      let ch_tok = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      parser_consume(p)
      let cp = if ch_tok.text.length() > 1 && ch_tok.text[0] == 92 {
        ch_tok.text[1]
      } else if ch_tok.text.length() > 0 {
        ch_tok.text[0]
      } else {
        0
      }
      return Ok(Some(MathNode::Ord(codepoint_to_utf8(cp), "textord")))
    }
    let mut cp_val = 0
    let mut has_d = false
    while true {
      let dt = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if dt.text.length() != 1 {
        break
      }
      let b = dt.text[0]
      let d = if b >= 48 && b <= 57 {
        b - 48
      } else if b >= 65 && b <= 70 {
        b - 55
      } else if b >= 97 && b <= 102 {
        b - 87
      } else {
        -1
      }
      if d < 0 || d >= base {
        break
      }
      cp_val = cp_val * base + d
      has_d = true
      parser_consume(p)
    }
    if !has_d {
      return Err(TexError::{ message: "Invalid \\char code", position: tok.start + 1 })
    }
    return Ok(Some(MathNode::Ord(codepoint_to_utf8(cp_val), "textord")))
  }
  // Untrusted HTML/link commands in KaTeX default mode (trust: false): render red \cmd
  if text == "\\href" || text == "\\htmlId" || text == "\\htmlClass" || text == "\\htmlStyle" || text == "\\htmlData" {
    parser_consume(p)
    let _ = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let _ = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Color("#cc0000", [MathNode::Text("", [MathNode::Ord(text, "textord")])])))
  }
  if text == "\\url" {
    parser_consume(p)
    let _ = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Color("#cc0000", [MathNode::Text("", [MathNode::Ord(text, "textord")])])))
  }
  if text == "\\includegraphics" {
    parser_consume(p)
    let _ = match parser_read_raw_opt(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let _ = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Color("#cc0000", [MathNode::Text("", [MathNode::Ord(text, "textord")])])))
  }
  // \bra, \ket, \braket, \set, \Bra, \Ket, \Braket, \Set
  if text == "\\bra" || text == "\\ket" || text == "\\braket" || text == "\\set" ||
  text == "\\Bra" || text == "\\Ket" || text == "\\Braket" || text == "\\Set" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Styled("braket:" + text.slice(1, text.length()), arg_to_array(arg))))
  }
  // \limits / \nolimits at top level without base
  if text == "\\limits" || text == "\\nolimits" {
    return Err(TexError::{
      message: "Limit controls must follow a math operator",
      position: tok.start + 1,
    })
  }
  // \genfrac{ld}{rd}{bar}{style}{numer}{denom} (ld/rd can also be bare single tokens)
  if text == "\\genfrac" {
    parser_consume(p)
    let ld = match parser_read_delim_or_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let rd = match parser_read_delim_or_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let (bar_str, bar_pos) = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let (st_str, _) = match parser_read_raw_group(p) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let numer = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let denom = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let mut has_bar = true
    let mut bar_fmt = ""
    if bar_str.trim().length() > 0 {
      match parse_size_str(bar_str, bar_pos) {
        Ok(v) =>
        if v == 0.0 {
          has_bar = false
        } else {
          bar_fmt = format_em(v)
        }
        Err(e) => return Err(e)
      }
    }
    let style = match st_str.trim() {
      "0" => "display"
      "1" => "text"
      "2" => "script"
      "3" => "scriptscript"
      _ => ""
    }
    return Ok(Some(MathNode::Frac(numer, denom, has_bar, ld.trim(), rd.trim(), bar_fmt, style, false)))
  }
  // \middle
  if text == "\\middle" {
    if p.leftright_depth == 0 {
      return Err(TexError::{
        message: "\\middle without preceding \\left",
        position: tok.start + 1,
      })
    }
    parser_consume(p)
    let d = match parser_parse_delim(p, "\\middle") {
      Ok(dd) => dd
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Delim("middle", d, Array::new(), 0, "mrel")))
  }
  // Sized delimiters \big, \Big, \bigg, \Bigg (+ l/r/m)
  match sized_delim_info(text) {
    Some((sz, mc)) => {
      parser_consume(p)
      let d = match parser_parse_delim(p, text) {
        Ok(dd) => dd
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Delim("sized", d, Array::new(), sz, mc)))
    }
    None => ()
  }
  // \mathop{body}
  if text == "\\mathop" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Op("\\mathop", false, false, false, arg_to_array(arg))))
  }
  // \overset{over}{base} and \underset{under}{base}
  if text == "\\overset" || text == "\\underset" {
    let is_over = text == "\\overset"
    let kind = text.slice(1, text.length())
    parser_consume(p)
    let script = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let base = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::OverUnder(kind, base, Some(script), is_over)))
  }
  // Legacy font switches (\rm, \bf, \it, \sf, \tt, \cal)
  match legacy_font_name(text) {
    Some(fname) => {
      parser_consume(p)
      let body = match parser_parse_expression(p, true, break_on_token) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled(fname, body)))
    }
    None => ()
  }
  // \substack{row1 \\ row2}
  if text == "\\substack" {
    parser_consume(p)
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match parser_expect(p, "{", true) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    expander_begin_group(p.gullet)
    let rows : Array[Array[Array[MathNode]]] = Array::new()
    while true {
      let row_nodes = match parser_parse_expression(p, false, "\\\\") {
        Ok(r) => r
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      rows.push([row_nodes])
      let nxt = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => {
          expander_end_group(p.gullet)
          return Err(e)
        }
      }
      if nxt.text == "\\\\" || nxt.text == "\\cr" {
        parser_consume(p)
      } else if nxt.text == "}" {
        parser_consume(p)
        break
      } else {
        expander_end_group(p.gullet)
        return Err(TexError::{ message: "Expected '}' in \\substack", position: nxt.start + 1 })
      }
    }
    expander_end_group(p.gullet)
    return Ok(Some(MathNode::Matrix("subarray", rows, ["center"], "", "", false)))
  }
  // \tag{...}, \tag*{...}, \notag, \nonumber
  if text == "\\tag" {
    parser_consume(p)
    let mut is_star = false
    let nxt = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if nxt.text == "*" {
      is_star = true
      parser_consume(p)
    }
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, "\\tag") {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    let tag_kind = if is_star { "tag:*" } else { "tag:" }
    return Ok(Some(MathNode::Styled(tag_kind, arg_to_array(arg))))
  }
  if text == "\\notag" || text == "\\nonumber" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("notag", Array::new())))
  }
  // \vcenter{body}, \hbox{body}, \reflectbox{body}, \mathreflectbox{body}, \minuso
  if text == "\\vcenter" || text == "\\mathreflectbox" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(arg))
  }
  if text == "\\hbox" || text == "\\reflectbox" {
    parser_consume(p)
    let _ = parser_consume_spaces(p)
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    if text == "\\reflectbox" {
      return Ok(Some(MathNode::Styled("reflectbox", [MathNode::Text("", arg_to_array(arg))])))
    }
    return Ok(Some(MathNode::Text("", arg_to_array(arg))))
  }
  if text == "\\minuso" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("minuso", Array::new())))
  }
  // \textcolor{color}{body}
  if text == "\\textcolor" {
    parser_consume(p)
    let color = match parser_parse_color_arg(p) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let arg = match parser_parse_arg(p, "\\textcolor") {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Color(color, arg_to_array(arg))))
  }
  // \kern, \mkern, \mskip, \hskip, \hspace, \hspace*
  if text == "\\kern" || text == "\\mkern" || text == "\\mskip" || text == "\\hskip" || text == "\\hspace" {
    parser_consume(p)
    if text == "\\hspace" {
      let nxt = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if nxt.text == "*" {
        parser_consume(p)
      }
    }
    match parser_parse_size_arg(p, false) {
      Ok(Some(w)) => return Ok(Some(MathNode::Space(text, w)))
      Ok(None) => return Err(TexError::{ message: "Expected size after " + text, position: tok.start + 1 })
      Err(e) => return Err(e)
    }
  }
  // \phantom, \hphantom, \vphantom
  if text == "\\phantom" || text == "\\hphantom" || text == "\\vphantom" {
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Phantom(arg_to_array(arg), text == "\\hphantom", text == "\\vphantom")))
  }
  // \rule[shift]{width}{height}
  if text == "\\rule" {
    parser_consume(p)
    let shift = match parser_parse_size_arg(p, true) {
      Ok(Some(v)) => v
      Ok(None) => 0.0
      Err(e) => return Err(e)
    }
    let w = match parser_parse_size_arg(p, false) {
      Ok(Some(v)) => v
      Ok(None) => return Err(TexError::{ message: "Expected width in \\rule", position: tok.start + 1 })
      Err(e) => return Err(e)
    }
    let h = match parser_parse_size_arg(p, false) {
      Ok(Some(v)) => v
      Ok(None) => return Err(TexError::{ message: "Expected height in \\rule", position: tok.start + 1 })
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Rule(shift, w, h)))
  }
  // Style switches (\displaystyle, \textstyle, \scriptstyle, \scriptscriptstyle)
  match style_switch_name(text) {
    Some(st) => {
      parser_consume(p)
      let body = match parser_parse_expression(p, true, break_on_token) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled("style:" + st, body)))
    }
    None => ()
  }
  // Sizing switches (\tiny .. \Huge)
  match sizing_switch_name(text) {
    Some(sz) => {
      parser_consume(p)
      let body = match parser_parse_expression(p, true, break_on_token) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled("size:" + sz, body)))
    }
    None => ()
  }
  // Math class overrides (\mathord, \mathbin, ...)
  match mclass_cmd_name(text) {
    Some(mc) => {
      parser_consume(p)
      let arg = match parser_parse_arg(p, text) {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled("mclass:" + mc, arg_to_array(arg))))
    }
    None => ()
  }
  // Fallback symbols lookup (for overridden symbols like \allowbreak / \nobreak / \degree if ever missed)
  match lookup_math_symbol(text) {
    Some(info) => {
      parser_consume(p)
      let node = match info.group {
        "bin" => MathNode::Bin(text)
        "rel" => MathNode::Rel(text)
        "open" => MathNode::Open(text)
        "close" => MathNode::Close(text)
        "punct" => MathNode::Punct(text)
        "inner" => MathNode::Inner(text)
        "spacing" => MathNode::Space(text, 0.25)
        "textord" => MathNode::Ord(text, "textord")
        _ => MathNode::Ord(text, "mathord")
      }
      return Ok(Some(node))
    }
    None => ()
  }
  // Unknown control sequence
  if !p.throw_on_error {
    parser_consume(p)
    let err_arr : Array[MathNode] = Array::new()
    err_arr.push(MathNode::Text("", [MathNode::Ord(text, "textord")]))
    return Ok(Some(MathNode::Color("#cc0000", err_arr)))
  }
  Err(TexError::{
    message: "Undefined control sequence: " + text,
    position: tok.start + 1,
  })
}

///| Hot path for group/atom parsing: ASCII fast path + hot backslash commands + symbol lookup.
fn parser_parse_group_inner(p : Parser, _name : String, break_on_token : String) -> Result[Option[MathNode], TexError] {
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let text = tok.text
  if is_end_of_expr(text) || (break_on_token.length() > 0 && (text == break_on_token || (break_on_token == "\\\\" && text == "\\cr"))) {
    return Ok(None)
  }
  if text == "#" {
    return Err(TexError::{
      message: "Expected 'EOF', got '#'",
      position: tok.start + 1,
    })
  }
  // Braced group `{ ... }`
  if text == "{" {
    parser_consume(p)
    expander_begin_group(p.gullet)
    let body = match parser_parse_expression(p, false, "") {
      Ok(b) => b
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    match parser_expect(p, "}", true) {
      Ok(_) => ()
      Err(e) => {
        expander_end_group(p.gullet)
        return Err(e)
      }
    }
    expander_end_group(p.gullet)
    return Ok(Some(MathNode::Group(body, true)))
  }
  // Text mode handling
  if p.mode == "text" {
    return parser_parse_text_group(p, tok, break_on_token)
  }
  // Math mode fast path: single ASCII non-backslash character!
  if text.length() == 1 {
    let b = text[0]
    if b != 92 {
      if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
        parser_consume(p)
        return Ok(Some(MathNode::Ord(text, "mathord")))
      }
      if b >= 48 && b <= 57 {
        parser_consume(p)
        return Ok(Some(MathNode::Ord(text, "textord")))
      }
      match b {
        36 => return Err(TexError::{ message: "Can't use function '$' in math mode", position: tok.start + 1 })
        94 | 95 | 39 => return Ok(None)
        126 => {
          parser_consume(p)
          return Ok(Some(MathNode::Space("~", 0.25)))
        }
        42 | 43 | 45 => {
          parser_consume(p)
          return Ok(Some(MathNode::Bin(text)))
        }
        58 | 60 | 61 | 62 => {
          parser_consume(p)
          return Ok(Some(MathNode::Rel(text)))
        }
        40 | 91 => {
          parser_consume(p)
          return Ok(Some(MathNode::Open(text)))
        }
        33 | 41 | 63 | 93 => {
          parser_consume(p)
          return Ok(Some(MathNode::Close(text)))
        }
        44 | 59 => {
          parser_consume(p)
          return Ok(Some(MathNode::Punct(text)))
        }
        34 | 46 | 47 | 64 | 96 | 124 => {
          parser_consume(p)
          return Ok(Some(MathNode::Ord(text, "textord")))
        }
        _ => {
          parser_consume(p)
          return Ok(Some(MathNode::Ord(text, "mathord")))
        }
      }
    }
  }
  // Non-backslash multi-byte token (Unicode char)
  if text.length() > 0 && text[0] != 92 {
    if text == "\u{21a4}" {
      parser_consume(p)
      return Ok(Some(MathNode::Styled("op_normal:\u{21a4}", Array::new())))
    }
    match lookup_math_symbol(text) {
      Some(info) => {
        parser_consume(p)
        let node = match info.group {
          "bin" => MathNode::Bin(text)
          "rel" => MathNode::Rel(text)
          "open" => MathNode::Open(text)
          "close" => MathNode::Close(text)
          "punct" => MathNode::Punct(text)
          "inner" => MathNode::Inner(text)
          "spacing" => MathNode::Space(text, 0.25)
          "textord" => MathNode::Ord(text, "textord")
          _ => MathNode::Ord(text, "mathord")
        }
        return Ok(Some(node))
      }
      None => {
        parser_consume(p)
        return Ok(Some(MathNode::Ord(text, "mathord")))
      }
    }
  }
  // Hot backslash commands (handles >95% of real math formulas without touching cold path)
  if text == "\\frac" || text == "\\dfrac" || text == "\\tfrac" || text == "\\cfrac" ||
  text == "\\binom" || text == "\\dbinom" || text == "\\tbinom" {
    parser_consume(p)
    let numer = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let denom = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let is_binom = text == "\\binom" || text == "\\dbinom" || text == "\\tbinom"
    let style = match text {
      "\\dfrac" | "\\dbinom" | "\\cfrac" => "display"
      "\\tfrac" | "\\tbinom" => "text"
      _ => ""
    }
    return Ok(Some(MathNode::Frac(numer, denom, !is_binom, if is_binom { "(" } else { "" }, if is_binom { ")" } else { "" }, "", style, text == "\\cfrac")))
  }
  if text == "\\sqrt" {
    parser_consume(p)
    let index = match parser_parse_opt_arg(p) {
      Ok(i) => i
      Err(e) => return Err(e)
    }
    let body = match parser_parse_arg(p, "\\sqrt") {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Sqrt(body, index)))
  }
  if text == "\\left" {
    parser_consume(p)
    let left_d = match parser_parse_delim(p, "\\left") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    p.leftright_depth = p.leftright_depth + 1
    let body = match parser_parse_expression(p, false, "") {
      Ok(b) => b
      Err(e) => {
        p.leftright_depth = p.leftright_depth - 1
        return Err(e)
      }
    }
    p.leftright_depth = p.leftright_depth - 1
    match parser_expect(p, "\\right", true) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let right_d = match parser_parse_delim(p, "\\right") {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Delim("leftright", left_d, body, 0, right_d)))
  }
  if text == "\\begin" {
    parser_consume(p)
    return match parser_parse_environment(p) {
      Ok(n) => Ok(Some(n))
      Err(e) => Err(e)
    }
  }
  match is_big_symbol_op(text) {
    Some(def_lim) => {
      parser_consume(p)
      return Ok(Some(MathNode::Op(text, true, def_lim, false, Array::new())))
    }
    None => ()
  }
  match is_named_op(text) {
    Some(def_lim) => {
      parser_consume(p)
      return Ok(Some(MathNode::Op(text, false, def_lim, false, Array::new())))
    }
    None => ()
  }
  if text == "\\operatorname" || text == "\\operatornamewithlimits" {
    let mut is_star = text == "\\operatornamewithlimits"
    parser_consume(p)
    if !is_star {
      let nxt = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if nxt.text == "*" {
        is_star = true
        parser_consume(p)
      }
    }
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Op("\\operatorname", false, is_star, false, arg_to_array(arg))))
  }
  match math_font_name(text) {
    Some(fname) => {
      parser_consume(p)
      let arg = match parser_parse_arg(p, text) {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      return Ok(Some(MathNode::Styled(fname, arg_to_array(arg))))
    }
    None => ()
  }
  if text == "\\text" || text == "\\textrm" || text == "\\textbf" ||
  text == "\\textit" || text == "\\textsf" || text == "\\texttt" ||
  text == "\\textnormal" || text == "\\textup" || text == "\\textmd" || text == "\\emph" {
    parser_consume(p)
    let prev_mode = p.mode
    p.mode = "text"
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => {
        p.mode = prev_mode
        return Err(e)
      }
    }
    p.mode = prev_mode
    let style = if text == "\\text" { "" } else { text.slice(1, text.length()) }
    return Ok(Some(MathNode::Text(style, arg_to_array(arg))))
  }
  match spacing_cmd_em(text) {
    Some(w) => {
      parser_consume(p)
      return Ok(Some(MathNode::Space(text, w)))
    }
    None => ()
  }
  if is_non_stretchy_accent(text) || is_stretchy_accent(text) {
    let stretchy = is_stretchy_accent(text)
    let shifty = !stretchy || text == "\\widehat" || text == "\\widetilde" || text == "\\widecheck"
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => normalize_arg(a)
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Accent(text, arg, stretchy, shifty)))
  }
  if text == "\\overline" || text == "\\underline" || text == "\\overbrace" ||
  text == "\\underbrace" || text == "\\overbracket" || text == "\\underbracket" {
    let is_over = text == "\\overline" || text == "\\overbrace" || text == "\\overbracket"
    let kind = text.slice(1, text.length())
    parser_consume(p)
    let arg = match parser_parse_arg(p, text) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::OverUnder(kind, arg, None, is_over)))
  }
  if text == "\\color" {
    parser_consume(p)
    let color = match parser_parse_color_arg(p) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    let body = match parser_parse_expression(p, true, break_on_token) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(Some(MathNode::Color(color, body)))
  }
  if text == "\\not" {
    parser_consume(p)
    return Ok(Some(MathNode::Ord("\\not", "mathord")))
  }
  if text == "\\neq" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("op_normal:\u{2260}", Array::new())))
  }
  if text == "\\notin" {
    parser_consume(p)
    return Ok(Some(MathNode::Styled("op_normal:\u{2209}", Array::new())))
  }
  if text == "\\dots" {
    parser_consume(p)
    return Ok(Some(MathNode::Inner("\\dots")))
  }
  // Fast symbol lookup for all non-overridden backslash symbols (avoids calling cold path!)
  if text != "\\allowbreak" && text != "\\nobreak" && text != "\\degree" {
    match lookup_math_symbol(text) {
      Some(info) => {
        parser_consume(p)
        let node = match info.group {
          "bin" => MathNode::Bin(text)
          "rel" => MathNode::Rel(text)
          "open" => MathNode::Open(text)
          "close" => MathNode::Close(text)
          "punct" => MathNode::Punct(text)
          "inner" => MathNode::Inner(text)
          "spacing" => MathNode::Space(text, 0.25)
          "textord" => MathNode::Ord(text, "textord")
          _ => MathNode::Ord(text, "mathord")
        }
        return Ok(Some(node))
      }
      None => ()
    }
  }
  parser_parse_cold_cmd(p, tok, break_on_token)
}
///| Parse superscript or subscript argument after `^` or `_`.
fn parser_handle_supsub(p : Parser, sym : String, pos : Int) -> Result[MathNode, TexError] {
  parser_consume(p)
  match parser_consume_spaces(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tok = match parser_fetch(p) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if is_end_of_expr(tok.text) {
    return Err(TexError::{
      message: "Expected group after '" + sym + "'",
      position: pos,
    })
  }
  match parser_parse_group(p, sym, "") {
    Ok(Some(n)) => Ok(n)
    Ok(None) =>
    Err(TexError::{
      message: "Expected group after '" + sym + "'",
      position: pos,
    })
    Err(e) => Err(e)
  }
}

///| Parse an atom with optional `\limits`/`\nolimits`, `^`, `_`, `'`.
fn parser_parse_atom(p : Parser, break_on_token : String) -> Result[Option[MathNode], TexError] {
  let base_opt = match parser_parse_group(p, "atom", break_on_token) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  // In text mode, no super/subscripts
  if p.mode == "text" {
    return Ok(base_opt)
  }
  let mut base = base_opt
  let mut sup : Option[MathNode] = None
  let mut sub : Option[MathNode] = None
  let mut has_scripts = false
  while true {
    match parser_consume_spaces(p) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let tlen = tok.text.length()
    let b0 = if tlen > 0 { tok.text[0] } else { 0 }
    if b0 != 94 && b0 != 95 && b0 != 39 && b0 != 92 {
      break
    }
    if b0 == 92 && (tok.text == "\\limits" || tok.text == "\\nolimits") {
      let lim = tok.text == "\\limits"
      match base {
        Some(Op(nm, is_sym, _, _, body)) => {
          base = Some(MathNode::Op(nm, is_sym, lim, true, body))
          parser_consume(p)
        }
        _ =>
        return Err(TexError::{
          message: "Limit controls must follow a math operator",
          position: tok.start + 1,
        })
      }
    } else if tok.text == "^" {
      if sup is Some(_) {
        return Err(TexError::{ message: "Double superscript", position: tok.start + 1 })
      }
      let s = match parser_handle_supsub(p, "^", tok.start + 1) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      sup = Some(s)
      has_scripts = true
    } else if tok.text == "_" {
      if sub is Some(_) {
        return Err(TexError::{ message: "Double subscript", position: tok.start + 1 })
      }
      let s = match parser_handle_supsub(p, "_", tok.start + 1) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      sub = Some(s)
      has_scripts = true
    } else if tok.text == "'" {
      if sup is Some(_) {
        return Err(TexError::{ message: "Double superscript", position: tok.start + 1 })
      }
      let primes : Array[MathNode] = Array::new()
      while true {
        let pt = match parser_fetch(p) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if pt.text == "'" {
          primes.push(MathNode::Ord("\\prime", "textord"))
          parser_consume(p)
        } else {
          break
        }
      }
      // Check if followed by `^` -> combine primes with superscript (like f'^2 -> f'^{2})
      match parser_consume_spaces(p) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let after = match parser_fetch(p) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if after.text == "^" {
        let extra = match parser_handle_supsub(p, "^", after.start + 1) {
          Ok(n) => n
          Err(e) => return Err(e)
        }
        primes.push(extra)
      }
      if primes.length() == 1 {
        sup = Some(primes[0])
      } else {
        sup = Some(MathNode::Group(primes, true))
      }
      has_scripts = true
    } else {
      break
    }
  }
  if has_scripts {
    Ok(Some(MathNode::SupSub(base, sub, sup)))
  } else {
    Ok(base)
  }
}

///| Rewrite infix operators (`\over`, `\choose`, `\atop`, `\brace`, `\brack`) in a parsed body.
fn handle_infix_nodes(body : Array[MathNode]) -> Result[Array[MathNode], TexError] {
  let mut infix_idx = -1
  let mut infix_cmd = ""
  let mut i = 0
  while i < body.length() {
    match body[i] {
      Ord(cmd, fam) =>
      if fam == "__infix__" {
        if infix_idx != -1 {
          return Err(TexError::{
            message: "only one infix operator per group",
            position: i,
          })
        }
        infix_idx = i
        infix_cmd = cmd
      }
      _ => ()
    }
    i = i + 1
  }
  if infix_idx == -1 {
    return Ok(body)
  }
  let numer_arr : Array[MathNode] = Array::new()
  let mut j = 0
  while j < infix_idx {
    numer_arr.push(body[j])
    j = j + 1
  }
  let denom_arr : Array[MathNode] = Array::new()
  let mut k = infix_idx + 1
  while k < body.length() {
    denom_arr.push(body[k])
    k = k + 1
  }
  let numer = if numer_arr.length() == 1 {
    numer_arr[0]
  } else {
    MathNode::Group(numer_arr, true)
  }
  let denom = if denom_arr.length() == 1 {
    denom_arr[0]
  } else {
    MathNode::Group(denom_arr, true)
  }
  let (has_bar, ld, rd, bar_sz) = if infix_cmd.starts_with("\\above:") {
    let bsz = infix_cmd.slice(7, infix_cmd.length())
    (bsz != "0em", "", "", bsz)
  } else {
    match infix_cmd {
      "\\over" => (true, "", "", "")
      "\\choose" => (false, "(", ")", "")
      "\\atop" => (false, "", "", "")
      "\\brace" => (false, "\\{", "\\}", "")
      "\\brack" => (false, "[", "]", "")
      _ => (true, "", "", "")
    }
  }
  let res : Array[MathNode] = Array::new()
  res.push(MathNode::Frac(numer, denom, has_bar, ld, rd, bar_sz, "", false))
  Ok(res)
}

///|
fn parser_parse_expression(
  p : Parser,
  break_on_infix : Bool,
  break_on_token : String,
) -> Result[Array[MathNode], TexError] {
  let body : Array[MathNode] = Array::new()
  let mut has_infix = false
  let has_break = break_on_token.length() > 0
  while true {
    if p.mode == "math" {
      match parser_consume_spaces(p) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    let tok = match parser_fetch(p) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if is_end_of_expr(tok.text) {
      break
    }
    if has_break && (tok.text == break_on_token || (break_on_token == "\\\\" && tok.text == "\\cr")) {
      break
    }
    if break_on_infix && is_infix_cmd(tok.text) {
      break
    }
    let prev_pos = tok.start
    match parser_parse_atom(p, break_on_token) {
      Ok(Some(atom)) => {
        match atom {
          Ord(_, fam) => if fam == "__infix__" { has_infix = true }
          _ => ()
        }
        body.push(atom)
      }
      Ok(None) => {
        // Check if we made progress (e.g. \relax or \def consumed tokens); if not, break!
        let cur = match parser_fetch(p) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if cur.start == prev_pos && cur.text == tok.text {
          break
        }
      }
      Err(e) => return Err(e)
    }
  }
  if has_infix {
    handle_infix_nodes(body)
  } else {
    Ok(body)
  }
}

///| Top-level parse entry point.
pub fn parse_tex(tex : String, opts : ParseOptions) -> Result[Array[MathNode], TexError] {
  let p = Parser::new(tex, opts)
  let body = match parser_parse_expression(p, false, "") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match parser_expect(p, "EOF", true) {
    Ok(_) => Ok(body)
    Err(e) => Err(e)
  }
}
