///| Exact KaTeX MathML serializer ported from upstream `src/buildMathML.ts`, `src/mathMLTree.ts`, and `src/functions/*.ts`.

///|
enum MmlNode {
  Elem(String, Array[(String, String)], Array[MmlNode])
  Txt(String)
  Frag(Array[MmlNode])
}

///|
val struct MmlCtx {
  display : Bool
  script_level : Int
  font : String
  color : String
  text_family : String
  text_weight : String
  text_shape : String
  in_supsub_base : Bool
}

///|
fn mml_ctx_default(display : Bool) -> MmlCtx {
  MmlCtx::{
    display,
    script_level: 0,
    font: "",
    color: "",
    text_family: "",
    text_weight: "",
    text_shape: "",
    in_supsub_base: false,
  }
}

///|
fn mml_elem(tag : String, children : Array[MmlNode]) -> MmlNode {
  MmlNode::Elem(tag, Array::new(), children)
}

///|
fn mml_elem1(tag : String, child : MmlNode) -> MmlNode {
  let ch : Array[MmlNode] = Array::new()
  ch.push(child)
  MmlNode::Elem(tag, Array::new(), ch)
}

///|
fn mml_elem_txt(tag : String, text : String) -> MmlNode {
  mml_elem1(tag, MmlNode::Txt(text))
}

///|
fn mml_set_attr(node : MmlNode, k : String, v : String) -> Unit {
  match node {
    Elem(_, attrs, _) => {
      let mut i = 0
      while i < attrs.length() {
        let (ak, _) = attrs[i]
        if ak == k {
          attrs[i] = (k, v)
          return
        }
        i = i + 1
      }
      attrs.push((k, v))
    }
    _ => ()
  }
}

///|
fn mml_get_attr(node : MmlNode, k : String) -> String {
  match node {
    Elem(_, attrs, _) => {
      let mut i = 0
      while i < attrs.length() {
        let (ak, av) = attrs[i]
        if ak == k {
          return av
        }
        i = i + 1
      }
      ""
    }
    _ => ""
  }
}

///|
fn mml_make_row(nodes : Array[MmlNode]) -> MmlNode {
  if nodes.length() == 1 {
    nodes[0]
  } else {
    mml_elem("mrow", nodes)
  }
}

///|
fn escape_xml_into(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s[i]
    if b == 38 {
      sb.write_string("&amp;")
    } else if b == 60 {
      sb.write_string("&lt;")
    } else if b == 62 {
      sb.write_string("&gt;")
    } else if b == 34 {
      sb.write_string("&quot;")
    } else if b == 39 {
      sb.write_string("&#x27;")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
}

///|
fn render_mml_into(sb : StringBuilder, node : MmlNode) -> Unit {
  match node {
    Txt(s) => escape_xml_into(sb, s)
    Frag(ch) => {
      let mut i = 0
      while i < ch.length() {
        render_mml_into(sb, ch[i])
        i = i + 1
      }
    }
    Elem(tag, attrs, ch) => {
      sb.write_string("<")
      sb.write_string(tag)
      let mut i = 0
      while i < attrs.length() {
        let (k, v) = attrs[i]
        sb.write_string(" ")
        sb.write_string(k)
        sb.write_string("=\"")
        escape_xml_into(sb, v)
        sb.write_string("\"")
        i = i + 1
      }
      let self_close_mspace = tag == "mspace" && ch.length() == 0 &&
      mml_get_attr(node, "linebreak") == "" && mml_get_attr(node, "mathbackground") == ""
      if self_close_mspace {
        sb.write_string("/>")
      } else {
        sb.write_string(">")
        let mut j = 0
        while j < ch.length() {
          render_mml_into(sb, ch[j])
          j = j + 1
        }
        sb.write_string("</")
        sb.write_string(tag)
        sb.write_string(">")
      }
    }
  }
}

///| Format a non-negative integer Double (>= 0) as decimal digits without 32-bit overflow.
fn write_whole_double(sb : StringBuilder, v : Double) -> Unit {
  if v < 1.0 {
    sb.write_string("0")
    return
  }
  if v < 2000000000.0 {
    sb.write_string(v.to_int().to_string())
    return
  }
  let digits : Array[Int] = Array::new()
  let mut cur = v
  while cur >= 1.0 {
    let q = (cur / 10.0).floor()
    let rem = (cur - q * 10.0 + 0.0001).to_int()
    let d = if rem < 0 { 0 } else if rem > 9 { 9 } else { rem }
    digits.push(d)
    cur = q
  }
  let mut i = digits.length() - 1
  while i >= 0 {
    sb.write_string(digits[i].to_string())
    i = i - 1
  }
}

///| Format em value cleanly matching KaTeX `makeEm` (up to 4 decimal places, stripped trailing zeros).
fn format_em(v : Double) -> String {
  let neg = v < 0.0
  let av = if neg { -v } else { v }
  let whole_d = av.floor()
  let frac_scaled = ((av - whole_d) * 10000.0 + 0.5).to_int()
  let mut whole_out = whole_d
  let mut frac = frac_scaled
  if frac >= 10000 {
    whole_out = whole_out + 1.0
    frac = frac - 10000
  }
  let sb = StringBuilder::new()
  if neg && (whole_out >= 1.0 || frac > 0) {
    sb.write_string("-")
  }
  write_whole_double(sb, whole_out)
  if frac > 0 {
    sb.write_string(".")
    // Pad to 4 digits then strip trailing zeros
    let d1 = frac / 1000
    let d2 = (frac / 100) % 10
    let d3 = (frac / 10) % 10
    let d4 = frac % 10
    let digits : Array[Int] = Array::new()
    digits.push(d1)
    digits.push(d2)
    digits.push(d3)
    digits.push(d4)
    let mut end = 4
    while end > 0 && digits[end - 1] == 0 {
      end = end - 1
    }
    let mut i = 0
    while i < end {
      sb.write_string(digits[i].to_string())
      i = i + 1
    }
  }
  sb.write_string("em")
  sb.to_string()
}

///|
fn is_digit_str(s : String) -> Bool {
  s.length() == 1 && s[0] >= 48 && s[0] <= 57
}

///|
fn mml_symbol_text(name : String, is_text : Bool) -> String {
  // Preserve Unicode Mathematical Alphanumeric Symbols (U+1D400..U+1D7FF) in both math and text modes
  let cp = first_codepoint(name)
  if cp >= 0x1D400 && cp <= 0x1D7FF {
    return name
  }
  if is_text {
    if name == " " {
      return "\u{00a0}"
    }
    match lookup_text_symbol(name) {
      Some(info) => if info.replace.length() > 0 { info.replace } else { name }
      None => name
    }
  } else {
    match lookup_math_symbol(name) {
      Some(info) => if info.replace.length() > 0 { info.replace } else { name }
      None => name
    }
  }
}

///|
fn mml_math_variant(ctx : MmlCtx, is_textord : Bool) -> String {
  match ctx.font {
    "mathrm" => "normal"
    "mathit" => "italic"
    "mathbf" => "bold"
    "mathbb" => "double-struck"
    "mathcal" | "mathscr" => "script"
    "mathfrak" => "fraktur"
    "mathsf" => "sans-serif"
    "mathsfit" => "sans-serif-italic"
    "mathtt" => "monospace"
    "boldsymbol" => if is_textord { "bold" } else { "bold-italic" }
    _ => ""
  }
}

///|
fn mml_text_variant(ctx : MmlCtx) -> String {
  if ctx.text_family == "texttt" {
    "monospace"
  } else if ctx.text_family == "textsf" {
    if ctx.text_shape == "textit" && ctx.text_weight == "textbf" {
      "sans-serif-bold-italic"
    } else if ctx.text_shape == "textit" {
      "sans-serif-italic"
    } else if ctx.text_weight == "textbf" {
      "bold-sans-serif"
    } else {
      "sans-serif"
    }
  } else if ctx.text_shape == "textit" && ctx.text_weight == "textbf" {
    "bold-italic"
  } else if ctx.text_shape == "textit" {
    "italic"
  } else if ctx.text_weight == "textbf" {
    "bold"
  } else {
    ""
  }
}

///| Check if node is `<mi>.</mi>` or `{,}` (`<mo separator="true" lspace="0em" rspace="0em">,</mo>`).
fn is_num_punct(n : MmlNode) -> Bool {
  match n {
    Elem(tag, _, ch) => {
      if tag == "mi" && ch.length() == 1 {
        match ch[0] {
          Txt(s) => s == "."
          _ => false
        }
      } else if tag == "mo" && ch.length() == 1 &&
      mml_get_attr(n, "separator") == "true" &&
      mml_get_attr(n, "lspace") == "0em" &&
      mml_get_attr(n, "rspace") == "0em" {
        match ch[0] {
          Txt(s) => s == ","
          _ => false
        }
      } else {
        false
      }
    }
    _ => false
  }
}

///| Build a list of MathNodes into MathML nodes with KaTeX's adjacent merging rules.
fn mml_build_expr(nodes : Array[MathNode], ctx : MmlCtx, is_ordgroup : Bool) -> Array[MmlNode] {
  if nodes.length() == 1 {
    let g = mml_build_node(nodes[0], ctx)
    if is_ordgroup {
      match g {
        Elem(tag, _, _) =>
        if tag == "mo" {
          mml_set_attr(g, "lspace", "0em")
          mml_set_attr(g, "rspace", "0em")
        }
        _ => ()
      }
    }
    let out : Array[MmlNode] = Array::new()
    out.push(g)
    return out
  }
  let groups : Array[MmlNode] = Array::new()
  let mut i = 0
  while i < nodes.length() {
    // Context-sensitive \dots and \cdots followed by punctuation
    let mut cur_override : Option[MmlNode] = None
    match nodes[i] {
      Inner("\\dots") => {
        let mut sym = "\u{2026}"
        let mut lead_neg_thin = false
        if i + 1 < nodes.length() {
          match nodes[i + 1] {
            Bin(_) | Rel(_) => sym = "\u{22ef}"
            Op(_, _, _, _, _) => {
              sym = "\u{22ef}"
              lead_neg_thin = true
            }
            _ => ()
          }
        }
        if lead_neg_thin {
          cur_override = Some(MmlNode::Frag([mml_elem_txt("mtext", "\u{2009}\u{2063}"), mml_elem_txt("mo", sym)]))
        } else {
          cur_override = Some(mml_elem_txt("mo", sym))
        }
      }
      Inner("\\@cdots") => {
        if i + 1 < nodes.length() {
          match nodes[i + 1] {
            Punct(_) | Close(_) =>
            cur_override = Some(MmlNode::Frag([mml_elem_txt("mo", "\u{22ef}"), mml_elem_txt("mtext", "\u{2009}")]))
            _ => ()
          }
        }
      }
      _ => ()
    }
    let cur = match cur_override {
      Some(ov) => ov
      None => mml_build_node(nodes[i], ctx)
    }
    if groups.length() > 0 {
      let last = groups[groups.length() - 1]
      match (last, cur) {
        (Elem(ltag, _, lch), Elem(ctag, _, cch)) => {
          // 1. Merge adjacent <mtext> with same mathvariant
          if ltag == "mtext" && ctag == "mtext" &&
          mml_get_attr(last, "mathvariant") == mml_get_attr(cur, "mathvariant") {
            let mut k = 0
            while k < cch.length() {
              lch.push(cch[k])
              k = k + 1
            }
            i = i + 1
            continue
          }
          // 2. Merge adjacent <mn>
          if ltag == "mn" && ctag == "mn" &&
          mml_get_attr(last, "mathvariant") == mml_get_attr(cur, "mathvariant") {
            let mut k = 0
            while k < cch.length() {
              lch.push(cch[k])
              k = k + 1
            }
            i = i + 1
            continue
          }
          // 3. <mn> followed by <mi>.</mi> or {,}
          if ltag == "mn" && is_num_punct(cur) {
            let mut k = 0
            while k < cch.length() {
              lch.push(cch[k])
              k = k + 1
            }
            i = i + 1
            continue
          }
          // 4. <mi>.</mi> or {,} followed by <mn>
          if is_num_punct(last) && ctag == "mn" {
            let merged : Array[MmlNode] = Array::new()
            let mut k = 0
            while k < lch.length() {
              merged.push(lch[k])
              k = k + 1
            }
            k = 0
            while k < cch.length() {
              merged.push(cch[k])
              k = k + 1
            }
            let _ = groups.pop()
            let nm = mml_elem("mn", merged)
            groups.push(nm)
            i = i + 1
            continue
          }
          // 5. <mn> or <mi>.</mi> before <msup><mn>...</mn>...</msup> or <msub>
          if (ctag == "msup" || ctag == "msub") && cch.length() >= 1 &&
          (ltag == "mn" || is_num_punct(last)) {
            match cch[0] {
              Elem(btag, _, bch) =>
              if btag == "mn" {
                let merged : Array[MmlNode] = Array::new()
                let mut k = 0
                while k < lch.length() {
                  merged.push(lch[k])
                  k = k + 1
                }
                k = 0
                while k < bch.length() {
                  merged.push(bch[k])
                  k = k + 1
                }
                cch[0] = mml_elem("mn", merged)
                let _ = groups.pop()
                groups.push(cur)
                i = i + 1
                continue
              }
              _ => ()
            }
          }
          // 6. \not (<mi>\u{0338}</mi>) combined with following <mo>/<mi>/<mn>
          if ltag == "mi" && lch.length() == 1 && (ctag == "mo" || ctag == "mi" || ctag == "mn") {
            let is_not = match lch[0] {
              Txt(s) => s == "\u{0338}"
              _ => false
            }
            if is_not && cch.length() > 0 {
              match cch[0] {
                Txt(ts) =>
                if ts.length() > 0 {
                  let clen = utf8_char_len(ts[0])
                  let split_at = if clen <= ts.length() { clen } else { ts.length() }
                  let combined = ts.slice(0, split_at) + "\u{0338}" + ts.slice(split_at, ts.length())
                  cch[0] = MmlNode::Txt(combined)
                  let _ = groups.pop()
                  groups.push(cur)
                  i = i + 1
                  continue
                }
                _ => ()
              }
            }
          }
        }
        _ => ()
      }
    }
    groups.push(cur)
    i = i + 1
  }
  groups
}

///|
fn mml_build_expr_row(nodes : Array[MathNode], ctx : MmlCtx, is_ordgroup : Bool) -> MmlNode {
  mml_make_row(mml_build_expr(nodes, ctx, is_ordgroup))
}

///|
fn mml_space_node(cmd : String, width_em : Double, ctx : MmlCtx) -> MmlNode {
  if cmd == "\\\\" || cmd == "\\newline" || cmd == "\\cr" {
    let n = mml_elem("mspace", Array::new())
    mml_set_attr(n, "linebreak", "newline")
    if width_em != 0.0 {
      mml_set_attr(n, "height", format_em(width_em))
    }
    return n
  }
  if ctx.script_level > 0 {
    let gm = get_global_metrics(if ctx.script_level == 1 { 1 } else { 2 })
    let mu_scale = gm.css_em_per_mu * 18.0
    match cmd {
      "\\," | "\\thinspace" | "\\:" | "\\>" | "\\medspace" | "\\;" | "\\thickspace" |
      "\\!" | "\\negthinspace" | "\\negmedspace" | "\\negthickspace" => {
        let n = mml_elem("mspace", Array::new())
        mml_set_attr(n, "width", format_em(width_em * mu_scale))
        return n
      }
      "\\mkern" | "\\mskip" => {
        let n = mml_elem("mspace", Array::new())
        mml_set_attr(n, "width", format_em(width_em * mu_scale))
        return n
      }
      _ => ()
    }
  }
  // Special named spaces in KaTeX are SpaceNodes (rendered as <mtext>, not merged with text <mtext>)
  match cmd {
    "\\," | "\\thinspace" => MmlNode::Frag([mml_elem_txt("mtext", "\u{2009}")])
    "\\:" | "\\>" | "\\medspace" => MmlNode::Frag([mml_elem_txt("mtext", "\u{2005}")])
    "\\;" | "\\thickspace" => MmlNode::Frag([mml_elem_txt("mtext", "\u{2005}\u{200a}")])
    "\\!" | "\\negthinspace" => MmlNode::Frag([mml_elem_txt("mtext", "\u{2009}\u{2063}")])
    "\\ " | "~" | "\\nobreakspace" => MmlNode::Frag([mml_elem_txt("mtext", "\u{00a0}")])
    "\\mkern" =>
    if math_abs(width_em - 1.0 / 18.0) < 0.001 {
      MmlNode::Frag([mml_elem_txt("mtext", "\u{200a}")])
    } else {
      let n = mml_elem("mspace", Array::new())
      mml_set_attr(n, "width", format_em(width_em))
      n
    }
    _ => {
      let n = mml_elem("mspace", Array::new())
      mml_set_attr(n, "width", format_em(width_em))
      n
    }
  }
}

///| Decompose common precomposed accented Latin characters into (base, accent) for KaTeX text MathML.
fn decompose_text_accent(ch : String) -> Option[(String, String)] {
  match ch {
    "é" => Some(("e", "\u{02ca}"))
    "è" => Some(("e", "\u{02cb}"))
    "ê" => Some(("e", "\u{02c6}"))
    "ë" => Some(("e", "\u{00a8}"))
    "á" => Some(("a", "\u{02ca}"))
    "à" => Some(("a", "\u{02cb}"))
    "â" => Some(("a", "\u{02c6}"))
    "ä" => Some(("a", "\u{00a8}"))
    "ã" => Some(("a", "\u{02dc}"))
    "å" => Some(("a", "\u{02da}"))
    "í" => Some(("\u{0131}", "\u{02ca}"))
    "ì" => Some(("\u{0131}", "\u{02cb}"))
    "î" => Some(("\u{0131}", "\u{02c6}"))
    "ï" => Some(("\u{0131}", "\u{00a8}"))
    "ó" => Some(("o", "\u{02ca}"))
    "ò" => Some(("o", "\u{02cb}"))
    "ô" => Some(("o", "\u{02c6}"))
    "ö" => Some(("o", "\u{00a8}"))
    "õ" => Some(("o", "\u{02dc}"))
    "ú" => Some(("u", "\u{02ca}"))
    "ù" => Some(("u", "\u{02cb}"))
    "û" => Some(("u", "\u{02c6}"))
    "ü" => Some(("u", "\u{00a8}"))
    "ñ" => Some(("n", "\u{02dc}"))
    "ý" => Some(("y", "\u{02ca}"))
    "ÿ" => Some(("y", "\u{00a8}"))
    "É" => Some(("E", "\u{02ca}"))
    "È" => Some(("E", "\u{02cb}"))
    "Ê" => Some(("E", "\u{02c6}"))
    "Ë" => Some(("E", "\u{00a8}"))
    "Á" => Some(("A", "\u{02ca}"))
    "À" => Some(("A", "\u{02cb}"))
    "Â" => Some(("A", "\u{02c6}"))
    "Ä" => Some(("A", "\u{00a8}"))
    "Ã" => Some(("A", "\u{02dc}"))
    "Å" => Some(("A", "\u{02da}"))
    "Í" => Some(("I", "\u{02ca}"))
    "Ì" => Some(("I", "\u{02cb}"))
    "Î" => Some(("I", "\u{02c6}"))
    "Ï" => Some(("I", "\u{00a8}"))
    "İ" => Some(("I", "\u{02d9}"))
    "Ó" => Some(("O", "\u{02ca}"))
    "Ò" => Some(("O", "\u{02cb}"))
    "Ô" => Some(("O", "\u{02c6}"))
    "Ö" => Some(("O", "\u{00a8}"))
    "Õ" => Some(("O", "\u{02dc}"))
    "Ú" => Some(("U", "\u{02ca}"))
    "Ù" => Some(("U", "\u{02cb}"))
    "Û" => Some(("U", "\u{02c6}"))
    "Ü" => Some(("U", "\u{00a8}"))
    "Ñ" => Some(("N", "\u{02dc}"))
    "Ç" => Some(("C", "\u{00b8}"))
    "ç" => Some(("c", "\u{00b8}"))
    _ => None
  }
}

///| Map TeX text accent command to KaTeX MathML accent glyph.
fn text_accent_glyph(cmd : String) -> String {
  match cmd {
    "\\'" => "\u{02ca}"
    "\\`" => "\u{02cb}"
    "\\^" => "\u{005e}"
    "\\\"" => "\u{00a8}"
    "\\~" => "\u{02dc}"
    "\\=" => "\u{00af}"
    "\\." => "\u{02d9}"
    "\\u" => "\u{02d8}"
    "\\v" => "\u{02c7}"
    "\\H" => "\u{02dd}"
    "\\r" => "\u{02da}"
    _ => cmd
  }
}

///|
fn mml_text_nodes(nodes : Array[MathNode], ctx : MmlCtx) -> Array[MmlNode] {
  let out : Array[MmlNode] = Array::new()
  let mut i = 0
  while i < nodes.length() {
    match nodes[i] {
      Ord(t, _) => {
        // Check if next node is a combining diacritical mark (U+0300..U+036F)
        let mut combined_acc : Option[String] = None
        if i + 1 < nodes.length() {
          match nodes[i + 1] {
            Ord(nt, _) =>
            match nt {
              "\u{0300}" => combined_acc = Some("\u{02cb}")
              "\u{0301}" => combined_acc = Some("\u{02ca}")
              "\u{0302}" => combined_acc = Some("\u{02c6}")
              "\u{0303}" => combined_acc = Some("\u{02dc}")
              "\u{0304}" => combined_acc = Some("\u{00af}")
              "\u{0306}" => combined_acc = Some("\u{02d8}")
              "\u{0307}" => combined_acc = Some("\u{02d9}")
              "\u{0308}" => combined_acc = Some("\u{00a8}")
              "\u{030a}" => combined_acc = Some("\u{02da}")
              "\u{030b}" => combined_acc = Some("\u{02dd}")
              "\u{030c}" => combined_acc = Some("\u{02c7}")
              _ => ()
            }
            _ => ()
          }
        }
        match combined_acc {
          Some(acc_ch) => {
            let base_el = mml_elem_txt("mtext", mml_symbol_text(t, true))
            let v = mml_text_variant(ctx)
            if v.length() > 0 {
              mml_set_attr(base_el, "mathvariant", v)
            }
            let mv = mml_elem("mover", [base_el, mml_elem_txt("mo", acc_ch)])
            mml_set_attr(mv, "accent", "true")
            out.push(mv)
            i = i + 2
            continue
          }
          None => ()
        }
        match decompose_text_accent(t) {
          Some((base_ch, acc_ch)) => {
            let base_el = mml_elem_txt("mtext", base_ch)
            let v = mml_text_variant(ctx)
            if v.length() > 0 {
              mml_set_attr(base_el, "mathvariant", v)
            }
            let mv = mml_elem("mover", [base_el, mml_elem_txt("mo", acc_ch)])
            mml_set_attr(mv, "accent", "true")
            out.push(mv)
          }
          None => {
            let txt = mml_symbol_text(t, true)
            let el = mml_elem_txt("mtext", txt)
            if t != " " {
              let v = mml_text_variant(ctx)
              if v.length() > 0 {
                mml_set_attr(el, "mathvariant", v)
              }
            }
            out.push(el)
          }
        }
      }
      Group(body, _) => {
        let sub = mml_text_nodes(body, ctx)
        let mut j = 0
        while j < sub.length() {
          out.push(sub[j])
          j = j + 1
        }
      }
      Accent(label, base, _, _) =>
      if label.starts_with("text:") {
        let cmd = label.slice(5, label.length())
        let acc_ch = text_accent_glyph(cmd)
        let base_nodes = mml_text_nodes(arg_to_array(base), ctx)
        let mv = mml_elem("mover", [mml_make_row(base_nodes), mml_elem_txt("mo", acc_ch)])
        mml_set_attr(mv, "accent", "true")
        out.push(mv)
      } else {
        out.push(mml_build_node(nodes[i], ctx))
      }
      Text(st, body) => {
        let nctx = match st {
          "textbf" => MmlCtx::{ ..ctx, text_weight: "textbf" }
          "textit" => MmlCtx::{ ..ctx, text_shape: "textit" }
          "emph" => MmlCtx::{ ..ctx, text_shape: if ctx.text_shape == "textit" { "" } else { "textit" } }
          "textsf" => MmlCtx::{ ..ctx, text_family: "textsf" }
          "texttt" => MmlCtx::{ ..ctx, text_family: "texttt" }
          "textrm" => MmlCtx::{ ..ctx, text_family: "textrm", text_weight: "", text_shape: "" }
          "textnormal" => MmlCtx::{ ..ctx, text_family: "", text_weight: "", text_shape: "" }
          "textup" => MmlCtx::{ ..ctx, text_shape: "" }
          "textmd" => MmlCtx::{ ..ctx, text_weight: "" }
          _ => ctx
        }
        let sub = mml_text_nodes(body, nctx)
        let mut j = 0
        while j < sub.length() {
          out.push(sub[j])
          j = j + 1
        }
      }
      Styled(st, body) =>
      if st == "math" {
        let mctx = MmlCtx::{ ..ctx, display: false, script_level: 0, font: "" }
        let sub = mml_build_expr(body, mctx, false)
        let st_el = mml_elem("mstyle", sub)
        mml_set_attr(st_el, "scriptlevel", "0")
        mml_set_attr(st_el, "displaystyle", "false")
        out.push(st_el)
      } else if st.starts_with("enclose:") {
        out.push(mml_build_node(nodes[i], ctx))
      } else if st.starts_with("size:") {
        let sz_name = st.slice(5, st.length())
        let sz_em = match sz_name {
          "tiny" => "0.5em"
          "scriptsize" => "0.7em"
          "footnotesize" => "0.8em"
          "small" => "0.9em"
          "normalsize" => "1em"
          "large" => "1.2em"
          "Large" => "1.44em"
          "LARGE" => "1.728em"
          "huge" => "2.074em"
          "Huge" => "2.488em"
          _ => "1em"
        }
        let el = mml_elem("mstyle", mml_text_nodes(body, ctx))
        mml_set_attr(el, "mathsize", sz_em)
        out.push(el)
      } else {
        let sub = mml_text_nodes(body, ctx)
        let mut j = 0
        while j < sub.length() {
          out.push(sub[j])
          j = j + 1
        }
      }
      _ => out.push(mml_build_node(nodes[i], ctx))
    }
    i = i + 1
  }
  // Merge adjacent <mtext> with same mathvariant
  let merged : Array[MmlNode] = Array::new()
  i = 0
  while i < out.length() {
    let cur = out[i]
    if merged.length() > 0 {
      let last = merged[merged.length() - 1]
      match (last, cur) {
        (Elem("mtext", _, lch), Elem("mtext", _, cch)) =>
        if mml_get_attr(last, "mathvariant") == mml_get_attr(cur, "mathvariant") {
          let mut k = 0
          while k < cch.length() {
            lch.push(cch[k])
            k = k + 1
          }
          i = i + 1
          continue
        }
        _ => ()
      }
    }
    merged.push(cur)
    i = i + 1
  }
  merged
}

///| Build KaTeX MathML for \bra, \ket, \braket, \set, \Bra, \Ket, \Braket, \Set.
fn mml_build_braket(kind : String, body : Array[MathNode], ctx : MmlCtx) -> MmlNode {
  let is_large = kind == "Bra" || kind == "Ket" || kind == "Braket" || kind == "Set"
  let is_set = kind == "set" || kind == "Set"
  let open_sym = if kind == "ket" || kind == "Ket" {
    if is_large { "\u{2223}" } else { "\u{2223}" }
  } else if is_set {
    "{"
  } else {
    "\u{27e8}"
  }
  let close_sym = if kind == "bra" || kind == "Bra" {
    "\u{2223}"
  } else if is_set {
    "}"
  } else {
    "\u{27e9}"
  }
  if !is_large && !is_set {
    // \bra, \ket, \braket -> <mpadded>...</mpadded>
    let items : Array[MmlNode] = Array::new()
    if kind == "ket" {
      let mi = mml_elem_txt("mi", "\u{2223}")
      mml_set_attr(mi, "mathvariant", "normal")
      items.push(mi)
    } else {
      let lo = mml_elem_txt("mo", "\u{27e8}")
      mml_set_attr(lo, "stretchy", "false")
      items.push(lo)
    }
    let inner_nodes : Array[MmlNode] = Array::new()
    let mut i = 0
    while i < body.length() {
      match body[i] {
        Ord("|", _) | Rel("|") | Ord("\\vert", _) => {
          let mi = mml_elem_txt("mi", "\u{2223}")
          mml_set_attr(mi, "mathvariant", "normal")
          inner_nodes.push(mi)
        }
        _ => inner_nodes.push(mml_build_node(body[i], ctx))
      }
      i = i + 1
    }
    items.push(mml_make_row(inner_nodes))
    if kind == "bra" {
      let mi = mml_elem_txt("mi", "\u{2223}")
      mml_set_attr(mi, "mathvariant", "normal")
      items.push(mi)
    } else {
      let ro = mml_elem_txt("mo", "\u{27e9}")
      mml_set_attr(ro, "stretchy", "false")
      items.push(ro)
    }
    return mml_elem("mpadded", items)
  }
  let items : Array[MmlNode] = Array::new()
  let lo = mml_elem_txt("mo", open_sym)
  if is_large {
    mml_set_attr(lo, "fence", "true")
  } else {
    mml_set_attr(lo, "stretchy", "false")
  }
  items.push(lo)
  if kind == "set" {
    items.push(mml_elem_txt("mtext", "\u{2009}"))
  } else if kind == "Set" {
    items.push(mml_elem_txt("mtext", "\u{2005}"))
  }
  let mut i = 0
  while i < body.length() {
    let is_bar = match body[i] {
      Ord("|", _) | Rel("|") | Ord("\\vert", _) => true
      _ => false
    }
    if is_bar {
      if kind == "set" {
        items.push(mml_elem_txt("mo", "\u{2223}"))
      } else if kind == "Set" {
        items.push(mml_elem_txt("mtext", "\u{2005}\u{200a}"))
        let mid = mml_elem_txt("mo", "|")
        mml_set_attr(mid, "fence", "true")
        mml_set_attr(mid, "lspace", "0.05em")
        mml_set_attr(mid, "rspace", "0.05em")
        items.push(mid)
        items.push(mml_elem_txt("mtext", "\u{2005}\u{200a}"))
      } else if kind == "Braket" {
        items.push(mml_elem_txt("mtext", "\u{2009}"))
        let mid = mml_elem_txt("mo", "|")
        mml_set_attr(mid, "fence", "true")
        mml_set_attr(mid, "lspace", "0.05em")
        mml_set_attr(mid, "rspace", "0.05em")
        items.push(mid)
        items.push(mml_elem_txt("mtext", "\u{2009}"))
      } else {
        items.push(mml_build_node(body[i], ctx))
      }
    } else {
      items.push(mml_build_node(body[i], ctx))
    }
    i = i + 1
  }
  if kind == "set" {
    items.push(mml_elem_txt("mtext", "\u{2009}"))
  } else if kind == "Set" {
    items.push(mml_elem_txt("mtext", "\u{2005}"))
  }
  let ro = mml_elem_txt("mo", close_sym)
  if is_large {
    mml_set_attr(ro, "fence", "true")
  } else {
    mml_set_attr(ro, "stretchy", "false")
  }
  items.push(ro)
  mml_make_row(items)
}

///|
fn mml_build_node(node : MathNode, ctx : MmlCtx) -> MmlNode {
  match node {
    Ord(text, fam) => {
      if text == "\\not" {
        let el = mml_elem_txt("mi", "\u{0338}")
        mml_set_attr(el, "mathvariant", "normal")
        return el
      }
      if text == "\\prime" {
        let mo = mml_elem_txt("mo", "\u{2032}")
        mml_set_attr(mo, "mathvariant", "normal")
        return mo
      }
      let rep = mml_symbol_text(text, false)
      let is_textord = fam == "textord"
      if is_digit_str(rep) {
        let el = mml_elem_txt("mn", rep)
        let v = mml_math_variant(ctx, true)
        if v.length() > 0 && v != "normal" {
          mml_set_attr(el, "mathvariant", v)
        }
        return el
      }
      let el = mml_elem_txt("mi", rep)
      let cp = first_codepoint(rep)
      let is_lower_greek = (cp >= 0x03B1 && cp <= 0x03C9) || cp == 0x03F5 || cp == 0x03D1 || cp == 0x03F0 || cp == 0x03D5 || cp == 0x03F1 || cp == 0x03D6
      let v = mml_math_variant(ctx, is_textord)
      if v.length() > 0 {
        if v == "italic" {
          // Single-char <mi> is italic by default in MathML; omit redundant mathvariant="italic"
          ()
        } else if v == "normal" && is_lower_greek {
          // Lowercase Greek stays italic under \mathrm in KaTeX
          ()
        } else {
          mml_set_attr(el, "mathvariant", v)
        }
      } else if is_textord && rep != "." {
        // KaTeX textord symbols (e.g. \Gamma..\Omega, \infty) get mathvariant="normal"
        mml_set_attr(el, "mathvariant", "normal")
      }
      el
    }
    Bin(text) | Rel(text) | Inner(text) => {
      let rep = mml_symbol_text(text, false)
      let el = mml_elem_txt("mo", rep)
      if ctx.font == "boldsymbol" {
        mml_set_attr(el, "mathvariant", "bold-italic")
      }
      el
    }
    Open(text) | Close(text) => {
      let rep = mml_symbol_text(text, false)
      let el = mml_elem_txt("mo", rep)
      mml_set_attr(el, "stretchy", "false")
      el
    }
    Punct(text) => {
      let rep = mml_symbol_text(text, false)
      let el = mml_elem_txt("mo", rep)
      mml_set_attr(el, "separator", "true")
      el
    }
    Group(body, is_ord) => mml_build_expr_row(body, ctx, is_ord)
    Space(cmd, w) => mml_space_node(cmd, w, ctx)
    Rule(shift, w, h) => {
      let sp = mml_elem("mspace", Array::new())
      let bg = if ctx.color.length() > 0 { ctx.color } else { "black" }
      mml_set_attr(sp, "mathbackground", bg)
      mml_set_attr(sp, "width", format_em(w))
      mml_set_attr(sp, "height", format_em(h))
      let pad = mml_elem1("mpadded", sp)
      mml_set_attr(pad, "height", format_em(shift))
      mml_set_attr(pad, "voffset", format_em(shift))
      pad
    }
    Phantom(body, h_only, v_only) => {
      let mp = mml_elem("mphantom", mml_build_expr(body, ctx, false))
      if h_only {
        let pad = mml_elem1("mpadded", mp)
        mml_set_attr(pad, "height", "0px")
        mml_set_attr(pad, "depth", "0px")
        pad
      } else if v_only {
        let pad = mml_elem1("mpadded", mp)
        mml_set_attr(pad, "width", "0px")
        pad
      } else {
        mp
      }
    }
    Color(c, body) => {
      let el = mml_elem("mstyle", mml_build_expr(body, MmlCtx::{ ..ctx, color: c }, false))
      mml_set_attr(el, "mathcolor", c)
      el
    }
    Text(st, body) => {
      let tctx = match st {
        "textbf" => MmlCtx::{ ..ctx, text_weight: "textbf" }
        "textit" => MmlCtx::{ ..ctx, text_shape: "textit" }
        "emph" => MmlCtx::{ ..ctx, text_shape: if ctx.text_shape == "textit" { "" } else { "textit" } }
        "textsf" => MmlCtx::{ ..ctx, text_family: "textsf" }
        "texttt" => MmlCtx::{ ..ctx, text_family: "texttt" }
        "textrm" => MmlCtx::{ ..ctx, text_family: "textrm" }
        "textnormal" => MmlCtx::{ ..ctx, text_family: "", text_weight: "", text_shape: "" }
        "textup" => MmlCtx::{ ..ctx, text_shape: "" }
        "textmd" => MmlCtx::{ ..ctx, text_weight: "" }
        _ => ctx
      }
      mml_make_row(mml_text_nodes(body, tctx))
    }
    Styled(st, body) => {
      if st == "style:display" {
        let el = mml_elem("mstyle", mml_build_expr(body, MmlCtx::{ ..ctx, display: true, script_level: 0 }, false))
        mml_set_attr(el, "scriptlevel", "0")
        mml_set_attr(el, "displaystyle", "true")
        return el
      }
      if st == "style:text" {
        let el = mml_elem("mstyle", mml_build_expr(body, MmlCtx::{ ..ctx, display: false, script_level: 0 }, false))
        mml_set_attr(el, "scriptlevel", "0")
        mml_set_attr(el, "displaystyle", "false")
        return el
      }
      if st == "style:script" {
        let el = mml_elem("mstyle", mml_build_expr(body, MmlCtx::{ ..ctx, display: false, script_level: 1 }, false))
        mml_set_attr(el, "scriptlevel", "1")
        mml_set_attr(el, "displaystyle", "false")
        return el
      }
      if st == "style:scriptscript" {
        let el = mml_elem("mstyle", mml_build_expr(body, MmlCtx::{ ..ctx, display: false, script_level: 2 }, false))
        mml_set_attr(el, "scriptlevel", "2")
        mml_set_attr(el, "displaystyle", "false")
        return el
      }
      if st == "math" {
        return mml_build_expr_row(body, MmlCtx::{ ..ctx, font: "" }, false)
      }
      if st.starts_with("size:") {
        let sz_name = st.slice(5, st.length())
        let sz_em = match sz_name {
          "tiny" => "0.5em"
          "scriptsize" => "0.7em"
          "footnotesize" => "0.8em"
          "small" => "0.9em"
          "normalsize" => "1em"
          "large" => "1.2em"
          "Large" => "1.44em"
          "LARGE" => "1.728em"
          "huge" => "2.074em"
          "Huge" => "2.488em"
          _ => "1em"
        }
        let el = mml_elem("mstyle", mml_build_expr(body, ctx, false))
        mml_set_attr(el, "mathsize", sz_em)
        return el
      }
      if st.starts_with("op_normal:") {
        let sym = st.slice(10, st.length())
        let mo = mml_elem_txt("mo", sym)
        mml_set_attr(mo, "mathvariant", "normal")
        return mo
      }
      if st.starts_with("op_normal_nospace:") {
        let sym = st.slice(18, st.length())
        let mo = mml_elem_txt("mo", sym)
        mml_set_attr(mo, "mathvariant", "normal")
        mml_set_attr(mo, "lspace", "0em")
        mml_set_attr(mo, "rspace", "0em")
        return mo
      }
      if st == "smash:tb" || st == "smash:t" || st == "smash:b" {
        let pad = mml_elem1("mpadded", mml_build_expr_row(body, ctx, false))
        if st == "smash:tb" || st == "smash:t" {
          mml_set_attr(pad, "height", "0px")
        }
        if st == "smash:tb" || st == "smash:b" {
          mml_set_attr(pad, "depth", "0px")
        }
        return pad
      }
      if st == "lap:r" || st == "lap:l" || st == "lap:c" {
        let pad = mml_elem1("mpadded", mml_build_expr_row(body, ctx, false))
        if st == "lap:l" {
          mml_set_attr(pad, "lspace", "-1width")
        } else if st == "lap:c" {
          mml_set_attr(pad, "lspace", "-0.5width")
        }
        mml_set_attr(pad, "width", "0px")
        return pad
      }
      if st.starts_with("xarrow:") {
        let cmd = st.slice(7, st.length())
        let arrow_ch = match cmd {
          "\\xrightarrow" => "\u{2192}"
          "\\xleftarrow" => "\u{2190}"
          "\\xRightarrow" => "\u{21d2}"
          "\\xLeftarrow" => "\u{21d0}"
          "\\xleftrightarrow" => "\u{2194}"
          "\\xLeftrightarrow" => "\u{21d4}"
          "\\xmapsto" => "\u{21a6}"
          "\\xhookleftarrow" => "\u{21a9}"
          "\\xhookrightarrow" => "\u{21aa}"
          "\\xleftharpoonup" => "\u{21bc}"
          "\\xleftharpoondown" => "\u{21bd}"
          "\\xrightharpoonup" => "\u{21c0}"
          "\\xrightharpoondown" => "\u{21c1}"
          "\\xrightleftharpoons" | "\\xrightequilibrium" => "\u{21cc}"
          "\\xleftrightharpoons" | "\\xleftequilibrium" => "\u{21cb}"
          "\\xrightleftarrows" => "\u{21c4}"
          "\\xtofrom" => "\u{21c4}"
          "\\xtwoheadleftarrow" => "\u{219e}"
          "\\xtwoheadrightarrow" => "\u{21a0}"
          "\\xlongequal" => "="
          _ => "\u{2192}"
        }
        let mo = mml_elem_txt("mo", arrow_ch)
        mml_set_attr(mo, "stretchy", "true")
        mml_set_attr(mo, "minsize", "3.0em")
        let sctx = MmlCtx::{ ..ctx, display: false }
        let above_pad = mml_elem1("mpadded", mml_build_node(body[0], sctx))
        mml_set_attr(above_pad, "width", "+0.6em")
        mml_set_attr(above_pad, "lspace", "0.3em")
        if body.length() >= 2 {
          let below_pad = mml_elem1("mpadded", mml_build_node(body[1], sctx))
          mml_set_attr(below_pad, "width", "+0.6em")
          mml_set_attr(below_pad, "lspace", "0.3em")
          let ch : Array[MmlNode] = Array::new()
          ch.push(mo)
          ch.push(below_pad)
          ch.push(above_pad)
          return mml_elem("munderover", ch)
        }
        let ch : Array[MmlNode] = Array::new()
        ch.push(mo)
        ch.push(above_pad)
        return mml_elem("mover", ch)
      }
      if st.starts_with("colorbox:") {
        let bg = st.slice(9, st.length())
        let st_el = mml_elem1("mstyle", mml_build_expr_row(body, ctx, false))
        mml_set_attr(st_el, "scriptlevel", "0")
        mml_set_attr(st_el, "displaystyle", "false")
        let pad = mml_elem1("mpadded", st_el)
        mml_set_attr(pad, "width", "+6pt")
        mml_set_attr(pad, "height", "+6pt")
        mml_set_attr(pad, "lspace", "3pt")
        mml_set_attr(pad, "voffset", "3pt")
        mml_set_attr(pad, "mathbackground", bg)
        return pad
      }
      if st.starts_with("fcolorbox:") {
        let rest = st.slice(10, st.length())
        let mut colon = 0
        while colon < rest.length() && rest[colon] != 58 {
          colon = colon + 1
        }
        let border = rest.slice(0, colon)
        let bg = if colon + 1 < rest.length() { rest.slice(colon + 1, rest.length()) } else { "" }
        let st_el = mml_elem1("mstyle", mml_build_expr_row(body, ctx, false))
        mml_set_attr(st_el, "scriptlevel", "0")
        mml_set_attr(st_el, "displaystyle", "false")
        let pad = mml_elem1("mpadded", st_el)
        mml_set_attr(pad, "width", "+6pt")
        mml_set_attr(pad, "height", "+6pt")
        mml_set_attr(pad, "lspace", "3pt")
        mml_set_attr(pad, "voffset", "3pt")
        mml_set_attr(pad, "style", "border: 0.04em solid " + border)
        mml_set_attr(pad, "mathbackground", bg)
        return pad
      }
      if st == "boxed" {
        let inner = mml_build_expr_row(body, MmlCtx::{ ..ctx, display: true }, false)
        let s3 = mml_elem1("mstyle", inner)
        mml_set_attr(s3, "scriptlevel", "0")
        mml_set_attr(s3, "displaystyle", "true")
        let s2 = mml_elem1("mstyle", s3)
        mml_set_attr(s2, "scriptlevel", "0")
        mml_set_attr(s2, "displaystyle", "false")
        let s1 = mml_elem1("mstyle", s2)
        mml_set_attr(s1, "scriptlevel", "0")
        mml_set_attr(s1, "displaystyle", "false")
        let enc = mml_elem1("menclose", s1)
        mml_set_attr(enc, "notation", "box")
        return enc
      }
      if st.starts_with("enclose:") {
        let kind = st.slice(8, st.length())
        let notation = match kind {
          "cancel" => "updiagonalstrike"
          "bcancel" => "downdiagonalstrike"
          "xcancel" => "updiagonalstrike downdiagonalstrike"
          "sout" => "horizontalstrike"
          "phase" => "phasorangle"
          "angl" => "actuarial"
          _ => "box"
        }
        let inner = if kind == "angl" {
          let s = mml_elem1("mstyle", mml_build_expr_row(body, ctx, false))
          mml_set_attr(s, "scriptlevel", "0")
          mml_set_attr(s, "displaystyle", "false")
          s
        } else {
          mml_build_expr_row(body, ctx, false)
        }
        let enc = mml_elem1("menclose", inner)
        mml_set_attr(enc, "notation", notation)
        return enc
      }
      if st == "pmb" {
        let el = mml_elem("mstyle", mml_build_expr(body, ctx, false))
        mml_set_attr(el, "style", "text-shadow: 0.02em 0.01em 0.04px")
        return el
      }
      if st == "dddot" {
        let base_mo = mml_elem1("mo", mml_build_node(body[0], ctx))
        let dots = mml_elem_txt("mtext", "...")
        let s2 = mml_elem1("mstyle", dots)
        mml_set_attr(s2, "mathsize", "1em")
        let s1 = mml_elem1("mstyle", s2)
        mml_set_attr(s1, "scriptlevel", "0")
        mml_set_attr(s1, "displaystyle", "false")
        let pad = mml_elem1("mpadded", s1)
        mml_set_attr(pad, "voffset", "-0.1ex")
        let mv = mml_elem("mover", [base_mo, pad])
        return mml_elem1("mi", mv)
      }
      if st.starts_with("raisebox:") {
        let voff = st.slice(9, st.length())
        let s = mml_elem1("mstyle", mml_build_expr_row(body, ctx, false))
        mml_set_attr(s, "scriptlevel", "0")
        mml_set_attr(s, "displaystyle", "false")
        let pad = mml_elem1("mpadded", s)
        mml_set_attr(pad, "voffset", voff)
        return pad
      }
      if st == "mathchoice" && body.length() == 4 {
        let idx = if ctx.script_level >= 2 {
          3
        } else if ctx.script_level == 1 {
          2
        } else if ctx.display {
          0
        } else {
          1
        }
        return mml_build_node(body[idx], ctx)
      }
      if st.starts_with("cd_vert:") {
        let dir = st.slice(8, st.length())
        if dir == "|" {
          let mo = mml_elem_txt("mo", "\u{2225}")
          mml_set_attr(mo, "fence", "false")
          mml_set_attr(mo, "stretchy", "true")
          mml_set_attr(mo, "minsize", "1.8em")
          mml_set_attr(mo, "maxsize", "1.8em")
          return mo
        }
        let sym = if dir == "V" { "\u{2193}" } else { "\u{2191}" }
        let sctx = MmlCtx::{ ..ctx, display: false, script_level: 1 }
        let left_row = mml_elem("mrow", [mml_build_node(body[0], sctx)])
        let left_pad = mml_elem1("mpadded", left_row)
        mml_set_attr(left_pad, "width", "0")
        mml_set_attr(left_pad, "lspace", "-1width")
        mml_set_attr(left_pad, "voffset", "0.7em")
        let left_st = mml_elem1("mstyle", left_pad)
        mml_set_attr(left_st, "displaystyle", "false")
        mml_set_attr(left_st, "scriptlevel", "1")
        let mo = mml_elem_txt("mo", sym)
        mml_set_attr(mo, "fence", "false")
        mml_set_attr(mo, "stretchy", "true")
        mml_set_attr(mo, "minsize", "1.8em")
        mml_set_attr(mo, "maxsize", "1.8em")
        let right_row = mml_elem("mrow", [mml_build_node(body[1], sctx)])
        let right_pad = mml_elem1("mpadded", right_row)
        mml_set_attr(right_pad, "width", "0")
        mml_set_attr(right_pad, "voffset", "0.7em")
        let right_st = mml_elem1("mstyle", right_pad)
        mml_set_attr(right_st, "displaystyle", "false")
        mml_set_attr(right_st, "scriptlevel", "1")
        let inner = mml_elem("mrow", [left_st, mo, right_st])
        return mml_elem1("mrow", inner)
      }
      if st == "reflectbox" {
        let el = mml_elem1("mstyle", mml_build_expr_row(body, ctx, false))
        mml_set_attr(el, "scriptlevel", "0")
        mml_set_attr(el, "displaystyle", "false")
        return el
      }
      if st == "minuso" {
        let mi = mml_elem_txt("mi", "\u{29b5}")
        mml_set_attr(mi, "mathvariant", "normal")
        let mo = mml_elem1("mo", mi)
        mml_set_attr(mo, "lspace", "0.22em")
        mml_set_attr(mo, "rspace", "0.22em")
        return mo
      }
      if st == "tag:" || st == "tag:*" || st == "notag" {
        return MmlNode::Frag(Array::new())
      }
      if st.starts_with("braket:") {
        let kind = st.slice(7, st.length())
        return mml_build_braket(kind, body, ctx)
      }
      if st == "mclass:mbin" || st == "mclass:mrel" || st == "mclass:mord" ||
      st == "mclass:mopen" || st == "mclass:mclose" || st == "mclass:mpunct" || st == "mclass:minner" {
        if st == "mclass:mbin" {
          if body.length() == 1 {
            match body[0] {
              Ord(t, fam) => {
                let rep = mml_symbol_text(t, false)
                let mo = mml_elem_txt("mo", rep)
                if fam == "textord" {
                  mml_set_attr(mo, "mathvariant", "normal")
                }
                mml_set_attr(mo, "lspace", "0.22em")
                mml_set_attr(mo, "rspace", "0.22em")
                return mo
              }
              _ => ()
            }
          }
          let mo = mml_elem1("mo", mml_build_expr_row(body, ctx, false))
          mml_set_attr(mo, "lspace", "0.22em")
          mml_set_attr(mo, "rspace", "0.22em")
          return mo
        }
        if st == "mclass:mrel" {
          return mml_elem1("mo", mml_build_expr_row(body, ctx, false))
        }
        return mml_build_expr_row(body, ctx, false)
      }
      // Math font wrapper (\mathrm, \mathbf, \mathbb, etc.)
      mml_build_expr_row(body, MmlCtx::{ ..ctx, font: st }, false)
    }
    Op(name, is_sym, _lim, _always, body) => {
      if is_sym {
        let rep = mml_symbol_text(name, false)
        let mo = mml_elem_txt("mo", rep)
        if name == "\\smallint" {
          mml_set_attr(mo, "largeop", "false")
        }
        return mo
      }
      if name == "\\operatorname" {
        // Concatenate text of body into <mi mathvariant="normal">...</mi> + <mo>\u{2061}</mo>
        let sb = StringBuilder::new()
        let mut i = 0
        while i < body.length() {
          match body[i] {
            Ord(t, _) => sb.write_string(mml_symbol_text(t, false))
            Bin(t) => if t == "-" { sb.write_string("-") } else { sb.write_string(mml_symbol_text(t, false)) }
            Space(_, _) => sb.write_string("\u{2009}")
            _ => ()
          }
          i = i + 1
        }
        let mi = mml_elem_txt("mi", sb.to_string())
        mml_set_attr(mi, "mathvariant", "normal")
        let af = mml_elem_txt("mo", "\u{2061}")
        let pair : Array[MmlNode] = Array::new()
        pair.push(mi)
        pair.push(af)
        if ctx.in_supsub_base {
          return mml_elem("mrow", pair)
        }
        return MmlNode::Frag(pair)
      }
      if body.length() > 0 {
        return mml_elem("mo", mml_build_expr(body, ctx, false))
      }
      // Named operator (\sin, \lim, \limsup, \liminf, \injlim, \projlim, \varliminf, ...)
      if name == "\\varliminf" || name == "\\varlimsup" || name == "\\varinjlim" || name == "\\varprojlim" {
        let lim_row = mml_elem("mrow", [
          mml_elem_txt("mi", "l"),
          mml_elem_txt("mi", "i"),
          mml_elem_txt("mi", "m"),
        ])
        match lim_row {
          Elem(_, _, ch) => {
            mml_set_attr(ch[0], "mathvariant", "normal")
            mml_set_attr(ch[1], "mathvariant", "normal")
            mml_set_attr(ch[2], "mathvariant", "normal")
          }
          _ => ()
        }
        let bar_ch = match name {
          "\\varliminf" => "\u{203e}"
          "\\varlimsup" => "\u{203e}"
          "\\varinjlim" => "\u{2192}"
          _ => "\u{2190}"
        }
        let mo = mml_elem_txt("mo", bar_ch)
        mml_set_attr(mo, "stretchy", "true")
        let wrapped = if name == "\\varlimsup" {
          let mv = mml_elem("mover", [lim_row, mo])
          mml_set_attr(mv, "accent", "true")
          mv
        } else {
          let mu = mml_elem("munder", [lim_row, mo])
          mml_set_attr(mu, "accentunder", "true")
          mu
        }
        let mi = mml_elem1("mi", wrapped)
        mml_set_attr(mi, "mathvariant", "normal")
        let af = mml_elem_txt("mo", "\u{2061}")
        let pair : Array[MmlNode] = Array::new()
        pair.push(mi)
        pair.push(af)
        if ctx.in_supsub_base {
          return mml_elem("mrow", pair)
        }
        return MmlNode::Frag(pair)
      }
      if name == "\\limsup" || name == "\\liminf" || name == "\\injlim" || name == "\\projlim" {
        let label = match name {
          "\\limsup" => "lim\u{2009}sup"
          "\\liminf" => "lim\u{2009}inf"
          "\\injlim" => "inj\u{2009}lim"
          _ => "proj\u{2009}lim"
        }
        let mi = mml_elem_txt("mi", label)
        mml_set_attr(mi, "mathvariant", "normal")
        let af = mml_elem_txt("mo", "\u{2061}")
        let pair : Array[MmlNode] = Array::new()
        pair.push(mi)
        pair.push(af)
        if ctx.in_supsub_base {
          return mml_elem("mrow", pair)
        }
        return MmlNode::Frag(pair)
      }
      let label = if name.length() > 1 && name[0] == 92 { name.slice(1, name.length()) } else { name }
      let mi = mml_elem_txt("mi", label)
      let af = mml_elem_txt("mo", "\u{2061}")
      let pair : Array[MmlNode] = Array::new()
      pair.push(mi)
      pair.push(af)
      if ctx.in_supsub_base {
        return mml_elem("mrow", pair)
      }
      MmlNode::Frag(pair)
    }
    SupSub(base_opt, sub_opt, sup_opt) => {
      // Special case: \overbrace{...}^{n} or \underbrace{...}_{n}
      match base_opt {
        Some(base_inner) =>
        match base_inner {
          OverUnder(kind, _, None, is_over) =>
          if kind == "overbrace" || kind == "underbrace" || kind == "overbracket" || kind == "underbracket" {
            if is_over && sub_opt is None && sup_opt is Some(sn) {
              let b = mml_build_node(base_inner, ctx)
              let s = mml_build_node(sn, ctx)
              let ch : Array[MmlNode] = Array::new()
              ch.push(b)
              ch.push(s)
              return mml_elem("mover", ch)
            }
            if !is_over && sup_opt is None && sub_opt is Some(sn) {
              let b = mml_build_node(base_inner, ctx)
              let s = mml_build_node(sn, ctx)
              let ch : Array[MmlNode] = Array::new()
              ch.push(b)
              ch.push(s)
              return mml_elem("munder", ch)
            }
          }
          _ => ()
        }
        None => ()
      }
      let use_limits = match base_opt {
        Some(Op(nm, _, lim, always, _)) => lim && (ctx.display || ((nm == "\\mathop" || nm == "\\operatorname") && always))
        _ => false
      }
      let base_node = match base_opt {
        Some(b) => mml_build_node(b, MmlCtx::{ ..ctx, in_supsub_base: true })
        None => mml_elem("mrow", Array::new())
      }
      let ch : Array[MmlNode] = Array::new()
      ch.push(base_node)
      let script_ctx = MmlCtx::{ ..ctx, display: false, script_level: ctx.script_level + 1, in_supsub_base: false }
      let build_sup_node = fn(sn : MathNode) -> MmlNode {
        let built = mml_build_node(sn, script_ctx)
        match sn {
          Ord("\\prime", _) => {
            mml_set_attr(built, "lspace", "0em")
            mml_set_attr(built, "rspace", "0em")
            built
          }
          _ => built
        }
      }
      match (sub_opt, sup_opt) {
        (Some(sub_n), Some(sup_n)) => {
          ch.push(mml_build_node(sub_n, script_ctx))
          ch.push(build_sup_node(sup_n))
          mml_elem(if use_limits { "munderover" } else { "msubsup" }, ch)
        }
        (Some(sub_n), None) => {
          ch.push(mml_build_node(sub_n, script_ctx))
          mml_elem(if use_limits { "munder" } else { "msub" }, ch)
        }
        (None, Some(sup_n)) => {
          ch.push(build_sup_node(sup_n))
          mml_elem(if use_limits { "mover" } else { "msup" }, ch)
        }
        (None, None) => base_node
        _ => base_node
      }
    }
    Frac(numer, denom, has_bar, ld, rd, bar_sz, fstyle, _cont) => {
      let inner_ctx = match fstyle {
        "display" => MmlCtx::{ ..ctx, display: true }
        "text" | "script" | "scriptscript" => MmlCtx::{ ..ctx, display: false }
        _ => ctx
      }
      let fch : Array[MmlNode] = Array::new()
      fch.push(mml_build_node(numer, inner_ctx))
      fch.push(mml_build_node(denom, inner_ctx))
      let frac = mml_elem("mfrac", fch)
      if !has_bar {
        mml_set_attr(frac, "linethickness", "0px")
      } else if bar_sz.length() > 0 {
        mml_set_attr(frac, "linethickness", bar_sz)
      }
      let wrapped = if ld.length() > 0 || rd.length() > 0 {
        let items : Array[MmlNode] = Array::new()
        if ld.length() > 0 {
          let lo = mml_elem_txt("mo", mml_symbol_text(ld, false))
          mml_set_attr(lo, "fence", "true")
          items.push(lo)
        }
        items.push(frac)
        if rd.length() > 0 {
          let ro = mml_elem_txt("mo", mml_symbol_text(rd, false))
          mml_set_attr(ro, "fence", "true")
          items.push(ro)
        }
        mml_make_row(items)
      } else {
        frac
      }
      if fstyle == "display" {
        let st = mml_elem1("mstyle", wrapped)
        mml_set_attr(st, "scriptlevel", "0")
        mml_set_attr(st, "displaystyle", "true")
        st
      } else if fstyle == "text" {
        let st = mml_elem1("mstyle", wrapped)
        mml_set_attr(st, "scriptlevel", "0")
        mml_set_attr(st, "displaystyle", "false")
        st
      } else if fstyle == "script" {
        let st = mml_elem1("mstyle", wrapped)
        mml_set_attr(st, "scriptlevel", "1")
        mml_set_attr(st, "displaystyle", "false")
        st
      } else if fstyle == "scriptscript" {
        let st = mml_elem1("mstyle", wrapped)
        mml_set_attr(st, "scriptlevel", "2")
        mml_set_attr(st, "displaystyle", "false")
        st
      } else {
        wrapped
      }
    }
    Sqrt(body, idx_opt) =>
    match idx_opt {
      Some(idx) => {
        let ch : Array[MmlNode] = Array::new()
        ch.push(mml_build_node(body, ctx))
        ch.push(mml_build_node(idx, ctx))
        mml_elem("mroot", ch)
      }
      None => mml_elem1("msqrt", mml_build_node(body, ctx))
    }
    Accent(label, base, stretchy, _shifty) => {
      let acc_txt = match label {
        "\\vec" => "\u{20d7}"
        "\\widehat" => "^"
        "\\widetilde" => "~"
        "\\widecheck" => "\u{02c7}"
        "\\overrightarrow" | "\\underrightarrow" => "\u{2192}"
        "\\overleftarrow" | "\\underleftarrow" => "\u{2190}"
        "\\overleftrightarrow" | "\\underleftrightarrow" => "\u{2194}"
        "\\Overrightarrow" => "\u{21d2}"
        "\\overgroup" => "\u{23e0}"
        "\\undergroup" => "\u{23e1}"
        "\\overlinesegment" | "\\underlinesegment" => "undefined"
        "\\overleftharpoon" => "\u{21bc}"
        "\\overrightharpoon" => "\u{21c0}"
        "\\utilde" => "~"
        _ => mml_symbol_text(label, false)
      }
      let acc_mo = mml_elem_txt("mo", acc_txt)
      if stretchy {
        mml_set_attr(acc_mo, "stretchy", "true")
      }
      let is_under = label == "\\underleftarrow" || label == "\\underrightarrow" ||
      label == "\\underleftrightarrow" || label == "\\undergroup" ||
      label == "\\underlinesegment" || label == "\\utilde"
      let ch : Array[MmlNode] = Array::new()
      ch.push(mml_build_node(base, ctx))
      ch.push(acc_mo)
      if is_under {
        let mu = mml_elem("munder", ch)
        mml_set_attr(mu, "accentunder", "true")
        mu
      } else {
        let mv = mml_elem("mover", ch)
        mml_set_attr(mv, "accent", "true")
        mv
      }
    }
    OverUnder(kind, base, script_opt, is_over) => {
      let b = mml_build_expr_row(arg_to_array(base), ctx, false)
      if kind == "overline" {
        let mo = mml_elem_txt("mo", "\u{203e}")
        mml_set_attr(mo, "stretchy", "true")
        let ch : Array[MmlNode] = Array::new()
        ch.push(b)
        ch.push(mo)
        let mv = mml_elem("mover", ch)
        mml_set_attr(mv, "accent", "true")
        return mv
      }
      if kind == "underline" {
        let mo = mml_elem_txt("mo", "\u{203e}")
        mml_set_attr(mo, "stretchy", "true")
        let ch : Array[MmlNode] = Array::new()
        ch.push(b)
        ch.push(mo)
        let mu = mml_elem("munder", ch)
        mml_set_attr(mu, "accentunder", "true")
        return mu
      }
      if kind == "overbrace" || kind == "underbrace" || kind == "overbracket" || kind == "underbracket" {
        let sym = match kind {
          "overbrace" => "\u{23de}"
          "underbrace" => "\u{23df}"
          "overbracket" => "\u{23b4}"
          _ => "\u{23b5}"
        }
        let mo = mml_elem_txt("mo", sym)
        mml_set_attr(mo, "stretchy", "true")
        let ch : Array[MmlNode] = Array::new()
        ch.push(b)
        ch.push(mo)
        return mml_elem(if is_over { "mover" } else { "munder" }, ch)
      }
      let sc = match script_opt {
        Some(sn) => mml_build_expr_row(arg_to_array(sn), ctx, true)
        None => mml_elem("mrow", Array::new())
      }
      let base_mo = mml_elem1("mo", b)
      let ch : Array[MmlNode] = Array::new()
      ch.push(base_mo)
      ch.push(sc)
      let ou = mml_elem(if is_over { "mover" } else { "munder" }, ch)
      // Wrap in <mo> when base is a Rel or Bin (KaTeX binrel behavior for \overset/\underset)
      let is_rel_or_bin = match base {
        Rel(_) | Bin(_) => true
        Group(arr, _) => arr.length() == 1 && (match arr[0] { Rel(_) | Bin(_) => true; _ => false })
        _ => false
      }
      if is_rel_or_bin {
        mml_elem1("mo", ou)
      } else {
        mml_elem1("mi", ou)
      }
    }
    Delim(kind, ld, body, sz, rd) => {
      if kind == "sized" {
        let ch : Array[MmlNode] = Array::new()
        if ld != "." {
          ch.push(MmlNode::Txt(mml_symbol_text(ld, false)))
        }
        let mo = mml_elem("mo", ch)
        let is_fence = rd == "mopen" || rd == "mclose"
        mml_set_attr(mo, "fence", if is_fence { "true" } else { "false" })
        mml_set_attr(mo, "stretchy", "true")
        let sz_em = match sz {
          1 => "1.2em"
          2 => "1.8em"
          3 => "2.4em"
          _ => "3em"
        }
        mml_set_attr(mo, "minsize", sz_em)
        mml_set_attr(mo, "maxsize", sz_em)
        return mo
      }
      if kind == "middle" {
        let rep = if ld == "|" { "|" } else { mml_symbol_text(ld, false) }
        let mo = mml_elem_txt("mo", rep)
        mml_set_attr(mo, "fence", "true")
        mml_set_attr(mo, "lspace", "0.05em")
        mml_set_attr(mo, "rspace", "0.05em")
        return mo
      }
      // leftright
      let items : Array[MmlNode] = Array::new()
      if ld != "." {
        let lo = mml_elem_txt("mo", mml_symbol_text(ld, false))
        mml_set_attr(lo, "fence", "true")
        items.push(lo)
      }
      let inner = mml_build_expr(body, ctx, false)
      let mut i = 0
      while i < inner.length() {
        items.push(inner[i])
        i = i + 1
      }
      if rd != "." {
        let ro = mml_elem_txt("mo", mml_symbol_text(rd, false))
        mml_set_attr(ro, "fence", "true")
        items.push(ro)
      }
      mml_make_row(items)
    }
    Matrix(env_name, rows, col_aligns, ld, rd, is_disp) => {
      let mut max_cols = 0
      let mut r = 0
      while r < rows.length() {
        if rows[r].length() > max_cols {
          max_cols = rows[r].length()
        }
        r = r + 1
      }
      let trs : Array[MmlNode] = Array::new()
      let is_subarray = env_name == "subarray"
      let is_cd = env_name == "CD"
      let cell_ctx = MmlCtx::{
        ..ctx,
        display: is_disp,
        script_level: if is_subarray { 1 } else { 0 },
        font: "",
      }
      let is_align_env = env_name == "aligned" || env_name == "align" || env_name == "align*" ||
      env_name == "alignedat" || env_name == "alignat" || env_name == "alignat*" || env_name == "split"
      let is_gather_env = env_name == "gather" || env_name == "gather*" || env_name == "gathered"
      let is_numbered = env_name == "equation" || env_name == "align" || env_name == "alignat" || env_name == "gather"
      let all_align_opt = if col_aligns.length() == 1 && col_aligns[0].starts_with("all:") {
        Some(col_aligns[0].slice(4, col_aligns[0].length()))
      } else {
        None
      }
      r = 0
      while r < rows.length() {
        let tds : Array[MmlNode] = Array::new()
        let mut row_tag : Option[(Bool, Array[MathNode])] = None
        let mut row_notag = false
        if is_numbered {
          let glue = mml_elem("mtd", Array::new())
          mml_set_attr(glue, "class ", "mtr-glue")
          tds.push(glue)
        }
        let mut c = 0
        while c < rows[r].length() {
          let raw_cell = rows[r][c]
          let cell_nodes : Array[MathNode] = Array::new()
          let mut ni = 0
          while ni < raw_cell.length() {
            match raw_cell[ni] {
              Styled("tag:", tb) => row_tag = Some((false, tb))
              Styled("tag:*", tb) => row_tag = Some((true, tb))
              Styled("notag", _) => row_notag = true
              _ => cell_nodes.push(raw_cell[ni])
            }
            ni = ni + 1
          }
          let cell_content = if cell_nodes.length() == 0 && is_cd {
            MmlNode::Frag(Array::new())
          } else {
            let built = mml_build_expr(cell_nodes, cell_ctx, !is_align_env && !is_cd)
            // In aligned/align, odd columns (index 1, 3, ...) get a leading empty <mrow></mrow>
            if is_align_env && (c % 2 == 1) && cell_nodes.length() > 0 {
              let prep : Array[MmlNode] = Array::new()
              prep.push(mml_elem("mrow", Array::new()))
              let mut k = 0
              while k < built.length() {
                prep.push(built[k])
                k = k + 1
              }
              mml_make_row(prep)
            } else {
              mml_make_row(built)
            }
          }
          let st = mml_elem1("mstyle", cell_content)
          mml_set_attr(st, "scriptlevel", if is_subarray { "1" } else { "0" })
          mml_set_attr(st, "displaystyle", if is_disp { "true" } else { "false" })
          tds.push(mml_elem1("mtd", st))
          c = c + 1
        }
        if is_numbered {
          let glue2 = mml_elem("mtd", Array::new())
          mml_set_attr(glue2, "class ", "mtr-glue")
          tds.push(glue2)
          match row_tag {
            Some((is_star, tb)) => {
              let tnodes = mml_text_nodes(tb, ctx)
              if is_star {
                tds.push(mml_elem1("mtd", mml_make_row(tnodes)))
              } else {
                let wrapped : Array[MmlNode] = Array::new()
                wrapped.push(mml_elem_txt("mtext", "("))
                let mut k = 0
                while k < tnodes.length() {
                  wrapped.push(tnodes[k])
                  k = k + 1
                }
                wrapped.push(mml_elem_txt("mtext", ")"))
                tds.push(mml_elem1("mtd", mml_make_row(wrapped)))
              }
            }
            None =>
            if !row_notag {
              let eqn_num = mml_elem("mtd", Array::new())
              mml_set_attr(eqn_num, "class ", "mml-eqn-num")
              tds.push(eqn_num)
            }
          }
        }
        trs.push(mml_elem("mtr", tds))
        r = r + 1
      }
      if is_cd {
        trs.push(mml_elem("mtr", Array::new()))
      }
      let tbl = mml_elem("mtable", trs)
      let row_sp = if env_name == "cases" || env_name == "rcases" || env_name == "dcases" || env_name == "drcases" {
        "0.36em"
      } else if is_subarray {
        "0.1em"
      } else if is_align_env || is_gather_env || is_cd {
        "0.25em"
      } else {
        "0.16em"
      }
      mml_set_attr(tbl, "rowspacing", row_sp)
      // Build columnalign string (equation/equation* omit columnalign in KaTeX)
      if env_name != "equation" && env_name != "equation*" && max_cols > 0 {
        let align_sb = StringBuilder::new()
        let mut ci = 0
        while ci < max_cols {
          if ci > 0 {
            align_sb.write_string(" ")
          }
          let al = match all_align_opt {
            Some(a) => a
            None =>
            if ci < col_aligns.length() {
              col_aligns[ci]
            } else if is_align_env {
              if ci % 2 == 0 { "right" } else { "left" }
            } else if env_name == "cases" || env_name == "rcases" || env_name == "dcases" || env_name == "drcases" {
              "left"
            } else {
              "center"
            }
          }
          align_sb.write_string(al)
          ci = ci + 1
        }
        mml_set_attr(tbl, "columnalign", align_sb.to_string())
      }
      let col_sp = if is_cd {
        "0.5em"
      } else if env_name == "alignat" || env_name == "alignat*" || env_name == "alignedat" || is_gather_env {
        "0em"
      } else if is_align_env {
        if max_cols <= 2 {
          "0em"
        } else {
          let csb = StringBuilder::new()
          let mut ci = 0
          while ci < max_cols - 1 {
            if ci > 0 {
              csb.write_string(" ")
            }
            csb.write_string(if ci % 2 == 0 { "0em" } else { "1em" })
            ci = ci + 1
          }
          csb.to_string()
        }
      } else {
        "1em"
      }
      mml_set_attr(tbl, "columnspacing", col_sp)
      if is_subarray {
        let st = mml_elem1("mstyle", tbl)
        mml_set_attr(st, "scriptlevel", "1")
        return st
      }
      if ld.length() == 0 && rd.length() == 0 {
        return tbl
      }
      let items : Array[MmlNode] = Array::new()
      if ld.length() > 0 && ld != "." {
        let lo = mml_elem_txt("mo", mml_symbol_text(ld, false))
        mml_set_attr(lo, "fence", "true")
        items.push(lo)
      }
      items.push(tbl)
      if rd.length() > 0 && rd != "." {
        let ro = mml_elem_txt("mo", mml_symbol_text(rd, false))
        mml_set_attr(ro, "fence", "true")
        items.push(ro)
      }
      mml_make_row(items)
    }
  }
}

///| Serialize parsed AST + source TeX into exact KaTeX MathML output.
pub fn build_mathml_string(nodes : Array[MathNode], tex : String, display_mode : Bool) -> String {
  let ctx = mml_ctx_default(display_mode)
  // Check for top-level \tag{...} / \tag*{...}
  let mut top_tag : Option[(Bool, Array[MathNode])] = None
  let filtered : Array[MathNode] = Array::new()
  let mut i = 0
  while i < nodes.length() {
    match nodes[i] {
      Styled("tag:", tb) => top_tag = Some((false, tb))
      Styled("tag:*", tb) => top_tag = Some((true, tb))
      _ => filtered.push(nodes[i])
    }
    i = i + 1
  }
  let expr = mml_build_expr(filtered, ctx, false)
  let base_wrapper = if expr.length() == 1 {
    match expr[0] {
      Elem("mrow", _, _) | Elem("mtable", _, _) => expr[0]
      _ => mml_elem("mrow", expr)
    }
  } else {
    mml_elem("mrow", expr)
  }
  let wrapper = match top_tag {
    Some((is_star, tb)) => {
      let pad1 = mml_elem("mtd", Array::new())
      mml_set_attr(pad1, "width", "50%")
      let pad2 = mml_elem("mtd", Array::new())
      mml_set_attr(pad2, "width", "50%")
      let body_td = mml_elem1("mtd", base_wrapper)
      let tag_content = if is_star {
        mml_make_row(mml_text_nodes(tb, ctx))
      } else {
        let inner_nodes = mml_text_nodes(tb, ctx)
        if inner_nodes.length() == 1 {
          match inner_nodes[0] {
            Elem("mtext", _, ch) => {
              let combined : Array[MmlNode] = Array::new()
              combined.push(MmlNode::Txt("("))
              let mut k = 0
              while k < ch.length() {
                combined.push(ch[k])
                k = k + 1
              }
              combined.push(MmlNode::Txt(")"))
              mml_elem("mtext", combined)
            }
            _ => mml_elem("mrow", [mml_elem_txt("mtext", "("), inner_nodes[0], mml_elem_txt("mtext", ")")])
          }
        } else {
          mml_elem("mrow", [mml_elem_txt("mtext", "("), mml_make_row(inner_nodes), mml_elem_txt("mtext", ")")])
        }
      }
      let tag_td = mml_elem1("mtd", tag_content)
      let tr = mml_elem("mtr", [pad1, body_td, pad2, tag_td])
      let tbl = mml_elem1("mtable", tr)
      mml_set_attr(tbl, "width", "100%")
      tbl
    }
    None => base_wrapper
  }
  let ann = mml_elem_txt("annotation", tex)
  mml_set_attr(ann, "encoding", "application/x-tex")
  let sem_ch : Array[MmlNode] = Array::new()
  sem_ch.push(wrapper)
  sem_ch.push(ann)
  let sem = mml_elem("semantics", sem_ch)
  let math = mml_elem1("math", sem)
  mml_set_attr(math, "xmlns", "http://www.w3.org/1998/Math/MathML")
  if display_mode {
    mml_set_attr(math, "display", "block")
  }
  let sb = StringBuilder::new()
  sb.write_string("<span class=\"katex\">")
  render_mml_into(sb, math)
  sb.write_string("</span>")
  sb.to_string()
}
