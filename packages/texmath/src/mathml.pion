///| Exact KaTeX MathML serializer (zero-intermediate-DOM direct StringBuilder writer).

///|
val struct MmlCtx {
  display : Bool
  script_level : Int
  font : String
  color : String
  text_family : String
  text_weight : String
  text_shape : String
  in_supsub_base : Bool
}

///|
fn mml_ctx_default(display : Bool) -> MmlCtx {
  MmlCtx::{
    display,
    script_level: 0,
    font: "",
    color: "",
    text_family: "",
    text_weight: "",
    text_shape: "",
    in_supsub_base: false,
  }
}

///| Fast XML text escaping into StringBuilder (single write_string on clean spans).
fn escape_xml_into(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n == 0 {
    return
  }
  if n == 1 {
    let b = s[0]
    if b != 38 && b != 60 && b != 62 && b != 34 && b != 39 {
      sb.write_string(s)
      return
    }
  }
  let mut i = 0
  let mut last = 0
  while i < n {
    let b = s[i]
    if b == 38 || b == 60 || b == 62 || b == 34 || b == 39 {
      if i > last {
        sb.write_string(s.slice(last, i))
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else if b == 60 {
        sb.write_string("&lt;")
      } else if b == 62 {
        sb.write_string("&gt;")
      } else if b == 34 {
        sb.write_string("&quot;")
      } else {
        sb.write_string("&#x27;")
      }
      last = i + 1
    }
    i = i + 1
  }
  if last == 0 {
    sb.write_string(s)
  } else if last < n {
    sb.write_string(s.slice(last, n))
  }
}

///|
fn write_attr(sb : StringBuilder, k : String, v : String) -> Unit {
  sb.write_string(" ")
  sb.write_string(k)
  sb.write_string("=\"")
  escape_xml_into(sb, v)
  sb.write_string("\"")
}

///| Format a non-negative integer Double (>= 0) as decimal digits without 32-bit overflow.
fn write_whole_double(sb : StringBuilder, v : Double) -> Unit {
  if v < 1.0 {
    sb.write_string("0")
    return
  }
  if v < 2000000000.0 {
    sb.write_string(v.to_int().to_string())
    return
  }
  let digits : Array[Int] = Array::new()
  let mut cur = v
  while cur >= 1.0 {
    let q = (cur / 10.0).floor()
    let rem = (cur - q * 10.0 + 0.0001).to_int()
    let d = if rem < 0 { 0 } else if rem > 9 { 9 } else { rem }
    digits.push(d)
    cur = q
  }
  let mut i = digits.length() - 1
  while i >= 0 {
    sb.write_byte((48 + digits[i]).to_byte())
    i = i - 1
  }
}

///| Format em value directly into a StringBuilder matching KaTeX `makeEm`.
fn write_em_into(sb : StringBuilder, v : Double) -> Unit {
  let neg = v < 0.0
  let av = if neg { -v } else { v }
  let whole_d = av.floor()
  let frac_scaled = ((av - whole_d) * 10000.0 + 0.5).to_int()
  let mut whole_out = whole_d
  let mut frac = frac_scaled
  if frac >= 10000 {
    whole_out = whole_out + 1.0
    frac = frac - 10000
  }
  if neg && (whole_out >= 1.0 || frac > 0) {
    sb.write_string("-")
  }
  write_whole_double(sb, whole_out)
  if frac > 0 {
    sb.write_string(".")
    let d1 = frac / 1000
    let d2 = (frac / 100) % 10
    let d3 = (frac / 10) % 10
    let d4 = frac % 10
    sb.write_byte((48 + d1).to_byte())
    if d2 != 0 || d3 != 0 || d4 != 0 {
      sb.write_byte((48 + d2).to_byte())
      if d3 != 0 || d4 != 0 {
        sb.write_byte((48 + d3).to_byte())
        if d4 != 0 {
          sb.write_byte((48 + d4).to_byte())
        }
      }
    }
  }
  sb.write_string("em")
}

///| Format em value cleanly matching KaTeX `makeEm` (up to 4 decimal places, stripped trailing zeros).
fn format_em(v : Double) -> String {
  let sb = StringBuilder::with_capacity(16)
  write_em_into(sb, v)
  sb.to_string()
}

///|
fn is_digit_str(s : String) -> Bool {
  s.length() == 1 && s[0] >= 48 && s[0] <= 57
}

///|
fn mml_symbol_text(name : String, is_text : Bool) -> String {
  let n = name.length()
  if n == 1 {
    let b = name[0]
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) {
      return name
    }
    if is_text {
      if b == 32 {
        return "\u{00a0}"
      }
      if b == 39 {
        return "\u{2019}"
      }
      if b == 96 {
        return "\u{2018}"
      }
      return name
    } else {
      if b == 45 {
        return "\u{2212}"
      }
      if b == 42 {
        return "\u{2217}"
      }
      if b == 96 {
        return "\u{2018}"
      }
      if b == 124 {
        return "\u{2223}"
      }
      return name
    }
  }
  // Preserve Unicode Mathematical Alphanumeric Symbols (U+1D400..U+1D7FF) in both math and text modes
  if n == 4 && name[0] == 0xF0 && name[1] == 0x9D {
    let cp = first_codepoint(name)
    if cp >= 0x1D400 && cp <= 0x1D7FF {
      return name
    }
  }
  if is_text {
    match lookup_text_symbol(name) {
      Some(info) => if info.replace.length() > 0 { info.replace } else { name }
      None => name
    }
  } else {
    match lookup_math_symbol(name) {
      Some(info) => if info.replace.length() > 0 { info.replace } else { name }
      None => name
    }
  }
}

///|
fn mml_math_variant(ctx : MmlCtx, is_textord : Bool) -> String {
  if ctx.font.length() == 0 {
    return ""
  }
  match ctx.font {
    "mathrm" => "normal"
    "mathit" => "italic"
    "mathbf" => "bold"
    "mathbb" => "double-struck"
    "mathcal" | "mathscr" => "script"
    "mathfrak" => "fraktur"
    "mathsf" => "sans-serif"
    "mathsfit" => "sans-serif-italic"
    "mathtt" => "monospace"
    "boldsymbol" => if is_textord { "bold" } else { "bold-italic" }
    _ => ""
  }
}

///|
fn mml_text_variant(ctx : MmlCtx) -> String {
  if ctx.text_family.length() == 0 && ctx.text_weight.length() == 0 && ctx.text_shape.length() == 0 {
    return ""
  }
  if ctx.text_family == "texttt" {
    "monospace"
  } else if ctx.text_family == "textsf" {
    if ctx.text_shape == "textit" && ctx.text_weight == "textbf" {
      "sans-serif-bold-italic"
    } else if ctx.text_shape == "textit" {
      "sans-serif-italic"
    } else if ctx.text_weight == "textbf" {
      "bold-sans-serif"
    } else {
      "sans-serif"
    }
  } else if ctx.text_shape == "textit" && ctx.text_weight == "textbf" {
    "bold-italic"
  } else if ctx.text_shape == "textit" {
    "italic"
  } else if ctx.text_weight == "textbf" {
    "bold"
  } else {
    ""
  }
}

///| Decompose common precomposed accented Latin characters into (base, accent) for KaTeX text MathML.
fn decompose_text_accent(ch : String) -> Option[(String, String)] {
  if ch.length() <= 1 {
    return None
  }
  match ch {
    "é" => Some(("e", "\u{02ca}"))
    "è" => Some(("e", "\u{02cb}"))
    "ê" => Some(("e", "\u{02c6}"))
    "ë" => Some(("e", "\u{00a8}"))
    "á" => Some(("a", "\u{02ca}"))
    "à" => Some(("a", "\u{02cb}"))
    "â" => Some(("a", "\u{02c6}"))
    "ä" => Some(("a", "\u{00a8}"))
    "ã" => Some(("a", "\u{02dc}"))
    "å" => Some(("a", "\u{02da}"))
    "í" => Some(("\u{0131}", "\u{02ca}"))
    "ì" => Some(("\u{0131}", "\u{02cb}"))
    "î" => Some(("\u{0131}", "\u{02c6}"))
    "ï" => Some(("\u{0131}", "\u{00a8}"))
    "ó" => Some(("o", "\u{02ca}"))
    "ò" => Some(("o", "\u{02cb}"))
    "ô" => Some(("o", "\u{02c6}"))
    "ö" => Some(("o", "\u{00a8}"))
    "õ" => Some(("o", "\u{02dc}"))
    "ú" => Some(("u", "\u{02ca}"))
    "ù" => Some(("u", "\u{02cb}"))
    "û" => Some(("u", "\u{02c6}"))
    "ü" => Some(("u", "\u{00a8}"))
    "ñ" => Some(("n", "\u{02dc}"))
    "ý" => Some(("y", "\u{02ca}"))
    "ÿ" => Some(("y", "\u{00a8}"))
    "É" => Some(("E", "\u{02ca}"))
    "È" => Some(("E", "\u{02cb}"))
    "Ê" => Some(("E", "\u{02c6}"))
    "Ë" => Some(("E", "\u{00a8}"))
    "Á" => Some(("A", "\u{02ca}"))
    "À" => Some(("A", "\u{02cb}"))
    "Â" => Some(("A", "\u{02c6}"))
    "Ä" => Some(("A", "\u{00a8}"))
    "Ã" => Some(("A", "\u{02dc}"))
    "Å" => Some(("A", "\u{02da}"))
    "Í" => Some(("I", "\u{02ca}"))
    "Ì" => Some(("I", "\u{02cb}"))
    "Î" => Some(("I", "\u{02c6}"))
    "Ï" => Some(("I", "\u{00a8}"))
    "İ" => Some(("I", "\u{02d9}"))
    "Ó" => Some(("O", "\u{02ca}"))
    "Ò" => Some(("O", "\u{02cb}"))
    "Ô" => Some(("O", "\u{02c6}"))
    "Ö" => Some(("O", "\u{00a8}"))
    "Õ" => Some(("O", "\u{02dc}"))
    "Ú" => Some(("U", "\u{02ca}"))
    "Ù" => Some(("U", "\u{02cb}"))
    "Û" => Some(("U", "\u{02c6}"))
    "Ü" => Some(("U", "\u{00a8}"))
    "Ñ" => Some(("N", "\u{02dc}"))
    "Ç" => Some(("C", "\u{00b8}"))
    "ç" => Some(("c", "\u{00b8}"))
    _ => None
  }
}

///| Map TeX text accent command to KaTeX MathML accent glyph.
fn text_accent_glyph(cmd : String) -> String {
  match cmd {
    "\\'" => "\u{02ca}"
    "\\`" => "\u{02cb}"
    "\\^" => "\u{005e}"
    "\\\"" => "\u{00a8}"
    "\\~" => "\u{02dc}"
    "\\=" => "\u{00af}"
    "\\." => "\u{02d9}"
    "\\u" => "\u{02d8}"
    "\\v" => "\u{02c7}"
    "\\H" => "\u{02dd}"
    "\\r" => "\u{02da}"
    _ => cmd
  }
}

///|
fn combining_diacritic_glyph(nt : String) -> String {
  if nt.length() != 2 || nt[0] != 0xCC {
    return ""
  }
  match nt {
    "\u{0300}" => "\u{02cb}"
    "\u{0301}" => "\u{02ca}"
    "\u{0302}" => "\u{02c6}"
    "\u{0303}" => "\u{02dc}"
    "\u{0304}" => "\u{00af}"
    "\u{0306}" => "\u{02d8}"
    "\u{0307}" => "\u{02d9}"
    "\u{0308}" => "\u{00a8}"
    "\u{030a}" => "\u{02da}"
    "\u{030b}" => "\u{02dd}"
    "\u{030c}" => "\u{02c7}"
    _ => ""
  }
}

///| Check if a MathNode produces a plain `<mn>` (returning its text and mathvariant).
fn node_as_mn(node : MathNode, ctx : MmlCtx) -> Option[(String, String)] {
  match node {
    Ord(text, _) => {
      if text == "\\not" || text == "\\prime" {
        return None
      }
      let rep = mml_symbol_text(text, false)
      if is_digit_str(rep) {
        let v = mml_math_variant(ctx, true)
        let eff_v = if v.length() > 0 && v != "normal" { v } else { "" }
        return Some((rep, eff_v))
      }
      None
    }
    Group(body, _) =>
    if body.length() == 1 {
      node_as_mn(body[0], ctx)
    } else {
      None
    }
    _ => None
  }
}

///| Check if a MathNode produces `<mi>.</mi>` or `{,}` (mergeable numeric punctuation).
fn node_as_num_punct(node : MathNode, ctx : MmlCtx) -> Option[String] {
  match node {
    Ord(text, _) => {
      if text == "." {
        // `<mi>.</mi>` (no mathvariant if font is empty/italic/normal? Wait: check Ord(".") logic)
        let v = mml_math_variant(ctx, true)
        // Note: in original is_num_punct, it only checks tag == "mi" && ch == ["."], ignoring attrs!
        let _ = v
        return Some(".")
      }
      None
    }
    Group(body, is_ord) => {
      if is_ord && body.length() == 1 {
        match body[0] {
          Punct(",") => return Some(",")
          _ => return node_as_num_punct(body[0], ctx)
        }
      }
      if body.length() == 1 {
        return node_as_num_punct(body[0], ctx)
      }
      None
    }
    _ => None
  }
}

///| Check if a MathNode is a simple `<msup>` or `<msub>` with an `<mn>` base (Rule 5).
fn node_as_mn_script(node : MathNode, ctx : MmlCtx) -> Option[(Bool, String, MathNode)] {
  match node {
    SupSub(Some(base_inner), sub_opt, sup_opt) => {
      // Only msup or msub (not msubsup, not overbrace/underbrace, not limits)
      match (sub_opt, sup_opt) {
        (None, Some(sup_n)) =>
        match node_as_mn(base_inner, MmlCtx::{ ..ctx, in_supsub_base: true }) {
          Some((dtxt, _)) => Some((true, dtxt, sup_n))
          None => None
        }
        (Some(sub_n), None) =>
        match node_as_mn(base_inner, MmlCtx::{ ..ctx, in_supsub_base: true }) {
          Some((dtxt, _)) => Some((false, dtxt, sub_n))
          None => None
        }
        _ => None
      }
    }
    _ => None
  }
}

///| Write `<mn>` or `<msup>/<msub>` for a number run starting at `nodes[start]`, returning next index.
///| Returns `0` if `nodes[start]` does NOT start a merged number run (caller handles single node).
fn try_write_number_run(
  sb : StringBuilder,
  nodes : Array[MathNode],
  start : Int,
  ctx : MmlCtx,
  dry_run : Bool,
) -> Int {
  let n = nodes.length()
  if start + 1 >= n {
    return 0
  }
  let mut first_is_mn = false
  let mut mn_variant = ""
  let mut first_txt = ""
  match node_as_mn(nodes[start], ctx) {
    Some((t, v)) => {
      first_is_mn = true
      mn_variant = v
      first_txt = t
    }
    None =>
    match node_as_num_punct(nodes[start], ctx) {
      Some(t) => first_txt = t
      None => return 0
    }
  }
  // Look ahead: if we started with num_punct, the very next node MUST be mn or mn_script
  if !first_is_mn {
    let next_ok = node_as_mn(nodes[start + 1], ctx) is Some(_) ||
    node_as_mn_script(nodes[start + 1], ctx) is Some(_)
    if !next_ok {
      return 0
    }
  }
  // Scan consecutive mn / num_punct
  let mut cur_is_mn = first_is_mn
  let mut cur_variant = mn_variant
  let mut j = start + 1
  while j < n {
    if cur_is_mn {
      match node_as_mn(nodes[j], ctx) {
        Some((_, v)) =>
        if v == cur_variant {
          j = j + 1
          continue
        } else {
          break
        }
        None => ()
      }
      if node_as_num_punct(nodes[j], ctx) is Some(_) {
        j = j + 1
        continue
      }
      break
    } else {
      // Currently only saw num_punct at start
      if node_as_mn(nodes[j], ctx) is Some(_) {
        cur_is_mn = true
        cur_variant = "" // Rule 4 drops attrs on newly created <mn>
        j = j + 1
        continue
      }
      break
    }
  }
  // Check trailing msup/msub with mn base (Rule 5)
  let mut trail_script : Option[(Bool, String, MathNode)] = None
  if j < n {
    match node_as_mn_script(nodes[j], ctx) {
      Some(sc) => {
        trail_script = Some(sc)
        j = j + 1
      }
      None => ()
    }
  }
  // Did we merge at least 2 nodes?
  if j <= start + 1 {
    return 0
  }
  if dry_run {
    return j
  }
  match trail_script {
    Some((is_sup, base_txt, script_node)) => {
      sb.write_string(if is_sup { "<msup><mn>" } else { "<msub><mn>" })
      escape_xml_into(sb, first_txt)
      let mut k = start + 1
      while k < j - 1 {
        match node_as_mn(nodes[k], ctx) {
          Some((t, _)) => escape_xml_into(sb, t)
          None =>
          match node_as_num_punct(nodes[k], ctx) {
            Some(t) => escape_xml_into(sb, t)
            None => ()
          }
        }
        k = k + 1
      }
      escape_xml_into(sb, base_txt)
      sb.write_string("</mn>")
      let script_ctx = MmlCtx::{ ..ctx, display: false, script_level: ctx.script_level + 1, in_supsub_base: false }
      if is_sup {
        mml_write_sup_node(sb, script_node, script_ctx)
        sb.write_string("</msup>")
      } else {
        mml_write_node(sb, script_node, script_ctx, false)
        sb.write_string("</msub>")
      }
    }
    None => {
      sb.write_string("<mn")
      if cur_variant.length() > 0 {
        write_attr(sb, "mathvariant", cur_variant)
      }
      sb.write_string(">")
      escape_xml_into(sb, first_txt)
      let mut k = start + 1
      while k < j {
        match node_as_mn(nodes[k], ctx) {
          Some((t, _)) => escape_xml_into(sb, t)
          None =>
          match node_as_num_punct(nodes[k], ctx) {
            Some(t) => escape_xml_into(sb, t)
            None => ()
          }
        }
        k = k + 1
      }
      sb.write_string("</mn>")
    }
  }
  j
}

///| Insert `\u{0338}` after the first UTF-8 character of `s` and write XML-escaped into `sb`.
fn write_not_combined(sb : StringBuilder, s : String) -> Unit {
  if s.length() == 0 {
    return
  }
  let clen = utf8_char_len(s[0])
  let split_at = if clen <= s.length() { clen } else { s.length() }
  escape_xml_into(sb, s.slice(0, split_at))
  sb.write_string("\u{0338}")
  if split_at < s.length() {
    escape_xml_into(sb, s.slice(split_at, s.length()))
  }
}

///| Try to emit `\not` combined with `next_node` (Rule 6). Returns true if combined.
fn try_write_not_combined(sb : StringBuilder, next_node : MathNode, ctx : MmlCtx, dry_run : Bool) -> Bool {
  match next_node {
    Ord(text, fam) => {
      if text == "\\not" || text == "\\prime" {
        return false
      }
      let rep = mml_symbol_text(text, false)
      if rep.length() == 0 {
        return false
      }
      if dry_run {
        return true
      }
      if is_digit_str(rep) {
        let v = mml_math_variant(ctx, true)
        sb.write_string("<mn")
        if v.length() > 0 && v != "normal" {
          write_attr(sb, "mathvariant", v)
        }
        sb.write_string(">")
        write_not_combined(sb, rep)
        sb.write_string("</mn>")
        return true
      }
      let is_textord = fam == "textord"
      let cp = first_codepoint(rep)
      let is_lower_greek = (cp >= 0x03B1 && cp <= 0x03C9) || cp == 0x03F5 || cp == 0x03D1 || cp == 0x03F0 || cp == 0x03D5 || cp == 0x03F1 || cp == 0x03D6
      let v = mml_math_variant(ctx, is_textord)
      sb.write_string("<mi")
      if v.length() > 0 {
        if v != "italic" && !(v == "normal" && is_lower_greek) {
          write_attr(sb, "mathvariant", v)
        }
      } else if is_textord && rep != "." {
        sb.write_string(" mathvariant=\"normal\"")
      }
      sb.write_string(">")
      write_not_combined(sb, rep)
      sb.write_string("</mi>")
      true
    }
    Bin(text) | Rel(text) | Inner(text) => {
      let rep = mml_symbol_text(text, false)
      if rep.length() == 0 {
        return false
      }
      if dry_run {
        return true
      }
      sb.write_string("<mo")
      if ctx.font == "boldsymbol" {
        sb.write_string(" mathvariant=\"bold-italic\"")
      }
      sb.write_string(">")
      write_not_combined(sb, rep)
      sb.write_string("</mo>")
      true
    }
    Open(text) | Close(text) => {
      let rep = mml_symbol_text(text, false)
      if rep.length() == 0 {
        return false
      }
      if dry_run {
        return true
      }
      sb.write_string("<mo stretchy=\"false\">")
      write_not_combined(sb, rep)
      sb.write_string("</mo>")
      true
    }
    Punct(text) => {
      let rep = mml_symbol_text(text, false)
      if rep.length() == 0 {
        return false
      }
      if dry_run {
        return true
      }
      sb.write_string("<mo separator=\"true\">")
      write_not_combined(sb, rep)
      sb.write_string("</mo>")
      true
    }
    Styled(st, _) => {
      if st.starts_with("op_normal:") {
        let sym = st.slice(10, st.length())
        if sym.length() == 0 {
          return false
        }
        if dry_run {
          return true
        }
        sb.write_string("<mo mathvariant=\"normal\">")
        write_not_combined(sb, sym)
        sb.write_string("</mo>")
        return true
      }
      false
    }
    _ => false
  }
}

///| Determine if `nodes` (when len >= 2) collapses to a single MathML element (no `<mrow>` needed).
fn mml_expr_is_single(nodes : Array[MathNode], ctx : MmlCtx) -> Bool {
  let n = nodes.length()
  if n == 1 {
    return true
  }
  if n == 0 {
    return false
  }
  let dummy = StringBuilder::with_capacity(0)
  // Case 1: entire list is a single merged number run
  let end_num = try_write_number_run(dummy, nodes, 0, ctx, true)
  if end_num == n {
    return true
  }
  // Case 2: `\not` + single combinable node
  if n == 2 {
    match nodes[0] {
      Ord("\\not", _) =>
      if try_write_not_combined(dummy, nodes[1], ctx, true) {
        return true
      }
      _ => ()
    }
  }
  false
}

///| Write a list of MathNodes into `sb` with KaTeX's adjacent merging rules.
fn mml_write_expr(sb : StringBuilder, nodes : Array[MathNode], ctx : MmlCtx, is_ordgroup : Bool) -> Unit {
  let n = nodes.length()
  if n == 0 {
    return
  }
  if n == 1 {
    mml_write_node(sb, nodes[0], ctx, is_ordgroup)
    return
  }
  let mut i = 0
  while i < n {
    // Context-sensitive \dots and \@cdots
    match nodes[i] {
      Inner("\\dots") => {
        let mut sym = "\u{2026}"
        let mut lead_neg_thin = false
        if i + 1 < n {
          match nodes[i + 1] {
            Bin(_) | Rel(_) => sym = "\u{22ef}"
            Op(_, _, _, _, _) => {
              sym = "\u{22ef}"
              lead_neg_thin = true
            }
            _ => ()
          }
        }
        if lead_neg_thin {
          sb.write_string("<mtext>\u{2009}\u{2063}</mtext><mo>")
          sb.write_string(sym)
          sb.write_string("</mo>")
        } else {
          sb.write_string("<mo>")
          sb.write_string(sym)
          sb.write_string("</mo>")
        }
        i = i + 1
        continue
      }
      Inner("\\@cdots") =>
      if i + 1 < n {
        match nodes[i + 1] {
          Punct(_) | Close(_) => {
            sb.write_string("<mo>\u{22ef}</mo><mtext>\u{2009}</mtext>")
            i = i + 1
            continue
          }
          _ => ()
        }
      }
      Ord("\\not", _) =>
      if i + 1 < n && try_write_not_combined(sb, nodes[i + 1], ctx, false) {
        i = i + 2
        continue
      }
      _ => ()
    }
    // Check merged number run (Rules 2, 3, 4, 5)
    let next_i = try_write_number_run(sb, nodes, i, ctx, false)
    if next_i > 0 {
      i = next_i
      continue
    }
    mml_write_node(sb, nodes[i], ctx, false)
    i = i + 1
  }
}

///| Write `nodes` wrapped in `<mrow>...</mrow>` unless it produces a single element.
fn mml_write_expr_row(sb : StringBuilder, nodes : Array[MathNode], ctx : MmlCtx, is_ordgroup : Bool) -> Unit {
  let n = nodes.length()
  if n == 0 {
    sb.write_string("<mrow></mrow>")
    return
  }
  if n == 1 {
    mml_write_node(sb, nodes[0], ctx, is_ordgroup)
    return
  }
  if mml_expr_is_single(nodes, ctx) {
    mml_write_expr(sb, nodes, ctx, is_ordgroup)
  } else {
    sb.write_string("<mrow>")
    mml_write_expr(sb, nodes, ctx, is_ordgroup)
    sb.write_string("</mrow>")
  }
}

///|
fn mml_write_space(sb : StringBuilder, cmd : String, width_em : Double, ctx : MmlCtx) -> Unit {
  if cmd == "\\\\" || cmd == "\\newline" || cmd == "\\cr" {
    sb.write_string("<mspace linebreak=\"newline\"")
    if width_em != 0.0 {
      sb.write_string(" height=\"")
      write_em_into(sb, width_em)
      sb.write_string("\"")
    }
    sb.write_string("></mspace>")
    return
  }
  if ctx.script_level > 0 {
    let gm = get_global_metrics(if ctx.script_level == 1 { 1 } else { 2 })
    let mu_scale = gm.css_em_per_mu * 18.0
    match cmd {
      "\\," | "\\thinspace" | "\\:" | "\\>" | "\\medspace" | "\\;" | "\\thickspace" |
      "\\!" | "\\negthinspace" | "\\negmedspace" | "\\negthickspace" | "\\mkern" | "\\mskip" => {
        sb.write_string("<mspace width=\"")
        write_em_into(sb, width_em * mu_scale)
        sb.write_string("\"/>")
        return
      }
      _ => ()
    }
  }
  match cmd {
    "\\," | "\\thinspace" => sb.write_string("<mtext>\u{2009}</mtext>")
    "\\:" | "\\>" | "\\medspace" => sb.write_string("<mtext>\u{2005}</mtext>")
    "\\;" | "\\thickspace" => sb.write_string("<mtext>\u{2005}\u{200a}</mtext>")
    "\\!" | "\\negthinspace" => sb.write_string("<mtext>\u{2009}\u{2063}</mtext>")
    "\\ " | "~" | "\\nobreakspace" => sb.write_string("<mtext>\u{00a0}</mtext>")
    "\\mkern" =>
    if math_abs(width_em - 1.0 / 18.0) < 0.001 {
      sb.write_string("<mtext>\u{200a}</mtext>")
    } else {
      sb.write_string("<mspace width=\"")
      write_em_into(sb, width_em)
      sb.write_string("\"/>")
    }
    _ => {
      sb.write_string("<mspace width=\"")
      write_em_into(sb, width_em)
      sb.write_string("\"/>")
    }
  }
}

///| Text-mode streaming state for coalescing adjacent `<mtext>` elements with same `mathvariant`.
struct TextEmitState {
  mut open_mtext : Bool
  mut open_variant : String
  mut item_count : Int
}

///|
fn text_emit_close(sb : StringBuilder, st : TextEmitState) -> Unit {
  if st.open_mtext {
    sb.write_string("</mtext>")
    st.open_mtext = false
    st.open_variant = ""
  }
}

///|
fn text_emit_str(sb : StringBuilder, st : TextEmitState, txt : String, variant : String) -> Unit {
  if st.open_mtext && st.open_variant == variant {
    escape_xml_into(sb, txt)
    return
  }
  text_emit_close(sb, st)
  sb.write_string("<mtext")
  if variant.length() > 0 {
    write_attr(sb, "mathvariant", variant)
  }
  sb.write_string(">")
  escape_xml_into(sb, txt)
  st.open_mtext = true
  st.open_variant = variant
  st.item_count = st.item_count + 1
}

///|
fn text_emit_nodes(sb : StringBuilder, st : TextEmitState, nodes : Array[MathNode], ctx : MmlCtx) -> Unit {
  let n = nodes.length()
  let mut i = 0
  while i < n {
    match nodes[i] {
      Ord(t, _) => {
        let mut combined_acc = ""
        if i + 1 < n {
          match nodes[i + 1] {
            Ord(nt, _) => combined_acc = combining_diacritic_glyph(nt)
            _ => ()
          }
        }
        if combined_acc.length() > 0 {
          text_emit_close(sb, st)
          let v = mml_text_variant(ctx)
          sb.write_string("<mover accent=\"true\"><mtext")
          if v.length() > 0 {
            write_attr(sb, "mathvariant", v)
          }
          sb.write_string(">")
          escape_xml_into(sb, mml_symbol_text(t, true))
          sb.write_string("</mtext><mo>")
          sb.write_string(combined_acc)
          sb.write_string("</mo></mover>")
          st.item_count = st.item_count + 1
          i = i + 2
          continue
        }
        match decompose_text_accent(t) {
          Some((base_ch, acc_ch)) => {
            text_emit_close(sb, st)
            let v = mml_text_variant(ctx)
            sb.write_string("<mover accent=\"true\"><mtext")
            if v.length() > 0 {
              write_attr(sb, "mathvariant", v)
            }
            sb.write_string(">")
            escape_xml_into(sb, base_ch)
            sb.write_string("</mtext><mo>")
            sb.write_string(acc_ch)
            sb.write_string("</mo></mover>")
            st.item_count = st.item_count + 1
          }
          None => {
            let txt = mml_symbol_text(t, true)
            let v = if t != " " { mml_text_variant(ctx) } else { "" }
            text_emit_str(sb, st, txt, v)
          }
        }
      }
      Group(body, _) => text_emit_nodes(sb, st, body, ctx)
      Accent(label, base, _, _) =>
      if label.starts_with("text:") {
        text_emit_close(sb, st)
        let cmd = label.slice(5, label.length())
        let acc_ch = text_accent_glyph(cmd)
        sb.write_string("<mover accent=\"true\">")
        mml_write_text_row(sb, arg_to_array(base), ctx)
        sb.write_string("<mo>")
        escape_xml_into(sb, acc_ch)
        sb.write_string("</mo></mover>")
        st.item_count = st.item_count + 1
      } else {
        text_emit_close(sb, st)
        mml_write_node(sb, nodes[i], ctx, false)
        st.item_count = st.item_count + 1
      }
      Text(ts, body) => {
        let nctx = match ts {
          "textbf" => MmlCtx::{ ..ctx, text_weight: "textbf" }
          "textit" => MmlCtx::{ ..ctx, text_shape: "textit" }
          "emph" => MmlCtx::{ ..ctx, text_shape: if ctx.text_shape == "textit" { "" } else { "textit" } }
          "textsf" => MmlCtx::{ ..ctx, text_family: "textsf" }
          "texttt" => MmlCtx::{ ..ctx, text_family: "texttt" }
          "textrm" => MmlCtx::{ ..ctx, text_family: "textrm", text_weight: "", text_shape: "" }
          "textnormal" => MmlCtx::{ ..ctx, text_family: "", text_weight: "", text_shape: "" }
          "textup" => MmlCtx::{ ..ctx, text_shape: "" }
          "textmd" => MmlCtx::{ ..ctx, text_weight: "" }
          _ => ctx
        }
        text_emit_nodes(sb, st, body, nctx)
      }
      Styled(ts, body) =>
      if ts == "math" {
        text_emit_close(sb, st)
        let mctx = MmlCtx::{ ..ctx, display: false, script_level: 0, font: "" }
        sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"false\">")
        mml_write_expr(sb, body, mctx, false)
        sb.write_string("</mstyle>")
        st.item_count = st.item_count + 1
      } else if ts.starts_with("enclose:") {
        text_emit_close(sb, st)
        mml_write_node(sb, nodes[i], ctx, false)
        st.item_count = st.item_count + 1
      } else if ts.starts_with("size:") {
        text_emit_close(sb, st)
        let sz_name = ts.slice(5, ts.length())
        let sz_em = size_name_to_em(sz_name)
        sb.write_string("<mstyle mathsize=\"")
        sb.write_string(sz_em)
        sb.write_string("\">")
        let inner_st = TextEmitState::{ open_mtext: false, open_variant: "", item_count: 0 }
        text_emit_nodes(sb, inner_st, body, ctx)
        text_emit_close(sb, inner_st)
        sb.write_string("</mstyle>")
        st.item_count = st.item_count + 1
      } else {
        text_emit_nodes(sb, st, body, ctx)
      }
      _ => {
        text_emit_close(sb, st)
        mml_write_node(sb, nodes[i], ctx, false)
        st.item_count = st.item_count + 1
      }
    }
    i = i + 1
  }
}

///| Fast check: are all text nodes simple plain ASCII/non-accented Ord chars with the same variant?
fn text_is_single_plain_mtext(nodes : Array[MathNode], ctx : MmlCtx) -> Bool {
  let n = nodes.length()
  if n == 0 {
    return false
  }
  let v = mml_text_variant(ctx)
  let mut i = 0
  while i < n {
    match nodes[i] {
      Ord(t, _) => {
        if t.length() > 1 {
          return false
        }
        if t == " " && v.length() > 0 {
          return false
        }
      }
      _ => return false
    }
    i = i + 1
  }
  true
}

///| Write text-mode nodes wrapped in `<mrow>` iff item_count != 1.
fn mml_write_text_row(sb : StringBuilder, nodes : Array[MathNode], ctx : MmlCtx) -> Unit {
  // Fast zero-alloc path for plain ASCII text (95% of \text{...})
  if text_is_single_plain_mtext(nodes, ctx) {
    let v = mml_text_variant(ctx)
    sb.write_string("<mtext")
    if v.length() > 0 {
      write_attr(sb, "mathvariant", v)
    }
    sb.write_string(">")
    let mut i = 0
    while i < nodes.length() {
      match nodes[i] {
        Ord(t, _) => escape_xml_into(sb, mml_symbol_text(t, true))
        _ => ()
      }
      i = i + 1
    }
    sb.write_string("</mtext>")
    return
  }
  let tmp = StringBuilder::with_capacity(64)
  let st = TextEmitState::{ open_mtext: false, open_variant: "", item_count: 0 }
  text_emit_nodes(tmp, st, nodes, ctx)
  text_emit_close(tmp, st)
  if st.item_count == 1 {
    sb.write_string(tmp.to_string())
  } else {
    sb.write_string("<mrow>")
    sb.write_string(tmp.to_string())
    sb.write_string("</mrow>")
  }
}

///|
fn size_name_to_em(sz_name : String) -> String {
  match sz_name {
    "tiny" => "0.5em"
    "scriptsize" => "0.7em"
    "footnotesize" => "0.8em"
    "small" => "0.9em"
    "normalsize" => "1em"
    "large" => "1.2em"
    "Large" => "1.44em"
    "LARGE" => "1.728em"
    "huge" => "2.074em"
    "Huge" => "2.488em"
    _ => "1em"
  }
}

///| Write KaTeX MathML for \bra, \ket, \braket, \set, \Bra, \Ket, \Braket, \Set.
fn mml_write_braket(sb : StringBuilder, kind : String, body : Array[MathNode], ctx : MmlCtx) -> Unit {
  let is_large = kind == "Bra" || kind == "Ket" || kind == "Braket" || kind == "Set"
  let is_set = kind == "set" || kind == "Set"
  let open_sym = if kind == "ket" || kind == "Ket" {
    "\u{2223}"
  } else if is_set {
    "{"
  } else {
    "\u{27e8}"
  }
  let close_sym = if kind == "bra" || kind == "Bra" {
    "\u{2223}"
  } else if is_set {
    "}"
  } else {
    "\u{27e9}"
  }
  if !is_large && !is_set {
    sb.write_string("<mpadded>")
    if kind == "ket" {
      sb.write_string("<mi mathvariant=\"normal\">\u{2223}</mi>")
    } else {
      sb.write_string("<mo stretchy=\"false\">\u{27e8}</mo>")
    }
    if body.length() != 1 {
      sb.write_string("<mrow>")
    }
    let mut i = 0
    while i < body.length() {
      match body[i] {
        Ord("|", _) | Rel("|") | Ord("\\vert", _) => sb.write_string("<mi mathvariant=\"normal\">\u{2223}</mi>")
        _ => mml_write_node(sb, body[i], ctx, false)
      }
      i = i + 1
    }
    if body.length() != 1 {
      sb.write_string("</mrow>")
    }
    if kind == "bra" {
      sb.write_string("<mi mathvariant=\"normal\">\u{2223}</mi>")
    } else {
      sb.write_string("<mo stretchy=\"false\">\u{27e9}</mo>")
    }
    sb.write_string("</mpadded>")
    return
  }
  sb.write_string("<mrow><mo ")
  sb.write_string(if is_large { "fence=\"true\">" } else { "stretchy=\"false\">" })
  escape_xml_into(sb, open_sym)
  sb.write_string("</mo>")
  if kind == "set" {
    sb.write_string("<mtext>\u{2009}</mtext>")
  } else if kind == "Set" {
    sb.write_string("<mtext>\u{2005}</mtext>")
  }
  let mut i = 0
  while i < body.length() {
    let is_bar = match body[i] {
      Ord("|", _) | Rel("|") | Ord("\\vert", _) => true
      _ => false
    }
    if is_bar {
      if kind == "set" {
        sb.write_string("<mo>\u{2223}</mo>")
      } else if kind == "Set" {
        sb.write_string("<mtext>\u{2005}\u{200a}</mtext><mo fence=\"true\" lspace=\"0.05em\" rspace=\"0.05em\">|</mo><mtext>\u{2005}\u{200a}</mtext>")
      } else if kind == "Braket" {
        sb.write_string("<mtext>\u{2009}</mtext><mo fence=\"true\" lspace=\"0.05em\" rspace=\"0.05em\">|</mo><mtext>\u{2009}</mtext>")
      } else {
        mml_write_node(sb, body[i], ctx, false)
      }
    } else {
      mml_write_node(sb, body[i], ctx, false)
    }
    i = i + 1
  }
  if kind == "set" {
    sb.write_string("<mtext>\u{2009}</mtext>")
  } else if kind == "Set" {
    sb.write_string("<mtext>\u{2005}</mtext>")
  }
  sb.write_string("<mo ")
  sb.write_string(if is_large { "fence=\"true\">" } else { "stretchy=\"false\">" })
  escape_xml_into(sb, close_sym)
  sb.write_string("</mo></mrow>")
}

///| Write superscript node (adding lspace/rspace="0em" for bare `\prime`).
fn mml_write_sup_node(sb : StringBuilder, sn : MathNode, script_ctx : MmlCtx) -> Unit {
  match sn {
    Ord("\\prime", _) => sb.write_string("<mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">\u{2032}</mo>")
    _ => mml_write_node(sb, sn, script_ctx, false)
  }
}

///| Cold path for rare `MathNode::Styled` variants (keeps hot `mml_write_node` small for Wasm JIT).
fn mml_write_styled_cold(sb : StringBuilder, st : String, body : Array[MathNode], ctx : MmlCtx, ordgroup_mo : Bool) -> Unit {
  if st == "style:display" {
    sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"true\">")
    mml_write_expr(sb, body, MmlCtx::{ ..ctx, display: true, script_level: 0 }, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "style:text" {
    sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"false\">")
    mml_write_expr(sb, body, MmlCtx::{ ..ctx, display: false, script_level: 0 }, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "style:script" {
    sb.write_string("<mstyle scriptlevel=\"1\" displaystyle=\"false\">")
    mml_write_expr(sb, body, MmlCtx::{ ..ctx, display: false, script_level: 1 }, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "style:scriptscript" {
    sb.write_string("<mstyle scriptlevel=\"2\" displaystyle=\"false\">")
    mml_write_expr(sb, body, MmlCtx::{ ..ctx, display: false, script_level: 2 }, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "math" {
    mml_write_expr_row(sb, body, MmlCtx::{ ..ctx, font: "" }, false)
    return
  }
  if st.starts_with("size:") {
    let sz_em = size_name_to_em(st.slice(5, st.length()))
    sb.write_string("<mstyle mathsize=\"")
    sb.write_string(sz_em)
    sb.write_string("\">")
    mml_write_expr(sb, body, ctx, false)
    sb.write_string("</mstyle>")
    return
  }
  if st.starts_with("op_normal:") {
    let sym = st.slice(10, st.length())
    sb.write_string("<mo mathvariant=\"normal\"")
    if ordgroup_mo {
      sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
    }
    sb.write_string(">")
    escape_xml_into(sb, sym)
    sb.write_string("</mo>")
    return
  }
  if st.starts_with("op_normal_nospace:") {
    let sym = st.slice(18, st.length())
    sb.write_string("<mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">")
    escape_xml_into(sb, sym)
    sb.write_string("</mo>")
    return
  }
  if st == "smash:tb" || st == "smash:t" || st == "smash:b" {
    sb.write_string("<mpadded")
    if st == "smash:tb" || st == "smash:t" {
      sb.write_string(" height=\"0px\"")
    }
    if st == "smash:tb" || st == "smash:b" {
      sb.write_string(" depth=\"0px\"")
    }
    sb.write_string(">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mpadded>")
    return
  }
  if st == "lap:r" || st == "lap:l" || st == "lap:c" {
    sb.write_string("<mpadded")
    if st == "lap:l" {
      sb.write_string(" lspace=\"-1width\"")
    } else if st == "lap:c" {
      sb.write_string(" lspace=\"-0.5width\"")
    }
    sb.write_string(" width=\"0px\">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mpadded>")
    return
  }
  if st.starts_with("xarrow:") {
    let cmd = st.slice(7, st.length())
    let arrow_ch = match cmd {
      "\\xrightarrow" => "\u{2192}"
      "\\xleftarrow" => "\u{2190}"
      "\\xRightarrow" => "\u{21d2}"
      "\\xLeftarrow" => "\u{21d0}"
      "\\xleftrightarrow" => "\u{2194}"
      "\\xLeftrightarrow" => "\u{21d4}"
      "\\xmapsto" => "\u{21a6}"
      "\\xhookleftarrow" => "\u{21a9}"
      "\\xhookrightarrow" => "\u{21aa}"
      "\\xleftharpoonup" => "\u{21bc}"
      "\\xleftharpoondown" => "\u{21bd}"
      "\\xrightharpoonup" => "\u{21c0}"
      "\\xrightharpoondown" => "\u{21c1}"
      "\\xrightleftharpoons" | "\\xrightequilibrium" => "\u{21cc}"
      "\\xleftrightharpoons" | "\\xleftequilibrium" => "\u{21cb}"
      "\\xrightleftarrows" | "\\xtofrom" => "\u{21c4}"
      "\\xtwoheadleftarrow" => "\u{219e}"
      "\\xtwoheadrightarrow" => "\u{21a0}"
      "\\xlongequal" => "="
      _ => "\u{2192}"
    }
    let sctx = MmlCtx::{ ..ctx, display: false }
    if body.length() >= 2 {
      sb.write_string("<munderover><mo stretchy=\"true\" minsize=\"3.0em\">")
      escape_xml_into(sb, arrow_ch)
      sb.write_string("</mo><mpadded width=\"+0.6em\" lspace=\"0.3em\">")
      mml_write_node(sb, body[1], sctx, false)
      sb.write_string("</mpadded><mpadded width=\"+0.6em\" lspace=\"0.3em\">")
      mml_write_node(sb, body[0], sctx, false)
      sb.write_string("</mpadded></munderover>")
    } else {
      sb.write_string("<mover><mo stretchy=\"true\" minsize=\"3.0em\">")
      escape_xml_into(sb, arrow_ch)
      sb.write_string("</mo><mpadded width=\"+0.6em\" lspace=\"0.3em\">")
      mml_write_node(sb, body[0], sctx, false)
      sb.write_string("</mpadded></mover>")
    }
    return
  }
  if st.starts_with("colorbox:") {
    let bg = st.slice(9, st.length())
    sb.write_string("<mpadded width=\"+6pt\" height=\"+6pt\" lspace=\"3pt\" voffset=\"3pt\"")
    write_attr(sb, "mathbackground", bg)
    sb.write_string("><mstyle scriptlevel=\"0\" displaystyle=\"false\">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mstyle></mpadded>")
    return
  }
  if st.starts_with("fcolorbox:") {
    let rest = st.slice(10, st.length())
    let mut colon = 0
    while colon < rest.length() && rest[colon] != 58 {
      colon = colon + 1
    }
    let border = rest.slice(0, colon)
    let bg = if colon + 1 < rest.length() { rest.slice(colon + 1, rest.length()) } else { "" }
    sb.write_string("<mpadded width=\"+6pt\" height=\"+6pt\" lspace=\"3pt\" voffset=\"3pt\" style=\"border: 0.04em solid ")
    escape_xml_into(sb, border)
    sb.write_string("\"")
    write_attr(sb, "mathbackground", bg)
    sb.write_string("><mstyle scriptlevel=\"0\" displaystyle=\"false\">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mstyle></mpadded>")
    return
  }
  if st == "boxed" {
    sb.write_string("<menclose notation=\"box\"><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mstyle scriptlevel=\"0\" displaystyle=\"true\">")
    mml_write_expr_row(sb, body, MmlCtx::{ ..ctx, display: true }, false)
    sb.write_string("</mstyle></mstyle></mstyle></menclose>")
    return
  }
  if st.starts_with("enclose:") {
    let kind = st.slice(8, st.length())
    let notation = match kind {
      "cancel" => "updiagonalstrike"
      "bcancel" => "downdiagonalstrike"
      "xcancel" => "updiagonalstrike downdiagonalstrike"
      "sout" => "horizontalstrike"
      "phase" => "phasorangle"
      "angl" => "actuarial"
      _ => "box"
    }
    sb.write_string("<menclose notation=\"")
    sb.write_string(notation)
    sb.write_string("\">")
    if kind == "angl" {
      sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"false\">")
      mml_write_expr_row(sb, body, ctx, false)
      sb.write_string("</mstyle>")
    } else {
      mml_write_expr_row(sb, body, ctx, false)
    }
    sb.write_string("</menclose>")
    return
  }
  if st == "pmb" {
    sb.write_string("<mstyle style=\"text-shadow: 0.02em 0.01em 0.04px\">")
    mml_write_expr(sb, body, ctx, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "dddot" {
    sb.write_string("<mi><mover><mo>")
    mml_write_node(sb, body[0], ctx, false)
    sb.write_string("</mo><mpadded voffset=\"-0.1ex\"><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mstyle mathsize=\"1em\"><mtext>...</mtext></mstyle></mstyle></mpadded></mover></mi>")
    return
  }
  if st.starts_with("raisebox:") {
    let voff = st.slice(9, st.length())
    sb.write_string("<mpadded")
    write_attr(sb, "voffset", voff)
    sb.write_string("><mstyle scriptlevel=\"0\" displaystyle=\"false\">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mstyle></mpadded>")
    return
  }
  if st == "mathchoice" && body.length() == 4 {
    let idx = if ctx.script_level >= 2 {
      3
    } else if ctx.script_level == 1 {
      2
    } else if ctx.display {
      0
    } else {
      1
    }
    mml_write_node(sb, body[idx], ctx, ordgroup_mo)
    return
  }
  if st.starts_with("cd_vert:") {
    let dir = st.slice(8, st.length())
    if dir == "|" {
      sb.write_string("<mo fence=\"false\" stretchy=\"true\" minsize=\"1.8em\" maxsize=\"1.8em\"")
      if ordgroup_mo {
        sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
      }
      sb.write_string(">\u{2225}</mo>")
      return
    }
    let sym = if dir == "V" { "\u{2193}" } else { "\u{2191}" }
    let sctx = MmlCtx::{ ..ctx, display: false, script_level: 1 }
    sb.write_string("<mrow><mrow><mstyle displaystyle=\"false\" scriptlevel=\"1\"><mpadded width=\"0\" lspace=\"-1width\" voffset=\"0.7em\"><mrow>")
    mml_write_node(sb, body[0], sctx, false)
    sb.write_string("</mrow></mpadded></mstyle><mo fence=\"false\" stretchy=\"true\" minsize=\"1.8em\" maxsize=\"1.8em\">")
    sb.write_string(sym)
    sb.write_string("</mo><mstyle displaystyle=\"false\" scriptlevel=\"1\"><mpadded width=\"0\" voffset=\"0.7em\"><mrow>")
    mml_write_node(sb, body[1], sctx, false)
    sb.write_string("</mrow></mpadded></mstyle></mrow></mrow>")
    return
  }
  if st == "reflectbox" {
    sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"false\">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mstyle>")
    return
  }
  if st == "minuso" {
    sb.write_string("<mo")
    if ordgroup_mo {
      sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
    } else {
      sb.write_string(" lspace=\"0.22em\" rspace=\"0.22em\"")
    }
    sb.write_string("><mi mathvariant=\"normal\">\u{29b5}</mi></mo>")
    return
  }
  if st == "tag:" || st == "tag:*" || st == "notag" {
    return
  }
  if st.starts_with("braket:") {
    mml_write_braket(sb, st.slice(7, st.length()), body, ctx)
    return
  }
  if st == "mclass:mbin" {
    if body.length() == 1 {
      match body[0] {
        Ord(t, fam) => {
          let rep = mml_symbol_text(t, false)
          sb.write_string("<mo")
          if fam == "textord" {
            sb.write_string(" mathvariant=\"normal\"")
          }
          if ordgroup_mo {
            sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
          } else {
            sb.write_string(" lspace=\"0.22em\" rspace=\"0.22em\"")
          }
          sb.write_string(">")
          escape_xml_into(sb, rep)
          sb.write_string("</mo>")
          return
        }
        _ => ()
      }
    }
    sb.write_string("<mo")
    if ordgroup_mo {
      sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
    } else {
      sb.write_string(" lspace=\"0.22em\" rspace=\"0.22em\"")
    }
    sb.write_string(">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mo>")
    return
  }
  if st == "mclass:mrel" {
    sb.write_string("<mo")
    if ordgroup_mo {
      sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
    }
    sb.write_string(">")
    mml_write_expr_row(sb, body, ctx, false)
    sb.write_string("</mo>")
    return
  }
  if st == "mclass:mord" || st == "mclass:mopen" || st == "mclass:mclose" || st == "mclass:mpunct" || st == "mclass:minner" {
    mml_write_expr_row(sb, body, ctx, false)
    return
  }
  mml_write_expr_row(sb, body, MmlCtx::{ ..ctx, font: st }, false)
}

///| Hot path for `MathNode::Styled`: handles math font wrappers in O(1), delegates rare styles to cold path.
fn mml_write_styled(sb : StringBuilder, st : String, body : Array[MathNode], ctx : MmlCtx, ordgroup_mo : Bool) -> Unit {
  match st {
    "mathrm" | "mathbf" | "mathit" | "mathbb" | "mathcal" | "mathfrak" |
    "mathscr" | "mathsf" | "mathsfit" | "mathtt" | "boldsymbol" | "mathnormal" =>
    mml_write_expr_row(sb, body, MmlCtx::{ ..ctx, font: st }, false)
    _ => mml_write_styled_cold(sb, st, body, ctx, ordgroup_mo)
  }
}

///|
fn mml_write_matrix(
  sb : StringBuilder,
  env_name : String,
  rows : Array[Array[Array[MathNode]]],
  col_aligns : Array[String],
  ld : String,
  rd : String,
  is_disp : Bool,
  ctx : MmlCtx,
) -> Unit {
  let mut max_cols = 0
  let mut r = 0
  while r < rows.length() {
    if rows[r].length() > max_cols {
      max_cols = rows[r].length()
    }
    r = r + 1
  }
  let is_subarray = env_name == "subarray"
  let is_cd = env_name == "CD"
  let cell_ctx = MmlCtx::{
    ..ctx,
    display: is_disp,
    script_level: if is_subarray { 1 } else { 0 },
    font: "",
  }
  let is_align_env = env_name == "aligned" || env_name == "align" || env_name == "align*" ||
  env_name == "alignedat" || env_name == "alignat" || env_name == "alignat*" || env_name == "split"
  let is_gather_env = env_name == "gather" || env_name == "gather*" || env_name == "gathered"
  let is_numbered = env_name == "equation" || env_name == "align" || env_name == "alignat" || env_name == "gather"
  let all_align_opt = if col_aligns.length() == 1 && col_aligns[0].starts_with("all:") {
    Some(col_aligns[0].slice(4, col_aligns[0].length()))
  } else {
    None
  }
  let has_ld = ld.length() > 0 && ld != "."
  let has_rd = rd.length() > 0 && rd != "."
  let wrap_delim = !is_subarray && (ld.length() > 0 || rd.length() > 0) && (has_ld || has_rd)
  if is_subarray {
    sb.write_string("<mstyle scriptlevel=\"1\">")
  } else if wrap_delim {
    sb.write_string("<mrow>")
    if has_ld {
      sb.write_string("<mo fence=\"true\">")
      escape_xml_into(sb, mml_symbol_text(ld, false))
      sb.write_string("</mo>")
    }
  }
  let row_sp = if env_name == "cases" || env_name == "rcases" || env_name == "dcases" || env_name == "drcases" {
    "0.36em"
  } else if is_subarray {
    "0.1em"
  } else if is_align_env || is_gather_env || is_cd {
    "0.25em"
  } else {
    "0.16em"
  }
  sb.write_string("<mtable rowspacing=\"")
  sb.write_string(row_sp)
  sb.write_string("\"")
  if env_name != "equation" && env_name != "equation*" && max_cols > 0 {
    sb.write_string(" columnalign=\"")
    let mut ci = 0
    while ci < max_cols {
      if ci > 0 {
        sb.write_string(" ")
      }
      let al = match all_align_opt {
        Some(a) => a
        None =>
        if ci < col_aligns.length() {
          col_aligns[ci]
        } else if is_align_env {
          if ci % 2 == 0 { "right" } else { "left" }
        } else if env_name == "cases" || env_name == "rcases" || env_name == "dcases" || env_name == "drcases" {
          "left"
        } else {
          "center"
        }
      }
      sb.write_string(al)
      ci = ci + 1
    }
    sb.write_string("\"")
  }
  sb.write_string(" columnspacing=\"")
  if is_cd {
    sb.write_string("0.5em")
  } else if env_name == "alignat" || env_name == "alignat*" || env_name == "alignedat" || is_gather_env {
    sb.write_string("0em")
  } else if is_align_env {
    if max_cols <= 2 {
      sb.write_string("0em")
    } else {
      let mut ci = 0
      while ci < max_cols - 1 {
        if ci > 0 {
          sb.write_string(" ")
        }
        sb.write_string(if ci % 2 == 0 { "0em" } else { "1em" })
        ci = ci + 1
      }
    }
  } else {
    sb.write_string("1em")
  }
  sb.write_string("\">")
  let st_open = if is_subarray {
    if is_disp {
      "<mtd><mstyle scriptlevel=\"1\" displaystyle=\"true\">"
    } else {
      "<mtd><mstyle scriptlevel=\"1\" displaystyle=\"false\">"
    }
  } else if is_disp {
    "<mtd><mstyle scriptlevel=\"0\" displaystyle=\"true\">"
  } else {
    "<mtd><mstyle scriptlevel=\"0\" displaystyle=\"false\">"
  }
  r = 0
  while r < rows.length() {
    sb.write_string("<mtr>")
    let mut row_tag : Option[(Bool, Array[MathNode])] = None
    let mut row_notag = false
    if is_numbered {
      sb.write_string("<mtd class =\"mtr-glue\"></mtd>")
    }
    let mut c = 0
    while c < rows[r].length() {
      let raw_cell = rows[r][c]
      // Fast check for tag/notag in cell
      let mut has_tag = false
      let mut ni = 0
      while ni < raw_cell.length() {
        match raw_cell[ni] {
          Styled("tag:", _) | Styled("tag:*", _) | Styled("notag", _) => {
            has_tag = true
            break
          }
          _ => ()
        }
        ni = ni + 1
      }
      let cell_nodes = if has_tag {
        let cn : Array[MathNode] = Array::new()
        let mut k = 0
        while k < raw_cell.length() {
          match raw_cell[k] {
            Styled("tag:", tb) => row_tag = Some((false, tb))
            Styled("tag:*", tb) => row_tag = Some((true, tb))
            Styled("notag", _) => row_notag = true
            _ => cn.push(raw_cell[k])
          }
          k = k + 1
        }
        cn
      } else {
        raw_cell
      }
      sb.write_string(st_open)
      if cell_nodes.length() == 0 && is_cd {
        ()
      } else if is_align_env && (c % 2 == 1) && cell_nodes.length() > 0 {
        sb.write_string("<mrow><mrow></mrow>")
        mml_write_expr(sb, cell_nodes, cell_ctx, false)
        sb.write_string("</mrow>")
      } else {
        mml_write_expr_row(sb, cell_nodes, cell_ctx, !is_align_env && !is_cd)
      }
      sb.write_string("</mstyle></mtd>")
      c = c + 1
    }
    if is_numbered {
      sb.write_string("<mtd class =\"mtr-glue\"></mtd>")
      match row_tag {
        Some((is_star, tb)) => {
          sb.write_string("<mtd>")
          if is_star {
            mml_write_text_row(sb, tb, ctx)
          } else {
            sb.write_string("<mrow><mtext>(</mtext>")
            let inner_st = TextEmitState::{ open_mtext: false, open_variant: "", item_count: 0 }
            text_emit_nodes(sb, inner_st, tb, ctx)
            text_emit_close(sb, inner_st)
            sb.write_string("<mtext>)</mtext></mrow>")
          }
          sb.write_string("</mtd>")
        }
        None =>
        if !row_notag {
          sb.write_string("<mtd class =\"mml-eqn-num\"></mtd>")
        }
      }
    }
    sb.write_string("</mtr>")
    r = r + 1
  }
  if is_cd {
    sb.write_string("<mtr></mtr>")
  }
  sb.write_string("</mtable>")
  if is_subarray {
    sb.write_string("</mstyle>")
  } else if wrap_delim {
    if has_rd {
      sb.write_string("<mo fence=\"true\">")
      escape_xml_into(sb, mml_symbol_text(rd, false))
      sb.write_string("</mo>")
    }
    sb.write_string("</mrow>")
  }
}

///|
fn mml_write_node(sb : StringBuilder, node : MathNode, ctx : MmlCtx, ordgroup_mo : Bool) -> Unit {
  match node {
    Ord(text, fam) => {
      if text == "\\not" {
        sb.write_string("<mi mathvariant=\"normal\">\u{0338}</mi>")
        return
      }
      if text == "\\prime" {
        sb.write_string("<mo mathvariant=\"normal\"")
        if ordgroup_mo {
          sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
        }
        sb.write_string(">\u{2032}</mo>")
        return
      }
      let rep = mml_symbol_text(text, false)
      let is_textord = fam == "textord"
      if is_digit_str(rep) {
        let v = mml_math_variant(ctx, true)
        if v.length() > 0 && v != "normal" {
          sb.write_string("<mn")
          write_attr(sb, "mathvariant", v)
          sb.write_string(">")
        } else {
          sb.write_string("<mn>")
        }
        sb.write_string(rep)
        sb.write_string("</mn>")
        return
      }
      let v = mml_math_variant(ctx, is_textord)
      if v.length() > 0 {
        let is_lower_greek = if rep.length() >= 2 && rep[0] >= 0xCE && rep[0] <= 0xCF {
          let cp = first_codepoint(rep)
          (cp >= 0x03B1 && cp <= 0x03C9) || cp == 0x03F5 || cp == 0x03D1 || cp == 0x03F0 || cp == 0x03D5 || cp == 0x03F1 || cp == 0x03D6
        } else {
          false
        }
        if v == "italic" || (v == "normal" && is_lower_greek) {
          sb.write_string("<mi>")
        } else {
          sb.write_string("<mi")
          write_attr(sb, "mathvariant", v)
          sb.write_string(">")
        }
      } else if is_textord && rep != "." {
        sb.write_string("<mi mathvariant=\"normal\">")
      } else {
        sb.write_string("<mi>")
      }
      escape_xml_into(sb, rep)
      sb.write_string("</mi>")
    }
    Bin(text) | Rel(text) | Inner(text) => {
      let rep = mml_symbol_text(text, false)
      sb.write_string("<mo")
      if ctx.font == "boldsymbol" {
        sb.write_string(" mathvariant=\"bold-italic\"")
      }
      if ordgroup_mo {
        sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
      }
      sb.write_string(">")
      escape_xml_into(sb, rep)
      sb.write_string("</mo>")
    }
    Open(text) | Close(text) => {
      let rep = mml_symbol_text(text, false)
      sb.write_string("<mo stretchy=\"false\"")
      if ordgroup_mo {
        sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
      }
      sb.write_string(">")
      escape_xml_into(sb, rep)
      sb.write_string("</mo>")
    }
    Punct(text) => {
      let rep = mml_symbol_text(text, false)
      sb.write_string("<mo separator=\"true\"")
      if ordgroup_mo {
        sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
      }
      sb.write_string(">")
      escape_xml_into(sb, rep)
      sb.write_string("</mo>")
    }
    Group(body, is_ord) => mml_write_expr_row(sb, body, ctx, is_ord || ordgroup_mo)
    Space(cmd, w) => mml_write_space(sb, cmd, w, ctx)
    Rule(shift, w, h) => {
      let bg = if ctx.color.length() > 0 { ctx.color } else { "black" }
      sb.write_string("<mpadded height=\"")
      write_em_into(sb, shift)
      sb.write_string("\" voffset=\"")
      write_em_into(sb, shift)
      sb.write_string("\"><mspace")
      write_attr(sb, "mathbackground", bg)
      sb.write_string(" width=\"")
      write_em_into(sb, w)
      sb.write_string("\" height=\"")
      write_em_into(sb, h)
      sb.write_string("\"></mspace></mpadded>")
    }
    Phantom(body, h_only, v_only) => {
      if h_only {
        sb.write_string("<mpadded height=\"0px\" depth=\"0px\"><mphantom>")
        mml_write_expr(sb, body, ctx, false)
        sb.write_string("</mphantom></mpadded>")
      } else if v_only {
        sb.write_string("<mpadded width=\"0px\"><mphantom>")
        mml_write_expr(sb, body, ctx, false)
        sb.write_string("</mphantom></mpadded>")
      } else {
        sb.write_string("<mphantom>")
        mml_write_expr(sb, body, ctx, false)
        sb.write_string("</mphantom>")
      }
    }
    Color(c, body) => {
      sb.write_string("<mstyle")
      write_attr(sb, "mathcolor", c)
      sb.write_string(">")
      mml_write_expr(sb, body, MmlCtx::{ ..ctx, color: c }, false)
      sb.write_string("</mstyle>")
    }
    Text(st, body) => {
      let tctx = match st {
        "textbf" => MmlCtx::{ ..ctx, text_weight: "textbf" }
        "textit" => MmlCtx::{ ..ctx, text_shape: "textit" }
        "emph" => MmlCtx::{ ..ctx, text_shape: if ctx.text_shape == "textit" { "" } else { "textit" } }
        "textsf" => MmlCtx::{ ..ctx, text_family: "textsf" }
        "texttt" => MmlCtx::{ ..ctx, text_family: "texttt" }
        "textrm" => MmlCtx::{ ..ctx, text_family: "textrm" }
        "textnormal" => MmlCtx::{ ..ctx, text_family: "", text_weight: "", text_shape: "" }
        "textup" => MmlCtx::{ ..ctx, text_shape: "" }
        "textmd" => MmlCtx::{ ..ctx, text_weight: "" }
        _ => ctx
      }
      mml_write_text_row(sb, body, tctx)
    }
    Styled(st, body) => mml_write_styled(sb, st, body, ctx, ordgroup_mo)
    Op(name, is_sym, _lim, _always, body) => {
      if is_sym {
        let rep = mml_symbol_text(name, false)
        sb.write_string("<mo")
        if name == "\\smallint" {
          sb.write_string(" largeop=\"false\"")
        }
        if ordgroup_mo {
          sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
        }
        sb.write_string(">")
        escape_xml_into(sb, rep)
        sb.write_string("</mo>")
        return
      }
      if name == "\\operatorname" {
        if ctx.in_supsub_base {
          sb.write_string("<mrow>")
        }
        sb.write_string("<mi mathvariant=\"normal\">")
        let mut i = 0
        while i < body.length() {
          match body[i] {
            Ord(t, _) => escape_xml_into(sb, mml_symbol_text(t, false))
            Bin(t) => if t == "-" { sb.write_string("-") } else { escape_xml_into(sb, mml_symbol_text(t, false)) }
            Space(_, _) => sb.write_string("\u{2009}")
            _ => ()
          }
          i = i + 1
        }
        sb.write_string("</mi><mo>\u{2061}</mo>")
        if ctx.in_supsub_base {
          sb.write_string("</mrow>")
        }
        return
      }
      if body.length() > 0 {
        sb.write_string("<mo")
        if ordgroup_mo {
          sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
        }
        sb.write_string(">")
        mml_write_expr(sb, body, ctx, false)
        sb.write_string("</mo>")
        return
      }
      if name == "\\varliminf" || name == "\\varlimsup" || name == "\\varinjlim" || name == "\\varprojlim" {
        let bar_ch = match name {
          "\\varliminf" | "\\varlimsup" => "\u{203e}"
          "\\varinjlim" => "\u{2192}"
          _ => "\u{2190}"
        }
        if ctx.in_supsub_base {
          sb.write_string("<mrow>")
        }
        sb.write_string("<mi mathvariant=\"normal\">")
        if name == "\\varlimsup" {
          sb.write_string("<mover accent=\"true\"><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mo stretchy=\"true\">")
          sb.write_string(bar_ch)
          sb.write_string("</mo></mover>")
        } else {
          sb.write_string("<munder accentunder=\"true\"><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mo stretchy=\"true\">")
          sb.write_string(bar_ch)
          sb.write_string("</mo></munder>")
        }
        sb.write_string("</mi><mo>\u{2061}</mo>")
        if ctx.in_supsub_base {
          sb.write_string("</mrow>")
        }
        return
      }
      if name == "\\limsup" || name == "\\liminf" || name == "\\injlim" || name == "\\projlim" {
        let label = match name {
          "\\limsup" => "lim\u{2009}sup"
          "\\liminf" => "lim\u{2009}inf"
          "\\injlim" => "inj\u{2009}lim"
          _ => "proj\u{2009}lim"
        }
        if ctx.in_supsub_base {
          sb.write_string("<mrow>")
        }
        sb.write_string("<mi mathvariant=\"normal\">")
        sb.write_string(label)
        sb.write_string("</mi><mo>\u{2061}</mo>")
        if ctx.in_supsub_base {
          sb.write_string("</mrow>")
        }
        return
      }
      let label = if name.length() > 1 && name[0] == 92 { name.slice(1, name.length()) } else { name }
      if ctx.in_supsub_base {
        sb.write_string("<mrow>")
      }
      sb.write_string("<mi>")
      escape_xml_into(sb, label)
      sb.write_string("</mi><mo>\u{2061}</mo>")
      if ctx.in_supsub_base {
        sb.write_string("</mrow>")
      }
    }
    SupSub(base_opt, sub_opt, sup_opt) => {
      match base_opt {
        Some(base_inner) =>
        match base_inner {
          OverUnder(kind, _, None, is_over) =>
          if kind == "overbrace" || kind == "underbrace" || kind == "overbracket" || kind == "underbracket" {
            if is_over && sub_opt is None && sup_opt is Some(sn) {
              sb.write_string("<mover>")
              mml_write_node(sb, base_inner, ctx, false)
              mml_write_node(sb, sn, ctx, false)
              sb.write_string("</mover>")
              return
            }
            if !is_over && sup_opt is None && sub_opt is Some(sn) {
              sb.write_string("<munder>")
              mml_write_node(sb, base_inner, ctx, false)
              mml_write_node(sb, sn, ctx, false)
              sb.write_string("</munder>")
              return
            }
          }
          _ => ()
        }
        None => ()
      }
      let use_limits = match base_opt {
        Some(Op(nm, _, lim, always, _)) => lim && (ctx.display || ((nm == "\\mathop" || nm == "\\operatorname") && always))
        _ => false
      }
      let base_ctx = MmlCtx::{ ..ctx, in_supsub_base: true }
      let script_ctx = MmlCtx::{ ..ctx, display: false, script_level: ctx.script_level + 1, in_supsub_base: false }
      match (sub_opt, sup_opt) {
        (Some(sub_n), Some(sup_n)) => {
          sb.write_string(if use_limits { "<munderover>" } else { "<msubsup>" })
          match base_opt {
            Some(b) => mml_write_node(sb, b, base_ctx, false)
            None => sb.write_string("<mrow></mrow>")
          }
          mml_write_node(sb, sub_n, script_ctx, false)
          mml_write_sup_node(sb, sup_n, script_ctx)
          sb.write_string(if use_limits { "</munderover>" } else { "</msubsup>" })
        }
        (Some(sub_n), None) => {
          sb.write_string(if use_limits { "<munder>" } else { "<msub>" })
          match base_opt {
            Some(b) => mml_write_node(sb, b, base_ctx, false)
            None => sb.write_string("<mrow></mrow>")
          }
          mml_write_node(sb, sub_n, script_ctx, false)
          sb.write_string(if use_limits { "</munder>" } else { "</msub>" })
        }
        (None, Some(sup_n)) => {
          sb.write_string(if use_limits { "<mover>" } else { "<msup>" })
          match base_opt {
            Some(b) => mml_write_node(sb, b, base_ctx, false)
            None => sb.write_string("<mrow></mrow>")
          }
          mml_write_sup_node(sb, sup_n, script_ctx)
          sb.write_string(if use_limits { "</mover>" } else { "</msup>" })
        }
        (None, None) =>
        match base_opt {
          Some(b) => mml_write_node(sb, b, base_ctx, false)
          None => sb.write_string("<mrow></mrow>")
        }
        _ => ()
      }
    }
    Frac(numer, denom, has_bar, ld, rd, bar_sz, fstyle, _cont) => {
      let inner_ctx = match fstyle {
        "display" => MmlCtx::{ ..ctx, display: true }
        "text" | "script" | "scriptscript" => MmlCtx::{ ..ctx, display: false }
        _ => ctx
      }
      let has_style = fstyle == "display" || fstyle == "text" || fstyle == "script" || fstyle == "scriptscript"
      if fstyle == "display" {
        sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"true\">")
      } else if fstyle == "text" {
        sb.write_string("<mstyle scriptlevel=\"0\" displaystyle=\"false\">")
      } else if fstyle == "script" {
        sb.write_string("<mstyle scriptlevel=\"1\" displaystyle=\"false\">")
      } else if fstyle == "scriptscript" {
        sb.write_string("<mstyle scriptlevel=\"2\" displaystyle=\"false\">")
      }
      let has_delims = ld.length() > 0 || rd.length() > 0
      if has_delims {
        sb.write_string("<mrow>")
        if ld.length() > 0 {
          sb.write_string("<mo fence=\"true\">")
          escape_xml_into(sb, mml_symbol_text(ld, false))
          sb.write_string("</mo>")
        }
      }
      sb.write_string("<mfrac")
      if !has_bar {
        sb.write_string(" linethickness=\"0px\"")
      } else if bar_sz.length() > 0 {
        write_attr(sb, "linethickness", bar_sz)
      }
      sb.write_string(">")
      mml_write_node(sb, numer, inner_ctx, false)
      mml_write_node(sb, denom, inner_ctx, false)
      sb.write_string("</mfrac>")
      if has_delims {
        if rd.length() > 0 {
          sb.write_string("<mo fence=\"true\">")
          escape_xml_into(sb, mml_symbol_text(rd, false))
          sb.write_string("</mo>")
        }
        sb.write_string("</mrow>")
      }
      if has_style {
        sb.write_string("</mstyle>")
      }
    }
    Sqrt(body, idx_opt) =>
    match idx_opt {
      Some(idx) => {
        sb.write_string("<mroot>")
        mml_write_node(sb, body, ctx, false)
        mml_write_node(sb, idx, ctx, false)
        sb.write_string("</mroot>")
      }
      None => {
        sb.write_string("<msqrt>")
        mml_write_node(sb, body, ctx, false)
        sb.write_string("</msqrt>")
      }
    }
    Accent(label, base, stretchy, _shifty) => {
      let acc_txt = match label {
        "\\vec" => "\u{20d7}"
        "\\widehat" => "^"
        "\\widetilde" => "~"
        "\\widecheck" => "\u{02c7}"
        "\\overrightarrow" | "\\underrightarrow" => "\u{2192}"
        "\\overleftarrow" | "\\underleftarrow" => "\u{2190}"
        "\\overleftrightarrow" | "\\underleftrightarrow" => "\u{2194}"
        "\\Overrightarrow" => "\u{21d2}"
        "\\overgroup" => "\u{23e0}"
        "\\undergroup" => "\u{23e1}"
        "\\overlinesegment" | "\\underlinesegment" => "undefined"
        "\\overleftharpoon" => "\u{21bc}"
        "\\overrightharpoon" => "\u{21c0}"
        "\\utilde" => "~"
        _ => mml_symbol_text(label, false)
      }
      let is_under = label == "\\underleftarrow" || label == "\\underrightarrow" ||
      label == "\\underleftrightarrow" || label == "\\undergroup" ||
      label == "\\underlinesegment" || label == "\\utilde"
      sb.write_string(if is_under { "<munder accentunder=\"true\">" } else { "<mover accent=\"true\">" })
      mml_write_node(sb, base, ctx, false)
      sb.write_string(if stretchy { "<mo stretchy=\"true\">" } else { "<mo>" })
      escape_xml_into(sb, acc_txt)
      sb.write_string(if is_under { "</mo></munder>" } else { "</mo></mover>" })
    }
    OverUnder(kind, base, script_opt, is_over) => {
      if kind == "overline" {
        sb.write_string("<mover accent=\"true\">")
        mml_write_expr_row(sb, arg_to_array(base), ctx, false)
        sb.write_string("<mo stretchy=\"true\">\u{203e}</mo></mover>")
        return
      }
      if kind == "underline" {
        sb.write_string("<munder accentunder=\"true\">")
        mml_write_expr_row(sb, arg_to_array(base), ctx, false)
        sb.write_string("<mo stretchy=\"true\">\u{203e}</mo></munder>")
        return
      }
      if kind == "overbrace" || kind == "underbrace" || kind == "overbracket" || kind == "underbracket" {
        let sym = match kind {
          "overbrace" => "\u{23de}"
          "underbrace" => "\u{23df}"
          "overbracket" => "\u{23b4}"
          _ => "\u{23b5}"
        }
        sb.write_string(if is_over { "<mover>" } else { "<munder>" })
        mml_write_expr_row(sb, arg_to_array(base), ctx, false)
        sb.write_string("<mo stretchy=\"true\">")
        sb.write_string(sym)
        sb.write_string(if is_over { "</mo></mover>" } else { "</mo></munder>" })
        return
      }
      let is_rel_or_bin = match base {
        Rel(_) | Bin(_) => true
        Group(arr, _) => arr.length() == 1 && (match arr[0] { Rel(_) | Bin(_) => true; _ => false })
        _ => false
      }
      sb.write_string(if is_rel_or_bin { "<mo>" } else { "<mi>" })
      sb.write_string(if is_over { "<mover><mo>" } else { "<munder><mo>" })
      mml_write_expr_row(sb, arg_to_array(base), ctx, false)
      sb.write_string("</mo>")
      match script_opt {
        Some(sn) => mml_write_expr_row(sb, arg_to_array(sn), ctx, true)
        None => sb.write_string("<mrow></mrow>")
      }
      sb.write_string(if is_over { "</mover>" } else { "</munder>" })
      sb.write_string(if is_rel_or_bin { "</mo>" } else { "</mi>" })
    }
    Delim(kind, ld, body, sz, rd) => {
      if kind == "sized" {
        let is_fence = rd == "mopen" || rd == "mclose"
        let sz_em = match sz {
          1 => "1.2em"
          2 => "1.8em"
          3 => "2.4em"
          _ => "3em"
        }
        sb.write_string("<mo fence=\"")
        sb.write_string(if is_fence { "true" } else { "false" })
        sb.write_string("\" stretchy=\"true\" minsize=\"")
        sb.write_string(sz_em)
        sb.write_string("\" maxsize=\"")
        sb.write_string(sz_em)
        sb.write_string("\"")
        if ordgroup_mo {
          sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
        }
        sb.write_string(">")
        if ld != "." {
          escape_xml_into(sb, mml_symbol_text(ld, false))
        }
        sb.write_string("</mo>")
        return
      }
      if kind == "middle" {
        let rep = if ld == "|" { "|" } else { mml_symbol_text(ld, false) }
        sb.write_string("<mo fence=\"true\"")
        if ordgroup_mo {
          sb.write_string(" lspace=\"0em\" rspace=\"0em\"")
        } else {
          sb.write_string(" lspace=\"0.05em\" rspace=\"0.05em\"")
        }
        sb.write_string(">")
        escape_xml_into(sb, rep)
        sb.write_string("</mo>")
        return
      }
      // leftright
      let has_l = ld != "."
      let has_r = rd != "."
      let total_non_body = (if has_l { 1 } else { 0 }) + (if has_r { 1 } else { 0 })
      let need_row = if total_non_body == 0 {
        !mml_expr_is_single(body, ctx)
      } else if total_non_body == 1 && body.length() == 0 {
        false
      } else {
        true
      }
      if need_row {
        sb.write_string("<mrow>")
      }
      if has_l {
        sb.write_string("<mo fence=\"true\">")
        escape_xml_into(sb, mml_symbol_text(ld, false))
        sb.write_string("</mo>")
      }
      mml_write_expr(sb, body, ctx, false)
      if has_r {
        sb.write_string("<mo fence=\"true\">")
        escape_xml_into(sb, mml_symbol_text(rd, false))
        sb.write_string("</mo>")
      }
      if need_row {
        sb.write_string("</mrow>")
      }
    }
    Matrix(env_name, rows, col_aligns, ld, rd, is_disp) =>
    mml_write_matrix(sb, env_name, rows, col_aligns, ld, rd, is_disp, ctx)
  }
}

///| Check if a single MathNode emits a top-level `<mrow>` or `<mtable>` (so build_mathml_string doesn't double-wrap).
fn node_is_mrow_or_mtable(node : MathNode, ctx : MmlCtx) -> Bool {
  match node {
    Matrix(env_name, _, _, ld, rd, _) => {
      if env_name == "subarray" {
        return false // emits <mstyle>
      }
      let _ = (ld, rd)
      true // emits <mtable> or <mrow>
    }
    Group(body, _) => {
      if body.length() == 1 {
        node_is_mrow_or_mtable(body[0], ctx)
      } else {
        !mml_expr_is_single(body, ctx)
      }
    }
    Delim(kind, ld, body, _, rd) => {
      if kind != "leftright" {
        return false
      }
      let total_non_body = (if ld != "." { 1 } else { 0 }) + (if rd != "." { 1 } else { 0 })
      if total_non_body == 0 {
        !mml_expr_is_single(body, ctx)
      } else if total_non_body == 1 && body.length() == 0 {
        false
      } else {
        true
      }
    }
    Frac(_, _, _, ld, rd, _, fstyle, _) => {
      let has_style = fstyle == "display" || fstyle == "text" || fstyle == "script" || fstyle == "scriptscript"
      !has_style && (ld.length() > 0 || rd.length() > 0)
    }
    Styled(st, body) => {
      if st.starts_with("braket:") {
        let kind = st.slice(7, st.length())
        return kind == "Bra" || kind == "Ket" || kind == "Braket" || kind == "Set" || kind == "set"
      }
      if st.starts_with("cd_vert:") {
        return st != "cd_vert:|"
      }
      if st == "math" || st == "mclass:mord" || st == "mclass:mopen" || st == "mclass:mclose" || st == "mclass:mpunct" || st == "mclass:minner" {
        return body.length() != 1 && !mml_expr_is_single(body, ctx)
      }
      if st == "mathrm" || st == "mathit" || st == "mathbf" || st == "mathnormal" || st == "mathsfit" ||
      st == "mathbb" || st == "mathcal" || st == "mathfrak" || st == "mathscr" || st == "mathsf" ||
      st == "mathtt" || st == "boldsymbol" {
        let fctx = MmlCtx::{ ..ctx, font: st }
        return if body.length() == 1 {
          node_is_mrow_or_mtable(body[0], fctx)
        } else {
          !mml_expr_is_single(body, fctx)
        }
      }
      false
    }
    Text(st, body) => {
      let tctx = match st {
        "textbf" => MmlCtx::{ ..ctx, text_weight: "textbf" }
        "textit" => MmlCtx::{ ..ctx, text_shape: "textit" }
        "emph" => MmlCtx::{ ..ctx, text_shape: if ctx.text_shape == "textit" { "" } else { "textit" } }
        "textsf" => MmlCtx::{ ..ctx, text_family: "textsf" }
        "texttt" => MmlCtx::{ ..ctx, text_family: "texttt" }
        "textrm" => MmlCtx::{ ..ctx, text_family: "textrm" }
        "textnormal" => MmlCtx::{ ..ctx, text_family: "", text_weight: "", text_shape: "" }
        "textup" => MmlCtx::{ ..ctx, text_shape: "" }
        "textmd" => MmlCtx::{ ..ctx, text_weight: "" }
        _ => ctx
      }
      if text_is_single_plain_mtext(body, tctx) {
        false
      } else {
        let tmp = StringBuilder::with_capacity(32)
        let em = TextEmitState::{ open_mtext: false, open_variant: "", item_count: 0 }
        text_emit_nodes(tmp, em, body, tctx)
        text_emit_close(tmp, em)
        em.item_count != 1
      }
    }
    _ => false
  }
}

///| Serialize parsed AST + source TeX into exact KaTeX MathML output.
pub fn build_mathml_string(nodes : Array[MathNode], tex : String, display_mode : Bool) -> String {
  let ctx = mml_ctx_default(display_mode)
  // Fast scan for top-level \tag{...} / \tag*{...} (avoids copying `nodes` on 99.9% of formulas)
  let mut has_top_tag = false
  let mut i = 0
  while i < nodes.length() {
    match nodes[i] {
      Styled("tag:", _) | Styled("tag:*", _) => {
        has_top_tag = true
        break
      }
      _ => ()
    }
    i = i + 1
  }
  let mut top_tag : Option[(Bool, Array[MathNode])] = None
  let filtered = if has_top_tag {
    let f : Array[MathNode] = Array::new()
    let mut k = 0
    while k < nodes.length() {
      match nodes[k] {
        Styled("tag:", tb) => top_tag = Some((false, tb))
        Styled("tag:*", tb) => top_tag = Some((true, tb))
        _ => f.push(nodes[k])
      }
      k = k + 1
    }
    f
  } else {
    nodes
  }
  let sb = StringBuilder::with_capacity(tex.length() * 12 + 128)
  if display_mode {
    sb.write_string("<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics>")
  } else {
    sb.write_string("<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics>")
  }
  let need_outer_mrow = !(filtered.length() == 1 && node_is_mrow_or_mtable(filtered[0], ctx))
  match top_tag {
    Some((is_star, tb)) => {
      sb.write_string("<mtable width=\"100%\"><mtr><mtd width=\"50%\"></mtd><mtd>")
      if need_outer_mrow {
        sb.write_string("<mrow>")
      }
      mml_write_expr(sb, filtered, ctx, false)
      if need_outer_mrow {
        sb.write_string("</mrow>")
      }
      sb.write_string("</mtd><mtd width=\"50%\"></mtd><mtd>")
      if is_star {
        mml_write_text_row(sb, tb, ctx)
      } else if text_is_single_plain_mtext(tb, ctx) {
        let v = mml_text_variant(ctx)
        sb.write_string("<mtext")
        if v.length() > 0 {
          write_attr(sb, "mathvariant", v)
        }
        sb.write_string(">(")
        let mut k = 0
        while k < tb.length() {
          match tb[k] {
            Ord(t, _) => escape_xml_into(sb, mml_symbol_text(t, true))
            _ => ()
          }
          k = k + 1
        }
        sb.write_string(")</mtext>")
      } else {
        let tmp = StringBuilder::with_capacity(32)
        let st = TextEmitState::{ open_mtext: false, open_variant: "", item_count: 0 }
        text_emit_nodes(tmp, st, tb, ctx)
        text_emit_close(tmp, st)
        let inner = tmp.to_string()
        if st.item_count == 1 && inner.starts_with("<mtext>") && inner.ends_with("</mtext>") {
          sb.write_string("<mtext>(")
          sb.write_string(inner.slice(7, inner.length() - 8))
          sb.write_string(")</mtext>")
        } else {
          sb.write_string("<mrow><mtext>(</mtext>")
          if st.item_count != 1 {
            sb.write_string("<mrow>")
            sb.write_string(inner)
            sb.write_string("</mrow>")
          } else {
            sb.write_string(inner)
          }
          sb.write_string("<mtext>)</mtext></mrow>")
        }
      }
      sb.write_string("</mtd></mtr></mtable>")
    }
    None => {
      if need_outer_mrow {
        sb.write_string("<mrow>")
      }
      mml_write_expr(sb, filtered, ctx, false)
      if need_outer_mrow {
        sb.write_string("</mrow>")
      }
    }
  }
  sb.write_string("<annotation encoding=\"application/x-tex\">")
  escape_xml_into(sb, tex)
  sb.write_string("</annotation></semantics></math></span>")
  sb.to_string()
}
