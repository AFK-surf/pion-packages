///| Core types for `texmath`: TeX math AST, parse options, errors, font metrics, and box layout IR.

///|
pub val struct ParseOptions {
  pub display_mode : Bool
  pub throw_on_error : Bool
  pub max_expand : Int
}

///|
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{
    display_mode: false,
    throw_on_error: true,
    max_expand: 1000,
  }
}

///|
pub fn ParseOptions::display() -> ParseOptions {
  ParseOptions::{
    display_mode: true,
    throw_on_error: true,
    max_expand: 1000,
  }
}

///|
pub val struct TexError {
  pub message : String
  pub position : Int
}

///|
pub fn TexError::to_string(self : TexError) -> String {
  "TeX parse error at position " + self.position.to_string() + ": " + self.message
}

///|
pub enum MathNode {
  Ord(String, String)
  Op(String, Bool, Bool, Bool, Array[MathNode])
  Bin(String)
  Rel(String)
  Open(String)
  Close(String)
  Punct(String)
  Inner(String)
  Group(Array[MathNode], Bool)
  SupSub(Option[MathNode], Option[MathNode], Option[MathNode])
  Frac(MathNode, MathNode, Bool, String, String, String, String, Bool)
  Sqrt(MathNode, Option[MathNode])
  Delim(String, String, Array[MathNode], Int, String)
  Accent(String, MathNode, Bool, Bool)
  OverUnder(String, MathNode, Option[MathNode], Bool)
  Matrix(String, Array[Array[Array[MathNode]]], Array[String], String, String, Bool)
  Styled(String, Array[MathNode])
  Color(String, Array[MathNode])
  Text(String, Array[MathNode])
  Space(String, Double)
  Phantom(Array[MathNode], Bool, Bool)
  Rule(Double, Double, Double)
}

///|
pub val struct Metrics {
  pub width : Double
  pub height : Double
  pub depth : Double
  pub italic : Double
}

///|
pub fn Metrics::zero() -> Metrics {
  Metrics::{ width: 0.0, height: 0.0, depth: 0.0, italic: 0.0 }
}

///|
pub val struct BoxGeom {
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub depth : Double
  pub font_style : String
  pub scale : Double
}

///|
pub fn BoxGeom::zero() -> BoxGeom {
  BoxGeom::{
    x: 0.0,
    y: 0.0,
    width: 0.0,
    height: 0.0,
    depth: 0.0,
    font_style: "Main-Regular",
    scale: 1.0,
  }
}

///|
pub enum LayoutBox {
  Glyph(String, BoxGeom, Double)
  HBox(Array[LayoutBox], BoxGeom)
  VBox(Array[LayoutBox], BoxGeom)
  Rule(BoxGeom)
  Kern(Double, BoxGeom)
  Delim(String, BoxGeom)
  Radical(LayoutBox, Option[LayoutBox], BoxGeom)
  ColorBox(String, LayoutBox, BoxGeom)
  ShiftBox(Double, LayoutBox, BoxGeom)
}

///|
pub fn box_geom(b : LayoutBox) -> BoxGeom {
  match b {
    Glyph(_, g, _) => g
    HBox(_, g) => g
    VBox(_, g) => g
    Rule(g) => g
    Kern(_, g) => g
    Delim(_, g) => g
    Radical(_, _, g) => g
    ColorBox(_, _, g) => g
    ShiftBox(_, _, g) => g
  }
}

///|
pub fn box_metrics(b : LayoutBox) -> Metrics {
  match b {
    Glyph(_, g, it) =>
    Metrics::{ width: g.width, height: g.height, depth: g.depth, italic: it }
    _ => {
      let g = box_geom(b)
      Metrics::{ width: g.width, height: g.height, depth: g.depth, italic: 0.0 }
    }
  }
}
