///| KaTeX symbol tables generated from upstream `src/symbols.ts` (O(1) ASCII + first-char bucketed dispatch).

///|
pub val struct SymbolInfo {
  pub group : String
  pub font : String
  pub replace : String
}

///|
fn lookup_math_symbol_bs_32(name : String) -> Option[SymbolInfo] {
  match name {
    "\\ " => Some(SymbolInfo::{ group: "spacing", font: "main", replace: " " })
    _ => None
  }
}

///|
fn lookup_math_symbol_bs_35(name : String) -> Option[SymbolInfo] {
  match name {
    "\\#" => Some(SymbolInfo::{ group: "textord", font: "main", replace: "#" })
    _ => None
  }
}

