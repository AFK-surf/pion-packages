let TEXT_BS_TBL : String = "$ 3% $\"7%¨$#%$#$$%$$$%%$%$&%$&$'7%ˊ$.7%˙$=7%ˉ%AE%%Æ$H7%˝$O%%Ø%OE%%Œ$P%%¶$S%%§$^7%ˆ$_%$_$`7%ˋ%ae%%æ$c7%¸,checkmark&&✓+circledR&%®&dag%&†'ddag%&‡)degree%%°$i%%ı$j%%ȷ)lbrack%$[(ldots1&…*maltese&&✠/nobreakspace3% $o%%ø%oe%%œ)pounds%%£$r7%˚)rbrack%$](space3% %ss%%ß2textasciicircum%$^1textasciitilde%$~0textbackslash%$\\*textbar%$|-textbardbl%&∥0textbraceleft%${1textbraceright%$}.textcircled7&◯-textdagger%&†0textdaggerdbl%&‡-textdegree%%°-textdollar%$$/textellipsis1&…-textemdash%&—-textendash%&–.textgreater%$>+textless%$<3textquotedblleft%&“4textquotedblright%&”0textquoteleft%&‘1textquoteright%&’/textsterling%%£1textunderscore%$_$u7%˘$v7%ˇ+varvdots%&⋮&yen&%¥${%${$}%$}$~7%˜"

///|
let TEXT_UNI_TBL : String = "%''%&”%--%&–&---%&—%``%&“%£%%£%¥&%¥%°%%°%·%&⋅%Æ%%Æ%Ð%%Ð%Ø%%Ø%Þ%%Þ%ß%%ß%æ%%æ%ð%%ð%ø%%ø%þ%%þ%ı%%ı%Œ%%Œ%œ%%œ%ȷ%%ȷ&–%&–&—%&—&‘%&‘&’%&’&“%&“&”%&”&…1&…&ℂ&$C&ℍ&$H&ℎ#$h&ℕ&$N&ℙ&$P&ℚ&$Q&ℝ&$R&ℤ&$Z"

///|
pub fn lookup_math_symbol(name : String) -> Option[SymbolInfo] {
  let n = name.length()
  if n == 1 {
    let b = name[0]
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
      return Some(SymbolInfo::{ group: "mathord", font: "main", replace: name })
    }
    if b >= 48 && b <= 57 {
      return Some(SymbolInfo::{ group: "textord", font: "main", replace: name })
    }
    return match b {
      33 => Some(SymbolInfo::{ group: "close", font: "main", replace: "!" })
      34 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "\"" })
      40 => Some(SymbolInfo::{ group: "open", font: "main", replace: "(" })
      41 => Some(SymbolInfo::{ group: "close", font: "main", replace: ")" })
      42 => Some(SymbolInfo::{ group: "bin", font: "main", replace: "∗" })
      43 => Some(SymbolInfo::{ group: "bin", font: "main", replace: "+" })
      44 => Some(SymbolInfo::{ group: "punct", font: "main", replace: "," })
      45 => Some(SymbolInfo::{ group: "bin", font: "main", replace: "−" })
      46 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "." })
      47 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "/" })
      58 => Some(SymbolInfo::{ group: "rel", font: "main", replace: ":" })
      59 => Some(SymbolInfo::{ group: "punct", font: "main", replace: ";" })
      60 => Some(SymbolInfo::{ group: "rel", font: "main", replace: "<" })
      61 => Some(SymbolInfo::{ group: "rel", font: "main", replace: "=" })
      62 => Some(SymbolInfo::{ group: "rel", font: "main", replace: ">" })
      63 => Some(SymbolInfo::{ group: "close", font: "main", replace: "?" })
      64 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "@" })
      91 => Some(SymbolInfo::{ group: "open", font: "main", replace: "[" })
      93 => Some(SymbolInfo::{ group: "close", font: "main", replace: "]" })
      96 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "‘" })
      124 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "∣" })
      _ => None
    }
  }
  if n >= 2 && name[0] == 92 {
    let (s, e) = math_bs_range(name[1])
    if s < e {
      return sym_scan_table(MATH_BS_TBL, s, e, name, 1)
    }
    return None
  }
  if n == 4 && name[0] == 0xF0 && name[1] == 0x9D {
    return lookup_math_alnum(name, "mathord")
  }
  if n > 0 {
    let (s, e) = math_uni_range(name[0])
    if s < e {
      return sym_scan_table(MATH_UNI_TBL, s, e, name, 0)
    }
  }
  None
}

///|
pub fn lookup_text_symbol(name : String) -> Option[SymbolInfo] {
  let n = name.length()
  if n == 1 {
    let b = name[0]
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) {
      return Some(SymbolInfo::{ group: "textord", font: "main", replace: name })
    }
    return match b {
      32 => Some(SymbolInfo::{ group: "spacing", font: "main", replace: " " })
      33 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "!" })
      34 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "\"" })
      39 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "’" })
      40 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "(" })
      41 => Some(SymbolInfo::{ group: "textord", font: "main", replace: ")" })
      42 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "*" })
      43 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "+" })
      44 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "," })
      45 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "-" })
      46 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "." })
      47 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "/" })
      58 => Some(SymbolInfo::{ group: "textord", font: "main", replace: ":" })
      59 => Some(SymbolInfo::{ group: "textord", font: "main", replace: ";" })
      60 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "<" })
      61 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "=" })
      62 => Some(SymbolInfo::{ group: "textord", font: "main", replace: ">" })
      63 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "?" })
      64 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "@" })
      91 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "[" })
      93 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "]" })
      96 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "‘" })
      124 => Some(SymbolInfo::{ group: "textord", font: "main", replace: "|" })
      _ => None
    }
  }
  if n >= 2 && name[0] == 92 {
    let (s, e) = text_bs_range(name[1])
    if s < e {
      return sym_scan_table(TEXT_BS_TBL, s, e, name, 1)
    }
    return None
  }
  if n == 4 && name[0] == 0xF0 && name[1] == 0x9D {
    return lookup_math_alnum(name, "textord")
  }
  if n > 0 {
    let (s, e) = text_uni_range(name[0])
    if s < e {
      return sym_scan_table(TEXT_UNI_TBL, s, e, name, 0)
    }
  }
  None
}
