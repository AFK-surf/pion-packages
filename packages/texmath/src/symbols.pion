///| KaTeX symbol tables (compact packed byte-table + O(1) ASCII/alnum dispatch).

///|
pub val struct SymbolInfo {
  pub group : String
  pub font : String
  pub replace : String
}

///|
fn sym_group_name(id : Int) -> String {
  match id {
    0 => "mathord"
    1 => "textord"
    2 => "bin"
    3 => "rel"
    4 => "open"
    5 => "close"
    6 => "punct"
    7 => "inner"
    8 => "spacing"
    9 => "accent"
    10 => "accent-token"
    _ => "op-token"
  }
}

///|
fn sym_scan_table(
  tbl : String,
  start : Int,
  end : Int,
  name : String,
  name_off : Int,
) -> Option[SymbolInfo] {
  let target_len = name.length() - name_off
  let mut p = start
  while p < end {
    let klen = tbl[p] - 35
    let key_start = p + 1
    let meta_pos = key_start + klen
    let rlen = tbl[meta_pos + 1] - 35
    let rep_start = meta_pos + 2
    if klen == target_len {
      let mut eq = true
      let mut i = 0
      while i < klen {
        if tbl[key_start + i] != name[name_off + i] {
          eq = false
          break
        }
        i = i + 1
      }
      if eq {
        let meta = tbl[meta_pos] - 35
        let group = sym_group_name(meta >> 1)
        let font = if (meta & 1) == 0 { "main" } else { "ams" }
        let replace = tbl.slice(rep_start, rep_start + rlen)
        return Some(SymbolInfo::{ group, font, replace })
      }
    }
    p = rep_start + rlen
  }
  None
}

///| O(1) decoder for Unicode Mathematical Alphanumeric Symbols (U+1D400..U+1D7FF).
fn lookup_math_alnum(name : String, group : String) -> Option[SymbolInfo] {
  let cp = ((name[0] & 0x07) << 18) | ((name[1] & 0x3F) << 12) | ((name[2] & 0x3F) << 6) | (name[3] & 0x3F)
  let idx = if cp >= 0x1D400 && cp <= 0x1D4B5 {
    (cp - 0x1D400) % 52
  } else if cp >= 0x1D504 && cp <= 0x1D551 {
    (cp - 0x1D504) % 52
  } else if cp == 0x1D55C {
    36 // 'k'
  } else if cp >= 0x1D56C && cp <= 0x1D63B {
    (cp - 0x1D56C) % 52
  } else if cp >= 0x1D670 && cp <= 0x1D6A3 {
    cp - 0x1D670
  } else if cp >= 0x1D7CE && cp <= 0x1D7D7 {
    52 + (cp - 0x1D7CE)
  } else if cp >= 0x1D7E2 && cp <= 0x1D7FF {
    52 + (cp - 0x1D7E2) % 10
  } else {
    -1
  }
  if idx < 0 {
    return None
  }
  let alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
  Some(SymbolInfo::{ group, font: "main", replace: alnum.slice(idx, idx + 1) })
}

