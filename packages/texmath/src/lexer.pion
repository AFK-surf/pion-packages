///| Pure byte-scanning TeX Lexer ported from KaTeX `src/Lexer.ts`.

///|
pub val struct Token {
  pub text : String
  pub start : Int
  pub end : Int
  pub noexpand : Bool
}

///|
pub fn Token::new(text : String, start : Int, end : Int) -> Token {
  Token::{ text, start, end, noexpand: false }
}

///|
pub fn Token::eof(pos : Int) -> Token {
  Token::{ text: "EOF", start: pos, end: pos, noexpand: false }
}

///|
pub struct Lexer {
  input : String
  len : Int
  mut pos : Int
}

///|
pub fn Lexer::new(input : String) -> Lexer {
  Lexer::{ input, len: input.length(), pos: 0 }
}

///|
fn is_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn is_ascii_letter_or_at(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 64
}

///|
fn utf8_char_len(b : Int) -> Int {
  if b < 0x80 {
    1
  } else if (b & 0xE0) == 0xC0 {
    2
  } else if (b & 0xF0) == 0xE0 {
    3
  } else if (b & 0xF8) == 0xF0 {
    4
  } else {
    1
  }
}

///|
pub fn lexer_next(lex : Lexer) -> Result[Token, TexError] {
  while lex.pos < lex.len {
    let start = lex.pos
    let b = lex.input[start]
    // Comment character '%'
    if b == 37 {
      lex.pos = start + 1
      while lex.pos < lex.len && lex.input[lex.pos] != 10 {
        lex.pos = lex.pos + 1
      }
      if lex.pos < lex.len && lex.input[lex.pos] == 10 {
        lex.pos = lex.pos + 1
      }
      continue
    }
    // Regular whitespace
    if is_ws(b) {
      let mut p = start + 1
      while p < lex.len && is_ws(lex.input[p]) {
        p = p + 1
      }
      lex.pos = p
      return Ok(Token::new(" ", start, p))
    }
    // Backslash control sequence
    if b == 92 {
      if start + 1 >= lex.len {
        lex.pos = start + 1
        return Err(TexError::{
          message: "Unexpected character: '\\'",
          position: start + 1,
        })
      }
      let nb = lex.input[start + 1]
      // Control space: \<whitespace>
      if is_ws(nb) {
        let mut p = start + 2
        while p < lex.len && (lex.input[p] == 32 || lex.input[p] == 9 || lex.input[p] == 13) {
          p = p + 1
        }
        lex.pos = p
        return Ok(Token::new("\\ ", start, p))
      }
      // Control word: \[a-zA-Z@]+ followed by optional whitespace
      if is_ascii_letter_or_at(nb) {
        let mut word_end = start + 2
        while word_end < lex.len && is_ascii_letter_or_at(lex.input[word_end]) {
          word_end = word_end + 1
        }
        let text = lex.input.slice(start, word_end)
        let mut p = word_end
        while p < lex.len && is_ws(lex.input[p]) {
          p = p + 1
        }
        lex.pos = p
        return Ok(Token::new(text, start, p))
      }
      // Control symbol: \<single UTF-8 char>
      let clen = utf8_char_len(nb)
      let end = if start + 1 + clen <= lex.len { start + 1 + clen } else { lex.len }
      lex.pos = end
      return Ok(Token::new(lex.input.slice(start, end), start, end))
    }
    // Control chars 0x00..0x1F (other than ws) are unexpected
    if b < 32 {
      lex.pos = start + 1
      return Err(TexError::{
        message: "Unexpected character",
        position: start + 1,
      })
    }
    // Single UTF-8 character
    let clen = utf8_char_len(b)
    let end = if start + clen <= lex.len { start + clen } else { lex.len }
    lex.pos = end
    return Ok(Token::new(lex.input.slice(start, end), start, end))
  }
  Ok(Token::eof(lex.len))
}

///| Lex an entire string into tokens in reverse order (for macro expansion stack).
pub fn lex_all_reversed(s : String) -> Result[Array[Token], TexError] {
  let lex = Lexer::new(s)
  let toks : Array[Token] = Array::new()
  while true {
    match lexer_next(lex) {
      Ok(tok) => {
        if tok.text == "EOF" {
          break
        }
        toks.push(tok)
      }
      Err(e) => return Err(e)
    }
  }
  // Reverse in place
  let n = toks.length()
  let mut i = 0
  while i < n / 2 {
    let tmp = toks[i]
    toks[i] = toks[n - 1 - i]
    toks[n - 1 - i] = tmp
    i = i + 1
  }
  Ok(toks)
}
