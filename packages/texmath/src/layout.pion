///| TeX Box Metrics Layout IR engine ported from KaTeX `buildCommon.ts`, `buildHTML.ts`, `Style.ts`, and TeXbook Rules 11, 12, 13, 15, 18.

///| TeX math styles:
///| 0 = D (Display), 1 = Dc, 2 = T (Text), 3 = Tc, 4 = S (Script), 5 = Sc, 6 = SS (ScriptScript), 7 = SSc.
val struct LayoutCtx {
  style_id : Int
  font : String
  color : String
}

///|
fn ctx_default(display_mode : Bool) -> LayoutCtx {
  LayoutCtx::{
    style_id: if display_mode { 0 } else { 2 },
    font: "Math-Italic",
    color: "",
  }
}

///|
fn style_size_index(style_id : Int) -> Int {
  // 0 = text/display (>=9pt), 1 = script (7pt), 2 = scriptscript (5pt)
  if style_id < 4 {
    0
  } else if style_id < 6 {
    1
  } else {
    2
  }
}

///|
fn style_scale(style_id : Int) -> Double {
  if style_id < 4 {
    1.0
  } else if style_id < 6 {
    0.7
  } else {
    0.5
  }
}

///|
fn style_is_display(style_id : Int) -> Bool {
  style_id == 0 || style_id == 1
}

///|
fn style_is_cramped(style_id : Int) -> Bool {
  (style_id & 1) == 1
}

///|
fn style_is_tight(style_id : Int) -> Bool {
  style_id >= 4
}

///|
fn style_cramp(style_id : Int) -> Int {
  style_id | 1
}

///|
fn style_sup(style_id : Int) -> Int {
  match style_id {
    0 | 2 => 4
    1 | 3 => 5
    4 | 6 => 6
    _ => 7
  }
}

///|
fn style_sub(style_id : Int) -> Int {
  if style_id < 4 { 5 } else { 7 }
}

///|
fn style_frac_num(style_id : Int) -> Int {
  match style_id {
    0 => 2
    1 => 3
    2 => 4
    3 => 5
    4 | 6 => 6
    _ => 7
  }
}

///|
fn style_frac_den(style_id : Int) -> Int {
  match style_id {
    0 | 1 => 3
    2 | 3 => 5
    _ => 7
  }
}

///|
fn max_d(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

///|
fn min_d(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

///| Decode the first UTF-8 codepoint of a string.
fn first_codepoint(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return 0
  }
  let b0 = s[0]
  if b0 < 0x80 {
    b0
  } else if (b0 & 0xE0) == 0xC0 && n >= 2 {
    ((b0 & 0x1F) << 6) | (s[1] & 0x3F)
  } else if (b0 & 0xF0) == 0xE0 && n >= 3 {
    ((b0 & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F)
  } else if (b0 & 0xF8) == 0xF0 && n >= 4 {
    ((b0 & 0x07) << 18) | ((s[1] & 0x3F) << 12) | ((s[2] & 0x3F) << 6) | (s[3] & 0x3F)
  } else {
    b0
  }
}

///| Resolve symbol replacement string if any.
fn resolve_symbol_char(name : String) -> String {
  match lookup_math_symbol(name) {
    Some(info) => if info.replace.length() > 0 { info.replace } else { name }
    None => name
  }
}

///| Look up real CM/KaTeX character metrics with fallback.
fn lookup_glyph_metric(ch : String, font : String) -> CharMetric {
  let cp = first_codepoint(ch)
  match get_char_metrics(font, cp) {
    Some(m) => m
    None =>
    match get_char_metrics("Main-Regular", cp) {
      Some(m) => m
      None =>
      match get_char_metrics("AMS-Regular", cp) {
        Some(m) => m
        None =>
        // Fallback to 'M' or standard 0.5em box
        CharMetric::{ depth: 0.0, height: 0.68333, italic: 0.0, skew: 0.0, width: 0.5 }
      }
    }
  }
}

///|
fn make_glyph_box(ch : String, font : String, scale : Double) -> LayoutBox {
  let m = lookup_glyph_metric(ch, font)
  let w = if m.width > 0.0 { m.width * scale } else { 0.5 * scale }
  let h = m.height * scale
  let d = m.depth * scale
  let it = m.italic * scale
  let g = BoxGeom::{
    x: 0.0,
    y: 0.0,
    width: w,
    height: h,
    depth: d,
    font_style: font,
    scale,
  }
  LayoutBox::Glyph(ch, g, it)
}

///|
fn set_box_xy(b : LayoutBox, nx : Double, ny : Double) -> LayoutBox {
  let g = box_geom(b)
  let ng = BoxGeom::{
    x: nx,
    y: ny,
    width: g.width,
    height: g.height,
    depth: g.depth,
    font_style: g.font_style,
    scale: g.scale,
  }
  match b {
    Glyph(s, _, it) => LayoutBox::Glyph(s, ng, it)
    HBox(ch, _) => LayoutBox::HBox(ch, ng)
    VBox(ch, _) => LayoutBox::VBox(ch, ng)
    Rule(_) => LayoutBox::Rule(ng)
    Kern(w, _) => LayoutBox::Kern(w, ng)
    Delim(s, _) => LayoutBox::Delim(s, ng)
    Radical(body, idx, _) => LayoutBox::Radical(body, idx, ng)
    ColorBox(c, inner, _) => LayoutBox::ColorBox(c, inner, ng)
    ShiftBox(sh, inner, _) => LayoutBox::ShiftBox(sh, inner, ng)
  }
}

///| Classify a MathNode into TeX atom class:
///| 0=ord, 1=op, 2=bin, 3=rel, 4=open, 5=close, 6=punct, 7=inner
fn node_atom_class(n : MathNode) -> Int {
  match n {
    Ord(_, _) => 0
    Op(_, _, _, _, _) => 1
    Bin(_) => 2
    Rel(_) => 3
    Open(_) => 4
    Close(_) => 5
    Punct(_) => 6
    Inner(_) => 7
    Delim(kind, _, _, _, mc) =>
    if kind == "leftright" {
      7
    } else if mc == "mopen" {
      4
    } else if mc == "mclose" {
      5
    } else if mc == "mrel" {
      3
    } else {
      0
    }
    SupSub(Some(base), _, _) => node_atom_class(base)
    Styled(st, _) =>
    match st {
      "mclass:mbin" => 2
      "mclass:mrel" => 3
      "mclass:mopen" => 4
      "mclass:mclose" => 5
      "mclass:mpunct" => 6
      "mclass:minner" => 7
      _ => 0
    }
    _ => 0
  }
}

///| TeXbook p. 170 inter-atom spacing in mu (0, 3=thin, 4=med, 5=thick).
fn inter_atom_mu(left : Int, right : Int, tight : Bool) -> Double {
  // 0=ord, 1=op, 2=bin, 3=rel, 4=open, 5=close, 6=punct, 7=inner
  let mu = match (left, right) {
    (0, 1) => 3.0
    (0, 2) => if tight { 0.0 } else { 4.0 }
    (0, 3) => if tight { 0.0 } else { 5.0 }
    (0, 7) => if tight { 0.0 } else { 3.0 }
    (1, 0) => 3.0
    (1, 1) => 3.0
    (1, 3) => if tight { 0.0 } else { 5.0 }
    (1, 7) => if tight { 0.0 } else { 3.0 }
    (2, 0) | (2, 1) | (2, 4) | (2, 7) => if tight { 0.0 } else { 4.0 }
    (3, 0) | (3, 1) | (3, 4) | (3, 7) => if tight { 0.0 } else { 5.0 }
    (5, 1) => 3.0
    (5, 2) => if tight { 0.0 } else { 4.0 }
    (5, 3) => if tight { 0.0 } else { 5.0 }
    (5, 7) => if tight { 0.0 } else { 3.0 }
    (6, 0) | (6, 1) | (6, 3) | (6, 4) | (6, 5) | (6, 6) | (6, 7) =>
    if tight { 0.0 } else { 3.0 }
    (7, 0) | (7, 4) | (7, 6) | (7, 7) => if tight { 0.0 } else { 3.0 }
    (7, 1) => 3.0
    (7, 2) => if tight { 0.0 } else { 4.0 }
    (7, 3) => if tight { 0.0 } else { 5.0 }
    _ => 0.0
  }
  mu
}

///| Layout a horizontal sequence of MathNodes with TeX inter-atom spacing.
fn layout_list(nodes : Array[MathNode], ctx : LayoutCtx) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  let tight = style_is_tight(ctx.style_id)
  let children : Array[LayoutBox] = Array::new()
  let mut cur_x = 0.0
  let mut max_h = 0.0
  let mut max_d = 0.0
  let mut prev_cls = -1
  let n = nodes.length()
  let mut i = 0
  while i < n {
    let node = nodes[i]
    let mut cls = node_atom_class(node)
    // Bin cancellation rule: Bin at start or after Bin/Op/Rel/Open/Punct becomes Ord
    if cls == 2 {
      if prev_cls == -1 || prev_cls == 1 || prev_cls == 2 || prev_cls == 3 || prev_cls == 4 || prev_cls == 6 {
        cls = 0
      } else if i + 1 == n {
        cls = 0
      } else {
        let nxt_cls = node_atom_class(nodes[i + 1])
        if nxt_cls == 3 || nxt_cls == 5 || nxt_cls == 6 {
          cls = 0
        }
      }
    }
    if prev_cls != -1 {
      let mu = inter_atom_mu(prev_cls, cls, tight)
      if mu > 0.0 {
        let kw = mu * gm.css_em_per_mu * sc
        let kg = BoxGeom::{
          x: cur_x,
          y: 0.0,
          width: kw,
          height: 0.0,
          depth: 0.0,
          font_style: ctx.font,
          scale: sc,
        }
        children.push(LayoutBox::Kern(kw, kg))
        cur_x = cur_x + kw
      }
    }
    let child = layout_node(node, ctx)
    let cg = box_geom(child)
    let positioned = set_box_xy(child, cur_x, cg.y)
    children.push(positioned)
    cur_x = cur_x + cg.width
    max_h = max_d(max_h, cg.height)
    max_d = max_d(max_d, cg.depth)
    // Space nodes do not change prev_cls
    match node {
      Space(_, _) => ()
      _ => prev_cls = cls
    }
    i = i + 1
  }
  if children.length() == 1 {
    return children[0]
  }
  let g = BoxGeom::{
    x: 0.0,
    y: 0.0,
    width: cur_x,
    height: max_h,
    depth: max_d,
    font_style: ctx.font,
    scale: sc,
  }
  LayoutBox::HBox(children, g)
}

///|
fn font_for_style(st : String, fallback : String) -> String {
  match st {
    "mathrm" => "Main-Regular"
    "mathbf" | "boldsymbol" => "Main-Bold"
    "mathit" | "mathnormal" => "Math-Italic"
    "mathbb" => "AMS-Regular"
    "mathcal" | "mathscr" => "Caligraphic-Regular"
    "mathfrak" => "Fraktur-Regular"
    "mathsf" | "mathsfit" => "SansSerif-Regular"
    "mathtt" => "Typewriter-Regular"
    _ => fallback
  }
}

///| Layout a delimiter scaled to cover a target total height.
fn make_delim_box(delim : String, target_h : Double, target_d : Double, ctx : LayoutCtx) -> LayoutBox {
  let sc = style_scale(ctx.style_id)
  if delim == "." || delim == "" {
    let w = 0.12 * sc
    return LayoutBox::Kern(
      w,
      BoxGeom::{
        x: 0.0,
        y: 0.0,
        width: w,
        height: 0.0,
        depth: 0.0,
        font_style: "Main-Regular",
        scale: sc,
      },
    )
  }
  let ch = resolve_symbol_char(delim)
  let total = target_h + target_d
  let font = if total <= 1.2 {
    "Main-Regular"
  } else if total <= 1.8 {
    "Size1-Regular"
  } else if total <= 2.4 {
    "Size2-Regular"
  } else if total <= 3.0 {
    "Size3-Regular"
  } else {
    "Size4-Regular"
  }
  let m = lookup_glyph_metric(ch, font)
  let h = max_d(m.height * sc, target_h)
  let d = max_d(m.depth * sc, target_d)
  let w = if m.width > 0.0 { m.width * sc } else { 0.45 * sc }
  LayoutBox::Delim(
    ch,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: w,
      height: h,
      depth: d,
      font_style: font,
      scale: sc,
    },
  )
}

///| Layout a single MathNode into a LayoutBox using TeXbook rules.
fn layout_node(node : MathNode, ctx : LayoutCtx) -> LayoutBox {
  let sc = style_scale(ctx.style_id)
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  match node {
    Ord(text, fam) => {
      let ch = resolve_symbol_char(text)
      let font = if fam == "textord" {
        if ctx.font == "Math-Italic" { "Main-Regular" } else { ctx.font }
      } else {
        ctx.font
      }
      make_glyph_box(ch, font, sc)
    }
    Bin(text) | Rel(text) | Open(text) | Close(text) | Punct(text) | Inner(text) => {
      let ch = resolve_symbol_char(text)
      make_glyph_box(ch, "Main-Regular", sc)
    }
    Group(body, _) => layout_list(body, ctx)
    Space(_, w) => {
      let sw = w * sc
      LayoutBox::Kern(
        sw,
        BoxGeom::{
          x: 0.0,
          y: 0.0,
          width: sw,
          height: 0.0,
          depth: 0.0,
          font_style: ctx.font,
          scale: sc,
        },
      )
    }
    Rule(shift, w, h) => {
      let sw = w * sc
      let sh = h * sc
      let ss = shift * sc
      let top_h = max_d(0.0, sh + ss)
      let bot_d = max_d(0.0, -ss)
      LayoutBox::Rule(BoxGeom::{
        x: 0.0,
        y: ss,
        width: sw,
        height: top_h,
        depth: bot_d,
        font_style: "Main-Regular",
        scale: sc,
      })
    }
    Color(c, body) => {
      let inner = layout_list(body, LayoutCtx::{ style_id: ctx.style_id, font: ctx.font, color: c })
      let g = box_geom(inner)
      LayoutBox::ColorBox(c, inner, g)
    }
    Phantom(body, h_only, v_only) => {
      let inner = layout_list(body, ctx)
      let g = box_geom(inner)
      let w = if v_only { 0.0 } else { g.width }
      let h = if h_only { 0.0 } else { g.height }
      let d = if h_only { 0.0 } else { g.depth }
      LayoutBox::Kern(
        w,
        BoxGeom::{
          x: 0.0,
          y: 0.0,
          width: w,
          height: h,
          depth: d,
          font_style: ctx.font,
          scale: sc,
        },
      )
    }
    Text(tstyle, body) => {
      let font = match tstyle {
        "textbf" => "Main-Bold"
        "textit" => "Math-Italic"
        "textsf" => "SansSerif-Regular"
        "texttt" => "Typewriter-Regular"
        _ => "Main-Regular"
      }
      let tctx = LayoutCtx::{ style_id: ctx.style_id, font, color: ctx.color }
      layout_list(body, tctx)
    }
    Styled(st, body) => {
      if st == "style:display" {
        layout_list(body, LayoutCtx::{ style_id: 0, font: ctx.font, color: ctx.color })
      } else if st == "style:text" {
        layout_list(body, LayoutCtx::{ style_id: 2, font: ctx.font, color: ctx.color })
      } else if st == "style:script" {
        layout_list(body, LayoutCtx::{ style_id: 4, font: ctx.font, color: ctx.color })
      } else if st == "style:scriptscript" {
        layout_list(body, LayoutCtx::{ style_id: 6, font: ctx.font, color: ctx.color })
      } else if st == "math" {
        layout_list(body, LayoutCtx::{ style_id: ctx.style_id, font: "Math-Italic", color: ctx.color })
      } else {
        let nf = font_for_style(st, ctx.font)
        layout_list(body, LayoutCtx::{ style_id: ctx.style_id, font: nf, color: ctx.color })
      }
    }
    Op(name, is_sym, _limits, _always, body) => layout_op_base(name, is_sym, body, ctx)
    SupSub(base_opt, sub_opt, sup_opt) => layout_supsub(base_opt, sub_opt, sup_opt, ctx)
    Frac(numer, denom, has_bar, ld, rd, _bar_sz, fstyle, _cont) =>
    layout_frac(numer, denom, has_bar, ld, rd, fstyle, ctx)
    Sqrt(body, index_opt) => layout_sqrt(body, index_opt, ctx)
    Accent(label, base, _stretchy, _shifty) => layout_accent(label, base, ctx)
    OverUnder(kind, base, script_opt, is_over) => layout_overunder(kind, base, script_opt, is_over, ctx)
    Delim(kind, ld, body, sz, rd) => layout_delim(kind, ld, body, sz, rd, ctx)
    Matrix(_env, rows, _aligns, ld, rd, is_disp) => layout_matrix(rows, ld, rd, is_disp, ctx)
  }
}

///| Layout an operator base (Rule 13).
fn layout_op_base(name : String, is_sym : Bool, body : Array[MathNode], ctx : LayoutCtx) -> LayoutBox {
  let sc = style_scale(ctx.style_id)
  if is_sym {
    let large = style_is_display(ctx.style_id) && name != "\\smallint"
    let font = if large { "Size2-Regular" } else { "Size1-Regular" }
    let ch = resolve_symbol_char(name)
    make_glyph_box(ch, font, sc)
  } else if body.length() > 0 {
    layout_list(body, LayoutCtx::{ style_id: ctx.style_id, font: "Main-Regular", color: ctx.color })
  } else {
    // Named operator like \sin, \lim
    let label = if name.length() > 1 && name[0] == 92 { name.slice(1, name.length()) } else { name }
    let glyphs : Array[LayoutBox] = Array::new()
    let mut cx = 0.0
    let mut mh = 0.0
    let mut md = 0.0
    let mut i = 0
    while i < label.length() {
      let gb = make_glyph_box(label.slice(i, i + 1), "Main-Regular", sc)
      let gg = box_geom(gb)
      glyphs.push(set_box_xy(gb, cx, 0.0))
      cx = cx + gg.width
      mh = max_d(mh, gg.height)
      md = max_d(md, gg.depth)
      i = i + 1
    }
    LayoutBox::HBox(
      glyphs,
      BoxGeom::{
        x: 0.0,
        y: 0.0,
        width: cx,
        height: mh,
        depth: md,
        font_style: "Main-Regular",
        scale: sc,
      },
    )
  }
}

///| Layout superscript/subscript (Rule 18 & Rule 13a for display limits).
fn layout_supsub(
  base_opt : Option[MathNode],
  sub_opt : Option[MathNode],
  sup_opt : Option[MathNode],
  ctx : LayoutCtx,
) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  // Check if base is an Op that stacks limits vertically (display mode or \limits)
  let stack_limits = match base_opt {
    Some(Op(_, _, lim, always, _)) => lim && (style_is_display(ctx.style_id) || always)
    _ => false
  }
  let base_box = match base_opt {
    Some(b) => layout_node(b, ctx)
    None =>
    LayoutBox::Kern(
      0.0,
      BoxGeom::{
        x: 0.0,
        y: 0.0,
        width: 0.0,
        height: 0.0,
        depth: 0.0,
        font_style: ctx.font,
        scale: sc,
      },
    )
  }
  let bg = box_geom(base_box)
  let sup_ctx = LayoutCtx::{ style_id: style_sup(ctx.style_id), font: ctx.font, color: ctx.color }
  let sub_ctx = LayoutCtx::{ style_id: style_sub(ctx.style_id), font: ctx.font, color: ctx.color }
  if stack_limits {
    // Rule 13a: vertical stacking of upper/lower limits
    let vchildren : Array[LayoutBox] = Array::new()
    let mut total_w = bg.width
    let mut total_h = bg.height
    let mut total_d = bg.depth
    vchildren.push(base_box)
    match sup_opt {
      Some(sn) => {
        let sb = layout_node(sn, sup_ctx)
        let sg = box_geom(sb)
        let gap = max_d(gm.big_op_spacing1, gm.big_op_spacing3 - sg.depth) * sc
        let y_up = bg.height + gap + sg.depth
        vchildren.push(set_box_xy(sb, 0.0, y_up))
        total_w = max_d(total_w, sg.width)
        total_h = max_d(total_h, y_up + sg.height + gm.big_op_spacing5 * sc)
      }
      None => ()
    }
    match sub_opt {
      Some(sn) => {
        let sb = layout_node(sn, sub_ctx)
        let sg = box_geom(sb)
        let gap = max_d(gm.big_op_spacing2, gm.big_op_spacing4 - sg.height) * sc
        let y_dn = bg.depth + gap + sg.height
        vchildren.push(set_box_xy(sb, 0.0, -y_dn))
        total_w = max_d(total_w, sg.width)
        total_d = max_d(total_d, y_dn + sg.depth + gm.big_op_spacing5 * sc)
      }
      None => ()
    }
    return LayoutBox::VBox(
      vchildren,
      BoxGeom::{
        x: 0.0,
        y: 0.0,
        width: total_w,
        height: total_h,
        depth: total_d,
        font_style: ctx.font,
        scale: sc,
      },
    )
  }
  // Rule 18: side-attached superscript/subscript
  let scriptspace = (0.5 / gm.pt_per_em) * sc
  let min_sup = if ctx.style_id == 0 {
    gm.sup1 * sc
  } else if style_is_cramped(ctx.style_id) {
    gm.sup3 * sc
  } else {
    gm.sup2 * sc
  }
  let children : Array[LayoutBox] = Array::new()
  children.push(base_box)
  let mut script_w = 0.0
  let mut out_h = bg.height
  let mut out_d = bg.depth
  match (sup_opt, sub_opt) {
    (Some(sup_n), Some(sub_n)) => {
      let sup_b = layout_node(sup_n, sup_ctx)
      let sub_b = layout_node(sub_n, sub_ctx)
      let sup_g = box_geom(sup_b)
      let sub_g = box_geom(sub_b)
      let mut sup_shift = max_d(max_d(bg.height - gm.sup_drop * sc, min_sup), sup_g.depth + 0.25 * gm.x_height * sc)
      let mut sub_shift = max_d(bg.depth + gm.sub_drop * sc, gm.sub2 * sc)
      let min_gap = 4.0 * gm.default_rule_thickness * sc
      if (sup_shift - sup_g.depth) - (sub_g.height - sub_shift) < min_gap {
        sub_shift = min_gap - (sup_shift - sup_g.depth) + sub_g.height
        let psi = 0.8 * gm.x_height * sc - (sup_shift - sup_g.depth)
        if psi > 0.0 {
          sup_shift = sup_shift + psi
          sub_shift = sub_shift - psi
        }
      }
      children.push(set_box_xy(sup_b, bg.width, sup_shift))
      children.push(set_box_xy(sub_b, bg.width, -sub_shift))
      script_w = max_d(sup_g.width, sub_g.width) + scriptspace
      out_h = max_d(out_h, sup_shift + sup_g.height)
      out_d = max_d(out_d, sub_shift + sub_g.depth)
    }
    (Some(sup_n), None) => {
      let sup_b = layout_node(sup_n, sup_ctx)
      let sup_g = box_geom(sup_b)
      let sup_shift = max_d(max_d(bg.height - gm.sup_drop * sc, min_sup), sup_g.depth + 0.25 * gm.x_height * sc)
      children.push(set_box_xy(sup_b, bg.width, sup_shift))
      script_w = sup_g.width + scriptspace
      out_h = max_d(out_h, sup_shift + sup_g.height)
    }
    (None, Some(sub_n)) => {
      let sub_b = layout_node(sub_n, sub_ctx)
      let sub_g = box_geom(sub_b)
      let sub_shift = max_d(max_d(bg.depth + gm.sub_drop * sc, gm.sub1 * sc), sub_g.height - 0.8 * gm.x_height * sc)
      children.push(set_box_xy(sub_b, bg.width, -sub_shift))
      script_w = sub_g.width + scriptspace
      out_d = max_d(out_d, sub_shift + sub_g.depth)
    }
    (None, None) => ()
    _ => ()
  }
  LayoutBox::HBox(
    children,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: bg.width + script_w,
      height: out_h,
      depth: out_d,
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout fraction (Rule 15a-e).
fn layout_frac(
  numer : MathNode,
  denom : MathNode,
  has_bar : Bool,
  ld : String,
  rd : String,
  fstyle : String,
  ctx : LayoutCtx,
) -> LayoutBox {
  let eff_style = match fstyle {
    "display" => 0
    "text" => 2
    "script" => 4
    "scriptscript" => 6
    _ => ctx.style_id
  }
  let gm = get_global_metrics(style_size_index(eff_style))
  let sc = style_scale(eff_style)
  let num_b = layout_node(numer, LayoutCtx::{ style_id: style_frac_num(eff_style), font: ctx.font, color: ctx.color })
  let den_b = layout_node(denom, LayoutCtx::{ style_id: style_frac_den(eff_style), font: ctx.font, color: ctx.color })
  let ng = box_geom(num_b)
  let dg = box_geom(den_b)
  let rule_w = if has_bar { gm.default_rule_thickness * sc } else { 0.0 }
  let rule_sp = gm.default_rule_thickness * sc
  let is_disp = style_is_display(eff_style)
  let mut num_shift = if is_disp {
    gm.num1 * sc
  } else if has_bar {
    gm.num2 * sc
  } else {
    gm.num3 * sc
  }
  let mut den_shift = if is_disp { gm.denom1 * sc } else { gm.denom2 * sc }
  let clearance = if is_disp {
    if has_bar { 3.0 * rule_sp } else { 7.0 * rule_sp }
  } else if has_bar {
    rule_sp
  } else {
    3.0 * rule_sp
  }
  let axis = gm.axis_height * sc
  if has_bar {
    if (num_shift - ng.depth) - (axis + 0.5 * rule_w) < clearance {
      num_shift = num_shift + (clearance - ((num_shift - ng.depth) - (axis + 0.5 * rule_w)))
    }
    if (axis - 0.5 * rule_w) - (dg.height - den_shift) < clearance {
      den_shift = den_shift + (clearance - ((axis - 0.5 * rule_w) - (dg.height - den_shift)))
    }
  } else {
    let cand = (num_shift - ng.depth) - (dg.height - den_shift)
    if cand < clearance {
      num_shift = num_shift + 0.5 * (clearance - cand)
      den_shift = den_shift + 0.5 * (clearance - cand)
    }
  }
  let inner_w = max_d(ng.width, dg.width)
  let frac_h = num_shift + ng.height
  let frac_d = den_shift + dg.depth
  let vchildren : Array[LayoutBox] = Array::new()
  vchildren.push(set_box_xy(num_b, (inner_w - ng.width) * 0.5, num_shift))
  if has_bar {
    vchildren.push(
      LayoutBox::Rule(BoxGeom::{
        x: 0.0,
        y: axis - 0.5 * rule_w,
        width: inner_w,
        height: rule_w,
        depth: 0.0,
        font_style: "Main-Regular",
        scale: sc,
      }),
    )
  }
  vchildren.push(set_box_xy(den_b, (inner_w - dg.width) * 0.5, -den_shift))
  let frac_box = LayoutBox::VBox(
    vchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: inner_w,
      height: frac_h,
      depth: frac_d,
      font_style: ctx.font,
      scale: sc,
    },
  )
  let lbox = make_delim_box(ld, frac_h, frac_d, ctx)
  let rbox = make_delim_box(rd, frac_h, frac_d, ctx)
  let lg = box_geom(lbox)
  let rg = box_geom(rbox)
  let hchildren : Array[LayoutBox] = Array::new()
  hchildren.push(set_box_xy(lbox, 0.0, 0.0))
  hchildren.push(set_box_xy(frac_box, lg.width, 0.0))
  hchildren.push(set_box_xy(rbox, lg.width + inner_w, 0.0))
  LayoutBox::HBox(
    hchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: lg.width + inner_w + rg.width,
      height: max_d(frac_h, max_d(lg.height, rg.height)),
      depth: max_d(frac_d, max_d(lg.depth, rg.depth)),
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout square root / nth root (Rule 11).
fn layout_sqrt(body : MathNode, index_opt : Option[MathNode], ctx : LayoutCtx) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  let inner = layout_node(body, LayoutCtx::{ style_id: style_cramp(ctx.style_id), font: ctx.font, color: ctx.color })
  let ig = box_geom(inner)
  let eff_h = if ig.height == 0.0 { gm.x_height * sc } else { ig.height }
  let theta = gm.sqrt_rule_thickness * sc
  let phi = if style_is_display(ctx.style_id) { gm.x_height * sc } else { theta }
  let mut clearance = theta + 0.25 * phi
  let min_delim_h = eff_h + ig.depth + clearance + theta
  // KaTeX makeSqrtImage snaps to at least Size1 surd height (~1.0em)
  let delim_depth = max_d(min_delim_h - theta, 0.96 * sc)
  if delim_depth > eff_h + ig.depth + clearance {
    clearance = (clearance + delim_depth - eff_h - ig.depth) * 0.5
  }
  let surd_advance = 0.833 * sc
  let total_h = eff_h + clearance + theta
  let total_d = ig.depth
  let mut total_w = surd_advance + ig.width
  let idx_box_opt = match index_opt {
    Some(idx_n) => {
      let ib = layout_node(idx_n, LayoutCtx::{ style_id: 6, font: ctx.font, color: ctx.color })
      let idx_g = box_geom(ib)
      if idx_g.width > 0.3 * sc {
        total_w = total_w + (idx_g.width - 0.3 * sc)
      }
      Some(ib)
    }
    None => None
  }
  LayoutBox::Radical(
    inner,
    idx_box_opt,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: total_w,
      height: total_h,
      depth: total_d,
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout accent (Rule 12).
fn layout_accent(label : String, base : MathNode, ctx : LayoutCtx) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  let inner = layout_node(base, LayoutCtx::{ style_id: style_cramp(ctx.style_id), font: ctx.font, color: ctx.color })
  let ig = box_geom(inner)
  let acc_ch = resolve_symbol_char(label)
  let acc_box = make_glyph_box(acc_ch, "Main-Regular", sc)
  let ag = box_geom(acc_box)
  let delta = min_d(ig.height, gm.x_height * sc)
  let acc_y = ig.height - delta + 0.2 * sc
  let out_h = max_d(ig.height + 0.22 * sc, acc_y + ag.height)
  let vchildren : Array[LayoutBox] = Array::new()
  vchildren.push(inner)
  vchildren.push(set_box_xy(acc_box, 0.0, acc_y))
  LayoutBox::VBox(
    vchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: max_d(ig.width, ag.width),
      height: out_h,
      depth: ig.depth,
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout \overline, \underline, \overbrace, \underbrace, \overset, \underset.
fn layout_overunder(
  kind : String,
  base : MathNode,
  script_opt : Option[MathNode],
  is_over : Bool,
  ctx : LayoutCtx,
) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  let inner = layout_node(base, ctx)
  let ig = box_geom(inner)
  let theta = gm.default_rule_thickness * sc
  let vchildren : Array[LayoutBox] = Array::new()
  vchildren.push(inner)
  let mut out_w = ig.width
  let mut out_h = ig.height
  let mut out_d = ig.depth
  if kind == "overline" {
    let line_y = ig.height + 3.0 * theta
    vchildren.push(
      LayoutBox::Rule(BoxGeom::{
        x: 0.0,
        y: line_y,
        width: ig.width,
        height: theta,
        depth: 0.0,
        font_style: "Main-Regular",
        scale: sc,
      }),
    )
    out_h = line_y + 2.0 * theta
  } else if kind == "underline" {
    let line_y = -(ig.depth + 3.0 * theta)
    vchildren.push(
      LayoutBox::Rule(BoxGeom::{
        x: 0.0,
        y: line_y,
        width: ig.width,
        height: theta,
        depth: 0.0,
        font_style: "Main-Regular",
        scale: sc,
      }),
    )
    out_d = ig.depth + 5.0 * theta
  } else if is_over {
    let extra = match script_opt {
      Some(sn) => {
        let sb = layout_node(sn, LayoutCtx::{ style_id: style_sup(ctx.style_id), font: ctx.font, color: ctx.color })
        let sg = box_geom(sb)
        vchildren.push(set_box_xy(sb, 0.0, ig.height + 0.2 * sc))
        out_w = max_d(out_w, sg.width)
        sg.height + sg.depth + 0.2 * sc
      }
      None => 0.35 * sc
    }
    out_h = ig.height + extra
  } else {
    let extra = match script_opt {
      Some(sn) => {
        let sb = layout_node(sn, LayoutCtx::{ style_id: style_sub(ctx.style_id), font: ctx.font, color: ctx.color })
        let sg = box_geom(sb)
        vchildren.push(set_box_xy(sb, 0.0, -(ig.depth + 0.2 * sc)))
        out_w = max_d(out_w, sg.width)
        sg.height + sg.depth + 0.2 * sc
      }
      None => 0.35 * sc
    }
    out_d = ig.depth + extra
  }
  LayoutBox::VBox(
    vchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: out_w,
      height: out_h,
      depth: out_d,
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout \left...\right or sized delimiter (\big..\Bigg).
fn layout_delim(
  kind : String,
  ld : String,
  body : Array[MathNode],
  sz : Int,
  rd : String,
  ctx : LayoutCtx,
) -> LayoutBox {
  let sc = style_scale(ctx.style_id)
  if kind == "sized" {
    let target_total = match sz {
      1 => 1.2
      2 => 1.8
      3 => 2.4
      _ => 3.0
    }
    return make_delim_box(ld, target_total * 0.65 * sc, target_total * 0.35 * sc, ctx)
  }
  if kind == "middle" {
    return make_delim_box(ld, 0.75 * sc, 0.25 * sc, ctx)
  }
  // leftright
  let inner = layout_list(body, ctx)
  let ig = box_geom(inner)
  let lbox = make_delim_box(ld, ig.height, ig.depth, ctx)
  let rbox = make_delim_box(rd, ig.height, ig.depth, ctx)
  let lg = box_geom(lbox)
  let rg = box_geom(rbox)
  let hchildren : Array[LayoutBox] = Array::new()
  hchildren.push(set_box_xy(lbox, 0.0, 0.0))
  hchildren.push(set_box_xy(inner, lg.width, 0.0))
  hchildren.push(set_box_xy(rbox, lg.width + ig.width, 0.0))
  LayoutBox::HBox(
    hchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: lg.width + ig.width + rg.width,
      height: max_d(ig.height, max_d(lg.height, rg.height)),
      depth: max_d(ig.depth, max_d(lg.depth, rg.depth)),
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Layout matrix/array environment.
fn layout_matrix(
  rows : Array[Array[Array[MathNode]]],
  ld : String,
  rd : String,
  is_disp : Bool,
  ctx : LayoutCtx,
) -> LayoutBox {
  let gm = get_global_metrics(style_size_index(ctx.style_id))
  let sc = style_scale(ctx.style_id)
  let cell_ctx = LayoutCtx::{
    style_id: if is_disp { 0 } else { 2 },
    font: "Math-Italic",
    color: ctx.color,
  }
  let nrows = rows.length()
  let mut ncols = 0
  let mut r = 0
  while r < nrows {
    if rows[r].length() > ncols {
      ncols = rows[r].length()
    }
    r = r + 1
  }
  let col_widths : Array[Double] = Array::new()
  let mut c = 0
  while c < ncols {
    col_widths.push(0.0)
    c = c + 1
  }
  let cell_boxes : Array[Array[LayoutBox]] = Array::new()
  let row_heights : Array[Double] = Array::new()
  let row_depths : Array[Double] = Array::new()
  r = 0
  while r < nrows {
    let row_b : Array[LayoutBox] = Array::new()
    let mut rh = 0.7 * sc
    let mut rd_v = 0.3 * sc
    c = 0
    while c < rows[r].length() {
      let cb = layout_list(rows[r][c], cell_ctx)
      let cg = box_geom(cb)
      if cg.width > col_widths[c] {
        col_widths[c] = cg.width
      }
      rh = max_d(rh, cg.height)
      rd_v = max_d(rd_v, cg.depth)
      row_b.push(cb)
      c = c + 1
    }
    cell_boxes.push(row_b)
    row_heights.push(rh)
    row_depths.push(rd_v)
    r = r + 1
  }
  let col_gap = 1.0 * sc
  let row_gap = 0.2 * sc
  let mut total_w = 0.0
  c = 0
  while c < ncols {
    total_w = total_w + col_widths[c]
    if c + 1 < ncols {
      total_w = total_w + col_gap
    }
    c = c + 1
  }
  let mut total_span = 0.0
  r = 0
  while r < nrows {
    total_span = total_span + row_heights[r] + row_depths[r]
    if r + 1 < nrows {
      total_span = total_span + row_gap
    }
    r = r + 1
  }
  let axis = gm.axis_height * sc
  let mat_h = total_span * 0.5 + axis
  let mat_d = max_d(0.0, total_span * 0.5 - axis)
  let vchildren : Array[LayoutBox] = Array::new()
  let mut cur_y = mat_h
  r = 0
  while r < nrows {
    cur_y = cur_y - row_heights[r]
    let mut cur_x = 0.0
    c = 0
    while c < cell_boxes[r].length() {
      let cb = cell_boxes[r][c]
      let cg = box_geom(cb)
      let x_off = cur_x + (col_widths[c] - cg.width) * 0.5
      vchildren.push(set_box_xy(cb, x_off, cur_y))
      cur_x = cur_x + col_widths[c] + col_gap
      c = c + 1
    }
    cur_y = cur_y - row_depths[r] - row_gap
    r = r + 1
  }
  let mat_box = LayoutBox::VBox(
    vchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: total_w,
      height: mat_h,
      depth: mat_d,
      font_style: ctx.font,
      scale: sc,
    },
  )
  if ld.length() == 0 && rd.length() == 0 {
    return mat_box
  }
  let lbox = make_delim_box(ld, mat_h, mat_d, ctx)
  let rbox = make_delim_box(rd, mat_h, mat_d, ctx)
  let lg = box_geom(lbox)
  let rg = box_geom(rbox)
  let hchildren : Array[LayoutBox] = Array::new()
  hchildren.push(set_box_xy(lbox, 0.0, 0.0))
  hchildren.push(set_box_xy(mat_box, lg.width, 0.0))
  hchildren.push(set_box_xy(rbox, lg.width + total_w, 0.0))
  LayoutBox::HBox(
    hchildren,
    BoxGeom::{
      x: 0.0,
      y: 0.0,
      width: lg.width + total_w + rg.width,
      height: max_d(mat_h, max_d(lg.height, rg.height)),
      depth: max_d(mat_d, max_d(lg.depth, rg.depth)),
      font_style: ctx.font,
      scale: sc,
    },
  )
}

///| Top-level layout entry point.
pub fn layout_nodes(nodes : Array[MathNode], display_mode : Bool) -> LayoutBox {
  layout_list(nodes, ctx_default(display_mode))
}
