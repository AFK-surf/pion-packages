///| Public API entry points for `texmath`.

///|
pub fn parse(tex : String, opts : ParseOptions) -> Result[Array[MathNode], TexError] {
  parse_tex(tex, opts)
}

///|
pub fn layout(nodes : Array[MathNode], display_mode : Bool) -> LayoutBox {
  layout_nodes(nodes, display_mode)
}

///|
pub fn to_mathml(tex : String, display_mode : Bool) -> Result[String, TexError] {
  let opts = if display_mode { ParseOptions::display() } else { ParseOptions::default() }
  match parse_tex(tex, opts) {
    Ok(nodes) => Ok(build_mathml_string(nodes, tex, display_mode))
    Err(e) => Err(e)
  }
}

///|
pub fn render_layout(tex : String, display_mode : Bool) -> Result[LayoutBox, TexError] {
  let opts = if display_mode { ParseOptions::display() } else { ParseOptions::default() }
  match parse_tex(tex, opts) {
    Ok(nodes) => Ok(layout_nodes(nodes, display_mode))
    Err(e) => Err(e)
  }
}
