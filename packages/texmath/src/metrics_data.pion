///|
pub fn get_char_metrics(font : String, cp : Int) -> Option[CharMetric] {
  match font {
    "Main-Regular" => metrics_main_regular(cp)
    "Math-Italic" => metrics_math_italic(cp)
    "Main-Bold" => metrics_main_bold(cp)
    "Size1-Regular" => metrics_size1_regular(cp)
    "Size2-Regular" => metrics_size2_regular(cp)
    "Size3-Regular" => metrics_size3_regular(cp)
    "Size4-Regular" => metrics_size4_regular(cp)
    "AMS-Regular" => metrics_ams_regular(cp)
    "Caligraphic-Regular" => metrics_caligraphic_regular(cp)
    "Fraktur-Regular" => metrics_fraktur_regular(cp)
    "SansSerif-Regular" => metrics_sansserif_regular(cp)
    "Typewriter-Regular" => metrics_typewriter_regular(cp)
    _ => metrics_main_regular(cp)
  }
}

///|
pub val struct GlobalMetrics {
  pub x_height : Double
  pub quad : Double
  pub num1 : Double
  pub num2 : Double
  pub num3 : Double
  pub denom1 : Double
  pub denom2 : Double
  pub sup1 : Double
  pub sup2 : Double
  pub sup3 : Double
  pub sub1 : Double
  pub sub2 : Double
  pub sup_drop : Double
  pub sub_drop : Double
  pub delim1 : Double
  pub delim2 : Double
  pub axis_height : Double
  pub default_rule_thickness : Double
  pub big_op_spacing1 : Double
  pub big_op_spacing2 : Double
  pub big_op_spacing3 : Double
  pub big_op_spacing4 : Double
  pub big_op_spacing5 : Double
  pub sqrt_rule_thickness : Double
  pub pt_per_em : Double
  pub css_em_per_mu : Double
}

///|
pub fn get_global_metrics(size_idx : Int) -> GlobalMetrics {
  if size_idx <= 0 {
    GlobalMetrics::{
      x_height: 0.431,
      quad: 1.0,
      num1: 0.677,
      num2: 0.394,
      num3: 0.444,
      denom1: 0.686,
      denom2: 0.345,
      sup1: 0.413,
      sup2: 0.363,
      sup3: 0.289,
      sub1: 0.15,
      sub2: 0.247,
      sup_drop: 0.386,
      sub_drop: 0.05,
      delim1: 2.39,
      delim2: 1.01,
      axis_height: 0.25,
      default_rule_thickness: 0.04,
      big_op_spacing1: 0.111,
      big_op_spacing2: 0.166,
      big_op_spacing3: 0.2,
      big_op_spacing4: 0.6,
      big_op_spacing5: 0.1,
      sqrt_rule_thickness: 0.04,
      pt_per_em: 10.0,
      css_em_per_mu: 1.0 / 18.0,
    }
  } else if size_idx == 1 {
    GlobalMetrics::{
      x_height: 0.431,
      quad: 1.171,
      num1: 0.732,
      num2: 0.384,
      num3: 0.471,
      denom1: 0.752,
      denom2: 0.344,
      sup1: 0.503,
      sup2: 0.431,
      sup3: 0.286,
      sub1: 0.143,
      sub2: 0.286,
      sup_drop: 0.353,
      sub_drop: 0.071,
      delim1: 1.7,
      delim2: 1.157,
      axis_height: 0.25,
      default_rule_thickness: 0.049,
      big_op_spacing1: 0.111,
      big_op_spacing2: 0.166,
      big_op_spacing3: 0.2,
      big_op_spacing4: 0.611,
      big_op_spacing5: 0.143,
      sqrt_rule_thickness: 0.04,
      pt_per_em: 10.0,
      css_em_per_mu: 1.171 / 18.0,
    }
  } else {
    GlobalMetrics::{
      x_height: 0.431,
      quad: 1.472,
      num1: 0.925,
      num2: 0.387,
      num3: 0.504,
      denom1: 1.025,
      denom2: 0.532,
      sup1: 0.504,
