///| TeX MacroExpander ("gullet") ported from KaTeX `src/MacroExpander.ts` and `src/macros.ts`.

///|
pub struct MacroDef {
  pub tokens : Array[Token]
  pub num_args : Int
}

///|
pub struct MacroExpander {
  lexer : Lexer
  mut stack : Option[Array[Token]]
  mut global_scope : Option[Map[String, MacroDef]]
  mut local_scopes : Option[Array[(Int, Map[String, MacroDef])]]
  mut group_depth : Int
  mut has_user_macros : Bool
  mut expansion_count : Int
  max_expand : Int
  max_tokens : Int
}

///|
pub fn MacroExpander::new(input : String, max_expand : Int) -> MacroExpander {
  MacroExpander::{
    lexer: Lexer::new(input),
    stack: None,
    global_scope: None,
    local_scopes: None,
    group_depth: 0,
    has_user_macros: false,
    expansion_count: 0,
    max_expand,
    max_tokens: 65536,
  }
}

///|
fn expander_stack(g : MacroExpander) -> Array[Token] {
  match g.stack {
    Some(s) => s
    None => {
      let s : Array[Token] = Array::new()
      g.stack = Some(s)
      s
    }
  }
}

///|
fn expander_global_scope(g : MacroExpander) -> Map[String, MacroDef] {
  match g.global_scope {
    Some(m) => m
    None => {
      let m : Map[String, MacroDef] = Map::new()
      g.global_scope = Some(m)
      m
    }
  }
}

///|
fn expander_local_scopes(g : MacroExpander) -> Array[(Int, Map[String, MacroDef])] {
  match g.local_scopes {
    Some(ls) => ls
    None => {
      let ls : Array[(Int, Map[String, MacroDef])] = Array::new()
      g.local_scopes = Some(ls)
      ls
    }
  }
}

///|
pub fn expander_begin_group(g : MacroExpander) -> Unit {
  g.group_depth = g.group_depth + 1
}

///|
pub fn expander_end_group(g : MacroExpander) -> Unit {
  if g.has_user_macros {
    match g.local_scopes {
      Some(ls) => {
        while ls.length() > 0 {
          let (d, _) = ls[ls.length() - 1]
          if d >= g.group_depth {
            let _ = ls.pop()
          } else {
            break
          }
        }
      }
      None => ()
    }
  }
  if g.group_depth > 0 {
    g.group_depth = g.group_depth - 1
  }
}

///|
pub fn expander_define(g : MacroExpander, name : String, def : MacroDef) -> Unit {
  g.has_user_macros = true
  if g.group_depth == 0 {
    expander_global_scope(g).set(name, def)
    return
  }
  let ls = expander_local_scopes(g)
  let n = ls.length()
  if n > 0 {
    let (d, m) = ls[n - 1]
    if d == g.group_depth {
      m.set(name, def)
      return
    }
  }
  let m : Map[String, MacroDef] = Map::new()
  m.set(name, def)
  ls.push((g.group_depth, m))
}

///|
pub fn expander_define_global(g : MacroExpander, name : String, def : MacroDef) -> Unit {
  g.has_user_macros = true
  expander_global_scope(g).set(name, def)
  // Also update any active local scope that shadows `name`
  match g.local_scopes {
    Some(ls) => {
      let mut i = 0
      while i < ls.length() {
        let (_, m) = ls[i]
        if m.get(name) is Some(_) {
          m.set(name, def)
        }
        i = i + 1
      }
    }
    None => ()
  }
}

///|
pub fn lookup_user_macro(g : MacroExpander, name : String) -> Option[MacroDef] {
  if !g.has_user_macros {
    return None
  }
  match g.local_scopes {
    Some(ls) => {
      let mut i = ls.length() - 1
      while i >= 0 {
        let (_, m) = ls[i]
        match m.get(name) {
          Some(d) => return Some(d)
          None => ()
        }
        i = i - 1
      }
    }
    None => ()
  }
  match g.global_scope {
    Some(gs) => gs.get(name)
    None => None
  }
}

///|
pub fn expander_is_defined(g : MacroExpander, name : String) -> Bool {
  lookup_user_macro(g, name) is Some(_) || lookup_builtin_macro(name) is Some(_)
}

///| Built-in KaTeX macros (O(1) second-char bucketed static match, from `src/macros.ts`).
fn lookup_builtin_macro(name : String) -> Option[(String, Int)] {
  if name.length() < 3 || name[0] != 92 {
    return None
  }
  match name[1] {
    97 =>
    match name {
      "\\argmax" => Some(("\\operatorname*{arg\\,max}", 0))
      "\\argmin" => Some(("\\operatorname*{arg\\,min}", 0))
      "\\angln" => Some(("\\angl{n}", 0))
      _ => None
    }
    98 =>
    match name {
      "\\bmod" => Some(("\\mkern1mu\\mathbin{\\mathrm{mod}}\\mkern1mu", 0))
      "\\blue" => Some(("\\textcolor{#6495ed}{#1}", 1))
      _ => None
    }
    99 =>
    match name {
      "\\cdots" => Some(("\\@cdots", 0))
      "\\colon" => Some((":", 0))
      _ => None
    }
    100 =>
    match name {
      "\\dotsb" => Some(("\\@cdots", 0))
      "\\dotsm" => Some(("\\@cdots", 0))
      "\\dotsi" => Some(("\\@cdots", 0))
      "\\dotsc" => Some(("\\mathellipsis", 0))
      "\\dotso" => Some(("\\mathellipsis", 0))
      _ => None
    }
    101 => if name == "\\emptyset" { Some(("\\varnothing", 0)) } else { None }
    103 =>
    match name {
      "\\ge" => Some(("\\geq", 0))
      "\\gets" => Some(("\\leftarrow", 0))
      "\\green" => Some(("\\textcolor{#28ae7b}{#1}", 1))
      "\\gray" => Some(("\\textcolor{gray}{#1}", 1))
      _ => None
    }
    105 =>
    match name {
      "\\iff" => Some(("\\;\\Longleftrightarrow\\;", 0))
      "\\implies" => Some(("\\;\\Longrightarrow\\;", 0))
      "\\impliedby" => Some(("\\;\\Longleftarrow\\;", 0))
      "\\iffalse" => Some(("", 0))
      _ => None
    }
    107 =>
    match name {
      "\\kaBlue" => Some(("\\textcolor{#314453}{#1}", 1))
      "\\kaGreen" => Some(("\\textcolor{#71B307}{#1}", 1))
      _ => None
    }
    108 =>
    match name {
      "\\le" => Some(("\\leq", 0))
      "\\land" => Some(("\\wedge", 0))
      "\\lor" => Some(("\\vee", 0))
      "\\lnot" => Some(("\\neg", 0))
      "\\ldots" => Some(("\\mathellipsis", 0))
      _ => None
    }
    109 =>
    match name {
      "\\mod" => Some(("\\quad\\mathrm{mod}\\;#1", 1))
      "\\mathstrut" => Some(("\\vphantom{(}", 0))
      _ => None
    }
    110 => if name == "\\ne" { Some(("\\neq", 0)) } else { None }
    111 =>
    match name {
      "\\owns" => Some(("\\ni", 0))
      "\\orange" => Some(("\\textcolor{#ffa500}{#1}", 1))
      _ => None
    }
    112 =>
    match name {
      "\\pmod" => Some(("\\quad(\\mathrm{mod}\\;#1)", 1))
      "\\pod" => Some(("\\quad(#1)", 1))
      "\\purple" => Some(("\\textcolor{#9d38bd}{#1}", 1))
      "\\pink" => Some(("\\textcolor{#ff00af}{#1}", 1))
      "\\plim" => Some(("\\mathop{\\operatorname{plim}}\\limits", 0))
      _ => None
    }
    114 => if name == "\\red" { Some(("\\textcolor{#df0030}{#1}", 1)) } else { None }
    115 => if name == "\\stackrel" { Some(("\\mathrel{\\mathop{#2}\\limits^{#1}}", 2)) } else { None }
    116 => if name == "\\to" { Some(("\\rightarrow", 0)) } else { None }
    _ => None
  }
}

///|
pub fn expander_future(g : MacroExpander) -> Result[Token, TexError] {
  let st = expander_stack(g)
  if st.length() == 0 {
    match lexer_next(g.lexer) {
      Ok(tok) => st.push(tok)
      Err(e) => return Err(e)
    }
  }
  Ok(st[st.length() - 1])
}

///|
pub fn expander_pop(g : MacroExpander) -> Result[Token, TexError] {
  match g.stack {
    Some(st) =>
    if st.length() > 0 {
      match st.pop() {
        Some(tok) => return Ok(tok)
        None => ()
      }
    }
    None => ()
  }
  lexer_next(g.lexer)
}

///|
pub fn expander_push(g : MacroExpander, tok : Token) -> Unit {
  expander_stack(g).push(tok)
}

///|
pub fn expander_push_tokens(g : MacroExpander, toks : Array[Token]) -> Unit {
  let st = expander_stack(g)
  let mut i = 0
  while i < toks.length() {
    st.push(toks[i])
    i = i + 1
  }
}

///|
pub fn expander_consume_spaces(g : MacroExpander) -> Result[Unit, TexError] {
  while true {
    match expander_future(g) {
      Ok(tok) => {
        if tok.text == " " {
          let _ = expander_pop(g)
        } else {
          return Ok(())
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(())
}

///| Consume one undelimited macro argument (single token or `{...}` group), returned in reverse order.
pub fn expander_consume_arg(g : MacroExpander) -> Result[Array[Token], TexError] {
  match expander_consume_spaces(g) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let toks : Array[Token] = Array::new()
  let mut depth = 0
  let mut started_brace = false
  let mut first = true
  while true {
    let tok = match expander_pop(g) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if first {
      first = false
      if tok.text == "{" {
        started_brace = true
      }
    }
    if tok.text == "{" {
      depth = depth + 1
      if depth > 1200 {
        return Err(TexError::{
          message: "Maximum nesting depth exceeded",
          position: tok.start + 1,
        })
      }
      toks.push(tok)
    } else if tok.text == "}" {
      depth = depth - 1
      if depth < 0 {
        return Err(TexError::{ message: "Extra }", position: tok.start + 1 })
      }
      toks.push(tok)
    } else if tok.text == "EOF" {
      return Err(TexError::{
        message: "Unexpected end of input in a macro argument, expected '}'",
        position: tok.start,
      })
    } else {
      toks.push(tok)
    }
    if toks.length() > g.max_tokens {
      return Err(TexError::{
        message: "Too many expansions: infinite loop or need to increase maxExpand setting",
        position: tok.start + 1,
      })
    }
    if depth == 0 {
      break
    }
  }
  // Strip outer braces if started with '{'
  let res : Array[Token] = Array::new()
  let start_i = if started_brace && toks.length() >= 2 { 1 } else { 0 }
  let end_i = if started_brace && toks.length() >= 2 { toks.length() - 1 } else { toks.length() }
  // Push in reverse order for stack
  let mut j = end_i - 1
  while j >= start_i {
    res.push(toks[j])
    j = j - 1
  }
  Ok(res)
}

///| Expand next token until it is not a macro.
pub fn expander_next_token(g : MacroExpander) -> Result[Token, TexError] {
  while true {
    let tok = match expander_pop(g) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let tlen = tok.text.length()
    if !g.has_user_macros && (tlen == 0 || tok.text[0] != 92) {
      return Ok(tok)
    }
    if tok.noexpand || tok.text == "EOF" {
      return Ok(tok)
    }
    // Check user-defined macros first
    match lookup_user_macro(g, tok.text) {
      Some(def) => {
        g.expansion_count = g.expansion_count + 1
        if g.expansion_count > g.max_expand {
          return Err(TexError::{
            message: "Too many expansions: infinite loop or need to increase maxExpand setting",
            position: tok.start + 1,
          })
        }
        let args : Array[Array[Token]] = Array::new()
        let mut ai = 0
        while ai < def.num_args {
          match expander_consume_arg(g) {
            Ok(a) => args.push(a)
            Err(e) => return Err(e)
          }
          ai = ai + 1
        }
        let st = expander_stack(g)
        // Push body tokens with #1..#9 substitution (body is already in reverse order)
        let mut ti = 0
        while ti < def.tokens.length() {
          let t = def.tokens[ti]
          // In reversed order, '#' is at index ti+1 and digit is at ti
          if ti + 1 < def.tokens.length() && def.tokens[ti + 1].text == "#" {
            let dig = t.text
            if dig.length() == 1 && dig[0] >= 49 && dig[0] <= 57 {
              let arg_idx = dig[0] - 49
              if arg_idx < args.length() {
                if st.length() + args[arg_idx].length() > g.max_tokens {
                  return Err(TexError::{
                    message: "Too many expansions: infinite loop or need to increase maxExpand setting",
                    position: tok.start + 1,
                  })
                }
                expander_push_tokens(g, args[arg_idx])
              }
              ti = ti + 2
              continue
            }
          }
          if st.length() + 1 > g.max_tokens {
            return Err(TexError::{
              message: "Too many expansions: infinite loop or need to increase maxExpand setting",
              position: tok.start + 1,
            })
          }
          st.push(t)
          ti = ti + 1
        }
        continue
      }
      None => ()
    }
    // Check built-in macros
    match lookup_builtin_macro(tok.text) {
      Some((body_str, num_args)) => {
        g.expansion_count = g.expansion_count + 1
        if g.expansion_count > g.max_expand {
          return Err(TexError::{
            message: "Too many expansions: infinite loop or need to increase maxExpand setting",
            position: tok.start + 1,
          })
        }
        let body_toks = match lex_all_reversed(body_str) {
          Ok(ts) => ts
          Err(e) => return Err(e)
        }
        let args : Array[Array[Token]] = Array::new()
        let mut ai = 0
        while ai < num_args {
          match expander_consume_arg(g) {
            Ok(a) => args.push(a)
            Err(e) => return Err(e)
          }
          ai = ai + 1
        }
        let st = expander_stack(g)
        let mut ti = 0
        while ti < body_toks.length() {
          let t = body_toks[ti]
          if ti + 1 < body_toks.length() && body_toks[ti + 1].text == "#" {
            let dig = t.text
            if dig.length() == 1 && dig[0] >= 49 && dig[0] <= 57 {
              let arg_idx = dig[0] - 49
              if arg_idx < args.length() {
                if st.length() + args[arg_idx].length() > g.max_tokens {
                  return Err(TexError::{
                    message: "Too many expansions: infinite loop or need to increase maxExpand setting",
                    position: tok.start + 1,
                  })
                }
                expander_push_tokens(g, args[arg_idx])
                ti = ti + 2
                continue
              }
            }
          }
          st.push(t)
          ti = ti + 1
        }
        continue
      }
      None => return Ok(tok)
    }
  }
  Ok(Token::eof(g.lexer.len))
}
