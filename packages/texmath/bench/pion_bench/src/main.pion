///| Head-to-head native benchmark driver for `texmath` (parse + MathML serialization + optional layout).
import "texmath"

///|
fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s[i]
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: texmath_bench <corpus_path> <iters>")
    return 1
  }
  let corpus_path = args[1]
  let iters = parse_int_arg(args[2], 20)
  let raw = match fs_read(world, corpus_path) {
    Ok(s) => s
    Err(err) => {
      io_eprintln(world, "failed to read corpus: " + corpus_path + " (" + err + ")")
      return 1
    }
  }
  let lines = raw.split("\n")
  let formulas : Array[(Bool, String)] = Array::new()
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if line.length() >= 2 {
      let dm = line[0] == 68 // 'D' = display, 'I' = inline
      let tex = line.slice(2, line.length())
      formulas.push((dm, tex))
    }
    i = i + 1
  }
  let n = formulas.length()
  let mut total_bytes = 0
  let out = StringBuilder::new()
  let mut iter = 0
  while iter < iters {
    let mut j = 0
    while j < n {
      let (dm, tex) = formulas[j]
      match texmath::to_mathml(tex, dm) {
        Ok(mml) => {
          total_bytes = total_bytes + mml.length()
          if iter == 0 {
            out.write_string(mml)
            out.write_string("\n")
          }
        }
        Err(e) => {
          io_eprintln(world, "parse error on #" + j.to_string() + ": " + e.to_string())
          return 2
        }
      }
      j = j + 1
    }
    iter = iter + 1
  }
  out.write_string("COUNT=" + (n * iters).to_string() + " BYTES=" + total_bytes.to_string() + "\n")
  io_print(world, out.to_string())
  0
}
