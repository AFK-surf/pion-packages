    "\\text{a\\textit{b}\\textbf{c}\\texttt{d}}",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mtext>a</mtext><mtext mathvariant=\"italic\">b</mtext><mtext mathvariant=\"bold\">c</mtext><mtext mathvariant=\"monospace\">d</mtext></mrow><annotation encoding=\"application/x-tex\">\\text{a\\textit{b}\\textbf{c}\\texttt{d}}</annotation></semantics></math></span>",
    "text_fonts",
  )
}

///|
test "mathml: textcolor" {
  assert_mathml_eq(
    "\\textcolor{red}{x+1}",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle mathcolor=\"red\"><mi>x</mi><mo>+</mo><mn>1</mn></mstyle></mrow><annotation encoding=\"application/x-tex\">\\textcolor{red}{x+1}</annotation></semantics></math></span>",
    "textcolor",
  )
}

///|
test "mathml: color" {
  assert_mathml_eq(
    "\\color{blue} x+1",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle mathcolor=\"blue\"><mi>x</mi><mo>+</mo><mn>1</mn></mstyle></mrow><annotation encoding=\"application/x-tex\">\\color{blue} x+1</annotation></semantics></math></span>",
    "color",
  )
}

///|
test "mathml: phantom" {
  assert_mathml_eq(
    "\\phantom{x} + y",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mphantom><mi>x</mi></mphantom><mo>+</mo><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">\\phantom{x} + y</annotation></semantics></math></span>",
    "phantom",
  )
}

///|
test "mathml: mathml_spec_nodes" {
  assert_mathml_eq(
    "\\sin{x}+1\\;\\text{a}",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>sin</mi><mo>⁡</mo><mi>x</mi><mo>+</mo><mn>1</mn><mtext>  </mtext><mtext>a</mtext></mrow><annotation encoding=\"application/x-tex\">\\sin{x}+1\\;\\text{a}</annotation></semantics></math></span>",
    "mathml_spec_nodes",
  )
}

///|
test "mathml: mathml_spec_numbers" {
  assert_mathml_eq(
    "\\sin{\\alpha}=0.34=.34^1",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>sin</mi><mo>⁡</mo><mi>α</mi><mo>=</mo><mn>0.34</mn><mo>=</mo><msup><mn>.34</mn><mn>1</mn></msup></mrow><annotation encoding=\"application/x-tex\">\\sin{\\alpha}=0.34=.34^1</annotation></semantics></math></span>",
    "mathml_spec_numbers",
  )
}

///|
test "mathml: mathml_spec_braced_comma" {
  assert_mathml_eq(
    "1{,}000{,}000",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1,000,000</mn></mrow><annotation encoding=\"application/x-tex\">1{,}000{,}000</annotation></semantics></math></span>",
    "mathml_spec_braced_comma",
  )
}

///|
test "mathml: mathml_spec_not" {
  assert_mathml_eq(
    "a \\not= b",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi><mo>≠</mo><mi>b</mi></mrow><annotation encoding=\"application/x-tex\">a \\not= b</annotation></semantics></math></span>",
    "mathml_spec_not",
  )
}

///|
test "mathml: operatorname" {
  assert_mathml_eq(
    "\\operatorname{Tr}(A)",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">Tr</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>A</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\operatorname{Tr}(A)</annotation></semantics></math></span>",
    "operatorname",
  )
}

///|
test "mathml: quadratic" {
  assert_mathml_eq(
    "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}",
    true,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>x</mi><mo>=</mo><mfrac><mrow><mo>−</mo><mi>b</mi><mo>±</mo><msqrt><mrow><msup><mi>b</mi><mn>2</mn></msup><mo>−</mo><mn>4</mn><mi>a</mi><mi>c</mi></mrow></msqrt></mrow><mrow><mn>2</mn><mi>a</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}</annotation></semantics></math></span>",
    "quadratic",
  )
}

///|
test "mathml: euler" {
  assert_mathml_eq(
    "e^{i\\pi} + 1 = 0",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mi>e</mi><mrow><mi>i</mi><mi>π</mi></mrow></msup><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">e^{i\\pi} + 1 = 0</annotation></semantics></math></span>",
    "euler",
  )
}

///|
test "mathml: gaussian" {
  assert_mathml_eq(
    "\\int_{-\\infty}^{\\infty} e^{-x^2}\\,dx = \\sqrt{\\pi}",
    true,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant=\"normal\">∞</mi></mrow><mi mathvariant=\"normal\">∞</mi></msubsup><msup><mi>e</mi><mrow><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mtext> </mtext><mi>d</mi><mi>x</mi><mo>=</mo><msqrt><mi>π</mi></msqrt></mrow><annotation encoding=\"application/x-tex\">\\int_{-\\infty}^{\\infty} e^{-x^2}\\,dx = \\sqrt{\\pi}</annotation></semantics></math></span>",
    "gaussian",
  )
}

///|
test "mathml: special_spaces" {
  assert_mathml_eq(
    "a\\,b\\:c\\;d\\!e",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi><mtext> </mtext><mi>b</mi><mtext> </mtext><mi>c</mi><mtext>  </mtext><mi>d</mi><mtext> ⁣</mtext><mi>e</mi></mrow><annotation encoding=\"application/x-tex\">a\\,b\\:c\\;d\\!e</annotation></semantics></math></span>",
    "special_spaces",
  )
}

///|
test "mathml: kern_em" {
  assert_mathml_eq(
    "\\kern1em\\kern1ex",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mspace width=\"1em\"/><mspace width=\"0.431em\"/></mrow><annotation encoding=\"application/x-tex\">\\kern1em\\kern1ex</annotation></semantics></math></span>",
    "kern_em",
  )
}

///|
test "mathml: mstyle_display" {
  assert_mathml_eq(
    "\\displaystyle\\sum_a^b",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle scriptlevel=\"0\" displaystyle=\"true\"><munderover><mo>∑</mo><mi>a</mi><mi>b</mi></munderover></mstyle></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\sum_a^b</annotation></semantics></math></span>",
    "mstyle_display",
  )
}

///|
test "mathml: mstyle_text" {
  assert_mathml_eq(
    "\\textstyle\\sum_a^b",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle scriptlevel=\"0\" displaystyle=\"false\"><msubsup><mo>∑</mo><mi>a</mi><mi>b</mi></msubsup></mstyle></mrow><annotation encoding=\"application/x-tex\">\\textstyle\\sum_a^b</annotation></semantics></math></span>",
    "mstyle_text",
  )
}

///|
test "mathml: limits_override" {
  assert_mathml_eq(
    "\\int\\limits_a^b f(x)",
    true,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munderover><mo>∫</mo><mi>a</mi><mi>b</mi></munderover><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\int\\limits_a^b f(x)</annotation></semantics></math></span>",
    "limits_override",
  )
}

///|
test "mathml: nolimits_override" {
  assert_mathml_eq(
    "\\sum\\nolimits_{i=1}^n i",
    true,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mi>i</mi></mrow><annotation encoding=\"application/x-tex\">\\sum\\nolimits_{i=1}^n i</annotation></semantics></math></span>",
    "nolimits_override",
  )
}
