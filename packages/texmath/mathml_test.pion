///| Exact KaTeX MathML equivalence tests (ground-truth generated from KaTeX v0.19.1).

///|
fn assert_mathml_eq(tex : String, display : Bool, expected : String, label : String) -> Unit {
  match to_mathml(tex, display) {
    Ok(actual) => debug_assert(actual == expected, label + " mismatch:\n  actual:   " + actual + "\n  expected: " + expected)
    Err(e) => debug_assert(false, label + " failed: " + e.to_string())
  }
}

///|
test "mathml: single_var" {
  assert_mathml_eq(
    "a",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi></mrow><annotation encoding=\"application/x-tex\">a</annotation></semantics></math></span>",
    "single_var",
  )
}

///|
test "mathml: digits_arith" {
  assert_mathml_eq(
    "1+2=3",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>3</mn></mrow><annotation encoding=\"application/x-tex\">1+2=3</annotation></semantics></math></span>",
    "digits_arith",
  )
}

