    "\\hat{x} + \\vec{v} + \\bar{y} + \\tilde{z} + \\dot{q}",
    false,
    "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mover accent=\"true\"><mi>x</mi><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mi>v</mi><mo>⃗</mo></mover><mo>+</mo><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mo>+</mo><mover accent=\"true\"><mi>z</mi><mo>~</mo></mover><mo>+</mo><mover accent=\"true\"><mi>q</mi><mo>˙</mo></mover></mrow><annotation encoding=\"application/x-tex\">\\hat{x} + \\vec{v} + \\bar{y} + \\tilde{z} + \\dot{q}</annotation></semantics></math></span>",
    "accents",
  )
}

