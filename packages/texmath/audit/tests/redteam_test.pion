///|
test "katex-diff: llbracket" {
  expect_katex_ok("\\llbracket x \\rrbracket", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">⟦</mo><mi>x</mi><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">⟧</mo></mrow><annotation encoding=\"application/x-tex\">\\llbracket x \\rrbracket</annotation></semantics></math></span>")
}

///|
test "katex-diff: operatornamewithlimits" {
  expect_katex_ok("\\operatornamewithlimits{argmax}_x f", true, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munder><mrow><mi mathvariant=\"normal\">argmax</mi><mo>⁡</mo></mrow><mi>x</mi></munder><mi>f</mi></mrow><annotation encoding=\"application/x-tex\">\\operatornamewithlimits{argmax}_x f</annotation></semantics></math></span>")
}

///|
test "katex-diff: argmax" {
  expect_katex_ok("\\argmax_x f", true, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munder><mrow><mi mathvariant=\"normal\">arg max</mi><mo>⁡</mo></mrow><mi>x</mi></munder><mi>f</mi></mrow><annotation encoding=\"application/x-tex\">\\argmax_x f</annotation></semantics></math></span>")
}

///|
