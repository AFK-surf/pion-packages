///|
test "katex-diff: utilde" {
  expect_katex_ok("\\utilde{AB}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><munder accentunder=\"true\"><mrow><mi>A</mi><mi>B</mi></mrow><mo stretchy=\"true\">~</mo></munder></mrow><annotation encoding=\"application/x-tex\">\\utilde{AB}</annotation></semantics></math></span>")
