test "katex-diff: Overrightarrow" {
  expect_katex_ok("\\Overrightarrow{AB}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mover accent=\"true\"><mrow><mi>A</mi><mi>B</mi></mrow><mo stretchy=\"true\">⇒</mo></mover></mrow><annotation encoding=\"application/x-tex\">\\Overrightarrow{AB}</annotation></semantics></math></span>")
