  expect_katex_ok("\\varliminf_{n} a_n", true, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munder><mrow><mi mathvariant=\"normal\"><munder accentunder=\"true\"><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mo stretchy=\"true\">‾</mo></munder></mi><mo>⁡</mo></mrow><mi>n</mi></munder><msub><mi>a</mi><mi>n</mi></msub></mrow><annotation encoding=\"application/x-tex\">\\varliminf_{n} a_n</annotation></semantics></math></span>")
}

