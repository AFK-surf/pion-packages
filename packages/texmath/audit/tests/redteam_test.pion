test "katex-diff: dddot" {
  expect_katex_ok("\\dddot{x}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi><mover><mo><mi>x</mi></mo><mpadded voffset=\"-0.1ex\"><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mstyle mathsize=\"1em\"><mtext>...</mtext></mstyle></mstyle></mpadded></mover></mi></mrow><annotation encoding=\"application/x-tex\">\\dddot{x}</annotation></semantics></math></span>")
}

///|
test "katex-diff: pmb" {
  expect_katex_ok("\\pmb{\\mu}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle style=\"text-shadow: 0.02em 0.01em 0.04px\"><mi>μ</mi></mstyle></mrow><annotation encoding=\"application/x-tex\">\\pmb{\\mu}</annotation></semantics></math></span>")
}

///|
test "katex-diff: cancel" {
  expect_katex_ok("\\cancel{x} + \\bcancel{y} + \\xcancel{z}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><menclose notation=\"updiagonalstrike\"><mi>x</mi></menclose><mo>+</mo><menclose notation=\"downdiagonalstrike\"><mi>y</mi></menclose><mo>+</mo><menclose notation=\"updiagonalstrike downdiagonalstrike\"><mi>z</mi></menclose></mrow><annotation encoding=\"application/x-tex\">\\cancel{x} + \\bcancel{y} + \\xcancel{z}</annotation></semantics></math></span>")
}

///|
test "katex-diff: braket" {
  expect_katex_ok("\\braket{\\phi|\\psi}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mpadded><mo stretchy=\"false\">⟨</mo><mrow><mi>ϕ</mi><mi mathvariant=\"normal\">∣</mi><mi>ψ</mi></mrow><mo stretchy=\"false\">⟩</mo></mpadded></mrow><annotation encoding=\"application/x-tex\">\\braket{\\phi|\\psi}</annotation></semantics></math></span>")
}

///|
test "katex-diff: set_builder" {
  expect_katex_ok("\\Set{ x | x<\\frac 1 2 }", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo fence=\"true\">{</mo><mtext> </mtext><mi>x</mi><mtext>  </mtext><mo fence=\"true\" lspace=\"0.05em\" rspace=\"0.05em\">|</mo><mtext>  </mtext><mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mtext> </mtext><mo fence=\"true\">}</mo></mrow><annotation encoding=\"application/x-tex\">\\Set{ x | x&lt;\\frac 1 2 }</annotation></semantics></math></span>")
}

///|
test "katex-diff: mathchoice" {
  expect_katex_ok("\\mathchoice{D}{T}{S}{SS}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>T</mi></mrow><annotation encoding=\"application/x-tex\">\\mathchoice{D}{T}{S}{SS}</annotation></semantics></math></span>")
}

///|
test "katex-diff: raisebox" {
  expect_katex_ok("a\\raisebox{0.5em}{b}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi><mpadded voffset=\"0.5em\"><mstyle scriptlevel=\"0\" displaystyle=\"false\"><mtext>b</mtext></mstyle></mpadded></mrow><annotation encoding=\"application/x-tex\">a\\raisebox{0.5em}{b}</annotation></semantics></math></span>")
}

///|
test "katex-diff: verb" {
  expect_katex_ok("\\verb|x^2|", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mtext mathvariant=\"monospace\">x^2</mtext></mrow><annotation encoding=\"application/x-tex\">\\verb|x^2|</annotation></semantics></math></span>")
}

///|
test "katex-diff: let_eq" {
  expect_katex_ok("\\let\\b=\\alpha \\b", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>α</mi></mrow><annotation encoding=\"application/x-tex\">\\let\\b=\\alpha \\b</annotation></semantics></math></span>")
}

///|
test "katex-diff: let_noeq" {
  expect_katex_ok("\\let\\b\\alpha \\b", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>α</mi></mrow><annotation encoding=\"application/x-tex\">\\let\\b\\alpha \\b</annotation></semantics></math></span>")
}

