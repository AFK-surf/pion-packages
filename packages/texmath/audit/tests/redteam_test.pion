///|
test "katex-diff: mapsfrom" {
  expect_katex_ok("a \\mapsfrom b", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi><mo mathvariant=\"normal\">↤</mo><mi>b</mi></mrow><annotation encoding=\"application/x-tex\">a \\mapsfrom b</annotation></semantics></math></span>")
