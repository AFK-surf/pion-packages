///|
test "katex-diff: limits_inline" {
  expect_katex_ok("\\sum\\limits_{i=1}^n i", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mi>i</mi></mrow><annotation encoding=\"application/x-tex\">\\sum\\limits_{i=1}^n i</annotation></semantics></math></span>")
}

///|
test "katex-diff: injlim" {
  expect_katex_ok("\\injlim", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">inj lim</mi><mo>⁡</mo></mrow><annotation encoding=\"application/x-tex\">\\injlim</annotation></semantics></math></span>")
}

///|
test "katex-diff: degree" {
  expect_katex_ok("\\degree", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">°</mi></mrow><annotation encoding=\"application/x-tex\">\\degree</annotation></semantics></math></span>")
}

///|
test "katex-diff: overset_wraps_op" {
  expect_katex_ok("x\\overset{!}{=}y", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi><mo><mover><mo><mo>=</mo></mo><mo stretchy=\"false\" lspace=\"0em\" rspace=\"0em\">!</mo></mover></mo><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">x\\overset{!}{=}y</annotation></semantics></math></span>")
}

///|
test "katex-diff: middle_spacing" {
  expect_katex_ok("\\left( a \\middle| b \\right)", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo fence=\"true\">(</mo><mi>a</mi><mo fence=\"true\" lspace=\"0.05em\" rspace=\"0.05em\">|</mo><mi>b</mi><mo fence=\"true\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\left( a \\middle| b \\right)</annotation></semantics></math></span>")
}

///|
test "katex-diff: rule_mpadded" {
  expect_katex_ok("\\rule{1em}{0.5em}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mpadded height=\"0em\" voffset=\"0em\"><mspace mathbackground=\"black\" width=\"1em\" height=\"0.5em\"></mspace></mpadded></mrow><annotation encoding=\"application/x-tex\">\\rule{1em}{0.5em}</annotation></semantics></math></span>")
}

///|
test "katex-diff: rule_ex_units" {
  expect_katex_ok("\\rule{1ex}{2ex}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mpadded height=\"0em\" voffset=\"0em\"><mspace mathbackground=\"black\" width=\"0.431em\" height=\"0.862em\"></mspace></mpadded></mrow><annotation encoding=\"application/x-tex\">\\rule{1ex}{2ex}</annotation></semantics></math></span>")
}

///|
test "katex-diff: hphantom" {
  expect_katex_ok("\\hphantom{x}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mpadded height=\"0px\" depth=\"0px\"><mphantom><mi>x</mi></mphantom></mpadded></mrow><annotation encoding=\"application/x-tex\">\\hphantom{x}</annotation></semantics></math></span>")
}

///|
test "katex-diff: scriptstyle_thickspace" {
  expect_katex_ok("\\scriptstyle a\\;b", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle scriptlevel=\"1\" displaystyle=\"false\"><mi>a</mi><mspace width=\"0.3253em\"/><mi>b</mi></mstyle></mrow><annotation encoding=\"application/x-tex\">\\scriptstyle a\\;b</annotation></semantics></math></span>")
}

///|
test "katex-diff: mathbin_symbol" {
  expect_katex_ok("\\mathbin{\\#}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo mathvariant=\"normal\" lspace=\"0.22em\" rspace=\"0.22em\">#</mo></mrow><annotation encoding=\"application/x-tex\">\\mathbin{\\#}</annotation></semantics></math></span>")
}

///|
test "katex-diff: genfrac_style" {
  expect_katex_ok("\\genfrac{(}{]}{0pt}{2}{a}{b}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mstyle scriptlevel=\"1\" displaystyle=\"false\"><mrow><mo fence=\"true\">(</mo><mfrac linethickness=\"0px\"><mi>a</mi><mi>b</mi></mfrac><mo fence=\"true\">]</mo></mrow></mstyle></mrow><annotation encoding=\"application/x-tex\">\\genfrac{(}{]}{0pt}{2}{a}{b}</annotation></semantics></math></span>")
}

///|
test "katex-diff: kern_large_overflow" {
  expect_katex_ok("\\kern300000em x", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mspace width=\"300000em\"/><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">\\kern300000em x</annotation></semantics></math></span>")
}

///|
test "katex-diff: rule_large_overflow" {
  expect_katex_ok("\\rule{100000000em}{1em}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mpadded height=\"0em\" voffset=\"0em\"><mspace mathbackground=\"black\" width=\"100000000em\" height=\"1em\"></mspace></mpadded></mrow><annotation encoding=\"application/x-tex\">\\rule{100000000em}{1em}</annotation></semantics></math></span>")
}

///|
test "katex-diff: dots_in_text_list" {
  expect_katex_ok("\\cdots;\\dots+\\dots\\int\\dots,\\dots", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>⋯</mo><mtext> </mtext><mo separator=\"true\">;</mo><mo>⋯</mo><mo>+</mo><mtext> ⁣</mtext><mo>⋯</mo><mo>∫</mo><mo>…</mo><mo separator=\"true\">,</mo><mo>…</mo></mrow><annotation encoding=\"application/x-tex\">\\cdots;\\dots+\\dots\\int\\dots,\\dots</annotation></semantics></math></span>")
}

///|
test "katex-diff: prime_spacing" {
  expect_katex_ok("x'^2", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msup><mi>x</mi><mrow><mo mathvariant=\"normal\">′</mo><mn>2</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">x&#x27;^2</annotation></semantics></math></span>")
}

///|
test "katex-diff: def_scope_leak_group" {
  expect_katex_err("{\\def\\a{x}}\\a", false, "KaTeX parse error: Undefined control sequence: \\a at position 12: {\\def\\a{x}}\\̲a̲")
}

///|
test "katex-diff: newcommand_scope_leak" {
  expect_katex_err("{\\newcommand{\\a}{x}}\\a", false, "KaTeX parse error: Undefined control sequence: \\a at position 21: …command{\\a}{x}}\\̲a̲")
}

///|
test "katex-diff: def_scope_leak_matrix_cell" {
  expect_katex_err("\\begin{matrix}\\def\\a{x} & \\a\\end{matrix}", false, "KaTeX parse error: Undefined control sequence: \\a at position 27: …ix}\\def\\a{x} & \\̲a̲\\end{matrix}")
}

///|
test "katex-diff: def_scope_leak_order" {
  expect_katex_err("{\\def\\a{2}}\\def\\b{}\\a", false, "KaTeX parse error: Undefined control sequence: \\a at position 20: …f\\a{2}}\\def\\b{}\\̲a̲")
}

///|
test "katex-diff: renewcommand_undefined" {
  expect_katex_err("\\renewcommand{\\a}{x}", false, "KaTeX parse error: \\renewcommand{\\a} when command \\a does not yet exist; use \\newcommand")
}

///|
test "katex-diff: newcommand_redefine_builtin" {
  expect_katex_err("\\newcommand{\\alpha}{x}", false, "KaTeX parse error: \\newcommand{\\alpha} attempting to redefine \\alpha; use \\renewcommand")
}

///|
test "katex-diff: newcommand_optional_default_garbage" {
  expect_katex_err("\\newcommand{\\a}[2][y]{#1+#2}\\a[z]{x}", false, "KaTeX parse error: Expected '}', got '#' at position 23: …mand{\\a}[2][y]{#̲1+#2}\\a[z]{x}")
}

///|
test "katex-diff: strut_undefined" {
  expect_katex_err("\\strut x", false, "KaTeX parse error: Undefined control sequence: \\strut at position 1: \\̲s̲t̲r̲u̲t̲ ̲x")
}

///|
test "katex-diff: bare_hash" {
  expect_katex_err("#", false, "KaTeX parse error: Expected 'EOF', got '#' at position 1: #̲")
}

///| ===== Layout height/depth oracle: katex.__renderToHTMLTree (TeXbook Appendix G in KaTeX) =====

