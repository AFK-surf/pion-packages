  expect_katex_ok("\\underbar{X}", false, "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><munder accentunder=\"true\"><mtext>X</mtext><mo stretchy=\"true\">‾</mo></munder></mrow><annotation encoding=\"application/x-tex\">\\underbar{X}</annotation></semantics></math></span>")
}

