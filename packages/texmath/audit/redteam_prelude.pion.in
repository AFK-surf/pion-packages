///| Red-team evidence suite for `texmath` vs the real npm `katex` (v0.19.1).
///|
///| Every assertion encodes what real KaTeX does for the same input; a FAILING test is a
///| reproducible defect of the Pion port. The `katex-diff:` and `katex-layout:` tests are
///| generated by `audit/gen_tests.mjs` (do not edit by hand); the tests in this prelude are
///| hand-written (crash / API contract probes). See `audit/REPORT.md`.
import "texmath"

///|
fn mode_opts(display : Bool) -> texmath::ParseOptions {
  if display {
    texmath::ParseOptions::display()
  } else {
    texmath::ParseOptions::default()
  }
}

///| KaTeX renders `tex`; Pion must produce byte-identical MathML (the README claims byte-for-byte compatibility).
fn expect_katex_ok(tex : String, display : Bool, katex_mathml : String) -> Unit {
  match texmath::to_mathml(tex, display) {
    Ok(mml) =>
    debug_assert(
      mml == katex_mathml,
      "MathML differs from KaTeX for `" + tex + "`\n  katex: " + katex_mathml + "\n  pion : " + mml,
    )
    Err(e) =>
    debug_assert(
      false,
      "Pion rejects input that KaTeX renders: `" + tex + "` -> " + e.message,
    )
  }
}

///| KaTeX rejects `tex`; Pion must reject it as well instead of rendering something.
fn expect_katex_err(tex : String, display : Bool, katex_message : String) -> Unit {
  match texmath::to_mathml(tex, display) {
    Ok(mml) =>
    debug_assert(
      false,
      "Pion accepts input that KaTeX rejects (" + katex_message + "): `" + tex + "` -> " + mml,
    )
    Err(_) => ()
  }
}

///|
fn absd(v : Double) -> Double {
  if v < 0.0 {
    -v
  } else {
    v
  }
}

///| Root box height/depth must match KaTeX's HTML layout within 0.005em.
fn expect_katex_box(tex : String, display : Bool, height : Double, depth : Double) -> Unit {
  match texmath::render_layout(tex, display) {
    Ok(b) => {
      let m = texmath::box_metrics(b)
      debug_assert(
        absd(m.height - height) < 0.005 && absd(m.depth - depth) < 0.005,
        "layout differs from KaTeX for `" + tex + "`: katex h=" + height.to_string() +
        " d=" + depth.to_string() + ", pion h=" + m.height.to_string() + " d=" + m.depth.to_string(),
      )
    }
    Err(e) => debug_assert(false, "Pion layout rejects `" + tex + "`: " + e.message)
  }
}

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| ===== P0: deep nesting kills the whole process (SIGSEGV) instead of returning an error =====
///| KaTeX throws a catchable `ParseError`/`RangeError` for all of these; the host survives.

///|
test "dos: 10000 nested \\frac must return Err, not crash the process" {
  let tex = repeat("\\frac{", 10000) + "x" + repeat("}{x}", 10000)
  debug_assert(texmath::to_mathml(tex, false).is_err(), "expected a catchable error like KaTeX")
}

///|
test "dos: 10000 nested \\sqrt must return Err, not crash the process" {
  let tex = repeat("\\sqrt{", 10000) + "x" + repeat("}", 10000)
  debug_assert(texmath::to_mathml(tex, false).is_err(), "expected a catchable error like KaTeX")
}

///|
test "dos: 10000 nested \\color groups must return Err, not crash the process" {
  let tex = repeat("\\color{red}{", 10000) + "x" + repeat("}", 10000)
  debug_assert(texmath::to_mathml(tex, false).is_err(), "expected a catchable error like KaTeX")
}

///|
test "dos: 100000 nested braces must return Err, not crash the process" {
  let tex = repeat("{", 100000) + "x" + repeat("}", 100000)
  debug_assert(texmath::to_mathml(tex, false).is_err(), "expected a catchable error like KaTeX")
}

///|
test "dos: 32000 flat \\color switches (implicitly nested) must not crash the process" {
  let tex = repeat("\\color{red}{x}", 32000)
  debug_assert(texmath::to_mathml(tex, false).is_err(), "expected a catchable error like KaTeX")
}

///|
test "dos: render_layout on 10000 nested \\sqrt must return Err, not crash" {
  let tex = repeat("\\sqrt{", 10000) + "x" + repeat("}", 10000)
  debug_assert(texmath::render_layout(tex, false).is_err(), "expected a catchable error")
}

///| ===== P1: public API contract =====

///| KaTeX `throwOnError: false` renders `\foo` as red `<mtext>\foo</mtext>` instead of failing.
///| Pion exposes `ParseOptions.throw_on_error` but never reads it.
test "api: ParseOptions.throw_on_error=false must not fail on undefined control sequence" {
  let opts = texmath::ParseOptions::{
    display_mode: false,
    throw_on_error: false,
    max_expand: 1000,
  }
  debug_assert(
    texmath::parse("\\foo x", opts).is_ok(),
    "throw_on_error=false is ignored: parse still returns Err (KaTeX renders <mstyle mathcolor=\"#cc0000\"><mtext>\\foo</mtext></mstyle>)",
  )
}

///| KaTeX never reports a negative box depth for `\overset` (it is 0); Pion reports -0.133em.
test "api: layout must not produce negative depth" {
  match texmath::render_layout("\\overset{!}{=}", true) {
    Ok(b) => {
      let m = texmath::box_metrics(b)
      debug_assert(m.depth >= 0.0, "negative box depth " + m.depth.to_string())
    }
    Err(e) => debug_assert(false, e.message)
  }
}
