///| Red-team differential driver: one formula per line (`D <tex>` display, `I <tex>` inline).
///| Prints `OK <mathml>` or `ERR <message>` per line, mirroring `audit/katex_diff.mjs`.
///| With a second argument `layout`, prints `OK <height> <depth>` of the root layout box instead.
import "texmath"

///| Fixed 3-decimal rendering (em), rounded half away from zero, for cross-implementation comparison.
fn fmt3(v : Double) -> String {
  let neg = v < 0.0
  let av = if neg { -v } else { v }
  let scaled = (av * 1000.0 + 0.5).to_int()
  let frac = scaled % 1000
  let fs = if frac < 10 {
    "00" + frac.to_string()
  } else if frac < 100 {
    "0" + frac.to_string()
  } else {
    frac.to_string()
  }
  (if neg && scaled > 0 { "-" } else { "" }) + (scaled / 1000).to_string() + "." + fs
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: texmath_audit_diff <cases_path>")
    return 1
  }
  let raw = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(err) => {
      io_eprintln(world, "failed to read: " + err)
      return 1
    }
  }
  let layout_mode = args.length() >= 3 && args[2] == "layout"
  let lines = raw.split("\n")
  let out = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if line.length() >= 2 {
      let dm = line[0] == 68
      let tex = line.slice(2, line.length())
      if layout_mode {
        match texmath::render_layout(tex, dm) {
          Ok(b) => {
            let m = texmath::box_metrics(b)
            out.write_string("OK " + fmt3(m.height) + " " + fmt3(m.depth))
          }
          Err(e) => out.write_string("ERR " + e.message)
        }
        out.write_string("\n")
        i = i + 1
        continue
      }
      match texmath::to_mathml(tex, dm) {
        Ok(mml) => {
          out.write_string("OK ")
          out.write_string(mml)
        }
        Err(e) => {
          out.write_string("ERR ")
          out.write_string(e.message)
        }
      }
      out.write_string("\n")
    }
    i = i + 1
  }
  io_print(world, out.to_string())
  0
}
