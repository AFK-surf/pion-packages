///| Wasm32 compilation smoke entry for `texmath`.
import "texmath"

///|
pub fn smoke() -> Int {
  let tex = "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"
  match texmath::to_mathml(tex, true) {
    Ok(mml) =>
    match texmath::render_layout(tex, true) {
      Ok(b) => {
        let m = texmath::box_metrics(b)
        if m.width > 0.0 && m.height > 0.0 {
          mml.length()
        } else {
          -1
        }
      }
      Err(_) => -2
    }
    Err(_) => -3
  }
}

///|
pub fn main(_world : World) -> Int {
  let n = smoke()
  if n > 0 { 0 } else { 1 }
}
