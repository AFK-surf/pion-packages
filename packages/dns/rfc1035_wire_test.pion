///| RFC 1035 wire protocol compliance tests: Header, Name, Compression, Core RRs,
///| Builders, and dig/zone-style text formatting.

///|
fn bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn must_name(s : String) -> Name {
  match Name::parse(s) {
    Ok(n) => n
    Err(e) => {
      debug_assert(false, "Name::parse failed for " + s + ": " + dns_error_message(e))
      Name::root()
    }
  }
}

///|
test "rfc1035_standard_query_wire_vector" {
  // Exact RFC 8484 / Wireshark wire vector for `www.example.com. IN A` query:
  // ID=0x1234, RD=1, QDCOUNT=1, QNAME=3www7example3com0, QTYPE=1(A), QCLASS=1(IN)
  let wire = bytes_from_ints([
    0x12, 0x34, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    3, 119, 119, 119, 7, 101, 120, 97, 109, 112, 108, 101, 3, 99, 111, 109, 0,
    0x00, 0x01, 0x00, 0x01,
  ])
  match decode_message(wire) {
    Ok(msg) => {
      debug_assert(msg.header.id == 0x1234, "id")
      debug_assert(!msg.header.qr, "qr false")
      debug_assert(msg.header.opcode == opcode_query, "opcode query")
      debug_assert(!msg.header.aa, "aa false")
      debug_assert(!msg.header.tc, "tc false")
      debug_assert(msg.header.rd, "rd true")
      debug_assert(!msg.header.ra, "ra false")
      debug_assert(!msg.header.z, "z false")
      debug_assert(!msg.header.ad, "ad false")
      debug_assert(!msg.header.cd, "cd false")
      debug_assert(msg.header.rcode == rcode_noerror, "rcode 0")
      debug_assert(msg.header.qdcount == 1, "qdcount 1")
      debug_assert(msg.questions.length() == 1, "1 question")
      debug_assert(msg.questions[0].name.to_string() == "www.example.com.", "qname")
      debug_assert(msg.questions[0].qtype == type_a, "qtype A")
      debug_assert(msg.questions[0].qclass == class_in, "qclass IN")
      match encode_message(msg) {
        Ok(reencoded) => debug_assert(bytes_equal(wire, reencoded), "exact wire roundtrip")
        Err(_) => debug_assert(false, "re-encode failed")
      }
    }
    Err(e) => debug_assert(false, "decode failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_header_all_flag_bits" {
  // ID=0xABCD
  // Byte 2: QR=1(0x80) | OPCODE=5(UPDATE, 0x28) | AA=1(0x04) | TC=1(0x02) | RD=1(0x01) = 0xAF
  // Byte 3: RA=1(0x80) | Z=1(0x40) | AD=1(0x20) | CD=1(0x10) | RCODE=3(NXDOMAIN, 0x03) = 0xF3
  let wire = bytes_from_ints([
    0xAB, 0xCD, 0xAF, 0xF3, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ])
  match decode_message(wire) {
    Ok(msg) => {
      let h = msg.header
      debug_assert(h.id == 0xABCD, "id")
      debug_assert(h.qr, "qr")
      debug_assert(h.opcode == opcode_update, "opcode update")
      debug_assert(h.aa, "aa")
      debug_assert(h.tc, "tc")
      debug_assert(h.rd, "rd")
      debug_assert(h.ra, "ra")
      debug_assert(h.z, "z")
      debug_assert(h.ad, "ad")
      debug_assert(h.cd, "cd")
      debug_assert(h.rcode == rcode_nxdomain, "rcode nxdomain")
      match encode_message(msg) {
        Ok(enc) => debug_assert(bytes_equal(wire, enc), "header flags roundtrip")
        Err(_) => debug_assert(false, "encode header failed")
      }
    }
    Err(e) => debug_assert(false, "decode header failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_name_parsing_escaping_and_comparison" {
  let root = must_name(".")
  debug_assert(root.is_root(), "root is_root")
  debug_assert(root.label_count() == 0, "root 0 labels")
  debug_assert(root.wire_len() == 1, "root 1 wire byte")
  debug_assert(root.to_string() == ".", "root to_string")

  let n1 = must_name("Example.COM.")
  let n2 = must_name("example.com")
  debug_assert(n1.to_string() == "Example.COM.", "preserves case")
  debug_assert(n2.to_string() == "example.com.", "normalizes trailing dot")
  debug_assert(n1.eq_ignore_case(n2), "case-insensitive equal")
  debug_assert(!n1.eq_exact(n2), "case-sensitive not equal")
  debug_assert(n1.to_lowercase().eq_exact(n2), "to_lowercase exact match")
  debug_assert(n1.label_count() == 2, "2 labels")
  debug_assert(n1.wire_len() == 13, "wire_len 13")

  let sub = must_name("a.b.example.com.")
  debug_assert(sub.is_subdomain_of(n1), "subdomain case-insensitive")
  debug_assert(sub.is_subdomain_of(root), "everything is subdomain of root")
  debug_assert(!n1.is_subdomain_of(sub), "parent not subdomain of child")

  // Escaped dot and decimal byte escape (\032 = space, \000 = NUL)
  let esc = must_name("first\\.last.sub\\032space.example.com.")
  let labels = esc.labels()
  debug_assert(labels.length() == 4, "4 labels with escaped dot")
  debug_assert(labels[0].to_string() == "first.last", "escaped dot in label 0")
  debug_assert(labels[1].to_string() == "sub space", "escaped space in label 1")
  let formatted = esc.to_string()
  let reparsed = must_name(formatted)
  debug_assert(esc.eq_exact(reparsed), "escaped name roundtrip")

  // Invalid names: empty label, >63B label, >255B total
  match Name::parse("a..b.com") {
    Err(DnsError::EmptyLabel) => ()
    _ => debug_assert(false, "empty label must fail")
  }
  let long_label = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" // 64 'a's
  match Name::parse(long_label + ".com") {
    Err(DnsError::LabelTooLong(_)) => ()
    _ => debug_assert(false, "64B label must fail")
  }
  // 4 labels of 63B = 4 * 64 + 1 = 257B > 255B
  let l63 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  match Name::parse(l63 + "." + l63 + "." + l63 + "." + l63 + ".") {
    Err(DnsError::NameTooLong) => ()
    _ => debug_assert(false, "257B wire name must fail")
  }
  // Max valid: 63 + 63 + 63 + 61 = 64 + 64 + 64 + 62 + 1 = 255B
  let l61 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  match Name::parse(l63 + "." + l63 + "." + l63 + "." + l61 + ".") {
    Ok(max_name) => debug_assert(max_name.wire_len() == 255, "exact 255B wire name ok")
    Err(e) => debug_assert(false, "255B valid name failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_section_4_1_4_compression_pointers" {
  // RFC 1035 §4.1.4 exact example:
  // Offset 12: 1 'F' 3 'I' 'S' 'I' 4 'A' 'R' 'P' 'A' 0  (F.ISI.ARPA., ends at 24)
  // Offset 24: 3 'F' 'O' 'O' 0xC0 0x0C                 (FOO.F.ISI.ARPA., pointer to 12)
  // Offset 30: 0xC0 0x12                               (ARPA., pointer to 18)
  let wire = bytes_from_ints([
    // 12-byte header: 3 questions
    0x00, 0x01, 0x01, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    // Q1 at 12: F.ISI.ARPA. (12 bytes -> ends at 24; 'A'R'P'A' starts at 12+2+4=18)
    1, 70, 3, 73, 83, 73, 4, 65, 82, 80, 65, 0,
    0x00, 0x01, 0x00, 0x01, // ends at 28
    // Q2 at 28: FOO.<ptr 12>
    3, 70, 79, 79, 0xC0, 0x0C,
    0x00, 0x01, 0x00, 0x01, // ends at 38
    // Q3 at 38: <ptr 18> (ARPA.)
    0xC0, 0x12,
    0x00, 0x01, 0x00, 0x01,
  ])
  match decode_message(wire) {
    Ok(msg) => {
      debug_assert(msg.questions.length() == 3, "3 questions")
      debug_assert(msg.questions[0].name.to_string() == "F.ISI.ARPA.", "q0")
      debug_assert(msg.questions[1].name.to_string() == "FOO.F.ISI.ARPA.", "q1")
      debug_assert(msg.questions[2].name.to_string() == "ARPA.", "q2")
    }
    Err(e) => debug_assert(false, "rfc1035 compression decode failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_encode_compression_toggle_and_case_insensitive_sharing" {
  let qname = must_name("www.Example.COM.")
  let cname_target = must_name("cdn.example.com.")
  let ns_target = must_name("ns1.example.com.")
  let mut msg = Message::query(0x4242, qname, type_a)
  msg = Message::response_for(msg, rcode_noerror)
  msg.answers.push(ResourceRecord::{
    name: qname,
    rtype: type_cname,
    rclass: class_in,
    ttl: 300L,
    rdata: RData::CNAME(cname_target),
  })
  msg.answers.push(ResourceRecord::{
    name: cname_target,
    rtype: type_a,
    rclass: class_in,
    ttl: 60L,
    rdata: RData::A(Ipv4Addr::new(93, 184, 216, 34)),
  })
  msg.authorities.push(ResourceRecord::{
    name: must_name("example.com."),
    rtype: type_ns,
    rclass: class_in,
    ttl: 86400L,
    rdata: RData::NS(ns_target),
  })

  let compressed = match encode_message_with(msg, EncodeOptions::default()) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "compressed encode failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  let uncompressed = match encode_message_with(msg, EncodeOptions::uncompressed()) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "uncompressed encode failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(
    compressed.length() < uncompressed.length(),
    "compressed must be strictly smaller than uncompressed",
  )

  // Both must decode to equivalent messages
  match decode_message(compressed) {
    Ok(dec) => {
      debug_assert(dec.header.id == 0x4242, "id")
      debug_assert(dec.header.qr, "qr")
      debug_assert(dec.answers.length() == 2, "2 answers")
      debug_assert(dec.authorities.length() == 1, "1 authority")
      debug_assert(dec.answers[0].name.eq_ignore_case(qname), "ans0 name")
      match dec.answers[0].rdata {
        RData::CNAME(t) => debug_assert(t.eq_ignore_case(cname_target), "cname target")
        _ => debug_assert(false, "expected CNAME")
      }
      match dec.answers[1].rdata {
        RData::A(ip) => debug_assert(ip.eq(Ipv4Addr::new(93, 184, 216, 34)), "A ip")
        _ => debug_assert(false, "expected A")
      }
      match dec.authorities[0].rdata {
        RData::NS(ns) => debug_assert(ns.eq_ignore_case(ns_target), "NS target")
        _ => debug_assert(false, "expected NS")
      }
    }
    Err(e) => debug_assert(false, "compressed decode failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_core_rr_types_roundtrip_and_text" {
  let zone = must_name("example.com.")
  let req = Message::query(0x7788, zone, type_any)
  let resp = Message::response_for(req, rcode_noerror)
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_a,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::A(Ipv4Addr::new(192, 0, 2, 1)),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_mx,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::MX(MxData::{ preference: 10, exchange: must_name("mail.example.com.") }),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_txt,
    rclass: class_in,
    ttl: 600L,
    rdata: RData::TXT(["v=spf1 include:_spf.example.com".to_bytes(), " ~all".to_bytes()]),
  })
  resp.answers.push(ResourceRecord::{
    name: must_name("1.2.0.192.in-addr.arpa."),
    rtype: type_ptr,
    rclass: class_in,
    ttl: 1800L,
    rdata: RData::PTR(must_name("host.example.com.")),
  })
  resp.authorities.push(ResourceRecord::{
    name: zone,
    rtype: type_soa,
    rclass: class_in,
    ttl: 86400L,
    rdata: RData::SOA(SoaData::{
      mname: must_name("ns1.example.com."),
      rname: must_name("hostmaster.example.com."),
      serial: 2026112301L,
      refresh: 7200L,
      retry: 900L,
      expire: 1209600L,
      minimum: 300L,
    }),
  })

  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode core RRs failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) => {
      debug_assert(dec.answers.length() == 4, "4 answers")
      debug_assert(dec.authorities.length() == 1, "1 authority")
      match dec.answers[1].rdata {
        RData::MX(mx) => {
          debug_assert(mx.preference == 10, "mx pref")
          debug_assert(mx.exchange.eq_ignore_case(must_name("mail.example.com.")), "mx exch")
        }
        _ => debug_assert(false, "expected MX")
      }
      match dec.answers[2].rdata {
        RData::TXT(chunks) => {
          debug_assert(chunks.length() == 2, "2 txt chunks")
          debug_assert(chunks[0].to_string() == "v=spf1 include:_spf.example.com", "txt0")
          debug_assert(chunks[1].to_string() == " ~all", "txt1")
        }
        _ => debug_assert(false, "expected TXT")
      }
      match dec.answers[3].rdata {
        RData::PTR(p) => debug_assert(p.eq_ignore_case(must_name("host.example.com.")), "ptr")
        _ => debug_assert(false, "expected PTR")
      }
      match dec.authorities[0].rdata {
        RData::SOA(soa) => {
          debug_assert(soa.mname.eq_ignore_case(must_name("ns1.example.com.")), "soa mname")
          debug_assert(soa.rname.eq_ignore_case(must_name("hostmaster.example.com.")), "soa rname")
          debug_assert(soa.serial == 2026112301L, "soa serial")
          debug_assert(soa.refresh == 7200L, "soa refresh")
          debug_assert(soa.retry == 900L, "soa retry")
          debug_assert(soa.expire == 1209600L, "soa expire")
          debug_assert(soa.minimum == 300L, "soa minimum")
        }
        _ => debug_assert(false, "expected SOA")
      }
      let txt = dec.to_text()
      debug_assert(txt.length() > 40, "to_text non-empty")
      debug_assert(dec.answers[0].to_text() == "example.com.\t3600\tIN\tA\t192.0.2.1", "A rr text")
    }
    Err(e) => debug_assert(false, "decode core RRs failed: " + dns_error_message(e))
  }
}

test "c1_migrated_dns_options_constants" {
  let d = DecodeLimits::default()
  let s = DecodeLimits::strict()
  debug_assert(s.max_pointers <= d.max_pointers && s.max_questions <= d.max_questions && s.max_records <= d.max_records, "strict <= default")
  debug_assert(!s.allow_trailing_bytes && d.allow_trailing_bytes, "trailing bytes policy")
  debug_assert(EncodeOptions::default().compress && !EncodeOptions::uncompressed().compress, "encode options compress")
}
