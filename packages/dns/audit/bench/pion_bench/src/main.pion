///| Adversarial head-to-head benchmark (pion `dns`), mirrors ../go/main.go and
///| ../rust/src/main.rs byte-for-byte on stdout.
///|   pion_bench encode <names.txt> <rounds>
///|   pion_bench decode <names.txt> <rounds>

import "dns"

///|
fn read_names(data : Bytes) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut pos = 0
  while pos < n {
    let mut e = pos
    while e < n && data[e].to_int() != 10 {
      e = e + 1
    }
    if e > pos {
      let mut b = Bytes::new(e - pos)
      let mut k = 0
      while k < e - pos {
        b[k] = data[pos + k]
        k = k + 1
      }
      out.push(b.to_string())
    }
    pos = e + 1
  }
  out
}

///|
fn build(names : Array[String]) -> dns::Message {
  let qn = match dns::Name::parse("q.bulk.example.") {
    Ok(n) => n
    Err(_) => dns::Name::root()
  }
  let q = dns::Message::query(0x4242, qn, dns::type_a)
  let m = dns::Message::response_for(q, dns::rcode_noerror)
  let m2 = dns::Message::{ ..m, header: dns::Header::{ ..m.header, ra: true } }
  let mut i = 0
  while i < names.length() {
    let n = match dns::Name::parse(names[i]) {
      Ok(v) => v
      Err(_) => dns::Name::root()
    }
    m2.answers.push(dns::ResourceRecord::{
      name: n,
      rtype: dns::type_a,
      rclass: dns::class_in,
      ttl: 60L,
      rdata: dns::RData::A(dns::Ipv4Addr::new(10, (i >> 16) & 255, (i >> 8) & 255, i & 255)),
    })
    i = i + 1
  }
  m2
}

///|
fn parse_uint(s : String) -> Int {
  let b = s.to_bytes()
  let mut v = 0
  let mut i = 0
  while i < b.length() {
    v = v * 10 + (b[i].to_int() - 48)
    i = i + 1
  }
  v
}

///|
fn fold(h0 : Int64, w : Bytes) -> Int64 {
  let mut h = h0
  let mut i = 0
  while i < w.length() {
    h = (h * 131L + w[i].to_int().to_int64()) % 1000000007L
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_bench <encode|decode> <names.txt> <rounds>")
    return 2
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 2
  }
  let rounds = parse_uint(args[3])
  let names = read_names(data)
  let m = build(names)
  if args[1] == "encode" || args[1] == "encode-uncompressed" {
    // `encode-uncompressed` is a pion-only diagnostic: same loop with
    // EncodeOptions::uncompressed() (no hash-table / scratch allocation).
    let opts = if args[1] == "encode" {
      dns::EncodeOptions::default()
    } else {
      dns::EncodeOptions::uncompressed()
    }
    let mut total = 0L
    let mut h = 0L
    let mut r = 0
    while r < rounds {
      match dns::encode_message_with(m, opts) {
        Ok(w) => {
          total = total + w.length().to_int64()
          if r == 0 {
            h = fold(0L, w)
          }
        }
        Err(e) => {
          io_println(world, "pack error: " + dns::dns_error_message(e))
          return 1
        }
      }
      r = r + 1
    }
    io_println(world, "mode=encode")
    io_println(world, "rrs=" + names.length().to_string())
    io_println(world, "bytes=" + total.to_string())
    io_println(world, "wire_hash=" + h.to_string())
  } else {
    let w = match dns::encode_message(m) {
      Ok(b) => b
      Err(_) => return 1
    }
    let mut rrs = 0L
    let mut r = 0
    while r < rounds {
      match dns::decode_message(w) {
        Ok(d) => rrs = rrs + d.answers.length().to_int64()
        Err(e) => {
          io_println(world, "unpack error: " + dns::dns_error_message(e))
          return 1
        }
      }
      r = r + 1
    }
    io_println(world, "mode=decode")
    io_println(world, "rrs=" + rrs.to_string())
    io_println(world, "wire=" + w.length().to_string())
  }
  0
}
