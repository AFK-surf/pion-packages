///| Differential / native-vs-wasm32 driver for the `dns` red-team audit.
///| Usage: dns_audit_diff_driver <msg|name|ip6|tcp|doh> <cases.tsv>
///| Each input line is `<id>\t<hex>`; each output line is `<id>\t<verdict>`.
///| The `msg` format is mirrored byte-for-byte by ../go/main.go and
///| ../rust/src/main.rs so the three outputs can be diffed directly.

import "dns"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///|
fn hex_decode(s : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((hexval(s[start + 2 * i].to_int()) << 4) | hexval(s[start + 2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///|
fn hex_of(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_byte(digits.code_unit_at(v >> 4).to_byte())
    sb.write_byte(digits.code_unit_at(v & 0x0F).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn name_key(n : dns::Name) -> String {
  hex_of(n.to_lowercase().wire)
}

///|
fn rr_key(sb : StringBuilder, r : dns::ResourceRecord) -> Unit {
  sb.write_char(' ')
  sb.write_string(name_key(r.name))
  sb.write_char('/')
  sb.write_string(r.rtype.to_string())
  sb.write_char('/')
  sb.write_string(r.rclass.to_string())
  sb.write_char('/')
  sb.write_string(r.ttl.to_string())
  match r.rdata {
    dns::RData::A(ip) => {
      sb.write_char('/')
      sb.write_string(hex_of(ip.to_bytes()))
    }
    dns::RData::AAAA(ip) => {
      sb.write_char('/')
      sb.write_string(hex_of(ip.to_bytes()))
    }
    dns::RData::CNAME(n) | dns::RData::NS(n) | dns::RData::PTR(n) => {
      sb.write_char('/')
      sb.write_string(name_key(n))
    }
    dns::RData::MX(mx) => {
      sb.write_char('/')
      sb.write_string(mx.preference.to_string())
      sb.write_char(',')
      sb.write_string(name_key(mx.exchange))
    }
    _ => ()
  }
}

///|
fn msg_verdict(b : Bytes) -> String {
  match dns::decode_message(b) {
    Err(e) => "ERR " + dns::dns_error_message(e)
    Ok(m) => {
      let sb = StringBuilder::new()
      let mut opt = 0
      let mut ar = 0
      let mut i = 0
      while i < m.additionals.length() {
        if m.additionals[i].rtype == dns::type_opt {
          opt = opt + 1
        } else {
          ar = ar + 1
        }
        i = i + 1
      }
      sb.write_string("OK qd=" + m.questions.length().to_string())
      sb.write_string(" an=" + m.answers.length().to_string())
      sb.write_string(" ns=" + m.authorities.length().to_string())
      sb.write_string(" ar=" + ar.to_string())
      sb.write_string(" opt=" + opt.to_string())
      i = 0
      while i < m.questions.length() {
        let q = m.questions[i]
        sb.write_string(" q:" + name_key(q.name) + "/" + q.qtype.to_string() + "/" + q.qclass.to_string())
        i = i + 1
      }
      i = 0
      while i < m.answers.length() {
        rr_key(sb, m.answers[i])
        i = i + 1
      }
      i = 0
      while i < m.authorities.length() {
        rr_key(sb, m.authorities[i])
        i = i + 1
      }
      i = 0
      while i < m.additionals.length() {
        if m.additionals[i].rtype != dns::type_opt {
          rr_key(sb, m.additionals[i])
        }
        i = i + 1
      }
      // Side channel (not part of the cross-library verdict): own re-encode.
      sb.write_string("\t")
      match dns::encode_message(m) {
        Err(_) => sb.write_string("enc=ERR")
        Ok(w) => {
          sb.write_string("enc=" + w.length().to_string())
          match dns::decode_message(w) {
            Ok(_) => sb.write_string(" rt=ok")
            Err(_) => sb.write_string(" rt=ERR")
          }
        }
      }
      sb.to_string()
    }
  }
}

///|
fn name_verdict(b : Bytes) -> String {
  match dns::Name::parse(b.to_string()) {
    Err(_) => "ERR"
    Ok(n) => "OK " + hex_of(n.wire) + " " + n.to_string()
  }
}

///|
fn ip6_verdict(b : Bytes) -> String {
  match dns::Ipv6Addr::parse(b.to_string()) {
    Err(_) => "ERR"
    Ok(a) => "OK " + a.to_string()
  }
}

///|
fn tcp_verdict(b : Bytes) -> String {
  match dns::decode_tcp(b) {
    Err(_) => "ERR"
    Ok(dns::TcpDecodeStatus::Incomplete(n)) => "INCOMPLETE " + n.to_string()
    Ok(dns::TcpDecodeStatus::Complete(m, used)) =>
    "COMPLETE " + used.to_string() + " an=" + m.answers.length().to_string()
  }
}

///|
fn doh_verdict(b : Bytes) -> String {
  match dns::decode_doh_get_param(b.to_string()) {
    Err(_) => "ERR"
    Ok(m) => "OK id=" + m.header.id.to_string() + " qd=" + m.questions.length().to_string()
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: dns_audit_diff_driver <msg|name|ip6|tcp|doh> <cases.tsv>")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "cannot read " + args[2])
      return 2
    }
  }
  let n = data.length()
  let mut pos = 0
  while pos < n {
    let mut tab = pos
    while tab < n && data[tab].to_int() != 9 {
      tab = tab + 1
    }
    let mut eol = tab
    while eol < n && data[eol].to_int() != 10 {
      eol = eol + 1
    }
    if tab < eol {
      let mut id = Bytes::new(tab - pos)
      let mut k = 0
      while k < tab - pos {
        id[k] = data[pos + k]
        k = k + 1
      }
      let payload = hex_decode(data, tab + 1, eol)
      let v = if mode == "msg" {
        msg_verdict(payload)
      } else if mode == "name" {
        name_verdict(payload)
      } else if mode == "ip6" {
        ip6_verdict(payload)
      } else if mode == "tcp" {
        tcp_verdict(payload)
      } else {
        doh_verdict(payload)
      }
      io_println(world, id.to_string() + "\t" + v)
    }
    pos = eol + 1
  }
  0
}
