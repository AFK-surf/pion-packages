///| Shared helpers for the `packages/dns` red-team audit suite.
///| Every helper only uses the public `dns` API (black-box audit).

import "dns"

///|
pub fn bytes_of(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (vals[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
pub fn bytes_fill(n : Int, v : Int) -> Bytes {
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (v & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
pub fn hex_of(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_byte(digits.code_unit_at(v >> 4).to_byte())
    sb.write_byte(digits.code_unit_at(v & 0x0F).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn must_name(s : String) -> dns::Name {
  match dns::Name::parse(s) {
    Ok(n) => n
    Err(e) => {
      debug_assert(false, "must_name(" + s + "): " + dns::dns_error_message(e))
      dns::Name::root()
    }
  }
}

///|
pub fn rr(name : dns::Name, rtype : Int, rdata : dns::RData) -> dns::ResourceRecord {
  dns::ResourceRecord::{ name: name, rtype: rtype, rclass: dns::class_in, ttl: 300L, rdata: rdata }
}

///| A response with one question (`q.example.`) and the given answers.
pub fn response_with(answers : Array[dns::ResourceRecord]) -> dns::Message {
  let q = dns::Message::query(0x4242, must_name("q.example."), dns::type_a)
  let m = dns::Message::response_for(q, dns::rcode_noerror)
  let mut i = 0
  while i < answers.length() {
    m.answers.push(answers[i])
    i = i + 1
  }
  m
}

///| Outcome of "encode, then decode our own bytes".
pub enum RoundTrip {
  EncodeErr(String)
  DecodeErr(String, Bytes)
  Ok(dns::Message, Bytes)
}

///|
pub fn round_trip(m : dns::Message) -> RoundTrip {
  match dns::encode_message(m) {
    Err(e) => RoundTrip::EncodeErr(dns::dns_error_message(e))
    Ok(w) =>
    match dns::decode_message_with(w, dns::DecodeLimits::{ ..dns::DecodeLimits::default(), allow_trailing_bytes: false }) {
      Ok(d) => RoundTrip::Ok(d, w)
      Err(e) => RoundTrip::DecodeErr(dns::dns_error_message(e), w)
    }
  }
}

///| RFC-correct encoder contract: either reject the message (`Err`) or emit
///| bytes that the same library decodes back. `Ok` + undecodable bytes is a
///| silent wire-format corruption.
pub fn encoder_is_self_consistent(m : dns::Message) -> (Bool, String) {
  match round_trip(m) {
    RoundTrip::EncodeErr(e) => (true, "rejected at encode: " + e)
    RoundTrip::Ok(_, _) => (true, "round-trips")
    RoundTrip::DecodeErr(e, w) =>
    (false, "encode_message returned Ok but own decoder rejects it (" + e + "), wire=" + hex_of(w))
  }
}

///|
pub fn is_err(r : Result[dns::Message, dns::DnsError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

///| Builds a minimal response wire: header (qd=0, an=1) + one RR at offset 12
///| with owner = root, given type, and raw RDATA bytes.
pub fn wire_one_rr(rtype : Int, rdata : Bytes) -> Bytes {
  let n = rdata.length()
  let mut b = Bytes::new(12 + 11 + n)
  b[0] = (0x12).to_byte()
  b[1] = (0x34).to_byte()
  b[2] = (0x81).to_byte()
  b[3] = (0x80).to_byte()
  b[7] = (1).to_byte()
  b[12] = (0).to_byte()
  b[13] = ((rtype >> 8) & 0xFF).to_byte()
  b[14] = (rtype & 0xFF).to_byte()
  b[15] = (0).to_byte()
  b[16] = (1).to_byte()
  b[20] = (60).to_byte()
  b[21] = ((n >> 8) & 0xFF).to_byte()
  b[22] = (n & 0xFF).to_byte()
  let mut i = 0
  while i < n {
    b[23 + i] = rdata[i]
    i = i + 1
  }
  b
}

///| Same as `wire_one_rr` but the RR lives in the additional section with an
///| arbitrary owner byte sequence (already in wire form).
pub fn wire_one_rr_section(section : Int, owner : Bytes, rtype : Int, rclass : Int, rdata : Bytes) -> Bytes {
  let on = owner.length()
  let n = rdata.length()
  let mut b = Bytes::new(12 + on + 10 + n)
  b[0] = (0x12).to_byte()
  b[1] = (0x34).to_byte()
  b[2] = (0x81).to_byte()
  b[3] = (0x80).to_byte()
  b[6 + section * 2 + 1] = (1).to_byte()
  let mut i = 0
  while i < on {
    b[12 + i] = owner[i]
    i = i + 1
  }
  let p = 12 + on
  b[p] = ((rtype >> 8) & 0xFF).to_byte()
  b[p + 1] = (rtype & 0xFF).to_byte()
  b[p + 2] = ((rclass >> 8) & 0xFF).to_byte()
  b[p + 3] = (rclass & 0xFF).to_byte()
  b[p + 8] = ((n >> 8) & 0xFF).to_byte()
  b[p + 9] = (n & 0xFF).to_byte()
  i = 0
  while i < n {
    b[p + 10 + i] = rdata[i]
    i = i + 1
  }
  b
}
