///| Modern DNS RR types & transport framing compliance tests:
///| AAAA (RFC 3596), SRV (RFC 2782), CAA (RFC 8659), NAPTR (RFC 2915),
///| OPT/EDNS0 (RFC 6891/7871/7873/7830), SVCB/HTTPS (RFC 9460),
///| DS/DNSKEY/RRSIG/NSEC (RFC 4034), Unknown passthrough, TCP framing, and DoH (RFC 8484).

///|
test "rfc3596_aaaa_and_rfc5952_ipv6_formatting" {
  let ip1 = match Ipv6Addr::parse("2001:0db8:0000:0000:0000:0000:0000:0001") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse ipv6 failed")
      Ipv6Addr::{ hi: 0UL, lo: 0UL }
    }
  }
  debug_assert(ip1.to_string() == "2001:db8::1", "RFC 5952 canonical compression")

  let loopback = match Ipv6Addr::parse("::1") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse ::1 failed")
      Ipv6Addr::{ hi: 0UL, lo: 0UL }
    }
  }
  debug_assert(loopback.to_string() == "::1", "loopback ::1")

  let unspec = match Ipv6Addr::parse("::") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse :: failed")
      Ipv6Addr::{ hi: 0UL, lo: 0UL }
    }
  }
  debug_assert(unspec.to_string() == "::", "unspecified ::")

  // Single zero group must NOT be compressed to :: per RFC 5952 §4.2.2
  let single_zero = match Ipv6Addr::parse("2001:db8:0:1:1:1:1:1") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse single_zero failed")
      Ipv6Addr::{ hi: 0UL, lo: 0UL }
    }
  }
  debug_assert(single_zero.to_string() == "2001:db8:0:1:1:1:1:1", "no single-zero ::")

  let name = must_name("ipv6.example.com.")
  let resp = Message::response_for(Message::query(0x1001, name, type_aaaa), rcode_noerror)
  resp.answers.push(ResourceRecord::{
    name: name,
    rtype: type_aaaa,
    rclass: class_in,
    ttl: 120L,
    rdata: RData::AAAA(ip1),
  })
  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode AAAA failed")
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) =>
    match dec.answers[0].rdata {
      RData::AAAA(got) => debug_assert(got.eq(ip1), "AAAA roundtrip")
      _ => debug_assert(false, "expected AAAA")
    }
    Err(_) => debug_assert(false, "decode AAAA failed")
  }
}

///|
test "rfc2782_srv_rfc8659_caa_rfc2915_naptr" {
  let zone = must_name("example.com.")
  let resp = Message::response_for(Message::query(0x2002, zone, type_any), rcode_noerror)
  resp.answers.push(ResourceRecord::{
    name: must_name("_sip._tcp.example.com."),
    rtype: type_srv,
    rclass: class_in,
    ttl: 300L,
    rdata: RData::SRV(SrvData::{
      priority: 10,
      weight: 60,
      port: 5060,
      target: must_name("sipserver.example.com."),
    }),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_caa,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::CAA(CaaData::{
      flags: 128,
      tag: "issue",
      value: "letsencrypt.org".to_bytes(),
    }),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_naptr,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::NAPTR(NaptrData::{
      order: 100,
      preference: 10,
      flags: "S".to_bytes(),
      service: "SIP+D2U".to_bytes(),
      regexp: "".to_bytes(),
      replacement: must_name("_sip._udp.example.com."),
    }),
  })

  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode SRV/CAA/NAPTR failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) => {
      debug_assert(dec.answers.length() == 3, "3 answers")
      match dec.answers[0].rdata {
        RData::SRV(srv) => {
          debug_assert(srv.priority == 10 && srv.weight == 60 && srv.port == 5060, "srv nums")
          debug_assert(srv.target.to_string() == "sipserver.example.com.", "srv target")
        }
        _ => debug_assert(false, "expected SRV")
      }
      match dec.answers[1].rdata {
        RData::CAA(caa) => {
          debug_assert(caa.flags == 128, "caa flags")
          debug_assert(caa.tag == "issue", "caa tag")
          debug_assert(caa.value.to_string() == "letsencrypt.org", "caa value")
        }
        _ => debug_assert(false, "expected CAA")
      }
      match dec.answers[2].rdata {
        RData::NAPTR(n) => {
          debug_assert(n.order == 100 && n.preference == 10, "naptr order/pref")
          debug_assert(n.flags.to_string() == "S", "naptr flags")
          debug_assert(n.service.to_string() == "SIP+D2U", "naptr service")
          debug_assert(n.regexp.length() == 0, "naptr regexp empty")
          debug_assert(n.replacement.to_string() == "_sip._udp.example.com.", "naptr repl")
        }
        _ => debug_assert(false, "expected NAPTR")
      }
    }
    Err(e) => debug_assert(false, "decode SRV/CAA/NAPTR failed: " + dns_error_message(e))
  }
}

///|
test "rfc6891_edns0_opt_ecs_cookie_padding_ext_rcode" {
  let req = Message::query(0x3003, must_name("edns.example.com."), type_a)
  let resp = Message::response_for(req, rcode_badcookie & 0x0F) // low 4 bits = 7
  let ecs = EcsOption::{
    family: 1,
    source_prefix_len: 24,
    scope_prefix_len: 24,
    address: bytes_from_ints([198, 51, 100]),
  }
  let cookie = CookieOption::{
    client: bytes_from_ints([1, 2, 3, 4, 5, 6, 7, 8]),
    server: bytes_from_ints([9, 10, 11, 12, 13, 14, 15, 16]),
  }
  let opt_rr = ResourceRecord::opt(
    4096,
    (rcode_badcookie >> 4) & 0xFF, // high 8 bits = 1 -> 16 + 7 = 23 (BADCOOKIE)
    0,
    true,
    [
      EdnsOption::Ecs(ecs),
      EdnsOption::Cookie(cookie),
      EdnsOption::Padding(16),
      EdnsOption::Unknown(65001, bytes_from_ints([0xDE, 0xAD])),
    ],
  )
  resp.additionals.push(opt_rr)

  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode OPT failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) => {
      debug_assert(dec.extended_rcode() == rcode_badcookie, "extended rcode BADCOOKIE=23")
      debug_assert(dec.additionals.length() == 1, "1 additional OPT")
      let opt = dec.additionals[0]
      debug_assert(opt.rtype == type_opt, "type OPT")
      debug_assert(opt.edns_udp_size() == 4096, "udp size 4096")
      debug_assert(opt.edns_ext_rcode() == 1, "ext rcode 1")
      debug_assert(opt.edns_version() == 0, "edns version 0")
      debug_assert(opt.edns_dnssec_ok(), "DO bit set")
      match opt.rdata {
        RData::OPT(od) => {
          debug_assert(od.options.length() == 4, "4 EDNS options")
          match od.options[0] {
            EdnsOption::Ecs(e) => {
              debug_assert(e.family == 1, "ecs family IPv4")
              debug_assert(e.source_prefix_len == 24, "ecs src 24")
              debug_assert(e.scope_prefix_len == 24, "ecs scope 24")
              debug_assert(bytes_equal(e.address, bytes_from_ints([198, 51, 100])), "ecs addr")
            }
            _ => debug_assert(false, "expected ECS")
          }
          match od.options[1] {
            EdnsOption::Cookie(c) => {
              debug_assert(c.client.length() == 8 && c.server.length() == 8, "cookie lengths")
              debug_assert(bytes_equal(c.client, cookie.client), "client cookie")
              debug_assert(bytes_equal(c.server, cookie.server), "server cookie")
            }
            _ => debug_assert(false, "expected Cookie")
          }
          match od.options[2] {
            EdnsOption::Padding(plen) => debug_assert(plen == 16, "padding 16")
            _ => debug_assert(false, "expected Padding")
          }
          match od.options[3] {
            EdnsOption::Unknown(code, data) => {
              debug_assert(code == 65001, "unknown opt code")
              debug_assert(bytes_equal(data, bytes_from_ints([0xDE, 0xAD])), "unknown opt data")
            }
            _ => debug_assert(false, "expected Unknown EDNS option")
          }
        }
        _ => debug_assert(false, "expected OPT RData")
      }
    }
    Err(e) => debug_assert(false, "decode OPT failed: " + dns_error_message(e))
  }
}

///|
test "rfc9460_svcb_and_https_full_svcparams" {
  let host = must_name("cdn.example.com.")
  let resp = Message::response_for(Message::query(0x4004, host, type_https), rcode_noerror)
  // ServiceMode HTTPS with all standard SvcParams in ascending key order (0..6 + custom)
  let v6 = match Ipv6Addr::parse("2001:db8::443") {
    Ok(v) => v
    Err(_) => Ipv6Addr::{ hi: 0UL, lo: 0UL }
  }
  resp.answers.push(ResourceRecord::{
    name: host,
    rtype: type_https,
    rclass: class_in,
    ttl: 300L,
    rdata: RData::HTTPS(SvcbData::{
      priority: 1,
      target: Name::root(),
      params: [
        SvcParam::Mandatory([svcparam_alpn, svcparam_port]),
        SvcParam::Alpn(["h3".to_bytes(), "h2".to_bytes()]),
        SvcParam::NoDefaultAlpn,
        SvcParam::Port(8443),
        SvcParam::Ipv4Hint([Ipv4Addr::new(192, 0, 2, 10), Ipv4Addr::new(192, 0, 2, 11)]),
        SvcParam::Ech(bytes_from_ints([0x00, 0x04, 0xFE, 0x0D, 0x01, 0x02])),
        SvcParam::Ipv6Hint([v6]),
        SvcParam::Unknown(65280, "custom".to_bytes()),
      ],
    }),
  })
  // AliasMode SVCB (priority 0, empty params)
  resp.answers.push(ResourceRecord::{
    name: must_name("_foo.example.com."),
    rtype: type_svcb,
    rclass: class_in,
    ttl: 300L,
    rdata: RData::SVCB(SvcbData::{
      priority: 0,
      target: must_name("target.example.net."),
      params: [],
    }),
  })

  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode SVCB/HTTPS failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) => {
      debug_assert(dec.answers.length() == 2, "2 answers")
      match dec.answers[0].rdata {
        RData::HTTPS(svcb) => {
          debug_assert(svcb.priority == 1, "https priority 1")
          debug_assert(svcb.target.is_root(), "https target root")
          debug_assert(svcb.params.length() == 8, "8 svcparams")
          match svcb.params[0] {
            SvcParam::Mandatory(ks) =>
            debug_assert(ks.length() == 2 && ks[0] == 1 && ks[1] == 3, "mandatory")
            _ => debug_assert(false, "expected Mandatory")
          }
          match svcb.params[1] {
            SvcParam::Alpn(ids) =>
            debug_assert(
              ids.length() == 2 && ids[0].to_string() == "h3" && ids[1].to_string() == "h2",
              "alpn",
            )
            _ => debug_assert(false, "expected Alpn")
          }
          match svcb.params[2] {
            SvcParam::NoDefaultAlpn => ()
            _ => debug_assert(false, "expected NoDefaultAlpn")
          }
          match svcb.params[3] {
            SvcParam::Port(p) => debug_assert(p == 8443, "port 8443")
            _ => debug_assert(false, "expected Port")
          }
          match svcb.params[4] {
            SvcParam::Ipv4Hint(ips) =>
            debug_assert(
              ips.length() == 2 && ips[0].eq(Ipv4Addr::new(192, 0, 2, 10)),
              "ipv4hint",
            )
            _ => debug_assert(false, "expected Ipv4Hint")
          }
          match svcb.params[5] {
            SvcParam::Ech(ech) => debug_assert(ech.length() == 6, "ech")
            _ => debug_assert(false, "expected Ech")
          }
          match svcb.params[6] {
            SvcParam::Ipv6Hint(ips) =>
            debug_assert(ips.length() == 1 && ips[0].eq(v6), "ipv6hint")
            _ => debug_assert(false, "expected Ipv6Hint")
          }
          match svcb.params[7] {
            SvcParam::Unknown(k, v) =>
            debug_assert(k == 65280 && v.to_string() == "custom", "unknown svcparam")
            _ => debug_assert(false, "expected Unknown svcparam")
          }
        }
        _ => debug_assert(false, "expected HTTPS")
      }
      match dec.answers[1].rdata {
        RData::SVCB(alias) => {
          debug_assert(alias.priority == 0, "alias priority 0")
          debug_assert(alias.target.to_string() == "target.example.net.", "alias target")
          debug_assert(alias.params.length() == 0, "alias 0 params")
        }
        _ => debug_assert(false, "expected SVCB")
      }
    }
    Err(e) => debug_assert(false, "decode SVCB/HTTPS failed: " + dns_error_message(e))
  }
}

///|
test "rfc4034_dnssec_ds_dnskey_rrsig_nsec_and_unknown_passthrough" {
  let zone = must_name("example.com.")
  let resp = Message::response_for(Message::query(0x5005, zone, type_any), rcode_noerror)
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_ds,
    rclass: class_in,
    ttl: 86400L,
    rdata: RData::DS(DsData::{
      key_tag: 60485,
      algorithm: 13,
      digest_type: 2,
      digest: bytes_from_ints([0x12, 0x34, 0x56, 0x78, 0x9A, 0xBC]),
    }),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_dnskey,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::DNSKEY(DnskeyData::{
      flags: 257,
      protocol: 3,
      algorithm: 13,
      public_key: bytes_from_ints([0xAA, 0xBB, 0xCC, 0xDD]),
    }),
  })
  resp.answers.push(ResourceRecord::{
    name: zone,
    rtype: type_rrsig,
    rclass: class_in,
    ttl: 3600L,
    rdata: RData::RRSIG(RrsigData::{
      type_covered: type_a,
      algorithm: 13,
      labels: 2,
      original_ttl: 3600L,
      expiration: 1796000000L,
      inception: 1795000000L,
      key_tag: 60485,
      signer_name: zone,
      signature: bytes_from_ints([0x01, 0x02, 0x03, 0x04, 0x05]),
    }),
  })
  resp.authorities.push(ResourceRecord::{
    name: zone,
    rtype: type_nsec,
    rclass: class_in,
    ttl: 300L,
    rdata: RData::NSEC(NsecData::{
      next_domain: must_name("www.example.com."),
      types: [type_a, type_ns, type_soa, type_mx, type_txt, type_aaaa, type_rrsig, type_nsec, type_caa],
    }),
  })
  resp.additionals.push(ResourceRecord::{
    name: zone,
    rtype: 65280,
    rclass: class_in,
    ttl: 60L,
    rdata: RData::Unknown(65280, bytes_from_ints([0xCA, 0xFE, 0xBA, 0xBE])),
  })

  let wire = match encode_message(resp) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode DNSSEC/Unknown failed: " + dns_error_message(e))
      Bytes::new(0)
    }
  }
  match decode_message(wire) {
    Ok(dec) => {
      match dec.answers[0].rdata {
        RData::DS(ds) =>
        debug_assert(
          ds.key_tag == 60485 && ds.algorithm == 13 && ds.digest_type == 2 && ds.digest.length() == 6,
          "DS roundtrip",
        )
        _ => debug_assert(false, "expected DS")
      }
      match dec.answers[1].rdata {
        RData::DNSKEY(dk) =>
        debug_assert(
          dk.flags == 257 && dk.protocol == 3 && dk.algorithm == 13 && dk.public_key.length() == 4,
          "DNSKEY roundtrip",
        )
        _ => debug_assert(false, "expected DNSKEY")
      }
      match dec.answers[2].rdata {
        RData::RRSIG(sig) =>
        debug_assert(
          sig.type_covered == type_a &&
          sig.key_tag == 60485 &&
          sig.expiration == 1796000000L &&
          sig.signer_name.eq_exact(zone) &&
          sig.signature.length() == 5,
          "RRSIG roundtrip",
        )
        _ => debug_assert(false, "expected RRSIG")
      }
      match dec.authorities[0].rdata {
        RData::NSEC(nsec) => {
          debug_assert(nsec.next_domain.to_string() == "www.example.com.", "NSEC next")
          debug_assert(nsec.types.length() == 9, "NSEC 9 types across 2 windows")
          debug_assert(nsec.types[0] == type_a && nsec.types[8] == type_caa, "NSEC window 0 & 1")
        }
        _ => debug_assert(false, "expected NSEC")
      }
      match dec.additionals[0].rdata {
        RData::Unknown(rt, data) =>
        debug_assert(
          rt == 65280 && bytes_equal(data, bytes_from_ints([0xCA, 0xFE, 0xBA, 0xBE])),
          "Unknown passthrough",
        )
        _ => debug_assert(false, "expected Unknown")
      }
    }
    Err(e) => debug_assert(false, "decode DNSSEC/Unknown failed: " + dns_error_message(e))
  }
}

///|
test "rfc1035_tcp_framing_and_rfc8484_doh_get" {
  let q = Message::query(0x99AA, must_name("www.example.com."), type_a)
  let framed = match encode_tcp(q) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "encode_tcp failed")
      Bytes::new(0)
    }
  }
  let flen = framed.length()
  debug_assert(flen == 35, "2B len + 33B query = 35B")
  debug_assert(framed[0].to_int() == 0 && framed[1].to_int() == 33, "2B big-endian length")

  // Partial 1-byte header -> Incomplete
  let mut p1 = Bytes::new(1)
  p1[0] = framed[0]
  match decode_tcp(p1) {
    Ok(TcpDecodeStatus::Incomplete(_)) => ()
    _ => debug_assert(false, "1B TCP must be Incomplete")
  }
  // Partial body -> Incomplete(35)
  let mut p10 = Bytes::new(10)
  let mut i = 0
  while i < 10 {
    p10[i] = framed[i]
    i = i + 1
  }
  match decode_tcp(p10) {
    Ok(TcpDecodeStatus::Incomplete(needed)) => debug_assert(needed == 35, "needed 35 bytes")
    _ => debug_assert(false, "10B TCP must be Incomplete(35)")
  }
  // Full frame -> Complete
  match decode_tcp(framed) {
    Ok(TcpDecodeStatus::Complete(msg, consumed)) => {
      debug_assert(consumed == 35, "consumed 35")
      debug_assert(msg.header.id == 0x99AA, "tcp id")
      debug_assert(msg.questions[0].name.to_string() == "www.example.com.", "tcp qname")
    }
    _ => debug_assert(false, "full TCP frame must be Complete")
  }

  // RFC 8484 §4.1 exact GET `dns=` vector: ID=0, RD=1, www.example.com. IN A
  let rfc8484_vec = "AAABAAABAAAAAAAAA3d3dwdleGFtcGxlA2NvbQAAAQAB"
  match decode_doh_get_param(rfc8484_vec) {
    Ok(msg) => {
      debug_assert(msg.header.id == 0, "doh id 0")
      debug_assert(msg.header.rd, "doh rd")
      debug_assert(msg.questions.length() == 1, "doh 1 q")
      debug_assert(msg.questions[0].name.to_string() == "www.example.com.", "doh qname")
      match encode_doh_get_param(msg) {
        Ok(enc) => debug_assert(enc == rfc8484_vec, "exact RFC 8484 base64url roundtrip")
        Err(_) => debug_assert(false, "encode_doh_get_param failed")
      }
    }
    Err(e) => debug_assert(false, "decode_doh_get_param failed: " + dns_error_message(e))
  }
}
