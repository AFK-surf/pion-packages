///| Pion Native head-to-head benchmark for packages/dns.
///| Modes: "decode" (200k mixed responses) | "encode" (200k compressed responses) | "query_rt" (500k query roundtrips)

import "dns"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_rr(h0 : Int64, rr : dns::ResourceRecord) -> Int64 {
  let mut h = mix(h0, rr.rtype.to_int64())
  h = mix(h, rr.ttl)
  match rr.rdata {
    dns::RData::A(ip) => {
      h = mix(h, ip.a.to_int64())
      h = mix(h, ip.b.to_int64())
      h = mix(h, ip.c.to_int64())
      h = mix(h, ip.d.to_int64())
    }
    dns::RData::AAAA(ip) => {
      h = mix(h, ((ip.hi >> 48) & 0xFFFFUL).to_int64())
      h = mix(h, (ip.lo & 0xFFFFUL).to_int64())
    }
    dns::RData::CNAME(n) | dns::RData::NS(n) | dns::RData::PTR(n) =>
    h = mix(h, n.label_count().to_int64())
    dns::RData::MX(mx) => {
      h = mix(h, mx.preference.to_int64())
      h = mix(h, mx.exchange.label_count().to_int64())
    }
    dns::RData::TXT(chunks) => {
      let mut tlen = 0L
      let mut i = 0
      while i < chunks.length() {
        tlen = tlen + chunks[i].length().to_int64()
        i = i + 1
      }
      h = mix(h, tlen)
    }
    dns::RData::SOA(soa) => {
      h = mix(h, soa.serial)
      h = mix(h, soa.minimum)
    }
    dns::RData::SRV(srv) => {
      h = mix(h, srv.priority.to_int64())
      h = mix(h, srv.weight.to_int64())
      h = mix(h, srv.port.to_int64())
    }
    dns::RData::OPT(_) => h = mix(h, rr.edns_udp_size().to_int64())
    _ => ()
  }
  h
}

///|
fn hash_msg(h0 : Int64, msg : dns::Message) -> Int64 {
  let mut h = mix(h0, msg.header.id.to_int64())
  h = mix(h, msg.header.rcode.to_int64())
  let mut i = 0
  while i < msg.questions.length() {
    h = mix(h, msg.questions[i].qtype.to_int64())
    i = i + 1
  }
  i = 0
  while i < msg.answers.length() {
    h = hash_rr(h, msg.answers[i])
    i = i + 1
  }
  i = 0
  while i < msg.authorities.length() {
    h = hash_rr(h, msg.authorities[i])
    i = i + 1
  }
  i = 0
  while i < msg.additionals.length() {
    h = hash_rr(h, msg.additionals[i])
    i = i + 1
  }
  h
}

///|
fn bench_decode(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = dns::DecodeLimits::default()
  let mut packets = 0L
  let mut total_rrs = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 200 {
    let mut pos = 0
    while pos + 2 <= dlen {
      let plen = (data[pos].to_int() << 8) | data[pos + 1].to_int()
      let pstart = pos + 2
      let pend = pstart + plen
      match dns::decode_message_at(data, pstart, pend, lim) {
        Ok(msg) => {
          packets = packets + 1L
          total_rrs = total_rrs +
          (msg.answers.length() + msg.authorities.length() + msg.additionals.length()).to_int64()
          checksum = hash_msg(checksum, msg)
        }
        Err(e) => {
          io_println(world, "decode error: " + dns::dns_error_message(e))
          return 1
        }
      }
      pos = pend
    }
    round = round + 1
  }
  io_println(world, "mode=decode")
  io_println(world, "packets=" + packets.to_string())
  io_println(world, "rrs=" + total_rrs.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_encode(world : World, data : Bytes) -> Int {
  let dlen = data.length()
  let lim = dns::DecodeLimits::default()
  let msgs : Array[dns::Message] = []
  let mut pos = 0
  while pos + 2 <= dlen {
    let plen = (data[pos].to_int() << 8) | data[pos + 1].to_int()
    let pstart = pos + 2
    let pend = pstart + plen
    match dns::decode_message_at(data, pstart, pend, lim) {
      Ok(m) => msgs.push(m)
      Err(e) => {
        io_println(world, "preload decode error: " + dns::dns_error_message(e))
        return 1
      }
    }
    pos = pend
  }
  let opts = dns::EncodeOptions::default()
  let n = msgs.length()
  let mut encoded = 0L
  let mut hdr_hash = 0L
  let mut rt_hash = 0L
  let mut round = 0
  while round < 200 {
    let mut i = 0
    while i < n {
      match dns::encode_message_with(msgs[i], opts) {
        Ok(wire) => {
          encoded = encoded + 1L
          let mut b = 0
          while b < 12 {
            hdr_hash = mix(hdr_hash, wire[b].to_int().to_int64())
            b = b + 1
          }
          if round == 0 {
            match dns::decode_message(wire) {
              Ok(rt) => rt_hash = hash_msg(rt_hash, rt)
              Err(_) => return 1
            }
          }
        }
        Err(_) => return 1
      }
      i = i + 1
    }
    round = round + 1
  }
  io_println(world, "mode=encode")
  io_println(world, "encoded=" + encoded.to_string())
  io_println(world, "hdr_hash=" + hdr_hash.to_string())
  io_println(world, "rt_hash=" + rt_hash.to_string())
  0
}

///|
fn bench_query_rt(world : World) -> Int {
  let names : Array[dns::Name] = []
  let mut i = 0
  while i < 100 {
    match dns::Name::parse("host" + i.to_string() + ".api.example.com.") {
      Ok(n) => names.push(n)
      Err(_) => return 1
    }
    i = i + 1
  }
  let qtypes : Array[Int] = [dns::type_a, dns::type_aaaa, dns::type_mx, dns::type_txt]
  let opts = dns::EncodeOptions::default()
  let mut ops = 0L
  let mut total_bytes = 0L
  let mut checksum = 0L
  i = 0
  while i < 500000 {
    let id = i & 0xFFFF
    let qname = names[i % 100]
    let qt = qtypes[i & 3]
    let q = dns::Message::query(id, qname, qt)
    match dns::encode_message_with(q, opts) {
      Ok(wire) => {
        total_bytes = total_bytes + wire.length().to_int64()
        match dns::decode_message(wire) {
          Ok(dec) => {
            ops = ops + 1L
            checksum = mix(checksum, dec.header.id.to_int64())
            checksum = mix(checksum, dec.questions[0].qtype.to_int64())
            checksum = mix(checksum, wire.length().to_int64())
          }
          Err(_) => return 1
        }
      }
      Err(_) => return 1
    }
    i = i + 1
  }
  io_println(world, "mode=query_rt")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: dns_bench <decode|encode|query_rt> [corpus.bin]")
    return 1
  }
  let mode = args[1]
  if mode == "query_rt" {
    return bench_query_rt(world)
  }
  if args.length() < 3 {
    io_println(world, "missing corpus path")
    return 1
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  if mode == "decode" {
    bench_decode(world, data)
  } else if mode == "encode" {
    bench_encode(world, data)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
