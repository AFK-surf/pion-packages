///| RFC 1035 / RFC 4343 DNS Domain Name parsing, formatting, escaping,
///| case-insensitive comparison, and CVE-hardened iterative wire decompression.

///| Fold ASCII uppercase byte `'A'..'Z'` to lowercase `'a'..'z'` (RFC 4343).
#verify
pub fn ascii_lower_byte(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

///|
pub fn Name::root() -> Name {
  let mut b = Bytes::new(1)
  b[0] = (0).to_byte()
  Name::{ wire: b }
}

///| Parse a DNS presentation-format domain name into canonical uncompressed wire format.
///| Supports `\.`, `\\`, and `\DDD` (000..255) decimal byte escapes per RFC 1035 §5.1.
pub fn Name::parse(s : String) -> Result[Name, DnsError] {
  let raw = s.to_bytes()
  let n = raw.length()
  if n == 0 || (n == 1 && raw[0].to_int() == 46) {
    return Ok(Name::root())
  }
  let mut scratch = Bytes::new(255)
  let mut out_pos = 0
  let mut i = 0
  while i < n {
    let label_len_pos = out_pos
    out_pos = out_pos + 1
    if out_pos >= 255 {
      return Err(DnsError::NameTooLong)
    }
    let mut llen = 0
    while i < n {
      let c = raw[i].to_int()
      if c == 46 {
        i = i + 1
        break
      }
      let mut byte_val = c
      if c == 92 {
        // Backslash escape
        i = i + 1
        if i >= n {
          return Err(DnsError::InvalidNameEscape(i))
        }
        let d0 = raw[i].to_int()
        if d0 >= 48 && d0 <= 57 {
          if i + 2 >= n {
            return Err(DnsError::InvalidNameEscape(i))
          }
          let d1 = raw[i + 1].to_int()
          let d2 = raw[i + 2].to_int()
          if !(d1 >= 48 && d1 <= 57 && d2 >= 48 && d2 <= 57) {
            return Err(DnsError::InvalidNameEscape(i))
          }
          let dec = (d0 - 48) * 100 + (d1 - 48) * 10 + (d2 - 48)
          if dec > 255 {
            return Err(DnsError::InvalidNameEscape(i))
          }
          byte_val = dec
          i = i + 3
        } else {
          byte_val = d0
          i = i + 1
        }
      } else {
        i = i + 1
      }
      llen = llen + 1
      if llen > 63 {
        return Err(DnsError::LabelTooLong(llen))
      }
      if out_pos >= 254 {
        return Err(DnsError::NameTooLong)
      }
      scratch[out_pos] = byte_val.to_byte()
      out_pos = out_pos + 1
    }
    if llen == 0 {
      return Err(DnsError::EmptyLabel)
    }
    scratch[label_len_pos] = llen.to_byte()
  }
  if out_pos >= 255 {
    return Err(DnsError::NameTooLong)
  }
  scratch[out_pos] = (0).to_byte()
  let total = out_pos + 1
  let mut wire = Bytes::new(total)
  let mut k = 0
  while k < total {
    wire[k] = scratch[k]
    k = k + 1
  }
  Ok(Name::{ wire: wire })
}

///|
pub fn Name::from_labels(labels : Array[Bytes]) -> Result[Name, DnsError] {
  let count = labels.length()
  let mut total = 1
  let mut i = 0
  while i < count {
    let llen = labels[i].length()
    if llen == 0 {
      return Err(DnsError::EmptyLabel)
    }
    if llen > 63 {
      return Err(DnsError::LabelTooLong(llen))
    }
    total = total + 1 + llen
    if total > 255 {
      return Err(DnsError::NameTooLong)
    }
    i = i + 1
  }
  let mut wire = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < count {
    let lbl = labels[i]
    let llen = lbl.length()
    wire[pos] = llen.to_byte()
    pos = pos + 1
    let mut j = 0
    while j < llen {
      wire[pos] = lbl[j]
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  wire[pos] = (0).to_byte()
  Ok(Name::{ wire: wire })
}

///| Validate that a `Name.wire` buffer is a well-formed uncompressed DNS wire name
///| (1..=255 bytes, <= 127 labels, each label 1..=63 bytes, terminated by 0x00 at the exact end).
fn validate_name_wire(w : Bytes) -> Result[Unit, DnsError] {
  let n = w.length()
  if n == 0 {
    return Err(DnsError::InvalidField("empty Name.wire"))
  }
  if n > 255 {
    return Err(DnsError::NameTooLong)
  }
  let mut pos = 0
  let mut labels = 0
  while pos < n {
    let llen = w[pos].to_int()
    if llen == 0 {
      if pos + 1 != n {
        return Err(DnsError::InvalidField("trailing bytes after root label in Name.wire"))
      }
      return Ok(())
    }
    if (llen & 0xC0) != 0 {
      return Err(DnsError::InvalidLabelType(llen & 0xC0, pos))
    }
    if llen > 63 {
      return Err(DnsError::LabelTooLong(llen))
    }
    labels = labels + 1
    if labels > 127 {
      return Err(DnsError::NameTooLong)
    }
    let next = pos + 1 + llen
    if next >= n {
      return Err(DnsError::UnexpectedEof(pos))
    }
    pos = next
  }
  Err(DnsError::UnexpectedEof(n))
}

///|
pub fn Name::labels(self : Name) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let w = self.wire
  let n = w.length()
  let mut pos = 0
  while pos < n {
    let llen = w[pos].to_int()
    if llen == 0 || llen > 63 || pos + 1 + llen > n {
      break
    }
    pos = pos + 1
    let mut lbl = Bytes::new(llen)
    let mut j = 0
    while j < llen {
      lbl[j] = w[pos + j]
      j = j + 1
    }
    out.push(lbl)
    pos = pos + llen
  }
  out
}

///|
pub fn Name::label_count(self : Name) -> Int {
  let w = self.wire
  let n = w.length()
  let mut pos = 0
  let mut count = 0
  while pos < n {
    let llen = w[pos].to_int()
    if llen == 0 || llen > 63 || pos + 1 + llen > n {
      break
    }
    count = count + 1
    pos = pos + 1 + llen
  }
  count
}

///|
pub fn Name::wire_len(self : Name) -> Int {
  self.wire.length()
}

///|
pub fn Name::is_root(self : Name) -> Bool {
  self.wire.length() == 1 && self.wire[0].to_int() == 0
}

///|
fn is_zone_label_special(b : Int) -> Bool {
  b == 46 || // '.'
  b == 92 || // '\'
  b == 59 || // ';'
  b == 40 || // '('
  b == 41 || // ')'
  b == 34 || // '"'
  b == 64 || // '@'
  b == 36 || // '$'
  b == 39 // '\''
}

///|
pub fn Name::to_string(self : Name) -> String {
  let w = self.wire
  let n = w.length()
  if n <= 1 || w[0].to_int() == 0 {
    return "."
  }
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    let llen = w[pos].to_int()
    if llen == 0 || llen > 63 || pos + 1 + llen > n {
      break
    }
    pos = pos + 1
    let mut j = 0
    while j < llen {
      let b = w[pos + j].to_int()
      if is_zone_label_special(b) {
        sb.write_byte((92).to_byte())
        sb.write_byte(b.to_byte())
      } else if b <= 32 || b >= 127 {
        sb.write_byte((92).to_byte())
        sb.write_byte((48 + b / 100).to_byte())
        sb.write_byte((48 + (b / 10) % 10).to_byte())
        sb.write_byte((48 + b % 10).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      j = j + 1
    }
    sb.write_char('.')
    pos = pos + llen
  }
  sb.to_string()
}

///| RFC 4343 ASCII case-insensitive equality on canonical wire bytes.
pub fn Name::eq_ignore_case(self : Name, other : Name) -> Bool {
  let a = self.wire
  let b = other.wire
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut pos = 0
  while pos < n {
    let la = a[pos].to_int()
    let lb = b[pos].to_int()
    if la != lb {
      return false
    }
    if la == 0 {
      return true
    }
    if la > 63 || pos + 1 + la > n {
      return false
    }
    pos = pos + 1
    let mut j = 0
    while j < la {
      if ascii_lower_byte(a[pos + j].to_int()) != ascii_lower_byte(b[pos + j].to_int()) {
        return false
      }
      j = j + 1
    }
    pos = pos + la
  }
  true
}

///|
pub fn Name::eq_exact(self : Name, other : Name) -> Bool {
  bytes_equal(self.wire, other.wire)
}

///|
pub fn Name::to_lowercase(self : Name) -> Name {
  let w = self.wire
  let n = w.length()
  let mut out = Bytes::new(n)
  let mut pos = 0
  while pos < n {
    let llen = w[pos].to_int()
    out[pos] = w[pos]
    if llen == 0 || llen > 63 || pos + 1 + llen > n {
      break
    }
    pos = pos + 1
    let mut j = 0
    while j < llen {
      out[pos + j] = ascii_lower_byte(w[pos + j].to_int()).to_byte()
      j = j + 1
    }
    pos = pos + llen
  }
  Name::{ wire: out }
}

///|
pub fn Name::is_subdomain_of(self : Name, parent : Name) -> Bool {
  let sw = self.wire
  let pw = parent.wire
  let slen = sw.length()
  let plen = pw.length()
  if plen > slen || plen == 0 {
    return false
  }
  if plen == 1 && pw[0].to_int() == 0 {
    return true
  }
  let target_off = slen - plen
  // Walk labels of `self` to verify `target_off` is on a label boundary
  let mut pos = 0
  while pos < target_off {
    let llen = sw[pos].to_int()
    if llen == 0 || llen > 63 || pos + 1 + llen > slen {
      return false
    }
    pos = pos + 1 + llen
  }
  if pos != target_off {
    return false
  }
  // Compare suffix case-insensitively
  let mut ppos = 0
  while ppos < plen {
    let ls = sw[pos].to_int()
    let lp = pw[ppos].to_int()
    if ls != lp {
      return false
    }
    if lp == 0 {
      return true
    }
    if lp > 63 || pos + 1 + lp > slen || ppos + 1 + lp > plen {
      return false
    }
    pos = pos + 1
    ppos = ppos + 1
    let mut j = 0
    while j < lp {
      if ascii_lower_byte(sw[pos + j].to_int()) != ascii_lower_byte(pw[ppos + j].to_int()) {
        return false
      }
      j = j + 1
    }
    pos = pos + lp
    ppos = ppos + lp
  }
  true
}

///| Iterative, CVE-hardened DNS wire name decoder using caller-provided 255-byte scratch buffer.
///| `base`..`end` is the message slice inside `buf`; `offset` is an absolute index in `buf`.
///| `min_rel_floor` is the minimum legal relative pointer target (0 for standalone, 12 for messages).
fn decode_name_with_scratch(
  buf : Bytes,
  base : Int,
  end : Int,
  offset : Int,
  min_rel_floor : Int,
  max_pointers : Int,
  scratch : Bytes,
) -> Result[(Name, Int), DnsError] {
  if base < 0 || end < base || end > buf.length() || offset < base || offset >= end {
    return Err(DnsError::UnexpectedEof(offset - base))
  }
  // Fast path: scan uncompressed name first without touching scratch
  let mut scan = offset
  let mut is_compressed = false
  let mut total_uncomp = 0
  while true {
    if scan >= end {
      return Err(DnsError::UnexpectedEof(scan - base))
    }
    let b = buf[scan].to_int()
    if b == 0 {
      total_uncomp = total_uncomp + 1
      if total_uncomp > 255 {
        return Err(DnsError::NameTooLong)
      }
      scan = scan + 1
      break
    }
    let tag = b & 0xC0
    if tag == 0 {
      let next = scan + 1 + b
      if next > end {
        return Err(DnsError::UnexpectedEof(scan - base))
      }
      total_uncomp = total_uncomp + 1 + b
      if total_uncomp >= 255 {
        return Err(DnsError::NameTooLong)
      }
      scan = next
    } else if tag == 0xC0 {
      is_compressed = true
      break
    } else {
      return Err(DnsError::InvalidLabelType(tag, scan - base))
    }
  }
  if !is_compressed {
    let mut wire = Bytes::new(total_uncomp)
    let mut i = 0
    while i < total_uncomp {
      wire[i] = buf[offset + i]
      i = i + 1
    }
    return Ok((Name::{ wire: wire }, scan))
  }
  // Compressed path: iterative jump with strictly decreasing target ceiling
  let mut out_len = 0
  let mut cur = offset
  let mut jumped = false
  let mut next_after = offset
  let mut jumps = 0
  let mut min_target = end
  let abs_floor = base + min_rel_floor
  while true {
    if cur >= end {
      return Err(DnsError::UnexpectedEof(cur - base))
    }
    let b = buf[cur].to_int()
    if b == 0 {
      if out_len >= 255 {
        return Err(DnsError::NameTooLong)
      }
      scratch[out_len] = (0).to_byte()
      out_len = out_len + 1
      if !jumped {
        next_after = cur + 1
      }
      break
    }
    let tag = b & 0xC0
    if tag == 0 {
      let next = cur + 1 + b
      if next > end {
        return Err(DnsError::UnexpectedEof(cur - base))
      }
      if out_len + 1 + b + 1 > 255 {
        return Err(DnsError::NameTooLong)
      }
      scratch[out_len] = b.to_byte()
      out_len = out_len + 1
      let mut j = 0
      while j < b {
        scratch[out_len] = buf[cur + 1 + j]
        out_len = out_len + 1
        j = j + 1
      }
      cur = next
    } else if tag == 0xC0 {
      if cur + 1 >= end {
        return Err(DnsError::UnexpectedEof(cur - base))
      }
      let ptr_rel = ((b & 0x3F) << 8) | buf[cur + 1].to_int()
      let target = base + ptr_rel
      if target >= end || target < abs_floor {
        return Err(DnsError::PointerOutOfBounds(cur - base))
      }
      if target == cur {
        return Err(DnsError::PointerLoop(cur - base))
      }
      if !jumped {
        if target > cur {
          return Err(DnsError::ForwardPointer(cur - base))
        }
        if target >= offset {
          return Err(DnsError::PointerLoop(cur - base))
        }
        next_after = cur + 2
        jumped = true
        min_target = target
      } else {
        if target >= min_target {
          return Err(DnsError::PointerLoop(cur - base))
        }
        min_target = target
      }
      jumps = jumps + 1
      if jumps > max_pointers {
        return Err(DnsError::TooManyPointers(max_pointers))
      }
      cur = target
    } else {
      return Err(DnsError::InvalidLabelType(tag, cur - base))
    }
  }
  let mut wire = Bytes::new(out_len)
  let mut k = 0
  while k < out_len {
    wire[k] = scratch[k]
    k = k + 1
  }
  Ok((Name::{ wire: wire }, next_after))
}

///|
fn decode_name_internal(
  buf : Bytes,
  base : Int,
  end : Int,
  offset : Int,
  min_rel_floor : Int,
  max_pointers : Int,
) -> Result[(Name, Int), DnsError] {
  decode_name_with_scratch(buf, base, end, offset, min_rel_floor, max_pointers, Bytes::new(255))
}

///| Decode a DNS domain name starting at `offset` in `buf` (with default max_pointers=128).
pub fn decode_name(buf : Bytes, offset : Int) -> Result[(Name, Int), DnsError] {
  decode_name_internal(buf, 0, buf.length(), offset, 0, 128)
}
