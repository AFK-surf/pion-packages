///| Core Sans-IO DNS wire protocol types, constants, options, limits, and errors
///| (RFC 1035 / 2782 / 2915 / 3596 / 4034 / 6891 / 7830 / 7871 / 7873 / 8484 / 8659 / 9460).

// ---------------------------------------------------------------------------
// DNS Constants
// ---------------------------------------------------------------------------

///| DNS Opcodes (RFC 1035 / 1996 / 2136 / 8490)
pub let opcode_query : Int = 0
pub let opcode_iquery : Int = 1
pub let opcode_status : Int = 2
pub let opcode_notify : Int = 4
pub let opcode_update : Int = 5
pub let opcode_dso : Int = 6

///| DNS Response Codes (RFC 1035 / 2136 / 6891 / 7873)
pub let rcode_noerror : Int = 0
pub let rcode_formerr : Int = 1
pub let rcode_servfail : Int = 2
pub let rcode_nxdomain : Int = 3
pub let rcode_notimp : Int = 4
pub let rcode_refused : Int = 5
pub let rcode_yxdomain : Int = 6
pub let rcode_yxrrset : Int = 7
pub let rcode_nxrrset : Int = 8
pub let rcode_notauth : Int = 9
pub let rcode_notzone : Int = 10
pub let rcode_badvers : Int = 16
pub let rcode_badcookie : Int = 23

///| DNS Classes (RFC 1035 / 2136)
pub let class_in : Int = 1
pub let class_cs : Int = 2
pub let class_ch : Int = 3
pub let class_hs : Int = 4
pub let class_none : Int = 254
pub let class_any : Int = 255

///| DNS RR Types
pub let type_a : Int = 1
pub let type_ns : Int = 2
pub let type_cname : Int = 5
pub let type_soa : Int = 6
pub let type_ptr : Int = 12
pub let type_mx : Int = 15
pub let type_txt : Int = 16
pub let type_aaaa : Int = 28
pub let type_srv : Int = 33
pub let type_naptr : Int = 35
pub let type_opt : Int = 41
pub let type_ds : Int = 43
pub let type_rrsig : Int = 46
pub let type_nsec : Int = 47
pub let type_dnskey : Int = 48
pub let type_svcb : Int = 64
pub let type_https : Int = 65
pub let type_any : Int = 255
pub let type_caa : Int = 257

///| EDNS0 Option Codes
pub let edns_opt_ecs : Int = 8
pub let edns_opt_cookie : Int = 10
pub let edns_opt_padding : Int = 12

///| SVCB/HTTPS SvcParam Keys (RFC 9460)
pub let svcparam_mandatory : Int = 0
pub let svcparam_alpn : Int = 1
pub let svcparam_no_default_alpn : Int = 2
pub let svcparam_port : Int = 3
pub let svcparam_ipv4hint : Int = 4
pub let svcparam_ech : Int = 5
pub let svcparam_ipv6hint : Int = 6

///| RFC 8484 DNS-over-HTTPS media type
pub let doh_media_type : String = "application/dns-message"

// ---------------------------------------------------------------------------
// Error Type
// ---------------------------------------------------------------------------

///|
pub enum DnsError {
  UnexpectedEof(Int)
  TrailingBytes(Int)
  InvalidLabelType(Int, Int)
  LabelTooLong(Int)
  NameTooLong
  EmptyLabel
  InvalidNameEscape(Int)
  PointerLoop(Int)
  ForwardPointer(Int)
  PointerOutOfBounds(Int)
  TooManyPointers(Int)
  TooManyQuestions(Int)
  TooManyRecords(Int)
  MessageTooLarge(Int)
  InvalidRData(String)
  InvalidIpAddress(String)
  InvalidBase64Url(Int)
  InvalidField(String)
}

///|
pub fn dns_error_message(err : DnsError) -> String {
  match err {
    DnsError::UnexpectedEof(pos) => "dns: unexpected EOF at offset " + pos.to_string()
    DnsError::TrailingBytes(pos) => "dns: trailing bytes at offset " + pos.to_string()
    DnsError::InvalidLabelType(ty, pos) =>
    "dns: invalid label type " + ty.to_string() + " at offset " + pos.to_string()
    DnsError::LabelTooLong(len) => "dns: label length " + len.to_string() + " exceeds 63"
    DnsError::NameTooLong => "dns: domain name exceeds 255 wire bytes"
    DnsError::EmptyLabel => "dns: empty label in domain name"
    DnsError::InvalidNameEscape(pos) => "dns: invalid escape sequence at offset " + pos.to_string()
    DnsError::PointerLoop(pos) => "dns: compression pointer loop at offset " + pos.to_string()
    DnsError::ForwardPointer(pos) => "dns: forward compression pointer at offset " + pos.to_string()
    DnsError::PointerOutOfBounds(pos) =>
    "dns: compression pointer out of bounds at offset " + pos.to_string()
    DnsError::TooManyPointers(limit) =>
    "dns: compression pointer hops exceeded limit " + limit.to_string()
    DnsError::TooManyQuestions(limit) =>
    "dns: question count exceeded limit " + limit.to_string()
    DnsError::TooManyRecords(limit) =>
    "dns: resource record count exceeded limit " + limit.to_string()
    DnsError::MessageTooLarge(len) =>
    "dns: message size " + len.to_string() + " exceeds limit"
    DnsError::InvalidRData(msg) => "dns: invalid RDATA: " + msg
    DnsError::InvalidIpAddress(msg) => "dns: invalid IP address: " + msg
    DnsError::InvalidBase64Url(pos) =>
    "dns: invalid base64url encoding at offset " + pos.to_string()
    DnsError::InvalidField(msg) => "dns: invalid field: " + msg
  }
}

// ---------------------------------------------------------------------------
// Options & Limits
// ---------------------------------------------------------------------------

///|
pub val struct DecodeLimits {
  pub max_pointers : Int
  pub max_questions : Int
  pub max_records : Int
  pub max_message_bytes : Int
  pub allow_trailing_bytes : Bool
}

///|
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_pointers: 128,
    max_questions: 1024,
    max_records: 4096,
    max_message_bytes: 65535,
    allow_trailing_bytes: true,
  }
}

///|
pub fn DecodeLimits::strict() -> DecodeLimits {
  DecodeLimits::{
    max_pointers: 64,
    max_questions: 256,
    max_records: 1024,
    max_message_bytes: 65535,
    allow_trailing_bytes: false,
  }
}

///|
pub val struct EncodeOptions {
  pub compress : Bool
}

///|
pub fn EncodeOptions::default() -> EncodeOptions {
  EncodeOptions::{ compress: true }
}

///|
pub fn EncodeOptions::uncompressed() -> EncodeOptions {
  EncodeOptions::{ compress: false }
}

// ---------------------------------------------------------------------------
// Value Types: Header, IPv4, IPv6, Name
// ---------------------------------------------------------------------------

///| 12-byte DNS Message Header (RFC 1035 §4.1.1 + RFC 4035 AD/CD).
pub val struct Header {
  pub id : Int
  pub qr : Bool
  pub opcode : Int
  pub aa : Bool
  pub tc : Bool
  pub rd : Bool
  pub ra : Bool
  pub z : Bool
  pub ad : Bool
  pub cd : Bool
  pub rcode : Int
  pub qdcount : Int
  pub ancount : Int
  pub nscount : Int
  pub arcount : Int
}

///|
pub fn Header::new(id : Int) -> Header {
  Header::{
    id: id,
    qr: false,
    opcode: opcode_query,
    aa: false,
    tc: false,
    rd: true,
    ra: false,
    z: false,
    ad: false,
    cd: false,
    rcode: rcode_noerror,
    qdcount: 0,
    ancount: 0,
    nscount: 0,
    arcount: 0,
  }
}

///| 4-byte IPv4 address (value type).
pub val struct Ipv4Addr {
  pub a : Int
  pub b : Int
  pub c : Int
  pub d : Int
}

///|
pub fn Ipv4Addr::new(a : Int, b : Int, c : Int, d : Int) -> Ipv4Addr {
  Ipv4Addr::{ a: a & 0xFF, b: b & 0xFF, c: c & 0xFF, d: d & 0xFF }
}

///|
pub fn Ipv4Addr::eq(self : Ipv4Addr, other : Ipv4Addr) -> Bool {
  self.a == other.a && self.b == other.b && self.c == other.c && self.d == other.d
}

///| 16-byte IPv6 address stored as two big-endian 64-bit halves (value type).
pub val struct Ipv6Addr {
  pub hi : UInt64
  pub lo : UInt64
}

///|
pub fn Ipv6Addr::eq(self : Ipv6Addr, other : Ipv6Addr) -> Bool {
  self.hi == other.hi && self.lo == other.lo
}

///| DNS Domain Name stored in uncompressed canonical wire format (`[len][label]...[0]`, <= 255 B).
///| Case is preserved as encoded/parsed; use `eq_ignore_case` for RFC 4343 comparison.
pub struct Name {
  pub wire : Bytes
}

// ---------------------------------------------------------------------------
// Question & RData Types
// ---------------------------------------------------------------------------

///|
pub struct Question {
  pub name : Name
  pub qtype : Int
  pub qclass : Int
}

///|
pub fn Question::new(name : Name, qtype : Int, qclass : Int) -> Question {
  Question::{ name: name, qtype: qtype, qclass: qclass }
}

///|
pub struct MxData {
  pub preference : Int
  pub exchange : Name
}

///|
pub struct SoaData {
  pub mname : Name
  pub rname : Name
  pub serial : Int64
  pub refresh : Int64
  pub retry : Int64
  pub expire : Int64
  pub minimum : Int64
}

///|
pub struct SrvData {
  pub priority : Int
  pub weight : Int
  pub port : Int
  pub target : Name
}

///|
pub struct CaaData {
  pub flags : Int
  pub tag : String
  pub value : Bytes
}

///|
pub struct NaptrData {
  pub order : Int
  pub preference : Int
  pub flags : Bytes
  pub service : Bytes
  pub regexp : Bytes
  pub replacement : Name
}

///| RFC 7871 EDNS Client Subnet option (code 8).
pub struct EcsOption {
  pub family : Int
  pub source_prefix_len : Int
  pub scope_prefix_len : Int
  pub address : Bytes
}

///| RFC 7873 DNS Cookie option (code 10).
pub struct CookieOption {
  pub client : Bytes
  pub server : Bytes
}

///| RFC 6891 EDNS0 Option.
pub enum EdnsOption {
  Ecs(EcsOption)
  Cookie(CookieOption)
  Padding(Int)
  Unknown(Int, Bytes)
}

///| RFC 6891 OPT Pseudo-RR RDATA.
pub struct OptData {
  pub options : Array[EdnsOption]
}

///| RFC 9460 SvcParam.
pub enum SvcParam {
  Mandatory(Array[Int])
  Alpn(Array[Bytes])
  NoDefaultAlpn
  Port(Int)
  Ipv4Hint(Array[Ipv4Addr])
  Ech(Bytes)
  Ipv6Hint(Array[Ipv6Addr])
  Unknown(Int, Bytes)
}

///| RFC 9460 SVCB / HTTPS RDATA.
pub struct SvcbData {
  pub priority : Int
  pub target : Name
  pub params : Array[SvcParam]
}

///| RFC 4034 §5 DS RDATA.
pub struct DsData {
  pub key_tag : Int
  pub algorithm : Int
  pub digest_type : Int
  pub digest : Bytes
}

///| RFC 4034 §2 DNSKEY RDATA.
pub struct DnskeyData {
  pub flags : Int
  pub protocol : Int
  pub algorithm : Int
  pub public_key : Bytes
}

///| RFC 4034 §3 RRSIG RDATA.
pub struct RrsigData {
  pub type_covered : Int
  pub algorithm : Int
  pub labels : Int
  pub original_ttl : Int64
  pub expiration : Int64
  pub inception : Int64
  pub key_tag : Int
  pub signer_name : Name
  pub signature : Bytes
}

///| RFC 4034 §4 NSEC RDATA.
pub struct NsecData {
  pub next_domain : Name
  pub types : Array[Int]
}

///| Structured DNS Resource Record Data.
pub enum RData {
  A(Ipv4Addr)
  AAAA(Ipv6Addr)
  CNAME(Name)
  NS(Name)
  PTR(Name)
  MX(MxData)
  TXT(Array[Bytes])
  SOA(SoaData)
  SRV(SrvData)
  CAA(CaaData)
  NAPTR(NaptrData)
  OPT(OptData)
  SVCB(SvcbData)
  HTTPS(SvcbData)
  DS(DsData)
  DNSKEY(DnskeyData)
  RRSIG(RrsigData)
  NSEC(NsecData)
  Unknown(Int, Bytes)
}

///| DNS Resource Record.
pub struct ResourceRecord {
  pub name : Name
  pub rtype : Int
  pub rclass : Int
  pub ttl : Int64
  pub rdata : RData
}

///| Complete DNS Message.
pub struct Message {
  pub header : Header
  pub questions : Array[Question]
  pub answers : Array[ResourceRecord]
  pub authorities : Array[ResourceRecord]
  pub additionals : Array[ResourceRecord]
}

///| TCP 2-byte length-prefixed decode status (RFC 1035 §4.2.2).
pub enum TcpDecodeStatus {
  Complete(Message, Int)
  Incomplete(Int)
}

///| Byte-wise equality helper for `Bytes`.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}
