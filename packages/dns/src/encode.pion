///|
pub fn Message::query(id : Int, name : Name, qtype : Int) -> Message {
  let _ = (id, name, qtype)
  Message::{
    header: Header::new(0),
    questions: [],
    answers: [],
    authorities: [],
    additionals: [],
  }
}

///|
pub fn Message::response_for(req : Message, rcode : Int) -> Message {
  let _ = (req, rcode)
  Message::{
    header: Header::new(0),
    questions: [],
    answers: [],
    authorities: [],
    additionals: [],
  }
}

///|
pub fn ResourceRecord::opt(
  udp_payload_size : Int,
  ext_rcode : Int,
  version : Int,
  dnssec_ok : Bool,
  options : Array[EdnsOption],
) -> ResourceRecord {
  let _ = (udp_payload_size, ext_rcode, version, dnssec_ok, options)
  ResourceRecord::{
    name: Name::root(),
    rtype: type_opt,
    rclass: 0,
    ttl: 0L,
    rdata: RData::OPT(OptData::{ options: [] }),
  }
}

