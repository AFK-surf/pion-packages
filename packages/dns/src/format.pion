///| Zone-file and dig-style presentation formatters for DNS Messages and Resource Records.

///|
pub fn rtype_to_string(rtype : Int) -> String {
  if rtype == type_a {
    "A"
  } else if rtype == type_ns {
    "NS"
  } else if rtype == type_cname {
    "CNAME"
  } else if rtype == type_soa {
    "SOA"
  } else if rtype == type_ptr {
    "PTR"
  } else if rtype == type_mx {
    "MX"
  } else if rtype == type_txt {
    "TXT"
  } else if rtype == type_aaaa {
    "AAAA"
  } else if rtype == type_srv {
    "SRV"
  } else if rtype == type_naptr {
    "NAPTR"
  } else if rtype == type_opt {
    "OPT"
  } else if rtype == type_ds {
    "DS"
  } else if rtype == type_rrsig {
    "RRSIG"
  } else if rtype == type_nsec {
    "NSEC"
  } else if rtype == type_dnskey {
    "DNSKEY"
  } else if rtype == type_svcb {
    "SVCB"
  } else if rtype == type_https {
    "HTTPS"
  } else if rtype == type_any {
    "ANY"
  } else if rtype == type_caa {
    "CAA"
  } else {
    "TYPE" + rtype.to_string()
  }
}

///|
pub fn rclass_to_string(rclass : Int) -> String {
  if rclass == class_in {
    "IN"
  } else if rclass == class_cs {
    "CS"
  } else if rclass == class_ch {
    "CH"
  } else if rclass == class_hs {
    "HS"
  } else if rclass == class_none {
    "NONE"
  } else if rclass == class_any {
    "ANY"
  } else {
    "CLASS" + rclass.to_string()
  }
}

///|
pub fn rcode_to_string(rcode : Int) -> String {
  if rcode == rcode_noerror {
    "NOERROR"
  } else if rcode == rcode_formerr {
    "FORMERR"
  } else if rcode == rcode_servfail {
    "SERVFAIL"
  } else if rcode == rcode_nxdomain {
    "NXDOMAIN"
  } else if rcode == rcode_notimp {
    "NOTIMP"
  } else if rcode == rcode_refused {
    "REFUSED"
  } else if rcode == rcode_yxdomain {
    "YXDOMAIN"
  } else if rcode == rcode_yxrrset {
    "YXRRSET"
  } else if rcode == rcode_nxrrset {
    "NXRRSET"
  } else if rcode == rcode_notauth {
    "NOTAUTH"
  } else if rcode == rcode_notzone {
    "NOTZONE"
  } else if rcode == rcode_badvers {
    "BADVERS"
  } else if rcode == rcode_badcookie {
    "BADCOOKIE"
  } else {
    "RCODE" + rcode.to_string()
  }
}

///|
pub fn opcode_to_string(opcode : Int) -> String {
  if opcode == opcode_query {
    "QUERY"
  } else if opcode == opcode_iquery {
    "IQUERY"
  } else if opcode == opcode_status {
    "STATUS"
  } else if opcode == opcode_notify {
    "NOTIFY"
  } else if opcode == opcode_update {
    "UPDATE"
  } else if opcode == opcode_dso {
    "DSO"
  } else {
    "OPCODE" + opcode.to_string()
  }
}

///|
fn write_hex_bytes(sb : StringBuilder, b : Bytes) -> Unit {
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_byte(digits.code_unit_at(v >> 4).to_byte())
    sb.write_byte(digits.code_unit_at(v & 0x0F).to_byte())
    i = i + 1
  }
}

///|
fn write_quoted_bytes(sb : StringBuilder, b : Bytes) -> Unit {
  sb.write_byte((34).to_byte())
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    if v == 34 || v == 92 {
      sb.write_byte((92).to_byte())
      sb.write_byte(v.to_byte())
    } else if v >= 32 && v <= 126 {
      sb.write_byte(v.to_byte())
    } else {
      sb.write_byte((92).to_byte())
      sb.write_byte((48 + v / 100).to_byte())
      sb.write_byte((48 + (v / 10) % 10).to_byte())
      sb.write_byte((48 + v % 10).to_byte())
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///|
pub fn rdata_to_text(rd : RData) -> String {
  let sb = StringBuilder::new()
  match rd {
    RData::A(ip) => sb.write_string(ip.to_string())
    RData::AAAA(ip) => sb.write_string(ip.to_string())
    RData::CNAME(n) | RData::NS(n) | RData::PTR(n) => sb.write_string(n.to_string())
    RData::MX(mx) => {
      sb.write_string(mx.preference.to_string())
      sb.write_char(' ')
      sb.write_string(mx.exchange.to_string())
    }
    RData::TXT(chunks) => {
      let mut i = 0
      while i < chunks.length() {
        if i > 0 {
          sb.write_char(' ')
        }
        write_quoted_bytes(sb, chunks[i])
        i = i + 1
      }
    }
    RData::SOA(soa) => {
      sb.write_string(soa.mname.to_string())
      sb.write_char(' ')
      sb.write_string(soa.rname.to_string())
      sb.write_char(' ')
      sb.write_string(soa.serial.to_string())
      sb.write_char(' ')
      sb.write_string(soa.refresh.to_string())
      sb.write_char(' ')
      sb.write_string(soa.retry.to_string())
      sb.write_char(' ')
      sb.write_string(soa.expire.to_string())
      sb.write_char(' ')
      sb.write_string(soa.minimum.to_string())
    }
    RData::SRV(srv) => {
      sb.write_string(srv.priority.to_string())
      sb.write_char(' ')
      sb.write_string(srv.weight.to_string())
      sb.write_char(' ')
      sb.write_string(srv.port.to_string())
      sb.write_char(' ')
      sb.write_string(srv.target.to_string())
    }
    RData::CAA(caa) => {
      sb.write_string(caa.flags.to_string())
      sb.write_char(' ')
      sb.write_string(caa.tag)
      sb.write_char(' ')
      write_quoted_bytes(sb, caa.value)
    }
    RData::NAPTR(n) => {
      sb.write_string(n.order.to_string())
      sb.write_char(' ')
      sb.write_string(n.preference.to_string())
      sb.write_char(' ')
      write_quoted_bytes(sb, n.flags)
      sb.write_char(' ')
      write_quoted_bytes(sb, n.service)
      sb.write_char(' ')
      write_quoted_bytes(sb, n.regexp)
      sb.write_char(' ')
      sb.write_string(n.replacement.to_string())
    }
    RData::OPT(od) => {
      sb.write_string("options=")
      sb.write_string(od.options.length().to_string())
    }
    RData::SVCB(sd) | RData::HTTPS(sd) => {
      sb.write_string(sd.priority.to_string())
      sb.write_char(' ')
      sb.write_string(sd.target.to_string())
      let mut i = 0
      while i < sd.params.length() {
        sb.write_char(' ')
        match sd.params[i] {
          SvcParam::Mandatory(_) => sb.write_string("mandatory=...")
          SvcParam::Alpn(ids) => {
            sb.write_string("alpn=\"")
            let mut j = 0
            while j < ids.length() {
              if j > 0 {
                sb.write_char(',')
              }
              sb.write_string(ids[j].to_string())
              j = j + 1
            }
            sb.write_char('"')
          }
          SvcParam::NoDefaultAlpn => sb.write_string("no-default-alpn")
          SvcParam::Port(p) => {
            sb.write_string("port=")
            sb.write_string(p.to_string())
          }
          SvcParam::Ipv4Hint(ips) => {
            sb.write_string("ipv4hint=")
            let mut j = 0
            while j < ips.length() {
              if j > 0 {
                sb.write_char(',')
              }
              sb.write_string(ips[j].to_string())
              j = j + 1
            }
          }
          SvcParam::Ech(e) => {
            sb.write_string("ech=")
            write_hex_bytes(sb, e)
          }
          SvcParam::Ipv6Hint(ips) => {
            sb.write_string("ipv6hint=")
            let mut j = 0
            while j < ips.length() {
              if j > 0 {
                sb.write_char(',')
              }
              sb.write_string(ips[j].to_string())
              j = j + 1
            }
          }
          SvcParam::Unknown(k, v) => {
            sb.write_string("key")
            sb.write_string(k.to_string())
            sb.write_char('=')
            write_hex_bytes(sb, v)
          }
        }
        i = i + 1
      }
    }
    RData::DS(ds) => {
      sb.write_string(ds.key_tag.to_string())
      sb.write_char(' ')
      sb.write_string(ds.algorithm.to_string())
      sb.write_char(' ')
      sb.write_string(ds.digest_type.to_string())
      sb.write_char(' ')
      write_hex_bytes(sb, ds.digest)
    }
    RData::DNSKEY(dk) => {
      sb.write_string(dk.flags.to_string())
      sb.write_char(' ')
      sb.write_string(dk.protocol.to_string())
      sb.write_char(' ')
      sb.write_string(dk.algorithm.to_string())
      sb.write_char(' ')
      write_hex_bytes(sb, dk.public_key)
    }
    RData::RRSIG(sig) => {
      sb.write_string(rtype_to_string(sig.type_covered))
      sb.write_char(' ')
      sb.write_string(sig.algorithm.to_string())
      sb.write_char(' ')
      sb.write_string(sig.labels.to_string())
      sb.write_char(' ')
      sb.write_string(sig.original_ttl.to_string())
      sb.write_char(' ')
      sb.write_string(sig.expiration.to_string())
      sb.write_char(' ')
      sb.write_string(sig.inception.to_string())
      sb.write_char(' ')
      sb.write_string(sig.key_tag.to_string())
      sb.write_char(' ')
      sb.write_string(sig.signer_name.to_string())
    }
    RData::NSEC(nsec) => {
      sb.write_string(nsec.next_domain.to_string())
      let mut i = 0
      while i < nsec.types.length() {
        sb.write_char(' ')
        sb.write_string(rtype_to_string(nsec.types[i]))
        i = i + 1
      }
    }
    RData::Unknown(_, raw) => {
      sb.write_string("\\# ")
      sb.write_string(raw.length().to_string())
      if raw.length() > 0 {
        sb.write_char(' ')
        write_hex_bytes(sb, raw)
      }
    }
  }
  sb.to_string()
}

///|
pub fn RData::to_text(self : RData) -> String {
  rdata_to_text(self)
}

///|
pub fn ResourceRecord::to_text(self : ResourceRecord) -> String {
  let sb = StringBuilder::new()
  sb.write_string(self.name.to_string())
  sb.write_char('\t')
  sb.write_string(self.ttl.to_string())
  sb.write_char('\t')
  sb.write_string(rclass_to_string(self.rclass))
  sb.write_char('\t')
  sb.write_string(rtype_to_string(self.rtype))
  sb.write_char('\t')
  sb.write_string(rdata_to_text(self.rdata))
  sb.to_string()
}

///|
pub fn Message::to_text(self : Message) -> String {
  let h = self.header
  let sb = StringBuilder::new()
  sb.write_string(";; ->>HEADER<<- opcode: ")
  sb.write_string(opcode_to_string(h.opcode))
  sb.write_string(", status: ")
  sb.write_string(rcode_to_string(self.extended_rcode()))
  sb.write_string(", id: ")
  sb.write_string(h.id.to_string())
  sb.write_string("\n;; flags:")
  if h.qr {
    sb.write_string(" qr")
  }
  if h.aa {
    sb.write_string(" aa")
  }
  if h.tc {
    sb.write_string(" tc")
  }
  if h.rd {
    sb.write_string(" rd")
  }
  if h.ra {
    sb.write_string(" ra")
  }
  if h.ad {
    sb.write_string(" ad")
  }
  if h.cd {
    sb.write_string(" cd")
  }
  sb.write_string("; QUERY: ")
  sb.write_string(self.questions.length().to_string())
  sb.write_string(", ANSWER: ")
  sb.write_string(self.answers.length().to_string())
  sb.write_string(", AUTHORITY: ")
  sb.write_string(self.authorities.length().to_string())
  sb.write_string(", ADDITIONAL: ")
  sb.write_string(self.additionals.length().to_string())
  sb.write_char('\n')
  if self.questions.length() > 0 {
    sb.write_string("\n;; QUESTION SECTION:\n")
    let mut i = 0
    while i < self.questions.length() {
      let q = self.questions[i]
      sb.write_char(';')
      sb.write_string(q.name.to_string())
      sb.write_char('\t')
      sb.write_string(rclass_to_string(q.qclass))
      sb.write_char('\t')
      sb.write_string(rtype_to_string(q.qtype))
      sb.write_char('\n')
      i = i + 1
    }
  }
  if self.answers.length() > 0 {
    sb.write_string("\n;; ANSWER SECTION:\n")
    let mut i = 0
    while i < self.answers.length() {
      sb.write_string(self.answers[i].to_text())
      sb.write_char('\n')
      i = i + 1
    }
  }
  if self.authorities.length() > 0 {
    sb.write_string("\n;; AUTHORITY SECTION:\n")
    let mut i = 0
    while i < self.authorities.length() {
      sb.write_string(self.authorities[i].to_text())
      sb.write_char('\n')
      i = i + 1
    }
  }
  if self.additionals.length() > 0 {
    sb.write_string("\n;; ADDITIONAL SECTION:\n")
    let mut i = 0
    while i < self.additionals.length() {
      sb.write_string(self.additionals[i].to_text())
      sb.write_char('\n')
      i = i + 1
    }
  }
  sb.to_string()
}
