///| IPv4 and IPv6 address parsing, wire conversion, and RFC 5952 canonical formatting.

///| Check whether `c` is an ASCII decimal digit `'0'..'9'`.
pub fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///| Parse an ASCII hex digit (`0-9`, `a-f`, `A-F`) into `0..=15`, or `-1` if invalid.
#verify
pub fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///|
fn append_hex_u16(sb : StringBuilder, v : Int) -> Unit {
  let digits = "0123456789abcdef"
  if v == 0 {
    sb.write_char('0')
    return
  }
  let mut started = false
  let mut shift = 12
  while shift >= 0 {
    let nib = (v >> shift) & 0xF
    if nib != 0 || started {
      sb.write_byte(digits.code_unit_at(nib).to_byte())
      started = true
    }
    shift = shift - 4
  }
}

///|
pub fn Ipv4Addr::parse(s : String) -> Result[Ipv4Addr, DnsError] {
  let n = s.length()
  if n < 7 || n > 15 {
    return Err(DnsError::InvalidIpAddress(s))
  }
  let parts : Array[Int] = [0, 0, 0, 0]
  let mut part_idx = 0
  let mut i = 0
  while i < n {
    if part_idx >= 4 {
      return Err(DnsError::InvalidIpAddress(s))
    }
    let start = i
    let mut octet = 0
    while i < n && s.code_unit_at(i) != 46 {
      let c = s.code_unit_at(i)
      if !is_ascii_digit(c) {
        return Err(DnsError::InvalidIpAddress(s))
      }
      octet = octet * 10 + (c - 48)
      if octet > 255 {
        return Err(DnsError::InvalidIpAddress(s))
      }
      i = i + 1
    }
    let dlen = i - start
    if dlen == 0 || (dlen > 1 && s.code_unit_at(start) == 48) {
      return Err(DnsError::InvalidIpAddress(s))
    }
    parts[part_idx] = octet
    part_idx = part_idx + 1
    if i < n {
      // skip '.'
      i = i + 1
      if i == n {
        return Err(DnsError::InvalidIpAddress(s))
      }
    }
  }
  if part_idx != 4 {
    return Err(DnsError::InvalidIpAddress(s))
  }
  Ok(Ipv4Addr::{ a: parts[0], b: parts[1], c: parts[2], d: parts[3] })
}

///|
pub fn Ipv4Addr::to_string(self : Ipv4Addr) -> String {
  let sb = StringBuilder::new()
  sb.write_string(self.a.to_string())
  sb.write_char('.')
  sb.write_string(self.b.to_string())
  sb.write_char('.')
  sb.write_string(self.c.to_string())
  sb.write_char('.')
  sb.write_string(self.d.to_string())
  sb.to_string()
}

///|
pub fn Ipv4Addr::to_bytes(self : Ipv4Addr) -> Bytes {
  let mut b = Bytes::new(4)
  b[0] = self.a.to_byte()
  b[1] = self.b.to_byte()
  b[2] = self.c.to_byte()
  b[3] = self.d.to_byte()
  b
}

///|
pub fn Ipv6Addr::from_segments(
  s0 : Int,
  s1 : Int,
  s2 : Int,
  s3 : Int,
  s4 : Int,
  s5 : Int,
  s6 : Int,
  s7 : Int,
) -> Ipv6Addr {
  let hi = (((s0 & 0xFFFF).to_int64().to_uint64()) << 48) |
  (((s1 & 0xFFFF).to_int64().to_uint64()) << 32) |
  (((s2 & 0xFFFF).to_int64().to_uint64()) << 16) |
  ((s3 & 0xFFFF).to_int64().to_uint64())
  let lo = (((s4 & 0xFFFF).to_int64().to_uint64()) << 48) |
  (((s5 & 0xFFFF).to_int64().to_uint64()) << 32) |
  (((s6 & 0xFFFF).to_int64().to_uint64()) << 16) |
  ((s7 & 0xFFFF).to_int64().to_uint64())
  Ipv6Addr::{ hi: hi, lo: lo }
}

///|
pub fn Ipv6Addr::from_bytes(b : Bytes) -> Result[Ipv6Addr, DnsError] {
  if b.length() != 16 {
    return Err(DnsError::InvalidIpAddress("IPv6 requires 16 bytes"))
  }
  let mut hi = 0UL
  let mut i = 0
  while i < 8 {
    hi = (hi << 8) | b[i].to_int().to_int64().to_uint64()
    i = i + 1
  }
  let mut lo = 0UL
  while i < 16 {
    lo = (lo << 8) | b[i].to_int().to_int64().to_uint64()
    i = i + 1
  }
  Ok(Ipv6Addr::{ hi: hi, lo: lo })
}

///|
fn parse_ipv4_slice(s : String, start : Int, end : Int) -> Result[Ipv4Addr, DnsError] {
  let n = end - start
  if n < 7 || n > 15 {
    return Err(DnsError::InvalidIpAddress(s))
  }
  let parts : Array[Int] = [0, 0, 0, 0]
  let mut part_idx = 0
  let mut i = start
  while i < end {
    if part_idx >= 4 {
      return Err(DnsError::InvalidIpAddress(s))
    }
    let pstart = i
    let mut octet = 0
    while i < end && s.code_unit_at(i) != 46 {
      let c = s.code_unit_at(i)
      if !is_ascii_digit(c) {
        return Err(DnsError::InvalidIpAddress(s))
      }
      octet = octet * 10 + (c - 48)
      if octet > 255 {
        return Err(DnsError::InvalidIpAddress(s))
      }
      i = i + 1
    }
    let dlen = i - pstart
    if dlen == 0 || (dlen > 1 && s.code_unit_at(pstart) == 48) {
      return Err(DnsError::InvalidIpAddress(s))
    }
    parts[part_idx] = octet
    part_idx = part_idx + 1
    if i < end {
      // skip '.'
      i = i + 1
      if i == end {
        return Err(DnsError::InvalidIpAddress(s))
      }
    }
  }
  if part_idx != 4 {
    return Err(DnsError::InvalidIpAddress(s))
  }
  Ok(Ipv4Addr::{ a: parts[0], b: parts[1], c: parts[2], d: parts[3] })
}

///|
pub fn Ipv6Addr::parse(s : String) -> Result[Ipv6Addr, DnsError] {
  let n = s.length()
  if n < 2 || n > 45 {
    return Err(DnsError::InvalidIpAddress(s))
  }
  let head : Array[Int] = []
  let tail : Array[Int] = []
  let mut seen_double_colon = false
  let mut i = 0
  if s.code_unit_at(0) == 58 {
    if n < 2 || s.code_unit_at(1) != 58 {
      return Err(DnsError::InvalidIpAddress(s))
    }
    seen_double_colon = true
    i = 2
  }
  while i < n {
    let start = i
    // Check if this segment is an RFC 4291 §2.2(3) embedded IPv4 address (contains '.')
    let mut has_dot = false
    let mut scan = start
    while scan < n && s.code_unit_at(scan) != 58 {
      if s.code_unit_at(scan) == 46 {
        has_dot = true
        break
      }
      scan = scan + 1
    }
    if has_dot {
      // Must be preceded by ':' (not bare IPv4) and consume the entire remainder
      if start == 0 {
        return Err(DnsError::InvalidIpAddress(s))
      }
      let ip4 = match parse_ipv4_slice(s, start, n) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let s_hi = (ip4.a << 8) | ip4.b
      let s_lo = (ip4.c << 8) | ip4.d
      if seen_double_colon {
        tail.push(s_hi)
        tail.push(s_lo)
      } else {
        head.push(s_hi)
        head.push(s_lo)
      }
      i = n
      break
    }
    let mut seg = 0
    while i < n && s.code_unit_at(i) != 58 {
      let hv = hex_val(s.code_unit_at(i))
      if hv < 0 {
        return Err(DnsError::InvalidIpAddress(s))
      }
      seg = (seg << 4) | hv
      i = i + 1
      if i - start > 4 {
        return Err(DnsError::InvalidIpAddress(s))
      }
    }
    if i == start {
      return Err(DnsError::InvalidIpAddress(s))
    }
    if seen_double_colon {
      tail.push(seg)
    } else {
      head.push(seg)
    }
    if i < n {
      // s[i] == ':'
      i = i + 1
      if i == n {
        return Err(DnsError::InvalidIpAddress(s))
      }
      if s.code_unit_at(i) == 58 {
        if seen_double_colon {
          return Err(DnsError::InvalidIpAddress(s))
        }
        seen_double_colon = true
        i = i + 1
      }
    }
  }
  let segs : Array[Int] = [0, 0, 0, 0, 0, 0, 0, 0]
  if seen_double_colon {
    let total = head.length() + tail.length()
    if total >= 8 {
      return Err(DnsError::InvalidIpAddress(s))
    }
    let mut k = 0
    while k < head.length() {
      segs[k] = head[k]
      k = k + 1
    }
    let tail_start = 8 - tail.length()
    k = 0
    while k < tail.length() {
      segs[tail_start + k] = tail[k]
      k = k + 1
    }
  } else {
    if head.length() != 8 {
      return Err(DnsError::InvalidIpAddress(s))
    }
    let mut k = 0
    while k < 8 {
      segs[k] = head[k]
      k = k + 1
    }
  }
  Ok(
    Ipv6Addr::from_segments(
      segs[0],
      segs[1],
      segs[2],
      segs[3],
      segs[4],
      segs[5],
      segs[6],
      segs[7],
    ),
  )
}

///| RFC 5952 canonical IPv6 text representation (including §5 IPv4-mapped `::ffff:d.d.d.d`).
pub fn Ipv6Addr::to_string(self : Ipv6Addr) -> String {
  if self.hi == 0UL && ((self.lo >> 32) & 0xFFFFFFFFUL) == 0x0000FFFFUL {
    let a = ((self.lo >> 24) & 0xFFUL).to_int()
    let b = ((self.lo >> 16) & 0xFFUL).to_int()
    let c = ((self.lo >> 8) & 0xFFUL).to_int()
    let d = (self.lo & 0xFFUL).to_int()
    let sb = StringBuilder::new()
    sb.write_string("::ffff:")
    sb.write_string(a.to_string())
    sb.write_char('.')
    sb.write_string(b.to_string())
    sb.write_char('.')
    sb.write_string(c.to_string())
    sb.write_char('.')
    sb.write_string(d.to_string())
    return sb.to_string()
  }
  let segs : Array[Int] = [
    ((self.hi >> 48) & 0xFFFFUL).to_int(),
    ((self.hi >> 32) & 0xFFFFUL).to_int(),
    ((self.hi >> 16) & 0xFFFFUL).to_int(),
    (self.hi & 0xFFFFUL).to_int(),
    ((self.lo >> 48) & 0xFFFFUL).to_int(),
    ((self.lo >> 32) & 0xFFFFUL).to_int(),
    ((self.lo >> 16) & 0xFFFFUL).to_int(),
    (self.lo & 0xFFFFUL).to_int(),
  ]
  // Find longest run of >= 2 consecutive zero segments (leftmost wins ties)
  let mut best_start = -1
  let mut best_len = 1
  let mut cur_start = -1
  let mut cur_len = 0
  let mut i = 0
  while i < 8 {
    if segs[i] == 0 {
      if cur_start < 0 {
        cur_start = i
        cur_len = 1
      } else {
        cur_len = cur_len + 1
      }
      if cur_len > best_len {
        best_start = cur_start
        best_len = cur_len
      }
    } else {
      cur_start = -1
      cur_len = 0
    }
    i = i + 1
  }
  let sb = StringBuilder::new()
  i = 0
  while i < 8 {
    if i == best_start {
      sb.write_string("::")
      i = i + best_len
    } else {
      if i > 0 && i != best_start + best_len {
        sb.write_char(':')
      }
      append_hex_u16(sb, segs[i])
      i = i + 1
    }
  }
  sb.to_string()
}

///|
pub fn Ipv6Addr::to_bytes(self : Ipv6Addr) -> Bytes {
  let mut b = Bytes::new(16)
  b[0] = ((self.hi >> 56) & 0xFFUL).to_int().to_byte()
  b[1] = ((self.hi >> 48) & 0xFFUL).to_int().to_byte()
  b[2] = ((self.hi >> 40) & 0xFFUL).to_int().to_byte()
  b[3] = ((self.hi >> 32) & 0xFFUL).to_int().to_byte()
  b[4] = ((self.hi >> 24) & 0xFFUL).to_int().to_byte()
  b[5] = ((self.hi >> 16) & 0xFFUL).to_int().to_byte()
  b[6] = ((self.hi >> 8) & 0xFFUL).to_int().to_byte()
  b[7] = (self.hi & 0xFFUL).to_int().to_byte()
  b[8] = ((self.lo >> 56) & 0xFFUL).to_int().to_byte()
  b[9] = ((self.lo >> 48) & 0xFFUL).to_int().to_byte()
  b[10] = ((self.lo >> 40) & 0xFFUL).to_int().to_byte()
  b[11] = ((self.lo >> 32) & 0xFFUL).to_int().to_byte()
  b[12] = ((self.lo >> 24) & 0xFFUL).to_int().to_byte()
  b[13] = ((self.lo >> 16) & 0xFFUL).to_int().to_byte()
  b[14] = ((self.lo >> 8) & 0xFFUL).to_int().to_byte()
  b[15] = (self.lo & 0xFFUL).to_int().to_byte()
  b
}
