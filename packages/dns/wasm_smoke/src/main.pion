///| Wasm32 + Native smoke entry for the `dns` package.

import "dns"

///|
pub fn smoke() -> Int {
  let name = match dns::Name::parse("www.example.com.") {
    Ok(n) => n
    Err(_) => return 1
  }
  let q = dns::Message::query(0x1234, name, dns::type_a)
  let resp = dns::Message::response_for(q, dns::rcode_noerror)
  resp.answers.push(dns::ResourceRecord::{
    name: name,
    rtype: dns::type_a,
    rclass: dns::class_in,
    ttl: 300L,
    rdata: dns::RData::A(dns::Ipv4Addr::new(93, 184, 216, 34)),
  })
  resp.additionals.push(dns::ResourceRecord::opt(4096, 0, 0, true, [dns::EdnsOption::Padding(8)]))
  let wire = match dns::encode_message(resp) {
    Ok(b) => b
    Err(_) => return 2
  }
  match dns::decode_message(wire) {
    Ok(dec) => {
      if dec.header.id != 0x1234 || dec.answers.length() != 1 || dec.additionals.length() != 1 {
        return 3
      }
    }
    Err(_) => return 4
  }
  // Security smoke: self-pointer must be rejected without trapping
  let mut bad = Bytes::new(18)
  bad[5] = (1).to_byte()
  bad[12] = (0xC0).to_byte()
  bad[13] = (0x0C).to_byte()
  bad[15] = (1).to_byte()
  bad[17] = (1).to_byte()
  match dns::decode_message(bad) {
    Err(_) => 0
    Ok(_) => 5
  }
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
