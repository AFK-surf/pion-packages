///| Upstream `paupino/rust-decimal` compliance test suite (Red -> Green).

///|
fn unwrap_dec(r : Result[Decimal, DecimalError]) -> Decimal {
  match r {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "expected Ok(Decimal)")
      Decimal::zero()
    }
  }
}

///|
fn must_parse(s : String) -> Decimal {
  unwrap_dec(Decimal::from_str(s))
}

///|
fn is_err_dec(r : Result[Decimal, DecimalError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "constructors_and_boundaries" {
  let a = unwrap_dec(Decimal::new(-100L, 2U))
  debug_assert(a.is_sign_negative(), "new(-100, 2) negative")
  debug_assert(a.scale() == 2U, "new(-100, 2) scale")
  debug_assert(a.to_string() == "-1.00", "new(-100, 2) str")

  let i64_max = 9223372036854775807L
  let i64_min = -9223372036854775807L - 1L
  let b = unwrap_dec(Decimal::new(i64_max, 2U))
  debug_assert(!b.is_sign_negative(), "i64_max positive")
  debug_assert(b.scale() == 2U, "i64_max scale")
  debug_assert(b.to_string() == "92233720368547758.07", "i64_max str")

  let c = unwrap_dec(Decimal::new(i64_min, 2U))
  debug_assert(c.is_sign_negative(), "i64_min negative")
  debug_assert(c.scale() == 2U, "i64_min scale")
  debug_assert(c.to_string() == "-92233720368547758.08", "i64_min str")

  let d = Decimal::from_i64(-42L)
  debug_assert(d.to_string() == "-42", "from_i64")
  let e = Decimal::from_u64(18446744073709551615UL)
  debug_assert(e.to_string() == "18446744073709551615", "from_u64 max")
  let f = Decimal::from_int(12345)
  debug_assert(f.to_string() == "12345", "from_int")

  let pi = unwrap_dec(Decimal::from_parts(1102470952U, 185874565U, 1703060790U, false, 28U))
  debug_assert(pi.to_string() == "3.1415926535897932384626433832", "from_parts pi")
  debug_assert(pi.lo() == 1102470952U, "pi lo")
  debug_assert(pi.mid() == 185874565U, "pi mid")
  debug_assert(pi.hi() == 1703060790U, "pi hi")

  debug_assert(
    Decimal::max().to_string() == "79228162514264337593543950335",
    "Decimal::MAX",
  )
  debug_assert(
    Decimal::min().to_string() == "-79228162514264337593543950335",
    "Decimal::MIN",
  )
  debug_assert(Decimal::zero().is_zero(), "zero is_zero")
  debug_assert(Decimal::one().to_string() == "1", "one")
  debug_assert(Decimal::negative_one().to_string() == "-1", "negative_one")

  match Decimal::new(1L, 29U) {
    Err(DecimalError::ScaleExceedsMaximumPrecision(s)) => debug_assert(s == 29U, "scale 29")
    _ => debug_assert(false, "expected ScaleExceedsMaximumPrecision")
  }
  match Decimal::from_parts(1U, 0U, 0U, false, 29U) {
    Err(DecimalError::ScaleExceedsMaximumPrecision(s)) => debug_assert(s == 29U, "parts scale 29")
    _ => debug_assert(false, "expected ScaleExceedsMaximumPrecision from_parts")
  }
}

///|
test "parse_basic_and_significant" {
  let cases : Array[(String, String)] = [
    ("233", "233"),
    ("-233", "-233"),
    ("+233", "233"),
    ("233.323223", "233.323223"),
    ("-233.43343", "-233.43343"),
    (".000001", "0.000001"),
    ("-0.000001", "-0.000001"),
    ("79228162514264337593543950330", "79228162514264337593543950330"),
    ("79.228162514264337593543950330", "79.228162514264337593543950330"),
    ("1_000", "1000"),
    ("1_000_000", "1000000"),
    ("1_____________0", "10"),
    ("0.1_23_456", "0.123456"),
    ("1_234.56", "1234.56"),
    ("11.111111111111111111111111111", "11.111111111111111111111111111"),
    ("11.11111111111111111111111111111", "11.111111111111111111111111111"),
    ("11.1111111111111111111111111115", "11.111111111111111111111111112"),
    ("115.111111111111111111111111111", "115.11111111111111111111111111"),
    ("1115.11111111111111111111111111", "1115.1111111111111111111111111"),
    ("11.1111111111111111111111111195", "11.111111111111111111111111120"),
    ("99.9999999999999999999999999995", "100.00000000000000000000000000"),
    ("-11.1111111111111111111111111195", "-11.111111111111111111111111120"),
    ("-99.9999999999999999999999999995", "-100.00000000000000000000000000"),
    ("3.1415926535897932384626433832", "3.1415926535897932384626433832"),
    ("8808257419827262908.5944405087133154018", "8808257419827262908.594440509"),
    ("8097370036018690744.2590371109596744091", "8097370036018690744.259037111"),
    ("8097370036018690744.2590371149596744091", "8097370036018690744.259037115"),
    ("8097370036018690744.2590371159596744091", "8097370036018690744.259037116"),
    ("8_097_370_036_018_690_744.259_037_115_959_674_409_1", "8097370036018690744.259037116"),
    ("1.234567890123456789012345678949999", "1.2345678901234567890123456789"),
    (".00000000000000000000000000001", "0.0000000000000000000000000000"),
    (".10000000000000000000000000000", "0.1000000000000000000000000000"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (inp, exp) = cases[i]
    let got = must_parse(inp).to_string()
    debug_assert(got == exp, "parse mismatch for " + inp + ": got " + got + ", exp " + exp)
    i = i + 1
  }

  let sci_cases : Array[(String, String)] = [
    ("1.23e4", "12300"),
    ("6.7e-1", "0.67"),
    ("1E2", "100"),
    ("-2.5E-3", "-0.0025"),
    ("5e0", "5"),
  ]
  i = 0
  while i < sci_cases.length() {
    let (inp, exp) = sci_cases[i]
    debug_assert(is_err_dec(Decimal::from_str(inp)), "from_str must reject scientific " + inp)
    let got = unwrap_dec(Decimal::from_scientific(inp)).to_string()
    debug_assert(got == exp, "from_scientific mismatch for " + inp + ": got " + got + ", exp " + exp)
    i = i + 1
  }
}

///|
test "parse_exact_and_scientific_and_radix" {
  let ok1 = unwrap_dec(Decimal::from_str_exact("11.111111111111111111111111111"))
  debug_assert(ok1.to_string() == "11.111111111111111111111111111", "exact ok1")
  let ok2 = unwrap_dec(Decimal::from_str_exact("0.1234567890123456789012345678_"))
  debug_assert(ok2.to_string() == "0.1234567890123456789012345678", "exact trailing _")

  let underflow_cases : Array[String] = [
    "11.11111111111111111111111111111",
    "11.1111111111111111111111111115",
    "99.9999999999999999999999999995",
    ".00000000000000000000000000001",
    "0.1234567890123456789012345678_9",
    "0.12345678901234567890123456780",
  ]
  let mut i = 0
  while i < underflow_cases.length() {
    match Decimal::from_str_exact(underflow_cases[i]) {
      Err(DecimalError::Underflow) => ()
      _ => debug_assert(false, "expected Underflow for " + underflow_cases[i])
    }
    i = i + 1
  }

  let sci_exact : Array[(String, String)] = [
    ("9.7e-7", "0.00000097"),
    ("9e-7", "0.0000009"),
    ("1.2e10", "12000000000"),
    ("1.2e+10", "12000000000"),
    ("12e10", "120000000000"),
    ("9.7E-7", "0.00000097"),
    ("1.2345E-24", "0.0000000000000000000000012345"),
    ("12345E-28", "0.0000000000000000000000012345"),
    ("1.2345E0", "1.2345"),
    ("1E28", "10000000000000000000000000000"),
  ]
  i = 0
  while i < sci_exact.length() {
    let (inp, exp) = sci_exact[i]
    let d = unwrap_dec(Decimal::from_scientific(inp))
    debug_assert(d.to_string() == exp, "sci_exact " + inp)
    i = i + 1
  }

  match Decimal::from_scientific("1.2345E-28") {
    Err(DecimalError::ScaleExceedsMaximumPrecision(s)) => debug_assert(s == 32U, "sci scale 32")
    _ => debug_assert(false, "expected ScaleExceedsMaximumPrecision(32)")
  }
  match Decimal::from_scientific("12345E29") {
    Err(DecimalError::ScaleExceedsMaximumPrecision(s)) => debug_assert(s == 29U, "sci scale 29")
    _ => debug_assert(false, "expected ScaleExceedsMaximumPrecision(29)")
  }
  match Decimal::from_scientific("12345E28") {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "expected Overflow for 12345E28")
  }

  let l1 = unwrap_dec(Decimal::from_scientific_lossy("1.2345E-28"))
  debug_assert(l1.to_string() == "0.0000000000000000000000000001", "sci_lossy 1.2345E-28")
  let l2 = unwrap_dec(Decimal::from_scientific_lossy("8.7654E-28"))
  debug_assert(l2.to_string() == "0.0000000000000000000000000009", "sci_lossy 8.7654E-28")
  let l3 = unwrap_dec(Decimal::from_scientific_lossy("2.5e-28"))
  debug_assert(l3.to_string() == "0.0000000000000000000000000003", "sci_lossy 2.5e-28")
  let l4 = unwrap_dec(Decimal::from_scientific_lossy("-2.5e-28"))
  debug_assert(l4.to_string() == "-0.0000000000000000000000000003", "sci_lossy -2.5e-28")

  debug_assert(unwrap_dec(Decimal::from_str_radix("123", 8U)).to_string() == "83", "radix 8")
  debug_assert(unwrap_dec(Decimal::from_str_radix("abc", 16U)).to_string() == "2748", "radix 16")
  debug_assert(unwrap_dec(Decimal::from_str_radix("101", 2U)).to_string() == "5", "radix 2")
  debug_assert(is_err_dec(Decimal::from_str_radix("78", 8U)), "radix 8 invalid")
  debug_assert(is_err_dec(Decimal::from_str_radix("1", 1U)), "radix 1 invalid")
  debug_assert(is_err_dec(Decimal::from_str_radix("1", 37U)), "radix 37 invalid")
}

///|
test "normalize_rescale_and_serialize" {
  let norm_cases : Array[(String, String)] = [
    ("1.00000000000000000000", "1"),
    ("1.10000000000000000000000", "1.1"),
    ("1.00010000000000000000000", "1.0001"),
    ("1", "1"),
    ("1.1", "1.1"),
    ("1.0001", "1.0001"),
    ("-0", "0"),
    ("-0.0", "0"),
    ("-0.010", "-0.01"),
    ("0.0", "0"),
  ]
  let mut i = 0
  while i < norm_cases.length() {
    let (inp, exp) = norm_cases[i]
    let d = must_parse(inp).normalize()
    debug_assert(d.to_string() == exp, "normalize " + inp)
    i = i + 1
  }

  let rs1 = must_parse("0.123456").rescale(12U)
  debug_assert(rs1.to_string() == "0.123456000000" && rs1.scale() == 12U, "rescale up")
  let rs2 = must_parse("0.12345600000").rescale(6U)
  debug_assert(rs2.to_string() == "0.123456" && rs2.scale() == 6U, "rescale down")
  let rs3 = must_parse("11.76470588235294").rescale(28U)
  debug_assert(rs3.scale() == 27U && rs3.to_string() == "11.764705882352940000000000000", "rescale cap")

  let ser_cases : Array[String] = [
    "12.3456789",
    "5233.9008808150288439427720175",
    "-5233.9008808150288439427720175",
    "79228162514264337593543950335",
    "-79228162514264337593543950335",
  ]
  i = 0
  while i < ser_cases.length() {
    let a = must_parse(ser_cases[i])
    let bytes = a.serialize()
    let b = unwrap_dec(Decimal::deserialize(bytes))
    debug_assert(b.to_string() == ser_cases[i], "serde " + ser_cases[i])
    i = i + 1
  }
}

///|
test "comparison_equality_and_sort" {
  let nz = must_parse("-0.0")
  let pz = must_parse("0.0")
  let z = Decimal::zero()
  debug_assert(nz.eq(pz), "-0.0 == 0.0")
  debug_assert(nz.eq(z), "-0.0 == 0")
  debug_assert(nz.compare(pz) == 0, "compare(-0.0, 0.0) == 0")

  debug_assert(must_parse("1.0").eq(must_parse("1.00")), "1.0 == 1.00")
  debug_assert(must_parse("1.00000000000000000000").eq(must_parse("1")), "1.0... == 1")
  debug_assert(must_parse("-0.5").lt(must_parse("-0.01")), "-0.5 < -0.01")
  debug_assert(must_parse("0.5").gt(must_parse("0.01")), "0.5 > 0.01")
  debug_assert(
    must_parse("11.815126050420168067226890757").gt(must_parse("0.6386554621848739495798319328")),
    "big cross-scale gt",
  )
  debug_assert(Decimal::min().lt(Decimal::max()), "MIN < MAX")

  let arr : Array[Decimal] = [
    must_parse("10.5"),
    must_parse("-3.25"),
    must_parse("0.00"),
    must_parse("10.50"),
    must_parse("-100"),
    must_parse("0.0001"),
  ]
  Decimal::sort(arr)
  debug_assert(arr[0].to_string() == "-100", "sort[0]")
  debug_assert(arr[1].to_string() == "-3.25", "sort[1]")
  debug_assert(arr[2].eq(Decimal::zero()), "sort[2]")
  debug_assert(arr[3].to_string() == "0.0001", "sort[3]")
  debug_assert(arr[4].eq(must_parse("10.5")), "sort[4]")
  debug_assert(arr[5].eq(must_parse("10.5")), "sort[5]")
}

///|
test "arithmetic_add_sub_mul_div_rem" {
  let add_cases : Array[(String, String, String)] = [
    ("0", "0", "0"),
    ("0", "-0", "0"),
    ("-0", "0", "0"),
    ("2", "3", "5"),
    ("2454495034", "3451204593", "5905699627"),
    ("24544.95034", ".3451204593", "24545.2954604593"),
    (".1", ".1", "0.2"),
    (".10", ".1", "0.20"),
    (".1", "-.1", "0.0"),
    ("0", "1.001", "1.001"),
    ("2", "-3", "-1"),
    ("-2", "3", "1"),
    ("-2", "-3", "-5"),
    ("1.234", "2.4567", "3.6907"),
    (
      "11.815126050420168067226890757",
      "0.6386554621848739495798319328",
      "12.453781512605042016806722690",
    ),
    (
      "-11.815126050420168067226890757",
      "0.6386554621848739495798319328",
      "-11.176470588235294117647058824",
    ),
    (
      "11815126050420168067226890757",
      "0.4386554621848739495798319328",
      "11815126050420168067226890757",
    ),
    ("0.0872727272727272727272727272", "843.65000000", "843.7372727272727272727272727"),
    ("7314.6229858868828353570724702", "1000", "8314.622985886882835357072470"),
    (
      "8097370036018690744.2590371109596744091",
      "3807285637671831400.15346897797550749555",
      "11904655673690522144.412506089",
    ),
  ]
  let mut i = 0
  while i < add_cases.length() {
    let (a, b, exp) = add_cases[i]
    let da = must_parse(a)
    let db = must_parse(b)
    let r1 = unwrap_dec(da.checked_add(db)).to_string()
    let r2 = unwrap_dec(db.checked_add(da)).to_string()
    debug_assert(r1 == exp, "add " + a + " + " + b + " = " + r1 + " != " + exp)
    debug_assert(r2 == exp, "add comm " + b + " + " + a + " = " + r2 + " != " + exp)
    i = i + 1
  }

  let sub_cases : Array[(String, String, String)] = [
    ("2", "3", "-1"),
    ("3451204593", "2323322332", "1127882261"),
    ("24544.95034", ".3451204593", "24544.6052195407"),
    (".1", ".1", "0.0"),
    (".1", "-.1", "0.2"),
    ("844.13000000", "843.65000000", "0.48000000"),
    ("79228162514264337593543950335", "79228162514264337593543950335", "0"),
    ("79228162514264337593543950335", "79228162514264337593543950333", "2"),
    ("4951760157141521099596496896", "1", "4951760157141521099596496895"),
    ("79228162514264337593543950334", "79228162514264337593543950335", "-1"),
    ("18446744073709551615", "-18446744073709551615", "36893488147419103230"),
  ]
  i = 0
  while i < sub_cases.length() {
    let (a, b, exp) = sub_cases[i]
    let r = unwrap_dec(must_parse(a).checked_sub(must_parse(b))).to_string()
    debug_assert(r == exp, "sub " + a + " - " + b + " = " + r + " != " + exp)
    i = i + 1
  }

  let mul_cases : Array[(String, String, String)] = [
    ("2", "3", "6"),
    ("2454495034", "3451204593", "8470964534836491162"),
    ("24544.95034", ".3451204593", "8470.964534836491162"),
    (".1", ".1", "0.01"),
    ("0", "1.001", "0"),
    ("2", "-3", "-6"),
    ("-2", "-3", "6"),
    ("1.0", "2.01", "2.010"),
    ("0.00000000000000001", "0.00000000000000001", "0.0000000000000000000000000000"),
    ("0.0000000000000000000000000001", "0.0000000000000000000000000001", "0"),
    (
      "0.6386554621848739495798319328",
      "11.815126050420168067226890757",
      "7.5457947885036367488171739292",
    ),
    (
      "2123456789012345678901234567.8",
      "11.815126050420168067226890757",
      "25088909624801327937270048761",
    ),
    (
      "2.1234567890123456789012345678",
      "2.1234567890123456789012345678",
      "4.5090687348026215523554336227",
    ),
    ("0.48000000", "0.1818181818181818181818181818", "0.0872727272727272727272727273"),
  ]
  i = 0
  while i < mul_cases.length() {
    let (a, b, exp) = mul_cases[i]
    let da = must_parse(a)
    let db = must_parse(b)
    let r1 = unwrap_dec(da.checked_mul(db)).to_string()
    let r2 = unwrap_dec(db.checked_mul(da)).to_string()
    debug_assert(r1 == exp, "mul " + a + " * " + b + " = " + r1 + " != " + exp)
    debug_assert(r2 == exp, "mul comm " + b + " * " + a + " = " + r2 + " != " + exp)
    i = i + 1
  }

  // No negative zero from wide mul underflow
  let wz = unwrap_dec(
    unwrap_dec(Decimal::new(-5000000000L, 20U)).checked_mul(unwrap_dec(Decimal::new(1L, 20U))),
  )
  debug_assert(!wz.is_sign_negative() && wz.is_zero(), "wide mul no -0")

  let div_cases : Array[(String, String, String)] = [
    ("6", "3", "2"),
    ("10", "2", "5"),
    ("2.2", "1.1", "2"),
    ("-2.2", "-1.1", "2"),
    ("12.88", "5.6", "2.3"),
    ("1023427554493", "43432632", "23563.562864276795382789603909"),
    ("10000", "3", "3333.3333333333333333333333333"),
    ("2", "3", "0.6666666666666666666666666667"),
    ("1", "3", "0.3333333333333333333333333333"),
    ("-2", "3", "-0.6666666666666666666666666667"),
    ("2", "-3", "-0.6666666666666666666666666667"),
    ("-2", "-3", "0.6666666666666666666666666667"),
    ("1234.5678", "0.1234567890123456", "9999.99926999999982999953127"),
    ("1234.567890123456789012345678", "1.234567890123456789012345678", "1000"),
    ("32.91625929004387114334488", "3.27629537", "10.046792359274942644546996384"),
    ("5000", "1000.26957490549", "4.9986524887277738570721416846"),
    ("6142.6941216127122745222131114", "2", "3071.3470608063561372611065557"),
    ("3071.3470608063561372611065557", "1228.87000756", "2.4993262443638869285360708423"),
    ("590.3274854004009467754255123", "53.68997202826239", "10.995116277759516850521689988"),
  ]
  i = 0
  while i < div_cases.length() {
    let (a, b, exp) = div_cases[i]
    let r = unwrap_dec(must_parse(a).checked_div(must_parse(b))).to_string()
    debug_assert(r == exp, "div " + a + " / " + b + " = " + r + " != " + exp)
    i = i + 1
  }

  let rem_cases : Array[(String, String, String)] = [
    ("2", "3", "2"),
    ("-2", "3", "-2"),
    ("2", "-3", "2"),
    ("-2", "-3", "-2"),
    ("6", "3", "0"),
    ("42.2", "11.9", "6.5"),
    ("2.1", "3", "2.1"),
    ("2", "3.1", "2"),
    ("2.0", "3.1", "2.0"),
    ("4", "3.1", "0.9"),
    ("2", "2", "0"),
    ("-2", "2", "0"),
    ("-2", "-2", "0"),
  ]
  i = 0
  while i < rem_cases.length() {
    let (a, b, exp) = rem_cases[i]
    let r = unwrap_dec(must_parse(a).checked_rem(must_parse(b))).to_string()
    debug_assert(r == exp, "rem " + a + " % " + b + " = " + r + " != " + exp)
    i = i + 1
  }
}

///|
test "rounding_all_7_strategies" {
  let cases : Array[(String, RoundingStrategy, String)] = [
    ("3.5", RoundingStrategy::MidpointAwayFromZero, "4"),
    ("2.8", RoundingStrategy::MidpointAwayFromZero, "3"),
    ("2.5", RoundingStrategy::MidpointAwayFromZero, "3"),
    ("2.1", RoundingStrategy::MidpointAwayFromZero, "2"),
    ("-2.1", RoundingStrategy::MidpointAwayFromZero, "-2"),
    ("-2.5", RoundingStrategy::MidpointAwayFromZero, "-3"),
    ("-2.8", RoundingStrategy::MidpointAwayFromZero, "-3"),
    ("-3.5", RoundingStrategy::MidpointAwayFromZero, "-4"),
    ("3.5", RoundingStrategy::MidpointNearestEven, "4"),
    ("2.8", RoundingStrategy::MidpointNearestEven, "3"),
    ("2.5", RoundingStrategy::MidpointNearestEven, "2"),
    ("2.1", RoundingStrategy::MidpointNearestEven, "2"),
    ("-2.1", RoundingStrategy::MidpointNearestEven, "-2"),
    ("-2.5", RoundingStrategy::MidpointNearestEven, "-2"),
    ("-2.8", RoundingStrategy::MidpointNearestEven, "-3"),
    ("-3.5", RoundingStrategy::MidpointNearestEven, "-4"),
    ("3.5", RoundingStrategy::MidpointTowardZero, "3"),
    ("2.8", RoundingStrategy::MidpointTowardZero, "3"),
    ("2.5", RoundingStrategy::MidpointTowardZero, "2"),
    ("2.1", RoundingStrategy::MidpointTowardZero, "2"),
    ("-2.1", RoundingStrategy::MidpointTowardZero, "-2"),
    ("-2.5", RoundingStrategy::MidpointTowardZero, "-2"),
    ("-2.8", RoundingStrategy::MidpointTowardZero, "-3"),
    ("-3.5", RoundingStrategy::MidpointTowardZero, "-3"),
    ("2.8", RoundingStrategy::ToNegativeInfinity, "2"),
    ("2.5", RoundingStrategy::ToNegativeInfinity, "2"),
    ("2.1", RoundingStrategy::ToNegativeInfinity, "2"),
    ("-2.1", RoundingStrategy::ToNegativeInfinity, "-3"),
    ("-2.5", RoundingStrategy::ToNegativeInfinity, "-3"),
    ("-2.8", RoundingStrategy::ToNegativeInfinity, "-3"),
    ("2.8", RoundingStrategy::ToPositiveInfinity, "3"),
    ("2.5", RoundingStrategy::ToPositiveInfinity, "3"),
    ("2.1", RoundingStrategy::ToPositiveInfinity, "3"),
    ("-2.1", RoundingStrategy::ToPositiveInfinity, "-2"),
    ("-2.5", RoundingStrategy::ToPositiveInfinity, "-2"),
    ("-2.8", RoundingStrategy::ToPositiveInfinity, "-2"),
    ("2.8", RoundingStrategy::ToZero, "2"),
    ("2.5", RoundingStrategy::ToZero, "2"),
    ("2.1", RoundingStrategy::ToZero, "2"),
    ("-2.1", RoundingStrategy::ToZero, "-2"),
    ("-2.5", RoundingStrategy::ToZero, "-2"),
    ("-2.8", RoundingStrategy::ToZero, "-2"),
    ("2.8", RoundingStrategy::AwayFromZero, "3"),
    ("2.5", RoundingStrategy::AwayFromZero, "3"),
    ("2.1", RoundingStrategy::AwayFromZero, "3"),
    ("-2.1", RoundingStrategy::AwayFromZero, "-3"),
    ("-2.5", RoundingStrategy::AwayFromZero, "-3"),
    ("-2.8", RoundingStrategy::AwayFromZero, "-3"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (inp, strat, exp) = cases[i]
    let got = must_parse(inp).round_dp_with_strategy(0U, strat).to_string()
    debug_assert(got == exp, "round0 " + inp + " got " + got + " exp " + exp)
    i = i + 1
  }

  // Banker's rounding at various dp
  debug_assert(must_parse("6.12345").round_dp(2U).to_string() == "6.12", "banker 6.12345")
  debug_assert(must_parse("6.126").round_dp(2U).to_string() == "6.13", "banker 6.126")
  debug_assert(must_parse("-6.126").round_dp(2U).to_string() == "-6.13", "banker -6.126")
  debug_assert(must_parse("1.2250").round_dp(2U).to_string() == "1.22", "banker 1.2250")
  debug_assert(must_parse("1.2251").round_dp(2U).to_string() == "1.23", "banker 1.2251")
  debug_assert(must_parse("6.1").round_dp(2U).to_string() == "6.1", "banker 6.1 dp 2")
  debug_assert(must_parse("0.0000").round_dp(2U).to_string() == "0.00", "banker 0.0000 dp 2")
  debug_assert(
    must_parse("2.1234567890123456789012345678").round_dp(27U).to_string() == "2.123456789012345678901234568",
    "banker dp 27",
  )

  // Issue #71: 0.19 / (0.19 + 1) rounded to 2dp -> 0.16
  let rate = unwrap_dec(Decimal::new(19L, 2U))
  let denom = unwrap_dec(rate.checked_add(Decimal::one()))
  let part = unwrap_dec(rate.checked_div(denom))
  debug_assert(part.round_dp(2U).to_string() == "0.16", "issue 71")
}

///|
test "math_abs_floor_ceil_trunc_fract_powi_sqrt" {
  debug_assert(must_parse("-3.141").abs().to_string() == "3.141", "abs neg")
  debug_assert(must_parse("3.141").abs().to_string() == "3.141", "abs pos")
  debug_assert(must_parse("3.141").neg().to_string() == "-3.141", "neg pos")
  debug_assert(must_parse("-3.141").neg().to_string() == "3.141", "neg neg")

  debug_assert(must_parse("3.641").floor().to_string() == "3", "floor pos")
  debug_assert(must_parse("-3.641").floor().to_string() == "-4", "floor neg")
  debug_assert(must_parse("-3.00").floor().to_string() == "-3", "floor neg exact")
  debug_assert(must_parse("3.141").ceil().to_string() == "4", "ceil pos")
  debug_assert(must_parse("3.00").ceil().to_string() == "3", "ceil pos exact")
  debug_assert(must_parse("-3.141").ceil().to_string() == "-3", "ceil neg")

  debug_assert(must_parse("1.9").trunc().to_string() == "1", "trunc pos")
  debug_assert(must_parse("-1.9").trunc().to_string() == "-1", "trunc neg")
  debug_assert(must_parse("3.141592").trunc_with_scale(2U).to_string() == "3.14", "trunc_with_scale")
  debug_assert(must_parse("-1.98765").trunc_with_scale(1U).to_string() == "-1.9", "trunc_with_scale neg")

  debug_assert(must_parse("3.141").fract().to_string() == "0.141", "fract pos")
  debug_assert(must_parse("-3.141").fract().to_string() == "-0.141", "fract neg")

  // powi
  let pow_cases : Array[(String, Int64, String)] = [
    ("0", 0L, "1"),
    ("1", 0L, "1"),
    ("0", 1L, "0"),
    ("2", 3L, "8"),
    ("-2", 3L, "-8"),
    ("2", -3L, "0.125"),
    ("-2", -3L, "-0.125"),
    ("3", -3L, "0.037037037037037037037037037"),
    ("6", 3L, "216"),
    ("0.5", 2L, "0.25"),
    ("0.5", -2L, "4"),
    ("0.2", -40L, "10000000000000000000000000000"),
    ("-0.2", -3L, "-125"),
  ]
  let mut i = 0
  while i < pow_cases.length() {
    let (base, exp, expected) = pow_cases[i]
    let got = unwrap_dec(must_parse(base).powi(exp)).to_string()
    debug_assert(got == expected, "powi " + base + "^" + exp.to_string() + " = " + got + " != " + expected)
    i = i + 1
  }
  match must_parse("1000000000000000").checked_powi(-2L) {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "1000000000000000^-2 must return Err(Overflow)")
  }

  // sqrt
  let sqrt_cases : Array[(String, String)] = [
    ("0", "0"),
    ("4", "2"),
    ("3.222", "1.7949930361981909371487724124"),
    ("199.45", "14.122676800097069416754994263"),
    ("342.4", "18.504053609952604112132102540"),
    ("2", "1.4142135623730950488016887242"),
    ("0.0000000000000000000000000001", "0.0000000000000100000000000000"),
  ]
  i = 0
  while i < sqrt_cases.length() {
    let (inp, exp) = sqrt_cases[i]
    match must_parse(inp).sqrt() {
      Some(s) => debug_assert(s.eq(must_parse(exp)), "sqrt " + inp + " got " + s.to_string())
      None => debug_assert(false, "sqrt returned None for " + inp)
    }
    i = i + 1
  }
  match must_parse("-2").sqrt() {
    None => ()
    Some(_) => debug_assert(false, "sqrt(-2) must be None")
  }
}
