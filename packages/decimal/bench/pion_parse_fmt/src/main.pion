///| Bench 1 (Parse + Format): 50,000 mixed decimal strings x 10 rounds = 500,000 parse + 500,000 fmt ops.

import "decimal"

///|
fn fnv1a_str(h_in : UInt64, s : String) -> UInt64 {
  let mut h = h_in
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ s.code_unit_at(i).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn split_lines(content : String) -> Array[String] {
  let lines : Array[String] = []
  let n = content.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if content.code_unit_at(i) == 10 {
      if i > start {
        let len = i - start
        let b = Bytes::new(len)
        let mut j = 0
        while j < len {
          b[j] = content.code_unit_at(start + j).to_byte()
          j = j + 1
        }
        lines.push(b.to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  lines
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-decimal-bench/decimals_50k.txt"
  }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let lines = split_lines(content)
  let n = lines.length()
  let mut hash : UInt64 = 14695981039346656037UL
  let mut total_ops : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut first_out = ""
  let mut last_out = ""

  let mut round = 0
  while round < 10 {
    let mut i = 0
    while i < n {
      let d = match decimal::Decimal::from_str(lines[i]) {
        Ok(v) => v
        Err(_) => {
          io_println(world, "error: parse failed")
          return 2
        }
      }
      let out = d.to_string()
      hash = fnv1a_str(hash, out)
      total_bytes = total_bytes + out.length().to_int64()
      total_ops = total_ops + 1L
      if round == 0 && i == 0 {
        first_out = out
      }
      if round == 9 && i == n - 1 {
        last_out = out
      }
      i = i + 1
    }
    round = round + 1
  }

  io_println(world, "ops=" + total_ops.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "first=" + first_out)
  io_println(world, "last=" + last_out)
  io_println(world, "fnv1a=" + hash.to_string())
  0
}
