///| Bench 3 (Sort + Aggregate + Banker's Rounding): 50,000 mixed-scale decimals x 10 rounds = 500,000 ops.

import "decimal"

///|
fn split_lines(content : String) -> Array[String] {
  let lines : Array[String] = []
  let n = content.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if content.code_unit_at(i) == 10 {
      if i > start {
        let len = i - start
        let b = Bytes::new(len)
        let mut j = 0
        while j < len {
          b[j] = content.code_unit_at(start + j).to_byte()
          j = j + 1
        }
        lines.push(b.to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  lines
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-decimal-bench/decimals_50k.txt"
  }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let lines = split_lines(content)
  let n = lines.length()
  let base : Array[decimal::Decimal] = []
  let mut i = 0
  while i < n {
    match decimal::Decimal::from_str(lines[i]) {
      Ok(d) => base.push(d)
      Err(_) => return 2
    }
    i = i + 1
  }

  let work : Array[decimal::Decimal] = []
  i = 0
  while i < n {
    work.push(base[i])
    i = i + 1
  }

  let mut checksum : UInt64 = 14695981039346656037UL
  let mut last_sum = decimal::Decimal::zero()
  let mut last_min = decimal::Decimal::zero()
  let mut last_med = decimal::Decimal::zero()
  let mut last_max = decimal::Decimal::zero()

  let mut round = 0
  while round < 10 {
    // Copy unsorted base into work
    i = 0
    while i < n {
      work[i] = base[i]
      i = i + 1
    }
    decimal::Decimal::sort(work)
    let mut sum = decimal::Decimal::zero()
    i = 0
    while i < n {
      let r = work[i].round_dp(2U)
      sum = match sum.checked_add(r) {
        Ok(v) => v
        Err(_) => return 3
      }
      checksum = (checksum ^ r.lo64) * 1099511628211UL
      i = i + 1
    }
    last_sum = sum
    last_min = work[0]
    last_med = work[n / 2]
    last_max = work[n - 1]
    round = round + 1
  }

  io_println(world, "ops=" + (n * 10).to_string())
  io_println(world, "min=" + last_min.to_string())
  io_println(world, "median=" + last_med.to_string())
  io_println(world, "max=" + last_max.to_string())
  io_println(world, "sum_rounded=" + last_sum.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
