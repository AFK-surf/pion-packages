///| Bench 2 (Billing Arithmetic Stream): 400,000 transactions x 5 ops = 2,000,000 ops
///| (mul, add, sub, div, round_dp) using public idiomatic `Decimal` API.

import "decimal"

///|
fn unwrap_d(r : Result[decimal::Decimal, decimal::DecimalError]) -> decimal::Decimal {
  match r {
    Ok(d) => d
    Err(_) => decimal::Decimal::zero()
  }
}

///|
pub fn main(world : World) -> Int {
  let n = 400000
  let tax_rate = unwrap_d(decimal::Decimal::new(825L, 4U)) // 0.0825
  let mut grand_total = decimal::Decimal::zero()
  let mut last_rounded = decimal::Decimal::zero()
  let mut checksum : UInt64 = 14695981039346656037UL

  let mut i = 0
  while i < n {
    let ii = i.to_int64()
    let price_cents = (ii * 7919L + 1003L) % 500000L + 100L
    let qty_val = (ii * 17L + 1L) % 25L + 1L
    let disc_cents = ii * 31L % 500L

    let price = unwrap_d(decimal::Decimal::new(price_cents, 2U))
    let qty = decimal::Decimal::from_i64(qty_val)
    let discount = unwrap_d(decimal::Decimal::new(disc_cents, 2U))

    // 5 core decimal ops per transaction: mul, add, sub, div, round_dp
    let subtotal = unwrap_d(price.checked_mul(qty))
    let tax = unwrap_d(subtotal.checked_mul(tax_rate))
    let gross = unwrap_d(subtotal.checked_add(tax))
    let net = unwrap_d(gross.checked_sub(discount))
    let unit = unwrap_d(net.checked_div(qty))
    let rounded = unit.round_dp(2U)

    grand_total = unwrap_d(grand_total.checked_add(rounded))
    checksum = (checksum ^ rounded.lo64) * 1099511628211UL
    last_rounded = rounded
    i = i + 1
  }

  io_println(world, "tx=" + n.to_string())
  io_println(world, "ops=" + (n * 5).to_string())
  io_println(world, "grand_total=" + grand_total.to_string())
  io_println(world, "last_rounded=" + last_rounded.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}
