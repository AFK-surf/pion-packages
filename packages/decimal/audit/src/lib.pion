///| Red-team audit helpers for packages/decimal (no production code; see ../REPORT.md).

import "decimal"

///| Parse a literal that must be valid (exact parser: no rounding, no scientific notation).
pub fn d(s : String) -> decimal::Decimal {
  match decimal::Decimal::from_str_exact(s) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "audit helper could not parse " + s)
      decimal::Decimal::zero()
    }
  }
}

///| `Ok(x).to_string()`, or `"ERR"` / `"NONE"` markers for failures.
pub fn rs(r : Result[decimal::Decimal, decimal::DecimalError]) -> String {
  match r {
    Ok(v) => v.to_string()
    Err(_) => "ERR"
  }
}

///|
pub fn os(r : Option[decimal::Decimal]) -> String {
  match r {
    Some(v) => v.to_string()
    None => "NONE"
  }
}

///| 16-byte rust_decimal wire form `[flags, lo, mid, hi]` (little endian) from raw words.
pub fn wire(flags : UInt, lo : UInt, mid : UInt, hi : UInt) -> Bytes {
  let b = Bytes::new(16)
  let w : FixedArray[UInt] = [flags, lo, mid, hi]
  let mut i = 0
  while i < 16 {
    b[i] = ((w[i / 4] >> ((i % 4) * 8)) & 0xFFU).to_int().to_byte()
    i = i + 1
  }
  b
}
