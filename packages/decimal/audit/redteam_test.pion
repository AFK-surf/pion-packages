///| Red-team regression tests for packages/decimal @ 9128ea9 (branch feat/pkg-decimal).
///
/// Every `redteam_*` test asserts the behaviour of the reference implementation `rust_decimal =1.37.2`
/// (each expected value below was produced by ../oracle, see REPORT.md) — a FAILURE here is the
/// evidence, and the test turns green once Pion matches. `control_*` tests are attacks Pion survives
/// (bit-identical to rust_decimal); they must keep passing.
/// The quadratic `Decimal::sort` DoS (F-1) cannot live in a unit test that must finish quickly:
/// it is reproduced by ../run_audit.sh (section 5).

import "decimal"

///|
fn eq_str(got : String, want : String, what : String) -> Unit {
  debug_assert(got == want, what + ": rust_decimal=" + want + " pion=" + got)
}

// ---------------------------------------------------------------------------
// F-2 (P1) Rounding a negative value to zero leaks a negative zero: "-0.00" / "-0".
// rust_decimal clears the sign whenever round_dp* produces a zero mantissa.
// ---------------------------------------------------------------------------

///|
test "redteam_round_dp_to_zero_has_no_minus_sign" {
  let r = d("-0.004").round_dp(2U)
  eq_str(r.to_string(), "0.00", "(-0.004).round_dp(2)")
  debug_assert(!r.is_sign_negative(), "(-0.004).round_dp(2) must not be sign-negative")
  eq_str(d("-0.1").round().to_string(), "0", "(-0.1).round()")
  eq_str(
    d("-0.5").round_dp_with_strategy(0U, decimal::RoundingStrategy::MidpointNearestEven).to_string(),
    "0",
    "(-0.5).round_dp_with_strategy(0, MidpointNearestEven)",
  )
  eq_str(
    d("-0.004").round_dp_with_strategy(2U, decimal::RoundingStrategy::ToPositiveInfinity).to_string(),
    "0.00",
    "(-0.004).round_dp_with_strategy(2, ToPositiveInfinity)",
  )
}

// ---------------------------------------------------------------------------
// F-2 (P1) Parsing "-0..." keeps the sign bit: to_string() prints "-0.00" and serialize() emits
// flags 0x80020000, while rust_decimal yields +0 (flags 0x00020000).
// ---------------------------------------------------------------------------

///|
test "redteam_parse_negative_zero_is_positive_zero" {
  match decimal::Decimal::from_str("-0.00") {
    Ok(v) => {
      eq_str(v.to_string(), "0.00", "from_str(\"-0.00\")")
      debug_assert(v.serialize()[3].to_int() == 0, "from_str(\"-0.00\").serialize() sign byte must be 0x00")
    }
    Err(_) => debug_assert(false, "from_str(\"-0.00\") must parse")
  }
  eq_str(rs(decimal::Decimal::from_str_exact("-0")), "0", "from_str_exact(\"-0\")")
  eq_str(rs(decimal::Decimal::from_scientific("-0e0")), "0", "from_scientific(\"-0e0\")")
  eq_str(rs(decimal::Decimal::from_str_radix("-0", 8U)), "0", "from_str_radix(\"-0\", 8)")
}

// ---------------------------------------------------------------------------
// F-3 (P1) checked_div keeps a different scale than rust_decimal: `unscale_96` is shared with
// normalize() and strips every trailing zero (`while` + low-byte test), whereas rust_decimal's
// div::unscale only strips 10^8 while lo == 0 and then 10^4/10^2/10^1 once each.
// Same value, different to_string()/serialize() bytes on ~5% of edge divisions.
// ---------------------------------------------------------------------------

///|
test "redteam_div_result_scale_matches_rust" {
  eq_str(rs(d("1").checked_div(d("5"))), "0.20", "1 / 5")
  eq_str(rs(d("1").checked_div(d("0.5"))), "2.0", "1 / 0.5")
  eq_str(rs(d("10").checked_div(d("4"))), "2.50", "10 / 4")
  eq_str(rs(d("7").checked_div(d("2"))), "3.50", "7 / 2")
  eq_str(rs(d("19.99").checked_div(d("5"))), "3.9980", "19.99 / 5")
  eq_str(os(d("0.25").sqrt()), "0.500000000000000000000", "sqrt(0.25)")
}

// ---------------------------------------------------------------------------
// F-4 (P1) Decimal::from_str silently accepts scientific notation (falls back to
// from_scientific_lossy); rust_decimal's FromStr rejects every exponent form.
// ---------------------------------------------------------------------------

///|
test "redteam_from_str_rejects_exponent_like_rust" {
  let inputs : Array[String] = ["1e28", "0e0", "1E5", "2.5e-3", "-7e+2"]
  let mut i = 0
  while i < inputs.length() {
    eq_str(rs(decimal::Decimal::from_str(inputs[i])), "ERR", "from_str(\"" + inputs[i] + "\")")
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// F-5 (P1) deserialize(): rust_decimal masks flags with 0x801F_0000 (5-bit scale) and, for
// scale 29..31, rounds up when the *raw remainder* of the 10^k division is >= 5. Pion reads an
// 8-bit scale and rounds at 10^k / 2, so the same 16 bytes decode to different numbers.
// ---------------------------------------------------------------------------

///|
test "redteam_deserialize_matches_rust_bit_for_bit" {
  // scale byte 0x20 (32): rust masks it to scale 0 -> 12345; pion divides by 10^4 -> 1e-28
  eq_str(rs(decimal::Decimal::deserialize(wire(0x00200000U, 12345U, 0U, 0U))), "12345", "scale byte 0x20")
  // scale byte 0x3C (60): rust masks to 28 -> 0.0000000000000000000000012345; pion -> 0
  eq_str(
    rs(decimal::Decimal::deserialize(wire(0x003C0000U, 12345U, 0U, 0U))),
    "0.0000000000000000000000012345",
    "scale byte 0x3c",
  )
  // scale 30, mantissa 15: rust 15 % 100 = 15 >= 5 -> rounds up to 1e-28; pion -> 0
  eq_str(
    rs(decimal::Decimal::deserialize(wire(0x001E0000U, 15U, 0U, 0U))),
    "0.0000000000000000000000000001",
    "scale 30, mantissa 15",
  )
}

// ---------------------------------------------------------------------------
// F-6 (P2) trunc_with_scale never pads: rust_decimal rescales up to the requested scale.
// ---------------------------------------------------------------------------

///|
test "redteam_trunc_with_scale_pads_like_rust" {
  eq_str(d("1").trunc_with_scale(2U).to_string(), "1.00", "1.trunc_with_scale(2)")
  eq_str(d("1.239").trunc_with_scale(5U).to_string(), "1.23900", "1.239.trunc_with_scale(5)")
  eq_str(d("0").trunc_with_scale(2U).to_string(), "0.00", "0.trunc_with_scale(2)")
}

// ---------------------------------------------------------------------------
// F-7 (P2) powi / powu: (a) any overflow of x^|n| for n < 0 is swallowed into Ok(0) instead of
// None; (b) the reciprocal-first path for |x| < 1 loses the last digit; (c) scale/normalization
// rules differ from MathematicalOps (exp 1 returns self, exp 2 is a plain checked_mul).
// ---------------------------------------------------------------------------

///|
test "redteam_powi_negative_exponent_overflow_is_an_error" {
  eq_str(rs(d("2").checked_powi(-96L)), "ERR", "2^-96 (rust: None)")
  eq_str(rs(d("2").checked_powi(-1000L)), "ERR", "2^-1000 (rust: None)")
}

///|
test "redteam_powi_reciprocal_precision" {
  // exact: 37.037037037037037037037037037037...; rust (1 / 0.027) is correctly rounded
  eq_str(rs(d("0.3").checked_powi(-3L)), "37.037037037037037037037037037", "0.3^-3")
}

///|
test "redteam_pow_scale_rules_match_rust" {
  eq_str(rs(d("1.0").checked_powi(1L)), "1", "1.0^1")
  eq_str(rs(d("-1.0").checked_powi(2L)), "1.00", "(-1.0)^2")
  eq_str(rs(d("1.10").checked_powu(2UL)), "1.2100", "1.10^2")
  eq_str(rs(d("0.000010").checked_powu(2UL)), "0.000000000100", "0.000010^2")
  eq_str(rs(d("-0").checked_powu(1UL)), "0", "(-0)^1")
}

// ---------------------------------------------------------------------------
// F-8 (P2) Zero / sign corner cases that differ from rust_decimal.
// ---------------------------------------------------------------------------

///|
test "redteam_zero_sign_and_scale_rules" {
  eq_str(rs(d("0.0").checked_add(d("0"))), "0", "0.0 + 0 (rust returns rhs when lhs is zero)")
  eq_str(rs(d("0").checked_add(d("-0.0"))), "-0.0", "0 + -0.0")
  eq_str(d("0.0").fract().to_string(), "0", "fract(0.0)")
  eq_str(os(d("-0").sqrt()), "NONE", "sqrt(-0) (rust: is_sign_negative -> None)")
  match d("-0.5").to_u64() {
    None => ()
    Some(v) => debug_assert(false, "(-0.5).to_u64(): rust_decimal=None pion=Some(" + v.to_string() + ")")
  }
}

// ---------------------------------------------------------------------------
// F-9 (P2) to_f64 is not correctly rounded (repeated /10.0) and keeps -0.0.
// ---------------------------------------------------------------------------

///|
test "redteam_to_f64_correctly_rounded" {
  let bits = d("0.0000000000000000001").to_f64().to_bits().to_uint64()
  debug_assert(
    bits == 0x3BFD83C94FB6D2ACUL,
    "1e-19.to_f64(): rust_decimal=0x3bfd83c94fb6d2ac (nearest double) pion=0x" +
    (if bits == 0x3BFD83C94FB6D2ADUL { "3bfd83c94fb6d2ad" } else { "?" }),
  )
  let z = d("-0").to_f64().to_bits().to_uint64()
  debug_assert(z == 0UL, "(-0).to_f64(): rust_decimal=+0.0")
}

// ---------------------------------------------------------------------------
// F-10 (P2) from_str_radix: overflowing fractional digits are an error in Pion; rust_decimal
// rounds them away (here the integer digits alone fit in 96 bits).
// ---------------------------------------------------------------------------

///|
test "redteam_radix_overflowing_fraction_rounds" {
  eq_str(
    rs(decimal::Decimal::from_str_radix("voqk09r5fbi23km1gk.rjclolh0jqd", 36U)),
    "9078744452314980059341770981",
    "from_str_radix(\"voqk09r5fbi23km1gk.rjclolh0jqd\", 36)",
  )
}

// ---------------------------------------------------------------------------
// Controls: attacks Pion survives with results bit-identical to rust_decimal.
// ---------------------------------------------------------------------------

///|
test "control_max_plus_fraction_boundaries" {
  let max = decimal::Decimal::max()
  eq_str(rs(max.checked_add(d("0.4"))), "79228162514264337593543950335", "MAX + 0.4")
  eq_str(rs(max.checked_add(d("0.5"))), "ERR", "MAX + 0.5")
  eq_str(rs(max.checked_add(d("0.6"))), "ERR", "MAX + 0.6")
  eq_str(
    rs(d("79228162514264337593543950334").checked_add(d("0.5"))),
    "79228162514264337593543950334",
    "(MAX-1) + 0.5 (banker's)",
  )
  eq_str(rs(max.checked_rem(d("0.0000000000000000000000000001"))), "0.0000000000000000000000000000", "MAX % 1e-28")
}

///|
test "control_parse_rounding_past_28_digits" {
  eq_str(rs(decimal::Decimal::from_str("0.00000000000000000000000000005")), "0.0000000000000000000000000001", "half-up at digit 29")
  eq_str(rs(decimal::Decimal::from_str("7.92281625142643375935439503355")), "7.922816251426433759354395034", "96-bit carry at digit 29")
  eq_str(rs(decimal::Decimal::from_str("1.0000000000000000000000000000_5")), "1.0000000000000000000000000001", "underscore at digit 29")
  eq_str(rs(decimal::Decimal::from_scientific("1e-29")), "ERR", "1e-29")
  eq_str(rs(decimal::Decimal::from_scientific("1e-28")), "0.0000000000000000000000000001", "1e-28")
}

///|
test "control_bankers_rounding_and_wide_mul" {
  let ne = decimal::RoundingStrategy::MidpointNearestEven
  eq_str(d("2.5").round_dp_with_strategy(0U, ne).to_string(), "2", "2.5 -> 2")
  eq_str(d("-3.5").round_dp_with_strategy(0U, ne).to_string(), "-4", "-3.5 -> -4")
  let m = d("7.9228162514264337593543950335")
  eq_str(rs(m.checked_mul(m)), "62.771017353866807638357894230", "full-width 96x96 mul")
  eq_str(rs(d("1").checked_div(d("3"))), "0.3333333333333333333333333333", "1 / 3")
}

///|
test "control_huge_inputs_are_linear_and_safe" {
  let sb = StringBuilder::new()
  sb.write_string("0.")
  let mut i = 0
  while i < 200000 {
    sb.write_char('0')
    i = i + 1
  }
  sb.write_char('1')
  eq_str(rs(decimal::Decimal::from_str(sb.to_string())), "0.0000000000000000000000000000", "0.(200k zeros)1")
  eq_str(rs(decimal::Decimal::from_scientific("1e99999999999999999")), "ERR", "1e99999999999999999")
  eq_str(rs(decimal::Decimal::from_scientific("1e-99999999999999999")), "ERR", "1e-99999999999999999")
  eq_str(rs(d("2").checked_powi(1000000000L)), "ERR", "2^1e9")
}
