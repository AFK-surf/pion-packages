///| Adversarial head-to-head workloads, Pion side (mirror of ../../oracle/src/advbench.rs).
///|
///|   decimal_audit_advbench sort <file>      parse + Decimal::sort (+ checksum of the sorted column)
///|   decimal_audit_advbench mul96 <n>        full-width 96-bit x 96-bit checked_mul (mixed scales)
///|   decimal_audit_advbench div <n>          checked_div with 32/64/96-bit divisors (mixed scales)
///|   decimal_audit_advbench sci <file> <r>   Decimal::from_scientific over every line, r rounds
///|   decimal_audit_advbench sqrt <n>         Decimal::sqrt on random positive decimals

import "decimal"

///|
struct Lcg {
  mut s : UInt64
}

///|
fn Lcg::next(self : Lcg) -> UInt64 {
  self.s = self.s * 6364136223846793005UL + 1442695040888963407UL
  self.s ^ (self.s >> 29)
}

///| Random decimal whose mantissa has `width` (32/64/96) significant bits at most.
fn Lcg::dec(self : Lcg, width : Int) -> decimal::Decimal {
  let a = self.next()
  let b = self.next()
  let lo = a.to_uint()
  let mid = if width > 32 { (a >> 32).to_uint() } else { 0U }
  let hi = if width > 64 { (b >> 32).to_uint() } else { 0U }
  let scale = (b % 29UL).to_uint()
  let zero = (lo | mid | hi) == 0U
  match decimal::Decimal::from_parts(lo, mid, hi, !zero && (b & 1UL) == 1UL, scale) {
    Ok(d) => d
    Err(_) => decimal::Decimal::zero()
  }
}

///|
fn fnv(h : UInt64, v : UInt64) -> UInt64 {
  (h ^ v) * 1099511628211UL
}

///|
fn mix(h : UInt64, r : Result[decimal::Decimal, decimal::DecimalError]) -> UInt64 {
  match r {
    Ok(d) => {
      let n = d.normalize()
      fnv(fnv(fnv(fnv(h, n.lo64 & 0xFFFFFFFFUL), n.lo64 >> 32), n.hi.to_uint64()), n.flags.to_uint64())
    }
    Err(_) => fnv(h, 0xFFFFFFFFUL)
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn split_lines(content : String) -> Array[String] {
  let lines : Array[String] = []
  let n = content.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if content.code_unit_at(i) == 10 {
      if i > start {
        lines.push(content.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  lines
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mut h : UInt64 = 14695981039346656037UL
  let rng = Lcg::{ s: 0x5EED1372UL }
  let mode = args[1]
  if mode == "sort" {
    let text = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 1
    }
    let lines = split_lines(text)
    let v : Array[decimal::Decimal] = []
    let mut i = 0
    while i < lines.length() {
      match decimal::Decimal::from_str(lines[i]) {
        Ok(d) => v.push(d)
        Err(_) => return 2
      }
      i = i + 1
    }
    decimal::Decimal::sort(v)
    i = 0
    while i < v.length() {
      h = mix(h, Ok(v[i]))
      i = i + 1
    }
    let n = v.length()
    io_println(
      world,
      "n=" +
      n.to_string() +
      " min=" +
      v[0].to_string() +
      " median=" +
      v[n / 2].to_string() +
      " max=" +
      v[n - 1].to_string(),
    )
  } else if mode == "mul96" {
    let n = parse_int(args[2])
    let mut i = 0
    while i < n {
      let a = rng.dec(96)
      let b = rng.dec(96)
      h = mix(h, a.checked_mul(b))
      i = i + 1
    }
  } else if mode == "div" {
    let n = parse_int(args[2])
    let mut i = 0
    while i < n {
      let a = rng.dec(96)
      let w = if i % 3 == 0 { 32 } else if i % 3 == 1 { 64 } else { 96 }
      let b = rng.dec(w)
      h = mix(h, a.checked_div(b))
      i = i + 1
    }
  } else if mode == "sci" {
    let text = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 1
    }
    let rounds = parse_int(args[3])
    let lines = split_lines(text)
    let mut r = 0
    while r < rounds {
      let mut i = 0
      while i < lines.length() {
        h = mix(h, decimal::Decimal::from_scientific(lines[i]))
        i = i + 1
      }
      r = r + 1
    }
  } else if mode == "sqrt" {
    let n = parse_int(args[2])
    let mut i = 0
    while i < n {
      let a = rng.dec(96).abs()
      h = match a.sqrt() {
        Some(d) => mix(h, Ok(d))
        None => mix(h, Err(decimal::DecimalError::InvalidDomain))
      }
      i = i + 1
    }
  } else {
    return 2
  }
  io_println(world, "fnv1a=" + h.to_string())
  0
}
