///| Wasm32 + Native smoke entry for the `decimal` package.

import "decimal"

///|
pub fn smoke() -> Int {
  let a = match decimal::Decimal::from_str("12345.6789") {
    Ok(d) => d
    Err(_) => return -1
  }
  let b = match decimal::Decimal::from_str("0.0011") {
    Ok(d) => d
    Err(_) => return -2
  }
  let sum = match a.checked_add(b) {
    Ok(d) => d
    Err(_) => return -3
  }
  if sum.to_string() != "12345.6800" {
    return -4
  }
  let norm = sum.normalize()
  if norm.to_string() != "12345.68" {
    return -5
  }
  let prod = match a.checked_mul(decimal::Decimal::from_i64(3L)) {
    Ok(d) => d
    Err(_) => return -6
  }
  let rounded = prod.round_dp_with_strategy(2U, decimal::RoundingStrategy::MidpointNearestEven)
  if rounded.to_string() != "37037.04" {
    return -7
  }
  let quot = match decimal::Decimal::one().checked_div(decimal::Decimal::from_i64(3L)) {
    Ok(d) => d
    Err(_) => return -8
  }
  if quot.to_string() != "0.3333333333333333333333333333" {
    return -9
  }
  match decimal::Decimal::one().checked_div(decimal::Decimal::zero()) {
    Err(decimal::DecimalError::DivisionByZero) => ()
    _ => return -10
  }
  match decimal::Decimal::from_str("1e999999999") {
    Err(_) => ()
    Ok(_) => return -11
  }
  let root = match decimal::Decimal::from_i64(2L).sqrt() {
    Some(d) => d
    None => return -12
  }
  if root.round_dp(6U).to_string() != "1.414214" {
    return -13
  }
  sum.to_string().length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
