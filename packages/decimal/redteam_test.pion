///| Day-1 Red-Team defenses for `packages/decimal`.

///|
fn is_err(r : Result[Decimal, DecimalError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "redteam_huge_exponents_no_oom" {
  let huge : Array[String] = [
    "1e999999999",
    "1e-999999999",
    "1E999999999999999999999999",
    "1E-999999999999999999999999",
    "1.5e4294967296",
    "-20165.4676_e-+4294967292",
    "1e29",
    "1e-29",
  ]
  let mut i = 0
  while i < huge.length() {
    debug_assert(is_err(Decimal::from_str(huge[i])), "from_str must reject " + huge[i])
    debug_assert(is_err(Decimal::from_scientific(huge[i])), "from_scientific must reject " + huge[i])
    debug_assert(
      is_err(Decimal::from_scientific_lossy(huge[i])),
      "from_scientific_lossy must reject " + huge[i],
    )
    i = i + 1
  }
}

///|
test "redteam_div_and_rem_by_zero" {
  let one = Decimal::one()
  let zeros : Array[Decimal] = [
    Decimal::zero(),
    match Decimal::from_str("-0") {
      Ok(d) => d
      Err(_) => Decimal::zero()
    },
    match Decimal::from_str("0.0000") {
      Ok(d) => d
      Err(_) => Decimal::zero()
    },
  ]
  let mut i = 0
  while i < zeros.length() {
    match one.checked_div(zeros[i]) {
      Err(DecimalError::DivisionByZero) => ()
      _ => debug_assert(false, "checked_div by zero must return DivisionByZero")
    }
    match one.checked_rem(zeros[i]) {
      Err(DecimalError::DivisionByZero) => ()
      _ => debug_assert(false, "checked_rem by zero must return DivisionByZero")
    }
    i = i + 1
  }
}

///|
test "redteam_overflow_boundaries" {
  let max = Decimal::max()
  let min = Decimal::min()
  let one = Decimal::one()
  let two = Decimal::two()

  match max.checked_add(one) {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "MAX + 1 must overflow")
  }
  match min.checked_sub(one) {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "MIN - 1 must overflow")
  }
  match max.checked_mul(two) {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "MAX * 2 must overflow")
  }
  match Decimal::from_str("0.1") {
    Ok(tenth) =>
    match max.checked_div(tenth) {
      Err(DecimalError::Overflow) => ()
      _ => debug_assert(false, "MAX / 0.1 must overflow")
    }
    Err(_) => debug_assert(false, "parse 0.1")
  }
  match two.checked_powu(128UL) {
    Err(DecimalError::Overflow) => ()
    _ => debug_assert(false, "2^128 must overflow")
  }
  match Decimal::zero().checked_powi(-1L) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "0^-1 must error")
  }
}

///|
test "redteam_invalid_strings_and_max_plus_one" {
  let invalid : Array[String] = [
    "",
    " ",
    ".",
    "-",
    "+",
    "-.",
    "+.",
    "_1",
    "1.0.0",
    "10_00.0_00.0",
    "abc",
    "12a3",
    "NaN",
    "Infinity",
    "-Infinity",
    "1e",
    "e1",
    "1e+",
    "1e-",
    "1e1.5",
    "1.00000000000000000000000000005zzz",
    "79228162514264337593543950336",
    "-79228162514264337593543950336",
    "79228162514264337593543950340",
    "99999999999999999999999999999",
  ]
  let mut i = 0
  while i < invalid.length() {
    debug_assert(is_err(Decimal::from_str(invalid[i])), "must reject: " + invalid[i])
    i = i + 1
  }
}

///|
test "redteam_long_leading_zeros_and_underscores" {
  let sb_z = StringBuilder::new()
  let mut i = 0
  while i < 10000 {
    sb_z.write_char('0')
    i = i + 1
  }
  sb_z.write_string("42.75")
  match Decimal::from_str(sb_z.to_string()) {
    Ok(d) => debug_assert(d.to_string() == "42.75", "10k leading zeros")
    Err(_) => debug_assert(false, "10k leading zeros failed")
  }

  let sb_u = StringBuilder::new()
  sb_u.write_char('1')
  i = 0
  while i < 10000 {
    sb_u.write_char('_')
    i = i + 1
  }
  sb_u.write_char('2')
  match Decimal::from_str(sb_u.to_string()) {
    Ok(d) => debug_assert(d.to_string() == "12", "10k underscores")
    Err(_) => debug_assert(false, "10k underscores failed")
  }
}

///|
test "redteam_full_precision_roundtrip" {
  let samples : Array[String] = [
    "0",
    "0.0000000000000000000000000000",
    "79228162514264337593543950335",
    "-79228162514264337593543950335",
    "7.9228162514264337593543950335",
    "-7.9228162514264337593543950335",
    "0.0000000000000000000000000001",
    "-0.0000000000000000000000000001",
    "3.1415926535897932384626433832",
    "18446744073709551615.99999999",
  ]
  let mut i = 0
  while i < samples.length() {
    let s = samples[i]
    match Decimal::from_str(s) {
      Ok(d1) => {
        let out = d1.to_string()
        debug_assert(out == s, "roundtrip str: " + out + " != " + s)
        match Decimal::from_str(out) {
          Ok(d2) => {
            debug_assert(d1.eq(d2) && d1.scale() == d2.scale(), "roundtrip eq")
            match Decimal::deserialize(d1.serialize()) {
              Ok(d3) => debug_assert(d3.to_string() == s, "roundtrip serde")
              Err(_) => debug_assert(false, "deserialize failed")
            }
          }
          Err(_) => debug_assert(false, "reparse failed")
        }
      }
      Err(_) => debug_assert(false, "parse failed for " + s)
    }
    i = i + 1
  }
}

///|
test "redteam_f1_to_f10_rust_decimal_alignment" {
  // F-1: Introsort handles reverse, organ-pipe, and all-equal adversarial inputs cleanly
  let n = 512
  let arr : Array[Decimal] = []
  let mut i = 0
  while i < n {
    let v = if (i & 1) == 0 { n - i } else { i }
    arr.push(Decimal::from_int(v))
    i = i + 1
  }
  Decimal::sort(arr)
  i = 1
  while i < n {
    debug_assert(arr[i - 1].le(arr[i]), "introsort ascending")
    i = i + 1
  }

  // F-2: Negative zero cleared on parse and rounding, preserved on neg()/rescale()
  match Decimal::from_str("-0.00") {
    Ok(z) => debug_assert(z.to_string() == "0.00" && !z.is_sign_negative(), "parse -0.00 -> +0.00")
    Err(_) => debug_assert(false, "parse -0.00")
  }
  match Decimal::from_str("-0.004") {
    Ok(v) => {
      let r = v.round_dp(2U)
      debug_assert(r.to_string() == "0.00" && !r.is_sign_negative(), "round_dp(-0.004, 2) -> 0.00")
      let rs = v.rescale(2U)
      debug_assert(rs.to_string() == "-0.00" && rs.is_sign_negative(), "rescale(-0.004, 2) keeps -0.00")
    }
    Err(_) => debug_assert(false, "parse -0.004")
  }

  // F-3: checked_div scale matches rust_decimal
  match Decimal::one().checked_div(Decimal::from_int(5)) {
    Ok(q) => debug_assert(q.to_string() == "0.20", "1/5 == 0.20")
    Err(_) => debug_assert(false, "1/5")
  }

  // F-4: from_str rejects scientific notation
  debug_assert(is_err(Decimal::from_str("1e5")), "from_str rejects 1e5")
  debug_assert(is_err(Decimal::from_str("2.5E-3")), "from_str rejects 2.5E-3")

  // F-5: deserialize 5-bit scale mask & scale 30 carry
  let b = Bytes::new(16)
  b[2] = (0x20).to_byte()
  b[4] = (57).to_byte()
  b[5] = (48).to_byte() // 12345 = 0x3039
  match Decimal::deserialize(b) {
    Ok(d) => debug_assert(d.to_string() == "12345", "deserialize 0x20 mask")
    Err(_) => debug_assert(false, "deserialize 0x20")
  }

  // F-6: trunc_with_scale pads zeros and caps scale > 28 without panic
  debug_assert(Decimal::one().trunc_with_scale(2U).to_string() == "1.00", "1.trunc_with_scale(2)")
  debug_assert(Decimal::zero().trunc_with_scale(255U).scale() == 28U, "trunc_with_scale(255) caps at 28")

  // F-7: powi negative overflow returns Err, reciprocal precision matches rust_decimal
  debug_assert(is_err(Decimal::two().checked_powi(-96L)), "2^-96 overflows")
  match Decimal::from_str("0.3") {
    Ok(v) =>
    match v.checked_powi(-3L) {
      Ok(p) => debug_assert(p.to_string() == "37.037037037037037037037037037", "0.3^-3")
      Err(_) => debug_assert(false, "0.3^-3")
    }
    Err(_) => debug_assert(false, "parse 0.3")
  }

  // F-8: zero sign/scale rules via .neg()
  let neg_zero = Decimal::zero().neg()
  let neg_zero_s1 = match Decimal::from_str("0.0") {
    Ok(v) => v.neg()
    Err(_) => Decimal::zero()
  }
  match Decimal::zero().checked_add(neg_zero_s1) {
    Ok(v) => debug_assert(v.to_string() == "-0.0", "0 + -0.0 == -0.0")
    Err(_) => debug_assert(false, "0 + -0.0")
  }
  match neg_zero.sqrt() {
    None => ()
    Some(_) => debug_assert(false, "sqrt(-0) must be None")
  }
  match neg_zero.to_u64() {
    None => ()
    Some(_) => debug_assert(false, "(-0).to_u64() must be None")
  }

  // F-9: to_f64 nearest double & (-0) -> +0.0
  debug_assert(neg_zero.to_f64().to_bits().to_uint64() == 0UL, "(-0).to_f64() == +0.0")
  match Decimal::from_str("0.0000000000000000001") {
    Ok(v) => debug_assert(v.to_f64().to_bits().to_uint64() == 0x3BFD83C94FB6D2ACUL, "1e-19 to_f64")
    Err(_) => debug_assert(false, "parse 1e-19")
  }

  // F-10: from_str_radix overflowing fraction rounds
  match Decimal::from_str_radix("voqk09r5fbi23km1gk.rjclolh0jqd", 36U) {
    Ok(v) => debug_assert(v.to_string() == "9078744452314980059341770981", "radix 36 overflow fraction")
    Err(_) => debug_assert(false, "radix 36")
  }
}
