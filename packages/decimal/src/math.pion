///| Mathematical functions (`powu`, `powi`, `sqrt`) and numeric conversions (`to_i64`, `to_u64`, `to_f64`).

///| Exact 10^0 .. 10^28 as IEEE-754 `Double`.
let POWERS_10_F64 : FixedArray[Double] = [
  1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0,
  10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0,
  1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0,
  10000000000000000000.0, 1e20, 1e21, 1e22, 1e23, 1e24, 1e25, 1e26, 1e27, 1e28,
]

///| Raise `self` to unsigned integer power `exp` (matches `rust_decimal::MathematicalOps::checked_powu`).
pub fn Decimal::checked_powu(self : Decimal, exp : UInt64) -> Result[Decimal, DecimalError] {
  if exp == 0UL {
    return Ok(ONE)
  }
  if self.is_zero() {
    return Ok(ZERO)
  }
  if self.eq(ONE) {
    return Ok(ONE)
  }
  if exp == 1UL {
    return Ok(self)
  }
  if exp == 2UL {
    return self.checked_mul(self)
  }

  let mut product = ONE
  let mut mask = exp
  let mut power = self
  let mut first = true
  while mask > 0UL {
    if !first {
      power = match power.checked_mul(power) {
        Ok(v) => v
        Err(err) => return Err(err)
      }
    }
    first = false
    if (mask & 1UL) != 0UL {
      product = match product.checked_mul(power) {
        Ok(v) => v
        Err(err) => return Err(err)
      }
    }
    mask = mask >> 1
  }
  Ok(product.normalize())
}

///| Raise `self` to signed integer power `exp` (matches `rust_decimal::MathematicalOps::checked_powi`).
pub fn Decimal::checked_powi(self : Decimal, exp : Int64) -> Result[Decimal, DecimalError] {
  if exp >= 0L {
    return self.checked_powu(exp.to_uint64())
  }
  let uexp : UInt64 = 0UL - exp.to_uint64()
  let pow = match self.checked_powu(uexp) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  ONE.checked_div(pow)
}

///| Alias for `checked_powi`.
pub fn Decimal::powi(self : Decimal, exp : Int64) -> Result[Decimal, DecimalError] {
  self.checked_powi(exp)
}

///| Square root of `self` via Babylonian method with 2-cycle detection (matches `rust_decimal`).
pub fn Decimal::sqrt(self : Decimal) -> Option[Decimal] {
  if self.is_sign_negative() {
    return None
  }
  if self.is_zero() {
    return Some(ZERO)
  }

  let mut result = match self.checked_div(TWO) {
    Ok(d) => d
    Err(_) => self
  }
  if result.is_zero() {
    result = self
  }
  let mut has_prev = false
  let mut prev = ZERO
  let mut iter = 0
  while iter < 1000 {
    iter = iter + 1
    let q = match self.checked_div(result) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    let sum = match result.checked_add(q) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    let next = match sum.checked_div(TWO) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    if next.eq(result) {
      return Some(next)
    }
    if has_prev && next.eq(prev) && next.scale() == prev.scale() {
      let (low, high) = if next.lt(result) { (next, result) } else { (result, next) }
      let mut has_le = false
      let mut le = ZERO
      match low.checked_mul(low) {
        Ok(sq) =>
        match sq.checked_sub(self) {
          Ok(diff) => {
            has_le = true
            le = diff.abs()
          }
          Err(_) => ()
        }
        Err(_) => ()
      }
      let mut has_he = false
      let mut he = ZERO
      match high.checked_mul(high) {
        Ok(sq) =>
        match sq.checked_sub(self) {
          Ok(diff) => {
            has_he = true
            he = diff.abs()
          }
          Err(_) => ()
        }
        Err(_) => ()
      }
      if has_le && has_he && he.lt(le) {
        return Some(high)
      }
      return Some(low)
    }
    prev = result
    has_prev = true
    result = next
  }
  Some(result)
}

///| Convert truncated integer part to `Int64` if it fits.
pub fn Decimal::to_i64(self : Decimal) -> Option[Int64] {
  let t = self.trunc()
  if t.hi != 0U {
    return None
  }
  if t.is_sign_negative() {
    if t.lo64 > 9223372036854775808UL {
      return None
    }
    if t.lo64 == 9223372036854775808UL {
      return Some(-9223372036854775807L - 1L)
    }
    Some(-(t.lo64.to_int64()))
  } else {
    if t.lo64 > 9223372036854775807UL {
      return None
    }
    Some(t.lo64.to_int64())
  }
}

///| Convert truncated integer part to `UInt64` if non-negative and fits (matches `rust_decimal`).
pub fn Decimal::to_u64(self : Decimal) -> Option[UInt64] {
  if self.is_sign_negative() {
    return None
  }
  let t = self.trunc()
  if t.hi != 0U {
    return None
  }
  Some(t.lo64)
}

///| Exact round-to-nearest-even conversion of a 96-bit unsigned integer `(lo64, hi)` to IEEE-754 `Double`.
///| Matches Rust's `u128 as f64` bit-for-bit.
fn u96_to_f64(lo64 : UInt64, hi : UInt) -> Double {
  if hi == 0U {
    if lo64 == 0UL {
      return 0.0
    }
    if lo64 <= 0x7FFFFFFFFFFFFFFFUL {
      return lo64.to_int64().to_double()
    }
    // 64-bit unsigned >= 2^63: exact round-to-nearest-even into 53-bit significand
    let mant = lo64 >> 11
    let rem = lo64 & 0x7FFUL
    let rounded = if rem > 0x400UL || (rem == 0x400UL && (mant & 1UL) != 0UL) {
      mant + 1UL
    } else {
      mant
    }
    let exp : UInt64 = if (rounded & (1UL << 53)) != 0UL { 1087UL } else { 1086UL }
    let frac = if (rounded & (1UL << 53)) != 0UL {
      (rounded >> 1) & 0xFFFFFFFFFFFFFUL
    } else {
      rounded & 0xFFFFFFFFFFFFFUL
    }
    return Double::from_bits(((exp << 52) | frac).to_int64())
  }
  // 65..96 bits: top bit position is 64 + (31 - clz32(hi)) = 95 - clz32(hi)
  let msb = 95 - clz32(hi)
  let shift = msb - 52 // shift in 12..=43
  let lshift = 64 - shift
  let half_shift = shift - 1
  let hi64 = hi.to_uint64()
  let mant = (hi64 << lshift) | (lo64 >> shift)
  let half_bit = 1UL << half_shift
  let low_mask = (1UL << shift) - 1UL
  let rem = lo64 & low_mask
  let rounded = if rem > half_bit || (rem == half_bit && (mant & 1UL) != 0UL) {
    mant + 1UL
  } else {
    mant
  }
  let carry = (rounded & (1UL << 53)) != 0UL
  let exp = (1023 + msb + (if carry { 1 } else { 0 })).to_int64().to_uint64()
  let frac = if carry {
    (rounded >> 1) & 0xFFFFFFFFFFFFFUL
  } else {
    rounded & 0xFFFFFFFFFFFFFUL
  }
  Double::from_bits(((exp << 52) | frac).to_int64())
}

///| Round non-negative Double half-away-from-zero (matches Rust `f64::round`).
fn f64_round_pos(x : Double) -> Double {
  if x >= 4503599627370496.0 {
    return x
  }
  let fl = x.to_int64().to_double()
  if x - fl >= 0.5 {
    fl + 1.0
  } else {
    fl
  }
}

///| Convert `self` to IEEE-754 `Double` (matches `rust_decimal =1.37.2` bit-for-bit).
pub fn Decimal::to_f64(self : Decimal) -> Double {
  let scale = self.scale().to_int()
  if scale == 0 {
    if self.is_zero() {
      return 0.0
    }
    let mag = u96_to_f64(self.lo64, self.hi)
    return if self.is_sign_negative() { -mag } else { mag }
  }

  let neg = self.is_sign_negative()
  let precision_f64 = POWERS_10_F64[scale]

  // Split 96-bit mantissa into integral_part = mantissa / 10^scale and frac_part = mantissa % 10^scale
  let mut int_lo64 : UInt64 = 0UL
  let mut int_hi : UInt = 0U
  let mut frac_lo64 : UInt64 = 0UL
  let mut frac_hi : UInt = 0U

  if self.hi == 0U && scale <= 19 {
    let pow = POWERS_10_U64[scale]
    int_lo64 = self.lo64 / pow
    frac_lo64 = self.lo64 - int_lo64 * pow
  } else {
    // Divide 96-bit mantissa by 10^scale in <= 3 chunks of 10^9, then compute frac = self - int * 10^scale
    let mut q0 = self.lo64.to_uint()
    let mut q1 = (self.lo64 >> 32).to_uint()
    let mut q2 = self.hi
    let mut rem = scale
    while rem > 0 {
      let step = if rem > 9 { 9 } else { rem }
      let div64 = POWERS_10[step].to_uint64()
      let c2 = q2.to_uint64()
      let n2 = c2 / div64
      let r2 = c2 - n2 * div64
      q2 = n2.to_uint()
      let c1 = (r2 << 32) | q1.to_uint64()
      let n1 = c1 / div64
      let r1 = c1 - n1 * div64
      q1 = n1.to_uint()
      let c0 = (r1 << 32) | q0.to_uint64()
      let n0 = c0 / div64
      q0 = n0.to_uint()
      rem = rem - step
    }
    int_lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
    int_hi = q2

    // Multiply int back by 10^scale to get exact remainder frac = self - int * 10^scale
    let mut m_lo64 = int_lo64
    let mut m_hi = int_hi
    rem = scale
    while rem > 0 {
      let step = if rem > 9 { 9 } else { rem }
      let pow = POWERS_10[step].to_uint64()
      let t_lo = (m_lo64 & 0xFFFFFFFFUL) * pow
      let t_mid = (m_lo64 >> 32) * pow + (t_lo >> 32)
      let t_hi = m_hi.to_uint64() * pow + (t_mid >> 32)
      m_lo64 = (t_lo & 0xFFFFFFFFUL) | (t_mid << 32)
      m_hi = t_hi.to_uint()
      rem = rem - step
    }
    let bw = if self.lo64 < m_lo64 { 1U } else { 0U }
    frac_lo64 = self.lo64 - m_lo64
    frac_hi = self.hi - m_hi - bw
  }

  let integral = u96_to_f64(int_lo64, int_hi)
  let frac_f64 = u96_to_f64(frac_lo64, frac_hi) / precision_f64
  if frac_f64 == 0.0 {
    return if neg { -integral } else { integral }
  }
  let value = integral + frac_f64
  let rounded = f64_round_pos(value * precision_f64) / precision_f64
  if neg {
    -rounded
  } else {
    rounded
  }
}
