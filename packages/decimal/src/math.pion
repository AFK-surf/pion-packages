///| Mathematical functions (`powu`, `powi`, `sqrt`) and numeric conversions (`to_i64`, `to_u64`, `to_f64`).

///| Raise `self` to unsigned integer power `exp` using binary exponentiation.
pub fn Decimal::checked_powu(self : Decimal, exp : UInt64) -> Result[Decimal, DecimalError] {
  if exp == 0UL {
    return Ok(ONE)
  }
  if exp == 1UL {
    return Ok(self)
  }
  if self.is_zero() {
    return Ok(ZERO)
  }
  if self.eq(ONE) {
    return Ok(ONE)
  }
  if self.eq(NEGATIVE_ONE) {
    return if (exp & 1UL) == 0UL { Ok(ONE) } else { Ok(NEGATIVE_ONE) }
  }

  let mut base = self.normalize()
  let mut acc = ONE
  let mut e = exp
  while e > 0UL {
    if (e & 1UL) == 1UL {
      acc = match acc.checked_mul(base) {
        Ok(v) => v
        Err(err) => return Err(err)
      }
      if acc.is_zero() {
        return Ok(ZERO)
      }
    }
    e = e >> 1
    if e > 0UL {
      base = match base.checked_mul(base) {
        Ok(v) => v
        Err(err) => return Err(err)
      }
      if base.is_zero() {
        return Ok(ZERO)
      }
    }
  }
  Ok(acc.normalize())
}

///| Raise `self` to signed integer power `exp` (matches `rust_decimal::MathematicalOps::checked_powi`).
pub fn Decimal::checked_powi(self : Decimal, exp : Int64) -> Result[Decimal, DecimalError] {
  if exp >= 0L {
    return self.checked_powu(exp.to_uint64())
  }
  if self.is_zero() {
    return Err(DecimalError::DivisionByZero)
  }
  let uexp : UInt64 = 0UL - exp.to_uint64()
  // For |x| < 1, take reciprocal first to preserve precision
  if self.abs().lt(ONE) {
    let recip = match ONE.checked_div(self) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    match recip.checked_powu(uexp) {
      Ok(p) => Ok(p.normalize())
      Err(e) => Err(e)
    }
  } else {
    match self.checked_powu(uexp) {
      Ok(p) => ONE.checked_div(p)
      Err(_) => Ok(ZERO)
    }
  }
}

///| Alias for `checked_powi`.
pub fn Decimal::powi(self : Decimal, exp : Int64) -> Result[Decimal, DecimalError] {
  self.checked_powi(exp)
}

///| Square root of `self` via Babylonian method with 2-cycle detection (matches `rust_decimal`).
pub fn Decimal::sqrt(self : Decimal) -> Option[Decimal] {
  if self.is_zero() {
    return Some(ZERO)
  }
  if self.is_sign_negative() {
    return None
  }

  let mut result = match self.checked_div(TWO) {
    Ok(d) => d
    Err(_) => self
  }
  if result.is_zero() {
    result = self
  }
  let mut has_prev = false
  let mut prev = ZERO
  let mut iter = 0
  while iter < 1000 {
    iter = iter + 1
    let q = match self.checked_div(result) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    let sum = match result.checked_add(q) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    let next = match sum.checked_div(TWO) {
      Ok(d) => d
      Err(_) => return Some(result)
    }
    if next.eq(result) {
      return Some(next)
    }
    if has_prev && next.eq(prev) && next.scale() == prev.scale() {
      let (low, high) = if next.lt(result) { (next, result) } else { (result, next) }
      let mut has_le = false
      let mut le = ZERO
      match low.checked_mul(low) {
        Ok(sq) =>
        match sq.checked_sub(self) {
          Ok(diff) => {
            has_le = true
            le = diff.abs()
          }
          Err(_) => ()
        }
        Err(_) => ()
      }
      let mut has_he = false
      let mut he = ZERO
      match high.checked_mul(high) {
        Ok(sq) =>
        match sq.checked_sub(self) {
          Ok(diff) => {
            has_he = true
            he = diff.abs()
          }
          Err(_) => ()
        }
        Err(_) => ()
      }
      if has_le && has_he && he.lt(le) {
        return Some(high)
      }
      return Some(low)
    }
    prev = result
    has_prev = true
    result = next
  }
  Some(result)
}

///| Convert truncated integer part to `Int64` if it fits.
pub fn Decimal::to_i64(self : Decimal) -> Option[Int64] {
  let t = self.trunc()
  if t.hi != 0U {
    return None
  }
  if t.is_sign_negative() {
    if t.lo64 > 9223372036854775808UL {
      return None
    }
    if t.lo64 == 9223372036854775808UL {
      return Some(-9223372036854775807L - 1L)
    }
    Some(-(t.lo64.to_int64()))
  } else {
    if t.lo64 > 9223372036854775807UL {
      return None
    }
    Some(t.lo64.to_int64())
  }
}

///| Convert truncated integer part to `UInt64` if non-negative and fits.
pub fn Decimal::to_u64(self : Decimal) -> Option[UInt64] {
  let t = self.trunc()
  if t.is_zero() {
    return Some(0UL)
  }
  if t.is_sign_negative() || t.hi != 0U {
    return None
  }
  Some(t.lo64)
}

///| Convert `self` to IEEE-754 `Double` approximation.
pub fn Decimal::to_f64(self : Decimal) -> Double {
  if self.is_zero() {
    return if self.is_sign_negative() { -0.0 } else { 0.0 }
  }
  let lo = (self.lo64 & 0xFFFFFFFFUL).to_int64().to_double()
  let mid = (self.lo64 >> 32).to_int64().to_double()
  let hi = self.hi.to_int64().to_double()
  let mut fv = lo + mid * 4294967296.0 + hi * 18446744073709551616.0
  let mut s = self.scale().to_int()
  while s >= 9 {
    fv = fv / 1000000000.0
    s = s - 9
  }
  while s > 0 {
    fv = fv / 10.0
    s = s - 1
  }
  if self.is_sign_negative() {
    -fv
  } else {
    fv
  }
}
