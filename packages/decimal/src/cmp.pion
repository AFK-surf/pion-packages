///| Total ordering, equality, and in-place sorting for `Decimal`.

///| Compare magnitudes of two non-zero Decimals (ignoring sign) with zero heap allocation.
#verify
fn cmp_magnitude(a : Decimal, b : Decimal) -> Int {
  let s1 = a.scale().to_int()
  let s2 = b.scale().to_int()
  let mut a_lo = a.lo64
  let mut a_hi = a.hi
  let mut b_lo = b.lo64
  let mut b_hi = b.hi

  if s1 != s2 {
    if s1 > s2 {
      let mut diff = s1 - s2
      if b_hi == 0U && diff <= 19 {
        let (nl, nh) = u64_mul_wide(b_lo, pow10_u64(diff))
        if nh > 0xFFFFFFFFUL {
          return -1
        }
        b_lo = nl
        b_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (b_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (b_lo >> 32) * power + (tmp_lo >> 32)
          b_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + b_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return -1
          }
          b_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    } else {
      let mut diff = s2 - s1
      if a_hi == 0U && diff <= 19 {
        let (nl, nh) = u64_mul_wide(a_lo, pow10_u64(diff))
        if nh > 0xFFFFFFFFUL {
          return 1
        }
        a_lo = nl
        a_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (a_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (a_lo >> 32) * power + (tmp_lo >> 32)
          a_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + a_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return 1
          }
          a_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    }
  }

  if a_hi < b_hi {
    -1
  } else if a_hi > b_hi {
    1
  } else if a_lo < b_lo {
    -1
  } else if a_lo > b_lo {
    1
  } else {
    0
  }
}

///| Compare two `Decimal` values numerically (-1 if self < other, 0 if equal, 1 if self > other).
///| Treats `-0.0 == 0.0` and `1.0 == 1.00`.
#verify
pub fn Decimal::compare(self : Decimal, other : Decimal) -> Int {
  let z1 = self.lo64 == 0UL && self.hi == 0U
  let z2 = other.lo64 == 0UL && other.hi == 0U
  if z2 {
    if z1 {
      return 0
    }
    return if self.is_sign_negative() { -1 } else { 1 }
  }
  if z1 {
    return if other.is_sign_negative() { 1 } else { -1 }
  }
  let n1 = self.is_sign_negative()
  let n2 = other.is_sign_negative()
  if n1 != n2 {
    return if n1 { -1 } else { 1 }
  }
  // Same-scale fast path
  if self.flags == other.flags {
    let mag = if self.hi < other.hi {
      -1
    } else if self.hi > other.hi {
      1
    } else if self.lo64 < other.lo64 {
      -1
    } else if self.lo64 > other.lo64 {
      1
    } else {
      0
    }
    return if n1 { -mag } else { mag }
  }
  let mag = cmp_magnitude(self, other)
  if n1 {
    -mag
  } else {
    mag
  }
}

///|
pub fn Decimal::eq(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) == 0
}

///|
pub fn Decimal::lt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) < 0
}

///|
pub fn Decimal::le(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) <= 0
}

///|
pub fn Decimal::gt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) > 0
}

///|
pub fn Decimal::ge(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) >= 0
}

///|
pub fn Decimal::min_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) > 0 {
    other
  } else {
    self
  }
}

///|
pub fn Decimal::max_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) < 0 {
    other
  } else {
    self
  }
}

///| Insertion sort on arr[lo..=hi].
fn insertion_sort_dec(arr : Array[Decimal], lo : Int, hi : Int) -> Unit {
  let mut i = lo + 1
  while i <= hi {
    let key = arr[i]
    let mut j = i - 1
    while j >= lo && arr[j].compare(key) > 0 {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| Sift-down helper for heapsort on `arr[lo..=lo+len-1]`.
fn heap_sift_down_dec(arr : Array[Decimal], lo : Int, len : Int, root_in : Int) -> Unit {
  let mut root = root_in
  let root_val = arr[lo + root]
  while true {
    let left = (root << 1) + 1
    if left >= len {
      break
    }
    let mut best = left
    let right = left + 1
    if right < len && arr[lo + right].compare(arr[lo + left]) > 0 {
      best = right
    }
    if arr[lo + best].compare(root_val) > 0 {
      arr[lo + root] = arr[lo + best]
      root = best
    } else {
      break
    }
  }
  arr[lo + root] = root_val
}

///| In-place O(n log n) worst-case heapsort on `arr[lo..=hi]`.
fn heapsort_dec(arr : Array[Decimal], lo : Int, hi : Int) -> Unit {
  let len = hi - lo + 1
  if len <= 1 {
    return
  }
  let mut start = (len >> 1) - 1
  while start >= 0 {
    heap_sift_down_dec(arr, lo, len, start)
    start = start - 1
  }
  let mut end = len - 1
  while end > 0 {
    let t = arr[lo]
    arr[lo] = arr[lo + end]
    arr[lo + end] = t
    heap_sift_down_dec(arr, lo, end, 0)
    end = end - 1
  }
}

///| In-place introsort: median-of-three quicksort with 2*log2(n) heapsort fallback and insertion sort cutoff.
fn introsort_dec(arr : Array[Decimal], lo_in : Int, hi_in : Int, depth_in : Int) -> Unit {
  let mut lo = lo_in
  let mut hi = hi_in
  let mut depth = depth_in
  while hi - lo > 16 {
    if depth == 0 {
      heapsort_dec(arr, lo, hi)
      return
    }
    depth = depth - 1
    let span = hi - lo
    let mid = lo + (span >> 1)
    let p1 = lo + (span >> 2)
    let p2 = hi - (span >> 2)
    // Median-of-three on interior quartiles (defeats boundary-pivot killers; heapsort guarantees O(n log n))
    if arr[mid].compare(arr[p1]) < 0 {
      let t = arr[p1]
      arr[p1] = arr[mid]
      arr[mid] = t
    }
    if arr[p2].compare(arr[p1]) < 0 {
      let t = arr[p1]
      arr[p1] = arr[p2]
      arr[p2] = t
    }
    if arr[p2].compare(arr[mid]) < 0 {
      let t = arr[mid]
      arr[mid] = arr[p2]
      arr[p2] = t
    }
    // Move median (arr[mid]) to arr[hi] as pivot
    let pt = arr[mid]
    arr[mid] = arr[hi]
    arr[hi] = pt
    let pivot = arr[hi]
    let mut i = lo - 1
    let mut j = hi
    while true {
      i = i + 1
      while arr[i].compare(pivot) < 0 {
        i = i + 1
      }
      j = j - 1
      while j > lo && arr[j].compare(pivot) > 0 {
        j = j - 1
      }
      if i >= j {
        break
      }
      let t = arr[i]
      arr[i] = arr[j]
      arr[j] = t
    }
    let t = arr[i]
    arr[i] = arr[hi]
    arr[hi] = t

    // Tail-call optimize larger partition
    if i - lo < hi - i {
      if i - 1 > lo {
        introsort_dec(arr, lo, i - 1, depth)
      }
      lo = i + 1
    } else {
      if i + 1 < hi {
        introsort_dec(arr, i + 1, hi, depth)
      }
      hi = i - 1
    }
  }
  if hi > lo {
    insertion_sort_dec(arr, lo, hi)
  }
}

///| Sort an `Array[Decimal]` in-place in ascending numerical order (worst-case O(n log n) introsort).
pub fn Decimal::sort(arr : Array[Decimal]) -> Unit {
  let n = arr.length()
  if n > 1 {
    let mut depth = 0
    let mut m = n
    while m > 1 {
      m = m >> 1
      depth = depth + 1
    }
    introsort_dec(arr, 0, n - 1, depth << 1)
  }
}
