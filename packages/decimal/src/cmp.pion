///| Total ordering, equality, and in-place sorting for `Decimal`.

///| Compare magnitudes of two non-zero Decimals (ignoring sign) with zero heap allocation.
#verify
fn cmp_magnitude(a : Decimal, b : Decimal) -> Int {
  let s1 = a.scale().to_int()
  let s2 = b.scale().to_int()
  let mut a_lo = a.lo64
  let mut a_hi = a.hi
  let mut b_lo = b.lo64
  let mut b_hi = b.hi

  if s1 != s2 {
    if s1 > s2 {
      let mut diff = s1 - s2
      if b_hi == 0U && diff <= 19 {
        let (nl, nh) = u64_mul_wide(b_lo, pow10_u64(diff))
        if nh > 0xFFFFFFFFUL {
          return -1
        }
        b_lo = nl
        b_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (b_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (b_lo >> 32) * power + (tmp_lo >> 32)
          b_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + b_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return -1
          }
          b_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    } else {
      let mut diff = s2 - s1
      if a_hi == 0U && diff <= 19 {
        let (nl, nh) = u64_mul_wide(a_lo, pow10_u64(diff))
        if nh > 0xFFFFFFFFUL {
          return 1
        }
        a_lo = nl
        a_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (a_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (a_lo >> 32) * power + (tmp_lo >> 32)
          a_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + a_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return 1
          }
          a_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    }
  }

  if a_hi < b_hi {
    -1
  } else if a_hi > b_hi {
    1
  } else if a_lo < b_lo {
    -1
  } else if a_lo > b_lo {
    1
  } else {
    0
  }
}

///| Compare two `Decimal` values numerically (-1 if self < other, 0 if equal, 1 if self > other).
///| Treats `-0.0 == 0.0` and `1.0 == 1.00`.
#verify
pub fn Decimal::compare(self : Decimal, other : Decimal) -> Int {
  let z1 = self.lo64 == 0UL && self.hi == 0U
  let z2 = other.lo64 == 0UL && other.hi == 0U
  if z2 {
    if z1 {
      return 0
    }
    return if self.is_sign_negative() { -1 } else { 1 }
  }
  if z1 {
    return if other.is_sign_negative() { 1 } else { -1 }
  }
  let n1 = self.is_sign_negative()
  let n2 = other.is_sign_negative()
  if n1 != n2 {
    return if n1 { -1 } else { 1 }
  }
  // Same-scale fast path
  if self.flags == other.flags {
    let mag = if self.hi < other.hi {
      -1
    } else if self.hi > other.hi {
      1
    } else if self.lo64 < other.lo64 {
      -1
    } else if self.lo64 > other.lo64 {
      1
    } else {
      0
    }
    return if n1 { -mag } else { mag }
  }
  let mag = cmp_magnitude(self, other)
  if n1 {
    -mag
  } else {
    mag
  }
}

///|
pub fn Decimal::eq(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) == 0
}

///|
pub fn Decimal::lt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) < 0
}

///|
pub fn Decimal::le(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) <= 0
}

///|
pub fn Decimal::gt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) > 0
}

///|
pub fn Decimal::ge(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) >= 0
}

///|
pub fn Decimal::min_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) > 0 {
    other
  } else {
    self
  }
}

///|
pub fn Decimal::max_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) < 0 {
    other
  } else {
    self
  }
}

///| Zero-allocation scalar comparison of two raw Decimal payloads `(lo64, hi, flags)`.
fn cmp_raw(
  a_lo_in : UInt64,
  a_hi_in : UInt,
  a_flags : UInt,
  b_lo_in : UInt64,
  b_hi_in : UInt,
  b_flags : UInt,
) -> Int {
  // Fast path: identical sign & scale (handles +-0 accurately)
  if a_flags == b_flags {
    let mag = if a_hi_in != b_hi_in {
      if a_hi_in < b_hi_in { -1 } else { 1 }
    } else if a_lo_in < b_lo_in {
      -1
    } else if a_lo_in > b_lo_in {
      1
    } else {
      0
    }
    return if (a_flags & SIGN_MASK) != 0U { -mag } else { mag }
  }
  let z1 = a_lo_in == 0UL && a_hi_in == 0U
  let z2 = b_lo_in == 0UL && b_hi_in == 0U
  if z2 {
    if z1 {
      return 0
    }
    return if (a_flags & SIGN_MASK) != 0U { -1 } else { 1 }
  }
  if z1 {
    return if (b_flags & SIGN_MASK) != 0U { 1 } else { -1 }
  }
  let n1 = (a_flags & SIGN_MASK) != 0U
  let n2 = (b_flags & SIGN_MASK) != 0U
  if n1 != n2 {
    return if n1 { -1 } else { 1 }
  }

  let s1 = ((a_flags & SCALE_MASK) >> 16).to_int()
  let s2 = ((b_flags & SCALE_MASK) >> 16).to_int()
  let mut a_lo = a_lo_in
  let mut a_hi = a_hi_in
  let mut b_lo = b_lo_in
  let mut b_hi = b_hi_in

  if s1 != s2 {
    if s1 > s2 {
      let mut diff = s1 - s2
      if b_hi == 0U && diff <= 9 {
        let power = pow10_u32(diff).to_uint64()
        let p0 = (b_lo & 0xFFFFFFFFUL) * power
        let p1 = (b_lo >> 32) * power + (p0 >> 32)
        b_lo = (p0 & 0xFFFFFFFFUL) | (p1 << 32)
        b_hi = (p1 >> 32).to_uint()
      } else if b_hi == 0U && diff <= 19 {
        let p64 = pow10_u64(diff)
        let x0 = b_lo & 0xFFFFFFFFUL
        let x1 = b_lo >> 32
        let y0 = p64 & 0xFFFFFFFFUL
        let y1 = p64 >> 32
        let p0 = x0 * y0
        let p1 = x0 * y1
        let p2 = x1 * y0
        let p3 = x1 * y1
        let mid = (p0 >> 32) + (p1 & 0xFFFFFFFFUL) + (p2 & 0xFFFFFFFFUL)
        let nh = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
        if nh > 0xFFFFFFFFUL {
          return if n1 { 1 } else { -1 }
        }
        b_lo = (p0 & 0xFFFFFFFFUL) | (mid << 32)
        b_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (b_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (b_lo >> 32) * power + (tmp_lo >> 32)
          b_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + b_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return if n1 { 1 } else { -1 }
          }
          b_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    } else {
      let mut diff = s2 - s1
      if a_hi == 0U && diff <= 9 {
        let power = pow10_u32(diff).to_uint64()
        let p0 = (a_lo & 0xFFFFFFFFUL) * power
        let p1 = (a_lo >> 32) * power + (p0 >> 32)
        a_lo = (p0 & 0xFFFFFFFFUL) | (p1 << 32)
        a_hi = (p1 >> 32).to_uint()
      } else if a_hi == 0U && diff <= 19 {
        let p64 = pow10_u64(diff)
        let x0 = a_lo & 0xFFFFFFFFUL
        let x1 = a_lo >> 32
        let y0 = p64 & 0xFFFFFFFFUL
        let y1 = p64 >> 32
        let p0 = x0 * y0
        let p1 = x0 * y1
        let p2 = x1 * y0
        let p3 = x1 * y1
        let mid = (p0 >> 32) + (p1 & 0xFFFFFFFFUL) + (p2 & 0xFFFFFFFFUL)
        let nh = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
        if nh > 0xFFFFFFFFUL {
          return if n1 { -1 } else { 1 }
        }
        a_lo = (p0 & 0xFFFFFFFFUL) | (mid << 32)
        a_hi = nh.to_uint()
      } else {
        while diff > 0 {
          let step = if diff >= 9 { 9 } else { diff }
          let power = pow10_u32(step).to_uint64()
          let tmp_lo = (a_lo & 0xFFFFFFFFUL) * power
          let mut tmp = (a_lo >> 32) * power + (tmp_lo >> 32)
          a_lo = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
          tmp = (tmp >> 32) + a_hi.to_uint64() * power
          if tmp > 0xFFFFFFFFUL {
            return if n1 { -1 } else { 1 }
          }
          a_hi = tmp.to_uint()
          diff = diff - step
        }
      }
    }
  }

  let mag = if a_hi != b_hi {
    if a_hi < b_hi { -1 } else { 1 }
  } else if a_lo < b_lo {
    -1
  } else if a_lo > b_lo {
    1
  } else {
    0
  }
  if n1 { -mag } else { mag }
}

///| Compute a 64-bit order-preserving sortable key from a Decimal's IEEE-754 Double approximation.
///| Error vs exact mathematical value is strictly < 4 ULPs (even across binade boundaries),
///| so `k_a + 8UL < k_b` strictly implies `a < b`, and `k_b + 8UL < k_a` strictly implies `a > b`.
fn decimal_sort_key(lo64 : UInt64, hi : UInt, flags : UInt) -> UInt64 {
  if lo64 == 0UL && hi == 0U {
    return 0x8000000000000000UL
  }
  let mag_f : Double = if hi == 0U && lo64 <= 0x7FFFFFFFFFFFFFFFUL {
    lo64.to_int64().to_double()
  } else {
    u96_to_f64(lo64, hi)
  }
  let scale = ((flags & SCALE_MASK) >> 16).to_int()
  let v = if scale == 0 { mag_f } else { mag_f / pow10_f64(scale) }
  let bits = v.to_bits().to_uint64()
  if (flags & SIGN_MASK) != 0U {
    (bits | 0x8000000000000000UL) ^ 0xFFFFFFFFFFFFFFFFUL
  } else {
    bits ^ 0x8000000000000000UL
  }
}

///| Insertion sort on SoA `(keys, lo64s, his, flagss)[lo..=hi]` (zero heap allocations).
fn insertion_sort_soa(
  keys : FixedArray[UInt64],
  lo64s : FixedArray[UInt64],
  his : FixedArray[UInt],
  flagss : FixedArray[UInt],
  lo : Int,
  hi : Int,
) -> Unit {
  let mut i = lo + 1
  while i <= hi {
    let k_key = keys[i]
    let k_lo = lo64s[i]
    let k_hi = his[i]
    let k_fl = flagss[i]
    let k_lo_bound = k_key - 8UL
    let k_hi_bound = k_key + 8UL
    let mut j = i - 1
    while j >= lo {
      let aj_key = keys[j]
      if aj_key < k_lo_bound {
        break
      }
      if aj_key > k_hi_bound || cmp_raw(lo64s[j], his[j], flagss[j], k_lo, k_hi, k_fl) > 0 {
        keys[j + 1] = aj_key
        lo64s[j + 1] = lo64s[j]
        his[j + 1] = his[j]
        flagss[j + 1] = flagss[j]
        j = j - 1
      } else {
        break
      }
    }
    keys[j + 1] = k_key
    lo64s[j + 1] = k_lo
    his[j + 1] = k_hi
    flagss[j + 1] = k_fl
    i = i + 1
  }
}

///| Sift-down helper for heapsort on SoA `(keys, lo64s, his, flagss)[lo..=lo+len-1]`.
fn heap_sift_down_soa(
  keys : FixedArray[UInt64],
  lo64s : FixedArray[UInt64],
  his : FixedArray[UInt],
  flagss : FixedArray[UInt],
  lo : Int,
  len : Int,
  root_in : Int,
) -> Unit {
  let mut root = root_in
  let r_key = keys[lo + root]
  let r_lo = lo64s[lo + root]
  let r_hi = his[lo + root]
  let r_fl = flagss[lo + root]
  while true {
    let left = (root << 1) + 1
    if left >= len {
      break
    }
    let mut best = left
    let mut b_key = keys[lo + left]
    let right = left + 1
    if right < len {
      let rt_key = keys[lo + right]
      if b_key + 8UL < rt_key ||
      (rt_key + 8UL >= b_key &&
        cmp_raw(
          lo64s[lo + right],
          his[lo + right],
          flagss[lo + right],
          lo64s[lo + left],
          his[lo + left],
          flagss[lo + left],
        ) >
        0) {
        best = right
        b_key = rt_key
      }
    }
    if r_key + 8UL < b_key ||
    (b_key + 8UL >= r_key &&
      cmp_raw(lo64s[lo + best], his[lo + best], flagss[lo + best], r_lo, r_hi, r_fl) > 0) {
      keys[lo + root] = b_key
      lo64s[lo + root] = lo64s[lo + best]
      his[lo + root] = his[lo + best]
      flagss[lo + root] = flagss[lo + best]
      root = best
    } else {
      break
    }
  }
  keys[lo + root] = r_key
  lo64s[lo + root] = r_lo
  his[lo + root] = r_hi
  flagss[lo + root] = r_fl
}

///| In-place O(n log n) worst-case heapsort on SoA `(keys, lo64s, his, flagss)[lo..=hi]`.
fn heapsort_soa(
  keys : FixedArray[UInt64],
  lo64s : FixedArray[UInt64],
  his : FixedArray[UInt],
  flagss : FixedArray[UInt],
  lo : Int,
  hi : Int,
) -> Unit {
  let len = hi - lo + 1
  if len <= 1 {
    return
  }
  let mut start = (len >> 1) - 1
  while start >= 0 {
    heap_sift_down_soa(keys, lo64s, his, flagss, lo, len, start)
    start = start - 1
  }
  let mut end = len - 1
  while end > 0 {
    let t_key = keys[lo]
    let t_lo = lo64s[lo]
    let t_hi = his[lo]
    let t_fl = flagss[lo]
    keys[lo] = keys[lo + end]
    lo64s[lo] = lo64s[lo + end]
    his[lo] = his[lo + end]
    flagss[lo] = flagss[lo + end]
    keys[lo + end] = t_key
    lo64s[lo + end] = t_lo
    his[lo + end] = t_hi
    flagss[lo + end] = t_fl
    heap_sift_down_soa(keys, lo64s, his, flagss, lo, end, 0)
    end = end - 1
  }
}

///| In-place introsort on SoA `(keys, lo64s, his, flagss)[lo..=hi]` with call-free inner partition scans.
fn introsort_soa(
  keys : FixedArray[UInt64],
  lo64s : FixedArray[UInt64],
  his : FixedArray[UInt],
  flagss : FixedArray[UInt],
  lo_in : Int,
  hi_in : Int,
  depth_in : Int,
) -> Unit {
  let mut lo = lo_in
  let mut hi = hi_in
  let mut depth = depth_in
  while hi - lo > 16 {
    if depth == 0 {
      heapsort_soa(keys, lo64s, his, flagss, lo, hi)
      return
    }
    depth = depth - 1
    let span = hi - lo
    let mid = lo + (span >> 1)
    let p1 = lo + (span >> 2)
    let p2 = hi - (span >> 2)
    // Median-of-three on interior quartiles
    if keys[mid] + 8UL < keys[p1] ||
    (keys[p1] + 8UL >= keys[mid] &&
      cmp_raw(lo64s[mid], his[mid], flagss[mid], lo64s[p1], his[p1], flagss[p1]) < 0) {
      let t_key = keys[p1]
      let t_lo = lo64s[p1]
      let t_hi = his[p1]
      let t_fl = flagss[p1]
      keys[p1] = keys[mid]
      lo64s[p1] = lo64s[mid]
      his[p1] = his[mid]
      flagss[p1] = flagss[mid]
      keys[mid] = t_key
      lo64s[mid] = t_lo
      his[mid] = t_hi
      flagss[mid] = t_fl
    }
    if keys[p2] + 8UL < keys[p1] ||
    (keys[p1] + 8UL >= keys[p2] &&
      cmp_raw(lo64s[p2], his[p2], flagss[p2], lo64s[p1], his[p1], flagss[p1]) < 0) {
      let t_key = keys[p1]
      let t_lo = lo64s[p1]
      let t_hi = his[p1]
      let t_fl = flagss[p1]
      keys[p1] = keys[p2]
      lo64s[p1] = lo64s[p2]
      his[p1] = his[p2]
      flagss[p1] = flagss[p2]
      keys[p2] = t_key
      lo64s[p2] = t_lo
      his[p2] = t_hi
      flagss[p2] = t_fl
    }
    if keys[p2] + 8UL < keys[mid] ||
    (keys[mid] + 8UL >= keys[p2] &&
      cmp_raw(lo64s[p2], his[p2], flagss[p2], lo64s[mid], his[mid], flagss[mid]) < 0) {
      let t_key = keys[mid]
      let t_lo = lo64s[mid]
      let t_hi = his[mid]
      let t_fl = flagss[mid]
      keys[mid] = keys[p2]
      lo64s[mid] = lo64s[p2]
      his[mid] = his[p2]
      flagss[mid] = flagss[p2]
      keys[p2] = t_key
      lo64s[p2] = t_lo
      his[p2] = t_hi
      flagss[p2] = t_fl
    }
    // Move median (mid) to hi as pivot
    let piv_key = keys[mid]
    let piv_lo = lo64s[mid]
    let piv_hi = his[mid]
    let piv_fl = flagss[mid]
    keys[mid] = keys[hi]
    lo64s[mid] = lo64s[hi]
    his[mid] = his[hi]
    flagss[mid] = flagss[hi]
    keys[hi] = piv_key
    lo64s[hi] = piv_lo
    his[hi] = piv_hi
    flagss[hi] = piv_fl

    let piv_lo_bound = piv_key - 8UL
    let piv_hi_bound = piv_key + 8UL
    let mut i = lo - 1
    let mut j = hi
    while true {
      i = i + 1
      let mut ki = keys[i]
      while true {
        while ki < piv_lo_bound {
          i = i + 1
          ki = keys[i]
        }
        if ki > piv_hi_bound || cmp_raw(lo64s[i], his[i], flagss[i], piv_lo, piv_hi, piv_fl) >= 0 {
          break
        }
        i = i + 1
        ki = keys[i]
      }
      j = j - 1
      let mut kj = keys[j]
      while j > lo {
        while j > lo && kj > piv_hi_bound {
          j = j - 1
          kj = keys[j]
        }
        if j <= lo || kj < piv_lo_bound || cmp_raw(lo64s[j], his[j], flagss[j], piv_lo, piv_hi, piv_fl) <= 0 {
          break
        }
        j = j - 1
        kj = keys[j]
      }
      if i >= j {
        break
      }
      keys[i] = kj
      keys[j] = ki
      let t_lo = lo64s[i]
      let t_hi = his[i]
      let t_fl = flagss[i]
      lo64s[i] = lo64s[j]
      his[i] = his[j]
      flagss[i] = flagss[j]
      lo64s[j] = t_lo
      his[j] = t_hi
      flagss[j] = t_fl
    }
    keys[hi] = keys[i]
    keys[i] = piv_key
    let t_lo = lo64s[i]
    let t_hi = his[i]
    let t_fl = flagss[i]
    lo64s[i] = piv_lo
    his[i] = piv_hi
    flagss[i] = piv_fl
    lo64s[hi] = t_lo
    his[hi] = t_hi
    flagss[hi] = t_fl

    // Tail-call optimize larger partition
    if i - lo < hi - i {
      if i - 1 > lo {
        introsort_soa(keys, lo64s, his, flagss, lo, i - 1, depth)
      }
      lo = i + 1
    } else {
      if i + 1 < hi {
        introsort_soa(keys, lo64s, his, flagss, i + 1, hi, depth)
      }
      hi = i - 1
    }
  }
  if hi > lo {
    insertion_sort_soa(keys, lo64s, his, flagss, lo, hi)
  }
}

///| Sort an `Array[Decimal]` in-place in ascending numerical order (worst-case O(n log n) SoA introsort).
pub fn Decimal::sort(arr : Array[Decimal]) -> Unit {
  let n = arr.length()
  if n <= 1 {
    return
  }
  let keys : FixedArray[UInt64] = FixedArray::make(n, 0UL)
  let lo64s : FixedArray[UInt64] = FixedArray::make(n, 0UL)
  let his : FixedArray[UInt] = FixedArray::make(n, 0U)
  let flagss : FixedArray[UInt] = FixedArray::make(n, 0U)
  let mut k = 0
  while k < n {
    let d = arr[k]
    let d_lo = d.lo64
    let d_hi = d.hi
    let d_fl = d.flags
    lo64s[k] = d_lo
    his[k] = d_hi
    flagss[k] = d_fl
    keys[k] = decimal_sort_key(d_lo, d_hi, d_fl)
    k = k + 1
  }
  let mut depth = 0
  let mut m = n
  while m > 1 {
    m = m >> 1
    depth = depth + 1
  }
  introsort_soa(keys, lo64s, his, flagss, 0, n - 1, depth << 1)
  k = 0
  while k < n {
    arr[k] = Decimal::{ lo64: lo64s[k], hi: his[k], flags: flagss[k] }
    k = k + 1
  }
}
