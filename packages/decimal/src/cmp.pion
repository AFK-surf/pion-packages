///| Total ordering, equality, and in-place sorting for `Decimal`.

///| Rescale a 96-bit unsigned integer (lo64, hi) by 10^diff; returns Some((lo64, hi)) or None on overflow.
fn cmp_rescale96(lo64_in : UInt64, hi_in : UInt, diff_in : Int) -> Option[(UInt64, UInt)] {
  let mut lo64 = lo64_in
  let mut hi = hi_in
  let mut diff = diff_in
  while diff > 0 {
    let step = if diff >= 9 { 9 } else { diff }
    let power = POWERS_10[step].to_uint64()
    let tmp_lo = (lo64 & 0xFFFFFFFFUL) * power
    let mut tmp = (lo64 >> 32) * power + (tmp_lo >> 32)
    lo64 = (tmp_lo & 0xFFFFFFFFUL) | (tmp << 32)
    tmp = tmp >> 32
    tmp = tmp + hi.to_uint64() * power
    if tmp > 0xFFFFFFFFUL {
      return None
    }
    hi = tmp.to_uint()
    diff = diff - step
  }
  Some((lo64, hi))
}

///| Compare magnitudes of two non-zero Decimals (ignoring sign).
fn cmp_magnitude(a : Decimal, b : Decimal) -> Int {
  let s1 = a.scale().to_int()
  let s2 = b.scale().to_int()
  let mut a_lo = a.lo64
  let mut a_hi = a.hi
  let mut b_lo = b.lo64
  let mut b_hi = b.hi

  if s1 != s2 {
    if s1 > s2 {
      match cmp_rescale96(b_lo, b_hi, s1 - s2) {
        Some((nl, nh)) => {
          b_lo = nl
          b_hi = nh
        }
        None => return -1
      }
    } else {
      match cmp_rescale96(a_lo, a_hi, s2 - s1) {
        Some((nl, nh)) => {
          a_lo = nl
          a_hi = nh
        }
        None => return 1
      }
    }
  }

  if a_hi < b_hi {
    -1
  } else if a_hi > b_hi {
    1
  } else if a_lo < b_lo {
    -1
  } else if a_lo > b_lo {
    1
  } else {
    0
  }
}

///| Compare two `Decimal` values numerically (-1 if self < other, 0 if equal, 1 if self > other).
///| Treats `-0.0 == 0.0` and `1.0 == 1.00`.
pub fn Decimal::compare(self : Decimal, other : Decimal) -> Int {
  let z1 = self.lo64 == 0UL && self.hi == 0U
  let z2 = other.lo64 == 0UL && other.hi == 0U
  if z2 {
    if z1 {
      return 0
    }
    return if self.is_sign_negative() { -1 } else { 1 }
  }
  if z1 {
    return if other.is_sign_negative() { 1 } else { -1 }
  }
  let n1 = self.is_sign_negative()
  let n2 = other.is_sign_negative()
  if n1 != n2 {
    return if n1 { -1 } else { 1 }
  }
  // Same-scale fast path
  if self.flags == other.flags {
    let mag = if self.hi < other.hi {
      -1
    } else if self.hi > other.hi {
      1
    } else if self.lo64 < other.lo64 {
      -1
    } else if self.lo64 > other.lo64 {
      1
    } else {
      0
    }
    return if n1 { -mag } else { mag }
  }
  let mag = cmp_magnitude(self, other)
  if n1 {
    -mag
  } else {
    mag
  }
}

///|
pub fn Decimal::eq(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) == 0
}

///|
pub fn Decimal::lt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) < 0
}

///|
pub fn Decimal::le(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) <= 0
}

///|
pub fn Decimal::gt(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) > 0
}

///|
pub fn Decimal::ge(self : Decimal, other : Decimal) -> Bool {
  self.compare(other) >= 0
}

///|
pub fn Decimal::min_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) > 0 {
    other
  } else {
    self
  }
}

///|
pub fn Decimal::max_val(self : Decimal, other : Decimal) -> Decimal {
  if self.compare(other) < 0 {
    other
  } else {
    self
  }
}

///| Insertion sort on arr[lo..=hi].
fn insertion_sort_dec(arr : Array[Decimal], lo : Int, hi : Int) -> Unit {
  let mut i = lo + 1
  while i <= hi {
    let key = arr[i]
    let mut j = i - 1
    while j >= lo && arr[j].compare(key) > 0 {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| In-place quicksort with median-of-three pivot and insertion sort cutoff.
fn quicksort_dec(arr : Array[Decimal], lo_in : Int, hi_in : Int) -> Unit {
  let mut lo = lo_in
  let mut hi = hi_in
  while hi - lo > 16 {
    let mid = lo + ((hi - lo) >> 1)
    if arr[mid].compare(arr[lo]) < 0 {
      let t = arr[lo]
      arr[lo] = arr[mid]
      arr[mid] = t
    }
    if arr[hi].compare(arr[lo]) < 0 {
      let t = arr[lo]
      arr[lo] = arr[hi]
      arr[hi] = t
    }
    if arr[mid].compare(arr[hi]) < 0 {
      let t = arr[mid]
      arr[mid] = arr[hi]
      arr[hi] = t
    }
    let pivot = arr[hi]
    let mut i = lo - 1
    let mut j = hi
    while true {
      i = i + 1
      while arr[i].compare(pivot) < 0 {
        i = i + 1
      }
      j = j - 1
      while j > lo && arr[j].compare(pivot) > 0 {
        j = j - 1
      }
      if i >= j {
        break
      }
      let t = arr[i]
      arr[i] = arr[j]
      arr[j] = t
    }
    let t = arr[i]
    arr[i] = arr[hi]
    arr[hi] = t

    // Tail-call optimize larger partition
    if i - lo < hi - i {
      if i - 1 > lo {
        quicksort_dec(arr, lo, i - 1)
      }
      lo = i + 1
    } else {
      if i + 1 < hi {
        quicksort_dec(arr, i + 1, hi)
      }
      hi = i - 1
    }
  }
  if hi > lo {
    insertion_sort_dec(arr, lo, hi)
  }
}

///| Sort an `Array[Decimal]` in-place in ascending numerical order.
pub fn Decimal::sort(arr : Array[Decimal]) -> Unit {
  let n = arr.length()
  if n > 1 {
    quicksort_dec(arr, 0, n - 1)
  }
}
