///| Iterative, O(1)-stack, 64-bit-fast-path parser for `Decimal`.

///| Add 1 to 96-bit (lo64, hi); returns (lo64, hi, overflow).
fn inc96(lo64 : UInt64, hi : UInt) -> (UInt64, UInt, Bool) {
  let nlo = lo64 + 1UL
  if nlo != 0UL {
    return (nlo, hi, false)
  }
  let nhi = hi + 1U
  if nhi != 0U {
    return (0UL, nhi, false)
  }
  (0UL, 0U, true)
}

///| Multiply 96-bit (lo64, hi) by 10 and add digit (0..9); returns (lo64, hi, overflow).
fn mul10_add96(lo64 : UInt64, hi : UInt, digit : UInt64) -> (UInt64, UInt, Bool) {
  let lo_part = (lo64 & 0xFFFFFFFFUL) * 10UL + digit
  let mid_part = (lo64 >> 32) * 10UL + (lo_part >> 32)
  let hi_part = hi.to_uint64() * 10UL + (mid_part >> 32)
  if hi_part > 0xFFFFFFFFUL {
    return (lo64, hi, true)
  }
  let nlo64 = (lo_part & 0xFFFFFFFFUL) | (mid_part << 32)
  (nlo64, hi_part.to_uint(), false)
}

///| Divide (2^96 + 4) / 10 when 96-bit value overflowed after +1 (i.e. 2^96 -> (2^96 + 4) / 10).
///| 2^96 = 79228162514264337593543950336, (2^96 + 4) / 10 = 7922816251426433759354395034
///| = 0x19999999_99999999_9999999A.
fn overflow96_div10() -> (UInt64, UInt) {
  (0x999999999999999AUL, 0x19999999U)
}

///| Core base-10 parser (iterative, O(1) stack, 64-bit fast path up to 18 digits).
fn parse_radix10_core(s : String, allow_round : Bool) -> Result[Decimal, DecimalError] {
  let n = s.length()
  if n == 0 {
    return Err(DecimalError::EmptyData)
  }
  let mut i = 0
  let mut negative = false
  let c0 = s.code_unit_at(0)
  if c0 == 45 {
    // '-'
    negative = true
    i = 1
  } else if c0 == 43 {
    // '+'
    i = 1
  }

  let mut has_digit = false
  let mut seen_dot = false
  let mut scale : Int = 0
  let mut lo64 : UInt64 = 0UL
  let mut hi : UInt = 0U
  let mut in_u64 = true

  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      let digit = (c - 48).to_int64().to_uint64()
      has_digit = true

      // Skip leading zeros in integer part cleanly
      if !seen_dot && lo64 == 0UL && hi == 0U && digit == 0UL {
        i = i + 1
        continue
      }

      if seen_dot && scale >= 28 {
        if !allow_round {
          return Err(DecimalError::Underflow)
        }
        // Round at this digit and validate remainder
        if digit >= 5UL {
          let (nlo, nhi, ov) = inc96(lo64, hi)
          if ov {
            if scale == 0 {
              return Err(DecimalError::Overflow)
            }
            let (rlo, rhi) = overflow96_div10()
            lo64 = rlo
            hi = rhi
            scale = scale - 1
          } else {
            lo64 = nlo
            hi = nhi
          }
        }
        // Validate remaining bytes
        i = i + 1
        while i < n {
          let rc = s.code_unit_at(i)
          if (rc >= 48 && rc <= 57) || rc == 95 {
            i = i + 1
          } else if rc == 46 {
            return Err(DecimalError::DuplicatedDecimalPoint)
          } else {
            return Err(DecimalError::InvalidCharacter)
          }
        }
        return Ok(make_decimal(lo64, hi, negative, scale.to_uint()))
      }

      if in_u64 && lo64 <= 1844674407370955160UL {
        lo64 = lo64 * 10UL + digit
        if seen_dot {
          scale = scale + 1
        }
        i = i + 1
      } else {
        in_u64 = false
        let (nlo, nhi, ov) = mul10_add96(lo64, hi, digit)
        if ov {
          if !seen_dot {
            return Err(DecimalError::Overflow)
          }
          if !allow_round {
            return Err(DecimalError::Underflow)
          }
          // Round at this digit
          if digit >= 5UL {
            let (ilo, ihi, iov) = inc96(lo64, hi)
            if iov {
              if scale == 0 {
                return Err(DecimalError::Overflow)
              }
              let (rlo, rhi) = overflow96_div10()
              lo64 = rlo
              hi = rhi
              scale = scale - 1
            } else {
              lo64 = ilo
              hi = ihi
            }
          }
          // Validate remaining bytes
          i = i + 1
          while i < n {
            let rc = s.code_unit_at(i)
            if (rc >= 48 && rc <= 57) || rc == 95 {
              i = i + 1
            } else if rc == 46 {
              return Err(DecimalError::DuplicatedDecimalPoint)
            } else {
              return Err(DecimalError::InvalidCharacter)
            }
          }
          return Ok(make_decimal(lo64, hi, negative, scale.to_uint()))
        }
        lo64 = nlo
        hi = nhi
        if seen_dot {
          scale = scale + 1
        }
        i = i + 1
      }
    } else if c == 46 {
      // '.'
      if seen_dot {
        return Err(DecimalError::DuplicatedDecimalPoint)
      }
      seen_dot = true
      i = i + 1
    } else if c == 95 {
      // '_'
      if !has_digit {
        return Err(DecimalError::InvalidLeadingChar)
      }
      i = i + 1
    } else {
      return Err(DecimalError::InvalidCharacter)
    }
  }

  if !has_digit {
    return Err(DecimalError::NoDigits)
  }
  Ok(make_decimal(lo64, hi, negative, scale.to_uint()))
}

///| Parse a decimal string (supports optional sign, `_` separators, rounding >28 dp, and scientific notation).
pub fn Decimal::from_str(s : String) -> Result[Decimal, DecimalError] {
  match parse_radix10_core(s, true) {
    Ok(d) => Ok(d)
    Err(e) => {
      // Check for scientific notation ('e' or 'E')
      let n = s.length()
      let mut i = 0
      while i < n {
        let c = s.code_unit_at(i)
        if c == 101 || c == 69 {
          return Decimal::from_scientific_lossy(s)
        }
        i = i + 1
      }
      Err(e)
    }
  }
}

///| Parse a base-10 decimal string without any precision loss (returns `Err(Underflow)` on excess digits).
pub fn Decimal::from_str_exact(s : String) -> Result[Decimal, DecimalError] {
  parse_radix10_core(s, false)
}

///| Parse unsigned exponent string with strict overflow protection (matches Rust u32::from_str semantics).
///| Returns Ok((val, overflowed_u32)) or Err(ScientificExpNotFound).
fn parse_exp_uint(s : String, start : Int, end : Int) -> Result[(UInt, Bool), DecimalError] {
  let mut i = start
  if i >= end {
    return Err(DecimalError::ScientificExpNotFound)
  }
  if s.code_unit_at(i) == 43 {
    // leading '+' allowed (Rust u32::from_str accepts "+123")
    i = i + 1
    if i >= end {
      return Err(DecimalError::ScientificExpNotFound)
    }
  }
  let mut acc : UInt64 = 0UL
  let mut overflowed = false
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return Err(DecimalError::ScientificExpNotFound)
    }
    if !overflowed {
      acc = acc * 10UL + (c - 48).to_int64().to_uint64()
      if acc > 0xFFFFFFFFUL {
        overflowed = true
      }
    }
    i = i + 1
  }
  if overflowed {
    Ok((0xFFFFFFFFU, true))
  } else {
    Ok((acc.to_uint(), false))
  }
}

///|
fn from_scientific_core(s : String, lossy : Bool) -> Result[Decimal, DecimalError] {
  let n = s.length()
  let mut e_pos = -1
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 101 || c == 69 {
      e_pos = i
      break
    }
    i = i + 1
  }
  if e_pos < 0 {
    return Err(DecimalError::ScientificExpNotFound)
  }
  if e_pos == 0 {
    return Err(DecimalError::ScientificBaseNotFound)
  }

  // Extract base substring
  let base_bytes = Bytes::new(e_pos)
  i = 0
  while i < e_pos {
    let cu = s.code_unit_at(i)
    if cu > 127 {
      return Err(DecimalError::InvalidCharacter)
    }
    base_bytes[i] = cu.to_byte()
    i = i + 1
  }
  let mut ret = match parse_radix10_core(base_bytes.to_string(), true) {
    Ok(d) => d
    Err(e) => return Err(e)
  }

  let current_scale = ret.scale()
  let exp_start = e_pos + 1
  if exp_start >= n {
    return Err(DecimalError::ScientificExpNotFound)
  }

  if s.code_unit_at(exp_start) == 45 {
    // negative exponent
    let (exp, ov) = match parse_exp_uint(s, exp_start + 1, n) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if ov || exp > MAX_SCALE {
      return Err(DecimalError::ScaleExceedsMaximumPrecision(exp))
    }
    let total_scale = current_scale + exp
    if total_scale > MAX_SCALE {
      if lossy {
        let rescaled = ret.rescale(MAX_SCALE - exp)
        match rescaled.set_scale(MAX_SCALE) {
          Ok(d) => Ok(d)
          Err(e) => Err(e)
        }
      } else {
        Err(DecimalError::ScaleExceedsMaximumPrecision(total_scale))
      }
    } else {
      ret.set_scale(total_scale)
    }
  } else {
    // non-negative exponent
    let (exp, ov) = match parse_exp_uint(s, exp_start, n) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if ov {
      return Err(DecimalError::ScaleExceedsMaximumPrecision(exp))
    }
    if exp <= current_scale {
      ret.set_scale(current_scale - exp)
    } else if exp > 0U {
      if exp > MAX_SCALE {
        return Err(DecimalError::ScaleExceedsMaximumPrecision(exp))
      }
      let mut rem = exp.to_int()
      while rem > 0 {
        let step = if rem >= 19 { 19 } else { rem }
        let pow = Decimal::from_u64(POWERS_10_U64[step])
        match ret.checked_mul(pow) {
          Ok(r) => ret = r
          Err(_) => return Err(DecimalError::Overflow)
        }
        rem = rem - step
      }
      Ok(ret.normalize())
    } else {
      Ok(ret)
    }
  }
}

///| Parse scientific notation strictly (without rounding negative exponents past scale 28).
pub fn Decimal::from_scientific(s : String) -> Result[Decimal, DecimalError] {
  from_scientific_core(s, false)
}

///| Parse scientific notation, rounding negative exponents that exceed scale 28 when |exp| <= 28.
pub fn Decimal::from_scientific_lossy(s : String) -> Result[Decimal, DecimalError] {
  from_scientific_core(s, true)
}

///| Parse a string in radix 2..=36.
pub fn Decimal::from_str_radix(s : String, radix : UInt) -> Result[Decimal, DecimalError] {
  if radix == 10U {
    return parse_radix10_core(s, true)
  }
  if s.length() == 0 {
    return Err(DecimalError::EmptyData)
  }
  if radix < 2U || radix > 36U {
    return Err(DecimalError::UnsupportedRadix)
  }
  let n = s.length()
  let mut i = 0
  let mut negative = false
  let c0 = s.code_unit_at(0)
  if c0 == 45 {
    negative = true
    i = 1
  } else if c0 == 43 {
    i = 1
  }

  let mut saw_digit = false
  let mut seen_dot = false
  let mut scale : UInt = 0U
  let d : FixedArray[UInt] = [0U, 0U, 0U]

  while i < n {
    let c = s.code_unit_at(i)
    if c == 95 {
      if !saw_digit {
        return Err(DecimalError::InvalidLeadingChar)
      }
      i = i + 1
      continue
    }
    if c == 46 {
      if seen_dot {
        return Err(DecimalError::DuplicatedDecimalPoint)
      }
      seen_dot = true
      i = i + 1
      continue
    }
    let dv : UInt = if c >= 48 && c <= 57 {
      (c - 48).to_uint()
    } else if c >= 97 && c <= 122 {
      (c - 87).to_uint()
    } else if c >= 65 && c <= 90 {
      (c - 55).to_uint()
    } else {
      return Err(DecimalError::InvalidCharacter)
    }
    if dv >= radix {
      return Err(DecimalError::InvalidCharacter)
    }
    saw_digit = true
    if !seen_dot && d[0] == 0U && d[1] == 0U && d[2] == 0U && dv == 0U {
      i = i + 1
      continue
    }
    if seen_dot {
      scale = scale + 1U
      if scale > MAX_SCALE {
        return Err(DecimalError::ScaleExceedsMaximumPrecision(scale))
      }
    }
    let ov1 = u96_mul_u32(d, radix)
    if ov1 != 0U {
      return Err(DecimalError::Overflow)
    }
    let ov2 = u96_add_u32(d, dv)
    if ov2 != 0U {
      return Err(DecimalError::Overflow)
    }
    i = i + 1
  }

  if !saw_digit {
    return Err(DecimalError::NoDigits)
  }
  let lo64 = d[0].to_uint64() | (d[1].to_uint64() << 32)
  Ok(make_decimal(lo64, d[2], negative, scale))
}
