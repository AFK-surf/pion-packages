///| Iterative, O(1)-stack, 64-bit-fast-path parser for `Decimal`.

///| Stack-allocated 96-bit arithmetic result with overflow flag (zero heap allocation).
val struct U96Ov {
  lo64 : UInt64
  hi : UInt
  ov : Bool
}

///| Add 1 to 96-bit (lo64, hi) returning stack `U96Ov` (zero heap allocation).
fn inc96_val(lo64 : UInt64, hi : UInt) -> U96Ov {
  let nlo = lo64 + 1UL
  if nlo != 0UL {
    return U96Ov::{ lo64: nlo, hi, ov: false }
  }
  let nhi = hi + 1U
  if nhi != 0U {
    return U96Ov::{ lo64: 0UL, hi: nhi, ov: false }
  }
  U96Ov::{ lo64: 0UL, hi: 0U, ov: true }
}

///| Multiply 96-bit (lo64, hi) by 10 and add digit (0..9) returning stack `U96Ov` (zero heap allocation).
fn mul10_add96_val(lo64 : UInt64, hi : UInt, digit : UInt64) -> U96Ov {
  let lo_part = (lo64 & 0xFFFFFFFFUL) * 10UL + digit
  let mid_part = (lo64 >> 32) * 10UL + (lo_part >> 32)
  let hi_part = hi.to_uint64() * 10UL + (mid_part >> 32)
  if hi_part > 0xFFFFFFFFUL {
    return U96Ov::{ lo64, hi, ov: true }
  }
  let nlo64 = (lo_part & 0xFFFFFFFFUL) | (mid_part << 32)
  U96Ov::{ lo64: nlo64, hi: hi_part.to_uint(), ov: false }
}

///| Add 1 to 96-bit (lo64, hi); returns (lo64, hi, overflow).
#verify
fn inc96(lo64 : UInt64, hi : UInt) -> (UInt64, UInt, Bool) {
  let nlo = lo64 + 1UL
  if nlo != 0UL {
    return (nlo, hi, false)
  }
  let nhi = hi + 1U
  if nhi != 0U {
    return (0UL, nhi, false)
  }
  (0UL, 0U, true)
}

///| Multiply 96-bit (lo64, hi) by 10 and add digit (0..9); returns (lo64, hi, overflow).
#verify
fn mul10_add96(lo64 : UInt64, hi : UInt, digit : UInt64) -> (UInt64, UInt, Bool) {
  let lo_part = (lo64 & 0xFFFFFFFFUL) * 10UL + digit
  let mid_part = (lo64 >> 32) * 10UL + (lo_part >> 32)
  let hi_part = hi.to_uint64() * 10UL + (mid_part >> 32)
  if hi_part > 0xFFFFFFFFUL {
    return (lo64, hi, true)
  }
  let nlo64 = (lo_part & 0xFFFFFFFFUL) | (mid_part << 32)
  (nlo64, hi_part.to_uint(), false)
}

///| Divide (2^96 + 4) / 10 when 96-bit value overflowed after +1 (i.e. 2^96 -> (2^96 + 4) / 10).
///| 2^96 = 79228162514264337593543950336, (2^96 + 4) / 10 = 7922816251426433759354395034
///| = 0x19999999_99999999_9999999A.
fn overflow96_div10() -> (UInt64, UInt) {
  (0x999999999999999AUL, 0x19999999U)
}

///| Slow path for base-10 strings > 18 chars (96-bit mantissa, leading zeros, >28dp rounding).
fn parse_radix10_slow(
  s : String,
  start_i : Int,
  end : Int,
  negative : Bool,
  allow_round : Bool,
) -> Result[Decimal, DecimalError] {
  let mut i = start_i
  let mut has_digit = false
  let mut seen_dot = false
  let mut scale : Int = 0
  let mut lo64 : UInt64 = 0UL
  let mut hi : UInt = 0U
  let mut in_u64 = true

  while i < end {
    let c = s.code_unit_at(i)
    let d_u32 = (c - 48).to_uint()
    if d_u32 < 10U {
      let digit = d_u32.to_uint64()
      has_digit = true

      // Skip leading zeros in integer part cleanly
      if !seen_dot && lo64 == 0UL && hi == 0U && digit == 0UL {
        i = i + 1
        continue
      }

      if seen_dot && scale >= 28 {
        if !allow_round {
          return Err(DecimalError::Underflow)
        }
        // Round at this digit and validate remainder
        if digit >= 5UL {
          let nlo = lo64 + 1UL
          if nlo != 0UL {
            lo64 = nlo
          } else {
            let nhi = hi + 1U
            if nhi != 0U {
              lo64 = 0UL
              hi = nhi
            } else {
              if scale == 0 {
                return Err(DecimalError::Overflow)
              }
              lo64 = 0x999999999999999AUL
              hi = 0x19999999U
              scale = scale - 1
            }
          }
        }
        // Validate remaining bytes
        i = i + 1
        while i < end {
          let rc = s.code_unit_at(i)
          if (rc - 48).to_uint() < 10U || rc == 95 {
            i = i + 1
          } else if rc == 46 {
            return Err(DecimalError::DuplicatedDecimalPoint)
          } else {
            return Err(DecimalError::InvalidCharacter)
          }
        }
        return Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale.to_uint()))
      }

      if in_u64 && lo64 <= 1844674407370955160UL {
        lo64 = lo64 * 10UL + digit
        if seen_dot {
          scale = scale + 1
        }
        i = i + 1
      } else {
        in_u64 = false
        let lo_part = (lo64 & 0xFFFFFFFFUL) * 10UL + digit
        let mid_part = (lo64 >> 32) * 10UL + (lo_part >> 32)
        let hi_part = hi.to_uint64() * 10UL + (mid_part >> 32)
        if hi_part > 0xFFFFFFFFUL {
          if !seen_dot {
            return Err(DecimalError::Overflow)
          }
          if !allow_round {
            return Err(DecimalError::Underflow)
          }
          // Round at this digit
          if digit >= 5UL {
            let nlo = lo64 + 1UL
            if nlo != 0UL {
              lo64 = nlo
            } else {
              let nhi = hi + 1U
              if nhi != 0U {
                lo64 = 0UL
                hi = nhi
              } else {
                if scale == 0 {
                  return Err(DecimalError::Overflow)
                }
                lo64 = 0x999999999999999AUL
                hi = 0x19999999U
                scale = scale - 1
              }
            }
          }
          // Validate remaining bytes
          i = i + 1
          while i < end {
            let rc = s.code_unit_at(i)
            if (rc - 48).to_uint() < 10U || rc == 95 {
              i = i + 1
            } else if rc == 46 {
              return Err(DecimalError::DuplicatedDecimalPoint)
            } else {
              return Err(DecimalError::InvalidCharacter)
            }
          }
          return Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale.to_uint()))
        }
        lo64 = (lo_part & 0xFFFFFFFFUL) | (mid_part << 32)
        hi = hi_part.to_uint()
        if seen_dot {
          scale = scale + 1
        }
        i = i + 1
      }
    } else if c == 46 {
      // '.'
      if seen_dot {
        return Err(DecimalError::DuplicatedDecimalPoint)
      }
      seen_dot = true
      i = i + 1
    } else if c == 95 {
      // '_'
      if !has_digit {
        return Err(DecimalError::InvalidLeadingChar)
      }
      i = i + 1
    } else {
      return Err(DecimalError::InvalidCharacter)
    }
  }

  if !has_digit {
    return Err(DecimalError::NoDigits)
  }
  Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale.to_uint()))
}

///| Core base-10 parser over `s[start..end)` (iterative, O(1) stack, compact 18-char UInt64 fast path).
fn parse_radix10_slice(s : String, start : Int, end : Int, allow_round : Bool) -> Result[Decimal, DecimalError] {
  if start >= end {
    return Err(DecimalError::EmptyData)
  }
  let mut i = start
  let mut negative = false
  let c0 = s.code_unit_at(i)
  if c0 == 45 {
    // '-'
    negative = true
    i = i + 1
  } else if c0 == 43 {
    // '+'
    i = i + 1
  }

  // Fast path: <= 18 remaining characters (<= 18 digits, guaranteed to fit in UInt64 with scale <= 18 < 28)
  if end - i > 18 {
    return parse_radix10_slow(s, i, end, negative, allow_round)
  }
  let mut lo64 : UInt64 = 0UL
  let mut has_digit = false
  let mut dot_pos = -1
  let mut under_after_dot = 0
  while i < end {
    let c = s.code_unit_at(i)
    let d = (c - 48).to_uint()
    if d < 10U {
      lo64 = lo64 * 10UL + d.to_uint64()
      has_digit = true
    } else if c == 46 {
      if dot_pos >= 0 {
        return Err(DecimalError::DuplicatedDecimalPoint)
      }
      dot_pos = i
    } else if c == 95 {
      if !has_digit {
        return Err(DecimalError::InvalidLeadingChar)
      }
      if dot_pos >= 0 {
        under_after_dot = under_after_dot + 1
      }
    } else {
      return Err(DecimalError::InvalidCharacter)
    }
    i = i + 1
  }
  if !has_digit {
    return Err(DecimalError::NoDigits)
  }
  let scale = if dot_pos >= 0 { (end - dot_pos - 1 - under_after_dot).to_uint() } else { 0U }
  Ok(make_decimal_nonzero_sign(lo64, 0U, negative, scale))
}

///| Parse a base-10 decimal string (supports optional sign, `_` separators, and rounding >28 dp; rejects `e`/`E` like `rust_decimal`).
pub fn Decimal::from_str(s : String) -> Result[Decimal, DecimalError] {
  parse_radix10_slice(s, 0, s.length(), true)
}

///| Parse a base-10 decimal string without any precision loss (returns `Err(Underflow)` on excess digits).
pub fn Decimal::from_str_exact(s : String) -> Result[Decimal, DecimalError] {
  parse_radix10_slice(s, 0, s.length(), false)
}

///| Parse unsigned exponent string with strict overflow protection (matches Rust u32::from_str semantics).
///| Returns >= 0L for exact UInt value, -1L for ScientificExpNotFound, -2L for UInt overflow.
fn parse_exp_uint_i64(s : String, start : Int, end : Int) -> Int64 {
  let mut i = start
  if i >= end {
    return -1L
  }
  if s.code_unit_at(i) == 43 {
    // leading '+' allowed (Rust u32::from_str accepts "+123")
    i = i + 1
    if i >= end {
      return -1L
    }
  }
  let mut acc : UInt64 = 0UL
  let mut overflowed = false
  while i < end {
    let c = s.code_unit_at(i)
    let d = (c - 48).to_uint()
    if d >= 10U {
      return -1L
    }
    if !overflowed {
      acc = acc * 10UL + d.to_uint64()
      if acc > 0xFFFFFFFFUL {
        overflowed = true
      }
    }
    i = i + 1
  }
  if overflowed {
    -2L
  } else {
    acc.to_int64()
  }
}

///|
fn from_scientific_core(s : String, lossy : Bool) -> Result[Decimal, DecimalError] {
  let n = s.length()
  let mut e_pos = -1
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 101 || c == 69 {
      e_pos = i
      break
    }
    i = i + 1
  }
  if e_pos < 0 {
    return Err(DecimalError::ScientificExpNotFound)
  }
  if e_pos == 0 {
    return Err(DecimalError::ScientificBaseNotFound)
  }

  // Scalar fast path for base mantissa when <= 18 chars after sign (avoids intermediate Result[Decimal, _] alloc)
  let mut base_lo64 : UInt64 = 0UL
  let mut base_hi : UInt = 0U
  let mut base_neg = false
  let mut current_scale : UInt = 0U
  let mut mi = 0
  let mc0 = s.code_unit_at(0)
  if mc0 == 45 {
    base_neg = true
    mi = 1
  } else if mc0 == 43 {
    mi = 1
  }
  if e_pos - mi <= 18 {
    let mut has_digit = false
    let mut dot_pos = -1
    let mut under_after_dot = 0
    while mi < e_pos {
      let c = s.code_unit_at(mi)
      let d = (c - 48).to_uint()
      if d < 10U {
        base_lo64 = base_lo64 * 10UL + d.to_uint64()
        has_digit = true
      } else if c == 46 {
        if dot_pos >= 0 {
          return Err(DecimalError::DuplicatedDecimalPoint)
        }
        dot_pos = mi
      } else if c == 95 {
        if !has_digit {
          return Err(DecimalError::InvalidLeadingChar)
        }
        if dot_pos >= 0 {
          under_after_dot = under_after_dot + 1
        }
      } else {
        return Err(DecimalError::InvalidCharacter)
      }
      mi = mi + 1
    }
    if !has_digit {
      return Err(DecimalError::NoDigits)
    }
    current_scale = if dot_pos >= 0 { (e_pos - dot_pos - 1 - under_after_dot).to_uint() } else { 0U }
  } else {
    let ret = match parse_radix10_slow(s, mi, e_pos, base_neg, true) {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    base_lo64 = ret.lo64
    base_hi = ret.hi
    base_neg = ret.is_sign_negative()
    current_scale = ret.scale()
  }

  let exp_start = e_pos + 1
  if exp_start >= n {
    return Err(DecimalError::ScientificExpNotFound)
  }

  if s.code_unit_at(exp_start) == 45 {
    // negative exponent
    let raw = parse_exp_uint_i64(s, exp_start + 1, n)
    if raw == -1L {
      return Err(DecimalError::ScientificExpNotFound)
    }
    if raw == -2L {
      return Err(DecimalError::ScaleExceedsMaximumPrecision(0xFFFFFFFFU))
    }
    let exp = raw.to_uint64().to_uint()
    if exp > MAX_SCALE {
      return Err(DecimalError::ScaleExceedsMaximumPrecision(exp))
    }
    let total_scale = current_scale + exp
    if total_scale > MAX_SCALE {
      if lossy {
        let tmp_dec = make_decimal_nonzero_sign(base_lo64, base_hi, base_neg, current_scale)
        let rescaled = tmp_dec.rescale(MAX_SCALE - exp)
        Ok(make_decimal_nonzero_sign(rescaled.lo64, rescaled.hi, rescaled.is_sign_negative(), MAX_SCALE))
      } else {
        Err(DecimalError::ScaleExceedsMaximumPrecision(total_scale))
      }
    } else {
      Ok(make_decimal_nonzero_sign(base_lo64, base_hi, base_neg, total_scale))
    }
  } else {
    // non-negative exponent
    let raw = parse_exp_uint_i64(s, exp_start, n)
    if raw == -1L {
      return Err(DecimalError::ScientificExpNotFound)
    }
    if raw == -2L {
      return Err(DecimalError::ScaleExceedsMaximumPrecision(0xFFFFFFFFU))
    }
    let exp = raw.to_uint64().to_uint()
    if exp <= current_scale {
      Ok(make_decimal_nonzero_sign(base_lo64, base_hi, base_neg, current_scale - exp))
    } else {
      if exp > MAX_SCALE {
        return Err(DecimalError::ScaleExceedsMaximumPrecision(exp))
      }
      if base_lo64 == 0UL && base_hi == 0U {
        return Ok(ZERO)
      }
      // Multiply 96-bit mantissa by 10^(exp - current_scale) directly in scalars (scale becomes 0)
      let mut lo64 = base_lo64
      let mut hi = base_hi
      let mut rem = (exp - current_scale).to_int()
      while rem > 0 {
        let step = if rem >= 9 { 9 } else { rem }
        let pow = pow10_u32(step).to_uint64()
        let t_lo = (lo64 & 0xFFFFFFFFUL) * pow
        let t_mid = (lo64 >> 32) * pow + (t_lo >> 32)
        let t_hi = hi.to_uint64() * pow + (t_mid >> 32)
        if t_hi > 0xFFFFFFFFUL {
          return Err(DecimalError::Overflow)
        }
        lo64 = (t_lo & 0xFFFFFFFFUL) | (t_mid << 32)
        hi = t_hi.to_uint()
        rem = rem - step
      }
      Ok(make_decimal(lo64, hi, base_neg, 0U))
    }
  }
}

///| Parse scientific notation strictly (without rounding negative exponents past scale 28).
pub fn Decimal::from_scientific(s : String) -> Result[Decimal, DecimalError] {
  from_scientific_core(s, false)
}

///| Parse scientific notation, rounding negative exponents that exceed scale 28 when |exp| <= 28.
pub fn Decimal::from_scientific_lossy(s : String) -> Result[Decimal, DecimalError] {
  from_scientific_core(s, true)
}

///| Multiply 96-bit (lo64, hi) by radix and add digit returning stack `U96Ov` (zero heap allocation).
fn mul_radix_add96_val(lo64 : UInt64, hi : UInt, radix : UInt64, digit : UInt64) -> U96Ov {
  let lo_part = (lo64 & 0xFFFFFFFFUL) * radix + digit
  let mid_part = (lo64 >> 32) * radix + (lo_part >> 32)
  let hi_part = hi.to_uint64() * radix + (mid_part >> 32)
  if hi_part > 0xFFFFFFFFUL {
    return U96Ov::{ lo64, hi, ov: true }
  }
  let nlo64 = (lo_part & 0xFFFFFFFFUL) | (mid_part << 32)
  U96Ov::{ lo64: nlo64, hi: hi_part.to_uint(), ov: false }
}

///| Decode a single digit character for radix 2..=36; returns -1 if invalid.
fn decode_radix_digit(c : Int, radix : UInt) -> Int {
  let dv : Int = if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 122 {
    c - 87
  } else if c >= 65 && c <= 90 {
    c - 55
  } else {
    -1
  }
  if dv >= 0 && dv.to_uint() < radix {
    dv
  } else {
    -1
  }
}

///| Parse a string in radix 2..=36.
pub fn Decimal::from_str_radix(s : String, radix : UInt) -> Result[Decimal, DecimalError] {
  if radix == 10U {
    return parse_radix10_slice(s, 0, s.length(), true)
  }
  if s.length() == 0 {
    return Err(DecimalError::EmptyData)
  }
  if radix < 2U || radix > 36U {
    return Err(DecimalError::UnsupportedRadix)
  }
  let n = s.length()
  let mut i = 0
  let mut negative = false
  let c0 = s.code_unit_at(0)
  if c0 == 45 {
    negative = true
    i = 1
  } else if c0 == 43 {
    i = 1
  }

  let mut saw_digit = false
  let mut seen_dot = false
  let mut scale : UInt = 0U
  let mut lo64 : UInt64 = 0UL
  let mut hi : UInt = 0U
  let radix64 = radix.to_uint64()

  while i < n {
    let c = s.code_unit_at(i)
    if c == 95 {
      if !saw_digit {
        return Err(DecimalError::InvalidLeadingChar)
      }
      i = i + 1
      continue
    }
    if c == 46 {
      if seen_dot {
        return Err(DecimalError::DuplicatedDecimalPoint)
      }
      seen_dot = true
      i = i + 1
      continue
    }
    let dv_int = decode_radix_digit(c, radix)
    if dv_int < 0 {
      return Err(DecimalError::InvalidCharacter)
    }
    let dv = dv_int.to_uint()
    saw_digit = true
    if !seen_dot && lo64 == 0UL && hi == 0U && dv == 0U {
      i = i + 1
      continue
    }
    if seen_dot && scale >= MAX_SCALE {
      if dv >= 5U {
        let ir = inc96_val(lo64, hi)
        if ir.ov {
          return Err(DecimalError::Overflow)
        }
        lo64 = ir.lo64
        hi = ir.hi
      }
      i = i + 1
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 95 || decode_radix_digit(rc, radix) >= 0 {
          i = i + 1
        } else if rc == 46 {
          return Err(DecimalError::DuplicatedDecimalPoint)
        } else {
          return Err(DecimalError::InvalidCharacter)
        }
      }
      return Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale))
    }
    let mr = mul_radix_add96_val(lo64, hi, radix64, dv.to_uint64())
    if mr.ov {
      if !seen_dot {
        return Err(DecimalError::Overflow)
      }
      // Fractional digit overflowed 96 bits: round at this digit (matching rust_decimal) and validate remainder
      if dv >= 5U {
        let ir = inc96_val(lo64, hi)
        if ir.ov {
          return Err(DecimalError::Overflow)
        }
        lo64 = ir.lo64
        hi = ir.hi
      }
      i = i + 1
      while i < n {
        let rc = s.code_unit_at(i)
        if rc == 95 || decode_radix_digit(rc, radix) >= 0 {
          i = i + 1
        } else if rc == 46 {
          return Err(DecimalError::DuplicatedDecimalPoint)
        } else {
          return Err(DecimalError::InvalidCharacter)
        }
      }
      return Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale))
    }
    lo64 = mr.lo64
    hi = mr.hi
    if seen_dot {
      scale = scale + 1U
    }
    i = i + 1
  }

  if !saw_digit {
    return Err(DecimalError::NoDigits)
  }
  Ok(make_decimal_nonzero_sign(lo64, hi, negative, scale))
}
