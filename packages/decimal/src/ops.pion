///| Exact 96/128/192-bit checked arithmetic for `Decimal`: add, sub, mul, div, rem.

///|
pub fn Decimal::neg(self : Decimal) -> Decimal {
  if self.lo64 == 0UL && self.hi == 0U {
    return Decimal::{ lo64: 0UL, hi: 0U, flags: self.flags ^ SIGN_MASK }
  }
  Decimal::{ lo64: self.lo64, hi: self.hi, flags: self.flags ^ SIGN_MASK }
}

///|
pub fn Decimal::abs(self : Decimal) -> Decimal {
  Decimal::{ lo64: self.lo64, hi: self.hi, flags: self.flags & 0x7FFFFFFFU }
}

// === Addition & Subtraction ===

///| Reduce scale by 1 when a 96-bit addition overflowed (implicit 2^96 bit set).
///| Returns (new_lo64, new_hi, new_scale).
fn reduce_scale_overflow96(lo64_in : UInt64, hi_in : UInt, scale : UInt) -> (UInt64, UInt, UInt) {
  let mut num = hi_in.to_uint64() + (1UL << 32)
  let mut hi = (num / 10UL).to_uint()
  num = ((num - hi.to_uint64() * 10UL) << 32) + (lo64_in >> 32)
  let mut div = (num / 10UL).to_uint()
  num = ((num - div.to_uint64() * 10UL) << 32) + (lo64_in & 0xFFFFFFFFUL)
  let mut lo64 = div.to_uint64() << 32
  div = (num / 10UL).to_uint()
  lo64 = lo64 + div.to_uint64()
  let rem = num.to_uint() - div * 10U
  if rem >= 5U && (rem > 5U || (lo64 & 1UL) != 0UL) {
    lo64 = lo64 + 1UL
    if lo64 == 0UL {
      hi = hi + 1U
    }
  }
  (lo64, hi, scale - 1U)
}

///| Aligned 96-bit add/sub where both operands share `scale`.
fn aligned_add_96(
  a_lo : UInt64,
  a_hi : UInt,
  b_lo : UInt64,
  b_hi : UInt,
  negative : Bool,
  scale : UInt,
  subtract : Bool,
) -> Result[Decimal, DecimalError] {
  if subtract {
    // Compare a vs b
    let a_ge_b = if a_hi != b_hi { a_hi > b_hi } else { a_lo >= b_lo }
    if a_ge_b {
      let borrow = if a_lo < b_lo { 1U } else { 0U }
      let lo = a_lo - b_lo
      let hi = a_hi - b_hi - borrow
      Ok(make_decimal_nonzero_sign(lo, hi, negative, scale))
    } else {
      let borrow = if b_lo < a_lo { 1U } else { 0U }
      let lo = b_lo - a_lo
      let hi = b_hi - a_hi - borrow
      Ok(make_decimal_nonzero_sign(lo, hi, !negative, scale))
    }
  } else {
    let lo = a_lo + b_lo
    let carry = if lo < a_lo { 1UL } else { 0UL }
    let hi64 = a_hi.to_uint64() + b_hi.to_uint64() + carry
    if hi64 > 0xFFFFFFFFUL {
      if scale == 0U {
        return Err(DecimalError::Overflow)
      }
      let (rlo, rhi, rscale) = reduce_scale_overflow96(lo, hi64.to_uint(), scale)
      Ok(make_decimal_nonzero_sign(rlo, rhi, negative, rscale))
    } else {
      Ok(make_decimal_nonzero_sign(lo, hi64.to_uint(), negative, scale))
    }
  }
}

///| Unaligned add/sub where `lhs` has smaller scale than `rhs` by `diff` (> 0).
fn unaligned_add_96(
  lhs_lo_in : UInt64,
  lhs_hi_in : UInt,
  rhs_lo : UInt64,
  rhs_hi : UInt,
  negative : Bool,
  scale : UInt,
  diff_in : Int,
  subtract : Bool,
) -> Result[Decimal, DecimalError] {
  let mut lo64 = lhs_lo_in
  let mut hi = lhs_hi_in
  let mut diff = diff_in
  let mut tmp64 : UInt64 = 0UL
  let mut overflowed = false

  while diff > 0 {
    let step = if diff <= 9 { diff } else { 9 }
    let power = POWERS_10[step].to_uint64()
    let t_lo = (lo64 & 0xFFFFFFFFUL) * power
    let t_mid = (lo64 >> 32) * power + (t_lo >> 32)
    lo64 = (t_lo & 0xFFFFFFFFUL) | (t_mid << 32)
    tmp64 = (t_mid >> 32) + hi.to_uint64() * power
    diff = diff - step
    if tmp64 > 0xFFFFFFFFUL {
      overflowed = true
      break
    }
    hi = tmp64.to_uint()
  }

  if !overflowed {
    return aligned_add_96(lo64, hi, rhs_lo, rhs_hi, negative, scale, subtract)
  }

  // Promote to 192-bit buffer (6 x UInt)
  let buf : FixedArray[UInt] = [
    lo64.to_uint(),
    (lo64 >> 32).to_uint(),
    tmp64.to_uint(),
    (tmp64 >> 32).to_uint(),
    0U,
    0U,
  ]
  let mut upper = u192_upper_word(buf)
  while diff > 0 {
    let step = if diff <= 9 { diff } else { 9 }
    let power = POWERS_10[step].to_uint64()
    let mut carry : UInt64 = 0UL
    let mut idx = 0
    while idx <= upper {
      carry = carry + buf[idx].to_uint64() * power
      buf[idx] = carry.to_uint()
      carry = carry >> 32
      idx = idx + 1
    }
    if carry != 0UL {
      upper = upper + 1
      buf[upper] = carry.to_uint()
    }
    diff = diff - step
  }

  // Add or subtract rhs (96-bit) against buf (> 96-bit, so buf > rhs always!)
  let buf_lo64 = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
  let buf_w2 = buf[2]
  if subtract {
    let res_lo = buf_lo64 - rhs_lo
    let b1 = if buf_lo64 < rhs_lo { 1U } else { 0U }
    let res_w2 = buf_w2 - rhs_hi - b1
    let borrow = if b1 != 0U { res_w2 >= buf_w2 } else { res_w2 > buf_w2 }
    buf[0] = res_lo.to_uint()
    buf[1] = (res_lo >> 32).to_uint()
    buf[2] = res_w2
    if borrow {
      let mut idx = 3
      while idx < 6 {
        buf[idx] = buf[idx] - 1U
        if buf[idx] != 0xFFFFFFFFU {
          break
        }
        idx = idx + 1
      }
    }
    upper = u192_upper_word(buf)
    if upper <= 2 {
      let nlo = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
      return Ok(make_decimal_nonzero_sign(nlo, buf[2], negative, scale))
    }
  } else {
    let res_lo = buf_lo64 + rhs_lo
    let c1 = if res_lo < buf_lo64 { 1UL } else { 0UL }
    let w2_sum = buf_w2.to_uint64() + rhs_hi.to_uint64() + c1
    buf[0] = res_lo.to_uint()
    buf[1] = (res_lo >> 32).to_uint()
    buf[2] = w2_sum.to_uint()
    if w2_sum > 0xFFFFFFFFUL {
      let mut idx = 3
      while idx < 6 {
        if upper < idx {
          buf[idx] = 1U
          upper = idx
          break
        }
        buf[idx] = buf[idx] + 1U
        if buf[idx] != 0U {
          break
        }
        idx = idx + 1
      }
    }
  }

  match u192_rescale(buf, upper, scale.to_int()) {
    Some(new_scale) => {
      let nlo = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
      Ok(make_decimal_nonzero_sign(nlo, buf[2], negative, new_scale))
    }
    None => Err(DecimalError::Overflow)
  }
}

///|
fn add_sub_core(d1 : Decimal, d2 : Decimal, subtract : Bool) -> Result[Decimal, DecimalError] {
  // Zero handling matching rust_decimal::ops::add::add_sub_internal
  if d1.is_zero() {
    if subtract && !d2.is_zero() {
      return Ok(Decimal::{ lo64: d2.lo64, hi: d2.hi, flags: d2.flags ^ SIGN_MASK })
    }
    return Ok(d2)
  }
  if d2.is_zero() {
    return Ok(d1)
  }

  let xor_flags = d1.flags ^ d2.flags
  let eff_sub = subtract != ((xor_flags & SIGN_MASK) != 0U)
  let same_scale = (xor_flags & SCALE_MASK) == 0U

  // Fast path 1: both fit in 64 bits and same scale
  if d1.hi == 0U && d2.hi == 0U {
    let m1 = d1.lo64
    let m2 = d2.lo64

    if same_scale {
      let neg1 = d1.is_sign_negative()
      let scale = d1.scale()
      if eff_sub {
        if m1 >= m2 {
          return Ok(make_decimal_nonzero_sign(m1 - m2, 0U, neg1, scale))
        } else {
          return Ok(make_decimal_nonzero_sign(m2 - m1, 0U, !neg1, scale))
        }
      } else {
        let sum = m1 + m2
        let carry : UInt = if sum < m1 { 1U } else { 0U }
        return Ok(make_decimal(sum, carry, neg1, scale))
      }
    }

    // Fast path 2: both 64-bit, diff <= 19, widen in 128-bit
    let s1 = d1.scale().to_int()
    let s2 = d2.scale().to_int()
    let diff = if s1 > s2 { s1 - s2 } else { s2 - s1 }
    if diff <= 19 {
      let pow = POWERS_10_U64[diff]
      let (a_lo, a_hi, b_lo, b_hi, scale) = if s1 > s2 {
        let (bl, bh) = u64_mul_wide(m2, pow)
        (m1, 0UL, bl, bh, s1.to_uint())
      } else {
        let (al, ah) = u64_mul_wide(m1, pow)
        (al, ah, m2, 0UL, s2.to_uint())
      }
      let neg1 = d1.is_sign_negative()
      let (r_lo, r_hi, r_neg) = if eff_sub {
        let a_ge_b = if a_hi != b_hi { a_hi > b_hi } else { a_lo >= b_lo }
        if a_ge_b {
          let bw = if a_lo < b_lo { 1UL } else { 0UL }
          (a_lo - b_lo, a_hi - b_hi - bw, neg1)
        } else {
          let bw = if b_lo < a_lo { 1UL } else { 0UL }
          (b_lo - a_lo, b_hi - a_hi - bw, !neg1)
        }
      } else {
        let sl = a_lo + b_lo
        let c = if sl < a_lo { 1UL } else { 0UL }
        (sl, a_hi + b_hi + c, neg1)
      }
      if r_hi <= 0xFFFFFFFFUL {
        return Ok(make_decimal_nonzero_sign(r_lo, r_hi.to_uint(), r_neg, scale))
      }
    }
  }

  let neg1 = d1.is_sign_negative()
  if same_scale {
    return aligned_add_96(d1.lo64, d1.hi, d2.lo64, d2.hi, neg1, d1.scale(), eff_sub)
  }
  let s1 = d1.scale().to_int()
  let s2 = d2.scale().to_int()
  if s2 < s1 {
    let neg = eff_sub != neg1
    unaligned_add_96(d2.lo64, d2.hi, d1.lo64, d1.hi, neg, d1.scale(), s1 - s2, eff_sub)
  } else {
    unaligned_add_96(d1.lo64, d1.hi, d2.lo64, d2.hi, neg1, d2.scale(), s2 - s1, eff_sub)
  }
}

///|
pub fn Decimal::checked_add(self : Decimal, other : Decimal) -> Result[Decimal, DecimalError] {
  add_sub_core(self, other, false)
}

///|
pub fn Decimal::checked_sub(self : Decimal, other : Decimal) -> Result[Decimal, DecimalError] {
  add_sub_core(self, other, true)
}

// === Multiplication ===

///| Zero-allocation scalar 192-bit rescale + banker's rounding for `checked_mul`.
fn finish_mul_192_scalar(
  w0_in : UInt,
  w1_in : UInt,
  w2_in : UInt,
  w3_in : UInt,
  w4_in : UInt,
  w5_in : UInt,
  negative : Bool,
  scale_in : UInt,
) -> Result[Decimal, DecimalError] {
  let mut w0 = w0_in
  let mut w1 = w1_in
  let mut w2 = w2_in
  let mut w3 = w3_in
  let mut w4 = w4_in
  let mut w5 = w5_in
  let mut upper = if w5 != 0U {
    5
  } else if w4 != 0U {
    4
  } else if w3 != 0U {
    3
  } else if w2 != 0U {
    2
  } else if w1 != 0U {
    1
  } else {
    0
  }
  let mut scale = scale_in.to_int()
  if upper <= 2 && scale <= 28 {
    let lo64 = w0.to_uint64() | (w1.to_uint64() << 32)
    return Ok(make_decimal_nonzero_sign(lo64, w2, negative, scale.to_uint()))
  }

  let mut rescale_target = 0
  if upper > 2 {
    let top_word = if upper == 5 { w5 } else if upper == 4 { w4 } else { w3 }
    rescale_target = upper * 32 - 64 - 1 - clz32(top_word)
    rescale_target = ((rescale_target * 77) >> 8) + 1
    if rescale_target > scale {
      return Err(DecimalError::Overflow)
    }
  }
  if rescale_target < scale - 28 {
    rescale_target = scale - 28
  }

  if rescale_target > 0 {
    scale = scale - rescale_target
    let mut sticky : UInt = 0U
    let mut remainder : UInt = 0U
    while true {
      sticky = sticky | remainder
      let mut power : UInt = if rescale_target > 8 {
        POWERS_10[9]
      } else {
        POWERS_10[rescale_target]
      }
      let power64 = power.to_uint64()
      let mut high_q : UInt = 0U
      if upper == 5 {
        let q5 = w5 / power
        remainder = w5 - q5 * power
        w5 = q5
        high_q = q5
        let n4 = w4.to_uint64() + (remainder.to_uint64() << 32)
        let q4 = (n4 / power64).to_uint()
        w4 = q4
        remainder = n4.to_uint() - q4 * power
        let n3 = w3.to_uint64() + (remainder.to_uint64() << 32)
        let q3 = (n3 / power64).to_uint()
        w3 = q3
        remainder = n3.to_uint() - q3 * power
        let n2 = w2.to_uint64() + (remainder.to_uint64() << 32)
        let q2 = (n2 / power64).to_uint()
        w2 = q2
        remainder = n2.to_uint() - q2 * power
        let n1 = w1.to_uint64() + (remainder.to_uint64() << 32)
        let q1 = (n1 / power64).to_uint()
        w1 = q1
        remainder = n1.to_uint() - q1 * power
        let n0 = w0.to_uint64() + (remainder.to_uint64() << 32)
        let q0 = (n0 / power64).to_uint()
        w0 = q0
        remainder = n0.to_uint() - q0 * power
      } else if upper == 4 {
        let q4 = w4 / power
        remainder = w4 - q4 * power
        w4 = q4
        high_q = q4
        let n3 = w3.to_uint64() + (remainder.to_uint64() << 32)
        let q3 = (n3 / power64).to_uint()
        w3 = q3
        remainder = n3.to_uint() - q3 * power
        let n2 = w2.to_uint64() + (remainder.to_uint64() << 32)
        let q2 = (n2 / power64).to_uint()
        w2 = q2
        remainder = n2.to_uint() - q2 * power
        let n1 = w1.to_uint64() + (remainder.to_uint64() << 32)
        let q1 = (n1 / power64).to_uint()
        w1 = q1
        remainder = n1.to_uint() - q1 * power
        let n0 = w0.to_uint64() + (remainder.to_uint64() << 32)
        let q0 = (n0 / power64).to_uint()
        w0 = q0
        remainder = n0.to_uint() - q0 * power
      } else if upper == 3 {
        let q3 = w3 / power
        remainder = w3 - q3 * power
        w3 = q3
        high_q = q3
        let n2 = w2.to_uint64() + (remainder.to_uint64() << 32)
        let q2 = (n2 / power64).to_uint()
        w2 = q2
        remainder = n2.to_uint() - q2 * power
        let n1 = w1.to_uint64() + (remainder.to_uint64() << 32)
        let q1 = (n1 / power64).to_uint()
        w1 = q1
        remainder = n1.to_uint() - q1 * power
        let n0 = w0.to_uint64() + (remainder.to_uint64() << 32)
        let q0 = (n0 / power64).to_uint()
        w0 = q0
        remainder = n0.to_uint() - q0 * power
      } else if upper == 2 {
        let q2 = w2 / power
        remainder = w2 - q2 * power
        w2 = q2
        high_q = q2
        let n1 = w1.to_uint64() + (remainder.to_uint64() << 32)
        let q1 = (n1 / power64).to_uint()
        w1 = q1
        remainder = n1.to_uint() - q1 * power
        let n0 = w0.to_uint64() + (remainder.to_uint64() << 32)
        let q0 = (n0 / power64).to_uint()
        w0 = q0
        remainder = n0.to_uint() - q0 * power
      } else if upper == 1 {
        let q1 = w1 / power
        remainder = w1 - q1 * power
        w1 = q1
        high_q = q1
        let n0 = w0.to_uint64() + (remainder.to_uint64() << 32)
        let q0 = (n0 / power64).to_uint()
        w0 = q0
        remainder = n0.to_uint() - q0 * power
      } else {
        let q0 = w0 / power
        remainder = w0 - q0 * power
        w0 = q0
        high_q = q0
      }

      if high_q == 0U && upper > 0 {
        upper = upper - 1
      }
      if rescale_target > 9 {
        rescale_target = rescale_target - 9
        continue
      }

      if upper > 2 {
        if scale == 0 {
          return Err(DecimalError::Overflow)
        }
        rescale_target = 1
        scale = scale - 1
        continue
      }

      // Banker's rounding
      power = power >> 1
      let carried = if power <= remainder {
        if power < remainder || ((w0 & 1U) | sticky) != 0U {
          w0 = w0 + 1U
          w0 == 0U
        } else {
          false
        }
      } else {
        false
      }

      if carried {
        let mut pos = 1
        w1 = w1 + 1U
        if w1 == 0U {
          pos = 2
          w2 = w2 + 1U
          if w2 == 0U {
            pos = 3
            w3 = w3 + 1U
            if w3 == 0U {
              pos = 4
              w4 = w4 + 1U
              if w4 == 0U {
                pos = 5
                w5 = w5 + 1U
              }
            }
          }
        }
        if pos > 2 {
          if scale == 0 {
            return Err(DecimalError::Overflow)
          }
          upper = pos
          sticky = 0U
          remainder = 0U
          rescale_target = 1
          scale = scale - 1
          continue
        }
      }
      break
    }
  }

  let lo64 = w0.to_uint64() | (w1.to_uint64() << 32)
  Ok(make_decimal_nonzero_sign(lo64, w2, negative, scale.to_uint()))
}

///|
pub fn Decimal::checked_mul(self : Decimal, other : Decimal) -> Result[Decimal, DecimalError] {
  if self.is_zero() || other.is_zero() {
    return Ok(ZERO)
  }
  let mut scale = self.scale() + other.scale()
  let negative = self.is_sign_negative() != other.is_sign_negative()

  // Fast path: both fit in 64 bits
  if self.hi == 0U && other.hi == 0U {
    if self.lo64 <= 0xFFFFFFFFUL && other.lo64 <= 0xFFFFFFFFUL {
      let mut low64 = self.lo64 * other.lo64
      if scale > MAX_SCALE {
        if scale > MAX_SCALE + 19U {
          return Ok(ZERO)
        }
        let drop = (scale - MAX_SCALE).to_int()
        let mut power = POWERS_10_U64[drop]
        let q = low64 / power
        let rem = low64 - q * power
        low64 = q
        power = power >> 1
        if rem >= power && (rem > power || (low64 & 1UL) != 0UL) {
          low64 = low64 + 1UL
        }
        scale = MAX_SCALE
      }
      return Ok(make_decimal_nonzero_sign(low64, 0U, negative, scale))
    }

    let (plo, phi) = u64_mul_wide(self.lo64, other.lo64)
    if phi <= 0xFFFFFFFFUL && scale <= MAX_SCALE {
      return Ok(make_decimal_nonzero_sign(plo, phi.to_uint(), negative, scale))
    }
    return finish_mul_192_scalar(
      plo.to_uint(),
      (plo >> 32).to_uint(),
      phi.to_uint(),
      (phi >> 32).to_uint(),
      0U,
      0U,
      negative,
      scale,
    )
  }

  // General 96x96 -> 192-bit schoolbook multiplication (zero heap allocation)
  let a0 = self.lo64 & 0xFFFFFFFFUL
  let a1 = self.lo64 >> 32
  let a2 = self.hi.to_uint64()
  let b0 = other.lo64 & 0xFFFFFFFFUL
  let b1 = other.lo64 >> 32
  let b2 = other.hi.to_uint64()

  // w0 = a0 * b0
  let mut tmp = a0 * b0
  let w0 = tmp.to_uint()
  let mut carry = tmp >> 32

  // w1 = a0*b1 + a1*b0 + carry
  let p01 = a0 * b1 + carry
  let p10 = a1 * b0
  tmp = p01 + p10
  let w1 = tmp.to_uint()
  let c1 = if tmp < p01 { 1UL << 32 } else { 0UL }
  carry = (tmp >> 32) | c1

  // w2 = a1*b1 + a0*b2 + a2*b0 + carry
  tmp = a1 * b1 + carry
  let mut hi_carry : UInt64 = 0UL
  let p02 = a0 * b2
  tmp = tmp + p02
  if tmp < p02 {
    hi_carry = hi_carry + 1UL
  }
  let p20 = a2 * b0
  tmp = tmp + p20
  if tmp < p20 {
    hi_carry = hi_carry + 1UL
  }
  let w2 = tmp.to_uint()
  carry = (hi_carry << 32) | (tmp >> 32)

  // w3 = a1*b2 + a2*b1 + carry
  tmp = a1 * b2 + carry
  hi_carry = if tmp < carry { 1UL } else { 0UL }
  let p21 = a2 * b1
  tmp = tmp + p21
  if tmp < p21 {
    hi_carry = hi_carry + 1UL
  }
  let w3 = tmp.to_uint()
  carry = (hi_carry << 32) | (tmp >> 32)

  // w4, w5 = a2*b2 + carry
  let top = a2 * b2 + carry
  let w4 = top.to_uint()
  let w5 = (top >> 32).to_uint()

  finish_mul_192_scalar(w0, w1, w2, w3, w4, w5, negative, scale)
}

// === Division & Remainder Helpers (Buf12 / Buf16 Knuth division) ===

///| Largest 96-bit values that don't overflow when multiplied by 10^1..10^8.
let POW_OV_LO : FixedArray[UInt] = [
  2576980377U, 687194767U, 2645699854U, 694066715U, 2216890319U, 2369172679U, 4102387834U, 410238783U,
]
let POW_OV_MID : FixedArray[UInt] = [
  2576980377U, 4123168604U, 1271310319U, 3133608139U, 2890341191U, 4154504685U, 2133437386U, 4078814305U,
]
let POW_OV_HI : FixedArray[UInt] = [
  429496729U, 42949672U, 4294967U, 429496U, 42949U, 4294U, 429U, 42U,
]

///| Port of `Buf12::find_scale`. Returns max x in 0..=9 such that q * 10^x fits in 96 bits, or -1 on overflow.
fn find_scale_96(q : FixedArray[UInt], scale : Int) -> Int {
  let hi = q[2]
  let low64 = q[0].to_uint64() | (q[1].to_uint64() << 32)
  if hi > 429496729U {
    return if scale < 0 { -1 } else { 0 }
  }
  if scale > 19 {
    let x = 28 - scale
    if x > 0 && hi < POW_OV_HI[x - 1] {
      return if x + scale < 0 { -1 } else { x }
    }
  } else if hi < 4U || (hi == 4U && low64 <= 5441186219426131129UL) {
    return 9
  }

  let mut x = if hi > 42949U {
    if hi > 4294967U {
      if hi > 42949672U { 1 } else { 2 }
    } else if hi > 429496U {
      3
    } else {
      4
    }
  } else if hi > 429U {
    if hi > 4294U { 5 } else { 6 }
  } else if hi > 42U {
    7
  } else {
    8
  }

  let ov_low64 = POW_OV_LO[x - 1].to_uint64() | (POW_OV_MID[x - 1].to_uint64() << 32)
  if hi == POW_OV_HI[x - 1] && low64 > ov_low64 {
    x = x - 1
  }
  if x + scale < 0 { -1 } else { x }
}

///| Multiply 96-bit `q` by `power` (<= 10^9); returns overflow word.
fn increase_scale_96(q : FixedArray[UInt], power : UInt64) -> UInt {
  let mut tmp = q[0].to_uint64() * power
  q[0] = tmp.to_uint()
  tmp = (tmp >> 32) + q[1].to_uint64() * power
  q[1] = tmp.to_uint()
  tmp = (tmp >> 32) + q[2].to_uint64() * power
  q[2] = tmp.to_uint()
  (tmp >> 32).to_uint()
}

///| Multiply low 64 bits of Buf16 `rem` by `power` into rem[0..3].
fn increase_scale_64(rem : FixedArray[UInt], power : UInt64) -> Unit {
  let mut tmp = rem[0].to_uint64() * power
  rem[0] = tmp.to_uint()
  tmp = (tmp >> 32) + rem[1].to_uint64() * power
  rem[1] = tmp.to_uint()
  rem[2] = (tmp >> 32).to_uint()
}

///| Port of `Buf12::div32_const`.
fn div32_const_96(q : FixedArray[UInt], pow : UInt) -> Bool {
  let pow64 = pow.to_uint64()
  let high64 = q[1].to_uint64() | (q[2].to_uint64() << 32)
  let lo = q[0].to_uint64()
  let div64 = high64 / pow64
  let div = ((((high64 - div64 * pow64) << 32) + lo) / pow64).to_uint()
  if q[0] == div * pow {
    q[1] = div64.to_uint()
    q[2] = (div64 >> 32).to_uint()
    q[0] = div
    true
  } else {
    false
  }
}

///| Strip trailing decimal zeros from `q` (port of `div::unscale`, generalized for normalize).
fn unscale_96(q : FixedArray[UInt], scale_in : Int) -> Int {
  let mut scale = scale_in
  while (q[0] & 0xFFU) == 0U && scale >= 8 && div32_const_96(q, 100000000U) {
    scale = scale - 8
  }
  while (q[0] & 0xFU) == 0U && scale >= 4 && div32_const_96(q, 10000U) {
    scale = scale - 4
  }
  while (q[0] & 0x3U) == 0U && scale >= 2 && div32_const_96(q, 100U) {
    scale = scale - 2
  }
  while (q[0] & 0x1U) == 0U && scale >= 1 && div32_const_96(q, 10U) {
    scale = scale - 1
  }
  scale
}

///| Port of `div::unscale_from_overflow`. Returns new scale or -1 on overflow.
fn unscale_from_overflow_96(q : FixedArray[UInt], scale_in : Int, sticky : Bool) -> Int {
  let scale = scale_in - 1
  if scale < 0 {
    return -1
  }
  let high_bit : UInt64 = 0x100000000UL
  q[2] = (high_bit / 10UL).to_uint()
  let mut tmp = ((high_bit % 10UL) << 32) + q[1].to_uint64()
  let mut qv = (tmp / 10UL).to_uint()
  q[1] = qv
  tmp = ((tmp - qv.to_uint64() * 10UL) << 32) + q[0].to_uint64()
  qv = (tmp / 10UL).to_uint()
  q[0] = qv
  let rem = (tmp - qv.to_uint64() * 10UL).to_uint()
  if rem > 5U || (rem == 5U && (sticky || (q[0] & 1U) != 0U)) {
    let _ = u96_add_u32(q, 1U)
  }
  scale
}

///| Port of `div::round_up`. Returns new scale or -1 on overflow.
fn round_up_96(q : FixedArray[UInt], scale : Int) -> Int {
  if u96_add_u32(q, 1U) == 0U {
    return scale
  }
  unscale_from_overflow_96(q, scale, true)
}

///| Port of `Buf16::partial_divide_64`.
fn partial_divide_64(buf : FixedArray[UInt], divisor : UInt64) -> UInt {
  if buf[2] == 0U {
    let low64 = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
    if low64 < divisor {
      return 0U
    }
    let q = low64 / divisor
    let r = low64 - q * divisor
    buf[0] = r.to_uint()
    buf[1] = (r >> 32).to_uint()
    return q.to_uint()
  }

  let divisor_hi32 = (divisor >> 32).to_uint()
  if buf[2] >= divisor_hi32 {
    let mut low64 = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
    low64 = low64 - (divisor << 32) + divisor
    let mut q : UInt = 0xFFFFFFFFU
    while low64 >= divisor {
      q = q - 1U
      low64 = low64 + divisor
    }
    buf[0] = low64.to_uint()
    buf[1] = (low64 >> 32).to_uint()
    return q
  }

  let mid64 = buf[1].to_uint64() | (buf[2].to_uint64() << 32)
  let divisor_hi64 = divisor_hi32.to_uint64()
  if mid64 < divisor_hi64 {
    return 0U
  }

  let mut q = mid64 / divisor_hi64
  let mut rem = buf[0].to_uint64() | ((mid64 - q * divisor_hi64) << 32)
  let prod = q * (divisor & 0xFFFFFFFFUL)
  rem = rem - prod
  if rem > (prod ^ 0xFFFFFFFFFFFFFFFFUL) {
    while true {
      q = q - 1UL
      rem = rem + divisor
      if rem < divisor {
        break
      }
    }
  }
  buf[0] = rem.to_uint()
  buf[1] = (rem >> 32).to_uint()
  q.to_uint()
}

///| Port of `Buf16::partial_divide_96`.
fn partial_divide_96(buf : FixedArray[UInt], divisor : FixedArray[UInt]) -> UInt {
  let dividend = buf[2].to_uint64() | (buf[3].to_uint64() << 32)
  let divisor_hi = divisor[2]
  let divisor_hi64 = divisor_hi.to_uint64()
  if dividend < divisor_hi64 {
    return 0U
  }

  let mut quo = (dividend / divisor_hi64).to_uint()
  let mut rem = dividend.to_uint() - quo * divisor_hi

  let mut prod1 = quo.to_uint64() * divisor[0].to_uint64()
  let mut prod2 = quo.to_uint64() * divisor[1].to_uint64()
  prod2 = prod2 + (prod1 >> 32)
  prod1 = (prod1 & 0xFFFFFFFFUL) | (prod2 << 32)
  prod2 = prod2 >> 32

  let mut num = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
  num = num - prod1
  let prod2_u32 = prod2.to_uint()
  rem = rem - prod2_u32

  let inv_prod1 = prod1 ^ 0xFFFFFFFFFFFFFFFFUL
  let inv_prod2 = prod2_u32 ^ 0xFFFFFFFFU
  if num > inv_prod1 {
    rem = rem - 1U
    if rem < inv_prod2 {
      buf[0] = num.to_uint()
      buf[1] = (num >> 32).to_uint()
      buf[2] = rem
      return quo
    }
  } else if rem <= inv_prod2 {
    buf[0] = num.to_uint()
    buf[1] = (num >> 32).to_uint()
    buf[2] = rem
    return quo
  }

  prod1 = divisor[0].to_uint64() | (divisor[1].to_uint64() << 32)
  while true {
    quo = quo - 1U
    num = num + prod1
    rem = rem + divisor_hi
    if num < prod1 {
      let tmp = rem
      rem = rem + 1U
      if tmp < divisor_hi {
        break
      }
    }
    if rem < divisor_hi {
      break
    }
  }
  buf[0] = num.to_uint()
  buf[1] = (num >> 32).to_uint()
  buf[2] = rem
  quo
}

///| Value-struct return types for zero-allocation scalar division.
val struct Div64Step {
  q : UInt
  r0 : UInt
  r1 : UInt
}

///|
val struct Div96Step {
  q : UInt
  r0 : UInt
  r1 : UInt
  r2 : UInt
}

///|
val struct Q96Scale {
  q0 : UInt
  q1 : UInt
  q2 : UInt
  scale : Int
}

///| Scalar port of `Buf12::find_scale`.
fn find_scale_scalar(q0 : UInt, q1 : UInt, hi : UInt, scale : Int) -> Int {
  let low64 = q0.to_uint64() | (q1.to_uint64() << 32)
  if hi > 429496729U {
    return if scale < 0 { -1 } else { 0 }
  }
  if scale > 19 {
    let x = 28 - scale
    if x > 0 && hi < POW_OV_HI[x - 1] {
      return if x + scale < 0 { -1 } else { x }
    }
  } else if hi < 4U || (hi == 4U && low64 <= 5441186219426131129UL) {
    return 9
  }

  let mut x = if hi > 42949U {
    if hi > 4294967U {
      if hi > 42949672U { 1 } else { 2 }
    } else if hi > 429496U {
      3
    } else {
      4
    }
  } else if hi > 429U {
    if hi > 4294U { 5 } else { 6 }
  } else if hi > 42U {
    7
  } else {
    8
  }

  let ov_low64 = POW_OV_LO[x - 1].to_uint64() | (POW_OV_MID[x - 1].to_uint64() << 32)
  if hi == POW_OV_HI[x - 1] && low64 > ov_low64 {
    x = x - 1
  }
  if x + scale < 0 { -1 } else { x }
}

///| Scalar port of `div::unscale_from_overflow`.
fn unscale_from_overflow_scalar(q0_in : UInt, q1_in : UInt, scale_in : Int, sticky : Bool) -> Q96Scale {
  let scale = scale_in - 1
  if scale < 0 {
    return Q96Scale::{ q0: 0U, q1: 0U, q2: 0U, scale: -1 }
  }
  let high_bit : UInt64 = 0x100000000UL
  let mut q2 = (high_bit / 10UL).to_uint()
  let mut tmp = ((high_bit % 10UL) << 32) + q1_in.to_uint64()
  let mut q1 = (tmp / 10UL).to_uint()
  tmp = ((tmp - q1.to_uint64() * 10UL) << 32) + q0_in.to_uint64()
  let mut q0 = (tmp / 10UL).to_uint()
  let rem = (tmp - q0.to_uint64() * 10UL).to_uint()
  if rem > 5U || (rem == 5U && (sticky || (q0 & 1U) != 0U)) {
    let s0 = q0.to_uint64() + 1UL
    q0 = s0.to_uint()
    if s0 > 0xFFFFFFFFUL {
      let s1 = q1.to_uint64() + 1UL
      q1 = s1.to_uint()
      if s1 > 0xFFFFFFFFUL {
        q2 = q2 + 1U
      }
    }
  }
  Q96Scale::{ q0, q1, q2, scale }
}

///| Scalar port of `div::round_up`.
fn round_up_scalar(q0_in : UInt, q1_in : UInt, q2_in : UInt, scale : Int) -> Q96Scale {
  let low64 = (q0_in.to_uint64() | (q1_in.to_uint64() << 32)) + 1UL
  if low64 != 0UL {
    return Q96Scale::{ q0: low64.to_uint(), q1: (low64 >> 32).to_uint(), q2: q2_in, scale }
  }
  let hi = q2_in + 1U
  if hi != 0U {
    return Q96Scale::{ q0: 0U, q1: 0U, q2: hi, scale }
  }
  unscale_from_overflow_scalar(0U, 0U, scale, true)
}

///| Scalar port of `Buf16::partial_divide_64` (zero heap allocation).
fn partial_divide_64_scalar(b0 : UInt, b1 : UInt, b2 : UInt, divisor : UInt64) -> Div64Step {
  if b2 == 0U {
    let low64 = b0.to_uint64() | (b1.to_uint64() << 32)
    if low64 < divisor {
      return Div64Step::{ q: 0U, r0: b0, r1: b1 }
    }
    let q = low64 / divisor
    let r = low64 - q * divisor
    return Div64Step::{ q: q.to_uint(), r0: r.to_uint(), r1: (r >> 32).to_uint() }
  }

  let divisor_hi32 = (divisor >> 32).to_uint()
  if b2 >= divisor_hi32 {
    let mut low64 = b0.to_uint64() | (b1.to_uint64() << 32)
    low64 = low64 - (divisor << 32) + divisor
    let mut q : UInt = 0xFFFFFFFFU
    while low64 >= divisor {
      q = q - 1U
      low64 = low64 + divisor
    }
    return Div64Step::{ q, r0: low64.to_uint(), r1: (low64 >> 32).to_uint() }
  }

  let mid64 = b1.to_uint64() | (b2.to_uint64() << 32)
  let divisor_hi64 = divisor_hi32.to_uint64()
  if mid64 < divisor_hi64 {
    return Div64Step::{ q: 0U, r0: b0, r1: b1 }
  }

  let mut q = mid64 / divisor_hi64
  let mut rem = b0.to_uint64() | ((mid64 - q * divisor_hi64) << 32)
  let prod = q * (divisor & 0xFFFFFFFFUL)
  rem = rem - prod
  if rem > (prod ^ 0xFFFFFFFFFFFFFFFFUL) {
    while true {
      q = q - 1UL
      rem = rem + divisor
      if rem < divisor {
        break
      }
    }
  }
  Div64Step::{ q: q.to_uint(), r0: rem.to_uint(), r1: (rem >> 32).to_uint() }
}

///| Scalar port of `Buf16::partial_divide_96` (zero heap allocation).
fn partial_divide_96_scalar(
  b0 : UInt,
  b1 : UInt,
  b2 : UInt,
  b3 : UInt,
  d0 : UInt,
  d1 : UInt,
  d2 : UInt,
) -> Div96Step {
  let dividend = b2.to_uint64() | (b3.to_uint64() << 32)
  let divisor_hi64 = d2.to_uint64()
  if dividend < divisor_hi64 {
    return Div96Step::{ q: 0U, r0: b0, r1: b1, r2: b2 }
  }

  let mut quo = (dividend / divisor_hi64).to_uint()
  let mut rem = dividend.to_uint() - quo * d2

  let mut prod1 = quo.to_uint64() * d0.to_uint64()
  let mut prod2 = quo.to_uint64() * d1.to_uint64()
  prod2 = prod2 + (prod1 >> 32)
  prod1 = (prod1 & 0xFFFFFFFFUL) | (prod2 << 32)
  prod2 = prod2 >> 32

  let mut num = b0.to_uint64() | (b1.to_uint64() << 32)
  num = num - prod1
  let prod2_u32 = prod2.to_uint()
  rem = rem - prod2_u32

  let inv_prod1 = prod1 ^ 0xFFFFFFFFFFFFFFFFUL
  let inv_prod2 = prod2_u32 ^ 0xFFFFFFFFU
  if num > inv_prod1 {
    rem = rem - 1U
    if rem < inv_prod2 {
      return Div96Step::{ q: quo, r0: num.to_uint(), r1: (num >> 32).to_uint(), r2: rem }
    }
  } else if rem <= inv_prod2 {
    return Div96Step::{ q: quo, r0: num.to_uint(), r1: (num >> 32).to_uint(), r2: rem }
  }

  prod1 = d0.to_uint64() | (d1.to_uint64() << 32)
  while true {
    quo = quo - 1U
    num = num + prod1
    rem = rem + d2
    if num < prod1 {
      let tmp = rem
      rem = rem + 1U
      if tmp < d2 {
        break
      }
    }
    if rem < d2 {
      break
    }
  }
  Div96Step::{ q: quo, r0: num.to_uint(), r1: (num >> 32).to_uint(), r2: rem }
}

///| Exact line-by-line port of `rust_decimal::ops::div::unscale` (zero heap allocation).
fn unscale_div_scalar(q0_in : UInt, q1_in : UInt, q2_in : UInt, scale_in : Int) -> Q96Scale {
  let mut q0 = q0_in
  let mut q1 = q1_in
  let mut q2 = q2_in
  let mut scale = scale_in

  while q0 == 0U && scale >= 8 {
    let pow64 = 100000000UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 100000000U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 8
    } else {
      break
    }
  }

  if (q0 & 0xFU) == 0U && scale >= 4 {
    let pow64 = 10000UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 10000U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 4
    }
  }

  if (q0 & 0x3U) == 0U && scale >= 2 {
    let pow64 = 100UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 100U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 2
    }
  }

  if (q0 & 0x1U) == 0U && scale >= 1 {
    let pow64 = 10UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 10U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 1
    }
  }

  Q96Scale::{ q0, q1, q2, scale }
}

///| Zero-allocation scalar 96-bit checked division matching `rust_decimal =1.37.2` bit-for-bit.
pub fn Decimal::checked_div(self : Decimal, other : Decimal) -> Result[Decimal, DecimalError] {
  if other.is_zero() {
    return Err(DecimalError::DivisionByZero)
  }
  if self.is_zero() {
    return Ok(ZERO)
  }

  let mut scale = self.scale().to_int() - other.scale().to_int()
  let neg = self.is_sign_negative() != other.is_sign_negative()
  let mut require_unscale = false

  let mut q0 = self.lo64.to_uint()
  let mut q1 = (self.lo64 >> 32).to_uint()
  let mut q2 = self.hi
  let d0 = other.lo64.to_uint()
  let d1 = (other.lo64 >> 32).to_uint()
  let d2 = other.hi

  if (d2 | d1) == 0U {
    // 32-bit divisor path (zero heap allocation)
    let div32 = d0
    let div64 = div32.to_uint64()
    let mut rem : UInt = if q2 != 0U {
      let mut temp = q1.to_uint64() | (q2.to_uint64() << 32)
      let hi_q = temp / div64
      q1 = hi_q.to_uint()
      q2 = (hi_q >> 32).to_uint()
      temp = ((temp - hi_q * div64) << 32) | q0.to_uint64()
      if temp == 0UL {
        0U
      } else {
        let lo_q = (temp / div64).to_uint()
        q0 = lo_q
        temp.to_uint() - lo_q * div32
      }
    } else {
      let low64 = self.lo64
      let lo_q = low64 / div64
      q0 = lo_q.to_uint()
      q1 = (lo_q >> 32).to_uint()
      (low64 - lo_q * div64).to_uint()
    }

    while rem != 0U || scale < 0 {
      let mut pscale = 0
      if rem == 0U {
        if scale >= 0 {
          break
        }
        pscale = if -scale < 9 { -scale } else { 9 }
      } else {
        require_unscale = true
        let will_ov = if scale == 28 {
          true
        } else {
          pscale = find_scale_scalar(q0, q1, q2, scale)
          if pscale < 0 {
            return Err(DecimalError::Overflow)
          }
          pscale == 0
        }
        if will_ov {
          let tmp = rem << 1
          let round = if tmp < rem {
            true
          } else if tmp >= div32 {
            tmp > div32 || (q0 & 1U) != 0U
          } else {
            false
          }
          if round {
            let ru = round_up_scalar(q0, q1, q2, scale)
            if ru.scale < 0 {
              return Err(DecimalError::Overflow)
            }
            q0 = ru.q0
            q1 = ru.q1
            q2 = ru.q2
            scale = ru.scale
          }
          break
        }
      }
      let power = POWERS_10[pscale].to_uint64()
      scale = scale + pscale
      let mut t = q0.to_uint64() * power
      q0 = t.to_uint()
      t = (t >> 32) + q1.to_uint64() * power
      q1 = t.to_uint()
      t = (t >> 32) + q2.to_uint64() * power
      q2 = t.to_uint()
      if (t >> 32) != 0UL {
        return Err(DecimalError::Overflow)
      }
      let rem_scaled = rem.to_uint64() * power
      let rq = (rem_scaled / div64).to_uint()
      rem = (rem_scaled - rq.to_uint64() * div64).to_uint()
      let new_lo = (q0.to_uint64() | (q1.to_uint64() << 32)) + rq.to_uint64()
      q0 = new_lo.to_uint()
      q1 = (new_lo >> 32).to_uint()
      if new_lo < rq.to_uint64() {
        q2 = q2 + 1U
        if q2 == 0U {
          let uo = unscale_from_overflow_scalar(q0, q1, scale, rem != 0U)
          if uo.scale < 0 {
            return Err(DecimalError::Overflow)
          }
          q0 = uo.q0
          q1 = uo.q1
          q2 = uo.q2
          scale = uo.scale
          break
        }
      }
    }
  } else {
    // 64-bit or 96-bit divisor path (zero heap allocation)
    let shift = if d2 == 0U { clz32(d1) } else { clz32(d2) }
    let rshift = 32 - shift
    let q_low64 = q0.to_uint64() | (q1.to_uint64() << 32)
    let r_lo = q_low64 << shift
    let mut r0 = r_lo.to_uint()
    let mut r1 = (r_lo >> 32).to_uint()
    let r_hi = (q1.to_uint64() + (q2.to_uint64() << 32)) >> rshift
    let mut r2 = r_hi.to_uint()
    let mut r3 = (r_hi >> 32).to_uint()

    let d_low64 = (d0.to_uint64() | (d1.to_uint64() << 32)) << shift
    if d2 == 0U {
      // 64-bit divisor
      q2 = 0U
      let rem_lo_saved = r0
      let step1 = partial_divide_64_scalar(r1, r2, r3, d_low64)
      q1 = step1.q
      let step0 = partial_divide_64_scalar(rem_lo_saved, step1.r0, step1.r1, d_low64)
      q0 = step0.q
      r0 = step0.r0
      r1 = step0.r1
      r2 = 0U

      while (r0 | r1) != 0U || scale < 0 {
        let mut pscale = 0
        let rem64 = r0.to_uint64() | (r1.to_uint64() << 32)
        if rem64 == 0UL {
          if scale >= 0 {
            break
          }
          pscale = if -scale < 9 { -scale } else { 9 }
        } else {
          require_unscale = true
          let will_ov = if scale == 28 {
            true
          } else {
            pscale = find_scale_scalar(q0, q1, q2, scale)
            if pscale < 0 {
              return Err(DecimalError::Overflow)
            }
            pscale == 0
          }
          if will_ov {
            let round = if (rem64 & 0x8000000000000000UL) != 0UL {
              true
            } else {
              let twice = rem64 << 1
              if twice > d_low64 {
                true
              } else {
                twice == d_low64 && (q0 & 1U) != 0U
              }
            }
            if round {
              let ru = round_up_scalar(q0, q1, q2, scale)
              if ru.scale < 0 {
                return Err(DecimalError::Overflow)
              }
              q0 = ru.q0
              q1 = ru.q1
              q2 = ru.q2
              scale = ru.scale
            }
            break
          }
        }
        let power = POWERS_10[pscale].to_uint64()
        scale = scale + pscale
        let mut t = q0.to_uint64() * power
        q0 = t.to_uint()
        t = (t >> 32) + q1.to_uint64() * power
        q1 = t.to_uint()
        t = (t >> 32) + q2.to_uint64() * power
        q2 = t.to_uint()
        if (t >> 32) != 0UL {
          return Err(DecimalError::Overflow)
        }
        let mut rt = r0.to_uint64() * power
        r0 = rt.to_uint()
        rt = (rt >> 32) + r1.to_uint64() * power
        r1 = rt.to_uint()
        r2 = (rt >> 32).to_uint()
        // Inlined partial_divide_64 (zero struct return)
        let mut rq : UInt = 0U
        if r2 == 0U {
          let low64 = r0.to_uint64() | (r1.to_uint64() << 32)
          if low64 >= d_low64 {
            let qq = low64 / d_low64
            let rr = low64 - qq * d_low64
            r0 = rr.to_uint()
            r1 = (rr >> 32).to_uint()
            rq = qq.to_uint()
          }
        } else {
          let divisor_hi32 = (d_low64 >> 32).to_uint()
          if r2 >= divisor_hi32 {
            let mut low64 = r0.to_uint64() | (r1.to_uint64() << 32)
            low64 = low64 - (d_low64 << 32) + d_low64
            rq = 0xFFFFFFFFU
            while low64 >= d_low64 {
              rq = rq - 1U
              low64 = low64 + d_low64
            }
            r0 = low64.to_uint()
            r1 = (low64 >> 32).to_uint()
          } else {
            let mid64 = r1.to_uint64() | (r2.to_uint64() << 32)
            let divisor_hi64 = divisor_hi32.to_uint64()
            if mid64 >= divisor_hi64 {
              let mut qq = mid64 / divisor_hi64
              let mut rem64_v = r0.to_uint64() | ((mid64 - qq * divisor_hi64) << 32)
              let prod = qq * (d_low64 & 0xFFFFFFFFUL)
              rem64_v = rem64_v - prod
              if rem64_v > (prod ^ 0xFFFFFFFFFFFFFFFFUL) {
                while true {
                  qq = qq - 1UL
                  rem64_v = rem64_v + d_low64
                  if rem64_v < d_low64 {
                    break
                  }
                }
              }
              r0 = rem64_v.to_uint()
              r1 = (rem64_v >> 32).to_uint()
              rq = qq.to_uint()
            }
          }
        }
        let new_lo = (q0.to_uint64() | (q1.to_uint64() << 32)) + rq.to_uint64()
        q0 = new_lo.to_uint()
        q1 = (new_lo >> 32).to_uint()
        if new_lo < rq.to_uint64() {
          q2 = q2 + 1U
          if q2 == 0U {
            let uo = unscale_from_overflow_scalar(q0, q1, scale, (r0 | r1) != 0U)
            if uo.scale < 0 {
              return Err(DecimalError::Overflow)
            }
            q0 = uo.q0
            q1 = uo.q1
            q2 = uo.q2
            scale = uo.scale
            break
          }
        }
      }
    } else {
      // 96-bit divisor
      let ds0 = d_low64.to_uint()
      let ds1 = (d_low64 >> 32).to_uint()
      let ds2 = ((d1.to_uint64() + (d2.to_uint64() << 32)) >> rshift).to_uint()
      let step0 = partial_divide_96_scalar(r0, r1, r2, r3, ds0, ds1, ds2)
      q0 = step0.q
      q1 = 0U
      q2 = 0U
      r0 = step0.r0
      r1 = step0.r1
      r2 = step0.r2

      while (r0 | r1 | r2) != 0U || scale < 0 {
        let mut pscale = 0
        if (r0 | r1 | r2) == 0U {
          if scale >= 0 {
            break
          }
          pscale = if -scale < 9 { -scale } else { 9 }
        } else {
          require_unscale = true
          let will_ov = if scale == 28 {
            true
          } else {
            pscale = find_scale_scalar(q0, q1, q2, scale)
            if pscale < 0 {
              return Err(DecimalError::Overflow)
            }
            pscale == 0
          }
          if will_ov {
            let round = if (r2 & 0x80000000U) != 0U {
              true
            } else {
              let carry_bit = r1 >> 31
              let mut rlo64 = r0.to_uint64() | (r1.to_uint64() << 32)
              rlo64 = rlo64 << 1
              let r2_twice = (r2 << 1) + carry_bit
              if r2_twice < ds2 {
                false
              } else if r2_twice > ds2 {
                true
              } else {
                let dl = ds0.to_uint64() | (ds1.to_uint64() << 32)
                if rlo64 > dl {
                  true
                } else {
                  rlo64 == dl && (q0 & 1U) != 0U
                }
              }
            }
            if round {
              let ru = round_up_scalar(q0, q1, q2, scale)
              if ru.scale < 0 {
                return Err(DecimalError::Overflow)
              }
              q0 = ru.q0
              q1 = ru.q1
              q2 = ru.q2
              scale = ru.scale
            }
            break
          }
        }
        let power = POWERS_10[pscale].to_uint64()
        scale = scale + pscale
        let mut t = q0.to_uint64() * power
        q0 = t.to_uint()
        t = (t >> 32) + q1.to_uint64() * power
        q1 = t.to_uint()
        t = (t >> 32) + q2.to_uint64() * power
        q2 = t.to_uint()
        if (t >> 32) != 0UL {
          return Err(DecimalError::Overflow)
        }
        let mut rt = r0.to_uint64() * power
        r0 = rt.to_uint()
        rt = (rt >> 32) + r1.to_uint64() * power
        r1 = rt.to_uint()
        rt = (rt >> 32) + r2.to_uint64() * power
        r2 = rt.to_uint()
        r3 = (rt >> 32).to_uint()
        // Inlined partial_divide_96 (zero struct return)
        let mut rq : UInt = 0U
        let dividend = r2.to_uint64() | (r3.to_uint64() << 32)
        let divisor_hi64 = ds2.to_uint64()
        if dividend >= divisor_hi64 {
          let mut quo = (dividend / divisor_hi64).to_uint()
          let mut rem32 = dividend.to_uint() - quo * ds2
          let mut prod1 = quo.to_uint64() * ds0.to_uint64()
          let mut prod2 = quo.to_uint64() * ds1.to_uint64()
          prod2 = prod2 + (prod1 >> 32)
          prod1 = (prod1 & 0xFFFFFFFFUL) | (prod2 << 32)
          prod2 = prod2 >> 32
          let mut num = r0.to_uint64() | (r1.to_uint64() << 32)
          num = num - prod1
          let prod2_u32 = prod2.to_uint()
          rem32 = rem32 - prod2_u32
          let inv_prod1 = prod1 ^ 0xFFFFFFFFFFFFFFFFUL
          let inv_prod2 = prod2_u32 ^ 0xFFFFFFFFU
          let mut need_fix = true
          if num > inv_prod1 {
            rem32 = rem32 - 1U
            if rem32 < inv_prod2 {
              need_fix = false
            }
          } else if rem32 <= inv_prod2 {
            need_fix = false
          }
          if need_fix {
            prod1 = ds0.to_uint64() | (ds1.to_uint64() << 32)
            while true {
              quo = quo - 1U
              num = num + prod1
              rem32 = rem32 + ds2
              if num < prod1 {
                let tmp = rem32
                rem32 = rem32 + 1U
                if tmp < ds2 {
                  break
                }
              }
              if rem32 < ds2 {
                break
              }
            }
          }
          r0 = num.to_uint()
          r1 = (num >> 32).to_uint()
          r2 = rem32
          rq = quo
        }
        let new_lo = (q0.to_uint64() | (q1.to_uint64() << 32)) + rq.to_uint64()
        q0 = new_lo.to_uint()
        q1 = (new_lo >> 32).to_uint()
        if new_lo < rq.to_uint64() {
          q2 = q2 + 1U
          if q2 == 0U {
            let sticky = (r0 | r1 | r2 | r3) != 0U
            let uo = unscale_from_overflow_scalar(q0, q1, scale, sticky)
            if uo.scale < 0 {
              return Err(DecimalError::Overflow)
            }
            q0 = uo.q0
            q1 = uo.q1
            q2 = uo.q2
            scale = uo.scale
            break
          }
        }
      }
    }
  }

  if require_unscale {
    let us = unscale_div_scalar(q0, q1, q2, scale)
    q0 = us.q0
    q1 = us.q1
    q2 = us.q2
    scale = us.scale
  }
  let res_lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  Ok(make_decimal_nonzero_sign(res_lo64, q2, neg, scale.to_uint()))
}

// === Remainder ===

///|
pub fn Decimal::checked_rem(self : Decimal, other : Decimal) -> Result[Decimal, DecimalError] {
  if other.is_zero() {
    return Err(DecimalError::DivisionByZero)
  }
  if self.is_zero() {
    return Ok(ZERO)
  }

  let cmp = cmp_magnitude(self, other)
  if cmp == 0 {
    return Ok(ZERO)
  }
  if cmp < 0 {
    return Ok(self)
  }

  // |self| > |other| > 0
  let neg = self.is_sign_negative()
  let mut d1_lo = self.lo64
  let mut d1_hi = self.hi
  let mut d1_scale = self.scale()
  let d2_scale = other.scale()
  let d2 : FixedArray[UInt] = [
    other.lo64.to_uint(),
    (other.lo64 >> 32).to_uint(),
    other.hi,
  ]

  let mut scale = d1_scale.to_int() - d2_scale.to_int()
  if scale > 0 {
    while scale > 0 {
      let step = if scale >= 9 { 9 } else { scale }
      let power = POWERS_10[step].to_uint64()
      let _ = increase_scale_96(d2, power)
      scale = scale - step
    }
    scale = 0
  }

  while true {
    if scale < 0 {
      let q : FixedArray[UInt] = [d1_lo.to_uint(), (d1_lo >> 32).to_uint(), d1_hi]
      while scale < 0 {
        let p = find_scale_96(q, 28 + scale)
        if p < 0 {
          return Err(DecimalError::Overflow)
        }
        let step = if p > 9 { 9 } else { p }
        if step == 0 {
          break
        }
        let power = POWERS_10[step].to_uint64()
        scale = scale + step
        let _ = increase_scale_96(q, power)
        if step != 9 {
          break
        }
      }
      d1_lo = q[0].to_uint64() | (q[1].to_uint64() << 32)
      d1_hi = q[2]
      d1_scale = d2_scale
    }

    if d1_hi == 0U {
      let d2_lo64 = d2[0].to_uint64() | (d2[1].to_uint64() << 32)
      d1_lo = d1_lo % d2_lo64
      return Ok(make_decimal_nonzero_sign(d1_lo, 0U, neg, d1_scale))
    } else if (d2[1] | d2[2]) == 0U {
      let div64 = d2[0].to_uint64()
      let mut tmp = (d1_lo >> 32) | (d1_hi.to_uint64() << 32)
      tmp = ((tmp % div64) << 32) | (d1_lo & 0xFFFFFFFFUL)
      d1_lo = tmp % div64
      d1_hi = 0U
    } else {
      // Full multi-word remainder (port of rem_full)
      let shift = if d2[2] == 0U { clz32(d2[1]) } else { clz32(d2[2]) }
      let rshift = 32 - shift
      let buf : FixedArray[UInt] = [0U, 0U, 0U, 0U, 0U, 0U]
      let mut overflow : UInt = 0U
      let s_lo = d1_lo << shift
      buf[0] = s_lo.to_uint()
      buf[1] = (s_lo >> 32).to_uint()
      let s_mid = ((d1_lo >> 32) + (d1_hi.to_uint64() << 32)) >> rshift
      buf[2] = s_mid.to_uint()
      buf[3] = (s_mid >> 32).to_uint()
      let mut upper = 3

      while scale < 0 {
        let step = if -scale >= 9 { 9 } else { -scale }
        let power = POWERS_10[step].to_uint64()
        let mut tmp64 = buf[0].to_uint64() * power
        buf[0] = tmp64.to_uint()
        let mut idx = 1
        while idx < 6 && idx <= upper {
          tmp64 = (tmp64 >> 32) + buf[idx].to_uint64() * power
          buf[idx] = tmp64.to_uint()
          idx = idx + 1
        }
        if upper == 6 {
          tmp64 = (tmp64 >> 32) + overflow.to_uint64() * power
          overflow = tmp64.to_uint()
        }
        if tmp64 > 0x7FFFFFFFUL {
          upper = upper + 1
          if upper > 5 {
            overflow = (tmp64 >> 32).to_uint()
          } else {
            buf[upper] = (tmp64 >> 32).to_uint()
          }
        }
        scale = scale + 9
      }

      let tmp : FixedArray[UInt] = [0U, 0U, 0U, 0U]
      let divisor = (d2[0].to_uint64() | (d2[1].to_uint64() << 32)) << shift
      if d2[2] == 0U {
        if upper == 6 {
          upper = upper - 1
          tmp[0] = buf[4]
          tmp[1] = buf[5]
          tmp[2] = overflow
          tmp[3] = 0U
          let _ = partial_divide_64(tmp, divisor)
          buf[4] = tmp[0]
          buf[5] = tmp[1]
        }
        if upper == 5 {
          upper = upper - 1
          tmp[0] = buf[3]
          tmp[1] = buf[4]
          tmp[2] = buf[5]
          tmp[3] = 0U
          let _ = partial_divide_64(tmp, divisor)
          buf[3] = tmp[0]
          buf[4] = tmp[1]
          buf[5] = tmp[2]
        }
        if upper == 4 {
          tmp[0] = buf[2]
          tmp[1] = buf[3]
          tmp[2] = buf[4]
          tmp[3] = 0U
          let _ = partial_divide_64(tmp, divisor)
          buf[2] = tmp[0]
          buf[3] = tmp[1]
          buf[4] = tmp[2]
        }
        tmp[0] = buf[1]
        tmp[1] = buf[2]
        tmp[2] = buf[3]
        tmp[3] = 0U
        let _ = partial_divide_64(tmp, divisor)
        buf[1] = tmp[0]
        buf[2] = tmp[1]
        buf[3] = tmp[2]

        tmp[0] = buf[0]
        tmp[1] = buf[1]
        tmp[2] = buf[2]
        tmp[3] = 0U
        let _ = partial_divide_64(tmp, divisor)
        buf[0] = tmp[0]
        buf[1] = tmp[1]
        buf[2] = tmp[2]

        let res_lo = (buf[0].to_uint64() | (buf[1].to_uint64() << 32)) >> shift
        return Ok(make_decimal_nonzero_sign(res_lo, 0U, neg, d1_scale))
      } else {
        let div96 : FixedArray[UInt] = [
          divisor.to_uint(),
          (divisor >> 32).to_uint(),
          ((d2[1].to_uint64() + (d2[2].to_uint64() << 32)) >> rshift).to_uint(),
        ]
        if upper == 6 {
          upper = upper - 1
          tmp[0] = buf[3]
          tmp[1] = buf[4]
          tmp[2] = buf[5]
          tmp[3] = overflow
          let _ = partial_divide_96(tmp, div96)
          buf[3] = tmp[0]
          buf[4] = tmp[1]
          buf[5] = tmp[2]
        }
        if upper == 5 {
          upper = upper - 1
          tmp[0] = buf[2]
          tmp[1] = buf[3]
          tmp[2] = buf[4]
          tmp[3] = buf[5]
          let _ = partial_divide_96(tmp, div96)
          buf[2] = tmp[0]
          buf[3] = tmp[1]
          buf[4] = tmp[2]
          buf[5] = tmp[3]
        }
        if upper == 4 {
          tmp[0] = buf[1]
          tmp[1] = buf[2]
          tmp[2] = buf[3]
          tmp[3] = buf[4]
          let _ = partial_divide_96(tmp, div96)
          buf[1] = tmp[0]
          buf[2] = tmp[1]
          buf[3] = tmp[2]
          buf[4] = tmp[3]
        }
        tmp[0] = buf[0]
        tmp[1] = buf[1]
        tmp[2] = buf[2]
        tmp[3] = buf[3]
        let _ = partial_divide_96(tmp, div96)
        buf[0] = tmp[0]
        buf[1] = tmp[1]
        buf[2] = tmp[2]
        buf[3] = tmp[3]

        let bl = buf[0].to_uint64() | (buf[1].to_uint64() << 32)
        let res_lo = (bl >> shift) + ((buf[2].to_uint64() << rshift) << 32)
        let res_hi = buf[2] >> shift
        return Ok(make_decimal_nonzero_sign(res_lo, res_hi, neg, d1_scale))
      }
    }

    if scale >= 0 {
      break
    }
  }

  Ok(make_decimal_nonzero_sign(d1_lo, d1_hi, neg, d1_scale))
}
