///| Core 128-bit exact decimal types, errors, rounding strategies, and constants.

///| Maximum decimal scale supported (0..=28).
pub let MAX_SCALE : UInt = 28U

///| Sign bit mask in `flags` (bit 31).
pub let SIGN_MASK : UInt = 0x80000000U

///| Scale mask in `flags` (bits 16..23).
pub let SCALE_MASK : UInt = 0x00FF0000U

///| Scale bit shift in `flags`.
pub let SCALE_SHIFT : UInt = 16U

///| Error returned by fallible `Decimal` operations.
pub enum DecimalError {
  EmptyData
  InvalidCharacter
  InvalidLeadingChar
  DuplicatedDecimalPoint
  NoDigits
  Overflow
  Underflow
  DivisionByZero
  ScaleExceedsMaximumPrecision(UInt)
  ScientificBaseNotFound
  ScientificExpNotFound
  UnsupportedRadix
  InvalidDomain
}

///| Rounding strategy for `round_dp_with_strategy`.
pub enum RoundingStrategy {
  MidpointNearestEven
  MidpointAwayFromZero
  MidpointTowardZero
  ToZero
  AwayFromZero
  ToNegativeInfinity
  ToPositiveInfinity
}

///| 128-bit exact decimal number: 96-bit unsigned mantissa (`lo64` + `hi`) + `flags` (sign + scale 0..=28).
pub val struct Decimal {
  pub lo64 : UInt64
  pub hi : UInt
  pub flags : UInt
}

///|
pub let ZERO : Decimal = Decimal::{ lo64: 0UL, hi: 0U, flags: 0U }

///|
pub let ONE : Decimal = Decimal::{ lo64: 1UL, hi: 0U, flags: 0U }

///|
pub let NEGATIVE_ONE : Decimal = Decimal::{ lo64: 1UL, hi: 0U, flags: 0x80000000U }

///|
pub let TWO : Decimal = Decimal::{ lo64: 2UL, hi: 0U, flags: 0U }

///|
pub let TEN : Decimal = Decimal::{ lo64: 10UL, hi: 0U, flags: 0U }

///|
pub let HUNDRED : Decimal = Decimal::{ lo64: 100UL, hi: 0U, flags: 0U }

///| 79,228,162,514,264,337,593,543,950,335
pub let MAX : Decimal = Decimal::{ lo64: 0xFFFFFFFFFFFFFFFFUL, hi: 0xFFFFFFFFU, flags: 0U }

///| -79,228,162,514,264,337,593,543,950,335
pub let MIN : Decimal = Decimal::{
  lo64: 0xFFFFFFFFFFFFFFFFUL,
  hi: 0xFFFFFFFFU,
  flags: 0x80000000U,
}

///|
pub fn Decimal::zero() -> Decimal {
  ZERO
}

///|
pub fn Decimal::one() -> Decimal {
  ONE
}

///|
pub fn Decimal::negative_one() -> Decimal {
  NEGATIVE_ONE
}

///|
pub fn Decimal::two() -> Decimal {
  TWO
}

///|
pub fn Decimal::ten() -> Decimal {
  TEN
}

///|
pub fn Decimal::hundred() -> Decimal {
  HUNDRED
}

///|
pub fn Decimal::max() -> Decimal {
  MAX
}

///|
pub fn Decimal::min() -> Decimal {
  MIN
}

///|
pub fn Decimal::max_scale() -> UInt {
  MAX_SCALE
}

///|
pub fn Decimal::new(num : Int64, scale : UInt) -> Result[Decimal, DecimalError] {
  let _ = num
  let _ = scale
  Err(DecimalError::EmptyData)
}

///|
pub fn Decimal::from_i64(n : Int64) -> Decimal {
  let _ = n
  ZERO
}

///|
pub fn Decimal::from_u64(n : UInt64) -> Decimal {
  let _ = n
  ZERO
}

///|
pub fn Decimal::from_int(n : Int) -> Decimal {
  let _ = n
  ZERO
}

///|
pub fn Decimal::from_parts(
  lo : UInt,
  mid : UInt,
  hi : UInt,
  negative : Bool,
  scale : UInt,
) -> Result[Decimal, DecimalError] {
  let _ = lo
  let _ = mid
  let _ = hi
  let _ = negative
  let _ = scale
  Err(DecimalError::EmptyData)
}

///|
pub fn Decimal::scale(self : Decimal) -> UInt {
  let _ = self
  0U
}

///|
pub fn Decimal::is_sign_negative(self : Decimal) -> Bool {
  let _ = self
  false
}

///|
pub fn Decimal::is_sign_positive(self : Decimal) -> Bool {
  let _ = self
  true
}

///|
pub fn Decimal::is_zero(self : Decimal) -> Bool {
  let _ = self
  false
}

///|
pub fn Decimal::is_integer(self : Decimal) -> Bool {
  let _ = self
  false
}

///|
pub fn Decimal::lo(self : Decimal) -> UInt {
  let _ = self
  0U
}

///|
pub fn Decimal::mid(self : Decimal) -> UInt {
  let _ = self
  0U
}

///|
pub fn Decimal::hi(self : Decimal) -> UInt {
  let _ = self
  0U
}
