///| Core 128-bit exact decimal types, errors, rounding strategies, constants, and low-level 96/128/192-bit primitives.

///| Maximum decimal scale supported (0..=28).
pub let MAX_SCALE : UInt = 28U

///| Sign bit mask in `flags` (bit 31).
pub let SIGN_MASK : UInt = 0x80000000U

///| Scale mask in `flags` (bits 16..23).
pub let SCALE_MASK : UInt = 0x00FF0000U

///| Scale bit shift in `flags`.
pub let SCALE_SHIFT : UInt = 16U

///| 10^0 .. 10^9 as UInt.
let POWERS_10 : FixedArray[UInt] = [
  1U, 10U, 100U, 1000U, 10000U, 100000U, 1000000U, 10000000U, 100000000U, 1000000000U,
]

///| 10^0 .. 10^19 as UInt64.
let POWERS_10_U64 : FixedArray[UInt64] = [
  1UL, 10UL, 100UL, 1000UL, 10000UL, 100000UL, 1000000UL, 10000000UL, 100000000UL, 1000000000UL,
  10000000000UL, 100000000000UL, 1000000000000UL, 10000000000000UL, 100000000000000UL,
  1000000000000000UL, 10000000000000000UL, 100000000000000000UL, 1000000000000000000UL,
  10000000000000000000UL,
]

///| Pure power-of-10 lookup for 0..=9 (returns 10^k as UInt; clamped to 10^0 / 10^9 outside range).
#verify
fn pow10_u32(k : Int) -> UInt {
  if k < 5 {
    if k < 2 {
      if k <= 0 { 1U } else { 10U }
    } else if k == 2 {
      100U
    } else if k == 3 {
      1000U
    } else {
      10000U
    }
  } else if k < 7 {
    if k == 5 { 100000U } else { 1000000U }
  } else if k == 7 {
    10000000U
  } else if k == 8 {
    100000000U
  } else {
    1000000000U
  }
}

///| Pure power-of-10 lookup for 0..=19 (returns 10^k as UInt64; clamped to 10^0 / 10^19 outside range).
#verify
fn pow10_u64(k : Int) -> UInt64 {
  if k < 10 {
    pow10_u32(k).to_uint64()
  } else if k < 15 {
    if k < 12 {
      if k == 10 { 10000000000UL } else { 100000000000UL }
    } else if k == 12 {
      1000000000000UL
    } else if k == 13 {
      10000000000000UL
    } else {
      100000000000000UL
    }
  } else if k < 17 {
    if k == 15 { 1000000000000000UL } else { 10000000000000000UL }
  } else if k == 17 {
    100000000000000000UL
  } else if k == 18 {
    1000000000000000000UL
  } else {
    10000000000000000000UL
  }
}

///| Error returned by fallible `Decimal` operations.
pub enum DecimalError {
  EmptyData
  InvalidCharacter
  InvalidLeadingChar
  DuplicatedDecimalPoint
  NoDigits
  Overflow
  Underflow
  DivisionByZero
  ScaleExceedsMaximumPrecision(UInt)
  ScientificBaseNotFound
  ScientificExpNotFound
  UnsupportedRadix
  InvalidDomain
}

///| Rounding strategy for `round_dp_with_strategy`.
pub enum RoundingStrategy {
  MidpointNearestEven
  MidpointAwayFromZero
  MidpointTowardZero
  ToZero
  AwayFromZero
  ToNegativeInfinity
  ToPositiveInfinity
}

///| 128-bit exact decimal number: 96-bit unsigned mantissa (`lo64` + `hi`) + `flags` (sign + scale 0..=28).
pub val struct Decimal {
  pub lo64 : UInt64
  pub hi : UInt
  pub flags : UInt
}

///|
pub let ZERO : Decimal = Decimal::{ lo64: 0UL, hi: 0U, flags: 0U }

///|
pub let ONE : Decimal = Decimal::{ lo64: 1UL, hi: 0U, flags: 0U }

///|
pub let NEGATIVE_ONE : Decimal = Decimal::{ lo64: 1UL, hi: 0U, flags: 0x80000000U }

///|
pub let TWO : Decimal = Decimal::{ lo64: 2UL, hi: 0U, flags: 0U }

///|
pub let TEN : Decimal = Decimal::{ lo64: 10UL, hi: 0U, flags: 0U }

///|
pub let HUNDRED : Decimal = Decimal::{ lo64: 100UL, hi: 0U, flags: 0U }

///| 79,228,162,514,264,337,593,543,950,335
pub let MAX : Decimal = Decimal::{ lo64: 0xFFFFFFFFFFFFFFFFUL, hi: 0xFFFFFFFFU, flags: 0U }

///| -79,228,162,514,264,337,593,543,950,335
pub let MIN : Decimal = Decimal::{
  lo64: 0xFFFFFFFFFFFFFFFFUL,
  hi: 0xFFFFFFFFU,
  flags: 0x80000000U,
}

///|
#verify
fn make_flags(negative : Bool, scale : UInt) -> UInt {
  let s = (scale & 0xFFU) << 16
  if negative {
    s | SIGN_MASK
  } else {
    s
  }
}

///|
#verify
fn make_decimal_raw(lo64 : UInt64, hi : UInt, flags : UInt) -> Decimal {
  Decimal::{ lo64, hi, flags }
}

///|
#verify
fn make_decimal(lo64 : UInt64, hi : UInt, negative : Bool, scale : UInt) -> Decimal {
  Decimal::{ lo64, hi, flags: make_flags(negative, scale) }
}

///|
#verify
fn make_decimal_nonzero_sign(lo64 : UInt64, hi : UInt, negative : Bool, scale : UInt) -> Decimal {
  let neg = if lo64 == 0UL && hi == 0U { false } else { negative }
  Decimal::{ lo64, hi, flags: make_flags(neg, scale) }
}

///|
pub fn Decimal::zero() -> Decimal {
  ZERO
}

///|
pub fn Decimal::one() -> Decimal {
  ONE
}

///|
pub fn Decimal::negative_one() -> Decimal {
  NEGATIVE_ONE
}

///|
pub fn Decimal::two() -> Decimal {
  TWO
}

///|
pub fn Decimal::ten() -> Decimal {
  TEN
}

///|
pub fn Decimal::hundred() -> Decimal {
  HUNDRED
}

///|
pub fn Decimal::max() -> Decimal {
  MAX
}

///|
pub fn Decimal::min() -> Decimal {
  MIN
}

///|
pub fn Decimal::max_scale() -> UInt {
  MAX_SCALE
}

///|
#verify
pub fn Decimal::new(num : Int64, scale : UInt) -> Result[Decimal, DecimalError] {
  if scale > MAX_SCALE {
    return Err(DecimalError::ScaleExceedsMaximumPrecision(scale))
  }
  if num < 0L {
    let mag : UInt64 = (0UL) - num.to_uint64()
    Ok(Decimal::{ lo64: mag, hi: 0U, flags: make_flags(true, scale) })
  } else {
    Ok(Decimal::{ lo64: num.to_uint64(), hi: 0U, flags: make_flags(false, scale) })
  }
}

///|
#verify
pub fn Decimal::from_i64(n : Int64) -> Decimal {
  if n < 0L {
    let mag : UInt64 = (0UL) - n.to_uint64()
    Decimal::{ lo64: mag, hi: 0U, flags: SIGN_MASK }
  } else {
    Decimal::{ lo64: n.to_uint64(), hi: 0U, flags: 0U }
  }
}

///|
#verify
pub fn Decimal::from_u64(n : UInt64) -> Decimal {
  Decimal::{ lo64: n, hi: 0U, flags: 0U }
}

///|
#verify
pub fn Decimal::from_int(n : Int) -> Decimal {
  Decimal::from_i64(n.to_int64())
}

///|
#verify
pub fn Decimal::from_parts(
  lo : UInt,
  mid : UInt,
  hi : UInt,
  negative : Bool,
  scale : UInt,
) -> Result[Decimal, DecimalError] {
  if scale > MAX_SCALE {
    return Err(DecimalError::ScaleExceedsMaximumPrecision(scale))
  }
  let lo64 = lo.to_uint64() | (mid.to_uint64() << 32)
  Ok(Decimal::{ lo64, hi, flags: make_flags(negative, scale) })
}

///|
#verify
pub fn Decimal::scale(self : Decimal) -> UInt {
  (self.flags & SCALE_MASK) >> 16
}

///|
#verify
pub fn Decimal::is_sign_negative(self : Decimal) -> Bool {
  (self.flags & SIGN_MASK) != 0U
}

///|
#verify
pub fn Decimal::is_sign_positive(self : Decimal) -> Bool {
  (self.flags & SIGN_MASK) == 0U
}

///|
#verify
pub fn Decimal::is_zero(self : Decimal) -> Bool {
  self.lo64 == 0UL && self.hi == 0U
}

///|
pub fn Decimal::is_integer(self : Decimal) -> Bool {
  let s = self.scale()
  if s == 0U || self.is_zero() {
    return true
  }
  self.fract().is_zero()
}

///|
#verify
pub fn Decimal::lo(self : Decimal) -> UInt {
  self.lo64.to_uint()
}

///|
#verify
pub fn Decimal::mid(self : Decimal) -> UInt {
  (self.lo64 >> 32).to_uint()
}

///|
pub fn Decimal::hi(self : Decimal) -> UInt {
  self.hi
}

// === Low-level multi-precision helpers ===

///| Count leading zeros of a 32-bit unsigned integer (returns 0..=32).
fn clz32(x : UInt) -> Int {
  if x == 0U {
    return 32
  }
  let mut v = x
  let mut n = 0
  if (v & 0xFFFF0000U) == 0U {
    n = n + 16
    v = v << 16
  }
  if (v & 0xFF000000U) == 0U {
    n = n + 8
    v = v << 8
  }
  if (v & 0xF0000000U) == 0U {
    n = n + 4
    v = v << 4
  }
  if (v & 0xC0000000U) == 0U {
    n = n + 2
    v = v << 2
  }
  if (v & 0x80000000U) == 0U {
    n = n + 1
  }
  n
}

///| Exact 64x64 -> 128-bit unsigned multiplication returning (lo64, hi64).
#verify
fn u64_mul_wide(a : UInt64, b : UInt64) -> (UInt64, UInt64) {
  let a_lo = a & 0xFFFFFFFFUL
  let a_hi = a >> 32
  let b_lo = b & 0xFFFFFFFFUL
  let b_hi = b >> 32
  let p0 = a_lo * b_lo
  let p1 = a_lo * b_hi
  let p2 = a_hi * b_lo
  let p3 = a_hi * b_hi
  let mid = (p0 >> 32) + (p1 & 0xFFFFFFFFUL) + (p2 & 0xFFFFFFFFUL)
  let lo = (p0 & 0xFFFFFFFFUL) | (mid << 32)
  let hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
  (lo, hi)
}

///| Divide 96-bit [lo, mid, hi] in-place by UInt divisor; returns remainder.
fn u96_div_u32(d : FixedArray[UInt], divisor : UInt) -> UInt {
  let div64 = divisor.to_uint64()
  let mut rem : UInt64 = 0UL
  let mut i = 2
  while i >= 0 {
    let cur = (rem << 32) | d[i].to_uint64()
    let q = cur / div64
    rem = cur - q * div64
    d[i] = q.to_uint()
    i = i - 1
  }
  rem.to_uint()
}

///| Multiply 96-bit [lo, mid, hi] in-place by UInt multiplier; returns carry.
fn u96_mul_u32(d : FixedArray[UInt], mul : UInt) -> UInt {
  let mul64 = mul.to_uint64()
  let mut carry : UInt64 = 0UL
  let mut i = 0
  while i < 3 {
    let cur = d[i].to_uint64() * mul64 + carry
    d[i] = cur.to_uint()
    carry = cur >> 32
    i = i + 1
  }
  carry.to_uint()
}

///| Add UInt to 96-bit [lo, mid, hi] in-place; returns carry (0 or 1).
fn u96_add_u32(d : FixedArray[UInt], addend : UInt) -> UInt {
  let mut carry : UInt64 = addend.to_uint64()
  let mut i = 0
  while i < 3 && carry != 0UL {
    let cur = d[i].to_uint64() + carry
    d[i] = cur.to_uint()
    carry = cur >> 32
    i = i + 1
  }
  carry.to_uint()
}

///| Subtract 96-bit b from 96-bit a in-place (assumes a >= b).
fn u96_sub(a : FixedArray[UInt], b : FixedArray[UInt]) -> Unit {
  let mut borrow : UInt64 = 0UL
  let mut i = 0
  while i < 3 {
    let av = a[i].to_uint64()
    let bv = b[i].to_uint64() + borrow
    if av >= bv {
      a[i] = (av - bv).to_uint()
      borrow = 0UL
    } else {
      a[i] = ((1UL << 32) + av - bv).to_uint()
      borrow = 1UL
    }
    i = i + 1
  }
}

///| Compare two 96-bit unsigned integers [lo, mid, hi].
#verify
fn u96_cmp(a : FixedArray[UInt], b : FixedArray[UInt]) -> Int {
  let mut i = 2
  while i >= 0 {
    if a[i] < b[i] {
      return -1
    }
    if a[i] > b[i] {
      return 1
    }
    i = i - 1
  }
  0
}

///| Return index of highest non-zero word in 6-word (192-bit) buffer.
fn u192_upper_word(buf : FixedArray[UInt]) -> Int {
  let mut i = 5
  while i > 0 {
    if buf[i] != 0U {
      return i
    }
    i = i - 1
  }
  0
}

///| Rescale a 192-bit buffer (6 x UInt) down to fit in 96 bits and scale <= 28 with banker's rounding.
///| Port of `rust_decimal::ops::common::Buf24::rescale`.
fn u192_rescale(buf : FixedArray[UInt], upper_in : Int, scale_in : Int) -> Option[UInt] {
  let mut scale = scale_in
  let mut upper = upper_in
  let mut rescale_target = 0

  if upper > 2 {
    rescale_target = upper * 32 - 64 - 1
    rescale_target = rescale_target - clz32(buf[upper])
    rescale_target = ((rescale_target * 77) >> 8) + 1
    if rescale_target > scale {
      return None
    }
  }

  if rescale_target < scale - 28 {
    rescale_target = scale - 28
  }

  if rescale_target > 0 {
    scale = scale - rescale_target
    let mut sticky : UInt = 0U
    let mut remainder : UInt = 0U
    while true {
      sticky = sticky | remainder
      let mut power : UInt = if rescale_target > 8 {
        POWERS_10[9]
      } else {
        POWERS_10[rescale_target]
      }
      let power64 = power.to_uint64()
      let high = buf[upper]
      let high_q = high / power
      remainder = high - high_q * power

      let mut idx = upper - 1
      while idx >= 0 {
        let num = buf[idx].to_uint64() + (remainder.to_uint64() << 32)
        let q = (num / power64).to_uint()
        buf[idx] = q
        remainder = num.to_uint() - q * power
        idx = idx - 1
      }
      buf[upper] = high_q

      if high_q == 0U && upper > 0 {
        upper = upper - 1
      }
      if rescale_target > 9 {
        rescale_target = rescale_target - 9
        continue
      }

      if upper > 2 {
        if scale == 0 {
          return None
        }
        rescale_target = 1
        scale = scale - 1
        continue
      }

      // Banker's rounding
      power = power >> 1
      let carried = if power <= remainder {
        if power < remainder || ((buf[0] & 1U) | sticky) != 0U {
          buf[0] = buf[0] + 1U
          buf[0] == 0U
        } else {
          false
        }
      } else {
        false
      }

      if carried {
        let mut pos = 0
        let mut k = 1
        while k < 6 {
          pos = k
          buf[k] = buf[k] + 1U
          if buf[k] != 0U {
            break
          }
          k = k + 1
        }
        if pos > 2 {
          if scale == 0 {
            return None
          }
          upper = pos
          sticky = 0U
          remainder = 0U
          rescale_target = 1
          scale = scale - 1
          continue
        }
      }
      break
    }
  }

  Some(scale.to_uint())
}
