///| Rounding (all 7 strategies), normalization, scale adjustment, floor, ceil, trunc, fract.

///| Scale up 96-bit `(lo64, hi)` from `old_scale` toward `target` without overflowing 96 bits (zero heap alloc).
#verify
fn scale_up_96(lo64_in : UInt64, hi_in : UInt, old_scale : UInt, target : UInt, negative : Bool) -> Decimal {
  let mut lo64 = lo64_in
  let mut hi = hi_in
  let mut cur_scale = old_scale
  while cur_scale < target {
    let t_lo = (lo64 & 0xFFFFFFFFUL) * 10UL
    let t_mid = (lo64 >> 32) * 10UL + (t_lo >> 32)
    let t_hi = hi.to_uint64() * 10UL + (t_mid >> 32)
    if t_hi > 0xFFFFFFFFUL {
      break
    }
    lo64 = (t_lo & 0xFFFFFFFFUL) | (t_mid << 32)
    hi = t_hi.to_uint()
    cur_scale = cur_scale + 1U
  }
  make_decimal(lo64, hi, negative, cur_scale)
}

///| Strip trailing zeros and convert `-0` / `-0.0` to `0` (zero heap alloc).
pub fn Decimal::normalize(self : Decimal) -> Decimal {
  if self.is_zero() {
    return ZERO
  }
  let mut scale = self.scale().to_int()
  if scale == 0 || (self.lo64 & 1UL) == 1UL {
    return self
  }
  if self.hi == 0U {
    let mut v = self.lo64
    while scale > 0 && (v % 10UL) == 0UL {
      v = v / 10UL
      scale = scale - 1
    }
    return make_decimal(v, 0U, self.is_sign_negative(), scale.to_uint())
  }
  let mut q0 = self.lo64.to_uint()
  let mut q1 = (self.lo64 >> 32).to_uint()
  let mut q2 = self.hi
  // Division-free mod-5 test: 2^16 == 1 (mod 5), so 96-bit value is divisible by 5 iff sum of 16-bit limbs is.
  let s5 = (q0 & 0xFFFFU) + (q0 >> 16) + (q1 & 0xFFFFU) + (q1 >> 16) + (q2 & 0xFFFFU) + (q2 >> 16)
  let q5 = ((s5.to_uint64() * 0xCCCCCCCDUL) >> 34).to_uint()
  if s5 != q5 * 5U {
    return self
  }
  while (q0 & 0xFFU) == 0U && scale >= 8 {
    let pow64 = 100000000UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 100000000U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 8
    } else {
      break
    }
  }
  while (q0 & 0xFU) == 0U && scale >= 4 {
    let pow64 = 10000UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 10000U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 4
    } else {
      break
    }
  }
  while (q0 & 0x3U) == 0U && scale >= 2 {
    let pow64 = 100UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 100U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 2
    } else {
      break
    }
  }
  while (q0 & 0x1U) == 0U && scale >= 1 {
    let pow64 = 10UL
    let high64 = q1.to_uint64() | (q2.to_uint64() << 32)
    let div64 = high64 / pow64
    let div = ((((high64 - div64 * pow64) << 32) + q0.to_uint64()) / pow64).to_uint()
    if q0 == div * 10U {
      q1 = div64.to_uint()
      q2 = (div64 >> 32).to_uint()
      q0 = div
      scale = scale - 1
    } else {
      break
    }
  }
  let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  make_decimal(lo64, q2, self.is_sign_negative(), scale.to_uint())
}

///|
#verify
pub fn Decimal::set_scale(self : Decimal, scale : UInt) -> Result[Decimal, DecimalError] {
  if scale > MAX_SCALE {
    return Err(DecimalError::ScaleExceedsMaximumPrecision(scale))
  }
  Ok(make_decimal(self.lo64, self.hi, self.is_sign_negative(), scale))
}

///| Adjust scale to `new_scale` (capped at 28), rounding down or scaling up without overflowing 96-bit.
pub fn Decimal::rescale(self : Decimal, new_scale : UInt) -> Decimal {
  let target = if new_scale > MAX_SCALE { MAX_SCALE } else { new_scale }
  let old_scale = self.scale()
  if old_scale == target {
    return self
  }
  if self.is_zero() {
    return make_decimal(0UL, 0U, self.is_sign_negative(), target)
  }
  if old_scale > target {
    // rust_decimal::rescale preserves sign bit even when rounding down to zero
    return round_dp_code(self, target, 1, false)
  }
  scale_up_96(self.lo64, self.hi, old_scale, target, self.is_sign_negative())
}

///| Stack-allocated result of `truncate_core_val` (zero heap allocation).
val struct TruncResult {
  dec : Decimal
  had_rem : Bool
}

///| Truncate `d` to `target_scale` (zero heap alloc); returns `TruncResult`.
fn truncate_core_val(self : Decimal, target_scale : UInt) -> TruncResult {
  let cur_scale = self.scale()
  if cur_scale <= target_scale {
    return TruncResult::{ dec: self, had_rem: false }
  }
  let mut drop = (cur_scale - target_scale).to_int()
  if self.hi == 0U && drop <= 19 {
    let pow = pow10_u64(drop)
    let q = self.lo64 / pow
    let had_rem = (self.lo64 - q * pow) != 0UL
    return TruncResult::{
      dec: make_decimal(q, 0U, self.is_sign_negative(), target_scale),
      had_rem,
    }
  }
  let mut q0 = self.lo64.to_uint()
  let mut q1 = (self.lo64 >> 32).to_uint()
  let mut q2 = self.hi
  let mut had_rem = false
  while drop > 0 {
    let step = if drop > 9 { 9 } else { drop }
    let div64 = pow10_u32(step).to_uint64()
    let c2 = q2.to_uint64()
    let n2 = c2 / div64
    let r2 = c2 - n2 * div64
    q2 = n2.to_uint()
    let c1 = (r2 << 32) | q1.to_uint64()
    let n1 = c1 / div64
    let r1 = c1 - n1 * div64
    q1 = n1.to_uint()
    let c0 = (r1 << 32) | q0.to_uint64()
    let n0 = c0 / div64
    let r0 = c0 - n0 * div64
    q0 = n0.to_uint()
    if r0 != 0UL {
      had_rem = true
    }
    drop = drop - step
  }
  let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  TruncResult::{
    dec: make_decimal(lo64, q2, self.is_sign_negative(), target_scale),
    had_rem,
  }
}

///| Truncate `d` to `target_scale` (zero heap alloc); returns true if any non-zero fractional digit was discarded.
#verify
fn truncate_core(self : Decimal, target_scale : UInt) -> (Decimal, Bool) {
  let cur_scale = self.scale()
  if cur_scale <= target_scale {
    return (self, false)
  }
  let mut drop = (cur_scale - target_scale).to_int()
  if self.hi == 0U && drop <= 19 {
    let pow = pow10_u64(drop)
    let q = self.lo64 / pow
    let had_rem = (self.lo64 - q * pow) != 0UL
    return (make_decimal(q, 0U, self.is_sign_negative(), target_scale), had_rem)
  }
  let mut q0 = self.lo64.to_uint()
  let mut q1 = (self.lo64 >> 32).to_uint()
  let mut q2 = self.hi
  let mut had_rem = false
  while drop > 0 {
    let step = if drop > 9 { 9 } else { drop }
    let div64 = pow10_u32(step).to_uint64()
    let c2 = q2.to_uint64()
    let n2 = c2 / div64
    let r2 = c2 - n2 * div64
    q2 = n2.to_uint()
    let c1 = (r2 << 32) | q1.to_uint64()
    let n1 = c1 / div64
    let r1 = c1 - n1 * div64
    q1 = n1.to_uint()
    let c0 = (r1 << 32) | q0.to_uint64()
    let n0 = c0 / div64
    let r0 = c0 - n0 * div64
    q0 = n0.to_uint()
    if r0 != 0UL {
      had_rem = true
    }
    drop = drop - step
  }
  let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  (make_decimal(lo64, q2, self.is_sign_negative(), target_scale), had_rem)
}

///|
#verify
pub fn Decimal::trunc(self : Decimal) -> Decimal {
  let (d, _) = truncate_core(self, 0U)
  d
}

///| Truncate or pad zeros to `scale` (capped at 28, matching `rust_decimal` without panicking on scale > 28).
pub fn Decimal::trunc_with_scale(self : Decimal, scale : UInt) -> Decimal {
  let target = if scale > MAX_SCALE { MAX_SCALE } else { scale }
  let old_scale = self.scale()
  if old_scale == target {
    return self
  }
  if self.is_zero() {
    return make_decimal(0UL, 0U, self.is_sign_negative(), target)
  }
  if old_scale > target {
    return truncate_core_val(self, target).dec
  }
  scale_up_96(self.lo64, self.hi, old_scale, target, self.is_sign_negative())
}

///|
pub fn Decimal::fract(self : Decimal) -> Decimal {
  match self.checked_sub(self.trunc()) {
    Ok(d) => d
    Err(_) => ZERO
  }
}

///|
pub fn Decimal::floor(self : Decimal) -> Decimal {
  if self.scale() == 0U {
    return self
  }
  let tr = truncate_core_val(self, 0U)
  if self.is_sign_negative() && tr.had_rem {
    match tr.dec.checked_sub(ONE) {
      Ok(d) => d
      Err(_) => tr.dec
    }
  } else {
    tr.dec
  }
}

///|
pub fn Decimal::ceil(self : Decimal) -> Decimal {
  if self.scale() == 0U {
    return self
  }
  let tr = truncate_core_val(self, 0U)
  if self.is_sign_positive() && tr.had_rem {
    match tr.dec.checked_add(ONE) {
      Ok(d) => d
      Err(_) => tr.dec
    }
  } else {
    tr.dec
  }
}

///| Map `RoundingStrategy` to an integer tag (avoids cross-package inlining of fieldless enum variants in `--release`).
fn strategy_to_code(strategy : RoundingStrategy) -> Int {
  match strategy {
    RoundingStrategy::MidpointNearestEven => 0
    RoundingStrategy::MidpointAwayFromZero => 1
    RoundingStrategy::MidpointTowardZero => 2
    RoundingStrategy::ToZero => 3
    RoundingStrategy::AwayFromZero => 4
    RoundingStrategy::ToNegativeInfinity => 5
    RoundingStrategy::ToPositiveInfinity => 6
  }
}

///|
pub fn Decimal::round(self : Decimal) -> Decimal {
  round_dp_code(self, 0U, 0, true)
}

///|
pub fn Decimal::round_dp(self : Decimal, dp : UInt) -> Decimal {
  round_dp_code(self, dp, 0, true)
}

///| Round `self` to `dp` decimal places using any of the 7 `RoundingStrategy` modes.
pub fn Decimal::round_dp_with_strategy(
  self : Decimal,
  dp : UInt,
  strategy : RoundingStrategy,
) -> Decimal {
  round_dp_code(self, dp, strategy_to_code(strategy), true)
}

///| Internal zero-allocation rounding keyed by integer strategy code (0..=6).
fn round_dp_code(self : Decimal, dp : UInt, code : Int, clear_zero_sign : Bool) -> Decimal {
  let old_scale = self.scale()
  if old_scale <= dp {
    return self
  }
  let negative = self.is_sign_negative()
  if self.is_zero() {
    return make_decimal(0UL, 0U, negative, dp)
  }

  let diff = (old_scale - dp).to_int()

  // Fast path: 64-bit mantissa and diff <= 19 (single UInt64 division)
  if self.hi == 0U && diff <= 19 {
    let pow = pow10_u64(diff)
    let mut q = self.lo64 / pow
    let rem = self.lo64 - q * pow
    let half = pow >> 1
    let round_up = if code == 0 {
      rem > half || (rem == half && (q & 1UL) == 1UL)
    } else if code == 1 {
      rem >= half
    } else if code == 2 {
      rem > half
    } else if code == 3 {
      false
    } else if code == 4 {
      rem != 0UL
    } else if code == 5 {
      negative && rem != 0UL
    } else {
      !negative && rem != 0UL
    }
    if round_up {
      q = q + 1UL
    }
    if clear_zero_sign {
      return make_decimal_nonzero_sign(q, 0U, negative, dp)
    }
    return make_decimal(q, 0U, negative, dp)
  }

  // General 96-bit scalar single-pass division with sticky bit (zero heap allocations)
  let mut q0 = self.lo64.to_uint()
  let mut q1 = (self.lo64 >> 32).to_uint()
  let mut q2 = self.hi
  let mut rem_diff = diff
  let mut sticky = false
  while rem_diff > 9 {
    let div64 = 1000000000UL
    if q2 == 0U {
      let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
      let q = lo64 / div64
      if lo64 != q * div64 {
        sticky = true
      }
      q0 = q.to_uint()
      q1 = (q >> 32).to_uint()
    } else {
      let c2 = q2.to_uint64()
      let n2 = c2 / div64
      let r2 = c2 - n2 * div64
      q2 = n2.to_uint()
      let c1 = (r2 << 32) | q1.to_uint64()
      let n1 = c1 / div64
      let r1 = c1 - n1 * div64
      q1 = n1.to_uint()
      let c0 = (r1 << 32) | q0.to_uint64()
      let n0 = c0 / div64
      let r0 = c0 - n0 * div64
      q0 = n0.to_uint()
      if r0 != 0UL {
        sticky = true
      }
    }
    rem_diff = rem_diff - 9
  }
  let pow = pow10_u32(rem_diff)
  let pow64 = pow.to_uint64()
  let mut rem : UInt = 0U
  if q2 == 0U {
    let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
    let q = lo64 / pow64
    rem = (lo64 - q * pow64).to_uint()
    q0 = q.to_uint()
    q1 = (q >> 32).to_uint()
  } else {
    let c2 = q2.to_uint64()
    let n2 = c2 / pow64
    let r2 = c2 - n2 * pow64
    q2 = n2.to_uint()
    let c1 = (r2 << 32) | q1.to_uint64()
    let n1 = c1 / pow64
    let r1 = c1 - n1 * pow64
    q1 = n1.to_uint()
    let c0 = (r1 << 32) | q0.to_uint64()
    let n0 = c0 / pow64
    rem = (c0 - n0 * pow64).to_uint()
    q0 = n0.to_uint()
  }

  let half = pow >> 1
  let is_nonzero_rem = rem != 0U || sticky
  let gt_half = rem > half || (rem == half && sticky)
  let eq_half = rem == half && !sticky

  let round_up = if code == 0 {
    gt_half || (eq_half && (q0 & 1U) == 1U)
  } else if code == 1 {
    gt_half || eq_half
  } else if code == 2 {
    gt_half
  } else if code == 3 {
    false
  } else if code == 4 {
    is_nonzero_rem
  } else if code == 5 {
    negative && is_nonzero_rem
  } else {
    !negative && is_nonzero_rem
  }

  if round_up {
    let s0 = q0.to_uint64() + 1UL
    q0 = s0.to_uint()
    if s0 > 0xFFFFFFFFUL {
      let s1 = q1.to_uint64() + 1UL
      q1 = s1.to_uint()
      if s1 > 0xFFFFFFFFUL {
        q2 = q2 + 1U
      }
    }
  }
  let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  if clear_zero_sign {
    make_decimal_nonzero_sign(lo64, q2, negative, dp)
  } else {
    make_decimal(lo64, q2, negative, dp)
  }
}
