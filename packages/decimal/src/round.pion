///| Rounding (all 7 strategies), normalization, scale adjustment, floor, ceil, trunc, fract.

///| Strip trailing zeros and convert `-0` / `-0.0` to `0`.
pub fn Decimal::normalize(self : Decimal) -> Decimal {
  if self.is_zero() {
    return ZERO
  }
  let mut scale = self.scale().to_int()
  if scale == 0 || (self.lo64 & 1UL) == 1UL {
    return self
  }
  if self.hi == 0U {
    let mut v = self.lo64
    while scale > 0 && (v % 10UL) == 0UL {
      v = v / 10UL
      scale = scale - 1
    }
    return make_decimal(v, 0U, self.is_sign_negative(), scale.to_uint())
  }
  let q : FixedArray[UInt] = [
    self.lo64.to_uint(),
    (self.lo64 >> 32).to_uint(),
    self.hi,
  ]
  scale = unscale_96(q, scale)
  let lo64 = q[0].to_uint64() | (q[1].to_uint64() << 32)
  make_decimal(lo64, q[2], self.is_sign_negative(), scale.to_uint())
}

///|
pub fn Decimal::set_scale(self : Decimal, scale : UInt) -> Result[Decimal, DecimalError] {
  if scale > MAX_SCALE {
    return Err(DecimalError::ScaleExceedsMaximumPrecision(scale))
  }
  Ok(make_decimal(self.lo64, self.hi, self.is_sign_negative(), scale))
}

///| Adjust scale to `new_scale` (capped at 28), rounding down or scaling up without overflowing 96-bit.
pub fn Decimal::rescale(self : Decimal, new_scale : UInt) -> Decimal {
  let target = if new_scale > MAX_SCALE { MAX_SCALE } else { new_scale }
  let old_scale = self.scale()
  if old_scale == target {
    return self
  }
  if self.is_zero() {
    return make_decimal(0UL, 0U, self.is_sign_negative(), target)
  }
  if old_scale > target {
    return round_dp_code(self, target, 1)
  }
  // Scale up without overflowing 96-bit
  let d : FixedArray[UInt] = [
    self.lo64.to_uint(),
    (self.lo64 >> 32).to_uint(),
    self.hi,
  ]
  let mut cur_scale = old_scale
  while cur_scale < target {
    let prev0 = d[0]
    let prev1 = d[1]
    let prev2 = d[2]
    let ov = u96_mul_u32(d, 10U)
    if ov != 0U {
      d[0] = prev0
      d[1] = prev1
      d[2] = prev2
      break
    }
    cur_scale = cur_scale + 1U
  }
  let lo64 = d[0].to_uint64() | (d[1].to_uint64() << 32)
  make_decimal(lo64, d[2], self.is_sign_negative(), cur_scale)
}

///| Truncate `d` to `target_scale` in-place; returns true if any non-zero fractional digit was discarded.
fn truncate_core(self : Decimal, target_scale : UInt) -> (Decimal, Bool) {
  let cur_scale = self.scale()
  if cur_scale <= target_scale {
    return (self, false)
  }
  let mut drop = (cur_scale - target_scale).to_int()
  if self.hi == 0U && drop <= 19 {
    let pow = POWERS_10_U64[drop]
    let q = self.lo64 / pow
    let had_rem = (self.lo64 - q * pow) != 0UL
    return (make_decimal(q, 0U, self.is_sign_negative(), target_scale), had_rem)
  }
  let d : FixedArray[UInt] = [
    self.lo64.to_uint(),
    (self.lo64 >> 32).to_uint(),
    self.hi,
  ]
  let mut had_rem = false
  while drop > 0 {
    let step = if drop > 9 { 9 } else { drop }
    let r = u96_div_u32(d, POWERS_10[step])
    if r != 0U {
      had_rem = true
    }
    drop = drop - step
  }
  let lo64 = d[0].to_uint64() | (d[1].to_uint64() << 32)
  (make_decimal(lo64, d[2], self.is_sign_negative(), target_scale), had_rem)
}

///|
pub fn Decimal::trunc(self : Decimal) -> Decimal {
  let (d, _) = truncate_core(self, 0U)
  d
}

///|
pub fn Decimal::trunc_with_scale(self : Decimal, scale : UInt) -> Decimal {
  let capped = if scale > MAX_SCALE { MAX_SCALE } else { scale }
  let (d, _) = truncate_core(self, capped)
  d
}

///|
pub fn Decimal::fract(self : Decimal) -> Decimal {
  match self.checked_sub(self.trunc()) {
    Ok(d) => d
    Err(_) => ZERO
  }
}

///|
pub fn Decimal::floor(self : Decimal) -> Decimal {
  if self.scale() == 0U {
    return self
  }
  let (floored, had_frac) = truncate_core(self, 0U)
  if self.is_sign_negative() && had_frac {
    match floored.checked_sub(ONE) {
      Ok(d) => d
      Err(_) => floored
    }
  } else {
    floored
  }
}

///|
pub fn Decimal::ceil(self : Decimal) -> Decimal {
  if self.scale() == 0U {
    return self
  }
  let (truncated, had_frac) = truncate_core(self, 0U)
  if self.is_sign_positive() && had_frac {
    match truncated.checked_add(ONE) {
      Ok(d) => d
      Err(_) => truncated
    }
  } else {
    truncated
  }
}

///| Map `RoundingStrategy` to an integer tag (avoids cross-package inlining of fieldless enum variants in `--release`).
fn strategy_to_code(strategy : RoundingStrategy) -> Int {
  match strategy {
    RoundingStrategy::MidpointNearestEven => 0
    RoundingStrategy::MidpointAwayFromZero => 1
    RoundingStrategy::MidpointTowardZero => 2
    RoundingStrategy::ToZero => 3
    RoundingStrategy::AwayFromZero => 4
    RoundingStrategy::ToNegativeInfinity => 5
    RoundingStrategy::ToPositiveInfinity => 6
  }
}

///|
pub fn Decimal::round(self : Decimal) -> Decimal {
  round_dp_code(self, 0U, 0)
}

///|
pub fn Decimal::round_dp(self : Decimal, dp : UInt) -> Decimal {
  round_dp_code(self, dp, 0)
}

///| Round `self` to `dp` decimal places using any of the 7 `RoundingStrategy` modes.
pub fn Decimal::round_dp_with_strategy(
  self : Decimal,
  dp : UInt,
  strategy : RoundingStrategy,
) -> Decimal {
  round_dp_code(self, dp, strategy_to_code(strategy))
}

///| Internal rounding implementation keyed by integer strategy code (0..=6).
fn round_dp_code(self : Decimal, dp : UInt, code : Int) -> Decimal {
  let old_scale = self.scale()
  if old_scale <= dp {
    return self
  }
  let negative = self.is_sign_negative()
  if self.is_zero() {
    return make_decimal(0UL, 0U, negative, dp)
  }

  let diff = (old_scale - dp).to_int()

  // Fast path: 64-bit mantissa and diff <= 19 (single UInt64 division!)
  if self.hi == 0U && diff <= 19 {
    let pow = POWERS_10_U64[diff]
    let mut q = self.lo64 / pow
    let rem = self.lo64 - q * pow
    let half = pow >> 1
    let round_up = if code == 0 {
      rem > half || (rem == half && (q & 1UL) == 1UL)
    } else if code == 1 {
      rem >= half
    } else if code == 2 {
      rem > half
    } else if code == 3 {
      false
    } else if code == 4 {
      rem != 0UL
    } else if code == 5 {
      negative && rem != 0UL
    } else {
      !negative && rem != 0UL
    }
    if round_up {
      q = q + 1UL
    }
    return make_decimal(q, 0U, negative, dp)
  }

  // General 96-bit path
  let value : FixedArray[UInt] = [
    self.lo64.to_uint(),
    (self.lo64 >> 32).to_uint(),
    self.hi,
  ]
  let mut rem_diff = diff
  while rem_diff > 0 {
    let step = if rem_diff < 10 { rem_diff } else { 9 }
    let _ = u96_div_u32(value, POWERS_10[step])
    rem_diff = rem_diff - step
  }

  // Compute discarded fractional part = self - value * 10^diff
  let offset : FixedArray[UInt] = [value[0], value[1], value[2]]
  rem_diff = diff
  while rem_diff > 0 {
    let step = if rem_diff < 10 { rem_diff } else { 9 }
    let _ = u96_mul_u32(offset, POWERS_10[step])
    rem_diff = rem_diff - step
  }
  let dec_part : FixedArray[UInt] = [
    self.lo64.to_uint(),
    (self.lo64 >> 32).to_uint(),
    self.hi,
  ]
  u96_sub(dec_part, offset)

  // Halfway threshold = 5 * 10^(diff - 1)
  let cap : FixedArray[UInt] = [5U, 0U, 0U]
  let mut k = diff - 1
  while k > 0 {
    let step = if k < 10 { k } else { 9 }
    let _ = u96_mul_u32(cap, POWERS_10[step])
    k = k - step
  }

  let order = u96_cmp(dec_part, cap)
  let is_nonzero_rem = (dec_part[0] | dec_part[1] | dec_part[2]) != 0U

  let round_up = if code == 0 {
    order > 0 || (order == 0 && (value[0] & 1U) == 1U)
  } else if code == 1 {
    order >= 0
  } else if code == 2 {
    order > 0
  } else if code == 3 {
    false
  } else if code == 4 {
    is_nonzero_rem
  } else if code == 5 {
    negative && is_nonzero_rem
  } else {
    !negative && is_nonzero_rem
  }

  if round_up {
    let _ = u96_add_u32(value, 1U)
  }
  let lo64 = value[0].to_uint64() | (value[1].to_uint64() << 32)
  make_decimal(lo64, value[2], negative, dp)
}
