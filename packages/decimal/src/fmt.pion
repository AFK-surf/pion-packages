///| High-performance 9-digit chunked formatting and 16-byte binary serialization for `Decimal`.

///| Write 9 zero-padded decimal digits of `v_in < 10^9` backwards from `end_pos` (division-free).
fn write_u32_padded9(digits : FixedArray[Byte], end_pos : Int, v_in : UInt) -> Unit {
  let mut v = v_in
  let mut p = end_pos
  let mut k = 0
  while k < 4 {
    let q = ((v.to_uint64() * 0x51EB851FUL) >> 37).to_uint()
    let r = v - q * 100U
    let d1 = (r * 205U) >> 11
    let d0 = r - d1 * 10U
    digits[p - 1] = (48U + d0).to_int().to_byte()
    digits[p - 2] = (48U + d1).to_int().to_byte()
    p = p - 2
    v = q
    k = k + 1
  }
  digits[p - 1] = (48U + v).to_int().to_byte()
}

///| Write decimal digits of a UInt (at least 1 digit) backwards from `end_pos`; returns new start pos (division-free).
fn write_u32_var(digits : FixedArray[Byte], end_pos : Int, v_in : UInt) -> Int {
  let mut v = v_in
  let mut p = end_pos
  while v >= 100U {
    let q = ((v.to_uint64() * 0x51EB851FUL) >> 37).to_uint()
    let r = v - q * 100U
    let d1 = (r * 205U) >> 11
    let d0 = r - d1 * 10U
    digits[p - 1] = (48U + d0).to_int().to_byte()
    digits[p - 2] = (48U + d1).to_int().to_byte()
    p = p - 2
    v = q
  }
  if v >= 10U {
    let d1 = (v * 205U) >> 11
    let d0 = v - d1 * 10U
    digits[p - 1] = (48U + d0).to_int().to_byte()
    digits[p - 2] = (48U + d1).to_int().to_byte()
    p - 2
  } else {
    digits[p - 1] = (48U + v).to_int().to_byte()
    p - 1
  }
}

///| Write 9 zero-padded decimal digits of `v_in < 10^9` directly into `Bytes` backwards (division-free).
fn write_u32_padded9_bytes(out : Bytes, end_pos : Int, v_in : UInt) -> Unit {
  let mut v = v_in
  let mut p = end_pos
  let mut k = 0
  while k < 4 {
    let q = ((v.to_uint64() * 0x51EB851FUL) >> 37).to_uint()
    let r = v - q * 100U
    let d1 = (r * 205U) >> 11
    let d0 = r - d1 * 10U
    out[p - 1] = (48U + d0).to_int().to_byte()
    out[p - 2] = (48U + d1).to_int().to_byte()
    p = p - 2
    v = q
    k = k + 1
  }
  out[p - 1] = (48U + v).to_int().to_byte()
}

///| Write decimal digits of a UInt directly into `Bytes` backwards; returns new start pos (division-free).
fn write_u32_var_bytes(out : Bytes, end_pos : Int, v_in : UInt) -> Int {
  let mut v = v_in
  let mut p = end_pos
  while v >= 100U {
    let q = ((v.to_uint64() * 0x51EB851FUL) >> 37).to_uint()
    let r = v - q * 100U
    let d1 = (r * 205U) >> 11
    let d0 = r - d1 * 10U
    out[p - 1] = (48U + d0).to_int().to_byte()
    out[p - 2] = (48U + d1).to_int().to_byte()
    p = p - 2
    v = q
  }
  if v >= 10U {
    let d1 = (v * 205U) >> 11
    let d0 = v - d1 * 10U
    out[p - 1] = (48U + d0).to_int().to_byte()
    out[p - 2] = (48U + d1).to_int().to_byte()
    p - 2
  } else {
    out[p - 1] = (48U + v).to_int().to_byte()
    p - 1
  }
}

///| Write decimal digits of a UInt64 directly into `Bytes` backwards; returns new start pos.
fn write_u64_var_bytes(out : Bytes, end_pos : Int, v_in : UInt64) -> Int {
  let mut v = v_in
  let mut p = end_pos
  while v >= 1000000000UL {
    let q = v / 1000000000UL
    let r = (v - q * 1000000000UL).to_uint()
    write_u32_padded9_bytes(out, p, r)
    p = p - 9
    v = q
  }
  write_u32_var_bytes(out, p, v.to_uint())
}

///| Exact base-10 digit count of a `UInt64` (1..=20) with zero divisions.
fn u64_digit_count(v : UInt64) -> Int {
  if v < 10000000000UL {
    if v < 100000UL {
      if v < 100UL {
        if v < 10UL { 1 } else { 2 }
      } else if v < 1000UL {
        3
      } else if v < 10000UL {
        4
      } else {
        5
      }
    } else if v < 10000000UL {
      if v < 1000000UL { 6 } else { 7 }
    } else if v < 100000000UL {
      8
    } else if v < 1000000000UL {
      9
    } else {
      10
    }
  } else if v < 1000000000000000UL {
    if v < 1000000000000UL {
      if v < 100000000000UL { 11 } else { 12 }
    } else if v < 10000000000000UL {
      13
    } else if v < 100000000000000UL {
      14
    } else {
      15
    }
  } else if v < 100000000000000000UL {
    if v < 10000000000000000UL { 16 } else { 17 }
  } else if v < 1000000000000000000UL {
    18
  } else if v < 10000000000000000000UL {
    19
  } else {
    20
  }
}

///| Write decimal digits of a UInt64 backwards from `end_pos`; returns new start pos.
fn write_u64_var(digits : FixedArray[Byte], end_pos : Int, v_in : UInt64) -> Int {
  let mut v = v_in
  let mut p = end_pos
  while v >= 1000000000UL {
    let q = v / 1000000000UL
    let r = (v - q * 1000000000UL).to_uint()
    write_u32_padded9(digits, p, r)
    p = p - 9
    v = q
  }
  write_u32_var(digits, p, v.to_uint())
}

///| Extract mantissa digits into `digits[start..32]` using 9-digit chunking (`1_000_000_000`).
///| Returns `start` index (so length is `32 - start`).
fn extract_digits_9chunk(d : Decimal, digits : FixedArray[Byte]) -> Int {
  let end = 32
  if d.hi == 0U {
    if d.lo64 == 0UL {
      digits[31] = (48).to_byte()
      return 31
    }
    return write_u64_var(digits, end, d.lo64)
  }

  // Full 96-bit: divide by 10^9 chunks (at most 4 divisions)
  let mut lo = d.lo64.to_uint()
  let mut mid = (d.lo64 >> 32).to_uint()
  let mut hi = d.hi
  let mut p = end
  let billion : UInt64 = 1000000000UL

  while hi != 0U {
    let cur2 = hi.to_uint64()
    let q2 = cur2 / billion
    let rem2 = cur2 - q2 * billion
    hi = q2.to_uint()

    let cur1 = (rem2 << 32) | mid.to_uint64()
    let q1 = cur1 / billion
    let rem1 = cur1 - q1 * billion
    mid = q1.to_uint()

    let cur0 = (rem1 << 32) | lo.to_uint64()
    let q0 = cur0 / billion
    let rem0 = cur0 - q0 * billion
    lo = q0.to_uint()

    write_u32_padded9(digits, p, rem0.to_uint())
    p = p - 9
  }

  let rem64 = lo.to_uint64() | (mid.to_uint64() << 32)
  if rem64 > 0UL {
    write_u64_var(digits, p, rem64)
  } else {
    // Strip any leading zeros from last padded chunk
    while p < 31 && digits[p] == (48).to_byte() {
      p = p + 1
    }
    p
  }
}

///| Pure digit byte ('0'..'9') -> Char conversion without module-level array lookup.
fn digit_byte_to_char(b : Byte) -> Char {
  let d = b.to_int() - 48
  if d < 5 {
    if d < 2 {
      if d == 0 { '0' } else { '1' }
    } else if d == 2 {
      '2'
    } else if d == 3 {
      '3'
    } else {
      '4'
    }
  } else if d < 7 {
    if d == 5 { '5' } else { '6' }
  } else if d == 7 {
    '7'
  } else if d == 8 {
    '8'
  } else {
    '9'
  }
}

///| Format `self` directly into `sb` without intermediate string allocation.
pub fn Decimal::write_to(self : Decimal, sb : StringBuilder) -> Unit {
  let scale = self.scale().to_int()
  let neg = self.is_sign_negative()

  // Fast path for 0 with scale 0
  if self.lo64 == 0UL && self.hi == 0U && scale == 0 {
    if neg {
      sb.write_string("-0")
    } else {
      sb.write_char('0')
    }
    return
  }

  let digits : FixedArray[Byte] = FixedArray::make(32, (48).to_byte())
  let start = extract_digits_9chunk(self, digits)
  let num_digits = 32 - start

  if neg {
    sb.write_char('-')
  }

  if scale == 0 {
    let mut i = start
    while i < 32 {
      sb.write_char(digit_byte_to_char(digits[i]))
      i = i + 1
    }
    return
  }

  if num_digits <= scale {
    sb.write_string("0.")
    let mut z = scale - num_digits
    while z > 0 {
      sb.write_char('0')
      z = z - 1
    }
    let mut i = start
    while i < 32 {
      sb.write_char(digit_byte_to_char(digits[i]))
      i = i + 1
    }
  } else {
    let int_len = num_digits - scale
    let split = start + int_len
    let mut i = start
    while i < split {
      sb.write_char(digit_byte_to_char(digits[i]))
      i = i + 1
    }
    sb.write_char('.')
    while i < 32 {
      sb.write_char(digit_byte_to_char(digits[i]))
      i = i + 1
    }
  }
}

///| Full 96-bit `to_string` slow path (isolated to keep 64-bit fast path compact).
fn to_string_96(self : Decimal, scale : Int, neg : Bool) -> String {
  let sign_len = if neg { 1 } else { 0 }
  let digits : FixedArray[Byte] = FixedArray::make(32, (48).to_byte())
  let start = extract_digits_9chunk(self, digits)
  let num_digits = 32 - start

  if scale == 0 {
    let out = Bytes::new(sign_len + num_digits)
    let mut p = 0
    if neg {
      out[0] = (45).to_byte()
      p = 1
    }
    let mut i = start
    while i < 32 {
      out[p] = digits[i]
      p = p + 1
      i = i + 1
    }
    return out.to_string()
  }

  if num_digits <= scale {
    let lead_zeros = scale - num_digits
    let out = Bytes::new(sign_len + 2 + scale)
    let mut p = 0
    if neg {
      out[0] = (45).to_byte()
      p = 1
    }
    out[p] = (48).to_byte()
    out[p + 1] = (46).to_byte()
    p = p + 2
    let mut z = 0
    while z < lead_zeros {
      out[p] = (48).to_byte()
      p = p + 1
      z = z + 1
    }
    let mut i = start
    while i < 32 {
      out[p] = digits[i]
      p = p + 1
      i = i + 1
    }
    out.to_string()
  } else {
    let int_len = num_digits - scale
    let split = start + int_len
    let out = Bytes::new(sign_len + num_digits + 1)
    let mut p = 0
    if neg {
      out[0] = (45).to_byte()
      p = 1
    }
    let mut i = start
    while i < split {
      out[p] = digits[i]
      p = p + 1
      i = i + 1
    }
    out[p] = (46).to_byte()
    p = p + 1
    while i < 32 {
      out[p] = digits[i]
      p = p + 1
      i = i + 1
    }
    out.to_string()
  }
}

///| Format `self` to its exact decimal string representation (preserving trailing zeros per `scale`).
pub fn Decimal::to_string(self : Decimal) -> String {
  let scale = self.scale().to_int()
  let neg = self.is_sign_negative()

  // Fast path for 0 with scale 0
  if self.lo64 == 0UL && self.hi == 0U && scale == 0 {
    return if neg { "-0" } else { "0" }
  }

  if self.hi != 0U {
    return to_string_96(self, scale, neg)
  }

  let sign_len = if neg { 1 } else { 0 }
  let lo64 = self.lo64
  let num_digits = u64_digit_count(lo64)
  if scale == 0 {
    let len = sign_len + num_digits
    let out = Bytes::new(len)
    if neg {
      out[0] = (45).to_byte()
    }
    let _ = if lo64 <= 0xFFFFFFFFUL {
      write_u32_var_bytes(out, len, lo64.to_uint())
    } else {
      write_u64_var_bytes(out, len, lo64)
    }
    return out.to_string()
  }
  if num_digits <= scale {
    let len = sign_len + 2 + scale
    let out = Bytes::new(len)
    if neg {
      out[0] = (45).to_byte()
    }
    out[sign_len] = (48).to_byte()
    out[sign_len + 1] = (46).to_byte()
    let dstart = if lo64 <= 0xFFFFFFFFUL {
      write_u32_var_bytes(out, len, lo64.to_uint())
    } else {
      write_u64_var_bytes(out, len, lo64)
    }
    let mut p = sign_len + 2
    while p < dstart {
      out[p] = (48).to_byte()
      p = p + 1
    }
    return out.to_string()
  }
  // num_digits > scale (so 1 <= scale <= 19)
  let len = sign_len + num_digits + 1
  let out = Bytes::new(len)
  if neg {
    out[0] = (45).to_byte()
  }
  if lo64 <= 0xFFFFFFFFUL {
    // 32-bit mantissa: format fractional and integer digits backwards with zero hardware divisions
    let mut v = lo64.to_uint()
    let mut p = len
    let mut rem_s = scale
    while rem_s >= 2 {
      let q = ((v.to_uint64() * 0x51EB851FUL) >> 37).to_uint()
      let r = v - q * 100U
      let d1 = (r * 205U) >> 11
      let d0 = r - d1 * 10U
      out[p - 1] = (48U + d0).to_int().to_byte()
      out[p - 2] = (48U + d1).to_int().to_byte()
      p = p - 2
      v = q
      rem_s = rem_s - 2
    }
    if rem_s == 1 {
      let q = ((v.to_uint64() * 0xCCCCCCCDUL) >> 35).to_uint()
      let r = v - q * 10U
      out[p - 1] = (48U + r).to_int().to_byte()
      p = p - 1
      v = q
    }
    out[p - 1] = (46).to_byte()
    let _ = write_u32_var_bytes(out, p - 1, v)
    return out.to_string()
  }
  let split = sign_len + num_digits - scale
  out[split] = (46).to_byte()
  let pow = pow10_u64(scale)
  let int_part = lo64 / pow
  let frac_part = lo64 - int_part * pow
  let _ = if int_part <= 0xFFFFFFFFUL {
    write_u32_var_bytes(out, split, int_part.to_uint())
  } else {
    write_u64_var_bytes(out, split, int_part)
  }
  let fstart = if frac_part <= 0xFFFFFFFFUL {
    write_u32_var_bytes(out, len, frac_part.to_uint())
  } else {
    write_u64_var_bytes(out, len, frac_part)
  }
  let mut p = split + 1
  while p < fstart {
    out[p] = (48).to_byte()
    p = p + 1
  }
  out.to_string()
}

///| Serialize `self` into 16 little-endian bytes `[flags, lo, mid, hi]`, matching `rust_decimal`.
#verify
pub fn Decimal::serialize(self : Decimal) -> Bytes {
  let out = Bytes::new(16)
  let f = self.flags
  let lo = self.lo64.to_uint()
  let mid = (self.lo64 >> 32).to_uint()
  let hi = self.hi
  out[0] = (f & 0xFFU).to_int().to_byte()
  out[1] = ((f >> 8) & 0xFFU).to_int().to_byte()
  out[2] = ((f >> 16) & 0xFFU).to_int().to_byte()
  out[3] = ((f >> 24) & 0xFFU).to_int().to_byte()
  out[4] = (lo & 0xFFU).to_int().to_byte()
  out[5] = ((lo >> 8) & 0xFFU).to_int().to_byte()
  out[6] = ((lo >> 16) & 0xFFU).to_int().to_byte()
  out[7] = ((lo >> 24) & 0xFFU).to_int().to_byte()
  out[8] = (mid & 0xFFU).to_int().to_byte()
  out[9] = ((mid >> 8) & 0xFFU).to_int().to_byte()
  out[10] = ((mid >> 16) & 0xFFU).to_int().to_byte()
  out[11] = ((mid >> 24) & 0xFFU).to_int().to_byte()
  out[12] = (hi & 0xFFU).to_int().to_byte()
  out[13] = ((hi >> 8) & 0xFFU).to_int().to_byte()
  out[14] = ((hi >> 16) & 0xFFU).to_int().to_byte()
  out[15] = ((hi >> 24) & 0xFFU).to_int().to_byte()
  out
}

///|
#verify
fn read_u32_le(b : Bytes, off : Int) -> UInt {
  b[off].to_int().to_uint() |
  (b[off + 1].to_int().to_uint() << 8) |
  (b[off + 2].to_int().to_uint() << 16) |
  (b[off + 3].to_int().to_uint() << 24)
}

///| Deserialize 16 little-endian bytes `[flags, lo, mid, hi]`, matching `rust_decimal =1.37.2` bit-for-bit.
#verify
pub fn Decimal::deserialize(bytes : Bytes) -> Result[Decimal, DecimalError] {
  if bytes.length() != 16 {
    return Err(DecimalError::EmptyData)
  }
  let raw_flags = read_u32_le(bytes, 0) & 0x801F0000U
  let lo = read_u32_le(bytes, 4)
  let mid = read_u32_le(bytes, 8)
  let hi = read_u32_le(bytes, 12)
  let neg = (raw_flags & SIGN_MASK) != 0U
  let raw_scale = (raw_flags & SCALE_MASK) >> 16
  if raw_scale <= MAX_SCALE {
    let lo64 = lo.to_uint64() | (mid.to_uint64() << 32)
    return Ok(Decimal::{ lo64, hi, flags: raw_flags })
  }
  // raw_scale is 29, 30, or 31 (5-bit masked): divide by 10, 100, or 1000 and round up if raw remainder >= 5.
  let div64 : UInt64 = if raw_scale == 29U {
    10UL
  } else if raw_scale == 30U {
    100UL
  } else {
    1000UL
  }
  let c2 = hi.to_uint64()
  let mut q2 = (c2 / div64).to_uint()
  let r2 = c2 - q2.to_uint64() * div64
  let c1 = (r2 << 32) | mid.to_uint64()
  let mut q1 = (c1 / div64).to_uint()
  let r1 = c1 - q1.to_uint64() * div64
  let c0 = (r1 << 32) | lo.to_uint64()
  let mut q0 = (c0 / div64).to_uint()
  let rem = (c0 - q0.to_uint64() * div64).to_uint()
  if rem >= 5U {
    let s0 = q0.to_uint64() + 1UL
    q0 = s0.to_uint()
    if s0 > 0xFFFFFFFFUL {
      let s1 = q1.to_uint64() + 1UL
      q1 = s1.to_uint()
      if s1 > 0xFFFFFFFFUL {
        q2 = q2 + 1U
      }
    }
  }
  let lo64 = q0.to_uint64() | (q1.to_uint64() << 32)
  Ok(Decimal::{ lo64, hi: q2, flags: make_flags(neg, MAX_SCALE) })
}
