///| Formatting and binary serialization for `Decimal`.

///|
pub fn Decimal::write_to(self : Decimal, sb : StringBuilder) -> Unit {
  let _ = self
  let _ = sb
}

///|
pub fn Decimal::to_string(self : Decimal) -> String {
  let _ = self
  ""
}

///|
pub fn Decimal::serialize(self : Decimal) -> Bytes {
  let _ = self
  Bytes::new(16)
}

///|
pub fn Decimal::deserialize(bytes : Bytes) -> Result[Decimal, DecimalError] {
  let _ = bytes
  Err(DecimalError::EmptyData)
}
