///| RT-crypto-v030 red-team CONTROL tests for `packages/crypto` v0.3.0 (AES-GCM, P-256 SEC1, P-256 ECDH).
///| Every `control_*` test is expected to PASS; a failure is a regression (run_audit.sh exits 1).
///| Known-answer vectors below come from Go 1.27 `crypto/aes` + `cipher.NewGCMWithNonceSize`
///| (`audit_v030/go`, `oracle kat`).

import "crypto"

///|
fn hx(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => {
      debug_assert(false, "bad hex literal")
      Bytes::new(0)
    }
  }
}

///|
fn cl(b : Bytes) -> Bytes {
  let out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    out[i] = b[i]
    i = i + 1
  }
  out
}

///|
fn take(b : Bytes, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b[i]
    i = i + 1
  }
  out
}

///|
fn cat(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn pattern(n : Int, seed : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((i * 131 + seed * 29 + 7) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn seal(klen : Int, key : Bytes, nonce : Bytes, aad : Bytes, pt : Bytes) -> Result[Bytes, crypto::CryptoError] {
  if klen == 16 {
    crypto::aes128_gcm_seal(key, nonce, aad, pt)
  } else {
    crypto::aes256_gcm_seal(key, nonce, aad, pt)
  }
}

///|
fn open(klen : Int, key : Bytes, nonce : Bytes, aad : Bytes, ct : Bytes) -> Result[Bytes, crypto::CryptoError] {
  if klen == 16 {
    crypto::aes128_gcm_open(key, nonce, aad, ct)
  } else {
    crypto::aes256_gcm_open(key, nonce, aad, ct)
  }
}

///|
fn is_err(r : Result[Bytes, crypto::CryptoError], want : crypto::CryptoError) -> Bool {
  match r {
    Ok(_) => false
    Err(e) => crypto::crypto_error_eq(e, want)
  }
}

///|
fn ok_hex(r : Result[Bytes, crypto::CryptoError]) -> String {
  match r {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(_) => "ERR"
  }
}

