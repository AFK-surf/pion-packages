///| RT-crypto-v030 differential oracle (Pion side) for `packages/crypto` v0.3.0.
///|
///|   oracle vectors <corpus.tsv>   one "<label>\t<result>" line per corpus line
///|
///| Corpus lines (from `audit_v030/go`): `label \t op \t hex-args...`
///|   S128/S256 key nonce aad pt   -> aesNNN_gcm_seal   (hex or ERR)
///|   O128/O256 key nonce aad ct   -> aesNNN_gcm_open   (hex or ERR)
///|   PV pub                       -> p256_validate_pubkey (1/0; INCONSISTENT if it disagrees
///|                                   with p256_validate_pubkey_strict / p256_decompress_pubkey)
///|   PD pub                       -> p256_decompress_pubkey (hex or ERR)
///|   DH d pub                     -> p256_ecdh (hex or ERR)

import "crypto"

///|
let hex_digits : String = "0123456789abcdef"

///|
fn to_hex(b : Bytes) -> String {
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int() & 0xFF
    out[2 * i] = hex_digits.code_unit_at(v >> 4).to_byte()
    out[2 * i + 1] = hex_digits.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_val(buf[start + 2 * i].to_int())
    let lo = hex_val(buf[start + 2 * i + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn slice_str(buf : Bytes, start : Int, end : Int) -> String {
  let n = end - start
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = buf[start + i]
    i = i + 1
  }
  out.to_string()
}

///| Tab-separated field boundaries of buf[start, end): flat [s0, e0, s1, e1, ...].
fn fields(buf : Bytes, start : Int, end : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut fs = start
  let mut i = start
  while i < end {
    if buf[i].to_int() == 9 {
      out.push(fs)
      out.push(i)
      fs = i + 1
    }
    i = i + 1
  }
  out.push(fs)
  out.push(end)
  out
}

///|
fn res_hex(r : Result[Bytes, crypto::CryptoError]) -> String {
  match r {
    Ok(b) => to_hex(b)
    Err(_) => "ERR"
  }
}

///|
fn pv(pubkey : Bytes) -> String {
  let a = crypto::p256_validate_pubkey(pubkey)
  let b = match crypto::p256_validate_pubkey_strict(pubkey) {
    Ok(_) => true
    Err(_) => false
  }
  let c = match crypto::p256_decompress_pubkey(pubkey) {
    Ok(_) => true
    Err(_) => false
  }
  if a != b || a != c {
    "INCONSISTENT"
  } else if a {
    "1"
  } else {
    "0"
  }
}

///|
fn run_line(buf : Bytes, start : Int, end : Int) -> String {
  let f = fields(buf, start, end)
  let label = slice_str(buf, f[0], f[1])
  let op = slice_str(buf, f[2], f[3])
  let res = if op == "S128" || op == "S256" || op == "O128" || op == "O256" {
    let key = from_hex(buf, f[4], f[5])
    let nonce = from_hex(buf, f[6], f[7])
    let aad = from_hex(buf, f[8], f[9])
    let data = from_hex(buf, f[10], f[11])
    if op == "S128" {
      res_hex(crypto::aes128_gcm_seal(key, nonce, aad, data))
    } else if op == "S256" {
      res_hex(crypto::aes256_gcm_seal(key, nonce, aad, data))
    } else if op == "O128" {
      res_hex(crypto::aes128_gcm_open(key, nonce, aad, data))
    } else {
      res_hex(crypto::aes256_gcm_open(key, nonce, aad, data))
    }
  } else if op == "PV" {
    pv(from_hex(buf, f[4], f[5]))
  } else if op == "PD" {
    res_hex(crypto::p256_decompress_pubkey(from_hex(buf, f[4], f[5])))
  } else if op == "DH" {
    res_hex(crypto::p256_ecdh(from_hex(buf, f[4], f[5]), from_hex(buf, f[6], f[7])))
  } else {
    "UNKNOWN_OP"
  }
  label + "\t" + res
}

///|
fn run_vectors(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let mut sb = StringBuilder::new()
  let mut pos = 0
  let mut pending = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos {
      sb.write_string(run_line(buf, pos, nl))
      sb.write_string("\n")
      pending = pending + 1
      if pending >= 256 {
        io_print(world, sb.to_string())
        sb = StringBuilder::new()
        pending = 0
      }
    }
    pos = nl + 1
  }
  io_print(world, sb.to_string())
  0
}

// ── Scaled benchmark (same workloads as bench/pion_bench, iteration count n from argv) ──

///|
fn mk_buf(len : Int) -> Bytes {
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = ((i * 131 + 17) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn hexb(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn run_bench(world : World, mode : String, n : Int) -> Int {
  let key = hexb("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let pub_u = hexb(
    "04c4cfd4dc14471cbc23f68830495857689ad122d899cc9d9726ea006c335a5122bb97ce9aac19a7a577297ad2654c320a1fb909cc0088793a691495d9aae2de08",
  )
  let pub_c = hexb("02c4cfd4dc14471cbc23f68830495857689ad122d899cc9d9726ea006c335a5122")
  let h = crypto::Sha256::new()
  let mut i = 0
  if mode == "p256_validate" {
    let mut ok = 0
    while i < n {
      if crypto::p256_validate_pubkey(pub_u) {
        ok = ok + 1
      }
      if crypto::p256_validate_pubkey(pub_c) {
        ok = ok + 1
      }
      i = i + 1
    }
    io_println(world, "ok=" + ok.to_string())
    return 0
  }
  if mode == "p256_ecdh" {
    let sk = hexb("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    while i < n {
      sk[31] = ((sk[31].to_int() + 1) & 0xFF).to_byte()
      match crypto::p256_ecdh(sk, pub_u) {
        Ok(s) => h.update(s)
        Err(_) => return 2
      }
      i = i + 1
    }
  } else if mode == "aes256gcm" || mode == "aes256gcm_small" {
    let big = mode == "aes256gcm"
    let pt = mk_buf(if big { 65536 } else { 256 })
    let aad = (if big { "pion-crypto-bench-aead-aad" } else { "pion-crypto-bench-small-aad" }).to_bytes()
    let nonce = hexb("070000004041424344454647")
    while i < n {
      nonce[0] = (i & 0xFF).to_byte()
      if !big {
        nonce[1] = ((i >> 8) & 0xFF).to_byte()
      }
      let sealed = match crypto::aes256_gcm_seal(key, nonce, aad, pt) {
        Ok(b) => b
        Err(_) => return 2
      }
      match crypto::aes256_gcm_open(key, nonce, aad, sealed) {
        Ok(o) => if o.length() != pt.length() { return 3 }
        Err(_) => return 3
      }
      h.update(sealed)
      i = i + 1
    }
  } else {
    return 2
  }
  io_println(world, "sha256=" + h.finalize_hex())
  0
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() > 2 && args[1] == "vectors" {
    run_vectors(world, args[2])
  } else if args.length() > 3 && args[1] == "bench" {
    run_bench(world, args[2], parse_int(args[3]))
  } else {
    io_eprintln(world, "usage: oracle vectors <corpus.tsv> | bench <mode> <n>")
    2
  }
}
