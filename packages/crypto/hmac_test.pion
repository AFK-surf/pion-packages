///| RFC 4231 HMAC-SHA256 / HMAC-SHA384 / HMAC-SHA512 official vectors,
///| streaming HMAC, zero-length key/message boundaries, constant_time_eq, and hex codec tests.

///|
fn h_hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    0
  }
}

///|
fn h_from_hex(hex : String) -> Bytes {
  let n = hex.length() / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = h_hex_nibble(hex.code_unit_at(i * 2))
    let lo = h_hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn h_to_hex(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let n = b.length()
  let mut out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[i * 2] = digits.code_unit_at((v >> 4) & 0xF).to_byte()
    out[i * 2 + 1] = digits.code_unit_at(v & 0xF).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn h_repeat(b : Int, n : Int) -> Bytes {
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b.to_byte()
    i = i + 1
  }
  out
}

///|
test "hmac_rfc4231_all_7_vectors" {
  // TC 1
  let k1 = h_repeat(0x0b, 20)
  let d1 = "Hi There".to_bytes()
  debug_assert(
    h_to_hex(hmac_sha256(k1, d1)) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
    "rfc4231 tc1 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k1, d1)) == "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6",
    "rfc4231 tc1 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k1, d1)) == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
    "rfc4231 tc1 hs512",
  )

  // TC 2
  let k2 = "Jefe".to_bytes()
  let d2 = "what do ya want for nothing?".to_bytes()
  debug_assert(
    h_to_hex(hmac_sha256(k2, d2)) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
    "rfc4231 tc2 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k2, d2)) == "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649",
    "rfc4231 tc2 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k2, d2)) == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
    "rfc4231 tc2 hs512",
  )

  // TC 3
  let k3 = h_repeat(0xaa, 20)
  let d3 = h_repeat(0xdd, 50)
  debug_assert(
    h_to_hex(hmac_sha256(k3, d3)) == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
    "rfc4231 tc3 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k3, d3)) == "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27",
    "rfc4231 tc3 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k3, d3)) == "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
    "rfc4231 tc3 hs512",
  )

  // TC 4
  let k4 = h_from_hex("0102030405060708090a0b0c0d0e0f10111213141516171819")
  let d4 = h_repeat(0xcd, 50)
  debug_assert(
    h_to_hex(hmac_sha256(k4, d4)) == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",
    "rfc4231 tc4 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k4, d4)) == "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb",
    "rfc4231 tc4 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k4, d4)) == "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
    "rfc4231 tc4 hs512",
  )

  // TC 5
  let k5 = h_repeat(0x0c, 20)
  let d5 = "Test With Truncation".to_bytes()
  debug_assert(
    h_to_hex(hmac_sha256(k5, d5)) == "a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5",
    "rfc4231 tc5 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k5, d5)) == "3abf34c3503b2a23a46efc619baef897f4c8e42c934ce55ccbae9740fcbc1af4ca62269e2a37cd88ba926341efe4aeea",
    "rfc4231 tc5 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k5, d5)) == "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b",
    "rfc4231 tc5 hs512",
  )

  // TC 6 (131-byte key > 64B and > 128B)
  let k6 = h_repeat(0xaa, 131)
  let d6 = "Test Using Larger Than Block-Size Key - Hash Key First".to_bytes()
  debug_assert(
    h_to_hex(hmac_sha256(k6, d6)) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
    "rfc4231 tc6 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k6, d6)) == "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
    "rfc4231 tc6 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k6, d6)) == "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
    "rfc4231 tc6 hs512",
  )

  // TC 7 (131-byte key + multi-block data)
  let k7 = h_repeat(0xaa, 131)
  let d7 = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".to_bytes()
  debug_assert(
    h_to_hex(hmac_sha256(k7, d7)) == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
    "rfc4231 tc7 hs256",
  )
  debug_assert(
    h_to_hex(hmac_sha384(k7, d7)) == "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e",
    "rfc4231 tc7 hs384",
  )
  debug_assert(
    h_to_hex(hmac_sha512(k7, d7)) == "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
    "rfc4231 tc7 hs512",
  )
}

///|
test "hmac_empty_key_and_message_and_streaming" {
  let empty = Bytes::new(0)
  debug_assert(
    hmac_sha256_hex(empty, empty) == "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad",
    "hmac256 empty/empty",
  )
  debug_assert(
    hmac_sha256_hex(empty, "abc".to_bytes()) == "fd7adb152c05ef80dccf50a1fa4c05d5a3ec6da95575fc312ae7c5d091836351",
    "hmac256 empty key",
  )
  debug_assert(
    hmac_sha256_hex("key".to_bytes(), empty) == "5d5d139563c95b5967b9bd9a8c9b233a9dedb45072794cd232dc1b74832607d0",
    "hmac256 empty msg",
  )
  debug_assert(
    hmac_sha384_hex(empty, empty) == "6c1f2ee938fad2e24bd91298474382ca218c75db3d83e114b3d4367776d14d3551289e75e8209cd4b792302840234adc",
    "hmac384 empty/empty",
  )
  debug_assert(
    hmac_sha512_hex(empty, empty) == "b936cee86c9f87aa5d3c6f2e84cb5a4239a5fe50480a6ec66b70ab5b1f4ac6730c6c515421b327ec1d69402e53dfb49ad7381eb067b338fd7b0cb22247225d47",
    "hmac512 empty/empty",
  )

  // Streaming HMAC-SHA256 / 384 / 512 with chunking and reset
  let k = h_repeat(0xaa, 131)
  let d = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".to_bytes()

  let m256 = HmacSha256::new(k)
  m256.update_slice(d, 0, 19)
  m256.update_slice(d, 19, 80)
  m256.update_slice(d, 80, d.length())
  debug_assert(
    m256.finalize_hex() == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
    "streaming hmac256",
  )
  m256.reset()
  m256.update("Test Using Larger Than Block-Size Key - Hash Key First".to_bytes())
  debug_assert(
    m256.finalize_hex() == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
    "streaming hmac256 reset",
  )

  let m384 = HmacSha384::new(k)
  m384.update_slice(d, 0, 50)
  m384.update_slice(d, 50, d.length())
  debug_assert(
    m384.finalize_hex() == "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e",
    "streaming hmac384",
  )
  m384.reset()
  m384.update("Test Using Larger Than Block-Size Key - Hash Key First".to_bytes())
  debug_assert(
    m384.finalize_hex() == "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
    "streaming hmac384 reset",
  )

  let m512 = HmacSha512::new(k)
  m512.update_slice(d, 0, 33)
  m512.update_slice(d, 33, 128)
  m512.update_slice(d, 128, d.length())
  debug_assert(
    m512.finalize_hex() == "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
    "streaming hmac512",
  )
  m512.reset()
  m512.update("Test Using Larger Than Block-Size Key - Hash Key First".to_bytes())
  debug_assert(
    m512.finalize_hex() == "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
    "streaming hmac512 reset",
  )
}

///|
test "constant_time_eq_and_hex_codec" {
  debug_assert(constant_time_eq(Bytes::new(0), Bytes::new(0)), "ct empty")
  debug_assert(
    constant_time_eq("abcdef".to_bytes(), "abcdef".to_bytes()),
    "ct equal",
  )
  debug_assert(
    !constant_time_eq("abcdef".to_bytes(), "abcdeg".to_bytes()),
    "ct last diff",
  )
  debug_assert(
    !constant_time_eq("abcdef".to_bytes(), "bbcdef".to_bytes()),
    "ct first diff",
  )
  debug_assert(
    !constant_time_eq("abcdef".to_bytes(), "abcde".to_bytes()),
    "ct len diff",
  )

  debug_assert(bytes_to_hex(Bytes::new(0)) == "", "hex empty")
  debug_assert(bytes_to_hex(h_from_hex("00010a7f80ff")) == "00010a7f80ff", "hex encode")
  match hex_to_bytes("00010A7f80FF") {
    Some(b) => debug_assert(bytes_to_hex(b) == "00010a7f80ff", "hex decode mixed")
    None => debug_assert(false, "hex decode should succeed")
  }
  match hex_to_bytes("abc") {
    None => ()
    Some(_) => debug_assert(false, "odd hex must fail")
  }
  match hex_to_bytes("zz") {
    None => ()
    Some(_) => debug_assert(false, "invalid hex char must fail")
  }
}
