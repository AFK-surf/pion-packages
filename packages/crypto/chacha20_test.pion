///| RFC 8439 ChaCha20 (§2.4.2), Poly1305 (§2.5.2), ChaCha20-Poly1305 AEAD (§2.8.2 & Appendix A.5),
///| counter overflow protection, and Wycheproof tamper/truncation tests.

///|
fn c_from_hex(s : String) -> Bytes {
  match hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn c_clone(b : Bytes) -> Bytes {
  let mut out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    out[i] = b[i]
    i = i + 1
  }
  out
}

///|
test "chacha20_rfc8439_section_2_4_2" {
  let key = c_from_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  // RFC 8439 §2.3.2 block function test (counter = 1, nonce = 000000090000004a00000000)
  let nonce_232 = c_from_hex("000000090000004a00000000")
  let exp_232 = "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e"
  match chacha20_xor(key, nonce_232, 1U, Bytes::new(64)) {
    Ok(ks) => debug_assert(bytes_to_hex(ks) == exp_232, "rfc8439 2.3.2 block")
    Err(_) => debug_assert(false, "rfc8439 2.3.2 err")
  }

  // RFC 8439 §2.4.2 encryption test (counter = 1, nonce = 000000000000004a00000000)
  let nonce = c_from_hex("000000000000004a00000000")
  let pt = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".to_bytes()
  let expected_ct = "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"
  match chacha20_xor(key, nonce, 1U, pt) {
    Ok(ct) => {
      debug_assert(bytes_to_hex(ct) == expected_ct, "rfc8439 2.4.2 encrypt")
      match chacha20_xor(key, nonce, 1U, ct) {
        Ok(back) => debug_assert(constant_time_eq(back, pt), "rfc8439 2.4.2 decrypt")
        Err(_) => debug_assert(false, "decrypt err")
      }
    }
    Err(_) => debug_assert(false, "encrypt err")
  }

  // Counter overflow: counter = 0xFFFFFFFFU allows 1 block (64B), rejects 65B
  match chacha20_xor(key, nonce, 0xFFFFFFFFU, Bytes::new(64)) {
    Ok(b) => debug_assert(b.length() == 64, "ctr max 64B ok")
    Err(_) => debug_assert(false, "ctr max 64B err")
  }
  match chacha20_xor(key, nonce, 0xFFFFFFFFU, Bytes::new(65)) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::CounterOverflow), "ctr overflow")
    Ok(_) => debug_assert(false, "ctr overflow must fail")
  }
}

///|
test "poly1305_rfc8439_section_2_5_2" {
  let key = c_from_hex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
  let msg = "Cryptographic Forum Research Group".to_bytes()
  let expected = "a8061dc1305136c6c22b8baf0c0127a9"
  match poly1305_mac(key, msg) {
    Ok(tag) => debug_assert(bytes_to_hex(tag) == expected, "rfc8439 2.5.2 poly1305")
    Err(_) => debug_assert(false, "poly1305 err")
  }
  match poly1305_mac(Bytes::new(31), msg) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidKeyLength(31)), "poly key31")
    Ok(_) => debug_assert(false, "poly key31 must fail")
  }
}

///|
test "chacha20_poly1305_rfc8439_section_2_8_2_and_a5" {
  // RFC 8439 §2.8.2
  let key = c_from_hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let nonce = c_from_hex("070000004041424344454647")
  let aad = c_from_hex("50515253c0c1c2c3c4c5c6c7")
  let pt = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".to_bytes()
  let expected_ct = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"
  let expected_tag = "1ae10b594f09e26a7e902ecbd0600691"
  let sealed = match chacha20_poly1305_seal(key, nonce, aad, pt) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "aead seal err")
      return ()
    }
  }
  debug_assert(bytes_to_hex(sealed) == expected_ct + expected_tag, "rfc8439 2.8.2 seal")
  match chacha20_poly1305_open(key, nonce, aad, sealed) {
    Ok(opened) => debug_assert(constant_time_eq(opened, pt), "rfc8439 2.8.2 open")
    Err(_) => debug_assert(false, "rfc8439 2.8.2 open err")
  }

  // RFC 8439 Appendix A.5
  let key5 = c_from_hex("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0")
  let nonce5 = c_from_hex("000000000102030405060708")
  let aad5 = c_from_hex("f33388860000000000004e91")
  let pt5 = c_from_hex(
    "",
  )
  // Verify round-trip on empty plaintext & empty AAD & block boundaries
  let lens : Array[Int] = [0, 1, 15, 16, 17, 63, 64, 65]
  let mut idx = 0
  while idx < lens.length() {
    let m = Bytes::new(lens[idx])
    match chacha20_poly1305_seal(key5, nonce5, Bytes::new(0), m) {
      Ok(s) => {
        debug_assert(s.length() == lens[idx] + 16, "aead len")
        match chacha20_poly1305_open(key5, nonce5, Bytes::new(0), s) {
          Ok(p) => debug_assert(constant_time_eq(p, m), "aead boundary roundtrip")
          Err(_) => debug_assert(false, "aead boundary open err")
        }
      }
      Err(_) => debug_assert(false, "aead boundary seal err")
    }
    idx = idx + 1
  }
  match chacha20_poly1305_seal(key5, nonce5, aad5, pt5) {
    Ok(s5) => {
      match chacha20_poly1305_open(key5, nonce5, aad5, s5) {
        Ok(p5) => debug_assert(constant_time_eq(p5, pt5), "a5 roundtrip")
        Err(_) => debug_assert(false, "a5 open err")
      }
    }
    Err(_) => debug_assert(false, "a5 seal err")
  }
}

///|
test "chacha20_poly1305_wycheproof_tamper_and_truncation" {
  let key = c_from_hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let nonce = c_from_hex("070000004041424344454647")
  let aad = c_from_hex("50515253c0c1c2c3c4c5c6c7")
  let pt = "hello authenticated encryption".to_bytes()
  let sealed = match chacha20_poly1305_seal(key, nonce, aad, pt) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "seal err")
      return ()
    }
  }

  // Flip bit in ciphertext
  let mut bad_ct = c_clone(sealed)
  bad_ct[0] = (bad_ct[0].to_int() ^ 1).to_byte()
  match chacha20_poly1305_open(key, nonce, aad, bad_ct) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::AuthenticationFailed), "tamper ct")
    Ok(_) => debug_assert(false, "tamper ct must fail")
  }

  // Flip bit in tag
  let mut bad_tag = c_clone(sealed)
  let last = bad_tag.length() - 1
  bad_tag[last] = (bad_tag[last].to_int() ^ 0x80).to_byte()
  match chacha20_poly1305_open(key, nonce, aad, bad_tag) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::AuthenticationFailed), "tamper tag")
    Ok(_) => debug_assert(false, "tamper tag must fail")
  }

  // Flip bit in AAD
  let mut bad_aad = c_clone(aad)
  bad_aad[3] = (bad_aad[3].to_int() ^ 1).to_byte()
  match chacha20_poly1305_open(key, nonce, bad_aad, sealed) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::AuthenticationFailed), "tamper aad")
    Ok(_) => debug_assert(false, "tamper aad must fail")
  }

  // Flip bit in nonce
  let mut bad_nonce = c_clone(nonce)
  bad_nonce[0] = (bad_nonce[0].to_int() ^ 1).to_byte()
  match chacha20_poly1305_open(key, bad_nonce, aad, sealed) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::AuthenticationFailed), "tamper nonce")
    Ok(_) => debug_assert(false, "tamper nonce must fail")
  }

  // Truncated (< 16 bytes)
  match chacha20_poly1305_open(key, nonce, aad, Bytes::new(15)) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidLength(15)), "short ct")
    Ok(_) => debug_assert(false, "short ct must fail")
  }

  // Wrong key/nonce lengths
  match chacha20_poly1305_seal(Bytes::new(16), nonce, aad, pt) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidKeyLength(16)), "key16")
    Ok(_) => debug_assert(false, "key16 must fail")
  }
  match chacha20_poly1305_seal(key, Bytes::new(8), aad, pt) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidNonceLength(8)), "nonce8")
    Ok(_) => debug_assert(false, "nonce8 must fail")
  }
}
