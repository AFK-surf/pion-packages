///| RT-crypto-v040 red-team CONTROL tests for `packages/crypto` v0.4.0 (PBKDF2-HMAC-SHA256/512, scrypt).
///| Every `control_*` test is expected to PASS; a failure is a defect (run_audit.sh exits 1).
///| Known answers come from golang.org/x/crypto v0.58.0 (`audit_v040/go`, `go_oracle one`) and were
///| re-derived byte for byte with Node.js 24 `crypto.pbkdf2Sync` / `crypto.scryptSync` (OpenSSL).
///| The 2 GiB dk_len and > 1 GiB V-table cases live in `probes.py` (one process per build mode),
///| since an abort or a wasm32 trap would take the whole test binary down.

import "crypto"

///|
fn hx(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => {
      debug_assert(false, "bad hex literal")
      Bytes::new(0)
    }
  }
}

///|
fn pattern(n : Int, mul : Int, add : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((i * mul + add) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn is_err(r : Result[Bytes, crypto::CryptoError], want : crypto::CryptoError) -> Bool {
  match r {
    Err(e) => crypto::crypto_error_eq(e, want)
    Ok(_) => false
  }
}

///|
fn ok_hex(r : Result[Bytes, crypto::CryptoError]) -> String {
  match r {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(e) => "ERR " + crypto::crypto_error_message(e)
  }
}

///|
fn ok_bytes(r : Result[Bytes, crypto::CryptoError]) -> Bytes {
  match r {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
fn is_prefix(a : Bytes, full : Bytes) -> Bool {
  if a.length() == 0 || a.length() > full.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != full[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn expect_err(r : Result[Bytes, crypto::CryptoError], want : crypto::CryptoError, what : String) -> Unit {
  debug_assert(is_err(r, want), what + ": got " + ok_hex(r))
}

///|
fn expect_hex(r : Result[Bytes, crypto::CryptoError], want : String, what : String) -> Unit {
  let got = ok_hex(r)
  debug_assert(got == want, what + ": got " + got)
}

///|
let int_min : Int = -2147483648

///|
let i64_min : Int64 = -9223372036854775807L - 1L

///|
let i64_max : Int64 = 9223372036854775807L

///|
test "control_pbkdf2_error_kinds" {
  let p = "pass".to_bytes()
  let s = "salt".to_bytes()
  let mut k = 0
  while k < 2 {
    let f = fn(it : Int, dk : Int) -> Result[Bytes, crypto::CryptoError] {
      if k == 0 {
        crypto::pbkdf2_hmac_sha256(p, s, it, dk)
      } else {
        crypto::pbkdf2_hmac_sha512(p, s, it, dk)
      }
    }
    expect_err(f(0, 32), crypto::CryptoError::InvalidParam, "iterations=0")
    expect_err(f(-1, 32), crypto::CryptoError::InvalidParam, "iterations=-1")
    expect_err(f(int_min, 32), crypto::CryptoError::InvalidParam, "iterations=Int::MIN")
    expect_err(f(1, 0), crypto::CryptoError::InvalidLength(0), "dk=0")
    expect_err(f(1, -1), crypto::CryptoError::InvalidLength(-1), "dk=-1")
    expect_err(f(1, int_min), crypto::CryptoError::InvalidLength(int_min), "dk=Int::MIN")
    // iterations is checked before dk_len
    expect_err(f(0, 0), crypto::CryptoError::InvalidParam, "iterations=0, dk=0")
    expect_err(f(int_min, int_min), crypto::CryptoError::InvalidParam, "both Int::MIN")
    k = k + 1
  }
}

///|
test "control_pbkdf2_rfc7914_s11_and_go_kats" {
  // RFC 7914 §11 PBKDF2-HMAC-SHA256 vectors (also golang.org/x/crypto/pbkdf2 + Node pbkdf2Sync)
  expect_hex(
    crypto::pbkdf2_hmac_sha256("passwd".to_bytes(), "salt".to_bytes(), 1, 64),
    "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783",
    "rfc7914 s11 #1",
  )
  expect_hex(
    crypto::pbkdf2_hmac_sha256("Password".to_bytes(), "NaCl".to_bytes(), 80000, 64),
    "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d",
    "rfc7914 s11 #2",
  )
  expect_hex(
    crypto::pbkdf2_hmac_sha512("password".to_bytes(), "salt".to_bytes(), 1, 64),
    "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce",
    "sha512 c=1",
  )
}

///| HMAC folds keys longer than the block (64 B / 128 B) to H(key): PBKDF2 with a 65-byte password must
///| equal PBKDF2 with its SHA-256 digest (and 129 B / SHA-512), while a key of exactly the block size is
///| used as is (so it must NOT equal the digest variant).
test "control_hmac_key_fold_boundaries" {
  let s = pattern(52, 5, 1)
  let mut len = 63
  while len <= 66 {
    let pw = pattern(len, 13, 7)
    let direct = ok_hex(crypto::pbkdf2_hmac_sha256(pw, s, 2, 40))
    let folded = ok_hex(crypto::pbkdf2_hmac_sha256(crypto::sha256(pw), s, 2, 40))
    debug_assert((direct == folded) == (len > 64), "sha256 fold at len " + len.to_string())
    len = len + 1
  }
  len = 127
  while len <= 130 {
    let pw = pattern(len, 13, 7)
    let direct = ok_hex(crypto::pbkdf2_hmac_sha512(pw, s, 2, 72))
    let folded = ok_hex(crypto::pbkdf2_hmac_sha512(crypto::sha512(pw), s, 2, 72))
    debug_assert((direct == folded) == (len > 128), "sha512 fold at len " + len.to_string())
    len = len + 1
  }
}

///| T_1 || T_2 || ... : a longer dk_len must extend, never change, a shorter one (prefix property).
test "control_pbkdf2_prefix_property" {
  let p = pattern(33, 3, 9)
  let s = pattern(60, 7, 2)
  let full256 = ok_bytes(crypto::pbkdf2_hmac_sha256(p, s, 3, 256))
  let full512 = ok_bytes(crypto::pbkdf2_hmac_sha512(p, s, 3, 256))
  let mut dk = 1
  while dk <= 256 {
    let a = ok_bytes(crypto::pbkdf2_hmac_sha256(p, s, 3, dk))
    let b = ok_bytes(crypto::pbkdf2_hmac_sha512(p, s, 3, dk))
    debug_assert(is_prefix(a, full256), "sha256 prefix dk=" + dk.to_string())
    debug_assert(is_prefix(b, full512), "sha512 prefix dk=" + dk.to_string())
    dk = dk + 7
  }
}

///|
test "control_scrypt_error_kinds" {
  let p = "p".to_bytes()
  let s = "s".to_bytes()
  let bad_n : Array[Int] = [0, -1, 1, 3, 6, 15, 1023, int_min, 2147483647]
  for n in bad_n {
    expect_err(crypto::scrypt(p, s, n, 1, 1, 32), crypto::CryptoError::InvalidParam, "N=" + n.to_string())
  }
  let bad_rp : Array[Int] = [0, -1, int_min]
  for v in bad_rp {
    expect_err(crypto::scrypt(p, s, 16, v, 1, 32), crypto::CryptoError::InvalidParam, "r=" + v.to_string())
    expect_err(crypto::scrypt(p, s, 16, 1, v, 32), crypto::CryptoError::InvalidParam, "p=" + v.to_string())
  }
  // r * p >= 2^30 (RFC 7914 §6), including products that overflow 32 bits
  expect_err(crypto::scrypt(p, s, 16, 2147483647, 1, 32), crypto::CryptoError::InvalidParam, "r=Int::MAX")
  expect_err(crypto::scrypt(p, s, 16, 1, 2147483647, 32), crypto::CryptoError::InvalidParam, "p=Int::MAX")
  expect_err(crypto::scrypt(p, s, 16, 65536, 65536, 32), crypto::CryptoError::InvalidParam, "r*p=2^32")
  expect_err(crypto::scrypt(p, s, 16, 1073741824, 1, 32), crypto::CryptoError::InvalidParam, "r=2^30")
  expect_err(crypto::scrypt(p, s, 16, 1, 1073741824, 32), crypto::CryptoError::InvalidParam, "p=2^30")
  expect_err(
    crypto::scrypt_with_max_mem(p, s, 1073741824, 2147483647, 1, 32, i64_max),
    crypto::CryptoError::InvalidParam,
    "N=2^30 r=Int::MAX (128 r (N+p+2) overflows 64 bits)",
  )
  // r * p just below 2^30: legal, but far beyond any memory ceiling (must not allocate)
  expect_err(
    crypto::scrypt(p, s, 2, 1, 1073741823, 32),
    crypto::CryptoError::MemoryLimitExceeded,
    "p=2^30-1",
  )
  expect_err(
    crypto::scrypt(p, s, 2, 1073741823, 1, 32),
    crypto::CryptoError::MemoryLimitExceeded,
    "r=2^30-1",
  )
  expect_err(
    crypto::scrypt_with_max_mem(p, s, 1073741824, 8, 1, 32, i64_max),
    crypto::CryptoError::MemoryLimitExceeded,
    "N=2^30 r=8 with an unbounded ceiling (1 TiB V table)",
  )
  expect_err(crypto::scrypt(p, s, 16, 1, 1, 0), crypto::CryptoError::InvalidLength(0), "dk=0")
  expect_err(crypto::scrypt(p, s, 16, 1, 1, -1), crypto::CryptoError::InvalidLength(-1), "dk=-1")
  expect_err(
    crypto::scrypt(p, s, 16, 1, 1, int_min),
    crypto::CryptoError::InvalidLength(int_min),
    "dk=Int::MIN",
  )
  let bad_mm : Array[Int64] = [0L, -1L, i64_min]
  for mm in bad_mm {
    expect_err(
      crypto::scrypt_with_max_mem(p, s, 16, 1, 1, 32, mm),
      crypto::CryptoError::InvalidParam,
      "max_mem=" + mm.to_string(),
    )
  }
}

///| RFC 7914 §2: "N ... must be larger than 1, a power of 2, and less than 2^(128 * r / 8)".
///| OpenSSL / Node.js `crypto.scryptSync` refuse N >= 2^(16 r); a Pion-derived key with r = 1 and
///| N >= 65536 can never be re-derived by the Node.js side of scrypt + AES-256-GCM envelope (REPORT P2-3).
test "control_scrypt_n_below_2_pow_16r" {
  let p = "pw".to_bytes()
  let s = "salt".to_bytes()
  expect_hex(
    crypto::scrypt(p, s, 32768, 1, 1, 32),
    "8490a98e8b57dad4a0acf88031b699b9be59777db2dc67e9d552d80da72289f0",
    "N=2^15 r=1 (largest legal N for r=1)",
  )
  expect_hex(
    crypto::scrypt(p, s, 65536, 2, 1, 32),
    "39e5b1ab65b103fc153d70c1138def5433abcfe690c952db00160fb640557c7e",
    "N=2^16 r=2",
  )
  expect_err(crypto::scrypt(p, s, 65536, 1, 1, 32), crypto::CryptoError::InvalidParam, "N=2^16 r=1")
  expect_err(crypto::scrypt(p, s, 131072, 1, 1, 32), crypto::CryptoError::InvalidParam, "N=2^17 r=1")
  expect_err(
    crypto::scrypt_with_max_mem(p, s, 1073741824, 1, 1, 32, i64_max),
    crypto::CryptoError::InvalidParam,
    "N=2^30 r=1 unbounded ceiling",
  )
}

///| 128 r (N + p + 2) is the OpenSSL / Node.js `maxmem` rule: exact value passes, one byte less fails
///| (each pair below was confirmed against Node.js `scryptSync({ maxmem })`).
test "control_scrypt_max_mem_exact_boundaries" {
  let p = "pw".to_bytes()
  let s = "NaCl".to_bytes()
  let cases : Array[(Int, Int, Int)] = [(2, 1, 1), (16, 2, 3), (16, 16, 4), (1024, 8, 16)]
  for c in cases {
    let (n, r, pp) = c
    let need = 128L * r.to_int64() * (n.to_int64() + pp.to_int64() + 2L)
    let at = ok_hex(crypto::scrypt_with_max_mem(p, s, n, r, pp, 32, need))
    let dflt = ok_hex(crypto::scrypt(p, s, n, r, pp, 32))
    debug_assert(at == dflt && at.length() == 64, "exact ceiling passes N=" + n.to_string())
    expect_err(
      crypto::scrypt_with_max_mem(p, s, n, r, pp, 32, need - 1L),
      crypto::CryptoError::MemoryLimitExceeded,
      "ceiling - 1 fails N=" + n.to_string(),
    )
  }
  // scrypt + AES-256-GCM envelope: N=32768 r=8 p=1 fits 64 MiB (33,557,504 B), N=65536 (67,111,936 B) does not
  let mp = "pion-kdf-test-passphrase-2026!".to_bytes()
  let ms = hx("0123456789abcdeffedcba9876543210")
  expect_hex(
    crypto::scrypt_with_max_mem(mp, ms, 32768, 8, 1, 32, 67108864L),
    "6df15f873061048eb3bf38f9b976cf8ad03b322dad6615bb84e0473d718a9364",
    "env_v1 N=32768 under 64 MiB",
  )
  expect_err(
    crypto::scrypt_with_max_mem(mp, ms, 65536, 8, 1, 32, 67108864L),
    crypto::CryptoError::MemoryLimitExceeded,
    "env_v1 N=65536 over 64 MiB",
  )
  expect_err(
    crypto::scrypt(mp, ms, 1048576, 8, 1, 64),
    crypto::CryptoError::MemoryLimitExceeded,
    "RFC 7914 vector 4 over the 256 MiB default",
  )
}

///| A scrypt + AES-256-GCM envelope produced by Node.js (scryptSync N=32768 r=8 p=1 maxmem=64 MiB +
///| aes-256-gcm, 12-byte IV, empty AAD) from a UTF-8 passphrase with an embedded NUL: Pion must derive
///| the same key, open the envelope and re-seal it to the identical bytes.
test "control_scrypt_env_v1_node_envelope" {
  let pass = hx("70c3a4737377c3b672642de5af86e7a0812df09f949100d0bad0bbd18ed187")
  let salt = hx("00112233445566778899aabbccddeeff")
  let iv = hx("0f0e0d0c0b0a090807060504")
  let pt = hx(
    "7b2276223a312c2273746174696f6e223a2272742d76303430222c22746f6b656e223a22785c753030303079227d",
  )
  let env = hx(
    "30423c257e3eb54eeefac8f1bd439f99cd4999ef7a53b80f24f3a4f088f97a93dde50f1c426f61aa6cf9b80bb044621ae1f2e7ed4f3544cfb7c95f9bb8e0",
  )
  let key = match crypto::scrypt_with_max_mem(pass, salt, 32768, 8, 1, 32, 67108864L) {
    Ok(k) => k
    Err(_) => Bytes::new(0)
  }
  debug_assert(
    crypto::bytes_to_hex(key) == "a2fdcca219da1525930affdf073e334031983d3866fc338a52fbfede1acb0411",
    "node scrypt key",
  )
  match crypto::aes256_gcm_open(key, iv, Bytes::new(0), env) {
    Ok(back) => debug_assert(crypto::constant_time_eq(back, pt), "node envelope plaintext")
    Err(_) => debug_assert(false, "node envelope must open")
  }
  expect_hex(crypto::aes256_gcm_seal(key, iv, Bytes::new(0), pt), crypto::bytes_to_hex(env), "re-seal")
}

///| p independent ROMix lanes: scrypt(p) must differ from scrypt(1), and the result must not depend on
///| a previous call (V / XY scratch reuse across calls).
test "control_scrypt_no_state_leak_between_calls" {
  let p = pattern(20, 3, 1)
  let s = pattern(16, 5, 2)
  let a1 = ok_hex(crypto::scrypt(p, s, 64, 4, 3, 48))
  let _ = crypto::scrypt(pattern(70, 9, 9), pattern(3, 1, 1), 1024, 2, 4, 100)
  let a2 = ok_hex(crypto::scrypt(p, s, 64, 4, 3, 48))
  debug_assert(a1 == a2, "repeatable")
  debug_assert(a1 != ok_hex(crypto::scrypt(p, s, 64, 4, 1, 48)), "p matters")
  debug_assert(a1 != ok_hex(crypto::scrypt(p, s, 64, 2, 3, 48)), "r matters")
}
