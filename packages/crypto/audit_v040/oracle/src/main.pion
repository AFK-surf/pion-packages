///| RT-crypto-v040 differential oracle (Pion side) for `packages/crypto` v0.4.0 PBKDF2 / scrypt.
///|
///|   oracle vectors <corpus.tsv>     one "<label>\t<result>" line per corpus line
///|   oracle one <op> <args...>       one result (crash-isolated hostile-parameter probes)
///|   oracle bench <mode> <n>         scaled copy of bench/pion_bench (pbkdf2_sha256 | scrypt)
///|
///| Ops (from `audit_v040/go`): P256 / P512 pass salt iters dk; SC pass salt N r p dk maxmem
///| (maxmem "D" = `scrypt`, else `scrypt_with_max_mem`); ML pass salt16 N iv12 pt (scrypt + AES-256-GCM envelope).
///| Results: lowercase hex, `ERR:<CryptoError kind>`, or for `one` with a > 1 MiB output
///| `OKBIG:len=<n>:tail=<hex of the last 32 bytes>` (the 2 GiB dk_len probes).

import "crypto"

///|
let hex_digits : String = "0123456789abcdef"

///|
fn to_hex(b : Bytes) -> String {
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int() & 0xFF
    out[2 * i] = hex_digits.code_unit_at(v >> 4).to_byte()
    out[2 * i + 1] = hex_digits.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_val(buf[start + 2 * i].to_int())
    let lo = hex_val(buf[start + 2 * i + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn slice_str(buf : Bytes, start : Int, end : Int) -> String {
  let n = end - start
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = buf[start + i]
    i = i + 1
  }
  out.to_string()
}

///| Tab-separated field boundaries of buf[start, end): flat [s0, e0, s1, e1, ...].
fn fields(buf : Bytes, start : Int, end : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut fs = start
  let mut i = start
  while i < end {
    if buf[i].to_int() == 9 {
      out.push(fs)
      out.push(i)
      fs = i + 1
    }
    i = i + 1
  }
  out.push(fs)
  out.push(end)
  out
}

///|
fn err_name(e : crypto::CryptoError) -> String {
  match e {
    crypto::CryptoError::InvalidLength(n) => "ERR:InvalidLength(" + n.to_string() + ")"
    crypto::CryptoError::InvalidParam => "ERR:InvalidParam"
    crypto::CryptoError::MemoryLimitExceeded => "ERR:MemoryLimitExceeded"
    crypto::CryptoError::InvalidKeyLength(n) => "ERR:InvalidKeyLength(" + n.to_string() + ")"
    crypto::CryptoError::InvalidNonceLength(n) => "ERR:InvalidNonceLength(" + n.to_string() + ")"
    crypto::CryptoError::AuthenticationFailed => "ERR:AuthenticationFailed"
    _ => "ERR:Other(" + crypto::crypto_error_message(e) + ")"
  }
}

///|
fn res_hex(r : Result[Bytes, crypto::CryptoError]) -> String {
  match r {
    Ok(b) =>
    if b.length() > 1048576 {
      let n = b.length()
      let tail = Bytes::new(32)
      let mut i = 0
      while i < 32 {
        tail[i] = b[n - 32 + i]
        i = i + 1
      }
      "OKBIG:len=" + n.to_string() + ":tail=" + to_hex(tail)
    } else {
      to_hex(b)
    }
    Err(e) => err_name(e)
  }
}

///| Decimal Int64 parser (accepts a leading '-', wraps like the target integer type).
fn parse_i64(s : String) -> Int64 {
  let mut acc = 0L
  let mut i = 0
  let mut neg = false
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  while i < s.length() {
    acc = acc * 10L + (s.code_unit_at(i) - 48).to_int64()
    i = i + 1
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
fn hexs(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///| Shared dispatcher: op + string args (hex / decimal), as in a corpus line.
fn run_op(op : String, a : Array[String]) -> String {
  if op == "P256" || op == "P512" {
    let pass = hexs(a[0])
    let salt = hexs(a[1])
    let iters = parse_i64(a[2]).to_int()
    let dk = parse_i64(a[3]).to_int()
    if op == "P256" {
      res_hex(crypto::pbkdf2_hmac_sha256(pass, salt, iters, dk))
    } else {
      res_hex(crypto::pbkdf2_hmac_sha512(pass, salt, iters, dk))
    }
  } else if op == "SC" {
    let pass = hexs(a[0])
    let salt = hexs(a[1])
    let n = parse_i64(a[2]).to_int()
    let r = parse_i64(a[3]).to_int()
    let p = parse_i64(a[4]).to_int()
    let dk = parse_i64(a[5]).to_int()
    if a[6] == "D" {
      res_hex(crypto::scrypt(pass, salt, n, r, p, dk))
    } else {
      res_hex(crypto::scrypt_with_max_mem(pass, salt, n, r, p, dk, parse_i64(a[6])))
    }
  } else if op == "ML" {
    let pass = hexs(a[0])
    let salt = hexs(a[1])
    let n = parse_i64(a[2]).to_int()
    let key = if n <= 32768 {
      crypto::scrypt_with_max_mem(pass, salt, n, 8, 1, 32, 67108864L)
    } else {
      crypto::scrypt(pass, salt, n, 8, 1, 32)
    }
    match key {
      Ok(k) => {
        let iv = hexs(a[3])
        let pt = hexs(a[4])
        match crypto::aes256_gcm_seal(k, iv, Bytes::new(0), pt) {
          Ok(ct) =>
          // the envelope must also open again with the derived key
          match crypto::aes256_gcm_open(k, iv, Bytes::new(0), ct) {
            Ok(back) => if crypto::constant_time_eq(back, pt) { to_hex(ct) } else { "ROUNDTRIP_MISMATCH" }
            Err(e) => "OPEN_" + err_name(e)
          }
          Err(e) => "SEAL_" + err_name(e)
        }
      }
      Err(e) => err_name(e)
    }
  } else {
    "UNKNOWN_OP"
  }
}

///|
fn run_line(buf : Bytes, start : Int, end : Int) -> String {
  let f = fields(buf, start, end)
  let label = slice_str(buf, f[0], f[1])
  let op = slice_str(buf, f[2], f[3])
  let args : Array[String] = []
  let mut i = 4
  while i + 1 < f.length() {
    args.push(slice_str(buf, f[i], f[i + 1]))
    i = i + 2
  }
  label + "\t" + run_op(op, args)
}

///|
fn run_vectors(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let mut sb = StringBuilder::new()
  let mut pos = 0
  let mut pending = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos {
      sb.write_string(run_line(buf, pos, nl))
      sb.write_string("\n")
      pending = pending + 1
      if pending >= 256 {
        io_print(world, sb.to_string())
        sb = StringBuilder::new()
        pending = 0
      }
    }
    pos = nl + 1
  }
  io_print(world, sb.to_string())
  0
}

// ── Scaled benchmark (same workloads as bench/pion_bench, op count n from argv) ──

///|
fn run_bench(world : World, mode : String, n : Int) -> Int {
  if mode == "pbkdf2_sha256" {
    let pass = "pion-crypto-bench-pbkdf2-passphrase-2026!".to_bytes()
    let salt = "pion-crypto-bench-pbkdf2-salt-0123456789".to_bytes()
    match crypto::pbkdf2_hmac_sha256(pass, salt, n, 32) {
      Ok(dk) => io_println(world, "pbkdf2_sha256=" + crypto::bytes_to_hex(dk))
      Err(_) => return 1
    }
    return 0
  }
  if mode == "scrypt" {
    let pass = "pion-kdf-test-passphrase-2026!".to_bytes()
    let salt = hexs("0123456789abcdeffedcba9876543210")
    let h = crypto::Sha256::new()
    let mut i = 0
    while i < n {
      salt[0] = (i & 0xFF).to_byte()
      match crypto::scrypt(pass, salt, 16384, 8, 1, 32) {
        Ok(dk) => h.update(dk)
        Err(_) => return 2
      }
      i = i + 1
    }
    io_println(world, "scrypt_sha256=" + h.finalize_hex())
    return 0
  }
  2
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() > 2 && args[1] == "vectors" {
    run_vectors(world, args[2])
  } else if args.length() > 2 && args[1] == "one" {
    let rest : Array[String] = []
    let mut i = 3
    while i < args.length() {
      rest.push(args[i])
      i = i + 1
    }
    io_println(world, run_op(args[2], rest))
    0
  } else if args.length() > 3 && args[1] == "bench" {
    run_bench(world, args[2], parse_i64(args[3]).to_int())
  } else {
    io_eprintln(world, "usage: oracle vectors <corpus.tsv> | one <op> <args...> | bench <mode> <n>")
    2
  }
}
