///| RFC 8018 PBKDF2-HMAC-SHA256 / PBKDF2-HMAC-SHA512 and RFC 7914 scrypt test suite.
///| Covers RFC 6070 vectors (SHA-256/512), RFC 7914 §12 vectors, `.mlogin.enc` v1 vectors & E2E,
///| edge cases (empty/long password & salt, multi-block dkLen), and full invalid parameter checks.

///|
fn kdf_hex(s : String) -> Bytes {
  match hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn kdf_pattern(len : Int, mul : Int, add : Int) -> Bytes {
  let mut out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = ((i * mul + add) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn kdf_expect_ok(r : Result[Bytes, CryptoError], want_hex : String, label : String) -> Unit {
  match r {
    Ok(b) => debug_assert(bytes_to_hex(b) == want_hex, label)
    Err(_) => debug_assert(false, label + " unexpected err")
  }
}

///|
fn kdf_expect_err(r : Result[Bytes, CryptoError], want : CryptoError, label : String) -> Unit {
  match r {
    Err(e) => debug_assert(crypto_error_eq(e, want), label)
    Ok(_) => debug_assert(false, label + " expected err")
  }
}

///|
test "pbkdf2_hmac_sha256_vectors" {
  // RFC 6070 input cases adapted to HMAC-SHA256 (verified against Go golang.org/x/crypto/pbkdf2)
  kdf_expect_ok(
    pbkdf2_hmac_sha256("password".to_bytes(), "salt".to_bytes(), 1, 32),
    "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
    "pbkdf2_256 rfc6070_1",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha256("password".to_bytes(), "salt".to_bytes(), 2, 32),
    "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
    "pbkdf2_256 rfc6070_2",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha256("password".to_bytes(), "salt".to_bytes(), 4096, 32),
    "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
    "pbkdf2_256 rfc6070_3",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha256(
      "passwordPASSWORDpassword".to_bytes(),
      "saltSALTsaltSALTsaltSALTsaltSALTsalt".to_bytes(),
      4096,
      40,
    ),
    "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9",
    "pbkdf2_256 rfc6070_4",
  )
  // Embedded NUL bytes: "pass\0word" and "sa\0lt"
  kdf_expect_ok(
    pbkdf2_hmac_sha256(kdf_hex("7061737300776f7264"), kdf_hex("7361006c74"), 4096, 16),
    "89b69d0516f829893c696226650a8687",
    "pbkdf2_256 rfc6070_5",
  )
  // Empty password, empty salt, long password/salt (>128 B), multi-block dkLen=64/100
  kdf_expect_ok(
    pbkdf2_hmac_sha256(Bytes::new(0), Bytes::new(0), 1, 32),
    "f7ce0b653d2d72a4108cf5abe912ffdd777616dbbb27a70e8204f3ae2d0f6fad",
    "pbkdf2_256 empty_both",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha256(Bytes::new(0), "salt".to_bytes(), 10, 64),
    "4c9d748ae0f9043b42a414cc80500da37a3ed69977ca443c31516f585f6449c5df193d9d6769d87c47894e3e04384ac07ff9f2a2409982e9352c3a46ee88d900",
    "pbkdf2_256 empty_pass",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha256("password".to_bytes(), Bytes::new(0), 10, 100),
    "33ec70c1814d0997a1f048abae2d39459693c84fcd3dfeb7f887902506f75716c5148f7048bb3f6cb8632cac30ec12424ca090c5084872b7397be259378b2088e512e1b25ab7a2c93405cba0b649e12e0fdef428e68e800a2bfaa37a64f2910140da2ee1",
    "pbkdf2_256 empty_salt",
  )
  let long_p = kdf_pattern(140, 7, 3)
  let long_s = kdf_pattern(140, 11, 5)
  kdf_expect_ok(
    pbkdf2_hmac_sha256(long_p, long_s, 5, 100),
    "45e008550823f76def57d44ea1af7ba72331aa1db8f3b387a9d80d6c977eae429aa47edc70f840b21a4f93fbe6eae8c1cf598f1ef1ec5f54262131f4dc33652f7b01cda9c50b6ab682de02fb2dee6a543799a0a12a55bc7d683a0e61edfdd4e059fdec9b",
    "pbkdf2_256 long_ps_100",
  )
}

///|
test "pbkdf2_hmac_sha512_vectors" {
  // RFC 6070 input cases adapted to HMAC-SHA512 (verified against Go golang.org/x/crypto/pbkdf2)
  kdf_expect_ok(
    pbkdf2_hmac_sha512("password".to_bytes(), "salt".to_bytes(), 1, 64),
    "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce",
    "pbkdf2_512 rfc6070_1",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512("password".to_bytes(), "salt".to_bytes(), 2, 64),
    "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e",
    "pbkdf2_512 rfc6070_2",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512("password".to_bytes(), "salt".to_bytes(), 4096, 64),
    "d197b1b33db0143e018b12f3d1d1479e6cdebdcc97c5c0f87f6902e072f457b5143f30602641b3d55cd335988cb36b84376060ecd532e039b742a239434af2d5",
    "pbkdf2_512 rfc6070_3",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512(
      "passwordPASSWORDpassword".to_bytes(),
      "saltSALTsaltSALTsaltSALTsaltSALTsalt".to_bytes(),
      4096,
      40,
    ),
    "8c0511f4c6e597c6ac6315d8f0362e225f3c501495ba23b868c005174dc4ee71115b59f9e60cd953",
    "pbkdf2_512 rfc6070_4",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512(kdf_hex("7061737300776f7264"), kdf_hex("7361006c74"), 4096, 16),
    "9d9e9c4cd21fe4be24d5b8244c759665",
    "pbkdf2_512 rfc6070_5",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512(Bytes::new(0), Bytes::new(0), 1, 64),
    "6d2ecbbbfb2e6dcd7056faf9af6aa06eae594391db983279a6bf27e0eb2286143ab0c996f33ca4b667e945829ea693340f2831797324e5f31df18ed171d18c97",
    "pbkdf2_512 empty_both",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512(Bytes::new(0), "salt".to_bytes(), 10, 64),
    "1f7a48471674bc0dcdc3735b2ddc3509b608ed771cb9d878e2ef4e0805d10817dde524a24fb2990a6dd3522bf8e71c6826833de87bd253806b9fccbfafa22255",
    "pbkdf2_512 empty_pass",
  )
  kdf_expect_ok(
    pbkdf2_hmac_sha512("password".to_bytes(), Bytes::new(0), 10, 100),
    "fae02439e4df197060113f7a226596999fe2e957c77058485893d4b33855ef63a8dfac3111e9fafed577df0eab902339edbb536abc4372a28deeb14c40618ff90a9da86748dfeda9b15728484f213ec5ba9b0731870f510b6f2de17643ade0578091f63c",
    "pbkdf2_512 empty_salt",
  )
  let long_p = kdf_pattern(140, 7, 3)
  let long_s = kdf_pattern(140, 11, 5)
  kdf_expect_ok(
    pbkdf2_hmac_sha512(long_p, long_s, 5, 100),
    "84955cbd799c4215a60de795363b1f7d86175b661838c2a7a4f21c4bc30c3274b4abdf79ab5d127352b74fd6c49ed7b597e4f68c4f0c465179f4a09b303d60168f3f7f2263cb38db0616c9b5d64a59feeb65715b56108a5c2b13367c534906de8eabc282",
    "pbkdf2_512 long_ps_100",
  )
}

///|
test "pbkdf2_invalid_params" {
  let p = "password".to_bytes()
  let s = "salt".to_bytes()
  kdf_expect_err(pbkdf2_hmac_sha256(p, s, 0, 32), CryptoError::InvalidParam, "p256 iter=0")
  kdf_expect_err(pbkdf2_hmac_sha256(p, s, -1, 32), CryptoError::InvalidParam, "p256 iter=-1")
  kdf_expect_err(pbkdf2_hmac_sha256(p, s, 1, 0), CryptoError::InvalidLength(0), "p256 dk=0")
  kdf_expect_err(pbkdf2_hmac_sha256(p, s, 1, -16), CryptoError::InvalidLength(-16), "p256 dk=-16")
  kdf_expect_err(pbkdf2_hmac_sha512(p, s, 0, 64), CryptoError::InvalidParam, "p512 iter=0")
  kdf_expect_err(pbkdf2_hmac_sha512(p, s, -5, 64), CryptoError::InvalidParam, "p512 iter=-5")
  kdf_expect_err(pbkdf2_hmac_sha512(p, s, 1, 0), CryptoError::InvalidLength(0), "p512 dk=0")
  kdf_expect_err(pbkdf2_hmac_sha512(p, s, 1, -1), CryptoError::InvalidLength(-1), "p512 dk=-1")
}

///|
test "scrypt_rfc7914_and_edges" {
  // RFC 7914 §12 Vector 1: P="", S="", N=16, r=1, p=1, dkLen=64
  kdf_expect_ok(
    scrypt(Bytes::new(0), Bytes::new(0), 16, 1, 1, 64),
    "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906",
    "rfc7914 vec1",
  )
  // RFC 7914 §12 Vector 2: P="password", S="NaCl", N=1024, r=8, p=16, dkLen=64
  kdf_expect_ok(
    scrypt("password".to_bytes(), "NaCl".to_bytes(), 1024, 8, 16, 64),
    "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640",
    "rfc7914 vec2",
  )
  // RFC 7914 §12 Vector 3: P="pleaseletmein", S="SodiumChloride", N=16384, r=8, p=1, dkLen=64
  kdf_expect_ok(
    scrypt("pleaseletmein".to_bytes(), "SodiumChloride".to_bytes(), 16384, 8, 1, 64),
    "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887",
    "rfc7914 vec3",
  )
  // RFC 7914 §12 Vector 4 params (N=1048576, r=8, p=1 => ~1 GiB) rejected by default 256 MiB ceiling
  kdf_expect_err(
    scrypt("pleaseletmein".to_bytes(), "SodiumChloride".to_bytes(), 1048576, 8, 1, 64),
    CryptoError::MemoryLimitExceeded,
    "rfc7914 vec4 default cap",
  )
  // Minimum valid N=2, r=1, p=1
  kdf_expect_ok(
    scrypt("a".to_bytes(), "b".to_bytes(), 2, 1, 1, 32),
    "da11baad0b1ed2e7dd90874c4d4d1a0d62ed2c8fbbc5cbf413943fce0f407743",
    "scrypt min n=2",
  )
  // Long password & salt (>128 B), p > 1, multi-block dkLen=100
  let long_p = kdf_pattern(140, 7, 3)
  let long_s = kdf_pattern(140, 11, 5)
  kdf_expect_ok(
    scrypt(long_p, long_s, 16, 2, 3, 100),
    "741ee74f088aac812e255b722a81ef2edda2fe8c19eec554f43065e2bd5b5da4304745783a31b8afb8c1ff76e47d42b97e1d52a7f3d1b2ce386abd177a5d452ceac4599c589e67025739f4f4fe0201b744105cd026138c76c7f68608dd84f62c66eef3fd",
    "scrypt multi_p dk100",
  )
  // Empty password / empty salt
  kdf_expect_ok(
    scrypt(Bytes::new(0), "NaCl".to_bytes(), 16, 2, 2, 64),
    "79b7a9d8c8bdf220d574ebeb5f9f683329638cdd8920e82489572e00032dcdd3027757edc23c02132b0342832b02f673ecc0dc68ca1fcee051fd57486192a518",
    "scrypt empty_pass",
  )
  kdf_expect_ok(
    scrypt("password".to_bytes(), Bytes::new(0), 16, 2, 2, 64),
    "205040069f40023410728f08c974b4ac164fccf100bd08454afb248f26ad8190bb08fbc7a746d6ecfe4da3b2af6e1115de003e1a9eed5604778590b9147146e9",
    "scrypt empty_salt",
  )
}

///|
test "scrypt_mlogin_enc_v1_and_e2e" {
  let pass = "monoid-login-passphrase-2026!".to_bytes()
  let salt16 = kdf_hex("0123456789abcdeffedcba9876543210")

  // .mlogin.enc v1 decrypt range: N in [1024, 131072], r=8, p=1, dkLen=32
  kdf_expect_ok(
    scrypt(pass, salt16, 1024, 8, 1, 32),
    "28f6a7d3f84731451b4a355addc26e19a6f6770bc137581266d12baccd48ccda",
    "mlogin N=1024",
  )
  kdf_expect_ok(
    scrypt(pass, salt16, 16384, 8, 1, 32),
    "225304659635845eb73cd13d4c52cf9a8afd173c564ee0ceb7b730fc66c657d7",
    "mlogin N=16384",
  )
  // Default .mlogin.enc v1 write params: N=32768, r=8, p=1, dkLen=32, maxmem=64 MiB
  kdf_expect_ok(
    scrypt_with_max_mem(pass, salt16, 32768, 8, 1, 32, 67108864L),
    "5fe5ed7a0c0de86ce3abc393ed90d2d3dbe3cb508b335276841e02a196c8d75a",
    "mlogin N=32768 maxmem=64MiB",
  )
  // N=65536, r=8, p=1 requires 128 * 8 * (65536 + 1 + 2) = 67,111,936 B > 64 MiB
  kdf_expect_err(
    scrypt_with_max_mem(pass, salt16, 65536, 8, 1, 32, 67108864L),
    CryptoError::MemoryLimitExceeded,
    "mlogin N=65536 rejected under 64MiB",
  )
  // N=65536 & N=131072 both succeed under default scrypt (256 MiB ceiling)
  kdf_expect_ok(
    scrypt(pass, salt16, 65536, 8, 1, 32),
    "09b209e0c0224c106687e56d1cc3eb35edb27eb8a24df964bf16799cde17dc87",
    "mlogin N=65536 default",
  )
  kdf_expect_ok(
    scrypt(pass, salt16, 131072, 8, 1, 32),
    "ce51b7940a2297f259d85bcc9a7fe6328fc7a82157d07aff1a17bd8471b820eb",
    "mlogin N=131072 default",
  )

  // End-to-end .mlogin.enc v1 envelope: scrypt(N=32768,r=8,p=1,dkLen=32) + AES-256-GCM (12B IV, empty AAD)
  let key = match scrypt_with_max_mem(pass, salt16, 32768, 8, 1, 32, 67108864L) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "mlogin e2e key derive")
      Bytes::new(0)
    }
  }
  let iv12 = kdf_hex("a1b2c3d4e5f60718293a4b5c")
  let aad = Bytes::new(0)
  let plaintext = "{\"v\":1,\"station\":\"tokyo\",\"token\":\"secret-session-payload\"}".to_bytes()
  let sealed = match aes256_gcm_seal(key, iv12, aad, plaintext) {
    Ok(ct) => ct
    Err(_) => {
      debug_assert(false, "mlogin e2e seal")
      Bytes::new(0)
    }
  }
  // 1. Correct passphrase decrypts cleanly
  match aes256_gcm_open(key, iv12, aad, sealed) {
    Ok(pt) => debug_assert(constant_time_eq(pt, plaintext), "mlogin e2e roundtrip")
    Err(_) => debug_assert(false, "mlogin e2e open")
  }
  // 2. Wrong passphrase rejected
  let wrong_key = match
  scrypt_with_max_mem("wrong-passphrase".to_bytes(), salt16, 32768, 8, 1, 32, 67108864L) {
    Ok(k) => k
    Err(_) => Bytes::new(0)
  }
  kdf_expect_err(
    aes256_gcm_open(wrong_key, iv12, aad, sealed),
    CryptoError::AuthenticationFailed,
    "mlogin e2e wrong passphrase",
  )
  // 3. 1-bit flip in ciphertext rejected
  let mut bad_ct = Bytes::new(sealed.length())
  let mut i = 0
  while i < sealed.length() {
    bad_ct[i] = sealed[i]
    i = i + 1
  }
  bad_ct[0] = (bad_ct[0].to_int() ^ 1).to_byte()
  kdf_expect_err(
    aes256_gcm_open(key, iv12, aad, bad_ct),
    CryptoError::AuthenticationFailed,
    "mlogin e2e tamper ct",
  )
  // 4. 1-bit flip in 16-byte tag rejected
  let mut bad_tag = Bytes::new(sealed.length())
  i = 0
  while i < sealed.length() {
    bad_tag[i] = sealed[i]
    i = i + 1
  }
  let last = bad_tag.length() - 1
  bad_tag[last] = (bad_tag[last].to_int() ^ 1).to_byte()
  kdf_expect_err(
    aes256_gcm_open(key, iv12, aad, bad_tag),
    CryptoError::AuthenticationFailed,
    "mlogin e2e tamper tag",
  )
  // 5. 1-bit flip in 12-byte IV rejected
  let mut bad_iv = Bytes::new(12)
  i = 0
  while i < 12 {
    bad_iv[i] = iv12[i]
    i = i + 1
  }
  bad_iv[11] = (bad_iv[11].to_int() ^ 1).to_byte()
  kdf_expect_err(
    aes256_gcm_open(key, bad_iv, aad, sealed),
    CryptoError::AuthenticationFailed,
    "mlogin e2e tamper iv",
  )
}

///|
test "scrypt_invalid_params" {
  let p = "password".to_bytes()
  let s = "salt".to_bytes()
  // N <= 1 or not power of 2
  kdf_expect_err(scrypt(p, s, 0, 1, 1, 32), CryptoError::InvalidParam, "n=0")
  kdf_expect_err(scrypt(p, s, 1, 1, 1, 32), CryptoError::InvalidParam, "n=1")
  kdf_expect_err(scrypt(p, s, -16, 1, 1, 32), CryptoError::InvalidParam, "n=-16")
  kdf_expect_err(scrypt(p, s, 3, 1, 1, 32), CryptoError::InvalidParam, "n=3")
  kdf_expect_err(scrypt(p, s, 6, 1, 1, 32), CryptoError::InvalidParam, "n=6")
  kdf_expect_err(scrypt(p, s, 12, 1, 1, 32), CryptoError::InvalidParam, "n=12")
  kdf_expect_err(scrypt(p, s, 1000, 8, 1, 32), CryptoError::InvalidParam, "n=1000")
  // r <= 0, p <= 0
  kdf_expect_err(scrypt(p, s, 16, 0, 1, 32), CryptoError::InvalidParam, "r=0")
  kdf_expect_err(scrypt(p, s, 16, -1, 1, 32), CryptoError::InvalidParam, "r=-1")
  kdf_expect_err(scrypt(p, s, 16, 1, 0, 32), CryptoError::InvalidParam, "p=0")
  kdf_expect_err(scrypt(p, s, 16, 1, -2, 32), CryptoError::InvalidParam, "p=-2")
  // dk_len <= 0
  kdf_expect_err(scrypt(p, s, 16, 1, 1, 0), CryptoError::InvalidLength(0), "dk=0")
  kdf_expect_err(scrypt(p, s, 16, 1, 1, -32), CryptoError::InvalidLength(-32), "dk=-32")
  // r * p >= 2^30 (RFC 7914 §6)
  kdf_expect_err(scrypt(p, s, 2, 1073741824, 1, 32), CryptoError::InvalidParam, "r*p=2^30 (1)")
  kdf_expect_err(scrypt(p, s, 2, 1048576, 1024, 32), CryptoError::InvalidParam, "r*p=2^30 (2)")
  kdf_expect_err(scrypt(p, s, 2, 65536, 16384, 32), CryptoError::InvalidParam, "r*p=2^30 (3)")
  // max_mem_bytes <= 0
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 16, 1, 1, 32, 0L),
    CryptoError::InvalidParam,
    "max_mem=0",
  )
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 16, 1, 1, 32, -1L),
    CryptoError::InvalidParam,
    "max_mem=-1",
  )
  // Exact max_mem formula boundary: 128 * r * (N + p + 2)
  // For N=16, r=1, p=1: 128 * 1 * (16 + 1 + 2) = 2432 bytes
  kdf_expect_err(
    scrypt_with_max_mem(Bytes::new(0), Bytes::new(0), 16, 1, 1, 64, 2431L),
    CryptoError::MemoryLimitExceeded,
    "max_mem 2431 fails",
  )
  kdf_expect_ok(
    scrypt_with_max_mem(Bytes::new(0), Bytes::new(0), 16, 1, 1, 64, 2432L),
    "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906",
    "max_mem 2432 passes",
  )
}

///|
test "kdf_rt_v040_regressions" {
  let p = "pass".to_bytes()
  let s = "salt".to_bytes()
  // P1-1 / P2-1: dk_len beyond the 1 GiB cap is rejected before allocating (no all-zero 2 GiB
  // "key", no container-limit abort), including the n_blocks wrap windows and Int::MAX.
  let big = [1073741825, 2147483584, 2147483585, 2147483617, 2147483631, 2147483632, 2147483647]
  let mut i = 0
  while i < big.length() {
    let d = big[i]
    kdf_expect_err(pbkdf2_hmac_sha256(p, s, 1, d), CryptoError::InvalidLength(d), "p256 dk big")
    kdf_expect_err(pbkdf2_hmac_sha512(p, s, 1, d), CryptoError::InvalidLength(d), "p512 dk big")
    kdf_expect_err(scrypt(p, s, 2, 1, 1, d), CryptoError::InvalidLength(d), "scrypt dk big")
    i = i + 1
  }
  // iterations are still checked before dk_len
  kdf_expect_err(pbkdf2_hmac_sha256(p, s, 0, 2147483647), CryptoError::InvalidParam, "p256 order")
  kdf_expect_err(pbkdf2_hmac_sha512(p, s, 0, 2147483647), CryptoError::InvalidParam, "p512 order")
  // n_blocks rewrite: lengths on and around block boundaries keep the T_1 || T_2 prefix property
  let full256 = match pbkdf2_hmac_sha256(p, s, 2, 97) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let full512 = match pbkdf2_hmac_sha512(p, s, 2, 194) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  debug_assert(full256.length() == 97, "p256 len 97")
  debug_assert(full512.length() == 194, "p512 len 194")
  let lens = [1, 31, 32, 33, 63, 64, 65, 96, 97]
  let mut li = 0
  while li < lens.length() {
    let l = lens[li]
    match pbkdf2_hmac_sha256(p, s, 2, l) {
      Ok(b) => {
        debug_assert(b.length() == l, "p256 prefix len")
        let mut k = 0
        while k < l {
          debug_assert(b[k] == full256[k], "p256 prefix byte")
          k = k + 1
        }
      }
      Err(_) => debug_assert(false, "p256 prefix err")
    }
    match pbkdf2_hmac_sha512(p, s, 2, l * 2) {
      Ok(b) => {
        let mut k = 0
        while k < l * 2 {
          debug_assert(b[k] == full512[k], "p512 prefix byte")
          k = k + 1
        }
      }
      Err(_) => debug_assert(false, "p512 prefix err")
    }
    li = li + 1
  }
  // P2-3: RFC 7914 §2 N < 2^(16 r): r = 1 refuses N >= 65536 (as OpenSSL / Node.js do)
  kdf_expect_err(scrypt(p, s, 65536, 1, 1, 32), CryptoError::InvalidParam, "r=1 N=2^16")
  kdf_expect_err(scrypt(p, s, 131072, 1, 1, 32), CryptoError::InvalidParam, "r=1 N=2^17")
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 1073741824, 1, 1, 32, 9223372036854775807L),
    CryptoError::InvalidParam,
    "r=1 N=2^30",
  )
  match scrypt(p, s, 32768, 1, 1, 32) {
    Ok(b) => debug_assert(b.length() == 32, "r=1 N=2^15 ok")
    Err(_) => debug_assert(false, "r=1 N=2^15 must derive")
  }
  // P2-2: V >= 2^28 words (1 GiB) is refused on every target even with an unlimited ceiling
  let unlimited = 9223372036854775807L
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 4194304, 2, 1, 32, unlimited),
    CryptoError::MemoryLimitExceeded,
    "V = 1 GiB (N=2^22 r=2)",
  )
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 1048576, 16, 1, 32, unlimited),
    CryptoError::MemoryLimitExceeded,
    "V = 2 GiB (N=2^20 r=16)",
  )
  kdf_expect_err(
    scrypt_with_max_mem(p, s, 16777216, 2, 1, 32, unlimited),
    CryptoError::MemoryLimitExceeded,
    "V = 4 GiB (N=2^24 r=2)",
  )
}
