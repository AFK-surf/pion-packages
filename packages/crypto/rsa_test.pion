///| RFC 8017 RSA-2048+ RS256 (PKCS#1 v1.5 SHA-256) tests:
///| - Byte-for-byte parity with OpenSSL PKCS#8 PEM/DER, SPKI DER, and RS256 signatures
///| - Strict Bleichenbacher defenses (missing NULL, trailing garbage, corrupted padding, shifted DigestInfo, sig >= n)
///| - Weak key rejection (< 2048 bits)

///|
fn r_from_hex(s : String) -> Bytes {
  match hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn r_test_pem() -> String {
  "-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgkqhkiG9w0BAQEFAASCBKkwggSlAgEAAoIBAQDCS3mC3AlcNNcE\nKuBNlS/4PZzw4j0dgYSBYoNDuMaqeeScjwYqZIbDm6iXVV9rebqCvsaFRXh/cThU\nFH6AfWw/3jD1fx8O4uLFTGM7SRx1EXpv0gMKxAk8OU3xPxLgVgK+QYJlCksuvozt\nK9Z17PFaDjj7OpRDv9qhZbBOkNiG/poC0KJgmRMj07yWotzbq4tVQYgJJQNgw0rL\nSOjgVjjolVG7kKY2lP/0EfNzgODuzZ522WfG9X3tbpaix0gj/o4V2bNvf0wuifn8\nMqkSKvRrpyxmWkF541vp/DYB69zciMLdUjMc5gG7wNjXXRXAdDh3BhB+MbKOivo4\n7wZg8rGHAgMBAAECggEAFgiJFxXs2dAEMizKkwHAFt6l1YtScu4lIKcTS7LAlMSN\n8FMn19bekYAtdjvwPjfntrv7t1FRgOJOCPrp/Zg7lmKUGsL3urBwFv+6oRaBa6U3\nxUaDoczpXzMAa8NDWL1oQjsblmm8bOifAqZeA7GDDTtfqt3Rwn0XRgZKIB6871Ht\naVWQ+NNpshACt55CMPk0dQnUtb7H380j+M7y1SmFg1nMo8wcgrswEcLVOcJqCiri\n1I7pzBOZxl91h1o/dcMI/SYMvXrwOdC/dB8t8mcIopvWmbk6I73MIU+e1GXRlCLX\nCgAytDMHRtJ5i05H+YC1J5qgbfeorjqeV4da+nsKQQKBgQDsldVWqgHZv4yqx1ck\nQ972t50fmWJ7f/F/YTxygXfQyZBnhsQ5g/0bQcAAZB2VlQjmb9xADJm2XqT4zyvB\n9YP/oEEVyO0RjiCsSymfRFR4c0gInaewIzRGeY1a/RLDskH5B2Ir/zaJojIABe3U\nYQqy4rRwmsUBulCexdoHRfdFqwKBgQDSPTTPNpPUnzCViuwJorRrV26czvw0tNT4\nrXYnatf6ALsQUSfm0BbVGC3ipMGuq/4jytsKsM2pdAPm5Gy4Dvp2NAt2H44sr0Ih\nKGbvS5l6z7WgJdgv5JolLVdtey5RUCb9MxramTd6hCQwzMGJTXoaGSYViMK2sEp1\nR1iy/HZvlQKBgQDeO2yXqMBuQxEmhnNjvGFfTWDJgvJQYgF+jt8SDG148S21IZGH\nGWWSyfNKKsDjdohStXalr3BgL401rp1C55XjdCxPA1s1J1Wnoj7pvWy/bEKY3Ubc\nHGWJYbqXYqvSqcpw2y+rdmNLa9Ed1nPuEG3VVUD7mVY/Zj0+t0kzldRNWwKBgQCG\nhnGXMbYQNDhzR+xXEgxeLxjxL6TD2P35jYzwFfbS2srX2wYsM/SYMBuUTZY9PYKl\nxnS4d39xsXGZuYozkCoFnrHCyNhBkXdAHkkXT4mKwwPV0MFvi9hyd3vc6xgtIZuB\nIsVJIQcV1x4NN8eTIsdBkdwDpXnqSg2q05dXGCJ0rQKBgQDoB822LKPQVwELCnGP\nes6bsvVvvauqF/mC/9xWpJn/T/9FFuDmz/mL1VFxVn1JG31B2LS3cWqqwmnMDg8O\n/gRuOoWQPY55rARTxdf8wgIMQTLwMXzBqisS8fjZFTf8AWs+Q9TUV2Wm4hiUGy5d\nQhswBZPMEqlyx+fWdwXIxntBfg==\n-----END PRIVATE KEY-----"
}

///|
fn r_test_spki_hex() -> String {
  ""
}

///|
fn r_test_n_hex() -> String {
  ""
}

///|
test "rsa2048_rs256_openssl_parity" {
  let priv_key = match RsaPrivateKey::from_pkcs8_pem(r_test_pem()) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "rsa pkcs8 pem err")
      return ()
    }
  }
  let pub_spki = match RsaPublicKey::from_spki_der(r_from_hex(r_test_spki_hex())) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "rsa spki err")
      return ()
    }
  }
  let pub_comp = match RsaPublicKey::from_components(r_from_hex(r_test_n_hex()), r_from_hex("010001")) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "rsa comp err")
      return ()
    }
  }

  let msg = "The quick brown fox jumps over the lazy dog".to_bytes()
  let exp_sig = ""
  let sig = match rsa_sign_rs256(priv_key, msg) {
    Ok(s) => s
    Err(_) => {
      debug_assert(false, "rsa sign err")
      return ()
    }
  }
  debug_assert(bytes_to_hex(sig) == exp_sig, "rsa sig matches openssl")
  match rsa_verify_rs256(pub_spki, msg, sig) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify spki failed")
  }
  match rsa_verify_rs256(pub_comp, msg, sig) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify comp failed")
  }
  match rsa_verify_rs256(priv_key.public_key(), msg, sig) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify priv.public_key failed")
  }

  // Empty message vector
  let exp_empty = ""
  match rsa_sign_rs256(priv_key, Bytes::new(0)) {
    Ok(s) => debug_assert(bytes_to_hex(s) == exp_empty, "rsa empty sig matches openssl")
    Err(_) => debug_assert(false, "rsa empty sign err")
  }
}

///|
test "rsa2048_bleichenbacher_and_malformed_rejections" {
  let pub_k = match RsaPublicKey::from_spki_der(r_from_hex(r_test_spki_hex())) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "rsa spki err")
      return ()
    }
  }
  let msg = "The quick brown fox jumps over the lazy dog".to_bytes()

  // 1. Missing ASN.1 NULL in DigestInfo
  let sig_nonull = r_from_hex(
    "",
  )
  match rsa_verify_rs256(pub_k, msg, sig_nonull) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "missing NULL")
    Ok(_) => debug_assert(false, "missing NULL must fail")
  }

  // 2. Trailing byte after digest
  let sig_trailing = r_from_hex(
    "",
  )
  match rsa_verify_rs256(pub_k, msg, sig_trailing) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "trailing byte")
    Ok(_) => debug_assert(false, "trailing byte must fail")
  }

  // 3. Corrupted 0xFF padding byte
  let sig_badpad = r_from_hex(
    "",
  )
  match rsa_verify_rs256(pub_k, msg, sig_badpad) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "bad pad")
    Ok(_) => debug_assert(false, "bad pad must fail")
  }

  // 4. Bleichenbacher short-padding shifted DigestInfo
  let sig_bleich = r_from_hex(
    "",
  )
  match rsa_verify_rs256(pub_k, msg, sig_bleich) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "bleichenbacher")
    Ok(_) => debug_assert(false, "bleichenbacher must fail")
  }

  // 5. sig >= n (sig == n and all-0xFF)
  match rsa_verify_rs256(pub_k, msg, r_from_hex(r_test_n_hex())) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "sig == n")
    Ok(_) => debug_assert(false, "sig == n must fail")
  }
  let mut all_ff = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    all_ff[i] = (0xFF).to_byte()
    i = i + 1
  }
  match rsa_verify_rs256(pub_k, msg, all_ff) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::SignatureMismatch), "sig all ff")
    Ok(_) => debug_assert(false, "sig all ff must fail")
  }

  // 6. Wrong signature lengths
  match rsa_verify_rs256(pub_k, msg, Bytes::new(255)) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidSignatureLength(255)), "sig255")
    Ok(_) => debug_assert(false, "sig255 must fail")
  }
  match rsa_verify_rs256(pub_k, msg, Bytes::new(257)) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidSignatureLength(257)), "sig257")
    Ok(_) => debug_assert(false, "sig257 must fail")
  }

  // 7. Weak modulus (< 2048 bits) rejected
  let mut weak_n = Bytes::new(128)
  weak_n[0] = (0x80).to_byte()
  weak_n[127] = (0x01).to_byte()
  match RsaPublicKey::from_components(weak_n, r_from_hex("010001")) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidKey), "weak 1024-bit rejected")
    Ok(_) => debug_assert(false, "weak 1024-bit must fail")
  }
}
