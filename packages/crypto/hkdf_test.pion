///| RFC 5869 HKDF-SHA256 (Cases 1–3), HKDF-SHA512 vectors, and boundary rejections.

///|
fn k_from_hex(s : String) -> Bytes {
  match hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn k_repeat(b : Int, n : Int) -> Bytes {
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b.to_byte()
    i = i + 1
  }
  out
}

///|
test "hkdf_sha256_rfc5869_cases_1_2_3" {
  // Case 1: Basic test case with SHA-256
  let ikm1 = k_repeat(0x0b, 22)
  let salt1 = k_from_hex("000102030405060708090a0b0c")
  let info1 = k_from_hex("f0f1f2f3f4f5f6f7f8f9")
  let prk1 = hkdf_sha256_extract(salt1, ikm1)
  debug_assert(
    bytes_to_hex(prk1) == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
    "rfc5869 case1 prk",
  )
  match hkdf_sha256_expand(prk1, info1, 42) {
    Ok(okm) => debug_assert(
      bytes_to_hex(okm) == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
      "rfc5869 case1 okm",
    )
    Err(_) => debug_assert(false, "rfc5869 case1 expand err")
  }
  match hkdf_sha256(salt1, ikm1, info1, 42) {
    Ok(okm) => debug_assert(
      bytes_to_hex(okm) == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
      "rfc5869 case1 full",
    )
    Err(_) => debug_assert(false, "rfc5869 case1 full err")
  }

  // Case 2: Longer inputs/outputs
  let mut ikm2 = Bytes::new(80)
  let mut salt2 = Bytes::new(80)
  let mut info2 = Bytes::new(80)
  let mut i = 0
  while i < 80 {
    ikm2[i] = i.to_byte()
    salt2[i] = (0x60 + i).to_byte()
    info2[i] = (0xb0 + i).to_byte()
    i = i + 1
  }
  let prk2 = hkdf_sha256_extract(salt2, ikm2)
  debug_assert(
    bytes_to_hex(prk2) == "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244",
    "rfc5869 case2 prk",
  )
  match hkdf_sha256(salt2, ikm2, info2, 82) {
    Ok(okm) => debug_assert(
      bytes_to_hex(okm) == "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87",
      "rfc5869 case2 okm",
    )
    Err(_) => debug_assert(false, "rfc5869 case2 err")
  }

  // Case 3: Zero-length salt/info
  let ikm3 = k_repeat(0x0b, 22)
  let prk3 = hkdf_sha256_extract(Bytes::new(0), ikm3)
  debug_assert(
    bytes_to_hex(prk3) == "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
    "rfc5869 case3 prk",
  )
  match hkdf_sha256(Bytes::new(0), ikm3, Bytes::new(0), 42) {
    Ok(okm) => debug_assert(
      bytes_to_hex(okm) == "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
      "rfc5869 case3 okm",
    )
    Err(_) => debug_assert(false, "rfc5869 case3 err")
  }
}

///|
test "hkdf_sha512_and_boundaries" {
  let ikm = k_repeat(0x0b, 22)
  let salt = k_from_hex("000102030405060708090a0b0c")
  let info = k_from_hex("f0f1f2f3f4f5f6f7f8f9")
  let prk512 = hkdf_sha512_extract(salt, ikm)
  debug_assert(
    bytes_to_hex(prk512) == "665799823737ded04a88e47e54a5890bb2c3d247c7a4254a8e61350723590a26c36238127d8661b88cf80ef802d57e2f7cebcf1e00e083848be19929c61b4237",
    "hkdf512 prk",
  )
  match hkdf_sha512(salt, ikm, info, 82) {
    Ok(okm) => debug_assert(
      bytes_to_hex(okm) == "832390086cda71fb47625bb5ceb168e4c8e26a1a16ed34d9fc7fe92c1481579338da362cb8d9f925d7cbcce0dff7098769cf15959867d571c1715450cb530137be3fb62f3cf32b84feba8f1eb1b563e20d97",
      "hkdf512 okm",
    )
    Err(_) => debug_assert(false, "hkdf512 okm err")
  }

  // Zero-length output is valid
  match hkdf_sha256_expand(Bytes::new(32), Bytes::new(0), 0) {
    Ok(b) => debug_assert(b.length() == 0, "len 0 ok")
    Err(_) => debug_assert(false, "len 0 err")
  }
  match hkdf_sha512_expand(Bytes::new(64), Bytes::new(0), 0) {
    Ok(b) => debug_assert(b.length() == 0, "len512 0 ok")
    Err(_) => debug_assert(false, "len512 0 err")
  }

  // Max valid output lengths
  match hkdf_sha256_expand(Bytes::new(32), Bytes::new(0), 255 * 32) {
    Ok(b) => debug_assert(b.length() == 255 * 32, "max256 ok")
    Err(_) => debug_assert(false, "max256 err")
  }
  match hkdf_sha512_expand(Bytes::new(64), Bytes::new(0), 255 * 64) {
    Ok(b) => debug_assert(b.length() == 255 * 64, "max512 ok")
    Err(_) => debug_assert(false, "max512 err")
  }

  // Invalid lengths & short PRKs
  match hkdf_sha256_expand(Bytes::new(32), Bytes::new(0), -1) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidLength(-1)), "neg256")
    Ok(_) => debug_assert(false, "neg256 must fail")
  }
  match hkdf_sha256_expand(Bytes::new(32), Bytes::new(0), 255 * 32 + 1) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidLength(8161)), "over256")
    Ok(_) => debug_assert(false, "over256 must fail")
  }
  match hkdf_sha256_expand(Bytes::new(31), Bytes::new(0), 32) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidKeyLength(31)), "prk31")
    Ok(_) => debug_assert(false, "prk31 must fail")
  }
  match hkdf_sha512_expand(Bytes::new(64), Bytes::new(0), -1) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidLength(-1)), "neg512")
    Ok(_) => debug_assert(false, "neg512 must fail")
  }
  match hkdf_sha512_expand(Bytes::new(64), Bytes::new(0), 255 * 64 + 1) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidLength(16321)), "over512")
    Ok(_) => debug_assert(false, "over512 must fail")
  }
  match hkdf_sha512_expand(Bytes::new(63), Bytes::new(0), 64) {
    Err(e) => debug_assert(crypto_error_eq(e, CryptoError::InvalidKeyLength(63)), "prk63")
    Ok(_) => debug_assert(false, "prk63 must fail")
  }
}
