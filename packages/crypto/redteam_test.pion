      let msg = rt_data(mls[mi], 7, 3)
      let expect = refs[ki * mls.length() + mi]
      let label = "hmac_sha384 klen=" + kls[ki].to_string() + " mlen=" + mls[mi].to_string()
      debug_assert(rt_hex(hmac_sha384(key, msg)) == expect, label + " one-shot")
      debug_assert(rt_stream_hmac_sha384(key, msg, 1) == expect, label + " chunk=1")
      debug_assert(rt_stream_hmac_sha384(key, msg, 129) == expect, label + " chunk=129")
      let h = HmacSha384::new(key)
      h.update(rt_data(97, 5, 9))
      h.reset()
      h.update(msg)
      let f1 = h.finalize_hex()
      debug_assert(f1 == expect, label + " reset clean")
      debug_assert(h.finalize_hex() == f1, label + " finalize idempotent")
      h.update_slice(msg, -7, -1)
      h.update_slice(msg, 1000, 2000)
      debug_assert(h.finalize_hex() == f1, label + " empty hostile slices are no-ops")
      mi = mi + 1
    }
    ki = ki + 1
  }
}

///|
fn rt_stream_hmac_sha512(key : Bytes, data : Bytes, chunk : Int) -> String {
  let h = HmacSha512::new(key)
  let n = data.length()
  let mut p = 0
  while p < n {
    let e = if p + chunk > n { n } else { p + chunk }
    h.update_slice(data, p, e)
    p = e
  }
  h.finalize_hex()
}

///|
test "redteam_hmac_sha512_key_lengths_streaming_reset" {
  let kls = rt_hmac_key_lengths()
  let mls = rt_hmac_msg_lengths()
  let refs = rt_hmac_sha512_vectors()
  let mut ki = 0
  while ki < kls.length() {
    let key = rt_data(kls[ki], 13, 1)
    let mut mi = 0
    while mi < mls.length() {
      let msg = rt_data(mls[mi], 7, 3)
      let expect = refs[ki * mls.length() + mi]
      let label = "hmac_sha512 klen=" + kls[ki].to_string() + " mlen=" + mls[mi].to_string()
      debug_assert(rt_hex(hmac_sha512(key, msg)) == expect, label + " one-shot")
      debug_assert(rt_stream_hmac_sha512(key, msg, 1) == expect, label + " chunk=1")
      debug_assert(rt_stream_hmac_sha512(key, msg, 129) == expect, label + " chunk=129")
      let h = HmacSha512::new(key)
      h.update(rt_data(97, 5, 9))
      h.reset()
      h.update(msg)
      let f1 = h.finalize_hex()
      debug_assert(f1 == expect, label + " reset clean")
      debug_assert(h.finalize_hex() == f1, label + " finalize idempotent")
      h.update_slice(msg, -7, -1)
      h.update_slice(msg, 1000, 2000)
      debug_assert(h.finalize_hex() == f1, label + " empty hostile slices are no-ops")
      mi = mi + 1
    }
    ki = ki + 1
  }
}

