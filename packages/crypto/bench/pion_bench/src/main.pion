///| Head-to-head benchmark binary for `packages/crypto` (Pion Native).
///| Modes:
///|   sha256   -- hash 16 MiB deterministic payload (256 x 64 KiB streaming)
///|   sha512   -- hash 16 MiB deterministic payload (256 x 64 KiB streaming)
///|   hmac256  -- 50,000 x HMAC-SHA256 over 256-byte messages
///|   ed25519  -- 200 x Ed25519 sign + 200 x strict Ed25519 verify

import "crypto"

///|
fn make_buf(len : Int) -> Bytes {
  let mut out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = ((i * 131 + 17) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn bench_sha256(world : World) -> Int {
  let chunk = make_buf(65536)
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 256 {
    h.update(chunk)
    i = i + 1
  }
  io_println(world, "sha256=" + h.finalize_hex())
  0
}

///|
fn bench_sha512(world : World) -> Int {
  let chunk = make_buf(65536)
  let h = crypto::Sha512::new()
  let mut i = 0
  while i < 256 {
    h.update(chunk)
    i = i + 1
  }
  io_println(world, "sha512=" + h.finalize_hex())
  0
}

///|
fn bench_hmac256(world : World) -> Int {
  let key = "pion-crypto-bench-hmac-key-0123456789abcdef".to_bytes()
  let mut msg = make_buf(256)
  let mut acc = Bytes::new(32)
  let mut i = 0
  while i < 50000 {
    msg[0] = (i & 0xFF).to_byte()
    msg[1] = ((i >> 8) & 0xFF).to_byte()
    let mac = crypto::hmac_sha256(key, msg)
    let mut j = 0
    while j < 32 {
      acc[j] = (acc[j].to_int() ^ mac[j].to_int()).to_byte()
      j = j + 1
    }
    i = i + 1
  }
  io_println(world, "hmac256_xor=" + crypto::bytes_to_hex(acc))
  0
}

///|
fn bench_ed25519(world : World) -> Int {
  let seed = match crypto::hex_to_bytes(
    "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
  ) {
    Some(b) => b
    None => return 1
  }
  let kp = match crypto::Ed25519KeyPair::from_seed(seed) {
    Ok(k) => k
    Err(_) => return 2
  }
  let pk = kp.public_key()
  let mut msg = make_buf(128)
  let h = crypto::Sha256::new()
  let mut ok_count = 0
  let mut i = 0
  while i < 200 {
    msg[0] = (i & 0xFF).to_byte()
    msg[1] = ((i >> 8) & 0xFF).to_byte()
    let sig = kp.sign(msg)
    if crypto::ed25519_verify(pk, msg, sig) {
      ok_count = ok_count + 1
    }
    h.update(sig)
    i = i + 1
  }
  io_println(world, "ed25519_ok=" + ok_count.to_string())
  io_println(world, "ed25519_sigs_sha256=" + h.finalize_hex())
  if ok_count == 200 { 0 } else { 3 }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "sha256" }
  if mode == "sha256" {
    bench_sha256(world)
  } else if mode == "sha512" {
    bench_sha512(world)
  } else if mode == "hmac256" {
    bench_hmac256(world)
  } else if mode == "ed25519" {
    bench_ed25519(world)
  } else {
    io_println(world, "usage: crypto_bench [sha256|sha512|hmac256|ed25519]")
    1
  }
}
