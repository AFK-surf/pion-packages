///| Head-to-head benchmark binary for `packages/crypto` (Pion Native).
///| Modes:
///|   sha256   -- hash 16 MiB deterministic payload (256 x 64 KiB streaming)
///|   sha512   -- hash 16 MiB deterministic payload (256 x 64 KiB streaming)
///|   hmac256  -- 50,000 x HMAC-SHA256 over 256-byte messages
///|   ed25519  -- 200 x Ed25519 sign + 200 x strict Ed25519 verify
///|   x25519   -- 200 x RFC 7748 X25519 key exchanges
///|   hkdf256  -- 20,000 x RFC 5869 HKDF-SHA256 (64-byte OKM)
///|   chacha20 -- 4 MiB (64 x 64 KiB) RFC 8439 ChaCha20-Poly1305 AEAD seal + open
///|   p256     -- 50 x NIST P-256 ES256 sign + 50 x ES256 verify

import "crypto"

///|
fn make_buf(len : Int) -> Bytes {
  let mut out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = ((i * 131 + 17) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

///|
fn bench_sha256(world : World) -> Int {
  let chunk = make_buf(65536)
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 256 {
    h.update(chunk)
    i = i + 1
  }
  io_println(world, "sha256=" + h.finalize_hex())
  0
}

///|
fn bench_sha512(world : World) -> Int {
  let chunk = make_buf(65536)
  let h = crypto::Sha512::new()
  let mut i = 0
  while i < 256 {
    h.update(chunk)
    i = i + 1
  }
  io_println(world, "sha512=" + h.finalize_hex())
  0
}

///|
fn bench_hmac256(world : World) -> Int {
  let key = "pion-crypto-bench-hmac-key-0123456789abcdef".to_bytes()
  let mut msg = make_buf(256)
  let mut acc = Bytes::new(32)
  let mut i = 0
  while i < 50000 {
    msg[0] = (i & 0xFF).to_byte()
    msg[1] = ((i >> 8) & 0xFF).to_byte()
    let mac = crypto::hmac_sha256(key, msg)
    let mut j = 0
    while j < 32 {
      acc[j] = (acc[j].to_int() ^ mac[j].to_int()).to_byte()
      j = j + 1
    }
    i = i + 1
  }
  io_println(world, "hmac256_xor=" + crypto::bytes_to_hex(acc))
  0
}

///|
fn bench_ed25519(world : World) -> Int {
  let seed = match crypto::hex_to_bytes(
    "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
  ) {
    Some(b) => b
    None => return 1
  }
  let kp = match crypto::Ed25519KeyPair::from_seed(seed) {
    Ok(k) => k
    Err(_) => return 2
  }
  let pk = kp.public_key()
  let mut msg = make_buf(128)
  let h = crypto::Sha256::new()
  let mut ok_count = 0
  let mut i = 0
  while i < 200 {
    msg[0] = (i & 0xFF).to_byte()
    msg[1] = ((i >> 8) & 0xFF).to_byte()
    let sig = kp.sign(msg)
    if crypto::ed25519_verify(pk, msg, sig) {
      ok_count = ok_count + 1
    }
    h.update(sig)
    i = i + 1
  }
  io_println(world, "ed25519_ok=" + ok_count.to_string())
  io_println(world, "ed25519_sigs_sha256=" + h.finalize_hex())
  if ok_count == 200 { 0 } else { 3 }
}

///|
fn bench_x25519(world : World) -> Int {
  let mut k = match crypto::hex_to_bytes(
    "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
  ) {
    Some(b) => b
    None => return 1
  }
  let mut u = match crypto::hex_to_bytes(
    "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f",
  ) {
    Some(b) => b
    None => return 1
  }
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 200 {
    let shared = match crypto::x25519(k, u) {
      Ok(s) => s
      Err(_) => return 2
    }
    h.update(shared)
    u = k
    k = shared
    i = i + 1
  }
  io_println(world, "x25519_sha256=" + h.finalize_hex())
  0
}

///|
fn bench_hkdf256(world : World) -> Int {
  let salt = "pion-crypto-bench-hkdf-salt-0123456789".to_bytes()
  let mut ikm = make_buf(32)
  let info = "pion-crypto-bench-hkdf-info".to_bytes()
  let mut acc = Bytes::new(64)
  let mut i = 0
  while i < 20000 {
    ikm[0] = (i & 0xFF).to_byte()
    ikm[1] = ((i >> 8) & 0xFF).to_byte()
    let okm = match crypto::hkdf_sha256(salt, ikm, info, 64) {
      Ok(b) => b
      Err(_) => return 1
    }
    let mut j = 0
    while j < 64 {
      acc[j] = (acc[j].to_int() ^ okm[j].to_int()).to_byte()
      j = j + 1
    }
    i = i + 1
  }
  io_println(world, "hkdf256_xor=" + crypto::bytes_to_hex(acc))
  0
}

///|
fn bench_chacha20(world : World) -> Int {
  let key = match crypto::hex_to_bytes(
    "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f",
  ) {
    Some(b) => b
    None => return 1
  }
  let mut nonce = match crypto::hex_to_bytes("070000004041424344454647") {
    Some(b) => b
    None => return 1
  }
  let aad = "pion-crypto-bench-aead-aad".to_bytes()
  let pt = make_buf(65536)
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 64 {
    nonce[0] = (i & 0xFF).to_byte()
    let sealed = match crypto::chacha20_poly1305_seal(key, nonce, aad, pt) {
      Ok(b) => b
      Err(_) => return 2
    }
    let opened = match crypto::chacha20_poly1305_open(key, nonce, aad, sealed) {
      Ok(b) => b
      Err(_) => return 3
    }
    if opened.length() != pt.length() {
      return 4
    }
    h.update(sealed)
    i = i + 1
  }
  io_println(world, "chacha20_sha256=" + h.finalize_hex())
  0
}

///|
fn bench_p256(world : World) -> Int {
  let sk = match crypto::hex_to_bytes(
    "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721",
  ) {
    Some(b) => b
    None => return 1
  }
  let pk = match crypto::p256_public_key(sk) {
    Ok(b) => b
    Err(_) => return 2
  }
  let mut msg = make_buf(128)
  let mut ok_count = 0
  let mut i = 0
  while i < 50 {
    msg[0] = (i & 0xFF).to_byte()
    let sig = match crypto::p256_sign_es256(sk, msg) {
      Ok(b) => b
      Err(_) => return 3
    }
    match crypto::p256_verify_es256(pk, msg, sig) {
      Ok(_) => ok_count = ok_count + 1
      Err(_) => ()
    }
    i = i + 1
  }
  io_println(world, "p256_ok=" + ok_count.to_string())
  if ok_count == 50 { 0 } else { 4 }
}

///|
fn bench_aes256gcm(world : World) -> Int {
  let key = match crypto::hex_to_bytes(
    "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f",
  ) {
    Some(b) => b
    None => return 1
  }
  let mut nonce = match crypto::hex_to_bytes("070000004041424344454647") {
    Some(b) => b
    None => return 1
  }
  let aad = "pion-crypto-bench-aead-aad".to_bytes()
  let pt = make_buf(65536)
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 1000 {
    nonce[0] = (i & 0xFF).to_byte()
    nonce[1] = ((i >> 8) & 0xFF).to_byte()
    let sealed = match crypto::aes256_gcm_seal(key, nonce, aad, pt) {
      Ok(b) => b
      Err(_) => return 2
    }
    let opened = match crypto::aes256_gcm_open(key, nonce, aad, sealed) {
      Ok(b) => b
      Err(_) => return 3
    }
    if opened.length() != pt.length() {
      return 4
    }
    h.update(sealed)
    i = i + 1
  }
  io_println(world, "aes256gcm_sha256=" + h.finalize_hex())
  0
}

///|
fn bench_aes256gcm_small(world : World) -> Int {
  let key = match crypto::hex_to_bytes(
    "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f",
  ) {
    Some(b) => b
    None => return 1
  }
  let mut nonce = match crypto::hex_to_bytes("070000004041424344454647") {
    Some(b) => b
    None => return 1
  }
  let aad = "pion-crypto-bench-small-aad".to_bytes()
  let pt = make_buf(256)
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 150000 {
    nonce[0] = (i & 0xFF).to_byte()
    nonce[1] = ((i >> 8) & 0xFF).to_byte()
    nonce[2] = ((i >> 16) & 0xFF).to_byte()
    let sealed = match crypto::aes256_gcm_seal(key, nonce, aad, pt) {
      Ok(b) => b
      Err(_) => return 2
    }
    let opened = match crypto::aes256_gcm_open(key, nonce, aad, sealed) {
      Ok(b) => b
      Err(_) => return 3
    }
    if opened.length() != pt.length() {
      return 4
    }
    h.update(sealed)
    i = i + 1
  }
  io_println(world, "aes256gcm_small_sha256=" + h.finalize_hex())
  0
}

///|
fn bench_p256_ecdh(world : World) -> Int {
  let mut sk = match crypto::hex_to_bytes(
    "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721",
  ) {
    Some(b) => b
    None => return 1
  }
  let peer_pub = match crypto::hex_to_bytes(
    "04c4cfd4dc14471cbc23f68830495857689ad122d899cc9d9726ea006c335a5122bb97ce9aac19a7a577297ad2654c320a1fb909cc0088793a691495d9aae2de08",
  ) {
    Some(b) => b
    None => return 1
  }
  let h = crypto::Sha256::new()
  let mut i = 0
  while i < 2000 {
    sk[31] = ((sk[31].to_int() + 1) & 0xFF).to_byte()
    let shared = match crypto::p256_ecdh(sk, peer_pub) {
      Ok(b) => b
      Err(_) => return 2
    }
    h.update(shared)
    i = i + 1
  }
  io_println(world, "p256_ecdh_sha256=" + h.finalize_hex())
  0
}

///|
fn bench_p256_validate(world : World) -> Int {
  let pub_u = match crypto::hex_to_bytes(
    "04c4cfd4dc14471cbc23f68830495857689ad122d899cc9d9726ea006c335a5122bb97ce9aac19a7a577297ad2654c320a1fb909cc0088793a691495d9aae2de08",
  ) {
    Some(b) => b
    None => return 1
  }
  let pub_c = match crypto::hex_to_bytes(
    "02c4cfd4dc14471cbc23f68830495857689ad122d899cc9d9726ea006c335a5122",
  ) {
    Some(b) => b
    None => return 1
  }
  let mut ok_count = 0
  let mut i = 0
  while i < 20000 {
    if crypto::p256_validate_pubkey(pub_u) {
      ok_count = ok_count + 1
    }
    if crypto::p256_validate_pubkey(pub_c) {
      ok_count = ok_count + 1
    }
    i = i + 1
  }
  io_println(world, "p256_validate_ok=" + ok_count.to_string())
  if ok_count == 40000 { 0 } else { 2 }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "sha256" }
  if mode == "sha256" {
    bench_sha256(world)
  } else if mode == "sha512" {
    bench_sha512(world)
  } else if mode == "hmac256" {
    bench_hmac256(world)
  } else if mode == "ed25519" {
    bench_ed25519(world)
  } else if mode == "x25519" {
    bench_x25519(world)
  } else if mode == "hkdf256" {
    bench_hkdf256(world)
  } else if mode == "chacha20" {
    bench_chacha20(world)
  } else if mode == "p256" {
    bench_p256(world)
  } else if mode == "aes256gcm" {
    bench_aes256gcm(world)
  } else if mode == "aes256gcm_small" {
    bench_aes256gcm_small(world)
  } else if mode == "p256_ecdh" {
    bench_p256_ecdh(world)
  } else if mode == "p256_validate" {
    bench_p256_validate(world)
  } else {
    io_println(
      world,
      "usage: crypto_bench [sha256|sha512|hmac256|ed25519|x25519|hkdf256|chacha20|p256|aes256gcm|aes256gcm_small|p256_ecdh|p256_validate]",
    )
    1
  }
}
