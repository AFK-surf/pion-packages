///| RFC 8017 RSA PKCS#1 v1.5 SHA-256 (RS256) signing and strict verification.
///| - Minimum modulus size: 2048 bits (max 8192 bits).
///| - Signing uses CRT with Bellcore fault self-check (`s^e mod n == em`).
///| - Verification enforces full-block constant-time comparison against the single canonical
///|   RFC 8017 DigestInfo (with explicit ASN.1 NULL), preventing Bleichenbacher's forgery attacks.

///|
pub struct RsaPrivateKey {
  n : BigUint
  e : BigUint
  p : BigUint
  q : BigUint
  dp : BigUint
  dq : BigUint
  qinv : BigUint
  size : Int
}

///|
pub struct RsaPublicKey {
  n : BigUint
  e : BigUint
  size : Int
}

///|
pub fn RsaPrivateKey::public_key(self : RsaPrivateKey) -> RsaPublicKey {
  RsaPublicKey::{ n: self.n, e: self.e, size: self.size }
}

///| Construct an `RsaPublicKey` from big-endian modulus `n` and public exponent `e`.
///| Requires `2048 <= bits(n) <= 8192`, odd `n`, odd `e >= 3`, and `e < n`.
pub fn RsaPublicKey::from_components(n_bytes : Bytes, e_bytes : Bytes) -> Result[RsaPublicKey, CryptoError] {
  let n = big_from_be(n_bytes)
  let e = big_from_be(e_bytes)
  let n_bits = big_bit_len(n)
  if n_bits < 2048 || n_bits > 8192 || !big_is_odd(n) {
    return Err(CryptoError::InvalidKey)
  }
  let two = big_from_u64(2UL)
  if big_cmp(e, two) <= 0 || !big_is_odd(e) || big_cmp(e, n) >= 0 {
    return Err(CryptoError::InvalidKey)
  }
  Ok(RsaPublicKey::{ n: n, e: e, size: (n_bits + 7) / 8 })
}

///| Parse an `RsaPublicKey` from SubjectPublicKeyInfo (SPKI) ASN.1 DER.
pub fn RsaPublicKey::from_spki_der(der : Bytes) -> Result[RsaPublicKey, CryptoError] {
  let spki = match der_sequence(der, 0, der.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let alg_span = match spki.take(0x30) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let alg = DerReader::{ data: der, at: alg_span.0, end: alg_span.0 + alg_span.1 }
  let oid_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let rsa_oid = der_const_hex("2a864886f70d010101")
  if !der_slice_eq(der, oid_span.0, oid_span.1, rsa_oid) {
    return Err(CryptoError::InvalidKey)
  }
  if !alg.done() {
    let null_span = match alg.take(0x05) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if null_span.1 != 0 || !alg.done() {
      return Err(CryptoError::InvalidDer)
    }
  }
  let bs = match spki.take(0x03) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !spki.done() || bs.1 < 2 || (der[bs.0].to_int() & 0xFF) != 0 {
    return Err(CryptoError::InvalidDer)
  }
  let pk = match der_sequence(der, bs.0 + 1, bs.1 - 1) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let n = match pk.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let e = match pk.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !pk.done() {
    return Err(CryptoError::InvalidDer)
  }
  let n_bits = big_bit_len(n)
  let two = big_from_u64(2UL)
  if n_bits < 2048 || n_bits > 8192 || !big_is_odd(n) || big_cmp(e, two) <= 0 || !big_is_odd(e) || big_cmp(e, n) >= 0 {
    return Err(CryptoError::InvalidKey)
  }
  Ok(RsaPublicKey::{ n: n, e: e, size: (n_bits + 7) / 8 })
}

///| Parse an `RsaPrivateKey` from PKCS#8 `PrivateKeyInfo` DER, validating modulus size (2048..8192 bits)
///| and full CRT mathematical consistency.
pub fn RsaPrivateKey::from_pkcs8_der(der : Bytes) -> Result[RsaPrivateKey, CryptoError] {
  let info = match der_sequence(der, 0, der.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ver = match info.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_is_zero(ver) {
    return Err(CryptoError::InvalidDer)
  }
  let alg_span = match info.take(0x30) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let alg = DerReader::{ data: der, at: alg_span.0, end: alg_span.0 + alg_span.1 }
  let oid_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let rsa_oid = der_const_hex("2a864886f70d010101")
  if !der_slice_eq(der, oid_span.0, oid_span.1, rsa_oid) {
    return Err(CryptoError::InvalidKey)
  }
  if !alg.done() {
    let null_span = match alg.take(0x05) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if null_span.1 != 0 || !alg.done() {
      return Err(CryptoError::InvalidDer)
    }
  }
  let priv_span = match info.take(0x04) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !info.done() {
    return Err(CryptoError::InvalidDer)
  }

  let rsa_seq = match der_sequence(der, priv_span.0, priv_span.1) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let rsa_ver = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_is_zero(rsa_ver) {
    return Err(CryptoError::InvalidKey)
  }
  let n = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let e = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let d = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let p = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let q = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dp = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dq = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let qinv = match rsa_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !rsa_seq.done() {
    return Err(CryptoError::InvalidDer)
  }

  let n_bits = big_bit_len(n)
  let one = big_from_u64(1UL)
  let two = big_from_u64(2UL)
  if n_bits < 2048 || n_bits > 8192 || !big_is_odd(n) {
    return Err(CryptoError::InvalidKey)
  }
  if big_cmp(e, two) <= 0 || !big_is_odd(e) || big_cmp(e, n) >= 0 || big_cmp(d, one) <= 0 || big_cmp(d, n) >= 0 {
    return Err(CryptoError::InvalidKey)
  }
  if big_cmp(p, two) <= 0 || big_cmp(q, two) <= 0 || big_eq(p, q) || !big_is_odd(p) || !big_is_odd(q) {
    return Err(CryptoError::InvalidKey)
  }
  if !big_eq(big_mul(p, q), n) {
    return Err(CryptoError::InvalidKey)
  }
  let pm1 = big_sub(p, one)
  let qm1 = big_sub(q, one)
  if !big_eq(big_mod(d, pm1), dp) || !big_eq(big_mod(d, qm1), dq) {
    return Err(CryptoError::InvalidKey)
  }
  if !big_eq(big_mul_mod(e, dp, pm1), one) || !big_eq(big_mul_mod(e, dq, qm1), one) {
    return Err(CryptoError::InvalidKey)
  }
  if big_is_zero(qinv) || big_cmp(qinv, p) >= 0 || !big_eq(big_mul_mod(q, qinv, p), one) {
    return Err(CryptoError::InvalidKey)
  }
  Ok(
    RsaPrivateKey::{
      n: n,
      e: e,
      p: p,
      q: q,
      dp: dp,
      dq: dq,
      qinv: qinv,
      size: (n_bits + 7) / 8,
    },
  )
}

///| Parse an `RsaPrivateKey` from PKCS#8 PEM (`-----BEGIN PRIVATE KEY-----`).
pub fn RsaPrivateKey::from_pkcs8_pem(pem : String) -> Result[RsaPrivateKey, CryptoError] {
  let der = match pem_decode(pem, "PRIVATE KEY") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  RsaPrivateKey::from_pkcs8_der(der)
}

///| Build canonical RFC 8017 EMSA-PKCS1-v1_5 SHA-256 encoded message block:
///| `0x00 || 0x01 || 0xFF...(size - 54 bytes, >= 8B) || 0x00 || 19B SHA-256 DigestInfo || 32B digest`.
fn rsa_pkcs1_sha256_em(msg : Bytes, size : Int) -> Bytes {
  let prefix = der_const_hex("3031300d060960864801650304020105000420")
  let digest = sha256(msg)
  let pad_len = size - 54
  let mut out = Bytes::new(size)
  out[0] = (0x00).to_byte()
  out[1] = (0x01).to_byte()
  let mut i = 0
  while i < pad_len {
    out[2 + i] = (0xFF).to_byte()
    i = i + 1
  }
  out[2 + pad_len] = (0x00).to_byte()
  let p_off = 3 + pad_len
  i = 0
  while i < prefix.length() {
    out[p_off + i] = prefix[i]
    i = i + 1
  }
  let d_off = p_off + prefix.length()
  i = 0
  while i < 32 {
    out[d_off + i] = digest[i]
    i = i + 1
  }
  out
}

///| Sign `msg` with RSA PKCS#1 v1.5 SHA-256 (RS256) using CRT + Bellcore fault self-check.
pub fn rsa_sign_rs256(key : RsaPrivateKey, msg : Bytes) -> Result[Bytes, CryptoError] {
  if key.size < 256 {
    return Err(CryptoError::InvalidKey)
  }
  let em = rsa_pkcs1_sha256_em(msg, key.size)
  let m = big_from_be(em)
  let a = big_mod_pow(m, key.dp, key.p)
  let b = big_mod_pow(m, key.dq, key.q)
  let b_mod_p = big_mod(b, key.p)
  let diff = big_sub_mod(a, b_mod_p, key.p)
  let h = big_mul_mod(diff, key.qinv, key.p)
  let signed = big_add(b, big_mul(key.q, h))
  // Bellcore fault check: verify signed^e mod n == m before releasing the signature
  if !big_eq(big_mod_pow(signed, key.e, key.n), m) {
    return Err(CryptoError::SignatureMismatch)
  }
  Ok(big_to_be(signed, key.size))
}

///| Strictly verify an RSA PKCS#1 v1.5 SHA-256 (RS256) signature.
///| Rejects wrong lengths, `sig >= n`, and any deviation from the exact full-length
///| RFC 8017 SHA-256 DigestInfo padding (immune to Bleichenbacher forgery attacks).
pub fn rsa_verify_rs256(
  key : RsaPublicKey,
  msg : Bytes,
  sig : Bytes,
) -> Result[Unit, CryptoError] {
  if key.size < 256 {
    return Err(CryptoError::InvalidKey)
  }
  if sig.length() != key.size {
    return Err(CryptoError::InvalidSignatureLength(sig.length()))
  }
  let s = big_from_be(sig)
  if big_cmp(s, key.n) >= 0 {
    return Err(CryptoError::SignatureMismatch)
  }
  let recovered = big_to_be(big_mod_pow(s, key.e, key.n), key.size)
  let expected = rsa_pkcs1_sha256_em(msg, key.size)
  if constant_time_eq(recovered, expected) {
    Ok(())
  } else {
    Err(CryptoError::SignatureMismatch)
  }
}
