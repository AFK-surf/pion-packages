///| RFC 7914 scrypt password-based key derivation function (pure Pion, zero World dependencies).
///| Hot path uses 16-register Salsa20/8 core, packed 2x32-bit `FixedArray[UInt64]` storage for
///| `V` and `xy` (halving memory footprint and load/store counts), ping-pong double buffering
///| (zero `Y -> X` copies), and explicit memory ceiling checks (`128 * r * (N + p + 2)`).

///| XOR `b[0..8]` (16 packed `UInt`s) with `inp[in_off/2 .. in_off/2 + 8]`, apply Salsa20/8 in
///| 16 `UInt` registers, and write the packed result to both `b[0..8]` and `out[out_off/2 .. out_off/2 + 8]`.
fn salsa20_8_xor(
  b : FixedArray[UInt64],
  inp : FixedArray[UInt64],
  in_off : Int,
  out : FixedArray[UInt64],
  out_off : Int,
) -> Unit {
  let in64 = in_off >> 1
  let p0 = b[0] ^ inp[in64]
  let p1 = b[1] ^ inp[in64 + 1]
  let p2 = b[2] ^ inp[in64 + 2]
  let p3 = b[3] ^ inp[in64 + 3]
  let p4 = b[4] ^ inp[in64 + 4]
  let p5 = b[5] ^ inp[in64 + 5]
  let p6 = b[6] ^ inp[in64 + 6]
  let p7 = b[7] ^ inp[in64 + 7]

  let mut x0 = p0.to_int().to_uint()
  let mut x1 = (p0 >> 32).to_int().to_uint()
  let mut x2 = p1.to_int().to_uint()
  let mut x3 = (p1 >> 32).to_int().to_uint()
  let mut x4 = p2.to_int().to_uint()
  let mut x5 = (p2 >> 32).to_int().to_uint()
  let mut x6 = p3.to_int().to_uint()
  let mut x7 = (p3 >> 32).to_int().to_uint()
  let mut x8 = p4.to_int().to_uint()
  let mut x9 = (p4 >> 32).to_int().to_uint()
  let mut x10 = p5.to_int().to_uint()
  let mut x11 = (p5 >> 32).to_int().to_uint()
  let mut x12 = p6.to_int().to_uint()
  let mut x13 = (p6 >> 32).to_int().to_uint()
  let mut x14 = p7.to_int().to_uint()
  let mut x15 = (p7 >> 32).to_int().to_uint()

  let mut round = 0
  while round < 4 {
    // Column round
    let mut t = x0 + x12
    x4 = x4 ^ ((t << 7U) | (t >> 25U))
    t = x4 + x0
    x8 = x8 ^ ((t << 9U) | (t >> 23U))
    t = x8 + x4
    x12 = x12 ^ ((t << 13U) | (t >> 19U))
    t = x12 + x8
    x0 = x0 ^ ((t << 18U) | (t >> 14U))

    t = x5 + x1
    x9 = x9 ^ ((t << 7U) | (t >> 25U))
    t = x9 + x5
    x13 = x13 ^ ((t << 9U) | (t >> 23U))
    t = x13 + x9
    x1 = x1 ^ ((t << 13U) | (t >> 19U))
    t = x1 + x13
    x5 = x5 ^ ((t << 18U) | (t >> 14U))

    t = x10 + x6
    x14 = x14 ^ ((t << 7U) | (t >> 25U))
    t = x14 + x10
    x2 = x2 ^ ((t << 9U) | (t >> 23U))
    t = x2 + x14
    x6 = x6 ^ ((t << 13U) | (t >> 19U))
    t = x6 + x2
    x10 = x10 ^ ((t << 18U) | (t >> 14U))

    t = x15 + x11
    x3 = x3 ^ ((t << 7U) | (t >> 25U))
    t = x3 + x15
    x7 = x7 ^ ((t << 9U) | (t >> 23U))
    t = x7 + x3
    x11 = x11 ^ ((t << 13U) | (t >> 19U))
    t = x11 + x7
    x15 = x15 ^ ((t << 18U) | (t >> 14U))

    // Row round
    t = x0 + x3
    x1 = x1 ^ ((t << 7U) | (t >> 25U))
    t = x1 + x0
    x2 = x2 ^ ((t << 9U) | (t >> 23U))
    t = x2 + x1
    x3 = x3 ^ ((t << 13U) | (t >> 19U))
    t = x3 + x2
    x0 = x0 ^ ((t << 18U) | (t >> 14U))

    t = x5 + x4
    x6 = x6 ^ ((t << 7U) | (t >> 25U))
    t = x6 + x5
    x7 = x7 ^ ((t << 9U) | (t >> 23U))
    t = x7 + x6
    x4 = x4 ^ ((t << 13U) | (t >> 19U))
    t = x4 + x7
    x5 = x5 ^ ((t << 18U) | (t >> 14U))

    t = x10 + x9
    x11 = x11 ^ ((t << 7U) | (t >> 25U))
    t = x11 + x10
    x8 = x8 ^ ((t << 9U) | (t >> 23U))
    t = x8 + x11
    x9 = x9 ^ ((t << 13U) | (t >> 19U))
    t = x9 + x8
    x10 = x10 ^ ((t << 18U) | (t >> 14U))

    t = x15 + x14
    x12 = x12 ^ ((t << 7U) | (t >> 25U))
    t = x12 + x15
    x13 = x13 ^ ((t << 9U) | (t >> 23U))
    t = x13 + x12
    x14 = x14 ^ ((t << 13U) | (t >> 19U))
    t = x14 + x13
    x15 = x15 ^ ((t << 18U) | (t >> 14U))

    round = round + 1
  }

  let out64 = out_off >> 1
  let q0 = (p0.to_int().to_uint() + x0).to_int64().to_uint64() |
  (((p0 >> 32).to_int().to_uint() + x1).to_int64().to_uint64() << 32)
  let q1 = (p1.to_int().to_uint() + x2).to_int64().to_uint64() |
  (((p1 >> 32).to_int().to_uint() + x3).to_int64().to_uint64() << 32)
  let q2 = (p2.to_int().to_uint() + x4).to_int64().to_uint64() |
  (((p2 >> 32).to_int().to_uint() + x5).to_int64().to_uint64() << 32)
  let q3 = (p3.to_int().to_uint() + x6).to_int64().to_uint64() |
  (((p3 >> 32).to_int().to_uint() + x7).to_int64().to_uint64() << 32)
  let q4 = (p4.to_int().to_uint() + x8).to_int64().to_uint64() |
  (((p4 >> 32).to_int().to_uint() + x9).to_int64().to_uint64() << 32)
  let q5 = (p5.to_int().to_uint() + x10).to_int64().to_uint64() |
  (((p5 >> 32).to_int().to_uint() + x11).to_int64().to_uint64() << 32)
  let q6 = (p6.to_int().to_uint() + x12).to_int64().to_uint64() |
  (((p6 >> 32).to_int().to_uint() + x13).to_int64().to_uint64() << 32)
  let q7 = (p7.to_int().to_uint() + x14).to_int64().to_uint64() |
  (((p7 >> 32).to_int().to_uint() + x15).to_int64().to_uint64() << 32)

  b[0] = q0
  b[1] = q1
  b[2] = q2
  b[3] = q3
  b[4] = q4
  b[5] = q5
  b[6] = q6
  b[7] = q7

  out[out64] = q0
  out[out64 + 1] = q1
  out[out64 + 2] = q2
  out[out64 + 3] = q3
  out[out64 + 4] = q4
  out[out64 + 5] = q5
  out[out64 + 6] = q6
  out[out64 + 7] = q7
}

///| RFC 7914 §4 scryptBlockMix: reads `2*r` 16-word subblocks from `xy[in_off/2..]`
///| and writes even/odd shuffled output into `xy[out_off/2..]`.
fn blockmix_salsa8(
  xy : FixedArray[UInt64],
  in_off : Int,
  out_off : Int,
  r : Int,
  x_blk : FixedArray[UInt64],
) -> Unit {
  let half = r << 4
  let last_in = in_off + ((r << 5) - 16)
  let last64 = last_in >> 1
  // X = B[2r - 1]
  x_blk[0] = xy[last64]
  x_blk[1] = xy[last64 + 1]
  x_blk[2] = xy[last64 + 2]
  x_blk[3] = xy[last64 + 3]
  x_blk[4] = xy[last64 + 4]
  x_blk[5] = xy[last64 + 5]
  x_blk[6] = xy[last64 + 6]
  x_blk[7] = xy[last64 + 7]

  let mut i = 0
  while i < r {
    let even_in = in_off + (i << 5)
    let even_out = out_off + (i << 4)
    salsa20_8_xor(x_blk, xy, even_in, xy, even_out)
    salsa20_8_xor(x_blk, xy, even_in + 16, xy, even_out + half)
    i = i + 1
  }
}

///| Fast Phase-1 BlockMix: reads `2*r` packed subblocks from `buf[in_off/2..]` and writes
///| even/odd shuffled output directly to `buf[out_off/2..]`, keeping the running Salsa20/8
///| state in 8 `UInt64` locals (zero `x_blk` traffic and zero per-subblock call overhead).
fn blockmix_salsa8_fast(
  buf : FixedArray[UInt64],
  in_off : Int,
  out_off : Int,
  r : Int,
) -> Unit {
  let half64 = r << 3
  let in64 = in_off >> 1
  let out64 = out_off >> 1
  let last64 = in64 + (r << 4) - 8
  let mut s0 = buf[last64]
  let mut s1 = buf[last64 + 1]
  let mut s2 = buf[last64 + 2]
  let mut s3 = buf[last64 + 3]
  let mut s4 = buf[last64 + 4]
  let mut s5 = buf[last64 + 5]
  let mut s6 = buf[last64 + 6]
  let mut s7 = buf[last64 + 7]

  let mut i = 0
  while i < r {
    let e_in = in64 + (i << 4)
    let eo = out64 + (i << 3)

    // Even subblock: 2*i -> out[i]
    let p0 = s0 ^ buf[e_in]
    let p1 = s1 ^ buf[e_in + 1]
    let p2 = s2 ^ buf[e_in + 2]
    let p3 = s3 ^ buf[e_in + 3]
    let p4 = s4 ^ buf[e_in + 4]
    let p5 = s5 ^ buf[e_in + 5]
    let p6 = s6 ^ buf[e_in + 6]
    let p7 = s7 ^ buf[e_in + 7]

    let mut x0 = p0.to_int().to_uint()
    let mut x1 = (p0 >> 32).to_int().to_uint()
    let mut x2 = p1.to_int().to_uint()
    let mut x3 = (p1 >> 32).to_int().to_uint()
    let mut x4 = p2.to_int().to_uint()
    let mut x5 = (p2 >> 32).to_int().to_uint()
    let mut x6 = p3.to_int().to_uint()
    let mut x7 = (p3 >> 32).to_int().to_uint()
    let mut x8 = p4.to_int().to_uint()
    let mut x9 = (p4 >> 32).to_int().to_uint()
    let mut x10 = p5.to_int().to_uint()
    let mut x11 = (p5 >> 32).to_int().to_uint()
    let mut x12 = p6.to_int().to_uint()
    let mut x13 = (p6 >> 32).to_int().to_uint()
    let mut x14 = p7.to_int().to_uint()
    let mut x15 = (p7 >> 32).to_int().to_uint()

    let mut round = 0
    while round < 4 {
      let mut t = x0 + x12
      x4 = x4 ^ ((t << 7U) | (t >> 25U))
      t = x4 + x0
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x4
      x12 = x12 ^ ((t << 13U) | (t >> 19U))
      t = x12 + x8
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x1
      x9 = x9 ^ ((t << 7U) | (t >> 25U))
      t = x9 + x5
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x9
      x1 = x1 ^ ((t << 13U) | (t >> 19U))
      t = x1 + x13
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x6
      x14 = x14 ^ ((t << 7U) | (t >> 25U))
      t = x14 + x10
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x14
      x6 = x6 ^ ((t << 13U) | (t >> 19U))
      t = x6 + x2
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x11
      x3 = x3 ^ ((t << 7U) | (t >> 25U))
      t = x3 + x15
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x3
      x11 = x11 ^ ((t << 13U) | (t >> 19U))
      t = x11 + x7
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      t = x0 + x3
      x1 = x1 ^ ((t << 7U) | (t >> 25U))
      t = x1 + x0
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x1
      x3 = x3 ^ ((t << 13U) | (t >> 19U))
      t = x3 + x2
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x4
      x6 = x6 ^ ((t << 7U) | (t >> 25U))
      t = x6 + x5
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x6
      x4 = x4 ^ ((t << 13U) | (t >> 19U))
      t = x4 + x7
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x9
      x11 = x11 ^ ((t << 7U) | (t >> 25U))
      t = x11 + x10
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x11
      x9 = x9 ^ ((t << 13U) | (t >> 19U))
      t = x9 + x8
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x14
      x12 = x12 ^ ((t << 7U) | (t >> 25U))
      t = x12 + x15
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x12
      x14 = x14 ^ ((t << 13U) | (t >> 19U))
      t = x14 + x13
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      round = round + 1
    }

    s0 = (p0.to_int().to_uint() + x0).to_int64().to_uint64() |
    (((p0 >> 32).to_int().to_uint() + x1).to_int64().to_uint64() << 32)
    s1 = (p1.to_int().to_uint() + x2).to_int64().to_uint64() |
    (((p1 >> 32).to_int().to_uint() + x3).to_int64().to_uint64() << 32)
    s2 = (p2.to_int().to_uint() + x4).to_int64().to_uint64() |
    (((p2 >> 32).to_int().to_uint() + x5).to_int64().to_uint64() << 32)
    s3 = (p3.to_int().to_uint() + x6).to_int64().to_uint64() |
    (((p3 >> 32).to_int().to_uint() + x7).to_int64().to_uint64() << 32)
    s4 = (p4.to_int().to_uint() + x8).to_int64().to_uint64() |
    (((p4 >> 32).to_int().to_uint() + x9).to_int64().to_uint64() << 32)
    s5 = (p5.to_int().to_uint() + x10).to_int64().to_uint64() |
    (((p5 >> 32).to_int().to_uint() + x11).to_int64().to_uint64() << 32)
    s6 = (p6.to_int().to_uint() + x12).to_int64().to_uint64() |
    (((p6 >> 32).to_int().to_uint() + x13).to_int64().to_uint64() << 32)
    s7 = (p7.to_int().to_uint() + x14).to_int64().to_uint64() |
    (((p7 >> 32).to_int().to_uint() + x15).to_int64().to_uint64() << 32)

    buf[eo] = s0
    buf[eo + 1] = s1
    buf[eo + 2] = s2
    buf[eo + 3] = s3
    buf[eo + 4] = s4
    buf[eo + 5] = s5
    buf[eo + 6] = s6
    buf[eo + 7] = s7

    // Odd subblock: 2*i + 1 -> out[r + i]
    let o_in = e_in + 8
    let oo = eo + half64
    let r0 = s0 ^ buf[o_in]
    let r1 = s1 ^ buf[o_in + 1]
    let r2 = s2 ^ buf[o_in + 2]
    let r3 = s3 ^ buf[o_in + 3]
    let r4 = s4 ^ buf[o_in + 4]
    let r5 = s5 ^ buf[o_in + 5]
    let r6 = s6 ^ buf[o_in + 6]
    let r7 = s7 ^ buf[o_in + 7]

    x0 = r0.to_int().to_uint()
    x1 = (r0 >> 32).to_int().to_uint()
    x2 = r1.to_int().to_uint()
    x3 = (r1 >> 32).to_int().to_uint()
    x4 = r2.to_int().to_uint()
    x5 = (r2 >> 32).to_int().to_uint()
    x6 = r3.to_int().to_uint()
    x7 = (r3 >> 32).to_int().to_uint()
    x8 = r4.to_int().to_uint()
    x9 = (r4 >> 32).to_int().to_uint()
    x10 = r5.to_int().to_uint()
    x11 = (r5 >> 32).to_int().to_uint()
    x12 = r6.to_int().to_uint()
    x13 = (r6 >> 32).to_int().to_uint()
    x14 = r7.to_int().to_uint()
    x15 = (r7 >> 32).to_int().to_uint()

    round = 0
    while round < 4 {
      let mut t = x0 + x12
      x4 = x4 ^ ((t << 7U) | (t >> 25U))
      t = x4 + x0
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x4
      x12 = x12 ^ ((t << 13U) | (t >> 19U))
      t = x12 + x8
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x1
      x9 = x9 ^ ((t << 7U) | (t >> 25U))
      t = x9 + x5
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x9
      x1 = x1 ^ ((t << 13U) | (t >> 19U))
      t = x1 + x13
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x6
      x14 = x14 ^ ((t << 7U) | (t >> 25U))
      t = x14 + x10
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x14
      x6 = x6 ^ ((t << 13U) | (t >> 19U))
      t = x6 + x2
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x11
      x3 = x3 ^ ((t << 7U) | (t >> 25U))
      t = x3 + x15
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x3
      x11 = x11 ^ ((t << 13U) | (t >> 19U))
      t = x11 + x7
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      t = x0 + x3
      x1 = x1 ^ ((t << 7U) | (t >> 25U))
      t = x1 + x0
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x1
      x3 = x3 ^ ((t << 13U) | (t >> 19U))
      t = x3 + x2
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x4
      x6 = x6 ^ ((t << 7U) | (t >> 25U))
      t = x6 + x5
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x6
      x4 = x4 ^ ((t << 13U) | (t >> 19U))
      t = x4 + x7
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x9
      x11 = x11 ^ ((t << 7U) | (t >> 25U))
      t = x11 + x10
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x11
      x9 = x9 ^ ((t << 13U) | (t >> 19U))
      t = x9 + x8
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x14
      x12 = x12 ^ ((t << 7U) | (t >> 25U))
      t = x12 + x15
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x12
      x14 = x14 ^ ((t << 13U) | (t >> 19U))
      t = x14 + x13
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      round = round + 1
    }

    s0 = (r0.to_int().to_uint() + x0).to_int64().to_uint64() |
    (((r0 >> 32).to_int().to_uint() + x1).to_int64().to_uint64() << 32)
    s1 = (r1.to_int().to_uint() + x2).to_int64().to_uint64() |
    (((r1 >> 32).to_int().to_uint() + x3).to_int64().to_uint64() << 32)
    s2 = (r2.to_int().to_uint() + x4).to_int64().to_uint64() |
    (((r2 >> 32).to_int().to_uint() + x5).to_int64().to_uint64() << 32)
    s3 = (r3.to_int().to_uint() + x6).to_int64().to_uint64() |
    (((r3 >> 32).to_int().to_uint() + x7).to_int64().to_uint64() << 32)
    s4 = (r4.to_int().to_uint() + x8).to_int64().to_uint64() |
    (((r4 >> 32).to_int().to_uint() + x9).to_int64().to_uint64() << 32)
    s5 = (r5.to_int().to_uint() + x10).to_int64().to_uint64() |
    (((r5 >> 32).to_int().to_uint() + x11).to_int64().to_uint64() << 32)
    s6 = (r6.to_int().to_uint() + x12).to_int64().to_uint64() |
    (((r6 >> 32).to_int().to_uint() + x13).to_int64().to_uint64() << 32)
    s7 = (r7.to_int().to_uint() + x14).to_int64().to_uint64() |
    (((r7 >> 32).to_int().to_uint() + x15).to_int64().to_uint64() << 32)

    buf[oo] = s0
    buf[oo + 1] = s1
    buf[oo + 2] = s2
    buf[oo + 3] = s3
    buf[oo + 4] = s4
    buf[oo + 5] = s5
    buf[oo + 6] = s6
    buf[oo + 7] = s7

    i = i + 1
  }
}

///| Fused Phase-2 BlockMix: computes `BlockMix(xy[in_off/2..] ^ v[v_off64..])` into `xy[out_off/2..]`
///| with the running 16-word Salsa20/8 state kept in 8 packed `UInt64` locals (zero `x_blk` traffic
///| and zero separate `xy ^= v` pass).
fn blockmix_salsa8_xor_v(
  xy : FixedArray[UInt64],
  in_off : Int,
  out_off : Int,
  v : FixedArray[UInt64],
  v_off64 : Int,
  r : Int,
) -> Unit {
  let half64 = r << 3
  let in64 = in_off >> 1
  let out64 = out_off >> 1
  let last_rel = (r << 4) - 8
  // X = (B ^ V[j])[2r - 1]
  let mut s0 = xy[in64 + last_rel] ^ v[v_off64 + last_rel]
  let mut s1 = xy[in64 + last_rel + 1] ^ v[v_off64 + last_rel + 1]
  let mut s2 = xy[in64 + last_rel + 2] ^ v[v_off64 + last_rel + 2]
  let mut s3 = xy[in64 + last_rel + 3] ^ v[v_off64 + last_rel + 3]
  let mut s4 = xy[in64 + last_rel + 4] ^ v[v_off64 + last_rel + 4]
  let mut s5 = xy[in64 + last_rel + 5] ^ v[v_off64 + last_rel + 5]
  let mut s6 = xy[in64 + last_rel + 6] ^ v[v_off64 + last_rel + 6]
  let mut s7 = xy[in64 + last_rel + 7] ^ v[v_off64 + last_rel + 7]

  let mut i = 0
  while i < r {
    let rel_even = i << 4
    let eo = out64 + (i << 3)

    // Even subblock: 2*i -> out[i]
    let e_in = in64 + rel_even
    let e_v = v_off64 + rel_even
    let p0 = s0 ^ xy[e_in] ^ v[e_v]
    let p1 = s1 ^ xy[e_in + 1] ^ v[e_v + 1]
    let p2 = s2 ^ xy[e_in + 2] ^ v[e_v + 2]
    let p3 = s3 ^ xy[e_in + 3] ^ v[e_v + 3]
    let p4 = s4 ^ xy[e_in + 4] ^ v[e_v + 4]
    let p5 = s5 ^ xy[e_in + 5] ^ v[e_v + 5]
    let p6 = s6 ^ xy[e_in + 6] ^ v[e_v + 6]
    let p7 = s7 ^ xy[e_in + 7] ^ v[e_v + 7]

    let mut x0 = p0.to_int().to_uint()
    let mut x1 = (p0 >> 32).to_int().to_uint()
    let mut x2 = p1.to_int().to_uint()
    let mut x3 = (p1 >> 32).to_int().to_uint()
    let mut x4 = p2.to_int().to_uint()
    let mut x5 = (p2 >> 32).to_int().to_uint()
    let mut x6 = p3.to_int().to_uint()
    let mut x7 = (p3 >> 32).to_int().to_uint()
    let mut x8 = p4.to_int().to_uint()
    let mut x9 = (p4 >> 32).to_int().to_uint()
    let mut x10 = p5.to_int().to_uint()
    let mut x11 = (p5 >> 32).to_int().to_uint()
    let mut x12 = p6.to_int().to_uint()
    let mut x13 = (p6 >> 32).to_int().to_uint()
    let mut x14 = p7.to_int().to_uint()
    let mut x15 = (p7 >> 32).to_int().to_uint()

    let mut round = 0
    while round < 4 {
      let mut t = x0 + x12
      x4 = x4 ^ ((t << 7U) | (t >> 25U))
      t = x4 + x0
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x4
      x12 = x12 ^ ((t << 13U) | (t >> 19U))
      t = x12 + x8
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x1
      x9 = x9 ^ ((t << 7U) | (t >> 25U))
      t = x9 + x5
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x9
      x1 = x1 ^ ((t << 13U) | (t >> 19U))
      t = x1 + x13
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x6
      x14 = x14 ^ ((t << 7U) | (t >> 25U))
      t = x14 + x10
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x14
      x6 = x6 ^ ((t << 13U) | (t >> 19U))
      t = x6 + x2
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x11
      x3 = x3 ^ ((t << 7U) | (t >> 25U))
      t = x3 + x15
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x3
      x11 = x11 ^ ((t << 13U) | (t >> 19U))
      t = x11 + x7
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      t = x0 + x3
      x1 = x1 ^ ((t << 7U) | (t >> 25U))
      t = x1 + x0
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x1
      x3 = x3 ^ ((t << 13U) | (t >> 19U))
      t = x3 + x2
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x4
      x6 = x6 ^ ((t << 7U) | (t >> 25U))
      t = x6 + x5
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x6
      x4 = x4 ^ ((t << 13U) | (t >> 19U))
      t = x4 + x7
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x9
      x11 = x11 ^ ((t << 7U) | (t >> 25U))
      t = x11 + x10
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x11
      x9 = x9 ^ ((t << 13U) | (t >> 19U))
      t = x9 + x8
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x14
      x12 = x12 ^ ((t << 7U) | (t >> 25U))
      t = x12 + x15
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x12
      x14 = x14 ^ ((t << 13U) | (t >> 19U))
      t = x14 + x13
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      round = round + 1
    }

    s0 = (p0.to_int().to_uint() + x0).to_int64().to_uint64() |
    (((p0 >> 32).to_int().to_uint() + x1).to_int64().to_uint64() << 32)
    s1 = (p1.to_int().to_uint() + x2).to_int64().to_uint64() |
    (((p1 >> 32).to_int().to_uint() + x3).to_int64().to_uint64() << 32)
    s2 = (p2.to_int().to_uint() + x4).to_int64().to_uint64() |
    (((p2 >> 32).to_int().to_uint() + x5).to_int64().to_uint64() << 32)
    s3 = (p3.to_int().to_uint() + x6).to_int64().to_uint64() |
    (((p3 >> 32).to_int().to_uint() + x7).to_int64().to_uint64() << 32)
    s4 = (p4.to_int().to_uint() + x8).to_int64().to_uint64() |
    (((p4 >> 32).to_int().to_uint() + x9).to_int64().to_uint64() << 32)
    s5 = (p5.to_int().to_uint() + x10).to_int64().to_uint64() |
    (((p5 >> 32).to_int().to_uint() + x11).to_int64().to_uint64() << 32)
    s6 = (p6.to_int().to_uint() + x12).to_int64().to_uint64() |
    (((p6 >> 32).to_int().to_uint() + x13).to_int64().to_uint64() << 32)
    s7 = (p7.to_int().to_uint() + x14).to_int64().to_uint64() |
    (((p7 >> 32).to_int().to_uint() + x15).to_int64().to_uint64() << 32)

    xy[eo] = s0
    xy[eo + 1] = s1
    xy[eo + 2] = s2
    xy[eo + 3] = s3
    xy[eo + 4] = s4
    xy[eo + 5] = s5
    xy[eo + 6] = s6
    xy[eo + 7] = s7

    // Odd subblock: 2*i + 1 -> out[r + i]
    let o_in = e_in + 8
    let o_v = e_v + 8
    let oo = eo + half64
    let r0 = s0 ^ xy[o_in] ^ v[o_v]
    let r1 = s1 ^ xy[o_in + 1] ^ v[o_v + 1]
    let r2 = s2 ^ xy[o_in + 2] ^ v[o_v + 2]
    let r3 = s3 ^ xy[o_in + 3] ^ v[o_v + 3]
    let r4 = s4 ^ xy[o_in + 4] ^ v[o_v + 4]
    let r5 = s5 ^ xy[o_in + 5] ^ v[o_v + 5]
    let r6 = s6 ^ xy[o_in + 6] ^ v[o_v + 6]
    let r7 = s7 ^ xy[o_in + 7] ^ v[o_v + 7]

    x0 = r0.to_int().to_uint()
    x1 = (r0 >> 32).to_int().to_uint()
    x2 = r1.to_int().to_uint()
    x3 = (r1 >> 32).to_int().to_uint()
    x4 = r2.to_int().to_uint()
    x5 = (r2 >> 32).to_int().to_uint()
    x6 = r3.to_int().to_uint()
    x7 = (r3 >> 32).to_int().to_uint()
    x8 = r4.to_int().to_uint()
    x9 = (r4 >> 32).to_int().to_uint()
    x10 = r5.to_int().to_uint()
    x11 = (r5 >> 32).to_int().to_uint()
    x12 = r6.to_int().to_uint()
    x13 = (r6 >> 32).to_int().to_uint()
    x14 = r7.to_int().to_uint()
    x15 = (r7 >> 32).to_int().to_uint()

    round = 0
    while round < 4 {
      let mut t = x0 + x12
      x4 = x4 ^ ((t << 7U) | (t >> 25U))
      t = x4 + x0
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x4
      x12 = x12 ^ ((t << 13U) | (t >> 19U))
      t = x12 + x8
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x1
      x9 = x9 ^ ((t << 7U) | (t >> 25U))
      t = x9 + x5
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x9
      x1 = x1 ^ ((t << 13U) | (t >> 19U))
      t = x1 + x13
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x6
      x14 = x14 ^ ((t << 7U) | (t >> 25U))
      t = x14 + x10
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x14
      x6 = x6 ^ ((t << 13U) | (t >> 19U))
      t = x6 + x2
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x11
      x3 = x3 ^ ((t << 7U) | (t >> 25U))
      t = x3 + x15
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x3
      x11 = x11 ^ ((t << 13U) | (t >> 19U))
      t = x11 + x7
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      t = x0 + x3
      x1 = x1 ^ ((t << 7U) | (t >> 25U))
      t = x1 + x0
      x2 = x2 ^ ((t << 9U) | (t >> 23U))
      t = x2 + x1
      x3 = x3 ^ ((t << 13U) | (t >> 19U))
      t = x3 + x2
      x0 = x0 ^ ((t << 18U) | (t >> 14U))

      t = x5 + x4
      x6 = x6 ^ ((t << 7U) | (t >> 25U))
      t = x6 + x5
      x7 = x7 ^ ((t << 9U) | (t >> 23U))
      t = x7 + x6
      x4 = x4 ^ ((t << 13U) | (t >> 19U))
      t = x4 + x7
      x5 = x5 ^ ((t << 18U) | (t >> 14U))

      t = x10 + x9
      x11 = x11 ^ ((t << 7U) | (t >> 25U))
      t = x11 + x10
      x8 = x8 ^ ((t << 9U) | (t >> 23U))
      t = x8 + x11
      x9 = x9 ^ ((t << 13U) | (t >> 19U))
      t = x9 + x8
      x10 = x10 ^ ((t << 18U) | (t >> 14U))

      t = x15 + x14
      x12 = x12 ^ ((t << 7U) | (t >> 25U))
      t = x12 + x15
      x13 = x13 ^ ((t << 9U) | (t >> 23U))
      t = x13 + x12
      x14 = x14 ^ ((t << 13U) | (t >> 19U))
      t = x14 + x13
      x15 = x15 ^ ((t << 18U) | (t >> 14U))

      round = round + 1
    }

    s0 = (r0.to_int().to_uint() + x0).to_int64().to_uint64() |
    (((r0 >> 32).to_int().to_uint() + x1).to_int64().to_uint64() << 32)
    s1 = (r1.to_int().to_uint() + x2).to_int64().to_uint64() |
    (((r1 >> 32).to_int().to_uint() + x3).to_int64().to_uint64() << 32)
    s2 = (r2.to_int().to_uint() + x4).to_int64().to_uint64() |
    (((r2 >> 32).to_int().to_uint() + x5).to_int64().to_uint64() << 32)
    s3 = (r3.to_int().to_uint() + x6).to_int64().to_uint64() |
    (((r3 >> 32).to_int().to_uint() + x7).to_int64().to_uint64() << 32)
    s4 = (r4.to_int().to_uint() + x8).to_int64().to_uint64() |
    (((r4 >> 32).to_int().to_uint() + x9).to_int64().to_uint64() << 32)
    s5 = (r5.to_int().to_uint() + x10).to_int64().to_uint64() |
    (((r5 >> 32).to_int().to_uint() + x11).to_int64().to_uint64() << 32)
    s6 = (r6.to_int().to_uint() + x12).to_int64().to_uint64() |
    (((r6 >> 32).to_int().to_uint() + x13).to_int64().to_uint64() << 32)
    s7 = (r7.to_int().to_uint() + x14).to_int64().to_uint64() |
    (((r7 >> 32).to_int().to_uint() + x15).to_int64().to_uint64() << 32)

    xy[oo] = s0
    xy[oo + 1] = s1
    xy[oo + 2] = s2
    xy[oo + 3] = s3
    xy[oo + 4] = s4
    xy[oo + 5] = s5
    xy[oo + 6] = s6
    xy[oo + 7] = s7

    i = i + 1
  }
}

///| RFC 7914 §5 scryptROMix on `b[b_off .. b_off + 128 * r]` using preallocated packed `xy`, `v`, `x_blk`.
fn scrypt_romix(
  b : Bytes,
  b_off : Int,
  r : Int,
  n : Int,
  xy : FixedArray[UInt64],
  v : FixedArray[UInt64],
  x_blk : FixedArray[UInt64],
) -> Unit {
  let block_words = r << 5
  let block_u64 = r << 4
  // Load little-endian 64-bit word pairs from B directly into V[0]
  let mut w = 0
  while w < block_u64 {
    let p = b_off + (w << 3)
    v[w] = b[p].to_int().to_int64().to_uint64() |
    (b[p + 1].to_int().to_int64().to_uint64() << 8) |
    (b[p + 2].to_int().to_int64().to_uint64() << 16) |
    (b[p + 3].to_int().to_int64().to_uint64() << 24) |
    (b[p + 4].to_int().to_int64().to_uint64() << 32) |
    (b[p + 5].to_int().to_int64().to_uint64() << 40) |
    (b[p + 6].to_int().to_int64().to_uint64() << 48) |
    (b[p + 7].to_int().to_int64().to_uint64() << 56)
    w = w + 1
  }

  // Phase 1: write V[i+1] = BlockMix(V[i]) directly in place (zero V <- xy copies)
  let mut i = 0
  while i < n - 1 {
    blockmix_salsa8_fast(v, i * block_words, (i + 1) * block_words, r)
    i = i + 1
  }
  // X = BlockMix(V[N - 1])
  let last_v = (n - 1) * block_u64
  let mut k = 0
  while k < block_u64 {
    xy[block_u64 + k] = v[last_v + k]
    k = k + 1
  }
  blockmix_salsa8(xy, block_words, 0, r, x_blk)

  // Phase 2: random-access mixing with fused V[j] XOR and ping-pong X <-> Y
  let mask = (n - 1).to_uint()
  let int_off_x = block_words - 16
  let int_off_y = (block_words << 1) - 16
  let int_x64 = int_off_x >> 1
  let int_y64 = int_off_y >> 1
  i = 0
  while i < n {
    let j0 = (xy[int_x64].to_int().to_uint() & mask).to_int()
    blockmix_salsa8_xor_v(xy, 0, block_words, v, j0 * block_u64, r)

    let j1 = (xy[int_y64].to_int().to_uint() & mask).to_int()
    blockmix_salsa8_xor_v(xy, block_words, 0, v, j1 * block_u64, r)
    i = i + 2
  }

  // Store X = xy[0 .. block_u64] back to B as little-endian bytes
  w = 0
  while w < block_u64 {
    let word = xy[w]
    let p = b_off + (w << 3)
    b[p] = (word & 0xFFUL).to_int().to_byte()
    b[p + 1] = ((word >> 8) & 0xFFUL).to_int().to_byte()
    b[p + 2] = ((word >> 16) & 0xFFUL).to_int().to_byte()
    b[p + 3] = ((word >> 24) & 0xFFUL).to_int().to_byte()
    b[p + 4] = ((word >> 32) & 0xFFUL).to_int().to_byte()
    b[p + 5] = ((word >> 40) & 0xFFUL).to_int().to_byte()
    b[p + 6] = ((word >> 48) & 0xFFUL).to_int().to_byte()
    b[p + 7] = ((word >> 56) & 0xFFUL).to_int().to_byte()
    w = w + 1
  }
}

///| RFC 7914 scrypt with explicit memory ceiling `max_mem_bytes`.
///| Memory usage is checked against `128 * r * (n + p + 2) <= max_mem_bytes` (overflow-safe).
///| Independent of `max_mem_bytes`, the V table is capped below 1 GiB (`32 * r * n < 2^28` words,
///| `MemoryLimitExceeded`) on every target, `N < 2^(16 r)` is enforced (`InvalidParam`) and
///| `dk_len <= 2^30` (`InvalidLength`).
pub fn scrypt_with_max_mem(
  password : Bytes,
  salt : Bytes,
  n : Int,
  r : Int,
  p : Int,
  dk_len : Int,
  max_mem_bytes : Int64,
) -> Result[Bytes, CryptoError] {
  if n <= 1 || (n & (n - 1)) != 0 {
    return Err(CryptoError::InvalidParam)
  }
  if r <= 0 || p <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  // RFC 7914 §2: N < 2^(128 * r / 8) = 2^(16 r). Only r = 1 can be violated by an `Int` N
  // (r >= 2 gives 2^32 > Int::MAX); OpenSSL / Node.js refuse it, Go x/crypto does not.
  if r < 2 && n >= 65536 {
    return Err(CryptoError::InvalidParam)
  }
  // Same 1 GiB output cap as PBKDF2, checked before the (expensive) ROMix.
  if dk_len <= 0 || dk_len > 1073741824 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  if max_mem_bytes <= 0L {
    return Err(CryptoError::InvalidParam)
  }
  // RFC 7914 §6 requires r * p < 2^30
  let r64 = r.to_int64()
  let p64 = p.to_int64()
  if r64 * p64 >= 1073741824L {
    return Err(CryptoError::InvalidParam)
  }
  // Standard OpenSSL / Node.js / RFC memory bound: 128 * r * (N + p + 2) <= max_mem_bytes
  let unit = 128L * r64
  let n_plus = n.to_int64() + p64 + 2L
  if n_plus > max_mem_bytes / unit {
    return Err(CryptoError::MemoryLimitExceeded)
  }
  // Target-independent hard ceiling: V < 2^28 words (< 1 GiB) whatever `max_mem_bytes` says, so
  // native and wasm32 agree (a FixedArray[UInt] of >= 2^28 elements traps on wasm32); B stays
  // within the 32-bit `Bytes` index bound.
  let v_words64 = n.to_int64() * 32L * r64
  let b_len64 = 128L * r64 * p64
  if v_words64 >= 268435456L || b_len64 > 2147483647L {
    return Err(CryptoError::MemoryLimitExceeded)
  }

  let b_len = b_len64.to_int()
  let b = match pbkdf2_hmac_sha256(password, salt, 1, b_len) {
    Ok(buf) => buf
    Err(e) => return Err(e)
  }

  let xy : FixedArray[UInt64] = FixedArray::make(r << 5, 0UL)
  let v : FixedArray[UInt64] = FixedArray::make((v_words64 >> 1).to_int(), 0UL)
  let x_blk : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let block_bytes = r << 7

  let mut bi = 0
  while bi < p {
    scrypt_romix(b, bi * block_bytes, r, n, xy, v, x_blk)
    bi = bi + 1
  }

  pbkdf2_hmac_sha256(password, b, 1, dk_len)
}

///| RFC 7914 scrypt with default 256 MiB safety ceiling (covers N=131072, r=8, p=1).
pub fn scrypt(
  password : Bytes,
  salt : Bytes,
  n : Int,
  r : Int,
  p : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  scrypt_with_max_mem(password, salt, n, r, p, dk_len, 268435456L)
}
