///| RFC 7914 scrypt password-based key derivation function (pure Pion, zero World dependencies).
///| Hot path uses 16-register Salsa20/8 core, flat `FixedArray[UInt]` reuse across `ROMix` & `BlockMix`,
///| ping-pong double buffering (zero `Y -> X` copies), and explicit memory ceiling checks (`128 * r * (N + p + 2)`).

///| XOR `b[0..16]` with `inp[in_off..in_off+16]`, apply Salsa20/8 in 16 `UInt` registers,
///| and write the result to both `b[0..16]` and `out[out_off..out_off+16]`.
fn salsa20_8_xor(
  b : FixedArray[UInt],
  inp : FixedArray[UInt],
  in_off : Int,
  out : FixedArray[UInt],
  out_off : Int,
) -> Unit {
  let b0 = b[0] ^ inp[in_off]
  let b1 = b[1] ^ inp[in_off + 1]
  let b2 = b[2] ^ inp[in_off + 2]
  let b3 = b[3] ^ inp[in_off + 3]
  let b4 = b[4] ^ inp[in_off + 4]
  let b5 = b[5] ^ inp[in_off + 5]
  let b6 = b[6] ^ inp[in_off + 6]
  let b7 = b[7] ^ inp[in_off + 7]
  let b8 = b[8] ^ inp[in_off + 8]
  let b9 = b[9] ^ inp[in_off + 9]
  let b10 = b[10] ^ inp[in_off + 10]
  let b11 = b[11] ^ inp[in_off + 11]
  let b12 = b[12] ^ inp[in_off + 12]
  let b13 = b[13] ^ inp[in_off + 13]
  let b14 = b[14] ^ inp[in_off + 14]
  let b15 = b[15] ^ inp[in_off + 15]

  let mut x0 = b0
  let mut x1 = b1
  let mut x2 = b2
  let mut x3 = b3
  let mut x4 = b4
  let mut x5 = b5
  let mut x6 = b6
  let mut x7 = b7
  let mut x8 = b8
  let mut x9 = b9
  let mut x10 = b10
  let mut x11 = b11
  let mut x12 = b12
  let mut x13 = b13
  let mut x14 = b14
  let mut x15 = b15

  let mut round = 0
  while round < 4 {
    // Column round
    let mut t = x0 + x12
    x4 = x4 ^ ((t << 7U) | (t >> 25U))
    t = x4 + x0
    x8 = x8 ^ ((t << 9U) | (t >> 23U))
    t = x8 + x4
    x12 = x12 ^ ((t << 13U) | (t >> 19U))
    t = x12 + x8
    x0 = x0 ^ ((t << 18U) | (t >> 14U))

    t = x5 + x1
    x9 = x9 ^ ((t << 7U) | (t >> 25U))
    t = x9 + x5
    x13 = x13 ^ ((t << 9U) | (t >> 23U))
    t = x13 + x9
    x1 = x1 ^ ((t << 13U) | (t >> 19U))
    t = x1 + x13
    x5 = x5 ^ ((t << 18U) | (t >> 14U))

    t = x10 + x6
    x14 = x14 ^ ((t << 7U) | (t >> 25U))
    t = x14 + x10
    x2 = x2 ^ ((t << 9U) | (t >> 23U))
    t = x2 + x14
    x6 = x6 ^ ((t << 13U) | (t >> 19U))
    t = x6 + x2
    x10 = x10 ^ ((t << 18U) | (t >> 14U))

    t = x15 + x11
    x3 = x3 ^ ((t << 7U) | (t >> 25U))
    t = x3 + x15
    x7 = x7 ^ ((t << 9U) | (t >> 23U))
    t = x7 + x3
    x11 = x11 ^ ((t << 13U) | (t >> 19U))
    t = x11 + x7
    x15 = x15 ^ ((t << 18U) | (t >> 14U))

    // Row round
    t = x0 + x3
    x1 = x1 ^ ((t << 7U) | (t >> 25U))
    t = x1 + x0
    x2 = x2 ^ ((t << 9U) | (t >> 23U))
    t = x2 + x1
    x3 = x3 ^ ((t << 13U) | (t >> 19U))
    t = x3 + x2
    x0 = x0 ^ ((t << 18U) | (t >> 14U))

    t = x5 + x4
    x6 = x6 ^ ((t << 7U) | (t >> 25U))
    t = x6 + x5
    x7 = x7 ^ ((t << 9U) | (t >> 23U))
    t = x7 + x6
    x4 = x4 ^ ((t << 13U) | (t >> 19U))
    t = x4 + x7
    x5 = x5 ^ ((t << 18U) | (t >> 14U))

    t = x10 + x9
    x11 = x11 ^ ((t << 7U) | (t >> 25U))
    t = x11 + x10
    x8 = x8 ^ ((t << 9U) | (t >> 23U))
    t = x8 + x11
    x9 = x9 ^ ((t << 13U) | (t >> 19U))
    t = x9 + x8
    x10 = x10 ^ ((t << 18U) | (t >> 14U))

    t = x15 + x14
    x12 = x12 ^ ((t << 7U) | (t >> 25U))
    t = x12 + x15
    x13 = x13 ^ ((t << 9U) | (t >> 23U))
    t = x13 + x12
    x14 = x14 ^ ((t << 13U) | (t >> 19U))
    t = x14 + x13
    x15 = x15 ^ ((t << 18U) | (t >> 14U))

    round = round + 1
  }

  let r0 = b0 + x0
  let r1 = b1 + x1
  let r2 = b2 + x2
  let r3 = b3 + x3
  let r4 = b4 + x4
  let r5 = b5 + x5
  let r6 = b6 + x6
  let r7 = b7 + x7
  let r8 = b8 + x8
  let r9 = b9 + x9
  let r10 = b10 + x10
  let r11 = b11 + x11
  let r12 = b12 + x12
  let r13 = b13 + x13
  let r14 = b14 + x14
  let r15 = b15 + x15

  b[0] = r0
  b[1] = r1
  b[2] = r2
  b[3] = r3
  b[4] = r4
  b[5] = r5
  b[6] = r6
  b[7] = r7
  b[8] = r8
  b[9] = r9
  b[10] = r10
  b[11] = r11
  b[12] = r12
  b[13] = r13
  b[14] = r14
  b[15] = r15

  out[out_off] = r0
  out[out_off + 1] = r1
  out[out_off + 2] = r2
  out[out_off + 3] = r3
  out[out_off + 4] = r4
  out[out_off + 5] = r5
  out[out_off + 6] = r6
  out[out_off + 7] = r7
  out[out_off + 8] = r8
  out[out_off + 9] = r9
  out[out_off + 10] = r10
  out[out_off + 11] = r11
  out[out_off + 12] = r12
  out[out_off + 13] = r13
  out[out_off + 14] = r14
  out[out_off + 15] = r15
}

///| RFC 7914 §4 scryptBlockMix: reads `2*r` 16-word subblocks from `xy[in_off..]`
///| and writes even/odd shuffled output into `xy[out_off..]`.
fn blockmix_salsa8(
  xy : FixedArray[UInt],
  in_off : Int,
  out_off : Int,
  r : Int,
  x_blk : FixedArray[UInt],
) -> Unit {
  let half = r << 4
  let last_in = in_off + ((r << 5) - 16)
  // X = B[2r - 1]
  x_blk[0] = xy[last_in]
  x_blk[1] = xy[last_in + 1]
  x_blk[2] = xy[last_in + 2]
  x_blk[3] = xy[last_in + 3]
  x_blk[4] = xy[last_in + 4]
  x_blk[5] = xy[last_in + 5]
  x_blk[6] = xy[last_in + 6]
  x_blk[7] = xy[last_in + 7]
  x_blk[8] = xy[last_in + 8]
  x_blk[9] = xy[last_in + 9]
  x_blk[10] = xy[last_in + 10]
  x_blk[11] = xy[last_in + 11]
  x_blk[12] = xy[last_in + 12]
  x_blk[13] = xy[last_in + 13]
  x_blk[14] = xy[last_in + 14]
  x_blk[15] = xy[last_in + 15]

  let mut i = 0
  while i < r {
    let even_in = in_off + (i << 5)
    let even_out = out_off + (i << 4)
    salsa20_8_xor(x_blk, xy, even_in, xy, even_out)
    salsa20_8_xor(x_blk, xy, even_in + 16, xy, even_out + half)
    i = i + 1
  }
}

///| RFC 7914 §5 scryptROMix on `b[b_off .. b_off + 128 * r]` using preallocated `xy`, `v`, `x_blk`.
fn scrypt_romix(
  b : Bytes,
  b_off : Int,
  r : Int,
  n : Int,
  xy : FixedArray[UInt],
  v : FixedArray[UInt],
  x_blk : FixedArray[UInt],
) -> Unit {
  let block_words = r << 5
  // Load little-endian UInt words from B into X = xy[0 .. block_words]
  let mut w = 0
  while w < block_words {
    let p = b_off + (w << 2)
    xy[w] = b[p].to_int().to_uint() |
    (b[p + 1].to_int().to_uint() << 8U) |
    (b[p + 2].to_int().to_uint() << 16U) |
    (b[p + 3].to_int().to_uint() << 24U)
    w = w + 1
  }

  // Phase 1: V[0..N-1] with ping-pong X <-> Y (N >= 2 is power of 2, always even)
  let mut i = 0
  while i < n {
    let v_off0 = i * block_words
    let mut k = 0
    while k < block_words {
      v[v_off0 + k] = xy[k]
      k = k + 1
    }
    blockmix_salsa8(xy, 0, block_words, r, x_blk)

    let v_off1 = (i + 1) * block_words
    k = 0
    while k < block_words {
      v[v_off1 + k] = xy[block_words + k]
      k = k + 1
    }
    blockmix_salsa8(xy, block_words, 0, r, x_blk)
    i = i + 2
  }

  // Phase 2: random-access mixing with ping-pong X <-> Y
  let mask = (n - 1).to_uint()
  let int_off_x = block_words - 16
  let int_off_y = (block_words << 1) - 16
  i = 0
  while i < n {
    let j0 = (xy[int_off_x] & mask).to_int()
    let v_off0 = j0 * block_words
    let mut k = 0
    while k < block_words {
      xy[k] = xy[k] ^ v[v_off0 + k]
      k = k + 1
    }
    blockmix_salsa8(xy, 0, block_words, r, x_blk)

    let j1 = (xy[int_off_y] & mask).to_int()
    let v_off1 = j1 * block_words
    k = 0
    while k < block_words {
      xy[block_words + k] = xy[block_words + k] ^ v[v_off1 + k]
      k = k + 1
    }
    blockmix_salsa8(xy, block_words, 0, r, x_blk)
    i = i + 2
  }

  // Store X = xy[0 .. block_words] back to B as little-endian bytes
  w = 0
  while w < block_words {
    let word = xy[w]
    let p = b_off + (w << 2)
    b[p] = (word & 0xFFU).to_int().to_byte()
    b[p + 1] = ((word >> 8U) & 0xFFU).to_int().to_byte()
    b[p + 2] = ((word >> 16U) & 0xFFU).to_int().to_byte()
    b[p + 3] = ((word >> 24U) & 0xFFU).to_int().to_byte()
    w = w + 1
  }
}

///| RFC 7914 scrypt with explicit memory ceiling `max_mem_bytes`.
///| Memory usage is checked against `128 * r * (n + p + 2) <= max_mem_bytes` (overflow-safe).
pub fn scrypt_with_max_mem(
  password : Bytes,
  salt : Bytes,
  n : Int,
  r : Int,
  p : Int,
  dk_len : Int,
  max_mem_bytes : Int64,
) -> Result[Bytes, CryptoError] {
  if n <= 1 || (n & (n - 1)) != 0 {
    return Err(CryptoError::InvalidParam)
  }
  if r <= 0 || p <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  if dk_len <= 0 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  if max_mem_bytes <= 0L {
    return Err(CryptoError::InvalidParam)
  }
  // RFC 7914 §6 requires r * p < 2^30
  let r64 = r.to_int64()
  let p64 = p.to_int64()
  if r64 * p64 >= 1073741824L {
    return Err(CryptoError::InvalidParam)
  }
  // Standard OpenSSL / Node.js / RFC memory bound: 128 * r * (N + p + 2) <= max_mem_bytes
  let unit = 128L * r64
  let n_plus = n.to_int64() + p64 + 2L
  if n_plus > max_mem_bytes / unit {
    return Err(CryptoError::MemoryLimitExceeded)
  }
  // Guard FixedArray[UInt] / Bytes 32-bit index bounds
  let v_words64 = n.to_int64() * 32L * r64
  let b_len64 = 128L * r64 * p64
  if v_words64 > 2147483647L || b_len64 > 2147483647L {
    return Err(CryptoError::MemoryLimitExceeded)
  }

  let b_len = b_len64.to_int()
  let b = match pbkdf2_hmac_sha256(password, salt, 1, b_len) {
    Ok(buf) => buf
    Err(e) => return Err(e)
  }

  let xy : FixedArray[UInt] = FixedArray::make(r << 6, 0U)
  let v : FixedArray[UInt] = FixedArray::make(v_words64.to_int(), 0U)
  let x_blk : FixedArray[UInt] = FixedArray::make(16, 0U)
  let block_bytes = r << 7

  let mut bi = 0
  while bi < p {
    scrypt_romix(b, bi * block_bytes, r, n, xy, v, x_blk)
    bi = bi + 1
  }

  pbkdf2_hmac_sha256(password, b, 1, dk_len)
}

///| RFC 7914 scrypt with default 256 MiB safety ceiling (covers N=131072, r=8, p=1).
pub fn scrypt(
  password : Bytes,
  salt : Bytes,
  n : Int,
  r : Int,
  p : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  scrypt_with_max_mem(password, salt, n, r, p, dk_len, 268435456L)
}
