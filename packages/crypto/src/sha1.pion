///| FIPS 180-4 SHA-1 streaming and one-shot hasher (pure Pion, zero World dependencies).
///| Provided for legacy protocol compatibility (e.g. WebSocket handshake, Git object IDs);
///| use SHA-256 or SHA-512 for cryptographic security.

///|
fn sha1_compress_w(state : FixedArray[UInt], w : FixedArray[UInt]) -> Unit {
  let mut i = 16
  while i < 80 {
    let x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]
    w[i] = (x << 1U) | (x >> 31U)
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]

  let mut t = 0
  while t < 20 {
    let f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
    let tmp = ((a << 5U) | (a >> 27U)) + f + e + 0x5A827999U + w[t]
    e = d
    d = c
    c = (b << 30U) | (b >> 2U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 40 {
    let f = b ^ c ^ d
    let tmp = ((a << 5U) | (a >> 27U)) + f + e + 0x6ED9EBA1U + w[t]
    e = d
    d = c
    c = (b << 30U) | (b >> 2U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 60 {
    let f = (b & c) | (b & d) | (c & d)
    let tmp = ((a << 5U) | (a >> 27U)) + f + e + 0x8F1BBCDCU + w[t]
    e = d
    d = c
    c = (b << 30U) | (b >> 2U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 80 {
    let f = b ^ c ^ d
    let tmp = ((a << 5U) | (a >> 27U)) + f + e + 0xCA62C1D6U + w[t]
    e = d
    d = c
    c = (b << 30U) | (b >> 2U)
    b = a
    a = tmp
    t = t + 1
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
}

///|
fn sha1_load_block_bytes(buf : Bytes, off : Int, w : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + (i << 2)
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[i] = (b0 << 24U) | (b1 << 16U) | (b2 << 8U) | b3
    i = i + 1
  }
}

///|
fn sha1_load_block_arr(buf : FixedArray[Int], w : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = i << 2
    w[i] = (buf[p].to_uint() << 24U) |
    (buf[p + 1].to_uint() << 16U) |
    (buf[p + 2].to_uint() << 8U) |
    buf[p + 3].to_uint()
    i = i + 1
  }
}

///|
fn sha1_state_to_bytes(state : FixedArray[UInt]) -> Bytes {
  let mut out = Bytes::new(20)
  let mut i = 0
  while i < 5 {
    let v = state[i]
    let p = i << 2
    out[p] = ((v >> 24U) & 0xFFU).to_int().to_byte()
    out[p + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
    out[p + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
    out[p + 3] = (v & 0xFFU).to_int().to_byte()
    i = i + 1
  }
  out
}

///|
pub struct Sha1 {
  state : FixedArray[UInt]
  buf : FixedArray[Int]
  w : FixedArray[UInt]
  mut fill : Int
  mut total : Int64
}

///|
pub fn Sha1::new() -> Sha1 {
  Sha1::{
    state: [0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U],
    buf: FixedArray::make(64, 0),
    w: FixedArray::make(80, 0U),
    fill: 0,
    total: 0L,
  }
}

///|
pub fn Sha1::reset(self : Sha1) -> Unit {
  self.state[0] = 0x67452301U
  self.state[1] = 0xEFCDAB89U
  self.state[2] = 0x98BADCFEU
  self.state[3] = 0x10325476U
  self.state[4] = 0xC3D2E1F0U
  self.fill = 0
  self.total = 0L
}

///|
pub fn Sha1::update_slice(self : Sha1, data : Bytes, start : Int, end : Int) -> Unit {
  let n = data.length()
  let mut pos = if start < 0 { 0 } else { start }
  let lim = if end > n { n } else { end }
  if pos >= lim {
    return
  }
  self.total = self.total + (lim - pos).to_int64()

  if self.fill > 0 {
    while pos < lim && self.fill < 64 {
      self.buf[self.fill] = data[pos].to_int()
      self.fill = self.fill + 1
      pos = pos + 1
    }
    if self.fill == 64 {
      sha1_load_block_arr(self.buf, self.w)
      sha1_compress_w(self.state, self.w)
      self.fill = 0
    }
  }

  while pos + 64 <= lim {
    sha1_load_block_bytes(data, pos, self.w)
    sha1_compress_w(self.state, self.w)
    pos = pos + 64
  }

  while pos < lim {
    self.buf[self.fill] = data[pos].to_int()
    self.fill = self.fill + 1
    pos = pos + 1
  }
}

///|
pub fn Sha1::update(self : Sha1, data : Bytes) -> Unit {
  self.update_slice(data, 0, data.length())
}

///|
pub fn Sha1::finalize(self : Sha1) -> Bytes {
  let st : FixedArray[UInt] = [
    self.state[0], self.state[1], self.state[2], self.state[3], self.state[4],
  ]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)
  let rem = self.fill
  let mut j = 0
  while j < rem {
    let shift : UInt = (24 - ((j & 3) << 3)).to_uint()
    w[j >> 2] = w[j >> 2] | (self.buf[j].to_uint() << shift)
    j = j + 1
  }
  let pad_shift : UInt = (24 - ((rem & 3) << 3)).to_uint()
  w[rem >> 2] = w[rem >> 2] | (0x80U << pad_shift)

  let bit_len : UInt64 = self.total.to_uint64() << 3
  if rem >= 56 {
    sha1_compress_w(st, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0U
      k = k + 1
    }
  }
  w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
  sha1_compress_w(st, w)
  sha1_state_to_bytes(st)
}

///|
pub fn Sha1::finalize_hex(self : Sha1) -> String {
  bytes_to_hex(self.finalize())
}

///|
pub fn sha1(data : Bytes) -> Bytes {
  let state : FixedArray[UInt] = [
    0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U,
  ]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)
  let len = data.length()
  let mut off = 0
  while off + 64 <= len {
    sha1_load_block_bytes(data, off, w)
    sha1_compress_w(state, w)
    off = off + 64
  }
  let rem = len - off
  let mut i = 0
  while i < 16 {
    w[i] = 0U
    i = i + 1
  }
  let mut j = 0
  while j < rem {
    let shift : UInt = (24 - ((j & 3) << 3)).to_uint()
    w[j >> 2] = w[j >> 2] | (data[off + j].to_int().to_uint() << shift)
    j = j + 1
  }
  let pad_shift : UInt = (24 - ((rem & 3) << 3)).to_uint()
  w[rem >> 2] = w[rem >> 2] | (0x80U << pad_shift)

  let bit_len : UInt64 = len.to_int64().to_uint64() << 3
  if rem >= 56 {
    sha1_compress_w(state, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0U
      k = k + 1
    }
  }
  w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
  sha1_compress_w(state, w)
  sha1_state_to_bytes(state)
}

///|
pub fn sha1_hex(data : Bytes) -> String {
  bytes_to_hex(sha1(data))
}
