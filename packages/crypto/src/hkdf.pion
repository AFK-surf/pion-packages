///| RFC 5869 HKDF-SHA256 and HKDF-SHA512 (pure Pion, zero World dependencies).
///| Reuses streaming `HmacSha256` / `HmacSha512` with `reset()` to avoid re-hashing PRK pads.

///| RFC 5869 §2.2 HKDF-Extract with SHA-256. Empty `salt` defaults to 32 zero bytes.
pub fn hkdf_sha256_extract(salt : Bytes, ikm : Bytes) -> Bytes {
  let actual_salt = if salt.length() == 0 { Bytes::new(32) } else { salt }
  hmac_sha256(actual_salt, ikm)
}

///| RFC 5869 §2.3 HKDF-SHA256 output length validity (`0 <= len <= 255 * 32`).
pub fn hkdf_sha256_valid_len(len : Int) -> Bool {
  len >= 0 && len <= 255 * 32
}

///| RFC 5869 §2.3 HKDF-SHA256 block count `ceil(len / 32)`.
#verify
pub fn hkdf_sha256_blocks(len : Int) -> Int {
  (len + 31) / 32
}

///| RFC 5869 §2.3 HKDF-SHA512 output length validity (`0 <= len <= 255 * 64`).
pub fn hkdf_sha512_valid_len(len : Int) -> Bool {
  len >= 0 && len <= 255 * 64
}

///| RFC 5869 §2.3 HKDF-SHA512 block count `ceil(len / 64)`.
pub fn hkdf_sha512_blocks(len : Int) -> Int {
  (len + 63) / 64
}

///| RFC 5869 §2.3 HKDF-Expand with SHA-256.
///| Rejects `prk.length() < 32`, `len < 0`, or `len > 255 * 32`.
pub fn hkdf_sha256_expand(prk : Bytes, info : Bytes, len : Int) -> Result[Bytes, CryptoError] {
  if prk.length() < 32 {
    return Err(CryptoError::InvalidKeyLength(prk.length()))
  }
  if !hkdf_sha256_valid_len(len) {
    return Err(CryptoError::InvalidLength(len))
  }
  if len == 0 {
    return Ok(Bytes::new(0))
  }
  let n_blocks = hkdf_sha256_blocks(len)
  let mut okm = Bytes::new(len)
  let mac = HmacSha256::new(prk)
  let mut prev = Bytes::new(0)
  let mut ctr_buf = Bytes::new(1)
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    mac.reset()
    if prev.length() > 0 {
      mac.update(prev)
    }
    if info.length() > 0 {
      mac.update(info)
    }
    ctr_buf[0] = block.to_byte()
    mac.update(ctr_buf)
    let t = mac.finalize()
    let rem = len - out_off
    let take = if rem < 32 { rem } else { 32 }
    let mut i = 0
    while i < take {
      okm[out_off + i] = t[i]
      i = i + 1
    }
    out_off = out_off + take
    prev = t
    block = block + 1
  }
  Ok(okm)
}

///| One-shot RFC 5869 HKDF-SHA256 (Extract + Expand).
pub fn hkdf_sha256(
  salt : Bytes,
  ikm : Bytes,
  info : Bytes,
  len : Int,
) -> Result[Bytes, CryptoError] {
  let prk = hkdf_sha256_extract(salt, ikm)
  hkdf_sha256_expand(prk, info, len)
}

///| RFC 5869 §2.2 HKDF-Extract with SHA-512. Empty `salt` defaults to 64 zero bytes.
pub fn hkdf_sha512_extract(salt : Bytes, ikm : Bytes) -> Bytes {
  let actual_salt = if salt.length() == 0 { Bytes::new(64) } else { salt }
  hmac_sha512(actual_salt, ikm)
}

///| RFC 5869 §2.3 HKDF-Expand with SHA-512.
///| Rejects `prk.length() < 64`, `len < 0`, or `len > 255 * 64`.
pub fn hkdf_sha512_expand(prk : Bytes, info : Bytes, len : Int) -> Result[Bytes, CryptoError] {
  if prk.length() < 64 {
    return Err(CryptoError::InvalidKeyLength(prk.length()))
  }
  if !hkdf_sha512_valid_len(len) {
    return Err(CryptoError::InvalidLength(len))
  }
  if len == 0 {
    return Ok(Bytes::new(0))
  }
  let n_blocks = hkdf_sha512_blocks(len)
  let mut okm = Bytes::new(len)
  let mac = HmacSha512::new(prk)
  let mut prev = Bytes::new(0)
  let mut ctr_buf = Bytes::new(1)
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    mac.reset()
    if prev.length() > 0 {
      mac.update(prev)
    }
    if info.length() > 0 {
      mac.update(info)
    }
    ctr_buf[0] = block.to_byte()
    mac.update(ctr_buf)
    let t = mac.finalize()
    let rem = len - out_off
    let take = if rem < 64 { rem } else { 64 }
    let mut i = 0
    while i < take {
      okm[out_off + i] = t[i]
      i = i + 1
    }
    out_off = out_off + take
    prev = t
    block = block + 1
  }
  Ok(okm)
}

///| One-shot RFC 5869 HKDF-SHA512 (Extract + Expand).
pub fn hkdf_sha512(
  salt : Bytes,
  ikm : Bytes,
  info : Bytes,
  len : Int,
) -> Result[Bytes, CryptoError] {
  let prk = hkdf_sha512_extract(salt, ikm)
  hkdf_sha512_expand(prk, info, len)
}
