}

///|
fn ge_identity() -> GeP3 {
  GeP3::{ x: fe_zero(), y: fe_one(), z: fe_one(), t: fe_zero() }
}

///| Branch-free 10-limb field element addition in GF(2^255 - 19).
#verify
pub fn fe_add(a : Fe, b : Fe) -> Fe {
  Fe::{
    h0: a.h0 + b.h0,
    h1: a.h1 + b.h1,
    h2: a.h2 + b.h2,
    h3: a.h3 + b.h3,
    h4: a.h4 + b.h4,
    h5: a.h5 + b.h5,
    h6: a.h6 + b.h6,
    h7: a.h7 + b.h7,
    h8: a.h8 + b.h8,
    h9: a.h9 + b.h9,
  }
}

///| Branch-free 10-limb field element subtraction in GF(2^255 - 19).
#verify
pub fn fe_sub(a : Fe, b : Fe) -> Fe {
  Fe::{
    h0: a.h0 - b.h0,
    h1: a.h1 - b.h1,
    h2: a.h2 - b.h2,
    h3: a.h3 - b.h3,
    h4: a.h4 - b.h4,
    h5: a.h5 - b.h5,
    h6: a.h6 - b.h6,
    h7: a.h7 - b.h7,
    h8: a.h8 - b.h8,
    h9: a.h9 - b.h9,
  }
}

///|
fn fe_neg(a : Fe) -> Fe {
  Fe::{
    h0: 0L - a.h0,
    h1: 0L - a.h1,
    h2: 0L - a.h2,
    h3: 0L - a.h3,
    h4: 0L - a.h4,
    h5: 0L - a.h5,
    h6: 0L - a.h6,
    h7: 0L - a.h7,
    h8: 0L - a.h8,
    h9: 0L - a.h9,
  }
}

///|
#verify
pub fn fe_cmov(a : Fe, b : Fe, flag : Int64) -> Fe {
  let mask = 0L - flag
  Fe::{
    h0: a.h0 ^ (mask & (a.h0 ^ b.h0)),
    h1: a.h1 ^ (mask & (a.h1 ^ b.h1)),
    h2: a.h2 ^ (mask & (a.h2 ^ b.h2)),
    h3: a.h3 ^ (mask & (a.h3 ^ b.h3)),
    h4: a.h4 ^ (mask & (a.h4 ^ b.h4)),
    h5: a.h5 ^ (mask & (a.h5 ^ b.h5)),
    h6: a.h6 ^ (mask & (a.h6 ^ b.h6)),
    h7: a.h7 ^ (mask & (a.h7 ^ b.h7)),
    h8: a.h8 ^ (mask & (a.h8 ^ b.h8)),
    h9: a.h9 ^ (mask & (a.h9 ^ b.h9)),
  }
}

///|
fn ge_cmov(a : GeP3, b : GeP3, flag : Int64) -> GeP3 {
  GeP3::{
    x: fe_cmov(a.x, b.x, flag),
    y: fe_cmov(a.y, b.y, flag),
    z: fe_cmov(a.z, b.z, flag),
    t: fe_cmov(a.t, b.t, flag),
  }
}

///|
fn ge_neg(p : GeP3) -> GeP3 {
  GeP3::{ x: fe_neg(p.x), y: p.y, z: p.z, t: fe_neg(p.t) }
}

///| Constant-time Ref10 10-limb multiplication modulo `2^255 - 19`.
#verify
pub fn fe_mul(f : Fe, g : Fe) -> Fe {
  let f0 = f.h0
  let f1 = f.h1
  let f2 = f.h2
  let f3 = f.h3
  let f4 = f.h4
  let f5 = f.h5
  let f6 = f.h6
  let f7 = f.h7
  let f8 = f.h8
  let f9 = f.h9

  let g0 = g.h0
  let g1 = g.h1
  let g2 = g.h2
  let g3 = g.h3
  let g4 = g.h4
  let g5 = g.h5
  let g6 = g.h6
  let g7 = g.h7
  let g8 = g.h8
  let g9 = g.h9

  let g1_19 = 19L * g1
  let g2_19 = 19L * g2
  let g3_19 = 19L * g3
  let g4_19 = 19L * g4
  let g5_19 = 19L * g5
  let g6_19 = 19L * g6
  let g7_19 = 19L * g7
  let g8_19 = 19L * g8
  let g9_19 = 19L * g9

  let f1_2 = 2L * f1
  let f3_2 = 2L * f3
  let f5_2 = 2L * f5
  let f7_2 = 2L * f7
  let f9_2 = 2L * f9

  let mut h0 = f0 * g0 + f1_2 * g9_19 + f2 * g8_19 + f3_2 * g7_19 + f4 * g6_19 + f5_2 * g5_19 + f6 * g4_19 + f7_2 * g3_19 + f8 * g2_19 + f9_2 * g1_19
  let mut h1 = f0 * g1 + f1 * g0 + f2 * g9_19 + f3 * g8_19 + f4 * g7_19 + f5 * g6_19 + f6 * g5_19 + f7 * g4_19 + f8 * g3_19 + f9 * g2_19
  let mut h2 = f0 * g2 + f1_2 * g1 + f2 * g0 + f3_2 * g9_19 + f4 * g8_19 + f5_2 * g7_19 + f6 * g6_19 + f7_2 * g5_19 + f8 * g4_19 + f9_2 * g3_19
  let mut h3 = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9_19 + f5 * g8_19 + f6 * g7_19 + f7 * g6_19 + f8 * g5_19 + f9 * g4_19
  let mut h4 = f0 * g4 + f1_2 * g3 + f2 * g2 + f3_2 * g1 + f4 * g0 + f5_2 * g9_19 + f6 * g8_19 + f7_2 * g7_19 + f8 * g6_19 + f9_2 * g5_19
  let mut h5 = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9_19 + f7 * g8_19 + f8 * g7_19 + f9 * g6_19
  let mut h6 = f0 * g6 + f1_2 * g5 + f2 * g4 + f3_2 * g3 + f4 * g2 + f5_2 * g1 + f6 * g0 + f7_2 * g9_19 + f8 * g8_19 + f9_2 * g7_19
  let mut h7 = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9_19 + f9 * g8_19
  let mut h8 = f0 * g8 + f1_2 * g7 + f2 * g6 + f3_2 * g5 + f4 * g4 + f5_2 * g3 + f6 * g2 + f7_2 * g1 + f8 * g0 + f9_2 * g9_19
  let mut h9 = f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0

  let c0 = (h0 + 33554432L) >> 26
  h1 = h1 + c0
  h0 = h0 - (c0 << 26)
  let c4 = (h4 + 33554432L) >> 26
  h5 = h5 + c4
  h4 = h4 - (c4 << 26)

  let c1 = (h1 + 16777216L) >> 25
  h2 = h2 + c1
  h1 = h1 - (c1 << 25)
  let c5 = (h5 + 16777216L) >> 25
  h6 = h6 + c5
  h5 = h5 - (c5 << 25)

  let c2 = (h2 + 33554432L) >> 26
  h3 = h3 + c2
  h2 = h2 - (c2 << 26)
  let c6 = (h6 + 33554432L) >> 26
  h7 = h7 + c6
  h6 = h6 - (c6 << 26)

  let c3 = (h3 + 16777216L) >> 25
  h4 = h4 + c3
  h3 = h3 - (c3 << 25)
  let c7 = (h7 + 16777216L) >> 25
  h8 = h8 + c7
  h7 = h7 - (c7 << 25)

  let c4b = (h4 + 33554432L) >> 26
  h5 = h5 + c4b
  h4 = h4 - (c4b << 26)
  let c8 = (h8 + 33554432L) >> 26
  h9 = h9 + c8
  h8 = h8 - (c8 << 26)

  let c9 = (h9 + 16777216L) >> 25
  h0 = h0 + c9 * 19L
  h9 = h9 - (c9 << 25)

  let c0b = (h0 + 33554432L) >> 26
  h1 = h1 + c0b
  h0 = h0 - (c0b << 26)

  Fe::{ h0: h0, h1: h1, h2: h2, h3: h3, h4: h4, h5: h5, h6: h6, h7: h7, h8: h8, h9: h9 }
}

///| Constant-time Ref10 10-limb squaring modulo `2^255 - 19`.
#verify
pub fn fe_sq(f : Fe) -> Fe {
  let f0 = f.h0
  let f1 = f.h1
  let f2 = f.h2
  let f3 = f.h3
  let f4 = f.h4
  let f5 = f.h5
  let f6 = f.h6
  let f7 = f.h7
  let f8 = f.h8
  let f9 = f.h9

  let f0_2 = 2L * f0
  let f1_2 = 2L * f1
  let f2_2 = 2L * f2
  let f3_2 = 2L * f3
  let f4_2 = 2L * f4
  let f5_2 = 2L * f5
  let f6_2 = 2L * f6
  let f7_2 = 2L * f7

  let f5_38 = 38L * f5
  let f6_19 = 19L * f6
  let f7_38 = 38L * f7
  let f8_19 = 19L * f8
  let f9_38 = 38L * f9

  let mut h0 = f0 * f0 + f1_2 * f9_38 + f2_2 * f8_19 + f3_2 * f7_38 + f4_2 * f6_19 + f5 * f5_38
  let mut h1 = f0_2 * f1 + f2 * f9_38 + f3_2 * f8_19 + f4 * f7_38 + f5_2 * f6_19
  let mut h2 = f0_2 * f2 + f1_2 * f1 + f3_2 * f9_38 + f4_2 * f8_19 + f5_2 * f7_38 + f6 * f6_19
  let mut h3 = f0_2 * f3 + f1_2 * f2 + f4 * f9_38 + f5_2 * f8_19 + f6 * f7_38
  let mut h4 = f0_2 * f4 + f1_2 * f3_2 + f2 * f2 + f5_2 * f9_38 + f6_2 * f8_19 + f7 * f7_38
  let mut h5 = f0_2 * f5 + f1_2 * f4 + f2_2 * f3 + f6 * f9_38 + f7_2 * f8_19
  let mut h6 = f0_2 * f6 + f1_2 * f5_2 + f2_2 * f4 + f3_2 * f3 + f7_2 * f9_38 + f8 * f8_19
  let mut h7 = f0_2 * f7 + f1_2 * f6 + f2_2 * f5 + f3_2 * f4 + f8 * f9_38
  let mut h8 = f0_2 * f8 + f1_2 * f7_2 + f2_2 * f6 + f3_2 * f5_2 + f4 * f4 + f9 * f9_38
  let mut h9 = f0_2 * f9 + f1_2 * f8 + f2_2 * f7 + f3_2 * f6 + f4_2 * f5

  let c0 = (h0 + 33554432L) >> 26
  h1 = h1 + c0
  h0 = h0 - (c0 << 26)
  let c4 = (h4 + 33554432L) >> 26
  h5 = h5 + c4
  h4 = h4 - (c4 << 26)

  let c1 = (h1 + 16777216L) >> 25
  h2 = h2 + c1
  h1 = h1 - (c1 << 25)
  let c5 = (h5 + 16777216L) >> 25
  h6 = h6 + c5
  h5 = h5 - (c5 << 25)

  let c2 = (h2 + 33554432L) >> 26
  h3 = h3 + c2
  h2 = h2 - (c2 << 26)
  let c6 = (h6 + 33554432L) >> 26
  h7 = h7 + c6
  h6 = h6 - (c6 << 26)

  let c3 = (h3 + 16777216L) >> 25
  h4 = h4 + c3
  h3 = h3 - (c3 << 25)
  let c7 = (h7 + 16777216L) >> 25
  h8 = h8 + c7
  h7 = h7 - (c7 << 25)

  let c4b = (h4 + 33554432L) >> 26
  h5 = h5 + c4b
  h4 = h4 - (c4b << 26)
  let c8 = (h8 + 33554432L) >> 26
  h9 = h9 + c8
  h8 = h8 - (c8 << 26)

  let c9 = (h9 + 16777216L) >> 25
  h0 = h0 + c9 * 19L
  h9 = h9 - (c9 << 25)

  let c0b = (h0 + 33554432L) >> 26
  h1 = h1 + c0b
  h0 = h0 - (c0b << 26)

  Fe::{ h0: h0, h1: h1, h2: h2, h3: h3, h4: h4, h5: h5, h6: h6, h7: h7, h8: h8, h9: h9 }
}

///|
fn fe_sq_n(f : Fe, n : Int) -> Fe {
  let mut r = f
  let mut i = 0
  while i < n {
    r = fe_sq(r)
    i = i + 1
  }
  r
}

///|
fn fe_invert(z : Fe) -> Fe {
  let t0 = fe_sq(z)
  let t1 = fe_sq(fe_sq(t0))
  let t1b = fe_mul(z, t1)
  let t0b = fe_mul(t0, t1b)
  let t2 = fe_sq(t0b)
  let t1c = fe_mul(t1b, t2)
  let t2b = fe_sq_n(t1c, 5)
  let t1d = fe_mul(t2b, t1c)
  let t2c = fe_sq_n(t1d, 10)
  let t2d = fe_mul(t2c, t1d)
  let t3 = fe_sq_n(t2d, 20)
  let t2e = fe_mul(t3, t2d)
  let t2f = fe_sq_n(t2e, 10)
  let t1e = fe_mul(t2f, t1d)
  let t2g = fe_sq_n(t1e, 50)
  let t2h = fe_mul(t2g, t1e)
  let t3b = fe_sq_n(t2h, 100)
  let t2i = fe_mul(t3b, t2h)
  let t2j = fe_sq_n(t2i, 50)
  let t1f = fe_mul(t2j, t1e)
  let t1g = fe_sq_n(t1f, 5)
  fe_mul(t1g, t0b)
}

///|
fn fe_pow22523(z : Fe) -> Fe {
  let t0 = fe_sq(z)
  let t1 = fe_sq(fe_sq(t0))
  let t1b = fe_mul(z, t1)
  let t0b = fe_mul(t0, t1b)
  let t0c = fe_sq(t0b)
  let t0d = fe_mul(t1b, t0c)
  let t1c = fe_sq_n(t0d, 5)
  let t0e = fe_mul(t1c, t0d)
  let t1d = fe_sq_n(t0e, 10)
  let t1e = fe_mul(t1d, t0e)
  let t2 = fe_sq_n(t1e, 20)
  let t1f = fe_mul(t2, t1e)
  let t1g = fe_sq_n(t1f, 10)
  let t0f = fe_mul(t1g, t0e)
  let t1h = fe_sq_n(t0f, 50)
  let t1i = fe_mul(t1h, t0f)
  let t2b = fe_sq_n(t1i, 100)
  let t1j = fe_mul(t2b, t1i)
  let t1k = fe_sq_n(t1j, 50)
  let t0g = fe_mul(t1k, t0f)
  let t0h = fe_sq_n(t0g, 2)
  fe_mul(t0h, z)
}

///|
fn load4_le(s : Bytes, off : Int) -> Int64 {
  s[off].to_int().to_int64() |
  (s[off + 1].to_int().to_int64() << 8) |
  (s[off + 2].to_int().to_int64() << 16) |
  (s[off + 3].to_int().to_int64() << 24)
}

///|
fn load3_le(s : Bytes, off : Int) -> Int64 {
  s[off].to_int().to_int64() |
  (s[off + 1].to_int().to_int64() << 8) |
  (s[off + 2].to_int().to_int64() << 16)
}

///|
fn fe_frombytes(s : Bytes, off : Int) -> Fe {
  let mut h0 = load4_le(s, off)
  let mut h1 = load3_le(s, off + 4) << 6
  let mut h2 = load3_le(s, off + 7) << 5
  let mut h3 = load3_le(s, off + 10) << 3
  let mut h4 = load3_le(s, off + 13) << 2
  let mut h5 = load4_le(s, off + 16)
  let mut h6 = load3_le(s, off + 20) << 7
  let mut h7 = load3_le(s, off + 23) << 5
  let mut h8 = load3_le(s, off + 26) << 4
  let mut h9 = (load3_le(s, off + 29) & 0x7FFFFFL) << 2

  let c9 = (h9 + 16777216L) >> 25
  h0 = h0 + c9 * 19L
  h9 = h9 - (c9 << 25)
  let c1 = (h1 + 16777216L) >> 25
  h2 = h2 + c1
  h1 = h1 - (c1 << 25)
  let c3 = (h3 + 16777216L) >> 25
  h4 = h4 + c3
  h3 = h3 - (c3 << 25)
  let c5 = (h5 + 16777216L) >> 25
  h6 = h6 + c5
  h5 = h5 - (c5 << 25)
  let c7 = (h7 + 16777216L) >> 25
  h8 = h8 + c7
  h7 = h7 - (c7 << 25)

  let c0 = (h0 + 33554432L) >> 26
  h1 = h1 + c0
  h0 = h0 - (c0 << 26)
  let c2 = (h2 + 33554432L) >> 26
  h3 = h3 + c2
  h2 = h2 - (c2 << 26)
  let c4 = (h4 + 33554432L) >> 26
  h5 = h5 + c4
  h4 = h4 - (c4 << 26)
  let c6 = (h6 + 33554432L) >> 26
  h7 = h7 + c6
  h6 = h6 - (c6 << 26)
  let c8 = (h8 + 33554432L) >> 26
  h9 = h9 + c8
  h8 = h8 - (c8 << 26)

  Fe::{ h0: h0, h1: h1, h2: h2, h3: h3, h4: h4, h5: h5, h6: h6, h7: h7, h8: h8, h9: h9 }
}

///|
fn fe_tobytes(f : Fe) -> Bytes {
  let mut h0 = f.h0
  let mut h1 = f.h1
  let mut h2 = f.h2
  let mut h3 = f.h3
  let mut h4 = f.h4
  let mut h5 = f.h5
  let mut h6 = f.h6
  let mut h7 = f.h7
  let mut h8 = f.h8
  let mut h9 = f.h9

  let mut q = (19L * h9 + 16777216L) >> 25
  q = (h0 + q) >> 26
  q = (h1 + q) >> 25
  q = (h2 + q) >> 26
  q = (h3 + q) >> 25
  q = (h4 + q) >> 26
  q = (h5 + q) >> 25
  q = (h6 + q) >> 26
  q = (h7 + q) >> 25
  q = (h8 + q) >> 26
  q = (h9 + q) >> 25

  h0 = h0 + 19L * q

  let c0 = h0 >> 26
  h1 = h1 + c0
  h0 = h0 - (c0 << 26)
  let c1 = h1 >> 25
  h2 = h2 + c1
  h1 = h1 - (c1 << 25)
  let c2 = h2 >> 26
  h3 = h3 + c2
  h2 = h2 - (c2 << 26)
  let c3 = h3 >> 25
  h4 = h4 + c3
  h3 = h3 - (c3 << 25)
  let c4 = h4 >> 26
  h5 = h5 + c4
  h4 = h4 - (c4 << 26)
  let c5 = h5 >> 25
  h6 = h6 + c5
  h5 = h5 - (c5 << 25)
  let c6 = h6 >> 26
  h7 = h7 + c6
  h6 = h6 - (c6 << 26)
  let c7 = h7 >> 25
  h8 = h8 + c7
  h7 = h7 - (c7 << 25)
  let c8 = h8 >> 26
  h9 = h9 + c8
  h8 = h8 - (c8 << 26)
  let c9 = h9 >> 25
  h9 = h9 - (c9 << 25)

  let mut s = Bytes::new(32)
  s[0] = (h0 & 0xFFL).to_int().to_byte()
  s[1] = ((h0 >> 8) & 0xFFL).to_int().to_byte()
  s[2] = ((h0 >> 16) & 0xFFL).to_int().to_byte()
  s[3] = (((h0 >> 24) | (h1 << 2)) & 0xFFL).to_int().to_byte()
  s[4] = ((h1 >> 6) & 0xFFL).to_int().to_byte()
  s[5] = ((h1 >> 14) & 0xFFL).to_int().to_byte()
  s[6] = (((h1 >> 22) | (h2 << 3)) & 0xFFL).to_int().to_byte()
  s[7] = ((h2 >> 5) & 0xFFL).to_int().to_byte()
  s[8] = ((h2 >> 13) & 0xFFL).to_int().to_byte()
  s[9] = (((h2 >> 21) | (h3 << 5)) & 0xFFL).to_int().to_byte()
  s[10] = ((h3 >> 3) & 0xFFL).to_int().to_byte()
  s[11] = ((h3 >> 11) & 0xFFL).to_int().to_byte()
  s[12] = (((h3 >> 19) | (h4 << 6)) & 0xFFL).to_int().to_byte()
  s[13] = ((h4 >> 2) & 0xFFL).to_int().to_byte()
  s[14] = ((h4 >> 10) & 0xFFL).to_int().to_byte()
  s[15] = ((h4 >> 18) & 0xFFL).to_int().to_byte()
  s[16] = (h5 & 0xFFL).to_int().to_byte()
  s[17] = ((h5 >> 8) & 0xFFL).to_int().to_byte()
  s[18] = ((h5 >> 16) & 0xFFL).to_int().to_byte()
  s[19] = (((h5 >> 24) | (h6 << 1)) & 0xFFL).to_int().to_byte()
  s[20] = ((h6 >> 7) & 0xFFL).to_int().to_byte()
  s[21] = ((h6 >> 15) & 0xFFL).to_int().to_byte()
  s[22] = (((h6 >> 23) | (h7 << 3)) & 0xFFL).to_int().to_byte()
  s[23] = ((h7 >> 5) & 0xFFL).to_int().to_byte()
  s[24] = ((h7 >> 13) & 0xFFL).to_int().to_byte()
  s[25] = (((h7 >> 21) | (h8 << 4)) & 0xFFL).to_int().to_byte()
  s[26] = ((h8 >> 4) & 0xFFL).to_int().to_byte()
  s[27] = ((h8 >> 12) & 0xFFL).to_int().to_byte()
  s[28] = (((h8 >> 20) | (h9 << 6)) & 0xFFL).to_int().to_byte()
  s[29] = ((h9 >> 2) & 0xFFL).to_int().to_byte()
  s[30] = ((h9 >> 10) & 0xFFL).to_int().to_byte()
  s[31] = ((h9 >> 18) & 0xFFL).to_int().to_byte()
  s
}

///|
fn fe_is_zero(f : Fe) -> Bool {
  let b = fe_tobytes(f)
  let mut acc = 0
  let mut i = 0
  while i < 32 {
    acc = acc | b[i].to_int()
    i = i + 1
  }
  acc == 0
}

///|
fn fe_is_negative(f : Fe) -> Int {
  let b = fe_tobytes(f)
  b[0].to_int() & 1
}

///|
fn ge_dbl(p : GeP3) -> GeP3 {
  let a = fe_sq(p.x)
  let b = fe_sq(p.y)
  let z2 = fe_sq(p.z)
  let c = fe_add(z2, z2)
  let xy = fe_add(p.x, p.y)
  let e = fe_sub(fe_sub(fe_sq(xy), a), b)
  let g = fe_sub(b, a)
  let f = fe_sub(g, c)
  let h = fe_neg(fe_add(a, b))
  GeP3::{
    x: fe_mul(e, f),
    y: fe_mul(g, h),
    z: fe_mul(f, g),
    t: fe_mul(e, h),
  }
}

///|
fn ge_add(p : GeP3, q : GeP3) -> GeP3 {
  let a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x))
  let b = fe_mul(fe_add(p.y, p.x), fe_add(q.y, q.x))
  let c = fe_mul(fe_mul(p.t, fe_d2()), q.t)
  let z1z2 = fe_mul(p.z, q.z)
  let d = fe_add(z1z2, z1z2)
  let e = fe_sub(b, a)
  let f = fe_sub(d, c)
  let g = fe_add(d, c)
  let h = fe_add(b, a)
  GeP3::{
    x: fe_mul(e, f),
    y: fe_mul(g, h),
    z: fe_mul(f, g),
    t: fe_mul(e, h),
  }
}

///|
fn ge_tobytes(p : GeP3) -> Bytes {
  let recip = fe_invert(p.z)
  let x = fe_mul(p.x, recip)
  let y = fe_mul(p.y, recip)
  let mut s = fe_tobytes(y)
  s[31] = (s[31].to_int() ^ (fe_is_negative(x) << 7)).to_byte()
  s
}

///| Branch-free equality of two 4-bit values: 1L if `a == b`, else 0L.
///| `a ^ b` is in [0, 15], so `(a ^ b) - 1` is negative exactly when they are equal; the
///| sign bit is extracted arithmetically so no secret-dependent `jnz` is emitted
///| (an `if a == b { 1L } else { 0L }` lowers to a conditional jump on the secret nibble).
#verify
pub fn ct_eq_nibble(a : Int, b : Int) -> Int64 {
  (((a ^ b) - 1) >> 31).to_int64() & 1L
}

///| Lazily-initialized 4-table fixed-base comb for `[k]B` (`B, 2^64 B, 2^128 B, 2^192 B`).
struct Ed25519BaseTables {
  mut ready : Bool
  t0 : FixedArray[GeP3]
  t1 : FixedArray[GeP3]
  t2 : FixedArray[GeP3]
  t3 : FixedArray[GeP3]
}

///|
let ed25519_base_tables : Ed25519BaseTables = Ed25519BaseTables::{
  ready: false,
  t0: FixedArray::make(16, ge_identity()),
  t1: FixedArray::make(16, ge_identity()),
  t2: FixedArray::make(16, ge_identity()),
  t3: FixedArray::make(16, ge_identity()),
}

///|
fn ed25519_fill_table(tbl : FixedArray[GeP3], base : GeP3) -> Unit {
  tbl[0] = ge_identity()
  tbl[1] = base
  let mut cur = base
  let mut i = 2
  while i < 16 {
    cur = ge_add(cur, base)
    tbl[i] = cur
    i = i + 1
  }
}

///|
fn ed25519_ensure_base_tables() -> Ed25519BaseTables {
  let bt = ed25519_base_tables
  if !bt.ready {
    let b0 = ge_base()
    ed25519_fill_table(bt.t0, b0)
    let mut cur = b0
    let mut i = 0
    while i < 64 {
      cur = ge_dbl(cur)
      i = i + 1
    }
    ed25519_fill_table(bt.t1, cur)
    i = 0
    while i < 64 {
      cur = ge_dbl(cur)
      i = i + 1
    }
    ed25519_fill_table(bt.t2, cur)
    i = 0
    while i < 64 {
      cur = ge_dbl(cur)
      i = i + 1
    }
    ed25519_fill_table(bt.t3, cur)
    bt.ready = true
  }
  bt
}

///|
fn ge_select16(tbl : FixedArray[GeP3], nib : Int) -> GeP3 {
  let mut picked = tbl[0]
  let mut j = 1
  while j < 16 {
    picked = ge_cmov(picked, tbl[j], ct_eq_nibble(nib, j))
    j = j + 1
  }
  picked
}

///| Constant-time 4-table fixed-base comb scalar multiplication by base point B.
fn ge_scalarmult_base(scalar : FixedArray[Int]) -> GeP3 {
  let bt = ed25519_ensure_base_tables()
  let mut acc = ge_identity()
  let mut i = 7
  while i >= 0 {
    let v3 = scalar[24 + i]
    let v2 = scalar[16 + i]
    let v1 = scalar[8 + i]
    let v0 = scalar[i]

    // High nibbles
    acc = ge_dbl(ge_dbl(ge_dbl(ge_dbl(acc))))
    acc = ge_add(acc, ge_select16(bt.t3, (v3 >> 4) & 0xF))
    acc = ge_add(acc, ge_select16(bt.t2, (v2 >> 4) & 0xF))
    acc = ge_add(acc, ge_select16(bt.t1, (v1 >> 4) & 0xF))
    acc = ge_add(acc, ge_select16(bt.t0, (v0 >> 4) & 0xF))

    // Low nibbles
    acc = ge_dbl(ge_dbl(ge_dbl(ge_dbl(acc))))
    acc = ge_add(acc, ge_select16(bt.t3, v3 & 0xF))
    acc = ge_add(acc, ge_select16(bt.t2, v2 & 0xF))
    acc = ge_add(acc, ge_select16(bt.t1, v1 & 0xF))
    acc = ge_add(acc, ge_select16(bt.t0, v0 & 0xF))

    i = i - 1
  }
  acc
}

///| Variable-time Shamir's trick double-scalar multiplication: [s]B + [k]Q.
fn ge_double_scalarmult_vartime(
  q : GeP3,
  k : FixedArray[Int],
  s : FixedArray[Int],
) -> GeP3 {
  let b = ge_base()
  let qb = ge_add(q, b)
  let mut acc = ge_identity()
  let mut i = 255
  while i >= 0 {
    acc = ge_dbl(acc)
    let kb = (k[i >> 3] >> (i & 7)) & 1
    let sb = (s[i >> 3] >> (i & 7)) & 1
    if kb == 1 && sb == 1 {
      acc = ge_add(acc, qb)
    } else if kb == 1 {
      acc = ge_add(acc, q)
    } else if sb == 1 {
      acc = ge_add(acc, b)
    }
    i = i - 1
  }
  acc
}

///| Check if 32-byte little-endian y (with bit 255 cleared) is strictly < p = 2^255 - 19.
fn is_canonical_y(s : Bytes, off : Int) -> Bool {
  if (s[off + 31].to_int() & 0x7F) != 0x7F {
    return true
  }
  let mut i = 1
  while i < 31 {
    if s[off + i].to_int() != 0xFF {
      return true
    }
    i = i + 1
  }
  s[off].to_int() < 0xED
}

///| Check if point P is a small-order torsion point ([8]P == identity).
fn ge_is_small_order(p : GeP3) -> Bool {
  let p8 = ge_dbl(ge_dbl(ge_dbl(p)))
  fe_is_zero(p8.x) && fe_is_zero(fe_sub(p8.y, p8.z))
}

///| Strictly decode a 32-byte compressed Edwards25519 point.
///| Rejects y >= p, off-curve points, x == 0 with sign bit 1, and small-order points.
fn ge_frombytes_strict(s : Bytes, off : Int) -> Result[GeP3, CryptoError] {
  if !is_canonical_y(s, off) {
    return Err(CryptoError::NonCanonicalPoint)
  }
  let y = fe_frombytes(s, off)
  let z = fe_one()
  let y2 = fe_sq(y)
  let u = fe_sub(y2, z) // y^2 - 1
  let v = fe_add(fe_mul(y2, fe_d()), z) // d*y^2 + 1

  let v3 = fe_mul(fe_sq(v), v)
  let v7 = fe_mul(fe_sq(v3), v)
  let mut x = fe_mul(fe_mul(u, v3), fe_pow22523(fe_mul(u, v7)))

  let vxx = fe_mul(fe_sq(x), v)
  let check = fe_sub(vxx, u)
  if !fe_is_zero(check) {
    let check2 = fe_add(vxx, u)
    if !fe_is_zero(check2) {
      return Err(CryptoError::InvalidPoint)
    }
    x = fe_mul(x, fe_sqrtm1())
  }

  let sign = (s[off + 31].to_int() >> 7) & 1
  if fe_is_zero(x) {
    if sign == 1 {
      return Err(CryptoError::NonCanonicalPoint)
    }
  } else if fe_is_negative(x) != sign {
    x = fe_neg(x)
  }

  let pt = GeP3::{ x: x, y: y, z: z, t: fe_mul(x, y) }
  if ge_is_small_order(pt) {
    return Err(CryptoError::SmallOrderPoint)
  }
  Ok(pt)
}

///| Group order L in little-endian bytes.
let ed25519_l : FixedArray[Int64] = [
  0xedL, 0xd3L, 0xf5L, 0x5cL, 0x1aL, 0x63L, 0x12L, 0x58L,
  0xd6L, 0x9cL, 0xf7L, 0xa2L, 0xdeL, 0xf9L, 0xdeL, 0x14L,
  0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L,
  0L, 0L, 0L, 0L, 0L, 0L, 0L, 0x10L,
]

///| Check if 32-byte little-endian scalar at s[off..off+32] is strictly < L.
fn sc_is_canonical(s : Bytes, off : Int) -> Bool {
  let l = ed25519_l
  let mut i = 31
  while i >= 0 {
    let b = s[off + i].to_int().to_int64()
    if b != l[i] {
      return b < l[i]
    }
    i = i - 1
  }
  false
}

///| Reduce 64-limb little-endian integer `x` modulo L into 32 bytes `r`.
fn sc_mod_l(r : FixedArray[Int], x : FixedArray[Int64]) -> Unit {
  let l = ed25519_l
  let mut i = 63
  while i >= 32 {
    let mut carry = 0L
    let mut j = i - 32
    while j < i - 12 {
      x[j] = x[j] + carry - 16L * x[i] * l[j - (i - 32)]
      carry = (x[j] + 128L) >> 8
      x[j] = x[j] - (carry << 8)
      j = j + 1
    }
    x[j] = x[j] + carry
    x[i] = 0L
    i = i - 1
  }
  let mut carry = 0L
  let mut j = 0
  while j < 32 {
    x[j] = x[j] + carry - (x[31] >> 4) * l[j]
    carry = x[j] >> 8
    x[j] = x[j] & 255L
    j = j + 1
  }
  let mut j2 = 0
  while j2 < 32 {
    x[j2] = x[j2] - carry * l[j2]
    j2 = j2 + 1
  }
  let mut k = 0
  while k < 32 {
    x[k + 1] = x[k + 1] + (x[k] >> 8)
    r[k] = (x[k] & 255L).to_int()
    k = k + 1
  }
}

///| Reduce 64-byte SHA-512 digest modulo L into 32-byte scalar.
fn sc_reduce_64(digest : Bytes) -> FixedArray[Int] {
  let x : FixedArray[Int64] = FixedArray::make(64, 0L)
  let mut i = 0
  while i < 64 {
    x[i] = digest[i].to_int().to_int64()
    i = i + 1
  }
  let r : FixedArray[Int] = FixedArray::make(32, 0)
  sc_mod_l(r, x)
  r
}

///|
pub struct Ed25519KeyPair {
  scalar : FixedArray[Int]
  prefix : Bytes
  pk : Bytes
}

///|
pub fn Ed25519KeyPair::from_seed(seed : Bytes) -> Result[Ed25519KeyPair, CryptoError] {
  if seed.length() != 32 {
    return Err(CryptoError::InvalidSeedLength(seed.length()))
  }
  let h = sha512(seed)
  let scalar : FixedArray[Int] = FixedArray::make(32, 0)
  let mut i = 0
  while i < 32 {
    scalar[i] = h[i].to_int()
    i = i + 1
  }
  scalar[0] = scalar[0] & 248
  scalar[31] = (scalar[31] & 127) | 64

  let mut prefix = Bytes::new(32)
  let mut j = 0
  while j < 32 {
    prefix[j] = h[32 + j]
    j = j + 1
  }

  let pk = ge_tobytes(ge_scalarmult_base(scalar))
  Ok(Ed25519KeyPair::{ scalar: scalar, prefix: prefix, pk: pk })
}

///|
pub fn Ed25519KeyPair::public_key(self : Ed25519KeyPair) -> Bytes {
  let mut out = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    out[i] = self.pk[i]
    i = i + 1
  }
  out
}

///|
pub fn Ed25519KeyPair::sign(self : Ed25519KeyPair, msg : Bytes) -> Bytes {
  // r = SHA-512(prefix || msg) mod L
  let hr = Sha512::new()
  hr.update(self.prefix)
  hr.update(msg)
  let r = sc_reduce_64(hr.finalize())

  // R = [r]B
  let r_bytes = ge_tobytes(ge_scalarmult_base(r))

  // k = SHA-512(R || pk || msg) mod L
  let hk = Sha512::new()
  hk.update(r_bytes)
  hk.update(self.pk)
  hk.update(msg)
  let k = sc_reduce_64(hk.finalize())

  // S = (r + k * a) mod L
  let x : FixedArray[Int64] = FixedArray::make(64, 0L)
  let mut i = 0
  while i < 32 {
    x[i] = r[i].to_int64()
    i = i + 1
  }
  let mut a_i = 0
  while a_i < 32 {
    let ki = k[a_i].to_int64()
    let mut b_j = 0
    while b_j < 32 {
      x[a_i + b_j] = x[a_i + b_j] + ki * self.scalar[b_j].to_int64()
      b_j = b_j + 1
    }
    a_i = a_i + 1
  }
  let s : FixedArray[Int] = FixedArray::make(32, 0)
  sc_mod_l(s, x)

  let mut sig = Bytes::new(64)
  let mut idx = 0
  while idx < 32 {
    sig[idx] = r_bytes[idx]
    sig[32 + idx] = s[idx].to_byte()
    idx = idx + 1
  }
  sig
}

///|
pub fn ed25519_public_key(seed : Bytes) -> Result[Bytes, CryptoError] {
  match Ed25519KeyPair::from_seed(seed) {
    Ok(kp) => Ok(kp.public_key())
    Err(e) => Err(e)
  }
}

///|
pub fn ed25519_sign(seed : Bytes, msg : Bytes) -> Result[Bytes, CryptoError] {
  match Ed25519KeyPair::from_seed(seed) {
    Ok(kp) => Ok(kp.sign(msg))
    Err(e) => Err(e)
  }
}

///|
pub fn ed25519_verify_strict(
  public_key : Bytes,
  msg : Bytes,
  signature : Bytes,
) -> Result[Unit, CryptoError] {
  if public_key.length() != 32 {
    return Err(CryptoError::InvalidPublicKeyLength(public_key.length()))
  }
  if signature.length() != 64 {
    return Err(CryptoError::InvalidSignatureLength(signature.length()))
  }
  if !sc_is_canonical(signature, 32) {
    return Err(CryptoError::NonCanonicalScalar)
  }

  let a_pt = match ge_frombytes_strict(public_key, 0) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  let r_pt = match ge_frombytes_strict(signature, 0) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }

  // k = SHA-512(R || A || msg) mod L
  let hk = Sha512::new()
  hk.update_slice(signature, 0, 32)
  hk.update(public_key)
  hk.update(msg)
  let k = sc_reduce_64(hk.finalize())

  let s : FixedArray[Int] = FixedArray::make(32, 0)
  let mut i = 0
  while i < 32 {
    s[i] = signature[32 + i].to_int()
    i = i + 1
  }

  // R' = [S]B + [k](-A); verify R' == R in projective coordinates (R.z == 1)
  let r_check = ge_double_scalarmult_vartime(ge_neg(a_pt), k, s)
  let lhs_x = fe_sub(r_check.x, fe_mul(r_pt.x, r_check.z))
  let lhs_y = fe_sub(r_check.y, fe_mul(r_pt.y, r_check.z))
  if fe_is_zero(lhs_x) && fe_is_zero(lhs_y) {
    Ok(())
  } else {
    Err(CryptoError::SignatureMismatch)
  }
}

///|
pub fn ed25519_verify(public_key : Bytes, msg : Bytes, signature : Bytes) -> Bool {
  match ed25519_verify_strict(public_key, msg, signature) {
    Ok(_) => true
    Err(_) => false
  }
}
