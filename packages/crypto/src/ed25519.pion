///| Strict RFC 8032 Ed25519 signing and verification (pure Pion, zero World dependencies).
///|
///| Field arithmetic over GF(2^255 - 19) uses Ref10 signed radix-2^25.5 (10 `Int64` limbs)
///| stored in stack-allocated `val struct Fe` for zero-allocation hot paths on both
///| Native and WebAssembly (`wasm32`).
///|
///| Security policy (strict non-malleability, matching `ed25519-dalek::verify_strict`):
///| - Exact input lengths: seed = 32B, public_key = 32B, signature = 64B.
///| - Canonical scalar `S`: rejects `S >= L`.
///| - Canonical point encoding for both `A` and `R`: rejects `y >= p` and `x == 0` with sign bit 1.
///| - Rejects all 8 small-order torsion points (`[8]P == O`) for both `A` and `R`.
///| - Verifies the strict un-cofactored equation `[S]B == R + [k]A`.

///|
#verify
pub val struct Fe {
  h0 : Int64
  h1 : Int64
  h2 : Int64
  h3 : Int64
  h4 : Int64
  h5 : Int64
  h6 : Int64
  h7 : Int64
  h8 : Int64
  h9 : Int64
}

///|
val struct GeP3 {
  x : Fe
  y : Fe
  z : Fe
  t : Fe
}

///|
fn fe_zero() -> Fe {
  Fe::{ h0: 0L, h1: 0L, h2: 0L, h3: 0L, h4: 0L, h5: 0L, h6: 0L, h7: 0L, h8: 0L, h9: 0L }
}

///|
fn fe_one() -> Fe {
  Fe::{ h0: 1L, h1: 0L, h2: 0L, h3: 0L, h4: 0L, h5: 0L, h6: 0L, h7: 0L, h8: 0L, h9: 0L }
}

