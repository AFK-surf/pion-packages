///| Lowercase hexadecimal encoding and decoding helpers.

///|
fn hex_nibble_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    -1
  }
}

///|
pub fn bytes_to_hex(data : Bytes) -> String {
  let digits = "0123456789abcdef"
  let n = data.length()
  let mut out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = data[i].to_int()
    out[i * 2] = digits.code_unit_at((v >> 4) & 0xF).to_byte()
    out[i * 2 + 1] = digits.code_unit_at(v & 0xF).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
pub fn hex_to_bytes(hex : String) -> Option[Bytes] {
  let n = hex.length()
  if (n & 1) != 0 {
    return None
  }
  let half = n >> 1
  let mut out = Bytes::new(half)
  let mut i = 0
  while i < half {
    let hi = hex_nibble_val(hex.code_unit_at(i * 2))
    let lo = hex_nibble_val(hex.code_unit_at(i * 2 + 1))
    if hi < 0 || lo < 0 {
      return None
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  Some(out)
}
