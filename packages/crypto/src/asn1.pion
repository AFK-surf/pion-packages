///| Internal strict ASN.1 DER reader and zero-dependency PEM/Base64 decoder
///| shared by `p256.pion` and `rsa.pion`.

///|
fn b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

///| Strict Base64 decoder ignoring ASCII whitespace (` `, `\t`, `\r`, `\n`).
fn b64_decode_pem_body(body : String) -> Result[Bytes, CryptoError] {
  let n = body.length()
  let clean = FixedArray::make(n, 0)
  let mut clen = 0
  let mut i = 0
  while i < n {
    let c = body.code_unit_at(i)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      i = i + 1
    } else {
      clean[clen] = c
      clen = clen + 1
      i = i + 1
    }
  }
  if clen == 0 || (clen & 3) != 0 {
    return Err(CryptoError::InvalidPem)
  }
  let mut pad = 0
  if clean[clen - 1] == 61 {
    pad = pad + 1
    if clean[clen - 2] == 61 {
      pad = pad + 1
    }
  }
  let out_len = (clen / 4) * 3 - pad
  let mut out = Bytes::new(out_len)
  let mut oi = 0
  let mut ci = 0
  while ci < clen {
    let c0 = clean[ci]
    let c1 = clean[ci + 1]
    let c2 = clean[ci + 2]
    let c3 = clean[ci + 3]
    let is_last = ci + 4 == clen
    let v0 = b64_val(c0)
    let v1 = b64_val(c1)
    if v0 < 0 || v1 < 0 {
      return Err(CryptoError::InvalidPem)
    }
    if is_last && c2 == 61 && c3 == 61 {
      // 2 padding chars: low 4 bits of v1 must be 0
      if (v1 & 0x0F) != 0 {
        return Err(CryptoError::InvalidPem)
      }
      out[oi] = ((v0 << 2) | (v1 >> 4)).to_byte()
      oi = oi + 1
    } else if is_last && c3 == 61 {
      let v2 = b64_val(c2)
      if v2 < 0 || (v2 & 0x03) != 0 {
        return Err(CryptoError::InvalidPem)
      }
      out[oi] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[oi + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      oi = oi + 2
    } else {
      let v2 = b64_val(c2)
      let v3 = b64_val(c3)
      if v2 < 0 || v3 < 0 {
        return Err(CryptoError::InvalidPem)
      }
      out[oi] = ((v0 << 2) | (v1 >> 4)).to_byte()
      out[oi + 1] = (((v1 & 0x0F) << 4) | (v2 >> 2)).to_byte()
      out[oi + 2] = (((v2 & 0x03) << 6) | v3).to_byte()
      oi = oi + 3
    }
    ci = ci + 4
  }
  Ok(out)
}

///|
fn pem_trim_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let c = s.code_unit_at(start)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      end = end - 1
    } else {
      break
    }
  }
  s.slice(start, end)
}

///| Decode a PEM block with exact header/footer `-----BEGIN <label>-----` / `-----END <label>-----`.
fn pem_decode(pem : String, label : String) -> Result[Bytes, CryptoError] {
  let heading = "-----BEGIN " + label + "-----"
  let ending = "-----END " + label + "-----"
  let trimmed = pem_trim_ws(pem)
  if trimmed.length() < heading.length() + ending.length() || trimmed.length() > 32768 {
    return Err(CryptoError::InvalidPem)
  }
  if trimmed.slice(0, heading.length()) != heading ||
  trimmed.slice(trimmed.length() - ending.length(), trimmed.length()) != ending {
    return Err(CryptoError::InvalidPem)
  }
  let body = trimmed.slice(heading.length(), trimmed.length() - ending.length())
  b64_decode_pem_body(body)
}

// ── Strict ASN.1 DER Reader ──

///|
struct DerReader {
  data : Bytes
  mut at : Int
  end : Int
}

///|
fn DerReader::done(self : DerReader) -> Bool {
  self.at == self.end
}

///|
fn DerReader::peek_tag(self : DerReader) -> Int {
  if self.at < self.end {
    self.data[self.at].to_int() & 0xFF
  } else {
    -1
  }
}

///|
fn DerReader::take(self : DerReader, tag : Int) -> Result[(Int, Int), CryptoError] {
  let mut at = self.at
  if self.end - at < 2 || (self.data[at].to_int() & 0xFF) != tag {
    return Err(CryptoError::InvalidDer)
  }
  let mut size = self.data[at + 1].to_int() & 0xFF
  at = at + 2
  if size >= 128 {
    let n = size - 128
    if n < 1 || n > 3 || self.end - at < n || (self.data[at].to_int() & 0xFF) == 0 {
      return Err(CryptoError::InvalidDer)
    }
    size = 0
    let mut i = 0
    while i < n {
      size = (size << 8) | (self.data[at + i].to_int() & 0xFF)
      i = i + 1
    }
    at = at + n
    if size < 128 {
      return Err(CryptoError::InvalidDer)
    }
  }
  if size > self.end - at {
    return Err(CryptoError::InvalidDer)
  }
  self.at = at + size
  Ok((at, size))
}

///| Read a strictly canonical non-negative ASN.1 DER INTEGER.
fn DerReader::uint_big(self : DerReader) -> Result[BigUint, CryptoError] {
  let span = match self.take(0x02) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let off = span.0
  let len = span.1
  if len <= 0 || (self.data[off].to_int() & 0xFF) >= 128 {
    return Err(CryptoError::InvalidDer)
  }
  if len > 1 && (self.data[off].to_int() & 0xFF) == 0 && (self.data[off + 1].to_int() & 0xFF) < 128 {
    return Err(CryptoError::InvalidDer)
  }
  Ok(big_from_be_slice(self.data, off, len))
}

///|
fn der_sequence(data : Bytes, off : Int, len : Int) -> Result[DerReader, CryptoError] {
  let outer = DerReader::{ data: data, at: off, end: off + len }
  let inner = match outer.take(0x30) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !outer.done() {
    return Err(CryptoError::InvalidDer)
  }
  Ok(DerReader::{ data: data, at: inner.0, end: inner.0 + inner.1 })
}

///|
fn der_slice_eq(data : Bytes, off : Int, len : Int, expected : Bytes) -> Bool {
  if len != expected.length() {
    return false
  }
  let mut i = 0
  while i < len {
    if data[off + i] != expected[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn der_const_hex(hex : String) -> Bytes {
  match hex_to_bytes(hex) {
    Some(b) => b
    None => Bytes::new(0)
  }
}
