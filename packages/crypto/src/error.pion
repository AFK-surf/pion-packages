///| Error types for `packages/crypto`.
///| Immutable value type (`Send`), zero `World` dependencies, no panics.

///|
pub enum CryptoError {
  InvalidSeedLength(Int)
  InvalidPublicKeyLength(Int)
  InvalidSignatureLength(Int)
  NonCanonicalScalar
  NonCanonicalPoint
  InvalidPoint
  SmallOrderPoint
  SignatureMismatch
}

///|
pub fn crypto_error_eq(a : CryptoError, b : CryptoError) -> Bool {
  match (a, b) {
    (CryptoError::InvalidSeedLength(x), CryptoError::InvalidSeedLength(y)) => x == y
    (CryptoError::InvalidPublicKeyLength(x), CryptoError::InvalidPublicKeyLength(y)) => x == y
    (CryptoError::InvalidSignatureLength(x), CryptoError::InvalidSignatureLength(y)) => x == y
    (CryptoError::NonCanonicalScalar, CryptoError::NonCanonicalScalar) => true
    (CryptoError::NonCanonicalPoint, CryptoError::NonCanonicalPoint) => true
    (CryptoError::InvalidPoint, CryptoError::InvalidPoint) => true
    (CryptoError::SmallOrderPoint, CryptoError::SmallOrderPoint) => true
    (CryptoError::SignatureMismatch, CryptoError::SignatureMismatch) => true
    _ => false
  }
}

///|
pub fn crypto_error_message(e : CryptoError) -> String {
  match e {
    CryptoError::InvalidSeedLength(_) => "invalid Ed25519 seed length (expected 32 bytes)"
    CryptoError::InvalidPublicKeyLength(_) => "invalid Ed25519 public key length (expected 32 bytes)"
    CryptoError::InvalidSignatureLength(_) => "invalid Ed25519 signature length (expected 64 bytes)"
    CryptoError::NonCanonicalScalar => "non-canonical Ed25519 signature scalar (S >= L)"
    CryptoError::NonCanonicalPoint => "non-canonical Ed25519 point encoding (y >= p or negative zero)"
    CryptoError::InvalidPoint => "invalid Ed25519 point (not on curve)"
    CryptoError::SmallOrderPoint => "small-order Ed25519 point rejected"
    CryptoError::SignatureMismatch => "Ed25519 signature verification failed"
  }
}
