///| RFC 2104 / RFC 4231 HMAC-SHA256, HMAC-SHA384, HMAC-SHA512 (streaming and one-shot).

///|
pub struct HmacSha256 {
  ipad_state : FixedArray[UInt]
  opad_state : FixedArray[UInt]
  inner : Sha256
}

///|
pub fn HmacSha256::new(key : Bytes) -> HmacSha256 {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let ipad_state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  let mut i = 0
  while i < 16 {
    let p = i << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[i] = ((b0 ^ 0x36).to_uint() << 24U) |
    ((b1 ^ 0x36).to_uint() << 16U) |
    ((b2 ^ 0x36).to_uint() << 8U) |
    (b3 ^ 0x36).to_uint()
    i = i + 1
  }
  sha256_compress_w(ipad_state, w)

  let opad_state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  let mut j = 0
  while j < 16 {
    let p = j << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[j] = ((b0 ^ 0x5C).to_uint() << 24U) |
    ((b1 ^ 0x5C).to_uint() << 16U) |
    ((b2 ^ 0x5C).to_uint() << 8U) |
    (b3 ^ 0x5C).to_uint()
    j = j + 1
  }
  sha256_compress_w(opad_state, w)

  let inner = Sha256::new()
  let mut s = 0
  while s < 8 {
    inner.state[s] = ipad_state[s]
    s = s + 1
  }
  inner.total = 64L

  HmacSha256::{ ipad_state: ipad_state, opad_state: opad_state, inner: inner }
}

///|
pub fn HmacSha256::reset(self : HmacSha256) -> Unit {
  let mut i = 0
  while i < 8 {
    self.inner.state[i] = self.ipad_state[i]
    i = i + 1
  }
  self.inner.fill = 0
  self.inner.total = 64L
}

///|
pub fn HmacSha256::update(self : HmacSha256, data : Bytes) -> Unit {
  self.inner.update(data)
}

///|
pub fn HmacSha256::update_slice(self : HmacSha256, data : Bytes, start : Int, end : Int) -> Unit {
  self.inner.update_slice(data, start, end)
}

///|
pub fn HmacSha256::finalize(self : HmacSha256) -> Bytes {
  let inner_h : FixedArray[UInt] = FixedArray::make(8, 0U)
  sha256_finalize_into(self.inner, inner_h)
  let outer_st : FixedArray[UInt] = [
    self.opad_state[0], self.opad_state[1], self.opad_state[2], self.opad_state[3],
    self.opad_state[4], self.opad_state[5], self.opad_state[6], self.opad_state[7],
  ]
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  w[0] = inner_h[0]
  w[1] = inner_h[1]
  w[2] = inner_h[2]
  w[3] = inner_h[3]
  w[4] = inner_h[4]
  w[5] = inner_h[5]
  w[6] = inner_h[6]
  w[7] = inner_h[7]
  w[8] = 0x80000000U
  w[15] = 768U
  sha256_compress_w(outer_st, w)
  sha256_state_to_bytes(outer_st)
}

///|
pub fn HmacSha256::finalize_hex(self : HmacSha256) -> String {
  bytes_to_hex(self.finalize())
}

///|
pub fn hmac_sha256(key : Bytes, data : Bytes) -> Bytes {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]

  let mut i = 0
  while i < 16 {
    let p = i << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[i] = ((b0 ^ 0x36).to_uint() << 24U) |
    ((b1 ^ 0x36).to_uint() << 16U) |
    ((b2 ^ 0x36).to_uint() << 8U) |
    (b3 ^ 0x36).to_uint()
    i = i + 1
  }
  sha256_compress_w(state, w)
  let len = data.length()
  sha256_update_final_state(state, data, 0, len, (64 + len).to_int64(), w)

  let h0 = state[0]
  let h1 = state[1]
  let h2 = state[2]
  let h3 = state[3]
  let h4 = state[4]
  let h5 = state[5]
  let h6 = state[6]
  let h7 = state[7]

  state[0] = 0x6a09e667U
  state[1] = 0xbb67ae85U
  state[2] = 0x3c6ef372U
  state[3] = 0xa54ff53aU
  state[4] = 0x510e527fU
  state[5] = 0x9b05688cU
  state[6] = 0x1f83d9abU
  state[7] = 0x5be0cd19U

  let mut j = 0
  while j < 16 {
    let p = j << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[j] = ((b0 ^ 0x5C).to_uint() << 24U) |
    ((b1 ^ 0x5C).to_uint() << 16U) |
    ((b2 ^ 0x5C).to_uint() << 8U) |
    (b3 ^ 0x5C).to_uint()
    j = j + 1
  }
  sha256_compress_w(state, w)

  w[0] = h0
  w[1] = h1
  w[2] = h2
  w[3] = h3
  w[4] = h4
  w[5] = h5
  w[6] = h6
  w[7] = h7
  w[8] = 0x80000000U
  w[9] = 0U
  w[10] = 0U
  w[11] = 0U
  w[12] = 0U
  w[13] = 0U
  w[14] = 0U
  w[15] = 768U
  sha256_compress_w(state, w)
  sha256_state_to_bytes(state)
}

///|
pub fn hmac_sha256_hex(key : Bytes, data : Bytes) -> String {
  bytes_to_hex(hmac_sha256(key, data))
}

///|
fn hmac_sha512_init_pads(
  key : Bytes,
  is_384 : Bool,
) -> (FixedArray[UInt64], FixedArray[UInt64]) {
  let k = if key.length() > 128 {
    if is_384 {
      sha384(key)
    } else {
      sha512(key)
    }
  } else {
    key
  }
  let klen = k.length()
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  let ipad_state : FixedArray[UInt64] = if is_384 {
    [
      0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
      0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
    ]
  } else {
    [
      0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
      0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
    ]
  }
  let opad_state : FixedArray[UInt64] = [
    ipad_state[0], ipad_state[1], ipad_state[2], ipad_state[3], ipad_state[4], ipad_state[5],
    ipad_state[6], ipad_state[7],
  ]

  let mut i = 0
  while i < 16 {
    let p = i << 3
    let b0 = (if p < klen { k[p].to_int() } else { 0 }) ^ 0x36
    let b1 = (if p + 1 < klen { k[p + 1].to_int() } else { 0 }) ^ 0x36
    let b2 = (if p + 2 < klen { k[p + 2].to_int() } else { 0 }) ^ 0x36
    let b3 = (if p + 3 < klen { k[p + 3].to_int() } else { 0 }) ^ 0x36
    let b4 = (if p + 4 < klen { k[p + 4].to_int() } else { 0 }) ^ 0x36
    let b5 = (if p + 5 < klen { k[p + 5].to_int() } else { 0 }) ^ 0x36
    let b6 = (if p + 6 < klen { k[p + 6].to_int() } else { 0 }) ^ 0x36
    let b7 = (if p + 7 < klen { k[p + 7].to_int() } else { 0 }) ^ 0x36
    w[i] = (b0.to_int64().to_uint64() << 56) |
    (b1.to_int64().to_uint64() << 48) |
    (b2.to_int64().to_uint64() << 40) |
    (b3.to_int64().to_uint64() << 32) |
    (b4.to_int64().to_uint64() << 24) |
    (b5.to_int64().to_uint64() << 16) |
    (b6.to_int64().to_uint64() << 8) |
    b7.to_int64().to_uint64()
    i = i + 1
  }
  sha512_compress_w(ipad_state, w)

  let mut j = 0
  while j < 16 {
    let p = j << 3
    let b0 = (if p < klen { k[p].to_int() } else { 0 }) ^ 0x5C
    let b1 = (if p + 1 < klen { k[p + 1].to_int() } else { 0 }) ^ 0x5C
    let b2 = (if p + 2 < klen { k[p + 2].to_int() } else { 0 }) ^ 0x5C
    let b3 = (if p + 3 < klen { k[p + 3].to_int() } else { 0 }) ^ 0x5C
    let b4 = (if p + 4 < klen { k[p + 4].to_int() } else { 0 }) ^ 0x5C
    let b5 = (if p + 5 < klen { k[p + 5].to_int() } else { 0 }) ^ 0x5C
    let b6 = (if p + 6 < klen { k[p + 6].to_int() } else { 0 }) ^ 0x5C
    let b7 = (if p + 7 < klen { k[p + 7].to_int() } else { 0 }) ^ 0x5C
    w[j] = (b0.to_int64().to_uint64() << 56) |
    (b1.to_int64().to_uint64() << 48) |
    (b2.to_int64().to_uint64() << 40) |
    (b3.to_int64().to_uint64() << 32) |
    (b4.to_int64().to_uint64() << 24) |
    (b5.to_int64().to_uint64() << 16) |
    (b6.to_int64().to_uint64() << 8) |
    b7.to_int64().to_uint64()
    j = j + 1
  }
  sha512_compress_w(opad_state, w)

  (ipad_state, opad_state)
}

///|
pub struct HmacSha384 {
  ipad_state : FixedArray[UInt64]
  opad_state : FixedArray[UInt64]
  core : Sha512Core
}

///|
pub fn HmacSha384::new(key : Bytes) -> HmacSha384 {
  let (ipad_state, opad_state) = hmac_sha512_init_pads(key, true)
  let core = Sha512Core::{
    state: [
      ipad_state[0], ipad_state[1], ipad_state[2], ipad_state[3], ipad_state[4], ipad_state[5],
      ipad_state[6], ipad_state[7],
    ],
    buf: FixedArray::make(128, 0),
    w: FixedArray::make(80, 0UL),
    fill: 0,
    total: 128L,
  }
  HmacSha384::{ ipad_state: ipad_state, opad_state: opad_state, core: core }
}

///|
pub fn HmacSha384::reset(self : HmacSha384) -> Unit {
  let mut i = 0
  while i < 8 {
    self.core.state[i] = self.ipad_state[i]
    i = i + 1
  }
  self.core.fill = 0
  self.core.total = 128L
}

///|
pub fn HmacSha384::update(self : HmacSha384, data : Bytes) -> Unit {
  sha512_core_update_slice(self.core, data, 0, data.length())
}

///|
pub fn HmacSha384::update_slice(self : HmacSha384, data : Bytes, start : Int, end : Int) -> Unit {
  sha512_core_update_slice(self.core, data, start, end)
}

///|
pub fn HmacSha384::finalize(self : HmacSha384) -> Bytes {
  let inner_h : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  sha512_core_finalize_into(self.core, inner_h)
  let outer_st : FixedArray[UInt64] = [
    self.opad_state[0], self.opad_state[1], self.opad_state[2], self.opad_state[3],
    self.opad_state[4], self.opad_state[5], self.opad_state[6], self.opad_state[7],
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  w[0] = inner_h[0]
  w[1] = inner_h[1]
  w[2] = inner_h[2]
  w[3] = inner_h[3]
  w[4] = inner_h[4]
  w[5] = inner_h[5]
  w[6] = 0x8000000000000000UL
  w[15] = 1408UL
  sha512_compress_w(outer_st, w)
  sha512_state_to_bytes(outer_st, 6)
}

///|
pub fn HmacSha384::finalize_hex(self : HmacSha384) -> String {
  bytes_to_hex(self.finalize())
}

///|
pub struct HmacSha512 {
  ipad_state : FixedArray[UInt64]
  opad_state : FixedArray[UInt64]
  core : Sha512Core
}

///|
pub fn HmacSha512::new(key : Bytes) -> HmacSha512 {
  let (ipad_state, opad_state) = hmac_sha512_init_pads(key, false)
  let core = Sha512Core::{
    state: [
      ipad_state[0], ipad_state[1], ipad_state[2], ipad_state[3], ipad_state[4], ipad_state[5],
      ipad_state[6], ipad_state[7],
    ],
    buf: FixedArray::make(128, 0),
    w: FixedArray::make(80, 0UL),
    fill: 0,
    total: 128L,
  }
  HmacSha512::{ ipad_state: ipad_state, opad_state: opad_state, core: core }
}

///|
pub fn HmacSha512::reset(self : HmacSha512) -> Unit {
  let mut i = 0
  while i < 8 {
    self.core.state[i] = self.ipad_state[i]
    i = i + 1
  }
  self.core.fill = 0
  self.core.total = 128L
}

///|
pub fn HmacSha512::update(self : HmacSha512, data : Bytes) -> Unit {
  sha512_core_update_slice(self.core, data, 0, data.length())
}

///|
pub fn HmacSha512::update_slice(self : HmacSha512, data : Bytes, start : Int, end : Int) -> Unit {
  sha512_core_update_slice(self.core, data, start, end)
}

///|
pub fn HmacSha512::finalize(self : HmacSha512) -> Bytes {
  let inner_h : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  sha512_core_finalize_into(self.core, inner_h)
  let outer_st : FixedArray[UInt64] = [
    self.opad_state[0], self.opad_state[1], self.opad_state[2], self.opad_state[3],
    self.opad_state[4], self.opad_state[5], self.opad_state[6], self.opad_state[7],
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  w[0] = inner_h[0]
  w[1] = inner_h[1]
  w[2] = inner_h[2]
  w[3] = inner_h[3]
  w[4] = inner_h[4]
  w[5] = inner_h[5]
  w[6] = inner_h[6]
  w[7] = inner_h[7]
  w[8] = 0x8000000000000000UL
  w[15] = 1536UL
  sha512_compress_w(outer_st, w)
  sha512_state_to_bytes(outer_st, 8)
}

///|
pub fn HmacSha512::finalize_hex(self : HmacSha512) -> String {
  bytes_to_hex(self.finalize())
}

///|
fn hmac_sha512_family(key : Bytes, data : Bytes, is_384 : Bool) -> Bytes {
  let (ipad_state, opad_state) = hmac_sha512_init_pads(key, is_384)
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  let len = data.length()
  sha512_update_final_state(ipad_state, data, 0, len, (128 + len).to_int64(), w)

  w[0] = ipad_state[0]
  w[1] = ipad_state[1]
  w[2] = ipad_state[2]
  w[3] = ipad_state[3]
  w[4] = ipad_state[4]
  w[5] = ipad_state[5]
  if is_384 {
    w[6] = 0x8000000000000000UL
    w[7] = 0UL
    w[8] = 0UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1408UL
    sha512_compress_w(opad_state, w)
    sha512_state_to_bytes(opad_state, 6)
  } else {
    w[6] = ipad_state[6]
    w[7] = ipad_state[7]
    w[8] = 0x8000000000000000UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1536UL
    sha512_compress_w(opad_state, w)
    sha512_state_to_bytes(opad_state, 8)
  }
}

///|
pub fn hmac_sha384(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family(key, data, true)
}

///|
pub fn hmac_sha384_hex(key : Bytes, data : Bytes) -> String {
  bytes_to_hex(hmac_sha384(key, data))
}

///|
pub fn hmac_sha512(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family(key, data, false)
}

///|
pub fn hmac_sha512_hex(key : Bytes, data : Bytes) -> String {
  bytes_to_hex(hmac_sha512(key, data))
}
