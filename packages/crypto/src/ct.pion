///| Constant-time byte comparison.

///| Constant-time difference accumulator step (`diff | (a ^ b)`).
#verify
pub fn ct_diff_acc(diff : Int, a : Int, b : Int) -> Int {
  diff | (a ^ b)
}

///|
pub fn constant_time_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut diff = 0
  let mut i = 0
  while i < n {
    diff = ct_diff_acc(diff, a[i].to_int(), b[i].to_int())
    i = i + 1
  }
  diff == 0
}
