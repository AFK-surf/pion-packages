///| RFC 7748 X25519 Elliptic Curve Diffie-Hellman (pure Pion, zero World dependencies).
///| Reuses the constant-time Ref10 `Fe` field arithmetic (`val struct Fe`, radix 2^25.5)
///| and branch-free `fe_cmov` from `ed25519.pion`.

///|
fn fe_a24() -> Fe {
  Fe::{ h0: 121665L, h1: 0L, h2: 0L, h3: 0L, h4: 0L, h5: 0L, h6: 0L, h7: 0L, h8: 0L, h9: 0L }
}

///| RFC 7748 §5 X25519 low-byte scalar clamping (clears bits 0, 1, 2 for cofactor 8).
#verify
pub fn x25519_clamp_low_byte(b : Int) -> Int {
  b & 248
}

///| RFC 7748 §5 X25519 high-byte scalar clamping (clears bit 7, sets bit 6).
#verify
pub fn x25519_clamp_high_byte(b : Int) -> Int {
  (b & 127) | 64
}

///| Constant-time conditional swap of two `Fe` values when `swap == 1L`.
#verify
pub fn fe_cswap_pair(a : Fe, b : Fe, swap : Int64) -> (Fe, Fe) {
  let mask = 0L - swap
  let d0 = mask & (a.h0 ^ b.h0)
  let d1 = mask & (a.h1 ^ b.h1)
  let d2 = mask & (a.h2 ^ b.h2)
  let d3 = mask & (a.h3 ^ b.h3)
  let d4 = mask & (a.h4 ^ b.h4)
  let d5 = mask & (a.h5 ^ b.h5)
  let d6 = mask & (a.h6 ^ b.h6)
  let d7 = mask & (a.h7 ^ b.h7)
  let d8 = mask & (a.h8 ^ b.h8)
  let d9 = mask & (a.h9 ^ b.h9)
  (
    Fe::{
      h0: a.h0 ^ d0,
      h1: a.h1 ^ d1,
      h2: a.h2 ^ d2,
      h3: a.h3 ^ d3,
      h4: a.h4 ^ d4,
      h5: a.h5 ^ d5,
      h6: a.h6 ^ d6,
      h7: a.h7 ^ d7,
      h8: a.h8 ^ d8,
      h9: a.h9 ^ d9,
    },
    Fe::{
      h0: b.h0 ^ d0,
      h1: b.h1 ^ d1,
      h2: b.h2 ^ d2,
      h3: b.h3 ^ d3,
      h4: b.h4 ^ d4,
      h5: b.h5 ^ d5,
      h6: b.h6 ^ d6,
      h7: b.h7 ^ d7,
      h8: b.h8 ^ d8,
      h9: b.h9 ^ d9,
    },
  )
}

///| RFC 7748 §5 raw X25519 Montgomery ladder (clamps `secret`, masks bit 255 of `peer_public`,
///| does NOT reject all-zero output; intended for RFC 7748 ladder vector verification).
pub fn x25519_raw(secret : Bytes, peer_public : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  if peer_public.length() != 32 {
    return Err(CryptoError::InvalidPublicKeyLength(peer_public.length()))
  }
  let k = FixedArray::make(32, 0)
  let mut i = 0
  while i < 32 {
    k[i] = secret[i].to_int() & 0xFF
    i = i + 1
  }
  k[0] = x25519_clamp_low_byte(k[0])
  k[31] = x25519_clamp_high_byte(k[31])

  let x1 = fe_frombytes(peer_public, 0)
  let mut x2 = fe_one()
  let mut z2 = fe_zero()
  let mut x3 = x1
  let mut z3 = fe_one()
  let a24 = fe_a24()
  let mut swap = 0L

  let mut t = 254
  while t >= 0 {
    let kt = ((k[t >> 3] >> (t & 7)) & 1).to_int64()
    swap = swap ^ kt
    let (nx2, nx3) = fe_cswap_pair(x2, x3, swap)
    let (nz2, nz3) = fe_cswap_pair(z2, z3, swap)
    x2 = nx2
    x3 = nx3
    z2 = nz2
    z3 = nz3
    swap = kt

    let a = fe_add(x2, z2)
    let aa = fe_sq(a)
    let b = fe_sub(x2, z2)
    let bb = fe_sq(b)
    let e = fe_sub(aa, bb)
    let c = fe_add(x3, z3)
    let d = fe_sub(x3, z3)
    let da = fe_mul(d, a)
    let cb = fe_mul(c, b)
    x3 = fe_sq(fe_add(da, cb))
    z3 = fe_mul(x1, fe_sq(fe_sub(da, cb)))
    x2 = fe_mul(aa, bb)
    z2 = fe_mul(e, fe_add(aa, fe_mul(a24, e)))

    t = t - 1
  }

  let (fx2, _) = fe_cswap_pair(x2, x3, swap)
  let (fz2, _) = fe_cswap_pair(z2, z3, swap)
  Ok(fe_tobytes(fe_mul(fx2, fe_invert(fz2))))
}

///| RFC 7748 X25519 Diffie-Hellman shared secret.
///| Clamps `secret` per RFC 7748 and strictly rejects all-zero outputs (all 8 small-order points)
///| with `Err(CryptoError::SmallOrderPoint)`.
pub fn x25519(secret : Bytes, peer_public : Bytes) -> Result[Bytes, CryptoError] {
  let out = match x25519_raw(secret, peer_public) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut acc = 0
  let mut i = 0
  while i < 32 {
    acc = acc | (out[i].to_int() & 0xFF)
    i = i + 1
  }
  if acc == 0 {
    return Err(CryptoError::SmallOrderPoint)
  }
  Ok(out)
}

///| Derive the 32-byte X25519 public key from a 32-byte private key (basepoint u = 9).
pub fn x25519_public_key(secret : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  let mut base = Bytes::new(32)
  base[0] = (9).to_byte()
  x25519(secret, base)
}
