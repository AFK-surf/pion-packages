///| Internal arbitrary-precision unsigned integer (base 2^32, UInt64 limbs) and
///| Montgomery CIOS multiplication/exponentiation shared by `p256.pion` and `rsa.pion`.

///|
struct BigUint {
  limbs : FixedArray[UInt64]
  len : Int
}

///|
fn big_trim(limbs : FixedArray[UInt64], raw_len : Int) -> BigUint {
  let mut n = raw_len
  while n > 0 && limbs[n - 1] == 0UL {
    n = n - 1
  }
  BigUint::{ limbs: limbs, len: n }
}

///|
fn big_zero() -> BigUint {
  BigUint::{ limbs: FixedArray::make(1, 0UL), len: 0 }
}

///|
fn big_from_u64(v : UInt64) -> BigUint {
  if v == 0UL {
    return big_zero()
  }
  let limbs = FixedArray::make(2, 0UL)
  limbs[0] = v & 0xFFFFFFFFUL
  limbs[1] = v >> 32UL
  big_trim(limbs, 2)
}

///|
fn big_is_zero(a : BigUint) -> Bool {
  a.len == 0
}

///|
fn big_is_odd(a : BigUint) -> Bool {
  a.len > 0 && (a.limbs[0] & 1UL) == 1UL
}

///|
fn big_cmp(a : BigUint, b : BigUint) -> Int {
  if a.len < b.len {
    return -1
  }
  if a.len > b.len {
    return 1
  }
  let mut i = a.len - 1
  while i >= 0 {
    if a.limbs[i] < b.limbs[i] {
      return -1
    }
    if a.limbs[i] > b.limbs[i] {
      return 1
    }
    i = i - 1
  }
  0
}

///|
fn big_eq(a : BigUint, b : BigUint) -> Bool {
  big_cmp(a, b) == 0
}

///|
fn big_bit_len(a : BigUint) -> Int {
  if a.len == 0 {
    return 0
  }
  let mut top = a.limbs[a.len - 1]
  let mut bits = 0
  while top > 0UL {
    top = top >> 1UL
    bits = bits + 1
  }
  (a.len - 1) * 32 + bits
}

///|
fn big_get_bit(a : BigUint, bit : Int) -> Int {
  let limb_idx = bit / 32
  if limb_idx < 0 || limb_idx >= a.len {
    return 0
  }
  let shift = (bit % 32).to_int64().to_uint64()
  ((a.limbs[limb_idx] >> shift) & 1UL).to_int()
}

///|
fn big_from_be_slice(data : Bytes, offset : Int, len : Int) -> BigUint {
  if len <= 0 {
    return big_zero()
  }
  let num_limbs = (len + 3) / 4
  let limbs = FixedArray::make(num_limbs, 0UL)
  let mut i = 0
  while i < len {
    let b = (data[offset + len - 1 - i].to_int() & 0xFF).to_int64().to_uint64()
    let limb_idx = i / 4
    let shift = ((i % 4) * 8).to_int64().to_uint64()
    limbs[limb_idx] = limbs[limb_idx] | (b << shift)
    i = i + 1
  }
  big_trim(limbs, num_limbs)
}

///|
fn big_from_be(data : Bytes) -> BigUint {
  big_from_be_slice(data, 0, data.length())
}

///|
fn big_to_be(a : BigUint, size : Int) -> Bytes {
  let mut out = Bytes::new(size)
  let mut i = 0
  while i < size {
    let limb_idx = i / 4
    let shift = ((i % 4) * 8).to_int64().to_uint64()
    let v = if limb_idx < a.len { (a.limbs[limb_idx] >> shift) & 0xFFUL } else { 0UL }
    out[size - 1 - i] = v.to_int().to_byte()
    i = i + 1
  }
  out
}

///|
fn big_add(a : BigUint, b : BigUint) -> BigUint {
  let max_len = if a.len > b.len { a.len } else { b.len }
  let out = FixedArray::make(max_len + 1, 0UL)
  let mut carry = 0UL
  let mut i = 0
  while i < max_len {
    let av = if i < a.len { a.limbs[i] } else { 0UL }
    let bv = if i < b.len { b.limbs[i] } else { 0UL }
    let s = av + bv + carry
    out[i] = s & 0xFFFFFFFFUL
    carry = s >> 32UL
    i = i + 1
  }
  out[max_len] = carry
  big_trim(out, max_len + 1)
}

///| Assumes `a >= b`.
fn big_sub(a : BigUint, b : BigUint) -> BigUint {
  let out = FixedArray::make(if a.len > 0 { a.len } else { 1 }, 0UL)
  let mut borrow = 0UL
  let mut i = 0
  while i < a.len {
    let av = a.limbs[i]
    let bv = (if i < b.len { b.limbs[i] } else { 0UL }) + borrow
    if av >= bv {
      out[i] = (av - bv) & 0xFFFFFFFFUL
      borrow = 0UL
    } else {
      out[i] = ((av + 0x100000000UL) - bv) & 0xFFFFFFFFUL
      borrow = 1UL
    }
    i = i + 1
  }
  big_trim(out, a.len)
}

///|
fn big_mul(a : BigUint, b : BigUint) -> BigUint {
  if a.len == 0 || b.len == 0 {
    return big_zero()
  }
  let out_len = a.len + b.len
  let out = FixedArray::make(out_len, 0UL)
  let mut i = 0
  while i < a.len {
    let ai = a.limbs[i]
    let mut carry = 0UL
    let mut j = 0
    while j < b.len {
      let cur = out[i + j] + ai * b.limbs[j] + carry
      out[i + j] = cur & 0xFFFFFFFFUL
      carry = cur >> 32UL
      j = j + 1
    }
    out[i + b.len] = out[i + b.len] + carry
    i = i + 1
  }
  big_trim(out, out_len)
}

///| Compute `a % m` via binary long division (`m > 0`).
fn big_mod(a : BigUint, m : BigUint) -> BigUint {
  if big_cmp(a, m) < 0 {
    return a
  }
  let m_len = m.len
  let rem = FixedArray::make(m_len + 1, 0UL)
  let mut r_len = 0
  let total_bits = big_bit_len(a)
  let mut bit = total_bits - 1
  while bit >= 0 {
    let mut carry = big_get_bit(a, bit).to_int64().to_uint64()
    let mut i = 0
    while i < r_len {
      let v = (rem[i] << 1UL) | carry
      rem[i] = v & 0xFFFFFFFFUL
      carry = v >> 32UL
      i = i + 1
    }
    if carry != 0UL {
      rem[r_len] = carry
      r_len = r_len + 1
    }
    let mut ge = false
    if r_len > m_len {
      ge = true
    } else if r_len == m_len {
      ge = true
      let mut k = m_len - 1
      while k >= 0 {
        if rem[k] != m.limbs[k] {
          ge = rem[k] > m.limbs[k]
          k = -1
        } else {
          k = k - 1
        }
      }
    }
    if ge {
      let mut borrow = 0UL
      let mut k = 0
      while k < r_len {
        let av = rem[k]
        let bv = (if k < m_len { m.limbs[k] } else { 0UL }) + borrow
        if av >= bv {
          rem[k] = (av - bv) & 0xFFFFFFFFUL
          borrow = 0UL
        } else {
          rem[k] = ((av + 0x100000000UL) - bv) & 0xFFFFFFFFUL
          borrow = 1UL
        }
        k = k + 1
      }
      while r_len > 0 && rem[r_len - 1] == 0UL {
        r_len = r_len - 1
      }
    }
    bit = bit - 1
  }
  big_trim(rem, r_len)
}

///|
fn big_add_mod(a : BigUint, b : BigUint, m : BigUint) -> BigUint {
  let s = big_add(a, b)
  if big_cmp(s, m) >= 0 { big_sub(s, m) } else { s }
}

///|
fn big_sub_mod(a : BigUint, b : BigUint, m : BigUint) -> BigUint {
  if big_cmp(a, b) >= 0 { big_sub(a, b) } else { big_sub(big_add(a, m), b) }
}

///|
fn big_mul_mod(a : BigUint, b : BigUint, m : BigUint) -> BigUint {
  big_mod(big_mul(a, b), m)
}

// ── Montgomery CIOS Multiplication & Exponentiation (odd modulus m) ──

///| Compute `-m0^(-1) mod 2^32` for odd `m0`.
fn mont_n0_inv(m0 : UInt64) -> UInt64 {
  let mut x = 1UL
  let mut i = 0
  while i < 5 {
    x = (x * (2UL - m0 * x)) & 0xFFFFFFFFUL
    i = i + 1
  }
  (0x100000000UL - x) & 0xFFFFFFFFUL
}

///| Compute `R^2 mod m` where `R = 2^(32 * k)` and `k = m.len`.
fn mont_r2(m : BigUint) -> BigUint {
  let k = m.len
  let limbs = FixedArray::make(2 * k + 1, 0UL)
  limbs[2 * k] = 1UL
  big_mod(BigUint::{ limbs: limbs, len: 2 * k + 1 }, m)
}

///|
fn to_fixed_limbs(a : BigUint, k : Int) -> FixedArray[UInt64] {
  let out = FixedArray::make(k, 0UL)
  let n = if a.len < k { a.len } else { k }
  let mut i = 0
  while i < n {
    out[i] = a.limbs[i]
    i = i + 1
  }
  out
}

///| Branch-free Montgomery CIOS multiplication: `a * b * R^(-1) mod m`.
fn mont_mul_limbs(
  a : FixedArray[UInt64],
  b : FixedArray[UInt64],
  m : FixedArray[UInt64],
  k : Int,
  n0_inv : UInt64,
) -> FixedArray[UInt64] {
  let t = FixedArray::make(k + 2, 0UL)
  let mut i = 0
  while i < k {
    let ai = a[i]
    let mut carry = 0UL
    let mut j = 0
    while j < k {
      let s = t[j] + ai * b[j] + carry
      t[j] = s & 0xFFFFFFFFUL
      carry = s >> 32UL
      j = j + 1
    }
    let s1 = t[k] + carry
    t[k] = s1 & 0xFFFFFFFFUL
    t[k + 1] = s1 >> 32UL

    let u = (t[0] * n0_inv) & 0xFFFFFFFFUL
    let s0 = t[0] + u * m[0]
    carry = s0 >> 32UL
    j = 1
    while j < k {
      let sj = t[j] + u * m[j] + carry
      t[j - 1] = sj & 0xFFFFFFFFUL
      carry = sj >> 32UL
      j = j + 1
    }
    let sk = t[k] + carry
    t[k - 1] = sk & 0xFFFFFFFFUL
    t[k] = t[k + 1] + (sk >> 32UL)
    t[k + 1] = 0UL
    i = i + 1
  }
  // Branch-free conditional subtraction: diff = t - m
  let diff = FixedArray::make(k, 0UL)
  let mut borrow = 0UL
  let mut idx = 0
  while idx < k {
    let sub = (t[idx] + 0x100000000UL) - m[idx] - borrow
    diff[idx] = sub & 0xFFFFFFFFUL
    borrow = 1UL - (sub >> 32UL)
    idx = idx + 1
  }
  // Subtract succeeded iff t[k] >= borrow, i.e. (t[k] - borrow) has sign bit 0
  let no_underflow = 1UL - ((t[k] - borrow) >> 63UL)
  let mask = 0UL - no_underflow
  let out = FixedArray::make(k, 0UL)
  idx = 0
  while idx < k {
    out[idx] = t[idx] ^ (mask & (t[idx] ^ diff[idx]))
    idx = idx + 1
  }
  out
}

///| Compute `base^exp mod m` using Montgomery multiplication (requires odd `m > 1`).
fn big_mod_pow(base : BigUint, exp : BigUint, m : BigUint) -> BigUint {
  let k = m.len
  let m_limbs = to_fixed_limbs(m, k)
  let n0_inv = mont_n0_inv(m_limbs[0])
  let r2 = to_fixed_limbs(mont_r2(m), k)
  let one = FixedArray::make(k, 0UL)
  one[0] = 1UL
  let b_red = to_fixed_limbs(big_mod(base, m), k)
  let mut acc = mont_mul_limbs(one, r2, m_limbs, k, n0_inv)
  let b_mont = mont_mul_limbs(b_red, r2, m_limbs, k, n0_inv)
  let bits = big_bit_len(exp)
  let mut bit = bits - 1
  while bit >= 0 {
    acc = mont_mul_limbs(acc, acc, m_limbs, k, n0_inv)
    if big_get_bit(exp, bit) == 1 {
      acc = mont_mul_limbs(acc, b_mont, m_limbs, k, n0_inv)
    }
    bit = bit - 1
  }
  let res = mont_mul_limbs(acc, one, m_limbs, k, n0_inv)
  big_trim(res, k)
}
