///| NIST SP 800-38D AES-128-GCM and AES-256-GCM authenticated encryption
///| (pure Pion, zero World dependencies).
///|
///| Constant-time implementation with zero secret-dependent table lookups or branches:
///| - 64-bit 4-block parallel bitsliced AES-128 / AES-256 (Boyar-Peralta S-box circuit)
///| - Carry-less GF(2^128) GHASH via 4-way masked 32x32->64-bit Karatsuba multiplication
///| - Constant-time tag verification (`constant_time_eq`) before decryption

// ── Constant-time 64-bit 4-block Bitsliced AES ──
//
// State `q[0..7]` holds 4 AES blocks (64 bytes) simultaneously:
// bit `b` of byte at `(row, col, blk)` is stored at bit position `row * 16 + col * 4 + blk`
// of `q[b]`, where `row ∈ 0..3`, `col ∈ 0..3`, `blk ∈ 0..3`, and byte offset in block `blk`
// is `col * 4 + row`.

///| In-place 8x8 bit-matrix transpose across all 8 byte-lanes of `q[0..7]` (self-inverse).
///| Delta swaps are inlined to avoid 2-tuple heap allocations.
fn aes_transpose_8x8(q : FixedArray[UInt64]) -> Unit {
  let m1 = 0x5555555555555555UL
  let m2 = 0x3333333333333333UL
  let m4 = 0x0F0F0F0F0F0F0F0FUL

  let mut q0 = q[0]
  let mut q1 = q[1]
  let mut q2 = q[2]
  let mut q3 = q[3]
  let mut q4 = q[4]
  let mut q5 = q[5]
  let mut q6 = q[6]
  let mut q7 = q[7]

  let mut d = ((q0 >> 1UL) ^ q1) & m1; q0 = q0 ^ (d << 1UL); q1 = q1 ^ d
  d = ((q2 >> 1UL) ^ q3) & m1; q2 = q2 ^ (d << 1UL); q3 = q3 ^ d
  d = ((q4 >> 1UL) ^ q5) & m1; q4 = q4 ^ (d << 1UL); q5 = q5 ^ d
  d = ((q6 >> 1UL) ^ q7) & m1; q6 = q6 ^ (d << 1UL); q7 = q7 ^ d

  d = ((q0 >> 2UL) ^ q2) & m2; q0 = q0 ^ (d << 2UL); q2 = q2 ^ d
  d = ((q1 >> 2UL) ^ q3) & m2; q1 = q1 ^ (d << 2UL); q3 = q3 ^ d
  d = ((q4 >> 2UL) ^ q6) & m2; q4 = q4 ^ (d << 2UL); q6 = q6 ^ d
  d = ((q5 >> 2UL) ^ q7) & m2; q5 = q5 ^ (d << 2UL); q7 = q7 ^ d

  d = ((q0 >> 4UL) ^ q4) & m4; q0 = q0 ^ (d << 4UL); q4 = q4 ^ d
  d = ((q1 >> 4UL) ^ q5) & m4; q1 = q1 ^ (d << 4UL); q5 = q5 ^ d
  d = ((q2 >> 4UL) ^ q6) & m4; q2 = q2 ^ (d << 4UL); q6 = q6 ^ d
  d = ((q3 >> 4UL) ^ q7) & m4; q3 = q3 ^ (d << 4UL); q7 = q7 ^ d

  q[0] = q0
  q[1] = q1
  q[2] = q2
  q[3] = q3
  q[4] = q4
  q[5] = q5
  q[6] = q6
  q[7] = q7
}

///| Boyar-Peralta (2010) constant-time bitsliced AES S-box over `q[0..7]` (LSB in `q[0]`, MSB in `q[7]`).
fn aes_bitslice_sbox(q : FixedArray[UInt64]) -> Unit {
  let x0 = q[7]
  let x1 = q[6]
  let x2 = q[5]
  let x3 = q[4]
  let x4 = q[3]
  let x5 = q[2]
  let x6 = q[1]
  let x7 = q[0]

  // Top linear transformation
  let y14 = x3 ^ x5
  let y13 = x0 ^ x6
  let y9 = x0 ^ x3
  let y8 = x0 ^ x5
  let t0 = x1 ^ x2
  let y1 = t0 ^ x7
  let y4 = y1 ^ x3
  let y12 = y13 ^ y14
  let y2 = y1 ^ x0
  let y5 = y1 ^ x6
  let y3 = y5 ^ y8
  let t1 = x4 ^ y12
  let y15 = t1 ^ x5
  let y20 = t1 ^ x1
  let y6 = y15 ^ x7
  let y10 = y15 ^ t0
  let y11 = y20 ^ y9
  let y7 = x7 ^ y11
  let y17 = y10 ^ y11
  let y19 = y10 ^ y8
  let y16 = t0 ^ y11
  let y21 = y13 ^ y16
  let y18 = x0 ^ y16

  // Middle non-linear GF(2^4) inversion
  let t2 = y12 & y15
  let t3 = y3 & y6
  let t4 = t3 ^ t2
  let t5 = y4 & x7
  let t6 = t5 ^ t2
  let t7 = y13 & y16
  let t8 = y5 & y1
  let t9 = t8 ^ t7
  let t10 = y2 & y7
  let t11 = t10 ^ t7
  let t12 = y9 & y11
  let t13 = y14 & y17
  let t14 = t13 ^ t12
  let t15 = y8 & y10
  let t16 = t15 ^ t12
  let t17 = t4 ^ t14
  let t18 = t6 ^ t16
  let t19 = t9 ^ t14
  let t20 = t11 ^ t16
  let t21 = t17 ^ y20
  let t22 = t18 ^ y19
  let t23 = t19 ^ y21
  let t24 = t20 ^ y18

  let t25 = t21 ^ t22
  let t26 = t21 & t23
  let t27 = t24 ^ t26
  let t28 = t25 & t27
  let t29 = t28 ^ t22
  let t30 = t23 ^ t24
  let t31 = t22 ^ t26
  let t32 = t31 & t30
  let t33 = t32 ^ t24
  let t34 = t23 ^ t33
  let t35 = t27 ^ t33
  let t36 = t24 & t35
  let t37 = t36 ^ t34
  let t38 = t27 ^ t36
  let t39 = t29 & t38
  let t40 = t25 ^ t39

  let t41 = t40 ^ t37
  let t42 = t29 ^ t33
  let t43 = t29 ^ t40
  let t44 = t33 ^ t37
  let t45 = t42 ^ t41
  let z0 = t44 & y15
  let z1 = t37 & y6
  let z2 = t33 & x7
  let z3 = t43 & y16
  let z4 = t40 & y1
  let z5 = t29 & y7
  let z6 = t42 & y11
  let z7 = t45 & y17
  let z8 = t41 & y10
  let z9 = t44 & y12
  let z10 = t37 & y3
  let z11 = t33 & y4
  let z12 = t43 & y13
  let z13 = t40 & y5
  let z14 = t29 & y2
  let z15 = t42 & y9
  let z16 = t45 & y14
  let z17 = t41 & y8

  // Bottom linear transformation + affine constant 0x63
  let t46 = z15 ^ z16
  let t47 = z10 ^ z11
  let t48 = z5 ^ z13
  let t49 = z9 ^ z10
  let t50 = z2 ^ z12
  let t51 = z2 ^ z5
  let t52 = z7 ^ z8
  let t53 = z0 ^ z3
  let t54 = z6 ^ z7
  let t55 = z16 ^ z17
  let t56 = z12 ^ t48
  let t57 = t50 ^ t53
  let t58 = z4 ^ t46
  let t59 = z3 ^ t54
  let t60 = t46 ^ t57
  let t61 = z14 ^ t57
  let t62 = t52 ^ t58
  let t63 = t49 ^ t58
  let t64 = z4 ^ t59
  let t65 = t61 ^ t62
  let t66 = z1 ^ t63
  let s0 = t59 ^ t63
  let s6 = (t56 ^ t62) ^ 0xFFFFFFFFFFFFFFFFUL
  let s7 = (t48 ^ t60) ^ 0xFFFFFFFFFFFFFFFFUL
  let t67 = t64 ^ t65
  let s3 = t53 ^ t66
  let s4 = t51 ^ t66
  let s5 = t47 ^ t65
  let s1 = (t64 ^ s3) ^ 0xFFFFFFFFFFFFFFFFUL
  let s2 = (t55 ^ t67) ^ 0xFFFFFFFFFFFFFFFFUL

  q[7] = s0
  q[6] = s1
  q[5] = s2
  q[4] = s3
  q[3] = s4
  q[2] = s5
  q[1] = s6
  q[0] = s7
}

///| Bitsliced ShiftRows on `q[0..7]`.
fn aes_bitslice_shift_rows(q : FixedArray[UInt64]) -> Unit {
  let mut i = 0
  while i < 8 {
    let x = q[i]
    let r0 = x & 0x000000000000FFFFUL
    let r1 = ((x & 0x00000000FFF00000UL) >> 4UL) | ((x & 0x00000000000F0000UL) << 12UL)
    let r2 = ((x & 0x0000FF0000000000UL) >> 8UL) | ((x & 0x000000FF00000000UL) << 8UL)
    let r3 = ((x & 0xF000000000000000UL) >> 12UL) | ((x & 0x0FFF000000000000UL) << 4UL)
    q[i] = r0 | r1 | r2 | r3
    i = i + 1
  }
}

///|
fn aes_rotr16(x : UInt64) -> UInt64 {
  (x >> 16UL) | (x << 48UL)
}

///|
fn aes_rotr32(x : UInt64) -> UInt64 {
  (x >> 32UL) | (x << 32UL)
}

///| Bitsliced MixColumns on `q[0..7]`.
fn aes_bitslice_mix_columns(q : FixedArray[UInt64]) -> Unit {
  let q0 = q[0]
  let q1 = q[1]
  let q2 = q[2]
  let q3 = q[3]
  let q4 = q[4]
  let q5 = q[5]
  let q6 = q[6]
  let q7 = q[7]

  let r0 = aes_rotr16(q0)
  let r1 = aes_rotr16(q1)
  let r2 = aes_rotr16(q2)
  let r3 = aes_rotr16(q3)
  let r4 = aes_rotr16(q4)
  let r5 = aes_rotr16(q5)
  let r6 = aes_rotr16(q6)
  let r7 = aes_rotr16(q7)

  let t0 = q0 ^ r0
  let t1 = q1 ^ r1
  let t2 = q2 ^ r2
  let t3 = q3 ^ r3
  let t4 = q4 ^ r4
  let t5 = q5 ^ r5
  let t6 = q6 ^ r6
  let t7 = q7 ^ r7

  q[0] = t7 ^ r0 ^ aes_rotr32(t0)
  q[1] = t0 ^ t7 ^ r1 ^ aes_rotr32(t1)
  q[2] = t1 ^ r2 ^ aes_rotr32(t2)
  q[3] = t2 ^ t7 ^ r3 ^ aes_rotr32(t3)
  q[4] = t3 ^ t7 ^ r4 ^ aes_rotr32(t4)
  q[5] = t4 ^ r5 ^ aes_rotr32(t5)
  q[6] = t5 ^ r6 ^ aes_rotr32(t6)
  q[7] = t6 ^ r7 ^ aes_rotr32(t7)
}

///| Constant-time single-word (4-byte) SubWord via the bitsliced S-box using caller scratch `q`.
fn aes_sub_word_ct(w : UInt, q : FixedArray[UInt64]) -> UInt {
  q[0] = (w & 0xFFU).to_int64().to_uint64()
  q[1] = ((w >> 8U) & 0xFFU).to_int64().to_uint64()
  q[2] = ((w >> 16U) & 0xFFU).to_int64().to_uint64()
  q[3] = ((w >> 24U) & 0xFFU).to_int64().to_uint64()
  q[4] = 0UL
  q[5] = 0UL
  q[6] = 0UL
  q[7] = 0UL
  aes_transpose_8x8(q)
  aes_bitslice_sbox(q)
  aes_transpose_8x8(q)
  let o0 = (q[0] & 0xFFUL).to_int().to_uint()
  let o1 = (q[1] & 0xFFUL).to_int().to_uint()
  let o2 = (q[2] & 0xFFUL).to_int().to_uint()
  let o3 = (q[3] & 0xFFUL).to_int().to_uint()
  o0 | (o1 << 8U) | (o2 << 16U) | (o3 << 24U)
}

///|
fn aes_load32_le(b : Bytes, off : Int) -> UInt {
  let b0 = (b[off].to_int() & 0xFF).to_uint()
  let b1 = (b[off + 1].to_int() & 0xFF).to_uint()
  let b2 = (b[off + 2].to_int() & 0xFF).to_uint()
  let b3 = (b[off + 3].to_int() & 0xFF).to_uint()
  b0 | (b1 << 8U) | (b2 << 16U) | (b3 << 24U)
}

///|
fn aes_rotr8_u32(x : UInt) -> UInt {
  ((x >> 8U) | (x << 24U)) & 0xFFFFFFFFU
}

///| Expanded bitsliced AES round keys (`(rounds + 1) * 8` UInt64 words).
struct AesKeySchedule {
  rounds : Int
  rk : FixedArray[UInt64]
}

///| Convert 4 little-endian 32-bit round-key words into 8 bitsliced UInt64s replicated across 4 blocks.
///| Uses `aes_transpose_8x8` on caller scratch `q` (zero heap allocations, no triple loop).
fn aes_pack_round_key(
  w0 : UInt,
  w1 : UInt,
  w2 : UInt,
  w3 : UInt,
  out : FixedArray[UInt64],
  base : Int,
  q : FixedArray[UInt64],
) -> Unit {
  // Pack the 16 key bytes replicated across all 4 block lanes (i = 0..3 -> col_lo=0, i = 4..7 -> col_lo=1).
  let r0c0 = (w0 & 0xFFU).to_int64().to_uint64()
  let r1c0 = ((w0 >> 8U) & 0xFFU).to_int64().to_uint64()
  let r2c0 = ((w0 >> 16U) & 0xFFU).to_int64().to_uint64()
  let r3c0 = ((w0 >> 24U) & 0xFFU).to_int64().to_uint64()

  let r0c1 = (w1 & 0xFFU).to_int64().to_uint64()
  let r1c1 = ((w1 >> 8U) & 0xFFU).to_int64().to_uint64()
  let r2c1 = ((w1 >> 16U) & 0xFFU).to_int64().to_uint64()
  let r3c1 = ((w1 >> 24U) & 0xFFU).to_int64().to_uint64()

  let r0c2 = (w2 & 0xFFU).to_int64().to_uint64()
  let r1c2 = ((w2 >> 8U) & 0xFFU).to_int64().to_uint64()
  let r2c2 = ((w2 >> 16U) & 0xFFU).to_int64().to_uint64()
  let r3c2 = ((w2 >> 24U) & 0xFFU).to_int64().to_uint64()

  let r0c3 = (w3 & 0xFFU).to_int64().to_uint64()
  let r1c3 = ((w3 >> 8U) & 0xFFU).to_int64().to_uint64()
  let r2c3 = ((w3 >> 16U) & 0xFFU).to_int64().to_uint64()
  let r3c3 = ((w3 >> 24U) & 0xFFU).to_int64().to_uint64()

  let even_cols = r0c0 | (r0c2 << 8UL) | (r1c0 << 16UL) | (r1c2 << 24UL) |
  (r2c0 << 32UL) | (r2c2 << 40UL) | (r3c0 << 48UL) | (r3c2 << 56UL)
  let odd_cols = r0c1 | (r0c3 << 8UL) | (r1c1 << 16UL) | (r1c3 << 24UL) |
  (r2c1 << 32UL) | (r2c3 << 40UL) | (r3c1 << 48UL) | (r3c3 << 56UL)

  q[0] = even_cols
  q[1] = even_cols
  q[2] = even_cols
  q[3] = even_cols
  q[4] = odd_cols
  q[5] = odd_cols
  q[6] = odd_cols
  q[7] = odd_cols
  aes_transpose_8x8(q)
  out[base] = q[0]
  out[base + 1] = q[1]
  out[base + 2] = q[2]
  out[base + 3] = q[3]
  out[base + 4] = q[4]
  out[base + 5] = q[5]
  out[base + 6] = q[6]
  out[base + 7] = q[7]
}

///| Expand a 16-byte (AES-128) or 32-byte (AES-256) key into bitsliced round keys.
fn aes_key_expand(key : Bytes) -> AesKeySchedule {
  let nk = key.length() / 4
  let rounds = nk + 6
  let total_words = (rounds + 1) * 4
  let w = FixedArray::make(total_words, 0U)
  let q = FixedArray::make(8, 0UL)
  let mut i = 0
  while i < nk {
    w[i] = aes_load32_le(key, i * 4)
    i = i + 1
  }
  let mut rcon = 1U
  while i < total_words {
    let mut temp = w[i - 1]
    if i % nk == 0 {
      temp = aes_sub_word_ct(aes_rotr8_u32(temp), q) ^ rcon
      let hi = (rcon >> 7U) & 1U
      rcon = ((rcon << 1U) ^ (hi * 0x1BU)) & 0xFFU
    } else if nk == 8 && i % nk == 4 {
      temp = aes_sub_word_ct(temp, q)
    }
    w[i] = w[i - nk] ^ temp
    i = i + 1
  }
  let rk = FixedArray::make((rounds + 1) * 8, 0UL)
  let mut r = 0
  while r <= rounds {
    aes_pack_round_key(w[r * 4], w[r * 4 + 1], w[r * 4 + 2], w[r * 4 + 3], rk, r * 8, q)
    r = r + 1
  }
  AesKeySchedule::{ rounds: rounds, rk: rk }
}

///| Encrypt 4 16-byte blocks in `buf[0..64]` in place using caller scratch `q[0..7]`.
fn aes_encrypt_4blocks_q(
  ks : AesKeySchedule,
  buf : FixedArray[Byte],
  q : FixedArray[UInt64],
) -> Unit {
  let mut i = 0
  while i < 8 {
    let blk_off = (i & 3) * 16
    let c0 = ((i >> 2) & 1) * 4
    let c2 = c0 + 8
    let b0 = (buf[blk_off + c0].to_int() & 0xFF).to_int64().to_uint64()
    let b1 = (buf[blk_off + c2].to_int() & 0xFF).to_int64().to_uint64()
    let b2 = (buf[blk_off + c0 + 1].to_int() & 0xFF).to_int64().to_uint64()
    let b3 = (buf[blk_off + c2 + 1].to_int() & 0xFF).to_int64().to_uint64()
    let b4 = (buf[blk_off + c0 + 2].to_int() & 0xFF).to_int64().to_uint64()
    let b5 = (buf[blk_off + c2 + 2].to_int() & 0xFF).to_int64().to_uint64()
    let b6 = (buf[blk_off + c0 + 3].to_int() & 0xFF).to_int64().to_uint64()
    let b7 = (buf[blk_off + c2 + 3].to_int() & 0xFF).to_int64().to_uint64()
    q[i] = b0 | (b1 << 8UL) | (b2 << 16UL) | (b3 << 24UL) |
    (b4 << 32UL) | (b5 << 40UL) | (b6 << 48UL) | (b7 << 56UL)
    i = i + 1
  }

  aes_transpose_8x8(q)

  // Initial AddRoundKey
  let rk = ks.rk
  q[0] = q[0] ^ rk[0]
  q[1] = q[1] ^ rk[1]
  q[2] = q[2] ^ rk[2]
  q[3] = q[3] ^ rk[3]
  q[4] = q[4] ^ rk[4]
  q[5] = q[5] ^ rk[5]
  q[6] = q[6] ^ rk[6]
  q[7] = q[7] ^ rk[7]

  // Rounds 1 .. rounds - 1
  let mut r = 1
  while r < ks.rounds {
    aes_bitslice_sbox(q)
    aes_bitslice_shift_rows(q)
    aes_bitslice_mix_columns(q)
    let base = r * 8
    q[0] = q[0] ^ rk[base]
    q[1] = q[1] ^ rk[base + 1]
    q[2] = q[2] ^ rk[base + 2]
    q[3] = q[3] ^ rk[base + 3]
    q[4] = q[4] ^ rk[base + 4]
    q[5] = q[5] ^ rk[base + 5]
    q[6] = q[6] ^ rk[base + 6]
    q[7] = q[7] ^ rk[base + 7]
    r = r + 1
  }

  // Final round (no MixColumns)
  aes_bitslice_sbox(q)
  aes_bitslice_shift_rows(q)
  let last_base = ks.rounds * 8
  q[0] = q[0] ^ rk[last_base]
  q[1] = q[1] ^ rk[last_base + 1]
  q[2] = q[2] ^ rk[last_base + 2]
  q[3] = q[3] ^ rk[last_base + 3]
  q[4] = q[4] ^ rk[last_base + 4]
  q[5] = q[5] ^ rk[last_base + 5]
  q[6] = q[6] ^ rk[last_base + 6]
  q[7] = q[7] ^ rk[last_base + 7]

  aes_transpose_8x8(q)

  // Unpack q[0..7] back into buf[0..64]
  i = 0
  while i < 8 {
    let blk_off = (i & 3) * 16
    let c0 = ((i >> 2) & 1) * 4
    let c2 = c0 + 8
    let word = q[i]
    buf[blk_off + c0] = (word & 0xFFUL).to_int().to_byte()
    buf[blk_off + c2] = ((word >> 8UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c0 + 1] = ((word >> 16UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c2 + 1] = ((word >> 24UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c0 + 2] = ((word >> 32UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c2 + 2] = ((word >> 40UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c0 + 3] = ((word >> 48UL) & 0xFFUL).to_int().to_byte()
    buf[blk_off + c2 + 3] = ((word >> 56UL) & 0xFFUL).to_int().to_byte()
    i = i + 1
  }
}

///| Encrypt 4 16-byte blocks in `buf[0..64]` in place (constant-time bitsliced AES).
fn aes_encrypt_4blocks(ks : AesKeySchedule, buf : FixedArray[Byte]) -> Unit {
  let q = FixedArray::make(8, 0UL)
  aes_encrypt_4blocks_q(ks, buf, q)
}

///| Encrypt a single 16-byte block `src[0..16]` into `dst[0..16]`.
fn aes_encrypt_block(ks : AesKeySchedule, src : FixedArray[Byte], dst : FixedArray[Byte]) -> Unit {
  let buf = FixedArray::make(64, (0).to_byte())
  let mut i = 0
  while i < 16 {
    buf[i] = src[i]
    i = i + 1
  }
  aes_encrypt_4blocks(ks, buf)
  i = 0
  while i < 16 {
    dst[i] = buf[i]
    i = i + 1
  }
}

// ── Constant-Time Carry-Less GHASH over GF(2^128) ──

///| Reverse all 64 bits of `x` (branch-free SWAR).
fn ghash_rev64(x : UInt64) -> UInt64 {
  let mut v = ((x >> 1UL) & 0x5555555555555555UL) | ((x & 0x5555555555555555UL) << 1UL)
  v = ((v >> 2UL) & 0x3333333333333333UL) | ((v & 0x3333333333333333UL) << 2UL)
  v = ((v >> 4UL) & 0x0F0F0F0F0F0F0F0FUL) | ((v & 0x0F0F0F0F0F0F0F0FUL) << 4UL)
  v = ((v >> 8UL) & 0x00FF00FF00FF00FFUL) | ((v & 0x00FF00FF00FF00FFUL) << 8UL)
  v = ((v >> 16UL) & 0x0000FFFF0000FFFFUL) | ((v & 0x0000FFFF0000FFFFUL) << 16UL)
  (v >> 32UL) | (v << 32UL)
}

///|
fn ghash_load64_be_arr(b : FixedArray[Byte], off : Int) -> UInt64 {
  ((b[off].to_int() & 0xFF).to_int64().to_uint64() << 56UL) |
  ((b[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 48UL) |
  ((b[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 40UL) |
  ((b[off + 3].to_int() & 0xFF).to_int64().to_uint64() << 32UL) |
  ((b[off + 4].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((b[off + 5].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((b[off + 6].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (b[off + 7].to_int() & 0xFF).to_int64().to_uint64()
}

///|
fn ghash_load64_be_bytes(b : Bytes, off : Int) -> UInt64 {
  ((b[off].to_int() & 0xFF).to_int64().to_uint64() << 56UL) |
  ((b[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 48UL) |
  ((b[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 40UL) |
  ((b[off + 3].to_int() & 0xFF).to_int64().to_uint64() << 32UL) |
  ((b[off + 4].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((b[off + 5].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((b[off + 6].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (b[off + 7].to_int() & 0xFF).to_int64().to_uint64()
}

///|
fn ghash_store64_be_arr(out : FixedArray[Byte], off : Int, v : UInt64) -> Unit {
  out[off] = ((v >> 56UL) & 0xFFUL).to_int().to_byte()
  out[off + 1] = ((v >> 48UL) & 0xFFUL).to_int().to_byte()
  out[off + 2] = ((v >> 40UL) & 0xFFUL).to_int().to_byte()
  out[off + 3] = ((v >> 32UL) & 0xFFUL).to_int().to_byte()
  out[off + 4] = ((v >> 24UL) & 0xFFUL).to_int().to_byte()
  out[off + 5] = ((v >> 16UL) & 0xFFUL).to_int().to_byte()
  out[off + 6] = ((v >> 8UL) & 0xFFUL).to_int().to_byte()
  out[off + 7] = (v & 0xFFUL).to_int().to_byte()
}

///| Branch-free 32x32 -> 64-bit carry-less multiplication (BearSSL `bmul`).
fn ghash_bmul32(x : UInt64, y : UInt64) -> UInt64 {
  let x0 = x & 0x11111111UL
  let x1 = x & 0x22222222UL
  let x2 = x & 0x44444444UL
  let x3 = x & 0x88888888UL
  let y0 = y & 0x11111111UL
  let y1 = y & 0x22222222UL
  let y2 = y & 0x44444444UL
  let y3 = y & 0x88888888UL

  let z0 = ((x0 * y0) ^ (x1 * y3) ^ (x2 * y2) ^ (x3 * y1)) & 0x1111111111111111UL
  let z1 = ((x0 * y1) ^ (x1 * y0) ^ (x2 * y3) ^ (x3 * y2)) & 0x2222222222222222UL
  let z2 = ((x0 * y2) ^ (x1 * y1) ^ (x2 * y0) ^ (x3 * y3)) & 0x4444444444444444UL
  let z3 = ((x0 * y3) ^ (x1 * y2) ^ (x2 * y1) ^ (x3 * y0)) & 0x8888888888888888UL
  z0 | z1 | z2 | z3
}

///|
struct GhashState {
  h0 : UInt64
  h1 : UInt64
  mut y0 : UInt64
  mut y1 : UInt64
}

///|
fn ghash_init(h_bytes : FixedArray[Byte]) -> GhashState {
  let h0 = ghash_rev64(ghash_load64_be_arr(h_bytes, 0))
  let h1 = ghash_rev64(ghash_load64_be_arr(h_bytes, 8))
  GhashState::{ h0: h0, h1: h1, y0: 0UL, y1: 0UL }
}

///| Update GHASH state in-place with zero heap allocations (inlined Karatsuba GF(2^128) multiply).
fn ghash_update_block_be(st : GhashState, hi_be : UInt64, lo_be : UInt64) -> Unit {
  let x0 = st.y0 ^ ghash_rev64(hi_be)
  let x1 = st.y1 ^ ghash_rev64(lo_be)
  let h0 = st.h0
  let h1 = st.h1

  // l = bmul64(x0, h0)
  let a0 = x0 & 0xFFFFFFFFUL; let a1 = x0 >> 32UL
  let b0 = h0 & 0xFFFFFFFFUL; let b1 = h0 >> 32UL
  let p0 = ghash_bmul32(a0, b0)
  let p1 = ghash_bmul32(a1, b1)
  let pm = ghash_bmul32(a0 ^ a1, b0 ^ b1) ^ p0 ^ p1
  let l0 = p0 ^ (pm << 32UL)
  let l1 = p1 ^ (pm >> 32UL)

  // u = bmul64(x1, h1)
  let c0 = x1 & 0xFFFFFFFFUL; let c1 = x1 >> 32UL
  let d0 = h1 & 0xFFFFFFFFUL; let d1 = h1 >> 32UL
  let q0 = ghash_bmul32(c0, d0)
  let q1 = ghash_bmul32(c1, d1)
  let qm = ghash_bmul32(c0 ^ c1, d0 ^ d1) ^ q0 ^ q1
  let u0 = q0 ^ (qm << 32UL)
  let u1 = q1 ^ (qm >> 32UL)

  // m = bmul64(x0 ^ x1, h0 ^ h1)
  let xm = x0 ^ x1
  let hm = h0 ^ h1
  let e0 = xm & 0xFFFFFFFFUL; let e1 = xm >> 32UL
  let f0 = hm & 0xFFFFFFFFUL; let f1 = hm >> 32UL
  let r0 = ghash_bmul32(e0, f0)
  let r1 = ghash_bmul32(e1, f1)
  let rm = ghash_bmul32(e0 ^ e1, f0 ^ f1) ^ r0 ^ r1
  let mid0 = (r0 ^ (rm << 32UL)) ^ l0 ^ u0
  let mid1 = (r1 ^ (rm >> 32UL)) ^ l1 ^ u1

  let mut z0 = l0
  let mut z1 = l1 ^ mid0
  let mut z2 = u0 ^ mid1
  let z3 = u1

  z2 = z2 ^ (z3 >> 63UL) ^ (z3 >> 62UL) ^ (z3 >> 57UL)
  z1 = z1 ^ z3 ^ (z3 << 1UL) ^ (z3 << 2UL) ^ (z3 << 7UL)
  z1 = z1 ^ (z2 >> 63UL) ^ (z2 >> 62UL) ^ (z2 >> 57UL)
  z0 = z0 ^ z2 ^ (z2 << 1UL) ^ (z2 << 2UL) ^ (z2 << 7UL)
  st.y0 = z0
  st.y1 = z1
}

///| Update GHASH with `data[start..start+len]`, zero-padding the final partial 16-byte block.
fn ghash_update_padded(st : GhashState, data : Bytes, start : Int, len : Int) -> Unit {
  let mut off = start
  let end = start + len
  let h0 = st.h0
  let h1 = st.h1
  let hm = h0 ^ h1
  let b0 = h0 & 0xFFFFFFFFUL; let b1 = h0 >> 32UL; let bm = b0 ^ b1
  let d0 = h1 & 0xFFFFFFFFUL; let d1 = h1 >> 32UL; let dm = d0 ^ d1
  let f0 = hm & 0xFFFFFFFFUL; let f1 = hm >> 32UL; let fm = f0 ^ f1
  let mut y0 = st.y0
  let mut y1 = st.y1
  while off + 16 <= end {
    let hi_be = ((data[off].to_int() & 0xFF).to_int64().to_uint64() << 56UL) |
    ((data[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 48UL) |
    ((data[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 40UL) |
    ((data[off + 3].to_int() & 0xFF).to_int64().to_uint64() << 32UL) |
    ((data[off + 4].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
    ((data[off + 5].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
    ((data[off + 6].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
    (data[off + 7].to_int() & 0xFF).to_int64().to_uint64()
    let lo_be = ((data[off + 8].to_int() & 0xFF).to_int64().to_uint64() << 56UL) |
    ((data[off + 9].to_int() & 0xFF).to_int64().to_uint64() << 48UL) |
    ((data[off + 10].to_int() & 0xFF).to_int64().to_uint64() << 40UL) |
    ((data[off + 11].to_int() & 0xFF).to_int64().to_uint64() << 32UL) |
    ((data[off + 12].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
    ((data[off + 13].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
    ((data[off + 14].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
    (data[off + 15].to_int() & 0xFF).to_int64().to_uint64()
    let x0 = y0 ^ ghash_rev64(hi_be)
    let x1 = y1 ^ ghash_rev64(lo_be)

    let a0 = x0 & 0xFFFFFFFFUL; let a1 = x0 >> 32UL
    let p0 = ghash_bmul32(a0, b0)
    let p1 = ghash_bmul32(a1, b1)
    let pm = ghash_bmul32(a0 ^ a1, bm) ^ p0 ^ p1
    let l0 = p0 ^ (pm << 32UL)
    let l1 = p1 ^ (pm >> 32UL)

    let c0 = x1 & 0xFFFFFFFFUL; let c1 = x1 >> 32UL
    let q0 = ghash_bmul32(c0, d0)
    let q1 = ghash_bmul32(c1, d1)
    let qm = ghash_bmul32(c0 ^ c1, dm) ^ q0 ^ q1
    let u0 = q0 ^ (qm << 32UL)
    let u1 = q1 ^ (qm >> 32UL)

    let xm = x0 ^ x1
    let e0 = xm & 0xFFFFFFFFUL; let e1 = xm >> 32UL
    let r0 = ghash_bmul32(e0, f0)
    let r1 = ghash_bmul32(e1, f1)
    let rm = ghash_bmul32(e0 ^ e1, fm) ^ r0 ^ r1
    let mid0 = (r0 ^ (rm << 32UL)) ^ l0 ^ u0
    let mid1 = (r1 ^ (rm >> 32UL)) ^ l1 ^ u1

    let mut z0 = l0
    let mut z1 = l1 ^ mid0
    let mut z2 = u0 ^ mid1
    let z3 = u1

    z2 = z2 ^ (z3 >> 63UL) ^ (z3 >> 62UL) ^ (z3 >> 57UL)
    z1 = z1 ^ z3 ^ (z3 << 1UL) ^ (z3 << 2UL) ^ (z3 << 7UL)
    z1 = z1 ^ (z2 >> 63UL) ^ (z2 >> 62UL) ^ (z2 >> 57UL)
    z0 = z0 ^ z2 ^ (z2 << 1UL) ^ (z2 << 2UL) ^ (z2 << 7UL)
    y0 = z0
    y1 = z1
    off = off + 16
  }
  st.y0 = y0
  st.y1 = y1
  if off < end {
    let tmp = FixedArray::make(16, (0).to_byte())
    let mut i = 0
    while off + i < end {
      tmp[i] = data[off + i]
      i = i + 1
    }
    let hi = ghash_load64_be_arr(tmp, 0)
    let lo = ghash_load64_be_arr(tmp, 8)
    ghash_update_block_be(st, hi, lo)
  }
}

///|
fn ghash_finalize_arr(st : GhashState, out : FixedArray[Byte]) -> Unit {
  ghash_store64_be_arr(out, 0, ghash_rev64(st.y0))
  ghash_store64_be_arr(out, 8, ghash_rev64(st.y1))
}

// ── AES-GCM Core (NIST SP 800-38D) ──

///| Increment the 32-bit big-endian counter in `ctr[12..16]` (mod 2^32).
fn gcm_inc32(ctr : FixedArray[Byte]) -> Unit {
  let mut c = 1
  let mut i = 15
  while i >= 12 {
    let s = (ctr[i].to_int() & 0xFF) + c
    ctr[i] = (s & 0xFF).to_byte()
    c = s >> 8
    i = i - 1
  }
}

///| Compute initial counter block `J_0` per NIST SP 800-38D §7.1.
fn gcm_derive_j0(h_bytes : FixedArray[Byte], nonce : Bytes) -> FixedArray[Byte] {
  let j0 = FixedArray::make(16, (0).to_byte())
  let nlen = nonce.length()
  if nlen == 12 {
    let mut i = 0
    while i < 12 {
      j0[i] = nonce[i]
      i = i + 1
    }
    j0[15] = (1).to_byte()
    return j0
  }
  let st = ghash_init(h_bytes)
  ghash_update_padded(st, nonce, 0, nlen)
  let bit_len = nlen.to_int64().to_uint64() * 8UL
  ghash_update_block_be(st, 0UL, bit_len)
  ghash_finalize_arr(st, j0)
  j0
}

///| GCTR XOR `src[src_off..src_off+len]` into `dst[dst_off..dst_off+len]` using 4-block parallel AES.
fn gcm_gctr(
  ks : AesKeySchedule,
  j0 : FixedArray[Byte],
  src : Bytes,
  src_off : Int,
  len : Int,
  dst : Bytes,
  dst_off : Int,
) -> Unit {
  if len <= 0 {
    return ()
  }
  let ctr = FixedArray::make(16, (0).to_byte())
  let mut i = 0
  while i < 16 {
    ctr[i] = j0[i]
    i = i + 1
  }
  let buf = FixedArray::make(64, (0).to_byte())
  let q = FixedArray::make(8, 0UL)
  let mut out = dst
  let mut off = 0
  while off < len {
    let rem = len - off
    let blocks = if rem >= 64 {
      4
    } else {
      (rem + 15) / 16
    }
    let mut b = 0
    while b < blocks {
      gcm_inc32(ctr)
      let base = b * 16
      i = 0
      while i < 16 {
        buf[base + i] = ctr[i]
        i = i + 1
      }
      b = b + 1
    }
    aes_encrypt_4blocks_q(ks, buf, q)
    let take = if rem < 64 { rem } else { 64 }
    i = 0
    while i < take {
      out[dst_off + off + i] = (
        (src[src_off + off + i].to_int() & 0xFF) ^ (buf[i].to_int() & 0xFF)
      ).to_byte()
      i = i + 1
    }
    off = off + take
  }
}

///| Compute the 16-byte GCM authentication tag over `aad` and `ct[ct_off..ct_off+ct_len]`.
fn gcm_compute_tag(
  ks : AesKeySchedule,
  h_bytes : FixedArray[Byte],
  j0 : FixedArray[Byte],
  aad : Bytes,
  ct : Bytes,
  ct_off : Int,
  ct_len : Int,
) -> Bytes {
  let st = ghash_init(h_bytes)
  ghash_update_padded(st, aad, 0, aad.length())
  ghash_update_padded(st, ct, ct_off, ct_len)
  let aad_bits = aad.length().to_int64().to_uint64() * 8UL
  let ct_bits = ct_len.to_int64().to_uint64() * 8UL
  ghash_update_block_be(st, aad_bits, ct_bits)
  let s_block = FixedArray::make(16, (0).to_byte())
  ghash_finalize_arr(st, s_block)

  let mask = FixedArray::make(16, (0).to_byte())
  aes_encrypt_block(ks, j0, mask)
  let mut tag = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    tag[i] = ((s_block[i].to_int() & 0xFF) ^ (mask[i].to_int() & 0xFF)).to_byte()
    i = i + 1
  }
  tag
}

///|
fn aes_gcm_seal_inner(
  key : Bytes,
  expected_key_len : Int,
  nonce : Bytes,
  aad : Bytes,
  plaintext : Bytes,
) -> Result[Bytes, CryptoError] {
  if key.length() != expected_key_len {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  if nonce.length() == 0 {
    return Err(CryptoError::InvalidNonceLength(0))
  }
  let ks = aes_key_expand(key)
  let zero = FixedArray::make(16, (0).to_byte())
  let h_bytes = FixedArray::make(16, (0).to_byte())
  aes_encrypt_block(ks, zero, h_bytes)
  let j0 = gcm_derive_j0(h_bytes, nonce)

  let pt_len = plaintext.length()
  let mut out = Bytes::new(pt_len + 16)
  gcm_gctr(ks, j0, plaintext, 0, pt_len, out, 0)
  let tag = gcm_compute_tag(ks, h_bytes, j0, aad, out, 0, pt_len)
  let mut i = 0
  while i < 16 {
    out[pt_len + i] = tag[i]
    i = i + 1
  }
  Ok(out)
}

///|
fn aes_gcm_open_inner(
  key : Bytes,
  expected_key_len : Int,
  nonce : Bytes,
  aad : Bytes,
  ciphertext_and_tag : Bytes,
) -> Result[Bytes, CryptoError] {
  if key.length() != expected_key_len {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  if nonce.length() == 0 {
    return Err(CryptoError::InvalidNonceLength(0))
  }
  let total = ciphertext_and_tag.length()
  if total < 16 {
    return Err(CryptoError::InvalidLength(total))
  }
  let ct_len = total - 16
  let ks = aes_key_expand(key)
  let zero = FixedArray::make(16, (0).to_byte())
  let h_bytes = FixedArray::make(16, (0).to_byte())
  aes_encrypt_block(ks, zero, h_bytes)
  let j0 = gcm_derive_j0(h_bytes, nonce)

  // Verify tag in constant time BEFORE decrypting; never leak plaintext on failure.
  let computed_tag = gcm_compute_tag(ks, h_bytes, j0, aad, ciphertext_and_tag, 0, ct_len)
  let mut expected_tag = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    expected_tag[i] = ciphertext_and_tag[ct_len + i]
    i = i + 1
  }
  if !constant_time_eq(computed_tag, expected_tag) {
    return Err(CryptoError::AuthenticationFailed)
  }
  let out = Bytes::new(ct_len)
  gcm_gctr(ks, j0, ciphertext_and_tag, 0, ct_len, out, 0)
  Ok(out)
}

///| Seal `plaintext` with AES-128-GCM (`key = 16B`, non-empty `nonce`), returning `ciphertext || tag(16B)`.
pub fn aes128_gcm_seal(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  plaintext : Bytes,
) -> Result[Bytes, CryptoError] {
  aes_gcm_seal_inner(key, 16, nonce, aad, plaintext)
}

///| Open `ciphertext_and_tag` with AES-128-GCM (`key = 16B`, non-empty `nonce`).
///| Verifies the 16-byte authentication tag in constant time before decrypting.
pub fn aes128_gcm_open(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  ciphertext_and_tag : Bytes,
) -> Result[Bytes, CryptoError] {
  aes_gcm_open_inner(key, 16, nonce, aad, ciphertext_and_tag)
}

///| Seal `plaintext` with AES-256-GCM (`key = 32B`, non-empty `nonce`), returning `ciphertext || tag(16B)`.
pub fn aes256_gcm_seal(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  plaintext : Bytes,
) -> Result[Bytes, CryptoError] {
  aes_gcm_seal_inner(key, 32, nonce, aad, plaintext)
}

///| Open `ciphertext_and_tag` with AES-256-GCM (`key = 32B`, non-empty `nonce`).
///| Verifies the 16-byte authentication tag in constant time before decrypting.
pub fn aes256_gcm_open(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  ciphertext_and_tag : Bytes,
) -> Result[Bytes, CryptoError] {
  aes_gcm_open_inner(key, 32, nonce, aad, ciphertext_and_tag)
}
