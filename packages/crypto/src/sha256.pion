///| FIPS 180-4 SHA-256 streaming and one-shot hasher (pure Pion, zero World dependencies).
///| Optimized with 8-way register-unrolled compression and hoisted FixedArray LUT.

///|
let sha256_k : FixedArray[UInt] = [
  0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U, 0x3956c25bU, 0x59f111f1U, 0x923f82a4U,
  0xab1c5ed5U, 0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U, 0x72be5d74U, 0x80deb1feU,
  0x9bdc06a7U, 0xc19bf174U, 0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU, 0x2de92c6fU,
  0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU, 0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U,
  0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U, 0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU,
  0x53380d13U, 0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U, 0xa2bfe8a1U, 0xa81a664bU,
  0xc24b8b70U, 0xc76c51a3U, 0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U, 0x19a4c116U,
  0x1e376c08U, 0x2748774cU, 0x34b0bcb5U, 0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
  0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U, 0x90befffaU, 0xa4506cebU, 0xbef9a3f7U,
  0xc67178f2U,
]

///|
fn sha256_compress_w(state : FixedArray[UInt], w : FixedArray[UInt]) -> Unit {
  let k = sha256_k
  let mut i = 16
  while i < 64 {
    let w15 = w[i - 15]
    let s0 = ((w15 >> 7U) | (w15 << 25U)) ^ ((w15 >> 18U) | (w15 << 14U)) ^ (w15 >> 3U)
    let w2 = w[i - 2]
    let s1 = ((w2 >> 17U) | (w2 << 15U)) ^ ((w2 >> 19U) | (w2 << 13U)) ^ (w2 >> 10U)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]

  let mut r = 0
  while r < 64 {
    // Round r + 0
    let t1_0 = h + (((e >> 6U) | (e << 26U)) ^ ((e >> 11U) | (e << 21U)) ^ ((e >> 25U) | (e << 7U))) + ((e & f) ^ ((e ^ 0xFFFFFFFFU) & g)) + k[r] + w[r]
    let t2_0 = (((a >> 2U) | (a << 30U)) ^ ((a >> 13U) | (a << 19U)) ^ ((a >> 22U) | (a << 10U))) + ((a & b) ^ (a & c) ^ (b & c))
    d = d + t1_0
    h = t1_0 + t2_0
    // Round r + 1
    let t1_1 = g + (((d >> 6U) | (d << 26U)) ^ ((d >> 11U) | (d << 21U)) ^ ((d >> 25U) | (d << 7U))) + ((d & e) ^ ((d ^ 0xFFFFFFFFU) & f)) + k[r + 1] + w[r + 1]
    let t2_1 = (((h >> 2U) | (h << 30U)) ^ ((h >> 13U) | (h << 19U)) ^ ((h >> 22U) | (h << 10U))) + ((h & a) ^ (h & b) ^ (a & b))
    c = c + t1_1
    g = t1_1 + t2_1
    // Round r + 2
    let t1_2 = f + (((c >> 6U) | (c << 26U)) ^ ((c >> 11U) | (c << 21U)) ^ ((c >> 25U) | (c << 7U))) + ((c & d) ^ ((c ^ 0xFFFFFFFFU) & e)) + k[r + 2] + w[r + 2]
    let t2_2 = (((g >> 2U) | (g << 30U)) ^ ((g >> 13U) | (g << 19U)) ^ ((g >> 22U) | (g << 10U))) + ((g & h) ^ (g & a) ^ (h & a))
    b = b + t1_2
    f = t1_2 + t2_2
    // Round r + 3
    let t1_3 = e + (((b >> 6U) | (b << 26U)) ^ ((b >> 11U) | (b << 21U)) ^ ((b >> 25U) | (b << 7U))) + ((b & c) ^ ((b ^ 0xFFFFFFFFU) & d)) + k[r + 3] + w[r + 3]
    let t2_3 = (((f >> 2U) | (f << 30U)) ^ ((f >> 13U) | (f << 19U)) ^ ((f >> 22U) | (f << 10U))) + ((f & g) ^ (f & h) ^ (g & h))
    a = a + t1_3
    e = t1_3 + t2_3
    // Round r + 4
    let t1_4 = d + (((a >> 6U) | (a << 26U)) ^ ((a >> 11U) | (a << 21U)) ^ ((a >> 25U) | (a << 7U))) + ((a & b) ^ ((a ^ 0xFFFFFFFFU) & c)) + k[r + 4] + w[r + 4]
    let t2_4 = (((e >> 2U) | (e << 30U)) ^ ((e >> 13U) | (e << 19U)) ^ ((e >> 22U) | (e << 10U))) + ((e & f) ^ (e & g) ^ (f & g))
    h = h + t1_4
    d = t1_4 + t2_4
    // Round r + 5
    let t1_5 = c + (((h >> 6U) | (h << 26U)) ^ ((h >> 11U) | (h << 21U)) ^ ((h >> 25U) | (h << 7U))) + ((h & a) ^ ((h ^ 0xFFFFFFFFU) & b)) + k[r + 5] + w[r + 5]
    let t2_5 = (((d >> 2U) | (d << 30U)) ^ ((d >> 13U) | (d << 19U)) ^ ((d >> 22U) | (d << 10U))) + ((d & e) ^ (d & f) ^ (e & f))
    g = g + t1_5
    c = t1_5 + t2_5
    // Round r + 6
    let t1_6 = b + (((g >> 6U) | (g << 26U)) ^ ((g >> 11U) | (g << 21U)) ^ ((g >> 25U) | (g << 7U))) + ((g & h) ^ ((g ^ 0xFFFFFFFFU) & a)) + k[r + 6] + w[r + 6]
    let t2_6 = (((c >> 2U) | (c << 30U)) ^ ((c >> 13U) | (c << 19U)) ^ ((c >> 22U) | (c << 10U))) + ((c & d) ^ (c & e) ^ (d & e))
    f = f + t1_6
    b = t1_6 + t2_6
    // Round r + 7
    let t1_7 = a + (((f >> 6U) | (f << 26U)) ^ ((f >> 11U) | (f << 21U)) ^ ((f >> 25U) | (f << 7U))) + ((f & g) ^ ((f ^ 0xFFFFFFFFU) & h)) + k[r + 7] + w[r + 7]
    let t2_7 = (((b >> 2U) | (b << 30U)) ^ ((b >> 13U) | (b << 19U)) ^ ((b >> 22U) | (b << 10U))) + ((b & c) ^ (b & d) ^ (c & d))
    e = e + t1_7
    a = t1_7 + t2_7

    r = r + 8
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + h
}

///|
fn sha256_load_block(buf : Bytes, off : Int, w : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + (i << 2)
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[i] = (b0 << 24U) | (b1 << 16U) | (b2 << 8U) | b3
    i = i + 1
  }
}

///|
fn sha256_load_block_arr(buf : FixedArray[Int], w : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = i << 2
    w[i] = (buf[p].to_uint() << 24U) |
    (buf[p + 1].to_uint() << 16U) |
    (buf[p + 2].to_uint() << 8U) |
    buf[p + 3].to_uint()
    i = i + 1
  }
}

///|
fn sha256_update_final_state(
  state : FixedArray[UInt],
  data : Bytes,
  start : Int,
  len : Int,
  total_bytes : Int64,
  w : FixedArray[UInt],
) -> Unit {
  let mut off = start
  let end = start + len
  while off + 64 <= end {
    sha256_load_block(data, off, w)
    sha256_compress_w(state, w)
    off = off + 64
  }

  let rem = end - off
  let mut i = 0
  while i < 16 {
    w[i] = 0U
    i = i + 1
  }
  let mut j = 0
  while j < rem {
    let shift : UInt = (24 - ((j & 3) << 3)).to_uint()
    w[j >> 2] = w[j >> 2] | (data[off + j].to_int().to_uint() << shift)
    j = j + 1
  }
  let pad_shift : UInt = (24 - ((rem & 3) << 3)).to_uint()
  w[rem >> 2] = w[rem >> 2] | (0x80U << pad_shift)

  let bit_len : UInt64 = total_bytes.to_uint64() << 3
  if rem >= 56 {
    sha256_compress_w(state, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0U
      k = k + 1
    }
  }
  w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
  sha256_compress_w(state, w)
}

///|
fn sha256_state_to_bytes(state : FixedArray[UInt]) -> Bytes {
  let mut digest = Bytes::new(32)
  let mut wi = 0
  while wi < 8 {
    let v = state[wi]
    let p = wi << 2
    digest[p] = ((v >> 24U) & 0xFFU).to_int().to_byte()
    digest[p + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
    digest[p + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
    digest[p + 3] = (v & 0xFFU).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///|
pub struct Sha256 {
  state : FixedArray[UInt]
  buf : FixedArray[Int]
  w : FixedArray[UInt]
  mut fill : Int
  mut total : Int64
}

///|
pub fn Sha256::new() -> Sha256 {
  Sha256::{
    state: [
      0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
      0x5be0cd19U,
    ],
    buf: FixedArray::make(64, 0),
    w: FixedArray::make(64, 0U),
    fill: 0,
    total: 0L,
  }
}

///|
pub fn Sha256::reset(self : Sha256) -> Unit {
  self.state[0] = 0x6a09e667U
  self.state[1] = 0xbb67ae85U
  self.state[2] = 0x3c6ef372U
  self.state[3] = 0xa54ff53aU
  self.state[4] = 0x510e527fU
  self.state[5] = 0x9b05688cU
  self.state[6] = 0x1f83d9abU
  self.state[7] = 0x5be0cd19U
  self.fill = 0
  self.total = 0L
}

///|
pub fn Sha256::update_slice(self : Sha256, data : Bytes, start : Int, end : Int) -> Unit {
  let n = data.length()
  let mut pos = if start < 0 { 0 } else { start }
  let lim = if end > n { n } else { end }
  if pos >= lim {
    return
  }
  self.total = self.total + (lim - pos).to_int64()

  if self.fill > 0 {
    while pos < lim && self.fill < 64 {
      self.buf[self.fill] = data[pos].to_int()
      self.fill = self.fill + 1
      pos = pos + 1
    }
    if self.fill == 64 {
      sha256_load_block_arr(self.buf, self.w)
      sha256_compress_w(self.state, self.w)
      self.fill = 0
    }
  }

  while pos + 64 <= lim {
    sha256_load_block(data, pos, self.w)
    sha256_compress_w(self.state, self.w)
    pos = pos + 64
  }

  while pos < lim {
    self.buf[self.fill] = data[pos].to_int()
    self.fill = self.fill + 1
    pos = pos + 1
  }
}

///|
pub fn Sha256::update(self : Sha256, data : Bytes) -> Unit {
  self.update_slice(data, 0, data.length())
}

///|
fn sha256_finalize_into(self : Sha256, out_state : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 8 {
    out_state[i] = self.state[i]
    i = i + 1
  }
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let rem = self.fill
  let mut j = 0
  while j < rem {
    let shift : UInt = (24 - ((j & 3) << 3)).to_uint()
    w[j >> 2] = w[j >> 2] | (self.buf[j].to_uint() << shift)
    j = j + 1
  }
  let pad_shift : UInt = (24 - ((rem & 3) << 3)).to_uint()
  w[rem >> 2] = w[rem >> 2] | (0x80U << pad_shift)

  let bit_len : UInt64 = self.total.to_uint64() << 3
  if rem >= 56 {
    sha256_compress_w(out_state, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0U
      k = k + 1
    }
  }
  w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
  sha256_compress_w(out_state, w)
}

///|
pub fn Sha256::finalize(self : Sha256) -> Bytes {
  let st : FixedArray[UInt] = FixedArray::make(8, 0U)
  sha256_finalize_into(self, st)
  sha256_state_to_bytes(st)
}

///|
pub fn Sha256::finalize_hex(self : Sha256) -> String {
  bytes_to_hex(self.finalize())
}

///|
pub fn sha256(data : Bytes) -> Bytes {
  let state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  sha256_update_final_state(
    state,
    data,
    0,
    data.length(),
    data.length().to_int64(),
    w,
  )
  sha256_state_to_bytes(state)
}

///|
pub fn sha256_hex(data : Bytes) -> String {
  bytes_to_hex(sha256(data))
}
