///| RFC 8439 ChaCha20, Poly1305, and ChaCha20-Poly1305 AEAD (pure Pion, zero World dependencies).
///| Zero-allocation scalar ChaCha20 block + streaming Poly1305-Donna 5x26-bit UInt64 MAC
///| with constant-time tag verification via `constant_time_eq`.

///|
#verify
pub fn cc_rotl32(x : UInt, n : UInt) -> UInt {
  ((x << n) | (x >> (32U - n))) & 0xFFFFFFFFU
}

///| RFC 8439 ChaCha20-Poly1305 key length check (must be 32 bytes).
pub fn chacha20_is_valid_key_len(n : Int) -> Bool {
  n == 32
}

///| RFC 8439 ChaCha20-Poly1305 nonce length check (must be 12 bytes).
pub fn chacha20_is_valid_nonce_len(n : Int) -> Bool {
  n == 12
}

///| RFC 8439 ChaCha20-Poly1305 ciphertext+tag minimum length check (at least 16-byte tag).
pub fn chacha20_is_valid_ct_len(n : Int) -> Bool {
  n >= 16
}

///|
fn cc_load32_le(b : Bytes, off : Int) -> UInt {
  let b0 = (b[off].to_int() & 0xFF).to_uint()
  let b1 = (b[off + 1].to_int() & 0xFF).to_uint()
  let b2 = (b[off + 2].to_int() & 0xFF).to_uint()
  let b3 = (b[off + 3].to_int() & 0xFF).to_uint()
  b0 | (b1 << 8U) | (b2 << 16U) | (b3 << 24U)
}

///|
fn cc_store32_le(out : FixedArray[Byte], off : Int, v : UInt) -> Unit {
  out[off] = (v & 0xFFU).to_int().to_byte()
  out[off + 1] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  out[off + 2] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  out[off + 3] = ((v >> 24U) & 0xFFU).to_int().to_byte()
}

///|
fn cc_store32_le_bytes(out : Bytes, off : Int, v : UInt) -> Unit {
  let mut o = out
  o[off] = (v & 0xFFU).to_int().to_byte()
  o[off + 1] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  o[off + 2] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  o[off + 3] = ((v >> 24U) & 0xFFU).to_int().to_byte()
}

///| Compute one 64-byte ChaCha20 keystream block into `out` (zero heap allocations).
fn chacha20_block_into(
  k0 : UInt,
  k1 : UInt,
  k2 : UInt,
  k3 : UInt,
  k4 : UInt,
  k5 : UInt,
  k6 : UInt,
  k7 : UInt,
  counter : UInt,
  n0 : UInt,
  n1 : UInt,
  n2 : UInt,
  out : FixedArray[Byte],
) -> Unit {
  let mut x0 = 0x61707865U
  let mut x1 = 0x3320646eU
  let mut x2 = 0x79622d32U
  let mut x3 = 0x6b206574U
  let mut x4 = k0
  let mut x5 = k1
  let mut x6 = k2
  let mut x7 = k3
  let mut x8 = k4
  let mut x9 = k5
  let mut x10 = k6
  let mut x11 = k7
  let mut x12 = counter
  let mut x13 = n0
  let mut x14 = n1
  let mut x15 = n2

  let mut r = 0
  while r < 10 {
    // Column rounds
    x0 = x0 + x4; x12 = cc_rotl32(x12 ^ x0, 16U)
    x8 = x8 + x12; x4 = cc_rotl32(x4 ^ x8, 12U)
    x0 = x0 + x4; x12 = cc_rotl32(x12 ^ x0, 8U)
    x8 = x8 + x12; x4 = cc_rotl32(x4 ^ x8, 7U)

    x1 = x1 + x5; x13 = cc_rotl32(x13 ^ x1, 16U)
    x9 = x9 + x13; x5 = cc_rotl32(x5 ^ x9, 12U)
    x1 = x1 + x5; x13 = cc_rotl32(x13 ^ x1, 8U)
    x9 = x9 + x13; x5 = cc_rotl32(x5 ^ x9, 7U)

    x2 = x2 + x6; x14 = cc_rotl32(x14 ^ x2, 16U)
    x10 = x10 + x14; x6 = cc_rotl32(x6 ^ x10, 12U)
    x2 = x2 + x6; x14 = cc_rotl32(x14 ^ x2, 8U)
    x10 = x10 + x14; x6 = cc_rotl32(x6 ^ x10, 7U)

    x3 = x3 + x7; x15 = cc_rotl32(x15 ^ x3, 16U)
    x11 = x11 + x15; x7 = cc_rotl32(x7 ^ x11, 12U)
    x3 = x3 + x7; x15 = cc_rotl32(x15 ^ x3, 8U)
    x11 = x11 + x15; x7 = cc_rotl32(x7 ^ x11, 7U)

    // Diagonal rounds
    x0 = x0 + x5; x15 = cc_rotl32(x15 ^ x0, 16U)
    x10 = x10 + x15; x5 = cc_rotl32(x5 ^ x10, 12U)
    x0 = x0 + x5; x15 = cc_rotl32(x15 ^ x0, 8U)
    x10 = x10 + x15; x5 = cc_rotl32(x5 ^ x10, 7U)

    x1 = x1 + x6; x12 = cc_rotl32(x12 ^ x1, 16U)
    x11 = x11 + x12; x6 = cc_rotl32(x6 ^ x11, 12U)
    x1 = x1 + x6; x12 = cc_rotl32(x12 ^ x1, 8U)
    x11 = x11 + x12; x6 = cc_rotl32(x6 ^ x11, 7U)

    x2 = x2 + x7; x13 = cc_rotl32(x13 ^ x2, 16U)
    x8 = x8 + x13; x7 = cc_rotl32(x7 ^ x8, 12U)
    x2 = x2 + x7; x13 = cc_rotl32(x13 ^ x2, 8U)
    x8 = x8 + x13; x7 = cc_rotl32(x7 ^ x8, 7U)

    x3 = x3 + x4; x14 = cc_rotl32(x14 ^ x3, 16U)
    x9 = x9 + x14; x4 = cc_rotl32(x4 ^ x9, 12U)
    x3 = x3 + x4; x14 = cc_rotl32(x14 ^ x3, 8U)
    x9 = x9 + x14; x4 = cc_rotl32(x4 ^ x9, 7U)

    r = r + 1
  }

  cc_store32_le(out, 0, x0 + 0x61707865U)
  cc_store32_le(out, 4, x1 + 0x3320646eU)
  cc_store32_le(out, 8, x2 + 0x79622d32U)
  cc_store32_le(out, 12, x3 + 0x6b206574U)
  cc_store32_le(out, 16, x4 + k0)
  cc_store32_le(out, 20, x5 + k1)
  cc_store32_le(out, 24, x6 + k2)
  cc_store32_le(out, 28, x7 + k3)
  cc_store32_le(out, 32, x8 + k4)
  cc_store32_le(out, 36, x9 + k5)
  cc_store32_le(out, 40, x10 + k6)
  cc_store32_le(out, 44, x11 + k7)
  cc_store32_le(out, 48, x12 + counter)
  cc_store32_le(out, 52, x13 + n0)
  cc_store32_le(out, 56, x14 + n1)
  cc_store32_le(out, 60, x15 + n2)
}

///| Internal ChaCha20 XOR into `out` starting at `out_off` from `src[src_off..src_off+len]`.
fn chacha20_xor_slice_into(
  key : Bytes,
  nonce : Bytes,
  counter : UInt,
  src : Bytes,
  src_off : Int,
  len : Int,
  out : Bytes,
  out_off : Int,
) -> Result[Unit, CryptoError] {
  if len > 0 {
    let blocks_m1 = (len - 1) / 64
    let max_rem = 0xFFFFFFFFU - counter
    if blocks_m1.to_uint() > max_rem {
      return Err(CryptoError::CounterOverflow)
    }
  }
  let k0 = cc_load32_le(key, 0)
  let k1 = cc_load32_le(key, 4)
  let k2 = cc_load32_le(key, 8)
  let k3 = cc_load32_le(key, 12)
  let k4 = cc_load32_le(key, 16)
  let k5 = cc_load32_le(key, 20)
  let k6 = cc_load32_le(key, 24)
  let k7 = cc_load32_le(key, 28)
  let n0 = cc_load32_le(nonce, 0)
  let n1 = cc_load32_le(nonce, 4)
  let n2 = cc_load32_le(nonce, 8)
  let block = FixedArray::make(64, (0).to_byte())
  let mut dst = out
  let mut off = 0
  let mut ctr = counter
  while off < len {
    chacha20_block_into(k0, k1, k2, k3, k4, k5, k6, k7, ctr, n0, n1, n2, block)
    let rem = len - off
    let take = if rem < 64 { rem } else { 64 }
    let mut i = 0
    while i < take {
      dst[out_off + off + i] = (
        (src[src_off + off + i].to_int() & 0xFF) ^ (block[i].to_int() & 0xFF)
      ).to_byte()
      i = i + 1
    }
    off = off + take
    if off < len {
      ctr = ctr + 1U
    }
  }
  Ok(())
}

///| RFC 8439 §2.4 ChaCha20 XOR stream cipher.
///| Validates `key = 32B`, `nonce = 12B`, and prevents 32-bit block counter wrap-around.
pub fn chacha20_xor(
  key : Bytes,
  nonce : Bytes,
  counter : UInt,
  data : Bytes,
) -> Result[Bytes, CryptoError] {
  if key.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  if nonce.length() != 12 {
    return Err(CryptoError::InvalidNonceLength(nonce.length()))
  }
  let n = data.length()
  let out = Bytes::new(n)
  match chacha20_xor_slice_into(key, nonce, counter, data, 0, n, out, 0) {
    Ok(_) => Ok(out)
    Err(e) => Err(e)
  }
}

// ── Streaming Poly1305-Donna (5x26-bit UInt64 limbs) ──

///|
fn poly_load32_arr(buf : FixedArray[Byte], off : Int) -> UInt64 {
  let b0 = (buf[off].to_int() & 0xFF).to_int64().to_uint64()
  let b1 = (buf[off + 1].to_int() & 0xFF).to_int64().to_uint64()
  let b2 = (buf[off + 2].to_int() & 0xFF).to_int64().to_uint64()
  let b3 = (buf[off + 3].to_int() & 0xFF).to_int64().to_uint64()
  b0 | (b1 << 8UL) | (b2 << 16UL) | (b3 << 24UL)
}

///|
fn poly_load32_bytes(buf : Bytes, off : Int) -> UInt64 {
  let b0 = (buf[off].to_int() & 0xFF).to_int64().to_uint64()
  let b1 = (buf[off + 1].to_int() & 0xFF).to_int64().to_uint64()
  let b2 = (buf[off + 2].to_int() & 0xFF).to_int64().to_uint64()
  let b3 = (buf[off + 3].to_int() & 0xFF).to_int64().to_uint64()
  b0 | (b1 << 8UL) | (b2 << 16UL) | (b3 << 24UL)
}

///|
struct Poly1305State {
  r0 : UInt64
  r1 : UInt64
  r2 : UInt64
  r3 : UInt64
  r4 : UInt64
  s1 : UInt64
  s2 : UInt64
  s3 : UInt64
  s4 : UInt64
  pad0 : UInt64
  pad1 : UInt64
  pad2 : UInt64
  pad3 : UInt64
  mut h0 : UInt64
  mut h1 : UInt64
  mut h2 : UInt64
  mut h3 : UInt64
  mut h4 : UInt64
  buf : FixedArray[Byte]
  mut fill : Int
}

///| RFC 8439 §2.5 Poly1305 key `r` clamping into 5x26-bit limbs.
#verify
pub fn poly1305_clamp_r(
  w0 : UInt64,
  w1 : UInt64,
  w2 : UInt64,
  w3 : UInt64,
  w4 : UInt64,
) -> (UInt64, UInt64, UInt64, UInt64, UInt64) {
  let r0 = w0 & 0x3ffffffUL
  let r1 = (w1 >> 2UL) & 0x3ffff03UL
  let r2 = (w2 >> 4UL) & 0x3ffc0ffUL
  let r3 = (w3 >> 6UL) & 0x3f03fffUL
  let r4 = (w4 >> 8UL) & 0x00fffffUL
  (r0, r1, r2, r3, r4)
}

///| Constant-time Poly1305 final carry propagation and canonical reduction modulo `2^130 - 5`.
#verify
pub fn poly1305_final_reduce(
  h0_in : UInt64,
  h1_in : UInt64,
  h2_in : UInt64,
  h3_in : UInt64,
  h4_in : UInt64,
) -> (UInt64, UInt64, UInt64, UInt64, UInt64) {
  let mut h0 = h0_in
  let mut h1 = h1_in
  let mut h2 = h2_in
  let mut h3 = h3_in
  let mut h4 = h4_in
  let mut c = h1 >> 26UL
  h1 = h1 & 0x3ffffffUL
  h2 = h2 + c
  c = h2 >> 26UL
  h2 = h2 & 0x3ffffffUL
  h3 = h3 + c
  c = h3 >> 26UL
  h3 = h3 & 0x3ffffffUL
  h4 = h4 + c
  c = h4 >> 26UL
  h4 = h4 & 0x3ffffffUL
  h0 = h0 + c * 5UL
  c = h0 >> 26UL
  h0 = h0 & 0x3ffffffUL
  h1 = h1 + c
  let mut g0 = h0 + 5UL
  c = g0 >> 26UL
  g0 = g0 & 0x3ffffffUL
  let mut g1 = h1 + c
  c = g1 >> 26UL
  g1 = g1 & 0x3ffffffUL
  let mut g2 = h2 + c
  c = g2 >> 26UL
  g2 = g2 & 0x3ffffffUL
  let mut g3 = h3 + c
  c = g3 >> 26UL
  g3 = g3 & 0x3ffffffUL
  let g4 = (h4 + c) - (1UL << 26UL)
  let mut mask = (g4 >> 63UL) - 1UL
  g0 = g0 & mask
  g1 = g1 & mask
  g2 = g2 & mask
  g3 = g3 & mask
  let g4_m = g4 & mask
  mask = mask ^ 0xFFFFFFFFFFFFFFFFUL
  h0 = (h0 & mask) | g0
  h1 = (h1 & mask) | g1
  h2 = (h2 & mask) | g2
  h3 = (h3 & mask) | g3
  h4 = (h4 & mask) | g4_m
  (h0, h1, h2, h3, h4)
}

///|
fn poly1305_init_arr(key : FixedArray[Byte]) -> Poly1305State {
  let (r0, r1, r2, r3, r4) = poly1305_clamp_r(
    poly_load32_arr(key, 0),
    poly_load32_arr(key, 3),
    poly_load32_arr(key, 6),
    poly_load32_arr(key, 9),
    poly_load32_arr(key, 12),
  )
  Poly1305State::{
    r0: r0,
    r1: r1,
    r2: r2,
    r3: r3,
    r4: r4,
    s1: r1 * 5UL,
    s2: r2 * 5UL,
    s3: r3 * 5UL,
    s4: r4 * 5UL,
    pad0: poly_load32_arr(key, 16),
    pad1: poly_load32_arr(key, 20),
    pad2: poly_load32_arr(key, 24),
    pad3: poly_load32_arr(key, 28),
    h0: 0UL,
    h1: 0UL,
    h2: 0UL,
    h3: 0UL,
    h4: 0UL,
    buf: FixedArray::make(16, (0).to_byte()),
    fill: 0,
  }
}

///|
fn poly1305_init_bytes(key : Bytes) -> Poly1305State {
  let (r0, r1, r2, r3, r4) = poly1305_clamp_r(
    poly_load32_bytes(key, 0),
    poly_load32_bytes(key, 3),
    poly_load32_bytes(key, 6),
    poly_load32_bytes(key, 9),
    poly_load32_bytes(key, 12),
  )
  Poly1305State::{
    r0: r0,
    r1: r1,
    r2: r2,
    r3: r3,
    r4: r4,
    s1: r1 * 5UL,
    s2: r2 * 5UL,
    s3: r3 * 5UL,
    s4: r4 * 5UL,
    pad0: poly_load32_bytes(key, 16),
    pad1: poly_load32_bytes(key, 20),
    pad2: poly_load32_bytes(key, 24),
    pad3: poly_load32_bytes(key, 28),
    h0: 0UL,
    h1: 0UL,
    h2: 0UL,
    h3: 0UL,
    h4: 0UL,
    buf: FixedArray::make(16, (0).to_byte()),
    fill: 0,
  }
}

///|
fn poly1305_block(st : Poly1305State, m0 : UInt64, m1 : UInt64, m2 : UInt64, m3 : UInt64, m4 : UInt64) -> Unit {
  let h0 = st.h0 + m0
  let h1 = st.h1 + m1
  let h2 = st.h2 + m2
  let h3 = st.h3 + m3
  let h4 = st.h4 + m4
  let d0 = h0 * st.r0 + h1 * st.s4 + h2 * st.s3 + h3 * st.s2 + h4 * st.s1
  let mut d1 = h0 * st.r1 + h1 * st.r0 + h2 * st.s4 + h3 * st.s3 + h4 * st.s2
  let mut d2 = h0 * st.r2 + h1 * st.r1 + h2 * st.r0 + h3 * st.s4 + h4 * st.s3
  let mut d3 = h0 * st.r3 + h1 * st.r2 + h2 * st.r1 + h3 * st.r0 + h4 * st.s4
  let mut d4 = h0 * st.r4 + h1 * st.r3 + h2 * st.r2 + h3 * st.r1 + h4 * st.r0
  let mut c = d0 >> 26UL
  let mut nh0 = d0 & 0x3ffffffUL
  d1 = d1 + c
  c = d1 >> 26UL
  let mut nh1 = d1 & 0x3ffffffUL
  d2 = d2 + c
  c = d2 >> 26UL
  let nh2 = d2 & 0x3ffffffUL
  d3 = d3 + c
  c = d3 >> 26UL
  let nh3 = d3 & 0x3ffffffUL
  d4 = d4 + c
  c = d4 >> 26UL
  let nh4 = d4 & 0x3ffffffUL
  nh0 = nh0 + c * 5UL
  c = nh0 >> 26UL
  nh0 = nh0 & 0x3ffffffUL
  nh1 = nh1 + c
  st.h0 = nh0
  st.h1 = nh1
  st.h2 = nh2
  st.h3 = nh3
  st.h4 = nh4
}

///|
fn poly1305_block_arr(st : Poly1305State, blk : FixedArray[Byte], hibit : UInt64) -> Unit {
  let m0 = poly_load32_arr(blk, 0) & 0x3ffffffUL
  let m1 = (poly_load32_arr(blk, 3) >> 2UL) & 0x3ffffffUL
  let m2 = (poly_load32_arr(blk, 6) >> 4UL) & 0x3ffffffUL
  let m3 = (poly_load32_arr(blk, 9) >> 6UL) & 0x3ffffffUL
  let m4 = (poly_load32_arr(blk, 12) >> 8UL) | hibit
  poly1305_block(st, m0, m1, m2, m3, m4)
}

///|
fn poly1305_update_slice(st : Poly1305State, data : Bytes, start : Int, len : Int) -> Unit {
  let mut off = start
  let end = start + len
  if st.fill > 0 {
    while off < end && st.fill < 16 {
      st.buf[st.fill] = data[off]
      st.fill = st.fill + 1
      off = off + 1
    }
    if st.fill == 16 {
      poly1305_block_arr(st, st.buf, 1UL << 24UL)
      st.fill = 0
    }
  }
  while off + 16 <= end {
    let m0 = poly_load32_bytes(data, off) & 0x3ffffffUL
    let m1 = (poly_load32_bytes(data, off + 3) >> 2UL) & 0x3ffffffUL
    let m2 = (poly_load32_bytes(data, off + 6) >> 4UL) & 0x3ffffffUL
    let m3 = (poly_load32_bytes(data, off + 9) >> 6UL) & 0x3ffffffUL
    let m4 = (poly_load32_bytes(data, off + 12) >> 8UL) | (1UL << 24UL)
    poly1305_block(st, m0, m1, m2, m3, m4)
    off = off + 16
  }
  while off < end {
    st.buf[st.fill] = data[off]
    st.fill = st.fill + 1
    off = off + 1
  }
}

///|
fn poly1305_pad16(st : Poly1305State) -> Unit {
  if st.fill > 0 {
    while st.fill < 16 {
      st.buf[st.fill] = (0).to_byte()
      st.fill = st.fill + 1
    }
    poly1305_block_arr(st, st.buf, 1UL << 24UL)
    st.fill = 0
  }
}

///|
fn poly1305_update_lengths(st : Poly1305State, aad_len : Int, ct_len : Int) -> Unit {
  // Always called on a 16-byte aligned boundary (st.fill == 0)
  let al = aad_len.to_int64().to_uint64()
  let cl = ct_len.to_int64().to_uint64()
  let mut i = 0
  while i < 8 {
    let shift = (i * 8).to_int64().to_uint64()
    st.buf[i] = ((al >> shift) & 0xFFUL).to_int().to_byte()
    st.buf[8 + i] = ((cl >> shift) & 0xFFUL).to_int().to_byte()
    i = i + 1
  }
  poly1305_block_arr(st, st.buf, 1UL << 24UL)
}

///|
fn poly1305_finalize(st : Poly1305State) -> Bytes {
  if st.fill > 0 {
    st.buf[st.fill] = (1).to_byte()
    let mut i = st.fill + 1
    while i < 16 {
      st.buf[i] = (0).to_byte()
      i = i + 1
    }
    poly1305_block_arr(st, st.buf, 0UL)
    st.fill = 0
  }
  let (h0, h1, h2, h3, h4) = poly1305_final_reduce(st.h0, st.h1, st.h2, st.h3, st.h4)
  let w0 = (h0 | (h1 << 26UL)) & 0xFFFFFFFFUL
  let w1 = ((h1 >> 6UL) | (h2 << 20UL)) & 0xFFFFFFFFUL
  let w2 = ((h2 >> 12UL) | (h3 << 14UL)) & 0xFFFFFFFFUL
  let w3 = ((h3 >> 18UL) | (h4 << 8UL)) & 0xFFFFFFFFUL
  let mut f = w0 + st.pad0
  let o0 = (f & 0xFFFFFFFFUL).to_int().to_uint()
  f = w1 + st.pad1 + (f >> 32UL)
  let o1 = (f & 0xFFFFFFFFUL).to_int().to_uint()
  f = w2 + st.pad2 + (f >> 32UL)
  let o2 = (f & 0xFFFFFFFFUL).to_int().to_uint()
  f = w3 + st.pad3 + (f >> 32UL)
  let o3 = (f & 0xFFFFFFFFUL).to_int().to_uint()
  let tag = Bytes::new(16)
  cc_store32_le_bytes(tag, 0, o0)
  cc_store32_le_bytes(tag, 4, o1)
  cc_store32_le_bytes(tag, 8, o2)
  cc_store32_le_bytes(tag, 12, o3)
  tag
}

///| RFC 8439 §2.5 Poly1305 one-time authenticator. `key` must be 32 bytes.
pub fn poly1305_mac(key : Bytes, msg : Bytes) -> Result[Bytes, CryptoError] {
  if key.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  let st = poly1305_init_bytes(key)
  poly1305_update_slice(st, msg, 0, msg.length())
  Ok(poly1305_finalize(st))
}

///| RFC 8439 §2.8 ChaCha20-Poly1305 AEAD seal: returns `ciphertext || 16-byte tag`.
pub fn chacha20_poly1305_seal(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  plaintext : Bytes,
) -> Result[Bytes, CryptoError] {
  if !chacha20_is_valid_key_len(key.length()) {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  if !chacha20_is_valid_nonce_len(nonce.length()) {
    return Err(CryptoError::InvalidNonceLength(nonce.length()))
  }
  let pt_len = plaintext.length()
  let mut out = Bytes::new(pt_len + 16)
  match chacha20_xor_slice_into(key, nonce, 1U, plaintext, 0, pt_len, out, 0) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let otk = FixedArray::make(64, (0).to_byte())
  chacha20_block_into(
    cc_load32_le(key, 0),
    cc_load32_le(key, 4),
    cc_load32_le(key, 8),
    cc_load32_le(key, 12),
    cc_load32_le(key, 16),
    cc_load32_le(key, 20),
    cc_load32_le(key, 24),
    cc_load32_le(key, 28),
    0U,
    cc_load32_le(nonce, 0),
    cc_load32_le(nonce, 4),
    cc_load32_le(nonce, 8),
    otk,
  )
  let st = poly1305_init_arr(otk)
  poly1305_update_slice(st, aad, 0, aad.length())
  poly1305_pad16(st)
  poly1305_update_slice(st, out, 0, pt_len)
  poly1305_pad16(st)
  poly1305_update_lengths(st, aad.length(), pt_len)
  let tag = poly1305_finalize(st)
  let mut i = 0
  while i < 16 {
    out[pt_len + i] = tag[i]
    i = i + 1
  }
  Ok(out)
}

///| RFC 8439 §2.8 ChaCha20-Poly1305 AEAD open.
///| Verifies the 16-byte Poly1305 tag in constant time before decrypting; never leaks plaintext on failure.
pub fn chacha20_poly1305_open(
  key : Bytes,
  nonce : Bytes,
  aad : Bytes,
  ciphertext_and_tag : Bytes,
) -> Result[Bytes, CryptoError] {
  if !chacha20_is_valid_key_len(key.length()) {
    return Err(CryptoError::InvalidKeyLength(key.length()))
  }
  if !chacha20_is_valid_nonce_len(nonce.length()) {
    return Err(CryptoError::InvalidNonceLength(nonce.length()))
  }
  let total = ciphertext_and_tag.length()
  if !chacha20_is_valid_ct_len(total) {
    return Err(CryptoError::InvalidLength(total))
  }
  let ct_len = total - 16
  let otk = FixedArray::make(64, (0).to_byte())
  chacha20_block_into(
    cc_load32_le(key, 0),
    cc_load32_le(key, 4),
    cc_load32_le(key, 8),
    cc_load32_le(key, 12),
    cc_load32_le(key, 16),
    cc_load32_le(key, 20),
    cc_load32_le(key, 24),
    cc_load32_le(key, 28),
    0U,
    cc_load32_le(nonce, 0),
    cc_load32_le(nonce, 4),
    cc_load32_le(nonce, 8),
    otk,
  )
  let st = poly1305_init_arr(otk)
  poly1305_update_slice(st, aad, 0, aad.length())
  poly1305_pad16(st)
  poly1305_update_slice(st, ciphertext_and_tag, 0, ct_len)
  poly1305_pad16(st)
  poly1305_update_lengths(st, aad.length(), ct_len)
  let computed_tag = poly1305_finalize(st)
  let mut expected_tag = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    expected_tag[i] = ciphertext_and_tag[ct_len + i]
    i = i + 1
  }
  if !constant_time_eq(computed_tag, expected_tag) {
    return Err(CryptoError::AuthenticationFailed)
  }
  let out = Bytes::new(ct_len)
  match chacha20_xor_slice_into(key, nonce, 1U, ciphertext_and_tag, 0, ct_len, out, 0) {
    Ok(_) => Ok(out)
    Err(e) => Err(e)
  }
}
