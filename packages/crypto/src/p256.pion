///| NIST P-256 (secp256r1) + RFC 6979 deterministic ECDSA (ES256) + strict ASN.1 DER
///| verification (WebAuthn/Passkey compatible) + PKCS#8 DER/PEM key parsing.
///|
///| Constant-time signing & keygen via:
///| - Branch-free Montgomery field arithmetic over F_p
///| - Complete projective addition/doubling (Renes-Costello-Batina 2015, a = -3)
///| - Constant-time 4-bit windowed base-point scalar multiplication (using `ct_eq_nibble`)

///|
fn p256_p() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0xFFFFFFFFUL, 0xFFFFFFFFUL, 0xFFFFFFFFUL, 0x00000000UL,
    0x00000000UL, 0x00000000UL, 0x00000001UL, 0xFFFFFFFFUL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///|
fn p256_n() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0xFC632551UL, 0xF3B9CAC2UL, 0xA7179E84UL, 0xBCE6FAADUL,
    0xFFFFFFFFUL, 0xFFFFFFFFUL, 0x00000000UL, 0xFFFFFFFFUL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///|
fn p256_b() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0x27D2604BUL, 0x3BCE3C3EUL, 0xCC53B0F6UL, 0x651D06B0UL,
    0x769886BCUL, 0xB3EBBD55UL, 0xAA3A93E7UL, 0x5AC635D8UL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///|
fn p256_gx() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0xD898C296UL, 0xF4A13945UL, 0x2DEB33A0UL, 0x77037D81UL,
    0x63A440F2UL, 0xF8BCE6E5UL, 0xE12C4247UL, 0x6B17D1F2UL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///|
fn p256_gy() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0x37BF51F5UL, 0xCBB64068UL, 0x6B315ECEUL, 0x2BCE3357UL,
    0x7C0F9E16UL, 0x8EE7EB4AUL, 0xFE1A7F9BUL, 0x4FE342E2UL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///|
struct P256Ctx {
  p : BigUint
  p_limbs : FixedArray[UInt64]
  n0_inv : UInt64
  r2 : FixedArray[UInt64]
  one_mont : FixedArray[UInt64]
  b_mont : FixedArray[UInt64]
}

///|
fn p256_ctx() -> P256Ctx {
  let p = p256_p()
  let p_limbs = to_fixed_limbs(p, 8)
  let n0_inv = mont_n0_inv(p_limbs[0])
  let r2 = to_fixed_limbs(mont_r2(p), 8)
  let one = FixedArray::make(8, 0UL)
  one[0] = 1UL
  let one_mont = mont_mul_limbs(one, r2, p_limbs, 8, n0_inv)
  let b_mont = mont_mul_limbs(to_fixed_limbs(p256_b(), 8), r2, p_limbs, 8, n0_inv)
  P256Ctx::{
    p: p,
    p_limbs: p_limbs,
    n0_inv: n0_inv,
    r2: r2,
    one_mont: one_mont,
    b_mont: b_mont,
  }
}

///|
fn fp_to_mont(ctx : P256Ctx, a : BigUint) -> FixedArray[UInt64] {
  mont_mul_limbs(to_fixed_limbs(big_mod(a, ctx.p), 8), ctx.r2, ctx.p_limbs, 8, ctx.n0_inv)
}

///|
fn fp_from_mont(ctx : P256Ctx, a : FixedArray[UInt64]) -> BigUint {
  let one = FixedArray::make(8, 0UL)
  one[0] = 1UL
  big_trim(mont_mul_limbs(a, one, ctx.p_limbs, 8, ctx.n0_inv), 8)
}

///|
fn fp_is_zero(a : FixedArray[UInt64]) -> Bool {
  let mut acc = 0UL
  let mut i = 0
  while i < 8 {
    acc = acc | a[i]
    i = i + 1
  }
  acc == 0UL
}

///| Branch-free modular addition `(a + b) mod p` over F_p.
fn fp_add(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  let sum = FixedArray::make(8, 0UL)
  let mut carry = 0UL
  let mut i = 0
  while i < 8 {
    let s = a[i] + b[i] + carry
    sum[i] = s & 0xFFFFFFFFUL
    carry = s >> 32UL
    i = i + 1
  }
  let diff = FixedArray::make(8, 0UL)
  let mut borrow = 0UL
  i = 0
  while i < 8 {
    let d = (sum[i] + 0x100000000UL) - ctx.p_limbs[i] - borrow
    diff[i] = d & 0xFFFFFFFFUL
    borrow = 1UL - (d >> 32UL)
    i = i + 1
  }
  let use_diff = 1UL - ((carry - borrow) >> 63UL)
  let mask = 0UL - use_diff
  let out = FixedArray::make(8, 0UL)
  i = 0
  while i < 8 {
    out[i] = sum[i] ^ (mask & (sum[i] ^ diff[i]))
    i = i + 1
  }
  out
}

///| Branch-free modular subtraction `(a - b) mod p` over F_p.
fn fp_sub(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  let diff = FixedArray::make(8, 0UL)
  let mut borrow = 0UL
  let mut i = 0
  while i < 8 {
    let d = (a[i] + 0x100000000UL) - b[i] - borrow
    diff[i] = d & 0xFFFFFFFFUL
    borrow = 1UL - (d >> 32UL)
    i = i + 1
  }
  let mask = 0UL - borrow
  let out = FixedArray::make(8, 0UL)
  let mut carry = 0UL
  i = 0
  while i < 8 {
    let s = diff[i] + (ctx.p_limbs[i] & mask) + carry
    out[i] = s & 0xFFFFFFFFUL
    carry = s >> 32UL
    i = i + 1
  }
  out
}

///|
fn fp_mul(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  mont_mul_limbs(a, b, ctx.p_limbs, 8, ctx.n0_inv)
}

///|
fn fp_cmov(a : FixedArray[UInt64], b : FixedArray[UInt64], flag : UInt64) -> FixedArray[UInt64] {
  let mask = 0UL - flag
  let out = FixedArray::make(8, 0UL)
  let mut i = 0
  while i < 8 {
    out[i] = a[i] ^ (mask & (a[i] ^ b[i]))
    i = i + 1
  }
  out
}

///| Homogeneous projective point `(X : Y : Z)` on NIST P-256. Identity is `(0 : 1 : 0)`.
struct P256Point {
  x : FixedArray[UInt64]
  y : FixedArray[UInt64]
  z : FixedArray[UInt64]
}

///|
fn p256_infinity(ctx : P256Ctx) -> P256Point {
  P256Point::{ x: FixedArray::make(8, 0UL), y: ctx.one_mont, z: FixedArray::make(8, 0UL) }
}

///|
fn p256_g(ctx : P256Ctx) -> P256Point {
  P256Point::{
    x: fp_to_mont(ctx, p256_gx()),
    y: fp_to_mont(ctx, p256_gy()),
    z: ctx.one_mont,
  }
}

///|
fn p256_cmov(a : P256Point, b : P256Point, flag : UInt64) -> P256Point {
  P256Point::{
    x: fp_cmov(a.x, b.x, flag),
    y: fp_cmov(a.y, b.y, flag),
    z: fp_cmov(a.z, b.z, flag),
  }
}

///| Complete, branch-free projective point doubling for `a = -3` (Renes-Costello-Batina 2015, Alg. 6).
fn p256_dbl(ctx : P256Ctx, pt : P256Point) -> P256Point {
  let x = pt.x
  let y = pt.y
  let z = pt.z
  let mut t0 = fp_mul(ctx, x, x)
  let t1 = fp_mul(ctx, y, y)
  let mut t2 = fp_mul(ctx, z, z)
  let mut t3 = fp_mul(ctx, x, y)
  t3 = fp_add(ctx, t3, t3)
  let mut z3 = fp_mul(ctx, x, z)
  z3 = fp_add(ctx, z3, z3)
  let mut y3 = fp_mul(ctx, ctx.b_mont, t2)
  y3 = fp_sub(ctx, y3, z3)
  let mut x3 = fp_add(ctx, y3, y3)
  y3 = fp_add(ctx, x3, y3)
  x3 = fp_sub(ctx, t1, y3)
  y3 = fp_add(ctx, t1, y3)
  y3 = fp_mul(ctx, x3, y3)
  x3 = fp_mul(ctx, x3, t3)
  t3 = fp_add(ctx, t2, t2)
  t2 = fp_add(ctx, t2, t3)
  z3 = fp_mul(ctx, ctx.b_mont, z3)
  z3 = fp_sub(ctx, z3, t2)
  z3 = fp_sub(ctx, z3, t0)
  t3 = fp_add(ctx, z3, z3)
  z3 = fp_add(ctx, z3, t3)
  t3 = fp_add(ctx, t0, t0)
  t0 = fp_add(ctx, t3, t0)
  t0 = fp_sub(ctx, t0, t2)
  t0 = fp_mul(ctx, t0, z3)
  y3 = fp_add(ctx, y3, t0)
  t0 = fp_mul(ctx, y, z)
  t0 = fp_add(ctx, t0, t0)
  z3 = fp_mul(ctx, t0, z3)
  x3 = fp_sub(ctx, x3, z3)
  z3 = fp_mul(ctx, t0, t1)
  z3 = fp_add(ctx, z3, z3)
  z3 = fp_add(ctx, z3, z3)
  P256Point::{ x: x3, y: y3, z: z3 }
}

///| Complete, branch-free projective point addition for `a = -3` (Renes-Costello-Batina 2015, Alg. 4).
fn p256_add(ctx : P256Ctx, p : P256Point, q : P256Point) -> P256Point {
  let x1 = p.x
  let y1 = p.y
  let z1 = p.z
  let x2 = q.x
  let y2 = q.y
  let z2 = q.z
  let mut t0 = fp_mul(ctx, x1, x2)
  let mut t1 = fp_mul(ctx, y1, y2)
  let mut t2 = fp_mul(ctx, z1, z2)
  let mut t3 = fp_add(ctx, x1, y1)
  let mut t4 = fp_add(ctx, x2, y2)
  t3 = fp_mul(ctx, t3, t4)
  t4 = fp_add(ctx, t0, t1)
  t3 = fp_sub(ctx, t3, t4)
  t4 = fp_add(ctx, y1, z1)
  let mut x3 = fp_add(ctx, y2, z2)
  t4 = fp_mul(ctx, t4, x3)
  x3 = fp_add(ctx, t1, t2)
  t4 = fp_sub(ctx, t4, x3)
  x3 = fp_add(ctx, x1, z1)
  let mut y3 = fp_add(ctx, x2, z2)
  x3 = fp_mul(ctx, x3, y3)
  y3 = fp_add(ctx, t0, t2)
  y3 = fp_sub(ctx, x3, y3)
  let mut z3 = fp_mul(ctx, ctx.b_mont, t2)
  x3 = fp_sub(ctx, y3, z3)
  z3 = fp_add(ctx, x3, x3)
  x3 = fp_add(ctx, x3, z3)
  z3 = fp_sub(ctx, t1, x3)
  x3 = fp_add(ctx, t1, x3)
  y3 = fp_mul(ctx, ctx.b_mont, y3)
  t1 = fp_add(ctx, t2, t2)
  t2 = fp_add(ctx, t1, t2)
  y3 = fp_sub(ctx, y3, t2)
  y3 = fp_sub(ctx, y3, t0)
  t1 = fp_add(ctx, y3, y3)
  y3 = fp_add(ctx, t1, y3)
  t1 = fp_add(ctx, t0, t0)
  t0 = fp_add(ctx, t1, t0)
  t0 = fp_sub(ctx, t0, t2)
  t1 = fp_mul(ctx, t4, y3)
  t2 = fp_mul(ctx, t0, y3)
  y3 = fp_mul(ctx, x3, z3)
  y3 = fp_add(ctx, y3, t2)
  x3 = fp_mul(ctx, t3, x3)
  x3 = fp_sub(ctx, x3, t1)
  z3 = fp_mul(ctx, t4, z3)
  t1 = fp_mul(ctx, t3, t0)
  z3 = fp_add(ctx, z3, t1)
  P256Point::{ x: x3, y: y3, z: z3 }
}

///| Constant-time 4-bit windowed scalar multiplication `[k]G` (branch-free table select).
fn p256_scalarmult_base_ct(ctx : P256Ctx, k_bytes : Bytes) -> P256Point {
  let g1 = p256_g(ctx)
  let g2 = p256_dbl(ctx, g1)
  let g3 = p256_add(ctx, g2, g1)
  let g4 = p256_dbl(ctx, g2)
  let g5 = p256_add(ctx, g4, g1)
  let g6 = p256_dbl(ctx, g3)
  let g7 = p256_add(ctx, g6, g1)
  let g8 = p256_dbl(ctx, g4)
  let g9 = p256_add(ctx, g8, g1)
  let g10 = p256_dbl(ctx, g5)
  let g11 = p256_add(ctx, g10, g1)
  let g12 = p256_dbl(ctx, g6)
  let g13 = p256_add(ctx, g12, g1)
  let g14 = p256_dbl(ctx, g7)
  let g15 = p256_add(ctx, g14, g1)
  let table : FixedArray[P256Point] = [
    p256_infinity(ctx), g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15,
  ]

  let mut acc = p256_infinity(ctx)
  let mut idx = 0
  while idx < 32 {
    let b = k_bytes[idx].to_int() & 0xFF
    let hi = (b >> 4) & 0xF
    acc = p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, acc))))
    let mut picked_hi = table[0]
    let mut j = 1
    while j < 16 {
      picked_hi = p256_cmov(picked_hi, table[j], ct_eq_nibble(hi, j).to_uint64())
      j = j + 1
    }
    acc = p256_add(ctx, acc, picked_hi)

    let lo = b & 0xF
    acc = p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, acc))))
    let mut picked_lo = table[0]
    let mut m = 1
    while m < 16 {
      picked_lo = p256_cmov(picked_lo, table[m], ct_eq_nibble(lo, m).to_uint64())
      m = m + 1
    }
    acc = p256_add(ctx, acc, picked_lo)
    idx = idx + 1
  }
  acc
}

///| Variable-time Shamir's trick `[u1]G + [u2]Q` (verification only, public inputs).
fn p256_double_scalarmult_vartime(
  ctx : P256Ctx,
  u1 : BigUint,
  q : P256Point,
  u2 : BigUint,
) -> P256Point {
  let g = p256_g(ctx)
  let gq = p256_add(ctx, g, q)
  let mut acc = p256_infinity(ctx)
  let mut bit = 255
  while bit >= 0 {
    acc = p256_dbl(ctx, acc)
    let b1 = big_get_bit(u1, bit)
    let b2 = big_get_bit(u2, bit)
    if b1 == 1 && b2 == 1 {
      acc = p256_add(ctx, acc, gq)
    } else if b1 == 1 {
      acc = p256_add(ctx, acc, g)
    } else if b2 == 1 {
      acc = p256_add(ctx, acc, q)
    }
    bit = bit - 1
  }
  acc
}

///| Convert homogeneous projective point `(X : Y : Z)` to affine `(x, y)`.
fn p256_affine(ctx : P256Ctx, pt : P256Point) -> (BigUint, BigUint, Bool) {
  if fp_is_zero(pt.z) {
    return (big_zero(), big_zero(), false)
  }
  // Z^(p-2) with the constant-time fixed-window ladder: Z depends on the secret scalar when
  // deriving public keys and on the nonce when signing.
  let one = FixedArray::make(8, 0UL)
  one[0] = 1UL
  let z_plain = mont_mul_limbs(pt.z, one, ctx.p_limbs, 8, ctx.n0_inv)
  let p_m_2 = big_sub(ctx.p, big_from_u64(2UL))
  let z_inv_plain = mont_pow_ct(mont_ctx_ct(ctx.p), z_plain, p_m_2, 8)
  let z_inv = mont_mul_limbs(z_inv_plain, ctx.r2, ctx.p_limbs, 8, ctx.n0_inv)
  let ax = fp_from_mont(ctx, fp_mul(ctx, pt.x, z_inv))
  let ay = fp_from_mont(ctx, fp_mul(ctx, pt.y, z_inv))
  (ax, ay, true)
}

///| Derive the 65-byte SEC1 uncompressed P-256 public key (`0x04 || X || Y`) from a 32-byte secret scalar.
pub fn p256_public_key(secret : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  let d = big_from_be(secret)
  let n = p256_n()
  if big_is_zero(d) || big_cmp(d, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let ctx = p256_ctx()
  let pt = p256_scalarmult_base_ct(ctx, secret)
  let aff = p256_affine(ctx, pt)
  if !aff.2 {
    return Err(CryptoError::InvalidPoint)
  }
  let xb = big_to_be(aff.0, 32)
  let yb = big_to_be(aff.1, 32)
  let mut out = Bytes::new(65)
  out[0] = (0x04).to_byte()
  let mut i = 0
  while i < 32 {
    out[1 + i] = xb[i]
    out[33 + i] = yb[i]
    i = i + 1
  }
  Ok(out)
}

///|
fn p256_concat2(a : Bytes, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn p256_concat3(a : Bytes, mid : Byte, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + 1 + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  out[a.length()] = mid
  let mut j = 0
  while j < b.length() {
    out[a.length() + 1 + j] = b[j]
    j = j + 1
  }
  out
}

///| Sign `msg` with NIST P-256 + RFC 6979 deterministic ECDSA (SHA-256), returning 64-byte `r || s`.
pub fn p256_sign_es256(secret : Bytes, msg : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  let d = big_from_be(secret)
  let n = p256_n()
  if big_is_zero(d) || big_cmp(d, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let n_m_2 = big_sub(n, big_from_u64(2UL))
  let ctx = p256_ctx()
  let hash = big_mod(big_from_be(sha256(msg)), n)
  let nctx = mont_ctx_ct(n)
  let d_limbs = to_fixed_limbs(d, 8)
  let hash_limbs = to_fixed_limbs(hash, 8)
  let seed = p256_concat2(big_to_be(d, 32), big_to_be(hash, 32))
  let mut k = Bytes::new(32)
  let mut v = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    v[i] = (1).to_byte()
    i = i + 1
  }
  k = hmac_sha256(k, p256_concat3(v, (0).to_byte(), seed))
  v = hmac_sha256(k, v)
  k = hmac_sha256(k, p256_concat3(v, (1).to_byte(), seed))
  v = hmac_sha256(k, v)
  let mut tries = 0
  while tries < 1000 {
    v = hmac_sha256(k, v)
    let nonce = big_from_be(v)
    if !big_is_zero(nonce) && big_cmp(nonce, n) < 0 {
      let aff = p256_affine(ctx, p256_scalarmult_base_ct(ctx, v))
      if aff.2 {
        let r = big_mod(aff.0, n)
        if !big_is_zero(r) {
          // s = k^-1 * (z + r * d) mod n, branch-free over fixed 8-limb operands.
          let nonce_inv = mont_pow_ct(nctx, to_fixed_limbs(nonce, 8), n_m_2, 8)
          let rk = mont_mul_mod_ct(nctx, to_fixed_limbs(r, 8), d_limbs)
          let sum = mod_add_ct(nctx, hash_limbs, rk)
          let s = big_trim(mont_mul_mod_ct(nctx, nonce_inv, sum), 8)
          if !big_is_zero(s) {
            return Ok(p256_concat2(big_to_be(r, 32), big_to_be(s, 32)))
          }
        }
      }
    }
    k = hmac_sha256(k, p256_concat3(v, (0).to_byte(), Bytes::new(0)))
    v = hmac_sha256(k, v)
    tries = tries + 1
  }
  Err(CryptoError::InvalidScalar)
}

///| Verify an ES256 (NIST P-256 SHA-256) 64-byte `r || s` signature.
///| Accepts 65-byte SEC1 uncompressed (`0x04 || X || Y`) or 64-byte raw (`X || Y`) public keys.
pub fn p256_verify_es256(
  public_key : Bytes,
  msg : Bytes,
  sig_rs : Bytes,
) -> Result[Unit, CryptoError] {
  let pk_len = public_key.length()
  let coord_off = if pk_len == 65 {
    if (public_key[0].to_int() & 0xFF) != 0x04 {
      return Err(CryptoError::InvalidPoint)
    }
    1
  } else if pk_len == 64 {
    0
  } else {
    return Err(CryptoError::InvalidPublicKeyLength(pk_len))
  }
  if sig_rs.length() != 64 {
    return Err(CryptoError::InvalidSignatureLength(sig_rs.length()))
  }
  let ctx = p256_ctx()
  let x = big_from_be_slice(public_key, coord_off, 32)
  let y = big_from_be_slice(public_key, coord_off + 32, 32)
  if big_cmp(x, ctx.p) >= 0 || big_cmp(y, ctx.p) >= 0 {
    return Err(CryptoError::InvalidPoint)
  }
  // Check y^2 == x^3 - 3x + b (mod p); also rejects (0, 0) since b != 0
  let xm = fp_to_mont(ctx, x)
  let ym = fp_to_mont(ctx, y)
  let lhs = fp_from_mont(ctx, fp_mul(ctx, ym, ym))
  let x2 = fp_mul(ctx, xm, xm)
  let x3 = fp_mul(ctx, x2, xm)
  let x3_m_3x = fp_sub(ctx, x3, fp_add(ctx, fp_add(ctx, xm, xm), xm))
  let rhs = fp_from_mont(ctx, fp_add(ctx, x3_m_3x, ctx.b_mont))
  if !big_eq(lhs, rhs) {
    return Err(CryptoError::InvalidPoint)
  }
  let n = p256_n()
  let r = big_from_be_slice(sig_rs, 0, 32)
  let s = big_from_be_slice(sig_rs, 32, 32)
  if big_is_zero(r) || big_cmp(r, n) >= 0 || big_is_zero(s) || big_cmp(s, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let z = big_mod(big_from_be(sha256(msg)), n)
  let w = big_mod_pow(s, big_sub(n, big_from_u64(2UL)), n)
  let u1 = big_mul_mod(z, w, n)
  let u2 = big_mul_mod(r, w, n)
  let pub_pt = P256Point::{ x: xm, y: ym, z: ctx.one_mont }
  let sum_pt = p256_double_scalarmult_vartime(ctx, u1, pub_pt, u2)
  let aff = p256_affine(ctx, sum_pt)
  if aff.2 && big_eq(big_mod(aff.0, n), r) {
    Ok(())
  } else {
    Err(CryptoError::SignatureMismatch)
  }
}

///| Verify a strict ASN.1 DER-encoded ECDSA P-256 SHA-256 signature (`SEQUENCE { INTEGER r, INTEGER s }`).
///| Rejects trailing bytes, non-minimal lengths, negative integers, and redundant leading zeros.
pub fn p256_verify_der(
  public_key : Bytes,
  msg : Bytes,
  der_sig : Bytes,
) -> Result[Unit, CryptoError] {
  let seq = match der_sequence(der_sig, 0, der_sig.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let r = match seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let s = match seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !seq.done() {
    return Err(CryptoError::InvalidDer)
  }
  let n = p256_n()
  if big_is_zero(r) || big_cmp(r, n) >= 0 || big_is_zero(s) || big_cmp(s, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let sig_rs = p256_concat2(big_to_be(r, 32), big_to_be(s, 32))
  p256_verify_es256(public_key, msg, sig_rs)
}

///| Parse a 32-byte P-256 private scalar from PKCS#8 `PrivateKeyInfo` DER.
pub fn p256_secret_from_pkcs8_der(der : Bytes) -> Result[Bytes, CryptoError] {
  let key = match der_sequence(der, 0, der.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ver = match key.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_is_zero(ver) {
    return Err(CryptoError::InvalidDer)
  }
  let alg_span = match key.take(0x30) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let alg = DerReader::{ data: der, at: alg_span.0, end: alg_span.0 + alg_span.1 }
  let oid_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let curve_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let ec_oid = der_const_hex("2a8648ce3d0201")
  let p256_oid = der_const_hex("2a8648ce3d030107")
  if !alg.done() ||
  !der_slice_eq(der, oid_span.0, oid_span.1, ec_oid) ||
  !der_slice_eq(der, curve_span.0, curve_span.1, p256_oid) {
    return Err(CryptoError::InvalidKey)
  }
  let priv_span = match key.take(0x04) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !key.done() {
    return Err(CryptoError::InvalidDer)
  }
  let ec_seq = match der_sequence(der, priv_span.0, priv_span.1) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ec_ver = match ec_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_eq(ec_ver, big_from_u64(1UL)) {
    return Err(CryptoError::InvalidKey)
  }
  let sec_span = match ec_seq.take(0x04) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if sec_span.1 != 32 {
    return Err(CryptoError::InvalidKeyLength(sec_span.1))
  }
  // Optional [0] parameters (OID prime256v1)
  if ec_seq.peek_tag() == 0xA0 {
    let opt0 = match ec_seq.take(0xA0) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let p_rdr = DerReader::{ data: der, at: opt0.0, end: opt0.0 + opt0.1 }
    let p_oid = match p_rdr.take(0x06) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if !p_rdr.done() || !der_slice_eq(der, p_oid.0, p_oid.1, p256_oid) {
      return Err(CryptoError::InvalidKey)
    }
  }
  // Optional [1] publicKey (BIT STRING)
  if ec_seq.peek_tag() == 0xA1 {
    let opt1 = match ec_seq.take(0xA1) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let pk_rdr = DerReader::{ data: der, at: opt1.0, end: opt1.0 + opt1.1 }
    let bs = match pk_rdr.take(0x03) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if !pk_rdr.done() || bs.1 < 2 || (der[bs.0].to_int() & 0xFF) != 0 {
      return Err(CryptoError::InvalidDer)
    }
  }
  if !ec_seq.done() {
    return Err(CryptoError::InvalidDer)
  }
  let mut secret = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    secret[i] = der[sec_span.0 + i]
    i = i + 1
  }
  let d = big_from_be(secret)
  if big_is_zero(d) || big_cmp(d, p256_n()) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  Ok(secret)
}

///| Parse a 32-byte P-256 private scalar from PKCS#8 PEM (`-----BEGIN PRIVATE KEY-----`).
pub fn p256_secret_from_pkcs8_pem(pem : String) -> Result[Bytes, CryptoError] {
  let der = match pem_decode(pem, "PRIVATE KEY") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  p256_secret_from_pkcs8_der(der)
}

///| `(p + 1) / 4` for NIST P-256 (`p ≡ 3 mod 4`), used for square roots mod `p`.
fn p256_p_plus_1_div_4() -> BigUint {
  let limbs : FixedArray[UInt64] = [
    0x00000000UL, 0x00000000UL, 0x40000000UL, 0x00000000UL,
    0x00000000UL, 0x40000000UL, 0xC0000000UL, 0x3FFFFFFFUL,
  ]
  BigUint::{ limbs: limbs, len: 8 }
}

///| Constant-time 4-bit windowed scalar multiplication `[k]P` for arbitrary point `P`.
fn p256_scalarmult_ct(ctx : P256Ctx, k_bytes : Bytes, base : P256Point) -> P256Point {
  let p1 = base
  let p2 = p256_dbl(ctx, p1)
  let p3 = p256_add(ctx, p2, p1)
  let p4 = p256_dbl(ctx, p2)
  let p5 = p256_add(ctx, p4, p1)
  let p6 = p256_dbl(ctx, p3)
  let p7 = p256_add(ctx, p6, p1)
  let p8 = p256_dbl(ctx, p4)
  let p9 = p256_add(ctx, p8, p1)
  let p10 = p256_dbl(ctx, p5)
  let p11 = p256_add(ctx, p10, p1)
  let p12 = p256_dbl(ctx, p6)
  let p13 = p256_add(ctx, p12, p1)
  let p14 = p256_dbl(ctx, p7)
  let p15 = p256_add(ctx, p14, p1)
  let table : FixedArray[P256Point] = [
    p256_infinity(ctx), p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15,
  ]

  let mut acc = p256_infinity(ctx)
  let mut idx = 0
  while idx < 32 {
    let b = k_bytes[idx].to_int() & 0xFF
    let hi = (b >> 4) & 0xF
    acc = p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, acc))))
    let mut picked_hi = table[0]
    let mut j = 1
    while j < 16 {
      picked_hi = p256_cmov(picked_hi, table[j], ct_eq_nibble(hi, j).to_uint64())
      j = j + 1
    }
    acc = p256_add(ctx, acc, picked_hi)

    let lo = b & 0xF
    acc = p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, p256_dbl(ctx, acc))))
    let mut picked_lo = table[0]
    let mut m = 1
    while m < 16 {
      picked_lo = p256_cmov(picked_lo, table[m], ct_eq_nibble(lo, m).to_uint64())
      m = m + 1
    }
    acc = p256_add(ctx, acc, picked_lo)
    idx = idx + 1
  }
  acc
}

///| Parse and strictly validate a SEC1 uncompressed (65B `0x04 || X || Y`) or compressed
///| (33B `0x02/0x03 || X`) NIST P-256 public key into affine `(X, Y)`.
fn p256_parse_sec1_pubkey(ctx : P256Ctx, pubkey : Bytes) -> Result[(BigUint, BigUint), CryptoError] {
  let len = pubkey.length()
  if len == 1 && (pubkey[0].to_int() & 0xFF) == 0x00 {
    return Err(CryptoError::InvalidPoint)
  }
  if len == 65 {
    if (pubkey[0].to_int() & 0xFF) != 0x04 {
      return Err(CryptoError::InvalidPoint)
    }
    let x = big_from_be_slice(pubkey, 1, 32)
    let y = big_from_be_slice(pubkey, 33, 32)
    if big_cmp(x, ctx.p) >= 0 || big_cmp(y, ctx.p) >= 0 {
      return Err(CryptoError::InvalidPoint)
    }
    let xm = fp_to_mont(ctx, x)
    let ym = fp_to_mont(ctx, y)
    let lhs = fp_from_mont(ctx, fp_mul(ctx, ym, ym))
    let x2 = fp_mul(ctx, xm, xm)
    let x3 = fp_mul(ctx, x2, xm)
    let x3_m_3x = fp_sub(ctx, x3, fp_add(ctx, fp_add(ctx, xm, xm), xm))
    let rhs = fp_from_mont(ctx, fp_add(ctx, x3_m_3x, ctx.b_mont))
    if !big_eq(lhs, rhs) {
      return Err(CryptoError::InvalidPoint)
    }
    return Ok((x, y))
  }
  if len == 33 {
    let prefix = pubkey[0].to_int() & 0xFF
    if prefix != 0x02 && prefix != 0x03 {
      return Err(CryptoError::InvalidPoint)
    }
    let x = big_from_be_slice(pubkey, 1, 32)
    if big_cmp(x, ctx.p) >= 0 {
      return Err(CryptoError::InvalidPoint)
    }
    let xm = fp_to_mont(ctx, x)
    let x2 = fp_mul(ctx, xm, xm)
    let x3 = fp_mul(ctx, x2, xm)
    let x3_m_3x = fp_sub(ctx, x3, fp_add(ctx, fp_add(ctx, xm, xm), xm))
    let rhs = fp_from_mont(ctx, fp_add(ctx, x3_m_3x, ctx.b_mont))
    let y_root = big_mod_pow(rhs, p256_p_plus_1_div_4(), ctx.p)
    let ym = fp_to_mont(ctx, y_root)
    let check = fp_from_mont(ctx, fp_mul(ctx, ym, ym))
    if !big_eq(check, rhs) || big_is_zero(y_root) {
      return Err(CryptoError::InvalidPoint)
    }
    let want_odd = prefix == 0x03
    let y = if big_is_odd(y_root) == want_odd {
      y_root
    } else {
      big_sub(ctx.p, y_root)
    }
    return Ok((x, y))
  }
  Err(CryptoError::InvalidPublicKeyLength(len))
}

///| Validate a SEC1 uncompressed (65B `0x04 || X || Y`) or compressed (33B `0x02/0x03 || X`)
///| NIST P-256 public key (WebCrypto / OpenSSL / Go `crypto/ecdh` semantics).
pub fn p256_validate_pubkey(pubkey : Bytes) -> Bool {
  match p256_validate_pubkey_strict(pubkey) {
    Ok(_) => true
    Err(_) => false
  }
}

///| Strictly validate a SEC1 uncompressed (65B) or compressed (33B) NIST P-256 public key,
///| returning a detailed `CryptoError` on rejection.
pub fn p256_validate_pubkey_strict(pubkey : Bytes) -> Result[Unit, CryptoError] {
  let ctx = p256_ctx()
  match p256_parse_sec1_pubkey(ctx, pubkey) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

///| Validate and decompress a SEC1 uncompressed (65B) or compressed (33B) NIST P-256 public key
///| into canonical 65-byte uncompressed SEC1 form (`0x04 || X || Y`).
pub fn p256_decompress_pubkey(pubkey : Bytes) -> Result[Bytes, CryptoError] {
  let ctx = p256_ctx()
  let (x, y) = match p256_parse_sec1_pubkey(ctx, pubkey) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  let xb = big_to_be(x, 32)
  let yb = big_to_be(y, 32)
  let mut out = Bytes::new(65)
  out[0] = (0x04).to_byte()
  let mut i = 0
  while i < 32 {
    out[1 + i] = xb[i]
    out[33 + i] = yb[i]
    i = i + 1
  }
  Ok(out)
}

///| Constant-time range check `1 <= d < n` for a 32-byte big-endian secret scalar.
///| Walks all 8 fixed 32-bit limbs (least significant first) computing the borrow of `d - n`
///| and an OR-accumulator for `d != 0`, with no secret-dependent branch or early exit.
///| Returns 1 if the scalar is in range, 0 otherwise.
fn p256_scalar_valid_ct(secret : Bytes) -> UInt64 {
  let n = p256_n()
  let mut borrow = 0UL
  let mut acc = 0UL
  let mut i = 0
  while i < 8 {
    let off = 28 - 4 * i
    let limb = ((secret[off].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
    ((secret[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
    ((secret[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
    (secret[off + 3].to_int() & 0xFF).to_int64().to_uint64()
    let diff = limb - n.limbs[i] - borrow
    borrow = (diff >> 63UL) & 1UL
    acc = acc | limb
    i = i + 1
  }
  let nonzero = (acc + 0xFFFFFFFFUL) >> 32UL
  nonzero & borrow
}

///| NIST SP 800-56A P-256 ECDH key agreement.
///| Validates `secret` (`1 <= d < n`) and `peer_public` (65B uncompressed or 33B compressed SEC1),
///| returning the 32-byte big-endian shared secret X coordinate.
pub fn p256_ecdh(secret : Bytes, peer_public : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  if p256_scalar_valid_ct(secret) == 0UL {
    return Err(CryptoError::InvalidScalar)
  }
  let ctx = p256_ctx()
  let (px, py) = match p256_parse_sec1_pubkey(ctx, peer_public) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  let peer_pt = P256Point::{
    x: fp_to_mont(ctx, px),
    y: fp_to_mont(ctx, py),
    z: ctx.one_mont,
  }
  let shared_pt = p256_scalarmult_ct(ctx, secret, peer_pt)
  let aff = p256_affine(ctx, shared_pt)
  if !aff.2 {
    return Err(CryptoError::InvalidPoint)
  }
  Ok(big_to_be(aff.0, 32))
}
