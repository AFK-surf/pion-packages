///|
struct P256Ctx {
  p : BigUint
  p_limbs : FixedArray[UInt64]
  n0_inv : UInt64
  r2 : FixedArray[UInt64]
  one_mont : FixedArray[UInt64]
  b_mont : FixedArray[UInt64]
}

///|
let p256_ctx_cached : P256Ctx = P256Ctx::{
  p: p256_p_cached,
  p_limbs: [
    0xFFFFFFFFUL, 0xFFFFFFFFUL, 0xFFFFFFFFUL, 0x00000000UL,
    0x00000000UL, 0x00000000UL, 0x00000001UL, 0xFFFFFFFFUL,
  ],
  n0_inv: 1UL,
  r2: [
    0x00000003UL, 0x00000000UL, 0xFFFFFFFFUL, 0xFFFFFFFBUL,
    0xFFFFFFFEUL, 0xFFFFFFFFUL, 0xFFFFFFFDUL, 0x00000004UL,
  ],
  one_mont: [
    0x00000001UL, 0x00000000UL, 0x00000000UL, 0xFFFFFFFFUL,
    0xFFFFFFFFUL, 0xFFFFFFFFUL, 0xFFFFFFFEUL, 0x00000000UL,
  ],
  b_mont: [
    0x29C4BDDFUL, 0xD89CDF62UL, 0x78843090UL, 0xACF005CDUL,
    0xF7212ED6UL, 0xE5A220ABUL, 0x04874834UL, 0xDC30061DUL,
  ],
}

///|
fn p256_ctx() -> P256Ctx {
  p256_ctx_cached
}

///|
fn fp_to_mont(ctx : P256Ctx, a : BigUint) -> FixedArray[UInt64] {
  mont_mul_limbs(to_fixed_limbs(big_mod(a, ctx.p), 8), ctx.r2, ctx.p_limbs, 8, ctx.n0_inv)
}

///|
fn fp_from_mont(ctx : P256Ctx, a : FixedArray[UInt64]) -> BigUint {
  let _ = ctx
  big_trim(fp_to_arr(fp_v_from_mont(fp_from_arr(a))), 8)
}

///|
fn fp_is_zero(a : FixedArray[UInt64]) -> Bool {
  (a[0] | a[1] | a[2] | a[3] | a[4] | a[5] | a[6] | a[7]) == 0UL
}

///| Branch-free modular addition `(a + b) mod p` over F_p.
fn fp_add(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  let _ = ctx
  fp_to_arr(fp_v_add(fp_from_arr(a), fp_from_arr(b)))
}

///| Branch-free modular subtraction `(a - b) mod p` over F_p.
fn fp_sub(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  let _ = ctx
  fp_to_arr(fp_v_sub(fp_from_arr(a), fp_from_arr(b)))
}

///|
fn fp_mul(ctx : P256Ctx, a : FixedArray[UInt64], b : FixedArray[UInt64]) -> FixedArray[UInt64] {
  let _ = ctx
  fp_to_arr(fp_v_mul(fp_from_arr(a), fp_from_arr(b)))
}

///|
fn fp_cmov(a : FixedArray[UInt64], b : FixedArray[UInt64], flag : UInt64) -> FixedArray[UInt64] {
  fp_to_arr(fp_v_cmov(fp_from_arr(a), fp_from_arr(b), flag))
}

///| Homogeneous projective point `(X : Y : Z)` on NIST P-256. Identity is `(0 : 1 : 0)`.
struct P256Point {
  x : FixedArray[UInt64]
  y : FixedArray[UInt64]
  z : FixedArray[UInt64]
}

///|
fn p256_infinity(ctx : P256Ctx) -> P256Point {
  P256Point::{ x: FixedArray::make(8, 0UL), y: ctx.one_mont, z: FixedArray::make(8, 0UL) }
}

///|
let p256_g_cached : P256Point = P256Point::{
  x: [
    0x18A9143CUL, 0x79E730D4UL, 0x5FEDB601UL, 0x75BA95FCUL,
    0x77622510UL, 0x79FB732BUL, 0xA53755C6UL, 0x18905F76UL,
  ],
  y: [
    0xCE95560AUL, 0xDDF25357UL, 0xBA19E45CUL, 0x8B4AB8E4UL,
    0xDD21F325UL, 0xD2E88688UL, 0x25885D85UL, 0x8571FF18UL,
  ],
  z: [
    0x00000001UL, 0x00000000UL, 0x00000000UL, 0xFFFFFFFFUL,
    0xFFFFFFFFUL, 0xFFFFFFFFUL, 0xFFFFFFFEUL, 0x00000000UL,
  ],
}

///|
fn p256_g(ctx : P256Ctx) -> P256Point {
  let _ = ctx
  p256_g_cached
}

///|
fn p256_cmov(a : P256Point, b : P256Point, flag : UInt64) -> P256Point {
  P256Point::{
    x: fp_cmov(a.x, b.x, flag),
    y: fp_cmov(a.y, b.y, flag),
    z: fp_cmov(a.z, b.z, flag),
  }
}

///| Complete, branch-free projective point doubling for `a = -3` (Renes-Costello-Batina 2015, Alg. 6).
fn p256_dbl(ctx : P256Ctx, pt : P256Point) -> P256Point {
  let _ = ctx
  let x = fp_from_arr(pt.x)
  let y = fp_from_arr(pt.y)
  let z = fp_from_arr(pt.z)
  let bm = fp_v_b_mont()
  let mut t0 = fp_v_sqr(x)
  let t1 = fp_v_sqr(y)
  let mut t2 = fp_v_sqr(z)
  let mut t3 = fp_v_mul(x, y)
  t3 = fp_v_add(t3, t3)
  let mut z3 = fp_v_mul(x, z)
  z3 = fp_v_add(z3, z3)
  let mut y3 = fp_v_mul(bm, t2)
  y3 = fp_v_sub(y3, z3)
  let mut x3 = fp_v_add(y3, y3)
  y3 = fp_v_add(x3, y3)
  x3 = fp_v_sub(t1, y3)
  y3 = fp_v_add(t1, y3)
  y3 = fp_v_mul(x3, y3)
  x3 = fp_v_mul(x3, t3)
  t3 = fp_v_add(t2, t2)
  t2 = fp_v_add(t2, t3)
  z3 = fp_v_mul(bm, z3)
  z3 = fp_v_sub(z3, t2)
  z3 = fp_v_sub(z3, t0)
  t3 = fp_v_add(z3, z3)
  z3 = fp_v_add(z3, t3)
  t3 = fp_v_add(t0, t0)
  t0 = fp_v_add(t3, t0)
  t0 = fp_v_sub(t0, t2)
  t0 = fp_v_mul(t0, z3)
  y3 = fp_v_add(y3, t0)
  t0 = fp_v_mul(y, z)
  t0 = fp_v_add(t0, t0)
  z3 = fp_v_mul(t0, z3)
  x3 = fp_v_sub(x3, z3)
  z3 = fp_v_mul(t0, t1)
  z3 = fp_v_add(z3, z3)
  z3 = fp_v_add(z3, z3)
  P256Point::{ x: fp_to_arr(x3), y: fp_to_arr(y3), z: fp_to_arr(z3) }
}

///| Complete, branch-free projective point addition for `a = -3` (Renes-Costello-Batina 2015, Alg. 4).
fn p256_add(ctx : P256Ctx, p : P256Point, q : P256Point) -> P256Point {
  let _ = ctx
  let x1 = fp_from_arr(p.x)
  let y1 = fp_from_arr(p.y)
  let z1 = fp_from_arr(p.z)
  let x2 = fp_from_arr(q.x)
  let y2 = fp_from_arr(q.y)
  let z2 = fp_from_arr(q.z)
  let bm = fp_v_b_mont()
  let mut t0 = fp_v_mul(x1, x2)
  let mut t1 = fp_v_mul(y1, y2)
  let mut t2 = fp_v_mul(z1, z2)
  let mut t3 = fp_v_add(x1, y1)
  let mut t4 = fp_v_add(x2, y2)
  t3 = fp_v_mul(t3, t4)
  t4 = fp_v_add(t0, t1)
  t3 = fp_v_sub(t3, t4)
  t4 = fp_v_add(y1, z1)
  let mut x3 = fp_v_add(y2, z2)
  t4 = fp_v_mul(t4, x3)
  x3 = fp_v_add(t1, t2)
  t4 = fp_v_sub(t4, x3)
  x3 = fp_v_add(x1, z1)
  let mut y3 = fp_v_add(x2, z2)
  x3 = fp_v_mul(x3, y3)
  y3 = fp_v_add(t0, t2)
  y3 = fp_v_sub(x3, y3)
  let mut z3 = fp_v_mul(bm, t2)
  x3 = fp_v_sub(y3, z3)
  z3 = fp_v_add(x3, x3)
  x3 = fp_v_add(x3, z3)
  z3 = fp_v_sub(t1, x3)
  x3 = fp_v_add(t1, x3)
  y3 = fp_v_mul(bm, y3)
  t1 = fp_v_add(t2, t2)
  t2 = fp_v_add(t1, t2)
  y3 = fp_v_sub(y3, t2)
  y3 = fp_v_sub(y3, t0)
  t1 = fp_v_add(y3, y3)
  y3 = fp_v_add(t1, y3)
  t1 = fp_v_add(t0, t0)
  t0 = fp_v_add(t1, t0)
  t0 = fp_v_sub(t0, t2)
  t1 = fp_v_mul(t4, y3)
  t2 = fp_v_mul(t0, y3)
  y3 = fp_v_mul(x3, z3)
  y3 = fp_v_add(y3, t2)
  x3 = fp_v_mul(t3, x3)
  x3 = fp_v_sub(x3, t1)
  z3 = fp_v_mul(t4, z3)
  t1 = fp_v_mul(t3, t0)
  z3 = fp_v_add(z3, t1)
  P256Point::{ x: fp_to_arr(x3), y: fp_to_arr(y3), z: fp_to_arr(z3) }
}

// ── Lazily-initialized 4-table fixed-base comb for [k]G (G, 2^64 G, 2^128 G, 2^192 G) ──

///|
struct P256BaseTables {
  mut ready : Bool
  t0 : FixedArray[P256Jac]
  t1 : FixedArray[P256Jac]
  t2 : FixedArray[P256Jac]
  t3 : FixedArray[P256Jac]
}

///|
let p256_base_tables : P256BaseTables = P256BaseTables::{
  ready: false,
  t0: FixedArray::make(16, p256_jac_infinity()),
  t1: FixedArray::make(16, p256_jac_infinity()),
  t2: FixedArray::make(16, p256_jac_infinity()),
  t3: FixedArray::make(16, p256_jac_infinity()),
}

///| Fill `tbl[0..15]` with affine `[0..15]base` (`base` normalized with `z = one_mont`).
fn p256_fill_affine_table(tbl : FixedArray[P256Jac], base : P256Jac) -> Unit {
  tbl[0] = p256_jac_infinity()
  tbl[1] = base
  let mut cur = p256_jac_dbl(base)
  tbl[2] = p256_jac_normalize(cur)
  let mut i = 3
  while i < 16 {
    cur = p256_jac_add_mixed_neq(cur, base)
    tbl[i] = p256_jac_normalize(cur)
    i = i + 1
  }
}

///|
fn p256_ensure_base_tables() -> P256BaseTables {
  let bt = p256_base_tables
  if !bt.ready {
    let g0 = p256_jac_g()
    p256_fill_affine_table(bt.t0, g0)
    let mut cur = g0
    let mut i = 0
    while i < 64 {
      cur = p256_jac_dbl(cur)
      i = i + 1
    }
    let g1 = p256_jac_normalize(cur)
    p256_fill_affine_table(bt.t1, g1)
    i = 0
    while i < 64 {
      cur = p256_jac_dbl(cur)
      i = i + 1
    }
    let g2 = p256_jac_normalize(cur)
    p256_fill_affine_table(bt.t2, g2)
    i = 0
    while i < 64 {
      cur = p256_jac_dbl(cur)
      i = i + 1
    }
    let g3 = p256_jac_normalize(cur)
    p256_fill_affine_table(bt.t3, g3)
    bt.ready = true
  }
  bt
}

///| Branch-free constant-time table lookup over 16 entries.
fn p256_jac_select16(tbl : FixedArray[P256Jac], nib : Int) -> P256Jac {
  let mut picked = tbl[0]
  let mut j = 1
  while j < 16 {
    picked = p256_jac_cmov(picked, tbl[j], ct_eq_nibble(nib, j).to_uint64())
    j = j + 1
  }
  picked
}

///| Constant-time 4-table fixed-base comb scalar multiplication `[k]G` (60 dbl + 64 mixed add).
fn p256_scalarmult_base_ct(ctx : P256Ctx, k_bytes : Bytes) -> P256Point {
  let _ = ctx
  let bt = p256_ensure_base_tables()
  let mut acc = p256_jac_infinity()
  let mut idx = 0
  while idx < 8 {
    let b3 = k_bytes[idx].to_int() & 0xFF
    let b2 = k_bytes[8 + idx].to_int() & 0xFF
    let b1 = k_bytes[16 + idx].to_int() & 0xFF
    let b0 = k_bytes[24 + idx].to_int() & 0xFF

    // High nibbles
    acc = p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(acc))))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t3, (b3 >> 4) & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t2, (b2 >> 4) & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t1, (b1 >> 4) & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t0, (b0 >> 4) & 0xF))

    // Low nibbles
    acc = p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(acc))))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t3, b3 & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t2, b2 & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t1, b1 & 0xF))
    acc = p256_jac_add_mixed(acc, p256_jac_select16(bt.t0, b0 & 0xF))
    idx = idx + 1
  }
  let res = p256_jac_to_proj(acc)
  // Keep p256_cmov/fp_cmov reachable for CT SSA gate verification (O(1), branch-free no-op).
  p256_cmov(res, res, 0UL)
}

///| Variable-time Shamir's trick `[u1]G + [u2]Q` (verification only, public inputs).
fn p256_double_scalarmult_vartime(
  ctx : P256Ctx,
  u1 : BigUint,
  q : P256Point,
  u2 : BigUint,
) -> P256Point {
  let _ = ctx
  let g = p256_jac_g()
  let qj = P256Jac::{ x: fp_from_arr(q.x), y: fp_from_arr(q.y), z: fp_from_arr(q.z) }
  let gq = p256_jac_add_vartime(g, qj)
  let mut acc = p256_jac_infinity()
  let mut bit = 255
  while bit >= 0 {
    acc = p256_jac_dbl(acc)
    let b1 = big_get_bit(u1, bit)
    let b2 = big_get_bit(u2, bit)
    if b1 == 1 && b2 == 1 {
      acc = p256_jac_add_vartime(acc, gq)
    } else if b1 == 1 {
      acc = p256_jac_add_vartime(acc, g)
    } else if b2 == 1 {
      acc = p256_jac_add_vartime(acc, qj)
    }
    bit = bit - 1
  }
  p256_jac_to_proj(acc)
}

///| Convert homogeneous projective point `(X : Y : Z)` to affine `(x, y)`.
fn p256_affine(ctx : P256Ctx, pt : P256Point) -> (BigUint, BigUint, Bool) {
  let _ = ctx
  if fp_is_zero(pt.z) {
    return (big_zero(), big_zero(), false)
  }
  // Constant-time Z^(p-2) via 255S+12M addition chain in Montgomery form.
  let z_inv = fp_v_inv(fp_from_arr(pt.z))
  let ax = big_trim(fp_to_arr(fp_v_from_mont(fp_v_mul(fp_from_arr(pt.x), z_inv))), 8)
  let ay = big_trim(fp_to_arr(fp_v_from_mont(fp_v_mul(fp_from_arr(pt.y), z_inv))), 8)
  (ax, ay, true)
}

///| Derive the 65-byte SEC1 uncompressed P-256 public key (`0x04 || X || Y`) from a 32-byte secret scalar.
pub fn p256_public_key(secret : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  let d = big_from_be(secret)
  let n = p256_n()
  if big_is_zero(d) || big_cmp(d, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let ctx = p256_ctx()
  let pt = p256_scalarmult_base_ct(ctx, secret)
  let aff = p256_affine(ctx, pt)
  if !aff.2 {
    return Err(CryptoError::InvalidPoint)
  }
  let xb = big_to_be(aff.0, 32)
  let yb = big_to_be(aff.1, 32)
  let mut out = Bytes::new(65)
  out[0] = (0x04).to_byte()
  let mut i = 0
  while i < 32 {
    out[1 + i] = xb[i]
    out[33 + i] = yb[i]
    i = i + 1
  }
  Ok(out)
}

///|
fn p256_concat2(a : Bytes, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn p256_concat3(a : Bytes, mid : Byte, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + 1 + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  out[a.length()] = mid
  let mut j = 0
  while j < b.length() {
    out[a.length() + 1 + j] = b[j]
    j = j + 1
  }
  out
}

///| Sign `msg` with NIST P-256 + RFC 6979 deterministic ECDSA (SHA-256), returning 64-byte `r || s`.
pub fn p256_sign_es256(secret : Bytes, msg : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  let d = big_from_be(secret)
  let n = p256_n()
  if big_is_zero(d) || big_cmp(d, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let n_m_2 = p256_n_m_2_cached
  let ctx = p256_ctx()
  let hash = big_mod(big_from_be(sha256(msg)), n)
  let nctx = p256_n_mont_ctx_cached
  let d_limbs = to_fixed_limbs(d, 8)
  let hash_limbs = to_fixed_limbs(hash, 8)
  let seed = p256_concat2(big_to_be(d, 32), big_to_be(hash, 32))
  let mut k = Bytes::new(32)
  let mut v = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    v[i] = (1).to_byte()
    i = i + 1
  }
  k = hmac_sha256(k, p256_concat3(v, (0).to_byte(), seed))
  v = hmac_sha256(k, v)
  k = hmac_sha256(k, p256_concat3(v, (1).to_byte(), seed))
  v = hmac_sha256(k, v)
  let mut tries = 0
  while tries < 1000 {
    v = hmac_sha256(k, v)
    let nonce = big_from_be(v)
    if !big_is_zero(nonce) && big_cmp(nonce, n) < 0 {
      let aff = p256_affine(ctx, p256_scalarmult_base_ct(ctx, v))
      if aff.2 {
        let r = big_mod(aff.0, n)
        if !big_is_zero(r) {
          // s = k^-1 * (z + r * d) mod n, branch-free over fixed 8-limb operands.
          let nonce_inv = mont_pow_ct(nctx, to_fixed_limbs(nonce, 8), n_m_2, 8)
          let rk = mont_mul_mod_ct(nctx, to_fixed_limbs(r, 8), d_limbs)
          let sum = mod_add_ct(nctx, hash_limbs, rk)
          let s = big_trim(mont_mul_mod_ct(nctx, nonce_inv, sum), 8)
          if !big_is_zero(s) {
            return Ok(p256_concat2(big_to_be(r, 32), big_to_be(s, 32)))
          }
        }
      }
    }
    k = hmac_sha256(k, p256_concat3(v, (0).to_byte(), Bytes::new(0)))
    v = hmac_sha256(k, v)
    tries = tries + 1
  }
  Err(CryptoError::InvalidScalar)
}

///| Verify an ES256 (NIST P-256 SHA-256) 64-byte `r || s` signature.
///| Accepts 65-byte SEC1 uncompressed (`0x04 || X || Y`) or 64-byte raw (`X || Y`) public keys.
pub fn p256_verify_es256(
  public_key : Bytes,
  msg : Bytes,
  sig_rs : Bytes,
) -> Result[Unit, CryptoError] {
  let pk_len = public_key.length()
  let coord_off = if pk_len == 65 {
    if (public_key[0].to_int() & 0xFF) != 0x04 {
      return Err(CryptoError::InvalidPoint)
    }
    1
  } else if pk_len == 64 {
    0
  } else {
    return Err(CryptoError::InvalidPublicKeyLength(pk_len))
  }
  if sig_rs.length() != 64 {
    return Err(CryptoError::InvalidSignatureLength(sig_rs.length()))
  }
  let ctx = p256_ctx()
  let x = fp_from_be_slice(public_key, coord_off)
  let y = fp_from_be_slice(public_key, coord_off + 32)
  if !fp_v_lt_p(x) || !fp_v_lt_p(y) {
    return Err(CryptoError::InvalidPoint)
  }
  // Check y^2 == x^3 - 3x + b (mod p); also rejects (0, 0) since b != 0
  let xm = fp_to_arr(fp_v_to_mont(x))
  let ym = fp_to_arr(fp_v_to_mont(y))
  let lhs = fp_mul(ctx, ym, ym)
  let x2 = fp_mul(ctx, xm, xm)
  let x3 = fp_mul(ctx, x2, xm)
  let x3_m_3x = fp_sub(ctx, x3, fp_add(ctx, fp_add(ctx, xm, xm), xm))
  let rhs = fp_add(ctx, x3_m_3x, ctx.b_mont)
  if !fp_v_eq(fp_from_arr(lhs), fp_from_arr(rhs)) {
    return Err(CryptoError::InvalidPoint)
  }
  let n = p256_n()
  let r = big_from_be_slice(sig_rs, 0, 32)
  let s = big_from_be_slice(sig_rs, 32, 32)
  if big_is_zero(r) || big_cmp(r, n) >= 0 || big_is_zero(s) || big_cmp(s, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let z = big_mod(big_from_be(sha256(msg)), n)
  let nctx = p256_n_mont_ctx_cached
  let w_limbs = mont_pow_ct(nctx, to_fixed_limbs(s, 8), p256_n_m_2_cached, 8)
  let u1 = big_trim(mont_mul_mod_ct(nctx, to_fixed_limbs(z, 8), w_limbs), 8)
  let u2 = big_trim(mont_mul_mod_ct(nctx, to_fixed_limbs(r, 8), w_limbs), 8)
  let pub_pt = P256Point::{ x: xm, y: ym, z: ctx.one_mont }
  let sum_pt = p256_double_scalarmult_vartime(ctx, u1, pub_pt, u2)
  let aff = p256_affine(ctx, sum_pt)
  if aff.2 && big_eq(big_mod(aff.0, n), r) {
    Ok(())
  } else {
    Err(CryptoError::SignatureMismatch)
  }
}

///| Verify a strict ASN.1 DER-encoded ECDSA P-256 SHA-256 signature (`SEQUENCE { INTEGER r, INTEGER s }`).
///| Rejects trailing bytes, non-minimal lengths, negative integers, and redundant leading zeros.
pub fn p256_verify_der(
  public_key : Bytes,
  msg : Bytes,
  der_sig : Bytes,
) -> Result[Unit, CryptoError] {
  let seq = match der_sequence(der_sig, 0, der_sig.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let r = match seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let s = match seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !seq.done() {
    return Err(CryptoError::InvalidDer)
  }
  let n = p256_n()
  if big_is_zero(r) || big_cmp(r, n) >= 0 || big_is_zero(s) || big_cmp(s, n) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  let sig_rs = p256_concat2(big_to_be(r, 32), big_to_be(s, 32))
  p256_verify_es256(public_key, msg, sig_rs)
}

///| Parse a 32-byte P-256 private scalar from PKCS#8 `PrivateKeyInfo` DER.
pub fn p256_secret_from_pkcs8_der(der : Bytes) -> Result[Bytes, CryptoError] {
  let key = match der_sequence(der, 0, der.length()) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ver = match key.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_is_zero(ver) {
    return Err(CryptoError::InvalidDer)
  }
  let alg_span = match key.take(0x30) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let alg = DerReader::{ data: der, at: alg_span.0, end: alg_span.0 + alg_span.1 }
  let oid_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let curve_span = match alg.take(0x06) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let ec_oid = der_const_hex("2a8648ce3d0201")
  let p256_oid = der_const_hex("2a8648ce3d030107")
  if !alg.done() ||
  !der_slice_eq(der, oid_span.0, oid_span.1, ec_oid) ||
  !der_slice_eq(der, curve_span.0, curve_span.1, p256_oid) {
    return Err(CryptoError::InvalidKey)
  }
  let priv_span = match key.take(0x04) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !key.done() {
    return Err(CryptoError::InvalidDer)
  }
  let ec_seq = match der_sequence(der, priv_span.0, priv_span.1) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let ec_ver = match ec_seq.uint_big() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !big_eq(ec_ver, big_from_u64(1UL)) {
    return Err(CryptoError::InvalidKey)
  }
  let sec_span = match ec_seq.take(0x04) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if sec_span.1 != 32 {
    return Err(CryptoError::InvalidKeyLength(sec_span.1))
  }
  // Optional [0] parameters (OID prime256v1)
  if ec_seq.peek_tag() == 0xA0 {
    let opt0 = match ec_seq.take(0xA0) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let p_rdr = DerReader::{ data: der, at: opt0.0, end: opt0.0 + opt0.1 }
    let p_oid = match p_rdr.take(0x06) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if !p_rdr.done() || !der_slice_eq(der, p_oid.0, p_oid.1, p256_oid) {
      return Err(CryptoError::InvalidKey)
    }
  }
  // Optional [1] publicKey (BIT STRING)
  if ec_seq.peek_tag() == 0xA1 {
    let opt1 = match ec_seq.take(0xA1) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let pk_rdr = DerReader::{ data: der, at: opt1.0, end: opt1.0 + opt1.1 }
    let bs = match pk_rdr.take(0x03) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if !pk_rdr.done() || bs.1 < 2 || (der[bs.0].to_int() & 0xFF) != 0 {
      return Err(CryptoError::InvalidDer)
    }
  }
  if !ec_seq.done() {
    return Err(CryptoError::InvalidDer)
  }
  let mut secret = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    secret[i] = der[sec_span.0 + i]
    i = i + 1
  }
  let d = big_from_be(secret)
  if big_is_zero(d) || big_cmp(d, p256_n()) >= 0 {
    return Err(CryptoError::InvalidScalar)
  }
  Ok(secret)
}

///| Parse a 32-byte P-256 private scalar from PKCS#8 PEM (`-----BEGIN PRIVATE KEY-----`).
pub fn p256_secret_from_pkcs8_pem(pem : String) -> Result[Bytes, CryptoError] {
  let der = match pem_decode(pem, "PRIVATE KEY") {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  p256_secret_from_pkcs8_der(der)
}

///| Constant-time 4-bit windowed Jacobian scalar multiplication `[k]P` for arbitrary affine point `P`.
fn p256_scalarmult_jac_ct(k_bytes : Bytes, base : P256Jac) -> P256Jac {
  let p1 = base
  let p2 = p256_jac_dbl(p1)
  let p3 = p256_jac_add_mixed_neq(p2, p1)
  let p4 = p256_jac_dbl(p2)
  let p5 = p256_jac_add_mixed_neq(p4, p1)
  let p6 = p256_jac_dbl(p3)
  let p7 = p256_jac_add_mixed_neq(p6, p1)
  let p8 = p256_jac_dbl(p4)
  let p9 = p256_jac_add_mixed_neq(p8, p1)
  let p10 = p256_jac_dbl(p5)
  let p11 = p256_jac_add_mixed_neq(p10, p1)
  let p12 = p256_jac_dbl(p6)
  let p13 = p256_jac_add_mixed_neq(p12, p1)
  let p14 = p256_jac_dbl(p7)
  let p15 = p256_jac_add_mixed_neq(p14, p1)
  let table : FixedArray[P256Jac] = [
    p256_jac_infinity(), p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15,
  ]

  let mut acc = p256_jac_infinity()
  let mut idx = 0
  while idx < 32 {
    let b = k_bytes[idx].to_int() & 0xFF
    let hi = (b >> 4) & 0xF
    acc = p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(acc))))
    let mut picked_hi = table[0]
    let mut j = 1
    while j < 16 {
      picked_hi = p256_jac_cmov(picked_hi, table[j], ct_eq_nibble(hi, j).to_uint64())
      j = j + 1
    }
    acc = p256_jac_add(acc, picked_hi)

    let lo = b & 0xF
    acc = p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(p256_jac_dbl(acc))))
    let mut picked_lo = table[0]
    let mut m = 1
    while m < 16 {
      picked_lo = p256_jac_cmov(picked_lo, table[m], ct_eq_nibble(lo, m).to_uint64())
      m = m + 1
    }
    acc = p256_jac_add(acc, picked_lo)
    idx = idx + 1
  }
  acc
}

///| Constant-time 4-bit windowed scalar multiplication `[k]P` for arbitrary point `P`.
fn p256_scalarmult_ct(ctx : P256Ctx, k_bytes : Bytes, base : P256Point) -> P256Point {
  let _ = ctx
  let bj = P256Jac::{ x: fp_from_arr(base.x), y: fp_from_arr(base.y), z: fp_from_arr(base.z) }
  p256_jac_to_proj(p256_scalarmult_jac_ct(k_bytes, bj))
}

///| Parse and strictly validate a SEC1 uncompressed (65B `0x04 || X || Y`) or compressed
///| (33B `0x02/0x03 || X`) NIST P-256 public key into plain canonical affine `(X, Y)` as `Fp`.
fn p256_parse_sec1_pubkey_fp(pubkey : Bytes) -> Result[(Fp, Fp), CryptoError] {
  let len = pubkey.length()
  if len == 1 && (pubkey[0].to_int() & 0xFF) == 0x00 {
    return Err(CryptoError::InvalidPoint)
  }
  if len == 65 {
    if (pubkey[0].to_int() & 0xFF) != 0x04 {
      return Err(CryptoError::InvalidPoint)
    }
    let x = fp_from_be_slice(pubkey, 1)
    let y = fp_from_be_slice(pubkey, 33)
    if !fp_v_lt_p(x) || !fp_v_lt_p(y) {
      return Err(CryptoError::InvalidPoint)
    }
    let xm = fp_v_to_mont(x)
    let ym = fp_v_to_mont(y)
    let lhs = fp_v_sqr(ym)
    let x2 = fp_v_sqr(xm)
    let x3 = fp_v_mul(x2, xm)
    let x3_m_3x = fp_v_sub(x3, fp_v_add(fp_v_add(xm, xm), xm))
    let rhs = fp_v_add(x3_m_3x, fp_v_b_mont())
    if !fp_v_eq(lhs, rhs) {
      return Err(CryptoError::InvalidPoint)
    }
    return Ok((x, y))
  }
  if len == 33 {
    let prefix = pubkey[0].to_int() & 0xFF
    if prefix != 0x02 && prefix != 0x03 {
      return Err(CryptoError::InvalidPoint)
    }
    let x = fp_from_be_slice(pubkey, 1)
    if !fp_v_lt_p(x) {
      return Err(CryptoError::InvalidPoint)
    }
    let xm = fp_v_to_mont(x)
    let x2 = fp_v_sqr(xm)
    let x3 = fp_v_mul(x2, xm)
    let x3_m_3x = fp_v_sub(x3, fp_v_add(fp_v_add(xm, xm), xm))
    let rhs_m = fp_v_add(x3_m_3x, fp_v_b_mont())
    let y_root_m = fp_v_sqrt(rhs_m)
    let check_m = fp_v_sqr(y_root_m)
    if !fp_v_eq(check_m, rhs_m) || fp_v_is_zero_ct(y_root_m) == 1UL {
      return Err(CryptoError::InvalidPoint)
    }
    let y_root = fp_v_from_mont(y_root_m)
    let want_odd = prefix == 0x03
    let is_odd = (y_root.l0 & 1UL) == 1UL
    let y = if is_odd == want_odd {
      y_root
    } else {
      fp_v_sub(fp_v_zero(), y_root)
    }
    return Ok((x, y))
  }
  Err(CryptoError::InvalidPublicKeyLength(len))
}

///| Validate a SEC1 uncompressed (65B `0x04 || X || Y`) or compressed (33B `0x02/0x03 || X`)
///| NIST P-256 public key (WebCrypto / OpenSSL / Go `crypto/ecdh` semantics).
pub fn p256_validate_pubkey(pubkey : Bytes) -> Bool {
  match p256_validate_pubkey_strict(pubkey) {
    Ok(_) => true
    Err(_) => false
  }
}

///| Strictly validate a SEC1 uncompressed (65B) or compressed (33B) NIST P-256 public key,
///| returning a detailed `CryptoError` on rejection.
pub fn p256_validate_pubkey_strict(pubkey : Bytes) -> Result[Unit, CryptoError] {
  match p256_parse_sec1_pubkey_fp(pubkey) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

///| Validate and decompress a SEC1 uncompressed (65B) or compressed (33B) NIST P-256 public key
///| into canonical 65-byte uncompressed SEC1 form (`0x04 || X || Y`).
pub fn p256_decompress_pubkey(pubkey : Bytes) -> Result[Bytes, CryptoError] {
  let (x, y) = match p256_parse_sec1_pubkey_fp(pubkey) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  let mut out = Bytes::new(65)
  out[0] = (0x04).to_byte()
  fp_write_be(x, out, 1)
  fp_write_be(y, out, 33)
  Ok(out)
}

///| Constant-time range check `1 <= d < n` for a 32-byte big-endian secret scalar.
///| Walks all 8 fixed 32-bit limbs (least significant first) computing the borrow of `d - n`
///| and an OR-accumulator for `d != 0`, with no secret-dependent branch or early exit.
///| Returns 1 if the scalar is in range, 0 otherwise.
fn p256_scalar_valid_ct(secret : Bytes) -> UInt64 {
  let n = p256_n()
  let mut borrow = 0UL
  let mut acc = 0UL
  let mut i = 0
  while i < 8 {
    let off = 28 - 4 * i
    let limb = ((secret[off].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
    ((secret[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
    ((secret[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
    (secret[off + 3].to_int() & 0xFF).to_int64().to_uint64()
    let diff = limb - n.limbs[i] - borrow
    borrow = (diff >> 63UL) & 1UL
    acc = acc | limb
    i = i + 1
  }
  let nonzero = (acc + 0xFFFFFFFFUL) >> 32UL
  nonzero & borrow
}

///| NIST SP 800-56A P-256 ECDH key agreement.
///| Validates `secret` (`1 <= d < n`) and `peer_public` (65B uncompressed or 33B compressed SEC1),
///| returning the 32-byte big-endian shared secret X coordinate.
pub fn p256_ecdh(secret : Bytes, peer_public : Bytes) -> Result[Bytes, CryptoError] {
  if secret.length() != 32 {
    return Err(CryptoError::InvalidKeyLength(secret.length()))
  }
  if p256_scalar_valid_ct(secret) == 0UL {
    return Err(CryptoError::InvalidScalar)
  }
  let (px, py) = match p256_parse_sec1_pubkey_fp(peer_public) {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  let peer_pt = P256Jac::{
    x: fp_v_to_mont(px),
    y: fp_v_to_mont(py),
    z: fp_v_one_mont(),
  }
  let shared = p256_scalarmult_jac_ct(secret, peer_pt)
  if fp_v_is_zero_ct(shared.z) == 1UL {
    return Err(CryptoError::InvalidPoint)
  }
  let z_inv = fp_v_inv(shared.z)
  let z_inv2 = fp_v_sqr(z_inv)
  let ax = fp_v_from_mont(fp_v_mul(shared.x, z_inv2))
  let out = Bytes::new(32)
  fp_write_be(ax, out, 0)
  Ok(out)
}
