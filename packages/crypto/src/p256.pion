///| NIST P-256 (secp256r1) + RFC 6979 deterministic ECDSA (ES256) + strict ASN.1 DER
///| verification (WebAuthn/Passkey compatible) + PKCS#8 DER/PEM key parsing.
///|
///| Constant-time signing, keygen & ECDH via:
///| - Zero-allocation stack-value `val struct Fp` (8x32-bit limbs) with multiplication-free
///|   P-256 Montgomery CIOS reduction and dedicated squaring
///| - Branch-free Jacobian doubling (3M+5S) and complete branch-free Jacobian addition
///| - Constant-time 4-bit windowed scalar multiplication (branch-free masked table scan)
///| - Addition-chain modular inversion `z^(p-2)` (255S+12M) and square root `x^((p+1)/4)` (253S+7M)

///| Stack-allocated field element over F_p (8 little-endian 32-bit limbs in UInt64).
val struct Fp {
  l0 : UInt64
  l1 : UInt64
  l2 : UInt64
  l3 : UInt64
  l4 : UInt64
  l5 : UInt64
  l6 : UInt64
  l7 : UInt64
}

///| Stack-allocated Jacobian point `(X : Y : Z)` representing `(X/Z^2, Y/Z^3)`. Infinity has `Z = 0`.
val struct P256Jac {
  x : Fp
  y : Fp
  z : Fp
}

///|
fn fp_v_zero() -> Fp {
  Fp::{ l0: 0UL, l1: 0UL, l2: 0UL, l3: 0UL, l4: 0UL, l5: 0UL, l6: 0UL, l7: 0UL }
}

///| `R mod p` (`1` in Montgomery domain).
fn fp_v_one_mont() -> Fp {
  Fp::{
    l0: 0x00000001UL,
    l1: 0x00000000UL,
    l2: 0x00000000UL,
    l3: 0xFFFFFFFFUL,
    l4: 0xFFFFFFFFUL,
    l5: 0xFFFFFFFFUL,
    l6: 0xFFFFFFFEUL,
    l7: 0x00000000UL,
  }
}

///| `R^2 mod p` for Montgomery conversion.
fn fp_v_r2_mont() -> Fp {
  Fp::{
    l0: 0x00000003UL,
    l1: 0x00000000UL,
    l2: 0xFFFFFFFFUL,
    l3: 0xFFFFFFFBUL,
    l4: 0xFFFFFFFEUL,
    l5: 0xFFFFFFFFUL,
    l6: 0xFFFFFFFDUL,
    l7: 0x00000004UL,
  }
}

///| `b * R mod p`.
fn fp_v_b_mont() -> Fp {
  Fp::{
    l0: 0x29C4BDDFUL,
    l1: 0xD89CDF62UL,
    l2: 0x78843090UL,
    l3: 0xACF005CDUL,
    l4: 0xF7212ED6UL,
    l5: 0xE5A220ABUL,
    l6: 0x04874834UL,
    l7: 0xDC30061DUL,
  }
}

///| `Gx * R mod p`.
fn fp_v_gx_mont() -> Fp {
  Fp::{
    l0: 0x18A9143CUL,
    l1: 0x79E730D4UL,
    l2: 0x5FEDB601UL,
    l3: 0x75BA95FCUL,
    l4: 0x77622510UL,
    l5: 0x79FB732BUL,
    l6: 0xA53755C6UL,
    l7: 0x18905F76UL,
  }
}

///| `Gy * R mod p`.
fn fp_v_gy_mont() -> Fp {
  Fp::{
    l0: 0xCE95560AUL,
    l1: 0xDDF25357UL,
    l2: 0xBA19E45CUL,
    l3: 0x8B4AB8E4UL,
    l4: 0xDD21F325UL,
    l5: 0xD2E88688UL,
    l6: 0x25885D85UL,
    l7: 0x8571FF18UL,
  }
}

///|
fn fp_from_arr(a : FixedArray[UInt64]) -> Fp {
  Fp::{ l0: a[0], l1: a[1], l2: a[2], l3: a[3], l4: a[4], l5: a[5], l6: a[6], l7: a[7] }
}

///|
fn fp_to_arr(a : Fp) -> FixedArray[UInt64] {
  [a.l0, a.l1, a.l2, a.l3, a.l4, a.l5, a.l6, a.l7]
}

///| Parse 32 big-endian bytes starting at `off` into `Fp`.
fn fp_from_be_slice(data : Bytes, off : Int) -> Fp {
  let l7 = ((data[off].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 1].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 2].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 3].to_int() & 0xFF).to_int64().to_uint64()
  let l6 = ((data[off + 4].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 5].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 6].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 7].to_int() & 0xFF).to_int64().to_uint64()
  let l5 = ((data[off + 8].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 9].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 10].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 11].to_int() & 0xFF).to_int64().to_uint64()
  let l4 = ((data[off + 12].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 13].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 14].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 15].to_int() & 0xFF).to_int64().to_uint64()
  let l3 = ((data[off + 16].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 17].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 18].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 19].to_int() & 0xFF).to_int64().to_uint64()
  let l2 = ((data[off + 20].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 21].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 22].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 23].to_int() & 0xFF).to_int64().to_uint64()
  let l1 = ((data[off + 24].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 25].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 26].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 27].to_int() & 0xFF).to_int64().to_uint64()
  let l0 = ((data[off + 28].to_int() & 0xFF).to_int64().to_uint64() << 24UL) |
  ((data[off + 29].to_int() & 0xFF).to_int64().to_uint64() << 16UL) |
  ((data[off + 30].to_int() & 0xFF).to_int64().to_uint64() << 8UL) |
  (data[off + 31].to_int() & 0xFF).to_int64().to_uint64()
  Fp::{ l0: l0, l1: l1, l2: l2, l3: l3, l4: l4, l5: l5, l6: l6, l7: l7 }
}

///| Write `Fp` (plain canonical form) as 32 big-endian bytes into `out` at `off`.
fn fp_write_be(a : Fp, out : Bytes, off : Int) -> Unit {
  let mut o = out
  o[off] = ((a.l7 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 1] = ((a.l7 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 2] = ((a.l7 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 3] = (a.l7 & 0xFFUL).to_int().to_byte()
  o[off + 4] = ((a.l6 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 5] = ((a.l6 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 6] = ((a.l6 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 7] = (a.l6 & 0xFFUL).to_int().to_byte()
  o[off + 8] = ((a.l5 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 9] = ((a.l5 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 10] = ((a.l5 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 11] = (a.l5 & 0xFFUL).to_int().to_byte()
  o[off + 12] = ((a.l4 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 13] = ((a.l4 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 14] = ((a.l4 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 15] = (a.l4 & 0xFFUL).to_int().to_byte()
  o[off + 16] = ((a.l3 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 17] = ((a.l3 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 18] = ((a.l3 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 19] = (a.l3 & 0xFFUL).to_int().to_byte()
  o[off + 20] = ((a.l2 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 21] = ((a.l2 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 22] = ((a.l2 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 23] = (a.l2 & 0xFFUL).to_int().to_byte()
  o[off + 24] = ((a.l1 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 25] = ((a.l1 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 26] = ((a.l1 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 27] = (a.l1 & 0xFFUL).to_int().to_byte()
  o[off + 28] = ((a.l0 >> 24UL) & 0xFFUL).to_int().to_byte()
  o[off + 29] = ((a.l0 >> 16UL) & 0xFFUL).to_int().to_byte()
  o[off + 30] = ((a.l0 >> 8UL) & 0xFFUL).to_int().to_byte()
  o[off + 31] = (a.l0 & 0xFFUL).to_int().to_byte()
}

///| Branch-free test `a == 0`, returning `1UL` if zero else `0UL`.
fn fp_v_is_zero_ct(a : Fp) -> UInt64 {
  let acc = a.l0 | a.l1 | a.l2 | a.l3 | a.l4 | a.l5 | a.l6 | a.l7
  1UL - ((acc + 0xFFFFFFFFUL) >> 32UL)
}

///| Check `a < p` (canonical field element).
fn fp_v_lt_p(a : Fp) -> Bool {
  let d0 = (a.l0 + 0x100000000UL) - 0xFFFFFFFFUL
  let b0 = 1UL - (d0 >> 32UL)
  let d1 = (a.l1 + 0x100000000UL) - 0xFFFFFFFFUL - b0
  let b1 = 1UL - (d1 >> 32UL)
  let d2 = (a.l2 + 0x100000000UL) - 0xFFFFFFFFUL - b1
  let b2 = 1UL - (d2 >> 32UL)
  let d3 = (a.l3 + 0x100000000UL) - b2
  let b3 = 1UL - (d3 >> 32UL)
  let d4 = (a.l4 + 0x100000000UL) - b3
  let b4 = 1UL - (d4 >> 32UL)
  let d5 = (a.l5 + 0x100000000UL) - b4
  let b5 = 1UL - (d5 >> 32UL)
  let d6 = (a.l6 + 0x100000000UL) - 1UL - b5
  let b6 = 1UL - (d6 >> 32UL)
  let d7 = (a.l7 + 0x100000000UL) - 0xFFFFFFFFUL - b6
  let borrow = 1UL - (d7 >> 32UL)
  borrow == 1UL
}

///|
fn fp_v_eq(a : Fp, b : Fp) -> Bool {
  ((a.l0 ^ b.l0) | (a.l1 ^ b.l1) | (a.l2 ^ b.l2) | (a.l3 ^ b.l3) | (a.l4 ^ b.l4) | (a.l5 ^ b.l5) | (a.l6 ^ b.l6) | (a.l7 ^ b.l7)) == 0UL
}

///| Branch-free conditional move: returns `b` if `flag == 1UL`, else `a`.
fn fp_v_cmov(a : Fp, b : Fp, flag : UInt64) -> Fp {
  let m = 0UL - flag
  Fp::{
    l0: a.l0 ^ (m & (a.l0 ^ b.l0)),
    l1: a.l1 ^ (m & (a.l1 ^ b.l1)),
    l2: a.l2 ^ (m & (a.l2 ^ b.l2)),
    l3: a.l3 ^ (m & (a.l3 ^ b.l3)),
    l4: a.l4 ^ (m & (a.l4 ^ b.l4)),
    l5: a.l5 ^ (m & (a.l5 ^ b.l5)),
    l6: a.l6 ^ (m & (a.l6 ^ b.l6)),
    l7: a.l7 ^ (m & (a.l7 ^ b.l7)),
  }
}

///| Branch-free `(a + b) mod p` over F_p (zero heap allocations).
fn fp_v_add(a : Fp, b : Fp) -> Fp {
  let r0 = a.l0 + b.l0; let s0 = r0 & 0xFFFFFFFFUL; let c0 = r0 >> 32UL
  let r1 = a.l1 + b.l1 + c0; let s1 = r1 & 0xFFFFFFFFUL; let c1 = r1 >> 32UL
  let r2 = a.l2 + b.l2 + c1; let s2 = r2 & 0xFFFFFFFFUL; let c2 = r2 >> 32UL
  let r3 = a.l3 + b.l3 + c2; let s3 = r3 & 0xFFFFFFFFUL; let c3 = r3 >> 32UL
  let r4 = a.l4 + b.l4 + c3; let s4 = r4 & 0xFFFFFFFFUL; let c4 = r4 >> 32UL
  let r5 = a.l5 + b.l5 + c4; let s5 = r5 & 0xFFFFFFFFUL; let c5 = r5 >> 32UL
  let r6 = a.l6 + b.l6 + c5; let s6 = r6 & 0xFFFFFFFFUL; let c6 = r6 >> 32UL
  let r7 = a.l7 + b.l7 + c6; let s7 = r7 & 0xFFFFFFFFUL; let carry = r7 >> 32UL

  let d0 = (s0 + 0x100000000UL) - 0xFFFFFFFFUL; let f0 = d0 & 0xFFFFFFFFUL; let b0 = 1UL - (d0 >> 32UL)
  let d1 = (s1 + 0x100000000UL) - 0xFFFFFFFFUL - b0; let f1 = d1 & 0xFFFFFFFFUL; let b1 = 1UL - (d1 >> 32UL)
  let d2 = (s2 + 0x100000000UL) - 0xFFFFFFFFUL - b1; let f2 = d2 & 0xFFFFFFFFUL; let b2 = 1UL - (d2 >> 32UL)
  let d3 = (s3 + 0x100000000UL) - b2; let f3 = d3 & 0xFFFFFFFFUL; let b3 = 1UL - (d3 >> 32UL)
  let d4 = (s4 + 0x100000000UL) - b3; let f4 = d4 & 0xFFFFFFFFUL; let b4 = 1UL - (d4 >> 32UL)
  let d5 = (s5 + 0x100000000UL) - b4; let f5 = d5 & 0xFFFFFFFFUL; let b5 = 1UL - (d5 >> 32UL)
  let d6 = (s6 + 0x100000000UL) - 1UL - b5; let f6 = d6 & 0xFFFFFFFFUL; let b6 = 1UL - (d6 >> 32UL)
  let d7 = (s7 + 0x100000000UL) - 0xFFFFFFFFUL - b6; let f7 = d7 & 0xFFFFFFFFUL; let borrow = 1UL - (d7 >> 32UL)

  let mask = 0UL - (1UL - ((carry - borrow) >> 63UL))
  Fp::{
    l0: s0 ^ (mask & (s0 ^ f0)),
    l1: s1 ^ (mask & (s1 ^ f1)),
    l2: s2 ^ (mask & (s2 ^ f2)),
    l3: s3 ^ (mask & (s3 ^ f3)),
    l4: s4 ^ (mask & (s4 ^ f4)),
    l5: s5 ^ (mask & (s5 ^ f5)),
    l6: s6 ^ (mask & (s6 ^ f6)),
    l7: s7 ^ (mask & (s7 ^ f7)),
  }
}

///| Branch-free `(a - b) mod p` over F_p (zero heap allocations).
fn fp_v_sub(a : Fp, b : Fp) -> Fp {
  let d0 = (a.l0 + 0x100000000UL) - b.l0; let f0 = d0 & 0xFFFFFFFFUL; let b0 = 1UL - (d0 >> 32UL)
  let d1 = (a.l1 + 0x100000000UL) - b.l1 - b0; let f1 = d1 & 0xFFFFFFFFUL; let b1 = 1UL - (d1 >> 32UL)
  let d2 = (a.l2 + 0x100000000UL) - b.l2 - b1; let f2 = d2 & 0xFFFFFFFFUL; let b2 = 1UL - (d2 >> 32UL)
  let d3 = (a.l3 + 0x100000000UL) - b.l3 - b2; let f3 = d3 & 0xFFFFFFFFUL; let b3 = 1UL - (d3 >> 32UL)
  let d4 = (a.l4 + 0x100000000UL) - b.l4 - b3; let f4 = d4 & 0xFFFFFFFFUL; let b4 = 1UL - (d4 >> 32UL)
  let d5 = (a.l5 + 0x100000000UL) - b.l5 - b4; let f5 = d5 & 0xFFFFFFFFUL; let b5 = 1UL - (d5 >> 32UL)
  let d6 = (a.l6 + 0x100000000UL) - b.l6 - b5; let f6 = d6 & 0xFFFFFFFFUL; let b6 = 1UL - (d6 >> 32UL)
  let d7 = (a.l7 + 0x100000000UL) - b.l7 - b6; let f7 = d7 & 0xFFFFFFFFUL; let borrow = 1UL - (d7 >> 32UL)

  let m = (0UL - borrow) & 0xFFFFFFFFUL
  let r0 = f0 + m; let o0 = r0 & 0xFFFFFFFFUL; let c0 = r0 >> 32UL
  let r1 = f1 + m + c0; let o1 = r1 & 0xFFFFFFFFUL; let c1 = r1 >> 32UL
  let r2 = f2 + m + c1; let o2 = r2 & 0xFFFFFFFFUL; let c2 = r2 >> 32UL
  let r3 = f3 + c2; let o3 = r3 & 0xFFFFFFFFUL; let c3 = r3 >> 32UL
  let r4 = f4 + c3; let o4 = r4 & 0xFFFFFFFFUL; let c4 = r4 >> 32UL
  let r5 = f5 + c4; let o5 = r5 & 0xFFFFFFFFUL; let c5 = r5 >> 32UL
  let r6 = f6 + borrow + c5; let o6 = r6 & 0xFFFFFFFFUL; let c6 = r6 >> 32UL
  let r7 = f7 + m + c6; let o7 = r7 & 0xFFFFFFFFUL
  Fp::{ l0: o0, l1: o1, l2: o2, l3: o3, l4: o4, l5: o5, l6: o6, l7: o7 }
}

///| Final branch-free conditional subtraction of `p` from `(t8 : t7..t0) < 2*p`.
fn fp_v_reduce_final(
  t0 : UInt64,
  t1 : UInt64,
  t2 : UInt64,
  t3 : UInt64,
  t4 : UInt64,
  t5 : UInt64,
  t6 : UInt64,
  t7 : UInt64,
  t8 : UInt64,
) -> Fp {
  let d0 = (t0 + 0x100000000UL) - 0xFFFFFFFFUL; let f0 = d0 & 0xFFFFFFFFUL; let b0 = 1UL - (d0 >> 32UL)
  let d1 = (t1 + 0x100000000UL) - 0xFFFFFFFFUL - b0; let f1 = d1 & 0xFFFFFFFFUL; let b1 = 1UL - (d1 >> 32UL)
  let d2 = (t2 + 0x100000000UL) - 0xFFFFFFFFUL - b1; let f2 = d2 & 0xFFFFFFFFUL; let b2 = 1UL - (d2 >> 32UL)
  let d3 = (t3 + 0x100000000UL) - b2; let f3 = d3 & 0xFFFFFFFFUL; let b3 = 1UL - (d3 >> 32UL)
  let d4 = (t4 + 0x100000000UL) - b3; let f4 = d4 & 0xFFFFFFFFUL; let b4 = 1UL - (d4 >> 32UL)
  let d5 = (t5 + 0x100000000UL) - b4; let f5 = d5 & 0xFFFFFFFFUL; let b5 = 1UL - (d5 >> 32UL)
  let d6 = (t6 + 0x100000000UL) - 1UL - b5; let f6 = d6 & 0xFFFFFFFFUL; let b6 = 1UL - (d6 >> 32UL)
  let d7 = (t7 + 0x100000000UL) - 0xFFFFFFFFUL - b6; let f7 = d7 & 0xFFFFFFFFUL; let borrow = 1UL - (d7 >> 32UL)
  let mask = 0UL - (1UL - ((t8 - borrow) >> 63UL))
  Fp::{
    l0: t0 ^ (mask & (t0 ^ f0)),
    l1: t1 ^ (mask & (t1 ^ f1)),
    l2: t2 ^ (mask & (t2 ^ f2)),
    l3: t3 ^ (mask & (t3 ^ f3)),
    l4: t4 ^ (mask & (t4 ^ f4)),
    l5: t5 ^ (mask & (t5 ^ f5)),
    l6: t6 ^ (mask & (t6 ^ f6)),
    l7: t7 ^ (mask & (t7 ^ f7)),
  }
}

///| Branch-free Montgomery multiplication `a * b * R^(-1) mod p` with multiplication-free P-256 reduction.
fn fp_v_mul(a : Fp, b : Fp) -> Fp {
  let b0 = b.l0; let b1 = b.l1; let b2 = b.l2; let b3 = b.l3
  let b4 = b.l4; let b5 = b.l5; let b6 = b.l6; let b7 = b.l7

  // i = 0 (initial t = 0)
  let mut ai = a.l0
  let mut s = ai * b0; let mut t0 = s & 0xFFFFFFFFUL; let mut c = s >> 32UL
  s = ai * b1 + c; let mut t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b2 + c; let mut t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b3 + c; let mut t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b4 + c; let mut t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b5 + c; let mut t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b6 + c; let mut t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = ai * b7 + c; let mut t7 = s & 0xFFFFFFFFUL; let mut t8 = s >> 32UL
  let mut u = t0; t0 = t1; t1 = t2
  let mut r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  // i = 1
  ai = a.l1
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; let mut t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 2
  ai = a.l2
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 3
  ai = a.l3
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 4
  ai = a.l4
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 5
  ai = a.l5
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 6
  ai = a.l6
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  // i = 7
  ai = a.l7
  s = t0 + ai * b0; t0 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t1 + ai * b1 + c; t1 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t2 + ai * b2 + c; t2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t3 + ai * b3 + c; t3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t4 + ai * b4 + c; t4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t5 + ai * b5 + c; t5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t6 + ai * b6 + c; t6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t7 + ai * b7 + c; t7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = t8 + c; t8 = s & 0xFFFFFFFFUL; t9 = s >> 32UL
  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = t9 + (r >> 32UL)

  fp_v_reduce_final(t0, t1, t2, t3, t4, t5, t6, t7, t8)
}

///| Branch-free Montgomery squaring `a^2 * R^(-1) mod p` (36 muls + multiplication-free P-256 reduction).
fn fp_v_sqr(a : Fp) -> Fp {
  let a0 = a.l0; let a1 = a.l1; let a2 = a.l2; let a3 = a.l3
  let a4 = a.l4; let a5 = a.l5; let a6 = a.l6; let a7 = a.l7

  // Cross products i < j (28 multiplies)
  let mut s = a0 * a1; let mut w1 = s & 0xFFFFFFFFUL; let mut c = s >> 32UL
  s = a0 * a2 + c; let mut w2 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = a0 * a3 + c; let mut w3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = a0 * a4 + c; let mut w4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = a0 * a5 + c; let mut w5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = a0 * a6 + c; let mut w6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = a0 * a7 + c; let mut w7 = s & 0xFFFFFFFFUL; let mut w8 = s >> 32UL

  s = w3 + a1 * a2; w3 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w4 + a1 * a3 + c; w4 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w5 + a1 * a4 + c; w5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w6 + a1 * a5 + c; w6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w7 + a1 * a6 + c; w7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w8 + a1 * a7 + c; w8 = s & 0xFFFFFFFFUL; let mut w9 = s >> 32UL

  s = w5 + a2 * a3; w5 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w6 + a2 * a4 + c; w6 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w7 + a2 * a5 + c; w7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w8 + a2 * a6 + c; w8 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w9 + a2 * a7 + c; w9 = s & 0xFFFFFFFFUL; let mut w10 = s >> 32UL

  s = w7 + a3 * a4; w7 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w8 + a3 * a5 + c; w8 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w9 + a3 * a6 + c; w9 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w10 + a3 * a7 + c; w10 = s & 0xFFFFFFFFUL; let mut w11 = s >> 32UL

  s = w9 + a4 * a5; w9 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w10 + a4 * a6 + c; w10 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w11 + a4 * a7 + c; w11 = s & 0xFFFFFFFFUL; let mut w12 = s >> 32UL

  s = w11 + a5 * a6; w11 = s & 0xFFFFFFFFUL; c = s >> 32UL
  s = w12 + a5 * a7 + c; w12 = s & 0xFFFFFFFFUL; let mut w13 = s >> 32UL

  s = w13 + a6 * a7; w13 = s & 0xFFFFFFFFUL; let mut w14 = s >> 32UL

  // Double cross products
  let mut w15 = w14 >> 31UL
  w14 = ((w14 << 1UL) | (w13 >> 31UL)) & 0xFFFFFFFFUL
  w13 = ((w13 << 1UL) | (w12 >> 31UL)) & 0xFFFFFFFFUL
  w12 = ((w12 << 1UL) | (w11 >> 31UL)) & 0xFFFFFFFFUL
  w11 = ((w11 << 1UL) | (w10 >> 31UL)) & 0xFFFFFFFFUL
  w10 = ((w10 << 1UL) | (w9 >> 31UL)) & 0xFFFFFFFFUL
  w9 = ((w9 << 1UL) | (w8 >> 31UL)) & 0xFFFFFFFFUL
  w8 = ((w8 << 1UL) | (w7 >> 31UL)) & 0xFFFFFFFFUL
  w7 = ((w7 << 1UL) | (w6 >> 31UL)) & 0xFFFFFFFFUL
  w6 = ((w6 << 1UL) | (w5 >> 31UL)) & 0xFFFFFFFFUL
  w5 = ((w5 << 1UL) | (w4 >> 31UL)) & 0xFFFFFFFFUL
  w4 = ((w4 << 1UL) | (w3 >> 31UL)) & 0xFFFFFFFFUL
  w3 = ((w3 << 1UL) | (w2 >> 31UL)) & 0xFFFFFFFFUL
  w2 = ((w2 << 1UL) | (w1 >> 31UL)) & 0xFFFFFFFFUL
  w1 = (w1 << 1UL) & 0xFFFFFFFFUL

  // Add diagonal squares (8 multiplies)
  let mut sq = a0 * a0
  let mut t0 = sq & 0xFFFFFFFFUL
  s = w1 + (sq >> 32UL); let mut t1 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a1 * a1
  s = w2 + (sq & 0xFFFFFFFFUL) + c; let mut t2 = s & 0xFFFFFFFFUL
  s = w3 + (sq >> 32UL) + (s >> 32UL); let mut t3 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a2 * a2
  s = w4 + (sq & 0xFFFFFFFFUL) + c; let mut t4 = s & 0xFFFFFFFFUL
  s = w5 + (sq >> 32UL) + (s >> 32UL); let mut t5 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a3 * a3
  s = w6 + (sq & 0xFFFFFFFFUL) + c; let mut t6 = s & 0xFFFFFFFFUL
  s = w7 + (sq >> 32UL) + (s >> 32UL); let mut t7 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a4 * a4
  s = w8 + (sq & 0xFFFFFFFFUL) + c; w8 = s & 0xFFFFFFFFUL
  s = w9 + (sq >> 32UL) + (s >> 32UL); w9 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a5 * a5
  s = w10 + (sq & 0xFFFFFFFFUL) + c; w10 = s & 0xFFFFFFFFUL
  s = w11 + (sq >> 32UL) + (s >> 32UL); w11 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a6 * a6
  s = w12 + (sq & 0xFFFFFFFFUL) + c; w12 = s & 0xFFFFFFFFUL
  s = w13 + (sq >> 32UL) + (s >> 32UL); w13 = s & 0xFFFFFFFFUL; c = s >> 32UL

  sq = a7 * a7
  s = w14 + (sq & 0xFFFFFFFFUL) + c; w14 = s & 0xFFFFFFFFUL
  w15 = w15 + (sq >> 32UL) + (s >> 32UL)

  // 8 rounds of multiplication-free P-256 Montgomery reduction
  let mut t8 = 0UL
  let mut u = t0; t0 = t1; t1 = t2
  let mut r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w8 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w9 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w10 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w11 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w12 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w13 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w14 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  u = t0; t0 = t1; t1 = t2
  r = t3 + u; t2 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
  r = t8 + w15 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL

  fp_v_reduce_final(t0, t1, t2, t3, t4, t5, t6, t7, t8)
}

///|
fn fp_v_sqr_n(a : Fp, n : Int) -> Fp {
  let mut r = a
  let mut i = 0
  while i < n {
    r = fp_v_sqr(r)
    i = i + 1
  }
  r
}

///| Constant-time modular inversion `a^(p - 2) mod p` in Montgomery form (255S + 12M).
fn fp_v_inv(a : Fp) -> Fp {
  let t1 = a
  let t2 = fp_v_mul(fp_v_sqr(t1), t1)
  let t3 = fp_v_mul(fp_v_sqr(t2), t1)
  let t6 = fp_v_mul(fp_v_sqr_n(t3, 3), t3)
  let t12 = fp_v_mul(fp_v_sqr_n(t6, 6), t6)
  let t15 = fp_v_mul(fp_v_sqr_n(t12, 3), t3)
  let t30 = fp_v_mul(fp_v_sqr_n(t15, 15), t15)
  let t32 = fp_v_mul(fp_v_sqr_n(t30, 2), t2)
  let mut r = fp_v_mul(fp_v_sqr_n(t32, 32), t1)
  r = fp_v_sqr_n(r, 96)
  r = fp_v_mul(fp_v_sqr_n(r, 32), t32)
  r = fp_v_mul(fp_v_sqr_n(r, 32), t32)
  r = fp_v_mul(fp_v_sqr_n(r, 30), t30)
  fp_v_mul(fp_v_sqr_n(r, 2), t1)
}

///| Constant-time square root `a^((p + 1) / 4) mod p` in Montgomery form (253S + 7M).
fn fp_v_sqrt(a : Fp) -> Fp {
  let t1 = a
  let t2 = fp_v_mul(fp_v_sqr(t1), t1)
  let t4 = fp_v_mul(fp_v_sqr_n(t2, 2), t2)
  let t8 = fp_v_mul(fp_v_sqr_n(t4, 4), t4)
  let t16 = fp_v_mul(fp_v_sqr_n(t8, 8), t8)
  let t32 = fp_v_mul(fp_v_sqr_n(t16, 16), t16)
  let mut r = fp_v_mul(fp_v_sqr_n(t32, 32), t1)
  r = fp_v_mul(fp_v_sqr_n(r, 96), t1)
  fp_v_sqr_n(r, 94)
}

///| Convert `a` from Montgomery form to plain canonical form: `a * R^(-1) mod p`.
fn fp_v_from_mont(a : Fp) -> Fp {
  let mut t0 = a.l0; let mut t1 = a.l1; let mut t2 = a.l2; let mut t3 = a.l3
  let mut t4 = a.l4; let mut t5 = a.l5; let mut t6 = a.l6; let mut t7 = a.l7
  let mut t8 = 0UL
  let mut i = 0
  while i < 8 {
    let u = t0; t0 = t1; t1 = t2
    let mut r = t3 + u; t2 = r & 0xFFFFFFFFUL; let mut c = r >> 32UL
    r = t4 + c; t3 = r & 0xFFFFFFFFUL; c = r >> 32UL
    r = t5 + c; t4 = r & 0xFFFFFFFFUL; c = r >> 32UL
    r = t6 + u + c; t5 = r & 0xFFFFFFFFUL; c = r >> 32UL
    r = t7 + ((u << 32UL) - u) + c; t6 = r & 0xFFFFFFFFUL; c = r >> 32UL
    r = t8 + c; t7 = r & 0xFFFFFFFFUL; t8 = r >> 32UL
    i = i + 1
  }
  fp_v_reduce_final(t0, t1, t2, t3, t4, t5, t6, t7, t8)
}

///| Convert plain `a < p` into Montgomery form: `a * R mod p`.
fn fp_v_to_mont(a : Fp) -> Fp {
  fp_v_mul(a, fp_v_r2_mont())
}

// ── Branch-free Jacobian point arithmetic (a = -3) ──

///|
fn p256_jac_infinity() -> P256Jac {
  P256Jac::{ x: fp_v_zero(), y: fp_v_one_mont(), z: fp_v_zero() }
}

///|
fn p256_jac_g() -> P256Jac {
  P256Jac::{ x: fp_v_gx_mont(), y: fp_v_gy_mont(), z: fp_v_one_mont() }
}

///|
fn p256_jac_cmov(a : P256Jac, b : P256Jac, flag : UInt64) -> P256Jac {
  P256Jac::{
    x: fp_v_cmov(a.x, b.x, flag),
    y: fp_v_cmov(a.y, b.y, flag),
    z: fp_v_cmov(a.z, b.z, flag),
  }
}

///| Branch-free Jacobian doubling for `a = -3` (3M + 5S; preserves infinity `Z = 0`).
fn p256_jac_dbl(pt : P256Jac) -> P256Jac {
  let x = pt.x
  let y = pt.y
  let z = pt.z
  let delta = fp_v_sqr(z)
  let gamma = fp_v_sqr(y)
  let beta = fp_v_mul(x, gamma)
  let t0 = fp_v_sub(x, delta)
  let t1 = fp_v_add(x, delta)
  let t2 = fp_v_mul(t0, t1)
  let alpha = fp_v_add(fp_v_add(t2, t2), t2)
  let b2 = fp_v_add(beta, beta)
  let b4 = fp_v_add(b2, b2)
  let b8 = fp_v_add(b4, b4)
  let x3 = fp_v_sub(fp_v_sqr(alpha), b8)
  let z3 = fp_v_sub(fp_v_sub(fp_v_sqr(fp_v_add(y, z)), gamma), delta)
  let g1 = fp_v_sqr(gamma)
  let g2 = fp_v_add(g1, g1)
  let g4 = fp_v_add(g2, g2)
  let g8 = fp_v_add(g4, g4)
  let y3 = fp_v_sub(fp_v_mul(alpha, fp_v_sub(b4, x3)), g8)
  P256Jac::{ x: x3, y: y3, z: z3 }
}

///| Complete, branch-free Jacobian addition `p1 + p2` (handles `O`, `P == Q`, `P == -Q`).
fn p256_jac_add(p1 : P256Jac, p2 : P256Jac) -> P256Jac {
  let z1_zero = fp_v_is_zero_ct(p1.z)
  let z2_zero = fp_v_is_zero_ct(p2.z)
  let z1z1 = fp_v_sqr(p1.z)
  let z2z2 = fp_v_sqr(p2.z)
  let u1 = fp_v_mul(p1.x, z2z2)
  let u2 = fp_v_mul(p2.x, z1z1)
  let s1 = fp_v_mul(p1.y, fp_v_mul(p2.z, z2z2))
  let s2 = fp_v_mul(p2.y, fp_v_mul(p1.z, z1z1))
  let h = fp_v_sub(u2, u1)
  let r = fp_v_sub(s2, s1)
  let h_zero = fp_v_is_zero_ct(h)
  let r_zero = fp_v_is_zero_ct(r)
  let hh = fp_v_sqr(h)
  let hhh = fp_v_mul(h, hh)
  let v = fp_v_mul(u1, hh)
  let x3 = fp_v_sub(fp_v_sub(fp_v_sqr(r), hhh), fp_v_add(v, v))
  let y3 = fp_v_sub(fp_v_mul(r, fp_v_sub(v, x3)), fp_v_mul(s1, hhh))
  let z3 = fp_v_mul(fp_v_mul(p1.z, p2.z), h)
  let dbl = p256_jac_dbl(p1)
  let is_dbl = (1UL - z1_zero) & (1UL - z2_zero) & h_zero & r_zero
  let mut rx = fp_v_cmov(x3, dbl.x, is_dbl)
  let mut ry = fp_v_cmov(y3, dbl.y, is_dbl)
  let mut rz = fp_v_cmov(z3, dbl.z, is_dbl)
  rx = fp_v_cmov(rx, p2.x, z1_zero)
  ry = fp_v_cmov(ry, p2.y, z1_zero)
  rz = fp_v_cmov(rz, p2.z, z1_zero)
  rx = fp_v_cmov(rx, p1.x, z2_zero)
  ry = fp_v_cmov(ry, p1.y, z2_zero)
  rz = fp_v_cmov(rz, p1.z, z2_zero)
  P256Jac::{ x: rx, y: ry, z: rz }
}

///| Complete, branch-free mixed Jacobian + Affine addition (`q.z` is `one_mont` or `0`).
fn p256_jac_add_mixed(p1 : P256Jac, q : P256Jac) -> P256Jac {
  let z1_zero = fp_v_is_zero_ct(p1.z)
  let z2_zero = fp_v_is_zero_ct(q.z)
  let z1z1 = fp_v_sqr(p1.z)
  let u2 = fp_v_mul(q.x, z1z1)
  let s2 = fp_v_mul(q.y, fp_v_mul(p1.z, z1z1))
  let h = fp_v_sub(u2, p1.x)
  let r = fp_v_sub(s2, p1.y)
  let h_zero = fp_v_is_zero_ct(h)
  let r_zero = fp_v_is_zero_ct(r)
  let hh = fp_v_sqr(h)
  let hhh = fp_v_mul(h, hh)
  let v = fp_v_mul(p1.x, hh)
  let x3 = fp_v_sub(fp_v_sub(fp_v_sqr(r), hhh), fp_v_add(v, v))
  let y3 = fp_v_sub(fp_v_mul(r, fp_v_sub(v, x3)), fp_v_mul(p1.y, hhh))
  let z3 = fp_v_mul(p1.z, h)
  let dbl = p256_jac_dbl(p1)
  let is_dbl = (1UL - z1_zero) & (1UL - z2_zero) & h_zero & r_zero
  let mut rx = fp_v_cmov(x3, dbl.x, is_dbl)
  let mut ry = fp_v_cmov(y3, dbl.y, is_dbl)
  let mut rz = fp_v_cmov(z3, dbl.z, is_dbl)
  rx = fp_v_cmov(rx, q.x, z1_zero)
  ry = fp_v_cmov(ry, q.y, z1_zero)
  rz = fp_v_cmov(rz, q.z, z1_zero)
  rx = fp_v_cmov(rx, p1.x, z2_zero)
  ry = fp_v_cmov(ry, p1.y, z2_zero)
  rz = fp_v_cmov(rz, p1.z, z2_zero)
  P256Jac::{ x: rx, y: ry, z: rz }
}

///| Fast non-complete mixed Jacobian + Affine addition (`p1 != O`, `q != O`, `p1 != ±q`, `q.z = 1`).
fn p256_jac_add_mixed_neq(p1 : P256Jac, q : P256Jac) -> P256Jac {
  let z1z1 = fp_v_sqr(p1.z)
  let u2 = fp_v_mul(q.x, z1z1)
  let s2 = fp_v_mul(q.y, fp_v_mul(p1.z, z1z1))
  let h = fp_v_sub(u2, p1.x)
  let r = fp_v_sub(s2, p1.y)
  let hh = fp_v_sqr(h)
  let hhh = fp_v_mul(h, hh)
  let v = fp_v_mul(p1.x, hh)
  let x3 = fp_v_sub(fp_v_sub(fp_v_sqr(r), hhh), fp_v_add(v, v))
  let y3 = fp_v_sub(fp_v_mul(r, fp_v_sub(v, x3)), fp_v_mul(p1.y, hhh))
  let z3 = fp_v_mul(p1.z, h)
  P256Jac::{ x: x3, y: y3, z: z3 }
}

///| Variable-time Jacobian addition (public inputs only, for ECDSA verification).
fn p256_jac_add_vartime(p1 : P256Jac, p2 : P256Jac) -> P256Jac {
  if fp_v_is_zero_ct(p1.z) == 1UL {
    return p2
  }
  if fp_v_is_zero_ct(p2.z) == 1UL {
    return p1
  }
  let z1z1 = fp_v_sqr(p1.z)
  let z2z2 = fp_v_sqr(p2.z)
  let u1 = fp_v_mul(p1.x, z2z2)
  let u2 = fp_v_mul(p2.x, z1z1)
  let s1 = fp_v_mul(p1.y, fp_v_mul(p2.z, z2z2))
  let s2 = fp_v_mul(p2.y, fp_v_mul(p1.z, z1z1))
  let h = fp_v_sub(u2, u1)
  let r = fp_v_sub(s2, s1)
  if fp_v_is_zero_ct(h) == 1UL {
    if fp_v_is_zero_ct(r) == 1UL {
      return p256_jac_dbl(p1)
    }
    return p256_jac_infinity()
  }
  let hh = fp_v_sqr(h)
  let hhh = fp_v_mul(h, hh)
  let v = fp_v_mul(u1, hh)
  let x3 = fp_v_sub(fp_v_sub(fp_v_sqr(r), hhh), fp_v_add(v, v))
  let y3 = fp_v_sub(fp_v_mul(r, fp_v_sub(v, x3)), fp_v_mul(s1, hhh))
  let z3 = fp_v_mul(fp_v_mul(p1.z, p2.z), h)
  P256Jac::{ x: x3, y: y3, z: z3 }
}

///| Convert Jacobian point to homogeneous projective `P256Point` `(X*Z : Y : Z^3)`.
fn p256_jac_to_proj(pt : P256Jac) -> P256Point {
  let z2 = fp_v_sqr(pt.z)
  let z3 = fp_v_mul(z2, pt.z)
  let px = fp_v_mul(pt.x, pt.z)
  P256Point::{ x: fp_to_arr(px), y: fp_to_arr(pt.y), z: fp_to_arr(z3) }
}

///| Normalize a non-infinity Jacobian point to affine (with `z = one_mont`).
fn p256_jac_normalize(pt : P256Jac) -> P256Jac {
  let zi = fp_v_inv(pt.z)
  let z2 = fp_v_sqr(zi)
  let z3 = fp_v_mul(z2, zi)
  P256Jac::{ x: fp_v_mul(pt.x, z2), y: fp_v_mul(pt.y, z3), z: fp_v_one_mont() }
}

