///| RFC 8018 PBKDF2-HMAC-SHA256 and PBKDF2-HMAC-SHA512 (pure Pion, zero World dependencies).

///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA256.
pub fn pbkdf2_hmac_sha256(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  let _ = (password, salt, iterations, dk_len)
  Err(CryptoError::InvalidParam)
}

///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA512.
pub fn pbkdf2_hmac_sha512(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  let _ = (password, salt, iterations, dk_len)
  Err(CryptoError::InvalidParam)
}
