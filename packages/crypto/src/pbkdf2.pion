    }
    out_off = out_off + take
    block = block + 1
  }
  Ok(out)
}

///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA512.
///| Rejects `iterations <= 0` (`InvalidParam`) and `dk_len <= 0` or `dk_len > 2^30` (1 GiB,
///| `InvalidLength`), checked before any allocation so `Bytes::new` / `n_blocks` cannot overflow.
pub fn pbkdf2_hmac_sha512(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  if iterations <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  if dk_len <= 0 || dk_len > 1073741824 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  let (ipad, opad) = hmac_sha512_init_pads(password, false)
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)

  let salt_len = salt.length()
  let salt_ctr_len = salt_len + 4
  let mut salt_ctr = Bytes::new(salt_ctr_len)
  let mut si = 0
  while si < salt_len {
    salt_ctr[si] = salt[si]
    si = si + 1
  }
  let salt_total_bytes = (128 + salt_ctr_len).to_int64()

  let inner_st : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let outer_st : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let u : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let t : FixedArray[UInt64] = FixedArray::make(8, 0UL)

  let mut out = Bytes::new(dk_len)
  let n_blocks = (dk_len - 1) / 64 + 1
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    let b_u = block.to_uint()
    salt_ctr[salt_len] = ((b_u >> 24U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 1] = ((b_u >> 16U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 2] = ((b_u >> 8U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 3] = (b_u & 0xFFU).to_int().to_byte()

    // U_1 = HMAC-SHA512(password, salt || INT_32_BE(block))
    inner_st[0] = ipad[0]
    inner_st[1] = ipad[1]
    inner_st[2] = ipad[2]
    inner_st[3] = ipad[3]
    inner_st[4] = ipad[4]
    inner_st[5] = ipad[5]
    inner_st[6] = ipad[6]
    inner_st[7] = ipad[7]
    sha512_update_final_state(inner_st, salt_ctr, 0, salt_ctr_len, salt_total_bytes, w)

    outer_st[0] = opad[0]
    outer_st[1] = opad[1]
    outer_st[2] = opad[2]
    outer_st[3] = opad[3]
    outer_st[4] = opad[4]
    outer_st[5] = opad[5]
    outer_st[6] = opad[6]
    outer_st[7] = opad[7]
    w[0] = inner_st[0]
    w[1] = inner_st[1]
    w[2] = inner_st[2]
    w[3] = inner_st[3]
    w[4] = inner_st[4]
    w[5] = inner_st[5]
    w[6] = inner_st[6]
    w[7] = inner_st[7]
    w[8] = 0x8000000000000000UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1536UL
    sha512_compress_w(outer_st, w)

    u[0] = outer_st[0]
    u[1] = outer_st[1]
    u[2] = outer_st[2]
    u[3] = outer_st[3]
    u[4] = outer_st[4]
    u[5] = outer_st[5]
    u[6] = outer_st[6]
    u[7] = outer_st[7]
    t[0] = outer_st[0]
    t[1] = outer_st[1]
    t[2] = outer_st[2]
    t[3] = outer_st[3]
    t[4] = outer_st[4]
    t[5] = outer_st[5]
    t[6] = outer_st[6]
    t[7] = outer_st[7]

    // U_2 .. U_iterations (zero heap allocations)
    let mut iter = 1
    while iter < iterations {
      inner_st[0] = ipad[0]
      inner_st[1] = ipad[1]
      inner_st[2] = ipad[2]
      inner_st[3] = ipad[3]
      inner_st[4] = ipad[4]
      inner_st[5] = ipad[5]
      inner_st[6] = ipad[6]
      inner_st[7] = ipad[7]
      w[0] = u[0]
      w[1] = u[1]
      w[2] = u[2]
      w[3] = u[3]
      w[4] = u[4]
      w[5] = u[5]
      w[6] = u[6]
      w[7] = u[7]
      w[8] = 0x8000000000000000UL
      w[9] = 0UL
      w[10] = 0UL
      w[11] = 0UL
      w[12] = 0UL
      w[13] = 0UL
      w[14] = 0UL
      w[15] = 1536UL
      sha512_compress_w(inner_st, w)

      outer_st[0] = opad[0]
      outer_st[1] = opad[1]
      outer_st[2] = opad[2]
      outer_st[3] = opad[3]
      outer_st[4] = opad[4]
      outer_st[5] = opad[5]
      outer_st[6] = opad[6]
      outer_st[7] = opad[7]
      w[0] = inner_st[0]
      w[1] = inner_st[1]
      w[2] = inner_st[2]
      w[3] = inner_st[3]
      w[4] = inner_st[4]
      w[5] = inner_st[5]
      w[6] = inner_st[6]
      w[7] = inner_st[7]
      w[8] = 0x8000000000000000UL
      w[9] = 0UL
      w[10] = 0UL
      w[11] = 0UL
      w[12] = 0UL
      w[13] = 0UL
      w[14] = 0UL
      w[15] = 1536UL
      sha512_compress_w(outer_st, w)

      u[0] = outer_st[0]
      u[1] = outer_st[1]
      u[2] = outer_st[2]
      u[3] = outer_st[3]
      u[4] = outer_st[4]
      u[5] = outer_st[5]
      u[6] = outer_st[6]
      u[7] = outer_st[7]
      t[0] = t[0] ^ outer_st[0]
      t[1] = t[1] ^ outer_st[1]
      t[2] = t[2] ^ outer_st[2]
      t[3] = t[3] ^ outer_st[3]
      t[4] = t[4] ^ outer_st[4]
      t[5] = t[5] ^ outer_st[5]
      t[6] = t[6] ^ outer_st[6]
      t[7] = t[7] ^ outer_st[7]
      iter = iter + 1
    }

    let rem = dk_len - out_off
    let take = if rem < 64 { rem } else { 64 }
    let mut k = 0
    while k < take {
      let word = t[k >> 3]
      let shift = 56 - ((k & 7) << 3)
      out[out_off + k] = ((word >> shift) & 0xFFUL).to_int().to_byte()
      k = k + 1
    }
    out_off = out_off + take
    block = block + 1
  }
  Ok(out)
}
