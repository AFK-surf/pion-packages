///| RFC 8018 PBKDF2-HMAC-SHA256 and PBKDF2-HMAC-SHA512 (pure Pion, zero World dependencies).
///| Zero-allocation hot loop: precomputes HMAC ipad/opad states once and iterates directly
///| over `FixedArray[UInt]` / `FixedArray[UInt64]` word states without per-iteration heap allocations.

///| Precompute HMAC-SHA256 inner and outer pad states once for `key`.
fn pbkdf2_hmac_sha256_pads(
  key : Bytes,
  ipad_state : FixedArray[UInt],
  opad_state : FixedArray[UInt],
  w : FixedArray[UInt],
) -> Unit {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  ipad_state[0] = 0x6a09e667U
  ipad_state[1] = 0xbb67ae85U
  ipad_state[2] = 0x3c6ef372U
  ipad_state[3] = 0xa54ff53aU
  ipad_state[4] = 0x510e527fU
  ipad_state[5] = 0x9b05688cU
  ipad_state[6] = 0x1f83d9abU
  ipad_state[7] = 0x5be0cd19U
  let mut i = 0
  while i < 16 {
    let p = i << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[i] = ((b0 ^ 0x36).to_uint() << 24U) |
    ((b1 ^ 0x36).to_uint() << 16U) |
    ((b2 ^ 0x36).to_uint() << 8U) |
    (b3 ^ 0x36).to_uint()
    i = i + 1
  }
  sha256_compress_w(ipad_state, w)

  opad_state[0] = 0x6a09e667U
  opad_state[1] = 0xbb67ae85U
  opad_state[2] = 0x3c6ef372U
  opad_state[3] = 0xa54ff53aU
  opad_state[4] = 0x510e527fU
  opad_state[5] = 0x9b05688cU
  opad_state[6] = 0x1f83d9abU
  opad_state[7] = 0x5be0cd19U
  let mut j = 0
  while j < 16 {
    let p = j << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[j] = ((b0 ^ 0x5C).to_uint() << 24U) |
    ((b1 ^ 0x5C).to_uint() << 16U) |
    ((b2 ^ 0x5C).to_uint() << 8U) |
    (b3 ^ 0x5C).to_uint()
    j = j + 1
  }
  sha256_compress_w(opad_state, w)
}

///|
val struct Sha256Digest {
  h0 : UInt
  h1 : UInt
  h2 : UInt
  h3 : UInt
  h4 : UInt
  h5 : UInt
  h6 : UInt
  h7 : UInt
}

