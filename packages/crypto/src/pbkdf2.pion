///| RFC 8018 PBKDF2-HMAC-SHA256 and PBKDF2-HMAC-SHA512 (pure Pion, zero World dependencies).
///| Zero-allocation hot loop: precomputes HMAC ipad/opad states once and iterates directly
///| over `FixedArray[UInt]` / `FixedArray[UInt64]` word states without per-iteration heap allocations.

///| Precompute HMAC-SHA256 inner and outer pad states once for `key`.
fn pbkdf2_hmac_sha256_pads(
  key : Bytes,
  ipad_state : FixedArray[UInt],
  opad_state : FixedArray[UInt],
  w : FixedArray[UInt],
) -> Unit {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  ipad_state[0] = 0x6a09e667U
  ipad_state[1] = 0xbb67ae85U
  ipad_state[2] = 0x3c6ef372U
  ipad_state[3] = 0xa54ff53aU
  ipad_state[4] = 0x510e527fU
  ipad_state[5] = 0x9b05688cU
  ipad_state[6] = 0x1f83d9abU
  ipad_state[7] = 0x5be0cd19U
  let mut i = 0
  while i < 16 {
    let p = i << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[i] = ((b0 ^ 0x36).to_uint() << 24U) |
    ((b1 ^ 0x36).to_uint() << 16U) |
    ((b2 ^ 0x36).to_uint() << 8U) |
    (b3 ^ 0x36).to_uint()
    i = i + 1
  }
  sha256_compress_w(ipad_state, w)

  opad_state[0] = 0x6a09e667U
  opad_state[1] = 0xbb67ae85U
  opad_state[2] = 0x3c6ef372U
  opad_state[3] = 0xa54ff53aU
  opad_state[4] = 0x510e527fU
  opad_state[5] = 0x9b05688cU
  opad_state[6] = 0x1f83d9abU
  opad_state[7] = 0x5be0cd19U
  let mut j = 0
  while j < 16 {
    let p = j << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[j] = ((b0 ^ 0x5C).to_uint() << 24U) |
    ((b1 ^ 0x5C).to_uint() << 16U) |
    ((b2 ^ 0x5C).to_uint() << 8U) |
    (b3 ^ 0x5C).to_uint()
    j = j + 1
  }
  sha256_compress_w(opad_state, w)
}

///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA256.
///| Rejects `iterations <= 0` (`InvalidParam`) and `dk_len <= 0` (`InvalidLength`).
pub fn pbkdf2_hmac_sha256(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  if iterations <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  if dk_len <= 0 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let ipad : FixedArray[UInt] = FixedArray::make(8, 0U)
  let opad : FixedArray[UInt] = FixedArray::make(8, 0U)
  pbkdf2_hmac_sha256_pads(password, ipad, opad, w)

  let salt_len = salt.length()
  let salt_ctr_len = salt_len + 4
  let mut salt_ctr = Bytes::new(salt_ctr_len)
  let mut si = 0
  while si < salt_len {
    salt_ctr[si] = salt[si]
    si = si + 1
  }
  let salt_total_bytes = (64 + salt_ctr_len).to_int64()

  let inner_st : FixedArray[UInt] = FixedArray::make(8, 0U)
  let outer_st : FixedArray[UInt] = FixedArray::make(8, 0U)
  let u : FixedArray[UInt] = FixedArray::make(8, 0U)
  let t : FixedArray[UInt] = FixedArray::make(8, 0U)

  let mut out = Bytes::new(dk_len)
  let n_blocks = (dk_len + 31) / 32
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    let b_u = block.to_uint()
    salt_ctr[salt_len] = ((b_u >> 24U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 1] = ((b_u >> 16U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 2] = ((b_u >> 8U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 3] = (b_u & 0xFFU).to_int().to_byte()

    // U_1 = HMAC-SHA256(password, salt || INT_32_BE(block))
    inner_st[0] = ipad[0]
    inner_st[1] = ipad[1]
    inner_st[2] = ipad[2]
    inner_st[3] = ipad[3]
    inner_st[4] = ipad[4]
    inner_st[5] = ipad[5]
    inner_st[6] = ipad[6]
    inner_st[7] = ipad[7]
    sha256_update_final_state(inner_st, salt_ctr, 0, salt_ctr_len, salt_total_bytes, w)

    outer_st[0] = opad[0]
    outer_st[1] = opad[1]
    outer_st[2] = opad[2]
    outer_st[3] = opad[3]
    outer_st[4] = opad[4]
    outer_st[5] = opad[5]
    outer_st[6] = opad[6]
    outer_st[7] = opad[7]
    w[0] = inner_st[0]
    w[1] = inner_st[1]
    w[2] = inner_st[2]
    w[3] = inner_st[3]
    w[4] = inner_st[4]
    w[5] = inner_st[5]
    w[6] = inner_st[6]
    w[7] = inner_st[7]
    w[8] = 0x80000000U
    w[9] = 0U
    w[10] = 0U
    w[11] = 0U
    w[12] = 0U
    w[13] = 0U
    w[14] = 0U
    w[15] = 768U
    sha256_compress_w(outer_st, w)

    u[0] = outer_st[0]
    u[1] = outer_st[1]
    u[2] = outer_st[2]
    u[3] = outer_st[3]
    u[4] = outer_st[4]
    u[5] = outer_st[5]
    u[6] = outer_st[6]
    u[7] = outer_st[7]
    t[0] = outer_st[0]
    t[1] = outer_st[1]
    t[2] = outer_st[2]
    t[3] = outer_st[3]
    t[4] = outer_st[4]
    t[5] = outer_st[5]
    t[6] = outer_st[6]
    t[7] = outer_st[7]

    // U_2 .. U_iterations (zero heap allocations)
    let mut iter = 1
    while iter < iterations {
      inner_st[0] = ipad[0]
      inner_st[1] = ipad[1]
      inner_st[2] = ipad[2]
      inner_st[3] = ipad[3]
      inner_st[4] = ipad[4]
      inner_st[5] = ipad[5]
      inner_st[6] = ipad[6]
      inner_st[7] = ipad[7]
      w[0] = u[0]
      w[1] = u[1]
      w[2] = u[2]
      w[3] = u[3]
      w[4] = u[4]
      w[5] = u[5]
      w[6] = u[6]
      w[7] = u[7]
      w[8] = 0x80000000U
      w[9] = 0U
      w[10] = 0U
      w[11] = 0U
      w[12] = 0U
      w[13] = 0U
      w[14] = 0U
      w[15] = 768U
      sha256_compress_w(inner_st, w)

      outer_st[0] = opad[0]
      outer_st[1] = opad[1]
      outer_st[2] = opad[2]
      outer_st[3] = opad[3]
      outer_st[4] = opad[4]
      outer_st[5] = opad[5]
      outer_st[6] = opad[6]
      outer_st[7] = opad[7]
      w[0] = inner_st[0]
      w[1] = inner_st[1]
      w[2] = inner_st[2]
      w[3] = inner_st[3]
      w[4] = inner_st[4]
      w[5] = inner_st[5]
      w[6] = inner_st[6]
      w[7] = inner_st[7]
      w[8] = 0x80000000U
      w[9] = 0U
      w[10] = 0U
      w[11] = 0U
      w[12] = 0U
      w[13] = 0U
      w[14] = 0U
      w[15] = 768U
      sha256_compress_w(outer_st, w)

      u[0] = outer_st[0]
      u[1] = outer_st[1]
      u[2] = outer_st[2]
      u[3] = outer_st[3]
      u[4] = outer_st[4]
      u[5] = outer_st[5]
      u[6] = outer_st[6]
      u[7] = outer_st[7]
      t[0] = t[0] ^ outer_st[0]
      t[1] = t[1] ^ outer_st[1]
      t[2] = t[2] ^ outer_st[2]
      t[3] = t[3] ^ outer_st[3]
      t[4] = t[4] ^ outer_st[4]
      t[5] = t[5] ^ outer_st[5]
      t[6] = t[6] ^ outer_st[6]
      t[7] = t[7] ^ outer_st[7]
      iter = iter + 1
    }

    let rem = dk_len - out_off
    let take = if rem < 32 { rem } else { 32 }
    let mut k = 0
    while k < take {
      let word = t[k >> 2]
      let shift : UInt = (24 - ((k & 3) << 3)).to_uint()
      out[out_off + k] = ((word >> shift) & 0xFFU).to_int().to_byte()
      k = k + 1
    }
    out_off = out_off + take
    block = block + 1
  }
  Ok(out)
}

///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA512.
///| Rejects `iterations <= 0` (`InvalidParam`) and `dk_len <= 0` (`InvalidLength`).
pub fn pbkdf2_hmac_sha512(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  if iterations <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  if dk_len <= 0 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  let (ipad, opad) = hmac_sha512_init_pads(password, false)
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)

  let salt_len = salt.length()
  let salt_ctr_len = salt_len + 4
  let mut salt_ctr = Bytes::new(salt_ctr_len)
  let mut si = 0
  while si < salt_len {
    salt_ctr[si] = salt[si]
    si = si + 1
  }
  let salt_total_bytes = (128 + salt_ctr_len).to_int64()

  let inner_st : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let outer_st : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let u : FixedArray[UInt64] = FixedArray::make(8, 0UL)
  let t : FixedArray[UInt64] = FixedArray::make(8, 0UL)

  let mut out = Bytes::new(dk_len)
  let n_blocks = (dk_len + 63) / 64
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    let b_u = block.to_uint()
    salt_ctr[salt_len] = ((b_u >> 24U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 1] = ((b_u >> 16U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 2] = ((b_u >> 8U) & 0xFFU).to_int().to_byte()
    salt_ctr[salt_len + 3] = (b_u & 0xFFU).to_int().to_byte()

    // U_1 = HMAC-SHA512(password, salt || INT_32_BE(block))
    inner_st[0] = ipad[0]
    inner_st[1] = ipad[1]
    inner_st[2] = ipad[2]
    inner_st[3] = ipad[3]
    inner_st[4] = ipad[4]
    inner_st[5] = ipad[5]
    inner_st[6] = ipad[6]
    inner_st[7] = ipad[7]
    sha512_update_final_state(inner_st, salt_ctr, 0, salt_ctr_len, salt_total_bytes, w)

    outer_st[0] = opad[0]
    outer_st[1] = opad[1]
    outer_st[2] = opad[2]
    outer_st[3] = opad[3]
    outer_st[4] = opad[4]
    outer_st[5] = opad[5]
    outer_st[6] = opad[6]
    outer_st[7] = opad[7]
    w[0] = inner_st[0]
    w[1] = inner_st[1]
    w[2] = inner_st[2]
    w[3] = inner_st[3]
    w[4] = inner_st[4]
    w[5] = inner_st[5]
    w[6] = inner_st[6]
    w[7] = inner_st[7]
    w[8] = 0x8000000000000000UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1536UL
    sha512_compress_w(outer_st, w)

    u[0] = outer_st[0]
    u[1] = outer_st[1]
    u[2] = outer_st[2]
    u[3] = outer_st[3]
    u[4] = outer_st[4]
    u[5] = outer_st[5]
    u[6] = outer_st[6]
    u[7] = outer_st[7]
    t[0] = outer_st[0]
    t[1] = outer_st[1]
    t[2] = outer_st[2]
    t[3] = outer_st[3]
    t[4] = outer_st[4]
    t[5] = outer_st[5]
    t[6] = outer_st[6]
    t[7] = outer_st[7]

    // U_2 .. U_iterations (zero heap allocations)
    let mut iter = 1
    while iter < iterations {
      inner_st[0] = ipad[0]
      inner_st[1] = ipad[1]
      inner_st[2] = ipad[2]
      inner_st[3] = ipad[3]
      inner_st[4] = ipad[4]
      inner_st[5] = ipad[5]
      inner_st[6] = ipad[6]
      inner_st[7] = ipad[7]
      w[0] = u[0]
      w[1] = u[1]
      w[2] = u[2]
      w[3] = u[3]
      w[4] = u[4]
      w[5] = u[5]
      w[6] = u[6]
      w[7] = u[7]
      w[8] = 0x8000000000000000UL
      w[9] = 0UL
      w[10] = 0UL
      w[11] = 0UL
      w[12] = 0UL
      w[13] = 0UL
      w[14] = 0UL
      w[15] = 1536UL
      sha512_compress_w(inner_st, w)

      outer_st[0] = opad[0]
      outer_st[1] = opad[1]
      outer_st[2] = opad[2]
      outer_st[3] = opad[3]
      outer_st[4] = opad[4]
      outer_st[5] = opad[5]
      outer_st[6] = opad[6]
      outer_st[7] = opad[7]
      w[0] = inner_st[0]
      w[1] = inner_st[1]
      w[2] = inner_st[2]
      w[3] = inner_st[3]
      w[4] = inner_st[4]
      w[5] = inner_st[5]
      w[6] = inner_st[6]
      w[7] = inner_st[7]
      w[8] = 0x8000000000000000UL
      w[9] = 0UL
      w[10] = 0UL
      w[11] = 0UL
      w[12] = 0UL
      w[13] = 0UL
      w[14] = 0UL
      w[15] = 1536UL
      sha512_compress_w(outer_st, w)

      u[0] = outer_st[0]
      u[1] = outer_st[1]
      u[2] = outer_st[2]
      u[3] = outer_st[3]
      u[4] = outer_st[4]
      u[5] = outer_st[5]
      u[6] = outer_st[6]
      u[7] = outer_st[7]
      t[0] = t[0] ^ outer_st[0]
      t[1] = t[1] ^ outer_st[1]
      t[2] = t[2] ^ outer_st[2]
      t[3] = t[3] ^ outer_st[3]
      t[4] = t[4] ^ outer_st[4]
      t[5] = t[5] ^ outer_st[5]
      t[6] = t[6] ^ outer_st[6]
      t[7] = t[7] ^ outer_st[7]
      iter = iter + 1
    }

    let rem = dk_len - out_off
    let take = if rem < 64 { rem } else { 64 }
    let mut k = 0
    while k < take {
      let word = t[k >> 3]
      let shift = 56 - ((k & 7) << 3)
      out[out_off + k] = ((word >> shift) & 0xFFUL).to_int().to_byte()
      k = k + 1
    }
    out_off = out_off + take
    block = block + 1
  }
  Ok(out)
}
