///| RFC 8018 §5.2 PBKDF2 with HMAC-SHA256.
///| Rejects `iterations <= 0` (`InvalidParam`) and `dk_len <= 0` or `dk_len > 2^30` (1 GiB,
///| `InvalidLength`), checked before any allocation so `Bytes::new` / `n_blocks` cannot overflow.
pub fn pbkdf2_hmac_sha256(
  password : Bytes,
  salt : Bytes,
  iterations : Int,
  dk_len : Int,
) -> Result[Bytes, CryptoError] {
  if iterations <= 0 {
    return Err(CryptoError::InvalidParam)
  }
  if dk_len <= 0 || dk_len > 1073741824 {
    return Err(CryptoError::InvalidLength(dk_len))
  }
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let ipad : FixedArray[UInt] = FixedArray::make(8, 0U)
  let opad : FixedArray[UInt] = FixedArray::make(8, 0U)
  pbkdf2_hmac_sha256_pads(password, ipad, opad, w)

  let salt_len = salt.length()
  let salt_ctr_len = salt_len + 4
  let mut salt_ctr = Bytes::new(salt_ctr_len)
  let mut si = 0
  while si < salt_len {
    salt_ctr[si] = salt[si]
    si = si + 1
  }
  let salt_total_bytes = (64 + salt_ctr_len).to_int64()

  let ip0 = ipad[0]
  let ip1 = ipad[1]
  let ip2 = ipad[2]
  let ip3 = ipad[3]
  let ip4 = ipad[4]
  let ip5 = ipad[5]
  let ip6 = ipad[6]
  let ip7 = ipad[7]
  let op0 = opad[0]
  let op1 = opad[1]
  let op2 = opad[2]
  let op3 = opad[3]
  let op4 = opad[4]
  let op5 = opad[5]
  let op6 = opad[6]
  let op7 = opad[7]

  let inner_st : FixedArray[UInt] = FixedArray::make(8, 0U)
  let t : FixedArray[UInt] = FixedArray::make(8, 0U)

  let mut out = Bytes::new(dk_len)
  let n_blocks = (dk_len - 1) / 32 + 1
  let mut out_off = 0
  let mut block = 1
  while block <= n_blocks {
    let b_u = block.to_uint()
    salt_ctr[salt_len] = ((b_u >> 24U) & 0xFFU).to_int().to_byte()
