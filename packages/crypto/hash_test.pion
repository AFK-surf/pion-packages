///| FIPS 180-4 SHA-1 / SHA-256 / SHA-384 / SHA-512 official vectors,
///| block-boundary tests (55/56/64/111/112/128/1MiB), and streaming API tests.

///|
fn t_ascii(s : String) -> Bytes {
  s.to_bytes()
}

///|
fn t_repeat(b : Int, n : Int) -> Bytes {
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b.to_byte()
    i = i + 1
  }
  out
}

///|
fn t_to_hex(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let n = b.length()
  let mut out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[i * 2] = digits.code_unit_at((v >> 4) & 0xF).to_byte()
    out[i * 2 + 1] = digits.code_unit_at(v & 0xF).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
test "sha1_fips180_4_and_boundaries" {
  debug_assert(
    t_to_hex(sha1(t_ascii(""))) == "da39a3ee5e6b4b0d3255bfef95601890afd80709",
    "sha1 empty",
  )
  debug_assert(
    t_to_hex(sha1(t_ascii("abc"))) == "a9993e364706816aba3e25717850c26c9cd0d89d",
    "sha1 abc",
  )
  debug_assert(
    t_to_hex(
      sha1(t_ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
    ) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    "sha1 448bit",
  )
  debug_assert(
    t_to_hex(
      sha1(
        t_ascii(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "a49b2446a02c645bf419f995b67091253a04a259",
    "sha1 896bit",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 55))) == "c1c8bbdc22796e28c0e15163d20899b65621d65a",
    "sha1 55B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 56))) == "c2db330f6083854c99d4b5bfb6e8f29f201be699",
    "sha1 56B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 64))) == "0098ba824b5c16427bd7a1122a5a442a25ec644d",
    "sha1 64B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 111))) == "ac877859d427d9192054eea8feb3b8a403ef83a5",
    "sha1 111B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 112))) == "689993727ba37386bb032495e9dbdfb4dd1ba744",
    "sha1 112B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 128))) == "ad5b3fdbcb526778c2839d2f151ea753995e26a0",
    "sha1 128B",
  )
  debug_assert(
    t_to_hex(sha1(t_repeat(97, 1000000))) == "34aa973cd4c4daa4f61eeb2bdbad27316534016f",
    "sha1 1M a",
  )
  debug_assert(
    sha1_hex(t_ascii("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d",
    "sha1_hex abc",
  )
}

///|
test "sha1_streaming_update_slice_reset" {
  let msg = t_ascii(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
  )
  let h = Sha1::new()
  h.update_slice(msg, 0, 13)
  h.update_slice(msg, 13, 64)
  h.update_slice(msg, 64, 64)
  h.update_slice(msg, 64, msg.length())
  let d1 = h.finalize_hex()
  let d2 = h.finalize_hex()
  debug_assert(d1 == "a49b2446a02c645bf419f995b67091253a04a259", "sha1 stream")
  debug_assert(d2 == d1, "sha1 finalize non-destructive")
  h.reset()
  h.update(t_ascii("abc"))
  debug_assert(
    h.finalize_hex() == "a9993e364706816aba3e25717850c26c9cd0d89d",
    "sha1 reset",
  )
}

///|
test "sha256_fips180_4_and_boundaries" {
  debug_assert(
    t_to_hex(sha256(t_ascii(""))) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "sha256 empty",
  )
  debug_assert(
    t_to_hex(sha256(t_ascii("abc"))) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 abc",
  )
  debug_assert(
    t_to_hex(
      sha256(
        t_ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
      ),
    ) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    "sha256 448bit",
  )
  debug_assert(
    t_to_hex(
      sha256(
        t_ascii(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
    "sha256 896bit",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 55))) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
    "sha256 55B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 56))) == "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a",
    "sha256 56B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 64))) == "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb",
    "sha256 64B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 111))) == "6374f73208854473827f6f6a3f43b1f53eaa3b82c21c1a6d69a2110b2a79baad",
    "sha256 111B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 112))) == "f54353008a2553262ecdc4a34749563ba0950e8b0fc8652780b0a614b99683c1",
    "sha256 112B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 128))) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
    "sha256 128B",
  )
  debug_assert(
    t_to_hex(sha256(t_repeat(97, 1048576))) == "9bc1b2a288b26af7257a36277ae3816a7d4f16e89c1e7e77d0a5c48bad62b360",
    "sha256 1MiB",
  )
}

///|
test "sha256_streaming_update_slice_reset" {
  let msg = t_repeat(97, 200)
  let expected = t_to_hex(sha256(msg))
  let h = Sha256::new()
  h.update_slice(msg, 0, 1)
  h.update_slice(msg, 1, 63)
  h.update_slice(msg, 63, 64)
  h.update_slice(msg, 64, 199)
  h.update_slice(msg, 199, 200)
  let d1 = h.finalize_hex()
  let d2 = h.finalize_hex()
  debug_assert(d1 == expected, "sha256 stream chunked")
  debug_assert(d2 == expected, "sha256 finalize non-destructive")
  h.reset()
  h.update(t_ascii("abc"))
  debug_assert(
    h.finalize_hex() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 reset",
  )
}

///|
test "sha384_fips180_4_and_boundaries" {
  debug_assert(
    t_to_hex(sha384(t_ascii(""))) == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b",
    "sha384 empty",
  )
  debug_assert(
    t_to_hex(sha384(t_ascii("abc"))) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
    "sha384 abc",
  )
  debug_assert(
    t_to_hex(
      sha384(
        t_ascii(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039",
    "sha384 896bit",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 55))) == "5d91ac7e74e62b5c728904b40f10784d66b7af9cb6302123e48c92f0432ceb8d2a92c02de77dcb29ed75c4b42bde46f4",
    "sha384 55B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 56))) == "8a8d9649ea04e993a6ca7135af7e3392cc5fca84f8531cac7aa3feed4eb98f55dcbe0f3284b61c6f35f98b02cc644b4c",
    "sha384 56B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 64))) == "2e404b9339da795776e510d96930b3be2904c500395b8cb7413334b82d4dec413b4b8113045a05bbbcff846f027423f6",
    "sha384 64B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 111))) == "3c37955051cb5c3026f94d551d5b5e2ac38d572ae4e07172085fed81f8466b8f90dc23a8ffcdea0b8d8e58e8fdacc80a",
    "sha384 111B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 112))) == "187d4e07cb306103c69967bf544d0dfbe9042577599c73c330abc0cb64c61236d5ed565ee19119d8c31779a38f791fcd",
    "sha384 112B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 128))) == "edb12730a366098b3b2beac75a3bef1b0969b15c48e2163c23d96994f8d1bef760c7e27f3c464d3829f56c0d53808b0b",
    "sha384 128B",
  )
  debug_assert(
    t_to_hex(sha384(t_repeat(97, 1048576))) == "ca5f19365048f25575c940a3c32a60cef4b9c9f46588d364845df15d6d92ebb4b9abe7ea3d65a381f4079c06deac8c2d",
    "sha384 1MiB",
  )
  let h = Sha384::new()
  let msg = t_repeat(97, 260)
  h.update_slice(msg, 0, 17)
  h.update_slice(msg, 17, 128)
  h.update_slice(msg, 128, 260)
  debug_assert(h.finalize_hex() == sha384_hex(msg), "sha384 streaming")
  h.reset()
  h.update(t_ascii("abc"))
  debug_assert(
    h.finalize_hex() == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
    "sha384 reset",
  )
}

///|
test "sha512_fips180_4_and_boundaries" {
  debug_assert(
    t_to_hex(sha512(t_ascii(""))) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
    "sha512 empty",
  )
  debug_assert(
    t_to_hex(sha512(t_ascii("abc"))) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    "sha512 abc",
  )
  debug_assert(
    t_to_hex(
      sha512(
        t_ascii(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
    "sha512 896bit",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 55))) == "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f",
    "sha512 55B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 56))) == "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04",
    "sha512 56B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 64))) == "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde",
    "sha512 64B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 111))) == "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2",
    "sha512 111B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 112))) == "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca",
    "sha512 112B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 128))) == "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321",
    "sha512 128B",
  )
  debug_assert(
    t_to_hex(sha512(t_repeat(97, 1048576))) == "f083039442f4a8cee2985641fa49cada4ca54d9bf3de03f9ef9f1f726dbb655d2a844aa1014e54fd239a5b3f37ae46d64744fee51ab2d7f5fe9b209e90b5ad52",
    "sha512 1MiB",
  )
  let h = Sha512::new()
  let msg = t_repeat(97, 300)
  h.update_slice(msg, 0, 5)
  h.update_slice(msg, 5, 130)
  h.update_slice(msg, 130, 300)
  debug_assert(h.finalize_hex() == sha512_hex(msg), "sha512 streaming")
  h.reset()
  h.update(t_ascii("abc"))
  debug_assert(
    h.finalize_hex() == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    "sha512 reset",
  )
}
