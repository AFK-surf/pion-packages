///| Pion Native head-to-head benchmark for `packages/git`.
///| Modes:
///|   w1 <w1.pack> <iters>
///|   w2 <w2_objects.bundle> <iters>
///|   w3 <w3_index_v2.bin> <w3_index_v4.bin> <w3_pktline.bin> <iters>

import "git"

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn read_u32_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn fnv1a_update(h : UInt, b : Bytes) -> UInt {
  let mut acc = h
  let n = b.length()
  let mut i = 0
  while i < n {
    acc = (acc ^ b[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  acc
}

///|
fn oid_u32_xor(o : git::Oid) -> UInt {
  let raw = o.raw_bytes()
  ((raw[0].to_int().to_uint() << 24U) |
    (raw[1].to_int().to_uint() << 16U) |
    (raw[2].to_int().to_uint() << 8U) |
    raw[3].to_int().to_uint()) ^
  ((raw[16].to_int().to_uint() << 24U) |
    (raw[17].to_int().to_uint() << 16U) |
    (raw[18].to_int().to_uint() << 8U) |
    raw[19].to_int().to_uint())
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: git_bench_pion <w1|w2|w3> ...")
    return 1
  }
  let mode = args[1]
  let limits = git::GitLimits::default()

  if mode == "w1" {
    let path = args[2]
    let iters = parse_int(args[3])
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut total_objs : Int64 = 0L
    let mut total_uncomp : Int64 = 0L
    let mut xor_oid : UInt = 0U
    let mut it = 0
    while it < iters {
      let ps = match git::PackStream::open(data, limits) {
        Ok(r) => r
        Err(e) => {
          io_println(world, "pack open err: " + e.to_string())
          return 1
        }
      }
      while true {
        match ps.next() {
          Ok(Some(o)) => {
            total_objs = total_objs + 1L
            total_uncomp = total_uncomp + o.payload.length().to_int64()
            xor_oid = xor_oid ^ oid_u32_xor(o.oid)
          }
          Ok(None) => break
          Err(e) => {
            io_println(world, "pack stream err: " + e.to_string())
            return 1
          }
        }
      }
      it = it + 1
    }
    io_println(
      world,
      "W1 objs=" +
      total_objs.to_string() +
      " uncomp=" +
      total_uncomp.to_string() +
      " xor=" +
      xor_oid.to_string(),
    )
    return 0
  }

  if mode == "w2" {
    let path = args[2]
    let iters = parse_int(args[3])
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut total_trees : Int64 = 0L
    let mut total_commits : Int64 = 0L
    let mut total_reencoded : Int64 = 0L
    let mut digest : UInt = 2166136261U
    let mut it = 0
    while it < iters {
      let mut pos = 0
      let num_trees = read_u32_be(data, pos)
      pos = pos + 4
      let mut t = 0
      while t < num_trees {
        let tlen = read_u32_be(data, pos)
        pos = pos + 4
        let slice = data.slice(pos, pos + tlen)
        pos = pos + tlen
        let tree = match git::Tree::parse(slice, git::HashKind::Sha1, limits) {
          Ok(tr) => tr
          Err(e) => {
            io_println(world, "tree parse err: " + e.to_string())
            return 1
          }
        }
        let enc = match tree.encode() {
          Ok(b) => b
          Err(e) => {
            io_println(world, "tree encode err: " + e.to_string())
            return 1
          }
        }
        total_trees = total_trees + 1L
        total_reencoded = total_reencoded + enc.length().to_int64()
        digest = fnv1a_update(digest, enc)
        t = t + 1
      }
      let num_commits = read_u32_be(data, pos)
      pos = pos + 4
      let mut c = 0
      while c < num_commits {
        let clen = read_u32_be(data, pos)
        pos = pos + 4
        let slice = data.slice(pos, pos + clen)
        pos = pos + clen
        let cm = match git::Commit::parse(slice, limits) {
          Ok(cm_ok) => cm_ok
          Err(e) => {
            io_println(world, "commit parse err: " + e.to_string())
            return 1
          }
        }
        let enc = cm.encode()
        total_commits = total_commits + 1L
        total_reencoded = total_reencoded + enc.length().to_int64()
        digest = fnv1a_update(digest, enc)
        c = c + 1
      }
      it = it + 1
    }
    io_println(
      world,
      "W2 trees=" +
      total_trees.to_string() +
      " commits=" +
      total_commits.to_string() +
      " reencoded=" +
      total_reencoded.to_string() +
      " fnv1a=" +
      digest.to_string(),
    )
    return 0
  }

  if mode == "w3" {
    if args.length() < 6 {
      io_println(world, "usage: git_bench_pion w3 <v2> <v4> <pkt> <iters>")
      return 1
    }
    let v2_data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let v4_data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let pkt_data = match fs_read_bytes(world, args[4]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let iters = parse_int(args[5])
    let mut total_v2 : Int64 = 0L
    let mut total_v4 : Int64 = 0L
    let mut total_pkts : Int64 = 0L
    let mut total_path_bytes : Int64 = 0L
    let mut total_pkt_bytes : Int64 = 0L
    let mut it = 0
    while it < iters {
      let i2 = match git::GitIndex::parse(v2_data, limits) {
        Ok(i) => i
        Err(e) => {
          io_println(world, "index v2 err: " + e.to_string())
          return 1
        }
      }
      let mut a = 0
      while a < i2.entries.length() {
        total_v2 = total_v2 + 1L
        total_path_bytes = total_path_bytes + i2.entries[a].path.length().to_int64()
        a = a + 1
      }
      let i4 = match git::GitIndex::parse(v4_data, limits) {
        Ok(i) => i
        Err(e) => {
          io_println(world, "index v4 err: " + e.to_string())
          return 1
        }
      }
      let mut b = 0
      while b < i4.entries.length() {
        total_v4 = total_v4 + 1L
        total_path_bytes = total_path_bytes + i4.entries[b].path.length().to_int64()
        b = b + 1
      }
      let pkts = match git::decode_pkt_lines(pkt_data, limits) {
        Ok(ls) => ls
        Err(e) => {
          io_println(world, "pkt err: " + e.to_string())
          return 1
        }
      }
      let mut p = 0
      while p < pkts.length() {
        total_pkts = total_pkts + 1L
        match pkts[p] {
          git::PktLine::Data(d) => total_pkt_bytes = total_pkt_bytes + d.length().to_int64()
          _ => ()
        }
        p = p + 1
      }
      it = it + 1
    }
    io_println(
      world,
      "W3 v2=" +
      total_v2.to_string() +
      " v4=" +
      total_v4.to_string() +
      " pkts=" +
      total_pkts.to_string() +
      " path_bytes=" +
      total_path_bytes.to_string() +
      " pkt_bytes=" +
      total_pkt_bytes.to_string(),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
