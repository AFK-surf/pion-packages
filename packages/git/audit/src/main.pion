///| RT-git differential oracle for `packages/git`.
///| Usage: git_audit <mode> <batch_file> [start_index]
///| Batch file: concatenated records `[u32 BE len][bytes]`.
///| Prints exactly one line per record: `<index> OK ...` or `<index> ERR <Variant>`.
///| Modes: loose tree commit tag pack idx index pkt ref delta (+ packx / treex: permissive limits)

import "git"
import "crypto"

///|
fn rd_u32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///| Error variant tag (text before the first ':').
fn err_tag(e : git::GitError) -> String {
  let m = e.to_string()
  let mut i = 0
  while i < m.length() && m.code_unit_at(i) != 58 {
    i = i + 1
  }
  let s = m.slice(0, i)
  let sb = StringBuilder::new()
  let mut j = 0
  while j < s.length() {
    let c = s.code_unit_at(j)
    if c == 32 {
      sb.write_string("_")
    } else {
      sb.write_string(s.slice(j, j + 1))
    }
    j = j + 1
  }
  sb.to_string()
}

///|
fn bytes_same(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn sha1_hex_str(s : String) -> String {
  crypto::bytes_to_hex(crypto::sha1(s.to_bytes()))
}

///|
fn run_one(mode : String, rec : Bytes, limits : git::GitLimits) -> String {
  if mode == "loose" {
    match git::decode_loose_object(rec, None, limits) {
      Ok(o) =>
      "OK " + o.kind.as_str() + " " + o.payload.length().to_string() + " " + o.oid.to_hex()
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "tree" {
    match git::Tree::parse(rec, git::HashKind::Sha1, limits) {
      Ok(t) => {
        let rt = match t.encode() {
          Ok(b) => if bytes_same(b, rec) { "same" } else { "diff" }
          Err(e) => "err:" + err_tag(e)
        }
        "OK n=" + t.entries.length().to_string() + " rt=" + rt
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "commit" {
    match git::Commit::parse(rec, limits) {
      Ok(c) => {
        let rt = if bytes_same(c.encode(), rec) { "same" } else { "diff" }
        "OK parents=" + c.parents.length().to_string() + " rt=" + rt
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "tag" {
    match git::Tag::parse(rec, limits) {
      Ok(t) => {
        let rt = if bytes_same(t.encode(), rec) { "same" } else { "diff" }
        "OK rt=" + rt
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "pack" {
    match git::PackReader::open(rec, limits) {
      Ok(p) =>
      match p.resolve_all() {
        Ok(objs) => {
          // Sorted, de-duplicated "<oid> <kind> <len>" lines, hashed.
          let lines : Array[String] = Array::new()
          let mut i = 0
          while i < objs.length() {
            lines.push(
              objs[i].oid.to_hex() +
              " " +
              objs[i].kind.as_str() +
              " " +
              objs[i].payload.length().to_string(),
            )
            i = i + 1
          }
          lines.sort()
          let sb = StringBuilder::new()
          let mut j = 0
          let mut uniq = 0
          while j < lines.length() {
            if j == 0 || lines[j] != lines[j - 1] {
              sb.write_string(lines[j])
              sb.write_string("\n")
              uniq = uniq + 1
            }
            j = j + 1
          }
          "OK n=" + uniq.to_string() + " h=" + sha1_hex_str(sb.to_string())
        }
        Err(e) => "ERR " + err_tag(e)
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "idx" {
    match git::PackIndex::parse(rec, limits) {
      Ok(ix) => {
        let sb = StringBuilder::new()
        let mut i = 0
        let mut bad = 0
        while i < ix.len() {
          match ix.entry_at(i) {
            Some((o, off, _)) => {
              sb.write_string(o.to_hex())
              sb.write_string(" ")
              sb.write_string(off.to_string())
              sb.write_string("\n")
              match ix.lookup(o) {
                Some((off2, _)) => if off2 != off { bad = bad + 1 }
                None => bad = bad + 1
              }
            }
            None => bad = bad + 1
          }
          i = i + 1
        }
        "OK n=" +
        ix.len().to_string() +
        " lookup_miss=" +
        bad.to_string() +
        " h=" +
        sha1_hex_str(sb.to_string())
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "index" {
    match git::GitIndex::parse(rec, limits) {
      Ok(ix) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < ix.entries.length() {
          let e = ix.entries[i]
          sb.write_string(e.oid.to_hex())
          sb.write_string(" ")
          sb.write_string(e.stage().to_string())
          sb.write_string(" ")
          sb.write_string(crypto::bytes_to_hex(e.path.to_bytes()))
          sb.write_string("\n")
          i = i + 1
        }
        let rt = match ix.encode() {
          Ok(b) => if bytes_same(b, rec) { "same" } else { "diff" }
          Err(e) => "err:" + err_tag(e)
        }
        "OK v=" +
        ix.version.to_string() +
        " n=" +
        ix.entries.length().to_string() +
        " rt=" +
        rt +
        " h=" +
        sha1_hex_str(sb.to_string())
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "pkt" {
    match git::decode_pkt_lines(rec, limits) {
      Ok(lines) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < lines.length() {
          match lines[i] {
            git::PktLine::Flush => sb.write_string("F\n")
            git::PktLine::Delim => sb.write_string("D\n")
            git::PktLine::ResponseEnd => sb.write_string("R\n")
            git::PktLine::Data(b) => {
              sb.write_string("P")
              sb.write_string(crypto::bytes_to_hex(b))
              sb.write_string("\n")
            }
          }
          i = i + 1
        }
        "OK n=" + lines.length().to_string() + " h=" + sha1_hex_str(sb.to_string())
      }
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "ref" {
    if rec.length() < 1 {
      return "ERR empty_record"
    }
    let onelevel = rec[0].to_int() != 0
    let name = rec.slice(1, rec.length()).to_string()
    match git::check_ref_format(name, onelevel) {
      Ok(_) => "OK"
      Err(e) => "ERR " + err_tag(e)
    }
  } else if mode == "delta" {
    if rec.length() < 4 {
      return "ERR empty_record"
    }
    let blen = rd_u32(rec, 0)
    if 4 + blen > rec.length() {
      return "ERR bad_record"
    }
    let base = rec.slice(4, 4 + blen)
    let delta = rec.slice(4 + blen, rec.length())
    match git::apply_delta(base, delta, limits) {
      Ok(out) => "OK " + out.length().to_string() + " " + crypto::bytes_to_hex(crypto::sha1(out))
      Err(e) => "ERR " + err_tag(e)
    }
  } else {
    "ERR unknown_mode"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: git_audit <mode> <batch_file> [start_index]")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + args[2])
      return 2
    }
  }
  let start = if args.length() > 3 { parse_int(args[3]) } else { 0 }
  // `packx` / `treex` run with permissive limits (deep chains, 1 GiB objects) for DoS probes.
  let permissive = mode == "packx" || mode == "treex"
  let eff_mode = if permissive { mode.slice(0, mode.length() - 1) } else { mode }
  let limits = if permissive {
    git::GitLimits::new(1073741824, 10000000, 1000000, 1073741824, 10000000, 10000000)
  } else {
    git::GitLimits::default()
  }
  let n = data.length()
  let mut pos = 0
  let mut idx = 0
  while pos + 4 <= n {
    let len = rd_u32(data, pos)
    let rec = data.slice(pos + 4, pos + 4 + len)
    pos = pos + 4 + len
    if idx >= start {
      io_println(world, idx.to_string() + " " + run_one(eff_mode, rec, limits))
    }
    idx = idx + 1
  }
  0
}
