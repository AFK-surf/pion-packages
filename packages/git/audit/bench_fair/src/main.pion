///| RT-git benchmark-fairness probe for W2 (`packages/git/bench` tree re-encode).
///| Usage: git_audit_bench_fair <enc|enc_noalloc> <w2_objects.bundle> <iters>
///|   enc          `Tree::parse` + `Tree::encode` (what bench W2 measures; comparator allocates
///|                `to_bytes()` twice per comparison)
///|   enc_noalloc  `Tree::parse` + the same git-order merge sort over names converted to `Bytes`
///|                once per entry (zero allocation per comparison), identical output bytes.

import "git"

///|
fn rd_u32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn fnv(h : UInt, b : Bytes) -> UInt {
  let mut acc = h
  let mut i = 0
  while i < b.length() {
    acc = (acc ^ b[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  acc
}

///| Git tree order over pre-converted name bytes; `dir` appends a virtual '/'.
fn cmp_raw(a : Bytes, a_dir : Bool, b : Bytes, b_dir : Bool) -> Int {
  let al = a.length()
  let bl = b.length()
  let ae = if a_dir { al + 1 } else { al }
  let be = if b_dir { bl + 1 } else { bl }
  let m = if ae < be { ae } else { be }
  let mut i = 0
  while i < m {
    let ac = if i < al { a[i].to_int() } else { 47 }
    let bc = if i < bl { b[i].to_int() } else { 47 }
    if ac != bc {
      return if ac < bc { -1 } else { 1 }
    }
    i = i + 1
  }
  if ae < be {
    -1
  } else if ae > be {
    1
  } else {
    0
  }
}

///|
fn msort(
  idx : FixedArray[Int],
  tmp : FixedArray[Int],
  names : Array[Bytes],
  dirs : FixedArray[Bool],
  lo : Int,
  hi : Int,
) -> Unit {
  if hi - lo <= 1 {
    return
  }
  let mid = lo + (hi - lo) / 2
  msort(idx, tmp, names, dirs, lo, mid)
  msort(idx, tmp, names, dirs, mid, hi)
  let mut i = lo
  let mut j = mid
  let mut k = lo
  while i < mid && j < hi {
    if cmp_raw(names[idx[i]], dirs[idx[i]], names[idx[j]], dirs[idx[j]]) <= 0 {
      tmp[k] = idx[i]
      i = i + 1
    } else {
      tmp[k] = idx[j]
      j = j + 1
    }
    k = k + 1
  }
  while i < mid {
    tmp[k] = idx[i]
    i = i + 1
    k = k + 1
  }
  while j < hi {
    tmp[k] = idx[j]
    j = j + 1
    k = k + 1
  }
  let mut m = lo
  while m < hi {
    idx[m] = tmp[m]
    m = m + 1
  }
}

///|
fn encode_noalloc(t : git::Tree) -> Bytes {
  let n = t.entries.length()
  let names : Array[Bytes] = Array::new()
  let dirs : FixedArray[Bool] = FixedArray::make(n, false)
  let idx : FixedArray[Int] = FixedArray::make(n, 0)
  let tmp : FixedArray[Int] = FixedArray::make(n, 0)
  let mut total = 0
  let mut i = 0
  while i < n {
    let e = t.entries[i]
    let nb = e.name.to_bytes()
    names.push(nb)
    dirs[i] = e.mode.equals(git::FileMode::Tree)
    idx[i] = i
    total = total + nb.length() + 28
    i = i + 1
  }
  msort(idx, tmp, names, dirs, 0, n)
  let out = Bytes::new(total)
  let mut p = 0
  let mut j = 0
  while j < n {
    let e = t.entries[idx[j]]
    let mb = e.mode.to_octal_str().to_bytes()
    let mut k = 0
    while k < mb.length() {
      out[p] = mb[k]
      p = p + 1
      k = k + 1
    }
    out[p] = 32.to_byte()
    p = p + 1
    let nb = names[idx[j]]
    k = 0
    while k < nb.length() {
      out[p] = nb[k]
      p = p + 1
      k = k + 1
    }
    out[p] = 0.to_byte()
    p = p + 1
    let ob = e.oid.raw_bytes()
    k = 0
    while k < ob.length() {
      out[p] = ob[k]
      p = p + 1
      k = k + 1
    }
    j = j + 1
  }
  out.slice(0, p)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: git_audit_bench_fair <enc|enc_noalloc> <bundle> <iters>")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 2
  }
  let iters = parse_int(args[3])
  let limits = git::GitLimits::default()
  let mut digest = 2166136261U
  let mut trees = 0
  let mut it = 0
  while it < iters {
    let num = rd_u32(data, 0)
    let mut pos = 4
    let mut t = 0
    while t < num {
      let len = rd_u32(data, pos)
      let slice = data.slice(pos + 4, pos + 4 + len)
      pos = pos + 4 + len
      let tree = match git::Tree::parse(slice, git::HashKind::Sha1, limits) {
        Ok(x) => x
        Err(_) => return 3
      }
      let enc = if mode == "enc" {
        match tree.encode() {
          Ok(b) => b
          Err(_) => return 4
        }
      } else {
        encode_noalloc(tree)
      }
      digest = fnv(digest, enc)
      trees = trees + 1
      t = t + 1
    }
    it = it + 1
  }
  io_println(world, "W2T trees=" + trees.to_string() + " fnv1a=" + digest.to_uint().to_string())
  0
}
