///| Git Protocol v1/v2 ref advertisement, want/have negotiation, and `git-check-ref-format(1)`.

///| Single advertised ref.
pub struct RefAdvert {
  pub oid : Oid
  pub refname : String
  pub symref_target : Option[String]
  pub peeled : Option[Oid]
}

///| Protocol v1 ref advertisement with capabilities.
pub struct RefAdvertisement {
  pub refs : Array[RefAdvert]
  pub capabilities : Array[String]
}

///|
fn strip_trailing_lf(s : String) -> String {
  let n = s.length()
  if n > 0 && s.code_unit_at(n - 1) == 10 {
    s.slice(0, n - 1)
  } else {
    s
  }
}

///|
fn split_spaces(s : String) -> Array[String] {
  let out : Array[String] = Array::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && s.code_unit_at(i) == 32 {
      i = i + 1
    }
    let start = i
    while i < n && s.code_unit_at(i) != 32 {
      i = i + 1
    }
    if i > start {
      out.push(s.slice(start, i))
    }
  }
  out
}

///|
pub fn parse_ref_advertisement_v1(
  lines : Array[PktLine],
) -> Result[RefAdvertisement, GitError] {
  let refs : Array[RefAdvert] = Array::new()
  let mut capabilities : Array[String] = Array::new()
  let mut first = true
  let mut i = 0
  while i < lines.length() {
    match lines[i] {
      PktLine::Flush => break
      PktLine::Data(raw) => {
        let mut nul = -1
        let mut j = 0
        while j < raw.length() {
          if raw[j].to_int() == 0 {
            nul = j
            break
          }
          j = j + 1
        }
        let head_str = if nul >= 0 {
          raw.slice(0, nul).to_string()
        } else {
          strip_trailing_lf(raw.to_string())
        }
        if first && nul >= 0 {
          let cap_str = strip_trailing_lf(raw.slice(nul + 1, raw.length()).to_string())
          capabilities = split_spaces(cap_str)
        }
        first = false
        let mut sp = 0
        while sp < head_str.length() && head_str.code_unit_at(sp) != 32 {
          sp = sp + 1
        }
        if sp == 0 || sp + 1 >= head_str.length() {
          return Err(GitError::InvalidPktLine("malformed v1 ref line"))
        }
        let oid = match Oid::from_hex(head_str.slice(0, sp)) {
          Ok(o) => o
          Err(e) => return Err(e)
        }
        let refname = head_str.slice(sp + 1, head_str.length())
        // Check for peeled tag line `<oid> <ref>^{}`
        let rlen = refname.length()
        if rlen > 3 && refname.slice(rlen - 3, rlen) == "^{}" {
          if refs.length() == 0 {
            return Err(GitError::InvalidPktLine("orphan peeled ref"))
          }
          let prev_idx = refs.length() - 1
          let prev = refs[prev_idx]
          refs[prev_idx] = RefAdvert::{
            oid: prev.oid,
            refname: prev.refname,
            symref_target: prev.symref_target,
            peeled: Some(oid),
          }
        } else if refname != "capabilities^{}" {
          refs.push(
            RefAdvert::{
              oid: oid,
              refname: refname,
              symref_target: None,
              peeled: None,
            },
          )
        }
      }
      _ => ()
    }
    i = i + 1
  }
  // Attach symref=<name>:<target> capabilities to matching refs
  let mut c = 0
  while c < capabilities.length() {
    let cap = capabilities[c]
    if cap.length() > 7 && cap.slice(0, 7) == "symref=" {
      let rest = cap.slice(7, cap.length())
      let mut colon = -1
      let mut k = 0
      while k < rest.length() {
        if rest.code_unit_at(k) == 58 {
          colon = k
          break
        }
        k = k + 1
      }
      if colon > 0 && colon + 1 < rest.length() {
        let src = rest.slice(0, colon)
        let dst = rest.slice(colon + 1, rest.length())
        let mut r = 0
        while r < refs.length() {
          if refs[r].refname == src {
            let cur = refs[r]
            refs[r] = RefAdvert::{
              oid: cur.oid,
              refname: cur.refname,
              symref_target: Some(dst),
              peeled: cur.peeled,
            }
          }
          r = r + 1
        }
      }
    }
    c = c + 1
  }
  Ok(RefAdvertisement::{ refs: refs, capabilities: capabilities })
}

///|
pub fn encode_ref_advertisement_v1(
  adv : RefAdvertisement,
) -> Result[Bytes, GitError] {
  let bb = ByteBuf::new(256)
  let mut i = 0
  while i < adv.refs.length() {
    let r = adv.refs[i]
    let line_buf = ByteBuf::new(128)
    line_buf.push_str(r.oid.to_hex())
    line_buf.push_byte(32)
    line_buf.push_str(r.refname)
    if i == 0 && adv.capabilities.length() > 0 {
      line_buf.push_byte(0)
      let mut c = 0
      while c < adv.capabilities.length() {
        if c > 0 {
          line_buf.push_byte(32)
        }
        line_buf.push_str(adv.capabilities[c])
        c = c + 1
      }
    }
    line_buf.push_byte(10)
    let pkt = match encode_pkt_line(PktLine::Data(line_buf.to_bytes())) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    bb.push_bytes(pkt)
    match r.peeled {
      Some(poid) => {
        let pline = poid.to_hex() + " " + r.refname + "^{}\n"
        let ppkt = match encode_pkt_line(PktLine::Data(pline.to_bytes())) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        bb.push_bytes(ppkt)
      }
      None => ()
    }
    i = i + 1
  }
  bb.push_str("0000")
  Ok(bb.to_bytes())
}

///|
pub fn parse_ls_refs_v2(
  lines : Array[PktLine],
) -> Result[Array[RefAdvert], GitError] {
  let out : Array[RefAdvert] = Array::new()
  let mut i = 0
  while i < lines.length() {
    match lines[i] {
      PktLine::Flush => break
      PktLine::Data(raw) => {
        let line = strip_trailing_lf(raw.to_string())
        let parts = split_spaces(line)
        if parts.length() < 2 {
          return Err(GitError::InvalidPktLine("malformed v2 ls-refs line"))
        }
        let oid = match Oid::from_hex(parts[0]) {
          Ok(o) => o
          Err(e) => return Err(e)
        }
        let refname = parts[1]
        let mut symref_target : Option[String] = None
        let mut peeled : Option[Oid] = None
        let mut p = 2
        while p < parts.length() {
          let attr = parts[p]
          if attr.length() > 14 && attr.slice(0, 14) == "symref-target:" {
            symref_target = Some(attr.slice(14, attr.length()))
          } else if attr.length() > 7 && attr.slice(0, 7) == "peeled:" {
            match Oid::from_hex(attr.slice(7, attr.length())) {
              Ok(po) => peeled = Some(po)
              Err(e) => return Err(e)
            }
          }
          p = p + 1
        }
        out.push(
          RefAdvert::{
            oid: oid,
            refname: refname,
            symref_target: symref_target,
            peeled: peeled,
          },
        )
      }
      _ => ()
    }
    i = i + 1
  }
  Ok(out)
}

///|
pub fn encode_want_have(
  wants : Array[Oid],
  haves : Array[Oid],
  capabilities : Array[String],
  done : Bool,
) -> Result[Bytes, GitError] {
  let bb = ByteBuf::new(256)
  let mut i = 0
  while i < wants.length() {
    let sb = StringBuilder::new()
    sb.write_string("want ")
    sb.write_string(wants[i].to_hex())
    if i == 0 && capabilities.length() > 0 {
      let mut c = 0
      while c < capabilities.length() {
        sb.write_string(" ")
        sb.write_string(capabilities[c])
        c = c + 1
      }
    }
    sb.write_string("\n")
    let pkt = match encode_pkt_line(PktLine::Data(sb.to_string().to_bytes())) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    bb.push_bytes(pkt)
    i = i + 1
  }
  bb.push_str("0000")
  let mut j = 0
  while j < haves.length() {
    let line = "have " + haves[j].to_hex() + "\n"
    let pkt = match encode_pkt_line(PktLine::Data(line.to_bytes())) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    bb.push_bytes(pkt)
    j = j + 1
  }
  if done {
    let pkt = match encode_pkt_line(PktLine::Data("done\n".to_bytes())) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    bb.push_bytes(pkt)
  } else if haves.length() > 0 {
    bb.push_str("0000")
  }
  Ok(bb.to_bytes())
}

///|
pub fn parse_want_have(
  lines : Array[PktLine],
) -> Result[(Array[Oid], Array[Oid], Array[String], Bool), GitError] {
  let wants : Array[Oid] = Array::new()
  let haves : Array[Oid] = Array::new()
  let capabilities : Array[String] = Array::new()
  let mut done = false
  let mut i = 0
  while i < lines.length() {
    match lines[i] {
      PktLine::Data(raw) => {
        let line = strip_trailing_lf(raw.to_string())
        let parts = split_spaces(line)
        if parts.length() == 0 {
          i = i + 1
          continue
        }
        let cmd = parts[0]
        if cmd == "want" {
          if parts.length() < 2 {
            return Err(GitError::InvalidPktLine("want missing OID"))
          }
          let oid = match Oid::from_hex(parts[1]) {
            Ok(o) => o
            Err(e) => return Err(e)
          }
          wants.push(oid)
          if wants.length() == 1 {
            let mut c = 2
            while c < parts.length() {
              capabilities.push(parts[c])
              c = c + 1
            }
          }
        } else if cmd == "have" {
          if parts.length() < 2 {
            return Err(GitError::InvalidPktLine("have missing OID"))
          }
          let oid = match Oid::from_hex(parts[1]) {
            Ok(o) => o
            Err(e) => return Err(e)
          }
          haves.push(oid)
        } else if cmd == "done" {
          done = true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Ok((wants, haves, capabilities, done))
}

///| Single-character prohibition per `git-check-ref-format(1)` Rules 4, 5, 10:
///| no ASCII control chars (< 0x20), space (0x20), DEL (0x7f), ~, ^, :, ?, *, [, \.
#verify
pub fn is_ref_forbidden_char(c : Int) -> Bool {
  c <= 32 ||
  c == 127 ||
  c == 126 ||
  c == 94 ||
  c == 58 ||
  c == 63 ||
  c == 42 ||
  c == 91 ||
  c == 92
}

///| Two-character prohibition per `git-check-ref-format(1)` Rules 3, 6, 8:
///| no "..", "//", or "@{".
#verify
pub fn is_ref_forbidden_pair(c : Int, next : Int) -> Bool {
  (c == 46 && next == 46) || (c == 47 && next == 47) || (c == 64 && next == 123)
}

///| Validate a Git reference name according to `git-check-ref-format(1)`.
pub fn check_ref_format(
  name : String,
  allow_onelevel : Bool,
) -> Result[Unit, GitError] {
  let n = name.length()
  if n == 0 {
    return Err(GitError::InvalidRefName("empty ref name"))
  }
  if name == "@" {
    return Err(GitError::InvalidRefName("single '@' is forbidden"))
  }
  if name.code_unit_at(0) == 47 || name.code_unit_at(n - 1) == 47 {
    return Err(GitError::InvalidRefName("leading or trailing '/'"))
  }
  if name.code_unit_at(n - 1) == 46 {
    return Err(GitError::InvalidRefName("trailing '.'"))
  }

  let mut slash_count = 0
  let mut comp_start = 0
  let mut i = 0
  while i < n {
    let c = name.code_unit_at(i)
    if is_ref_forbidden_char(c) {
      return Err(GitError::InvalidRefName("illegal character in ref name"))
    }
    if i + 1 < n {
      let next = name.code_unit_at(i + 1)
      if is_ref_forbidden_pair(c, next) {
        return Err(GitError::InvalidRefName("forbidden character pair in ref name"))
      }
    }
    if c == 47 {
      slash_count = slash_count + 1
      let comp = name.slice(comp_start, i)
      if comp.length() == 0 || comp.code_unit_at(0) == 46 {
        return Err(GitError::InvalidRefName("component starts with '.'"))
      }
      if comp.length() >= 5 && comp.slice(comp.length() - 5, comp.length()) == ".lock" {
        return Err(GitError::InvalidRefName("component ends with '.lock'"))
      }
      comp_start = i + 1
    }
    i = i + 1
  }

  // Check final component
  let last_comp = name.slice(comp_start, n)
  if last_comp.length() == 0 || last_comp.code_unit_at(0) == 46 {
    return Err(GitError::InvalidRefName("component starts with '.'"))
  }
  if last_comp.length() >= 5 &&
  last_comp.slice(last_comp.length() - 5, last_comp.length()) == ".lock" {
    return Err(GitError::InvalidRefName("component ends with '.lock'"))
  }

  if !allow_onelevel && slash_count == 0 {
    return Err(GitError::InvalidRefName("one-level ref name requires allow_onelevel"))
  }
  Ok(())
}
