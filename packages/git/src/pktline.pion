///| Sans-IO Git wire protocol `pkt-line` framing and sideband-64k demultiplexing.

///| A single Git `pkt-line` frame.
pub enum PktLine {
  Flush
  Delim
  ResponseEnd
  Data(Bytes)
}

///|
pub fn encode_pkt_line(pkt : PktLine) -> Result[Bytes, GitError] {
  Err(GitError::InvalidPktLine("unimplemented"))
}

///|
pub fn decode_pkt_line(
  data : Bytes,
  offset : Int,
) -> Result[(PktLine, Int), GitError] {
  Err(GitError::InvalidPktLine("unimplemented"))
}

///|
pub fn decode_pkt_lines(
  data : Bytes,
  limits : GitLimits,
) -> Result[Array[PktLine], GitError] {
  Err(GitError::InvalidPktLine("unimplemented"))
}

///| Sideband-64k channel message.
pub enum SidebandMessage {
  PackData(Bytes)
  Progress(String)
  Error(String)
}

///|
pub fn decode_sideband(payload : Bytes) -> Result[SidebandMessage, GitError] {
  Err(GitError::InvalidPktLine("unimplemented"))
}

///|
pub fn encode_sideband(msg : SidebandMessage) -> Bytes {
  Bytes::new(0)
}

///|
pub fn demux_sideband(
  lines : Array[PktLine],
) -> Result[(Bytes, Array[String], Array[String]), GitError] {
  Err(GitError::InvalidPktLine("unimplemented"))
}
