///| Sans-IO Git wire protocol `pkt-line` framing and sideband-64k demultiplexing.

///| Maximum total pkt-line length (4 header bytes + 65516 payload bytes).
let max_pkt_line_len : Int = 65520

///| A single Git `pkt-line` frame.
pub enum PktLine {
  Flush
  Delim
  ResponseEnd
  Data(Bytes)
}

///|
fn write_hex4(bb : ByteBuf, v : Int) -> Unit {
  let digits = "0123456789abcdef"
  bb.push_byte(digits.code_unit_at((v >> 12) & 0xF))
  bb.push_byte(digits.code_unit_at((v >> 8) & 0xF))
  bb.push_byte(digits.code_unit_at((v >> 4) & 0xF))
  bb.push_byte(digits.code_unit_at(v & 0xF))
}

///|
pub fn encode_pkt_line(pkt : PktLine) -> Result[Bytes, GitError] {
  match pkt {
    PktLine::Flush => Ok("0000".to_bytes())
    PktLine::Delim => Ok("0001".to_bytes())
    PktLine::ResponseEnd => Ok("0002".to_bytes())
    PktLine::Data(payload) => {
      let total = payload.length() + 4
      if total > max_pkt_line_len {
        return Err(GitError::InvalidPktLine("pkt-line exceeds 65520 bytes"))
      }
      let bb = ByteBuf::new(total)
      write_hex4(bb, total)
      bb.push_bytes(payload)
      Ok(bb.to_bytes())
    }
  }
}

///| Assemble 4 decoded hex nibbles into a 16-bit pkt-line total length.
#verify
pub fn pkt_line_decode_len(n0 : Int, n1 : Int, n2 : Int, n3 : Int) -> Int {
  (n0 << 12) | (n1 << 8) | (n2 << 4) | n3
}

///| Classify a decoded pkt-line total length:
///| 0 = Flush, 1 = Delim, 2 = ResponseEnd, 3 = Data (4..65520), -1 = Invalid.
#verify
pub fn pkt_line_classify_len(total : Int) -> Int {
  if total == 0 {
    0
  } else if total == 1 {
    1
  } else if total == 2 {
    2
  } else if total >= 4 && total <= 65520 {
    3
  } else {
    -1
  }
}

///|
pub fn decode_pkt_line(
  data : Bytes,
  offset : Int,
) -> Result[(PktLine, Int), GitError] {
  let n = data.length()
  if offset < 0 || offset + 4 > n {
    return Err(GitError::Truncated("truncated pkt-line length prefix"))
  }
  let lut = git_hex_decode_lut
  let n0 = lut[data[offset].to_int()]
  let n1 = lut[data[offset + 1].to_int()]
  let n2 = lut[data[offset + 2].to_int()]
  let n3 = lut[data[offset + 3].to_int()]
  if (n0 | n1 | n2 | n3) < 0 {
    return Err(GitError::InvalidPktLine("non-hex pkt-line length"))
  }
  let total = (n0 << 12) | (n1 << 8) | (n2 << 4) | n3
  if total >= 4 && total <= 65520 {
    if offset + total > n {
      return Err(GitError::Truncated("truncated pkt-line payload"))
    }
    return Ok((PktLine::Data(data.slice(offset + 4, offset + total)), offset + total))
  }
  if total == 0 {
    return Ok((PktLine::Flush, offset + 4))
  }
  if total == 1 {
    return Ok((PktLine::Delim, offset + 4))
  }
  if total == 2 {
    return Ok((PktLine::ResponseEnd, offset + 4))
  }
  Err(GitError::InvalidPktLine("invalid pkt-line length: " + total.to_string()))
}

///|
pub fn decode_pkt_lines(
  data : Bytes,
  limits : GitLimits,
) -> Result[Array[PktLine], GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = data.length()
  let out : Array[PktLine] = Array::new()
  let lut = git_hex_decode_lut
  let mut pos = 0
  while pos < n {
    if pos + 4 > n {
      return Err(GitError::Truncated("truncated pkt-line length prefix"))
    }
    let n0 = lut[data[pos].to_int()]
    let n1 = lut[data[pos + 1].to_int()]
    let n2 = lut[data[pos + 2].to_int()]
    let n3 = lut[data[pos + 3].to_int()]
    if (n0 | n1 | n2 | n3) < 0 {
      return Err(GitError::InvalidPktLine("non-hex pkt-line length"))
    }
    let total = (n0 << 12) | (n1 << 8) | (n2 << 4) | n3
    if total >= 4 && total <= 65520 {
      let next_pos = pos + total
      if next_pos > n {
        return Err(GitError::Truncated("truncated pkt-line payload"))
      }
      out.push(PktLine::Data(data.slice(pos + 4, next_pos)))
      pos = next_pos
    } else if total == 0 {
      out.push(PktLine::Flush)
      pos = pos + 4
    } else if total == 1 {
      out.push(PktLine::Delim)
      pos = pos + 4
    } else if total == 2 {
      out.push(PktLine::ResponseEnd)
      pos = pos + 4
    } else {
      return Err(GitError::InvalidPktLine("invalid pkt-line length: " + total.to_string()))
    }
  }
  Ok(out)
}

///| Sideband-64k channel message.
pub enum SidebandMessage {
  PackData(Bytes)
  Progress(String)
  Error(String)
}

///|
pub fn decode_sideband(payload : Bytes) -> Result[SidebandMessage, GitError] {
  let n = payload.length()
  if n == 0 {
    return Err(GitError::InvalidPktLine("empty sideband payload"))
  }
  let band = payload[0].to_int()
  let body = payload.slice(1, n)
  if band == 1 {
    Ok(SidebandMessage::PackData(body))
  } else if band == 2 {
    Ok(SidebandMessage::Progress(body.to_string()))
  } else if band == 3 {
    Ok(SidebandMessage::Error(body.to_string()))
  } else {
    Err(GitError::InvalidPktLine("invalid sideband channel: " + band.to_string()))
  }
}

///|
pub fn encode_sideband(msg : SidebandMessage) -> Bytes {
  match msg {
    SidebandMessage::PackData(b) => {
      let bb = ByteBuf::new(1 + b.length())
      bb.push_byte(1)
      bb.push_bytes(b)
      bb.to_bytes()
    }
    SidebandMessage::Progress(s) => {
      let b = s.to_bytes()
      let bb = ByteBuf::new(1 + b.length())
      bb.push_byte(2)
      bb.push_bytes(b)
      bb.to_bytes()
    }
    SidebandMessage::Error(s) => {
      let b = s.to_bytes()
      let bb = ByteBuf::new(1 + b.length())
      bb.push_byte(3)
      bb.push_bytes(b)
      bb.to_bytes()
    }
  }
}

///|
pub fn demux_sideband(
  lines : Array[PktLine],
) -> Result[(Bytes, Array[String], Array[String]), GitError] {
  let pack_buf = ByteBuf::new(256)
  let progress : Array[String] = Array::new()
  let errors : Array[String] = Array::new()
  let mut i = 0
  while i < lines.length() {
    match lines[i] {
      PktLine::Data(payload) =>
      match decode_sideband(payload) {
        Ok(SidebandMessage::PackData(b)) => pack_buf.push_bytes(b)
        Ok(SidebandMessage::Progress(s)) => progress.push(s)
        Ok(SidebandMessage::Error(s)) => errors.push(s)
        Err(e) => return Err(e)
      }
      _ => ()
    }
    i = i + 1
  }
  Ok((pack_buf.to_bytes(), progress, errors))
}
