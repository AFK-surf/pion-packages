///| Git Object ID (OID) for SHA-1 (20B) and SHA-256 (32B).

///| Immutable Git Object ID.
pub struct Oid {
  pub kind : HashKind
  pub bytes : Bytes
}

///|
#verify
pub fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    -1
  }
}

///| 256-entry ASCII hex nibble LUT (-1 for invalid).
fn build_hex_decode_lut() -> FixedArray[Int] {
  let t : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 0
  while i < 10 {
    t[48 + i] = i
    i = i + 1
  }
  let mut j = 0
  while j < 6 {
    t[97 + j] = 10 + j
    t[65 + j] = 10 + j
    j = j + 1
  }
  t
}

let git_hex_decode_lut : FixedArray[Int] = build_hex_decode_lut()

let git_hex_encode_lut : FixedArray[Byte] = [
  48.to_byte(), 49.to_byte(), 50.to_byte(), 51.to_byte(), 52.to_byte(), 53.to_byte(), 54.to_byte(),
  55.to_byte(), 56.to_byte(), 57.to_byte(), 97.to_byte(), 98.to_byte(), 99.to_byte(), 100.to_byte(),
  101.to_byte(), 102.to_byte(),
]

///| Decode a 40-char (SHA-1) or 64-char (SHA-256) hex OID directly from raw bytes `[start..start+len)`.
fn oid_from_hex_bytes(data : Bytes, start : Int, len : Int) -> Result[Oid, GitError] {
  let kind = if len == 40 {
    HashKind::Sha1
  } else if len == 64 {
    HashKind::Sha256
  } else {
    return Err(GitError::InvalidOid("expected 40 or 64 hex chars, got " + len.to_string()))
  }
  let half = len >> 1
  let lut = git_hex_decode_lut
  let out = Bytes::new(half)
  let mut i = 0
  let mut p = start
  while i < half {
    let hi = lut[data[p].to_int()]
    let lo = lut[data[p + 1].to_int()]
    if (hi | lo) < 0 {
      return Err(GitError::InvalidOid("invalid hex characters"))
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
    p = p + 2
  }
  Ok(Oid::{ kind: kind, bytes: out })
}

///| Write lowercase hex representation of `raw` directly into `out[off..]`.
fn write_oid_hex_into(raw : Bytes, out : Bytes, off : Int) -> Int {
  let hex = git_hex_encode_lut
  let n = raw.length()
  let mut i = 0
  let mut p = off
  while i < n {
    let v = raw[i].to_int()
    out[p] = hex[(v >> 4) & 0xF]
    out[p + 1] = hex[v & 0xF]
    i = i + 1
    p = p + 2
  }
  p
}

///|
pub fn Oid::from_bytes(raw : Bytes) -> Result[Oid, GitError] {
  let n = raw.length()
  if n == 20 {
    Ok(Oid::{ kind: HashKind::Sha1, bytes: raw })
  } else if n == 32 {
    Ok(Oid::{ kind: HashKind::Sha256, bytes: raw })
  } else {
    Err(GitError::InvalidOid("expected 20 or 32 bytes, got " + n.to_string()))
  }
}

///|
pub fn Oid::from_hex(hex : String) -> Result[Oid, GitError] {
  let n = hex.length()
  let kind = if n == 40 {
    HashKind::Sha1
  } else if n == 64 {
    HashKind::Sha256
  } else {
    return Err(GitError::InvalidOid("expected 40 or 64 hex chars, got " + n.to_string()))
  }
  let half = n >> 1
  let lut = git_hex_decode_lut
  let out = Bytes::new(half)
  let mut i = 0
  while i < half {
    let c0 = hex.code_unit_at(i * 2)
    let c1 = hex.code_unit_at(i * 2 + 1)
    if c0 >= 256 || c1 >= 256 {
      return Err(GitError::InvalidOid("invalid hex characters"))
    }
    let hi = lut[c0]
    let lo = lut[c1]
    if (hi | lo) < 0 {
      return Err(GitError::InvalidOid("invalid hex characters"))
    }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  Ok(Oid::{ kind: kind, bytes: out })
}

///|
pub fn Oid::zero(kind : HashKind) -> Oid {
  Oid::{ kind: kind, bytes: Bytes::new(kind.byte_len()) }
}

///|
pub fn Oid::is_zero(self : Oid) -> Bool {
  let n = self.bytes.length()
  let mut i = 0
  while i < n {
    if self.bytes[i].to_int() != 0 {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn Oid::to_hex(self : Oid) -> String {
  let out = Bytes::new(self.bytes.length() * 2)
  let _ = write_oid_hex_into(self.bytes, out, 0)
  out.to_string()
}

///|
pub fn Oid::raw_bytes(self : Oid) -> Bytes {
  self.bytes
}

///|
pub fn Oid::byte_len(self : Oid) -> Int {
  self.bytes.length()
}

///|
pub fn Oid::equals(self : Oid, other : Oid) -> Bool {
  self.kind.equals(other.kind) && bytes_eq(self.bytes, other.bytes)
}

///|
pub fn Oid::compare(self : Oid, other : Oid) -> Int {
  let a_len = self.bytes.length()
  let b_len = other.bytes.length()
  let min_len = if a_len < b_len { a_len } else { b_len }
  let c = bytes_cmp_slice(self.bytes, 0, other.bytes, 0, min_len)
  if c != 0 {
    return c
  }
  if a_len < b_len {
    -1
  } else if a_len > b_len {
    1
  } else {
    0
  }
}

///|
pub fn Oid::starts_with_hex(self : Oid, prefix : String) -> Bool {
  let plen = prefix.length()
  if plen > self.bytes.length() * 2 {
    return false
  }
  let mut i = 0
  while i < plen {
    let nib = hex_nibble(prefix.code_unit_at(i))
    if nib < 0 {
      return false
    }
    let byte_val = self.bytes[i >> 1].to_int()
    let expected = if (i & 1) == 0 { (byte_val >> 4) & 0xF } else { byte_val & 0xF }
    if nib != expected {
      return false
    }
    i = i + 1
  }
  true
}

///| Format `<type> <len>\0` directly into `hdr_buf` (must be >= 32 bytes) and return length.
fn format_git_object_header(hdr_buf : Bytes, kind : ObjectKind, payload_len : Int) -> Int {
  let mut p = 0
  match kind {
    ObjectKind::Blob => {
      hdr_buf[0] = 98.to_byte()
      hdr_buf[1] = 108.to_byte()
      hdr_buf[2] = 111.to_byte()
      hdr_buf[3] = 98.to_byte()
      hdr_buf[4] = 32.to_byte()
      p = 5
    }
    ObjectKind::Tree => {
      hdr_buf[0] = 116.to_byte()
      hdr_buf[1] = 114.to_byte()
      hdr_buf[2] = 101.to_byte()
      hdr_buf[3] = 101.to_byte()
      hdr_buf[4] = 32.to_byte()
      p = 5
    }
    ObjectKind::Commit => {
      hdr_buf[0] = 99.to_byte()
      hdr_buf[1] = 111.to_byte()
      hdr_buf[2] = 109.to_byte()
      hdr_buf[3] = 109.to_byte()
      hdr_buf[4] = 105.to_byte()
      hdr_buf[5] = 116.to_byte()
      hdr_buf[6] = 32.to_byte()
      p = 7
    }
    ObjectKind::Tag => {
      hdr_buf[0] = 116.to_byte()
      hdr_buf[1] = 97.to_byte()
      hdr_buf[2] = 103.to_byte()
      hdr_buf[3] = 32.to_byte()
      p = 4
    }
  }
  if payload_len == 0 {
    hdr_buf[p] = 48.to_byte()
    p = p + 1
  } else {
    let start = p
    let mut v = payload_len
    while v > 0 {
      hdr_buf[p] = (48 + (v % 10)).to_byte()
      v = v / 10
      p = p + 1
    }
    let mut lo = start
    let mut hi = p - 1
    while lo < hi {
      let tmp = hdr_buf[lo]
      hdr_buf[lo] = hdr_buf[hi]
      hdr_buf[hi] = tmp
      lo = lo + 1
      hi = hi - 1
    }
  }
  hdr_buf[p] = 0.to_byte()
  p + 1
}

///| Compute Git object OID over `<type> <len>\0<payload>` using streaming hasher.
pub fn hash_object_bytes(
  kind : ObjectKind,
  payload : Bytes,
  hash_kind : HashKind,
) -> Oid {
  match hash_kind {
    HashKind::Sha1 => {
      let h = GitSha1::new()
      h.hash_git_object(kind, payload)
    }
    HashKind::Sha256 => {
      let hdr_buf = Bytes::new(32)
      let hdr_len = format_git_object_header(hdr_buf, kind, payload.length())
      let h = crypto::Sha256::new()
      h.update_slice(hdr_buf, 0, hdr_len)
      h.update(payload)
      Oid::{ kind: HashKind::Sha256, bytes: h.finalize() }
    }
  }
}

///|
pub fn hash_object_sha1(kind : ObjectKind, payload : Bytes) -> Oid {
  hash_object_bytes(kind, payload, HashKind::Sha1)
}
