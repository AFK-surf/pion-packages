///| Git Object ID (OID) for SHA-1 (20B) and SHA-256 (32B).

///| Immutable Git Object ID.
pub struct Oid {
  pub kind : HashKind
  pub bytes : Bytes
}

///|
pub fn Oid::from_bytes(raw : Bytes) -> Result[Oid, GitError] {
  Err(GitError::InvalidOid("unimplemented"))
}

///|
pub fn Oid::from_hex(hex : String) -> Result[Oid, GitError] {
  Err(GitError::InvalidOid("unimplemented"))
}

///|
pub fn Oid::zero(kind : HashKind) -> Oid {
  Oid::{ kind: kind, bytes: Bytes::new(kind.byte_len()) }
}

///|
pub fn Oid::is_zero(self : Oid) -> Bool {
  false
}

///|
pub fn Oid::to_hex(self : Oid) -> String {
  ""
}

///|
pub fn Oid::raw_bytes(self : Oid) -> Bytes {
  self.bytes
}

///|
pub fn Oid::byte_len(self : Oid) -> Int {
  self.bytes.length()
}

///|
pub fn Oid::equals(self : Oid, other : Oid) -> Bool {
  false
}

///|
pub fn Oid::compare(self : Oid, other : Oid) -> Int {
  0
}

///|
pub fn Oid::starts_with_hex(self : Oid, prefix : String) -> Bool {
  false
}

///|
pub fn hash_object_bytes(
  kind : ObjectKind,
  payload : Bytes,
  hash_kind : HashKind,
) -> Oid {
  Oid::zero(hash_kind)
}

///|
pub fn hash_object_sha1(kind : ObjectKind, payload : Bytes) -> Oid {
  hash_object_bytes(kind, payload, HashKind::Sha1)
}
