///| Zero-bounds-check struct-field-window FIPS 180-4 SHA-1 tuned for QBE (zero stack spills).
///| Pure Pion, zero C dependencies, zero per-block bounds checks on W[0..15].

///| Reusable streaming SHA-1 hasher with flat scalar state and 16-word struct window.
struct GitSha1 {
  mut h0 : UInt
  mut h1 : UInt
  mut h2 : UInt
  mut h3 : UInt
  mut h4 : UInt
  mut w0 : UInt
  mut w1 : UInt
  mut w2 : UInt
  mut w3 : UInt
  mut w4 : UInt
  mut w5 : UInt
  mut w6 : UInt
  mut w7 : UInt
  mut w8 : UInt
  mut w9 : UInt
  mut w10 : UInt
  mut w11 : UInt
  mut w12 : UInt
  mut w13 : UInt
  mut w14 : UInt
  mut w15 : UInt
  buf : FixedArray[Byte]
  mut fill : Int
  mut total : Int64
}

///|
fn GitSha1::new() -> GitSha1 {
  GitSha1::{
    h0: 0x67452301U,
    h1: 0xEFCDAB89U,
    h2: 0x98BADCFEU,
    h3: 0x10325476U,
    h4: 0xC3D2E1F0U,
    w0: 0U,
    w1: 0U,
    w2: 0U,
    w3: 0U,
    w4: 0U,
    w5: 0U,
    w6: 0U,
    w7: 0U,
    w8: 0U,
    w9: 0U,
    w10: 0U,
    w11: 0U,
    w12: 0U,
    w13: 0U,
    w14: 0U,
    w15: 0U,
    buf: FixedArray::make(64, 0.to_byte()),
    fill: 0,
    total: 0L,
  }
}

///|
fn GitSha1::reset(self : GitSha1) -> Unit {
  self.h0 = 0x67452301U
  self.h1 = 0xEFCDAB89U
  self.h2 = 0x98BADCFEU
  self.h3 = 0x10325476U
  self.h4 = 0xC3D2E1F0U
  self.fill = 0
  self.total = 0L
}

fn GitSha1::compress_r0(self : GitSha1) -> Unit {
  let mut a = self.h0
  let mut b = self.h1
  let mut c = self.h2
  let mut d = self.h3
  let mut e = self.h4
  let mut wv : UInt = 0U
  e = e + ((a << 5U) | (a >> 27U)) + (d ^ (b & (c ^ d))) + 0x5A827999U + self.w0
  b = (b << 30U) | (b >> 2U)
  d = d + ((e << 5U) | (e >> 27U)) + (c ^ (a & (b ^ c))) + 0x5A827999U + self.w1
  a = (a << 30U) | (a >> 2U)
  c = c + ((d << 5U) | (d >> 27U)) + (b ^ (e & (a ^ b))) + 0x5A827999U + self.w2
  e = (e << 30U) | (e >> 2U)
  b = b + ((c << 5U) | (c >> 27U)) + (a ^ (d & (e ^ a))) + 0x5A827999U + self.w3
  d = (d << 30U) | (d >> 2U)
  a = a + ((b << 5U) | (b >> 27U)) + (e ^ (c & (d ^ e))) + 0x5A827999U + self.w4
  c = (c << 30U) | (c >> 2U)
  e = e + ((a << 5U) | (a >> 27U)) + (d ^ (b & (c ^ d))) + 0x5A827999U + self.w5
  b = (b << 30U) | (b >> 2U)
  d = d + ((e << 5U) | (e >> 27U)) + (c ^ (a & (b ^ c))) + 0x5A827999U + self.w6
  a = (a << 30U) | (a >> 2U)
  c = c + ((d << 5U) | (d >> 27U)) + (b ^ (e & (a ^ b))) + 0x5A827999U + self.w7
  e = (e << 30U) | (e >> 2U)
  b = b + ((c << 5U) | (c >> 27U)) + (a ^ (d & (e ^ a))) + 0x5A827999U + self.w8
  d = (d << 30U) | (d >> 2U)
  a = a + ((b << 5U) | (b >> 27U)) + (e ^ (c & (d ^ e))) + 0x5A827999U + self.w9
  c = (c << 30U) | (c >> 2U)
  e = e + ((a << 5U) | (a >> 27U)) + (d ^ (b & (c ^ d))) + 0x5A827999U + self.w10
  b = (b << 30U) | (b >> 2U)
  d = d + ((e << 5U) | (e >> 27U)) + (c ^ (a & (b ^ c))) + 0x5A827999U + self.w11
  a = (a << 30U) | (a >> 2U)
  c = c + ((d << 5U) | (d >> 27U)) + (b ^ (e & (a ^ b))) + 0x5A827999U + self.w12
  e = (e << 30U) | (e >> 2U)
  b = b + ((c << 5U) | (c >> 27U)) + (a ^ (d & (e ^ a))) + 0x5A827999U + self.w13
  d = (d << 30U) | (d >> 2U)
  a = a + ((b << 5U) | (b >> 27U)) + (e ^ (c & (d ^ e))) + 0x5A827999U + self.w14
  c = (c << 30U) | (c >> 2U)
  e = e + ((a << 5U) | (a >> 27U)) + (d ^ (b & (c ^ d))) + 0x5A827999U + self.w15
  b = (b << 30U) | (b >> 2U)
  wv = self.w13 ^ self.w8 ^ self.w2 ^ self.w0
  wv = (wv << 1U) | (wv >> 31U)
  self.w0 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (c ^ (a & (b ^ c))) + 0x5A827999U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w14 ^ self.w9 ^ self.w3 ^ self.w1
  wv = (wv << 1U) | (wv >> 31U)
  self.w1 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (b ^ (e & (a ^ b))) + 0x5A827999U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w15 ^ self.w10 ^ self.w4 ^ self.w2
  wv = (wv << 1U) | (wv >> 31U)
  self.w2 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (a ^ (d & (e ^ a))) + 0x5A827999U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w0 ^ self.w11 ^ self.w5 ^ self.w3
  wv = (wv << 1U) | (wv >> 31U)
  self.w3 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (e ^ (c & (d ^ e))) + 0x5A827999U + wv
  c = (c << 30U) | (c >> 2U)
  self.h0 = a
  self.h1 = b
  self.h2 = c
  self.h3 = d
  self.h4 = e
}

fn GitSha1::compress_r1(self : GitSha1) -> Unit {
  let mut a = self.h0
  let mut b = self.h1
  let mut c = self.h2
  let mut d = self.h3
  let mut e = self.h4
  let mut wv : UInt = 0U
  wv = self.w1 ^ self.w12 ^ self.w6 ^ self.w4
  wv = (wv << 1U) | (wv >> 31U)
  self.w4 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0x6ED9EBA1U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w2 ^ self.w13 ^ self.w7 ^ self.w5
  wv = (wv << 1U) | (wv >> 31U)
  self.w5 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0x6ED9EBA1U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w3 ^ self.w14 ^ self.w8 ^ self.w6
  wv = (wv << 1U) | (wv >> 31U)
  self.w6 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0x6ED9EBA1U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w4 ^ self.w15 ^ self.w9 ^ self.w7
  wv = (wv << 1U) | (wv >> 31U)
  self.w7 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0x6ED9EBA1U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w5 ^ self.w0 ^ self.w10 ^ self.w8
  wv = (wv << 1U) | (wv >> 31U)
  self.w8 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0x6ED9EBA1U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w6 ^ self.w1 ^ self.w11 ^ self.w9
  wv = (wv << 1U) | (wv >> 31U)
  self.w9 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0x6ED9EBA1U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w7 ^ self.w2 ^ self.w12 ^ self.w10
  wv = (wv << 1U) | (wv >> 31U)
  self.w10 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0x6ED9EBA1U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w8 ^ self.w3 ^ self.w13 ^ self.w11
  wv = (wv << 1U) | (wv >> 31U)
  self.w11 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0x6ED9EBA1U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w9 ^ self.w4 ^ self.w14 ^ self.w12
  wv = (wv << 1U) | (wv >> 31U)
  self.w12 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0x6ED9EBA1U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w10 ^ self.w5 ^ self.w15 ^ self.w13
  wv = (wv << 1U) | (wv >> 31U)
  self.w13 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0x6ED9EBA1U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w11 ^ self.w6 ^ self.w0 ^ self.w14
  wv = (wv << 1U) | (wv >> 31U)
  self.w14 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0x6ED9EBA1U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w12 ^ self.w7 ^ self.w1 ^ self.w15
  wv = (wv << 1U) | (wv >> 31U)
  self.w15 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0x6ED9EBA1U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w13 ^ self.w8 ^ self.w2 ^ self.w0
  wv = (wv << 1U) | (wv >> 31U)
  self.w0 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0x6ED9EBA1U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w14 ^ self.w9 ^ self.w3 ^ self.w1
  wv = (wv << 1U) | (wv >> 31U)
  self.w1 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0x6ED9EBA1U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w15 ^ self.w10 ^ self.w4 ^ self.w2
  wv = (wv << 1U) | (wv >> 31U)
  self.w2 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0x6ED9EBA1U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w0 ^ self.w11 ^ self.w5 ^ self.w3
  wv = (wv << 1U) | (wv >> 31U)
  self.w3 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0x6ED9EBA1U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w1 ^ self.w12 ^ self.w6 ^ self.w4
  wv = (wv << 1U) | (wv >> 31U)
  self.w4 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0x6ED9EBA1U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w2 ^ self.w13 ^ self.w7 ^ self.w5
  wv = (wv << 1U) | (wv >> 31U)
  self.w5 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0x6ED9EBA1U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w3 ^ self.w14 ^ self.w8 ^ self.w6
  wv = (wv << 1U) | (wv >> 31U)
  self.w6 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0x6ED9EBA1U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w4 ^ self.w15 ^ self.w9 ^ self.w7
  wv = (wv << 1U) | (wv >> 31U)
  self.w7 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0x6ED9EBA1U + wv
  c = (c << 30U) | (c >> 2U)
  self.h0 = a
  self.h1 = b
  self.h2 = c
  self.h3 = d
  self.h4 = e
}

fn GitSha1::compress_r2(self : GitSha1) -> Unit {
  let mut a = self.h0
  let mut b = self.h1
  let mut c = self.h2
  let mut d = self.h3
  let mut e = self.h4
  let mut wv : UInt = 0U
  wv = self.w5 ^ self.w0 ^ self.w10 ^ self.w8
  wv = (wv << 1U) | (wv >> 31U)
  self.w8 = wv
  e = e + ((a << 5U) | (a >> 27U)) + ((b & c) | (d & (b | c))) + 0x8F1BBCDCU + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w6 ^ self.w1 ^ self.w11 ^ self.w9
  wv = (wv << 1U) | (wv >> 31U)
  self.w9 = wv
  d = d + ((e << 5U) | (e >> 27U)) + ((a & b) | (c & (a | b))) + 0x8F1BBCDCU + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w7 ^ self.w2 ^ self.w12 ^ self.w10
  wv = (wv << 1U) | (wv >> 31U)
  self.w10 = wv
  c = c + ((d << 5U) | (d >> 27U)) + ((e & a) | (b & (e | a))) + 0x8F1BBCDCU + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w8 ^ self.w3 ^ self.w13 ^ self.w11
  wv = (wv << 1U) | (wv >> 31U)
  self.w11 = wv
  b = b + ((c << 5U) | (c >> 27U)) + ((d & e) | (a & (d | e))) + 0x8F1BBCDCU + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w9 ^ self.w4 ^ self.w14 ^ self.w12
  wv = (wv << 1U) | (wv >> 31U)
  self.w12 = wv
  a = a + ((b << 5U) | (b >> 27U)) + ((c & d) | (e & (c | d))) + 0x8F1BBCDCU + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w10 ^ self.w5 ^ self.w15 ^ self.w13
  wv = (wv << 1U) | (wv >> 31U)
  self.w13 = wv
  e = e + ((a << 5U) | (a >> 27U)) + ((b & c) | (d & (b | c))) + 0x8F1BBCDCU + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w11 ^ self.w6 ^ self.w0 ^ self.w14
  wv = (wv << 1U) | (wv >> 31U)
  self.w14 = wv
  d = d + ((e << 5U) | (e >> 27U)) + ((a & b) | (c & (a | b))) + 0x8F1BBCDCU + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w12 ^ self.w7 ^ self.w1 ^ self.w15
  wv = (wv << 1U) | (wv >> 31U)
  self.w15 = wv
  c = c + ((d << 5U) | (d >> 27U)) + ((e & a) | (b & (e | a))) + 0x8F1BBCDCU + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w13 ^ self.w8 ^ self.w2 ^ self.w0
  wv = (wv << 1U) | (wv >> 31U)
  self.w0 = wv
  b = b + ((c << 5U) | (c >> 27U)) + ((d & e) | (a & (d | e))) + 0x8F1BBCDCU + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w14 ^ self.w9 ^ self.w3 ^ self.w1
  wv = (wv << 1U) | (wv >> 31U)
  self.w1 = wv
  a = a + ((b << 5U) | (b >> 27U)) + ((c & d) | (e & (c | d))) + 0x8F1BBCDCU + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w15 ^ self.w10 ^ self.w4 ^ self.w2
  wv = (wv << 1U) | (wv >> 31U)
  self.w2 = wv
  e = e + ((a << 5U) | (a >> 27U)) + ((b & c) | (d & (b | c))) + 0x8F1BBCDCU + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w0 ^ self.w11 ^ self.w5 ^ self.w3
  wv = (wv << 1U) | (wv >> 31U)
  self.w3 = wv
  d = d + ((e << 5U) | (e >> 27U)) + ((a & b) | (c & (a | b))) + 0x8F1BBCDCU + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w1 ^ self.w12 ^ self.w6 ^ self.w4
  wv = (wv << 1U) | (wv >> 31U)
  self.w4 = wv
  c = c + ((d << 5U) | (d >> 27U)) + ((e & a) | (b & (e | a))) + 0x8F1BBCDCU + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w2 ^ self.w13 ^ self.w7 ^ self.w5
  wv = (wv << 1U) | (wv >> 31U)
  self.w5 = wv
  b = b + ((c << 5U) | (c >> 27U)) + ((d & e) | (a & (d | e))) + 0x8F1BBCDCU + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w3 ^ self.w14 ^ self.w8 ^ self.w6
  wv = (wv << 1U) | (wv >> 31U)
  self.w6 = wv
  a = a + ((b << 5U) | (b >> 27U)) + ((c & d) | (e & (c | d))) + 0x8F1BBCDCU + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w4 ^ self.w15 ^ self.w9 ^ self.w7
  wv = (wv << 1U) | (wv >> 31U)
  self.w7 = wv
  e = e + ((a << 5U) | (a >> 27U)) + ((b & c) | (d & (b | c))) + 0x8F1BBCDCU + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w5 ^ self.w0 ^ self.w10 ^ self.w8
  wv = (wv << 1U) | (wv >> 31U)
  self.w8 = wv
  d = d + ((e << 5U) | (e >> 27U)) + ((a & b) | (c & (a | b))) + 0x8F1BBCDCU + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w6 ^ self.w1 ^ self.w11 ^ self.w9
  wv = (wv << 1U) | (wv >> 31U)
  self.w9 = wv
  c = c + ((d << 5U) | (d >> 27U)) + ((e & a) | (b & (e | a))) + 0x8F1BBCDCU + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w7 ^ self.w2 ^ self.w12 ^ self.w10
  wv = (wv << 1U) | (wv >> 31U)
  self.w10 = wv
  b = b + ((c << 5U) | (c >> 27U)) + ((d & e) | (a & (d | e))) + 0x8F1BBCDCU + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w8 ^ self.w3 ^ self.w13 ^ self.w11
  wv = (wv << 1U) | (wv >> 31U)
  self.w11 = wv
  a = a + ((b << 5U) | (b >> 27U)) + ((c & d) | (e & (c | d))) + 0x8F1BBCDCU + wv
  c = (c << 30U) | (c >> 2U)
  self.h0 = a
  self.h1 = b
  self.h2 = c
  self.h3 = d
  self.h4 = e
