fn GitSha1::compress_r3(self : GitSha1) -> Unit {
  let mut a = self.h0
  let mut b = self.h1
  let mut c = self.h2
  let mut d = self.h3
  let mut e = self.h4
  let mut wv : UInt = 0U
  wv = self.w9 ^ self.w4 ^ self.w14 ^ self.w12
  wv = (wv << 1U) | (wv >> 31U)
  self.w12 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0xCA62C1D6U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w10 ^ self.w5 ^ self.w15 ^ self.w13
  wv = (wv << 1U) | (wv >> 31U)
  self.w13 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0xCA62C1D6U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w11 ^ self.w6 ^ self.w0 ^ self.w14
  wv = (wv << 1U) | (wv >> 31U)
  self.w14 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0xCA62C1D6U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w12 ^ self.w7 ^ self.w1 ^ self.w15
  wv = (wv << 1U) | (wv >> 31U)
  self.w15 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0xCA62C1D6U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w13 ^ self.w8 ^ self.w2 ^ self.w0
  wv = (wv << 1U) | (wv >> 31U)
  self.w0 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0xCA62C1D6U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w14 ^ self.w9 ^ self.w3 ^ self.w1
  wv = (wv << 1U) | (wv >> 31U)
  self.w1 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0xCA62C1D6U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w15 ^ self.w10 ^ self.w4 ^ self.w2
  wv = (wv << 1U) | (wv >> 31U)
  self.w2 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0xCA62C1D6U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w0 ^ self.w11 ^ self.w5 ^ self.w3
  wv = (wv << 1U) | (wv >> 31U)
  self.w3 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0xCA62C1D6U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w1 ^ self.w12 ^ self.w6 ^ self.w4
  wv = (wv << 1U) | (wv >> 31U)
  self.w4 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0xCA62C1D6U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w2 ^ self.w13 ^ self.w7 ^ self.w5
  wv = (wv << 1U) | (wv >> 31U)
  self.w5 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0xCA62C1D6U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w3 ^ self.w14 ^ self.w8 ^ self.w6
  wv = (wv << 1U) | (wv >> 31U)
  self.w6 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0xCA62C1D6U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w4 ^ self.w15 ^ self.w9 ^ self.w7
  wv = (wv << 1U) | (wv >> 31U)
  self.w7 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0xCA62C1D6U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w5 ^ self.w0 ^ self.w10 ^ self.w8
  wv = (wv << 1U) | (wv >> 31U)
  self.w8 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0xCA62C1D6U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w6 ^ self.w1 ^ self.w11 ^ self.w9
  wv = (wv << 1U) | (wv >> 31U)
  self.w9 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0xCA62C1D6U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w7 ^ self.w2 ^ self.w12 ^ self.w10
  wv = (wv << 1U) | (wv >> 31U)
  self.w10 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0xCA62C1D6U + wv
  c = (c << 30U) | (c >> 2U)
  wv = self.w8 ^ self.w3 ^ self.w13 ^ self.w11
  wv = (wv << 1U) | (wv >> 31U)
  self.w11 = wv
  e = e + ((a << 5U) | (a >> 27U)) + (b ^ c ^ d) + 0xCA62C1D6U + wv
  b = (b << 30U) | (b >> 2U)
  wv = self.w9 ^ self.w4 ^ self.w14 ^ self.w12
  wv = (wv << 1U) | (wv >> 31U)
  self.w12 = wv
  d = d + ((e << 5U) | (e >> 27U)) + (a ^ b ^ c) + 0xCA62C1D6U + wv
  a = (a << 30U) | (a >> 2U)
  wv = self.w10 ^ self.w5 ^ self.w15 ^ self.w13
  wv = (wv << 1U) | (wv >> 31U)
  self.w13 = wv
  c = c + ((d << 5U) | (d >> 27U)) + (e ^ a ^ b) + 0xCA62C1D6U + wv
  e = (e << 30U) | (e >> 2U)
  wv = self.w11 ^ self.w6 ^ self.w0 ^ self.w14
  wv = (wv << 1U) | (wv >> 31U)
  self.w14 = wv
  b = b + ((c << 5U) | (c >> 27U)) + (d ^ e ^ a) + 0xCA62C1D6U + wv
  d = (d << 30U) | (d >> 2U)
  wv = self.w12 ^ self.w7 ^ self.w1 ^ self.w15
  wv = (wv << 1U) | (wv >> 31U)
  self.w15 = wv
  a = a + ((b << 5U) | (b >> 27U)) + (c ^ d ^ e) + 0xCA62C1D6U + wv
  c = (c << 30U) | (c >> 2U)
  self.h0 = a
  self.h1 = b
  self.h2 = c
  self.h3 = d
  self.h4 = e
}

///| Compress `self.w0..w15` into `self.h0..h4`.
fn GitSha1::compress_w(self : GitSha1) -> Unit {
  let s0 = self.h0
  let s1 = self.h1
  let s2 = self.h2
  let s3 = self.h3
  let s4 = self.h4
  self.compress_r0()
  self.compress_r1()
  self.compress_r2()
  self.compress_r3()
  self.h0 = self.h0 + s0
  self.h1 = self.h1 + s1
  self.h2 = self.h2 + s2
  self.h3 = self.h3 + s3
  self.h4 = self.h4 + s4
}

///| Load 64 bytes from `data[off..off+64)` into `self.w0..w15` and compress.
fn GitSha1::compress_bytes(self : GitSha1, data : Bytes, off : Int) -> Unit {
  self.w0 = (data[off].to_int().to_uint() << 24U) | (data[off+1].to_int().to_uint() << 16U) | (data[off+2].to_int().to_uint() << 8U) | data[off+3].to_int().to_uint()
  self.w1 = (data[off + 4].to_int().to_uint() << 24U) | (data[off + 4+1].to_int().to_uint() << 16U) | (data[off + 4+2].to_int().to_uint() << 8U) | data[off + 4+3].to_int().to_uint()
  self.w2 = (data[off + 8].to_int().to_uint() << 24U) | (data[off + 8+1].to_int().to_uint() << 16U) | (data[off + 8+2].to_int().to_uint() << 8U) | data[off + 8+3].to_int().to_uint()
  self.w3 = (data[off + 12].to_int().to_uint() << 24U) | (data[off + 12+1].to_int().to_uint() << 16U) | (data[off + 12+2].to_int().to_uint() << 8U) | data[off + 12+3].to_int().to_uint()
  self.w4 = (data[off + 16].to_int().to_uint() << 24U) | (data[off + 16+1].to_int().to_uint() << 16U) | (data[off + 16+2].to_int().to_uint() << 8U) | data[off + 16+3].to_int().to_uint()
  self.w5 = (data[off + 20].to_int().to_uint() << 24U) | (data[off + 20+1].to_int().to_uint() << 16U) | (data[off + 20+2].to_int().to_uint() << 8U) | data[off + 20+3].to_int().to_uint()
  self.w6 = (data[off + 24].to_int().to_uint() << 24U) | (data[off + 24+1].to_int().to_uint() << 16U) | (data[off + 24+2].to_int().to_uint() << 8U) | data[off + 24+3].to_int().to_uint()
  self.w7 = (data[off + 28].to_int().to_uint() << 24U) | (data[off + 28+1].to_int().to_uint() << 16U) | (data[off + 28+2].to_int().to_uint() << 8U) | data[off + 28+3].to_int().to_uint()
  self.w8 = (data[off + 32].to_int().to_uint() << 24U) | (data[off + 32+1].to_int().to_uint() << 16U) | (data[off + 32+2].to_int().to_uint() << 8U) | data[off + 32+3].to_int().to_uint()
  self.w9 = (data[off + 36].to_int().to_uint() << 24U) | (data[off + 36+1].to_int().to_uint() << 16U) | (data[off + 36+2].to_int().to_uint() << 8U) | data[off + 36+3].to_int().to_uint()
  self.w10 = (data[off + 40].to_int().to_uint() << 24U) | (data[off + 40+1].to_int().to_uint() << 16U) | (data[off + 40+2].to_int().to_uint() << 8U) | data[off + 40+3].to_int().to_uint()
  self.w11 = (data[off + 44].to_int().to_uint() << 24U) | (data[off + 44+1].to_int().to_uint() << 16U) | (data[off + 44+2].to_int().to_uint() << 8U) | data[off + 44+3].to_int().to_uint()
  self.w12 = (data[off + 48].to_int().to_uint() << 24U) | (data[off + 48+1].to_int().to_uint() << 16U) | (data[off + 48+2].to_int().to_uint() << 8U) | data[off + 48+3].to_int().to_uint()
  self.w13 = (data[off + 52].to_int().to_uint() << 24U) | (data[off + 52+1].to_int().to_uint() << 16U) | (data[off + 52+2].to_int().to_uint() << 8U) | data[off + 52+3].to_int().to_uint()
  self.w14 = (data[off + 56].to_int().to_uint() << 24U) | (data[off + 56+1].to_int().to_uint() << 16U) | (data[off + 56+2].to_int().to_uint() << 8U) | data[off + 56+3].to_int().to_uint()
  self.w15 = (data[off + 60].to_int().to_uint() << 24U) | (data[off + 60+1].to_int().to_uint() << 16U) | (data[off + 60+2].to_int().to_uint() << 8U) | data[off + 60+3].to_int().to_uint()
  self.compress_w()
}

///| Load 64 bytes from `self.buf` into `self.w0..w15` and compress.
fn GitSha1::compress_buf(self : GitSha1) -> Unit {
  let buf = self.buf
  self.w0 = (buf[0].to_int().to_uint() << 24U) | (buf[1].to_int().to_uint() << 16U) | (buf[2].to_int().to_uint() << 8U) | buf[3].to_int().to_uint()
  self.w1 = (buf[4].to_int().to_uint() << 24U) | (buf[5].to_int().to_uint() << 16U) | (buf[6].to_int().to_uint() << 8U) | buf[7].to_int().to_uint()
  self.w2 = (buf[8].to_int().to_uint() << 24U) | (buf[9].to_int().to_uint() << 16U) | (buf[10].to_int().to_uint() << 8U) | buf[11].to_int().to_uint()
  self.w3 = (buf[12].to_int().to_uint() << 24U) | (buf[13].to_int().to_uint() << 16U) | (buf[14].to_int().to_uint() << 8U) | buf[15].to_int().to_uint()
  self.w4 = (buf[16].to_int().to_uint() << 24U) | (buf[17].to_int().to_uint() << 16U) | (buf[18].to_int().to_uint() << 8U) | buf[19].to_int().to_uint()
  self.w5 = (buf[20].to_int().to_uint() << 24U) | (buf[21].to_int().to_uint() << 16U) | (buf[22].to_int().to_uint() << 8U) | buf[23].to_int().to_uint()
  self.w6 = (buf[24].to_int().to_uint() << 24U) | (buf[25].to_int().to_uint() << 16U) | (buf[26].to_int().to_uint() << 8U) | buf[27].to_int().to_uint()
  self.w7 = (buf[28].to_int().to_uint() << 24U) | (buf[29].to_int().to_uint() << 16U) | (buf[30].to_int().to_uint() << 8U) | buf[31].to_int().to_uint()
  self.w8 = (buf[32].to_int().to_uint() << 24U) | (buf[33].to_int().to_uint() << 16U) | (buf[34].to_int().to_uint() << 8U) | buf[35].to_int().to_uint()
  self.w9 = (buf[36].to_int().to_uint() << 24U) | (buf[37].to_int().to_uint() << 16U) | (buf[38].to_int().to_uint() << 8U) | buf[39].to_int().to_uint()
  self.w10 = (buf[40].to_int().to_uint() << 24U) | (buf[41].to_int().to_uint() << 16U) | (buf[42].to_int().to_uint() << 8U) | buf[43].to_int().to_uint()
  self.w11 = (buf[44].to_int().to_uint() << 24U) | (buf[45].to_int().to_uint() << 16U) | (buf[46].to_int().to_uint() << 8U) | buf[47].to_int().to_uint()
  self.w12 = (buf[48].to_int().to_uint() << 24U) | (buf[49].to_int().to_uint() << 16U) | (buf[50].to_int().to_uint() << 8U) | buf[51].to_int().to_uint()
  self.w13 = (buf[52].to_int().to_uint() << 24U) | (buf[53].to_int().to_uint() << 16U) | (buf[54].to_int().to_uint() << 8U) | buf[55].to_int().to_uint()
  self.w14 = (buf[56].to_int().to_uint() << 24U) | (buf[57].to_int().to_uint() << 16U) | (buf[58].to_int().to_uint() << 8U) | buf[59].to_int().to_uint()
  self.w15 = (buf[60].to_int().to_uint() << 24U) | (buf[61].to_int().to_uint() << 16U) | (buf[62].to_int().to_uint() << 8U) | buf[63].to_int().to_uint()
  self.compress_w()
}

///|
fn GitSha1::update_slice(self : GitSha1, data : Bytes, start : Int, end : Int) -> Unit {
  let n = data.length()
  let mut pos = if start < 0 { 0 } else { start }
  let lim = if end > n { n } else { end }
  if pos >= lim {
    return
  }
  self.total = self.total + (lim - pos).to_int64()
  let buf = self.buf
  let mut fill = self.fill
  if fill > 0 {
    while pos < lim && fill < 64 {
      buf[fill] = data[pos]
      fill = fill + 1
      pos = pos + 1
    }
    if fill == 64 {
      self.compress_buf()
      fill = 0
    }
  }
  while pos + 64 <= lim {
    self.compress_bytes(data, pos)
    pos = pos + 64
  }
  while pos < lim {
    buf[fill] = data[pos]
    fill = fill + 1
    pos = pos + 1
  }
  self.fill = fill
}

///| Finalize and return 20-byte SHA-1 digest (consumes state; call `reset()` to reuse).
fn GitSha1::finalize_bytes(self : GitSha1) -> Bytes {
  let buf = self.buf
  let mut fill = self.fill
  let bit_len : UInt64 = self.total.to_uint64() << 3
  buf[fill] = 0x80.to_byte()
  fill = fill + 1
  if fill > 56 {
    while fill < 64 {
      buf[fill] = 0.to_byte()
      fill = fill + 1
    }
    self.compress_buf()
    fill = 0
  }
  while fill < 56 {
    buf[fill] = 0.to_byte()
    fill = fill + 1
  }
  buf[56] = ((bit_len >> 56) & 0xFFUL).to_int().to_byte()
  buf[57] = ((bit_len >> 48) & 0xFFUL).to_int().to_byte()
  buf[58] = ((bit_len >> 40) & 0xFFUL).to_int().to_byte()
  buf[59] = ((bit_len >> 32) & 0xFFUL).to_int().to_byte()
  buf[60] = ((bit_len >> 24) & 0xFFUL).to_int().to_byte()
  buf[61] = ((bit_len >> 16) & 0xFFUL).to_int().to_byte()
  buf[62] = ((bit_len >> 8) & 0xFFUL).to_int().to_byte()
  buf[63] = (bit_len & 0xFFUL).to_int().to_byte()
  self.compress_buf()
  let out = Bytes::new(20)
  let v0 = self.h0
  out[0] = ((v0 >> 24U) & 0xFFU).to_int().to_byte()
  out[1] = ((v0 >> 16U) & 0xFFU).to_int().to_byte()
  out[2] = ((v0 >> 8U) & 0xFFU).to_int().to_byte()
  out[3] = (v0 & 0xFFU).to_int().to_byte()
  let v1 = self.h1
  out[4] = ((v1 >> 24U) & 0xFFU).to_int().to_byte()
  out[5] = ((v1 >> 16U) & 0xFFU).to_int().to_byte()
  out[6] = ((v1 >> 8U) & 0xFFU).to_int().to_byte()
  out[7] = (v1 & 0xFFU).to_int().to_byte()
  let v2 = self.h2
  out[8] = ((v2 >> 24U) & 0xFFU).to_int().to_byte()
  out[9] = ((v2 >> 16U) & 0xFFU).to_int().to_byte()
  out[10] = ((v2 >> 8U) & 0xFFU).to_int().to_byte()
  out[11] = (v2 & 0xFFU).to_int().to_byte()
  let v3 = self.h3
  out[12] = ((v3 >> 24U) & 0xFFU).to_int().to_byte()
  out[13] = ((v3 >> 16U) & 0xFFU).to_int().to_byte()
  out[14] = ((v3 >> 8U) & 0xFFU).to_int().to_byte()
  out[15] = (v3 & 0xFFU).to_int().to_byte()
  let v4 = self.h4
  out[16] = ((v4 >> 24U) & 0xFFU).to_int().to_byte()
  out[17] = ((v4 >> 16U) & 0xFFU).to_int().to_byte()
  out[18] = ((v4 >> 8U) & 0xFFU).to_int().to_byte()
  out[19] = (v4 & 0xFFU).to_int().to_byte()
  out
}

///| Hash `<kind> <payload.len>\0<payload>` directly into `self.buf` (zero header allocs).
fn GitSha1::hash_git_object(self : GitSha1, kind : ObjectKind, payload : Bytes) -> Oid {
  self.reset()
  let buf = self.buf
  let mut p = 0
  match kind {
    ObjectKind::Blob => {
      buf[0] = 98.to_byte(); buf[1] = 108.to_byte(); buf[2] = 111.to_byte(); buf[3] = 98.to_byte(); buf[4] = 32.to_byte()
      p = 5
    }
    ObjectKind::Tree => {
      buf[0] = 116.to_byte(); buf[1] = 114.to_byte(); buf[2] = 101.to_byte(); buf[3] = 101.to_byte(); buf[4] = 32.to_byte()
      p = 5
    }
    ObjectKind::Commit => {
      buf[0] = 99.to_byte(); buf[1] = 111.to_byte(); buf[2] = 109.to_byte(); buf[3] = 109.to_byte(); buf[4] = 105.to_byte(); buf[5] = 116.to_byte(); buf[6] = 32.to_byte()
      p = 7
    }
    ObjectKind::Tag => {
      buf[0] = 116.to_byte(); buf[1] = 97.to_byte(); buf[2] = 103.to_byte(); buf[3] = 32.to_byte()
      p = 4
    }
  }
  let plen = payload.length()
  if plen == 0 {
    buf[p] = 48.to_byte()
    p = p + 1
  } else {
    let start = p
    let mut v = plen
    while v > 0 {
      buf[p] = (48 + (v % 10)).to_byte()
      v = v / 10
      p = p + 1
    }
    let mut lo = start
    let mut hi = p - 1
    while lo < hi {
      let tmp = buf[lo]
      buf[lo] = buf[hi]
      buf[hi] = tmp
      lo = lo + 1
      hi = hi - 1
    }
  }
  buf[p] = 0.to_byte()
  self.fill = p + 1
  self.total = (p + 1).to_int64()
  self.update_slice(payload, 0, plen)
  Oid::{ kind: HashKind::Sha1, bytes: self.finalize_bytes() }
}

///| One-shot SHA-1 over `data[start..end)`.
fn git_sha1_slice(data : Bytes, start : Int, end : Int) -> Bytes {
  let h = GitSha1::new()
  h.update_slice(data, start, end)
  h.finalize_bytes()
}
