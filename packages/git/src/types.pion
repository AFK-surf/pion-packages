///| Core Git data types, error taxonomy, security limits, and binary helpers.
///| Pure Pion, zero C dependencies, no `World`.

import "crypto"
import "flate"
import "diff"

///| Hash algorithm used for Git Object IDs.
pub enum HashKind {
  Sha1
  Sha256
}

///| Git object type.
pub enum ObjectKind {
  Commit
  Tree
  Blob
  Tag
}

///| Structured error type for all Git plumbing operations.
pub enum GitError {
  InvalidOid(String)
  InvalidObject(String)
  InvalidHeader(String)
  InvalidTree(String)
  InvalidCommit(String)
  InvalidTag(String)
  InvalidPack(String)
  InvalidPackIndex(String)
  InvalidDelta(String)
  InvalidIndex(String)
  InvalidPktLine(String)
  InvalidRefName(String)
  ChecksumMismatch(String)
  DecompressError(String)
  CompressError(String)
  ObjectNotFound(String)
  CycleDetected(String)
  InsecurePath(String)
  LimitExceeded(String)
  InvalidLimits(String)
  Truncated(String)
  UnsupportedVersion(Int)
}

///| Human-readable message for a `GitError`.
pub fn git_error_message(err : GitError) -> String {
  match err {
    GitError::InvalidOid(m) => "invalid oid: " + m
    GitError::InvalidObject(m) => "invalid object: " + m
    GitError::InvalidHeader(m) => "invalid header: " + m
    GitError::InvalidTree(m) => "invalid tree: " + m
    GitError::InvalidCommit(m) => "invalid commit: " + m
    GitError::InvalidTag(m) => "invalid tag: " + m
    GitError::InvalidPack(m) => "invalid pack: " + m
    GitError::InvalidPackIndex(m) => "invalid pack index: " + m
    GitError::InvalidDelta(m) => "invalid delta: " + m
    GitError::InvalidIndex(m) => "invalid index: " + m
    GitError::InvalidPktLine(m) => "invalid pkt-line: " + m
    GitError::InvalidRefName(m) => "invalid ref name: " + m
    GitError::ChecksumMismatch(m) => "checksum mismatch: " + m
    GitError::DecompressError(m) => "decompress error: " + m
    GitError::CompressError(m) => "compress error: " + m
    GitError::ObjectNotFound(m) => "object not found: " + m
    GitError::CycleDetected(m) => "cycle detected: " + m
    GitError::InsecurePath(m) => "insecure path: " + m
    GitError::LimitExceeded(m) => "limit exceeded: " + m
    GitError::InvalidLimits(m) => "invalid limits: " + m
    GitError::Truncated(m) => "truncated: " + m
    GitError::UnsupportedVersion(v) => "unsupported version: " + v.to_string()
  }
}

///|
pub fn GitError::to_string(self : GitError) -> String {
  git_error_message(self)
}

///| Defensive resource limits for Git parsing, packfile inflation, and delta resolution.
pub val struct GitLimits {
  pub max_object_bytes : Int
  pub max_pack_entries : Int
  pub max_delta_depth : Int
  pub max_delta_result_bytes : Int
  pub max_tree_entries : Int
  pub max_index_entries : Int
  pub max_pack_total_bytes : Int64
}

///| Default conservative limits.
pub fn GitLimits::default() -> GitLimits {
  GitLimits::{
    max_object_bytes: 67108864,
    max_pack_entries: 1000000,
    max_delta_depth: 500,
    max_delta_result_bytes: 67108864,
    max_tree_entries: 100000,
    max_index_entries: 1000000,
    max_pack_total_bytes: 268435456L,
  }
}

///| Construct custom `GitLimits`.
pub fn GitLimits::new(
  max_object_bytes : Int,
  max_pack_entries : Int,
  max_delta_depth : Int,
  max_delta_result_bytes : Int,
  max_tree_entries : Int,
  max_index_entries : Int,
) -> GitLimits {
  let default_total : Int64 = 268435456L
  let scaled_obj : Int64 = if max_object_bytes > 0 {
    max_object_bytes.to_int64() * 4L
  } else {
    0L
  }
  let max_pack_total_bytes = if scaled_obj > default_total {
    scaled_obj
  } else {
    default_total
  }
  GitLimits::{
    max_object_bytes: max_object_bytes,
    max_pack_entries: max_pack_entries,
    max_delta_depth: max_delta_depth,
    max_delta_result_bytes: max_delta_result_bytes,
    max_tree_entries: max_tree_entries,
    max_index_entries: max_index_entries,
    max_pack_total_bytes: max_pack_total_bytes,
  }
}

///| Return a copy of `GitLimits` with a custom aggregate packfile byte budget.
pub fn GitLimits::with_max_pack_total_bytes(
  self : GitLimits,
  max_pack_total_bytes : Int64,
) -> GitLimits {
  GitLimits::{
    max_object_bytes: self.max_object_bytes,
    max_pack_entries: self.max_pack_entries,
    max_delta_depth: self.max_delta_depth,
    max_delta_result_bytes: self.max_delta_result_bytes,
    max_tree_entries: self.max_tree_entries,
    max_index_entries: self.max_index_entries,
    max_pack_total_bytes: max_pack_total_bytes,
  }
}

///| Check whether all limit fields are non-negative.
pub fn git_limits_is_valid(l : GitLimits) -> Bool {
  l.max_object_bytes >= 0 &&
  l.max_pack_entries >= 0 &&
  l.max_delta_depth >= 0 &&
  l.max_delta_result_bytes >= 0 &&
  l.max_tree_entries >= 0 &&
  l.max_index_entries >= 0 &&
  l.max_pack_total_bytes >= 0L
}

///| Validate that all limit fields are non-negative.
pub fn GitLimits::validate(self : GitLimits) -> Result[Unit, GitError] {
  if !git_limits_is_valid(self) {
    return Err(GitError::InvalidLimits("negative limit"))
  }
  Ok(())
}

///|
pub fn HashKind::byte_len(self : HashKind) -> Int {
  match self {
    HashKind::Sha1 => 20
    HashKind::Sha256 => 32
  }
}

///|
pub fn HashKind::equals(self : HashKind, other : HashKind) -> Bool {
  match (self, other) {
    (HashKind::Sha1, HashKind::Sha1) => true
    (HashKind::Sha256, HashKind::Sha256) => true
    _ => false
  }
}

///|
pub fn ObjectKind::as_str(self : ObjectKind) -> String {
  match self {
    ObjectKind::Commit => "commit"
    ObjectKind::Tree => "tree"
    ObjectKind::Blob => "blob"
    ObjectKind::Tag => "tag"
  }
}

///|
pub fn ObjectKind::from_str(s : String) -> Result[ObjectKind, GitError] {
  if s == "commit" {
    Ok(ObjectKind::Commit)
  } else if s == "tree" {
    Ok(ObjectKind::Tree)
  } else if s == "blob" {
    Ok(ObjectKind::Blob)
  } else if s == "tag" {
    Ok(ObjectKind::Tag)
  } else {
    Err(GitError::InvalidObject("unknown object type: " + s))
  }
}

///|
pub fn ObjectKind::pack_type(self : ObjectKind) -> Int {
  match self {
    ObjectKind::Commit => 1
    ObjectKind::Tree => 2
    ObjectKind::Blob => 3
    ObjectKind::Tag => 4
  }
}

///|
pub fn object_kind_from_pack_type_opt(t : Int) -> Option[ObjectKind] {
  if t == 1 {
    Some(ObjectKind::Commit)
  } else if t == 2 {
    Some(ObjectKind::Tree)
  } else if t == 3 {
    Some(ObjectKind::Blob)
  } else if t == 4 {
    Some(ObjectKind::Tag)
  } else {
    None
  }
}

///|
pub fn ObjectKind::from_pack_type(t : Int) -> Result[ObjectKind, GitError] {
  match object_kind_from_pack_type_opt(t) {
    Some(k) => Ok(k)
    None => Err(GitError::InvalidPack("invalid object pack type: " + t.to_string()))
  }
}

///|
pub fn ObjectKind::equals(self : ObjectKind, other : ObjectKind) -> Bool {
  self.pack_type() == other.pack_type()
}

// ============================================================================
// Internal Binary & Buffer Helpers
// ============================================================================

///|
fn read_u16_be(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 8U) | b[off + 1].to_int().to_uint()
}

///|
fn read_u32_be(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24U) |
  (b[off + 1].to_int().to_uint() << 16U) |
  (b[off + 2].to_int().to_uint() << 8U) |
  b[off + 3].to_int().to_uint()
}

///|
fn read_u64_be(b : Bytes, off : Int) -> Int64 {
  let hi = read_u32_be(b, off).to_int64() & 0xFFFFFFFFL
  let lo = read_u32_be(b, off + 4).to_int64() & 0xFFFFFFFFL
  (hi << 32) | lo
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn bytes_eq_slice(a : Bytes, a_off : Int, b : Bytes, b_off : Int, len : Int) -> Bool {
  let mut i = 0
  while i < len {
    if a[a_off + i] != b[b_off + i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn bytes_cmp_slice(a : Bytes, a_off : Int, b : Bytes, b_off : Int, len : Int) -> Int {
  let mut i = 0
  while i < len {
    let av = a[a_off + i].to_int()
    let bv = b[b_off + i].to_int()
    if av != bv {
      return if av < bv { -1 } else { 1 }
    }
    i = i + 1
  }
  0
}

///| Growable byte buffer for fast binary serialization.
struct ByteBuf {
  mut buf : Bytes
  mut len : Int
}

///|
fn ByteBuf::new(cap : Int) -> ByteBuf {
  let c = if cap < 16 { 16 } else { cap }
  ByteBuf::{ buf: Bytes::new(c), len: 0 }
}

///|
fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  let needed = self.len + extra
  let cur_cap = self.buf.length()
  if needed <= cur_cap {
    return
  }
  let mut new_cap = if cur_cap < 16 { 16 } else { cur_cap }
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let pad = Bytes::new(new_cap - self.len)
  if self.len == 0 {
    self.buf = Bytes::new(new_cap)
  } else if self.len == cur_cap {
    self.buf = self.buf.concat(pad)
  } else {
    self.buf = self.buf.slice(0, self.len).concat(pad)
  }
}

///|
fn ByteBuf::push_byte(self : ByteBuf, v : Int) -> Unit {
  self.ensure(1)
  self.buf[self.len] = (v & 0xFF).to_byte()
  self.len = self.len + 1
}

///|
fn ByteBuf::push_u16_be(self : ByteBuf, v : UInt) -> Unit {
  self.ensure(2)
  self.buf[self.len] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  self.buf[self.len + 1] = (v & 0xFFU).to_int().to_byte()
  self.len = self.len + 2
}

///|
fn ByteBuf::push_u32_be(self : ByteBuf, v : UInt) -> Unit {
  self.ensure(4)
  self.buf[self.len] = ((v >> 24U) & 0xFFU).to_int().to_byte()
  self.buf[self.len + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  self.buf[self.len + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  self.buf[self.len + 3] = (v & 0xFFU).to_int().to_byte()
  self.len = self.len + 4
}

///|
fn ByteBuf::push_u64_be(self : ByteBuf, v : Int64) -> Unit {
  self.push_u32_be(((v >> 32) & 0xFFFFFFFFL).to_int().to_uint())
  self.push_u32_be((v & 0xFFFFFFFFL).to_int().to_uint())
}

///|
fn ByteBuf::push_bytes_slice(self : ByteBuf, src : Bytes, start : Int, end : Int) -> Unit {
  let n = end - start
  if n <= 0 {
    return
  }
  self.ensure(n)
  let mut i = 0
  let p = self.len
  while i < n {
    self.buf[p + i] = src[start + i]
    i = i + 1
  }
  self.len = p + n
}

///|
fn ByteBuf::push_bytes(self : ByteBuf, src : Bytes) -> Unit {
  self.push_bytes_slice(src, 0, src.length())
}

///|
fn ByteBuf::push_str(self : ByteBuf, s : String) -> Unit {
  self.push_bytes(s.to_bytes())
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  if self.len == self.buf.length() {
    self.buf
  } else {
    self.buf.slice(0, self.len)
  }
}

///| Strip HFS+ ignorable UTF-8 code points (U+200C..200F, U+202A..202E, U+206A..206F, U+FEFF)
///| and ASCII-lowercase into a byte array.
fn normalize_git_name_bytes(s : String) -> Array[Int] {
  let out : Array[Int] = Array::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 == 0xE2 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 == 0x80 && ((b2 >= 0x8C && b2 <= 0x8F) || (b2 >= 0xAA && b2 <= 0xAE))) ||
      (b1 == 0x81 && b2 >= 0xAA && b2 <= 0xAF) {
        i = i + 3
        continue
      }
    } else if b0 == 0xEF && i + 2 < n {
      if s.code_unit_at(i + 1) == 0xBB && s.code_unit_at(i + 2) == 0xBF {
        i = i + 3
        continue
      }
    }
    let lc = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
    out.push(lc)
    i = i + 1
  }
  out
}

///| Strip NTFS Alternate Data Stream (`:...`) and trailing dots/spaces.
fn strip_ntfs_tail(bytes : Array[Int]) -> Int {
  let mut end = bytes.length()
  let mut i = 0
  while i < end {
    if bytes[i] == 58 {
      end = i
      break
    }
    i = i + 1
  }
  while end > 0 && (bytes[end - 1] == 46 || bytes[end - 1] == 32) {
    end = end - 1
  }
  end
}

///|
fn bytes_arr_eq_ascii(bytes : Array[Int], end : Int, target : String) -> Bool {
  if end != target.length() {
    return false
  }
  let mut i = 0
  while i < end {
    if bytes[i] != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check if `bytes[0..end]` matches `<pfx>~<digits>` (NTFS 8.3 short name).
fn is_ntfs_shortname(bytes : Array[Int], end : Int, pfx : String) -> Bool {
  let pl = pfx.length()
  if end < pl + 2 {
    return false
  }
  let mut i = 0
  while i < pl {
    if bytes[i] != pfx.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  if bytes[pl] != 126 {
    return false
  }
  let mut j = pl + 1
  while j < end {
    let c = bytes[j]
    if c < 48 || c > 57 {
      return false
    }
    j = j + 1
  }
  true
}

///| Detect `.git` and all NTFS/HFS+ aliases (CVE-2014-9390 / CVE-2019-1353).
fn is_dotgit_component(s : String) -> Bool {
  let n = s.length()
  if n < 4 {
    return false
  }
  // Fast ASCII reject: must start with '.', 'g', 'G', or a multi-byte UTF-8 ignorable (>= 0x80)
  let c0 = s.code_unit_at(0)
  if c0 != 46 && c0 != 103 && c0 != 71 && c0 < 128 {
    return false
  }
  let norm = normalize_git_name_bytes(s)
  let end = strip_ntfs_tail(norm)
  bytes_arr_eq_ascii(norm, end, ".git") || is_ntfs_shortname(norm, end, "git")
}

///| Detect symlinked `.gitmodules` / `.gitattributes` / `.gitignore` and NTFS/HFS+ aliases (CVE-2018-11235).
fn is_dotgit_special_file(s : String) -> Bool {
  let n = s.length()
  if n < 6 {
    return false
  }
  let c0 = s.code_unit_at(0)
  if c0 != 46 && c0 != 103 && c0 != 71 && c0 < 128 {
    return false
  }
  let norm = normalize_git_name_bytes(s)
  let end = strip_ntfs_tail(norm)
  bytes_arr_eq_ascii(norm, end, ".gitmodules") ||
  is_ntfs_shortname(norm, end, "gitmod") ||
  is_ntfs_shortname(norm, end, "gi7eba") ||
  bytes_arr_eq_ascii(norm, end, ".gitattributes") ||
  is_ntfs_shortname(norm, end, "gitatt") ||
  is_ntfs_shortname(norm, end, "gi7d29") ||
  bytes_arr_eq_ascii(norm, end, ".gitignore") ||
  is_ntfs_shortname(norm, end, "gitign") ||
  is_ntfs_shortname(norm, end, "gi250a") ||
  bytes_arr_eq_ascii(norm, end, ".gitmailmap")
}

///| Validate a single Git tree path component (no empty, `.`, `..`, `.git` & aliases, `/`, NUL).
fn validate_git_path_component(name : String) -> Result[Unit, GitError] {
  let n = name.length()
  if n == 0 {
    return Err(GitError::InsecurePath("empty path component"))
  }
  let c0 = name.code_unit_at(0)
  if c0 == 46 {
    if n == 1 || (n == 2 && name.code_unit_at(1) == 46) || is_dotgit_component(name) {
      return Err(GitError::InsecurePath("disallowed path component: " + name))
    }
  } else if (c0 == 103 || c0 == 71 || c0 >= 128) && n >= 4 && is_dotgit_component(name) {
    return Err(GitError::InsecurePath("disallowed path component: " + name))
  }
  let mut i = 0
  while i < n {
    let c = name.code_unit_at(i)
    if c == 0 || c == 47 {
      return Err(GitError::InsecurePath("illegal character in component: " + name))
    }
    i = i + 1
  }
  Ok(())
}

///| Validate a Git relative path (for `.git/index`): no leading/trailing `/`, no `//`, no `..`/`.`/`.git`, no NUL.
fn validate_git_rel_path(path : String) -> Result[Unit, GitError] {
  let n = path.length()
  if n == 0 {
    return Err(GitError::InsecurePath("empty index path"))
  }
  if path.code_unit_at(0) == 47 || path.code_unit_at(n - 1) == 47 {
    return Err(GitError::InsecurePath("leading or trailing slash: " + path))
  }
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || path.code_unit_at(i) == 47 {
      let seg_len = i - start
      if seg_len == 0 {
        return Err(GitError::InsecurePath("empty path segment in: " + path))
      }
      let c0 = path.code_unit_at(start)
      if c0 == 46 {
        if seg_len == 1 ||
        (seg_len == 2 && path.code_unit_at(start + 1) == 46) ||
        (seg_len >= 4 && is_dotgit_component(path.slice(start, i))) {
          return Err(GitError::InsecurePath("disallowed path segment: " + path))
        }
      } else if (c0 == 103 || c0 == 71 || c0 >= 128) &&
      seg_len >= 4 &&
      is_dotgit_component(path.slice(start, i)) {
        return Err(GitError::InsecurePath("disallowed path segment: " + path))
      }
      start = i + 1
    } else {
      let c = path.code_unit_at(i)
      if c == 0 {
        return Err(GitError::InsecurePath("NUL byte in path"))
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Zero-allocation relative path validator directly over `data[start_off..end_off)`.
fn validate_git_rel_path_bytes(
  data : Bytes,
  start_off : Int,
  end_off : Int,
) -> Result[Unit, GitError] {
  if start_off >= end_off {
    return Err(GitError::InsecurePath("empty index path"))
  }
  if data[start_off].to_int() == 47 || data[end_off - 1].to_int() == 47 {
    return Err(
      GitError::InsecurePath("leading or trailing slash: " + data.slice(start_off, end_off).to_string()),
    )
  }
  let mut seg_start = start_off
  let mut i = start_off
  while i <= end_off {
    if i == end_off || data[i].to_int() == 47 {
      let seg_len = i - seg_start
      if seg_len == 0 {
        return Err(
          GitError::InsecurePath("empty path segment in: " + data.slice(start_off, end_off).to_string()),
        )
      }
      let c0 = data[seg_start].to_int()
      if c0 == 46 {
        if seg_len == 1 ||
        (seg_len == 2 && data[seg_start + 1].to_int() == 46) ||
        (seg_len >= 4 && is_dotgit_component(data.slice(seg_start, i).to_string())) {
          return Err(
            GitError::InsecurePath(
              "disallowed path segment: " + data.slice(start_off, end_off).to_string(),
            ),
          )
        }
      } else if (c0 == 103 || c0 == 71 || c0 >= 128) &&
      seg_len >= 4 &&
      is_dotgit_component(data.slice(seg_start, i).to_string()) {
        return Err(
          GitError::InsecurePath(
            "disallowed path segment: " + data.slice(start_off, end_off).to_string(),
          ),
        )
      }
      seg_start = i + 1
    } else if data[i].to_int() == 0 {
      return Err(GitError::InsecurePath("NUL byte in path"))
    }
    i = i + 1
  }
  Ok(())
}

///| Parse non-negative Git signature timestamp directly from bytes `[start..end)`.
fn parse_timestamp_bytes(data : Bytes, start : Int, end : Int) -> Result[Int64, GitError] {
  let n = end - start
  if n <= 0 {
    return Err(GitError::InvalidCommit("empty timestamp"))
  }
  if n > 1 && data[start].to_int() == 48 {
    return Err(GitError::InvalidCommit("zero-padded timestamp"))
  }
  let mut v : Int64 = 0L
  let mut i = start
  while i < end {
    let c = data[i].to_int()
    if c < 48 || c > 57 {
      return Err(GitError::InvalidCommit("invalid digit in timestamp"))
    }
    let d = (c - 48).to_int64()
    if v > 922337203685477580L || (v == 922337203685477580L && d > 7L) {
      return Err(GitError::InvalidCommit("timestamp overflow"))
    }
    v = v * 10L + d
    i = i + 1
  }
  Ok(v)
}

///| Parse non-negative decimal Int from ASCII bytes `[start..end)` (no zero-padding).
fn parse_uint_ascii(b : Bytes, start : Int, end : Int) -> Result[Int, GitError] {
  if start >= end {
    return Err(GitError::InvalidHeader("empty integer"))
  }
  if end - start > 1 && b[start].to_int() == 48 {
    return Err(GitError::InvalidHeader("zero-padded integer"))
  }
  let mut v = 0
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return Err(GitError::InvalidHeader("non-digit in integer"))
    }
    let d = c - 48
    if v > 214748364 || (v == 214748364 && d > 7) {
      return Err(GitError::LimitExceeded("integer overflow"))
    }
    v = v * 10 + d
    i = i + 1
  }
  Ok(v)
}

///| Parse non-negative Git signature timestamp (no sign, no leading zeros, no Int64 overflow).
fn parse_timestamp_str(s : String) -> Result[Int64, GitError] {
  let n = s.length()
  if n == 0 {
    return Err(GitError::InvalidCommit("empty timestamp"))
  }
  if n > 1 && s.code_unit_at(0) == 48 {
    return Err(GitError::InvalidCommit("zero-padded timestamp"))
  }
  let mut v : Int64 = 0L
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return Err(GitError::InvalidCommit("invalid digit in timestamp"))
    }
    let d = (c - 48).to_int64()
    if v > 922337203685477580L || (v == 922337203685477580L && d > 7L) {
      return Err(GitError::InvalidCommit("timestamp overflow"))
    }
    v = v * 10L + d
    i = i + 1
  }
  Ok(v)
}
