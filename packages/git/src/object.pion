///| Git loose objects and structured object codecs (Blob, Tree, Commit, Tag).

///| Raw decoded Git object with verified OID.
pub struct RawObject {
  pub kind : ObjectKind
  pub payload : Bytes
  pub oid : Oid
}

///|
pub fn encode_loose_object(
  kind : ObjectKind,
  payload : Bytes,
