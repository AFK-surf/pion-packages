///| Git loose objects and structured object codecs (Blob, Tree, Commit, Tag).

///| Raw decoded Git object with verified OID.
pub struct RawObject {
  pub kind : ObjectKind
  pub payload : Bytes
  pub oid : Oid
}

///|
pub fn encode_loose_object(
  kind : ObjectKind,
  payload : Bytes,
) -> Result[(Oid, Bytes), GitError] {
  encode_loose_object_with_hash(kind, payload, HashKind::Sha1)
}

///|
pub fn encode_loose_object_with_hash(
  kind : ObjectKind,
  payload : Bytes,
  hash_kind : HashKind,
) -> Result[(Oid, Bytes), GitError] {
  let oid = hash_object_bytes(kind, payload, hash_kind)
  let hdr_str = kind.as_str() + " " + payload.length().to_string()
  let hdr_b = hdr_str.to_bytes()
  let bb = ByteBuf::new(hdr_b.length() + 1 + payload.length())
  bb.push_bytes(hdr_b)
  bb.push_byte(0)
  bb.push_bytes(payload)
  match flate::zlib_compress(bb.to_bytes(), 6) {
    Ok(comp) => Ok((oid, comp))
    Err(e) => Err(GitError::CompressError(e.to_string()))
  }
}

///|
pub fn decode_loose_object(
  compressed : Bytes,
  expected_oid : Option[Oid],
  limits : GitLimits,
) -> Result[RawObject, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let max_decompressed = limits.max_object_bytes + 64
  let raw = match flate::zlib_decompress_with_limit(compressed, max_decompressed) {
    Ok(b) => b
    Err(e) => return Err(GitError::DecompressError(e.to_string()))
  }
  let n = raw.length()
  let mut sp = -1
  let mut nul = -1
  let mut i = 0
  let header_cap = if n < 64 { n } else { 64 }
  while i < header_cap {
    let c = raw[i].to_int()
    if c == 32 && sp < 0 {
      sp = i
    } else if c == 0 {
      nul = i
      break
    }
    i = i + 1
  }
  if sp <= 0 || nul <= sp + 1 {
    return Err(GitError::InvalidHeader("malformed loose object header"))
  }
  let kind_str = raw.slice(0, sp).to_string()
  let kind = match ObjectKind::from_str(kind_str) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let declared_len = match parse_uint_ascii(raw, sp + 1, nul) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if declared_len > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("loose object exceeds max_object_bytes"))
  }
  let actual_len = n - (nul + 1)
  if declared_len != actual_len {
    return Err(
      GitError::InvalidObject(
        "loose object size mismatch: declared " +
        declared_len.to_string() +
        ", actual " +
        actual_len.to_string(),
      ),
    )
  }
  let payload = raw.slice(nul + 1, n)
  let hash_kind = match expected_oid {
    Some(o) => o.kind
    None => HashKind::Sha1
  }
  let actual_oid = hash_object_bytes(kind, payload, hash_kind)
  match expected_oid {
    Some(exp) =>
    if !actual_oid.equals(exp) {
      return Err(
        GitError::ChecksumMismatch(
          "expected oid " + exp.to_hex() + ", got " + actual_oid.to_hex(),
        ),
      )
    }
    None => ()
  }
  Ok(RawObject::{ kind: kind, payload: payload, oid: actual_oid })
}

// ============================================================================
// Blob
// ============================================================================

///| Git Blob object.
pub struct Blob {
  pub data : Bytes
}

///|
pub fn Blob::new(data : Bytes) -> Blob {
  Blob::{ data: data }
}

///|
pub fn Blob::encode(self : Blob) -> Bytes {
  self.data
}

///|
pub fn Blob::decode(payload : Bytes) -> Blob {
  Blob::{ data: payload }
}

///|
pub fn Blob::oid(self : Blob) -> Oid {
  hash_object_sha1(ObjectKind::Blob, self.data)
}

// ============================================================================
// Tree
// ============================================================================

///| Git tree entry file mode.
pub enum FileMode {
  Tree
  Blob
  BlobExecutable
  Link
  Commit
}

///|
pub fn FileMode::to_octal_str(self : FileMode) -> String {
  match self {
    FileMode::Tree => "40000"
    FileMode::Blob => "100644"
    FileMode::BlobExecutable => "100755"
    FileMode::Link => "120000"
    FileMode::Commit => "160000"
  }
}

///|
pub fn FileMode::to_u32(self : FileMode) -> UInt {
  match self {
    FileMode::Tree => 0x4000U
    FileMode::Blob => 0x81a4U
    FileMode::BlobExecutable => 0x81edU
    FileMode::Link => 0xa000U
    FileMode::Commit => 0xe000U
  }
}

///|
pub fn FileMode::from_octal_str(s : String) -> Result[FileMode, GitError] {
  if s == "40000" || s == "040000" {
    Ok(FileMode::Tree)
  } else if s == "100644" {
    Ok(FileMode::Blob)
  } else if s == "100755" {
    Ok(FileMode::BlobExecutable)
  } else if s == "120000" {
    Ok(FileMode::Link)
  } else if s == "160000" {
    Ok(FileMode::Commit)
  } else {
    Err(GitError::InvalidTree("unsupported file mode: " + s))
  }
}

///|
pub fn FileMode::equals(self : FileMode, other : FileMode) -> Bool {
  self.to_u32() == other.to_u32()
}

///| Single entry inside a Git Tree object.
pub struct TreeEntry {
  pub mode : FileMode
  pub name : String
  pub oid : Oid
}

///| Exact Git tree sorting comparator (directories compare as `name + "/"`).
pub fn tree_entry_compare(a : TreeEntry, b : TreeEntry) -> Int {
  let ab = a.name.to_bytes()
  let bb = b.name.to_bytes()
  let al = ab.length()
  let bl = bb.length()
  let a_is_dir = a.mode.equals(FileMode::Tree)
  let b_is_dir = b.mode.equals(FileMode::Tree)
  let a_eff = if a_is_dir { al + 1 } else { al }
  let b_eff = if b_is_dir { bl + 1 } else { bl }
  let min_len = if a_eff < b_eff { a_eff } else { b_eff }
  let mut i = 0
  while i < min_len {
    let ac = if i < al { ab[i].to_int() } else { 47 }
    let bc = if i < bl { bb[i].to_int() } else { 47 }
    if ac != bc {
      return if ac < bc { -1 } else { 1 }
    }
    i = i + 1
  }
  if a_eff < b_eff {
    -1
  } else if a_eff > b_eff {
    1
  } else {
    0
  }
}

///|
fn merge_sort_tree_entries(
  arr : Array[TreeEntry],
  tmp : Array[TreeEntry],
  lo : Int,
  hi : Int,
) -> Unit {
  if hi - lo <= 1 {
    return
  }
  let mid = lo + (hi - lo) / 2
  merge_sort_tree_entries(arr, tmp, lo, mid)
  merge_sort_tree_entries(arr, tmp, mid, hi)
  let mut i = lo
  let mut j = mid
  let mut k = lo
  while i < mid && j < hi {
    if tree_entry_compare(arr[i], arr[j]) <= 0 {
      tmp[k] = arr[i]
      i = i + 1
    } else {
      tmp[k] = arr[j]
      j = j + 1
    }
    k = k + 1
  }
  while i < mid {
    tmp[k] = arr[i]
    i = i + 1
    k = k + 1
  }
  while j < hi {
    tmp[k] = arr[j]
    j = j + 1
    k = k + 1
  }
  let mut m = lo
  while m < hi {
    arr[m] = tmp[m]
    m = m + 1
  }
}

///| Git Tree object.
pub struct Tree {
  pub entries : Array[TreeEntry]
}

///|
pub fn Tree::parse(
  payload : Bytes,
  hash_kind : HashKind,
  limits : GitLimits,
) -> Result[Tree, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  let oid_len = hash_kind.byte_len()
  let entries : Array[TreeEntry] = Array::new()
  let mut pos = 0
  while pos < n {
    if entries.length() >= limits.max_tree_entries {
      return Err(GitError::LimitExceeded("tree exceeds max_tree_entries"))
    }
    let mut sp = pos
    while sp < n && payload[sp].to_int() != 32 {
      sp = sp + 1
    }
    if sp == pos || sp >= n {
      return Err(GitError::InvalidTree("missing space after mode"))
    }
    let mode_str = payload.slice(pos, sp).to_string()
    let mode = match FileMode::from_octal_str(mode_str) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    let name_start = sp + 1
    let mut nul = name_start
    while nul < n && payload[nul].to_int() != 0 {
      nul = nul + 1
    }
    if nul >= n {
      return Err(GitError::InvalidTree("missing NUL after tree entry name"))
    }
    let name = payload.slice(name_start, nul).to_string()
    match validate_git_path_component(name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let oid_start = nul + 1
    if oid_start + oid_len > n {
      return Err(GitError::Truncated("truncated OID in tree entry"))
    }
    let oid = Oid::{
      kind: hash_kind,
      bytes: payload.slice(oid_start, oid_start + oid_len),
    }
    entries.push(TreeEntry::{ mode: mode, name: name, oid: oid })
    pos = oid_start + oid_len
  }
  Ok(Tree::{ entries: entries })
}

///|
pub fn Tree::encode(self : Tree) -> Result[Bytes, GitError] {
  let count = self.entries.length()
  let sorted : Array[TreeEntry] = Array::new()
  let tmp : Array[TreeEntry] = Array::new()
  let mut i = 0
  while i < count {
    let e = self.entries[i]
    match validate_git_path_component(e.name) {
      Ok(_) => ()
      Err(err) => return Err(err)
    }
    sorted.push(e)
    tmp.push(e)
    i = i + 1
  }
  if count > 1 {
    merge_sort_tree_entries(sorted, tmp, 0, count)
  }
  let bb = ByteBuf::new(count * 36)
  let mut j = 0
  while j < count {
    let e = sorted[j]
    if j > 0 && sorted[j - 1].name == e.name {
      return Err(GitError::InvalidTree("duplicate tree entry: " + e.name))
    }
    bb.push_str(e.mode.to_octal_str())
    bb.push_byte(32)
    bb.push_str(e.name)
    bb.push_byte(0)
    bb.push_bytes(e.oid.raw_bytes())
    j = j + 1
  }
  Ok(bb.to_bytes())
}

// ============================================================================
// Signature, Commit, Tag
// ============================================================================

///| Git author / committer / tagger signature.
pub val struct Signature {
  pub name : String
  pub email : String
  pub timestamp : Int64
  pub tz_offset_minutes : Int
  pub tz_raw : String
}

///|
fn parse_tz_offset(tz : String) -> Result[Int, GitError] {
  if tz.length() != 5 {
    return Err(GitError::InvalidCommit("invalid timezone: " + tz))
  }
  let sign_c = tz.code_unit_at(0)
  let sign = if sign_c == 43 {
    1
  } else if sign_c == 45 {
    -1
  } else {
    return Err(GitError::InvalidCommit("timezone missing sign: " + tz))
  }
  let d1 = tz.code_unit_at(1) - 48
  let d2 = tz.code_unit_at(2) - 48
  let d3 = tz.code_unit_at(3) - 48
  let d4 = tz.code_unit_at(4) - 48
  if d1 < 0 || d1 > 9 || d2 < 0 || d2 > 9 || d3 < 0 || d3 > 9 || d4 < 0 || d4 > 9 {
    return Err(GitError::InvalidCommit("non-digit in timezone: " + tz))
  }
  let hh = d1 * 10 + d2
  let mm = d3 * 10 + d4
  if mm >= 60 {
    return Err(GitError::InvalidCommit("timezone minutes >= 60: " + tz))
  }
  Ok(sign * (hh * 60 + mm))
}

///|
pub fn Signature::parse(s : String) -> Result[Signature, GitError] {
  let n = s.length()
  // Find last '>'
  let mut gt = n - 1
  while gt >= 0 && s.code_unit_at(gt) != 62 {
    gt = gt - 1
  }
  if gt < 0 {
    return Err(GitError::InvalidCommit("signature missing '>'"))
  }
  // Find matching '<' before gt
  let mut lt = gt - 1
  while lt >= 0 && s.code_unit_at(lt) != 60 {
    lt = lt - 1
  }
  if lt < 0 {
    return Err(GitError::InvalidCommit("signature missing '<'"))
  }
  let name = if lt > 0 && s.code_unit_at(lt - 1) == 32 {
    s.slice(0, lt - 1)
  } else {
    s.slice(0, lt)
  }
  let email = s.slice(lt + 1, gt)
  let rest_start = if gt + 1 < n && s.code_unit_at(gt + 1) == 32 {
    gt + 2
  } else {
    return Err(GitError::InvalidCommit("signature missing space after email"))
  }
  let mut sp = rest_start
  while sp < n && s.code_unit_at(sp) != 32 {
    sp = sp + 1
  }
  if sp <= rest_start || sp >= n {
    return Err(GitError::InvalidCommit("signature missing timestamp or timezone"))
  }
  let ts_str = s.slice(rest_start, sp)
  let ts = match parse_int64_str(ts_str) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let tz_raw = s.slice(sp + 1, n)
  let tz_min = match parse_tz_offset(tz_raw) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  Ok(
    Signature::{
      name: name,
      email: email,
      timestamp: ts,
      tz_offset_minutes: tz_min,
      tz_raw: tz_raw,
    },
  )
}

///|
pub fn Signature::format(self : Signature) -> String {
  self.name +
  " <" +
  self.email +
  "> " +
  self.timestamp.to_string() +
  " " +
  self.tz_raw
}

///| Extra commit header (including multiline `gpgsig` / `mergetag`).
pub val struct ExtraHeader {
  pub key : String
  pub value : String
}

///| Git Commit object.
pub struct Commit {
  pub tree : Oid
  pub parents : Array[Oid]
  pub author : Signature
  pub committer : Signature
  pub encoding : Option[String]
  pub extra_headers : Array[ExtraHeader]
  pub message : String
}

///|
pub fn Commit::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Commit, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  if n > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("commit exceeds max_object_bytes"))
  }
  let mut tree_opt : Option[Oid] = None
  let parents : Array[Oid] = Array::new()
  let mut author_opt : Option[Signature] = None
  let mut committer_opt : Option[Signature] = None
  let mut encoding : Option[String] = None
  let extra_headers : Array[ExtraHeader] = Array::new()
  let mut pos = 0
  let mut msg_start = n

  while pos < n {
    let mut nl = pos
    while nl < n && payload[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl == pos {
      // Blank line separates headers from message
      msg_start = if nl + 1 <= n { nl + 1 } else { n }
      break
    }
    let line = payload.slice(pos, nl).to_string()
    if line.length() > 0 && line.code_unit_at(0) == 32 {
      // Multiline header continuation (e.g. gpgsig, mergetag)
      if extra_headers.length() == 0 {
        return Err(GitError::InvalidCommit("orphan continuation line"))
      }
      let last_idx = extra_headers.length() - 1
      let prev = extra_headers[last_idx]
      extra_headers[last_idx] = ExtraHeader::{
        key: prev.key,
        value: prev.value + "\n" + line.slice(1, line.length()),
      }
    } else {
      let mut sp = 0
      let llen = line.length()
      while sp < llen && line.code_unit_at(sp) != 32 {
        sp = sp + 1
      }
      if sp == 0 || sp >= llen {
        return Err(GitError::InvalidCommit("malformed commit header line"))
      }
      let key = line.slice(0, sp)
      let val_str = line.slice(sp + 1, llen)
      if key == "tree" {
        match Oid::from_hex(val_str) {
          Ok(o) => tree_opt = Some(o)
          Err(e) => return Err(e)
        }
      } else if key == "parent" {
        match Oid::from_hex(val_str) {
          Ok(o) => parents.push(o)
          Err(e) => return Err(e)
        }
      } else if key == "author" {
        match Signature::parse(val_str) {
          Ok(sig) => author_opt = Some(sig)
          Err(e) => return Err(e)
        }
      } else if key == "committer" {
        match Signature::parse(val_str) {
          Ok(sig) => committer_opt = Some(sig)
          Err(e) => return Err(e)
        }
      } else if key == "encoding" {
        encoding = Some(val_str)
      } else {
        extra_headers.push(ExtraHeader::{ key: key, value: val_str })
      }
    }
    pos = if nl < n { nl + 1 } else { n }
  }

  let tree = match tree_opt {
    Some(t) => t
    None => return Err(GitError::InvalidCommit("missing tree header"))
  }
  let author = match author_opt {
    Some(a) => a
    None => return Err(GitError::InvalidCommit("missing author header"))
  }
  let committer = match committer_opt {
    Some(c) => c
    None => return Err(GitError::InvalidCommit("missing committer header"))
  }
  let message = payload.slice(msg_start, n).to_string()
  Ok(
    Commit::{
      tree: tree,
      parents: parents,
      author: author,
      committer: committer,
      encoding: encoding,
      extra_headers: extra_headers,
      message: message,
    },
  )
}

///|
fn write_extra_header(sb : StringBuilder, h : ExtraHeader) -> Unit {
  sb.write_string(h.key)
  sb.write_string(" ")
  let v = h.value
  let n = v.length()
  let mut i = 0
  let mut seg_start = 0
  while i < n {
    if v.code_unit_at(i) == 10 {
      sb.write_string(v.slice(seg_start, i))
      sb.write_string("\n ")
      seg_start = i + 1
    }
    i = i + 1
  }
  sb.write_string(v.slice(seg_start, n))
  sb.write_string("\n")
}

///|
pub fn Commit::encode(self : Commit) -> Bytes {
  let sb = StringBuilder::new()
  sb.write_string("tree ")
  sb.write_string(self.tree.to_hex())
  sb.write_string("\n")
  let mut i = 0
  while i < self.parents.length() {
    sb.write_string("parent ")
    sb.write_string(self.parents[i].to_hex())
    sb.write_string("\n")
    i = i + 1
  }
  sb.write_string("author ")
  sb.write_string(self.author.format())
  sb.write_string("\n")
  sb.write_string("committer ")
  sb.write_string(self.committer.format())
  sb.write_string("\n")
  match self.encoding {
    Some(enc) => {
      sb.write_string("encoding ")
      sb.write_string(enc)
      sb.write_string("\n")
    }
    None => ()
  }
  let mut j = 0
  while j < self.extra_headers.length() {
    write_extra_header(sb, self.extra_headers[j])
    j = j + 1
  }
  sb.write_string("\n")
  sb.write_string(self.message)
  sb.to_string().to_bytes()
}

///|
pub fn Commit::gpgsig(self : Commit) -> Option[String] {
  let mut i = 0
  while i < self.extra_headers.length() {
    if self.extra_headers[i].key == "gpgsig" {
      return Some(self.extra_headers[i].value)
    }
    i = i + 1
  }
  None
}

///| Git annotated Tag object.
pub struct Tag {
  pub target : Oid
  pub target_kind : ObjectKind
  pub name : String
  pub tagger : Option[Signature]
  pub message : String
}

///|
pub fn Tag::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Tag, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  if n > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("tag exceeds max_object_bytes"))
  }
  let mut target_opt : Option[Oid] = None
  let mut kind_opt : Option[ObjectKind] = None
  let mut name_opt : Option[String] = None
  let mut tagger : Option[Signature] = None
  let mut pos = 0
  let mut msg_start = n

  while pos < n {
    let mut nl = pos
    while nl < n && payload[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl == pos {
      msg_start = if nl + 1 <= n { nl + 1 } else { n }
      break
    }
    let line = payload.slice(pos, nl).to_string()
    let mut sp = 0
    let llen = line.length()
    while sp < llen && line.code_unit_at(sp) != 32 {
      sp = sp + 1
    }
    if sp == 0 || sp >= llen {
      return Err(GitError::InvalidTag("malformed tag header"))
    }
    let key = line.slice(0, sp)
    let val_str = line.slice(sp + 1, llen)
    if key == "object" {
      match Oid::from_hex(val_str) {
        Ok(o) => target_opt = Some(o)
        Err(e) => return Err(e)
      }
    } else if key == "type" {
      match ObjectKind::from_str(val_str) {
        Ok(k) => kind_opt = Some(k)
        Err(e) => return Err(e)
      }
    } else if key == "tag" {
      name_opt = Some(val_str)
    } else if key == "tagger" {
      match Signature::parse(val_str) {
        Ok(s) => tagger = Some(s)
        Err(e) => return Err(e)
      }
    }
    pos = if nl < n { nl + 1 } else { n }
  }

  let target = match target_opt {
    Some(t) => t
    None => return Err(GitError::InvalidTag("missing object header"))
  }
  let target_kind = match kind_opt {
    Some(k) => k
    None => return Err(GitError::InvalidTag("missing type header"))
  }
  let name = match name_opt {
    Some(nm) => nm
    None => return Err(GitError::InvalidTag("missing tag name header"))
  }
  let message = payload.slice(msg_start, n).to_string()
  Ok(
    Tag::{
      target: target,
      target_kind: target_kind,
      name: name,
      tagger: tagger,
      message: message,
    },
  )
}

///|
pub fn Tag::encode(self : Tag) -> Bytes {
  let sb = StringBuilder::new()
  sb.write_string("object ")
  sb.write_string(self.target.to_hex())
  sb.write_string("\n")
  sb.write_string("type ")
  sb.write_string(self.target_kind.as_str())
  sb.write_string("\n")
  sb.write_string("tag ")
  sb.write_string(self.name)
  sb.write_string("\n")
  match self.tagger {
    Some(tg) => {
      sb.write_string("tagger ")
      sb.write_string(tg.format())
      sb.write_string("\n")
    }
    None => ()
  }
  sb.write_string("\n")
  sb.write_string(self.message)
  sb.to_string().to_bytes()
}
