///| Git loose objects and structured object codecs (Blob, Tree, Commit, Tag).

///| Raw decoded Git object with verified OID.
pub struct RawObject {
  pub kind : ObjectKind
  pub payload : Bytes
  pub oid : Oid
}

///|
pub fn encode_loose_object(
  kind : ObjectKind,
  payload : Bytes,
) -> Result[(Oid, Bytes), GitError] {
  encode_loose_object_with_hash(kind, payload, HashKind::Sha1)
}

///|
pub fn encode_loose_object_with_hash(
  kind : ObjectKind,
  payload : Bytes,
  hash_kind : HashKind,
) -> Result[(Oid, Bytes), GitError] {
  let oid = hash_object_bytes(kind, payload, hash_kind)
  let hdr_str = kind.as_str() + " " + payload.length().to_string()
  let hdr_b = hdr_str.to_bytes()
  let bb = ByteBuf::new(hdr_b.length() + 1 + payload.length())
  bb.push_bytes(hdr_b)
  bb.push_byte(0)
  bb.push_bytes(payload)
  match flate::zlib_compress(bb.to_bytes(), 6) {
    Ok(comp) => Ok((oid, comp))
    Err(e) => Err(GitError::CompressError(e.to_string()))
  }
}

///|
pub fn decode_loose_object(
  compressed : Bytes,
  expected_oid : Option[Oid],
  limits : GitLimits,
) -> Result[RawObject, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let max_decompressed = limits.max_object_bytes + 64
  let scratch = PackInflateScratch::new()
  let (raw, end_pos) = match zlib_inflate_at(compressed, 0, 256, max_decompressed, scratch) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  if end_pos != compressed.length() {
    return Err(GitError::InvalidObject("trailing garbage after loose object zlib stream"))
  }
  let n = raw.length()
  let mut sp = -1
  let mut nul = -1
  let mut i = 0
  let header_cap = if n < 64 { n } else { 64 }
  while i < header_cap {
    let c = raw[i].to_int()
    if c == 32 && sp < 0 {
      sp = i
    } else if c == 0 {
      nul = i
      break
    }
    i = i + 1
  }
  if sp <= 0 || nul <= sp + 1 {
    return Err(GitError::InvalidHeader("malformed loose object header"))
  }
  let kind_str = raw.slice(0, sp).to_string()
  let kind = match ObjectKind::from_str(kind_str) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let declared_len = match parse_uint_ascii(raw, sp + 1, nul) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if declared_len > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("loose object exceeds max_object_bytes"))
  }
  let actual_len = n - (nul + 1)
  if declared_len != actual_len {
    return Err(
      GitError::InvalidObject(
        "loose object size mismatch: declared " +
        declared_len.to_string() +
        ", actual " +
        actual_len.to_string(),
      ),
    )
  }
  let payload = raw.slice(nul + 1, n)
  let hash_kind = match expected_oid {
    Some(o) => o.kind
    None => HashKind::Sha1
  }
  let actual_oid = hash_object_bytes(kind, payload, hash_kind)
  match expected_oid {
    Some(exp) =>
    if !actual_oid.equals(exp) {
      return Err(
        GitError::ChecksumMismatch(
          "expected oid " + exp.to_hex() + ", got " + actual_oid.to_hex(),
        ),
      )
    }
    None => ()
  }
  Ok(RawObject::{ kind: kind, payload: payload, oid: actual_oid })
}

// ============================================================================
// Blob
// ============================================================================

///| Git Blob object.
pub struct Blob {
  pub data : Bytes
}

///|
pub fn Blob::new(data : Bytes) -> Blob {
  Blob::{ data: data }
}

///|
pub fn Blob::encode(self : Blob) -> Bytes {
  self.data
}

///|
pub fn Blob::decode(payload : Bytes) -> Blob {
  Blob::{ data: payload }
}

///|
pub fn Blob::oid(self : Blob) -> Oid {
  hash_object_sha1(ObjectKind::Blob, self.data)
}

// ============================================================================
// Tree
// ============================================================================

///| Git tree entry file mode.
pub enum FileMode {
  Tree
  Blob
  BlobExecutable
  Link
  Commit
}

///|
pub fn FileMode::to_octal_str(self : FileMode) -> String {
  match self {
    FileMode::Tree => "40000"
    FileMode::Blob => "100644"
    FileMode::BlobExecutable => "100755"
    FileMode::Link => "120000"
    FileMode::Commit => "160000"
  }
}

///|
pub fn FileMode::to_u32(self : FileMode) -> UInt {
  match self {
    FileMode::Tree => 0x4000U
    FileMode::Blob => 0x81a4U
    FileMode::BlobExecutable => 0x81edU
    FileMode::Link => 0xa000U
    FileMode::Commit => 0xe000U
  }
}

///|
pub fn FileMode::from_octal_str(s : String) -> Result[FileMode, GitError] {
  if s == "40000" || s == "040000" {
    Ok(FileMode::Tree)
  } else if s == "100644" {
    Ok(FileMode::Blob)
  } else if s == "100755" {
    Ok(FileMode::BlobExecutable)
  } else if s == "120000" {
    Ok(FileMode::Link)
  } else if s == "160000" {
    Ok(FileMode::Commit)
  } else {
    Err(GitError::InvalidTree("unsupported file mode: " + s))
  }
}

///|
pub fn FileMode::equals(self : FileMode, other : FileMode) -> Bool {
  self.to_u32() == other.to_u32()
}

///| Single entry inside a Git Tree object.
pub struct TreeEntry {
  pub mode : FileMode
  pub name : String
  pub oid : Oid
}

///| Zero-allocation Git tree name comparator (directories compare as `name + "/"`).
fn tree_name_compare(an : String, a_is_dir : Bool, bn : String, b_is_dir : Bool) -> Int {
  let al = an.length()
  let bl = bn.length()
  let a_eff = if a_is_dir { al + 1 } else { al }
  let b_eff = if b_is_dir { bl + 1 } else { bl }
  let min_len = if a_eff < b_eff { a_eff } else { b_eff }
  let mut i = 0
  while i < min_len {
    let ac = if i < al { an.code_unit_at(i) } else { 47 }
    let bc = if i < bl { bn.code_unit_at(i) } else { 47 }
    if ac != bc {
      return if ac < bc { -1 } else { 1 }
    }
    i = i + 1
  }
  if a_eff < b_eff {
    -1
  } else if a_eff > b_eff {
    1
  } else {
    0
  }
}

///| Exact Git tree sorting comparator (directories compare as `name + "/"`), zero allocations.
pub fn tree_entry_compare(a : TreeEntry, b : TreeEntry) -> Int {
  tree_name_compare(a.name, a.mode.equals(FileMode::Tree), b.name, b.mode.equals(FileMode::Tree))
}

///| Binary search sorted `entries[0..hi)` for a non-directory entry with `name`.
fn tree_has_nondir_name(entries : Array[TreeEntry], hi : Int, name : String) -> Bool {
  let mut lo = 0
  let mut r = hi
  while lo < r {
    let mid = lo + ((r - lo) >> 1)
    let em = entries[mid]
    let cmp = tree_name_compare(name, false, em.name, em.mode.equals(FileMode::Tree))
    if cmp == 0 {
      return true
    } else if cmp < 0 {
      r = mid
    } else {
      lo = mid + 1
    }
  }
  false
}

///|
fn merge_sort_tree_entries(
  arr : Array[TreeEntry],
  tmp : Array[TreeEntry],
  lo : Int,
  hi : Int,
) -> Unit {
  if hi - lo <= 1 {
    return
  }
  let mid = lo + (hi - lo) / 2
  merge_sort_tree_entries(arr, tmp, lo, mid)
  merge_sort_tree_entries(arr, tmp, mid, hi)
  let mut i = lo
  let mut j = mid
  let mut k = lo
  while i < mid && j < hi {
    if tree_entry_compare(arr[i], arr[j]) <= 0 {
      tmp[k] = arr[i]
      i = i + 1
    } else {
      tmp[k] = arr[j]
      j = j + 1
    }
    k = k + 1
  }
  while i < mid {
    tmp[k] = arr[i]
    i = i + 1
    k = k + 1
  }
  while j < hi {
    tmp[k] = arr[j]
    j = j + 1
    k = k + 1
  }
  let mut m = lo
  while m < hi {
    arr[m] = tmp[m]
    m = m + 1
  }
}

///| Git Tree object.
pub struct Tree {
  pub entries : Array[TreeEntry]
}

///| Zero-allocation FileMode parser directly from `payload[start..end)`.
fn parse_file_mode_bytes(payload : Bytes, start : Int, end : Int) -> Result[FileMode, GitError] {
  let len = end - start
  if len == 6 {
    let b0 = payload[start].to_int()
    let b1 = payload[start + 1].to_int()
    let b2 = payload[start + 2].to_int()
    let b3 = payload[start + 3].to_int()
    let b4 = payload[start + 4].to_int()
    let b5 = payload[start + 5].to_int()
    if b0 == 49 && b1 == 48 && b2 == 48 {
      if b3 == 54 && b4 == 52 && b5 == 52 {
        return Ok(FileMode::Blob)
      }
      if b3 == 55 && b4 == 53 && b5 == 53 {
        return Ok(FileMode::BlobExecutable)
      }
    } else if b0 == 48 && b1 == 52 && b2 == 48 && b3 == 48 && b4 == 48 && b5 == 48 {
      return Ok(FileMode::Tree)
    } else if b0 == 49 && b1 == 50 && b2 == 48 && b3 == 48 && b4 == 48 && b5 == 48 {
      return Ok(FileMode::Link)
    } else if b0 == 49 && b1 == 54 && b2 == 48 && b3 == 48 && b4 == 48 && b5 == 48 {
      return Ok(FileMode::Commit)
    }
  } else if len == 5 {
    if payload[start].to_int() == 52 &&
    payload[start + 1].to_int() == 48 &&
    payload[start + 2].to_int() == 48 &&
    payload[start + 3].to_int() == 48 &&
    payload[start + 4].to_int() == 48 {
      return Ok(FileMode::Tree)
    }
  }
  Err(GitError::InvalidTree("unsupported file mode: " + payload.slice(start, end).to_string()))
}

///|
fn file_mode_is_tree(m : FileMode) -> Bool {
  match m {
    FileMode::Tree => true
    _ => false
  }
}

///|
fn file_mode_is_link(m : FileMode) -> Bool {
  match m {
    FileMode::Link => true
    _ => false
  }
}

///| Combined duplicate + Git tree order comparator:
///| returns `0` if `an == bn` (duplicate), `-1` if `a < b`, `1` if `a > b`.
fn tree_name_cmp_strict(an : String, a_is_dir : Bool, bn : String, b_is_dir : Bool) -> Int {
  let al = an.length()
  let bl = bn.length()
  let min_raw = if al < bl { al } else { bl }
  let mut i = 0
  while i < min_raw {
    let ac = an.code_unit_at(i)
    let bc = bn.code_unit_at(i)
    if ac != bc {
      return if ac < bc { -1 } else { 1 }
    }
    i = i + 1
  }
  if al == bl {
    return 0
  }
  if al < bl {
    if a_is_dir {
      let bc = bn.code_unit_at(al)
      if 47 < bc { -1 } else if 47 > bc { 1 } else { -1 }
    } else {
      -1
    }
  } else {
    if b_is_dir {
      let ac = an.code_unit_at(bl)
      if ac < 47 { -1 } else if ac > 47 { 1 } else { 1 }
    } else {
      1
    }
  }
}

///|
pub fn Tree::parse(
  payload : Bytes,
  hash_kind : HashKind,
  limits : GitLimits,
) -> Result[Tree, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  let oid_len = hash_kind.byte_len()
  let entries : Array[TreeEntry] = Array::new()
  let max_entries = limits.max_tree_entries
  let mut pos = 0
  let mut has_prev = false
  let mut prev_name = ""
  let mut prev_is_dir = false
  while pos < n {
    let cur_len = entries.length()
    if cur_len >= max_entries {
      return Err(GitError::LimitExceeded("tree exceeds max_tree_entries"))
    }
    let mut sp = pos
    while sp < n && payload[sp].to_int() != 32 {
      sp = sp + 1
    }
    if sp == pos || sp >= n {
      return Err(GitError::InvalidTree("missing space after mode"))
    }
    let mode = match parse_file_mode_bytes(payload, pos, sp) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    let name_start = sp + 1
    let mut nul = name_start
    let mut has_slash = false
    while nul < n {
      let c = payload[nul].to_int()
      if c == 0 {
        break
      }
      if c == 47 {
        has_slash = true
      }
      nul = nul + 1
    }
    if nul >= n {
      return Err(GitError::InvalidTree("missing NUL after tree entry name"))
    }
    let name_len = nul - name_start
    if name_len == 0 {
      return Err(GitError::InsecurePath("empty path component"))
    }
    let name = payload.slice(name_start, nul).to_string()
    if has_slash {
      return Err(GitError::InsecurePath("illegal character in component: " + name))
    }
    let c0 = payload[name_start].to_int()
    if c0 == 46 {
      if name_len == 1 ||
      (name_len == 2 && payload[name_start + 1].to_int() == 46) ||
      (name_len >= 4 && is_dotgit_component(name)) {
        return Err(GitError::InsecurePath("disallowed path component: " + name))
      }
    } else if (c0 == 103 || c0 == 71 || c0 >= 128) && name_len >= 4 && is_dotgit_component(name) {
      return Err(GitError::InsecurePath("disallowed path component: " + name))
    }
    if file_mode_is_link(mode) && is_dotgit_special_file(name) {
      return Err(GitError::InsecurePath("symlinked git config file: " + name))
    }
    let oid_start = nul + 1
    if oid_start + oid_len > n {
      return Err(GitError::Truncated("truncated OID in tree entry"))
    }
    let oid = Oid::{
      kind: hash_kind,
      bytes: payload.slice(oid_start, oid_start + oid_len),
    }
    let cur_is_dir = file_mode_is_tree(mode)
    if has_prev {
      let cmp = tree_name_cmp_strict(prev_name, prev_is_dir, name, cur_is_dir)
      if cmp == 0 {
        return Err(GitError::InvalidTree("duplicate tree entry: " + name))
      }
      if cmp > 0 {
        return Err(GitError::InvalidTree("unsorted tree entries"))
      }
      if cur_is_dir && tree_has_nondir_name(entries, cur_len, name) {
        return Err(GitError::InvalidTree("duplicate tree entry: " + name))
      }
    }
    entries.push(TreeEntry::{ mode: mode, name: name, oid: oid })
    has_prev = true
    prev_name = name
    prev_is_dir = cur_is_dir
    pos = oid_start + oid_len
  }
  Ok(Tree::{ entries: entries })
}

///|
pub fn Tree::encode(self : Tree) -> Result[Bytes, GitError] {
  let count = self.entries.length()
  let mut is_sorted = true
  let mut total_bytes = 0
  let mut i = 0
  let mut prev_name = ""
  let mut prev_is_dir = false
  while i < count {
    let e = self.entries[i]
    let nm = e.name
    match validate_git_path_component(nm) {
      Ok(_) => ()
      Err(err) => return Err(err)
    }
    let cur_is_dir = file_mode_is_tree(e.mode)
    if file_mode_is_link(e.mode) && is_dotgit_special_file(nm) {
      return Err(GitError::InsecurePath("symlinked git config file: " + nm))
    }
    if i > 0 && is_sorted {
      let cmp = tree_name_cmp_strict(prev_name, prev_is_dir, nm, cur_is_dir)
      if cmp == 0 {
        return Err(GitError::InvalidTree("duplicate tree entry: " + nm))
      }
      if cmp > 0 {
        is_sorted = false
      }
    }
    prev_name = nm
    prev_is_dir = cur_is_dir
    let mode_len = if cur_is_dir { 5 } else { 6 }
    total_bytes = total_bytes + mode_len + 1 + nm.length() + 1 + e.oid.byte_len()
    i = i + 1
  }

  let ordered = if is_sorted || count <= 1 {
    self.entries
  } else {
    let sorted : Array[TreeEntry] = Array::new()
    let tmp : Array[TreeEntry] = Array::new()
    let mut s = 0
    while s < count {
      let e = self.entries[s]
      sorted.push(e)
      tmp.push(e)
      s = s + 1
    }
    merge_sort_tree_entries(sorted, tmp, 0, count)
    sorted
  }

  let out = Bytes::new(total_bytes)
  let mut p = 0
  let mut j = 0
  while j < count {
    let e = ordered[j]
    let nm = e.name
    let cur_is_dir = file_mode_is_tree(e.mode)
    if j > 0 {
      if !is_sorted && ordered[j - 1].name == nm {
        return Err(GitError::InvalidTree("duplicate tree entry: " + nm))
      }
      if cur_is_dir && tree_has_nondir_name(ordered, j, nm) {
        return Err(GitError::InvalidTree("duplicate tree entry: " + nm))
      }
    }
    match e.mode {
      FileMode::Tree => {
        out[p] = 52.to_byte()
        out[p + 1] = 48.to_byte()
        out[p + 2] = 48.to_byte()
        out[p + 3] = 48.to_byte()
        out[p + 4] = 48.to_byte()
        out[p + 5] = 32.to_byte()
        p = p + 6
      }
      FileMode::Blob => {
        out[p] = 49.to_byte()
        out[p + 1] = 48.to_byte()
        out[p + 2] = 48.to_byte()
        out[p + 3] = 54.to_byte()
        out[p + 4] = 52.to_byte()
        out[p + 5] = 52.to_byte()
        out[p + 6] = 32.to_byte()
        p = p + 7
      }
      FileMode::BlobExecutable => {
        out[p] = 49.to_byte()
        out[p + 1] = 48.to_byte()
        out[p + 2] = 48.to_byte()
        out[p + 3] = 55.to_byte()
        out[p + 4] = 53.to_byte()
        out[p + 5] = 53.to_byte()
        out[p + 6] = 32.to_byte()
        p = p + 7
      }
      FileMode::Link => {
        out[p] = 49.to_byte()
        out[p + 1] = 50.to_byte()
        out[p + 2] = 48.to_byte()
        out[p + 3] = 48.to_byte()
        out[p + 4] = 48.to_byte()
        out[p + 5] = 48.to_byte()
        out[p + 6] = 32.to_byte()
        p = p + 7
      }
      FileMode::Commit => {
        out[p] = 49.to_byte()
        out[p + 1] = 54.to_byte()
        out[p + 2] = 48.to_byte()
        out[p + 3] = 48.to_byte()
        out[p + 4] = 48.to_byte()
        out[p + 5] = 48.to_byte()
        out[p + 6] = 32.to_byte()
        p = p + 7
      }
    }
    let nlen = nm.length()
    let mut k = 0
    let nlim4 = nlen - 4
    while k <= nlim4 {
      out[p] = nm.code_unit_at(k).to_byte()
      out[p + 1] = nm.code_unit_at(k + 1).to_byte()
      out[p + 2] = nm.code_unit_at(k + 2).to_byte()
      out[p + 3] = nm.code_unit_at(k + 3).to_byte()
      p = p + 4
      k = k + 4
    }
    while k < nlen {
      out[p] = nm.code_unit_at(k).to_byte()
      p = p + 1
      k = k + 1
    }
    out[p] = 0.to_byte()
    p = p + 1
    let ob = e.oid.bytes
    let olen = ob.length()
    if olen == 20 {
      out[p] = ob[0]
      out[p + 1] = ob[1]
      out[p + 2] = ob[2]
      out[p + 3] = ob[3]
      out[p + 4] = ob[4]
      out[p + 5] = ob[5]
      out[p + 6] = ob[6]
      out[p + 7] = ob[7]
      out[p + 8] = ob[8]
      out[p + 9] = ob[9]
      out[p + 10] = ob[10]
      out[p + 11] = ob[11]
      out[p + 12] = ob[12]
      out[p + 13] = ob[13]
      out[p + 14] = ob[14]
      out[p + 15] = ob[15]
      out[p + 16] = ob[16]
      out[p + 17] = ob[17]
      out[p + 18] = ob[18]
      out[p + 19] = ob[19]
      p = p + 20
    } else {
      k = 0
      while k < olen {
        out[p] = ob[k]
        p = p + 1
        k = k + 1
      }
    }
    j = j + 1
  }
  Ok(out)
}

// ============================================================================
// Signature, Commit, Tag
// ============================================================================

///| Git author / committer / tagger signature.
pub val struct Signature {
  pub name : String
  pub email : String
  pub timestamp : Int64
  pub tz_offset_minutes : Int
  pub tz_raw : String
}

///|
fn parse_tz_offset(tz : String) -> Result[Int, GitError] {
  if tz.length() != 5 {
    return Err(GitError::InvalidCommit("invalid timezone: " + tz))
  }
  let sign_c = tz.code_unit_at(0)
  let sign = if sign_c == 43 {
    1
  } else if sign_c == 45 {
    -1
  } else {
    return Err(GitError::InvalidCommit("timezone missing sign: " + tz))
  }
  let d1 = tz.code_unit_at(1) - 48
  let d2 = tz.code_unit_at(2) - 48
  let d3 = tz.code_unit_at(3) - 48
  let d4 = tz.code_unit_at(4) - 48
  if d1 < 0 || d1 > 9 || d2 < 0 || d2 > 9 || d3 < 0 || d3 > 9 || d4 < 0 || d4 > 9 {
    return Err(GitError::InvalidCommit("non-digit in timezone: " + tz))
  }
  let hh = d1 * 10 + d2
  let mm = d3 * 10 + d4
  Ok(sign * (hh * 60 + mm))
}

///|
pub fn Signature::parse(s : String) -> Result[Signature, GitError] {
  let n = s.length()
  // Find last '>'
  let mut gt = n - 1
  while gt >= 0 && s.code_unit_at(gt) != 62 {
    gt = gt - 1
  }
  if gt < 0 {
    return Err(GitError::InvalidCommit("signature missing '>'"))
  }
  // Find matching '<' before gt
  let mut lt = gt - 1
  while lt >= 0 && s.code_unit_at(lt) != 60 {
    lt = lt - 1
  }
  if lt < 0 {
    return Err(GitError::InvalidCommit("signature missing '<'"))
  }
  let name = if lt > 0 && s.code_unit_at(lt - 1) == 32 {
    s.slice(0, lt - 1)
  } else {
    s.slice(0, lt)
  }
  let email = s.slice(lt + 1, gt)
  let mut rest_start = if gt + 1 < n && s.code_unit_at(gt + 1) == 32 {
    gt + 2
  } else {
    return Err(GitError::InvalidCommit("signature missing space after email"))
  }
  while rest_start < n && s.code_unit_at(rest_start) == 32 {
    rest_start = rest_start + 1
  }
  let mut sp = rest_start
  while sp < n && s.code_unit_at(sp) != 32 {
    sp = sp + 1
  }
  if sp <= rest_start || sp >= n {
    return Err(GitError::InvalidCommit("signature missing timestamp or timezone"))
  }
  let ts_str = s.slice(rest_start, sp)
  let ts = match parse_timestamp_str(ts_str) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let tz_raw = s.slice(sp + 1, n)
  let tz_min = match parse_tz_offset(tz_raw) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  Ok(
    Signature::{
      name: name,
      email: email,
      timestamp: ts,
      tz_offset_minutes: tz_min,
      tz_raw: tz_raw,
    },
  )
}

///|
pub fn Signature::format(self : Signature) -> String {
  self.name +
  " <" +
  self.email +
  "> " +
  self.timestamp.to_string() +
  " " +
  self.tz_raw
}

///| Extra commit header (including multiline `gpgsig` / `mergetag`).
pub val struct ExtraHeader {
  pub key : String
  pub value : String
}

///| Git Commit object.
pub struct Commit {
  pub tree : Oid
  pub parents : Array[Oid]
  pub author : Signature
  pub committer : Signature
  pub encoding : Option[String]
  pub extra_headers : Array[ExtraHeader]
  pub message : String
}

///| Parse a Git signature directly from raw bytes `data[start..end)`.
fn parse_signature_bytes(data : Bytes, start : Int, end : Int) -> Result[Signature, GitError] {
  let mut gt = end - 1
  while gt >= start && data[gt].to_int() != 62 {
    gt = gt - 1
  }
  if gt < start {
    return Err(GitError::InvalidCommit("signature missing '>'"))
  }
  let mut lt = gt - 1
  while lt >= start && data[lt].to_int() != 60 {
    lt = lt - 1
  }
  if lt < start {
    return Err(GitError::InvalidCommit("signature missing '<'"))
  }
  let name_end = if lt > start && data[lt - 1].to_int() == 32 { lt - 1 } else { lt }
  let mut rest_start = if gt + 1 < end && data[gt + 1].to_int() == 32 {
    gt + 2
  } else {
    return Err(GitError::InvalidCommit("signature missing space after email"))
  }
  while rest_start < end && data[rest_start].to_int() == 32 {
    rest_start = rest_start + 1
  }
  let mut sp = rest_start
  while sp < end && data[sp].to_int() != 32 {
    sp = sp + 1
  }
  if sp <= rest_start || sp >= end {
    return Err(GitError::InvalidCommit("signature missing timestamp or timezone"))
  }
  let ts = match parse_timestamp_bytes(data, rest_start, sp) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let tz_start = sp + 1
  let tz_len = end - tz_start
  if tz_len != 5 {
    return Err(GitError::InvalidCommit("invalid timezone: " + data.slice(tz_start, end).to_string()))
  }
  let sign_c = data[tz_start].to_int()
  let sign = if sign_c == 43 {
    1
  } else if sign_c == 45 {
    -1
  } else {
    return Err(
      GitError::InvalidCommit("timezone missing sign: " + data.slice(tz_start, end).to_string()),
    )
  }
  let d1 = data[tz_start + 1].to_int() - 48
  let d2 = data[tz_start + 2].to_int() - 48
  let d3 = data[tz_start + 3].to_int() - 48
  let d4 = data[tz_start + 4].to_int() - 48
  if d1 < 0 || d1 > 9 || d2 < 0 || d2 > 9 || d3 < 0 || d3 > 9 || d4 < 0 || d4 > 9 {
    return Err(
      GitError::InvalidCommit("non-digit in timezone: " + data.slice(tz_start, end).to_string()),
    )
  }
  let tz_min = sign * ((d1 * 10 + d2) * 60 + (d3 * 10 + d4))
  let tz_raw = if sign_c == 43 && d1 == 0 && d2 == 0 && d3 == 0 && d4 == 0 {
    "+0000"
  } else {
    data.slice(tz_start, end).to_string()
  }
  let name = data.slice(start, name_end).to_string()
  let email = data.slice(lt + 1, gt).to_string()
  Ok(
    Signature::{
      name: name,
      email: email,
      timestamp: ts,
      tz_offset_minutes: tz_min,
      tz_raw: tz_raw,
    },
  )
}

///|
fn bytes_match_str(data : Bytes, start : Int, end : Int, s : String) -> Bool {
  let n = s.length()
  if end - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if data[start + i].to_int() != s.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn int64_decimal_len(v : Int64) -> Int {
  if v == 0L {
    return 1
  }
  let mut x = v
  let mut n = 0
  if x < 0L {
    n = 1
    // Handle min Int64 safely
    if x == -9223372036854775807L - 1L {
      return 20
    }
    x = -x
  }
  while x > 0L {
    n = n + 1
    x = x / 10L
  }
  n
}

///|
fn write_str_into(out : Bytes, off : Int, s : String) -> Int {
  let n = s.length()
  let mut p = off
  let mut i = 0
  while i < n {
    out[p] = s.code_unit_at(i).to_byte()
    p = p + 1
    i = i + 1
  }
  p
}

///|
fn write_int64_into(out : Bytes, off : Int, v : Int64) -> Int {
  if v == 0L {
    out[off] = 48.to_byte()
    return off + 1
  }
  if v < 0L {
    return write_str_into(out, off, v.to_string())
  }
  let mut p = off
  let mut x = v
  while x > 0L {
    out[p] = (48 + (x % 10L).to_int()).to_byte()
    x = x / 10L
    p = p + 1
  }
  let mut lo = off
  let mut hi = p - 1
  while lo < hi {
    let tmp = out[lo]
    out[lo] = out[hi]
    out[hi] = tmp
    lo = lo + 1
    hi = hi - 1
  }
  p
}

///|
pub fn Commit::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Commit, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  if n > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("commit exceeds max_object_bytes"))
  }
  let mut tree_opt : Option[Oid] = None
  let parents : Array[Oid] = Array::new()
  let mut author_opt : Option[Signature] = None
  let mut committer_opt : Option[Signature] = None
  let mut encoding : Option[String] = None
  let extra_headers : Array[ExtraHeader] = Array::new()
  let mut pos = 0
  let mut msg_start = n
  // Strict Git commit header phase: 0=tree, 1=parent*/author, 2=committer, 3=extra
  let mut phase = 0

  while pos < n {
    let mut nl = pos
    while nl < n && payload[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl == pos {
      // Blank line separates headers from message
      msg_start = if nl + 1 <= n { nl + 1 } else { n }
      break
    }
    if payload[pos].to_int() == 32 {
      // Multiline header continuation (e.g. gpgsig, mergetag)
      if phase < 3 || extra_headers.length() == 0 {
        return Err(GitError::InvalidCommit("orphan continuation line"))
      }
      let last_idx = extra_headers.length() - 1
      let prev = extra_headers[last_idx]
      extra_headers[last_idx] = ExtraHeader::{
        key: prev.key,
        value: prev.value + "\n" + payload.slice(pos + 1, nl).to_string(),
      }
    } else {
      let mut sp = pos
      while sp < nl && payload[sp].to_int() != 32 {
        sp = sp + 1
      }
      if sp == pos || sp >= nl {
        return Err(GitError::InvalidCommit("malformed commit header line"))
      }
      let val_start = sp + 1
      let val_len = nl - val_start
      if phase == 0 {
        if sp - pos != 4 ||
        payload[pos].to_int() != 116 ||
        payload[pos + 1].to_int() != 114 ||
        payload[pos + 2].to_int() != 101 ||
        payload[pos + 3].to_int() != 101 {
          return Err(GitError::InvalidCommit("commit must start with tree header"))
        }
        match oid_from_hex_bytes(payload, val_start, val_len) {
          Ok(o) => {
            tree_opt = Some(o)
            phase = 1
          }
          Err(e) => return Err(e)
        }
      } else if phase == 1 {
        let klen = sp - pos
        if klen == 6 &&
        payload[pos].to_int() == 112 &&
        payload[pos + 1].to_int() == 97 &&
        payload[pos + 2].to_int() == 114 &&
        payload[pos + 3].to_int() == 101 &&
        payload[pos + 4].to_int() == 110 &&
        payload[pos + 5].to_int() == 116 {
          match oid_from_hex_bytes(payload, val_start, val_len) {
            Ok(o) => parents.push(o)
            Err(e) => return Err(e)
          }
        } else if klen == 6 &&
        payload[pos].to_int() == 97 &&
        payload[pos + 1].to_int() == 117 &&
        payload[pos + 2].to_int() == 116 &&
        payload[pos + 3].to_int() == 104 &&
        payload[pos + 4].to_int() == 111 &&
        payload[pos + 5].to_int() == 114 {
          match parse_signature_bytes(payload, val_start, nl) {
            Ok(sig) => {
              author_opt = Some(sig)
              phase = 2
            }
            Err(e) => return Err(e)
          }
        } else {
          return Err(
            GitError::InvalidCommit("unexpected header before author: " + payload.slice(pos, sp).to_string()),
          )
        }
      } else if phase == 2 {
        if sp - pos != 9 ||
        payload[pos].to_int() != 99 ||
        payload[pos + 1].to_int() != 111 ||
        payload[pos + 2].to_int() != 109 ||
        payload[pos + 3].to_int() != 109 ||
        payload[pos + 4].to_int() != 105 ||
        payload[pos + 5].to_int() != 116 ||
        payload[pos + 6].to_int() != 116 ||
        payload[pos + 7].to_int() != 101 ||
        payload[pos + 8].to_int() != 114 {
          return Err(
            GitError::InvalidCommit(
              "expected committer header after author, got: " + payload.slice(pos, sp).to_string(),
            ),
          )
        }
        match parse_signature_bytes(payload, val_start, nl) {
          Ok(sig) => {
            committer_opt = Some(sig)
            phase = 3
          }
          Err(e) => return Err(e)
        }
      } else {
        let key = payload.slice(pos, sp).to_string()
        let val_str = payload.slice(val_start, nl).to_string()
        if key == "encoding" {
          encoding = Some(val_str)
        }
        extra_headers.push(ExtraHeader::{ key: key, value: val_str })
      }
    }
    pos = if nl < n { nl + 1 } else { n }
  }

  let tree = match tree_opt {
    Some(t) => t
    None => return Err(GitError::InvalidCommit("missing tree header"))
  }
  let author = match author_opt {
    Some(a) => a
    None => return Err(GitError::InvalidCommit("missing author header"))
  }
  let committer = match committer_opt {
    Some(c) => c
    None => return Err(GitError::InvalidCommit("missing committer header"))
  }
  let message = payload.slice(msg_start, n).to_string()
  Ok(
    Commit::{
      tree: tree,
      parents: parents,
      author: author,
      committer: committer,
      encoding: encoding,
      extra_headers: extra_headers,
      message: message,
    },
  )
}

///|
fn write_extra_header(sb : StringBuilder, h : ExtraHeader) -> Unit {
  sb.write_string(h.key)
  sb.write_string(" ")
  let v = h.value
  let n = v.length()
  let mut i = 0
  let mut seg_start = 0
  while i < n {
    if v.code_unit_at(i) == 10 {
      sb.write_string(v.slice(seg_start, i))
      sb.write_string("\n ")
      seg_start = i + 1
    }
    i = i + 1
  }
  sb.write_string(v.slice(seg_start, n))
  sb.write_string("\n")
}

///|
fn extra_header_encoded_len(h : ExtraHeader) -> Int {
  let v = h.value
  let n = v.length()
  let mut nls = 0
  let mut i = 0
  while i < n {
    if v.code_unit_at(i) == 10 {
      nls = nls + 1
    }
    i = i + 1
  }
  h.key.length() + 1 + n + nls + 1
}

///|
fn write_extra_header_into(out : Bytes, off : Int, h : ExtraHeader) -> Int {
  let mut p = write_str_into(out, off, h.key)
  out[p] = 32.to_byte()
  p = p + 1
  let v = h.value
  let n = v.length()
  let mut i = 0
  while i < n {
    let c = v.code_unit_at(i)
    out[p] = c.to_byte()
    p = p + 1
    if c == 10 {
      out[p] = 32.to_byte()
      p = p + 1
    }
    i = i + 1
  }
  out[p] = 10.to_byte()
  p + 1
}

///|
pub fn Commit::encode(self : Commit) -> Bytes {
  let num_parents = self.parents.length()
  let num_extra = self.extra_headers.length()
  let mut has_encoding_in_extra = false
  let mut extra_bytes = 0
  let mut k = 0
  while k < num_extra {
    let eh = self.extra_headers[k]
    if eh.key == "encoding" {
      has_encoding_in_extra = true
    }
    extra_bytes = extra_bytes + extra_header_encoded_len(eh)
    k = k + 1
  }

  let mut total = 5 + self.tree.bytes.length() * 2 + 1
  let mut i = 0
  while i < num_parents {
    total = total + 7 + self.parents[i].bytes.length() * 2 + 1
    i = i + 1
  }
  let a = self.author
  let c = self.committer
  // "author " (7) + name + " <" (2) + email + "> " (2) + ts + " " (1) + tz + "\n" (1)
  total = total + 13 + a.name.length() + a.email.length() + int64_decimal_len(a.timestamp) + a.tz_raw.length()
  // "committer " (10) + name + " <" (2) + email + "> " (2) + ts + " " (1) + tz + "\n" (1)
  total = total + 16 + c.name.length() + c.email.length() + int64_decimal_len(c.timestamp) + c.tz_raw.length()
  if !has_encoding_in_extra {
    match self.encoding {
      Some(enc) => total = total + 9 + enc.length() + 1
      None => ()
    }
  }
  total = total + extra_bytes + 1 + self.message.length()

  let out = Bytes::new(total)
  let mut p = 0
  // "tree "
  out[p] = 116.to_byte()
  out[p + 1] = 114.to_byte()
  out[p + 2] = 101.to_byte()
  out[p + 3] = 101.to_byte()
  out[p + 4] = 32.to_byte()
  p = write_oid_hex_into(self.tree.bytes, out, p + 5)
  out[p] = 10.to_byte()
  p = p + 1

  i = 0
  while i < num_parents {
    out[p] = 112.to_byte()
    out[p + 1] = 97.to_byte()
    out[p + 2] = 114.to_byte()
    out[p + 3] = 101.to_byte()
    out[p + 4] = 110.to_byte()
    out[p + 5] = 116.to_byte()
    out[p + 6] = 32.to_byte()
    p = write_oid_hex_into(self.parents[i].bytes, out, p + 7)
    out[p] = 10.to_byte()
    p = p + 1
    i = i + 1
  }

  // "author "
  out[p] = 97.to_byte()
  out[p + 1] = 117.to_byte()
  out[p + 2] = 116.to_byte()
  out[p + 3] = 104.to_byte()
  out[p + 4] = 111.to_byte()
  out[p + 5] = 114.to_byte()
  out[p + 6] = 32.to_byte()
  p = write_str_into(out, p + 7, a.name)
  out[p] = 32.to_byte()
  out[p + 1] = 60.to_byte()
  p = write_str_into(out, p + 2, a.email)
  out[p] = 62.to_byte()
  out[p + 1] = 32.to_byte()
  p = write_int64_into(out, p + 2, a.timestamp)
  out[p] = 32.to_byte()
  p = write_str_into(out, p + 1, a.tz_raw)
  out[p] = 10.to_byte()
  p = p + 1

  // "committer "
  out[p] = 99.to_byte()
  out[p + 1] = 111.to_byte()
  out[p + 2] = 109.to_byte()
  out[p + 3] = 109.to_byte()
  out[p + 4] = 105.to_byte()
  out[p + 5] = 116.to_byte()
  out[p + 6] = 116.to_byte()
  out[p + 7] = 101.to_byte()
  out[p + 8] = 114.to_byte()
  out[p + 9] = 32.to_byte()
  p = write_str_into(out, p + 10, c.name)
  out[p] = 32.to_byte()
  out[p + 1] = 60.to_byte()
  p = write_str_into(out, p + 2, c.email)
  out[p] = 62.to_byte()
  out[p + 1] = 32.to_byte()
  p = write_int64_into(out, p + 2, c.timestamp)
  out[p] = 32.to_byte()
  p = write_str_into(out, p + 1, c.tz_raw)
  out[p] = 10.to_byte()
  p = p + 1

  if !has_encoding_in_extra {
    match self.encoding {
      Some(enc) => {
        p = write_str_into(out, p, "encoding ")
        p = write_str_into(out, p, enc)
        out[p] = 10.to_byte()
        p = p + 1
      }
      None => ()
    }
  }
  let mut j = 0
  while j < num_extra {
    p = write_extra_header_into(out, p, self.extra_headers[j])
    j = j + 1
  }
  out[p] = 10.to_byte()
  let _ = write_str_into(out, p + 1, self.message)
  out
}

///|
pub fn Commit::gpgsig(self : Commit) -> Option[String] {
  let mut i = 0
  while i < self.extra_headers.length() {
    if self.extra_headers[i].key == "gpgsig" {
      return Some(self.extra_headers[i].value)
    }
    i = i + 1
  }
  None
}

///| Git annotated Tag object.
pub struct Tag {
  pub target : Oid
  pub target_kind : ObjectKind
  pub name : String
  pub tagger : Option[Signature]
  pub extra_headers : Array[ExtraHeader]
  pub message : String
}

///|
pub fn Tag::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Tag, GitError] {
  match limits.validate() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = payload.length()
  if n > limits.max_object_bytes {
    return Err(GitError::LimitExceeded("tag exceeds max_object_bytes"))
  }
  let mut target_opt : Option[Oid] = None
  let mut kind_opt : Option[ObjectKind] = None
  let mut name_opt : Option[String] = None
  let mut tagger : Option[Signature] = None
  let extra_headers : Array[ExtraHeader] = Array::new()
  let mut pos = 0
  let mut msg_start = n
  // Strict Git tag header phase: 0=object, 1=type, 2=tag, 3=tagger?/extra, 4=extra
  let mut phase = 0

  while pos < n {
    let mut nl = pos
    while nl < n && payload[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl == pos {
      msg_start = if nl + 1 <= n { nl + 1 } else { n }
      break
    }
    let line = payload.slice(pos, nl).to_string()
    if line.length() > 0 && line.code_unit_at(0) == 32 {
      if phase < 3 || extra_headers.length() == 0 {
        return Err(GitError::InvalidTag("orphan continuation line in tag"))
      }
      let last_idx = extra_headers.length() - 1
      let prev = extra_headers[last_idx]
      extra_headers[last_idx] = ExtraHeader::{
        key: prev.key,
        value: prev.value + "\n" + line.slice(1, line.length()),
      }
    } else {
      let mut sp = 0
      let llen = line.length()
      while sp < llen && line.code_unit_at(sp) != 32 {
        sp = sp + 1
      }
      if sp == 0 || sp >= llen {
        return Err(GitError::InvalidTag("malformed tag header"))
      }
      let key = line.slice(0, sp)
      let val_str = line.slice(sp + 1, llen)
      if phase == 0 {
        if key != "object" {
          return Err(GitError::InvalidTag("tag must start with object header"))
        }
        match Oid::from_hex(val_str) {
          Ok(o) => {
            target_opt = Some(o)
            phase = 1
          }
          Err(e) => return Err(e)
        }
      } else if phase == 1 {
        if key != "type" {
          return Err(GitError::InvalidTag("expected type header after object"))
        }
        match ObjectKind::from_str(val_str) {
          Ok(k) => {
            kind_opt = Some(k)
            phase = 2
          }
          Err(e) => return Err(e)
        }
      } else if phase == 2 {
        if key != "tag" {
          return Err(GitError::InvalidTag("expected tag header after type"))
        }
        match check_ref_format("refs/tags/" + val_str, false) {
          Ok(_) => ()
          Err(_) => return Err(GitError::InvalidTag("invalid tag name: " + val_str))
        }
        name_opt = Some(val_str)
        phase = 3
      } else if phase == 3 && key == "tagger" {
        match Signature::parse(val_str) {
          Ok(s) => {
            tagger = Some(s)
            phase = 4
          }
          Err(e) => return Err(e)
        }
      } else {
        phase = 4
        extra_headers.push(ExtraHeader::{ key: key, value: val_str })
      }
    }
    pos = if nl < n { nl + 1 } else { n }
  }

  let target = match target_opt {
    Some(t) => t
    None => return Err(GitError::InvalidTag("missing object header"))
  }
  let target_kind = match kind_opt {
    Some(k) => k
    None => return Err(GitError::InvalidTag("missing type header"))
  }
  let name = match name_opt {
    Some(nm) => nm
    None => return Err(GitError::InvalidTag("missing tag name header"))
  }
  let message = payload.slice(msg_start, n).to_string()
  Ok(
    Tag::{
      target: target,
      target_kind: target_kind,
      name: name,
      tagger: tagger,
      extra_headers: extra_headers,
      message: message,
    },
  )
}

///|
pub fn Tag::encode(self : Tag) -> Bytes {
  let sb = StringBuilder::new()
  sb.write_string("object ")
  sb.write_string(self.target.to_hex())
  sb.write_string("\n")
  sb.write_string("type ")
  sb.write_string(self.target_kind.as_str())
  sb.write_string("\n")
  sb.write_string("tag ")
  sb.write_string(self.name)
  sb.write_string("\n")
  match self.tagger {
    Some(tg) => {
      sb.write_string("tagger ")
      sb.write_string(tg.format())
      sb.write_string("\n")
    }
    None => ()
  }
  let mut j = 0
  while j < self.extra_headers.length() {
    write_extra_header(sb, self.extra_headers[j])
    j = j + 1
  }
  sb.write_string("\n")
  sb.write_string(self.message)
  sb.to_string().to_bytes()
}
