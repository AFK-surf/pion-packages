  Err(GitError::InvalidObject("unimplemented"))
}

///|
pub fn encode_loose_object_with_hash(
  kind : ObjectKind,
  payload : Bytes,
  hash_kind : HashKind,
) -> Result[(Oid, Bytes), GitError] {
  Err(GitError::InvalidObject("unimplemented"))
}

///|
pub fn decode_loose_object(
  compressed : Bytes,
  expected_oid : Option[Oid],
  limits : GitLimits,
) -> Result[RawObject, GitError] {
  Err(GitError::InvalidObject("unimplemented"))
}

///| Git Blob object.
pub struct Blob {
  pub data : Bytes
}

///|
pub fn Blob::new(data : Bytes) -> Blob {
  Blob::{ data: data }
}

///|
pub fn Blob::encode(self : Blob) -> Bytes {
  self.data
}

///|
pub fn Blob::decode(payload : Bytes) -> Blob {
  Blob::{ data: payload }
}

///|
pub fn Blob::oid(self : Blob) -> Oid {
  hash_object_sha1(ObjectKind::Blob, self.data)
}

///| Git tree entry file mode.
pub enum FileMode {
  Tree
  Blob
  BlobExecutable
  Link
  Commit
}

///|
pub fn FileMode::to_octal_str(self : FileMode) -> String {
  ""
}

///|
pub fn FileMode::to_u32(self : FileMode) -> UInt {
  0U
}

///|
pub fn FileMode::from_octal_str(s : String) -> Result[FileMode, GitError] {
  Err(GitError::InvalidTree("unimplemented"))
}

///|
pub fn FileMode::equals(self : FileMode, other : FileMode) -> Bool {
  self.to_u32() == other.to_u32()
}

///| Single entry inside a Git Tree object.
pub struct TreeEntry {
  pub mode : FileMode
  pub name : String
  pub oid : Oid
}

///| Exact Git tree sorting comparator (directories compare as `name + "/"`).
pub fn tree_entry_compare(a : TreeEntry, b : TreeEntry) -> Int {
  0
}

///| Git Tree object.
pub struct Tree {
  pub entries : Array[TreeEntry]
}

///|
pub fn Tree::parse(
  payload : Bytes,
  hash_kind : HashKind,
  limits : GitLimits,
) -> Result[Tree, GitError] {
  Err(GitError::InvalidTree("unimplemented"))
}

///|
pub fn Tree::encode(self : Tree) -> Result[Bytes, GitError] {
  Err(GitError::InvalidTree("unimplemented"))
}

///| Git author / committer / tagger signature.
pub val struct Signature {
  pub name : String
  pub email : String
  pub timestamp : Int64
  pub tz_offset_minutes : Int
  pub tz_raw : String
}

///|
pub fn Signature::parse(s : String) -> Result[Signature, GitError] {
  Err(GitError::InvalidCommit("unimplemented"))
}

///|
pub fn Signature::format(self : Signature) -> String {
  ""
}

///| Extra commit header (including multiline `gpgsig` / `mergetag`).
pub val struct ExtraHeader {
  pub key : String
  pub value : String
}

///| Git Commit object.
pub struct Commit {
  pub tree : Oid
  pub parents : Array[Oid]
  pub author : Signature
  pub committer : Signature
  pub encoding : Option[String]
  pub extra_headers : Array[ExtraHeader]
  pub message : String
}

///|
pub fn Commit::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Commit, GitError] {
  Err(GitError::InvalidCommit("unimplemented"))
}

///|
pub fn Commit::encode(self : Commit) -> Bytes {
  Bytes::new(0)
}

///|
pub fn Commit::gpgsig(self : Commit) -> Option[String] {
  None
}

///| Git annotated Tag object.
pub struct Tag {
  pub target : Oid
  pub target_kind : ObjectKind
  pub name : String
  pub tagger : Option[Signature]
  pub message : String
}

///|
pub fn Tag::parse(
  payload : Bytes,
  limits : GitLimits,
) -> Result[Tag, GitError] {
  Err(GitError::InvalidTag("unimplemented"))
}

///|
pub fn Tag::encode(self : Tag) -> Bytes {
  Bytes::new(0)
}
