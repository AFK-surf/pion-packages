///| Git Index (`.git/index` dircache v2 / v3 / v4) parser and serializer.

///| Single entry in `.git/index`.
pub struct IndexEntry {
  pub ctime_sec : UInt
  pub ctime_nsec : UInt
  pub mtime_sec : UInt
  pub mtime_nsec : UInt
  pub dev : UInt
  pub ino : UInt
  pub mode : UInt
  pub uid : UInt
  pub gid : UInt
  pub file_size : UInt
  pub oid : Oid
  pub flags : UInt
  pub extended_flags : UInt
  pub path : String
}

///|
pub fn IndexEntry::stage(self : IndexEntry) -> Int {
  ((self.flags >> 12U) & 3U).to_int()
}

///|
pub fn IndexEntry::assume_valid(self : IndexEntry) -> Bool {
  (self.flags & 0x8000U) != 0U
}

///|
pub fn IndexEntry::intent_to_add(self : IndexEntry) -> Bool {
  (self.extended_flags & 0x2000U) != 0U
}

///|
pub fn IndexEntry::skip_worktree(self : IndexEntry) -> Bool {
  (self.extended_flags & 0x4000U) != 0U
}

///| Raw extension block in `.git/index` (e.g. `TREE`, `REUC`, `LINK`).
pub struct IndexExtension {
  pub signature : String
  pub data : Bytes
}

///| Parsed `.git/index` dircache.
pub struct GitIndex {
  pub version : Int
  pub entries : Array[IndexEntry]
  pub extensions : Array[IndexExtension]
  pub checksum : Oid
}

///|
pub fn GitIndex::parse(
  data : Bytes,
  limits : GitLimits,
) -> Result[GitIndex, GitError] {
  Err(GitError::InvalidIndex("unimplemented"))
}

///|
pub fn GitIndex::encode(self : GitIndex) -> Result[Bytes, GitError] {
  Err(GitError::InvalidIndex("unimplemented"))
}
