///| 4-mode Wasm32 & Native smoke verification for `packages/git`.

import "git"

///|
pub fn smoke() -> String {
  let limits = git::GitLimits::default()

  // 1. OID & Loose Blob
  let blob_data = "Hello from Wasm32 Git plumbing!\nLine 2 repeated repeated.\n".to_bytes()
  let (blob_oid, loose_blob) = match git::encode_loose_object(git::ObjectKind::Blob, blob_data) {
    Ok(p) => p
    Err(e) => return "FAIL loose_encode: " + e.to_string()
  }
  let dec_blob = match git::decode_loose_object(loose_blob, Some(blob_oid), limits) {
    Ok(o) => o
    Err(e) => return "FAIL loose_decode: " + e.to_string()
  }

  // 2. Tree with Git directory-sorting rule ("a-b" before dir "a")
  let sub_tree_oid = git::hash_object_sha1(git::ObjectKind::Tree, Bytes::new(0))
  let tree = git::Tree::{
    entries: [
      git::TreeEntry::{ mode: git::FileMode::Tree, name: "a", oid: sub_tree_oid },
      git::TreeEntry::{ mode: git::FileMode::Blob, name: "a-b", oid: blob_oid },
    ],
  }
  let tree_bytes = match tree.encode() {
    Ok(b) => b
    Err(e) => return "FAIL tree_encode: " + e.to_string()
  }
  let tree_oid = git::hash_object_sha1(git::ObjectKind::Tree, tree_bytes)
  let tree_parsed = match git::Tree::parse(tree_bytes, git::HashKind::Sha1, limits) {
    Ok(t) => t
    Err(e) => return "FAIL tree_parse: " + e.to_string()
  }
  if tree_parsed.entries.length() != 2 || tree_parsed.entries[0].name != "a-b" {
    return "FAIL tree_sort"
  }

  // 3. Commit
  let sig = git::Signature::{
    name: "Wasm Smoke",
    email: "smoke@example.com",
    timestamp: 1700000000L,
    tz_offset_minutes: 480,
    tz_raw: "+0800",
  }
  let commit = git::Commit::{
    tree: tree_oid,
    parents: [],
    author: sig,
    committer: sig,
    encoding: Some("UTF-8"),
    extra_headers: [],
    message: "Wasm smoke commit\n",
  }
  let commit_bytes = commit.encode()
  let commit_oid = git::hash_object_sha1(git::ObjectKind::Commit, commit_bytes)

  // 4. Delta + PackWriter + PackReader + PackIndex v2
  let blob_v2 = "Hello from Wasm32 Git plumbing!\nLine 2 repeated repeated.\nLine 3 appended.\n".to_bytes()
  let delta = git::create_delta(blob_data, blob_v2)
  let pw = git::PackWriter::new()
  let _ = pw.add_object(git::ObjectKind::Blob, blob_data)
  pw.add_ofs_delta(0, delta)
  let _ = pw.add_object(git::ObjectKind::Tree, tree_bytes)
  let _ = pw.add_object(git::ObjectKind::Commit, commit_bytes)
  let (pack_bytes, pack_csum) = match pw.finish() {
    Ok(p) => p
    Err(e) => return "FAIL pack_write: " + e.to_string()
  }
  let pr = match git::PackReader::open(pack_bytes, limits) {
    Ok(r) => r
    Err(e) => return "FAIL pack_open: " + e.to_string()
  }
  let idx_bytes = match pr.build_idx_v2() {
    Ok(b) => b
    Err(e) => return "FAIL idx_build: " + e.to_string()
  }
  let pidx = match git::PackIndex::parse(idx_bytes, limits) {
    Ok(i) => i
    Err(e) => return "FAIL idx_parse: " + e.to_string()
  }
  let blob_v2_oid = git::hash_object_sha1(git::ObjectKind::Blob, blob_v2)
  match pidx.lookup(blob_v2_oid) {
    Some((off, _)) =>
    match pr.resolve_at_offset(off) {
      Ok(o) => if o.payload.length() != blob_v2.length() { return "FAIL delta_len" }
      Err(e) => return "FAIL resolve_delta: " + e.to_string()
    }
    None => return "FAIL idx_lookup"
  }

  // 5. GitIndex v4 roundtrip
  let idx_v4 = git::GitIndex::{
    version: 4,
    entries: [
      git::IndexEntry::{
        ctime_sec: 1U,
        ctime_nsec: 0U,
        mtime_sec: 1U,
        mtime_nsec: 0U,
        dev: 1U,
        ino: 1U,
        mode: 0x81a4U,
        uid: 0U,
        gid: 0U,
        file_size: blob_data.length().to_uint(),
        oid: blob_oid,
        flags: 0U,
        extended_flags: 0U,
        path: "dir/alpha.txt",
      },
      git::IndexEntry::{
        ctime_sec: 1U,
        ctime_nsec: 0U,
        mtime_sec: 1U,
        mtime_nsec: 0U,
        dev: 1U,
        ino: 2U,
        mode: 0x81a4U,
        uid: 0U,
        gid: 0U,
        file_size: blob_v2.length().to_uint(),
        oid: blob_v2_oid,
        flags: 0U,
        extended_flags: 0U,
        path: "dir/beta.txt",
      },
    ],
    extensions: [],
    checksum: git::Oid::zero(git::HashKind::Sha1),
  }
  let idx_v4_bytes = match idx_v4.encode() {
    Ok(b) => b
    Err(e) => return "FAIL index_v4_encode: " + e.to_string()
  }
  let idx_v4_parsed = match git::GitIndex::parse(idx_v4_bytes, limits) {
    Ok(i) => i
    Err(e) => return "FAIL index_v4_parse: " + e.to_string()
  }

  // 6. pkt-line + Sideband + check_ref_format
  let pkt_wire = match git::encode_pkt_line(
    git::PktLine::Data(git::encode_sideband(git::SidebandMessage::Progress("ok\n"))),
  ) {
    Ok(b) => b
    Err(e) => return "FAIL pkt_encode: " + e.to_string()
  }
  let pkt_lines = match git::decode_pkt_lines(pkt_wire, limits) {
    Ok(ls) => ls
    Err(e) => return "FAIL pkt_decode: " + e.to_string()
  }
  let (_, prog, _) = match git::demux_sideband(pkt_lines) {
    Ok(t) => t
    Err(e) => return "FAIL sideband: " + e.to_string()
  }
  match git::check_ref_format("refs/heads/feat/pkg-git", false) {
    Ok(_) => ()
    Err(e) => return "FAIL ref_format: " + e.to_string()
  }

  "git_wasm_smoke: OK blob=" +
  dec_blob.oid.to_hex() +
  " tree=" +
  tree_oid.to_hex() +
  " commit=" +
  commit_oid.to_hex() +
  " pack=" +
  pack_csum.to_hex() +
  " idx_v4_entries=" +
  idx_v4_parsed.entries.length().to_string() +
  " prog=" +
  prog.length().to_string()
}

///|
pub fn main(world : World) -> Int {
  let msg = smoke()
  io_println(world, msg)
  if msg.length() >= 18 && msg.slice(0, 18) == "git_wasm_smoke: OK" {
    0
  } else {
    1
  }
}
