///| Comprehensive test suite for `packages/git` v0.1.0.
///| Includes real `git` CLI binary fixtures (loose objects, packfile v2 OFS_DELTA/REF_DELTA,
///| `.idx` v2, `.git/index` v2/v4) and `gix` specification & security tests.

fn bytes_eq_test(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn hex_to_raw(h : String) -> Bytes {
  match crypto::hex_to_bytes(h) {
    Some(b) => b
    None => {
      debug_assert(false, "invalid test hex fixture")
      Bytes::new(0)
    }
  }
}

fn must_oid(h : String) -> Oid {
  match Oid::from_hex(h) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "expected valid oid: " + e.to_string())
      Oid::zero(HashKind::Sha1)
    }
  }
}

// Real `git` CLI fixtures generated by `git 2.54.0`:
// Repo with:
//   - a-b ("file a-b\n")
//   - a/inside.txt (40x "inside a/\n" + "appended line 2\n")
//   - run.sh (0755, "#!/bin/sh\necho hi\n")
//   - link.txt (symlink -> "a/inside.txt")
//   - z.txt ("z file\n")
// Two commits (HEAD=9ee0dec2..., COMMIT1=5b4b91d7...), annotated tag v0.1.0 (6c05f68c...).

let fixture_head_oid : String = "9ee0dec2789e4bcc9aabe00e04f95e2f5e7e3f2e"
let fixture_commit1_oid : String = "5b4b91d74b43389a0bd05806f276ff2b45426d47"
let fixture_tree_oid : String = "5e8f512b2bf7a55c3081b02085d530aa076d8da5"
let fixture_tag_oid : String = "6c05f68c434351e65c9345a66728326841eabbd4"
let fixture_blob_oid : String = "240437eb4d4db2194f8de99df186bff058020531"
let fixture_delta_blob_oid : String = "a658918af78d833982cdf53b2f7724e5368b5028"

let fixture_loose_blob_hex : String = "78014bcac94f5230313463c8cc2bce4c495548d4e71a650d8630482c2848cd4b494d51c8c9cc4b5530e2020038e38830"
let fixture_loose_tree_hex : String = ""
let fixture_loose_commit_hex : String = ""
let fixture_loose_tag_hex : String = "7801358c410ac23014055de7147f2f849fb4250644c40b08de203fbe14a521c106d1dbdb2c9cd52c8669612633b85d912762230ff01dd1ba83c72831fa1004cce031f909364d701892856adf0a8a25e747536d7bbc591bcd5d67bce85284ae75a5a31439e313725da0b7fa44c671c732d3be8b52372c082bfe871fb0302acf"

let fixture_index_v2_hex : String = ""

let fixture_index_v4_hex : String = ""

let fixture_pack_ofs_hex : String = ""

let fixture_pack_idx_hex : String = ""

let fixture_pack_ref_hex : String = ""

// ============================================================================
// 1. OID Tests (SHA-1 20B & SHA-256 32B)
// ============================================================================

test "oid_sha1_and_sha256_roundtrip_compare_prefix" {
  let o1 = must_oid("9EE0DEC2789E4BCC9AABE00E04F95E2F5E7E3F2E")
  debug_assert(o1.byte_len() == 20, "sha1 len")
  debug_assert(o1.to_hex() == fixture_head_oid, "lowercase hex")
  debug_assert(!o1.is_zero(), "non-zero")
  debug_assert(o1.starts_with_hex("9ee0dec"), "prefix lower")
  debug_assert(o1.starts_with_hex("9EE0DEC2"), "prefix upper")
  debug_assert(!o1.starts_with_hex("9ee0ded"), "prefix mismatch")

  let z1 = Oid::zero(HashKind::Sha1)
  debug_assert(z1.is_zero(), "zero sha1")
  debug_assert(z1.compare(o1) < 0, "zero < non-zero")
  debug_assert(o1.compare(z1) > 0, "non-zero > zero")
  debug_assert(o1.compare(o1) == 0, "eq")
  debug_assert(o1.equals(must_oid(fixture_head_oid)), "equals")

  let sha256_hex = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  let o256 = must_oid(sha256_hex)
  debug_assert(o256.byte_len() == 32, "sha256 len")
  debug_assert(o256.to_hex() == sha256_hex, "sha256 hex")
  debug_assert(o256.starts_with_hex("e3b0c44"), "sha256 prefix")

  // Invalid OID lengths and characters
  match Oid::from_hex("1234") {
    Err(GitError::InvalidOid(_)) => ()
    _ => debug_assert(false, "expected InvalidOid for short hex")
  }
  match Oid::from_hex("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz") {
    Err(GitError::InvalidOid(_)) => ()
    _ => debug_assert(false, "expected InvalidOid for bad hex")
  }
  match Oid::from_bytes(Bytes::new(19)) {
    Err(GitError::InvalidOid(_)) => ()
    _ => debug_assert(false, "expected InvalidOid for 19B")
  }
}

test "oid_known_git_blob_hashes" {
  // Empty blob: e69de29bb2d1d6434b8b29ae775ad8c2e48c5391
  let empty_oid = hash_object_sha1(ObjectKind::Blob, Bytes::new(0))
  debug_assert(
    empty_oid.to_hex() == "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
    "empty blob sha1",
  )
  // "what is up, doc?" -> bd9dbf5aae1a3862dd1526723246b20206e5fc37
  let doc_oid = hash_object_sha1(ObjectKind::Blob, "what is up, doc?".to_bytes())
  debug_assert(
    doc_oid.to_hex() == "bd9dbf5aae1a3862dd1526723246b20206e5fc37",
    "known blob sha1",
  )
}

// ============================================================================
// 2. Loose Objects & Blob / Tree / Commit / Tag Codecs (Real Git Fixtures)
// ============================================================================

test "loose_blob_decode_and_roundtrip" {
  let limits = GitLimits::default()
  let expected = must_oid(fixture_blob_oid)
  let raw = match decode_loose_object(hex_to_raw(fixture_loose_blob_hex), Some(expected), limits) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "decode_loose_object blob failed: " + e.to_string())
      return
    }
  }
  debug_assert(raw.kind.equals(ObjectKind::Blob), "kind blob")
  debug_assert(raw.oid.equals(expected), "oid match")
  debug_assert(raw.payload.length() == 416, "blob payload len 416")

  // Re-encode loose object and verify OID matches
  let (re_oid, re_bytes) = match encode_loose_object(ObjectKind::Blob, raw.payload) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "encode_loose_object failed: " + e.to_string())
      return
    }
  }
  debug_assert(re_oid.equals(expected), "re-encoded oid")
  let re_dec = match decode_loose_object(re_bytes, Some(expected), limits) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "re-decode failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(re_dec.payload, raw.payload), "payload roundtrip")

  // Wrong expected OID must fail with ChecksumMismatch
  let wrong_oid = Oid::zero(HashKind::Sha1)
  match decode_loose_object(hex_to_raw(fixture_loose_blob_hex), Some(wrong_oid), limits) {
    Err(GitError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "expected ChecksumMismatch on wrong expected_oid")
  }
}

test "loose_tree_parse_and_strict_git_directory_sorting" {
  let limits = GitLimits::default()
  let expected = must_oid(fixture_tree_oid)
  let raw = match decode_loose_object(hex_to_raw(fixture_loose_tree_hex), Some(expected), limits) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "decode_loose_object tree failed: " + e.to_string())
      return
    }
  }
  debug_assert(raw.kind.equals(ObjectKind::Tree), "kind tree")
  let tree = match Tree::parse(raw.payload, HashKind::Sha1, limits) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "Tree::parse failed: " + e.to_string())
      return
    }
  }
  debug_assert(tree.entries.length() == 5, "5 tree entries")
  // Critical Git sorting rule: file "a-b" (0x2d) MUST sort BEFORE directory "a" (treated as "a/", 0x2f)!
  debug_assert(tree.entries[0].name == "a-b", "entry 0 is a-b")
  debug_assert(tree.entries[0].mode.equals(FileMode::Blob), "a-b is 100644")
  debug_assert(tree.entries[1].name == "a", "entry 1 is dir a")
  debug_assert(tree.entries[1].mode.equals(FileMode::Tree), "a is 040000")
  debug_assert(tree.entries[2].name == "link.txt", "entry 2 is link.txt")
  debug_assert(tree.entries[2].mode.equals(FileMode::Link), "link.txt is 120000")
  debug_assert(tree.entries[3].name == "run.sh", "entry 3 is run.sh")
  debug_assert(tree.entries[3].mode.equals(FileMode::BlobExecutable), "run.sh is 100755")
  debug_assert(tree.entries[4].name == "z.txt", "entry 4 is z.txt")

  // Re-encode with scrambled entry order and verify byte-identical canonical Git tree + exact OID!
  let scrambled = Tree::{
    entries: [
      tree.entries[4],
      tree.entries[1],
      tree.entries[3],
      tree.entries[0],
      tree.entries[2],
    ],
  }
  let encoded = match scrambled.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "Tree::encode failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(encoded, raw.payload), "tree canonical re-encode byte-identical")
  debug_assert(hash_object_sha1(ObjectKind::Tree, encoded).equals(expected), "tree oid exact")
}

test "loose_commit_parse_and_roundtrip" {
  let limits = GitLimits::default()
  let expected = must_oid(fixture_head_oid)
  let raw = match decode_loose_object(hex_to_raw(fixture_loose_commit_hex), Some(expected), limits) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "decode_loose_object commit failed: " + e.to_string())
      return
    }
  }
  debug_assert(raw.kind.equals(ObjectKind::Commit), "kind commit")
  let c = match Commit::parse(raw.payload, limits) {
    Ok(cm) => cm
    Err(e) => {
      debug_assert(false, "Commit::parse failed: " + e.to_string())
      return
    }
  }
  debug_assert(c.tree.to_hex() == fixture_tree_oid, "commit tree oid")
  debug_assert(c.parents.length() == 1, "1 parent")
  debug_assert(c.parents[0].to_hex() == fixture_commit1_oid, "parent oid")
  debug_assert(c.author.name == "Alice Dev", "author name")
  debug_assert(c.author.email == "alice@example.com", "author email")
  debug_assert(c.author.timestamp == 1700000200L, "author ts")
  debug_assert(c.author.tz_offset_minutes == 0, "author tz")
  debug_assert(c.committer.name == "Bob Ops", "committer name")
  debug_assert(c.message == "Second commit\n", "commit msg")

  let encoded = c.encode()
  debug_assert(bytes_eq_test(encoded, raw.payload), "commit roundtrip byte-identical")
  debug_assert(hash_object_sha1(ObjectKind::Commit, encoded).equals(expected), "commit oid")
}

test "commit_with_encoding_and_multiline_gpgsig" {
  let raw_str = "tree 5e8f512b2bf7a55c3081b02085d530aa076d8da5\n" +
  "parent 5b4b91d74b43389a0bd05806f276ff2b45426d47\n" +
  "author Alice <alice@example.com> 1700000000 +0800\n" +
  "committer Bob <bob@example.com> 1700000100 -0530\n" +
  "encoding UTF-8\n" +
  "gpgsig -----BEGIN PGP SIGNATURE-----\n" +
  " \n" +
  " iQIzBAABCAAdFiEEtest\n" +
  " -----END PGP SIGNATURE-----\n" +
  "\nSigned commit body\n"
  let payload = raw_str.to_bytes()
  let c = match Commit::parse(payload, GitLimits::default()) {
    Ok(cm) => cm
    Err(e) => {
      debug_assert(false, "Commit::parse gpgsig failed: " + e.to_string())
      return
    }
  }
  debug_assert(c.author.tz_offset_minutes == 480, "+0800 = 480m")
  debug_assert(c.committer.tz_offset_minutes == -330, "-0530 = -330m")
  match c.encoding {
    Some(enc) => debug_assert(enc == "UTF-8", "encoding")
    None => debug_assert(false, "expected encoding")
  }
  match c.gpgsig() {
    Some(sig) => {
      debug_assert(sig.contains("BEGIN PGP SIGNATURE"), "gpgsig start")
      debug_assert(sig.contains("END PGP SIGNATURE"), "gpgsig end")
    }
    None => debug_assert(false, "expected gpgsig")
  }
  debug_assert(bytes_eq_test(c.encode(), payload), "gpgsig commit roundtrip byte-identical")
}

test "loose_tag_parse_and_roundtrip" {
  let limits = GitLimits::default()
  let expected = must_oid(fixture_tag_oid)
  let raw = match decode_loose_object(hex_to_raw(fixture_loose_tag_hex), Some(expected), limits) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "decode_loose_object tag failed: " + e.to_string())
      return
    }
  }
  debug_assert(raw.kind.equals(ObjectKind::Tag), "kind tag")
  let t = match Tag::parse(raw.payload, limits) {
    Ok(tg) => tg
    Err(e) => {
      debug_assert(false, "Tag::parse failed: " + e.to_string())
      return
    }
  }
  debug_assert(t.target.to_hex() == fixture_head_oid, "tag target")
  debug_assert(t.target_kind.equals(ObjectKind::Commit), "tag target kind")
  debug_assert(t.name == "v0.1.0", "tag name")
  match t.tagger {
    Some(tg) => debug_assert(tg.name == "Bob Ops", "tagger name")
    None => debug_assert(false, "expected tagger")
  }
  debug_assert(t.message == "Release v0.1.0\n", "tag msg")
  debug_assert(bytes_eq_test(t.encode(), raw.payload), "tag roundtrip byte-identical")
}

// ============================================================================
// 3. Delta Engine Tests
// ============================================================================

test "delta_encode_decode_roundtrip" {
  let base = "The quick brown fox jumps over the lazy dog.\nRepeat line 1234567890!\nRepeat line 1234567890!\nEnd of base.\n".to_bytes()
  let target = "The quick brown fox jumps over the lazy dog.\nINSERTED MIDDLE LINE\nRepeat line 1234567890!\nEnd of target!\n".to_bytes()
  let delta = create_delta(base, target)
  debug_assert(delta.length() > 0 && delta.length() < target.length(), "delta should compress")
  let (b_sz, t_sz, _) = match decode_delta_header(delta) {
    Ok(h) => h
    Err(e) => {
      debug_assert(false, "decode_delta_header failed: " + e.to_string())
      return
    }
  }
  debug_assert(b_sz == base.length(), "delta base size")
  debug_assert(t_sz == target.length(), "delta target size")
  let applied = match apply_delta(base, delta, GitLimits::default()) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "apply_delta failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(applied, target), "delta roundtrip exact")
}

test "delta_rejects_reserved_opcode_and_bomb" {
  // base_size=4, target_size=4, opcode=0x00 (reserved!)
  let mut bad = Bytes::new(3)
  bad[0] = 4.to_byte()
  bad[1] = 4.to_byte()
  bad[2] = 0.to_byte()
  match apply_delta("abcd".to_bytes(), bad, GitLimits::default()) {
    Err(GitError::InvalidDelta(_)) => ()
    _ => debug_assert(false, "expected InvalidDelta on reserved opcode 0")
  }
  // Bomb: base_size=4, target_size=10000, limit=100
  let mut bomb = Bytes::new(4)
  bomb[0] = 4.to_byte()
  bomb[1] = 0x90.to_byte()
  bomb[2] = 0x4e.to_byte()
  bomb[3] = 0x01.to_byte()
  let tight = GitLimits::new(100, 100, 10, 100, 100, 100)
  match apply_delta("abcd".to_bytes(), bomb, tight) {
    Err(GitError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on delta bomb")
  }
}

// ============================================================================
// 4. Packfile v2 + `.idx` v2 (Real Git CLI OFS_DELTA & REF_DELTA Fixtures)
// ============================================================================

test "packfile_v2_ofs_delta_and_idx_v2_real_git" {
  let limits = GitLimits::default()
  let pack_bytes = hex_to_raw(fixture_pack_ofs_hex)
  let idx_bytes = hex_to_raw(fixture_pack_idx_hex)

  let idx = match PackIndex::parse(idx_bytes, limits) {
    Ok(i) => i
    Err(e) => {
      debug_assert(false, "PackIndex::parse failed: " + e.to_string())
      return
    }
  }
  debug_assert(idx.len() == 13, "13 objects in idx")

  let reader = match PackReader::open(pack_bytes, limits) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "PackReader::open OFS pack failed: " + e.to_string())
      return
    }
  }
  debug_assert(reader.len() == 13, "13 objects in pack")
  debug_assert(reader.checksum().equals(idx.pack_checksum()), "pack checksum == idx pack_checksum")

  // Verify delta-encoded blob resolves with exact OID and payload!
  let delta_oid = must_oid(fixture_delta_blob_oid)
  let resolved = match reader.resolve_object(delta_oid) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "resolve_object delta blob failed: " + e.to_string())
      return
    }
  }
  debug_assert(resolved.kind.equals(ObjectKind::Blob), "delta resolved kind blob")
  debug_assert(resolved.oid.equals(delta_oid), "delta resolved oid")
  debug_assert(resolved.payload.length() == 400, "old a/inside.txt was 400B")

  // Verify `.idx` lookup matches PackReader offset + CRC32 for every single object!
  let all = match reader.resolve_all() {
    Ok(a) => a
    Err(e) => {
      debug_assert(false, "resolve_all failed: " + e.to_string())
      return
    }
  }
  debug_assert(all.length() == 13, "13 resolved objects")
  let mut i = 0
  while i < all.length() {
    let obj = all[i]
    match idx.lookup(obj.oid) {
      Some((off, _crc)) => {
        let by_off = match reader.resolve_at_offset(off) {
          Ok(o2) => o2
          Err(e) => {
            debug_assert(false, "resolve_at_offset failed: " + e.to_string())
            return
          }
        }
        debug_assert(by_off.oid.equals(obj.oid), "offset lookup oid match")
      }
      None => debug_assert(false, "oid missing from idx: " + obj.oid.to_hex())
    }
    i = i + 1
  }

  // Build `.idx` v2 from PackReader and verify it is BYTE-IDENTICAL to git's `.idx`!
  let built_idx = match reader.build_idx_v2() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "build_idx_v2 failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(built_idx, idx_bytes), "built .idx v2 must be byte-identical to git CLI .idx!")
}

test "packfile_v2_ref_delta_real_git" {
  let limits = GitLimits::default()
  let pack_bytes = hex_to_raw(fixture_pack_ref_hex)
  let reader = match PackReader::open(pack_bytes, limits) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "PackReader::open REF pack failed: " + e.to_string())
      return
    }
  }
  debug_assert(reader.len() == 13, "13 objects in REF pack")
  let delta_oid = must_oid(fixture_delta_blob_oid)
  let resolved = match reader.resolve_object(delta_oid) {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "resolve_object REF_DELTA failed: " + e.to_string())
      return
    }
  }
  debug_assert(resolved.oid.equals(delta_oid), "REF_DELTA oid match")
  debug_assert(resolved.payload.length() == 400, "REF_DELTA payload len")
}

test "packfile_writer_with_ofs_and_ref_deltas_roundtrip" {
  let w = PackWriter::new()
  let base_data = "0123456789abcdef".to_bytes().concat("0123456789abcdef".to_bytes())
  let target1 = "0123456789abcdef".to_bytes().concat("XYZ_CHANGED_1234".to_bytes())
  let target2 = "PREFIX_".to_bytes().concat(target1)
  let base_oid = w.add_object(ObjectKind::Blob, base_data)
  let d1 = create_delta(base_data, target1)
  let d2 = create_delta(target1, target2)
  w.add_ofs_delta(0, d1)
  let t1_oid = hash_object_sha1(ObjectKind::Blob, target1)
  let t2_oid = hash_object_sha1(ObjectKind::Blob, target2)
  w.add_ref_delta(t1_oid, d2)

  let (pack_bytes, _csum) = match w.finish() {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "PackWriter::finish failed: " + e.to_string())
      return
    }
  }
  let r = match PackReader::open(pack_bytes, GitLimits::default()) {
    Ok(pr) => pr
    Err(e) => {
      debug_assert(false, "PackReader::open written pack failed: " + e.to_string())
      return
    }
  }
  debug_assert(r.len() == 3, "3 pack objects")
  match r.resolve_object(base_oid) {
    Ok(o) => debug_assert(bytes_eq_test(o.payload, base_data), "base payload")
    Err(e) => debug_assert(false, "resolve base: " + e.to_string())
  }
  match r.resolve_object(t1_oid) {
    Ok(o) => debug_assert(bytes_eq_test(o.payload, target1), "t1 payload")
    Err(e) => debug_assert(false, "resolve t1: " + e.to_string())
  }
  match r.resolve_object(t2_oid) {
    Ok(o) => debug_assert(bytes_eq_test(o.payload, target2), "t2 payload")
    Err(e) => debug_assert(false, "resolve t2: " + e.to_string())
  }

  // Delta depth limit = 1 must reject depth-2 chain (t2 -> t1 -> base)!
  let depth1 = GitLimits::new(65536, 100, 1, 65536, 100, 100)
  match PackReader::open(pack_bytes, depth1) {
    Err(GitError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for delta depth > 1")
  }
}

// ============================================================================
// 5. Git Index (`.git/index` v2 / v3 / v4) Real Git CLI Fixtures
// ============================================================================

test "git_index_v2_real_git_parse_and_roundtrip" {
  let raw = hex_to_raw(fixture_index_v2_hex)
  let idx = match GitIndex::parse(raw, GitLimits::default()) {
    Ok(i) => i
    Err(e) => {
      debug_assert(false, "GitIndex::parse v2 failed: " + e.to_string())
      return
    }
  }
  debug_assert(idx.version == 2, "index version 2")
  debug_assert(idx.entries.length() == 5, "5 index entries")
  debug_assert(idx.entries[0].path == "a-b", "entry 0 path")
  debug_assert(idx.entries[1].path == "a/inside.txt", "entry 1 path")
  debug_assert(idx.entries[1].oid.to_hex() == fixture_blob_oid, "entry 1 oid")
  debug_assert(idx.entries[2].path == "link.txt", "entry 2 path")
  debug_assert(idx.entries[3].path == "run.sh", "entry 3 path")
  debug_assert(idx.entries[4].path == "z.txt", "entry 4 path")
  debug_assert(idx.extensions.length() == 1, "TREE extension preserved")
  debug_assert(idx.extensions[0].signature == "TREE", "TREE sig")

  let re = match idx.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "GitIndex::encode v2 failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(re, raw), "index v2 re-encode byte-identical to git CLI!")
}

test "git_index_v4_real_git_parse_and_roundtrip" {
  let raw = hex_to_raw(fixture_index_v4_hex)
  let idx = match GitIndex::parse(raw, GitLimits::default()) {
    Ok(i) => i
    Err(e) => {
      debug_assert(false, "GitIndex::parse v4 failed: " + e.to_string())
      return
    }
  }
  debug_assert(idx.version == 4, "index version 4")
  debug_assert(idx.entries.length() == 5, "5 index entries v4")
  debug_assert(idx.entries[0].path == "a-b", "v4 entry 0")
  debug_assert(idx.entries[1].path == "a/inside.txt", "v4 entry 1 (prefix compressed)")
  debug_assert(idx.entries[2].path == "link.txt", "v4 entry 2")
  debug_assert(idx.entries[3].path == "run.sh", "v4 entry 3")
  debug_assert(idx.entries[4].path == "z.txt", "v4 entry 4")

  let re = match idx.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "GitIndex::encode v4 failed: " + e.to_string())
      return
    }
  }
  debug_assert(bytes_eq_test(re, raw), "index v4 re-encode byte-identical to git CLI!")
}

test "git_index_v3_extended_flags_and_stages" {
  let e1 = IndexEntry::{
    ctime_sec: 100U,
    ctime_nsec: 0U,
    mtime_sec: 200U,
    mtime_nsec: 0U,
    dev: 1U,
    ino: 2U,
    mode: 0x81a4U,
    uid: 1000U,
    gid: 1000U,
    file_size: 42U,
    oid: must_oid(fixture_blob_oid),
    flags: 0x5000U, // extended (0x4000) + stage 1 (0x1000)
    extended_flags: 0x6000U, // intent-to-add + skip-worktree
    path: "dir/conflict.txt",
  }
  let idx = GitIndex::{
    version: 3,
    entries: [e1],
    extensions: [],
    checksum: Oid::zero(HashKind::Sha1),
  }
  let encoded = match idx.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode v3 failed: " + e.to_string())
      return
    }
  }
  let parsed = match GitIndex::parse(encoded, GitLimits::default()) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse v3 failed: " + e.to_string())
      return
    }
  }
  debug_assert(parsed.version == 3, "v3")
  debug_assert(parsed.entries[0].stage() == 1, "stage 1")
  debug_assert(parsed.entries[0].intent_to_add(), "intent-to-add")
  debug_assert(parsed.entries[0].skip_worktree(), "skip-worktree")
  debug_assert(parsed.entries[0].path == "dir/conflict.txt", "v3 path")
}

// ============================================================================
// 6. Wire Protocol `pkt-line`, Sideband-64k, Ref Advertisement & `check_ref_format`
// ============================================================================

test "pktline_framing_and_special_packets" {
  let stream = "0006a\n0005a000bfoobar\n0004000000010002".to_bytes()
  let lines = match decode_pkt_lines(stream, GitLimits::default()) {
    Ok(ls) => ls
    Err(e) => {
      debug_assert(false, "decode_pkt_lines failed: " + e.to_string())
      return
    }
  }
  debug_assert(lines.length() == 7, "7 pkt-lines")
  match lines[0] {
    PktLine::Data(b) => debug_assert(b.to_string() == "a\n", "pkt 0")
    _ => debug_assert(false, "expected Data 0")
  }
  match lines[1] {
    PktLine::Data(b) => debug_assert(b.to_string() == "a", "pkt 1")
    _ => debug_assert(false, "expected Data 1")
  }
  match lines[2] {
    PktLine::Data(b) => debug_assert(b.to_string() == "foobar\n", "pkt 2")
    _ => debug_assert(false, "expected Data 2")
  }
  match lines[3] {
    PktLine::Data(b) => debug_assert(b.length() == 0, "empty data 0004")
    _ => debug_assert(false, "expected empty Data")
  }
  match lines[4] {
    PktLine::Flush => ()
    _ => debug_assert(false, "expected Flush 0000")
  }
  match lines[5] {
    PktLine::Delim => ()
    _ => debug_assert(false, "expected Delim 0001")
  }
  match lines[6] {
    PktLine::ResponseEnd => ()
    _ => debug_assert(false, "expected ResponseEnd 0002")
  }

  // Oversize pkt-line (> 65516 payload) must be rejected
  match encode_pkt_line(PktLine::Data(Bytes::new(65517))) {
    Err(GitError::InvalidPktLine(_)) => ()
    _ => debug_assert(false, "expected InvalidPktLine for > 65516 payload")
  }
  // Invalid length 0003 must be rejected
  match decode_pkt_line("0003".to_bytes(), 0) {
    Err(GitError::InvalidPktLine(_)) => ()
    _ => debug_assert(false, "expected InvalidPktLine for 0003")
  }
}

test "sideband_64k_demux" {
  let l1 = PktLine::Data(encode_sideband(SidebandMessage::Progress("Counting objects: 100%\n")))
  let l2 = PktLine::Data(encode_sideband(SidebandMessage::PackData("PACK_CHUNK_1".to_bytes())))
  let l3 = PktLine::Data(encode_sideband(SidebandMessage::PackData("PACK_CHUNK_2".to_bytes())))
  let l4 = PktLine::Data(encode_sideband(SidebandMessage::Error("fatal: bad ref\n")))
  let (pack, prog, errs) = match demux_sideband([l1, l2, l3, l4, PktLine::Flush]) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "demux_sideband failed: " + e.to_string())
      return
    }
  }
  debug_assert(pack.to_string() == "PACK_CHUNK_1PACK_CHUNK_2", "demuxed pack")
  debug_assert(prog.length() == 1 && prog[0] == "Counting objects: 100%\n", "progress")
  debug_assert(errs.length() == 1 && errs[0] == "fatal: bad ref\n", "error")
}

test "ref_advertisement_v1_v2_and_want_have" {
  let adv = RefAdvertisement::{
    refs: [
      RefAdvert::{
        oid: must_oid(fixture_head_oid),
        refname: "HEAD",
        symref_target: Some("refs/heads/main"),
        peeled: None,
      },
      RefAdvert::{
        oid: must_oid(fixture_head_oid),
        refname: "refs/heads/main",
        symref_target: None,
        peeled: None,
      },
      RefAdvert::{
        oid: must_oid(fixture_tag_oid),
        refname: "refs/tags/v0.1.0",
        symref_target: None,
        peeled: Some(must_oid(fixture_head_oid)),
      },
    ],
    capabilities: ["multi_ack_detailed", "side-band-64k", "ofs-delta", "symref=HEAD:refs/heads/main"],
  }
  let wire = match encode_ref_advertisement_v1(adv) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode_ref_advertisement_v1 failed: " + e.to_string())
      return
    }
  }
  let lines = match decode_pkt_lines(wire, GitLimits::default()) {
    Ok(ls) => ls
    Err(e) => {
      debug_assert(false, "decode_pkt_lines adv failed: " + e.to_string())
      return
    }
  }
  let parsed = match parse_ref_advertisement_v1(lines) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_ref_advertisement_v1 failed: " + e.to_string())
      return
    }
  }
  debug_assert(parsed.refs.length() == 3, "3 advertised refs")
  debug_assert(parsed.capabilities.length() == 4, "4 capabilities")
  match parsed.refs[2].peeled {
    Some(p) => debug_assert(p.to_hex() == fixture_head_oid, "peeled tag oid")
    None => debug_assert(false, "expected peeled oid")
  }

  // Protocol v2 ls-refs response
  let v2_lines = [
    PktLine::Data((fixture_head_oid + " HEAD symref-target:refs/heads/main\n").to_bytes()),
    PktLine::Data((fixture_tag_oid + " refs/tags/v0.1.0 peeled:" + fixture_head_oid + "\n").to_bytes()),
    PktLine::Flush,
  ]
  let v2_refs = match parse_ls_refs_v2(v2_lines) {
    Ok(rs) => rs
    Err(e) => {
      debug_assert(false, "parse_ls_refs_v2 failed: " + e.to_string())
      return
    }
  }
  debug_assert(v2_refs.length() == 2, "2 v2 refs")
  match v2_refs[0].symref_target {
    Some(st) => debug_assert(st == "refs/heads/main", "v2 symref-target")
    None => debug_assert(false, "expected v2 symref-target")
  }
  match v2_refs[1].peeled {
    Some(p) => debug_assert(p.to_hex() == fixture_head_oid, "v2 peeled")
    None => debug_assert(false, "expected v2 peeled")
  }

  // want / have negotiation
  let wh_wire = match encode_want_have(
    [must_oid(fixture_head_oid)],
    [must_oid(fixture_commit1_oid)],
    ["ofs-delta", "side-band-64k"],
    true,
  ) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "encode_want_have failed: " + e.to_string())
      return
    }
  }
  let wh_lines = match decode_pkt_lines(wh_wire, GitLimits::default()) {
    Ok(ls) => ls
    Err(e) => {
      debug_assert(false, "decode want_have failed: " + e.to_string())
      return
    }
  }
  let (wants, haves, caps, done) = match parse_want_have(wh_lines) {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "parse_want_have failed: " + e.to_string())
      return
    }
  }
  debug_assert(wants.length() == 1 && wants[0].to_hex() == fixture_head_oid, "want oid")
  debug_assert(haves.length() == 1 && haves[0].to_hex() == fixture_commit1_oid, "have oid")
  debug_assert(caps.length() == 2 && done, "caps and done")
}

test "check_ref_format_all_git_rules" {
  // Valid refs
  let valid = [
    "refs/heads/main",
    "refs/tags/v0.1.0-rc.1",
    "refs/remotes/origin/feat/pkg-git",
    "refs/heads/a.b/c_d",
  ]
  let mut i = 0
  while i < valid.length() {
    match check_ref_format(valid[i], false) {
      Ok(_) => ()
      Err(e) => debug_assert(false, "expected valid ref " + valid[i] + ": " + e.to_string())
    }
    i = i + 1
  }
  // One-level ref: rejected when allow_onelevel=false, accepted when true
  match check_ref_format("HEAD", false) {
    Err(GitError::InvalidRefName(_)) => ()
    _ => debug_assert(false, "expected one-level rejection")
  }
  match check_ref_format("HEAD", true) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "expected HEAD allowed with onelevel: " + e.to_string())
  }

  // Invalid refs per git-check-ref-format(1)
  let invalid = [
    "",
    "@",
    "refs/heads/.hidden",
    "refs/heads/foo.lock",
    "refs/heads/a..b",
    "refs/heads/a//b",
    "/refs/heads/main",
    "refs/heads/main/",
    "refs/heads/main.",
    "refs/heads/a@{b}",
    "refs/heads/a~1",
    "refs/heads/a^2",
    "refs/heads/a:b",
    "refs/heads/a?b",
    "refs/heads/a*b",
    "refs/heads/a[b",
    "refs/heads/a\\b",
    "refs/heads/a b",
  ]
  let mut j = 0
  while j < invalid.length() {
    match check_ref_format(invalid[j], true) {
      Err(GitError::InvalidRefName(_)) => ()
      Ok(_) => debug_assert(false, "expected invalid ref rejected: " + invalid[j])
      Err(_) => debug_assert(false, "expected InvalidRefName for: " + invalid[j])
    }
    j = j + 1
  }
}

// ============================================================================
// 7. Security & Limits Tests (Path Traversal, Bad Checksums, Negative Limits)
// ============================================================================

test "security_tree_rejects_traversal_and_dotgit" {
  let o = must_oid(fixture_blob_oid)
  let bad_names = ["..", ".", ".git", ".GIT", "a/b", ""]
  let mut i = 0
  while i < bad_names.length() {
    let payload = ("100644 " + bad_names[i]).to_bytes().concat(Bytes::new(1)).concat(o.raw_bytes())
    match Tree::parse(payload, HashKind::Sha1, GitLimits::default()) {
      Err(GitError::InsecurePath(_)) => ()
      Err(GitError::InvalidTree(_)) => ()
      _ => debug_assert(false, "expected tree entry rejected: " + bad_names[i])
    }
    i = i + 1
  }
}

test "security_limits_and_bad_checksums" {
  let neg = GitLimits::new(-1, 10, 10, 10, 10, 10)
  match neg.validate() {
    Err(GitError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits")
  }
  // Corrupt last byte of packfile -> ChecksumMismatch
  let mut bad_pack = hex_to_raw(fixture_pack_ofs_hex)
  let last = bad_pack.length() - 1
  bad_pack[last] = (bad_pack[last].to_int() ^ 0xFF).to_byte()
  match PackReader::open(bad_pack, GitLimits::default()) {
    Err(GitError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "expected ChecksumMismatch on corrupt packfile")
  }
  // Corrupt last byte of `.idx` -> ChecksumMismatch
  let mut bad_idx = hex_to_raw(fixture_pack_idx_hex)
  let ilast = bad_idx.length() - 1
  bad_idx[ilast] = (bad_idx[ilast].to_int() ^ 0xFF).to_byte()
  match PackIndex::parse(bad_idx, GitLimits::default()) {
    Err(GitError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "expected ChecksumMismatch on corrupt .idx")
  }
  // Corrupt last byte of `.git/index` -> ChecksumMismatch
  let mut bad_dirc = hex_to_raw(fixture_index_v2_hex)
  let dlast = bad_dirc.length() - 1
  bad_dirc[dlast] = (bad_dirc[dlast].to_int() ^ 0xFF).to_byte()
  match GitIndex::parse(bad_dirc, GitLimits::default()) {
    Err(GitError::ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "expected ChecksumMismatch on corrupt .git/index")
  }
}

// ============================================================================
// 8. Additional Edge Cases (64-bit .idx, Merge Commits, Truncation, Index Traversal)
// ============================================================================

test "pack_index_64bit_large_offsets_roundtrip" {
  let o1 = must_oid(fixture_blob_oid)
  let o2 = must_oid(fixture_head_oid)
  let pack_csum = must_oid(fixture_tree_oid)
  let big_off : Int64 = 5000000000L // > 2 GiB (triggers 64-bit offset table)
  let idx_bytes = match PackIndex::build([(o2, big_off, 0x12345678U), (o1, 12L, 0xABCDEF01U)], pack_csum) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "PackIndex::build 64-bit failed: " + e.to_string())
      return
    }
  }
  let idx = match PackIndex::parse(idx_bytes, GitLimits::default()) {
    Ok(i) => i
    Err(e) => {
      debug_assert(false, "PackIndex::parse 64-bit failed: " + e.to_string())
      return
    }
  }
  debug_assert(idx.len() == 2, "2 entries")
  match idx.lookup(o2) {
    Some((off, crc)) => {
      debug_assert(off == big_off, "64-bit offset preserved")
      debug_assert(crc == 0x12345678U, "crc preserved")
    }
    None => debug_assert(false, "o2 missing")
  }
  match idx.entry_at(0) {
    Some((o, off, crc)) => {
      debug_assert(o.equals(o1), "sorted entry 0 is o1")
      debug_assert(off == 12L && crc == 0xABCDEF01U, "entry 0 off/crc")
    }
    None => debug_assert(false, "entry_at(0) missing")
  }
}

test "merge_commit_and_empty_tree" {
  let empty_tree = Tree::{ entries: [] }
  let enc_tree = match empty_tree.encode() {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "empty tree encode: " + e.to_string())
      return
    }
  }
  // Empty tree SHA-1 is famously 4b825dc642cb6eb9a060e54bf8d69288fbee4904
  debug_assert(
    hash_object_sha1(ObjectKind::Tree, enc_tree).to_hex() ==
    "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
    "canonical empty tree sha1",
  )

  let sig = Signature::{
    name: "Merger",
    email: "m@example.com",
    timestamp: 1700001000L,
    tz_offset_minutes: 0,
    tz_raw: "+0000",
  }
  let merge = Commit::{
    tree: must_oid(fixture_tree_oid),
    parents: [must_oid(fixture_head_oid), must_oid(fixture_commit1_oid)],
    author: sig,
    committer: sig,
    encoding: None,
    extra_headers: [],
    message: "Merge branch 'feat'\n",
  }
  let enc = merge.encode()
  let parsed = match Commit::parse(enc, GitLimits::default()) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "parse merge commit: " + e.to_string())
      return
    }
  }
  debug_assert(parsed.parents.length() == 2, "2 parents")
  debug_assert(parsed.parents[1].to_hex() == fixture_commit1_oid, "second parent")
}

test "security_index_rejects_path_traversal_and_dotgit" {
  let bad_paths = ["../escape.txt", "a/../b", ".git/config", "sub/.GIT/hooks", "/abs/path", "dir//file"]
  let mut i = 0
  while i < bad_paths.length() {
    let e = IndexEntry::{
      ctime_sec: 0U,
      ctime_nsec: 0U,
      mtime_sec: 0U,
      mtime_nsec: 0U,
      dev: 0U,
      ino: 0U,
      mode: 0x81a4U,
      uid: 0U,
      gid: 0U,
      file_size: 0U,
      oid: must_oid(fixture_blob_oid),
      flags: 0U,
      extended_flags: 0U,
      path: bad_paths[i],
    }
    let idx = GitIndex::{
      version: 2,
      entries: [e],
      extensions: [],
      checksum: Oid::zero(HashKind::Sha1),
    }
    match idx.encode() {
      Err(GitError::InsecurePath(_)) => ()
      _ => debug_assert(false, "expected InsecurePath for: " + bad_paths[i])
    }
    i = i + 1
  }
}

test "security_truncated_varints_and_pack_limits" {
  // Truncated delta varint (MSB set at EOF)
  let mut trunc_delta = Bytes::new(1)
  trunc_delta[0] = 0x80.to_byte()
  match decode_delta_header(trunc_delta) {
    Err(GitError::Truncated(_)) => ()
    _ => debug_assert(false, "expected Truncated on delta varint")
  }
  // Pack exceeding max_pack_entries
  let tight_entries = GitLimits::new(65536, 5, 50, 65536, 100, 100)
  match PackReader::open(hex_to_raw(fixture_pack_ofs_hex), tight_entries) {
    Err(GitError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on max_pack_entries")
  }
  // Index exceeding max_index_entries
  let tight_idx = GitLimits::new(65536, 100, 50, 65536, 100, 2)
  match GitIndex::parse(hex_to_raw(fixture_index_v2_hex), tight_idx) {
    Err(GitError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on max_index_entries")
  }
}

test "security_redteam_regressions_pack_budget_and_dotgit" {
  // Aggregate pack total byte budget blocks amplification bombs
  let w = PackWriter::new()
  let base = Bytes::new(65536)
  let _ = w.add_object(ObjectKind::Blob, base)
  let _ = w.add_object(ObjectKind::Blob, base)
  let (pack_bytes, _) = match w.finish() {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "pack finish failed: " + e.to_string())
      return
    }
  }
  let tight_budget = GitLimits::default().with_max_pack_total_bytes(80000L)
  match PackReader::open(pack_bytes, tight_budget) {
    Err(GitError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on max_pack_total_bytes")
  }
  // NTFS/HFS+ .git aliases and symlinked .gitmodules rejected; backslash accepted
  let o = must_oid(fixture_blob_oid)
  let alias_tree = ("40000 GIT~1").to_bytes().concat(Bytes::new(1)).concat(o.raw_bytes())
  match Tree::parse(alias_tree, HashKind::Sha1, GitLimits::default()) {
    Err(GitError::InsecurePath(_)) => ()
    _ => debug_assert(false, "expected GIT~1 rejected")
  }
  let sym_tree = ("120000 .gitmodules").to_bytes().concat(Bytes::new(1)).concat(o.raw_bytes())
  match Tree::parse(sym_tree, HashKind::Sha1, GitLimits::default()) {
    Err(GitError::InsecurePath(_)) => ()
    _ => debug_assert(false, "expected symlink .gitmodules rejected")
  }
  let bs_tree = ("100644 a\\b").to_bytes().concat(Bytes::new(1)).concat(o.raw_bytes())
  match Tree::parse(bs_tree, HashKind::Sha1, GitLimits::default()) {
    Ok(t) => debug_assert(t.entries.length() == 1 && t.entries[0].name == "a\\b", "backslash ok")
    Err(e) => debug_assert(false, "expected backslash allowed: " + e.to_string())
  }
}
