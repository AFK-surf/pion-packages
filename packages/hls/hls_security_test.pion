///| Security, red-team, DoS limits, malformed input, and injection guard tests.

fn expect_err(res : Result[Playlist, HlsError], label : String) -> Unit {
  match res {
    Ok(_) => debug_assert(false, label + ": expected Err, got Ok")
    Err(_) => ()
  }
}

///|
test "security_missing_header_and_mixed_tags" {
  expect_err(parse_playlist(""), "empty input")
  expect_err(parse_playlist("#EXT-X-TARGETDURATION:6\n"), "missing #EXTM3U")
  expect_err(parse_playlist("#EXTM3U extra\n#EXT-X-TARGETDURATION:6\n"), "garbage on #EXTM3U")
  expect_err(parse_playlist("#EXTM3U\n"), "empty playlist with neither master nor media tags")

  // Mixed Master + Media tags must be rejected
  let mixed =
  "#EXTM3U\n" +
  "#EXT-X-TARGETDURATION:6\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1000000\n" +
  "v.m3u8\n"
  match parse_playlist(mixed) {
    Err(HlsError::MixedPlaylistTags(_)) => ()
    _ => debug_assert(false, "expected MixedPlaylistTags")
  }

  // Media playlist missing #EXT-X-TARGETDURATION
  let no_td = "#EXTM3U\n#EXTINF:6.0,\nseg0.ts\n"
  match parse_playlist(no_td) {
    Err(HlsError::MissingRequiredTag(_)) => ()
    _ => debug_assert(false, "expected MissingRequiredTag for target duration")
  }
}

///|
test "security_limits_negative_and_zero" {
  let valid_media = "#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6.0,\nseg0.ts\n"
  let valid_master = "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000\nv.m3u8\n"

  // Negative limit -> immediate LimitExceeded
  let neg = HlsLimits::{
    max_input_bytes: -1,
    max_lines: 100,
    max_segments: 100,
    max_variants: 100,
    max_attributes: 100,
    max_line_bytes: 1000,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(valid_media, neg) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_input_bytes must fail with LimitExceeded")
  }

  // Zero max_segments strictly rejects 1 segment
  let zero_seg = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 0,
    max_variants: 100,
    max_attributes: 100,
    max_line_bytes: 1000,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(valid_media, zero_seg) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_segments=0 must reject 1 segment")
  }

  // Zero max_variants strictly rejects 1 variant
  let zero_var = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 100,
    max_variants: 0,
    max_attributes: 100,
    max_line_bytes: 1000,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(valid_master, zero_var) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_variants=0 must reject 1 variant")
  }

  // Zero max_attributes strictly rejects tag with 1 attribute
  let zero_attr = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 100,
    max_variants: 100,
    max_attributes: 0,
    max_line_bytes: 1000,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(valid_master, zero_attr) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attributes=0 must reject 1 attribute")
  }

  // max_line_bytes enforced
  let tiny_line = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 100,
    max_variants: 100,
    max_attributes: 100,
    max_line_bytes: 10,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(valid_media, tiny_line) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_line_bytes=10 must reject long line")
  }
}

///|
test "security_malformed_numbers_iv_datetime_and_quotes" {
  // Negative / NaN / Inf duration
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:-1.0,\na.ts\n"), "negative duration")
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:NaN,\na.ts\n"), "NaN duration")
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:Inf,\na.ts\n"), "Inf duration")
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:0\n#EXTINF:1.0,\na.ts\n"), "zero target duration")

  // Unclosed quote in attribute list (must not hang or backtrack)
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000,CODECS=\"avc1.4d401f\nv.m3u8\n"),
    "unclosed quote",
  )

  // Duplicate attribute in same tag
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000,BANDWIDTH=2000\nv.m3u8\n"),
    "duplicate attribute",
  )

  // Invalid 128-bit IV (wrong length / bad hex)
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-KEY:METHOD=AES-128,URI=\"k\",IV=0x1234\n#EXTINF:6,\na.ts\n"),
    "short IV",
  )
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-KEY:METHOD=AES-128,URI=\"k\",IV=0xzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\n#EXTINF:6,\na.ts\n"),
    "non-hex IV",
  )

  // Invalid ISO-8601 date-time (non-leap year Feb 29, bad hour)
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-PROGRAM-DATE-TIME:2025-02-29T12:00:00Z\n#EXTINF:6,\na.ts\n"),
    "invalid leap day",
  )
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-PROGRAM-DATE-TIME:2026-11-24T25:00:00Z\n#EXTINF:6,\na.ts\n"),
    "hour 25",
  )

  // Implicit ByteRange without previous segment or with different URI
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6,\n#EXT-X-BYTERANGE:100\na.ts\n"),
    "implicit byterange on first segment",
  )
  expect_err(
    parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6,\n#EXT-X-BYTERANGE:100@0\na.ts\n#EXTINF:6,\n#EXT-X-BYTERANGE:100\nb.ts\n"),
    "implicit byterange on different URI",
  )

  // Dangling EXTINF / STREAM-INF without URI
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6,\n"), "dangling EXTINF")
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000\n"), "dangling STREAM-INF")
  // Missing comma on EXTINF
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6.0\na.ts\n"), "EXTINF missing comma")
  // Bare CR inside line
  expect_err(parse_playlist("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXTINF:6.0,\na\rb.ts\n"), "bare CR in URI")
  // Variable expansion DoS
  let expand_dos =
  "#EXTM3U\n" +
  "#EXT-X-DEFINE:NAME=\"a\",VALUE=\"01234567890123456789\"\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1000\n" +
  "{$a}{$a}{$a}{$a}\n"
  let tight_line = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 100,
    max_variants: 100,
    max_attributes: 100,
    max_line_bytes: 60,
    max_custom_tags: 100,
  }
  match parse_playlist_with_limits(expand_dos, tight_line) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "variable expansion DoS must hit LimitExceeded")
  }
  // Custom tag limit = 0
  let zero_custom = HlsLimits::{
    max_input_bytes: 10000,
    max_lines: 100,
    max_segments: 100,
    max_variants: 100,
    max_attributes: 100,
    max_line_bytes: 1000,
    max_custom_tags: 0,
  }
  match parse_playlist_with_limits("#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-CUSTOM:1\n#EXTINF:6,\na.ts\n", zero_custom) {
    Err(HlsError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_custom_tags=0 must reject custom tag")
  }
}

///|
test "security_formatter_crlf_and_quote_injection_guards" {
  // Attempt to inject a newline into a URI
  let bad_master = MasterPlaylist::{
    version: Some(7),
    independent_segments: false,
    start: None,
    defines: [],
    variants: [
      VariantStream::{
        uri: "ok.m3u8\n#EXT-X-STREAM-INF:BANDWIDTH=999\nevil.m3u8",
        bandwidth: 1000L,
        average_bandwidth: None,
        codecs: None,
        resolution: None,
        frame_rate_mhz: None,
        hdcp_level: None,
        audio: None,
        video: None,
        subtitles: None,
        closed_captions: None,
        score_micros: None,
        pathway_id: None,
      },
    ],
    iframe_streams: [],
    media: [],
    session_data: [],
    session_keys: [],
    custom_tags: [],
  }
  match format_master_playlist(bad_master) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "formatter must reject CRLF injection in URI")
  }

  // Attempt to inject a double-quote into a quoted attribute
  let bad_quote = MasterPlaylist::{
    version: None,
    independent_segments: false,
    start: None,
    defines: [],
    variants: [
      VariantStream::{
        uri: "ok.m3u8",
        bandwidth: 1000L,
        average_bandwidth: None,
        codecs: Some("avc1\",BANDWIDTH=999999,X=\""),
        resolution: None,
        frame_rate_mhz: None,
        hdcp_level: None,
        audio: None,
        video: None,
        subtitles: None,
        closed_captions: None,
        score_micros: None,
        pathway_id: None,
      },
    ],
    iframe_streams: [],
    media: [],
    session_data: [],
    session_keys: [],
    custom_tags: [],
  }
  match format_master_playlist(bad_quote) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "formatter must reject quote injection in attribute")
  }
}
