///| LL-HLS (Low-Latency HLS) tags tests.

///|
test "llhls_full_media_playlist" {
  let m3u8 =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:9\n" +
  "#EXT-X-TARGETDURATION:4\n" +
  "#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=24.0,CAN-SKIP-DATERANGES=YES,HOLD-BACK=12.0,PART-HOLD-BACK=1.002,CAN-BLOCK-RELOAD=YES\n" +
  "#EXT-X-PART-INF:PART-TARGET=0.334\n" +
  "#EXT-X-MEDIA-SEQUENCE:500\n" +
  "#EXT-X-SKIP:SKIPPED-SEGMENTS=10,RECENTLY-REMOVED-DATERANGES=\"ad-0\"\n" +
  "#EXT-X-MAP:URI=\"init.m4s\"\n" +
  "#EXT-X-PART:DURATION=0.334,URI=\"seg500.0.m4s\",INDEPENDENT=YES\n" +
  "#EXT-X-PART:DURATION=0.333,URI=\"seg500.1.m4s\",BYTERANGE=\"4096@0\"\n" +
  "#EXTINF:4.000,\n" +
  "seg500.m4s\n" +
  "#EXT-X-PART:DURATION=0.334,URI=\"seg501.0.m4s\",INDEPENDENT=YES\n" +
  "#EXT-X-PART:DURATION=0.333,URI=\"seg501.1.m4s\",GAP=YES\n" +
  "#EXT-X-PRELOAD-HINT:TYPE=PART,URI=\"seg501.2.m4s\",BYTERANGE-START=0,BYTERANGE-LENGTH=2048\n" +
  "#EXT-X-RENDITION-REPORT:URI=\"../720p/index.m3u8\",LAST-MSN=501,LAST-PART=1\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Media(m)) => {
      match m.server_control {
        Some(sc) => {
          assert_opt_i64(sc.can_skip_until_us, 24000000L, "can_skip_until")
          debug_assert(sc.can_skip_dateranges, "can_skip_dateranges")
          assert_opt_i64(sc.hold_back_us, 12000000L, "hold_back")
          assert_opt_i64(sc.part_hold_back_us, 1002000L, "part_hold_back")
          debug_assert(sc.can_block_reload, "can_block_reload")
        }
        None => debug_assert(false, "missing server_control")
      }
      match m.part_inf {
        Some(pi) => debug_assert(pi.part_target_us == 334000L, "part_target_us")
        None => debug_assert(false, "missing part_inf")
      }
      match m.skip {
        Some(sk) => {
          debug_assert(sk.skipped_segments == 10L, "skipped_segments")
          assert_opt_str(sk.recently_removed_dateranges, "ad-0", "removed dr")
        }
        None => debug_assert(false, "missing skip")
      }
      debug_assert(m.segments.length() == 1, "1 full segment")
      debug_assert(m.segments[0].parts.length() == 2, "2 parts on seg 0")
      debug_assert(m.segments[0].parts[0].independent, "part 0 independent")
      match m.segments[0].parts[1].byterange {
        Some(br) => {
          debug_assert(br.length == 4096L, "part 1 br len")
          assert_opt_i64(br.offset, 0L, "part 1 br off")
        }
        None => debug_assert(false, "part 1 missing br")
      }
      debug_assert(m.trailing_parts.length() == 2, "2 trailing parts")
      debug_assert(m.trailing_parts[1].gap, "trailing part 1 gap")
      debug_assert(m.preload_hints.length() == 1, "1 preload hint")
      debug_assert(m.preload_hints[0].uri == "seg501.2.m4s", "preload hint uri")
      assert_opt_i64(m.preload_hints[0].byterange_start, 0L, "preload start")
      assert_opt_i64(m.preload_hints[0].byterange_length, 2048L, "preload len")
      debug_assert(m.rendition_reports.length() == 1, "1 rendition report")
      assert_opt_i64(m.rendition_reports[0].last_msn, 501L, "last_msn")
      assert_opt_i64(m.rendition_reports[0].last_part, 1L, "last_part")
    }
    Ok(Playlist::Master(_)) => debug_assert(false, "expected Media")
    Err(e) => debug_assert(false, "LL-HLS parse failed: " + hls_error_to_string(e))
  }
}
