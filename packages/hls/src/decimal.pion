///| Exact integer decimal parsing, ISO-8601 validation, and deterministic formatting.
///| Zero `Double::to_string` usage — 100% bit-identical across Native and Wasm32.

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn slice_eq(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn slice_eq_range(
  s : String,
  s1 : Int,
  e1 : Int,
  s2 : Int,
  e2 : Int,
) -> Bool {
  let n = e1 - s1
  if e2 - s2 != n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(s1 + i) != s.code_unit_at(s2 + i) {
      return false
    }
    i = i + 1
  }
  true
}

fn slice_starts_with(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start < n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn find_byte_in(s : String, start : Int, end : Int, needle : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == needle {
      return i
    }
    i = i + 1
  }
  -1
}

///| Zero-allocation non-negative base-10 `Int64` parser.
///| Returns `>= 0L` on success, `-1L` on empty/invalid digit, `-2L` on overflow.
fn parse_uint64_raw(s : String, start : Int, end : Int) -> Int64 {
  let len = end - start
  if len <= 0 {
    return -1L
  }
  let mut acc = 0L
  let mut i = start
  if len <= 18 {
    while i < end {
      let d = s.code_unit_at(i) - 48
      if d < 0 || d > 9 {
        return -1L
      }
      acc = acc * 10L + d.to_int64()
      i = i + 1
    }
    return acc
  }
  let max_div10 = 922337203685477580L
  while i < end {
    let d = s.code_unit_at(i) - 48
    if d < 0 || d > 9 {
      return -1L
    }
    let d64 = d.to_int64()
    if acc > max_div10 || (acc == max_div10 && d64 > 7L) {
      return -2L
    }
    acc = acc * 10L + d64
    i = i + 1
  }
  acc
}

///| Parse a non-negative base-10 `Int64` from `s[start..end]` with overflow check.
fn parse_uint64_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[Int64, HlsError] {
  let v = parse_uint64_raw(s, start, end)
  if v >= 0L {
    Ok(v)
  } else if v == -2L {
    Err(HlsError::InvalidNumber("integer overflow"))
  } else if start >= end {
    Err(HlsError::InvalidNumber("empty integer"))
  } else {
    Err(HlsError::InvalidNumber("invalid digit in integer"))
  }
}

///| Zero-allocation specialized parser for non-negative seconds as exact integer microseconds (`10^6`).
///| Returns `>= 0L` on success, `-1L` on invalid syntax or overflow.
fn parse_us_raw(s : String, start : Int, end : Int) -> Int64 {
  if start >= end {
    return -1L
  }
  let mut i = start
  let d0 = s.code_unit_at(i) - 48
  if d0 < 0 || d0 > 9 {
    return -1L
  }
  let mut whole = d0.to_int64()
  i = i + 1
  while i < end {
    let d = s.code_unit_at(i) - 48
    if d >= 0 && d <= 9 {
      if whole >= 922337203685L {
        if whole > 922337203685L || d > 4 {
          return -1L
        }
      }
      whole = whole * 10L + d.to_int64()
      i = i + 1
    } else {
      break
    }
  }

  let mut frac = 0L
  let mut round_up = false
  if i < end {
    if s.code_unit_at(i) != 46 {
      return -1L
    }
    i = i + 1
    if i >= end {
      return -1L
    }
    let fd0 = s.code_unit_at(i) - 48
    if fd0 < 0 || fd0 > 9 {
      return -1L
    }
    frac = fd0.to_int64()
    let mut frac_digits = 1
    i = i + 1
    while i < end {
      let d = s.code_unit_at(i) - 48
      if d < 0 || d > 9 {
        return -1L
      }
      if frac_digits < 6 {
        frac = frac * 10L + d.to_int64()
        frac_digits = frac_digits + 1
      } else if frac_digits == 6 {
        if d >= 5 {
          round_up = true
        }
        frac_digits = 7
      }
      i = i + 1
    }
    if frac_digits == 1 {
      frac = frac * 100000L
    } else if frac_digits == 2 {
      frac = frac * 10000L
    } else if frac_digits == 3 {
      frac = frac * 1000L
    } else if frac_digits == 4 {
      frac = frac * 100L
    } else if frac_digits == 5 {
      frac = frac * 10L
    }
  }

  let whole_scaled = whole * 1000000L
  let frac_with_round = if round_up { frac + 1L } else { frac }
  if whole_scaled > 9223372036854775807L - frac_with_round {
    return -1L
  }
  whole_scaled + frac_with_round
}

///| Zero-allocation specialized parser for non-negative frame rate as exact integer milli-Hz (`10^3`).
///| Returns `>= 0L` on success, `-1L` on invalid syntax or overflow.
fn parse_mhz_raw(s : String, start : Int, end : Int) -> Int64 {
  if start >= end {
    return -1L
  }
  let mut i = start
  let d0 = s.code_unit_at(i) - 48
  if d0 < 0 || d0 > 9 {
    return -1L
  }
  let mut whole = d0.to_int64()
  i = i + 1
  while i < end {
    let d = s.code_unit_at(i) - 48
    if d >= 0 && d <= 9 {
      if whole >= 922337203685477L {
        if whole > 922337203685477L || d > 5 {
          return -1L
        }
      }
      whole = whole * 10L + d.to_int64()
      i = i + 1
    } else {
      break
    }
  }

  let mut frac = 0L
  let mut round_up = false
  if i < end {
    if s.code_unit_at(i) != 46 {
      return -1L
    }
    i = i + 1
    if i >= end {
      return -1L
    }
    let fd0 = s.code_unit_at(i) - 48
    if fd0 < 0 || fd0 > 9 {
      return -1L
    }
    frac = fd0.to_int64()
    let mut frac_digits = 1
    i = i + 1
    while i < end {
      let d = s.code_unit_at(i) - 48
      if d < 0 || d > 9 {
        return -1L
      }
      if frac_digits < 3 {
        frac = frac * 10L + d.to_int64()
        frac_digits = frac_digits + 1
      } else if frac_digits == 3 {
        if d >= 5 {
          round_up = true
        }
        frac_digits = 4
      }
      i = i + 1
    }
    if frac_digits == 1 {
      frac = frac * 100L
    } else if frac_digits == 2 {
      frac = frac * 10L
    }
  }

  let whole_scaled = whole * 1000L
  let frac_with_round = if round_up { frac + 1L } else { frac }
  if whole_scaled > 9223372036854775807L - frac_with_round {
    return -1L
  }
  whole_scaled + frac_with_round
}

///| Write a non-negative `Int64` directly to a `StringBuilder` without intermediate `String` allocation.
fn write_u64(sb : StringBuilder, value : Int64) -> Unit {
  if value < 10L {
    sb.write_byte((48 + value.to_int()).to_byte())
    return
  }
  if value < 100L {
    let v = value.to_int()
    sb.write_byte((48 + v / 10).to_byte())
    sb.write_byte((48 + v % 10).to_byte())
    return
  }
  sb.write_string(value.to_string())
}

///| Deterministically write a scaled `Int64` value directly to `StringBuilder`.
///| Safe for all `Int64` values including `Int64::MIN` (no `-Int64::MIN` overflow).
fn write_scaled(
  sb : StringBuilder,
  value : Int64,
  scale_digits : Int,
  trim_trailing : Bool,
) -> Unit {
  let scale = if scale_digits == 6 {
    1000000L
  } else if scale_digits == 3 {
    1000L
  } else {
    let mut s = 1L
    let mut k = 0
    while k < scale_digits {
      s = s * 10L
      k = k + 1
    }
    s
  }
  let neg = value < 0L
  let raw_whole = value / scale
  let raw_frac = value % scale
  let whole = if raw_whole < 0L { -raw_whole } else { raw_whole }
  let frac = if raw_frac < 0L { -raw_frac } else { raw_frac }

  if neg {
    sb.write_byte((45).to_byte())
  }
  write_u64(sb, whole)

  if trim_trailing && frac == 0L {
    return
  }

  let f = frac.to_int()
  if scale_digits == 6 {
    let d0 = f / 100000
    let r0 = f - d0 * 100000
    let d1 = r0 / 10000
    let r1 = r0 - d1 * 10000
    let d2 = r1 / 1000
    let r2 = r1 - d2 * 1000
    let d3 = r2 / 100
    let r3 = r2 - d3 * 100
    let d4 = r3 / 10
    let d5 = r3 - d4 * 10
    let end_idx = if !trim_trailing {
      6
    } else if d5 != 0 {
      6
    } else if d4 != 0 {
      5
    } else if d3 != 0 {
      4
    } else if d2 != 0 {
      3
    } else if d1 != 0 {
      2
    } else if d0 != 0 {
      1
    } else {
      0
    }
    if end_idx > 0 {
      sb.write_byte((46).to_byte())
      sb.write_byte((48 + d0).to_byte())
      if end_idx > 1 {
        sb.write_byte((48 + d1).to_byte())
        if end_idx > 2 {
          sb.write_byte((48 + d2).to_byte())
          if end_idx > 3 {
            sb.write_byte((48 + d3).to_byte())
            if end_idx > 4 {
              sb.write_byte((48 + d4).to_byte())
              if end_idx > 5 {
                sb.write_byte((48 + d5).to_byte())
              }
            }
          }
        }
      }
    }
    return
  }

  if scale_digits == 3 {
    let d0 = f / 100
    let r0 = f - d0 * 100
    let d1 = r0 / 10
    let d2 = r0 - d1 * 10
    let end_idx = if !trim_trailing {
      3
    } else if d2 != 0 {
      3
    } else if d1 != 0 {
      2
    } else if d0 != 0 {
      1
    } else {
      0
    }
    if end_idx > 0 {
      sb.write_byte((46).to_byte())
      sb.write_byte((48 + d0).to_byte())
      if end_idx > 1 {
        sb.write_byte((48 + d1).to_byte())
        if end_idx > 2 {
          sb.write_byte((48 + d2).to_byte())
        }
      }
    }
    return
  }

  let digits = FixedArray::make(scale_digits, 48)
  let mut rem = frac
  let mut idx = scale_digits - 1
  while idx >= 0 {
    digits[idx] = 48 + (rem % 10L).to_int()
    rem = rem / 10L
    idx = idx - 1
  }
  let mut end_idx = scale_digits
  if trim_trailing {
    while end_idx > 0 && digits[end_idx - 1] == 48 {
      end_idx = end_idx - 1
    }
  }
  if end_idx > 0 {
    sb.write_byte((46).to_byte())
    let mut j = 0
    while j < end_idx {
      sb.write_byte(digits[j].to_byte())
      j = j + 1
    }
  }
}

///| Write exact microseconds directly to `StringBuilder`.
fn write_us(sb : StringBuilder, us : Int64) -> Unit {
  write_scaled(sb, us, 6, true)
}

///| Write exact milli-Hz as 3-decimal-place frame rate directly to `StringBuilder`.
fn write_mhz(sb : StringBuilder, mhz : Int64) -> Unit {
  write_scaled(sb, mhz, 3, false)
}

///| Format exact microseconds as canonical decimal seconds (trailing zeros trimmed).
fn format_us(us : Int64) -> String {
  let sb = StringBuilder::with_capacity(24)
  write_us(sb, us)
  sb.to_string()
}

///| Format exact milli-Hz as 3-decimal-place frame rate (e.g. `29.970`).
fn format_mhz(mhz : Int64) -> String {
  let sb = StringBuilder::with_capacity(16)
  write_mhz(sb, mhz)
  sb.to_string()
}

fn days_in_month(year : Int, month : Int) -> Int {
  match month {
    1 => 31
    2 => {
      let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
      if leap { 29 } else { 28 }
    }
    3 => 31
    4 => 30
    5 => 31
    6 => 30
    7 => 31
    8 => 31
    9 => 30
    10 => 31
    11 => 30
    12 => 31
    _ => 0
  }
}

///| Zero-allocation strict ISO-8601 date-time validator returning `Bool`.
///| Format: `YYYY-MM-DDTHH:MM:SS(.frac)?(Z|[+-]HH:MM|[+-]HHMM|[+-]HH)?`.
fn validate_iso8601_ok(s : String, start : Int, end : Int) -> Bool {
  if end - start < 19 {
    return false
  }
  let y0 = s.code_unit_at(start) - 48
  let y1 = s.code_unit_at(start + 1) - 48
  let y2 = s.code_unit_at(start + 2) - 48
  let y3 = s.code_unit_at(start + 3) - 48
  if (y0 | y1 | y2 | y3) < 0 || y0 > 9 || y1 > 9 || y2 > 9 || y3 > 9 {
    return false
  }
  let year = y0 * 1000 + y1 * 100 + y2 * 10 + y3

  if s.code_unit_at(start + 4) != 45 {
    return false
  }
  let m0 = s.code_unit_at(start + 5) - 48
  let m1 = s.code_unit_at(start + 6) - 48
  if (m0 | m1) < 0 || m0 > 9 || m1 > 9 {
    return false
  }
  let month = m0 * 10 + m1
  if month < 1 || month > 12 {
    return false
  }

  if s.code_unit_at(start + 7) != 45 {
    return false
  }
  let d0 = s.code_unit_at(start + 8) - 48
  let d1 = s.code_unit_at(start + 9) - 48
  if (d0 | d1) < 0 || d0 > 9 || d1 > 9 {
    return false
  }
  let day = d0 * 10 + d1
  if day < 1 || day > days_in_month(year, month) {
    return false
  }

  let sep = s.code_unit_at(start + 10)
  if sep != 84 && sep != 116 {
    return false
  }

  let h0 = s.code_unit_at(start + 11) - 48
  let h1 = s.code_unit_at(start + 12) - 48
  if (h0 | h1) < 0 || h0 > 9 || h1 > 9 || h0 * 10 + h1 > 23 {
    return false
  }

  if s.code_unit_at(start + 13) != 58 {
    return false
  }
  let mi0 = s.code_unit_at(start + 14) - 48
  let mi1 = s.code_unit_at(start + 15) - 48
  if (mi0 | mi1) < 0 || mi0 > 9 || mi1 > 9 || mi0 * 10 + mi1 > 59 {
    return false
  }

  if s.code_unit_at(start + 16) != 58 {
    return false
  }
  let s0 = s.code_unit_at(start + 17) - 48
  let s1 = s.code_unit_at(start + 18) - 48
  if (s0 | s1) < 0 || s0 > 9 || s1 > 9 || s0 * 10 + s1 > 60 {
    return false
  }

  let mut i = start + 19
  if i < end && s.code_unit_at(i) == 46 {
    i = i + 1
    let frac_start = i
    while i < end {
      let d = s.code_unit_at(i) - 48
      if d < 0 || d > 9 {
        break
      }
      i = i + 1
    }
    if i == frac_start {
      return false
    }
  }

  if i >= end {
    return true
  }
  let tz = s.code_unit_at(i)
  if tz == 90 || tz == 122 {
    return i + 1 == end
  }
  if tz == 43 || tz == 45 {
    let rem = end - i
    if rem == 6 {
      let th0 = s.code_unit_at(i + 1) - 48
      let th1 = s.code_unit_at(i + 2) - 48
      if (th0 | th1) < 0 || th0 > 9 || th1 > 9 || s.code_unit_at(i + 3) != 58 {
        return false
      }
      let tm0 = s.code_unit_at(i + 4) - 48
      let tm1 = s.code_unit_at(i + 5) - 48
      if (tm0 | tm1) < 0 || tm0 > 9 || tm1 > 9 {
        return false
      }
      return th0 * 10 + th1 <= 23 && tm0 * 10 + tm1 <= 59
    } else if rem == 5 {
      let th0 = s.code_unit_at(i + 1) - 48
      let th1 = s.code_unit_at(i + 2) - 48
      let tm0 = s.code_unit_at(i + 3) - 48
      let tm1 = s.code_unit_at(i + 4) - 48
      if (th0 | th1 | tm0 | tm1) < 0 || th0 > 9 || th1 > 9 || tm0 > 9 || tm1 > 9 {
        return false
      }
      return th0 * 10 + th1 <= 23 && tm0 * 10 + tm1 <= 59
    } else if rem == 3 {
      let th0 = s.code_unit_at(i + 1) - 48
      let th1 = s.code_unit_at(i + 2) - 48
      if (th0 | th1) < 0 || th0 > 9 || th1 > 9 {
        return false
      }
      return th0 * 10 + th1 <= 23
    }
    return false
  }
  false
}

///| Strict ISO-8601 date-time validation returning `Result`.
fn validate_iso8601(s : String) -> Result[Unit, HlsError] {
  if validate_iso8601_ok(s, 0, s.length()) {
    Ok(())
  } else {
    Err(HlsError::InvalidDateTime("invalid ISO-8601 date-time"))
  }
}
