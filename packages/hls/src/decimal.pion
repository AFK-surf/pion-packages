///| Exact integer decimal parsing, ISO-8601 validation, and deterministic formatting.
///| Zero `Double::to_string` usage — 100% bit-identical across Native and Wasm32.

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_hex_digit(b : Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn slice_eq(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start != n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn slice_starts_with(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = lit.length()
  if end - start < n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn find_byte_in(s : String, start : Int, end : Int, needle : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == needle {
      return i
    }
    i = i + 1
  }
  -1
}

///| Parse a non-negative base-10 `Int64` from `s[start..end]` with overflow check.
fn parse_uint64_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[Int64, HlsError] {
  if start >= end {
    return Err(HlsError::InvalidNumber("empty integer"))
  }
  let max_div10 = 922337203685477580L
  let mut acc = 0L
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if !is_ascii_digit(b) {
      return Err(HlsError::InvalidNumber("invalid digit in integer"))
    }
    let d = (b - 48).to_int64()
    if acc > max_div10 || (acc == max_div10 && d > 7L) {
      return Err(HlsError::InvalidNumber("integer overflow"))
    }
    acc = acc * 10L + d
    i = i + 1
  }
  Ok(acc)
}

///| Parse a decimal number scaled by `10^scale_digits` into an exact `Int64`.
///| Rejects NaN, Inf, scientific notation, and negative values unless `allow_negative` is true.
fn parse_decimal_scaled(
  s : String,
  start : Int,
  end : Int,
  scale_digits : Int,
  allow_negative : Bool,
) -> Result[Int64, HlsError] {
  if start >= end {
    return Err(HlsError::InvalidNumber("empty decimal"))
  }
  let mut i = start
  let mut neg = false
  let first = s.code_unit_at(i)
  if first == 45 {
    if !allow_negative {
      return Err(HlsError::InvalidNumber("negative decimal not allowed"))
    }
    neg = true
    i = i + 1
  } else if first == 43 {
    return Err(HlsError::InvalidNumber("leading '+' not allowed"))
  }
  if i >= end || !is_ascii_digit(s.code_unit_at(i)) {
    return Err(HlsError::InvalidNumber("expected digit in decimal"))
  }

  let mut scale = 1L
  let mut k = 0
  while k < scale_digits {
    scale = scale * 10L
    k = k + 1
  }

  let max_whole = 9223372036854775807L / scale
  let mut whole = 0L
  while i < end && is_ascii_digit(s.code_unit_at(i)) {
    let d = (s.code_unit_at(i) - 48).to_int64()
    if whole > max_whole / 10L ||
    (whole == max_whole / 10L && d > max_whole % 10L) {
      return Err(HlsError::InvalidNumber("decimal overflow"))
    }
    whole = whole * 10L + d
    i = i + 1
  }

  let mut frac = 0L
  let mut frac_digits = 0
  let mut round_up = false
  if i < end {
    if s.code_unit_at(i) != 46 {
      return Err(HlsError::InvalidNumber("unexpected character in decimal"))
    }
    i = i + 1
    if i >= end || !is_ascii_digit(s.code_unit_at(i)) {
      return Err(HlsError::InvalidNumber("expected digit after decimal point"))
    }
    while i < end {
      let b = s.code_unit_at(i)
      if !is_ascii_digit(b) {
        return Err(HlsError::InvalidNumber("invalid fractional digit"))
      }
      let d = (b - 48).to_int64()
      if frac_digits < scale_digits {
        frac = frac * 10L + d
        frac_digits = frac_digits + 1
      } else if frac_digits == scale_digits {
        if d >= 5L {
          round_up = true
        }
        frac_digits = frac_digits + 1
      }
      i = i + 1
    }
  }

  while frac_digits < scale_digits {
    frac = frac * 10L
    frac_digits = frac_digits + 1
  }

  let mut total = whole * scale + frac
  if round_up {
    if total == 9223372036854775807L {
      return Err(HlsError::InvalidNumber("decimal rounding overflow"))
    }
    total = total + 1L
  }
  if neg {
    Ok(-total)
  } else {
    Ok(total)
  }
}

///| Parse non-negative seconds as exact integer microseconds (`10^6`).
fn parse_us(s : String, start : Int, end : Int) -> Result[Int64, HlsError] {
  parse_decimal_scaled(s, start, end, 6, false)
}

///| Parse signed seconds as exact integer microseconds (`10^6`).
fn parse_signed_us(
  s : String,
  start : Int,
  end : Int,
) -> Result[Int64, HlsError] {
  parse_decimal_scaled(s, start, end, 6, true)
}

///| Parse non-negative frame rate as exact integer milli-Hz (`10^3`).
fn parse_mhz(s : String, start : Int, end : Int) -> Result[Int64, HlsError] {
  parse_decimal_scaled(s, start, end, 3, false)
}

///| Deterministically format a scaled `Int64` value with `scale_digits` fractional places.
///| Safe for all `Int64` values including `Int64::MIN` (no `-Int64::MIN` overflow).
fn format_scaled(
  value : Int64,
  scale_digits : Int,
  trim_trailing : Bool,
) -> String {
  let mut scale = 1L
  let mut k = 0
  while k < scale_digits {
    scale = scale * 10L
    k = k + 1
  }
  let neg = value < 0L
  let raw_whole = value / scale
  let raw_frac = value % scale
  let whole = if raw_whole < 0L { -raw_whole } else { raw_whole }
  let frac = if raw_frac < 0L { -raw_frac } else { raw_frac }

  let sb = StringBuilder::new()
  if neg {
    sb.write_string("-")
  }
  sb.write_string(whole.to_string())

  if trim_trailing && frac == 0L {
    return sb.to_string()
  }

  // Build fixed-width fractional digits
  let digits = FixedArray::make(scale_digits, 48)
  let mut rem = frac
  let mut idx = scale_digits - 1
  while idx >= 0 {
    digits[idx] = 48 + (rem % 10L).to_int()
    rem = rem / 10L
    idx = idx - 1
  }

  let mut end_idx = scale_digits
  if trim_trailing {
    while end_idx > 0 && digits[end_idx - 1] == 48 {
      end_idx = end_idx - 1
    }
  }
  if end_idx > 0 {
    sb.write_string(".")
    let mut j = 0
    while j < end_idx {
      sb.write_byte(digits[j].to_byte())
      j = j + 1
    }
  }
  sb.to_string()
}

///| Format exact microseconds as canonical decimal seconds (trailing zeros trimmed).
fn format_us(us : Int64) -> String {
  format_scaled(us, 6, true)
}

///| Format exact milli-Hz as 3-decimal-place frame rate (e.g. `29.970`).
fn format_mhz(mhz : Int64) -> String {
  format_scaled(mhz, 3, false)
}

fn parse_fixed_digits(s : String, start : Int, count : Int) -> Option[Int] {
  if start + count > s.length() {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < count {
    let b = s.code_unit_at(start + i)
    if !is_ascii_digit(b) {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

fn days_in_month(year : Int, month : Int) -> Int {
  match month {
    1 => 31
    2 => {
      let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
      if leap { 29 } else { 28 }
    }
    3 => 31
    4 => 30
    5 => 31
    6 => 30
    7 => 31
    8 => 31
    9 => 30
    10 => 31
    11 => 30
    12 => 31
    _ => 0
  }
}

///| Strict ISO-8601 / RFC 3339 date-time validation (`YYYY-MM-DDTHH:MM:SS(.frac)?(Z|[+-]HH:MM)`).
fn validate_iso8601(s : String) -> Result[Unit, HlsError] {
  let n = s.length()
  if n < 20 {
    return Err(HlsError::InvalidDateTime("ISO-8601 date-time too short"))
  }
  let year = match parse_fixed_digits(s, 0, 4) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid year"))
  }
  if s.code_unit_at(4) != 45 {
    return Err(HlsError::InvalidDateTime("expected '-' after year"))
  }
  let month = match parse_fixed_digits(s, 5, 2) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid month"))
  }
  if month < 1 || month > 12 {
    return Err(HlsError::InvalidDateTime("month out of range"))
  }
  if s.code_unit_at(7) != 45 {
    return Err(HlsError::InvalidDateTime("expected '-' after month"))
  }
  let day = match parse_fixed_digits(s, 8, 2) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid day"))
  }
  let max_day = days_in_month(year, month)
  if day < 1 || day > max_day {
    return Err(HlsError::InvalidDateTime("day out of range for month"))
  }
  let sep = s.code_unit_at(10)
  if sep != 84 && sep != 116 {
    return Err(HlsError::InvalidDateTime("expected 'T' separator"))
  }
  let hour = match parse_fixed_digits(s, 11, 2) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid hour"))
  }
  if hour > 23 {
    return Err(HlsError::InvalidDateTime("hour out of range"))
  }
  if s.code_unit_at(13) != 58 {
    return Err(HlsError::InvalidDateTime("expected ':' after hour"))
  }
  let minute = match parse_fixed_digits(s, 14, 2) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid minute"))
  }
  if minute > 59 {
    return Err(HlsError::InvalidDateTime("minute out of range"))
  }
  if s.code_unit_at(16) != 58 {
    return Err(HlsError::InvalidDateTime("expected ':' after minute"))
  }
  let second = match parse_fixed_digits(s, 17, 2) {
    Some(v) => v
    None => return Err(HlsError::InvalidDateTime("invalid second"))
  }
  if second > 60 {
    return Err(HlsError::InvalidDateTime("second out of range"))
  }

  let mut i = 19
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let frac_start = i
    while i < n && is_ascii_digit(s.code_unit_at(i)) {
      i = i + 1
    }
    if i == frac_start {
      return Err(HlsError::InvalidDateTime("empty fractional seconds"))
    }
  }

  if i >= n {
    return Err(HlsError::InvalidDateTime("missing timezone designator"))
  }
  let tz = s.code_unit_at(i)
  if tz == 90 || tz == 122 {
    if i + 1 != n {
      return Err(HlsError::InvalidDateTime("trailing characters after Z"))
    }
    return Ok(())
  }
  if tz == 43 || tz == 45 {
    if i + 6 != n {
      return Err(HlsError::InvalidDateTime("invalid timezone offset length"))
    }
    let tz_h = match parse_fixed_digits(s, i + 1, 2) {
      Some(v) => v
      None => return Err(HlsError::InvalidDateTime("invalid timezone hour"))
    }
    if s.code_unit_at(i + 3) != 58 {
      return Err(HlsError::InvalidDateTime("expected ':' in timezone offset"))
    }
    let tz_m = match parse_fixed_digits(s, i + 4, 2) {
      Some(v) => v
      None => return Err(HlsError::InvalidDateTime("invalid timezone minute"))
    }
    if tz_h > 23 || tz_m > 59 {
      return Err(HlsError::InvalidDateTime("timezone offset out of range"))
    }
    return Ok(())
  }
  Err(HlsError::InvalidDateTime("invalid timezone designator"))
}
