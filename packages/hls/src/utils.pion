///| Helper utilities (ABR variant selection, timeline resolution) and deterministic formatter.

///| Check if a string contains control characters (CR/LF/NUL/ASCII ctrl/C1 ctrl).
fn check_no_crlf(s : String, field : String) -> Result[Unit, HlsError] {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b <= 8 || (b >= 10 && b <= 31) || b == 127 {
      return Err(HlsError::InvalidSyntax("control character not allowed in " + field))
    }
    if b == 194 && i + 1 < n {
      let next = s.code_unit_at(i + 1)
      if next >= 128 && next <= 159 {
        return Err(HlsError::InvalidSyntax("C1 control character not allowed in " + field))
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Check if a URI line is valid for emission (non-empty, does not start with `#`, no ctrl, no var ref).
fn check_uri_line_safe(s : String, field : String) -> Result[Unit, HlsError] {
  let n = s.length()
  if n == 0 {
    return Err(HlsError::InvalidSyntax("empty " + field))
  }
  if s.code_unit_at(0) == 35 {
    return Err(HlsError::InvalidSyntax(field + " must not start with '#'"))
  }
  let mut has_lbrace = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 32 && b < 123 {
      i = i + 1
    } else if b == 123 {
      has_lbrace = true
      i = i + 1
    } else if b > 123 && b != 127 {
      if b == 194 && i + 1 < n {
        let next = s.code_unit_at(i + 1)
        if next >= 128 && next <= 159 {
          return Err(HlsError::InvalidSyntax("C1 control character not allowed in " + field))
        }
      }
      i = i + 1
    } else if b == 9 {
      i = i + 1
    } else {
      return Err(HlsError::InvalidSyntax("control character not allowed in " + field))
    }
  }
  if has_lbrace && contains_var_ref(s) {
    return Err(HlsError::InvalidVariable("cannot format literal variable reference in " + field))
  }
  Ok(())
}

///| Check if a quoted-string value contains `"`, CR, LF, NUL, control chars, or literal var refs.
fn check_quoted_safe(s : String, field : String) -> Result[Unit, HlsError] {
  let n = s.length()
  let mut has_lbrace = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 10 || b == 13 || b == 0 {
      return Err(HlsError::InvalidSyntax("quote/CR/LF/NUL not allowed in " + field))
    }
    if b >= 32 && b < 123 {
      i = i + 1
    } else if b == 123 {
      has_lbrace = true
      i = i + 1
    } else if b > 123 && b != 127 {
      if b == 194 && i + 1 < n {
        let next = s.code_unit_at(i + 1)
        if next >= 128 && next <= 159 {
          return Err(HlsError::InvalidSyntax("C1 control character not allowed in " + field))
        }
      }
      i = i + 1
    } else if b == 9 {
      i = i + 1
    } else {
      return Err(HlsError::InvalidSyntax("control character not allowed in " + field))
    }
  }
  if has_lbrace && contains_var_ref(s) {
    return Err(HlsError::InvalidVariable("cannot format literal variable reference in " + field))
  }
  Ok(())
}

///| Check if an unquoted token is safe (enumerated-string `[A-Z0-9-]+`).
fn check_token_safe(s : String, field : String) -> Result[Unit, HlsError] {
  if !is_valid_enum_token(s) {
    return Err(HlsError::InvalidSyntax("unsafe character in unquoted token " + field))
  }
  Ok(())
}

fn is_known_hls_tag(name : String) -> Bool {
  name == "#EXTM3U" ||
  name == "#EXT-X-VERSION" ||
  name == "#EXT-X-INDEPENDENT-SEGMENTS" ||
  name == "#EXT-X-START" ||
  name == "#EXT-X-DEFINE" ||
  name == "#EXT-X-STREAM-INF" ||
  name == "#EXT-X-I-FRAME-STREAM-INF" ||
  name == "#EXT-X-MEDIA" ||
  name == "#EXT-X-SESSION-DATA" ||
  name == "#EXT-X-SESSION-KEY" ||
  name == "#EXT-X-TARGETDURATION" ||
  name == "#EXT-X-MEDIA-SEQUENCE" ||
  name == "#EXT-X-DISCONTINUITY-SEQUENCE" ||
  name == "#EXT-X-PLAYLIST-TYPE" ||
  name == "#EXT-X-ENDLIST" ||
  name == "#EXT-X-I-FRAMES-ONLY" ||
  name == "#EXTINF" ||
  name == "#EXT-X-BYTERANGE" ||
  name == "#EXT-X-DISCONTINUITY" ||
  name == "#EXT-X-GAP" ||
  name == "#EXT-X-PROGRAM-DATE-TIME" ||
  name == "#EXT-X-KEY" ||
  name == "#EXT-X-MAP" ||
  name == "#EXT-X-DATERANGE" ||
  name == "#EXT-X-SERVER-CONTROL" ||
  name == "#EXT-X-PART-INF" ||
  name == "#EXT-X-PART" ||
  name == "#EXT-X-PRELOAD-HINT" ||
  name == "#EXT-X-RENDITION-REPORT" ||
  name == "#EXT-X-SKIP"
}

fn validate_custom_tag_name(name : String) -> Result[Unit, HlsError] {
  let n = name.length()
  if n < 4 || !slice_starts_with(name, 0, n, "#EXT") {
    return Err(HlsError::InvalidTag("custom tag name must start with #EXT"))
  }
  let mut i = 4
  while i < n {
    if !is_attr_name_char(name.code_unit_at(i)) {
      return Err(HlsError::InvalidTag("invalid character in custom tag name"))
    }
    i = i + 1
  }
  if is_known_hls_tag(name) {
    return Err(HlsError::InvalidTag("custom tag cannot forge reserved HLS tag: " + name))
  }
  Ok(())
}

fn validate_client_attr_key(key : String) -> Result[Unit, HlsError] {
  let n = key.length()
  if n < 3 || key.code_unit_at(0) != 88 || key.code_unit_at(1) != 45 {
    return Err(HlsError::InvalidAttribute("DATERANGE client attribute key must start with X-"))
  }
  let mut i = 2
  while i < n {
    if !is_attr_name_char(key.code_unit_at(i)) {
      return Err(HlsError::InvalidAttribute("invalid character in DATERANGE client attribute key"))
    }
    i = i + 1
  }
  Ok(())
}

fn write_quoted(
  sb : StringBuilder,
  s : String,
  field : String,
) -> Result[Unit, HlsError] {
  match check_quoted_safe(s, field) {
    Ok(_) => {
      sb.write_string("\"")
      sb.write_string(s)
      sb.write_string("\"")
      Ok(())
    }
    Err(e) => Err(e)
  }
}

fn write_byterange_val(sb : StringBuilder, br : ByteRange) -> Unit {
  write_u64(sb, br.length)
  match br.offset {
    Some(off) => {
      sb.write_byte((64).to_byte())
      write_u64(sb, off)
    }
    None => ()
  }
}

fn format_hdcp(h : HdcpLevel) -> Result[String, HlsError] {
  match h {
    HdcpLevel::None => Ok("NONE")
    HdcpLevel::Type0 => Ok("TYPE-0")
    HdcpLevel::Type1 => Ok("TYPE-1")
    HdcpLevel::Other(s) => {
      match check_token_safe(s, "HDCP-LEVEL") {
        Ok(_) => Ok(s)
        Err(e) => Err(e)
      }
    }
  }
}

fn format_key_tag(
  sb : StringBuilder,
  tag_prefix : String,
  key : EncryptionKey,
  is_session_key : Bool,
) -> Result[Unit, HlsError] {
  match key.method {
    KeyMethod::None => {
      if is_session_key {
        return Err(HlsError::InvalidAttribute("EXT-X-SESSION-KEY METHOD must not be NONE"))
      }
      match (key.uri, key.iv, key.keyformat, key.keyformat_versions) {
        (None, None, None, None) => ()
        _ => return Err(HlsError::InvalidAttribute("METHOD=NONE forbids other attributes"))
      }
    }
    _ => {
      match key.uri {
        Some(u) => {
          if u.length() == 0 {
            return Err(HlsError::MissingRequiredAttribute("KEY URI"))
          }
        }
        None => return Err(HlsError::MissingRequiredAttribute("KEY URI"))
      }
    }
  }
  sb.write_string(tag_prefix)
  sb.write_string("METHOD=")
  match key.method {
    KeyMethod::None => sb.write_string("NONE")
    KeyMethod::Aes128 => sb.write_string("AES-128")
    KeyMethod::SampleAes => sb.write_string("SAMPLE-AES")
    KeyMethod::SampleAesCtr => sb.write_string("SAMPLE-AES-CTR")
  }
  match key.uri {
    Some(u) => {
      sb.write_string(",URI=")
      match write_quoted(sb, u, "KEY URI") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match key.iv {
    Some(iv) => {
      match validate_iv_hex(iv) {
        Ok(_) => {
          sb.write_string(",IV=")
          sb.write_string(iv)
        }
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match key.keyformat {
    Some(kf) => {
      sb.write_string(",KEYFORMAT=")
      match write_quoted(sb, kf, "KEYFORMAT") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  match key.keyformat_versions {
    Some(kfv) => {
      sb.write_string(",KEYFORMATVERSIONS=")
      match write_quoted(sb, kfv, "KEYFORMATVERSIONS") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  sb.write_string("\n")
  Ok(())
}

fn format_defines(
  sb : StringBuilder,
  defines : Array[DefineTag],
) -> Result[Unit, HlsError] {
  // Omit NAME/VALUE DEFINEs since playlist values are already expanded (prevents re-expansion on re-parse).
  let mut i = 0
  while i < defines.length() {
    let d = defines[i]
    match d.kind {
      DefineKind::Value(_) => ()
      DefineKind::Import => {
        sb.write_string("#EXT-X-DEFINE:IMPORT=")
        match write_quoted(sb, d.name, "DEFINE IMPORT") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        sb.write_string("\n")
      }
      DefineKind::QueryParam => {
        sb.write_string("#EXT-X-DEFINE:QUERYPARAM=")
        match write_quoted(sb, d.name, "DEFINE QUERYPARAM") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        sb.write_string("\n")
      }
    }
    i = i + 1
  }
  Ok(())
}

fn format_custom_tags(
  sb : StringBuilder,
  custom_tags : Array[CustomTag],
) -> Result[Unit, HlsError] {
  let mut i = 0
  while i < custom_tags.length() {
    let ct = custom_tags[i]
    match validate_custom_tag_name(ct.name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(ct.name)
    match ct.value {
      Some(v) => {
        match check_no_crlf(v, "custom tag value") {
          Ok(_) => {
            sb.write_string(":")
            sb.write_string(v)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    sb.write_string("\n")
    i = i + 1
  }
  Ok(())
}

///| Format a `Playlist` deterministically with CRLF/quote injection guards.
pub fn format_playlist(playlist : Playlist) -> Result[String, HlsError] {
  match playlist {
    Playlist::Master(m) => format_master_playlist(m)
    Playlist::Media(m) => format_media_playlist(m)
  }
}

///| Format a `MasterPlaylist` deterministically.
pub fn format_master_playlist(
  master : MasterPlaylist,
) -> Result[String, HlsError] {
  if master.variants.length() == 0 &&
  master.iframe_streams.length() == 0 &&
  master.media.length() == 0 &&
  master.session_data.length() == 0 &&
  master.session_keys.length() == 0 {
    return Err(HlsError::MissingRequiredTag("MasterPlaylist has no master tags"))
  }
  let est_cap = master.variants.length() * 192 +
  master.media.length() * 128 +
  master.iframe_streams.length() * 128 +
  256
  let sb = StringBuilder::with_capacity(est_cap)
  sb.write_string("#EXTM3U\n")
  match master.version {
    Some(v) => {
      if v < 1 {
        return Err(HlsError::InvalidNumber("VERSION must be >= 1"))
      }
      sb.write_string("#EXT-X-VERSION:")
      sb.write_string(v.to_string())
      sb.write_string("\n")
    }
    None => ()
  }
  if master.independent_segments {
    sb.write_string("#EXT-X-INDEPENDENT-SEGMENTS\n")
  }
  match master.start {
    Some(st) => {
      if st.time_offset_us == -9223372036854775808L {
        return Err(HlsError::InvalidNumber("TIME-OFFSET overflow"))
      }
      sb.write_string("#EXT-X-START:TIME-OFFSET=")
      write_us(sb, st.time_offset_us)
      if st.precise {
        sb.write_string(",PRECISE=YES")
      }
      sb.write_string("\n")
    }
    None => ()
  }
  match format_defines(sb, master.defines) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let mut i = 0
  while i < master.session_data.length() {
    let sd = master.session_data[i]
    match (sd.value, sd.uri) {
      (Some(_), Some(_)) =>
      return Err(HlsError::InvalidAttribute("SESSION-DATA cannot have both VALUE and URI"))
      (None, None) =>
      return Err(HlsError::MissingRequiredAttribute("SESSION-DATA VALUE or URI"))
      _ => ()
    }
    sb.write_string("#EXT-X-SESSION-DATA:DATA-ID=")
    match write_quoted(sb, sd.data_id, "SESSION-DATA DATA-ID") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match sd.value {
      Some(v) => {
        sb.write_string(",VALUE=")
        match write_quoted(sb, v, "SESSION-DATA VALUE") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match sd.uri {
      Some(u) => {
        sb.write_string(",URI=")
        match write_quoted(sb, u, "SESSION-DATA URI") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match sd.language {
      Some(l) => {
        sb.write_string(",LANGUAGE=")
        match write_quoted(sb, l, "SESSION-DATA LANGUAGE") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match sd.format {
      Some(f) => {
        if f != "JSON" && f != "RAW" {
          return Err(HlsError::InvalidAttribute("SESSION-DATA FORMAT must be JSON or RAW"))
        }
        sb.write_string(",FORMAT=")
        sb.write_string(f)
      }
      None => ()
    }
    sb.write_string("\n")
    i = i + 1
  }

  i = 0
  while i < master.session_keys.length() {
    match format_key_tag(sb, "#EXT-X-SESSION-KEY:", master.session_keys[i], true) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let groups : Map[String, Bool] = Map::new()
  let group_names : Map[String, Bool] = Map::new()
  i = 0
  while i < master.media.length() {
    let med = master.media[i]
    let gk = media_type_key(med.media_type) + "\x00" + med.group_id
    groups.set(gk, true)
    let nk = gk + "\x00" + med.name
    match group_names.get(nk) {
      Some(_) =>
      return Err(HlsError::InvalidAttribute("duplicate NAME in EXT-X-MEDIA group: " + med.name))
      None => group_names.set(nk, true)
    }
    if med.forced {
      match med.media_type {
        MediaType::Subtitles => ()
        _ => return Err(HlsError::InvalidAttribute("FORCED is only valid for TYPE=SUBTITLES"))
      }
    }
    match med.instream_id {
      Some(_) => {
        match med.media_type {
          MediaType::ClosedCaptions => ()
          _ => return Err(HlsError::InvalidAttribute("INSTREAM-ID is only valid for TYPE=CLOSED-CAPTIONS"))
        }
      }
      None => {
        match med.media_type {
          MediaType::ClosedCaptions =>
          return Err(HlsError::MissingRequiredAttribute("INSTREAM-ID"))
          _ => ()
        }
      }
    }
    match med.channels {
      Some(_) => {
        match med.media_type {
          MediaType::Audio => ()
          _ => return Err(HlsError::InvalidAttribute("CHANNELS is only valid for TYPE=AUDIO"))
        }
      }
      None => ()
    }
    match med.media_type {
      MediaType::ClosedCaptions => {
        match med.uri {
          Some(_) => return Err(HlsError::InvalidAttribute("CLOSED-CAPTIONS must not have URI"))
          None => ()
        }
      }
      _ => ()
    }
    sb.write_string("#EXT-X-MEDIA:TYPE=")
    match med.media_type {
      MediaType::Audio => sb.write_string("AUDIO")
      MediaType::Video => sb.write_string("VIDEO")
      MediaType::Subtitles => sb.write_string("SUBTITLES")
      MediaType::ClosedCaptions => sb.write_string("CLOSED-CAPTIONS")
    }
    sb.write_string(",GROUP-ID=")
    match write_quoted(sb, med.group_id, "MEDIA GROUP-ID") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(",NAME=")
    match write_quoted(sb, med.name, "MEDIA NAME") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match med.language {
      Some(l) => {
        sb.write_string(",LANGUAGE=")
        match write_quoted(sb, l, "MEDIA LANGUAGE") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match med.assoc_language {
      Some(al) => {
        sb.write_string(",ASSOC-LANGUAGE=")
        match write_quoted(sb, al, "MEDIA ASSOC-LANGUAGE") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    if med.is_default {
      sb.write_string(",DEFAULT=YES")
    }
    if med.autoselect {
      sb.write_string(",AUTOSELECT=YES")
    }
    if med.forced {
      sb.write_string(",FORCED=YES")
    }
    match med.instream_id {
      Some(id) => {
        sb.write_string(",INSTREAM-ID=")
        match write_quoted(sb, id, "MEDIA INSTREAM-ID") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match med.characteristics {
      Some(ch) => {
        sb.write_string(",CHARACTERISTICS=")
        match write_quoted(sb, ch, "MEDIA CHARACTERISTICS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match med.channels {
      Some(c) => {
        sb.write_string(",CHANNELS=")
        match write_quoted(sb, c, "MEDIA CHANNELS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match med.uri {
      Some(u) => {
        sb.write_string(",URI=")
        match write_quoted(sb, u, "MEDIA URI") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    sb.write_string("\n")
    i = i + 1
  }

  let mut any_cc_none = false
  let mut any_cc_not_none = false
  i = 0
  while i < master.variants.length() {
    let v = master.variants[i]
    match check_uri_line_safe(v.uri, "variant URI") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if v.bandwidth <= 0L {
      return Err(HlsError::InvalidNumber("BANDWIDTH must be positive"))
    }
    sb.write_string("#EXT-X-STREAM-INF:BANDWIDTH=")
    sb.write_string(v.bandwidth.to_string())
    match v.average_bandwidth {
      Some(ab) => {
        if ab <= 0L {
          return Err(HlsError::InvalidNumber("AVERAGE-BANDWIDTH must be positive"))
        }
        sb.write_string(",AVERAGE-BANDWIDTH=")
        sb.write_string(ab.to_string())
      }
      None => ()
    }
    match v.codecs {
      Some(c) => {
        sb.write_string(",CODECS=")
        match write_quoted(sb, c, "CODECS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match v.resolution {
      Some(r) => {
        if r.width <= 0L || r.height <= 0L {
          return Err(HlsError::InvalidNumber("RESOLUTION dimensions must be positive"))
        }
        sb.write_string(",RESOLUTION=")
        sb.write_string(r.width.to_string())
        sb.write_string("x")
        sb.write_string(r.height.to_string())
      }
      None => ()
    }
    match v.frame_rate_mhz {
      Some(fr) => {
        if fr <= 0L {
          return Err(HlsError::InvalidNumber("FRAME-RATE must be positive"))
        }
        sb.write_string(",FRAME-RATE=")
        write_mhz(sb, fr)
      }
      None => ()
    }
    match v.hdcp_level {
      Some(hl) => {
        match format_hdcp(hl) {
          Ok(s) => {
            sb.write_string(",HDCP-LEVEL=")
            sb.write_string(s)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match v.audio {
      Some(a) => {
        match groups.get("A\x00" + a) {
          Some(_) => ()
          None => return Err(HlsError::InvalidAttribute("AUDIO group not found: " + a))
        }
        sb.write_string(",AUDIO=")
        match write_quoted(sb, a, "AUDIO") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match v.video {
      Some(vid) => {
        match groups.get("V\x00" + vid) {
          Some(_) => ()
          None => return Err(HlsError::InvalidAttribute("VIDEO group not found: " + vid))
        }
        sb.write_string(",VIDEO=")
        match write_quoted(sb, vid, "VIDEO") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match v.subtitles {
      Some(sub) => {
        match groups.get("S\x00" + sub) {
          Some(_) => ()
          None => return Err(HlsError::InvalidAttribute("SUBTITLES group not found: " + sub))
        }
        sb.write_string(",SUBTITLES=")
        match write_quoted(sb, sub, "SUBTITLES") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match v.closed_captions {
      Some(ClosedCaptionsRef::None) => {
        any_cc_none = true
        sb.write_string(",CLOSED-CAPTIONS=NONE")
      }
      Some(ClosedCaptionsRef::GroupId(g)) => {
        any_cc_not_none = true
        match groups.get("C\x00" + g) {
          Some(_) => ()
          None => return Err(HlsError::InvalidAttribute("CLOSED-CAPTIONS group not found: " + g))
        }
        sb.write_string(",CLOSED-CAPTIONS=")
        match write_quoted(sb, g, "CLOSED-CAPTIONS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => any_cc_not_none = true
    }
    match v.score_micros {
      Some(sc) => {
        if sc < 0L {
          return Err(HlsError::InvalidNumber("SCORE must be non-negative"))
        }
        sb.write_string(",SCORE=")
        write_us(sb, sc)
      }
      None => ()
    }
    match v.pathway_id {
      Some(p) => {
        sb.write_string(",PATHWAY-ID=")
        match write_quoted(sb, p, "PATHWAY-ID") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    sb.write_string("\n")
    sb.write_string(v.uri)
    sb.write_string("\n")
    i = i + 1
  }
  if any_cc_none && any_cc_not_none {
    return Err(HlsError::InvalidAttribute("CLOSED-CAPTIONS=NONE must be present on all variants if used on any"))
  }

  i = 0
  while i < master.iframe_streams.length() {
    let ifr = master.iframe_streams[i]
    if ifr.bandwidth <= 0L {
      return Err(HlsError::InvalidNumber("I-FRAME BANDWIDTH must be positive"))
    }
    if ifr.uri.length() == 0 {
      return Err(HlsError::MissingRequiredAttribute("I-FRAME URI"))
    }
    sb.write_string("#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=")
    sb.write_string(ifr.bandwidth.to_string())
    match ifr.average_bandwidth {
      Some(ab) => {
        if ab < 0L {
          return Err(HlsError::InvalidNumber("I-FRAME AVERAGE-BANDWIDTH must be non-negative"))
        }
        sb.write_string(",AVERAGE-BANDWIDTH=")
        sb.write_string(ab.to_string())
      }
      None => ()
    }
    match ifr.codecs {
      Some(c) => {
        sb.write_string(",CODECS=")
        match write_quoted(sb, c, "I-FRAME CODECS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match ifr.resolution {
      Some(r) => {
        if r.width <= 0L || r.height <= 0L {
          return Err(HlsError::InvalidNumber("I-FRAME RESOLUTION dimensions must be positive"))
        }
        sb.write_string(",RESOLUTION=")
        sb.write_string(r.width.to_string())
        sb.write_string("x")
        sb.write_string(r.height.to_string())
      }
      None => ()
    }
    match ifr.hdcp_level {
      Some(hl) => {
        match format_hdcp(hl) {
          Ok(s) => {
            sb.write_string(",HDCP-LEVEL=")
            sb.write_string(s)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match ifr.video {
      Some(vid) => {
        sb.write_string(",VIDEO=")
        match write_quoted(sb, vid, "I-FRAME VIDEO") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match ifr.score_micros {
      Some(sc) => {
        if sc < 0L {
          return Err(HlsError::InvalidNumber("I-FRAME SCORE must be non-negative"))
        }
        sb.write_string(",SCORE=")
        write_us(sb, sc)
      }
      None => ()
    }
    match ifr.pathway_id {
      Some(p) => {
        sb.write_string(",PATHWAY-ID=")
        match write_quoted(sb, p, "I-FRAME PATHWAY-ID") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    sb.write_string(",URI=")
    match write_quoted(sb, ifr.uri, "I-FRAME URI") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string("\n")
    i = i + 1
  }

  match format_custom_tags(sb, master.custom_tags) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(sb.to_string())
}

fn format_partial_segment(
  sb : StringBuilder,
  part : PartialSegment,
  part_target_us : Int64,
) -> Result[Unit, HlsError] {
  if part.duration_us < 0L || part.duration_us > part_target_us {
    return Err(HlsError::InvalidNumber("PART DURATION invalid"))
  }
  sb.write_string("#EXT-X-PART:DURATION=")
  write_us(sb, part.duration_us)
  sb.write_string(",URI=")
  match write_quoted(sb, part.uri, "PART URI") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if part.independent {
    sb.write_string(",INDEPENDENT=YES")
  }
  match part.byterange {
    Some(br) => {
      if br.length < 0L {
        return Err(HlsError::InvalidByteRange("PART BYTERANGE length must be non-negative"))
      }
      match br.offset {
        Some(o) => {
          if o < 0L || o > 9223372036854775807L - br.length {
            return Err(HlsError::InvalidByteRange("PART BYTERANGE offset invalid"))
          }
        }
        None => ()
      }
      sb.write_string(",BYTERANGE=\"")
      write_byterange_val(sb, br)
      sb.write_byte((34).to_byte())
    }
    None => ()
  }
  if part.gap {
    sb.write_string(",GAP=YES")
  }
  sb.write_string("\n")
  Ok(())
}

fn format_segment_keys_range(
  sb : StringBuilder,
  seg : MediaSegment,
  start_idx : Int,
  end_idx : Int,
) -> Result[Unit, HlsError] {
  let klen = seg.keys.length()
  if klen == 0 {
    if start_idx == 0 && end_idx > 0 {
      match seg.key {
        Some(k) => {
          match format_key_tag(sb, "#EXT-X-KEY:", k, false) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
    }
    return Ok(())
  }
  let mut ki = start_idx
  while ki < end_idx && ki < klen {
    let k = if ki == klen - 1 {
      match seg.key {
        Some(sk) => sk
        None => seg.keys[ki]
      }
    } else {
      seg.keys[ki]
    }
    match format_key_tag(sb, "#EXT-X-KEY:", k, false) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    ki = ki + 1
  }
  Ok(())
}

fn format_segment_map(
  sb : StringBuilder,
  seg : MediaSegment,
) -> Result[Unit, HlsError] {
  match seg.map {
    Some(mp) => {
      if mp.uri.length() == 0 {
        return Err(HlsError::MissingRequiredAttribute("MAP URI"))
      }
      sb.write_string("#EXT-X-MAP:URI=")
      match write_quoted(sb, mp.uri, "MAP URI") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match mp.byterange {
        Some(br) => {
          if br.length < 0L {
            return Err(HlsError::InvalidByteRange("MAP BYTERANGE length must be non-negative"))
          }
          match br.offset {
            Some(o) => {
              if o < 0L {
                return Err(HlsError::InvalidByteRange("MAP BYTERANGE offset must be non-negative"))
              }
            }
            None =>
            return Err(HlsError::InvalidByteRange("EXT-X-MAP BYTERANGE requires @offset"))
          }
          sb.write_string(",BYTERANGE=\"")
          write_byterange_val(sb, br)
          sb.write_byte((34).to_byte())
        }
        None => ()
      }
      sb.write_string("\n")
    }
    None => ()
  }
  Ok(())
}

///| Format a `MediaPlaylist` deterministically.
pub fn format_media_playlist(
  media : MediaPlaylist,
) -> Result[String, HlsError] {
  let max_i64 = 9223372036854775807L
  let est_cap = media.segments.length() * 96 +
  media.trailing_parts.length() * 80 +
  256
  let sb = StringBuilder::with_capacity(est_cap)
  sb.write_string("#EXTM3U\n")
  if media.target_duration <= 0L {
    return Err(HlsError::InvalidNumber("TARGETDURATION must be positive"))
  }
  if media.media_sequence < 0L {
    return Err(HlsError::InvalidNumber("MEDIA-SEQUENCE must be non-negative"))
  }
  if media.discontinuity_sequence < 0L {
    return Err(HlsError::InvalidNumber("DISCONTINUITY-SEQUENCE must be non-negative"))
  }
  match media.version {
    Some(v) => {
      if v < 1 {
        return Err(HlsError::InvalidNumber("VERSION must be >= 1"))
      }
      sb.write_string("#EXT-X-VERSION:")
      sb.write_string(v.to_string())
      sb.write_string("\n")
    }
    None => ()
  }
  sb.write_string("#EXT-X-TARGETDURATION:")
  sb.write_string(media.target_duration.to_string())
  sb.write_string("\n")
  if media.media_sequence != 0L {
    sb.write_string("#EXT-X-MEDIA-SEQUENCE:")
    sb.write_string(media.media_sequence.to_string())
    sb.write_string("\n")
  }
  if media.discontinuity_sequence != 0L {
    sb.write_string("#EXT-X-DISCONTINUITY-SEQUENCE:")
    sb.write_string(media.discontinuity_sequence.to_string())
    sb.write_string("\n")
  }
  match media.playlist_type {
    Some(PlaylistType::Event) => sb.write_string("#EXT-X-PLAYLIST-TYPE:EVENT\n")
    Some(PlaylistType::Vod) => sb.write_string("#EXT-X-PLAYLIST-TYPE:VOD\n")
    None => ()
  }
  if media.i_frames_only {
    sb.write_string("#EXT-X-I-FRAMES-ONLY\n")
  }
  if media.independent_segments {
    sb.write_string("#EXT-X-INDEPENDENT-SEGMENTS\n")
  }
  match media.start {
    Some(st) => {
      if st.time_offset_us == -9223372036854775808L {
        return Err(HlsError::InvalidNumber("TIME-OFFSET overflow"))
      }
      sb.write_string("#EXT-X-START:TIME-OFFSET=")
      write_us(sb, st.time_offset_us)
      if st.precise {
        sb.write_string(",PRECISE=YES")
      }
      sb.write_string("\n")
    }
    None => ()
  }
  match format_defines(sb, media.defines) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match media.server_control {
    Some(sc) => {
      if sc.can_skip_dateranges {
        match sc.can_skip_until_us {
          Some(_) => ()
          None => return Err(HlsError::InvalidAttribute("CAN-SKIP-DATERANGES requires CAN-SKIP-UNTIL"))
        }
      }
      let mut first = true
      sb.write_string("#EXT-X-SERVER-CONTROL:")
      match sc.can_skip_until_us {
        Some(v) => {
          if v < 0L || media.target_duration > max_i64 / 6000000L || v < media.target_duration * 6000000L {
            return Err(HlsError::InvalidAttribute("CAN-SKIP-UNTIL must be >= 6 * TARGETDURATION"))
          }
          sb.write_string("CAN-SKIP-UNTIL=")
          sb.write_string(format_us(v))
          first = false
        }
        None => ()
      }
      if sc.can_skip_dateranges {
        if !first {
          sb.write_string(",")
        }
        sb.write_string("CAN-SKIP-DATERANGES=YES")
        first = false
      }
      match sc.hold_back_us {
        Some(v) => {
          if v < 0L || media.target_duration > max_i64 / 3000000L || v < media.target_duration * 3000000L {
            return Err(HlsError::InvalidAttribute("HOLD-BACK must be >= 3 * TARGETDURATION"))
          }
          if !first {
            sb.write_string(",")
          }
          sb.write_string("HOLD-BACK=")
          sb.write_string(format_us(v))
          first = false
        }
        None => ()
      }
      match sc.part_hold_back_us {
        Some(v) => {
          if v < 0L {
            return Err(HlsError::InvalidNumber("PART-HOLD-BACK must be non-negative"))
          }
          if !first {
            sb.write_string(",")
          }
          sb.write_string("PART-HOLD-BACK=")
          sb.write_string(format_us(v))
          first = false
        }
        None => ()
      }
      if sc.can_block_reload {
        if !first {
          sb.write_string(",")
        }
        sb.write_string("CAN-BLOCK-RELOAD=YES")
      }
      sb.write_string("\n")
    }
    None => ()
  }
  let mut part_target_us = 0L
  match media.part_inf {
    Some(pi) => {
      if pi.part_target_us <= 0L {
        return Err(HlsError::InvalidNumber("PART-TARGET must be positive"))
      }
      match media.server_control {
        None => return Err(HlsError::MissingRequiredAttribute("PART-HOLD-BACK required with EXT-X-PART-INF"))
        Some(sc) => {
          match sc.part_hold_back_us {
            None => return Err(HlsError::MissingRequiredAttribute("PART-HOLD-BACK required with EXT-X-PART-INF"))
            Some(phb) => {
              if pi.part_target_us > max_i64 / 2L || phb < pi.part_target_us * 2L {
                return Err(HlsError::InvalidAttribute("PART-HOLD-BACK must be >= 2 * PART-TARGET"))
              }
            }
          }
        }
      }
      part_target_us = pi.part_target_us
      sb.write_string("#EXT-X-PART-INF:PART-TARGET=")
      sb.write_string(format_us(pi.part_target_us))
      sb.write_string("\n")
    }
    None => ()
  }
  match media.skip {
    Some(sk) => {
      if sk.skipped_segments < 0L {
        return Err(HlsError::InvalidNumber("SKIPPED-SEGMENTS must be non-negative"))
      }
      sb.write_string("#EXT-X-SKIP:SKIPPED-SEGMENTS=")
      sb.write_string(sk.skipped_segments.to_string())
      match sk.recently_removed_dateranges {
        Some(r) => {
          sb.write_string(",RECENTLY-REMOVED-DATERANGES=")
          match write_quoted(sb, r, "RECENTLY-REMOVED-DATERANGES") {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => ()
      }
      sb.write_string("\n")
    }
    None => ()
  }

  match format_custom_tags(sb, media.custom_tags) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let mut i = 0
  while i < media.segments.length() {
    let seg = media.segments[i]
    match check_uri_line_safe(seg.uri, "segment URI") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if seg.duration_us < 0L {
      return Err(HlsError::InvalidNumber("EXTINF duration must be non-negative"))
    }
    let rounded_s = seg.duration_us / 1000000L + (if seg.duration_us % 1000000L >= 500000L { 1L } else { 0L })
    if rounded_s > media.target_duration {
      return Err(HlsError::InvalidNumber("EXTINF rounded duration exceeds TARGETDURATION"))
    }
    match format_custom_tags(sb, seg.custom_tags) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if seg.discontinuity {
      sb.write_string("#EXT-X-DISCONTINUITY\n")
    }
    let kcount = if seg.keys.length() > 0 {
      seg.keys.length()
    } else {
      match seg.key {
        Some(_) => 1
        None => 0
      }
    }
    let split = if seg.keys_before_map < 0 {
      0
    } else if seg.keys_before_map > kcount {
      kcount
    } else {
      seg.keys_before_map
    }
    match seg.map {
      Some(_) => {
        match format_segment_keys_range(sb, seg, 0, split) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match format_segment_map(sb, seg) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match format_segment_keys_range(sb, seg, split, kcount) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => {
        match format_segment_keys_range(sb, seg, 0, kcount) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
    }
    match seg.program_date_time {
      Some(pdt) => {
        match validate_iso8601(pdt) {
          Ok(_) => {
            sb.write_string("#EXT-X-PROGRAM-DATE-TIME:")
            sb.write_string(pdt)
            sb.write_string("\n")
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    if seg.parts.length() > 0 && part_target_us <= 0L {
      return Err(HlsError::MissingRequiredTag("#EXT-X-PART-INF required with #EXT-X-PART"))
    }
    let mut p = 0
    while p < seg.parts.length() {
      match format_partial_segment(sb, seg.parts[p], part_target_us) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      p = p + 1
    }
    if seg.gap {
      sb.write_string("#EXT-X-GAP\n")
    }
    sb.write_string("#EXTINF:")
    write_us(sb, seg.duration_us)
    sb.write_byte((44).to_byte())
    match seg.title {
      Some(t) => {
        match check_no_crlf(t, "EXTINF title") {
          Ok(_) => sb.write_string(t)
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    sb.write_byte((10).to_byte())
    match seg.byterange {
      Some(br) => {
        if br.length < 0L {
          return Err(HlsError::InvalidByteRange("BYTERANGE length must be non-negative"))
        }
        match br.offset {
          Some(o) => {
            if o < 0L || o > max_i64 - br.length {
              return Err(HlsError::InvalidByteRange("BYTERANGE offset invalid"))
            }
          }
          None => ()
        }
        sb.write_string("#EXT-X-BYTERANGE:")
        write_byterange_val(sb, br)
        sb.write_byte((10).to_byte())
      }
      None => ()
    }
    sb.write_string(seg.uri)
    sb.write_byte((10).to_byte())
    i = i + 1
  }

  if media.trailing_parts.length() > 0 && part_target_us <= 0L {
    return Err(HlsError::MissingRequiredTag("#EXT-X-PART-INF required with #EXT-X-PART"))
  }
  i = 0
  while i < media.trailing_parts.length() {
    match format_partial_segment(sb, media.trailing_parts[i], part_target_us) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  i = 0
  while i < media.preload_hints.length() {
    let ph = media.preload_hints[i]
    sb.write_string("#EXT-X-PRELOAD-HINT:TYPE=")
    match ph.hint_type {
      PreloadHintType::Part => sb.write_string("PART")
      PreloadHintType::Map => sb.write_string("MAP")
    }
    sb.write_string(",URI=")
    match write_quoted(sb, ph.uri, "PRELOAD-HINT URI") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match ph.byterange_start {
      Some(bs) => {
        if bs < 0L {
          return Err(HlsError::InvalidNumber("BYTERANGE-START must be non-negative"))
        }
        sb.write_string(",BYTERANGE-START=")
        sb.write_string(bs.to_string())
      }
      None => ()
    }
    match ph.byterange_length {
      Some(bl) => {
        if bl < 0L {
          return Err(HlsError::InvalidNumber("BYTERANGE-LENGTH must be non-negative"))
        }
        sb.write_string(",BYTERANGE-LENGTH=")
        sb.write_string(bl.to_string())
      }
      None => ()
    }
    sb.write_string("\n")
    i = i + 1
  }

  i = 0
  while i < media.rendition_reports.length() {
    let rr = media.rendition_reports[i]
    sb.write_string("#EXT-X-RENDITION-REPORT:URI=")
    match write_quoted(sb, rr.uri, "RENDITION-REPORT URI") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match rr.last_msn {
      Some(m) => {
        if m < 0L {
          return Err(HlsError::InvalidNumber("LAST-MSN must be non-negative"))
        }
        sb.write_string(",LAST-MSN=")
        sb.write_string(m.to_string())
      }
      None => ()
    }
    match rr.last_part {
      Some(p) => {
        if p < 0L {
          return Err(HlsError::InvalidNumber("LAST-PART must be non-negative"))
        }
        sb.write_string(",LAST-PART=")
        sb.write_string(p.to_string())
      }
      None => ()
    }
    sb.write_string("\n")
    i = i + 1
  }

  i = 0
  while i < media.dateranges.length() {
    let dr = media.dateranges[i]
    if dr.end_on_next {
      match dr.class_name {
        Some(_) => ()
        None => return Err(HlsError::MissingRequiredAttribute("CLASS required with END-ON-NEXT=YES"))
      }
      match (dr.duration_us, dr.end_date) {
        (None, None) => ()
        _ => return Err(HlsError::InvalidAttribute("END-ON-NEXT=YES forbids DURATION and END-DATE"))
      }
    }
    sb.write_string("#EXT-X-DATERANGE:ID=")
    match write_quoted(sb, dr.id, "DATERANGE ID") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match dr.class_name {
      Some(cl) => {
        sb.write_string(",CLASS=")
        match write_quoted(sb, cl, "DATERANGE CLASS") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match validate_iso8601(dr.start_date) {
      Ok(_) => {
        sb.write_string(",START-DATE=")
        match write_quoted(sb, dr.start_date, "DATERANGE START-DATE") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      Err(e) => return Err(e)
    }
    match dr.end_date {
      Some(ed) => {
        match validate_iso8601(ed) {
          Ok(_) => {
            sb.write_string(",END-DATE=")
            match write_quoted(sb, ed, "DATERANGE END-DATE") {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match dr.duration_us {
      Some(d) => {
        if d < 0L {
          return Err(HlsError::InvalidNumber("DATERANGE DURATION must be non-negative"))
        }
        sb.write_string(",DURATION=")
        sb.write_string(format_us(d))
      }
      None => ()
    }
    match dr.planned_duration_us {
      Some(pd) => {
        if pd < 0L {
          return Err(HlsError::InvalidNumber("DATERANGE PLANNED-DURATION must be non-negative"))
        }
        sb.write_string(",PLANNED-DURATION=")
        sb.write_string(format_us(pd))
      }
      None => ()
    }
    if dr.end_on_next {
      sb.write_string(",END-ON-NEXT=YES")
    }
    match dr.scte35_cmd {
      Some(x) => {
        match validate_hex_sequence(x, "SCTE35-CMD") {
          Ok(_) => {
            sb.write_string(",SCTE35-CMD=")
            sb.write_string(x)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match dr.scte35_out {
      Some(x) => {
        match validate_hex_sequence(x, "SCTE35-OUT") {
          Ok(_) => {
            sb.write_string(",SCTE35-OUT=")
            sb.write_string(x)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    match dr.scte35_in {
      Some(x) => {
        match validate_hex_sequence(x, "SCTE35-IN") {
          Ok(_) => {
            sb.write_string(",SCTE35-IN=")
            sb.write_string(x)
          }
          Err(e) => return Err(e)
        }
      }
      None => ()
    }
    let seen_ca : Map[String, Bool] = Map::new()
    let mut ca = 0
    while ca < dr.client_attributes.length() {
      let pair = dr.client_attributes[ca]
      match validate_client_attr_key(pair.key) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match seen_ca.get(pair.key) {
        Some(_) => return Err(HlsError::InvalidAttribute("duplicate DATERANGE client attribute: " + pair.key))
        None => seen_ca.set(pair.key, true)
      }
      sb.write_string(",")
      sb.write_string(pair.key)
      sb.write_string("=")
      if pair.quoted {
        match write_quoted(sb, pair.value, "DATERANGE X-attr value") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else {
        let is_hex = match validate_hex_sequence(pair.value, pair.key) {
          Ok(_) => true
          Err(_) => false
        }
        if !is_hex && !is_valid_decimal_float(pair.value) {
          return Err(HlsError::InvalidAttribute("unquoted DATERANGE X-attr value must be hex or decimal-float"))
        }
        sb.write_string(pair.value)
      }
      ca = ca + 1
    }
    sb.write_string("\n")
    i = i + 1
  }

  match format_custom_tags(sb, media.trailing_custom_tags) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  if media.end_list {
    sb.write_string("#EXT-X-ENDLIST\n")
  }
  Ok(sb.to_string())
}

fn codec_matches_list(codecs_str : String, preferred : Array[String]) -> Bool {
  let n = codecs_str.length()
  let mut i = 0
  while i < n {
    while i < n && (codecs_str.code_unit_at(i) == 32 || codecs_str.code_unit_at(i) == 44) {
      i = i + 1
    }
    let start = i
    while i < n && codecs_str.code_unit_at(i) != 44 {
      i = i + 1
    }
    let mut end = i
    while end > start && codecs_str.code_unit_at(end - 1) == 32 {
      end = end - 1
    }
    if end > start {
      let mut p = 0
      while p < preferred.length() {
        let pref = preferred[p]
        let pn = pref.length()
        if pn > 0 && end - start >= pn {
          if slice_starts_with(codecs_str, start, end, pref) {
            if end - start == pn || codecs_str.code_unit_at(start + pn) == 46 {
              return true
            }
          }
        }
        p = p + 1
      }
    }
  }
  false
}

fn is_better_variant(cand : VariantStream, best : VariantStream) -> Bool {
  if cand.bandwidth != best.bandwidth {
    return cand.bandwidth > best.bandwidth
  }
  let cs = match cand.score_micros {
    Some(v) => v
    None => -1L
  }
  let bs = match best.score_micros {
    Some(v) => v
    None => -1L
  }
  cs > bs
}

///| Select the highest-bandwidth variant `<= max_bandwidth`, preferring variants matching `preferred_codecs`.
pub fn select_variant(
  master : MasterPlaylist,
  max_bandwidth : Int64,
  preferred_codecs : Array[String],
) -> Option[VariantStream] {
  if max_bandwidth < 0L {
    return None
  }
  let mut best_pref : Option[VariantStream] = None
  let mut best_any : Option[VariantStream] = None
  let has_pref = preferred_codecs.length() > 0

  let mut i = 0
  while i < master.variants.length() {
    let v = master.variants[i]
    if v.bandwidth <= max_bandwidth {
      best_any = match best_any {
        None => Some(v)
        Some(b) => if is_better_variant(v, b) { Some(v) } else { Some(b) }
      }
      if has_pref {
        let matched = match v.codecs {
          Some(c) => codec_matches_list(c, preferred_codecs)
          None => false
        }
        if matched {
          best_pref = match best_pref {
            None => Some(v)
            Some(b) => if is_better_variant(v, b) { Some(v) } else { Some(b) }
          }
        }
      }
    }
    i = i + 1
  }

  match best_pref {
    Some(v) => Some(v)
    None => best_any
  }
}

fn sat_add_i64(a : Int64, b : Int64) -> Int64 {
  let max_i64 = 9223372036854775807L
  if b > 0L && a > max_i64 - b {
    max_i64
  } else {
    a + b
  }
}

///| Total duration of a `MediaPlaylist` in exact integer microseconds (saturates at `Int64::MAX`).
pub fn total_duration_us(media : MediaPlaylist) -> Int64 {
  let mut sum = 0L
  let mut i = 0
  while i < media.segments.length() {
    let d = media.segments[i].duration_us
    if d > 0L {
      sum = sat_add_i64(sum, d)
    }
    i = i + 1
  }
  sum
}

///| Total duration of a `MediaPlaylist` in integer milliseconds (`total_duration_us / 1000`).
pub fn total_duration_ms(media : MediaPlaylist) -> Int64 {
  total_duration_us(media) / 1000L
}

fn key_format_id(k : EncryptionKey) -> String {
  match k.keyformat {
    Some(kf) => if kf.length() == 0 { "identity" } else { kf }
    None => "identity"
  }
}

fn apply_key_to_active(
  active_formats : Array[String],
  active_keys : Array[EncryptionKey],
  k : EncryptionKey,
) -> Option[EncryptionKey] {
  match k.method {
    KeyMethod::None => {
      while active_formats.length() > 0 {
        let _ = active_formats.pop()
      }
      while active_keys.length() > 0 {
        let _ = active_keys.pop()
      }
      None
    }
    _ => {
      let kf = key_format_id(k)
      let mut idx = -1
      let mut j = 0
      while j < active_formats.length() {
        if active_formats[j] == kf {
          idx = j
          break
        }
        j = j + 1
      }
      if idx >= 0 {
        active_keys[idx] = k
      } else {
        active_formats.push(kf)
        active_keys.push(k)
      }
      Some(k)
    }
  }
}

///| Resolve all active multi-DRM `EncryptionKey`s (per `KEYFORMAT`) for each segment in a `MediaPlaylist`.
pub fn resolve_segment_keys(
  media : MediaPlaylist,
) -> Array[Array[EncryptionKey]] {
  let out : Array[Array[EncryptionKey]] = []
  let active_formats : Array[String] = []
  let active_keys : Array[EncryptionKey] = []
  let mut i = 0
  while i < media.segments.length() {
    let seg = media.segments[i]
    if seg.keys.length() > 0 {
      let mut ki = 0
      while ki < seg.keys.length() {
        let _ = apply_key_to_active(active_formats, active_keys, seg.keys[ki])
        ki = ki + 1
      }
    } else {
      match seg.key {
        Some(k) => {
          let _ = apply_key_to_active(active_formats, active_keys, k)
        }
        None => ()
      }
    }
    let snap : Array[EncryptionKey] = []
    let mut j = 0
    while j < active_keys.length() {
      snap.push(active_keys[j])
      j = j + 1
    }
    out.push(snap)
    i = i + 1
  }
  out
}

///| Resolve each segment's media sequence (accounting for `EXT-X-SKIP`), discontinuity sequence,
///| cumulative timing (saturating at `Int64::MAX`), and inherited Key/Map.
pub fn resolve_media_sequence(
  media : MediaPlaylist,
) -> Array[ResolvedSegment] {
  let out : Array[ResolvedSegment] = []
  let skipped = match media.skip {
    Some(sk) => if sk.skipped_segments > 0L { sk.skipped_segments } else { 0L }
    None => 0L
  }
  let mut msn = sat_add_i64(media.media_sequence, skipped)
  let mut dsn = media.discontinuity_sequence
  let mut cursor_us = 0L
  let active_formats : Array[String] = []
  let active_keys : Array[EncryptionKey] = []
  let mut active_key : Option[EncryptionKey] = None
  let mut active_map : Option[MediaMap] = None

  let mut i = 0
  while i < media.segments.length() {
    let seg = media.segments[i]
    if seg.discontinuity {
      dsn = sat_add_i64(dsn, 1L)
    }
    if seg.keys.length() > 0 {
      let mut ki = 0
      while ki < seg.keys.length() {
        active_key = apply_key_to_active(active_formats, active_keys, seg.keys[ki])
        ki = ki + 1
      }
    } else {
      match seg.key {
        Some(k) => {
          active_key = apply_key_to_active(active_formats, active_keys, k)
        }
        None => ()
      }
    }
    match seg.map {
      Some(mp) => active_map = Some(mp)
      None => ()
    }
    let start_us = cursor_us
    let dur = if seg.duration_us > 0L { seg.duration_us } else { 0L }
    let end_us = sat_add_i64(cursor_us, dur)
    out.push(ResolvedSegment::{
      media_sequence: msn,
      discontinuity_sequence: dsn,
      start_us: start_us,
      end_us: end_us,
      duration_us: seg.duration_us,
      uri: seg.uri,
      byterange: seg.byterange,
      key: active_key,
      map: active_map,
      discontinuity: seg.discontinuity,
      gap: seg.gap,
      program_date_time: seg.program_date_time,
    })
    cursor_us = end_us
    msn = sat_add_i64(msn, 1L)
    i = i + 1
  }
  out
}
