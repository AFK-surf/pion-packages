///| RFC 8216 + LL-HLS Master and Media Playlist parser and strict spec validator.

val struct PendingStreamInf {
  bandwidth : Int64
  average_bandwidth : Option[Int64]
  codecs : Option[String]
  resolution : Option[Resolution]
  frame_rate_mhz : Option[Int64]
  hdcp_level : Option[HdcpLevel]
  audio : Option[String]
  video : Option[String]
  subtitles : Option[String]
  closed_captions : Option[ClosedCaptionsRef]
  score_micros : Option[Int64]
  pathway_id : Option[String]
}

fn set_err(st : ParserState, e : HlsError) -> Bool {
  st.has_err = true
  st.err = Some(e)
  false
}

fn validate_limits_ok(limits : HlsLimits) -> Bool {
  !(limits.max_input_bytes < 0 ||
    limits.max_lines < 0 ||
    limits.max_segments < 0 ||
    limits.max_variants < 0 ||
    limits.max_attributes < 0 ||
    limits.max_line_bytes < 0 ||
    limits.max_custom_tags < 0 ||
    limits.max_expanded_bytes < 0 ||
    limits.max_parts < 0 ||
    limits.max_defines < 0 ||
    limits.max_dateranges < 0 ||
    limits.max_preload_hints < 0 ||
    limits.max_rendition_reports < 0 ||
    limits.max_media < 0)
}

fn parse_resolution_raw(
  s : String,
  start : Int,
  end : Int,
  st : ParserState,
) -> Option[Resolution] {
  let x_idx = find_byte_in(s, start, end, 120)
  if x_idx <= start || x_idx + 1 >= end {
    let _ = set_err(st, HlsError::InvalidAttribute("RESOLUTION must be WxH"))
    return None
  }
  let w = parse_uint64_raw(s, start, x_idx)
  if w < 0L {
    let _ = set_err(st, HlsError::InvalidNumber("invalid RESOLUTION width"))
    return None
  }
  let h = parse_uint64_raw(s, x_idx + 1, end)
  if h < 0L {
    let _ = set_err(st, HlsError::InvalidNumber("invalid RESOLUTION height"))
    return None
  }
  if w <= 0L || h <= 0L {
    let _ = set_err(st, HlsError::InvalidAttribute("RESOLUTION dimensions must be positive"))
    return None
  }
  Some(Resolution::{ width: w, height: h })
}

fn parse_hdcp_raw(
  s : String,
  start : Int,
  end : Int,
  st : ParserState,
) -> Option[HdcpLevel] {
  if slice_eq(s, start, end, "NONE") {
    Some(HdcpLevel::None)
  } else if slice_eq(s, start, end, "TYPE-0") {
    Some(HdcpLevel::Type0)
  } else if slice_eq(s, start, end, "TYPE-1") {
    Some(HdcpLevel::Type1)
  } else if is_valid_enum_token_slice(s, start, end) {
    Some(HdcpLevel::Other(s.slice(start, end)))
  } else {
    let _ = set_err(st, HlsError::InvalidAttribute("invalid HDCP-LEVEL token: " + s.slice(start, end)))
    None
  }
}

fn parse_start_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_to = false
  let mut to_us = 0L
  let mut precise = false
  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 11 && slice_eq(input, ks, ke, "TIME-OFFSET") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: TIME-OFFSET"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("TIME-OFFSET must not be quoted"))
      }
      if vs < ve && input.code_unit_at(vs) == 45 {
        let v = parse_us_raw(input, vs + 1, ve)
        if v < 0L {
          return set_err(st, HlsError::InvalidNumber("invalid TIME-OFFSET"))
        }
        to_us = -v
      } else {
        let v = parse_us_raw(input, vs, ve)
        if v < 0L {
          return set_err(st, HlsError::InvalidNumber("invalid TIME-OFFSET"))
        }
        to_us = v
      }
      has_to = true
    } else if klen == 7 && slice_eq(input, ks, ke, "PRECISE") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PRECISE"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PRECISE must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("PRECISE must be YES or NO"))
      }
      precise = yn == 1
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  if !has_to {
    return set_err(st, HlsError::MissingRequiredAttribute("TIME-OFFSET"))
  }
  st.start_tag = Some(StartTag::{ time_offset_us: to_us, precise: precise })
  true
}

fn validate_define_value(
  v : String,
  max_line_bytes : Int,
  st : ParserState,
) -> Bool {
  let n = v.length()
  if n > max_line_bytes {
    return set_err(st, HlsError::LimitExceeded("context variable value exceeded max_line_bytes"))
  }
  let mut i = 0
  while i < n {
    let b = v.code_unit_at(i)
    if b == 34 || b <= 8 || (b >= 10 && b <= 31) || b == 127 {
      return set_err(st, HlsError::InvalidVariable("disallowed character in IMPORT/QUERYPARAM value"))
    }
    if b == 194 && i + 1 < n {
      let next = v.code_unit_at(i + 1)
      if next >= 128 && next <= 159 {
        return set_err(st, HlsError::InvalidVariable("C1 control character in IMPORT/QUERYPARAM value"))
      }
    }
    i = i + 1
  }
  true
}

fn lookup_kv(pairs : Array[(String, String)], key : String) -> Option[String] {
  let mut i = 0
  while i < pairs.length() {
    let (k, v) = pairs[i]
    if k == key {
      return Some(v)
    }
    i = i + 1
  }
  None
}

fn set_define_value(st : ParserState, name : String, val_str : String) -> Unit {
  match st.define_values {
    Some(m) => m.set(name, val_str)
    None => {
      let m : Map[String, String] = Map::new()
      m.set(name, val_str)
      st.define_values = Some(m)
    }
  }
}

fn parse_define_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
  import_vars : Array[(String, String)],
  query_params : Array[(String, String)],
) -> Bool {
  if st.defines.length() >= limits.max_defines {
    return set_err(st, HlsError::LimitExceeded("max_defines exceeded"))
  }
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut d_name : Option[String] = None
  let mut d_val : Option[String] = None
  let mut d_imp : Option[String] = None
  let mut d_qp : Option[String] = None
  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 4 && slice_eq(input, ks, ke, "NAME") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: NAME"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DEFINE NAME must be quoted"))
      }
      d_name = Some(input.slice(vs, ve))
    } else if klen == 5 && slice_eq(input, ks, ke, "VALUE") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: VALUE"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DEFINE VALUE must be quoted"))
      }
      d_val = Some(input.slice(vs, ve))
    } else if klen == 6 && slice_eq(input, ks, ke, "IMPORT") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: IMPORT"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DEFINE IMPORT must be quoted"))
      }
      d_imp = Some(input.slice(vs, ve))
    } else if klen == 10 && slice_eq(input, ks, ke, "QUERYPARAM") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: QUERYPARAM"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DEFINE QUERYPARAM must be quoted"))
      }
      d_qp = Some(input.slice(vs, ve))
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let entry = match (d_name, d_val, d_imp, d_qp) {
    (Some(nm), Some(vl), None, None) =>
    DefineTag::{ name: nm, kind: DefineKind::Value(vl) }
    (None, None, Some(im), None) =>
    DefineTag::{ name: im, kind: DefineKind::Import }
    (None, None, None, Some(qp)) =>
    DefineTag::{ name: qp, kind: DefineKind::QueryParam }
    _ =>
    return set_err(st, HlsError::InvalidVariable("invalid #EXT-X-DEFINE attribute combination"))
  }
  if entry.name.length() == 0 {
    return set_err(st, HlsError::InvalidVariable("empty variable name"))
  }
  let mut vn = 0
  while vn < entry.name.length() {
    if !is_var_name_char(entry.name.code_unit_at(vn)) {
      return set_err(st, HlsError::InvalidVariable("invalid character in DEFINE name"))
    }
    vn = vn + 1
  }
  match st.define_names {
    Some(m) => {
      match m.get(entry.name) {
        Some(_) =>
        return set_err(st, HlsError::InvalidVariable("duplicate #EXT-X-DEFINE: " + entry.name))
        None => ()
      }
    }
    None => ()
  }
  match entry.kind {
    DefineKind::Value(vl) => set_define_value(st, entry.name, vl)
    DefineKind::Import => {
      st.has_import_define = true
      if st.is_master {
        return set_err(st, HlsError::InvalidVariable("IMPORT not allowed in Multivariant Playlist"))
      }
      match lookup_kv(import_vars, entry.name) {
        Some(vl) => {
          if !validate_define_value(vl, limits.max_line_bytes, st) {
            return false
          }
          set_define_value(st, entry.name, vl)
        }
        None =>
        return set_err(st, HlsError::InvalidVariable("unresolved IMPORT variable: " + entry.name))
      }
    }
    DefineKind::QueryParam => {
      match lookup_kv(query_params, entry.name) {
        Some(vl) => {
          if !validate_define_value(vl, limits.max_line_bytes, st) {
            return false
          }
          set_define_value(st, entry.name, vl)
        }
        None =>
        return set_err(st, HlsError::InvalidVariable("unresolved QUERYPARAM variable: " + entry.name))
      }
    }
  }
  match st.define_names {
    Some(m) => m.set(entry.name, true)
    None => {
      let m : Map[String, Bool] = Map::new()
      m.set(entry.name, true)
      st.define_names = Some(m)
    }
  }
  st.defines.push(entry)
  true
}

fn parse_stream_inf_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_bw = false
  let mut bw = 0L
  let mut avg_bw : Option[Int64] = None
  let mut codecs : Option[String] = None
  let mut res : Option[Resolution] = None
  let mut fps : Option[Int64] = None
  let mut hdcp : Option[HdcpLevel] = None
  let mut audio : Option[String] = None
  let mut video : Option[String] = None
  let mut subs : Option[String] = None
  let mut cc : Option[ClosedCaptionsRef] = None
  let mut score : Option[Int64] = None
  let mut pathway : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 9 && b0 == 66 && slice_eq(input, ks, ke, "BANDWIDTH") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BANDWIDTH"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("BANDWIDTH must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v <= 0L {
        return set_err(st, HlsError::InvalidNumber("BANDWIDTH must be positive"))
      }
      bw = v
      has_bw = true
    } else if klen == 17 && b0 == 65 && slice_eq(input, ks, ke, "AVERAGE-BANDWIDTH") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: AVERAGE-BANDWIDTH"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("AVERAGE-BANDWIDTH must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v <= 0L {
        return set_err(st, HlsError::InvalidNumber("AVERAGE-BANDWIDTH must be positive"))
      }
      avg_bw = Some(v)
    } else if klen == 6 && b0 == 67 && slice_eq(input, ks, ke, "CODECS") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CODECS"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CODECS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      codecs = Some(x)
    } else if klen == 10 && b0 == 82 && slice_eq(input, ks, ke, "RESOLUTION") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: RESOLUTION"))
      }
      seen = seen | 8
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("RESOLUTION must not be quoted"))
      }
      res = parse_resolution_raw(input, vs, ve, st)
      if st.has_err {
        return false
      }
    } else if klen == 10 && b0 == 70 && slice_eq(input, ks, ke, "FRAME-RATE") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: FRAME-RATE"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("FRAME-RATE must not be quoted"))
      }
      let v = parse_mhz_raw(input, vs, ve)
      if v <= 0L {
        return set_err(st, HlsError::InvalidNumber("FRAME-RATE must be positive"))
      }
      fps = Some(v)
    } else if klen == 10 && b0 == 72 && slice_eq(input, ks, ke, "HDCP-LEVEL") {
      if (seen & 32) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: HDCP-LEVEL"))
      }
      seen = seen | 32
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("HDCP-LEVEL must not be quoted"))
      }
      hdcp = parse_hdcp_raw(input, vs, ve, st)
      if st.has_err {
        return false
      }
    } else if klen == 5 && b0 == 65 && slice_eq(input, ks, ke, "AUDIO") {
      if (seen & 64) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: AUDIO"))
      }
      seen = seen | 64
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("AUDIO must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      audio = Some(x)
    } else if klen == 5 && b0 == 86 && slice_eq(input, ks, ke, "VIDEO") {
      if (seen & 128) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: VIDEO"))
      }
      seen = seen | 128
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("VIDEO must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      video = Some(x)
    } else if klen == 9 && b0 == 83 && slice_eq(input, ks, ke, "SUBTITLES") {
      if (seen & 256) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SUBTITLES"))
      }
      seen = seen | 256
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SUBTITLES must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      subs = Some(x)
    } else if klen == 15 && b0 == 67 && slice_eq(input, ks, ke, "CLOSED-CAPTIONS") {
      if (seen & 512) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CLOSED-CAPTIONS"))
      }
      seen = seen | 512
      if !cur.quoted && slice_eq(input, vs, ve, "NONE") {
        cc = Some(ClosedCaptionsRef::None)
      } else if cur.quoted {
        let x = sub_slice(input, vs, ve, st, limits)
        if st.has_err {
          return false
        }
        cc = Some(ClosedCaptionsRef::GroupId(x))
      } else {
        return set_err(st, HlsError::InvalidAttribute("CLOSED-CAPTIONS must be NONE or quoted group-id"))
      }
    } else if klen == 5 && b0 == 83 && slice_eq(input, ks, ke, "SCORE") {
      if (seen & 1024) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SCORE"))
      }
      seen = seen | 1024
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SCORE must not be quoted"))
      }
      let x = parse_us_raw(input, vs, ve)
      if x < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid SCORE"))
      }
      score = Some(x)
    } else if klen == 10 && b0 == 80 && slice_eq(input, ks, ke, "PATHWAY-ID") {
      if (seen & 2048) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PATHWAY-ID"))
      }
      seen = seen | 2048
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PATHWAY-ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      pathway = Some(x)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }

  if !has_bw {
    return set_err(st, HlsError::MissingRequiredAttribute("BANDWIDTH"))
  }
  st.pending_stream_inf = Some(PendingStreamInf::{
    bandwidth: bw,
    average_bandwidth: avg_bw,
    codecs: codecs,
    resolution: res,
    frame_rate_mhz: fps,
    hdcp_level: hdcp,
    audio: audio,
    video: video,
    subtitles: subs,
    closed_captions: cc,
    score_micros: score,
    pathway_id: pathway,
  })
  true
}

fn parse_iframe_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_bw = false
  let mut bw = 0L
  let mut avg_bw : Option[Int64] = None
  let mut uri : Option[String] = None
  let mut codecs : Option[String] = None
  let mut res : Option[Resolution] = None
  let mut hdcp : Option[HdcpLevel] = None
  let mut video : Option[String] = None
  let mut score : Option[Int64] = None
  let mut pathway : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 9 && b0 == 66 && slice_eq(input, ks, ke, "BANDWIDTH") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BANDWIDTH"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("BANDWIDTH must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v <= 0L {
        return set_err(st, HlsError::InvalidNumber("BANDWIDTH must be positive"))
      }
      bw = v
      has_bw = true
    } else if klen == 17 && b0 == 65 && slice_eq(input, ks, ke, "AVERAGE-BANDWIDTH") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: AVERAGE-BANDWIDTH"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("AVERAGE-BANDWIDTH must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid AVERAGE-BANDWIDTH"))
      }
      avg_bw = Some(v)
    } else if klen == 3 && b0 == 85 && slice_eq(input, ks, ke, "URI") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("I-FRAME URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 6 && b0 == 67 && slice_eq(input, ks, ke, "CODECS") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CODECS"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CODECS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      codecs = Some(x)
    } else if klen == 10 && b0 == 82 && slice_eq(input, ks, ke, "RESOLUTION") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: RESOLUTION"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("RESOLUTION must not be quoted"))
      }
      res = parse_resolution_raw(input, vs, ve, st)
      if st.has_err {
        return false
      }
    } else if klen == 10 && b0 == 72 && slice_eq(input, ks, ke, "HDCP-LEVEL") {
      if (seen & 32) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: HDCP-LEVEL"))
      }
      seen = seen | 32
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("HDCP-LEVEL must not be quoted"))
      }
      hdcp = parse_hdcp_raw(input, vs, ve, st)
      if st.has_err {
        return false
      }
    } else if klen == 5 && b0 == 86 && slice_eq(input, ks, ke, "VIDEO") {
      if (seen & 64) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: VIDEO"))
      }
      seen = seen | 64
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("VIDEO must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      video = Some(x)
    } else if klen == 5 && b0 == 83 && slice_eq(input, ks, ke, "SCORE") {
      if (seen & 128) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SCORE"))
      }
      seen = seen | 128
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SCORE must not be quoted"))
      }
      let x = parse_us_raw(input, vs, ve)
      if x < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid SCORE"))
      }
      score = Some(x)
    } else if klen == 10 && b0 == 80 && slice_eq(input, ks, ke, "PATHWAY-ID") {
      if (seen & 256) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PATHWAY-ID"))
      }
      seen = seen | 256
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PATHWAY-ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      pathway = Some(x)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  if !has_bw {
    return set_err(st, HlsError::MissingRequiredAttribute("BANDWIDTH"))
  }
  let u = match uri {
    Some(x) => {
      if x.length() == 0 {
        return set_err(st, HlsError::MissingRequiredAttribute("URI"))
      }
      x
    }
    None => return set_err(st, HlsError::MissingRequiredAttribute("URI"))
  }
  st.iframe_streams.push(IFrameStream::{
    uri: u,
    bandwidth: bw,
    average_bandwidth: avg_bw,
    codecs: codecs,
    resolution: res,
    hdcp_level: hdcp,
    video: video,
    score_micros: score,
    pathway_id: pathway,
  })
  true
}

fn parse_media_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut mtype : Option[MediaType] = None
  let mut group_id : Option[String] = None
  let mut name : Option[String] = None
  let mut uri : Option[String] = None
  let mut lang : Option[String] = None
  let mut assoc_lang : Option[String] = None
  let mut is_def = false
  let mut has_autoselect = false
  let mut autoselect = false
  let mut has_forced = false
  let mut forced = false
  let mut instream_id : Option[String] = None
  let mut chars : Option[String] = None
  let mut channels : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 4 && b0 == 84 && slice_eq(input, ks, ke, "TYPE") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: TYPE"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("MEDIA TYPE must not be quoted"))
      }
      if slice_eq(input, vs, ve, "AUDIO") {
        mtype = Some(MediaType::Audio)
      } else if slice_eq(input, vs, ve, "VIDEO") {
        mtype = Some(MediaType::Video)
      } else if slice_eq(input, vs, ve, "SUBTITLES") {
        mtype = Some(MediaType::Subtitles)
      } else if slice_eq(input, vs, ve, "CLOSED-CAPTIONS") {
        mtype = Some(MediaType::ClosedCaptions)
      } else {
        return set_err(st, HlsError::InvalidAttribute("unknown MEDIA TYPE: " + input.slice(vs, ve)))
      }
    } else if klen == 8 && b0 == 71 && slice_eq(input, ks, ke, "GROUP-ID") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: GROUP-ID"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("GROUP-ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      group_id = Some(x)
    } else if klen == 4 && b0 == 78 && slice_eq(input, ks, ke, "NAME") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: NAME"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("NAME must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      name = Some(x)
    } else if klen == 3 && b0 == 85 && slice_eq(input, ks, ke, "URI") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("MEDIA URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 8 && b0 == 76 && slice_eq(input, ks, ke, "LANGUAGE") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: LANGUAGE"))
      }
      seen = seen | 16
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("LANGUAGE must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      lang = Some(x)
    } else if klen == 14 && b0 == 65 && slice_eq(input, ks, ke, "ASSOC-LANGUAGE") {
      if (seen & 32) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: ASSOC-LANGUAGE"))
      }
      seen = seen | 32
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("ASSOC-LANGUAGE must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      assoc_lang = Some(x)
    } else if klen == 7 && b0 == 68 && slice_eq(input, ks, ke, "DEFAULT") {
      if (seen & 64) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: DEFAULT"))
      }
      seen = seen | 64
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DEFAULT must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("DEFAULT must be YES or NO"))
      }
      is_def = yn == 1
    } else if klen == 10 && b0 == 65 && slice_eq(input, ks, ke, "AUTOSELECT") {
      if (seen & 128) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: AUTOSELECT"))
      }
      seen = seen | 128
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("AUTOSELECT must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("AUTOSELECT must be YES or NO"))
      }
      has_autoselect = true
      autoselect = yn == 1
    } else if klen == 6 && b0 == 70 && slice_eq(input, ks, ke, "FORCED") {
      if (seen & 256) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: FORCED"))
      }
      seen = seen | 256
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("FORCED must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("FORCED must be YES or NO"))
      }
      has_forced = true
      forced = yn == 1
    } else if klen == 11 && b0 == 73 && slice_eq(input, ks, ke, "INSTREAM-ID") {
      if (seen & 512) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: INSTREAM-ID"))
      }
      seen = seen | 512
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("INSTREAM-ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      instream_id = Some(x)
    } else if klen == 15 && b0 == 67 && slice_eq(input, ks, ke, "CHARACTERISTICS") {
      if (seen & 1024) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CHARACTERISTICS"))
      }
      seen = seen | 1024
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CHARACTERISTICS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      chars = Some(x)
    } else if klen == 8 && b0 == 67 && slice_eq(input, ks, ke, "CHANNELS") {
      if (seen & 2048) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CHANNELS"))
      }
      seen = seen | 2048
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CHANNELS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      channels = Some(x)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let mt = match mtype {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("TYPE"))
  }
  let gid = match group_id {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("GROUP-ID"))
  }
  let nm = match name {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("NAME"))
  }
  if is_def && has_autoselect && !autoselect {
    return set_err(st, HlsError::InvalidAttribute("DEFAULT=YES forbids AUTOSELECT=NO"))
  }
  if has_forced {
    match mt {
      MediaType::Subtitles => ()
      _ => return set_err(st, HlsError::InvalidAttribute("FORCED is only valid for TYPE=SUBTITLES"))
    }
  }
  match instream_id {
    Some(_) => {
      match mt {
        MediaType::ClosedCaptions => ()
        _ => return set_err(st, HlsError::InvalidAttribute("INSTREAM-ID is only valid for TYPE=CLOSED-CAPTIONS"))
      }
    }
    None => ()
  }
  match channels {
    Some(_) => {
      match mt {
        MediaType::Audio => ()
        _ => return set_err(st, HlsError::InvalidAttribute("CHANNELS is only valid for TYPE=AUDIO"))
      }
    }
    None => ()
  }
  match mt {
    MediaType::ClosedCaptions => {
      match uri {
        Some(_) => return set_err(st, HlsError::InvalidAttribute("CLOSED-CAPTIONS must not have URI"))
        None => ()
      }
      match instream_id {
        Some(_) => ()
        None => return set_err(st, HlsError::MissingRequiredAttribute("INSTREAM-ID"))
      }
    }
    _ => ()
  }
  st.media_renditions.push(MediaRendition::{
    media_type: mt,
    group_id: gid,
    name: nm,
    uri: uri,
    language: lang,
    assoc_language: assoc_lang,
    is_default: is_def,
    autoselect: autoselect,
    forced: forced,
    instream_id: instream_id,
    characteristics: chars,
    channels: channels,
  })
  true
}

fn parse_session_data_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut data_id : Option[String] = None
  let mut sdata_val : Option[String] = None
  let mut uri : Option[String] = None
  let mut lang : Option[String] = None
  let mut fmt : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 7 && slice_eq(input, ks, ke, "DATA-ID") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: DATA-ID"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DATA-ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      data_id = Some(x)
    } else if klen == 5 && slice_eq(input, ks, ke, "VALUE") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: VALUE"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SESSION-DATA VALUE must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      sdata_val = Some(x)
    } else if klen == 3 && slice_eq(input, ks, ke, "URI") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SESSION-DATA URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 8 && slice_eq(input, ks, ke, "LANGUAGE") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: LANGUAGE"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("LANGUAGE must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      lang = Some(x)
    } else if klen == 6 && slice_eq(input, ks, ke, "FORMAT") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: FORMAT"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("FORMAT must not be quoted"))
      }
      if slice_eq(input, vs, ve, "JSON") {
        fmt = Some("JSON")
      } else if slice_eq(input, vs, ve, "RAW") {
        fmt = Some("RAW")
      } else {
        return set_err(st, HlsError::InvalidAttribute("SESSION-DATA FORMAT must be JSON or RAW"))
      }
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let did = match data_id {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("DATA-ID"))
  }
  match (sdata_val, uri) {
    (Some(_), Some(_)) =>
    return set_err(st, HlsError::InvalidAttribute("SESSION-DATA cannot have both VALUE and URI"))
    (None, None) =>
    return set_err(st, HlsError::MissingRequiredAttribute("VALUE or URI"))
    _ => ()
  }
  st.session_data.push(SessionData::{
    data_id: did,
    value: sdata_val,
    uri: uri,
    language: lang,
    format: fmt,
  })
  true
}

fn parse_map_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut uri : Option[String] = None
  let mut br : Option[ByteRange] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 3 && slice_eq(input, ks, ke, "URI") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("MAP URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 9 && slice_eq(input, ks, ke, "BYTERANGE") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BYTERANGE"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("MAP BYTERANGE must be quoted"))
      }
      let ok = if !st.line_has_lbrace {
        parse_byterange_raw(input, vs, ve, st)
      } else {
        let br_str = sub_slice(input, vs, ve, st, limits)
        if st.has_err {
          return false
        }
        parse_byterange_raw(br_str, 0, br_str.length(), st)
      }
      if !ok {
        return false
      }
      if !st.tmp_br_has_off {
        return set_err(st, HlsError::InvalidByteRange("EXT-X-MAP BYTERANGE requires @offset"))
      }
      br = Some(ByteRange::{ length: st.tmp_br_len, offset: Some(st.tmp_br_off) })
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let u = match uri {
    Some(x) => {
      if x.length() == 0 {
        return set_err(st, HlsError::MissingRequiredAttribute("URI"))
      }
      x
    }
    None => return set_err(st, HlsError::MissingRequiredAttribute("URI"))
  }
  st.pending_keys_before_map = st.pending_keys.length()
  st.pending_map = Some(MediaMap::{ uri: u, byterange: br })
  true
}

fn parse_daterange_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut id : Option[String] = None
  let mut class_name : Option[String] = None
  let mut start_date : Option[String] = None
  let mut end_date : Option[String] = None
  let mut dur_us : Option[Int64] = None
  let mut planned_us : Option[Int64] = None
  let mut end_on_next = false
  let mut scte_cmd : Option[String] = None
  let mut scte_out : Option[String] = None
  let mut scte_in : Option[String] = None
  let client_attrs : Array[AttrPair] = []

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 2 && b0 == 73 && slice_eq(input, ks, ke, "ID") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: ID"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DATERANGE ID must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      id = Some(x)
    } else if klen == 5 && b0 == 67 && slice_eq(input, ks, ke, "CLASS") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CLASS"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DATERANGE CLASS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      class_name = Some(x)
    } else if klen == 10 && b0 == 83 && slice_eq(input, ks, ke, "START-DATE") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: START-DATE"))
      }
      seen = seen | 4
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("START-DATE must be quoted"))
      }
      let v = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      if !validate_iso8601_ok(v, 0, v.length()) {
        return set_err(st, HlsError::InvalidDateTime("invalid START-DATE"))
      }
      start_date = Some(v)
    } else if klen == 8 && b0 == 69 && slice_eq(input, ks, ke, "END-DATE") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: END-DATE"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("END-DATE must be quoted"))
      }
      let v = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      if !validate_iso8601_ok(v, 0, v.length()) {
        return set_err(st, HlsError::InvalidDateTime("invalid END-DATE"))
      }
      end_date = Some(v)
    } else if klen == 8 && b0 == 68 && slice_eq(input, ks, ke, "DURATION") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: DURATION"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("DURATION must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid DURATION"))
      }
      dur_us = Some(v)
    } else if klen == 16 && b0 == 80 && slice_eq(input, ks, ke, "PLANNED-DURATION") {
      if (seen & 32) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PLANNED-DURATION"))
      }
      seen = seen | 32
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PLANNED-DURATION must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid PLANNED-DURATION"))
      }
      planned_us = Some(v)
    } else if klen == 11 && b0 == 69 && slice_eq(input, ks, ke, "END-ON-NEXT") {
      if (seen & 64) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: END-ON-NEXT"))
      }
      seen = seen | 64
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("END-ON-NEXT must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("END-ON-NEXT must be YES or NO"))
      }
      end_on_next = yn == 1
    } else if klen == 10 && b0 == 83 && slice_eq(input, ks, ke, "SCTE35-CMD") {
      if (seen & 128) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SCTE35-CMD"))
      }
      seen = seen | 128
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SCTE35-CMD must not be quoted"))
      }
      let v = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      if !validate_hex_sequence_ok(v, 0, v.length()) {
        return set_err(st, HlsError::InvalidAttribute("invalid hex sequence in SCTE35-CMD"))
      }
      scte_cmd = Some(v)
    } else if klen == 10 && b0 == 83 && slice_eq(input, ks, ke, "SCTE35-OUT") {
      if (seen & 256) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SCTE35-OUT"))
      }
      seen = seen | 256
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SCTE35-OUT must not be quoted"))
      }
      let v = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      if !validate_hex_sequence_ok(v, 0, v.length()) {
        return set_err(st, HlsError::InvalidAttribute("invalid hex sequence in SCTE35-OUT"))
      }
      scte_out = Some(v)
    } else if klen == 9 && b0 == 83 && slice_eq(input, ks, ke, "SCTE35-IN") {
      if (seen & 512) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SCTE35-IN"))
      }
      seen = seen | 512
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SCTE35-IN must not be quoted"))
      }
      let v = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      if !validate_hex_sequence_ok(v, 0, v.length()) {
        return set_err(st, HlsError::InvalidAttribute("invalid hex sequence in SCTE35-IN"))
      }
      scte_in = Some(v)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
      if klen >= 2 && b0 == 88 && input.code_unit_at(ks + 1) == 45 {
        let key_str = input.slice(ks, ke)
        if cur.quoted {
          let v = sub_slice(input, vs, ve, st, limits)
          if st.has_err {
            return false
          }
          client_attrs.push(AttrPair::{
            key: key_str,
            value: v,
            quoted: true,
          })
        } else {
          if !validate_hex_sequence_ok(input, vs, ve) && !is_valid_decimal_float_slice(input, vs, ve) {
            return set_err(st, HlsError::InvalidAttribute("unquoted X-attribute must be hex or decimal-float: " + key_str))
          }
          client_attrs.push(AttrPair::{
            key: key_str,
            value: input.slice(vs, ve),
            quoted: false,
          })
        }
      }
    }
  }
  let dr_id = match id {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("ID"))
  }
  let dr_sd = match start_date {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("START-DATE"))
  }
  if end_on_next {
    match class_name {
      Some(_) => ()
      None =>
      return set_err(st, HlsError::MissingRequiredAttribute("CLASS required with END-ON-NEXT=YES"))
    }
    match (dur_us, end_date) {
      (None, None) => ()
      _ =>
      return set_err(st, HlsError::InvalidAttribute("END-ON-NEXT=YES forbids DURATION and END-DATE"))
    }
  }
  st.dateranges.push(DateRange::{
    id: dr_id,
    class_name: class_name,
    start_date: dr_sd,
    end_date: end_date,
    duration_us: dur_us,
    planned_duration_us: planned_us,
    end_on_next: end_on_next,
    scte35_cmd: scte_cmd,
    scte35_out: scte_out,
    scte35_in: scte_in,
    client_attributes: client_attrs,
  })
  true
}

fn parse_server_control_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut csu : Option[Int64] = None
  let mut csd = false
  let mut hb : Option[Int64] = None
  let mut phb : Option[Int64] = None
  let mut cbr = false

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 14 && slice_eq(input, ks, ke, "CAN-SKIP-UNTIL") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CAN-SKIP-UNTIL"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CAN-SKIP-UNTIL must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid CAN-SKIP-UNTIL"))
      }
      csu = Some(v)
    } else if klen == 19 && slice_eq(input, ks, ke, "CAN-SKIP-DATERANGES") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CAN-SKIP-DATERANGES"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CAN-SKIP-DATERANGES must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("CAN-SKIP-DATERANGES must be YES or NO"))
      }
      csd = yn == 1
    } else if klen == 9 && slice_eq(input, ks, ke, "HOLD-BACK") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: HOLD-BACK"))
      }
      seen = seen | 4
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("HOLD-BACK must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid HOLD-BACK"))
      }
      hb = Some(v)
    } else if klen == 14 && slice_eq(input, ks, ke, "PART-HOLD-BACK") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PART-HOLD-BACK"))
      }
      seen = seen | 8
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PART-HOLD-BACK must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid PART-HOLD-BACK"))
      }
      phb = Some(v)
    } else if klen == 16 && slice_eq(input, ks, ke, "CAN-BLOCK-RELOAD") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: CAN-BLOCK-RELOAD"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("CAN-BLOCK-RELOAD must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("CAN-BLOCK-RELOAD must be YES or NO"))
      }
      cbr = yn == 1
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  st.server_control = Some(ServerControl::{
    can_skip_until_us: csu,
    can_skip_dateranges: csd,
    hold_back_us: hb,
    part_hold_back_us: phb,
    can_block_reload: cbr,
  })
  true
}

fn parse_part_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_uri = false
  let mut uri = ""
  let mut has_dur = false
  let mut dur_us = 0L
  let mut indep = false
  let mut has_br = false
  let mut br_len = 0L
  let mut br_has_off = false
  let mut br_off = 0L
  let mut gap = false

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 3 && b0 == 85 && slice_eq(input, ks, ke, "URI") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PART URI must be quoted"))
      }
      uri = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      has_uri = true
    } else if klen == 8 && b0 == 68 && slice_eq(input, ks, ke, "DURATION") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: DURATION"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PART DURATION must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid PART DURATION"))
      }
      dur_us = v
      has_dur = true
    } else if klen == 11 && b0 == 73 && slice_eq(input, ks, ke, "INDEPENDENT") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: INDEPENDENT"))
      }
      seen = seen | 4
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("INDEPENDENT must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("INDEPENDENT must be YES or NO"))
      }
      indep = yn == 1
    } else if klen == 9 && b0 == 66 && slice_eq(input, ks, ke, "BYTERANGE") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BYTERANGE"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PART BYTERANGE must be quoted"))
      }
      let ok = if !st.line_has_lbrace {
        parse_byterange_raw(input, vs, ve, st)
      } else {
        let br_str = sub_slice(input, vs, ve, st, limits)
        if st.has_err {
          return false
        }
        parse_byterange_raw(br_str, 0, br_str.length(), st)
      }
      if !ok {
        return false
      }
      has_br = true
      br_len = st.tmp_br_len
      br_has_off = st.tmp_br_has_off
      br_off = st.tmp_br_off
    } else if klen == 3 && b0 == 71 && slice_eq(input, ks, ke, "GAP") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: GAP"))
      }
      seen = seen | 16
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("GAP must not be quoted"))
      }
      let yn = parse_yes_no_raw(input, vs, ve)
      if yn < 0 {
        return set_err(st, HlsError::InvalidAttribute("GAP must be YES or NO"))
      }
      gap = yn == 1
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  if !has_uri {
    return set_err(st, HlsError::MissingRequiredAttribute("URI"))
  }
  if !has_dur {
    return set_err(st, HlsError::MissingRequiredAttribute("DURATION"))
  }
  let resolved_br : Option[ByteRange] = if !has_br {
    st.has_prev_part_br_end = false
    None
  } else {
    let eff_off = if br_has_off {
      br_off
    } else {
      if st.has_prev_part_uri && st.has_prev_part_br_end {
        if st.prev_part_uri != uri {
          return set_err(st, HlsError::InvalidByteRange("implicit PART BYTERANGE offset requires same URI as previous part"))
        }
        st.prev_part_br_end
      } else {
        return set_err(st, HlsError::InvalidByteRange("implicit PART BYTERANGE offset requires preceding byterange part"))
      }
    }
    if eff_off > 9223372036854775807L - br_len {
      return set_err(st, HlsError::InvalidByteRange("PART BYTERANGE offset + length overflow"))
    }
    st.has_prev_part_uri = true
    st.prev_part_uri = uri
    st.has_prev_part_br_end = true
    st.prev_part_br_end = eff_off + br_len
    Some(ByteRange::{ length: br_len, offset: Some(eff_off) })
  }
  st.has_parts = true
  if dur_us > st.max_part_dur_us {
    st.max_part_dur_us = dur_us
  }
  st.total_parts = st.total_parts + 1
  st.pending_parts.push(PartialSegment::{
    uri: uri,
    duration_us: dur_us,
    independent: indep,
    byterange: resolved_br,
    gap: gap,
  })
  true
}

fn parse_preload_hint_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut htype : Option[PreloadHintType] = None
  let mut uri : Option[String] = None
  let mut bs : Option[Int64] = None
  let mut bl : Option[Int64] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 4 && slice_eq(input, ks, ke, "TYPE") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: TYPE"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PRELOAD-HINT TYPE must not be quoted"))
      }
      if slice_eq(input, vs, ve, "PART") {
        htype = Some(PreloadHintType::Part)
      } else if slice_eq(input, vs, ve, "MAP") {
        htype = Some(PreloadHintType::Map)
      } else {
        return set_err(st, HlsError::InvalidAttribute("PRELOAD-HINT TYPE must be PART or MAP"))
      }
    } else if klen == 3 && slice_eq(input, ks, ke, "URI") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PRELOAD-HINT URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 15 && slice_eq(input, ks, ke, "BYTERANGE-START") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BYTERANGE-START"))
      }
      seen = seen | 4
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("BYTERANGE-START must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid BYTERANGE-START"))
      }
      bs = Some(v)
    } else if klen == 16 && slice_eq(input, ks, ke, "BYTERANGE-LENGTH") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: BYTERANGE-LENGTH"))
      }
      seen = seen | 8
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("BYTERANGE-LENGTH must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid BYTERANGE-LENGTH"))
      }
      bl = Some(v)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let ht = match htype {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("TYPE"))
  }
  let u = match uri {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("URI"))
  }
  st.preload_hints.push(PreloadHint::{
    hint_type: ht,
    uri: u,
    byterange_start: bs,
    byterange_length: bl,
  })
  true
}

fn parse_rendition_report_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut uri : Option[String] = None
  let mut last_msn : Option[Int64] = None
  let mut last_part : Option[Int64] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 3 && slice_eq(input, ks, ke, "URI") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 1
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("RENDITION-REPORT URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 8 && slice_eq(input, ks, ke, "LAST-MSN") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: LAST-MSN"))
      }
      seen = seen | 2
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("LAST-MSN must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid LAST-MSN"))
      }
      last_msn = Some(v)
    } else if klen == 9 && slice_eq(input, ks, ke, "LAST-PART") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: LAST-PART"))
      }
      seen = seen | 4
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("LAST-PART must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid LAST-PART"))
      }
      last_part = Some(v)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  let u = match uri {
    Some(x) => x
    None => return set_err(st, HlsError::MissingRequiredAttribute("URI"))
  }
  st.rendition_reports.push(RenditionReport::{
    uri: u,
    last_msn: last_msn,
    last_part: last_part,
  })
  true
}

fn parse_skip_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_skipped = false
  let mut skipped = 0L
  let mut removed : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 16 && slice_eq(input, ks, ke, "SKIPPED-SEGMENTS") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: SKIPPED-SEGMENTS"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("SKIPPED-SEGMENTS must not be quoted"))
      }
      let v = parse_uint64_raw(input, vs, ve)
      if v < 0L {
        return set_err(st, HlsError::InvalidNumber("invalid SKIPPED-SEGMENTS"))
      }
      skipped = v
      has_skipped = true
    } else if klen == 27 && slice_eq(input, ks, ke, "RECENTLY-REMOVED-DATERANGES") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: RECENTLY-REMOVED-DATERANGES"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("RECENTLY-REMOVED-DATERANGES must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      removed = Some(x)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  if !has_skipped {
    return set_err(st, HlsError::MissingRequiredAttribute("SKIPPED-SEGMENTS"))
  }
  st.skip_tag = Some(SkipTag::{
    skipped_segments: skipped,
    recently_removed_dateranges: removed,
  })
  true
}

fn parse_part_inf_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut has_pt = false
  let mut pt = 0L

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    if klen == 11 && slice_eq(input, ks, ke, "PART-TARGET") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: PART-TARGET"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("PART-TARGET must not be quoted"))
      }
      let v = parse_us_raw(input, vs, ve)
      if v <= 0L {
        return set_err(st, HlsError::InvalidNumber("PART-TARGET must be positive"))
      }
      pt = v
      has_pt = true
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }
  if !has_pt {
    return set_err(st, HlsError::MissingRequiredAttribute("PART-TARGET"))
  }
  st.part_inf = Some(PartInf::{ part_target_us: pt })
  true
}

struct ParserState {
  attr_cur : AttrCursor
  mut has_err : Bool
  mut err : Option[HlsError]
  mut line_has_lbrace : Bool
  mut tmp_br_len : Int64
  mut tmp_br_has_off : Bool
  mut tmp_br_off : Int64
  mut is_master : Bool
  mut is_media : Bool
  mut version : Option[Int]
  mut independent_segments : Bool
  mut start_tag : Option[StartTag]
  defines : Array[DefineTag]
  mut define_names : Option[Map[String, Bool]]
  mut define_values : Option[Map[String, String]]
  mut has_import_define : Bool
  mut expanded_bytes : Int
  mut total_parts : Int
  mut total_custom_tags : Int
  custom_tags : Array[CustomTag]
  variants : Array[VariantStream]
  iframe_streams : Array[IFrameStream]
  media_renditions : Array[MediaRendition]
  session_data : Array[SessionData]
  session_keys : Array[EncryptionKey]
  mut pending_stream_inf : Option[PendingStreamInf]
  mut target_duration : Option[Int64]
  mut media_sequence : Option[Int64]
  mut discontinuity_sequence : Option[Int64]
  mut playlist_type : Option[PlaylistType]
  mut end_list : Bool
  mut i_frames_only : Bool
  mut server_control : Option[ServerControl]
  mut part_inf : Option[PartInf]
  mut skip_tag : Option[SkipTag]
  mut segments : Array[MediaSegment]
  mut segments_reserved : Bool
  preload_hints : Array[PreloadHint]
  rendition_reports : Array[RenditionReport]
  dateranges : Array[DateRange]
  mut has_pending_extinf : Bool
  mut pending_extinf_us : Int64
  mut pending_extinf_title : Option[String]
  mut has_pending_byterange : Bool
  mut pending_br_len : Int64
  mut pending_br_has_off : Bool
  mut pending_br_off : Int64
  mut pending_discontinuity : Bool
  mut pending_gap : Bool
  mut pending_pdt : Option[String]
  mut pending_key : Option[EncryptionKey]
  mut pending_keys : Array[EncryptionKey]
  mut pending_map : Option[MediaMap]
  mut pending_keys_before_map : Int
  mut pending_parts : Array[PartialSegment]
  mut pending_custom_tags : Array[CustomTag]
  mut has_prev_seg_uri : Bool
  mut prev_seg_uri : String
  mut has_prev_seg_br_end : Bool
  mut prev_seg_br_end : Int64
  mut has_prev_part_uri : Bool
  mut prev_part_uri : String
  mut has_prev_part_br_end : Bool
  mut prev_part_br_end : Int64
  mut max_seg_dur_us : Int64
  mut max_part_dur_us : Int64
  mut total_dur_us : Int64
  mut dur_overflow : Bool
  mut disc_count : Int64
  mut has_parts : Bool
}

fn new_parser_state() -> ParserState {
  ParserState::{
    attr_cur: new_attr_cursor(),
    has_err: false,
    err: None,
    line_has_lbrace: false,
    tmp_br_len: 0L,
    tmp_br_has_off: false,
    tmp_br_off: 0L,
    is_master: false,
    is_media: false,
    version: None,
    independent_segments: false,
    start_tag: None,
    defines: [],
    define_names: None,
    define_values: None,
    has_import_define: false,
    expanded_bytes: 0,
    total_parts: 0,
    total_custom_tags: 0,
    custom_tags: [],
    variants: [],
    iframe_streams: [],
    media_renditions: [],
    session_data: [],
    session_keys: [],
    pending_stream_inf: None,
    target_duration: None,
    media_sequence: None,
    discontinuity_sequence: None,
    playlist_type: None,
    end_list: false,
    i_frames_only: false,
    server_control: None,
    part_inf: None,
    skip_tag: None,
    segments: [],
    segments_reserved: false,
    preload_hints: [],
    rendition_reports: [],
    dateranges: [],
    has_pending_extinf: false,
    pending_extinf_us: 0L,
    pending_extinf_title: None,
    has_pending_byterange: false,
    pending_br_len: 0L,
    pending_br_has_off: false,
    pending_br_off: 0L,
    pending_discontinuity: false,
    pending_gap: false,
    pending_pdt: None,
    pending_key: None,
    pending_keys: [],
    pending_map: None,
    pending_keys_before_map: 0,
    pending_parts: [],
    pending_custom_tags: [],
    has_prev_seg_uri: false,
    prev_seg_uri: "",
    has_prev_seg_br_end: false,
    prev_seg_br_end: 0L,
    has_prev_part_uri: false,
    prev_part_uri: "",
    has_prev_part_br_end: false,
    prev_part_br_end: 0L,
    max_seg_dur_us: 0L,
    max_part_dur_us: 0L,
    total_dur_us: 0L,
    dur_overflow: false,
    disc_count: 0L,
    has_parts: false,
  }
}

fn handle_custom_tag(
  st : ParserState,
  input : String,
  line_start : Int,
  tag_end : Int,
  colon : Int,
  val_start : Int,
  line_end : Int,
  limits : HlsLimits,
) -> Bool {
  if st.total_custom_tags >= limits.max_custom_tags {
    return set_err(st, HlsError::LimitExceeded("max_custom_tags exceeded"))
  }
  let cname = input.slice(line_start, tag_end)
  let cval = if colon >= 0 {
    Some(input.slice(val_start, line_end))
  } else {
    None
  }
  let ct = CustomTag::{ name: cname, value: cval }
  st.total_custom_tags = st.total_custom_tags + 1
  if st.is_media && (st.segments.length() > 0 || st.has_pending_extinf) {
    st.pending_custom_tags.push(ct)
  } else {
    st.custom_tags.push(ct)
  }
  true
}

fn handle_tag_line(
  st : ParserState,
  input : String,
  line_start : Int,
  line_end : Int,
  limits : HlsLimits,
  import_vars : Array[(String, String)],
  query_params : Array[(String, String)],
) -> Bool {
  let line_len = line_end - line_start

  // Fast path #1: `#EXTINF:...` (most frequent tag in Media Playlists — zero `:` scan, zero heap alloc!)
  if line_len >= 7 &&
  input.code_unit_at(line_start + 4) == 73 &&
  input.code_unit_at(line_start + 5) == 78 &&
  input.code_unit_at(line_start + 6) == 70 {
    if line_len == 7 || input.code_unit_at(line_start + 7) == 58 {
      st.is_media = true
      if st.is_master {
        return set_err(st, HlsError::MixedPlaylistTags("#EXTINF in Master Playlist"))
      }
      if st.has_pending_extinf {
        return set_err(st, HlsError::InvalidSyntax("dangling #EXTINF without URI"))
      }
      if line_len == 7 {
        return set_err(st, HlsError::InvalidTag("#EXTINF requires duration"))
      }
      let val_start = line_start + 8
      // Single-pass duration + comma scan
      if val_start >= line_end {
        return set_err(st, HlsError::InvalidTag("#EXTINF missing required comma"))
      }
      let mut i = val_start
      let d0 = input.code_unit_at(i) - 48
      if d0 < 0 || d0 > 9 {
        let comma = find_byte_in(input, val_start, line_end, 44)
        if comma < 0 {
          return set_err(st, HlsError::InvalidTag("#EXTINF missing required comma"))
        }
        return set_err(st, HlsError::InvalidNumber("invalid #EXTINF duration"))
      }
      let mut whole = d0.to_int64()
      i = i + 1
      while i < line_end {
        let d = input.code_unit_at(i) - 48
        if d >= 0 && d <= 9 {
          if whole >= 922337203685L {
            if whole > 922337203685L || d > 4 {
              return set_err(st, HlsError::InvalidNumber("invalid #EXTINF duration"))
            }
          }
          whole = whole * 10L + d.to_int64()
          i = i + 1
        } else {
          break
        }
      }
      let mut frac = 0L
      let mut round_up = false
      if i < line_end && input.code_unit_at(i) == 46 {
        i = i + 1
        if i >= line_end {
          return set_err(st, HlsError::InvalidTag("#EXTINF missing required comma"))
        }
        let fd0 = input.code_unit_at(i) - 48
        if fd0 < 0 || fd0 > 9 {
          return set_err(st, HlsError::InvalidNumber("invalid #EXTINF duration"))
        }
        frac = fd0.to_int64()
        let mut frac_digits = 1
        i = i + 1
        while i < line_end {
          let d = input.code_unit_at(i) - 48
          if d >= 0 && d <= 9 {
            if frac_digits < 6 {
              frac = frac * 10L + d.to_int64()
              frac_digits = frac_digits + 1
            } else if frac_digits == 6 {
              if d >= 5 {
                round_up = true
              }
              frac_digits = 7
            }
            i = i + 1
          } else {
            break
          }
        }
        if frac_digits == 1 {
          frac = frac * 100000L
        } else if frac_digits == 2 {
          frac = frac * 10000L
        } else if frac_digits == 3 {
          frac = frac * 1000L
        } else if frac_digits == 4 {
          frac = frac * 100L
        } else if frac_digits == 5 {
          frac = frac * 10L
        }
      }
      if i >= line_end || input.code_unit_at(i) != 44 {
        let comma = find_byte_in(input, i, line_end, 44)
        if comma < 0 {
          return set_err(st, HlsError::InvalidTag("#EXTINF missing required comma"))
        }
        return set_err(st, HlsError::InvalidNumber("invalid #EXTINF duration"))
      }
      let whole_scaled = whole * 1000000L
      let frac_with_round = if round_up { frac + 1L } else { frac }
      if whole_scaled > 9223372036854775807L - frac_with_round {
        return set_err(st, HlsError::InvalidNumber("invalid #EXTINF duration"))
      }
      st.has_pending_extinf = true
      st.pending_extinf_us = whole_scaled + frac_with_round
      if i + 1 < line_end {
        st.pending_extinf_title = Some(input.slice(i + 1, line_end))
      } else {
        st.pending_extinf_title = None
      }
      return true
    }
  }

  let colon = find_byte_in(input, line_start + 4, line_end, 58)
  let tag_end = if colon >= 0 { colon } else { line_end }
  let val_start = if colon >= 0 { colon + 1 } else { line_end }
  let tag_len = tag_end - line_start

  // All remaining known HLS tags start with `#EXT-X-` (length >= 10)
  if tag_len >= 10 &&
  input.code_unit_at(line_start + 4) == 45 &&
  input.code_unit_at(line_start + 5) == 88 &&
  input.code_unit_at(line_start + 6) == 45 {
    let t7 = line_start + 7
    let b7 = input.code_unit_at(t7)

    if tag_len == 16 {
      if b7 == 66 && slice_eq(input, t7, tag_end, "BYTERANGE") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-BYTERANGE in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidByteRange("#EXT-X-BYTERANGE requires value"))
        }
        if !parse_byterange_raw(input, val_start, line_end, st) {
          return false
        }
        st.has_pending_byterange = true
        st.pending_br_len = st.tmp_br_len
        st.pending_br_has_off = st.tmp_br_has_off
        st.pending_br_off = st.tmp_br_off
        return true
      }
      if b7 == 68 && slice_eq(input, t7, tag_end, "DATERANGE") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-DATERANGE in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-DATERANGE requires attributes"))
        }
        if st.dateranges.length() >= limits.max_dateranges {
          return set_err(st, HlsError::LimitExceeded("max_dateranges exceeded"))
        }
        return parse_daterange_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 24 {
      if b7 == 80 && slice_eq(input, t7, tag_end, "PROGRAM-DATE-TIME") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-PROGRAM-DATE-TIME in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidDateTime("#EXT-X-PROGRAM-DATE-TIME requires value"))
        }
        if !validate_iso8601_ok(input, val_start, line_end) {
          return set_err(st, HlsError::InvalidDateTime("invalid #EXT-X-PROGRAM-DATE-TIME"))
        }
        st.pending_pdt = Some(input.slice(val_start, line_end))
        return true
      }
    } else if tag_len == 10 {
      if b7 == 75 && slice_eq(input, t7, tag_end, "KEY") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-KEY in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-KEY requires attributes"))
        }
        return parse_key_attrs(input, val_start, line_end, st, limits, false)
      }
      if b7 == 77 && slice_eq(input, t7, tag_end, "MAP") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-MAP in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-MAP requires attributes"))
        }
        return parse_map_attrs(input, val_start, line_end, st, limits)
      }
      if b7 == 71 && slice_eq(input, t7, tag_end, "GAP") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-GAP in Master Playlist"))
        }
        st.pending_gap = true
        return true
      }
    } else if tag_len == 11 {
      if b7 == 80 && slice_eq(input, t7, tag_end, "PART") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-PART in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-PART requires attributes"))
        }
        if st.total_parts >= limits.max_parts {
          return set_err(st, HlsError::LimitExceeded("max_parts exceeded"))
        }
        return parse_part_attrs(input, val_start, line_end, st, limits)
      }
      if b7 == 83 && slice_eq(input, t7, tag_end, "SKIP") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-SKIP in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-SKIP requires attributes"))
        }
        match st.skip_tag {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-SKIP"))
          None => ()
        }
        return parse_skip_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 17 {
      if b7 == 83 && slice_eq(input, t7, tag_end, "STREAM-INF") {
        st.is_master = true
        if st.is_media {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-STREAM-INF in Media Playlist"))
        }
        match st.pending_stream_inf {
          Some(_) => return set_err(st, HlsError::InvalidSyntax("dangling #EXT-X-STREAM-INF without URI"))
          None => ()
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-STREAM-INF requires attributes"))
        }
        return parse_stream_inf_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 12 {
      if b7 == 77 && slice_eq(input, t7, tag_end, "MEDIA") {
        st.is_master = true
        if st.is_media {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-MEDIA in Media Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-MEDIA requires attributes"))
        }
        if st.media_renditions.length() >= limits.max_media {
          return set_err(st, HlsError::LimitExceeded("max_media exceeded"))
        }
        return parse_media_attrs(input, val_start, line_end, st, limits)
      }
      if b7 == 83 && slice_eq(input, t7, tag_end, "START") {
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-START requires attributes"))
        }
        match st.start_tag {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-START"))
          None => ()
        }
        return parse_start_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 20 {
      if b7 == 68 && slice_eq(input, t7, tag_end, "DISCONTINUITY") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-DISCONTINUITY in Master Playlist"))
        }
        st.pending_discontinuity = true
        return true
      }
      if b7 == 80 && slice_eq(input, t7, tag_end, "PLAYLIST-TYPE") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-PLAYLIST-TYPE in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-PLAYLIST-TYPE requires value"))
        }
        match st.playlist_type {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-PLAYLIST-TYPE"))
          None => ()
        }
        if slice_eq(input, val_start, line_end, "EVENT") {
          st.playlist_type = Some(PlaylistType::Event)
        } else if slice_eq(input, val_start, line_end, "VOD") {
          st.playlist_type = Some(PlaylistType::Vod)
        } else {
          return set_err(st, HlsError::InvalidTag("PLAYLIST-TYPE must be EVENT or VOD"))
        }
        return true
      }
      if b7 == 73 && slice_eq(input, t7, tag_end, "I-FRAMES-ONLY") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-I-FRAMES-ONLY in Master Playlist"))
        }
        if st.i_frames_only {
          return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-I-FRAMES-ONLY"))
        }
        st.i_frames_only = true
        return true
      }
    } else if tag_len == 14 {
      if b7 == 86 && slice_eq(input, t7, tag_end, "VERSION") {
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-VERSION requires value"))
        }
        match st.version {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-VERSION"))
          None => ()
        }
        let v = parse_uint64_raw(input, val_start, line_end)
        if v < 1L || v > 2147483647L {
          return set_err(st, HlsError::InvalidNumber("invalid #EXT-X-VERSION"))
        }
        st.version = Some(v.to_int())
        return true
      }
      if b7 == 69 && slice_eq(input, t7, tag_end, "ENDLIST") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-ENDLIST in Master Playlist"))
        }
        if st.end_list {
          return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-ENDLIST"))
        }
        st.end_list = true
        return true
      }
    } else if tag_len == 21 {
      if b7 == 84 && slice_eq(input, t7, tag_end, "TARGETDURATION") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-TARGETDURATION in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-TARGETDURATION requires value"))
        }
        match st.target_duration {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-TARGETDURATION"))
          None => ()
        }
        let td = parse_uint64_raw(input, val_start, line_end)
        if td <= 0L {
          return set_err(st, HlsError::InvalidNumber("TARGETDURATION must be positive"))
        }
        st.target_duration = Some(td)
        if !st.segments_reserved && st.segments.length() == 0 && input.length() > 512 {
          let mut est = input.length() / 96
          if est > limits.max_segments {
            est = limits.max_segments
          }
          if est > 2048 {
            est = 2048
          }
          if est > 8 {
            st.segments = Array::with_capacity(est)
          }
          st.segments_reserved = true
        }
        return true
      }
      if b7 == 77 && slice_eq(input, t7, tag_end, "MEDIA-SEQUENCE") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-MEDIA-SEQUENCE in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-MEDIA-SEQUENCE requires value"))
        }
        match st.media_sequence {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-MEDIA-SEQUENCE"))
          None => ()
        }
        if st.segments.length() > 0 || st.has_pending_extinf {
          return set_err(st, HlsError::InvalidTag("#EXT-X-MEDIA-SEQUENCE must appear before first segment"))
        }
        let x = parse_uint64_raw(input, val_start, line_end)
        if x < 0L {
          return set_err(st, HlsError::InvalidNumber("invalid #EXT-X-MEDIA-SEQUENCE"))
        }
        st.media_sequence = Some(x)
        return true
      }
      if b7 == 83 && slice_eq(input, t7, tag_end, "SERVER-CONTROL") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-SERVER-CONTROL in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-SERVER-CONTROL requires attributes"))
        }
        match st.server_control {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-SERVER-CONTROL"))
          None => ()
        }
        return parse_server_control_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 15 {
      if b7 == 80 && slice_eq(input, t7, tag_end, "PART-INF") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-PART-INF in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-PART-INF requires attributes"))
        }
        match st.part_inf {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-PART-INF"))
          None => ()
        }
        return parse_part_inf_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 19 {
      if b7 == 80 && slice_eq(input, t7, tag_end, "PRELOAD-HINT") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-PRELOAD-HINT in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-PRELOAD-HINT requires attributes"))
        }
        if st.preload_hints.length() >= limits.max_preload_hints {
          return set_err(st, HlsError::LimitExceeded("max_preload_hints exceeded"))
        }
        return parse_preload_hint_attrs(input, val_start, line_end, st, limits)
      }
      if b7 == 83 && slice_eq(input, t7, tag_end, "SESSION-DATA") {
        st.is_master = true
        if st.is_media {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-SESSION-DATA in Media Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-SESSION-DATA requires attributes"))
        }
        return parse_session_data_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 23 {
      if b7 == 82 && slice_eq(input, t7, tag_end, "RENDITION-REPORT") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-RENDITION-REPORT in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-RENDITION-REPORT requires attributes"))
        }
        if st.rendition_reports.length() >= limits.max_rendition_reports {
          return set_err(st, HlsError::LimitExceeded("max_rendition_reports exceeded"))
        }
        return parse_rendition_report_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 25 {
      if b7 == 73 && slice_eq(input, t7, tag_end, "I-FRAME-STREAM-INF") {
        st.is_master = true
        if st.is_media {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-I-FRAME-STREAM-INF in Media Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-I-FRAME-STREAM-INF requires attributes"))
        }
        if st.iframe_streams.length() >= limits.max_variants {
          return set_err(st, HlsError::LimitExceeded("max_variants exceeded"))
        }
        return parse_iframe_attrs(input, val_start, line_end, st, limits)
      }
    } else if tag_len == 13 {
      if b7 == 68 && slice_eq(input, t7, tag_end, "DEFINE") {
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-DEFINE requires attributes"))
        }
        return parse_define_attrs(input, val_start, line_end, st, limits, import_vars, query_params)
      }
    } else if tag_len == 18 {
      if b7 == 83 && slice_eq(input, t7, tag_end, "SESSION-KEY") {
        st.is_master = true
        if st.is_media {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-SESSION-KEY in Media Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-SESSION-KEY requires attributes"))
        }
        return parse_key_attrs(input, val_start, line_end, st, limits, true)
      }
    } else if tag_len == 27 {
      if b7 == 73 && slice_eq(input, t7, tag_end, "INDEPENDENT-SEGMENTS") {
        if st.independent_segments {
          return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-INDEPENDENT-SEGMENTS"))
        }
        st.independent_segments = true
        return true
      }
    } else if tag_len == 29 {
      if b7 == 68 && slice_eq(input, t7, tag_end, "DISCONTINUITY-SEQUENCE") {
        st.is_media = true
        if st.is_master {
          return set_err(st, HlsError::MixedPlaylistTags("#EXT-X-DISCONTINUITY-SEQUENCE in Master Playlist"))
        }
        if colon < 0 {
          return set_err(st, HlsError::InvalidTag("#EXT-X-DISCONTINUITY-SEQUENCE requires value"))
        }
        match st.discontinuity_sequence {
          Some(_) => return set_err(st, HlsError::InvalidTag("duplicate #EXT-X-DISCONTINUITY-SEQUENCE"))
          None => ()
        }
        if st.segments.length() > 0 || st.has_pending_extinf {
          return set_err(st, HlsError::InvalidTag("#EXT-X-DISCONTINUITY-SEQUENCE must appear before first segment"))
        }
        let x = parse_uint64_raw(input, val_start, line_end)
        if x < 0L {
          return set_err(st, HlsError::InvalidNumber("invalid #EXT-X-DISCONTINUITY-SEQUENCE"))
        }
        st.discontinuity_sequence = Some(x)
        return true
      }
    }
  }

  handle_custom_tag(st, input, line_start, tag_end, colon, val_start, line_end, limits)
}

fn handle_uri_line(
  st : ParserState,
  input : String,
  line_start : Int,
  line_end : Int,
  limits : HlsLimits,
) -> Bool {
  let uri = sub_slice(input, line_start, line_end, st, limits)
  if st.has_err {
    return false
  }

  if st.has_pending_extinf {
    if st.segments.length() >= limits.max_segments {
      return set_err(st, HlsError::LimitExceeded("max_segments exceeded"))
    }
    let dur_us = st.pending_extinf_us
    let resolved_br : Option[ByteRange] = if !st.has_pending_byterange {
      st.has_prev_seg_br_end = false
      None
    } else {
      let br_len = st.pending_br_len
      let eff_off = if st.pending_br_has_off {
        st.pending_br_off
      } else {
        if st.has_prev_seg_uri && st.has_prev_seg_br_end {
          if st.prev_seg_uri != uri {
            return set_err(st, HlsError::InvalidByteRange("implicit BYTERANGE offset requires same URI as previous segment"))
          }
          st.prev_seg_br_end
        } else {
          return set_err(st, HlsError::InvalidByteRange("implicit BYTERANGE offset requires preceding byterange segment"))
        }
      }
      if eff_off > 9223372036854775807L - br_len {
        return set_err(st, HlsError::InvalidByteRange("BYTERANGE offset + length overflow"))
      }
      st.has_prev_seg_uri = true
      st.prev_seg_uri = uri
      st.has_prev_seg_br_end = true
      st.prev_seg_br_end = eff_off + br_len
      Some(ByteRange::{ length: br_len, offset: Some(eff_off) })
    }

    if dur_us > st.max_seg_dur_us {
      st.max_seg_dur_us = dur_us
    }
    if dur_us > 9223372036854775807L - st.total_dur_us {
      st.dur_overflow = true
    } else {
      st.total_dur_us = st.total_dur_us + dur_us
    }
    if st.pending_discontinuity {
      st.disc_count = st.disc_count + 1L
    }

    st.segments.push(MediaSegment::{
      uri: uri,
      duration_us: dur_us,
      title: st.pending_extinf_title,
      byterange: resolved_br,
      discontinuity: st.pending_discontinuity,
      gap: st.pending_gap,
      program_date_time: st.pending_pdt,
      key: st.pending_key,
      keys: st.pending_keys,
      map: st.pending_map,
      keys_before_map: st.pending_keys_before_map,
      parts: st.pending_parts,
      custom_tags: st.pending_custom_tags,
    })
    st.has_pending_extinf = false
    st.pending_extinf_title = None
    st.has_pending_byterange = false
    st.pending_discontinuity = false
    st.pending_gap = false
    st.pending_pdt = None
    st.pending_key = None
    st.pending_keys = []
    st.pending_map = None
    st.pending_keys_before_map = 0
    st.pending_parts = []
    st.pending_custom_tags = []
    st.has_prev_part_uri = false
    st.has_prev_part_br_end = false
    return true
  }

  match st.pending_stream_inf {
    Some(si) => {
      if st.variants.length() >= limits.max_variants {
        return set_err(st, HlsError::LimitExceeded("max_variants exceeded"))
      }
      st.variants.push(VariantStream::{
        uri: uri,
        bandwidth: si.bandwidth,
        average_bandwidth: si.average_bandwidth,
        codecs: si.codecs,
        resolution: si.resolution,
        frame_rate_mhz: si.frame_rate_mhz,
        hdcp_level: si.hdcp_level,
        audio: si.audio,
        video: si.video,
        subtitles: si.subtitles,
        closed_captions: si.closed_captions,
        score_micros: si.score_micros,
        pathway_id: si.pathway_id,
      })
      st.pending_stream_inf = None
      return true
    }
    None => ()
  }

  set_err(st, HlsError::InvalidSyntax("unexpected URI without preceding #EXTINF or #EXT-X-STREAM-INF"))
}

fn media_type_key(mt : MediaType) -> String {
  match mt {
    MediaType::Audio => "A"
    MediaType::Video => "V"
    MediaType::Subtitles => "S"
    MediaType::ClosedCaptions => "C"
  }
}

fn validate_master_constraints(st : ParserState) -> Bool {
  if st.has_import_define {
    return set_err(st, HlsError::InvalidVariable("IMPORT not allowed in Multivariant Playlist"))
  }
  let has_media = st.media_renditions.length() > 0
  let groups : Map[String, Bool] = Map::new()
  if has_media {
    let group_names : Map[String, Bool] = Map::new()
    let mut i = 0
    while i < st.media_renditions.length() {
      let r = st.media_renditions[i]
      let gk = media_type_key(r.media_type) + "\x00" + r.group_id
      groups.set(gk, true)
      let nk = gk + "\x00" + r.name
      match group_names.get(nk) {
        Some(_) =>
        return set_err(st, HlsError::InvalidAttribute("duplicate NAME in EXT-X-MEDIA group: " + r.name))
        None => group_names.set(nk, true)
      }
      i = i + 1
    }
  }

  let mut any_cc_none = false
  let mut any_cc_not_none = false
  let mut i = 0
  while i < st.variants.length() {
    let v = st.variants[i]
    match v.audio {
      Some(g) => {
        if !has_media {
          return set_err(st, HlsError::InvalidAttribute("AUDIO group not found: " + g))
        }
        match groups.get("A\x00" + g) {
          Some(_) => ()
          None => return set_err(st, HlsError::InvalidAttribute("AUDIO group not found: " + g))
        }
      }
      None => ()
    }
    match v.video {
      Some(g) => {
        if !has_media {
          return set_err(st, HlsError::InvalidAttribute("VIDEO group not found: " + g))
        }
        match groups.get("V\x00" + g) {
          Some(_) => ()
          None => return set_err(st, HlsError::InvalidAttribute("VIDEO group not found: " + g))
        }
      }
      None => ()
    }
    match v.subtitles {
      Some(g) => {
        if !has_media {
          return set_err(st, HlsError::InvalidAttribute("SUBTITLES group not found: " + g))
        }
        match groups.get("S\x00" + g) {
          Some(_) => ()
          None => return set_err(st, HlsError::InvalidAttribute("SUBTITLES group not found: " + g))
        }
      }
      None => ()
    }
    match v.closed_captions {
      Some(ClosedCaptionsRef::None) => any_cc_none = true
      Some(ClosedCaptionsRef::GroupId(g)) => {
        any_cc_not_none = true
        if !has_media {
          return set_err(st, HlsError::InvalidAttribute("CLOSED-CAPTIONS group not found: " + g))
        }
        match groups.get("C\x00" + g) {
          Some(_) => ()
          None => return set_err(st, HlsError::InvalidAttribute("CLOSED-CAPTIONS group not found: " + g))
        }
      }
      None => any_cc_not_none = true
    }
    i = i + 1
  }
  if any_cc_none && any_cc_not_none {
    return set_err(st, HlsError::InvalidAttribute("CLOSED-CAPTIONS=NONE must be present on all variants if used on any"))
  }
  true
}

fn validate_media_constraints(
  st : ParserState,
  td : Int64,
  ms : Int64,
  ds : Int64,
) -> Bool {
  let max_i64 = 9223372036854775807L
  let seg_count = st.segments.length().to_int64()
  if seg_count > 0L {
    let rounded_s = st.max_seg_dur_us / 1000000L + (if st.max_seg_dur_us % 1000000L >= 500000L { 1L } else { 0L })
    if rounded_s > td {
      return set_err(st, HlsError::InvalidNumber("EXTINF rounded duration exceeds TARGETDURATION"))
    }
    let skipped = match st.skip_tag {
      Some(sk) => sk.skipped_segments
      None => 0L
    }
    if skipped > max_i64 - ms {
      return set_err(st, HlsError::InvalidNumber("media sequence overflow"))
    }
    let base_msn = ms + skipped
    if seg_count - 1L > max_i64 - base_msn {
      return set_err(st, HlsError::InvalidNumber("media sequence overflow"))
    }
    if st.disc_count > max_i64 - ds {
      return set_err(st, HlsError::InvalidNumber("discontinuity sequence overflow"))
    }
    if st.dur_overflow {
      return set_err(st, HlsError::InvalidNumber("playlist total duration overflow"))
    }
  }

  match st.part_inf {
    None => {
      if st.has_parts {
        return set_err(st, HlsError::MissingRequiredTag("#EXT-X-PART-INF required with #EXT-X-PART"))
      }
    }
    Some(pi) => {
      if st.has_parts && st.max_part_dur_us > pi.part_target_us {
        return set_err(st, HlsError::InvalidNumber("EXT-X-PART DURATION exceeds PART-TARGET"))
      }
      match st.server_control {
        None =>
        return set_err(st, HlsError::MissingRequiredAttribute("PART-HOLD-BACK required with EXT-X-PART-INF"))
        Some(sc) => {
          match sc.part_hold_back_us {
            None =>
            return set_err(st, HlsError::MissingRequiredAttribute("PART-HOLD-BACK required with EXT-X-PART-INF"))
            Some(phb) => {
              if pi.part_target_us > max_i64 / 2L || phb < pi.part_target_us * 2L {
                return set_err(st, HlsError::InvalidAttribute("PART-HOLD-BACK must be >= 2 * PART-TARGET"))
              }
            }
          }
        }
      }
    }
  }

  match st.server_control {
    Some(sc) => {
      if sc.can_skip_dateranges {
        match sc.can_skip_until_us {
          Some(_) => ()
          None =>
          return set_err(st, HlsError::InvalidAttribute("CAN-SKIP-DATERANGES requires CAN-SKIP-UNTIL"))
        }
      }
      match sc.can_skip_until_us {
        Some(csu) => {
          if td > max_i64 / 6000000L || csu < td * 6000000L {
            return set_err(st, HlsError::InvalidAttribute("CAN-SKIP-UNTIL must be >= 6 * TARGETDURATION"))
          }
        }
        None => ()
      }
      match sc.hold_back_us {
        Some(hb) => {
          if td > max_i64 / 3000000L || hb < td * 3000000L {
            return set_err(st, HlsError::InvalidAttribute("HOLD-BACK must be >= 3 * TARGETDURATION"))
          }
        }
        None => ()
      }
    }
    None => ()
  }
  true
}

fn take_err(st : ParserState) -> HlsError {
  match st.err {
    Some(e) => e
    None => HlsError::InvalidSyntax("parse error")
  }
}

///| Parse an HLS Master or Media playlist with default `HlsLimits`.
pub fn parse_playlist(input : String) -> Result[Playlist, HlsError] {
  parse_playlist_with_context(input, HlsLimits::default(), [], [])
}

///| Parse an HLS Master or Media playlist with explicit `HlsLimits`.
pub fn parse_playlist_with_limits(
  input : String,
  limits : HlsLimits,
) -> Result[Playlist, HlsError] {
  parse_playlist_with_context(input, limits, [], [])
}

///| Parse an HLS Master or Media playlist with explicit `HlsLimits`, Multivariant `IMPORT` variables,
///| and Playlist URI `QUERYPARAM` values (RFC 8216bis §4.4.2.3).
pub fn parse_playlist_with_context(
  input : String,
  limits : HlsLimits,
  import_vars : Array[(String, String)],
  query_params : Array[(String, String)],
) -> Result[Playlist, HlsError] {
  if !validate_limits_ok(limits) {
    return Err(HlsError::LimitExceeded("negative HlsLimits field"))
  }
  let n = input.length()
  if n > limits.max_input_bytes {
    return Err(HlsError::LimitExceeded("max_input_bytes exceeded"))
  }

  let mut pos = 0
  if n >= 3 &&
  input.code_unit_at(0) == 239 &&
  input.code_unit_at(1) == 187 &&
  input.code_unit_at(2) == 191 {
    pos = 3
  }
  if pos >= n {
    return Err(HlsError::MissingHeader("empty playlist"))
  }

  let st = new_parser_state()
  let mut line_count = 0

  while pos < n {
    line_count = line_count + 1
    if line_count > limits.max_lines {
      return Err(HlsError::LimitExceeded("max_lines exceeded"))
    }

    let line_start = pos
    let mut nl = pos
    let mut line_end = -1
    let mut has_lbrace = false
    while nl < n {
      let ch = input.code_unit_at(nl)
      if ch >= 32 && ch < 123 {
        nl = nl + 1
      } else if ch == 10 {
        line_end = nl
        break
      } else if ch == 13 {
        if nl + 1 < n && input.code_unit_at(nl + 1) == 10 {
          line_end = nl
          nl = nl + 1
          break
        }
        return Err(HlsError::InvalidSyntax("control character inside line"))
      } else if ch == 123 {
        has_lbrace = true
        nl = nl + 1
      } else if ch > 123 && ch != 127 {
        if ch == 194 && nl + 1 < n {
          let next = input.code_unit_at(nl + 1)
          if next >= 128 && next <= 159 {
            return Err(HlsError::InvalidSyntax("C1 control character inside line"))
          }
        }
        nl = nl + 1
      } else if ch == 9 {
        nl = nl + 1
      } else {
        return Err(HlsError::InvalidSyntax("control character inside line"))
      }
    }
    if line_end < 0 {
      line_end = nl
    }
    pos = if nl < n { nl + 1 } else { n }

    let line_len = line_end - line_start
    if line_len > limits.max_line_bytes {
      return Err(HlsError::LimitExceeded("max_line_bytes exceeded"))
    }

    if line_count == 1 {
      if !slice_eq(input, line_start, line_end, "#EXTM3U") {
        return Err(HlsError::MissingHeader("playlist must start with #EXTM3U"))
      }
      continue
    }

    if line_len == 0 {
      continue
    }

    st.line_has_lbrace = has_lbrace

    if input.code_unit_at(line_start) == 35 {
      if line_len < 4 ||
      input.code_unit_at(line_start + 1) != 69 ||
      input.code_unit_at(line_start + 2) != 88 ||
      input.code_unit_at(line_start + 3) != 84 {
        continue
      }
      if !handle_tag_line(st, input, line_start, line_end, limits, import_vars, query_params) {
        return Err(take_err(st))
      }
    } else {
      if !handle_uri_line(st, input, line_start, line_end, limits) {
        return Err(take_err(st))
      }
    }
  }

  match st.pending_stream_inf {
    Some(_) => return Err(HlsError::InvalidSyntax("dangling #EXT-X-STREAM-INF at EOF"))
    None => ()
  }
  if st.has_pending_extinf {
    return Err(HlsError::InvalidSyntax("dangling #EXTINF at EOF"))
  }

  if st.is_master && st.is_media {
    return Err(HlsError::MixedPlaylistTags("mixed Master and Media tags"))
  }
  if st.is_master {
    if !validate_master_constraints(st) {
      return Err(take_err(st))
    }
    return Ok(Playlist::Master(MasterPlaylist::{
      version: st.version,
      independent_segments: st.independent_segments,
      start: st.start_tag,
      defines: st.defines,
      variants: st.variants,
      iframe_streams: st.iframe_streams,
      media: st.media_renditions,
      session_data: st.session_data,
      session_keys: st.session_keys,
      custom_tags: st.custom_tags,
    }))
  }
  if st.is_media {
    let td = match st.target_duration {
      Some(v) => v
      None => return Err(HlsError::MissingRequiredTag("#EXT-X-TARGETDURATION"))
    }
    let ms = match st.media_sequence {
      Some(v) => v
      None => 0L
    }
    let ds = match st.discontinuity_sequence {
      Some(v) => v
      None => 0L
    }
    if !validate_media_constraints(st, td, ms, ds) {
      return Err(take_err(st))
    }
    return Ok(Playlist::Media(MediaPlaylist::{
      version: st.version,
      target_duration: td,
      media_sequence: ms,
      discontinuity_sequence: ds,
      playlist_type: st.playlist_type,
      end_list: st.end_list,
      i_frames_only: st.i_frames_only,
      independent_segments: st.independent_segments,
      start: st.start_tag,
      defines: st.defines,
      server_control: st.server_control,
      part_inf: st.part_inf,
      skip: st.skip_tag,
      segments: st.segments,
      trailing_parts: st.pending_parts,
      preload_hints: st.preload_hints,
      rendition_reports: st.rendition_reports,
      dateranges: st.dateranges,
      custom_tags: st.custom_tags,
      trailing_custom_tags: st.pending_custom_tags,
    }))
  }
  Err(HlsError::MissingRequiredTag("playlist contains neither Master nor Media tags"))
}
